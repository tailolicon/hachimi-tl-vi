    {
      "entry_index": 7,
      "uid": "zhcn:97e2936f7b6e95450859b975",
      "kind": "text_data",
      "source_text": "恶之千金，奋起",
      "source_fingerprint": "66a80780de8d22901d0f6cf1edaaaf477326d30682ec5248f18caac073509f5e",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010304"],
      "target_text": "Thiên kim ác nữ, trỗi dậy",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:606a74fdafe32941ff231ed0",
      "kind": "text_data",
      "source_text": "恶之千金与生存竞赛",
      "source_fingerprint": "ee48acbae153a830fa197dced0a750175bc0f920feb6f0462416e5a4730981a4",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010305"],
      "target_text": "Thiên kim ác nữ và cuộc đua sinh tồn",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:da57e31f268350aeabdb99f7",
      "kind": "text_data",
      "source_text": "恶之千金与爱的逃亡",
      "source_fingerprint": "47d4eefc65364ab106c0f5adcfc38f44b4cf21cfcb57b375555f90374e485c5f",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010306"],
      "target_text": "Thiên kim ác nữ và cuộc đào tẩu của tình yêu",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:7c68160b680f7637368116e4",
      "kind": "text_data",
      "source_text": "与爱之千金今后也",
      "source_fingerprint": "f1dc078b64b6ce969c6c9ad324c846bc13f65a066ddd97512f525138e4e7940b",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010307"],
      "target_text": "Thiên kim của tình yêu, từ nay về sau cũng vậy",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:0d027194aedcd67cb84b4801",
      "kind": "text_data",
      "source_text": "本能追求最强",
      "source_fingerprint": "ff64d0beb172d77c669574f005af719d4269f341cf618d5e3a767daa98f12a72",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010308"],
      "target_text": "Theo bản năng, theo đuổi kẻ mạnh nhất",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:337d609f83f24f3e178e735c",
      "kind": "text_data",
      "source_text": "在强者面前，人人平等",
      "source_fingerprint": "8eaccc4992b42293a8b288a81ff2d4ba21a51116eb891b984490242c29ceaff9",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010309"],
      "target_text": "Trước kẻ mạnh, ai cũng bình đẳng",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:e2a7e906991edae7a7541ef7",
      "kind": "text_data",
      "source_text": "淑女面前无敌",
      "source_fingerprint": "ba1d3683d626351eac1b9f5b646678167f9a82e0d571f10f9369b8628c2c4ff3",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010310"],
      "target_text": "Vô địch trước các quý cô",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:ce8b6c4570990afa0ac5e3b5",
      "kind": "text_data",
      "source_text": "向绝对的强者许下愿望",
      "source_fingerprint": "e921ee343ff066818f6fbde60bb1b01448cb092bd7a4577eb06ac547a3c27986",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010311"],
      "target_text": "Gửi nguyện ước đến kẻ mạnh tuyệt đối",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:a2398d7acc59711923833b95",
      "kind": "text_data",
      "source_text": "这里是起点",
      "source_fingerprint": "01504842d6baba31fb413c554744a34820c97bdd23debd34599002ae8ec0b4ee",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010316"],
      "target_text": "Đây là điểm khởi đầu",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:a5b81672dd10c6fb193e9da7",
      "kind": "text_data",
      "source_text": "成为照亮大家的力量",
      "source_fingerprint": "86040b85f0dc9cc0d5d2061957c9734fb6e0a7cc00bada0e8ebbaad35a1b7bf8",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010317"],
      "target_text": "Trở thành sức mạnh soi sáng mọi người",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:633e7858e5dfb05e1b43d2ed",
      "kind": "text_data",
      "source_text": "无论何时何地都能闪耀的东西",
      "source_fingerprint": "47ba4b72035685437e19bde0d5f7ddf4de771223d257e730fb131c8b15efcfde",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010318"],
      "target_text": "Thứ có thể tỏa sáng mọi lúc mọi nơi",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:b225e20fa04854deb8b81a70",
      "kind": "text_data",
      "source_text": "传说的光辉",
      "source_fingerprint": "01e7758aaa593193df48c3b1fd341657feb8cc7b19d5ede1db9c5c0f75b6e163",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400010319"],
      "target_text": "Ánh hào quang của truyền thuyết",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:8a163eb289325bb10a298fb0",
      "kind": "text_data",
      "source_text": "无人岛计划，启动！",
      "source_fingerprint": "e6d232e006359b5c7430c4b719248b970e498228d5c893dad7c4a1c147bf0106",
      "source_path": "text_data_dict.json",
      "json_path": ["181", "400011000"],
      "target_text": "Kế hoạch đảo hoang, khởi động!",
      "reviewed": true
