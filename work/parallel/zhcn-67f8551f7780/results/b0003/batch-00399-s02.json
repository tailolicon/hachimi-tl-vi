    },
    {
      "entry_index": 45,
      "uid": "zhcn:9402aef005bca4b7259b23c1",
      "kind": "text_data",
      "source_text": "『即便将巧克力隐于咖喱之中，其味犹存』",
      "source_fingerprint": "d296a3b762a7a08f8312db1fdd2afbf9025565b945a14779779f83ab678c1b56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501069113"
      ],
      "target_text": "『Dù giấu sô-cô-la trong cà ri, hương vị vẫn còn đó』",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:83f7ec64476ec189d3e86443",
      "kind": "text_data",
      "source_text": "『崭新的榻榻米更能留下足迹』",
      "source_fingerprint": "472eea792b06744ad6b52661e8b5a2adca0c45b9fa6678e3769b96f080640835",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501069114"
      ],
      "target_text": "『Chiếu tatami mới càng dễ lưu dấu chân』",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:02858f180ca17f7c56307e1a",
      "kind": "text_data",
      "source_text": "『一味盯着水中之月，只会止步不前』",
      "source_fingerprint": "e809cf29b57241712e1f374d1371785d5e5505962ed1718df323fb4ef502996d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501069115"
      ],
      "target_text": "『Chỉ mãi nhìn trăng dưới nước, ta sẽ chẳng thể tiến bước』",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:a64d4174b66795289e9d692f",
      "kind": "text_data",
      "source_text": "『今宵所见是为满月，抑或新月？』",
      "source_fingerprint": "904abba9fd24f1b61d173f212950eef79ec8e4ab35c230d6f96c6ad5c5bedfe7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501069116"
      ],
      "target_text": "『Trăng đêm nay là trăng tròn, hay trăng non?』",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:c7d5c606f5dc0bbdedefcb3c",
      "kind": "text_data",
      "source_text": "『若不想作茧自缚，则需以茧为食』",
      "source_fingerprint": "e88e2dfee4b5918e3b38e48a2bf9d185af8f16fd4e8d8ab69dc67299edc3344e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501069117"
      ],
      "target_text": "『Nếu không muốn tự trói mình trong kén, hãy ăn luôn cái kén』",
      "reviewed": true
    },
    {
      "entry_index": 50,
      "uid": "zhcn:85255414f999daf71da8ed27",
      "kind": "text_data",
      "source_text": "这是所谓羡慕呢、还是所谓执念呢——",
      "source_fingerprint": "215e14d254d39362c08f28f735f0b548451630d0423c5de09cf3b25301d47533",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501069118"
      ],
      "target_text": "Đây là ngưỡng mộ, hay là chấp niệm đây——",
      "reviewed": true
    },
