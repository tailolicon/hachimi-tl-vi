      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501082704"
      ],
      "target_text": "Nỗi lo ③: Đi 1 mình thì ngại vào cửa hàng!",
      "reviewed": true
    },
    {
      "entry_index": 54,
      "uid": "zhcn:c776496f0a8153fbe768f96f",
      "kind": "text_data",
      "source_text": "かわいらしいお友だち",
