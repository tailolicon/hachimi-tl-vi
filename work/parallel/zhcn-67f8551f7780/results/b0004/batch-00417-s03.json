      ],
      "target_text": "Prelude tái sinh",
      "reviewed": true
    },
    {
      "entry_index": 70,
      "uid": "zhcn:c556b80c15acc37865d652bc",
      "kind": "text_data",
      "source_text": "因此痴狂，沉醉于汝",
      "source_fingerprint": "20efa44f30ae4eb6955586ef52c518dc32007ba894bf14bc971b6d2828708195",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501084117"
      ],
      "target_text": "Bởi thế mà cuồng si, đắm say vì người",
      "reviewed": true
    },
    {
      "entry_index": 71,
      "uid": "zhcn:fce4d23e8b95723fab0143b2",
      "kind": "text_data",
      "source_text": "越过无数的夜晚",
