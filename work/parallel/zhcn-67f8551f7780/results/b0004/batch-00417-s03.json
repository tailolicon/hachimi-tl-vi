    {
      "entry_index": 64,
      "uid": "zhcn:eb305afc7a138e1fa5a7d856",
      "kind": "text_data",
      "source_text": "破坏机缘、宿志与命运的是两位成神之人",
      "source_fingerprint": "6b20aec320ccfec4de699dfbd2af29d1568eb759ae5a682d747f1c1e3b047ae1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501084111"
      ],
      "target_text": "Hai người đã hóa thần, những kẻ phá vỡ cơ duyên, chí nguyện và vận mệnh",
      "reviewed": true
    },
    {
      "entry_index": 65,
      "uid": "zhcn:e8bf2796702759fd6385580c",
      "kind": "text_data",
      "source_text": "温泉旅行",
      "source_fingerprint": "08f173fddcb7e5822fab5109fd215cebe140f0aa03b4c5e000b99882bdbd34eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501084112"
      ],
      "target_text": "Chuyến du lịch suối nước nóng",
      "reviewed": true
    },
    {
      "entry_index": 66,
      "uid": "zhcn:caddbc6c433c205301bc7b28",
      "kind": "text_data",
      "source_text": "宿命论／注定相逢的炽热",
      "source_fingerprint": "2abfca85a0900e991b23250f7ed52efb618c502b7b23c15a960b04d5a2f6c416",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501084113"
      ],
      "target_text": "Thuyết định mệnh／Sức nóng của cuộc tương phùng định mệnh",
      "reviewed": true
    },
    {
      "entry_index": 67,
      "uid": "zhcn:9b4af1dff574c973d38b4248",
      "kind": "text_data",
      "source_text": "宿命论／冷酷的命运",
      "source_fingerprint": "bf8730f00ca0dc4fb325433f8b8493ef070641ff7825b12159fdfb2abebdcf92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501084114"
      ],
      "target_text": "Thuyết định mệnh／Vận mệnh tàn khốc",
      "reviewed": true
    },
    {
      "entry_index": 68,
      "uid": "zhcn:dfd8f2355c366c50d9cdda39",
      "kind": "text_data",
      "source_text": "宿命论／圈外者之名",
      "source_fingerprint": "ca8fe9bf558be4451fce1f233050ef9d5114a8e593c22b136048b44545095f53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501084115"
      ],
      "target_text": "Thuyết định mệnh／Danh xưng kẻ ngoài cuộc",
      "reviewed": true
    },
    {
      "entry_index": 69,
      "uid": "zhcn:4b043fc949b43c2886191b5f",
      "kind": "text_data",
      "source_text": "重生序曲",
      "source_fingerprint": "ce9d278b5cb9e9c46f16a7a1a128fad575b3df2d71b98023d5562649efe20bbb",
      "source_path": "text_data_dict.json",
      "json_path": [
