      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133514"
      ],
      "target_text": "Yểu điệu, đôi lúc nồng nhiệt",
      "reviewed": true
    },
    {
      "entry_index": 35,
      "uid": "zhcn:c0bb6e35e50eaa110f87021e",
      "kind": "text_data",
      "source_text": "注视着取景器",
