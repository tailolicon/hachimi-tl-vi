    },
    {
      "entry_index": 30,
      "uid": "zhcn:09340a2fa69e1b6ef62ef8c9",
      "kind": "text_data",
      "source_text": "连续参赛后……",
      "source_fingerprint": "884798b2ed571f540f00ba12995bc89a7f546f03f0608d48cf52c0f6ebf96e18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133509"
      ],
      "target_text": "Sau những trận đấu liên tiếp……",
