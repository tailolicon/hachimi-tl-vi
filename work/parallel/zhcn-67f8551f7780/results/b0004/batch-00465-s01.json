    },
    {
      "entry_index": 31,
      "uid": "zhcn:25e32dcac1e9f2d52eda5729",
      "kind": "text_data",
      "source_text": "然后将创造历史的瞬间……",
      "source_fingerprint": "1c8b28f54440734ebfabcd8f3ec4fb8e719581debe15b91e52b081ce42622787",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133510"
      ],
      "target_text": "Và rồi khoảnh khắc làm nên lịch sử……",
      "reviewed": true
    },
    {
      "entry_index": 32,
      "uid": "zhcn:26af7033944b62f3d9e788d0",
      "kind": "text_data",
      "source_text": "撰稿人×撰稿人",
