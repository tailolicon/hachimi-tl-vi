  "entries": [
    {
      "entry_index": 20,
      "uid": "zhcn:94fef3c78471c9ff47139001",
      "kind": "text_data",
      "source_text": "日本橡树大赛结束后・波折也是戏剧",
      "source_fingerprint": "7c1a771bad9c313c582a923cfc9fc621742058cc8078f7114281f091a1c24bb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133311"
      ],
      "target_text": "Sau Japanese Oaks・Sóng gió cũng thành kịch",
      "reviewed": true
    },
    {
      "entry_index": 21,
      "uid": "zhcn:4181e783176a5a252c88d9bd",
      "kind": "text_data",
      "source_text": "秋华赏结束后・踏着三重花影，飞翔",
      "source_fingerprint": "4e444ebeffb6d3d5cdf7efd844dea21d75a05ef76964ccbc2c7d77c8de3285d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133312"
      ],
      "target_text": "Sau Shuka Sho・Băng qua ba tầng bóng hoa, tung cánh",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:5e9975ff2d2b92e2aebee1a3",
      "kind": "text_data",
      "source_text": "大阪杯结束后・无法触及，时间之重",
      "source_fingerprint": "ec32e15935d3529088f55bbeb5d9c184bd50049aba5c5b0d0c01ca275518ae33",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133313"
      ],
      "target_text": "Sau Osaka Hai・Không thể chạm tới, sức nặng của thời gian",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:59a5430d8a939a231c954668",
      "kind": "text_data",
      "source_text": "宝冢纪念结束后・将梦之足迹刻进历史",
      "source_fingerprint": "0ce15c05d636b3e5f46086b81e0543ba66b245d15b5c543a5f9f5f5be359109d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133314"
      ],
      "target_text": "Sau Takarazuka Kinen・Khắc dấu chân ước mơ vào lịch sử",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:4538a4756b2fcec6f69a7092",
      "kind": "text_data",
      "source_text": "天皇赏（秋）结束后・和传说并肩",
      "source_fingerprint": "49c1ad689d0f23523b906c8ed8839795f93116656c621d43db9c8a835ea65ba1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133315"
      ],
      "target_text": "Sau Tenno Sho (Autumn)・Sánh vai cùng huyền thoại",
      "reviewed": true
    },
    {
      "entry_index": 25,
      "uid": "zhcn:f2b8ae705f2f1963ad51422e",
      "kind": "text_data",
      "source_text": "有马纪念结束后・历史已然创造",
      "source_fingerprint": "d36dfe96e128179f6346ad7afad1f34fdcefd67d04ded3e7afe9272146d224f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133316"
      ],
      "target_text": "Sau Arima Kinen・Lịch sử đã được tạo nên",
      "reviewed": true
    },
    {
      "entry_index": 26,
      "uid": "zhcn:249eafe46f8035f667b84d5f",
      "kind": "text_data",
      "source_text": "名指导",
      "source_fingerprint": "73d76c90aad34394dfec642f4758203206bff1d5b8ed3beddced420674c37031",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133500"
      ],
      "target_text": "Bậc thầy huấn luyện",
      "reviewed": true
    },
    {
      "entry_index": 27,
      "uid": "zhcn:c55f9b025c791a5656ad216f",
      "kind": "text_data",
      "source_text": "舞蹈练习",
      "source_fingerprint": "48422923f5a0c99b6201cbd11c56b889a00cf2bc85007fde24f763a7b5b6adb3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133506"
      ],
      "target_text": "Luyện tập vũ đạo",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:34ba1e06c972db8ba0dc66ad",
      "kind": "text_data",
      "source_text": "粉丝来信",
      "source_fingerprint": "46257e0fd128c9a70691058bca678a94f526fa9918e5e2f80c0e4f979ca8385d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133507"
      ],
      "target_text": "Thư của người hâm mộ",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:d4ac8bda1e7c89fa09662ece",
      "kind": "text_data",
      "source_text": "比赛疲劳",
      "source_fingerprint": "7a143fcef2befe014ed7e2793b7c4c0de892e51ac65509f10d3bd2febb2ea6aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501133508"
      ],
      "target_text": "Mệt mỏi vì Cuộc đua",
