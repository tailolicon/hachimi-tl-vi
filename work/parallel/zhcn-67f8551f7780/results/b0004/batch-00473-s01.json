      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820066002"
      ],
      "target_text": "Lời của bạn, lời nhiệm màu",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:814ae1d48b6ea11029ae2147",
      "kind": "text_data",
      "source_text": "甘えてもいいデスカ？",
      "source_fingerprint": "1c0ae08c60c2cac10ddcc564b62494c3cf3bff6b03ade10ae5b8188b6177e058",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820067001"
      ],
      "target_text": "Em làm nũng một chút có được không ạ?",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:d49b32130a10ed0420bca5c2",
      "kind": "text_data",
      "source_text": "甘えてもいいんデスヨ？",
      "source_fingerprint": "f052aa136eb07727b4a5d627e9b65d89f8507d85b0be270d641f61d9a39e1388",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820067002"
      ],
      "target_text": "Cứ làm nũng một chút cũng được nhé?",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:7673a7d1e54224e8d79f2dc2",
      "kind": "text_data",
      "source_text": "いつものネイチャは？ばいばいちゃ～♪",
      "source_fingerprint": "4b0178c64bae7c739584dbb11f746536ba5e3e96e0ba4268b11ab67954993f49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820068001"
      ],
      "target_text": "Nature như mọi khi đâu rồi? Bye bye nha～♪",
      "reviewed": true
    },
    {
      "entry_index": 25,
      "uid": "zhcn:dda5cebff8f7a24edba7bded",
      "kind": "text_data",
      "source_text": "ピンチも笑顔で！ばいばいちゃ～♪",
      "source_fingerprint": "eb463749b9b066b2c82b1112ec11a192efe221774acc47ba39e469fe16102551",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820068002"
      ],
      "target_text": "Gặp nguy cũng phải cười tươi! Bye bye nha～♪",
      "reviewed": true
    },
    {
      "entry_index": 26,
      "uid": "zhcn:0b146ac850a56e64aaec20bc",
      "kind": "text_data",
      "source_text": "占い屋新装開店！！",
      "source_fingerprint": "4a944df277514f1bb86ae7abc939d25f240af8f2029bc0969c5c9ca781c467d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820069001"
      ],
      "target_text": "Tiệm bói toán khai trương diện mạo mới!!",
      "reviewed": true
    },
    {
      "entry_index": 27,
      "uid": "zhcn:e4b0a679fa2ce78df20797fa",
      "kind": "text_data",
      "source_text": "地球最後の日！……か？",
      "source_fingerprint": "1847e5e04647877b216f0fee71d7bcbd6d955a497606ba7b252f7ebb1aaf04dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820069002"
      ],
      "target_text": "Ngày cuối cùng của Trái Đất! ……hay là không?",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:6ad13761ed319125d98d432c",
      "kind": "text_data",
      "source_text": "長姉とあまあま三女",
      "source_fingerprint": "1ab5d4351ebe0b6b00a89063c68b119626cb1575182bbabf241bbacc1c897608",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820070001"
      ],
      "target_text": "Chị cả và cô em thứ ba nũng nịu",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:727b23186d6405e1f1a5c964",
      "kind": "text_data",
      "source_text": "長姉と素直になれない次女",
      "source_fingerprint": "7c7cdab48d13146416ed7d9bb3ab521f33a948915cff5205c81b1376c986dbf0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820070002"
      ],
      "target_text": "Chị cả và cô em thứ hai chẳng chịu thành thật",
      "reviewed": true
    },
    {
      "entry_index": 30,
      "uid": "zhcn:c0970000c87e941c56daa54a",
      "kind": "text_data",
      "source_text": "トライアル＆トライアル！",
      "source_fingerprint": "faa5cc76246a47aac8d6d6a31f2e80cfd6a47e8adec8ecebb913c767762f3ba1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820071001"
      ],
      "target_text": "Trial & Trial!",
      "reviewed": true
    },
    {
      "entry_index": 31,
      "uid": "zhcn:ce06687c03dab205a7a53450",
      "kind": "text_data",
      "source_text": "再試行＆再検証！",
      "source_fingerprint": "e898826196407b3de2e3bd080ed80e359e1970d517c3060a1145a29f07da2947",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820071002"
      ],
      "target_text": "Thử lại & kiểm chứng lại!",
      "reviewed": true
    },
    {
      "entry_index": 32,
      "uid": "zhcn:6e91910baacd7acdaa7b45cc",
      "kind": "text_data",
      "source_text": "虚ろなる陶酔",
      "source_fingerprint": "d2618d434b41a708bc6610a92930413e33dc9d6497315e48ac7d07805dd42c70",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820072001"
      ],
      "target_text": "Cơn mê say trống rỗng",
      "reviewed": true
    },
    {
      "entry_index": 33,
      "uid": "zhcn:af2886f3dbcc1617d7fd2fe5",
      "kind": "text_data",
      "source_text": "迷える子羊に捧ぐ祝杯",
      "source_fingerprint": "8296ba8f996f4e2c0bd45c892f2fdb9d1bdf60ae345c2c2f470b500125da601d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820072002"
      ],
      "target_text": "Chén mừng dành cho chú cừu lạc lối",
      "reviewed": true
    },
    {
      "entry_index": 34,
      "uid": "zhcn:12fab5925dbffdb3d2e2ad6b",
      "kind": "text_data",
      "source_text": "とりま甘いもん食わね？",
      "source_fingerprint": "f59c573b3256a3e2420156313fae3ac5d216c794285badbba7f8341fbc4d3785",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820073001"
      ],
      "target_text": "Trước mắt đi ăn đồ ngọt không?",
      "reviewed": true
    },
    {
      "entry_index": 35,
      "uid": "zhcn:ddaf3dc5d9594cdac847f468",
      "kind": "text_data",
      "source_text": "えらすぎ賞あげてーんだが",
      "source_fingerprint": "978266cb72e27ee644deb0a8b41e2760f77c523751f2e85c5eb55434b6f3b296",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820073002"
      ],
      "target_text": "Muốn trao giải “Giỏi quá đi” ghê á",
      "reviewed": true
    },
    {
      "entry_index": 36,
      "uid": "zhcn:05f4782b99c513f771bd5ec7",
      "kind": "text_data",
      "source_text": "燃える心と、心強さと",
      "source_fingerprint": "cbb7931c2f36ef7e2e41c0d24c1c9f7de4088714d7de2735ab229863ba35ea9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820074001"
      ],
      "target_text": "Trái tim rực cháy, cùng sự vững lòng",
      "reviewed": true
    },
    {
      "entry_index": 37,
      "uid": "zhcn:57209dd5b280dc1211d83cc4",
      "kind": "text_data",
      "source_text": "萌ゆる心を忍ぶれど",
      "source_fingerprint": "d6c1065e2a010ca83eaf2688ed134ea5f435d1bac633648afe10dc31b4dec426",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "820074002"
      ],
