  "entries": [
    {
      "entry_index": 60,
      "uid": "zhcn:1bf7f471d783e8bcc91fb938",
      "kind": "text_data",
      "source_text": "致温柔的你",
      "source_fingerprint": "ce8e808524c87393e7cd36b70c5a4c1fb2ef5d9adc0ce8ac7780df78bccb0191",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830109001"
      ],
      "target_text": "Gửi đến bạn, người dịu dàng",
      "reviewed": true
    },
    {
      "entry_index": 61,
      "uid": "zhcn:7be337ee11134428fd479c59",
      "kind": "text_data",
      "source_text": "因为我希望你尽情欢笑",
      "source_fingerprint": "83a4c04daad18c4f77e834f8ca2959e1a61e8b3b18fd6a07c4a3517e7d093fc8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830109002"
      ],
      "target_text": "Vì mình muốn bạn được cười thật thỏa thích",
      "reviewed": true
    },
    {
      "entry_index": 62,
      "uid": "zhcn:b9ee651a306871bead1bab99",
      "kind": "text_data",
      "source_text": "把「快乐」送给你！",
      "source_fingerprint": "36bce2ef53f2de2fb759d7a6e14677ba0b113bfe1590f241d0b77bc0ac63c9e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830109003"
      ],
      "target_text": "Gửi tặng bạn「niềm vui」!",
      "reviewed": true
    },
    {
      "entry_index": 63,
      "uid": "zhcn:59ceb1be4968dfeaf57bec15",
      "kind": "text_data",
      "source_text": "看不见的事物，不看也无妨",
      "source_fingerprint": "d99dc1384191b94f352efe2753bc7d202c909f86942bec14962fca45c608a2fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830110001"
      ],
      "target_text": "Thứ không nhìn thấy, không nhìn cũng chẳng sao",
      "reviewed": true
    },
    {
      "entry_index": 64,
      "uid": "zhcn:8c4f1484722020b5df634f8e",
      "kind": "text_data",
      "source_text": "大事，并不是大事",
      "source_fingerprint": "d18eb41e3d4a2c54278e63dace86ced5e862c938394e0fe49ea3f72aa59c6336",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830110002"
      ],
      "target_text": "Chuyện lớn, thật ra chẳng phải chuyện lớn",
      "reviewed": true
    },
    {
      "entry_index": 65,
      "uid": "zhcn:2132142fbd068dc725d5fb09",
      "kind": "text_data",
      "source_text": "无解之事，保持无解就好",
      "source_fingerprint": "5ddeac6d16b460d8b2f5fef7152ad377e0fc1fa9c3f57fbe9527cb4dd53a4f89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830110003"
      ],
      "target_text": "Chuyện không có lời giải thì cứ để nó không có lời giải",
      "reviewed": true
    },
    {
      "entry_index": 66,
      "uid": "zhcn:02ac7f9644425fb982890315",
      "kind": "text_data",
      "source_text": "帝王的弱点",
      "source_fingerprint": "077efb84a39ba906f0389ec21eb6905962a4309e19fea04732bf74677e24d127",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830111001"
      ],
      "target_text": "Điểm yếu của Teio",
      "reviewed": true
    },
    {
      "entry_index": 67,
      "uid": "zhcn:f9511e91a894523e6d6afc4b",
      "kind": "text_data",
      "source_text": "「帅气」不只一种",
      "source_fingerprint": "6c91e23e6b34b67fc58aebad27e7da2c23051e8ebf293bfce0ac1cbd10fe196e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830111002"
      ],
      "target_text": "「Ngầu」không chỉ có một kiểu",
      "reviewed": true
    },
    {
      "entry_index": 68,
      "uid": "zhcn:b741e10bbbc6a09d9020d6e9",
      "kind": "text_data",
      "source_text": "帝王的作战风格",
      "source_fingerprint": "246c196b6b82c0d99c6e6daedbf4a7092ecb8d8b609c94bca1ddcd18135871b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830111003"
      ],
      "target_text": "Phong cách tác chiến của Teio",
      "reviewed": true
    },
    {
      "entry_index": 69,
      "uid": "zhcn:cdbdc70d1e1faac487e24c64",
      "kind": "text_data",
      "source_text": "来追涡轮！",
      "source_fingerprint": "9bbeebf335d29de86f26c3dc97cd99413c9f81791fc89f37764e90f813ae78eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830112001"
      ],
      "target_text": "Đuổi theo Turbo nào!",
      "reviewed": true
    },
    {
      "entry_index": 70,
      "uid": "zhcn:200d46db8be4600d5ae39667",
      "kind": "text_data",
      "source_text": "跟涡轮玩游戏！",
      "source_fingerprint": "23e62ba16f920ba655d552798727815688898c1b2eadc4ff70ac97a2e1b0878b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830112002"
      ],
      "target_text": "Chơi cùng Turbo!",
      "reviewed": true
    },
    {
      "entry_index": 71,
      "uid": "zhcn:6c800f497159d7f5974ae77a",
      "kind": "text_data",
      "source_text": "涡轮是最强的！",
      "source_fingerprint": "0b7bf83867d10fe7e1df209631379489b865b5a4452665cb935826473d381faa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830112003"
      ],
      "target_text": "Turbo là mạnh nhất!",
      "reviewed": true
    },
    {
      "entry_index": 72,
      "uid": "zhcn:7251405ad84d0a27790f30b7",
      "kind": "text_data",
      "source_text": "关于老家业务上产生的各种问题",
      "source_fingerprint": "9b552b0b42b7643131cfc4a7dc3cb03eb21e9ebed71cd9c856ee9cd0e001dbd9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830113001"
      ],
      "target_text": "Về những vấn đề phát sinh trong công việc kinh doanh của gia đình",
      "reviewed": true
    },
    {
      "entry_index": 73,
      "uid": "zhcn:3664a29dc94cd1e019a24d51",
      "kind": "text_data",
      "source_text": "关于活用虚拟实境之认知修正",
      "source_fingerprint": "1fda249b52aa0adcb5676b49fb89d309ddb0a5e8a3e892eca2f94194ba92ef92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830113002"
      ],
      "target_text": "Về việc điều chỉnh nhận thức bằng cách ứng dụng thực tế ảo",
      "reviewed": true
    },
    {
      "entry_index": 74,
      "uid": "zhcn:c2cfbd0f1d89b0cd9f01cf0f",
      "kind": "text_data",
      "source_text": "关于负责人特质对宴会造成之影响",
      "source_fingerprint": "293a17fc4fd4953006e09518cc1914d85fff90a9767990a644fd27948a6efcfa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830113003"
      ],
      "target_text": "Về ảnh hưởng của đặc tính người phụ trách đối với bữa tiệc",
      "reviewed": true
    },
    {
      "entry_index": 75,
      "uid": "zhcn:750d2a8d8d6c219b02f68f0e",
      "kind": "text_data",
      "source_text": "何故展现坚强一面",
      "source_fingerprint": "77e411b32f1dd9ebe48823ac7a26f0745f15a560de1720e0e20cb91d17d5eaf9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830114001"
      ],
      "target_text": "Vì sao lại thể hiện mặt kiên cường",
      "reviewed": true
    },
    {
      "entry_index": 76,
      "uid": "zhcn:22f8636f465bad41689fab61",
      "kind": "text_data",
      "source_text": "何故展现利落手腕",
      "source_fingerprint": "18a0abcafbad74ec4db14ec7ea4b9fa34936b25b844e6d6157963c12d1aa6aaa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830114002"
      ],
      "target_text": "Vì sao lại thể hiện sự tháo vát",
      "reviewed": true
    },
    {
      "entry_index": 77,
      "uid": "zhcn:4076315d73ab557322cdbeda",
      "kind": "text_data",
      "source_text": "为何人而温柔体贴",
      "source_fingerprint": "e9957179bdfb40c2f598202c782fe36555f511d3e086984bb99942668cca3fb0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830114003"
      ],
      "target_text": "Dịu dàng chu đáo vì ai",
      "reviewed": true
    },
    {
      "entry_index": 78,
      "uid": "zhcn:b29fdb0585167cf6a990362c",
      "kind": "text_data",
      "source_text": "因为我很会发糖果啊",
      "source_fingerprint": "76cebe0673bfc93e02cf960f6c9f90fd21dbe2016be4c4cdd8317828a57dfa5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830115001"
      ],
      "target_text": "Vì mình rất giỏi phát kẹo mà",
      "reviewed": true
    },
    {
      "entry_index": 79,
      "uid": "zhcn:23f376bc7f1958aa57d36521",
      "kind": "text_data",
      "source_text": "我这样就满意了耶",
      "source_fingerprint": "835ce93360373e3098430131552436faaf49578a389ac671d2554bd7487319a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830115002"
      ],
      "target_text": "Thế này là mình hài lòng rồi mà",
      "reviewed": true
    }
  ],
