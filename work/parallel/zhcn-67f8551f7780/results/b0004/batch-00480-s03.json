    },
    {
      "entry_index": 62,
      "uid": "zhcn:2649fa643ae523988c9e547c",
      "kind": "text_data",
      "source_text": "なくしてしまった楽しさ",
      "source_fingerprint": "d35c99d7b92413b939232672582dce57927e4c2bc635abdfe22001d0f3728c03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830185002"
      ],
      "target_text": "Niềm vui đã đánh mất",
      "reviewed": true
    },
    {
      "entry_index": 63,
      "uid": "zhcn:5ed3220ae406886774b61f99",
      "kind": "text_data",
      "source_text": "忘れていた輝き",
      "source_fingerprint": "e19598c2328fb37e17c2f1d87eb9d741e79336cf8947e6fff13df6c892215b3f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830185003"
      ],
      "target_text": "Ánh sáng từng lãng quên",
      "reviewed": true
    },
    {
      "entry_index": 64,
      "uid": "zhcn:eec3dab35b1614a87321e0d4",
      "kind": "text_data",
      "source_text": "強き器に強き心",
      "source_fingerprint": "9548bdc1175749afa8b03b6213d528756f45e8e8d71740688bf7182708e99acf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830186001"
      ],
      "target_text": "Thân thể mạnh mẽ, trái tim mạnh mẽ",
      "reviewed": true
    },
    {
      "entry_index": 65,
      "uid": "zhcn:862cf1e0f49ed8e68c2a5950",
      "kind": "text_data",
      "source_text": "強き器に気高き華",
      "source_fingerprint": "065dc3a836b8aae4dbda9b9818f549ee2eb42d31d7aeb64ae2d0c88a9442cbdf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830186002"
      ],
      "target_text": "Thân thể mạnh mẽ, đóa hoa cao quý",
      "reviewed": true
    },
    {
      "entry_index": 66,
      "uid": "zhcn:4343888a60c2f5e3c9f4b771",
      "kind": "text_data",
      "source_text": "強き器に『心技脚』あり",
      "source_fingerprint": "8124b29db30d0ddc5804c1cae023cd6bb6a62f281065886dbc45cc3a462a898c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830186003"
      ],
      "target_text": "Thân thể mạnh mẽ có đủ 『Tâm・Kỹ・Cước』",
      "reviewed": true
    },
    {
      "entry_index": 67,
      "uid": "zhcn:562b595a4ee8ecef004132e7",
      "kind": "text_data",
      "source_text": "王の気稟",
      "source_fingerprint": "045e8d006698edc9ffc5d6791c704ab4d2216337b70b3742a42b874b67d4bb35",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830187001"
      ],
      "target_text": "Khí chất thiên bẩm của vương giả",
      "reviewed": true
    },
    {
      "entry_index": 68,
      "uid": "zhcn:2c61538e9949f38304d8560a",
      "kind": "text_data",
      "source_text": "王の下知",
      "source_fingerprint": "375e0545608c5f2827489135726977ca9b29a82be07e3d8c3a7c76268bd4d4b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830187002"
      ],
      "target_text": "Mệnh lệnh của vương giả",
      "reviewed": true
    },
    {
      "entry_index": 69,
      "uid": "zhcn:06c49ebb56aaa9d8016c4908",
      "kind": "text_data",
      "source_text": "王の天資",
      "source_fingerprint": "23c274baaf256475ac0c0f5f7a2e0bc082ba783622fa6dc33b88a549494fdce5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830187003"
      ],
      "target_text": "Thiên tư của vương giả",
      "reviewed": true
    },
    {
      "entry_index": 70,
      "uid": "zhcn:5f864743b298d727decceece",
      "kind": "text_data",
      "source_text": "その働きに敬意を",
      "source_fingerprint": "97324bec6be22672aa335868258dce0ae4f951de5f654507f969c3031689ef7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830188001"
      ],
      "target_text": "Xin dành sự kính trọng cho công sức ấy",
      "reviewed": true
    },
    {
      "entry_index": 71,
      "uid": "zhcn:408e65129735cf17150ed881",
      "kind": "text_data",
      "source_text": "夢の約束",
      "source_fingerprint": "89b8793cbf4247ebae920c222001d2ae589d172555ee19a8787db600972bfa22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830189001"
      ],
      "target_text": "Lời hẹn của giấc mơ",
      "reviewed": true
    },
    {
      "entry_index": 72,
      "uid": "zhcn:a7b0424fbf07a4f9a4f447ab",
      "kind": "text_data",
      "source_text": "2人だけの輝き",
      "source_fingerprint": "a30d4d278eef60e1db5aa80e02b1e8d5e3a54e7d435779456578f09854df18ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830189002"
      ],
      "target_text": "Ánh sáng chỉ thuộc về 2 người",
      "reviewed": true
    },
    {
      "entry_index": 73,
      "uid": "zhcn:8bd130f3f0c4cb049bd72446",
      "kind": "text_data",
      "source_text": "夢で共に輝いて",
      "source_fingerprint": "7f2b8a660518bf11274f88b5f1708d66effbc869f3d5c4e70e8748a1a32a82cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830189003"
      ],
      "target_text": "Cùng tỏa sáng trong giấc mơ",
      "reviewed": true
    },
    {
      "entry_index": 74,
      "uid": "zhcn:86ae856d4bd3f6a0cb1454ff",
      "kind": "text_data",
      "source_text": "それはいつかのイニーツィオ",
      "source_fingerprint": "f9a09bb7b61802ad8062365cea21a774974a3dd20420645ba733416c457f387a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830190001"
      ],
      "target_text": "Đó là khởi đầu của một ngày nào đó",
      "reviewed": true
    },
    {
      "entry_index": 75,
      "uid": "zhcn:ffc2e234260b5f2db23029e0",
      "kind": "text_data",
      "source_text": "そして2人はア・ポコ・ア・ポコ",
      "source_fingerprint": "9b3c7616a35b76cb6e6ec04680459551d5289aa1f7c1bdd69df5c404250d7cf0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830190002"
      ],
      "target_text": "Và rồi 2 người, từng chút một",
      "reviewed": true
    },
    {
      "entry_index": 76,
      "uid": "zhcn:e79b05eb8e63edcaa269ba9e",
      "kind": "text_data",
      "source_text": "リヴァーレだからこそ",
      "source_fingerprint": "39d0d7275c4c57469ffb58af817151a0fab599f74653c4a339d2ec96f5ae924c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830190003"
      ],
      "target_text": "Chính vì là đối thủ",
      "reviewed": true
    },
    {
      "entry_index": 77,
      "uid": "zhcn:e1a6e5b5a82924cebd3d9092",
      "kind": "text_data",
      "source_text": "めくるめくミルテの花",
      "source_fingerprint": "b9ca6c2a2499ca3e07b7c47ccf2b9f156014f1ee4d0658c279b78ac836925911",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830191001"
      ],
      "target_text": "Đóa hoa sim rực rỡ mê say",
      "reviewed": true
    },
    {
      "entry_index": 78,
      "uid": "zhcn:f38b75f102f39d815b4a3e3b",
      "kind": "text_data",
      "source_text": "愛を込めて、乾杯の歌を",
      "source_fingerprint": "e11161fcf5be868fe773cefcf158a85ec2549919464501c13dd109d51b162d7b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830191002"
      ],
      "target_text": "Gửi trọn yêu thương vào khúc ca nâng ly",
      "reviewed": true
    },
    {
      "entry_index": 79,
      "uid": "zhcn:6fa0eccaa64b53f95fa42f7d",
      "kind": "text_data",
      "source_text": "そして私は、君を愛す",
      "source_fingerprint": "f83009a69a8f552963ae5deb6a9c301a234d04cf62997b0ddb48cd5527a33f64",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830191003"
      ],
      "target_text": "Và rồi tôi yêu bạn",
      "reviewed": true
    }
