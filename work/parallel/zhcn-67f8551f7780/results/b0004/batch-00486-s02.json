  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:b2ce43fb0d22d567085a1efa",
      "kind": "text_data",
      "source_text": "训练员，TP攒满啦～！\\n为了训练，嘿、嘿、哞！",
      "source_fingerprint": "a4703d2a113c39ee217d8fcca4444375259b70f919ec1864f741414f2d7d8dee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1062"
      ],
      "target_text": "Trainer, TP đầy rồi～！\\nĐể luyện tập, hây, hây, moo!",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:4829cc90b37bf21e6bced29e",
      "kind": "text_data",
      "source_text": "TP已经恢复。我已经做好了准备，\\n只要训练员一到就可以开始训练。",
      "source_fingerprint": "05c0392a26ca96e698d8da0c10e576758caceafef47b375250a3a7519c612533",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1063"
      ],
      "target_text": "TP đã hồi phục. Tôi đã chuẩn bị xong,\\nchỉ cần Trainer tới là có thể bắt đầu luyện tập.",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:37340a12c2acf97a99513497",
      "kind": "text_data",
      "source_text": "TP已满，准备就绪！\\n剩下的就只等你了呢！",
      "source_fingerprint": "03d09c4910eaf3f5406437c11813463522a3e22c80aab6ad4cdb00e2f07053a6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1064"
      ],
      "target_text": "TP đã đầy, sẵn sàng rồi!\\nGiờ chỉ còn chờ bạn thôi!",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:c8bdfe4734e73cf8e6b36876",
      "kind": "text_data",
      "source_text": "LANE：太阳神\\nTP到MAX了！快来练个痛快吧～！",
      "source_fingerprint": "93af70743046c24c2029261c1a4ac3d48a9020c03c8482f20c9858ad966ab859",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1065"
      ],
      "target_text": "LANE：Daitaku Helios\\nTP lên MAX rồi! Mau tới luyện cho đã nào～！",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:4e8c9dc6674d45599a74f8e5",
      "kind": "text_data",
      "source_text": "TP满了哦TP！\\n涡轮引擎启动！",
      "source_fingerprint": "fbacbfd26876070ed3dad5f9b5bb0edaa0b3654f67f3c586faa5129815a18e5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1066"
      ],
      "target_text": "TP đầy rồi đó, TP!\\nĐộng cơ Turbo khởi động!",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:7a0357c833843bf388868943",
      "kind": "text_data",
      "source_text": "TP已经攒满了♪\\n来，让我们开始训练吧！",
      "source_fingerprint": "1d9f31baf35af33cf16407899b00c693a5def7a769cb6f29c6cc9a3fc7d9d162",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1067"
      ],
      "target_text": "TP đã đầy rồi♪\\nNào, bắt đầu luyện tập thôi!",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:c03e8624b120124a415e4631",
      "kind": "text_data",
      "source_text": "训练员，TP攒满了！\\n训练的准备就请交给我吧！",
      "source_fingerprint": "3c95206c555546b922b8aa54425eb9eb57ef0c9f237cc4503a184605b9092929",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1068"
      ],
      "target_text": "Trainer, TP đầy rồi!\\nCứ giao khâu chuẩn bị luyện tập cho tôi!",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:6469332886d6937aabea7a04",
      "kind": "text_data",
      "source_text": "TP好像已经攒得满心花开了！\\n能进行好多好多训练，真是期待呢♪",
      "source_fingerprint": "fe3af8ae048c3da03321ad6096c71be356f99b6d674a65476ecdb1cc775876db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1069"
      ],
      "target_text": "TP hình như đầy đến mức lòng cũng nở hoa rồi!\\nĐược luyện thật nhiều thật nhiều, mong chờ quá đi♪",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:7715da43396946852af7185c",
      "kind": "text_data",
      "source_text": "TP好像全恢复了。也就是说……\\n训练时间到了。跟我来！",
      "source_fingerprint": "ba0ca9a139676d02b34502adc302748f5ff4f36025fe5584a6315690fd786bcd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1070"
      ],
      "target_text": "TP hình như đã hồi phục hoàn toàn. Nghĩa là……\\nĐến giờ luyện tập rồi. Theo tôi!",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:1378ef5d4306a18619a74a0b",
      "kind": "text_data",
      "source_text": "TP已经完全恢复。我会一边认真拉伸，\\n一边在此恭候。",
      "source_fingerprint": "564cd5bea0884e657d10f24112a778c7c2378ae2aaea04be2daa25aaa9900040",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1071"
      ],
      "target_text": "TP đã hồi phục hoàn toàn. Tôi sẽ vừa giãn cơ thật kỹ,\\nvừa chờ bạn ở đây.",
      "reviewed": true
    },
    {
      "entry_index": 50,
      "uid": "zhcn:037c31bdf1de0db94c5c2f35",
      "kind": "text_data",
      "source_text": "TP似乎攒满了！\\n去锻炼吧！这就出发，出发！！",
      "source_fingerprint": "442741995221d7be1125d602dd02757bd60ddb711c48ed43e3d798755857eab9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1072"
      ],
      "target_text": "TP hình như đầy rồi!\\nĐi rèn luyện thôi! Xuất phát nào, xuất phát！！",
      "reviewed": true
    },
    {
      "entry_index": 51,
      "uid": "zhcn:143513c09a36b899dd7442a8",
      "kind": "text_data",
      "source_text": "TP 满格，元气也满格哦！我等着你——咳咳咳咳……！！",
      "source_fingerprint": "50dacaf1750e4c957afe5c890202fdd7288b0ae727d0fe7e5f4086059e8cacc1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1073"
      ],
      "target_text": "TP đầy thanh, tinh thần cũng đầy thanh luôn! Tôi chờ bạn——khụ khụ khụ khụ……！！",
      "reviewed": true
    },
    {
      "entry_index": 52,
      "uid": "zhcn:d1dcbec6720319945806e2c9",
      "kind": "text_data",
      "source_text": "哎呀～？TP好像已经完全恢复了呢～。\\n请在您喜欢的时机叫我吧～。",
      "source_fingerprint": "d5060e04579ba1e9e7c32d7b6a79e74bead6d50c8aa3a4bdddbb353f7948e359",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1074"
      ],
      "target_text": "Ôi chà～？TP hình như đã hồi phục hoàn toàn rồi nhỉ～。\\nKhi nào bạn thích thì cứ gọi tôi nhé～。",
      "reviewed": true
    },
    {
      "entry_index": 53,
      "uid": "zhcn:6c004d8227918f153120bcee",
      "kind": "text_data",
      "source_text": "TP好像恢复了！\\n腿部的状态也完美！我等着你哦！",
      "source_fingerprint": "a6593adae5f0e0ba64e95253a50f637d5ea13af33885e26498acd0f50a4c83bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1076"
      ],
      "target_text": "TP hình như hồi phục rồi!\\nTình trạng đôi chân cũng hoàn hảo! Tôi chờ bạn nhé!",
      "reviewed": true
    },
    {
      "entry_index": 54,
      "uid": "zhcn:ce7467a25ba6f7dbae652196",
      "kind": "text_data",
      "source_text": "训练员，TP好像满了！\\n我先走一步开始热身了哦！",
      "source_fingerprint": "97379f5ad3d7b48a423ef22737ad598e4d97ea8ed078b4eb33e03f43ad11bc28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1077"
      ],
      "target_text": "Trainer, TP hình như đầy rồi!\\nTôi đi trước khởi động nhé!",
      "reviewed": true
    },
    {
      "entry_index": 55,
      "uid": "zhcn:47f36515a09718575c4c280c",
      "kind": "text_data",
      "source_text": "TP好像全恢复了。\\n我会在顺风吹拂的地方等你。",
      "source_fingerprint": "b9829bf58211eb4c8cf0f081113d13edd0990b026a3c45e8ef09b5a13ad83150",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1078"
      ],
      "target_text": "TP hình như đã hồi phục hoàn toàn.\\nTôi sẽ đợi bạn nơi gió thuận chiều thổi qua.",
      "reviewed": true
    },
    {
      "entry_index": 56,
      "uid": "zhcn:66d87b3a6ffed2e6c65c8b99",
      "kind": "text_data",
      "source_text": "TP 已经满了呢。\\n为了船桥的未来，让我们一起不断锻炼吧。",
      "source_fingerprint": "ec123a85ba16ca6416f3f2c0284096463512c90744ce8de19f3bf1d536cb4a86",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1079"
      ],
      "target_text": "TP đã đầy rồi nhỉ.\\nVì tương lai của Funabashi, hãy cùng nhau không ngừng rèn luyện nhé.",
      "reviewed": true
    },
    {
      "entry_index": 57,
      "uid": "zhcn:1e4c498bdfce7f147ffb023e",
      "kind": "text_data",
      "source_text": "训酱，给你个好消息～。\\nTP满了哦。",
      "source_fingerprint": "8bf7d92f91a5545e58473d683a913956991459749a6982d5f165c0113d65b739",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1080"
      ],
      "target_text": "Trainer-chan, có tin vui đây～。\\nTP đầy rồi đó.",
      "reviewed": true
    },
    {
      "entry_index": 58,
      "uid": "zhcn:203818568a4a7a98efb9b8bc",
      "kind": "text_data",
      "source_text": "喂，TP攒满了！\\n我会拼命锻练，让所有人都刮目相看！",
      "source_fingerprint": "67984ec1dcdfece78bdc85e217fe7cef1df180ffaaf30f9e3d7e6b25c22853f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1081"
      ],
      "target_text": "Này, TP đầy rồi!\\nTôi sẽ luyện hết mình để khiến mọi người phải nhìn bằng con mắt khác!",
      "reviewed": true
    },
    {
      "entry_index": 59,
      "uid": "zhcn:317ba951457a851720a268cc",
      "kind": "text_data",
      "source_text": "TP已经攒满了。\\n让我们华丽地开跑吧♪",
      "source_fingerprint": "e5f2718ce4a83672712d530624ffd10d34b7ff7c71a102d0410fc294ce86db6d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1082"
      ],
      "target_text": "TP đã đầy rồi.\\nHãy cùng xuất phát thật lộng lẫy nào♪",
      "reviewed": true
    }
