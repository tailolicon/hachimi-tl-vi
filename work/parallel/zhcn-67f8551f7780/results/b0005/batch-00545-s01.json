    {
      "entry_index": 26,
      "uid": "zhcn:ead0380320ff22c1cb6ccf17",
      "kind": "text_data",
      "source_text": "绝不能错过<color=#ff9900>群英月赛</color>。",
      "source_fingerprint": "67743667cd61e674d147f572524b630b9d53243b3d3df2e37939c48ee0640402",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2101"
      ],
      "target_text": "Tuyệt đối không thể bỏ lỡ <color=#ff9900>Champions Meeting</color>.",
      "reviewed": true
    },
    {
      "entry_index": 27,
      "uid": "zhcn:1c84136ceb068f03f568ccbd",
      "kind": "text_data",
      "source_text": "肯定胜负难料的<color=#ff9900>群英月赛</color>。",
      "source_fingerprint": "8695feac1c0962fa6a028e97469ad9b093e0a049dfaad8c1069974d2b2790917",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2102"
      ],
      "target_text": "<color=#ff9900>Champions Meeting</color> chắc chắn sẽ khó đoán thắng bại.",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:f3eb60228118721556bc8c0e",
      "kind": "text_data",
      "source_text": "竞争激烈的<color=#ff9900>群英月赛 <race_name></color> ROUND2开始。",
      "source_fingerprint": "0e0e10f52353acdc90719f0d567e55b0d5d7722a06c92bc7dc6562a595a740da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2103"
      ],
      "target_text": "<color=#ff9900>Champions Meeting <race_name></color> ROUND2 cạnh tranh khốc liệt bắt đầu.",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:ac1a5edaedf148dd758dede1",
      "kind": "text_data",
      "source_text": "绝对不会停下来，<color=#ff9900>群英月赛\\n<race_name></color> ROUND2。",
      "source_fingerprint": "fd23cddf9fafb5d20ca190eb9b090de085340cbffed7bbb0ecd655a33ae8a468",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2104"
      ],
      "target_text": "Nhất định không dừng lại, <color=#ff9900>Champions Meeting\\n<race_name></color> ROUND2.",
      "reviewed": true
    },
    {
      "entry_index": 30,
      "uid": "zhcn:82429674ad1649b42df16a58",
      "kind": "text_data",
      "source_text": "赛马娘齐聚，<color=#ff9900>群英月赛</color> ROUND2。",
      "source_fingerprint": "b9a4cedf71a5eee1414d73b966189c29afb38ec486f1d016fa5e5c14cbe94aef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2105"
      ],
      "target_text": "Mã Nương tề tựu, <color=#ff9900>Champions Meeting</color> ROUND2.",
      "reviewed": true
    },
    {
      "entry_index": 31,
      "uid": "zhcn:02a3590f2f9ac673387ca21d",
      "kind": "text_data",
      "source_text": "ROUND1结束，强者云集的ROUND2。",
      "source_fingerprint": "f69930f16a0df648713d2fba17772fb274a4f4f13b5263b45a9e3f6df7a4e1b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2106"
      ],
      "target_text": "ROUND1 kết thúc, ROUND2 quy tụ toàn cao thủ.",
      "reviewed": true
    },
    {
      "entry_index": 32,
      "uid": "zhcn:89eae13edc7574162dff1ef8",
      "kind": "text_data",
      "source_text": "王牌云集，仅有三女神才知道结果，备受瞩目的一战。",
      "source_fingerprint": "f3bc2c65b99115d664c9d45ceadce3e95a2f46f5fde017c72ed459b51110ff35",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2200"
      ],
      "target_text": "Các át chủ bài tề tựu, chỉ ba Nữ thần mới biết kết quả của trận đấu được chú ý này.",
      "reviewed": true
    },
    {
      "entry_index": 33,
      "uid": "zhcn:2c970e3f01520b233b0b0522",
      "kind": "text_data",
      "source_text": "从全国各地聚集而来的精锐，在热烈的欢呼声中展现魅力。",
      "source_fingerprint": "abce797f7f15c3dda54d071839b7ba8bd01eb0fd11a00c718dc919c7b2a96631",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2201"
      ],
      "target_text": "Những tinh anh từ khắp cả nước tề tựu, phô diễn sức hút giữa tiếng reo hò cuồng nhiệt.",
      "reviewed": true
    },
    {
      "entry_index": 34,
      "uid": "zhcn:04c72153f2c4ddd427dd44e2",
      "kind": "text_data",
      "source_text": "所有人的实力都是货真价实，谁赢都不奇怪。",
      "source_fingerprint": "389ed646929795cb3d67f43bc5f117ac5fe0d23b26e5708771a398357d8b7a92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2202"
      ],
      "target_text": "Thực lực của tất cả đều là hàng thật, ai chiến thắng cũng chẳng có gì lạ.",
      "reviewed": true
    },
    {
      "entry_index": 35,
      "uid": "zhcn:5f9d800474656c83522447b4",
      "kind": "text_data",
      "source_text": "展翅飞向未来，备受期待的赛马娘们。",
      "source_fingerprint": "28d799f73efa39e2bb85dfc80197c77ae2f42eee67bcbff9a113c3afdea59752",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2203"
      ],
      "target_text": "Những Mã Nương được kỳ vọng dang cánh bay tới tương lai.",
      "reviewed": true
    },
    {
      "entry_index": 36,
      "uid": "zhcn:8a34ff5328400be91af37efb",
      "kind": "text_data",
      "source_text": "参赛的赛马娘都颇具实力。",
      "source_fingerprint": "494c891eb639886ec8887be192835407158e1972d24ba822b1981b2b7d046bbe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2204"
      ],
      "target_text": "Các Mã Nương tham gia đều có thực lực đáng gờm.",
      "reviewed": true
    },
    {
      "entry_index": 37,
      "uid": "zhcn:08d0c6b77361c22c50ebf904",
      "kind": "text_data",
      "source_text": "演员齐聚一堂，受众人瞩目的一战。",
      "source_fingerprint": "6dae00a974a9464e1650949aa577e687eb0084a76065855f8fa23ad0398122ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2205"
      ],
      "target_text": "Dàn tuyển thủ tề tựu, một trận đấu thu hút mọi ánh nhìn.",
      "reviewed": true
    },
    {
      "entry_index": 38,
      "uid": "zhcn:bf85a383a1fb3732f3d76192",
      "kind": "text_data",
      "source_text": "各赛马娘的实力在伯仲之间，能期待是场高水平的竞赛。",
      "source_fingerprint": "af95488caa6b3af0186e27d9d878e280eb77b83e4d1fc77c8b579c4c5163779d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2206"
      ],
      "target_text": "Các Mã Nương có thực lực ngang tài ngang sức, hứa hẹn một cuộc đua đẳng cấp cao.",
      "reviewed": true
    },
    {
      "entry_index": 39,
      "uid": "zhcn:6cda64d2d4d85f176c5164d9",
      "kind": "text_data",
      "source_text": "聚集了难得的优秀成员，是粉丝必看的竞赛。",
      "source_fingerprint": "6b0b77bb1d166abbc1b1f60d7cd196ef68015b29669ad30ef6aac6706813eaed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2207"
      ],
      "target_text": "Quy tụ dàn thành viên xuất sắc hiếm có, đây là cuộc đua fan nhất định phải xem.",
      "reviewed": true
    }
