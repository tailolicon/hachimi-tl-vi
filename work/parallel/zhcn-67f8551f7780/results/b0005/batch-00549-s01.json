  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 20,
  "shard_end_exclusive": 40,
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 20,
      "uid": "zhcn:8fe4a5b167b57ee50c579ffc",
      "kind": "text_data",
      "source_text": "不过成为殿堂赛马娘前在<single_battle_record>留有成绩，实力无庸置疑。",
      "source_fingerprint": "beb60fa593e705f398fc4f97af1b3caa649825fd40b3db355a7457c1ef0c03c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1104"
      ],
      "target_text": "Tuy nhiên, trước khi trở thành Mã Nương được vinh danh, cô ấy đã để lại thành tích <single_battle_record>, nên thực lực là không phải bàn cãi.",
      "reviewed": true
    },
    {
      "entry_index": 21,
      "uid": "zhcn:214fa3a4a2d1fe543237384b",
      "kind": "text_data",
      "source_text": "不过那压倒性的速度，让人不禁感受到胜利的迹象。",
      "source_fingerprint": "e8236a7fc1e7d5bbace2236814c83d953ccf9bcb0409eda4c6930fc880f394fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1105"
      ],
      "target_text": "Nhưng Speed áp đảo ấy khiến người ta không khỏi cảm nhận dấu hiệu của chiến thắng.",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:1f853a0500704e4b687df594",
      "kind": "text_data",
      "source_text": "但其无尽的持久力，能期待持续跑到后期也不会力竭。",
      "source_fingerprint": "fd466982c73092aa873b1445ef0fcc0f8a760bf5f7236957f0e6f4ceb0fc5215",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1106"
      ],
      "target_text": "Nhưng với Stamina dường như vô tận, có thể kỳ vọng cô ấy chạy tới cuối mà không hụt hơi.",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:6a3dd81ef6c3378309be9163",
      "kind": "text_data",
      "source_text": "不过爆发性的力量是其强项，其实力货真价实。",
      "source_fingerprint": "b47d19b6885c5eca3581fc97635d07efca90cd5b155709434ebe6b9c8385f925",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1107"
      ],
      "target_text": "Nhưng Power bùng nổ mới là sở trường, thực lực của cô ấy hoàn toàn chính hiệu.",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:9ae0d247f98f606e1e61fe01",
      "kind": "text_data",
      "source_text": "但与生俱来那不屈的意志力，会随着情势大展所长。",
      "source_fingerprint": "c26fe12f4b935c0047c614e1e709dd77a8aed0f5972cf6ac32ca0d9049aef6c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1108"
      ],
      "target_text": "Nhưng Guts bất khuất bẩm sinh sẽ phát huy tối đa tùy theo tình thế.",
      "reviewed": true
    },
    {
      "entry_index": 25,
      "uid": "zhcn:6038208fbc498e8198a29d73",
      "kind": "text_data",
      "source_text": "不过若是竞赛的展开符合她的精心计算，期待度会大大提升。",
      "source_fingerprint": "5e810bdf3405c7d04004884759895381b6089b667d74f9af04a621ea327fbd68",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1109"
      ],
      "target_text": "Nhưng nếu diễn biến cuộc đua đúng như tính toán kỹ lưỡng của cô ấy, mức kỳ vọng sẽ tăng mạnh.",
      "reviewed": true
    },
    {
      "entry_index": 26,
      "uid": "zhcn:5154ac2bb48e024da1d119c4",
      "kind": "text_data",
      "source_text": "若能合力累积胜利，通往决赛的道路会为她们敞开吗？",
      "source_fingerprint": "c47e119f1d428653c06039e7821f433c62d2b02bf76fe199295bb23d893b3b60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11100"
      ],
      "target_text": "Nếu cùng nhau tích lũy chiến thắng, liệu con đường tới vòng chung kết có mở ra trước họ?",
      "reviewed": true
    },
    {
      "entry_index": 27,
      "uid": "zhcn:ec8f233be9e6e76881ee86b1",
      "kind": "text_data",
      "source_text": "似乎已经掌握了攻略这次大赛的线索。",
      "source_fingerprint": "d7d8a0de40802e6e2a1a99736b601d17c4be8be508ec8c456d28f953b5fddce4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11101"
      ],
      "target_text": "Có vẻ cô ấy đã nắm được manh mối để chinh phục giải đấu lần này.",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:b8b125842977a8deb8fe69bf",
      "kind": "text_data",
      "source_text": "当竞赛按照预定进行时，会展现出惊人的破坏力。",
      "source_fingerprint": "1955f4914e899968cf18aa70ca369e3892b81020c2c8d1f96796bdb77e6db708",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11102"
      ],
      "target_text": "Khi cuộc đua diễn ra đúng kế hoạch, cô ấy sẽ thể hiện sức công phá đáng kinh ngạc.",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:46979d0d18ec881f75669a84",
      "kind": "text_data",
      "source_text": "这次也能引领这场竞赛吗？一定要看！",
      "source_fingerprint": "33a4341ea450e5b0e9851b0e4d21444d68bb9a5ad099d256a476cf7928851b9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11200"
      ],
      "target_text": "Liệu lần này cô ấy vẫn có thể dẫn dắt cuộc đua? Nhất định phải xem!",
      "reviewed": true
    },
    {
      "entry_index": 30,
      "uid": "zhcn:f3771c3e51915a574b56e920",
      "kind": "text_data",
      "source_text": "在这场竞赛中也让人感受到胜利眷顾的存在。",
      "source_fingerprint": "b2e0322bf7ff481d5bb5849d8cfc3e30a569c905f35176415298439038db49f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11201"
      ],
      "target_text": "Ngay trong cuộc đua này cũng có thể cảm nhận vận may chiến thắng đang mỉm cười.",
      "reviewed": true
    },
    {
      "entry_index": 31,
      "uid": "zhcn:0496d3d96896ae478781998d",
      "kind": "text_data",
      "source_text": "也期待她这一战的表现吧。",
      "source_fingerprint": "d4557d507586ce4150217bbd830f2d816774b0f1087931ad27a33d89e4e0796c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11202"
      ],
      "target_text": "Hãy cùng chờ xem màn thể hiện của cô ấy ở trận này.",
      "reviewed": true
    },
    {
      "entry_index": 32,
      "uid": "zhcn:e4949c9fd5f284b09c76d827",
      "kind": "text_data",
      "source_text": "关注其压倒性的速度吧！",
      "source_fingerprint": "592cad9fca31488b793b4477d11d698dbe5421e113de431e8538f07bd4d5c85e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11203"
      ],
      "target_text": "Hãy chú ý đến Speed áp đảo của cô ấy!",
      "reviewed": true
    },
    {
      "entry_index": 33,
      "uid": "zhcn:ab5bd2180fd46cf15fe5a66b",
      "kind": "text_data",
      "source_text": "关注其压倒性的耐力吧！",
      "source_fingerprint": "16c41d5186e95d529f13be1fed0ac17a7109e615d8fcda9d308a05a874cb0ef8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11204"
      ],
      "target_text": "Hãy chú ý đến Stamina áp đảo của cô ấy!",
      "reviewed": true
    },
    {
      "entry_index": 34,
      "uid": "zhcn:8d23097a2c4a85d066c6a083",
      "kind": "text_data",
      "source_text": "关注其压倒性的力量吧！",
      "source_fingerprint": "d1ee6cf6c31688cf707fecd4d27310b0343d2eb6c5d5c29d9d1d54c834452cde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11205"
      ],
      "target_text": "Hãy chú ý đến Power áp đảo của cô ấy!",
      "reviewed": true
    },
    {
      "entry_index": 35,
      "uid": "zhcn:bcc59bd4185338f72b46c320",
      "kind": "text_data",
      "source_text": "关注其压倒性的根性吧！",
      "source_fingerprint": "5df748fea3fa42f61ccef820ffae2f22af5a1a863eaa7605609770208d7a91db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11206"
      ],
      "target_text": "Hãy chú ý đến Guts áp đảo của cô ấy!",
      "reviewed": true
    },
    {
      "entry_index": 36,
      "uid": "zhcn:04a37210b3aaf3263cd510c5",
      "kind": "text_data",
      "source_text": "关注其压倒性的智力吧！",
      "source_fingerprint": "7e6cc85f38daac8eb631cb03fa4541419bfc41a2919c83cc7118e414f9618378",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11207"
      ],
      "target_text": "Hãy chú ý đến Wit áp đảo của cô ấy!",
      "reviewed": true
    },
    {
      "entry_index": 37,
      "uid": "zhcn:e2ca38233516e0d5b192300b",
      "kind": "text_data",
      "source_text": "要关注本次状况良好的表现！",
      "source_fingerprint": "cf3f1bc675404f2bf1bb1766bbb192fe4cd76ae7abab52f16756cd5ec9fc59cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1200"
      ],
      "target_text": "Hãy chú ý màn thể hiện với phong độ tốt lần này!",
      "reviewed": true
    },
    {
      "entry_index": 38,
      "uid": "zhcn:d7fdb5cff0131ca8c27bfd66",
      "kind": "text_data",
      "source_text": "过去5战中获得2胜，战绩优异。",
      "source_fingerprint": "883225ef2797beabc9a0948ad89c48000661d863c2be81ff706267aa9433ff45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12000"
      ],
      "target_text": "Giành 2 chiến thắng trong 5 trận gần nhất, thành tích rất tốt.",
      "reviewed": true
    },
    {
      "entry_index": 39,
      "uid": "zhcn:ea93efff3dca3f1808a19113",
      "kind": "text_data",
      "source_text": "成功以拿下胜利而扬名，是必须关注的赛马娘。",
      "source_fingerprint": "d5deef7f29a0cddd6f3dde2869035b018f56bb05538642df269aaf303cc725b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120000"
      ],
      "target_text": "Mã Nương đáng chú ý, đã tạo dựng danh tiếng bằng những chiến thắng.",
      "reviewed": true
    }
  ],
