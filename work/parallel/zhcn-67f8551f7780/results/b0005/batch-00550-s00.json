      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14101"
      ],
      "target_text": "Màn trình diễn áp đảo đến mức khiến những người xung quanh phải chùn bước, đúng là cường giả trong cường giả.",
      "reviewed": true
