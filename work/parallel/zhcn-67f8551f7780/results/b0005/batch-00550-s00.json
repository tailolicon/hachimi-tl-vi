      "json_path": [
        "203",
        "14001"
      ],
      "target_text": "Tỷ lệ thắng trong 5 cuộc đua gần nhất lên tới 80% đầy ấn tượng.",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:1a9601f3a64e978d38682024",
      "kind": "text_data",
      "source_text": "目前在<color=#ff9900>群英月赛 <race_name></color>的胜率为<total_win_percent>%。",
