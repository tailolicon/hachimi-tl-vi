      ],
      "target_text": "Thực lực chắc chắn thuộc hàng cao nhất.",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:c9773bd7b3a1d88a3957f768",
      "kind": "text_data",
      "source_text": "展现足以让周遭众人感到畏缩的压倒性表现，是强者中的强者。",
