  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:ab3e54b650f512fbebf085a4",
      "kind": "text_data",
      "source_text": "手強いライバルばかりですが、今の心境は？",
      "source_fingerprint": "180686c620ddedd878d8c179572883f7f22e78b28f553cf9e0e98880041f262b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "1356"
      ],
      "target_text": "Toàn là những đối thủ đáng gờm, tâm trạng hiện giờ của bạn thế nào?",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:9cb5e38721262a35568f14fb",
      "kind": "text_data",
      "source_text": "決勝へ向けて、『宣言』はありますか？",
      "source_fingerprint": "6467c60d9f7816e7aaaa3f7465f3618be9b3c419bd18755749f7fba689016297",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "1357"
      ],
      "target_text": "Hướng tới trận chung kết, bạn có lời 『tuyên bố』 nào không?",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:92f4244ac6c7ec75ece10f24",
      "kind": "text_data",
      "source_text": "状态怎么样呢？",
      "source_fingerprint": "381a9d3c904e27eeb92525cc32cb2f64c009c5d931d04d9277f43ebf4e658322",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "136"
      ],
      "target_text": "Tình trạng của bạn thế nào?",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:05a0910d9f889239f9195cec",
      "kind": "text_data",
      "source_text": "竞赛前有什么推荐的放松方法？",
      "source_fingerprint": "05a51be5346e7db4b9042ff61227b5d1197a3e825838c89d80da604eccf95995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "137"
      ],
      "target_text": "Trước cuộc đua, bạn có cách thư giãn nào muốn giới thiệu không?",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:fa78e00efa34761f63120321",
      "kind": "text_data",
      "source_text": "今天早上吃了什么呢？",
      "source_fingerprint": "556c081ab48e581c64ee3a0fc6166399bcaee72c21d70014f723d1eba3334951",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "138"
      ],
      "target_text": "Sáng nay bạn đã ăn gì?",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:6e90afbb42dbb40c1929c63e",
      "kind": "text_data",
      "source_text": "请告诉我们你的期许！",
      "source_fingerprint": "62afe0c7bbf3ab142f57366595e60b9db99da41a122cb10cbb7313ffd7777cd6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "139"
      ],
      "target_text": "Hãy cho chúng tôi biết kỳ vọng của bạn!",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:51a097ef92c4e528fe14f9e8",
      "kind": "text_data",
      "source_text": "请对今天的竞赛发表一句感言！",
      "source_fingerprint": "232f0f49f76568f53c3c7c30f3eae9ce999dfbe7dfd0cbfd262e581346d0ac7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "14"
      ],
      "target_text": "Hãy chia sẻ đôi lời về cuộc đua hôm nay!",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:2a40edebeeea8caa2d2bdaa7",
      "kind": "text_data",
      "source_text": "听说你很喜欢阅读。",
      "source_fingerprint": "c1652e5ea05c3c5afe3cf6799b663d4c7f19c9a4da5b6a76517cc06157a7726a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "140"
      ],
      "target_text": "Nghe nói bạn rất thích đọc sách.",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:22830e073c886685f321cefc",
      "kind": "text_data",
      "source_text": "最喜欢的故事是什么呢？",
      "source_fingerprint": "45cf7984ad68447976930ec54ce461f519ceee2abf33d28889454b1b2a79fa10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "141"
      ],
      "target_text": "Câu chuyện bạn yêu thích nhất là gì?",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:9f1c3942f0fe38910ff38cd7",
      "kind": "text_data",
      "source_text": "请谈谈你的抱负。",
      "source_fingerprint": "6cb3e5be35ae8bed9c53d3d96222212a95919bb80ceed9b04dcb7c89992b4d10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "142"
      ],
      "target_text": "Hãy chia sẻ về hoài bão của bạn.",
      "reviewed": true
    },
    {
      "entry_index": 50,
      "uid": "zhcn:811370102a9fbc904f25159a",
      "kind": "text_data",
      "source_text": "你总是会很认真地保养指甲呢。",
      "source_fingerprint": "00a47ff8b8a4e4feaaf243589a5f51cf0ebf565cbb9690526dddca97758b4818",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "143"
      ],
      "target_text": "Bạn lúc nào cũng chăm sóc móng rất kỹ nhỉ.",
      "reviewed": true
    },
    {
      "entry_index": 51,
      "uid": "zhcn:eb19249d4a5b28c8681e6994",
      "kind": "text_data",
      "source_text": "有什么在竞赛前一定会做的事情吗？",
      "source_fingerprint": "61029e3310f1f87abf12c6f08c982bc6b37604330617488ee2e2949a2af660ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "144"
      ],
      "target_text": "Có việc gì bạn nhất định sẽ làm trước cuộc đua không?",
      "reviewed": true
    },
    {
      "entry_index": 52,
      "uid": "zhcn:ab75f7953d584c83809fa500",
      "kind": "text_data",
      "source_text": "直白地说，有多少胜率呢？",
      "source_fingerprint": "6c874201800484dbbd0389ca2c311b248d4e7acfb4ed659b2ab5c5e68d2ec3cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "145"
      ],
      "target_text": "Nói thẳng nhé, tỷ lệ thắng là bao nhiêu?",
      "reviewed": true
    },
    {
      "entry_index": 53,
      "uid": "zhcn:2d343cccda6477dcf526f09f",
      "kind": "text_data",
      "source_text": "有什么作战策略吗？",
      "source_fingerprint": "3e83dfd15e2b94c319d89c327d18eb8a73bd63cebe1e9a73fa005bc92a419dae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "146"
      ],
      "target_text": "Bạn có chiến thuật gì không?",
      "reviewed": true
    },
    {
      "entry_index": 54,
      "uid": "zhcn:a9de148a76b28018457c218f",
      "kind": "text_data",
      "source_text": "请对竞争对手们说句话。",
      "source_fingerprint": "7ad637da9854fa3aea1c0a9040f7ef18f4ac406dc62226aa4157cfae6c99ddc4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "147"
      ],
      "target_text": "Hãy nói đôi lời với các đối thủ.",
      "reviewed": true
    },
    {
      "entry_index": 55,
      "uid": "zhcn:1c5c859c3f890b5a5cae7d1c",
      "kind": "text_data",
      "source_text": "这场比赛我会为你加油！",
      "source_fingerprint": "92a19167c9a233b59c111a6b6e792af79585abe6fccf239bf839a53274b215ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "148"
      ],
      "target_text": "Ở Cuộc đua này, tôi sẽ cổ vũ bạn!",
      "reviewed": true
    },
    {
      "entry_index": 56,
      "uid": "zhcn:31a70a44547af21b89d4e9d3",
      "kind": "text_data",
      "source_text": "听说你很擅长玩游戏？",
      "source_fingerprint": "339037674b1d83af451bfdbe4cd9d3abacaec54a1d99edc14f95cfe9d2518b20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "149"
      ],
      "target_text": "Nghe nói bạn chơi game rất giỏi?",
      "reviewed": true
    },
    {
      "entry_index": 57,
      "uid": "zhcn:8797de95235da0d08cb325e4",
      "kind": "text_data",
      "source_text": "最近有感兴趣的舞台表演吗？",
      "source_fingerprint": "2f780eb604edad57f68ef06075b091a29131a47b8aaa9c90d3751106b0e43998",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "15"
      ],
      "target_text": "Gần đây có màn biểu diễn sân khấu nào khiến bạn hứng thú không?",
      "reviewed": true
    },
    {
      "entry_index": 58,
      "uid": "zhcn:7d5340623d0735296251e0ba",
      "kind": "text_data",
      "source_text": "有强悍的秘诀吗？",
      "source_fingerprint": "e62ad319242c06e58272bafe42f23f8dc2db4f6f5a2dfbe6bb38bae2dc276c0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "150"
      ],
      "target_text": "Bạn có bí quyết nào để trở nên mạnh mẽ không?",
