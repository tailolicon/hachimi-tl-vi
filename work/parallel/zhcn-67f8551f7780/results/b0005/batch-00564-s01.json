  "entries": [
    {
      "entry_index": 20,
      "uid": "zhcn:7f74e392592f0f19345a162e",
      "kind": "text_data",
      "source_text": "请告诉我们你推荐的蛋糕。",
      "source_fingerprint": "31cdb32954b1ae8f71b0854ddf936576217a73e849327f1cce4528029ff7c8ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "477"
      ],
      "target_text": "Bạn có món bánh nào muốn giới thiệu không?",
      "reviewed": true
    },
    {
      "entry_index": 21,
      "uid": "zhcn:44b77402209ab2ee8cb5d055",
      "kind": "text_data",
      "source_text": "竞赛前有一定会做的例行公事吗？",
      "source_fingerprint": "b8d979824f772e97a57ea17e4d58d77a71626c7fd9d74b702d60a3ae4b45b24e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "478"
      ],
      "target_text": "Trước cuộc đua, bạn có thói quen nào nhất định phải làm không?",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:a2e6d2f5b460e2ec968c14fd",
      "kind": "text_data",
      "source_text": "对于竞赛，有什么从平常就会注意的事情吗？",
      "source_fingerprint": "132455adef026da36348ae645a8fa1a42dcf477a6b173d6425346283836ddceb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "479"
      ],
      "target_text": "Để chuẩn bị cho các cuộc đua, bình thường bạn có điều gì luôn chú ý không?",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:1c0c3aeb1b19824ccc3483c5",
      "kind": "text_data",
      "source_text": "有必胜方法吗？",
      "source_fingerprint": "940cc73da55ff87dda08f4da2909d0262690150d90dd1939346f535da4b08c1b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "48"
      ],
      "target_text": "Bạn có bí quyết nào để chắc thắng không?",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:66f85c7d20ea96b48cd45b10",
      "kind": "text_data",
      "source_text": "有正在关注的赛马娘吗？",
      "source_fingerprint": "dae9153ff57eb86d62cefce7ca313a0308ac958b1c2fa22a3455b90c9082feab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "480"
      ],
      "target_text": "Có Mã Nương nào bạn đang chú ý không?",
      "reviewed": true
    },
    {
      "entry_index": 25,
      "uid": "zhcn:0f3dc852109cc5d5c8daf867",
      "kind": "text_data",
      "source_text": "请告诉我们你对今天竞赛的期许。",
      "source_fingerprint": "9dff7582ada1fd2dd53d406300cb564867ca0169783bc55164aac2300dca5186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "481"
      ],
      "target_text": "Hãy cho chúng tôi biết kỳ vọng của bạn về cuộc đua hôm nay.",
      "reviewed": true
    },
    {
      "entry_index": 26,
      "uid": "zhcn:e9df8808b4156933861e54ab",
      "kind": "text_data",
      "source_text": "有什么事情是每天都会留意的？",
      "source_fingerprint": "873c3830df46d15c08dd0634cbb94cd2f0e02cf837cc467e5ddd0d9165275f76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "482"
      ],
      "target_text": "Có điều gì bạn luôn chú ý mỗi ngày không?",
      "reviewed": true
    },
    {
      "entry_index": 27,
      "uid": "zhcn:55fba0ae6e16ffe9893436b5",
      "kind": "text_data",
      "source_text": "你认为在竞赛中最重要的事情是什么？",
      "source_fingerprint": "3d00941d76605b0bf22f97911a2aa2b67da5bf5ae3b2eed8fad383b52b34948d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "483"
      ],
      "target_text": "Theo bạn, điều quan trọng nhất trong một cuộc đua là gì?",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:e0cf43d8eabe7bc7e9c83130",
      "kind": "text_data",
      "source_text": "听说你作为模特儿也很受欢迎呢！",
      "source_fingerprint": "63d9eacd944bfaf98ee1fdc2208c3bd87fe1c7089b7eeb2bee8399fd14ce9100",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "484"
      ],
      "target_text": "Nghe nói bạn cũng rất được yêu thích với vai trò người mẫu!",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:30e72dccd502c347a6b25b6a",
      "kind": "text_data",
      "source_text": "有正在关注的赛马娘吗？",
      "source_fingerprint": "dae9153ff57eb86d62cefce7ca313a0308ac958b1c2fa22a3455b90c9082feab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "485"
      ],
      "target_text": "Có Mã Nương nào bạn đang chú ý không?",
      "reviewed": true
    },
    {
      "entry_index": 30,
      "uid": "zhcn:2403818b7787c1a2486d7f39",
      "kind": "text_data",
      "source_text": "你有着即使在竞赛中也很美丽耀眼的发色呢。",
      "source_fingerprint": "b87fec3b6bb62d43bfb140e22690cf2356126eb1034a43d02cde2d028d748445",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "486"
      ],
      "target_text": "Màu tóc của bạn thật đẹp và nổi bật ngay cả khi thi đấu nhỉ.",
      "reviewed": true
    },
    {
      "entry_index": 31,
      "uid": "zhcn:0395603054089beae3e5b3d5",
      "kind": "text_data",
      "source_text": "请偷偷告诉我们胜利的秘诀！",
      "source_fingerprint": "1765c70f946969fcd6fc6cfd44a4744f76e24d2ea8ac8bfee8437be3cc6fe065",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "487"
      ],
      "target_text": "Hãy bí mật bật mí cho chúng tôi bí quyết chiến thắng nhé!",
      "reviewed": true
    },
    {
      "entry_index": 32,
      "uid": "zhcn:119db5a7a6b96c3f5f76d19e",
      "kind": "text_data",
      "source_text": "请以班长的身份对班上同学说句话！",
      "source_fingerprint": "6a8e5ef188264f1f11246fecfab7a60a3dd3d0adb0d1203b99d72325bc74128c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "488"
      ],
      "target_text": "Với tư cách lớp trưởng, hãy nói đôi lời với các bạn cùng lớp!",
      "reviewed": true
    },
    {
      "entry_index": 33,
      "uid": "zhcn:602ae32fbbf4cb3f9fb4e54c",
      "kind": "text_data",
      "source_text": "请用四字成语讲出抱负！",
      "source_fingerprint": "81fa773378f4376c4c5256a0819c47aae0c48745edabece9c73259292ebc5d04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "489"
      ],
      "target_text": "Hãy dùng một thành ngữ bốn chữ để nói lên hoài bão của bạn!",
      "reviewed": true
    },
    {
      "entry_index": 34,
      "uid": "zhcn:de5a33ad6ae27b29a1f0f3b4",
      "kind": "text_data",
      "source_text": "请以学生会长的身份对学园的大家说句话！",
      "source_fingerprint": "4b08f40d03e9fce9e2578080460aac2543759f7fb381016a6cbc5f1797327186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "49"
      ],
      "target_text": "Với tư cách chủ tịch hội học sinh, hãy nói đôi lời với mọi người trong học viện!",
      "reviewed": true
    },
    {
      "entry_index": 35,
      "uid": "zhcn:96c1f2eafd15f1c0cacad962",
      "kind": "text_data",
      "source_text": "有什么实力坚强的祕诀吗？",
      "source_fingerprint": "1998aff469caad818d10739dbd5b1ed2e6af4bf50a928b33b28a57c499c5f0fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "490"
      ],
      "target_text": "Có bí quyết nào để trở nên mạnh mẽ như vậy không?",
      "reviewed": true
    },
    {
      "entry_index": 36,
      "uid": "zhcn:317a7632b06e8b829a7d3f5d",
      "kind": "text_data",
      "source_text": "意思是你最近热衷于打工吗？",
      "source_fingerprint": "c7579218a2939e8304955e610e35ec6fc066fcf2c4e541c478b92606922f2cd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "491"
      ],
      "target_text": "Ý là gần đây bạn rất hăng hái đi làm thêm sao?",
      "reviewed": true
    },
    {
      "entry_index": 37,
      "uid": "zhcn:95ec2db6d35d26614f21161e",
      "kind": "text_data",
      "source_text": "直白地说「可能性」的意思是？",
      "source_fingerprint": "5c8d358baa0d4d8c06be89c165b5e661fe75425d11148e4b531e0ba95395ee2e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "492"
      ],
      "target_text": "Nói thẳng ra thì, 「khả năng」 nghĩa là gì?",
      "reviewed": true
    },
    {
      "entry_index": 38,
      "uid": "zhcn:3e9335d4af8836b55140c02f",
      "kind": "text_data",
      "source_text": "有竞赛的必胜方法吗？",
      "source_fingerprint": "2f0ec8e6ba3eba88fcd85258e746cf3c543a170b784080cd7794f4382b63562b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "493"
      ],
      "target_text": "Có bí quyết nào để chắc thắng trong cuộc đua không?",
      "reviewed": true
    },
    {
      "entry_index": 39,
      "uid": "zhcn:557e4ab2a46b28a697032fcc",
      "kind": "text_data",
      "source_text": "请告诉我们你有多少信心！",
      "source_fingerprint": "67c0566acc0b1baaec4166a4b09ab0476d2b538afdf2961a929d0d678d847706",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "494"
      ],
      "target_text": "Hãy cho chúng tôi biết bạn tự tin đến mức nào!",
      "reviewed": true
    }
