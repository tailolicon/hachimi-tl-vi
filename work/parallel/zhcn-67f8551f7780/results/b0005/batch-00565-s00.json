  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:860d6540ac7a7acd0853ac38",
      "kind": "text_data",
      "source_text": "最近发现的美丽是？",
      "source_fingerprint": "cdd0f8a053c940ce847ea76a61f59da29dc9efad64b60ba56876c6409dcfb137",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "530"
      ],
      "target_text": "Gần đây, bạn mới khám phá ra vẻ đẹp nào?",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:1e388cd9d88963b0da8243ab",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "531"
      ],
      "target_text": "Hãy nói đôi lời với các đối thủ mạnh!",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:034291ca6b2132296a8073d1",
      "kind": "text_data",
      "source_text": "有多少把握……不，有多少运气？",
      "source_fingerprint": "6afe40e0bd50f6dec30bd1e2d073b73d8b89eb98a44ad6145637605be5a4bf4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "532"
      ],
      "target_text": "Bạn tự tin bao nhiêu phần… à không, may mắn bao nhiêu phần?",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:24020bab750d92ea5329001d",
      "kind": "text_data",
      "source_text": "虽然很突然，可以请你帮我占卜一下吗？",
      "source_fingerprint": "66d245592203f602e5337fec7bb4d32d91b2c4037ac78631d7c1b00225ff8339",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "533"
      ],
      "target_text": "Hơi đột ngột, nhưng bạn có thể bói giúp tôi một quẻ không?",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:141d0d23fe252f88c53b60b4",
      "kind": "text_data",
      "source_text": "福气会降临吗？",
      "source_fingerprint": "5a05348f715b06713a5fa1bb2ef23e007c7ec9320bbb040768a514f440a398ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "534"
      ],
      "target_text": "May mắn sẽ đến chứ?",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:6bc42fb75b0cebf37ec540f9",
      "kind": "text_data",
      "source_text": "请告诉我们你在比赛前的期许。",
      "source_fingerprint": "22d4ccfb0772d6fb67359d87bc1a0ba63e6d05f8de6ef734b1db43d11be67faa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "535"
      ],
      "target_text": "Hãy cho chúng tôi biết kỳ vọng của bạn trước Cuộc đua.",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:318c2d6af124da315e41d04f",
      "kind": "text_data",
      "source_text": "这场比赛有很多位强者喔？",
      "source_fingerprint": "84293ddf08d5a1e4586d900dc94ddc8cb16e1c50effcd19842aface040391f45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "536"
      ],
      "target_text": "Cuộc đua này có rất nhiều đối thủ mạnh đấy?",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:1d58f2700e09b1399f4698df",
      "kind": "text_data",
      "source_text": "你看起来心情非常好，遇上什么好事了吗？",
      "source_fingerprint": "e15705a70c8e2ec129b061b064bca2c6814f5f67d0b2cde861807d66055ef60c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "537"
      ],
      "target_text": "Trông bạn có vẻ rất vui, có chuyện gì tốt đẹp sao?",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:bc6c4cecde12e6b2bb0b1684",
      "kind": "text_data",
      "source_text": "请说说抱负──呃，还好吗？你脸色有点……",
      "source_fingerprint": "371cff6facd734922f540fa772410d778e29c9a3305278dac5ec25bba66c0160",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "538"
      ],
      "target_text": "Hãy nói về hoài bão của bạn──ơ, bạn ổn chứ? Sắc mặt có vẻ……",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:c7a142d2598ff527828577b5",
      "kind": "text_data",
      "source_text": "请告诉我们你当作目标的对象。",
      "source_fingerprint": "fcd065493ad700887062846739f4a5483cbdac9c49891ab6235c3a1967a486b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "539"
      ],
      "target_text": "Hãy cho chúng tôi biết người mà bạn lấy làm mục tiêu.",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:13a149cd48bee9aa4e7fe92a",
      "kind": "text_data",
      "source_text": "请告诉我们不会紧张的诀窍。",
      "source_fingerprint": "59732d13f75b8d0e7fc6f69c9885498df4f4e48c077afad712c87913d5ea4185",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "54"
      ],
      "target_text": "Hãy cho chúng tôi biết bí quyết để không căng thẳng.",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:95ee9647dbf5078f0d690ab4",
      "kind": "text_data",
      "source_text": "简单来说，胜利的秘诀是！？",
      "source_fingerprint": "0ff3d96bbce3120a567d96bf3ae2ad18e24a9b575869dce9c246816b2b26a51a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "540"
      ],
      "target_text": "Nói ngắn gọn, bí quyết chiến thắng là！？",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:3a62d10f97ade0c660a80b56",
      "kind": "text_data",
      "source_text": "好像有什么很香的味道？",
      "source_fingerprint": "f5ee03c12b1548c9f79f0fa872901f7196bf30d1940b29f6f57a35780306d842",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "541"
      ],
      "target_text": "Hình như có mùi gì thơm lắm thì phải?",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:d448ef5e71093dbab2246826",
      "kind": "text_data",
      "source_text": "家人是不是都会叫你「小多」之类的？",
      "source_fingerprint": "c63cc737a969b6b3f0399ef0351ba13cbe1b4c417a80178eb9a5462678658cff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "542"
      ],
      "target_text": "Gia đình thường gọi bạn kiểu như 「bé Đa」, đúng không?",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:13a1fad427f0727bbbb51a50",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "543"
      ],
      "target_text": "Hãy nói đôi lời với người hâm mộ!",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:c7f5cc27cf1a113f27dc0407",
      "kind": "text_data",
      "source_text": "听说你常看电视购物节目，最近有推荐的节目吗？",
      "source_fingerprint": "1a818539d5b589a03f412535c0ac4ed8234cc0c90cb9cfc9821ff8a4d40b6ae4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "544"
      ],
      "target_text": "Nghe nói bạn hay xem chương trình mua sắm trên TV, gần đây có chương trình nào muốn giới thiệu không?",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:c1057f7c551d8cfe26968ac7",
      "kind": "text_data",
      "source_text": "请用福冈腔说说抱负。",
      "source_fingerprint": "dfdd53bda620cc463cae579dd6ab0ad0d64b3035e07b8889cf54c07eb4802828",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "545"
      ],
      "target_text": "Hãy nói về hoài bão bằng giọng Fukuoka.",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:9dc118e76b0e70051eec2d4b",
      "kind": "text_data",
      "source_text": "期待你能拿出安定感非凡的表现纵横赛场！",
      "source_fingerprint": "07c3b87883ac1e9e7e574fc4e322c9c03474f31808e081bd173c05b4da82d687",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "546"
      ],
      "target_text": "Mong chờ màn thể hiện ổn định phi thường của bạn tung hoành trên đường đua!",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:d02b4c5b45dd376026657369",
      "kind": "text_data",
      "source_text": "针对竞赛做了多少跑步训练呢？",
      "source_fingerprint": "b9897adb7b91482892537c91de7ad8363625284939dae0181f2f9c2afd871622",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "547"
      ],
      "target_text": "Bạn đã tập chạy bao nhiêu để chuẩn bị cho cuộc đua?",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:30ff9a33359a7a9e4198fcbc",
      "kind": "text_data",
      "source_text": "最近有遇到什么失误吗？",
      "source_fingerprint": "45bef4fc162d8dba4f1d45c120193a69c2d072eadbd0ee86be7228f3f7a2c397",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "548"
      ],
      "target_text": "Gần đây bạn có mắc sai sót nào không?",
      "reviewed": true
    }
  ],
