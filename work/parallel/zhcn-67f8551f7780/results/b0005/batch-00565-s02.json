    {"entry_index":44,"uid":"zhcn:b68a37ff72d64911258278d0","kind":"text_data","source_text":"本次的竞赛，会是高手云集吗？","source_fingerprint":"70fa1115ea526e0c1b0ade626b106dc064ad27604cca9ca6ef1270eea54766a5","source_path":"text_data_dict.json","json_path":["204","570"],"target_text":"Cuộc đua lần này có quy tụ nhiều cao thủ không?","reviewed":true},
    {"entry_index":45,"uid":"zhcn:4df3c09779a1fb8b31a6010d","kind":"text_data","source_text":"就快到决赛了，状况如何？","source_fingerprint":"9630e42d5c9d012871840bbd197b921fb58e1c9b32eae3a940fe02875fb56c78","source_path":"text_data_dict.json","json_path":["204","571"],"target_text":"Chung kết sắp đến rồi, tình trạng của bạn thế nào?","reviewed":true},
    {"entry_index":46,"uid":"zhcn:630865b9e08d6728f5727799","kind":"text_data","source_text":"会觉得紧张吗？","source_fingerprint":"3b6efe49e3ea4e77f0d196cc0d23da9389f3adb0d159bc4709603985686340a0","source_path":"text_data_dict.json","json_path":["204","572"],"target_text":"Bạn có cảm thấy căng thẳng không?","reviewed":true},
