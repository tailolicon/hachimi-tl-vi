    {"entry_index":49,"uid":"zhcn:bc59a743520c69b0d63ec40e","kind":"text_data","source_text":"确定进入决赛时的心情是？","source_fingerprint":"aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3","source_path":"text_data_dict.json","json_path":["204","575"],"target_text":"Bạn cảm thấy thế nào khi biết mình đã vào chung kết?","reviewed":true},
