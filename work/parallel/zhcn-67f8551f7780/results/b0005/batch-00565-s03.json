  "entries": [
    {"entry_index":60,"uid":"zhcn:0a5cff0ce29219747be86348","kind":"text_data","source_text":"请对支持你的家人说句话！","source_fingerprint":"c32438522fb770add8dfde2d8c39210783febf99e5b3e67a28982999ade2fe38","source_path":"text_data_dict.json","json_path":["204","585"],"target_text":"Hãy nói đôi lời với gia đình luôn ủng hộ bạn!","reviewed":true},
    {"entry_index":61,"uid":"zhcn:81813eeb1452e0a50e9a4f49","kind":"text_data","source_text":"我的推就是爱丽数码，我会为你加油的！","source_fingerprint":"b11b27df18fd4e3235ce43642253db9d08032a525bf3b4b9aa5d518f06b84cfc","source_path":"text_data_dict.json","json_path":["204","586"],"target_text":"Thần tượng tôi yêu thích nhất là Agnes Digital, tôi sẽ cổ vũ cho bạn!","reviewed":true},
    {"entry_index":62,"uid":"zhcn:58bc11cc2cb35466563d13f0","kind":"text_data","source_text":"决赛在即，请谈谈你的抱负。","source_fingerprint":"62f4225de557f17e34be1468a793de97699494597c534e3c052a67b7d6838897","source_path":"text_data_dict.json","json_path":["204","587"],"target_text":"Chung kết sắp tới, hãy chia sẻ hoài bão của bạn.","reviewed":true},
    {"entry_index":63,"uid":"zhcn:5f553027d5ec38404073948a","kind":"text_data","source_text":"昨天做了怎么样的梦呢？","source_fingerprint":"38cf6edb38e46bd82a646068164fa4018b31a915248798a97df78a932f667ba9","source_path":"text_data_dict.json","json_path":["204","588"],"target_text":"Hôm qua bạn đã mơ giấc mơ như thế nào?","reviewed":true},
    {"entry_index":64,"uid":"zhcn:e8bfafc880b169f073a83a4f","kind":"text_data","source_text":"请对同年级的大家，说说你的抱负！","source_fingerprint":"f6dfd312b5e03b79d3678c2dfdde2e4faecf658c83de1a3342960854f692d081","source_path":"text_data_dict.json","json_path":["204","589"],"target_text":"Hãy chia sẻ hoài bão của bạn với mọi người cùng khối!","reviewed":true},
    {"entry_index":65,"uid":"zhcn:708081eb0a033105e6ee3e10","kind":"text_data","source_text":"跟你要好的猫咪过得还好吗？","source_fingerprint":"2eaae4f30d4c4a5db10801f122cbfb06cd85f9574aa075883038e16af9eab7f2","source_path":"text_data_dict.json","json_path":["204","59"],"target_text":"Chú mèo thân với bạn vẫn khỏe chứ?","reviewed":true},
    {"entry_index":66,"uid":"zhcn:c944f9c058deb74cff8779e3","kind":"text_data","source_text":"决赛结束后，你想做什么呢？","source_fingerprint":"316f7da4f2c0e89bf593997dd593dac0bbd865e5b577d0fb05bba5595a4a95a0","source_path":"text_data_dict.json","json_path":["204","590"],"target_text":"Sau khi chung kết kết thúc, bạn muốn làm gì?","reviewed":true},
    {"entry_index":67,"uid":"zhcn:42477ccc9916115bb803ecdd","kind":"text_data","source_text":"请对一同出赛的对手们宣战吧！","source_fingerprint":"ac0c416fc871ddcb18c5adc59598a0e8186aaf3bbcbfd13e3624de7805d5ae09","source_path":"text_data_dict.json","json_path":["204","591"],"target_text":"Hãy gửi lời tuyên chiến tới các đối thủ cùng tham gia!","reviewed":true},
    {"entry_index":68,"uid":"zhcn:d6ffe21c8bb3ec0394686df1","kind":"text_data","source_text":"请针对决赛发表发表一句感言！","source_fingerprint":"15608e22528142921eb74a51a43b754ba878306772954e713488103d58b42525","source_path":"text_data_dict.json","json_path":["204","592"],"target_text":"Hãy nói một câu cảm nghĩ về trận chung kết!","reviewed":true},
    {"entry_index":69,"uid":"zhcn:878f33fdfc557b733587c9b8","kind":"text_data","source_text":"有信心获得优胜吗？","source_fingerprint":"ff02efb6b31f4ee36a5ac3cee3cc69ba89bebbe84a0ceba8ec7c29988b0ca6fe","source_path":"text_data_dict.json","json_path":["204","593"],"target_text":"Bạn có tự tin giành chiến thắng không?","reviewed":true},
    {"entry_index":70,"uid":"zhcn:84c4404d5cbbe153f43221f9","kind":"text_data","source_text":"简单来说，胜利方程式是！？","source_fingerprint":"e0ed230c0bf259f8ec2c9e7eefdd04c8bed826868276ed0d05075e6f2f2a0eca","source_path":"text_data_dict.json","json_path":["204","594"],"target_text":"Nói ngắn gọn, công thức chiến thắng là gì!?","reviewed":true},
    {"entry_index":71,"uid":"zhcn:8ece9819970f1f7ed5fe82ff","kind":"text_data","source_text":"至今曾面临过怎么样的障碍呢？","source_fingerprint":"765ff3b28647f57bf7c5eebf74f791b94b7ccb29212f1e304eab522d3376dbbe","source_path":"text_data_dict.json","json_path":["204","595"],"target_text":"Cho tới nay bạn từng phải đối mặt với những trở ngại nào?","reviewed":true},
    {"entry_index":72,"uid":"zhcn:547f4db3569c78539ad54c25","kind":"text_data","source_text":"这次也是强者云集呢。","source_fingerprint":"7e990e5b8b2edd2622e366582df104a44510db8753ca1fa3fa2b3f36dfbd815c","source_path":"text_data_dict.json","json_path":["204","596"],"target_text":"Lần này cũng quy tụ toàn cao thủ nhỉ.","reviewed":true},
    {"entry_index":73,"uid":"zhcn:dc8cfc74f7b1eaedc0caf0dc","kind":"text_data","source_text":"终于要到决赛了！请问有多少把握？","source_fingerprint":"e2f97e4fd9dbe759dd43a1cfe32f373c7c2db03d5cf0b4085ae16c87635aa6a8","source_path":"text_data_dict.json","json_path":["204","597"],"target_text":"Cuối cùng cũng đến chung kết! Bạn tự tin đến mức nào?","reviewed":true},
    {"entry_index":74,"uid":"zhcn:954eaafbba950fa56da52aa1","kind":"text_data","source_text":"请告诉我们你对于决赛的抱负。","source_fingerprint":"98de95fc17b3e22752a6bdc06aede85d57f5183f2a4a701b5aa4e7463a1467f8","source_path":"text_data_dict.json","json_path":["204","598"],"target_text":"Hãy cho chúng tôi biết hoài bão của bạn cho trận chung kết.","reviewed":true},
    {"entry_index":75,"uid":"zhcn:8e1806cc55003558639640a7","kind":"text_data","source_text":"期待你获得优胜！","source_fingerprint":"523f8940c89d63ae5057a2fbb283dda0216d6a6d0c3cacd15e77bdfbae689bf3","source_path":"text_data_dict.json","json_path":["204","599"],"target_text":"Mong bạn giành chiến thắng!","reviewed":true},
    {"entry_index":76,"uid":"zhcn:ac027465f3ca7340fd176d1b","kind":"text_data","source_text":"听见粉丝的声援，有什么感想吗？","source_fingerprint":"118edecc7999f4ee934dedf2548120af5c92a723404dcf786a3d605cb0be3c5b","source_path":"text_data_dict.json","json_path":["204","6"],"target_text":"Khi nghe tiếng cổ vũ của người hâm mộ, bạn cảm thấy thế nào?","reviewed":true},
    {"entry_index":77,"uid":"zhcn:4ef79371b76d22492a1e177f","kind":"text_data","source_text":"请告诉我们胜利的秘诀。","source_fingerprint":"101ef869ca1844732c0caef7d06b423da699e8c32dcff4849b9677c43475577e","source_path":"text_data_dict.json","json_path":["204","60"],"target_text":"Hãy cho chúng tôi biết bí quyết chiến thắng.","reviewed":true},
    {"entry_index":78,"uid":"zhcn:e94694badd479e69acf67693","kind":"text_data","source_text":"确定进入决赛时的心情是？","source_fingerprint":"aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3","source_path":"text_data_dict.json","json_path":["204","600"],"target_text":"Bạn cảm thấy thế nào khi biết mình đã vào chung kết?","reviewed":true},
    {"entry_index":79,"uid":"zhcn:ff031de2e85a8d3ccd77e0df","kind":"text_data","source_text":"请露出笑容，让我们拍1张刊登用的照片。","source_fingerprint":"702d01163727082940a64b0d84ed8928c7d4e9eddc5d0cfa75457ebc6af148e4","source_path":"text_data_dict.json","json_path":["204","601"],"target_text":"Hãy mỉm cười để chúng tôi chụp 1 tấm ảnh đăng báo.","reviewed":true}
  ]
