      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "689"
      ],
      "target_text": "Mọi người đều dự đoán đây sẽ là một cuộc đua quyết liệt. Tâm trạng của bạn lúc này thế nào?",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:58ada97b829ce18d02075200",
      "kind": "text_data",
      "source_text": "有特别努力克服的课题吗？",
      "source_fingerprint": "586188be76723cd96e4ed56fe170cc6f9700944d540863bed3cf90f509e27da1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "69"
      ],
      "target_text": "Có thử thách nào bạn đặc biệt nỗ lực để vượt qua không?",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:dc9015566032cee325451dc8",
      "kind": "text_data",
      "source_text": "在决赛中会让我们见识到怎么样的表现呢？",
      "source_fingerprint": "eb9f7adc4539303ee1d4688547461581016dbc599b6dcf378c343eb89c78ccb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "690"
      ],
      "target_text": "Bạn sẽ cho chúng tôi thấy màn trình diễn như thế nào ở chung kết?",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:d3a2eb00a502c2e6d26ce32b",
      "kind": "text_data",
      "source_text": "请对位于美国的双亲说些话！",
      "source_fingerprint": "7f973e65242045cd8579052c9e4e3e6f86ceb11d66d24f6d20d632945cdfc60b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "691"
      ],
      "target_text": "Hãy nhắn đôi lời tới cha mẹ bạn đang ở Mỹ!",
      "reviewed": true
