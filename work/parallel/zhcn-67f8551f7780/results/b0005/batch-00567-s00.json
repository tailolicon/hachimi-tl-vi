      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "676"
      ],
      "target_text": "Bạn muốn ai chứng kiến cuộc đua này?",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:63666e8593195f7b8770540d",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "677"
      ],
      "target_text": "Hãy nhắn đôi lời tới các đối thủ đáng gờm!",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:f7b9d68fb24242c5be79fbbb",
      "kind": "text_data",
      "source_text": "请对崇拜你的后辈们说句话！",
      "source_fingerprint": "80104f428486dfeef057f8e3e5976abc0ac50ec4b3c3ebcef5272c06843d1dca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "678"
      ],
      "target_text": "Hãy nhắn đôi lời tới những đàn em ngưỡng mộ bạn!",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:5451571d247a1771b6550b00",
      "kind": "text_data",
      "source_text": "希望我们在竞赛中关注哪些地方呢？",
      "source_fingerprint": "acd7849ced480e4b1bd51f95942cca0e61df706efa0e533508ea511763c39c22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "679"
      ],
      "target_text": "Bạn muốn chúng tôi chú ý điều gì trong cuộc đua?",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:2f6493a42dbb062eaa645381",
      "kind": "text_data",
      "source_text": "对BNW的那2人有什么看法？",
      "source_fingerprint": "da39ae64643e7b4bdc697865623ba9e69dc305ec99a9f8598d9b0bb8a9e0f6bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "68"
      ],
      "target_text": "Bạn nghĩ gì về 2 người còn lại trong BNW?",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:e047383d9c607e1e72a51456",
      "kind": "text_data",
      "source_text": "可以表演魔术给我们看吗？",
      "source_fingerprint": "8012d9d6b71f6530db43efc0ec4ea77fce7ce39ee675065101eca9e94dc60024",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "680"
      ],
      "target_text": "Bạn có thể biểu diễn ảo thuật cho chúng tôi xem không?",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:e768629373ded908079c655e",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "681"
      ],
      "target_text": "Hãy nhắn đôi lời tới người hâm mộ!",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:155649be68f95c7a227f4d8b",
      "kind": "text_data",
      "source_text": "觉得这场备受瞩目的竞赛，有什么新鲜之处吗！？",
      "source_fingerprint": "e48ee7f7eb40fca1202a653b269388ba6913b2b0d91ff1686b16e6af020d83e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "682"
      ],
      "target_text": "Bạn thấy cuộc đua đang rất được chú ý này có gì mới mẻ không!?",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:65d318d9d659de9f16b43a36",
      "kind": "text_data",
      "source_text": "请对在故乡守护你的大家说句话！",
