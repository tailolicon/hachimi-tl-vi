    {
      "entry_index": 19,
      "uid": "zhcn:2bc090216993a4cac75ecd05",
      "kind": "text_data",
      "source_text": "本次的竞赛，会是高手云集吗？",
      "source_fingerprint": "70fa1115ea526e0c1b0ade626b106dc064ad27604cca9ca6ef1270eea54766a5",
