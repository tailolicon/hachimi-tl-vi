  "entries": [
    {
      "entry_index": 20,
      "uid": "zhcn:54a2e1c471c7c55f5f11ca9c",
      "kind": "text_data",
      "source_text": "ルーティンってヤツ？　興味ねぇよ。\\n勝つヤツが勝つ、それだけだろ。",
      "source_fingerprint": "3fd55e617f26e61ebfb0b7815c6f7ec240ca77c1a8543a0ed3724d04d0736d25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1273"
      ],
      "target_text": "Cái gọi là thói quen trước trận ấy à? Ta chẳng quan tâm.\\\\nKẻ thắng thì sẽ thắng, chỉ thế thôi.",
      "reviewed": true
    },
    {
      "entry_index": 21,
      "uid": "zhcn:de86d0d17a260ecdd2b1aae2",
      "kind": "text_data",
      "source_text": "ねェな。\\n今はワクワクとゾクゾクだけだよ。",
      "source_fingerprint": "c8d6cfa85b82ad357c540846b8f955e4317a868981e58fe04df20227ed36eb7b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1274"
      ],
      "target_text": "Không có.\\\\nGiờ chỉ còn cảm giác háo hức và rùng mình thôi.",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:bb6df7a1dd0281cfcb90ed03",
      "kind": "text_data",
      "source_text": "誰に聞いてんだよ。俺は“最強”だぜ？",
      "source_fingerprint": "5f94c38e4afbbc3d91c0b0c37693f354bd685a51be616a22181d80d30f32c886",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1275"
      ],
      "target_text": "Hỏi ai vậy hả? Ta là “mạnh nhất” đấy nhé?",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:f19a2e551de5f0139cde27b7",
      "kind": "text_data",
      "source_text": "誰が相手だろうがゼッテー負けねェ！\\nまとめて叩き潰してやる！",
      "source_fingerprint": "59928b8fa707c6ea8c1ee4e36d3a416a6841a2715ec127706706e4cd485a485e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1276"
      ],
      "target_text": "Đối thủ là ai thì ta cũng tuyệt đối không thua!\\\\nTa sẽ nghiền nát tất cả một lượt!",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:e7f94f28f458fb41ee4fb8b1",
      "kind": "text_data",
      "source_text": "目ん玉かっぴらいてよ～く見とけ。\\n俺がスゲーもん見せてやるよ！",
      "source_fingerprint": "716f4aa2c0656ae09597963ec0616b768c0575e7b346b85bd4c7fa6000fb648d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1277"
      ],
      "target_text": "Mở to mắt ra mà nhìn cho kỹ.\\\\nTa sẽ cho xem thứ cực kỳ ghê gớm!",
      "reviewed": true
    },
    {
      "entry_index": 25,
      "uid": "zhcn:6bf762a89ee8b5d3096cc7e0",
      "kind": "text_data",
      "source_text": "誰が相手だろうがゼッテー負けねェ！\\nまとめて叩き潰してやる！",
      "source_fingerprint": "59928b8fa707c6ea8c1ee4e36d3a416a6841a2715ec127706706e4cd485a485e",
      "source_path": "text_data_dict.json",
