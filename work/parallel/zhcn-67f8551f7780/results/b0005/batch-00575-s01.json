    {
      "entry_index": 27,
      "uid": "zhcn:4269daecb84841c955a7916e",
      "kind": "text_data",
      "source_text": "吼唔──！\\n风风要把所有人都打得落花流水──",
      "source_fingerprint": "e02317bb60aec0c1fedbf9c94684aa0df3247ec5d550a736e245a0b712f16afc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "128"
      ],
      "target_text": "Gừừ──!\\\\nTớ sẽ đánh cho tất cả tơi tả──",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:d6d3d92e43a4052c47155623",
      "kind": "text_data",
      "source_text": "ええ勿論。実は、今もしておりますよ。\\n……フフ。",
      "source_fingerprint": "824cd2d12e58f4bd3f5e8902123266ca2a1ab8205366d3cfad9956be6fb6bba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1280"
      ],
      "target_text": "Vâng, tất nhiên rồi. Thật ra, ngay lúc này tôi vẫn đang làm đấy.\\\\n……Hihi.",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:bc4d47c8c35741b641370cf2",
      "kind": "text_data",
      "source_text": "そうですね……ゴミ掃除でしょうか。\\n綺麗好きなもので、目につくとつい。",
      "source_fingerprint": "e21a2afb43ff85afc2113cc66f76977443f8efe7d605745f5572b0e72119919e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1281"
      ],
      "target_text": "Để xem……chắc là dọn rác.\\\\nTôi thích sạch sẽ nên hễ thấy là lại tiện tay dọn ngay.",
      "reviewed": true
    },
    {
      "entry_index": 30,
      "uid": "zhcn:caefc93e7bbcd278203808ee",
      "kind": "text_data",
      "source_text": "眼鏡は必ず拭きますよ。曇っていては、\\n小石なんかを見落としてしまいますから。",
      "source_fingerprint": "fa7c25fac3272091df44aa431092852a54f193e67be140c1c75c927b0db0c7db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1282"
      ],
      "target_text": "Tôi luôn lau kính đấy. Nếu kính bị mờ,\\\\nthì có thể bỏ sót cả những viên sỏi nhỏ.",
      "reviewed": true
    },
    {
      "entry_index": 31,
      "uid": "zhcn:8165e72d906c400285737c4b",
      "kind": "text_data",
      "source_text": "ええ勿論。実は、今もしておりますよ。\\n……フフ。",
      "source_fingerprint": "824cd2d12e58f4bd3f5e8902123266ca2a1ab8205366d3cfad9956be6fb6bba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1283"
      ],
