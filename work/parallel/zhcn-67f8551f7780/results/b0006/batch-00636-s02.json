  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:6a3cc14ad14713c76b561146",
      "kind": "text_data",
      "source_text": "对一路陪伴您走到现在的训练员说句话吧！",
      "source_fingerprint": "e3e2a83adc85bfb452cb7a640a39feee90190a73039837f310b5cfb2581c17eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1468"
      ],
      "target_text": "Hãy nói đôi lời với Trainer đã đồng hành cùng bạn đến tận hôm nay!",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:e6d90cf701e176f8e0bfd227",
      "kind": "text_data",
      "source_text": "夺得主角之位，请谈谈此刻的心情！",
      "source_fingerprint": "6cf287cf65e4afdc6d23758ba0997e906db7b95c2ea36d297284ae3e61940157",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1469"
      ],
      "target_text": "Đã giành vị trí nhân vật chính, hãy chia sẻ cảm xúc lúc này!",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:36a716e97baa60f6bf5c5906",
      "kind": "text_data",
      "source_text": "……你从刚刚开始就在眺望什么呢？",
      "source_fingerprint": "9e57e7708f79379058390a4e2b287518d7f763aa2a7f27015909313daa5a06b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "147"
      ],
      "target_text": "……Từ nãy đến giờ bạn đang ngắm nhìn gì vậy?",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:85a2f9fc288250c668776898",
      "kind": "text_data",
      "source_text": "有没有考虑过给自己什么奖励呢？",
      "source_fingerprint": "db87977f56abc019aaa82eddb01e79966eff1377bdaba40ec2172d7b46f75d5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1470"
      ],
      "target_text": "Bạn có nghĩ đến phần thưởng nào dành cho chính mình không?",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:30570cbda2159c9d7d98f108",
      "kind": "text_data",
      "source_text": "听说您经常挑战特别菜单上的特训呢。",
      "source_fingerprint": "6c0d161ef66635bf5b5ba01ff0c1d513ba3c3ce1376755ecbe6764d3e46122f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1471"
      ],
      "target_text": "Nghe nói bạn thường thử sức với bài đặc huấn trong thực đơn đặc biệt nhỉ.",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:76239e8cc9fb307d47419d49",
      "kind": "text_data",
      "source_text": "期待您在决赛中也能取得胜利！",
      "source_fingerprint": "b7fc0187528eba7f0573ee76a86c7a8b3054286b2c3ba36cc22f2aa70887f565",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1472"
      ],
      "target_text": "Mong bạn cũng giành chiến thắng ở trận chung kết!",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:9680451c7d53029f9f363420",
      "kind": "text_data",
      "source_text": "有什么非常珍视的信念吗？",
      "source_fingerprint": "260a2ff21374c3af3f19a4c535a374c82a4c7958dd21ef02c015862d12fccf2e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1473"
      ],
      "target_text": "Believe, bạn có niềm tin nào đặc biệt trân trọng không?",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:6fe3394a6ebbe900d4c0ed02",
      "kind": "text_data",
      "source_text": "优胜演出我们也会进行采访的！",
