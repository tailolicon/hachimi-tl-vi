  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:cddcf998b0cbddc0bf5d2216",
      "kind": "text_data",
      "source_text": "请告诉我们让你感到松一口气的瞬间是何时？",
      "source_fingerprint": "a8f2b1c245da02bd001d34b079e6c5d3ac523fdf3f1cd4d196c646a78359e93b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "538"
      ],
      "target_text": "Bạn thấy nhẹ nhõm nhất vào khoảnh khắc nào?",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:3f6a0d4b7e447e464bbfb8b8",
      "kind": "text_data",
      "source_text": "请告诉我们在竞赛前必做的流程！",
      "source_fingerprint": "9cfb48ea8fde81b42f084bf27887484a0802de6e66e61b0c3eae174e44571cdb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "539"
      ],
      "target_text": "Trước mỗi cuộc đua, bạn có quy trình nào nhất định phải làm không?",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:1ca04309bfc6e9acfd843316",
      "kind": "text_data",
      "source_text": "会想给自己什么样的奖励？",
      "source_fingerprint": "fccda8ab44188d79bb2659eeb9a01a36be30dd51ef0ba4ec342ddbbc25a5ad19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "54"
      ],
      "target_text": "Bạn muốn tự thưởng cho mình gì?",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:6be28717389d62e1fcbfdda1",
      "kind": "text_data",
      "source_text": "日頃心掛けていることは？",
      "source_fingerprint": "7e0202af73cb60b0733dbe94590ad3c9c44db26fee93342daef3f8a0953def8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "540"
      ],
      "target_text": "Hằng ngày, bạn luôn tự nhắc mình điều gì?",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:9acad4911ce46f350cca6d5c",
      "kind": "text_data",
      "source_text": "レース後のウマトック投稿、すごい反響でしたね！",
      "source_fingerprint": "e7b2166f0b3121c42188dc0e023e1468421493997db8524f2484d2e7b085cea1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "541"
      ],
      "target_text": "Bài đăng UmaTok sau cuộc đua nhận được phản hồi cực lớn nhỉ!",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:366f43836181128223580301",
      "kind": "text_data",
      "source_text": "勝負メシはなんですか？",
      "source_fingerprint": "e0e9fe3bf80ea4c38312a56e0c1153737b6f9befcfe7fb156018f9d31e412958",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "542"
      ],
      "target_text": "Món ăn lấy may của bạn là gì?",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:23db4312289d38f9bc518559",
      "kind": "text_data",
      "source_text": "竞赛时特别注重什么地方呢？",
      "source_fingerprint": "17049ea9c281943667741ca2198a84af023a580e9b6c96caf5b7f4cb887081e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "543"
      ],
      "target_text": "Khi đua, bạn đặc biệt chú ý điều gì?",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:f0fbd71775e7a3098cfb73bb",
      "kind": "text_data",
      "source_text": "最后冲刺时飞舞的缎带令人印象深刻！",
      "source_fingerprint": "c312235862222cddd8ae18eafded8c97a4591061730309cb891b14287191166c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "544"
      ],
      "target_text": "Những dải ruy băng tung bay ở cú nước rút cuối thật ấn tượng!",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:71bd76e408ed499514cec5b4",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "545"
      ],
      "target_text": "Hãy nhắn đôi lời tới những người hâm mộ luôn ủng hộ bạn!",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:fede2efe78f8b3d54b235fad",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝发表一句感言！",
      "source_fingerprint": "3b0e691d9d91c19c6082542a0a1c94e0a3915e2db2bceb4c2fc701ec5a460658",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "546"
      ],
      "target_text": "Hãy chia sẻ cảm nghĩ với những người hâm mộ luôn ủng hộ bạn!",
      "reviewed": true
    },
    {
      "entry_index": 50,
      "uid": "zhcn:b5810b5140e9f92bc8465dfd",
      "kind": "text_data",
      "source_text": "签约训练员是否也发挥了庞大的助力呢？",
      "source_fingerprint": "f0fb0fba5f86ee2a6ede22173f48e5635a9c5077a64d9a58884f4101b90a4d61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "547"
      ],
      "target_text": "Trainer đã ký hợp đồng với bạn cũng góp công rất lớn, phải không?",
      "reviewed": true
    },
    {
      "entry_index": 51,
      "uid": "zhcn:a0625f34f054d1eaff76f5d9",
      "kind": "text_data",
      "source_text": "请针对下场比赛说出你的抱负！",
      "source_fingerprint": "2b90b7dfd011593ab25e80e411c31c2c72407eb7cb28a5d180632dc70dcd1506",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "548"
      ],
      "target_text": "Hãy chia sẻ quyết tâm của bạn với cuộc đua tiếp theo!",
      "reviewed": true
    },
    {
      "entry_index": 52,
      "uid": "zhcn:4fcbe27b1913f9fe8efa988d",
      "kind": "text_data",
      "source_text": "这份喜悦想要传达给谁呢？",
      "source_fingerprint": "ba95759be7d5eb21d39ba1e7be3acd96a947c48b22d54aa3fd9c4474ba098acc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "549"
      ],
      "target_text": "Bạn muốn chia sẻ niềm vui này với ai?",
      "reviewed": true
    },
    {
      "entry_index": 53,
      "uid": "zhcn:3290a2c4d6a9e7a29f0c9601",
      "kind": "text_data",
      "source_text": "今天能获胜的原因是什么呢？",
      "source_fingerprint": "f94a17fb3a38e1a899b0c84e917d9cea3359f6df9dfc50c0294c890970ac11c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "55"
      ],
      "target_text": "Theo bạn, vì sao hôm nay bạn có thể giành chiến thắng?",
      "reviewed": true
    },
    {
      "entry_index": 54,
      "uid": "zhcn:893782898eed0ba22b78472c",
      "kind": "text_data",
      "source_text": "有想吃什么来庆祝胜利吗？",
      "source_fingerprint": "9962fbb6d266f3cd2a310be09f0b71c08436a4e9570d15c5d83dfe7a7ee2e46c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "550"
      ],
      "target_text": "Bạn muốn ăn gì để ăn mừng chiến thắng?",
      "reviewed": true
    }
  ]
