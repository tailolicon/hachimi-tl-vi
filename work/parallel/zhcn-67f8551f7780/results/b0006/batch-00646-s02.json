      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "765"
      ],
      "target_text": "Quả nhiên sẽ ăn mừng chiến thắng bằng 「đồ uống mật ong đặc biệt」 sao?",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:53fbeb96bab91c82500a92dc",
      "kind": "text_data",
      "source_text": "接下来有什么计划呢？",
