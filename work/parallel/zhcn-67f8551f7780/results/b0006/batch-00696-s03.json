  "entries": [
    {
      "entry_index": 60,
      "uid": "zhcn:ea39bc0557d755bd4cd709cc",
      "kind": "text_data",
      "source_text": "穿透虚空——（※空气栅栏破坏）",
      "source_fingerprint": "a9e315696e881759ca2bd5c16feb9d5025bdce34f9fd423f127616e258abe012",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1084"
      ],
      "target_text": "Xuyên thủng hư không——（※Phá rào chắn không khí）",
      "reviewed": true
    },
    {
      "entry_index": 61,
      "uid": "zhcn:ed409a30b7dff27e11f2ee44",
      "kind": "text_data",
      "source_text": "吟诵家族的玉条，再次明确自己肩负的责任",
      "source_fingerprint": "80359eb946917218608aaf440cdaa90970156655c23f4d8fa463ea0f71d27948",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1085"
      ],
      "target_text": "Ngâm đọc điều răn của gia tộc, một lần nữa khắc ghi trách nhiệm mình gánh vác",
      "reviewed": true
    },
    {
      "entry_index": 62,
      "uid": "zhcn:5d6050cd2e825b4ddffec149",
      "kind": "text_data",
      "source_text": "呼吸深到能听见吐息声",
      "source_fingerprint": "e06fdf84a611284a87161b4622236393360ddb2078bd35e3edba731ad797a0d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1086"
      ],
      "target_text": "Hít thở thật sâu, đến mức nghe rõ cả tiếng thở ra",
      "reviewed": true
    },
    {
      "entry_index": 63,
      "uid": "zhcn:514ac9539b2927f5412f7af0",
      "kind": "text_data",
      "source_text": "用语音备忘录记录赛前的小真",
      "source_fingerprint": "5429d76a5631f35c4ccc4334e12243f5a30c2753c30e51e81e9b24173efc81ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1087"
      ],
      "target_text": "Dùng ghi âm thoại để lưu lại Machan trước cuộc đua",
      "reviewed": true
    },
    {
      "entry_index": 64,
      "uid": "zhcn:3f99e3e90d588ee0a13c209d",
      "kind": "text_data",
      "source_text": "温煦腹部、按压合谷穴、点上茉莉香",
      "source_fingerprint": "9862606607d320fd20d4885381ae717fedeb4128a51f801abac019e483d420d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1088"
      ],
      "target_text": "Làm ấm bụng, ấn huyệt Hợp Cốc, thắp hương hoa nhài",
      "reviewed": true
    },
    {
      "entry_index": 65,
      "uid": "zhcn:71861401beb8585feee44c94",
      "kind": "text_data",
      "source_text": "面向墙壁集中精神",
      "source_fingerprint": "62686fa4a4ae7a0b3f1524f9a300fce742981ce6c7ecbaaa4775f9edf3bab283",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1089"
      ],
      "target_text": "Hướng mặt vào tường để tập trung tinh thần",
      "reviewed": true
    },
    {
      "entry_index": 66,
      "uid": "zhcn:8b4012ac849c96051437e3fd",
      "kind": "text_data",
      "source_text": "在镜子前检查心中的悸动☆",
      "source_fingerprint": "29b8fbefe2b5be4fc57decf957213bb667a553b97675a557275d835f5dc88b53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1091"
      ],
      "target_text": "Đứng trước gương kiểm tra xem tim có đang rung động không☆",
      "reviewed": true
    },
    {
      "entry_index": 67,
      "uid": "zhcn:e1e291c4b3d7368b73f5f0cb",
      "kind": "text_data",
      "source_text": "走出休息室前会说『谢谢』",
      "source_fingerprint": "c5f6fba8416583c112bb9053718fe21af9abd19c4d988b1a4725367efcaa329e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1093"
      ],
      "target_text": "Nói 『Cảm ơn』 trước khi rời phòng chờ",
      "reviewed": true
    },
    {
      "entry_index": 68,
      "uid": "zhcn:5830eda2851d309d119d71c0",
      "kind": "text_data",
      "source_text": "想象着从密林一跃而出，奔向荒野",
      "source_fingerprint": "3160f666d0db36eb4d841cf1b8e1b12cd763aeb4b6b70d0e8f5331cf539df5e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1094"
      ],
      "target_text": "Tưởng tượng mình lao vút khỏi rừng rậm, chạy thẳng ra hoang dã",
      "reviewed": true
    },
    {
      "entry_index": 69,
      "uid": "zhcn:d90affc3f5b2d715b700085e",
      "kind": "text_data",
      "source_text": "从应援歌中获取快乐☆",
      "source_fingerprint": "f76e062b5ce80f87c2271ff22d583cfbaf83a916b916550856ebd9449e0c379a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1098"
      ],
      "target_text": "Tìm niềm vui trong bài hát cổ vũ☆",
      "reviewed": true
    },
    {
      "entry_index": 70,
      "uid": "zhcn:d6822436821fd18f3557840a",
      "kind": "text_data",
      "source_text": "小声哼唱原创应援歌曲",
      "source_fingerprint": "d18013f22b0a6c582a128e98f34fdeddcafe7bb64ead784e0ade266195be6cb6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1099"
      ],
      "target_text": "Khẽ ngân nga bài hát cổ vũ tự sáng tác",
      "reviewed": true
    },
    {
      "entry_index": 71,
      "uid": "zhcn:5a2b0f3961cbb5693c4c7311",
      "kind": "text_data",
      "source_text": "为避免走形，会调整决胜服的腰围",
      "source_fingerprint": "1619f7818d7c1ca780ee3a67972251303ed434d1e1d405015d7b18bb644a0672",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1100"
      ],
      "target_text": "Chỉnh phần eo của Trang phục đua để giữ phom",
      "reviewed": true
    },
    {
      "entry_index": 72,
      "uid": "zhcn:4ab7b8e12106d9ac5c7167e9",
      "kind": "text_data",
      "source_text": "作为演奏者的礼仪，会整理出最美丽的仪态",
      "source_fingerprint": "ee5761515544797fee5bfe9ef3b89f377da04830a40f221ee7ac7f1f24ae053c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1102"
      ],
      "target_text": "Theo lễ nghi của người biểu diễn, chỉnh trang để có dáng vẻ đẹp nhất",
      "reviewed": true
    },
    {
      "entry_index": 73,
      "uid": "zhcn:419f56e845745127ac4373cf",
      "kind": "text_data",
      "source_text": "用拳头刺向眼前看不见的墙壁",
      "source_fingerprint": "f197dd942dc878bc17e00e8c69496f228f2092dd2d4d0bb0a0c21238d7f6a1d0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1104"
      ],
      "target_text": "Đấm thẳng vào bức tường vô hình trước mặt",
      "reviewed": true
    },
    {
      "entry_index": 74,
      "uid": "zhcn:792684b643a216e6368c1cf5",
      "kind": "text_data",
      "source_text": "『相信』“同调”",
      "source_fingerprint": "78e1dfeacbe0728e24ab0f0ebda63bea434e9ff2883aba59da0b7199b7de5e05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1105"
      ],
      "target_text": "『Tin tưởng』“Đồng điệu”",
      "reviewed": true
    }
  ]
}
