  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:703a6a469058356d233be6b4",
      "kind": "text_data",
      "source_text": "比赛中盘消耗少量体力\\n使速度大幅提升\\n之后在终盘的最终直线处速度稍微提升\\n＜作战・追赶＞",
      "source_fingerprint": "286975fffe6ef23fa800d792bb487a540fb1788a4dfee5f54d82f83d06b3782f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104402211"
      ],
      "target_text": "Ở giữa Cuộc đua, tiêu hao một ít Stamina\\nSpeed tăng mạnh\\nsau đó Speed tăng nhẹ ở đoạn thẳng cuối trong chặng cuối\\n＜End Closer＞",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:2f23553277316b4c65622c4e",
      "kind": "text_data",
      "source_text": "比赛终盘时若身处前方\\n则一段时间内速度持续提升\\n＜作战・先行＞",
      "source_fingerprint": "716cdf4f2cbda393a3094d346a2ccaa0ad5c082d248021dde457f4c7549350ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104501111"
      ],
      "target_text": "Ở chặng cuối Cuộc đua, nếu đang ở phía trước\\nSpeed tiếp tục tăng trong một khoảng thời gian\\n＜Pace Chaser＞",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:d2200e9ca78abaf0a83559af",
      "kind": "text_data",
      "source_text": "以利落的动作过弯\\n大幅回复持久力",
      "source_fingerprint": "126625a9be697ca6650d16aecf6b7b8c5b58a8f31a2447a7ed3f7baa8d04532c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104501211"
      ],
      "target_text": "Vào cua gọn gàng\\nhồi phục nhiều Stamina",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:0f40762135bdb9d553ec23c3",
      "kind": "text_data",
      "source_text": "身处弯道上时速度提升\\n并且稍微回复持久力",
      "source_fingerprint": "44cef8905337120752f00d6edb61878cbae9fe25c274860a9766eff1e874ac80",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104502111"
      ],
      "target_text": "Khi ở khúc cua, Speed tăng\\nđồng thời hồi phục nhẹ Stamina",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:19c078bf8ab5a796d1410540",
      "kind": "text_data",
      "source_text": "比赛中盘遭遇前方拥堵时\\n稍微回复持久力\\n并且剥夺前方赛马娘的持久力＜中距离＞",
      "source_fingerprint": "424e5e81ee8cb0abf0130837f01924fe5917484bc786ab6f805306bca7904a77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104502211"
      ],
      "target_text": "Khi bị ùn phía trước ở giữa Cuộc đua\\nhồi phục nhẹ Stamina\\nđồng thời làm giảm Stamina của Mã Nương phía trước＜Medium＞",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:5e0dc097e17e6adaf532ca58",
      "kind": "text_data",
      "source_text": "比赛中盘速度大幅提升\\n＜作战・先行＞",
      "source_fingerprint": "532441ffd6df5e734df32a163f586752bae36dacc65ee3149c2e8aba947318da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104503111"
      ],
      "target_text": "Ở giữa Cuộc đua, Speed tăng mạnh\\n＜Pace Chaser＞",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:457fffaa5ff94b43c99451d1",
      "kind": "text_data",
      "source_text": "临近终盘位于领头或是\\n距离领头6马身以内时\\n在终盘提升加速度＜先行・长距离＞",
      "source_fingerprint": "2b2068bb03c8a7274e6b0085e09b62daf3f72e5a46ce11ab73051af0301d5587",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104503211"
      ],
      "target_text": "Gần chặng cuối, khi đang dẫn đầu hoặc\\ncách người dẫn đầu không quá 6 thân ngựa\\ntăng gia tốc Speed ở chặng cuối＜Pace Chaser・Long＞",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:f7a90cbd16da5354cebce161",
      "kind": "text_data",
      "source_text": "在比赛中盘处于好位置时\\n持久力回复",
      "source_fingerprint": "6e840da6f513589eb3f91d109657894e66fbd62c08de278830ffa1e9337503bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "10451"
      ],
      "target_text": "Khi ở vị trí thuận lợi giữa Cuộc đua\\nhồi phục Stamina",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:3d240c7598a924ca60a6cba5",
      "kind": "text_data",
      "source_text": "比赛序盘的一段时间内\\n赛道的选择变得更加明智",
