      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:6250a422b4e240374571f96d",
      "kind": "text_data",
      "source_text": "Leap into a New World!",
      "source_fingerprint": "66a6e3dfd414cfa8de21ab1b0111cf53b9dae46eae55156e11032ec89109d4ad",
      "source_path": "text_data_dict.json",
