      "kind": "text_data",
      "source_text": "甜蜜回忆・茶会时光",
      "source_fingerprint": "f6c5505dfb771473040cd7276122863c614dd78fd863d519b8ce80de4645e227",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
