    {
      "entry_index": 5,
      "uid": "zhcn:5f6b46ee78fade8c2d0b3d4f",
      "kind": "text_data",
      "source_text": "正因如此，你才美丽",
      "source_fingerprint": "cf0ac8e25badcf3ba919a0903d5428ad1b91eaac5aab0f84ef3a98a868723bab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310124"
      ],
      "target_text": "Chính vì vậy, bạn mới xinh đẹp.",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:045f91ab80db40ebc99bfdb8",
      "kind": "text_data",
      "source_text": "神算鬼谋！？春日祭！热血激斗躲鬼球",
      "source_fingerprint": "783ea50c1ae38bed491dded52f17817a9c72b4c50f526d65e0c5937bff72107d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310125"
      ],
      "target_text": "Mưu ma chước quỷ!? Lễ hội mùa xuân! Kịch chiến né bóng ma nhiệt huyết",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:1222d0062e86478ea8d78c1d",
      "kind": "text_data",
      "source_text": "誓约，向奋战的你献上爱意",
      "source_fingerprint": "23b3beec1ce75d520c6bc66c707fb7db9ed674709b6426b86bec2ab0b0ad2ae3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310126"
      ],
      "target_text": "Lời thề, xin dâng tình yêu đến bạn - người đang chiến đấu hết mình",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:a65814859946feb70249c5da",
      "kind": "text_data",
      "source_text": "#summer #besties",
      "source_fingerprint": "f1592601f124f8cb0b2e992143460c0f8608ef01e5ace1b022d028075af21207",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310127"
      ],
      "target_text": "#summer #besties",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:b9e6f56e333aa57dfab8e552",
      "kind": "text_data",
      "source_text": "夏日炽阳，止于浩渺",
      "source_fingerprint": "5b1c8cc9068df0bda8d47e92a5fbf19232bcdedd6f4ed00ad015ef92ff3d56ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310128"
      ],
      "target_text": "Nắng hè rực cháy, dừng lại nơi mênh mông",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:b8c3edea11e4694d73846c31",
      "kind": "text_data",
      "source_text": "于离别中重“缝”",
      "source_fingerprint": "cbb7b137a81bdeab41caeddf29d9364760fbae04ac0a7db61862b46758604472",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310129"
      ],
      "target_text": "Trong biệt ly, “khâu” lại chữ duyên",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:183726d03f3b5ca76cef1104",
      "kind": "text_data",
      "source_text": "寂寥秋色，连缀思念",
      "source_fingerprint": "e4384857c7ae6ffd14bb2e1af5cdae3b6d33cd7cccf20c14cf06123bd4295d83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310130"
      ],
      "target_text": "Sắc thu quạnh quẽ, kết nối nỗi nhớ nhung",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:ed6b33448832806fa196b2c3",
      "kind": "text_data",
      "source_text": "流光溢彩，目白晚会",
      "source_fingerprint": "a679d5a91e341b82e29baeac0996c47ef6991de09de4fdb46655f6d653edafa0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310131"
      ],
      "target_text": "Rực rỡ ánh sáng, dạ tiệc Mejiro",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:02ca16cdd5f36f78515a5726",
      "kind": "text_data",
      "source_text": "我也是，大家的爱马",
      "source_fingerprint": "3ead0b834a8ab2ce5e90be27124ae29a891170990eff60163839c845aaa7a440",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310132"
      ],
      "target_text": "Tôi cũng vậy, cũng là Mã Nương được mọi người yêu quý",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:394f41acd444e997763ea103",
      "kind": "text_data",
      "source_text": "欢迎光临！温馨的幸味庵",
      "source_fingerprint": "ca37cddfc4fafa91e225a05bb6254403f9e2c3f8f5925f010107b4580432844a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310133"
      ],
      "target_text": "Chào mừng ghé thăm! Quán Hạnh Vị Am ấm áp",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:ba79fc779888e296d995b668",
      "kind": "text_data",
      "source_text": "致彗星兰的你",
      "source_fingerprint": "412462db820939578ac36be3a2d51e1ca4eddac7d2b63c1701cac7ebd10517e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310134"
      ],
      "target_text": "Gửi tới bạn - Lan Sao Chổi",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:d89bc0011b29f11da7291724",
      "kind": "text_data",
      "source_text": "下克上，骁兵勇将齐战吼",
      "source_fingerprint": "c00cb4c78dfc0de30d67e681c3bc019dba13eca82e82a8cd590829d2f15827d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310135"
      ],
      "target_text": "Hạ khắc thượng, kiêu binh dũng tướng cùng gầm vang xung trận",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:11356a7502406c2f2e9460cd",
      "kind": "text_data",
      "source_text": "敬启，独一无二的我",
      "source_fingerprint": "6361e4c3f92f2a33c12753630dfc40556220f0a3614a20542eea77d3b2e2c9d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310136"
      ],
      "target_text": "Kính gửi, chính tôi - người độc nhất vô nhị",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:80aa963cd125abee00b02623",
      "kind": "text_data",
      "source_text": "沙滩夕阳映青春",
      "source_fingerprint": "ad2ec66b052a900df519de3a642f9572c4383d471fa1862e06e37d3b1e775df6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310137"
      ],
      "target_text": "Hoàng hôn bãi biển in bóng thanh xuân",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:ec828f46d21654138b5d0342",
      "kind": "text_data",
      "source_text": "良朋共赏中秋月",
      "source_fingerprint": "c51774bf9103dc5688134f92cc987efb24ba432ebc278a496cebe1b2774fbbc6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "65",
        "310138"
      ],
      "target_text": "Bạn hiền cùng ngắm trăng Trung Thu",
      "reviewed": true
    }
