      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41061003"
      ],
      "target_text": "Minh chứng bậc nhất",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:442e1020dfdbe466a732ba69",
      "kind": "text_data",
      "source_text": "觉悟与宣言",
      "source_fingerprint": "7e09bfa7cd11f9d45bed47c79e02c988c76ebd29c4e05efedf369d5f68666525",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41061004"
      ],
      "target_text": "Giác ngộ và tuyên ngôn",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:4c2e375b98f46477161a9659",
      "kind": "text_data",
      "source_text": "让我满足吧！",
