      "kind": "text_data",
      "source_text": "可能给你添了麻烦……但是",
      "source_fingerprint": "44adc14d10dfada55c1957371769fa5d046d335cb276f2d9cfd4be808ead7e2f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41058007"
      ],
      "target_text": "Có lẽ tôi đã làm phiền bạn… nhưng",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:daf5ceff43fbd80f87eb4cab",
      "kind": "text_data",
      "source_text": "闪耀，Particle",
      "source_fingerprint": "bb08801908c767aecd42603956bf688fb407aa28f8c9a8e15c7f59dbb9b24704",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059001"
      ],
      "target_text": "Tỏa sáng, Particle",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:9d7a5a0dd611e84724fb17aa",
      "kind": "text_data",
      "source_text": "奋勇迈进，Dreamer",
      "source_fingerprint": "e83c852bc5f15941d04fb9d3a673632a34d7a2a5a7d524eebf7c19eb66f3cdf2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059002"
      ],
      "target_text": "Dũng cảm tiến bước, Dreamer",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:1c99e401af5cf0a7dea286c3",
      "kind": "text_data",
      "source_text": "然后，Blackout",
      "source_fingerprint": "bc0a5e700e7e5a872680d4494ffbd147e98ecf6904dfdd46eab618b4d65ac0bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059003"
      ],
      "target_text": "Rồi thì, Blackout",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:34af6e223007f591f85b8146",
      "kind": "text_data",
      "source_text": "即便如此，Fighter",
      "source_fingerprint": "e9543fe67ef81df2f68ba7b81ead278d86bf49942921ae05804aba1e869e3649",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059004"
      ],
      "target_text": "Dù vậy, Fighter",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:2e9a36147410c1261c50b9ed",
      "kind": "text_data",
      "source_text": "时至今日，Distance",
      "source_fingerprint": "cd936bcafba55648cc539d00a43fa3a441c9832a0bc38800ad82899622c8ac9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059005"
      ],
      "target_text": "Đến tận hôm nay, Distance",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:6613a1038eb4df9c1b8945e5",
      "kind": "text_data",
      "source_text": "例如这样，Colorful Memory",
      "source_fingerprint": "6347bd9647f753a83cf62e81772e4c14563f6de56651ba90e4224570b79b797b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059006"
      ],
      "target_text": "Chẳng hạn như vậy, Colorful Memory",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:3ec924cbe52f5619a842c053",
      "kind": "text_data",
      "source_text": "这便是，Pressure",
      "source_fingerprint": "54234c4dcfa5abc2d1f2df33f54dbcc0b84ecde12ec5f96a7017c3e692cfcd58",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41059007"
      ],
      "target_text": "Đây chính là, Pressure",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:c0d4e912e771695a4651ce91",
      "kind": "text_data",
      "source_text": "你好呀，我是庶民派哦~",
      "source_fingerprint": "f1383bf017e2daf5589477039beb20586ad1db99fbf265d1d9f7a7b43566977c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060001"
      ],
      "target_text": "Chào cậu, tớ là kiểu bình dân đó~",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:6062be6c789691dfb0bc610c",
      "kind": "text_data",
      "source_text": "怀旧系赛马娘",
      "source_fingerprint": "7a24659027aa7adf7b5ff9b683526f34d0680202bea7023575d95980030b9367",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060002"
      ],
      "target_text": "Mã Nương phong cách hoài cổ",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:554c3b59def6ebb2639f35ef",
      "kind": "text_data",
      "source_text": "无法触及的前方",
      "source_fingerprint": "31ec6dc4c9997956abd7cf8f63d6ce585da996faa73024b2bbad50924afa645a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060003"
      ],
      "target_text": "Phía trước không thể chạm tới",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:70f60900d4e8a57adc341e41",
      "kind": "text_data",
      "source_text": "说一次『就算如此』吧",
      "source_fingerprint": "1bc0721750b4e2866ff4f3a179ab1e45634236eb5ed8fb7edbc0fb9945b40ac0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060004"
      ],
      "target_text": "Hãy thử nói một câu『dù vậy』xem nào",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:d8473f926d41f12432d62c98",
      "kind": "text_data",
      "source_text": "后来居上的人气投票第三位",
      "source_fingerprint": "e1834262a5bdfac731e8d5a8f014014f9172e02b2f7c69a8bbd50bc21cfe97f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060005"
      ],
      "target_text": "Vượt lên từ phía sau, giành hạng ba bình chọn độ nổi tiếng",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:d32a721660543109ba61861e",
      "kind": "text_data",
      "source_text": "蹄铁、熠熠生辉",
      "source_fingerprint": "77be87533368b7fb5f579aacd7e60ae6b06e436e7610c9539d44f734326e8dbd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060006"
      ],
      "target_text": "Móng ngựa, lấp lánh tỏa sáng",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:3946dac0761edf4cc0b31898",
      "kind": "text_data",
      "source_text": "值得自豪的一个特长",
      "source_fingerprint": "5957a25fafe22154c9e1205555a075c080442a78338ebd2e23324a61520f599c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060007"
      ],
      "target_text": "Một sở trường đáng tự hào",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:8312d45a8c567872beddc283",
      "kind": "text_data",
      "source_text": "其名为圣王光环！",
      "source_fingerprint": "4ba5b662351a5a71e385828f2a11978541d95dda80625ffb548f793b7811ca42",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41061001"
      ],
      "target_text": "Tên gọi là King Halo!",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:429d4c2edaa801dca78d7f9f",
      "kind": "text_data",
      "source_text": "一流的资格",
      "source_fingerprint": "2ecaf7fc547aee8bad3df001ae24eafb1af39324a9abee0d93ed50e2f5dd1351",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41061002"
      ],
      "target_text": "Tư cách bậc nhất",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:871c6a5841f3e30a516b398d",
