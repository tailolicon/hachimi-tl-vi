  "entries": [
    {"entry_index":60,"uid":"zhcn:341bfae616066dd62132195a","kind":"character_system_text","source_text":"没有问题。\n能发挥和往常一样的实力。","source_fingerprint":"4eabae70dab0ac641d9f5f1da5e586d2640bbda0f241517b587c6922cf3d6e79","source_path":"character_system_text_dict.json","json_path":["1002","20029"],"target_text":"Không sao cả.\nMình vẫn có thể thể hiện đúng phong độ như mọi khi.","reviewed":true},
    {"entry_index":61,"uid":"zhcn:79f680cee25616e9c221c8df","kind":"character_system_text","source_text":"迄今为止学到的一切，\n都会在这场比赛中发挥出来。","source_fingerprint":"38751120d6747400ff9dba1a1d82a7d738287f8348f0b8a4db0ac68a58672be8","source_path":"character_system_text_dict.json","json_path":["1002","20030"],"target_text":"Tất cả những gì mình đã học được cho đến giờ,\nmình sẽ vận dụng hết trong cuộc đua này.","reviewed":true},
    {"entry_index":62,"uid":"zhcn:2e016f1614433b80bbb76c97","kind":"character_system_text","source_text":"请好好看着我。\n我一定会赢给你看的。","source_fingerprint":"b280392f9f277549d9f1f76f48c5d2834568cc2f8c8245c11bc030f58bdf0fcf","source_path":"character_system_text_dict.json","json_path":["1002","20031"],"target_text":"Hãy dõi theo mình nhé.\nMình nhất định sẽ thắng cho bạn xem.","reviewed":true},
    {"entry_index":63,"uid":"zhcn:75912a4631834366c0481c87","kind":"character_system_text","source_text":"虽然稍微有点不安……\n不过没问题。","source_fingerprint":"61f38312eaf489c1683a472038fc3525d68b27d4f26eec0c7bdc6a6fb4988388","source_path":"character_system_text_dict.json","json_path":["1002","20032"],"target_text":"Dù hơi lo một chút……\nnhưng không sao đâu.","reviewed":true},
    {"entry_index":64,"uid":"zhcn:4772524af0e1b4710b3b6ffb","kind":"character_system_text","source_text":"只要回想起平时的训练……\n只要按平时那样来……","source_fingerprint":"887568dc1b764983de26d00b74e1c3ff69c6c2bacc15e1960ebe454f54052bd0","source_path":"character_system_text_dict.json","json_path":["1002","20033"],"target_text":"Chỉ cần nhớ lại những buổi tập thường ngày……\nChỉ cần làm như mọi khi……","reviewed":true},
    {"entry_index":65,"uid":"zhcn:021114f4cc48e27157898239","kind":"character_system_text","source_text":"我只会向着前方奔跑……\n除此以外的事情，我从没考虑过。","source_fingerprint":"fa8f4040d2ad629ec8464fc78c6213dd9adcefff800c301afeabefa3e7a3ab23","source_path":"character_system_text_dict.json","json_path":["1002","20034"],"target_text":"Mình chỉ biết chạy về phía trước……\nNgoài điều đó ra, mình chưa từng nghĩ đến gì khác.","reviewed":true},
    {"entry_index":66,"uid":"zhcn:6e7a8e3edb9c4b49a45e05de","kind":"character_system_text","source_text":"好像状态调整得不太好…\n不过，即便说出来，\n也没什么用吧。","source_fingerprint":"c5c863e806b3c6549a916b6a1412d1e3b33a6177686dfa5c68d9368316bfae7d","source_path":"character_system_text_dict.json","json_path":["1002","20035"],"target_text":"Có vẻ mình chưa đạt trạng thái tốt lắm…\nNhưng dù có nói ra,\ncũng chẳng ích gì nhỉ.","reviewed":true},
    {"entry_index":67,"uid":"zhcn:6e778d134578b8950e0b1639","kind":"character_system_text","source_text":"我会想想办法得。\n……我能做的事情，也只有这些了。","source_fingerprint":"e16bc1dfb120b5f2a3b50bc9febac7e4bcfc495c69b120ad2c29fccada82f1a7","source_path":"character_system_text_dict.json","json_path":["1002","20036"],"target_text":"Mình sẽ tìm cách.\n……Đó cũng là tất cả những gì mình có thể làm.","reviewed":true},
    {"entry_index":68,"uid":"zhcn:13e0ad8c0bc380fe1c295f5a","kind":"character_system_text","source_text":"如果不好好想想在这个状态也能获胜得方法的话……","source_fingerprint":"006293882dec5fa052ebf302c496286e2f63fa4c6496d9eb354c5b2e8f349be0","source_path":"character_system_text_dict.json","json_path":["1002","20037"],"target_text":"Nếu không nghĩ kỹ cách để thắng dù đang ở trạng thái này thì……","reviewed":true},
    {"entry_index":69,"uid":"zhcn:8fd506f827fd3cc9447d3bc3","kind":"character_system_text","source_text":"要上了。","source_fingerprint":"4cc3e66bd2d16801a26318a428d92c7d296744eed798b5374b62953d95ec7a1c","source_path":"character_system_text_dict.json","json_path":["1002","20038"],"target_text":"Bắt đầu thôi.","reviewed":true}
  ]
}
