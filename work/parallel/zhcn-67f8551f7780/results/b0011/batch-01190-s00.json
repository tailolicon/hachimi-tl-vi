    {
      "entry_index": 15,
      "uid": "zhcn:764bcef0c5cd92c7fdeb22c9",
      "kind": "character_system_text",
      "source_text": "那就赶紧开始训练吧？",
      "source_fingerprint": "199f8d01ec2a51a7512e97ea13b4b5d68c51b910f51f7528194bd72bd477fd97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "110000"
      ],
      "target_text": "Vậy thì bắt đầu huấn luyện ngay thôi nhé?",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:cfb1a101784d193b8037715f",
      "kind": "character_system_text",
      "source_text": "嗯嗯，\r\n在意的话有很多呢。",
      "source_fingerprint": "6c70f787bf50f7e08ff0b76fea5421b5c8612fbb1923301dbc636b0a34f5bb7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "110001"
      ],
      "target_text": "Ừ ừ,\r\ncó khá nhiều điều khiến tớ để tâm đấy.",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:7f8a633d58582d9d6db410ba",
      "kind": "character_system_text",
      "source_text": "啊，是来\r\n给比赛报名的吗？",
      "source_fingerprint": "5494e1e7debe8a2712e794aa46579980e4a70aa747c24afd303666a33b422a87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "110002"
      ],
      "target_text": "A, cậu đến đây\r\nđể đăng ký tham gia Cuộc đua à?",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:f4a187b515e4e6d1c5a536b9",
      "kind": "character_system_text",
      "source_text": "感觉很好嘛♪",
      "source_fingerprint": "b5388b5d13318b76ac789881e05c6072bb097d576274cd32aeba0005d2b84c3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "1137"
      ],
      "target_text": "Cảm giác thật tuyệt đấy♪",
