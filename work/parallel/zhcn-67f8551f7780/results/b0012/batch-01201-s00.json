{"schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01201-s00","batch":1201,"shard":0,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":0,"shard_end_exclusive":20,"translated_count":15,"entries":[{"entry_index":0,"uid":"zhcn:9b95c43651b1d5c59e03988d","kind":"character_system_text","source_text":"好像能跑出好成绩哦。\r\n看着吧，训练员！","source_fingerprint":"d0c1c3dfeb463a609f8966cbaa991904436ba88d6cbf8579c26fced8fcadb445","source_path":"character_system_text_dict.json","json_path":["1006","20028"],"target_text":"Có vẻ mình sẽ chạy tốt đấy.\r\nHãy xem nhé, Trainer!","reviewed":true},{"entry_index":1,"uid":"zhcn:0214660aed61af2cb7c3995f","kind":"character_system_text","source_text":"轮到我上场了。\r\n看着吧，我会努力的。","source_fingerprint":"cbb6399adfe1c0d70815dd48f1333457adbdcded4e00b58de399de1a4bf15514","source_path":"character_system_text_dict.json","json_path":["1006","20029"],"target_text":"Đến lượt mình rồi.\r\nHãy xem nhé, mình sẽ cố hết sức.","reviewed":true},{"entry_index":2,"uid":"zhcn:803113752326b97978298b5d","kind":"character_system_text","source_text":"有点紧张……\r\n要小心不要乱了步调才好。","source_fingerprint":"0f753152a3dc4b2833f81cc55e27bc7116ce645bd33868f374cb5bc85a7bcf1f","source_path":"character_system_text_dict.json","json_path":["1006","20030"],"target_text":"Hơi căng thẳng...\r\nPhải cẩn thận để không bị rối nhịp.","reviewed":true},{"entry_index":3,"uid":"zhcn:8e5be0e3fd860e9baa030de9","kind":"character_system_text","source_text":"只要拿出平时训练的实力，\r\n应该就能赢……","source_fingerprint":"c555399c44d69d109e10d350d933e65f1f9f29565c9f452c741ed69d541427d4","source_path":"character_system_text_dict.json","json_path":["1006","20031"],"target_text":"Chỉ cần phát huy như lúc tập luyện,\r\nchắc mình sẽ thắng được...","reviewed":true},{"entry_index":4,"uid":"zhcn:2890e41404c0cd9dcebddf85","kind":"character_system_text","source_text":"虽然没有完全准备好……\r\n但我会用全力去跑的。","source_fingerprint":"c007b144f8e32e32eddf932777e1bd98653341d0bc9d8fe6cc919d01afcebd5b","source_path":"character_system_text_dict.json","json_path":["1006","20032"],"target_text":"Dù chưa chuẩn bị thật tốt...\r\nnhưng mình sẽ chạy hết sức.","reviewed":true},{"entry_index":5,"uid":"zhcn:9148aa1cbdb503d0a1fc5a35","kind":"character_system_text","source_text":"状态不是非常好……\r\n训练员，要麻烦你比平时\r\n更用力地为我加油了……","source_fingerprint":"3cf3af269cb16102b48c181c4973946e15fd910743febe6c9878b702f7fe9165","source_path":"character_system_text_dict.json","json_path":["1006","20033"],"target_text":"Mình không được sung sức lắm...\r\nTrainer, phải nhờ bạn\r\ncổ vũ mình nhiệt tình hơn thường lệ rồi...","reviewed":true},{"entry_index":6,"uid":"zhcn:4cb5b0d081a8575d5004e6df","kind":"character_system_text","source_text":"就算实力不够，\r\n我也要全力去奔跑……！","source_fingerprint":"e1798dd9fffa4cd192338914ecb72041a8461d8ef85cbc6e7ed560cb550c5f3a","source_path":"character_system_text_dict.json","json_path":["1006","20034"],"target_text":"Dù thực lực còn chưa đủ,\r\nmình vẫn sẽ chạy hết sức...!","reviewed":true},{"entry_index":7,"uid":"zhcn:eb9f7b5b719f2092ba025d70","kind":"character_system_text","source_text":"以我目前的实力……\r\n不，无论如何我都会挑战的。","source_fingerprint":"2badc535db8bd95ecc34cb96e365542e68c4658af337904276cf4ba0d0e32c89","source_path":"character_system_text_dict.json","json_path":["1006","20035"],"target_text":"Với thực lực hiện tại của mình...\r\nKhông, dù thế nào mình cũng sẽ thử sức.","reviewed":true},{"entry_index":8,"uid":"zhcn:107704fb62ab352473a65369","kind":"character_system_text","source_text":"不知道能不能达到\r\n大家对我的期许……\r\n不，我只需要尽全力去奔跑就对了。","source_fingerprint":"bd362007b3e0b82ec91b2cc5a498d990fcd11a73376327816721b116749cf033","source_path":"character_system_text_dict.json","json_path":["1006","20036"],"target_text":"Không biết mình có đáp lại được\r\nkỳ vọng của mọi người không...\r\nKhông, mình chỉ cần chạy hết sức là được.","reviewed":true},{"entry_index":9,"uid":"zhcn:e4ad3ac8acf58d931c88f2ae","kind":"character_system_text","source_text":"对手全都具有实力……\r\n速度也比我快。但不实际跑过，\r\n就无法决定胜负……！","source_fingerprint":"d239c7b399b238396f9526c2ecd5f2fe748a69d259155dc5dd5a2ef251aa29bd","source_path":"character_system_text_dict.json","json_path":["1006","20037"],"target_text":"Đối thủ ai cũng rất mạnh...\r\nHọ còn nhanh hơn mình. Nhưng chưa chạy thử,\r\nthì chưa thể biết ai thắng...!","reviewed":true},{"entry_index":10,"uid":"zhcn:cabc68a0291a90fcb4c09e35","kind":"character_system_text","source_text":"好，就这么做。","source_fingerprint":"34c95677059123870e2f7dbaa87a4e315164e52d50f9121aeece7854ac968178","source_path":"character_system_text_dict.json","json_path":["1006","20038"],"target_text":"Được, cứ làm vậy đi.","reviewed":true},{"entry_index":11,"uid":"zhcn:d3e995b6e1123999bf51b316","kind":"character_system_text","source_text":"请你看着我。","source_fingerprint":"09e94e3ffc579f30f9ba853366c3507b301e34de15989d2a657fd7e3af3cf298","source_path":"character_system_text_dict.json","json_path":["1006","20039"],"target_text":"Hãy nhìn mình nhé.","reviewed":true},{"entry_index":12,"uid":"zhcn:527cb7abd9d409765a532ba4","kind":"character_system_text","source_text":"交给我吧。","source_fingerprint":"b0f70558d850ecc83c59a7f556d74001d25e024c7fa3678ca8a6cbcf1ef56f92","source_path":"character_system_text_dict.json","json_path":["1006","20040"],"target_text":"Cứ giao cho mình.","reviewed":true},{"entry_index":13,"uid":"zhcn:ae34d10efa337243cf02ecab","kind":"character_system_text","source_text":"要好好用功呢。","source_fingerprint":"c7e82fdb97bdcaad9316b35e202ac4e6681faebd98c4153208d3a84b9859319a","source_path":"character_system_text_dict.json","json_path":["1006","20041"],"target_text":"Phải chăm chỉ thôi.","reviewed":true},{"entry_index":14,"uid":"zhcn:8557d647d744697e7284ca18","kind":"character_system_text","source_text":"感觉状态不太好……","source_fingerprint":"ae709c9a974a044b4cbdbb07741998275494a2381c28bf35e1201ea9c962d4e4","source_path":"character_system_text_dict.json","json_path":["1006","20042"],"target_text":"Mình thấy không được sung sức lắm...","reviewed":true}]}
