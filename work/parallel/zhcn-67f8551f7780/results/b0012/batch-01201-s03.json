{"schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01201-s03","batch":1201,"shard":3,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":60,"shard_end_exclusive":80,"translated_count":10,"entries":[{"entry_index":60,"uid":"zhcn:cf4d2512e5832c49f17f2fbc","kind":"character_system_text","source_text":"轮到我了……尽全力表现吧！","source_fingerprint":"6bca23ce8d39ed1ba31f1a9b1567ac6ed29173c82d8631afc12110a2b9b977db","source_path":"character_system_text_dict.json","json_path":["1006","60000"],"target_text":"Đến lượt mình rồi... thể hiện hết sức thôi!","reviewed":true},{"entry_index":61,"uid":"zhcn:3ba0c9df4a6b719810f336a9","kind":"character_system_text","source_text":"虽然有点紧张……但没问题的！","source_fingerprint":"27734bca390e107a891b5909f60fd63e33c74640d8bf9e8aecdf0addde632e58","source_path":"character_system_text_dict.json","json_path":["1006","60001"],"target_text":"Dù hơi căng thẳng... nhưng không sao!","reviewed":true},{"entry_index":62,"uid":"zhcn:fd8e6e457aa867dc47ba26a3","kind":"character_system_text","source_text":"训练员……我很仰赖你哦。","source_fingerprint":"26dcffe70a2b8bca4e3a2ab8b3ccd8f4a6ee662969e0cf7e1381dfadbb9e775c","source_path":"character_system_text_dict.json","json_path":["1006","70000"],"target_text":"Trainer... mình trông cậy vào bạn đấy.","reviewed":true},{"entry_index":63,"uid":"zhcn:37e73b816751f6798e259ea9","kind":"character_system_text","source_text":"我刚来到学园的时候，\r\n连左右都分不清楚……\r\n真的一路都受到你的帮助。","source_fingerprint":"da209991a14fedbfc17c9db0caac2da2ed192673ea8d00efc8d067e1e7f67894","source_path":"character_system_text_dict.json","json_path":["1006","70001"],"target_text":"Khi mới đến học viện,\r\nmình còn chẳng phân biệt nổi trái phải...\r\nthật sự suốt chặng đường này đều nhờ bạn giúp đỡ.","reviewed":true},{"entry_index":64,"uid":"zhcn:0a68c347896025b77355b820","kind":"character_system_text","source_text":"好，没有任何奇怪的地方。","source_fingerprint":"7a59517396ba8ccabbe6199774157ca648e6d3d4a54e9f1071b327ba2be9aef6","source_path":"character_system_text_dict.json","json_path":["1006","70004"],"target_text":"Được, không có gì kỳ lạ cả.","reviewed":true},{"entry_index":65,"uid":"zhcn:6bf6458015491c0a12ea82ac","kind":"character_system_text","source_text":"会不会有点太花哨了……？","source_fingerprint":"f190b3e9b965d69dd9ffe31d3369c63e8ba56879c9fdba932f9765af4aa0d48b","source_path":"character_system_text_dict.json","json_path":["1006","70008"],"target_text":"Có hơi lòe loẹt quá không...?","reviewed":true},{"entry_index":66,"uid":"zhcn:a103b64c4fe0dbc3303dfcaa","kind":"character_system_text","source_text":"嗯，开始觉得紧张了。","source_fingerprint":"049a3b7ddd1cd97ad92f7d40df467a31d68f083562dac681f84df7e42122ebb1","source_path":"character_system_text_dict.json","json_path":["1006","70009"],"target_text":"Ừm, mình bắt đầu thấy căng thẳng rồi.","reviewed":true},{"entry_index":67,"uid":"zhcn:1d5b3ae06493981953e7d08f","kind":"character_system_text","source_text":"我有穿好吗……？","source_fingerprint":"ae4388657d831f8d016f8ff9622807133403ef44aa7649f16ad827a4556573ae","source_path":"character_system_text_dict.json","json_path":["1006","70010"],"target_text":"Mình mặc ổn chứ...?","reviewed":true},{"entry_index":68,"uid":"zhcn:39e2853aaea3a2a19c5a7e36","kind":"character_system_text","source_text":"希望能适合我……","source_fingerprint":"48dc87ce3da9e4faa9ed4259d0ce85d9e1507ed722b8241fb2a7529551698aa1","source_path":"character_system_text_dict.json","json_path":["1006","70014"],"target_text":"Mong là nó hợp với mình...","reviewed":true},{"entry_index":69,"uid":"zhcn:2a32537973f4c8e7b97e5121","kind":"character_system_text","source_text":"穿着这套衣服，就会觉得胸口好热……！","source_fingerprint":"9d1e8e949642d7316f46eced61508c1c7b820689e2e8931206611fe140c052f8","source_path":"character_system_text_dict.json","json_path":["1006","70015"],"target_text":"Mặc bộ đồ này, mình cảm thấy trong lòng nóng lên...!","reviewed":true}]}
