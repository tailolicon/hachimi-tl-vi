  "entries": [
    {"entry_index":0,"uid":"zhcn:14672ba3ca1e63f816e60d2e","kind":"character_system_text","source_text":"我……我会把……油门踩到底的！","source_fingerprint":"1871834deb5fa713143db1f675397fb38ba2c6c93c42ba8b15c85281a6c04738","source_path":"character_system_text_dict.json","json_path":["1008","40001"],"target_text":"Tôi… tôi sẽ… đạp ga hết cỡ!","reviewed":true},
    {"entry_index":1,"uid":"zhcn:e18ec2a0899e9a9540918f4b","kind":"character_system_text","source_text":"活动任务也有很多丰富内容喔！\r\n感觉会是一场热闹的典礼呢♪","source_fingerprint":"bde9c1c9d14b827562de6047d9cdd81bca387fd84e5b090e48858f613f6f9a2d","source_path":"character_system_text_dict.json","json_path":["1008","400012"],"target_text":"Nhiệm vụ sự kiện cũng có đủ thứ nội dung hấp dẫn đấy!\r\nCó vẻ sẽ là một buổi lễ náo nhiệt lắm đây♪","reviewed":true},
    {"entry_index":2,"uid":"zhcn:048ad160978a7a7e6de0827c","kind":"character_system_text","source_text":"拿去！这是「婚宴小礼」！\r\n……开玩笑的啦！\r\n你可别忘了拿啰！","source_fingerprint":"f6883b742b28ded313de867de36519e08db20155046476f1708bbe9a60bc1b23","source_path":"character_system_text_dict.json","json_path":["1008","400013"],"target_text":"Cầm lấy! Đây là 「quà nhỏ tiệc cưới」!\r\n…Đùa thôi mà!\r\nNhớ đừng quên nhận đấy nhé!","reviewed":true},
    {"entry_index":3,"uid":"zhcn:039fe1652301c7a09a7b79ec","kind":"character_system_text","source_text":"让大家见识一下！","source_fingerprint":"97995958e9c91ee3d133d27520a769a8c36ef2cf209a40a9cb8228ab4bf83de8","source_path":"character_system_text_dict.json","json_path":["1008","40002"],"target_text":"Cho mọi người thấy nào!","reviewed":true},
    {"entry_index":4,"uid":"zhcn:bea57aae5aa640ca36709fd9","kind":"character_system_text","source_text":"喝啊，看招！","source_fingerprint":"6322de14f539ff35d5e7e201fd428eedd146c810417f22a88bb5b74929f6d532","source_path":"character_system_text_dict.json","json_path":["1008","40003"],"target_text":"Haa, xem chiêu đây!","reviewed":true},
    {"entry_index":5,"uid":"zhcn:6304f6a18edece5eb0a9fe96","kind":"character_system_text","source_text":"呀呵～！仔细看着我的技术吧！\r\n我用最快速度抵达了……礼物来啦！","source_fingerprint":"7e8e0160f28f01bdb2095228d4bfde69feb3327c40d0cc22dc23690ae0dcba29","source_path":"character_system_text_dict.json","json_path":["1008","40004"],"target_text":"Yahoo~! Nhìn kỹ kỹ năng của tôi đây!\r\nTôi đã tới với tốc độ nhanh nhất… Quà tới rồi!","reviewed":true},
    {"entry_index":6,"uid":"zhcn:dbdfd88f7dcbc692babf77bf","kind":"character_system_text","source_text":"我上了！","source_fingerprint":"004e7ad03760ca4de54eb8714ebf3d626f0737fd957dec00e92601dd4fdc23ea","source_path":"character_system_text_dict.json","json_path":["1008","410000"],"target_text":"Tôi lên đây!","reviewed":true},
    {"entry_index":7,"uid":"zhcn:f890c619f1475219f3131f55","kind":"character_system_text","source_text":"成功了～！","source_fingerprint":"3d1bf314e1f144b611c7778e151a34ecc1b19a98f8d54f3b64e99198cd19a5b5","source_path":"character_system_text_dict.json","json_path":["1008","410001"],"target_text":"Thành công rồi~!","reviewed":true},
