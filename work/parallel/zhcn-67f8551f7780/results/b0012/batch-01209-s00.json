    {"entry_index":15,"uid":"zhcn:cf5309e085262ebdecdc7cde","kind":"character_system_text","source_text":"我会让你感到震撼的！","source_fingerprint":"fa9bec28b9543d72dc0bad5874580a2dff0fa649946a8c90949c129b1f8d1b2b","source_path":"character_system_text_dict.json","json_path":["1008","60000"],"target_text":"Tôi sẽ khiến cậu phải choáng ngợp!","reviewed":true},
    {"entry_index":16,"uid":"zhcn:4b2ff38d6b6eeb4498ea7e34","kind":"character_system_text","source_text":"我会把油门踩到底的！","source_fingerprint":"72755853c6c9f63a9d2e96f504a4bb7ef38482e081f916ac8b7446471276e0dc","source_path":"character_system_text_dict.json","json_path":["1008","60001"],"target_text":"Tôi sẽ đạp ga hết cỡ!","reviewed":true},
    {"entry_index":17,"uid":"zhcn:e8e5ce73b8ac0de9e45eeff2","kind":"character_system_text","source_text":"今后也要一起\r\n狂奔到底！","source_fingerprint":"99c8b6af88df357f46f978b67f99333f1ef2b74f3aad25cfbc58f662c029788f","source_path":"character_system_text_dict.json","json_path":["1008","70000"],"target_text":"Từ giờ về sau cũng cùng nhau\r\nchạy hết mình đến cùng nhé!","reviewed":true},
    {"entry_index":18,"uid":"zhcn:c0c648dbe1cb5c8ea41aafb1","kind":"character_system_text","source_text":"你也是个挺了不起的家伙嘛～。\n竟然比谁都先发现了我的\n帅气之处啊。","source_fingerprint":"d0a1e60db7000d7684e70c4ec5ee61e258e658011079ae0e3be61ce35d5b9304","source_path":"character_system_text_dict.json","json_path":["1008","70001"],"target_text":"Cậu cũng ra gì phết đấy chứ~.\nLại nhận ra điểm ngầu của tôi\nsớm hơn bất kỳ ai nữa.","reviewed":true},
    {"entry_index":19,"uid":"zhcn:487b653a4923f9092d637470","kind":"character_system_text","source_text":"要是能再更灵活一点的话ー。","source_fingerprint":"e1a0fe5ddd77f716ed4e195cbdbe24ce3da383d41c917b85b4c6c5eb95759327","source_path":"character_system_text_dict.json","json_path":["1008","70004"],"target_text":"Giá mà linh hoạt hơn chút nữa thì—","reviewed":true}
