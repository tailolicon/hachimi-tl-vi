  "entries": [
    {"entry_index":20,"uid":"zhcn:21b617298c8318f564763111","kind":"character_system_text","source_text":"这种的实在有点……令人害羞。","source_fingerprint":"c5ec54ee9fe68ab88b9263b4569a8ec38c01eb4316f85273c3fbecfe07f3412a","source_path":"character_system_text_dict.json","json_path":["1008","70008"],"target_text":"Kiểu này thật sự hơi… ngượng quá.","reviewed":true},
    {"entry_index":21,"uid":"zhcn:9c29bfebd129a90e842a9233","kind":"character_system_text","source_text":"呼ー！帅气啊！超棒的ー！","source_fingerprint":"19af6c16299b74fda67de311be5d481a9d65cdb191593e53b43f8390895b610e","source_path":"character_system_text_dict.json","json_path":["1008","70009"],"target_text":"Hú—! Ngầu quá! Tuyệt quá—!","reviewed":true},
    {"entry_index":22,"uid":"zhcn:1734fca6d77180f87b531763","kind":"character_system_text","source_text":"我也不能把袖子扯掉对吧……","source_fingerprint":"339d10746f820530c4786c3b6bbb3a9ac27d696c217fe6b3db07088967139805","source_path":"character_system_text_dict.json","json_path":["1008","70010"],"target_text":"Tôi cũng không thể xé tay áo ra được nhỉ…","reviewed":true},
    {"entry_index":23,"uid":"zhcn:601fc6ea6c5527698c778556","kind":"character_system_text","source_text":"嗯ー…就没有帅气一点的吗？","source_fingerprint":"c56351905fd44ee5890f535f6cb973e4ae4c5f46c83c95a14fda9d6a29f3b7a5","source_path":"character_system_text_dict.json","json_path":["1008","70014"],"target_text":"Ừm—… Không có bộ nào ngầu hơn chút à?","reviewed":true},
    {"entry_index":24,"uid":"zhcn:2d619a8951082d537471c7a5","kind":"character_system_text","source_text":"穿上这个\r\n就能感受到风在身边吹呢！","source_fingerprint":"532a6f3a9516a12a66ffd9a515851f2398df9b2ee875904588ce9b80cafcbe3c","source_path":"character_system_text_dict.json","json_path":["1008","70015"],"target_text":"Mặc cái này vào\r\nlà cảm nhận được gió lướt bên mình đấy!","reviewed":true},
    {"entry_index":25,"uid":"zhcn:093978fc3987505674c62e3d","kind":"character_system_text","source_text":"在holy night盛大登场！","source_fingerprint":"2129dff760981503bb5ecebe79b8b93f67497e77cd9067701d031ae4d8e5c348","source_path":"character_system_text_dict.json","json_path":["1008","70016"],"target_text":"Xuất hiện hoành tráng trong holy night!","reviewed":true},
    {"entry_index":26,"uid":"zhcn:36e9f13881b794b281d586f5","kind":"character_system_text","source_text":"怎么样？帅气的圣诞老人也不赖吧？","source_fingerprint":"9ab315f461818e0c920ce546c3a7525b0aa016c2f405f1ca245dbf3ee223e5eb","source_path":"character_system_text_dict.json","json_path":["1008","70017"],"target_text":"Thế nào? Ông già Noel ngầu cũng đâu tệ nhỉ?","reviewed":true},
    {"entry_index":27,"uid":"zhcn:de78d16b3104ad10380cdeff","kind":"character_system_text","source_text":"超棒～……！！","source_fingerprint":"782cab7c4ccfe5ea8d5737350a8aaae4ba21ec0a147d994285c1b968ecd6e319","source_path":"character_system_text_dict.json","json_path":["1008","70018"],"target_text":"Tuyệt quá~…!!","reviewed":true},
    {"entry_index":28,"uid":"zhcn:a85af9d8d668d0a73db830f2","kind":"character_system_text","source_text":"以压倒性优势获胜吧！","source_fingerprint":"744fe1053ce0b84ab89d9a73208ec4f4d85ec33c8f42bf47243e1baebd636270","source_path":"character_system_text_dict.json","json_path":["1008","70019"],"target_text":"Thắng với ưu thế áp đảo nào!","reviewed":true},
    {"entry_index":29,"uid":"zhcn:8885b60a55b98f9896fe5e2e","kind":"character_system_text","source_text":"换上一身帅气的打扮！","source_fingerprint":"13a2353ad9885081fcd4c0e73571a8c7ede3f66ea6bcb621176790b09a987743","source_path":"character_system_text_dict.json","json_path":["1008","70020"],"target_text":"Khoác lên mình một bộ thật ngầu nào!","reviewed":true}
