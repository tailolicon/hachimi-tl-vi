  "entries": [
    {"entry_index":40,"uid":"zhcn:a7628ff6495d7abf779fec1e","kind":"character_system_text","source_text":"以压倒性优势获胜吧！","source_fingerprint":"744fe1053ce0b84ab89d9a73208ec4f4d85ec33c8f42bf47243e1baebd636270","source_path":"character_system_text_dict.json","json_path":["1008","71019"],"target_text":"Thắng với ưu thế áp đảo nào!","reviewed":true},
    {"entry_index":41,"uid":"zhcn:d8fb617c3db7fdff85fd672a","kind":"character_system_text","source_text":"お疲れ","source_fingerprint":"edc815c5e1c17c5c8f9166c714fa758e6cd4105c119f858c91288bccbf9a9d85","source_path":"character_system_text_dict.json","json_path":["1008","80000"],"target_text":"Vất vả rồi.","reviewed":true},
    {"entry_index":42,"uid":"zhcn:79b3f7890bac43dd787e73d1","kind":"character_system_text","source_text":"想跟我一决胜负吗？\r\n好啊，来吧！","source_fingerprint":"9388ffb5bdff0449ef612e49a3486c2596325985534dab925b56bf1daa12f333","source_path":"character_system_text_dict.json","json_path":["1008","81000"],"target_text":"Muốn đấu một trận với tôi à?\r\nĐược thôi, tới đi!","reviewed":true},
    {"entry_index":43,"uid":"zhcn:10ae9c10f5d40ec3e4523b97","kind":"character_system_text","source_text":"好嘞！\r\n差不多该动真格的了！","source_fingerprint":"7b139e550e848761350795345fdacbe5f7eb21e83c5efdec3cfdf6ee89bba719","source_path":"character_system_text_dict.json","json_path":["1008","81001"],"target_text":"Được rồi!\r\nCũng đến lúc nghiêm túc rồi!","reviewed":true},
    {"entry_index":44,"uid":"zhcn:9e5c391a4fe5891b2cdd443c","kind":"character_system_text","source_text":"噢，早啊！\r\n今天我也要踩着油门\r\n跑一整天哦！","source_fingerprint":"2c6d2ddc9ff294b7254f9a6c69edc55d2c9c43028527829c65b537715014f3eb","source_path":"character_system_text_dict.json","json_path":["1008","90000"],"target_text":"Ồ, chào buổi sáng!\r\nHôm nay tôi cũng sẽ đạp ga\r\nchạy suốt cả ngày!","reviewed":true},
    {"entry_index":45,"uid":"zhcn:d102ecea906595ac4fe0da89","kind":"character_system_text","source_text":"哦，训练员！我一早就很幸运嘛♪\r\n喂，告诉我作业的答案……不，提示！\r\n能不能告诉我提示啊！？拜托啦～！","source_fingerprint":"1aede118b0a1ddf0e8a2e42ac21e65742d71c1da639914eb2adf675769997a66","source_path":"character_system_text_dict.json","json_path":["1008","90001"],"target_text":"Ồ, Trainer! Sáng sớm đã gặp may rồi♪\r\nNày, cho tôi đáp án bài tập… không, gợi ý!\r\nCho tôi một chút gợi ý được không!? Xin cậu đó~!","reviewed":true},
    {"entry_index":46,"uid":"zhcn:37637c0d10224ad497b758f6","kind":"character_system_text","source_text":"呼啊──好困～\r\n可能是昨天太拼了。\r\n去顶楼睡个午觉好了～。","source_fingerprint":"4dfec3d9683e289d6eb65b90ca3d4248caf8fdc715ad6d6e0951efb31dfabef7","source_path":"character_system_text_dict.json","json_path":["1008","90002"],"target_text":"Haaa──buồn ngủ quá~\r\nChắc hôm qua cố quá rồi.\r\nLên sân thượng ngủ trưa một giấc vậy~.","reviewed":true},
    {"entry_index":47,"uid":"zhcn:7a779c492d3a0ca04a55c938","kind":"character_system_text","source_text":"呃、被发现了。……没、没有啦，\r\n我才没有打算逃课去跑步呢！\r\n啊哈哈～！","source_fingerprint":"d85fcfc6752cb54e24e2b1ac312f72090aa358e0d5c62aabe1748e54a3b5a82b","source_path":"character_system_text_dict.json","json_path":["1008","90003"],"target_text":"Ơ, bị phát hiện rồi. …Kh-không có đâu,\r\nTôi đâu có định cúp học để đi chạy đâu!\r\nA ha ha~!","reviewed":true},
    {"entry_index":48,"uid":"zhcn:4a85e033b0c2c9ae458cb2e5","kind":"character_system_text","source_text":"我要熬夜到几点呢～\r\n嘿嘿，你怎么啰嗦都没用哦？\r\n我可不是个乖宝宝！","source_fingerprint":"5413508dccf4a941d51ecaa57b4239ffc639937fff66477638361055c366c034","source_path":"character_system_text_dict.json","json_path":["1008","90004"],"target_text":"Tôi sẽ thức khuya tới mấy giờ nhỉ~\r\nHê hê, cậu có càm ràm cũng vô ích thôi nhé?\r\nTôi đâu phải bé ngoan!","reviewed":true},
    {"entry_index":49,"uid":"zhcn:ac72a9003345402cfb68f42e","kind":"character_system_text","source_text":"噢──还在工作啊。\r\n累不累啊？我用胳膊肘帮你揉揉肩膀吧。\r\n这可是老爸亲传的手法哦！","source_fingerprint":"3be92675c991af8d0a50841c560d58e02b0012fd4dc050dcf5707b6a1d238dc4","source_path":"character_system_text_dict.json","json_path":["1008","90005"],"target_text":"Ồ──vẫn đang làm việc à.\r\nMệt không? Để tôi dùng khuỷu tay bóp vai cho nhé.\r\nĐây là tuyệt chiêu được bố truyền lại đấy!","reviewed":true}
  ]
}
