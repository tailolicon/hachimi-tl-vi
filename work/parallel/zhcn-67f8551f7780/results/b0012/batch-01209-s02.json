    {"entry_index":42,"uid":"zhcn:79b3f7890bac43dd787e73d1","kind":"character_system_text","source_text":"想跟我一决胜负吗？\r\n好啊，来吧！","source_fingerprint":"9388ffb5bdff0449ef612e49a3486c2596325985534dab925b56bf1daa12f333","source_path":"character_system_text_dict.json","json_path":["1008","81000"],"target_text":"Muốn đấu một trận với tôi à?\r\nĐược thôi, tới đi!","reviewed":true},
