{
  "schema_version": 1,
  "epoch": "zhcn-67f8551f7780",
  "task_id": "batch-01219-s00",
  "batch": 1219,
  "shard": 0,
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 0,
  "shard_end_exclusive": 20,
  "status": "complete",
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:c65e5b556331cf7255903268",
      "kind": "character_system_text",
      "source_text": "不时刻注意过上端正仪表、有规律的校园生活可不行呢。",
      "source_fingerprint": "b20228bbe82a2ed138ab55cd94ea1f7cb22815b2d4154a637b66ea42a73238e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71010"
      ],
      "target_text": "Nếu không luôn để tâm giữ tác phong chỉnh tề và nếp sống học đường có quy củ thì không được đâu nhé.",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:b87c258824f39d51b184e6ef",
      "kind": "character_system_text",
      "source_text": "在胜者舞台上也要诚心诚意地款待大家♪",
      "source_fingerprint": "114ae6c2c406fe9aa9771ef928de1f19981f63720b0dd5b47d18f249cafa583f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71014"
      ],
      "target_text": "Dù đứng trên sân khấu của người chiến thắng cũng phải chân thành tiếp đãi mọi người thật chu đáo ♪",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:1e93139ff282e3fd36ad06ba",
      "kind": "character_system_text",
      "source_text": "这最重要的感情，将用这件决胜服所传达……",
      "source_fingerprint": "af8741e74fd1467582fe824bd350ba2fd98077fdda3933d0cb79c8710826eaf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71015"
      ],
      "target_text": "Tình cảm quan trọng nhất này, sẽ được truyền tải qua bộ trang phục quyết thắng này……",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:70ac9ea8ce794e9d187ff6d2",
      "kind": "character_system_text",
      "source_text": "转职为治愈师♪",
      "source_fingerprint": "16e0e50706d76660e7b18e0a20697dffc3de886aa4948945b5f65b0eb7546a8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71016"
      ],
      "target_text": "Chuyển chức nghiệp thành Healer ♪",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:d8090f2503fdfe9356f82b68",
      "kind": "character_system_text",
      "source_text": "诶呀诶呀，您需要回复魔法吗？",
      "source_fingerprint": "9e9e01a350d291039d203e916b1bbc2726bb6c8f5e150f98cdac1f120714f9e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71017"
      ],
      "target_text": "Ôi chao, ôi chao, bạn có cần phép hồi phục không?",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:3ad33ff7eb5b1301d6724746",
      "kind": "character_system_text",
      "source_text": "真是风流呢～",
      "source_fingerprint": "bfc0faa4533788c2985c6fe1d7348026e6ab392cc3283ce073ab9cadb4d01c23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71018"
      ],
      "target_text": "Thật là phong lưu nhỉ～",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:88b75877395bffa0fb0da2c1",
      "kind": "character_system_text",
      "source_text": "此身，定会达到顶点。",
      "source_fingerprint": "2f9caa93bb51a6256f3e013770d201be0b9bc68c8609c057e5584b2e31bf3253",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "71019"
      ],
      "target_text": "Tấm thân này, nhất định sẽ đạt đến đỉnh cao.",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:30fd99d839b9edb64e625c69",
      "kind": "character_system_text",
      "source_text": "お疲れ様です",
      "source_fingerprint": "ba6d317ce3a2bfaf3d87ba426113b0a3498828395ba8d093265eb3539b78c491",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "80000"
      ],
      "target_text": "Bạn đã vất vả rồi.",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:64c47b5ee449d9d2c87ad568",
      "kind": "character_system_text",
      "source_text": "还请多多手下留情♪",
      "source_fingerprint": "1c60e9409dbce61e9a1791ce5f4ce22c398a6debff2e684d2dbd7556ea6fade4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "81000"
      ],
      "target_text": "Mong bạn nương tay cho tôi nhé♪",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:b11e42063769aba544bac2e1",
      "kind": "character_system_text",
      "source_text": "这次也请让我好好学点东西吧♪",
      "source_fingerprint": "a2d8ebf96b9955cfac9cbf44fa9f4d925f0c01feea05c0dda6f13a3c5b8e8be1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "81001"
      ],
      "target_text": "Lần này cũng xin hãy để tôi học hỏi được điều gì đó nhé♪",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:49b97231eb0de2237bc5fe29",
      "kind": "character_system_text",
      "source_text": "早上好。\r\n俗话说“早晨一小时抵得上晚间的两小时。”\r\n可要好好珍惜时间哦。",
      "source_fingerprint": "0a81c50c1c1e36a1daf9df59b97b273e3cd0069f273ba83e5fc95cc5087bfbf4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90000"
      ],
      "target_text": "Chào buổi sáng.\r\nNgười ta thường nói “một giờ buổi sáng đáng giá bằng hai giờ buổi tối.”\r\nHãy nhớ trân trọng thời gian thật tốt nhé.",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:9eef95acdf5a123c38b7d325",
      "kind": "character_system_text",
      "source_text": "来一杯提神醒脑的早茶如何呢？\r\n正所谓“哪怕赶路七里，也要饮上一杯茶”。\r\n也能让人快速清醒哦。",
      "source_fingerprint": "ddd8708cd0b6471656143a4f284a44f9e781ae337d4f0e1f0ad2c77091dbf413",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90001"
      ],
      "target_text": "Uống một tách trà sáng cho tỉnh táo thì sao nhỉ?\r\nĐúng như câu “dù có vội đi bảy dặm đường cũng phải uống một tách trà”.\r\nNó cũng sẽ giúp bạn nhanh chóng tỉnh táo đấy.",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:1007f75cb5596acf08983ac6",
      "kind": "character_system_text",
      "source_text": "午安。\r\n端整好仪容仪表，\r\n下午的训练也好好加油吧。",
      "source_fingerprint": "8db5f693252df853075ffade3dcf28a803951bc9e717a1d253d13f8a2c351a82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90002"
      ],
      "target_text": "Chào buổi trưa.\r\nHãy chỉnh trang lại diện mạo cho ngay ngắn,\r\nvà cố gắng hết mình cho buổi tập luyện chiều nay nhé.",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:bd6a6a3b9136f4f1f1ed2f4a",
      "kind": "character_system_text",
      "source_text": "最近开始喜欢上做便当了呢。\r\n如果不嫌弃的话下次要尝尝看吗？\r\n我对味道还是很自信的♪",
      "source_fingerprint": "77cf37c952faa9e63d45a6802524bbdf51e8f47c6bf6eba468ed83aa8d491f0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90003"
      ],
      "target_text": "Dạo này tôi bắt đầu thích làm cơm hộp đấy.\r\nNếu không chê thì lần sau bạn có muốn thử không?\r\nTôi khá tự tin vào hương vị của mình đấy♪",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:ee9d3f95041564c6072cff89",
      "kind": "character_system_text",
      "source_text": "真是的，小鹰每次都跑过来\r\n戏弄我……啊，不不。\r\n什么事都没有哦～，呼呼呼。",
      "source_fingerprint": "aa6302c6b09914ed9f567e452f585356984b66d5ede74d0e62d8bf93aca3ea8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90004"
      ],
      "target_text": "Thật là, chú chim ưng nhỏ lúc nào cũng bay tới\r\ntrêu chọc tôi... à, không không.\r\nChẳng có chuyện gì đâu～, hi hi hi.",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:b9ef6396f003888ebadf94b3",
      "kind": "character_system_text",
      "source_text": "可不要太勉强自己哦。\r\n不然可变成“晚睡晚起的夜猫子”了。",
      "source_fingerprint": "ff1db9a036b32401d5e1350b588ae391e29578f92f9db1e000a6f241f5cbc898",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90005"
      ],
      "target_text": "Đừng ép bản thân quá sức nhé.\r\nKhông thì sẽ biến thành “con cú đêm ngủ muộn dậy muộn” đấy.",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:60382c8f8bd6bdcd3a99e3a3",
      "kind": "character_system_text",
      "source_text": "花儿的笑容最能让人感觉到春天来了呢。\r\n要不要一起优哉游哉地散会步呢？\r\n一定会很清爽的哦。",
      "source_fingerprint": "111bd7362bc734fdcb2bcbc672aabefc14de26f0e1dd9d61941a9dd3eaaa2dda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90006"
      ],
      "target_text": "Nụ cười của những đóa hoa khiến người ta cảm nhận rõ nhất mùa xuân đã đến rồi đấy.\r\nChúng ta cùng nhau dạo bộ thong thả một chút nhé?\r\nChắc chắn sẽ rất sảng khoái đấy.",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:6047560734d28c81e151e7e8",
      "kind": "character_system_text",
      "source_text": "哈啊。天气真是热呢～。\r\n要不要在地上撒些水呢。\r\n说不定能稍微凉快一些。",
      "source_fingerprint": "1eb2d7c0424f17598389cce6c32113e3673473610b8237aa7838518ea90221c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90007"
      ],
      "target_text": "Haa. Thời tiết nóng thật đấy～.\r\nHay là rưới chút nước xuống đất nhỉ.\r\nBiết đâu sẽ mát hơn một chút.",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:18c4d01981d40998cd123c2f",
      "kind": "character_system_text",
      "source_text": "“秋天的太阳落得快”。\r\n对时间的感觉也因此变得敏锐了，\r\n能够好好地珍惜每一天了呢～。",
      "source_fingerprint": "a758ac6c76e31194ce3a04e64cddc14e123bf2e61b0837c7ea9a3479cc083459",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90008"
      ],
      "target_text": "“Nắng thu tàn rất nhanh”.\r\nCũng vì vậy mà cảm nhận về thời gian trở nên nhạy bén hơn,\r\ngiúp tôi biết trân trọng từng ngày một cách trọn vẹn～.",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:cc4077c669f1fa79e34ae4d2",
      "kind": "character_system_text",
      "source_text": "“如果冬天来了，春天还会远吗。\r\n冬天的努力与春天的飞跃息息相关。\r\n就让我们打起精神地上吧。",
      "source_fingerprint": "3de76da079285efbdfa073306d6ba1086d08755d1e510657af2150fffb325554",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "90009"
      ],
      "target_text": "“Nếu mùa đông đã đến, mùa xuân còn xa nữa chăng.\r\nNỗ lực của mùa đông gắn liền mật thiết với bước nhảy vọt của mùa xuân.\r\nVậy nên chúng ta hãy phấn chấn tinh thần mà cố gắng thôi.",
      "reviewed": true
    }
  ]
}
