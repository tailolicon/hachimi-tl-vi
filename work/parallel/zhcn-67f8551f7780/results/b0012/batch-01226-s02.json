  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 40,
  "shard_end_exclusive": 60,
  "translated_count": 10,
  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:905ae931c3b23766e03a96d5",
      "kind": "character_system_text",
      "source_text": "宛如水鸟一般，强悍又优雅。",
      "source_fingerprint": "0fe76a99e44b3636d5e8ae5310fb18af4bff38cdf6c18a56c47ed0fb95f70029",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92017"
      ],
      "target_text": "Như loài chim nước, mạnh mẽ mà thanh nhã.",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:6dc7572e9ff4187c09f994d9",
      "kind": "character_system_text",
      "source_text": "让我们振翅高飞，\r\n迈向胜利吧。",
      "source_fingerprint": "4908ccb317d2fc3fe617df7a9e55b4b1ad68018d89403c007cd2bf9ae115f532",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92018"
      ],
      "target_text": "Hãy cùng tung cánh bay cao,\r\nhướng tới chiến thắng.",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:c6f1861174abe845195c83fa",
      "kind": "character_system_text",
      "source_text": "这里有很多可以互相切磋的对手呢。\r\n要好好珍惜……这样的环境。",
      "source_fingerprint": "d273f4183767d87ce2fd03a0575157abdc6317183d76030e4cfbc895244b6be8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92020"
      ],
      "target_text": "Ở đây có rất nhiều đối thủ để cùng nhau rèn giũa.\r\nPhải trân trọng…… môi trường như thế này.",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:889ad9b7c28d2baa889fe72b",
      "kind": "character_system_text",
      "source_text": "我希望自己可以常保平静，\r\n就像清澈无比的池水那样。",
      "source_fingerprint": "0b66a499a7d16812d6d3f65c1c4f6f9651d290e967377fb2e584f2b36b4213fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92021"
      ],
      "target_text": "Tôi mong mình luôn giữ được sự bình thản,\r\nnhư mặt hồ trong veo.",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:09ede406b09dd5c93ce1348b",
      "kind": "character_system_text",
      "source_text": "未知的未来会发生什么事……\r\n就让我们两个人一起亲眼确认吧。",
      "source_fingerprint": "7c6bb23116deb9bee5ccfad1fdde1bb6880e39187767440c2e70887f10e827b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92022"
      ],
      "target_text": "Tương lai chưa biết sẽ xảy ra điều gì……\r\nHãy để hai chúng ta cùng tận mắt chứng kiến nhé.",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:18059f0701315b48b680bea0",
      "kind": "character_system_text",
      "source_text": "我已经恢复精神了……\r\n来吧，无论什么训练\r\n我都会完美达成的！",
      "source_fingerprint": "572d1140be113f47fc143193de1215035acf027b595d3104b60614cdeedb03a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92215"
      ],
      "target_text": "Tôi đã lấy lại tinh thần rồi……\r\nNào, dù là bài tập nào\r\ntôi cũng sẽ hoàn thành thật hoàn hảo!",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:5514221948b6d34d1de0f596",
      "kind": "character_system_text",
      "source_text": "真的没问题吗……\r\n训练员，要是我的蝴蝶结掉了\r\n请立刻告诉我。",
      "source_fingerprint": "c00838efa6af9807b314548c1a1142e3e4d227716d5e5ac498dbf880deefa717",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92216"
      ],
      "target_text": "Thật sự không sao chứ……\r\nTrainer, nếu chiếc nơ của tôi bị tuột\r\nhãy báo ngay cho tôi nhé.",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:e34245d157d3c52fa1d9ac1d",
      "kind": "character_system_text",
      "source_text": "只要事关胜负，无论何时何地……\r\n都必须全力以赴。",
      "source_fingerprint": "3c801d5b4f614c4a2214b900e09e51b4f636cdef4c6db4b4ed952e2b243f197d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92217"
      ],
      "target_text": "Chỉ cần liên quan đến thắng thua, bất kể lúc nào hay ở đâu……\r\nđều phải dốc toàn lực.",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:4712cd23cc2e42898cf31f2e",
      "kind": "character_system_text",
      "source_text": "我也能够提出一些\r\n傻气的任性要求吗？\r\n……呵呵，开玩笑的。",
      "source_fingerprint": "33a678b11ff7f83a3bf4c3bf0b155fa6d30d2a6d72a663e41cce9c3d1bb00dc1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92218"
      ],
      "target_text": "Tôi cũng có thể đưa ra vài\r\nyêu cầu ngốc nghếch và ích kỷ chứ?\r\n……Hehe, tôi đùa thôi.",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:c260bfcec86e8abb6d6d1e58",
      "kind": "character_system_text",
      "source_text": "「身为目白家的赛马娘」……\r\n我会将这份骄傲铭记在心，\r\n但不受此束缚，持续向前迈进。",
      "source_fingerprint": "6daffc80d2c4674e92add8c9d4eb3f7dcfefa92f094cb3aa0318478e827becfe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "92220"
      ],
      "target_text": "「Là một Mã Nương nhà Mejiro」……\r\nTôi sẽ khắc ghi niềm kiêu hãnh ấy,\r\nnhưng không để nó trói buộc và sẽ tiếp tục tiến bước.",
      "reviewed": true
    }
  ]
}
