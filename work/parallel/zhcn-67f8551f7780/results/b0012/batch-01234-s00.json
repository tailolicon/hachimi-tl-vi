{"schema_version":1,"status":"complete","epoch":"zhcn-67f8551f7780","task_id":"batch-01234-s00","batch":1234,"shard":0,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":0,"shard_end_exclusive":20,"translated_count":20,"entries":[{"entry_index":0,"uid":"zhcn:3bf8d2c989a879d376340cef","kind":"character_system_text","source_text":"对手是谁都可以──\r\n试着让我认真起来吧……！","source_fingerprint":"fc7e43b0d6a91dd11536f25c0bc8c1e47d9c9f13335923c51dbcbd1785622ced","source_path":"character_system_text_dict.json","json_path":["1016","20024"],"target_text":"Đối thủ là ai cũng được──\r\nThử khiến ta phải nghiêm túc xem nào……!","reviewed":true},{"entry_index":1,"uid":"zhcn:bdc642805c7571d279fd692c","kind":"character_system_text","source_text":"热血沸腾……\r\n对决即将要开始了……！","source_fingerprint":"1a582d7375fb7028f4d175b1bd054014a8f6e88977d26e54a56f8030359a1818","source_path":"character_system_text_dict.json","json_path":["1016","20025"],"target_text":"Máu nóng đang sôi lên……\r\nTrận quyết đấu sắp bắt đầu rồi……!","reviewed":true},{"entry_index":2,"uid":"zhcn:2bcec58d715498585d342fda","kind":"character_system_text","source_text":"……想被我狩猎的家伙在哪？\r\n我来成全你们。","source_fingerprint":"e720adeedf7d40114910b7058c46ed12389f59f6e6c0add835de1b3b88420638","source_path":"character_system_text_dict.json","json_path":["1016","20026"],"target_text":"……Kẻ nào muốn bị ta săn đâu rồi?\r\nTa sẽ chiều các ngươi.","reviewed":true},{"entry_index":3,"uid":"zhcn:334440f2ffc9dd1f293e9c09","kind":"character_system_text","source_text":"很快就能定出胜负了吧。\r\n──瞬间高下立判。","source_fingerprint":"05e34a28224158cd77a33b272dcb4cb571b55c73007ad04940112bc7fde01591","source_path":"character_system_text_dict.json","json_path":["1016","20027"],"target_text":"Chắc sẽ phân thắng bại nhanh thôi.\r\n──Chỉ một thoáng là biết ai hơn ai.","reviewed":true},{"entry_index":4,"uid":"zhcn:bd0f0d7f80be0575ef832168","kind":"character_system_text","source_text":"我只要用实力压倒所有人就行了。","source_fingerprint":"41463c1c1bd9f723e7470ff0bd8857525fa438955e06adf5abed1199c2cc8473","source_path":"character_system_text_dict.json","json_path":["1016","20028"],"target_text":"Ta chỉ cần dùng thực lực áp đảo tất cả là được.","reviewed":true},{"entry_index":5,"uid":"zhcn:43ae05980764f451457e675d","kind":"character_system_text","source_text":"……拿下胜利。仅此而已。","source_fingerprint":"8c5bc8d32e175800ddf1124454bf01bd0446828a2969e332a20b2cbd75803c74","source_path":"character_system_text_dict.json","json_path":["1016","20029"],"target_text":"……Giành chiến thắng. Chỉ vậy thôi.","reviewed":true},{"entry_index":6,"uid":"zhcn:28e34b677ee8a557f5404383","kind":"character_system_text","source_text":"发挥一直以来锻炼的成果吧。","source_fingerprint":"11da74ede572e904da6184cbe6a0f574e97d6cf9e269f9c3d38cf2bb8de2f4ff","source_path":"character_system_text_dict.json","json_path":["1016","20030"],"target_text":"Phát huy thành quả rèn luyện bấy lâu thôi.","reviewed":true},{"entry_index":7,"uid":"zhcn:3cf8361e09e58b8e1cdf06c8","kind":"character_system_text","source_text":"我已经等不及……\r\n要听到开场小号的声音了。","source_fingerprint":"de615668ac7b5c5e37efc8d33ddfb469bf62941a879a9570fea78a28d0a77796","source_path":"character_system_text_dict.json","json_path":["1016","20031"],"target_text":"Ta không chờ nổi nữa……\r\nMuốn nghe tiếng kèn hiệu khai cuộc lắm rồi.","reviewed":true},{"entry_index":8,"uid":"zhcn:2ba0c7b4d06c3bd7bf8a5952","kind":"character_system_text","source_text":"就这种程度……没问题的。\r\n不用特别担心。","source_fingerprint":"3c78a3f25423e0e0a69dc116df14ed7810143f47a07e8091bf7b594db6805ccf","source_path":"character_system_text_dict.json","json_path":["1016","20032"],"target_text":"Chỉ mức này thôi…… không sao.\r\nKhông cần lo lắng quá.","reviewed":true},{"entry_index":9,"uid":"zhcn:4d3248d96af19b46cf7abb78","kind":"character_system_text","source_text":"虽然会多少影响到我的表现……\r\n……但也只需要去克服而已。","source_fingerprint":"ef549219ce0bf0836368b8e398e6103041620fdcc2ba4f71cb55f22ebcacf8e0","source_path":"character_system_text_dict.json","json_path":["1016","20033"],"target_text":"Dù sẽ ảnh hưởng ít nhiều đến màn thể hiện của ta……\r\n……thì cũng chỉ cần vượt qua thôi.","reviewed":true},{"entry_index":10,"uid":"zhcn:fc2a4a65123e11c76881ba7a","kind":"character_system_text","source_text":"不用过度担心。\r\n专心盯着前方就好……","source_fingerprint":"510bf388e297f4b6195312559ae21a6dc12406b7fcaf546f63f67bd31bb3613a","source_path":"character_system_text_dict.json","json_path":["1016","20034"],"target_text":"Không cần lo lắng quá.\r\nChỉ cần tập trung nhìn về phía trước……","reviewed":true},{"entry_index":11,"uid":"zhcn:a90e0110c8903c717401d2d7","kind":"character_system_text","source_text":"「毒药用好了也能成为良药」\r\n大姐曾这么说过……但究竟……","source_fingerprint":"3fe531f45299cc848b614a2b14020f4e9fdab1a959cf1293d55311ebe1897b9f","source_path":"character_system_text_dict.json","json_path":["1016","20035"],"target_text":"「Độc dược nếu dùng đúng cách cũng có thể thành thuốc tốt」\r\nChị cả từng nói vậy…… nhưng rốt cuộc……","reviewed":true},{"entry_index":12,"uid":"zhcn:96791e6fbc3b367ea90faae5","kind":"character_system_text","source_text":"现在才后悔也已经没有意义了。\r\n……只能全力以赴了。","source_fingerprint":"0bb9211ea239c3153f396d36be0a5bf8ba2b31eeabd1f4ea8f60b097e072f568","source_path":"character_system_text_dict.json","json_path":["1016","20036"],"target_text":"Giờ có hối hận cũng chẳng còn ý nghĩa gì.\r\n……Chỉ còn cách dốc toàn lực.","reviewed":true},{"entry_index":13,"uid":"zhcn:9bac406df0fc97bb38f65f43","kind":"character_system_text","source_text":"现在还不是我倒下的时候……！","source_fingerprint":"c9d48a81d6e18b640bf92af12b404ce951d4628fb1cd11aa48b1a6ff85cf4c5b","source_path":"character_system_text_dict.json","json_path":["1016","20037"],"target_text":"Giờ chưa phải lúc ta gục xuống……!","reviewed":true},{"entry_index":14,"uid":"zhcn:979b5fcaf849cbee105aad18","kind":"character_system_text","source_text":"走吧。","source_fingerprint":"f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf","source_path":"character_system_text_dict.json","json_path":["1016","20038"],"target_text":"Đi thôi.","reviewed":true},{"entry_index":15,"uid":"zhcn:ffda0e30daf435bc3912c82e","kind":"character_system_text","source_text":"……好吧。","source_fingerprint":"52c1743b838216f957d3056e8112f3dd8b15089fcfd0e26e4df719d36a32fe5d","source_path":"character_system_text_dict.json","json_path":["1016","20039"],"target_text":"……Được thôi.","reviewed":true},{"entry_index":16,"uid":"zhcn:d2cad19e5af5deae3e9b1a2d","kind":"character_system_text","source_text":"……是啊。","source_fingerprint":"23a22cc4a53409f493b70a2e7dcc991892bfecf828df0ec04e437aefd4003943","source_path":"character_system_text_dict.json","json_path":["1016","20040"],"target_text":"……Ừ.","reviewed":true},{"entry_index":17,"uid":"zhcn:731ae4b83d01bc6d07a02505","kind":"character_system_text","source_text":"开始吧。","source_fingerprint":"5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299","source_path":"character_system_text_dict.json","json_path":["1016","20041"],"target_text":"Bắt đầu thôi.","reviewed":true},{"entry_index":18,"uid":"zhcn:9f8dd20dcb8a430eebf47ad9","kind":"character_system_text","source_text":"啧……","source_fingerprint":"f067f48da199e272fcff687fcdf4c651840778b12461e92a3b2f3daffefaa1f2","source_path":"character_system_text_dict.json","json_path":["1016","20042"],"target_text":"Chậc……","reviewed":true},{"entry_index":19,"uid":"zhcn:6024ca02de5d0e3749c5f21b","kind":"character_system_text","source_text":"可恶……","source_fingerprint":"ed21a303e5d04ce20dc3019128d0a1b9543f7a003cdb9a3f9ece6e791dcf33a4","source_path":"character_system_text_dict.json","json_path":["1016","20043"],"target_text":"Chết tiệt……","reviewed":true}]}