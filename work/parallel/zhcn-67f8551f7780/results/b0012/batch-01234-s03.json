  "entries": [
    {"entry_index":60,"uid":"zhcn:990eeb6b74a64492dd7f3800","kind":"character_system_text","source_text":"就不能不要这么多装饰吗……","source_fingerprint":"c1dd7a315c84e3cb8e84ee85378bf90356ecde000d0094f07df1a7904b897a02","source_path":"character_system_text_dict.json","json_path":["1016","70010"],"target_text":"Không thể bớt mấy món trang trí này đi sao…","reviewed":true},
    {"entry_index":61,"uid":"zhcn:f7bba3161c5029dee3ea2d55","kind":"character_system_text","source_text":"唔，竟然这么花俏……烦死了。","source_fingerprint":"aacc35f2eb4cf41842c00ae6f01b3a9f6d15731f419b6248c7d3764023ace566","source_path":"character_system_text_dict.json","json_path":["1016","70014"],"target_text":"Hừm, màu mè đến thế này… phiền chết đi được.","reviewed":true},
    {"entry_index":62,"uid":"zhcn:163bcfd6bf780b5246059dc2","kind":"character_system_text","source_text":"脚的重量……让我感到安心。","source_fingerprint":"81f8bda053a93cb174d09d002c6c66c68d3cbce710b10fe15047bebdf19319bb","source_path":"character_system_text_dict.json","json_path":["1016","70015"],"target_text":"Sức nặng nơi đôi chân… khiến tôi thấy yên tâm.","reviewed":true},
    {"entry_index":63,"uid":"zhcn:6e8100a652f552632c83f3f4","kind":"character_system_text","source_text":"渴望着奔跑而蠢蠢欲动……","source_fingerprint":"ed1821085f97dc4bffa2118507e747bec7108d3e3652e17f0bcf4a09732e2437","source_path":"character_system_text_dict.json","json_path":["1016","70016"],"target_text":"Cả người cứ rạo rực vì muốn được chạy…","reviewed":true},
    {"entry_index":64,"uid":"zhcn:24d7aed5ff0a062a160ee089","kind":"character_system_text","source_text":"心无旁鹜、贪得无厌。\r\n我就是如此贪求胜利。","source_fingerprint":"8029ca214906e92850dafc14cb819bfeea8fa5d4a1e35a0ee537a9e6df7b5822","source_path":"character_system_text_dict.json","json_path":["1016","70017"],"target_text":"Không màng gì khác, chẳng bao giờ biết đủ.\r\nTôi khao khát chiến thắng đến thế.","reviewed":true},
    {"entry_index":65,"uid":"zhcn:02056bcba180c0417ee6add0","kind":"character_system_text","source_text":"拉开距离……！","source_fingerprint":"6149abb4aa32b6dadccbb0a4f7cd37d4f0b61524db3253f0812ed6bb47e1cb79","source_path":"character_system_text_dict.json","json_path":["1016","70018"],"target_text":"Bứt xa…!","reviewed":true},
    {"entry_index":66,"uid":"zhcn:0c76f56b2c51fce971e418ac","kind":"character_system_text","source_text":"真是吵闹啊……","source_fingerprint":"2b7a8b2d9cfb004306ecb3e850920b3b65e421120f0c7cf5543082688f0c29fb","source_path":"character_system_text_dict.json","json_path":["1016","70019"],"target_text":"Đúng là ồn ào…","reviewed":true},
    {"entry_index":67,"uid":"zhcn:3b1e064689b94c128eb9d08f","kind":"character_system_text","source_text":"虽然跑起来有点不便，但我并不讨厌。","source_fingerprint":"a4c95acee33058d1d02e70dab56d99647d6a75ad4bbaad421c6a8052b05d08b3","source_path":"character_system_text_dict.json","json_path":["1016","70020"],"target_text":"Chạy thì hơi vướng, nhưng tôi không ghét.","reviewed":true},
    {"entry_index":68,"uid":"zhcn:da1623559d5d5cf8618880a6","kind":"character_system_text","source_text":"我比较喜欢长裤。便于行动。","source_fingerprint":"b7ac7d231a54d7d7712b090e8c4abb34e322473d653749afc41c00116cb5aa2f","source_path":"character_system_text_dict.json","json_path":["1016","70021"],"target_text":"Tôi thích quần dài hơn. Dễ vận động.","reviewed":true},
    {"entry_index":69,"uid":"zhcn:23663d37ba784cd769b08b95","kind":"character_system_text","source_text":"……我常会忘记蝴蝶结，\r\n但没有也没差。","source_fingerprint":"455be9677123b9917c1c7a05dfc12e15b98176dcf3dc0948bad71a49f6d6f13a","source_path":"character_system_text_dict.json","json_path":["1016","71004"],"target_text":"…Tôi hay quên nơ,\r\nnhưng không có cũng chẳng sao.","reviewed":true}
