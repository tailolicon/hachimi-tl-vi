    {"entry_index":44,"uid":"zhcn:48d95135169cba929850df6f","kind":"character_system_text","source_text":"献上光荣的胜利！永恒的美丽！\r\n在此发誓吧！","source_fingerprint":"b2b86764ed912a523d2fc1bf76208c6eef0aedf8104d167e9e88b8c8f60f26f0","source_path":"character_system_text_dict.json","json_path":["1018","95009"],"target_text":"Dâng lên chiến thắng vinh quang! Vẻ đẹp vĩnh hằng!\r\nHãy thề ngay tại đây!","reviewed":true},
    {"entry_index":45,"uid":"zhcn:ff25632e2a61a326eeaf00d4","kind":"character_system_text","source_text":"我是气槽。\r\n你做好和我共进退的觉悟了吗？","source_fingerprint":"c835162d4bf2f67a7f36d57c45078c9f090fb89dbee87b4caf68a26f31bf533b","source_path":"character_system_text_dict.json","json_path":["1018","95010"],"target_text":"Tôi là Air Groove.\r\nCậu đã chuẩn bị tinh thần cùng tôi sát cánh, dù tiến hay lùi chưa?","reviewed":true},
    {"entry_index":46,"uid":"zhcn:647ef285524e044b0779b1fe","kind":"character_system_text","source_text":"我来帮你介绍！！","source_fingerprint":"e63c9689ff5cf3c51ebd8dfa3bc96d20714524aea0abca993bb27c24c65b42ca","source_path":"character_system_text_dict.json","json_path":["1019","1000"],"target_text":"Để tôi giới thiệu cho bạn nhé!!","reviewed":true},
