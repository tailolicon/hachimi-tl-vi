  "entries": [
    {"entry_index":20,"uid":"zhcn:cdbb27f091c3815a8fc59488","kind":"character_system_text","source_text":"这个，就是这个！\r\n非圣地巡礼的圣服穿着！！","source_fingerprint":"f0f2bbc9730016e42394acdf3b4584367dd78d39a2109cf1ae259d15a112f7ac","source_path":"character_system_text_dict.json","json_path":["1019","70004"],"target_text":"Đây, chính là thế này!\r\nMặc thánh phục mà chẳng cần hành hương thánh địa!!","reviewed":true},
    {"entry_index":21,"uid":"zhcn:f0cfe45303bb5376a5c5ca3a","kind":"character_system_text","source_text":"憧憬的服装……！虽然已经在原稿上\r\n画过很多次，居然要实际穿上……！","source_fingerprint":"f1e7403b3f0ffef218227cd6b7267753d83b54fa07c5f1c96c24658671985486","source_path":"character_system_text_dict.json","json_path":["1019","70008"],"target_text":"Bộ trang phục hằng ao ước……! Dù đã vẽ nó\r\nbao lần trong bản thảo, giờ lại được mặc thật……!","reviewed":true},
    {"entry_index":22,"uid":"zhcn:11d8730d906ece2f64825422","kind":"character_system_text","source_text":"如果我是在场上跑的人……\r\n就是这套服装让我持续陷入妄想！","source_fingerprint":"dfd72b5da1760a8acbe6dbf6a6985e83823ce042954c6bf1c4998061ded150ff","source_path":"character_system_text_dict.json","json_path":["1019","70009"],"target_text":"Nếu mình là người đang chạy trên sân……\r\nChính bộ trang phục này khiến mình cứ mãi chìm trong tưởng tượng!","reviewed":true},
    {"entry_index":23,"uid":"zhcn:46d959948b6690b4ea3e631b","kind":"character_system_text","source_text":"……我有成功变成墙壁吗？\r\n有完全融入吗？","source_fingerprint":"0d7fa1e2be8f0230caf9c7b8bafa2cf7cd269b97b471de68b5fdf323af8cc475","source_path":"character_system_text_dict.json","json_path":["1019","70010"],"target_text":"……Mình đã biến thành bức tường thành công chưa?\r\nĐã hòa vào hoàn toàn chưa?","reviewed":true},
    {"entry_index":24,"uid":"zhcn:cfa8944ff0cc880f9eefe4b6","kind":"character_system_text","source_text":"到处都能看见用心呢……！\r\n要让赛马娘上镜头的用心……！","source_fingerprint":"b485ee26d5daf2a869d41c535cb6461e746c82e9a8eca4ac95f555ad05214d7c","source_path":"character_system_text_dict.json","json_path":["1019","70014"],"target_text":"Chỗ nào cũng thấy sự chăm chút……!\r\nSự chăm chút để đưa Mã Nương lên hình……!","reviewed":true},
    {"entry_index":25,"uid":"zhcn:a023acaf48db44b1cba15053","kind":"character_system_text","source_text":"是的，完全都是我的喜好！\r\n……感觉有点难为情呢！","source_fingerprint":"59e2dd5953a93eb3722d3c0c1174e45bf6f40b32b888497dd4b5f3b6721ac600","source_path":"character_system_text_dict.json","json_path":["1019","70015"],"target_text":"Đúng vậy, hoàn toàn là gu của tôi!\r\n…… Hơi ngượng thật đấy!","reviewed":true},
    {"entry_index":26,"uid":"zhcn:6b2323abd6c90d14129309ac","kind":"character_system_text","source_text":"殭尸在萌萌指引之下复活！","source_fingerprint":"75fe4e8a5d5fc7bc20966b242748fe4273e3019a9cd827e4ae99395f8b5d377a","source_path":"character_system_text_dict.json","json_path":["1019","70016"],"target_text":"Xác sống hồi sinh dưới sự dẫn lối của moe!","reviewed":true},
    {"entry_index":27,"uid":"zhcn:7825a7ea0d1b5bc55039e28d","kind":"character_system_text","source_text":"这套服装处处充满我的巧思，\r\n以免站在暗处时吓到别人……！","source_fingerprint":"8ca8d8cf2f5f9b7bcac1389cd690b8ede2e443742f85a36984d43a7c86585c5a","source_path":"character_system_text_dict.json","json_path":["1019","70017"],"target_text":"Bộ trang phục này chỗ nào cũng có dụng ý của tôi,\r\nđể khỏi dọa người khác khi đứng trong chỗ tối……!","reviewed":true},
    {"entry_index":28,"uid":"zhcn:1c338e9cb538e7c96a177d4a","kind":"character_system_text","source_text":"我是数码碳喔──☆","source_fingerprint":"3056cac86b0710b40349bce1c0e988c05a42d9886adc0782e9c6edd680fb2775","source_path":"character_system_text_dict.json","json_path":["1019","70018"],"target_text":"Tôi là Digitan đây──☆","reviewed":true},
    {"entry_index":29,"uid":"zhcn:37fa86d657a1049197f49195","kind":"character_system_text","source_text":"就算对手是赛马娘，我也不会输喔！","source_fingerprint":"96ade0adf1ca5ff846a5c8a2e394f4d79ad2b45d0464c911069405bddca02dbc","source_path":"character_system_text_dict.json","json_path":["1019","70019"],"target_text":"Dù đối thủ là Mã Nương, tôi cũng không thua đâu!","reviewed":true}
  ]
}
