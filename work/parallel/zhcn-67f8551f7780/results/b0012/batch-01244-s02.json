    {"entry_index":40,"uid":"zhcn:800aa33d2b43cf316c4fab81","kind":"character_system_text","source_text":"我是数码碳喔──☆","source_fingerprint":"3056cac86b0710b40349bce1c0e988c05a42d9886adc0782e9c6edd680fb2775","source_path":"character_system_text_dict.json","json_path":["1019","71018"],"target_text":"Tôi là Digitan đây──☆","reviewed":true},
    {"entry_index":41,"uid":"zhcn:051975cae82d004b158ece2e","kind":"character_system_text","source_text":"就算对手是赛马娘，我也不会输喔！","source_fingerprint":"96ade0adf1ca5ff846a5c8a2e394f4d79ad2b45d0464c911069405bddca02dbc","source_path":"character_system_text_dict.json","json_path":["1019","71019"],"target_text":"Dù đối thủ là Mã Nương, tôi cũng không thua đâu!","reviewed":true},
    {"entry_index":42,"uid":"zhcn:0e985fdad08ed89dc10b76e8","kind":"character_system_text","source_text":"辛苦了！","source_fingerprint":"20df094ff1112517c623c111a7239f2b6398134743fb570a85aa6a2f9f1f8889","source_path":"character_system_text_dict.json","json_path":["1019","80000"],"target_text":"Vất vả rồi!","reviewed":true},
    {"entry_index":43,"uid":"zhcn:73232b7e1974fad800e7f765","kind":"character_system_text","source_text":"拜托你\r\n手下留情！","source_fingerprint":"40712406319daac77f76916d8e8e048d72bd95d57c95db188c089fa7be87c98b","source_path":"character_system_text_dict.json","json_path":["1019","81000"],"target_text":"Nhờ cậu\r\nnương tay nhé!","reviewed":true},
    {"entry_index":44,"uid":"zhcn:4b345b401adb715d25e2aab9","kind":"character_system_text","source_text":"太棒了……！\r\n还请再多多展现给我看吧！","source_fingerprint":"29ceedb495e55f19beda06dba9fd920f5b8b56e79d1e9e5c6c0fefb381182b55","source_path":"character_system_text_dict.json","json_path":["1019","81001"],"target_text":"Tuyệt quá……!\r\nHãy cho tôi được thấy nhiều hơn nữa nhé!","reviewed":true},
    {"entry_index":45,"uid":"zhcn:b1fb10a71b1fbd13dcdbea65","kind":"character_system_text","source_text":"早安！\r\n今天也要好好地\r\n行善积德喔～！","source_fingerprint":"a22f24eaf3ee1e633c0c25bc778a9bc4379eb3ad7d2a28ea1b1e5b512a6b096a","source_path":"character_system_text_dict.json","json_path":["1019","90000"],"target_text":"Chào buổi sáng!\r\nHôm nay cũng phải chăm chỉ\r\nlàm việc thiện tích đức nhé～!","reviewed":true},
    {"entry_index":46,"uid":"zhcn:4150cdb8bba3d1ca64b86973","kind":"character_system_text","source_text":"我今天早上也在速子醒来前\r\n就离开宿舍了！\r\n因为我不想在早晨打扰到我的推嘛！","source_fingerprint":"024fe697583d8d3d42889f91effddca12afb01421128d63181425dcb717484ba","source_path":"character_system_text_dict.json","json_path":["1019","90001"],"target_text":"Sáng nay mình cũng rời ký túc xá\r\ntrước khi Tachyon thức dậy!\r\nVì mình không muốn làm phiền oshi vào buổi sáng mà!","reviewed":true},
    {"entry_index":47,"uid":"zhcn:be5bd2349923d5dde0c1d083","kind":"character_system_text","source_text":"你好！今天是个超棒的赛马娘\r\n好日子呢～♪我要完全隐藏气息，\r\n把自己变成一堵墙喔！","source_fingerprint":"60a35bb1a95db6d013e0a1b611d79d9d0f68ff74227ec8099aee2587dc4f1785","source_path":"character_system_text_dict.json","json_path":["1019","90002"],"target_text":"Xin chào! Hôm nay đúng là một ngày\r\ntuyệt vời dành cho Mã Nương～♪ Mình sẽ giấu sạch khí tức,\r\nbiến mình thành một bức tường!","reviewed":true},
    {"entry_index":48,"uid":"zhcn:c89a3d30dd50038c1cf974c3","kind":"character_system_text","source_text":"唔呼～！现在食堂中\r\n挤满了赛马娘……！\r\n我稍微去偷看一下好了……！？","source_fingerprint":"88f99443c11faaf937fc40f086d929f958b4d5f444db01a491498ae0b849fc21","source_path":"character_system_text_dict.json","json_path":["1019","90003"],"target_text":"Ư hư～! Giờ nhà ăn đang\r\nchật kín Mã Nương……!\r\nMình lén nhìn một chút vậy……!?","reviewed":true},
    {"entry_index":49,"uid":"zhcn:0cec0eee2772c2b2b6748e21","kind":"character_system_text","source_text":"好了好了，已经天黑了。\r\n我们阿宅的本领\r\n要从现在开始才会发挥出来喔～～","source_fingerprint":"30e115e9538e0cde50266eadc149a3f4629be709d68720c03daf1edfbcfd66f1","source_path":"character_system_text_dict.json","json_path":["1019","90004"],"target_text":"Nào nào, trời tối rồi.\r\nBản lĩnh của otaku chúng ta\r\ngiờ mới bắt đầu phát huy đó～～","reviewed":true}
  ]
