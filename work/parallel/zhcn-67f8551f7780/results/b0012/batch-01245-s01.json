  "entries": [
    {"entry_index":20,"uid":"zhcn:858b0eeb3708df02fd04ad6d","kind":"character_system_text","source_text":"那个要这样子，这个要那样子……\r\n唔呵呵，假想训练无懈可击！","source_fingerprint":"d34bd87861bb3bd27bd30c5d8e20a5749d2a549d8b9124a7113d73b2fd73f2de","source_path":"character_system_text_dict.json","json_path":["1019","92001"],"target_text":"Cái kia làm thế này, cái này làm thế kia……\r\nƯ hư hư, mô phỏng huấn luyện hoàn hảo!","reviewed":true},
    {"entry_index":21,"uid":"zhcn:3ccf4e36340eefa1b020fe90","kind":"character_system_text","source_text":"呼，今天我的推也很尊。","source_fingerprint":"0b7b1f1d852f46e023e41e4780a16e6f12e60265b1b306b656470a8b90f19b71","source_path":"character_system_text_dict.json","json_path":["1019","92002"],"target_text":"Phù, hôm nay oshi của mình cũng tôn quý quá.","reviewed":true},
    {"entry_index":22,"uid":"zhcn:f586ecaeb54af0c912a78087","kind":"character_system_text","source_text":"一想到究竟有多少赛马娘\r\n曾经通过这里……\r\n──真让人受不了！！","source_fingerprint":"b56ae0fa4fc969b299ee16818a8843bf11a3a214b060698e5764ba83419791f3","source_path":"character_system_text_dict.json","json_path":["1019","92003"],"target_text":"Chỉ cần nghĩ đã có biết bao Mã Nương\r\ntừng đi qua nơi này……\r\n── là mình chịu không nổi!!","reviewed":true},
    {"entry_index":23,"uid":"zhcn:e16ae0facc81070d92988f02","kind":"character_system_text","source_text":"古代的哲学家有云：\r\n「所谓的爱，比起被爱，\r\n更该去爱人」……","source_fingerprint":"160b28f7a0d76738a7198829783d7f3453ccddf0cd4df058f954a1676030b9c2","source_path":"character_system_text_dict.json","json_path":["1019","92005"],"target_text":"Triết gia cổ đại từng nói:\r\n“Yêu, thay vì được yêu,\r\nthì càng nên trao tình yêu cho người khác”……","reviewed":true},
    {"entry_index":24,"uid":"zhcn:9137805e5eeda1e251c81304","kind":"character_system_text","source_text":"「仰之弥高，\r\n钻之弥坚」──\r\n……赛马娘也是这样呢～","source_fingerprint":"ea197a471bf81eb493ce0da5b3a471b8fea5d88227cae4a2758003c014b15cfc","source_path":"character_system_text_dict.json","json_path":["1019","92006"],"target_text":"“Càng ngước nhìn càng thấy cao,\r\ncàng đào sâu càng thấy vững”──\r\n…… Mã Nương cũng vậy nhỉ～","reviewed":true}
  ]
