  "entries": [
    {"entry_index":40,"uid":"zhcn:115dd8302139e242db1748c9","kind":"character_system_text","source_text":"是的，我是爱丽数码！","source_fingerprint":"a7e077841cc0927c36062aa5a024a6b8ad7e0011f77229aa9769603ee539e10b","source_path":"character_system_text_dict.json","json_path":["1019","95003"],"target_text":"Vâng, tôi là Agnes Digital!","reviewed":true},
    {"entry_index":41,"uid":"zhcn:155810040fe04b8f4c2bb8de","kind":"character_system_text","source_text":"只要是为了感受我的推，\r\n不管要跑过草地还是沙土都愿意！！","source_fingerprint":"5921faa580f0367d68d282c3734ddd2f22ead0be59644f8c7443cc9c0dad86dd","source_path":"character_system_text_dict.json","json_path":["1019","95004"],"target_text":"Miễn là để cảm nhận oshi của mình,\r\ndù phải chạy trên Turf hay Dirt mình cũng sẵn lòng!!","reviewed":true},
    {"entry_index":42,"uid":"zhcn:a401cbff7bdafa89afdf7daa","kind":"character_system_text","source_text":"我一定会追好追满的～！","source_fingerprint":"4a7b9289248b4f081527322b8d868f6bd3f55ed3e07351bb916569513fcbda3a","source_path":"character_system_text_dict.json","json_path":["1019","95005"],"target_text":"Mình nhất định sẽ theo đến cùng～!","reviewed":true},
    {"entry_index":43,"uid":"zhcn:1d12b4241002b16d440161aa","kind":"character_system_text","source_text":"我会好好服侍的……！","source_fingerprint":"7cb5261ea824818c6724f4be330196bf58c5baedd0c4cb6a5af8c4ac63b93f30","source_path":"character_system_text_dict.json","json_path":["1019","95006"],"target_text":"Mình sẽ phục vụ thật chu đáo……!","reviewed":true},
    {"entry_index":44,"uid":"zhcn:4ccc85179e37ef2879503ce9","kind":"character_system_text","source_text":"注意注意！失控殭尸来了！","source_fingerprint":"43df087b90221b0b2bbef181a505a6febc59337bdf55d38599b3218f7e5e5bef","source_path":"character_system_text_dict.json","json_path":["1019","95007"],"target_text":"Chú ý chú ý! Zombie mất kiểm soát tới đây!","reviewed":true},
    {"entry_index":45,"uid":"zhcn:9b36c5070b93930d40f28dc2","kind":"character_system_text","source_text":"数码殭尸大飞翔！","source_fingerprint":"44e2c29d1d3d9acb70d5c134de3af58f39afdf92ceeb908c221bd5b350ab0c86","source_path":"character_system_text_dict.json","json_path":["1019","95008"],"target_text":"Zombie Digital đại phi hành!","reviewed":true},
    {"entry_index":46,"uid":"zhcn:75ff1c94676ed1de998ff6ed","kind":"character_system_text","source_text":"无论被尊倒几次，我都会\r\n为了尊而……再度复活──！！","source_fingerprint":"62191b742fa24aaf3f4394da9dd56e138605a203325ab60920b95cdb3110da29","source_path":"character_system_text_dict.json","json_path":["1019","95009"],"target_text":"Dù bị tôn quý đến gục bao nhiêu lần, mình vẫn sẽ\r\nvì sự tôn quý mà…… hồi sinh lần nữa──!!","reviewed":true},
    {"entry_index":47,"uid":"zhcn:df8bf53e01f529428751620b","kind":"character_system_text","source_text":"爱丽数码复活啰～！","source_fingerprint":"758d4c4ca76f7291b6b185726332f7a8383e6abc0746e9e519dbcc1a0284a8a9","source_path":"character_system_text_dict.json","json_path":["1019","95010"],"target_text":"Agnes Digital hồi sinh rồi～!","reviewed":true},
    {"entry_index":48,"uid":"zhcn:5a5b6adbbe93f453f4a48614","kind":"character_system_text","source_text":"那我就去咯——","source_fingerprint":"e96441a321db55e3e5b8eb19cf1f36a61d6fc16261e9eb4346e00b1bdd3cd9e2","source_path":"character_system_text_dict.json","json_path":["1020","1000"],"target_text":"Vậy mình đi đây——","reviewed":true},
    {"entry_index":49,"uid":"zhcn:836ae4df1a57e104ef0619ac","kind":"character_system_text","source_text":"既然决定要钓了，\r\n那就钓大鱼吧，最大的那种。\r\n这样也比较有意思嘛。","source_fingerprint":"7c1ff64773b70f9fc3118953b47ee86245c3dd99459f7363b46238fef723a1f9","source_path":"character_system_text_dict.json","json_path":["1020","10000"],"target_text":"Đã quyết định đi câu rồi,\r\nthì câu cá lớn đi, loại lớn nhất ấy.\r\nNhư vậy mới thú vị chứ.","reviewed":true}
