    {"entry_index":2,"uid":"zhcn:167eadb9004bb1aeeb1bbbde","kind":"character_system_text","source_text":"做得好，做得好——♪","source_fingerprint":"4129c2ff8c874d2ca42241807a84bebdff0831db79f5fccc2c4666ca6b84cda8","source_path":"character_system_text_dict.json","json_path":["1020","30000"],"target_text":"Giỏi lắm, giỏi lắm——♪","reviewed":true},
