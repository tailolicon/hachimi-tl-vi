    {"entry_index":20,"uid":"zhcn:8bd6995d99b3cab048e1d90f","kind":"character_system_text","source_text":"那就乘上这股风吧！","source_fingerprint":"b2ccb41c493f0111591d91f8b3aec4e3446cc2584f07bd537b85d052a8f48293","source_path":"character_system_text_dict.json","json_path":["1020","40003"],"target_text":"Vậy thì hãy thuận theo ngọn gió này nào!","reviewed":true},
    {"entry_index":21,"uid":"zhcn:c1c58d895375545d50556c44","kind":"character_system_text","source_text":"真没劲啊……才怪☆\r\nIt's show time！……吓了一跳吧？","source_fingerprint":"dea4155b62e99646ca068b688b0cb31b3c52aa456e79e41156863be0dee1ce00","source_path":"character_system_text_dict.json","json_path":["1020","40004"],"target_text":"Chán thật đấy…… mới lạ☆\r\nIt's show time!…… Bất ngờ chưa?","reviewed":true},
    {"entry_index":22,"uid":"zhcn:540e671cc491acac2d4e921d","kind":"character_system_text","source_text":"くぁ…っ。早起きでねむ～～。\r\n――甲板の端っこで、\r\nお昼寝しちゃダメかな。","source_fingerprint":"2417f7daace9ce26133572bf7e6d66aa5b35c142043decb2577c55c654840c44","source_path":"character_system_text_dict.json","json_path":["1020","400079"],"target_text":"Khà… buồn ngủ quá vì dậy sớm～～.\r\n——Không biết chợp mắt một lát\r\nở mép boong tàu có được không nhỉ.","reviewed":true},
    {"entry_index":23,"uid":"zhcn:df9e68e2a9894bfdfa5705f3","kind":"character_system_text","source_text":"あんなに堂々とされたら\r\nみんな認めるしかないんじゃない？\r\n…かっこよかったよ、キング。","source_fingerprint":"469d99698f0c99bd0824ac025a5c2aebaf4f28842c86a7372697cad61ce8775a","source_path":"character_system_text_dict.json","json_path":["1020","400080"],"target_text":"Cứ hiên ngang đến thế thì\r\nmọi người chỉ còn cách công nhận thôi nhỉ?\r\n…Ngầu lắm đấy, King.","reviewed":true},
    {"entry_index":24,"uid":"zhcn:200ca4e86a2cb8e478711dda","kind":"character_system_text","source_text":"那我去咯——","source_fingerprint":"49c87dc39f67e8774041ff4f0c5da95bb2529cec51d206eb8280c05d02c5aac1","source_path":"character_system_text_dict.json","json_path":["1020","410000"],"target_text":"Vậy tôi đi đây——","reviewed":true},
    {"entry_index":25,"uid":"zhcn:59b05fc5f4dcba46fec6d724","kind":"character_system_text","source_text":"耶——","source_fingerprint":"ee327d3092c4afc6b71659ccfc729029aef99544817e688ab1fa87c873e2d321","source_path":"character_system_text_dict.json","json_path":["1020","410001"],"target_text":"Yê——","reviewed":true},
    {"entry_index":26,"uid":"zhcn:46bbe4040fa689d795a4f693","kind":"character_system_text","source_text":"呀哈哈——","source_fingerprint":"03f0f02e2f7841d29d7e7f75bccd3cf24118e01407f5995eb8426554eff86828","source_path":"character_system_text_dict.json","json_path":["1020","410002"],"target_text":"Ya-ha-ha——","reviewed":true},
    {"entry_index":27,"uid":"zhcn:26da40b6030957a8b3702371","kind":"character_system_text","source_text":"呀哈哈——","source_fingerprint":"03f0f02e2f7841d29d7e7f75bccd3cf24118e01407f5995eb8426554eff86828","source_path":"character_system_text_dict.json","json_path":["1020","410003"],"target_text":"Ya-ha-ha——","reviewed":true},
    {"entry_index":28,"uid":"zhcn:5ab43f94779bdb7be61b1352","kind":"character_system_text","source_text":"嘿嘿。","source_fingerprint":"6d0212cb1ec9201ff17e6acf0ea2d70e06cf290b6bc356f0e84aed5329a8a9e7","source_path":"character_system_text_dict.json","json_path":["1020","410004"],"target_text":"Hê hê.","reviewed":true},
    {"entry_index":29,"uid":"zhcn:a54454690d3352c73dc823fd","kind":"character_system_text","source_text":"嘿嘿。","source_fingerprint":"6d0212cb1ec9201ff17e6acf0ea2d70e06cf290b6bc356f0e84aed5329a8a9e7","source_path":"character_system_text_dict.json","json_path":["1020","410005"],"target_text":"Hê hê.","reviewed":true},
    {"entry_index":30,"uid":"zhcn:525c307cd856714abe9b339f","kind":"character_system_text","source_text":"诶嘿☆","source_fingerprint":"4f54137d60e821b7cae09b47fa2e665f5be43a1b8519738aecd59be7a101532f","source_path":"character_system_text_dict.json","json_path":["1020","410006"],"target_text":"Ê hê☆","reviewed":true},
    {"entry_index":31,"uid":"zhcn:96e657fc83ead65e1c657ff4","kind":"character_system_text","source_text":"诶嘿☆","source_fingerprint":"4f54137d60e821b7cae09b47fa2e665f5be43a1b8519738aecd59be7a101532f","source_path":"character_system_text_dict.json","json_path":["1020","410007"],"target_text":"Ê hê☆","reviewed":true},
    {"entry_index":32,"uid":"zhcn:d74f8e52e041075314e6a90b","kind":"character_system_text","source_text":"诶嘿☆","source_fingerprint":"4f54137d60e821b7cae09b47fa2e665f5be43a1b8519738aecd59be7a101532f","source_path":"character_system_text_dict.json","json_path":["1020","410008"],"target_text":"Ê hê☆","reviewed":true},
    {"entry_index":33,"uid":"zhcn:350af17cb99dd5d72747b8fc","kind":"character_system_text","source_text":"嘿嘿——\r\n这时候就该热闹起来才对哦——？","source_fingerprint":"3e4f7c4f3f7eabf3756aca98452bed8a93cb07467e841f4c8beed20e526c9b78","source_path":"character_system_text_dict.json","json_path":["1020","60000"],"target_text":"Hê hê——\r\nLúc thế này phải náo nhiệt lên mới đúng chứ——?","reviewed":true},
    {"entry_index":34,"uid":"zhcn:a2b064114ecc3015d6b2411d","kind":"character_system_text","source_text":"那我就来去唱一下吧——","source_fingerprint":"0cbd174ca68982dae9c1c8c5c3c3f5d4f2bbe319b71781a09c43cfb409630d4a","source_path":"character_system_text_dict.json","json_path":["1020","60001"],"target_text":"Vậy để tôi đi hát một bài nhé——","reviewed":true},
    {"entry_index":35,"uid":"zhcn:8f59f9bf3820e64fe59cbab9","kind":"character_system_text","source_text":"我们一起轻～松度过吧——","source_fingerprint":"bf3c482c9cf2b7110fbabadf4675b973d28aad0cf2ba6842a96b904dafa624a9","source_path":"character_system_text_dict.json","json_path":["1020","70000"],"target_text":"Cùng nhau thư～ thả nhé——","reviewed":true},
    {"entry_index":36,"uid":"zhcn:93379f709f45259293c4f326","kind":"character_system_text","source_text":"很久很久以前，\r\n某个新人训练员和赛马娘……\r\n哎呀？讲这太多余了是吗？","source_fingerprint":"1fd0ea0482217f2581d4341668cf3813d3134df0fe9a7c3bb0141229ed2268ad","source_path":"character_system_text_dict.json","json_path":["1020","70001"],"target_text":"Ngày xửa ngày xưa,\r\ncó một Trainer mới vào nghề và một Mã Nương……\r\nƠ? Kể thế này là thừa à?","reviewed":true},
    {"entry_index":37,"uid":"zhcn:9e1841ce809011cc9e47a11f","kind":"character_system_text","source_text":"不用烦恼每天要穿什么！\r\n制服最棒了——！","source_fingerprint":"3b53d32ee66057324b7fe9989d1d770c3f9f29335d2616489ff72f8eb67cfc61","source_path":"character_system_text_dict.json","json_path":["1020","70004"],"target_text":"Khỏi phải đau đầu mỗi ngày mặc gì!\r\nĐồng phục là nhất——!","reviewed":true},
    {"entry_index":38,"uid":"zhcn:b0c8e41df121d2279789d629","kind":"character_system_text","source_text":"跑完还要演唱会……其实很辛苦的耶～","source_fingerprint":"79a0e4a5503e46ba4dda7f2b73b9f8662486a95808f4ab9e6d6d8f0459d479ad","source_path":"character_system_text_dict.json","json_path":["1020","70008"],"target_text":"Chạy xong còn phải lên Live nữa…… thật ra vất vả lắm đó～","reviewed":true},
    {"entry_index":39,"uid":"zhcn:44d13d4f803fb3fd5681835a","kind":"character_system_text","source_text":"这是我最棒的衣服哦——","source_fingerprint":"4e7408fb5dfb9c0bd1fd04f281dddfb48eaf7ac1a9c81b065323a9f73a2e3790","source_path":"character_system_text_dict.json","json_path":["1020","70009"],"target_text":"Đây là bộ đồ tuyệt nhất của tôi đấy——","reviewed":true}
