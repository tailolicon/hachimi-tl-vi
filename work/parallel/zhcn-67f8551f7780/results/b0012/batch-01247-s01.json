    {"entry_index":20,"uid":"zhcn:8bd6995d99b3cab048e1d90f","kind":"character_system_text","source_text":"那就乘上这股风吧！","source_fingerprint":"b2ccb41c493f0111591d91f8b3aec4e3446cc2584f07bd537b85d052a8f48293","source_path":"character_system_text_dict.json","json_path":["1020","40003"],"target_text":"Vậy thì hãy thuận theo ngọn gió này nào!","reviewed":true},
    {"entry_index":21,"uid":"zhcn:c1c58d895375545d50556c44","kind":"character_system_text","source_text":"真没劲啊……才怪☆\r\nIt's show time！……吓了一跳吧？","source_fingerprint":"dea4155b62e99646ca068b688b0cb31b3c52aa456e79e41156863be0dee1ce00","source_path":"character_system_text_dict.json","json_path":["1020","40004"],"target_text":"Chán thật đấy…… mới lạ☆\r\nIt's show time!…… Bất ngờ chưa?","reviewed":true},
    {"entry_index":22,"uid":"zhcn:540e671cc491acac2d4e921d","kind":"character_system_text","source_text":"くぁ…っ。早起きでねむ～～。\r\n――甲板の端っこで、\r\nお昼寝しちゃダメかな。","source_fingerprint":"2417f7daace9ce26133572bf7e6d66aa5b35c142043decb2577c55c654840c44","source_path":"character_system_text_dict.json","json_path":["1020","400079"],"target_text":"Khà… buồn ngủ quá vì dậy sớm～～.\r\n——Không biết chợp mắt một lát\r\nở mép boong tàu có được không nhỉ.","reviewed":true},
    {"entry_index":23,"uid":"zhcn:df9e68e2a9894bfdfa5705f3","kind":"character_system_text","source_text":"あんなに堂々とされたら\r\nみんな認めるしかないんじゃない？\r\n…かっこよかったよ、キング。","source_fingerprint":"469d99698f0c99bd0824ac025a5c2aebaf4f28842c86a7372697cad61ce8775a","source_path":"character_system_text_dict.json","json_path":["1020","400080"],"target_text":"Cứ hiên ngang đến thế thì\r\nmọi người chỉ còn cách công nhận thôi nhỉ?\r\n…Ngầu lắm đấy, King.","reviewed":true},
    {"entry_index":24,"uid":"zhcn:200ca4e86a2cb8e478711dda","kind":"character_system_text","source_text":"那我去咯——","source_fingerprint":"49c87dc39f67e8774041ff4f0c5da95bb2529cec51d206eb8280c05d02c5aac1","source_path":"character_system_text_dict.json","json_path":["1020","410000"],"target_text":"Vậy tôi đi đây——","reviewed":true},
