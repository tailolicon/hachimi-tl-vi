  "shard_end_exclusive": 20,
  "worker_id": "claude-sonnet5-w4-20260904T205200Z",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:d5bb0b4c4d04af60a85ded8b",
      "kind": "character_system_text",
      "source_text": "我没办法送你贵重的东西……\r\n不过！至少我有时间！\r\n今天要我陪你几小时都可以！",
      "source_fingerprint": "2d065626dbf62d71fc9ddacbfe1015c221fffc144630df67f84b9f41d7a64179",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10012"
      ],
      "target_text": "Tôi không có gì quý giá để tặng cậu đâu……\r\nNhưng mà! Ít nhất tôi có thời gian!\r\nHôm nay muốn tôi ở bên cậu bao nhiêu tiếng cũng được!",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:7932f2974a8d1a19c947e2b1",
      "kind": "character_system_text",
      "source_text": "因为过了生日，今年可以更加\r\n成长──你在笑什么！\r\n我刚刚说的是……精神层面啦！！",
      "source_fingerprint": "a9e8932ea1621f6f0eb9e0ca8b71e2fb85131080bf7c66b3ddb58c250706cfc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10013"
      ],
      "target_text": "Vì đã qua sinh nhật nên năm nay tôi có thể trưởng thành\r\nhơn nữa──cậu cười gì thế hả!\r\nÝ tôi vừa nói là……về mặt tinh thần thôi mà!!",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:788ba01b2d0740f05b59f255",
      "kind": "character_system_text",
      "source_text": "礼物！？可以收下吗！？\r\n不好意思啊……！但我好开心！\r\n下次那个……我会送你回礼的！",
      "source_fingerprint": "749a2403acd00b56ab3e94b02c5c2db574be489843403883658dbd011f833d39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10014"
      ],
      "target_text": "Quà tặng á!? Tôi nhận được không đấy!?\r\nNgại quá……! Nhưng mà vui thật sự!\r\nLần sau đó……tôi sẽ tặng lại cậu một món quà đáp lễ!",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:1aa34c5f0f170a57b5f5e3d7",
      "kind": "character_system_text",
      "source_text": "听说有新的公告！\r\n不看就亏大咯！",
      "source_fingerprint": "2ca802bd41332b3fff3ab0d1018e8c3ac25db750c28a9b62010b2afc83a8b427",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10015"
      ],
      "target_text": "Nghe nói có thông báo mới đó!\r\nKhông xem là lỗ to đấy!",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:7c39cfbb48b73c98e5ef3476",
      "kind": "character_system_text",
      "source_text": "有礼物！太幸运了吧！\r\n你要赶快去领！",
      "source_fingerprint": "f22f9e8fb618de52feabf484e9c42b34dc72cedc3524a618a94f15463fbac2f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10016"
      ],
      "target_text": "Có quà đó! May quá đi mất!\r\nCậu mau đi nhận đi!",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:89c727b2aaba5d78c54e385a",
      "kind": "character_system_text",
      "source_text": "达成任务，辛苦了！\r\n要休息吗？给你吃糖吧。",
      "source_fingerprint": "abc294e945cdf435586291cb7b1b95f9b165f25ac999b5e13c81ee5d2df727a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10017"
      ],
      "target_text": "Hoàn thành nhiệm vụ rồi, vất vả rồi đấy!\r\nCó muốn nghỉ ngơi không? Cho cậu kẹo nè.",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:bff2d57f7e7be16a6f1fbde7",
      "kind": "character_system_text",
      "source_text": "活动好像快开始了！\r\n事不宜迟，现在就开始准备吧！",
      "source_fingerprint": "d273926a75bd8dd0a2bfdd787954b3a13d4334a677dcc0fb92f150629ad27123",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10018"
      ],
      "target_text": "Sự kiện có vẻ sắp bắt đầu rồi!\r\nKhông chần chừ nữa, chuẩn bị ngay thôi!",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:997f4695e34843b970fb6bb1",
      "kind": "character_system_text",
      "source_text": "活动举办中！\r\n会有参加奖吗？\r\n总之我们快去吧！",
      "source_fingerprint": "1990b2e1bb225597da254f8b6b68796cd2c78eb2dc134690f80f1390a3f1ef4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10019"
      ],
      "target_text": "Sự kiện đang diễn ra!\r\nCó phần thưởng tham gia không nhỉ?\r\nDù sao thì mau đi thôi!",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:9eaa7b213d4de1fe30e3b27d",
      "kind": "character_system_text",
      "source_text": "可恶──！",
      "source_fingerprint": "c036f562c6a75a4e27815cd5424c55f5a4bd1b97d2360e4bee2da178142a3654",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1002"
      ],
      "target_text": "Đáng ghét──!",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:a484c85cf0c26b328dd7d9e9",
      "kind": "character_system_text",
      "source_text": "名册等级提升咯！\r\n……能获得什么奖赏吗？",
      "source_fingerprint": "2bf3edf5bca798eeb354b44bdd0bd27c90087484da2d164941b2865693a5eaec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10021"
      ],
      "target_text": "Cấp độ Danh mục tăng rồi đó!\r\n……Có nhận được phần thưởng gì không nhỉ?",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:99d537fa6ce69c25d8015bfe",
      "kind": "character_system_text",
      "source_text": "この服、バーゲンで掴み取りして\r\nきたにしては似合っとるやろ？\r\nちょお…っと大きいけどな…。",
      "source_fingerprint": "4cd56e02f6cb0063690298881de00e1d03639494e323cfd41699692b97d1922f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10025"
      ],
      "target_text": "Bộ đồ này, tôi chộp được trong đợt sale,\r\nnhưng mặc cũng hợp đấy chứ hả?\r\nCó điều... hơi rộng một chút...",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:4ecb5a94d09f90502841118e",
      "kind": "character_system_text",
      "source_text": "このシャツこないだオグリに\r\n貸したらサイズぴったしでな…\r\nわかっとったけど複雑やわ…。",
      "source_fingerprint": "ddd74ba40a710a8553645a6f5ba94364b18aa7280b5f8d816ddff7e3ee025722",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10026"
      ],
      "target_text": "Cái áo này lần trước tôi cho\r\nOguri mượn thì vừa in luôn...\r\nBiết trước là vậy rồi nhưng vẫn thấy phức tạp ghê...",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:8fba1b50788f8b20ab5dff78",
      "kind": "character_system_text",
      "source_text": "ウチの服はその内おさがりで\r\nチビたちも着ることになるからな～\r\n手入れは結構ちゃんとしてんで？",
      "source_fingerprint": "94c58e9def8514cc505a50f143e8c1c92d96ff06e2d4d5af2b2fb2061e6df04d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "10027"
      ],
      "target_text": "Đồ của tôi rồi cũng sẽ thành đồ cũ\r\ncho mấy đứa nhóc mặc lại thôi~\r\nNên tôi chăm sóc chúng khá kỹ đấy nhé?",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:d5ab09f0a84ee2813e1f77d3",
      "kind": "character_system_text",
      "source_text": "……没办法了！",
      "source_fingerprint": "1ae7c54881857d6af64c643a7dfabec4bf50cd136d1ed9c3eda1b346f9a4b877",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1003"
      ],
      "target_text": "……Đành chịu thôi!",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:f0b6eedda81e7abd0ffd0506",
      "kind": "character_system_text",
      "source_text": "就是这样！",
      "source_fingerprint": "b4ce2395974d719b54cc132431ee24078429bcd3c5a32898da3fedb4f43d3754",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1004"
      ],
      "target_text": "Đúng là như vậy!",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:df6b52d628e926fb208352ee",
      "kind": "character_system_text",
      "source_text": "可恶──！",
      "source_fingerprint": "c036f562c6a75a4e27815cd5424c55f5a4bd1b97d2360e4bee2da178142a3654",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1005"
      ],
      "target_text": "Đáng ghét──!",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:72ac3b743cebb0883009c14b",
      "kind": "character_system_text",
      "source_text": "……没办法了！",
      "source_fingerprint": "1ae7c54881857d6af64c643a7dfabec4bf50cd136d1ed9c3eda1b346f9a4b877",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1006"
      ],
      "target_text": "……Đành chịu thôi!",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:cb8f70b4bce05ffd62faa872",
      "kind": "character_system_text",
      "source_text": "新纪录喔！",
      "source_fingerprint": "1736ca184a4fe051e1906f243735864a2169ff0ec9da0f09b3039750af7eebcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1007"
      ],
      "target_text": "Kỷ lục mới đó!",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:fa76d73662c0473cbe357760",
      "kind": "character_system_text",
      "source_text": "你要好好跟上脚步喔！",
      "source_fingerprint": "2a91b6ed3dd0f6198d27ef1da9af2e250176e5d1c67a91e3267155ea947b266e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1008"
      ],
      "target_text": "Cậu phải theo kịp bước chân đấy nhé!",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:bc0dcf87cb316d02f39de24c",
      "kind": "character_system_text",
      "source_text": "喔，包在我身上！",
      "source_fingerprint": "0fd319fb73006ca16c9a4b229799153ac2dcd02c0b539832d26c27fd020d5ba9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "1020"
      ],
      "target_text": "Ồ, cứ để đó cho tôi!",
      "reviewed": true
    }
  ]
}
