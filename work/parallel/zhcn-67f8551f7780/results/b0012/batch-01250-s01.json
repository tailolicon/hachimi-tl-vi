  "entries": [
    {"entry_index":20,"uid":"zhcn:1bab9a82df8039680fb422a1","kind":"character_system_text","source_text":"看到了吧！这就是大阪人的意志力！","source_fingerprint":"26c205c51abc6a9041a7224b86e54ee4d00ca6d4b470a9f9a7eb50433cc2f8e5","source_path":"character_system_text_dict.json","json_path":["1021","30004"],"target_text":"Thấy chưa! Đây chính là ý chí của người Osaka!","reviewed":true},
    {"entry_index":21,"uid":"zhcn:dfc3eddd592d6f8dc676a9bd","kind":"character_system_text","source_text":"如何！见识到我的意志力了吧！","source_fingerprint":"ebfb658fa8e570e889817ede292744ed3e9e8ac08e0b337d21474248fdfea380","source_path":"character_system_text_dict.json","json_path":["1021","30005"],"target_text":"Thế nào! Thấy ý chí của tôi rồi chứ!","reviewed":true},
    {"entry_index":22,"uid":"zhcn:686b9b4d3a54cf13ba1b148e","kind":"character_system_text","source_text":"这就是响彻神话时代的闪电！","source_fingerprint":"d43e8371390a70ee67e9d2bf6fa94a2b7e1c080abde4fef811981a2a72911775","source_path":"character_system_text_dict.json","json_path":["1021","30006"],"target_text":"Đây chính là tia chớp vang dội từ thời thần thoại!","reviewed":true},
    {"entry_index":23,"uid":"zhcn:0eca3c7e30b9be80afed21f5","kind":"character_system_text","source_text":"如何！见识到我的意志力了吧！","source_fingerprint":"ebfb658fa8e570e889817ede292744ed3e9e8ac08e0b337d21474248fdfea380","source_path":"character_system_text_dict.json","json_path":["1021","30007"],"target_text":"Thế nào! Thấy ý chí của tôi rồi chứ!","reviewed":true},
    {"entry_index":24,"uid":"zhcn:263f1cb373ddb39eddad4bc5","kind":"character_system_text","source_text":"好，走吧！","source_fingerprint":"a1847dedf2949edc2fec2f68a27f5af020238b67e321cd8178d1f99182cf5bd9","source_path":"character_system_text_dict.json","json_path":["1021","31000"],"target_text":"Được, đi thôi!","reviewed":true},
    {"entry_index":25,"uid":"zhcn:d3d288e41845f6fbd403a226","kind":"character_system_text","source_text":"这就叫疾风迅雷啊……！！","source_fingerprint":"ac866f845714949655eeaf15ef7b52ac1625d43b63bceff85cc89b63b970bc39","source_path":"character_system_text_dict.json","json_path":["1021","40000"],"target_text":"Đây mới gọi là nhanh như gió, dữ như sấm……!!","reviewed":true},
    {"entry_index":26,"uid":"zhcn:b176c550fe4de9a453e2be7e","kind":"character_system_text","source_text":"我要当「神马」啊～\r\n老妈听了应该会吓一大跳吧～\r\n……得在家人面前好好表现才行！","source_fingerprint":"518cd21c19cb4c28ebb398e5b44238be836b20eb399dd2f80d1e014f308ab6a5","source_path":"character_system_text_dict.json","json_path":["1021","400000"],"target_text":"Tôi sẽ trở thành 「Thần Mã」 đó～\r\nMẹ mà nghe chắc sẽ giật mình lắm～\r\n…Phải thể hiện thật tốt trước gia đình mới được!","reviewed":true},
    {"entry_index":27,"uid":"zhcn:364b5e8db5c6f7a0b1e93e9e","kind":"character_system_text","source_text":"真是个麻烦的家伙～\r\n好吧，我就一起照顾吧！","source_fingerprint":"a277f067731f29b7cdb33a5eb6b7e17c18f289b22233e4a7da0637d4e5fda705","source_path":"character_system_text_dict.json","json_path":["1021","400004"],"target_text":"Đúng là một đứa phiền phức～\r\nThôi được, tôi chăm luôn vậy!","reviewed":true},
    {"entry_index":28,"uid":"zhcn:572e3fac6052d1f84ea0dd8e","kind":"character_system_text","source_text":"等着瞧！\r\n我们绝对会跑出一场专属于我们、\r\n最棒的「神马驱」……！","source_fingerprint":"e2838d6fdaec1ed9fc7d521239849a4538ac7bfdc9ec134a70ef834abdf46b0b","source_path":"character_system_text_dict.json","json_path":["1021","400006"],"target_text":"Cứ chờ mà xem!\r\nChúng ta nhất định sẽ chạy nên một màn chỉ thuộc về mình,\r\nmột 「Thần Mã Khu」 tuyệt nhất……!","reviewed":true},
    {"entry_index":29,"uid":"zhcn:c343174da673efc2e3e5a83b","kind":"character_system_text","source_text":"有机会的话，下次叫稻荷举办一场\r\n荞麦面派对吧。至于汤底……\r\n东西边两种口味都准备就好啦！","source_fingerprint":"91861175882dfef92573830853c81c6a9c18e80485273e60a97622a7c5a84b0d","source_path":"character_system_text_dict.json","json_path":["1021","400009"],"target_text":"Có dịp thì lần tới nhờ Inari One tổ chức\r\nmột bữa tiệc soba nhé. Còn nước dùng……\r\nchuẩn bị cả vị miền Đông lẫn miền Tây là được!","reviewed":true}
  ]
}
