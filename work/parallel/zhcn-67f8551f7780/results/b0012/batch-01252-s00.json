  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 0,
  "shard_end_exclusive": 20,
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:5e38e72fd13f4e470b84ad6c",
      "kind": "character_system_text",
      "source_text": "太好了呢♪",
      "source_fingerprint": "5dc4a4a75c655e69f5aa9602de71b3b3b441439d2887a36bbc821e42c3c4f4c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "1001"
      ],
      "target_text": "Tuyệt quá nhỉ♪",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:9d365251d62b5bcae0917837",
      "kind": "character_system_text",
      "source_text": "除夕夜的时候，\n要把榭寄生的叶子放在枕头下面呢。\n训练员，我分你一片叶子哦！",
      "source_fingerprint": "d7b6d0f8c740d356f4d4e8fc3c950237b34d207e982c3af90cf1d7696bdfe725",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10010"
      ],
      "target_text": "Đêm Giao thừa,\nngười ta đặt lá tầm gửi dưới gối đấy.\nTrainer, tặng bạn một chiếc lá nhé!",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:a55f24530c49a0f0cb73b514",
      "kind": "character_system_text",
      "source_text": "生日快乐哦♪\n虽然只是微不足道的祝福…\n不过，还请尽情期待礼物哦。",
      "source_fingerprint": "ed2d3a60ae8fafe312a835aad17143c8f1970c1c073b5463d03ef9668dfd193b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10011"
      ],
      "target_text": "Chúc mừng sinh nhật nhé♪\nChỉ là một lời chúc nho nhỏ thôi…\nNhưng quà thì cứ tha hồ mong chờ nhé.",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:3204b1e7023570b4295b1d3b",
      "kind": "character_system_text",
      "source_text": "你看见请柬了吗？\n是我为你举办的生日派对哦～\n今天就由我来”护送“你吧♪",
      "source_fingerprint": "e71b09073108c64f18ea83a2c40a2a8be1cb36cd39b114925ec7ba30b15d77d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10012"
      ],
      "target_text": "Bạn thấy thiệp mời chưa?\nĐó là tiệc sinh nhật tôi tổ chức cho bạn đấy～\nHôm nay cứ để tôi “hộ tống” bạn nhé♪",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:30b6f4bdd3d26396300ef122",
      "kind": "character_system_text",
      "source_text": "宿舍里寄来了各国的生日礼物，\n实在是太多了……\n同学们都惊呼着『发生了什么！』了呢！",
      "source_fingerprint": "65312b5565a4c7b18b2d0023727a471a92c815a1b7b900701e886777f4096cff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10013"
      ],
      "target_text": "Quà sinh nhật từ khắp các nước gửi tới ký túc xá,\nnhiều đến choáng ngợp luôn……\nCác bạn cùng lớp ai cũng thốt lên 『Chuyện gì thế này!』 đấy!",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:92c5b1db0145c07e42347540",
      "kind": "character_system_text",
      "source_text": "今天想和你一起拍张照呢♪\n第一次在异国他乡过生日的模样，\n想让城堡的大家也看看呢！",
      "source_fingerprint": "9f644f41aa2d53f4578d5858c53de1eb85eb5ee723e2bcb5383afaddc828cab4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10014"
      ],
      "target_text": "Hôm nay tôi muốn chụp một tấm ảnh với bạn♪\nĐây là lần đầu tôi đón sinh nhật nơi đất khách,\ntôi muốn mọi người ở lâu đài cũng được thấy!",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:601b4f240f3cd0bb0cf48b32",
      "kind": "character_system_text",
      "source_text": "哎呀，好像有什么新通知呢！\n可别忘记去看看哦。",
      "source_fingerprint": "0a14d8a603eba445e28c443114af36d1ddcd5bf2e75656bb5d4db6bfcca2a535",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10015"
      ],
      "target_text": "Ôi, hình như có thông báo mới đấy!\nĐừng quên vào xem nhé.",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:08f1365049743b6c81b88394",
      "kind": "character_system_text",
      "source_text": "好像有什么礼物送到了呢♪\n会是什么呢？好期待～！",
      "source_fingerprint": "4f10ba2068d2c233b1368682a6f3d1d05c08935b422db75539f69ee0ff7720da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10016"
      ],
      "target_text": "Hình như có quà được gửi tới rồi♪\nKhông biết là gì nhỉ? Mong quá～!",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:4c7a3923e91e55d903542e64",
      "kind": "character_system_text",
      "source_text": "成功完成任务了呢！\n赐你些奖励吧～♪…开玩笑的！",
      "source_fingerprint": "b1ab8629737c40b31be06035b6ec34023700f6dd8399e50941d4e5a5e04592be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10017"
      ],
      "target_text": "Hoàn thành nhiệm vụ rồi nhỉ!\nĐể ta ban cho bạn chút phần thưởng nhé～♪…Đùa thôi!",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:ba5d8bbca08da612880b9028",
      "kind": "character_system_text",
      "source_text": "活动好像要开始了呢♪\n大家都玩得很开心的样子，\n我也得提前安排下时间呢。",
      "source_fingerprint": "9711a30d516ef9ae97f9cffcf07be817dea76dd09c3a56f40e736444bf72416f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10018"
      ],
      "target_text": "Hình như sự kiện sắp bắt đầu rồi♪\nTrông mọi người vui lắm,\ntôi cũng phải thu xếp lịch trước mới được.",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:1ef5c987b82206e6c2e8aac4",
      "kind": "character_system_text",
      "source_text": "活动好像正在进行中～♪\n尽情玩乐之后，\n就要安排慰劳的茶话会了呢！",
      "source_fingerprint": "a5e670c569ff9e9c937cfffe9fee1a498adc8b1adbf0272086599d00682671b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10019"
      ],
      "target_text": "Hình như sự kiện đang diễn ra rồi～♪\nSau khi vui chơi hết mình,\nthì phải thu xếp một buổi tiệc trà để mọi người thư giãn chứ!",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:119fa5a023778df4d1c560c8",
      "kind": "character_system_text",
      "source_text": "唔唔……下次一定……！",
      "source_fingerprint": "9e4ce700934a9c8bc57ee134bf2f5501aef38bf50990d8f64a776c16bcc56349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "1002"
      ],
      "target_text": "Ưư…… Lần sau nhất định……!",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:ed5f8394cfaa21624b650da2",
      "kind": "character_system_text",
      "source_text": "哇啊，赛马娘名鉴的等级，\n好像上升了哦～♪",
      "source_fingerprint": "9d527fe256912a83cf44c4fba3cf7225a96ff373c03b0e2e6bf7d965c009799a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10021"
      ],
      "target_text": "Oa, hình như Archive của Mã Nương\nvừa tăng cấp rồi đấy～♪",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:54fe521ffa8a83a55a860604",
      "kind": "character_system_text",
      "source_text": "どのような場に招かれても、\r\nすぐ行ける格好でいたいの！\r\nパーティー、森…どこへでも♪",
      "source_fingerprint": "5605be129dbf3514e84b6e52d1c6f175ae92e843261eac15237944f4d556f0a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10025"
      ],
      "target_text": "Dù được mời tới đâu,\r\ntôi cũng muốn ăn mặc sao cho có thể đi ngay!\r\nDự tiệc, vào rừng… đâu cũng được♪",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:13656fcc5115cc239e89b90c",
      "kind": "character_system_text",
      "source_text": "初めてラーメンを食べた日、\r\nシャツに汁を飛ばしちゃって…\r\n染み抜きというものを覚えました！",
      "source_fingerprint": "002f2de01f39486847af069ce8fe7990756fbc065cfd72de88800eb2459c516a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10026"
      ],
      "target_text": "Lần đầu ăn ramen,\r\ntôi lỡ làm nước dùng bắn lên áo…\r\nthế là học được cách tẩy vết bẩn luôn!",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:681d5e0611785ad50dcaf072",
      "kind": "character_system_text",
      "source_text": "歴史のあるお洋服って素敵。\r\nこのスカートもおばあさまから\r\n受け継いで、大切に着ているの！",
      "source_fingerprint": "f6f58ae6b1a83febc89d05b7bc6d7e5170bf547a17f369ac47784220dcd95e39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "10027"
      ],
      "target_text": "Những bộ đồ mang theo cả một lịch sử thật tuyệt.\r\nChiếc váy này cũng là món tôi được bà truyền lại,\r\nnên tôi luôn nâng niu mỗi khi mặc!",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:1ead00fc660cd992217c3e28",
      "kind": "character_system_text",
      "source_text": "平局啊～",
      "source_fingerprint": "e21fcbff8101495aa54703ed1c70d1d9824b5d78da15a94bd0ff6b396486ca62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "1003"
      ],
      "target_text": "Hòa rồi～",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:5eb5c0992a4d59e3e57a56a0",
      "kind": "character_system_text",
      "source_text": "光荣的胜利…！",
      "source_fingerprint": "32088f0081251c4c948ed6d2d4e0f7f3db7fbb6ad606f4882fd3a4bf29c08d60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "1004"
      ],
      "target_text": "Chiến thắng vẻ vang…!",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:d94b0d2542b75c40542438b1",
      "kind": "character_system_text",
      "source_text": "唔唔……下次一定……！",
      "source_fingerprint": "9e4ce700934a9c8bc57ee134bf2f5501aef38bf50990d8f64a776c16bcc56349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "1005"
      ],
      "target_text": "Ưư…… Lần sau nhất định……!",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:253b775e5b371c4cefcb5798",
      "kind": "character_system_text",
      "source_text": "平局啊～",
      "source_fingerprint": "e21fcbff8101495aa54703ed1c70d1d9824b5d78da15a94bd0ff6b396486ca62",
      "source_path": "character_system_text_dict.json",
