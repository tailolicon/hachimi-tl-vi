  "batch": 1252,
  "shard": 3,
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 60,
  "shard_end_exclusive": 80,
  "translated_count": 10,
  "entries": [
    {
      "uid": "zhcn:74c40a2a64ebe73fa55f23e0",
      "kind": "character_system_text",
      "source_text": "鞋子的保养也非常棒♪\n呵呵，就算是小矮妖看见了，\n也会吓一大跳吧。",
      "source_fingerprint": "6113aa5df4b23e3d24ad0531378c9304a866ac22e1a3a68bd9a92837d3743320",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20005"
      ],
      "entry_index": 60,
      "target_text": "Giày cũng được chăm sóc rất kỹ nữa♪\nHihi, chắc ngay cả yêu tinh tí hon nhìn thấy\ncũng phải giật mình ấy nhỉ.",
      "reviewed": true
    },
    {
      "uid": "zhcn:12daa52ecbf183d1514f61a2",
      "kind": "character_system_text",
      "source_text": "今天也请您多加指导♪\n那么…！开始训练吧！",
      "source_fingerprint": "fcd1e96cb4cc9e5af4dcca04334082787449a0bb0eb7b08ddcb8b5a55c5025ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20006"
      ],
      "entry_index": 61,
      "target_text": "Hôm nay cũng mong bạn chỉ dẫn nhé♪\nVậy thì…! Bắt đầu huấn luyện thôi!",
      "reviewed": true
    },
    {
      "uid": "zhcn:cc58fef14ecb014c4c1909fb",
      "kind": "character_system_text",
      "source_text": "贵安。\n今天安排了怎样的训练呢？\n不管怎样的训练都可以的哦♪",
      "source_fingerprint": "f603c7ce01e1940808868e6b88b92dabe510d378619bae762f0ca6d0c171e916",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20007"
      ],
      "entry_index": 62,
      "target_text": "Xin chào.\nHôm nay bạn đã lên kế hoạch huấn luyện thế nào?\nBài nào tôi cũng sẵn sàng nhé♪",
      "reviewed": true
    },
    {
      "uid": "zhcn:3933d14fc4a0330a1ef93688",
      "kind": "character_system_text",
      "source_text": "嗯～…为了转换心情，\n去找找看四叶草吧？",
      "source_fingerprint": "e271c03ee0fc20982c5069706179c5ff470d4a577cb31ab4b283e3cbe9b4a6b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20008"
      ],
      "entry_index": 63,
      "target_text": "Ừm～… Để đổi gió một chút,\nđi tìm cỏ bốn lá nhé?",
      "reviewed": true
    },
    {
      "uid": "zhcn:ea10085286b489810ca58d56",
      "kind": "character_system_text",
      "source_text": "嗯…不打起精神来的话…\n好不容易才得到父亲的许可，\n可不能放弃…！",
      "source_fingerprint": "b7873b28eed510024180a186919b3d686d199b9aec707f5366a60f10cd2b8aa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20009"
      ],
      "entry_index": 64,
      "target_text": "Ừm… phải phấn chấn lên thôi…\nKhó khăn lắm tôi mới được cha cho phép,\nkhông thể bỏ cuộc được…!",
      "reviewed": true
    },
    {
      "uid": "zhcn:838ba69bb2247153878a3fd9",
      "kind": "character_system_text",
      "source_text": "哈啊…啊，抱歉。\n开始训练了吗？",
      "source_fingerprint": "63da923cac113f333dd94ba94ed9bf6cfff6d5fe2303b54ff2e076140815fcf7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20010"
      ],
      "entry_index": 65,
      "target_text": "Haa… à, xin lỗi.\nBắt đầu huấn luyện rồi sao?",
      "reviewed": true
    },
    {
      "uid": "zhcn:71e40510952b28440eeb41f8",
      "kind": "character_system_text",
      "source_text": "说实话，情况不容乐观…\n但我已经下定决心了。\n一定要在我该走的道路上前行…！",
      "source_fingerprint": "cd6fd27c6f48c1e6ef7db1f8f4e4595f30bd0bd2b9bbe9664d2f898dc5b7fce2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20011"
      ],
      "entry_index": 66,
      "target_text": "Nói thật, tình hình không mấy khả quan…\nNhưng tôi đã quyết rồi.\nTôi nhất định sẽ bước tiếp trên con đường mình phải đi…!",
      "reviewed": true
    },
    {
      "uid": "zhcn:e30397f1358bc8fe2c1e8c10",
      "kind": "character_system_text",
      "source_text": "啊啦，还要继续参加比赛吗。\n我会继续尽全力做到最好的。",
      "source_fingerprint": "c2ade76794e4ef8364966e9dd1928179dc176607ae62eaa1ca3c669e93dcfb71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20021"
      ],
      "entry_index": 67,
      "target_text": "Ôi, vẫn tiếp tục tham gia Cuộc đua sao.\nTôi sẽ tiếp tục dốc hết sức mình.",
      "reviewed": true
    },
    {
      "uid": "zhcn:8c6af9a4d29e0f5d1b202eae",
      "kind": "character_system_text",
      "source_text": "偶尔也该自爱一点哦？\n如果错失时机，\n能赢的比赛也会赢不了的。",
      "source_fingerprint": "e36aa36518b9e035d40d2eb10e5b28ca245420d5975c2dbf5c3819f25eaaef7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20022"
      ],
      "entry_index": 68,
      "target_text": "Đôi lúc cũng phải biết giữ gìn bản thân chứ?\nNếu không chọn đúng thời điểm,\nđến Cuộc đua lẽ ra thắng được cũng có thể thua đấy.",
      "reviewed": true
    },
    {
      "uid": "zhcn:afe1169cfb7d732103ad0357",
      "kind": "character_system_text",
      "source_text": "哼哼～♪今天早上，\n城堡的大家发来了为我打气的短信哦！\n好～要加油咯～！",
      "source_fingerprint": "6c46c90cffb7ef85a5e0c133e6e62e546156b6f0fe6deb32a25ddaa4cb04cfcc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20023"
      ],
      "entry_index": 69,
      "target_text": "Hừm hừm～♪ Sáng nay,\nmọi người ở lâu đài đã nhắn tin cổ vũ tôi đấy!\nĐược～ phải cố lên thôi～!",
      "reviewed": true
    }
  ]
}
