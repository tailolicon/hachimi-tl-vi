  "entries": [
    {
      "uid": "zhcn:74c40a2a64ebe73fa55f23e0",
      "kind": "character_system_text",
      "source_text": "鞋子的保养也非常棒♪\n呵呵，就算是小矮妖看见了，\n也会吓一大跳吧。",
      "source_fingerprint": "6113aa5df4b23e3d24ad0531378c9304a866ac22e1a3a68bd9a92837d3743320",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20005"
      ],
      "entry_index": 60,
      "target_text": "Giày cũng được chăm sóc rất kỹ nữa♪\nHihi, chắc ngay cả yêu tinh tí hon nhìn thấy\ncũng phải giật mình ấy nhỉ.",
      "reviewed": true
    },
    {
      "uid": "zhcn:12daa52ecbf183d1514f61a2",
      "kind": "character_system_text",
      "source_text": "今天也请您多加指导♪\n那么…！开始训练吧！",
      "source_fingerprint": "fcd1e96cb4cc9e5af4dcca04334082787449a0bb0eb7b08ddcb8b5a55c5025ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20006"
      ],
      "entry_index": 61,
      "target_text": "Hôm nay cũng mong bạn chỉ dẫn nhé♪\nVậy thì…! Bắt đầu huấn luyện thôi!",
      "reviewed": true
    },
    {
      "uid": "zhcn:cc58fef14ecb014c4c1909fb",
      "kind": "character_system_text",
      "source_text": "贵安。\n今天安排了怎样的训练呢？\n不管怎样的训练都可以的哦♪",
      "source_fingerprint": "f603c7ce01e1940808868e6b88b92dabe510d378619bae762f0ca6d0c171e916",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20007"
      ],
      "entry_index": 62,
      "target_text": "Xin chào.\nHôm nay bạn đã lên kế hoạch huấn luyện thế nào?\nBài nào tôi cũng sẵn sàng nhé♪",
      "reviewed": true
    },
    {
      "uid": "zhcn:3933d14fc4a0330a1ef93688",
      "kind": "character_system_text",
      "source_text": "嗯～…为了转换心情，\n去找找看四叶草吧？",
      "source_fingerprint": "e271c03ee0fc20982c5069706179c5ff470d4a577cb31ab4b283e3cbe9b4a6b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20008"
      ],
      "entry_index": 63,
      "target_text": "Ừm～… Để đổi gió một chút,\nđi tìm cỏ bốn lá nhé?",
      "reviewed": true
    },
    {
      "uid": "zhcn:ea10085286b489810ca58d56",
      "kind": "character_system_text",
      "source_text": "嗯…不打起精神来的话…\n好不容易才得到父亲的许可，\n可不能放弃…！",
      "source_fingerprint": "b7873b28eed510024180a186919b3d686d199b9aec707f5366a60f10cd2b8aa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20009"
      ],
      "entry_index": 64,
      "target_text": "Ừm… phải phấn chấn lên thôi…\nKhó khăn lắm tôi mới được cha cho phép,\nkhông thể bỏ cuộc được…!",
      "reviewed": true
    }
  ]
}
