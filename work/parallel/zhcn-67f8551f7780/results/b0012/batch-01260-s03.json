    {"entry_index":61,"uid":"zhcn:af329144aabdcdb1a121faab","kind":"character_system_text","source_text":"哼哼──！有王牌飞行员的感觉吧♪","source_fingerprint":"373ff0572b5d6db49f6d9875fb0470d940b97a44e043168669dc174d85e884d0","source_path":"character_system_text_dict.json","json_path":["1024","70009"],"target_text":"Hừm hừm──! Trông ra dáng phi công át chủ bài rồi chứ♪","reviewed":true},
