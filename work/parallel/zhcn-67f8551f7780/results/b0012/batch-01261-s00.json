    {"entry_index":0,"uid":"zhcn:aa6671c0ea9526b80bc2c5b5","kind":"character_system_text","source_text":"就拜托你当Maya的护花使者咯☆","source_fingerprint":"42ded053a8bfe6dccf05367f140bca603cefcecaf693afb2a36c686dbaadc1aa","source_path":"character_system_text_dict.json","json_path":["1024","71017"],"target_text":"Vậy nhờ cậu làm hiệp sĩ bảo vệ Maya nhé☆","reviewed":true},
    {"entry_index":1,"uid":"zhcn:50025bc1bd8139ee981e2f5d","kind":"character_system_text","source_text":"Take Off☆","source_fingerprint":"5790d5f60134ce63e6054514795a91b5b0686804c7b170c1a8a54e1c6a787cd1","source_path":"character_system_text_dict.json","json_path":["1024","71018"],"target_text":"Take Off☆","reviewed":true},
    {"entry_index":2,"uid":"zhcn:47b876757a6b9eeef1e9a900","kind":"character_system_text","source_text":"全──部都会被我搞清楚的！","source_fingerprint":"64009ddf13403fd031399f8bb6e96a5a1f830cb8dfd94fc05ff3f0857e76da86","source_path":"character_system_text_dict.json","json_path":["1024","71019"],"target_text":"Maya sẽ tìm hiểu hết── tất cả!","reviewed":true},
    {"entry_index":3,"uid":"zhcn:ea57ff88c369d93a32815e11","kind":"character_system_text","source_text":"用魔法快速换装~♪","source_fingerprint":"8a58ebb44c5a180ecca299dfe78fd165134b1fc6499601f668dc874bcda5d011","source_path":"character_system_text_dict.json","json_path":["1024","71216"],"target_text":"Thay đồ thật nhanh bằng phép thuật~♪","reviewed":true},
    {"entry_index":4,"uid":"zhcn:e415b50710826653b7fea58e","kind":"character_system_text","source_text":"摸摸我的耳朵也没关系哦！","source_fingerprint":"b2289091fa6a17bb32c0db86f260c0232031969f357ce834402844e5b35efb0d","source_path":"character_system_text_dict.json","json_path":["1024","71217"],"target_text":"Sờ tai Maya một chút cũng được nhé!","reviewed":true},
    {"entry_index":5,"uid":"zhcn:b82a5301296db4201f89f583","kind":"character_system_text","source_text":"辛苦了！","source_fingerprint":"20df094ff1112517c623c111a7239f2b6398134743fb570a85aa6a2f9f1f8889","source_path":"character_system_text_dict.json","json_path":["1024","80000"],"target_text":"Vất vả rồi!","reviewed":true},
    {"entry_index":6,"uid":"zhcn:365ea1325f4619086b780747","kind":"character_system_text","source_text":"可不要小看Maya哦☆","source_fingerprint":"35fe5e1a2c96fc5dbd51a8bf93de6ab7a7b478e7f3d349ff1869812d253fba1f","source_path":"character_system_text_dict.json","json_path":["1024","81000"],"target_text":"Đừng xem thường Maya nhé☆","reviewed":true},
    {"entry_index":7,"uid":"zhcn:54cee745de3a8a2cb376ba51","kind":"character_system_text","source_text":"哼哼──♪\r\n接下来才要定胜负呢☆","source_fingerprint":"dbc9bcd4076a2d78dbaa280ab518558367fe16d3b8bb69dd10f5ecb274f5b52f","source_path":"character_system_text_dict.json","json_path":["1024","81001"],"target_text":"Hừm hừm──♪\r\nTừ giờ mới là lúc phân thắng bại nhé☆","reviewed":true},
    {"entry_index":8,"uid":"zhcn:e75628308459934fd8fecf6d","kind":"character_system_text","source_text":"早安──！\r\n今天Maya也要充满活力地Take Off！","source_fingerprint":"06aa9ed4fe305c42d76b2d96b490f98fa3ab4e11787ee50aaf8841b281adac07","source_path":"character_system_text_dict.json","json_path":["1024","90000"],"target_text":"Chào buổi sáng──!\r\nHôm nay Maya cũng sẽ tràn đầy năng lượng mà Take Off!","reviewed":true},
    {"entry_index":9,"uid":"zhcn:a249ad3b34dad767fb7764ff","kind":"character_system_text","source_text":"训练员，早安！\r\n你该不会是～正在找Maya吧？\r\n诶嘿嘿，我在这里啦～♪","source_fingerprint":"ebe016e6a62c0844848ddbcd4b70b8bd18f8ed50a91e5734672815fcfdde27b8","source_path":"character_system_text_dict.json","json_path":["1024","90001"],"target_text":"Trainer, chào buổi sáng!\r\nChẳng lẽ cậu đang～ tìm Maya sao?\r\nEhehe, Maya ở đây nè～♪","reviewed":true},
    {"entry_index":10,"uid":"zhcn:ad2dbcadf9dec36f828084b1","kind":"character_system_text","source_text":"训练员～！\r\n我们今天要做什么训练啊？\r\n我随时都能紧急起飞哦！","source_fingerprint":"37d0fcec22a25d961ac69be4a038aab7ff106e581d6c7a1f5ba1d7c1a87305ec","source_path":"character_system_text_dict.json","json_path":["1024","90002"],"target_text":"Trainer～!\r\nHôm nay mình sẽ tập gì vậy?\r\nMaya lúc nào cũng sẵn sàng cất cánh khẩn cấp nhé!","reviewed":true},
    {"entry_index":11,"uid":"zhcn:dd025ee04a9e588ec4f4be61","kind":"character_system_text","source_text":"走吧，训练员！\r\n今天也要Take Off去寻找令人期待、\r\n闪闪发亮的事情哦！","source_fingerprint":"dd85db3c300b706d21409af0434a2236b8df6b2cf3682d88b752a8d827c7c28b","source_path":"character_system_text_dict.json","json_path":["1024","90003"],"target_text":"Đi thôi, Trainer!\r\nHôm nay cũng Take Off đi tìm những điều\r\nđáng mong chờ và lấp lánh nhé!","reviewed":true},
    {"entry_index":12,"uid":"zhcn:03dd00d7fe7805e8965430bc","kind":"character_system_text","source_text":"你──好──☆\r\n晚上会让人感觉心跳加快呢！\r\n因为是属于大人的时间吗？","source_fingerprint":"b0207b55401cf1fc32afb6f4fed129c5cc7132fa61f2180d274e048a1083c664","source_path":"character_system_text_dict.json","json_path":["1024","90004"],"target_text":"Xin──chào──☆\r\nBuổi tối làm tim đập nhanh hơn nhỉ!\r\nVì đây là thời gian của người lớn sao?","reviewed":true},
    {"entry_index":13,"uid":"zhcn:920eecf0db2456c364121350","kind":"character_system_text","source_text":"呼啊……训练员……\r\n忙到这么晚真是辛苦了～\r\nMaya啊……好像已经想睡觉了……","source_fingerprint":"ba103a18529fef1438bc42eef0a7429150a3f098b6d45a4115d05bc5bacb94ce","source_path":"character_system_text_dict.json","json_path":["1024","90005"],"target_text":"Huaa…… Trainer……\r\nBận đến tận giờ này, vất vả rồi～\r\nMaya thì…… hình như buồn ngủ mất rồi……","reviewed":true},
    {"entry_index":14,"uid":"zhcn:d84bf4fd14faa4cf7ef5f496","kind":"character_system_text","source_text":"春天的约会就决定是散步了！\r\n一定会充满期待，非常开心的！\r\n我们要一起去很多地方哦☆","source_fingerprint":"282dea96e2e45c827668c23d0eed01fa491799338e807f2de17c838069bad207","source_path":"character_system_text_dict.json","json_path":["1024","90006"],"target_text":"Hẹn hò mùa xuân thì quyết định đi dạo nhé!\r\nChắc chắn sẽ đầy háo hức và vui lắm!\r\nMình cùng đi thật nhiều nơi nhé☆","reviewed":true}
  ]
}
