      "uid": "zhcn:b0ed3ec9aa472c514ed25e3d",
      "kind": "character_system_text",
      "source_text": "就差一点了哇！",
      "source_fingerprint": "b7d9a44ba6e81b81f0204d148192b4585c8655060f6a69e27cfa958178bcf351",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "30001"
      ],
      "target_text": "Chỉ còn một chút nữa thôi!",
