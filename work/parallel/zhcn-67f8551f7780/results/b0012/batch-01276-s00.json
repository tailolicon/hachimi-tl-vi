    },
    {
      "entry_index": 3,
      "uid": "zhcn:6009e06f8ab4bda6cd896587",
      "kind": "character_system_text",
      "source_text": "真难啊……",
      "source_fingerprint": "4c4b01cf3cb63ae6f8b8835a4a1b13c867fe5ab983aef95445948a9970f70ff5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20042"
      ],
      "target_text": "Khó thật đấy……",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:92d78126791115653a020903",
      "kind": "character_system_text",
      "source_text": "诶呀呀～？",
      "source_fingerprint": "ea5df482e2adb74269cf2ed874906d166ee89adc688a9dd964505ad43f6cfb59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20043"
      ],
      "target_text": "Ơ kìa～?",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:d1c15d4457f1ada2a8838be4",
      "kind": "character_system_text",
      "source_text": "快来！快来～！",
      "source_fingerprint": "5edcea134cc7e1647122bc4037bcc072f2332f3066612aab51b4316213104982",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20046"
      ],
      "target_text": "Mau đến đây! Mau đến đây～!",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:517f32b74c1aea32591b9691",
      "kind": "character_system_text",
      "source_text": "到海边玩咯！",
      "source_fingerprint": "aa5d9ce544f38c4537638901ac99dfd55c3bc2ddb6497654fbb57b7c5a28352d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20047"
      ],
      "target_text": "Đi chơi biển thôi nào!",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:dc99a1b362b07ed7b9aa86f0",
      "kind": "character_system_text",
      "source_text": "我要和故乡的大家分享至今为止发生的所有事！",
      "source_fingerprint": "8fc5d07bd7d61119f4877ad654afbd6a66bacdf2a56fa8be568712692c235ea5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20049"
      ],
      "target_text": "Mình sẽ kể cho mọi người ở quê nghe hết mọi chuyện đã xảy ra từ trước đến giờ!",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:bf5f38886fcb6f553b9d6601",
      "kind": "character_system_text",
      "source_text": "非常非常感谢～！",
      "source_fingerprint": "fdb99dfb6144d56f293e8f6532fd5c1c5732ca2220417dcb9041c66844008913",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20050"
      ],
      "target_text": "Cảm ơn mọi người thật nhiều～!",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:db4a135c26e8471fda7a6662",
      "kind": "character_system_text",
      "source_text": "一起加油呗！",
      "source_fingerprint": "cfb383dd8d2174be0f3f26e6d18a611208df1ed59db6554af6c4d69d27e3168b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "20051"
      ],
      "target_text": "Cùng cố gắng nào!",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:8843b27e70c95930493940a7",
      "kind": "character_system_text",
      "source_text": "Fight、噢――的说～！",
      "source_fingerprint": "1e5ca511fdf897751c734aab69d8c4dccc930e6e7fab6e6ddae5b70ba63e8ba1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "2030"
      ],
      "target_text": "Fight, ồ――, đó nha～!",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:aa1496ad312cc187108af27e",
      "kind": "character_system_text",
      "source_text": "大家，一起上吧！",
      "source_fingerprint": "964aa8a5f85779fee82ac72fdc07e559295b2e293ca2b24f812e4fad0c408055",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "2031"
      ],
      "target_text": "Mọi người, cùng xông lên nào!",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:0032f6b91b7ce262e0471157",
      "kind": "character_system_text",
      "source_text": "真的非常非常感谢～！",
      "source_fingerprint": "5090fe93af7a57283c441fdc26b578dab097cc4447163168ce29dd3222dfd8e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "2032"
      ],
      "target_text": "Thật sự cảm ơn mọi người rất nhiều～!",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:b15a33bedb8108dc905599e9",
      "kind": "character_system_text",
      "source_text": "真是紧张啊～！\r\n但是，比起来紧张更觉得是兴奋……\r\n现在这种状态的话感觉能行！",
      "source_fingerprint": "1818279cb1ec40db35e264c59b11e60934182539f9c40c538140b6555ac0aef0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "2033"
      ],
      "target_text": "Thật là hồi hộp quá～!\r\nNhưng mà, so với hồi hộp thì cảm giác hào hứng còn nhiều hơn……\r\nVới trạng thái bây giờ thì cảm giác có thể làm được!",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:52c85c2c9b9833ead5746608",
      "kind": "character_system_text",
      "source_text": "盛冈的大家不知道会不会在看着呢？\r\n如果是今天的状态的话\r\n应该能展现出自己帅气的一面吧！",
      "source_fingerprint": "5c9a9fec2bae0e665966384b4fffe54ae8a8f0cf7b55b22990b86dac859954be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "2034"
      ],
      "target_text": "Không biết mọi người ở Morioka có đang xem không nhỉ?\r\nNếu là trạng thái hôm nay\r\nchắc mình sẽ thể hiện được vẻ ngầu của bản thân đấy!",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:fb97d48d2618196b91499fa7",
      "kind": "character_system_text",
      "source_text": "真的非常非常感谢～！",
      "source_fingerprint": "5090fe93af7a57283c441fdc26b578dab097cc4447163168ce29dd3222dfd8e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "2035"
      ],
      "target_text": "Thật sự cảm ơn mọi người rất nhiều～!",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:5491b740a496fc13a0ddf707",
      "kind": "character_system_text",
      "source_text": "行くでがんす！",
      "source_fingerprint": "f3ad50f555d6b9ec8fbcb1a7c25f7c444b1200cef10343df24156484f3133466",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1029",
        "23015"
      ],
      "target_text": "Đi thôi nào!",
