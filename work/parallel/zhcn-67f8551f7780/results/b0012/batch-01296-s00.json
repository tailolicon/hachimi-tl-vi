      ],
      "target_text": "Đây là thành quả mà chúng ta cùng nỗ lực đạt được đấy!!",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:a7769533a38b0a373147c84a",
      "kind": "character_system_text",
      "source_text": "训练员，真的很谢谢你！",
