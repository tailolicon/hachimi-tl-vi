      ],
      "target_text": "Đi thôi!",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:1614e21b851c2111fdfe8139",
      "kind": "character_system_text",
      "source_text": "是海啊──！",
      "source_fingerprint": "6dc4bc075480521095e50998f7b9926b2e626e42925427db8875813d2dc468a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
