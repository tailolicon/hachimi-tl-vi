      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:0e741bc97b11b774a8d7499d",
      "kind": "character_system_text",
      "source_text": "走吧！",
      "source_fingerprint": "92ae3e5dcae9a53056d19b3106de1996e8c400c410dfd1c96cb651012cfebc4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
