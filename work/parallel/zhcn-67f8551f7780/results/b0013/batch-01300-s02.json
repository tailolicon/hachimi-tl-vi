  "entries": [
    {"entry_index":40,"uid":"zhcn:c67560522a9353008310a861","kind":"character_system_text","source_text":"暗い場所で光るトリックについて？\r\nハ、教えるかよ。","source_fingerprint":"d1bd1710e6553701c2f364b3147920a01ff1a34365eafd8df383a1015f08043d","source_path":"character_system_text_dict.json","json_path":["1036","70017"],"target_text":"Mánh phát sáng trong bóng tối ấy hả?\r\nHừ, ai mà nói cho mày biết.","reviewed":true},
    {"entry_index":41,"uid":"zhcn:ff2789d63878864013d1989c","kind":"character_system_text","source_text":"不管穿着什么去比赛，\r\n推算的结果都不会改变的。","source_fingerprint":"c994871d7d9724ad761264176ab0e625e873bc06d9b2c7fa674c2a6a225a8273","source_path":"character_system_text_dict.json","json_path":["1036","70018"],"target_text":"Dù mặc gì để đi đua,\r\nkết quả tính toán cũng chẳng thay đổi đâu.","reviewed":true},
    {"entry_index":42,"uid":"zhcn:63921bb81335a6ec41858203","kind":"character_system_text","source_text":"……顺便收集一下衣服尺寸的数据好了。","source_fingerprint":"9676dbc19f680745ee84e46f680eef494d68091cda5ca84f13743537d2fcfef3","source_path":"character_system_text_dict.json","json_path":["1036","70019"],"target_text":"…Tiện thể thu thập luôn dữ liệu kích cỡ trang phục vậy.","reviewed":true},
    {"entry_index":43,"uid":"zhcn:7f2c38507935574dd816e883","kind":"character_system_text","source_text":"コメントは求めてませーん。","source_fingerprint":"46adb28a9ea70653031301533eaeac56d29c27ed071f5c82f6471e090bdb92d7","source_path":"character_system_text_dict.json","json_path":["1036","70020"],"target_text":"Tao có hỏi ý kiến đâu nhéー.","reviewed":true},
    {"entry_index":44,"uid":"zhcn:d2b8d295668d03832d34f6d3","kind":"character_system_text","source_text":"スニーカー、\r\n一生足りねェ…。","source_fingerprint":"3c0e3108dea787b18f0642a91834fefe08808af646a61db355f09db6a104576a","source_path":"character_system_text_dict.json","json_path":["1036","70021"],"target_text":"Sneaker ấy mà,\r\ncó bao nhiêu cũng chẳng đủ…","reviewed":true},
    {"entry_index":45,"uid":"zhcn:17d768d4179431493212de67","kind":"character_system_text","source_text":"嘛，算是蛮说得过去的设计？","source_fingerprint":"07be2e4813e5bb46857a9bfd9fec223205d1e0ac391ce3a9a8a16ab3ee12fa29","source_path":"character_system_text_dict.json","json_path":["1036","71004"],"target_text":"Ờ, thiết kế này cũng tạm ổn đấy chứ?","reviewed":true},
    {"entry_index":46,"uid":"zhcn:bccbe1e62bb121e941d175d0","kind":"character_system_text","source_text":"和这身衣服的风格唱反调的话才没效率吧？","source_fingerprint":"f730b6aa0a59e2e8ce6b19b3bf36f508889140066e061396b697438a4a49bcf2","source_path":"character_system_text_dict.json","json_path":["1036","71008"],"target_text":"Ăn mặc trái hẳn phong cách của bộ này mới là thiếu hiệu quả chứ?","reviewed":true},
    {"entry_index":47,"uid":"zhcn:f42a96aec0ef4339564170f1","kind":"character_system_text","source_text":"是很吸睛的设计对吧？","source_fingerprint":"cde0570d28d4159a8c7cd2647826122add4ea05e15ebe002d8d38c497bb78fae","source_path":"character_system_text_dict.json","json_path":["1036","71009"],"target_text":"Thiết kế khá bắt mắt, đúng không?","reviewed":true},
    {"entry_index":48,"uid":"zhcn:faa6ef86f08dbb24cc25a650","kind":"character_system_text","source_text":"合不合身？马马虎虎吧。","source_fingerprint":"51c2fc405d90d8c3d6264bc83dd2937ea80a084b92b66e0088b1db9c52cb7ad5","source_path":"character_system_text_dict.json","json_path":["1036","71010"],"target_text":"Có vừa không á? Tạm tạm thôi.","reviewed":true},
    {"entry_index":49,"uid":"zhcn:88f31ba577713e67aa9e50d2","kind":"character_system_text","source_text":"啥啊，Live的排练吗？","source_fingerprint":"edadd1f12e893e0d4acfa7043c469c59f098b3144a6cfab4ae50bf8fd8f9c3fd","source_path":"character_system_text_dict.json","json_path":["1036","71014"],"target_text":"Gì đấy, tập Live à?","reviewed":true},
    {"entry_index":50,"uid":"zhcn:01260157bed6dc861132ba92","kind":"character_system_text","source_text":"就让你看到和推算相符的结果吧。","source_fingerprint":"2d081bbdcb8a3cd86cad3a26662275e6b02be17294f14dfe43826f9d3c32bfd4","source_path":"character_system_text_dict.json","json_path":["1036","71015"],"target_text":"Để tao cho mày thấy kết quả đúng như tính toán.","reviewed":true},
    {"entry_index":51,"uid":"zhcn:d9aff9594692b823b5faf9ee","kind":"character_system_text","source_text":"デザインは精査してる。モチベが下がると\r\nパフォーマンスに影響すっからな。","source_fingerprint":"08a5ae6da31c17a6bb9b57ef998be2d0d53e0e030928561e37218d38acd743e0","source_path":"character_system_text_dict.json","json_path":["1036","71016"],"target_text":"Tao đã xem xét kỹ thiết kế rồi. Tụt hứng thì\r\nhiệu suất cũng bị ảnh hưởng mà.","reviewed":true},
    {"entry_index":52,"uid":"zhcn:3bfeec6ff6dd2d0bd0c24dd4","kind":"character_system_text","source_text":"暗い場所で光るトリックについて？\r\nハ、教えるかよ。","source_fingerprint":"d1bd1710e6553701c2f364b3147920a01ff1a34365eafd8df383a1015f08043d","source_path":"character_system_text_dict.json","json_path":["1036","71017"],"target_text":"Mánh phát sáng trong bóng tối ấy hả?\r\nHừ, ai mà nói cho mày biết.","reviewed":true},
    {"entry_index":53,"uid":"zhcn:e8baf139b8eadf04391f6a97","kind":"character_system_text","source_text":"不管穿着什么去比赛，\r\n推算的结果都不会改变的。","source_fingerprint":"c994871d7d9724ad761264176ab0e625e873bc06d9b2c7fa674c2a6a225a8273","source_path":"character_system_text_dict.json","json_path":["1036","71018"],"target_text":"Dù mặc gì để đi đua,\r\nkết quả tính toán cũng chẳng thay đổi đâu.","reviewed":true},
    {"entry_index":54,"uid":"zhcn:2f20cfdce37f42a75fcee19b","kind":"character_system_text","source_text":"……顺便收集一下衣服尺寸的数据好了。","source_fingerprint":"9676dbc19f680745ee84e46f680eef494d68091cda5ca84f13743537d2fcfef3","source_path":"character_system_text_dict.json","json_path":["1036","71019"],"target_text":"…Tiện thể thu thập luôn dữ liệu kích cỡ trang phục vậy.","reviewed":true},
    {"entry_index":55,"uid":"zhcn:4837dc1186ac983324b11706","kind":"character_system_text","source_text":"辛苦了。","source_fingerprint":"2f747fdfd41fdd19d5e6205e2563472ecb3e45190ea9201c283e895272ee13e6","source_path":"character_system_text_dict.json","json_path":["1036","80000"],"target_text":"Vất vả rồi.","reviewed":true},
    {"entry_index":56,"uid":"zhcn:88100019e070270fbcfe8464","kind":"character_system_text","source_text":"シミュレーション通り、\r\nブチ抜いてやるよ！","source_fingerprint":"5c4a466947e456d344f05df130f5c2e6176c67597cdb6f312e8f60d32ecf9bd2","source_path":"character_system_text_dict.json","json_path":["1036","81000"],"target_text":"Đúng như mô phỏng,\r\ntao sẽ vượt phăng hết cho xem!","reviewed":true},
    {"entry_index":57,"uid":"zhcn:a13e6358b4c41471153ca4a1","kind":"character_system_text","source_text":"オレのロジックを超えるってか？\r\n…はッ、甘ェんだよ！","source_fingerprint":"33858e3dc1fe3cd9a1cba29a4a4c2816ffac793c69a9a12b60ba4349f1da961d","source_path":"character_system_text_dict.json","json_path":["1036","81001"],"target_text":"Tính vượt qua logic của tao à?\r\n…Hah, ngây thơ quá đấy!","reviewed":true},
    {"entry_index":58,"uid":"zhcn:bb158757958bea2b50768cfa","kind":"character_system_text","source_text":"……嗯。\r\n什么啊，刚刚那句就是在对你说早上好了。\r\n排列语句什么的没必要吧？","source_fingerprint":"be82c0b27da81fef839325610d7b29f33f496de06f0e3d04f88d9ddc420f159e","source_path":"character_system_text_dict.json","json_path":["1036","90000"],"target_text":"…Ừ.\r\nGì? Câu vừa rồi là tao chào buổi sáng mày đấy.\r\nCần gì phải sắp chữ thành câu cho tử tế chứ?","reviewed":true},
    {"entry_index":59,"uid":"zhcn:3d3989322fde3d4454960c58","kind":"character_system_text","source_text":"我可不会一大早就在那里\r\n优雅地吃着什么面包鸡蛋啊啥的。\r\n靠能量胶里的营养素就已经足够了。","source_fingerprint":"31100307cf9102dc2dadae51452d6fc405567118db24daabf2f7ec33cd2da530","source_path":"character_system_text_dict.json","json_path":["1036","90001"],"target_text":"Tao đâu có sáng sớm ngồi đó\r\nnhã nhặn ăn bánh mì, trứng các kiểu.\r\nDinh dưỡng trong gel năng lượng là đủ rồi.","reviewed":true}
  ]
}