{
  "schema_version": 1,
  "status": "complete",
  "epoch": "zhcn-67f8551f7780",
  "task_id": "batch-01301-s02",
  "batch": 1301,
  "shard": 2,
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 40,
  "shard_end_exclusive": 60,
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 40,
      "uid": "zhcn:96d4a18c32fdabdad229f418",
      "kind": "character_system_text",
      "source_text": "レースで白黒ハッキリつける。\r\nそのためのデータ収集だ。",
      "source_fingerprint": "ed654d5e0f8d1e5bbd3bd1a74a6b8b055a2a120ae6228eee8bf23a4012805200",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "92016"
      ],
      "target_text": "Phân rõ trắng đen ngay trên đường đua.\r\nĐây là việc thu thập dữ liệu vì mục đích đó.",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:daceae6d48b5079fab934d64",
      "kind": "character_system_text",
      "source_text": "お前の知恵も力も、\r\n貪欲に利用してやるさ。",
      "source_fingerprint": "1cc8da9755cb734298253cd15baefbb87f7b6130fee09d6681c37e7c2f1e1aea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "92017"
      ],
      "target_text": "Trí tuệ lẫn sức mạnh của cậu,\r\ntao sẽ tham lam tận dụng hết đấy.",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:9693febb999bf1bb91394c26",
      "kind": "character_system_text",
      "source_text": "ドミナントだけじゃ\r\nトラックは成立しねェ。\r\nまずは基本を押さえンぞ。",
      "source_fingerprint": "de1c5b1ee6ce3674de6051fc31a1c4c6f343d382162706810ad6b9d1e82ecdaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "92018"
      ],
      "target_text": "Chỉ có mỗi âm chủ đạo (dominant) thôi\r\nthì chẳng dựng nên được track nào đâu.\r\nTrước tiên phải nắm chắc phần cơ bản cái đã.",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:36b81f54a947a4e9fd06f359",
      "kind": "character_system_text",
      "source_text": "羽があるから速く走れそう…？\r\nハ、単純なヤツ。",
      "source_fingerprint": "f30cbf3e7c91de21b9bd20803b334f64ecab7ff7bf3e27bf19ec40dfbb4373a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "92020"
      ],
      "target_text": "Có cánh nên chắc chạy nhanh được…?\r\nHa, đúng là đơn giản.",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:e7cfe45e4e591863b8199dd8",
      "kind": "character_system_text",
      "source_text": "呆れるくらい穏やかな顔\r\nしてンなァ…お前にも角が\r\n必要なンじゃねェの？",
      "source_fingerprint": "c486c3a5911b0d3422bf4ba68a28611a3e0d77c00fb1a628c12ffac94e3520ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "92021"
      ],
      "target_text": "Cái mặt bình thản đến phát chán\r\nấy nhỉ… Cậu cũng cần có\r\nsừng đấy chứ nhỉ?",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:97206386f798a13ec8db3f91",
      "kind": "character_system_text",
      "source_text": "オレとの『契約』が続く限り、\r\nお前にゃよく働いてもらう。\r\n…って、言うまでもなかったか。",
      "source_fingerprint": "e9932b153a4bb54080901ed2fdea2c6558a5bb91f8d6b7eb1c7ef46dd28cefea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "92022"
      ],
      "target_text": "Chừng nào『hợp đồng』với tao còn tiếp diễn,\r\ntao sẽ để cậu làm việc cho ra trò.\r\n…mà thôi, chắc không cần nói cũng biết nhỉ.",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:137c41fd1db9f716545c6cf3",
      "kind": "character_system_text",
      "source_text": "居然让我随性展现只属于我的“逻辑”，\r\n真是个有趣的家伙啊。",
      "source_fingerprint": "55c1ac10a78dedca3a62ece03423fcc54c2f564a78f7007bea57565802995c5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "93000"
      ],
      "target_text": "Lại để cho tao tự do thể hiện thứ “logic” chỉ thuộc về riêng tao,\r\nquả là một kẻ thú vị đấy.",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:24af0caee9618cfb12a68e28",
      "kind": "character_system_text",
      "source_text": "验证完毕。\r\n……直到最后也没有从我身边逃开，真让我惊讶。",
      "source_fingerprint": "62ce6018743fb424eb9fb0ff62cf8437c40dc6c8c24465629aa5cb9a595d7c56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "93001"
      ],
      "target_text": "Xác minh hoàn tất.\r\n…Đến tận cuối cùng cũng không chạy trốn khỏi tao, thật khiến tao bất ngờ.",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:ff2a03e23c35c0f2ec3dcf99",
      "kind": "character_system_text",
      "source_text": "お前との『契約』…悪くなかったよ。\r\nハハ、愉快な地獄だったなァ？",
      "source_fingerprint": "61177272e8eab3082796d93c81eb8f4fd8c38d086662a3430d5b9666427aaf0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "93004"
      ],
      "target_text": "『Hợp đồng』với cậu… cũng không tệ đâu.\r\nHaha, đúng là một địa ngục thú vị nhỉ?",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:d4be6c9e8d666bd7e4104331",
      "kind": "character_system_text",
      "source_text": "地獄みてェな道のりだったが、\r\nお互いよく生き残ったな。",
      "source_fingerprint": "43c56a65cdeb2b046c7aadffa908a6127c1c25f5c7cd1f938d05c4d6be4ad9e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "93005"
      ],
      "target_text": "Là một con đường như địa ngục vậy,\r\nnhưng cả hai đứa mình đều sống sót giỏi thật đấy.",
      "reviewed": true
    },
    {
      "entry_index": 50,
      "uid": "zhcn:4ed92de46f1c2f44000ac01a",
      "kind": "character_system_text",
      "source_text": "和推算结果一样的成长曲线啊。",
      "source_fingerprint": "2a3a6ed2374043ebad43934b085f813f8ebbe4fc5e453b508ba90719027096fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95000"
      ],
      "target_text": "Đúng là đường cong tăng trưởng giống hệt kết quả đã tính toán.",
      "reviewed": true
    },
    {
      "entry_index": 51,
      "uid": "zhcn:6c31d66c2fa8bd2340c543e2",
      "kind": "character_system_text",
      "source_text": "在此之上还有更强的境界，\r\n我可再清楚不过了。",
      "source_fingerprint": "957fde6a1337839db9019e3221e2ed22e838fc8406ee200a81d1f54665b193bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95001"
      ],
      "target_text": "Cao hơn thế này còn có cảnh giới mạnh mẽ hơn nữa,\r\ntao thì rõ hơn ai hết.",
      "reviewed": true
    },
    {
      "entry_index": 52,
      "uid": "zhcn:c71570fd65ac6548df693111",
      "kind": "character_system_text",
      "source_text": "……切。……我是空中神宫。",
      "source_fingerprint": "0110634fefc9e41163072acee7bee65577608dd13bfcfac21bcb803c9da84e6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95003"
      ],
      "target_text": "…Chậc. …Tao là Air Shakur.",
      "reviewed": true
    },
    {
      "entry_index": 53,
      "uid": "zhcn:da74480cb323ebb6268af093",
      "kind": "character_system_text",
      "source_text": "理解不了？……正好。\r\n这其中的“逻辑”，就由我来证明。",
      "source_fingerprint": "33baa39a7a915c09040571511ad7a5eba0b95e28e62898bb3946f9ea00181b8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95004"
      ],
      "target_text": "Không hiểu nổi à? …Vừa hay đấy.\r\nCái “logic” ẩn trong chuyện này, để tao chứng minh cho.",
      "reviewed": true
    },
    {
      "entry_index": 54,
      "uid": "zhcn:2c9050f60c50b3a527885872",
      "kind": "character_system_text",
      "source_text": "嘁……我来帮忙吧。",
      "source_fingerprint": "9e8981f0496a3f7e4ce573772c16aab94410d704fb7169522e7449caded9de86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95005"
      ],
      "target_text": "Xì… để tao giúp cho.",
      "reviewed": true
    },
    {
      "entry_index": 55,
      "uid": "zhcn:8828d4f96a2c81a082d5c7d9",
      "kind": "character_system_text",
      "source_text": "真是的……真没办法！",
      "source_fingerprint": "abdccb56b4edc88690978fb1da9d3d67771706f1010073d7aa4e89b94967e61e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95006"
      ],
      "target_text": "Thật tình… hết cách luôn mà!",
      "reviewed": true
    },
    {
      "entry_index": 56,
      "uid": "zhcn:4048406a58a869087aadaed1",
      "kind": "character_system_text",
      "source_text": "魔力アップ。\r\n…って言やァ満足か？",
      "source_fingerprint": "bfb690ee0c3972aae32746863851c931cfb0a518c7e6a464df674fc1f383bcf0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95007"
      ],
      "target_text": "Ma lực tăng lên.\r\n…Nói vậy là vừa lòng chưa?",
      "reviewed": true
    },
    {
      "entry_index": 57,
      "uid": "zhcn:c6f190d49c4b6447a0d28dd1",
      "kind": "character_system_text",
      "source_text": "悪魔の上っつーと…魔王？",
      "source_fingerprint": "6de742d3be4790085b094177be52f725a170e22594d12df4dceb8d2d7b8036ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95008"
      ],
      "target_text": "Trên ác quỷ thì là… Ma vương à?",
      "reviewed": true
    },
    {
      "entry_index": 58,
      "uid": "zhcn:9a934298d13b796556c39983",
      "kind": "character_system_text",
      "source_text": "突き詰めてやる――\r\n地獄の奥の奥までな！",
      "source_fingerprint": "ff466e90bfbce1a5cd3b8871c4f692e914c0b3c28cd34c80b1d5fed0ff8ffce6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95009"
      ],
      "target_text": "Tao sẽ truy đến tận cùng――\r\nđến tận sâu nhất của địa ngục luôn!",
      "reviewed": true
    },
    {
      "entry_index": 59,
      "uid": "zhcn:8e11857140ba75d39ec741dd",
      "kind": "character_system_text",
      "source_text": "…エアシャカール。\r\nオレと『取引』したいって？",
      "source_fingerprint": "e7ffa5e0895c5d02646f251b41de7f4f08112da2c6b75780d7bc86e6bb2a18de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1036",
        "95010"
      ],
      "target_text": "…Air Shakur.\r\nMuốn 『giao dịch』với tao à?",
      "reviewed": true
    }
  ]
}
