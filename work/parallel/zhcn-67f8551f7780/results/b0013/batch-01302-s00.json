  "shard": 0,
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 0,
  "shard_end_exclusive": 20,
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:a18e92ca69c1a24bb7bdaba9",
      "kind": "character_system_text",
      "source_text": "有你的Geschenk……礼物。\r\n里面装的会是什么呢？",
      "source_fingerprint": "02007735f5d3b9df8a2a007ece80deb10d8bcbfaf9fadece2bbf021e40727956",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10016"
      ],
      "target_text": "Có Geschenk… quà tặng dành cho Trainer đây.\r\nKhông biết bên trong đựng gì nhỉ?",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:8db103ed3692ea1d4410afe7",
      "kind": "character_system_text",
      "source_text": "依照计划完成了任务……\r\n真了不起。\r\n记得领取努力达成的奖励喔。",
      "source_fingerprint": "b88aca81506c5860862c8468232602d02394be80ef8e063467f580041f05644e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10017"
      ],
      "target_text": "Đã hoàn thành nhiệm vụ đúng theo kế hoạch…\r\nthật tuyệt vời.\r\nNhớ nhận phần thưởng cho nỗ lực đã đạt được nhé.",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:1c0e898271211733e6f40a81",
      "kind": "character_system_text",
      "source_text": "很快就要举办活动了。\r\n为了当天能够尽兴，\r\n要好好制定行程才行。",
      "source_fingerprint": "c22675691d628092edd160141768df4e3918192e01c373049534389088eb56bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10018"
      ],
      "target_text": "Sắp đến lúc tổ chức sự kiện rồi.\r\nĐể có thể tận hưởng trọn vẹn ngày hôm đó,\r\ncần phải lên kế hoạch cho thật chu đáo mới được.",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:41bb7fbd9f4cd5818d7a444a",
      "kind": "character_system_text",
      "source_text": "正在举办活动呢。\r\n活动就像是嘉年华一样……\r\n感觉身体蠢蠢欲动呢。",
      "source_fingerprint": "d5c70d287d4c5510ab6397e272092ee37d00be90c2917898f6b715bc019fb118",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10019"
      ],
      "target_text": "Sự kiện đang được tổ chức đấy.\r\nSự kiện cứ như một lễ hội carnival vậy…\r\ncảm giác cơ thể cứ rục rịch muốn động đậy.",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:98301da42c67775b3b517dec",
      "kind": "character_system_text",
      "source_text": "这是我的失误……",
      "source_fingerprint": "2f99d6fd6144b861415e5439850e1200c2d17e5890c98cab2cb9cf110993c349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1002"
      ],
      "target_text": "Đây là sai sót của tôi…",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:627ab363e57719578e9c409f",
      "kind": "character_system_text",
      "source_text": "赛马娘名鉴的等级好像提升了。\r\n请确认。",
      "source_fingerprint": "17b6d060df96efebce0e6e082e8d0d5a17bf2da1242c6ff2d6d5cb9ed9d51e8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10021"
      ],
      "target_text": "Cấp độ Archive Mã Nương hình như đã tăng lên rồi.\r\nMời Trainer xác nhận.",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:b197e0fe850c586979ea19b1",
      "kind": "character_system_text",
      "source_text": "着やすさ、運動性、上品さ…\r\nそれら全てをバランスよく汲んだ物\r\n――それがこの服というわけです。",
      "source_fingerprint": "f60e0b47767ea106796d55890a2c6e73bddf9ff2a7275b4d1672e00874074459",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10025"
      ],
      "target_text": "Sự dễ mặc, tính vận động, vẻ thanh lịch…\r\nmón đồ dung hòa tất cả những điều đó một cách cân bằng\r\n――đó chính là bộ trang phục này.",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:9a4e190fccf99441d34d45f2",
      "kind": "character_system_text",
      "source_text": "ジャケットはクリーニング。\r\nベルトは手洗い…洗濯の時間をより\r\n効率的にできないものでしょうか。",
      "source_fingerprint": "444ad66c28e01c769363088dd4749db5d27335850e286a50f2d7198e50fd64c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10026"
      ],
      "target_text": "Áo khoác thì giặt khô.\r\nThắt lưng thì giặt tay…\r\nchẳng lẽ không có cách nào để thời gian giặt giũ hiệu quả hơn sao.",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:d5cdf575660fb3fe9a955f6e",
      "kind": "character_system_text",
      "source_text": "いいですか。ボタンを下まで止めて\r\nいないのはファッションです。\r\nだらしがないわけではありません。",
      "source_fingerprint": "2808c759f6930f5b11aa9d34810b7cfdace1b5d5c94d378dd31f2ca16038df71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "10027"
      ],
      "target_text": "Nghe cho rõ đây.\r\nKhông cài nút áo đến tận cùng là thời trang.\r\nKhông phải là luộm thuộm đâu.",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:5c54395c0d9b433546c5aa7d",
      "kind": "character_system_text",
      "source_text": "是我想得太天真了。",
      "source_fingerprint": "ac13e729e4e027b88e5491113bd00ebb2af4ba842ef226925aa7dc925f0b166c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1003"
      ],
      "target_text": "Là do tôi đã nghĩ quá ngây thơ rồi.",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:afdaca90db6979538339087b",
      "kind": "character_system_text",
      "source_text": "按照计划取得胜利了。",
      "source_fingerprint": "9a752a751a2a613fc2c1e297963c6daff42b9cad3c7ddfc8de2301773029ba80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1004"
      ],
      "target_text": "Đã giành chiến thắng đúng theo kế hoạch.",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:8c9476b27749eb12bb32165d",
      "kind": "character_system_text",
      "source_text": "这是我的失误……",
      "source_fingerprint": "2f99d6fd6144b861415e5439850e1200c2d17e5890c98cab2cb9cf110993c349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1005"
      ],
      "target_text": "Đây là sai sót của tôi…",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:8fffaa3dd23def257e786423",
      "kind": "character_system_text",
      "source_text": "是我想得太天真了。",
      "source_fingerprint": "ac13e729e4e027b88e5491113bd00ebb2af4ba842ef226925aa7dc925f0b166c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1006"
      ],
      "target_text": "Là do tôi đã nghĩ quá ngây thơ rồi.",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:0692f502135f3be6e5a6de3d",
      "kind": "character_system_text",
      "source_text": "要比原订目标走得更远……",
      "source_fingerprint": "274f1cc04eaddbcb45f4b523ac66995dcdf93e4fcb32ffac64eb1b2f95075e7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1007"
      ],
      "target_text": "Phải đi xa hơn cả mục tiêu đã định ban đầu…",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:e10631f5cb293801e3c81453",
      "kind": "character_system_text",
      "source_text": "尽力做到Beste吧。",
      "source_fingerprint": "e07ee8aedee8f3acd6f30b859ac861abd4b9e4e7040cb2e4eec01dd4acf236e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1008"
      ],
      "target_text": "Hãy cố gắng làm đến mức Beste (tốt nhất) nào.",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:547fe54c7b00419d51c0d7fb",
      "kind": "character_system_text",
      "source_text": "全都在我的计划之中。",
      "source_fingerprint": "66858824831527b22ce22305deba7534d8a622a6cdff2636921d22f3bc8813f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1022"
      ],
      "target_text": "Tất cả đều nằm trong kế hoạch của tôi.",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:f20ba0de01df5799df1263ad",
      "kind": "character_system_text",
      "source_text": "一秒都不能怠慢。",
      "source_fingerprint": "5b9d3570d54885a9f3f7b845f65b237a1253b0f8219dd5bde0cf26489dfdb50d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1079"
      ],
      "target_text": "Không được lơ là dù chỉ một giây.",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:7caf1ea8e11f31295c3d89f3",
      "kind": "character_system_text",
      "source_text": "绝对守时。",
      "source_fingerprint": "b814ea6626a9663c9bdb0d6e9bbb4d4b546f21ee0b713c4d238ebb6fdc17b5ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "1080"
      ],
      "target_text": "Tuyệt đối đúng giờ.",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:06b6010525abd9e20b7a08c7",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "11"
      ],
      "target_text": "Cygames",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:0b761cb996b26a8389badb1f",
      "kind": "character_system_text",
      "source_text": "那么，\r\n这次预计要做的训练是……",
      "source_fingerprint": "c52725aef57b6139fee3b483d2783fd16b672fb552eb72e17c1411ce21174e68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "110000"
      ],
      "target_text": "Vậy thì,\r\nbài huấn luyện dự định thực hiện lần này là…",
      "reviewed": true
    }
  ]
}
