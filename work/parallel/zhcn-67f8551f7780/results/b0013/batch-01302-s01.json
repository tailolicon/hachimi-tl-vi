      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "110001"
      ],
      "target_text": "Lịch sử và truyền thống của học viện…\r\nxin Trainer nhất định để tôi học hỏi thật kỹ càng.",
