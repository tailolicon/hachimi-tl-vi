      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "140014"
      ],
      "target_text": "Ừm…",
      "reviewed": true
    },
    {
      "entry_index": 41,
      "uid": "zhcn:a91955a670e282eb081a623b",
      "kind": "character_system_text",
      "source_text": "没有……",
      "source_fingerprint": "3f57dfee24aa08bd125df6a26d39e23067bd3b67d99fc448a32d9243f8ed9fe5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "140015"
      ],
      "target_text": "Không có gì…",
      "reviewed": true
    },
    {
      "entry_index": 42,
      "uid": "zhcn:55761f14ffd9812d4e87a6dc",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "140016"
      ],
      "target_text": "Đi thôi.",
      "reviewed": true
    },
    {
      "entry_index": 43,
      "uid": "zhcn:9ebadf1bd748fc9054704d5d",
      "kind": "character_system_text",
      "source_text": "呜……",
      "source_fingerprint": "e23a2a933be63f7992ef78dc97543046307e6306c1a546d698062edb79747a91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "140017"
      ],
      "target_text": "Ưm…",
      "reviewed": true
    },
    {
      "entry_index": 44,
      "uid": "zhcn:dbf11245ec45390fd20576fb",
      "kind": "character_system_text",
      "source_text": "唉……",
      "source_fingerprint": "fda4bd33d622bd98ca587ee7d715a334c1539d637bda2840b8a8e6b90025e5cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "140018"
      ],
      "target_text": "Haiz…",
      "reviewed": true
    },
    {
      "entry_index": 45,
      "uid": "zhcn:2749c2823e0d5cb8a957b56f",
      "kind": "character_system_text",
      "source_text": "预计明天可以拿到这个。",
      "source_fingerprint": "4f736f5663f41f1d199bdafd565909c0dec41a49cede4d0749591e795e9fc95d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "15"
      ],
      "target_text": "Dự kiến ngày mai có thể nhận được cái này.",
      "reviewed": true
    },
    {
      "entry_index": 46,
      "uid": "zhcn:b22e8640d82940f2ac393204",
      "kind": "character_system_text",
      "source_text": "……感觉身体有点沉重呢。\r\n是否该稍微调整一下行程比较好……",
      "source_fingerprint": "66fddf4714ca7ef26f922dca540a182a94b2591d1b33e09dd19c3e5228d7be24",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20000"
      ],
      "target_text": "…Cảm giác cơ thể hơi nặng nề nhỉ.\r\nCó lẽ nên điều chỉnh lại lịch trình một chút thì hơn…",
      "reviewed": true
    },
    {
      "entry_index": 47,
      "uid": "zhcn:17f52c6db1aea2c65003baa8",
      "kind": "character_system_text",
      "source_text": "看来有必要制定休息的时间呢……",
      "source_fingerprint": "b63a93706ae8892f1b7cc99283fafd2ae02e5a8c56b10ec3e644872e5162d83d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20001"
      ],
      "target_text": "Xem ra cần phải sắp xếp thời gian nghỉ ngơi rồi…",
      "reviewed": true
    },
    {
      "entry_index": 48,
      "uid": "zhcn:8bf7ad9fbc41e7274c125c62",
      "kind": "character_system_text",
      "source_text": "这就是绝佳状态吧……呵呵。\r\n多亏了你的指导，\r\n才让我有办法依照行程做事呢。",
      "source_fingerprint": "251f2a2000ce65064422a1a177fd062e1f5f168be6f53c0381236151cc33cbe7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20002"
      ],
      "target_text": "Đây chắc là trạng thái tuyệt vời nhất rồi…hì hì.\r\nNhờ có sự chỉ dẫn của Trainer,\r\ntôi mới có thể làm việc đúng theo lịch trình đấy.",
      "reviewed": true
    },
    {
      "entry_index": 49,
      "uid": "zhcn:eaf0c6a77c7304ddc7871889",
      "kind": "character_system_text",
      "source_text": "现在的状态非常好。\r\n再来就只需要照计划进行……！",
      "source_fingerprint": "acdd76f7cc0c39be9e971cf31c1dbb33fb369105991c7be99b7ab78b9eab8f24",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20003"
      ],
      "target_text": "Trạng thái hiện tại rất tốt.\r\nTiếp theo chỉ cần tiến hành theo đúng kế hoạch thôi…!",
      "reviewed": true
    },
    {
      "entry_index": 50,
      "uid": "zhcn:7f648a25c3ec9a4048ddc3c8",
      "kind": "character_system_text",
      "source_text": "感觉不错……\r\n应该能获得预期的成果。",
      "source_fingerprint": "dfa20357445f83abb749ea62cd07ba305c1d57d8330129601170d231d5c03b89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20004"
      ],
      "target_text": "Cảm giác không tệ…\r\nchắc sẽ đạt được thành quả như dự tính.",
      "reviewed": true
    },
    {
      "entry_index": 51,
      "uid": "zhcn:aca910de735c9152e726b7bf",
      "kind": "character_system_text",
      "source_text": "那我们就按照计划开始吧。\r\n感觉会是一场充实的训练呢。",
      "source_fingerprint": "9c562743686fbfa217561dbefe8ef2bf54cda0f8fe533f43127f6508c70dd8b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20005"
      ],
      "target_text": "Vậy thì chúng ta bắt đầu theo đúng kế hoạch thôi.\r\nCảm giác đây sẽ là một buổi luyện tập thật sung túc đấy.",
      "reviewed": true
    },
    {
      "entry_index": 52,
      "uid": "zhcn:cb2b115c7bb2222888df99af",
      "kind": "character_system_text",
      "source_text": "状态很好。\r\n应该能按照计划完成训练项目。",
      "source_fingerprint": "53153d0407532cee0960e9b19bf38c3874b683355d86b70b830c6129f4bfedd8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20006"
      ],
      "target_text": "Trạng thái rất tốt.\r\nChắc sẽ hoàn thành được các hạng mục luyện tập đúng theo kế hoạch.",
      "reviewed": true
    },
    {
      "entry_index": 53,
      "uid": "zhcn:e0cd31c4cf17349b5b25397b",
      "kind": "character_system_text",
      "source_text": "依照现在的步调，\r\n目前的行程应该都没有问题。",
      "source_fingerprint": "5966a49c18b70fe9c4b7c757df8d18c319166f1323405ac69ccccd2b73de59e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20007"
      ],
      "target_text": "Theo nhịp độ hiện tại,\r\nlịch trình bây giờ chắc sẽ không có vấn đề gì.",
      "reviewed": true
    },
    {
      "entry_index": 54,
      "uid": "zhcn:9216a932bd8173e32950769a",
      "kind": "character_system_text",
      "source_text": "不知道怎么了……感觉有点倦怠……\r\n或许是需要稍做调整……",
      "source_fingerprint": "516a447f9a18300f572768307d46fa6285c8a5329013b3a54d5031edfe000a38",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20008"
      ],
      "target_text": "Không biết sao nữa…cảm thấy hơi uể oải…\r\ncó lẽ cần điều chỉnh một chút…",
      "reviewed": true
    },
    {
      "entry_index": 55,
      "uid": "zhcn:b43b842a94f671e45963c5de",
      "kind": "character_system_text",
      "source_text": "今天本来计划好要训练的……\r\n可是身体却有点沉重。",
      "source_fingerprint": "613bb363b41d08eb31d1e8bfe543adc56ce9f01636e9afd8a4cb8b7a0a13960d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20009"
      ],
      "target_text": "Hôm nay vốn đã định sẵn kế hoạch luyện tập…\r\nnhưng cơ thể lại hơi nặng nề.",
      "reviewed": true
    },
    {
      "entry_index": 56,
      "uid": "zhcn:b1c5a2a266f6692283f30231",
      "kind": "character_system_text",
      "source_text": "唔……\r\n总觉得连尾巴都变得毛躁起来了……",
      "source_fingerprint": "754168780dfa0df1b9bcaea2b8f7350f4d9e2d2030cfb91c8a4bc2a154792dd7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20010"
      ],
      "target_text": "Ừm…\r\ncảm giác đến cả cái đuôi cũng trở nên xù xì rồi…",
      "reviewed": true
    },
    {
      "entry_index": 57,
      "uid": "zhcn:f0a5f22646daafd505d66f83",
      "kind": "character_system_text",
      "source_text": "好像没办法调整好状态呢……",
      "source_fingerprint": "acb376ec3077af84a4ab7c57a36398c0959a106d756c00d158c0aef91e5be4ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20011"
      ],
      "target_text": "Có vẻ như không thể điều chỉnh trạng thái cho tốt được…",
      "reviewed": true
    },
    {
      "entry_index": 58,
      "uid": "zhcn:6be2967b26bb82d144963c6d",
      "kind": "character_system_text",
      "source_text": "……今天也要参赛的话，\r\n以行程安排来说有点太勉强了……",
      "source_fingerprint": "b429fb0b2707b97bde8940c376295e184b40728eaa728dde9b5c665c59692c57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20021"
      ],
      "target_text": "…Nếu hôm nay cũng phải tham gia thi đấu,\r\nthì xét theo lịch trình sắp xếp thì hơi quá gượng ép rồi…",
      "reviewed": true
    },
    {
      "entry_index": 59,
      "uid": "zhcn:dc9a0f22d1d584045cf1da25",
      "kind": "character_system_text",
      "source_text": "一直这样连续参赛的话，\r\n会影响到之后的行程的……",
      "source_fingerprint": "94bdcf3451d196defc8c48ecf70347bbd0ddb6acd7fa378662204f3131851153",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20022"
      ],
      "target_text": "Nếu cứ liên tục tham gia thi đấu mãi như vậy,\r\nsẽ ảnh hưởng đến lịch trình về sau đấy…",
      "reviewed": true
    }
  ]
}
