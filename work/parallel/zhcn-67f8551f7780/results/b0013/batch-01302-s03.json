  "shard": 3,
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 60,
  "shard_end_exclusive": 80,
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 60,
      "uid": "zhcn:72fd9854b5be1a41ebbec0a0",
      "kind": "character_system_text",
      "source_text": "Sturm und Drang……！\r\n老实说我现在感到很雀跃……！",
      "source_fingerprint": "06bd22cc2324d78dcc7febe5d46d3f9535010b10f23e7adf9547ecb57639fd4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20023"
      ],
      "target_text": "Sturm und Drang…!\r\nThành thật mà nói bây giờ tôi cảm thấy rất hào hứng…!",
      "reviewed": true
    },
    {
      "entry_index": 61,
      "uid": "zhcn:b28bead42b093e1405114f2f",
      "kind": "character_system_text",
      "source_text": "分毫不差地执行计划……\r\n完全是理想中的状态。\r\n感觉可以顺利地取得胜利。",
      "source_fingerprint": "129255acc2e5995c182c3a61ce76740519378ec3fb61358b4e6742abf219393c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20024"
      ],
      "target_text": "Thực hiện kế hoạch không sai lệch dù chỉ một li…\r\nhoàn toàn là trạng thái lý tưởng.\r\nCảm giác có thể giành chiến thắng một cách suôn sẻ.",
      "reviewed": true
    },
    {
      "entry_index": 62,
      "uid": "zhcn:bcf8e396ca22763bfc73c219",
      "kind": "character_system_text",
      "source_text": "不枉费我们花时间一起制定计划呢。\r\n……那我这就去完成我们的目标了。",
      "source_fingerprint": "82a6af74cc684b388e595c8945647f45f05bf83cd82363772a1447a0b01763c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20025"
      ],
      "target_text": "Không uổng công chúng ta đã dành thời gian cùng nhau lập kế hoạch nhỉ.\r\n…Vậy thì tôi đi hoàn thành mục tiêu của chúng ta đây.",
      "reviewed": true
    },
    {
      "entry_index": 63,
      "uid": "zhcn:449f62c560d30a48396889b7",
      "kind": "character_system_text",
      "source_text": "体能状态良好、精神状态良好、\r\n尾巴的修剪也没问题……\r\n可以说是准备万全的状态。",
      "source_fingerprint": "f08be57feeb44bfdbba0475781a9ac201f45877be2a998925fc341800330c1be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20026"
      ],
      "target_text": "Thể lực tốt, tinh thần tốt,\r\nviệc tỉa đuôi cũng ổn cả…\r\ncó thể nói là trạng thái chuẩn bị hoàn hảo.",
      "reviewed": true
    },
    {
      "entry_index": 64,
      "uid": "zhcn:5766bba807e1fec4ab9a022f",
      "kind": "character_system_text",
      "source_text": "顺利依照计划以良好的状态迎战呢。\r\n再来就只需要跑出好成绩了。",
      "source_fingerprint": "d8525d4d46d65d5aac35173928466b0fc0206f00dd78f6606170ada24c760976",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20027"
      ],
      "target_text": "Đã theo đúng kế hoạch bước vào trận đấu với trạng thái tốt rồi nhỉ.\r\nTiếp theo chỉ cần chạy ra thành tích tốt thôi.",
      "reviewed": true
    },
    {
      "entry_index": 65,
      "uid": "zhcn:57536e59cf2a33bf62e6344f",
      "kind": "character_system_text",
      "source_text": "因为有你，才顺利调整到好的状态。\r\n我一定不会辜负你的期望。",
      "source_fingerprint": "c8c75ecb3bbcf1316202e1f47b50ef636ad8017a5057e9ea1c0be9b5a66770e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20028"
      ],
      "target_text": "Nhờ có Trainer mà tôi mới điều chỉnh được trạng thái tốt một cách suôn sẻ.\r\nTôi nhất định sẽ không phụ lòng mong đợi của Trainer.",
      "reviewed": true
    },
    {
      "entry_index": 66,
      "uid": "zhcn:adcead977668181a5dd4198b",
      "kind": "character_system_text",
      "source_text": "……请不用担心。\r\n我会证明这一路以来，\r\n我们所做的事情都是正确的。",
      "source_fingerprint": "0e72829c52028d72ea2f1695e85e1552c4768cd11cb184fba9189fbb5c641e2c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20029"
      ],
      "target_text": "…Xin đừng lo lắng.\r\nTôi sẽ chứng minh rằng suốt chặng đường vừa qua,\r\nnhững gì chúng ta đã làm đều đúng đắn.",
      "reviewed": true
    },
    {
      "entry_index": 67,
      "uid": "zhcn:851cb377de624cb685c27e6f",
      "kind": "character_system_text",
      "source_text": "toi、toi、toi……好。\r\n那就上场吧。",
      "source_fingerprint": "5417f8ed1020110be59d8f22682e260639b2ab7722de2a398f4630541f74c46d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20030"
      ],
      "target_text": "toi, toi, toi… được rồi.\r\nVậy thì ra sân thôi.",
      "reviewed": true
    },
    {
      "entry_index": 68,
      "uid": "zhcn:e12d1dce1f71b233b874fcc2",
      "kind": "character_system_text",
      "source_text": "一切几乎都依照计划进行呢。\r\n我有十足的把握能够达成目标。",
      "source_fingerprint": "04d15c7c80e9ade5493915ef1164c3af3a6865fa2ad008f43b810eeb229d32e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20031"
      ],
      "target_text": "Hầu như mọi thứ đều đang diễn ra đúng theo kế hoạch nhỉ.\r\nTôi có đầy đủ tự tin có thể đạt được mục tiêu.",
      "reviewed": true
    },
    {
      "entry_index": 69,
      "uid": "zhcn:eb13db4fad5e8a6ee215e5f6",
      "kind": "character_system_text",
      "source_text": "虽然不是最完美的状态……\r\n但我并没有迷失目标。",
      "source_fingerprint": "85d9210d27887c41bbd3892703ea36d442ae7131553278a2b4c70f8d24713594",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20032"
      ],
      "target_text": "Tuy không phải trạng thái hoàn hảo nhất…\r\nnhưng tôi không hề đánh mất mục tiêu.",
      "reviewed": true
    },
    {
      "entry_index": 70,
      "uid": "zhcn:e1c590b31c73e0c86907ec0f",
      "kind": "character_system_text",
      "source_text": "虽然计划有些被打乱了，\r\n但……还是有补救的可能。",
      "source_fingerprint": "cebf0f82b980a7fb32696ffee73de4ba070d6de0be221e13a10790e27bdfd19a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20033"
      ],
      "target_text": "Tuy kế hoạch có phần bị xáo trộn,\r\nnhưng… vẫn còn khả năng khắc phục được.",
      "reviewed": true
    },
    {
      "entry_index": 71,
      "uid": "zhcn:de3be3cc60e742a1396a355d",
      "kind": "character_system_text",
      "source_text": "目前的状态确实不好呢……\r\n但总之我会全力以赴的。",
      "source_fingerprint": "93a61f55823373779c942db4c58af0d0890eec1c83b639f987fa64510f70aa1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20034"
      ],
      "target_text": "Trạng thái hiện tại quả thực không tốt…\r\nnhưng dù sao tôi cũng sẽ dốc hết toàn lực.",
      "reviewed": true
    },
    {
      "entry_index": 72,
      "uid": "zhcn:7e9387d76c7a91ff7c3162e8",
      "kind": "character_system_text",
      "source_text": "这是预料之外的状况……\r\n但在沮丧之前，\r\n还要先好好应战才行……",
      "source_fingerprint": "7c8945a15f921494de2f818817f437347c926969057213e96ee3e56e8a72b236",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20035"
      ],
      "target_text": "Đây là tình huống ngoài dự đoán…\r\nnhưng trước khi chán nản,\r\ntôi phải đối mặt thật tốt với trận đấu này đã…",
      "reviewed": true
    },
    {
      "entry_index": 73,
      "uid": "zhcn:226ffc8b385ef05842fdf96d",
      "kind": "character_system_text",
      "source_text": "现在只希望能跑完全程，\r\n不给父母丢脸……只能如此了。",
      "source_fingerprint": "95a57573161696a41ffa87a6ac8f17d3226720164c91383f4d6212af261f2229",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20036"
      ],
      "target_text": "Bây giờ chỉ mong có thể chạy hết toàn bộ chặng đường,\r\nkhông làm ba mẹ mất mặt… đành phải như vậy thôi.",
      "reviewed": true
    },
    {
      "entry_index": 74,
      "uid": "zhcn:9cdea8a0e5dca842384b6098",
      "kind": "character_system_text",
      "source_text": "一直没办法集中注意力……\r\n但也不是不能参赛的地步。",
      "source_fingerprint": "b335167479114e89ae848d66eaa391c9c3d174879470d1b54672ee1564463c2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20037"
      ],
      "target_text": "Cứ mãi không thể tập trung được…\r\nnhưng cũng chưa đến mức không thể tham gia thi đấu.",
      "reviewed": true
    },
    {
      "entry_index": 75,
      "uid": "zhcn:53ca51e1846bff3668723d55",
      "kind": "character_system_text",
      "source_text": "那我要上了。",
      "source_fingerprint": "020a28a15128f0c8bf2a4dcfc7b524be5f099c6fc021f403031b7d144ea2fab4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20038"
      ],
      "target_text": "Vậy thì tôi lên đường đây.",
      "reviewed": true
    },
    {
      "entry_index": 76,
      "uid": "zhcn:cb4d612f2bda8cb3d15f202e",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20039"
      ],
      "target_text": "Bắt đầu thôi.",
      "reviewed": true
    },
    {
      "entry_index": 77,
      "uid": "zhcn:8c66460a5c14710b1e38adcb",
      "kind": "character_system_text",
      "source_text": "我会集中精神的。",
      "source_fingerprint": "28f29f715977690595dfd16ee28e069f8cdfcb5a782163bf55f7f1bd0a5f42fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20040"
      ],
      "target_text": "Tôi sẽ tập trung tinh thần.",
      "reviewed": true
    },
    {
      "entry_index": 78,
      "uid": "zhcn:5fa194d9647351126f3b4faa",
      "kind": "character_system_text",
      "source_text": "这很基本。",
      "source_fingerprint": "c24f6a000981dee56b3890a9a6e9bb39a36ec7a0bc4432d24730d00691cad9b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20041"
      ],
      "target_text": "Đây là điều cơ bản thôi.",
      "reviewed": true
    },
    {
      "entry_index": 79,
      "uid": "zhcn:32706993e070bd509c2cc593",
      "kind": "character_system_text",
      "source_text": "真是难以置信……！",
      "source_fingerprint": "943aa1696bfe28d3edf1f9e2a381f36f02a2064ef5b850f66f4617ba8030a031",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1037",
        "20042"
      ],
      "target_text": "Thật khó mà tin nổi…!",
      "reviewed": true
    }
  ]
}
