    {"uid":"zhcn:cd633e8d2a2d93a8d93ab44a","kind":"character_system_text","source_text":"更新高分纪录了喔！","source_fingerprint":"07f480c885a2c9d723662d34313c3c0a5a07cd87678520056181f04efb26083e","source_path":"character_system_text_dict.json","json_path":["1043","1007"],"entry_index":71,"target_text":"Phá kỷ lục điểm cao rồi!","reviewed":true},
    {"uid":"zhcn:e120f3f56c73a33fa56a42f9","kind":"character_system_text","source_text":"手下们，上啊！","source_fingerprint":"39a82c038323f87273503ac1e44aa0af9cf3da920803b66bd719ed8b3f88db59","source_path":"character_system_text_dict.json","json_path":["1043","1008"],"entry_index":72,"target_text":"Các thuộc hạ, xông lên!","reviewed":true},
    {"uid":"zhcn:27538ea111fe1de950f7c6dd","kind":"character_system_text","source_text":"どんないたずらを…。","source_fingerprint":"fc10e101979023ba652b1a0b612d783bf92fefb065eef56b1892dc6da6a18687","source_path":"character_system_text_dict.json","json_path":["1043","1091"],"entry_index":73,"target_text":"Nên nghịch trò gì đây…","reviewed":true},
    {"uid":"zhcn:6fa28d9982530bdd50172763","kind":"character_system_text","source_text":"风风要大口咬下！","source_fingerprint":"0472c99a2b1621f1cb7a071fe1be94e05733956603d85f2a0f7fa338cff0d5ff","source_path":"character_system_text_dict.json","json_path":["1043","1092"],"entry_index":74,"target_text":"Windy sẽ cắn một miếng thật to!","reviewed":true},
