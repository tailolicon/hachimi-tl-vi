  "entries": [
    {"uid":"zhcn:17813abd3f9457d5cb9ed465","kind":"character_system_text","source_text":"唔唔，活动预告！\r\n风风感到有机会可以恶作剧了喔！","source_fingerprint":"c6c4aa6d616070c2eb7272ec1f6a3f2c742253db74aa79890db273bb75b0bf33","source_path":"character_system_text_dict.json","json_path":["1043","10018"],"entry_index":60,"target_text":"Ồ ồ, có thông báo sự kiện!\r\nWindy ngửi thấy cơ hội nghịch phá rồi!","reviewed":true},
    {"uid":"zhcn:27014685dac11008a010e74c","kind":"character_system_text","source_text":"活动开始啰！\r\n动作快，风风想快点去玩啦！","source_fingerprint":"38cbe093dd37d1da8db84fc48c56e0ac18076f6478d9f747bd9babd05cbf936b","source_path":"character_system_text_dict.json","json_path":["1043","10019"],"entry_index":61,"target_text":"Sự kiện bắt đầu rồi!\r\nNhanh lên, Windy muốn đi chơi ngay!","reviewed":true},
    {"uid":"zhcn:a04975b72ac4bcf4452221e6","kind":"character_system_text","source_text":"唔哇！！","source_fingerprint":"4506dd0d7bfa26ae7a66f0e6e3326dbcb7eac9950470ae3cad7d60a0d0a5d8f9","source_path":"character_system_text_dict.json","json_path":["1043","1002"],"entry_index":62,"target_text":"Uwaa!!","reviewed":true},
    {"uid":"zhcn:ff6047d1c5bbc5a4b87447b0","kind":"character_system_text","source_text":"名册等级上升！呵呵♪\r\n手下的成果就是老大的成果！","source_fingerprint":"db79c5b6bb5970072e574820c49ad028bce673821b16fa3c66c2f491639211eb","source_path":"character_system_text_dict.json","json_path":["1043","10021"],"entry_index":63,"target_text":"Hạng danh bạ tăng rồi! Hehe♪\r\nThành quả của thuộc hạ cũng là thành quả của đại ca!","reviewed":true},
    {"uid":"zhcn:54497cc472986b2a70718c67","kind":"character_system_text","source_text":"にししっ、ポッケがおっきいと\r\nいたずら道具も入れ放題なのだ！","source_fingerprint":"c3c722406d152580443300d427a2f890aa5d5248f0c5cb1cfa34aa83c19378ac","source_path":"character_system_text_dict.json","json_path":["1043","10025"],"entry_index":64,"target_text":"Nishishi, túi mà to thì\r\ntha hồ nhét đạo cụ nghịch phá vào!","reviewed":true},
    {"uid":"zhcn:45af203cd8392e8919164cb8","kind":"character_system_text","source_text":"白いと汚れが目立つからいいって\r\nお母さんが言ってたのだ！元気\r\nいっぱいで、ニコニコになるって！","source_fingerprint":"690a5e910494c707cf640facca291246fbb7037d9b5f79dff0969c0c885c51ea","source_path":"character_system_text_dict.json","json_path":["1043","10026"],"entry_index":65,"target_text":"Mẹ nói màu trắng tốt vì vết bẩn sẽ dễ thấy!\r\nNhìn vậy sẽ thấy Windy khỏe khoắn\r\nvà khiến mọi người cười tươi nữa!","reviewed":true},
    {"uid":"zhcn:da33834ebab94942d051d5ab","kind":"character_system_text","source_text":"今日も『肉厚ジューシーバーガー』\r\n食べに行くぞ！お前のおごりだと\r\n特に美味しいからな！へへっ。","source_fingerprint":"875e462c2f2c9648671090430a1c30671c78579229d633e70a4983483324a95d","source_path":"character_system_text_dict.json","json_path":["1043","10027"],"entry_index":66,"target_text":"Hôm nay lại đi ăn “Burger Dày Mọng Nước” nhé!\r\nBạn bao thì\r\nđặc biệt ngon hơn hẳn! Hehe.","reviewed":true},
    {"uid":"zhcn:4bcc23e9b6834204c4e2bfb7","kind":"character_system_text","source_text":"唔唔唔。","source_fingerprint":"a4d411669abf1d8a4eb549250647aa9fbb1430b3fa6f89f6f05e0ddc57926381","source_path":"character_system_text_dict.json","json_path":["1043","1003"],"entry_index":67,"target_text":"Ư ư ư.","reviewed":true},
    {"uid":"zhcn:7bfc8f45909dbd2258f976b9","kind":"character_system_text","source_text":"乖乖投降吧～！","source_fingerprint":"5b1ffde17737b55d7e43aaf02a1575f27ce18224ec7d5589f6cc1a1fdf9e2b6f","source_path":"character_system_text_dict.json","json_path":["1043","1004"],"entry_index":68,"target_text":"Ngoan ngoãn đầu hàng đi～!","reviewed":true},
    {"uid":"zhcn:15d9356aa7e0f08f223b45ac","kind":"character_system_text","source_text":"唔哇！！","source_fingerprint":"4506dd0d7bfa26ae7a66f0e6e3326dbcb7eac9950470ae3cad7d60a0d0a5d8f9","source_path":"character_system_text_dict.json","json_path":["1043","1005"],"entry_index":69,"target_text":"Uwaa!!","reviewed":true},
