  "entries": [
    {"uid":"zhcn:c3386502adf8f715fdc14b55","kind":"character_system_text","source_text":"以你的程度来说算是做得不错了喔。","source_fingerprint":"5a0f5c8b5184b4bf8a97684a45af32f92dee42eddda513f0d93919245f91e4b6","source_path":"character_system_text_dict.json","json_path":["1043","20049"],"entry_index":60,"target_text":"Xét trình độ của bạn thì làm khá tốt đấy.","reviewed":true},
    {"uid":"zhcn:f76c2a58c6eca3a4fde10ab1","kind":"character_system_text","source_text":"跑得还算开心啦！","source_fingerprint":"5adb1831e92451470583fd10f479c35e3a24b63dc470db160b223694450a48de","source_path":"character_system_text_dict.json","json_path":["1043","20050"],"entry_index":61,"target_text":"Chạy cũng khá vui đấy!","reviewed":true},
    {"uid":"zhcn:03dfa46b9228704ec8f6f3bb","kind":"character_system_text","source_text":"跟上风风我的脚步！","source_fingerprint":"4231f25f0ef215435c6aeefef45463e6f09278fb4a0d80e969fbcfe62e3f6178","source_path":"character_system_text_dict.json","json_path":["1043","20051"],"entry_index":62,"target_text":"Theo kịp bước chân của Windy đi!","reviewed":true},
    {"uid":"zhcn:a26fc410e88c027c44f453fa","kind":"character_system_text","source_text":"一口气向前咬！","source_fingerprint":"daf544a0feaa093887ac76c224c71b25778a97997c516210b64839e9149ba907","source_path":"character_system_text_dict.json","json_path":["1043","2030"],"entry_index":63,"target_text":"Cắn thẳng tới trước một mạch!","reviewed":true},
    {"uid":"zhcn:b310180dbacaf6600816017b","kind":"character_system_text","source_text":"手下们，上啊！","source_fingerprint":"39a82c038323f87273503ac1e44aa0af9cf3da920803b66bd719ed8b3f88db59","source_path":"character_system_text_dict.json","json_path":["1043","2031"],"entry_index":64,"target_text":"Các thuộc hạ, xông lên!","reviewed":true},
    {"uid":"zhcn:9effb560e35fdde54c8755ca","kind":"character_system_text","source_text":"跑得还算开心啦！","source_fingerprint":"5adb1831e92451470583fd10f479c35e3a24b63dc470db160b223694450a48de","source_path":"character_system_text_dict.json","json_path":["1043","2032"],"entry_index":65,"target_text":"Chạy cũng khá vui đấy!","reviewed":true},
    {"uid":"zhcn:9403f497f1cc6749315679fd","kind":"character_system_text","source_text":"哼，每个人的表情都不赖嘛！\r\n虽然还是完～全\r\n赢不过风风啦！","source_fingerprint":"6b4daa5aea5f75969b3a0529d502e7ec3e9e457a89e0ce7cb4de49eff1945e7a","source_path":"character_system_text_dict.json","json_path":["1043","2033"],"entry_index":66,"target_text":"Hừm, vẻ mặt ai cũng khá đấy!\r\nDù vẫn hoàn～toàn\r\nkhông thắng nổi Windy!","reviewed":true},
    {"uid":"zhcn:eeb20f77e227f329383c2382","kind":"character_system_text","source_text":"今天风风也要\r\n独占所有人的注意喔！","source_fingerprint":"49b9ad528a5a49635cd3c6066a44ee387aa50f6424ed04e6d90717427f95d04e","source_path":"character_system_text_dict.json","json_path":["1043","2034"],"entry_index":67,"target_text":"Hôm nay Windy cũng sẽ\r\nđộc chiếm mọi ánh nhìn!","reviewed":true},
    {"uid":"zhcn:a19ea8bcde64f11d7f878935","kind":"character_system_text","source_text":"跑得还算开心啦！","source_fingerprint":"5adb1831e92451470583fd10f479c35e3a24b63dc470db160b223694450a48de","source_path":"character_system_text_dict.json","json_path":["1043","2035"],"entry_index":68,"target_text":"Chạy cũng khá vui đấy!","reviewed":true},
    {"uid":"zhcn:3959b0bf6cab395f5a4db6cb","kind":"character_system_text","source_text":"やるのだ！","source_fingerprint":"ff6d5503acab0632f194ada06ce54a0d1fbb6a9f48c50e1acc6ecd4d931b2ff1","source_path":"character_system_text_dict.json","json_path":["1043","23015"],"entry_index":69,"target_text":"Làm thôi!","reviewed":true},
    {"uid":"zhcn:2df452c4216ba04f8ad7dc51","kind":"character_system_text","source_text":"下次要一口气得第一名喔！","source_fingerprint":"ca92404337cfbb6741da918fb6ad1cba5894bf69600bc6f367182ed87587564f","source_path":"character_system_text_dict.json","json_path":["1043","30000"],"entry_index":70,"target_text":"Lần sau phải một mạch giành hạng nhất nhé!","reviewed":true},
    {"uid":"zhcn:f4ebfd5d8a32bc34cacb8963","kind":"character_system_text","source_text":"把脖子洗干净等着吧～！！","source_fingerprint":"5d94da4eea17c1a1961d467091dc68d5e220cb87a55c2883860326e2fc029b75","source_path":"character_system_text_dict.json","json_path":["1043","30001"],"entry_index":71,"target_text":"Rửa cổ sạch rồi chờ đó đi～!!","reviewed":true},
    {"uid":"zhcn:cceb2b771de1a9172ed9f0e1","kind":"character_system_text","source_text":"也看向风风吧～！！","source_fingerprint":"dc65412f2dccb488aec9d49dd441fc485adb10fd6b21e5cf1736ea4d27147665","source_path":"character_system_text_dict.json","json_path":["1043","30002"],"entry_index":72,"target_text":"Nhìn sang Windy nữa đi～!!","reviewed":true},
    {"uid":"zhcn:12fc8c753597295a33c1e023","kind":"character_system_text","source_text":"我还想再来一次啦～！","source_fingerprint":"621704584edb0c1a5872606773aa2aaea3dc09e82d0cde784dab0176c3c2b91f","source_path":"character_system_text_dict.json","json_path":["1043","30003"],"entry_index":73,"target_text":"Windy còn muốn làm thêm lần nữa～!","reviewed":true},
    {"uid":"zhcn:fab88d0ae034794fa5543470","kind":"character_system_text","source_text":"下一个想被咬碎的……\r\n是谁啊？吼──！！","source_fingerprint":"f41ceeb27a61f230bdeeef1668d14ffbd2542788dbfc4b40ada3a8ddd6b3a2f4","source_path":"character_system_text_dict.json","json_path":["1043","30004"],"entry_index":74,"target_text":"Kẻ tiếp theo muốn bị cắn nát…\r\nlà ai nào? Gào──!!","reviewed":true},
    {"uid":"zhcn:daca93d7fc2c52eecb55ef3a","kind":"character_system_text","source_text":"看到了吗？看到了吧！风风赢了！","source_fingerprint":"63b1b8308054c206ed376c597a46d7752cd23f73eec6d1270f439a8e9d986d8b","source_path":"character_system_text_dict.json","json_path":["1043","30005"],"entry_index":75,"target_text":"Thấy chưa? Thấy rồi chứ! Windy thắng rồi!","reviewed":true},
    {"uid":"zhcn:33e959e3b01be62b65a21450","kind":"character_system_text","source_text":"在那里等着风风吧！","source_fingerprint":"9786e91ad823dbb6a47c420b84406c2b7f4c6db6adcd80976ad3d6b50c6b0827","source_path":"character_system_text_dict.json","json_path":["1043","31000"],"entry_index":76,"target_text":"Chờ Windy ở đó nhé!","reviewed":true},
    {"uid":"zhcn:a96cb9921a624cd8d98d0556","kind":"character_system_text","source_text":"吼吼吼吼……看风风大口咬！！","source_fingerprint":"3b31d4d342e530f28566aaabac8f80878be1b1c7a077aa86b29b2249cd0a33c2","source_path":"character_system_text_dict.json","json_path":["1043","40000"],"entry_index":77,"target_text":"Gừ gừ gừ gừ… xem Windy cắn một phát thật to đây!!","reviewed":true},
    {"uid":"zhcn:603222ecba1f7ff820a12938","kind":"character_system_text","source_text":"大家一起盖出一座\r\n用来崇拜风风的\r\n最强魔王城堡吧～！","source_fingerprint":"bc21a3c176c503680cc64cd4d85ac2967495cf9a1c522435a140b423fb030427","source_path":"character_system_text_dict.json","json_path":["1043","400000"],"entry_index":78,"target_text":"Mọi người cùng xây một\r\nlâu đài Ma Vương mạnh nhất\r\nđể tôn thờ Windy nào～!","reviewed":true},
    {"uid":"zhcn:d3fe4399c7d7b7487d4565b2","kind":"character_system_text","source_text":"居然能聚集到这么多仆人……\r\n太强了……太强了！","source_fingerprint":"71fdd63a9f8da4a7e0e8f66949977174543d996cadcbd1b4d572dd15ae5b46a7","source_path":"character_system_text_dict.json","json_path":["1043","400005"],"entry_index":79,"target_text":"Lại có thể tập hợp nhiều tôi tớ đến thế…\r\nMạnh quá… mạnh quá đi!","reviewed":true}
  ]
}
