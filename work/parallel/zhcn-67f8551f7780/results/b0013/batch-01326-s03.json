{
  "schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01326-s03","batch":1326,"shard":3,
  "source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":60,"shard_end_exclusive":80,"translated_count":15,
  "entries":[
    {"entry_index":60,"uid":"zhcn:d973355abf2977414cf819d9","kind":"character_system_text","source_text":"使い魔、なんかアドバイスある？\r\nどーしようもない意見だったら\r\n聞いてなんてあげないけど！","source_fingerprint":"65ab4f65348e6c843163b3bc0074a48b3dc94b4ce54f4a8c8926fb54efc6dfed","source_path":"character_system_text_dict.json","json_path":["1044","92021"],"target_text":"Sử ma, có lời khuyên gì không?\r\nNếu ý kiến vô dụng quá\r\nthì ta chẳng thèm nghe đâu!","reviewed":true},
    {"entry_index":61,"uid":"zhcn:8dc1f8c31870b65d638c06a3","kind":"character_system_text","source_text":"アンタはずっと、アタシに尽くし\r\nなさい！そしたら、アタシも――\r\nちょっとは、期待に応えてあげる！","source_fingerprint":"cbaa6ede9cfe54aca6ad4670355b5dfad15ecb10041736e5bd0fbc4524968f35","source_path":"character_system_text_dict.json","json_path":["1044","92022"],"target_text":"Ngươi cứ mãi tận tâm phục vụ ta đi!\r\nNếu vậy thì ta cũng――\r\nsẽ đáp lại kỳ vọng của ngươi một chút!","reviewed":true},
    {"entry_index":62,"uid":"zhcn:3b8505b6df98ad758dd5f7a7","kind":"character_system_text","source_text":"你变得可靠了呢。身为我的使魔，\r\n这是理所当然的事情！","source_fingerprint":"7b4701972c53c234883c6714dbc37c5c0f42d0d3baee60b17ff751c59605e802","source_path":"character_system_text_dict.json","json_path":["1044","93000"],"target_text":"Ngươi trở nên đáng tin cậy rồi đấy. Là sử ma của ta,\r\nđó là chuyện đương nhiên!","reviewed":true},
    {"entry_index":63,"uid":"zhcn:2f859b92ee5ba1f9ba7eb617","kind":"character_system_text","source_text":"你今后也要好好看Sweepy\r\n大显身手！知道了吗？","source_fingerprint":"6ee6c0083fb3da46d546e325a10924c602e68e67ba9582c31c4edf3e4f73b3d8","source_path":"character_system_text_dict.json","json_path":["1044","93001"],"target_text":"Từ giờ ngươi cũng phải nhìn cho kỹ\r\nSweepy đại triển thân thủ đấy! Biết chưa?","reviewed":true},
    {"entry_index":64,"uid":"zhcn:c6988d734fe45c4e735b4260","kind":"character_system_text","source_text":"これからもずっと、隣にいなさい！\r\nこれは命令だからねっ！","source_fingerprint":"1099baa1aba8309289636b8fafc5b394843914aa33b1e76375631983db3531e3","source_path":"character_system_text_dict.json","json_path":["1044","93004"],"target_text":"Từ giờ về sau cũng phải luôn ở bên cạnh ta!\r\nĐây là mệnh lệnh đấy!","reviewed":true},
    {"entry_index":65,"uid":"zhcn:1fbebfe021ea4fc946acb761","kind":"character_system_text","source_text":"アンタも、ちょっとは使い魔らしく\r\nなったんじゃない？ちょっとだけど！","source_fingerprint":"12babec7896ba4a9e3aab366a65da2dbe21e4d9d0f0099102a99f379d29b90cd","source_path":"character_system_text_dict.json","json_path":["1044","93005"],"target_text":"Ngươi cũng ra dáng sử ma\r\nhơn một chút rồi nhỉ? Chỉ một chút thôi!","reviewed":true},
    {"entry_index":66,"uid":"zhcn:95f8cbd880af79a94827b746","kind":"character_system_text","source_text":"感觉魔力提升了！","source_fingerprint":"7bd2f8d453cd24cf19a5cd5e3efc82538a85708151372e4b700d88368731385d","source_path":"character_system_text_dict.json","json_path":["1044","95000"],"target_text":"Cảm giác ma lực tăng lên rồi!","reviewed":true},
    {"entry_index":67,"uid":"zhcn:f71501833a2b09e985130c80","kind":"character_system_text","source_text":"究极魔法・花朵盛开！\r\n绽放吧，天赋！","source_fingerprint":"0a610b082ace3f6cb38c8a617a67894ff71b16b40c6966da303439b041256f4d","source_path":"character_system_text_dict.json","json_path":["1044","95001"],"target_text":"Cực hạn ma pháp・Hoa nở rộ!\r\nHãy bung nở đi, thiên phú!","reviewed":true},
    {"entry_index":68,"uid":"zhcn:6a7137bcab18d3d67e2fccc2","kind":"character_system_text","source_text":"我是天才魔法少女东商变革！","source_fingerprint":"ea1fd5a03efabf6d35e863dc44b67e9b9ae8966155aeab4e321d0d740edd01d9","source_path":"character_system_text_dict.json","json_path":["1044","95003"],"target_text":"Ta là thiên tài ma pháp thiếu nữ Sweep Tosho!","reviewed":true},
    {"entry_index":69,"uid":"zhcn:4ad7c58f6293a463ad90db24","kind":"character_system_text","source_text":"一闪一闪・亮晶晶☆\r\n我会让你见识到厉害的魔法！","source_fingerprint":"90b79d048f9b0789d01411bdf11682745f87ab10816fcffff4b2fbe2e5bfa2b3","source_path":"character_system_text_dict.json","json_path":["1044","95004"],"target_text":"Lấp lánh・lung linh☆\r\nTa sẽ cho ngươi thấy ma pháp lợi hại!","reviewed":true},
    {"entry_index":70,"uid":"zhcn:a705997b92cee9286a10ef18","kind":"character_system_text","source_text":"辅助魔法就交给我吧。","source_fingerprint":"ebc470815415f5637dc78f34445d699e8eb1784b48e32bbfce3655c42cb86753","source_path":"character_system_text_dict.json","json_path":["1044","95005"],"target_text":"Cứ giao ma pháp hỗ trợ cho ta.","reviewed":true},
    {"entry_index":71,"uid":"zhcn:1352407f2e0830a4da6e44f4","kind":"character_system_text","source_text":"看来是时候使用秘术了！","source_fingerprint":"109c18b8596a37ceed913b8a8eaf5f17eb60017a9b711c572bcf700aec4e92df","source_path":"character_system_text_dict.json","json_path":["1044","95006"],"target_text":"Xem ra đến lúc dùng bí thuật rồi!","reviewed":true},
    {"entry_index":72,"uid":"zhcn:b2e81fa4ca7823971e98b33c","kind":"character_system_text","source_text":"成長したアタシに、祝福の鐘を鳴らしなさい！","source_fingerprint":"89fe02dc0eca4d377e606836f0626f19eb50fa70856f2a4493cd168b151014e5","source_path":"character_system_text_dict.json","json_path":["1044","95007"],"target_text":"Hãy rung chuông chúc phúc cho ta đã trưởng thành đi!","reviewed":true},
    {"entry_index":73,"uid":"zhcn:0ea001346ac45d14596b9b74","kind":"character_system_text","source_text":"魔女としての、新たな門出ね！","source_fingerprint":"ffd358c58f5d54b0899dce870b4231148695d43d5352bafbc0237325366c5bee","source_path":"character_system_text_dict.json","json_path":["1044","95008"],"target_text":"Một khởi đầu mới trên con đường phù thủy nhỉ!","reviewed":true},
    {"entry_index":74,"uid":"zhcn:6b000114a475945dab73e05c","kind":"character_system_text","source_text":"ほら！さっさとエスコートして！\r\n特別な魔法、見つけに行くわよ！","source_fingerprint":"ab88b055ab290ac1844d2a5252897e88ca7132bbf77ae49be1065132e048783b","source_path":"character_system_text_dict.json","json_path":["1044","95009"],"target_text":"Nào! Mau hộ tống ta đi!\r\nTa đi tìm ma pháp đặc biệt đây!","reviewed":true}
  ]
}
