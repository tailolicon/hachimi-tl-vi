    {"entry_index":55,"uid":"zhcn:6f1159a49417968ec7bd910f","kind":"character_system_text","source_text":"Cygames","source_fingerprint":"70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb","source_path":"character_system_text_dict.json","json_path":["1048","11"],"target_text":"Cygames","reviewed":true},
    {"entry_index":56,"uid":"zhcn:84acfd0bbc83576c22f4826d","kind":"character_system_text","source_text":"做好美甲了──\r\n要进行训练对吧？\r\n随时都没问题──","source_fingerprint":"c2263d821a1956df5eb612504428f41be8e89a53dfcb941b589fe73699363c2a","source_path":"character_system_text_dict.json","json_path":["1048","110000"],"target_text":"Làm móng xong rồi──\r\nGiờ tập luyện đúng không?\r\nLúc nào cũng được──","reviewed":true},
    {"entry_index":57,"uid":"zhcn:0f22be3fe9b276a3b508753b","kind":"character_system_text","source_text":"总觉得──\r\n大家都很认真。\r\n……就有种我也可以的感觉？","source_fingerprint":"001c34bb39620296e49c4b3002b92d81e784eee8458def3c4aa3025564e7b984","source_path":"character_system_text_dict.json","json_path":["1048","110001"],"target_text":"Cứ có cảm giác──\r\nmọi người đều rất nghiêm túc.\r\n……Thế nên tôi cũng thấy mình làm được chăng?","reviewed":true},
    {"entry_index":58,"uid":"zhcn:97e1b85e457fd8907adbcd93","kind":"character_system_text","source_text":"在这里报名参加竞赛，\r\n多指教咯～","source_fingerprint":"846fd4b4e91370f7325b8fb125578d57dc0f47beb881cce5e304984a1e6f3338","source_path":"character_system_text_dict.json","json_path":["1048","110002"],"target_text":"Đăng ký đua ở đây nhé,\r\nnhờ bạn cả đó～","reviewed":true},
