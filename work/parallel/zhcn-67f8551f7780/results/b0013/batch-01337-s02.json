    {"entry_index":51,"uid":"zhcn:98065707d8f935753697457d","kind":"character_system_text","source_text":"新纪录不得了耶！","source_fingerprint":"c933714ea471060861cbf2c0b199c14f743421d221857f36c557b63ed31a346b","source_path":"character_system_text_dict.json","json_path":["1048","1007"],"target_text":"Kỷ lục mới, ghê thật!","reviewed":true},
    {"entry_index":52,"uid":"zhcn:7bff8d481865ed3260b78e16","kind":"character_system_text","source_text":"那就走吧──","source_fingerprint":"5f81e39296bc88cca7284f5b6835c687d1b8f728a1c0daa0aceecedecc1b5344","source_path":"character_system_text_dict.json","json_path":["1048","1008"],"target_text":"Vậy đi thôi──","reviewed":true},
    {"entry_index":53,"uid":"zhcn:85b53167ac998a91abdf4ede","kind":"character_system_text","source_text":"惊人的气势……","source_fingerprint":"0c09717d25db97ac0aa7add58793c5c0196df30c3253f2ef4fcda1acc5061ce1","source_path":"character_system_text_dict.json","json_path":["1048","1076"],"target_text":"Khí thế ghê gớm thật……","reviewed":true},
