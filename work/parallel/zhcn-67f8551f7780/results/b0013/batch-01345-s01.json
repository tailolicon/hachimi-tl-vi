  "entries": [
    {
      "entry_index": 20,
      "uid": "zhcn:ef1f734c328ace1610455de1",
      "kind": "character_system_text",
      "source_text": "過ごしやすい季節になると、どこも\r\n人が多くなってさ…。お気に入りの\r\nスポット、また探さないとじゃん。",
      "source_fingerprint": "20ab8b26b0df0aaf9ab7bab1feb591f73b2e7875d64d9e13abb92c050429d750",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1050", "90216"],
      "target_text": "Cứ đến mùa dễ chịu là đâu đâu cũng\r\nđông nghịt người… Lại phải đi tìm\r\nmột chỗ ruột mới thôi.",
      "reviewed": true
    },
    {
      "entry_index": 21,
      "uid": "zhcn:2b0cd4d7b5d7d55c7df2d1a2",
      "kind": "character_system_text",
      "source_text": "暑っ…。チケットが押しつけてきた\r\nアイス、ハヤヒデにあげるんじゃ\r\nなかった…。",
      "source_fingerprint": "d118cedc09046f510497b82b184ce5ca094179359a1cc118601edb490382fccb",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1050", "90217"],
      "target_text": "Nóng quá… Biết thế đừng đưa cây kem\r\nTicket dúi cho mình sang Hayahide\r\nmới phải…",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:a283f369d92274060b2ec511",
      "kind": "character_system_text",
      "source_text": "落ち葉焚きと甘い香り…焼き芋大会\r\nでもしてんのかな？人多そうだから\r\n絶対行かないけど。",
      "source_fingerprint": "a20bbbfee9be8ff027f5ca4556e579d6c3474e4782b5bea1bbf380f0ab00c114",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1050", "90218"],
      "target_text": "Mùi lá khô cháy với mùi thơm ngọt… Có khi\r\nđang mở hội khoai nướng? Chắc đông người lắm,\r\nnên tôi tuyệt đối không đi đâu.",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:4003d3e7079a2677087d1670",
      "kind": "character_system_text",
      "source_text": "そと寒っ…。走って体温めるか、\r\n部屋でぬくぬくゲームするか…\r\n迷うな…。",
      "source_fingerprint": "0070b6f816f0b98aa53d5b22ea00a977d3bc721a585cd0b68d9ee4df293da026",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1050", "90219"],
      "target_text": "Ngoài trời lạnh thật… Chạy cho ấm người,\r\nhay cuộn mình trong phòng chơi game đây…\r\nKhó chọn ghê…",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:20a164db9a992b095c60a1c1",
      "kind": "character_system_text",
      "source_text": "……ハッピーバレンタイン",
      "source_fingerprint": "cff507df3f646d0da7f5a74b8941cfabdf2b60e4bee9f62f0d62dd0b69cea0b7",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1050", "90221"],
      "target_text": "……Valentine vui vẻ.",
      "reviewed": true
    }
  ]
