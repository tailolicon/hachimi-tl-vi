  "entries": [
    {"entry_index":40,"uid":"zhcn:e421a6e7d97b53feb3d6d65c","kind":"character_system_text","source_text":"接下来要去哪儿？\r\n记得一定要先制定好计划哦。","source_fingerprint":"91c4c010dcffdfc7090dd3f8c156aa6fdc5b60e0f5b84f2fd2be240ef8629951","source_path":"character_system_text_dict.json","json_path":["1059","71017"],"target_text":"Tiếp theo sẽ đi đâu đây?\r\nNhớ là nhất định phải lên kế hoạch trước nhé.","reviewed":true},
    {"entry_index":41,"uid":"zhcn:e225b5069da6843c704a4147","kind":"character_system_text","source_text":"……～嘁！","source_fingerprint":"20b9843d1c8543eb3e90e50676fb30df20623535c47ae6d8d27d1e0f99b4f4c7","source_path":"character_system_text_dict.json","json_path":["1059","71018"],"target_text":"……Chậc!","reviewed":true},
    {"entry_index":42,"uid":"zhcn:88ecbe43497d24953f212f87","kind":"character_system_text","source_text":"如预想那般地奔跑了……！","source_fingerprint":"f045b7f00c6991110ead2a4e428725e02c1716cca22993746234f40d3eb9a98e","source_path":"character_system_text_dict.json","json_path":["1059","71019"],"target_text":"Mình đã chạy đúng như dự tính……!","reviewed":true},
    {"entry_index":43,"uid":"zhcn:2f0381bd430d2fc21670d481","kind":"character_system_text","source_text":"お疲れ様","source_fingerprint":"b953841c6237f6f93550f5268f577fd573201293558ed014b9eb53c636e0c0c4","source_path":"character_system_text_dict.json","json_path":["1059","80000"],"target_text":"Vất vả rồi.","reviewed":true},
    {"entry_index":44,"uid":"zhcn:bebab86a9a6d43d1d2080e64","kind":"character_system_text","source_text":"和我一决胜负？\r\n……嗯，我明白了。\r\n我会全力以赴的哦！","source_fingerprint":"1962109929863bb1274839e20b5b0aa85b593fcf5b74245c7a9df07cd9b7b6cc","source_path":"character_system_text_dict.json","json_path":["1059","81000"],"target_text":"Muốn phân thắng bại với tôi sao?\r\n……Ừm, tôi hiểu rồi.\r\nTôi sẽ dốc hết sức!","reviewed":true},
    {"entry_index":45,"uid":"zhcn:4069615e082153c81c85013d","kind":"character_system_text","source_text":"好厉害……不过，\r\n我也还能变得更强的！\r\n可别擅自对我失望啊！","source_fingerprint":"86055865cadcab573d011d868a7795af45ea69300e53d821fb8790e5c8fd22e9","source_path":"character_system_text_dict.json","json_path":["1059","81001"],"target_text":"Ghê thật…… Nhưng\r\ntôi vẫn có thể mạnh hơn nữa!\r\nĐừng tự tiện thất vọng về tôi đấy!","reviewed":true},
    {"entry_index":46,"uid":"zhcn:18f9c0e7acf36670efa3a4c9","kind":"character_system_text","source_text":"早啊……诶，怎么了？\r\n不就跟你打了个招呼吗，\r\n别这么死盯着我看。","source_fingerprint":"8dc9f60328d72b6557b6e96dc4c78553c143fe7200e0b8b4a914c237dbc8a478","source_path":"character_system_text_dict.json","json_path":["1059","90000"],"target_text":"Chào buổi sáng…… Hả, sao vậy?\r\nTôi chỉ chào cậu thôi mà,\r\nđừng nhìn tôi chằm chằm như thế.","reviewed":true},
    {"entry_index":47,"uid":"zhcn:ec4cfda1a64e77e266a5ffeb","kind":"character_system_text","source_text":"从早上开始就保持优雅……真难啊。\r\n困得止不住地发呆……\r\n麦昆可真厉害啊……","source_fingerprint":"4525a67e3fc8cfad5cee3bb9fa67cae1bb0e430afdd46b440074c593fc411ce2","source_path":"character_system_text_dict.json","json_path":["1059","90001"],"target_text":"Giữ vẻ tao nhã từ sáng sớm…… khó thật.\r\nBuồn ngủ đến mức cứ ngẩn ra……\r\nMejiro McQueen đúng là giỏi thật……","reviewed":true},
    {"entry_index":48,"uid":"zhcn:5a27b91453737c8ff8de78e5","kind":"character_system_text","source_text":"休息日去吃午饭的时候，\r\n看见大家都穿着非常可爱的衣服……\r\n我可没法穿那种衣服啊。","source_fingerprint":"f057f7992bf2cb8459a7bcdc93985322f1c6b8fa765223e26f992e96627c9545","source_path":"character_system_text_dict.json","json_path":["1059","90002"],"target_text":"Hôm nghỉ đi ăn trưa,\r\ntôi thấy mọi người mặc toàn đồ rất dễ thương……\r\nTôi thì chẳng thể mặc kiểu đó được.","reviewed":true},
    {"entry_index":49,"uid":"zhcn:343bc5fcd245bf2b322afe9a","kind":"character_system_text","source_text":"要用午休时间来训练一会儿吗……？\r\n……我才没有在勉强自己了。","source_fingerprint":"d9ee5fe4b5bef5e32efcff110f5de60f66f00eb7eeface3d19fb46d64aeea55d","source_path":"character_system_text_dict.json","json_path":["1059","90003"],"target_text":"Hay tranh thủ giờ nghỉ trưa tập một chút nhỉ……?\r\n……Tôi đâu có cố quá sức.","reviewed":true}
  ]
}
