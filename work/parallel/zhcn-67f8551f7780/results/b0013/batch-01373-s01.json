    {"entry_index":30,"uid":"zhcn:7ff29d8fc270972756949063","kind":"character_system_text","source_text":"祝贺！评分更新♪","source_fingerprint":"aa795251b2d6a4af47d6315604f6ce8af8ade6ff32e31e8b626370d5d2b87a1e","source_path":"character_system_text_dict.json","json_path":["1060","1007"],"target_text":"Chúc mừng! Điểm đánh giá đã được cập nhật♪","reviewed":true},
    {"entry_index":31,"uid":"zhcn:dd74783529969c6db0b81eb3","kind":"character_system_text","source_text":"慢慢地，出发吧！","source_fingerprint":"9fb8a181bf936411134ba83d13b8d5ddca0ec3defecaa13ce6866b8983df2c2e","source_path":"character_system_text_dict.json","json_path":["1060","1008"],"target_text":"Cứ thong thả, xuất phát nào!","reviewed":true},
