    {"entry_index":33,"uid":"zhcn:cf0c6d833d6ab5b205a03519","kind":"character_system_text","source_text":"哟，要训练吗？\n要工作呢～。","source_fingerprint":"24dc0f43bdcd3908e9ffb0173cf07f7192b505f451c02310a21422be681e1d9a","source_path":"character_system_text_dict.json","json_path":["1060","110000"],"target_text":"Ồ, định Training à?\nLại phải làm việc rồi～.","reviewed":true},
