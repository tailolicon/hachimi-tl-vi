  "entries": [
    {"entry_index":60,"uid":"zhcn:b5873f9e99ceb0ab726da60f","kind":"character_system_text","source_text":"嘿！","source_fingerprint":"4f80298f6ad3f06504d125a4a500b2c955c83c5f325b006c292424d190c097f2","source_path":"character_system_text_dict.json","json_path":["1060","140016"],"target_text":"Hây!","reviewed":true},
    {"entry_index":61,"uid":"zhcn:2db496c29d59ecd666f7c22a","kind":"character_system_text","source_text":"啊～…","source_fingerprint":"4b404a10ad661cbd1e5c6a66fd2cda12a03e9c93a4a10378d4306d531fcf769c","source_path":"character_system_text_dict.json","json_path":["1060","140017"],"target_text":"Aah～…","reviewed":true},
    {"entry_index":62,"uid":"zhcn:42f6221b6749b55427767c1a","kind":"character_system_text","source_text":"这可真糟糕…","source_fingerprint":"f3dfa7c11e5728b823764d21315e95c0a3849ad50446e3f6cea4204ae6d71ee5","source_path":"character_system_text_dict.json","json_path":["1060","140018"],"target_text":"Thế này thì tệ thật…","reviewed":true},
    {"entry_index":63,"uid":"zhcn:486c96c3af6f0ef3669fcb62","kind":"character_system_text","source_text":"明天好像能拿到这个。","source_fingerprint":"05455df9a61eff2f59cb5dc2bf0840682d0169c42988968da22137fe1da487b1","source_path":"character_system_text_dict.json","json_path":["1060","15"],"target_text":"Hình như mai sẽ nhận được cái này.","reviewed":true},
    {"entry_index":64,"uid":"zhcn:f0dd06da0657c6f84ef6c50c","kind":"character_system_text","source_text":"呼…可能已经累了。","source_fingerprint":"bdea8981065f871c14c1e17c6df427faf311a43d4ceeee8719e55b2754205942","source_path":"character_system_text_dict.json","json_path":["1060","20000"],"target_text":"Phù… chắc là mệt rồi.","reviewed":true},
    {"entry_index":65,"uid":"zhcn:f93cd851e5861a94bb41fe39","kind":"character_system_text","source_text":"哈啊…今天可不要发呆…\n不像样子，要努力啊。","source_fingerprint":"4ff42d47c950fcf6a835659edbd2d3d4bb840aa102246bd9acbf98389cc63837","source_path":"character_system_text_dict.json","json_path":["1060","20001"],"target_text":"Haah… hôm nay không được lơ đãng…\nThế này không ổn, phải cố lên thôi.","reviewed":true},
    {"entry_index":66,"uid":"zhcn:8cddbe140b2ca2d773a7f0d4","kind":"character_system_text","source_text":"哟，要开整吗！\n…啊…抱歉，还是忘了刚才的话吧。\n干劲充足过头了。好羞。","source_fingerprint":"020e8252c3c87cca54f482c53fb2849f56948a2ac15f3e32eeaa60d4670cd501","source_path":"character_system_text_dict.json","json_path":["1060","20002"],"target_text":"Nào, bắt đầu thôi!\n…À… xin lỗi, quên câu vừa rồi đi nhé.\nHăng quá mức mất rồi. Ngượng thật.","reviewed":true},
    {"entry_index":67,"uid":"zhcn:a0243ddedef937ff53577a1b","kind":"character_system_text","source_text":"呵呵，也许可以\n去比较好的地方呢？","source_fingerprint":"dc0f4b8f8d0be9ea7d58510154e6d582e473c2d11ec3fdfd994b349522e82bde","source_path":"character_system_text_dict.json","json_path":["1060","20003"],"target_text":"Hehe, biết đâu hôm nay\nmình có thể tiến tới một nơi tốt đẹp hơn nhỉ?","reviewed":true},
    {"entry_index":68,"uid":"zhcn:3dcb99fdb5edd5a79b87bbb7","kind":"character_system_text","source_text":"脚步好像有点轻快？\n是说状态很好吗。\n…可能是心理作用吧。","source_fingerprint":"20ab6321a90308f7f3d77b9fb4634fb39d781fb572f23db28f9bd97bce1543ff","source_path":"character_system_text_dict.json","json_path":["1060","20004"],"target_text":"Bước chân có vẻ nhẹ hơn nhỉ?\nÝ là tình trạng đang rất tốt sao.\n…Chắc chỉ là cảm giác thôi.","reviewed":true},
    {"entry_index":69,"uid":"zhcn:0edf170517b570d94cf736e9","kind":"character_system_text","source_text":"好的好的。是非常\n精神的内恰哦。\n今天的训练内容是什么呢～？","source_fingerprint":"1b35ca3d1772629d75b7ec15fefc29b8d8f288e8c0e0e7208e81d55ca2fad9e0","source_path":"character_system_text_dict.json","json_path":["1060","20005"],"target_text":"Rồi rồi. Nice Nature hôm nay\nsung sức lắm đây.\nNội dung Training hôm nay là gì nhỉ～?","reviewed":true},
    {"entry_index":70,"uid":"zhcn:4ca2c6d110486ab8a87155c0","kind":"character_system_text","source_text":"那么那么。\n今天也要\n好好的加油啊。","source_fingerprint":"c8d75c59f4f03cf31ae62c9019cb95e69963410b3a310ec525096d2beb2a3223","source_path":"character_system_text_dict.json","json_path":["1060","20006"],"target_text":"Nào nào.\nHôm nay cũng phải\ncố gắng cho thật tốt nhé.","reviewed":true},
    {"entry_index":71,"uid":"zhcn:61da24a359ad692941b785ae","kind":"character_system_text","source_text":"好的，什么时候开始？","source_fingerprint":"8a247c9d8aab52eb67223ceec65746c94940163c841998e796ba6f3e96f08d10","source_path":"character_system_text_dict.json","json_path":["1060","20007"],"target_text":"Rồi, khi nào bắt đầu?","reviewed":true},
    {"entry_index":72,"uid":"zhcn:c912ed46bcc0d3185c2c0ba0","kind":"character_system_text","source_text":"嗯ー…\n干劲，是不是掉到哪里去了呢。","source_fingerprint":"6fe60861f5e515a25e4b5e04ea03928f6ff2c795658340be59c7ea4f3a00f570","source_path":"character_system_text_dict.json","json_path":["1060","20008"],"target_text":"Ừmー…\nTinh thần của mình rơi đâu mất rồi nhỉ.","reviewed":true},
    {"entry_index":73,"uid":"zhcn:79a3a30481a2c947d39f99b2","kind":"character_system_text","source_text":"哈啊…为什么。\n不知不觉的，已经…没有力气了…","source_fingerprint":"95abd63419d0eea400015eee45ddc40f6e7127e33ac491f03908145d4fea2b94","source_path":"character_system_text_dict.json","json_path":["1060","20009"],"target_text":"Haah… tại sao chứ.\nChẳng biết từ lúc nào mà… hết sức mất rồi…","reviewed":true},
    {"entry_index":74,"uid":"zhcn:763c016c9f3b6f7bccbc1340","kind":"character_system_text","source_text":"啊ー！不行！\n只能想到最坏的结果。\n…必须冷静。","source_fingerprint":"d3159297e58e5e68994d327a674aa818ecfcae73d197c0ca7ec6dead6caa1a1f","source_path":"character_system_text_dict.json","json_path":["1060","20010"],"target_text":"Aー! Không được!\nChỉ nghĩ tới kết quả tệ nhất thôi.\n…Phải bình tĩnh lại.","reviewed":true},
    {"entry_index":75,"uid":"zhcn:ec70e13f5581f5d5c2e78b82","kind":"character_system_text","source_text":"呜，状态好差。\n明明是该坚持的时候ー…","source_fingerprint":"1fda8a8248259aa155429bc486a66ea6a592857e4833a38427c78a03863be66c","source_path":"character_system_text_dict.json","json_path":["1060","20011"],"target_text":"Ưu, tình trạng tệ quá.\nĐúng lúc cần phải cố gắng thế nàyー…","reviewed":true},
    {"entry_index":76,"uid":"zhcn:d527232c241258e2d8481e96","kind":"character_system_text","source_text":"诶，又要比赛？…没关系吗。\n希望不会影响到身体状况。","source_fingerprint":"bb5d3bfa76f7e88c5dec3dffe12ecae8b58a989ae022d1a8e68bbe942750a0ea","source_path":"character_system_text_dict.json","json_path":["1060","20021"],"target_text":"Hả, lại đua nữa à? …Có ổn không vậy.\nMong là không ảnh hưởng đến thể trạng.","reviewed":true},
    {"entry_index":77,"uid":"zhcn:ecee023953e20da606d56737","kind":"character_system_text","source_text":"比赛果然还是太多了吧？\n为了保持状态良好。\n差不多也休息一下吧。","source_fingerprint":"f400a54413069034caa4878acbdb99c7008d91df90edb59d3ed30685af5b1ad9","source_path":"character_system_text_dict.json","json_path":["1060","20022"],"target_text":"Đua nhiều quá rồi phải không?\nMuốn giữ tình trạng tốt thì\ncũng nên nghỉ một chút thôi.","reviewed":true},
    {"entry_index":78,"uid":"zhcn:9986f1fcb5b5673ecdf9a9cd","kind":"character_system_text","source_text":"哈啊～、这个时候终于来了呢。\n状态…嘛，还行吧。嗯。\n说不定…之类的呢，啊哈哈。","source_fingerprint":"936b6ca696b74dd20459bfcf4d505e0d0a75c794c810f3b6b503e7e11fa5fd21","source_path":"character_system_text_dict.json","json_path":["1060","20023"],"target_text":"Haah～, cuối cùng cũng tới lúc này rồi nhỉ.\nTình trạng… chà, cũng tạm ổn. Ừm.\nBiết đâu… đại loại thế, ahaha.","reviewed":true},
    {"entry_index":79,"uid":"zhcn:2483019aeac8031484508a6f","kind":"character_system_text","source_text":"努力得也差不多了，\n胜算…我想应该有。\n…不如说，我想有啊！","source_fingerprint":"5ca20d3a37396c54ec28b636210c56ad778c3d9779864ea93f0bd84175688484","source_path":"character_system_text_dict.json","json_path":["1060","20024"],"target_text":"Cũng đã cố gắng đủ nhiều rồi,\ncơ hội thắng… chắc là có.\n…Không, phải nói là tôi muốn có chứ!","reviewed":true}
  ]
}
