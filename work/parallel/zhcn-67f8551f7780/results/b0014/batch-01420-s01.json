    {"entry_index":21,"uid":"zhcn:beb275d01f835c16747d3228","kind":"character_system_text","source_text":"是！","source_fingerprint":"92c7c80d421e17e0e64227dc915153ae460be7213ab0bfafd9026602c2e67892","source_path":"character_system_text_dict.json","json_path":["1076","140009"],"target_text":"Vâng!","reviewed":true},
    {"entry_index":22,"uid":"zhcn:300e2baf212828e5ff3d5e24","kind":"character_system_text","source_text":"怎么了吗？","source_fingerprint":"eb75f8d097324489df9101b9fb1301ac4112567bf0af3df0f690cd98a27eee1c","source_path":"character_system_text_dict.json","json_path":["1076","140010"],"target_text":"Có chuyện gì sao?","reviewed":true},
    {"entry_index":23,"uid":"zhcn:74c019310f408e9d84eda663","kind":"character_system_text","source_text":"好可爱～！","source_fingerprint":"e614ffdcfee91a68e059e8df06098005a2d03de8e1b7d6894167797235ee738e","source_path":"character_system_text_dict.json","json_path":["1076","140011"],"target_text":"Dễ thương quá~!","reviewed":true},
    {"entry_index":24,"uid":"zhcn:d9c7a4bf086da51c8d6f9a57","kind":"character_system_text","source_text":"一定没问题！","source_fingerprint":"4915407d947edd118e7312e62409ff8f114e3664b41ab5ba4a2640e6f08f549a","source_path":"character_system_text_dict.json","json_path":["1076","140012"],"target_text":"Nhất định sẽ ổn thôi!","reviewed":true},
    {"entry_index":25,"uid":"zhcn:6b9d2d2b026571d7c3eac065","kind":"character_system_text","source_text":"就这样夹过来……！","source_fingerprint":"c33b284eaafb64af774196fdcd8f4ee1991e40d0b563d8f6f17d586dccabc89a","source_path":"character_system_text_dict.json","json_path":["1076","140013"],"target_text":"Cứ thế gắp qua đây…!","reviewed":true},
    {"entry_index":26,"uid":"zhcn:646982640473d6e0b777c7ed","kind":"character_system_text","source_text":"哎呀呀……","source_fingerprint":"ff2fc41fc2a37ee08441f40c67d9ba7a9c82aa96fa79524ef44330e764709db9","source_path":"character_system_text_dict.json","json_path":["1076","140014"],"target_text":"Ôi chà…","reviewed":true},
    {"entry_index":27,"uid":"zhcn:f769e394ad527e7b8d740367","kind":"character_system_text","source_text":"嗯……","source_fingerprint":"a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a","source_path":"character_system_text_dict.json","json_path":["1076","140015"],"target_text":"Ừm…","reviewed":true},
    {"entry_index":28,"uid":"zhcn:1d19d5230724d6eed6ef70c6","kind":"character_system_text","source_text":"你在想事情吗？","source_fingerprint":"63efe8a243578e32393eb15ccfafba6edd2d58531270aefbe5fe6c63e14408d4","source_path":"character_system_text_dict.json","json_path":["1076","140016"],"target_text":"Cậu đang suy nghĩ gì sao?","reviewed":true},
    {"entry_index":29,"uid":"zhcn:9219cfbfddcc2f14a6b3efc1","kind":"character_system_text","source_text":"啊……！","source_fingerprint":"8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6","source_path":"character_system_text_dict.json","json_path":["1076","140017"],"target_text":"A…!","reviewed":true},
    {"entry_index":30,"uid":"zhcn:323ba4bcd69b1eae2973c819","kind":"character_system_text","source_text":"唔嗯……","source_fingerprint":"34ca3bd0ae861985f839122e2ffd1c1bb718fb26f6a34a4612ecf4d5126977f4","source_path":"character_system_text_dict.json","json_path":["1076","140018"],"target_text":"Ưm…","reviewed":true},
    {"entry_index":31,"uid":"zhcn:33cba950c0d159f871483384","kind":"character_system_text","source_text":"明天我会准备这个奖励喔♪","source_fingerprint":"392e2f946991d42844945a4d78f6fb74e1af17b3014ebe55f68b4eec25dd0a16","source_path":"character_system_text_dict.json","json_path":["1076","15"],"target_text":"Ngày mai tôi sẽ chuẩn bị phần thưởng này nhé♪","reviewed":true},
    {"entry_index":32,"uid":"zhcn:c9d9dde47a36aad2ccff0cfc","kind":"character_system_text","source_text":"现在得休息才行……\r\n为了不失去梦想……","source_fingerprint":"4523c2c9171fe3b55d39ac6cc7e0c3e6d3726777ac111d4f40ab69a1834d98ba","source_path":"character_system_text_dict.json","json_path":["1076","20000"],"target_text":"Bây giờ phải nghỉ ngơi thôi…\r\nĐể không đánh mất ước mơ…","reviewed":true},
    {"entry_index":33,"uid":"zhcn:d0f6b57a4660a8343c3e0d17","kind":"character_system_text","source_text":"我明白有备无患也是\r\n不可或缺的一环……\r\n而现在不正是该做准备之时吗？","source_fingerprint":"db74ae639c3b72cf2bd71372258b5ffaeadc8deee6ff0a2dd4d30b39c372fb54","source_path":"character_system_text_dict.json","json_path":["1076","20001"],"target_text":"Tôi hiểu rằng chuẩn bị trước để phòng bất trắc cũng\r\nlà một phần không thể thiếu…\r\nVà chẳng phải bây giờ chính là lúc nên chuẩn bị sao?","reviewed":true},
    {"entry_index":34,"uid":"zhcn:a69a8e0335af38b85473ed75","kind":"character_system_text","source_text":"我现在超想跑步的！\r\n想要一直跑一直跑，\r\n跑到很远的地方去！","source_fingerprint":"b118823f70dcd60bb1b4e6065c43afef2e0683998c77bb77aab018626ac24a1c","source_path":"character_system_text_dict.json","json_path":["1076","20002"],"target_text":"Giờ tôi muốn chạy lắm rồi!\r\nMuốn chạy mãi, chạy mãi,\r\nđến một nơi thật xa!","reviewed":true},
    {"entry_index":35,"uid":"zhcn:866c6264481086b94db07050","kind":"character_system_text","source_text":"我现在是最佳状态！\r\n来来来，不管今天的训练项目\r\n是什么，都尽管说吧♪","source_fingerprint":"d4477e749332f4065a7957f0523873f2564d258d22cca5b521edc0254fed92ac","source_path":"character_system_text_dict.json","json_path":["1076","20003"],"target_text":"Bây giờ tôi đang ở trạng thái tốt nhất!\r\nNào nào, hôm nay huấn luyện gì\r\ncứ nói với tôi đi♪","reviewed":true},
    {"entry_index":36,"uid":"zhcn:ac0f61f53587bdf60a517604","kind":"character_system_text","source_text":"照这个状况来看──我甚至能\r\n追上她，并且超越她……！","source_fingerprint":"d0b1e1e54e6a7245872a2e3d0ea00f2744cec05bb4da0e872ba899c7165c996e","source_path":"character_system_text_dict.json","json_path":["1076","20004"],"target_text":"Với trạng thái này──tôi thậm chí có thể\r\nđuổi kịp cô ấy, rồi vượt qua cô ấy…!","reviewed":true},
    {"entry_index":37,"uid":"zhcn:d665df9e49075e30a34a99f6","kind":"character_system_text","source_text":"今天就来彻底训练吧！\r\n能训练时，\r\n就得全力投入才行！","source_fingerprint":"5652016b9abba6b82a3833cd41a47fd2d73d5589c1577730addf464feb525fb7","source_path":"character_system_text_dict.json","json_path":["1076","20005"],"target_text":"Hôm nay hãy tập luyện thật triệt để!\r\nKhi còn có thể tập,\r\nthì phải dốc hết sức!","reviewed":true},
    {"entry_index":38,"uid":"zhcn:fa1d0d0ed0f3c4f1dc73e70f","kind":"character_system_text","source_text":"一点一滴脚踏实地！\r\n确实地累积实力吧。","source_fingerprint":"fb9543fdb6832f7a0e4ce64801b799a617bced7bd83449de53ae792ee86bcaba","source_path":"character_system_text_dict.json","json_path":["1076","20006"],"target_text":"Từng chút một, vững vàng tiến bước!\r\nHãy chắc chắn tích lũy thực lực.","reviewed":true},
    {"entry_index":39,"uid":"zhcn:386126cb4c83606a6adef733","kind":"character_system_text","source_text":"只要一步步向前迈进，\r\n就一定能抵达目的地。","source_fingerprint":"96fe65f78c4c74cc012d84c0c28bf6a55cefa842a8dcdd6e024bb6d1f21c54c1","source_path":"character_system_text_dict.json","json_path":["1076","20007"],"target_text":"Chỉ cần từng bước tiến về phía trước,\r\nnhất định sẽ đến được đích.","reviewed":true}
  ]
}
