  "entries": [
    {"entry_index":20,"uid":"zhcn:06d5e806f4a098e4ef38b154","kind":"character_system_text","source_text":"在所有领域，我都要赢过中央。\r\n无论是唱歌，还是跳舞。","source_fingerprint":"8a886b9e2f82aa916a84ab348f58c9f65fa385447aa28877750e119764d9d010","source_path":"character_system_text_dict.json","json_path":["1079","71014"],"target_text":"Trong mọi lĩnh vực, mình đều phải vượt qua Central.\nDù là ca hát hay khiêu vũ.","reviewed":true},
    {"entry_index":21,"uid":"zhcn:03a89a0734d3ea84b756efef","kind":"character_system_text","source_text":"船桥的天空与大海……真是个不错的意象。\r\n纵使离去，心亦相随。","source_fingerprint":"d02ca3a332075d8335385107b380f7f7d9392cef1f71c33ff9216a78cdae3f9a","source_path":"character_system_text_dict.json","json_path":["1079","71015"],"target_text":"Bầu trời và biển cả Funabashi…… quả là hình tượng tuyệt vời.\nDù rời xa, trái tim vẫn ở bên nhau.","reviewed":true},
    {"entry_index":22,"uid":"zhcn:51a342abc4730164aee202b3","kind":"character_system_text","source_text":"唔，还不错呢。","source_fingerprint":"7d87d54599ab00476499fd927897da007b95eee1c32ce0950ff8b6774bd786b8","source_path":"character_system_text_dict.json","json_path":["1079","71018"],"target_text":"Ừm, cũng không tệ.","reviewed":true},
    {"entry_index":23,"uid":"zhcn:82462f35371228de2b9bf3de","kind":"character_system_text","source_text":"衣装齐整，姿态端正。\r\n无论何时被人看见都没问题。","source_fingerprint":"ab12772b9523cd483b6a3f807e6c40696731eab71e9d51c7fa29718520de4160","source_path":"character_system_text_dict.json","json_path":["1079","71019"],"target_text":"Trang phục chỉnh tề, tư thế ngay ngắn.\nDù bị nhìn thấy lúc nào cũng không thành vấn đề.","reviewed":true},
    {"entry_index":24,"uid":"zhcn:ba1605c3e7d75ec685509734","kind":"character_system_text","source_text":"辛苦了","source_fingerprint":"bd96bf364b8b21a3bb94efcf4ef82feb1bc34cf02203524e7949dbd19151dd13","source_path":"character_system_text_dict.json","json_path":["1079","80000"],"target_text":"Vất vả rồi","reviewed":true}
