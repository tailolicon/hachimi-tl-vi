    {"entry_index":60,"uid":"zhcn:f03b73adb5f2af948065c7b5","kind":"character_system_text","source_text":"あなたらしく輝いて！","source_fingerprint":"fd574e265fd30dc2e753b13e9f2b7ba712e6285f04161e4ef5b0f4854c2eca03","source_path":"character_system_text_dict.json","json_path":["1082","20051"],"target_text":"Hãy tỏa sáng theo cách của bạn!","reviewed":true},
    {"entry_index":61,"uid":"zhcn:5fdfdef225d3549b6ae71113","kind":"character_system_text","source_text":"ときめきを胸に！","source_fingerprint":"372c9338da6689aa9e9d895d5c04453264e6b167b2a8b9a20bf9dfcf3f1710c0","source_path":"character_system_text_dict.json","json_path":["1082","2030"],"target_text":"Mang niềm rung động trong tim!","reviewed":true},
    {"entry_index":62,"uid":"zhcn:dc7919a7d759e671a74bc94e","kind":"character_system_text","source_text":"わたしたちなりの輝きで！","source_fingerprint":"b7c70a2103044aad89429a1a4517f5f8c0d17f0cba8255e6d7383b5d0ebea219","source_path":"character_system_text_dict.json","json_path":["1082","2031"],"target_text":"Hãy tỏa sáng theo cách của chúng ta!","reviewed":true},
    {"entry_index":63,"uid":"zhcn:adb9de1a78a4c6ccc58c0109","kind":"character_system_text","source_text":"ふふ、楽しかったですね。","source_fingerprint":"67ee401d176a280f3feb30e7d41f12cc20a23f47592fb60e3fd04b7f0090a6cb","source_path":"character_system_text_dict.json","json_path":["1082","2032"],"target_text":"Fufu, vui thật nhỉ.","reviewed":true},
    {"entry_index":64,"uid":"zhcn:4c6b7815bce7fac97e75a237","kind":"character_system_text","source_text":"いっしょに試行錯誤して\r\nここまで来たんです。\r\n脚は止めません！","source_fingerprint":"b1315893f87041cb2ee96c4cd4c73549c8eaf131cb02f0e0ee386c70a8345b47","source_path":"character_system_text_dict.json","json_path":["1082","2033"],"target_text":"Cùng nhau thử hết cách này đến cách khác\r\nmới đi được tới đây.\r\nTôi sẽ không dừng bước!","reviewed":true},
    {"entry_index":65,"uid":"zhcn:0bc761c72e433c7c7b2837b4","kind":"character_system_text","source_text":"コンディションは最高…\r\n怖いものなしの\r\nキラキラモードです！","source_fingerprint":"3bbe233b61382a067c3e57b7a13a7270ee33cf8b3388e4979db7396e99ccaa56","source_path":"character_system_text_dict.json","json_path":["1082","2034"],"target_text":"Thể trạng đang tuyệt nhất…\r\nChẳng còn gì phải sợ,\r\nchế độ lấp lánh đã bật!","reviewed":true},
    {"entry_index":66,"uid":"zhcn:da120e1d0b33c3559f4a01b5","kind":"character_system_text","source_text":"ふふ、楽しかったですね。","source_fingerprint":"67ee401d176a280f3feb30e7d41f12cc20a23f47592fb60e3fd04b7f0090a6cb","source_path":"character_system_text_dict.json","json_path":["1082","2035"],"target_text":"Fufu, vui thật nhỉ.","reviewed":true},
    {"entry_index":67,"uid":"zhcn:c4b499157188bb887c257fe1","kind":"character_system_text","source_text":"スタート！","source_fingerprint":"56168e4c96e45494fb01d8c8ca4769e00143d91c911c0e479147002100980cb1","source_path":"character_system_text_dict.json","json_path":["1082","23015"],"target_text":"Xuất phát!","reviewed":true},
    {"entry_index":68,"uid":"zhcn:2876e0043b3a07f6eaaea38b","kind":"character_system_text","source_text":"次は今より輝けるように！","source_fingerprint":"3f4cafcaa0e8c8a0fd9ba3c2d91c06f859fae6cfc39d45dee1a724184acf50fd","source_path":"character_system_text_dict.json","json_path":["1082","30000"],"target_text":"Lần tới, mình sẽ tỏa sáng hơn bây giờ!","reviewed":true},
    {"entry_index":69,"uid":"zhcn:f265fe15bfe8a25da1ed7655","kind":"character_system_text","source_text":"これで満足はできませんっ。","source_fingerprint":"c87d5c9b8a911038dfe0655f18545aa23df12e0208e8e7fec5355aff99ac703d","source_path":"character_system_text_dict.json","json_path":["1082","30001"],"target_text":"Mình vẫn chưa thể hài lòng với thế này đâu.","reviewed":true},
    {"entry_index":70,"uid":"zhcn:333101fd8fb5730f66a6e2bc","kind":"character_system_text","source_text":"リベンジあるのみですね。","source_fingerprint":"18ceaf1ef6ff39aa459f4bd32208432849c200deb496f49c7a74b4698f4ccc80","source_path":"character_system_text_dict.json","json_path":["1082","30002"],"target_text":"Vậy thì chỉ còn cách phục thù thôi nhỉ.","reviewed":true},
    {"entry_index":71,"uid":"zhcn:52c66e0a2325278ff09aeff5","kind":"character_system_text","source_text":"『わたし』を見つめ直さなきゃ…！","source_fingerprint":"34e282c65f2982a5f65918f55f3de291ed83e03338290185389c8c2c019fcb93","source_path":"character_system_text_dict.json","json_path":["1082","30003"],"target_text":"Phải nhìn lại chính 『mình』 thôi…!","reviewed":true},
    {"entry_index":72,"uid":"zhcn:b90e2f930f18a5eda37ca1e9","kind":"character_system_text","source_text":"最高のランウェイを飾りました♪","source_fingerprint":"340836764b8d9bfc6da53e58c646cd67321062a45a3c059592642037446bbfc0","source_path":"character_system_text_dict.json","json_path":["1082","30004"],"target_text":"Mình đã tỏa sáng trên runway tuyệt nhất♪","reviewed":true},
    {"entry_index":73,"uid":"zhcn:de186d31af8833bd2dd704f0","kind":"character_system_text","source_text":"輝きをあなたにも♪","source_fingerprint":"7aeb7c822eb16cf0d8affe88c776cfb5f4f643461acbb99d25ed04989c3c687e","source_path":"character_system_text_dict.json","json_path":["1082","30005"],"target_text":"Gửi cả ánh sáng này đến bạn♪","reviewed":true},
    {"entry_index":74,"uid":"zhcn:0d5366ec9b1784a6b8845b72","kind":"character_system_text","source_text":"出番ですね！","source_fingerprint":"4b3f8013c5c1b7a743b93c6f63ccbca064ac6d0292093e0780d07aaefde213e6","source_path":"character_system_text_dict.json","json_path":["1082","31000"],"target_text":"Đến lượt mình rồi nhỉ!","reviewed":true},
    {"entry_index":75,"uid":"zhcn:2e7413fb050ddbb51ab84187","kind":"character_system_text","source_text":"煌めきをまとって、いざ！","source_fingerprint":"40d3b367cd3074ee46b08a2a5cf6a4a1fe74878233b449d27c0ac2a719e911db","source_path":"character_system_text_dict.json","json_path":["1082","40000"],"target_text":"Khoác lên mình ánh lấp lánh, tiến lên!","reviewed":true},
    {"entry_index":76,"uid":"zhcn:65e7accc4b77a21b5836a81d","kind":"character_system_text","source_text":"爆进爆进爆进！\r\n爆进爆进爆进！\r\n…呵呵！真想也随着这首歌跳舞呢♪","source_fingerprint":"f3a61679831bc3676882bf28f29cd7083ce14535483ba51937185851c0dc28dc","source_path":"character_system_text_dict.json","json_path":["1082","400001"],"target_text":"Bakushin Bakushin Bakushin!\r\nBakushin Bakushin Bakushin!\r\n…Fufu! Nghe bài này là mình cũng muốn nhảy theo♪","reviewed":true},
    {"entry_index":77,"uid":"zhcn:6a139ff82cb785be4c8a6f22","kind":"character_system_text","source_text":"チケットさんのファッションは\r\n遊び心があるんですよね。だから\r\n遊べるアイテムを選んでみたんです","source_fingerprint":"d7a9daaef5e5a896120142e2dc6a55599a8a5f80dc977e2fa5fc6a0596e4e031","source_path":"character_system_text_dict.json","json_path":["1082","400002"],"target_text":"Phong cách của Ticket\r\ncó nét tinh nghịch lắm nhỉ. Vì thế\r\nmình thử chọn một món phụ kiện để tha hồ biến tấu.","reviewed":true},
    {"entry_index":78,"uid":"zhcn:591953df924b3bbc363bac69","kind":"character_system_text","source_text":"ファッションでも、リサーチは\r\n大切ですので。街ですれ違う方々の\r\n服装はいつもチェックしていますよ","source_fingerprint":"0b9921004331dd6d6297913383ea677c2972e3a0639b702256dc16763abbcd6f","source_path":"character_system_text_dict.json","json_path":["1082","400004"],"target_text":"Tìm hiểu cũng rất quan trọng\r\ntrong thời trang. Mình luôn để ý\r\ntrang phục của những người lướt qua trên phố.","reviewed":true},
    {"entry_index":79,"uid":"zhcn:78def37d607c42285f308346","kind":"character_system_text","source_text":"わたしたちの衣装は、華美に\r\nならないよう気をつけました。\r\n主役は和菓子ですからね♪","source_fingerprint":"f065d660f39a2dab5165b240b3bacf1bd3b5a96d76569993fe4c85543f09cbb5","source_path":"character_system_text_dict.json","json_path":["1082","400008"],"target_text":"Bọn mình đã chú ý để trang phục\r\nkhông quá lộng lẫy.\r\nVì nhân vật chính là wagashi mà♪","reviewed":true}
