  "entries": [
    {"entry_index":40,"uid":"zhcn:66c2f7423d4328d28c280012","kind":"character_system_text","source_text":"おめでとう。…あら、\r\n誕生日じゃなかったかしら。\r\nお祝いの言葉を、贈りますわ。","source_fingerprint":"a4ee970bc924eec5eb2b039043b24eff0adaa6763a1b362e7c08c9bca6682b8b","source_path":"character_system_text_dict.json","json_path":["1086","10012"],"target_text":"Chúc mừng. …Ồ,\r\nchẳng phải hôm nay là sinh nhật sao?\r\nTôi xin gửi đến bạn lời chúc mừng.","reviewed":true},
    {"entry_index":41,"uid":"zhcn:bcd0f578b9a13a2a1cebb75e","kind":"character_system_text","source_text":"そうだ、貴方…アクセサリーを\r\n試してみたら。今日は家に、\r\nたくさん届くの…差し上げるわ。","source_fingerprint":"8fc116d21444adeee5e68b6da1fd5dea4b58cae9dca67df8fadc01489c7e03b9","source_path":"character_system_text_dict.json","json_path":["1086","10013"],"target_text":"Phải rồi, bạn… thử đeo vài món phụ kiện\r\nxem sao. Hôm nay nhà tôi sẽ gửi đến\r\nrất nhiều… tôi tặng bạn đấy.","reviewed":true},
    {"entry_index":42,"uid":"zhcn:beb6983f289b4a7fde98c9cc","kind":"character_system_text","source_text":"誕生日…ね。貴方が、\r\n大切に思わせてくださるの？\r\n忘れられないお祝いで…。","source_fingerprint":"d91bf7066b25cb8b31f049e164167a1025a64c9019e2236c841b9b25e3674526","source_path":"character_system_text_dict.json","json_path":["1086","10014"],"target_text":"Sinh nhật… nhỉ. Bạn sẽ khiến tôi\r\ntrân trọng ngày này sao?\r\nBằng một lời chúc không thể nào quên…","reviewed":true},
    {"entry_index":43,"uid":"zhcn:c8b5e4cdd43c2ab85287cca0","kind":"character_system_text","source_text":"お知らせ…ですって。\r\nご覧になったら。","source_fingerprint":"7e5c5a46a9b4f162aac3b90f0d472998c8512f81c76ae400234b6a7e97b74c06","source_path":"character_system_text_dict.json","json_path":["1086","10015"],"target_text":"Có thông báo… à.\r\nBạn xem thử đi.","reviewed":true},
    {"entry_index":44,"uid":"zhcn:866619199403d1182df75359","kind":"character_system_text","source_text":"貴方にプレゼントがあるそうよ。\r\nよかったですわね。","source_fingerprint":"1bf59214e51269c6d4c498b556bf52faaf92197e06eefdf4f0ce9f1121e6216d","source_path":"character_system_text_dict.json","json_path":["1086","10016"],"target_text":"Nghe nói có quà dành cho bạn đấy.\r\nTốt quá nhỉ.","reviewed":true},
    {"entry_index":45,"uid":"zhcn:ee0dd70f7c91dd8a881f82c7","kind":"character_system_text","source_text":"ミッションを達成したのね。\r\nそう…。","source_fingerprint":"ed3cb09a5440e61c9a5c5387e25c30e494f8ed8283cd23caff7ac6379dfe1520","source_path":"character_system_text_dict.json","json_path":["1086","10017"],"target_text":"Mission đã hoàn thành rồi nhỉ.\r\nVậy à…","reviewed":true},
    {"entry_index":46,"uid":"zhcn:ade2328c20c7439be8e4483a","kind":"character_system_text","source_text":"イベントが始まるらしいわ。\r\n確認なさらないの？","source_fingerprint":"603cdea5b0589c8bb4e045025ecf80759815b6e116285d7695a96b675904b03c","source_path":"character_system_text_dict.json","json_path":["1086","10018"],"target_text":"Nghe nói sự kiện sắp bắt đầu.\r\nBạn không kiểm tra sao?","reviewed":true},
    {"entry_index":47,"uid":"zhcn:b8373c3ebc14f0fba45c087a","kind":"character_system_text","source_text":"イベントね…。\r\nどうぞ、お好きに。","source_fingerprint":"70ca9a9f40bf75bb4a3ad7bbb8d916730aea7a1ac4965dfd54df5a7ee362c34a","source_path":"character_system_text_dict.json","json_path":["1086","10019"],"target_text":"Sự kiện à…\r\nCứ tùy ý bạn.","reviewed":true},
    {"entry_index":48,"uid":"zhcn:f96f581eb0345276d94de159","kind":"character_system_text","source_text":"負けるなんて…。","source_fingerprint":"7edb6a59f3b85e8714c51f3e3cd758d132d0440c15017fed9680790ce241052a","source_path":"character_system_text_dict.json","json_path":["1086","1002"],"target_text":"Không ngờ lại thua…","reviewed":true},
    {"entry_index":49,"uid":"zhcn:63d69891311de8631c010d5c","kind":"character_system_text","source_text":"ウマ娘名鑑のレベルが、\r\n上がったそうよ。","source_fingerprint":"18950df05c9d06a7cb525e71c18376b009adbd2848de42a7b4e85d0798ef37ee","source_path":"character_system_text_dict.json","json_path":["1086","10021"],"target_text":"Nghe nói cấp Archive\r\nđã tăng rồi.","reviewed":true},
    {"entry_index":50,"uid":"zhcn:d2ca1364fa2da67f43688519","kind":"character_system_text","source_text":"引き分け…ね。","source_fingerprint":"596698458fd1bce015bb1db5b352b2f9c1ce8e4244af68b659cbfb4f9933dff5","source_path":"character_system_text_dict.json","json_path":["1086","1003"],"target_text":"Hòa… nhỉ.","reviewed":true},
    {"entry_index":51,"uid":"zhcn:d12361ffe8118685c967964a","kind":"character_system_text","source_text":"当然の結果ね。","source_fingerprint":"402268b883ad8f86a126e2312b09799dbeac985e2b3e06b04cd748dc079ab326","source_path":"character_system_text_dict.json","json_path":["1086","1004"],"target_text":"Kết quả hiển nhiên thôi.","reviewed":true},
    {"entry_index":52,"uid":"zhcn:4e35b596457a2d4e3e29bc55","kind":"character_system_text","source_text":"負けるなんて…。","source_fingerprint":"7edb6a59f3b85e8714c51f3e3cd758d132d0440c15017fed9680790ce241052a","source_path":"character_system_text_dict.json","json_path":["1086","1005"],"target_text":"Không ngờ lại thua…","reviewed":true},
    {"entry_index":53,"uid":"zhcn:96912953b3d2cc64350af6ce","kind":"character_system_text","source_text":"引き分け…ね。","source_fingerprint":"596698458fd1bce015bb1db5b352b2f9c1ce8e4244af68b659cbfb4f9933dff5","source_path":"character_system_text_dict.json","json_path":["1086","1006"],"target_text":"Hòa… nhỉ.","reviewed":true},
    {"entry_index":54,"uid":"zhcn:b68c4388aa77e5be7f9b2674","kind":"character_system_text","source_text":"ふふ、完璧…。","source_fingerprint":"a2ecf7cff77f43fed1aa852949034fa4dc1be0c75af5dfdf3a275de5458c02ae","source_path":"character_system_text_dict.json","json_path":["1086","1007"],"target_text":"Hì hì, hoàn hảo…","reviewed":true},
    {"entry_index":55,"uid":"zhcn:926c62cd71154e90389a7fcf","kind":"character_system_text","source_text":"望むのは…勝利だけよ。","source_fingerprint":"a6749b6aaaa9093d29055a563dee8469530046cb8d1f9fcf9cca0902e8b2ae48","source_path":"character_system_text_dict.json","json_path":["1086","1008"],"target_text":"Điều tôi mong muốn… chỉ có chiến thắng.","reviewed":true},
    {"entry_index":56,"uid":"zhcn:c31836b24d3409b9760ea58f","kind":"character_system_text","source_text":"Cygames","source_fingerprint":"70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb","source_path":"character_system_text_dict.json","json_path":["1086","11"],"target_text":"Cygames","reviewed":true},
    {"entry_index":57,"uid":"zhcn:4d97412bcb0659eb26981ac1","kind":"character_system_text","source_text":"さあ…\r\n今日はどうなさるのかしら。","source_fingerprint":"1593fbb6a3fc1175bd09eebe0bd8838300a65b055fd19516dfee49bc7bedf0b8","source_path":"character_system_text_dict.json","json_path":["1086","110000"],"target_text":"Nào…\r\nhôm nay bạn định làm gì đây?","reviewed":true},
    {"entry_index":58,"uid":"zhcn:7e8bfacbf942cc804a894fd6","kind":"character_system_text","source_text":"歴史を学ぶことも、\r\n自分を磨くことに繋がるわ。","source_fingerprint":"e399b885c529f2cf6d3b5199969a704ab208372998ca1d1dcffa2b5380634c49","source_path":"character_system_text_dict.json","json_path":["1086","110001"],"target_text":"Học lịch sử cũng góp phần\r\nmài giũa chính mình.","reviewed":true},
    {"entry_index":59,"uid":"zhcn:81f726c039a39e8bab165dbf","kind":"character_system_text","source_text":"いつでもよろしくてよ。\r\n素晴らしいレースへ…。","source_fingerprint":"3cb60aa77a3f84ffc4735ad368117865b0bbc40866ecc571f2f935b2e31af386","source_path":"character_system_text_dict.json","json_path":["1086","110002"],"target_text":"Tôi luôn sẵn sàng.\r\nHướng tới một cuộc đua tuyệt vời…","reviewed":true}
