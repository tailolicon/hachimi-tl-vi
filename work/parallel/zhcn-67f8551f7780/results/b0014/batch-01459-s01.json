  "entries": [
    {"entry_index":20,"uid":"zhcn:e2ef38a282aa582f6f899b21","kind":"character_system_text","source_text":"姐姐说锻炼精神也很重要……\n呜呜，铁球训练什么的\n还是不要啦~……","source_fingerprint":"de2815e54402e2d3eec129262ac221f5f6272d3c1d82a168ec3172c0f73cfe69","source_path":"character_system_text_dict.json","json_path":["1091","92018"],"target_text":"Chị bảo rèn luyện tinh thần cũng rất quan trọng…\nƯ-ư, mấy bài tập với bóng sắt thì\nthôi cho em xin~…","reviewed":true},
    {"entry_index":21,"uid":"zhcn:1b5d582671fea3bcbbd6acdc","kind":"character_system_text","source_text":"呐~呐~来制定一下今天训练后的\n安排吧！是去吃东西？\n还是去购物？该选哪个呢♪","source_fingerprint":"231c90f9f6c74dd63e2ba25dfac13e392af3b3915cd9a3ef60e92b423b558e2d","source_path":"character_system_text_dict.json","json_path":["1091","92020"],"target_text":"Nè~ nè~ cùng lên lịch sau buổi tập hôm nay đi!\nĐi ăn gì đó?\nHay đi mua sắm? Chọn cái nào đây♪","reviewed":true},
    {"entry_index":22,"uid":"zhcn:1d241eb2e100a607bfdcec0b","kind":"character_system_text","source_text":"还有很多地方想和训练员亲\n一起去呢！\n你会和我一起去的，对吧？","source_fingerprint":"7bb6345d054e7dc162f066c0c1217fd8fe436eb6badb7cb85b469e36c1dda15c","source_path":"character_system_text_dict.json","json_path":["1091","92021"],"target_text":"Còn nhiều nơi em muốn đi cùng Trainer lắm!\nTrainer sẽ đi cùng em, đúng không?","reviewed":true},
    {"entry_index":23,"uid":"zhcn:ebac1762972798ffafe7ec16","kind":"character_system_text","source_text":"训练员亲喜欢什么样的穿搭？\n可以的话我来帮训练员亲\n选一套合适的西装吧！","source_fingerprint":"bb776f62d85db15dbc81bb035de01a2858c65d1a864b74b7c5b4fbc725a159e2","source_path":"character_system_text_dict.json","json_path":["1091","92022"],"target_text":"Trainer thích phong cách ăn mặc thế nào?\nNếu được thì để em giúp Trainer\nchọn một bộ suit thật hợp nhé!","reviewed":true},
    {"entry_index":24,"uid":"zhcn:5af9339d08f19247a6f24cd0","kind":"character_system_text","source_text":"训练员亲喜欢什么样的穿搭？\n可以的话我来帮训练员亲\n选一套合适的礼服吧！","source_fingerprint":"8c98ad9d9f337f21922eb79c18c9dbaff3cc712e4c482ffa30d4cb7f44aec6f9","source_path":"character_system_text_dict.json","json_path":["1091","92122"],"target_text":"Trainer thích phong cách ăn mặc thế nào?\nNếu được thì để em giúp Trainer\nchọn một bộ lễ phục thật hợp nhé!","reviewed":true},
    {"entry_index":25,"uid":"zhcn:644146b3f80820016b3029ba","kind":"character_system_text","source_text":"很厉害吧！\r\n已经变得这么闪耀了☆","source_fingerprint":"c0be88dfb2508738f121715539d468cbd86ddd87e6eba80703d77b4a4aa11932","source_path":"character_system_text_dict.json","json_path":["1091","93000"],"target_text":"Tuyệt lắm đúng không!\r\nGiờ em đã tỏa sáng thế này rồi☆","reviewed":true},
    {"entry_index":26,"uid":"zhcn:0ef163c80b02c7312c79c52f","kind":"character_system_text","source_text":"训练员亲努力了，奖励你一朵小花！","source_fingerprint":"01e73a9414766e4c019c85c3ce2530cbad43b76f2d541c472f37e1bd07a9fc30","source_path":"character_system_text_dict.json","json_path":["1091","93001"],"target_text":"Trainer cố gắng nhiều rồi, em thưởng một bông hoa nhỏ nhé!","reviewed":true},
    {"entry_index":27,"uid":"zhcn:5e45c9eecc278ec92e2343cb","kind":"character_system_text","source_text":"一起享受了最棒的假期呢♪","source_fingerprint":"5635e62a12eb8fcc0e803f558dd9ff0c9c01666973d0eab83522dca6660359e1","source_path":"character_system_text_dict.json","json_path":["1091","93004"],"target_text":"Mình đã cùng tận hưởng kỳ nghỉ tuyệt nhất rồi nhỉ♪","reviewed":true},
    {"entry_index":28,"uid":"zhcn:910639fda73f94a4358356a2","kind":"character_system_text","source_text":"真是短暂却开心的旅程呢~☆","source_fingerprint":"2850bef6115b6d102d0d9aafae49cfdcf420f021174aaf4dd8c053de9d24fa1f","source_path":"character_system_text_dict.json","json_path":["1091","93005"],"target_text":"Đúng là chuyến đi ngắn mà vui ghê~☆","reviewed":true},
    {"entry_index":29,"uid":"zhcn:518021a35b8e59ba12de5a54","kind":"character_system_text","source_text":"变得更厉害了！","source_fingerprint":"3f1643b977624337bc997a7a630078d4d06abec8324c77bd047a6f069e3f41c0","source_path":"character_system_text_dict.json","json_path":["1091","95000"],"target_text":"Em giỏi hơn rồi!","reviewed":true}
