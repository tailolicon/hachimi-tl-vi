  "entries": [
    {"entry_index":60,"uid":"zhcn:4a4f1ca3f091805970cb8835","kind":"character_system_text","source_text":"似乎有礼物送到了呢\n拆开的乐趣…呢。呵呵。","source_fingerprint":"b4f895d7959cee5a742929b1c42962b3d60260410d648daef7f317f6eee624fb","source_path":"character_system_text_dict.json","json_path":["1097","10016"],"target_text":"Có vẻ quà đã được gửi tới rồi.\nNiềm vui lúc mở ra… nhỉ. Hì hì.","reviewed":true},
    {"entry_index":61,"uid":"zhcn:8c36dbe698b04afb2d335aa2","kind":"character_system_text","source_text":"似乎有达成的任务呢\n呵呵，辛苦您了。","source_fingerprint":"0786a967cb7d1cff567aba3665f4715749e35b36b3f2580f5e621ba036854fb0","source_path":"character_system_text_dict.json","json_path":["1097","10017"],"target_text":"Có vẻ có Mission đã hoàn thành rồi.\nHì hì, bạn vất vả rồi.","reviewed":true},
    {"entry_index":62,"uid":"zhcn:4e7b6128c2b77270f7663195","kind":"character_system_text","source_text":"似乎要举办活动了。\n…那孩子也开始躁动了…","source_fingerprint":"7e8399def5dec4a9ca5540e8a6a14223bffbe5caa21f13ba17a9c706827b4c92","source_path":"character_system_text_dict.json","json_path":["1097","10018"],"target_text":"Có vẻ sắp có sự kiện.\n…Đứa trẻ ấy cũng bắt đầu rục rịch rồi…","reviewed":true},
    {"entry_index":63,"uid":"zhcn:8698b2892bea056d57009b0f","kind":"character_system_text","source_text":"活动似乎很热闹。\n沉迷过度的话…必须注意\n不要展现出不得体的模样。","source_fingerprint":"ca60c69f5d8e693e618b58971adf6ca75071add9d0bb672337f2a50c7a04e8a1","source_path":"character_system_text_dict.json","json_path":["1097","10019"],"target_text":"Sự kiện có vẻ rất náo nhiệt.\nNếu quá mải mê… phải cẩn thận\nđừng để lộ dáng vẻ thất thố.","reviewed":true},
    {"entry_index":64,"uid":"zhcn:1405fc3040efd48936aa11af","kind":"character_system_text","source_text":"让他逃掉了…","source_fingerprint":"3da9c40405bc61cea7d7e79e61aaba3a1fc8f14acc5be3edac6ca2fd3ec7b6c6","source_path":"character_system_text_dict.json","json_path":["1097","1002"],"target_text":"Để hắn thoát mất rồi…","reviewed":true},
    {"entry_index":65,"uid":"zhcn:fff97eaa46076d4c5addb9a9","kind":"character_system_text","source_text":"赛马娘名鉴的等级\n似乎提升了。","source_fingerprint":"b4fb966cca1b710da0cdc59e58afcf4d6487cfce3938483ec701be7e0460b62b","source_path":"character_system_text_dict.json","json_path":["1097","10021"],"target_text":"Cấp Archive\nhình như đã tăng rồi.","reviewed":true},
    {"entry_index":66,"uid":"zhcn:08e369cd7dac09c54870c81d","kind":"character_system_text","source_text":"深色能聚集阳光，保护肌肤\n…这件衣服，是非常\n可靠的伙伴呢…","source_fingerprint":"619bffab1d6e6a2af026a49d3e6120fc4777cb88570856c33ee9d2eff0fc91ce","source_path":"character_system_text_dict.json","json_path":["1097","10025"],"target_text":"Màu tối hấp thụ ánh nắng, bảo vệ làn da\n…Bộ đồ này quả là một\nngười bạn rất đáng tin cậy…","reviewed":true},
    {"entry_index":67,"uid":"zhcn:c3ca4dbc95361d12fcd847b4","kind":"character_system_text","source_text":"尽量找了长款的衣服…\n如果是便于奔跑的服装…\n可能会唤醒那孩子吧…？","source_fingerprint":"327231b98ceaa46ddef309e2c5cfa84c2750b28921035840b823f2f20a25ac29","source_path":"character_system_text_dict.json","json_path":["1097","10026"],"target_text":"Tôi đã cố tìm đồ dài hết mức có thể…\nNếu là trang phục dễ chạy…\ncó lẽ sẽ đánh thức đứa trẻ ấy…?","reviewed":true},
    {"entry_index":68,"uid":"zhcn:a8d6ebccb183ace69dd80805","kind":"character_system_text","source_text":"这件衣服、装了点心和\n咖啡的篮子…还有阳伞…\n休息日的三件套呢。呵呵","source_fingerprint":"d476ad3a44e6cc54606cbbd1301469b2d22a107d00fb25e1aeee27885182c9d2","source_path":"character_system_text_dict.json","json_path":["1097","10027"],"target_text":"Bộ đồ này, chiếc giỏ đựng bánh ngọt và\ncà phê… cùng chiếc ô che nắng…\nlà bộ ba cho ngày nghỉ nhỉ. Hì hì.","reviewed":true},
    {"entry_index":69,"uid":"zhcn:6184038dc0b85a798191736a","kind":"character_system_text","source_text":"不够不够…！","source_fingerprint":"579b6daee8af14a5d74190ec4b6ac140f3164017a072b15dbcc1dce8ab980af2","source_path":"character_system_text_dict.json","json_path":["1097","1003"],"target_text":"Chưa đủ, chưa đủ…!","reviewed":true},
    {"entry_index":70,"uid":"zhcn:b70569fdaf7595b7da40bb55","kind":"character_system_text","source_text":"吃饱了…","source_fingerprint":"f21ab7cb4ad6462bd64bd232fed0e86265894a3ccba188043e1c70ec8cf3c8e2","source_path":"character_system_text_dict.json","json_path":["1097","1004"],"target_text":"No rồi…","reviewed":true},
    {"entry_index":71,"uid":"zhcn:7c6a3361ae606c6e89149bb6","kind":"character_system_text","source_text":"让他逃掉了…","source_fingerprint":"3da9c40405bc61cea7d7e79e61aaba3a1fc8f14acc5be3edac6ca2fd3ec7b6c6","source_path":"character_system_text_dict.json","json_path":["1097","1005"],"target_text":"Để hắn thoát mất rồi…","reviewed":true},
    {"entry_index":72,"uid":"zhcn:3e53359b980182e7a16df525","kind":"character_system_text","source_text":"还不够还不够…！","source_fingerprint":"252084006d8b0a1cbe4b38d46d39497239039055a1f031e65ca7560a830b0474","source_path":"character_system_text_dict.json","json_path":["1097","1006"],"target_text":"Vẫn chưa đủ, vẫn chưa đủ…!","reviewed":true},
    {"entry_index":73,"uid":"zhcn:2954d5fa7312a99346700a3e","kind":"character_system_text","source_text":"啊啊，至高无上的味道…！","source_fingerprint":"a15c07b90be7e1ae5364b023b47bcb5c347012e4648a105ad0f5ccdbf8a426ae","source_path":"character_system_text_dict.json","json_path":["1097","1007"],"target_text":"Aah, hương vị tuyệt đỉnh…!","reviewed":true},
    {"entry_index":74,"uid":"zhcn:c740ed80f03ad4efdf2652b6","kind":"character_system_text","source_text":"最美味的孩子…是我的东西。","source_fingerprint":"ce8e876af7b7fe53d0f953fddc273c10a663203597354b61dbe25ea0011330d3","source_path":"character_system_text_dict.json","json_path":["1097","1008"],"target_text":"Đứa ngon lành nhất… là của tôi.","reviewed":true}
  ]
}
