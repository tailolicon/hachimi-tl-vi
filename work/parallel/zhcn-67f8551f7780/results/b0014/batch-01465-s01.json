{
  "schema_version": 1,
  "status": "complete",
  "epoch": "zhcn-67f8551f7780",
  "task_id": "batch-01465-s01",
  "batch": 1465,
  "shard": 1,
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "shard_start": 20,
  "shard_end_exclusive": 40,
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 20,
      "uid": "zhcn:60df270967e0a328c75dbebf",
      "kind": "character_system_text",
      "source_text": "您觉得如何？",
      "source_fingerprint": "f41b79a58ab44cf4e04f7c5467a55a12cfa60a24cd4c4571a12e10db7064636f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140016"
      ],
      "target_text": "Ngài thấy thế nào?",
      "reviewed": true
    },
    {
      "entry_index": 21,
      "uid": "zhcn:e95c9989dd8e3f8098dc8015",
      "kind": "character_system_text",
      "source_text": "可惜…",
      "source_fingerprint": "4441c01168900818ac075ac7a66297457874f771e69016556f3d7f8d1f494b64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140017"
      ],
      "target_text": "Tiếc quá…",
      "reviewed": true
    },
    {
      "entry_index": 22,
      "uid": "zhcn:4d8b4b04e0144687353fe99f",
      "kind": "character_system_text",
      "source_text": "逃掉了呢…",
      "source_fingerprint": "f807849caf95a9b6f6f0c4aa1e12e8b2dc96ed003822953d99a1affd8d475af6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140018"
      ],
      "target_text": "Để nó chạy mất rồi…",
      "reviewed": true
    },
    {
      "entry_index": 23,
      "uid": "zhcn:729048f39a555c4fb120ae38",
      "kind": "character_system_text",
      "source_text": "明天似乎能由我们收下呢。",
      "source_fingerprint": "415922b5f0e02498c16efd30d1b9496a85b6e077decc4b4615cbbed9cf9f0269",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "15"
      ],
      "target_text": "Ngày mai hình như chúng tôi có thể nhận được rồi.",
      "reviewed": true
    },
    {
      "entry_index": 24,
      "uid": "zhcn:facb9a7e4e6984386a869cfc",
      "kind": "character_system_text",
      "source_text": "现在，如果那孩子狂暴起来的话\n…感觉腿会支撑不住呢…",
      "source_fingerprint": "a10f351bfea6a0ae2d18677a9e1c82028ee0c85c297d93c9a39563144bcc8cae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20000"
      ],
      "target_text": "Bây giờ, nếu đứa trẻ đó nổi cơn cuồng bạo\n…cảm giác đôi chân sẽ không trụ nổi mất…",
      "reviewed": true
    },
    {
      "entry_index": 25,
      "uid": "zhcn:6da99983cd213f6672acc38a",
      "kind": "character_system_text",
      "source_text": "…身体，不听使唤…\n呜，让您失望了，\n非常抱歉…",
      "source_fingerprint": "f6cd68a95c0158e4dd405032494bf3237b41d9671bbd6ad58048ac1984a9acd3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20001"
      ],
      "target_text": "…cơ thể, không chịu nghe lời…\nhức, khiến ngài thất vọng rồi,\nthật sự xin lỗi…",
      "reviewed": true
    },
    {
      "entry_index": 26,
      "uid": "zhcn:7cff227f622c0e8f825479b2",
      "kind": "character_system_text",
      "source_text": "已经受够等待了…\n来吧…！…呜，不行…！\n还，太早了…！",
      "source_fingerprint": "229f10498a19cef2bd6dd3c8280c57abc7e2e15665afe5ae7a8dbb9e42dfa40b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20002"
      ],
      "target_text": "Đã chịu đủ chờ đợi rồi…\nĐến đây…! …hức, không được…!\nVẫn, còn quá sớm…!",
      "reviewed": true
    },
    {
      "entry_index": 27,
      "uid": "zhcn:7b429d57172f1cdfcaef35db",
      "kind": "character_system_text",
      "source_text": "双腿，渴望着奔跑…\n啊啊…那孩子的心情，\n现在…或许稍微能理解了。",
      "source_fingerprint": "d8191624d48ce3473aa03f396b9373a0f6ea0bedf0a829a66a25919caf410ca0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20003"
      ],
      "target_text": "Đôi chân, khát khao được chạy…\nA à…tâm trạng của đứa trẻ đó,\nbây giờ…có lẽ tôi đã hiểu được đôi chút.",
      "reviewed": true
    },
    {
      "entry_index": 28,
      "uid": "zhcn:01d8a52d269401dfa54b26b7",
      "kind": "character_system_text",
      "source_text": "…正看着呢…那孩子。等待着\n能够吞噬一切的肉体…\n完成的那一刻。",
      "source_fingerprint": "57adfced2abb76400401dc9fcce46a7e043055bebb5aeb3b5ae1a296f2e930fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20004"
      ],
      "target_text": "…đang nhìn kìa…đứa trẻ đó. Đang chờ đợi\nkhoảnh khắc thân thể có thể nuốt trọn vạn vật…\nhoàn tất.",
      "reviewed": true
    },
    {
      "entry_index": 29,
      "uid": "zhcn:fd18ce755fe691200606e130",
      "kind": "character_system_text",
      "source_text": "准备运动期间，身体也在躁动…\n…不快点…奔跑的话——\n快点，快点…更快。",
      "source_fingerprint": "094682a55f09e63144f9d2050ad97142c6e7466dc51137492a218470d048ad44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20005"
      ],
      "target_text": "Trong lúc khởi động, cơ thể cũng đang nóng nảy…\n…nếu không nhanh…chạy đi thì——\nnhanh lên, nhanh lên…nhanh hơn nữa.",
      "reviewed": true
    },
    {
      "entry_index": 30,
      "uid": "zhcn:637f7f31779f7bd604d298be",
      "kind": "character_system_text",
      "source_text": "准备工作就稳步推进吧。\n积蓄得越多…在赛场上，\n那孩子就越是狂暴。",
      "source_fingerprint": "5fd92f77a0e88d613a28ccc302af37df49e533b15c5f3c7226c5d82dcd2bf98d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20006"
      ],
      "target_text": "Công tác chuẩn bị cứ vững vàng tiến hành thôi.\nCàng tích lũy nhiều…thì trên đường đua,\nđứa trẻ đó càng trở nên cuồng bạo.",
      "reviewed": true
    },
    {
      "entry_index": 31,
      "uid": "zhcn:fc7f7e7d801d2fea5808979c",
      "kind": "character_system_text",
      "source_text": "与您一起，将内心的存在\n逐步驯服吧。\n…直到解放的那一瞬间。",
      "source_fingerprint": "523ce740717f4712fa83aee59099185accb83fdd588af3014f4d772d4a43deb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20007"
      ],
      "target_text": "Cùng ngài, hãy từng bước thuần hóa\nsự tồn tại bên trong nội tâm.\n…cho đến khoảnh khắc được giải phóng.",
      "reviewed": true
    },
    {
      "entry_index": 32,
      "uid": "zhcn:56fe1f76bbc2cc7638458357",
      "kind": "character_system_text",
      "source_text": "感觉不到往常的兴奋\n…异常地，那孩子很安静呢",
      "source_fingerprint": "9c6351ea3770c5024b825adb86507284c54ff18f17ccca3492456317847681d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20008"
      ],
      "target_text": "Không cảm nhận được sự hưng phấn như thường lệ\n…thật bất thường, đứa trẻ đó im lặng quá",
      "reviewed": true
    },
    {
      "entry_index": 33,
      "uid": "zhcn:3504ee0387ce30b157d16716",
      "kind": "character_system_text",
      "source_text": "…必须振作起来呢。\n这种时候，\n果然需要苦咖啡吧…",
      "source_fingerprint": "23c3e0b39a0cd8ee3829442dbbb6520debcc789891282ab54ac0dffc5a44fe58",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20009"
      ],
      "target_text": "…phải lấy lại tinh thần mới được.\nLúc như thế này,\nquả nhiên cần một ly cà phê đắng thôi…",
      "reviewed": true
    },
    {
      "entry_index": 34,
      "uid": "zhcn:216fc748e62648a9f56d70ab",
      "kind": "character_system_text",
      "source_text": "腿没有颤抖…胸口，也没有疼痛…\n…没有渴望奔跑吗…？",
      "source_fingerprint": "9bff4a524fed64dda4f1dca6271310ac96687e7ad85dfa8bcbcd0099593b8aa7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20010"
      ],
      "target_text": "Đôi chân không run rẩy…lồng ngực, cũng chẳng đau…\n…không khát khao được chạy sao…?",
      "reviewed": true
    },
    {
      "entry_index": 35,
      "uid": "zhcn:f235b41fd0e1fed52bc54523",
      "kind": "character_system_text",
      "source_text": "…非常抱歉。\n可以稍微，让我在\n阴凉处休息一下吗…？",
      "source_fingerprint": "44f423ba2fec7819574bd6589d731c802fbb1c87e9973526f5bb098d94bbfd61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20011"
      ],
      "target_text": "…thật sự xin lỗi.\nCó thể cho tôi nghỉ ngơi\nmột chút ở chỗ mát được không…?",
      "reviewed": true
    },
    {
      "entry_index": 36,
      "uid": "zhcn:7ed0aa50d557dcb50b523146",
      "kind": "character_system_text",
      "source_text": "是不是稍微，让那孩子\n狂暴过头了呢…如果失去了\n控制的方法…会发生什么…",
      "source_fingerprint": "f14138a094a631978621da1aa37e400f9f1e4981faee5fae4ce56a7a870e7ddc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20021"
      ],
      "target_text": "Có phải tôi đã để đứa trẻ đó\ncuồng bạo hơi quá rồi không…nếu mất đi\ncách khống chế…thì sẽ xảy ra chuyện gì…",
      "reviewed": true
    },
    {
      "entry_index": 37,
      "uid": "zhcn:e16d0114eac013aeab2956bc",
      "kind": "character_system_text",
      "source_text": "…开始，不明白了…。\n狂暴的怪物，试图抑制的我…\n真实的…是哪一个…？",
      "source_fingerprint": "c421b3f7fb664cefcc23b10e3b8ed4463ace92cc4f4ac91519baeadde551d1ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20022"
      ],
      "target_text": "…bắt đầu, không hiểu nổi nữa rồi….\nQuái vật cuồng bạo, và tôi kẻ cố kìm nén nó…\nrốt cuộc…ai mới là thật…?",
      "reviewed": true
    },
    {
      "entry_index": 38,
      "uid": "zhcn:978fdef5f72b6c187cb2a1c3",
      "kind": "character_system_text",
      "source_text": "…渴求。无法抑制地，\n饥饿着。啊啊…束缚那孩子的\n锁链，马上就要断裂了…",
      "source_fingerprint": "f44e52da93b29a3b98a75a9dfc01751655e547225c498ed6182e56ef0ed32dc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20023"
      ],
      "target_text": "…khao khát. Không thể nào kìm nén được,\nđang đói khát. A à…sợi xích trói buộc đứa trẻ đó,\nsắp sửa đứt gãy rồi…",
      "reviewed": true
    },
    {
      "entry_index": 39,
      "uid": "zhcn:4f60dd1b175a439760e9b7f3",
      "kind": "character_system_text",
      "source_text": "没关系。已经，可以了。…可以吗？\n真的？…呵呵，呵呵呵，呵呵呵\n呵呵呵呵。已经不用忍耐了…",
      "source_fingerprint": "ba821363faae54b15d1ff63449399d27b9314d4a4ffc9983e1ec5a5ef826428a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20024"
      ],
      "target_text": "Không sao đâu. Đã, được rồi. …được chứ?\nThật sao?…hì hì, hì hì hì, hì hì hì\nhì hì hì hì. Không cần nhẫn nhịn nữa rồi…",
      "reviewed": true
    }
  ]
}
