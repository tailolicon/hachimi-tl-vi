  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:3277f4aef8fc9013d34876af",
      "kind": "character_system_text",
      "source_text": "若能给舞台增添华彩…",
      "source_fingerprint": "478215a4ef5b6cf33d07d0382d9da4910b88d4d9954f894a0ad0079b8289fcf1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "60000"
      ],
      "target_text": "Nếu có thể tô điểm thêm sắc màu rực rỡ cho sân khấu…",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:31fc1877ebfdabfb7df194e4",
      "kind": "character_system_text",
      "source_text": "呵呵，前往令人目眩的盛宴…",
      "source_fingerprint": "9f60348a938f22e92fd4ad2ac59147ad5829254400028adc853a08a4ffbfcadc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "60001"
      ],
      "target_text": "Khe khẽ cười, tiến về bữa tiệc lộng lẫy đến chóng mặt…",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:64645af3b6fd97ac6c6ba8cc",
      "kind": "character_system_text",
      "source_text": "若是与您一起，无论何处都…",
      "source_fingerprint": "7b952e3ab2917f418ad23c8638d0c6ce3f6a830d95ae78f95607a87a1ef14b69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70000"
      ],
      "target_text": "Nếu là cùng ngài, thì dù ở bất cứ nơi đâu…",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:99783305c4cb38872d4bc807",
      "kind": "character_system_text",
      "source_text": "没有您的我，已经无法想象\n那个时候…被吞噬灵魂的\n或许是我…",
      "source_fingerprint": "37e6c4bdec10adc8e3417fa83b2c91d466dcb9c04de25caf75892b67b0161f82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70001"
      ],
      "target_text": "Tôi mà không có ngài, đã không thể tưởng tượng nổi\nkhoảnh khắc đó…kẻ bị nuốt chửng linh hồn\ncó lẽ sẽ là tôi…",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:fa4811437f7fd6594e23f1d1",
      "kind": "character_system_text",
      "source_text": "心情紧绷起来…\n为了不展现出不得体的模样。",
      "source_fingerprint": "3c03c670acb6c3b2bbbe8b1bacb501999baeba4ce0eacff1740f742a52b84445",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70004"
      ],
      "target_text": "Tâm trạng bỗng căng thẳng hẳn lên…\nđể không lộ ra dáng vẻ thất thố.",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:349bb6baddc87041d0cecfe2",
      "kind": "character_system_text",
      "source_text": "非常可爱的服装…令人害羞呢。",
      "source_fingerprint": "5ae127d7033b9b73695de8efea1425873fc938a39681e7ad65fd01306763e2bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70008"
      ],
      "target_text": "Bộ trang phục dễ thương quá…khiến người ta thấy ngại ngùng.",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:d0638537cbe1cf602b3dd10c",
      "kind": "character_system_text",
      "source_text": "愿这副模样，能成为您的骄傲。",
      "source_fingerprint": "1231c1e94264701489eff9a3a18500c410cb6c301f38d717e7f70d9f6100ce6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70009"
      ],
      "target_text": "Mong rằng dáng vẻ này, có thể trở thành niềm tự hào của ngài.",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:1df1a666f0ed249be408a28f",
      "kind": "character_system_text",
      "source_text": "制服让人安心呢。\n因为我不喜欢…展现个性。",
      "source_fingerprint": "eea4d824bb1d9f4172711d59df92ca0cf4bd2fd2ed7441bbfddb095818038b30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70010"
      ],
      "target_text": "Đồng phục khiến người ta thấy an tâm nhỉ.\nVì tôi không thích…phô bày cá tính của mình.",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:dc729174d50aa41359f18fd4",
      "kind": "character_system_text",
      "source_text": "要给粉丝们展现美好的笑容…呢。",
      "source_fingerprint": "589a6ce9e07d5ff834df073e40a7f2773d3243c458bc3ca0eedfa9c5e1338db8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70014"
      ],
      "target_text": "Phải cho các fan thấy nụ cười thật đẹp…nhỉ.",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:129e1994939eb28110d750e8",
      "kind": "character_system_text",
      "source_text": "在这里，必须隐藏…卑劣的本性。",
      "source_fingerprint": "b14d5cb7223956131cbb3a215ff9dbc9d5fb91a7da08f9b23a7d5d68329c3fcc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70015"
      ],
      "target_text": "Ở đây, tôi phải giấu đi…bản tính đê hèn của mình.",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:f31130f59629b783047ec8de",
      "kind": "character_system_text",
      "source_text": "即使装扮成各种模样…\n其中潜藏的东西，不会改变。",
      "source_fingerprint": "ddad92dc5a8d92d703fbc3af8a2d072f62da7e5c98107023a51b79d5d62599fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70018"
      ],
      "target_text": "Dù có hóa trang thành đủ mọi dáng vẻ…\nthứ ẩn giấu bên trong cũng sẽ không thay đổi.",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:d4dfdb34ac55c700bf2b2369",
      "kind": "character_system_text",
      "source_text": "服装是映照自我的镜子…现在的我，看起来如何？",
      "source_fingerprint": "4cc4f041511fa3dbe6ec80cf2191fc839150786c711f997f6b9dea0257454412",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70019"
      ],
      "target_text": "Trang phục là tấm gương phản chiếu bản thân…tôi lúc này, trông thế nào?",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:40d9f4f5e415bc58a3470e00",
      "kind": "character_system_text",
      "source_text": "在这种地方穿便服…总觉得\n好像变成了不良少女呢…",
      "source_fingerprint": "5d2466f7c264b888798f254956a24e509d47101569a083b491862e674beb8554",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70020"
      ],
      "target_text": "Mặc đồ thường ở nơi thế này…sao cứ thấy\nnhư mình biến thành cô gái hư hỏng vậy…",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:91370a3163501c820050d867",
      "kind": "character_system_text",
      "source_text": "如果您有时间的话…\n出去散散步之类的，如何？",
      "source_fingerprint": "be8d300406134bc36ffdf64b28ca8bc844e46dd75004c70ac084f849142c31c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "70021"
      ],
      "target_text": "Nếu ngài có thời gian…\nra ngoài dạo bộ một chút, ngài thấy sao?",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:199ecedb830ae97474de5e43",
      "kind": "character_system_text",
      "source_text": "心情紧绷起来…\n为了不展现出不得体的模样。",
      "source_fingerprint": "3c03c670acb6c3b2bbbe8b1bacb501999baeba4ce0eacff1740f742a52b84445",
