  "entries": [
    {
      "entry_index": 60,
      "uid": "zhcn:0250f7b46aacaef57aadd732",
      "kind": "character_system_text",
      "source_text": "我要变成鲑鱼！\n被风浪无情拍打，然后彻底变强！",
      "source_fingerprint": "22a64a7faa1bc8c9ac072e25d269cefceeb24c8b5477571fd55905b4058c0622",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1099", "92015"],
      "target_text": "Tôi sẽ trở thành cá hồi!\nMặc cho sóng gió quật vùi, tôi sẽ mạnh mẽ lên cho xem!",
      "reviewed": true
    },
    {
      "entry_index": 61,
      "uid": "zhcn:0de8f4c18356c1e6ed71506c",
      "kind": "character_system_text",
      "source_text": "还得更快才行。\n一旦在比赛中受到瞩目，\n苫小牧也能得到热切关注！",
      "source_fingerprint": "3762d9e0997acf4385d634d867c203995e96c7a57f0ec8e04e8d53411a306874",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1099", "92016"],
      "target_text": "Phải nhanh hơn nữa.\nNếu tôi được chú ý trong các cuộc đua,\nTomakomai cũng sẽ được mọi người quan tâm hơn!",
      "reviewed": true
    },
    {
      "entry_index": 62,
      "uid": "zhcn:74cb4c3ac363f55d4cef9fcb",
      "kind": "character_system_text",
      "source_text": "好~嘞，今天也要用北寄力量\n好好加油呗~！",
      "source_fingerprint": "0d6244249a6947478837c7cc849ed623525133d8c9dfcf79ede47b89c250c838",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1099", "92017"],
      "target_text": "Được~ rồi, hôm nay cũng dùng Hokki Power\nđể cố gắng thật nhiều nào~!",
      "reviewed": true
    },
    {
      "entry_index": 63,
      "uid": "zhcn:edeb20338d43f75b134de2bd",
      "kind": "character_system_text",
      "source_text": "下次度假，\n一定会带来好消息的……\n等着我，大家！",
      "source_fingerprint": "884e40e39dd72de5770a416f6e478b2efc8f24e7dcd755f3934d0ffd7422a3ab",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1099", "92018"],
      "target_text": "Kỳ nghỉ lần tới,\ntôi nhất định sẽ mang tin vui về……\nMọi người cứ chờ tôi nhé!",
      "reviewed": true
    },
    {
      "entry_index": 64,
      "uid": "zhcn:9f91402c4f1985ac68717b95",
      "kind": "character_system_text",
      "source_text": "感觉肩膀有些放松下来了。\n……不是独自一人的话\n心里就踏实多了呢。",
      "source_fingerprint": "70168d7b576eae6558ed7e19749845f3a2be599deacfe86b59bf4763ec5ebd42",
      "source_path": "character_system_text_dict.json",
      "json_path": ["1099", "92020"],
      "target_text": "Cảm giác đôi vai đã thả lỏng hơn rồi.\n……Khi không phải ở một mình,\ntôi cũng thấy yên tâm hơn hẳn.",
      "reviewed": true
    }
  ]
}
