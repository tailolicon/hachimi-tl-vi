haracter_system_text","source_text":"お気に召したかい、アモーレ？","source_fingerprint":"c7a4c607d00fffbd9926f7951c2a3e37ae8b1bc0e55671a5f3fff8de7706f1ed","source_path":"character_system_text_dict.json","json_path":["1102","71018"],"target_text":"Có hợp ý cậu không, amore?","reviewed":true}]}