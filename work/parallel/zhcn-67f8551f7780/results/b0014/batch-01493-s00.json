{
  "schema_version": 1,
  "status": "complete",
  "epoch": "zhcn-67f8551f7780",
  "task_id": "batch-01493-s00",
  "batch": 1493,
  "shard": 0,
  "shard_start": 0,
  "shard_end_exclusive": 20,
  "worker_id": "claude-sonnet5-w4-20260904T213200Z",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "translated_count": 20,
  "entries": [
    {
      "entry_index": 0,
      "uid": "zhcn:aa6e666225e35b3bd0427310",
      "kind": "character_system_text",
      "source_text": "谢谢你一直为我照亮前进的道路。\r\n多亏了你，我才能够直直地往前跑！",
      "source_fingerprint": "ddb955bcdc4f2348f4258b8b16ed890cef0f319c1bd5da251d3555ab1a3fe5cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92007"
      ],
      "target_text": "Cảm ơn cậu vì đã luôn thắp sáng con đường phía trước cho tôi.\r\nNhờ có cậu mà tôi mới có thể chạy thẳng về phía trước!",
      "reviewed": true
    },
    {
      "entry_index": 1,
      "uid": "zhcn:715dff094290493900622884",
      "kind": "character_system_text",
      "source_text": "持续沐浴夏日的阳光，\r\n应该就能不怕热了！\r\n好了，GO——！",
      "source_fingerprint": "1af5f38e394b93c7a8e5a262b488b692aae0f196e562a00cff0ecf6a36e9ed1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92011"
      ],
      "target_text": "Cứ tiếp tục tắm mình trong ánh nắng mùa hè,\r\nlà sẽ không còn sợ nóng nữa thôi!\r\nĐược rồi, GO──!",
      "reviewed": true
    },
    {
      "entry_index": 2,
      "uid": "zhcn:63c767638363c4494fcc4725",
      "kind": "character_system_text",
      "source_text": "为了今后能够传承未来……\n训练就拜托了！",
      "source_fingerprint": "7bcef58f196312caa8744dda7bc2af9cf8b29f3b7aa3760cb4ca9717889bbc35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92015"
      ],
      "target_text": "Để sau này có thể tiếp nối tương lai……\nHuấn luyện thì nhờ cậu nhé!",
      "reviewed": true
    },
    {
      "entry_index": 3,
      "uid": "zhcn:c7684f7bc8aa528b7f7ac8e2",
      "kind": "character_system_text",
      "source_text": "让他人从自己的奔跑中看到梦想，\n我想以此为目标。",
      "source_fingerprint": "590b4f815df0d842d309508f8230f925f849049ef937da342c32282fc7fd0236",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92016"
      ],
      "target_text": "Để người khác nhìn thấy giấc mơ qua từng bước chạy của mình,\ntôi muốn lấy đó làm mục tiêu.",
      "reviewed": true
    },
    {
      "entry_index": 4,
      "uid": "zhcn:5eea1fb416da125159c2fe5d",
      "kind": "character_system_text",
      "source_text": "今天也很风和日丽呢~……\n啊，不行！要随时保持状态！\n好~嘞……要上了！",
      "source_fingerprint": "01864111990cce002d1660ebfbdc033d3509968dc288fd2dac5101352e68673d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92017"
      ],
      "target_text": "Hôm nay cũng nắng đẹp gió hiu hiu thật~……\nA, không được! Phải luôn giữ phong độ mới được!\nĐược~ rồi……xuất phát thôi!",
      "reviewed": true
    },
    {
      "entry_index": 5,
      "uid": "zhcn:221f35163afb55fd2f54202c",
      "kind": "character_system_text",
      "source_text": "太阳下头冠正闪闪发亮！\n我也要跑得闪闪发亮！",
      "source_fingerprint": "e3403754b36e3df624e41ef01924a76c7c5dd087319962a9d5ca8258c98c993d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92018"
      ],
      "target_text": "Dưới ánh mặt trời, chiếc Tiara đang lấp lánh tỏa sáng!\nTôi cũng muốn chạy thật rực rỡ như thế!",
      "reviewed": true
    },
    {
      "entry_index": 6,
      "uid": "zhcn:6dfc327b548b36c2885bb891",
      "kind": "character_system_text",
      "source_text": "我想开辟一条\n只有自己才能够传承的道路……\n为此，我要变得更强！",
      "source_fingerprint": "0ff3cd8907cb1c3b6c13d5382dea46869f459ec6dda3dbaae0558ff4e5b7bffb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92020"
      ],
      "target_text": "Tôi muốn khai mở một con đường\nmà chỉ riêng mình tôi mới có thể tiếp nối……\nVì vậy, tôi phải trở nên mạnh mẽ hơn nữa!",
      "reviewed": true
    },
    {
      "entry_index": 7,
      "uid": "zhcn:f19c07a89e25295775f017dc",
      "kind": "character_system_text",
      "source_text": "未来必将由我的双脚开辟。\n所以……我跑过的每一步，\n希望都能一直留存在你心里。",
      "source_fingerprint": "b340fe845bee800a8db31345c9ad04a70442e8f0fa8f38f18cfb5b6bd6087d42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92021"
      ],
      "target_text": "Tương lai chắc chắn sẽ được mở ra bởi chính đôi chân này của tôi.\nVì vậy……từng bước tôi đã chạy qua,\ntôi mong rằng sẽ luôn lưu lại mãi trong trái tim cậu.",
      "reviewed": true
    },
    {
      "entry_index": 8,
      "uid": "zhcn:7ead4088110d74deb45d8090",
      "kind": "character_system_text",
      "source_text": "我奔跑的轨迹，我奔跑过的证明……\n希望它能一直，一~直延续到未来。",
      "source_fingerprint": "af65128799483ba09f07dc0a6705bd45dedecf549330c673e79504bc123d7fda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "92022"
      ],
      "target_text": "Dấu vết tôi đã chạy qua, minh chứng cho những gì tôi đã chạy……\ntôi mong nó sẽ mãi, mãi mãi nối tiếp đến tương lai.",
      "reviewed": true
    },
    {
      "entry_index": 9,
      "uid": "zhcn:ab7952c0f5dcf0215a008206",
      "kind": "character_system_text",
      "source_text": "这条道路前方所连结的东西，\r\n我想和你一起守护。",
      "source_fingerprint": "761617b5f5654e90b5875ab721d3460b51d427b5b13b4c6be811682b40ddf763",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "93000"
      ],
      "target_text": "Điều được kết nối ở phía trước con đường này,\r\ntôi muốn cùng cậu bảo vệ nó.",
      "reviewed": true
    },
    {
      "entry_index": 10,
      "uid": "zhcn:35f48c0740ca6e12284ccc13",
      "kind": "character_system_text",
      "source_text": "冲线~~！\r\n我奔跑过的证明，\r\n留存下来了呢！",
      "source_fingerprint": "b1168f06420bed0013f10ce83be3666623cb80c2755f0db255cdd7881b76af85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "93001"
      ],
      "target_text": "Về đích~~!\r\nMinh chứng cho những gì tôi đã chạy,\r\nđã được lưu lại rồi đấy!",
      "reviewed": true
    },
    {
      "entry_index": 11,
      "uid": "zhcn:c5181f44185566db92a5f608",
      "kind": "character_system_text",
      "source_text": "让我们一起\n去不断开辟前方的道路吧！",
      "source_fingerprint": "32a10f891cdf4376b5456bcb47664d7063cb35bafef8486466de25a531242391",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "93004"
      ],
      "target_text": "Hãy cùng nhau\nkhông ngừng khai mở con đường phía trước nào!",
      "reviewed": true
    },
    {
      "entry_index": 12,
      "uid": "zhcn:0d9f0cb9810d29d863cd7b14",
      "kind": "character_system_text",
      "source_text": "这就是我的轨迹。\n不知道有没有给谁\n……带来梦想呢？",
      "source_fingerprint": "727434d14f29e62b253ed248dcf06caf288bbe17be66f3de9cb3464ba7a35eb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "93005"
      ],
      "target_text": "Đây chính là dấu vết của tôi.\nKhông biết có mang đến giấc mơ\n……cho ai đó hay không nhỉ?",
      "reviewed": true
    },
    {
      "entry_index": 13,
      "uid": "zhcn:9eb49cf3044d4035d51e0b0b",
      "kind": "character_system_text",
      "source_text": "离后冠更进一步了！",
      "source_fingerprint": "fc56919901a9687cfca128dc6816f1b314669bcd184d3fddebb8c829a0b8e7f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95000"
      ],
      "target_text": "Đã tiến thêm một bước gần hơn tới Tiara rồi!",
      "reviewed": true
    },
    {
      "entry_index": 14,
      "uid": "zhcn:22049f194b0e420445fa2ecd",
      "kind": "character_system_text",
      "source_text": "用这份力量，去开辟道路！",
      "source_fingerprint": "49dc8d6588419f55452c604af0db6f45c1fb9a8560a0a0b68db35ed017d29f01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95001"
      ],
      "target_text": "Bằng Power này, hãy khai mở con đường!",
      "reviewed": true
    },
    {
      "entry_index": 15,
      "uid": "zhcn:c994884b20ad89b4b61fa323",
      "kind": "character_system_text",
      "source_text": "莱茵力量。目标是，后冠！",
      "source_fingerprint": "88c67d8e82b98c364c88175a0c4d46cb7f5f7311673d6c7d9a1b0daedaf3d9cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95003"
      ],
      "target_text": "Rhein Kraft — nghĩa là 'Power'. Mục tiêu là, Tiara!",
      "reviewed": true
    },
    {
      "entry_index": 16,
      "uid": "zhcn:e00908811d786c65cb72860c",
      "kind": "character_system_text",
      "source_text": "为了将心意与某人联系在一起。\r\n我会不断进行挑战。",
      "source_fingerprint": "1266d48eb9b3261ae9ecf4cae88c7a5a0560075fa8967ca5bc0c8412a4d87616",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95004"
      ],
      "target_text": "Để kết nối tâm ý này với một ai đó.\r\nTôi sẽ không ngừng thử thách bản thân.",
      "reviewed": true
    },
    {
      "entry_index": 17,
      "uid": "zhcn:a1e679eadb67b4c991176e5d",
      "kind": "character_system_text",
      "source_text": "我来领头！",
      "source_fingerprint": "024ac4b84219f36d44cdba21f13b28265cb4e2b35a2a24fdf7f5ca76c1d38709",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95005"
      ],
      "target_text": "Để tôi dẫn đầu nào!",
      "reviewed": true
    },
    {
      "entry_index": 18,
      "uid": "zhcn:6f314c28bc63b4a980ebd158",
      "kind": "character_system_text",
      "source_text": "为了与未来相连！",
      "source_fingerprint": "e3aaeadbe12b066c781634e88669b6016d92c2d87ab17c8926bb078bd022f4c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95006"
      ],
      "target_text": "Để kết nối với tương lai!",
      "reviewed": true
    },
    {
      "entry_index": 19,
      "uid": "zhcn:8d7b0705b96eed64bea70c42",
      "kind": "character_system_text",
      "source_text": "开拓未来的接力棒，就由我来传递！",
      "source_fingerprint": "f101ebb473dabc4c619468dea757485cac0d63ad82deb26ea93d82eb3e3ebebd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "95007"
      ],
      "target_text": "Cây gậy tiếp sức khai mở tương lai, hãy để tôi truyền lại!",
      "reviewed": true
    }
  ]
}
