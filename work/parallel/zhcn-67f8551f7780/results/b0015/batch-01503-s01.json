  "translated_count": 15,
  "entries": [
    {"entry_index":20,"uid":"zhcn:429ea3914d99ef35ca4c791d","kind":"character_system_text","source_text":"被看到丢人的一面了……","source_fingerprint":"fc49cc6ef454b4224da5befcc63a3ff1ee7aa71f404627d34056415c050fb22d","source_path":"character_system_text_dict.json","json_path":["1114","30003"],"target_text":"Bị anh thấy bộ dạng đáng xấu hổ mất rồi…","reviewed":true},
    {"entry_index":21,"uid":"zhcn:0131b7be82673a4803ec9c1e","kind":"character_system_text","source_text":"你也看见那片“绝景”了吧……！\n……呜……","source_fingerprint":"835f060df6a76cae3a94b709b82b3292edd46feefb79595a67583a6748d3545e","source_path":"character_system_text_dict.json","json_path":["1114","30004"],"target_text":"Anh cũng đã thấy khung cảnh tuyệt đẹp ấy rồi nhỉ…!\n…Ư…","reviewed":true},
    {"entry_index":22,"uid":"zhcn:ba23ff55e964a38d104a1c0d","kind":"character_system_text","source_text":"谢谢支持……\n大家的声音都成了我的力量……！","source_fingerprint":"7d02ae2fcc2330971172b78740fb86753d7c88cde30cea30f2235d8e126bdf0e","source_path":"character_system_text_dict.json","json_path":["1114","30005"],"target_text":"Cảm ơn mọi người đã cổ vũ…\nTiếng cổ vũ của mọi người đã tiếp thêm sức mạnh cho em…!","reviewed":true},
    {"entry_index":23,"uid":"zhcn:cf293bbdd8f2611d584af128","kind":"character_system_text","source_text":"我出发啦！","source_fingerprint":"7a81719318f354a289fa32effff3e0060c6af596527f262f806d5f1b7f27b877","source_path":"character_system_text_dict.json","json_path":["1114","31000"],"target_text":"Em đi đây!","reviewed":true},
    {"entry_index":24,"uid":"zhcn:abe2e8bb64a0e9bf16a8087e","kind":"character_system_text","source_text":"和你一起……！","source_fingerprint":"0177db8d422477ea9e6ce1baf2e66e59e717e34dda217aa42b208e08708aae7d","source_path":"character_system_text_dict.json","json_path":["1114","40000"],"target_text":"Cùng với anh…!","reviewed":true},
    {"entry_index":25,"uid":"zhcn:3e0c9268fe7c5fe421f9e728","kind":"character_system_text","source_text":"想法枯竭的话先来喝茶吧。\n低糖蔬菜蛋糕，\n宿舍的大家都很喜欢哦♪","source_fingerprint":"de34169dc61e11cd4a590c0e8ebd452308aa2ff1f2d312c4f3fb9132ee09673b","source_path":"character_system_text_dict.json","json_path":["1114","400002"],"target_text":"Nếu cạn ý tưởng thì uống trà trước nhé.\nBánh rau củ ít đường này,\nmọi người trong ký túc xá đều thích lắm đó♪","reviewed":true},
    {"entry_index":26,"uid":"zhcn:8386dc93af1da7d2018f8021","kind":"character_system_text","source_text":"咳、咳、嗯。哟……哟兄弟伙。\n……啊，好像比上次\n说得顺畅些了……？","source_fingerprint":"a4a6ce0f9c9ace07d4ce0aeb2b7c8892408f2494cca76b6cce32656c251c8838","source_path":"character_system_text_dict.json","json_path":["1114","400005"],"target_text":"Khụ, khụ, ừm. Yo… yo, anh em.\n…À, hình như lần này\nem nói trôi chảy hơn lần trước rồi…?","reviewed":true},
    {"entry_index":27,"uid":"zhcn:809fe1d141f1c5d668a4982e","kind":"character_system_text","source_text":"那个约定，至今仍刻在心中——\n绝对要和你一同抵达……！","source_fingerprint":"266051bf62fe6f8d25d49696dac1cfd83d0aaef8144833edab7db27f9ee83378","source_path":"character_system_text_dict.json","json_path":["1114","40001"],"target_text":"Lời hứa ấy đến giờ vẫn khắc sâu trong tim—\nNhất định em sẽ cùng anh tới được nơi đó…!","reviewed":true},
    {"entry_index":28,"uid":"zhcn:dd91bfb479b6953be35007b2","kind":"character_system_text","source_text":"传达出的点点光芒，实在\n太过美丽……这充满回忆的照片，\n我想设为手机壁纸♪","source_fingerprint":"faca058ddc4351b88747d58591def226836974e8996128c853783ced53af328d","source_path":"character_system_text_dict.json","json_path":["1114","400014"],"target_text":"Những tia sáng truyền tới thật sự\nđẹp quá… Bức ảnh đầy kỷ niệm này,\nem muốn đặt làm hình nền điện thoại♪","reviewed":true},
    {"entry_index":29,"uid":"zhcn:1dda74e920cfe25d027fd181","kind":"character_system_text","source_text":"要把『谢谢』传达给大家！","source_fingerprint":"16bf4c7d58168102fa01342ac34bf31a16d1d0c7a19e9343d7c8b607972734df","source_path":"character_system_text_dict.json","json_path":["1114","60000"],"target_text":"Em muốn gửi lời 『cảm ơn』 đến mọi người!","reviewed":true},
    {"entry_index":30,"uid":"zhcn:09bba97a8d2b28909f62c328","kind":"character_system_text","source_text":"即使在舞台上，\n也要把最棒的景色……！","source_fingerprint":"1563babbfd2bf0f41cd3d544745fa0f6cd1b8f63838bee72dd5762f4a393070d","source_path":"character_system_text_dict.json","json_path":["1114","60001"],"target_text":"Ngay cả trên sân khấu,\nem cũng muốn mang đến khung cảnh tuyệt vời nhất…!","reviewed":true},
    {"entry_index":31,"uid":"zhcn:5b1393d8f80312fa885e01ca","kind":"character_system_text","source_text":"那片景色，一起去见证吧。","source_fingerprint":"225a02a8978bb315112c7f61b32f630a3f720224dab0252f68e88f992a3a36eb","source_path":"character_system_text_dict.json","json_path":["1114","70000"],"target_text":"Hãy cùng nhau chứng kiến khung cảnh ấy nhé.","reviewed":true},
    {"entry_index":32,"uid":"zhcn:5543d986a90c8d2c472545a3","kind":"character_system_text","source_text":"有着同样的梦想——\n能够共同追逐憧憬的“绝景”……\n有这样的人在我真的很幸福呢。","source_fingerprint":"9d245a1daaeabd502982ced120e016fc244e5ab0fd8ee66f25a934253d2ba2b1","source_path":"character_system_text_dict.json","json_path":["1114","70001"],"target_text":"Cùng chung một giấc mơ—\ncó người cùng em theo đuổi “khung cảnh tuyệt đẹp” hằng ao ước…\nem thật sự rất hạnh phúc.","reviewed":true},
    {"entry_index":33,"uid":"zhcn:07c7e93b7693d49bf158245d","kind":"character_system_text","source_text":"这套制服是努力的证明。\n就和你的徽章一样呢！","source_fingerprint":"5189287b9070b4709de05ecedf2d4f1874f95bbca54807554ac954953dd28340","source_path":"character_system_text_dict.json","json_path":["1114","70004"],"target_text":"Bộ đồng phục này là minh chứng cho những nỗ lực của em.\nGiống như huy hiệu của anh vậy!","reviewed":true},
    {"entry_index":34,"uid":"zhcn:b65bd089761eea6a76ce935f","kind":"character_system_text","source_text":"即便在Live上，\n也想让大家看到绝景！","source_fingerprint":"3226896045fd3fcfb044a46447a4115b9d46091b681ab39b3819ee27106827b6","source_path":"character_system_text_dict.json","json_path":["1114","70008"],"target_text":"Ngay cả trên Live,\nem cũng muốn cho mọi người thấy khung cảnh tuyệt đẹp ấy!","reviewed":true}
  ],
