    {"entry_index":40,"uid":"zhcn:20c5fae92cf477e12bafa626","kind":"character_system_text","source_text":"怎么样？\n……有变得和平常不一样吗？","source_fingerprint":"873f581e62d58bf071c02f0ad35d2d66e9883ebd280c11fb9e32c5860a2bc6a0","source_path":"character_system_text_dict.json","json_path":["1114","70019"],"target_text":"Thế nào?\n…Trông em có khác mọi ngày không?","reviewed":true},
    {"entry_index":41,"uid":"zhcn:14da0cb98a98c86f1ba01238","kind":"character_system_text","source_text":"呐，一起出门吧？","source_fingerprint":"07874cf38e99727b7ede81df4eb644d63dd9747967e0ecad768069c803a53c3d","source_path":"character_system_text_dict.json","json_path":["1114","70020"],"target_text":"Này, mình cùng ra ngoài nhé?","reviewed":true},
    {"entry_index":42,"uid":"zhcn:ba889078d19c7278fe79dd20","kind":"character_system_text","source_text":"我的喜好一直没变哦。\n还是很喜欢可爱的衣服！","source_fingerprint":"8d8fb58c87d3ae61742365ea12f750b9de7648a6be86773441f8374e3da05f52","source_path":"character_system_text_dict.json","json_path":["1114","70021"],"target_text":"Sở thích của em vẫn chẳng thay đổi đâu.\nEm vẫn rất thích những bộ đồ dễ thương!","reviewed":true},
    {"entry_index":43,"uid":"zhcn:1d1ae67d2c0db9f465434db2","kind":"character_system_text","source_text":"这套制服是努力的证明。\n就和你的徽章一样呢！","source_fingerprint":"5189287b9070b4709de05ecedf2d4f1874f95bbca54807554ac954953dd28340","source_path":"character_system_text_dict.json","json_path":["1114","71004"],"target_text":"Bộ đồng phục này là minh chứng cho những nỗ lực của em.\nGiống như huy hiệu của anh vậy!","reviewed":true},
    {"entry_index":44,"uid":"zhcn:8175b0087f84e09c0d9f16c8","kind":"character_system_text","source_text":"即便在Live上，\n也想让大家看到绝景！","source_fingerprint":"3226896045fd3fcfb044a46447a4115b9d46091b681ab39b3819ee27106827b6","source_path":"character_system_text_dict.json","json_path":["1114","71008"],"target_text":"Ngay cả trên Live,\nem cũng muốn cho mọi người thấy khung cảnh tuyệt đẹp ấy!","reviewed":true}
