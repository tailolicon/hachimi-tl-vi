    {"entry_index":40,"uid":"zhcn:d3075b2e9739edb1974f9f57","kind":"character_system_text","source_text":"まいりましょう。","source_fingerprint":"7649606ba64bd115f061bcad811531899eef88e8676bafd30764edc12fa46186","source_path":"character_system_text_dict.json","json_path":["1116","2030"],"target_text":"Đi thôi nào.","reviewed":true},
    {"entry_index":41,"uid":"zhcn:1dce63450c9579c29d29ef3f","kind":"character_system_text","source_text":"目指すは勝利のみでしてよ。","source_fingerprint":"b657d29bc169e294c2186bbbb8f50922fbebbfd1115a6c4574e2401676c88d62","source_path":"character_system_text_dict.json","json_path":["1116","2031"],"target_text":"Mục tiêu duy nhất là chiến thắng.","reviewed":true},
    {"entry_index":42,"uid":"zhcn:d597f51556cd185318cef621","kind":"character_system_text","source_text":"感謝いたしますわ。","source_fingerprint":"754da2127865554214eeabb3d5c2d91765ab65c01d8184ee4cbb5bc5ecdf3137","source_path":"character_system_text_dict.json","json_path":["1116","2032"],"target_text":"Tôi xin cảm ơn.","reviewed":true},
    {"entry_index":43,"uid":"zhcn:d2bca68d916208a9da697a31","kind":"character_system_text","source_text":"時間ね。\r\nレースも観客も、\r\n『勝者』を待っていてよ。","source_fingerprint":"05f3f62887c5ca05cf16feb69504af686cd46d80fbaa92fb1b4f7a979ebda02f","source_path":"character_system_text_dict.json","json_path":["1116","2033"],"target_text":"Đến giờ rồi.\r\nCả cuộc đua lẫn khán giả\r\nđều đang chờ đợi “người chiến thắng”.","reviewed":true},
    {"entry_index":44,"uid":"zhcn:d358cb51f5b7216ca30cc487","kind":"character_system_text","source_text":"ここは通過点ですわ。\r\n貴方も、この先を見据えなさい。","source_fingerprint":"7397b37c8a80a35d49b022c61caba738d57ac589cea5dae2d184ad7a3be91889","source_path":"character_system_text_dict.json","json_path":["1116","2034"],"target_text":"Đây chỉ là một điểm trên hành trình.\r\nAnh cũng hãy nhìn xa hơn về phía trước đi.","reviewed":true},
    {"entry_index":45,"uid":"zhcn:1121d3323a3fa7a6d497aa34","kind":"character_system_text","source_text":"感謝いたしますわ。","source_fingerprint":"754da2127865554214eeabb3d5c2d91765ab65c01d8184ee4cbb5bc5ecdf3137","source_path":"character_system_text_dict.json","json_path":["1116","2035"],"target_text":"Tôi xin cảm ơn.","reviewed":true},
    {"entry_index":46,"uid":"zhcn:9b4c6630c59505af8e50a8b7","kind":"character_system_text","source_text":"さて。","source_fingerprint":"4ccc0a4c1d8553a1216b70a22cc2817117c30e5db50980ed67df860ae5ad58f0","source_path":"character_system_text_dict.json","json_path":["1116","23015"],"target_text":"Nào.","reviewed":true},
    {"entry_index":47,"uid":"zhcn:a4015ee7cd95d06cb01625c9","kind":"character_system_text","source_text":"勝利以外は無価値。次よ。","source_fingerprint":"663720c2cdcfe03a55d08b2507da9497d028f70bf4e4bf7058a179e6bfd74f8f","source_path":"character_system_text_dict.json","json_path":["1116","30000"],"target_text":"Ngoài chiến thắng ra, tất cả đều vô giá trị. Tiếp theo.","reviewed":true},
    {"entry_index":48,"uid":"zhcn:e58824fb0f21b1d2deffb3fd","kind":"character_system_text","source_text":"あるべき姿を、必ず取り戻さねば。","source_fingerprint":"d5d13732bf6cb4733945fb843b08b9a58393ed1f1c5f5929f9eafa2d3f3ad59e","source_path":"character_system_text_dict.json","json_path":["1116","30001"],"target_text":"Nhất định phải lấy lại dáng vẻ vốn có.","reviewed":true},
    {"entry_index":49,"uid":"zhcn:a364dcb8988f224a8bd9d320","kind":"character_system_text","source_text":"トレーニングの準備をなさい。","source_fingerprint":"e0fb7d97b23d5122edb6bc834a2ca4600f0245b99be7a03f8a03f1ca71757272","source_path":"character_system_text_dict.json","json_path":["1116","30002"],"target_text":"Hãy chuẩn bị cho buổi Training đi.","reviewed":true},
    {"entry_index":50,"uid":"zhcn:429ab609dc298a1519bfd312","kind":"character_system_text","source_text":"…許されませんわ。","source_fingerprint":"fb2e791f6f2166994f48cfded79d2baa1acd99560919d77e39c6cff53c0f763d","source_path":"character_system_text_dict.json","json_path":["1116","30003"],"target_text":"…Không thể tha thứ được.","reviewed":true},
    {"entry_index":51,"uid":"zhcn:2c5ddc4ea0fbac80f70d9e61","kind":"character_system_text","source_text":"私こそ勝者、私こそ最強。\r\nよろしくて？","source_fingerprint":"c2d9bc1b6a39f20ffbbda6276daf29007502c101a6e3127a3a59cf81d9e03676","source_path":"character_system_text_dict.json","json_path":["1116","30004"],"target_text":"Chính tôi là người chiến thắng, chính tôi là mạnh nhất.\r\nRõ chưa?","reviewed":true},
    {"entry_index":52,"uid":"zhcn:2d5c8139132fb915f5853e7b","kind":"character_system_text","source_text":"強さとは、かくあるべき――でしょう？","source_fingerprint":"935bbb0febf5a521ca37a8ae2f5b5845fbbd29625cbb8d004137c094580e7ad0","source_path":"character_system_text_dict.json","json_path":["1116","30005"],"target_text":"Sức mạnh phải là như thế này—phải không?","reviewed":true},
    {"entry_index":53,"uid":"zhcn:9083f47fd4b3996a96124d0f","kind":"character_system_text","source_text":"楽しめそうね。","source_fingerprint":"3b72e69d9261b8dac1db8688f919661a430cb4d8f934fd9187a25f3898cb0ed7","source_path":"character_system_text_dict.json","json_path":["1116","31000"],"target_text":"Có vẻ sẽ vui đây.","reviewed":true},
    {"entry_index":54,"uid":"zhcn:003f94974e517d96cc2b2ad3","kind":"character_system_text","source_text":"ごめんあそばせ。","source_fingerprint":"3bae8612b0fb845476733fa684c815a98d221f4b49c8d60d0e4b7c45f70e4b21","source_path":"character_system_text_dict.json","json_path":["1116","40000"],"target_text":"Xin thứ lỗi.","reviewed":true}
