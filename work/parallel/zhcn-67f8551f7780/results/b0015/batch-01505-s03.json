    {"entry_index":63,"uid":"zhcn:ef9b5998b161e7ffb56bdb5c","kind":"character_system_text","source_text":"胸のリボンの程よい主張。\r\nいい引き立て役ね。","source_fingerprint":"dc74f42d844bafa8091c216de0ef6a88d6ca36e48a9398189020556a95c9cecc","source_path":"character_system_text_dict.json","json_path":["1116","70010"],"target_text":"Chiếc nơ trước ngực nổi bật vừa đủ.\r\nLàm nền rất tốt đấy.","reviewed":true},
