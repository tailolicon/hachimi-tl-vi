  "entries": [
    {"entry_index":60,"uid":"zhcn:a1abb0f2a46baa5cf0026a05","kind":"character_system_text","source_text":"干脆利落地解决掉吧。","source_fingerprint":"db6e13c595863f9e5b61f1152cb875b8dffa6665b98361022fa4d1fa373e7737","source_path":"character_system_text_dict.json","json_path":["1118","20051"],"target_text":"Giải quyết cho gọn thôi.","reviewed":true},
    {"entry_index":61,"uid":"zhcn:c29db7a7aad620a11209fdc3","kind":"character_system_text","source_text":"……快点结束吧。","source_fingerprint":"021787757c33b7bd391462d2273eff62752824bede31e96ec11ae13a32ee948c","source_path":"character_system_text_dict.json","json_path":["1118","2030"],"target_text":"…Kết thúc nhanh thôi.","reviewed":true},
    {"entry_index":62,"uid":"zhcn:05a9e436162217c3ad80b080","kind":"character_system_text","source_text":"请多关照……","source_fingerprint":"76e546beb607c78391a13a35fae42de155540fc89abd524192b761dd1d1f1747","source_path":"character_system_text_dict.json","json_path":["1118","2031"],"target_text":"Mong anh giúp đỡ…","reviewed":true},
    {"entry_index":63,"uid":"zhcn:26c16cc8c140ae6e807e009b","kind":"character_system_text","source_text":"受您照顾了。","source_fingerprint":"9c26dbd47850b3db4af939815161583cd3f5cd1c566fc5cad29ffbdb9e899aab","source_path":"character_system_text_dict.json","json_path":["1118","2032"],"target_text":"Cảm ơn anh đã giúp đỡ.","reviewed":true},
    {"entry_index":64,"uid":"zhcn:168955c0caa503fe1c2882da","kind":"character_system_text","source_text":"耳机，带了。\r\n歌也存进去了……嗯。\r\n在休息室里也能集中精神了。","source_fingerprint":"e59a66e490d01165a26571e71583c2680ae348c969f022e7aaac03faae68be4a","source_path":"character_system_text_dict.json","json_path":["1118","2033"],"target_text":"Tai nghe, đã mang theo.\r\nNhạc cũng lưu sẵn rồi… Ừm.\r\nGiờ ở phòng chờ cũng có thể tập trung.","reviewed":true},
    {"entry_index":65,"uid":"zhcn:0927dfd8b610c5aa3ee9c61d","kind":"character_system_text","source_text":"我不会让任何人追上。我所积累\n的东西比任何人都要多……\n不容许有任何松懈……！","source_fingerprint":"a2f288cc33700456d24a9187eacafb2c9c5fb6436a17d3b264e57f7d117c652d","source_path":"character_system_text_dict.json","json_path":["1118","2034"],"target_text":"Tôi sẽ không để bất kỳ ai đuổi kịp. Những gì tôi tích lũy\nnhiều hơn bất kỳ ai khác…\nKhông được phép lơi lỏng dù chỉ một chút…!","reviewed":true},
    {"entry_index":66,"uid":"zhcn:7fa54867cfbabc99f6166148","kind":"character_system_text","source_text":"受您照顾了。","source_fingerprint":"9c26dbd47850b3db4af939815161583cd3f5cd1c566fc5cad29ffbdb9e899aab","source_path":"character_system_text_dict.json","json_path":["1118","2035"],"target_text":"Cảm ơn anh đã giúp đỡ.","reviewed":true},
    {"entry_index":67,"uid":"zhcn:688286336393d17ace39838e","kind":"character_system_text","source_text":"开始吧。","source_fingerprint":"5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299","source_path":"character_system_text_dict.json","json_path":["1118","23015"],"target_text":"Bắt đầu thôi.","reviewed":true},
    {"entry_index":68,"uid":"zhcn:541e39012387d1d5b75ded3f","kind":"character_system_text","source_text":"……为什么，在眼前错失了……！","source_fingerprint":"c2fa97b47d0294ffd794c2c461942b39adee603a771863342c718b3b39e5e2db","source_path":"character_system_text_dict.json","json_path":["1118","30000"],"target_text":"…Tại sao, lại để vuột mất ngay trước mắt…!","reviewed":true},
    {"entry_index":69,"uid":"zhcn:4872310e14a80b0e971d435f","kind":"character_system_text","source_text":"第3名……真是，难看。","source_fingerprint":"9507bbab7703068aced17e7989df59a7bd675c0de184731b947b020e06345195","source_path":"character_system_text_dict.json","json_path":["1118","30001"],"target_text":"Hạng 3… thật đáng xấu hổ.","reviewed":true},
    {"entry_index":70,"uid":"zhcn:57cb52888e54ad56df72f44f","kind":"character_system_text","source_text":"太不像话了……","source_fingerprint":"1127a1c722f9b799402b702c7f6492b7e778b76fd051cb057b17d45a0d6c61d4","source_path":"character_system_text_dict.json","json_path":["1118","30002"],"target_text":"Thật không thể chấp nhận được…","reviewed":true},
    {"entry_index":71,"uid":"zhcn:6b8b8d8174dfec000f2b0e00","kind":"character_system_text","source_text":"不可原谅……这样的话，我……！","source_fingerprint":"6259a7a0ee0a67539b242aa91a126cfacd18dd9ad7e439ced6bac194a9ab6b48","source_path":"character_system_text_dict.json","json_path":["1118","30003"],"target_text":"Không thể tha thứ… Cứ thế này, tôi…!","reviewed":true},
    {"entry_index":72,"uid":"zhcn:076ab192399a157d83a1fe96","kind":"character_system_text","source_text":"能达到至高境界的只有一人——那就是我。","source_fingerprint":"9247b9a44c5bdb2ecd990ca3d79a94d342f4174cc617eed103a97168a48cf618","source_path":"character_system_text_dict.json","json_path":["1118","30004"],"target_text":"Chỉ có một người có thể vươn tới đỉnh cao—đó là tôi.","reviewed":true},
    {"entry_index":73,"uid":"zhcn:cf196f6b54f47522ccf59461","kind":"character_system_text","source_text":"胜利是理所当然的。要强大到，能让人产生这种想法的程度……！","source_fingerprint":"0b87e7253a91e2844635af31da84df8c3d41b704f4dda66d677d8b5f48c472fa","source_path":"character_system_text_dict.json","json_path":["1118","30005"],"target_text":"Chiến thắng là điều hiển nhiên. Phải mạnh đến mức khiến người ta nghĩ như vậy…!","reviewed":true},
    {"entry_index":74,"uid":"zhcn:a2eea6ca29e0ec0acd34972d","kind":"character_system_text","source_text":"我只要全部赢下就好。","source_fingerprint":"67f370e797cb395ab9d5de671689580fd2feb1726fff67e52a8207baab568a0b","source_path":"character_system_text_dict.json","json_path":["1118","31000"],"target_text":"Tôi chỉ cần thắng tất cả là được.","reviewed":true},
    {"entry_index":75,"uid":"zhcn:36556f6c2d625abea0b6ca93","kind":"character_system_text","source_text":"来吧，尽情颤抖吧。","source_fingerprint":"018a4cca605cfccfa6eac8c4a364aa8c92bb04dabe5b907fb70d32a04f9b0aa9","source_path":"character_system_text_dict.json","json_path":["1118","40000"],"target_text":"Nào, cứ run rẩy cho thỏa thích đi.","reviewed":true}
