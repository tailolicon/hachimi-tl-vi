  "entries": [
    {"entry_index":0,"uid":"zhcn:e174cfc0003576793be8ac13","kind":"character_system_text","source_text":"在风雪交加的道路上，不甘于沉溺温暖——\r\n我选择了，那冻结一切的强大！","source_fingerprint":"d55a34a893cab0dbe8dd16e340e2bdf5bd9bfef6c713c74b7d70e1f237684bc4","source_path":"character_system_text_dict.json","json_path":["1118","40001"],"target_text":"Trên con đường giữa gió tuyết, tôi không cam lòng đắm mình trong hơi ấm—\r\nTôi đã chọn sức mạnh có thể đóng băng tất cả!","reviewed":true},
    {"entry_index":1,"uid":"zhcn:ad4f5ce5f2f4e5111e6b2ed3","kind":"character_system_text","source_text":"……我不需要，什么声援……","source_fingerprint":"e54c30fd0929730e05619f7e3d05d04033be6aa0ebc953013f8f2495afaebed4","source_path":"character_system_text_dict.json","json_path":["1118","60000"],"target_text":"……Tôi không cần… lời cổ vũ nào cả……","reviewed":true},
    {"entry_index":2,"uid":"zhcn:f1f3f087f60434bc4609b44e","kind":"character_system_text","source_text":"为了谁，为了什么……？","source_fingerprint":"bd30cd477706fd5de8a0a4010d0f016b3426ff9b31c611264871922c4ba1f99c","source_path":"character_system_text_dict.json","json_path":["1118","60001"],"target_text":"Vì ai, vì điều gì……?","reviewed":true},
    {"entry_index":3,"uid":"zhcn:3f7e11a11cd123a8676b44f9","kind":"character_system_text","source_text":"请不要，太在意我。","source_fingerprint":"c047fd7a0550c32e94b9bee66692f8d774ae4a26bc65e1428c36dcf7e7d8c0d1","source_path":"character_system_text_dict.json","json_path":["1118","70000"],"target_text":"Xin đừng quá bận tâm đến tôi.","reviewed":true},
    {"entry_index":4,"uid":"zhcn:84a392f61e6d12fd5f45e256","kind":"character_system_text","source_text":"……你是想要重新考虑\r\n契约吗？","source_fingerprint":"fa2fcdf24efe6326807f8acb87ded2aafdd68f28fb2d5ba4792e5f4f6489aec0","source_path":"character_system_text_dict.json","json_path":["1118","70001"],"target_text":"……Anh muốn cân nhắc lại\r\nhợp đồng sao?","reviewed":true},
    {"entry_index":5,"uid":"zhcn:80488e0a8e0fd6eaa6bdacc2","kind":"character_system_text","source_text":"皱纹，灰尘……没有。","source_fingerprint":"f6091fda23a909372ce793e7390b926380caa4697b13b33e3931a10f34b6c64d","source_path":"character_system_text_dict.json","json_path":["1118","70004"],"target_text":"Nếp nhăn, bụi bẩn…… không có.","reviewed":true},
    {"entry_index":6,"uid":"zhcn:7cf64dce1c1f3c70b2960235","kind":"character_system_text","source_text":"对设计没有不满。","source_fingerprint":"72ddbf281a4e4c3deaa6c75c365d3b1314231cf436359d0c7221d8e83535363c","source_path":"character_system_text_dict.json","json_path":["1118","70008"],"target_text":"Tôi không có gì bất mãn với thiết kế.","reviewed":true},
    {"entry_index":7,"uid":"zhcn:cd36eb2bdc13170fc4e1c2f1","kind":"character_system_text","source_text":"只要强大就好。我一个人……","source_fingerprint":"d05f06e195f58fa0ad00b9685799d204c54b6bd8204f8a4c1adf9e280b32623d","source_path":"character_system_text_dict.json","json_path":["1118","70009"],"target_text":"Chỉ cần mạnh là đủ. Một mình tôi……","reviewed":true},
    {"entry_index":8,"uid":"zhcn:5473728f9dd0537c0c663ac1","kind":"character_system_text","source_text":"开学典礼的照片……设施里的人也真是，明明不用挂起来的","source_fingerprint":"7904c6b002177e2d7646c38c0ba4fc2236e7b137f17766e49b58cac3f22b402f","source_path":"character_system_text_dict.json","json_path":["1118","70010"],"target_text":"Bức ảnh lễ khai giảng…… Người ở cơ sở đó thật tình, đâu cần phải treo lên chứ.","reviewed":true},
    {"entry_index":9,"uid":"zhcn:af532417fcebfcbcf080a5d6","kind":"character_system_text","source_text":"Live，真的有必要吗……不，没什么。","source_fingerprint":"d6bc1a33adfe43da1a991331f129b61d7e77ba3c2c8dd2ad8f0ba73f827457fe","source_path":"character_system_text_dict.json","json_path":["1118","70014"],"target_text":"Live, thật sự cần thiết sao…… Không, không có gì.","reviewed":true},
    {"entry_index":10,"uid":"zhcn:9f19958a2b9f7f8527ed5dbd","kind":"character_system_text","source_text":"比任何人都要强……将这份觉悟，倾注在这件衣服上。","source_fingerprint":"279d8c1d68e0e867afb2b275930715ccb88483835f9043a7b89106115fe4ad36","source_path":"character_system_text_dict.json","json_path":["1118","70015"],"target_text":"Mạnh hơn bất kỳ ai…… Tôi gửi trọn quyết tâm ấy vào bộ trang phục này.","reviewed":true},
    {"entry_index":11,"uid":"zhcn:bfd87597b51aac91551e16d0","kind":"character_system_text","source_text":"穿什么都不会改变。我就是我。","source_fingerprint":"725df83cb2959c27bbaf1465debe4d7bc8d5df113f9f9176aa7956bcf201a86a","source_path":"character_system_text_dict.json","json_path":["1118","70018"],"target_text":"Dù mặc gì cũng không thay đổi. Tôi vẫn là tôi.","reviewed":true},
    {"entry_index":12,"uid":"zhcn:a191bf3d05cd00081b63ef82","kind":"character_system_text","source_text":"……已经，可以换衣服了吧？","source_fingerprint":"84ef1814584d2c1632add1dabfbcb07152b411408472340dd4b65b0b2e9c1cf2","source_path":"character_system_text_dict.json","json_path":["1118","70019"],"target_text":"……Giờ tôi thay đồ được rồi chứ?","reviewed":true},
    {"entry_index":13,"uid":"zhcn:67f10aaeaebc2707fcf33b7d","kind":"character_system_text","source_text":"流行什么的……我不知道，我只穿自己想穿的","source_fingerprint":"78c4ec56079599a7ce6765eb5e32f51558e15eeee8ab8de6732146d4a3760edc","source_path":"character_system_text_dict.json","json_path":["1118","70020"],"target_text":"Xu hướng gì đó…… tôi không biết. Tôi chỉ mặc thứ mình muốn mặc.","reviewed":true},
    {"entry_index":14,"uid":"zhcn:8a6a28ea6f9e2ee653c09bb9","kind":"character_system_text","source_text":"黑色很好……因为毫不动摇。","source_fingerprint":"534a7d7b67ff5ac82096b7c9168b2cabcdd41c65c703598bc642626e8083d318","source_path":"character_system_text_dict.json","json_path":["1118","70021"],"target_text":"Màu đen rất tốt…… vì chẳng hề lay chuyển.","reviewed":true},
    {"entry_index":15,"uid":"zhcn:296df1c1085f067a7659cb7a","kind":"character_system_text","source_text":"皱纹，灰尘……没有。","source_fingerprint":"f6091fda23a909372ce793e7390b926380caa4697b13b33e3931a10f34b6c64d","source_path":"character_system_text_dict.json","json_path":["1118","71004"],"target_text":"Nếp nhăn, bụi bẩn…… không có.","reviewed":true},
