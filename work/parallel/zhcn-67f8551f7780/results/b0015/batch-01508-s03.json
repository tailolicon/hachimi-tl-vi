{
  "schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01508-s03","batch":1508,"shard":3,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":60,"shard_end_exclusive":80,"translated_count":15,
  "entries":[
    {"entry_index":60,"uid":"zhcn:375ab07013330688c3de2ffa","kind":"character_system_text","source_text":"如果是以前的我听到的话……一定会很吃惊吧。","source_fingerprint":"e5df375e60deb2f47d2337b66b8e4409ae92722d65714b2b500971592de88b07","source_path":"character_system_text_dict.json","json_path":["1118","93001"],"target_text":"Nếu là tôi ngày trước nghe thấy…… chắc hẳn sẽ rất ngạc nhiên.","reviewed":true},
    {"entry_index":61,"uid":"zhcn:899fdccf70711f83bfee7e2a","kind":"character_system_text","source_text":"变强，我只是想要变强……！","source_fingerprint":"5122ec2db650345d8115d83587474cbbd1b832c2518b84d98a3fa3da0655b9aa","source_path":"character_system_text_dict.json","json_path":["1118","95000"],"target_text":"Mạnh lên, tôi chỉ muốn mạnh hơn thôi……!","reviewed":true},
    {"entry_index":62,"uid":"zhcn:33c205e7e11ddd9be5fef70a","kind":"character_system_text","source_text":"没有任何欠缺的地方。","source_fingerprint":"3aec3d0aeca54580280fecbb86c29c02ff81263083900235452cbd634fa9038a","source_path":"character_system_text_dict.json","json_path":["1118","95001"],"target_text":"Không có gì thiếu sót cả.","reviewed":true},
    {"entry_index":63,"uid":"zhcn:5b060b11ca4cd7edc8a584c0","kind":"character_system_text","source_text":"我是爱慕律动。……有事吗？","source_fingerprint":"476225c257240f2d46456478a9f55ee09a447071daa70605224a24a186e04fd8","source_path":"character_system_text_dict.json","json_path":["1118","95003"],"target_text":"Tôi là Admire Groove. ……Có chuyện gì sao?","reviewed":true},
    {"entry_index":64,"uid":"zhcn:0edcb968c97bf95e5d0100f8","kind":"character_system_text","source_text":"如冰冻般的强大。\r\n除此之外——全都不需要。","source_fingerprint":"8d028c1eb000c05b758931ac987d5e4b854f90058362fcde8ea7ca97e70249c0","source_path":"character_system_text_dict.json","json_path":["1118","95004"],"target_text":"Sức mạnh lạnh giá như băng.\r\nNgoài điều đó ra—— tôi không cần gì cả.","reviewed":true},
    {"entry_index":65,"uid":"zhcn:bb74d2215ef055f5d4d03114","kind":"character_system_text","source_text":"只是帮个忙的话……。","source_fingerprint":"f2bbfb17c3ea85183f4a70c6bf8c1b2f9bbf6c99e2b718df5c95e2c827cd415d","source_path":"character_system_text_dict.json","json_path":["1118","95005"],"target_text":"Nếu chỉ là giúp một tay thôi thì……","reviewed":true},
    {"entry_index":66,"uid":"zhcn:6362cff26a83dd5f971dfcdf","kind":"character_system_text","source_text":"这种事……我并不知道……。","source_fingerprint":"742a380097fa75a7840378e22239db058ec464c9b13214de5ff647c61b62afd3","source_path":"character_system_text_dict.json","json_path":["1118","95006"],"target_text":"Chuyện như thế…… tôi không biết……","reviewed":true},
    {"entry_index":67,"uid":"zhcn:6a29c3ce19bb2efbcdfaccc8","kind":"character_system_text","source_text":"那就、全力以赴吧。","source_fingerprint":"daf81a5473ecf642223d0961d5883c883eaf4569349870d162ee5fc2d7a0cbfd","source_path":"character_system_text_dict.json","json_path":["1119","1000"],"target_text":"Vậy thì, hãy dốc hết sức nhé.","reviewed":true},
    {"entry_index":68,"uid":"zhcn:6ad9aaf6fc01cb766a83b747","kind":"character_system_text","source_text":"您真是位纯粹又真诚的人呢。\r\n呵…真是惹人怜爱","source_fingerprint":"f698e91a0ab447aaa0a9b1f9a82c6b2be5aef2fbdcb8ba6f7eaf01c6930e3f60","source_path":"character_system_text_dict.json","json_path":["1119","10000"],"target_text":"Trainer quả là một người thuần khiết và chân thành.\r\nHừm… thật khiến người ta thương mến.","reviewed":true},
    {"entry_index":69,"uid":"zhcn:98bdd6e064d331cbdcf47ccc","kind":"character_system_text","source_text":"我出发了。","source_fingerprint":"874e7497e7be8367a4f334f4c7f1d69916bd93469660e8935829876ff0311191","source_path":"character_system_text_dict.json","json_path":["1119","100000"],"target_text":"Tôi đi đây.","reviewed":true},
    {"entry_index":70,"uid":"zhcn:c6e117ae22a1f40ecde0c95d","kind":"character_system_text","source_text":"我回来了。","source_fingerprint":"4f3f071de3a132d55ed31edf557b362afda8ef29b618fd0f52a13920ed7d26bb","source_path":"character_system_text_dict.json","json_path":["1119","100001"],"target_text":"Tôi về rồi.","reviewed":true},
    {"entry_index":71,"uid":"zhcn:5004d3c433d1a1a771d52570","kind":"character_system_text","source_text":"若有任何困扰之事，请尽管找我。\r\n“一切”…都请您放心托付给我","source_fingerprint":"2a3617715c9ddcb44904dc8732b73cb2f182a60fa9e752ccb67d38b3d7764f51","source_path":"character_system_text_dict.json","json_path":["1119","10001"],"target_text":"Nếu có bất cứ điều gì phiền lòng, cứ tìm tôi.\r\n“Mọi chuyện”… xin Trainer cứ yên tâm giao cho tôi.","reviewed":true},
    {"entry_index":72,"uid":"zhcn:070ef1be87383d827e283cf8","kind":"character_system_text","source_text":"用动物来比喻人的性格…\r\n这话題在宿舍里稍微流行起来了呢。\r\n您的话…大概是 企鹅吧？","source_fingerprint":"508c7c4dfd65a8eda96838d7d1ac2352d7354dfcabfbeb55f8a8a81a0826837c","source_path":"character_system_text_dict.json","json_path":["1119","10002"],"target_text":"Ví tính cách con người bằng động vật…\r\nchủ đề này đang hơi thịnh hành trong ký túc xá.\r\nCòn Trainer… chắc là chim cánh cụt nhỉ?","reviewed":true},
    {"entry_index":73,"uid":"zhcn:fca12442da321330420b0503","kind":"character_system_text","source_text":"贺年卡我是一定会寄出去的。\r\n对于关照过我的人们\r\n礼数必须更要周到才行呢。","source_fingerprint":"648ab4cb2033bc33fce62f7d4603aed42d593bc9a252ded31b52aebcf235b0f7","source_path":"character_system_text_dict.json","json_path":["1119","10003"],"target_text":"Thiệp mừng năm mới thì tôi nhất định sẽ gửi.\r\nVới những người đã giúp đỡ mình,\r\nlễ nghĩa càng phải chu toàn mới được.","reviewed":true},
    {"entry_index":74,"uid":"zhcn:553400f77eab4ab8eaf0515e","kind":"character_system_text","source_text":"要一起喝杯茶吗？您曾说过的\r\n喜欢的点心，我已经备好了\r\n――毕竟是情人节，对吧？","source_fingerprint":"1c11558d384e145fb2830264c0b24b8b239e8e06cde5465ac08521aabb58157d","source_path":"character_system_text_dict.json","json_path":["1119","10004"],"target_text":"Cùng uống một tách trà nhé? Món bánh Trainer từng nói\r\nlà mình thích, tôi đã chuẩn bị rồi.\r\n――Dù sao hôm nay cũng là Valentine, phải không?","reviewed":true}
  ]
}