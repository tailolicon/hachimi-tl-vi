{"schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01510-s00","batch":1510,"shard":0,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":0,"shard_end_exclusive":20,"translated_count":15,"entries":[{"entry_index":0,"uid":"zhcn:fc93c32e87a5f206e383c7f2","kind":"character_system_text","source_text":"哦呦…。","source_fingerprint":"05e21e882067c9c68dfaf3854f5a6e207cea3c6fd4f908fde5807a7e4e33d333","source_path":"character_system_text_dict.json","json_path":["1119","20042"],"target_text":"Ôi chao...","reviewed":true},{"entry_index":1,"uid":"zhcn:1d7c9c6fc188b34db18047a6","kind":"character_system_text","source_text":"呼ー…。","source_fingerprint":"792d428d32e6aff1af93acf94392326dd285de953367a97221d835d288fc7b0f","source_path":"character_system_text_dict.json","json_path":["1119","20043"],"target_text":"Phù...","reviewed":true},{"entry_index":2,"uid":"zhcn:270280a4d94cd132d07184cc","kind":"character_system_text","source_text":"我要上了。","source_fingerprint":"6662d4dbec001753217e00827e1b11c773577bc67a31875f80338646c5f07bc9","source_path":"character_system_text_dict.json","json_path":["1119","20046"],"target_text":"Tôi lên đây.","reviewed":true},{"entry_index":3,"uid":"zhcn:c5a9f008055bf23279d4ac26","kind":"character_system_text","source_text":"真美…。","source_fingerprint":"a785455814559dafa3d633ee605bdc64aee5c169e38e2150ac6790cd53a1801f","source_path":"character_system_text_dict.json","json_path":["1119","20047"],"target_text":"Đẹp quá...","reviewed":true},{"entry_index":4,"uid":"zhcn:a74dcef7861a0dae0aed0055","kind":"character_system_text","source_text":"托您的福，度过了一段美好的时光","source_fingerprint":"f33b44cdf06218ed16eebd9ced44f1a9ccba345ce3e677229b8d83bd7b2f355c","source_path":"character_system_text_dict.json","json_path":["1119","20049"],"target_text":"Nhờ ngài, tôi đã có một khoảng thời gian tuyệt vời.","reviewed":true},{"entry_index":5,"uid":"zhcn:d6b828696bc8f1a12bfa91af","kind":"character_system_text","source_text":"一直以来承蒙您的照顾了。","source_fingerprint":"bcc04a0652fb43c27c99467499b904aa724498ea1a249ae3fc8a96181de55edd","source_path":"character_system_text_dict.json","json_path":["1119","20050"],"target_text":"Bấy lâu nay, cảm ơn ngài đã luôn quan tâm đến tôi.","reviewed":true},{"entry_index":6,"uid":"zhcn:7e9a028ae9f8d7167deff47a","kind":"character_system_text","source_text":"那就、全力以赴吧。","source_fingerprint":"daf81a5473ecf642223d0961d5883c883eaf4569349870d162ee5fc2d7a0cbfd","source_path":"character_system_text_dict.json","json_path":["1119","2030"],"target_text":"Vậy thì, hãy dốc toàn lực nào.","reviewed":true},{"entry_index":7,"uid":"zhcn:3f22567917a5eb223c391c78","kind":"character_system_text","source_text":"让我们奉献一场精彩的比赛吧。","source_fingerprint":"2a25bed0b58c785dccce70855a3a78734e9e7a4620dfc818f328204670c8c538","source_path":"character_system_text_dict.json","json_path":["1119","2031"],"target_text":"Hãy cùng cống hiến một cuộc đua thật tuyệt vời nào.","reviewed":true},{"entry_index":8,"uid":"zhcn:17984019286565f8869876a4","kind":"character_system_text","source_text":"一直以来承蒙您的照顾了。","source_fingerprint":"bcc04a0652fb43c27c99467499b904aa724498ea1a249ae3fc8a96181de55edd","source_path":"character_system_text_dict.json","json_path":["1119","2032"],"target_text":"Bấy lâu nay, cảm ơn ngài đã luôn quan tâm đến tôi.","reviewed":true},{"entry_index":9,"uid":"zhcn:45c00aa5ead85588f8249bc5","kind":"character_system_text","source_text":"啊，身体如此轻盈。\r\n――仿佛能翱翔天际一般。","source_fingerprint":"65a579eafc7f4e02568eb54d3124641475f4284b5897121a5c372c89cead9473","source_path":"character_system_text_dict.json","json_path":["1119","2033"],"target_text":"A, cơ thể nhẹ bẫng.\r\n——Cứ như có thể tung cánh trên bầu trời vậy.","reviewed":true},{"entry_index":10,"uid":"zhcn:eac4c82a74abbe3f74aa934d","kind":"character_system_text","source_text":"调整完毕…您也做得\r\n非常出色。今天我会\r\n让您见证精彩的结果。","source_fingerprint":"99fd1d87c5b9cd0616faa11ebc3256cf09d1fd58bb76a1aee566bebd011af2c2","source_path":"character_system_text_dict.json","json_path":["1119","2034"],"target_text":"Điều chỉnh xong rồi... ngài cũng đã\r\nlàm rất tốt. Hôm nay tôi sẽ\r\ncho ngài chứng kiến một kết quả tuyệt vời.","reviewed":true},{"entry_index":11,"uid":"zhcn:c8f90597a38165c84a0a706c","kind":"character_system_text","source_text":"一直以来承蒙您的照顾了。","source_fingerprint":"bcc04a0652fb43c27c99467499b904aa724498ea1a249ae3fc8a96181de55edd","source_path":"character_system_text_dict.json","json_path":["1119","2035"],"target_text":"Bấy lâu nay, cảm ơn ngài đã luôn quan tâm đến tôi.","reviewed":true},{"entry_index":12,"uid":"zhcn:03c698813335d15b4ffc9017","kind":"character_system_text","source_text":"好了。","source_fingerprint":"8c1bb480ed0811432e377c03a073021704dea1af4170f367125bc0d9553854df","source_path":"character_system_text_dict.json","json_path":["1119","23015"],"target_text":"Được rồi.","reviewed":true},{"entry_index":13,"uid":"zhcn:57da12ca336f4375091e9a2a","kind":"character_system_text","source_text":"还算…可以吧。","source_fingerprint":"69bdbb3929f9b4c354e5623d115a5b842e2d642c1ee3cfe6dce556a28d46a5e6","source_path":"character_system_text_dict.json","json_path":["1119","30000"],"target_text":"Cũng... tạm được.","reviewed":true},{"entry_index":14,"uid":"zhcn:f34f94e071defcba254757db","kind":"character_system_text","source_text":"将经验活用于下一战吧。","source_fingerprint":"cd8fc4451c6712251c91edc55828957ef8cd01bb2b201c215808c3645c3e9d83","source_path":"character_system_text_dict.json","json_path":["1119","30001"],"target_text":"Hãy vận dụng kinh nghiệm này vào trận tiếp theo.","reviewed":true}]}