{"schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01514-s00","batch":1514,"shard":0,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":0,"shard_end_exclusive":20,"translated_count":5,"entries":[{"entry_index":0,"uid":"zhcn:fa1bc9afcc9e22fae3798130","kind":"character_system_text","source_text":"报告，\r\n有新的通知，\r\n请尽快确认。","source_fingerprint":"fb3c8db1d6fd3a31c5820190677c8922e1b6bd135a697900cfb91c42de75b9e6","source_path":"character_system_text_dict.json","json_path":["1121","10015"],"target_text":"Báo cáo,\r\ncó thông báo mới.\r\nXin hãy kiểm tra sớm.","reviewed":true},{"entry_index":1,"uid":"zhcn:44bd164d0e6817cb1f868398","kind":"character_system_text","source_text":"看来有礼物送来了。\r\n安全已确认，\r\n请放心收下。","source_fingerprint":"1f8b443c7135a9fd2203b9826895c24103e6546cfbc8c1bf084979dbad94f292","source_path":"character_system_text_dict.json","json_path":["1121","10016"],"target_text":"Có vẻ quà đã được gửi tới.\r\nTôi đã xác nhận an toàn,\r\nngài cứ yên tâm nhận lấy.","reviewed":true},{"entry_index":2,"uid":"zhcn:35a8493069f2c75c378f24a7","kind":"character_system_text","source_text":"任务完成……太棒了！\r\n不愧是您，我的主君！","source_fingerprint":"3af6c44ffce4bcf0042d669641610b28588d4b12065a2ef4f2d7a8ff0c7914a5","source_path":"character_system_text_dict.json","json_path":["1121","10017"],"target_text":"Nhiệm vụ hoàn thành... tuyệt quá!\r\nQuả không hổ là ngài, chủ quân của tôi!","reviewed":true},{"entry_index":3,"uid":"zhcn:0f3dfdc1b85afb8f9186232d","kind":"character_system_text","source_text":"看来有活动要举行，\r\n请做好万全准备。","source_fingerprint":"eaaffa08897a25a1a716f2593a759b7c73fe2f3d8971782105a73bffc432d41a","source_path":"character_system_text_dict.json","json_path":["1121","10018"],"target_text":"Có vẻ sắp có sự kiện được tổ chức.\r\nXin hãy chuẩn bị thật chu toàn.","reviewed":true},{"entry_index":4,"uid":"zhcn:8d9a54454af11f3f54ef66bb","kind":"character_system_text","source_text":"活动开始了呢，\r\n您要参加吗？\r\n我会陪伴左右！","source_fingerprint":"603e9265c5afc6c55a3c446e11b5dfc1b1e43870b63c5107130e5b389598586f","source_path":"character_system_text_dict.json","json_path":["1121","10019"],"target_text":"Sự kiện bắt đầu rồi nhỉ.\r\nNgài sẽ tham gia chứ?\r\nTôi sẽ luôn ở bên ngài!","reviewed":true}]}