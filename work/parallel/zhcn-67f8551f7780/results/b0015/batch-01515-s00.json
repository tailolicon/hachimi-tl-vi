{"schema_version":1,"status":"complete","epoch":"zhcn-67f8551f7780","task_id":"batch-01515-s00","batch":1515,"shard":0,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":0,"shard_end_exclusive":20,"translated_count":20,"entries":[{"entry_index":0,"uid":"zhcn:7aa41393b49ea9bf63775fb3","kind":"character_system_text","source_text":"唔……","source_fingerprint":"57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6","source_path":"character_system_text_dict.json","json_path":["1121","20043"],"target_text":"Ừm...","reviewed":true},{"entry_index":1,"uid":"zhcn:2d94aa904a2d5ae8c87d200a","kind":"character_system_text","source_text":"来吧！","source_fingerprint":"259094e5a27d8b74ef6c993df596f92eace76ba061f4116e7799ac4847d895f0","source_path":"character_system_text_dict.json","json_path":["1121","20046"],"target_text":"Nào!","reviewed":true},{"entry_index":2,"uid":"zhcn:3fcc6661c3379ca269ac96bb","kind":"character_system_text","source_text":"真是雄伟啊……","source_fingerprint":"00a96e3bc2e12ff2efe9f70bba05102f381511b699ccbd11c3754f10c45b1233","source_path":"character_system_text_dict.json","json_path":["1121","20047"],"target_text":"Quả là hùng vĩ...","reviewed":true},{"entry_index":3,"uid":"zhcn:be2f03b5af0e5f3af0766ddb","kind":"character_system_text","source_text":"能够与吾君一同前行，\n是我的骄傲。","source_fingerprint":"ddb02271920c9bc35fa226f23f6cd5602461fda74e7adf02d7cc2cc49b8f77aa","source_path":"character_system_text_dict.json","json_path":["1121","20049"],"target_text":"Được cùng chủ quân tiến bước,\nlà niềm kiêu hãnh của tôi.","reviewed":true},{"entry_index":4,"uid":"zhcn:21119563ec33652f14a1794d","kind":"character_system_text","source_text":"艰难却充满乐趣的日子。","source_fingerprint":"d1025b3c7fe3c9e170bc42e5ac2577ab8997e49f574658e3d3511d570e00c391","source_path":"character_system_text_dict.json","json_path":["1121","20050"],"target_text":"Những ngày gian nan nhưng tràn đầy niềm vui.","reviewed":true},{"entry_index":5,"uid":"zhcn:43fa1b862e83dd4cae99c232","kind":"character_system_text","source_text":"闪耀吧，我的『圣剑』！","source_fingerprint":"9e6edf9a8b0fe928abc1f325dbf83f1cdc97cdcef26f0a9e76c8817e4ef234b5","source_path":"character_system_text_dict.json","json_path":["1121","20051"],"target_text":"Tỏa sáng đi, 『Thánh kiếm』 của ta!","reviewed":true},{"entry_index":6,"uid":"zhcn:ebcdab1f26e871221a6a9e19","kind":"character_system_text","source_text":"准备好了吗？","source_fingerprint":"3e36fbccc1afd0f573cd3d8f897e3488e4336d872375cc4340fe31a60f44d59c","source_path":"character_system_text_dict.json","json_path":["1121","2030"],"target_text":"Đã sẵn sàng chưa?","reviewed":true},{"entry_index":7,"uid":"zhcn:da8d66b10b23b13518641452","kind":"character_system_text","source_text":"集结在我的『圣剑』下吧，勇士们！","source_fingerprint":"b5e5ca9c7dde835e4157628137a2136dbffaec21b19fd6c598a05da2c634c2f2","source_path":"character_system_text_dict.json","json_path":["1121","2031"],"target_text":"Hỡi các dũng sĩ, hãy tập hợp dưới 『Thánh kiếm』 của ta!","reviewed":true},{"entry_index":8,"uid":"zhcn:efde2bdbdd7de4dbb16a6def","kind":"character_system_text","source_text":"这是艰险却充满乐趣的日子。","source_fingerprint":"cf4f8d0e8ba631a7f63b3eb4845b8d241453fdc3683e102bd7fdcd1959231467","source_path":"character_system_text_dict.json","json_path":["1121","2032"],"target_text":"Đây là những ngày gian nan nhưng tràn đầy niềm vui.","reviewed":true},{"entry_index":9,"uid":"zhcn:d9be0775677d60905cb1d223","kind":"character_system_text","source_text":"没有什么可畏惧的。\r\n这就是我一直以来\r\n积累的锻炼成果。","source_fingerprint":"1a1262ac2a04c211cacaebc4309e01da514a52b262874f4d688db2beb136909e","source_path":"character_system_text_dict.json","json_path":["1121","2033"],"target_text":"Không có gì phải sợ.\r\nĐây chính là thành quả rèn luyện\r\ntôi đã tích lũy bấy lâu nay.","reviewed":true},{"entry_index":10,"uid":"zhcn:d825764eee8a9d39c4a42f25","kind":"character_system_text","source_text":"如果能取得胜利，\r\n让我的君主露出喜悦的笑容……\r\n那一定……就能……！","source_fingerprint":"3a70a75cf07afb56f641b37ffa14ef02fccd28d1fb7aaa8abd0269bc5e0f4e51","source_path":"character_system_text_dict.json","json_path":["1121","2034"],"target_text":"Nếu có thể giành chiến thắng,\r\nkhiến chủ quân nở nụ cười vui sướng...\r\nthì nhất định... sẽ...!","reviewed":true},{"entry_index":11,"uid":"zhcn:7fd8cff252c29e3049728e09","kind":"character_system_text","source_text":"这是艰险却充满乐趣的日子。","source_fingerprint":"cf4f8d0e8ba631a7f63b3eb4845b8d241453fdc3683e102bd7fdcd1959231467","source_path":"character_system_text_dict.json","json_path":["1121","2035"],"target_text":"Đây là những ngày gian nan nhưng tràn đầy niềm vui.","reviewed":true},{"entry_index":12,"uid":"zhcn:94e5eb5ebf4fe60da719128f","kind":"character_system_text","source_text":"出发。","source_fingerprint":"8167d1d045fa6f23c7c40620b76aa43604b384e653241623afc8b7061394a145","source_path":"character_system_text_dict.json","json_path":["1121","23015"],"target_text":"Xuất phát.","reviewed":true},{"entry_index":13,"uid":"zhcn:39106095023da3860c693721","kind":"character_system_text","source_text":"唔，差一步……下次一定！","source_fingerprint":"d0c65db2f2e038eadd97a6b2601bdebe7623463e37a42addaa002466a0e2cd92","source_path":"character_system_text_dict.json","json_path":["1121","30000"],"target_text":"Ừm, chỉ thiếu một bước... Lần sau nhất định!","reviewed":true},{"entry_index":14,"uid":"zhcn:f7130b17ecfde49e0316cef4","kind":"character_system_text","source_text":"骑士的道路崎岖不平……","source_fingerprint":"3a849e6177ab392dfd1b9d1d8011f75bfcf1aa021cf2e537fce11bbe784a6b05","source_path":"character_system_text_dict.json","json_path":["1121","30001"],"target_text":"Con đường của hiệp sĩ quả lắm chông gai...","reviewed":true},{"entry_index":15,"uid":"zhcn:9a40fc248474dc54d1c4904a","kind":"character_system_text","source_text":"唯有不断锻炼……！","source_fingerprint":"9d1f7661bf0a4e23e5e8e420739b3370452fb7ba8f7fd61e2dd29a62efdf1fbb","source_path":"character_system_text_dict.json","json_path":["1121","30002"],"target_text":"Chỉ có không ngừng rèn luyện...!","reviewed":true},{"entry_index":16,"uid":"zhcn:d27f83feaf09d04577223494","kind":"character_system_text","source_text":"这是骑士的耻辱……","source_fingerprint":"774aa4ac81b8ea975b49a075d016ee04d9fae5a08f9ba4e95299e4677c7bed5b","source_path":"character_system_text_dict.json","json_path":["1121","30003"],"target_text":"Đây là nỗi hổ thẹn của một hiệp sĩ...","reviewed":true},{"entry_index":17,"uid":"zhcn:0cfe6e635b0ea1f3ad5d3fdc","kind":"character_system_text","source_text":"来吧，请握住我的手。\r\n让我们踏上凯旋的道路。","source_fingerprint":"c17f947cb53ffc6b355c2575bb70f29dc88a1cf5254b3d5d3466daf5c38a0f8e","source_path":"character_system_text_dict.json","json_path":["1121","30004"],"target_text":"Nào, xin hãy nắm lấy tay tôi.\r\nChúng ta hãy cùng bước lên con đường khải hoàn.","reviewed":true},{"entry_index":18,"uid":"zhcn:e1261cb16402d04613ae9bdd","kind":"character_system_text","source_text":"献给吾君……胜利的一切皆为您。","source_fingerprint":"c5a44e332b07a6c838a410be165c5612484e89520042a3cdb667ccab8d94733d","source_path":"character_system_text_dict.json","json_path":["1121","30005"],"target_text":"Dâng lên chủ quân... mọi chiến thắng đều dành cho ngài.","reviewed":true},{"entry_index":19,"uid":"zhcn:0c704aa54d3057581af2cd2d","kind":"character_system_text","source_text":"出发吧……！","source_fingerprint":"eae773f0956de8bd881f22b8026d8878020ed7aa60c72340db4f942fbc67355b","source_path":"character_system_text_dict.json","json_path":["1121","31000"],"target_text":"Xuất phát thôi...!","reviewed":true}]}