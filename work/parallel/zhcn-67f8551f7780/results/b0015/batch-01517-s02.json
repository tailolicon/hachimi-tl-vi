{"schema_version":1,"status":"partial","epoch":"zhcn-67f8551f7780","task_id":"batch-01517-s02","batch":1517,"shard":2,"source_commit":"67f8551f77807292cebd2b20b2c752b652393835","source_queue_git_commit":"ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2","shard_start":40,"shard_end_exclusive":60,"translated_count":15,"entries":[{"entry_index":40,"uid":"zhcn:ea96641ed546b8e3ea486439","kind":"character_system_text","source_text":"もっと、上を目指すんだ…！","source_fingerprint":"1a97acb6214833002cc71f1e508ffb4c411ed9503483ce07ecc0c9a8f70819b6","source_path":"character_system_text_dict.json","json_path":["1124","30001"],"target_text":"Phải nhắm cao hơn nữa...!","reviewed":true},{"entry_index":41,"uid":"zhcn:e435a80996509f3bb730b792","kind":"character_system_text","source_text":"次は、負けない。","source_fingerprint":"afda0fe1e208d375b483c9db90de4116e19d649fe94fe013c24356361fa7e56f","source_path":"character_system_text_dict.json","json_path":["1124","30002"],"target_text":"Lần sau, tôi sẽ không thua.","reviewed":true},{"entry_index":42,"uid":"zhcn:44af8bc980376e44cc174b9f","kind":"character_system_text","source_text":"情けないな…。","source_fingerprint":"af33ad0887921fee967f7be59d9e28c5a5aecf77e3304ccd0b5738b6de1d8534","source_path":"character_system_text_dict.json","json_path":["1124","30003"],"target_text":"Thảm hại thật...","reviewed":true},{"entry_index":43,"uid":"zhcn:b09eb01d306282838dd64ba1","kind":"character_system_text","source_text":"私の起こす旋風は、\r\nまだこんなものじゃあないよ！","source_fingerprint":"36c49f48e4654cba2b6125c2eb553ae1bf6c1b3bb8f469fec3dbe9fc3f9b443b","source_path":"character_system_text_dict.json","json_path":["1124","30004"],"target_text":"Cơn lốc tôi tạo ra\r\nvẫn chưa chỉ có thế đâu!","reviewed":true},{"entry_index":44,"uid":"zhcn:71c7d42936b860d8da517002","kind":"character_system_text","source_text":"宣言通り、『私の勝ち』だね！","source_fingerprint":"ec6aebf1b93dd1b561d5c86c771de03cc1a701e35c6d09022f3148895049d9d8","source_path":"character_system_text_dict.json","json_path":["1124","30005"],"target_text":"Đúng như đã tuyên bố, 『tôi thắng』 nhỉ!","reviewed":true},{"entry_index":45,"uid":"zhcn:dc1458afc4e930da9f7c10e0","kind":"character_system_text","source_text":"行ってくるよ。","source_fingerprint":"7da79748cc0c78260452eff6f93ce5c5aa46913a8d4199c892b59c4e329c3594","source_path":"character_system_text_dict.json","json_path":["1124","31000"],"target_text":"Tôi đi đây.","reviewed":true},{"entry_index":46,"uid":"zhcn:8a70cf8d23aad375238bd08c","kind":"character_system_text","source_text":"私が切り込む！","source_fingerprint":"a46fae01256eff31fa7de1524bb03d81204e49a1993b7a3795c907fc99ab1da1","source_path":"character_system_text_dict.json","json_path":["1124","40000"],"target_text":"Để tôi mở đường!","reviewed":true},{"entry_index":47,"uid":"zhcn:e1b322d6313ab8ae9a7a81ae","kind":"character_system_text","source_text":"んっ…よし。無謀だなんて言わせない。\r\n私が示す！さあ、ついて来て。","source_fingerprint":"a879430e71789c910c394a330d5e748e96974f2b60751d182413bf01571d0357","source_path":"character_system_text_dict.json","json_path":["1124","40001"],"target_text":"Ừm... được. Tôi sẽ không để ai nói là liều lĩnh.\r\nTôi sẽ chứng minh! Nào, theo tôi.","reviewed":true},{"entry_index":48,"uid":"zhcn:ee495bdd4cd0c840dadc181f","kind":"character_system_text","source_text":"盛り上げてくるからね！","source_fingerprint":"a64cf9cdc26681799d31c334a76f04503086254845dbea3619ae2a7f2aa346b9","source_path":"character_system_text_dict.json","json_path":["1124","60000"],"target_text":"Tôi sẽ khuấy động không khí nhé!","reviewed":true},{"entry_index":49,"uid":"zhcn:5d518eb5894e96d18d3c1fea","kind":"character_system_text","source_text":"さあみんな、行こうっ！","source_fingerprint":"2b2a0e7324be0f8dbf770cd2b93b798ee2064ecdc3a32dedec118972b881c805","source_path":"character_system_text_dict.json","json_path":["1124","60001"],"target_text":"Nào mọi người, đi thôi!","reviewed":true},{"entry_index":50,"uid":"zhcn:c769e25667733ea928d41888","kind":"character_system_text","source_text":"私が切り開いてみせる！","source_fingerprint":"b873a1d077e6dc5da6d175f9b281f582ac8814f2d787c41e27b2be97054f2026","source_path":"character_system_text_dict.json","json_path":["1124","70000"],"target_text":"Tôi sẽ mở đường cho mọi người xem!","reviewed":true},{"entry_index":51,"uid":"zhcn:a389e0d6a55f65fc0d29e821","kind":"character_system_text","source_text":"自分の名前が聞こえてきたから、\r\n思わず声かけちゃったけど…\r\nあの時、切り込んで正解だったよ！","source_fingerprint":"79068df8021a6244662689072ad5300b035303717f5485b9c74420ac221d4269","source_path":"character_system_text_dict.json","json_path":["1124","70001"],"target_text":"Vì nghe thấy tên mình nên\r\ntôi vô thức lên tiếng...\r\nnhưng lúc đó nhảy vào quả là đúng đắn!","reviewed":true},{"entry_index":52,"uid":"zhcn:f8e4262b99e61d17f0c77f1a","kind":"character_system_text","source_text":"名門校のトレセン学園制服…\r\n誇らしいね！","source_fingerprint":"54a668fb2f85927c960baf728f0bafa45180160fdea3c006f5d0a1ce46ab10fa","source_path":"character_system_text_dict.json","json_path":["1124","70004"],"target_text":"Đồng phục của Học viện Tracen danh tiếng...\r\nthật đáng tự hào!","reviewed":true},{"entry_index":53,"uid":"zhcn:120018591718b4fb197bda72","kind":"character_system_text","source_text":"幼馴染たちとも、\r\nこれ着て並んでみたいな…。","source_fingerprint":"4d68f043e9f17dc0c3d272f4aac7eb00a5db21b358078f8976059fb84edc0a8f","source_path":"character_system_text_dict.json","json_path":["1124","70008"],"target_text":"Tôi cũng muốn mặc bộ này\r\nrồi đứng cạnh những người bạn thuở nhỏ...","reviewed":true},{"entry_index":54,"uid":"zhcn:84fad381d1061face8264d24","kind":"character_system_text","source_text":"すっごく軽いんだ、この服！\r\n風の抵抗も少なそうでしょう？","source_fingerprint":"e5577f048c86464b4232ce01169a6c90fdf8e387a5b3e8807ae4779c9288f82e","source_path":"character_system_text_dict.json","json_path":["1124","70009"],"target_text":"Bộ đồ này nhẹ lắm!\r\nCó vẻ lực cản của gió cũng ít, đúng không?","reviewed":true}]}