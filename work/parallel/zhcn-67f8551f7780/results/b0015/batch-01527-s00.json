  "entries":[
    {"entry_index":0,"uid":"zhcn:3a8160e929d6132afcc8b59a","kind":"character_system_text","source_text":"要把这一战，载入历史…！","source_fingerprint":"298ea7fcca7001f3557c17447854d2700625b1ea179e327daae99a269e56bdc8","source_path":"character_system_text_dict.json","json_path":["1133","2031"],"target_text":"Nhất định phải ghi trận chiến này vào lịch sử…!","reviewed":true},
    {"entry_index":1,"uid":"zhcn:67a4aadc97b5af6afd27af05","kind":"character_system_text","source_text":"谢谢您的指导。","source_fingerprint":"d81b170be6932eb234489b3ae1b5349a861e7d50c9c201e2c7e680e1cfe37f46","source_path":"character_system_text_dict.json","json_path":["1133","2032"],"target_text":"Cảm ơn vì đã chỉ dẫn cho tôi.","reviewed":true},
    {"entry_index":2,"uid":"zhcn:5faaa1e8f1377654f6d99c77","kind":"character_system_text","source_text":"去刻下……属于我们的足迹吧。","source_fingerprint":"0010b79ea548b46b59f6b46f5dc6bef4a823ac44aa1005de47cae515d549faf4","source_path":"character_system_text_dict.json","json_path":["1133","2033"],"target_text":"Hãy cùng khắc lại…… dấu chân của chúng ta.","reviewed":true},
    {"entry_index":3,"uid":"zhcn:6ed6b6765dccecadc46c0d90","kind":"character_system_text","source_text":"为了认可这份『梦想』\n的各位……！我会努力的…！","source_fingerprint":"56edcedee1980eaa131aab72c17d548054283e57441550d748646233631c1905","source_path":"character_system_text_dict.json","json_path":["1133","2034"],"target_text":"Vì tất cả những người đã công nhận 『ước mơ』 này…!\nTôi sẽ cố gắng…!","reviewed":true},
    {"entry_index":4,"uid":"zhcn:7924b308470dae7426dc0a3e","kind":"character_system_text","source_text":"谢谢您的指导。","source_fingerprint":"d81b170be6932eb234489b3ae1b5349a861e7d50c9c201e2c7e680e1cfe37f46","source_path":"character_system_text_dict.json","json_path":["1133","2035"],"target_text":"Cảm ơn vì đã chỉ dẫn cho tôi.","reviewed":true},
    {"entry_index":5,"uid":"zhcn:a0171f521e486cd2412190f2","kind":"character_system_text","source_text":"要上了……！","source_fingerprint":"602dd5bd12b0d5089900226573bb73477f4d5e5b12e24ab6c953ba984b68eee9","source_path":"character_system_text_dict.json","json_path":["1133","23015"],"target_text":"Bắt đầu thôi……!","reviewed":true},
    {"entry_index":6,"uid":"zhcn:12c0a0aff6e566a0156f384b","kind":"character_system_text","source_text":"下一次，要以胜者之姿\n载入史册……！","source_fingerprint":"73b04318ac887199e9dc35d17bce333e9f750e39da132c5104e86238502dbce0","source_path":"character_system_text_dict.json","json_path":["1133","30000"],"target_text":"Lần sau, nhất định tôi sẽ đi vào lịch sử\nvới tư cách người chiến thắng……!","reviewed":true},
    {"entry_index":7,"uid":"zhcn:a49b728d5fa6f6f7863fbbe7","kind":"character_system_text","source_text":"我的方略，\n看来得重新审视一下了……","source_fingerprint":"e5a5679e326c73eaacea8e615017a9002dd7367faac0d8683f4677b5e3b2dec8","source_path":"character_system_text_dict.json","json_path":["1133","30001"],"target_text":"Xem ra tôi phải xem xét lại\nchiến lược của mình rồi……","reviewed":true},
    {"entry_index":8,"uid":"zhcn:dcf54dabb441c3a2a3a10898","kind":"character_system_text","source_text":"刚才的也只是，\n历史的一部分……","source_fingerprint":"38f94582264a2d22f0e6ec16f6ea8a79d5b1380a2e5b570e691119e2abd96ec1","source_path":"character_system_text_dict.json","json_path":["1133","30002"],"target_text":"Chuyện vừa rồi cũng chỉ là\nmột phần của lịch sử……","reviewed":true},
    {"entry_index":9,"uid":"zhcn:bb7893795aca306422aa9c24","kind":"character_system_text","source_text":"这也是一种竞赛呢……","source_fingerprint":"b326808fec26bb5fae8c769528fc0b66890fc087936e37ce2a505ad4ba53dd9b","source_path":"character_system_text_dict.json","json_path":["1133","30003"],"target_text":"Đây cũng là một kiểu thi đấu nhỉ……","reviewed":true}
