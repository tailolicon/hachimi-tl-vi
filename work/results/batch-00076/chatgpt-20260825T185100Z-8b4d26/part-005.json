    {"uid":"zhcn:6d37991d18c0e63f926ed3fb","source_fingerprint":"e42a46e0a2ab9fad14dac40caf04b6b8462175a55b3b2acbf790547deedd92a3","target_text":"Giới hạn tối đa của chỉ số cơ bản"},
