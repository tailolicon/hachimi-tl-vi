  "translations": [
    {"uid":"zhcn:02e073375e570a8b75b6058a","source_fingerprint":"7d23ad3dfafda2d5552795a81b72d79eee6bccdc3eab7bb20353c4d10c8949c3","target_text":"Thắp sáng trái tim mọi người!\\nCô gái lễ hội tươi sáng, hoạt bát!"},
    {"uid":"zhcn:2197dcc6355574d5ac492859","source_fingerprint":"1636092b2780f82a8e35c20b6cd3044d4c71eab18f24510e74e712967cd1b8c0","target_text":"Theo đuổi điều mình ngưỡng mộ!\\nUma Musume chăm chỉ và chân thành"},
    {"uid":"zhcn:8de0dd83f1b0811b9098f4b1","source_fingerprint":"13c0be31364f6af22bcf0468e9414c7d5dc598ce806e9db975efd997645b1d3d","target_text":"Trở thành ngôi sao rực rỡ nhất thế gian!\\nUma Musume tham vọng đầy sức hút"},
    {"uid":"zhcn:e3bdf6fc246e38570b21b9ca","source_fingerprint":"88d6608bafe7796a711583595a8930dc2e8a59ee211244f95eb4993915c9fa0a","target_text":"Dù thể chất yếu ớt vẫn kiên cường tỏa sáng.\\nTiểu thư sinh ra với đôi chân mong manh như thủy tinh"},
    {"uid":"zhcn:ab6f7f3d56f1e6f2d0f56bc6","source_fingerprint":"77058b9103f04cfc5a0f07eaab326dfb8026ca4b2c0b96c3f12176730939fa52","target_text":"Dùng võ thay lễ, dốc sức chạy hết mình.\\nUma Musume mê võ"},
    {"uid":"zhcn:77f74e64e8883f9e129404cb","source_fingerprint":"d68d85cfe2113478169e9bdf36e4a6bbd9c52c52b9f34ff755e6f4bf45ca0be3","target_text":"Mục tiêu Tam Quán! Luôn sẵn sàng!!\\nVượt qua cực hạn—guwaa?!"},
    {"uid":"zhcn:24afb086fe7700c540b4cd49","source_fingerprint":"ee1f192987e3a97288a49831253f7cecaf7ea082e5f4ef4847a6194a5815b1c9","target_text":"Ý chí kiên định, bước chân thong thả!\\nTiểu thư ung dung"},
    {"uid":"zhcn:f97e12d6057252dc2fa0877c","source_fingerprint":"4d4ffe2d20ae8524559e5d3af9d950cd76c48d1d6e2385d32a4adeb2abd77661","target_text":"Đứa con thuần khiết, trắng trong của thiên nhiên"},
    {"uid":"zhcn:8905276eb4e15eddebf064e3","source_fingerprint":"d456f4095a5fba13590ffe53c72abf627624d832a10198576489d204b8f69932","target_text":"Điềm tĩnh mà bất khuất.\\nHoa anh đào nở vượt qua mùa đông"},
    {"uid":"zhcn:a5b44aa905e7beb7f7cdfdee","source_fingerprint":"e36a2711428bcca37a17b6fb6b8db914bf33a96526f02e1a7d1a164426dcee69","target_text":"Học sinh ưu tú hoàn hảo và sáng sủa!\\nThế mà lại toát ra khí chất nhân vật phụ...?"}
