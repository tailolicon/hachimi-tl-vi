    {
      "uid": "zhcn:1185c014e85a30b3e3ec68e8",
      "kind": "localize",
      "source_text": "特设网站将在预定期限内公开\n公开期间结束后也有可能再次登载",
      "source_fingerprint": "934eb85ee59e280e9c08b7b40e6b85c77da43bf616eb9faeadfe7be6aa4d2536",
