      "source_path": "localize_dict.json",
      "json_path": [
        "Race0532"
      ]
    },
    {
      "uid": "zhcn:62f76a71df5bf6e96c20dbac",
      "kind": "localize",
      "source_text": "同策略马娘太多",
      "source_fingerprint": "d7defd00f22627c6d4d9835ad77f68cef3478e08f27b3e141df0da7da5ed7fad",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0534"
      ]
    },
    {
      "uid": "zhcn:73b0635e4bfc24904efefd80",
      "kind": "localize",
