      "uid": "zhcn:3aba44d0f85408cd29d01639",
      "kind": "localize",
      "source_text": "干劲不足",
      "source_fingerprint": "d7ec939e46513965f6c3f7d3ecfae29613b73a3ddde6d8999887d0150e8fe255",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0528"
      ]
    },
