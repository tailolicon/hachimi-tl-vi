        "SingleMode701023"
      ]
    },
    {
      "uid": "zhcn:e9e705a6a113c72fb57c1bcb",
      "kind": "localize",
      "source_text": "<atlas=PreIn sprite=utx_ico_notice_00/>宝石每天最多可获得20次",
      "source_fingerprint": "657e7c1a7a31bc42ee795c61a75c0fe2ca4e9ca5737a66ce10bb58ad946260bf",
