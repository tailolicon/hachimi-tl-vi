      "source_path": "localize_dict.json",
      "json_path": [
        "SingleMode661042"
      ]
    },
    {
      "uid": "zhcn:8af4e4325bb77c1b58fd891c",
      "kind": "localize",
      "source_text": "是否将育成出的赛马娘与设定的计划进行比较？",
