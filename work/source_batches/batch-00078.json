        "SingleMode701024"
      ]
    },
    {
      "uid": "zhcn:9c92550ac19f0ffdfacbbf31",
      "kind": "localize",
      "source_text": "设置优先技能后，将在养成活动等场合中\n优先获得优先技能的诀窍",
      "source_fingerprint": "a69fdb8b74c6ba69a581cd14aed46a6c1453c0589e92356b22dfe194ec6a314c",
      "source_path": "localize_dict.json",
