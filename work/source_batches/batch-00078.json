    {
      "uid": "zhcn:b81f9e45ea8ff01bc18a551d",
      "kind": "localize",
      "source_text": "在特殊回合选择比赛时",
      "source_fingerprint": "ef2251f4b43879ba97d21bbb6b1583e6377caffaf1ab31e53fceba3d3933b193",
