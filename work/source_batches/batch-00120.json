    {
      "uid": "zhcn:7a45a546d163d5f2ff4b9444",
      "kind": "text_data",
      "source_text": "可在★3必得赛马娘奖池第１R\\n进行抽奖的抽奖券。\\n可在奖池一览中使用。",
      "source_fingerprint": "84659426bd8ae37b4eddef3178f8f58366c1e10af0054e9824e2e21f88d1be4d",
