      "json_path": [
        "131",
        "10"
      ]
    },
    {
      "uid": "zhcn:ff6bae0e5926016e180a3025",
      "kind": "text_data",
      "source_text": "取得朱鹮夏季短跑赛、光速秋季短跑赛、\\n韦驮天锦标的胜利",
      "source_fingerprint": "7ac12d3e0b1ad70a4cad9b7008aad17092bcaabd971711319db82689b53de3b4",
