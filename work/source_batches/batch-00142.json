      "source_path": "text_data_dict.json",
      "json_path": [
        "131",
        "101"
      ]
    },
    {
      "uid": "zhcn:5c1f9fa572ca6840dde20a1f",
      "kind": "text_data",
      "source_text": "取得青叶赏和日本德比的胜利",
