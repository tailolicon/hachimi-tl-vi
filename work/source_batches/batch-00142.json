        "1"
      ]
    },
    {
      "uid": "zhcn:7d2c81901a64fee331f5209c",
      "kind": "text_data",
      "source_text": "使用作战[领放]或[先行]在GⅡ或GⅠ级别的比赛中以3马身以上的差距取得胜利合计6次",
      "source_fingerprint": "252d4d880de73a525ec91761c16f663bb6fac857e3d34ae4380f21822a0fe49d",
