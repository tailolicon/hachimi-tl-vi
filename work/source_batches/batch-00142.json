      "json_path": [
        "131",
        "103"
      ]
    },
    {
      "uid": "zhcn:f88a67deb8460317b184893f",
      "kind": "text_data",
      "source_text": "取得希望锦标的胜利，并取得有马纪念（第二年、第三年）两连霸",
