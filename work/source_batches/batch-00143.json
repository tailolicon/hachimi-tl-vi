    {
      "uid": "zhcn:583700a1f5f27a678acfb5ad",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "以3又1/2个马位的领先距离取得皋月赏的胜利；\\n以5个马位的领先距离取得日本德比的胜利；\\n以7个马位的领先距离取得菊花赏的胜利；取得有马纪念两连霸。",
      "source_fingerprint": "5eb7c2f9c39a164003657e500d1dac5a22b05c36f27cbbb41151c26f8f43dd42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
