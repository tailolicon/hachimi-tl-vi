      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "完成10次以上青春之魂爆发\\n※青春杯～团队默契绽光芒～限定",
      "source_fingerprint": "c5f060700d40e6bf131e8384880dace1521cdc618812fbd0de58fa466d662830",
