    {
      "uid": "zhcn:a219c7521ae6fcd50d9a74f7",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "向光明的彼方前进！\\n冲向最速的直线组长",
      "source_fingerprint": "ec2250e27beed5ea0fc051816bda46e9fee908ecc9eec8738725b20a763f96a9",
