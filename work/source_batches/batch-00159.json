      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "打磨至臻的自信熠熠生辉，\\n此乃Queen Heart！",
      "source_fingerprint": "00aa20b4457946cce8b4e5e5ec2f5d582886ab4db476f66fe5609d3f764a1e2d",
