    },
    {
      "uid": "zhcn:ea2309d80335b5e93de08523",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "睁大双眼吧。\\n闪耀的双脚，忠义的圣剑",
      "source_fingerprint": "e8ce7d86456a21ce56d6a4b40f275338de9497091eb12e24fc15c381fd5321b3",
