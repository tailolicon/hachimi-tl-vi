    {
      "uid": "zhcn:e63f2ae4182946f5a9a6b9c6",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "百折不挠。\\n无论输多少次，这颗心都不会破碎！",
      "source_fingerprint": "94f80e5ab7df760f43be1dd7e69e9de800a4734d7e4366172fa386284ccef80c",
