    {
      "uid": "zhcn:f49b764f3655e2717afcbe43",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "心怀母亲的期盼，\\n脚踏实地……达成毕生心愿",
      "source_fingerprint": "20c361d8c3cd3e34b2d3f625eeac9866f4047ba8968946080689faff14856fde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
