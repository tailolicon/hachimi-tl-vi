    {
      "uid": "zhcn:0d330557228406a755b8360e",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "刚毅的高贵妇人。\\n只会强势地绽放！",
      "source_fingerprint": "89dc92c623933a71b9e68267b2e4275ae78727710cf57493a553ee5ce37786ea",
