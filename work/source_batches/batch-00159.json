    },
    {
      "uid": "zhcn:4df87cff91651b996329a163",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "冲出去吧！\\n无限的希望与棉花糖般的心♡",
      "source_fingerprint": "d40290e830a9d5e9a7700a3f4575115cae641187663d9f0ab2921b9e8a076fe6",
