    {
      "uid": "zhcn:cdca759639f706f5866898a8",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "可能性无限英里！\\n最强英里马娘",
      "source_fingerprint": "219e14dd363ec90dbdd1f776ca8330c9222fe263e6687b7a4739d983991ae930",
