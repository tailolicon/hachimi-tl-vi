    {
      "uid": "zhcn:9806461def522f7cabed4446",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "悠然自得、不骄不躁而又充满毅力。\\n永不言弃的有骨气的赛马娘",
      "source_fingerprint": "3ac6e96b1598e861f57db78bdbb94c49694a51bd82cb6852d9e025bfc4046f9f",
