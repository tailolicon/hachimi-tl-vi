      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "创造传说！\\n以独特的视角追寻着最强",
      "source_fingerprint": "074c0fc1531ac9bcb2e0d2308d488983b382969bb985b2029af581e9bc098bdd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
