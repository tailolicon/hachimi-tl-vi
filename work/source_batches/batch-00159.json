    {
      "uid": "zhcn:c16244597700d798237359ef",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "有点儿不可思议？相当之不可思议？\\n宇宙般神秘的赛马娘",
      "source_fingerprint": "f5761e7e6c26c834b6d338d5c3f47acf8e8da1a0737f5b63e29ca50b58764583",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
