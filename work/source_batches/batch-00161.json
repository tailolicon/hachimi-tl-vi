      "source_path": "text_data_dict.json",
      "json_path": [
        "131",
        "225"
      ]
    },
    {
      "uid": "zhcn:ba351eed3eac527681f844fa",
      "kind": "text_data",
      "source_text": "使用「领放」战术以第四或更低人气取得GⅠ胜利；\\n使用「领放」战术取得第三年春季天皇赏、宝冢纪念、有马纪念的胜利；\\n「领放」适性达到S或以上",
      "source_fingerprint": "d14f528c8456eebe27352f330046008b011135cc4cc23f3cf54109c8fd7ab91b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "131",
        "226"
