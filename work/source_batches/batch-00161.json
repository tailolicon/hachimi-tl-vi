        "387"
      ]
    },
    {
      "uid": "zhcn:d3a96fe896b8485600ae6758",
      "kind": "text_data",
      "source_text": "将技巧提升至LvMAX并完成养成\n※仅限Beyond Dreams 共同向前，共觅荣光",
      "source_fingerprint": "994acbaea23f5a4bf233bb9a26e9ea1d18b05971d54fccf6cf4840a0fc4b6b6c",
      "source_path": "text_data_dict.json",
      "json_path": [
