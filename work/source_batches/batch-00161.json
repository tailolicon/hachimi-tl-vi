      ]
    },
    {
      "uid": "zhcn:6e501c9df51e298d0c9f5345",
      "kind": "text_data",
      "source_text": "将体能提升至LvMAX并完成养成\n※仅限Beyond Dreams 共同向前，共觅荣光",
      "source_fingerprint": "60e6d859b10490a046a933c9a452b8338f609614fa4c5d8e4065e47eb3c9ca75",
      "source_path": "text_data_dict.json",
      "json_path": [
