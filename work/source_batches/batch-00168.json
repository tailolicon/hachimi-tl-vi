      ]
    },
    {
      "uid": "zhcn:f796dcdb88e2f518641fcd24",
      "kind": "text_data",
      "source_text": "格斗技",
      "source_fingerprint": "dca9ab3ca2933e28275ffc217ffc9f56a13912fda1bbf26628fa96a5a561ffe9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "138",
        "98"
      ]
    },
    {
      "uid": "zhcn:e5992088afcd40e744e7145c",
      "kind": "text_data",
      "source_text": "格斗技",
      "source_fingerprint": "dca9ab3ca2933e28275ffc217ffc9f56a13912fda1bbf26628fa96a5a561ffe9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "138",
        "99"
      ]
    },
    {
      "uid": "zhcn:06120801c2248b942213cb8b",
      "kind": "text_data",
      "source_text": "佩服！　两人的关系\\n是多么的理想啊……！！",
      "source_fingerprint": "dc1a7f2f3d5e4ca133e8dd2f6a7fa84d72851d87ab5b6414b2898c34037b170e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "1"
      ]
    },
    {
      "uid": "zhcn:5ff6a3ff763f16411239c219",
      "kind": "text_data",
      "source_text": "原来如此。此等实力……\\n果然不是只会耍嘴皮子而已啊。",
      "source_fingerprint": "d974c3fce29e8eb4b747557f82e41fce9cb472bcfa2254a8f9ec2ea8143c7ac3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "10"
      ]
    },
    {
      "uid": "zhcn:8bb5f212516ee8900a400bdf",
      "kind": "text_data",
      "source_text": "从今往后，也请你负起训练员的责任，\\n以热忱之心与赛马娘诚挚来往。",
      "source_fingerprint": "69fc480177a7c5408e7d6a68ecbfad9510a78a955824d04e1d59ac89f5601242",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "11"
      ]
    },
    {
      "uid": "zhcn:ed4c5798244384ef19251576",
      "kind": "text_data",
      "source_text": "希望你今后的表现也能不辱特雷森之名。",
      "source_fingerprint": "7c1638bbbbae75ed43e99b7b6a24f40d8adc9150a57426be2837d3539b4476fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "12"
      ]
    },
    {
      "uid": "zhcn:20653fd306783b0bce07e4b4",
      "kind": "text_data",
      "source_text": "最近每次来观摩都会令我着迷。\\n……着迷于各位所散发的光辉。",
      "source_fingerprint": "9e8aa264767e985c2038607507c454387d75aca4529a7cf03d574be9813d1e48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "13"
      ]
    },
    {
      "uid": "zhcn:da66328e7c7f22dcfcfa7c17",
      "kind": "text_data",
      "source_text": "完成度又更高了……！\\n真不愧是训练员呢。",
      "source_fingerprint": "4e25dd09cd1268caebbbaab2c712a9e2bf82274ae9255765390da47998e63a17",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "14"
      ]
    },
    {
      "uid": "zhcn:3731ef69e0c3bb3769555b35",
      "kind": "text_data",
      "source_text": "看来日积月累的努力\\n有确实为她所吸收！",
      "source_fingerprint": "ac763a8b9341802b065ae02dd6b6726110a053cf6d9280475f42ac438885d761",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "15"
      ]
    },
    {
      "uid": "zhcn:7af4cf3e0cbf89b41b3a8778",
      "kind": "text_data",
      "source_text": "如果有什么我能帮上忙的地方，\\n请不要客气尽管告诉我喔～",
      "source_fingerprint": "b58dad4e14ea2bf563354f361418c3648a4b625cb186b944b4f3d5d354199a3f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "16"
      ]
    },
    {
      "uid": "zhcn:11d07807ea6005494d6a38df",
      "kind": "text_data",
      "source_text": "优秀！\\n期待能有更上一层楼的活跃表现！",
      "source_fingerprint": "c6dabd4fe1396b4b7357f16b8e7a940a60ec29a1792254d33f762ef64b91bc17",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "2"
      ]
    },
    {
      "uid": "zhcn:a0005d56a762693b314ee6d0",
      "kind": "text_data",
      "source_text": "真的……非常以你们为傲！\\n你们正可说是──梦想。",
      "source_fingerprint": "afbd2231d5e3ec385cb1038ab64ac33893fff62f9b3853b2730043b0b4d9f8fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "21"
      ]
    },
    {
      "uid": "zhcn:a447173ab530055fe8681719",
      "kind": "text_data",
      "source_text": "喜悦与烦恼都能共有共享。\\n对彼此而言都是无可取代的伙伴！",
      "source_fingerprint": "99e3eed5e5aef1d7d24fd621143ce0ef6d35d035a2608c3d71223dc9e5dfea0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "22"
      ]
    },
    {
      "uid": "zhcn:2f8e7ebbe481318423ce8d53",
      "kind": "text_data",
      "source_text": "似乎与专任建立起良好关系了呢。\\n不错不错，很棒喔～！",
      "source_fingerprint": "b615bec229064de01f7e7f09a0f445abb6e8196a31439b4088e55ee382b69f8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "23"
      ]
    },
    {
      "uid": "zhcn:a7ada67c09a8c545f734c604",
      "kind": "text_data",
      "source_text": "有什么烦恼吗？\\n有什么事都可以来谈谈喔！",
      "source_fingerprint": "e5c15fcedbcc9928ad5069b6fcdce5b4066e48cac9706ce325217a4019834e8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "24"
      ]
    },
    {
      "uid": "zhcn:75e578efb4f8557f10c70fd2",
      "kind": "text_data",
      "source_text": "感動とは……貴方たちのような\\n強い絆から生まれるのですね。",
      "source_fingerprint": "7b90beb22e477b85421fb87e4f64980dc4145fba6b1e2f97b8215f9d64b37bb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "25"
      ]
    },
    {
      "uid": "zhcn:65ba38bf8373df451634ae61",
      "kind": "text_data",
      "source_text": "大変ご活躍のようですね……！\\n私個人としても応援しています。",
      "source_fingerprint": "5ec74d348bdbb5252c8e57093ff3027379fac9591c4bb017720be183e8ed1aa3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "26"
      ]
    },
    {
      "uid": "zhcn:33ffeee7773cb8ed8d844139",
      "kind": "text_data",
      "source_text": "お二人が共有する熱意……\\n私もそれに、倣おうと思います。",
      "source_fingerprint": "5003a0b0505f8ca92c86ef9b89d75285d71b85b9828a9ae98f37abd23490bddc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "27"
      ]
    },
    {
      "uid": "zhcn:30f2441b6e7fe901fbc85adc",
      "kind": "text_data",
      "source_text": "相談したいことがございましたら\\nいつでも仰ってくださいね。",
      "source_fingerprint": "664c97e03d39f11ae627531dddd1183b4215bbf41e7987095107c628216303b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "28"
      ]
    },
    {
      "uid": "zhcn:644c37e5be0a1704e0dd034d",
      "kind": "text_data",
      "source_text": "我感觉到了，感受到了啊！\\n灵魂燃烧的声音！达哈哈哈！",
      "source_fingerprint": "ccc78b6a33dad4a039ad75058f04b60a38c1f180e2783cd82dde4758602e8daa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "29"
      ]
    },
    {
      "uid": "zhcn:1cf7655a7dcbf203f5eeced8",
      "kind": "text_data",
      "source_text": "不错！　实力似乎\\n渐渐增长了呢！",
      "source_fingerprint": "7fc749db6212824759642712437022d8454375b611f958d59daa71f265583c2d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "3"
      ]
    },
    {
      "uid": "zhcn:f27e8e4efe9e72ea45e89007",
      "kind": "text_data",
      "source_text": "你的活跃传闻连无人岛上都常听到！\\n哎呀，真是！完全超出我的预想啊！",
      "source_fingerprint": "a5593926ffdd27d6687c8412a1cf3645e670a02e6f23843b4782532de7443171",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "30"
      ]
    },
    {
      "uid": "zhcn:9cc52d510210a3f4b80dcd26",
      "kind": "text_data",
      "source_text": "看起来你很努力啊！\\n好，下顿伙食我就给你加个菜！",
      "source_fingerprint": "ab33a986151ddc7df91ffee4ed4ffafb440418d9e8b81c06a48565a9d788397e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "31"
      ]
    },
    {
      "uid": "zhcn:87c0e2679f4d642759d8ea1d",
      "kind": "text_data",
      "source_text": "哟哟！最近怎么样啊！\\n尽管冲吧，一路奔跑到终点！",
      "source_fingerprint": "bd37b94e8a8523d0ecede558a45aee480bfb0e05ccd4022615fa7cf5fd59d20c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "32"
      ]
    },
    {
      "uid": "zhcn:36e77aa0d64daa98cf733337",
      "kind": "text_data",
      "source_text": "我关注赛界这么多年，\\n你们俩真是绝佳的搭档啊！",
      "source_fingerprint": "46f17aeaa97eba00afc0c20873747d2cd70e0f896c88ba5c05fda05df7fbf6c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "33"
      ]
    },
    {
      "uid": "zhcn:918b7ed25dca7e13560a3aab",
      "kind": "text_data",
      "source_text": "建立起了很好的信赖关系呢！\\n今后也要好好珍惜这份情谊啊。",
      "source_fingerprint": "351cba0ceefabee89d38dbf454620f6ea189ffaaad199dc47eab5580b449cff6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "34"
      ]
    },
    {
      "uid": "zhcn:fedf1ea451e692a1e5b37d82",
      "kind": "text_data",
      "source_text": "牵绊也越来越深厚了呢。\\n注意保重身体，好好加油吧。",
      "source_fingerprint": "7f52f76ae41f28b960052cc3c692ebc126173d34159cc77b4527ea9c0539217a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "35"
      ]
    },
    {
      "uid": "zhcn:1ca45d0016ec31c20dec9f92",
      "kind": "text_data",
      "source_text": "过得还精神吗？\\n要是累了，就再来旅馆歇歇吧。",
      "source_fingerprint": "4c490df98c9d01e4a42bb9a3127adc68585980638005f5b2451bc75d72590d71",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "36"
      ]
    },
    {
      "uid": "zhcn:4c43f4199c820f86a7794ee8",
      "kind": "text_data",
      "source_text": "赌上绝不退让的梦想去挑战，这就是BC！\\n让我们齐心协力向前迈进吧！",
      "source_fingerprint": "d139e02fe207619fad52d8c2c6d7c1b35044162c0f5e42732448479a2bc32e4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "37"
      ]
    },
    {
      "uid": "zhcn:7c570ab7afdc76a9f2735b72",
      "kind": "text_data",
      "source_text": "大家的热情，我都切实感受到了！\\n甚至连我都有些跃跃欲试了呢！",
      "source_fingerprint": "c0f44cd22bbd556fea280c5a344fa4e52bbe6c06e0af58105f927523e2ebb79e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "38"
      ]
    },
    {
      "uid": "zhcn:d6362291caed83c09b025f8b",
      "kind": "text_data",
      "source_text": "大家都是才华横溢的赛马娘。\\n指导起来非常有成就感。",
      "source_fingerprint": "67cae1a85ce2bca959deb3e3de142443d7e159dacba6d3fdc34d270af6942dc1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "39"
      ]
    },
    {
      "uid": "zhcn:bbe951faf0a2c9539879a0a2",
      "kind": "text_data",
      "source_text": "鼓励！　期待今后的\\n成长哦！",
      "source_fingerprint": "344bcbe0169b5f2a57744fddd75ced3348e7b59a7ebfb6ba4046f79ac5a0b03d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "4"
      ]
    },
    {
      "uid": "zhcn:e50de61bc36addb47e36358f",
      "kind": "text_data",
      "source_text": "来提升一下Motivation吧。\\n凡事都是start最关键哦。",
      "source_fingerprint": "f2035af70751a0a76aa2ae779f29305f80ff24aa742ebe743dd784f2b5274537",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "40"
      ]
    },
    {
      "uid": "zhcn:8c2fada97c8dfff6115887cb",
      "kind": "text_data",
      "source_text": "离梦想触手可及的日子已经不远了呢！\\n真不愧是训练员您呀。",
      "source_fingerprint": "00f1e0e65c44d148ec409f1811eb30893faecb503585dd641028149e54c7f2f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "41"
      ]
    },
    {
      "uid": "zhcn:ad58381e3710ac9af60b9f85",
      "kind": "text_data",
      "source_text": "关于你们的活跃表现，在特雷森学园里\\n也已经传为热门话题了哦！",
      "source_fingerprint": "91d115fae4253cd5727253aa098845656a157f3edf6bc649a2735cac92a5db52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "42"
      ]
    },
    {
      "uid": "zhcn:f70ac904c319e4d0a7f74caa",
      "kind": "text_data",
      "source_text": "就连我个人，也越来越期待\\n两位的成长了呢♪",
      "source_fingerprint": "f61af365f561c2c3a6e9b65b25fc80071fe8e419e2ffc19ea1d59000816d6593",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "43"
      ]
    },
    {
      "uid": "zhcn:75104d7faaa61f79d3ba3492",
      "kind": "text_data",
      "source_text": "今后也请携手并进，\\n不断成长下去哦。",
      "source_fingerprint": "cb278220c7be2260c3094b7d2da9c997599ead3858e6f9922b6e146aa5a4e4ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "44"
      ]
    },
    {
      "uid": "zhcn:330c1d6fa7801d453b0abc78",
      "kind": "text_data",
      "source_text": "――愿两位的缘分，\\n今后也能永世长存。",
      "source_fingerprint": "90696a3acd8a5a9bf53ca6a73f8aaece2ac87a8328672759f3539ae56125a45d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "45"
      ]
    },
    {
      "uid": "zhcn:11a6aaaadbce8a5f6f1e4715",
      "kind": "text_data",
      "source_text": "两位共同砥砺前行的历史，\\n定会成为后世的助力吧。",
      "source_fingerprint": "e608b60a9b2f484755f68db381f27435a27ecfced033f3b64e3652537dd0eea2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "46"
      ]
    },
    {
      "uid": "zhcn:3d50aba04a62f45799c68d62",
      "kind": "text_data",
      "source_text": "愿诸位前行的道路……\\n尽是光芒万丈。",
      "source_fingerprint": "a77c72247257b396f155478cc1503e935497477cc50f77bdad3c811c9240b8ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "47"
      ]
    },
    {
      "uid": "zhcn:811629fb9bfd7bedb08c747a",
      "kind": "text_data",
      "source_text": "无论是智慧还是祈愿――\\n凡所能赐予之物，皆归于诸位。",
      "source_fingerprint": "db0b0bdc2cf74672fc1314f5dc518a855780a1d1f6609a619cceb83b03fa4194",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "48"
      ]
    },
    {
      "uid": "zhcn:886d486e85a00446d0ea664d",
      "kind": "text_data",
      "source_text": "这种成长速度……灿烂的眼神……\\n啊啊！　真是太～～棒了！！",
      "source_fingerprint": "fab78ccc90be1695d70b6e28c14cdad6cd28f4229a1468b91a7030cf40a85c1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "5"
      ]
    },
    {
      "uid": "zhcn:a9f47107b276bd1bd69402bf",
      "kind": "text_data",
      "source_text": "能代表赛马界的\\n就属这对赛马娘与训练员了吧！",
      "source_fingerprint": "1429286b326e029eba16ff21c76c1f36788eb84c8672dc66cc88aab2912f6c83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "6"
      ]
    },
    {
      "uid": "zhcn:112f558d96d9e678d0136c1d",
      "kind": "text_data",
      "source_text": "差不多该写篇\\n专题报导了吧……！",
      "source_fingerprint": "e72f044f937439bf404889eb5466e672ae7edb7f8ecc54bcb2fecfc5c70f87f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "7"
      ]
    },
    {
      "uid": "zhcn:06e26234bc04df372f316fec",
      "kind": "text_data",
      "source_text": "更加期待你们\\n今后的活跃了。",
      "source_fingerprint": "604293883f1fa6236ac62efef53ccda61dd928f746c802417e5f85dcf304bb87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "8"
      ]
    },
    {
      "uid": "zhcn:25d674473704096e51612e50",
      "kind": "text_data",
      "source_text": "没想到你们竟会进步到此等水平。\\n……让我继续见证你们的未来吧。",
      "source_fingerprint": "c511e1b7d05c93aeed2a73c1647c27833922a1443162cc89898f146048b7ac05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "9"
      ]
    },
    {
      "uid": "zhcn:684ee3692828afb3274eb34d",
      "kind": "text_data",
      "source_text": "体操服",
      "source_fingerprint": "d9922b14af61c547139398397d14d78b3b91e0570bbef2ec03e54d35f1e7ff72",
      "source_path": "text_data_dict.json",
      "json_path": [
        "14",
        "1"
      ]
    },
    {
      "uid": "zhcn:e7fa44f29398fa2502e7bb30",
      "kind": "text_data",
      "source_text": "特别梦想家",
      "source_fingerprint": "d517c9816e277b53943946b7839aace535e175b3c88b1771f99ef3eee21c17c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "14",
        "100101"
      ]
    },
    {
      "uid": "zhcn:afee982816820a76a6895a9c",
      "kind": "text_data",
      "source_text": "日本第一总大将",
      "source_fingerprint": "44c3edcd90c40d05d5d520984d7469d85587462b6498c3b6391cff2659cd986b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "14",
        "100102"
      ]
    },
    {
      "uid": "zhcn:b7ec75509b32e69d32fee8de",
      "kind": "text_data",
      "source_text": "雀跃♪维他命心拍",
      "source_fingerprint": "acfee065c3a124452b4d6d51eb026bc71e46e00b7a8fb132210b9104f6361c03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "14",
        "100130"
      ]
    }
  ]
}
