{
  "schema_version": 1,
  "batch": 174,
  "batch_count": 1672,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "f85e64da034d2ca23051e8bbc3f69b7e20001b4b",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:41ed93559a9bcab88945c6ad",
      "kind": "text_data",
      "source_text": "真刀真枪来个一决胜负！\\n热血・风纪委员长！",
      "source_fingerprint": "8049a699b56716d02ef78da3aa74314754e5a351cb22bb1d7d3abce337b4453d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1053"
      ]
    },
    {
      "uid": "zhcn:fe23a748e721231018232e6c",
      "kind": "text_data",
      "source_text": "正义之焰熊熊燃烧！\\n热血英雄，登场！",
      "source_fingerprint": "a25f16d03efecde911032ca15db1e620f194b5dd9b23a5b63e6a60b08a801189",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1054"
      ]
    },
    {
      "uid": "zhcn:cde65fdfe7cfd0e822ec037b",
      "kind": "text_data",
      "source_text": "Marvelous！\\n元气地、无敌地改变世界！",
      "source_fingerprint": "640d214e4bdecb06091de5db8e2e02370d5d6148fb3f5f33be65688d36e0be02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1055"
      ]
    },
    {
      "uid": "zhcn:77a62f51f8c77a2016420af4",
      "kind": "text_data",
      "source_text": "福啊，来吧！\\n热爱占卜的福运祈愿少女",
      "source_fingerprint": "dbd154abb15b2d4f44fdd7ef4c3f0e6d41249736bdd02ca040e18661f89578a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1056"
      ]
    },
    {
      "uid": "zhcn:f39700e7e803f135dcfe8379",
      "kind": "text_data",
      "source_text": "不受任何束缚！\\n纯朴真挚的活泼赛马娘",
      "source_fingerprint": "ddf435e289fed58ed97cdc1cf1c4a7de86dfb6deea0440a193cb4f3fb290ae03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1057"
      ]
    },
    {
      "uid": "zhcn:d043f63b5d5ff173fa7b40a0",
      "kind": "text_data",
      "source_text": "想变得积极向上！\\n消极的努力家",
      "source_fingerprint": "356d55d3762e945f115c54ec9a8cfd1f894d58b35addc5842ea5eb07351bd3c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1058"
      ]
    },
    {
      "uid": "zhcn:b3d10c5dd97261346e570755",
      "kind": "text_data",
      "source_text": "想要改变！\\n带着过去的伤痛奔跑的大小姐",
      "source_fingerprint": "cfb7059a307cd06a1fdb27f60f68d7a4c4f1b90d3712f2fff59e5d6e101c31fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1059"
      ]
    },
    {
      "uid": "zhcn:4ba29aad0844a85cdb9bf0ce",
      "kind": "text_data",
      "source_text": "对期待说No, Thank You？\\n疑心重重的少女",
      "source_fingerprint": "4b6e88e3392ddf56a07a403e15c8ce1b1938305fa396c1638d748a350d2f9ae6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1060"
      ]
    },
    {
      "uid": "zhcn:75239011e9af37e472769871",
      "kind": "text_data",
      "source_text": "盛气凌人的大小姐。\\n那份自尊心比天还高！",
      "source_fingerprint": "0a32c75388011f95812cb98033f749b50039b461fa01f07c7407bd0b3f8e3fe5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1061"
      ]
    },
    {
      "uid": "zhcn:2db4816fc228f385b8ec93ad",
      "kind": "text_data",
      "source_text": "备受期待的璞玉。\\n今天也要大获全胜！",
      "source_fingerprint": "aabf51fa8cf4e0fb06d9c530d5a083364c7ebb3a946dd8596bccfc47ddcbf858",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1062"
      ]
    },
    {
      "uid": "zhcn:f6b21a092f296b09c82b41c6",
      "kind": "text_data",
      "source_text": "彻底管理主义。\\n兼备冷酷与热情的干练赛马娘",
      "source_fingerprint": "c20f59f22e75ce8c310303409493fce33914a363a8594a1197b0b32a9ceb0612",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1063"
      ]
    },
    {
      "uid": "zhcn:8d2add4f63a716667e9a7a9c",
      "kind": "text_data",
      "source_text": "放轻松吧ー。\\n值得信赖的乐观少女",
      "source_fingerprint": "98096ebd0ecb3c4443275acdd52c2fee2a707d44c75cd74284aeeb7646fd097a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1064"
      ]
    },
    {
      "uid": "zhcn:a0323aa1550cc13f78f9c51f",
      "kind": "text_data",
      "source_text": "闹吧笑吧嗨起来☆\\n每天都是・派对咖！",
      "source_fingerprint": "21c81c6062ff9df701f53c3da07dcd0f7fc7fc5c28eacb2695f9513d03c82401",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1065"
      ]
    },
    {
      "uid": "zhcn:64c9fee79b60089c1be3185c",
      "kind": "text_data",
      "source_text": "涡轮全开！\\n不受极限束缚的暴走赛马娘！",
      "source_fingerprint": "12f4281facf01c11cad1f19dca55cdf0fc5b553cf39632769a3e9acf0655137d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1066"
      ]
    },
    {
      "uid": "zhcn:82c498226e789f9af7dfe87d",
      "kind": "text_data",
      "source_text": "内心坚强度是钻石级别！\\n挑战厄运的大小姐",
      "source_fingerprint": "781c7ff6738b57df38f1b170774c4099583c0e8bbe7e5bf22c83bf4802ae0928",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1067"
      ]
    },
    {
      "uid": "zhcn:02e073375e570a8b75b6058a",
      "kind": "text_data",
      "source_text": "照亮大家的心！\\n开朗活泼的庆典少女！",
      "source_fingerprint": "7d23ad3dfafda2d5552795a81b72d79eee6bccdc3eab7bb20353c4d10c8949c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1068"
      ]
    },
    {
      "uid": "zhcn:2197dcc6355574d5ac492859",
      "kind": "text_data",
      "source_text": "追求着所憧憬的！\\n坦率的努力家赛马娘",
      "source_fingerprint": "1636092b2780f82a8e35c20b6cd3044d4c71eab18f24510e74e712967cd1b8c0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1069"
      ]
    },
    {
      "uid": "zhcn:8de0dd83f1b0811b9098f4b1",
      "kind": "text_data",
      "source_text": "成为世上最闪耀的星！\\n充满魅力的野心家赛马娘",
      "source_fingerprint": "13c0be31364f6af22bcf0468e9414c7d5dc598ce806e9db975efd997645b1d3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1070"
      ]
    },
    {
      "uid": "zhcn:e3bdf6fc246e38570b21b9ca",
      "kind": "text_data",
      "source_text": "即使身体虚弱也要坚强地绽放光芒。\\n天生一双玻璃脚的闺秀",
      "source_fingerprint": "88d6608bafe7796a711583595a8930dc2e8a59ee211244f95eb4993915c9fa0a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1071"
      ]
    },
    {
      "uid": "zhcn:ab6f7f3d56f1e6f2d0f56bc6",
      "kind": "text_data",
      "source_text": "以武代礼，全力奔跑。\\n武痴赛马娘",
      "source_fingerprint": "77058b9103f04cfc5a0f07eaab326dfb8026ca4b2c0b96c3f12176730939fa52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1072"
      ]
    },
    {
      "uid": "zhcn:77f74e64e8883f9e129404cb",
      "kind": "text_data",
      "source_text": "目标三冠！常备不怠！！\\n超越极咕哇啊？！",
      "source_fingerprint": "d68d85cfe2113478169e9bdf36e4a6bbd9c52c52b9f34ff755e6f4bf45ca0be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1073"
      ]
    },
    {
      "uid": "zhcn:24afb086fe7700c540b4cd49",
      "kind": "text_data",
      "source_text": "意志坚定，步伐放缓！\\n悠闲的大小姐",
      "source_fingerprint": "ee1f192987e3a97288a49831253f7cecaf7ea082e5f4ef4847a6194a5815b1c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1074"
      ]
    },
    {
      "uid": "zhcn:f97e12d6057252dc2fa0877c",
      "kind": "text_data",
      "source_text": "洁白纯净的大自然之子",
      "source_fingerprint": "4d4ffe2d20ae8524559e5d3af9d950cd76c48d1d6e2385d32a4adeb2abd77661",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1075"
      ]
    },
    {
      "uid": "zhcn:8905276eb4e15eddebf064e3",
      "kind": "text_data",
      "source_text": "稳重而不屈。\\n越过冬天绽放的樱花",
      "source_fingerprint": "d456f4095a5fba13590ffe53c72abf627624d832a10198576489d204b8f69932",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1076"
      ]
    },
    {
      "uid": "zhcn:a5b44aa905e7beb7f7cdfdee",
      "kind": "text_data",
      "source_text": "爽朗的完美优等生！\\n然而是配角一般的气质……？",
      "source_fingerprint": "e36a2711428bcca37a17b6fb6b8db914bf33a96526f02e1a7d1a164426dcee69",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1077"
      ]
    },
    {
      "uid": "zhcn:054f7f0a36179618e6ae02e5",
      "kind": "text_data",
      "source_text": "自然派微风赛马娘。\\n其灵魂却如烈风",
      "source_fingerprint": "18d8bfeae528447984d94ed38849eac1ca3d0024b0cb4bb064ec6c5e72fb319a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1078"
      ]
    },
    {
      "uid": "zhcn:f7687e3b5e8bdb053cc93004",
      "kind": "text_data",
      "source_text": "坚定不移的船桥爱。\\n来自地方的文静留学生",
      "source_fingerprint": "dc8871437c6285bac29fa10b1ea059b437fca89ea9dfc13700e5f38d66258b65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1079"
      ]
    },
    {
      "uid": "zhcn:08a5047573769d3f91d5b0f9",
      "kind": "text_data",
      "source_text": "想要兴奋不已！\\n追求未知的情报商",
      "source_fingerprint": "c082f00f037880fe1ab7ccc2d11b40c2f91cd3d51f10af83b9799971a78ba8c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1080"
      ]
    },
    {
      "uid": "zhcn:3cf37486d91823de1f5dd589",
      "kind": "text_data",
      "source_text": "可别小看我！\\n尖声的处于叛逆期的少女",
      "source_fingerprint": "acb69231f6ef8a1d84fa7a5e00f4cf6b1ce652e6ab50dadc324211372efdeac8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1081"
      ]
    },
    {
      "uid": "zhcn:fe96b9f674e1fa2868b892bc",
      "kind": "text_data",
      "source_text": "光辉需要磨练！\\n闪耀的时尚达人",
      "source_fingerprint": "dfa73c875f250bbddb3663ba671f6c952daa551ca49a3c7b8d2188e421e2143c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1082"
      ]
    },
    {
      "uid": "zhcn:fbce213604736623c80ade1a",
      "kind": "text_data",
      "source_text": "海外诞生，\\n沉默寡言的任务执行者",
      "source_fingerprint": "60e801e479f7712944dcc44ff2e3d32262a7f707c09269cc8426deff1c30fe5f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1083"
      ]
    },
    {
      "uid": "zhcn:a4135e7326103a92fc9cad26",
      "kind": "text_data",
      "source_text": "可别止步于这种美学！\\n追求完美的破坏神",
      "source_fingerprint": "3020ddd8441596e9dec9571b9738460e30e63722c27eddd105517e724270cbe9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1084"
      ]
    },
    {
      "uid": "zhcn:c31239082c2bfa7c9132fc3e",
      "kind": "text_data",
      "source_text": "胜利是必然的。\\n华丽一族的赛马娘",
      "source_fingerprint": "7f94fd779ab42dfe3ddb05aab08ae355841aabdd84d2fbe5fc4e142697e8f2c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1085"
      ]
    },
    {
      "uid": "zhcn:c0f9775e5bec53c171fa5783",
      "kind": "text_data",
      "source_text": "将至高无上的爱献给比赛……\\n绝世独立，绽放于顶点的魔性之花",
      "source_fingerprint": "123934297e76e1f3c2c692633efa7a48b431b68bea2490cf3d6c56d2e673ef18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1086"
      ]
    },
    {
      "uid": "zhcn:8b8525463c3b3e7d1be091b2",
      "kind": "text_data",
      "source_text": "目标是成为吉祥物。\\n有着奇幻气质的不可思议的孩子",
      "source_fingerprint": "3e9f78a2cdf825dbddf9cf857c0f2e92a4ceeba55f1fe70355e98a31003e37db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1087"
      ]
    },
    {
      "uid": "zhcn:b10b6d9b4105898b2c7025fc",
      "kind": "text_data",
      "source_text": "草地上的魔术师！\\n值得信赖的精英姐姐",
      "source_fingerprint": "98e8373db45f03290e0a441c14593b5c0f2e195e8a1162952edf3af9fed34712",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1088"
      ]
    },
    {
      "uid": "zhcn:5dfea77b27aa5c916a761d07",
      "kind": "text_data",
      "source_text": "内向的心中怀着壮志。\\n目标是成为伟大的赛马娘",
      "source_fingerprint": "cda74e3dc3d85bbc83f6f9584a662aa3d77edb1d2208dc665c024d30257c12ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1089"
      ]
    },
    {
      "uid": "zhcn:2b51d7801b58c5bf75317e42",
      "kind": "text_data",
      "source_text": "目标是与自己相配的『女王』之座。\\n好胜的名流赛马娘",
      "source_fingerprint": "78d27666663a84679f6e3e24a74ce4fe9d8914a333afec82d180cdede046ee03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1090"
      ]
    },
    {
      "uid": "zhcn:1482f1d2fbbd4de3996af357",
      "kind": "text_data",
      "source_text": "天生讨人喜欢，\\n梦想是跨越遥远的大海",
      "source_fingerprint": "888d45fe1421045d3bc8cdbb49739d10057203736b397cad22b45b00c2d11be7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1091"
      ]
    },
    {
      "uid": "zhcn:143081fb905b0d32ac68143e",
      "kind": "text_data",
      "source_text": "老好人！\\n根本是个可爱的听使唤的人",
      "source_fingerprint": "70f8b8d958dcf38213f36123855152337e51ec159703a24c7741f0c838b1cef1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1092"
      ]
    },
    {
      "uid": "zhcn:7ab5cea3922d23e5cd3cd236",
      "kind": "text_data",
      "source_text": "为表感谢而创造奇迹。\\n温柔而稳重的赛马娘",
      "source_fingerprint": "7eb554e41f2c5aa978d2c62c4a326a20457cb17121976a96bfaef705f9eb5f4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1093"
      ]
    },
    {
      "uid": "zhcn:15568231748a42aebfd0031f",
      "kind": "text_data",
      "source_text": "以最强为目标，屡战屡胜！\\n天衣无缝的非凡不良",
      "source_fingerprint": "7022f8719c7aae335647fee653d7d560c3fba6a0e134dca34f5dffc63390e974",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1094"
      ]
    },
    {
      "uid": "zhcn:49bd88acdc7b9617b20ce843",
      "kind": "text_data",
      "source_text": "『最速』即为技艺精湛\\n坚忍不拔的匠人马娘",
      "source_fingerprint": "a7889ff096df2c8dd1740125a549d6d089639081d6038930c0fd55f7f68ca7e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1095"
      ]
    },
    {
      "uid": "zhcn:b87bced6563bea99a7996895",
      "kind": "text_data",
      "source_text": "天下统一！\\n追梦无需理由",
      "source_fingerprint": "6407b5bbd0ec5ebb149fd94717e3cfbda0be8463d19d0fd2d0de01aa7d6aa1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1096"
      ]
    },
    {
      "uid": "zhcn:5c7ac8035057d0286b79d5e6",
      "kind": "text_data",
      "source_text": "在理智与本能间挣扎。\\n怀抱渴望的妖艳之人",
      "source_fingerprint": "f00f667453b56f59a5e2c962a42aa6926af7c3c3286a0a4f048fad6d656c40c0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1097"
      ]
    },
    {
      "uid": "zhcn:bedd49eb6fcb2701d098e459",
      "kind": "text_data",
      "source_text": "Rickey☆Lucky☆\\n好管闲事系・风水少女☆",
      "source_fingerprint": "bae3a3a2e90464612c80ef50d11ef00ccda14bc2ce3d49203b545c5e25ddb020",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1098"
      ]
    },
    {
      "uid": "zhcn:b27cb874c1b9e59dae9e8d25",
      "kind": "text_data",
      "source_text": "背负着苫小牧奔跑的\\n务实的地方偶像",
      "source_fingerprint": "169751cefe5535caa9205fe348e5df40ea9bf3387ba8485312633903628c1d15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1099"
      ]
    },
    {
      "uid": "zhcn:9806461def522f7cabed4446",
      "kind": "text_data",
      "source_text": "悠然自得、不骄不躁而又充满毅力。\\n永不言弃的有骨气的赛马娘",
      "source_fingerprint": "3ac6e96b1598e861f57db78bdbb94c49694a51bd82cb6852d9e025bfc4046f9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1100"
      ]
    },
    {
      "uid": "zhcn:f50e62a6b230db52d2c16064",
      "kind": "text_data",
      "source_text": "比赛就是一场合奏！\\n热爱音乐的艺术家赛马娘",
      "source_fingerprint": "e1f3ce2b32632d4a372f15a78d0d986394b8026a1d39aaa765a527259a5a8292",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1102"
      ]
    },
    {
      "uid": "zhcn:a834e1e21eae9f9e2d5dca7e",
      "kind": "text_data",
      "source_text": "创造传说！\\n以独特的视角追寻着最强",
      "source_fingerprint": "074c0fc1531ac9bcb2e0d2308d488983b382969bb985b2029af581e9bc098bdd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1103"
      ]
    },
    {
      "uid": "zhcn:02eb5801c907e499675bda00",
      "kind": "text_data",
      "source_text": "目标是赛马娘界的王牌！\\n向着远大目标勇往直前的活泼少女",
      "source_fingerprint": "543e6f2c0f2f5c801dd7e6c253e94d4837362d2c15583b569b693785428631ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1104"
      ]
    },
    {
      "uid": "zhcn:c16244597700d798237359ef",
      "kind": "text_data",
      "source_text": "有点儿不可思议？相当之不可思议？\\n宇宙般神秘的赛马娘",
      "source_fingerprint": "f5761e7e6c26c834b6d338d5c3f47acf8e8da1a0737f5b63e29ca50b58764583",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1105"
      ]
    },
    {
      "uid": "zhcn:c9626190090e8e91792a4591",
      "kind": "text_data",
      "source_text": "悠闲的赛马娘。\\n今天也很普通～地正常发挥着",
      "source_fingerprint": "bc12522727ab7330ec72e038010afcf27391ac4ea7d63ae8ad1a29dbd1ad6de8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1106"
      ]
    },
    {
      "uid": "zhcn:c11c8d528bc4caf737e4c6fe",
      "kind": "text_data",
      "source_text": "朋友、梦想和钱全都要得到！\\n生于浪漫之中的赛马娘",
      "source_fingerprint": "9254222a3c862176e11621360d35a41916126c7fffaa738f4a716fa573996502",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1107"
      ]
    },
    {
      "uid": "zhcn:6ae29bf3de1a5025e309872f",
      "kind": "text_data",
      "source_text": "流淌于身的是最强之血。\\n名门家族的结晶",
      "source_fingerprint": "9a122f23208e4695eed9454af512769fdcbbd86cf6303c944fd1d7f141bd32ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1108"
      ]
    },
    {
      "uid": "zhcn:e2fe57c3efdad6ebbf37980d",
      "kind": "text_data",
      "source_text": "向着光辉的未来！\\n以三后冠为梦想的阳光女孩",
      "source_fingerprint": "b313633c338fe14883199620b73433b578cec5e6efb0bbf7ae0ee99f336775ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1109"
      ]
    },
    {
      "uid": "zhcn:e30bb7e72d08a1a0d2b8dfe4",
      "kind": "text_data",
      "source_text": "是冷酷的武士又是圣母——\\n拥有两幅面孔的赛马娘",
      "source_fingerprint": "13314c4f57c67296abb801727c6f1b4bc4556ac74844180c09fa5efd86c18562",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1110"
      ]
    },
    {
      "uid": "zhcn:f49b764f3655e2717afcbe43",
      "kind": "text_data",
      "source_text": "心怀母亲的期盼，\\n脚踏实地……达成毕生心愿",
      "source_fingerprint": "20c361d8c3cd3e34b2d3f625eeac9866f4047ba8968946080689faff14856fde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1111"
      ]
    },
    {
      "uid": "zhcn:3b15f124eadeb7fbdb8e5124",
      "kind": "text_data",
      "source_text": "打磨至臻的自信熠熠生辉，\\n此乃Queen Heart！",
      "source_fingerprint": "00aa20b4457946cce8b4e5e5ec2f5d582886ab4db476f66fe5609d3f764a1e2d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1112"
      ]
    },
    {
      "uid": "zhcn:4df87cff91651b996329a163",
      "kind": "text_data",
      "source_text": "冲出去吧！\\n无限的希望与棉花糖般的心♡",
      "source_fingerprint": "d40290e830a9d5e9a7700a3f4575115cae641187663d9f0ab2921b9e8a076fe6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1113"
      ]
    },
    {
      "uid": "zhcn:bfb6d8231073a37d258113fd",
      "kind": "text_data",
      "source_text": "终有一天将抵达“绝景”。\\n真诚、受人喜爱的赛马娘",
      "source_fingerprint": "f8d4b15249a56fc34ad88d954b6725c11591500331045eb4f27ba7c79521e197",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1114"
      ]
    },
    {
      "uid": "zhcn:701e7856fbad101ea83e59fc",
      "kind": "text_data",
      "source_text": "天上天下唯我独尊，\\n自称为草地之王的暴君",
      "source_fingerprint": "e696ab8011c5e65bfc5bb22979d672db899b8330283dfd14b3db76d15e17aa65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1115"
      ]
    },
    {
      "uid": "zhcn:0d330557228406a755b8360e",
      "kind": "text_data",
      "source_text": "刚毅的高贵妇人。\\n只会强势地绽放！",
      "source_fingerprint": "89dc92c623933a71b9e68267b2e4275ae78727710cf57493a553ee5ce37786ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1116"
      ]
    },
    {
      "uid": "zhcn:e63f2ae4182946f5a9a6b9c6",
      "kind": "text_data",
      "source_text": "百折不挠。\\n无论输多少次，这颗心都不会破碎！",
      "source_fingerprint": "94f80e5ab7df760f43be1dd7e69e9de800a4734d7e4366172fa386284ccef80c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1117"
      ]
    },
    {
      "uid": "zhcn:d664b25b84cdb53f870c0fc5",
      "kind": "text_data",
      "source_text": "高贵凛然\\n——孤傲绽放的苍银之花",
      "source_fingerprint": "c7528540f815de2596fd7657c8d147772a9119374a1b7ea13dbd8a947e8c9294",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1118"
      ]
    },
    {
      "uid": "zhcn:9e000c2ff3f2d65d7e1d35ab",
      "kind": "text_data",
      "source_text": "带着微笑向着梦想前行\\n但不要试图窥视她的眼瞳深处",
      "source_fingerprint": "e27a9d18a931bdf1ab6f73d551beb8dce6d2a0fc784116a2439e12caa18d0f10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1119"
      ]
    },
    {
      "uid": "zhcn:a219c7521ae6fcd50d9a74f7",
      "kind": "text_data",
      "source_text": "向光明的彼方前进！\\n冲向最速的直线组长",
      "source_fingerprint": "ec2250e27beed5ea0fc051816bda46e9fee908ecc9eec8738725b20a763f96a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1120"
      ]
    },
    {
      "uid": "zhcn:ea2309d80335b5e93de08523",
      "kind": "text_data",
      "source_text": "睁大双眼吧。\\n闪耀的双脚，忠义的圣剑",
      "source_fingerprint": "e8ce7d86456a21ce56d6a4b40f275338de9497091eb12e24fc15c381fd5321b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1121"
      ]
    },
    {
      "uid": "zhcn:531721a45e1ba91e7a3231b2",
      "kind": "text_data",
      "source_text": "拥有大梦想的，\\n斗志迸发的冲锋队长！",
      "source_fingerprint": "7d11a4eb26992bc19b73be5eb39529038fb189ad3c4c5b2717947b8f011d5556",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1124"
      ]
    },
    {
      "uid": "zhcn:2691fdca7be0a4a48596a5f7",
      "kind": "text_data",
      "source_text": "以食为药——\\n泰然自若的仙者马娘",
      "source_fingerprint": "f4e5c0c9315851440cf8cdc4e41e8ad2e8a111dd362678348c6d17ca06330143",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1126"
      ]
    },
    {
      "uid": "zhcn:bba6230d60a874c42602270f",
      "kind": "text_data",
      "source_text": "铁面无私的正义——\\n奔跑的冷面巡警",
      "source_fingerprint": "a895f854d5bc657f0b26c28d65cb1747879465de9bb1824143a7fc76300ed0be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1127"
      ]
    },
    {
      "uid": "zhcn:b542f6f622f9d54c8bfb3c06",
      "kind": "text_data",
      "source_text": "以坚固牵绊与人类相连的友好马娘",
      "source_fingerprint": "c169a28182b3d3fc882686ebcedf1453dfa1b1cc70f4b5a3c26f970383b15be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1128"
      ]
    },
    {
      "uid": "zhcn:ef62548e132bcc521ab802c2",
      "kind": "text_data",
      "source_text": "超×9不服输！\\n最强挑战者",
      "source_fingerprint": "32af7422f93ae47af3f8828b07e168337bff64eaeb01a428db2ca525fab2ef15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1129"
      ]
    },
    {
      "uid": "zhcn:0f2397b3379e7b0311576f8d",
      "kind": "text_data",
      "source_text": "那朵花经历漫长寒冬，\\n定会傲然盛放",
      "source_fingerprint": "69d367288501f5d80bd5d8f5eb106ed8cf8000d43df2ba1d06acdb83abfed908",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1130"
      ]
    },
    {
      "uid": "zhcn:cdca759639f706f5866898a8",
      "kind": "text_data",
      "source_text": "可能性无限英里！\\n最强英里马娘",
      "source_fingerprint": "219e14dd363ec90dbdd1f776ca8330c9222fe263e6687b7a4739d983991ae930",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1131"
      ]
    },
    {
      "uid": "zhcn:b91a57790177d574a3108513",
      "kind": "text_data",
      "source_text": "Love me♡Love you♡\\n满溢着爱的直播主",
      "source_fingerprint": "353979d5c64b461d8a244df0d743f235acebe53c67b51e7b2ca97640ba8be1c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1132"
      ]
    },
    {
      "uid": "zhcn:4c92b21c0f585e9afdd347b3",
      "kind": "text_data",
      "source_text": "稀世的赛跑史爱好者。\\n立志开创新时代！",
      "source_fingerprint": "540d2f9f21231e63f5e5c51fcaaecae4af74a3b2f6559465fb03067daaa5c8c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1133"
      ]
    },
    {
      "uid": "zhcn:f1cb0634ccf9df65a779df64",
      "kind": "text_data",
      "source_text": "将心愿与温柔交织，\\n驰骋的动人花朵",
      "source_fingerprint": "d55242a22816814935cafb08c9f86b865b2ad338af94ffed368fad4cca1719df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1134"
      ]
    },
    {
      "uid": "zhcn:a4b44bab0dd592efeb70aad2",
      "kind": "text_data",
      "source_text": "奔放的流浪者！\\n向着曾见的黄金之旅启程",
      "source_fingerprint": "6b0bf8b67bacc59543957a24706bfa5b10c153fff6a0fd68320b4b7953344057",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1135"
      ]
    },
    {
      "uid": "zhcn:56cba7dc51bfec3093a68727",
      "kind": "text_data",
      "source_text": "不挠的圣女，\\n为了在试炼的尽头成为救世主。",
      "source_fingerprint": "c0f7dfb6ccae529e89c23441df41f24ed456c30704bbd852819bbdc3bd5aef7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1136"
      ]
    }
  ]
}
