{
  "schema_version": 1,
  "batch": 177,
  "batch_count": 1697,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "89bbda6948bf092a08e3287e29276a39db038159",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:6ae29bf3de1a5025e309872f",
      "kind": "text_data",
      "source_text": "流淌于身的是最强之血。\\n名门家族的结晶",
      "source_fingerprint": "9a122f23208e4695eed9454af512769fdcbbd86cf6303c944fd1d7f141bd32ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1108"
      ]
    },
    {
      "uid": "zhcn:e2fe57c3efdad6ebbf37980d",
      "kind": "text_data",
      "source_text": "向着光辉的未来！\\n以三后冠为梦想的阳光女孩",
      "source_fingerprint": "b313633c338fe14883199620b73433b578cec5e6efb0bbf7ae0ee99f336775ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1109"
      ]
    },
    {
      "uid": "zhcn:e30bb7e72d08a1a0d2b8dfe4",
      "kind": "text_data",
      "source_text": "是冷酷的武士又是圣母——\\n拥有两幅面孔的赛马娘",
      "source_fingerprint": "13314c4f57c67296abb801727c6f1b4bc4556ac74844180c09fa5efd86c18562",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1110"
      ]
    },
    {
      "uid": "zhcn:f49b764f3655e2717afcbe43",
      "kind": "text_data",
      "source_text": "心怀母亲的期盼，\\n脚踏实地……达成毕生心愿",
      "source_fingerprint": "20c361d8c3cd3e34b2d3f625eeac9866f4047ba8968946080689faff14856fde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1111"
      ]
    },
    {
      "uid": "zhcn:3b15f124eadeb7fbdb8e5124",
      "kind": "text_data",
      "source_text": "打磨至臻的自信熠熠生辉，\\n此乃Queen Heart！",
      "source_fingerprint": "00aa20b4457946cce8b4e5e5ec2f5d582886ab4db476f66fe5609d3f764a1e2d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1112"
      ]
    },
    {
      "uid": "zhcn:4df87cff91651b996329a163",
      "kind": "text_data",
      "source_text": "冲出去吧！\\n无限的希望与棉花糖般的心♡",
      "source_fingerprint": "d40290e830a9d5e9a7700a3f4575115cae641187663d9f0ab2921b9e8a076fe6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1113"
      ]
    },
    {
      "uid": "zhcn:bfb6d8231073a37d258113fd",
      "kind": "text_data",
      "source_text": "终有一天将抵达“绝景”。\\n真诚、受人喜爱的赛马娘",
      "source_fingerprint": "f8d4b15249a56fc34ad88d954b6725c11591500331045eb4f27ba7c79521e197",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1114"
      ]
    },
    {
      "uid": "zhcn:701e7856fbad101ea83e59fc",
      "kind": "text_data",
      "source_text": "天上天下唯我独尊，\\n自称为草地之王的暴君",
      "source_fingerprint": "e696ab8011c5e65bfc5bb22979d672db899b8330283dfd14b3db76d15e17aa65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1115"
      ]
    },
    {
      "uid": "zhcn:0d330557228406a755b8360e",
      "kind": "text_data",
      "source_text": "刚毅的高贵妇人。\\n只会强势地绽放！",
      "source_fingerprint": "89dc92c623933a71b9e68267b2e4275ae78727710cf57493a553ee5ce37786ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1116"
      ]
    },
    {
      "uid": "zhcn:e63f2ae4182946f5a9a6b9c6",
      "kind": "text_data",
      "source_text": "百折不挠。\\n无论输多少次，这颗心都不会破碎！",
      "source_fingerprint": "94f80e5ab7df760f43be1dd7e69e9de800a4734d7e4366172fa386284ccef80c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1117"
      ]
    },
    {
      "uid": "zhcn:d664b25b84cdb53f870c0fc5",
      "kind": "text_data",
      "source_text": "高贵凛然\\n——孤傲绽放的苍银之花",
      "source_fingerprint": "c7528540f815de2596fd7657c8d147772a9119374a1b7ea13dbd8a947e8c9294",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1118"
      ]
    },
    {
      "uid": "zhcn:9e000c2ff3f2d65d7e1d35ab",
      "kind": "text_data",
      "source_text": "带着微笑向着梦想前行\\n但不要试图窥视她的眼瞳深处",
      "source_fingerprint": "e27a9d18a931bdf1ab6f73d551beb8dce6d2a0fc784116a2439e12caa18d0f10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1119"
      ]
    },
    {
      "uid": "zhcn:a219c7521ae6fcd50d9a74f7",
      "kind": "text_data",
      "source_text": "向光明的彼方前进！\\n冲向最速的直线组长",
      "source_fingerprint": "ec2250e27beed5ea0fc051816bda46e9fee908ecc9eec8738725b20a763f96a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1120"
      ]
    },
    {
      "uid": "zhcn:ea2309d80335b5e93de08523",
      "kind": "text_data",
      "source_text": "睁大双眼吧。\\n闪耀的双脚，忠义的圣剑",
      "source_fingerprint": "e8ce7d86456a21ce56d6a4b40f275338de9497091eb12e24fc15c381fd5321b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1121"
      ]
    },
    {
      "uid": "zhcn:531721a45e1ba91e7a3231b2",
      "kind": "text_data",
      "source_text": "拥有大梦想的，\\n斗志迸发的冲锋队长！",
      "source_fingerprint": "7d11a4eb26992bc19b73be5eb39529038fb189ad3c4c5b2717947b8f011d5556",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1124"
      ]
    },
    {
      "uid": "zhcn:2691fdca7be0a4a48596a5f7",
      "kind": "text_data",
      "source_text": "以食为药——\\n泰然自若的仙者马娘",
      "source_fingerprint": "f4e5c0c9315851440cf8cdc4e41e8ad2e8a111dd362678348c6d17ca06330143",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1126"
      ]
    },
    {
      "uid": "zhcn:bba6230d60a874c42602270f",
      "kind": "text_data",
      "source_text": "铁面无私的正义——\\n奔跑的冷面巡警",
      "source_fingerprint": "a895f854d5bc657f0b26c28d65cb1747879465de9bb1824143a7fc76300ed0be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1127"
      ]
    },
    {
      "uid": "zhcn:b542f6f622f9d54c8bfb3c06",
      "kind": "text_data",
      "source_text": "以坚固牵绊与人类相连的友好马娘",
      "source_fingerprint": "c169a28182b3d3fc882686ebcedf1453dfa1b1cc70f4b5a3c26f970383b15be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1128"
      ]
    },
    {
      "uid": "zhcn:ef62548e132bcc521ab802c2",
      "kind": "text_data",
      "source_text": "超×9不服输！\\n最强挑战者",
      "source_fingerprint": "32af7422f93ae47af3f8828b07e168337bff64eaeb01a428db2ca525fab2ef15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1129"
      ]
    },
    {
      "uid": "zhcn:0f2397b3379e7b0311576f8d",
      "kind": "text_data",
      "source_text": "那朵花经历漫长寒冬，\\n定会傲然盛放",
      "source_fingerprint": "69d367288501f5d80bd5d8f5eb106ed8cf8000d43df2ba1d06acdb83abfed908",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1130"
      ]
    },
    {
      "uid": "zhcn:cdca759639f706f5866898a8",
      "kind": "text_data",
      "source_text": "可能性无限英里！\\n最强英里马娘",
      "source_fingerprint": "219e14dd363ec90dbdd1f776ca8330c9222fe263e6687b7a4739d983991ae930",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1131"
      ]
    },
    {
      "uid": "zhcn:b91a57790177d574a3108513",
      "kind": "text_data",
      "source_text": "Love me♡Love you♡\\n满溢着爱的直播主",
      "source_fingerprint": "353979d5c64b461d8a244df0d743f235acebe53c67b51e7b2ca97640ba8be1c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1132"
      ]
    },
    {
      "uid": "zhcn:4c92b21c0f585e9afdd347b3",
      "kind": "text_data",
      "source_text": "稀世的赛跑史爱好者。\\n立志开创新时代！",
      "source_fingerprint": "540d2f9f21231e63f5e5c51fcaaecae4af74a3b2f6559465fb03067daaa5c8c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1133"
      ]
    },
    {
      "uid": "zhcn:f1cb0634ccf9df65a779df64",
      "kind": "text_data",
      "source_text": "将心愿与温柔交织，\\n驰骋的动人花朵",
      "source_fingerprint": "d55242a22816814935cafb08c9f86b865b2ad338af94ffed368fad4cca1719df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1134"
      ]
    },
    {
      "uid": "zhcn:a4b44bab0dd592efeb70aad2",
      "kind": "text_data",
      "source_text": "奔放的流浪者！\\n向着曾见的黄金之旅启程",
      "source_fingerprint": "6b0bf8b67bacc59543957a24706bfa5b10c153fff6a0fd68320b4b7953344057",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1135"
      ]
    },
    {
      "uid": "zhcn:56cba7dc51bfec3093a68727",
      "kind": "text_data",
      "source_text": "不挠的圣女，\\n为了在试炼的尽头成为救世主。",
      "source_fingerprint": "c0f7dfb6ccae529e89c23441df41f24ed456c30704bbd852819bbdc3bd5aef7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1136"
      ]
    },
    {
      "uid": "zhcn:7af4e139847258877192eb59",
      "kind": "text_data",
      "source_text": "描绘奇迹的，\\n激情系创作者",
      "source_fingerprint": "3720c163ddc3e532da3ba5c74cad9e3b952ebd2fa76fac9cb927bd75c639a635",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1137"
      ]
    },
    {
      "uid": "zhcn:30fe92dc5a642ab89e22bffd",
      "kind": "text_data",
      "source_text": "掀起革新\\n超凡的辣妹赛马娘",
      "source_fingerprint": "970d5f57618106b55ce8cc0a37ead25b17b47886ee3d182e50947b2e25980b76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1138"
      ]
    },
    {
      "uid": "zhcn:01e3d680f74593e5d2d31ab7",
      "kind": "text_data",
      "source_text": "挑战世界的最高峰，\\n计划领导者",
      "source_fingerprint": "d7c36f543e4730e3a7670afd7f9551c0fec7462e479d175ab5179e22d1023d7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1139"
      ]
    },
    {
      "uid": "zhcn:a536fc058d98424b58e8c477",
      "kind": "text_data",
      "source_text": "倾听这声音吧！\\n受命运眷顾的超暴走赛马娘",
      "source_fingerprint": "719500def7dfa091274d1949f14be7750a12723cd447fcd4012f32b907c162c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1141"
      ]
    },
    {
      "uid": "zhcn:ebd12e87b430262482cbdcb6",
      "kind": "text_data",
      "source_text": "连结温暖之轮，\\n希望的使者",
      "source_fingerprint": "e58496d7becfc298fe42fdf4d99290301a39a1d5ff936dc31d617436c74a2bd2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1143"
      ]
    },
    {
      "uid": "zhcn:8ef4247b22e729bd9c9d8ac1",
      "kind": "text_data",
      "source_text": "背负一族夙愿的、\\n蔷薇王子",
      "source_fingerprint": "ad4ab76c7028ff9183f02558fef1ddcaa449787afabc0f9ad9c9cfc1f0e4d428",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1144"
      ]
    },
    {
      "uid": "zhcn:eb3cba496d79b8ee0335b080",
      "kind": "text_data",
      "source_text": "聪慧的棋盘支配者，\\n但是个玻璃心",
      "source_fingerprint": "94cdbdf48e3b25d47f318a2c6413239043b8bb4d988e33c5f49b4cf29e022bbd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1145"
      ]
    },
    {
      "uid": "zhcn:d0f006dd1d7ff0ede66bcfdf",
      "kind": "text_data",
      "source_text": "斩断枷锁，炽烈绽放的，\\n便是战场之花",
      "source_fingerprint": "3e92e2dba790bc2d00bdb6557d4a6be765c9ae72ed2bdf78ea6493e9219c8b13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1149"
      ]
    },
    {
      "uid": "zhcn:9f58ed71e26114290a248586",
      "kind": "text_data",
      "source_text": "大方稳重的赛马娘。\\n幸福乃大器晚成！",
      "source_fingerprint": "9e1c188f01da1b46a4d206c022e028a58fb242a73683b660e5422353df31ac63",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "2001"
      ]
    },
    {
      "uid": "zhcn:bdacf459a53758b5dbd973ee",
      "kind": "text_data",
      "source_text": "笑容迷人的特雷森学园\\n理事长秘书",
      "source_fingerprint": "57d4347d3ca391acc8efa7f05c14571120ec11f021cc5078297c796075f615de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9001"
      ]
    },
    {
      "uid": "zhcn:d1eed1bc4611924f2db3db4b",
      "kind": "text_data",
      "source_text": "欢迎！\\n对学生们满怀爱意的特雷森学园理事长",
      "source_fingerprint": "2eede6772fac742da1571631626a9f4c2c2ec8cebcd5fb642104fa1ed9de4f54",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9002"
      ]
    },
    {
      "uid": "zhcn:406e458e2654b79ba5999065",
      "kind": "text_data",
      "source_text": "专心致志任我行！\\n充满热情的训练员",
      "source_fingerprint": "5e34ccc28615aeb718f3e4f11025a102e7801aac37eb990e114066bfa0be21cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9004"
      ]
    },
    {
      "uid": "zhcn:d613c4ffe432a8ab26bb447c",
      "kind": "text_data",
      "source_text": "全世界投来热烈的『刺』线？\\n超天才？？笹针师",
      "source_fingerprint": "34b66c088109c549b097684e08897f4741c61bb1be90d4ca8117b3d5a3bb1870",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9005"
      ]
    },
    {
      "uid": "zhcn:d9b6fd52507b91651928a39a",
      "kind": "text_data",
      "source_text": "URA下派，\\n严厉而又温柔的工作者",
      "source_fingerprint": "66d3fd849e4dec676eb826f2ba847df54f2e249431492e946196909569a7cd04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9006"
      ]
    },
    {
      "uid": "zhcn:961e1112bf645a5d2ad9ee30",
      "kind": "text_data",
      "source_text": "为了大家闪耀的舞台！\\n与大家心相连的活动制作人",
      "source_fingerprint": "aa25b34643af64b8e9386e558d645404ac90618ca8054ffd15e005d357be37e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9008"
      ]
    },
    {
      "uid": "zhcn:156ec8d0883f3cec8f77c945",
      "kind": "text_data",
      "source_text": "开朗而贤明，\\n注重个性的引导者",
      "source_fingerprint": "221157c0d79156b62fb33460d0d7c3b07de548d01823b3674180452b15fac8cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9040"
      ]
    },
    {
      "uid": "zhcn:eb566446c46dc9f4654e41f0",
      "kind": "text_data",
      "source_text": "满溢包容万物的温柔，\\n一位优雅的老师",
      "source_fingerprint": "b0f1101fbc9eb22a495902c89607a45e10e3d8dc503575b677b244735d8ebef4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9041"
      ]
    },
    {
      "uid": "zhcn:79f0e50db71084149374e6ba",
      "kind": "text_data",
      "source_text": "军人气质般的严厉背后，\\n藏着对赛马娘深深的爱",
      "source_fingerprint": "a060afb8b623a0eb0202c23a938afe21cefc4a2ef43df6aaba6da95036ba93eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9042"
      ]
    },
    {
      "uid": "zhcn:659e1967f9d9d72d5b751e0e",
      "kind": "text_data",
      "source_text": "不断向世界发起挑战\\n追求梦想的领导者",
      "source_fingerprint": "3c67b335cfc6aa68939c3beb012044998e24b8ac62bb74533e1d217a0cd95566",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9043"
      ]
    },
    {
      "uid": "zhcn:bb84f29bde6869e35f1e89ab",
      "kind": "text_data",
      "source_text": "致力于打造最好的娱乐项目\\n有才干的制作人",
      "source_fingerprint": "83076b8e635258e97acb009bae959adc658a66c5d0f67446fb39526a85d3268d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "9044"
      ]
    },
    {
      "uid": "zhcn:fec9006c762177fc2cc556c6",
      "kind": "text_data",
