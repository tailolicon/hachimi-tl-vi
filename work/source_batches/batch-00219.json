      ]
    },
    {
      "uid": "zhcn:c5589bff4a8a4ca3bedf095e",
      "kind": "text_data",
      "source_text": "高等部",
      "source_fingerprint": "00f0d5453b55fa6296c158e6943fe2adc3c90372c5f1f5b5b22e797865e75be4",
