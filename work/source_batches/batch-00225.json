{
  "schema_version": 1,
  "batch": 225,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:a320c8ec87f8a19ecbd61492",
      "kind": "text_data",
      "source_text": "听到比赛前的号角声就会热血沸腾",
      "source_fingerprint": "8ee5bfa69d2edbdea1ef1b4ef02d39f98c1f960f232df04d129e95342005c4bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1016"
      ]
    },
    {
      "uid": "zhcn:74d348844ea81fd0e7903f98",
      "kind": "text_data",
      "source_text": "在想到冷笑话时，会“噗嗤”的大幅移动",
      "source_fingerprint": "114bd11d2765a2aa09a9c9715eba8eca48da1b2f5dc35335bb7729d37b3b5783",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1017"
      ]
    },
    {
      "uid": "zhcn:1a7f9c5535c9b423689bffc6",
      "kind": "text_data",
      "source_text": "照料花朵时会温柔地微微下垂",
      "source_fingerprint": "4b19533f0838598845a896c59546ae839a1403808bbd37be4784962500057022",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1018"
      ]
    },
    {
      "uid": "zhcn:d44a788c50a8cb676cfb3378",
      "kind": "text_data",
      "source_text": "耳朵捕捉到萌波动时就会毛发皆竖",
      "source_fingerprint": "3e303159a2ba5b0dfb972e5b256dcf4496126e698d06db019e5df472da91ea5d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1019"
      ]
    },
    {
      "uid": "zhcn:6e7a8d8156d5db2417b9c2bc",
      "kind": "text_data",
      "source_text": "有时，耳朵会意味深长地竖立起来",
      "source_fingerprint": "7dc0926fcc65e0098812a8ef1e483ece1dfbef80769b29dcf5a3ba1e46884b53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1020"
      ]
    },
    {
      "uid": "zhcn:ec00b0882ed5c1d2379cac9e",
      "kind": "text_data",
      "source_text": "一听到“大减价”、“大甩卖”之类的词就会突然立起",
      "source_fingerprint": "484269d07efdd882b3544a8ff5990acd62666c5af1b4133c33eaa46e3f5a44ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1021"
      ]
    },
    {
      "uid": "zhcn:b7a81693d4300b89b7211ed4",
      "kind": "text_data",
      "source_text": "对庶民文化的话题十分感兴趣",
      "source_fingerprint": "06def5070a429bfa9477107ab1863957b5d43f3610d0c761e133e247274c528f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1022"
      ]
    },
    {
      "uid": "zhcn:efa5fa1924e4b332899fc17c",
      "kind": "text_data",
      "source_text": "小时候就对声音十分敏感，经常被吓到",
      "source_fingerprint": "453e90fcb6db6dc2e3c78c59852a047b97c8b20f734bc93afb9de3aa12a35ad9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1023"
      ]
    },
    {
      "uid": "zhcn:6a372ba9dba7c4a21ce579f5",
      "kind": "text_data",
      "source_text": "非常擅长塞住耳朵",
      "source_fingerprint": "d835b9c6c31b74f99d8bb3c4fd6379cb434efb964ac3b648ce4200ad5ebac6fb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1024"
      ]
    },
    {
      "uid": "zhcn:5eee54bf2ff4ffad71b85ff5",
      "kind": "text_data",
      "source_text": "好像能听到只有自己才听得到的声音",
      "source_fingerprint": "b5b339dd83bd40ce9c0a848a50f16780ae7af197c7b9585e9c9106e03a1a692a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1025"
      ]
    },
    {
      "uid": "zhcn:e63fcadcd733fe1572f48632",
      "kind": "text_data",
      "source_text": "即使睡着了，一听到命令就会立刻起来",
      "source_fingerprint": "dec9704fbf6c4c0160665def4aa77e6b7831aad98faab99fbbacd11e858b9093",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1026"
      ]
    },
    {
      "uid": "zhcn:e2615c1e1df700c7526acc22",
      "kind": "text_data",
      "source_text": "阅读少女漫画时会动个不停",
      "source_fingerprint": "d72db7098bea38691550f9a3660b7ea27d618c1472111d0eaca527030abefb32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1027"
      ]
    },
    {
      "uid": "zhcn:b6378e0871900de00f21a271",
      "kind": "text_data",
      "source_text": "无论多么微弱的肚子饿的咕噜声都不会听漏",
      "source_fingerprint": "45d983592405daf84ddfb3cfcf5402c227df44d747b49ff23eecafc2eb12a3cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1028"
      ]
    },
    {
      "uid": "zhcn:cf1c9c2173eeb6ca1b5d0275",
      "kind": "text_data",
      "source_text": "有很多可爱的耳罩",
      "source_fingerprint": "39187f2943dc2d32105bc1e44a46650794f5d16246d381699e0d9e2db09c7cd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1029"
      ]
    },
    {
      "uid": "zhcn:24db5d531e18a9680ca860e8",
      "kind": "text_data",
      "source_text": "听到关于他人的不幸的话题耳朵就会无力的垂下",
      "source_fingerprint": "2b83003e43fed45bd7ec595bbfc0bfee64d9d0984c11baa50e3f1da1c41f7454",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1030"
      ]
    },
    {
      "uid": "zhcn:3d28e58921a0eed02cd1b4f4",
      "kind": "text_data",
      "source_text": "会不由自主地对小孩子的声音起反应",
      "source_fingerprint": "86c42739f036c1f1ab2e678e47f0befc135e4bf37b765a571a045c7c6b84c90c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1031"
      ]
    },
    {
      "uid": "zhcn:3e6a04f5746ccd44d66d878d",
      "kind": "text_data",
      "source_text": "坚决不让碰耳朵和额头",
      "source_fingerprint": "6ae555a9bc7a6571ce8ab550d6c659320ff24d839f178e5b83c3f66d846e1ac2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1032"
      ]
    },
    {
      "uid": "zhcn:705c08efb37d9cf91f45d340",
      "kind": "text_data",
      "source_text": "听到“姐姐”的叫声的话会无意识地抖动",
      "source_fingerprint": "d52b155150da18e7603adb101f1b89fe1715a733ec022732b10e85ae2f0e9040",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1033"
      ]
    },
    {
      "uid": "zhcn:7ca64030699165e25e01a498",
      "kind": "text_data",
      "source_text": "一听到庆典伴奏的声音，就会如起舞一般动起来",
      "source_fingerprint": "984f24f345cd53245dc4db5589669e73c6d4828bdba7fb69c77eafa8d21bb9b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1034"
      ]
    },
    {
      "uid": "zhcn:239a2fc46c4111f9d5d8ea2c",
      "kind": "text_data",
      "source_text": "挚友表示“就连耳朵也动的好烦人”",
      "source_fingerprint": "1cb670df5bed3b8f6a0335aec6c294cfd70821229597e2e1dfc9b50f96615d67",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1035"
      ]
    },
    {
      "uid": "zhcn:8d075c0d16b9bd487004204a",
      "kind": "text_data",
      "source_text": "进行逻辑思考时会直直地站着",
      "source_fingerprint": "caeb23c9ee6f3050ddfe3ea11d3803944e19db65422e8708b753820a10d191d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1036"
      ]
    },
    {
      "uid": "zhcn:a86565aef806cf68bc9f7cae",
      "kind": "text_data",
      "source_text": "听到节拍器的声音的话会被治愈",
      "source_fingerprint": "d5d0b5ef7870f613f808ea51932e697bc5f1b552eedb4fb2dfeba67b64b3ef39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1037"
      ]
    },
    {
      "uid": "zhcn:f0b251296b559f0de9c8e7bf",
      "kind": "text_data",
      "source_text": "想撒娇时，耳朵会像招手般摇动",
      "source_fingerprint": "7112361bead12af397eec77b019bb2d899c6d94614c5b39202317a2ee81b4f22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1038"
      ]
    },
    {
      "uid": "zhcn:efb71d1d73f5704bec15faec",
      "kind": "text_data",
      "source_text": "自认为拥有在赛马娘中最适合皇冠的耳朵",
      "source_fingerprint": "ead5a51e33acb7818cf569de7ddc92480e1aa5ce2014acacef258331138ef77a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1039"
      ]
    },
    {
      "uid": "zhcn:a5b0d31908648b1a677ad207",
      "kind": "text_data",
      "source_text": "想要赢过闹钟继续睡",
      "source_fingerprint": "ba98779f47b2b22b33257bdcba9c1a481fd3375d3fbff48c5eb7fa259ae63c3c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1040"
      ]
    },
    {
      "uid": "zhcn:d84993714d72102de71989f5",
      "kind": "text_data",
      "source_text": "他人的话只能听进去一半",
      "source_fingerprint": "84f185e5a3375d3693fc2b2e632a77abc280b63128817f184fa81bdb28fbf4b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1041"
      ]
    },
    {
      "uid": "zhcn:03e9955cad53a75d30b43375",
      "kind": "text_data",
      "source_text": "能用感觉来理解各种语言的意思",
      "source_fingerprint": "c7e483143f2ecc7c4913f2d90be94163b4029413b7574a48e08776279dfdcabd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1042"
      ]
    },
    {
      "uid": "zhcn:fa4aa1882489a934cea71f1a",
      "kind": "text_data",
      "source_text": "想出新的恶作剧方式时会浑身发抖",
      "source_fingerprint": "308a57e89c018c382e44ed0cbad454b146a1de6524793de84438ed002efc11c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1043"
      ]
    },
    {
      "uid": "zhcn:eeb62fe10597ffc91b5bf576",
      "kind": "text_data",
      "source_text": "不认识的单词听起来全都像咒语",
      "source_fingerprint": "de2d2b99956191fc3de9cea05ab63a2845bae8bb74ad9c119e9e766ba64e099d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1044"
      ]
    },
    {
      "uid": "zhcn:a1702dcd4399d25e8cf1e867",
      "kind": "text_data",
      "source_text": "擅长掏耳朵，但不擅长被掏耳朵",
      "source_fingerprint": "3a9dc5389ff994cf9f6458fa949854f8e4b60174b4594a269855bbe50bb05790",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1045"
      ]
    },
    {
      "uid": "zhcn:cf7804ad667b81ba623c39b5",
      "kind": "text_data",
      "source_text": "不会漏听任何一位粉丝的声音",
      "source_fingerprint": "0986a7ed33dd3c34f548b7b6a27b03a60d593dcd4f79f2cd45622e833febc2fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1046"
      ]
    },
    {
      "uid": "zhcn:5960f3957e3ca9612df8c918",
      "kind": "text_data",
      "source_text": "一到故事的高潮部分就立马朝后翻",
      "source_fingerprint": "8c31805723ef02870b7fcd7d6af0dde2ff13a0b622472738d1df36b7a7e2f9f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1047"
      ]
    },
    {
      "uid": "zhcn:e217558c1df9a76ca3477269",
      "kind": "text_data",
      "source_text": "希望能流行叠起双耳的拍照方式",
      "source_fingerprint": "cbf2f1495c24c1e4b2880d56c5bb3daaa038aa080f5da3f00c789be1e89ebc8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1048"
      ]
    },
    {
      "uid": "zhcn:1bf864121fc21bc79531a6c3",
      "kind": "text_data",
      "source_text": "帽子上伸出耳朵的洞是自己剪开缝制的",
      "source_fingerprint": "952eebd08007388c41140a9314f8cfc8d39ec9e1b5b4808f6f40a78bad10e690",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1049"
      ]
    },
    {
      "uid": "zhcn:1df0b35ef8df2eda3f059ad9",
      "kind": "text_data",
      "source_text": "就算听到感兴趣的话题也只有耳朵会转向这边",
      "source_fingerprint": "a576971d0099eecf9dee4ffe959757f93b9e982714fe20464f6f66b0a00bff99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1050"
      ]
    },
    {
      "uid": "zhcn:9a65d5f816f6496b020bb114",
      "kind": "text_data",
      "source_text": "触摸的话就会被安心感所包裹，因为十分治愈而饱受好评",
      "source_fingerprint": "7f0887d7f3c06d435a015a7bbd33480ba396533740287291857799689342bd6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1051"
      ]
    },
    {
      "uid": "zhcn:572b47723c594306101f4e25",
      "kind": "text_data",
      "source_text": "很难懂的话就会右耳进左耳出",
      "source_fingerprint": "9db5ca00fd1d9741504daddb30e8fc645d07df4ef1634f9ac76252e783c76095",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1052"
      ]
    },
    {
      "uid": "zhcn:d9f07063e71bd6d923ee7c83",
      "kind": "text_data",
      "source_text": "一摘下头带就会垂下来",
      "source_fingerprint": "24bb84a340d8e6a4d39333e01a39cc87df748234990650d1a30c1bc7af11ba79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1053"
      ]
    },
    {
      "uid": "zhcn:dad19d0657e571c0ffcd9a1a",
      "kind": "text_data",
      "source_text": "随时响应求助声",
      "source_fingerprint": "a9ea50b23b991fa7534fe3ac1724cc510d72bebd523cdbeef7a0bd902bf4cfcc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1054"
      ]
    },
    {
      "uid": "zhcn:8cc29e95277b31eae60b1e62",
      "kind": "text_data",
      "source_text": "能分辨出Marvelous的声音",
      "source_fingerprint": "22b5360d4c76142a168a35d75ea95c68482f3aed8dec3fe9cb0a52cf7f05c73a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1055"
      ]
    },
    {
      "uid": "zhcn:168cda1d73f2a2b99d7c1df5",
      "kind": "text_data",
      "source_text": "偶尔用于占卜方位",
      "source_fingerprint": "9271b35252c06920edc09e7b602528bad8762641f293b8ef4340752411883a56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1056"
      ]
    },
    {
      "uid": "zhcn:55402f7dab4ca70e4238a3e6",
      "kind": "text_data",
      "source_text": "能够用脚摸到耳朵",
      "source_fingerprint": "0f53493f0c088121951815e0445c6b341558d8d8be033a9190c182ee6abd65d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1057"
      ]
    },
    {
      "uid": "zhcn:a0228fbfb083e403cee9dc06",
      "kind": "text_data",
      "source_text": "经常微微颤抖",
      "source_fingerprint": "6eaba460885b9be5ff7ac4375245a2ae1dccbd8a4c3d283f6c89372fad42f83a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1058"
      ]
    },
    {
      "uid": "zhcn:522131dca7b8ec38d2fb6acb",
      "kind": "text_data",
      "source_text": "一听到男性的声音就会愣住",
      "source_fingerprint": "6538d54894ac6d65caf0e1241ea1bb4bd0ee19276573e3b33ca5422f3ca269b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1059"
      ]
    },
    {
      "uid": "zhcn:d3bfe745b633845a94c4b9d9",
      "kind": "text_data",
      "source_text": "一听到“内酱”的称呼身体就会不自觉地起反应",
      "source_fingerprint": "350ac476f06b456990cae79e7f68cca0dc712ac53ce1d601c91563842f8f83dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1060"
      ]
    },
    {
      "uid": "zhcn:f958c249bcf12a2f69cbf17e",
      "kind": "text_data",
      "source_text": "除了一流的话题以外什么也不想听",
      "source_fingerprint": "8765e2d7bd9e13abd08ed087f703d451c26cd39834f88a6bf60a4ec95b9f43c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1061"
      ]
    },
    {
      "uid": "zhcn:e1ad1a4ff33df92570a69e4a",
      "kind": "text_data",
      "source_text": "即使周围很吵也可以不受影响",
      "source_fingerprint": "c7a19fbcfff560a750aa7d9a050b310911a5d8be3921b56417a13201694b5396",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1062"
      ]
    },
    {
      "uid": "zhcn:51ee4d90d393b2a3d866df44",
      "kind": "text_data",
      "source_text": "左右的毛发必须要均匀整齐",
      "source_fingerprint": "1e2a9181e90cff12f3674d3a08969bed702a35078b7a403289f63e0069926f00",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1063"
      ]
    },
    {
      "uid": "zhcn:23d4a76164ac2fde60a621be",
      "kind": "text_data",
      "source_text": "能够感受到风向和风的强度",
      "source_fingerprint": "f31d7b2a66002a90b7022b98a33d1e72d04608ac87742efcc23feef19b7b1823",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1064"
      ]
    },
    {
      "uid": "zhcn:386b58a222b8b0edc8c3be02",
      "kind": "text_data",
      "source_text": "晴天时动得可厉害了，笑死",
      "source_fingerprint": "52ef773b6b5e38f8e2d32e98b41c1797c64cd112f0f5eb692afbb5924289eb2a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1065"
      ]
    },
    {
      "uid": "zhcn:286dca5d131c0c8e67dbaa8b",
      "kind": "text_data",
      "source_text": "越是到困境越会兴奋地颤动",
      "source_fingerprint": "a1c43db1152bef76872798f9e80439309e559ee8c0bb45e4fa16bb46f536efd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1066"
      ]
    },
    {
      "uid": "zhcn:5e000706703e1d1faa22aafb",
      "kind": "text_data",
      "source_text": "耳朵上的毛发总是包裹着有透明感的光泽",
      "source_fingerprint": "4cbb1a3c926b0cbbf69fc3bad401cde4f2bd9a7c193cf339c36e48a9f7acb659",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1067"
      ]
    },
    {
      "uid": "zhcn:ab6e22c7fd9cd1024216a4e7",
      "kind": "text_data",
      "source_text": "耳朵的音感很好",
      "source_fingerprint": "63fb1091e6105744915a1e0f7e5f518f5e8ea6802f71d195762373074f3ab971",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1068"
      ]
    },
    {
      "uid": "zhcn:772789ad3ebaacf0d79c6e5c",
      "kind": "text_data",
      "source_text": "想到好的格言的话耳朵就会猛而立起",
      "source_fingerprint": "ce291c25dc05ff0113a1845a32faa06218a2e3b5d55b9d299c85939769a6417e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1069"
      ]
    },
    {
      "uid": "zhcn:8944ad31003fea11351d85c1",
      "kind": "text_data",
      "source_text": "不戴耳塞就睡不着觉",
      "source_fingerprint": "779ca9f067149e09afddfd8a7e305bfe28aed3398ff5803887ffcbf18fc582fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1070"
      ]
    },
    {
      "uid": "zhcn:4899005fa7281fbdea91c6a3",
      "kind": "text_data",
      "source_text": "倘若听到玻璃碎裂的声音就会堵住耳朵",
      "source_fingerprint": "013e42873b68bdafcb6fede139894c91d2c4e172f2b765e564c728bb5afe49e1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1071"
      ]
    },
    {
      "uid": "zhcn:5b9a7f49b89bec0f9ace5f1a",
      "kind": "text_data",
      "source_text": "听到可爱的声音的话耳朵就会微微泛红",
      "source_fingerprint": "0a8ae6227c5ca78ece2b273f31755c7583e28f526c345b3e619add0b126b5ed3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1072"
      ]
    },
    {
      "uid": "zhcn:7ecaeca4457a4f956c38273a",
      "kind": "text_data",
      "source_text": "一但被人依赖就会高兴地晃动",
      "source_fingerprint": "7be5a13662e07444b219e3196a4da49b6e835b75d80c14b79ec23fd28bb4c1bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1073"
      ]
    },
    {
      "uid": "zhcn:c9fdf4273554e739dce0f9aa",
      "kind": "text_data",
      "source_text": "一被掏耳朵的话，就会很快地睡着",
      "source_fingerprint": "fa1b1c338a4246ab1cde4a7056011344e7b9213216f44d02741389ae242a94c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1074"
      ]
    },
    {
      "uid": "zhcn:2064fe31c34ff2c0a70e9ec3",
      "kind": "text_data",
      "source_text": "听到喇叭声就会一下子挺直腰杆",
      "source_fingerprint": "daf56323ef70c1b428c0a4f766dc5de9ff22ac6c0d9c13ed7e46d1bd722c15cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1076"
      ]
    },
    {
      "uid": "zhcn:2c85af0fef33ac12e1ba7075",
      "kind": "text_data",
      "source_text": "曾经当过耳部模特",
      "source_fingerprint": "11c862ec0f4b01cab87636eac16376e770d550cd691716e7e478ad670a2a098d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1077"
      ]
    },
    {
      "uid": "zhcn:8d003f0d729fe767eb593664",
      "kind": "text_data",
      "source_text": "蝴蝶和小鸟们的休息所",
      "source_fingerprint": "7adb9c38596a7185da99b815e53f63e92feeb0ce8345d949707d2cc54aaeacaf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1078"
      ]
    },
    {
      "uid": "zhcn:bc7880c74f7ce09e282d249f",
      "kind": "text_data",
      "source_text": "感受到海风和海浪声就会开心地摇晃",
      "source_fingerprint": "8079dc51a823c43a8feec57cf9d2f3e73d2c025f856262156c18f5734a0a5bdf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1079"
      ]
    },
    {
      "uid": "zhcn:f0788e9f2da66a3763970384",
      "kind": "text_data",
      "source_text": "地狱之耳！",
      "source_fingerprint": "8c19648ab8305a294e3d3c30bf2f04fd87afc29b949358371f9ede9324c9ba73",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1080"
      ]
    },
    {
      "uid": "zhcn:33fa1acc84dbcee8969c2e6e",
      "kind": "text_data",
      "source_text": "下决心打第一个耳洞时花了一个月时间",
      "source_fingerprint": "93ca1e92da6a170ab6ddf9782d8dd0ce798c68f4f28b3572f1509972393cde1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1081"
      ]
    },
    {
      "uid": "zhcn:66fb7f4b1bd150373136cfb2",
      "kind": "text_data",
      "source_text": "仔细按摩耳朵，以促进血液循环",
      "source_fingerprint": "93193f7db89027611434ea48e2df0f44868fd4debd6b6a52da93bc308ed8510b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1082"
      ]
    },
    {
      "uid": "zhcn:b8ea4bb4bfca5e6f5b979d30",
      "kind": "text_data",
      "source_text": "会盯着耳朵和自己长得很像的马娘",
      "source_fingerprint": "e3487ba072640347126a998dd5c09c5c5932dba628f880f96472d6bcc12e637d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1083"
      ]
    },
    {
      "uid": "zhcn:76a826d46813b3589704fa31",
      "kind": "text_data",
      "source_text": "能够讴歌我的只有我――（※容易无视采访团）",
      "source_fingerprint": "6e98c4f4568206e707d7f6dedb764d340c001152201e317d112f3dcc11f87fb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1084"
      ]
    },
    {
      "uid": "zhcn:c6b8bbae6d670a5b45e3e338",
      "kind": "text_data",
      "source_text": "有时听到音乐就会竖起耳朵认真听",
      "source_fingerprint": "5faf93336a425c3197ad8e2c053eebf17826cfd7a79a4908e18144710f113654",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1085"
      ]
    },
    {
      "uid": "zhcn:221d8fbd89cf73ad78fe59a4",
      "kind": "text_data",
      "source_text": "按摩要一直做到耳尖",
      "source_fingerprint": "efd1f3e8e1285dc4e8fc9dc7bb4a1dcab3606bdbde472bb47150f4d80ebce8be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1086"
      ]
    },
    {
      "uid": "zhcn:6ea520f29d8bb628c718685e",
      "kind": "text_data",
      "source_text": "耳环经常丢，现在戴的是第9只",
      "source_fingerprint": "5a8d124e3961b588a9d90ea0c437c5cbd43c82eaf67f22147a1659f7152db68d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1087"
      ]
    },
    {
      "uid": "zhcn:ede21af4a3b002c89a12527e",
      "kind": "text_data",
      "source_text": "有在最重要的时刻绷紧的习惯",
      "source_fingerprint": "7a3aaf8a89c247d55bfbe21626c539a6d7aeba21422c7867977aea2d95b7e0a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1088"
      ]
    },
    {
      "uid": "zhcn:290d3d868e9d099fe8e20ea1",
      "kind": "text_data",
      "source_text": "一个人的时候，会摘下帽子让风去吹",
      "source_fingerprint": "c4f916e9b6a392c6c4b023a983000bb609361d6b6df3ba304eecd241e766d8e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1089"
      ]
    },
    {
      "uid": "zhcn:76277f4b72ccd81fbe2d23b8",
      "kind": "text_data",
      "source_text": "只靠接球声就能知道是家里哪位投的球",
      "source_fingerprint": "718b939d1d2d8ba4c538926a99731240b34c9ba75737d6d7be42521ae996879c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1090"
      ]
    },
    {
      "uid": "zhcn:914731f5fea5e91faf8fe3ae",
      "kind": "text_data",
      "source_text": "想撒娇的时候，会不自觉地啪嗒啪嗒摇起来",
      "source_fingerprint": "86aba8d64527f40da23ebcd7e814c47493ef5e58e9524a2c1f9429ef0735bc1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1091"
      ]
    },
    {
      "uid": "zhcn:533d1a1021ac4200b4886128",
      "kind": "text_data",
      "source_text": "决定耳套颜色时烦恼了三天",
      "source_fingerprint": "eb0984376395b7e44eaaa13090b1b1594a1f545710b5f23acf409e1403c53d04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1092"
      ]
    },
    {
      "uid": "zhcn:3d40b0d68423efcab3e6d271",
      "kind": "text_data",
      "source_text": "听到笑声会微微摇动",
      "source_fingerprint": "ff00f28fc7eae717813371be8ac5de7576b7d6fc534bb70167b0c0479891d05e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1093"
      ]
    },
    {
      "uid": "zhcn:c473a0772bde59bd73f3b4ad",
      "kind": "text_data",
      "source_text": "不知为何，偶尔会有小鸟在此停留",
      "source_fingerprint": "001fda1cc7ec498ad1022c136e1bddf1affc75c0ac29e7ae9ea3e3bfab354f81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1094"
      ]
    },
    {
      "uid": "zhcn:1084ebadd92f1679070f59e9",
      "kind": "text_data",
      "source_text": "调制砂浆时，连声音都是判断依据",
      "source_fingerprint": "5ff4e40034ab680ce464a4256231e2e4cf5655854a99ea1bad6ec3c00a59627a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1095"
      ]
    },
    {
      "uid": "zhcn:351f62b500a06ecf8c51d0fa",
      "kind": "text_data",
      "source_text": "订购了和身形相匹配的头盔",
      "source_fingerprint": "d39117a7ec8bb4d8b7369c43c6a5df82680a4a6e690398d858ba5d211ba0abe5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1096"
      ]
    }
  ]
}
