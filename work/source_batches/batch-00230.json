      "json_pointer": "/169/1059"
    },
    {
      "uid": "zhcn:e8884505b8b60dd73ca2de17",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "老家的小吃店内装饰着关于女儿的报道",
      "source_fingerprint": "27909e2d6b391e4baa5baf044af8f69e37ccb1af0c41927e1006acd821778172",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
