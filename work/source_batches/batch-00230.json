    {
      "uid": "zhcn:b8bdf7e5c9a60a33ef7035bb",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "爸爸妈妈总是会被自己装死给骗到www",
      "source_fingerprint": "2bfad49dcb1da3497bce870b621065fdfa5ca9204010e1850d9800a8c60a2b41",
