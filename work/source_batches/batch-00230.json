    },
    {
      "uid": "zhcn:5bda22a17ef70265cbefdfbb",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "每次回老家的时候，老家的定食屋就会挂上欢迎的横幅",
      "source_fingerprint": "672574b1e51536a3ad1c31a573887ab00f1dfb47ae11097f87cab3b0220abcb4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
