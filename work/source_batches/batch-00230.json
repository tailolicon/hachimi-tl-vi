    },
    {
      "uid": "zhcn:ca5ccfe54d74c78395331129",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "虚弱的女儿的胡闹，在父母看来是她成长的证明",
      "source_fingerprint": "e73ed662ee57d6feee559b7655f62cababbf24c827896edcf7a44b3cc849e4e9",
