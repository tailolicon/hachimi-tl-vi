      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1040"
      ],
      "json_pointer": "/169/1040"
    },
    {
      "uid": "zhcn:884b5f84a09e9386a64800f0",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "家训为“表扬我表扬我表扬我，想被表扬！”",
      "source_fingerprint": "d1c0edc8825f68e1a627eeb0fcf215dcfd4d1a5c1ad6fe432065bbd53ea6876c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
