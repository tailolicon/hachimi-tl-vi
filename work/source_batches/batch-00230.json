    },
    {
      "uid": "zhcn:a869753298c1ab191f29a901",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "家庭会议中总是被委以主持人角色",
      "source_fingerprint": "3d63785f3beecca5fa7d02b1e2960b81c46c4e1fa03d1f99c1e6136ee2f45478",
