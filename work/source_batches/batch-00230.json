    {
      "uid": "zhcn:b1a8dc0bc1a1899a218c1531",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "父亲是知名的绅士，也是赛马娘界里的慈善家",
      "source_fingerprint": "4a8fdcf6c9c749ff9e81908286b3d5c0180b9573cbfba9a5a68c60b836391733",
