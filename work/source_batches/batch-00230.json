    },
    {
      "uid": "zhcn:4b16fbdd514f9457d8214516",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "父母谈论最新的电器会一直讲到天黑",
      "source_fingerprint": "6562469989c973d3b5275eaeb34040d1c5eeb198abdb6d734060da72ddf5025d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
