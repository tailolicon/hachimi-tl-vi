    },
    {
      "uid": "zhcn:0b407fdfbe78337f5212bcc6",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "煎蛋饼和格雷派饼的做法是从父亲亲自研究的菜谱中学到的",
      "source_fingerprint": "7d9a70b1685d694123d75d8a78065f4cf41606af1fbb43bc789969299cac869e",
