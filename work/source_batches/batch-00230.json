    {
      "uid": "zhcn:3f6a73d62a755343c01c7d75",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "虽然父亲是高尔夫的老师，但女儿已经开始超越自己了",
      "source_fingerprint": "b934b04fbc20c91a39184608b3ad671450952e6d10b9c8e2cc642bdd222a37f9",
