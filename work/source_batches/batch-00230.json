    },
    {
      "uid": "zhcn:099e4af785b7ab8cf81a681a",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "父亲的弟子们也同吃同住，是个30人的大家族",
      "source_fingerprint": "025dfda1469b1aad4cfaaabf060f08a45a64360c8fb9a4ceceb770b76006750e",
