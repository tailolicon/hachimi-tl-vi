    },
    {
      "uid": "zhcn:95aef7e8426cbfca3a6b5d7d",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "家人的兴趣是野营！节日！BBQ！",
      "source_fingerprint": "74f07d8a92a933dfb49b4c1a6ea662972db29f922be3ac7a78327e3287227548",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
