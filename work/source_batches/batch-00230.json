    },
    {
      "uid": "zhcn:31ee8b975928307596581695",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "母亲在家务方面灾难性的不行，因此家中雇有佣人",
      "source_fingerprint": "6ca7c13a0e87f1a7164cf1c169c3e2763e1f51f0145dd1e8f6346cac7c585c3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
