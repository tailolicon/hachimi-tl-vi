        "169",
        "1058"
      ],
      "json_pointer": "/169/1058"
    },
    {
      "uid": "zhcn:ce2921e58189672eb10cfd37",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "因为被禁止叫她“多伯酱”，父亲甚是伤心",
      "source_fingerprint": "3a74079a18df24c538c6edaf796774f6e07f5831ad412b0eb82fb505c08f0e52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
