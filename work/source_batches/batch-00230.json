      "uid": "zhcn:fd84096860293b5a70acbb83",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "会经常寄来水果",
      "source_fingerprint": "378c28e874bf842f2c769a9ed28dac803f93c89693a5f764a9e859a7d8596a53",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
