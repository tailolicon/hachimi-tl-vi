  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:00d4cef6da27e58009d4337d",
      "kind": "text_data",
      "source_text": "因为兄弟姐妹很多所以特别热闹☆",
      "source_fingerprint": "db374d23db8d28e9d1ab084ecf83a1a8f10b3cf4ceee4a94c2cf5b209bd13437",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1098"
      ]
    },
    {
      "uid": "zhcn:7874c39bce5a9fe922ac6d87",
      "kind": "text_data",
      "source_text": "寄东西来的时候，一定会带着苫小牧名糕点",
      "source_fingerprint": "978f1022ba7e10a3889d4156ef535eb67abb35cc4e3e42c8e268eed5ad955cd0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1099"
      ]
    },
    {
      "uid": "zhcn:fd9e6ac1daff2459155ea014",
      "kind": "text_data",
      "source_text": "家庭中最悠然的人是母亲",
      "source_fingerprint": "864f6a615ba7a18a075765396060dcfb4f30270f12166080663d8f304e074a23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1100"
      ]
    },
    {
      "uid": "zhcn:c5c91cc0b5c876f2d8d6a045",
      "kind": "text_data",
      "source_text": "常常以合奏的形式来交流",
      "source_fingerprint": "d6cce200cd3ed7e38e53448fba232303bf401ddf48560411da46053647017ab1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1102"
      ]
    },
    {
      "uid": "zhcn:696ff162847f4a1ccb972a51",
      "kind": "text_data",
      "source_text": "以前，妹妹的小学出道好好筹备了一番",
      "source_fingerprint": "0250ac5012fdf2b359d6a5a9858aa4a5d41fdc1106bb8931940989824ab0488e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1103"
      ]
    },
    {
      "uid": "zhcn:1443342f6b2815072cc405b9",
      "kind": "text_data",
      "source_text": "直到现在还说她以前太调皮很难对付",
      "source_fingerprint": "d40f52c1c969df2afae76f83eee29fa9e3fdcae1a2af254319db7cc7c4f45c76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1104"
      ]
    },
    {
      "uid": "zhcn:8b2289f5aba311904b9c5576",
      "kind": "text_data",
      "source_text": "和爸爸对话时大概有54%的概率能把意思传达到",
      "source_fingerprint": "ab846b9ff6ec24b1b57c71095a3094d2d82e0d733d8d034f53fea368f65c131a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1105"
      ]
    },
    {
      "uid": "zhcn:894ea533bbd706a76501031d",
      "kind": "text_data",
      "source_text": "入学申请书被父母先给交了上去",
      "source_fingerprint": "995bf9a8cfcdecdb6e9691c28a4bbb06f87b549367db6ed3f580019e2be9d7c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1106"
      ]
    },
    {
      "uid": "zhcn:da54278687dc6052cd8a1665",
      "kind": "text_data",
      "source_text": "妈妈的拿手料理是烤棉花糖派",
      "source_fingerprint": "cc3428df48be6193d21117714700cffee4416feef14e66e2b69a283120f06017",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1107"
      ]
    },
    {
      "uid": "zhcn:6cae0f04fee94da04758e9bc",
      "kind": "text_data",
      "source_text": "温泉旅行时，全家人都会认真比拼乒乓球",
      "source_fingerprint": "b138285900dd6cab6d571ad23a92be377f4b5c2219b1b7e3763388fea775cacc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1108"
      ]
    },
    {
      "uid": "zhcn:3a3c1829b561ddd2a648fb6d",
      "kind": "text_data",
      "source_text": "家庭齐聚时，野餐是固定项目",
      "source_fingerprint": "4413f5be619d3c16bab223ffce71d8386e8749e9d35849484a9f5e70e955d403",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1109"
      ]
    },
    {
      "uid": "zhcn:3347fb4c548d62adbef5bc3e",
      "kind": "text_data",
      "source_text": "有母亲亲传的胡萝卜蜜饯做法",
      "source_fingerprint": "ca397567bfe583dd0c69cc8a65ae702bb81bc3b0b88c1f75830491f215fad56f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1110"
      ]
    },
    {
      "uid": "zhcn:833a2201db16c73e8fe28741",
      "kind": "text_data",
      "source_text": "全员都会用某种方式写日记",
      "source_fingerprint": "9379c863fac9d45b8ebc100cd89b10fe529a8b707287aeb3fe6fb764e56c5ee1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1111"
      ]
    },
    {
      "uid": "zhcn:4c48c6b720fcaaf6868de87f",
      "kind": "text_data",
      "source_text": "最喜欢哥哥亲传的隐藏赏花点",
      "source_fingerprint": "f6af097d0ff94fbbc48d2d240f3ec76145e84fe4e04449773837deeaa3c3af1e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1112"
      ]
    },
    {
      "uid": "zhcn:d9f6fca2496ac84586172480",
      "kind": "text_data",
      "source_text": "全家，都是旅游前夜睡不着觉的类型",
      "source_fingerprint": "77c9756c6095eff2d36c6bbfebf526fa623a96344e0c401633a31bbf162cd1c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1113"
      ]
    },
    {
      "uid": "zhcn:eecea9dfeedcde96f3d43459",
      "kind": "text_data",
      "source_text": "有段时期什么事都模仿母亲",
      "source_fingerprint": "ad19385f5390e42920b41d8e44ca30ab0ff68a2c105c60d3c1b8c328c5fe3c59",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1114"
      ]
    },
    {
      "uid": "zhcn:a0aa2cfbbc22335b27103fce",
      "kind": "text_data",
      "source_text": "优秀的艺术感遗传自父母",
      "source_fingerprint": "564862f6f30cffae9f667d1da1063b664d2f0052cb95d2f67c3f9d63e9fba04b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1115"
      ]
    },
    {
      "uid": "zhcn:6917ab55b9375e1f9f04e4f7",
      "kind": "text_data",
      "source_text": "以3岁登上富士山三合目，5岁登上五合目，\\n7岁登顶为规矩",
      "source_fingerprint": "bbe4f77c7f256a3ca5a6fa993f23b63abd94a77eea00ae9db2af0cb1e76f8576",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1116"
      ]
    },
    {
      "uid": "zhcn:2e00c62ec5a9acca0e0ca1f4",
      "kind": "text_data",
      "source_text": "护理指甲的方法是妈妈教的",
      "source_fingerprint": "24f1e59ef856c5a102c0a3551fb122bf5c5183c958f4e4aa4f5e4aa823a89232",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1117"
      ]
    },
    {
      "uid": "zhcn:1300e967efec699221ae3c10",
      "kind": "text_data",
      "source_text": "从未违反过就寝时间",
      "source_fingerprint": "666a79c60d1e64cb0e7225194aee8d865b4bf705de749ee53973c38e69e1f1a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1118"
      ]
    },
    {
      "uid": "zhcn:82fdb12b9fab8232d134cc18",
      "kind": "text_data",
      "source_text": "没有一天不想念他们",
      "source_fingerprint": "d44a8429fbc89bb48cab3a9d85c2e7257565397385cd7a50eae40e088a92a7fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1119"
      ]
    },
    {
      "uid": "zhcn:05714e4dcc41b5bbfe1fafcc",
      "kind": "text_data",
      "source_text": "通过表情就大致能猜到父母在想什么",
      "source_fingerprint": "4a5207d1421dcb3a07f2885845a3e910953164630a123ddef2e23b716678f302",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1120"
      ]
    },
    {
      "uid": "zhcn:7db8950d6ed6bd73b376a0d3",
      "kind": "text_data",
      "source_text": "通过『石头剪刀布』来决定家务活分配",
      "source_fingerprint": "199886187a7f3bb10fea0f46833ffa5bed5835ca005f39c0fed975dceaac8dc8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1121"
      ]
    },
    {
      "uid": "zhcn:1e1bea6356c68872feb5b22f",
      "kind": "text_data",
      "source_text": "大家都有着一丝甜美而高雅的香气",
      "source_fingerprint": "0b2317d976eb7bd6257532c02b4f038c0e6331e447f4d9086286dc4796dfe7dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1124"
      ]
    },
    {
      "uid": "zhcn:c1622f22c3a70aa03bbe6ea7",
      "kind": "text_data",
      "source_text": "全家都偏好豆沙馅",
      "source_fingerprint": "931187398ffd8c78f3960d95d8501fcf3b1d4b179e0422a366e7f0d17bdf20db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1127"
      ]
    },
    {
      "uid": "zhcn:e4ce8985e4f7f52ad6a7de2c",
      "kind": "text_data",
      "source_text": "家族团聚中经常会跳黑拉丁街舞来炒热气氛",
      "source_fingerprint": "de46ec5428802ceeb904efd24ce0cf462db7b0adabd9fe9f904d57dd6d1d1569",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1129"
      ]
    },
    {
      "uid": "zhcn:37246dca549ae97326c8d928",
      "kind": "text_data",
      "source_text": "去搞笑剧场是全家人的定例活动",
      "source_fingerprint": "2f865242e7d18e5164960f3ef16b2e7548ad9a074e3c61e5301323a542df4f6f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1130"
      ]
    },
    {
      "uid": "zhcn:e6a3e2356909cbc03bbbc04c",
      "kind": "text_data",
      "source_text": "设有全家都说英语的『英语日』",
      "source_fingerprint": "0493c83084837b1263a39bafd311ddd84da58e6806f77e71c2c95ebc0403cc59",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1131"
      ]
    },
    {
      "uid": "zhcn:82d246dcc818d899bfb185dd",
      "kind": "text_data",
      "source_text": "纪念日不拍照片而是拍视频",
      "source_fingerprint": "6d78e685b4c0e3650e678af1530610a8a42599cbdeeb90ad1d2362bc14ab8220",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1132"
      ]
    },
    {
      "uid": "zhcn:0ae2aceb153a95024097094a",
      "kind": "text_data",
      "source_text": "会全家一起待在书房，最后全员睡着",
      "source_fingerprint": "495c8bc031f1eb8c8ae9e8f7c88740859de5847a3195f365e6791deb62e6b9d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1133"
      ]
    },
    {
      "uid": "zhcn:dba5c0b0d6a71153d2fb717b",
      "kind": "text_data",
      "source_text": "与母亲外出的日子总是大晴天",
      "source_fingerprint": "8396c4d8ca4ea754f3655f05a7bef9e2f3419159d6b6cfe30667ff8dedf2d9bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1134"
      ]
    },
    {
      "uid": "zhcn:eb91c930391e074aa2d059bd",
      "kind": "text_data",
      "source_text": "被妹妹们说挑土特产的品味有点迷",
      "source_fingerprint": "03412668382ca3ddf66697bd37aa64cb4d0f48f75115c30664b716d605f5cc5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1135"
      ]
    },
    {
      "uid": "zhcn:0f566df712566e10e8f8a30c",
      "kind": "text_data",
      "source_text": "经常去母亲的工作现场参观，也曾作为童星出演过",
      "source_fingerprint": "a725e2db27339308c24f143bb82bda351b3dc7fbbd7fe57e1a0907a68cc00916",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1136"
      ]
    },
    {
      "uid": "zhcn:bac97d231d0e5a85417c20d7",
      "kind": "text_data",
      "source_text": "即使父母回来得晚也决定先睡觉",
      "source_fingerprint": "89b8dcedc656c6a83d5f6a12c8640d6ef85509d7b13c4eeb2189665384d693cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1137"
      ]
    },
    {
      "uid": "zhcn:4d125d24d9bcdd64d051b08f",
      "kind": "text_data",
      "source_text": "宝贝是父亲赠送的瑞士制手表",
      "source_fingerprint": "1e683fb0fe74d31ddf7f53ef66bcc7e5a97367723b36cc268883abf85bf0e427",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1141"
      ]
    },
    {
      "uid": "zhcn:65b980759cd652d20896f610",
      "kind": "text_data",
      "source_text": "老家家具的摆放位置经过了极其严密的计算",
      "source_fingerprint": "02b1713749c0b2880881afd7983cae5262bc20909c1a42fca8c9a40882cdbc9a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1143"
      ]
    },
    {
      "uid": "zhcn:c793339fe5c216c8f359b941",
      "kind": "text_data",
      "source_text": "把弟弟的钢琴演奏当作背景音乐能提高专注力",
      "source_fingerprint": "cc813d0de066469624d1b5c8ced8aee2e9e8e02f956b5202345e34db796f8581",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1145"
      ]
    },
