{
  "schema_version": 1,
  "batch": 233,
  "batch_count": 1655,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "9c226cba1af606e532633417d9bfcf7f7d66a4bf",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:ede21af4a3b002c89a12527e",
      "kind": "text_data",
      "source_text": "有在最重要的时刻绷紧的习惯",
      "source_fingerprint": "7a3aaf8a89c247d55bfbe21626c539a6d7aeba21422c7867977aea2d95b7e0a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1088"
      ]
    },
    {
      "uid": "zhcn:290d3d868e9d099fe8e20ea1",
      "kind": "text_data",
      "source_text": "一个人的时候，会摘下帽子让风去吹",
      "source_fingerprint": "c4f916e9b6a392c6c4b023a983000bb609361d6b6df3ba304eecd241e766d8e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1089"
      ]
    },
    {
      "uid": "zhcn:76277f4b72ccd81fbe2d23b8",
      "kind": "text_data",
      "source_text": "只靠接球声就能知道是家里哪位投的球",
      "source_fingerprint": "718b939d1d2d8ba4c538926a99731240b34c9ba75737d6d7be42521ae996879c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1090"
      ]
    },
    {
      "uid": "zhcn:914731f5fea5e91faf8fe3ae",
      "kind": "text_data",
      "source_text": "想撒娇的时候，会不自觉地啪嗒啪嗒摇起来",
      "source_fingerprint": "86aba8d64527f40da23ebcd7e814c47493ef5e58e9524a2c1f9429ef0735bc1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1091"
      ]
    },
    {
      "uid": "zhcn:533d1a1021ac4200b4886128",
      "kind": "text_data",
      "source_text": "决定耳套颜色时烦恼了三天",
      "source_fingerprint": "eb0984376395b7e44eaaa13090b1b1594a1f545710b5f23acf409e1403c53d04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1092"
      ]
    },
    {
      "uid": "zhcn:3d40b0d68423efcab3e6d271",
      "kind": "text_data",
      "source_text": "听到笑声会微微摇动",
      "source_fingerprint": "ff00f28fc7eae717813371be8ac5de7576b7d6fc534bb70167b0c0479891d05e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1093"
      ]
    },
    {
      "uid": "zhcn:c473a0772bde59bd73f3b4ad",
      "kind": "text_data",
      "source_text": "不知为何，偶尔会有小鸟在此停留",
      "source_fingerprint": "001fda1cc7ec498ad1022c136e1bddf1affc75c0ac29e7ae9ea3e3bfab354f81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1094"
      ]
    },
    {
      "uid": "zhcn:1084ebadd92f1679070f59e9",
      "kind": "text_data",
      "source_text": "调制砂浆时，连声音都是判断依据",
      "source_fingerprint": "5ff4e40034ab680ce464a4256231e2e4cf5655854a99ea1bad6ec3c00a59627a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1095"
      ]
    },
    {
      "uid": "zhcn:351f62b500a06ecf8c51d0fa",
      "kind": "text_data",
      "source_text": "订购了和身形相匹配的头盔",
      "source_fingerprint": "d39117a7ec8bb4d8b7369c43c6a5df82680a4a6e690398d858ba5d211ba0abe5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1096"
      ]
    },
    {
      "uid": "zhcn:3b1532ddbafd6c7db0570e26",
      "kind": "text_data",
      "source_text": "专注地向着训练员",
      "source_fingerprint": "ec57c4cd0a0eea2bb8f482ce2b2a6e94dcb39c174a7ca35595bcbb5975baf736",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1097"
      ]
    },
    {
      "uid": "zhcn:f7f45e725ab990709e04ca45",
      "kind": "text_data",
      "source_text": "两只耳罩是爸爸亲手制作的",
      "source_fingerprint": "6b7755b5a6c3b0f8fe92c7a8034b68e98da179af1b9f6246bda308f218aea6a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1098"
      ]
    },
    {
      "uid": "zhcn:1a60ce0e9899b8e9ce1a0e45",
      "kind": "text_data",
      "source_text": "绝对不会忘戴耳罩",
      "source_fingerprint": "35f45e294c0eea06ab45ff0ae57b4989cc55347c1ca9757ef42149e2efb18e9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1099"
      ]
    },
    {
      "uid": "zhcn:baad391aed489504f61c7620",
      "kind": "text_data",
      "source_text": "会对敲锣声起反应",
      "source_fingerprint": "a24ac38d4a5870f018ae420f2ac667bfe483fa50cae0ef1d1ca1836c550f7970",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1100"
      ]
    },
    {
      "uid": "zhcn:6a0fa39f633e36d6a07734a5",
      "kind": "text_data",
      "source_text": "使用布料讲究的海外品牌耳罩",
      "source_fingerprint": "fbabca94b8ed3f0b79beb3e401ff36af1f27872807df54ec3b6378c14d498cda",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1102"
      ]
    },
    {
      "uid": "zhcn:d3b2f94b1f500d5c6fb9bc97",
      "kind": "text_data",
      "source_text": "对上自己的判断会立刻・Catch！",
      "source_fingerprint": "9066113787aa4492ef82128311a9da0dd0eb9209505c5fe5c94bfa9734cc053d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1103"
      ]
    },
    {
      "uid": "zhcn:bceb2dc4e1fc548af1bd433d",
      "kind": "text_data",
      "source_text": "换衣服时最后带上耳罩，充满了干劲",
      "source_fingerprint": "1764e1efc6ea2d9f49e3ee9f0b5ede0c1ee9fdd4324270926c569ff05c1fa10a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1104"
      ]
    },
    {
      "uid": "zhcn:ab797dddc81f3548662093b2",
      "kind": "text_data",
      "source_text": "保持着最适合接收“信号”的抛物线幅度",
      "source_fingerprint": "24a9d0174e9c4077760498949846a146b4070809a39762646d4969fffa11d3d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1105"
      ]
    },
    {
      "uid": "zhcn:bd1f5ab68b7fb85b96726e28",
      "kind": "text_data",
      "source_text": "起床之后需要很长时间才能立起来",
      "source_fingerprint": "df22ba4f8161fdef3a9b6d21c92a72eedc5e667fb7c58218f55ecb7dc61697cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1106"
      ]
    },
    {
      "uid": "zhcn:57ec2c9d299154f8d4dcc4be",
      "kind": "text_data",
      "source_text": "寻求浪漫时会不断摇动",
      "source_fingerprint": "e4e25aca31173133734aff451fd916d3dda408db1494a59665f91ab743128706",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1107"
      ]
    },
    {
      "uid": "zhcn:1b80b4d58bd2d11ee3b78bd0",
      "kind": "text_data",
      "source_text": "常常凛然挺立着",
      "source_fingerprint": "360696531e3d63cde9062f9fdaabb774eabdbe3f3f8a998f7975f2905c5ac4d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1108"
      ]
    },
    {
      "uid": "zhcn:0f78e9e8ee14805113285ab0",
      "kind": "text_data",
      "source_text": "亲密接触时会放松地垂下来",
      "source_fingerprint": "de34b18dbdf627e430f0853ae000a99f48395175a23ff84334b920c4346eb105",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1109"
      ]
    },
    {
      "uid": "zhcn:4fdfc822f289590f22088e99",
      "kind": "text_data",
      "source_text": "如果得不到宠溺，有时会变成飞机耳",
      "source_fingerprint": "ad567f21b3ade34b360da5e8725fcb37b89a811bf2683f0dd9b60041a1177298",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1110"
      ]
    },
    {
      "uid": "zhcn:02ad1526615ac17e206292da",
      "kind": "text_data",
      "source_text": "越是敞开心扉时就越柔软",
      "source_fingerprint": "8402bd853dd4763512727660a28baa9c7555527d7087554343e847be33d327fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1111"
      ]
    },
    {
      "uid": "zhcn:0f0d3d95b0b94f9a12a713ee",
      "kind": "text_data",
      "source_text": "每次重新染色时都会和朋友开派对庆祝",
      "source_fingerprint": "54330ad343d8a027552a6b7f20821aa2898873b28266166039db62e5c622c87b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1112"
      ]
    },
    {
      "uid": "zhcn:a343620643e83a32a0ecad26",
      "kind": "text_data",
      "source_text": "求饶的时候会垂到极限",
      "source_fingerprint": "c16bcb8176173a4a72c00ada3fbd38bde467cde63cf5af85a6d869faf17e4f92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1113"
      ]
    },
    {
      "uid": "zhcn:8649cdfc1c4a5afe28a98762",
      "kind": "text_data",
      "source_text": "分辨粉丝声音的准确度相当高",
      "source_fingerprint": "77916296c908002bf62a5eb48fbe0042db95416a41e8633c441e40d40d31ecf2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1114"
      ]
    },
    {
      "uid": "zhcn:67d525f2721b5a5ab27e9419",
      "kind": "text_data",
      "source_text": "耳饰是父亲做的",
      "source_fingerprint": "f25a6a311e4d8a4061fd9be62c4e4cb7bf872ce521013d804b32390dea4830a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1115"
      ]
    },
    {
      "uid": "zhcn:b55ccba14e6e2ee535f546e1",
      "kind": "text_data",
      "source_text": "十分讲究，要根据耳罩来决定服装",
      "source_fingerprint": "bd97dae7895d6474e1edbe99be2124936a0f156706eaff6107becee35ee703ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1116"
      ]
    },
    {
      "uid": "zhcn:9e9a525a729a0db0b2b5af1f",
      "kind": "text_data",
      "source_text": "容易对古典音乐产生反应",
      "source_fingerprint": "b3f62ec779883ca86acb3369d9b6bfac7dc1c9c98063986a89b89773dd4ab8d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1117"
      ]
    },
    {
      "uid": "zhcn:19fc738d2ddc912037bc7d83",
      "kind": "text_data",
      "source_text": "耳机没有降噪功能就静不下心来",
      "source_fingerprint": "c55b181bbbccc7a295d0922152ca629798d93c3b026f49e3ae46722abbcc0cec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1118"
      ]
    },
    {
      "uid": "zhcn:23e8746072dfe01c97585c7b",
      "kind": "text_data",
      "source_text": "不能摸",
      "source_fingerprint": "aeea9480fd49c7be607fd42f54ab291bdb4dde0b6e1b22b4e607a82d9596bbb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1119"
      ]
    },
    {
      "uid": "zhcn:5567dcbd3bf8cb79697d51d0",
      "kind": "text_data",
      "source_text": "无论离多远都能捕捉到猫叫声",
      "source_fingerprint": "6c4097fcd6d5777f0cfaead3a6a15e9c6531af72f14a84d0e9af3e431c11b10f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1120"
      ]
    },
    {
      "uid": "zhcn:da4b982122981b2da76749e3",
      "kind": "text_data",
      "source_text": "赞美自己的话语，一句也不会错过",
      "source_fingerprint": "66f8c91387777428ec863eeaa741b17646a2cfcfe59e5706f8ab0450858dd209",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1121"
      ]
    },
    {
      "uid": "zhcn:9052c660ae03e667cb596a65",
      "kind": "text_data",
      "source_text": "是『四天王』中听觉最敏锐的",
      "source_fingerprint": "052fee3f22d3fe9c5872c3498c21ec09e92822e06a197554ad1de4d5e0e53ca5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1124"
      ]
    },
    {
      "uid": "zhcn:213a6313b281b3424c4e8ef4",
      "kind": "text_data",
      "source_text": "有威严的毛色是我的秘密喜爱",
      "source_fingerprint": "e4b4656f2454312ce2fc1ee09ee88399b516fe63954c53953dd06b8673c5a325",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1127"
      ]
    },
    {
      "uid": "zhcn:71e77635146c7508b4bdf7ac",
      "kind": "text_data",
      "source_text": "对阳光的策略是，皮革制的耳套",
      "source_fingerprint": "77a695cac2e95737a51f9700e03c6c6e7333796e3c207ebb47926865ab244da5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1129"
      ]
    },
    {
      "uid": "zhcn:db6dfb56f11de9e5d879b06c",
      "kind": "text_data",
      "source_text": "会听着自己的脚步声来调整步态",
      "source_fingerprint": "0f524d4c96477dcab05c3aca291bfd8e5893a8ef9b0123ef5723b2cf00830f02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1130"
      ]
    },
    {
      "uid": "zhcn:26abe3b254dc9e519ccc1e31",
      "kind": "text_data",
      "source_text": "被按摩就会秒睡",
      "source_fingerprint": "9b0250ca03b20cb017a3cc4fca3427a34d195adfe6251f86ecf6137e90290be0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1131"
      ]
    },
    {
      "uid": "zhcn:d31e69eb51041dd4fe038d66",
      "kind": "text_data",
      "source_text": "直播时360度收音，一字不漏",
      "source_fingerprint": "29462bcecfa8ed694bfa282b7a706a43111435343bc636c3353399b789112492",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1132"
      ]
    },
    {
      "uid": "zhcn:73e55d9c194bfef15ddb17ea",
      "kind": "text_data",
      "source_text": "正在设计可以用来夹速记笔的耳饰",
      "source_fingerprint": "3f6dfff40256e5e250ad53eb38f49208878db4195cb98675212063d6aea05b32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1133"
      ]
    },
    {
      "uid": "zhcn:a87b52ed6af42c1c78cbddba",
      "kind": "text_data",
      "source_text": "在耳尖抹上少许花香精油",
      "source_fingerprint": "538b2380cb087ae6c19d758cb3d69b71a70219fc85e0c789d2b97318b4defb56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1134"
      ]
    },
    {
      "uid": "zhcn:c71989936cb218ec7c417abc",
      "kind": "text_data",
      "source_text": "从声音脸色变化来判断对方的真意",
      "source_fingerprint": "a0f801de97c21d849729c4f4380e53049443269407c07458bd266d13ef550714",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1135"
      ]
    },
    {
      "uid": "zhcn:7b97bba87aa168a90a34b113",
      "kind": "text_data",
      "source_text": "听曼城茶座的声音会觉得很清澈",
      "source_fingerprint": "10073c360c3a3258324b1aae0b2dedb0e5d74e72cd64357bb9529e2ba9b653b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1136"
      ]
    },
    {
      "uid": "zhcn:5b12b0c1501a94378b3f3bfe",
      "kind": "text_data",
      "source_text": "对酷炫的词语反应敏感",
      "source_fingerprint": "76e2cb713128fafdc75c5cacdb47003a9b1648cf52d2e2e8ddfbd0be1b148f8d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1137"
      ]
    },
    {
      "uid": "zhcn:fc4755cd6c3924e57d29a2bc",
      "kind": "text_data",
      "source_text": "因为和吉兆的很像所以很喜欢",
      "source_fingerprint": "10ffe8cf43859daf5a5db39e4975384534b0ccc5cc14ffa471fd4b93c0781628",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1141"
      ]
    },
    {
      "uid": "zhcn:8c2e8a6cb0927a9b2ce241a3",
      "kind": "text_data",
      "source_text": "毛茸茸的，经常会让朋友摸",
      "source_fingerprint": "7aadcc6a4ea960165bdf01c494235c102e24efe37b77cc4d1b7f225862f98df3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1143"
      ]
    },
    {
      "uid": "zhcn:5c3fd357f6f6526a82f5e5e0",
      "kind": "text_data",
      "source_text": "戴着头戴式耳机会觉得更安心",
      "source_fingerprint": "5353fc773dc84811f41dc518642d92d41211faa2555bb17d10465128279ba058",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1145"
      ]
    },
    {
      "uid": "zhcn:95c12b943602f688808f932b",
      "kind": "text_data",
      "source_text": "由于尾巴会按照心情摆动所以不擅长打扑克",
      "source_fingerprint": "1101055ab3f778bd17ea4b094e9f97eb27bbe31df29cf1ba1c29c0fa31071792",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1001"
      ]
    },
    {
      "uid": "zhcn:36a170518d928ce31044db4e",
      "kind": "text_data",
      "source_text": "为了减少空气阻力，经常保养尾巴",
      "source_fingerprint": "d9dc354f3febefa9a684930fc3806b6d50c9a31ebf7e8cafc990e61fce1591b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1002"
      ]
    },
    {
      "uid": "zhcn:488ea87b02c08bc66a047572",
      "kind": "text_data",
      "source_text": "被关注的话，尾巴会兴奋地摇晃",
      "source_fingerprint": "8404695fdeb7e5c1332490252266a6874f4fd4368ac026097fd64d47b5c24e13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1003"
      ]
    },
    {
      "uid": "zhcn:737b6e406a949d551dc4d569",
      "kind": "text_data",
      "source_text": "起床后唰啦唰啦地洗头是自己的最爱",
      "source_fingerprint": "61ae534ed1012f05db869882f8b64280202f69a241274f81fe8e4bf3fb258a4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1004"
      ]
    },
    {
      "uid": "zhcn:8a81ce9ab8aaee928d927d8e",
      "kind": "text_data",
      "source_text": "像歌剧中的大羽根般优雅的摇动",
      "source_fingerprint": "43d1b316178f6514f51f75d1a2db671ec6dd39a887a599c3b474517251c90a92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1005"
      ]
    },
    {
      "uid": "zhcn:07874dedce5f7de842b68bac",
      "kind": "text_data",
      "source_text": "由于身体很柔软所以尾巴没有梳理不到的地方",
      "source_fingerprint": "9b8c4a5613875065533cdc9c05aeeb853600ce62c47f4e2a008aaea39cc9cae7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1006"
      ]
    },
    {
      "uid": "zhcn:2d997b6be34934301d43e924",
      "kind": "text_data",
      "source_text": "有时候会忘在宿舍（本人表示）",
      "source_fingerprint": "3ef63f23c91adf5d670220f8b101e5e221a3c89bfe492831614f3802b9ce3878",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1007"
      ]
    },
    {
      "uid": "zhcn:6ae5a4ba0db488d36dd12a17",
      "kind": "text_data",
      "source_text": "练习着帅气晃动尾巴的方法",
      "source_fingerprint": "5432a9fb1a22f11e65ac95c832c101fbbc7f75262853e4b251a8629ca1df7c50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1008"
      ]
    },
    {
      "uid": "zhcn:df46a572f41e638ce2b3b1f2",
      "kind": "text_data",
      "source_text": "每天早上都为了能够梳好尾巴而战斗着",
      "source_fingerprint": "9f61d63651a0dcb257bba35bca2be25b6d3ffc4b11f3cea70494874006fba848",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1009"
      ]
    },
    {
      "uid": "zhcn:0639e0bde0938d134f6f18de",
      "kind": "text_data",
      "source_text": "顺毛喷雾与生活费一同收到",
      "source_fingerprint": "15c57aa5d4734c8ddace4edf6057660ea8c148fa05ac7c7a6a755374513c972f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1010"
      ]
    },
    {
      "uid": "zhcn:38e1e864a39ebeffae4c2c65",
      "kind": "text_data",
      "source_text": "不用回头就可以将身后的虫子扫落",
      "source_fingerprint": "59e24ce208b134b0bc0c6dfc70c075d7dee19ea610ebf1f8d5826de26efdc54a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1011"
      ]
    },
    {
      "uid": "zhcn:e9140992c32245cdcdf493c5",
      "kind": "text_data",
      "source_text": "许多学生憧憬着那抹艳黑色的尾巴",
      "source_fingerprint": "07be3b873d024bb9ce660e9a8b7031fa544d5307a868e63d2c30e077c0d9ff90",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1012"
      ]
    },
    {
      "uid": "zhcn:caa01ed27b9324484ffa3b7f",
      "kind": "text_data",
      "source_text": "提到运动话题的话尾巴会摇晃的很激烈",
      "source_fingerprint": "92a6776e27e94839f6897fa2067ca29677667448dfc8c51a168fad5077e86951",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1013"
      ]
    },
    {
      "uid": "zhcn:4f18436f24be2e14c368e2f9",
      "kind": "text_data",
      "source_text": "抓尾巴似乎是犯规行为",
      "source_fingerprint": "4bb964304cb7455bf2891d01d457147e23e1c77c8f7c7ade93aa6b3914d07349",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1014"
      ]
    },
    {
      "uid": "zhcn:5ec38bae7c602c395b5463ea",
      "kind": "text_data",
      "source_text": "被光照射的话就会熠熠生辉",
      "source_fingerprint": "31f6db3cd95a6e174151810ccfe55c5ef5e2904a94e02862b699d38d8bce8642",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1015"
      ]
    },
    {
      "uid": "zhcn:def577458db2e4eae2801c05",
      "kind": "text_data",
      "source_text": "既不在意也不保养",
      "source_fingerprint": "b2f696408a16cc0ad68fed101dcd82415ae9aeafb07bb266d39919b8a1aee029",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1016"
      ]
    },
    {
      "uid": "zhcn:d0faa225d82789d150784c28",
      "kind": "text_data",
      "source_text": "在发表演讲时每一根毛都充满着魄力",
      "source_fingerprint": "ee423b367fedf821410d5ae2eec83a96bea218749a456766d0073cc8371e81d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1017"
      ]
    },
    {
      "uid": "zhcn:07a0c834f9642ef8e50ed305",
      "kind": "text_data",
      "source_text": "使用着与母亲相同的尾部护理油",
      "source_fingerprint": "3b1d6ef2e0d03e82ea697011016efa42ef06c9165411a97b478353aba80a117c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1018"
      ]
    },
    {
      "uid": "zhcn:3961ea21638a6b8c8f32c5fb",
      "kind": "text_data",
      "source_text": "在Live前会去理发店梳理尾巴",
      "source_fingerprint": "28ef9180b384832677aa2acf3fad1b70f851d7f0900619ce50d0e7ed85afe530",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1019"
      ]
    },
    {
      "uid": "zhcn:2bcba0ba11b16aa64d95b382",
      "kind": "text_data",
      "source_text": "就算不梳理也会自然而然的顺直",
      "source_fingerprint": "bc5e00eef5a946f56e5a79dded0824a03dc0526c6585f5ed4b7f7e52c8c7d246",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1020"
      ]
    },
    {
      "uid": "zhcn:142ca45bf972231cddf2c016",
      "kind": "text_data",
      "source_text": "生气了的话，就会像闪电一般抖动",
      "source_fingerprint": "f0bc896ec4cd449d588ae6fd74fb387a0e58f86f1fc0f87b4c083fb55efaddd8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1021"
      ]
    },
    {
      "uid": "zhcn:3552449a31be04765336cb49",
      "kind": "text_data",
      "source_text": "拥有着王族特有的发质。俗称“皇家·尾巴”",
      "source_fingerprint": "8aca9ebb3782b8b3c83717a76677b5f84c8a5e576bfb360b33fe0d3fac251f09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1022"
      ]
    },
    {
      "uid": "zhcn:1cbcc552408f458752abd61c",
      "kind": "text_data",
      "source_text": "倘若有湿气的话，会陷入将尾巴塞入衣服上的尾巴孔的苦战",
      "source_fingerprint": "1e0b5dc6e56bd69f0f49fe3391d58b8f0daac76fdd79645b95fbef662d640b4f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1023"
      ]
    },
    {
      "uid": "zhcn:6344cbd54e2c579bb1cfb5a8",
      "kind": "text_data",
      "source_text": "说谎时会摇的很厉害",
      "source_fingerprint": "6315a5c88671fb082b0fc08a7bd30fc494fb0e4d83a9dfe66b2dc387830db65b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1024"
      ]
    },
    {
      "uid": "zhcn:95234f3d7377e164bcbd9d29",
      "kind": "text_data",
      "source_text": "即使不做任何保养，尾巴也十分光亮润泽",
      "source_fingerprint": "5f0fcef7f09ceb24bf869f47d2741948784f0ae245c591b5681e53cda6624c2a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1025"
      ]
    },
    {
      "uid": "zhcn:4e9bab369ea906c1fcc44cd8",
      "kind": "text_data",
      "source_text": "有着能够依靠尾巴来支撑自己的力量……据说",
      "source_fingerprint": "f09b97728c3c3f3deaa47df12a4d523acec6dd53874cedfbbb8f20990ab3be3c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1026"
      ]
    },
    {
      "uid": "zhcn:4667035f1ed2886855e5a32a",
      "kind": "text_data",
      "source_text": "因为经常出汗所以常备尾巴用汗巾",
      "source_fingerprint": "85b56f83e2f8d6a3f532d4c3350cb631a4e77717fb28fb8c6410de7a8032682a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1027"
      ]
    },
    {
      "uid": "zhcn:efa096bb8947481ec94fe142",
      "kind": "text_data",
      "source_text": "打发时间的时候尾巴也会跟着一齐旋转",
      "source_fingerprint": "6c4b97970bea2b3a6d2a3fb9541e5f41ebc5e296a198880abb56970993a16959",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1028"
      ]
    },
    {
      "uid": "zhcn:681cdf8ebbf61c86e0a5e371",
      "kind": "text_data",
      "source_text": "正在挑战买到便宜实惠的尾部护理用品",
      "source_fingerprint": "b937de6dc37030ca040fc3fb0251489fd1d1e834c3d1b679798b7f7728d6d593",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1029"
      ]
    },
    {
      "uid": "zhcn:5abfc08716d18cdc7e8886dd",
      "kind": "text_data",
      "source_text": "为了不撞到他人而小心翼翼地注意着",
      "source_fingerprint": "9031724712c1d6f01c12315352ca1a191ed04191432226a82eb08a956965c444",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1030"
      ]
    },
    {
      "uid": "zhcn:49f851d88c5da64a3482c7e1",
      "kind": "text_data",
      "source_text": "习惯于被妹妹们捉弄、即使被突然抓住也不会被吓到",
      "source_fingerprint": "e440e8feaffefbb7836423960cbf4d6edceac78a15fd82332de503137d386745",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1031"
      ]
    },
    {
      "uid": "zhcn:f12ebc1808758a3cf060013a",
      "kind": "text_data",
      "source_text": "灵光一闪时就会毛发皆竖",
      "source_fingerprint": "f3c73b440c24f342f91a720e3e236d1001db5359fdb03a246d1aed2854678994",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1032"
      ]
    },
    {
      "uid": "zhcn:bffc6f19f9f899284a86c1dc",
      "kind": "text_data",
      "source_text": "在睡觉时有着会无意识抓住尾巴的习惯",
      "source_fingerprint": "623f9af4319d60f8a6d687cf82657a8bca1936ce0e77cafae246323ea6d0d989",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1033"
      ]
    }
  ]
}
