{
  "schema_version": 1,
  "batch": 234,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:06cb9347a8b03730c9af1cf0",
      "kind": "text_data",
      "source_text": "无论刮风下雨都会每天锻炼自己的尾巴",
      "source_fingerprint": "71f3e3e25d1278e01751412af24e830ab49043684b22ab4322f97f76e9b55cbc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1053"
      ]
    },
    {
      "uid": "zhcn:9416d9d1ba53049960c8916c",
      "kind": "text_data",
      "source_text": "摆出英雄姿势时容易踩到",
      "source_fingerprint": "231c6898756df6ef6a47d3768861501a5d01df01f6606a47c03f83319a39c75e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1054"
      ]
    },
    {
      "uid": "zhcn:04fd5782b4bd69d779f0fd0a",
      "kind": "text_data",
      "source_text": "是能发现Marvelous的事物的天线☆",
      "source_fingerprint": "039a6394dbcf67852664d2168084d4ad5819ef152533e35ebbbd4824e605f141",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1055"
      ]
    },
    {
      "uid": "zhcn:ae573a74414600865ab9c5a2",
      "kind": "text_data",
      "source_text": "在占卜时尾巴会突然停住",
      "source_fingerprint": "c18dd5225534628433e7b401f6ff481d0793650d71cb6dd67db9ba093f6e9bcb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1056"
      ]
    },
    {
      "uid": "zhcn:2c5884032c007c31fd0625b9",
      "kind": "text_data",
      "source_text": "经常更换尾部护理油",
      "source_fingerprint": "474143231c4cbc96acd5b0e56d8e9ded3d2525eae0d3344759562c180a8a4222",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1057"
      ]
    },
    {
      "uid": "zhcn:7f84c1a6389bbd3a3661bf76",
      "kind": "text_data",
      "source_text": "由于烦恼时习惯于摆弄尾巴，所以经常打结",
      "source_fingerprint": "675289ee958ccd2280feb75f3f092197cc786a455eb43b4234a5930e2fbf13d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1058"
      ]
    },
    {
      "uid": "zhcn:eb6b644d01a5f534879b2d80",
      "kind": "text_data",
      "source_text": "比起名牌更喜欢适合发质的产品",
      "source_fingerprint": "150ba9bf35edd61dae17388ae9aaeed3a0900d8a94e905a1ec95f94d1f46ed08",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1059"
      ]
    },
    {
      "uid": "zhcn:58b7c42bfb4a1bb5cf70efee",
      "kind": "text_data",
      "source_text": "在夜里偷偷地梳理",
      "source_fingerprint": "33546e178a6cce12a09404fec1271d3b1eed70d35cb20c662f95d716a6e7af39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1060"
      ]
    },
    {
      "uid": "zhcn:aadc85f213ef0799355e1ca3",
      "kind": "text_data",
      "source_text": "常常保持着一流的摇动尾巴的方式",
      "source_fingerprint": "0da56fd9132221b6e244dbc5ddffd9b8376876412640487d549b7dd6b683c064",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1061"
      ]
    },
    {
      "uid": "zhcn:e0eefe61de86ec471ce95aa4",
      "kind": "text_data",
      "source_text": "如果自己修剪的话就会果断地斜剪一刀",
      "source_fingerprint": "4d71c4299d774238142c21ea5688612f23b7305f4f4c3c3acc9a097e33fdee0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1062"
      ]
    },
    {
      "uid": "zhcn:a2f9daa57be87a8c4139e6f6",
      "kind": "text_data",
      "source_text": "有时会当作指示棒使用",
      "source_fingerprint": "342744b5095328e7ff09b0ded1c0e429d638dbf6527c195f49a9998cca880c0c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1063"
      ]
    },
    {
      "uid": "zhcn:9f4892fb8c5da75f2506288b",
      "kind": "text_data",
      "source_text": "有时会用尾巴对别人的脚进行挠痒痒攻击",
      "source_fingerprint": "0b41212fae21e8b11653fa3f74406bdc04512db0837f4c4b8f2a82d5e9a8d2a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1064"
      ]
    },
    {
      "uid": "zhcn:27b0f62f5cb866762b51c4fe",
      "kind": "text_data",
      "source_text": "跟好姬友缠成心形拍照真的超激动",
      "source_fingerprint": "9bfb75de7fe6a9ee8cdf6a74100323583e8521fc6d1f0c580b6c1b2cbb5dfb1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1065"
      ]
    },
    {
      "uid": "zhcn:8286249068460599d67b3209",
      "kind": "text_data",
      "source_text": "不冷静的时候，会到处摇来摇去",
      "source_fingerprint": "eb0fc438760d1a4a7c0dd7d8d83e53bbc074497e167c23b2c1d5ad87276d2310",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1066"
      ]
    },
    {
      "uid": "zhcn:20799ee327b110cf004e09d4",
      "kind": "text_data",
      "source_text": "有着最棒的触感（评价・来自北部玄驹）",
      "source_fingerprint": "34800962867af45a7d565e1503080e89f1e6a7a87ea6b25b6e07b646a37bc055",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1067"
      ]
    },
    {
      "uid": "zhcn:9c4c97ab04b6343b688207d1",
      "kind": "text_data",
      "source_text": "尾巴也能拎起重物",
      "source_fingerprint": "b82ea068b5130a83acbfe6d8509396cc7e3927370cbc4361363713cfa8fff8f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1068"
      ]
    },
    {
      "uid": "zhcn:2ac8b0a50c3731d354162d00",
      "kind": "text_data",
      "source_text": "使用着与丸善斯基同款的尾部护理油",
      "source_fingerprint": "bb5b54bcaacf56e6633a7b970381195d8ba75960b58ebb86fcaf97333df4f437",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1069"
      ]
    },
    {
      "uid": "zhcn:94c4d8986397fe8d462dc682",
      "kind": "text_data",
      "source_text": "有焦躁时就会缩起来的习惯",
      "source_fingerprint": "eb7bec3329627182cb0f2c199cbb56dc96554803379a474dc8af240869531193",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1070"
      ]
    },
    {
      "uid": "zhcn:bb6f8a50f0fe91fafa94a07b",
      "kind": "text_data",
      "source_text": "喜欢使用特别订购的有机营养护理液来护理尾巴",
      "source_fingerprint": "05628fad8976d0a7e6992f02d323674fac48779e3004011ca19e2aae4cf2a50b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1071"
      ]
    },
    {
      "uid": "zhcn:c59238187a574149af4b9060",
      "kind": "text_data",
      "source_text": "强韧到能够将飞过来的物体击落",
      "source_fingerprint": "d0b4a312e96c46e8decf13e5b17b5609a01fed2d8216f4cc0813f1878b97fb93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1072"
      ]
    },
    {
      "uid": "zhcn:eaa6b1e47325bc3af80fb912",
      "kind": "text_data",
      "source_text": "洗了不马上吹干就会感冒",
      "source_fingerprint": "b68b91ecb63188de563622549c253d09925934d2e7de7e71ec797b24ddc3a3ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1073"
      ]
    },
    {
      "uid": "zhcn:6a9ee4bcdd6c66ed5b846c61",
      "kind": "text_data",
      "source_text": "坐着的时候即使尾巴被垫在屁股下面也不在意",
      "source_fingerprint": "09f985a41de081b09034632d615dc7155be139819b0498b9d46ccc3d20b116e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1074"
      ]
    },
    {
      "uid": "zhcn:612eab55d8bce4bcef927d92",
      "kind": "text_data",
      "source_text": "发质跟母亲一样，相当柔软",
      "source_fingerprint": "a93f662c90d15aa9e588d7a5f9cf5d4617f0bd288416755cded074f8490ef5b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1076"
      ]
    },
    {
      "uid": "zhcn:68d6f5f9001e04952316b5c3",
      "kind": "text_data",
      "source_text": "会介意因为湿气而稍稍变散",
      "source_fingerprint": "91bfb35c8f8a9546106c5a2e6e3b2abac0fd7e50f1e1fecd895da1ba8ccaf3ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1077"
      ]
    },
    {
      "uid": "zhcn:863fa9bf9cb91209a93a4e23",
      "kind": "text_data",
      "source_text": "自然风干派",
      "source_fingerprint": "7bf69da7295b07332f745e56e6fb19c18ea86ab36bd1d53c1cad8c93d7014809",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1078"
      ]
    },
    {
      "uid": "zhcn:71f6ad76df29e7cc2e788041",
      "kind": "text_data",
      "source_text": "要被绊倒时，会拍打脚部斥责自己",
      "source_fingerprint": "675180a486aa73c8b63a65f3eaf71657b31cf1bb6fe227550d103409a098b19f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1079"
      ]
    },
    {
      "uid": "zhcn:8e0762acc925055e6ac87ac3",
      "kind": "text_data",
      "source_text": "将其当作新制尾巴护理用品的试验台",
      "source_fingerprint": "603cc01e6524c610c05f539f568e9d2d88314c418b23d235c7caec3c99527db3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1080"
      ]
    },
    {
      "uid": "zhcn:5a80e360c4515418a337f01c",
      "kind": "text_data",
      "source_text": "用历奇的梳子随手护理※有开运效果☆",
      "source_fingerprint": "b7c865e1b92e4cbaf0a1f79a57d0414d934486774decccb63f27c46dd79a66fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1081"
      ]
    },
    {
      "uid": "zhcn:1a920dccf8355276c61a090f",
      "kind": "text_data",
      "source_text": "有着许多种打理方式",
      "source_fingerprint": "e685fadc8a8bc53ca078d9de6fb21ac131fcdc429cc9797c6d11db1fb272eb72",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1082"
      ]
    },
    {
      "uid": "zhcn:895bccab300e9d0bb15f4229",
      "kind": "text_data",
      "source_text": "用专用的洗发水刷刷地洗",
      "source_fingerprint": "dac141a5409cb057971b5694fa25805215902af99d556a1b5115d31215ae6c06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1083"
      ]
    },
    {
      "uid": "zhcn:e4bea24b301a7fc6361e8437",
      "kind": "text_data",
      "source_text": "反抗着概念――（※即使是尾巴也想要破坏栅栏）",
      "source_fingerprint": "41755ad96d4f4c31e647a79dd5686ba564c46604187072d31da8c9a9ce707548",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1084"
      ]
    },
    {
      "uid": "zhcn:f73406d6257083a28209b0b0",
      "kind": "text_data",
      "source_text": "发梢能自来卷出高贵的造型",
      "source_fingerprint": "e62b8a261314dd387ef8545b804586ea62ed42875b3b8aabc67fa154ad1e009f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1085"
      ]
    },
    {
      "uid": "zhcn:13be554d48b3dcbbd1b7c930",
      "kind": "text_data",
      "source_text": "总是丝滑的流线型",
      "source_fingerprint": "74c4c724736a97a29ff81de987e37ec9cdfda92c63c54e87f2def6827acaee88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1086"
      ]
    },
    {
      "uid": "zhcn:551d419bd8ba362a34a7844f",
      "kind": "text_data",
      "source_text": "正在摸索自己的形象商品化时尾巴如何打理得更漂亮",
      "source_fingerprint": "1194deb79031b50a456da7c0a0a882ccb1c9fef68b9a1001249c9edfb7e5b3ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1087"
      ]
    },
    {
      "uid": "zhcn:4e9045b83e44978d62f1cbe1",
      "kind": "text_data",
      "source_text": "订购了里见系酒店的特供护理品",
      "source_fingerprint": "3bdf44e70068f459c17bcaad79b23acb19aa8397819d8a26ea8471b2fc9d576b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1088"
      ]
    },
    {
      "uid": "zhcn:e680d806100283ca756bfcea",
      "kind": "text_data",
      "source_text": "常常被妹妹随便编成三股辫",
      "source_fingerprint": "0dd018453dbe8305b1c8f945ec95de0ec93ffe47eae5f4de6e47d0d6cea73d9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1089"
      ]
    },
    {
      "uid": "zhcn:f55e12117380e1d1290407fa",
      "kind": "text_data",
      "source_text": "小时候经常由妈妈帮忙梳理",
      "source_fingerprint": "8dbf9367a5b776b0035e9f8103def0f82e9beee2dd7794160be95e4dc0328382",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1090"
      ]
    },
    {
      "uid": "zhcn:6316b65aa4fb04838c9d8735",
      "kind": "text_data",
      "source_text": "使用名流推荐的护理液",
      "source_fingerprint": "9043b9bfb3364c655f645bb5419ea4e3bb66760ba507be3efd468dad04548607",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1091"
      ]
    },
    {
      "uid": "zhcn:77817ce4dc4057ea673a8859",
      "kind": "text_data",
      "source_text": "听怪谈时会跳个不停",
      "source_fingerprint": "d93354b155bd07ae0dda02548fc233d9c46bae078eec9e01b317d7e90f467e29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1092"
      ]
    },
    {
      "uid": "zhcn:7bbf0dbcfc2bf974694f0634",
      "kind": "text_data",
      "source_text": "有着肥皂的香味",
      "source_fingerprint": "85d425321045f3ec7ebd1d5884287f7f5c497b13e731f1f4eb7ca59dedd827c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1093"
      ]
    },
    {
      "uid": "zhcn:c284a3cfaa982d16ed16bfd8",
      "kind": "text_data",
      "source_text": "在富士奇石面前会来回摇摆",
      "source_fingerprint": "880ab19789062a818433b9ef5eac8e47fee1b7e0a2da4f0a08f80a4fb16de336",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1094"
      ]
    },
    {
      "uid": "zhcn:04af875e271149bf0da00100",
      "kind": "text_data",
      "source_text": "护理刷是行家才能懂的匠人珍品",
      "source_fingerprint": "4595845cc0109319a99fc9ef09c10aa7b9cfbaac2473fc267ed9c38b563600b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1095"
      ]
    },
    {
      "uid": "zhcn:8ad9ef6257f97a073940b150",
      "kind": "text_data",
      "source_text": "喜欢用碳酸洗发水清洗",
      "source_fingerprint": "b013751c0df4b2f9414c29f658d4b39f9409ddcedabb7079b32fa1574423f68e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1096"
      ]
    },
    {
      "uid": "zhcn:2a657d3e26cd1f9ad03122a9",
      "kind": "text_data",
      "source_text": "摇晃时会散发出淡淡的香气",
      "source_fingerprint": "0e1cc4be4635f6d09cb0d647a6eae4d337d7bb622b7e9a00ae723a4641d6bfcd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1097"
      ]
    },
    {
      "uid": "zhcn:8c7286f8b57d0297f6b83317",
      "kind": "text_data",
      "source_text": "会情不自禁地朝着今日的吉祥方位甩来甩去",
      "source_fingerprint": "7746b4f678e843c8d630f15f47b7a370b0044261a88f0fcca48327312d98f981",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1098"
      ]
    },
    {
      "uid": "zhcn:d6ff867b955d1968bbedd9df",
      "kind": "text_data",
      "source_text": "地方偶像模式启动时，摆动得更多",
      "source_fingerprint": "796421b67255ec21e293d7d71845f4865043d6052acc425825804e6ec155e3a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1099"
      ]
    },
    {
      "uid": "zhcn:9418022656ef125650c88c93",
      "kind": "text_data",
      "source_text": "即使要被触碰了也能华丽地躲开",
      "source_fingerprint": "960ddfaba3479c13b58bc780183cc8e0c7acf5b5047b890d318d5320f678b36d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1100"
      ]
    },
    {
      "uid": "zhcn:b93a05b095771b0217bfa22f",
      "kind": "text_data",
      "source_text": "普通着装和正装时使用不同的尾巴用古龙水",
      "source_fingerprint": "7c894fd4a03d6f722c7ad8caff532a175b0583a7eb078a9b6a70203da7dc7e9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1102"
      ]
    },
    {
      "uid": "zhcn:e7f7a5c42ce1a485391546af",
      "kind": "text_data",
      "source_text": "尾巴用的香水是自己调制的",
      "source_fingerprint": "c69b8777f53be3431082cbd41c54e2c72ad070239742e0b305f766e9b0f2e85f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1103"
      ]
    },
    {
      "uid": "zhcn:5e2197dd42034f50060ff563",
      "kind": "text_data",
      "source_text": "随时欢迎刷毛",
      "source_fingerprint": "fe8db328061150d3e99669a82fd639c319ae795a249acb769e9a517a1193d9cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1104"
      ]
    },
    {
      "uid": "zhcn:2f0b04fdedd65473c57e878e",
      "kind": "text_data",
      "source_text": "状态不好的时候似乎尾巴就会变成“尘埃彗尾”的样子",
      "source_fingerprint": "2339dd2c18eeb8cebcb2ea589269085854f96e57877b95a37ce60cf0de5bd197",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1105"
      ]
    },
    {
      "uid": "zhcn:30d7bb8e170aa8d4b5940351",
      "kind": "text_data",
      "source_text": "要不要染一下呢……只是有这么想过",
      "source_fingerprint": "9045b8c6d61d6c2c77c942899e476d208e4b2c9d76ede8d4ed93dc693d32af5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1106"
      ]
    },
    {
      "uid": "zhcn:e1f2a85c5da7ecef9cfba057",
      "kind": "text_data",
      "source_text": "为了跳舞时更好看，使用护理油",
      "source_fingerprint": "d07676e549387438c6cb81e69e085d38fca18bdad1297a89b26ffaa529d4823c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1107"
      ]
    },
    {
      "uid": "zhcn:b7506add170f4d91c0f055ae",
      "kind": "text_data",
      "source_text": "自己确定好适合运动的重量并作整备",
      "source_fingerprint": "befcb2db43d654583c49d6022e9088f7deff26317263b4d985187a73660e0e24",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1108"
      ]
    },
    {
      "uid": "zhcn:2dba5a6fc4a8204b7a856d21",
      "kind": "text_data",
      "source_text": "总是柔软蓬松",
      "source_fingerprint": "ee1b8da9a625e2ceba1b5fcb4cb1a78f25964ee1b3c126bf55aa71e77aed2a73",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1109"
      ]
    },
    {
      "uid": "zhcn:ed8f81c97281e8c8fd3336e3",
      "kind": "text_data",
      "source_text": "使用深海海洋水制成的洗发水",
      "source_fingerprint": "f0481cb1a47bfaf671b0566c13530ee0712079b9d47aa37778bc7e60896c9a69",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1110"
      ]
    },
    {
      "uid": "zhcn:68c101afafedb2217cd8b840",
      "kind": "text_data",
      "source_text": "拥有遗传自母亲的优质毛发",
      "source_fingerprint": "40e164ff6492c74a7d82830366f409ada50a51e81ef4d06c46ccbefec95644b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1111"
      ]
    },
    {
      "uid": "zhcn:665c97f0bafab371e6cfa21d",
      "kind": "text_data",
      "source_text": "用河水清洗也依然丝滑柔顺，能梳理得整齐美观",
      "source_fingerprint": "53e5602a7f51d466de14dde56d81d174d0ad524f9d3753ebf3ac32deafd7e5b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1112"
      ]
    },
    {
      "uid": "zhcn:07ff1c707840d6b0fab516ed",
      "kind": "text_data",
      "source_text": "睡觉时会变得很狂暴有点吓人",
      "source_fingerprint": "fbadd49c7b82209b551e5636c79231965be72f870cc78926d0d8f11875e67004",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1113"
      ]
    },
    {
      "uid": "zhcn:d9fef30ef951d2153b3f96fc",
      "kind": "text_data",
      "source_text": "会向着同行者那边微微靠过去",
      "source_fingerprint": "f8c26002aef49317962478a64d9b4f4dbcd342d9cbce820e2baaa20ef9513717",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1114"
      ]
    },
    {
      "uid": "zhcn:090b0d24d49c6b27f83921d6",
      "kind": "text_data",
      "source_text": "常常被姐姐照顾得很完美",
      "source_fingerprint": "9781b5dc79f093acf34364242c7e710ae6722d9107cd0fdb595c96ccd0ff0208",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1115"
      ]
    },
    {
      "uid": "zhcn:ac8179b56ffa8552030013ad",
      "kind": "text_data",
      "source_text": "就寝时使用有针织花边的尾巴套",
      "source_fingerprint": "c362b22cb9fecbc53eb1849855ac002f9b1019cf268cf58ba71e7fcde6935113",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1116"
      ]
    },
    {
      "uid": "zhcn:0c5f37566e874e06f802db72",
      "kind": "text_data",
      "source_text": "虽然会有些不知所措，但并不讨厌被摸",
      "source_fingerprint": "298f211d68d5938af541acf0eda9875b96489a703dc47bda5f276f91b51aa794",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1117"
      ]
    },
    {
      "uid": "zhcn:d0b62fa28d268b35a375cd62",
      "kind": "text_data",
      "source_text": "修剪手艺达到了专业级别",
      "source_fingerprint": "00ae7e28f7cdffc309250a12740a2bc2b7b5a4a5ee193b768490ee1d48d4ecaa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1118"
      ]
    },
    {
      "uid": "zhcn:bf2c82e46d7a15f3e460fb99",
      "kind": "text_data",
      "source_text": "不能摸",
      "source_fingerprint": "aeea9480fd49c7be607fd42f54ab291bdb4dde0b6e1b22b4e607a82d9596bbb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1119"
      ]
    },
    {
      "uid": "zhcn:58deea7144ef86d53dbb2f1e",
      "kind": "text_data",
      "source_text": "保养时要用尺子确保完全笔直",
      "source_fingerprint": "22da2ededef26048d11db3cbcfdf5a4b7bfd4fa64c21244ffcf9d3bfc96e7895",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1120"
      ]
    },
    {
      "uid": "zhcn:8df68acfbb8cad484f270961",
      "kind": "text_data",
      "source_text": "正在认真思考能否当作武器使用",
      "source_fingerprint": "35ecde72162605fcde576f46c891d2c5e9abfbb71b79ccce7a8a3bec0ceefeb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1121"
      ]
    },
    {
      "uid": "zhcn:066b58653d4d0e77d2972df9",
      "kind": "text_data",
      "source_text": "喜欢用粉彩色配饰来打扮",
      "source_fingerprint": "47cd67a2e12d9bf31bdcc6314db56f8fc180d5cf83d7dfad7142bfdcc28e7ffa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1124"
      ]
    },
    {
      "uid": "zhcn:e14a1b56b9b7eafc81bf895d",
      "kind": "text_data",
      "source_text": "在BOSS（训练员）面前会摇个不停",
      "source_fingerprint": "983801ce4053dccf8f7a9f3dc1501b16b73ba5255912adb26a6bf9f01126f8a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1127"
      ]
    },
    {
      "uid": "zhcn:1347e350821decd08e9d5d38",
      "kind": "text_data",
      "source_text": "做瑜伽的时候会打结",
      "source_fingerprint": "4e9ee432f77bcf528ae5394a9976437dce7d2ed3691a833cfe0b1b02c99164a2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1129"
      ]
    },
    {
      "uid": "zhcn:7bc5810d04e04bb64b8a3fec",
      "kind": "text_data",
      "source_text": "尽量每天都用山茶花油进行护理",
      "source_fingerprint": "f263d57d566fd6263e8d8b6295745f1402364532c19c35240c62219443c436b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1130"
      ]
    },
    {
      "uid": "zhcn:75422f8b7c46dfa8f45bb93f",
      "kind": "text_data",
      "source_text": "睡觉前会用红丝带把毛发扎起来",
      "source_fingerprint": "8a53f302c2b07555ba40b40ab4b5366c0be1fe5a12ac360c6ebc7db78cd65eb6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1131"
      ]
    },
    {
      "uid": "zhcn:1845e3feba2aef00dad6475e",
      "kind": "text_data",
      "source_text": "会用来吸引猫的注意，防止其闯入直播",
      "source_fingerprint": "0eb5ebdf857d4153b10f3a72b082bfa2d9f7d2d52cedaacd515c4b2dce6efeaf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1132"
      ]
    },
    {
      "uid": "zhcn:dd69e5fac605bce1fad4d784",
      "kind": "text_data",
      "source_text": "开场号响起时会跟着节奏摇摆",
      "source_fingerprint": "0ab42f212eaf1443751597e8506062cff2c1a327720090deed00cce25978c09f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1133"
      ]
    },
    {
      "uid": "zhcn:1131f3ea2d8c59de728990ff",
      "kind": "text_data",
      "source_text": "容易与身边人的动作同步",
      "source_fingerprint": "b22939d505ce8e94b9cb392532f8fb82e1b2213871692a6dc4a2cea7594c5d79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1134"
      ]
    },
    {
      "uid": "zhcn:edb878ccff3fe92945c15278",
      "kind": "text_data",
      "source_text": "无论何种环境都能保持柔顺飘逸",
      "source_fingerprint": "e28f8d48ede00e725fdc94f84c083c3bdc1d3855e28f73858e812a634d135b0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1135"
      ]
    },
    {
      "uid": "zhcn:3723651def00e10bd96534a7",
      "kind": "text_data",
      "source_text": "即使在冬天，也会用冷水洗净",
      "source_fingerprint": "a78acb8b95b2dabbef47decc5dff912d9855dd80e8461e22ebcbba262dbf1809",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1136"
      ]
    },
    {
      "uid": "zhcn:c847b6dd40f6419488ee8dda",
      "kind": "text_data",
      "source_text": "在画原稿的时候，会在无意识中碰到",
      "source_fingerprint": "999f797f720e38056de3a9f360fbfa33cba9fb1b25a222bb05c7a75ff2a86267",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1137"
      ]
    },
    {
      "uid": "zhcn:23be2f26e0fd2d7e959f8c15",
      "kind": "text_data",
      "source_text": "使用和西沙里奥同款的海洋深层水洗发水",
      "source_fingerprint": "f1890cb7aa653ab0d124e9893faa15fb7eab59cdeb9031bfa41084330d98e48a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1141"
      ]
    },
    {
      "uid": "zhcn:8617096961bb0f4c30f51652",
      "kind": "text_data",
      "source_text": "扎起来时使用的发圈上带有绿松石",
      "source_fingerprint": "9861315307d6e70c5aab906dd59e99749dbbe0b43e46a4a1e650551257ab68a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1143"
      ]
    }
  ]
}
