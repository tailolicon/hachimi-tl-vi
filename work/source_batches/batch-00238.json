    },
    {
      "uid": "zhcn:0910b7f656376f37265ef3d2",
      "kind": "text_data",
      "source_text": "中等部",
      "source_fingerprint": "6a31cf361effb3de279e8bd44c30bd8d3e366301eaa11471f639b58b0a5ce39b",
