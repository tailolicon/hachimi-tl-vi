      ]
    },
    {
      "uid": "zhcn:81714efbe11464c039623959",
      "kind": "text_data",
      "source_text": "对视游戏、独自旅行、『投降』",
      "source_fingerprint": "60f6a76b7dc67d991836aa1c07d0f276be844e2a411dd9266e500b4e76e6af9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1121"
      ]
    },
    {
      "uid": "zhcn:4f712b5ea4e05b20ed7ca863",
      "kind": "text_data",
      "source_text": "仓鼠",
      "source_fingerprint": "cdee70afa8c278fdfc43d27bc443336d2fd2bccd90848cfd973c1f3156aa0bfa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1124"
      ]
    },
    {
      "uid": "zhcn:ea44c5682b2bf65d45957953",
      "kind": "text_data",
      "source_text": "发蜡、薄荷糖",
      "source_fingerprint": "0a94f07deba88ea197964ab3aa2120c752715ae2db80cbf8c6d29e441f7aadac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1127"
      ]
    },
    {
      "uid": "zhcn:c6e79b1e00971658d6ddf3a2",
      "kind": "text_data",
      "source_text": "换衣服、桑拿",
      "source_fingerprint": "f50682da6363d32f6fdf344bfde004f3093504cc5b1235d2b589ffa2c1e7154b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1129"
      ]
    },
    {
      "uid": "zhcn:6657f50f0a306490d353fc2a",
      "kind": "text_data",
      "source_text": "蛞蝓、废墟、细思极恐类的怪谈",
      "source_fingerprint": "078dcfe040f9772ca58e0311c5182e452144caadbb04353e9d479a6c2ab0f016",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1130"
      ]
    },
    {
      "uid": "zhcn:9522989f4353f6b51cd027cf",
      "kind": "text_data",
      "source_text": "深海鱼、安静的地方、捉迷藏",
      "source_fingerprint": "810d58f3423d968a5b0ff68385816cefa58031f8009f8bf265c6b464af72ea0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1131"
      ]
    },
    {
      "uid": "zhcn:eed2f603a7b7b180c552306b",
      "kind": "text_data",
      "source_text": "画画、恐怖游戏、无所事事的休息日",
      "source_fingerprint": "24a75c1d7b103ef5811d527855a60f26a04785bec81c516f3e7066f9e468198f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1132"
      ]
    },
    {
      "uid": "zhcn:a8660e4944e0c7a56ef23f1f",
      "kind": "text_data",
      "source_text": "过度的湿气",
      "source_fingerprint": "9ad70d4d997f90be8743d1b27767ee0c59c2e3051576deff55fd4cd528c6ed0b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1133"
      ]
    },
    {
      "uid": "zhcn:a2afea54b3c4961ae3dec7e8",
      "kind": "text_data",
      "source_text": "脆脆的薯片，嗥叫",
      "source_fingerprint": "9e7f2b9e46c4fa21cfaf9a712ad007426d81f4fc9699ed77b0b8943c4efdc279",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1134"
      ]
    },
    {
      "uid": "zhcn:71f4cd5f8cb24963167adb9a",
      "kind": "text_data",
      "source_text": "健康检查",
      "source_fingerprint": "da7d17db5d64be3c55cda118da4f68972d067cdfa7d2eff8935d4b26c36799d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1135"
      ]
    },
    {
      "uid": "zhcn:71cf9d65f1537526ec9ac5b5",
      "kind": "text_data",
      "source_text": "粗糙的纸巾",
      "source_fingerprint": "65f85a6f3d975cbc72d7a5126bc9b8b7576650581a6d86c3cacf7f3b122069d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1136"
      ]
    },
    {
      "uid": "zhcn:f1da3538c540f6ad822b800e",
      "kind": "text_data",
      "source_text": "等待结果发表、节奏游戏",
      "source_fingerprint": "10207d36ecf5a8c1824b56ad729652c988d7100a7ecceff4e1dd9c04874efeab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1137"
      ]
    },
    {
      "uid": "zhcn:c621fb84114b7452bfb298d8",
      "kind": "text_data",
      "source_text": "绕口令、系鞋带",
      "source_fingerprint": "d308fb76d99d9df63e007c9c2a3e93e9e12fd46a3dfdd34d75601f3630259dbf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1141"
      ]
    },
    {
      "uid": "zhcn:1fbdb6d41f8ec0cfe20a1f8a",
      "kind": "text_data",
      "source_text": "解智力扣",
      "source_fingerprint": "1124b1c9f967f611e074e991da5113c4071d683437b1037440ec83fa7b3376b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1143"
      ]
    },
    {
      "uid": "zhcn:b79acd5d3e2da31649a107a1",
      "kind": "text_data",
      "source_text": "猫、拥挤的人群、飞虫",
      "source_fingerprint": "4cc92ace1ef98c6c3cbcaf9b62d5f8e3225a59ac210cc020cbd40e0333708f27",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1145"
      ]
    },
    {
      "uid": "zhcn:009d98bf31f8842ef72c887d",
      "kind": "text_data",
      "source_text": "密室",
      "source_fingerprint": "06472bd026dcfd10a9849b2d958b8d8642862c8997ddac2c8313200c8111b8f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "165",
        "1149"
      ]
    },
    {
      "uid": "zhcn:f13ad39b3894371748794dda",
      "kind": "text_data",
      "source_text": "对做料理的声音很敏感，稍不注意就会专注地听",
      "source_fingerprint": "a5ffe9b9db8fff1dd4cb4796341a1fd72cbce3ba924b982ae9566cf0e8188a85",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1001"
      ]
    },
    {
      "uid": "zhcn:6587c9d83a17b8cbe316d0ae",
      "kind": "text_data",
      "source_text": "在想跑步的事的时候，偶尔不会留意其他声音",
      "source_fingerprint": "7fafc623fba12c52cc05b49a172333990dbf5b5aa660915dc5978370504f0cd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1002"
      ]
    },
    {
      "uid": "zhcn:345e9af01d415bfe2d8b905d",
      "kind": "text_data",
      "source_text": "不会漏听赞赏和会长的声音",
      "source_fingerprint": "70cc237eaba86cd3b803a9642b24ba182f31e2ab2d0b2f968c7bb567a6243bdd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1003"
      ]
    },
    {
      "uid": "zhcn:c5626dac7ca41aba8d4f472d",
      "kind": "text_data",
      "source_text": "听到欧洲节拍的话就会想飞奔起来",
      "source_fingerprint": "7b9cf7726f762ff1a63f5eb388ce07085e5c3cf255537a96c9ad9e1f66872c81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1004"
      ]
    },
    {
      "uid": "zhcn:47e4d01bcfaec25b8956961f",
      "kind": "text_data",
      "source_text": "有着绝对音感",
      "source_fingerprint": "8c6d5ca35a58168c156e581f7732d614dda70fdce77b3c660f65033c8fd58466",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1005"
      ]
    },
    {
      "uid": "zhcn:a27a4fea620531a0489cf4de",
      "kind": "text_data",
      "source_text": "能在全场的欢呼声中分辨认出家乡的人",
      "source_fingerprint": "ebf3e4cb2e33c06f9d0392956a3372f779ca36009cbebf00c0e6d89b64519d7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1006"
      ]
    },
    {
      "uid": "zhcn:94258bc945409aec0d3aa6db",
      "kind": "text_data",
      "source_text": "会突然捂住别人的耳朵然后问“我是谁～？”",
      "source_fingerprint": "300c7923030efb6b6d4742bf1f0bff142388553980d488c06393276bbb663ff5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1007"
      ]
    },
    {
      "uid": "zhcn:91b1c83048524b09c48fed7c",
      "kind": "text_data",
      "source_text": "碰到的话就会异常害羞",
      "source_fingerprint": "011dfe3d26784ce49870539e143f52c0400a222f32a88041f7b8331692100ab2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1008"
      ]
    },
    {
      "uid": "zhcn:408847ba1a67be7294f25bf5",
      "kind": "text_data",
      "source_text": "会无意间暴露心里话",
      "source_fingerprint": "fbcd4ba7dc889b91302be2d1b2703c5148747365ff86add5b743545b9068feb6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1009"
      ]
    },
    {
      "uid": "zhcn:ac8110a70c9845d80a5cdeb3",
      "kind": "text_data",
      "source_text": "听到有派对的话不管身处何处都会赶到现场",
      "source_fingerprint": "2ebad4510c7b08be43353cca3c9f6f96df83ea670c51fdd30e341d8e50e5ef64",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1010"
      ]
    },
    {
      "uid": "zhcn:ba98d749ecb563e18562c2c9",
      "kind": "text_data",
      "source_text": "沏抹茶时连耳朵都纹丝不动",
      "source_fingerprint": "89e9b31a7631af9576e1570dcde8f6e4b31088686fc0b1843f3edc7b60b53ecb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1011"
      ]
    },
    {
      "uid": "zhcn:8c1e9c043244ae90e5f95bcc",
      "kind": "text_data",
      "source_text": "对“单挑”一词十分敏感",
      "source_fingerprint": "7c208d69dbeb0ab94e4fcbc48a14754dab74cc9fc27dbb694fb0cbc19f4c889f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1012"
      ]
    },
    {
      "uid": "zhcn:5c290b6976652e679882059e",
      "kind": "text_data",
      "source_text": "在他人面前耳朵常常高高立起",
      "source_fingerprint": "dfe9adb0f7c2333d2ade103475549e67467a2c7886abe965768b1db8e61a5eb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1013"
      ]
    },
    {
      "uid": "zhcn:6525eb2112bdee59b4ee2292",
      "kind": "text_data",
      "source_text": "听到读秒声身体就做好了准备",
      "source_fingerprint": "f70f7928ad45b1cd3d0e065a362b2932d1b4d62b66c3085298d5f95617f91c4f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1014"
      ]
    },
    {
      "uid": "zhcn:ad729c7cad6cdb7396201f90",
      "kind": "text_data",
      "source_text": "无论什么话在耳中都是赞美",
      "source_fingerprint": "5f881cbb3d6e85b6cbf03424d937f80090ff47658273d12df1e03e21f27c2d93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1015"
      ]
    },
    {
      "uid": "zhcn:a320c8ec87f8a19ecbd61492",
      "kind": "text_data",
      "source_text": "听到比赛前的号角声就会热血沸腾",
      "source_fingerprint": "8ee5bfa69d2edbdea1ef1b4ef02d39f98c1f960f232df04d129e95342005c4bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1016"
      ]
    },
    {
      "uid": "zhcn:74d348844ea81fd0e7903f98",
      "kind": "text_data",
      "source_text": "在想到冷笑话时，会“噗嗤”的大幅移动",
      "source_fingerprint": "114bd11d2765a2aa09a9c9715eba8eca48da1b2f5dc35335bb7729d37b3b5783",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1017"
      ]
    },
    {
      "uid": "zhcn:1a7f9c5535c9b423689bffc6",
      "kind": "text_data",
      "source_text": "照料花朵时会温柔地微微下垂",
      "source_fingerprint": "4b19533f0838598845a896c59546ae839a1403808bbd37be4784962500057022",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1018"
      ]
    },
    {
      "uid": "zhcn:d44a788c50a8cb676cfb3378",
      "kind": "text_data",
      "source_text": "耳朵捕捉到萌波动时就会毛发皆竖",
      "source_fingerprint": "3e303159a2ba5b0dfb972e5b256dcf4496126e698d06db019e5df472da91ea5d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1019"
      ]
    },
    {
      "uid": "zhcn:6e7a8d8156d5db2417b9c2bc",
      "kind": "text_data",
      "source_text": "有时，耳朵会意味深长地竖立起来",
      "source_fingerprint": "7dc0926fcc65e0098812a8ef1e483ece1dfbef80769b29dcf5a3ba1e46884b53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1020"
      ]
    },
    {
      "uid": "zhcn:ec00b0882ed5c1d2379cac9e",
      "kind": "text_data",
      "source_text": "一听到“大减价”、“大甩卖”之类的词就会突然立起",
      "source_fingerprint": "484269d07efdd882b3544a8ff5990acd62666c5af1b4133c33eaa46e3f5a44ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1021"
      ]
    },
    {
      "uid": "zhcn:b7a81693d4300b89b7211ed4",
      "kind": "text_data",
      "source_text": "对庶民文化的话题十分感兴趣",
      "source_fingerprint": "06def5070a429bfa9477107ab1863957b5d43f3610d0c761e133e247274c528f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1022"
      ]
    },
    {
      "uid": "zhcn:efa5fa1924e4b332899fc17c",
      "kind": "text_data",
      "source_text": "小时候就对声音十分敏感，经常被吓到",
      "source_fingerprint": "453e90fcb6db6dc2e3c78c59852a047b97c8b20f734bc93afb9de3aa12a35ad9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1023"
      ]
    },
    {
      "uid": "zhcn:6a372ba9dba7c4a21ce579f5",
      "kind": "text_data",
      "source_text": "非常擅长塞住耳朵",
      "source_fingerprint": "d835b9c6c31b74f99d8bb3c4fd6379cb434efb964ac3b648ce4200ad5ebac6fb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1024"
      ]
    },
    {
      "uid": "zhcn:5eee54bf2ff4ffad71b85ff5",
      "kind": "text_data",
      "source_text": "好像能听到只有自己才听得到的声音",
      "source_fingerprint": "b5b339dd83bd40ce9c0a848a50f16780ae7af197c7b9585e9c9106e03a1a692a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1025"
      ]
    },
    {
      "uid": "zhcn:e63fcadcd733fe1572f48632",
      "kind": "text_data",
      "source_text": "即使睡着了，一听到命令就会立刻起来",
      "source_fingerprint": "dec9704fbf6c4c0160665def4aa77e6b7831aad98faab99fbbacd11e858b9093",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1026"
      ]
    },
    {
      "uid": "zhcn:e2615c1e1df700c7526acc22",
      "kind": "text_data",
      "source_text": "阅读少女漫画时会动个不停",
      "source_fingerprint": "d72db7098bea38691550f9a3660b7ea27d618c1472111d0eaca527030abefb32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1027"
      ]
    },
    {
      "uid": "zhcn:b6378e0871900de00f21a271",
      "kind": "text_data",
      "source_text": "无论多么微弱的肚子饿的咕噜声都不会听漏",
      "source_fingerprint": "45d983592405daf84ddfb3cfcf5402c227df44d747b49ff23eecafc2eb12a3cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1028"
      ]
    },
    {
      "uid": "zhcn:cf1c9c2173eeb6ca1b5d0275",
      "kind": "text_data",
      "source_text": "有很多可爱的耳罩",
      "source_fingerprint": "39187f2943dc2d32105bc1e44a46650794f5d16246d381699e0d9e2db09c7cd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1029"
      ]
    },
    {
      "uid": "zhcn:24db5d531e18a9680ca860e8",
      "kind": "text_data",
      "source_text": "听到关于他人的不幸的话题耳朵就会无力的垂下",
      "source_fingerprint": "2b83003e43fed45bd7ec595bbfc0bfee64d9d0984c11baa50e3f1da1c41f7454",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1030"
      ]
    },
    {
      "uid": "zhcn:3d28e58921a0eed02cd1b4f4",
      "kind": "text_data",
      "source_text": "会不由自主地对小孩子的声音起反应",
      "source_fingerprint": "86c42739f036c1f1ab2e678e47f0befc135e4bf37b765a571a045c7c6b84c90c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1031"
      ]
    },
    {
      "uid": "zhcn:3e6a04f5746ccd44d66d878d",
      "kind": "text_data",
      "source_text": "坚决不让碰耳朵和额头",
      "source_fingerprint": "6ae555a9bc7a6571ce8ab550d6c659320ff24d839f178e5b83c3f66d846e1ac2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1032"
      ]
    },
    {
      "uid": "zhcn:705c08efb37d9cf91f45d340",
      "kind": "text_data",
      "source_text": "听到“姐姐”的叫声的话会无意识地抖动",
      "source_fingerprint": "d52b155150da18e7603adb101f1b89fe1715a733ec022732b10e85ae2f0e9040",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1033"
      ]
    },
    {
      "uid": "zhcn:7ca64030699165e25e01a498",
      "kind": "text_data",
      "source_text": "一听到庆典伴奏的声音，就会如起舞一般动起来",
      "source_fingerprint": "984f24f345cd53245dc4db5589669e73c6d4828bdba7fb69c77eafa8d21bb9b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1034"
      ]
    },
    {
      "uid": "zhcn:239a2fc46c4111f9d5d8ea2c",
      "kind": "text_data",
      "source_text": "挚友表示“就连耳朵也动的好烦人”",
      "source_fingerprint": "1cb670df5bed3b8f6a0335aec6c294cfd70821229597e2e1dfc9b50f96615d67",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1035"
      ]
    },
    {
      "uid": "zhcn:8d075c0d16b9bd487004204a",
      "kind": "text_data",
      "source_text": "进行逻辑思考时会直直地站着",
      "source_fingerprint": "caeb23c9ee6f3050ddfe3ea11d3803944e19db65422e8708b753820a10d191d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1036"
      ]
    },
    {
      "uid": "zhcn:a86565aef806cf68bc9f7cae",
      "kind": "text_data",
      "source_text": "听到节拍器的声音的话会被治愈",
      "source_fingerprint": "d5d0b5ef7870f613f808ea51932e697bc5f1b552eedb4fb2dfeba67b64b3ef39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1037"
      ]
    },
    {
      "uid": "zhcn:f0b251296b559f0de9c8e7bf",
      "kind": "text_data",
      "source_text": "想撒娇时，耳朵会像招手般摇动",
      "source_fingerprint": "7112361bead12af397eec77b019bb2d899c6d94614c5b39202317a2ee81b4f22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1038"
      ]
    },
    {
      "uid": "zhcn:efb71d1d73f5704bec15faec",
      "kind": "text_data",
      "source_text": "自认为拥有在赛马娘中最适合皇冠的耳朵",
      "source_fingerprint": "ead5a51e33acb7818cf569de7ddc92480e1aa5ce2014acacef258331138ef77a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1039"
      ]
    },
    {
      "uid": "zhcn:a5b0d31908648b1a677ad207",
      "kind": "text_data",
      "source_text": "想要赢过闹钟继续睡",
      "source_fingerprint": "ba98779f47b2b22b33257bdcba9c1a481fd3375d3fbff48c5eb7fa259ae63c3c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1040"
      ]
    },
    {
      "uid": "zhcn:d84993714d72102de71989f5",
      "kind": "text_data",
      "source_text": "他人的话只能听进去一半",
      "source_fingerprint": "84f185e5a3375d3693fc2b2e632a77abc280b63128817f184fa81bdb28fbf4b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1041"
      ]
    },
    {
      "uid": "zhcn:03e9955cad53a75d30b43375",
      "kind": "text_data",
      "source_text": "能用感觉来理解各种语言的意思",
      "source_fingerprint": "c7e483143f2ecc7c4913f2d90be94163b4029413b7574a48e08776279dfdcabd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1042"
      ]
    },
    {
      "uid": "zhcn:fa4aa1882489a934cea71f1a",
      "kind": "text_data",
      "source_text": "想出新的恶作剧方式时会浑身发抖",
      "source_fingerprint": "308a57e89c018c382e44ed0cbad454b146a1de6524793de84438ed002efc11c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1043"
      ]
    },
    {
      "uid": "zhcn:eeb62fe10597ffc91b5bf576",
      "kind": "text_data",
      "source_text": "不认识的单词听起来全都像咒语",
      "source_fingerprint": "de2d2b99956191fc3de9cea05ab63a2845bae8bb74ad9c119e9e766ba64e099d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1044"
      ]
    },
    {
      "uid": "zhcn:a1702dcd4399d25e8cf1e867",
      "kind": "text_data",
      "source_text": "擅长掏耳朵，但不擅长被掏耳朵",
      "source_fingerprint": "3a9dc5389ff994cf9f6458fa949854f8e4b60174b4594a269855bbe50bb05790",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1045"
      ]
    },
    {
      "uid": "zhcn:cf7804ad667b81ba623c39b5",
      "kind": "text_data",
      "source_text": "不会漏听任何一位粉丝的声音",
      "source_fingerprint": "0986a7ed33dd3c34f548b7b6a27b03a60d593dcd4f79f2cd45622e833febc2fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1046"
      ]
    },
    {
      "uid": "zhcn:5960f3957e3ca9612df8c918",
      "kind": "text_data",
      "source_text": "一到故事的高潮部分就立马朝后翻",
      "source_fingerprint": "8c31805723ef02870b7fcd7d6af0dde2ff13a0b622472738d1df36b7a7e2f9f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1047"
      ]
    },
    {
      "uid": "zhcn:e217558c1df9a76ca3477269",
      "kind": "text_data",
      "source_text": "希望能流行叠起双耳的拍照方式",
      "source_fingerprint": "cbf2f1495c24c1e4b2880d56c5bb3daaa038aa080f5da3f00c789be1e89ebc8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1048"
      ]
    },
    {
      "uid": "zhcn:1bf864121fc21bc79531a6c3",
      "kind": "text_data",
      "source_text": "帽子上伸出耳朵的洞是自己剪开缝制的",
      "source_fingerprint": "952eebd08007388c41140a9314f8cfc8d39ec9e1b5b4808f6f40a78bad10e690",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1049"
      ]
    },
    {
      "uid": "zhcn:1df0b35ef8df2eda3f059ad9",
      "kind": "text_data",
      "source_text": "就算听到感兴趣的话题也只有耳朵会转向这边",
      "source_fingerprint": "a576971d0099eecf9dee4ffe959757f93b9e982714fe20464f6f66b0a00bff99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1050"
      ]
    },
    {
      "uid": "zhcn:9a65d5f816f6496b020bb114",
      "kind": "text_data",
      "source_text": "触摸的话就会被安心感所包裹，因为十分治愈而饱受好评",
      "source_fingerprint": "7f0887d7f3c06d435a015a7bbd33480ba396533740287291857799689342bd6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1051"
      ]
    },
    {
      "uid": "zhcn:572b47723c594306101f4e25",
      "kind": "text_data",
      "source_text": "很难懂的话就会右耳进左耳出",
      "source_fingerprint": "9db5ca00fd1d9741504daddb30e8fc645d07df4ef1634f9ac76252e783c76095",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1052"
      ]
    },
    {
      "uid": "zhcn:d9f07063e71bd6d923ee7c83",
      "kind": "text_data",
      "source_text": "一摘下头带就会垂下来",
      "source_fingerprint": "24bb84a340d8e6a4d39333e01a39cc87df748234990650d1a30c1bc7af11ba79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1053"
      ]
    },
    {
      "uid": "zhcn:dad19d0657e571c0ffcd9a1a",
      "kind": "text_data",
      "source_text": "随时响应求助声",
      "source_fingerprint": "a9ea50b23b991fa7534fe3ac1724cc510d72bebd523cdbeef7a0bd902bf4cfcc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1054"
      ]
    },
    {
      "uid": "zhcn:8cc29e95277b31eae60b1e62",
      "kind": "text_data",
      "source_text": "能分辨出Marvelous的声音",
      "source_fingerprint": "22b5360d4c76142a168a35d75ea95c68482f3aed8dec3fe9cb0a52cf7f05c73a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1055"
      ]
    },
    {
      "uid": "zhcn:168cda1d73f2a2b99d7c1df5",
      "kind": "text_data",
      "source_text": "偶尔用于占卜方位",
      "source_fingerprint": "9271b35252c06920edc09e7b602528bad8762641f293b8ef4340752411883a56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1056"
      ]
    },
    {
      "uid": "zhcn:55402f7dab4ca70e4238a3e6",
      "kind": "text_data",
      "source_text": "能够用脚摸到耳朵",
      "source_fingerprint": "0f53493f0c088121951815e0445c6b341558d8d8be033a9190c182ee6abd65d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1057"
      ]
    },
    {
      "uid": "zhcn:a0228fbfb083e403cee9dc06",
      "kind": "text_data",
      "source_text": "经常微微颤抖",
      "source_fingerprint": "6eaba460885b9be5ff7ac4375245a2ae1dccbd8a4c3d283f6c89372fad42f83a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1058"
      ]
    },
    {
      "uid": "zhcn:522131dca7b8ec38d2fb6acb",
      "kind": "text_data",
      "source_text": "一听到男性的声音就会愣住",
      "source_fingerprint": "6538d54894ac6d65caf0e1241ea1bb4bd0ee19276573e3b33ca5422f3ca269b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1059"
      ]
    },
    {
      "uid": "zhcn:d3bfe745b633845a94c4b9d9",
      "kind": "text_data",
      "source_text": "一听到“内酱”的称呼身体就会不自觉地起反应",
      "source_fingerprint": "350ac476f06b456990cae79e7f68cca0dc712ac53ce1d601c91563842f8f83dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "166",
        "1060"
      ]
    }
  ]
}
