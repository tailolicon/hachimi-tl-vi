{
  "schema_version": 1,
  "batch": 242,
  "batch_count": 1674,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "c0843a2d48250bf43b290794d39bc866bb741857",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:2d997b6be34934301d43e924",
      "kind": "text_data",
      "source_text": "有时候会忘在宿舍（本人表示）",
      "source_fingerprint": "3ef63f23c91adf5d670220f8b101e5e221a3c89bfe492831614f3802b9ce3878",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1007"
      ]
    },
    {
      "uid": "zhcn:6ae5a4ba0db488d36dd12a17",
      "kind": "text_data",
      "source_text": "练习着帅气晃动尾巴的方法",
      "source_fingerprint": "5432a9fb1a22f11e65ac95c832c101fbbc7f75262853e4b251a8629ca1df7c50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1008"
      ]
    },
    {
      "uid": "zhcn:df46a572f41e638ce2b3b1f2",
      "kind": "text_data",
      "source_text": "每天早上都为了能够梳好尾巴而战斗着",
      "source_fingerprint": "9f61d63651a0dcb257bba35bca2be25b6d3ffc4b11f3cea70494874006fba848",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1009"
      ]
    },
    {
      "uid": "zhcn:0639e0bde0938d134f6f18de",
      "kind": "text_data",
      "source_text": "顺毛喷雾与生活费一同收到",
      "source_fingerprint": "15c57aa5d4734c8ddace4edf6057660ea8c148fa05ac7c7a6a755374513c972f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1010"
      ]
    },
    {
      "uid": "zhcn:38e1e864a39ebeffae4c2c65",
      "kind": "text_data",
      "source_text": "不用回头就可以将身后的虫子扫落",
      "source_fingerprint": "59e24ce208b134b0bc0c6dfc70c075d7dee19ea610ebf1f8d5826de26efdc54a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1011"
      ]
    },
    {
      "uid": "zhcn:e9140992c32245cdcdf493c5",
      "kind": "text_data",
      "source_text": "许多学生憧憬着那抹艳黑色的尾巴",
      "source_fingerprint": "07be3b873d024bb9ce660e9a8b7031fa544d5307a868e63d2c30e077c0d9ff90",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1012"
      ]
    },
    {
      "uid": "zhcn:caa01ed27b9324484ffa3b7f",
      "kind": "text_data",
      "source_text": "提到运动话题的话尾巴会摇晃的很激烈",
      "source_fingerprint": "92a6776e27e94839f6897fa2067ca29677667448dfc8c51a168fad5077e86951",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1013"
      ]
    },
    {
      "uid": "zhcn:4f18436f24be2e14c368e2f9",
      "kind": "text_data",
      "source_text": "抓尾巴似乎是犯规行为",
      "source_fingerprint": "4bb964304cb7455bf2891d01d457147e23e1c77c8f7c7ade93aa6b3914d07349",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1014"
      ]
    },
    {
      "uid": "zhcn:5ec38bae7c602c395b5463ea",
      "kind": "text_data",
      "source_text": "被光照射的话就会熠熠生辉",
      "source_fingerprint": "31f6db3cd95a6e174151810ccfe55c5ef5e2904a94e02862b699d38d8bce8642",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1015"
      ]
    },
    {
      "uid": "zhcn:def577458db2e4eae2801c05",
      "kind": "text_data",
      "source_text": "既不在意也不保养",
      "source_fingerprint": "b2f696408a16cc0ad68fed101dcd82415ae9aeafb07bb266d39919b8a1aee029",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1016"
      ]
    },
    {
      "uid": "zhcn:d0faa225d82789d150784c28",
      "kind": "text_data",
      "source_text": "在发表演讲时每一根毛都充满着魄力",
      "source_fingerprint": "ee423b367fedf821410d5ae2eec83a96bea218749a456766d0073cc8371e81d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1017"
      ]
    },
    {
      "uid": "zhcn:07a0c834f9642ef8e50ed305",
      "kind": "text_data",
      "source_text": "使用着与母亲相同的尾部护理油",
      "source_fingerprint": "3b1d6ef2e0d03e82ea697011016efa42ef06c9165411a97b478353aba80a117c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1018"
      ]
    },
    {
      "uid": "zhcn:3961ea21638a6b8c8f32c5fb",
      "kind": "text_data",
      "source_text": "在Live前会去理发店梳理尾巴",
      "source_fingerprint": "28ef9180b384832677aa2acf3fad1b70f851d7f0900619ce50d0e7ed85afe530",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1019"
      ]
    },
    {
      "uid": "zhcn:2bcba0ba11b16aa64d95b382",
      "kind": "text_data",
      "source_text": "就算不梳理也会自然而然的顺直",
      "source_fingerprint": "bc5e00eef5a946f56e5a79dded0824a03dc0526c6585f5ed4b7f7e52c8c7d246",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1020"
      ]
    },
    {
      "uid": "zhcn:142ca45bf972231cddf2c016",
      "kind": "text_data",
      "source_text": "生气了的话，就会像闪电一般抖动",
      "source_fingerprint": "f0bc896ec4cd449d588ae6fd74fb387a0e58f86f1fc0f87b4c083fb55efaddd8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1021"
      ]
    },
    {
      "uid": "zhcn:3552449a31be04765336cb49",
      "kind": "text_data",
      "source_text": "拥有着王族特有的发质。俗称“皇家·尾巴”",
      "source_fingerprint": "8aca9ebb3782b8b3c83717a76677b5f84c8a5e576bfb360b33fe0d3fac251f09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1022"
      ]
    },
    {
      "uid": "zhcn:1cbcc552408f458752abd61c",
      "kind": "text_data",
      "source_text": "倘若有湿气的话，会陷入将尾巴塞入衣服上的尾巴孔的苦战",
      "source_fingerprint": "1e0b5dc6e56bd69f0f49fe3391d58b8f0daac76fdd79645b95fbef662d640b4f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1023"
      ]
    },
    {
      "uid": "zhcn:6344cbd54e2c579bb1cfb5a8",
      "kind": "text_data",
      "source_text": "说谎时会摇的很厉害",
      "source_fingerprint": "6315a5c88671fb082b0fc08a7bd30fc494fb0e4d83a9dfe66b2dc387830db65b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1024"
      ]
    },
    {
      "uid": "zhcn:95234f3d7377e164bcbd9d29",
      "kind": "text_data",
      "source_text": "即使不做任何保养，尾巴也十分光亮润泽",
      "source_fingerprint": "5f0fcef7f09ceb24bf869f47d2741948784f0ae245c591b5681e53cda6624c2a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1025"
      ]
    },
    {
      "uid": "zhcn:4e9bab369ea906c1fcc44cd8",
      "kind": "text_data",
      "source_text": "有着能够依靠尾巴来支撑自己的力量……据说",
      "source_fingerprint": "f09b97728c3c3f3deaa47df12a4d523acec6dd53874cedfbbb8f20990ab3be3c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1026"
      ]
    },
    {
      "uid": "zhcn:4667035f1ed2886855e5a32a",
      "kind": "text_data",
      "source_text": "因为经常出汗所以常备尾巴用汗巾",
      "source_fingerprint": "85b56f83e2f8d6a3f532d4c3350cb631a4e77717fb28fb8c6410de7a8032682a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1027"
      ]
    },
    {
      "uid": "zhcn:efa096bb8947481ec94fe142",
      "kind": "text_data",
      "source_text": "打发时间的时候尾巴也会跟着一齐旋转",
      "source_fingerprint": "6c4b97970bea2b3a6d2a3fb9541e5f41ebc5e296a198880abb56970993a16959",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1028"
      ]
    },
    {
      "uid": "zhcn:681cdf8ebbf61c86e0a5e371",
      "kind": "text_data",
      "source_text": "正在挑战买到便宜实惠的尾部护理用品",
      "source_fingerprint": "b937de6dc37030ca040fc3fb0251489fd1d1e834c3d1b679798b7f7728d6d593",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1029"
      ]
    },
    {
      "uid": "zhcn:5abfc08716d18cdc7e8886dd",
      "kind": "text_data",
      "source_text": "为了不撞到他人而小心翼翼地注意着",
      "source_fingerprint": "9031724712c1d6f01c12315352ca1a191ed04191432226a82eb08a956965c444",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1030"
      ]
    },
    {
      "uid": "zhcn:49f851d88c5da64a3482c7e1",
      "kind": "text_data",
      "source_text": "习惯于被妹妹们捉弄、即使被突然抓住也不会被吓到",
      "source_fingerprint": "e440e8feaffefbb7836423960cbf4d6edceac78a15fd82332de503137d386745",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1031"
      ]
    },
    {
      "uid": "zhcn:f12ebc1808758a3cf060013a",
      "kind": "text_data",
      "source_text": "灵光一闪时就会毛发皆竖",
      "source_fingerprint": "f3c73b440c24f342f91a720e3e236d1001db5359fdb03a246d1aed2854678994",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1032"
      ]
    },
    {
      "uid": "zhcn:bffc6f19f9f899284a86c1dc",
      "kind": "text_data",
      "source_text": "在睡觉时有着会无意识抓住尾巴的习惯",
      "source_fingerprint": "623f9af4319d60f8a6d687cf82657a8bca1936ce0e77cafae246323ea6d0d989",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1033"
      ]
    },
    {
      "uid": "zhcn:cab586c46a85373a0bce1bd3",
      "kind": "text_data",
      "source_text": "有着盛夏之日也要洗热水澡的潇洒讲究",
      "source_fingerprint": "dcf3536f19e5e2b8e3b4c7009e3cf460af94d0472f7e72e64a684af1765c4fa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1034"
      ]
    },
    {
      "uid": "zhcn:46a8bc5b3452a23c8936bcf9",
      "kind": "text_data",
      "source_text": "有着可以看出喜怒哀乐的表现力",
      "source_fingerprint": "89d4f12398e1687649320493e883e5b979d1f9c0cb4a08de045c8976b768a4eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1035"
      ]
    },
    {
      "uid": "zhcn:6957d9fa58e2e722e558a883",
      "kind": "text_data",
      "source_text": "计算适合奔跑的长度和毛量，并维持中",
      "source_fingerprint": "2dbbfc93a5deb2aeff81a53d4f6ae1e74e38e0ec8fcd027430fdf6a8366c787a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1036"
      ]
    },
    {
      "uid": "zhcn:7114922c24ce885c81cd6497",
      "kind": "text_data",
      "source_text": "连0.1毫米的误差都无法接受，整齐的修剪好",
      "source_fingerprint": "469c8af7d9e9064af97470014ed30eee2d85a4d134e83de4186d9c6f081d7e91",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1037"
      ]
    },
    {
      "uid": "zhcn:fefac86515eeb15292357a84",
      "kind": "text_data",
      "source_text": "有着触摸的话就会被其俘获的柔软手感",
      "source_fingerprint": "4c84523278ba8398c7e9f2bd925acac49cdd4dc2811cb4e3807eb3bc1fd2aef1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1038"
      ]
    },
    {
      "uid": "zhcn:75874f21fdf723101767be06",
      "kind": "text_data",
      "source_text": "自称为“公主尾巴”",
      "source_fingerprint": "5e81304c1004efc84add28f1ab3c85f4081f3109d7d9616fd6285e5678150f5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1039"
      ]
    },
    {
      "uid": "zhcn:1c6aa330c7ff39a6ff8e9019",
      "kind": "text_data",
      "source_text": "被拍照片时尾巴会无意识地静止不动",
      "source_fingerprint": "170f709a3273858b43c140c8dfa06cba75b67ceee1422a74902936504ccaf41c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1040"
      ]
    },
    {
      "uid": "zhcn:e02b3ba4b0c40d046227d36e",
      "kind": "text_data",
      "source_text": "倘若爆进起来的话，连一根发梢都抓不住",
      "source_fingerprint": "0a5a317cf1569255887dbb7eba1cfdfb3c96018bc7305e948acd6c393efff5e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1041"
      ]
    },
    {
      "uid": "zhcn:d02590a7dc4903322aa14b23",
      "kind": "text_data",
      "source_text": "为了在海外表演而学习了用尾巴写字",
      "source_fingerprint": "9763de5d35c9198a0931e3fad9fcd3a3c400c85835a206fbb6d46a5206ea70d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1042"
      ]
    },
    {
      "uid": "zhcn:a54fe24f8fe6dbc74cd0b78a",
      "kind": "text_data",
      "source_text": "有时早上起来时会发现上面沾着口水",
      "source_fingerprint": "7966b1e1824af1890c2bde18f598c1df2414543f8958be9b8c132601ec9bb391",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1043"
      ]
    },
    {
      "uid": "zhcn:13acaf9e088938cb322e1ddd",
      "kind": "text_data",
      "source_text": "想驯服黑猫时，反被其当作玩具",
      "source_fingerprint": "ce24686a9eb64edcb78b6f5845f6855d18e9084fac06abef54dbdd31b1e8ca37",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1044"
      ]
    },
    {
      "uid": "zhcn:bed6dad724723d728d36f33b",
      "kind": "text_data",
      "source_text": "能够巧妙地哄小孩子",
      "source_fingerprint": "5301d6db5d32455faca442bdff8cbcbbe301d408166ba596dcd5f13d31574c89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1045"
      ]
    },
    {
      "uid": "zhcn:e9e540b93c6fd6dcb34df393",
      "kind": "text_data",
      "source_text": "为了不养成坏习惯，很注重坐姿",
      "source_fingerprint": "c877ea1521b1a9248db26238fe587948223827d72343564aa68264a91d1fe63e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1046"
      ]
    },
    {
      "uid": "zhcn:0346fcf9e0150f31a2ae9c77",
      "kind": "text_data",
      "source_text": "在人群中会紧张得纹丝不动",
      "source_fingerprint": "1dc0605d014f5676f02bb61773e1691c77edb8e7ec9007ea34b8e362887a07aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1047"
      ]
    },
    {
      "uid": "zhcn:67228253eb95f0488e844289",
      "kind": "text_data",
      "source_text": "因为笨拙而无法检查尾毛是否分叉，为此烦恼着",
      "source_fingerprint": "b21c204aa38179f5c47358d666753e134af7780b9489ada247e03852a87d49f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1048"
      ]
    },
    {
      "uid": "zhcn:d1352eb214ab0eefa189c3f0",
      "kind": "text_data",
      "source_text": "赌博的时候用尾巴的动作来虚张声势",
      "source_fingerprint": "cb4fb403916ac0975a75c2ed55e5adaecfed9900a4d533a1d3ebe44e7ada0605",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1049"
      ]
    },
    {
      "uid": "zhcn:b62aae3f9241b1509a775a2d",
      "kind": "text_data",
      "source_text": "除了知心好友外的其他人倘若摸了就会被踹飞",
      "source_fingerprint": "295b4b575817879f9aa1358c9bbefb29d2d84c6764658c8c946b02db4569be41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1050"
      ]
    },
    {
      "uid": "zhcn:1ca06a3ff0dbf4d24829f8cb",
      "kind": "text_data",
      "source_text": "有着太阳以及应季花朵的香味",
      "source_fingerprint": "9319fc5c835c3322a957faac7d5b86ffb98d300f2bbd4f994bb5c7fd95274bb0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1051"
      ]
    },
    {
      "uid": "zhcn:2a0582c059f65a7fea9ed7bf",
      "kind": "text_data",
      "source_text": "认为只要能够旋转着甩动尾巴就能变得更快",
      "source_fingerprint": "f5be1cb14bb57fa259dbf76ab171e392cd25c76a9be825f49c0c7f8bf3168cf5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1052"
      ]
    },
    {
      "uid": "zhcn:06cb9347a8b03730c9af1cf0",
      "kind": "text_data",
      "source_text": "无论刮风下雨都会每天锻炼自己的尾巴",
      "source_fingerprint": "71f3e3e25d1278e01751412af24e830ab49043684b22ab4322f97f76e9b55cbc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1053"
      ]
    },
    {
      "uid": "zhcn:9416d9d1ba53049960c8916c",
      "kind": "text_data",
      "source_text": "摆出英雄姿势时容易踩到",
      "source_fingerprint": "231c6898756df6ef6a47d3768861501a5d01df01f6606a47c03f83319a39c75e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1054"
      ]
    },
    {
      "uid": "zhcn:04fd5782b4bd69d779f0fd0a",
      "kind": "text_data",
      "source_text": "是能发现Marvelous的事物的天线☆",
      "source_fingerprint": "039a6394dbcf67852664d2168084d4ad5819ef152533e35ebbbd4824e605f141",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1055"
      ]
    },
    {
      "uid": "zhcn:ae573a74414600865ab9c5a2",
      "kind": "text_data",
      "source_text": "在占卜时尾巴会突然停住",
      "source_fingerprint": "c18dd5225534628433e7b401f6ff481d0793650d71cb6dd67db9ba093f6e9bcb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1056"
      ]
    },
    {
      "uid": "zhcn:2c5884032c007c31fd0625b9",
      "kind": "text_data",
      "source_text": "经常更换尾部护理油",
      "source_fingerprint": "474143231c4cbc96acd5b0e56d8e9ded3d2525eae0d3344759562c180a8a4222",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1057"
      ]
    },
    {
      "uid": "zhcn:7f84c1a6389bbd3a3661bf76",
      "kind": "text_data",
      "source_text": "由于烦恼时习惯于摆弄尾巴，所以经常打结",
      "source_fingerprint": "675289ee958ccd2280feb75f3f092197cc786a455eb43b4234a5930e2fbf13d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1058"
      ]
    },
    {
      "uid": "zhcn:eb6b644d01a5f534879b2d80",
      "kind": "text_data",
      "source_text": "比起名牌更喜欢适合发质的产品",
      "source_fingerprint": "150ba9bf35edd61dae17388ae9aaeed3a0900d8a94e905a1ec95f94d1f46ed08",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1059"
      ]
    },
    {
      "uid": "zhcn:58b7c42bfb4a1bb5cf70efee",
      "kind": "text_data",
      "source_text": "在夜里偷偷地梳理",
      "source_fingerprint": "33546e178a6cce12a09404fec1271d3b1eed70d35cb20c662f95d716a6e7af39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1060"
      ]
    },
    {
      "uid": "zhcn:aadc85f213ef0799355e1ca3",
      "kind": "text_data",
      "source_text": "常常保持着一流的摇动尾巴的方式",
      "source_fingerprint": "0da56fd9132221b6e244dbc5ddffd9b8376876412640487d549b7dd6b683c064",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1061"
      ]
    },
    {
      "uid": "zhcn:e0eefe61de86ec471ce95aa4",
      "kind": "text_data",
      "source_text": "如果自己修剪的话就会果断地斜剪一刀",
      "source_fingerprint": "4d71c4299d774238142c21ea5688612f23b7305f4f4c3c3acc9a097e33fdee0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1062"
      ]
    },
    {
      "uid": "zhcn:a2f9daa57be87a8c4139e6f6",
      "kind": "text_data",
      "source_text": "有时会当作指示棒使用",
      "source_fingerprint": "342744b5095328e7ff09b0ded1c0e429d638dbf6527c195f49a9998cca880c0c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1063"
      ]
    },
    {
      "uid": "zhcn:9f4892fb8c5da75f2506288b",
      "kind": "text_data",
      "source_text": "有时会用尾巴对别人的脚进行挠痒痒攻击",
      "source_fingerprint": "0b41212fae21e8b11653fa3f74406bdc04512db0837f4c4b8f2a82d5e9a8d2a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1064"
      ]
    },
    {
      "uid": "zhcn:27b0f62f5cb866762b51c4fe",
      "kind": "text_data",
      "source_text": "跟好姬友缠成心形拍照真的超激动",
      "source_fingerprint": "9bfb75de7fe6a9ee8cdf6a74100323583e8521fc6d1f0c580b6c1b2cbb5dfb1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1065"
      ]
    },
    {
      "uid": "zhcn:8286249068460599d67b3209",
      "kind": "text_data",
      "source_text": "不冷静的时候，会到处摇来摇去",
      "source_fingerprint": "eb0fc438760d1a4a7c0dd7d8d83e53bbc074497e167c23b2c1d5ad87276d2310",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1066"
      ]
    },
    {
      "uid": "zhcn:20799ee327b110cf004e09d4",
      "kind": "text_data",
      "source_text": "有着最棒的触感（评价・来自北部玄驹）",
      "source_fingerprint": "34800962867af45a7d565e1503080e89f1e6a7a87ea6b25b6e07b646a37bc055",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1067"
      ]
    },
    {
      "uid": "zhcn:9c4c97ab04b6343b688207d1",
      "kind": "text_data",
      "source_text": "尾巴也能拎起重物",
      "source_fingerprint": "b82ea068b5130a83acbfe6d8509396cc7e3927370cbc4361363713cfa8fff8f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1068"
      ]
    },
    {
      "uid": "zhcn:2ac8b0a50c3731d354162d00",
      "kind": "text_data",
      "source_text": "使用着与丸善斯基同款的尾部护理油",
      "source_fingerprint": "bb5b54bcaacf56e6633a7b970381195d8ba75960b58ebb86fcaf97333df4f437",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1069"
      ]
    },
    {
      "uid": "zhcn:94c4d8986397fe8d462dc682",
      "kind": "text_data",
      "source_text": "有焦躁时就会缩起来的习惯",
      "source_fingerprint": "eb7bec3329627182cb0f2c199cbb56dc96554803379a474dc8af240869531193",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1070"
      ]
    },
    {
      "uid": "zhcn:bb6f8a50f0fe91fafa94a07b",
      "kind": "text_data",
      "source_text": "喜欢使用特别订购的有机营养护理液来护理尾巴",
      "source_fingerprint": "05628fad8976d0a7e6992f02d323674fac48779e3004011ca19e2aae4cf2a50b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1071"
      ]
    },
    {
      "uid": "zhcn:c59238187a574149af4b9060",
      "kind": "text_data",
      "source_text": "强韧到能够将飞过来的物体击落",
      "source_fingerprint": "d0b4a312e96c46e8decf13e5b17b5609a01fed2d8216f4cc0813f1878b97fb93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1072"
      ]
    },
    {
      "uid": "zhcn:eaa6b1e47325bc3af80fb912",
      "kind": "text_data",
      "source_text": "洗了不马上吹干就会感冒",
      "source_fingerprint": "b68b91ecb63188de563622549c253d09925934d2e7de7e71ec797b24ddc3a3ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1073"
      ]
    },
    {
      "uid": "zhcn:6a9ee4bcdd6c66ed5b846c61",
      "kind": "text_data",
      "source_text": "坐着的时候即使尾巴被垫在屁股下面也不在意",
      "source_fingerprint": "09f985a41de081b09034632d615dc7155be139819b0498b9d46ccc3d20b116e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1074"
      ]
    },
    {
      "uid": "zhcn:612eab55d8bce4bcef927d92",
      "kind": "text_data",
      "source_text": "发质跟母亲一样，相当柔软",
      "source_fingerprint": "a93f662c90d15aa9e588d7a5f9cf5d4617f0bd288416755cded074f8490ef5b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1076"
      ]
    },
    {
      "uid": "zhcn:68d6f5f9001e04952316b5c3",
      "kind": "text_data",
      "source_text": "会介意因为湿气而稍稍变散",
      "source_fingerprint": "91bfb35c8f8a9546106c5a2e6e3b2abac0fd7e50f1e1fecd895da1ba8ccaf3ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1077"
      ]
    },
    {
      "uid": "zhcn:863fa9bf9cb91209a93a4e23",
      "kind": "text_data",
      "source_text": "自然风干派",
      "source_fingerprint": "7bf69da7295b07332f745e56e6fb19c18ea86ab36bd1d53c1cad8c93d7014809",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1078"
      ]
    },
    {
      "uid": "zhcn:71f6ad76df29e7cc2e788041",
      "kind": "text_data",
      "source_text": "要被绊倒时，会拍打脚部斥责自己",
      "source_fingerprint": "675180a486aa73c8b63a65f3eaf71657b31cf1bb6fe227550d103409a098b19f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1079"
      ]
    },
    {
      "uid": "zhcn:8e0762acc925055e6ac87ac3",
      "kind": "text_data",
      "source_text": "将其当作新制尾巴护理用品的试验台",
      "source_fingerprint": "603cc01e6524c610c05f539f568e9d2d88314c418b23d235c7caec3c99527db3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1080"
      ]
    },
    {
      "uid": "zhcn:5a80e360c4515418a337f01c",
      "kind": "text_data",
      "source_text": "用历奇的梳子随手护理※有开运效果☆",
      "source_fingerprint": "b7c865e1b92e4cbaf0a1f79a57d0414d934486774decccb63f27c46dd79a66fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1081"
      ]
    },
    {
      "uid": "zhcn:1a920dccf8355276c61a090f",
      "kind": "text_data",
      "source_text": "有着许多种打理方式",
      "source_fingerprint": "e685fadc8a8bc53ca078d9de6fb21ac131fcdc429cc9797c6d11db1fb272eb72",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1082"
      ]
    },
    {
      "uid": "zhcn:895bccab300e9d0bb15f4229",
      "kind": "text_data",
      "source_text": "用专用的洗发水刷刷地洗",
      "source_fingerprint": "dac141a5409cb057971b5694fa25805215902af99d556a1b5115d31215ae6c06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1083"
      ]
    },
    {
      "uid": "zhcn:e4bea24b301a7fc6361e8437",
      "kind": "text_data",
      "source_text": "反抗着概念――（※即使是尾巴也想要破坏栅栏）",
      "source_fingerprint": "41755ad96d4f4c31e647a79dd5686ba564c46604187072d31da8c9a9ce707548",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1084"
      ]
    },
    {
      "uid": "zhcn:f73406d6257083a28209b0b0",
      "kind": "text_data",
      "source_text": "发梢能自来卷出高贵的造型",
      "source_fingerprint": "e62b8a261314dd387ef8545b804586ea62ed42875b3b8aabc67fa154ad1e009f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1085"
      ]
    },
    {
      "uid": "zhcn:13be554d48b3dcbbd1b7c930",
      "kind": "text_data",
      "source_text": "总是丝滑的流线型",
      "source_fingerprint": "74c4c724736a97a29ff81de987e37ec9cdfda92c63c54e87f2def6827acaee88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1086"
      ]
    },
    {
      "uid": "zhcn:551d419bd8ba362a34a7844f",
      "kind": "text_data",
      "source_text": "正在摸索自己的形象商品化时尾巴如何打理得更漂亮",
      "source_fingerprint": "1194deb79031b50a456da7c0a0a882ccb1c9fef68b9a1001249c9edfb7e5b3ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1087"
      ]
    }
  ]
}
