  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:4e9045b83e44978d62f1cbe1",
      "kind": "text_data",
      "source_text": "订购了里见系酒店的特供护理品",
      "source_fingerprint": "3bdf44e70068f459c17bcaad79b23acb19aa8397819d8a26ea8471b2fc9d576b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1088"
      ]
    },
    {
      "uid": "zhcn:e680d806100283ca756bfcea",
      "kind": "text_data",
      "source_text": "常常被妹妹随便编成三股辫",
      "source_fingerprint": "0dd018453dbe8305b1c8f945ec95de0ec93ffe47eae5f4de6e47d0d6cea73d9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1089"
      ]
    },
    {
      "uid": "zhcn:f55e12117380e1d1290407fa",
      "kind": "text_data",
      "source_text": "小时候经常由妈妈帮忙梳理",
      "source_fingerprint": "8dbf9367a5b776b0035e9f8103def0f82e9beee2dd7794160be95e4dc0328382",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1090"
      ]
    },
    {
      "uid": "zhcn:6316b65aa4fb04838c9d8735",
      "kind": "text_data",
      "source_text": "使用名流推荐的护理液",
      "source_fingerprint": "9043b9bfb3364c655f645bb5419ea4e3bb66760ba507be3efd468dad04548607",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1091"
      ]
    },
    {
      "uid": "zhcn:77817ce4dc4057ea673a8859",
      "kind": "text_data",
      "source_text": "听怪谈时会跳个不停",
      "source_fingerprint": "d93354b155bd07ae0dda02548fc233d9c46bae078eec9e01b317d7e90f467e29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1092"
      ]
    },
    {
      "uid": "zhcn:7bbf0dbcfc2bf974694f0634",
      "kind": "text_data",
      "source_text": "有着肥皂的香味",
      "source_fingerprint": "85d425321045f3ec7ebd1d5884287f7f5c497b13e731f1f4eb7ca59dedd827c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1093"
      ]
    },
    {
      "uid": "zhcn:c284a3cfaa982d16ed16bfd8",
      "kind": "text_data",
      "source_text": "在富士奇石面前会来回摇摆",
      "source_fingerprint": "880ab19789062a818433b9ef5eac8e47fee1b7e0a2da4f0a08f80a4fb16de336",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1094"
      ]
    },
    {
      "uid": "zhcn:04af875e271149bf0da00100",
      "kind": "text_data",
      "source_text": "护理刷是行家才能懂的匠人珍品",
      "source_fingerprint": "4595845cc0109319a99fc9ef09c10aa7b9cfbaac2473fc267ed9c38b563600b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1095"
      ]
    },
    {
      "uid": "zhcn:8ad9ef6257f97a073940b150",
      "kind": "text_data",
      "source_text": "喜欢用碳酸洗发水清洗",
      "source_fingerprint": "b013751c0df4b2f9414c29f658d4b39f9409ddcedabb7079b32fa1574423f68e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1096"
      ]
    },
    {
      "uid": "zhcn:2a657d3e26cd1f9ad03122a9",
      "kind": "text_data",
      "source_text": "摇晃时会散发出淡淡的香气",
      "source_fingerprint": "0e1cc4be4635f6d09cb0d647a6eae4d337d7bb622b7e9a00ae723a4641d6bfcd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1097"
      ]
    },
    {
      "uid": "zhcn:8c7286f8b57d0297f6b83317",
      "kind": "text_data",
      "source_text": "会情不自禁地朝着今日的吉祥方位甩来甩去",
      "source_fingerprint": "7746b4f678e843c8d630f15f47b7a370b0044261a88f0fcca48327312d98f981",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1098"
      ]
    },
    {
      "uid": "zhcn:d6ff867b955d1968bbedd9df",
      "kind": "text_data",
      "source_text": "地方偶像模式启动时，摆动得更多",
      "source_fingerprint": "796421b67255ec21e293d7d71845f4865043d6052acc425825804e6ec155e3a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1099"
      ]
    },
    {
      "uid": "zhcn:9418022656ef125650c88c93",
      "kind": "text_data",
      "source_text": "即使要被触碰了也能华丽地躲开",
      "source_fingerprint": "960ddfaba3479c13b58bc780183cc8e0c7acf5b5047b890d318d5320f678b36d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1100"
      ]
    },
    {
      "uid": "zhcn:b93a05b095771b0217bfa22f",
      "kind": "text_data",
      "source_text": "普通着装和正装时使用不同的尾巴用古龙水",
      "source_fingerprint": "7c894fd4a03d6f722c7ad8caff532a175b0583a7eb078a9b6a70203da7dc7e9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1102"
      ]
    },
    {
      "uid": "zhcn:e7f7a5c42ce1a485391546af",
      "kind": "text_data",
      "source_text": "尾巴用的香水是自己调制的",
      "source_fingerprint": "c69b8777f53be3431082cbd41c54e2c72ad070239742e0b305f766e9b0f2e85f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1103"
      ]
    },
    {
      "uid": "zhcn:5e2197dd42034f50060ff563",
      "kind": "text_data",
      "source_text": "随时欢迎刷毛",
      "source_fingerprint": "fe8db328061150d3e99669a82fd639c319ae795a249acb769e9a517a1193d9cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1104"
      ]
    },
    {
      "uid": "zhcn:2f0b04fdedd65473c57e878e",
      "kind": "text_data",
      "source_text": "状态不好的时候似乎尾巴就会变成“尘埃彗尾”的样子",
      "source_fingerprint": "2339dd2c18eeb8cebcb2ea589269085854f96e57877b95a37ce60cf0de5bd197",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1105"
      ]
    },
    {
      "uid": "zhcn:30d7bb8e170aa8d4b5940351",
      "kind": "text_data",
      "source_text": "要不要染一下呢……只是有这么想过",
      "source_fingerprint": "9045b8c6d61d6c2c77c942899e476d208e4b2c9d76ede8d4ed93dc693d32af5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1106"
      ]
    },
    {
      "uid": "zhcn:e1f2a85c5da7ecef9cfba057",
      "kind": "text_data",
      "source_text": "为了跳舞时更好看，使用护理油",
      "source_fingerprint": "d07676e549387438c6cb81e69e085d38fca18bdad1297a89b26ffaa529d4823c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1107"
      ]
    },
    {
      "uid": "zhcn:b7506add170f4d91c0f055ae",
      "kind": "text_data",
      "source_text": "自己确定好适合运动的重量并作整备",
      "source_fingerprint": "befcb2db43d654583c49d6022e9088f7deff26317263b4d985187a73660e0e24",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1108"
      ]
    },
    {
      "uid": "zhcn:2dba5a6fc4a8204b7a856d21",
      "kind": "text_data",
      "source_text": "总是柔软蓬松",
      "source_fingerprint": "ee1b8da9a625e2ceba1b5fcb4cb1a78f25964ee1b3c126bf55aa71e77aed2a73",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1109"
      ]
    },
    {
      "uid": "zhcn:ed8f81c97281e8c8fd3336e3",
      "kind": "text_data",
      "source_text": "使用深海海洋水制成的洗发水",
      "source_fingerprint": "f0481cb1a47bfaf671b0566c13530ee0712079b9d47aa37778bc7e60896c9a69",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1110"
      ]
    },
    {
      "uid": "zhcn:68c101afafedb2217cd8b840",
      "kind": "text_data",
      "source_text": "拥有遗传自母亲的优质毛发",
      "source_fingerprint": "40e164ff6492c74a7d82830366f409ada50a51e81ef4d06c46ccbefec95644b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1111"
      ]
    },
    {
      "uid": "zhcn:665c97f0bafab371e6cfa21d",
      "kind": "text_data",
      "source_text": "用河水清洗也依然丝滑柔顺，能梳理得整齐美观",
      "source_fingerprint": "53e5602a7f51d466de14dde56d81d174d0ad524f9d3753ebf3ac32deafd7e5b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1112"
      ]
    },
    {
      "uid": "zhcn:07ff1c707840d6b0fab516ed",
      "kind": "text_data",
      "source_text": "睡觉时会变得很狂暴有点吓人",
      "source_fingerprint": "fbadd49c7b82209b551e5636c79231965be72f870cc78926d0d8f11875e67004",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1113"
      ]
    },
    {
      "uid": "zhcn:d9fef30ef951d2153b3f96fc",
      "kind": "text_data",
      "source_text": "会向着同行者那边微微靠过去",
      "source_fingerprint": "f8c26002aef49317962478a64d9b4f4dbcd342d9cbce820e2baaa20ef9513717",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1114"
      ]
    },
    {
      "uid": "zhcn:090b0d24d49c6b27f83921d6",
      "kind": "text_data",
      "source_text": "常常被姐姐照顾得很完美",
      "source_fingerprint": "9781b5dc79f093acf34364242c7e710ae6722d9107cd0fdb595c96ccd0ff0208",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1115"
      ]
    },
    {
      "uid": "zhcn:ac8179b56ffa8552030013ad",
      "kind": "text_data",
      "source_text": "就寝时使用有针织花边的尾巴套",
      "source_fingerprint": "c362b22cb9fecbc53eb1849855ac002f9b1019cf268cf58ba71e7fcde6935113",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1116"
      ]
    },
    {
      "uid": "zhcn:0c5f37566e874e06f802db72",
      "kind": "text_data",
      "source_text": "虽然会有些不知所措，但并不讨厌被摸",
      "source_fingerprint": "298f211d68d5938af541acf0eda9875b96489a703dc47bda5f276f91b51aa794",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1117"
      ]
    },
    {
      "uid": "zhcn:d0b62fa28d268b35a375cd62",
      "kind": "text_data",
      "source_text": "修剪手艺达到了专业级别",
      "source_fingerprint": "00ae7e28f7cdffc309250a12740a2bc2b7b5a4a5ee193b768490ee1d48d4ecaa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1118"
      ]
    },
    {
      "uid": "zhcn:bf2c82e46d7a15f3e460fb99",
      "kind": "text_data",
      "source_text": "不能摸",
      "source_fingerprint": "aeea9480fd49c7be607fd42f54ab291bdb4dde0b6e1b22b4e607a82d9596bbb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1119"
      ]
    },
    {
      "uid": "zhcn:58deea7144ef86d53dbb2f1e",
      "kind": "text_data",
      "source_text": "保养时要用尺子确保完全笔直",
      "source_fingerprint": "22da2ededef26048d11db3cbcfdf5a4b7bfd4fa64c21244ffcf9d3bfc96e7895",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1120"
      ]
    },
    {
      "uid": "zhcn:8df68acfbb8cad484f270961",
      "kind": "text_data",
      "source_text": "正在认真思考能否当作武器使用",
      "source_fingerprint": "35ecde72162605fcde576f46c891d2c5e9abfbb71b79ccce7a8a3bec0ceefeb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1121"
      ]
    },
    {
      "uid": "zhcn:066b58653d4d0e77d2972df9",
      "kind": "text_data",
      "source_text": "喜欢用粉彩色配饰来打扮",
      "source_fingerprint": "47cd67a2e12d9bf31bdcc6314db56f8fc180d5cf83d7dfad7142bfdcc28e7ffa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1124"
      ]
    },
    {
      "uid": "zhcn:e14a1b56b9b7eafc81bf895d",
      "kind": "text_data",
      "source_text": "在BOSS（训练员）面前会摇个不停",
      "source_fingerprint": "983801ce4053dccf8f7a9f3dc1501b16b73ba5255912adb26a6bf9f01126f8a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1127"
      ]
    },
    {
      "uid": "zhcn:1347e350821decd08e9d5d38",
      "kind": "text_data",
      "source_text": "做瑜伽的时候会打结",
      "source_fingerprint": "4e9ee432f77bcf528ae5394a9976437dce7d2ed3691a833cfe0b1b02c99164a2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1129"
      ]
    },
    {
      "uid": "zhcn:7bc5810d04e04bb64b8a3fec",
      "kind": "text_data",
      "source_text": "尽量每天都用山茶花油进行护理",
      "source_fingerprint": "f263d57d566fd6263e8d8b6295745f1402364532c19c35240c62219443c436b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1130"
      ]
    },
    {
      "uid": "zhcn:75422f8b7c46dfa8f45bb93f",
      "kind": "text_data",
      "source_text": "睡觉前会用红丝带把毛发扎起来",
      "source_fingerprint": "8a53f302c2b07555ba40b40ab4b5366c0be1fe5a12ac360c6ebc7db78cd65eb6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1131"
      ]
    },
    {
      "uid": "zhcn:1845e3feba2aef00dad6475e",
      "kind": "text_data",
      "source_text": "会用来吸引猫的注意，防止其闯入直播",
      "source_fingerprint": "0eb5ebdf857d4153b10f3a72b082bfa2d9f7d2d52cedaacd515c4b2dce6efeaf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1132"
      ]
    },
    {
      "uid": "zhcn:dd69e5fac605bce1fad4d784",
      "kind": "text_data",
      "source_text": "开场号响起时会跟着节奏摇摆",
      "source_fingerprint": "0ab42f212eaf1443751597e8506062cff2c1a327720090deed00cce25978c09f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1133"
      ]
    },
    {
      "uid": "zhcn:1131f3ea2d8c59de728990ff",
      "kind": "text_data",
      "source_text": "容易与身边人的动作同步",
      "source_fingerprint": "b22939d505ce8e94b9cb392532f8fb82e1b2213871692a6dc4a2cea7594c5d79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1134"
      ]
    },
    {
      "uid": "zhcn:edb878ccff3fe92945c15278",
      "kind": "text_data",
      "source_text": "无论何种环境都能保持柔顺飘逸",
      "source_fingerprint": "e28f8d48ede00e725fdc94f84c083c3bdc1d3855e28f73858e812a634d135b0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1135"
      ]
    },
    {
      "uid": "zhcn:3723651def00e10bd96534a7",
      "kind": "text_data",
      "source_text": "即使在冬天，也会用冷水洗净",
      "source_fingerprint": "a78acb8b95b2dabbef47decc5dff912d9855dd80e8461e22ebcbba262dbf1809",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1136"
      ]
    },
    {
      "uid": "zhcn:c847b6dd40f6419488ee8dda",
      "kind": "text_data",
      "source_text": "在画原稿的时候，会在无意识中碰到",
      "source_fingerprint": "999f797f720e38056de3a9f360fbfa33cba9fb1b25a222bb05c7a75ff2a86267",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1137"
      ]
    },
    {
      "uid": "zhcn:23be2f26e0fd2d7e959f8c15",
      "kind": "text_data",
      "source_text": "使用和西沙里奥同款的海洋深层水洗发水",
      "source_fingerprint": "f1890cb7aa653ab0d124e9893faa15fb7eab59cdeb9031bfa41084330d98e48a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1141"
      ]
    },
    {
      "uid": "zhcn:8617096961bb0f4c30f51652",
      "kind": "text_data",
      "source_text": "扎起来时使用的发圈上带有绿松石",
      "source_fingerprint": "9861315307d6e70c5aab906dd59e99749dbbe0b43e46a4a1e650551257ab68a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1143"
      ]
    },
    {
      "uid": "zhcn:a97d7ea508e1a577e8d28c95",
      "kind": "text_data",
      "source_text": "经常会压出睡袋的痕迹",
      "source_fingerprint": "8f1f4747ae5a8f5f706cbc67d3b8e85237df4cc39d6ffa2866fff05b09ab758a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1145"
      ]
    },
    {
      "uid": "zhcn:47aadcaf03a706e58cdf4344",
      "kind": "text_data",
      "source_text": "就寝时从不懈怠用元结束发",
      "source_fingerprint": "cfcdd298c842ef514cc2f57691642d02302fdae9aac8fdbeb2510b86f3929ba3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "167",
        "1149"
      ]
    },
    {
      "uid": "zhcn:67a1d1fb29eda51ecd69ff49",
