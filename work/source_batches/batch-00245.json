        "1149"
      ]
    },
    {
      "uid": "zhcn:b65d26febe76294f2349cbea",
      "kind": "text_data",
      "source_text": "眼睛的颜色继承于生母",
      "source_fingerprint": "71531beeeacc3b78a6978cfc099a6e654756ed4f9ba8f7baae9573dfc0625fad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1001"
      ]
    },
    {
      "uid": "zhcn:611afe2364dd0a198e543098",
      "kind": "text_data",
      "source_text": "增加了买鞋用的零花钱",
      "source_fingerprint": "6d99604b67c2803e7654700e367a611600fca4074a046d0ed63aeb2362f98a39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1002"
      ]
    },
    {
      "uid": "zhcn:78f124c589b233e5221a4fd4",
      "kind": "text_data",
      "source_text": "试着不叫爸爸妈妈结果哭了",
      "source_fingerprint": "56456b4e72499009f5da1dd51089ce8278841b04b74ccae30e6e96776d4c731e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1003"
      ]
    },
    {
      "uid": "zhcn:aa9995d19814495b8af7f3ac",
      "kind": "text_data",
      "source_text": "赤红色的超级跑车为父亲的旧车",
      "source_fingerprint": "1efaa56aa98baed0cebefa705b892bd7f0fb464526da5fa5a784ffad71af8c21",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1004"
      ]
    },
    {
      "uid": "zhcn:cc548f71d2a72a0e56132fb1",
      "kind": "text_data",
      "source_text": "出身于舞台家族，双亲时常全国巡演",
      "source_fingerprint": "d76add5a4474f2d348f00ba2ea44f8d0c105b6f9576a2c132e53533b38bf9447",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1005"
      ]
    },
    {
      "uid": "zhcn:1e9958977ff4321d07e4e231",
      "kind": "text_data",
      "source_text": "说到家族旅行就是去温泉，全家都是某个秘汤的常客",
      "source_fingerprint": "bb5c217a9de0ca714b09350bd1f00d98eb39e2930a7aa2a4fae49c40a89c81f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1006"
      ]
    },
    {
      "uid": "zhcn:c112030781dff1a6cb4c1851",
      "kind": "text_data",
      "source_text": "好像是国家级的机密事项",
      "source_fingerprint": "37ba9c320d478abc39b4b7c2019c5b3f5eb9687940b752e7309642f8734919d5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1007"
      ]
    },
    {
      "uid": "zhcn:413e1b93fa465ccf65296930",
      "kind": "text_data",
      "source_text": "经常和父亲一起皮，一起被母亲说教",
      "source_fingerprint": "0affe62134cb1ed66d49bd08718627295a54bfbf7dbfe0ccb0508d5a27b4aeb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1008"
      ]
    },
    {
      "uid": "zhcn:d53f3a8047715123f576a2d3",
      "kind": "text_data",
      "source_text": "憧憬并挂念着对工作热心的母亲",
      "source_fingerprint": "9daf992ad1e0af964df8205da3254fa75cc66221a516dc0bf05393ae13da74bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1009"
      ]
    },
    {
      "uid": "zhcn:e8c13595d46052dbdbe99881",
      "kind": "text_data",
      "source_text": "老家时常准备着欢迎用烟花",
      "source_fingerprint": "5c25ab0afa61719edbaa0dbf1b3a6e214ef2bda096d9884caa5c74b10bcd8d78",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1010"
      ]
    },
    {
      "uid": "zhcn:38823a60da497e0d87c4c044",
      "kind": "text_data",
      "source_text": "性格受喜欢日本文化的双亲影响。在老家也有和室",
      "source_fingerprint": "66c5ec8428dcbc025efef9f6aac8fb4371b18a42ad50e1647e5ece56baf77f1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1011"
      ]
    },
    {
      "uid": "zhcn:54f48804a0c1876bc668e4bf",
      "kind": "text_data",
      "source_text": "大姐头气质遗传自母亲，但其实是家中老幺",
      "source_fingerprint": "81d21cdf7ff92723379a13822c9280b5eee4d4a581577f491482b4a30c0dc418",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1012"
      ]
    },
    {
      "uid": "zhcn:4f2fa58597f88727b95f9408",
      "kind": "text_data",
      "source_text": "双亲以“麦酱”称呼自己",
      "source_fingerprint": "a096e6c740493c17c9d14f810d7c73421b317c42bf977b0e7f4f574887612a9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1013"
      ]
    },
    {
      "uid": "zhcn:12dad5f96f8d67b14eebb393",
      "kind": "text_data",
      "source_text": "与名为“曼波”的老鹰如姐弟般一同长大",
      "source_fingerprint": "bf259d4678a3c6143306b0ba9b8f8e2fe638d9334b5e466d2c0f47ecdddc3025",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1014"
      ]
    },
    {
      "uid": "zhcn:0261bf18ce72d0994503fb4c",
      "kind": "text_data",
      "source_text": "尊敬着生下并养育了美丽自己的双亲",
      "source_fingerprint": "e5e6b54ba84927b367406659ebafd8d4e6448c8c70a4b6b8366cd1aa3ee9f2ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1015"
      ]
    },
    {
      "uid": "zhcn:d02254174e099f24d392792b",
      "kind": "text_data",
      "source_text": "双亲以及姐姐都表示“沉默寡言是她温柔的证据”",
      "source_fingerprint": "55e7df3fa6b23857f9625fe41a8c3dbb5d041fcd3b1422bf15e75295ce2d722f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1016"
      ]
    },
    {
      "uid": "zhcn:f25c0df136292b075039e74f",
      "kind": "text_data",
      "source_text": "自幼就被双亲传授帝王学",
      "source_fingerprint": "77b467600187d87cecbafeaa5683ffc2f7040986d873e8200a1baf901dae0e86",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1017"
      ]
    },
    {
      "uid": "zhcn:8415a7a2aa4934b8182e6778",
      "kind": "text_data",
      "source_text": "为了母亲的生日会精心策划了1整年",
      "source_fingerprint": "15e328441c61d84d06f57ac93c94491470d22fae819fda85365d925a083d5e00",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1018"
      ]
    },
    {
      "uid": "zhcn:95aef7e8426cbfca3a6b5d7d",
      "kind": "text_data",
      "source_text": "家人的兴趣是野营！节日！BBQ！",
      "source_fingerprint": "74f07d8a92a933dfb49b4c1a6ea662972db29f922be3ac7a78327e3287227548",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1019"
      ]
    },
    {
      "uid": "zhcn:ef03b36219e35a96846ad27c",
      "kind": "text_data",
      "source_text": "回老家时，会与作为钓鱼伙伴的祖父一起去钓鱼",
      "source_fingerprint": "80a503d31858a167a5adf5b25a9d595751b47efe53219981f41da3b7a3928d74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1020"
      ]
    },
    {
      "uid": "zhcn:8e12e183a85e8701011def2a",
      "kind": "text_data",
      "source_text": "和弟弟妹妹在一起的时候就会变成“玉藻姐”",
      "source_fingerprint": "28e86ef824163ca33ca89ee04ad5a71a1759100ef67d03f047ff6ea0194780d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1021"
      ]
    },
    {
      "uid": "zhcn:64330ada351d3578e3d848cf",
      "kind": "text_data",
      "source_text": "比双亲更擅长对付自由奔放的姐姐",
      "source_fingerprint": "4f7e6086eb397d24da1a04ccc3eeab9cb3074876845f4be7dd76c3b3a7357691",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1022"
      ]
    },
    {
      "uid": "zhcn:2be55522836f39fd93732b18",
      "kind": "text_data",
      "source_text": "以前和妈妈、妹妹留着一样的发型",
      "source_fingerprint": "3ba3d840c642a901f2a64e4256d5f7f10ad622dded3debd96984b422d7c823fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1023"
      ]
    },
    {
      "uid": "zhcn:3a0e4caa72e36e0c32c66758",
      "kind": "text_data",
      "source_text": "机场曾是和飞行员父亲的游乐场",
      "source_fingerprint": "11029686779313770b45867447fea2465a29c48236c3b1eb596740d6e2fcc336",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1024"
      ]
    },
    {
      "uid": "zhcn:4154ba88d3fd8e2461a0cc73",
      "kind": "text_data",
      "source_text": "家人们为了作为咖啡爱好者的自己而购买直接进口的咖啡豆",
      "source_fingerprint": "c182d6336bcf414e9d31c68d24ace684161d5817b4a8d9f0f59deee59317e9ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1025"
      ]
    },
    {
      "uid": "zhcn:5a92e805c5f188081bdcc5dc",
      "kind": "text_data",
      "source_text": "由于电器经常损坏所以全家目前过着乡村生活",
      "source_fingerprint": "f15037f72e31e8d97c416e54daef5d24dd0bd1a3735d58b5eafe39098196d8fb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1026"
      ]
    },
    {
      "uid": "zhcn:7de9aa56bfeb066cd535b105",
      "kind": "text_data",
      "source_text": "父亲长得十分年轻，经常被误认为兄妹",
      "source_fingerprint": "a9cbc471fcaab8cebd2063bcd7f0a7685e2c529361dbabf7ebb5b310a624180b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1027"
      ]
    },
    {
      "uid": "zhcn:e361f5dbd91137dce1d4d275",
      "kind": "text_data",
      "source_text": "父亲是料理师傅，母亲是西式点心教师",
      "source_fingerprint": "cb3ebac6d09916a9e54c5f8bc625fa36fd72a66610f6a8ac01463302fb5e2105",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1028"
      ]
    },
    {
      "uid": "zhcn:5def99f515a4999f1212d9b3",
      "kind": "text_data",
      "source_text": "看着女儿进京后依旧带着乡音，双亲感到些许安心",
      "source_fingerprint": "a4ec616ed3c30301cb25f6b6290f1c98cbe4c9681aebca59aa47994ba966a5bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1029"
      ]
    },
    {
      "uid": "zhcn:c891da727268dad95ee39afe",
      "kind": "text_data",
      "source_text": "曾经父母会在睡前给自己朗读绘本故事",
      "source_fingerprint": "a9e3bb84a8638d9a1f387ccb2b623772b59a17201ae21f0bad557186114495d5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1030"
      ]
    },
    {
      "uid": "zhcn:3334c0c32474500dcda7608c",
      "kind": "text_data",
      "source_text": "“出门的时候要紧牵着手”是家庭准则",
      "source_fingerprint": "a3b4e8f6d75864f7984aa5178fb3636a76aed1e839655eac09647569dd322c20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1031"
      ]
    },
    {
      "uid": "zhcn:fea13bb73c7ae2d305747849",
      "kind": "text_data",
      "source_text": "自己是在赛马娘界声名显赫的家族中的特立独行者",
      "source_fingerprint": "426b176097b9dd976b4f6687e97c0388dd13a97c4b59314875053eea20b453ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1032"
      ]
    },
    {
      "uid": "zhcn:e547bce2893f4f9fcf04cd0b",
      "kind": "text_data",
      "source_text": "每年的生日蛋糕都会准备两个",
      "source_fingerprint": "94c5cd0b1be73758c7c59c60df8c1332284f6fbd2da5e51561167bdcd0b204f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1033"
      ]
    },
    {
      "uid": "zhcn:16fd9b72b1979df2e5c2d2cb",
      "kind": "text_data",
      "source_text": "有一条洗澡的顺序要通过拍洋画来决定的家规",
      "source_fingerprint": "4ac5cb76b6cbb591560e8d5b6bdd212cd16e1497a77726f8a7eaf5cf24cb82f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1034"
      ]
    },
    {
      "uid": "zhcn:e7ae680cd0f192df6e93b079",
      "kind": "text_data",
      "source_text": "观战德比是最重要的家庭活动",
      "source_fingerprint": "581e5be12f01b9718fc109e579c8cbb3f1b9706c5136e8f9089d1cf1e0f2bab3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1035"
      ]
    },
    {
      "uid": "zhcn:0b19b5ba67846fb2e022cc90",
      "kind": "text_data",
      "source_text": "从未打开过母亲寄来的箱子",
      "source_fingerprint": "409cebb41bd9258669049dae191e2dd07bcd4c8b0032715b0c33b15354317ddd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1036"
      ]
    },
    {
      "uid": "zhcn:5314da16b3502fa10936c93d",
      "kind": "text_data",
      "source_text": "家里经营着蛋糕店。其招牌出品是年轮蛋糕",
      "source_fingerprint": "590782a3d90f07a982413cb3efb946a820366da2e3914cf2ed6740d1ace3d044",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1037"
      ]
    },
    {
      "uid": "zhcn:38734f2dd7fd5ee3bd742400",
      "kind": "text_data",
      "source_text": "女儿离家后，思女心切的家人选择应聘学园工作人员岗位",
      "source_fingerprint": "e61c66efed3e2409e0a0f28f45b2413848b67daba43a3eb7f5c6dea53b36f06f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1038"
      ]
    },
    {
      "uid": "zhcn:3edfc716b25848fc2e677d61",
      "kind": "text_data",
      "source_text": "为其选择了既可爱又结实的衣服",
      "source_fingerprint": "9b78e5f2ebd38e427816683d7659e8cd3405df875f13a3689da43f11da5d4ad2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1039"
      ]
    },
    {
      "uid": "zhcn:5a12f0d65994d4e50fc73ac3",
      "kind": "text_data",
      "source_text": "吹弹可破的肌肤来自母亲，闪耀的金发则来自父亲",
      "source_fingerprint": "ec6df6c23c8753cab88afc3ea29ec60acd3b6c089b8e80cc7799aa5fad6b4c73",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1040"
      ]
    },
    {
      "uid": "zhcn:884b5f84a09e9386a64800f0",
      "kind": "text_data",
      "source_text": "家训为“表扬我表扬我表扬我，想被表扬！”",
      "source_fingerprint": "d1c0edc8825f68e1a627eeb0fcf215dcfd4d1a5c1ad6fe432065bbd53ea6876c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1041"
      ]
    },
    {
      "uid": "zhcn:cb05ffb2156f090e72ba345c",
      "kind": "text_data",
      "source_text": "全家人都有一样的墨镜",
      "source_fingerprint": "b2bcc8a851b1a2bd06a5d24cfb3e9957e10148ad4bb3037bdc81faf2f3f88090",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1042"
      ]
    },
    {
      "uid": "zhcn:854f73b612cd143f5f8d2676",
      "kind": "text_data",
      "source_text": "父亲公司的广告曲是全家合唱的",
      "source_fingerprint": "7f3ff77cfda13520eeed3fd752ce54c643dd756b0049a18e7ccc1e05c805c6fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1043"
      ]
    },
    {
      "uid": "zhcn:7fd1ed256a652bb7cb92ddb0",
      "kind": "text_data",
      "source_text": "跟父亲打电话，挂断之前一定会哭",
      "source_fingerprint": "964881a997cab19e596eeb44489f1a54aec36e5fbd84480ce9ad85286b77f15e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1044"
      ]
    },
    {
      "uid": "zhcn:242e091759fd7335127f02cc",
      "kind": "text_data",
      "source_text": "老家开的托儿所，因如家一般温馨而闻名",
      "source_fingerprint": "4b288ca095e05ce097569eac86e14efa3b8345de81e266b60a32bf1085b3f9e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1045"
      ]
    },
    {
      "uid": "zhcn:41ff6f7f50a8b319e2b841a1",
      "kind": "text_data",
      "source_text": "发饰是母亲亲手制作的第1号偶像服",
      "source_fingerprint": "78f37ce24ba31603b1de8302f1e057bbacef346838957bb51d4c9530077a73b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1046"
      ]
    },
    {
      "uid": "zhcn:4b16fbdd514f9457d8214516",
      "kind": "text_data",
      "source_text": "父母谈论最新的电器会一直讲到天黑",
      "source_fingerprint": "6562469989c973d3b5275eaeb34040d1c5eeb198abdb6d734060da72ddf5025d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1047"
      ]
    },
    {
      "uid": "zhcn:29c79ef5570331fb2fb29752",
      "kind": "text_data",
      "source_text": "“从蔬菜开始吃吧”是最让人生气的回忆",
      "source_fingerprint": "881adad3e942db7aec43d0f95e4aa62dcff316b852dd111ce39a3060aa8badd8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1048"
      ]
    },
    {
      "uid": "zhcn:a14fd0b36b89ca0060f95627",
      "kind": "text_data",
      "source_text": "一家人睡相都很差",
      "source_fingerprint": "ce3696926c4c7fddbe2c38bba5bb0abdad9aa726a7402ec9a1e8215dcf4a8350",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1049"
      ]
    },
    {
      "uid": "zhcn:29e427f7dfa089060a1e42c4",
      "kind": "text_data",
      "source_text": "有着会秒读妈妈、朋友以及BNW信息的传闻",
      "source_fingerprint": "3cf179898ed394c5fa12f3da5d2002c6b61c20841a267742eebf51cb939221d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1050"
      ]
    },
    {
      "uid": "zhcn:b091eee8ffe8973739258e0c",
      "kind": "text_data",
      "source_text": "从双亲那收到的洒水壶至今仍被当为宝物而爱惜着",
      "source_fingerprint": "c6950c13cd96b46a715e10d04942c2707acb2ce154437a76055b7bc7b5700785",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1051"
      ]
    },
    {
      "uid": "zhcn:5f34d72dedaf81184cee2046",
      "kind": "text_data",
      "source_text": "最喜欢的料理是母亲做的胡萝卜饭",
      "source_fingerprint": "1946c56f0f4575d339958894a70f3b6459806a1280b1fab41f32f9562c87770f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1052"
      ]
    },
    {
      "uid": "zhcn:e9eced4126573e60dbc952c6",
      "kind": "text_data",
      "source_text": "身为热血体育教师的父亲对她而言亦父亦师，也是她成长的起点",
      "source_fingerprint": "8683ce87e270d37182933e0319aafa47a1333d16de44368ed68eb2aeed367e4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1053"
      ]
    },
    {
      "uid": "zhcn:6700c3773b1fd73e1cb35621",
      "kind": "text_data",
      "source_text": "周日早上，是全家人一起看特摄片的时间！",
      "source_fingerprint": "9a326c60fb461238678c7ccd8fd776c04e4bea74be3517e0f238e97a73157362",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1054"
      ]
    },
    {
      "uid": "zhcn:21e832c13fb57a0ebcea3f49",
      "kind": "text_data",
      "source_text": "和最爱的奶奶秋天一起赏红叶",
      "source_fingerprint": "591bb547a87ec394df05bb2c3f77b6d3a4a3a692292802417e5c4f807d18f5ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1055"
      ]
    },
    {
      "uid": "zhcn:f81854f5936e8884c586b630",
      "kind": "text_data",
      "source_text": "优秀的姐姐憧憬着作为妹妹的自己的开朗",
      "source_fingerprint": "2e3fa6439f9ba16fe7711b0916b65e4d22f67947f7937bebdb291fc542e66267",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1056"
      ]
    },
    {
      "uid": "zhcn:2c15464fe9ed6ce7e9ca5105",
      "kind": "text_data",
      "source_text": "父母是以半私奔的方式结婚的",
      "source_fingerprint": "1538536e0686009bb9ee932c62481313d8ea09391c46bcb8db4ce5b6d00383ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1057"
      ]
    },
    {
      "uid": "zhcn:14ea9cd7d8dbab54dca1c202",
      "kind": "text_data",
      "source_text": "家人由于频繁调动工作所以擅长外语。作为女儿也当然不在话下",
      "source_fingerprint": "a9b94a288fa3dc6667f72571ba0ccbc28382cf279ce8236e18ee0be590c41acc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1058"
      ]
    }
  ]
}
