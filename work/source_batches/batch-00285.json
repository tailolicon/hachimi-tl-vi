      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006309"
      ]
    },
    {
      "uid": "zhcn:62ad93521f120fcf5e5fb92a",
      "kind": "text_data",
      "source_text": "“シリウス”を追って",
      "source_fingerprint": "335d21406cbc72d10ee5213f3a8413f0a6f32ab68037983bee927c2c7f5a3901",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006310"
      ]
    },
    {
      "uid": "zhcn:290af2d0f8d2a0d874dcd94a",
      "kind": "text_data",
      "source_text": "星の輝きは終わらない",
      "source_fingerprint": "6d62cbd3cf193de0155228a251f09fc064696eeb796ba7b409c69f9f06ef4c32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006311"
      ]
    },
    {
      "uid": "zhcn:6e0aed6ee45511678cd92061",
