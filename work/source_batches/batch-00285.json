      "source_fingerprint": "f596eeb9d58881a05631ab3b944e0a8c9cb57e50f3ca36644f8e37ec14aec1d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006316"
      ]
    },
    {
      "uid": "zhcn:a178f2544d2d73a5d0e51387",
      "kind": "text_data",
      "source_text": "お大事に！",
      "source_fingerprint": "aebb445d34696cd39b4a804392bf4f3ace4b667d7bf2a8e2ba89b020cacc3256",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006317"
      ]
    },
    {
      "uid": "zhcn:ac4b01c6e332e6f05235f90b",
      "kind": "text_data",
      "source_text": "無茶は厳禁！",
      "source_fingerprint": "078bda01e710c8304595761b5a262bd745227d9951b5d0b894fccb1531a59157",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006318"
      ]
    },
