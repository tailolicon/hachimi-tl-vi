      ]
    },
    {
      "uid": "zhcn:d7db7b0e7d6ea2e3e14887a4",
      "kind": "text_data",
      "source_text": "至高の『愉快』を",
      "source_fingerprint": "b7f72ab2b3c28a9850a95e47fa15651c8cbade320be4245644b0eb5d367085f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006305"
      ]
    },
    {
      "uid": "zhcn:8f43194e7e969b728a2d1858",
      "kind": "text_data",
      "source_text": "貴石の誇りを胸に――",
      "source_fingerprint": "5d0ca6fdcfc1ba21874452003df9d45bd5a28b20dec4eb75cc028f16063ea529",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006306"
      ]
    },
    {
      "uid": "zhcn:cbf936492c050ee4a9ca0aba",
      "kind": "text_data",
      "source_text": "不可能を越えた先に",
      "source_fingerprint": "fc2ab979379e179b5f9fe07cfbc818ea6d4c1e70c07a78dfe4b5262de0a8b496",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006307"
      ]
    },
    {
      "uid": "zhcn:05eb1c83d9ea7995c4eae20b",
      "kind": "text_data",
      "source_text": "その背を越えた先に",
      "source_fingerprint": "11af739bbe906f23775f0ad05c0bc5ef011517695a79478069131132e8d46529",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400006308"
      ]
    },
    {
      "uid": "zhcn:2907f08e0f9266a1d04f3383",
      "kind": "text_data",
