      "json_path": [
        "181",
        "400015004"
      ]
    },
    {
      "uid": "zhcn:4beec45a4eb2ac4d7eb0b16f",
      "kind": "text_data",
      "source_text": "此亦为，仪式",
      "source_fingerprint": "882b61ca66300df1a4bcff5644bec6de24c6697a9db37c14900e80914cb1aee6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400015005"
      ]
    },
    {
      "uid": "zhcn:e5f8b796cdff4561788e0f04",
      "kind": "text_data",
      "source_text": "第1年，骏大祭合宿结束",
