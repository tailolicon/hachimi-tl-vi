      ]
    },
    {
      "uid": "zhcn:dd35f0f4a7fbca008f8c7084",
      "kind": "text_data",
      "source_text": "凡人之星",
      "source_fingerprint": "a6079a1d0a98fab7337064748be1dbcc4856aba2e26f97a00fee8401f7759870",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014309"
      ]
    },
    {
      "uid": "zhcn:c1815047e0d4cd1bdd44980c",
      "kind": "text_data",
      "source_text": "只要一起吃",
      "source_fingerprint": "9026569aaecd25062d32559d9ec61015c403799404aba3e1c7d2603bd93debdc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014310"
      ]
    },
    {
      "uid": "zhcn:fc113ad8e0ec93613cf1aa86",
      "kind": "text_data",
      "source_text": "你闪闪发光",
      "source_fingerprint": "7a11a63448936fdbcf21a74724024afdba96b876917b6e354a99baf43d73940a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014311"
      ]
    },
    {
      "uid": "zhcn:11ec45128f00d261c7250ee6",
      "kind": "text_data",
      "source_text": "恩师、弟子与拉面",
      "source_fingerprint": "92ea269908fc2097e337780b16ac3a3f46d2772133460e57ec0279fde503f9c0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014312"
      ]
    },
    {
      "uid": "zhcn:cee91dfdb070cba895a3789b",
      "kind": "text_data",
      "source_text": "面线～先辈的指引～",
      "source_fingerprint": "bcdd466cb659c5536e3cd18e6c0f270ef3ab54d5db2f173fb1bdb9bfe20aa07c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014313"
      ]
    },
    {
      "uid": "zhcn:54dad43d78ba5c7e76e1237b",
      "kind": "text_data",
      "source_text": "Ramen to the top",
      "source_fingerprint": "0803ca9e928f5ed7901cc64f3cd867bc90a2bbb7c56aac2ffb6c02100f3680a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014314"
      ]
    },
    {
      "uid": "zhcn:841187d61f3804bca4f36922",
      "kind": "text_data",
      "source_text": "一生难忘的至高一碗",
      "source_fingerprint": "8d29e5d08dad7602df01107dae7d7845044a860998426a820eeab3b373afd34d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014315"
      ]
    },
    {
      "uid": "zhcn:18082e2406200afbce0ac73a",
      "kind": "text_data",
      "source_text": "欢迎来到『直线硬面堂』噢噢！",
      "source_fingerprint": "62efe0ace3845aa92423da6fecd252da6ba340f5b8647f034ef58da50ce1d57e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014316"
      ]
    },
    {
      "uid": "zhcn:a23709550392e8a30728e19f",
      "kind": "text_data",
      "source_text": "拉面乃是通向明日之路！",
      "source_fingerprint": "8ad69162278bba0ae74125e9ffec8d10de746339adbb1e81e49006f0d42b78c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014317"
      ]
    },
    {
      "uid": "zhcn:97feda730bcf0f16d04182d8",
      "kind": "text_data",
      "source_text": "一切硬面皆为拉·面",
