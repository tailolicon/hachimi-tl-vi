      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400015002"
      ]
    },
    {
      "uid": "zhcn:caf12198bc95b4b8a6ec1dd7",
      "kind": "text_data",
      "source_text": "此刻，教诲传授！",
      "source_fingerprint": "d35fac64204c1f691c4025c0c4151833612ac306c7d522f474431f559b8aead4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400015003"
      ]
    },
    {
      "uid": "zhcn:393b2e35db0e1a21e374fc50",
      "kind": "text_data",
      "source_text": "第1年，骏大祭合宿开始！",
