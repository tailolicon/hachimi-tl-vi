      "uid": "zhcn:004d000c6a15751e1fcaefa9",
      "kind": "text_data",
      "source_text": "被夸奖×",
      "source_fingerprint": "602c3add08bb8bc3caf29fd07d3b5e6f517997526afee0e5fc4346855ddac979",
      "source_path": "text_data_dict.json",
