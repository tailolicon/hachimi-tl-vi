      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400015000"
      ]
    },
    {
      "uid": "zhcn:9927dee87cf667068a63803f",
      "kind": "text_data",
      "source_text": "承蒙指南，培训会",
      "source_fingerprint": "cd175d1d4c219a96a9ea1ba1bc48c957531ce768bea56deff9eea522d6a54117",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400015001"
      ]
    },
    {
      "uid": "zhcn:566d383eb6bb1ccff45c75cb",
