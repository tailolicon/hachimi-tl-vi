      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014318"
      ]
    },
    {
      "uid": "zhcn:7f7aeb7a61aca7d7651d417a",
      "kind": "text_data",
      "source_text": "循着面条，奔向志向的尽头！",
      "source_fingerprint": "0cbaeef40e7803d36720f288fceed79cabfa63dd3d2c4fb264f0b32525b9fd9c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "400014319"
      ]
    },
    {
      "uid": "zhcn:33c8ace79af9ad3dd7b7a7d4",
      "kind": "text_data",
      "source_text": "时节，将至 ―午式骏大祭―",
