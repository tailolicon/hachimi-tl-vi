      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063705"
      ]
    },
    {
      "uid": "zhcn:c6e24d65e590d96ebe618374",
      "kind": "text_data",
      "source_text": "ぷちアゲ・コンサルタント",
      "source_fingerprint": "93d078ce15209d1d18469307fd75eba0fe6d1e74127e60303ffca221dc749ded",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063706"
      ]
    },
    {
      "uid": "zhcn:eede7b7064520d1ca7eac848",
      "kind": "text_data",
      "source_text": "神社でお祈り！",
      "source_fingerprint": "06b731b66c3603a32c1cac4b4908776cc86635a0de8a2efa50ba8073f31fb180",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063707"
      ]
    },
    {
      "uid": "zhcn:d08a8d82fee8275cd5919241",
      "kind": "text_data",
      "source_text": "レース勝利！",
      "source_fingerprint": "41790a1b5f8d0e645951f342cc052cc2c0f1183fe6a662072b935a3d6098a1fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063708"
      ]
    },
    {
      "uid": "zhcn:cbe794050ff19d47489d32e0",
      "kind": "text_data",
      "source_text": "レース入着",
      "source_fingerprint": "e4d0bf03e5655cac21b58856d1003b726f71b11b71eb48edbe420038d6c33e15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063709"
      ]
    },
    {
      "uid": "zhcn:24528f7bb8f82850c8e55192",
      "kind": "text_data",
      "source_text": "レース敗北",
      "source_fingerprint": "e44ca7b679cb69d01b24af5ea35ca7c562e4b81ae32c6f488a437577af14a73e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063710"
      ]
    },
    {
      "uid": "zhcn:0311098814a9e75492d3a470",
      "kind": "text_data",
      "source_text": "今度こそ負けない！",
      "source_fingerprint": "1a4987e705d288580f95307601ec77f5f393ccd07975e9844dcd744fb89c5cf4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063711"
      ]
    },
    {
      "uid": "zhcn:ff1d05ae77c9dd9ada5c3e24",
      "kind": "text_data",
      "source_text": "不在の理由は……",
      "source_fingerprint": "e84e2b559d6ea65f431c50d18fb74ec2bbd2beed0b5e51cc7ec887704b624f21",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063712"
      ]
    },
    {
      "uid": "zhcn:c54ef972ccbf32b37f71f89f",
      "kind": "text_data",
      "source_text": "お大事に！",
      "source_fingerprint": "aebb445d34696cd39b4a804392bf4f3ace4b667d7bf2a8e2ba89b020cacc3256",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063713"
      ]
    },
    {
      "uid": "zhcn:69f93bb0edbeaa504739bd44",
      "kind": "text_data",
      "source_text": "無茶は厳禁！",
      "source_fingerprint": "078bda01e710c8304595761b5a262bd745227d9951b5d0b894fccb1531a59157",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063714"
      ]
    },
    {
      "uid": "zhcn:d3e828ab389b7445a9306a8e",
      "kind": "text_data",
      "source_text": "追加の自主トレ",
      "source_fingerprint": "02d0e195f7b5ccf45b9e52f06b0766835f22e8e7d843dc5d3b0893a664562291",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063715"
      ]
    },
    {
      "uid": "zhcn:f8a0260e16697eab6caa3719",
      "kind": "text_data",
      "source_text": "ダイエット成功！",
      "source_fingerprint": "b64ec84e1423a7bc834af33a43841894b90dc76a4d8469854345dbfb29eb9dad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063716"
      ]
    },
    {
      "uid": "zhcn:d87b4d44799ebb89084fa196",
      "kind": "text_data",
      "source_text": "保健室にて",
      "source_fingerprint": "4f11e78e0d41d8ef6aa7a70cc1767ecf335dcd8efcd890b7575bbd97c51b525a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063717"
      ]
    },
    {
      "uid": "zhcn:8015f6639b000441c9fd382a",
