      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063438"
      ]
    },
    {
      "uid": "zhcn:2cf64c08a19c1c817965a9ed",
      "kind": "text_data",
      "source_text": "有馬記念の後に・不壊の奇跡",
      "source_fingerprint": "6eb2cf102662531bee897310c9f9eecee8a586939fdcc8a222fa7489dabfbfa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063439"
      ]
    },
    {
      "uid": "zhcn:83f8515dd01d96f29ea17a6e",
      "kind": "text_data",
      "source_text": "有馬記念の後に・駆ける奇跡",
