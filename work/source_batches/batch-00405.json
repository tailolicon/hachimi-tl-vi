      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063523"
      ]
    },
    {
      "uid": "zhcn:01299afefe06c328d09e6cb7",
      "kind": "text_data",
      "source_text": "星の流れに身を任せ",
      "source_fingerprint": "f18c9966b28d55c1c0516ac48503476a1caf0a155d96cdf5b99cb18036de4795",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063524"
      ]
    },
    {
      "uid": "zhcn:e6c23214d5a9718864762812",
      "kind": "text_data",
      "source_text": "武者震い",
      "source_fingerprint": "4af55be0f8ae08b1cdd3e763245815ae6ce5884e23ba22921a0e5366c34d9214",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063600"
      ]
    },
    {
      "uid": "zhcn:bc45d26621d8d08dee24b7df",
      "kind": "text_data",
      "source_text": "今度こそ！",
      "source_fingerprint": "0022100b97bfc22a1f9a23b9b35b1f58438b8ef8c98a79d874e17949a2d22bfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063601"
      ]
    },
    {
      "uid": "zhcn:213596e89a54c7cc2d937fa9",
      "kind": "text_data",
      "source_text": "寝不足で……",
      "source_fingerprint": "d0c8b9fe16d8655a3cf88410dfd6feeba87a9bfdda5bc2013e0f792cc64a6dd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063700"
      ]
    },
    {
      "uid": "zhcn:73a8590d9259913e8688b457",
