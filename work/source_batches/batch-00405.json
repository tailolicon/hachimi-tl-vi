      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063520"
      ]
    },
    {
      "uid": "zhcn:e19761ef861a7a312729187c",
      "kind": "text_data",
      "source_text": "夜ふかし気味で……",
      "source_fingerprint": "e0f6c8de7f18cec878e69e7d6802b0c497185d81199005943377f97c53e5287b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063521"
      ]
    },
    {
      "uid": "zhcn:09ac4470ce6e4800d1205fd4",
      "kind": "text_data",
      "source_text": "お肌の調子が……",
      "source_fingerprint": "f596eeb9d58881a05631ab3b944e0a8c9cb57e50f3ca36644f8e37ec14aec1d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063522"
      ]
    },
    {
      "uid": "zhcn:eccaaef95819b56155d1852b",
      "kind": "text_data",
      "source_text": "『これ行けんじゃね』で『ドーン！』",
