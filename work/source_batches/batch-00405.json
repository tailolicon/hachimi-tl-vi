      "source_text": "寡黙のうちに",
      "source_fingerprint": "e741ca52b2540d924393bfafde5e5af58139d450d2a37bb76008f50208143d5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063515"
      ]
    },
    {
      "uid": "zhcn:3a6903aae1c44e05ed20d26b",
      "kind": "text_data",
