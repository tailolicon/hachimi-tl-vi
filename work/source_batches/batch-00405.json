      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063437"
      ]
    },
    {
      "uid": "zhcn:23bbd1fa35fa9bda4f62d11b",
      "kind": "text_data",
      "source_text": "マイルCSの後に・強靭の証明",
