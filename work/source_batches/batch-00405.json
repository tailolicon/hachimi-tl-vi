      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063434"
      ]
    },
    {
      "uid": "zhcn:8428d018bfafb48345b042a3",
      "kind": "text_data",
      "source_text": "宝塚記念の後に・交わす約束は",
      "source_fingerprint": "ceeb53ce0f46199facd3627e67b8ef0f8d116aab9c8b85958c46644cab9cef88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063435"
      ]
    },
    {
