      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063702"
      ]
    },
    {
      "uid": "zhcn:464ae8be11f66a04de042087",
      "kind": "text_data",
      "source_text": "時にはこちらが案内を",
      "source_fingerprint": "5346386a37b61deb65c2fb0c361eaeb2a674aa2a52798493e4d414c280d10c0a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501063703"
      ]
    },
    {
      "uid": "zhcn:f409f186d448022aee607d54",
      "kind": "text_data",
