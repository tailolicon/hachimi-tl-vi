      ]
    },
    {
      "uid": "zhcn:9a827b1d39ab9f8bae7f86c0",
      "kind": "text_data",
      "source_text": "秋華賞の後に・秋色の花冠",
      "source_fingerprint": "08b0500a51cdc99a64ba8fc94b128eb7836b1e10a395037cff290a0ce3165610",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086429"
      ]
    },
    {
      "uid": "zhcn:a1f8794c5ee14c32ad6681cc",
      "kind": "text_data",
      "source_text": "有馬記念の後に・誰も疑わぬ",
      "source_fingerprint": "e41c73bd9a311bb5758693aaca656abe104e86ce85d38d6dee3c1894280a8fe5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086430"
      ]
    },
    {
      "uid": "zhcn:328102d0d5bccc102982fffb",
      "kind": "text_data",
      "source_text": "ヴィクトリアマイルの後に・“憧れ”",
      "source_fingerprint": "43442c3874df6b2d0db734c1c9ae02a0b3e181d327d3a862d48d33092edf5672",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086431"
      ]
    },
    {
      "uid": "zhcn:3590b57c0ae60c605d1c5d5f",
      "kind": "text_data",
      "source_text": "宝塚記念の後に・キミとターフを",
      "source_fingerprint": "982ad7c673d471fe8efb8174c3013534218ae026666e2bdcda8f8ce99c37a863",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086432"
      ]
    },
    {
      "uid": "zhcn:7c86990990c4c589cfc2f8a0",
      "kind": "text_data",
      "source_text": "天皇賞（秋）の後に・天狼の味",
      "source_fingerprint": "c99ddd64276f6ea368de56131ae58e971c5aece4e0080dda24e908fdfbc07d4c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086433"
      ]
    },
    {
      "uid": "zhcn:3c34c61192589e6bc24abc6f",
      "kind": "text_data",
      "source_text": "エリザベス女王杯の後に・エスコートを",
      "source_fingerprint": "ea6a3567afc24ad03d1d1c37ea85333f3b3546e221c7552f281f77ebbc30bb42",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086434"
      ]
    },
    {
      "uid": "zhcn:9cd6fd6beb686775bda05b8e",
      "kind": "text_data",
      "source_text": "ジャパンCの後に・至高の愛",
      "source_fingerprint": "d95840d09b43a08fbf17966d587bf219044dcd5445da6cc5959247f3deefdb50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086435"
      ]
    },
    {
      "uid": "zhcn:a15e97df4ebfbbc121e43621",
      "kind": "text_data",
      "source_text": "名指導",
      "source_fingerprint": "6170c1a4213259be0d793955ab8a09729afab90cb50fdd65adc72757d5ae829d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086500"
      ]
    },
    {
      "uid": "zhcn:826d58358c1e0de85e2b8b91",
      "kind": "text_data",
      "source_text": "ダンスレッスン",
      "source_fingerprint": "520b656f7daf6a895b4563cbeb87161b58a7da035f9a65c32d2ed10eb09b67ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086506"
      ]
    },
    {
      "uid": "zhcn:728a1bce045dedfdef3d0c5c",
      "kind": "text_data",
      "source_text": "ファンレター",
      "source_fingerprint": "45b4f82b247703c89cac3a4fab9892f825ed5075ddd213ff15b5c5b9d90bd0ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086507"
      ]
    },
    {
      "uid": "zhcn:ea97216dd10bfea0d849548a",
      "kind": "text_data",
      "source_text": "レース疲れ",
      "source_fingerprint": "1bd227b23f765071f3121f347351bb0a3aab15f8579d5b1b813758e479b879e1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086508"
      ]
    },
    {
      "uid": "zhcn:b8816ebb555f34c11d2a4d55",
      "kind": "text_data",
      "source_text": "連続出走で……",
      "source_fingerprint": "6405d73ec3773a3b44388485cb7e45cf6706ef8fbb29a65ef5ecd59f2e1ff675",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086509"
      ]
    },
    {
      "uid": "zhcn:86c8a42caeba1e927b2111be",
      "kind": "text_data",
      "source_text": "魔性の魔法……？",
      "source_fingerprint": "6b65e1340a1df33c4395a9f786d1bdbe090a4517b84229dbd19ba1f797a37513",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086510"
      ]
    },
    {
      "uid": "zhcn:c6723518d39301f9bc826704",
      "kind": "text_data",
      "source_text": "花々の競演",
      "source_fingerprint": "1e1cf96c0134315a4ec61a8d5348fa650eaf9a5c1e01a266b4815e86a30e533a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086511"
      ]
    },
    {
      "uid": "zhcn:e445f2fa84b4f6fa39446c18",
      "kind": "text_data",
      "source_text": "愛は炎に似ている",
      "source_fingerprint": "4227344ab2944b19f6972909334de4d966cf3cf9f307fccfb5fddaec6dce8da2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086513"
      ]
    },
    {
      "uid": "zhcn:84c32bed511715451f228a05",
      "kind": "text_data",
      "source_text": "花、香る",
      "source_fingerprint": "bf8d9aebb28e477677b19100b6eb9e6bca7c6405f3d91480ac14e8169b25fa13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086514"
      ]
    },
    {
      "uid": "zhcn:ef16afd76328459e8632bbbb",
      "kind": "text_data",
      "source_text": "その心、揺さぶられるは",
      "source_fingerprint": "43eb0197125d01a0c1dcef77bd549dfdf0b52fbe4740caaa2b117a75483542a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086515"
      ]
    },
    {
      "uid": "zhcn:9321d6b2772ba4005ad5ea75",
      "kind": "text_data",
      "source_text": "愛を注ぐ器のために",
      "source_fingerprint": "8d104394afb916ac11d3e673d40daf609755ac96feceb34a662eaf1cfa7df108",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086516"
      ]
    },
    {
      "uid": "zhcn:00d69425a0a2c5d4105c2840",
      "kind": "text_data",
      "source_text": "愛のための下ごしらえ",
      "source_fingerprint": "c007a010f3cf495360f80955b559fcafa3ae1ed9062ffa638c059d20a933849e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086517"
      ]
    },
    {
      "uid": "zhcn:858aefeaa2946738bd5eb1a6",
      "kind": "text_data",
      "source_text": "お気に入りの瞳",
      "source_fingerprint": "6ef5ca3605317fe3541103470370412d640fe4a95cae565f0c3164640ad83bb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086518"
      ]
    },
    {
      "uid": "zhcn:e3fdef76d882f068629d38e9",
      "kind": "text_data",
      "source_text": "愛を描くということ",
      "source_fingerprint": "2a9fd03d4df43af97897943b09690a4adade5c92c08a16aa0832ed6d634be579",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086519"
      ]
    },
    {
      "uid": "zhcn:55d8e6234053da4e15fd6430",
      "kind": "text_data",
      "source_text": "アウトオブアイズな昼下がり",
      "source_fingerprint": "8cd630bc1a0cbaef6a94855d791e9e2b7f0d62250d5294972240d816b02f23a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086520"
      ]
    },
    {
      "uid": "zhcn:d2a4b90f05e36ec3d8b9eb11",
      "kind": "text_data",
      "source_text": "夜ふかし気味で……",
      "source_fingerprint": "e0f6c8de7f18cec878e69e7d6802b0c497185d81199005943377f97c53e5287b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086521"
      ]
    },
    {
      "uid": "zhcn:5fd26206fabec2a5b45f2e83",
      "kind": "text_data",
      "source_text": "お肌の調子が……",
      "source_fingerprint": "f596eeb9d58881a05631ab3b944e0a8c9cb57e50f3ca36644f8e37ec14aec1d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086522"
      ]
    },
    {
      "uid": "zhcn:44cf94686b83273b900c2d94",
      "kind": "text_data",
      "source_text": "愛、美、幸福――そしてラーメン",
      "source_fingerprint": "41e9a6a007a5004bb0fa5eaeadbb263bc349a466f573f726ea69d8fad0f66f3b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086523"
      ]
    },
    {
      "uid": "zhcn:24feca733933d65b9d1944ff",
      "kind": "text_data",
      "source_text": "この愛は、尽きることなく",
      "source_fingerprint": "9d430303112c4061d78f92bdbb53dff28e1f77232f9d84165be0a6b19ff802d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086524"
      ]
    },
    {
      "uid": "zhcn:aa97f79736cee92cf3018262",
      "kind": "text_data",
      "source_text": "武者震い",
      "source_fingerprint": "4af55be0f8ae08b1cdd3e763245815ae6ce5884e23ba22921a0e5366c34d9214",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086600"
      ]
    },
    {
      "uid": "zhcn:a488ea0ec5e535bb5dd1a5e2",
      "kind": "text_data",
      "source_text": "今度こそ！",
      "source_fingerprint": "0022100b97bfc22a1f9a23b9b35b1f58438b8ef8c98a79d874e17949a2d22bfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086601"
      ]
    },
    {
      "uid": "zhcn:ac7749d6478a0206f58a2dd9",
      "kind": "text_data",
      "source_text": "寝不足で……",
      "source_fingerprint": "d0c8b9fe16d8655a3cf88410dfd6feeba87a9bfdda5bc2013e0f792cc64a6dd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086700"
      ]
    },
    {
      "uid": "zhcn:c3fe94835795ca642f553d4a",
      "kind": "text_data",
      "source_text": "休息はバッチリ！",
      "source_fingerprint": "94bed783f8892adc5530b76839b280d8759a4301b02ce45baa7aa5b4249fe3ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086701"
      ]
    },
    {
      "uid": "zhcn:21329de2867aa07044e5d04d",
      "kind": "text_data",
      "source_text": "高貴なる蝶に見惚れて",
      "source_fingerprint": "44d8952a45833471f2e3b728d3053ef7e2ec0031f33ba923bdf07283fbcd72e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086702"
      ]
    },
    {
      "uid": "zhcn:640459803bd53d8d1ad19c52",
      "kind": "text_data",
      "source_text": "蝶を夢見て繭紡ぐ",
      "source_fingerprint": "a7e94d4fd2f0c23b99a12f8ab9d6b3d7579ccbe6c67091ff665a334b640e3008",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086703"
      ]
    },
    {
      "uid": "zhcn:aa7a16879f22d0167974cdaf",
      "kind": "text_data",
      "source_text": "高貴なる蝶々",
      "source_fingerprint": "914e24824c8708951839de6ad048490f54476f649a8fc4659a77753faed058fb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086704"
      ]
    },
    {
      "uid": "zhcn:3547629738ad2f579db6454a",
      "kind": "text_data",
      "source_text": "考えるまでもなく",
      "source_fingerprint": "de9f63d26f810175ed1af7336bb69b4b899084068148563caeaf16429fe8cc1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086705"
      ]
    },
