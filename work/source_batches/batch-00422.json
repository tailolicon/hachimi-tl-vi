    },
    {
      "uid": "zhcn:2df8fe1204bff2b2442a8465",
      "kind": "text_data",
      "source_text": "オークスの後に・樫は堅く",
      "source_fingerprint": "7afe5a8bcffddc98ab1bfc949870065601f59f1705dfecb40d97f4cd652310af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501086427"
      ]
    },
    {
      "uid": "zhcn:1ffaeb58c6af2bdc93000024",
      "kind": "text_data",
      "source_text": "秋華賞の後に・麗しきトリプルティアラ",
      "source_fingerprint": "7ec426e99a3ef600b6d98713dfffd0ce1cee5217be4416f45bfb13d45089eb41",
      "source_path": "text_data_dict.json",
