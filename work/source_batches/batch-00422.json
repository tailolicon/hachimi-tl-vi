    },
    {
      "uid": "zhcn:07ac6ca4f69dda0dd3c3d115",
      "kind": "text_data",
      "source_text": "オークスの後に・樫で織る",
      "source_fingerprint": "8f4653f21cbe01840f0db420296e057edfe60a467951a7fbe0a52e9a8dc80845",
      "source_path": "text_data_dict.json",
