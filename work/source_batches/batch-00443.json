      "source_text": "助けを求められるのは……",
      "source_fingerprint": "6e2a92a712c03a6c824a7c59516c3a7e128c7760004ff6ff15343bc4e06edd9c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089519"
      ]
    },
    {
      "uid": "zhcn:9fc3065c4f6fb919d9dfc403",
