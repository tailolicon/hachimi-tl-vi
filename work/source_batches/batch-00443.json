      "source_text": "これで大丈夫です……",
      "source_fingerprint": "e4e7be3edfcd2582aaafb5b42a7a3020994c7ca8c10ad6d9dd20d5dc78063ae5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089517"
      ]
    },
    {
      "uid": "zhcn:34e70b2a5bbfd4580f11825d",
      "kind": "text_data",
      "source_text": "ぶきような昼下がり",
      "source_fingerprint": "63f0f5732a85cdde36bd5e3c56fb40464704525477fd287326da8634cb73b912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089518"
      ]
    },
    {
      "uid": "zhcn:2bc7b09afcce196491c62f1b",
