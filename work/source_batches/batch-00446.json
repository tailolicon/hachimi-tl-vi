        "181",
        "501089431"
      ]
    },
    {
      "uid": "zhcn:eb1018976f129701d814c99b",
      "kind": "text_data",
      "source_text": "目标达成后・点燃觉悟之火",
      "source_fingerprint": "a17fb45e882d0e873ef05ba74a1dad68eb7cf9e0c009597f069d0c35a368701e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089432"
      ]
    },
    {
      "uid": "zhcn:5b0d3d2dd45c7e6598b2f9c9",
      "kind": "text_data",
      "source_text": "阪神大赏典后・巨大的变革",
      "source_fingerprint": "dda4cb295bb95d3c0d7c3251cc6fb3353b494abd92c01b2f744f194a535bad22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089433"
      ]
    },
    {
      "uid": "zhcn:e809d47b1902ef03bf7a2b50",
      "kind": "text_data",
      "source_text": "天皇赏（春）后・与并不相似的你",
      "source_fingerprint": "5fdafc6583f3cad0b6c656d2263a95fe4b836b70f790bc215aa98c69b946c493",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089434"
      ]
    },
    {
      "uid": "zhcn:e0c2cf08083dadea1cd73e2e",
      "kind": "text_data",
      "source_text": "宝冢纪念之后・遭遇波涛",
      "source_fingerprint": "48cb94cb67b5e7155380ff2a6b6202d01998e7e79384c6b54fcc52213d5e633c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089435"
      ]
    },
    {
      "uid": "zhcn:3e3d7234c7832b3de43bb1f7",
      "kind": "text_data",
      "source_text": "京都大赏典之后・噩耗",
      "source_fingerprint": "dc608bba9a373c6dece77fbdf6944b6483e24cd0376f58b1ecc52bd0e198c81a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089436"
      ]
    },
    {
      "uid": "zhcn:ddba292ccc9090ae1e91bc4a",
      "kind": "text_data",
      "source_text": "伊丽莎白女王杯之后・三姐妹",
      "source_fingerprint": "182c27126b624c3424c85df5e5c901d4cd1a1ba25e1bd4cc02351b4fd0b7305e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089437"
      ]
    },
    {
      "uid": "zhcn:6b3b08defe6ebd3a0bc39b82",
      "kind": "text_data",
      "source_text": "日本杯之后・“伟大的赛马娘”",
      "source_fingerprint": "89e4bf159561525f6089388cc4577ae1390a6635a2cd829d2b07535a7ef20da6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089438"
      ]
    },
    {
      "uid": "zhcn:c8d1d53794b0323d086a47d7",
      "kind": "text_data",
      "source_text": "名指导",
      "source_fingerprint": "73d76c90aad34394dfec642f4758203206bff1d5b8ed3beddced420674c37031",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089500"
      ]
    },
    {
      "uid": "zhcn:bf16490ac6a2b36dcef9d925",
      "kind": "text_data",
      "source_text": "舞蹈课",
      "source_fingerprint": "77ac56988e82c41549b32a6a6603ec9c5a3fc495083b9808222b02d214a82269",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089506"
      ]
    },
    {
      "uid": "zhcn:3aadc707cb584d3bd0877fa3",
      "kind": "text_data",
      "source_text": "粉丝来信",
      "source_fingerprint": "46257e0fd128c9a70691058bca678a94f526fa9918e5e2f80c0e4f979ca8385d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089507"
      ]
    },
    {
      "uid": "zhcn:ee835860a5eebd77d9b3ca3e",
      "kind": "text_data",
      "source_text": "比赛疲劳",
      "source_fingerprint": "7a143fcef2befe014ed7e2793b7c4c0de892e51ac65509f10d3bd2febb2ea6aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089508"
      ]
    },
    {
      "uid": "zhcn:60da0834282d9e61d282f8b9",
      "kind": "text_data",
      "source_text": "连续参赛之后……",
      "source_fingerprint": "96b1ffe809203d91c996123c7e38bf0cf382bcc71ec20ceae613b1e82a91a58a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089509"
      ]
    },
    {
      "uid": "zhcn:29a6655154b6dee4a3ddbf14",
      "kind": "text_data",
      "source_text": "至少今天我也想……",
      "source_fingerprint": "c296460378655b40c43c241f8f9f495a2e5a60eb52cf67c2b2c9f0878e58dd26",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089510"
      ]
    },
    {
      "uid": "zhcn:2f905f26bc3401dcbd70a21b",
      "kind": "text_data",
      "source_text": "我得想办法才行……！",
      "source_fingerprint": "09d3ba76cf64966586b82cd9c316597e9452af43cf228ec9e5db3a83377e9b15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089511"
      ]
    },
    {
      "uid": "zhcn:f01677e68803312ac484b674",
      "kind": "text_data",
      "source_text": "更远，更高",
      "source_fingerprint": "933982b48ee31116e2fe218dcd4aa323846aee5ef8da981c94f5ce6466ca9fb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089513"
      ]
    },
    {
      "uid": "zhcn:13dcf41ab43d394dd74a1fd5",
      "kind": "text_data",
      "source_text": "悄悄地，埋头苦干",
      "source_fingerprint": "0ae4d822a84a7c9cd82c8c7fd017eaf75a5d31aa5342eb7db75001bafa615830",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089514"
      ]
    },
    {
      "uid": "zhcn:b20913444fab1105a19b1660",
      "kind": "text_data",
      "source_text": "吃得饱饱，全力以赴",
      "source_fingerprint": "61a359c867cf1755126b9de6554bcbc4cd17d4cda1fd44a1e9e17742a307d03a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089515"
      ]
    },
    {
      "uid": "zhcn:b3698f2c7e3847c0e927498a",
      "kind": "text_data",
      "source_text": "诱惑也是超大份？",
      "source_fingerprint": "412b4976969ff2d3a3aabf2ace3fd481e164040e2cdf502b628d60a61c9844f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089516"
      ]
    },
    {
      "uid": "zhcn:7abcc405219c72da2e12ed30",
      "kind": "text_data",
      "source_text": "这样就没问题了……",
      "source_fingerprint": "a8a18c8f3f432ad8c6902b85a4e35e85b17f42dafa33c7e3bbf4d5a00942864e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089517"
      ]
    },
    {
      "uid": "zhcn:34e70b2a5bbfd4580f11825d",
      "kind": "text_data",
      "source_text": "笨拙的午后",
      "source_fingerprint": "98a6908cab399104c7defcc910bd76f47e1158dad81f85e20395e7ff26c9bcc8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089518"
      ]
    },
    {
      "uid": "zhcn:2bc7b09afcce196491c62f1b",
      "kind": "text_data",
      "source_text": "被人求助的话……",
      "source_fingerprint": "0fd5f7eb327c8d8a904442cfadd496df7219ead4432f56677f39074e5a77fdd6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089519"
      ]
    },
    {
      "uid": "zhcn:9fc3065c4f6fb919d9dfc403",
      "kind": "text_data",
      "source_text": "小小的体贴",
      "source_fingerprint": "8d3dfa94175b6df4c2f168bd9570e56608f5c7f9ed7f856438f5bc4dbd9b89d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089520"
      ]
    },
    {
      "uid": "zhcn:8be0ff202d8aab0e976b7409",
      "kind": "text_data",
      "source_text": "时常熬夜……",
      "source_fingerprint": "b1da304e4842e8dd030e7b2a5b7a1d43d21772d6d6b5040413062d8e063b3248",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089521"
      ]
    },
    {
      "uid": "zhcn:27d95ba884f22ee9372109e7",
      "kind": "text_data",
      "source_text": "皮肤状态不太好……",
      "source_fingerprint": "3f94b6d347e08cd87b5a8b8783a54c48a2c33e50d07181e03ad89e99e09cfbbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089522"
      ]
    },
    {
      "uid": "zhcn:572ff9596b9cbac686a3c9e2",
      "kind": "text_data",
      "source_text": "踏步的诀窍",
      "source_fingerprint": "fa353e6d578db1a544030aabb32f34919f7f00251331dbbc2b6b75619b88e796",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089523"
      ]
    },
    {
      "uid": "zhcn:389a2f023d79798583b8b417",
      "kind": "text_data",
      "source_text": "偶尔也吃点点心",
      "source_fingerprint": "34f2378749ad351c8e36dedec0066682acd70be9192ab610841fbb53022ff5f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089524"
      ]
    },
    {
      "uid": "zhcn:c9ee0cfff73123bc3204a958",
      "kind": "text_data",
      "source_text": "临阵抖擞",
      "source_fingerprint": "2f465f55872e2c87a082f27cd4280362c590038dcd5fcd11b5cff5fa2f045c91",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089600"
      ]
    },
    {
      "uid": "zhcn:720686c64e34384d479e41f9",
      "kind": "text_data",
      "source_text": "这次一定！",
      "source_fingerprint": "4d5f0e7d8437cc1e2f211add2fad5f8d227061b2521db6517b0aed1179248a30",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089601"
      ]
    },
    {
      "uid": "zhcn:b926efae2d9fa10a96c98386",
      "kind": "text_data",
      "source_text": "睡眠不足……",
      "source_fingerprint": "caeed6d03df692f4f73de57772fb647413532cce79cabdac99ae1be5893ce1f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089700"
      ]
    },
    {
      "uid": "zhcn:e26def0ef82b8f1029e21ed3",
      "kind": "text_data",
      "source_text": "休息得很充足！",
      "source_fingerprint": "0b1bfeaf87405269d36feda1d66bd3fe2f383769315660bc5069ceeda2e11e0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089701"
      ]
    },
    {
      "uid": "zhcn:d2a3334fe8b77e55d8e81719",
      "kind": "text_data",
      "source_text": "一点也不开心，对吧……",
      "source_fingerprint": "7239c46d2db5d19d9220886aa01df03b2fa6e51f5162200f2d108286bb8fdfb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089702"
      ]
    },
    {
      "uid": "zhcn:495c65ad7cb50b4ca59540dd",
      "kind": "text_data",
      "source_text": "……真的玩得，很开心吗？",
      "source_fingerprint": "d2dcd263dd510362654ffa0e0ab08f4545c6a07fef01e56ecabedb388287cfa0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089703"
      ]
    },
    {
      "uid": "zhcn:e70873b4dbcb7ef86a132668",
      "kind": "text_data",
      "source_text": "就、就连我，也很开心",
      "source_fingerprint": "0b2e32ee00165b64cc8cc52b4511e5906c8d8f9d393eb4064abd635f0be4e2dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089704"
      ]
    },
    {
      "uid": "zhcn:32ca27aa9ce17221fc87ccb2",
      "kind": "text_data",
      "source_text": "为了我们的伙伴，鼓起勇气！",
      "source_fingerprint": "191a1dd79bb012c4c860f44128b5787693da8cdab1844aca281ca0bbff145ba9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089705"
      ]
    },
    {
      "uid": "zhcn:42dbe6696b5e23f4851c0b6e",
      "kind": "text_data",
      "source_text": "悠悠地，顺势而行",
      "source_fingerprint": "834befa029e2aa1c186fc0d92a8f952a974c12a9454bff8f82af4b3f4e47c7fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089706"
      ]
    },
    {
      "uid": "zhcn:38aa9b9df8cf77106fcf6173",
      "kind": "text_data",
      "source_text": "在神社祈福！",
      "source_fingerprint": "a8749a7b2fe6d2b3615a7aa07347702959729a5de9b60190069e869559a0e356",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089707"
      ]
    },
    {
      "uid": "zhcn:e65b414854a72e1d293c7eae",
      "kind": "text_data",
      "source_text": "比赛胜利！",
      "source_fingerprint": "ec26f4ee0698aede003232088c845008815050ef4c42ee145c7666351bfb7c74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089708"
      ]
    },
    {
      "uid": "zhcn:344e5bc5488e56fb482115cb",
      "kind": "text_data",
      "source_text": "比赛入着",
      "source_fingerprint": "87eac458e8eb6fb74350c2fb833e121ff8e8e8aa8cc389a5268a45b03af3a25d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089709"
      ]
    },
    {
      "uid": "zhcn:43b383ddbacad9a158401c94",
      "kind": "text_data",
      "source_text": "比赛败北",
      "source_fingerprint": "b6f93f65c9d96a1018526a72cfa1451fff4f5cce964fb3b5d50b0870258e0569",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089710"
      ]
    },
    {
      "uid": "zhcn:c23cb98e160bbceef012d2f5",
      "kind": "text_data",
      "source_text": "下次绝对不会输！",
      "source_fingerprint": "fb706cedbb847c70dcf59946440cff23885802e72bec44da0b7af98997f0ea57",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089711"
      ]
    },
    {
      "uid": "zhcn:d9e188e1e27b4b16029beba3",
      "kind": "text_data",
      "source_text": "不在场的理由是……",
      "source_fingerprint": "e129146029cac0db5ac5913a81a44243e572ae0d1cb4be57408eb8652baf08fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089712"
      ]
    },
    {
      "uid": "zhcn:b7d7e7b50b8ddcf8ac1b4f54",
      "kind": "text_data",
      "source_text": "请多保重！",
      "source_fingerprint": "11e55e10385bcda2d60bcf0d6e172cb88a4bbce40790279e79083a2e56f17d7e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089713"
      ]
    },
    {
      "uid": "zhcn:44923bb9e77bbb049c44cf2c",
      "kind": "text_data",
      "source_text": "禁止勉强！",
      "source_fingerprint": "7dfe17c34f2db04a4fa48e7ac5162e45f132f6e8d2ec494388f28bd3c09cd04f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089714"
      ]
    },
    {
      "uid": "zhcn:9c11979c9edcd0bbd1145b9f",
      "kind": "text_data",
      "source_text": "追加的自主训练",
      "source_fingerprint": "643f88a7ae46b00f4a1f80be810060acd10a095fdccd5e2a9f0bd0ea9985e31c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089715"
      ]
    },
    {
      "uid": "zhcn:7859c25a729f3f31435c04ce",
      "kind": "text_data",
      "source_text": "减肥成功！",
      "source_fingerprint": "699d4d83058f767f2a2d15e07591d3ba053022d15704ad5c30e67600b395ee0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089716"
      ]
    },
    {
      "uid": "zhcn:aa88943902ef4de59096f653",
      "kind": "text_data",
      "source_text": "在保健室里",
      "source_fingerprint": "e13acdb5de813c633b4a47dcd1db8f157acb08541395b662890397c24da52aa0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089717"
      ]
    },
    {
      "uid": "zhcn:674d84489b4becd5200e783d",
      "kind": "text_data",
      "source_text": "恢复精神了",
      "source_fingerprint": "386ea8b7b051fae8e85c57abd0fc7232c888cc7b21cc19506a7ab387c0b4af6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089718"
      ]
    },
    {
      "uid": "zhcn:42312a8e61c58547cc92d1a2",
      "kind": "text_data",
      "source_text": "要是被步步紧逼的话……！",
      "source_fingerprint": "5e8fa09befa0ff32e128ec19d5a9e987ea9bc27653b2bca652fdb38cff019573",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089719"
      ]
    },
    {
      "uid": "zhcn:af90113f0dc9b643fe87eab1",
      "kind": "text_data",
      "source_text": "安心～笹针师，登☆场",
      "source_fingerprint": "31cb10f0596acbf0c1fa43cff0e5994734c82ba1b92a7a32d1070fed57a83c6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089720"
      ]
    },
    {
      "uid": "zhcn:c7cd588e2aca81faf040e2dd",
