      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089418"
      ]
    },
    {
      "uid": "zhcn:10f37da7824b27b6e6580801",
      "kind": "text_data",
      "source_text": "目标达成后・闪耀的同期们",
      "source_fingerprint": "124af950a7b6929523969aeda8918d8c27fc9bb67435aaaeeeed644211e38ce0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089419"
      ]
    },
    {
      "uid": "zhcn:d93658182c1f2ebbb127a996",
      "kind": "text_data",
      "source_text": "皋月赏之后・逼近的“巨浪”",
      "source_fingerprint": "81c8ad5f3438f63cc0e57125e8739e1762094d5b8a3d373cf44ff8f6984739ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089420"
      ]
    },
    {
      "uid": "zhcn:592d9472f89fddbc31e47117",
      "kind": "text_data",
      "source_text": "皋月赏之后・“血脉”的荣耀",
      "source_fingerprint": "1b43161453bad0008fe0a13e72b24fc434ffc7de63e1a45cddea107b089dcbbe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089421"
      ]
    },
    {
      "uid": "zhcn:d8b3be497bd7186056fdd2a2",
      "kind": "text_data",
      "source_text": "皋月赏之后・所展示的“觉悟”",
      "source_fingerprint": "14830769aa111ba26a329e4ef1825671932c0d23a6ba5e34cb148823cb1e0465",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
