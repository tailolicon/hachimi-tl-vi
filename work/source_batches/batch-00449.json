      "source_fingerprint": "106f313ca9ffabd891b2d4fc9651e0f34974e82e44125abd86295dd1aacff9ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089423"
      ]
    },
    {
      "uid": "zhcn:d74b20c55a40f4dcaea15b92",
      "kind": "text_data",
      "source_text": "日本德比之后・即便成为了世代最强",
      "source_fingerprint": "0f51829ddb5b8848a8c9cead3bb8fd8db4ac53b6a110734fc05bcf3f73683ecc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089424"
      ]
    },
    {
      "uid": "zhcn:f869c929bcb4be2c432ab075",
      "kind": "text_data",
      "source_text": "日本德比之后・“觉悟”的缺失",
      "source_fingerprint": "a01fcff26ff189d4fe3699b583916157efc7d91cb63bbbb53772a6375f3f09da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089425"
      ]
    },
    {
      "uid": "zhcn:eea0f5616710c90321acfb9d",
      "kind": "text_data",
      "source_text": "日本德比之后・不足的心情",
      "source_fingerprint": "4859e73b8f4789bad2e90128a74a4214fabdee33c7a57b31b55197b9e522aa0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089426"
      ]
    },
    {
      "uid": "zhcn:8c8b74fba96e6353a69b0cbf",
      "kind": "text_data",
      "source_text": "最强，如此说道",
      "source_fingerprint": "8fc55500189848dd73a8bc63fcf215dde9df3caf4fbb02d15235370786fc14a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089427"
      ]
    },
    {
      "uid": "zhcn:e3171c25a516df4da860586c",
      "kind": "text_data",
      "source_text": "菊花赏之后・面向作为竞争对手的你",
      "source_fingerprint": "d04e4df4cfdac5f550b00b7f9001c9214f36264602e6071a01165feb3137af7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089428"
      ]
    },
    {
      "uid": "zhcn:50182894f9829fe8e6d7776c",
      "kind": "text_data",
      "source_text": "菊花赏之后・耀眼的你",
      "source_fingerprint": "f6686b7e827d498e7e7182f1accc90df78a217d99ef899bb7e7189b82a58fc4e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089429"
      ]
    },
    {
      "uid": "zhcn:409bb37aacde6c2de82f5fb5",
      "kind": "text_data",
      "source_text": "菊花赏之后・一同站起……",
      "source_fingerprint": "ce2fc8e011e03a8bfa2e30d0cd05e19ff5d191f2be3cc83ebfa8e2e11e8a9f88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089430"
      ]
    },
    {
      "uid": "zhcn:76557868bb09b6832b1aad11",
      "kind": "text_data",
      "source_text": "追逐你的背影",
      "source_fingerprint": "e33763b58d707b7485e6f85cdb16cfdb23ffbbe89732e2632a5557aaadcfcad7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089431"
      ]
    },
    {
      "uid": "zhcn:eb1018976f129701d814c99b",
      "kind": "text_data",
      "source_text": "目标达成后・点燃觉悟之火",
      "source_fingerprint": "a17fb45e882d0e873ef05ba74a1dad68eb7cf9e0c009597f069d0c35a368701e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089432"
      ]
    },
    {
      "uid": "zhcn:5b0d3d2dd45c7e6598b2f9c9",
      "kind": "text_data",
      "source_text": "阪神大赏典后・巨大的变革",
      "source_fingerprint": "dda4cb295bb95d3c0d7c3251cc6fb3353b494abd92c01b2f744f194a535bad22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089433"
      ]
    },
    {
      "uid": "zhcn:e809d47b1902ef03bf7a2b50",
      "kind": "text_data",
      "source_text": "天皇赏（春）后・与并不相似的你",
      "source_fingerprint": "5fdafc6583f3cad0b6c656d2263a95fe4b836b70f790bc215aa98c69b946c493",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089434"
      ]
    },
    {
      "uid": "zhcn:e0c2cf08083dadea1cd73e2e",
      "kind": "text_data",
      "source_text": "宝冢纪念之后・遭遇波涛",
      "source_fingerprint": "48cb94cb67b5e7155380ff2a6b6202d01998e7e79384c6b54fcc52213d5e633c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089435"
      ]
    },
    {
      "uid": "zhcn:3e3d7234c7832b3de43bb1f7",
      "kind": "text_data",
      "source_text": "京都大赏典之后・噩耗",
      "source_fingerprint": "dc608bba9a373c6dece77fbdf6944b6483e24cd0376f58b1ecc52bd0e198c81a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501089436"
      ]
    },
    {
      "uid": "zhcn:ddba292ccc9090ae1e91bc4a",
