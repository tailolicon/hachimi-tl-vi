      "kind": "text_data",
      "source_text": "保健室にて",
      "source_fingerprint": "4f11e78e0d41d8ef6aa7a70cc1767ecf335dcd8efcd890b7575bbd97c51b525a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121717"
      ]
    },
