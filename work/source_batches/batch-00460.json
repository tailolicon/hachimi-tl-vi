      "source_text": "レース入着",
      "source_fingerprint": "e4d0bf03e5655cac21b58856d1003b726f71b11b71eb48edbe420038d6c33e15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121709"
      ]
    },
    {
      "uid": "zhcn:cb84d88ab17cc51a60f5d659",
      "kind": "text_data",
      "source_text": "レース敗北",
      "source_fingerprint": "e44ca7b679cb69d01b24af5ea35ca7c562e4b81ae32c6f488a437577af14a73e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121710"
      ]
    },
    {
      "uid": "zhcn:59d992d87cbd56376a3e64ba",
      "kind": "text_data",
      "source_text": "今度こそ負けない！",
      "source_fingerprint": "1a4987e705d288580f95307601ec77f5f393ccd07975e9844dcd744fb89c5cf4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121711"
      ]
    },
    {
      "uid": "zhcn:5545ac9ddba1a5d326828a4e",
      "kind": "text_data",
      "source_text": "不在の理由は……",
      "source_fingerprint": "e84e2b559d6ea65f431c50d18fb74ec2bbd2beed0b5e51cc7ec887704b624f21",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121712"
      ]
    },
    {
      "uid": "zhcn:943e0da5381707050c65baf7",
      "kind": "text_data",
      "source_text": "お大事に！",
      "source_fingerprint": "aebb445d34696cd39b4a804392bf4f3ace4b667d7bf2a8e2ba89b020cacc3256",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121713"
      ]
    },
    {
      "uid": "zhcn:a762738b8333f504196d36a5",
      "kind": "text_data",
      "source_text": "無茶は厳禁！",
      "source_fingerprint": "078bda01e710c8304595761b5a262bd745227d9951b5d0b894fccb1531a59157",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121714"
      ]
    },
    {
      "uid": "zhcn:ad767c967709ec1438c40a0f",
      "kind": "text_data",
      "source_text": "追加の自主トレ",
      "source_fingerprint": "02d0e195f7b5ccf45b9e52f06b0766835f22e8e7d843dc5d3b0893a664562291",
      "source_path": "text_data_dict.json",
      "json_path": [
