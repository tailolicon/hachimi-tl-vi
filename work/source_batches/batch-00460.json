      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121706"
      ]
    },
    {
      "uid": "zhcn:2c62b5a619b3481caf73d7a2",
      "kind": "text_data",
      "source_text": "神社でお祈り！",
      "source_fingerprint": "06b731b66c3603a32c1cac4b4908776cc86635a0de8a2efa50ba8073f31fb180",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121707"
      ]
    },
    {
      "uid": "zhcn:5fb3d76b5f7a56ee52d32aa2",
      "kind": "text_data",
      "source_text": "レース勝利！",
      "source_fingerprint": "41790a1b5f8d0e645951f342cc052cc2c0f1183fe6a662072b935a3d6098a1fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121708"
      ]
    },
    {
      "uid": "zhcn:dbdd77fd38ef240b166a32b4",
