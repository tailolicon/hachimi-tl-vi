      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121702"
      ]
    },
    {
      "uid": "zhcn:94ef28f86e1a84b27eed322d",
      "kind": "text_data",
      "source_text": "その助力、恩返しにつき",
      "source_fingerprint": "1713fda19f86f80c484f7cced86a4aa11e98ebf2ffa3782c0f950410fb341a9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121703"
      ]
    },
    {
      "uid": "zhcn:b0b6c7bdc8ab7243ac2e387c",
