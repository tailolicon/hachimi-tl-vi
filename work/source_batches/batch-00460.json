      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501121705"
      ]
    },
    {
      "uid": "zhcn:d66c9d2cf11fcd5a938a7bf2",
      "kind": "text_data",
      "source_text": "結成、聖騎士団",
