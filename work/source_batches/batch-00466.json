      "source_fingerprint": "e3d046842c43767ccb24a5c2a9a9d0b17ced7a660df07243686ca1066d06298e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501120516"
      ]
    },
    {
      "uid": "zhcn:be6bbc0fc57bda2277a09c9e",
      "kind": "text_data",
      "source_text": "早すぎたせいで",
      "source_fingerprint": "a06bbbea7ad8fff184e8f57a02e8f9243ee4fec352c38c05f784abeb148a66db",
      "source_path": "text_data_dict.json",
