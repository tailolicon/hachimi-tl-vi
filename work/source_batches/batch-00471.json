        "181",
        "809042001"
      ]
    },
    {
      "uid": "zhcn:6d34b62e2729ae852bede747",
      "kind": "text_data",
      "source_text": "毛头小子，保持积极吧",
      "source_fingerprint": "dbacf3e001cfe1e5ad2036f71d4bed6fe7965f0d72893e18d6b8d225d5707b55",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
