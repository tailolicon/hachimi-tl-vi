      "source_text": "本能的训练",
      "source_fingerprint": "8788ff7668c9faaaf2dc8a1a8cf4a64ef342c493c34109b1d9f22e4e966b99d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049032"
      ]
    },
    {
      "uid": "zhcn:b87b1b2670204fd44ab6ff30",
