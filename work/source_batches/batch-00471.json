      "source_fingerprint": "048155ab2914e74b9858b54083e233515761ff1236ce2c9437710aff70292084",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043002"
      ]
    },
    {
      "uid": "zhcn:57101b30c31efa45ec4454b4",
      "kind": "text_data",
      "source_text": "お疲れ様！！",
      "source_fingerprint": "aa651f0a70a1005919d8a7fd4f34f34034db3ef60d00d895806bc166fcc63386",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043003"
      ]
    },
    {
      "uid": "zhcn:93fd90ffa10d7ae84cd4673c",
      "kind": "text_data",
      "source_text": "時には仕事を忘れて",
      "source_fingerprint": "7008dda7205dcdef693fddb435c20dc3e68ef7da208cf19d0d3067e98a57c1fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043004"
      ]
    },
    {
      "uid": "zhcn:0fe1904b07bac610c98ddc53",
      "kind": "text_data",
      "source_text": "礼賛は雨のように",
      "source_fingerprint": "2b647346d2d4c7b73714954969fd46100f4a0e1ddd9e655f12d9b80cc9f60114",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043005"
      ]
    },
    {
      "uid": "zhcn:3d932e0360f2d8c8ec7742bc",
      "kind": "text_data",
      "source_text": "克服は近い未来に？",
      "source_fingerprint": "d38eebce85152aa0c1d73bbed2fefe71812566c7f3c3d9f623962659af3d8ca0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043006"
      ]
    },
    {
      "uid": "zhcn:59f1506b9395d3c369bd3429",
      "kind": "text_data",
      "source_text": "縁がいずれ行きつくは",
      "source_fingerprint": "b00a2948958185f1fa6b2405d155bde8119aed99ef0a5c96b64e640f74657453",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043007"
      ]
    },
    {
      "uid": "zhcn:55b9128876a06992560bd846",
      "kind": "text_data",
      "source_text": "憧憬は始まりの地に",
      "source_fingerprint": "0bc90072374f26cd70aeaf59a063c75110d27b3849daf05f0c2dc99f3aec412c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043008"
      ]
    },
    {
      "uid": "zhcn:06ec187f2270f0bf59242706",
      "kind": "text_data",
      "source_text": "星の凱旋門",
      "source_fingerprint": "8eacf510263612f3237dac339a1ea86801f35d5edb43e85af9e934e9bc44ffc5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043009"
      ]
    },
    {
      "uid": "zhcn:6079d9c8fbf6e61ce0cbbde5",
      "kind": "text_data",
      "source_text": "祝杯の前払い",
      "source_fingerprint": "50a8b0bd40905a6d24abb800b15f1fcd27e1625711f747c8023732b0d5eaaa8b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043010"
      ]
    },
    {
      "uid": "zhcn:0562c8f368b7c772a5d71d91",
      "kind": "text_data",
      "source_text": "メイとの絆・『夢』は難しい",
      "source_fingerprint": "0a0e412b4b515e5c3c21c935403afdc51cd1cd0beb2b023fdedc24d067377637",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809043011"
      ]
    },
    {
      "uid": "zhcn:1f2ae3659019c2690bd77c4e",
      "kind": "text_data",
      "source_text": "忙しいは楽しい！",
      "source_fingerprint": "ce7b95818d86725e588ae3f29ffbc3cb396287be628d46a22364226c18bfbfab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044001"
      ]
    },
    {
      "uid": "zhcn:c95e16ebcbc02cb8b2b6863a",
      "kind": "text_data",
      "source_text": "広がる笑顔",
      "source_fingerprint": "14c4a3ce5fb6400af35a25fdea1c238cfa7ca8a4f011983e474a0d4e76e95dea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044002"
      ]
    },
    {
      "uid": "zhcn:81354a7c231a8d71b0db94ef",
      "kind": "text_data",
      "source_text": "お疲れ様です！！",
      "source_fingerprint": "169f353d562623349b55a3d20e6d498266eeaf514aa2b3924eede04318390dd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044003"
      ]
    },
    {
      "uid": "zhcn:2a1da1ca9e8d94680cfd5f4b",
      "kind": "text_data",
      "source_text": "撃ち抜いたのは……",
      "source_fingerprint": "a95a51bc74b97c9b40d8704f693cdbdb792426886bfecb5536fef5342b32cd03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044004"
      ]
    },
    {
      "uid": "zhcn:8a8c769691845be9aec6666a",
      "kind": "text_data",
      "source_text": "意外な素顔？",
      "source_fingerprint": "ef9ac4fcff51f6225bdf470c0ed245bc62f16666f8f069c689301c4de2ba87f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044005"
      ]
    },
    {
      "uid": "zhcn:0f1693d828f7b54aca47b2a1",
      "kind": "text_data",
      "source_text": "『貴方のおっしゃる通りでした』",
      "source_fingerprint": "cdf3253c04df76cf901e5c5eccb258a50867abb1e9bcee0aa3e313c7e9fd9176",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044006"
      ]
    },
    {
      "uid": "zhcn:16ec395291ea9ac4bf06cca1",
      "kind": "text_data",
      "source_text": "貴方の胸にも灯を",
      "source_fingerprint": "ae745f277fdb66c359326f8140fb422e56cf222bc6d1758d2f605ecfb90ff733",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044007"
      ]
    },
    {
      "uid": "zhcn:5b85175838866f8d0c60961c",
      "kind": "text_data",
      "source_text": "きっと何色の未来でも",
      "source_fingerprint": "d9d273c250a25d7db675015618a959b33ba1ce851257645290b6762309541088",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044008"
      ]
    },
    {
      "uid": "zhcn:d51f13fce9a608fe9ceff9ff",
      "kind": "text_data",
      "source_text": "そしてまた、彼女の隣へ",
      "source_fingerprint": "1ea4bd4199907e68e618a2fb5ebb2d761e10aa36be5364ea98b7ef7ebed2cb75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044009"
      ]
    },
    {
      "uid": "zhcn:675b5d85c690e39ddedce573",
      "kind": "text_data",
      "source_text": "そして彼女らに光あれ、と",
      "source_fingerprint": "c2f3dff52ccc6b07ae03b256c802a97756d8af3bb30c495c2a88cd34338eb5ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044010"
      ]
    },
    {
      "uid": "zhcn:61a626f2d5e87c338a0a1b8b",
      "kind": "text_data",
      "source_text": "涼花との絆・彼女の『強み』",
      "source_fingerprint": "5b2262afcdccff2e5c77c178bd906c885c8fe6ac11fc96e1f71dc9f1ac2078a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809044011"
      ]
    },
    {
      "uid": "zhcn:8c31078bbfe6e5cb430d6817",
      "kind": "text_data",
      "source_text": "开发无人岛，走向未来",
      "source_fingerprint": "c7bb8bf8abf6eea55b194292eb1f5b364435052266999c72c00f10f7b313e9ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049001"
      ]
    },
    {
      "uid": "zhcn:156de07dd9642d60e0260f2c",
      "kind": "text_data",
      "source_text": "心跳雀跃的律动",
      "source_fingerprint": "1274b9301623cc31c156e4d3d179825f4c1518ab0ae6aebce8294006f863b6a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049002"
      ]
    },
    {
      "uid": "zhcn:8838dad643c27149143bf71c",
      "kind": "text_data",
      "source_text": "燃烧吧！健身！",
      "source_fingerprint": "2bf39b467c0d97fed95b327e4a94204abfd84186c72f3e0b6a899e01d2827c81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049003"
      ]
    },
    {
      "uid": "zhcn:79898842231dc88331c8c88c",
      "kind": "text_data",
      "source_text": "燃烧吧！健身！",
      "source_fingerprint": "2bf39b467c0d97fed95b327e4a94204abfd84186c72f3e0b6a899e01d2827c81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049004"
      ]
    },
    {
      "uid": "zhcn:4fb2564cda26318de0e328af",
      "kind": "text_data",
      "source_text": "梦想就要盛大绽放！",
      "source_fingerprint": "e0a1d3aa92e46e17223fc217a315be84eb1e3f334f6955e217ed24ff3c9a8c96",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049011"
      ]
    },
    {
      "uid": "zhcn:1d9ff052cd368d80bd2352b1",
      "kind": "text_data",
      "source_text": "随心所欲",
      "source_fingerprint": "611b70eb2fdc3da371f679326e37c806ee9aebad5019ffdcfc030d955fc078f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049012"
      ]
    },
    {
      "uid": "zhcn:207b05d533a378d66932df4f",
      "kind": "text_data",
      "source_text": "无需多言",
      "source_fingerprint": "fa8c55a0a168638e05b58d09ee63b1f665e1852ac511fef2296a9b108f5ad721",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049013"
      ]
    },
    {
      "uid": "zhcn:21a8235fb6746cac8c126c43",
      "kind": "text_data",
      "source_text": "微醺中藏着秘密",
      "source_fingerprint": "21eefa67c70ed4a92b6010d60c35e7c25e6f3102cbaad3f45df8bec045af88fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049014"
      ]
    },
    {
      "uid": "zhcn:210983218baa7ec0e323ff91",
      "kind": "text_data",
      "source_text": "呐喊吧！回响吧！",
      "source_fingerprint": "5d0474781ec1e161921e8078c67a82ea1a42b7cb012a3ab82648a398c7a23c1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049015"
      ]
    },
    {
      "uid": "zhcn:6ff85e0ce933ae9f7ea5754e",
      "kind": "text_data",
      "source_text": "与塔可布莱恩的牵绊・踏上大秘境",
      "source_fingerprint": "6a30fca6d70dc2d93905cf7afdf3478c758c86ff866426b0ec3daf66fceaf52f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049021"
      ]
    },
    {
      "uid": "zhcn:649297bfe1564c069b240e61",
      "kind": "text_data",
      "source_text": "因为有你在",
      "source_fingerprint": "e9f593336d73eb3b5cffb41f8be64d0e1aac2581a3174cab54dccd31562cd77a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049022"
      ]
    },
    {
      "uid": "zhcn:0a23eeab8e607f080bcbc374",
      "kind": "text_data",
      "source_text": "多亏了你",
      "source_fingerprint": "d68a8cb076bf56db69fa516bc8b69bda0872b65b2e7d0e9e0dd7d4d38d26edaa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049023"
      ]
    },
    {
      "uid": "zhcn:b57de8b481384f8a3a2c04ca",
