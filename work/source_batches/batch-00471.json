        "181",
        "809041001"
      ]
    },
    {
      "uid": "zhcn:312a881943bc7e8de829012a",
      "kind": "text_data",
      "source_text": "女神的爱之深，责之切",
      "source_fingerprint": "3c727917498725174148d02e69eb071e65269eac3976725e634d412e43be7b6c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809041002"
      ]
    },
    {
      "uid": "zhcn:e490affbcc4f37e0fd723678",
      "kind": "text_data",
      "source_text": "毛头小子，别误判了",
