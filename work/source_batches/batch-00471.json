      "source_text": "指引前路的，引导者",
      "source_fingerprint": "82c7a9fae6335b66639ca81f25195a4f5b2154b6f09b687ea16049e7c42492e3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049031"
      ]
    },
    {
      "uid": "zhcn:876d2149c0264620150a78c7",
