      "source_fingerprint": "0022100b97bfc22a1f9a23b9b35b1f58438b8ef8c98a79d874e17949a2d22bfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119601"
      ]
    },
    {
      "uid": "zhcn:dcb41f7d76a29f5b63b0808f",
      "kind": "text_data",
      "source_text": "寝不足で……",
      "source_fingerprint": "d0c8b9fe16d8655a3cf88410dfd6feeba87a9bfdda5bc2013e0f792cc64a6dd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119700"
      ]
    },
    {
      "uid": "zhcn:adcc88356a3a033ffb984909",
      "kind": "text_data",
      "source_text": "休息はバッチリ！",
      "source_fingerprint": "94bed783f8892adc5530b76839b280d8759a4301b02ce45baa7aa5b4249fe3ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119701"
      ]
    },
    {
      "uid": "zhcn:6f774405308193655e62f7de",
      "kind": "text_data",
      "source_text": "知れば知るほど……",
      "source_fingerprint": "5e00f1a9c34291bd4744a9328646290424f1b5ce2f943bb4ac3db2cf3127084f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119702"
      ]
    },
    {
      "uid": "zhcn:b8636fae0a680b4601913b64",
      "kind": "text_data",
      "source_text": "仰げば危うし",
      "source_fingerprint": "f17af9a0a72d6d7e6b55dc876bd76bab15dc19aad621b1c32f13fda2b28d50de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119703"
      ]
    },
    {
      "uid": "zhcn:2678e2584617cc94330b66bc",
      "kind": "text_data",
      "source_text": "秘密の扉、その先に",
      "source_fingerprint": "25393f875aa13346a3f790c4bc47c1460f9f738161897f3420db3f85cb368cf7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119704"
      ]
    },
    {
      "uid": "zhcn:9bd7cf6a2467de65553dca1c",
      "kind": "text_data",
      "source_text": "うらない！",
      "source_fingerprint": "c8bb4d0d477da3e4d9205f26c1cbdf35b00a3e31a3f220dd8e9578f915effe4f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119705"
      ]
    },
    {
      "uid": "zhcn:625a606023387b31e23abce4",
      "kind": "text_data",
