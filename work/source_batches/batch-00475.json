      "source_fingerprint": "694b3969297eae75486e50f8eb362e46c34aff97dd1a4ea6da1e54463a2114a2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119706"
      ]
    },
    {
      "uid": "zhcn:af10532ca2fcce9a96acb443",
      "kind": "text_data",
      "source_text": "神社でお祈り！",
      "source_fingerprint": "06b731b66c3603a32c1cac4b4908776cc86635a0de8a2efa50ba8073f31fb180",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119707"
      ]
    },
    {
      "uid": "zhcn:73379efda61bc066f4077346",
      "kind": "text_data",
      "source_text": "レース勝利！",
      "source_fingerprint": "41790a1b5f8d0e645951f342cc052cc2c0f1183fe6a662072b935a3d6098a1fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119708"
      ]
    },
    {
      "uid": "zhcn:5c74522877a230e46e5aa58e",
      "kind": "text_data",
      "source_text": "レース入着",
      "source_fingerprint": "e4d0bf03e5655cac21b58856d1003b726f71b11b71eb48edbe420038d6c33e15",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119709"
      ]
    },
    {
      "uid": "zhcn:0027f234a19d40cc9ee466a5",
      "kind": "text_data",
      "source_text": "レース敗北",
      "source_fingerprint": "e44ca7b679cb69d01b24af5ea35ca7c562e4b81ae32c6f488a437577af14a73e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "501119710"
      ]
    },
    {
      "uid": "zhcn:6fe7c5f82639477438953c07",
