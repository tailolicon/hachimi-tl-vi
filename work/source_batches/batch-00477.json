      "source_fingerprint": "ac55e23e0e8563e1d85afbde3eab56a2fa75594bb454083cfebb13e8246bfc2e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809004001"
      ]
    },
    {
      "uid": "zhcn:ce609d83c5cb2a218487f644",
      "kind": "text_data",
      "source_text": "同期的桐生院训练员",
      "source_fingerprint": "a2bcad61e0ab9c1ba76f1d61fb05475561736a9b79eb11920ad409c13c043d33",
      "source_path": "text_data_dict.json",
