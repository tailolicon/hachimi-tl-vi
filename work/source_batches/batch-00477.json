      "source_text": "辛苦了！",
      "source_fingerprint": "20df094ff1112517c623c111a7239f2b6398134743fb570a85aa6a2f9f1f8889",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809004003"
      ]
    },
    {
      "uid": "zhcn:567bc22c32aac7361ebc49a4",
      "kind": "text_data",
      "source_text": "寻找兴趣",
      "source_fingerprint": "da4d01dccf7f7140cb20d5975dcc56fb84c6828657af05ac87e39ec2fd1ca54e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809004004"
      ]
    },
    {
      "uid": "zhcn:e2dfc8abe5717e776ce8b612",
      "kind": "text_data",
      "source_text": "应当亲身学习！",
      "source_fingerprint": "a10ec1ad1b129bea66c9235884b96e61cf61bd48aeed3b660b30822aa5a13ccb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809004005"
      ]
    },
    {
      "uid": "zhcn:0580f7f1c2acafdd2b995646",
