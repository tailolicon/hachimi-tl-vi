      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001112"
      ]
    },
    {
      "uid": "zhcn:8d573c9474312d4267cf58b5",
      "kind": "text_data",
      "source_text": "拼起桌子，带上各自的东西",
