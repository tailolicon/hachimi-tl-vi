      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001001"
      ]
    },
    {
      "uid": "zhcn:9a5e25e6ec4f5c8c2382b99a",
      "kind": "text_data",
      "source_text": "理事长秘书・手纲小姐",
      "source_fingerprint": "073d71677344bc03ae451a341a16667e0921816830c0312b3e2da4f9acf61a54",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001002"
      ]
    },
    {
      "uid": "zhcn:44fc714b13605235f352c415",
      "kind": "text_data",
      "source_text": "辛苦了♪",
      "source_fingerprint": "5f4bce504ad3a782bc7db58c1c3bf690d86ff33e4ad95b0ec3aed85c79ec42e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001003"
      ]
    },
    {
      "uid": "zhcn:5cf8ef2a12b326e0c99e6374",
      "kind": "text_data",
      "source_text": "热情的两人",
      "source_fingerprint": "3d2c4856dc38ddb83f73acb67bce25f84fbecb965f7d21e45a8d8461421ccf5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001004"
      ]
    },
    {
      "uid": "zhcn:9bfae948345fcce78598027e",
      "kind": "text_data",
      "source_text": "有时牛奶、有时苹果",
      "source_fingerprint": "74eab005d212013f2cfafd157d4204f1b26606c6ebb8e4ea34e184a1aab75c21",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001005"
      ]
    },
    {
      "uid": "zhcn:014958bde7c7c120f5bb0c29",
      "kind": "text_data",
      "source_text": "惊异的领头脚质？",
      "source_fingerprint": "22b2f2e35a4e798e0cc1f2812d7a2477aa198daec24cb75213a11289e83b3fe6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001006"
      ]
    },
    {
      "uid": "zhcn:75f3ea123fd448b90fa87b6a",
      "kind": "text_data",
      "source_text": "电影的回忆",
      "source_fingerprint": "fd8115c3bcb5bd8e32b898de11dfbeb1203041671759f223f0e6a0d755396d48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001007"
      ]
    },
    {
      "uid": "zhcn:e16cdde9be39dcf7e392e710",
      "kind": "text_data",
      "source_text": "叹息与创可贴",
      "source_fingerprint": "dcb9a76b21a5a9a0e70df043937b319d646c4aad8e95f4861c97b35790d38195",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001008"
      ]
    },
    {
      "uid": "zhcn:b019be9e605e593eb0580744",
      "kind": "text_data",
      "source_text": "让我稍微待在身边",
      "source_fingerprint": "6a0090f56d815ec530f5bfd29561897d9c57a3cf831ec206a165c11eb1629773",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001009"
      ]
    },
    {
      "uid": "zhcn:a8248dbc7f950ecaeac66d21",
      "kind": "text_data",
      "source_text": "请给我「跟平常一样的」！",
      "source_fingerprint": "c57011f9fc338c86c0106419f5fe2e5374448ac7cc3c6d14df912a185be7c87a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001010"
      ]
    },
    {
      "uid": "zhcn:777c7b3265a4f311ce955b85",
      "kind": "text_data",
      "source_text": "和手纲之间的牵绊，寄托憧憬",
      "source_fingerprint": "fbd6ec8fb95a075779453377e7e9900eebe3f9fe48e5bfb89d96359fd4738e71",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001011"
      ]
    },
    {
      "uid": "zhcn:0462eafbb0168c78c2e591b1",
      "kind": "text_data",
      "source_text": "很顺利呢♪",
      "source_fingerprint": "ad8ccf22b8243b2deaf353f21241a92c45c5e2e06de721c5134e913221816902",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001033"
      ]
    },
    {
      "uid": "zhcn:356d27c8c8382974bb933a78",
      "kind": "text_data",
      "source_text": "早上好，手纲小姐",
      "source_fingerprint": "4a6d9c897d5883fda2b5b4f830978fed88ca725734de677b41cb2a31e62acd44",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001101"
      ]
    },
    {
      "uid": "zhcn:a165653d660b4d68a992aba6",
      "kind": "text_data",
      "source_text": "深夜的家庭餐厅，还有拉面",
      "source_fingerprint": "053d352bd4ca3e02b0421fdb625f60cb8ccf190a6d7e04b5f9a50e2f7e7c5aab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001104"
      ]
    },
    {
      "uid": "zhcn:5e6e71a9c701f51cbb889b75",
      "kind": "text_data",
      "source_text": "西装、手杖与汗水",
      "source_fingerprint": "6bee689b548033e9754314e57ddc7ffa0a039b4ff37233e69889cdbb159dc291",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001111"
      ]
    },
    {
      "uid": "zhcn:85c52bcb19df8ad7c059bd3b",
      "kind": "text_data",
      "source_text": "明天什么的才不管！",
      "source_fingerprint": "0b69fc80b5a3806ec2e27885b95bad0fb5cc7b05c8e30cbf631dfca5d102a8e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001112"
      ]
    },
    {
      "uid": "zhcn:8d573c9474312d4267cf58b5",
      "kind": "text_data",
      "source_text": "拼起桌子，带上各自的东西",
      "source_fingerprint": "552b0944d16ed87068b78c16b13d54e4b314c3a2241dd3808ea91eb97a86d4c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001113"
      ]
    },
    {
      "uid": "zhcn:8a168c5c359c5e633cbca2c9",
      "kind": "text_data",
      "source_text": "在孤身一人的尽头",
      "source_fingerprint": "28ebdb55d74321c8eb5ef2ad1cc2b9a7eb859c1cebd4769d920d2d26982dbe39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001114"
      ]
    },
    {
      "uid": "zhcn:9aa0e538489dd86341955e5f",
      "kind": "text_data",
      "source_text": "无论何时，每一秒，都是那一刻",
      "source_fingerprint": "cd7cec20a72f8a037d6d717de9e598927e4b80fec7d0722bc94a8c25daf081aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001115"
      ]
    },
    {
      "uid": "zhcn:b2a31e3ada27a25b76816483",
      "kind": "text_data",
      "source_text": "与手纲的牵绊·为胜利美酒干杯",
      "source_fingerprint": "8121bd75996892d89a35255ea47d653cd20793c86d661a8c34b61b9c92bc703c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001121"
      ]
    },
    {
      "uid": "zhcn:e73fa649e539269c1a372d5e",
      "kind": "text_data",
      "source_text": "舞台侧幕后的应援歌",
      "source_fingerprint": "04ced3754a008ce1e12fbbdc65fe591f66605e938c53e80009d62750dfdf579a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001122"
      ]
    },
    {
      "uid": "zhcn:a468f873f62680f6605662fc",
      "kind": "text_data",
      "source_text": "稍作片刻喘息",
      "source_fingerprint": "43d53479bfe3dabc63d8ec1997ad142a39a06016c41f02004d2ce039fa8adbf6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001123"
      ]
    },
    {
      "uid": "zhcn:ce7813650c0530a2733734c3",
      "kind": "text_data",
      "source_text": "我很期待哦♪",
      "source_fingerprint": "773f106ee2aeb432f3eb26e10c5ab5ede4cffb98ea40e7c5e8e4bd8f4a36f7a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809001132"
      ]
    },
    {
      "uid": "zhcn:18107a71b884431d03e4b7db",
      "kind": "text_data",
      "source_text": "出題ッ！理事長チェック！",
      "source_fingerprint": "01c3e7ec9dd7ebe458123ac2ada38a085f9d986c026b40a435ef797c08d85222",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002001"
      ]
    },
    {
      "uid": "zhcn:4d7514b4ac26b5c8335090a6",
      "kind": "text_data",
      "source_text": "撸猫撸猫！理事长的秘技！",
      "source_fingerprint": "1582ce9744f90dd40b7a6e8ff4d60ac97ed36514edb25c1c5b97cf790db878b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002002"
      ]
    },
    {
      "uid": "zhcn:b46cf934307be81c4aef14b6",
      "kind": "text_data",
      "source_text": "激励ッ！そのまま進め！",
      "source_fingerprint": "67f3e664eaf6007f6eec9daed8d8a090d1eb277703a7890b871e1378c7e1ccce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002003"
      ]
    },
    {
      "uid": "zhcn:b19e9e49cf545446ffa129e5",
      "kind": "text_data",
      "source_text": "计划！特雷森乐园（暂定）",
      "source_fingerprint": "fbee59bc14c3d39d7ea55630b44a28095addddc395cabcf6e684d1e6a4ce7762",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002004"
      ]
    },
    {
      "uid": "zhcn:b88d452142d77d405e25ec0c",
      "kind": "text_data",
      "source_text": "提议！首先是奖励！",
      "source_fingerprint": "ef53470f57bfda5d05f090b60fc0cbcec50e01b35268a89f7829e8d74937447a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002005"
      ]
    },
    {
      "uid": "zhcn:6435925112c0141cabeda64a",
      "kind": "text_data",
      "source_text": "享受！对牛摸摸！",
      "source_fingerprint": "4a1182d0d6f0aa7ff5f5ab3c96140f76bd81cc43f313a6564897ecd2e5410760",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002006"
      ]
    },
    {
      "uid": "zhcn:71ab4d620483480688eeab45",
      "kind": "text_data",
      "source_text": "记忆！回想起那天的事",
      "source_fingerprint": "87d7e484c34632b9796487b3d2bcb8616f08b183b18f7219429966cbf51d5d4e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002007"
      ]
    },
    {
      "uid": "zhcn:0aaa670a4bc2190abba06c81",
      "kind": "text_data",
      "source_text": "邂逅！同一片天空下",
      "source_fingerprint": "1100cefbf03f168c9d698ece079a8293977a0e34f20df05d31f96d05016ebe9c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002008"
      ]
    },
    {
      "uid": "zhcn:e54e4c74a7376faa94cae541",
      "kind": "text_data",
      "source_text": "安息！然后迎接明天",
      "source_fingerprint": "2493ffd8c6252f37639bd14e39c921ecb2ee50f1d220b11a30f446dc89104e71",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002009"
      ]
    },
    {
      "uid": "zhcn:42971496045074de74bbc3de",
      "kind": "text_data",
      "source_text": "燦然ッ！限界を超えた力ッ！",
      "source_fingerprint": "8d13e69ba74f23d0c5f3d737fc09f6fb50f21ef6c270680288f4cd3db75f3d99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002010"
      ]
    },
    {
      "uid": "zhcn:0392301b680bd3608c97d0f3",
      "kind": "text_data",
      "source_text": "やよいとの絆・これからはっ！",
      "source_fingerprint": "4665ee4458b3b9a79185d5f9dbc1f5ed9829eae4bac968af3bd2926d5a74cada",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809002011"
      ]
    },
    {
      "uid": "zhcn:6c72e80444e750769c03017e",
