    },
    {
      "uid": "zhcn:b21911fd69f4a5238149385d",
      "kind": "text_data",
      "source_text": "太阳的嗨翻天堂週揭幕！",
      "source_fingerprint": "2cbc0d1030260654d8ce550d33a0a1f63862029032221265bfb2f4548ee5f9ff",
      "source_path": "text_data_dict.json",
