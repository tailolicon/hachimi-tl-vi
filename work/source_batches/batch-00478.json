      "source_text": "大相迳庭的自尊心",
      "source_fingerprint": "f109526096a552382c86189e5f3e55304cf98e22350aaa98453133c06936454d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830118002"
      ]
    },
    {
      "uid": "zhcn:7da9c9b5e57b8634f290ad68",
      "kind": "text_data",
      "source_text": "魔鬼教官吉兆",
