      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830121003"
      ]
    },
    {
      "uid": "zhcn:e436cc04e8138240c6e3622a",
      "kind": "text_data",
      "source_text": "汝应成为辣妹的守护者",
      "source_fingerprint": "c037570562f2f13ee1b47c6e6785c8fbf098b86d1d9195e420eca912232c96f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830122001"
      ]
    },
    {
      "uid": "zhcn:73ec5606a611af7902f76d67",
      "kind": "text_data",
      "source_text": "汝应成为赛马娘偶像炒热气氛",
