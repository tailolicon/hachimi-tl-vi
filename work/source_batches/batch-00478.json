      "kind": "text_data",
      "source_text": "实行计划！",
      "source_fingerprint": "cb166e56addf9287db2529f7710242be1ffff5059f236e0d6265bb1608b26611",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830117003"
      ]
    },
    {
      "uid": "zhcn:ba3b5b36bc797f61fe7ec3bc",
