      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830120001"
      ]
    },
    {
      "uid": "zhcn:6371fa9cb18296fdc401217b",
      "kind": "text_data",
      "source_text": "二、决定该做的事",
