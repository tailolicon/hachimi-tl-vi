        "181",
        "830116002"
      ]
    },
    {
      "uid": "zhcn:c468a158ad514d987f43a3eb",
      "kind": "text_data",
      "source_text": "嗨翻天堂延长赛！",
      "source_fingerprint": "20a6632351f13cf77501bec8caad0ee7639ce6aefe8902bf0bb939ac5f3d7d05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830116003"
      ]
    },
    {
      "uid": "zhcn:d1509443fad6ce9debb96995",
      "kind": "text_data",
      "source_text": "太一成不变了！？",
      "source_fingerprint": "f767079b82d0af5847f59e5aaece33149df59607826d98d580a26a4ad978ffe9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830117001"
      ]
    },
    {
