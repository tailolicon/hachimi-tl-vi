  "entries": [
    {
      "uid": "zhcn:4cef12191535e97c398d8fa8",
      "kind": "text_data",
      "source_text": "キングの流儀／相伝編",
      "source_fingerprint": "e6a9a2fd5ca2b86fb3025070bbaedfba2f9b820a8b359cf6b95287241f8d786c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830170003"
      ]
    },
    {
      "uid": "zhcn:f348369b3a9be5205151e2ba",
      "kind": "text_data",
      "source_text": "先輩がんばる！",
      "source_fingerprint": "95933739adaf9b10632126453c278cacd3b19947cdbd055a1b47486c61f93144",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830171001"
      ]
    },
    {
      "uid": "zhcn:1b9f08a40dbf12ea0fe99bab",
      "kind": "text_data",
      "source_text": "修行がんばる！",
      "source_fingerprint": "29f85d7bdd721dc57bb30998a27a01189e5073dd633a5edecd358d682d07761a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830171002"
      ]
    },
    {
      "uid": "zhcn:90b083513f648153203f7f3d",
      "kind": "text_data",
      "source_text": "後輩がんばれ！",
      "source_fingerprint": "bb6a98568c032f072bc11f537258ad644c45cf0c03ae1cd77a2d6b97c13a2673",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830171003"
      ]
    },
    {
      "uid": "zhcn:a0d0951ce2b63eeb6fcca1fd",
      "kind": "text_data",
      "source_text": "直球、投げ抜く勇気",
      "source_fingerprint": "0f069a68bb2c20abe59583155f0942ae33f4220756bb0a95e75da7d0e8b0e350",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830172001"
      ]
    },
    {
      "uid": "zhcn:4380792e327a047bd0e4a344",
      "kind": "text_data",
      "source_text": "エンジョイ・ベースボール！",
      "source_fingerprint": "c9044b80d5c9052eb2caf8b1ba5b06617104598deb858c06507558cfc7462346",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830172002"
      ]
    },
    {
      "uid": "zhcn:cbe4c972f034d94f77986d98",
      "kind": "text_data",
      "source_text": "白球にエール乗せて",
      "source_fingerprint": "b728ceb26eebfb9964e855a28516fcfb5b3d7a595c035b77a79f8c8d30d6285d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830172003"
      ]
    },
    {
      "uid": "zhcn:8ab78bd018d6625027e38a6d",
      "kind": "text_data",
      "source_text": "君は、テンポ・ジュストなアンダンテ",
      "source_fingerprint": "0fe6d760723018897b9cd2f67cb8d07c95635d5dc75019f6ee7a19e96dcbd420",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830173001"
      ]
    },
    {
      "uid": "zhcn:369978d66d12a7762a8d4e6e",
      "kind": "text_data",
      "source_text": "クインディチェージマからローコ…でも",
      "source_fingerprint": "b08009ba106d8880156102d6d3f6c157218667e8b846d9a60be7196ce60b8576",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830173002"
      ]
    },
    {
      "uid": "zhcn:679426b628aaec0f19d97462",
      "kind": "text_data",
      "source_text": "いずれグランディオーソなセッションへ",
      "source_fingerprint": "c952eb3c8842b09fd62ae00670590a1b7a3529a9c6f2460ed03b2af9ecb5565e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830173003"
      ]
    },
    {
      "uid": "zhcn:5f5ece45b53eba02079dd913",
      "kind": "text_data",
      "source_text": "言えない言葉",
      "source_fingerprint": "68ce880b39778faeb275aaa386ee8a77d5f2a9e271b14848f4f1dc3774cca21a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830174001"
      ]
    },
    {
      "uid": "zhcn:a5375582d1543948f3aac7aa",
      "kind": "text_data",
      "source_text": "アタシだって――",
      "source_fingerprint": "3337c41ac010cf4e2e1f837c9581ff87d31b7d4453e27a26222576f9421b49b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830174002"
      ]
    },
    {
      "uid": "zhcn:d1a430e9a6e6fe105bd31f99",
      "kind": "text_data",
      "source_text": "隠しきれぬ牙",
      "source_fingerprint": "49a4f3099ab8ce7429728a4fbaef1ebc7c4384072366309bbe4f511d4466db66",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830174003"
      ]
    },
    {
      "uid": "zhcn:97205b745d5520a55db2e06e",
      "kind": "text_data",
      "source_text": "虚ろなる灰簾石",
      "source_fingerprint": "1cd9a0f4657e80ea06859150d3ad93a3bb5250d16f45758178e00e43873c790b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830175001"
      ]
    },
    {
      "uid": "zhcn:2d33e9f5f8d610bb5fbbfe50",
      "kind": "text_data",
      "source_text": "不香の花に燃ゆ",
      "source_fingerprint": "9e2122bb36a958b8d39c465ed89505e3137cd363edfbc8e9c1a7f4fdfa9de534",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830175002"
      ]
    },
    {
      "uid": "zhcn:1fc288fcbdb95d3f3e812277",
      "kind": "text_data",
      "source_text": "恍惚の色彩",
      "source_fingerprint": "aee83dabbb37b6ee0b00d8cda7b03387a0229ee6afb6a3afa57980a216eb630e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830175003"
      ]
    },
    {
      "uid": "zhcn:d3b3d9d59a22116bbc11ea97",
      "kind": "text_data",
      "source_text": "あたしとあなたの距離",
      "source_fingerprint": "0401fb9456839a9c4fb92eb05a6f8c033c7aa5665dc7d6df40456ee1e6cead5f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830176001"
      ]
    },
    {
      "uid": "zhcn:a2e55a40aa3d43e8d297c175",
      "kind": "text_data",
      "source_text": "あたしでも",
      "source_fingerprint": "100be31e209db6cd0af9384662d7d2f85c78bbc723e757022068487b3536bd16",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830176002"
      ]
    },
    {
      "uid": "zhcn:a60ded3a0e74149c6cf73f12",
      "kind": "text_data",
      "source_text": "一歩ずつ、あなたとの距離を",
      "source_fingerprint": "bb8fbed1a64837ea18c7aaddf667a86cd0764e0e8daed0053b28e2ede9e007f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830176003"
      ]
    },
    {
      "uid": "zhcn:dcc55ddf504d5a89d4d19dbf",
      "kind": "text_data",
      "source_text": "お願い！ご褒美ちょうだい？",
      "source_fingerprint": "30b47676b00cc0cbe1502f5d907730b47017fded9fdef172f7d93966fa750375",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830177001"
      ]
    },
    {
      "uid": "zhcn:1fd8a39ecd23a20e97044de4",
      "kind": "text_data",
      "source_text": "野球！みんなでやろうよ！",
      "source_fingerprint": "5fae95f84be479eb21a0f32b159bad6ea05cc50cedb4b2f820bf46977bd9281e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830177002"
      ]
    },
    {
      "uid": "zhcn:b556b3e889987cb908d002db",
      "kind": "text_data",
      "source_text": "絶対！ときめきパワー！",
      "source_fingerprint": "655db7c010b18a7b3add203c3b3181ac60ab38ed49e3953adba46bcb3b13bc79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830177003"
      ]
    },
    {
      "uid": "zhcn:b44c3415adaec2719bca6667",
      "kind": "text_data",
      "source_text": "Vol.1 『ストイックの向こう側』",
      "source_fingerprint": "95c7a6370be0b33747f35e12a4fa776ea14b535e8bb18bbd155a390048c6c221",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830178001"
      ]
    },
    {
      "uid": "zhcn:96579c3b51a8adb8a22457e0",
      "kind": "text_data",
      "source_text": "Vol.2 『脈々と』",
      "source_fingerprint": "81bc8394cf93aaaaa82039f5f8e50c49e5ea53df9589a5f7edb12eaa3115e38c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830178002"
      ]
    },
    {
      "uid": "zhcn:6c2d66f35998507d91949bf1",
      "kind": "text_data",
      "source_text": "Vol.3 『その名はドゥラメンテ』",
      "source_fingerprint": "62941faea84f8481c8deb6743bb02c947fae064bdaddb82cd4a61da21a5867eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830178003"
      ]
    },
    {
      "uid": "zhcn:35a692b8195f446636232ca4",
      "kind": "text_data",
      "source_text": "アイオライトの精神",
      "source_fingerprint": "33a4c6634295267d3b1be06b325f5043e15f07793a906d808268e206c0fb1139",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830179001"
      ]
    },
    {
      "uid": "zhcn:3154d93f5233c2ca9d8c059b",
      "kind": "text_data",
      "source_text": "シリマナイトの渚",
      "source_fingerprint": "7d75730f0f709e745e0bc5ef00efe3efb038063aeb1ce261e1f9074012aa3b8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830179002"
      ]
    },
    {
      "uid": "zhcn:1e3ce42ddec4ccd17f8253e3",
      "kind": "text_data",
      "source_text": "カルセドニーが輝く",
      "source_fingerprint": "876058422c94a46e79834959e09081ad49f08c6a23b7305342332bb81552259e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830179003"
      ]
    },
    {
      "uid": "zhcn:baf68685158d276e3ee06591",
      "kind": "text_data",
      "source_text": "頑張ったあとのお楽しみ",
      "source_fingerprint": "52eefe0bd689863b56f2471eee645f0f27f535ed68a99035284025ecf90912c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180001"
      ]
    },
    {
      "uid": "zhcn:178d3859c02cb5e27a357bfb",
      "kind": "text_data",
      "source_text": "スターウマ娘の威厳を！",
      "source_fingerprint": "67475bcbd89b7c914e09d8aa64a8e1e2c5d17b35f0957a3587cdc117f1f0b878",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180002"
      ]
    },
    {
      "uid": "zhcn:3911329cccbc950ecfcd3ce5",
      "kind": "text_data",
      "source_text": "王道のトレーニングといえば",
      "source_fingerprint": "3a93ae9bca563a6f703da4a99a423cffa67eb4298b1ba97604d5abe12141710a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180003"
      ]
    },
    {
      "uid": "zhcn:f4d294289982b62dde2ede93",
      "kind": "text_data",
      "source_text": "バトンを受け取って",
      "source_fingerprint": "0ec95fe245ce9c28ece922fdeb236449cad9741fda6a52c0f5297d2d3f792f52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180004"
      ]
    },
    {
      "uid": "zhcn:b7c4c35fb92a3e86da0b461a",
      "kind": "text_data",
      "source_text": "頼れる先輩",
      "source_fingerprint": "1e1c4cf23a2d6f55192229cba0e96a0c50a9eb93201de5a2c91080f985d8b425",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180005"
      ]
    },
    {
      "uid": "zhcn:8d6878b76a628a2026426399",
      "kind": "text_data",
      "source_text": "これがボクらのリラックス",
      "source_fingerprint": "2254d4d45090b1faaaab8be5bb614b52db9a614dd52470cf3554d4d1f51e9132",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180006"
      ]
    },
    {
      "uid": "zhcn:a87c05d29d4932707e94d82f",
      "kind": "text_data",
      "source_text": "元気が届くように",
      "source_fingerprint": "c4a9ebf9ba543fa6506a4d0304840a98b1ee6db3552719da28d816a6cd3f64ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180007"
      ]
    },
    {
      "uid": "zhcn:3321e4b086649745a0f58b74",
      "kind": "text_data",
      "source_text": "踊ればそこがお祭り会場！",
      "source_fingerprint": "03e62a812c4649024f9515af3d0f4f54081c3c2e8bfbfdff8bc56082fb3afa99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180020"
      ]
    },
    {
      "uid": "zhcn:31952c79c84a5ebf8a01cdbd",
      "kind": "text_data",
      "source_text": "憧れは傍に",
      "source_fingerprint": "60e5ee7d7292121a6617ac6882c502bdc1c378ea9994251a34a295e293dba018",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180021"
      ]
    },
    {
      "uid": "zhcn:9eea06667652c9ff020f9fa1",
      "kind": "text_data",
      "source_text": "区切りの先へ",
      "source_fingerprint": "2ef980b7773af1fe476dd435ff0772802e6e1d1b217e4e2392a0541639234e62",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180030"
      ]
    },
    {
      "uid": "zhcn:05b30008b4c2e89274187a4a",
      "kind": "text_data",
      "source_text": "軌跡、そして",
      "source_fingerprint": "7a04329fadd1a4af43aea0e5053d9055d0b2971c95ac9784ba52711b7c81ffba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180031"
      ]
    },
    {
      "uid": "zhcn:fd63098487ca471dab066a89",
      "kind": "text_data",
      "source_text": "あなたを想って",
      "source_fingerprint": "897cf2447ea8c2a997f5ed22d01f11db44b72ee40dde685d57f2f9d18a4a2a51",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830180032"
      ]
    },
    {
      "uid": "zhcn:613882372383e2f9f480de50",
      "kind": "text_data",
      "source_text": "観察！ターボの愛され力！",
      "source_fingerprint": "cb934630217589f2d972fd8b045a15c002b667753dcc5193f7de83a3dd865054",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830181001"
      ]
    },
    {
      "uid": "zhcn:2fe52d6714161687ff2b5085",
      "kind": "text_data",
      "source_text": "発動！ターボのちょーのーりょく！",
      "source_fingerprint": "93634b5495701b07e9ed08ed666517af176c010445c4e5dd6b660ffd9bfbbd99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830181002"
      ]
    },
    {
      "uid": "zhcn:6ba812beb0b984cd0a8abaa2",
      "kind": "text_data",
      "source_text": "みんなで！いっしょに校内放送！",
      "source_fingerprint": "9f5ff75e554ee49d02817f11a98bd42445406c5f31affb747d1d2a15ee1cd385",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830181003"
      ]
    },
    {
      "uid": "zhcn:291832f6ea1426c1032502b3",
      "kind": "text_data",
      "source_text": "どーするロコドル！？",
      "source_fingerprint": "0b8f0076379ee75af1069021b3baaab6a6162f27cf4bc1ef805baa7377c95ccd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830182001"
      ]
    },
    {
      "uid": "zhcn:2542f6113f67ad3a2c9ce103",
      "kind": "text_data",
      "source_text": "学べロコドル！！",
      "source_fingerprint": "ac1338b1ced6e330a69a8605b51375833882073ba26cfa9ba2fee67fb0860d8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830182002"
      ]
    },
    {
      "uid": "zhcn:95c55d7f2f0e2e76f5a103a6",
      "kind": "text_data",
      "source_text": "進めロコドル！！",
      "source_fingerprint": "f7b215487bcd16d6eaee097ad09813c3057fafb6803f329f845779b0ab4fc8b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830182003"
      ]
    },
    {
      "uid": "zhcn:ea61ed2213f8966fc0cc9276",
      "kind": "text_data",
      "source_text": "完売！？思い出の味！！",
      "source_fingerprint": "b5089cd023fe2fd7bb67ac0b28811af67ed2112fb2d43785c92823b0d6b626d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830183001"
      ]
    },
    {
      "uid": "zhcn:280a3188dede04ce726ad937",
      "kind": "text_data",
      "source_text": "完敗！？全力クッキング！！",
      "source_fingerprint": "5c6d31861da2b618efcdd8caf83cdf54c3bdfc968af6368a05966b612003d6c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830183002"
      ]
    },
    {
      "uid": "zhcn:869c348836c9e458901ecb51",
      "kind": "text_data",
      "source_text": "完成！！世界で1つのスイーツ！！",
      "source_fingerprint": "b8fc80210a15bfdafbed8ffdcdbf68d133cf8890344c09147211a8d8d413fe3a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830183003"
      ]
    },
    {
      "uid": "zhcn:ba38d9583f034352c4374e75",
      "kind": "text_data",
      "source_text": "ぶっ飛べ！空き缶と学級委員長！！",
      "source_fingerprint": "ad21cb516959f596df71f637b91a3ea486355b7c8d2488f3a8d8f435a5220948",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830184001"
      ]
    },
    {
      "uid": "zhcn:64d2b6864f5d748c0becb907",
      "kind": "text_data",
      "source_text": "ちがう2人で、いっしょの1日",
