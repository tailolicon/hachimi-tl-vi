      "source_path": "text_data_dict.json",
      "json_path": [
        "185",
        "1093"
      ]
    },
    {
      "uid": "zhcn:d18af04e4788e04bd200aa51",
      "kind": "text_data",
      "source_text": "RP已经MAX了，走吧。\\n把他们一口气全甩掉！！",
