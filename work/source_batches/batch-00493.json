      "json_path": [
        "184",
        "1064"
      ]
    },
    {
      "uid": "zhcn:c8bdfe4734e73cf8e6b36876",
      "kind": "text_data",
      "source_text": "LANE：太阳神\\nTP到MAX了！快来练个痛快吧～！",
      "source_fingerprint": "93af70743046c24c2029261c1a4ac3d48a9020c03c8482f20c9858ad966ab859",
      "source_path": "text_data_dict.json",
      "json_path": [
        "184",
        "1065"
      ]
    },
    {
      "uid": "zhcn:4e8c9dc6674d45599a74f8e5",
      "kind": "text_data",
      "source_text": "TP满了哦TP！\\n涡轮引擎启动！",
