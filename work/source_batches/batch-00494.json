      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049014"
      ]
    },
    {
      "uid": "zhcn:210983218baa7ec0e323ff91",
      "kind": "text_data",
      "source_text": "呐喊吧！回响吧！",
      "source_fingerprint": "5d0474781ec1e161921e8078c67a82ea1a42b7cb012a3ab82648a398c7a23c1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049015"
      ]
    },
    {
      "uid": "zhcn:6ff85e0ce933ae9f7ea5754e",
      "kind": "text_data",
      "source_text": "与塔可布莱恩的牵绊・踏上大秘境",
