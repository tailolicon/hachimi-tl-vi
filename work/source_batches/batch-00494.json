      "json_path": [
        "181",
        "809052001"
      ]
    },
    {
      "uid": "zhcn:22f43b49d435e819a9977650",
      "kind": "text_data",
      "source_text": "其深意在于……",
      "source_fingerprint": "3456302d39d7b288d29f1d4c719c51bdb77c7596d59e87e6aa4ec570df845d89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809052002"
      ]
    },
    {
      "uid": "zhcn:3d6c6da0b5e73589b16bca15",
      "kind": "text_data",
      "source_text": "所求乃是新书卷",
      "source_fingerprint": "e4a84b3e12940bf540984d537f76d24ca1057c8855aa5aa0909af0d790df59b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809052003"
      ]
    },
    {
      "uid": "zhcn:1a49318d2b2059bcd8012d13",
      "kind": "text_data",
      "source_text": "所求乃是新书卷",
      "source_fingerprint": "e4a84b3e12940bf540984d537f76d24ca1057c8855aa5aa0909af0d790df59b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809052004"
      ]
    },
    {
      "uid": "zhcn:57187fbbd4c2d20f52760198",
      "kind": "text_data",
      "source_text": "故而我，记述着岁月",
