      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049032"
      ]
    },
    {
      "uid": "zhcn:b87b1b2670204fd44ab6ff30",
      "kind": "text_data",
      "source_text": "进展很顺利啊！",
      "source_fingerprint": "88cf2c7a4994e4cfacb89c8705622c5c2814307b07c520e0df0072494e01e7e1",
      "source_path": "text_data_dict.json",
