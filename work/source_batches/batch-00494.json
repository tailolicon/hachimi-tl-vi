      "json_path": [
        "181",
        "809049021"
      ]
    },
    {
      "uid": "zhcn:649297bfe1564c069b240e61",
      "kind": "text_data",
      "source_text": "因为有你在",
      "source_fingerprint": "e9f593336d73eb3b5cffb41f8be64d0e1aac2581a3174cab54dccd31562cd77a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049022"
      ]
    },
    {
      "uid": "zhcn:0a23eeab8e607f080bcbc374",
      "kind": "text_data",
      "source_text": "多亏了你",
      "source_fingerprint": "d68a8cb076bf56db69fa516bc8b69bda0872b65b2e7d0e9e0dd7d4d38d26edaa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "809049023"
      ]
    },
    {
      "uid": "zhcn:b57de8b481384f8a3a2c04ca",
