    },
    {
      "uid": "zhcn:18680a0dd7586a442e938d57",
      "kind": "text_data",
      "source_text": "『精灵赐予的力量·RP已满。与众强敌的\\n决战时刻即将来临——（第6卷261页）』",
      "source_fingerprint": "3194f99456c37632ada402a56e39010b83ecf7b029a16ddb37ba3f82f6039ffa",
