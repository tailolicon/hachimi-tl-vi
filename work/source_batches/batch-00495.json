    {
      "uid": "zhcn:3f36cb5acaaaa859e5744037",
      "kind": "text_data",
      "source_text": "向Master报告。RP已完全恢复。\\n可以出战了。请给我……下达指令。",
      "source_fingerprint": "9d1a0d9d1cef51073fedeef6696d64815a1e63216b7dbd4280b83627ce26e551",
      "source_path": "text_data_dict.json",
