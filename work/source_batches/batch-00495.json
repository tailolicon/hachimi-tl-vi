        "1095"
      ]
    },
    {
      "uid": "zhcn:98c3e78fa0769328431f4d1c",
      "kind": "text_data",
      "source_text": "RP满了！出阵的时刻到了！",
      "source_fingerprint": "6eabeae6957913be480426ae6317cff737e4033ba9e50b96e0995016c094d7e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "185",
        "1096"
      ]
    },
    {
      "uid": "zhcn:f984bac596ffa14130c2ad7b",
      "kind": "text_data",
      "source_text": "RP满了……啊啊……已经按捺不住了……",
      "source_fingerprint": "ddf89298692bc881c1bdae0afcabfbde00f4c02b8158a14ad3a281960b587645",
