      ]
    },
    {
      "uid": "zhcn:ab93733ab8ad1792edab5b1b",
      "kind": "text_data",
      "source_text": "RP恢复了！奔赴赛事的舞台吧！\\n一切……都是为了宣传苫小牧！",
      "source_fingerprint": "44ce2c3b2932c857d81220ffcd1a729bafb42652e04174ebad736ee881f171f1",
