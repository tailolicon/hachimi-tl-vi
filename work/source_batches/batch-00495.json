        "1048"
      ]
    },
    {
      "uid": "zhcn:97cc3c9c4b634dfe9fe42330",
      "kind": "text_data",
      "source_text": "RP满了。\\n那么，令人热血沸腾的时间开始了。",
      "source_fingerprint": "45aacbc11ad8e1dd7e81f6c02ac071faa8370665a91ec412c5cc071d5e0257ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "185",
        "1049"
      ]
    },
    {
      "uid": "zhcn:2c7700317334e1daebbcde7c",
      "kind": "text_data",
      "source_text": "听说RP完全恢复了。\\n……所以？比还是不比？",
