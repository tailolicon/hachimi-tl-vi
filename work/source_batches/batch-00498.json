      "source_text": "リヴァーレだからこそ",
      "source_fingerprint": "39d0d7275c4c57469ffb58af817151a0fab599f74653c4a339d2ec96f5ae924c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830190003"
