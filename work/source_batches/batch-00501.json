      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830316003"
      ]
    },
    {
      "uid": "zhcn:0155b0bb8820d515f4212999",
      "kind": "text_data",
      "source_text": "以食为乐，愿见欢颜",
