      "uid": "zhcn:0155b0bb8820d515f4212999",
      "kind": "text_data",
      "source_text": "以食为乐，愿见欢颜",
      "source_fingerprint": "031836a1ad5a8b46a463500d9d48a1b368b8771a7bcf530c64776bb183e8799e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830317001"
      ]
    },
    {
      "uid": "zhcn:125586198c213bb814c1fc4d",
      "kind": "text_data",
      "source_text": "那一天，那一刻，那个小诗",
      "source_fingerprint": "c4ce2a3c40a301d634498e4b9bab25cb34a6a59c2182591bdf12ce742ecf70f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830317002"
      ]
    },
    {
      "uid": "zhcn:936f166be4e6521dd07243ad",
      "kind": "text_data",
      "source_text": "小小的成长故事",
      "source_fingerprint": "4d425610ec8742fc9b1a63ab927467868a7a745aab1a479418f435c5560bc6b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830317003"
      ]
    },
    {
      "uid": "zhcn:cf75175933fb33c17fdaf05e",
      "kind": "text_data",
      "source_text": "学生会副会长的报告书",
      "source_fingerprint": "123edf5fec5626c40be7d04e78378a5e67f1cbd9520b9bd6dd1f398fc1c5a5f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830319001"
      ]
    },
    {
      "uid": "zhcn:13690e88a64be802e6511a56",
      "kind": "text_data",
      "source_text": "学生会副会长的根源",
      "source_fingerprint": "ac55fe964ae6f6a563980041aa163093504dbfac8c133b29dcd4ec79f0425f2f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830319002"
      ]
    },
    {
      "uid": "zhcn:9dba4d57d4787793a41447f7",
      "kind": "text_data",
      "source_text": "学生会副会长的“未来”",
      "source_fingerprint": "b1776ccac30f77807e9824a5756dcb06b871e1078f667666c135d7075c18dfea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830319003"
      ]
    },
    {
      "uid": "zhcn:b03715842a33fe0713b11078",
      "kind": "text_data",
      "source_text": "不知所措的指导",
      "source_fingerprint": "892120b2f2debb8d2140abcd0efee9260f1c2266291fcd58b9b3ed753e4d0de4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830320001"
      ]
    },
    {
      "uid": "zhcn:9ea8cd9a1afd65de6670b1bd",
      "kind": "text_data",
      "source_text": "笨拙的交流",
      "source_fingerprint": "924b55792436f1c6170df1aff61a0eccc8943e0bfdbd63506033206c6daadc01",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830320002"
      ]
    },
    {
      "uid": "zhcn:cdd0406d6d849a72938705c6",
      "kind": "text_data",
      "source_text": "悄然的温情",
      "source_fingerprint": "cf703eff93b1d0491046348d6f89f6e9baa2cec119dba7c3916fe838ab3750e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830320003"
      ]
    },
    {
      "uid": "zhcn:2705d24ed333cd07ffd0e620",
      "kind": "text_data",
      "source_text": "『彼者，自魔界现身』",
      "source_fingerprint": "36fc7f394d4158e290f5baf0e40e45d974695ede37d41ba1a77b93e9863688df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830321001"
      ]
    },
    {
      "uid": "zhcn:d3d0e230eabe14b12e75d46d",
      "kind": "text_data",
      "source_text": "『讨伐夜之王！』",
      "source_fingerprint": "bcb7af904938dcb45276153603ed9e026de6cabd1ada9034872ad380cbcadee1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830321002"
      ]
    },
    {
      "uid": "zhcn:c6cf650f59ee17f807b31b27",
      "kind": "text_data",
      "source_text": "『满月中闪烁的是，赤色之石』",
      "source_fingerprint": "62d777a53b9b1996a98eca833be9120dbcc30fe38c878848ad03d12b833f9c65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830321003"
      ]
    },
    {
      "uid": "zhcn:d817f7ca7c285fb6d999c01b",
      "kind": "text_data",
      "source_text": "求神拜佛，不如求Maya",
      "source_fingerprint": "051ac4310c310448bb2d2efede8471af8d3080575cab7b728128aabc69389f75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830322001"
      ]
    },
    {
      "uid": "zhcn:53c69ad5d060f371384c2898",
      "kind": "text_data",
      "source_text": "大家真正需要的东西",
      "source_fingerprint": "163dddd2976f8db97be1b8fc9a737b2a001d5802c5114bfa938dc2b68a3070f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830322002"
      ]
    },
    {
      "uid": "zhcn:a9a7294692833ed8bc7ccedc",
      "kind": "text_data",
      "source_text": "Maya，完全懂了！",
      "source_fingerprint": "cb10b9cc2b5d79c7bcc516984bf1c229c6641f73aa5c4bae2b15ebcaa6f447fb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "830322003"
      ]
    },
    {
      "uid": "zhcn:09cbe485f5ae09452e2973d5",
      "kind": "text_data",
      "source_text": "「初次见面！」",
      "source_fingerprint": "52740704cafe74951345d34054c623fd1c26ce07769fa464e2287842f24b1984",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001001"
      ]
    },
    {
      "uid": "zhcn:953678d8032a54577ff62669",
      "kind": "text_data",
      "source_text": "「我出门了」就从这里开始",
      "source_fingerprint": "55fbb2cbac14d2c89d6ba1704255a66915e9f8037bed239dcd0ddc17b8dd94c4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001002"
      ]
    },
    {
      "uid": "zhcn:852933787258e9731486d1b3",
      "kind": "text_data",
      "source_text": "欢迎来到特雷森学园！",
      "source_fingerprint": "98f02797b94febc40a7743e3a0d81f28d9caa4ca1d99315ad7ded4c8e4b71a63",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001003"
      ]
    },
    {
      "uid": "zhcn:3c860589486c942a8a0653f5",
      "kind": "text_data",
      "source_text": "太早开始的一日",
      "source_fingerprint": "2194446382b8afd261d9579e789168fc92b36fc0ba8ca9353677ced47c5e2908",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001004"
      ]
    },
    {
      "uid": "zhcn:7d6e4a0b854e84e411de0964",
      "kind": "text_data",
      "source_text": "在此奔跑的意义",
      "source_fingerprint": "e74748d2f6331488ef7b46e2e497e9bbd0a060acdba39b791120e1e7bf328345",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001005"
      ]
    },
    {
      "uid": "zhcn:836c3b584b54deea68f81b0d",
      "kind": "text_data",
      "source_text": "睡不着的夜晚，然后",
      "source_fingerprint": "f20ef86e2c8a296a50d3590ab9810ce075aa2963f236100ed21d4fe05b5edcd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001006"
      ]
    },
    {
      "uid": "zhcn:7937a51d7ac5e3de35f8f595",
      "kind": "text_data",
      "source_text": "「一骑绝尘无与齐驱」",
      "source_fingerprint": "a75f6944aca848b20435344e9c976243cbe747b0e2334a85cf4d70b9fc322595",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001007"
      ]
    },
    {
      "uid": "zhcn:89683395ed135cce79a72e6b",
      "kind": "text_data",
      "source_text": "一定会由此开始，绝对会在这里",
      "source_fingerprint": "2c38f7324094df8813c8b9d5185b5ca16c3156aaaeea5e1c0b31ba056a60e716",
      "source_path": "text_data_dict.json",
      "json_path": [
        "181",
        "90001008"
      ]
    },
