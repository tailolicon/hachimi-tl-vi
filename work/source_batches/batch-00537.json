      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "61"
      ]
    },
    {
      "uid": "zhcn:046535407e9751ee6c65fd5f",
      "kind": "text_data",
      "source_text": "各自起飞",
      "source_fingerprint": "c78e3e756521a2ec7fa6529eb5ee30b8ab8b196c50a230da95d7b256aea28a32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "62"
      ]
    },
    {
      "uid": "zhcn:a3f853d24898fc2d0b723345",
      "kind": "text_data",
      "source_text": "圣诞节到了！",
      "source_fingerprint": "6fe4d29e33a5dafff2fdc3e18f2f3aadd4340f20cbb9a27eddf02e720b44c77b",
