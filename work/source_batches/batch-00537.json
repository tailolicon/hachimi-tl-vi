      "json_path": [
        "191",
        "64"
      ]
    },
    {
      "uid": "zhcn:5363b4e2fb2368f1aaa3edb4",
      "kind": "text_data",
      "source_text": "保佑我吧保佑你吧！开运祈祷",
      "source_fingerprint": "95f278c9a02c90f8042fb9b38f04ebef7324537605863595a9eeec4cb2ac1d2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "65"
      ]
    },
    {
      "uid": "zhcn:05b7c58656a57a702e33a8b6",
      "kind": "text_data",
