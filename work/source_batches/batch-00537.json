      "source_fingerprint": "4b78dc2be22c6634bedb51c85ec3efc82ac3793295122e364b353d23a76baa0a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "68"
      ]
    },
    {
      "uid": "zhcn:b983e4a28c383632323d1f1c",
      "kind": "text_data",
      "source_text": "激励！名将怒涛！？",
      "source_fingerprint": "7f08f0022b152de4d5cb8b8bb84b74fe564aaa5fa708bc2bef91511e8e5339af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "69"
      ]
    },
    {
      "uid": "zhcn:b3bb86082e9bb71298e28c7f",
