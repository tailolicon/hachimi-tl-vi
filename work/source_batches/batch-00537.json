      "source_fingerprint": "a75f6944aca848b20435344e9c976243cbe747b0e2334a85cf4d70b9fc322595",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "7"
      ]
    },
    {
      "uid": "zhcn:df965a089aa56f13e4efff85",
      "kind": "text_data",
      "source_text": "准备上阵！",
      "source_fingerprint": "f2e4e02a47ef7cf26a0f1b57303da651b6082a70681bf17c62c2d9a38b67decc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "70"
      ]
    },
    {
      "uid": "zhcn:4da7360f14674243c93e7e6c",
      "kind": "text_data",
      "source_text": "队伍＜新春大大吉来＞！",
      "source_fingerprint": "c262bdb4aab5ea02c7d31ab5ba33accde8109460a6b43d0b79b41c2c8f2acfec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "71"
      ]
    },
    {
      "uid": "zhcn:58d290295af1d93c63c7ac56",
      "kind": "text_data",
      "source_text": "天晴大家招来福气！",
      "source_fingerprint": "43b60dcd3ecad3907bbacf511c73af013aa209f6ac36aae4d195ebc9570cbe06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "72"
      ]
