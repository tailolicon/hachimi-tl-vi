{
  "schema_version": 1,
  "batch": 544,
  "batch_count": 1662,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "c0513553da490a692523f45b5f779f99f6cb7e34",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:c67a0ad977d69369db53f7fd",
      "kind": "text_data",
      "source_text": "来自目白家的爱",
      "source_fingerprint": "3924e828ff0027d2ccd79cdfea38cacbf93ac570d8ec9edceb8e627b352afcc5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "251"
      ]
    },
    {
      "uid": "zhcn:b67da069fdf7f6d91a108870",
      "kind": "text_data",
      "source_text": "让这个充满爱的夜晚",
      "source_fingerprint": "059d425d3b294caea79a2c4eec8be4f74fb17f39ccbc8550943128f295808c4f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "252"
      ]
    },
    {
      "uid": "zhcn:9abb883eb79c695853143315",
      "kind": "text_data",
      "source_text": "一年不会徒然结束",
      "source_fingerprint": "797542093a93c0cfc9eefdb85c9b39971456788743043d73ebd3fbe209d97b1d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "253"
      ]
    },
    {
      "uid": "zhcn:a3468ef85867816e10fa253b",
      "kind": "text_data",
      "source_text": "和大家快乐过年！",
      "source_fingerprint": "16ac3980198bb4c75119d77a7301d4ff47ae261503c4afca0e1121d9fac2309d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "254"
      ]
    },
    {
      "uid": "zhcn:257d4a011852a0d49c4914cd",
      "kind": "text_data",
      "source_text": "饭撒要完美……？",
      "source_fingerprint": "be1290da95989dabed317ecaf79501ecde15cd63d6fbefebb7842e64745bba17",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "255"
      ]
    },
    {
      "uid": "zhcn:1e9814c8efc03356b4adafe7",
      "kind": "text_data",
      "source_text": "送上最强的饭撒",
      "source_fingerprint": "06e6d23cbafd11f7b548f6e368ab689c2d2c5a1f0dce3016599d4fd598de9560",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "256"
      ]
    },
    {
      "uid": "zhcn:bf1d290e0238ae1413117aea",
      "kind": "text_data",
      "source_text": "开办！跨年倒计时派对",
      "source_fingerprint": "e871806028dd7c08eb93ee0a40dcde4b20080cd9e8844ae0cc9f1bded7743e48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "257"
      ]
    },
    {
      "uid": "zhcn:4261afc0857ba2391414cc54",
      "kind": "text_data",
      "source_text": "各自被爱的方式",
      "source_fingerprint": "1233041d76914ab4d332c27772607d9bc233d77135f828103ce34ad3eb7328de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "258"
      ]
    },
    {
      "uid": "zhcn:7ae1944618bc898008e1cd75",
      "kind": "text_data",
      "source_text": "我们独特的模样",
      "source_fingerprint": "f590c89e39986b86d115c6ac5275193bf04228ba766f44ba81d6f672482304ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "259"
      ]
    },
    {
      "uid": "zhcn:267e35745bd24bb311b484db",
      "kind": "text_data",
      "source_text": "赛马娘是作弊玩家？",
      "source_fingerprint": "32a1476bb14cef0fa234b29410d1af7736932eae13319172a45e9519b5014929",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "26"
      ]
    },
    {
      "uid": "zhcn:135c430bf6d9140121b877d0",
      "kind": "text_data",
      "source_text": "我也是大家的爱马！",
      "source_fingerprint": "a24c93a46d3cf6220123ba7145f90932a823c4fc3a25581c350df9623c3ea564",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "260"
      ]
    },
    {
      "uid": "zhcn:ae3852e51fb85b56b6411b61",
      "kind": "text_data",
      "source_text": "煎茶　桃山　慢悠悠",
      "source_fingerprint": "b486942bb960d5f172837d5f9c3372b0de234bae277b5a1a9a86c200588afba9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "261"
      ]
    },
    {
      "uid": "zhcn:6660358386a37f51b0cb715b",
      "kind": "text_data",
      "source_text": "松散　融化　黄身时雨",
      "source_fingerprint": "1105cb7e010a5502c66ebe2cf3b9a78bdba736ba803a7e1dcfda18b39516526e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "262"
      ]
    },
    {
      "uid": "zhcn:7af84d4de4cf4be755f0265f",
      "kind": "text_data",
      "source_text": "咖啡　羊羹　赴幽会",
      "source_fingerprint": "b596fb19a665b0ccd5ad800c8f5d88a4c5896912fe00edba5939bc4c97096d28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "263"
      ]
    },
    {
      "uid": "zhcn:b18c5f5958a4ce04c29560c2",
      "kind": "text_data",
      "source_text": "迸裂　绽放　米糖火花",
      "source_fingerprint": "f5845906e9fe0340f239d019d58d218dbf4477456dc339ca4ea8dbdb3e0a31b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "264"
      ]
    },
    {
      "uid": "zhcn:68dc4cd0d6bcef4ab94af0fb",
      "kind": "text_data",
      "source_text": "葛切　飞溅　拌红糖",
      "source_fingerprint": "cc135296bca2e3160d4614338c25f4190857abf2ce48becb43443189b33c2ed5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "265"
      ]
    },
    {
      "uid": "zhcn:2d005a2599535dea34e74433",
      "kind": "text_data",
      "source_text": "石衣　窥见　朔月",
      "source_fingerprint": "580e930504f823fb1de3449cface7100cd304a29b936068098f2d0f7fcb11b06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "266"
      ]
    },
    {
      "uid": "zhcn:2d22c9a980735f366f644be4",
      "kind": "text_data",
      "source_text": "笑呀闹呀　金平糖",
      "source_fingerprint": "cbdba55ddf350ad3ec6b6dd11f6a8e5ece555f5654d4b9bff79a2894cee71843",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "267"
      ]
    },
    {
      "uid": "zhcn:4b239c2ecdc7ea872ecb0a59",
      "kind": "text_data",
      "source_text": "点缀　色彩　琥珀糖",
      "source_fingerprint": "0160ee5d53d99a1a6bbb1e8d8c3555565b7260fc63d03992db2aada6d60889bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "268"
      ]
    },
    {
      "uid": "zhcn:3ddc9dad3edbdec57b8f0e53",
      "kind": "text_data",
      "source_text": "直奔向你",
      "source_fingerprint": "4d9b66b06b687977a2c8fff4d7748d03e4d72040e1d6983c2d1f3081e5eb7ad9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "269"
      ]
    },
    {
      "uid": "zhcn:ad64b61166b3bd396e9c793d",
      "kind": "text_data",
      "source_text": "战斗！出道战",
      "source_fingerprint": "fbeb44bd1c72603f2d62be5bc624478d0151cce3bb78bed3983d2547f1f584b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "27"
      ]
    },
    {
      "uid": "zhcn:cce0eb9a674ef52164cde7b3",
      "kind": "text_data",
      "source_text": "突击！再突击！！",
      "source_fingerprint": "30562f4f4263f2582cbf60af6d93e0af4267dca0aa80c3d9d8fa8e11e1a5044b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "270"
      ]
    },
    {
      "uid": "zhcn:f347a218bbc0277d75e54edb",
      "kind": "text_data",
      "source_text": "互相，了解内心",
      "source_fingerprint": "2d137477f536e31e65b96654dd1c6a070e2df143a3a2c1202e7218ad31b80e8d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "271"
      ]
    },
    {
      "uid": "zhcn:902fa1482c41630291420113",
      "kind": "text_data",
      "source_text": "与特别的人",
      "source_fingerprint": "d5fd0fa56c30ce16ab382e3b315ab1e50feb4600f66736e59d239082b2c93fc7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "272"
      ]
    },
    {
      "uid": "zhcn:4adbd8adb17c0692403a4cea",
      "kind": "text_data",
      "source_text": "最开心的，是和你一起",
      "source_fingerprint": "fdc2831c934fb91972b62c68699660373bdd6335fc7c641591926e967464e390",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "273"
      ]
    },
    {
      "uid": "zhcn:c802ea06f55a860eae2c2354",
      "kind": "text_data",
      "source_text": "满怀热情……突击！",
      "source_fingerprint": "fcd524438c6e540ed3f6ac07a4011665ace3e850860d93d67143a47fbb014925",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "274"
      ]
    },
    {
      "uid": "zhcn:bb26fc3ff4f92638951992a3",
      "kind": "text_data",
      "source_text": "萌生心愿",
      "source_fingerprint": "1d9c683ef6333a3a248f9d0b01a660a249b7b2fdaadfe2efd0a4aa3f86f827c4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "275"
      ]
    },
    {
      "uid": "zhcn:ca2aae5baf21df0fa0977550",
      "kind": "text_data",
      "source_text": "嘿，笑一下",
      "source_fingerprint": "677730c934e78728a445516bd266d107e6bcabd281d337afae7d19c0f7784bb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "276"
      ]
    },
    {
      "uid": "zhcn:73d7cc5c2b8fac21ade2aadd",
      "kind": "text_data",
      "source_text": "揭竿而起，下克上！",
      "source_fingerprint": "c45d0a474fe0e208fe1d47de00e52b74440e4b4ca2fc925f184c5a1427b74a13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "277"
      ]
    },
    {
      "uid": "zhcn:12a3dd1de13374db0cf9e211",
      "kind": "text_data",
      "source_text": "＜天队＞！出动！",
      "source_fingerprint": "77b60d132b07f3c32ab96765a95ca601c37deda76f3797aa154072c4992129f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "278"
      ]
    },
    {
      "uid": "zhcn:31b316a99a874650bab2c3a6",
      "kind": "text_data",
      "source_text": "群雄割据之乱世",
      "source_fingerprint": "7d08bc9af7d53987bad9be1b8825ef8e3c92d3906849658c95652b8f9323c58f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "279"
      ]
    },
    {
      "uid": "zhcn:576dfdad57cd2492d011f83a",
      "kind": "text_data",
      "source_text": "两大魔将来袭！",
      "source_fingerprint": "e6fc1543c0a3a4f6a28819cccb91e51ed59b58cb7d7980831ae95aba3f082ed4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "28"
      ]
    },
    {
      "uid": "zhcn:050f922bde435c613bdeb9ed",
      "kind": "text_data",
      "source_text": "大河忍法帖♡",
      "source_fingerprint": "11b5e08ac64d6b4556b1666069729b2704965067cf7fab515ede84f37dc7c74b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "280"
      ]
    },
    {
      "uid": "zhcn:0ec9b7e5ab0703dee5557f0d",
      "kind": "text_data",
      "source_text": "伟大觉悟",
      "source_fingerprint": "ce8bf1a5a24ec73ee34ec778c574c39adb9dccd9548bd02b6e3f346c79ac0f36",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "281"
      ]
    },
    {
      "uid": "zhcn:1f5763d0fe060dd5f6010d62",
      "kind": "text_data",
      "source_text": "背叛者",
      "source_fingerprint": "10f9c9bb9a2863db3bb6a01881856ac1ad25eff20ae7238b6bc10a25dfc2a575",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "282"
      ]
    },
    {
      "uid": "zhcn:675f13d8d60712ce298cf27e",
      "kind": "text_data",
      "source_text": "好险，好险！",
      "source_fingerprint": "c89e362c1b90c7b80b9a5360f234d02c0236657221ebf10a1b008298e061ad7f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "283"
      ]
    },
    {
      "uid": "zhcn:72b216096e689b698a6ce040",
      "kind": "text_data",
      "source_text": "天下统一！",
      "source_fingerprint": "7d46711c7aa558e3e4a95a91e7cd42d2581cdea4e19f50e62eb3d7a555e2e8c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "284"
      ]
    },
    {
      "uid": "zhcn:5b69bb736fba31ad74505970",
      "kind": "text_data",
      "source_text": "缪斯候补与缪斯女仆",
      "source_fingerprint": "c2255d07babbb6f5e7e2909b98d328f89ac9ffadaefb4a90ac663e844976078f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "285"
      ]
    },
    {
      "uid": "zhcn:eefb1f5c639ae75c5ce3a9c4",
      "kind": "text_data",
      "source_text": "开幕，迷宫逃脱选拔赛！",
      "source_fingerprint": "00d04ddfacfb5615e109712ae545a51198ccfde05127e6eff305567e9aeaa81f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "286"
      ]
    },
    {
      "uid": "zhcn:07bed166e74acf6395306d0d",
      "kind": "text_data",
      "source_text": "我的原点",
      "source_fingerprint": "14690a8bd45ca76e2477eb0f33cebf5b9017e3c1a8293f6904fc0cbf1ebeb334",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "287"
      ]
    },
    {
      "uid": "zhcn:1219c7611309d5c35dc0463b",
      "kind": "text_data",
      "source_text": "你的背后援助",
      "source_fingerprint": "547b2313e9e64a9c0fa95adf2fffeb25180becff0a8665f11aa3eb4f16fd18ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "288"
      ]
    },
    {
      "uid": "zhcn:b8b03ae7666301ec3528e167",
      "kind": "text_data",
      "source_text": "刚毅之壁阻挡在前……",
      "source_fingerprint": "c577d7573fbceb44cb5bf7766f92e88d1be9a72ebca06de92f5fa02c64df9e48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "289"
      ]
    },
    {
      "uid": "zhcn:418c40d838674d2647713d39",
      "kind": "text_data",
      "source_text": "对决！马王",
      "source_fingerprint": "31ec6f45a14be80c6c262793807014209b6dc8b14842da8bcdf27ecb95735a10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "29"
      ]
    },
    {
      "uid": "zhcn:fe6898358095d097de4bd821",
      "kind": "text_data",
      "source_text": "为挑战者献上祝福",
      "source_fingerprint": "58cca854275c08a7d834d3d9abfbb1273d2cebaebf2348367635a6f3e4897d0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "290"
      ]
    },
    {
      "uid": "zhcn:dbb7cef94d2a5eaa7e02ee4b",
      "kind": "text_data",
      "source_text": "变革的特别魔法！",
      "source_fingerprint": "61f0d2d5247a4c14e854a8c45fda24c8ad98243366f6a4a428270049bbc43cdf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "291"
      ]
    },
    {
      "uid": "zhcn:4ad586dbb47d3b7159bbd475",
      "kind": "text_data",
      "source_text": "敬启，独一无二的我――",
      "source_fingerprint": "f38e4db0bc6e6a5531a04ba841f9a3d1f1069fa45cb63cb14f736b29cb882448",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "292"
      ]
    },
    {
      "uid": "zhcn:c8c763ed4bbe40226bca4519",
      "kind": "text_data",
      "source_text": "盛夏沙滩沙土嘉年华！",
      "source_fingerprint": "a9bc27f941b144464d97461545e7a278949a4285e83e4ec19a59b6b0d299ac68",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "293"
      ]
    },
    {
      "uid": "zhcn:3ac11c85ddafeb6a57cb09f3",
      "kind": "text_data",
      "source_text": "跌跌撞撞起跑线",
      "source_fingerprint": "547e7a55e7e67bfd8a8ad6cae1d195d61ed2ed0e60e755611c886efeed061094",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "294"
      ]
    },
    {
      "uid": "zhcn:6da08c364b570dd99e84f613",
      "kind": "text_data",
      "source_text": "海风有点咸",
      "source_fingerprint": "02214853580429e6ed291107ca393bac62580244ac2b4a2c3c6cc18a1e9c2517",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "295"
      ]
    },
    {
      "uid": "zhcn:42aa1ec2e7a8fae2778e861c",
      "kind": "text_data",
      "source_text": "像她一样",
      "source_fingerprint": "e3cc09993a998f0a4ef29c44ec26effdfe02ba0a413392a0c91823b51dee69a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "296"
      ]
    },
    {
      "uid": "zhcn:54770ccdbd0099edd0c08f6e",
      "kind": "text_data",
      "source_text": "所谓团队协作……",
      "source_fingerprint": "927a92abb3e23cbde210949f375d16c4f0f2f7343dac64aa5c73c065b03d84e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "297"
      ]
    },
    {
      "uid": "zhcn:1554f7bade5eccf6650c9d22",
      "kind": "text_data",
      "source_text": "夕阳下最佳镜头！",
