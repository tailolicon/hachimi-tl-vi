      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "405"
      ]
    },
    {
      "uid": "zhcn:93e1156a8c2f6ab917b175a1",
      "kind": "text_data",
      "source_text": "响彻吧！Entusiasmo！",
      "source_fingerprint": "db2890963eb6ce53dbf7c5c43020d9f1c6ef16ed2ec2dbe74912200e3dee105e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "406"
      ]
    },
    {
      "uid": "zhcn:a87f3f1ffa06f907871e5ba2",
      "kind": "text_data",
      "source_text": "融化凝固、再打个结？",
      "source_fingerprint": "f6f3b93d66e428015b5a7788997041cd73cd343cd0ca6dd5db63c56f52e03877",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "407"
      ]
    },
    {
      "uid": "zhcn:3b4bca2ce159f50ecedbc276",
      "kind": "text_data",
      "source_text": "释放吧！必杀的心意！",
      "source_fingerprint": "0f6522a492fe210ed438f3cdcdedf723a3a9356c655b5fa79fdd52a880f50fa2",
