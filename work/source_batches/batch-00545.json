      "json_path": [
        "191",
        "408"
      ]
    },
    {
      "uid": "zhcn:216805777cd31a4dc7daae4a",
      "kind": "text_data",
      "source_text": "遥远而切近的心",
      "source_fingerprint": "7456cdf0ea38094070d914d9df8c63b1a405041c4563510e55b749b8f4c95861",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "409"
      ]
    },
    {
      "uid": "zhcn:4888361a2f1f2d5b67e9d9a7",
      "kind": "text_data",
      "source_text": "Hello！Halloween！",
      "source_fingerprint": "968b1ec22e5f259e61a5ae33115e9ccbd372b6f8d5bd0be7156a1ab747de7919",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "41"
      ]
    },
    {
      "uid": "zhcn:9c504706670e3d3377afe49a",
      "kind": "text_data",
      "source_text": "往“连接”的“轨道”",
      "source_fingerprint": "0bc8574581b6216432d9ce9a9a419dbb4776b3a1b74fc7b9c622831030743d03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "410"
      ]
    },
    {
      "uid": "zhcn:6a3f2b830781128c943c19cf",
      "kind": "text_data",
      "source_text": "仅仅是，“全力以赴”",
      "source_fingerprint": "d6c44fe3ad1b3aa02638f445510ba2fded69d24a330a350a07af80a2ce642d39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "411"
      ]
    },
    {
      "uid": "zhcn:faf1a15dbd846f9c9988068b",
      "kind": "text_data",
