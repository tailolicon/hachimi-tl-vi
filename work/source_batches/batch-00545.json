        "361"
      ]
    },
    {
      "uid": "zhcn:594d8797705ce6d2687e9dd8",
      "kind": "text_data",
      "source_text": "我们的『爱』",
      "source_fingerprint": "720edc47043194e979f50d90d552cddd90ea2c0439dba61f8c78f1ab2b38833b",
      "source_path": "text_data_dict.json",
