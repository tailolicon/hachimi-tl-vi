  "entries": [
    {
      "uid": "zhcn:39433c0936e75c50ed1fc9df",
      "kind": "text_data",
      "source_text": "究竟会是哪位赛马娘能以第1的成绩抵达终点……！",
      "source_fingerprint": "e9f4252372774d4c771bd649939cafd08d81797da6ce60ecdb0264fc0bf5a562",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1401"
      ]
    },
    {
      "uid": "zhcn:df939ce043281904b4808099",
      "kind": "text_data",
      "source_text": "谁能够第1个跑完<race_distance>呢！",
      "source_fingerprint": "7c8eb3e7907ae1647485b4a9d6e316c7c338d06c1c7c0c94efcca1158a96e451",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1402"
      ]
    },
    {
      "uid": "zhcn:9040833901cb1857eea3ebad",
      "kind": "text_data",
      "source_text": "最快的会是谁……！",
      "source_fingerprint": "cbda784640152285c8d2c32943fac5e0c75a7e79d754c80aa5618e3e1cea8410",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1403"
      ]
    },
    {
      "uid": "zhcn:6a38121f738794ba91ffe516",
      "kind": "text_data",
      "source_text": "专注看着前方迈进！",
      "source_fingerprint": "c06bdca4fae7bc1bb23665083e7310967acb8b3d4247b161598ca2630790063f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1404"
      ]
    },
    {
      "uid": "zhcn:82c91b807f03c9a007a917ad",
      "kind": "text_data",
      "source_text": "在抵达终点前无法移开视线！",
      "source_fingerprint": "26e1a96a39a20d7a74f96fc75a45a636e820fc3c14885e0c231ee48047c85950",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1405"
      ]
    },
    {
      "uid": "zhcn:93e6334d84c19ceb36be8d0c",
      "kind": "text_data",
      "source_text": "朝<race_distance>前方的终点奔驰！",
      "source_fingerprint": "cfebe28115957508d07924c2fb8678d1e77cb909e8eba4a084a369432a421912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1406"
      ]
    },
    {
      "uid": "zhcn:9050e6ec0d51a7527c33797e",
      "kind": "text_data",
      "source_text": "最精彩的竞赛，现在开始……！",
      "source_fingerprint": "12ffc17c61f6ca72702fa99c1e5c39702f058e69492db25946f02483832c5e40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1407"
      ]
    },
    {
      "uid": "zhcn:36fc39b7096f79d5d4f9b536",
      "kind": "text_data",
      "source_text": "你支持哪一位赛马娘？",
      "source_fingerprint": "17a15c46d4fffae3d1122a4acd60467263d47ae018d15f36392ce7abe1728afe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1408"
      ]
    },
    {
      "uid": "zhcn:82652d98c9831aff2b53311b",
      "kind": "text_data",
      "source_text": "能超越9人成为第1的会是谁！",
      "source_fingerprint": "3fdf2679c3f1e636e76b66ddc81e8e36b75f0f1f6689ee186bd5209ee280402d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1500"
      ]
    },
    {
      "uid": "zhcn:a3ffd39cd2ba947f4c552295",
      "kind": "text_data",
      "source_text": "获胜的会是哪位赛马娘呢……！",
      "source_fingerprint": "41e9ed0044fe99ae5787383a926d39b23a84e045839723bf39696933cdd0fc44",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1501"
      ]
    },
    {
      "uid": "zhcn:8e083d0a2357c5c2dc62b207",
      "kind": "text_data",
      "source_text": "去抓住未来吧！",
      "source_fingerprint": "46f8f579c965a4ae688c653c64907f9ca21e52904da88e75fd3ea0f5f7056953",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1502"
      ]
    },
    {
      "uid": "zhcn:f1e75dad75a45798ecfa5737",
      "kind": "text_data",
      "source_text": "难以预料的伏兵也值得关注。",
      "source_fingerprint": "69f590abbb84b5bbb076d2cf79ec676f9caf0ca189a37594af471eb4499f6168",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1503"
      ]
    },
    {
      "uid": "zhcn:acbd83e21dd53ca70da950f7",
      "kind": "text_data",
      "source_text": "最终取得第1的会是……！",
      "source_fingerprint": "fe27e1663d0ddfc71ee7ed28daa5fd8e01bc7c0bb3183dec9626b24c90ecba28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1504"
      ]
    },
    {
      "uid": "zhcn:d1b1dda0bdac7cdb65edc765",
      "kind": "text_data",
      "source_text": "期待她们各自带着自信的表现吧。",
      "source_fingerprint": "886da9b4cef997afeb65bddbae5aa4b36ec0e77bc379ef57cea234330138b68f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1505"
      ]
    },
    {
      "uid": "zhcn:881410ed17a3348f3a24e484",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛 <race_name></color> ROUND2开始。",
      "source_fingerprint": "7634a445a9d42a7ccd55f13b99185e57f995766f655c35f2fea9d6c6cc071e8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2000"
      ]
    },
    {
      "uid": "zhcn:e04cd1fd3be59ba7e6590d5f",
      "kind": "text_data",
      "source_text": "值得关注的<color=#ff9900>群英月赛 <race_name></color> ROUND2。",
      "source_fingerprint": "d0cda02e330d6a5d7c104f8c4cbd6d7d1d86f99d34ea54b040cba290be105ef1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2001"
      ]
    },
    {
      "uid": "zhcn:1cf36aa0fa1c364cb50225b5",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛 <race_name></color> ROUND2，舞台是<race_course>赛场。",
      "source_fingerprint": "08539786e7b053419369b03afb88d0e1b8aa5fc5f3e2cc1fe05417fa494fd004",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2002"
      ]
    },
    {
      "uid": "zhcn:a2af6262075a24175d6312f1",
      "kind": "text_data",
      "source_text": "优骏集结<race_course>的赛场，<color=#ff9900>群英月赛</color>。",
      "source_fingerprint": "08f41827a9930d5ef1fac621ddaa198ff4589e0f8be6d8de26b875499cefeafc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2003"
      ]
    },
    {
      "uid": "zhcn:d9ac0766c43e9bf716540d3d",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> ROUND2，期待已久的这个时刻来临了。",
      "source_fingerprint": "c0cb3971a633417cb24d54b08adca0ba3da6578db0571adc0525ac7e43f83b2e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2004"
      ]
    },
    {
      "uid": "zhcn:772e7eccc719e04d2b66fd0e",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛 <race_name></color> ROUND2。",
      "source_fingerprint": "5af16d9303137f1b03678e53df3a0cce32325ba7f43886ac330f46628c331abb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2005"
      ]
    },
    {
      "uid": "zhcn:a75ab8671ae3e43558c2ed76",
      "kind": "text_data",
      "source_text": "终于即将开始，<color=#ff9900>群英月赛 <race_name></color> ROUND2。",
      "source_fingerprint": "ffd34ccbcd7703846d808ea70122c7a6443401b3463a3c66cf71a92447d8a664",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2006"
      ]
    },
    {
      "uid": "zhcn:6d6776d1a5f8eaa758af8d67",
      "kind": "text_data",
      "source_text": "激战的<color=#ff9900>群英月赛 <race_name></color> ROUND2。",
      "source_fingerprint": "acf811df39c67b6848ebcf8d9cb1a71e2a0572924d0e1d93862944146f4a037e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2007"
      ]
    },
    {
      "uid": "zhcn:756587923412b58c0a41208e",
      "kind": "text_data",
      "source_text": "情绪高昂的<color=#ff9900>群英月赛</color> ROUND2开始。",
      "source_fingerprint": "c654ea4b2c92df0036e5e7178c5871995a299045f996931f093114d2532d25c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2008"
      ]
    },
    {
      "uid": "zhcn:d157a391cc3a986066470f09",
      "kind": "text_data",
      "source_text": "无比激烈的<color=#ff9900>群英月赛 <race_name></color> ROUND2。",
      "source_fingerprint": "65de3df824d63cb52e1b9837e0f745b85e86f92bbc025a68a7239f5ab520fc55",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2009"
      ]
    },
    {
      "uid": "zhcn:c79fba4dc3bd9c34efe2285c",
      "kind": "text_data",
      "source_text": "ROUND1结束，强者云集的ROUND2。",
      "source_fingerprint": "f69930f16a0df648713d2fba17772fb274a4f4f13b5263b45a9e3f6df7a4e1b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2010"
      ]
    },
    {
      "uid": "zhcn:f4ea8e8f3f44a3cb50de6751",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛 <race_name></color> ROUND2开始。",
      "source_fingerprint": "7634a445a9d42a7ccd55f13b99185e57f995766f655c35f2fea9d6c6cc071e8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2100"
      ]
    },
    {
      "uid": "zhcn:ead0380320ff22c1cb6ccf17",
      "kind": "text_data",
      "source_text": "绝不能错过<color=#ff9900>群英月赛</color>。",
      "source_fingerprint": "67743667cd61e674d147f572524b630b9d53243b3d3df2e37939c48ee0640402",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2101"
      ]
    },
    {
      "uid": "zhcn:1c84136ceb068f03f568ccbd",
      "kind": "text_data",
      "source_text": "肯定胜负难料的<color=#ff9900>群英月赛</color>。",
      "source_fingerprint": "8695feac1c0962fa6a028e97469ad9b093e0a049dfaad8c1069974d2b2790917",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2102"
      ]
    },
    {
      "uid": "zhcn:f3eb60228118721556bc8c0e",
      "kind": "text_data",
      "source_text": "竞争激烈的<color=#ff9900>群英月赛 <race_name></color> ROUND2开始。",
      "source_fingerprint": "0e0e10f52353acdc90719f0d567e55b0d5d7722a06c92bc7dc6562a595a740da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2103"
      ]
    },
    {
      "uid": "zhcn:ac1a5edaedf148dd758dede1",
      "kind": "text_data",
      "source_text": "绝对不会停下来，<color=#ff9900>群英月赛\\n<race_name></color> ROUND2。",
      "source_fingerprint": "fd23cddf9fafb5d20ca190eb9b090de085340cbffed7bbb0ecd655a33ae8a468",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2104"
      ]
    },
    {
      "uid": "zhcn:82429674ad1649b42df16a58",
      "kind": "text_data",
      "source_text": "赛马娘齐聚，<color=#ff9900>群英月赛</color> ROUND2。",
      "source_fingerprint": "b9a4cedf71a5eee1414d73b966189c29afb38ec486f1d016fa5e5c14cbe94aef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2105"
      ]
    },
    {
      "uid": "zhcn:02a3590f2f9ac673387ca21d",
      "kind": "text_data",
      "source_text": "ROUND1结束，强者云集的ROUND2。",
      "source_fingerprint": "f69930f16a0df648713d2fba17772fb274a4f4f13b5263b45a9e3f6df7a4e1b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2106"
      ]
    },
    {
      "uid": "zhcn:89eae13edc7574162dff1ef8",
      "kind": "text_data",
      "source_text": "王牌云集，仅有三女神才知道结果，备受瞩目的一战。",
      "source_fingerprint": "f3bc2c65b99115d664c9d45ceadce3e95a2f46f5fde017c72ed459b51110ff35",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2200"
      ]
    },
    {
      "uid": "zhcn:2c970e3f01520b233b0b0522",
      "kind": "text_data",
      "source_text": "从全国各地聚集而来的精锐，在热烈的欢呼声中展现魅力。",
      "source_fingerprint": "abce797f7f15c3dda54d071839b7ba8bd01eb0fd11a00c718dc919c7b2a96631",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2201"
      ]
    },
    {
      "uid": "zhcn:04c72153f2c4ddd427dd44e2",
      "kind": "text_data",
      "source_text": "所有人的实力都是货真价实，谁赢都不奇怪。",
      "source_fingerprint": "389ed646929795cb3d67f43bc5f117ac5fe0d23b26e5708771a398357d8b7a92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2202"
      ]
    },
    {
      "uid": "zhcn:5f9d800474656c83522447b4",
      "kind": "text_data",
      "source_text": "展翅飞向未来，备受期待的赛马娘们。",
      "source_fingerprint": "28d799f73efa39e2bb85dfc80197c77ae2f42eee67bcbff9a113c3afdea59752",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2203"
      ]
    },
    {
      "uid": "zhcn:8a34ff5328400be91af37efb",
      "kind": "text_data",
      "source_text": "参赛的赛马娘都颇具实力。",
      "source_fingerprint": "494c891eb639886ec8887be192835407158e1972d24ba822b1981b2b7d046bbe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2204"
      ]
    },
    {
      "uid": "zhcn:08d0c6b77361c22c50ebf904",
      "kind": "text_data",
      "source_text": "演员齐聚一堂，受众人瞩目的一战。",
      "source_fingerprint": "6dae00a974a9464e1650949aa577e687eb0084a76065855f8fa23ad0398122ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2205"
      ]
    },
    {
      "uid": "zhcn:bf85a383a1fb3732f3d76192",
      "kind": "text_data",
      "source_text": "各赛马娘的实力在伯仲之间，能期待是场高水平的竞赛。",
      "source_fingerprint": "af95488caa6b3af0186e27d9d878e280eb77b83e4d1fc77c8b579c4c5163779d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2206"
      ]
    },
    {
      "uid": "zhcn:6cda64d2d4d85f176c5164d9",
      "kind": "text_data",
      "source_text": "聚集了难得的优秀成员，是粉丝必看的竞赛。",
      "source_fingerprint": "6b0b77bb1d166abbc1b1f60d7cd196ef68015b29669ad30ef6aac6706813eaed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2207"
      ]
    },
    {
      "uid": "zhcn:0b8251900b53d09c1d337373",
      "kind": "text_data",
      "source_text": "参加的都是强者，备受瞩目的一战。",
      "source_fingerprint": "c45cc2ffa58b92cd9a91422afa9b9d0180b7cc258c4d9b308d8776329a1e2154",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2208"
      ]
    },
    {
      "uid": "zhcn:2e89662d9cc37848c150f616",
      "kind": "text_data",
      "source_text": "粉丝也抱持高度期待的盛大竞赛。",
      "source_fingerprint": "4de9b92ceaccc59711e6082b3ec3e85dd2a8ce9f8409ba7cfb825543e3552c9a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2209"
      ]
    },
    {
      "uid": "zhcn:fec2365f52d949ac1e002bab",
      "kind": "text_data",
      "source_text": "会是目标为进入决赛的三方齐聚一堂的重要一役。",
      "source_fingerprint": "9a1930322d7091b4839fee7d3aa3158b4c504d84fa64a34d08777a29cb010b12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2210"
      ]
    },
    {
      "uid": "zhcn:f50f65ff0ef566b4a6179300",
      "kind": "text_data",
      "source_text": "实力相当，在抵达终点前都不能移开视线的精彩竞赛。",
      "source_fingerprint": "9f3ec4972d2e19e80d30bd3fbcdba7ae18bce324a724b2ce2277ed9b43b24fef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2300"
      ]
    },
    {
      "uid": "zhcn:acba11b622f0277e02404389",
      "kind": "text_data",
      "source_text": "<season>晴朗的<race_course>赛场，备受瞩目的赛马娘齐聚一堂。",
      "source_fingerprint": "060aa7ad8dd70abd44a3734b8f5b1599f556d052887e42687380f50ef5d1dd30",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2301"
      ]
    },
    {
      "uid": "zhcn:6e72256f9586ff17535e1139",
      "kind": "text_data",
      "source_text": "不是赢，就是输！胜利者只有一名！",
      "source_fingerprint": "3a014d1c0e8fa3108d64d2699e1bf709b1635bd04edb029a3b12881e4f7351bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2302"
      ]
    },
    {
      "uid": "zhcn:2a7f6a3fd584767de41d4595",
      "kind": "text_data",
      "source_text": "任何赛马娘都会在此鼓起冲劲的重要场合。",
      "source_fingerprint": "e64e68791ea0aedd3482e8326a4250f45e262d6215ec7c3e1ac9b1c9aeba3dac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2303"
      ]
    },
    {
      "uid": "zhcn:b35173d883d393206a7f1f89",
      "kind": "text_data",
      "source_text": "大家抱着对胜利的强烈决心挑战对手们。",
      "source_fingerprint": "91752906d51a6d566a72002b2b99c9e655de53754eb836e39c9283d45b645bf9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2304"
      ]
    },
    {
      "uid": "zhcn:99c7672ec3b3fda8cc287039",
      "kind": "text_data",
      "source_text": "一场不论谁获胜都不奇怪的激烈竞赛就此开始。",
      "source_fingerprint": "c29b0f7625731520ed41b67b6528c23c96594904c2d46c434d393cf740533748",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2305"
      ]
    },
    {
      "uid": "zhcn:bbfdbb3fa494ef73a2168891",
      "kind": "text_data",
      "source_text": "受到瞩目的赛马娘们一边竞争，一边奔驰在<race_distance>。",
      "source_fingerprint": "e74794e61ea3457739e8af9e7ec4c6eef761c4b4832131b3c074dd792c9c5a3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2306"
      ]
    },
    {
      "uid": "zhcn:4bcb6f35644fd58ebe7d4af1",
      "kind": "text_data",
      "source_text": "比任何地方都长，也比任何地方都短的<race_course>的<race_distance>。",
      "source_fingerprint": "22116d467121ec75700bc711bd442b1943a3931cb7d3de4342da94a2e4248d8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2307"
      ]
    },
    {
      "uid": "zhcn:da5e19346013029f2e2b1561",
      "kind": "text_data",
      "source_text": "会是目标为进入决赛的三方齐聚一堂的重要一役。",
      "source_fingerprint": "9a1930322d7091b4839fee7d3aa3158b4c504d84fa64a34d08777a29cb010b12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2308"
      ]
    },
    {
      "uid": "zhcn:7e3bf0665cc2221503c53116",
      "kind": "text_data",
      "source_text": "谁能成为最后的优胜者……！",
      "source_fingerprint": "9b53750a723e4f62eba0cd50ff63072ed286b5e243be1d7df27ede38a1626ecc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2400"
      ]
    },
    {
      "uid": "zhcn:5b52ab0131b256ec773954d3",
      "kind": "text_data",
      "source_text": "究竟会是哪位赛马娘能以第1的成绩抵达终点……！",
      "source_fingerprint": "e9f4252372774d4c771bd649939cafd08d81797da6ce60ecdb0264fc0bf5a562",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2401"
      ]
    },
    {
      "uid": "zhcn:a7721b83d7c992a5f307eabf",
      "kind": "text_data",
      "source_text": "谁能够第1个跑完<race_distance>呢！",
      "source_fingerprint": "7c8eb3e7907ae1647485b4a9d6e316c7c338d06c1c7c0c94efcca1158a96e451",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2402"
      ]
    },
    {
      "uid": "zhcn:0ecf665890e295bb689bd116",
      "kind": "text_data",
      "source_text": "最快的会是谁……！",
      "source_fingerprint": "cbda784640152285c8d2c32943fac5e0c75a7e79d754c80aa5618e3e1cea8410",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2403"
      ]
    },
    {
      "uid": "zhcn:c7e397155edd67950ca6e332",
      "kind": "text_data",
      "source_text": "专注看着前方迈进！",
      "source_fingerprint": "c06bdca4fae7bc1bb23665083e7310967acb8b3d4247b161598ca2630790063f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2404"
      ]
    },
    {
      "uid": "zhcn:ba0066165e022ef335b56f90",
      "kind": "text_data",
      "source_text": "在抵达终点前无法移开视线！",
      "source_fingerprint": "26e1a96a39a20d7a74f96fc75a45a636e820fc3c14885e0c231ee48047c85950",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2405"
      ]
    },
    {
      "uid": "zhcn:1fd83a29f06372757b0ddec0",
      "kind": "text_data",
      "source_text": "朝<race_distance>前方的终点奔驰！",
      "source_fingerprint": "cfebe28115957508d07924c2fb8678d1e77cb909e8eba4a084a369432a421912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2406"
      ]
    },
    {
      "uid": "zhcn:a48b93918a942dfb0ac770d1",
      "kind": "text_data",
      "source_text": "最精彩的竞赛，现在开始……！",
      "source_fingerprint": "12ffc17c61f6ca72702fa99c1e5c39702f058e69492db25946f02483832c5e40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2407"
      ]
    },
    {
      "uid": "zhcn:e4cbf3fb3b694ad3a04ca1ec",
      "kind": "text_data",
      "source_text": "你支持哪一位赛马娘？",
      "source_fingerprint": "17a15c46d4fffae3d1122a4acd60467263d47ae018d15f36392ce7abe1728afe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2408"
      ]
    },
    {
      "uid": "zhcn:d86932504519b90324723d64",
      "kind": "text_data",
      "source_text": "能超越9人成为第1的会是谁！",
      "source_fingerprint": "3fdf2679c3f1e636e76b66ddc81e8e36b75f0f1f6689ee186bd5209ee280402d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2500"
      ]
    },
    {
      "uid": "zhcn:30abadfa166104f00816402e",
      "kind": "text_data",
      "source_text": "获胜的会是哪位赛马娘呢……！",
      "source_fingerprint": "41e9ed0044fe99ae5787383a926d39b23a84e045839723bf39696933cdd0fc44",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2501"
      ]
    },
    {
      "uid": "zhcn:137a54bdad62f341878c8ccc",
      "kind": "text_data",
      "source_text": "去抓住未来吧！",
      "source_fingerprint": "46f8f579c965a4ae688c653c64907f9ca21e52904da88e75fd3ea0f5f7056953",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2502"
      ]
    },
    {
      "uid": "zhcn:88133959bb411774a90e6b39",
      "kind": "text_data",
      "source_text": "难以预料的伏兵也值得关注。",
      "source_fingerprint": "69f590abbb84b5bbb076d2cf79ec676f9caf0ca189a37594af471eb4499f6168",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2503"
      ]
    },
    {
      "uid": "zhcn:3741c73d113d8ffb3d6708ad",
      "kind": "text_data",
      "source_text": "最终取得第1的会是……！",
      "source_fingerprint": "fe27e1663d0ddfc71ee7ed28daa5fd8e01bc7c0bb3183dec9626b24c90ecba28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2504"
      ]
    },
