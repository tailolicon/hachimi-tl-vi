      "source_fingerprint": "db8b10bab3b7e9b5332fae5baa14f8f9aa96a9e96812b8312beb7739ab7f3870",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "367"
      ]
    },
    {
      "uid": "zhcn:eac4d0e45b2622d3b224f768",
      "kind": "text_data",
      "source_text": "偶发Emotional",
      "source_fingerprint": "432651c7c27bc9979fbc510b516b8b8e6f685b728d1b9679306b70f6611f8a21",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "368"
      ]
    },
    {
      "uid": "zhcn:bba0995dfc462f8ccaf8a2a8",
      "kind": "text_data",
      "source_text": "Plan is no plan",
      "source_fingerprint": "7145433f6eeb9acbc32b17e5bf3babb698fedbf93ec4a84ff873b56c18fc6cc9",
      "source_path": "text_data_dict.json",
