      "source_text": "响彻于宫灯百合的钟声",
      "source_fingerprint": "f85866a54eaf32684e2e9dcbad5afc0daa5edcbbae3fbbec541706939f94460d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "413"
      ]
    },
