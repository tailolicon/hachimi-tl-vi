        "37"
      ]
    },
    {
      "uid": "zhcn:a106bd61ac374946f614f8f0",
      "kind": "text_data",
      "source_text": "这样就好吗？",
      "source_fingerprint": "9a7fa4e61addaf169a8f591a72b105cfe5da461f07d1f7426c067a3688e15f49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "370"
      ]
    },
    {
      "uid": "zhcn:18f6c84cbd49e4735c5d214d",
      "kind": "text_data",
      "source_text": "向你献上惊喜",
      "source_fingerprint": "2c5e1bcbe638bf20346faa8ae29d1d618959e2339dbf1095832411abeb384a4f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "371"
      ]
    },
    {
      "uid": "zhcn:e0992d67fc8356e8c906af73",
      "kind": "text_data",
      "source_text": "大团圆的秘诀",
      "source_fingerprint": "7d4afa2590b393027c607a08cbc8fa892f6f47e8b0a3999019a6aad40e900511",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "372"
      ]
    },
    {
      "uid": "zhcn:c428af2bfcb163ba489d2788",
      "kind": "text_data",
      "source_text": "intro：两个奇迹",
      "source_fingerprint": "d5e5034742d6370b3939c57203494c6068388def9de01e2a55933111891727a6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "373"
      ]
    },
    {
      "uid": "zhcn:b4d5860a24ba057c958d5a51",
      "kind": "text_data",
      "source_text": "poco a poco：合上声音？",
      "source_fingerprint": "8b51093c7c754e3c1412c4b405ed2ed6f927680706b03218f4ab3ca9e1de2547",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "374"
      ]
    },
    {
      "uid": "zhcn:abf8d97a58cfe61512420390",
      "kind": "text_data",
      "source_text": "festivo：拜托再延长一会儿～！",
      "source_fingerprint": "df1ec298a883b9b2cd08b8be6788eb4aec614e0618951d8e4313a44438b7fe04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "375"
      ]
    },
    {
      "uid": "zhcn:12e38334c892aa6a8fc2eb31",
      "kind": "text_data",
      "source_text": "tutti：合上声音！",
      "source_fingerprint": "fd57c9c429dad90fd987ea6bd3b818f80f9c166458efba405bdd2bbf4f027e94",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "376"
      ]
    },
    {
      "uid": "zhcn:a6be7b9bb820fbc9ccb750db",
      "kind": "text_data",
      "source_text": "impetuoso：多亏了大家",
      "source_fingerprint": "efce385909a73ba73acbef674279584d321392f0fab536a014812c1097d6572e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "377"
      ]
    },
    {
      "uid": "zhcn:71489608bdd798c8c5815382",
      "kind": "text_data",
      "source_text": "fermata：只因为是你啊",
      "source_fingerprint": "cefcfeedabc9c2f807573c31688f05ec415fcbb870003aae385dd892d1b7426a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "378"
      ]
    },
    {
      "uid": "zhcn:9465273dc418f7af11880fb3",
      "kind": "text_data",
      "source_text": "prestississimo：只要变得更快",
      "source_fingerprint": "26f43dbc993f993f757bf063b3995b81a6b37b9ec05a168a76e710633ac4ae2d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "379"
      ]
    },
    {
      "uid": "zhcn:da1ab8628e2c1b9cc5a9770f",
      "kind": "text_data",
      "source_text": "不懂父母心",
      "source_fingerprint": "c74cc33214ff78ad1e017688e618ea6d0501e76d8b52e997cca07218bde38cbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "38"
      ]
    },
    {
      "uid": "zhcn:ad44ce77ffdb6d31fe4c55a5",
      "kind": "text_data",
      "source_text": "finale：然后，重叠起来",
      "source_fingerprint": "15b39f29583eb19183c0b532f93dc20f3079e1d5e5eb849eb2a0baad4643d95c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "380"
      ]
    },
    {
      "uid": "zhcn:cb5b4ad99416c4050931acea",
      "kind": "text_data",
      "source_text": "响起吧，圣诞铃声",
      "source_fingerprint": "4574a28395aaf9d151570210c133ac441f56a63607d4178b1bc716bfe7c3967c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "389"
      ]
    },
    {
      "uid": "zhcn:b8ed8afea7c704e5ef3cd371",
      "kind": "text_data",
      "source_text": "五名赛马娘的夏日物语",
      "source_fingerprint": "fb9785c56a57936e3dc583fbc2a636992fd7648d80b57f0f8580dd55be3ff4e1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "39"
      ]
    },
    {
      "uid": "zhcn:309234705c1ae22c1b932419",
      "kind": "text_data",
      "source_text": "奔跑吧！圣诞警察",
      "source_fingerprint": "07feeaafec5a3a53cb8e3c559a1391026c25ca3f216ae14754a03e272c72f07d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "390"
      ]
    },
    {
      "uid": "zhcn:defcdd61b2c1efded653bbdb",
      "kind": "text_data",
      "source_text": "爆牌・还是・越界",
      "source_fingerprint": "5f8ba7c973f9395eace03b59c8a3cd30d830956d215ee92220c3f1613d5590ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "391"
      ]
    },
    {
      "uid": "zhcn:256c14bbeb759b1a7ea295ea",
      "kind": "text_data",
      "source_text": "超越预测与期待！",
      "source_fingerprint": "9b865888ee7b86d201f2962dd6bf11ea66406cb1c41ec86c08b148b3cca2248a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "392"
      ]
    },
    {
      "uid": "zhcn:98a91f900d1b0fce32f4564f",
      "kind": "text_data",
      "source_text": "孤注一掷、胜负难料、喧嚣不断",
      "source_fingerprint": "2b805c36200e61fb8533f0e25336650a5a31ced1699f3021aacbd3baa56118c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "393"
      ]
    },
    {
      "uid": "zhcn:7172840e521099cf2d9f3f26",
      "kind": "text_data",
      "source_text": "舞动吧欢悦的玩家",
      "source_fingerprint": "696e49a90b4adcf1e7522ee12fad28e6f600ec4db3575a9ee4a3aace5363e1ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "394"
      ]
    },
    {
      "uid": "zhcn:0855d692c35d2c6a6c8bd5a9",
      "kind": "text_data",
      "source_text": "喧闹吧派对时间",
      "source_fingerprint": "891c64c41fd8cfef506cac50d48b64631680c2076fc48aecc57dafb7cd770229",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "395"
      ]
    },
    {
      "uid": "zhcn:fbfc98f0a3b09fa8840f2d68",
      "kind": "text_data",
      "source_text": "超越极限的的圣诞之夜",
      "source_fingerprint": "e88d38507e06aa181cd912c3248815760819e3e2f1a71ac48a9f5fc1bc6f6b05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "396"
      ]
    },
    {
      "uid": "zhcn:444e6e0bbbc3004c4b214ffc",
      "kind": "text_data",
      "source_text": "太早开始的一日",
      "source_fingerprint": "2194446382b8afd261d9579e789168fc92b36fc0ba8ca9353677ced47c5e2908",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "4"
      ]
    },
    {
      "uid": "zhcn:7ddd04df1501f36a75fc43da",
      "kind": "text_data",
      "source_text": "渴望奔跑！",
      "source_fingerprint": "3a5a997206b4520c5c5c8a520b7cde3f8d6762e610d1722637510e6c5d7362a2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "40"
      ]
    },
    {
      "uid": "zhcn:2d1c53219bfb832e8d1cfbbf",
      "kind": "text_data",
      "source_text": "做好觉悟了吗？情人节来袭Desu！",
