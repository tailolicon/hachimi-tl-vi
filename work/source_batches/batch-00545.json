      "source_text": "期待她们各自带着自信的表现吧。",
      "source_fingerprint": "886da9b4cef997afeb65bddbae5aa4b36ec0e77bc379ef57cea234330138b68f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "2505"
      ]
    },
