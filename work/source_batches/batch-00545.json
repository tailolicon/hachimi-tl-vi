      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "363"
      ]
    },
    {
      "uid": "zhcn:2310d20bfa22c153e2526fbd",
      "kind": "text_data",
      "source_text": "对比赛的爱，是永恒的",
      "source_fingerprint": "dabdd1d0e85ac60e81539bb523a53d3203ff797dda4710b4bd616117816daf63",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "364"
      ]
    },
    {
      "uid": "zhcn:ae53b3eee016b228dc7a4f5a",
      "kind": "text_data",
      "source_text": "欢迎光临！里见度假村",
