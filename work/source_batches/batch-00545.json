      "kind": "text_data",
      "source_text": "帝王花一路爆进",
      "source_fingerprint": "744f9f9e133e4c9768de288c7c1e0c23bede6c6acc18f46c2cb20bce6c8c60d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "414"
      ]
    },
