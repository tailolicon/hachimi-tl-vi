      ]
    },
    {
      "uid": "zhcn:5b15a9cc011c8c8d294f85ef",
      "kind": "text_data",
      "source_text": "深秋之中",
      "source_fingerprint": "a3eddcbfe06d1ac090c77ba5b382c39c5e607e293358ca4d00bd5fc5da819afb",
      "source_path": "text_data_dict.json",
