        "82"
      ]
    },
    {
      "uid": "zhcn:50e6a2260eaca476165118c1",
      "kind": "text_data",
      "source_text": "只要斗志不灭",
      "source_fingerprint": "5a864375ce532eca639bf381851d3921f96daa525c26519dae065997a6044e87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "83"
      ]
    },
