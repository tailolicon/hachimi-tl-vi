        "78"
      ]
    },
    {
      "uid": "zhcn:55ca659d75586534de2c9e74",
      "kind": "text_data",
      "source_text": "目标只有巅峰",
      "source_fingerprint": "22580849bd52bad691f5824681f948ba41fe19def905a2ac29cd5da5cc5ad140",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "79"
      ]
    },
    {
      "uid": "zhcn:674d5da84e88c1c099eb36c4",
      "kind": "text_data",
      "source_text": "一定会由此开始，绝对会在这里",
      "source_fingerprint": "2c38f7324094df8813c8b9d5185b5ca16c3156aaaeea5e1c0b31ba056a60e716",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "8"
      ]
    },
    {
