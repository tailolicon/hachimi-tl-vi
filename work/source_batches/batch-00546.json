      ]
    },
    {
      "uid": "zhcn:ea5a668c829a841c55f7a9b2",
      "kind": "text_data",
      "source_text": "秋菊之脍围聚一堂",
      "source_fingerprint": "e281adcbbc1a00abdec045020934e013e5c89d93f35da6bc69415b3f41db354b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "50"
      ]
    },
    {
      "uid": "zhcn:166d214a24a40166134d71ba",
      "kind": "text_data",
      "source_text": "红叶宴会热闹非常",
      "source_fingerprint": "b3695230952d83a24f88854aa3c5be307a4a7b11cb34cf6811dca0d6938710f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "51"
      ]
    },
    {
      "uid": "zhcn:c3f24b376dbb6c7c12089854",
      "kind": "text_data",
      "source_text": "隔月依旧美丽",
      "source_fingerprint": "8df8f3ee2cc049425c03e7e45da7194daa02dd7b8334166a72f22c76be18265b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "52"
      ]
    },
    {
      "uid": "zhcn:b2e09ffd4a07594823e48275",
      "kind": "text_data",
      "source_text": "你宛如珊瑚树",
      "source_fingerprint": "8fae74d300452395deab7e9a4ccedee81798edcfe3b9123864974fdb52443b72",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "53"
      ]
    },
    {
      "uid": "zhcn:202147f04b7e84f17117d82e",
      "kind": "text_data",
      "source_text": "度过寒秋之夜",
      "source_fingerprint": "559ec28b8928d7a86773a93abfd7852f588179418d3920d1338073addfa83c89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "54"
      ]
    },
    {
      "uid": "zhcn:5407df7a420faebdb70a7b1d",
      "kind": "text_data",
      "source_text": "晚秋之中点亮灯火",
      "source_fingerprint": "438e03a67800de72d67a9221498abdea61ff30b9f7c4dc2074901f66c4cbbf62",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "55"
      ]
    },
    {
      "uid": "zhcn:c0a1b584882697179c608c1b",
      "kind": "text_data",
      "source_text": "晚秋热闹的「骏大祭」",
      "source_fingerprint": "fa23907cda7029932bec35b1489a06ed33a2697a9f49a86b959f5cda1f63aff0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "56"
      ]
    },
    {
      "uid": "zhcn:38a1ca0bed0352343d89b235",
      "kind": "text_data",
      "source_text": "圣诞节来临！",
      "source_fingerprint": "96e312e93f953a4514b657ac4a819b53e18fcb7a6d72ad96c708f368b6786556",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "57"
      ]
    },
    {
      "uid": "zhcn:97869fe492cad65e98cd1f6f",
      "kind": "text_data",
      "source_text": "「愉快高兴的」礼物",
      "source_fingerprint": "2967d0a48620fdae722f731d0f0ffadf2a80017e6648b21cdbb052fe74bd88fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "58"
      ]
    },
    {
      "uid": "zhcn:2a822fd95c16b565883af596",
      "kind": "text_data",
      "source_text": "美丽的建议？",
      "source_fingerprint": "73c7af6fd6ba39f6e947fd341c3e689fbb1dd786ef163d42cf0ab29ac41efee9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "59"
      ]
    },
    {
      "uid": "zhcn:5882ce4812745ff22ca63b6d",
      "kind": "text_data",
      "source_text": "睡不着的夜晚，然后",
      "source_fingerprint": "f20ef86e2c8a296a50d3590ab9810ce075aa2963f236100ed21d4fe05b5edcd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "6"
      ]
    },
    {
      "uid": "zhcn:769e0795dfba6549404cbdae",
      "kind": "text_data",
      "source_text": "看不到「星星」的夜晚",
      "source_fingerprint": "1f1a41daa1976769cf5206082d55f473e4dd067065bf5a703776b473145b0ec6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "60"
      ]
    },
    {
      "uid": "zhcn:ae81fa8cdd31be9aacf45415",
      "kind": "text_data",
      "source_text": "迎接我们的圣诞节",
      "source_fingerprint": "3b684f38401fdbb239e40450f6ce3ca95d9200bfb79bb6167ef8d641048a10c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "61"
      ]
    },
    {
      "uid": "zhcn:046535407e9751ee6c65fd5f",
      "kind": "text_data",
      "source_text": "各自起飞",
      "source_fingerprint": "c78e3e756521a2ec7fa6529eb5ee30b8ab8b196c50a230da95d7b256aea28a32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "62"
      ]
    },
    {
      "uid": "zhcn:a3f853d24898fc2d0b723345",
      "kind": "text_data",
      "source_text": "圣诞节到了！",
      "source_fingerprint": "6fe4d29e33a5dafff2fdc3e18f2f3aadd4340f20cbb9a27eddf02e720b44c77b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "63"
      ]
    },
    {
      "uid": "zhcn:8df76f0ef1858bed22127385",
      "kind": "text_data",
      "source_text": "「圣夜奇迹」无远弗届",
      "source_fingerprint": "13d0577912be7a0bbeef187f3c311511c3d4c128a979ac55b1fdb5c466376f5d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "64"
      ]
    },
    {
      "uid": "zhcn:5363b4e2fb2368f1aaa3edb4",
      "kind": "text_data",
      "source_text": "保佑我吧保佑你吧！开运祈祷",
      "source_fingerprint": "95f278c9a02c90f8042fb9b38f04ebef7324537605863595a9eeec4cb2ac1d2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "65"
      ]
    },
    {
      "uid": "zhcn:05b7c58656a57a702e33a8b6",
      "kind": "text_data",
      "source_text": "疑惑？歌牌真的好难……！",
      "source_fingerprint": "0fffbcaf4fe0299065764b168cdeec14939934711c2c02d85c70f34762a10a7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "66"
      ]
    },
    {
      "uid": "zhcn:72199a12700d72daa80cca3c",
      "kind": "text_data",
      "source_text": "即使分开的将来……",
      "source_fingerprint": "c97e2a2211df878cd27eaf4e15f5aca1b967d30dccc42255ba206abc55ae94e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "67"
      ]
    },
    {
      "uid": "zhcn:83fbf448a35b0c078f0f5be1",
      "kind": "text_data",
      "source_text": "直到触及那颗星……",
      "source_fingerprint": "4b78dc2be22c6634bedb51c85ec3efc82ac3793295122e364b353d23a76baa0a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "68"
      ]
    },
    {
      "uid": "zhcn:b983e4a28c383632323d1f1c",
      "kind": "text_data",
      "source_text": "激励！名将怒涛！？",
      "source_fingerprint": "7f08f0022b152de4d5cb8b8bb84b74fe564aaa5fa708bc2bef91511e8e5339af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "69"
      ]
    },
    {
      "uid": "zhcn:b3bb86082e9bb71298e28c7f",
      "kind": "text_data",
      "source_text": "「一骑绝尘无与齐驱」",
      "source_fingerprint": "a75f6944aca848b20435344e9c976243cbe747b0e2334a85cf4d70b9fc322595",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "7"
      ]
    },
    {
      "uid": "zhcn:df965a089aa56f13e4efff85",
      "kind": "text_data",
      "source_text": "准备上阵！",
      "source_fingerprint": "f2e4e02a47ef7cf26a0f1b57303da651b6082a70681bf17c62c2d9a38b67decc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "70"
      ]
    },
    {
      "uid": "zhcn:4da7360f14674243c93e7e6c",
      "kind": "text_data",
      "source_text": "队伍＜新春大大吉来＞！",
      "source_fingerprint": "c262bdb4aab5ea02c7d31ab5ba33accde8109460a6b43d0b79b41c2c8f2acfec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "71"
      ]
    },
    {
      "uid": "zhcn:58d290295af1d93c63c7ac56",
      "kind": "text_data",
      "source_text": "天晴大家招来福气！",
      "source_fingerprint": "43b60dcd3ecad3907bbacf511c73af013aa209f6ac36aae4d195ebc9570cbe06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "72"
      ]
    },
    {
      "uid": "zhcn:0840b424f1c5e6a343cdfffe",
      "kind": "text_data",
      "source_text": "挑战！巧克力对决",
      "source_fingerprint": "9a3665201e0b59b875f10646ec4cc264c6bdcb43c9ba2fa7e79f539da57577bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "73"
      ]
    },
    {
      "uid": "zhcn:cb14645af86fd238f3d15146",
      "kind": "text_data",
      "source_text": "尝试＆错误",
      "source_fingerprint": "6e16be866ecddc26d2b3805563d36bd12861baa030f819d7267c2be1a6c5b946",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "74"
      ]
    },
    {
      "uid": "zhcn:70aa3ae1853df6f46a1749dc",
