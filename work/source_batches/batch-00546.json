      "source_fingerprint": "0793de747bb829a8a92c44062f7cfa938114a700fab2a3d852418d747b957e91",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "75"
      ]
    },
    {
      "uid": "zhcn:72e0747887e228bb612329d5",
      "kind": "text_data",
      "source_text": "精髓",
      "source_fingerprint": "57460b4cb74bdf28a0519ab5fe1cd2a97f49e9a3569a5310289f315de905eaf4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "76"
      ]
    },
    {
      "uid": "zhcn:f97119701e2f41113bbc1db3",
      "kind": "text_data",
      "source_text": "我们的学校",
      "source_fingerprint": "3867e85779b8421f06413ecf09979c94405d36525b7cc917e51188105b119642",
      "source_path": "text_data_dict.json",
      "json_path": [
        "191",
        "77"
      ]
    },
    {
      "uid": "zhcn:ff144bab6ca913108a9b70b6",
      "kind": "text_data",
      "source_text": "指尖之花",
      "source_fingerprint": "3a4b9ea9b1fbe89dab1e5df524b2028ed058bfb7903cc7c9aae543dac1f18bc2",
      "source_path": "text_data_dict.json",
      "json_path": [
