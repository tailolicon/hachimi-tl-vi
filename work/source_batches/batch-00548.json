      ]
    },
    {
      "uid": "zhcn:052db4da898f1f7cc3a1e6c9",
      "kind": "text_data",
      "source_text": "明治コラボキャンペーン実施中！\\nオリジナル商品や限定クリアファイルの\\n詳細は特設サイトをチェック！",
      "source_fingerprint": "bab7cacaaf54159d7d5ccd8e01167c1d3a54db06fd2efdfc165d7e571bc5a18c",
