    },
    {
      "uid": "zhcn:efe4e2d8138811c4df90af3a",
      "kind": "text_data",
      "source_text": "『スタブロ』2巻＆『シングレ』14巻\\n最新コミックス絶賛発売中！\\n詳細はウェブサイトをチェック！",
      "source_fingerprint": "132854df521784e1886c6e84d52e0539193379d7a01c2bce5c0c3ca66f35e498",
