        "1041"
      ]
    },
    {
      "uid": "zhcn:0ef3024f8a1a025ade2f5d36",
      "kind": "text_data",
      "source_text": "5th EVENTの詳細は特設サイトへ！\\n第1公演は7月15日・16日に、\\n第2公演は9月16日・17日に開催！",
      "source_fingerprint": "4de2b426b58bd5a03e44d3b6bb2ef08c5ffcccbc860a0a13b206bb14dcd4f7d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "196",
        "1042"
      ]
    },
    {
