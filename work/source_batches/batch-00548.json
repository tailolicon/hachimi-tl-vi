        "1068"
      ]
    },
    {
      "uid": "zhcn:c558032ff229cd281821e113",
      "kind": "text_data",
      "source_text": "ジャングルポケットとダンツフレームが目印\\nダービーをテーマに「ウマ娘」を大特集！\\n「Number」1096号好評発売中！",
      "source_fingerprint": "8429bb42f332ff9ab307ef0332f698f4cdb28525f91fa4ca8b3e11b5b390f2c2",
      "source_path": "text_data_dict.json",
      "json_path": [
