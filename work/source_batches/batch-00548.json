    },
    {
      "uid": "zhcn:3038304cd667f6e9cb0a1c13",
      "kind": "text_data",
      "source_text": "TVアニメ第3期『ウマ箱３』\\n第２コーナー 2/21発売！\\nここでしか見られない特典が満載です！",
      "source_fingerprint": "cd9e83f6ba4172650629073cbd823762251149b83122c931b268ba8e4b0a3b61",
