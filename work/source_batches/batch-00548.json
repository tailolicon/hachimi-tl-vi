    {
      "uid": "zhcn:9b387593423aa09ca1b3adda",
      "kind": "text_data",
      "source_text": "5th EVENTの詳細は特設サイトへ！\\n第3公演は2月17日・18日まで配信中！\\n第4公演は3月22日・23日に開催！",
      "source_fingerprint": "9aeb454eac7ee202d6390dddd8d11512ba6d48175e9d004741602b52248ecb07",
