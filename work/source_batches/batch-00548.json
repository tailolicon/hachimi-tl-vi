        "196",
        "1045"
      ]
    },
    {
      "uid": "zhcn:5319bf004fe56377220a8517",
      "kind": "text_data",
      "source_text": "ファミマ×ウマ娘 プリティーダービー\\n 「2.5周年記念サマーキャンペーン」開催！",
      "source_fingerprint": "af36aa351f4686b98cae18cd0f5e040f02c86ef9cc8a5ccb07326edc1384bd1b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "196",
        "1046"
      ]
    },
    {
      "uid": "zhcn:83980ed0737ee80479e34501",
      "kind": "text_data",
      "source_text": "『諦めない、その手が届くまでーー』\\nTVアニメシリーズの第3期が\\n2023年10月より放送開始！",
