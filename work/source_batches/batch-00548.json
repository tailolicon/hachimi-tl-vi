        "1067"
      ]
    },
    {
      "uid": "zhcn:c9bfc883f49365c8101fb845",
      "kind": "text_data",
      "source_text": "今年のゴールデンウィークは\\nGOCHI WEEKを開催！\\n詳しくは特設ページをチェック！",
      "source_fingerprint": "40613a5e95ace96317382ef7999b54ba72a2abf3ee41c71f28ca11b40904709b",
