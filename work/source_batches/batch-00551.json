    {
      "uid": "zhcn:ac2dfce81f4a2a92e72fea1c",
      "kind": "text_data",
      "source_text": "机械EN的初次获得量提升（最大+2）\\n容易配置更多机械齿轮",
      "source_fingerprint": "c3645fab6941bd203577bea9f134c95ee7caced1dcf3bd36a41c8806cc9699b1",
