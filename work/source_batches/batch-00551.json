      ]
    },
    {
      "uid": "zhcn:ba9983ac858b5d7cdd26c3e0",
      "kind": "text_data",
      "source_text": "机械EN的初次获得量提升（最大+2）\\n根据研究Lv，训练效果上升量提升",
      "source_fingerprint": "2f99798507dd0c067070db9e231955332b657bfe33b65341f1057ea441582673",
      "source_path": "text_data_dict.json",
      "json_path": [
        "200",
        "69"
      ]
    },
    {
      "uid": "zhcn:374df5912e9c8a630434eb74",
      "kind": "text_data",
      "source_text": "超速驱动槽的初始值提升\\n研究Lv的初始值提升",
      "source_fingerprint": "700d13b3c48f4c05be725af601fb2c7034bfe4453410b2c15ea4a904ea0eed47",
      "source_path": "text_data_dict.json",
