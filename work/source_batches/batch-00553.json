      ]
    },
    {
      "uid": "zhcn:963e77febb4ffd9b39952a09",
      "kind": "text_data",
      "source_text": "激战的<color=#ff9900>群英月赛 <race_name></color> ROUND1。",
      "source_fingerprint": "3fd3052189db65c94a888cbaca6a73a8f8cc32655553f75eafb1b8714b4a79d1",
      "source_path": "text_data_dict.json",
