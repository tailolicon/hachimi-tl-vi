        "1401"
      ]
    },
    {
      "uid": "zhcn:df939ce043281904b4808099",
      "kind": "text_data",
      "source_text": "谁能够第1个跑完<race_distance>呢！",
      "source_fingerprint": "7c8eb3e7907ae1647485b4a9d6e316c7c338d06c1c7c0c94efcca1158a96e451",
      "source_path": "text_data_dict.json",
      "json_path": [
        "201",
        "1402"
      ]
    },
    {
      "uid": "zhcn:9040833901cb1857eea3ebad",
      "kind": "text_data",
