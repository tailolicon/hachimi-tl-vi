    {
      "uid": "zhcn:f46753111db1c8958c2f4c44",
      "kind": "text_data",
      "source_text": "终于即将开始，<color=#ff9900>群英月赛 <race_name></color> ROUND1。",
      "source_fingerprint": "0e84da620bb1b6aef6827b397c669c11bdd4b1bfd04d8383e7e6fa36358cf064",
      "source_path": "text_data_dict.json",
      "json_path": [
