      "json_path": [
        "202",
        "10101"
      ]
    },
    {
      "uid": "zhcn:5d23ab9528430e8e9c64fc0c",
      "kind": "text_data",
      "source_text": "虽然竞赛表现都是距离胜利只差一步，但实力其实不仅如此。",
