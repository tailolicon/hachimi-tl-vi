        "140202"
      ]
    },
    {
      "uid": "zhcn:cf66ee85075382b01f239924",
      "kind": "text_data",
      "source_text": "实力毫无疑问位于最高等级。",
      "source_fingerprint": "7b0f02125e2af70b91be86c58306eaaf15a0331ef04a8015d0b01fc8a9ac7b4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14100"
      ]
    },
    {
      "uid": "zhcn:c9773bd7b3a1d88a3957f768",
      "kind": "text_data",
      "source_text": "展现足以让周遭众人感到畏缩的压倒性表现，是强者中的强者。",
      "source_fingerprint": "bd58bbb8e556a245273df302808a178f75a8796ac5557a71f2e99214becc7c2d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14101"
      ]
    },
    {
      "uid": "zhcn:efa27a8322114ac8e53c4790",
      "kind": "text_data",
      "source_text": "绝不会让人期待落空，<color=#ff9900>「<trainer_name>」</color>的心腹。",
      "source_fingerprint": "9a4c949eb3ccb34d743e621f43691e1ba5045ed3830c035da543d36911282aef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14102"
      ]
    },
    {
      "uid": "zhcn:675b9dc6e12229ba6577fafa",
      "kind": "text_data",
      "source_text": "这一战也绝对不容错过！",
      "source_fingerprint": "bd2fe2d841f33358fad7a9464e54ae09a165020938935018740a93fe2989eb83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14200"
      ]
    },
    {
      "uid": "zhcn:8184bc047bcfbba9f0811d44",
      "kind": "text_data",
      "source_text": "本次竞赛也最被看好！",
      "source_fingerprint": "0f079e9dcf0b1214a62ed234ae534b9a1416a7727853363cb71b81f09066ad8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14201"
      ]
    },
    {
      "uid": "zhcn:00cf41fd2343127c4191719e",
      "kind": "text_data",
      "source_text": "也要在此累积胜利，朝更高的目标迈进……！",
      "source_fingerprint": "f143c6cdf5bf01e93860ca7afd55c2f556ab9097589436b5dfb614be93ad46c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14202"
      ]
    },
    {
      "uid": "zhcn:5fc60115a708687a5d86d21e",
      "kind": "text_data",
      "source_text": "过去5战全都获胜，状态绝佳的赛马娘。",
      "source_fingerprint": "87ba153b19f8e0b871fc998e0bc2fa6ddb6367d240d594e14ad0fd09f5573545",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15000"
      ]
    },
    {
      "uid": "zhcn:079290ccaf6d256ed5033bc8",
      "kind": "text_data",
      "source_text": "最近5场竞赛的胜率竟然为100%。",
      "source_fingerprint": "e1ce8135aeebff6b882737d7531e4f169771736b613d142946cbe6c4027e36cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15001"
      ]
    },
    {
      "uid": "zhcn:7feaf4b247b22da8cd56e9a1",
      "kind": "text_data",
      "source_text": "目前在<color=#ff9900>群英月赛 <race_name></color>的胜率为<total_win_percent>%。",
      "source_fingerprint": "0beda041d80e8df4f73bcacaba420066a331ec471e7012c9ad3c0840e7b2d8de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15002"
      ]
    },
    {
      "uid": "zhcn:a90fdc7a797ead42ce155a1c",
      "kind": "text_data",
      "source_text": "简直难以想象她败北的模样。",
      "source_fingerprint": "53097f7ac338225d225a3ebffcbee407317d8d2c32dfebd0f0deef45681947cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15100"
      ]
    },
    {
      "uid": "zhcn:b3db6207547a24a8feea200b",
      "kind": "text_data",
      "source_text": "已经散发出令人感觉到王者风范的气势。",
      "source_fingerprint": "91adafd43b00043fe0a6356b35f3991d6fae99aa43cf381d6abddc80e20595b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15101"
      ]
    },
    {
      "uid": "zhcn:c385e1e9955f25a217c67646",
      "kind": "text_data",
      "source_text": "真的有能够战胜这名赛马娘的对手吗？",
      "source_fingerprint": "7f48688e53f8661a65b3028571958e0c956ba5237c84f6250e005beb12820516",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15102"
      ]
    },
    {
      "uid": "zhcn:1157de91ec4e222990afeae0",
      "kind": "text_data",
      "source_text": "这股压倒性气势能够持续到何时？一定要看！",
      "source_fingerprint": "9179758a482db57b9a31d23ae597f34554aecf11891a8173f6e3d5c6d2b15bdc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15200"
      ]
    },
    {
      "uid": "zhcn:5bd18eca14d7d0d8646242f1",
      "kind": "text_data",
      "source_text": "这场胜利唾手可得吗？让我们来看看。",
      "source_fingerprint": "574d89228e56830c788ccb845866f53167838d2cd7e6203f96c6612579f0025e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15201"
      ]
    },
    {
      "uid": "zhcn:f69276065895ddb6105a7212",
      "kind": "text_data",
      "source_text": "敬请期待吧。",
      "source_fingerprint": "1dabf010f331d14415784a9f63a80a01d007cd1e563bd73d0e301d606146fb49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "15202"
      ]
    },
    {
      "uid": "zhcn:416c6a644b52823864bd21c8",
      "kind": "text_data",
      "source_text": "虽然实力还不明了，但成为殿堂赛马娘之前的评价极佳。",
      "source_fingerprint": "601c8d44a3b7b5ab1bceb92f175f029214c5f9a457d3c10878be61a158d25f37",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "200"
      ]
    },
    {
      "uid": "zhcn:2eb6f70fbe9e27d3cb2992cd",
      "kind": "text_data",
      "source_text": "曾在预赛取得第1名，实力坚强的赛马娘。",
      "source_fingerprint": "f4e941b20331f9048f0d482044f17f9a13bd61f76678b72c685c528fab44b2fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "2000"
      ]
    },
    {
      "uid": "zhcn:4b7d04097a34d19ff13a046d",
      "kind": "text_data",
      "source_text": "目前胜率25%，尝过胜利滋味的赛马娘。",
      "source_fingerprint": "49ed59d1bc4e3d08c0ff5446f209ad6500e23083d099b20c0d1e11e31f1afa7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "2001"
      ]
    },
    {
      "uid": "zhcn:992489386178a5385f23b973",
      "kind": "text_data",
      "source_text": "在<color=#ff9900>群英月赛 <race_name></color>有获得第1名的经验。",
      "source_fingerprint": "e4372c17fee634a256a7a9da296fb0bc37198738ac2ba1bb51d9d9105bd3863d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "2002"
      ]
    },
    {
      "uid": "zhcn:d4d0f069c8ca94b8beeb8e2b",
      "kind": "text_data",
      "source_text": "实力还是未知数。务必要看看是否能将至今所累积的实力，透过对手展现出来。",
      "source_fingerprint": "5bdb02b1e93988a5a79be6f7a6b61771ff4f13c192e6a2c298b35e19497a19d2",
