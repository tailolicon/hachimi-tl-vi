      ]
    },
    {
      "uid": "zhcn:6c44f39f4a8d24f395e4dff6",
      "kind": "text_data",
      "source_text": "我的梦想和你的梦想，将要起步。",
      "source_fingerprint": "a0385ec307151bf46dc632c099623eb2894c90896832794d63849c157caa4cd6",
      "source_path": "text_data_dict.json",
