    },
    {
      "uid": "zhcn:cd6e5c18e48cfe28e82d4116",
      "kind": "text_data",
      "source_text": "过去5战中获得4胜，是超受瞩目的赛马娘。",
      "source_fingerprint": "d8ec7de914611ba3374d5cc6478cce1544d0b54e59b00f06605992dea95768d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "14000"
      ]
    },
    {
      "uid": "zhcn:714704a283ead13ee868c4f0",
      "kind": "text_data",
      "source_text": "成为「最强赛马娘」的会是谁呢？",
      "source_fingerprint": "120451aedbe89f63a3bd1780baa3591903fee909c89bc57eff444d46b8b631a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "140000"
      ]
    },
    {
      "uid": "zhcn:b29d57b8adf1e7e2ff478a0e",
      "kind": "text_data",
      "source_text": "成为「最强赛马娘」的会是谁呢？",
      "source_fingerprint": "120451aedbe89f63a3bd1780baa3591903fee909c89bc57eff444d46b8b631a0",
      "source_path": "text_data_dict.json",
      "json_path": [
