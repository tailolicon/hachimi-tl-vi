      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "232"
      ]
    },
    {
      "uid": "zhcn:28186f858871bf2827dfe648",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
