      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "180"
      ]
    },
    {
      "uid": "zhcn:2d361261e185244e6c5750ee",
      "kind": "text_data",
      "source_text": "针对竞赛做了多少跑步训练呢？",
