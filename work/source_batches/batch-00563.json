    {
      "uid": "zhcn:e0127926d02fcf52ef549ded",
      "kind": "text_data",
      "source_text": "还没有尝过败绩，程度超凡的强者。",
      "source_fingerprint": "1eda9e7f16a36910cb1a034ef927cf54111e05b06bd4573b950b128f4b182fe1",
      "source_path": "text_data_dict.json",
