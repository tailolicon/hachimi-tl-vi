{
  "schema_version": 1,
  "batch": 567,
  "batch_count": 1682,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "f1c6893d60a8989361cfd9c371f56bc8ec25f81d",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:2449140fc6c9fc4ea86b675e",
      "kind": "text_data",
      "source_text": "看来胜利还没有降临。",
      "source_fingerprint": "af5ca64786059e361ef2470e0e08b1b092d9ea56468b27b13d4c97acbe9ea9e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10000"
      ]
    },
    {
      "uid": "zhcn:36cfcce703268542b638167d",
      "kind": "text_data",
      "source_text": "来到这里首次参赛的赛马娘。",
      "source_fingerprint": "e25c46139ee5bdd49267ed8c9c9868a1b84e96a36d63fb2bd330b8ec893ce32d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100000"
      ]
    },
    {
      "uid": "zhcn:9e2e33d3f61fa7d86aa5555e",
      "kind": "text_data",
      "source_text": "在决赛首度登场的赛马娘。",
      "source_fingerprint": "4c9a4ee734d1bf1d616b3b5afddf8c3ff6337469de6bde8bdfe7eef5cfa0b683",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100001"
      ]
    },
    {
      "uid": "zhcn:b77ce606052118a1ba309052",
      "kind": "text_data",
      "source_text": "登场时蓄势待发，初战即为决赛的赛马娘。",
      "source_fingerprint": "0bc1733bec9c1ec94b9810c6122910883324c1686b9ec5d722ed66bb83b46ca2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100002"
      ]
    },
    {
      "uid": "zhcn:0968a96609d2bb2034472468",
      "kind": "text_data",
      "source_text": "最近5场竞赛没能掌握胜利。",
      "source_fingerprint": "8c9cde5ebaee01d67a24f79e420c5708adf18d6447adeda3a790c2bf61065066",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10001"
      ]
    },
    {
      "uid": "zhcn:3a1689c04c2014248bd64b06",
      "kind": "text_data",
      "source_text": "最近是成绩没有起色的状态。",
      "source_fingerprint": "cf0764f3ecacbea6f74e95e0dcc578b42452eaead31a6e86c78817d50e13bbb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10002"
      ]
    },
    {
      "uid": "zhcn:c17f345aa5d31e63fea7b6db",
      "kind": "text_data",
      "source_text": "在本次大赛中还未获胜的赛马娘。",
      "source_fingerprint": "c15c5c0d48fdca6118db5cd29a93782eac8c9e9502a75deffa5dd840df0c6bee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1001"
      ]
    },
    {
      "uid": "zhcn:940124c9af0a0d56aaed2b77",
      "kind": "text_data",
      "source_text": "是在预赛隐藏实力的<color=#ff9900>「<trainer_name>」</color>的王牌。",
      "source_fingerprint": "81141a5496e690171317e5c50e6f2e497f28306e18ec0e09de2f2f6c23dc9feb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100100"
      ]
    },
    {
      "uid": "zhcn:dd08ad24b28c32c2e1bddb12",
      "kind": "text_data",
      "source_text": "那至今尚未明了的实力终于要在这次大赛亮相。",
      "source_fingerprint": "f1db294310ca3a24f0cd8935f1fc818c57058ae4f6012bcca55db6d87e582181",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100101"
      ]
    },
    {
      "uid": "zhcn:4681e3b032b1f59c554967e0",
      "kind": "text_data",
      "source_text": "在绝不能输的场合骤然登场，似乎值得期待。",
      "source_fingerprint": "b23ec31b09f4c8c85020424ebd6a6e568675ab66f3c8baa12b8d89c7d6a1cf9a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100102"
      ]
    },
    {
      "uid": "zhcn:3915cb5289e4b146a0537c0e",
      "kind": "text_data",
      "source_text": "尚未拿下过一胜的赛马娘。",
      "source_fingerprint": "425a23d88682f4ed821e0d54ee51cb4a4460a20523e3910500f4f0ee71af594e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1002"
      ]
    },
    {
      "uid": "zhcn:aea308134056268081d1ef49",
      "kind": "text_data",
      "source_text": "与同伴的合作也值得关注！",
      "source_fingerprint": "799115cfb47a68df199ec1a57dace426a29fc9ca2ec0c7d9f76c235e285999ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100200"
      ]
    },
    {
      "uid": "zhcn:f7eda72011b9b2b2b34ef83f",
      "kind": "text_data",
      "source_text": "好，会展现出怎么样的表现呢……！",
      "source_fingerprint": "3ae9673824fbe1398bfcc42c60c85dbf5dc39076d015ea26ba7738cbe59a4068",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100201"
      ]
    },
    {
      "uid": "zhcn:0ef2dc6cc8e47fd55e4af95c",
      "kind": "text_data",
      "source_text": "在首次参赛就以拿下冠军的结果获得胜利吧！",
      "source_fingerprint": "2028557b95c619fb07b800ebbedc84c8644857c27ea5abed6db86a9569beccbc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "100202"
      ]
    },
    {
      "uid": "zhcn:9763bacb6fdc12cca5dc53fb",
      "kind": "text_data",
      "source_text": "首次参加<color=#ff9900>群英月赛 <race_name></color>。",
      "source_fingerprint": "dff8434be2bfb582e02c9ad9474ba810a7fbde50217cc5d35da49f0fdfe8a672",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "101"
      ]
    },
    {
      "uid": "zhcn:0eef50c28e33a9abf4ebc9e7",
      "kind": "text_data",
      "source_text": "不过可以从其表现看出对胜利以及不想输的执着。",
      "source_fingerprint": "912631b2e36ed4cd34d63d72858491fb2dccc95e6d39805d0ca748dd228434bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10100"
      ]
    },
    {
      "uid": "zhcn:bb70624f3929dcaf0f48fad5",
      "kind": "text_data",
      "source_text": "但从原本的实力来看，可说是持续留下非其所望的成果。",
      "source_fingerprint": "aeb0b466f2c6c8e4588bfa1cc8af3e672f0d67ba2cf78b0598fedf32ce36bd83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10101"
      ]
    },
    {
      "uid": "zhcn:79d0d81f300d23e50dfd14d8",
      "kind": "text_data",
      "source_text": "不过若能满足一些条件，就能大大改变结果吧。",
      "source_fingerprint": "f1396bb09b5f56c3d5c515be2cf6ecfa962036051ca583859a6b6189666e0593",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10102"
      ]
    },
    {
      "uid": "zhcn:d88a26a7e496e510f0ea885c",
      "kind": "text_data",
      "source_text": "想要摆脱低潮，带给训练员和粉丝们好结果。",
      "source_fingerprint": "48a28a7bbb4e4f12ea66412312bc2213adaf390473ded04c9db0a7feec84341d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10103"
      ]
    },
    {
      "uid": "zhcn:aa9464c16ae5fb15cb9b78f4",
      "kind": "text_data",
      "source_text": "于<color=#ff9900>群英月赛 <race_name></color>出道的赛马娘。",
      "source_fingerprint": "a7e07de5b80c108b685839c29836610aa3d3782ac1141e3f68817cafc83e94eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "102"
      ]
    },
    {
      "uid": "zhcn:27d8a7dc72995a4701b0d427",
      "kind": "text_data",
      "source_text": "希望藉由这一战掌握某种契机……！",
      "source_fingerprint": "853f67d61e851c5780d154eb5ff87c1f9df809547d6732e957029a9625495b13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10200"
      ]
    },
    {
      "uid": "zhcn:05fc8af6aa00c0aeb1931006",
      "kind": "text_data",
      "source_text": "能够掌握重要的1胜吗！",
      "source_fingerprint": "1c3d148d95510455fa64ba4881620cb48535fe876f3920a83a575dba35450663",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10201"
      ]
    },
    {
      "uid": "zhcn:0d8acbc7bfec72d0dce3241a",
      "kind": "text_data",
      "source_text": "就此期待局势逆转吧。",
      "source_fingerprint": "2e28d1c4319cc172aa0ffd4ad1acf8a20043ef56a4d4cd4d0228953b7be8a004",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10202"
      ]
    },
    {
      "uid": "zhcn:187ff0d8d6bb43b33c24f822",
      "kind": "text_data",
      "source_text": "能将这场竞赛化为转机吗？",
      "source_fingerprint": "27be29a33d9512f291bae0c2940ea5f619135c8e35ce91d53f2fec0d1ae5868a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "10203"
      ]
    },
    {
      "uid": "zhcn:fe76b569e99f0883aa536e21",
      "kind": "text_data",
      "source_text": "不过，在累积经验后已能窥见胜机了吗？",
      "source_fingerprint": "1b7ae18171e2bdb3b6a3aba5248105766ad8281bdee802ac970d6868eb3bfb0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1100"
      ]
    },
    {
      "uid": "zhcn:546fa079b21e7855f5b702c2",
      "kind": "text_data",
      "source_text": "过去5战中获得1胜的赛马娘。",
      "source_fingerprint": "e1747aab19cba4a2e5dc492315baac0adeaccfce8a3a5be254b191202acd142e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11000"
      ]
    },
    {
      "uid": "zhcn:383f951d1ee2dd30f0d656fe",
      "kind": "text_data",
      "source_text": "<color=#ff9900>「<trainer_name>」</color>的招牌赛马娘。",
      "source_fingerprint": "9d57121301d91b9a363529767d53c6f419821c720caeb8685cef3e74c90058a6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110000"
      ]
    },
    {
      "uid": "zhcn:fa6c7ca31f8b7a5f09a310e8",
      "kind": "text_data",
      "source_text": "登上决赛也充满自信，值得关注的赛马娘。",
      "source_fingerprint": "e72890cc29a6bd6b618906e0b5e657a89aebcf5124102d73c4288ee5eefcce08",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110001"
      ]
    },
    {
      "uid": "zhcn:81922a3e23dc11aa97e57014",
      "kind": "text_data",
      "source_text": "瞩目的赛马娘，终于来到了这里。",
      "source_fingerprint": "82cf805b23682aceb4b88e6786db4b67e58bc89e976a007454ab5ee95a1cf74f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110002"
      ]
    },
    {
      "uid": "zhcn:533c398bfcae187e55acc2de",
      "kind": "text_data",
      "source_text": "最近5场竞赛的胜率为20%的赛马娘。",
      "source_fingerprint": "5a30fce3241611103021ef98f2a1cfe0fd92e3fa23d54c487429b3c940febcc9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11001"
      ]
    },
    {
      "uid": "zhcn:64154856a246599347ed3fcc",
      "kind": "text_data",
      "source_text": "尝过胜利滋味的赛马娘。",
      "source_fingerprint": "598dcb776890d11f2d8a90ea5fce6a7a23b2dbc182ba4caec811f9e8a3b88cc8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11002"
      ]
    },
    {
      "uid": "zhcn:c5e53d4fd6b0ef0e6401b234",
      "kind": "text_data",
      "source_text": "一直在等待爆发之时吗？",
      "source_fingerprint": "833269d83b38de658b10441120e657b67a3a4d81cf0c213cffdad831bdcf8df1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1101"
      ]
    },
    {
      "uid": "zhcn:d019f5638fef38e16932dd6c",
      "kind": "text_data",
      "source_text": "若能在这个盛大舞台发挥坚强的实力，获得优胜并非只是梦想。",
      "source_fingerprint": "259607c037da502adbc24013475a0badf24a6702017ff72655f358c304734a56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110100"
      ]
    },
    {
      "uid": "zhcn:30b417b8ab7fd249ccf91aa4",
      "kind": "text_data",
      "source_text": "决赛时究竟会让我们见识到怎么样的表现呢。",
      "source_fingerprint": "d5422f38344bc5d450df243837ff7e2f1d86b4e253bc753c95305564d9684093",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110101"
      ]
    },
    {
      "uid": "zhcn:c7a64e206278b48c7a7a1338",
      "kind": "text_data",
      "source_text": "若能将竞赛导向擅长的情况，就能大幅度地接近胜利。",
      "source_fingerprint": "16f03905cc1ad0012df174a5db17c72991d3c7e03af439dd704118edae03db40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110102"
      ]
    },
    {
      "uid": "zhcn:1cecc8441f5f2ddf86f53ab7",
      "kind": "text_data",
      "source_text": "展现了在上次竞赛中掌握到的重要灵感。",
      "source_fingerprint": "f4783637c5d34a76713c44f2e200b3aa1d2991d8173e1a00be382c0ae2de510e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1102"
      ]
    },
    {
      "uid": "zhcn:66802f6e70508e7691970a97",
      "kind": "text_data",
      "source_text": "登上迈向荣耀的阶梯吧……！",
      "source_fingerprint": "b7fe8a0356c2e7f0fd940ceb6adffa8d59d75c574a6f11ffdeae6e8793030baf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110200"
      ]
    },
    {
      "uid": "zhcn:19588ce283dabe02e46fed80",
      "kind": "text_data",
      "source_text": "踏出奔向优胜的一步吧！",
      "source_fingerprint": "c6f617d273403a2e8f71f92c02101c6165ef79b01edb1ea0fe68a0c133d0cd4d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110201"
      ]
    },
    {
      "uid": "zhcn:6d623a137f0fb3068566db88",
      "kind": "text_data",
      "source_text": "前往最后的盛大竞赛！",
      "source_fingerprint": "449f7a480ada7f433ced8239fbfcc78bab8eeb69783113c6ce8cabe8a2b840bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "110202"
      ]
    },
    {
      "uid": "zhcn:947a587f136132369c6f7d05",
      "kind": "text_data",
      "source_text": "但本次竞赛似乎不同。是因为萌生对第1名的执着吗？",
      "source_fingerprint": "684d0e7722c5173299f8213ab9217e404148e075fad50e87f199ef5ed36122e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1103"
      ]
    },
    {
      "uid": "zhcn:8fe4a5b167b57ee50c579ffc",
      "kind": "text_data",
      "source_text": "不过成为殿堂赛马娘前在<single_battle_record>留有成绩，实力无庸置疑。",
      "source_fingerprint": "beb60fa593e705f398fc4f97af1b3caa649825fd40b3db355a7457c1ef0c03c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1104"
      ]
    },
    {
      "uid": "zhcn:214fa3a4a2d1fe543237384b",
      "kind": "text_data",
      "source_text": "不过那压倒性的速度，让人不禁感受到胜利的迹象。",
      "source_fingerprint": "e8236a7fc1e7d5bbace2236814c83d953ccf9bcb0409eda4c6930fc880f394fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1105"
      ]
    },
    {
      "uid": "zhcn:1f853a0500704e4b687df594",
      "kind": "text_data",
      "source_text": "但其无尽的持久力，能期待持续跑到后期也不会力竭。",
      "source_fingerprint": "fd466982c73092aa873b1445ef0fcc0f8a760bf5f7236957f0e6f4ceb0fc5215",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1106"
      ]
    },
    {
      "uid": "zhcn:6a3dd81ef6c3378309be9163",
      "kind": "text_data",
      "source_text": "不过爆发性的力量是其强项，其实力货真价实。",
      "source_fingerprint": "b47d19b6885c5eca3581fc97635d07efca90cd5b155709434ebe6b9c8385f925",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1107"
      ]
    },
    {
      "uid": "zhcn:9ae0d247f98f606e1e61fe01",
      "kind": "text_data",
      "source_text": "但与生俱来那不屈的意志力，会随着情势大展所长。",
      "source_fingerprint": "c26fe12f4b935c0047c614e1e709dd77a8aed0f5972cf6ac32ca0d9049aef6c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1108"
      ]
    },
    {
      "uid": "zhcn:6038208fbc498e8198a29d73",
      "kind": "text_data",
      "source_text": "不过若是竞赛的展开符合她的精心计算，期待度会大大提升。",
      "source_fingerprint": "5e810bdf3405c7d04004884759895381b6089b667d74f9af04a621ea327fbd68",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1109"
      ]
    },
    {
      "uid": "zhcn:5154ac2bb48e024da1d119c4",
      "kind": "text_data",
      "source_text": "若能合力累积胜利，通往决赛的道路会为她们敞开吗？",
      "source_fingerprint": "c47e119f1d428653c06039e7821f433c62d2b02bf76fe199295bb23d893b3b60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11100"
      ]
    },
    {
      "uid": "zhcn:ec8f233be9e6e76881ee86b1",
      "kind": "text_data",
      "source_text": "似乎已经掌握了攻略这次大赛的线索。",
      "source_fingerprint": "d7d8a0de40802e6e2a1a99736b601d17c4be8be508ec8c456d28f953b5fddce4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11101"
      ]
    },
    {
      "uid": "zhcn:b8b125842977a8deb8fe69bf",
      "kind": "text_data",
      "source_text": "当竞赛按照预定进行时，会展现出惊人的破坏力。",
      "source_fingerprint": "1955f4914e899968cf18aa70ca369e3892b81020c2c8d1f96796bdb77e6db708",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11102"
      ]
    },
    {
      "uid": "zhcn:46979d0d18ec881f75669a84",
      "kind": "text_data",
      "source_text": "这次也能引领这场竞赛吗？一定要看！",
      "source_fingerprint": "33a4341ea450e5b0e9851b0e4d21444d68bb9a5ad099d256a476cf7928851b9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11200"
      ]
    },
    {
      "uid": "zhcn:f3771c3e51915a574b56e920",
      "kind": "text_data",
      "source_text": "在这场竞赛中也让人感受到胜利眷顾的存在。",
      "source_fingerprint": "b2e0322bf7ff481d5bb5849d8cfc3e30a569c905f35176415298439038db49f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11201"
      ]
    },
    {
      "uid": "zhcn:0496d3d96896ae478781998d",
      "kind": "text_data",
      "source_text": "也期待她这一战的表现吧。",
      "source_fingerprint": "d4557d507586ce4150217bbd830f2d816774b0f1087931ad27a33d89e4e0796c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11202"
      ]
    },
    {
      "uid": "zhcn:e4949c9fd5f284b09c76d827",
      "kind": "text_data",
      "source_text": "关注其压倒性的速度吧！",
      "source_fingerprint": "592cad9fca31488b793b4477d11d698dbe5421e113de431e8538f07bd4d5c85e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11203"
      ]
    },
    {
      "uid": "zhcn:ab5bd2180fd46cf15fe5a66b",
      "kind": "text_data",
      "source_text": "关注其压倒性的耐力吧！",
      "source_fingerprint": "16c41d5186e95d529f13be1fed0ac17a7109e615d8fcda9d308a05a874cb0ef8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11204"
      ]
    },
    {
      "uid": "zhcn:8d23097a2c4a85d066c6a083",
      "kind": "text_data",
      "source_text": "关注其压倒性的力量吧！",
      "source_fingerprint": "d1ee6cf6c31688cf707fecd4d27310b0343d2eb6c5d5c29d9d1d54c834452cde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11205"
      ]
    },
    {
      "uid": "zhcn:bcc59bd4185338f72b46c320",
      "kind": "text_data",
      "source_text": "关注其压倒性的根性吧！",
      "source_fingerprint": "5df748fea3fa42f61ccef820ffae2f22af5a1a863eaa7605609770208d7a91db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11206"
      ]
    },
    {
      "uid": "zhcn:04a37210b3aaf3263cd510c5",
      "kind": "text_data",
      "source_text": "关注其压倒性的智力吧！",
      "source_fingerprint": "7e6cc85f38daac8eb631cb03fa4541419bfc41a2919c83cc7118e414f9618378",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "11207"
      ]
    },
    {
      "uid": "zhcn:e2ca38233516e0d5b192300b",
      "kind": "text_data",
      "source_text": "要关注本次状况良好的表现！",
      "source_fingerprint": "cf3f1bc675404f2bf1bb1766bbb192fe4cd76ae7abab52f16756cd5ec9fc59cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1200"
      ]
    },
    {
      "uid": "zhcn:d7fdb5cff0131ca8c27bfd66",
      "kind": "text_data",
      "source_text": "过去5战中获得2胜，战绩优异。",
      "source_fingerprint": "883225ef2797beabc9a0948ad89c48000661d863c2be81ff706267aa9433ff45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12000"
      ]
    },
    {
      "uid": "zhcn:ea93efff3dca3f1808a19113",
      "kind": "text_data",
      "source_text": "成功以拿下胜利而扬名，是必须关注的赛马娘。",
      "source_fingerprint": "d5deef7f29a0cddd6f3dde2869035b018f56bb05538642df269aaf303cc725b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120000"
      ]
    },
    {
      "uid": "zhcn:41673889fab8a07c99bc7978",
      "kind": "text_data",
      "source_text": "总胜率<total_win_percent>%，是备受期待的赛马娘。",
      "source_fingerprint": "eb0696be8a31d7eb8a8ffc10277e15c6bd9ad4c73b316e2dafd93424790a84b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120001"
      ]
    },
    {
      "uid": "zhcn:eb432f67c16bdc2e1c4942c5",
      "kind": "text_data",
      "source_text": "经历过无数激战，实力坚强的赛马娘。",
      "source_fingerprint": "b36558ee00de20d389d73baabacba5bf46f64af5ea14e4414e518518e32b00b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120002"
      ]
    },
    {
      "uid": "zhcn:d941b6717858dab4e44dde7c",
      "kind": "text_data",
      "source_text": "最近5场竞赛的胜率为40%。",
      "source_fingerprint": "c06a6905295ea06cad9605f2a30d545f0738cff0f33dc2ec654a840a0aa20087",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12001"
      ]
    },
    {
      "uid": "zhcn:1fac0f7a77347fb707fcf54d",
      "kind": "text_data",
      "source_text": "目前在<color=#ff9900>群英月赛 <race_name></color>的胜率为<total_win_percent>%。",
      "source_fingerprint": "0beda041d80e8df4f73bcacaba420066a331ec471e7012c9ad3c0840e7b2d8de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12002"
      ]
    },
    {
      "uid": "zhcn:264f8c2d0b71a763f1ca1997",
      "kind": "text_data",
      "source_text": "希望发挥本领，掌握胜利……！",
      "source_fingerprint": "3cc2c9ee1a48ea5be80c8e74af3d708e0963abacdfef6562bac9b52963b48d3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1201"
      ]
    },
    {
      "uid": "zhcn:31056a99e37a148130aad067",
      "kind": "text_data",
      "source_text": "在预赛确实拿下胜利的实力，足以和决赛的对手抗衡。",
      "source_fingerprint": "104dc06e8c5512696feb5ced5bcbac6030f0cd62473a954ce1cfdd330aa79e76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120100"
      ]
    },
    {
      "uid": "zhcn:fd8470746f9f9f233f9e9a31",
      "kind": "text_data",
      "source_text": "至今在这次大赛的活跃表现只能用十分出色来形容。",
      "source_fingerprint": "ddc4f9e14826e71352845b502e2d28657298fc3cd6c38033dccaa72305148961",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120101"
      ]
    },
    {
      "uid": "zhcn:d625ac5c6147257047fd60e3",
      "kind": "text_data",
      "source_text": "能将粉丝的声援化作力量，彻底发挥与生俱来的爆发力吗？",
      "source_fingerprint": "245ae2a388355170d8053183b18e3ed6cf8d5ac9da08f1364945104874f46bbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120102"
      ]
    },
    {
      "uid": "zhcn:78403bb5d4f3a313092a33cb",
      "kind": "text_data",
      "source_text": "首先要拿下1胜！在这场竞赛倾尽全力！",
      "source_fingerprint": "eca18d8b6269c7e930331181df4f33ed1b12e931d4926204f1d515b641d3427f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "1202"
      ]
    },
    {
      "uid": "zhcn:80fc8627170453d3dd92972e",
      "kind": "text_data",
      "source_text": "划下完美的句号吧！",
      "source_fingerprint": "ca1e0eec27cf72e40556bee2832618c7f7e6884ee31d0a88a9225f703fb7a78a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120200"
      ]
    },
    {
      "uid": "zhcn:460326285b4e07afa521585f",
      "kind": "text_data",
      "source_text": "拿下第1名吧！",
      "source_fingerprint": "c1af81aab7fa88bb731e2da4c954dfcd2040960816090511908781b554b9fb25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120201"
      ]
    },
    {
      "uid": "zhcn:064d0a793beed73bd073ff48",
      "kind": "text_data",
      "source_text": "现在就前往顶点！",
      "source_fingerprint": "41a4ed1815688084ee0a36f22a5dc7e24dbeebc758705c2e8a440eec1c020388",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "120202"
      ]
    },
    {
      "uid": "zhcn:d655381dada022a18927fc83",
      "kind": "text_data",
      "source_text": "这次也毫无疑问会是强力候补之一吧。",
      "source_fingerprint": "048472094b3db4e7045c4925808803d7b1fc5e40a4f99ebc85a01f21f119346f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12100"
      ]
    },
    {
      "uid": "zhcn:6270c4401f29f90ac1ffc913",
      "kind": "text_data",
      "source_text": "能充分发挥坚强实力的强大赛马娘！",
      "source_fingerprint": "2e8baee69255fc17c72b95eec02fc1de129c8be166f7f67d8fda1be4e42b10c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12101"
      ]
    },
    {
      "uid": "zhcn:8a546c890ddc019261fb2f91",
      "kind": "text_data",
      "source_text": "连面对强敌也能确实取胜的赛马娘。",
      "source_fingerprint": "d20305ad7e5e8f301e4adc3dd3c08cf2d0bf7df90f9abbf55f6768a5364419fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12102"
      ]
    },
    {
      "uid": "zhcn:42ceb665120d38d3a1840e42",
      "kind": "text_data",
      "source_text": "能够响应众多粉丝的期待吗？",
      "source_fingerprint": "726a1735ba2e9e9b18869b3ad978ea5932369d3650a6762d24e44ff061ad826b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12200"
      ]
    },
    {
      "uid": "zhcn:9766e6bd6fb4c800649b27cd",
      "kind": "text_data",
      "source_text": "朝向战况绝对会非常火热的竞赛，前进！",
      "source_fingerprint": "535179d05bf1befe000c4251179870eccf827d17ae49796101af88fb793a5d6d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12201"
      ]
    },
    {
      "uid": "zhcn:f404738393955c204a363643",
      "kind": "text_data",
      "source_text": "在这场竞赛中也是必须关注的1人。",
      "source_fingerprint": "2fd79331b38ac2866c69cfbddff444f601c7bede1cfa49ef0de31c7d7c6acfad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "12202"
      ]
    },
    {
      "uid": "zhcn:3cd7588ccf6e6fedd8f4958d",
      "kind": "text_data",
      "source_text": "过去5战中获得3胜，战绩亮眼。",
      "source_fingerprint": "b89fb695d7a033d269ececd3ccac8eae790a77f91e9c803072d3bec820ee5713",
      "source_path": "text_data_dict.json",
      "json_path": [
        "203",
        "13000"
      ]
    },
    {
      "uid": "zhcn:93ea3b576a4edf6c08f6eca2",
      "kind": "text_data",
      "source_text": "目前的胜率为<total_win_percent>%的赛马娘。",
      "source_fingerprint": "2ed2a6dd94232ef2d05211d08cb25f7e09d42e2dc6242a35305279098400537c",
      "source_path": "text_data_dict.json",
