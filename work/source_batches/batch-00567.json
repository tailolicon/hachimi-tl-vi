      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "710"
      ]
    },
    {
      "uid": "zhcn:fa46c705d1a250f196d2f8bf",
      "kind": "text_data",
      "source_text": "请对同年级的大家，说说你的抱负！",
      "source_fingerprint": "f6dfd312b5e03b79d3678c2dfdde2e4faecf658c83de1a3342960854f692d081",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "711"
      ]
    },
    {
      "uid": "zhcn:e66e1130a3c9565de8be3859",
      "kind": "text_data",
      "source_text": "决赛结束后，你想做什么呢？",
