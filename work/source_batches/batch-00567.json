      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "7"
      ]
    },
    {
      "uid": "zhcn:b07e79f6afab1f3e315465b0",
      "kind": "text_data",
      "source_text": "请说说你的抱负！",
      "source_fingerprint": "7321329fe7053537673a27efce5d83991630f035a40f049626407139a041be58",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "70"
      ]
    },
    {
      "uid": "zhcn:8e565eb4eb7d5f6e3ff16dc9",
      "kind": "text_data",
      "source_text": "希望我们在决赛中关注哪些地方呢？",
      "source_fingerprint": "34bf4fd0809bc18a88085e3ca03a4c1277d3b54932d57ff9c62b874dd802e403",
      "source_path": "text_data_dict.json",
      "json_path": [
