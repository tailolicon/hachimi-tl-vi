    },
    {
      "uid": "zhcn:dd2863ee0d62201495661a31",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "318"
      ]
    },
    {
      "uid": "zhcn:33bab79317664e05fbf0416f",
      "kind": "text_data",
      "source_text": "状态怎么样呢？",
      "source_fingerprint": "381a9d3c904e27eeb92525cc32cb2f64c009c5d931d04d9277f43ebf4e658322",
      "source_path": "text_data_dict.json",
