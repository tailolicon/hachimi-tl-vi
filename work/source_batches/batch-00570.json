        "204",
        "320"
      ]
    },
    {
      "uid": "zhcn:cc12b9838d476c472118398a",
      "kind": "text_data",
      "source_text": "今天早上吃了什么呢？",
      "source_fingerprint": "556c081ab48e581c64ee3a0fc6166399bcaee72c21d70014f723d1eba3334951",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "321"
      ]
    },
    {
      "uid": "zhcn:e6386f2df81a683c628780f4",
      "kind": "text_data",
