  "entries": [
    {
      "uid": "zhcn:3a00e8e04fbd66031c321043",
      "kind": "text_data",
      "source_text": "最近有遇到开心的事情吗？",
      "source_fingerprint": "1fb438d700921e2d77288ae421e956e9014398c24f074d053b25cfefd7ed4668",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "273"
      ]
    },
    {
      "uid": "zhcn:cc050eb035859a26557b7c99",
      "kind": "text_data",
      "source_text": "请向正在观看竞赛的大家说句话。",
      "source_fingerprint": "9858d2c47478db2349fd006b62b759bc4a2ae36ef9ce3116caa811d4c51190b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "274"
      ]
    },
    {
      "uid": "zhcn:a1a60903e6b2b7e0f004aa9a",
      "kind": "text_data",
      "source_text": "听说你最近常出现在车站附近？",
      "source_fingerprint": "ac0fc190bc6f747d3dd2134f7857cfb9100958be501ce503ffb436cbbb72cff6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "275"
      ]
    },
    {
      "uid": "zhcn:f83b52041e7956abe98e7283",
      "kind": "text_data",
      "source_text": "你对自己最有自信的地方是？",
      "source_fingerprint": "5090dc56f1fd72afe86c8dacd09dd573042463c1941ae65b35db422db7bb19d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "276"
      ]
    },
    {
      "uid": "zhcn:ab9a40849c287f8d33470ea4",
      "kind": "text_data",
      "source_text": "有赛前的例行公事吗？",
      "source_fingerprint": "6dfd1db01bad37da61eea4b1dabf534504c0d5e5eaefe56d49950e960140e83d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "277"
      ]
    },
    {
      "uid": "zhcn:10f9e3bfd4720e0414b65834",
      "kind": "text_data",
      "source_text": "竞赛时什么事情最重要？",
      "source_fingerprint": "01995ff79ab47d1424696b2b834325bc04124c8490d059765adf949cc05a8e81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "278"
      ]
    },
    {
      "uid": "zhcn:5f088c3e22da9c9bb0ce1a08",
      "kind": "text_data",
      "source_text": "觉得最辛苦的训练是什么？",
      "source_fingerprint": "71bc033852587690846b8662d86cbfac3c299beeeb9fd773b53a23a0123e3eff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "279"
      ]
    },
    {
      "uid": "zhcn:e7750c4d30eedcb63be2a3a5",
      "kind": "text_data",
      "source_text": "请告诉我们充满活力的秘诀。",
      "source_fingerprint": "681a83840de51636a4f347351e26574d1c34eb2bc5dfdb2edb4d62037cb19b83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "28"
      ]
    },
    {
      "uid": "zhcn:9f157e5011690f46225b500c",
      "kind": "text_data",
      "source_text": "期待你的表现！",
      "source_fingerprint": "a1bdb267edb2a739beea3debe5c1f8b84215ea9ae4eef11ba2a4127224acf6f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "280"
      ]
    },
    {
      "uid": "zhcn:ecda72ff8297ee549b44006f",
      "kind": "text_data",
      "source_text": "是否有人为你演出了一场激励人心的歌剧？",
      "source_fingerprint": "0e1ca1998600436c4bd7e16253ecb32b04d05d332c775f32b474c10aa9903310",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "281"
      ]
    },
    {
      "uid": "zhcn:4fbffceea1141c89c2dfd904",
      "kind": "text_data",
      "source_text": "胜利所需最重要的因素是什么？",
      "source_fingerprint": "e8ebf6717228afab815276dc5abf7e38bee7cf1a93f690e2fe48457ceaad626a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "282"
      ]
    },
    {
      "uid": "zhcn:e7f4ed6e32fcdf42d5a07ba3",
      "kind": "text_data",
      "source_text": "请向祈望你获得胜利的粉丝说说你的抱负！",
      "source_fingerprint": "278c8eb06cd3ab091707d309e605f0454cf6b8f508dda63fe0578674a21e2a6e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "283"
      ]
    },
    {
      "uid": "zhcn:354ef42b432b0936ad0d0910",
      "kind": "text_data",
      "source_text": "在比赛前，会做什么提升士气的事情吗？",
      "source_fingerprint": "d4638d19f49ab94b91a0bc5886e9d9c6be3c81bb95b53141e7b78814c5c8415e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "284"
      ]
    },
    {
      "uid": "zhcn:2928584f0c7969c94c894999",
      "kind": "text_data",
      "source_text": "在休假日会从事什么样的休闲活动？",
      "source_fingerprint": "d62c289e12cee0dc78b4686ce6ab3eab5d397aa2586a03cce1efb625596a73ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "285"
      ]
    },
    {
      "uid": "zhcn:c5f74ad104627d1a3b852c04",
      "kind": "text_data",
      "source_text": "没有训练的日子都怎么度过？",
      "source_fingerprint": "c0c9471aaa399f86240626a409851799f6ddb2dbb1bc5855b1b166f4fc16b281",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "286"
      ]
    },
    {
      "uid": "zhcn:c16a0ba87e8f11be5e15336e",
      "kind": "text_data",
      "source_text": "竞赛时什么事情最重要？",
      "source_fingerprint": "01995ff79ab47d1424696b2b834325bc04124c8490d059765adf949cc05a8e81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "287"
      ]
    },
    {
      "uid": "zhcn:f432f165ccf5dfbae076af58",
      "kind": "text_data",
      "source_text": "觉得最难熬的训练是什么？",
      "source_fingerprint": "6ec3201036d0468168509171e65b0e9268b4f6d53502a1a16e5a2049cf406e66",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "288"
      ]
    },
    {
      "uid": "zhcn:70b09030f9b5e9e23a64aa3e",
      "kind": "text_data",
      "source_text": "请和支持你的粉丝说句话。",
      "source_fingerprint": "bd97f0c193e731c7332a6a4a911f1451729383e0194d9b2de2ba8587079bbdf4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "289"
      ]
    },
    {
      "uid": "zhcn:28172eeb9e3ea2bac4d6e0e2",
      "kind": "text_data",
      "source_text": "用什么方法舒缓赛前的紧张感？",
      "source_fingerprint": "1047ddebdaa0033de992cb3d60a0520bae69d9fafed32fc8d6e0763c36879c5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "29"
      ]
    },
    {
      "uid": "zhcn:e8fb85ecaa8e481ea721abfd",
      "kind": "text_data",
      "source_text": "请告诉大家你的致胜料理！",
      "source_fingerprint": "5f6fa0a6577dbb782fac26beac7f3d9a552f2ec5385a67f587b7bf9303d0cdbf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "290"
      ]
    },
    {
      "uid": "zhcn:c8aa3c4dc38bb94677e91326",
      "kind": "text_data",
      "source_text": "如果你身上有着不安的因素，会是什么呢？",
      "source_fingerprint": "cee541b54013104020ebdd6958cebc245a196e04cba7c77e394e78216f6af4d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "291"
      ]
    },
    {
      "uid": "zhcn:52dc579a505511352bf8430a",
      "kind": "text_data",
      "source_text": "请告诉我们为了获胜，最重要的是什么？",
      "source_fingerprint": "01a8655f74e7d41c24bde3c90cc7a30a852ebe1549b908939c19219c7a227bb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "292"
      ]
    },
    {
      "uid": "zhcn:8483de8c5746f72b5a165b1a",
      "kind": "text_data",
      "source_text": "听说你对时间掌握得很精准。",
      "source_fingerprint": "c401d3978654fab0c698c8d0c33cb099fc35cbe66365d7183876bbfaeee49d17",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "293"
      ]
    },
    {
      "uid": "zhcn:db37a6e38fec565e07c47277",
      "kind": "text_data",
      "source_text": "请告诉我们你推荐的蛋糕。",
      "source_fingerprint": "31cdb32954b1ae8f71b0854ddf936576217a73e849327f1cce4528029ff7c8ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "294"
      ]
    },
    {
      "uid": "zhcn:410083c78808dcde7bdac190",
      "kind": "text_data",
      "source_text": "竞赛前有一定会做的例行公事吗？",
      "source_fingerprint": "b8d979824f772e97a57ea17e4d58d77a71626c7fd9d74b702d60a3ae4b45b24e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "295"
      ]
    },
    {
      "uid": "zhcn:b5e7f2b7779e5b280bab9d2c",
      "kind": "text_data",
      "source_text": "对于竞赛，有什么从平常就会注意的事情吗？",
      "source_fingerprint": "132455adef026da36348ae645a8fa1a42dcf477a6b173d6425346283836ddceb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "296"
      ]
    },
    {
      "uid": "zhcn:d39e9aba143f1e73add140dc",
      "kind": "text_data",
      "source_text": "有正在关注的赛马娘吗？",
      "source_fingerprint": "dae9153ff57eb86d62cefce7ca313a0308ac958b1c2fa22a3455b90c9082feab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "297"
      ]
    },
    {
      "uid": "zhcn:54f6100332499d8722411f98",
      "kind": "text_data",
      "source_text": "请告诉我们你对今天竞赛的期许。",
      "source_fingerprint": "9dff7582ada1fd2dd53d406300cb564867ca0169783bc55164aac2300dca5186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "298"
      ]
    },
    {
      "uid": "zhcn:8f272c6078f340502f219fc5",
      "kind": "text_data",
      "source_text": "有什么事情是每天都会留意的？",
      "source_fingerprint": "873c3830df46d15c08dd0634cbb94cd2f0e02cf837cc467e5ddd0d9165275f76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "299"
      ]
    },
    {
      "uid": "zhcn:9207b2163c68b0ea7590cb0f",
      "kind": "text_data",
      "source_text": "请告诉我们这次的秘密策略！",
      "source_fingerprint": "683b41ef7e38ecc3e6b41ed3600d4c3df16e31fb1effa512773546e3ef826ce9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "3"
      ]
    },
    {
      "uid": "zhcn:fae915e4e357a9c64ee8da3a",
      "kind": "text_data",
      "source_text": "请告诉我们训练时的甘苦谈！",
      "source_fingerprint": "d150e7f604a20c120b547cd61e4a0ecff77e7d55e6dda8827402e241efe04459",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "30"
      ]
    },
    {
      "uid": "zhcn:3f3c0614a68cee7f9a310d62",
      "kind": "text_data",
      "source_text": "你认为在竞赛中最重要的事情是什么？",
      "source_fingerprint": "3d00941d76605b0bf22f97911a2aa2b67da5bf5ae3b2eed8fad383b52b34948d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "300"
      ]
    },
    {
      "uid": "zhcn:50f84a71895e2aa777ceedcf",
      "kind": "text_data",
      "source_text": "听说你作为模特儿也很受欢迎呢！",
      "source_fingerprint": "63d9eacd944bfaf98ee1fdc2208c3bd87fe1c7089b7eeb2bee8399fd14ce9100",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "301"
      ]
    },
    {
      "uid": "zhcn:f4c735f26397ba285026bf81",
      "kind": "text_data",
      "source_text": "有正在关注的赛马娘吗？",
      "source_fingerprint": "dae9153ff57eb86d62cefce7ca313a0308ac958b1c2fa22a3455b90c9082feab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "302"
      ]
    },
    {
      "uid": "zhcn:917ecb8d6298520444bbbf17",
      "kind": "text_data",
      "source_text": "你有着即使在竞赛中也很美丽耀眼的发色呢。",
      "source_fingerprint": "b87fec3b6bb62d43bfb140e22690cf2356126eb1034a43d02cde2d028d748445",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "303"
      ]
    },
    {
      "uid": "zhcn:e5c10094a07f1126919d5417",
      "kind": "text_data",
      "source_text": "请偷偷告诉我们胜利的秘诀！",
      "source_fingerprint": "1765c70f946969fcd6fc6cfd44a4744f76e24d2ea8ac8bfee8437be3cc6fe065",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "304"
      ]
    },
    {
      "uid": "zhcn:163e04bdd69cb0101f6e189b",
      "kind": "text_data",
      "source_text": "请以班长的身份对班上同学说句话！",
      "source_fingerprint": "6a8e5ef188264f1f11246fecfab7a60a3dd3d0adb0d1203b99d72325bc74128c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "305"
      ]
    },
    {
      "uid": "zhcn:6201e05a1d1ded19bc4e4664",
      "kind": "text_data",
      "source_text": "请用四字成语讲出抱负！",
      "source_fingerprint": "81fa773378f4376c4c5256a0819c47aae0c48745edabece9c73259292ebc5d04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "306"
      ]
    },
    {
      "uid": "zhcn:f2a9cc0f07e4c1eb587e2f1d",
      "kind": "text_data",
      "source_text": "有什么实力坚强的祕诀吗？",
      "source_fingerprint": "1998aff469caad818d10739dbd5b1ed2e6af4bf50a928b33b28a57c499c5f0fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "307"
      ]
    },
    {
      "uid": "zhcn:6491e6fae2f5d1a571f2d59c",
      "kind": "text_data",
      "source_text": "意思是你最近热衷于打工吗？",
      "source_fingerprint": "c7579218a2939e8304955e610e35ec6fc066fcf2c4e541c478b92606922f2cd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "308"
      ]
    },
    {
      "uid": "zhcn:12ba56fb9965b92aa5feb0aa",
      "kind": "text_data",
      "source_text": "直白地说「可能性」的意思是？",
      "source_fingerprint": "5c8d358baa0d4d8c06be89c165b5e661fe75425d11148e4b531e0ba95395ee2e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "309"
      ]
    },
    {
      "uid": "zhcn:847d46c0d7b80ac6e3819038",
      "kind": "text_data",
      "source_text": "请说说对这次竞赛的期许！",
      "source_fingerprint": "1d4d011727fe6e9ec518eb7c37ad3207312c5d11b3f05d9f5c0841b06d342def",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "31"
      ]
    },
    {
      "uid": "zhcn:2de9317738bb2a345978002d",
      "kind": "text_data",
      "source_text": "有竞赛的必胜方法吗？",
      "source_fingerprint": "2f0ec8e6ba3eba88fcd85258e746cf3c543a170b784080cd7794f4382b63562b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "310"
      ]
    },
    {
      "uid": "zhcn:14c38490c768b31780fbd49a",
      "kind": "text_data",
      "source_text": "请告诉我们你有多少信心！",
      "source_fingerprint": "67c0566acc0b1baaec4166a4b09ab0476d2b538afdf2961a929d0d678d847706",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "311"
      ]
    },
    {
      "uid": "zhcn:c0b398e7e5c98332233ef709",
      "kind": "text_data",
      "source_text": "听说你其实是个很怕寂寞的人呢！",
      "source_fingerprint": "7a965e1a73af071cebf0cf000caddf3bea56c5966fec36ef6409e531d3d76086",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "312"
      ]
    },
    {
      "uid": "zhcn:f3808b6fc62156a6a22cb456",
      "kind": "text_data",
      "source_text": "请告诉大家你的特技。",
      "source_fingerprint": "c1cf90baf496effa99260d5909d99bd02318d3352b6f7391c421c35cef388552",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "313"
      ]
    },
    {
      "uid": "zhcn:ecbcdd7cac500989fe0b757c",
      "kind": "text_data",
      "source_text": "你最尊敬的人是？",
      "source_fingerprint": "e28f589618bf339bc9cb64783658ac2b0e1c0675dcdb891d484415fa2030631e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "314"
      ]
    },
    {
      "uid": "zhcn:836a750d3b9b27b124670587",
      "kind": "text_data",
      "source_text": "请告诉我们你的期许。",
      "source_fingerprint": "0fe094234e4ced51147152f86f3275dc47feccc8f20140ed2053e51ae119740d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "315"
      ]
    },
    {
      "uid": "zhcn:1eff2cd9f6955438cedfef98",
      "kind": "text_data",
      "source_text": "想放松的时候会做些什么事呢？",
      "source_fingerprint": "db20a3b831c683111e369edf90d9a94c11b4242de30c9557e869ad7645acc03a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "316"
      ]
    },
    {
      "uid": "zhcn:187c94e07bcc597313784ef7",
      "kind": "text_data",
      "source_text": "有令你担心的事情吗？",
      "source_fingerprint": "b696eb41d9fa586492d27d30f126fb4efecf6b0cbb1f969a1fc68e1d0f01f0c8",
      "source_path": "text_data_dict.json",
