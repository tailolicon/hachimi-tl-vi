      ]
    },
    {
      "uid": "zhcn:4440e3a51bc5604f59a11b72",
      "kind": "text_data",
      "source_text": "这次的竞赛，有令你感到不安的要素吗？",
      "source_fingerprint": "ab2e0363d1b0616fd641af78dd0e863d213e62d98f5f92ee99c243f3fd015654",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "51"
      ]
    },
    {
      "uid": "zhcn:1fb180e47efdadc01cc3cff6",
      "kind": "text_data",
      "source_text": "有什么在竞赛前一定会做的事情吗？",
      "source_fingerprint": "61029e3310f1f87abf12c6f08c982bc6b37604330617488ee2e2949a2af660ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "510"
      ]
    },
    {
      "uid": "zhcn:1d77948dc89021553c869a6f",
      "kind": "text_data",
      "source_text": "直白地说，有多少胜率呢？",
      "source_fingerprint": "6c874201800484dbbd0389ca2c311b248d4e7acfb4ed659b2ab5c5e68d2ec3cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "511"
      ]
    },
    {
      "uid": "zhcn:d3f4f87e41f63431a5c0cc15",
      "kind": "text_data",
      "source_text": "有什么作战策略吗？",
      "source_fingerprint": "3e83dfd15e2b94c319d89c327d18eb8a73bd63cebe1e9a73fa005bc92a419dae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "512"
      ]
    },
    {
      "uid": "zhcn:8dffe460f40eb0cb71b78165",
      "kind": "text_data",
      "source_text": "请对竞争对手们说句话。",
      "source_fingerprint": "7ad637da9854fa3aea1c0a9040f7ef18f4ac406dc62226aa4157cfae6c99ddc4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "513"
      ]
    },
    {
      "uid": "zhcn:b7b19e8c4e80d27f1471b305",
      "kind": "text_data",
      "source_text": "这场比赛我会为你加油！",
      "source_fingerprint": "92a19167c9a233b59c111a6b6e792af79585abe6fccf239bf839a53274b215ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "514"
      ]
    },
    {
      "uid": "zhcn:88ffe5c3b6744e2bb0f57aad",
      "kind": "text_data",
      "source_text": "听说你很擅长玩游戏？",
      "source_fingerprint": "339037674b1d83af451bfdbe4cd9d3abacaec54a1d99edc14f95cfe9d2518b20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "515"
      ]
    },
    {
      "uid": "zhcn:35efb08c6ff881cb5b8d3e51",
      "kind": "text_data",
      "source_text": "有强悍的秘诀吗？",
      "source_fingerprint": "e62ad319242c06e58272bafe42f23f8dc2db4f6f5a2dfbe6bb38bae2dc276c0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "516"
      ]
    },
    {
      "uid": "zhcn:dd48b64c6ed3f4f03351b531",
      "kind": "text_data",
      "source_text": "请说说你对今天竞赛的期许。",
      "source_fingerprint": "d36ce43be398fd985a798ae1287bfac63c1b992af32a26a9aa793cb7b91f1295",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "517"
      ]
    },
    {
      "uid": "zhcn:210ea40839d4c1bafeafa428",
      "kind": "text_data",
      "source_text": "听说你是跳级进入特雷森学园就读的？",
      "source_fingerprint": "8970f12dc2ba9ef2c85066b92e2f3ff28c1cb318e037d899b69dd6c7a6232bfa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "518"
      ]
    },
    {
      "uid": "zhcn:caedd862caa778396454c9aa",
      "kind": "text_data",
      "source_text": "擅长的料理是什么？",
      "source_fingerprint": "bfe692632ac63b38fa3d6c2f34092e1eed2147af327202c082420d3cae29d686",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "519"
      ]
    },
    {
      "uid": "zhcn:47053d1cc822c54cabd8b177",
      "kind": "text_data",
      "source_text": "有做什么事祈求好运吗？",
      "source_fingerprint": "4e37f432d02ff939eccdce4da382f034142b2754134b534240d3a8a167a5a8b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "52"
      ]
    },
    {
      "uid": "zhcn:76941071b3cadf4605dd6e83",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "520"
      ]
    },
    {
      "uid": "zhcn:728c966e17db001fcf87986c",
      "kind": "text_data",
      "source_text": "简单来说，竞赛的妙趣是！？",
      "source_fingerprint": "2ab02b88c8533f76d597c19df02b6e9dda30ea8b87451a461420899e4969649f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "521"
      ]
    },
    {
      "uid": "zhcn:d9de3a106a19dd4d64f53a73",
      "kind": "text_data",
      "source_text": "都做了些怎么样的特训呢？",
      "source_fingerprint": "15a329e535fe19cab12bfe1896d07ed624b509eeeca34fa90ac3649816456bf6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "522"
      ]
    },
    {
      "uid": "zhcn:e90f5994101d5f68112c2cb6",
      "kind": "text_data",
      "source_text": "请说说你的抱负！",
      "source_fingerprint": "7321329fe7053537673a27efce5d83991630f035a40f049626407139a041be58",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "523"
      ]
    },
    {
      "uid": "zhcn:de729d92fd2259e3c3f7c5ba",
      "kind": "text_data",
      "source_text": "听说你被称为魔鬼纠察队长，原因是？",
      "source_fingerprint": "da115032d343211c4773a2614fcac0704f8d9effefca336e8675d4b050a466c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "524"
      ]
    },
    {
      "uid": "zhcn:a98b161d7c835a7b0b80be64",
      "kind": "text_data",
      "source_text": "请告诉我们你尊敬的对象！",
      "source_fingerprint": "2841363d27d91818cab85659b522e2ca44345f5f819f49075cbc463293dfa3bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "525"
      ]
    },
    {
      "uid": "zhcn:d821ba9abdad111ca59ef9de",
      "kind": "text_data",
      "source_text": "意気込みをお願いします。",
      "source_fingerprint": "63c2ae9ca096e74b507a7747fd64aa2423e0b5670722295aa1121282e68b85ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "526"
      ]
    },
    {
      "uid": "zhcn:a0eafde63e0423e539fea931",
      "kind": "text_data",
      "source_text": "尊敬する人物を教えてください。",
      "source_fingerprint": "aad0c8a05e0026b3905ba528d8d2907b4043d8193d233cde9e10188bc92bb56a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "527"
      ]
    },
    {
      "uid": "zhcn:c8b22e77d447a2d95d404b98",
      "kind": "text_data",
      "source_text": "本日のレース、1着を取れそうですか？",
      "source_fingerprint": "6b065254fec691008e76dbd9a1401f8ec89ed82596a367b2156a33817d25cfe7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "528"
      ]
    },
    {
      "uid": "zhcn:54b070c0f1695ef1e0153981",
      "kind": "text_data",
      "source_text": "面对比赛是否已经准备周全了呢？",
      "source_fingerprint": "0a6b4bc9f27dcb3887c0069531795f09520e036769bee7e35e63b89a336c9995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "529"
      ]
    },
    {
      "uid": "zhcn:40c3726ff9dbe98c096807a2",
      "kind": "text_data",
      "source_text": "兼顾学生会与竞赛最让你感到辛苦的是？",
      "source_fingerprint": "342004631ee2aab7010600f120a9124cb1dc42ed6f86b0a08525b65e6fbbaf36",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "53"
      ]
    },
    {
      "uid": "zhcn:860d6540ac7a7acd0853ac38",
      "kind": "text_data",
      "source_text": "最近发现的美丽是？",
      "source_fingerprint": "cdd0f8a053c940ce847ea76a61f59da29dc9efad64b60ba56876c6409dcfb137",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "530"
      ]
    },
    {
      "uid": "zhcn:1e388cd9d88963b0da8243ab",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "531"
      ]
    },
    {
      "uid": "zhcn:034291ca6b2132296a8073d1",
      "kind": "text_data",
      "source_text": "有多少把握……不，有多少运气？",
      "source_fingerprint": "6afe40e0bd50f6dec30bd1e2d073b73d8b89eb98a44ad6145637605be5a4bf4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "532"
      ]
    },
    {
      "uid": "zhcn:24020bab750d92ea5329001d",
      "kind": "text_data",
      "source_text": "虽然很突然，可以请你帮我占卜一下吗？",
      "source_fingerprint": "66d245592203f602e5337fec7bb4d32d91b2c4037ac78631d7c1b00225ff8339",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "533"
      ]
    },
    {
      "uid": "zhcn:141d0d23fe252f88c53b60b4",
      "kind": "text_data",
      "source_text": "福气会降临吗？",
      "source_fingerprint": "5a05348f715b06713a5fa1bb2ef23e007c7ec9320bbb040768a514f440a398ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "534"
      ]
    },
    {
      "uid": "zhcn:6bc42fb75b0cebf37ec540f9",
      "kind": "text_data",
      "source_text": "请告诉我们你在比赛前的期许。",
      "source_fingerprint": "22d4ccfb0772d6fb67359d87bc1a0ba63e6d05f8de6ef734b1db43d11be67faa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "535"
      ]
    },
    {
      "uid": "zhcn:318c2d6af124da315e41d04f",
      "kind": "text_data",
      "source_text": "这场比赛有很多位强者喔？",
      "source_fingerprint": "84293ddf08d5a1e4586d900dc94ddc8cb16e1c50effcd19842aface040391f45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "536"
      ]
    },
    {
      "uid": "zhcn:1d58f2700e09b1399f4698df",
      "kind": "text_data",
      "source_text": "你看起来心情非常好，遇上什么好事了吗？",
      "source_fingerprint": "e15705a70c8e2ec129b061b064bca2c6814f5f67d0b2cde861807d66055ef60c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "537"
      ]
    }
  ]
