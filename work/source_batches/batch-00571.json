      "uid": "zhcn:2886f17378cd7361d0354f50",
      "kind": "text_data",
      "source_text": "有令你担心的事情吗？",
      "source_fingerprint": "b696eb41d9fa586492d27d30f126fb4efecf6b0cbb1f969a1fc68e1d0f01f0c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "500"
      ]
    },
    {
      "uid": "zhcn:babb37a29fd961451ae32268",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
