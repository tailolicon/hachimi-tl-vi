        "501"
      ]
    },
    {
      "uid": "zhcn:9e9758d21658e5e07bfad740",
      "kind": "text_data",
      "source_text": "状态怎么样呢？",
      "source_fingerprint": "381a9d3c904e27eeb92525cc32cb2f64c009c5d931d04d9277f43ebf4e658322",
      "source_path": "text_data_dict.json",
