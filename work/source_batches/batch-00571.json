{
  "schema_version": 1,
  "batch": 571,
  "batch_count": 1662,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "c0513553da490a692523f45b5f779f99f6cb7e34",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:115273961274a13056314cee",
      "kind": "text_data",
      "source_text": "本日のレース、1着を取れそうですか？",
      "source_fingerprint": "6b065254fec691008e76dbd9a1401f8ec89ed82596a367b2156a33817d25cfe7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "345"
      ]
    },
    {
      "uid": "zhcn:55e7878fa09ac32a0216e12b",
      "kind": "text_data",
      "source_text": "面对比赛是否已经准备周全了呢？",
      "source_fingerprint": "0a6b4bc9f27dcb3887c0069531795f09520e036769bee7e35e63b89a336c9995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "346"
      ]
    },
    {
      "uid": "zhcn:919e6d4d3e429dc011efa4f5",
      "kind": "text_data",
      "source_text": "最近发现的美丽是？",
      "source_fingerprint": "cdd0f8a053c940ce847ea76a61f59da29dc9efad64b60ba56876c6409dcfb137",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "347"
      ]
    },
    {
      "uid": "zhcn:adf84b0065a95dd5d346a772",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "348"
      ]
    },
    {
      "uid": "zhcn:4f299c4ed2c151497a752a1c",
      "kind": "text_data",
      "source_text": "有多少把握……不，有多少运气？",
      "source_fingerprint": "6afe40e0bd50f6dec30bd1e2d073b73d8b89eb98a44ad6145637605be5a4bf4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "349"
      ]
    },
    {
      "uid": "zhcn:4a1dd5ceb37a4fbc22d3ddb7",
      "kind": "text_data",
      "source_text": "最近有热衷于什么事情吗？",
      "source_fingerprint": "1a667983e52f68704f5b8d26950927364a2721d11fa64af4010f610aea76ea3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "35"
      ]
    },
    {
      "uid": "zhcn:cc1571568a2d94aac168d0ec",
      "kind": "text_data",
      "source_text": "虽然很突然，可以请你帮我占卜一下吗？",
      "source_fingerprint": "66d245592203f602e5337fec7bb4d32d91b2c4037ac78631d7c1b00225ff8339",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "350"
      ]
    },
    {
      "uid": "zhcn:b4c44f33515ca19647155221",
      "kind": "text_data",
      "source_text": "福气会降临吗？",
      "source_fingerprint": "5a05348f715b06713a5fa1bb2ef23e007c7ec9320bbb040768a514f440a398ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "351"
      ]
    },
    {
      "uid": "zhcn:5161221e15acdc5c40674a2c",
      "kind": "text_data",
      "source_text": "请告诉我们你在比赛前的期许。",
      "source_fingerprint": "22d4ccfb0772d6fb67359d87bc1a0ba63e6d05f8de6ef734b1db43d11be67faa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "352"
      ]
    },
    {
      "uid": "zhcn:745eac9c8143c0a6b4b748fc",
      "kind": "text_data",
      "source_text": "这场比赛有很多位强者喔？",
      "source_fingerprint": "84293ddf08d5a1e4586d900dc94ddc8cb16e1c50effcd19842aface040391f45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "353"
      ]
    },
    {
      "uid": "zhcn:0ab6c67878994da832613355",
      "kind": "text_data",
      "source_text": "你看起来心情非常好，遇上什么好事了吗？",
      "source_fingerprint": "e15705a70c8e2ec129b061b064bca2c6814f5f67d0b2cde861807d66055ef60c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "354"
      ]
    },
    {
      "uid": "zhcn:898a2959f1e0c698432b4c9e",
      "kind": "text_data",
      "source_text": "请说说抱负──呃，还好吗？你脸色有点……",
      "source_fingerprint": "371cff6facd734922f540fa772410d778e29c9a3305278dac5ec25bba66c0160",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "355"
      ]
    },
    {
      "uid": "zhcn:a059de50b46072b48178c991",
      "kind": "text_data",
      "source_text": "请告诉我们你当作目标的对象。",
      "source_fingerprint": "fcd065493ad700887062846739f4a5483cbdac9c49891ab6235c3a1967a486b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "356"
      ]
    },
    {
      "uid": "zhcn:6eef54dbd9f65afe1315a279",
      "kind": "text_data",
      "source_text": "简单来说，胜利的秘诀是！？",
      "source_fingerprint": "0ff3d96bbce3120a567d96bf3ae2ad18e24a9b575869dce9c246816b2b26a51a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "357"
      ]
    },
    {
      "uid": "zhcn:9146d7847a40787a03fbdf39",
      "kind": "text_data",
      "source_text": "好像有什么很香的味道？",
      "source_fingerprint": "f5ee03c12b1548c9f79f0fa872901f7196bf30d1940b29f6f57a35780306d842",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "358"
      ]
    },
    {
      "uid": "zhcn:9735c32d0bfa0dc6ebe57a4c",
      "kind": "text_data",
      "source_text": "家人是不是都会叫你「小多」之类的？",
      "source_fingerprint": "c63cc737a969b6b3f0399ef0351ba13cbe1b4c417a80178eb9a5462678658cff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "359"
      ]
    },
    {
      "uid": "zhcn:e8097a1b403624f337205aa7",
      "kind": "text_data",
      "source_text": "掌握胜利的诀窍是？",
      "source_fingerprint": "750b8d58e40b491d69fdda8ea53a30ec0b363512ff514dfca88582ef27c750fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "36"
      ]
    },
    {
      "uid": "zhcn:82ebd9ab6cd74944c5939e03",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "360"
      ]
    },
    {
      "uid": "zhcn:12670156d2bcac8878fc43c8",
      "kind": "text_data",
      "source_text": "听说你常看电视购物节目，最近有推荐的节目吗？",
      "source_fingerprint": "1a818539d5b589a03f412535c0ac4ed8234cc0c90cb9cfc9821ff8a4d40b6ae4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "361"
      ]
    },
    {
      "uid": "zhcn:dca86a2431d94b4789598cd2",
      "kind": "text_data",
      "source_text": "请用福冈腔说说抱负。",
      "source_fingerprint": "dfdd53bda620cc463cae579dd6ab0ad0d64b3035e07b8889cf54c07eb4802828",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "362"
      ]
    },
    {
      "uid": "zhcn:18d000326efe231d89f5e513",
      "kind": "text_data",
      "source_text": "期待你能拿出安定感非凡的表现纵横赛场！",
      "source_fingerprint": "07c3b87883ac1e9e7e574fc4e322c9c03474f31808e081bd173c05b4da82d687",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "363"
      ]
    },
    {
      "uid": "zhcn:7b5d936659d8de70fe112005",
      "kind": "text_data",
      "source_text": "针对竞赛做了多少跑步训练呢？",
      "source_fingerprint": "b9897adb7b91482892537c91de7ad8363625284939dae0181f2f9c2afd871622",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "364"
      ]
    },
    {
      "uid": "zhcn:57800eb3e5e12ec007a68086",
      "kind": "text_data",
      "source_text": "最近有遇到什么失误吗？",
      "source_fingerprint": "45bef4fc162d8dba4f1d45c120193a69c2d072eadbd0ee86be7228f3f7a2c397",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "365"
      ]
    },
    {
      "uid": "zhcn:e77ea5184c9eac2c43659849",
      "kind": "text_data",
      "source_text": "没有竞赛和训练的日子都怎么度过？",
      "source_fingerprint": "983491826807b4f382b0c40de8281498dea0c3870d05ec066c4325f8f0c6a58a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "366"
      ]
    },
    {
      "uid": "zhcn:3e6637fdb906addc8cb7bd5a",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话。",
      "source_fingerprint": "ae5a9a2f814783e93d18d5e700918a58315f57dbc941972f0d027258e78fcdb5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "367"
      ]
    },
    {
      "uid": "zhcn:68de0eca947c26f262f65fe9",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "368"
      ]
    },
    {
      "uid": "zhcn:bd14e8f62f8b948f668ae1e3",
      "kind": "text_data",
      "source_text": "请告诉我们这次的秘密策略！",
      "source_fingerprint": "683b41ef7e38ecc3e6b41ed3600d4c3df16e31fb1effa512773546e3ef826ce9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "369"
      ]
    },
    {
      "uid": "zhcn:3dadf3e0d0a6f43517ec2feb",
      "kind": "text_data",
      "source_text": "身为目白家的赛马娘，会觉得压力很沉重吗？",
      "source_fingerprint": "a97a50b744409e07df4a49edc7e65508d894b4b79830f4804172cd18c433dcf3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "37"
      ]
    },
    {
      "uid": "zhcn:5b11a8e58eff6008f1db936a",
      "kind": "text_data",
      "source_text": "除了跑步以外，还热衷于什么吗？",
      "source_fingerprint": "b2faf5a43dc845c86e2b79b45fe7225e2e97d5de76ade729384278f08fc5ba7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "370"
      ]
    },
    {
      "uid": "zhcn:d0cf31ec99937d8384801e28",
      "kind": "text_data",
      "source_text": "针对这次的比赛，做了多少跑步训练呢？",
      "source_fingerprint": "71efe3a174db6fdcdc77e43744c4d0eff341de844bb3f879b792a15850bcbc23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "371"
      ]
    },
    {
      "uid": "zhcn:b16482d1b31bbd3515c84907",
      "kind": "text_data",
      "source_text": "听见粉丝的声援，有什么感想吗？",
      "source_fingerprint": "118edecc7999f4ee934dedf2548120af5c92a723404dcf786a3d605cb0be3c5b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "372"
      ]
    },
    {
      "uid": "zhcn:ae937471e30b4d13050c7c85",
      "kind": "text_data",
      "source_text": "这场竞赛备受瞩目，你觉得有把握吗？",
      "source_fingerprint": "dc13f680cb3f6c07b475749d15867f0597d85e8021ea96aeebdec88b1e1d448a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "373"
      ]
    },
    {
      "uid": "zhcn:7293f87deaa8a075c3f5e546",
      "kind": "text_data",
      "source_text": "会展现帝王舞步给我们看吗？",
      "source_fingerprint": "fa17a0f135a537aec28eb9987affc25e8e3683b5dacc4494d779365837712280",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "374"
      ]
    },
    {
      "uid": "zhcn:a3214cca32fc6bfa6f28ffa3",
      "kind": "text_data",
      "source_text": "今天也有喝蜂蜜特饮吗？",
      "source_fingerprint": "a8e5b1c10fee84ec08aaa07655e9577a14cbbc1b2dd1bd3ffc464d28343b69a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "375"
      ]
    },
    {
      "uid": "zhcn:926ccd186bf77c2fdd2b6197",
      "kind": "text_data",
      "source_text": "透过每日训练有什么发现吗？",
      "source_fingerprint": "158508bde08f033576c576870118b298918084c06ffc9eb7c8238dd346e5190b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "376"
      ]
    },
    {
      "uid": "zhcn:cf391b82dc68d05fd23f659f",
      "kind": "text_data",
      "source_text": "可以用一句话来形容现在的状态吗？",
      "source_fingerprint": "d0af936a38636e00bea46c99770f515b89e07439a333d6ff46cf5e7d7298323f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "377"
      ]
    },
    {
      "uid": "zhcn:54e1412f4c5a51083ce7f3ac",
      "kind": "text_data",
      "source_text": "对你而言的最佳表现是？",
      "source_fingerprint": "27b312c3d3a527bb9c3bed477b62e3cb2f384f9ebcc23b7751c411e143dfbaf0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "378"
      ]
    },
    {
      "uid": "zhcn:1b9af5d0b648aec4c6de599b",
      "kind": "text_data",
      "source_text": "最近栗东宿舍有发生什么事情吗？",
      "source_fingerprint": "161965b5705fb960791b878b18957117ac4dc6bb40e808fce17b5458f5e352fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "379"
      ]
    },
    {
      "uid": "zhcn:bb604ca818693cde0fc270f2",
      "kind": "text_data",
      "source_text": "竞赛时什么事情最重要？",
      "source_fingerprint": "01995ff79ab47d1424696b2b834325bc04124c8490d059765adf949cc05a8e81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "38"
      ]
    },
    {
      "uid": "zhcn:2df39c7f10e6534912e0a8bd",
      "kind": "text_data",
      "source_text": "请对今天的竞赛发表一句感言！",
      "source_fingerprint": "232f0f49f76568f53c3c7c30f3eae9ce999dfbe7dfd0cbfd262e581346d0ac7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "380"
      ]
    },
    {
      "uid": "zhcn:5f6dd57312c00cd4a21462d7",
      "kind": "text_data",
      "source_text": "最近有感兴趣的舞台表演吗？",
      "source_fingerprint": "2f780eb604edad57f68ef06075b091a29131a47b8aaa9c90d3751106b0e43998",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "381"
      ]
    },
    {
      "uid": "zhcn:cca7ae9ba97dd40c3646f518",
      "kind": "text_data",
      "source_text": "请告诉大家你平常会特别留心的事情。",
      "source_fingerprint": "05d235a7f932dba4bf206f15546842044785e90d5f24fb543cc62fc3d61f8648",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "382"
      ]
    },
    {
      "uid": "zhcn:e8a81b25add3f2df84f27de3",
      "kind": "text_data",
      "source_text": "曾因为环境改变而感到困扰吗？",
      "source_fingerprint": "7ab387f2dd86b90c0c5dcc31fcaa8b2168cc3edccbe838f890c9e9ebb58a7d75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "383"
      ]
    },
    {
      "uid": "zhcn:ae719afebeacd280a178b676",
      "kind": "text_data",
      "source_text": "竞赛获胜后，最想先做什么事？",
      "source_fingerprint": "d5787b942deaeba8c22d4b163986d529c5d8e8c784bc3748175ebab6335032f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "384"
      ]
    },
    {
      "uid": "zhcn:8bc0002b00ba6807a57ec170",
      "kind": "text_data",
      "source_text": "请对家人说几句话。",
      "source_fingerprint": "678a22e5b71e394baf9c25302c8dcdb80d2283754d77232844d65ded34767b06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "385"
      ]
    },
    {
      "uid": "zhcn:affec439826bee55b7f801ed",
      "kind": "text_data",
      "source_text": "竞赛前有一定会做的例行公事吗？",
      "source_fingerprint": "b8d979824f772e97a57ea17e4d58d77a71626c7fd9d74b702d60a3ae4b45b24e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "386"
      ]
    },
    {
      "uid": "zhcn:f817058e8e956c16f791778e",
      "kind": "text_data",
      "source_text": "觉得最辛苦的训练是什么？",
      "source_fingerprint": "71bc033852587690846b8662d86cbfac3c299beeeb9fd773b53a23a0123e3eff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "387"
      ]
    },
    {
      "uid": "zhcn:8e30ff825c01f602fc9b6a7c",
      "kind": "text_data",
      "source_text": "很期待你这次也能有帅气的表现！",
      "source_fingerprint": "c74c2a174c55a1192841eaf1366711a89e7f6cc4697118db208c82a66ede4fcb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "388"
      ]
    },
    {
      "uid": "zhcn:b7873ad167e02e661f795fef",
      "kind": "text_data",
      "source_text": "视这场竞赛的结果，也有可能前往国外挑战？",
      "source_fingerprint": "e7194d36e5bd298cdb31c7b6884451feb8ec4d482354090040a50a1956195519",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "389"
      ]
    },
    {
