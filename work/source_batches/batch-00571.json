      "source_fingerprint": "e28f589618bf339bc9cb64783658ac2b0e1c0675dcdb891d484415fa2030631e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "497"
      ]
    },
    {
      "uid": "zhcn:34ce3e020c5dab920c6da58b",
      "kind": "text_data",
      "source_text": "请告诉我们你的期许。",
      "source_fingerprint": "0fe094234e4ced51147152f86f3275dc47feccc8f20140ed2053e51ae119740d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "498"
      ]
    },
    {
      "uid": "zhcn:e663f955426370e78e9e8757",
      "kind": "text_data",
      "source_text": "想放松的时候会做些什么事呢？",
