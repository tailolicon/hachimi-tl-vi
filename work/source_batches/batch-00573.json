      "uid": "zhcn:63d3af98d8b580629db1b497",
      "kind": "text_data",
      "source_text": "可以表演魔术给我们看吗？",
      "source_fingerprint": "8012d9d6b71f6530db43efc0ec4ea77fce7ce39ee675065101eca9e94dc60024",
