      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "552"
      ]
    },
    {
      "uid": "zhcn:434c94d9eb5e3f5048f9a5fc",
      "kind": "text_data",
      "source_text": "竞赛获胜的话会想要怎么样的奖励呢？",
