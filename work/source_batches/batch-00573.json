      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "551"
      ]
    },
    {
      "uid": "zhcn:e00dc3260a7cba10031ab13b",
      "kind": "text_data",
      "source_text": "在跑步这件事上有什么原则吗？",
