      "uid": "zhcn:7bf7a596d619b96a88df777f",
      "kind": "text_data",
      "source_text": "長めの湯で身を清め、オイルケアを。\\n身体の隅々まで――レースで艶めくまで。",
      "source_fingerprint": "5381a0f4e06212c78aa93032787c68b4829acb6694e61242a0a5b13eef31b677",
      "source_path": "text_data_dict.json",
