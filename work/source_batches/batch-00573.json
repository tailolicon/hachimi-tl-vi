  "entries": [
    {
      "uid": "zhcn:de5a33ad6ae27b29a1f0f3b4",
      "kind": "text_data",
      "source_text": "请以学生会长的身份对学园的大家说句话！",
      "source_fingerprint": "4b08f40d03e9fce9e2578080460aac2543759f7fb381016a6cbc5f1797327186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "49"
      ]
    },
    {
      "uid": "zhcn:96c1f2eafd15f1c0cacad962",
      "kind": "text_data",
      "source_text": "有什么实力坚强的祕诀吗？",
      "source_fingerprint": "1998aff469caad818d10739dbd5b1ed2e6af4bf50a928b33b28a57c499c5f0fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "490"
      ]
    },
    {
      "uid": "zhcn:317a7632b06e8b829a7d3f5d",
      "kind": "text_data",
      "source_text": "意思是你最近热衷于打工吗？",
      "source_fingerprint": "c7579218a2939e8304955e610e35ec6fc066fcf2c4e541c478b92606922f2cd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "491"
      ]
    },
    {
      "uid": "zhcn:95ec2db6d35d26614f21161e",
      "kind": "text_data",
      "source_text": "直白地说「可能性」的意思是？",
      "source_fingerprint": "5c8d358baa0d4d8c06be89c165b5e661fe75425d11148e4b531e0ba95395ee2e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "492"
      ]
    },
    {
      "uid": "zhcn:3e9335d4af8836b55140c02f",
      "kind": "text_data",
      "source_text": "有竞赛的必胜方法吗？",
      "source_fingerprint": "2f0ec8e6ba3eba88fcd85258e746cf3c543a170b784080cd7794f4382b63562b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "493"
      ]
    },
    {
      "uid": "zhcn:557e4ab2a46b28a697032fcc",
      "kind": "text_data",
      "source_text": "请告诉我们你有多少信心！",
      "source_fingerprint": "67c0566acc0b1baaec4166a4b09ab0476d2b538afdf2961a929d0d678d847706",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "494"
      ]
    },
    {
      "uid": "zhcn:a826b79fafd5171d9fac9d31",
      "kind": "text_data",
      "source_text": "听说你其实是个很怕寂寞的人呢！",
      "source_fingerprint": "7a965e1a73af071cebf0cf000caddf3bea56c5966fec36ef6409e531d3d76086",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "495"
      ]
    },
    {
      "uid": "zhcn:7d212635658d31059bb04990",
      "kind": "text_data",
      "source_text": "请告诉大家你的特技。",
      "source_fingerprint": "c1cf90baf496effa99260d5909d99bd02318d3352b6f7391c421c35cef388552",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "496"
      ]
    },
    {
      "uid": "zhcn:6fb7cf8a83d7d88a8d1375aa",
      "kind": "text_data",
      "source_text": "你最尊敬的人是？",
      "source_fingerprint": "e28f589618bf339bc9cb64783658ac2b0e1c0675dcdb891d484415fa2030631e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "497"
      ]
    },
    {
      "uid": "zhcn:34ce3e020c5dab920c6da58b",
      "kind": "text_data",
      "source_text": "请告诉我们你的期许。",
      "source_fingerprint": "0fe094234e4ced51147152f86f3275dc47feccc8f20140ed2053e51ae119740d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "498"
      ]
    },
    {
      "uid": "zhcn:e663f955426370e78e9e8757",
      "kind": "text_data",
      "source_text": "想放松的时候会做些什么事呢？",
      "source_fingerprint": "db20a3b831c683111e369edf90d9a94c11b4242de30c9557e869ad7645acc03a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "499"
      ]
    },
    {
      "uid": "zhcn:be5117344f95a3f40c77e2e9",
      "kind": "text_data",
      "source_text": "针对这次的比赛，做了多少跑步训练呢？",
      "source_fingerprint": "71efe3a174db6fdcdc77e43744c4d0eff341de844bb3f879b792a15850bcbc23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "5"
      ]
    },
    {
      "uid": "zhcn:63fdae2757eb967b88e9a590",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "50"
      ]
    },
    {
      "uid": "zhcn:2886f17378cd7361d0354f50",
      "kind": "text_data",
      "source_text": "有令你担心的事情吗？",
      "source_fingerprint": "b696eb41d9fa586492d27d30f126fb4efecf6b0cbb1f969a1fc68e1d0f01f0c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "500"
      ]
    },
    {
      "uid": "zhcn:babb37a29fd961451ae32268",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "501"
      ]
    },
    {
      "uid": "zhcn:9e9758d21658e5e07bfad740",
      "kind": "text_data",
      "source_text": "状态怎么样呢？",
      "source_fingerprint": "381a9d3c904e27eeb92525cc32cb2f64c009c5d931d04d9277f43ebf4e658322",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "502"
      ]
    },
    {
      "uid": "zhcn:95e48e297b68724afee3bef1",
      "kind": "text_data",
      "source_text": "竞赛前有什么推荐的放松方法？",
      "source_fingerprint": "05a51be5346e7db4b9042ff61227b5d1197a3e825838c89d80da604eccf95995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "503"
      ]
    },
    {
      "uid": "zhcn:f275dce91e51fc8a08f61ba3",
      "kind": "text_data",
      "source_text": "今天早上吃了什么呢？",
      "source_fingerprint": "556c081ab48e581c64ee3a0fc6166399bcaee72c21d70014f723d1eba3334951",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "504"
      ]
    },
    {
      "uid": "zhcn:71ea1590b9736d3df70b683b",
      "kind": "text_data",
      "source_text": "请告诉我们你的期许！",
      "source_fingerprint": "62afe0c7bbf3ab142f57366595e60b9db99da41a122cb10cbb7313ffd7777cd6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "505"
      ]
    },
    {
      "uid": "zhcn:9dc2dd5a07016905cf29293f",
      "kind": "text_data",
      "source_text": "听说你很喜欢阅读。",
      "source_fingerprint": "c1652e5ea05c3c5afe3cf6799b663d4c7f19c9a4da5b6a76517cc06157a7726a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "506"
      ]
    },
    {
      "uid": "zhcn:9f73e2acf2ccea9f73607c50",
      "kind": "text_data",
      "source_text": "最喜欢的故事是什么呢？",
      "source_fingerprint": "45cf7984ad68447976930ec54ce461f519ceee2abf33d28889454b1b2a79fa10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "507"
      ]
    },
    {
      "uid": "zhcn:1fffb34ec48e2b792aeb8d65",
      "kind": "text_data",
      "source_text": "请谈谈你的抱负。",
      "source_fingerprint": "6cb3e5be35ae8bed9c53d3d96222212a95919bb80ceed9b04dcb7c89992b4d10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "508"
      ]
    },
    {
      "uid": "zhcn:f28f984abf2934304d83e383",
      "kind": "text_data",
      "source_text": "你总是会很认真地保养指甲呢。",
      "source_fingerprint": "00a47ff8b8a4e4feaaf243589a5f51cf0ebf565cbb9690526dddca97758b4818",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "509"
      ]
    },
    {
      "uid": "zhcn:4440e3a51bc5604f59a11b72",
      "kind": "text_data",
      "source_text": "这次的竞赛，有令你感到不安的要素吗？",
      "source_fingerprint": "ab2e0363d1b0616fd641af78dd0e863d213e62d98f5f92ee99c243f3fd015654",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "51"
      ]
    },
    {
      "uid": "zhcn:1fb180e47efdadc01cc3cff6",
      "kind": "text_data",
      "source_text": "有什么在竞赛前一定会做的事情吗？",
      "source_fingerprint": "61029e3310f1f87abf12c6f08c982bc6b37604330617488ee2e2949a2af660ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "510"
      ]
    },
    {
      "uid": "zhcn:1d77948dc89021553c869a6f",
      "kind": "text_data",
      "source_text": "直白地说，有多少胜率呢？",
      "source_fingerprint": "6c874201800484dbbd0389ca2c311b248d4e7acfb4ed659b2ab5c5e68d2ec3cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "511"
      ]
    },
    {
      "uid": "zhcn:d3f4f87e41f63431a5c0cc15",
      "kind": "text_data",
      "source_text": "有什么作战策略吗？",
      "source_fingerprint": "3e83dfd15e2b94c319d89c327d18eb8a73bd63cebe1e9a73fa005bc92a419dae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "512"
      ]
    },
    {
      "uid": "zhcn:8dffe460f40eb0cb71b78165",
      "kind": "text_data",
      "source_text": "请对竞争对手们说句话。",
      "source_fingerprint": "7ad637da9854fa3aea1c0a9040f7ef18f4ac406dc62226aa4157cfae6c99ddc4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "513"
      ]
    },
    {
      "uid": "zhcn:b7b19e8c4e80d27f1471b305",
      "kind": "text_data",
      "source_text": "这场比赛我会为你加油！",
      "source_fingerprint": "92a19167c9a233b59c111a6b6e792af79585abe6fccf239bf839a53274b215ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "514"
      ]
    },
    {
      "uid": "zhcn:88ffe5c3b6744e2bb0f57aad",
      "kind": "text_data",
      "source_text": "听说你很擅长玩游戏？",
      "source_fingerprint": "339037674b1d83af451bfdbe4cd9d3abacaec54a1d99edc14f95cfe9d2518b20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "515"
      ]
    },
    {
      "uid": "zhcn:35efb08c6ff881cb5b8d3e51",
      "kind": "text_data",
      "source_text": "有强悍的秘诀吗？",
      "source_fingerprint": "e62ad319242c06e58272bafe42f23f8dc2db4f6f5a2dfbe6bb38bae2dc276c0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "516"
      ]
    },
    {
      "uid": "zhcn:dd48b64c6ed3f4f03351b531",
      "kind": "text_data",
      "source_text": "请说说你对今天竞赛的期许。",
      "source_fingerprint": "d36ce43be398fd985a798ae1287bfac63c1b992af32a26a9aa793cb7b91f1295",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "517"
      ]
    },
    {
      "uid": "zhcn:210ea40839d4c1bafeafa428",
      "kind": "text_data",
      "source_text": "听说你是跳级进入特雷森学园就读的？",
      "source_fingerprint": "8970f12dc2ba9ef2c85066b92e2f3ff28c1cb318e037d899b69dd6c7a6232bfa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "518"
      ]
    },
    {
      "uid": "zhcn:caedd862caa778396454c9aa",
      "kind": "text_data",
      "source_text": "擅长的料理是什么？",
      "source_fingerprint": "bfe692632ac63b38fa3d6c2f34092e1eed2147af327202c082420d3cae29d686",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "519"
      ]
    },
    {
      "uid": "zhcn:47053d1cc822c54cabd8b177",
      "kind": "text_data",
      "source_text": "有做什么事祈求好运吗？",
      "source_fingerprint": "4e37f432d02ff939eccdce4da382f034142b2754134b534240d3a8a167a5a8b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "52"
      ]
    },
    {
      "uid": "zhcn:76941071b3cadf4605dd6e83",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "520"
      ]
    },
    {
      "uid": "zhcn:728c966e17db001fcf87986c",
      "kind": "text_data",
      "source_text": "简单来说，竞赛的妙趣是！？",
      "source_fingerprint": "2ab02b88c8533f76d597c19df02b6e9dda30ea8b87451a461420899e4969649f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "521"
      ]
    },
    {
      "uid": "zhcn:d9de3a106a19dd4d64f53a73",
      "kind": "text_data",
      "source_text": "都做了些怎么样的特训呢？",
      "source_fingerprint": "15a329e535fe19cab12bfe1896d07ed624b509eeeca34fa90ac3649816456bf6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "522"
      ]
    },
    {
      "uid": "zhcn:e90f5994101d5f68112c2cb6",
      "kind": "text_data",
      "source_text": "请说说你的抱负！",
      "source_fingerprint": "7321329fe7053537673a27efce5d83991630f035a40f049626407139a041be58",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "523"
      ]
    },
    {
      "uid": "zhcn:de729d92fd2259e3c3f7c5ba",
      "kind": "text_data",
      "source_text": "听说你被称为魔鬼纠察队长，原因是？",
      "source_fingerprint": "da115032d343211c4773a2614fcac0704f8d9effefca336e8675d4b050a466c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "524"
      ]
    },
    {
      "uid": "zhcn:a98b161d7c835a7b0b80be64",
      "kind": "text_data",
      "source_text": "请告诉我们你尊敬的对象！",
      "source_fingerprint": "2841363d27d91818cab85659b522e2ca44345f5f819f49075cbc463293dfa3bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "525"
      ]
    },
    {
      "uid": "zhcn:d821ba9abdad111ca59ef9de",
      "kind": "text_data",
      "source_text": "意気込みをお願いします。",
      "source_fingerprint": "63c2ae9ca096e74b507a7747fd64aa2423e0b5670722295aa1121282e68b85ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "526"
      ]
    },
    {
      "uid": "zhcn:a0eafde63e0423e539fea931",
      "kind": "text_data",
      "source_text": "尊敬する人物を教えてください。",
      "source_fingerprint": "aad0c8a05e0026b3905ba528d8d2907b4043d8193d233cde9e10188bc92bb56a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "527"
      ]
    },
    {
      "uid": "zhcn:c8b22e77d447a2d95d404b98",
      "kind": "text_data",
      "source_text": "本日のレース、1着を取れそうですか？",
      "source_fingerprint": "6b065254fec691008e76dbd9a1401f8ec89ed82596a367b2156a33817d25cfe7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "528"
      ]
    },
    {
      "uid": "zhcn:54b070c0f1695ef1e0153981",
      "kind": "text_data",
      "source_text": "面对比赛是否已经准备周全了呢？",
      "source_fingerprint": "0a6b4bc9f27dcb3887c0069531795f09520e036769bee7e35e63b89a336c9995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "529"
      ]
    },
    {
      "uid": "zhcn:40c3726ff9dbe98c096807a2",
      "kind": "text_data",
      "source_text": "兼顾学生会与竞赛最让你感到辛苦的是？",
      "source_fingerprint": "342004631ee2aab7010600f120a9124cb1dc42ed6f86b0a08525b65e6fbbaf36",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "53"
      ]
    },
    {
      "uid": "zhcn:860d6540ac7a7acd0853ac38",
      "kind": "text_data",
      "source_text": "最近发现的美丽是？",
      "source_fingerprint": "cdd0f8a053c940ce847ea76a61f59da29dc9efad64b60ba56876c6409dcfb137",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "530"
      ]
    },
    {
      "uid": "zhcn:1e388cd9d88963b0da8243ab",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "531"
      ]
    },
    {
      "uid": "zhcn:034291ca6b2132296a8073d1",
      "kind": "text_data",
      "source_text": "有多少把握……不，有多少运气？",
      "source_fingerprint": "6afe40e0bd50f6dec30bd1e2d073b73d8b89eb98a44ad6145637605be5a4bf4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "532"
      ]
    },
    {
      "uid": "zhcn:24020bab750d92ea5329001d",
      "kind": "text_data",
      "source_text": "虽然很突然，可以请你帮我占卜一下吗？",
      "source_fingerprint": "66d245592203f602e5337fec7bb4d32d91b2c4037ac78631d7c1b00225ff8339",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "533"
      ]
    },
    {
      "uid": "zhcn:141d0d23fe252f88c53b60b4",
      "kind": "text_data",
      "source_text": "福气会降临吗？",
      "source_fingerprint": "5a05348f715b06713a5fa1bb2ef23e007c7ec9320bbb040768a514f440a398ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "534"
      ]
    },
    {
      "uid": "zhcn:6bc42fb75b0cebf37ec540f9",
      "kind": "text_data",
      "source_text": "请告诉我们你在比赛前的期许。",
      "source_fingerprint": "22d4ccfb0772d6fb67359d87bc1a0ba63e6d05f8de6ef734b1db43d11be67faa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "535"
      ]
    },
    {
      "uid": "zhcn:318c2d6af124da315e41d04f",
      "kind": "text_data",
      "source_text": "这场比赛有很多位强者喔？",
      "source_fingerprint": "84293ddf08d5a1e4586d900dc94ddc8cb16e1c50effcd19842aface040391f45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "536"
      ]
    },
    {
      "uid": "zhcn:1d58f2700e09b1399f4698df",
      "kind": "text_data",
      "source_text": "你看起来心情非常好，遇上什么好事了吗？",
      "source_fingerprint": "e15705a70c8e2ec129b061b064bca2c6814f5f67d0b2cde861807d66055ef60c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "537"
      ]
    },
    {
      "uid": "zhcn:bc6c4cecde12e6b2bb0b1684",
      "kind": "text_data",
      "source_text": "请说说抱负──呃，还好吗？你脸色有点……",
      "source_fingerprint": "371cff6facd734922f540fa772410d778e29c9a3305278dac5ec25bba66c0160",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "538"
      ]
    },
    {
      "uid": "zhcn:c7a142d2598ff527828577b5",
      "kind": "text_data",
      "source_text": "请告诉我们你当作目标的对象。",
      "source_fingerprint": "fcd065493ad700887062846739f4a5483cbdac9c49891ab6235c3a1967a486b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "539"
      ]
    },
    {
      "uid": "zhcn:13a149cd48bee9aa4e7fe92a",
      "kind": "text_data",
      "source_text": "请告诉我们不会紧张的诀窍。",
      "source_fingerprint": "59732d13f75b8d0e7fc6f69c9885498df4f4e48c077afad712c87913d5ea4185",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "54"
      ]
    },
    {
      "uid": "zhcn:95ee9647dbf5078f0d690ab4",
      "kind": "text_data",
      "source_text": "简单来说，胜利的秘诀是！？",
      "source_fingerprint": "0ff3d96bbce3120a567d96bf3ae2ad18e24a9b575869dce9c246816b2b26a51a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "540"
      ]
    },
    {
      "uid": "zhcn:3a62d10f97ade0c660a80b56",
      "kind": "text_data",
      "source_text": "好像有什么很香的味道？",
      "source_fingerprint": "f5ee03c12b1548c9f79f0fa872901f7196bf30d1940b29f6f57a35780306d842",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "541"
      ]
    },
    {
      "uid": "zhcn:d448ef5e71093dbab2246826",
      "kind": "text_data",
      "source_text": "家人是不是都会叫你「小多」之类的？",
      "source_fingerprint": "c63cc737a969b6b3f0399ef0351ba13cbe1b4c417a80178eb9a5462678658cff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "542"
      ]
    },
    {
      "uid": "zhcn:13a1fad427f0727bbbb51a50",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "543"
      ]
    },
    {
      "uid": "zhcn:c7f5cc27cf1a113f27dc0407",
      "kind": "text_data",
      "source_text": "听说你常看电视购物节目，最近有推荐的节目吗？",
      "source_fingerprint": "1a818539d5b589a03f412535c0ac4ed8234cc0c90cb9cfc9821ff8a4d40b6ae4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "544"
      ]
    },
    {
      "uid": "zhcn:c1057f7c551d8cfe26968ac7",
      "kind": "text_data",
      "source_text": "请用福冈腔说说抱负。",
      "source_fingerprint": "dfdd53bda620cc463cae579dd6ab0ad0d64b3035e07b8889cf54c07eb4802828",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "545"
      ]
    },
    {
      "uid": "zhcn:9dc118e76b0e70051eec2d4b",
      "kind": "text_data",
      "source_text": "期待你能拿出安定感非凡的表现纵横赛场！",
      "source_fingerprint": "07c3b87883ac1e9e7e574fc4e322c9c03474f31808e081bd173c05b4da82d687",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "546"
      ]
    },
    {
      "uid": "zhcn:d02b4c5b45dd376026657369",
      "kind": "text_data",
      "source_text": "针对竞赛做了多少跑步训练呢？",
