  "entries": [
    {
      "uid": "zhcn:72c56b186a0253dd2f353bf0",
      "kind": "text_data",
      "source_text": "请对在故乡守护你的大家说句话！",
      "source_fingerprint": "7e4b7db7bed10fc92201e1ab1494bac8c3e81a3e784e68b0ebda93c298fe5a04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "561"
      ]
    },
    {
      "uid": "zhcn:bd955729289d16cda0930b13",
      "kind": "text_data",
      "source_text": "决赛在即，有什么担心的事情吗？",
      "source_fingerprint": "d9d8cb4e45baa117eba49f3a1d38cd753c848cb1e7713a1437ed89a4bfd92119",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "562"
      ]
    },
    {
      "uid": "zhcn:fd80add49efb273fc1253401",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "563"
      ]
    },
    {
      "uid": "zhcn:64cf5282cda4b22503ecbd2a",
      "kind": "text_data",
      "source_text": "会想替自己取什么别称？",
      "source_fingerprint": "d83f8284013a7e138db061a69256481cae624fc62b075e1b8c8b9cf78c827fe2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "564"
      ]
    },
    {
      "uid": "zhcn:496d13ea778507c76fedf785",
      "kind": "text_data",
      "source_text": "请问目前状态大概达到百分之几呢？",
      "source_fingerprint": "ec6a9bf23e285a06e9382c4de63f3cfe742d2c10c0be1edb7d9febbf84df85ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "565"
      ]
    },
    {
      "uid": "zhcn:a9611363d0707eb4dc497da9",
      "kind": "text_data",
      "source_text": "决赛有令你感到不安的地方吗？",
      "source_fingerprint": "296055d77ce0f5606ca0e5e289ebbcc034f091d4bef086429954f8a02b995487",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "566"
      ]
    },
    {
      "uid": "zhcn:3ed3bfd9d6ca8cf96b1cdfed",
      "kind": "text_data",
      "source_text": "各方皆预期会是场激战，请问你的心境是？",
      "source_fingerprint": "649a52eb745efcd728402fc74adda338ace6a1fb0360566061b3ecf010590b8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "567"
      ]
    },
    {
      "uid": "zhcn:12a1ffefcc67c4c3af8598fc",
      "kind": "text_data",
      "source_text": "在决赛中会让我们见识到怎么样的表现呢？",
      "source_fingerprint": "eb9f7adc4539303ee1d4688547461581016dbc599b6dcf378c343eb89c78ccb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "568"
      ]
    },
    {
      "uid": "zhcn:afeddc463895181afe3b9b18",
      "kind": "text_data",
      "source_text": "请对位于美国的双亲说些话！",
      "source_fingerprint": "7f973e65242045cd8579052c9e4e3e6f86ceb11d66d24f6d20d632945cdfc60b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "569"
      ]
    },
    {
      "uid": "zhcn:dcfb11cd4be257269793b14e",
      "kind": "text_data",
      "source_text": "你觉得获得胜利的关键是什么？",
      "source_fingerprint": "ab6f0f6923974db5a4ee56377b83affcaa6889a878fe6abbf9aed76532e60449",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "57"
      ]
    },
    {
      "uid": "zhcn:b68a37ff72d64911258278d0",
      "kind": "text_data",
      "source_text": "本次的竞赛，会是高手云集吗？",
      "source_fingerprint": "70fa1115ea526e0c1b0ade626b106dc064ad27604cca9ca6ef1270eea54766a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "570"
      ]
    },
    {
      "uid": "zhcn:4df3c09779a1fb8b31a6010d",
      "kind": "text_data",
      "source_text": "就快到决赛了，状况如何？",
      "source_fingerprint": "9630e42d5c9d012871840bbd197b921fb58e1c9b32eae3a940fe02875fb56c78",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "571"
      ]
    },
    {
      "uid": "zhcn:630865b9e08d6728f5727799",
      "kind": "text_data",
      "source_text": "会觉得紧张吗？",
      "source_fingerprint": "3b6efe49e3ea4e77f0d196cc0d23da9389f3adb0d159bc4709603985686340a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "572"
      ]
    },
    {
      "uid": "zhcn:6e9cd563ba935064e070ead6",
      "kind": "text_data",
      "source_text": "请说句对竞赛的期许！",
      "source_fingerprint": "7f20d393858cbc5eaf3229ddae5ded6b3983386e8bee9612434b8571a9f807ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "573"
      ]
    },
    {
      "uid": "zhcn:2685edab6bd32838f7a59ee4",
      "kind": "text_data",
      "source_text": "终于要到决赛了！请问有必胜策略吗？",
      "source_fingerprint": "d88104f794712b75f5301f13765d21a1cb814effaf45543f4e29abe49d104949",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "574"
      ]
    },
    {
      "uid": "zhcn:bc59a743520c69b0d63ec40e",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "575"
      ]
    },
    {
      "uid": "zhcn:3758a6fdd1fd4e8396c82132",
      "kind": "text_data",
      "source_text": "请问对这场竞赛有多少把握？",
      "source_fingerprint": "e5bc11f0dbcf1ecd3bc3a8206ce1465a8786d2069e0f2f3f80dd7a024eb69b64",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "576"
      ]
    },
    {
      "uid": "zhcn:8f793ab13900b2f723f7ff41",
      "kind": "text_data",
      "source_text": "若获得优胜，会希望能被谁夸奖呢？",
      "source_fingerprint": "33902c5d31bd104559882c827e0a337896169cdddd2a9b5da5b1d24befe64325",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "577"
      ]
    },
    {
      "uid": "zhcn:74e163c9f7af061a03eac390",
      "kind": "text_data",
      "source_text": "希望我们在决赛中关注哪些地方呢？",
      "source_fingerprint": "34bf4fd0809bc18a88085e3ca03a4c1277d3b54932d57ff9c62b874dd802e403",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "578"
      ]
    },
    {
      "uid": "zhcn:23454786ce371acd56180bdc",
      "kind": "text_data",
      "source_text": "想将这场竞赛献给谁呢？",
      "source_fingerprint": "86be9faeb2b005f617dce7428e8052aa038e18c42e014000b3a0095e3d44de85",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "579"
      ]
    },
    {
      "uid": "zhcn:087fdd3ca036da40f8fe22e1",
      "kind": "text_data",
      "source_text": "最近的钓鱼成果如何？",
      "source_fingerprint": "b0cd6ded6970e05862f031de7fb4e1298f395bd3ab1ec4fbc5129af2ec8bb9fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "58"
      ]
    },
    {
      "uid": "zhcn:a63a4253867708edc05181ad",
      "kind": "text_data",
      "source_text": "请说说你的抱负。",
      "source_fingerprint": "39601c88c7f0b1062a6de868e1b1bb79ab3c212b14ba3f73f03b23e5508cdd0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "580"
      ]
    },
    {
      "uid": "zhcn:c002ab19ff21fe456a255d6b",
      "kind": "text_data",
      "source_text": "听说你很喜欢开场小号？",
      "source_fingerprint": "e7bd10b5dac4cf61114a97b92d19812bb0aa5a582bbf4fbefa113560f5a8f770",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "581"
      ]
    },
    {
      "uid": "zhcn:d07564376d18746140109671",
      "kind": "text_data",
      "source_text": "面对盛大的舞台，现在是什么心情？",
      "source_fingerprint": "83b7d853f8be0efb4986cf122f53ab2d0f43c8b3fb13734a64f7ed98e4e89cce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "582"
      ]
    },
    {
      "uid": "zhcn:31094f271c70af5b851f3204",
      "kind": "text_data",
      "source_text": "决赛之战有什么秘密策略吗？",
      "source_fingerprint": "5177656b54c000c3523e5c44edeaa65707f661f2b04c1802f6a5e2a5f9516912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "583"
      ]
    },
    {
      "uid": "zhcn:bccd4e8b4ec9786d952fe8a1",
      "kind": "text_data",
      "source_text": "决赛之战有什么秘密策略吗？",
      "source_fingerprint": "5177656b54c000c3523e5c44edeaa65707f661f2b04c1802f6a5e2a5f9516912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "584"
      ]
    },
    {
      "uid": "zhcn:0a5cff0ce29219747be86348",
      "kind": "text_data",
      "source_text": "请对支持你的家人说句话！",
      "source_fingerprint": "c32438522fb770add8dfde2d8c39210783febf99e5b3e67a28982999ade2fe38",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "585"
      ]
    },
    {
      "uid": "zhcn:81813eeb1452e0a50e9a4f49",
      "kind": "text_data",
      "source_text": "我的推就是爱丽数码，我会为你加油的！",
      "source_fingerprint": "b11b27df18fd4e3235ce43642253db9d08032a525bf3b4b9aa5d518f06b84cfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "586"
      ]
    },
    {
      "uid": "zhcn:58bc11cc2cb35466563d13f0",
      "kind": "text_data",
      "source_text": "决赛在即，请谈谈你的抱负。",
      "source_fingerprint": "62f4225de557f17e34be1468a793de97699494597c534e3c052a67b7d6838897",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "587"
      ]
    },
    {
      "uid": "zhcn:5f553027d5ec38404073948a",
      "kind": "text_data",
      "source_text": "昨天做了怎么样的梦呢？",
      "source_fingerprint": "38cf6edb38e46bd82a646068164fa4018b31a915248798a97df78a932f667ba9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "588"
      ]
    },
    {
      "uid": "zhcn:e8bfafc880b169f073a83a4f",
      "kind": "text_data",
      "source_text": "请对同年级的大家，说说你的抱负！",
      "source_fingerprint": "f6dfd312b5e03b79d3678c2dfdde2e4faecf658c83de1a3342960854f692d081",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "589"
      ]
    },
    {
      "uid": "zhcn:708081eb0a033105e6ee3e10",
      "kind": "text_data",
      "source_text": "跟你要好的猫咪过得还好吗？",
      "source_fingerprint": "2eaae4f30d4c4a5db10801f122cbfb06cd85f9574aa075883038e16af9eab7f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "59"
      ]
    },
    {
      "uid": "zhcn:c944f9c058deb74cff8779e3",
      "kind": "text_data",
      "source_text": "决赛结束后，你想做什么呢？",
      "source_fingerprint": "316f7da4f2c0e89bf593997dd593dac0bbd865e5b577d0fb05bba5595a4a95a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "590"
      ]
    },
    {
      "uid": "zhcn:42477ccc9916115bb803ecdd",
      "kind": "text_data",
      "source_text": "请对一同出赛的对手们宣战吧！",
      "source_fingerprint": "ac0c416fc871ddcb18c5adc59598a0e8186aaf3bbcbfd13e3624de7805d5ae09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "591"
      ]
    },
    {
      "uid": "zhcn:d6ffe21c8bb3ec0394686df1",
      "kind": "text_data",
      "source_text": "请针对决赛发表发表一句感言！",
      "source_fingerprint": "15608e22528142921eb74a51a43b754ba878306772954e713488103d58b42525",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "592"
      ]
    },
    {
      "uid": "zhcn:878f33fdfc557b733587c9b8",
      "kind": "text_data",
      "source_text": "有信心获得优胜吗？",
      "source_fingerprint": "ff02efb6b31f4ee36a5ac3cee3cc69ba89bebbe84a0ceba8ec7c29988b0ca6fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "593"
      ]
    },
    {
      "uid": "zhcn:84c4404d5cbbe153f43221f9",
      "kind": "text_data",
      "source_text": "简单来说，胜利方程式是！？",
      "source_fingerprint": "e0ed230c0bf259f8ec2c9e7eefdd04c8bed826868276ed0d05075e6f2f2a0eca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "594"
      ]
    },
    {
      "uid": "zhcn:8ece9819970f1f7ed5fe82ff",
      "kind": "text_data",
      "source_text": "至今曾面临过怎么样的障碍呢？",
      "source_fingerprint": "765ff3b28647f57bf7c5eebf74f791b94b7ccb29212f1e304eab522d3376dbbe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "595"
      ]
    },
    {
      "uid": "zhcn:547f4db3569c78539ad54c25",
      "kind": "text_data",
      "source_text": "这次也是强者云集呢。",
      "source_fingerprint": "7e990e5b8b2edd2622e366582df104a44510db8753ca1fa3fa2b3f36dfbd815c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "596"
      ]
    },
    {
      "uid": "zhcn:dc8cfc74f7b1eaedc0caf0dc",
      "kind": "text_data",
      "source_text": "终于要到决赛了！请问有多少把握？",
      "source_fingerprint": "e2f97e4fd9dbe759dd43a1cfe32f373c7c2db03d5cf0b4085ae16c87635aa6a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "597"
      ]
    },
    {
      "uid": "zhcn:954eaafbba950fa56da52aa1",
      "kind": "text_data",
      "source_text": "请告诉我们你对于决赛的抱负。",
      "source_fingerprint": "98de95fc17b3e22752a6bdc06aede85d57f5183f2a4a701b5aa4e7463a1467f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "598"
      ]
    },
    {
      "uid": "zhcn:8e1806cc55003558639640a7",
      "kind": "text_data",
      "source_text": "期待你获得优胜！",
      "source_fingerprint": "523f8940c89d63ae5057a2fbb283dda0216d6a6d0c3cacd15e77bdfbae689bf3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "599"
      ]
    },
    {
      "uid": "zhcn:ac027465f3ca7340fd176d1b",
      "kind": "text_data",
      "source_text": "听见粉丝的声援，有什么感想吗？",
      "source_fingerprint": "118edecc7999f4ee934dedf2548120af5c92a723404dcf786a3d605cb0be3c5b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "6"
      ]
    },
    {
      "uid": "zhcn:4ef79371b76d22492a1e177f",
      "kind": "text_data",
      "source_text": "请告诉我们胜利的秘诀。",
      "source_fingerprint": "101ef869ca1844732c0caef7d06b423da699e8c32dcff4849b9677c43475577e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "60"
      ]
    },
    {
      "uid": "zhcn:e94694badd479e69acf67693",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "600"
      ]
    },
    {
      "uid": "zhcn:ff031de2e85a8d3ccd77e0df",
      "kind": "text_data",
      "source_text": "请露出笑容，让我们拍1张刊登用的照片。",
      "source_fingerprint": "702d01163727082940a64b0d84ed8928c7d4e9eddc5d0cfa75457ebc6af148e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "601"
      ]
    },
    {
      "uid": "zhcn:6faa177d724b99b985ad7efc",
      "kind": "text_data",
      "source_text": "请针对优胜发表你的决心！",
      "source_fingerprint": "3bef724f99cebc7dfc138c697e872da4f98e1c7c4a3bc2e4aa250e26d69ae1de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "602"
      ]
    },
    {
      "uid": "zhcn:d57b1dc15f844a4542126808",
      "kind": "text_data",
      "source_text": "请告诉我们这场竞赛该关注哪个部分！",
      "source_fingerprint": "8722b55b608e8036a8493cb74c8718c0cfba6612e93d56c156eb44d3c3bba5cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "603"
      ]
    },
    {
      "uid": "zhcn:c70173d402056781bca0c43e",
      "kind": "text_data",
      "source_text": "请告诉我们你对今天竞赛的期许。",
      "source_fingerprint": "9dff7582ada1fd2dd53d406300cb564867ca0169783bc55164aac2300dca5186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "604"
      ]
    },
    {
      "uid": "zhcn:de78ae655b14693bf226b390",
      "kind": "text_data",
      "source_text": "看来会是一场精彩的竞赛呢！",
      "source_fingerprint": "e617932580608142b91c361f6d1f951096323a99e336bbcf57ca27229a9f1f0b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "605"
      ]
    },
    {
      "uid": "zhcn:91f521d0d6f860c491f9bcf7",
      "kind": "text_data",
      "source_text": "故乡的大家也在看台前为你加油喔！",
      "source_fingerprint": "aee91006aa1fb86e0efe7e15ab790c3c85565524ebe26b03aed34782e9d9bad4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "606"
      ]
    },
    {
      "uid": "zhcn:abd8aa9f53f1e280c24df59e",
      "kind": "text_data",
      "source_text": "请发表一下你充满干劲的感言！",
      "source_fingerprint": "66e197fc547bfe798b59d4a9457987b0f83005936499b41686211cdb5dd35c78",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "607"
      ]
    },
    {
      "uid": "zhcn:4bad354d8798a1705e8ba3f7",
      "kind": "text_data",
      "source_text": "弊刊有收到「谢谢你带来活力」的声音！",
      "source_fingerprint": "bd84612ab2c294cbb62439cdc6ed3063903d02e62727b4444a17eb0d9f25f5f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "608"
      ]
    },
    {
      "uid": "zhcn:404710aa752cf3ca954d2a7c",
      "kind": "text_data",
      "source_text": "请问餐点和胜利，有什么共通点？",
      "source_fingerprint": "b9e2f793483880bd8b20944babe502dcfb9e41e5105302b019e9ca326a8f91c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "609"
      ]
    },
    {
      "uid": "zhcn:dd0afe349d54c6c6ae2f9d38",
      "kind": "text_data",
      "source_text": "在竞赛中会期待什么样的发展？",
      "source_fingerprint": "2b6f21dd6f582fb5f4fee8f042cda84b3371637acfc3fe3e43ffd680d88d1ddd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "61"
      ]
    },
    {
      "uid": "zhcn:21f16aaac1b229b7d025c340",
      "kind": "text_data",
      "source_text": "能感觉到不寻常的气势呢！",
      "source_fingerprint": "e82b4027da0379aaf4d94dadc1c24b28a1bee2d913d350b2d78c842c437d4387",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "610"
      ]
    },
    {
      "uid": "zhcn:98e26c8df902072cc822455d",
      "kind": "text_data",
      "source_text": "终于到决赛了呢。请告诉我们你现在的心情。",
      "source_fingerprint": "16717b47e4b2697fe388fa77ad0953386c9f68b65b3e613d9073555921ebd7c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "611"
      ]
    },
    {
      "uid": "zhcn:64c1f5745050a20cfb1dd66e",
      "kind": "text_data",
      "source_text": "预赛前喝的饮料是什么呢？",
      "source_fingerprint": "4e9f2249b401431f3409c60fde68ff14e9f224c89211e0ae6aa5643c621749e3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "612"
      ]
    },
    {
      "uid": "zhcn:6de9667d59defcf60e8af6a1",
      "kind": "text_data",
      "source_text": "决赛即将开始的现在是什么心情？",
      "source_fingerprint": "c13f1b4a31e0b94ff1be7dd970d3738a51cf8d4d5269727810f40ff2fe0ac001",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "613"
      ]
    },
    {
      "uid": "zhcn:6c10a807574571991b39c710",
      "kind": "text_data",
      "source_text": "请让我们见识一等星的光芒吧！",
      "source_fingerprint": "40d9333a84f2251276a437dea70b0a7e055f6fd06004b9025bbf30f2be63350b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "614"
      ]
    },
    {
      "uid": "zhcn:5ad4d2dca5ff590763fc59e7",
      "kind": "text_data",
      "source_text": "想将这次的胜利献给谁呢？",
      "source_fingerprint": "16dc9f461172c8a9b824862cb11e49c69ac4acc7cbfa57ddfc76bb5e8559d714",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "615"
      ]
    },
    {
      "uid": "zhcn:bc4edd74d03b3d14a668510e",
      "kind": "text_data",
      "source_text": "不愧是决赛，众强者云集呢……",
      "source_fingerprint": "8ac1c07371cb0bd23a646b35b0ceddb038afd7466f4d3d8a9f11d46e1d808f3f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "616"
      ]
    },
    {
      "uid": "zhcn:187606510f0abe96a6067ce7",
      "kind": "text_data",
      "source_text": "请对一路给予你支持的训练员说句话！",
      "source_fingerprint": "588521ef06bb9d6a9d9a1a84239fac5eabe3a57d0409bb6e61312ff96f445eb3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "617"
      ]
    },
    {
      "uid": "zhcn:7bf9e96a3a5375619ae3a342",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "618"
      ]
    },
    {
      "uid": "zhcn:d3987f7bbce1078f7266908d",
      "kind": "text_data",
      "source_text": "请问目前状态大概达到百分之几呢？",
      "source_fingerprint": "ec6a9bf23e285a06e9382c4de63f3cfe742d2c10c0be1edb7d9febbf84df85ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "619"
      ]
    },
    {
      "uid": "zhcn:e6dbdbd002bcd39fec3a8cf6",
      "kind": "text_data",
      "source_text": "到目前为止做过最辛苦的训练是？",
      "source_fingerprint": "decad934505ae29b9577efbedff19860a519088133afb3cd025a638308ec3b1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "62"
      ]
    },
    {
      "uid": "zhcn:08402d2a4841d894505e59ea",
      "kind": "text_data",
      "source_text": "看了敝刊做的胜率预测后，现在的心情如何？",
      "source_fingerprint": "962b04315ce4ec9d29021b336425783acdac7cd864f7c1e3c456cd674a0851d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "620"
      ]
    },
    {
      "uid": "zhcn:361f75e9dc7f6c8faf82533c",
      "kind": "text_data",
      "source_text": "请对劲敌们下达开战宣言！",
      "source_fingerprint": "45ecaa1689d4894c0974092e0a3c46fec806550f5daf2bf055c4616bd5188e36",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "621"
      ]
    },
    {
      "uid": "zhcn:3e97a6d4c46107c26976543a",
      "kind": "text_data",
      "source_text": "有什么作战策略吗？",
      "source_fingerprint": "3e83dfd15e2b94c319d89c327d18eb8a73bd63cebe1e9a73fa005bc92a419dae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "622"
      ]
    },
    {
      "uid": "zhcn:e3cb4ba0090d12fcf3ea267e",
      "kind": "text_data",
      "source_text": "请针对决赛发表你的期许。",
      "source_fingerprint": "d741db3e57bb8a3e64808502ddbb9fd399901197e4dfbe336be663eaca2e70d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "623"
      ]
    },
    {
      "uid": "zhcn:1241c4a7077f92ba31f2ef79",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "624"
      ]
    },
    {
      "uid": "zhcn:932ab271d67fca1d2263ed0a",
      "kind": "text_data",
      "source_text": "请告诉我们这场竞赛该关注哪个部分！",
      "source_fingerprint": "8722b55b608e8036a8493cb74c8718c0cfba6612e93d56c156eb44d3c3bba5cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "625"
      ]
    },
    {
      "uid": "zhcn:87340c79089d7417d2556f90",
      "kind": "text_data",
      "source_text": "你现在可是注目的焦点呢！",
      "source_fingerprint": "03f126549b0a172f1ef90e62ef700f80bb1fda243c13e9b21efdc8f0ff932b08",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "626"
      ]
    },
    {
      "uid": "zhcn:0b6152fdd2ea71d642f4d0bd",
      "kind": "text_data",
      "source_text": "终于到决赛了。请问你有多少自信？",
      "source_fingerprint": "606dd2d88f68ac059a42734c08438084b418dc6db50aa72a959d07f1d0701cbd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "627"
      ]
    },
    {
      "uid": "zhcn:1af0b27516f6b9ac942d6400",
      "kind": "text_data",
      "source_text": "能有华丽的决赛会让粉丝的情绪也很激昂。",
      "source_fingerprint": "3975f2d4ef908012c8cd966fe50a32d6a024e1a0ab603de37d601684177de9ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "628"
      ]
    },
    {
      "uid": "zhcn:3d3fb6f946ac36e848bdf86d",
      "kind": "text_data",
      "source_text": "请针对决赛说出你的抱负！",
      "source_fingerprint": "43bff237de14d9000edd40b7ce6a36f0a17fbc04c034cea0995ebb758ac89617",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "629"
      ]
    },
    {
      "uid": "zhcn:beef6fb5d9ee405c0957271b",
      "kind": "text_data",
      "source_text": "期待你展现如闪电般一鸣惊人的表现。",
      "source_fingerprint": "732d8bd1a0ed2de4a20d055d51c89977f8c5862813835be1a79a548061b398c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "63"
      ]
    },
    {
      "uid": "zhcn:a8ae0a4cbf28e74a4df5b56e",
      "kind": "text_data",
      "source_text": "请告诉我们你推荐的爆进地点。",
      "source_fingerprint": "38f369f9bbcd78c30bc952ba6d5bf1541fa6d38795854c8d5f5e6ce58bd8a5f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "630"
      ]
    },
    {
      "uid": "zhcn:0ad173f3898566725ee36ac9",
      "kind": "text_data",
      "source_text": "有自信战胜其他参赛的强者们吗？",
      "source_fingerprint": "e788f565e5414a92158d497031455339ebc8193b0de7117ba895da03637dea29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "631"
      ]
    },
    {
      "uid": "zhcn:a5efb9644abcc9c8690ff32f",
      "kind": "text_data",
      "source_text": "赢得优胜后，最想先做什么事？",
      "source_fingerprint": "abc74e88d78d2a625a3bbc3371dfb607be14ec4570f56f439c84c878038c923a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "632"
      ]
    }
  ]
}
