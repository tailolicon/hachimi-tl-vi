{
  "schema_version": 1,
  "batch": 575,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:d2dfb51f1c3d6be07f3277d4",
      "kind": "text_data",
      "source_text": "赢得优胜后，最想先做什么事？",
      "source_fingerprint": "abc74e88d78d2a625a3bbc3371dfb607be14ec4570f56f439c84c878038c923a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "754"
      ]
    },
    {
      "uid": "zhcn:00932456852c70361b4576d9",
      "kind": "text_data",
      "source_text": "请对世界各地的粉丝们说句话！",
      "source_fingerprint": "afff0deb8ca1d7229698353b21ba8c06e76e5033d96dfa3d8de8d78f9ee3e607",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "755"
      ]
    },
    {
      "uid": "zhcn:c51ccf5b88b13760c06e960f",
      "kind": "text_data",
      "source_text": "终于到决赛了呢。请问你会紧张吗？",
      "source_fingerprint": "43ce5f5427c7cb3c00c041b0876f59a026633399c670e53f9ba7f4dd4d127f63",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "756"
      ]
    },
    {
      "uid": "zhcn:565b0721806e53652f372857",
      "kind": "text_data",
      "source_text": "面对近来最重要的大比赛。有什么作战策略吗？",
      "source_fingerprint": "df7acde2282e54be0c7177085cea96e538fb9148780c368fa0ea0044eacac8d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "757"
      ]
    },
    {
      "uid": "zhcn:13fe7c7c3144e886859019cc",
      "kind": "text_data",
      "source_text": "你认为会在决赛上遇到劲敌吗？",
      "source_fingerprint": "582ed3b239774af37404427a7dc4ba9d708ae4db39e23aabf9f0b62f24dfde45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "758"
      ]
    },
    {
      "uid": "zhcn:5245f65d980bc528de94dfb1",
      "kind": "text_data",
      "source_text": "能顺利施展奇迹魔法吗？",
      "source_fingerprint": "b291675b5eefd2a12c9d893e699929e065263c85d310dd33f0a911be3a8cb6c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "759"
      ]
    },
    {
      "uid": "zhcn:089322265a5b0357242ed20b",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "76"
      ]
    },
    {
      "uid": "zhcn:b4b7af9d87611b25f598a7ee",
      "kind": "text_data",
      "source_text": "请针对决赛说说你的抱负！",
      "source_fingerprint": "16f9fcb1324a705a0dca15b0434206f448fddaf820e5172eee7b85e4b9b6b1ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "760"
      ]
    },
    {
      "uid": "zhcn:638d79f59ee32504efd1ddb2",
      "kind": "text_data",
      "source_text": "竞赛获胜的话会想要怎么样的奖励呢？",
      "source_fingerprint": "996a1301ebb51f56e28f403fb681c545aaf6db34d8a01905a3eaecda0db66026",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "761"
      ]
    },
    {
      "uid": "zhcn:15b504866dde951228e5263d",
      "kind": "text_data",
      "source_text": "请说说你的抱负。",
      "source_fingerprint": "39601c88c7f0b1062a6de868e1b1bb79ab3c212b14ba3f73f03b23e5508cdd0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "762"
      ]
    },
    {
      "uid": "zhcn:4a6cb1ffc2c01c09c3d18fed",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "763"
      ]
    },
    {
      "uid": "zhcn:c3666ba7ea37b40c28044764",
      "kind": "text_data",
      "source_text": "终于来到决赛的大舞台了呢。",
      "source_fingerprint": "af784802a1b3122c93f564a18337686e0ae3fb9b0caf5ecb243409204880ab14",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "764"
      ]
    },
    {
      "uid": "zhcn:4a01714d9f0dbbfb4c99d509",
      "kind": "text_data",
      "source_text": "众多的粉丝们都对你充满期待喔！",
      "source_fingerprint": "125dc9c09b5ba36a03b754c2aee7a84f8fdd20fc587f00ce5268f29c775d1246",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "765"
      ]
    },
    {
      "uid": "zhcn:50ac0535590c3f184788c4f6",
      "kind": "text_data",
      "source_text": "没想到……竟然进决赛了呢！",
      "source_fingerprint": "7886f2f0e85a350d3f641780c2870c7e021bdc2fd534a335c7af1745c328f374",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "766"
      ]
    },
    {
      "uid": "zhcn:b704cf09e3e88f5998aca863",
      "kind": "text_data",
      "source_text": "请对决赛的劲敌发表一句感言！",
      "source_fingerprint": "074544c32f79f0321e54dacf6cdc398fad3c8cb22f4fea039e7e30b3bab79ebd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "767"
      ]
    },
    {
      "uid": "zhcn:2d73267cca13d3daa773b9a2",
      "kind": "text_data",
      "source_text": "比赛即将要开始了……莫非，你在发抖吗？",
      "source_fingerprint": "d6ca3c428a6b8450f6bdf75bc18394f37c21ea6b59b1038dc58933a7bcdeabfd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "768"
      ]
    },
    {
      "uid": "zhcn:73aef9d936b3654338879a94",
      "kind": "text_data",
      "source_text": "若获得优胜，会想第一个告诉谁呢？",
      "source_fingerprint": "5203c80985e5d32bf4ee375b7fdd36ad9939b22068899b411a1e60c43e7512e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "769"
      ]
    },
    {
      "uid": "zhcn:23f25c415a1687f7fcdac5fb",
      "kind": "text_data",
      "source_text": "没有竞赛和训练的日子都怎么度过？",
      "source_fingerprint": "983491826807b4f382b0c40de8281498dea0c3870d05ec066c4325f8f0c6a58a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "77"
      ]
    },
    {
      "uid": "zhcn:8c6a7c4335e9daa4c5f6a86c",
      "kind": "text_data",
      "source_text": "若获得优胜，会想先跟谁说呢？",
      "source_fingerprint": "65bcfba2328bd0545bb18dbd7d1e29f5c0f3c48915802c992fadfa499ea9991f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "770"
      ]
    },
    {
      "uid": "zhcn:0e4192152c93537216ce6b7c",
      "kind": "text_data",
      "source_text": "请对一同参加决赛的对手说句话！",
      "source_fingerprint": "8ee49204c67fad2a8d9926f948ee520e2a07d515bc791db41df249b8b27d994a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "771"
      ]
    },
    {
      "uid": "zhcn:56258f1178d1423379ab39d6",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝发表一句感言！",
      "source_fingerprint": "3b0e691d9d91c19c6082542a0a1c94e0a3915e2db2bceb4c2fc701ec5a460658",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "772"
      ]
    },
    {
      "uid": "zhcn:0168cf311b8ce2c1d6282da5",
      "kind": "text_data",
      "source_text": "终于要到决赛了呢。有多少把握呢？",
      "source_fingerprint": "ddb99d78eaaff3af41d97de696466a4839e969fe3efe32bc2002295448e6bd11",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "773"
      ]
    },
    {
      "uid": "zhcn:9e1337ac73e66901580d4375",
      "kind": "text_data",
      "source_text": "竞赛获胜的话会想要怎么样的奖励呢？",
      "source_fingerprint": "996a1301ebb51f56e28f403fb681c545aaf6db34d8a01905a3eaecda0db66026",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "774"
      ]
    },
    {
      "uid": "zhcn:fcccc4d663dd56ab39c2c338",
      "kind": "text_data",
      "source_text": "有什么针对决赛的秘策吗？",
      "source_fingerprint": "fb464644f6f95424bd27ce9a1d91125384c7998c67fd035ec6a8bd2bac9c10c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "775"
      ]
    },
    {
      "uid": "zhcn:c1bc0c4768865744f29b0702",
      "kind": "text_data",
      "source_text": "这次将多少选手视为劲敌呢？",
      "source_fingerprint": "b066fb40523cb31751380ac557e3079b71edd3a92ca0ace033d9bb34e8a03d01",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "776"
      ]
    },
    {
      "uid": "zhcn:902440f4fff709688d44048c",
      "kind": "text_data",
      "source_text": "这场决赛，期待你强力的表现喔！",
      "source_fingerprint": "0e9c3a4cd5a938b5d635f61e30276fff05274bc4bfcc86b4f2571cbb39dc7455",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "777"
      ]
    },
    {
      "uid": "zhcn:8b9ec692ec2a3aae79bf086e",
      "kind": "text_data",
      "source_text": "決勝戦の熱気、感じていますか？",
      "source_fingerprint": "e72c6e892ffe11a3bb771b9eb87220178a0910f99ac8c5de7b20e2a4875bece9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "778"
      ]
    },
    {
      "uid": "zhcn:5cabb638cf57e654c9e1f328",
      "kind": "text_data",
      "source_text": "勝利の暁には、何をしたいですか？",
      "source_fingerprint": "03644c27fe77853cc1654490f7744d02268eefaf9abe8a4a6466aee0a1948352",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "779"
      ]
    },
    {
      "uid": "zhcn:01186eaa1baf4a3166bdef93",
      "kind": "text_data",
      "source_text": "至今感到最热血沸腾的竞赛是？",
      "source_fingerprint": "0a7e5fd43bb9a57674ad873f748b504264a75b773811f6f62ec5958cc2be240b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "78"
      ]
    },
    {
      "uid": "zhcn:2b0376b9d563264fe49dded0",
      "kind": "text_data",
      "source_text": "麻烦你来一句平时的那个！",
      "source_fingerprint": "35f17c61c33ba77fa189646becb9309608edcd5a7051811623dab32556d295cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "780"
      ]
    },
    {
      "uid": "zhcn:14a21556a8545c89f9218e54",
      "kind": "text_data",
      "source_text": "我们可以期待你的美丽吗？",
      "source_fingerprint": "a7f24e1922f77c54a52eb616f7308acd3d5a6b72ad08e098e37ec928245ea935",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "781"
      ]
    },
    {
      "uid": "zhcn:18ed2302778a36bd02714a1b",
      "kind": "text_data",
      "source_text": "最近总觉得肩膀特别沉重……",
      "source_fingerprint": "d054174664f0d44ef32ef0f0cb4bee88b245b389dd6507d25666008ebb9711e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "782"
      ]
    },
    {
      "uid": "zhcn:8f10b9b0d5db0beb621269c1",
      "kind": "text_data",
      "source_text": "你觉得是什么影响了竞赛的输赢呢？",
      "source_fingerprint": "421fb79b7de2fa422b9c9fbd19812bf3c6e107148c5e3f7c2438fdfcdbb76392",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "783"
      ]
    },
    {
      "uid": "zhcn:fc38a5a19f7917705e5b93dc",
      "kind": "text_data",
      "source_text": "你的签约训练员在决赛前看起来很慌张耶……？",
      "source_fingerprint": "a1454867fd4919fbfa5c6dac12aec486ef8360158a24c84384ab5cbd0f6a9d3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "784"
      ]
    },
    {
      "uid": "zhcn:6601190fb5beff2ed57d7931",
      "kind": "text_data",
      "source_text": "全国各地聚集了对你的期待！",
      "source_fingerprint": "d4ce02bbee21829ae4aaa5f4a3c824f60d0dec0507900cb667a060797edcbf11",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "785"
      ]
    },
    {
      "uid": "zhcn:c03ef54038b33a5c22406e56",
      "kind": "text_data",
      "source_text": "终于到决赛了呢！",
      "source_fingerprint": "f27678946b9da613586b2f3d19b83ecef04e55558767b0e4460740dd9817bffe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "786"
      ]
    },
    {
      "uid": "zhcn:0198df424acb8ab880d80281",
      "kind": "text_data",
      "source_text": "请说说你对于优胜的抱负！",
      "source_fingerprint": "fa7e130fa93755eddae26db747190cd491b568b6a0c2eab9c049b95e8d5b5ce8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "787"
      ]
    },
    {
      "uid": "zhcn:7eaff6ec5878f0574bf40e60",
      "kind": "text_data",
      "source_text": "终于要到决赛了，有没有自信呢？",
      "source_fingerprint": "78150652c9ce30a592d1f2650d4da21441d68e50a6ba5eb6a8c30bc51408c8bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "788"
      ]
    },
    {
      "uid": "zhcn:92d9bd99154e8893fa167300",
      "kind": "text_data",
      "source_text": "对目白家的各位有什么想说的吗？",
      "source_fingerprint": "3e23022cedd1247fed45f4f9bc0cf0c1e9fd9f5a5b1f9c281031326efb66f58c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "789"
      ]
    },
    {
      "uid": "zhcn:4e78dbb85feb3fc608352e4e",
      "kind": "text_data",
      "source_text": "竞赛时最重要的是哪个部位的肌肉呢？",
      "source_fingerprint": "d388aed9292f96062256e5696e450ee426e54af9321bc0ab07bcaa2e4faa8ab5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "79"
      ]
    },
    {
      "uid": "zhcn:254c9a51ccda080f70ff98ee",
      "kind": "text_data",
      "source_text": "会带什么东西去无人岛上呢？",
      "source_fingerprint": "cdd6b3b239ff0ef2dc2a8c15e705cb14540882bcca4a4f41584e4fc9261427e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "790"
      ]
    },
    {
      "uid": "zhcn:6490b97109cab0618b2be5d8",
      "kind": "text_data",
      "source_text": "简单来说，锁定的名次是？",
      "source_fingerprint": "bedfd5c27046167fa045dceb93bd7c40dc911c3082a87224e4b9ef9b6e53bfc4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "791"
      ]
    },
    {
      "uid": "zhcn:be8f99e09aa4ced122098f26",
      "kind": "text_data",
      "source_text": "请对你的家人说句话！",
      "source_fingerprint": "8adb999d21115ed54c4842c73412b1836749b33f06b2e97a30fd63397863fc7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "792"
      ]
    },
    {
      "uid": "zhcn:5dcd77b4d4ea1f4dc4f5c318",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "793"
      ]
    },
    {
      "uid": "zhcn:8a0ee7bf41d104a3ec14f68c",
      "kind": "text_data",
      "source_text": "你有多少自信？",
      "source_fingerprint": "619aa98ff42893c36c27a61068941a862cea32f97241f7def6ae17512797f61c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "799"
      ]
    },
    {
      "uid": "zhcn:7b984bbe0716e2d77ea7ce6d",
      "kind": "text_data",
      "source_text": "会展现帝王舞步给我们看吗？",
      "source_fingerprint": "fa17a0f135a537aec28eb9987affc25e8e3683b5dacc4494d779365837712280",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "8"
      ]
    },
    {
      "uid": "zhcn:8bae16de2796961843ac3ba0",
      "kind": "text_data",
      "source_text": "想放松的时候都做些什么呢？",
      "source_fingerprint": "cfdcfe562460edcd75afe8527449dc6a29ceea048e62872adf9bfa1dfc026403",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "80"
      ]
    },
    {
      "uid": "zhcn:7717d5b34f39ba64c334867d",
      "kind": "text_data",
      "source_text": "说到致胜料理就会想到？",
      "source_fingerprint": "1b020b34f39544dec841c28908990c897f9f07defb5418de5f6f5f60d1a50122",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "800"
      ]
    },
    {
      "uid": "zhcn:c25db9e4a26ff341ec000a59",
      "kind": "text_data",
      "source_text": "请告诉我们你的目标！",
      "source_fingerprint": "5bfe5a7cb1ba241dfadb61cb3992e374bd13eaca1873ab124e1632ea43a9f749",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "801"
      ]
