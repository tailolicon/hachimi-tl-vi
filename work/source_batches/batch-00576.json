      ]
    },
    {
      "uid": "zhcn:af7d6efa1d9371287574f56a",
      "kind": "text_data",
      "source_text": "平常都是怎么度过假日的呢？",
      "source_fingerprint": "564c6298ce1b93b2d899ac9a883b0baf56f3d0a6d2c70f46df09deb48c3613ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "75"
      ]
    },
    {
      "uid": "zhcn:011038a03041674c99084541",
      "kind": "text_data",
      "source_text": "能有华丽的决赛会让粉丝的情绪也很激昂。",
      "source_fingerprint": "3975f2d4ef908012c8cd966fe50a32d6a024e1a0ab603de37d601684177de9ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "750"
      ]
    },
    {
      "uid": "zhcn:96a7eb4cd1080d582699826a",
      "kind": "text_data",
      "source_text": "请针对决赛说出你的抱负！",
      "source_fingerprint": "43bff237de14d9000edd40b7ce6a36f0a17fbc04c034cea0995ebb758ac89617",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "751"
      ]
    },
    {
      "uid": "zhcn:7cf4cef5ee8a5f80abf84e01",
      "kind": "text_data",
      "source_text": "请告诉我们你推荐的爆进地点。",
      "source_fingerprint": "38f369f9bbcd78c30bc952ba6d5bf1541fa6d38795854c8d5f5e6ce58bd8a5f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "752"
      ]
    },
    {
      "uid": "zhcn:56d37ed68468b3dfd9bea676",
      "kind": "text_data",
      "source_text": "有自信战胜其他参赛的强者们吗？",
      "source_fingerprint": "e788f565e5414a92158d497031455339ebc8193b0de7117ba895da03637dea29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "753"
      ]
    },
    {
      "uid": "zhcn:d2dfb51f1c3d6be07f3277d4",
      "kind": "text_data",
      "source_text": "赢得优胜后，最想先做什么事？",
      "source_fingerprint": "abc74e88d78d2a625a3bbc3371dfb607be14ec4570f56f439c84c878038c923a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "754"
      ]
    },
    {
      "uid": "zhcn:00932456852c70361b4576d9",
      "kind": "text_data",
      "source_text": "请对世界各地的粉丝们说句话！",
      "source_fingerprint": "afff0deb8ca1d7229698353b21ba8c06e76e5033d96dfa3d8de8d78f9ee3e607",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "755"
      ]
    },
    {
      "uid": "zhcn:c51ccf5b88b13760c06e960f",
      "kind": "text_data",
      "source_text": "终于到决赛了呢。请问你会紧张吗？",
      "source_fingerprint": "43ce5f5427c7cb3c00c041b0876f59a026633399c670e53f9ba7f4dd4d127f63",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "756"
      ]
    },
    {
      "uid": "zhcn:565b0721806e53652f372857",
      "kind": "text_data",
      "source_text": "面对近来最重要的大比赛。有什么作战策略吗？",
      "source_fingerprint": "df7acde2282e54be0c7177085cea96e538fb9148780c368fa0ea0044eacac8d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "757"
      ]
    },
    {
      "uid": "zhcn:13fe7c7c3144e886859019cc",
      "kind": "text_data",
      "source_text": "你认为会在决赛上遇到劲敌吗？",
      "source_fingerprint": "582ed3b239774af37404427a7dc4ba9d708ae4db39e23aabf9f0b62f24dfde45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "758"
      ]
    },
    {
      "uid": "zhcn:5245f65d980bc528de94dfb1",
      "kind": "text_data",
      "source_text": "能顺利施展奇迹魔法吗？",
      "source_fingerprint": "b291675b5eefd2a12c9d893e699929e065263c85d310dd33f0a911be3a8cb6c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "759"
      ]
    },
    {
      "uid": "zhcn:089322265a5b0357242ed20b",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "76"
      ]
    },
    {
      "uid": "zhcn:b4b7af9d87611b25f598a7ee",
      "kind": "text_data",
      "source_text": "请针对决赛说说你的抱负！",
      "source_fingerprint": "16f9fcb1324a705a0dca15b0434206f448fddaf820e5172eee7b85e4b9b6b1ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "760"
      ]
    },
    {
      "uid": "zhcn:638d79f59ee32504efd1ddb2",
      "kind": "text_data",
      "source_text": "竞赛获胜的话会想要怎么样的奖励呢？",
      "source_fingerprint": "996a1301ebb51f56e28f403fb681c545aaf6db34d8a01905a3eaecda0db66026",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "761"
      ]
    },
    {
      "uid": "zhcn:15b504866dde951228e5263d",
      "kind": "text_data",
      "source_text": "请说说你的抱负。",
      "source_fingerprint": "39601c88c7f0b1062a6de868e1b1bb79ab3c212b14ba3f73f03b23e5508cdd0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "762"
      ]
    },
