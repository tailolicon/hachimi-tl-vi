      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "766"
      ]
    },
    {
      "uid": "zhcn:b704cf09e3e88f5998aca863",
      "kind": "text_data",
      "source_text": "请对决赛的劲敌发表一句感言！",
