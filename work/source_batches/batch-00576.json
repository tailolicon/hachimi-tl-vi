      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "『私は勝つ！　どんな障害にも切り込んで、\\n真っ先に栄光を手にしてみせる！』",
      "source_fingerprint": "1ed489e29dd78dfe766f350529ba945b7a7a803cd2bf71b4a1c18b624afe568f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
