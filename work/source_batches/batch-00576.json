        "205",
        "136"
      ],
      "json_pointer": "/205/136"
    },
    {
      "uid": "zhcn:7fea7e4deae4becc58db23b2",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "唱演唱会歌曲就自然而然能放松啰☆\\n大力推荐这么做喔！",
      "source_fingerprint": "f417c3812bd5dcacac5535bc0e3e7a18ea40c68b3cb90f545c84b7c7a1d12962",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
