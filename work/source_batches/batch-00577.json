      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "8"
      ]
    },
    {
      "uid": "zhcn:8bae16de2796961843ac3ba0",
      "kind": "text_data",
      "source_text": "想放松的时候都做些什么呢？",
