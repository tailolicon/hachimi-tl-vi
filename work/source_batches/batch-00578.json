      ]
    },
    {
      "uid": "zhcn:17e0bb6ad030d63321e1b5ab",
      "kind": "text_data",
      "source_text": "麻烦请对一同出赛的对手们宣战！",
      "source_fingerprint": "5193ef9b741aa8b2981b83aace0314e5e857e959e0ace5c728dc2fc96705ecca",
