      ]
    },
    {
      "uid": "zhcn:8ef1f1017c473f02b1c380b3",
      "kind": "text_data",
      "source_text": "请对各位粉丝说句话。",
      "source_fingerprint": "79e0b58f1c54548d7a10cf12e343986c38d74449c285590f8772147368b814bb",
      "source_path": "text_data_dict.json",
