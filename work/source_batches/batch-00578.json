      "kind": "text_data",
      "source_text": "朝向胜利「勇往直前」──是我的stance，\\n我请鲁道夫──帮忙翻译，成日文了──",
      "source_fingerprint": "98a821b0f8e8e8cd00aa4cc382d916ab974db7f9accbe624a6349792ef4e2684",
      "source_path": "text_data_dict.json",
