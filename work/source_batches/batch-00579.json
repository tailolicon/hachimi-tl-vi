    {
      "uid": "zhcn:88fa30684982e0b651308fc8",
      "kind": "text_data",
      "source_text": "尾巴的旧伤……因为冲动（pathos）而隐隐\\n作疼！吹响决战的号角（Gjallarhorn）吧！",
      "source_fingerprint": "2a8513acd9e01493bf93ca21516140be447445e33f480ee158731b14579bc38b",
