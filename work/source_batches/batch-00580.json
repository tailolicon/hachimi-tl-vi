      "json_path": [
        "204",
        "340"
      ]
    },
    {
      "uid": "zhcn:0a4c4a0fe1d24d408da9efb1",
      "kind": "text_data",
      "source_text": "听说你被称为魔鬼纠察队长，原因是？",
      "source_fingerprint": "da115032d343211c4773a2614fcac0704f8d9effefca336e8675d4b050a466c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "341"
      ]
    },
    {
      "uid": "zhcn:074d45e7bf9a7132c60c63fa",
      "kind": "text_data",
      "source_text": "请告诉我们你尊敬的对象！",
      "source_fingerprint": "2841363d27d91818cab85659b522e2ca44345f5f819f49075cbc463293dfa3bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "342"
      ]
    },
    {
      "uid": "zhcn:fae08a7660393a123e7edb83",
      "kind": "text_data",
      "source_text": "意気込みをお願いします。",
      "source_fingerprint": "63c2ae9ca096e74b507a7747fd64aa2423e0b5670722295aa1121282e68b85ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "343"
      ]
    },
    {
      "uid": "zhcn:1f50034194aab83b16d3d170",
      "kind": "text_data",
      "source_text": "尊敬する人物を教えてください。",
      "source_fingerprint": "aad0c8a05e0026b3905ba528d8d2907b4043d8193d233cde9e10188bc92bb56a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "344"
      ]
    },
    {
      "uid": "zhcn:115273961274a13056314cee",
      "kind": "text_data",
      "source_text": "本日のレース、1着を取れそうですか？",
      "source_fingerprint": "6b065254fec691008e76dbd9a1401f8ec89ed82596a367b2156a33817d25cfe7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "345"
      ]
    },
    {
      "uid": "zhcn:55e7878fa09ac32a0216e12b",
      "kind": "text_data",
      "source_text": "面对比赛是否已经准备周全了呢？",
      "source_fingerprint": "0a6b4bc9f27dcb3887c0069531795f09520e036769bee7e35e63b89a336c9995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "346"
      ]
    },
    {
      "uid": "zhcn:919e6d4d3e429dc011efa4f5",
      "kind": "text_data",
      "source_text": "最近发现的美丽是？",
      "source_fingerprint": "cdd0f8a053c940ce847ea76a61f59da29dc9efad64b60ba56876c6409dcfb137",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "347"
      ]
    },
    {
      "uid": "zhcn:adf84b0065a95dd5d346a772",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "348"
      ]
    },
    {
      "uid": "zhcn:4f299c4ed2c151497a752a1c",
      "kind": "text_data",
      "source_text": "有多少把握……不，有多少运气？",
      "source_fingerprint": "6afe40e0bd50f6dec30bd1e2d073b73d8b89eb98a44ad6145637605be5a4bf4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "349"
      ]
    },
    {
      "uid": "zhcn:4a1dd5ceb37a4fbc22d3ddb7",
      "kind": "text_data",
      "source_text": "最近有热衷于什么事情吗？",
      "source_fingerprint": "1a667983e52f68704f5b8d26950927364a2721d11fa64af4010f610aea76ea3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "35"
      ]
    },
    {
      "uid": "zhcn:cc1571568a2d94aac168d0ec",
      "kind": "text_data",
      "source_text": "虽然很突然，可以请你帮我占卜一下吗？",
      "source_fingerprint": "66d245592203f602e5337fec7bb4d32d91b2c4037ac78631d7c1b00225ff8339",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "350"
      ]
    },
    {
      "uid": "zhcn:b4c44f33515ca19647155221",
      "kind": "text_data",
      "source_text": "福气会降临吗？",
      "source_fingerprint": "5a05348f715b06713a5fa1bb2ef23e007c7ec9320bbb040768a514f440a398ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "351"
      ]
    },
    {
      "uid": "zhcn:5161221e15acdc5c40674a2c",
      "kind": "text_data",
      "source_text": "请告诉我们你在比赛前的期许。",
      "source_fingerprint": "22d4ccfb0772d6fb67359d87bc1a0ba63e6d05f8de6ef734b1db43d11be67faa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "352"
      ]
    },
    {
      "uid": "zhcn:745eac9c8143c0a6b4b748fc",
      "kind": "text_data",
      "source_text": "这场比赛有很多位强者喔？",
      "source_fingerprint": "84293ddf08d5a1e4586d900dc94ddc8cb16e1c50effcd19842aface040391f45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "353"
      ]
    },
    {
      "uid": "zhcn:0ab6c67878994da832613355",
      "kind": "text_data",
      "source_text": "你看起来心情非常好，遇上什么好事了吗？",
      "source_fingerprint": "e15705a70c8e2ec129b061b064bca2c6814f5f67d0b2cde861807d66055ef60c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "354"
      ]
    },
    {
      "uid": "zhcn:898a2959f1e0c698432b4c9e",
      "kind": "text_data",
      "source_text": "请说说抱负──呃，还好吗？你脸色有点……",
      "source_fingerprint": "371cff6facd734922f540fa772410d778e29c9a3305278dac5ec25bba66c0160",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "355"
      ]
    },
    {
      "uid": "zhcn:a059de50b46072b48178c991",
      "kind": "text_data",
      "source_text": "请告诉我们你当作目标的对象。",
      "source_fingerprint": "fcd065493ad700887062846739f4a5483cbdac9c49891ab6235c3a1967a486b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "356"
      ]
    },
    {
      "uid": "zhcn:6eef54dbd9f65afe1315a279",
      "kind": "text_data",
      "source_text": "简单来说，胜利的秘诀是！？",
      "source_fingerprint": "0ff3d96bbce3120a567d96bf3ae2ad18e24a9b575869dce9c246816b2b26a51a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "357"
      ]
    },
    {
      "uid": "zhcn:9146d7847a40787a03fbdf39",
      "kind": "text_data",
      "source_text": "好像有什么很香的味道？",
      "source_fingerprint": "f5ee03c12b1548c9f79f0fa872901f7196bf30d1940b29f6f57a35780306d842",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "358"
      ]
    },
    {
      "uid": "zhcn:9735c32d0bfa0dc6ebe57a4c",
      "kind": "text_data",
      "source_text": "家人是不是都会叫你「小多」之类的？",
      "source_fingerprint": "c63cc737a969b6b3f0399ef0351ba13cbe1b4c417a80178eb9a5462678658cff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "359"
      ]
    },
    {
      "uid": "zhcn:e8097a1b403624f337205aa7",
      "kind": "text_data",
      "source_text": "掌握胜利的诀窍是？",
      "source_fingerprint": "750b8d58e40b491d69fdda8ea53a30ec0b363512ff514dfca88582ef27c750fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "36"
      ]
    },
    {
      "uid": "zhcn:82ebd9ab6cd74944c5939e03",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "360"
      ]
    },
    {
      "uid": "zhcn:12670156d2bcac8878fc43c8",
      "kind": "text_data",
      "source_text": "听说你常看电视购物节目，最近有推荐的节目吗？",
      "source_fingerprint": "1a818539d5b589a03f412535c0ac4ed8234cc0c90cb9cfc9821ff8a4d40b6ae4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "361"
      ]
    },
    {
      "uid": "zhcn:dca86a2431d94b4789598cd2",
      "kind": "text_data",
      "source_text": "请用福冈腔说说抱负。",
      "source_fingerprint": "dfdd53bda620cc463cae579dd6ab0ad0d64b3035e07b8889cf54c07eb4802828",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "362"
      ]
    },
    {
      "uid": "zhcn:18d000326efe231d89f5e513",
      "kind": "text_data",
      "source_text": "期待你能拿出安定感非凡的表现纵横赛场！",
      "source_fingerprint": "07c3b87883ac1e9e7e574fc4e322c9c03474f31808e081bd173c05b4da82d687",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "363"
      ]
    },
    {
      "uid": "zhcn:7b5d936659d8de70fe112005",
      "kind": "text_data",
      "source_text": "针对竞赛做了多少跑步训练呢？",
      "source_fingerprint": "b9897adb7b91482892537c91de7ad8363625284939dae0181f2f9c2afd871622",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "364"
      ]
    },
    {
      "uid": "zhcn:57800eb3e5e12ec007a68086",
      "kind": "text_data",
      "source_text": "最近有遇到什么失误吗？",
      "source_fingerprint": "45bef4fc162d8dba4f1d45c120193a69c2d072eadbd0ee86be7228f3f7a2c397",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "365"
      ]
    },
    {
      "uid": "zhcn:e77ea5184c9eac2c43659849",
      "kind": "text_data",
      "source_text": "没有竞赛和训练的日子都怎么度过？",
      "source_fingerprint": "983491826807b4f382b0c40de8281498dea0c3870d05ec066c4325f8f0c6a58a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "366"
      ]
    },
    {
      "uid": "zhcn:3e6637fdb906addc8cb7bd5a",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话。",
      "source_fingerprint": "ae5a9a2f814783e93d18d5e700918a58315f57dbc941972f0d027258e78fcdb5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "367"
      ]
    },
    {
      "uid": "zhcn:68de0eca947c26f262f65fe9",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
