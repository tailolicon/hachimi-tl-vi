      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "324"
      ]
    },
    {
      "uid": "zhcn:ffd6e169bac3a9c44aa3cd1e",
      "kind": "text_data",
      "source_text": "请谈谈你的抱负。",
