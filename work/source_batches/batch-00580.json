      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "32"
      ]
    },
    {
      "uid": "zhcn:5c471d03074d0639ec772be2",
      "kind": "text_data",
      "source_text": "竞赛前有什么推荐的放松方法？",
