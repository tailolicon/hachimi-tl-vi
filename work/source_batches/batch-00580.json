      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "323"
      ]
    },
    {
      "uid": "zhcn:7402315e5613fcde82d74e19",
      "kind": "text_data",
      "source_text": "最喜欢的故事是什么呢？",
