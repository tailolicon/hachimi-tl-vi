    {
      "uid": "zhcn:f15e6e0bd83bf91b019f2978",
      "kind": "text_data",
      "source_text": "「喜欢」的「乐团」歌曲──「前奏」\\n据说……和「幽浮的声音」很相似喔？",
      "source_fingerprint": "b4d839d67d7f71c3d12455b0aafc80df391012738b0558dcbd603da7ac1dd1cc",
      "source_path": "text_data_dict.json",
