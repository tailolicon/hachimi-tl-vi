    {
      "uid": "zhcn:34a02f842a9c04d32b285aec",
      "kind": "text_data",
      "source_text": "これは……勝利を前にしての昂り。\\nつまり……緊張ではなく、血の滾りです。",
      "source_fingerprint": "97b641da2e562720224465d5ea4d7f9357e9fae7e399bf37b899c41be5b32082",
