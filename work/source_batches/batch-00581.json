        "205",
        "1202"
      ]
    },
    {
      "uid": "zhcn:9db53fb2b28b7d90b9ac499c",
      "kind": "text_data",
      "source_text": "レースへの調整に費やしています。\\n万全を期して臨みたいので。",
      "source_fingerprint": "1eab07bf5ad6eeb1f95c380bb17dbdf2dc0773350ff84c8113ded28e0831d345",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1203"
      ]
    },
    {
      "uid": "zhcn:2042a9aa2378cb521af06a8d",
      "kind": "text_data",
      "source_text": "私は、1番のライバルを自分としています。\\nまずは己の走りを極めるのみです。",
      "source_fingerprint": "4486f3e50c6b139e7c9e0f61051d2246de46e07b6a233e2c5b30eb31ead6a3d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1204"
      ]
    },
