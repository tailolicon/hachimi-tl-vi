      ]
    },
    {
      "uid": "zhcn:e44f271b202c724b4cfdbad8",
      "kind": "text_data",
      "source_text": "“最強”を証明する――それだけです。",
      "source_fingerprint": "5305d6a1a8a8fc48c3754451a43adc46a086ef3b0c06f4068665dcb819a6dd7e",
