      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "422"
      ]
    },
    {
      "uid": "zhcn:b95b52dba087ecd7e8e4097d",
      "kind": "text_data",
      "source_text": "你觉得获得胜利的关键是什么？",
