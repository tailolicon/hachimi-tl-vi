      ]
    },
    {
      "uid": "zhcn:6423f936316e39658080b153",
      "kind": "text_data",
      "source_text": "体、精神、蹄鉄に至るまで仕上がり上々。\\nこのレース……勝たせていただきます。",
      "source_fingerprint": "2c9894a47c5d2f09f605748206737607c6214926314b1991c7ba8bcde4ba302d",
