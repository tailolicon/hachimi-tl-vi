      ]
    },
    {
      "uid": "zhcn:f7fe86d54853fa4a727f55a3",
      "kind": "text_data",
      "source_text": "無論……だからこそ、ここにいます。",
      "source_fingerprint": "c25295cf412d5dd11302300fa0819c09668c0c9c0ed6406b0af4bfabf5b3e172",
      "source_path": "text_data_dict.json",
