        "205",
        "115"
      ]
    },
    {
      "uid": "zhcn:fa68dc7db82fa5af95326c69",
      "kind": "text_data",
      "source_text": "練習・休息・栄養補給その他諸々、\\n事前に立てた計画どおり進めることですね！",
      "source_fingerprint": "b5e5372f8ef2e1c508ec9bb4cc87092d15748a0b5d1ee532464e6a091f825ec0",
      "source_path": "text_data_dict.json",
