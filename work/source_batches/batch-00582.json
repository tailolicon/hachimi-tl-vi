  "entries": [
    {
      "uid": "zhcn:b4873d2db76bdaefe3f0fcf4",
      "kind": "text_data",
      "source_text": "喜欢的咖啡是？",
      "source_fingerprint": "04056be011b45f3e7e7d2f6c44035f4acd90dfdae1cc2b781a63d93d126dccfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "440"
      ]
    },
    {
      "uid": "zhcn:515a71b5140ec6040214daaf",
      "kind": "text_data",
      "source_text": "平常都是怎么度过假日的呢？",
      "source_fingerprint": "564c6298ce1b93b2d899ac9a883b0baf56f3d0a6d2c70f46df09deb48c3613ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "441"
      ]
    },
    {
      "uid": "zhcn:96a3591444af41c0a99fac51",
      "kind": "text_data",
      "source_text": "赛前的致胜料理吃了什么呢？",
      "source_fingerprint": "977ce0c7615a51c57dff528bc9bedf1dc33650d36215b553d98df2851f2f32aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "442"
      ]
    },
    {
      "uid": "zhcn:3cc94527b581ae22e702d1fa",
      "kind": "text_data",
      "source_text": "没有竞赛和训练的日子都怎么度过？",
      "source_fingerprint": "983491826807b4f382b0c40de8281498dea0c3870d05ec066c4325f8f0c6a58a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "443"
      ]
    },
    {
      "uid": "zhcn:797fb119aeee45560d66007d",
      "kind": "text_data",
      "source_text": "至今感到最热血沸腾的竞赛是？",
      "source_fingerprint": "0a7e5fd43bb9a57674ad873f748b504264a75b773811f6f62ec5958cc2be240b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "444"
      ]
    },
    {
      "uid": "zhcn:fcf39ce2fac70bb5a502d1c8",
      "kind": "text_data",
      "source_text": "竞赛时最重要的是哪个部位的肌肉呢？",
      "source_fingerprint": "d388aed9292f96062256e5696e450ee426e54af9321bc0ab07bcaa2e4faa8ab5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "445"
      ]
    },
    {
      "uid": "zhcn:21a1741e06e80b3bbd1989fd",
      "kind": "text_data",
      "source_text": "想放松的时候都做些什么呢？",
      "source_fingerprint": "cfdcfe562460edcd75afe8527449dc6a29ceea048e62872adf9bfa1dfc026403",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "446"
      ]
    },
    {
      "uid": "zhcn:48dfff4a165f29f1842f138d",
      "kind": "text_data",
      "source_text": "身为目白家的赛马娘，会感觉到压力沉重吗？",
      "source_fingerprint": "a6d6af86625b8a8e6ce71ff3ba599859ae5048b95f8401668a67aabd9257ad41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "447"
      ]
    },
    {
      "uid": "zhcn:fe223d723d90d003679ca167",
      "kind": "text_data",
      "source_text": "身体状态的调整完成度大概有百分之几了呢？",
      "source_fingerprint": "a0bb57fe119e91dd174d973646e301c6ab59fa2dc5fb63082acfd92abebdaad0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "448"
      ]
    },
    {
      "uid": "zhcn:aef2121195c20ddd189fb6ec",
      "kind": "text_data",
      "source_text": "喜欢的料理是什么？",
      "source_fingerprint": "007912bde97c9c1be28d90d17ea3bcfc90d5a78dfe91468f88cdd9b3bb69c39e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "449"
      ]
    },
    {
      "uid": "zhcn:59a94657167df92e0e80ef68",
      "kind": "text_data",
      "source_text": "请问目前状态大概达到百分之几呢？",
      "source_fingerprint": "ec6a9bf23e285a06e9382c4de63f3cfe742d2c10c0be1edb7d9febbf84df85ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "45"
      ]
    },
    {
      "uid": "zhcn:230bfe031b18961dc54e0832",
      "kind": "text_data",
      "source_text": "在相扑中最喜欢的致胜招式是什么？",
      "source_fingerprint": "3c87f6e280508acf49d84ef54fd11a8575c2a6d43af311bf3334ed2712e7fc75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "450"
      ]
    },
    {
      "uid": "zhcn:92ce12173a209c94ec32487b",
      "kind": "text_data",
      "source_text": "这次的预赛，你有多少信心？",
      "source_fingerprint": "c8b7e50233e1b5d1decac549657a4fcea7430b255a77dfe9e520784240ef38c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "451"
      ]
    },
    {
      "uid": "zhcn:da516429fa9f7bad1975b79c",
      "kind": "text_data",
      "source_text": "雪子，听说你很有信心馁？过得好不好吶？",
      "source_fingerprint": "ef3cc04d6899317100a086148b77dbbb514725a6b62cfc5d744b7cb4d77b366e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "452"
      ]
    },
    {
      "uid": "zhcn:b31cb9350dfb89f523a6ea2e",
      "kind": "text_data",
      "source_text": "你想带给粉丝怎样的竞赛呢？",
      "source_fingerprint": "9923760b3e6f9b0ae7c93e2081dea09a326bca992dcb82b475d7ca7fa55c1cf6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "453"
      ]
    },
    {
      "uid": "zhcn:c1c299f5d687a48988a9f645",
      "kind": "text_data",
      "source_text": "期待你的表现！",
      "source_fingerprint": "a1bdb267edb2a739beea3debe5c1f8b84215ea9ae4eef11ba2a4127224acf6f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "454"
      ]
    },
    {
      "uid": "zhcn:27d25d6ef86785ddbafe488b",
      "kind": "text_data",
      "source_text": "目前状态可在满分100分中，拿到几分？",
      "source_fingerprint": "b85f62347788114b2196ae6888aee4d7e24988944c18c1578e087a01e2860d03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "455"
      ]
    },
    {
      "uid": "zhcn:547ffebb821067b63684b961",
      "kind": "text_data",
      "source_text": "最近有遇到开心的事情吗？",
      "source_fingerprint": "1fb438d700921e2d77288ae421e956e9014398c24f074d053b25cfefd7ed4668",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "456"
      ]
    },
    {
      "uid": "zhcn:3963221859509c405cb1ea00",
      "kind": "text_data",
      "source_text": "请向正在观看竞赛的大家说句话。",
      "source_fingerprint": "9858d2c47478db2349fd006b62b759bc4a2ae36ef9ce3116caa811d4c51190b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "457"
      ]
    },
    {
      "uid": "zhcn:03d1edb518d8e278f8765d2c",
      "kind": "text_data",
      "source_text": "听说你最近常出现在车站附近？",
      "source_fingerprint": "ac0fc190bc6f747d3dd2134f7857cfb9100958be501ce503ffb436cbbb72cff6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "458"
      ]
    },
    {
      "uid": "zhcn:0adeef0d79edfb93529fe6fc",
      "kind": "text_data",
      "source_text": "你对自己最有自信的地方是？",
      "source_fingerprint": "5090dc56f1fd72afe86c8dacd09dd573042463c1941ae65b35db422db7bb19d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "459"
      ]
    },
    {
      "uid": "zhcn:b000241711a82b0ec8a8ed5d",
      "kind": "text_data",
      "source_text": "这次有可以称得上是劲敌的成员吗？",
      "source_fingerprint": "e1743c0be863361c9356834cb02cc663cc92de842d92cf13395b1167392a0782",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "46"
      ]
    },
    {
      "uid": "zhcn:fe810f8f1e84033f9f57d6cb",
      "kind": "text_data",
      "source_text": "有赛前的例行公事吗？",
      "source_fingerprint": "6dfd1db01bad37da61eea4b1dabf534504c0d5e5eaefe56d49950e960140e83d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "460"
      ]
    },
    {
      "uid": "zhcn:1a7a7f11e3653542e8306b16",
      "kind": "text_data",
      "source_text": "竞赛时什么事情最重要？",
      "source_fingerprint": "01995ff79ab47d1424696b2b834325bc04124c8490d059765adf949cc05a8e81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "461"
      ]
    },
    {
      "uid": "zhcn:549be9d16f647899daf31950",
      "kind": "text_data",
      "source_text": "觉得最辛苦的训练是什么？",
      "source_fingerprint": "71bc033852587690846b8662d86cbfac3c299beeeb9fd773b53a23a0123e3eff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "462"
      ]
    },
    {
      "uid": "zhcn:b5888b1dd1479a804d042061",
      "kind": "text_data",
      "source_text": "期待你的表现！",
      "source_fingerprint": "a1bdb267edb2a739beea3debe5c1f8b84215ea9ae4eef11ba2a4127224acf6f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "463"
      ]
    },
    {
      "uid": "zhcn:2399bb2e2bf7022d6e65aaa3",
      "kind": "text_data",
      "source_text": "是否有人为你演出了一场激励人心的歌剧？",
      "source_fingerprint": "0e1ca1998600436c4bd7e16253ecb32b04d05d332c775f32b474c10aa9903310",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "464"
      ]
    },
    {
      "uid": "zhcn:920c30ebe2f0d6d4133b1571",
      "kind": "text_data",
      "source_text": "胜利所需最重要的因素是什么？",
      "source_fingerprint": "e8ebf6717228afab815276dc5abf7e38bee7cf1a93f690e2fe48457ceaad626a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "465"
      ]
    },
    {
      "uid": "zhcn:f0f44b0d2d4c4e161d3d8b0f",
      "kind": "text_data",
      "source_text": "请向祈望你获得胜利的粉丝说说你的抱负！",
      "source_fingerprint": "278c8eb06cd3ab091707d309e605f0454cf6b8f508dda63fe0578674a21e2a6e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "466"
      ]
    },
    {
      "uid": "zhcn:963dce0c4c5d8495204bd1c4",
      "kind": "text_data",
      "source_text": "在比赛前，会做什么提升士气的事情吗？",
      "source_fingerprint": "d4638d19f49ab94b91a0bc5886e9d9c6be3c81bb95b53141e7b78814c5c8415e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "467"
      ]
    },
    {
      "uid": "zhcn:0e9f39a2d72319b4857639cc",
      "kind": "text_data",
      "source_text": "在休假日会从事什么样的休闲活动？",
      "source_fingerprint": "d62c289e12cee0dc78b4686ce6ab3eab5d397aa2586a03cce1efb625596a73ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "468"
      ]
    },
    {
      "uid": "zhcn:6107fe9ae66ab8df707f4313",
      "kind": "text_data",
      "source_text": "没有训练的日子都怎么度过？",
      "source_fingerprint": "c0c9471aaa399f86240626a409851799f6ddb2dbb1bc5855b1b166f4fc16b281",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "469"
      ]
    },
    {
      "uid": "zhcn:62119df3fb4e67df1ea13fe6",
      "kind": "text_data",
      "source_text": "有传闻说你会在休息室吃饭团？",
      "source_fingerprint": "3ebe55341b5a818ce036aab0322bc9b3babfd37c6ad8c1a41580c5cd82b1cc13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "47"
      ]
    },
    {
      "uid": "zhcn:49f3882a83a8f0e688c70169",
      "kind": "text_data",
      "source_text": "竞赛时什么事情最重要？",
      "source_fingerprint": "01995ff79ab47d1424696b2b834325bc04124c8490d059765adf949cc05a8e81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "470"
      ]
    },
    {
      "uid": "zhcn:91aff035c779c8273aff2515",
      "kind": "text_data",
      "source_text": "觉得最难熬的训练是什么？",
      "source_fingerprint": "6ec3201036d0468168509171e65b0e9268b4f6d53502a1a16e5a2049cf406e66",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "471"
      ]
    },
    {
      "uid": "zhcn:3cf8b40479e517d355bec45e",
      "kind": "text_data",
      "source_text": "请和支持你的粉丝说句话。",
      "source_fingerprint": "bd97f0c193e731c7332a6a4a911f1451729383e0194d9b2de2ba8587079bbdf4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "472"
      ]
    },
    {
      "uid": "zhcn:7964fcd768f9d3628ad87526",
      "kind": "text_data",
      "source_text": "请告诉大家你的致胜料理！",
      "source_fingerprint": "5f6fa0a6577dbb782fac26beac7f3d9a552f2ec5385a67f587b7bf9303d0cdbf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "473"
      ]
    },
    {
      "uid": "zhcn:203b68c6e89a16cdb938a49c",
      "kind": "text_data",
      "source_text": "如果你身上有着不安的因素，会是什么呢？",
      "source_fingerprint": "cee541b54013104020ebdd6958cebc245a196e04cba7c77e394e78216f6af4d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "474"
      ]
    },
    {
      "uid": "zhcn:c723a6acdca0b870214c1b3b",
      "kind": "text_data",
      "source_text": "请告诉我们为了获胜，最重要的是什么？",
      "source_fingerprint": "01a8655f74e7d41c24bde3c90cc7a30a852ebe1549b908939c19219c7a227bb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "475"
      ]
    },
    {
      "uid": "zhcn:6e8bcb698f68ad267fb01608",
      "kind": "text_data",
      "source_text": "听说你对时间掌握得很精准。",
      "source_fingerprint": "c401d3978654fab0c698c8d0c33cb099fc35cbe66365d7183876bbfaeee49d17",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "476"
      ]
    },
    {
      "uid": "zhcn:7f74e392592f0f19345a162e",
      "kind": "text_data",
      "source_text": "请告诉我们你推荐的蛋糕。",
      "source_fingerprint": "31cdb32954b1ae8f71b0854ddf936576217a73e849327f1cce4528029ff7c8ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "477"
      ]
    },
    {
      "uid": "zhcn:44b77402209ab2ee8cb5d055",
      "kind": "text_data",
      "source_text": "竞赛前有一定会做的例行公事吗？",
      "source_fingerprint": "b8d979824f772e97a57ea17e4d58d77a71626c7fd9d74b702d60a3ae4b45b24e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "478"
      ]
    },
    {
      "uid": "zhcn:a2e6d2f5b460e2ec968c14fd",
      "kind": "text_data",
      "source_text": "对于竞赛，有什么从平常就会注意的事情吗？",
      "source_fingerprint": "132455adef026da36348ae645a8fa1a42dcf477a6b173d6425346283836ddceb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "479"
      ]
    },
    {
      "uid": "zhcn:1c0c3aeb1b19824ccc3483c5",
      "kind": "text_data",
      "source_text": "有必胜方法吗？",
      "source_fingerprint": "940cc73da55ff87dda08f4da2909d0262690150d90dd1939346f535da4b08c1b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "48"
      ]
    },
    {
      "uid": "zhcn:66f85c7d20ea96b48cd45b10",
      "kind": "text_data",
      "source_text": "有正在关注的赛马娘吗？",
      "source_fingerprint": "dae9153ff57eb86d62cefce7ca313a0308ac958b1c2fa22a3455b90c9082feab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "480"
      ]
    },
    {
      "uid": "zhcn:0f3dc852109cc5d5c8daf867",
      "kind": "text_data",
      "source_text": "请告诉我们你对今天竞赛的期许。",
      "source_fingerprint": "9dff7582ada1fd2dd53d406300cb564867ca0169783bc55164aac2300dca5186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "481"
      ]
    },
    {
      "uid": "zhcn:e9df8808b4156933861e54ab",
      "kind": "text_data",
      "source_text": "有什么事情是每天都会留意的？",
      "source_fingerprint": "873c3830df46d15c08dd0634cbb94cd2f0e02cf837cc467e5ddd0d9165275f76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "482"
      ]
    },
    {
      "uid": "zhcn:55fba0ae6e16ffe9893436b5",
      "kind": "text_data",
      "source_text": "你认为在竞赛中最重要的事情是什么？",
      "source_fingerprint": "3d00941d76605b0bf22f97911a2aa2b67da5bf5ae3b2eed8fad383b52b34948d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "483"
      ]
    },
