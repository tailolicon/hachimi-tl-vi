    {
      "uid": "zhcn:ec4e7bc4ae5c061d1af30e37",
      "kind": "text_data",
      "source_text": "ふふ。自信がなきゃここにいないよーん。\\n……なんて。カッコつけすぎ？",
      "source_fingerprint": "f86271b62da7b2c0c8085314150581141cacdff59b2d6b4767dd30804cc0bd50",
      "source_path": "text_data_dict.json",
