      ]
    },
    {
      "uid": "zhcn:611803bf582c27e848870165",
      "kind": "text_data",
      "source_text": "你们一定要相信\\n我是比谁都更strong的！",
      "source_fingerprint": "b0c14db036d4e45e99d5d1dbb8445605b4215bd7dc1ccad88453a130cd497966",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "124"
      ]
    },
    {
      "uid": "zhcn:c731b8c0930d274a82bfe38d",
      "kind": "text_data",
      "source_text": "記録にも記憶にも残るレースにしましょう！\\nでも……1着はわたしです！",
      "source_fingerprint": "42526695aa6b9c138eb43b542d1459a374d8d9ab4ea577aabdae7c18c085f622",
      "source_path": "text_data_dict.json",
