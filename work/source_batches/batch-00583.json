    {
      "uid": "zhcn:727c8261dcb4c9bec7180289",
      "kind": "text_data",
      "source_text": "わたし、負けません！　強い走りを見せて、\\n次の世代へバトンを繋いでいくためにも！",
      "source_fingerprint": "610806c802bbc41a1353f1a9d720c1203ee4cc7192e8ed297bf9636eadf9e600",
