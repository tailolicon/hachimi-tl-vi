      ]
    },
    {
      "uid": "zhcn:9221bfc250884e977ae9e1c0",
      "kind": "text_data",
      "source_text": "ああ、気に入ってくれたかい？　今日の\\nテーマは『ドルチェ』……伝わったかな？",
      "source_fingerprint": "38ea7e958a349dc065737c8195f6d22fd53c7e52667de050de91124d91559c10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1250"
      ]
    },
    {
      "uid": "zhcn:96b7c4e2c7e85fb50defcda6",
      "kind": "text_data",
      "source_text": "コン・アモーレ。至高の1曲を約束しよう。\\n私たちの奏でる愛を、全身で感じておくれ。",
      "source_fingerprint": "59e343fa1051793f7c4951ff7d76a0430988f6e3d537400daa5b35ca08ef9dec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1251"
      ]
    },
    {
      "uid": "zhcn:ef86283e95ded62eb7fea79a",
      "kind": "text_data",
      "source_text": "ああ、気に入ってくれたかい？　今日の\\nテーマは『ドルチェ』……伝わったかな？",
