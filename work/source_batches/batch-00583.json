    },
    {
      "uid": "zhcn:1c0f9920573b3f7c46b57dd6",
      "kind": "text_data",
      "source_text": "いいじゃん、いいじゃん。中途半端じゃ\\n『未知』が遠のく。……所望、バチバチ！",
      "source_fingerprint": "37b8a0ef7cfdd22338bb33989b232e269753a8671da4b82fba1822b9962cbd08",
      "source_path": "text_data_dict.json",
