    },
    {
      "uid": "zhcn:999024bdeb4997a622bbcdf9",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "呵呵，你摸摸右边的口袋看看？",
      "source_fingerprint": "a004473ab0e798af219d8f976f2a9f4ef47778e172a9a1326007cba777980c8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
