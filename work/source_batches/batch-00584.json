    {
      "uid": "zhcn:c845f560c187e8ada0a1cd77",
      "kind": "text_data",
      "source_text": "そうね……理事長の特注トラクターかしら。\\nいい重りなの。丈夫で、かわいらしくて。",
      "source_fingerprint": "532dea9d2e34157061c22c47b5347891b4e0a1982c71ce2376f4b0b16abf1b82",
      "source_path": "text_data_dict.json",
