      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "645"
      ]
    },
    {
      "uid": "zhcn:bb9992d454b7532b8ecf6abc",
      "kind": "text_data",
      "source_text": "比赛即将要开始了……莫非，你在发抖吗？",
