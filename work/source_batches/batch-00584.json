      ]
    },
    {
      "uid": "zhcn:2adc1b7e5c522b40d1708d97",
      "kind": "text_data",
      "source_text": "無論、我が聖剣――末脚の切れ味です。\\n道を阻む者は両断あるのみ。",
      "source_fingerprint": "edba0b86978d8173c6b381419d3da9bf85d87320164c0130c5f84e995a1ae911",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1332"
      ]
    },
    {
      "uid": "zhcn:36c3b6654be54a7691ea9477",
      "kind": "text_data",
      "source_text": "控室での精神統一は大切な儀。\\n主君以外の声は一切届きません。",
      "source_fingerprint": "71aa53f46b4536cec142bb72cd6965bb342f37e97c2223cb783dfd38181b62eb",
