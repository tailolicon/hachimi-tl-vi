      ]
    },
    {
      "uid": "zhcn:203a555f9038a0ffcfd32825",
      "kind": "text_data",
      "source_text": "真っ直ぐ、最短距離を走ります。\\nすると1番速い。当然のことです！",
      "source_fingerprint": "aae67c01daef4cde315d44d8b5447f206f8b290e12c76df79cc1df5ac510d145",
      "source_path": "text_data_dict.json",
