    {
      "uid": "zhcn:2958543b49d9efa18098ffe6",
      "kind": "text_data",
      "source_text": "太巻き寿司です。\\n惚れ惚れするほど真っ直ぐでした。",
      "source_fingerprint": "e3d1ea8deeb9184e2f738115556788bb2f5115ead775dc56b4eeeaac6061d390",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1293"
      ]
    },
    {
      "uid": "zhcn:3be9cddd305111d0dc39a3b2",
      "kind": "text_data",
      "source_text": "超えるべきは自分のみ。見ていろ、私！",
      "source_fingerprint": "bb3a495071ebb36193d73546368974a4ae93b5ca871f7ed7022f6e317ced5e65",
      "source_path": "text_data_dict.json",
      "json_path": [
