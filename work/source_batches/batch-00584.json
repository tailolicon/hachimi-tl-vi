        "1318"
      ]
    },
    {
      "uid": "zhcn:8f4010f9796f2dd0f79d49fa",
      "kind": "text_data",
      "source_text": "はい、いくつか。あらゆる展開を想定し、\\nそれぞれに戦略を用意しておりますから。",
      "source_fingerprint": "ec1d24bcc7a9b50f7c8c6650d67a2b3a4f535da87a01d004b7f5f7c6775e0cfa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "1319"
      ]
    },
    {
      "uid": "zhcn:e68453d8b09643de6489be30",
      "kind": "text_data",
      "source_text": "哼，我才不会让使魔看见丢脸的一面。\\n好好期待吧！",
      "source_fingerprint": "05e9659d7ea6c9980584f58544442c89964044faad1f6b0cf7cdd16f1b45ba94",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "132"
      ]
    },
    {
      "uid": "zhcn:9f3bece9101276c174f088c0",
      "kind": "text_data",
      "source_text": "食事、睡眠、鍛錬、全て疎かにできません。\\nあとは……親友との日向ぼっこでしょうか。",
      "source_fingerprint": "47a499096d7df5dd9af97f00c6817cbe946256a487d6addd521a21be133bfa64",
      "source_path": "text_data_dict.json",
