      ]
    },
    {
      "uid": "zhcn:30d1bdd193372ca72d5cb340",
      "kind": "text_data",
      "source_text": "最高速の更新。それだけです。",
      "source_fingerprint": "a5630d21c55c952da5ef56415c975c3a91ed470a98d1c593271fbd8458c5c3d0",
      "source_path": "text_data_dict.json",
