    {
      "uid": "zhcn:30bfd31057ca0188a3a90235",
      "kind": "text_data",
      "source_text": "――ふ。\\nそれ以上の言葉が、あって？",
      "source_fingerprint": "912c470ecc22d495975ceb652478a97b78b0e7dc9fbd8bdb70c281d2364db8cd",
      "source_path": "text_data_dict.json",
