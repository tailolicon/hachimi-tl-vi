        "649"
      ]
    },
    {
      "uid": "zhcn:0ef7198570759bbafbaf00af",
      "kind": "text_data",
      "source_text": "日本的竞赛感觉如何？",
      "source_fingerprint": "4592bfee947a946d862619ace242a4132ffa4a58039d19082f1809a5af8f3984",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "65"
      ]
    },
    {
      "uid": "zhcn:d45dce8c7da5671177c16fa9",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝发表一句感言！",
      "source_fingerprint": "3b0e691d9d91c19c6082542a0a1c94e0a3915e2db2bceb4c2fc701ec5a460658",
      "source_path": "text_data_dict.json",
      "json_path": [
