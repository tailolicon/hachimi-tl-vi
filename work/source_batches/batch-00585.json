{
  "schema_version": 1,
  "batch": 585,
  "batch_count": 1682,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "f1c6893d60a8989361cfd9c371f56bc8ec25f81d",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:21c619750eab77d1fa28579e",
      "kind": "text_data",
      "source_text": "勝利の暁には、何をしたいですか？",
      "source_fingerprint": "03644c27fe77853cc1654490f7744d02268eefaf9abe8a4a6466aee0a1948352",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "657"
      ]
    },
    {
      "uid": "zhcn:8c5680a79db57dde1a03737f",
      "kind": "text_data",
      "source_text": "麻烦你来一句平时的那个！",
      "source_fingerprint": "35f17c61c33ba77fa189646becb9309608edcd5a7051811623dab32556d295cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "658"
      ]
    },
    {
      "uid": "zhcn:68355a19b862a8d42a6821fd",
      "kind": "text_data",
      "source_text": "我们可以期待你的美丽吗？",
      "source_fingerprint": "a7f24e1922f77c54a52eb616f7308acd3d5a6b72ad08e098e37ec928245ea935",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "659"
      ]
    },
    {
      "uid": "zhcn:f7be2d19a25610acac6ae6b1",
      "kind": "text_data",
      "source_text": "听说你很喜欢拉面。",
      "source_fingerprint": "86698c4c5ac8be31a802ab3649d99d2ce4b1e1ea542309c1447d6447faa924c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "66"
      ]
    },
    {
      "uid": "zhcn:21446823ab3ba35b45e220ca",
      "kind": "text_data",
      "source_text": "最近总觉得肩膀特别沉重……",
      "source_fingerprint": "d054174664f0d44ef32ef0f0cb4bee88b245b389dd6507d25666008ebb9711e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "660"
      ]
    },
    {
      "uid": "zhcn:6fb45d368cb4f098143fd6b2",
      "kind": "text_data",
      "source_text": "你觉得是什么影响了竞赛的输赢呢？",
      "source_fingerprint": "421fb79b7de2fa422b9c9fbd19812bf3c6e107148c5e3f7c2438fdfcdbb76392",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "661"
      ]
    },
    {
      "uid": "zhcn:d60b9c981b50476a43a2de98",
      "kind": "text_data",
      "source_text": "你的签约训练员在决赛前看起来很慌张耶……？",
      "source_fingerprint": "a1454867fd4919fbfa5c6dac12aec486ef8360158a24c84384ab5cbd0f6a9d3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "662"
      ]
    },
    {
      "uid": "zhcn:09c3a175785e1c8601c2c4a0",
      "kind": "text_data",
      "source_text": "全国各地聚集了对你的期待！",
      "source_fingerprint": "d4ce02bbee21829ae4aaa5f4a3c824f60d0dec0507900cb667a060797edcbf11",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "663"
      ]
    },
    {
      "uid": "zhcn:bd6477164059437b0deaa1be",
      "kind": "text_data",
      "source_text": "终于到决赛了呢！",
      "source_fingerprint": "f27678946b9da613586b2f3d19b83ecef04e55558767b0e4460740dd9817bffe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "664"
      ]
    },
    {
      "uid": "zhcn:e49f1ebae805f45773ce73ae",
      "kind": "text_data",
      "source_text": "请说说你对于优胜的抱负！",
      "source_fingerprint": "fa7e130fa93755eddae26db747190cd491b568b6a0c2eab9c049b95e8d5b5ce8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "665"
      ]
    },
    {
      "uid": "zhcn:f471ec49da3bfb6f6ebe571a",
      "kind": "text_data",
      "source_text": "终于要到决赛了，有没有自信呢？",
      "source_fingerprint": "78150652c9ce30a592d1f2650d4da21441d68e50a6ba5eb6a8c30bc51408c8bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "666"
      ]
    },
    {
      "uid": "zhcn:5ee8276d8f4616cd3d6de45f",
      "kind": "text_data",
      "source_text": "对目白家的各位有什么想说的吗？",
      "source_fingerprint": "3e23022cedd1247fed45f4f9bc0cf0c1e9fd9f5a5b1f9c281031326efb66f58c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "667"
      ]
    },
    {
      "uid": "zhcn:11459562738d49db2e95a932",
      "kind": "text_data",
      "source_text": "会带什么东西去无人岛上呢？",
      "source_fingerprint": "cdd6b3b239ff0ef2dc2a8c15e705cb14540882bcca4a4f41584e4fc9261427e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "668"
      ]
    },
    {
      "uid": "zhcn:d9391a8fcc23f0160e78f4c8",
      "kind": "text_data",
      "source_text": "简单来说，锁定的名次是？",
      "source_fingerprint": "bedfd5c27046167fa045dceb93bd7c40dc911c3082a87224e4b9ef9b6e53bfc4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "669"
      ]
    },
    {
      "uid": "zhcn:f2db82ad558dade2cd6df45f",
      "kind": "text_data",
      "source_text": "对眼镜有什么坚持吗？",
      "source_fingerprint": "f6124be2be639041e168070b689222f9e318b97b2df4e6fa46263dc85bbc06b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "67"
      ]
    },
    {
      "uid": "zhcn:eb9dd19483b6a7fc0588e562",
      "kind": "text_data",
      "source_text": "请对你的家人说句话！",
      "source_fingerprint": "8adb999d21115ed54c4842c73412b1836749b33f06b2e97a30fd63397863fc7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "670"
      ]
    },
    {
      "uid": "zhcn:12eee8f51eadc372afefcedb",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "671"
      ]
    },
    {
      "uid": "zhcn:8c5e53c8223c93117829c4b3",
      "kind": "text_data",
      "source_text": "请问即将触及顶点的现在是什么心情？",
      "source_fingerprint": "b76b0de65072ea734ada183e10755a99d3c74e37db0cc5a666161754d37c18b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "672"
      ]
    },
    {
      "uid": "zhcn:77d94179eaf2a60c44cebf31",
      "kind": "text_data",
      "source_text": "迎接决赛的心境为何呢？",
      "source_fingerprint": "58c595fe2313f548ea50d79a6dd7cd3831699105ffb87896e5b35012ae48e688",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "673"
      ]
    },
    {
      "uid": "zhcn:9fc211f198ffdbae4eb121b9",
      "kind": "text_data",
      "source_text": "在跑步这件事上有什么原则吗？",
      "source_fingerprint": "9f4f905a830a6c1ac6ceb789e9021fee16da1263654650a33052af76c21b8736",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "674"
      ]
    },
    {
      "uid": "zhcn:585986f965ff561442e1b6b2",
      "kind": "text_data",
      "source_text": "竞赛获胜的话会想要怎么样的奖励呢？",
      "source_fingerprint": "996a1301ebb51f56e28f403fb681c545aaf6db34d8a01905a3eaecda0db66026",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "675"
      ]
    },
    {
      "uid": "zhcn:c2aba87485db325e99250351",
      "kind": "text_data",
      "source_text": "会希望让谁看见这场胜负呢？",
      "source_fingerprint": "4361a7ccb772f13e9d75b6132631d5b86c9732ad5a22e36fa6bf493354b93dfa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "676"
      ]
    },
    {
      "uid": "zhcn:63666e8593195f7b8770540d",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "677"
      ]
    },
    {
      "uid": "zhcn:f7b9d68fb24242c5be79fbbb",
      "kind": "text_data",
      "source_text": "请对崇拜你的后辈们说句话！",
      "source_fingerprint": "80104f428486dfeef057f8e3e5976abc0ac50ec4b3c3ebcef5272c06843d1dca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "678"
      ]
    },
    {
      "uid": "zhcn:5451571d247a1771b6550b00",
      "kind": "text_data",
      "source_text": "希望我们在竞赛中关注哪些地方呢？",
      "source_fingerprint": "acd7849ced480e4b1bd51f95942cca0e61df706efa0e533508ea511763c39c22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "679"
      ]
    },
    {
      "uid": "zhcn:2f6493a42dbb062eaa645381",
      "kind": "text_data",
      "source_text": "对BNW的那2人有什么看法？",
      "source_fingerprint": "da39ae64643e7b4bdc697865623ba9e69dc305ec99a9f8598d9b0bb8a9e0f6bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "68"
      ]
    },
    {
      "uid": "zhcn:e047383d9c607e1e72a51456",
      "kind": "text_data",
      "source_text": "可以表演魔术给我们看吗？",
      "source_fingerprint": "8012d9d6b71f6530db43efc0ec4ea77fce7ce39ee675065101eca9e94dc60024",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "680"
      ]
    },
    {
      "uid": "zhcn:e768629373ded908079c655e",
      "kind": "text_data",
      "source_text": "请对粉丝们说句话！",
      "source_fingerprint": "1398b3629ec121af8bef36cb0d63fda7a0ddfc5fdf5ca6d5c069bc57053bd1cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "681"
      ]
    },
    {
      "uid": "zhcn:155649be68f95c7a227f4d8b",
      "kind": "text_data",
      "source_text": "觉得这场备受瞩目的竞赛，有什么新鲜之处吗！？",
      "source_fingerprint": "e48ee7f7eb40fca1202a653b269388ba6913b2b0d91ff1686b16e6af020d83e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "682"
      ]
    },
    {
      "uid": "zhcn:65d318d9d659de9f16b43a36",
      "kind": "text_data",
      "source_text": "请对在故乡守护你的大家说句话！",
      "source_fingerprint": "7e4b7db7bed10fc92201e1ab1494bac8c3e81a3e784e68b0ebda93c298fe5a04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "683"
      ]
    },
    {
      "uid": "zhcn:042683062205d07930060b76",
      "kind": "text_data",
      "source_text": "决赛在即，有什么担心的事情吗？",
      "source_fingerprint": "d9d8cb4e45baa117eba49f3a1d38cd753c848cb1e7713a1437ed89a4bfd92119",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "684"
      ]
    },
    {
      "uid": "zhcn:3f915290adebb2902813d1ef",
      "kind": "text_data",
      "source_text": "请对劲敌们说句话！",
      "source_fingerprint": "64ed748702a6491cfe604801b5ea9e6b2c41f1e94595cf3b9a87dd8692d7ffa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "685"
      ]
    },
    {
      "uid": "zhcn:282963867992835d4a9fd31c",
      "kind": "text_data",
      "source_text": "会想替自己取什么别称？",
      "source_fingerprint": "d83f8284013a7e138db061a69256481cae624fc62b075e1b8c8b9cf78c827fe2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "686"
      ]
    },
    {
      "uid": "zhcn:8dc05a875718e6cf3be08ba5",
      "kind": "text_data",
      "source_text": "请问目前状态大概达到百分之几呢？",
      "source_fingerprint": "ec6a9bf23e285a06e9382c4de63f3cfe742d2c10c0be1edb7d9febbf84df85ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "687"
      ]
    },
    {
      "uid": "zhcn:84277432e5500bbe589dac1d",
      "kind": "text_data",
      "source_text": "决赛有令你感到不安的地方吗？",
      "source_fingerprint": "296055d77ce0f5606ca0e5e289ebbcc034f091d4bef086429954f8a02b995487",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "688"
      ]
    },
    {
      "uid": "zhcn:db48e41472aff3030fd4901c",
      "kind": "text_data",
      "source_text": "各方皆预期会是场激战，请问你的心境是？",
      "source_fingerprint": "649a52eb745efcd728402fc74adda338ace6a1fb0360566061b3ecf010590b8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "689"
      ]
    },
    {
      "uid": "zhcn:58ada97b829ce18d02075200",
      "kind": "text_data",
      "source_text": "有特别努力克服的课题吗？",
      "source_fingerprint": "586188be76723cd96e4ed56fe170cc6f9700944d540863bed3cf90f509e27da1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "69"
      ]
    },
    {
      "uid": "zhcn:dc9015566032cee325451dc8",
      "kind": "text_data",
      "source_text": "在决赛中会让我们见识到怎么样的表现呢？",
      "source_fingerprint": "eb9f7adc4539303ee1d4688547461581016dbc599b6dcf378c343eb89c78ccb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "690"
      ]
    },
    {
      "uid": "zhcn:d3a2eb00a502c2e6d26ce32b",
      "kind": "text_data",
      "source_text": "请对位于美国的双亲说些话！",
      "source_fingerprint": "7f973e65242045cd8579052c9e4e3e6f86ceb11d66d24f6d20d632945cdfc60b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "691"
      ]
    },
    {
      "uid": "zhcn:2bc090216993a4cac75ecd05",
      "kind": "text_data",
      "source_text": "本次的竞赛，会是高手云集吗？",
      "source_fingerprint": "70fa1115ea526e0c1b0ade626b106dc064ad27604cca9ca6ef1270eea54766a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "692"
      ]
    },
    {
      "uid": "zhcn:279a8c6c1846f5a65648b914",
      "kind": "text_data",
      "source_text": "就快到决赛了，状况如何？",
      "source_fingerprint": "9630e42d5c9d012871840bbd197b921fb58e1c9b32eae3a940fe02875fb56c78",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "693"
      ]
    },
    {
      "uid": "zhcn:ab15a5681f7d6a546f5925d1",
      "kind": "text_data",
      "source_text": "会觉得紧张吗？",
      "source_fingerprint": "3b6efe49e3ea4e77f0d196cc0d23da9389f3adb0d159bc4709603985686340a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "694"
      ]
    },
    {
      "uid": "zhcn:e0c5496c8960812954860a21",
      "kind": "text_data",
      "source_text": "请说句对竞赛的期许！",
      "source_fingerprint": "7f20d393858cbc5eaf3229ddae5ded6b3983386e8bee9612434b8571a9f807ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "695"
      ]
    },
    {
      "uid": "zhcn:efbff9aef8c966e8970677db",
      "kind": "text_data",
      "source_text": "终于要到决赛了！请问有必胜策略吗？",
      "source_fingerprint": "d88104f794712b75f5301f13765d21a1cb814effaf45543f4e29abe49d104949",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "696"
      ]
    },
    {
      "uid": "zhcn:4fcde22d4f899a23fc782262",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "697"
      ]
    },
    {
      "uid": "zhcn:89063c5850192f4fff907264",
      "kind": "text_data",
      "source_text": "请问对这场竞赛有多少把握？",
      "source_fingerprint": "e5bc11f0dbcf1ecd3bc3a8206ce1465a8786d2069e0f2f3f80dd7a024eb69b64",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "698"
      ]
    },
    {
      "uid": "zhcn:28500936ce18d774dfa68e3b",
      "kind": "text_data",
      "source_text": "若获得优胜，会希望能被谁夸奖呢？",
      "source_fingerprint": "33902c5d31bd104559882c827e0a337896169cdddd2a9b5da5b1d24befe64325",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "699"
      ]
    },
    {
      "uid": "zhcn:f1723052fffb3f8415a41a90",
      "kind": "text_data",
      "source_text": "这场竞赛备受瞩目，你觉得有把握吗？",
      "source_fingerprint": "dc13f680cb3f6c07b475749d15867f0597d85e8021ea96aeebdec88b1e1d448a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "7"
      ]
    },
    {
      "uid": "zhcn:b07e79f6afab1f3e315465b0",
      "kind": "text_data",
      "source_text": "请说说你的抱负！",
      "source_fingerprint": "7321329fe7053537673a27efce5d83991630f035a40f049626407139a041be58",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "70"
      ]
    },
    {
      "uid": "zhcn:8e565eb4eb7d5f6e3ff16dc9",
      "kind": "text_data",
      "source_text": "希望我们在决赛中关注哪些地方呢？",
      "source_fingerprint": "34bf4fd0809bc18a88085e3ca03a4c1277d3b54932d57ff9c62b874dd802e403",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "700"
      ]
    },
    {
      "uid": "zhcn:06578e2981f2ea394db8efb6",
      "kind": "text_data",
      "source_text": "想将这场竞赛献给谁呢？",
      "source_fingerprint": "86be9faeb2b005f617dce7428e8052aa038e18c42e014000b3a0095e3d44de85",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "701"
      ]
    },
    {
      "uid": "zhcn:170186d8e7c9cfefe04f49a2",
      "kind": "text_data",
      "source_text": "请说说你的抱负。",
      "source_fingerprint": "39601c88c7f0b1062a6de868e1b1bb79ab3c212b14ba3f73f03b23e5508cdd0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "702"
      ]
    },
    {
      "uid": "zhcn:11f7ec5a3cf8cf19a81757d4",
      "kind": "text_data",
      "source_text": "听说你很喜欢开场小号？",
      "source_fingerprint": "e7bd10b5dac4cf61114a97b92d19812bb0aa5a582bbf4fbefa113560f5a8f770",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "703"
      ]
    },
    {
      "uid": "zhcn:fc6a49264f80cb26a6daf2ad",
      "kind": "text_data",
      "source_text": "面对盛大的舞台，现在是什么心情？",
      "source_fingerprint": "83b7d853f8be0efb4986cf122f53ab2d0f43c8b3fb13734a64f7ed98e4e89cce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "704"
      ]
    },
    {
      "uid": "zhcn:21ac8c0930a03aeb8cea0160",
      "kind": "text_data",
      "source_text": "决赛之战有什么秘密策略吗？",
      "source_fingerprint": "5177656b54c000c3523e5c44edeaa65707f661f2b04c1802f6a5e2a5f9516912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "705"
      ]
    },
    {
      "uid": "zhcn:3fff4c15e2d04a8f0992997c",
      "kind": "text_data",
      "source_text": "决赛之战有什么秘密策略吗？",
      "source_fingerprint": "5177656b54c000c3523e5c44edeaa65707f661f2b04c1802f6a5e2a5f9516912",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "706"
      ]
    },
    {
      "uid": "zhcn:a78bf388c5eef74ef4c82878",
      "kind": "text_data",
      "source_text": "请对支持你的家人说句话！",
      "source_fingerprint": "c32438522fb770add8dfde2d8c39210783febf99e5b3e67a28982999ade2fe38",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "707"
      ]
    },
    {
      "uid": "zhcn:02be55040eb87c67091c463d",
      "kind": "text_data",
      "source_text": "我的推就是爱丽数码，我会为你加油的！",
      "source_fingerprint": "b11b27df18fd4e3235ce43642253db9d08032a525bf3b4b9aa5d518f06b84cfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "708"
      ]
    },
    {
      "uid": "zhcn:b1799ab4ab67349654d7c234",
      "kind": "text_data",
      "source_text": "决赛在即，请谈谈你的抱负。",
      "source_fingerprint": "62f4225de557f17e34be1468a793de97699494597c534e3c052a67b7d6838897",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "709"
      ]
    },
    {
      "uid": "zhcn:2e59240df4e08f41305dbc48",
      "kind": "text_data",
      "source_text": "通往第1名的视野如何？",
      "source_fingerprint": "739624bf7c6b312f4505b4842094d3ae5e9f1d3e73760435d03605d6a3f2aec4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "71"
      ]
    },
    {
      "uid": "zhcn:901081e896a9251265a7e356",
      "kind": "text_data",
      "source_text": "昨天做了怎么样的梦呢？",
      "source_fingerprint": "38cf6edb38e46bd82a646068164fa4018b31a915248798a97df78a932f667ba9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "710"
      ]
    },
    {
      "uid": "zhcn:fa46c705d1a250f196d2f8bf",
      "kind": "text_data",
      "source_text": "请对同年级的大家，说说你的抱负！",
      "source_fingerprint": "f6dfd312b5e03b79d3678c2dfdde2e4faecf658c83de1a3342960854f692d081",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "711"
      ]
    },
    {
      "uid": "zhcn:e66e1130a3c9565de8be3859",
      "kind": "text_data",
      "source_text": "决赛结束后，你想做什么呢？",
      "source_fingerprint": "316f7da4f2c0e89bf593997dd593dac0bbd865e5b577d0fb05bba5595a4a95a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "712"
      ]
    },
    {
      "uid": "zhcn:32b8b516c24aac9e52836505",
      "kind": "text_data",
      "source_text": "请对一同出赛的对手们宣战吧！",
      "source_fingerprint": "ac0c416fc871ddcb18c5adc59598a0e8186aaf3bbcbfd13e3624de7805d5ae09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "713"
      ]
    },
    {
      "uid": "zhcn:8f14cdc29ed7cbb4ad0b8cd8",
      "kind": "text_data",
      "source_text": "请针对决赛发表发表一句感言！",
      "source_fingerprint": "15608e22528142921eb74a51a43b754ba878306772954e713488103d58b42525",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "714"
      ]
    },
    {
      "uid": "zhcn:ae654a5341aaaf0d176a203b",
      "kind": "text_data",
      "source_text": "有信心获得优胜吗？",
      "source_fingerprint": "ff02efb6b31f4ee36a5ac3cee3cc69ba89bebbe84a0ceba8ec7c29988b0ca6fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "715"
      ]
    },
    {
      "uid": "zhcn:4a01d27918dd3bba5bb5f1ca",
      "kind": "text_data",
      "source_text": "简单来说，胜利方程式是！？",
      "source_fingerprint": "e0ed230c0bf259f8ec2c9e7eefdd04c8bed826868276ed0d05075e6f2f2a0eca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "716"
      ]
    },
    {
      "uid": "zhcn:1dad1c5491f61eccf48e332e",
      "kind": "text_data",
      "source_text": "至今曾面临过怎么样的障碍呢？",
      "source_fingerprint": "765ff3b28647f57bf7c5eebf74f791b94b7ccb29212f1e304eab522d3376dbbe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "717"
      ]
    },
    {
      "uid": "zhcn:582518cc201860cf7eeafcb3",
      "kind": "text_data",
      "source_text": "这次也是强者云集呢。",
      "source_fingerprint": "7e990e5b8b2edd2622e366582df104a44510db8753ca1fa3fa2b3f36dfbd815c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "718"
      ]
    },
    {
      "uid": "zhcn:4445f1da3864157f88cb2e30",
      "kind": "text_data",
      "source_text": "终于要到决赛了！请问有多少把握？",
      "source_fingerprint": "e2f97e4fd9dbe759dd43a1cfe32f373c7c2db03d5cf0b4085ae16c87635aa6a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "719"
      ]
    },
    {
      "uid": "zhcn:d7f354644969bf8d39b6e4ef",
      "kind": "text_data",
      "source_text": "有特别留意的参赛者吗？",
      "source_fingerprint": "aa5f67a56a888cf6138478ac3a27ad0b51cc718c4c23e22cd92a1b61f7468d07",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "72"
      ]
    },
    {
      "uid": "zhcn:faf1887b7356196b88819d66",
      "kind": "text_data",
      "source_text": "请告诉我们你对于决赛的抱负。",
      "source_fingerprint": "98de95fc17b3e22752a6bdc06aede85d57f5183f2a4a701b5aa4e7463a1467f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "720"
      ]
    },
    {
      "uid": "zhcn:78dcc249a799a57b22561326",
      "kind": "text_data",
      "source_text": "期待你获得优胜！",
      "source_fingerprint": "523f8940c89d63ae5057a2fbb283dda0216d6a6d0c3cacd15e77bdfbae689bf3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "721"
      ]
    },
    {
      "uid": "zhcn:9b270ce974831164c3aa50aa",
      "kind": "text_data",
      "source_text": "确定进入决赛时的心情是？",
      "source_fingerprint": "aeed2d1aaba4a387efdc6d471008d546eaf7edfb7138db95466193d349ee3be3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "722"
      ]
    },
    {
      "uid": "zhcn:b840148389e28893bb91bbb9",
      "kind": "text_data",
      "source_text": "请露出笑容，让我们拍1张刊登用的照片。",
      "source_fingerprint": "702d01163727082940a64b0d84ed8928c7d4e9eddc5d0cfa75457ebc6af148e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "723"
      ]
    },
    {
      "uid": "zhcn:f4c3f0ad60d4b124a0c6fe50",
      "kind": "text_data",
      "source_text": "请针对优胜发表你的决心！",
      "source_fingerprint": "3bef724f99cebc7dfc138c697e872da4f98e1c7c4a3bc2e4aa250e26d69ae1de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "724"
      ]
    },
    {
      "uid": "zhcn:0d696a24264ace12b267d7d5",
      "kind": "text_data",
      "source_text": "请告诉我们这场竞赛该关注哪个部分！",
      "source_fingerprint": "8722b55b608e8036a8493cb74c8718c0cfba6612e93d56c156eb44d3c3bba5cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "725"
      ]
    },
    {
      "uid": "zhcn:b7c73a470ef882c5f57a7d2c",
      "kind": "text_data",
      "source_text": "请告诉我们你对今天竞赛的期许。",
      "source_fingerprint": "9dff7582ada1fd2dd53d406300cb564867ca0169783bc55164aac2300dca5186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "726"
      ]
    },
    {
      "uid": "zhcn:182afae2e32a0bf08840b3c6",
      "kind": "text_data",
      "source_text": "看来会是一场精彩的竞赛呢！",
      "source_fingerprint": "e617932580608142b91c361f6d1f951096323a99e336bbcf57ca27229a9f1f0b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "727"
      ]
    },
    {
      "uid": "zhcn:c8089f5731eec5a318d7ac23",
      "kind": "text_data",
      "source_text": "故乡的大家也在看台前为你加油喔！",
      "source_fingerprint": "aee91006aa1fb86e0efe7e15ab790c3c85565524ebe26b03aed34782e9d9bad4",
      "source_path": "text_data_dict.json",
