    },
    {
      "uid": "zhcn:ead8ab26d61e1e3d21feade1",
      "kind": "text_data",
      "source_text": "将会场环境和参赛者运气、历象……都用风水\\n仔细观察过，并拟定了最合适的作战喔♪",
      "source_fingerprint": "3b94d040da0d6563620a81666ce2aede36051be36005d9d1a88a7516ed2f5dd4",
