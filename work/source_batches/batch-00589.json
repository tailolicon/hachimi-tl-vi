      "uid": "zhcn:d4cf547a7d1598af590b2999",
      "kind": "text_data",
      "source_text": "请谈谈你对今天竞赛的期许！",
      "source_fingerprint": "845da271ebdde5d146e7041e8745b3f666dba537d6c7a3838e63fa020a9941a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "994"
      ]
    },
    {
      "uid": "zhcn:3945e8aa15bb0ded619ab8a8",
      "kind": "text_data",
      "source_text": "听说你第一次接受采访时竟然只有两岁！",
      "source_fingerprint": "10f3f93989d1fd923992d2e953a0fe9b9ed05e2ec0d64ffb4e5f7b11cb2012ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "995"
      ]
    },
    {
      "uid": "zhcn:026efe244cae6b505c6c872e",
      "kind": "text_data",
      "source_text": "竞赛前有一定会做的例行公事吗？",
      "source_fingerprint": "b8d979824f772e97a57ea17e4d58d77a71626c7fd9d74b702d60a3ae4b45b24e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "204",
        "996"
      ]
    },
    {
      "uid": "zhcn:ea015944890d74476202b593",
      "kind": "text_data",
      "source_text": "请谈谈你对今天竞赛的期许！",
      "source_fingerprint": "845da271ebdde5d146e7041e8745b3f666dba537d6c7a3838e63fa020a9941a4",
      "source_path": "text_data_dict.json",
