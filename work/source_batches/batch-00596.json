      "kind": "text_data",
      "source_text": "过去累积的努力化成强风促使我前进。\\n所以是顺风喔。",
      "source_fingerprint": "9db972413fd533b784a9c1c9d5958f5a2ea20010106c60eebf593000e2d9306c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "936"
