        "226",
        "8001"
      ]
    },
    {
      "uid": "zhcn:3aaa5a7638d44399c7d099bc",
      "kind": "text_data",
      "source_text": "从使用回合起的3回合内，所有训练项目中可获得的属性提高40％(不可重复使用)。",
      "source_fingerprint": "fd6129da6612a7212c24bd17890ab380cda53f149d3c40481ba5c0e1d604c780",
      "source_path": "text_data_dict.json",
