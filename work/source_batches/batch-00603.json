    {
      "uid": "zhcn:c7db43a97c3c226267406c4a",
      "kind": "text_data",
      "source_text": "从使用回合起的4回合内，所有训练项目中可获得的属性提高20％(不可重复使用)。",
      "source_fingerprint": "269b4a6fc321c6a50d31a4fbf5e73614f3c689ec3a7228a96d3d177f92f1adc4",
      "source_path": "text_data_dict.json",
