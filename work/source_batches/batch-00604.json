      "uid": "zhcn:94b7a5603d36bb8c20a5ada1",
      "kind": "text_data",
      "source_text": "用长腿跑步的赛马娘……\\n如果您认识的话，请务必让她来我的队伍。",
      "source_fingerprint": "a07d9389775b7fe04944b9a4ca452a16c564d6d775c39cb2fbe253669fcf87f2",
