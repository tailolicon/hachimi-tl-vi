    },
    {
      "uid": "zhcn:9a41453faca6e49bf61f36ab",
      "kind": "text_data",
      "source_text": "我感到无比的喜悦。内心雀跃地舞动着……\\n拳脚也有如烈火般地炙热。",
      "source_fingerprint": "4d95fa7c42816d57124f33c69122bdaf8090cb38c28990156cd6adee7a3d3003",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
        "887"
      ]
    },
    {
      "uid": "zhcn:b10a528c55a782875c94c06e",
      "kind": "text_data",
      "source_text": "！……是！",
      "source_fingerprint": "a5a46b5a377e247765e497ed796d495940116067a61f68f40a76f291d3a483df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "205",
