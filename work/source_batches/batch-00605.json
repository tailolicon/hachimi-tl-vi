    },
    {
      "uid": "zhcn:2bb752d8c6bb1d44822e99b2",
      "kind": "text_data",
      "source_text": "正在寻找有力量的赛马娘。",
      "source_fingerprint": "3ea44d147da9ad4174a0aa0921642e87f17a162bc24844d8fc70e45145693925",
      "source_path": "text_data_dict.json",
      "json_path": [
        "216",
        "15006"
      ]
    },
    {
      "uid": "zhcn:c35de8f879b0898131ddd73e",
      "kind": "text_data",
      "source_text": "正在寻找擅长直至最后也不让出领头位置的赛马娘！\\n我很期待您的才干。",
      "source_fingerprint": "7f8e16dfce8768fe1f1d88641a754a323e16b840e126d4bf1ec3a8b4ac56616e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "216",
