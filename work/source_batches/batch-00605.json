    {
      "uid": "zhcn:250125d362d72da31fe1ba8d",
      "kind": "text_data",
      "source_text": "因为我是粗鲁的人，不会好好地道谢。\\n所以……我会以胜利响应大家的声援。",
      "source_fingerprint": "41e081688c8e9e2665513b110c2310b8edd6dc35c853870cce89b66c60046c47",
      "source_path": "text_data_dict.json",
