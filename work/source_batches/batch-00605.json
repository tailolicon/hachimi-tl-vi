      ]
    },
    {
      "uid": "zhcn:395891300dd7b6527773cf15",
      "kind": "text_data",
      "source_text": "无论是认识小真还是不认识小真的人。\\n我都会稍微映在大家的回忆里。",
      "source_fingerprint": "f960f8a23e98a84209c44bd00b755e896fad0e6bec0175b0923c0a8e09644ae9",
