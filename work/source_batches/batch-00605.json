      ]
    },
    {
      "uid": "zhcn:7dd336910dce0673f5a280dd",
      "kind": "text_data",
      "source_text": "我把冰淇淋苏打摇一摇了。\\n口感变得很绵密，而且清凉爽口喔。",
      "source_fingerprint": "43a19cef8622517b9a26853e141b7bf0dd3958863ef2b1b3dc2904a37715a79d",
      "source_path": "text_data_dict.json",
      "json_path": [
