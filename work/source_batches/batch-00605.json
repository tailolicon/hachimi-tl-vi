    {
      "uid": "zhcn:74fc1b2adf36ba0129206cc2",
      "kind": "text_data",
      "source_text": "正在募集可在沙土发挥实力的赛马娘！\\n请您务必向我介绍。",
      "source_fingerprint": "337b828d2b04c948917c71ab1a0fbf240b6280bdbedae6106227da0a822aede1",
      "source_path": "text_data_dict.json",
