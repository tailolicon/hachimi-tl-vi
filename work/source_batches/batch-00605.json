      ]
    },
    {
      "uid": "zhcn:6bb38dfdddcd1c403810dc5a",
      "kind": "text_data",
      "source_text": "是小真之眼喔。这份闪耀，\\n请保存在你心中的相簿里吧。唔唔。",
      "source_fingerprint": "0db36180cfb999fea145831d03f328f8af205d8c6f99436ff87c1f13b343b8aa",
      "source_path": "text_data_dict.json",
