      ]
    },
    {
      "uid": "zhcn:ecdda6e8417ff0fe0e2ca353",
      "kind": "text_data",
      "source_text": "不管是比赛、粉丝的声援，还是潮流。\\n所有的第一名都由小真拿走了。",
      "source_fingerprint": "ba047afe870cd7a2546926655af43b8568db7fe0197023ee816cde14078bf142",
      "source_path": "text_data_dict.json",
