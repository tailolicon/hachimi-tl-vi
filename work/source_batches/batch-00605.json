    },
    {
      "uid": "zhcn:8d588706c8887adfef3fded6",
      "kind": "text_data",
      "source_text": "！……是！",
      "source_fingerprint": "a5a46b5a377e247765e497ed796d495940116067a61f68f40a76f291d3a483df",
      "source_path": "text_data_dict.json",
