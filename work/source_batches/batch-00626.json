    {
      "uid": "zhcn:03af2cf3bd06488701ee2eb0",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，在强者聚集的这一战中获得第1的是<color=#ff9900><character_name></color>！",
