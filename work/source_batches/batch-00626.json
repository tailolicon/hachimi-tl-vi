      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "10102"
      ]
    },
    {
      "uid": "zhcn:e96ee803e29ced5a7cbe5356",
      "kind": "text_data",
      "source_text": "以<bashin>漂亮地称霸了战况激烈的竞赛。",
