    {
      "uid": "zhcn:65cbd1f5c7a7594f7a3273eb",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "充分发挥足以掌握梦想的实力。",
      "source_fingerprint": "ab9c6d4f4269c1f252031a0c43df97fc4c3f9094ce6210a5870841abe5497ff3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
