    {
      "uid": "zhcn:6daab07567d8abdc7e975476",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在欢欣鼓舞的<color=#ff9900>群英月赛</color> 第1轮竞赛中，由<color=#ff9900><character_name></color>拿下第1！",
      "source_fingerprint": "dd5e2f5a615cf8698bf957d45b6fa8f4f99be8a24d51c71b712068cc95166d36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
