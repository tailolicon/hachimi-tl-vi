    {
      "uid": "zhcn:d54bc98bb1468d38b87f2552",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，在大批观众注目下获胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "9037ebbf0884d0d32f0d2b371e56c01e5df533321192d872e5597d6666b1602c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
