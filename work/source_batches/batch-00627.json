    {
      "uid": "zhcn:586692ccedd1f4faf546ea44",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在所有人都憧憬的盛大舞台<color=#ff9900>群英月赛</color> 决赛上，获胜的是<color=#ff9900><character_name></color>！",
