    },
    {
      "uid": "zhcn:b1f081285886cd88aab4878f",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在重要的<color=#ff9900>群英月赛</color> 一战中获胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "49191235593facbb36e0a6c8fcee7b8e2486d52e3d08164590c5b8eb78bd51d6",
