      ]
    },
    {
      "uid": "zhcn:4d5a0eb49c4a6a8525a9d811",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，<color=#ff9900>「<username>」</color>的<color=#ff9900><character_name></color>再度拿下第1！",
      "source_fingerprint": "759ae9ebe50b632d928dbc679027ad079fb9ef0837451bc036153d12f0c900c9",
      "source_path": "text_data_dict.json",
      "json_path": [
