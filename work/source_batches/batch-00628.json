        "122"
      ]
    },
    {
      "uid": "zhcn:45d015fb205575fa4e7d6b96",
      "kind": "text_data",
      "source_text": "<character_name>\\n不容许他人望其项背",
      "source_fingerprint": "cf10efb60ece30e9150a88e8735cd1063d2d950976222228b929676082bc60f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "123"
      ]
    },
    {
      "uid": "zhcn:e6a42015758b437da56e6fbc",
