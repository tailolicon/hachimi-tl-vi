        "22001"
      ]
    },
    {
      "uid": "zhcn:c4c44bbec74e64efa3fae898",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第2轮，漂亮地在重要战役中抢下了胜利的是<color=#ff9900><character_name></color>！",
