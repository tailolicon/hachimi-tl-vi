        "2001"
      ]
    },
    {
      "uid": "zhcn:f29242eeeef0766b5b957b78",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，在重要战役中抢下胜利的是<color=#ff9900><character_name></color>！\r\n",
      "source_fingerprint": "ba3e3d8351a55a6036236353353e463319458b4f9f5b2025e961e4b056548fd8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2002"
      ]
    },
    {
      "uid": "zhcn:61a163dc2854b7545bd4ade0",
      "kind": "text_data",
      "source_text": "以完美表现将重大的一胜带给<color=#ff9900>「<username>」</color>。",
      "source_fingerprint": "713b1cc2fc6d9fbceffa4d28b8ccc1d6e1398747e3a34b9ced9fe528d03eb551",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "201"
      ]
    },
    {
      "uid": "zhcn:e04708204aa0eb9000a7bef6",
      "kind": "text_data",
      "source_text": "即使是初次出赛，依旧展现了精彩的表现。",
      "source_fingerprint": "07d9369f93a301dc654202a29bec9ed36755e120d07cfe2fdaec772e03209f4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20100"
      ]
    },
    {
      "uid": "zhcn:9bacfa54ff10041b948dd72e",
      "kind": "text_data",
      "source_text": "以完美表现将重大的一胜带给<color=#ff9900>「<username>」</color>。",
      "source_fingerprint": "713b1cc2fc6d9fbceffa4d28b8ccc1d6e1398747e3a34b9ced9fe528d03eb551",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20101"
      ]
    },
    {
      "uid": "zhcn:9948a6d036b1a265e0f0b6cf",
      "kind": "text_data",
      "source_text": "如彗星般现身，彻底支配竞赛，并且顺利称霸。",
      "source_fingerprint": "34d44c31c85b3a156a3f8bf762b67562cde187f983da6ae2a03bcfd67d729292",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20102"
      ]
    },
    {
      "uid": "zhcn:9009bdea907a4c0ef75ba060",
      "kind": "text_data",
      "source_text": "如彗星般现身，彻底支配竞赛，并且顺利称霸。",
      "source_fingerprint": "34d44c31c85b3a156a3f8bf762b67562cde187f983da6ae2a03bcfd67d729292",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "202"
      ]
    },
    {
      "uid": "zhcn:96d2bbf1b198f7871a26cd3f",
      "kind": "text_data",
      "source_text": "这名赛马娘的第2战也绝不容错过！",
      "source_fingerprint": "c99bbb682f3641f10a9b4357137bf56e75c3b2b26220c3f1f2696a2813f18ac3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20200"
      ]
    },
    {
      "uid": "zhcn:fa212c13509337e57746e074",
      "kind": "text_data",
      "source_text": "非常期待她今后的表现！",
      "source_fingerprint": "952c24cb31697a81e9d9bd90ffc7b4c154aaa26b470ba56a8bf2f12b55163e9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20201"
      ]
    },
    {
      "uid": "zhcn:8820ffc873edd6ec0f04595f",
      "kind": "text_data",
      "source_text": "值得将她视为大赛中需瞩目的赛马娘来持续关注。",
      "source_fingerprint": "0e21076abefe3dc59a1509d0f764e709a7c025ea8fcc18aaa04fed4e1ab320ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20202"
      ]
    },
    {
      "uid": "zhcn:1b1f29369a9f937b6b1b75e2",
      "kind": "text_data",
      "source_text": "她发挥擅长一决胜负的实力，在粉丝间的支持度也逐渐攀升。",
      "source_fingerprint": "459aebd292c29b12a8c3b45fb7b50a254e68b6ee1cbff23b2c5d353329aecabb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2100"
      ]
    },
    {
      "uid": "zhcn:9a20c7416ed755bdac8bc810",
      "kind": "text_data",
      "source_text": "<color=#ff9900><character_name></color>顺利在<color=#ff9900>群英月赛</color> 第2轮竞赛中摘下首次胜利！",
      "source_fingerprint": "5d82f7b15776e924d6d1836f5b7c7087161a6a043c1adc79b0ca2fa2237b1fab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21000"
      ]
    },
    {
      "uid": "zhcn:23e06c792daacbdce5341330",
      "kind": "text_data",
      "source_text": "在盛况空前的<color=#ff9900>群英月赛</color> 中，<color=#ff9900><character_name></color>如愿摘下了首次胜利。",
      "source_fingerprint": "f1106362d700d19dd155c33465224284f0e44e0833cc10645da368ddc340568b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21001"
      ]
    },
    {
      "uid": "zhcn:7db811001ed96cd9209c3af8",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第2轮。<color=#ff9900><character_name></color>以<bashin>成功获胜！",
      "source_fingerprint": "cf0761e3126f4cd5235dc551b11e55affb38babf8a004c44f755a789d5f230c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21002"
      ]
    },
    {
      "uid": "zhcn:22127a7be56a2fe105365312",
      "kind": "text_data",
      "source_text": "虽然她在本次大赛中的出场次数还不多，但已具备大人物的气势。",
      "source_fingerprint": "7b4a874db39656871dfe881db3bad491ecc868f96dfa0c389952a760c4554bbd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2101"
      ]
    },
    {
      "uid": "zhcn:2ae75535cd66a0780173d309",
      "kind": "text_data",
      "source_text": "即使面对盛大舞台也能不退缩地发挥实力，足以证明其为强者。",
      "source_fingerprint": "62b683ee035e3f26e261e453a60bb53cff43f4c5f19e1990f0e33c9fbc945fe8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2102"
      ]
    },
    {
      "uid": "zhcn:f7273d5537661b30cbbe3fa8",
      "kind": "text_data",
      "source_text": "她成功向大家展现了不亚于评价的实力。",
      "source_fingerprint": "de3e33e41ca31dfa4a749c7165f6bddb036fcf4e399d1ff7344de473ef3b68b1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21100"
      ]
    },
    {
      "uid": "zhcn:46d2591be132aa0c1ff9e483",
      "kind": "text_data",
      "source_text": "运用<total_race_count>次的战败经验，完全适应了这场竞赛。",
      "source_fingerprint": "ebcf9bb4ab131fcb8a2d9a32c9015fe8cc6fa0b49424fd36447906d3c8130794",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21101"
      ]
    },
    {
      "uid": "zhcn:06a68128316a2c30e6409288",
      "kind": "text_data",
      "source_text": "她彻底发挥本来的实力，向大家展露了精彩的表现。",
      "source_fingerprint": "06d82432aec84a03c56725a3bd6c36bab606edc1850825c6cdecb27e5b2552d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21102"
      ]
    },
    {
      "uid": "zhcn:9fab5cb45662234b4ff88537",
      "kind": "text_data",
      "source_text": "似乎能从现在起趁胜追击！",
      "source_fingerprint": "cc37b4b62fbda6201f97d12224630655b1c6ee2177185f22f9900853665559a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21200"
      ]
    },
    {
      "uid": "zhcn:78aad1d77e49fe777f0fb47e",
      "kind": "text_data",
      "source_text": "现在开始将冠以本次大赛的主角名号！",
      "source_fingerprint": "240f47fb116078437345d53bf2670e17c54fba30892eba5066cccc3fda4acbe6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21201"
      ]
    },
    {
      "uid": "zhcn:00cf5340c72139568e074386",
      "kind": "text_data",
      "source_text": "让我们关注下一场竞赛吧。",
      "source_fingerprint": "e25141b3aa20f8f6d7849ee8132310fa092f4b3042efdb9f15f6fb269702f72e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "21202"
      ]
    },
    {
      "uid": "zhcn:185a7f09b5156a6c7d61b704",
      "kind": "text_data",
      "source_text": "让我们继续期待这名赛马娘今后的精彩表现吧。",
      "source_fingerprint": "c1724a4f25819e932cc177ffff6f50ce608d67bc60f2579519774289f267349e",
      "source_path": "text_data_dict.json",
      "json_path": [
