    {
      "uid": "zhcn:e6c00686b7c76f96ba662bbd",
      "kind": "text_data",
      "source_text": "<character_name>\\n以极小差距获胜",
      "source_fingerprint": "54cef00f1c504b307fcc25b87157c3b4d2a33b65be43272f841e4fa99dc4f9bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "112"
      ]
    },
    {
      "uid": "zhcn:c877be8b677e0aa87b1bd7ec",
      "kind": "text_data",
      "source_text": "<character_name>\\n以些微之差获胜",
      "source_fingerprint": "cc43caa9631e95eef1f319ec3a3ae0cc15820ceac7993f94c69be3d7234c4056",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "113"
      ]
    },
    {
      "uid": "zhcn:5db1c10e2dbd6ece060b8176",
      "kind": "text_data",
      "source_text": "在竞争中胜出的是\\n<character_name>",
      "source_fingerprint": "bf5c99fe6c0242ca6e54fbcf81f598c158cd1528f4345388bb79db7675e8e2af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "114"
      ]
    },
    {
      "uid": "zhcn:465b8bdec46cf9b0216eb06b",
      "kind": "text_data",
      "source_text": "拿下胜利的是\\n<character_name>",
      "source_fingerprint": "a130ba1abb12ba08322b870c91406dd30acc28750f69cf9257d580a10c550f57",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "115"
      ]
    },
    {
      "uid": "zhcn:f340c4a5d1ab26c20c32c212",
      "kind": "text_data",
      "source_text": "在激斗中称霸的是\\n<character_name>",
      "source_fingerprint": "0914a9ffcb0162f186119b33fcefac81aacdaaf0d58cbf783b06b22328272702",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "116"
      ]
    },
    {
      "uid": "zhcn:3c6bc5627bb077dcf87fa6d2",
      "kind": "text_data",
      "source_text": "<character_name>\\n获得完全胜利！",
      "source_fingerprint": "b0a4f7edee182ab598f71787ff756be435ae1a97c8a7d94ca5f9339f1b354414",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "117"
      ]
    },
    {
      "uid": "zhcn:a05731b8a47c67a6fb3c6104",
      "kind": "text_data",
      "source_text": "谁都追不上\\n<character_name>",
      "source_fingerprint": "1f7743a3eaceabc251542e135ff823ad431ca7f9fbba8e87d7cfbe6f83e953e3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "118"
      ]
    },
    {
      "uid": "zhcn:7d72a603d83ee88ddcaaa5b8",
      "kind": "text_data",
      "source_text": "<character_name>\\n使他人望尘莫及！",
      "source_fingerprint": "800769c982105fff91d03466a736f7ad5cd320a82d63db5edafebd4b873a6b26",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "119"
      ]
    },
    {
      "uid": "zhcn:4309682a3ce6f1a12834bd8a",
      "kind": "text_data",
      "source_text": "<character_name>\\n以<bashin>称霸",
      "source_fingerprint": "671b4997b1841e24c52788154cde9dc4c5888b603de2c2aeece6f3cb2b6bc3fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "12"
      ]
    },
    {
      "uid": "zhcn:4d7d0dea674d1ad7f9814a65",
      "kind": "text_data",
      "source_text": "这名赛马娘的实力\\n深不可测！",
      "source_fingerprint": "e7a261cd0eeb40c0616e662f7b2ed4d2ddfabb4dbcc216e0489284bb80caf946",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "120"
      ]
    },
    {
      "uid": "zhcn:f3c1c400ea24f7fa8898e723",
      "kind": "text_data",
      "source_text": "<character_name>\\n的实力超群",
      "source_fingerprint": "72b058e3030fd127b847deabd5161fe366b3fd3e79e8c86937fda6c6de698573",
      "source_path": "text_data_dict.json",
      "json_path": [
        "229",
        "121"
      ]
    },
    {
      "uid": "zhcn:97797e790af76427e0aa45ce",
      "kind": "text_data",
      "source_text": "有能够战胜这名\\n赛马娘的对手吗？",
      "source_fingerprint": "92f1ed42bf8454be07dc826ad3b5db40a4b5ad457d6969cf0a628ea4392a69ce",
      "source_path": "text_data_dict.json",
      "json_path": [
