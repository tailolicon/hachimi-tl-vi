    },
    {
      "uid": "zhcn:6fe869c6f63f9c5ddedae5b2",
      "kind": "text_data",
      "source_text": "于热闹的<color=#ff9900>群英月赛</color> 中漂亮地摘下了重大胜利的是<color=#ff9900><character_name></color>！",
