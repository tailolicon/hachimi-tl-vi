      "source_text": "于前列以稳健的表现顺利地击败了对手。",
      "source_fingerprint": "b6813197caedf1ab36fb6fa4ad98f2eecefd47f4f5f2e41217898ee282f3bf29",
      "source_path": "text_data_dict.json",
