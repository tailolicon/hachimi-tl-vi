    {
      "uid": "zhcn:36e47aad00a1c58f4f5e139d",
      "kind": "text_data",
      "source_text": "在波涛汹涌的<color=#ff9900>群英月赛</color> 上，为<color=#ff9900>「<username>」</color>带来胜利的是<color=#ff9900><character_name></color>！",
