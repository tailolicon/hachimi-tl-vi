        "110000"
      ]
    },
    {
      "uid": "zhcn:ca7f29b3b91799034324736e",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 决赛，称霸这场关键对决而决定一切的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "d5e2f613708f59b11abf5220e150fc0a3973a860ef823aa287ab0c108d4c8baa",
      "source_path": "text_data_dict.json",
