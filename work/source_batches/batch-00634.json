      ]
    },
    {
      "uid": "zhcn:635798ea7973a648bc4d4127",
      "kind": "text_data",
      "source_text": "是<color=#ff9900><character_name></color>！在<color=#ff9900>群英月赛</color> 以<bashin>称霸并拿下第1。",
      "source_fingerprint": "0a721be0592776c3e2d16855edf3d7f98a9b3b7040c26b1c3e903e7212726d42",
      "source_path": "text_data_dict.json",
