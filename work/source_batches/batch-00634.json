    },
    {
      "uid": "zhcn:11f443c84b7b531cf16ecd12",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 决赛，称霸这场世纪之战的是<color=#ff9900><character_name></color>！",
