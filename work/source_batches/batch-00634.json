    {
      "uid": "zhcn:9f592b98c35b54231e784385",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，在这场极具意义的重要竞赛中获胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "0f94658e5bd5116d308a3f2950797ff602635c2e057c2365656b5c0f72977fc4",
