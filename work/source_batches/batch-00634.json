        "110002"
      ]
    },
    {
      "uid": "zhcn:8990cbc558e4b73d8264807c",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，<color=#ff9900><character_name></color>以<bashin>称霸了竞赛！",
      "source_fingerprint": "7c4aeb258af0caf4681ad2bdbb2bd36784f56dcec5f3283001b63969184ade4b",
      "source_path": "text_data_dict.json",
