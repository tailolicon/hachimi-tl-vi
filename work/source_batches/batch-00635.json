  "entries": [
    {
      "uid": "zhcn:f12c81efe5671debac9e7227",
      "kind": "text_data",
      "source_text": "她在参赛者净是强豪的竞赛中，竟然以<bashin>胜出了。",
      "source_fingerprint": "b940cb9503cb3e58f66ada4a317e1ce317249c100a389e7d5aa064f2fab95230",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12104"
      ]
    },
    {
      "uid": "zhcn:d1e012d353ae5b4be3f6e913",
      "kind": "text_data",
      "source_text": "作为<color=#ff9900>「<username>」</color>的王牌漂亮地打赢了一场硬仗。",
      "source_fingerprint": "89a68c044d528d572038f01a5df347ab086e9912fcdaea14f2ed039868026f8c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12105"
      ]
    },
    {
      "uid": "zhcn:bb8b8c01a49080ceebb832ee",
      "kind": "text_data",
      "source_text": "以利落的领头之姿，从头到尾称霸竞赛。",
      "source_fingerprint": "b3a94b6407f63bbfe4db511b1ad8c9523b7652557609df960588c7ed1236f7f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12106"
      ]
    },
    {
      "uid": "zhcn:f76c701070840939f17ad5b0",
      "kind": "text_data",
      "source_text": "于前列以稳健的表现顺利地击败了对手。",
      "source_fingerprint": "b6813197caedf1ab36fb6fa4ad98f2eecefd47f4f5f2e41217898ee282f3bf29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12107"
      ]
    },
    {
      "uid": "zhcn:7fe53c8e8fbcf73cd917aa72",
      "kind": "text_data",
      "source_text": "充分发挥速度，以精彩的居中支配了竞赛。",
      "source_fingerprint": "7e160aa9cc09562fe9f1aacd9edd1ced625d25884c6e63e17f4e6786bf9a0820",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12108"
      ]
    },
    {
      "uid": "zhcn:6a97a0941dab389d83121e68",
      "kind": "text_data",
      "source_text": "以漂亮的后追，一个一个地超越了对手。",
      "source_fingerprint": "01e42e39105bf0d3ed3e523007703e09fe05d02600291575d2f943a40d039741",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12109"
      ]
    },
    {
      "uid": "zhcn:30916fe83ba262ae991d435c",
      "kind": "text_data",
      "source_text": "希望还能够持续看到如此精彩的表现。",
      "source_fingerprint": "caca7ce435219560096ccc9eba9ad08ed71e68ea3d673fa1076290f4882cd4ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12200"
      ]
    },
    {
      "uid": "zhcn:d0ad87c86a0b2478a2fcd24c",
      "kind": "text_data",
      "source_text": "究竟能攀登至那里呢？让人无法移开视线。",
      "source_fingerprint": "aa46217a07ba803ba7c416628895157c1f849d9e3f93fed7c60b2d505b4a9780",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12201"
      ]
    },
    {
      "uid": "zhcn:8932261046f589eab1a74796",
      "kind": "text_data",
      "source_text": "可别错过这名赛马娘和大家约定好要获得的成功……！",
      "source_fingerprint": "e205a4a2d3a4f2f99a6bf0b5eba5473c6028687ec2e69a0bc5925e4c39709383",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "12202"
      ]
    },
    {
      "uid": "zhcn:abf08bbae6bbb0b9419bf6b3",
      "kind": "text_data",
      "source_text": "座无虚席的<color=#ff9900>群英月赛</color> 第1轮竞赛！<color=#ff9900><character_name></color>漂亮地摘下了胜利。",
      "source_fingerprint": "6f32c8071611a780faa84a6747bc26d3a8ca6aa33f11325fdeb1d288265577f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13000"
      ]
    },
    {
      "uid": "zhcn:e9adc40b732af66e9e9b8433",
      "kind": "text_data",
      "source_text": "在<color=#ff9900>群英月赛</color> 决赛中证明了自己最强最快的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "6b1d18adfcc5e13616a82e5705ab78facb2f957c52529d4f60c34919e5452995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130000"
      ]
    },
    {
      "uid": "zhcn:e52d71cc576e2346b548fc9f",
      "kind": "text_data",
      "source_text": "最精彩的<color=#ff9900>群英月赛</color> 决赛，坐上了最强宝座的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "9934b3b31b51571ddcb63d11a9e3ef60215affd819add4607ffe97100789d357",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130001"
      ]
    },
    {
      "uid": "zhcn:a89a60fa3a05164a2ccad4fd",
      "kind": "text_data",
      "source_text": "在<color=#ff9900>群英月赛</color> 决赛中，以完美的表现技压各高手的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "53fb517c3bcbeb2ed5cc9c9e24dab378c880438cc84584742c15d0e017f1041a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130002"
      ]
    },
    {
      "uid": "zhcn:95f6920c670a4fb15c3a80e5",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，逼退众多强者们取胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "c7f2c6ad63e5b977959b6aaf92eab64dc362eefc2795896e635135df2e749724",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13001"
      ]
    },
    {
      "uid": "zhcn:a4fbffee8f92b5bba1ea1a1d",
      "kind": "text_data",
      "source_text": "<color=#ff9900><character_name></color>！在高手云集的<color=#ff9900>群英月赛</color> 第1轮竞赛中顺利拿下第1。",
      "source_fingerprint": "ea827bae1be82fcc989dacd9f5886397ad5d3b5422e0869e69a46d5ea57df2cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13002"
      ]
    },
    {
      "uid": "zhcn:3450066bf0d48304dcd91b80",
      "kind": "text_data",
      "source_text": "作为<color=#ff9900>「<username>」</color>的得力好手达成伟大成就。",
      "source_fingerprint": "1c4c70dc3d2207ed7b77f871a6faa87bd600662847b46f001912f02ef3d4e0d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130100"
      ]
    },
    {
      "uid": "zhcn:14950b090cb8371db604f587",
      "kind": "text_data",
      "source_text": "作为大赛的主角，展现出了有别于其他对手的实力。",
      "source_fingerprint": "4bd5e147deca1c2eb55a0ccda2c4b1c72afe99e9cf1c4ee8bcb5f1ba2735c041",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130101"
      ]
    },
    {
      "uid": "zhcn:99ad79662e3df1dc46fa7381",
      "kind": "text_data",
      "source_text": "从预赛一开始就持续展示压倒性的实力，就连决赛也拿下了。",
      "source_fingerprint": "3c73bddea86e8182d918e09dcba8dd38aa0833ad5a871aaf1bd1c544cff9acb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130102"
      ]
    },
    {
      "uid": "zhcn:b178212738d7646b5ed1688c",
      "kind": "text_data",
      "source_text": "说绝对能获得优胜也不为过吧。",
      "source_fingerprint": "2d35e9c48435fddf85079a3a2c3fb3518701c88973abe482a842dfa7659d0bd6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130200"
      ]
    },
    {
      "uid": "zhcn:0ea33f9d2e2bbc95ec87edab",
      "kind": "text_data",
      "source_text": "属于最强且最优秀的赛马娘所拿下的杰出胜利。",
      "source_fingerprint": "c7c6124be28038a5cf9a838d92537a3d2da0dc36fd89bd9d9c0506758ef9f4ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130201"
      ]
    },
    {
      "uid": "zhcn:f13f6f50388d2eb81d4509f5",
      "kind": "text_data",
      "source_text": "在大赛中展现完美无瑕的出色表现，并获得优胜。",
      "source_fingerprint": "9bbfe46962372c66e608fe1dede9fd0a80a747eda6e644fcfd1f09a6ea1969d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "130202"
      ]
    },
    {
      "uid": "zhcn:bed305d5456f67e9a8411a3f",
      "kind": "text_data",
      "source_text": "至今5战3胜的状态还不错，照这个气势下去也能称霸这场竞赛。",
      "source_fingerprint": "1320b0349e87523e009bef5db8e9c296940bc8d1ed29a8f00ee53aade11dbb2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13100"
      ]
    },
    {
      "uid": "zhcn:a558db6a120fbd32a007b629",
      "kind": "text_data",
      "source_text": "在本次大赛一帆风顺地一路胜出的赛马娘，让这场竞赛也十分精彩。",
      "source_fingerprint": "7188321109904a0eea7113fcc12ebc32d60e044cb176ce14ee8c63358def2073",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13101"
      ]
    },
    {
      "uid": "zhcn:8b376965a9cf8eff3ff037c5",
      "kind": "text_data",
      "source_text": "即便解说也只能想到赞美的话语，以完美表现拿下的胜利。",
      "source_fingerprint": "c6ec596782905c1424b38b1732ca77ce69fe304c2b44631d211c91b5db56db46",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13102"
      ]
    },
    {
      "uid": "zhcn:d422c602421c3d2fbc3ebeec",
      "kind": "text_data",
      "source_text": "展现出了让人一看就明白为何会有如此高胜率的表现。",
      "source_fingerprint": "19e35614cfc343ebf5eb3c066acbadbf8919f1cbe29544f520f3208663d8300c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13103"
      ]
    },
    {
      "uid": "zhcn:4ab4dab2f15f75bfb30c7843",
      "kind": "text_data",
      "source_text": "以<bashin>激烈地交战到现在，胜利已是垂手可得。",
      "source_fingerprint": "2b1d0bcfe763c861dfccd15061b7f9b9395413027342a38509a49a74b4d22bf1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13104"
      ]
    },
    {
      "uid": "zhcn:975af30fcd333045072946a2",
      "kind": "text_data",
      "source_text": "以<bashin>跑出无法想象她会输的完美胜利。",
      "source_fingerprint": "8bc6a6f94f5a8056541ba13ddc50a83ca50d7a9b522d313d944a412dbf0566cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13105"
      ]
    },
    {
      "uid": "zhcn:2a1319c17adbf8c73e9f6eaa",
      "kind": "text_data",
      "source_text": "<color=#ff9900>「<username>」</color>的评价也扶摇直上。",
      "source_fingerprint": "843be21c5d61e9058ae85bbfe7f6d40dc0c736e2763f0d2d2f039dd23055bec4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13200"
      ]
    },
    {
      "uid": "zhcn:474fb28481b03b899717112c",
      "kind": "text_data",
      "source_text": "已经备受瞩目的她，究竟还会站上多高的地方呢……！",
      "source_fingerprint": "ed37972978e674b5b94b98fa43ecd1d9643e51e4efcd5b5c78becb93bd5a9ce8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13201"
      ]
    },
    {
      "uid": "zhcn:c7da18f6968a8a4732311551",
      "kind": "text_data",
      "source_text": "让人现在就开始期待她之后的参赛。",
      "source_fingerprint": "8898c4689fe67a8d6347549858906341519ab6acbbd8e0846c3bb43e1138346a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "13202"
      ]
    },
    {
      "uid": "zhcn:657ab1b95b039c137f3e6872",
      "kind": "text_data",
      "source_text": "被狂热席卷的<color=#ff9900>群英月赛</color> 第1轮竞赛。再度获胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "e3f5cb8a701654ef79648f35d32ffd838445d0874131fb989a8d29ef90e81b5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14000"
      ]
    },
    {
      "uid": "zhcn:85ae781d57ffb0a732245689",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 决赛。",
      "source_fingerprint": "466efd3cd9ea9c0f3b6b1a92235317a41b93cc130146106c8100b78226958558",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "140000"
      ]
    },
    {
      "uid": "zhcn:e0e3ee81a199492d838c263d",
      "kind": "text_data",
      "source_text": "撼动灵魂的<color=#ff9900>群英月赛</color> 第1轮竞赛！顺利获得了第1的是<color=#ff9900><character_name></color>。",
      "source_fingerprint": "58694da236ba90f038d41787c5d2e10ca28223cbe6100dbd242ed0d185d2dff8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14001"
      ]
    },
    {
      "uid": "zhcn:c7e70bd36e5e0384c9a5f157",
      "kind": "text_data",
      "source_text": "是<color=#ff9900><character_name></color>！在<color=#ff9900>群英月赛</color> 第1轮以<bashin>胜出了。",
      "source_fingerprint": "99f5dabcf54017b629b22d4806d498af831e0eb13c3ea9b4ec44c68c2a5f8762",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14002"
      ]
    },
    {
      "uid": "zhcn:6617846476dfe96abcfb9324",
      "kind": "text_data",
      "source_text": "<color=#ff9900>「<username>」</color>的<color=#ff9900><character_name></color>。",
      "source_fingerprint": "ca1ea6b1a88452ff30fdeb931ca9a94c26169a297f81f18bc27b7bc1448b2686",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "140100"
      ]
    },
    {
      "uid": "zhcn:a2ad8a832620c520ac783202",
      "kind": "text_data",
      "source_text": "大赛中毫无败绩的「最强赛马娘」在此诞生了。",
      "source_fingerprint": "a246aeb7aac348c31962614d77834639b86415a7deed93706bc0ce58add11a25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "140200"
      ]
    },
    {
      "uid": "zhcn:fd09c28def191ff74a6e102e",
      "kind": "text_data",
      "source_text": "至今5战4胜的状态绝佳，照这个气势下去也能彻底称霸这场竞赛。",
      "source_fingerprint": "1ec075d4d84780ac3217b8e5542d7dc215e50c33b260a31d30b29c66d3580e14",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14100"
      ]
    },
    {
      "uid": "zhcn:62c59ceb8f2addcb6c640c06",
      "kind": "text_data",
      "source_text": "观众们沸腾的声援宛如地表轰隆作响，诉说着她的惊人表现。",
      "source_fingerprint": "2ed2563c8f7bcde39b4994c87fdfa8bc7fbeb7bd5016e5adaf152aea38659ab3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14101"
      ]
    },
    {
      "uid": "zhcn:88260cd9a1cfd9de8af6fe99",
      "kind": "text_data",
      "source_text": "她一路过关斩将，想来对手们也束手无策了吧。",
      "source_fingerprint": "aa57c4ec8848a5886e7806ed18c9e081628e05511d7ecd17741cbe0e1b220c8c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14102"
      ]
    },
    {
      "uid": "zhcn:ec76f85842532549d23af1b0",
      "kind": "text_data",
      "source_text": "展现出了让人一看就明白为何会有如此高胜率的表现。",
      "source_fingerprint": "19e35614cfc343ebf5eb3c066acbadbf8919f1cbe29544f520f3208663d8300c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14103"
      ]
    },
    {
      "uid": "zhcn:bbd0ac2c3789756e78687d13",
      "kind": "text_data",
      "source_text": "可别错过大赛中超级备受瞩目的选手接下来的竞赛……！",
      "source_fingerprint": "443a9deef2b24e58b619f1bd384766bdcdcb39786c7f5ce7936efe55122cda1e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14200"
      ]
    },
    {
      "uid": "zhcn:de647ac5d4fb76b91477f3e7",
      "kind": "text_data",
      "source_text": "甚至还听见说她会获胜简直是理所当然的声音。",
      "source_fingerprint": "857cd92fc2b453507e1d90b866d03df93388d8ee493927df149dd2f7906bec57",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14201"
      ]
    },
    {
      "uid": "zhcn:bdac53709d448df5042efe70",
      "kind": "text_data",
      "source_text": "会出现能够战胜眼前这名赛马娘的对手吗？",
      "source_fingerprint": "e078cd56f4fd8bc369ec4b63e098827bb6c47d5cb1b0434776763a57642835e3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "14202"
      ]
    },
    {
      "uid": "zhcn:dcc84f2877f1817cafccfa7d",
      "kind": "text_data",
      "source_text": "<color=#ff9900>「<username>」</color>的得力好手<color=#ff9900><character_name></color>再度于<color=#ff9900>群英月赛</color> 中获胜！",
      "source_fingerprint": "af5d39fd28f5a4fb6c3303022012c608e0144c6fe0a0700540581e1af505429d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15000"
      ]
    },
    {
      "uid": "zhcn:97d74e3a26c36deff8ccc24b",
      "kind": "text_data",
      "source_text": "在赛况激荡的<color=#ff9900>群英月赛</color> 第1轮竞赛中，<color=#ff9900><character_name></color>理所当然地拿下第1。",
      "source_fingerprint": "ddd7be8bd54032f938f48f5c5ba01b24572fa45b8087b409e95f91e6ba7bd617",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15001"
      ]
    },
    {
      "uid": "zhcn:4134cd790baed86993783128",
      "kind": "text_data",
      "source_text": "在强者集结的<color=#ff9900>群英月赛</color> 上依旧没有大爆冷门。获胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "68efe6e8764c278b89be9c3283c27e93fadb8a86846cd8da23d5d9878c83aa4d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15002"
      ]
    },
    {
      "uid": "zhcn:7df70fe81e07c47d4eaa4bef",
      "kind": "text_data",
      "source_text": "至今的战绩为5战5胜，所向无敌的赛马娘再度获胜。",
      "source_fingerprint": "39065383b9c9c2d91b1e5ac9f9ea1b0e4cc1a09ef7598d18b8ec50374bc97d8d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15100"
      ]
    },
    {
      "uid": "zhcn:d74e6286db541c960a40ead5",
      "kind": "text_data",
      "source_text": "众人都预测她会获胜，而她也没有违背众人的期待拿下了胜利。",
      "source_fingerprint": "908492f3e40d69e31646f07b64dc02b043d2ac5ed060318d934db4e8b9c565e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15101"
      ]
    },
    {
      "uid": "zhcn:265ff0101e0f7f1d8109da37",
      "kind": "text_data",
      "source_text": "从起跑开始就展现足以震撼会场般疾风怒涛的表现。",
      "source_fingerprint": "60ee69d22068f74bce979e15593bbe9f735b9ecdd5bf638ac5c4150ac65f2e5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15102"
      ]
    },
    {
      "uid": "zhcn:82b9cd3d28efa13f6f589883",
      "kind": "text_data",
      "source_text": "好强、好强、太强了。等不及想看她的下一场比赛。",
      "source_fingerprint": "fb6c1867cba8636a9b6fb32d66c64f8719a2ec3c794f01cb12163facd352ea09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15200"
      ]
    },
    {
      "uid": "zhcn:b4c52cc2c5803c5451e85b03",
      "kind": "text_data",
      "source_text": "是打破以往认知的最强选手。",
      "source_fingerprint": "06eed2119d357e71210a472106e905af54bdf45f58fd8c03d8af20bef59ad872",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15201"
      ]
    },
    {
      "uid": "zhcn:9e25ecd55354d89efcd75faf",
      "kind": "text_data",
      "source_text": "身为大赛的主角，想必连在决赛也会居高临下吧。",
      "source_fingerprint": "8a78cf47b7d876d9252bfc452e64b20cf8d84e9ef66dbd8576160ae3d4fb86b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "15202"
      ]
    },
    {
      "uid": "zhcn:a979658e0a7527964009e379",
      "kind": "text_data",
      "source_text": "即使是初次出赛，依旧展现了精彩的表现。",
      "source_fingerprint": "07d9369f93a301dc654202a29bec9ed36755e120d07cfe2fdaec772e03209f4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "200"
      ]
    },
    {
      "uid": "zhcn:a0a261dbe112dafaea3192de",
      "kind": "text_data",
      "source_text": "于热闹的<color=#ff9900>群英月赛</color> 中漂亮地摘下了重大胜利的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "1fef315d6a0a75cf8121a34d412a3f8fa5fcb3bd2968e4d4d325e7ad9b735372",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2000"
      ]
    },
    {
      "uid": "zhcn:a99e7783880aa833f52897fa",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第2轮，逼退众多强者拿下第1的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "16a7207814627dc47fdc3cb74f003b861441fd6d6c741f68a8a9b352b3fd2c34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20000"
      ]
    },
    {
      "uid": "zhcn:30245bfd49e6a6c9270e5315",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第2轮，漂亮称霸这场重要竞赛的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "5103a0a6c073964905be0282ac966d2faea7e9ec7170079ab84470ecb40ab3d0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "20001"
      ]
    },
    {
      "uid": "zhcn:6f935c38060f1eb44e8349d3",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第2轮，在令人屏息的赛况中漂亮获胜的是<color=#ff9900><character_name></color>！",
      "source_fingerprint": "fe97845116e0775743163c32a824381f451fa4cb3452cf691c9a57c2f5d8f3f4",
      "source_path": "text_data_dict.json",
