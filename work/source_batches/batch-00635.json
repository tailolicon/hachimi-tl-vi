      ]
    },
    {
      "uid": "zhcn:4d5a0eb49c4a6a8525a9d811",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，<color=#ff9900>「<username>」</color>的<color=#ff9900><character_name></color>再度拿下第1！",
      "source_fingerprint": "759ae9ebe50b632d928dbc679027ad079fb9ef0837451bc036153d12f0c900c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2001"
      ]
    },
    {
      "uid": "zhcn:f29242eeeef0766b5b957b78",
      "kind": "text_data",
      "source_text": "<color=#ff9900>群英月赛</color> 第1轮，在重要战役中抢下胜利的是<color=#ff9900><character_name></color>！\r\n",
      "source_fingerprint": "ba3e3d8351a55a6036236353353e463319458b4f9f5b2025e961e4b056548fd8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "230",
        "2002"
      ]
    },
    {
      "uid": "zhcn:61a163dc2854b7545bd4ade0",
