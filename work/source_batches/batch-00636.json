        "1433"
      ]
    },
    {
      "uid": "zhcn:c6f98aa0f269817e1a198921",
      "kind": "text_data",
      "source_text": "赛事结束后，您会进行怎样的护理？",
      "source_fingerprint": "c4d1ab245aba6a5995099709e889176b8fecb0f14f502e2b89e5fd5bc852c342",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1434"
      ]
    },
    {
      "uid": "zhcn:124c88bb31aae43fe9a14cf7",
      "kind": "text_data",
      "source_text": "接下来的比赛，有您关注的选手吗？",
      "source_fingerprint": "a5a250660dcd98ffecef35098db9342088970fd141811c222e33bed9d1ce5039",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1435"
      ]
    },
    {
      "uid": "zhcn:ad9de9eea9baa1233922c946",
      "kind": "text_data",
      "source_text": "听说令堂也来应援了？成为您的动力了吗？",
      "source_fingerprint": "798887bccebbc3742bb4963d7176acbee3491a41e244f39bbf784c0146541563",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1436"
      ]
    },
    {
      "uid": "zhcn:65a824badfd8ac4c8c0f74be",
      "kind": "text_data",
      "source_text": "听说为了今天的胜利，您的朋友也给予了帮助？",
      "source_fingerprint": "b5abc869c3ba505d309faf0e590e9dc69d00e8d4ec3bc955a271a404caf83150",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1437"
      ]
    },
    {
      "uid": "zhcn:9878eb17a621b61f582bbc9b",
      "kind": "text_data",
      "source_text": "冲线的瞬间，您在想些什么？",
      "source_fingerprint": "5eefbda550a9803762fd2ac63776c520eff2fcbaa13bd7bd1d5f6258e6559ce4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1438"
      ]
    },
    {
      "uid": "zhcn:909ff5260f058cc52a58ed9a",
      "kind": "text_data",
      "source_text": "听说令堂也来应援了？成为您的动力了吗？",
      "source_fingerprint": "798887bccebbc3742bb4963d7176acbee3491a41e244f39bbf784c0146541563",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1439"
      ]
    },
    {
      "uid": "zhcn:967a8fd33fd4870de1e45dc3",
      "kind": "text_data",
      "source_text": "听说你小时候出人意料地很顽皮……？",
      "source_fingerprint": "c80a8e75419a75e6b7a274b1a8fc9374ec2ac3860acea29dea6e9ffd9f776ddd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "144"
      ]
    },
    {
      "uid": "zhcn:7a24e5383d48748a9065f27e",
      "kind": "text_data",
      "source_text": "听说为了今天的胜利，您的朋友也给予了帮助？",
      "source_fingerprint": "b5abc869c3ba505d309faf0e590e9dc69d00e8d4ec3bc955a271a404caf83150",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1440"
      ]
    },
    {
      "uid": "zhcn:02ad4a667a153559f89bf976",
      "kind": "text_data",
      "source_text": "冲线的瞬间，您在想些什么？",
      "source_fingerprint": "5eefbda550a9803762fd2ac63776c520eff2fcbaa13bd7bd1d5f6258e6559ce4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1441"
      ]
    },
    {
      "uid": "zhcn:bcd428acad2e24fdce71106e",
      "kind": "text_data",
      "source_text": "想对一直支持您的粉丝们说什么？",
      "source_fingerprint": "54642f3f23f5b9537540b34ddff29cd86cb6e9bd60e83aab5a905464d74553af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1442"
      ]
    },
    {
      "uid": "zhcn:57a53f2f79b2ca7174ac5206",
      "kind": "text_data",
      "source_text": "请对训练员说句话吧！",
      "source_fingerprint": "42e1bf4bbcbf1e65fbf1588a8589f5eefe8df4c24bca048417cec6458e6cc1c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1443"
      ]
    },
    {
      "uid": "zhcn:5619f419721c7d6a1997efd7",
      "kind": "text_data",
      "source_text": "想对一直支持您的粉丝们说什么？",
      "source_fingerprint": "54642f3f23f5b9537540b34ddff29cd86cb6e9bd60e83aab5a905464d74553af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1444"
      ]
    },
    {
      "uid": "zhcn:968d8e9dd88c2b94102a2395",
      "kind": "text_data",
      "source_text": "请对训练员说句话吧！",
      "source_fingerprint": "42e1bf4bbcbf1e65fbf1588a8589f5eefe8df4c24bca048417cec6458e6cc1c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1445"
      ]
    },
    {
      "uid": "zhcn:6203dd82bbdf65a5af0f0082",
      "kind": "text_data",
      "source_text": "简直称得上是『精湛技艺』的奔跑，太精彩了！",
      "source_fingerprint": "7d6f310223416ad8a9453f9da1f1d951b65990cc086c1f5c1de392d4efe9636d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1446"
      ]
    },
    {
      "uid": "zhcn:36e0a56057ea85cf29c04c60",
      "kind": "text_data",
      "source_text": "这场较量，您是怀着怎样的抱负来挑战的呢？",
      "source_fingerprint": "1e0126fbb3a1c63bd99a82d483582a840d7869ba22f09575f6edf0039371490f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1447"
      ]
    },
    {
      "uid": "zhcn:0d858703044dd6a35e152ac0",
      "kind": "text_data",
      "source_text": "有举办庆功宴之类的计划吗？",
      "source_fingerprint": "e6dcacf0aa72c78eb1f9a828e9b3a675cf73289ce1d7e3a56758dfbceb64e6bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1448"
      ]
    },
    {
      "uid": "zhcn:17c2e828f4e4808cf24b9a31",
      "kind": "text_data",
      "source_text": "现在有想要立刻分享这份胜利喜悦的人吗！？",
      "source_fingerprint": "9716f7dc912bbc8636d5e77666d95894218dcdcba45909dfe80e8a982caa3146",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1449"
      ]
    },
    {
      "uid": "zhcn:9b37fb63a341480b307bff9d",
      "kind": "text_data",
      "source_text": "之后有什么安排？",
      "source_fingerprint": "a270602359d37b5635e2e4f7eacb6f9ede86da81e30238d1deeb55432eb0c191",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1450"
      ]
    },
    {
      "uid": "zhcn:c197f35c8e96d9270d7b8f0a",
      "kind": "text_data",
      "source_text": "有举办庆功宴之类的计划吗？",
      "source_fingerprint": "e6dcacf0aa72c78eb1f9a828e9b3a675cf73289ce1d7e3a56758dfbceb64e6bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1451"
      ]
    },
    {
      "uid": "zhcn:e9a908a684f72be3365fd331",
      "kind": "text_data",
      "source_text": "现在有想要立刻分享这份胜利喜悦的人吗！？",
      "source_fingerprint": "9716f7dc912bbc8636d5e77666d95894218dcdcba45909dfe80e8a982caa3146",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1452"
      ]
    },
    {
      "uid": "zhcn:af72a710d81bf27a176de7ab",
      "kind": "text_data",
      "source_text": "之后有什么安排？",
      "source_fingerprint": "a270602359d37b5635e2e4f7eacb6f9ede86da81e30238d1deeb55432eb0c191",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1453"
      ]
    },
    {
      "uid": "zhcn:1964fe5fd0c7d65e437ba6e3",
      "kind": "text_data",
      "source_text": "让我们见识到了非常棒的『工作』呢——！",
