    {
      "uid": "zhcn:86ec526c974e8265cd73832c",
      "kind": "text_data",
      "source_text": "直白地说，你认为自己的强项是什么？",
      "source_fingerprint": "b7f8dae9bd1b2f76373687807e436360eda68574e28c5955a3c65859b116dca7",
      "source_path": "text_data_dict.json",
