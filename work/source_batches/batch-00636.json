      "kind": "text_data",
      "source_text": "对一起赢得胜利的训练员说点什么吧！",
      "source_fingerprint": "33fc219ef8cb350c2c123fc3e15e292b2e56b623250e573d19ef45aa3dfefb91",
      "source_path": "text_data_dict.json",
