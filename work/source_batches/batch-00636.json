      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1471"
      ]
    },
    {
      "uid": "zhcn:76239e8cc9fb307d47419d49",
      "kind": "text_data",
      "source_text": "期待您在决赛中也能取得胜利！",
