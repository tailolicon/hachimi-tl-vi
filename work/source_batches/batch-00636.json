      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1430"
      ]
    },
    {
      "uid": "zhcn:423707d1c6a2494c0d51e521",
      "kind": "text_data",
      "source_text": "那是一场甚至让人感到“恐惧”的奔跑……",
