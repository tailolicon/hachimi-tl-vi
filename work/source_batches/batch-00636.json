        "1432"
      ]
    },
    {
      "uid": "zhcn:2cf66a0d572dcb966acc9274",
      "kind": "text_data",
      "source_text": "那是一场甚至让人感到“恐惧”的奔跑……",
      "source_fingerprint": "2197b0ed9be4d7f10de8c30310f37c1c2a459f1e0b9aff3fa764ac4b8c6a8a04",
      "source_path": "text_data_dict.json",
      "json_path": [
