      "kind": "text_data",
      "source_text": "让我们见识到了非常棒的『工作』呢——！",
      "source_fingerprint": "0b17fdd83b51cd2e55c71bcdc76b82fc4765557755eb4d33ab6a3ab7c2c24b40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1456"
      ]
    },
