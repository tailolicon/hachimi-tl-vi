      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1431"
      ]
    },
    {
      "uid": "zhcn:99f6d2adb79c21545cc97c4f",
      "kind": "text_data",
      "source_text": "您觉得这次的胜利，很有自己的风格吗？",
      "source_fingerprint": "a3aff85a8d439ed2e7f9e7d20ff4fd5ca1277634371daf56572cee1601180ade",
      "source_path": "text_data_dict.json",
