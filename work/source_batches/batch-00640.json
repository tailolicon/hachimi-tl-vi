{
  "schema_version": 1,
  "batch": 640,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:28ff2de56d27c569703485f5",
      "kind": "text_data",
      "source_text": "经历过最辛苦的训练是？",
      "source_fingerprint": "2d14e74c2d2cefc93ad09d2713ec28ccc66732ccb53c360e2e4422737c8f5d87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "280"
      ]
    },
    {
      "uid": "zhcn:40d7289073d49bccf22e1304",
      "kind": "text_data",
      "source_text": "面对众所瞩目的决赛，现在的心情是？",
      "source_fingerprint": "0244bc8403dd00dff9486b4f25a3f030939f78adff10a562d58d3aa3a18f6380",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "281"
      ]
    },
    {
      "uid": "zhcn:416be4c7abe95b986e9cce8e",
      "kind": "text_data",
      "source_text": "与训练员进行特训的成果出来了呢！",
      "source_fingerprint": "0d23c2e3b9483268e257b819f7246a8a2a8fb07ff434f9e37f8327ec808dd08b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "282"
      ]
    },
    {
      "uid": "zhcn:e05bb828f1f5581c05c21776",
      "kind": "text_data",
      "source_text": "你是怎么面对获胜时收到的盛大欢呼呢？",
      "source_fingerprint": "e1bce0df8a0c6273c5cdeadad35ece9d091dde69b0b9890725fe84c1ead126c4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "283"
      ]
    },
    {
      "uid": "zhcn:def36bc308337c49d0eb41b1",
      "kind": "text_data",
      "source_text": "决赛时会采取哪种作战呢？",
      "source_fingerprint": "e425898b03152e180204dc565e8b806acb9742245a03f442dfc57245afb091d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "284"
      ]
    },
    {
      "uid": "zhcn:07ce98dae5a22b2b019cf696",
      "kind": "text_data",
      "source_text": "请对粉丝说句话！",
      "source_fingerprint": "e4120d78fbf1092e6b2fafd181fece9e0af0ec5b78238248d9a4228d438d3c77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "285"
      ]
    },
    {
      "uid": "zhcn:5c83357251d760d09a08446f",
      "kind": "text_data",
      "source_text": "决赛时会对上更难应付的强敌吧……？",
      "source_fingerprint": "c5f29df2c0c89c8a70d9960c85a854e18ea32f7963cc655b12aa476005d10bcd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "286"
      ]
    },
    {
      "uid": "zhcn:0a9d81602365c51d0ee698d8",
      "kind": "text_data",
      "source_text": "预计要用什么当成「给自己的奖励」？",
      "source_fingerprint": "7f40f6f635f5ed8e74fbf8d0ed5ed1bebf64ec203b6198cbe1717e56ad0b01ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "287"
      ]
    },
    {
      "uid": "zhcn:e988974979c3340d9ab51a57",
      "kind": "text_data",
      "source_text": "即使是决赛，胜者舞台的C位也……？",
      "source_fingerprint": "eb95b7953473e330d93fab6acb83405e664e3e6954b559ec84d4bb2b69cb7aa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "288"
      ]
    },
    {
      "uid": "zhcn:63bc8bc13e0d50015f76b493",
      "kind": "text_data",
      "source_text": "决赛时会对上更难应付的强敌赛马娘吧……？",
      "source_fingerprint": "c0bf280125361ce925708ce4a0a503eb735c6033d29e8bac1d868a8a0c7d9a39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "289"
      ]
    },
    {
      "uid": "zhcn:1503d8d170068346ed678acf",
      "kind": "text_data",
      "source_text": "请对粉丝发表一句感言。",
      "source_fingerprint": "11442f32578f8e66299a851b9c0e4147b9f539fd37b494326e6661b70cf96da8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "29"
      ]
    },
    {
      "uid": "zhcn:4e8f9d7afe5c2be8ab258be0",
      "kind": "text_data",
      "source_text": "宛如游隼般的极速表现实在太帅了！",
      "source_fingerprint": "1d73e84245dd01b553b451cc3a269e27bb654b42e57e842b89bc55b9502183b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "290"
      ]
    },
    {
      "uid": "zhcn:05272a49756b5447f6af0a30",
      "kind": "text_data",
      "source_text": "之后就是决赛！感觉能如自己所想地进行吗？",
      "source_fingerprint": "11c35fb88408c92a6d58941903912244d9d74d45650fe32441a6f7a8f0216b25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "291"
      ]
    },
    {
      "uid": "zhcn:c6f5d7c4fbb0b5e0e7d45339",
      "kind": "text_data",
      "source_text": "有没有关键时刻必吃的致胜料理呢？",
      "source_fingerprint": "9c9d3145d7b2522e86dee7b6213190fce8888b9500d18cf55ac3de2abc525d00",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "292"
      ]
    },
    {
      "uid": "zhcn:63df1d6a3ca8a35b2c4fda07",
      "kind": "text_data",
      "source_text": "你表现得相当从容，不紧张吗？",
      "source_fingerprint": "e3f1a84886b58d0c658adfa8ebf00f5196059a5bf04ab47b42bef31d01bedd74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "293"
      ]
    },
    {
      "uid": "zhcn:b6e6cdf2e86d92e39e91babd",
      "kind": "text_data",
      "source_text": "你觉得下一场竞赛会获胜吗！？",
      "source_fingerprint": "0f6c745f934d5338ee6757785852a02540842fa11d3ad378af53109da87e48a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "294"
      ]
    },
    {
      "uid": "zhcn:cb85cc1c52d1a0e64bf37127",
      "kind": "text_data",
      "source_text": "会想将这次的胜利传达给谁呢？",
      "source_fingerprint": "9a3aacf7bd22d81aedb86e65ffa6085109bbf8dbd7b49e803fc91b716666e2f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "295"
      ]
    },
    {
      "uid": "zhcn:0a4145ec0b5047cfd3361970",
      "kind": "text_data",
      "source_text": "已经决定好祈求好运的美甲款式了吗？",
      "source_fingerprint": "93b013a1a1181b71a9f46b8843c74f2572b2076d52c7b4d4503582077fd9d02c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "296"
      ]
    },
    {
      "uid": "zhcn:3597906ce62cf7863ae85d58",
      "kind": "text_data",
      "source_text": "胜利的祕诀莫非是你嘴里的糖果……？",
      "source_fingerprint": "da5d7c816a50dbd5ea4dfc139d3cccd9c136c644b3c33736c8532b0a6f6000fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "297"
      ]
    },
    {
      "uid": "zhcn:ce4a0692024815652c139fb8",
      "kind": "text_data",
      "source_text": "直白地说，获胜的原因是什么呢？",
      "source_fingerprint": "4806defc7425eeebf1eabb7fd994210a67c482a09903e8deff93623747a92ff3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "298"
      ]
    },
    {
      "uid": "zhcn:bc3d1d10b870dd50cbc265fd",
      "kind": "text_data",
      "source_text": "请对粉丝说句话。",
      "source_fingerprint": "5158e5968d3925472a69db66731a6b7d470a51af6c432a70560917953d76b24c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "299"
      ]
    },
    {
      "uid": "zhcn:73b4d08e861a1bcb6701a906",
      "kind": "text_data",
      "source_text": "粉丝的欢呼如雷贯耳呢。",
      "source_fingerprint": "0ca2f2c8f5dd954359d61406e7d254189fb9900d74c08b2e88ac4670bd2e5361",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "3"
      ]
    },
    {
      "uid": "zhcn:ae2ec8db079dba02b3190c20",
      "kind": "text_data",
      "source_text": "回顾竞赛，哪个部分是重要关键？",
      "source_fingerprint": "3d6b030acb89e9f85b8682921647f60ab99fbbd7340e2e4e731a832a0e221740",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "30"
      ]
    },
    {
      "uid": "zhcn:d7e1f0a0b500e0fcfb89385d",
      "kind": "text_data",
      "source_text": "可以预见决赛时会聚集更多强敌赛马娘……",
      "source_fingerprint": "3217d2821f73b820a3af5a5a8d3770066b708a7d2c4a1824089bf108d25e261f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "300"
      ]
    },
    {
      "uid": "zhcn:fd7b32f64ab85a0f87c29ec5",
      "kind": "text_data",
      "source_text": "有令你在意到想在决赛一起奔驰的选手吗？",
      "source_fingerprint": "b47ca6985bb52e28b3991c73d86a709a0aebd38ffba24a770630275dd1c7b299",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "301"
      ]
    },
    {
      "uid": "zhcn:8e827e44c0f96c960185592f",
      "kind": "text_data",
      "source_text": "利落的表现简直就像变魔术一样！",
      "source_fingerprint": "2d7278ef9eea7bc851c9dd37e6505c7f487e67699f5be984bc582134a3ca3bef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "302"
      ]
    },
    {
      "uid": "zhcn:3bf3c138818e99ac61ea00f8",
      "kind": "text_data",
      "source_text": "刚才在粉丝面前摆出的可爱动作是？",
      "source_fingerprint": "89be043b9143e7457746ffea54a025a5ebb378a2717cef40592618d4ec05faa4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "303"
      ]
    },
    {
      "uid": "zhcn:f9b7b34e13674ef0c5dcf892",
      "kind": "text_data",
      "source_text": "你一路走来给人的印象都很沉稳对吧？",
      "source_fingerprint": "6ca539b6213ed65572a2c78e7c8e9fade1bb1d7065ee3cd0226f8351b90f4cbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "304"
      ]
    },
    {
      "uid": "zhcn:eeadad4ccb80f1b8f65cf0be",
      "kind": "text_data",
      "source_text": "请针对决赛说说你的抱负！",
      "source_fingerprint": "16f9fcb1324a705a0dca15b0434206f448fddaf820e5172eee7b85e4b9b6b1ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "305"
      ]
    },
    {
      "uid": "zhcn:c6605cfbfb0f0d614fa7c73f",
      "kind": "text_data",
      "source_text": "那个护身符是朋友送的吗？",
      "source_fingerprint": "5d8c087f9f3d6ec7153f92dd11b65e690576929ab56650984745c0b70e91e996",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "306"
      ]
    },
    {
      "uid": "zhcn:7df6237929c2dc80d0292852",
      "kind": "text_data",
      "source_text": "你能一直保持充沛活力的秘诀是？",
      "source_fingerprint": "52c5ea14c02df6373eb59ef590083d679c86f453295e1b564c8d24396a979721",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "307"
      ]
    },
    {
      "uid": "zhcn:c31efd62a0b5640cf0aa91b3",
      "kind": "text_data",
      "source_text": "你的表现被评论为「能让人获得勇气」喔！",
      "source_fingerprint": "bc1cf49313e76de5fe770e7102a010ff2f14cc651db0bcd3360f3a45414a7767",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "308"
      ]
    },
    {
      "uid": "zhcn:428831338de723dcd1be430d",
      "kind": "text_data",
      "source_text": "面对粉丝有什么想传达的消息吗？",
      "source_fingerprint": "776b960cc4021fbf10e010eea0314ac4f0030b415e61c0abaa868e46d1883815",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "309"
      ]
    },
    {
      "uid": "zhcn:e142ef940075a66a8886f67a",
      "kind": "text_data",
      "source_text": "出赛前吃的角色便当是「致胜料理」吗？",
      "source_fingerprint": "448e57d753d5da5434995ab947a7ea06d800429481ae4370c50edfb0c2ccd6a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "31"
      ]
    },
    {
      "uid": "zhcn:32650dd3e7cc60593c3b94c1",
      "kind": "text_data",
      "source_text": "请告诉我们让你感到松一口气的瞬间是何时？",
      "source_fingerprint": "a8f2b1c245da02bd001d34b079e6c5d3ac523fdf3f1cd4d196c646a78359e93b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "310"
      ]
    },
    {
      "uid": "zhcn:cf58dd823d1be1ac9edf46f6",
      "kind": "text_data",
      "source_text": "请告诉我们在竞赛前必做的流程！",
      "source_fingerprint": "9cfb48ea8fde81b42f084bf27887484a0802de6e66e61b0c3eae174e44571cdb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "311"
      ]
    },
    {
      "uid": "zhcn:e14c3d81d1f8cc1987c41e24",
      "kind": "text_data",
      "source_text": "日頃心掛けていることは？",
      "source_fingerprint": "7e0202af73cb60b0733dbe94590ad3c9c44db26fee93342daef3f8a0953def8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "312"
      ]
    },
    {
      "uid": "zhcn:78058a34695c57f99f6548c0",
      "kind": "text_data",
      "source_text": "レース後のウマトック投稿、すごい反響でしたね！",
      "source_fingerprint": "e7b2166f0b3121c42188dc0e023e1468421493997db8524f2484d2e7b085cea1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "313"
      ]
    },
    {
      "uid": "zhcn:0b6b56fbe02af9e60c961e07",
      "kind": "text_data",
      "source_text": "勝負メシはなんですか？",
      "source_fingerprint": "e0e9fe3bf80ea4c38312a56e0c1153737b6f9befcfe7fb156018f9d31e412958",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "314"
      ]
    },
    {
      "uid": "zhcn:80072514ffc8bdd0ff1003e5",
      "kind": "text_data",
      "source_text": "竞赛时特别注重什么地方呢？",
      "source_fingerprint": "17049ea9c281943667741ca2198a84af023a580e9b6c96caf5b7f4cb887081e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "315"
      ]
    },
    {
      "uid": "zhcn:9180782dd84950a85d69c0e7",
      "kind": "text_data",
      "source_text": "最后冲刺时飞舞的缎带令人印象深刻！",
      "source_fingerprint": "c312235862222cddd8ae18eafded8c97a4591061730309cb891b14287191166c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "316"
      ]
    },
    {
      "uid": "zhcn:4393bd151773ab8a19313c6b",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "317"
      ]
    },
    {
      "uid": "zhcn:eafe0b4656bf61cc322cb996",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝发表一句感言！",
      "source_fingerprint": "3b0e691d9d91c19c6082542a0a1c94e0a3915e2db2bceb4c2fc701ec5a460658",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "318"
      ]
    },
    {
      "uid": "zhcn:5a952210e0a5edf5bc8bfdc1",
      "kind": "text_data",
      "source_text": "签约训练员是否也发挥了庞大的助力呢？",
      "source_fingerprint": "f0fb0fba5f86ee2a6ede22173f48e5635a9c5077a64d9a58884f4101b90a4d61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "319"
      ]
    },
    {
      "uid": "zhcn:ddcf3e5d0d6a46120ad6c8b1",
      "kind": "text_data",
      "source_text": "请说说你对于下一场比赛的抱负！",
      "source_fingerprint": "e1ea1aeae061dd93ae11abfe6be09cf2980330d1aa29cc0c0f0bffbfe29c7291",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "32"
      ]
    },
    {
      "uid": "zhcn:b12a422b7357115b40638663",
      "kind": "text_data",
      "source_text": "请针对下场比赛说出你的抱负！",
      "source_fingerprint": "2b90b7dfd011593ab25e80e411c31c2c72407eb7cb28a5d180632dc70dcd1506",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "320"
      ]
    },
    {
      "uid": "zhcn:cd01e7f8ef1bd32aed22f2f4",
      "kind": "text_data",
      "source_text": "这份喜悦想要传达给谁呢？",
      "source_fingerprint": "ba95759be7d5eb21d39ba1e7be3acd96a947c48b22d54aa3fd9c4474ba098acc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "321"
      ]
    },
    {
      "uid": "zhcn:ae6ad6562a66edf6cf7bece6",
      "kind": "text_data",
      "source_text": "有想吃什么来庆祝胜利吗？",
      "source_fingerprint": "9962fbb6d266f3cd2a310be09f0b71c08436a4e9570d15c5d83dfe7a7ee2e46c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "322"
      ]
    },
    {
      "uid": "zhcn:a2f36dd22aedbc163951facb",
      "kind": "text_data",
      "source_text": "在比赛结束后有安排什么娱乐吗？",
      "source_fingerprint": "afc37c73267afe38167a3fedc3dc06592c89723afc1a906e4fa4c78313f8281f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "323"
      ]
    },
    {
      "uid": "zhcn:40345c2a6a7425d738ec710e",
      "kind": "text_data",
      "source_text": "是做了什么讨吉利的事而赢得了比赛呢？",
      "source_fingerprint": "953d3417ce5fcb870689dd6989d47331077070db4277ced8c03ad1c7db11ac2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "324"
      ]
    },
    {
      "uid": "zhcn:7818113c9e43a177596624f3",
      "kind": "text_data",
      "source_text": "领先抵达终点的瞬间，你在想着什么呢？",
      "source_fingerprint": "bb3168a68d659cda8d63c858fd0217e0eed3fa40237bf36b0c03b1234ec89530",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "325"
      ]
    },
    {
      "uid": "zhcn:2ca21e2df3abd89edd608199",
      "kind": "text_data",
      "source_text": "请说说你对下场比赛的抱负。",
      "source_fingerprint": "e0a355a96d14e009e3c82891b4bf0383e4f8378e0addc2af78fda5085e8f4c9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "326"
      ]
    },
    {
      "uid": "zhcn:32a284f9de3add075b5576be",
      "kind": "text_data",
      "source_text": "可预见决赛时会聚集更多强者赛马娘喔？",
      "source_fingerprint": "f77b190cbfc2ceeb83936689e14beb00bb2c4d257031134d65d50c416af8d96a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "327"
      ]
    },
    {
      "uid": "zhcn:b327ffe6f4f85f0aec02d3ea",
      "kind": "text_data",
      "source_text": "有意见表示期待决赛是「目白家对决」喔？",
      "source_fingerprint": "efc708433b31b5acd56f0fb98b904897ddd3240e1194ff5cb2af3be0f18b9dec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "328"
      ]
    },
    {
      "uid": "zhcn:906e1c16a09782de8ae6d719",
      "kind": "text_data",
      "source_text": "多伯总是给人很冷静的感觉呢……",
      "source_fingerprint": "69174a6b663a21199636e11c1ce189de4cf4e6a82a8de8910c38dc5f54f5c145",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "329"
      ]
    },
    {
      "uid": "zhcn:8d5d2b2a44214fc7f242627c",
      "kind": "text_data",
      "source_text": "你能在背负沉重压力下获胜，实在了不起！",
      "source_fingerprint": "82fc2b9ffad0bd6e7b456675dde9b4f36c2723ad3679feb62e89ae0789a2a116",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "33"
      ]
    },
    {
      "uid": "zhcn:7ce3459f9a25890f126b344b",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "330"
      ]
    },
    {
      "uid": "zhcn:43f4a79297652df286fbc102",
      "kind": "text_data",
      "source_text": "应该会就这样朝着优胜直直奔去对吧！？",
      "source_fingerprint": "ac87967a37b750396c7f512bc8914344ef4dd02dfed17c9fefcd2dcaff95295e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "331"
      ]
    },
    {
      "uid": "zhcn:aa4a47d9519772559343bbe1",
      "kind": "text_data",
      "source_text": "你是以什么样的心情去挑战竞赛的呢？",
      "source_fingerprint": "9bf8e368bee15ba557f168ccdcce45138bdbddf7a100cf96bbb7c14cc544b5d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "332"
      ]
    },
    {
      "uid": "zhcn:b7a68cb139743e78b988503b",
      "kind": "text_data",
      "source_text": "刚刚起就持续不断的「帝王口号」是……？",
      "source_fingerprint": "e7513a50a2c0fa6b1b93f90400a44ba286a843c6ce3fb99c58ecbf928e9bf9d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "333"
      ]
    },
    {
      "uid": "zhcn:ca110357c755f8253d514bef",
      "kind": "text_data",
      "source_text": "可以预见决赛时会聚集更多的强敌……",
      "source_fingerprint": "4b0173c736b29597ea9675e440991360bd7b5c1e269c845501883708661123d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "334"
      ]
    },
    {
      "uid": "zhcn:76fff57b49576c665d73e97d",
      "kind": "text_data",
      "source_text": "请对粉丝说句话！",
      "source_fingerprint": "e4120d78fbf1092e6b2fafd181fece9e0af0ec5b78238248d9a4228d438d3c77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "335"
      ]
    },
    {
      "uid": "zhcn:f42546c6678647d3abae2a5e",
      "kind": "text_data",
      "source_text": "可预见决赛时会与更强的强敌交战吧……？",
      "source_fingerprint": "bdf6f82785a7a4d7f42b80ac44fa0dbdb7166232dd6c19e1c866698a5ac04893",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "336"
      ]
    },
    {
      "uid": "zhcn:963c460a10e8e8e86ab18684",
      "kind": "text_data",
      "source_text": "请说说你现在的心情！",
      "source_fingerprint": "7ffcd377e6a6ac7132795adaf740ff989cc0e8321a870fd489f4f9efd43ec2ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "337"
      ]
    },
    {
      "uid": "zhcn:da6b550875c939bc9a80af9e",
      "kind": "text_data",
      "source_text": "真是漂亮的胜利呢！",
      "source_fingerprint": "44ac9b5d397b49d533b005a6801d0678d2d34c210d01d5f532e74ab71977c763",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "338"
      ]
    },
    {
      "uid": "zhcn:c4106042a8826d0d7a807bf8",
      "kind": "text_data",
      "source_text": "ファンの皆さんに一言お願いします！",
      "source_fingerprint": "e2f6147bb4e79946d933c59b7f4054fdb58b49fbca5d13f23f35a365689bfb45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "339"
      ]
    },
    {
      "uid": "zhcn:df3b7057a269f6fe3331a6ca",
      "kind": "text_data",
      "source_text": "感觉你并不想把路让出来给后辈呢。",
      "source_fingerprint": "b48b82cd945e69821a3b563f38f97076f2c686fae1f0946935eb3446d733bd3e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "34"
      ]
    },
    {
      "uid": "zhcn:04e2f2fe2da07346ae511996",
      "kind": "text_data",
      "source_text": "お食事にもこだわっていると伺いましたが？",
      "source_fingerprint": "59e988bd8dd21f21c866c9f851160a019d27c599d6c5e04f5666359de61fe863",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "340"
      ]
    },
    {
      "uid": "zhcn:f108bdc9502959d7921ea56c",
      "kind": "text_data",
      "source_text": "次のレースへの意気込みをどうぞ！",
      "source_fingerprint": "95e5dfe2a65c11074b2b5afc41f09a2a9c3e7343a57a3251231f99ddcf5208da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "341"
      ]
    },
    {
      "uid": "zhcn:d67a2cd1b0786a1b7ebfa7da",
      "kind": "text_data",
      "source_text": "果然还是得用「KP」来庆祝胜利吧？",
      "source_fingerprint": "4a65b71b3fdcfabd238f02b3eb16daf77f4bf8b115480465b73317b99e4a3740",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "342"
      ]
    },
    {
      "uid": "zhcn:7a96f4ae1c19f75440e83200",
      "kind": "text_data",
      "source_text": "我就开门见山地问了。你这次获胜的原因是？",
      "source_fingerprint": "6e84102aeb6900864a07e29717c41c6131dc7fd99e670c8689f1ef8615a7dfe3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "343"
      ]
    },
    {
      "uid": "zhcn:faceec38a7b8ea4b7f76247d",
      "kind": "text_data",
      "source_text": "有想要和谁分享这次的胜利吗？",
      "source_fingerprint": "ee1ee145612a0d327e79ec086f70da837cafad83ac27eab3ab6eec0b606e8b5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "344"
      ]
    },
    {
      "uid": "zhcn:d2c0ae302ada7df2dc1fd136",
      "kind": "text_data",
      "source_text": "麻烦请对粉丝们说句话！",
      "source_fingerprint": "d2a2521fda0060b91cb348ee1e4f8f461af10cf4db5a765907ecbec06849c85f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "345"
      ]
    },
    {
      "uid": "zhcn:36f78d12f2fc38a332b55351",
      "kind": "text_data",
      "source_text": "顺利通过预赛！身边的人应该都很开心吧？",
      "source_fingerprint": "827411865fe261ed68a3af6d5816c37e4ed0164f292e1144188abfd408b9a06d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "346"
      ]
    },
    {
      "uid": "zhcn:f0888d47287dd5ee15758ae1",
      "kind": "text_data",
      "source_text": "为了决赛，请问你会做什么样的准备呢？",
      "source_fingerprint": "aa01857402cc0ca5ec49f439ff5315d55258eb54d632948be9e0c0456353e48f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "347"
      ]
    },
    {
      "uid": "zhcn:cd1ff4911a927f4146d5c900",
      "kind": "text_data",
      "source_text": "有吃致胜料理吗？",
      "source_fingerprint": "20cf6cc637548e0b8cf551b62545eb7b5ba2f12c2844a44e75aef72f7a0e2aad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "348"
      ]
    },
    {
      "uid": "zhcn:ee2b938e84f4b66d8f13a0e6",
      "kind": "text_data",
      "source_text": "在有比赛的日子会做些什么特别的事吗？",
      "source_fingerprint": "3b3e5dc1e095380a52bbcec11fe7feced5e5ae9e7a91ee88f4941a27cbc74025",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "349"
      ]
    },
    {
      "uid": "zhcn:872a39903ef228654348690e",
      "kind": "text_data",
      "source_text": "那种威风凛凛的表现究竟是从何而来……？",
      "source_fingerprint": "5fe97118a8bd373480ffaa70e2f57c08fe7427b71cc072a02573f7cfa7263b37",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "35"
      ]
    },
    {
      "uid": "zhcn:2981632f06caf844017f2f9b",
      "kind": "text_data",
      "source_text": "顺利进入决赛了呢！身边的人应该都很开心吧？",
      "source_fingerprint": "9c7852df0e2b9c7a9d89230d7e900a414a3df9df105c5e4330ffbb351b99bc19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "350"
      ]
    },
    {
      "uid": "zhcn:796e404b84ac2d6bced302f2",
      "kind": "text_data",
      "source_text": "请向竞赛对手发表一些感想。",
      "source_fingerprint": "7b2ca90e0f7c4bad8abad229c7399817c98239adb0949124f352333ed17176f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "351"
      ]
    }
  ]
}
