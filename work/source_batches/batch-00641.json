{
  "schema_version": 1,
  "batch": 641,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:251023cc091c38611139c91c",
      "kind": "text_data",
      "source_text": "决赛时会对上更难应付的强者赛马娘吧……",
      "source_fingerprint": "36b71aa30bf6e25e2b4d067f97d20ef0fa696672432649dd36af5bee647c49d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "352"
      ]
    },
    {
      "uid": "zhcn:67441c1a903dc76f916dd7a8",
      "kind": "text_data",
      "source_text": "身为「辉煌逸才」的你正备受瞩目呢！",
      "source_fingerprint": "b5a4bc2064acd1cbe499b57f6603474c9bb367267570d0641410bfc038cd33cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "353"
      ]
    },
    {
      "uid": "zhcn:be35896ec16fd766963750d4",
      "kind": "text_data",
      "source_text": "听说你的写作功力在课堂上被夸奖了。",
      "source_fingerprint": "f02e4e18ea4734f34d9b7d719668ac46c209bea7f52c9e2768c7af0b942f1436",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "354"
      ]
    },
    {
      "uid": "zhcn:511a926f44b494642227e509",
      "kind": "text_data",
      "source_text": "最近引起你注意的赛马娘是？",
      "source_fingerprint": "4f437e38f2486140cf537a453cb6c41faf07f2df8d093879f3a71badeae1a274",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "355"
      ]
    },
    {
      "uid": "zhcn:34358a53fb5214614fa64804",
      "kind": "text_data",
      "source_text": "竞赛开始前会紧张吗？",
      "source_fingerprint": "e50565654cc4a1be28f0f43c9e3d1db0e5a46787cd97002bdb603824ba6284e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "356"
      ]
    },
    {
      "uid": "zhcn:54617d498ed51ade692cebde",
      "kind": "text_data",
      "source_text": "很精彩的表现！",
      "source_fingerprint": "ee6b959a9629f3fe045615523dfffcfe79a9e1848e1e4ef33c00288ff9dc6c60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "357"
      ]
    },
    {
      "uid": "zhcn:32b70a1a6310b6eb120b1df8",
      "kind": "text_data",
      "source_text": "刚才好像看到你在笔记本上写了什么……？",
      "source_fingerprint": "a74aa498367c5e045572edbc5e2da26810a31ad3e5ede20b61b19ea31d204621",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "358"
      ]
    },
    {
      "uid": "zhcn:e3f2eb2a52f3b377de3ccea5",
      "kind": "text_data",
      "source_text": "有无论如何都想在决赛中一战的赛马娘吗？",
      "source_fingerprint": "8c8c1079c8c0c7383df7621a618edbe3bc582689792fdc93483fd7288fc65bb3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "359"
      ]
    },
    {
      "uid": "zhcn:b4ec188f231941c7104782a6",
      "kind": "text_data",
      "source_text": "与你的母亲不相上下的精彩表现呢！",
      "source_fingerprint": "2bc151be538000a1ecbc3eef35d2bc119c4d00549d2fe9306cf092259e591e09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "36"
      ]
    },
    {
      "uid": "zhcn:d2d3d307c484e9a3b6db3d73",
      "kind": "text_data",
      "source_text": "请告诉大家让你维持坚强实力的饮食是什么。",
      "source_fingerprint": "67054bf358b9d3cb5a1cfffe8a68d52cfed9a64dac3f832684e447ff3b4d88bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "360"
      ]
    },
    {
      "uid": "zhcn:ef2f8c230eba767ff97d9a6e",
      "kind": "text_data",
      "source_text": "据说，你好像有在养狗？",
      "source_fingerprint": "46f44d166fc62fdad7a8103afb9730399b72efdf8fa8ae47ece7be525b75948e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "361"
      ]
    },
    {
      "uid": "zhcn:f6c583f188b10a7e266df0b4",
      "kind": "text_data",
      "source_text": "决赛该关注哪个部分？",
      "source_fingerprint": "c0eb1042c76c0e83870cc6d0e6a95ab4a043cb9bc82063118d0c2ca8e473dfe8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "362"
      ]
    },
    {
      "uid": "zhcn:d9567943318460a28e68419f",
      "kind": "text_data",
      "source_text": "请对粉丝发表一句感言！",
      "source_fingerprint": "7c5af0f64085ff6426a046679705388129f151c4ca7bad839a95ba1f0a10f1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "363"
      ]
    },
    {
      "uid": "zhcn:d3f0b2b210b1b2f700e1bb73",
      "kind": "text_data",
      "source_text": "今天的竞赛跑起来感觉如何？",
      "source_fingerprint": "dcb831c7d2173e9f1415f269506db84a459b5517da313301dd1ab5fba6883eba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "364"
      ]
    },
    {
      "uid": "zhcn:46cdf308991eebc6882b2438",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "365"
      ]
    },
    {
      "uid": "zhcn:d614327c0866368df104f70b",
      "kind": "text_data",
      "source_text": "请对如同竞赛师父般的训练员说句话！",
      "source_fingerprint": "1784f5d02fcb63863e930927059a29c82196082fd6b3c2c55a4dbb08b41a1e93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "366"
      ]
    },
    {
      "uid": "zhcn:4c079b6884c031444ccb304b",
      "kind": "text_data",
      "source_text": "请对位于故乡道场的众人发表感言！",
      "source_fingerprint": "f4e0fa6ff124258607abd0468c840fcbfeb934723d6af427cbd326cb3369544b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "367"
      ]
    },
    {
      "uid": "zhcn:3f1ce1e0e1e827cf0e4df3e5",
      "kind": "text_data",
      "source_text": "身为一名武术家，你认为竞赛是？",
      "source_fingerprint": "4528237471640844c4b6b9f65886edb343b2cc0821f555ad4dbe5739e1100933",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "368"
      ]
    },
    {
      "uid": "zhcn:ae7d21bc4b5bce55a675e94a",
      "kind": "text_data",
      "source_text": "你带着满面的开怀笑容抵达了终点呢！",
      "source_fingerprint": "1018c6a9ab57b17a2fcb1feb9a66fa3e085fc55351c54f987f3745ed71fb6c46",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "37"
      ]
    },
    {
      "uid": "zhcn:3efab5d2bfb049e938da6c75",
      "kind": "text_data",
      "source_text": "决赛上可能会聚集更多强敌赛马娘喔？",
      "source_fingerprint": "2ada7199e312933d75ab8d125722ce5b0fdb1247c50caf6eaf068a67c1e16d72",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "372"
      ]
    },
    {
      "uid": "zhcn:292ea09b53c401509a7adecf",
      "kind": "text_data",
      "source_text": "在决赛上有可能要与目白家的成员一战喔？",
      "source_fingerprint": "c7b3a38951329cd6f7755c0f0249b7f62a50bd6bfd55986e100bc7928b4a33e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "373"
      ]
    },
    {
      "uid": "zhcn:f8e882a37a1c70a170d8122a",
      "kind": "text_data",
      "source_text": "下场竞赛会用什么样的作战去跑呢！？",
      "source_fingerprint": "785484a4b1c87b6d4a7642a3d23a2b5a896fd29135c0d84a713772661b22bbe5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "374"
      ]
    },
    {
      "uid": "zhcn:a6903e7b66d712912c79c58a",
      "kind": "text_data",
      "source_text": "这次的成果，想必你的父母也会很开心吧？",
      "source_fingerprint": "d0588c3f028ee546bbb1752bdacafc4aa9e7add46c6d8e5476633e0ab9c54686",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "378"
      ]
    },
    {
      "uid": "zhcn:00acf3d97dd814af3955e954",
      "kind": "text_data",
      "source_text": "打算如何庆祝获胜？",
      "source_fingerprint": "59d2561bb5d22c2e088197894fe41c475e5b208828221fb003ce8cba5e1a5b6d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "379"
      ]
    },
    {
      "uid": "zhcn:6905d064993a6f4a7971fa6f",
      "kind": "text_data",
      "source_text": "竞赛过程中，你都在想些什么呢？",
      "source_fingerprint": "e73d8aa698cf2637a90ccb4d3d64cdb2f97dbc784a01fe2c6ceb39e26001be5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "38"
      ]
    },
    {
      "uid": "zhcn:eafaf604c0088b8aeb64db74",
      "kind": "text_data",
      "source_text": "请对为你加油的粉丝说句话！",
      "source_fingerprint": "d2ed9f04fdc5328604c1dfbf8141594a43843ab55980c12aa4bc32412614e170",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "380"
      ]
    },
    {
      "uid": "zhcn:fc62678f63dc841e9238a5cc",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "381"
      ]
    },
    {
      "uid": "zhcn:3d8c0d3f705b0e2ea5bc1b17",
      "kind": "text_data",
      "source_text": "请对下场比赛的劲敌们说句话！",
      "source_fingerprint": "e32610bcce81c51c76c2c3dde0f2756e73043920658f8d1a42093c69129a5d14",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "382"
      ]
    },
    {
      "uid": "zhcn:209429d13e79b366cc3bc2c5",
      "kind": "text_data",
      "source_text": "有持续做什么特殊的训练吗？",
      "source_fingerprint": "e39cd4599ffdbb6521058b0dde074f7537cf4b02fe21acde6c4b247125094373",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "383"
      ]
    },
    {
      "uid": "zhcn:0f47d451be7f2ca5d4798e6d",
      "kind": "text_data",
      "source_text": "请针对竞赛发表感言！",
      "source_fingerprint": "9cb76c82153db35de63f5ca6025641ee3a49f5a21ddca6dfefa538ef26ab36fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "384"
      ]
    },
    {
      "uid": "zhcn:f71d2b3293324210be7ccf23",
      "kind": "text_data",
      "source_text": "今天是采取了什么样的作战呢？",
      "source_fingerprint": "889dd0d924d7c5e7ccfe9e608e3a724ac82894fbcf031baad0ca91caeee7bc09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "385"
      ]
    },
    {
      "uid": "zhcn:9c1c2f5b0dcabaf633603445",
      "kind": "text_data",
      "source_text": "你今天看到了什么样的「景色」？",
      "source_fingerprint": "3b30c533a67b444e796d39fe803022a8e75df0d069c3cbafe090de44c859f6db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "386"
      ]
    },
    {
      "uid": "zhcn:d43323823d596b4c08cd5fef",
      "kind": "text_data",
      "source_text": "下次会跑出什么样令人着迷的竞赛表现呢？",
      "source_fingerprint": "babc2e4f54da618e1cfa5c535e2ef53a0428fdc865fcd055e1bec6b2933a67a7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "387"
      ]
    },
    {
      "uid": "zhcn:507b31e89387d782336aa8d8",
      "kind": "text_data",
      "source_text": "这是「帝王传说」的全新一页呢！",
      "source_fingerprint": "896201d6eae01d14281b6fbd59a8be88cf544942a80e6258db071a5aeadb658d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "388"
      ]
    },
    {
      "uid": "zhcn:6ce084c83056da9ddb0433ae",
      "kind": "text_data",
      "source_text": "请说说你对于决赛的抱负！",
      "source_fingerprint": "d1814c4db5c2ebc8a85a263ac978a2c36a57d54e41b07f175d0319f1480d2ab5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "389"
      ]
    },
    {
      "uid": "zhcn:61550e58334e41da07694afb",
      "kind": "text_data",
      "source_text": "很期待青云天空选手下一场比赛的表现！",
      "source_fingerprint": "b8508cb6f36e0aec8097314d0e6c7d5e5696b0bcf8d9bf5dd1d2232c8c05576a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "39"
      ]
    },
    {
      "uid": "zhcn:618c44a8ba9b8fe6401d4e62",
      "kind": "text_data",
      "source_text": "你对于竞赛对手有什么印象？",
      "source_fingerprint": "302645e529d32679575e6f55315e0afed2998fa6fb7374bb1c7a262b894b075b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "390"
      ]
    },
    {
      "uid": "zhcn:1ce8d86698b8150439f81ce6",
      "kind": "text_data",
      "source_text": "你推荐的时髦景点是？",
      "source_fingerprint": "b7fb14fb45b0f6288660779dfb98f4cc4db27932bade71a4a23a1b432c10e1b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "391"
      ]
    },
    {
      "uid": "zhcn:0cd95a234e6626506ff61376",
      "kind": "text_data",
      "source_text": "最近在流行什么呢？",
      "source_fingerprint": "f82307fec5c1baa4a63f7373733336d8a47c779d76a1a9e40eed4b64b4b334c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "392"
      ]
    },
    {
      "uid": "zhcn:0b5c863f5a132e6e7b7f09ca",
      "kind": "text_data",
      "source_text": "难道刚才的那种表现就是「魔术」……？",
      "source_fingerprint": "e69b7bd84e8be6ce4cb8355749a170282c025a5f09d143aec9ea1fd9cca653a7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "393"
      ]
    },
    {
      "uid": "zhcn:e14b3a9c4781a27d296aa8a8",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负。",
      "source_fingerprint": "0d0fe55c60745f139f9332cf35a86fa076afecce5531b9fd12ef1b900a31e065",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "394"
      ]
    },
    {
      "uid": "zhcn:0d587d7b0a582524e578c646",
      "kind": "text_data",
      "source_text": "富士大人今天的表现也好美！",
      "source_fingerprint": "fc7c58811c9587994f1bd4f05358c08be9b2c58c5ce2fd317c51f1c8bdb6a657",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "395"
      ]
    },
    {
      "uid": "zhcn:f221076a96efc70f4014f9c2",
      "kind": "text_data",
      "source_text": "预计要用什么当成「给自己的奖励」？",
      "source_fingerprint": "7f40f6f635f5ed8e74fbf8d0ed5ed1bebf64ec203b6198cbe1717e56ad0b01ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "396"
      ]
    },
    {
      "uid": "zhcn:a703c662e36f0193bcf752aa",
      "kind": "text_data",
      "source_text": "简直是足以被称为「怪物」的表现！",
      "source_fingerprint": "8c80dded3836e46046389452246342fd562de1b1f309601c9fbe8c016e8ab6b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "397"
      ]
    },
    {
      "uid": "zhcn:4d1feb9e5c56263966857661",
      "kind": "text_data",
      "source_text": "请对前来加油的粉丝说句话！",
      "source_fingerprint": "f453f437ee30b5118a482209cd6976c3f715c14530eead60c22d5e4c8f87246f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "398"
      ]
    },
    {
      "uid": "zhcn:7bd3e62b1ff7ef2aa2b6d88a",
      "kind": "text_data",
      "source_text": "可以用一句话来形容胜利的喜悦吗？",
      "source_fingerprint": "db87dae64a956a1d2dfc48157ce232a4cbad8faa2a7cf46522199d41e6a9b15a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "399"
      ]
    },
    {
      "uid": "zhcn:f54951c0b38199dad9183659",
      "kind": "text_data",
      "source_text": "有曾经为了竞赛而去忍耐某些事物吗？",
      "source_fingerprint": "5a61280adfe716369ae872732fc8f7807a11436f3b63d081c97827869118d366",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "4"
      ]
    },
    {
      "uid": "zhcn:0ea8abc636213b764d1b5f98",
      "kind": "text_data",
      "source_text": "精彩的作战取胜！下一场也有什么作战……？",
      "source_fingerprint": "da2324d998d2190fbb0f76f0407b11fba98e5873dd118ce210dedc6c546ed3cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "40"
      ]
    },
    {
      "uid": "zhcn:2dfa4bf2af85d6de8c965f3c",
      "kind": "text_data",
      "source_text": "有办法与劲敌拉开距离的主要原因是？",
      "source_fingerprint": "f3b28c4fe10d3acf12a123fdc7b07818b65c6a3718134bf2149ae7fddef50bbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "400"
      ]
    },
    {
      "uid": "zhcn:bb1d19e4fdd5547184aff95a",
      "kind": "text_data",
      "source_text": "你在竞赛后和训练员说了些什么呢？",
      "source_fingerprint": "5b6b86d9cfb97739e7d8fa8e0e0e6f1ab093cdbb41c40f81f3482e817210fbee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "401"
      ]
    },
    {
      "uid": "zhcn:798d26a7e8553a2e3e418511",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "402"
      ]
    },
    {
      "uid": "zhcn:850b41c78ab9551f5f290fdb",
      "kind": "text_data",
      "source_text": "竞赛当中的哪个部分让你觉得最辛苦？",
      "source_fingerprint": "31326515c2e8b67fa45eea61b3748d6f2046c6bfb09bb036bfc058424d6afa05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "403"
      ]
    },
    {
      "uid": "zhcn:fcab8189fe1bf7b536aa8887",
      "kind": "text_data",
      "source_text": "训练员有跟你说些什么样的话了吗？",
      "source_fingerprint": "b036af540f91584539618a3a512ae54f374bd1a93fa7e57e492afce4608e0652",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "404"
      ]
    },
    {
      "uid": "zhcn:b748a89f96939ea4f6140590",
      "kind": "text_data",
      "source_text": "决赛中强者云集，你有多少自信呢？",
      "source_fingerprint": "bf102b0760297210a7307a66fb33e88da71cd96bc694c6417e1e478ca18a74c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "405"
      ]
    },
    {
      "uid": "zhcn:538f0e01c3c62fe458db54b0",
      "kind": "text_data",
      "source_text": "有在竞赛中发挥出如预期般的表现吗？",
      "source_fingerprint": "a6d424e7e6006f28c33596050656507f9ecade9287bc76ab5963706eadcf6b8b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "406"
      ]
    },
    {
      "uid": "zhcn:5322a16cfbc3711b41426fa2",
      "kind": "text_data",
      "source_text": "你似乎在训练时重新检视了自己跑法对吗？",
      "source_fingerprint": "06a47c7f44755fa2e4152d99f59b10e70861ffd3bd3129ba54bc8d1f03267524",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "407"
      ]
    },
    {
      "uid": "zhcn:1e1b2a0e0b6bdd51566fcd0c",
      "kind": "text_data",
      "source_text": "你那充满爆发力的赛况，太令人感动了！",
      "source_fingerprint": "826059428a808904d13abe1aee977db466c3a79b21aa79179241b884c1e46c9c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "408"
      ]
    },
    {
      "uid": "zhcn:ed020ea543ae8de860e9e190",
      "kind": "text_data",
      "source_text": "除了获胜之外还有哪些收获？",
      "source_fingerprint": "ee9fb572ecf28b7758a36f1dc544912e4b7b092609de410f7f4fee6d179311d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "409"
      ]
    },
    {
      "uid": "zhcn:bf7556368f0d4a5a33312b26",
      "kind": "text_data",
      "source_text": "完全是能形容为「电光石火」的表现！",
      "source_fingerprint": "b8b95aca4e03fc0315e3b9650a5bce0599838551656025de8286bfb1fce2559a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "41"
      ]
    },
    {
      "uid": "zhcn:983bf52562f748b3294e46a9",
      "kind": "text_data",
      "source_text": "下场比赛会采取什么样的作战？",
      "source_fingerprint": "82ad9497ef4a7dabb3ef35d0ea001c5af0d7a8da33f70740b120cd2091d9db40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "410"
      ]
    },
    {
      "uid": "zhcn:5964bea48290d76f39f4b9e6",
      "kind": "text_data",
      "source_text": "称霸激烈的比赛并获得胜利，太精彩了。",
      "source_fingerprint": "ac88303109553d75584ce3e0bd40cfb023a6010dd853548106932993bdfb7f86",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "411"
      ]
    },
    {
      "uid": "zhcn:0182d375b0979d0e589e6147",
      "kind": "text_data",
      "source_text": "接下来最想先做什么事？",
      "source_fingerprint": "bde23a6c1d6cdcae5b5b613f74f2a5a1720d0f8f6ca6778aed45bfc9b015ffd3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "412"
      ]
    },
    {
      "uid": "zhcn:4f7a47915f6da71208310c8f",
      "kind": "text_data",
      "source_text": "我们都很期待你的下一场竞赛！",
      "source_fingerprint": "24c2b5bf48a66a450b4955bae8f9f65457c72ee086eb28afb203f496b11c9f44",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "413"
      ]
    },
    {
      "uid": "zhcn:f23486faf4170107d1fe6092",
      "kind": "text_data",
      "source_text": "可以预见决赛时会聚集更多的强敌……",
      "source_fingerprint": "4b0173c736b29597ea9675e440991360bd7b5c1e269c845501883708661123d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "414"
      ]
    },
    {
      "uid": "zhcn:397331622544327f78cd7e44",
      "kind": "text_data",
      "source_text": "会针对决赛特地去吃「致胜料理」吗……？",
      "source_fingerprint": "7e57567e8face532bb1b30cac81763943187365222b4778a6aaa9b2fbaf16e11",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "415"
      ]
    },
    {
      "uid": "zhcn:c8bf303a0a1361ac58f8f01c",
      "kind": "text_data",
      "source_text": "请针对决赛说说你的抱负。",
      "source_fingerprint": "b4b8909cb979778ac43ca869bad5125b818db7ce025ce9f9c1d9d1b913373ade",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "416"
      ]
    },
    {
      "uid": "zhcn:11fdcf240b6bcd9f4543d3e8",
      "kind": "text_data",
      "source_text": "训练时会特别注重什么吗？",
      "source_fingerprint": "a466a12127975df8438610b71bd25286a1be4122aa220e3c446cb8911bcc8a13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "417"
      ]
    },
    {
      "uid": "zhcn:a28345e01f4568119dc8b657",
      "kind": "text_data",
      "source_text": "和训练员开了什么样的作战会议？",
      "source_fingerprint": "975076c88f73bfeddc1603c71093d812f26662d336744a0f02b5c16d4c8052e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "418"
      ]
    },
    {
      "uid": "zhcn:6192356c4317ba468b187d3a",
      "kind": "text_data",
      "source_text": "想必接下来的竞赛对手会越来越强吧。",
      "source_fingerprint": "0de076c3a77b5bb699000fef645b19176ffa2b4268886da900709b4ce6aecbe8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "419"
      ]
    },
    {
      "uid": "zhcn:989f99c37700615bd7fe29f2",
      "kind": "text_data",
      "source_text": "竞赛时，会注重些什么事呢？",
      "source_fingerprint": "a1c10f9a6051e24fdd11142a94c7cced0b1e1b59c52b9d8acb98b1c748e32bb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "42"
      ]
    },
    {
      "uid": "zhcn:6d3b1176dd58bf0683d17015",
      "kind": "text_data",
      "source_text": "一下子就好，可以请你把面罩脱掉吗……？",
      "source_fingerprint": "be0da9d64a32b978b2600ca30c19954b0dec5319a937dce7540263f54d7cdf1b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "420"
      ]
    },
    {
      "uid": "zhcn:832b841fc10a038647f6d57e",
      "kind": "text_data",
      "source_text": "请对粉丝们说句感言！",
      "source_fingerprint": "2d15f6fdfced58652fbc9e3a2f8e7c128e170e92e9d1e781004a50c8ef3855ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "421"
      ]
    },
    {
      "uid": "zhcn:cf27e9f1f21c4452a14a79d6",
      "kind": "text_data",
      "source_text": "看来下次也会成为一场热血的对决呢！",
      "source_fingerprint": "4d56fd0bdcd8c1e4e83ca22a11fc5c46c8f274b2624163bfa4b8f50d62a2e7cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "422"
      ]
    },
    {
      "uid": "zhcn:7ef61e93a0e310deccf70ef5",
      "kind": "text_data",
      "source_text": "请问成为你致胜关键的料理是？",
      "source_fingerprint": "632f9a50aa74df9680d1e364094117aca8a517ee215de1907cd0159b5fa53a83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "423"
      ]
    },
    {
      "uid": "zhcn:423e481db3e6b186912cc11c",
      "kind": "text_data",
      "source_text": "请告诉我们在竞赛上吸引众人目光的技巧！",
      "source_fingerprint": "fb345a2b0e0f7a48b53721d6e41e04b4028119405fa136aaba11b19f0074b5fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "424"
      ]
    },
    {
      "uid": "zhcn:c00d521a8e74e514890e31c0",
      "kind": "text_data",
      "source_text": "你认为自己与对手们的差别在于？",
      "source_fingerprint": "17e7309c9a98accc24a7161089ea48d7131fbee81a5727ba6aac50efd9a670cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "425"
      ]
    },
    {
      "uid": "zhcn:efdc94adc2f4207bc24c40b8",
      "kind": "text_data",
      "source_text": "你的表现就宛如捕捉猎物时的猛禽一般……",
      "source_fingerprint": "88ab1b5cfc3ce6f7b84e2e93b6c282e71f53e9b2d6b740684c56e58ebc77b573",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "426"
      ]
    },
    {
      "uid": "zhcn:36d7b54d9cb22ac0dc097848",
      "kind": "text_data",
      "source_text": "也有意见表示期待你们两姐妹在决赛对决喔？",
      "source_fingerprint": "0350c7ff94863a869d41e60c3794a79bba8d04e724d99b86a6d33ec91096c783",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "427"
      ]
    },
    {
      "uid": "zhcn:f8aee4e2f725d7d2cf56b4a0",
      "kind": "text_data",
      "source_text": "你会中意「怪物」这个别称吗？",
      "source_fingerprint": "0b1b7a4e6c757c4a6de377bf1e5ae03a18c16f8132c51149cddffe8e854ca208",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "428"
      ]
    },
    {
      "uid": "zhcn:f7f74d105416f646650f44cf",
      "kind": "text_data",
      "source_text": "请告诉我们你抵达终点瞬间的心情！",
      "source_fingerprint": "0c345c2f52b1e6bedfbacee49b896841a12e066f5d700ee76293697e8369d693",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "429"
      ]
    }
  ]
}
