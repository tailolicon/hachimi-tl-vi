        "231",
        "1420"
      ]
    },
    {
      "uid": "zhcn:8c334a3204c6c2be684dbe7f",
      "kind": "text_data",
      "source_text": "请发表获胜感言！！",
      "source_fingerprint": "7010d35d5dae735878cdcf77c03bbc4b8b1be50587d45aaaa9745b4a9487e998",
      "source_path": "text_data_dict.json",
