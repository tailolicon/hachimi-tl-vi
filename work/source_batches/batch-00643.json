        "231",
        "1421"
      ]
    },
    {
      "uid": "zhcn:b44746b67fcfbbce7bb7cdbb",
      "kind": "text_data",
      "source_text": "爱如往昔小姐，赛事的感想……是——",
      "source_fingerprint": "fd583b1d177d4f43c1de983c8e81b2aee44512648065104085f1043d0886a46b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1422"
      ]
    },
    {
      "uid": "zhcn:37685727578771fca93a9bc9",
      "kind": "text_data",
      "source_text": "听说您很喜欢历史小说！",
      "source_fingerprint": "1aa719b0bb33042d779e0256118e2a38fda064056834d064969bfe9985aeae54",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1423"
      ]
    },
    {
      "uid": "zhcn:fc3a73210b1d02ba4373d607",
      "kind": "text_data",
      "source_text": "在最后的直线，您是怀着怎样的心情奔跑的？",
      "source_fingerprint": "48ff21f5cd56c3000de472dc5680f48ba286c5ce17a2289f5ad7252de53e1a90",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1424"
      ]
    },
    {
      "uid": "zhcn:9115cfc6e5f5b266b0facadb",
      "kind": "text_data",
      "source_text": "闻到了一股好闻的香味……您对香水很讲究吗？",
