      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1411"
      ]
    },
    {
      "uid": "zhcn:a83b0b704ca8488406aa1c54",
      "kind": "text_data",
      "source_text": "为了迎接决赛，特训也更加干劲十足了呢！",
