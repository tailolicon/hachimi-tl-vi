      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1425"
      ]
    },
    {
      "uid": "zhcn:5a8677538bb64671198343a1",
      "kind": "text_data",
      "source_text": "请谈谈对决赛的抱负吧！",
