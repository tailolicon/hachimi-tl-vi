        "231",
        "1412"
      ]
    },
    {
      "uid": "zhcn:0982328201cee93fb81c931f",
      "kind": "text_data",
      "source_text": "赛事中听到粉丝的欢呼声了吗？",
      "source_fingerprint": "fb2b91a87e35f43dc846e837dc99a7811e46d9e04457f35dde1d0fd61db47b6c",
      "source_path": "text_data_dict.json",
