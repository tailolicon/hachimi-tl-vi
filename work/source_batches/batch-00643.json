      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "142"
      ]
    },
    {
      "uid": "zhcn:1c7b3c9b82f0121ef70664d3",
      "kind": "text_data",
      "source_text": "获胜的奖励，打算找谁要点什么呢？",
      "source_fingerprint": "a56e6a67ea88103913d2871e8964c36b86c70d80873223cb81747c7f14e339b5",
      "source_path": "text_data_dict.json",
