{
  "schema_version": 1,
  "batch": 645,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:89ff0f5f94f40718dd48cb34",
      "kind": "text_data",
      "source_text": "你是以什么样的心情面对竞赛的呢？",
      "source_fingerprint": "4bd3202703a25719cb74a8d7066db47cc31e7f974580080de2b17a42d699644e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "651"
      ]
    },
    {
      "uid": "zhcn:7cee2009f5c5c63605bfe1a0",
      "kind": "text_data",
      "source_text": "请告诉我们你现在的心情？",
      "source_fingerprint": "0aaaaa85a44b63b971501900d4d597dc8db52eef71c7ab677a1e80302f11b79e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "652"
      ]
    },
    {
      "uid": "zhcn:409382dc6f102c786906f17e",
      "kind": "text_data",
      "source_text": "请为今天的竞赛做个总结！",
      "source_fingerprint": "053000db9f76b734f8d14c373d97066ed8e42a92d33266b4b72c6b5977ed7d09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "653"
      ]
    },
    {
      "uid": "zhcn:580b0b5ab864b8c6d9b5bd8c",
      "kind": "text_data",
      "source_text": "请对家人们说些感言！",
      "source_fingerprint": "bfd89d76dd214d5ef847f6cdfd9ca867b2d4d76588cd48719c50e8d305a784e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "654"
      ]
    },
    {
      "uid": "zhcn:0731683045f3868ee1b9b88e",
      "kind": "text_data",
      "source_text": "请向你重视的对象发表一些感想！",
      "source_fingerprint": "caf50958fbdf13056524772541a63dacf3a03625d13340b49e51dd05d8059590",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "655"
      ]
    },
    {
      "uid": "zhcn:bb1c0e43b11121b936385a8d",
      "kind": "text_data",
      "source_text": "请向为你声援至今的粉丝说句话！",
      "source_fingerprint": "731f2464c60761dbf5d5e339cae580ec178baf10b93def2a7da1157dfd19748a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "656"
      ]
    },
    {
      "uid": "zhcn:35ef6bf1fb201e4b15bdc1d0",
      "kind": "text_data",
      "source_text": "请直接了当地告诉我们，你现在的心情如何？",
      "source_fingerprint": "5b38a13e0fd006812f5b143b90797685a5bdfa8977ffa48740d30d4492083da2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "657"
      ]
    },
    {
      "uid": "zhcn:c26787a5011cd6664686eaf2",
      "kind": "text_data",
      "source_text": "现在最想做的事情是？",
      "source_fingerprint": "fb1bf951e64f8e5ea079ef5ab872dc51f83c448ba3442799948cf185121b3a6b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "658"
      ]
    },
    {
      "uid": "zhcn:ba32d3fa0173b2924da3f6d1",
      "kind": "text_data",
      "source_text": "请对签约训练员说几句话！",
      "source_fingerprint": "b0c0404e3041fda2af359c294ae004f0acbc4b091c149471652af35a11ce86d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "659"
      ]
    },
    {
      "uid": "zhcn:5e9b13a1eae7e61ea1808f4e",
      "kind": "text_data",
      "source_text": "有打算「给自己奖励」来庆祝获胜吗？",
      "source_fingerprint": "1f2ef0ff7839db648719f6981ed30060abe54253546249fd006a48b2a54540cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "66"
      ]
    },
    {
      "uid": "zhcn:ef3706c6c12ba57d02501828",
      "kind": "text_data",
      "source_text": "请用一句话来形容你拿下优胜的心情。",
      "source_fingerprint": "476b937226e3d03de871ae9357aacd0c2e5d97a142fc115817fddd30c00b78dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "660"
      ]
    },
    {
      "uid": "zhcn:a211e137b23c8101e7004cf8",
      "kind": "text_data",
      "source_text": "宛如带领目白家得胜般的表现，相当精彩！",
      "source_fingerprint": "753bc8607124134536596b879b43b8cdfb3c4d29007bcc7a9e6cd5896815c3a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "661"
      ]
    },
    {
      "uid": "zhcn:7b95794e9c92316af0b3a952",
      "kind": "text_data",
      "source_text": "请对粉丝说几句话！",
      "source_fingerprint": "97c816d570abb7d12f0821eb6e9de1663087ec4aa6f94f3be0c307a9ca3b026c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "662"
      ]
    },
    {
      "uid": "zhcn:88b93b4f4beb7927e66e350b",
      "kind": "text_data",
      "source_text": "会想用什么当成「给自己的奖励」？",
      "source_fingerprint": "e11fe063a70ada7dbb465f2531748aaaa8bec87fb71a5e924049ec100c9507a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "663"
      ]
    },
    {
      "uid": "zhcn:e8d46e02d1f7df8ebb2f07a6",
      "kind": "text_data",
      "source_text": "等一下有什么计划吗？",
      "source_fingerprint": "ef21e1d3166ae72cc17a631be4f6a0f48b1d0427f89186191bd75731f2ae2db1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "664"
      ]
    },
    {
      "uid": "zhcn:a95e3aede44792ce9aeec71b",
      "kind": "text_data",
      "source_text": "听得见观众席传来庆祝优胜的盛大欢呼声呢！",
      "source_fingerprint": "9eccefdc986d223bb3463aa6d12ff971ea026c87399370821641842796802a7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "665"
      ]
    },
    {
      "uid": "zhcn:aa275a0eba92f6bffd701837",
      "kind": "text_data",
      "source_text": "很厉害馁！这下明天的报纸版面都是雪子了！",
      "source_fingerprint": "0aa4d649afc661f9c06b3d99095914a71a30cc0cc4b39d280a16be28c97bf545",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "666"
      ]
    },
    {
      "uid": "zhcn:5c251c3be987e822916f9ab9",
      "kind": "text_data",
      "source_text": "连这里都听得见粉丝的欢呼声呢！",
      "source_fingerprint": "032dd2b099e2b30cfdc400fef98a29c007057c3c78c0277ebecead347b7738d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "667"
      ]
    },
    {
      "uid": "zhcn:dc8d150a7bb38716cf1a2489",
      "kind": "text_data",
      "source_text": "请向签约训练员发表你的感想！",
      "source_fingerprint": "404db520d69606999715eaef325ca853e0a0705c91c594d1f9cfef7d53a52316",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "668"
      ]
    },
    {
      "uid": "zhcn:5843b6cd36d6b7a5d49ac187",
      "kind": "text_data",
      "source_text": "请向签约训练员说几句话！",
      "source_fingerprint": "7643d53bbcd14f416a218d2239ce26db64c6d2190965dc003d00a1e780f160b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "669"
      ]
    },
    {
      "uid": "zhcn:54558b3a0d59ac33890942e5",
      "kind": "text_data",
      "source_text": "真是场激战呢。会感到疲累吗？",
      "source_fingerprint": "dd4e39609af82bdea2159ce1e72d49966be9823a296c3d800542f755f17c3c16",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "67"
      ]
    },
    {
      "uid": "zhcn:9869960c39e6a3a7199ad8ea",
      "kind": "text_data",
      "source_text": "已经想好要给自己的奖励了吗？",
      "source_fingerprint": "3b6be7254fce51830ea6fb8de6680595defccb1314b6611996354ab73d63965f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "670"
      ]
    },
    {
      "uid": "zhcn:d89afe41a9d792e07ed0468f",
      "kind": "text_data",
      "source_text": "透过此胜，你是否更接近追求的「真理」了？",
      "source_fingerprint": "022940e935da678fbe5ab266dcb9deb558ddbd7373df9b1f4dbe7fa12dbb2f34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "671"
      ]
    },
    {
      "uid": "zhcn:695f705f629e837583d979cf",
      "kind": "text_data",
      "source_text": "透过这场胜利，有让你获得了什么吗？",
      "source_fingerprint": "2a5518b9e77fc7b49666dab718107754a4362b5b6068a82d7b69645a9f9044db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "672"
      ]
    },
    {
      "uid": "zhcn:aed4243647d1fd6fa1508f2d",
      "kind": "text_data",
      "source_text": "预计做些什么来庆祝获胜？",
      "source_fingerprint": "dcc146da696d087f256782902119bc469ab0328ae2f1621786a568955d7ce316",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "673"
      ]
    },
    {
      "uid": "zhcn:80cb5e5bd374ff59f5425e3f",
      "kind": "text_data",
      "source_text": "请问你是以何种心境去面对这次的盛大赛事？",
      "source_fingerprint": "a66d771b691c5dc79ca21c2cff714b5b3072f17b19516751b71cd68e84c2daf9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "674"
      ]
    },
    {
      "uid": "zhcn:6b9154b9b1d62815925ce8a9",
      "kind": "text_data",
      "source_text": "请告诉我们获得胜利女神眷顾的秘诀！",
      "source_fingerprint": "5c56460632cdb2525de7d6a8f871808f3c98e75e7529dbfde362108c5c8df313",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "675"
      ]
    },
    {
      "uid": "zhcn:198d6fe302395158922c1e49",
      "kind": "text_data",
      "source_text": "直到获胜为止的路途果然很艰辛吗？",
      "source_fingerprint": "25948e320fcec3214137e5ec594244a443b2de472cbdbacbc2a9d51e6c4d175b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "676"
      ]
    },
    {
      "uid": "zhcn:a8c8d094ecb61276392788cf",
      "kind": "text_data",
      "source_text": "喊着「奖券藏口号」的欢呼声不绝于耳呢！",
      "source_fingerprint": "dda7e15996ed6f52b69a223ed742a0b158069d1d1d5e5b138609c29ac70c45ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "677"
      ]
    },
    {
      "uid": "zhcn:8485bc6dc3f28d9a43586f50",
      "kind": "text_data",
      "source_text": "请说说你现在的心情！",
      "source_fingerprint": "7ffcd377e6a6ac7132795adaf740ff989cc0e8321a870fd489f4f9efd43ec2ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "678"
      ]
    },
    {
      "uid": "zhcn:df658a62509db7c193469498",
      "kind": "text_data",
      "source_text": "真是精彩的表现！现在的心情如何？",
      "source_fingerprint": "816f7c03cab6898c78e01a40dd42ee87502a89a3c202efd6932aff8749c79b9b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "679"
      ]
    },
    {
      "uid": "zhcn:e00a4eed0e94fb14fad48e75",
      "kind": "text_data",
      "source_text": "请告诉我们关于你那脚力的秘密！",
      "source_fingerprint": "76305cfe80969b4dd8a408c500547c543bacda0012ebf159f8e26eed70b6388c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "68"
      ]
    },
    {
      "uid": "zhcn:c9c5650f7356f21a8a1a835c",
      "kind": "text_data",
      "source_text": "请对签约训练员说几句话！",
      "source_fingerprint": "b0c0404e3041fda2af359c294ae004f0acbc4b091c149471652af35a11ce86d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "680"
      ]
    },
    {
      "uid": "zhcn:3fbfdcfdc417a8b6c0474ec1",
      "kind": "text_data",
      "source_text": "打算怎么庆祝获得优胜呢？",
      "source_fingerprint": "a1e3733e88583915a029f276f2998995e87fea6036024e2104ea249767b4ee23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "681"
      ]
    },
    {
      "uid": "zhcn:5985e5b1ec4deec3b4d4a1b2",
      "kind": "text_data",
      "source_text": "请对支持你拿到优胜的签约训练员说句话！",
      "source_fingerprint": "3e306f737cd52f622ac44ab813a796332953b6c7bb45838aca28a9c29dc5dbb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "682"
      ]
    },
    {
      "uid": "zhcn:67ba0ced9536218c77d315ab",
      "kind": "text_data",
      "source_text": "请向一路声援你拿到优胜的粉丝说句话！",
      "source_fingerprint": "b077c9a5aed268ba0ffaa5907d95c80e25e0233a98d7f0753d260f36833959b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "683"
      ]
    },
    {
      "uid": "zhcn:faba7c105a4e1bd57affb7bc",
      "kind": "text_data",
      "source_text": "你是不是越跑就越可爱啊！？",
      "source_fingerprint": "8d6461f85a60db6f66672d3e84b010328b69c6b31285ecd216cad545d84d7adc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "684"
      ]
    },
    {
      "uid": "zhcn:f3e7433f2b68fed2a951dcb2",
      "kind": "text_data",
      "source_text": "请告诉我们你将来的展望。",
      "source_fingerprint": "57e753e25ffafb2e4c334a9d6bd55858e55eab3f7e375f29f48d916267cc8da6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "685"
      ]
    },
    {
      "uid": "zhcn:0e6dc029eddc7b14970d3c2d",
      "kind": "text_data",
      "source_text": "战斗公主的获胜秘诀是什么？",
      "source_fingerprint": "d0d9d9320aa8b8036c0b5a0922a1e07c0f9d06cc25643b11e9ee4f4452dde703",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "686"
      ]
    },
    {
      "uid": "zhcn:7dc96cdbbf7916b3bbe762f1",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜，请告诉我们你现在的心情！",
      "source_fingerprint": "828eccbf2ebe710dbba2a24c2a68dc1bc97f0d5c304917cf60341b423a969cc1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "687"
      ]
    },
    {
      "uid": "zhcn:5e952eb2586299e5f54a6b67",
      "kind": "text_data",
      "source_text": "请让我们拍纪念优胜和制作首页特辑的照片！",
      "source_fingerprint": "9e749d4f2940fc77f202b73bb3e8562d94e5ac26f594ac86974e12cba117c3db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "688"
      ]
    },
    {
      "uid": "zhcn:7477dd60f9ee2aaac9585deb",
      "kind": "text_data",
      "source_text": "所以这次是你的作战奏效了对吧？",
      "source_fingerprint": "f836027c3381c56e449c526f00cd87f1818fd8a7008910ed45f13d4fe699b78e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "689"
      ]
    },
    {
      "uid": "zhcn:87ec40581bb0525629592034",
      "kind": "text_data",
      "source_text": "今天是采取什么样的作战去参赛的呢？",
      "source_fingerprint": "f38e7a830bfa1111a0572472bc9fa1d96d0b2e647c392dbcd9c13ad658e9d078",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "69"
      ]
    },
    {
      "uid": "zhcn:14b0136e2157e9c85bfa6658",
      "kind": "text_data",
      "source_text": "请对在观众席的同班同学说句话！",
      "source_fingerprint": "0edcea9843e1d6df07d73e49f06cdcead111016c0420cfc7da2d45554bba736a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "690"
      ]
    },
    {
      "uid": "zhcn:73710aed5586b2f12b452752",
      "kind": "text_data",
      "source_text": "庆功宴会办得fabulous又gorgeous吗？",
      "source_fingerprint": "1b638ab4608445e3171b67d9e7ac70cc036cad2c8f501f245fb93318ca144d4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "691"
      ]
    },
    {
      "uid": "zhcn:d536ce2b2772354816e65f61",
      "kind": "text_data",
      "source_text": "请对粉丝说些话！",
      "source_fingerprint": "77e7db6e4fcc382854ade795817983d877f7d03fac6cbc5d033b3117923bf9d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "692"
      ]
    },
    {
      "uid": "zhcn:f9ec358a1a84e53c8354f77b",
      "kind": "text_data",
      "source_text": "赢得胜利的现在，你最想跟谁分享喜悦？",
      "source_fingerprint": "ad561e46810c3bc95a9b6db4721aa0f9becf3fa6e39daeceb1c77658b719bba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "693"
      ]
    },
    {
      "uid": "zhcn:e4ec7256dd090c308f3b0ee6",
      "kind": "text_data",
      "source_text": "你的双亲似乎都在观战呢。请对他们说句话！",
      "source_fingerprint": "8aebf8c2cd75272af5f4784bddc97b0a5b9bb1d8b34e6c6957c4f3c6781551c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "694"
      ]
    },
    {
      "uid": "zhcn:d494850ba58010d6134f8835",
      "kind": "text_data",
      "source_text": "你的魔法之力太令人佩服了！",
      "source_fingerprint": "93a8eea9f8eba49065cc7c46290bea0948b9b6ff883ed7ecf47c161d0121c2c6",
      "source_path": "text_data_dict.json",
      "json_path": [
