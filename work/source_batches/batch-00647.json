      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "853"
      ]
    },
    {
      "uid": "zhcn:b69bb54d8f47d3a95d67f29a",
      "kind": "text_data",
      "source_text": "请坦白形容你现在的心情！",
