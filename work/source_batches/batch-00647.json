        "842"
      ]
    },
    {
      "uid": "zhcn:15fa25c3dcbce9105230b48f",
      "kind": "text_data",
      "source_text": "庆功宴会办得fabulous又gorgeous吗？",
      "source_fingerprint": "1b638ab4608445e3171b67d9e7ac70cc036cad2c8f501f245fb93318ca144d4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "843"
      ]
    },
    {
      "uid": "zhcn:ff9926cd8a57a846e54d8f23",
      "kind": "text_data",
      "source_text": "请对粉丝说些话！",
      "source_fingerprint": "77e7db6e4fcc382854ade795817983d877f7d03fac6cbc5d033b3117923bf9d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "844"
      ]
    },
    {
      "uid": "zhcn:9808ebab56088b57917458e2",
      "kind": "text_data",
      "source_text": "赢得胜利的现在，你最想跟谁分享喜悦？",
      "source_fingerprint": "ad561e46810c3bc95a9b6db4721aa0f9becf3fa6e39daeceb1c77658b719bba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "845"
      ]
    },
    {
      "uid": "zhcn:b8c21591e3d85bde233942f8",
      "kind": "text_data",
      "source_text": "你的双亲似乎都在观战呢。请对他们说句话！",
      "source_fingerprint": "8aebf8c2cd75272af5f4784bddc97b0a5b9bb1d8b34e6c6957c4f3c6781551c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "846"
      ]
    },
    {
      "uid": "zhcn:c2adce8db015cc5f62f033d6",
      "kind": "text_data",
      "source_text": "你的魔法之力太令人佩服了！",
      "source_fingerprint": "93a8eea9f8eba49065cc7c46290bea0948b9b6ff883ed7ecf47c161d0121c2c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "847"
      ]
    },
    {
      "uid": "zhcn:318644c152801d1cc50691be",
      "kind": "text_data",
      "source_text": "请对你的家人说几句话。",
      "source_fingerprint": "9afa6a7a2c47efae54dfa9bafb6ab8e21cb017fcb5fdf4abcb1e4c4aa18c7f48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "848"
      ]
    },
    {
      "uid": "zhcn:c6d5258643c8f9f3b7147bed",
      "kind": "text_data",
      "source_text": "你刚才和队伍成员说了些什么对吧？",
      "source_fingerprint": "d25e0a67e7ca26e5b14adf6e95903c12aac53ecda402ff53cf0822b40e3d09aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "849"
      ]
    },
    {
      "uid": "zhcn:827e23fd1099d8ee8d62a212",
      "kind": "text_data",
      "source_text": "请告诉大家让你拿下胜利的致胜料理！",
