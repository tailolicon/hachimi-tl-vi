      ]
    },
    {
      "uid": "zhcn:3418f6467419187ad9439308",
      "kind": "text_data",
      "source_text": "你认为可以进入决赛吗？",
      "source_fingerprint": "76ef2b7f83e4583d37fe19f0a782373f8bf39a63138ac54b8e50a0571c972220",
      "source_path": "text_data_dict.json",
      "json_path": [
