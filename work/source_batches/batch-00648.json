        "1013"
      ]
    },
    {
      "uid": "zhcn:bebb503f4590d009484feb4f",
      "kind": "text_data",
      "source_text": "你真受瞩目呢。心情如何？",
      "source_fingerprint": "de9fcab59261f1260c72c463b5e22a4760f4c6d85f710a0b06a2d462f9021889",
      "source_path": "text_data_dict.json",
      "json_path": [
