      ]
    },
    {
      "uid": "zhcn:af6b19f80342124f6b253a46",
      "kind": "text_data",
      "source_text": "请跟大家说句话！",
      "source_fingerprint": "135eda8d42de9da4741a3181f85a905252695dd05184e56fa0c09f928b30afa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1016"
      ]
    },
    {
      "uid": "zhcn:68f44ed0078733620ea67323",
      "kind": "text_data",
      "source_text": "你引发了奇迹呢！",
      "source_fingerprint": "d37c4e8fc2e68d530642303d6dfc3868b7f0f4cdc4503b3a4ec30a04b19b73e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "1017"
      ]
    },
    {
      "uid": "zhcn:a45c5ab58b4e7d9ee276842e",
      "kind": "text_data",
      "source_text": "你真受欢迎呢！",
      "source_fingerprint": "394d6a450d25c89bed68fef7ce7b1a0a9fe5619aacbc2e988158298976c57dd9",
      "source_path": "text_data_dict.json",
