      ]
    },
    {
      "uid": "zhcn:673cb6577194d48915b8e174",
      "kind": "text_data",
      "source_text": "我很开心！　这是大家一起留下的记录。\n因为我的速度是大家赐予我的东西！",
      "source_fingerprint": "c2da9d6031bb5e842924a70504f733a4b35ca0001b57c580ceff175bb025db3a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1070"
      ]
    },
    {
      "uid": "zhcn:302ccc020c35e0d08a2dcd84",
      "kind": "text_data",
      "source_text": "谢谢你。希望能向着光明的方向\n奔跑下去呢。和重要的人们一起——",
      "source_fingerprint": "1c128ae6a866e14a9fb20e2a89279ee723d9d8ef125eb7c5df85c8d45fbd2570",
      "source_path": "text_data_dict.json",
