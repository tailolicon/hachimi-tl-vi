    {
      "uid": "zhcn:665eab5f02bb9e9ccf31f84a",
      "kind": "text_data",
      "source_text": "へへ、結構練習してさ……名前の最後に翼を\\n書くのがこだわりなんだ！　あとで書くぞ！",
      "source_fingerprint": "1143ff3bea4ca21293cf0eb3ad08b7ae96e390c42bfb42a1101120d0076873a7",
      "source_path": "text_data_dict.json",
      "json_path": [
