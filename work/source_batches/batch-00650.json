        "1083"
      ]
    },
    {
      "uid": "zhcn:8c398dce741329be17eae97b",
      "kind": "text_data",
      "source_text": "交锋、热气，以及如地鸣般的脚步声。\n正是因为赛事的一切都是如此惹人怜爱。",
      "source_fingerprint": "430e89ce00612d12bb6052f68a8f7b6d03baf365f1b0101c8b8160f3bdbad583",
