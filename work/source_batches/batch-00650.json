      ]
    },
    {
      "uid": "zhcn:1fb05efb8b9a5d6e57215314",
      "kind": "text_data",
      "source_text": "……不禁让人蠢蠢欲动了呢。\n明明刚刚才尽情燃烧过自己。",
      "source_fingerprint": "3bd094b064e3f7eea52f1e5952435e8c74aa73b30ff72617b94e25e8a4adad6c",
      "source_path": "text_data_dict.json",
      "json_path": [
