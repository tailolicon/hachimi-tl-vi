      "kind": "text_data",
      "source_text": "……每天，我都会告诉自己。\n别垂头丧气，总之先去做。大概是，这个吧。",
      "source_fingerprint": "5f456cdcd245cedc5242546f63cbbf4639ce44611484549fc9f8e41b645dfd36",
      "source_path": "text_data_dict.json",
      "json_path": [
