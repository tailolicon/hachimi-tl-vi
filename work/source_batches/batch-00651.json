      ]
    },
    {
      "uid": "zhcn:95989e8aae9908edb3b06040",
      "kind": "text_data",
      "source_text": "欸嘿嘿，对吧？\n这光芒可不输给迪拜的夜景哦♪",
      "source_fingerprint": "a18986ee19b123b0486353740d3f498cc36ef9df4a1f774f990ad069acdb59f7",
      "source_path": "text_data_dict.json",
