    {
      "uid": "zhcn:c8ca6881134c6e81d5e792ba",
      "kind": "text_data",
      "source_text": "您还记得母亲的跑姿呢。\n很荣幸。为了不输给她，我会更加精进的。",
      "source_fingerprint": "3835e0533f116c2060c11bf7f1af394933eea0dd93be2d9bc6c4c26a37b823c6",
