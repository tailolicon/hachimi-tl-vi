      "kind": "text_data",
      "source_text": "接下来就轮到大家了。我等着你们哦！",
      "source_fingerprint": "41955f98abb329b392b4d426d4a5772844a47e25d6540980b397e6563e96cbf3",
      "source_path": "text_data_dict.json",
