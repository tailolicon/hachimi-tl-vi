  "entries": [
    {
      "uid": "zhcn:dc92afa91404f441179f1f41",
      "kind": "text_data",
      "source_text": "听说你的致胜料理是意式料理？",
      "source_fingerprint": "6c5dfa4abbee7824618ba8b7400d93d3350c2af99f08f219485562febb37bca3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "7"
      ]
    },
    {
      "uid": "zhcn:5a029803ce6a311475c021e6",
      "kind": "text_data",
      "source_text": "今天的致胜关键是什么？",
      "source_fingerprint": "3c95f8183ed15650cacc9f81e125574ad13704036efaecbb644815c28773d7ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "70"
      ]
    },
    {
      "uid": "zhcn:15e216a63c7bbd8c9dff7361",
      "kind": "text_data",
      "source_text": "我很期待你的胜者舞台喔！",
      "source_fingerprint": "29b711c05310035310f9188406c19e45a579c8f7efc1fa1c31bad7a9571fe6ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "700"
      ]
    },
    {
      "uid": "zhcn:0cb83914894ed1027cbe5b46",
      "kind": "text_data",
      "source_text": "若要为今天的竞赛下个标题会是什么呢！",
      "source_fingerprint": "1c52746e3c2895355412498eb8c2403ae4a87d51e90f77cb89d19bc38d8a12aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "701"
      ]
    },
    {
      "uid": "zhcn:6907cd08ddbb2e22e67c05a2",
      "kind": "text_data",
      "source_text": "请坦白形容你现在的心情！",
      "source_fingerprint": "eaae0c7b6a7a9276f572fc1fd54674b440a6726e2bcaebd3af44d6511a337704",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "702"
      ]
    },
    {
      "uid": "zhcn:892eb9ead5f718f11b2743d0",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "703"
      ]
    },
    {
      "uid": "zhcn:34b53c5d85d70f3e316f982f",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "704"
      ]
    },
    {
      "uid": "zhcn:312945c95844f9ab6eda4482",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "705"
      ]
    },
    {
      "uid": "zhcn:1eaedb90bab66ae5700bf5b9",
      "kind": "text_data",
      "source_text": "有没有想跟谁分享优胜的喜悦呢？",
      "source_fingerprint": "b55047926e65c68e803c48cfd96a2b642bc9429f44f2f12cc37042fe85e30da8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "706"
      ]
    },
    {
      "uid": "zhcn:07de4ff12acf6d591d7b823f",
      "kind": "text_data",
      "source_text": "请向为你声援至今的人们说句话！",
      "source_fingerprint": "a57e03d7227e09b9b19fdde145eda6ae76b6e9b651b95045af8c3cc7b6598937",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "707"
      ]
    },
    {
      "uid": "zhcn:9dff779dfeb74f8cd3a9b765",
      "kind": "text_data",
      "source_text": "预计会怎样庆祝自己获得优胜呢？",
      "source_fingerprint": "f6945768edce79d491a35ace8f0f96561d27076510604ed54ce33b7e3e2e41d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "708"
      ]
    },
    {
      "uid": "zhcn:7eed34445f70fac6f09825b8",
      "kind": "text_data",
      "source_text": "会怎样庆祝自己获得获胜呢？",
      "source_fingerprint": "20fc7b9e55258f741be56bc1a5fcf25b0f0a65f029db014686e27e8a6b079b34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "709"
      ]
    },
    {
      "uid": "zhcn:c95d8563c297f44fc30b0ec1",
      "kind": "text_data",
      "source_text": "对于常用的耳机有什么样的坚持吗？",
      "source_fingerprint": "e3b7eefeed1d9484bb54bf900a575c70ee7d13e62965279d206f48c832c523de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "71"
      ]
    },
    {
      "uid": "zhcn:d25ca1843cd265f92f2bef35",
      "kind": "text_data",
      "source_text": "请对粉丝发表一句感言！",
      "source_fingerprint": "7c5af0f64085ff6426a046679705388129f151c4ca7bad839a95ba1f0a10f1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "710"
      ]
    },
    {
      "uid": "zhcn:5098214d8d1f90c7c3439561",
      "kind": "text_data",
      "source_text": "你现在的心境如何呢？",
      "source_fingerprint": "1c7a7184233da8021d3efe1b062e4855f8b91d8ed8beabb4e850694d2d74262c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "711"
      ]
    },
    {
      "uid": "zhcn:761972d7ec0c250b14fda96f",
      "kind": "text_data",
      "source_text": "请对签约训练员说句话！",
      "source_fingerprint": "52035a20f686c9314746b0b32ef70b537e6da674c79f6b1de14553096641d072",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "712"
      ]
    },
    {
      "uid": "zhcn:035ef044f3739073dbd181f5",
      "kind": "text_data",
      "source_text": "这份喜悦想第一个跟谁分享呢？",
      "source_fingerprint": "ad780518f21fc88d9534a53a26992089ad1b7f689dc837da1a2770f3542514c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "713"
      ]
    },
    {
      "uid": "zhcn:98c8aedc7cbc99ab9f5e1c5e",
      "kind": "text_data",
      "source_text": "请对竞赛时激烈争锋的劲敌们说句话！",
      "source_fingerprint": "460379efde6ab5003fc279585188cae086d8786d85f4bae3d83669e2b6b4b298",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "714"
      ]
    },
    {
      "uid": "zhcn:d45b4b3a30ab1fa703a9d7a9",
      "kind": "text_data",
      "source_text": "どんな気持ちで走りましたか？",
      "source_fingerprint": "0895a3c639538c25f384f43f5521a59158a72730d866037adda56bc78f4f93cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "715"
      ]
    },
    {
      "uid": "zhcn:1bef606f538b7c5ab240a482",
      "kind": "text_data",
      "source_text": "最後にヒーローからみんなへ、一言！",
      "source_fingerprint": "0eab7a56efae313a1a76e628552bc77e6157a8d53ff10df0fa59701ff261dd02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "716"
      ]
    },
    {
      "uid": "zhcn:63653e8748eae967893ca927",
      "kind": "text_data",
      "source_text": "在最后直线时彷佛窥见了异世界……",
      "source_fingerprint": "0e73e8f87c3ce29a6469134c5fd023d7d8bf57060074b8e732562a1349e9d12a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "717"
      ]
    },
    {
      "uid": "zhcn:4293f4d760eda6d41b44506d",
      "kind": "text_data",
      "source_text": "世界美丽计划的目标也达成了吧？",
      "source_fingerprint": "7f148727ff840e684e5a9647613b57173366d2b46c342c98c68ed83cb635d3c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "718"
      ]
    },
    {
      "uid": "zhcn:c761d136642e257494566595",
      "kind": "text_data",
      "source_text": "福临？",
      "source_fingerprint": "c6007ce84aa3cbdf1da1cbac2509a8541c15455cbdaa72470e636f95c15d32ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "719"
      ]
    },
    {
      "uid": "zhcn:ba328b9b3812e712e44beff8",
      "kind": "text_data",
      "source_text": "你认为自己今天在竞赛中的表现如何？",
      "source_fingerprint": "e2215f080a3cb3153e169a90b1e97504a2660ab2d30448d6f854aadb1b2b9fb0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "72"
      ]
    },
    {
      "uid": "zhcn:c2b03c9ddb8be5840a75ea90",
      "kind": "text_data",
      "source_text": "已经决定好今后的规划了吗？",
      "source_fingerprint": "5bad6da6e3f1b59a2f93d11777ac175f9a7c868202505ad95e885dc0bf402c41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "720"
      ]
    },
    {
      "uid": "zhcn:1c152df5c65cd85575b022ec",
      "kind": "text_data",
      "source_text": "请告诉我们你站上顶点此刻的心情！",
      "source_fingerprint": "e7c70c1b49cddae8be3535641dbec51eb24a54b5e8bd70f5dab20cd37847e6fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "721"
      ]
    },
    {
      "uid": "zhcn:882746a5bac8ac0b3634378d",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "722"
      ]
    },
    {
      "uid": "zhcn:e8d453f1cea6951dec554e53",
      "kind": "text_data",
      "source_text": "请以冠军的身份说几句话！",
      "source_fingerprint": "b647c07252222aaaf6d0bbcc87b7e54238be45d93026be0816e00175b21f1f47",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "723"
      ]
    },
    {
      "uid": "zhcn:ed3af225108b73cba481888f",
      "kind": "text_data",
      "source_text": "撑过了严苛考验后，现在的心情如何？",
      "source_fingerprint": "cd7d37a4b58cd62614d6a2cb1260f23b02bfd18cbeb28f58d8232ee6d9a2305f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "724"
      ]
    },
    {
      "uid": "zhcn:c029997a7403429577bdd502",
      "kind": "text_data",
      "source_text": "今天的竞赛中有让你觉得感动的事物吗？",
      "source_fingerprint": "72d3f0822f4312c53a45d12c86bae9b3c05192fc243495a4d65b76989f519152",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "725"
      ]
    },
    {
      "uid": "zhcn:c9a927eb8672c3034008829b",
      "kind": "text_data",
      "source_text": "请向为你声援至今的粉丝说句话！",
      "source_fingerprint": "731f2464c60761dbf5d5e339cae580ec178baf10b93def2a7da1157dfd19748a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "726"
      ]
    },
    {
      "uid": "zhcn:a8a3009064e379c7fb9cc336",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "727"
      ]
    },
    {
      "uid": "zhcn:f95e60a686c17c9ecae371a7",
      "kind": "text_data",
      "source_text": "简单来说，今天的获胜原因是？",
      "source_fingerprint": "d7853a48a3f3ab5a12edd0cbab6734dfd035d313e7814008521f8dd7c013e13c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "728"
      ]
    },
    {
      "uid": "zhcn:4df5c82e0037e2a4a6adb3dd",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "729"
      ]
    },
    {
      "uid": "zhcn:1178578de37663e7dbaa6184",
