      ]
    },
    {
      "uid": "zhcn:16d6e025b341d512de231049",
      "kind": "text_data",
      "source_text": "收到了高尚骏逸小姐和优秀素质小姐发来的祝贺\nLANE消息……嗯。我会继续努力的，下一次也是。",
      "source_fingerprint": "9f11028aab632e3f957bc46c14ccdf07cae0fb1d4b97971594924a53b20049e6",
