    {
      "uid": "zhcn:6bbf7450df1c64187fa71e21",
      "kind": "text_data",
      "source_text": "向今天来到现场观看的家人们。\n还有与我一同走来的训练员。",
      "source_fingerprint": "fc402fcab1d24938e8ba873959142b66c9a76fc7c45a334268ae720d85893f90",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1286"
      ]
    },
    {
      "uid": "zhcn:38a3ec399f3e75e622606ac4",
      "kind": "text_data",
      "source_text": "您还记得母亲的跑姿呢。\n很荣幸。为了不输给她，我会更加精进的。",
      "source_fingerprint": "3835e0533f116c2060c11bf7f1af394933eea0dd93be2d9bc6c4c26a37b823c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1287"
      ]
    },
    {
      "uid": "zhcn:96cb78b2154b2aa62c305030",
      "kind": "text_data",
      "source_text": "向今天来到现场观看的家人们。\n还有与我一同走来的训练员。",
      "source_fingerprint": "fc402fcab1d24938e8ba873959142b66c9a76fc7c45a334268ae720d85893f90",
