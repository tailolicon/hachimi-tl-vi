      ]
    },
    {
      "uid": "zhcn:700f176edbbc740a7626c5e8",
      "kind": "text_data",
      "source_text": "以这场胜利为跳板，\n迈向更高的高度。我们两人都燃起了最高昂的斗志！",
      "source_fingerprint": "76bdad0511e70347a5c1bd276d7e1647de139f6dd25459b1ec346d678a9a724e",
