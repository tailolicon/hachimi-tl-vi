      ]
    },
    {
      "uid": "zhcn:eccbeec557da476a6a341098",
      "kind": "text_data",
      "source_text": "爬上顶点后的下个舞台是？",
      "source_fingerprint": "5231108f75f562991106ec132dba3fa850be5288a06932bcf396ee9c76dcf406",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "776"
      ]
    },
    {
      "uid": "zhcn:eba4aa96eb7b8e204abfdd3e",
      "kind": "text_data",
      "source_text": "请将获胜的喜讯传达给你想告知的对象！",
      "source_fingerprint": "dc908050950e3031c77dd21aab08a9f840852ad60e3867db3221a6d4837db989",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "777"
      ]
    },
    {
      "uid": "zhcn:0a5627e06af5a70ff322e1e3",
      "kind": "text_data",
      "source_text": "登上了顶点后，接下来有什么规划吗？",
      "source_fingerprint": "0ededcac8415de40bea42e0458cc74c4da9953ace86863c4af203960e24666ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "778"
      ]
    },
    {
      "uid": "zhcn:945b28f5766a8be900dc35c4",
      "kind": "text_data",
      "source_text": "想做什么来庆祝获胜？",
      "source_fingerprint": "1ad5287162b142e59e7763176b295cf130e756146f620d35763bb101a458733d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "779"
      ]
    },
    {
      "uid": "zhcn:112c16b249db967f058c7f59",
      "kind": "text_data",
      "source_text": "你的爱犬赛巴斯钦过得怎么样？",
      "source_fingerprint": "527828642f59db8e37ee86fd04b6a99c5b11bf940f0fea3995bbe10561f53ddb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "78"
      ]
    },
    {
      "uid": "zhcn:b299bf14f760b3c72450b222",
      "kind": "text_data",
      "source_text": "想将获胜的喜悦分享给谁？",
      "source_fingerprint": "13d05e843f2c8c3977f0ffc6635a9413dc9b8cf1f0811d6b516b1804dce1eaf1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "780"
      ]
    },
    {
      "uid": "zhcn:81c8df198c73d8a7eb7c0307",
      "kind": "text_data",
      "source_text": "是能充分感受到气魄的表现呢……！",
      "source_fingerprint": "00e5ca39dd471dc0116c7a62f79c360c753730ae161999b0a91e4d5ec6e4b89f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "781"
      ]
    },
    {
      "uid": "zhcn:5541d364233e8f1119c8a31b",
      "kind": "text_data",
      "source_text": "请跟缠斗至今的竞赛对手说些你的感想！",
      "source_fingerprint": "77fdfa8d7f1751796f102b187479cd76bb6cd4b36c2253da84ddb25d8510b193",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "782"
      ]
    },
    {
      "uid": "zhcn:41967dc4519c26064b6c80f4",
      "kind": "text_data",
      "source_text": "请对粉丝发表一句感言！",
      "source_fingerprint": "7c5af0f64085ff6426a046679705388129f151c4ca7bad839a95ba1f0a10f1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "783"
      ]
    },
    {
      "uid": "zhcn:12872a8697bfcdbdfc48d875",
      "kind": "text_data",
      "source_text": "请对一同奋战到最后的签约训练员说句话！",
      "source_fingerprint": "2125472a560c2c3b1e376536c0752e563e24cdf7085d9de5919078e9eb519504",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "784"
      ]
    },
    {
      "uid": "zhcn:42282f6e3b5584e4b1070b16",
      "kind": "text_data",
      "source_text": "有准备要给自己的奖励吗？",
      "source_fingerprint": "14b685593736ffb5fa17d582e180c59f9a998ab31879766485d4c2a6a1df0338",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "785"
      ]
    },
    {
      "uid": "zhcn:5363d3ec6d0e66aee2678e2f",
      "kind": "text_data",
      "source_text": "想将现在的心情传达给谁呢？",
      "source_fingerprint": "8624555181e4608493f68c9e8fa8f515546db36dd9cddaac1546805353618f02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "786"
      ]
    },
    {
      "uid": "zhcn:d8413ec22e3b8cdb165141c7",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！！",
      "source_fingerprint": "6cb01c60c782580959f4f9700be723fcabcbaf360e4916e2d60c683a700c8e9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "787"
      ]
    },
    {
      "uid": "zhcn:1e7329a758e21e02eb5c2246",
      "kind": "text_data",
      "source_text": "想将现在的心情传达给谁呢？",
      "source_fingerprint": "8624555181e4608493f68c9e8fa8f515546db36dd9cddaac1546805353618f02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "788"
      ]
    },
    {
      "uid": "zhcn:f9d4e22fcd64d319a0025e46",
      "kind": "text_data",
      "source_text": "胜利女神对你展露了微笑呢！",
      "source_fingerprint": "6cf5464ea41a2ea63f4cdfd7554fce72014cb9969ef9a8810ec7d03f93c32f41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "789"
      ]
    },
    {
      "uid": "zhcn:409ee8cba6e990c3f12b02ef",
      "kind": "text_data",
      "source_text": "请针对今天的竞赛发表感言。",
      "source_fingerprint": "1516de24f975bb2efc48a659772b39c274a075ebecb5d13fd8c0aaeb0b71fe86",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "79"
      ]
    },
    {
      "uid": "zhcn:287c2fb1068b7c9279730993",
      "kind": "text_data",
      "source_text": "请对与你互相扶持至今的训练员说句话！",
      "source_fingerprint": "65bda414adda2f588444fe602b14ee3046dc42c89a34acaa31bcfce9791edd4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "790"
      ]
    },
    {
      "uid": "zhcn:9508968329e1b89b833c3dae",
      "kind": "text_data",
      "source_text": "请向竞赛对手发表些感想。",
      "source_fingerprint": "91b66bb7f519d6b54edabc6fa63721331a516ab213f707d1f4412f0930ac410d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "791"
      ]
    },
    {
      "uid": "zhcn:bd265364344dc171b76e2ff6",
      "kind": "text_data",
      "source_text": "你的「饥渴」已透过这场战役获得满足了吗？",
      "source_fingerprint": "a0b53c5ffadf359722eb57b92601f38675f85c8b7bd32d16b1dacfa077efed6f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "792"
      ]
    },
    {
      "uid": "zhcn:0fb7f071fa131ca648b335a1",
      "kind": "text_data",
      "source_text": "除了胜利之外，还透过决赛获得了什么呢？",
      "source_fingerprint": "fc06f09b1c29f090b6fcb8ef76ad960248d337bb3874ea14e0130ba2cffbc975",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "793"
      ]
    },
    {
      "uid": "zhcn:13ea535f47060d85c1a43254",
      "kind": "text_data",
      "source_text": "请告诉我们你登上了顶点后的心情！",
      "source_fingerprint": "bbbd5039e8d66f153908979cbb35108e1b24e5c9482279f50e4dc970957eeeb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "794"
      ]
    },
    {
      "uid": "zhcn:438b8d7e6849674f2f4111e4",
      "kind": "text_data",
      "source_text": "请向给予你支持的家人发表一些感言！",
      "source_fingerprint": "f3a7a0f0b18eba469b1935d506cd62042e8e96815abe008ceead25871ade0348",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "795"
      ]
    },
    {
      "uid": "zhcn:cf449e7b2d4cf20d32dd6ab8",
      "kind": "text_data",
      "source_text": "哎呀？你抱着的花束是……？",
      "source_fingerprint": "b8e07001b9cea89840182775b76be2ee716f8711c841cb940e67211632ebb5aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "796"
      ]
    },
    {
      "uid": "zhcn:a8d9748bd89f909d36e9cc43",
      "kind": "text_data",
      "source_text": "你那自由自在的表现真的是深具勇者风范！",
      "source_fingerprint": "4db66f99f01856e93a4a530a2ae74075bba2af0ec350b1c8b37a439e2dbbbfd9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "797"
      ]
    },
    {
      "uid": "zhcn:e8c2771d2cd329668d858ad5",
      "kind": "text_data",
      "source_text": "请告诉我们你今后的计划！",
      "source_fingerprint": "78f8f7c4850ba61807f07175946eb1279018504f2c21fdd9c182d2375dc19858",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "798"
      ]
    },
    {
      "uid": "zhcn:3a853f4bacd4bcfe23d5513b",
      "kind": "text_data",
      "source_text": "请对与你同甘共苦的签约训练员说句话！",
      "source_fingerprint": "864ee68c0ac2732b781ec43d63211fadacd279128903242f3e499ea0248aebdf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "799"
      ]
    },
    {
      "uid": "zhcn:7058716f4039fdafe2532864",
      "kind": "text_data",
      "source_text": "维持良好状态的秘诀是？",
      "source_fingerprint": "3e93a90e883e526607949218185e3392d9c1ca1a422bc0b8c1b3a1156fa88d3a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "8"
      ]
    },
    {
      "uid": "zhcn:20333df91887c7a3ddc323de",
      "kind": "text_data",
      "source_text": "兼顾模特儿工作还能如此活跃，真厉害！",
      "source_fingerprint": "ef8a21384674be0686597e7c5bd1c4a4acd438dd248e7bdb228ff1e84e6df68d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "80"
      ]
    },
    {
      "uid": "zhcn:dba71797970f48b6262dcd28",
      "kind": "text_data",
      "source_text": "竟然让我们看到那样的表现……太厉害了。",
      "source_fingerprint": "2a4b2703502378adbb0734d19de469df050902de6d1fd555ba4c8de9482ed479",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "800"
      ]
    },
    {
      "uid": "zhcn:fc5d5dbc37eed92b915e5587",
      "kind": "text_data",
      "source_text": "请发表几句感言吧！",
      "source_fingerprint": "9e2eb1e19b5071fe45c7b92bcaa50e4fd9b979a9a1871d5c33e26c41572637dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "801"
      ]
    },
    {
      "uid": "zhcn:bf77137d3f5b6dccc22c1c3e",
      "kind": "text_data",
      "source_text": "请对粉丝们发表几句感言！",
      "source_fingerprint": "88f6437428266213a7a233298a726374f64de07574119309fd1e3f342c4ca3da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "802"
      ]
    },
    {
      "uid": "zhcn:83f35b2d44fce5838116bda7",
      "kind": "text_data",
      "source_text": "你是以什么样的心情面对竞赛的呢？",
      "source_fingerprint": "4bd3202703a25719cb74a8d7066db47cc31e7f974580080de2b17a42d699644e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "803"
      ]
    },
    {
      "uid": "zhcn:748a01629760d8e6ecb7dce8",
      "kind": "text_data",
      "source_text": "请告诉我们你现在的心情？",
      "source_fingerprint": "0aaaaa85a44b63b971501900d4d597dc8db52eef71c7ab677a1e80302f11b79e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "804"
      ]
    },
    {
      "uid": "zhcn:7b3b2e0551c0aec65e6e7d57",
      "kind": "text_data",
      "source_text": "请为今天的竞赛做个总结！",
      "source_fingerprint": "053000db9f76b734f8d14c373d97066ed8e42a92d33266b4b72c6b5977ed7d09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "805"
      ]
    },
    {
      "uid": "zhcn:e5048910d45dac27f1e49155",
      "kind": "text_data",
      "source_text": "请对家人们说些感言！",
      "source_fingerprint": "bfd89d76dd214d5ef847f6cdfd9ca867b2d4d76588cd48719c50e8d305a784e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "806"
      ]
    },
    {
      "uid": "zhcn:fca5f86d8e92e0b2ff1f88d3",
      "kind": "text_data",
      "source_text": "请向你重视的对象发表一些感想！",
      "source_fingerprint": "caf50958fbdf13056524772541a63dacf3a03625d13340b49e51dd05d8059590",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "807"
      ]
    },
    {
      "uid": "zhcn:b235cf98ca0cc27108c88263",
      "kind": "text_data",
      "source_text": "请向为你声援至今的粉丝说句话！",
      "source_fingerprint": "731f2464c60761dbf5d5e339cae580ec178baf10b93def2a7da1157dfd19748a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "808"
      ]
    },
    {
      "uid": "zhcn:98b1261e8b8534f8ce735ab3",
      "kind": "text_data",
      "source_text": "请直接了当地告诉我们，你现在的心情如何？",
      "source_fingerprint": "5b38a13e0fd006812f5b143b90797685a5bdfa8977ffa48740d30d4492083da2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "809"
      ]
    },
    {
      "uid": "zhcn:ae0c2fd54dda2e6e0f4ece40",
      "kind": "text_data",
      "source_text": "有令你在意的对手吗？",
      "source_fingerprint": "f54443c22c002308655301dccf444a2571f1d74d539e3aaf389661b79db3c487",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "81"
      ]
    },
    {
      "uid": "zhcn:f8e995dbd8a7f34f002805dd",
      "kind": "text_data",
      "source_text": "现在最想做的事情是？",
      "source_fingerprint": "fb1bf951e64f8e5ea079ef5ab872dc51f83c448ba3442799948cf185121b3a6b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "810"
      ]
    },
    {
      "uid": "zhcn:18635ffa1d84fb67ef457986",
      "kind": "text_data",
      "source_text": "请对签约训练员说几句话！",
      "source_fingerprint": "b0c0404e3041fda2af359c294ae004f0acbc4b091c149471652af35a11ce86d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "811"
      ]
    },
    {
      "uid": "zhcn:6dcbae8bdc6d72fd6d806767",
      "kind": "text_data",
      "source_text": "请用一句话来形容你拿下优胜的心情。",
      "source_fingerprint": "476b937226e3d03de871ae9357aacd0c2e5d97a142fc115817fddd30c00b78dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "812"
      ]
    },
    {
      "uid": "zhcn:c9d07cb92aa01dbf66d13f1e",
      "kind": "text_data",
      "source_text": "宛如带领目白家得胜般的表现，相当精彩！",
      "source_fingerprint": "753bc8607124134536596b879b43b8cdfb3c4d29007bcc7a9e6cd5896815c3a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "813"
      ]
    },
    {
      "uid": "zhcn:e52d012b05dd005712241e70",
      "kind": "text_data",
      "source_text": "请对粉丝说几句话！",
      "source_fingerprint": "97c816d570abb7d12f0821eb6e9de1663087ec4aa6f94f3be0c307a9ca3b026c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "814"
      ]
    },
    {
      "uid": "zhcn:96464532dad7f60dde86cda5",
      "kind": "text_data",
      "source_text": "会想用什么当成「给自己的奖励」？",
      "source_fingerprint": "e11fe063a70ada7dbb465f2531748aaaa8bec87fb71a5e924049ec100c9507a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "815"
      ]
    },
    {
      "uid": "zhcn:c81690ce9dd90d8b5220e78a",
      "kind": "text_data",
      "source_text": "等一下有什么计划吗？",
      "source_fingerprint": "ef21e1d3166ae72cc17a631be4f6a0f48b1d0427f89186191bd75731f2ae2db1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "816"
      ]
    },
    {
      "uid": "zhcn:886acb8614d4bea5cdb0fed7",
      "kind": "text_data",
      "source_text": "听得见观众席传来庆祝优胜的盛大欢呼声呢！",
      "source_fingerprint": "9eccefdc986d223bb3463aa6d12ff971ea026c87399370821641842796802a7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "817"
      ]
    },
    {
      "uid": "zhcn:4ae382ca6fca158c0804d54f",
      "kind": "text_data",
      "source_text": "很厉害馁！这下明天的报纸版面都是雪子了！",
      "source_fingerprint": "0aa4d649afc661f9c06b3d99095914a71a30cc0cc4b39d280a16be28c97bf545",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "818"
      ]
    },
    {
      "uid": "zhcn:0197c2c126227dbd92c1de79",
      "kind": "text_data",
      "source_text": "连这里都听得见粉丝的欢呼声呢！",
      "source_fingerprint": "032dd2b099e2b30cfdc400fef98a29c007057c3c78c0277ebecead347b7738d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "819"
      ]
    },
    {
      "uid": "zhcn:e2baef93f34af0750e738ea8",
      "kind": "text_data",
      "source_text": "有能提升爆进力的好办法吗？",
      "source_fingerprint": "006536f84684466acdcbe147cd08bb859dcf070a5d27475d8711bc469082d67e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "82"
      ]
    },
    {
      "uid": "zhcn:66972652687907dac24459c2",
      "kind": "text_data",
      "source_text": "请向签约训练员发表你的感想！",
      "source_fingerprint": "404db520d69606999715eaef325ca853e0a0705c91c594d1f9cfef7d53a52316",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "820"
      ]
    },
    {
      "uid": "zhcn:5e8c71759ba59aed7696bf04",
      "kind": "text_data",
      "source_text": "请向签约训练员说几句话！",
      "source_fingerprint": "7643d53bbcd14f416a218d2239ce26db64c6d2190965dc003d00a1e780f160b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "821"
      ]
    },
    {
      "uid": "zhcn:c39b65e2d0f9ccd41dea4d74",
      "kind": "text_data",
      "source_text": "已经想好要给自己的奖励了吗？",
      "source_fingerprint": "3b6be7254fce51830ea6fb8de6680595defccb1314b6611996354ab73d63965f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "822"
      ]
    },
    {
      "uid": "zhcn:35d4078a5b6598b4e48a0055",
      "kind": "text_data",
      "source_text": "透过此胜，你是否更接近追求的「真理」了？",
      "source_fingerprint": "022940e935da678fbe5ab266dcb9deb558ddbd7373df9b1f4dbe7fa12dbb2f34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "823"
      ]
    },
    {
      "uid": "zhcn:d938022d34c53a8e1b4050ad",
      "kind": "text_data",
      "source_text": "透过这场胜利，有让你获得了什么吗？",
      "source_fingerprint": "2a5518b9e77fc7b49666dab718107754a4362b5b6068a82d7b69645a9f9044db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "824"
      ]
    },
    {
      "uid": "zhcn:69bd118bbb9c403b8ebaaa17",
      "kind": "text_data",
      "source_text": "预计做些什么来庆祝获胜？",
      "source_fingerprint": "dcc146da696d087f256782902119bc469ab0328ae2f1621786a568955d7ce316",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "825"
      ]
    },
    {
      "uid": "zhcn:43d38571c664fea0116b8dbd",
      "kind": "text_data",
      "source_text": "请问你是以何种心境去面对这次的盛大赛事？",
      "source_fingerprint": "a66d771b691c5dc79ca21c2cff714b5b3072f17b19516751b71cd68e84c2daf9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "826"
      ]
    },
    {
      "uid": "zhcn:5a255786eeb41d473d698351",
      "kind": "text_data",
      "source_text": "请告诉我们获得胜利女神眷顾的秘诀！",
      "source_fingerprint": "5c56460632cdb2525de7d6a8f871808f3c98e75e7529dbfde362108c5c8df313",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "827"
      ]
    },
    {
      "uid": "zhcn:96752a43b1adb22c1f0f13d9",
      "kind": "text_data",
      "source_text": "直到获胜为止的路途果然很艰辛吗？",
      "source_fingerprint": "25948e320fcec3214137e5ec594244a443b2de472cbdbacbc2a9d51e6c4d175b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "828"
      ]
    },
    {
      "uid": "zhcn:1de1466cd35101fd8261e230",
      "kind": "text_data",
      "source_text": "喊着「奖券藏口号」的欢呼声不绝于耳呢！",
      "source_fingerprint": "dda7e15996ed6f52b69a223ed742a0b158069d1d1d5e5b138609c29ac70c45ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "829"
      ]
    },
    {
      "uid": "zhcn:2d6e03fca94e967e01a25be4",
      "kind": "text_data",
      "source_text": "有今后想要交手的赛马娘吗？",
      "source_fingerprint": "3dd1aaa6401282c0461364c079c5d5d0f469ef81286086e97b72acc75d542b4d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "83"
      ]
    },
    {
      "uid": "zhcn:e92ca074f2e5ebeb36c13eca",
      "kind": "text_data",
      "source_text": "请说说你现在的心情！",
      "source_fingerprint": "7ffcd377e6a6ac7132795adaf740ff989cc0e8321a870fd489f4f9efd43ec2ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "830"
      ]
    },
    {
      "uid": "zhcn:b57b99635ece66a17481233b",
      "kind": "text_data",
      "source_text": "真是精彩的表现！现在的心情如何？",
      "source_fingerprint": "816f7c03cab6898c78e01a40dd42ee87502a89a3c202efd6932aff8749c79b9b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "831"
      ]
    },
    {
      "uid": "zhcn:3173843830dc3906049ac361",
      "kind": "text_data",
      "source_text": "请对签约训练员说几句话！",
      "source_fingerprint": "b0c0404e3041fda2af359c294ae004f0acbc4b091c149471652af35a11ce86d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "832"
      ]
    },
    {
      "uid": "zhcn:c0bdfbb4b80afb0e9f2ace41",
      "kind": "text_data",
      "source_text": "打算怎么庆祝获得优胜呢？",
      "source_fingerprint": "a1e3733e88583915a029f276f2998995e87fea6036024e2104ea249767b4ee23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "833"
      ]
    },
    {
      "uid": "zhcn:a2141905b560d43a76c45dd4",
      "kind": "text_data",
      "source_text": "请对支持你拿到优胜的签约训练员说句话！",
      "source_fingerprint": "3e306f737cd52f622ac44ab813a796332953b6c7bb45838aca28a9c29dc5dbb1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "834"
      ]
    },
    {
      "uid": "zhcn:2e056a79909635cb1bb0cd7f",
      "kind": "text_data",
      "source_text": "请向一路声援你拿到优胜的粉丝说句话！",
      "source_fingerprint": "b077c9a5aed268ba0ffaa5907d95c80e25e0233a98d7f0753d260f36833959b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "835"
      ]
    },
    {
      "uid": "zhcn:3925bb15364bc68410903a57",
      "kind": "text_data",
      "source_text": "你是不是越跑就越可爱啊！？",
      "source_fingerprint": "8d6461f85a60db6f66672d3e84b010328b69c6b31285ecd216cad545d84d7adc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "836"
      ]
    },
    {
      "uid": "zhcn:378e5dd5c5318c8fdc5ba78b",
      "kind": "text_data",
      "source_text": "请告诉我们你将来的展望。",
      "source_fingerprint": "57e753e25ffafb2e4c334a9d6bd55858e55eab3f7e375f29f48d916267cc8da6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "837"
      ]
    },
    {
      "uid": "zhcn:1dc8a9639b2b5e8794543faf",
      "kind": "text_data",
      "source_text": "战斗公主的获胜秘诀是什么？",
      "source_fingerprint": "d0d9d9320aa8b8036c0b5a0922a1e07c0f9d06cc25643b11e9ee4f4452dde703",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "838"
      ]
    },
    {
      "uid": "zhcn:8b459911d8b57c3e126d6750",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜，请告诉我们你现在的心情！",
      "source_fingerprint": "828eccbf2ebe710dbba2a24c2a68dc1bc97f0d5c304917cf60341b423a969cc1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "839"
      ]
    },
    {
      "uid": "zhcn:d0409ec7d386e18eefa3a95b",
      "kind": "text_data",
      "source_text": "会怎么庆祝自己的胜利呢？",
      "source_fingerprint": "28a95d25a1b58c09c115dc236f696eaa59c191fc461cf7f09f4d76076f32b05b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "84"
      ]
    },
    {
      "uid": "zhcn:877dfc425070a363bd5ad36e",
      "kind": "text_data",
      "source_text": "请让我们拍纪念优胜和制作首页特辑的照片！",
      "source_fingerprint": "9e749d4f2940fc77f202b73bb3e8562d94e5ac26f594ac86974e12cba117c3db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "840"
      ]
    },
    {
      "uid": "zhcn:48528630ae249db47020a462",
      "kind": "text_data",
      "source_text": "所以这次是你的作战奏效了对吧？",
      "source_fingerprint": "f836027c3381c56e449c526f00cd87f1818fd8a7008910ed45f13d4fe699b78e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "841"
      ]
    },
    {
      "uid": "zhcn:12cb6f4f523f0ba699faa0fb",
      "kind": "text_data",
      "source_text": "请对在观众席的同班同学说句话！",
      "source_fingerprint": "0edcea9843e1d6df07d73e49f06cdcead111016c0420cfc7da2d45554bba736a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "842"
      ]
    },
    {
      "uid": "zhcn:15fa25c3dcbce9105230b48f",
      "kind": "text_data",
      "source_text": "庆功宴会办得fabulous又gorgeous吗？",
      "source_fingerprint": "1b638ab4608445e3171b67d9e7ac70cc036cad2c8f501f245fb93318ca144d4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "843"
      ]
    },
    {
      "uid": "zhcn:ff9926cd8a57a846e54d8f23",
      "kind": "text_data",
      "source_text": "请对粉丝说些话！",
      "source_fingerprint": "77e7db6e4fcc382854ade795817983d877f7d03fac6cbc5d033b3117923bf9d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "844"
      ]
    },
    {
      "uid": "zhcn:9808ebab56088b57917458e2",
      "kind": "text_data",
      "source_text": "赢得胜利的现在，你最想跟谁分享喜悦？",
      "source_fingerprint": "ad561e46810c3bc95a9b6db4721aa0f9becf3fa6e39daeceb1c77658b719bba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "845"
      ]
    },
    {
      "uid": "zhcn:b8c21591e3d85bde233942f8",
      "kind": "text_data",
      "source_text": "你的双亲似乎都在观战呢。请对他们说句话！",
      "source_fingerprint": "8aebf8c2cd75272af5f4784bddc97b0a5b9bb1d8b34e6c6957c4f3c6781551c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "846"
      ]
    }
  ]
