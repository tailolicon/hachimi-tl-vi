    {
      "uid": "zhcn:83108405d6e5c350ffd5a25b",
      "kind": "text_data",
      "source_text": "真的……那些声音给了我力量。这是\n不仅是我，而是大家一起赢下的胜利！",
      "source_fingerprint": "2e53d2c427b75c47108629b651bdbea1516257f271343daf4f915e076528e0e5",
      "source_path": "text_data_dict.json",
