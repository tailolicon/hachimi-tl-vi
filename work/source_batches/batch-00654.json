      ]
    },
    {
      "uid": "zhcn:4549d112b4694d5416918495",
      "kind": "text_data",
      "source_text": "鹤丸刚志是，『很强』的。\n给所有这样相信着我的人！！",
      "source_fingerprint": "3b50f4ed31f9b42fd6f8d15b3c709f4578f65b74aeaf8e7aeeb06a182a34f6d0",
      "source_path": "text_data_dict.json",
