  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:c2adce8db015cc5f62f033d6",
      "kind": "text_data",
      "source_text": "你的魔法之力太令人佩服了！",
      "source_fingerprint": "93a8eea9f8eba49065cc7c46290bea0948b9b6ff883ed7ecf47c161d0121c2c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "847"
      ]
    },
    {
      "uid": "zhcn:318644c152801d1cc50691be",
      "kind": "text_data",
      "source_text": "请对你的家人说几句话。",
      "source_fingerprint": "9afa6a7a2c47efae54dfa9bafb6ab8e21cb017fcb5fdf4abcb1e4c4aa18c7f48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "848"
      ]
    },
    {
      "uid": "zhcn:c6d5258643c8f9f3b7147bed",
      "kind": "text_data",
      "source_text": "你刚才和队伍成员说了些什么对吧？",
      "source_fingerprint": "d25e0a67e7ca26e5b14adf6e95903c12aac53ecda402ff53cf0822b40e3d09aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "849"
      ]
    },
    {
      "uid": "zhcn:827e23fd1099d8ee8d62a212",
      "kind": "text_data",
      "source_text": "请告诉大家让你拿下胜利的致胜料理！",
      "source_fingerprint": "e0da58ba8b4b5512611634c6dc3b7dfa54b7221234192947b97faaa1bd53ba59",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "85"
      ]
    },
    {
      "uid": "zhcn:88d42288183ca41b10b68335",
      "kind": "text_data",
      "source_text": "请对支持你获得胜利的签约训练员说句话！",
      "source_fingerprint": "83deaec08b854576bf223c8d8e0203af6d5998db15a94922c307a4e4b4a86c62",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "850"
      ]
    },
    {
      "uid": "zhcn:ff7491816c34fc0f440b8262",
      "kind": "text_data",
      "source_text": "请向前来加油的粉丝说句话！",
      "source_fingerprint": "f2f1d38e72d3b33d29a74190755a9b287574306f0fd7a6878e60f5727d0f6df4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "851"
      ]
    },
    {
      "uid": "zhcn:55b5426b46161cf32614907c",
      "kind": "text_data",
      "source_text": "我很期待你的胜者舞台喔！",
      "source_fingerprint": "29b711c05310035310f9188406c19e45a579c8f7efc1fa1c31bad7a9571fe6ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "852"
      ]
    },
    {
      "uid": "zhcn:a9724c267dde4817ec908b9d",
      "kind": "text_data",
      "source_text": "若要为今天的竞赛下个标题会是什么呢！",
      "source_fingerprint": "1c52746e3c2895355412498eb8c2403ae4a87d51e90f77cb89d19bc38d8a12aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "853"
      ]
    },
    {
      "uid": "zhcn:b69bb54d8f47d3a95d67f29a",
      "kind": "text_data",
      "source_text": "请坦白形容你现在的心情！",
      "source_fingerprint": "eaae0c7b6a7a9276f572fc1fd54674b440a6726e2bcaebd3af44d6511a337704",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "854"
      ]
    },
    {
      "uid": "zhcn:d6352739c7f0ca7c2466d9e7",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "855"
      ]
    },
    {
      "uid": "zhcn:a3d4e5cda0d806fa162a18d8",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "856"
      ]
    },
    {
      "uid": "zhcn:2e2a49aa1032c2ebd48144bb",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "857"
      ]
    },
    {
      "uid": "zhcn:6bd849c3c621b0d616c072fb",
      "kind": "text_data",
      "source_text": "有没有想跟谁分享优胜的喜悦呢？",
      "source_fingerprint": "b55047926e65c68e803c48cfd96a2b642bc9429f44f2f12cc37042fe85e30da8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "858"
      ]
    },
    {
      "uid": "zhcn:5c9043c993813f13387024ad",
      "kind": "text_data",
      "source_text": "请向为你声援至今的人们说句话！",
      "source_fingerprint": "a57e03d7227e09b9b19fdde145eda6ae76b6e9b651b95045af8c3cc7b6598937",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "859"
      ]
    },
    {
      "uid": "zhcn:a8a0c77ec0be4e042b215b54",
      "kind": "text_data",
      "source_text": "竞赛中，请问你都在想些什么呢？",
      "source_fingerprint": "d0808c874dac6d086ededf694241babe1ca1440a09d07b94f62dd1e127163d59",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "86"
      ]
    },
    {
      "uid": "zhcn:b8b4d41095689aac7dc09362",
      "kind": "text_data",
      "source_text": "预计会怎样庆祝自己获得优胜呢？",
      "source_fingerprint": "f6945768edce79d491a35ace8f0f96561d27076510604ed54ce33b7e3e2e41d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "860"
      ]
    },
    {
      "uid": "zhcn:c6d4275bfa6121ef30118726",
      "kind": "text_data",
      "source_text": "会怎样庆祝自己获得获胜呢？",
      "source_fingerprint": "20fc7b9e55258f741be56bc1a5fcf25b0f0a65f029db014686e27e8a6b079b34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "861"
      ]
    },
    {
      "uid": "zhcn:0a04c3fa2823b32306a54173",
      "kind": "text_data",
      "source_text": "请对粉丝发表一句感言！",
      "source_fingerprint": "7c5af0f64085ff6426a046679705388129f151c4ca7bad839a95ba1f0a10f1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "862"
      ]
    },
    {
      "uid": "zhcn:8688f99298b57a9442c1379a",
      "kind": "text_data",
      "source_text": "你现在的心境如何呢？",
      "source_fingerprint": "1c7a7184233da8021d3efe1b062e4855f8b91d8ed8beabb4e850694d2d74262c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "863"
      ]
    },
    {
      "uid": "zhcn:ddb64f34c0b3cc63183e33d7",
      "kind": "text_data",
      "source_text": "请对签约训练员说句话！",
      "source_fingerprint": "52035a20f686c9314746b0b32ef70b537e6da674c79f6b1de14553096641d072",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "864"
      ]
    },
    {
      "uid": "zhcn:5ed23eb80aa144fb4f553697",
      "kind": "text_data",
      "source_text": "这份喜悦想第一个跟谁分享呢？",
      "source_fingerprint": "ad780518f21fc88d9534a53a26992089ad1b7f689dc837da1a2770f3542514c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "865"
      ]
    },
    {
      "uid": "zhcn:56a30907e4bcd6dc96121ab2",
      "kind": "text_data",
      "source_text": "请对竞赛时激烈争锋的劲敌们说句话！",
      "source_fingerprint": "460379efde6ab5003fc279585188cae086d8786d85f4bae3d83669e2b6b4b298",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "866"
      ]
    },
    {
      "uid": "zhcn:cf76556fa07b17becf0c29c8",
      "kind": "text_data",
      "source_text": "どんな気持ちで走りましたか？",
      "source_fingerprint": "0895a3c639538c25f384f43f5521a59158a72730d866037adda56bc78f4f93cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "867"
      ]
    },
    {
      "uid": "zhcn:1b14506080945b77496337e0",
      "kind": "text_data",
      "source_text": "最後にヒーローからみんなへ、一言！",
      "source_fingerprint": "0eab7a56efae313a1a76e628552bc77e6157a8d53ff10df0fa59701ff261dd02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "868"
      ]
    },
    {
      "uid": "zhcn:e85851f77acb86a04e3a663d",
      "kind": "text_data",
      "source_text": "在最后直线时彷佛窥见了异世界……",
      "source_fingerprint": "0e73e8f87c3ce29a6469134c5fd023d7d8bf57060074b8e732562a1349e9d12a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "869"
      ]
    },
    {
      "uid": "zhcn:e58ca51c0755a22e17682d4f",
      "kind": "text_data",
      "source_text": "你在竞赛前施展了什么样的魔咒？",
      "source_fingerprint": "7142e0480aea4d5d6940866b64b5e270271e69828388c7704c603638d28cc5d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "87"
      ]
    },
    {
      "uid": "zhcn:f0520be182fa33950d142325",
      "kind": "text_data",
      "source_text": "世界美丽计划的目标也达成了吧？",
      "source_fingerprint": "7f148727ff840e684e5a9647613b57173366d2b46c342c98c68ed83cb635d3c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "870"
      ]
    },
    {
      "uid": "zhcn:310b5d38bd2ef174f5a0a6c1",
      "kind": "text_data",
      "source_text": "福临？",
      "source_fingerprint": "c6007ce84aa3cbdf1da1cbac2509a8541c15455cbdaa72470e636f95c15d32ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "871"
      ]
    },
    {
      "uid": "zhcn:e7e6ae803c7ae5f87ebbf906",
      "kind": "text_data",
      "source_text": "已经决定好今后的规划了吗？",
      "source_fingerprint": "5bad6da6e3f1b59a2f93d11777ac175f9a7c868202505ad95e885dc0bf402c41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "872"
      ]
    },
    {
      "uid": "zhcn:608483d6552dcbfc259de19e",
      "kind": "text_data",
      "source_text": "请告诉我们你站上顶点此刻的心情！",
      "source_fingerprint": "e7c70c1b49cddae8be3535641dbec51eb24a54b5e8bd70f5dab20cd37847e6fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "873"
      ]
    },
    {
      "uid": "zhcn:9c4f30ef6069680b0e8342e3",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "874"
      ]
    },
    {
      "uid": "zhcn:791e48674d315562b2f1cea9",
      "kind": "text_data",
      "source_text": "请以冠军的身份说几句话！",
      "source_fingerprint": "b647c07252222aaaf6d0bbcc87b7e54238be45d93026be0816e00175b21f1f47",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "875"
      ]
    },
    {
      "uid": "zhcn:ffd5e15ee9f33e46894f24c6",
      "kind": "text_data",
      "source_text": "撑过了严苛考验后，现在的心情如何？",
      "source_fingerprint": "cd7d37a4b58cd62614d6a2cb1260f23b02bfd18cbeb28f58d8232ee6d9a2305f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "876"
      ]
    },
    {
      "uid": "zhcn:fd5edd873c6710f21d8f97c9",
      "kind": "text_data",
      "source_text": "今天的竞赛中有让你觉得感动的事物吗？",
      "source_fingerprint": "72d3f0822f4312c53a45d12c86bae9b3c05192fc243495a4d65b76989f519152",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "877"
      ]
    },
    {
      "uid": "zhcn:bcece4b4471c57eedfabc413",
      "kind": "text_data",
      "source_text": "请向为你声援至今的粉丝说句话！",
      "source_fingerprint": "731f2464c60761dbf5d5e339cae580ec178baf10b93def2a7da1157dfd19748a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "878"
      ]
    },
    {
      "uid": "zhcn:be1297a3aa90bf8e0c5e32e0",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "879"
      ]
    },
    {
      "uid": "zhcn:3a65f1e9020d82b639c234ca",
      "kind": "text_data",
      "source_text": "竞赛当中的哪个部分让你感到最为吃力？",
      "source_fingerprint": "017c0ef2f2f540647d07899009c17b37fbbbd1d74493fee33f25ebd645c87273",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "88"
      ]
    },
    {
      "uid": "zhcn:b98ddefd214ac596a0d6dc40",
      "kind": "text_data",
      "source_text": "简单来说，今天的获胜原因是？",
      "source_fingerprint": "d7853a48a3f3ab5a12edd0cbab6734dfd035d313e7814008521f8dd7c013e13c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "880"
      ]
    },
    {
      "uid": "zhcn:038ee26cc0a02fcc83a9f20c",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "881"
      ]
    },
    {
      "uid": "zhcn:7acafaaebe382719f91d5ef7",
      "kind": "text_data",
      "source_text": "我记住「圣王口号」了！",
      "source_fingerprint": "91e9bbb86f258ca8f09e16fc4e89c8f5d2344c37b03eb2b8980d22f669a37a7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "882"
      ]
    },
    {
      "uid": "zhcn:0c1f2a4235807a4dab628ce7",
      "kind": "text_data",
      "source_text": "听说你昨天晚上其实长了荨麻疹……？",
      "source_fingerprint": "03c28a5f519a3cdf0854b13e1ba08ae5447303ccd17842d1273b4f5b64e57402",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "883"
      ]
    },
    {
      "uid": "zhcn:bacaea0feae489562c83c8fd",
      "kind": "text_data",
      "source_text": "恭喜你获得优胜！",
      "source_fingerprint": "7dbef6f8cacab123c75f31d503257e9beb4c93e16aed31e6d018febdd38c735b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "884"
      ]
    },
    {
      "uid": "zhcn:cf3b7fbc0cff38fcf2933efe",
      "kind": "text_data",
      "source_text": "勝利を掴み取った今の感想を！",
      "source_fingerprint": "a7493d9c47ed2957fc22ec6bd437742521fdf27fb4fac77b0dab95462768977f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "885"
      ]
    },
    {
      "uid": "zhcn:a945ebf4d1e1a08cc94ff920",
      "kind": "text_data",
      "source_text": "この勝利を誰に捧げますか？",
      "source_fingerprint": "ac7a43c8e1e2aea437fcfd92f870c67112f039a4988fbdc477480dcad20795ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "886"
      ]
    },
    {
      "uid": "zhcn:21e226b72788f7eee0e5b14d",
      "kind": "text_data",
      "source_text": "呼喊「善信」的声音不绝于耳呢！",
      "source_fingerprint": "af217ae52ddf198aa7cd5faace0dc44d655981b4b6c310e59f15dbf5f202b6a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "887"
      ]
    },
    {
      "uid": "zhcn:6b16196d7bce2cd759f29024",
      "kind": "text_data",
      "source_text": "请对和你一同迈进的训练员说句话！",
      "source_fingerprint": "097ac93f8d36bb3ef9affe43c6d74379e30563e8729c2db3308f087ceacf6c16",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "888"
      ]
    },
    {
      "uid": "zhcn:fc19801bda0d6ead0c13c915",
      "kind": "text_data",
      "source_text": "震撼人心的胜利！是场相当激烈的竞赛呢！",
      "source_fingerprint": "f6ee265aacc9eb5e0abf022c3ac2e41ec8a3248a52772ae14da6dcdecec26f4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "889"
      ]
    },
    {
      "uid": "zhcn:32ffab15d8225e4a245a4789",
      "kind": "text_data",
      "source_text": "你经常称赞训练员，那自己会想要被称赞吗？",
      "source_fingerprint": "9fb01ceaad1b0bb6e8b502880ec3b4be2edba822e6cec68ea31857f8ac5bbbf5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "89"
      ]
    },
    {
      "uid": "zhcn:848ca03520a96b7ae474907d",
      "kind": "text_data",
      "source_text": "这场胜利，想先跟谁分享呢？",
      "source_fingerprint": "a50c631c76a52916c264ba5f53506626c017d08d120cdf001ec2728ec6803c23",
      "source_path": "text_data_dict.json",
