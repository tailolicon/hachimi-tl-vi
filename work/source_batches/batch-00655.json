        "1424"
      ]
    },
    {
      "uid": "zhcn:99e8d8bf70897d4921b9abad",
      "kind": "text_data",
      "source_text": "没、没有……什么特别的讲究。不过……，\n倒是有时会被人说身上有股甜甜的香味。",
      "source_fingerprint": "9387e46e0abcc1ea7f58a234ae560dd1d552c5bf4257da9bdcd21d68077cbec9",
      "source_path": "text_data_dict.json",
