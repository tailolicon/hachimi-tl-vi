    {
      "uid": "zhcn:4d1b15c597e83d9300456aa7",
      "kind": "text_data",
      "source_text": "意外地沉甸甸的呢。不过很开心！\n今天的直播，就把它摆在背景里吧♡",
      "source_fingerprint": "7cf39785cccfda7c1c8cc8c560138fb249b738d500d703bb734662469871c77c",
