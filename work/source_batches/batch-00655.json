    },
    {
      "uid": "zhcn:10abc8dda48d354a5caec8c5",
      "kind": "text_data",
      "source_text": "啊！？　其他人怎样都无所谓啦！\n我才是最值得关注的！　少看不起人了！",
      "source_fingerprint": "5a4b46297ce37fcb5f406133ea3f5c326f6147082e736554150dd496400ffd22",
