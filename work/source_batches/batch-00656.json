      ]
    },
    {
      "uid": "zhcn:fb0f88f6174fefc49361876b",
      "kind": "text_data",
      "source_text": "就好像还在奔跑一样，心还在怦怦直跳。\n真的……没有放弃，真是太好了！",
      "source_fingerprint": "5149dc62f3f54f74288efb87fe133faa6a76ef9c16c47b623f1fae69d045d4f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
