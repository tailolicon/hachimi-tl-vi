        "1528"
      ]
    },
    {
      "uid": "zhcn:17612170e2b7645ead51dc02",
      "kind": "text_data",
      "source_text": "真是留在记忆里的一场好赛事呢。\n这是我们共同抓住的，最棒的胜利哦！",
      "source_fingerprint": "cbc3e02d52e586a62cedb3d1ffedd3e0f7332689dcde81cecca81eb9d515d147",
      "source_path": "text_data_dict.json",
      "json_path": [
