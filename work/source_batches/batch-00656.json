      ]
    },
    {
      "uid": "zhcn:5bf462c43f596fec394b04fa",
      "kind": "text_data",
      "source_text": "谢谢你一～直支持着我！\n我们两个人的梦想……要一起去实现哦！",
      "source_fingerprint": "153e87b405fc85d498f7efbfb5affe96254a4ed968285e684423ada225ca5c3c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1479"
      ]
    },
    {
      "uid": "zhcn:342fefd711ead9aff5c1fe70",
      "kind": "text_data",
      "source_text": "哎呀，因为我很高兴能跟粉丝们挥手，\\n结果不由得就分心了～真是不好意思♪",
      "source_fingerprint": "ca8cb7a9e9897d63d9934841018aeac17833b6e04463182167078f06c406b337",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "148"
      ]
    },
    {
      "uid": "zhcn:b179935c181c6127c64b4273",
      "kind": "text_data",
      "source_text": "啊……。呜，谢谢！\n能跑出那样的赛事……我很感激……！",
      "source_fingerprint": "a7437b9fc2d84dcc9c7a07492e4f3ca3c4d4da089b00ba7164e5817f5f74be97",
      "source_path": "text_data_dict.json",
