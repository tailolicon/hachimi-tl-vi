        "1529"
      ]
    },
    {
      "uid": "zhcn:bda254891fec25898c7f3cf2",
      "kind": "text_data",
      "source_text": "我想决赛时要面对的挑战会变得更加严峻！\\n但我会加油的，还请大家声援我！",
      "source_fingerprint": "167680e523683ea98bffa6829727bcebdf99b39ecdf3df664312684e34116141",
      "source_path": "text_data_dict.json",
