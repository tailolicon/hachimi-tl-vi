    {
      "uid": "zhcn:1c1792017dc8553a6b90bf3f",
      "kind": "text_data",
      "source_text": "现在结束旅程还为时过早。\n这么想的，应该不止我一个吧？",
      "source_fingerprint": "5bcfd4a8ea8044eddfec8a7a48de05d0c61e4f007e63a1823ae2ab4404cee6d3",
      "source_path": "text_data_dict.json",
