    {
      "uid": "zhcn:00151fad1b946c52ce3eeab8",
      "kind": "text_data",
      "source_text": "比起永恒闪耀的星光，\\n不如化为贯穿黑夜的雷电。",
      "source_fingerprint": "ff4fb0632b0cc771a4e94ad50cf6c7532144cfe21287b72680d4c69a4a28dc4a",
      "source_path": "text_data_dict.json",
