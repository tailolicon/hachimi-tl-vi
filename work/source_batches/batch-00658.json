      ]
    },
    {
      "uid": "zhcn:0741f9ef00d8c669e6ad5e1a",
      "kind": "text_data",
      "source_text": "我觉得我已经传达了……\n通过刚才的奔跑。",
      "source_fingerprint": "74bd3ad3e376c267cec2cc994855dc531c1b5139a2a0d1ba09c6292388901604",
      "source_path": "text_data_dict.json",
