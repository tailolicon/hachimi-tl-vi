        "1075"
      ]
    },
    {
      "uid": "zhcn:1f02cca2e562e0f1e650bd24",
      "kind": "text_data",
      "source_text": "无数的视线与声援……。\n各位，还真是乐此不疲呢。",
      "source_fingerprint": "5feb810f7c1583ee26adbdd6d7bb229a5414e327b7040511fa94fc58af84edb4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1076"
      ]
    },
    {
      "uid": "zhcn:6f2efb9a5d97a2d32f9b6eae",
      "kind": "text_data",
      "source_text": "赛事难道会有尽头吗？\n——理想遥不可及，故而无远弗届。",
      "source_fingerprint": "731dc5befe04daf90311e113c7b243dc8f19b21cee81e47ce69aab16fcaddb65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1077"
      ]
    },
    {
      "uid": "zhcn:8db8e556883c4f26b0c639d0",
      "kind": "text_data",
      "source_text": "爱是改变身形摇曳的火焰。\n若与各位同看——不知会是怎样的颜色呢。",
      "source_fingerprint": "f58404cc98cc7e808d5128bc1b9a85b5b7003e39720cb36502beaede74a8e5c4",
