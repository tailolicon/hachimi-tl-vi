      ]
    },
    {
      "uid": "zhcn:dccd33a7c6f010f7c79fad3d",
      "kind": "text_data",
      "source_text": "锻炼身体之类的！　如果一直吃甜食\n会被训练员亲骂的哦～。",
      "source_fingerprint": "d0549bac33ac7ab2ca48e3d9105014b4a5048e6b94bc31c38ac85eb31dee251d",
