        "1260"
      ]
    },
    {
      "uid": "zhcn:34e2590017d53fbae3d5c8c7",
      "kind": "text_data",
      "source_text": "主君还在等我复盘呢。\n得快点过去才行……失礼了。",
      "source_fingerprint": "1a4f2ac3289c06b32519ad5854dd1ef560a1be249850207b590f85a92d417b1f",
      "source_path": "text_data_dict.json",
