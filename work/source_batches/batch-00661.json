    },
    {
      "uid": "zhcn:e458f7abbf298e129894dee0",
      "kind": "text_data",
      "source_text": "——可以。余允许你对余献上赞美之词。",
      "source_fingerprint": "44976183544c8e2879eef4e4f744a3fe98e71d41412694ed4ce22e7f44ae8cea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1334"
      ]
    },
    {
      "uid": "zhcn:25f84afdb6f2562ed850d59e",
      "kind": "text_data",
      "source_text": "――――哼。\n去慰劳一下他吧。那家伙，也算是做得不错。",
      "source_fingerprint": "c1bcff73bbc087200d5cac245ad4b0e20c281ca9fad52a926c43c7cfd7c49bc3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "1335"
      ]
    },
    {
      "uid": "zhcn:6d1075a473fee06070a687e8",
      "kind": "text_data",
      "source_text": "——可以。余允许你对余献上赞美之词。",
      "source_fingerprint": "44976183544c8e2879eef4e4f744a3fe98e71d41412694ed4ce22e7f44ae8cea",
      "source_path": "text_data_dict.json",
