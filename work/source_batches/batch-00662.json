      "kind": "text_data",
      "source_text": "因为，大家都是动真格的嘛。\n天才的真本事，必须要展示一下对吧？",
      "source_fingerprint": "27a9c27ee39096a00cd333d4bde71d97368a81377c9c2ece5cae3bbbef441cd7",
      "source_path": "text_data_dict.json",
