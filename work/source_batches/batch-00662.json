{
  "schema_version": 1,
  "batch": 662,
  "batch_count": 1682,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "f1c6893d60a8989361cfd9c371f56bc8ec25f81d",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:af23d2135d2e07b852bdbd47",
      "kind": "text_data",
      "source_text": "会想将这次的胜利传达给谁呢？",
      "source_fingerprint": "9a3aacf7bd22d81aedb86e65ffa6085109bbf8dbd7b49e803fc91b716666e2f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "523"
      ]
    },
    {
      "uid": "zhcn:7d35d114ce6a678aa1e8b8d6",
      "kind": "text_data",
      "source_text": "已经决定好祈求好运的美甲款式了吗？",
      "source_fingerprint": "93b013a1a1181b71a9f46b8843c74f2572b2076d52c7b4d4503582077fd9d02c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "524"
      ]
    },
    {
      "uid": "zhcn:5b6992f6dba1ecfdc09fc2a3",
      "kind": "text_data",
      "source_text": "胜利的祕诀莫非是你嘴里的糖果……？",
      "source_fingerprint": "da5d7c816a50dbd5ea4dfc139d3cccd9c136c644b3c33736c8532b0a6f6000fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "525"
      ]
    },
    {
      "uid": "zhcn:f89f8eaa0a62d0956bc3bd6b",
      "kind": "text_data",
      "source_text": "直白地说，获胜的原因是什么呢？",
      "source_fingerprint": "4806defc7425eeebf1eabb7fd994210a67c482a09903e8deff93623747a92ff3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "526"
      ]
    },
    {
      "uid": "zhcn:c2857ae1f9930b4e55a42f48",
      "kind": "text_data",
      "source_text": "请对粉丝说句话。",
      "source_fingerprint": "5158e5968d3925472a69db66731a6b7d470a51af6c432a70560917953d76b24c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "527"
      ]
    },
    {
      "uid": "zhcn:84f8aaceec0b2c203a577751",
      "kind": "text_data",
      "source_text": "可以预见决赛时会聚集更多强敌赛马娘……",
      "source_fingerprint": "3217d2821f73b820a3af5a5a8d3770066b708a7d2c4a1824089bf108d25e261f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "528"
      ]
    },
    {
      "uid": "zhcn:b2ba6e032c3970a196947955",
      "kind": "text_data",
      "source_text": "有令你在意到想在决赛一起奔驰的选手吗？",
      "source_fingerprint": "b47ca6985bb52e28b3991c73d86a709a0aebd38ffba24a770630275dd1c7b299",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "529"
      ]
    },
    {
      "uid": "zhcn:bc135fc4179f2ed9d63a203b",
      "kind": "text_data",
      "source_text": "最后直线时的强劲脚力令人印象深刻呢！",
      "source_fingerprint": "fcc37bbeec2b5660afe8b028d49d9a3fdc67a3745d2580db8521d3d86502b4f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "53"
      ]
    },
    {
      "uid": "zhcn:5ed54e781d8645dcc5bcc6b0",
      "kind": "text_data",
      "source_text": "利落的表现简直就像变魔术一样！",
      "source_fingerprint": "2d7278ef9eea7bc851c9dd37e6505c7f487e67699f5be984bc582134a3ca3bef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "530"
      ]
    },
    {
      "uid": "zhcn:cde37974f80e6442355139af",
      "kind": "text_data",
      "source_text": "刚才在粉丝面前摆出的可爱动作是？",
      "source_fingerprint": "89be043b9143e7457746ffea54a025a5ebb378a2717cef40592618d4ec05faa4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "531"
      ]
    },
    {
      "uid": "zhcn:59c914b83865d741f53198fa",
      "kind": "text_data",
      "source_text": "你一路走来给人的印象都很沉稳对吧？",
      "source_fingerprint": "6ca539b6213ed65572a2c78e7c8e9fade1bb1d7065ee3cd0226f8351b90f4cbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "532"
      ]
    },
    {
      "uid": "zhcn:ba40460df5e992f42876cf83",
      "kind": "text_data",
      "source_text": "请针对决赛说说你的抱负！",
      "source_fingerprint": "16f9fcb1324a705a0dca15b0434206f448fddaf820e5172eee7b85e4b9b6b1ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "533"
      ]
    },
    {
      "uid": "zhcn:c00d10a6bf7b3bc8a221cd37",
      "kind": "text_data",
      "source_text": "那个护身符是朋友送的吗？",
      "source_fingerprint": "5d8c087f9f3d6ec7153f92dd11b65e690576929ab56650984745c0b70e91e996",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "534"
      ]
    },
    {
      "uid": "zhcn:815ced945a9ee0c7fa08b7b4",
      "kind": "text_data",
      "source_text": "你能一直保持充沛活力的秘诀是？",
      "source_fingerprint": "52c5ea14c02df6373eb59ef590083d679c86f453295e1b564c8d24396a979721",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "535"
      ]
    },
    {
      "uid": "zhcn:a9ff0734d9783e4aa4c0bd63",
      "kind": "text_data",
      "source_text": "你的表现被评论为「能让人获得勇气」喔！",
      "source_fingerprint": "bc1cf49313e76de5fe770e7102a010ff2f14cc651db0bcd3360f3a45414a7767",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "536"
      ]
    },
    {
      "uid": "zhcn:1511667c6408c615588a7659",
      "kind": "text_data",
      "source_text": "面对粉丝有什么想传达的消息吗？",
      "source_fingerprint": "776b960cc4021fbf10e010eea0314ac4f0030b415e61c0abaa868e46d1883815",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "537"
      ]
    },
    {
      "uid": "zhcn:cddcf998b0cbddc0bf5d2216",
      "kind": "text_data",
      "source_text": "请告诉我们让你感到松一口气的瞬间是何时？",
      "source_fingerprint": "a8f2b1c245da02bd001d34b079e6c5d3ac523fdf3f1cd4d196c646a78359e93b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "538"
      ]
    },
    {
      "uid": "zhcn:3f6a0d4b7e447e464bbfb8b8",
      "kind": "text_data",
      "source_text": "请告诉我们在竞赛前必做的流程！",
      "source_fingerprint": "9cfb48ea8fde81b42f084bf27887484a0802de6e66e61b0c3eae174e44571cdb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "539"
      ]
    },
    {
      "uid": "zhcn:1ca04309bfc6e9acfd843316",
      "kind": "text_data",
      "source_text": "会想给自己什么样的奖励？",
      "source_fingerprint": "fccda8ab44188d79bb2659eeb9a01a36be30dd51ef0ba4ec342ddbbc25a5ad19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "54"
      ]
    },
    {
      "uid": "zhcn:6be28717389d62e1fcbfdda1",
      "kind": "text_data",
      "source_text": "日頃心掛けていることは？",
      "source_fingerprint": "7e0202af73cb60b0733dbe94590ad3c9c44db26fee93342daef3f8a0953def8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "540"
      ]
    },
    {
      "uid": "zhcn:9acad4911ce46f350cca6d5c",
      "kind": "text_data",
      "source_text": "レース後のウマトック投稿、すごい反響でしたね！",
      "source_fingerprint": "e7b2166f0b3121c42188dc0e023e1468421493997db8524f2484d2e7b085cea1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "541"
      ]
    },
    {
      "uid": "zhcn:366f43836181128223580301",
      "kind": "text_data",
      "source_text": "勝負メシはなんですか？",
      "source_fingerprint": "e0e9fe3bf80ea4c38312a56e0c1153737b6f9befcfe7fb156018f9d31e412958",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "542"
      ]
    },
    {
      "uid": "zhcn:23db4312289d38f9bc518559",
      "kind": "text_data",
      "source_text": "竞赛时特别注重什么地方呢？",
      "source_fingerprint": "17049ea9c281943667741ca2198a84af023a580e9b6c96caf5b7f4cb887081e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "543"
      ]
    },
    {
      "uid": "zhcn:f0fbd71775e7a3098cfb73bb",
      "kind": "text_data",
      "source_text": "最后冲刺时飞舞的缎带令人印象深刻！",
      "source_fingerprint": "c312235862222cddd8ae18eafded8c97a4591061730309cb891b14287191166c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "544"
      ]
    },
    {
      "uid": "zhcn:71bd76e408ed499514cec5b4",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "545"
      ]
    },
    {
      "uid": "zhcn:fede2efe78f8b3d54b235fad",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝发表一句感言！",
      "source_fingerprint": "3b0e691d9d91c19c6082542a0a1c94e0a3915e2db2bceb4c2fc701ec5a460658",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "546"
      ]
    },
    {
      "uid": "zhcn:b5810b5140e9f92bc8465dfd",
      "kind": "text_data",
      "source_text": "签约训练员是否也发挥了庞大的助力呢？",
      "source_fingerprint": "f0fb0fba5f86ee2a6ede22173f48e5635a9c5077a64d9a58884f4101b90a4d61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "547"
      ]
    },
    {
      "uid": "zhcn:a0625f34f054d1eaff76f5d9",
      "kind": "text_data",
      "source_text": "请针对下场比赛说出你的抱负！",
      "source_fingerprint": "2b90b7dfd011593ab25e80e411c31c2c72407eb7cb28a5d180632dc70dcd1506",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "548"
      ]
    },
    {
      "uid": "zhcn:4fcbe27b1913f9fe8efa988d",
      "kind": "text_data",
      "source_text": "这份喜悦想要传达给谁呢？",
      "source_fingerprint": "ba95759be7d5eb21d39ba1e7be3acd96a947c48b22d54aa3fd9c4474ba098acc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "549"
      ]
    },
    {
      "uid": "zhcn:3290a2c4d6a9e7a29f0c9601",
      "kind": "text_data",
      "source_text": "今天能获胜的原因是什么呢？",
      "source_fingerprint": "f94a17fb3a38e1a899b0c84e917d9cea3359f6df9dfc50c0294c890970ac11c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "55"
      ]
    },
    {
      "uid": "zhcn:893782898eed0ba22b78472c",
      "kind": "text_data",
      "source_text": "有想吃什么来庆祝胜利吗？",
      "source_fingerprint": "9962fbb6d266f3cd2a310be09f0b71c08436a4e9570d15c5d83dfe7a7ee2e46c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "550"
      ]
    },
    {
      "uid": "zhcn:a86c178e97496e153b7f35e5",
      "kind": "text_data",
      "source_text": "在比赛结束后有安排什么娱乐吗？",
      "source_fingerprint": "afc37c73267afe38167a3fedc3dc06592c89723afc1a906e4fa4c78313f8281f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "551"
      ]
    },
    {
      "uid": "zhcn:30a08eee2d4882a990c7be98",
      "kind": "text_data",
      "source_text": "是做了什么讨吉利的事而赢得了比赛呢？",
      "source_fingerprint": "953d3417ce5fcb870689dd6989d47331077070db4277ced8c03ad1c7db11ac2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "552"
      ]
    },
    {
      "uid": "zhcn:86b84af93cae81860ea2cf18",
      "kind": "text_data",
      "source_text": "领先抵达终点的瞬间，你在想着什么呢？",
      "source_fingerprint": "bb3168a68d659cda8d63c858fd0217e0eed3fa40237bf36b0c03b1234ec89530",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "553"
      ]
    },
    {
      "uid": "zhcn:62d3fafa09fba99a61b121bb",
      "kind": "text_data",
      "source_text": "请说说你对下场比赛的抱负。",
      "source_fingerprint": "e0a355a96d14e009e3c82891b4bf0383e4f8378e0addc2af78fda5085e8f4c9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "554"
      ]
    },
    {
      "uid": "zhcn:803faa0a76ced2bbed0b2137",
      "kind": "text_data",
      "source_text": "可预见决赛时会聚集更多强者赛马娘喔？",
      "source_fingerprint": "f77b190cbfc2ceeb83936689e14beb00bb2c4d257031134d65d50c416af8d96a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "555"
      ]
    },
    {
      "uid": "zhcn:185fa942a61c9dbba1d7a3ff",
      "kind": "text_data",
      "source_text": "有意见表示期待决赛是「目白家对决」喔？",
      "source_fingerprint": "efc708433b31b5acd56f0fb98b904897ddd3240e1194ff5cb2af3be0f18b9dec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "556"
      ]
    },
    {
      "uid": "zhcn:b64be7647156a2a723657199",
      "kind": "text_data",
      "source_text": "多伯总是给人很冷静的感觉呢……",
      "source_fingerprint": "69174a6b663a21199636e11c1ce189de4cf4e6a82a8de8910c38dc5f54f5c145",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "557"
      ]
    },
    {
      "uid": "zhcn:e5e482e34fea7d48cedaf6e5",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "558"
      ]
    },
    {
      "uid": "zhcn:f49b7391f40d00dbfb2b6293",
      "kind": "text_data",
      "source_text": "应该会就这样朝着优胜直直奔去对吧！？",
      "source_fingerprint": "ac87967a37b750396c7f512bc8914344ef4dd02dfed17c9fefcd2dcaff95295e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "559"
      ]
    },
    {
      "uid": "zhcn:7077c16ec0ee28ca642f194b",
      "kind": "text_data",
      "source_text": "请问你都吃些什么「致胜料理」呢？",
      "source_fingerprint": "1bb951e051ec6eb3af795068f4ff7a03d8f7449a6dde39d2394309baa5ae22ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "56"
      ]
    },
    {
      "uid": "zhcn:a23bcfd4038e978f6729f7a3",
      "kind": "text_data",
      "source_text": "你是以什么样的心情去挑战竞赛的呢？",
      "source_fingerprint": "9bf8e368bee15ba557f168ccdcce45138bdbddf7a100cf96bbb7c14cc544b5d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "560"
      ]
    },
    {
      "uid": "zhcn:ef8962ba7c20dcf58f7a3318",
      "kind": "text_data",
      "source_text": "刚刚起就持续不断的「圣王口号」是……？",
      "source_fingerprint": "28f1acd95261a559e10256a438b4a04e453f758d5190b7873da6750fe0143d31",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "561"
      ]
    },
    {
      "uid": "zhcn:e060d7c38be916f57510c09c",
      "kind": "text_data",
      "source_text": "可以预见决赛时会聚集更多的强敌……",
      "source_fingerprint": "4b0173c736b29597ea9675e440991360bd7b5c1e269c845501883708661123d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "562"
      ]
    },
    {
      "uid": "zhcn:10a73102eab55386573e0e12",
      "kind": "text_data",
      "source_text": "请对粉丝说句话！",
      "source_fingerprint": "e4120d78fbf1092e6b2fafd181fece9e0af0ec5b78238248d9a4228d438d3c77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "563"
      ]
    },
    {
      "uid": "zhcn:fc73c1b1faaa68102f4343ec",
      "kind": "text_data",
      "source_text": "可预见决赛时会与更强的强敌交战吧……？",
      "source_fingerprint": "bdf6f82785a7a4d7f42b80ac44fa0dbdb7166232dd6c19e1c866698a5ac04893",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "564"
      ]
    },
    {
      "uid": "zhcn:b124067b01adda15ad8df24f",
      "kind": "text_data",
      "source_text": "请说说你现在的心情！",
      "source_fingerprint": "7ffcd377e6a6ac7132795adaf740ff989cc0e8321a870fd489f4f9efd43ec2ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "565"
      ]
    },
    {
      "uid": "zhcn:da7178d92c64e7ca79167e32",
      "kind": "text_data",
      "source_text": "真是漂亮的胜利呢！",
      "source_fingerprint": "44ac9b5d397b49d533b005a6801d0678d2d34c210d01d5f532e74ab71977c763",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "566"
      ]
    },
    {
      "uid": "zhcn:c01deb881d4392fe78ff6494",
      "kind": "text_data",
      "source_text": "ファンの皆さんに一言お願いします！",
      "source_fingerprint": "e2f6147bb4e79946d933c59b7f4054fdb58b49fbca5d13f23f35a365689bfb45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "567"
      ]
    },
    {
      "uid": "zhcn:98093d91afc7c4a25086c821",
      "kind": "text_data",
      "source_text": "お食事にもこだわっていると伺いましたが？",
      "source_fingerprint": "59e988bd8dd21f21c866c9f851160a019d27c599d6c5e04f5666359de61fe863",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "568"
      ]
    },
    {
      "uid": "zhcn:b8bf3aab2097e1bf327bed47",
      "kind": "text_data",
      "source_text": "次のレースへの意気込みをどうぞ！",
      "source_fingerprint": "95e5dfe2a65c11074b2b5afc41f09a2a9c3e7343a57a3251231f99ddcf5208da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "569"
      ]
    },
    {
      "uid": "zhcn:5189cb3d41643cba6d57bc82",
      "kind": "text_data",
      "source_text": "请对粉丝说句话吧！",
      "source_fingerprint": "3f6e067fd1c9994186a537c296758fa2f5f12fa564ba78a1f6151532c2ff4d87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "57"
      ]
    },
    {
      "uid": "zhcn:baf73a5987dd79b1ad721300",
      "kind": "text_data",
      "source_text": "果然还是得用「KP」来庆祝胜利吧？",
      "source_fingerprint": "4a65b71b3fdcfabd238f02b3eb16daf77f4bf8b115480465b73317b99e4a3740",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "570"
      ]
    },
    {
      "uid": "zhcn:c0f64ddb4a9ea799742b5f00",
      "kind": "text_data",
      "source_text": "我就开门见山地问了。你这次获胜的原因是？",
      "source_fingerprint": "6e84102aeb6900864a07e29717c41c6131dc7fd99e670c8689f1ef8615a7dfe3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "571"
      ]
    },
    {
      "uid": "zhcn:6f6af27e23cb382d815cf240",
      "kind": "text_data",
      "source_text": "有想要和谁分享这次的胜利吗？",
      "source_fingerprint": "ee1ee145612a0d327e79ec086f70da837cafad83ac27eab3ab6eec0b606e8b5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "572"
      ]
    },
    {
      "uid": "zhcn:884291d6daac19a27d04c3be",
      "kind": "text_data",
      "source_text": "麻烦请对粉丝们说句话！",
      "source_fingerprint": "d2a2521fda0060b91cb348ee1e4f8f461af10cf4db5a765907ecbec06849c85f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "573"
      ]
    },
    {
      "uid": "zhcn:97e2618eeb24878a0666e95d",
      "kind": "text_data",
      "source_text": "顺利通过预赛！身边的人应该都很开心吧？",
      "source_fingerprint": "827411865fe261ed68a3af6d5816c37e4ed0164f292e1144188abfd408b9a06d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "574"
      ]
    },
    {
      "uid": "zhcn:7d30780a32ebad6f11165720",
      "kind": "text_data",
      "source_text": "为了决赛，请问你会做什么样的准备呢？",
      "source_fingerprint": "aa01857402cc0ca5ec49f439ff5315d55258eb54d632948be9e0c0456353e48f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "575"
      ]
    },
    {
      "uid": "zhcn:9c79b73ea67ec2cda9cab2d6",
      "kind": "text_data",
      "source_text": "有吃致胜料理吗？",
      "source_fingerprint": "20cf6cc637548e0b8cf551b62545eb7b5ba2f12c2844a44e75aef72f7a0e2aad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "576"
      ]
    },
    {
      "uid": "zhcn:e167614b9812593c86a9e7c6",
      "kind": "text_data",
      "source_text": "在有比赛的日子会做些什么特别的事吗？",
      "source_fingerprint": "3b3e5dc1e095380a52bbcec11fe7feced5e5ae9e7a91ee88f4941a27cbc74025",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "577"
      ]
    },
    {
      "uid": "zhcn:a770bc84e324c8160c26a05d",
      "kind": "text_data",
      "source_text": "顺利进入决赛了呢！身边的人应该都很开心吧？",
      "source_fingerprint": "9c7852df0e2b9c7a9d89230d7e900a414a3df9df105c5e4330ffbb351b99bc19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "578"
      ]
    },
    {
      "uid": "zhcn:d913df71b6d78200a554017c",
      "kind": "text_data",
      "source_text": "请向竞赛对手发表一些感想。",
      "source_fingerprint": "7b2ca90e0f7c4bad8abad229c7399817c98239adb0949124f352333ed17176f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "579"
      ]
    },
    {
      "uid": "zhcn:3388d55f5e2bb9d40c176919",
      "kind": "text_data",
      "source_text": "会用什么当成「给自己的奖励」来庆祝获胜？",
      "source_fingerprint": "5f9ff7123d9a1e5702e5ae2d649e2f5a807f556edc7889de56d13808033b33ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "58"
      ]
    },
    {
      "uid": "zhcn:ac485f0943861920ec3d0c1a",
      "kind": "text_data",
      "source_text": "决赛时会对上更难应付的强者赛马娘吧……",
      "source_fingerprint": "36b71aa30bf6e25e2b4d067f97d20ef0fa696672432649dd36af5bee647c49d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "580"
      ]
    },
    {
      "uid": "zhcn:0fe539a93c19d5df158a188e",
      "kind": "text_data",
      "source_text": "身为「辉煌逸才」的你正备受瞩目呢！",
      "source_fingerprint": "b5a4bc2064acd1cbe499b57f6603474c9bb367267570d0641410bfc038cd33cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "581"
      ]
    },
    {
      "uid": "zhcn:dda31e7871cc5b36001a0265",
      "kind": "text_data",
      "source_text": "听说你的写作功力在课堂上被夸奖了。",
      "source_fingerprint": "f02e4e18ea4734f34d9b7d719668ac46c209bea7f52c9e2768c7af0b942f1436",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "582"
      ]
    },
    {
      "uid": "zhcn:444c9a215df530f2f7ec4ab8",
      "kind": "text_data",
      "source_text": "最近引起你注意的赛马娘是？",
      "source_fingerprint": "4f437e38f2486140cf537a453cb6c41faf07f2df8d093879f3a71badeae1a274",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "583"
      ]
    },
    {
      "uid": "zhcn:71e55bcc3124d73b87f5f003",
      "kind": "text_data",
      "source_text": "竞赛开始前会紧张吗？",
      "source_fingerprint": "e50565654cc4a1be28f0f43c9e3d1db0e5a46787cd97002bdb603824ba6284e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "584"
      ]
    },
    {
      "uid": "zhcn:e2921ebb6a2e0dc3597f5f40",
      "kind": "text_data",
      "source_text": "很精彩的表现！",
      "source_fingerprint": "ee6b959a9629f3fe045615523dfffcfe79a9e1848e1e4ef33c00288ff9dc6c60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "585"
      ]
    },
    {
      "uid": "zhcn:3a4eb070de836c17d4b7229c",
      "kind": "text_data",
      "source_text": "刚才好像看到你在笔记本上写了什么……？",
      "source_fingerprint": "a74aa498367c5e045572edbc5e2da26810a31ad3e5ede20b61b19ea31d204621",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "586"
      ]
    },
    {
      "uid": "zhcn:e09c1da1389704bfb2c87f40",
      "kind": "text_data",
      "source_text": "有无论如何都想在决赛中一战的赛马娘吗？",
      "source_fingerprint": "8c8c1079c8c0c7383df7621a618edbe3bc582689792fdc93483fd7288fc65bb3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "587"
      ]
    },
    {
      "uid": "zhcn:489e08502ca4f8f40d5e4847",
      "kind": "text_data",
      "source_text": "请告诉大家让你维持坚强实力的饮食是什么。",
      "source_fingerprint": "67054bf358b9d3cb5a1cfffe8a68d52cfed9a64dac3f832684e447ff3b4d88bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "588"
      ]
    },
    {
      "uid": "zhcn:110cbfea50d744dddf755766",
      "kind": "text_data",
      "source_text": "据说，你好像有在养狗？",
      "source_fingerprint": "46f44d166fc62fdad7a8103afb9730399b72efdf8fa8ae47ece7be525b75948e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "589"
      ]
    },
    {
      "uid": "zhcn:444789a29ed1e895887c768d",
      "kind": "text_data",
      "source_text": "今天能获胜的原因是？",
      "source_fingerprint": "1ba992e7dd1f87282f3a99f2b396170aa4b5b84b0da8a922bcc654547c5738e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "59"
      ]
    },
    {
      "uid": "zhcn:30d76fe36a4c7c00977b4642",
      "kind": "text_data",
      "source_text": "决赛该关注哪个部分？",
      "source_fingerprint": "c0eb1042c76c0e83870cc6d0e6a95ab4a043cb9bc82063118d0c2ca8e473dfe8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "590"
      ]
    },
    {
      "uid": "zhcn:2d65aa620ec4b6a5cb8dd5b4",
      "kind": "text_data",
      "source_text": "请对粉丝发表一句感言！",
      "source_fingerprint": "7c5af0f64085ff6426a046679705388129f151c4ca7bad839a95ba1f0a10f1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "591"
      ]
    },
    {
      "uid": "zhcn:5991670dce9c8ecd688e391f",
      "kind": "text_data",
      "source_text": "今天的竞赛跑起来感觉如何？",
      "source_fingerprint": "dcb831c7d2173e9f1415f269506db84a459b5517da313301dd1ab5fba6883eba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "592"
      ]
    },
    {
      "uid": "zhcn:25c991cea29976bb8a1035cf",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "593"
      ]
    },
    {
      "uid": "zhcn:69f6fa8f9134073b771d13cb",
      "kind": "text_data",
      "source_text": "请对如同竞赛师父般的训练员说句话！",
      "source_fingerprint": "1784f5d02fcb63863e930927059a29c82196082fd6b3c2c55a4dbb08b41a1e93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "594"
      ]
    },
    {
      "uid": "zhcn:98117353e5a9eb30f32371be",
      "kind": "text_data",
      "source_text": "请对位于故乡道场的众人发表感言！",
      "source_fingerprint": "f4e0fa6ff124258607abd0468c840fcbfeb934723d6af427cbd326cb3369544b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "595"
      ]
    }
  ]
}
