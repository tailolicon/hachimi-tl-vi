    },
    {
      "uid": "zhcn:f8558d11391f996f51946b24",
      "kind": "text_data",
      "source_text": "谢谢你，一直相信我。\n终于……我站上了舞台的正中央了哦！",
      "source_fingerprint": "2639febc02be32decd3e0e4fb35b64e8033aa63ad834f950bc4242a9470e4d5b",
