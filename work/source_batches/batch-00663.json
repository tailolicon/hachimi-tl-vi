      "json_pointer": "/232/554"
    },
    {
      "uid": "zhcn:8b6676dfb862559f5b795260",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "老实说，的确会感到紧张……不过\\n能跟那样的对手们同台奔驰让我感到很荣幸。",
      "source_fingerprint": "4fb04859abff7cbc8ae5ba49fc2e02cb50617345b3d62738d5010cd7aaf98354",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
