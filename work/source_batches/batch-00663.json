      ]
    },
    {
      "uid": "zhcn:a64f4a540c393f84f40b3c38",
      "kind": "text_data",
      "source_text": "当然是很开心……但如果就此满足的话，\\n会被昨天的自己耻笑的！！",
      "source_fingerprint": "3d6e5cc4ad557cc276a239de4d36487424204fedfd6fa30565046d08a310a4ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "15"
      ]
    },
    {
