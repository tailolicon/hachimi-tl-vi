      "uid": "zhcn:41bd4e64dbac1f1b5e97ca70",
      "kind": "text_data",
      "source_text": "家人！　每次，赛事结束后\n我们全家都会进行视频通话哦！",
      "source_fingerprint": "d6499d5905cc9747d859ec93c6e169f6f6d77c05fc850a07b6a3fdfac9478f06",
      "source_path": "text_data_dict.json",
