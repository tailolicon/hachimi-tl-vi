    {
      "uid": "zhcn:15e8cbc4c7157f4e39cf670c",
      "kind": "text_data",
      "source_text": "如果说是像我的风格……确实如此。\n展现真实自我的奔跑，感觉格外舒畅呢。",
      "source_fingerprint": "e9cb56f81b8ab731be889ef8fcd2c92631378e8221633d91d4411d9fe2962c08",
