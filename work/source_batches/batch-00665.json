        "49"
      ]
    },
    {
      "uid": "zhcn:77c17f3e59a4089fc02129be",
      "kind": "text_data",
      "source_text": "到决赛为止的行程表已经订出来了吗？",
      "source_fingerprint": "e4756a93783c1d770b38b0100227c5cae6a81db3ea6e7f87f608bc683c967a0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "490"
      ]
    },
    {
      "uid": "zhcn:d50920a1354b1efcd45fdde6",
      "kind": "text_data",
      "source_text": "下场竞赛会以什么样的作战去对抗呢？",
      "source_fingerprint": "4e99e098eebb899d290b33c5f05bf9c0da07a07ab9d8d24aa8e4c39abbca8173",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "491"
      ]
    },
    {
      "uid": "zhcn:9d59de9144ea2687c0e32817",
      "kind": "text_data",
      "source_text": "我看了你今早上传到UG的照片喔！",
      "source_fingerprint": "b889424937c6e817e3a07b84aa2561e44994f4824e4c3b273d1685b5d725aaed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "492"
      ]
    },
    {
      "uid": "zhcn:3e25335f709450440ae9535c",
      "kind": "text_data",
      "source_text": "下场竞赛会用什么样的作战去跑呢？",
      "source_fingerprint": "6b7471e98999899ea945d98d500a9eafca68acf8c4070b2ef68c5c2166b6b447",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "493"
      ]
    },
    {
      "uid": "zhcn:d3fc0f500e3bdfd208951cee",
      "kind": "text_data",
      "source_text": "可、可爱的真机伶！",
      "source_fingerprint": "dc8c53d47b33e6727f05bc4a8ddb4cfe83e6c2eaa736b323c7ce0c932d8188f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "494"
      ]
    },
    {
      "uid": "zhcn:3c865a505537a0abbc354df4",
      "kind": "text_data",
      "source_text": "对手真是强敌云集呢！",
      "source_fingerprint": "6243237a40b1caa48b0053d9e671c5c0978a0e74b94f9c30c68030ae938440d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "495"
      ]
    },
    {
      "uid": "zhcn:f2bc9302d6bac29e2db4b0b9",
      "kind": "text_data",
      "source_text": "真是充满气势的表现呢！",
      "source_fingerprint": "c0d510de8e7c48de469865d4bce91e7b8b5337651fd4d76403021b91493e9c64",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "496"
      ]
    },
    {
      "uid": "zhcn:02685c5fddfe06efe9fd74a5",
      "kind": "text_data",
      "source_text": "请对王子说句话。",
      "source_fingerprint": "9df9e6ffeda40532aeffbe25249e8d904ee7ea98570f398a756ba0cef3ffdb1e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "497"
      ]
    },
    {
      "uid": "zhcn:51f12fadac423c2201d5bd1d",
      "kind": "text_data",
      "source_text": "决赛时应该会对上更难应付的强敌……",
      "source_fingerprint": "95e1a0d58a2ed059e3f34af01a57e8a69520705c86a47b268f23ee4cb2fd2e4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "498"
      ]
    },
    {
      "uid": "zhcn:df7dcb1b1ce5763abb822453",
      "kind": "text_data",
      "source_text": "请说说你对下场比赛的抱负。",
      "source_fingerprint": "e0a355a96d14e009e3c82891b4bf0383e4f8378e0addc2af78fda5085e8f4c9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "499"
      ]
    },
    {
      "uid": "zhcn:db1aa24b40f74cde52e39547",
      "kind": "text_data",
      "source_text": "竞赛对手有资格被帝王大人看上吗？",
      "source_fingerprint": "a7d676cfb24e1c399018906672620ea03acdbae5ee8b60092d1a9d928753a2a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "5"
      ]
    },
    {
      "uid": "zhcn:0309e4cd5a070045f0b5ae74",
      "kind": "text_data",
      "source_text": "昨天晚上睡得好吗？",
      "source_fingerprint": "d50ae1ecfba2290d0be01eb837cbe992e3aa1a2d6e0af648f25712f7936be140",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "50"
      ]
    },
    {
      "uid": "zhcn:4e5262279717a839e92aae50",
      "kind": "text_data",
      "source_text": "最近有什么改变吗？",
      "source_fingerprint": "96d282726dbc53c5fe688da71e2a5ff9955687631415b39674eebe2231c1844d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "500"
      ]
    },
    {
      "uid": "zhcn:4ed787bbe44035d787cfc67a",
      "kind": "text_data",
      "source_text": "胜利俱乐部的表现实在亮眼呢！",
      "source_fingerprint": "a66ff7836015554a32a7323995b09599e57d50ed514ef286a8bb6c05d688b940",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "501"
      ]
    },
    {
      "uid": "zhcn:5f67e4dc9994ca9bfaa21978",
      "kind": "text_data",
      "source_text": "听说你最近对双马尾有兴趣？",
      "source_fingerprint": "931d663d7c652e9f543cfe9dadbf74572d30269d374deecfa5fdb16fbc8934ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "502"
      ]
    },
    {
      "uid": "zhcn:4814a47830094a5e1b25c9c8",
      "kind": "text_data",
      "source_text": "请针对决赛说出你的抱负！",
      "source_fingerprint": "43bff237de14d9000edd40b7ce6a36f0a17fbc04c034cea0995ebb758ac89617",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "503"
      ]
    },
    {
      "uid": "zhcn:87d7c79af28a5079263423a1",
      "kind": "text_data",
      "source_text": "简单说今天的获胜原因是？",
      "source_fingerprint": "e045ec56a244c94a8964695493f7506ce36d02d60d14ee0668ab5ff3f14f1a3f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "504"
      ]
    },
    {
      "uid": "zhcn:8d689f7b7f210051d83c53d5",
      "kind": "text_data",
      "source_text": "会吃大餐来庆祝获胜吗？",
      "source_fingerprint": "150e124f0d161970cb638f25128a6376ae083dbf6f204715cea680d70d40063b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "505"
      ]
    },
    {
      "uid": "zhcn:0d311a48fafe925caaeab1fc",
      "kind": "text_data",
      "source_text": "请在决赛前对粉丝说句话！",
      "source_fingerprint": "327b8228174af6dc8f6b34d8ac25cf58099c7c7a464e8dab7ed74336d4a1a847",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "506"
      ]
    },
    {
      "uid": "zhcn:59afff6c621845844608393a",
      "kind": "text_data",
      "source_text": "针对决赛有准备什么对策吗？",
      "source_fingerprint": "96769d92b5e7976ad53050b3ad84f68fedb42b5df8eac4590511068f9c7dd7a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "507"
      ]
    },
    {
      "uid": "zhcn:ca53c3194b0dcf811628161d",
      "kind": "text_data",
      "source_text": "经历过最辛苦的训练是？",
      "source_fingerprint": "2d14e74c2d2cefc93ad09d2713ec28ccc66732ccb53c360e2e4422737c8f5d87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "508"
      ]
    },
    {
      "uid": "zhcn:9d8c0063c02afcd38ecee86d",
      "kind": "text_data",
      "source_text": "面对众所瞩目的决赛，现在的心情是？",
      "source_fingerprint": "0244bc8403dd00dff9486b4f25a3f030939f78adff10a562d58d3aa3a18f6380",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "509"
      ]
    },
    {
      "uid": "zhcn:bc5163eef8e20854cb8537e5",
      "kind": "text_data",
      "source_text": "请说说你对于下场比赛的抱负！",
      "source_fingerprint": "0fede3e3f600c7943b09f52e254b414d137badde58a6fbc81f60a2449102055a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "51"
      ]
    },
    {
      "uid": "zhcn:3123a5f3a7f4f34db7de0f43",
      "kind": "text_data",
      "source_text": "与训练员进行特训的成果出来了呢！",
      "source_fingerprint": "0d23c2e3b9483268e257b819f7246a8a2a8fb07ff434f9e37f8327ec808dd08b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "510"
      ]
    },
    {
      "uid": "zhcn:c4107fee90ba64ec46300eea",
      "kind": "text_data",
      "source_text": "你是怎么面对获胜时收到的盛大欢呼呢？",
      "source_fingerprint": "e1bce0df8a0c6273c5cdeadad35ece9d091dde69b0b9890725fe84c1ead126c4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "511"
      ]
    },
    {
      "uid": "zhcn:2e4d45fcedf243dfae4b026a",
      "kind": "text_data",
      "source_text": "决赛时会采取哪种作战呢？",
      "source_fingerprint": "e425898b03152e180204dc565e8b806acb9742245a03f442dfc57245afb091d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "512"
      ]
    },
    {
      "uid": "zhcn:c168df8adad845a153f956ce",
      "kind": "text_data",
      "source_text": "请对粉丝说句话！",
      "source_fingerprint": "e4120d78fbf1092e6b2fafd181fece9e0af0ec5b78238248d9a4228d438d3c77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "513"
      ]
    },
    {
      "uid": "zhcn:f004bbf09a12a164ff778e59",
      "kind": "text_data",
      "source_text": "决赛时会对上更难应付的强敌吧……？",
      "source_fingerprint": "c5f29df2c0c89c8a70d9960c85a854e18ea32f7963cc655b12aa476005d10bcd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "514"
      ]
    },
    {
      "uid": "zhcn:18ddf04995e1392004f068fe",
      "kind": "text_data",
      "source_text": "预计要用什么当成「给自己的奖励」？",
      "source_fingerprint": "7f40f6f635f5ed8e74fbf8d0ed5ed1bebf64ec203b6198cbe1717e56ad0b01ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "515"
      ]
    },
    {
      "uid": "zhcn:6790da619596b40f96a048f4",
      "kind": "text_data",
      "source_text": "即使是决赛，胜者舞台的C位也……？",
      "source_fingerprint": "eb95b7953473e330d93fab6acb83405e664e3e6954b559ec84d4bb2b69cb7aa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "516"
      ]
    },
    {
      "uid": "zhcn:df3b90689c50aab0806627cd",
      "kind": "text_data",
      "source_text": "决赛时会对上更难应付的强敌赛马娘吧……？",
      "source_fingerprint": "c0bf280125361ce925708ce4a0a503eb735c6033d29e8bac1d868a8a0c7d9a39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "517"
      ]
    },
    {
      "uid": "zhcn:ad4095c8bd56d5927ad63f91",
      "kind": "text_data",
      "source_text": "宛如游隼般的极速表现实在太帅了！",
      "source_fingerprint": "1d73e84245dd01b553b451cc3a269e27bb654b42e57e842b89bc55b9502183b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "518"
      ]
    },
    {
      "uid": "zhcn:6b3daf39a8352e680253b70a",
      "kind": "text_data",
      "source_text": "之后就是决赛！感觉能如自己所想地进行吗？",
      "source_fingerprint": "11c35fb88408c92a6d58941903912244d9d74d45650fe32441a6f7a8f0216b25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "519"
      ]
    },
    {
      "uid": "zhcn:2945cdf5b32a807896c94893",
      "kind": "text_data",
      "source_text": "这次能获胜的原因是？",
      "source_fingerprint": "b1c4488c0e99984b8405de68f414d74673cdccdf94daabbf8761651d68764bb7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "52"
      ]
    },
    {
      "uid": "zhcn:fe07b7abbf5df776a612095f",
      "kind": "text_data",
      "source_text": "有没有关键时刻必吃的致胜料理呢？",
      "source_fingerprint": "9c9d3145d7b2522e86dee7b6213190fce8888b9500d18cf55ac3de2abc525d00",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "520"
      ]
    },
    {
      "uid": "zhcn:d2aa0579b39dc2516b6ce853",
      "kind": "text_data",
      "source_text": "你表现得相当从容，不紧张吗？",
      "source_fingerprint": "e3f1a84886b58d0c658adfa8ebf00f5196059a5bf04ab47b42bef31d01bedd74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "521"
      ]
    },
    {
      "uid": "zhcn:6ab6950a96dd0d8c7cc4c2ac",
      "kind": "text_data",
      "source_text": "你觉得下一场竞赛会获胜吗！？",
      "source_fingerprint": "0f6c745f934d5338ee6757785852a02540842fa11d3ad378af53109da87e48a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "522"
      ]
    },
    {
      "uid": "zhcn:af23d2135d2e07b852bdbd47",
      "kind": "text_data",
      "source_text": "会想将这次的胜利传达给谁呢？",
      "source_fingerprint": "9a3aacf7bd22d81aedb86e65ffa6085109bbf8dbd7b49e803fc91b716666e2f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "523"
      ]
    },
    {
      "uid": "zhcn:7d35d114ce6a678aa1e8b8d6",
      "kind": "text_data",
      "source_text": "已经决定好祈求好运的美甲款式了吗？",
      "source_fingerprint": "93b013a1a1181b71a9f46b8843c74f2572b2076d52c7b4d4503582077fd9d02c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "524"
      ]
    },
    {
      "uid": "zhcn:5b6992f6dba1ecfdc09fc2a3",
      "kind": "text_data",
      "source_text": "胜利的祕诀莫非是你嘴里的糖果……？",
      "source_fingerprint": "da5d7c816a50dbd5ea4dfc139d3cccd9c136c644b3c33736c8532b0a6f6000fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "525"
      ]
    },
    {
      "uid": "zhcn:f89f8eaa0a62d0956bc3bd6b",
      "kind": "text_data",
      "source_text": "直白地说，获胜的原因是什么呢？",
      "source_fingerprint": "4806defc7425eeebf1eabb7fd994210a67c482a09903e8deff93623747a92ff3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "526"
      ]
    },
    {
      "uid": "zhcn:c2857ae1f9930b4e55a42f48",
      "kind": "text_data",
      "source_text": "请对粉丝说句话。",
      "source_fingerprint": "5158e5968d3925472a69db66731a6b7d470a51af6c432a70560917953d76b24c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "527"
      ]
    },
    {
      "uid": "zhcn:84f8aaceec0b2c203a577751",
      "kind": "text_data",
      "source_text": "可以预见决赛时会聚集更多强敌赛马娘……",
      "source_fingerprint": "3217d2821f73b820a3af5a5a8d3770066b708a7d2c4a1824089bf108d25e261f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "528"
      ]
    },
    {
      "uid": "zhcn:b2ba6e032c3970a196947955",
      "kind": "text_data",
      "source_text": "有令你在意到想在决赛一起奔驰的选手吗？",
      "source_fingerprint": "b47ca6985bb52e28b3991c73d86a709a0aebd38ffba24a770630275dd1c7b299",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "529"
      ]
    },
    {
      "uid": "zhcn:bc135fc4179f2ed9d63a203b",
      "kind": "text_data",
      "source_text": "最后直线时的强劲脚力令人印象深刻呢！",
      "source_fingerprint": "fcc37bbeec2b5660afe8b028d49d9a3fdc67a3745d2580db8521d3d86502b4f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "53"
      ]
    },
    {
      "uid": "zhcn:5ed54e781d8645dcc5bcc6b0",
      "kind": "text_data",
      "source_text": "利落的表现简直就像变魔术一样！",
      "source_fingerprint": "2d7278ef9eea7bc851c9dd37e6505c7f487e67699f5be984bc582134a3ca3bef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "530"
      ]
    },
    {
      "uid": "zhcn:cde37974f80e6442355139af",
      "kind": "text_data",
      "source_text": "刚才在粉丝面前摆出的可爱动作是？",
      "source_fingerprint": "89be043b9143e7457746ffea54a025a5ebb378a2717cef40592618d4ec05faa4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "531"
      ]
    },
    {
      "uid": "zhcn:59c914b83865d741f53198fa",
      "kind": "text_data",
      "source_text": "你一路走来给人的印象都很沉稳对吧？",
      "source_fingerprint": "6ca539b6213ed65572a2c78e7c8e9fade1bb1d7065ee3cd0226f8351b90f4cbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "532"
      ]
    },
    {
      "uid": "zhcn:ba40460df5e992f42876cf83",
      "kind": "text_data",
      "source_text": "请针对决赛说说你的抱负！",
      "source_fingerprint": "16f9fcb1324a705a0dca15b0434206f448fddaf820e5172eee7b85e4b9b6b1ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "533"
      ]
    },
    {
      "uid": "zhcn:c00d10a6bf7b3bc8a221cd37",
      "kind": "text_data",
      "source_text": "那个护身符是朋友送的吗？",
      "source_fingerprint": "5d8c087f9f3d6ec7153f92dd11b65e690576929ab56650984745c0b70e91e996",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "534"
      ]
    },
    {
      "uid": "zhcn:815ced945a9ee0c7fa08b7b4",
      "kind": "text_data",
      "source_text": "你能一直保持充沛活力的秘诀是？",
      "source_fingerprint": "52c5ea14c02df6373eb59ef590083d679c86f453295e1b564c8d24396a979721",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "535"
      ]
    },
    {
      "uid": "zhcn:a9ff0734d9783e4aa4c0bd63",
      "kind": "text_data",
      "source_text": "你的表现被评论为「能让人获得勇气」喔！",
      "source_fingerprint": "bc1cf49313e76de5fe770e7102a010ff2f14cc651db0bcd3360f3a45414a7767",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "536"
      ]
    },
    {
      "uid": "zhcn:1511667c6408c615588a7659",
      "kind": "text_data",
      "source_text": "面对粉丝有什么想传达的消息吗？",
      "source_fingerprint": "776b960cc4021fbf10e010eea0314ac4f0030b415e61c0abaa868e46d1883815",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "537"
      ]
    },
    {
      "uid": "zhcn:cddcf998b0cbddc0bf5d2216",
      "kind": "text_data",
      "source_text": "请告诉我们让你感到松一口气的瞬间是何时？",
      "source_fingerprint": "a8f2b1c245da02bd001d34b079e6c5d3ac523fdf3f1cd4d196c646a78359e93b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "538"
      ]
    },
    {
      "uid": "zhcn:3f6a0d4b7e447e464bbfb8b8",
      "kind": "text_data",
      "source_text": "请告诉我们在竞赛前必做的流程！",
      "source_fingerprint": "9cfb48ea8fde81b42f084bf27887484a0802de6e66e61b0c3eae174e44571cdb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "539"
      ]
    },
    {
      "uid": "zhcn:1ca04309bfc6e9acfd843316",
      "kind": "text_data",
      "source_text": "会想给自己什么样的奖励？",
      "source_fingerprint": "fccda8ab44188d79bb2659eeb9a01a36be30dd51ef0ba4ec342ddbbc25a5ad19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "54"
      ]
    },
    {
      "uid": "zhcn:6be28717389d62e1fcbfdda1",
      "kind": "text_data",
      "source_text": "日頃心掛けていることは？",
      "source_fingerprint": "7e0202af73cb60b0733dbe94590ad3c9c44db26fee93342daef3f8a0953def8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "540"
      ]
    },
    {
      "uid": "zhcn:9acad4911ce46f350cca6d5c",
      "kind": "text_data",
      "source_text": "レース後のウマトック投稿、すごい反響でしたね！",
      "source_fingerprint": "e7b2166f0b3121c42188dc0e023e1468421493997db8524f2484d2e7b085cea1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "541"
      ]
    },
    {
      "uid": "zhcn:366f43836181128223580301",
      "kind": "text_data",
      "source_text": "勝負メシはなんですか？",
      "source_fingerprint": "e0e9fe3bf80ea4c38312a56e0c1153737b6f9befcfe7fb156018f9d31e412958",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "542"
      ]
    },
    {
      "uid": "zhcn:23db4312289d38f9bc518559",
      "kind": "text_data",
      "source_text": "竞赛时特别注重什么地方呢？",
      "source_fingerprint": "17049ea9c281943667741ca2198a84af023a580e9b6c96caf5b7f4cb887081e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "543"
      ]
    },
    {
      "uid": "zhcn:f0fbd71775e7a3098cfb73bb",
      "kind": "text_data",
      "source_text": "最后冲刺时飞舞的缎带令人印象深刻！",
      "source_fingerprint": "c312235862222cddd8ae18eafded8c97a4591061730309cb891b14287191166c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "544"
      ]
    },
    {
      "uid": "zhcn:71bd76e408ed499514cec5b4",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝说句话！",
      "source_fingerprint": "3c1bdbac337ada9059558abb476fe264c30b0d25dbf409ce8b66e4524a4e3f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "545"
      ]
    },
    {
      "uid": "zhcn:fede2efe78f8b3d54b235fad",
      "kind": "text_data",
      "source_text": "请对支持你的粉丝发表一句感言！",
      "source_fingerprint": "3b0e691d9d91c19c6082542a0a1c94e0a3915e2db2bceb4c2fc701ec5a460658",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "546"
      ]
    },
    {
      "uid": "zhcn:b5810b5140e9f92bc8465dfd",
      "kind": "text_data",
      "source_text": "签约训练员是否也发挥了庞大的助力呢？",
      "source_fingerprint": "f0fb0fba5f86ee2a6ede22173f48e5635a9c5077a64d9a58884f4101b90a4d61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "547"
      ]
    },
    {
      "uid": "zhcn:a0625f34f054d1eaff76f5d9",
      "kind": "text_data",
      "source_text": "请针对下场比赛说出你的抱负！",
      "source_fingerprint": "2b90b7dfd011593ab25e80e411c31c2c72407eb7cb28a5d180632dc70dcd1506",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "548"
      ]
    },
    {
      "uid": "zhcn:4fcbe27b1913f9fe8efa988d",
      "kind": "text_data",
      "source_text": "这份喜悦想要传达给谁呢？",
      "source_fingerprint": "ba95759be7d5eb21d39ba1e7be3acd96a947c48b22d54aa3fd9c4474ba098acc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "549"
      ]
    },
    {
      "uid": "zhcn:3290a2c4d6a9e7a29f0c9601",
      "kind": "text_data",
      "source_text": "今天能获胜的原因是什么呢？",
      "source_fingerprint": "f94a17fb3a38e1a899b0c84e917d9cea3359f6df9dfc50c0294c890970ac11c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "55"
      ]
    },
    {
      "uid": "zhcn:893782898eed0ba22b78472c",
      "kind": "text_data",
      "source_text": "有想吃什么来庆祝胜利吗？",
      "source_fingerprint": "9962fbb6d266f3cd2a310be09f0b71c08436a4e9570d15c5d83dfe7a7ee2e46c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "550"
      ]
    },
    {
      "uid": "zhcn:a86c178e97496e153b7f35e5",
      "kind": "text_data",
      "source_text": "在比赛结束后有安排什么娱乐吗？",
      "source_fingerprint": "afc37c73267afe38167a3fedc3dc06592c89723afc1a906e4fa4c78313f8281f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "551"
      ]
    },
    {
      "uid": "zhcn:30a08eee2d4882a990c7be98",
      "kind": "text_data",
      "source_text": "是做了什么讨吉利的事而赢得了比赛呢？",
      "source_fingerprint": "953d3417ce5fcb870689dd6989d47331077070db4277ced8c03ad1c7db11ac2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "552"
      ]
    },
    {
      "uid": "zhcn:86b84af93cae81860ea2cf18",
      "kind": "text_data",
      "source_text": "领先抵达终点的瞬间，你在想着什么呢？",
      "source_fingerprint": "bb3168a68d659cda8d63c858fd0217e0eed3fa40237bf36b0c03b1234ec89530",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "553"
      ]
    },
    {
      "uid": "zhcn:62d3fafa09fba99a61b121bb",
      "kind": "text_data",
      "source_text": "请说说你对下场比赛的抱负。",
      "source_fingerprint": "e0a355a96d14e009e3c82891b4bf0383e4f8378e0addc2af78fda5085e8f4c9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "554"
      ]
    },
    {
      "uid": "zhcn:803faa0a76ced2bbed0b2137",
      "kind": "text_data",
      "source_text": "可预见决赛时会聚集更多强者赛马娘喔？",
      "source_fingerprint": "f77b190cbfc2ceeb83936689e14beb00bb2c4d257031134d65d50c416af8d96a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "555"
      ]
    },
    {
      "uid": "zhcn:185fa942a61c9dbba1d7a3ff",
      "kind": "text_data",
      "source_text": "有意见表示期待决赛是「目白家对决」喔？",
      "source_fingerprint": "efc708433b31b5acd56f0fb98b904897ddd3240e1194ff5cb2af3be0f18b9dec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "556"
      ]
    },
    {
      "uid": "zhcn:b64be7647156a2a723657199",
      "kind": "text_data",
      "source_text": "多伯总是给人很冷静的感觉呢……",
      "source_fingerprint": "69174a6b663a21199636e11c1ce189de4cf4e6a82a8de8910c38dc5f54f5c145",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "557"
      ]
    },
    {
      "uid": "zhcn:e5e482e34fea7d48cedaf6e5",
      "kind": "text_data",
      "source_text": "请说说你对决赛的抱负！",
      "source_fingerprint": "9d821453d4f1dae85b0dff7a37264b0b651ac12ba73a6603a006410efbb4437b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "558"
      ]
    },
    {
      "uid": "zhcn:f49b7391f40d00dbfb2b6293",
      "kind": "text_data",
      "source_text": "应该会就这样朝着优胜直直奔去对吧！？",
      "source_fingerprint": "ac87967a37b750396c7f512bc8914344ef4dd02dfed17c9fefcd2dcaff95295e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "559"
      ]
    },
    {
      "uid": "zhcn:7077c16ec0ee28ca642f194b",
      "kind": "text_data",
      "source_text": "请问你都吃些什么「致胜料理」呢？",
      "source_fingerprint": "1bb951e051ec6eb3af795068f4ff7a03d8f7449a6dde39d2394309baa5ae22ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "56"
      ]
    }
  ]
}
