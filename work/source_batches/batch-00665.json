      "uid": "zhcn:81c8df198c73d8a7eb7c0307",
      "kind": "text_data",
      "source_text": "是能充分感受到气魄的表现呢……！",
      "source_fingerprint": "00e5ca39dd471dc0116c7a62f79c360c753730ae161999b0a91e4d5ec6e4b89f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "231",
        "781"
      ]
    },
