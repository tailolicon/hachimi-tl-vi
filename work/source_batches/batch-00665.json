    {
      "uid": "zhcn:646b003415fe8f623fa04be6",
      "kind": "text_data",
      "source_text": "真是让人看得身心舒畅的好表现呢！",
      "source_fingerprint": "4b12f0f449834cdb7a171dbbc6c02316c684ce6ed71afac20611874a8333fa08",
      "source_path": "text_data_dict.json",
