    {
      "uid": "zhcn:31654041eb7f37ab8ee9ebcf",
      "kind": "text_data",
      "source_text": "称不上是──Easy travel。\\n但果然是场强敌环伺的──好比赛──",
      "source_fingerprint": "1500019bf73878a8094aa8ce9bef6ad513034bbc7c41bff6b52d5e7003f6b0a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
