        "1439"
      ]
    },
    {
      "uid": "zhcn:26af55ec8499b3480fa8a4fc",
      "kind": "text_data",
      "source_text": "唔！？是、是的……曾经用飞踢把\\n刚贴上和纸的拉门给……踢破了一个洞。",
      "source_fingerprint": "0a6893cdd98f89fe07fb2203285fc77aef86f4895c64f54c8003c87591e6bf20",
      "source_path": "text_data_dict.json",
