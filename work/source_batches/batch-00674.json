    {
      "uid": "zhcn:dbb02b3acbc517a238fa78bf",
      "kind": "text_data",
      "source_text": "这个词用在我身上，还名不副实。\n……要称得上是『职人』，还差得远。",
      "source_fingerprint": "806256b3e14452707a3aa88a82bfb440e378d3e7c29e594ef663a92dbda1f4e2",
