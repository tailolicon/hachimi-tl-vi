      ]
    },
    {
      "uid": "zhcn:feed8fd420ad1cce18e2453b",
      "kind": "text_data",
      "source_text": "我会赢的……。我相信，那是能献给那位大人的\n最美丽的事物……。",
      "source_fingerprint": "6250a8cb7777f569de62168f46a61551a390b2a7889e99d9daa5d07f1ad91c7c",
      "source_path": "text_data_dict.json",
