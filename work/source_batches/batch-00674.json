    },
    {
      "uid": "zhcn:a7157934f7916d0802a99b52",
      "kind": "text_data",
      "source_text": "很幸福。能够和大家一起跑到最后，\n这种理所当然的事，比什么都宝贵。",
      "source_fingerprint": "35c5fb340b447b861ee146e3489c4689ec2caaab4c777a57d8f72fc90c1a5230",
      "source_path": "text_data_dict.json",
