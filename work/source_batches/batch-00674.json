      ]
    },
    {
      "uid": "zhcn:ed46260bade73a271a0aa9b1",
      "kind": "text_data",
      "source_text": "是的，我没有停下脚步的时间。\n在将世界连结起来之前，必须要一直奔跑下去。",
      "source_fingerprint": "766092968ff19272f9a49a365d658140895b4d75ee1c2e7ac9b9571e83858d5a",
      "source_path": "text_data_dict.json",
