      ]
    },
    {
      "uid": "zhcn:0d3188b4c861ca6e81447495",
      "kind": "text_data",
      "source_text": "没什么特别的。\n这不过是必经之路，没什么好高兴的。",
      "source_fingerprint": "46091a8e09efd72c6b83e2b62f2265921d5425bfb3113fc0a6272d5b12bf9058",
