      ]
    },
    {
      "uid": "zhcn:02e153f7f187ee0af9cff860",
      "kind": "text_data",
      "source_text": "这场胜利是多亏了风水才赢得的……\\n能让大家明白这件事的话我会很开心的。",
      "source_fingerprint": "b1d06683781a4c8086a014c219443ab84c2c14c5e6540c5c24378ecb85e3b76b",
      "source_path": "text_data_dict.json",
