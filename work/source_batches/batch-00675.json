      ]
    },
    {
      "uid": "zhcn:5642d4b4aa071d4c95306190",
      "kind": "text_data",
      "source_text": "多亏有对手们扬起的暴风和训练员的暖风，\\n才促使着我往前冲。",
      "source_fingerprint": "f5b79406ccf70be70e9978a936764a44f010f313826f820361b2f6d0a46dc306",
