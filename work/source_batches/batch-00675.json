    {
      "uid": "zhcn:1d1095839d42460aa5f84415",
      "kind": "text_data",
      "source_text": "耶嘿嘿！但也是因为实力增强了才能优胜的，\\n所以也是训练员的功劳喔♪",
      "source_fingerprint": "61d8d3f1e386192f9e4dd9e01a324553220c4b221401eb49d83bcdfb8cc5c996",
      "source_path": "text_data_dict.json",
