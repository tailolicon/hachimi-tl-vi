      ]
    },
    {
      "uid": "zhcn:1803b55a4ae876e1c9a31502",
      "kind": "text_data",
      "source_text": "我认为是找出属于自己的跑步方式。",
      "source_fingerprint": "61c1c95f722ae1ca0d9d8e17db7f7e3c41aaa3812c613510843cbac90751c323",
      "source_path": "text_data_dict.json",
