      ]
    },
    {
      "uid": "zhcn:1b3cf4962f7b89b8186fb139",
      "kind": "text_data",
      "source_text": "咦？啊……我会努力呗～！",
      "source_fingerprint": "207ed310ffd0f6f0d6cc78c5d86b46f567fd20a60b5487ccc108405ec1fe8ac4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "973"
      ]
    },
    {
      "uid": "zhcn:67f9e24ebccf81767cbb3915",
      "kind": "text_data",
      "source_text": "咦咦？王者！？没有啦，太过奖了，\\n我会继续加油……好好努力呗！",
      "source_fingerprint": "4ddd1ca0621f4f685408c1b445349f861802e8992484d0cb4022c1c4e228a883",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "974"
      ]
    },
    {
      "uid": "zhcn:70bad744aef4657dba3c8b12",
      "kind": "text_data",
      "source_text": "那个，我今后还会继续跑下去的！\\n我们一起努力让苫小牧变得更繁荣吧……！",
      "source_fingerprint": "048145aede5bdf42cd5e8ec8c1e1e6a029774bd5ddc7c0dc31a760621fbafe12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
