      ]
    },
    {
      "uid": "zhcn:b872c0e148641e2e36da5c56",
      "kind": "text_data",
      "source_text": "那个，我今后还会继续跑下去的！\\n我们一起努力让苫小牧变得更繁荣吧……！",
      "source_fingerprint": "048145aede5bdf42cd5e8ec8c1e1e6a029774bd5ddc7c0dc31a760621fbafe12",
      "source_path": "text_data_dict.json",
