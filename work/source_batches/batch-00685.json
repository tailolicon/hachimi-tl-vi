{
  "schema_version": 1,
  "batch": 685,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:09b4177ebbfa47447f1d10f9",
      "kind": "text_data",
      "source_text": "在唱卡拉OK前，必须要讲开场台词",
      "source_fingerprint": "5f9982b46dfa9824be04d70dafc6ea36eeda218632912efb74b697c6294d2ba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1014"
      ]
    },
    {
      "uid": "zhcn:39f45239b0dba9e0b3531b6a",
      "kind": "text_data",
      "source_text": "观看戏剧时必定会为剧组成员送上花篮",
      "source_fingerprint": "5cf7c1fe014dd35105e291faa1f0973804458903a82f91b66b63538a5df59e8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1015"
      ]
    },
    {
      "uid": "zhcn:8d59d944d681fc96633ab431",
      "kind": "text_data",
      "source_text": "如果互相盯视，不首先移开视线",
      "source_fingerprint": "f11e69351361a724ce87a85d7ce67a5bff175cf16dac485341ceba0442f7bb54",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1016"
      ]
    },
    {
      "uid": "zhcn:fe01e4fcdc4e0131ff84689b",
      "kind": "text_data",
      "source_text": "出远门时，会为学生会成员带回当地特产",
      "source_fingerprint": "6cdd4682194d4406ec29abbd9f0f55a1c300eaf55f5e1d10482097291e198f9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1017"
      ]
    },
    {
      "uid": "zhcn:e5ec89ca8fa4b4829489b9d6",
      "kind": "text_data",
      "source_text": "不挑食，无论是珍馐还是失败作都能吃完",
      "source_fingerprint": "013c55e31d7d2acac900e4f762e62ec54e33bcaf41528443c0a55baa327dd725",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1018"
      ]
    },
    {
      "uid": "zhcn:46ad2a386c4d49a9cd5df523",
      "kind": "text_data",
      "source_text": "对于芸芸众生的推，即便自己不推也该尊",
      "source_fingerprint": "ac5adbe4fec77be8c433dce78b8395b5b7fa57987f4c619b5957ac7cdb468c41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1019"
      ]
    },
    {
      "uid": "zhcn:276c269e778872321ed709c6",
      "kind": "text_data",
      "source_text": "米饭一粒不剩地吃光，鱼的话除了骨头以外全都吃掉",
      "source_fingerprint": "dc746ff642ec5138e60f3b35eef354ef31bc0d6545fd98ba307af585fe6a75ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1020"
      ]
    },
    {
      "uid": "zhcn:300d92df2b310abddd69b5f1",
      "kind": "text_data",
      "source_text": "认真品尝乌冬面时，只放酱油",
      "source_fingerprint": "e93bb56fa793f1adb24e12c3d36dd45e335f34b9265d89f2238ba3a24d6015b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1021"
      ]
    },
    {
      "uid": "zhcn:9c95c70df377e7e0f644a96c",
      "kind": "text_data",
      "source_text": "起床后会立刻去看祖国的新闻",
      "source_fingerprint": "1ca7401a930c70614a7fd7513ca65c7d4492016cd5a3ff1cdd8f97f37389c1ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1022"
      ]
    },
    {
      "uid": "zhcn:96b765b16aee9e3f97b6910a",
      "kind": "text_data",
      "source_text": "睡前将眼镜放在床的左上角",
      "source_fingerprint": "7630135575cb508a2d9cd1679326d3ad72ce0a5aaf7b88d55fbb4cec4f402f6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1023"
      ]
    },
    {
      "uid": "zhcn:7ebfe4827961e4ecde87e80b",
      "kind": "text_data",
      "source_text": "在进入训练员室前会涂上口袋里的口红",
      "source_fingerprint": "974e3880059a2b1c2523b0641f33659ee1a9f640358664bf82ee3bf2c15f8d32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1024"
      ]
    },
    {
      "uid": "zhcn:86f9fb62a1db6329e5350e56",
      "kind": "text_data",
      "source_text": "黄昏时刻尽可能独自度过",
      "source_fingerprint": "bc16f726c5a1912a4b637c796168a3c861126288c1674b1f64f18a146acdfd08",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1025"
      ]
    },
    {
      "uid": "zhcn:e195cc18a34fe6590b4cfcd1",
      "kind": "text_data",
      "source_text": "不要忘记世上存在着无法用数值来衡量的东西",
      "source_fingerprint": "a35bb209676792822d7c09c7525be91427a417996997f01127a101872bcbfe86",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1026"
      ]
    },
    {
      "uid": "zhcn:4964e4ab1fbc52a36ca92890",
      "kind": "text_data",
      "source_text": "喜欢的少女漫画出新一期时，会把所有的全重看一遍",
      "source_fingerprint": "d1a217baf1d3cdaeb357c965d6ea42e3bc55b85db9871a66e11a964e08bb23cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1027"
      ]
    },
    {
      "uid": "zhcn:95ee3d0fa07e8a3ee7b271de",
      "kind": "text_data",
      "source_text": "口袋里总是放着很~多糖果♪",
      "source_fingerprint": "0140cc8f57dddfe6ddea5790c33f67fa6fa69292de50bbb29887f183dfdf0b04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1028"
      ]
    },
    {
      "uid": "zhcn:8abc88d1e165e0b2b444f9df",
      "kind": "text_data",
      "source_text": "冬天绝对是被炉的季节。即使在宿舍里也喜欢用迷你被炉",
      "source_fingerprint": "16fff57dbbbd3743436a555ea05804d71b5381ee207f5498d7b19e463f6964ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1029"
      ]
    },
    {
      "uid": "zhcn:3aab414bd9ad09bd38552d07",
      "kind": "text_data",
      "source_text": "将绘本的腰封小心取下并保存起来",
      "source_fingerprint": "5d9e9b9e5588637ca5af632955e043fb5d8f39c687b6247514087c41dcb28363",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1030"
      ]
    },
    {
      "uid": "zhcn:6dd5b57e081f11693148cb18",
      "kind": "text_data",
      "source_text": "打工的发薪日给妹妹们寄礼物！",
      "source_fingerprint": "4e61aa329749474e8012011afd4636a320f4d686267289dc9e5830f7036ea5eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1031"
      ]
    },
    {
      "uid": "zhcn:1bbf593b54b4213300518c39",
      "kind": "text_data",
      "source_text": "头发长了就自己剪",
      "source_fingerprint": "4cc355b411a6aec7aa78773dbb56db3d830c3aa12de82566b65af63192a3a857",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1032"
      ]
    },
    {
      "uid": "zhcn:bfc08a40a4916a59cc280ecd",
      "kind": "text_data",
      "source_text": "认真读书时只在台灯下读",
      "source_fingerprint": "55df106e9ad24689540e63f56fb811cb436b3f2678371783448f22e675b59e60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1033"
      ]
    },
    {
      "uid": "zhcn:897f16a0bf6f13465b4609b2",
      "kind": "text_data",
      "source_text": "不拿隔夜的胡萝卜",
      "source_fingerprint": "9d25c4962925269a39c09dfe52b8676001f88adeffd7809abf4172aea2f642d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1034"
      ]
    },
    {
      "uid": "zhcn:aff721ad11ab55f28f802d4a",
      "kind": "text_data",
      "source_text": "经常关注最新的训练装备！",
      "source_fingerprint": "1ae62bb400c3bdadb440abd041c79ce355e43d3c9b8c321d0a224484d88ed38a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1035"
      ]
    },
    {
      "uid": "zhcn:5a9ff909e5a8f79f70600d33",
      "kind": "text_data",
      "source_text": "关掉所有社交平台的通知",
      "source_fingerprint": "316b3a48733c97be8de9ed30cb8473d3424b7dccc8893a175cae261f09fe24c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1036"
      ]
    },
    {
      "uid": "zhcn:179ad4093df3c87866766f76",
      "kind": "text_data",
      "source_text": "基本上只购买事先写好的购物清单上的物品",
      "source_fingerprint": "a30f610553bbea0b19faad63178d48d270877b765447db1f8cf3d64b23f48859",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1037"
      ]
    },
    {
      "uid": "zhcn:508a773cd54e30cbf1822668",
      "kind": "text_data",
      "source_text": "拍摄之后的料理会可爱地吃完♪",
      "source_fingerprint": "fac139b5e20d5b314222a63dd38d184953f1b8d683de8726a24fcd59f179b2e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1038"
      ]
    },
    {
      "uid": "zhcn:6e05506045621e86a055ab3e",
      "kind": "text_data",
      "source_text": "要自己主动向王子殿下求婚",
      "source_fingerprint": "23c8b21a837005302b55804c311b593729ef10460070d7b08d442d8cfedf4374",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1039"
      ]
    },
    {
      "uid": "zhcn:1a72f1f97ca6017721f9e004",
      "kind": "text_data",
      "source_text": "摄影日前一天不要吃盐分过多的东西",
      "source_fingerprint": "bdd757d6c9ee70f35ff3468f824719b3467f60cd3b1cac94db3094f2b2076082",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1040"
      ]
    },
    {
      "uid": "zhcn:bae45117d19ea1f1668de0a2",
      "kind": "text_data",
      "source_text": "有关班级的问题要在被找去商量前就飞速解决！",
      "source_fingerprint": "7800cbe05f8f738a3a977d7c9a731ec02ac5b6b05e62b6d22fb8a7802b9101f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1041"
      ]
    },
    {
      "uid": "zhcn:52068460e942d7f1932c2787",
      "kind": "text_data",
      "source_text": "目光交汇后，就开唠",
      "source_fingerprint": "a2dafe787972ed5ad9aefe9722c8ed6b78499ea7784c8a410f848525dc4e88f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1042"
      ]
    },
    {
      "uid": "zhcn:ae6e71a7c2cd182eefe456b7",
      "kind": "text_data",
      "source_text": "魔女都是夜猫子所以可以睡懒觉",
      "source_fingerprint": "635f0acde7ad0764097a4d3d6d66fa38f49f59db644549baaef9b6f080d4e6cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1044"
      ]
    },
    {
      "uid": "zhcn:abd63ce7891bf44431073934",
      "kind": "text_data",
      "source_text": "不去做对自己不利的溺爱",
      "source_fingerprint": "9dcf80287dd34e5045b2dac25c9d49219b412cb96c16979f6fd55172ad29fddc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1045"
      ]
    },
    {
      "uid": "zhcn:0e5e27da76e0b20ab6126f2c",
      "kind": "text_data",
      "source_text": "（想要）在柜子里放满偶像周边",
      "source_fingerprint": "cc994c70ba0f8c364ff79705f52c5f8229a7f28f9c5f3363aa279ecb682341f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1046"
      ]
    },
    {
      "uid": "zhcn:a7471547b4a9b577fffc61c8",
      "kind": "text_data",
      "source_text": "恐怖小说要在明亮、热闹的地方看",
      "source_fingerprint": "54859a6295e51b7a20fb46a47c5fa355c26d5ffb7c9322bb9de2179b94c593dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1047"
      ]
    },
    {
      "uid": "zhcn:949ef5a30d21ae072697aee7",
      "kind": "text_data",
      "source_text": "汉堡配薯条是必点套餐",
      "source_fingerprint": "071f0ff7dafdda2a13b9aea279eef8fc61bfeb4255299acb0a5317f223bed0da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1048"
      ]
    },
    {
      "uid": "zhcn:d554c42c7a1e95ad01453add",
      "kind": "text_data",
      "source_text": "杂煮要慢慢煮3个小时",
      "source_fingerprint": "fbfceccb96a36b6822ee7d41a45e868645de8c6b85fc800c1150c5e35e56a52e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1049"
      ]
    },
    {
      "uid": "zhcn:55699e4bb06026408c5a0d93",
      "kind": "text_data",
      "source_text": "不要给野猫起名字",
      "source_fingerprint": "a2277089bea392febe261d990d0192dd428443e35fb6a74dbe7e937e3cd26b7e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1050"
      ]
    },
    {
      "uid": "zhcn:deeade587642854ec9d536c2",
      "kind": "text_data",
      "source_text": "马上查课上看不懂的汉字",
      "source_fingerprint": "8f1f7827093e55461462c2d94e1096b1f7bd6ca150f04c31770934c480243f81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1051"
      ]
    },
    {
      "uid": "zhcn:f07de863bcdbe3df753e120d",
      "kind": "text_data",
      "source_text": "已经不需要再用洗发帽了！",
      "source_fingerprint": "d8f0273cd01ee341c2889d3d660b5246bb2cc52458a3d235b001664c125e3caa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1052"
      ]
    },
    {
      "uid": "zhcn:c5270c62878e4abf03521acc",
      "kind": "text_data",
      "source_text": "首先要从『相信』开始",
      "source_fingerprint": "6ce4d36dab9febcf484fc353101a07b5e513d271143bd369dfd0c3aef1794baf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1053"
      ]
    },
    {
      "uid": "zhcn:2177da88ffec67b7dc5ec146",
      "kind": "text_data",
      "source_text": "迷路时比起看地图更习惯参照地形☆",
      "source_fingerprint": "99cc1f6c868467586124dd19394db72407f04a3977f0b254296ca16ac726d28d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1055"
      ]
    },
    {
      "uid": "zhcn:7ce654c147d407fbe17ac7ad",
      "kind": "text_data",
      "source_text": "遭遇黑猫后为了不让它横穿自己要走的路得和它并排移动",
      "source_fingerprint": "0c1148c5156a500f00b4fb3edbf235b896f012538288f2fe985457ee09a67e74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1056"
      ]
    },
    {
      "uid": "zhcn:6fc4d9dc13533cf26ae3a7e2",
      "kind": "text_data",
      "source_text": "完全以“是否有趣”为准则",
      "source_fingerprint": "24d2648c2aea0e4d222a27c38133f26029eb38a1a30d62c6c6a45c3d5376f914",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1057"
      ]
    },
    {
      "uid": "zhcn:899788db48ff28b530357a7f",
      "kind": "text_data",
      "source_text": "常备福来占卜出的幸运物品",
      "source_fingerprint": "d3931eda9887252d459aaa23bae5584458f8223dea0531d934676bb74be1d73d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1058"
      ]
    },
    {
      "uid": "zhcn:2e3dd661c08c985f2fae9816",
      "kind": "text_data",
      "source_text": "跟小孩子说话时会俯身与他们平视",
      "source_fingerprint": "4ec162353965185802dc4743f7ce17fda98e3cc7f06d0b33cf87754d99891393",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1059"
      ]
    },
    {
      "uid": "zhcn:56424417a46eef64e5758631",
      "kind": "text_data",
      "source_text": "缓解腿部肌肉疲劳的话就得靠青竹踏",
      "source_fingerprint": "a422a05755f78514f4d30795bd08aaaf55e7e7cc9177dd8e4a4ce462edacfab3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1060"
      ]
    },
    {
      "uid": "zhcn:eab8b50c0491d0761af269ad",
      "kind": "text_data",
      "source_text": "越是消沉的时候就越得昂首挺胸",
      "source_fingerprint": "3a1a8a5367a59160d1604143705de42ed42cd37b744d5ede0c4eaaa335d223f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1061"
      ]
    },
    {
      "uid": "zhcn:55ba6c53038402bdc8ea96cb",
      "kind": "text_data",
      "source_text": "是土豆沙拉里加黄瓜派！",
      "source_fingerprint": "2d73674eb1bfbf3483acc9223015bc310223d94a166f984b346a8c774ba7808f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1062"
      ]
    },
    {
      "uid": "zhcn:0da3879f8aa0f6ebea3ff683",
      "kind": "text_data",
      "source_text": "更换昂贵的自行车配件时，会考虑两晚再做决定",
      "source_fingerprint": "b05e302e7551b901ccc521c4d70ca888e575ccbf4dba912f4a880411af51e070",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1063"
      ]
    },
    {
      "uid": "zhcn:ecf13e6d4e8aef45bb7c379e",
      "kind": "text_data",
      "source_text": "被说「可以领放」，就代表这儿自己应该领放",
      "source_fingerprint": "17cf07dcdf20b1bc58c69bad912f62ca8fe0d54c6b30e143f47f03149501deaf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1064"
      ]
    },
    {
      "uid": "zhcn:e000ba780c0c2d2f1ebf5450",
      "kind": "text_data",
      "source_text": "没有★",
      "source_fingerprint": "472990b3f032cf5f9fc4fea30c182799d541d7aa64ffc46e0d7c9df02e7d969a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1065"
      ]
    },
    {
      "uid": "zhcn:2a5f77e021e3d949b4571d78",
      "kind": "text_data",
      "source_text": "有在意的事情，就主动参与进去！",
      "source_fingerprint": "38f7e31f32780a174c783863874d6c716a78e17fe106ccdbef2fd204155d3400",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1067"
      ]
    },
    {
      "uid": "zhcn:8c9bbd38d0a5761d28899633",
      "kind": "text_data",
      "source_text": "训练要一直做到筋疲力尽！",
      "source_fingerprint": "c1792ffe9401e4492b5dbd9daf499bcf9661eb481d1e30f0e664c630b910e24a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1068"
      ]
    },
    {
      "uid": "zhcn:a3fb4f615b276f1e85b58b4b",
      "kind": "text_data",
      "source_text": "睡前更新自己的时间表！",
      "source_fingerprint": "46110073720eaabbf1b5aa63e9b15c2e06d15848e392505aa4bc6d7ba4c8cb04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1069"
      ]
    },
    {
      "uid": "zhcn:09246f92f4afedcb28b981ea",
      "kind": "text_data",
      "source_text": "会教新人最起码的规矩",
      "source_fingerprint": "5138073924f51f7732c3cd3794a266cea42f19d197e178e9e121422e0b5b5d82",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1070"
      ]
    },
    {
      "uid": "zhcn:7f590b0ca5967ed30ab26851",
      "kind": "text_data",
      "source_text": "药膳原材料要去喜欢的中华食材店买",
      "source_fingerprint": "f10775342b17ebafe5abb3c4fb38799622c81ea8f394207b80a433a4b820847a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1071"
      ]
    },
    {
      "uid": "zhcn:f2e376cd13193792f25b1cfe",
      "kind": "text_data",
      "source_text": "自己买袜子时要买纯白色",
      "source_fingerprint": "62c7195f128189b9790f75b3b3c51ab2179f7d72f8b61357c35744f75d5912d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1072"
      ]
    },
    {
      "uid": "zhcn:f1e954e9072a17eef46c8486",
      "kind": "text_data",
      "source_text": "只有自己处于队伍末尾时，才允许插队",
      "source_fingerprint": "d515613002ca1913c7ddf89731a91bf6bd53b4679342e2424966b93ade05802d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1074"
      ]
    },
    {
      "uid": "zhcn:552aa264facd3f940c476199",
      "kind": "text_data",
      "source_text": "在寒冷的夜晚，会泡收到的药膳茶",
      "source_fingerprint": "3d8520dbdac6bde2f5ca3f98e4d6565e25f6976aaabb04521020ddcaae95b7b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1076"
      ]
    },
    {
      "uid": "zhcn:55c511b29fa93c9ab8c9a3ce",
      "kind": "text_data",
      "source_text": "宿舍冰箱会常备3盒1升装牛奶",
      "source_fingerprint": "a8b06761f01dd102a3a671236c81acebab01ac2232ffd516b4085f2bcd7d337a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1077"
      ]
    },
    {
      "uid": "zhcn:6afa0bae2073bd5778743dcd",
      "kind": "text_data",
      "source_text": "吹向心间的风不会说谎",
      "source_fingerprint": "c46c5ad76815bb80810f9d4e71fb3a3fdb257a66d986456eb1c20220ac027c20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1078"
      ]
    },
    {
      "uid": "zhcn:6d3d3081d64163cd9846725a",
      "kind": "text_data",
      "source_text": "进杂货店前会先定好预算（遵守率为两成）",
      "source_fingerprint": "bc24020d4da2d08f4ad8ae94e901637df1aa9a63307366ea36f853a8b5dea228",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1080"
      ]
    },
    {
      "uid": "zhcn:66d4df0f5d04fcf82d26cd2e",
      "kind": "text_data",
      "source_text": "添置新衣服时，也会考虑搭配适合的香水",
      "source_fingerprint": "32cea84c9e6f78f228c7dcce89e2c3d3d69c23b5b779edaa86923c0749ea1b74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1082"
      ]
    },
    {
      "uid": "zhcn:0983e65c20eea3a293bfe66a",
      "kind": "text_data",
      "source_text": "写错的汉字要回家后练习",
      "source_fingerprint": "98db69eb263277172ee46f6292070117edda6bc7d5eaffd59c030d97f2c68fc0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1083"
      ]
    },
    {
      "uid": "zhcn:45fcb6f1e8d9fc28fd9969a0",
      "kind": "text_data",
      "source_text": "唯有具备赔偿觉悟之人，方可破坏",
      "source_fingerprint": "e7e3dbe7624ad27ce2174259160c51c188d4b30769b93f3aa457894e8fc3b126",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1084"
      ]
    },
    {
      "uid": "zhcn:5f050993302398be3004faa1",
      "kind": "text_data",
      "source_text": "任何服装都不能有哪怕1毫米褶皱",
      "source_fingerprint": "cd313ffd95341c974a64bd8f2f8232f9f3ce9fe1a1adb08e51099440baa932a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1085"
      ]
    },
    {
      "uid": "zhcn:042413259d555cd2337f8c74",
      "kind": "text_data",
      "source_text": "最后要洗的是指尖",
      "source_fingerprint": "03e9554cb11d48717dbd41dc432ff50733bd4b551cd8b967ef4ff1750459f96b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1086"
      ]
    },
    {
      "uid": "zhcn:00503f261ab93aeb1e9afbc6",
      "kind": "text_data",
      "source_text": "说再见的时候，总是会面带笑容",
      "source_fingerprint": "a395131f4576bc85d81e2f85aaeccce3bc98859cb483739865f34ddb12e2f651",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1087"
      ]
    },
    {
      "uid": "zhcn:d98dbe5d5368ef083a93d895",
      "kind": "text_data",
      "source_text": "早上最先做的是『气血水自检』",
      "source_fingerprint": "f1f0ed02c2dcb1d455990f993cfefbc2be11099b420b584f3cabee11f401219c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1088"
      ]
    },
    {
      "uid": "zhcn:59cf98f088114b36d1e26e16",
      "kind": "text_data",
      "source_text": "棒球转播是广播派",
      "source_fingerprint": "b715798786920dc43b5e7d8cc22690e18f931e87db3af4befadab4b2e804989a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1089"
      ]
    },
    {
      "uid": "zhcn:407b7a235c93b0bf2755e939",
      "kind": "text_data",
      "source_text": "拿到新毛巾时会先贴脸试用",
      "source_fingerprint": "bfb8a6096f9aefa41b35c8855df63eb1ff7c9133d1ae50f3367852e20ca0b9c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1091"
      ]
    },
    {
      "uid": "zhcn:a71ca46d6e088690efa7bbc6",
      "kind": "text_data",
      "source_text": "归还的东西会比借时更整洁",
      "source_fingerprint": "fad6304d63273d49f12e781102b812ab9a7d2cb11b42858ede1fe8e3f3e75233",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1093"
      ]
    },
    {
      "uid": "zhcn:8f859dce97abf5ac353d01d7",
      "kind": "text_data",
      "source_text": "吃动物饼干时，如果抽出狮子形状就算中奖",
      "source_fingerprint": "de444aa9ec3e05301f827059786c4d4c9009788b13a0fb5c193dfebf817dae0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1094"
      ]
    },
    {
      "uid": "zhcn:8ad358f5044db148add2ac43",
      "kind": "text_data",
      "source_text": "清洁工具也保养得闪闪发亮！",
      "source_fingerprint": "4e9fb8aa5eadfa740e41ba363d6ef4951a0a6434d8ecc6a824f38b9d2e6069b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1098"
      ]
    },
    {
      "uid": "zhcn:d521c6e624ddf4cbaf907743",
      "kind": "text_data",
      "source_text": "外出前将帽子的角度调整到满意为止",
      "source_fingerprint": "5c5897fa3723d8d9a335bea5d9f61c5159679ea04482b7ec3ebfaad97701eb37",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1099"
      ]
    },
    {
      "uid": "zhcn:2c064562bce6acaed3fd21f0",
      "kind": "text_data",
      "source_text": "洗完澡后的温热麦茶很暖人心呢",
      "source_fingerprint": "6b2f1374720dea83df0160f181445eda127bc10b017382f47f0ab1bece836b7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1100"
      ]
    },
    {
      "uid": "zhcn:a7d34adae348c9d3076e99dc",
      "kind": "text_data",
      "source_text": "悲伤的时候，会通过弹奏『命运』来转换心情",
      "source_fingerprint": "c905f5991ffdee5301a79666862ce990ef1206ecf7b13b0206cad074869a31a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1102"
      ]
    },
    {
      "uid": "zhcn:bdd68ad510c8f2e88b5a5315",
      "kind": "text_data",
      "source_text": "即使在寒冬，早晨也是用冷水洗脸",
      "source_fingerprint": "d1c295acfeb54283286baf45c0b4bb9bba3de4810c71f4efb3c7b59ed4a77d06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1104"
      ]
    },
    {
      "uid": "zhcn:656be1c43f995d0ad352b853",
      "kind": "text_data",
      "source_text": "柠檬是不能『咬』的",
      "source_fingerprint": "eb01604faadb21c01ed53eab1675ef28ca0229dacbb3716860ccd9f30dd97538",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1105"
      ]
    },
    {
      "uid": "zhcn:fae5558caeb57c6330b3d6ee",
      "kind": "text_data",
      "source_text": "遇上好事会说给别人听，分享喜气",
      "source_fingerprint": "0b23830784130883307fd7de7413d860cfba76587c530f047b896347dcffbf93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1106"
      ]
    },
    {
      "uid": "zhcn:1198498c99a51c1c6155eb50",
      "kind": "text_data",
      "source_text": "做不出决定时会选择抛硬币",
      "source_fingerprint": "8c2225040e799831221f64f19e48333b28ad78b71064b54a12cac29b075d6a0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1107"
      ]
    }
  ]
}
