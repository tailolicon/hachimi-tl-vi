    {
      "uid": "zhcn:b3cb35b9bb2a66babface196",
      "kind": "text_data",
      "source_text": "方才，我已透过电话收到来自双亲的赞赏。\\n──下场比赛也定要拿出与评价相符的贡献。",
      "source_fingerprint": "0243e23889cba9a4750f5f23f17d2148784ec57a65a27aa40281a0e9af473cb8",
