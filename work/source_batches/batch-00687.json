    {
      "uid": "zhcn:f13fbaddf144da8e16af0c74",
      "kind": "text_data",
      "source_text": "当然是北寄贝饭啰！\\n我可是已经都备好料了吶♪",
      "source_fingerprint": "79dee1cbf0c0704fa175aea2fce0c59e375cc48b0d7bc78d860231bef3057b42",
