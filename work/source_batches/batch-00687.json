      ]
    },
    {
      "uid": "zhcn:321d3fe14c8ffd24724b09e3",
      "kind": "text_data",
      "source_text": "我的恩人──也来为我加油了──\\n──能让他看见我的胜利，我很欣慰。",
      "source_fingerprint": "e6a10003b367d58ca362b99f779a66e955a8e1d3a465a7ef8b300654e14d1901",
