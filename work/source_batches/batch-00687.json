        "968"
      ]
    },
    {
      "uid": "zhcn:fb573c51fc24c3003c37118e",
      "kind": "text_data",
      "source_text": "我想想喔～应该还是……\\n随时尽全力认真又脚踏实地吧！",
      "source_fingerprint": "feb1d40856f65352d801d905b7173dc11614b00e8186fb2126e0048923903cf1",
