    {
      "uid": "zhcn:f1c80b0739a7ae27624824ca",
      "kind": "text_data",
      "source_text": "大家都有好好看着小真吗？\\n除了眨眼以外，都不能移开目光喔。",
      "source_fingerprint": "9f363b58d6d3bc18052a9d97728ffb1460d281f105474bce8b060d9a4a29a65b",
      "source_path": "text_data_dict.json",
