        "966"
      ]
    },
    {
      "uid": "zhcn:9ab4695e46ad67efff94c773",
      "kind": "text_data",
      "source_text": "谢谢大家为我加油～♪\\n今后也要继续支持我跟苫小牧喔！",
      "source_fingerprint": "8fb312d9908827ba6e3c1bc095f722ba678fc3ebb01b6fd81ad00d2552469fe0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "232",
        "967"
      ]
    },
    {
      "uid": "zhcn:0c8f59ea4d0dbeff7645fc6d",
      "kind": "text_data",
      "source_text": "超级开心～！\\n毕竟决赛不可能轻松，我会打起精神的！",
      "source_fingerprint": "d396497d831623c19d8d01a14cc04f844b7ee67249869b6573ce6ddbe4499a86",
      "source_path": "text_data_dict.json",
