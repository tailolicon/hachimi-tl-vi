        "1050"
      ]
    },
    {
      "uid": "zhcn:deeade587642854ec9d536c2",
      "kind": "text_data",
      "source_text": "马上查课上看不懂的汉字",
      "source_fingerprint": "8f1f7827093e55461462c2d94e1096b1f7bd6ca150f04c31770934c480243f81",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1051"
      ]
    },
    {
      "uid": "zhcn:f07de863bcdbe3df753e120d",
      "kind": "text_data",
      "source_text": "已经不需要再用洗发帽了！",
      "source_fingerprint": "d8f0273cd01ee341c2889d3d660b5246bb2cc52458a3d235b001664c125e3caa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1052"
      ]
    },
    {
      "uid": "zhcn:c5270c62878e4abf03521acc",
      "kind": "text_data",
      "source_text": "首先要从『相信』开始",
      "source_fingerprint": "6ce4d36dab9febcf484fc353101a07b5e513d271143bd369dfd0c3aef1794baf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1053"
      ]
    },
    {
      "uid": "zhcn:2177da88ffec67b7dc5ec146",
      "kind": "text_data",
      "source_text": "迷路时比起看地图更习惯参照地形☆",
      "source_fingerprint": "99cc1f6c868467586124dd19394db72407f04a3977f0b254296ca16ac726d28d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1055"
      ]
    },
    {
      "uid": "zhcn:7ce654c147d407fbe17ac7ad",
      "kind": "text_data",
      "source_text": "遭遇黑猫后为了不让它横穿自己要走的路得和它并排移动",
