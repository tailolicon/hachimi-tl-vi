      ]
    },
    {
      "uid": "zhcn:aef36ef7e3b46e03e16b3ef8",
      "kind": "text_data",
      "source_text": "黄金船、目白麦昆2人一起参赛并获胜",
      "source_fingerprint": "c6a23f9a1eb5573c99a60bc768554d809e667b21ce2c2456c712faebcd79fb7c",
      "source_path": "text_data_dict.json",
      "json_path": [
