      ]
    },
    {
      "uid": "zhcn:de57cba38ce6569d3e067a32",
      "kind": "text_data",
      "source_text": "北港火山、创升2人一起参赛并获胜",
      "source_fingerprint": "169e90d29fcee1e79b5f3b5c139dbd535a30d8db61761ecb8f69e8711104820c",
      "source_path": "text_data_dict.json",
      "json_path": [
