      ]
    },
    {
      "uid": "zhcn:cde419ae98c6341c04dcf1cc",
      "kind": "text_data",
      "source_text": "真机伶、樱花进王2人一起参赛并获胜",
      "source_fingerprint": "5fb7d6f48c346d52d421f6365422d02f1d23e8a1a6d358715a00008522381941",
      "source_path": "text_data_dict.json",
      "json_path": [
        "257",
        "4"
      ]
    },
    {
      "uid": "zhcn:7628bf9b5deaa3f48bf93fb9",
      "kind": "text_data",
      "source_text": "小栗帽、大树快车2人一起参赛并获胜",
      "source_fingerprint": "f0d50a33500d3d3113502788673b3a0f11dc133cac5a0a2eaeca96872bb1e3e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "257",
        "5"
      ]
    },
    {
      "uid": "zhcn:bf6b31d80f1d497f21a8124f",
      "kind": "text_data",
      "source_text": "东海帝王、鲁道夫象征2人一起参赛并获胜",
      "source_fingerprint": "c88a6c97fe1cd431540dc012e3243f5d1bd3a87141bbadfbc37d032c32e159c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "257",
        "6"
      ]
    },
    {
      "uid": "zhcn:0269360f0c6adf1b97f16613",
      "kind": "text_data",
      "source_text": "里见光钻、北部玄驹2人一起参赛并获胜",
      "source_fingerprint": "8a5f369e0aa23a7cf683d54879813db3133a0e09d054ad3c682177a7b5ab49a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "257",
        "7"
      ]
    },
    {
      "uid": "zhcn:5aa0b8fde66cb1bf81eb0dd5",
      "kind": "text_data",
      "source_text": "醒目飞鹰、小林历奇2人一起参赛并获胜",
      "source_fingerprint": "d71863ce5fb8c857d8dd8b625fc7b248e299b5c34d70f032ca92739b5dd7f186",
      "source_path": "text_data_dict.json",
      "json_path": [
        "257",
        "8"
      ]
    },
    {
      "uid": "zhcn:9fc29f0b3af7cdfa157c3061",
      "kind": "text_data",
      "source_text": "大树快车、第一红宝石2人一起参赛并获胜",
      "source_fingerprint": "d0c5cffee9adeab6cd39997e9b088710182292e3fe9015c0365129eb9f2d6fa2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "257",
        "9"
      ]
    },
    {
      "uid": "zhcn:43a3b99c115e0e459a1b3b6d",
      "kind": "text_data",
      "source_text": "吃玉米时一定要专心致志！",
      "source_fingerprint": "90583652322367f23b79c4a4200ad10eb7a5c4ef4302488d57184a0124806766",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1001"
      ]
    },
    {
      "uid": "zhcn:0389d16e6ff2d22b853f782f",
      "kind": "text_data",
      "source_text": "喝热牛奶里头要加一勺蜂蜜",
      "source_fingerprint": "68481a4fabb6ed4fe98fcf18aad483f03119a67e8c51d2f19ea854f50144a09f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1002"
      ]
    },
    {
      "uid": "zhcn:287fdeb7eb967be1298833ad",
      "kind": "text_data",
      "source_text": "状态好的时候喝蜂蜜！不好的时候也喝蜂蜜",
      "source_fingerprint": "bc057883ce0166d3dae91ea92ab9652ea535f67b7271d1c521d59e8ba7d9f774",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1003"
      ]
    },
    {
      "uid": "zhcn:3bd3e47c0bc13254c3cea64d",
      "kind": "text_data",
      "source_text": "早起洗头后咕咚咕咚地喝咖啡牛奶♪",
      "source_fingerprint": "5c4b22bc2f3fa134ca18173bfce00f45c84a39391623dca4bad487bf86124fe0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1004"
      ]
    },
    {
      "uid": "zhcn:26c40161feb37fdacfeba30a",
      "kind": "text_data",
      "source_text": "握手时一定要看着对方的眼睛、然后微笑",
      "source_fingerprint": "f418224f8eb0e25e30914f8e755ed447a7bb7b4300c5ec236586ab504f621156",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1005"
      ]
    },
    {
      "uid": "zhcn:4c8795b8aef61422593bd8f9",
      "kind": "text_data",
      "source_text": "任何情况都不能忘记说“我开动了”",
      "source_fingerprint": "ba6b6b5b5e0f35d2199ca728bcd49a0205f17a6d3111d7aeebf2c66518ed78e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1006"
      ]
    },
    {
      "uid": "zhcn:43a2cccc50112b9a08c5308f",
      "kind": "text_data",
      "source_text": "每30秒改变一次自己的原则",
      "source_fingerprint": "8f5aeffebd08b82aa824204f826b1a47e1d86c55009839297d06c1c3ca3179bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1007"
      ]
    },
    {
      "uid": "zhcn:f45650db18bbb1683204c45a",
      "kind": "text_data",
      "source_text": "迷失方向的话就走没人选过的",
      "source_fingerprint": "79001f85a6c32d2e1fbaccdcb2a549c3717a97228c1aecdc70cb08e4074c1d3c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1008"
      ]
    },
    {
      "uid": "zhcn:c046a4df7c91cc828b34dca4",
      "kind": "text_data",
      "source_text": "笔记本上用红笔写目标，用蓝笔写反省",
      "source_fingerprint": "197cfac5002983f7197ea7a00faf6e82b2c7b837f4bec9737caa3e7e5c8d718b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1009"
      ]
    },
    {
      "uid": "zhcn:dd8a7119c294f70faeabb294",
      "kind": "text_data",
      "source_text": "用妈妈亲传的配方制作烤点心",
      "source_fingerprint": "107875a9aee9d9cfd76e140362f78a95c38412ebce938749d09e86abfec58428",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1010"
      ]
    },
    {
      "uid": "zhcn:872229fcf01042527fbcaa85",
      "kind": "text_data",
      "source_text": "就连笔盒里的铅笔，也要削的整整齐齐",
      "source_fingerprint": "522084c4ca524d5c02a3a7c78385b376560670943c9fe9b15ac1324a56b90ce1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1011"
      ]
    },
    {
      "uid": "zhcn:04ca9480aa624ac965296473",
      "kind": "text_data",
      "source_text": "盛放便当的时候要记得增添点可爱元素",
      "source_fingerprint": "78e60157cfcd4ebffe5a0e559265e4f3ea145105b12f35a3da979f41bb01df17",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1012"
      ]
    },
    {
      "uid": "zhcn:2751c01bd0ed9b51aaabd392",
      "kind": "text_data",
      "source_text": "起床后的第一件事是喝早茶",
      "source_fingerprint": "27037ce2ce2d700f3dd8a94278517d688e4e4661483b50a7064ec2155a9b3b89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1013"
      ]
    },
    {
      "uid": "zhcn:09b4177ebbfa47447f1d10f9",
      "kind": "text_data",
      "source_text": "在唱卡拉OK前，必须要讲开场台词",
      "source_fingerprint": "5f9982b46dfa9824be04d70dafc6ea36eeda218632912efb74b697c6294d2ba2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1014"
      ]
    },
    {
      "uid": "zhcn:39f45239b0dba9e0b3531b6a",
      "kind": "text_data",
      "source_text": "观看戏剧时必定会为剧组成员送上花篮",
      "source_fingerprint": "5cf7c1fe014dd35105e291faa1f0973804458903a82f91b66b63538a5df59e8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1015"
      ]
    },
    {
      "uid": "zhcn:8d59d944d681fc96633ab431",
      "kind": "text_data",
      "source_text": "如果互相盯视，不首先移开视线",
      "source_fingerprint": "f11e69351361a724ce87a85d7ce67a5bff175cf16dac485341ceba0442f7bb54",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1016"
      ]
    },
    {
      "uid": "zhcn:fe01e4fcdc4e0131ff84689b",
      "kind": "text_data",
      "source_text": "出远门时，会为学生会成员带回当地特产",
      "source_fingerprint": "6cdd4682194d4406ec29abbd9f0f55a1c300eaf55f5e1d10482097291e198f9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1017"
      ]
    },
    {
      "uid": "zhcn:e5ec89ca8fa4b4829489b9d6",
      "kind": "text_data",
      "source_text": "不挑食，无论是珍馐还是失败作都能吃完",
      "source_fingerprint": "013c55e31d7d2acac900e4f762e62ec54e33bcaf41528443c0a55baa327dd725",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1018"
      ]
    },
    {
      "uid": "zhcn:46ad2a386c4d49a9cd5df523",
      "kind": "text_data",
      "source_text": "对于芸芸众生的推，即便自己不推也该尊",
      "source_fingerprint": "ac5adbe4fec77be8c433dce78b8395b5b7fa57987f4c619b5957ac7cdb468c41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1019"
      ]
    },
    {
      "uid": "zhcn:276c269e778872321ed709c6",
      "kind": "text_data",
      "source_text": "米饭一粒不剩地吃光，鱼的话除了骨头以外全都吃掉",
      "source_fingerprint": "dc746ff642ec5138e60f3b35eef354ef31bc0d6545fd98ba307af585fe6a75ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1020"
      ]
    },
    {
      "uid": "zhcn:300d92df2b310abddd69b5f1",
      "kind": "text_data",
      "source_text": "认真品尝乌冬面时，只放酱油",
      "source_fingerprint": "e93bb56fa793f1adb24e12c3d36dd45e335f34b9265d89f2238ba3a24d6015b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1021"
      ]
    },
    {
      "uid": "zhcn:9c95c70df377e7e0f644a96c",
      "kind": "text_data",
      "source_text": "起床后会立刻去看祖国的新闻",
      "source_fingerprint": "1ca7401a930c70614a7fd7513ca65c7d4492016cd5a3ff1cdd8f97f37389c1ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1022"
      ]
    },
    {
      "uid": "zhcn:96b765b16aee9e3f97b6910a",
      "kind": "text_data",
      "source_text": "睡前将眼镜放在床的左上角",
      "source_fingerprint": "7630135575cb508a2d9cd1679326d3ad72ce0a5aaf7b88d55fbb4cec4f402f6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1023"
      ]
    },
    {
      "uid": "zhcn:7ebfe4827961e4ecde87e80b",
      "kind": "text_data",
      "source_text": "在进入训练员室前会涂上口袋里的口红",
      "source_fingerprint": "974e3880059a2b1c2523b0641f33659ee1a9f640358664bf82ee3bf2c15f8d32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1024"
      ]
    },
    {
      "uid": "zhcn:86f9fb62a1db6329e5350e56",
      "kind": "text_data",
      "source_text": "黄昏时刻尽可能独自度过",
      "source_fingerprint": "bc16f726c5a1912a4b637c796168a3c861126288c1674b1f64f18a146acdfd08",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1025"
      ]
    },
    {
      "uid": "zhcn:e195cc18a34fe6590b4cfcd1",
      "kind": "text_data",
      "source_text": "不要忘记世上存在着无法用数值来衡量的东西",
      "source_fingerprint": "a35bb209676792822d7c09c7525be91427a417996997f01127a101872bcbfe86",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1026"
      ]
    },
    {
      "uid": "zhcn:4964e4ab1fbc52a36ca92890",
      "kind": "text_data",
      "source_text": "喜欢的少女漫画出新一期时，会把所有的全重看一遍",
      "source_fingerprint": "d1a217baf1d3cdaeb357c965d6ea42e3bc55b85db9871a66e11a964e08bb23cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1027"
      ]
    },
    {
      "uid": "zhcn:95ee3d0fa07e8a3ee7b271de",
      "kind": "text_data",
      "source_text": "口袋里总是放着很~多糖果♪",
      "source_fingerprint": "0140cc8f57dddfe6ddea5790c33f67fa6fa69292de50bbb29887f183dfdf0b04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1028"
      ]
    },
    {
      "uid": "zhcn:8abc88d1e165e0b2b444f9df",
      "kind": "text_data",
      "source_text": "冬天绝对是被炉的季节。即使在宿舍里也喜欢用迷你被炉",
      "source_fingerprint": "16fff57dbbbd3743436a555ea05804d71b5381ee207f5498d7b19e463f6964ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1029"
      ]
    },
    {
      "uid": "zhcn:3aab414bd9ad09bd38552d07",
      "kind": "text_data",
      "source_text": "将绘本的腰封小心取下并保存起来",
      "source_fingerprint": "5d9e9b9e5588637ca5af632955e043fb5d8f39c687b6247514087c41dcb28363",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1030"
      ]
    },
    {
      "uid": "zhcn:6dd5b57e081f11693148cb18",
      "kind": "text_data",
      "source_text": "打工的发薪日给妹妹们寄礼物！",
      "source_fingerprint": "4e61aa329749474e8012011afd4636a320f4d686267289dc9e5830f7036ea5eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1031"
      ]
    },
    {
      "uid": "zhcn:1bbf593b54b4213300518c39",
      "kind": "text_data",
      "source_text": "头发长了就自己剪",
      "source_fingerprint": "4cc355b411a6aec7aa78773dbb56db3d830c3aa12de82566b65af63192a3a857",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1032"
      ]
    },
    {
      "uid": "zhcn:bfc08a40a4916a59cc280ecd",
      "kind": "text_data",
      "source_text": "认真读书时只在台灯下读",
