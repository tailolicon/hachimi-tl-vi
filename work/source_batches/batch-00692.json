      "json_path": [
        "258",
        "1061"
      ]
    },
    {
      "uid": "zhcn:55ba6c53038402bdc8ea96cb",
      "kind": "text_data",
      "source_text": "是土豆沙拉里加黄瓜派！",
      "source_fingerprint": "2d73674eb1bfbf3483acc9223015bc310223d94a166f984b346a8c774ba7808f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1062"
      ]
    },
    {
      "uid": "zhcn:0da3879f8aa0f6ebea3ff683",
      "kind": "text_data",
      "source_text": "更换昂贵的自行车配件时，会考虑两晚再做决定",
      "source_fingerprint": "b05e302e7551b901ccc521c4d70ca888e575ccbf4dba912f4a880411af51e070",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
