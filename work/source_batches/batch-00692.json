      "json_path": [
        "258",
        "1056"
      ]
    },
    {
      "uid": "zhcn:6fc4d9dc13533cf26ae3a7e2",
      "kind": "text_data",
      "source_text": "完全以“是否有趣”为准则",
      "source_fingerprint": "24d2648c2aea0e4d222a27c38133f26029eb38a1a30d62c6c6a45c3d5376f914",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1057"
      ]
    },
    {
      "uid": "zhcn:899788db48ff28b530357a7f",
      "kind": "text_data",
      "source_text": "常备福来占卜出的幸运物品",
      "source_fingerprint": "d3931eda9887252d459aaa23bae5584458f8223dea0531d934676bb74be1d73d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1058"
      ]
    },
    {
      "uid": "zhcn:2e3dd661c08c985f2fae9816",
      "kind": "text_data",
      "source_text": "跟小孩子说话时会俯身与他们平视",
      "source_fingerprint": "4ec162353965185802dc4743f7ce17fda98e3cc7f06d0b33cf87754d99891393",
