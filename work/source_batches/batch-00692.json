      ]
    },
    {
      "uid": "zhcn:ecf13e6d4e8aef45bb7c379e",
      "kind": "text_data",
      "source_text": "被说「可以领放」，就代表这儿自己应该领放",
      "source_fingerprint": "17cf07dcdf20b1bc58c69bad912f62ca8fe0d54c6b30e143f47f03149501deaf",
