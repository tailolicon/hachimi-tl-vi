{
  "schema_version": 1,
  "batch": 693,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:a3fb4f615b276f1e85b58b4b",
      "kind": "text_data",
      "source_text": "睡前更新自己的时间表！",
      "source_fingerprint": "46110073720eaabbf1b5aa63e9b15c2e06d15848e392505aa4bc6d7ba4c8cb04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1069"
      ]
    },
    {
      "uid": "zhcn:09246f92f4afedcb28b981ea",
      "kind": "text_data",
      "source_text": "会教新人最起码的规矩",
      "source_fingerprint": "5138073924f51f7732c3cd3794a266cea42f19d197e178e9e121422e0b5b5d82",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1070"
      ]
    },
    {
      "uid": "zhcn:7f590b0ca5967ed30ab26851",
      "kind": "text_data",
      "source_text": "药膳原材料要去喜欢的中华食材店买",
      "source_fingerprint": "f10775342b17ebafe5abb3c4fb38799622c81ea8f394207b80a433a4b820847a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1071"
      ]
    },
    {
      "uid": "zhcn:f2e376cd13193792f25b1cfe",
      "kind": "text_data",
      "source_text": "自己买袜子时要买纯白色",
      "source_fingerprint": "62c7195f128189b9790f75b3b3c51ab2179f7d72f8b61357c35744f75d5912d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1072"
      ]
    },
    {
      "uid": "zhcn:f1e954e9072a17eef46c8486",
      "kind": "text_data",
      "source_text": "只有自己处于队伍末尾时，才允许插队",
      "source_fingerprint": "d515613002ca1913c7ddf89731a91bf6bd53b4679342e2424966b93ade05802d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1074"
      ]
    },
    {
      "uid": "zhcn:552aa264facd3f940c476199",
      "kind": "text_data",
      "source_text": "在寒冷的夜晚，会泡收到的药膳茶",
      "source_fingerprint": "3d8520dbdac6bde2f5ca3f98e4d6565e25f6976aaabb04521020ddcaae95b7b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1076"
      ]
    },
    {
      "uid": "zhcn:55c511b29fa93c9ab8c9a3ce",
      "kind": "text_data",
      "source_text": "宿舍冰箱会常备3盒1升装牛奶",
      "source_fingerprint": "a8b06761f01dd102a3a671236c81acebab01ac2232ffd516b4085f2bcd7d337a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1077"
      ]
    },
    {
      "uid": "zhcn:6afa0bae2073bd5778743dcd",
      "kind": "text_data",
      "source_text": "吹向心间的风不会说谎",
      "source_fingerprint": "c46c5ad76815bb80810f9d4e71fb3a3fdb257a66d986456eb1c20220ac027c20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1078"
      ]
    },
    {
      "uid": "zhcn:6d3d3081d64163cd9846725a",
      "kind": "text_data",
      "source_text": "进杂货店前会先定好预算（遵守率为两成）",
      "source_fingerprint": "bc24020d4da2d08f4ad8ae94e901637df1aa9a63307366ea36f853a8b5dea228",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1080"
      ]
    },
    {
      "uid": "zhcn:66d4df0f5d04fcf82d26cd2e",
      "kind": "text_data",
      "source_text": "添置新衣服时，也会考虑搭配适合的香水",
      "source_fingerprint": "32cea84c9e6f78f228c7dcce89e2c3d3d69c23b5b779edaa86923c0749ea1b74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1082"
      ]
    },
    {
      "uid": "zhcn:0983e65c20eea3a293bfe66a",
      "kind": "text_data",
      "source_text": "写错的汉字要回家后练习",
      "source_fingerprint": "98db69eb263277172ee46f6292070117edda6bc7d5eaffd59c030d97f2c68fc0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1083"
      ]
    },
    {
      "uid": "zhcn:45fcb6f1e8d9fc28fd9969a0",
      "kind": "text_data",
      "source_text": "唯有具备赔偿觉悟之人，方可破坏",
      "source_fingerprint": "e7e3dbe7624ad27ce2174259160c51c188d4b30769b93f3aa457894e8fc3b126",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1084"
      ]
    },
    {
      "uid": "zhcn:5f050993302398be3004faa1",
      "kind": "text_data",
      "source_text": "任何服装都不能有哪怕1毫米褶皱",
      "source_fingerprint": "cd313ffd95341c974a64bd8f2f8232f9f3ce9fe1a1adb08e51099440baa932a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1085"
      ]
    },
    {
      "uid": "zhcn:042413259d555cd2337f8c74",
      "kind": "text_data",
      "source_text": "最后要洗的是指尖",
      "source_fingerprint": "03e9554cb11d48717dbd41dc432ff50733bd4b551cd8b967ef4ff1750459f96b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1086"
      ]
    },
    {
      "uid": "zhcn:00503f261ab93aeb1e9afbc6",
      "kind": "text_data",
      "source_text": "说再见的时候，总是会面带笑容",
      "source_fingerprint": "a395131f4576bc85d81e2f85aaeccce3bc98859cb483739865f34ddb12e2f651",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1087"
      ]
    },
    {
      "uid": "zhcn:d98dbe5d5368ef083a93d895",
      "kind": "text_data",
      "source_text": "早上最先做的是『气血水自检』",
      "source_fingerprint": "f1f0ed02c2dcb1d455990f993cfefbc2be11099b420b584f3cabee11f401219c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1088"
      ]
    },
    {
      "uid": "zhcn:59cf98f088114b36d1e26e16",
      "kind": "text_data",
      "source_text": "棒球转播是广播派",
      "source_fingerprint": "b715798786920dc43b5e7d8cc22690e18f931e87db3af4befadab4b2e804989a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1089"
      ]
    },
    {
      "uid": "zhcn:407b7a235c93b0bf2755e939",
      "kind": "text_data",
      "source_text": "拿到新毛巾时会先贴脸试用",
      "source_fingerprint": "bfb8a6096f9aefa41b35c8855df63eb1ff7c9133d1ae50f3367852e20ca0b9c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1091"
      ]
    },
    {
      "uid": "zhcn:a71ca46d6e088690efa7bbc6",
      "kind": "text_data",
      "source_text": "归还的东西会比借时更整洁",
      "source_fingerprint": "fad6304d63273d49f12e781102b812ab9a7d2cb11b42858ede1fe8e3f3e75233",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1093"
      ]
    },
    {
      "uid": "zhcn:8f859dce97abf5ac353d01d7",
      "kind": "text_data",
      "source_text": "吃动物饼干时，如果抽出狮子形状就算中奖",
      "source_fingerprint": "de444aa9ec3e05301f827059786c4d4c9009788b13a0fb5c193dfebf817dae0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1094"
      ]
    },
    {
      "uid": "zhcn:8ad358f5044db148add2ac43",
      "kind": "text_data",
      "source_text": "清洁工具也保养得闪闪发亮！",
      "source_fingerprint": "4e9fb8aa5eadfa740e41ba363d6ef4951a0a6434d8ecc6a824f38b9d2e6069b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1098"
      ]
    },
    {
      "uid": "zhcn:d521c6e624ddf4cbaf907743",
      "kind": "text_data",
      "source_text": "外出前将帽子的角度调整到满意为止",
      "source_fingerprint": "5c5897fa3723d8d9a335bea5d9f61c5159679ea04482b7ec3ebfaad97701eb37",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1099"
      ]
    },
    {
      "uid": "zhcn:2c064562bce6acaed3fd21f0",
      "kind": "text_data",
      "source_text": "洗完澡后的温热麦茶很暖人心呢",
      "source_fingerprint": "6b2f1374720dea83df0160f181445eda127bc10b017382f47f0ab1bece836b7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1100"
      ]
    },
    {
      "uid": "zhcn:a7d34adae348c9d3076e99dc",
      "kind": "text_data",
      "source_text": "悲伤的时候，会通过弹奏『命运』来转换心情",
      "source_fingerprint": "c905f5991ffdee5301a79666862ce990ef1206ecf7b13b0206cad074869a31a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1102"
      ]
    },
    {
      "uid": "zhcn:bdd68ad510c8f2e88b5a5315",
      "kind": "text_data",
      "source_text": "即使在寒冬，早晨也是用冷水洗脸",
      "source_fingerprint": "d1c295acfeb54283286baf45c0b4bb9bba3de4810c71f4efb3c7b59ed4a77d06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1104"
      ]
    },
    {
      "uid": "zhcn:656be1c43f995d0ad352b853",
      "kind": "text_data",
      "source_text": "柠檬是不能『咬』的",
      "source_fingerprint": "eb01604faadb21c01ed53eab1675ef28ca0229dacbb3716860ccd9f30dd97538",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1105"
      ]
    },
    {
      "uid": "zhcn:fae5558caeb57c6330b3d6ee",
      "kind": "text_data",
      "source_text": "遇上好事会说给别人听，分享喜气",
      "source_fingerprint": "0b23830784130883307fd7de7413d860cfba76587c530f047b896347dcffbf93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1106"
      ]
    },
    {
      "uid": "zhcn:1198498c99a51c1c6155eb50",
      "kind": "text_data",
      "source_text": "做不出决定时会选择抛硬币",
      "source_fingerprint": "8c2225040e799831221f64f19e48333b28ad78b71064b54a12cac29b075d6a0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1107"
      ]
    },
    {
      "uid": "zhcn:667278d46ec8167c892cc93b",
      "kind": "text_data",
      "source_text": "考试中不知道答案时会摸头上的小闪电",
      "source_fingerprint": "6ad2ab2bf06e9dd8c752c4200d44db27418aa20288c021736867779fbf60faf2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1109"
      ]
    },
    {
      "uid": "zhcn:838d2b7db1f3e8f378bd33ce",
      "kind": "text_data",
      "source_text": "冬天睡觉时会把被子严严实实盖到脖子以上",
      "source_fingerprint": "3da7cee751816390bcf5773d285d2be147def3ba2ccd9506abbb50e48189e43e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1110"
      ]
    },
    {
      "uid": "zhcn:110d621678ef8edb9af8e816",
      "kind": "text_data",
      "source_text": "只会将眼部打理交给被自己认可为强者的美睫师",
      "source_fingerprint": "d1cb0ae9f122d516432b4c87f795cc04a6001671d1fa379c7d7a9132f7171197",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1116"
      ]
    },
    {
      "uid": "zhcn:d84f56949bcf0ad5a8a65f62",
      "kind": "text_data",
      "source_text": "宿舍冰箱里的Dolce（意大利甜点）从不断供",
      "source_fingerprint": "12ccbcd13b48840a9aa81195f9bf693038e729c926e1afc3709922dd5f0568f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1119"
      ]
    },
    {
      "uid": "zhcn:30f3924706be7ac6b7ac2202",
      "kind": "text_data",
      "source_text": "早上，第一个走进教室打开窗户！",
      "source_fingerprint": "973614db4c7da840e5d1eef9d34c88b9a80e027c199dbf824abed4813f694f3b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1124"
      ]
    },
    {
      "uid": "zhcn:0a06006f82e131f8d6588ea0",
      "kind": "text_data",
      "source_text": "会把信纸折成心形再交给对方",
      "source_fingerprint": "28ef192082f084dbc1219c79f0514178df4fd3a7e35c8ea1ef23ca9b528cbf28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "258",
        "1132"
      ]
    },
    {
      "uid": "zhcn:ff3bb45be982959543938f28",
      "kind": "text_data",
      "source_text": "和母亲的双人自拍（每次回家都会更新）",
      "source_fingerprint": "5c9996f8f92034825ce8288df6a4046d97ab99328d46b3bfd313018cc99a0fe1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1001"
      ]
    },
    {
      "uid": "zhcn:a79b9c3b7c52f6699df61ea4",
      "kind": "text_data",
      "source_text": "猫咪角色的壁纸",
      "source_fingerprint": "52273b1c4e24da48e7c7d1e274a1cf3b7f22d1657a2da35d6e0321b8cc9be6b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1002"
      ]
    },
    {
      "uid": "zhcn:6bd6c10931124b9639d0b8ca",
      "kind": "text_data",
      "source_text": "和会长的两人合照（会根据心情更换）",
      "source_fingerprint": "a5227472ab0136b52c3c64efba012ba371fff14630e4a50179936be410bde5d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1003"
      ]
    },
    {
      "uid": "zhcn:81b4f7c95e7f8a2fd2cf20ef",
      "kind": "text_data",
      "source_text": "使用默认壁纸",
      "source_fingerprint": "f4c121cd1e7dcccdfc4881dae934360250096b4e841fb8ecf3481beed524bf3b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1004"
      ]
    },
    {
      "uid": "zhcn:9aab39c9670f6741e3033fbc",
      "kind": "text_data",
      "source_text": "母亲在舞台界刚出道时的海报",
      "source_fingerprint": "e9bb87c88f78716ef183fee1396a8e56e70561198510c06f5310c26544a3dde6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1005"
      ]
    },
    {
      "uid": "zhcn:4ae3b7824da2943e8c329094",
      "kind": "text_data",
      "source_text": "在学习了设置壁纸的方法后，将壁纸设置为母亲的照片",
      "source_fingerprint": "61203423ab3b111ed1fecb51116b124b483cd9e9187e33289e86fb849dc9b35e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1006"
      ]
    },
    {
      "uid": "zhcn:15391af031ee9084677092ca",
      "kind": "text_data",
      "source_text": "『每次见到她貌似壁纸都不一样呢…』（MM大小姐谈）",
      "source_fingerprint": "daf612fe059bd0bc47a0610835d7ea376820818f34fe293a5e858c3c47b3894c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1007"
      ]
    },
    {
      "uid": "zhcn:b9efd921273f7edc747f7b05",
      "kind": "text_data",
      "source_text": "老爸的摩托车的照片",
      "source_fingerprint": "798d520457863c0abc8ca89bd9369ae2f140b9509d3c3acec2a423e10d26aa77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1008"
      ]
    },
    {
      "uid": "zhcn:e6c5fc93a9beb2ec92027d79",
      "kind": "text_data",
      "source_text": "过生日妈妈送的花束的照片",
      "source_fingerprint": "5d449ab6402df6b9f78b8236bc9e036b3c1d73c633085f3a55cceecd552bf881",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1009"
      ]
    },
    {
      "uid": "zhcn:b1eb2c1fe920f42e5f4047b5",
      "kind": "text_data",
      "source_text": "与故乡的亲人们和牧羊犬们拍的合照",
      "source_fingerprint": "bffb62efcba04e50835103ed928cd4df3b6a96147f7d1d490482d330b43a3c44",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1010"
      ]
    },
    {
      "uid": "zhcn:57bffa9a17a85e515c3a7b8e",
      "kind": "text_data",
      "source_text": "以大号文字标记的目标比赛的日期",
      "source_fingerprint": "a97c64cb54a8169fc0e46792294b3be307164d2e667985bbab88c941b6593292",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1011"
      ]
    },
    {
      "uid": "zhcn:d240d98ea71b51cfad352289",
      "kind": "text_data",
      "source_text": "和美浦宿舍的孩子们拍的集体照",
      "source_fingerprint": "97a020397bc75eb38af95f18712ca15c692cf1d5a06836939dad1ae8786f9827",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1012"
      ]
    },
    {
      "uid": "zhcn:64b0b7a4f35c75335d46dd7d",
      "kind": "text_data",
      "source_text": "锁屏画面是目白家的纹章，壁纸仍然保密",
      "source_fingerprint": "44685eca9254ede722524953fb417a2368f68bb6c8837fd9e8742e4b783c868c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1013"
      ]
    },
    {
      "uid": "zhcn:eb9a474c991d0524e13dda0b",
      "kind": "text_data",
      "source_text": "“高扬吧！斗志！”等类似的热血语录",
      "source_fingerprint": "0a4ba9cc37456a883f95027d59f1c2e697f4179cb156da6156fd295828525a83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "259",
        "1014"
      ]
