    {
      "uid": "zhcn:862404848dfdfe3f17bb1a38",
      "kind": "text_data",
      "source_text": "Dear My Trainer,\\n你一直支持着我，所以我也努力做了个点心来报答你。\\n我有友人相助，所以味道一定是有保证的哦♪\\nBest wishes!　美妙",
      "source_fingerprint": "aa36b6afea28220f8758309bfb249b52f11c9bc17299ee0661f893aad748e8d7",
      "source_path": "text_data_dict.json",
