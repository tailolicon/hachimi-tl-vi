      ]
    },
    {
      "uid": "zhcn:f198f01bcc620d699698586f",
      "kind": "text_data",
      "source_text": "尔之忠勤，确为粉骨碎身之诚，甚是欣慰。\\n故赐予尔以此感状并佐以亲制之甘味。\\n望尔珍重其身为“今孔明”之智慧。\\n谨言　莫名其妙",
      "source_fingerprint": "7fd7c0ef1a7ce2d6ea366a278607b139b3e1751e3e331b2ad8780fcfc58f7dd1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "271",
        "109601"
      ]
    },
    {
      "uid": "zhcn:d1e38a4d9055439efa9cabdd",
      "kind": "text_data",
      "source_text": "希望能合您的胃口……。\\n\\n\\n由衷地　　　　　爱如往昔",
      "source_fingerprint": "592fea7ef69d8f8d069aa06df725fdc277e9cd9d5e9487506e75987d5da2241e",
      "source_path": "text_data_dict.json",
