    {
      "uid": "zhcn:22932716bd261958d1e44c18",
      "kind": "text_data",
      "source_text": "『我们的三大铁律』\\n一、只要两人同心，刀山火海也照闯！\\n二、推心置腹坦诚相见，理所应当！\\n三、我们就是“最强”，不惧强敌！\\n铭记这些铁律，给老子好好品尝！",
      "source_fingerprint": "757980a61d5d88c40cceef5bf539877a5f462f15daccbf332e2d5cb33982399b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "271",
        "109401"
      ]
    },
    {
      "uid": "zhcn:ea4f5e3864c888aa164075c8",
      "kind": "text_data",
      "source_text": "会根据需要，适时补充。",
      "source_fingerprint": "bdac58e0d40c64f4a7d00210428d1dd6d41c4ad333a40a8a4fc32ba481918db9",
      "source_path": "text_data_dict.json",
      "json_path": [
