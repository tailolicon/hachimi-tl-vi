    },
    {
      "uid": "zhcn:fca1f577dd2a6f551b19dac7",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "一直以来谢谢你了！\\n跟着我这种全力猛冲的人\\n不容易吧。不过，果然\\n我还是想和你一起努力啊。\\n所以，今后也拜托你了！",
      "source_fingerprint": "11a70e6ae9b1d8e4c35138274d576b4d7fda198aca751c8d6486413e8afcb404",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
