    {
      "uid": "zhcn:32f4e3135450167af30f8b5c",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "Hey, First Mate,\\nWhen it comes to exploring,\\nyou can't forget the snacks.\\nTake this and re-energize!\\nP.S.　别忘了拿上地图还有提灯！",
      "source_fingerprint": "d2e0daaa05315b7e3ad3177508e170f6697d2c6073b3d35cbffed50e31c70ea9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
