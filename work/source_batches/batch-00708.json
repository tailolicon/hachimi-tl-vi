    {
      "uid": "zhcn:f97c1bd8191d7bfac7139dc0",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "请在确认试作品的同时，核对订单申请书。\\n＝＝＝\\n■概念：楚楚可怜的受宠型♡情人节\\n■要点：通过书写错误等表现出生疏感\\n■目标：让人想要支持、更想应援的甜点",
      "source_fingerprint": "de6a4c27c80cf40dc369a8b0b18ff60bb72ddddd75cc8fba0f451d1f2cfd45c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
