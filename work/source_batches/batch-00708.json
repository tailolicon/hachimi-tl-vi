    {
      "uid": "zhcn:0acbce302640f37e475748df",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "我的心意已经注入这份巧克力之中了哦！\\n您总是在我悲伤时安慰我、在我气馁时激励我……\\n对我而言，训练员就像是胡萝卜一样！\\n有您在，我才能奔跑至今、奔向未来。\\n所以，请品尝一下我的心意吧！ ——小特敬上",
      "source_fingerprint": "06be9f0b7fce9f1b51a6e7ee7422c5198c39a098954ecf2f089d8d8cb9eab496",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
