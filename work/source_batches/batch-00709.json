    {
      "uid": "zhcn:f5e6993798c6305bf13b538a",
      "kind": "text_data",
      "source_text": "能把我与训练员连接起来的东西，\\n当然就是对马娘酱的爱！！！\\n欢迎同担☆毕竟萌就是该交流和相互碰撞的！！\\n这一粒一粒都饱含我的宠爱和见解。\\n欢迎各位来战！！",
      "source_fingerprint": "1034cd89d421730044c77784444b3d5e19be9e965b5d558fd4aa44cbb8747ac5",
      "source_path": "text_data_dict.json",
