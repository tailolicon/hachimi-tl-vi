    {
      "uid": "zhcn:733ed2e878bfe19ea5957f0b",
      "kind": "text_data",
      "source_text": "空荡荡虽然很轻松，有时也想填补些什么呢。",
      "source_fingerprint": "7e04fa2ced1c5b96414d34142106d057ac1eaa22d08d25e5f966836ce673339e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "272",
        "105701"
      ]
    },
    {
      "uid": "zhcn:7cbf674548b1761e469a6ebc",
      "kind": "text_data",
      "source_text": "空空如也虽然轻松，但有时也会想要填满它呢。",
      "source_fingerprint": "8e3ce3647a6cb528848d33f30e6fa6c8f6a8af93b0d47ec0962239aa07ca16e0",
      "source_path": "text_data_dict.json",
      "json_path": [
