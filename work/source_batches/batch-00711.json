    {
      "uid": "zhcn:ddf1cbd6acdb7cbd61033bbb",
      "kind": "text_data",
      "source_text": "\\n　　情人节快乐　v（^_^）v\\n\\n　　　表达我平日的感谢。\\n　　　今后也拜托你了。",
      "source_fingerprint": "b01630b4243eeb4960fff44dc5a57c513ab8ada8b9b282f8442ee350403c2be5",
