    {
      "uid": "zhcn:d70f29b371a47dca9fda4d00",
      "kind": "text_data",
      "source_text": "这是准备用在粉丝活动上的曲奇的试制品。\\n因为想将味道改良到最佳，请务必给出您的意见。\\n我觉得如果有训练员的帮助的话，\\n一定能够调整的更好。\\n请多指教！",
      "source_fingerprint": "d779c6a4a020ac70a92e8a94c2d6f0b147c6b167ffb71217bdb6b9263ecbe4e6",
      "source_path": "text_data_dict.json",
