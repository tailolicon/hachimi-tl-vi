      "source_path": "text_data_dict.json",
      "json_path": [
        "262",
        "1011"
      ]
    },
    {
      "uid": "zhcn:dc6b7ecda2c70c8849248b83",
      "kind": "text_data",
      "source_text": "看到别人的奇怪行为不会再像以前一样大惊小怪了",
