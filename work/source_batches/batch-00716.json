      "json_path": [
        "262",
        "1013"
      ]
    },
    {
      "uid": "zhcn:e8021a9bdcb3555013d1cb6f",
      "kind": "text_data",
      "source_text": "自己拍摄的各地拉面店招牌暖帘的照片",
