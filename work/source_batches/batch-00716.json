      "source_path": "text_data_dict.json",
      "json_path": [
        "262",
        "1007"
      ]
    },
    {
      "uid": "zhcn:ed7d304d8a85059fae9593f7",
      "kind": "text_data",
      "source_text": "在老家的牧场里，很受羊群的喜欢",
