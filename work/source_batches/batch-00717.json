    {
      "uid": "zhcn:9d890ff327b5da715e9a7608",
      "kind": "text_data",
      "source_text": "辛苦了！\\n我对训练员满怀报恩谢德之心，\\n所以准备了这个。\\n你我之间，可谓是一莲托生。\\n希望彼此都要注意健康，一起努力！",
      "source_fingerprint": "f7e2c9c6cbef769c2bd0a333b8db66e287383c045293d53f56111866e886b1d2",
      "source_path": "text_data_dict.json",
