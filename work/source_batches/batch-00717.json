    },
    {
      "uid": "zhcn:946f90a587a0dee6aaad1c3f",
      "kind": "text_data",
      "source_text": "我　的训练员不怎么生气！\\n想　这句想不出来！\\n感　觉训练员很努力！\\n谢　谢善待三涡轮！\\n你　快吃吧！很好吃！",
      "source_fingerprint": "a1b5a90d12ed1f873a6115a46db2ee516360467f3add1bba3a8b6a35593d0fe3",
      "source_path": "text_data_dict.json",
