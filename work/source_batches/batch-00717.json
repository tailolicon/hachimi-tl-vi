    },
    {
      "uid": "zhcn:20bdcb11f3519c12e3e94fdd",
      "kind": "text_data",
      "source_text": "今后我也想与训练员合为两轮，\\n朝着目标共同努力。\\n今后还请多多指教、多多鞭策。\\n\\nP.S. 重点是可爱的三股辫。",
      "source_fingerprint": "be6635b1d48700c2638e2f53feafede6e53b858e6ce6e9547f689acb3d7d1aeb",
      "source_path": "text_data_dict.json",
