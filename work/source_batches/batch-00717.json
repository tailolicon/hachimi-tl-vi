      ]
    },
    {
      "uid": "zhcn:aa6ad5cd182f1d56efa2afbf",
      "kind": "text_data",
      "source_text": "致训练员\\n如果你能读到这封信的话，\\n那就说明我做的蛋糕还是赶上了吧。\\n这是我怀着平日的感谢之情所做成的。\\n请慢慢地，尽情品尝。",
      "source_fingerprint": "4dff6fd95f9f2464f66665a483398b62aea1beb9228fde007cbf0121619a4128",
      "source_path": "text_data_dict.json",
