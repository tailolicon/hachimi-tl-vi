      "json_path": [
        "262",
        "1022"
      ]
    },
    {
      "uid": "zhcn:1528abb50bb17477392708fa",
      "kind": "text_data",
      "source_text": "被任命去做的事没有无法胜任的",
      "source_fingerprint": "efcd02a716ad51df249b787f029f2996a6585ff2bca6417da62be095a02ae79b",
