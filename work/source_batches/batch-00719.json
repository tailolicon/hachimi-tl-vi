      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1104"
      ]
    },
    {
      "uid": "zhcn:792684b643a216e6368c1cf5",
      "kind": "text_data",
      "source_text": "『相信』“同调”",
