      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1099"
      ]
    },
    {
      "uid": "zhcn:5a2b0f3961cbb5693c4c7311",
      "kind": "text_data",
      "source_text": "为避免走形，会调整决胜服的腰围",
