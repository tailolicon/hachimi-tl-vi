      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1091"
      ]
    },
    {
      "uid": "zhcn:e1e291c4b3d7368b73f5f0cb",
      "kind": "text_data",
      "source_text": "走出休息室前会说『谢谢』",
