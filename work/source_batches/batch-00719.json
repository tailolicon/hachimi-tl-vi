      "source_path": "text_data_dict.json",
      "json_path": [
        "260",
        "1094"
      ]
    },
    {
      "uid": "zhcn:d90affc3f5b2d715b700085e",
      "kind": "text_data",
      "source_text": "从应援歌中获取快乐☆",
