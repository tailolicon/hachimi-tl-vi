      "uid": "zhcn:eef1aed502ebf54e63eef91c",
      "kind": "text_data",
      "source_text": "你只有一种选择。\\n明白了吗？",
      "source_fingerprint": "bb8e3999cef8abe30a1047b7718bd3f1f8b2ff2a5508920000b510cad0f911ab",
