    {
      "uid": "zhcn:99e24073325fa890192c0f9c",
      "kind": "text_data",
      "source_text": "训练员阁下\\n这是怀着平日的感谢之情，\\n向祖母学习后所做成的一味。\\n请好好享用吧。\\n附言：这个小碟子是祖父他送给你的礼物",
      "source_fingerprint": "995060787a7f9cc20b5148fe7d4e02df074e4b11d0d75b4db303232dcba46c8d",
      "source_path": "text_data_dict.json",
