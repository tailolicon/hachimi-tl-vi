        "100"
      ]
    },
    {
      "uid": "zhcn:bccf55a52083f198ec50e885",
      "kind": "text_data",
      "source_text": "获得了英雄技能的比赛\\n比赛结果似乎比平常更值得期待呢！",
      "source_fingerprint": "a6991746ae269cbf40b6b58f688eebdd8f8ce002d0aff629afa2bbfb25b2fab9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "297",
        "101"
      ]
    },
    {
      "uid": "zhcn:4d60ba8fee721999878558a2",
      "kind": "text_data",
      "source_text": "有英雄技能需通过使用比赛专用道具\\n来满足生效条件！",
      "source_fingerprint": "f3138e90f7b1f416111d7dc1136c3ba8637bee843ac9c40fc047f70fa2ead280",
      "source_path": "text_data_dict.json",
      "json_path": [
        "297",
        "102"
      ]
    },
    {
      "uid": "zhcn:427097fa1de2b7b11b4f19a0",
      "kind": "text_data",
      "source_text": "还差一点儿英雄量表就达到MAX了呢！",
