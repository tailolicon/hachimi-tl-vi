    },
    {
      "uid": "zhcn:48faa9c1b0638f4481363749",
      "kind": "text_data",
      "source_text": "高松宫纪念",
      "source_fingerprint": "23280cfccf83dffc3cfb731bb59a7f783fa4a0ef2d61a8908530b75ccc7b1cb7",
      "source_path": "text_data_dict.json",
