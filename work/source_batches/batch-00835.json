    {
      "uid": "zhcn:29602c616b989c86b95798bf",
      "kind": "text_data",
      "source_text": "URA总决赛决赛",
      "source_fingerprint": "41563c2c6d1ff5bbc135cd0280c07330b9ba10cfb67fb04d6d7f5512ea1f82c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "32",
        "9999"
      ]
    },
    {
      "uid": "zhcn:145e0056d9126a307350e020",
      "kind": "text_data",
      "source_text": "我所寻求的，是具有毅力的赛马娘。\\n……拜托了。",
      "source_fingerprint": "634a67d58f9aa8583e68deeedc1344b1732bc9743759d0c59d2832f9226b8c5b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100101"
      ]
    },
    {
      "uid": "zhcn:aa20fe98bb12935bdc3f7b4b",
      "kind": "text_data",
      "source_text": "正在寻找对力量有自信的赛马娘。",
      "source_fingerprint": "c5c4e54536c462e3f05bfbb76983b68466fe37b1ce2aec0f1a82a26a3fb0e99f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100102"
      ]
    },
    {
      "uid": "zhcn:aa7645bd537da2659b45d7f5",
      "kind": "text_data",
      "source_text": "正在寻找有耐力的赛马娘。",
      "source_fingerprint": "e51fa753eecd26f3ae13af531c15d9188eed28fc906090db49371142eff3aacc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100103"
      ]
    },
    {
      "uid": "zhcn:d92047ccf745e334741f4bb3",
      "kind": "text_data",
      "source_text": "正在寻找擅长用长腿跑步的赛马娘！\\n我很期待您的才干。",
      "source_fingerprint": "0247dd94319ea0fa22f0e8d0ab53c10b7d310d5a9af9f70931ce01118f05f2e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100201"
      ]
    },
    {
      "uid": "zhcn:7406676816b81253e1287fad",
      "kind": "text_data",
      "source_text": "正在寻找对速度有自信的赛马娘。",
      "source_fingerprint": "69a4cd9b4f751f0d2d38a7b208dd36a5d0fbd3b513094a8cccbb1faf5343542d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100202"
      ]
    },
    {
      "uid": "zhcn:c1c9c47d2562db51dd7fad3d",
      "kind": "text_data",
      "source_text": "正在寻找聪明的赛马娘。",
      "source_fingerprint": "721c8a6fe75086f7b25aaa103aa2bb41d93835777cf321c148c1ce846dfe6ca8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100203"
      ]
    },
    {
      "uid": "zhcn:33d0a998fd789a203197feaa",
      "kind": "text_data",
      "source_text": "能够在终盘展现出具有瞬间爆发力的跑法……\\n希望这样的赛马娘一定要加入我的队伍。",
      "source_fingerprint": "e5a5a9ee27bc0588f9a11285bd8999840e9640d7be0cb97b2112c12acd422a79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100301"
      ]
    },
    {
      "uid": "zhcn:d6fb931ef34f142946d1dd9f",
      "kind": "text_data",
      "source_text": "正在寻找对坚强韧性有自信的赛马娘。",
      "source_fingerprint": "63409d875b1cc6130d2c9544d4992ca1662db4e33f21a0fe867117aefe889b70",
      "source_path": "text_data_dict.json",
      "json_path": [
        "320",
        "100302"
      ]
    },
    {
      "uid": "zhcn:d30f8696fe2c83455c83d960",
      "kind": "text_data",
      "source_text": "正在寻找有速度的赛马娘。",
      "source_fingerprint": "29441e83ee4bd3e20dd7530da716fb3ed22d028915c9373c871a91b46170a7d7",
      "source_path": "text_data_dict.json",
