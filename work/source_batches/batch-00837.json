        "100102"
      ]
    },
    {
      "uid": "zhcn:aa7645bd537da2659b45d7f5",
      "kind": "text_data",
      "source_text": "正在寻找有耐力的赛马娘。",
      "source_fingerprint": "e51fa753eecd26f3ae13af531c15d9188eed28fc906090db49371142eff3aacc",
      "source_path": "text_data_dict.json",
