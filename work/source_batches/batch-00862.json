      "kind": "text_data",
      "source_text": "主题：<jobs_placename>\\n顺利结束。回学园了。",
      "source_fingerprint": "0f7aa4be9b12327cebef9ef5881ea2ba63a201ab235921e45cbb6a2fd3f26ddc",
      "source_path": "text_data_dict.json",
