    {
      "uid": "zhcn:3ff65a0a35492e06dde208f1",
      "kind": "text_data",
      "source_text": "当亲友条达到MAX并一起进行友情训练时，<color=#ff911c>亲友条将重置</color>，\\n并且<color=#ff911c>亲友Lv将上升</color>",
