    {
      "uid": "zhcn:7c44239381456ff48798b298",
      "kind": "text_data",
      "source_text": "技能Pt的训练效果提升 <color=#ff6d26>100%</color>",
      "source_fingerprint": "0b2293b62fecabc4b794ee84ea534e31b5af28f966caeae29fd4a89c352cf3c3",
      "source_path": "text_data_dict.json",
      "json_path": [
