  "entries": [
    {
      "uid": "zhcn:19c538c94be559453e2e07d0",
      "kind": "text_data",
      "source_text": "猪背脂大葱拉面",
      "source_fingerprint": "657be9d4a3b3a12d3abf51f777d428d4d49ff3ad59c1666908f4280af914fb7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "459",
        "8"
      ]
    },
    {
      "uid": "zhcn:94bb8d290345d1e68b795ba3",
      "kind": "text_data",
      "source_text": "甜口酱油拉面",
      "source_fingerprint": "56e2c4d3452438a73133865137704deeb1db144f6208cf3f5358a7c6aea6b171",
      "source_path": "text_data_dict.json",
      "json_path": [
        "459",
        "9"
      ]
    },
    {
      "uid": "zhcn:095d671540fc9bd1c440646e",
      "kind": "text_data",
      "source_text": "特别特雷森拉面",
      "source_fingerprint": "f78a73c0be50f95c25500f355e8d7315f4cb8113439e29797a8ccd9f4a82818d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "460",
        "1"
      ]
    },
    {
      "uid": "zhcn:e62b060f2fa012ed4e12abd1",
      "kind": "text_data",
      "source_text": "大满足特雷森拉面",
      "source_fingerprint": "82ac29ca18ee5837c3ea0a933deeaa93aec929953145fc33895bba54d925c371",
      "source_path": "text_data_dict.json",
      "json_path": [
        "460",
        "2"
      ]
    },
    {
      "uid": "zhcn:3eb80861040adc020aa4c644",
      "kind": "text_data",
      "source_text": "极品特雷森拉面",
      "source_fingerprint": "f58ddef9a99fbcbecf8c2901d0c99e012fbc99f26be694379200d1e3364b83f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "460",
        "3"
      ]
    },
    {
      "uid": "zhcn:87f6687d36b6714f20e8f72b",
      "kind": "text_data",
      "source_text": "拉面嘉年华",
      "source_fingerprint": "b717e5841539f2f18d1fa5a853004d4cac3f119a3c1d40b56cac4c5cc0ac7330",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "1"
      ]
    },
    {
      "uid": "zhcn:0945bf972f3a6eeaa3dabefc",
      "kind": "text_data",
      "source_text": "以正宗拉面令粉丝着迷",
      "source_fingerprint": "8c50e8f52aff5cabb5c7acee0b523b1f712c871c7ca7ccf2404ddb706b1ea8df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "10"
      ]
    },
    {
      "uid": "zhcn:909555758dcd26804c70244f",
      "kind": "text_data",
      "source_text": "在特雷森轩的招牌下，拉面嘉年华于<region_name>举办！",
      "source_fingerprint": "25d156e4730fd7608a4a03bb83f563dabbaafc1bbe0065713fe58c4df6c9eaee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "100"
      ]
    },
    {
      "uid": "zhcn:ff40a1f3559b9559f0911d56",
      "kind": "text_data",
      "source_text": "为了向各地款待拉面，特雷森轩于<region_name>特别开店！",
      "source_fingerprint": "4f52ba594d87c5b30fc70fdcb498128d20019d0fa440493bfa5e35e7059b47cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "101"
      ]
    },
    {
      "uid": "zhcn:8f16a1a87bf719bf3af55a53",
      "kind": "text_data",
      "source_text": "<character_name>等人款待手工拉面的活动，吸引了众多粉丝到场。",
      "source_fingerprint": "e7cfd8867c7f141c3eebc35f76584defa914ca63d86818f8eace55fde13dcada",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "102"
      ]
    },
    {
      "uid": "zhcn:b0edb946598322580d0a5404",
      "kind": "text_data",
      "source_text": "口味地道的拉面引发了巨大反响，在当地卷起了一股强大的拉面旋风。",
      "source_fingerprint": "206eebf41143cfeee9acb53455f07a5b597b0c172828f2c4025fba23c4f05a84",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "103"
      ]
    },
    {
      "uid": "zhcn:a67c8b8c31094e4d9aa646e7",
      "kind": "text_data",
      "source_text": "款待了亲手制作的<ramen_name>，向粉丝和当地人们传达了感谢。",
      "source_fingerprint": "6a3e7854b3c4e8aa10529cdfe6f3ba94f59beba808b41433b88bded207d67b1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "104"
      ]
    },
    {
      "uid": "zhcn:63452ddd2ad35441e2f60cd7",
      "kind": "text_data",
      "source_text": "施展在修行中磨炼的手艺，充满元气的招待与出色的<ramen_name>大受好评！",
      "source_fingerprint": "9306270b08e8868ec0d85018406e1b22613c9381c1a0a2a08ac723d0b9415db7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "105"
      ]
    },
    {
      "uid": "zhcn:f6e16b012a450c27381355cc",
      "kind": "text_data",
      "source_text": "作为四处品尝与试做成果的<ramen_name>，是连当地粉丝都拍胸脯保证的佳作。",
      "source_fingerprint": "a327ac126cb7ee01d3ac4bbc89c60d663a9c1f4bd10455db754e88d26552c085",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "106"
      ]
    },
    {
      "uid": "zhcn:e957aaeb9920536624b83c5c",
      "kind": "text_data",
      "source_text": "许多人为了品尝<ramen_name>而来，首次举办便让会场迎来了大盛况。",
      "source_fingerprint": "0127ef2cda0b98ed5e2b1a415cb52f7026098ab74a4c2a5649558403f3d70d88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "107"
      ]
    },
    {
      "uid": "zhcn:0d875d2ab3dbafa801b70744",
      "kind": "text_data",
      "source_text": "赛马娘们认真挑战的拉面引发了话题，达成了极高的动员人数。",
      "source_fingerprint": "382eb8c2cd0987d1322a3a73e99766cc0a03ae13c188f63aa500eee72c9de463",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "108"
      ]
    },
    {
      "uid": "zhcn:750db0d6feb49a747eab6807",
      "kind": "text_data",
      "source_text": "这碗旨在用拉面表达感谢、倾注了灵魂的拉面，让众多粉丝赞不绝口。",
      "source_fingerprint": "4f14740e321826a822a2dadbc5d3582602a6b1ed121fabfed9788e9f3389f68e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "109"
      ]
    },
    {
      "uid": "zhcn:1821f42267868559cacb2a0e",
      "kind": "text_data",
      "source_text": "<region_name>因众多来客而热闹非凡",
      "source_fingerprint": "f77bce5e28f1832be02ef3a7d59b994612d0e3555a80a674b9581cdcb4c0b7c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "11"
      ]
    },
    {
      "uid": "zhcn:d7e282a7871ac5e17c86d4d3",
      "kind": "text_data",
      "source_text": "对于满载讲究的<ramen_name>的正宗味道，惊叹之声连绵不绝。",
      "source_fingerprint": "2c7c900ec15e26e689f4602839054cfa3d1ae233771d7273b9dbc8813a2a4838",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "110"
      ]
    },
    {
      "uid": "zhcn:5d5de0f23a745993b8addbb6",
      "kind": "text_data",
      "source_text": "用精心制作的<ramen_name>，以干劲十足的首战装点了精彩的大盛况。",
      "source_fingerprint": "d07e41744cda242b760e7f34a7abace9be852fde3e5f0e4db0774c389bf8f837",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "111"
      ]
    },
    {
      "uid": "zhcn:952d33a063bdd833705a1aca",
      "kind": "text_data",
      "source_text": "以娴熟的烹饪和开朗的招待回应来客，全力款待了饱含感谢的拉面。",
      "source_fingerprint": "ecc4b02099236436f2e09d79bc92f459a4fb3613463282aa483446b4f08dfcfd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "112"
      ]
    },
    {
      "uid": "zhcn:5256565602ace2e4e1244ad6",
      "kind": "text_data",
      "source_text": "虽是崭新尝试的活动，却引发了热烈反响，完成了华丽的起跑冲刺。",
      "source_fingerprint": "707b24bd5a5ed32621c125c478e64b818dc0834bc4f24a6f37af1b0d85cae7ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "113"
      ]
    },
    {
      "uid": "zhcn:c9be6731b8e225445a1358dd",
      "kind": "text_data",
      "source_text": "以<ramen_name>为亮点的动员情况极佳，首次举办便达成了巨大的高潮！",
      "source_fingerprint": "3ded55b5b764d862d6252fe35a6466a356618a420375fd59d459d2063069d34f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "114"
      ]
    },
    {
      "uid": "zhcn:40fbb19cd945a555cd0ede3c",
      "kind": "text_data",
      "source_text": "从熬汤到甩干面汤，通过饱含热情的烹饪，向来场者送上了拉面。",
      "source_fingerprint": "30328021af32d7a3975865d332b6b3aa3fbed7289309a3db8fd774335ad2c090",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "115"
      ]
    },
    {
      "uid": "zhcn:7be8667e3feff2389c25d86a",
      "kind": "text_data",
      "source_text": "自家制的正宗拉面成为话题，这也成了与粉丝和当地人们加深交流的机会。",
      "source_fingerprint": "0e00fc504038ba2d905f3f9d7d783ef8c45e7b597519b731a04e995a517f1074",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "116"
      ]
    },
    {
      "uid": "zhcn:c869c5f514ed1f8ec814bf30",
      "kind": "text_data",
      "source_text": "赛马娘们亲自款待手工拉面的活动，在当地人们中也反响极佳。",
      "source_fingerprint": "3cdf7d0f90a5e3a0168548c510993326a62b237bf1fd44bd65c76031fa1f89d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "117"
      ]
    },
    {
      "uid": "zhcn:9d5df759d657f5b5b85f39b5",
      "kind": "text_data",
      "source_text": "向当地的粉丝款待了经过反复试做汤底、且食材十分讲究的拉面。",
      "source_fingerprint": "32ee77a7fa6c7614e59fef6b8b3736bc6c2bfea42a686c4f85b26f9fdaf5b471",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "118"
      ]
    },
    {
      "uid": "zhcn:b9b88f683005be5273ce9623",
      "kind": "text_data",
      "source_text": "看到品尝拉面的人们的笑容，特雷森轩全员似乎也重新振奋了精神。",
      "source_fingerprint": "aaa7da99036abd9248950e083e560a477f4db4d47c2eb88c9edfed942e67d067",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "119"
      ]
    },
    {
      "uid": "zhcn:21a938e7808292ce16dd6cc1",
      "kind": "text_data",
      "source_text": "首次举办便迎来大盛况！",
      "source_fingerprint": "f6fa627ce6446f87aae5efd093bb49a53b12d4f8c5bb6f91fbf902eadf673f19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "12"
      ]
    },
    {
      "uid": "zhcn:58abd8d1627d3a3355c3452f",
      "kind": "text_data",
      "source_text": "在超出预期的热烈气氛中，迎来了顺利的开局。",
      "source_fingerprint": "994a9a2300b051fb4ad0e02944ccc13057270f199c34b58f00900efa66df7696",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "120"
      ]
    },
    {
      "uid": "zhcn:bfb8b0b590a7a4948c6475b6",
      "kind": "text_data",
      "source_text": "特雷森轩今后的动向令人无法移开视线。",
      "source_fingerprint": "3f5e7644b350236f97615974560204ad1b7877a6c5854998ab39106321b84de5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "121"
      ]
    },
    {
      "uid": "zhcn:345bcfeb1ebc789a9b8e061a",
      "kind": "text_data",
      "source_text": "对下次举办的期待也越来越高。特雷森轩的跃进值得关注。",
      "source_fingerprint": "0f6effe6ed32a1c290494d0912c47f0d1ed86925d23ff78e1c0c7dff09834cde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "122"
      ]
    },
    {
      "uid": "zhcn:d2a0876e8c5dbe07a8bcf6d1",
      "kind": "text_data",
      "source_text": "会场的活力直到最后都未衰退，成为了一场满意度极高的活动。",
      "source_fingerprint": "d2be7a4dcc72fa82de4bd8380762c440cab7fcc6959cea2ee6f9fcd8a9c899c6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "123"
      ]
    },
    {
      "uid": "zhcn:bd6e37b6145576f7dc52fdf2",
      "kind": "text_data",
      "source_text": "笑容与欢呼声交织，成为了一场留下舒适余韵的活动。",
      "source_fingerprint": "70a5d368f54f1cd7f53baf22025304661c4cd798b5543b7291803f8b5b5657e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "124"
      ]
    },
    {
      "uid": "zhcn:45ad881abc788bc752961d32",
      "kind": "text_data",
      "source_text": "人们已经迫不及待地期盼下次举办了。对特雷森轩的未来充满期待！",
      "source_fingerprint": "96b1c6850705e29a05c25e4cd1e167cf8e49e0cb0c01c2b9723c822d57673504",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "125"
      ]
    },
    {
      "uid": "zhcn:21bfdd2934f2ba36abcdb461",
      "kind": "text_data",
      "source_text": "期待今后通过美味与粉丝交流的范围能进一步扩大。",
      "source_fingerprint": "4682597f0f94dc6e26883c532e666c290f53df4c28ee3ce1e02b422d36299b27",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "126"
      ]
    },
    {
      "uid": "zhcn:97988cb1e052a21210c8adfc",
      "kind": "text_data",
      "source_text": "今后的举办动向，也希望通过后续报道传达。",
      "source_fingerprint": "4810b2d844fc04488734c7cd957fd69a85c078f17e74e99746bd3096783884f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "127"
      ]
    },
    {
      "uid": "zhcn:a82d072777d60571f7193f0c",
      "kind": "text_data",
      "source_text": "刚刚起跑的特雷森轩。期待其今后的活跃表现。",
      "source_fingerprint": "23021c3ce04ef8297bca2008e8b3e4d4a5ded23c7c664cbaff9a82114d46ca92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "128"
      ]
    },
    {
      "uid": "zhcn:2fd05ba4864131927cd4c773",
      "kind": "text_data",
      "source_text": "热情与热气包围了会场，成为了一场充满活力的活动。",
      "source_fingerprint": "676b10dbdc7a17f36a490bd8bbb18856926aabbf1996b6da5cac2e2da3bf136e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "129"
      ]
    },
    {
      "uid": "zhcn:c243afa838482687f6b37acd",
      "kind": "text_data",
      "source_text": "<region_name>的粉丝对这注入灵魂的一碗赞不绝口",
      "source_fingerprint": "59068c6c9c6ec30fddd4836cbfcc32656a86848975e3d69f310c0bba3b433527",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "13"
      ]
    },
    {
      "uid": "zhcn:e8c09ce1235a79648648655a",
      "kind": "text_data",
      "source_text": "赛马娘们传达感谢的拉面嘉年华第2届举办了！",
      "source_fingerprint": "6df6b591f4a2bbddae82fcc1292c9a0723cf472b166cd9161e036c84667eb664",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "130"
      ]
    },
    {
      "uid": "zhcn:769b8a9aac616d2c9009d741",
      "kind": "text_data",
      "source_text": "赛马娘们举办的拉面活动，得到进一步强化后再次到来！",
      "source_fingerprint": "bc595b68e74accb816d20d9263e1a6839f6e98263f323ec60d1848dacdf2986b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "131"
      ]
    },
    {
      "uid": "zhcn:fc7276da24896a1f87d8b5f7",
      "kind": "text_data",
      "source_text": "上次引发巨大反响的拉面嘉年华回来了！",
      "source_fingerprint": "b75578144cfc1509c59d56c4258f1ed409219ada5a00ad71ac22599daf30fd01",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "132"
      ]
    },
    {
      "uid": "zhcn:24c231c98ed307cd081d60f8",
      "kind": "text_data",
      "source_text": "众所期盼重新举办的拉面嘉年华，这次于<region_name>举办！",
      "source_fingerprint": "7cd71be2f1fc05ad0689b3f6bc8c2645c53c4ea2701643b960294474cda3fd2a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "133"
      ]
    },
    {
      "uid": "zhcn:c9b3a15f188716a2b2123039",
      "kind": "text_data",
      "source_text": "引发巨大话题的特雷森轩，将<region_name>作为新舞台出战！",
      "source_fingerprint": "342c8245e9dd9de178555264297e78c2fac988cfe77a9494cf323f1f0d77e4f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "134"
      ]
    },
    {
      "uid": "zhcn:567cf956028fd0f59e3c8c9f",
      "kind": "text_data",
      "source_text": "回应粉丝的期待，特雷森轩的大型活动再次举办！",
      "source_fingerprint": "5a2445a9741f34f1d74d7632108b82f35c02fcce847ee2b179c60b38da8ba467",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "135"
      ]
    },
    {
      "uid": "zhcn:185ababf24f3fafd494b3894",
      "kind": "text_data",
      "source_text": "为了品尝成长后的<character_name>等人的新作拉面，会场一整天都排着长队。",
      "source_fingerprint": "4b1f5fe9698a6455d4e6be3d4d3cc5bb43882d8ce16f6e5ea4f7f947cd0bd79e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "136"
      ]
    },
    {
      "uid": "zhcn:5e7d982e29da0372463cde5b",
      "kind": "text_data",
      "source_text": "会场一整天大排长龙，对这碗倾尽全力的<ramen_name>，直呼绝品的声音蜂拥而至！",
      "source_fingerprint": "a19e17bfd38ea40d30a950b5794ff6ff0a657d4bf1ffe92f88c92d8cf72b3815",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "137"
      ]
    },
    {
      "uid": "zhcn:51af4d0ead8c10c8e15d56ed",
      "kind": "text_data",
      "source_text": "<ramen_name>那彰显细致准备的匠心出品，在来场者中也大受好评！",
      "source_fingerprint": "5af68975c2862f821727d80940453bd2bf57b9944d2f5d2b7078bf12ecaa630e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "138"
      ]
    },
    {
      "uid": "zhcn:aa42240819cf415d295b0e83",
      "kind": "text_data",
      "source_text": "会场动员人数超越上次，对大显身手制作的拉面，当地的粉丝也大满足！",
      "source_fingerprint": "6fed12139b03f39f5620aad2ece44e421cec7b95caa6fe143f43ce0e03b35fd3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "139"
      ]
    },
    {
      "uid": "zhcn:9724c0922e74e884961c2388",
      "kind": "text_data",
      "source_text": "对讲究的美味充满自信！",
      "source_fingerprint": "4d374aad32b922735446a445f942dc81554d9abfa92b633fdf7028c93b2213de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "14"
      ]
    },
    {
      "uid": "zhcn:3f72e5694c95659ed55ae2dc",
      "kind": "text_data",
      "source_text": "用满载当地食材的<ramen_name>款待，热情招待了粉丝。",
      "source_fingerprint": "afad8e004d98451945f0c86ad19b64119334854353b940300344172196d4a106",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "140"
      ]
    },
    {
      "uid": "zhcn:eed5bc0e4b2e5cf02acbf31e",
      "kind": "text_data",
      "source_text": "拉面的出品被评价为醇厚感与爽口度都有所提升，创下了历史最高的提供数记录！",
      "source_fingerprint": "22813bed780274349551085e2d6eea4cdfaa8301f37d5a022bbd58ba273914e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "141"
      ]
    },
    {
      "uid": "zhcn:f737271751dc793135fdc722",
      "kind": "text_data",
      "source_text": "比上次更加讲究汤底和配料的这一碗，被多数人绝赞这才是美味的最前线！",
      "source_fingerprint": "4d10aa35571903ea735a4899a6ccb72d91a7b1d639a2a5be1c81ab6b231391d5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "142"
      ]
    },
    {
      "uid": "zhcn:bcfed1458faa093c65ba1cef",
      "kind": "text_data",
      "source_text": "反复钻研的这一碗美味毫不动摇，在提供速度与味道上的两全其美赢得了赞赏。",
      "source_fingerprint": "fca6968f75106921ad07d3df4d0b5a784bbafb3a67c97394a20046821fd57e2d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "143"
      ]
    },
    {
      "uid": "zhcn:03da8adf0c8de28360b54ab8",
      "kind": "text_data",
      "source_text": "汤底的鲜味与甩面汤的精准度展现了特训的成果，是尝一口就能体会到进化的佳品。",
      "source_fingerprint": "436e6882d03234c584be514bf927c57d84f70d96ee8f13f27b06b619a0f7f440",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "144"
      ]
    },
    {
      "uid": "zhcn:4e5a7716eb3dda8e60819027",
      "kind": "text_data",
      "source_text": "经过巡回名店修行打造的<ramen_name>，成为了让人切实感受到成长的一碗。",
      "source_fingerprint": "b703f9fddd08310a94c8697f769237f111072e43f097245c95eace49d4f459b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "145"
      ]
    },
    {
      "uid": "zhcn:9dec3267dc31c2df7e3a5e02",
      "kind": "text_data",
      "source_text": "为了新作拉面，许多回头客也纷纷造访，会场卷入了超越上次的狂热旋涡中！",
      "source_fingerprint": "c311d84126a2fed94457c243f64c0bc22bf5c4675dcc1e15e858e639bd5093cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "146"
      ]
    },
    {
      "uid": "zhcn:df297a036002540596b2ad89",
      "kind": "text_data",
      "source_text": "温暖人心的美味拉面加深了与粉丝的牵绊，会场因笑容与活力而焕发光彩。",
      "source_fingerprint": "5e397d87f7ee71473ad3530e0b783bfe3f4f2b5e6a17d37eb4bc86056fb81ac0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "147"
      ]
    },
    {
      "uid": "zhcn:775ac4a2767fd1eff916f9fc",
      "kind": "text_data",
      "source_text": "飘散在会场的芳醇汤底香气吸引了客流，迎来了座无虚席的热闹场面。",
      "source_fingerprint": "714c74b7e098e0e1adf9cc7985659e6403fc07c6990399768944f7bba4b040b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "148"
      ]
    },
    {
      "uid": "zhcn:e1663f438a52e3e588f7119f",
      "kind": "text_data",
      "source_text": "对于再次举办意气风发的特雷森轩全员，向粉丝们献上了精益求精的美味。",
      "source_fingerprint": "e7805206f67429f591777a6168c43b9d47f3f9e8d8f49b03785eb12d92c0aa18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "149"
      ]
    },
    {
      "uid": "zhcn:e48c9e478f6a596999e63712",
      "kind": "text_data",
      "source_text": "干劲十足地开幕",
      "source_fingerprint": "c9dab7c59d34273f553bd8f81c7a0877caad485e62de3946024141a7f7789883",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "15"
      ]
    },
    {
      "uid": "zhcn:dcfff192078acf00e8378277",
      "kind": "text_data",
      "source_text": "为了用全新的拉面回应粉丝的期待，特雷森轩的成员们大显身手。",
      "source_fingerprint": "fcc56ccc67de4f1064993b24f2791a9f21e07f42c66ada6b3a4e69c04e1aa7be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "150"
      ]
    },
    {
      "uid": "zhcn:4dd8ac009ebf9ca144bbfe02",
      "kind": "text_data",
      "source_text": "继上次之后，这场通过拉面传递美味与真心的活动唤起了许多笑容。",
      "source_fingerprint": "536b35a50fac109acfcfae0113262e6a8b2b98d44cae74e8994a480c2300a985",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "151"
      ]
    },
    {
      "uid": "zhcn:e5ab09ceaac42c5a13fb2035",
      "kind": "text_data",
      "source_text": "令人舒适的招待和渗入冰冷身体的滋味广受好评，会场始终洋溢着开朗的气氛。",
      "source_fingerprint": "2465779543fe320203b25c30f747dfe5d4f7538b650ee717e9c00dcaf6ec1158",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "152"
      ]
    },
    {
      "uid": "zhcn:03f9ba3a2437664b73946bff",
      "kind": "text_data",
      "source_text": "将积累的学习成果融入拉面，一碗一碗地提供，其真挚的运营方式获得了好评。",
      "source_fingerprint": "f21dd2df09f92f0a9f0d9c5943bd4b0a7bbd320c7f51b361b13d74df873f12b5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "153"
      ]
    },
    {
      "uid": "zhcn:df853ddd544de920736d7bba",
      "kind": "text_data",
      "source_text": "特雷森轩势头愈发强劲，让人对其接下来的挑战充满期待。",
      "source_fingerprint": "dc4cdc2515186980289b13d52de8595728ec991de30fcb99db6ebbaa4c629d91",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "154"
      ]
    },
    {
      "uid": "zhcn:c852ad9dea50ac74e0ac6923",
      "kind": "text_data",
      "source_text": "希望下次也能通过拉面带来令人心潮澎湃的体验。",
      "source_fingerprint": "8713362e12e0d72aa4c72fcbf8da08297ec48df9266086dad8fbc156c8e80422",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "155"
      ]
    },
    {
      "uid": "zhcn:5f38cfbfa74f288da4602a0a",
      "kind": "text_data",
      "source_text": "特雷森轩的历史上，又刻下了辉煌的记录。",
      "source_fingerprint": "66445bd3bd2f7e7474702924cc9e207a1a1debef1e58a9ed201d0ab3f97ffaed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "156"
      ]
    },
    {
      "uid": "zhcn:6273b88db064a28926abb41d",
      "kind": "text_data",
      "source_text": "通过拉面的交流，成为了一场留下温暖余韵的活动。",
      "source_fingerprint": "bd98798a80cfa1a9feb201e903bf10a7dd5c8b24a0583e5e7eb8ec40a5afd92c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "157"
      ]
    },
    {
      "uid": "zhcn:5270aa0e3ab13d8134a5a607",
      "kind": "text_data",
      "source_text": "这场罕见的活动，想必会永远留在来场者的心中吧。",
      "source_fingerprint": "b84bb99e4859c3a6ba8873fc846738c89ea4e5506aae80be70bf7d93c4c57da8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "158"
      ]
    },
    {
      "uid": "zhcn:88b2feca229bffde8376dca0",
      "kind": "text_data",
      "source_text": "以出色的手艺展现切实的成长，成为了一场精彩绝伦的活动。",
      "source_fingerprint": "c237bf853af46f5bdec042c469472c1b759e7bfc4c2ff160c953b8e0b6c57156",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "159"
      ]
    },
    {
      "uid": "zhcn:00222f0270ae8dabe79da3f9",
      "kind": "text_data",
      "source_text": "元气满满地全力提供！",
      "source_fingerprint": "12a14246b1b1fdc3f393ae044939de99f55f827dc8ab6ccde8cf8893dbf3b294",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "16"
      ]
    },
    {
      "uid": "zhcn:2525f351a6b5f71f95bf2103",
      "kind": "text_data",
      "source_text": "希望继续关注特雷森轩今后的步伐。",
      "source_fingerprint": "e502305c034242bad7b3c02598de8a9db846ff6d96177676c077416a9aee75c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "160"
      ]
    },
    {
      "uid": "zhcn:5a94d29a0783d1dd21b25b34",
      "kind": "text_data",
      "source_text": "不断扩大活跃舞台的特雷森轩，期待他们的下一碗拉面。",
      "source_fingerprint": "0fd4af04ee2eb7a4d007dff9b475b61d9d1892c828857c44ac2819a7effbfd88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "161"
      ]
    },
    {
      "uid": "zhcn:3f26b97906e1e83058b364a3",
      "kind": "text_data",
      "source_text": "希望今后也能继续守望着由拉面连接起的真心之环。",
      "source_fingerprint": "60ff05319db50f964e5e39c85274a7d18428fcbeceb7867ee8fcbc6a6d7f7844",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "162"
      ]
    },
    {
      "uid": "zhcn:66e4fd74f00ea2e15ec7f791",
      "kind": "text_data",
      "source_text": "因对拉面的热情而充满活力，成为了一场顺利举办的第2届活动。",
      "source_fingerprint": "7ef7ff6f4834986a7c6853470e987ebdb4bf2c61fa61e5242c84c8635669198d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "163"
      ]
    },
    {
      "uid": "zhcn:12fc03a41266043b2c1e53d5",
      "kind": "text_data",
      "source_text": "迎来集大成的第3届『超拉面嘉年华极』举办了！",
      "source_fingerprint": "930f8af3ec75ae19ef483497c70098a5cac6a4bcb1296e51344cfe01df67c4aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "164"
      ]
    },
    {
      "uid": "zhcn:993bfd2f4dee5ee6180fcb33",
      "kind": "text_data",
      "source_text": "特雷森轩以全国的赛场为舞台，毅然举办了超重量级活动！",
      "source_fingerprint": "02fd719bb8dbae1ab67587747c813da3b6e0a7455cd9e8ac82edb09acd4168a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "165"
      ]
    },
    {
      "uid": "zhcn:c2dc8bae7a96aa3528849c6a",
      "kind": "text_data",
      "source_text": "史上最大规模的，超拉面嘉年华极于全国赛场出战！",
      "source_fingerprint": "1f9b82bc274bb6f0529ac9649518e0133aac73f11c6422d6715c5665dba6b22f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "166"
      ]
    }
  ]
}
