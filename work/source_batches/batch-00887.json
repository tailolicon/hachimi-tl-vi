{
  "schema_version": 1,
  "batch": 887,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:793552d35809e28e730b1dca",
      "kind": "text_data",
      "source_text": "纵贯日本列岛的巨大拉面祭典，终于在全国各地的赛场出战！",
      "source_fingerprint": "b9edb8564c58d4edd195a7e217724b7df283a7fe1259b47f25be72f644bd3904",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "167"
      ]
    },
    {
      "uid": "zhcn:0346dcb63e6321d6bb4848a5",
      "kind": "text_data",
      "source_text": "空前规模的超大型拉面活动终于举办了！",
      "source_fingerprint": "922ab675435ba24353ab91ae59cdc40cdae109ae2244e59dbbf5173fd8205bcf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "168"
      ]
    },
    {
      "uid": "zhcn:ca1d7b89b2a52fe6afdb02e0",
      "kind": "text_data",
      "source_text": "特雷森轩终于实现了全国同时举办的拉面祭典！",
      "source_fingerprint": "1b8dd6101f361406e6e0f6fa24e168b1c340e55d9bfc9773c2818b9c3c5b16a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "169"
      ]
    },
    {
      "uid": "zhcn:30a3726a0271b3c79d023a3b",
      "kind": "text_data",
      "source_text": "起跑冲刺大成功！",
      "source_fingerprint": "601a398e96611bc18359408a331af36abdc58bb5dea9ce8b8c6fad3f294c77a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "17"
      ]
    },
    {
      "uid": "zhcn:308c3fdb1fd0c6fecbfd54d3",
      "kind": "text_data",
      "source_text": "将可以说是<character_name>等人拉面之道集大成的一碗，广为告知了全国。",
      "source_fingerprint": "c65980cf37a6a979fb7277d8171038a885d6a948d33b38331db813dc106ffc1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "170"
      ]
    },
    {
      "uid": "zhcn:05f3a5d294c36fc337ca25b4",
      "kind": "text_data",
      "source_text": "为了传达最高的感谢而制作的<ramen_name>，其完成度堪称至高。",
      "source_fingerprint": "716a6fcf7a52b2ae1450fbc2a14ad693bac84ed742fb80ba8870cf092a798d60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "171"
      ]
    },
    {
      "uid": "zhcn:e98f76277c52239034ef8092",
      "kind": "text_data",
      "source_text": "作为拉面旅途上筑起的所有终点的一碗拉面，也迎来了全国各地粉丝如潮的绝赞！",
      "source_fingerprint": "94c05f5b1e5002a4e38d26e42318dbcd1e150e3f0cfb64fceba8be9c89c0405a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "172"
      ]
    },
    {
      "uid": "zhcn:89bd01271a722a7893dd67a4",
      "kind": "text_data",
      "source_text": "怀着味道和接待都要全马力全开的干劲去挑战，全力跑完了这个最高级别的舞台。",
      "source_fingerprint": "924cbeab5e193720bcd0e3c86156947af2eeb3f5b00c9a28c49e371b4b53264b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "173"
      ]
    },
    {
      "uid": "zhcn:6e47fd92e2568699e03bf99d",
      "kind": "text_data",
      "source_text": "通过味道和毫无妥协的服务全力提供的拉面，来场者的满意度也刷新了历史最高记录！",
      "source_fingerprint": "86bca9e2eff75cc1f7ebf85592cecb55808dd41375c3055c14829e3e1c31b8ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "174"
      ]
    },
    {
      "uid": "zhcn:091440a248186b3d9e103ff8",
      "kind": "text_data",
      "source_text": "全国各会场从早上起就排起了长龙，这碗倾尽全力的<ramen_name>也引发了巨大反响！",
      "source_fingerprint": "5aed893cded452f21750ae0c124672d2be7658c08cb5f1108ad4587c074d7d29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "175"
      ]
    },
    {
      "uid": "zhcn:34bd4637a4a617a71b29d2ca",
      "kind": "text_data",
      "source_text": "经过反复研究创造出的<ramen_name>，成了足以配得上传说的得意之作。",
      "source_fingerprint": "6d6cded414e3f613ff7aa1f494fb24c9f6774c125d6122c66d15c460de4e75d0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "176"
      ]
    },
    {
      "uid": "zhcn:4d0081ec75e306b039717ebc",
      "kind": "text_data",
      "source_text": "总动员了磨炼出的技术的究极一碗，以无比的美味让会场也随之沸腾。",
      "source_fingerprint": "4ac07b50f40a21a8a40805cbb8560beb5f4f1656161781e806a84da6da0e7d7e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "177"
      ]
    },
    {
      "uid": "zhcn:47652c656235817c40fc54c8",
      "kind": "text_data",
      "source_text": "对于体现了前所未有美味的这一碗，来场的粉丝们接连发出称赞之声。",
      "source_fingerprint": "96c649867fd831a77c009452c6366ba2c0ae484c05b1b0d14e22cf8b517fc4de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "178"
      ]
    },
    {
      "uid": "zhcn:dabbeb7fc5e2b0e95b67561e",
      "kind": "text_data",
      "source_text": "为了这倾注浑身气势制作的一碗拉面，粉丝们蜂拥而至，会场被空前的热气包围。",
      "source_fingerprint": "d54b67cd1b3674acbf27ac703e5d0dc0a5790c361853b5a93bc31e10c1c8b418",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "179"
      ]
    },
    {
      "uid": "zhcn:931f2b8e993a490f3c18c8e1",
      "kind": "text_data",
      "source_text": "开幕起便全马力开动！",
      "source_fingerprint": "ecd61584114f09ece897054aa91c988c401158a3163372e988e7a16d5fbdc1ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "18"
      ]
    },
    {
      "uid": "zhcn:a7583379c263a7f5066e1d99",
      "kind": "text_data",
      "source_text": "<ramen_name>以配得上最终章的完成度，创下了历史最高动员人数记录。",
      "source_fingerprint": "6a0d1048c92ab6abb8de8533eddd1ccecc670341ef743d7dddbbb9306115687d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "180"
      ]
    },
    {
      "uid": "zhcn:d4586d6c287b3631b3f3dd13",
      "kind": "text_data",
      "source_text": "倾注了所有感谢的<ramen_name>，在会场中扩散开了笑容的波纹。",
      "source_fingerprint": "06360b70640a089c6e946d4b7587ca980b1937daa33938b14faa7aa237fe3c0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "181"
      ]
    },
    {
      "uid": "zhcn:b1ac2793f0b9be96e9677c42",
      "kind": "text_data",
      "source_text": "钻研到最后所抵达的滋味格外特别，以最高规格的款待送上了这极上的一碗。",
      "source_fingerprint": "4e7d6574c37aab9a5bd8ead6330ea4e93000acbd1c8b6426f9982a29a42e62b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "182"
      ]
    },
    {
      "uid": "zhcn:f3c00d2dc98ad05159b31974",
      "kind": "text_data",
      "source_text": "用满载心意的拉面为众多来场者送上饱腹感，从反响来看也收获了十足的信心。",
      "source_fingerprint": "8a7ccf4dfc25c4a7ef68cfff5ef7c5676e827574b0436bdf198f19349165f2cf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "183"
      ]
    },
    {
      "uid": "zhcn:68e0f1075aee0f4f4ba16f7f",
      "kind": "text_data",
      "source_text": "以赛马娘们的热意为原动力，向全国的粉丝毫无保留地传达了感谢之情。",
      "source_fingerprint": "2de171c31bc5e7749d4acfcfb55cc446c08f96abee5cce1ae727c095b8a2feae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "184"
      ]
    },
    {
      "uid": "zhcn:71e6983f9f44a4a4869ea76e",
      "kind": "text_data",
      "source_text": "装满至今积累下的牵绊的一碗，为众多粉丝带来了满足与笑容。",
      "source_fingerprint": "61b4ebc2db0fb64eaf9febb9efc124e6070fa0c42f32d8e54bc8c24ecf0707ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "185"
      ]
    },
    {
      "uid": "zhcn:82a05e915f2cc17d4326dcf8",
      "kind": "text_data",
      "source_text": "全力完成的<ramen_name>博得好评，客流不断，呈现出一片盛况。",
      "source_fingerprint": "989b608cb4860a79bebb9ab91871f1c48720ac2a22160adda97c408dfa836a49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "186"
      ]
    },
    {
      "uid": "zhcn:465dfab9e71e4aaa59ab114d",
      "kind": "text_data",
      "source_text": "用集大成的拉面回应历代最多的动员人数，充满真心的美味在各地备受好评！",
      "source_fingerprint": "2e04f9122a4004b2abd1ca883b7637f40ffec65a924c68694e70c530bc053a0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "187"
      ]
    },
    {
      "uid": "zhcn:b4e071ff6d0dd29ba9b5fe4b",
      "kind": "text_data",
      "source_text": "在拉面史上留下蹄迹，迎来了堂堂正正的落幕。",
      "source_fingerprint": "66e76ef19a259c7ab2d9ea23ad2cff81e297c7bd770f0cf3ba3a87a785be1afa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "188"
      ]
    },
    {
      "uid": "zhcn:15b4f1b3b4f8e5210ad92f87",
      "kind": "text_data",
      "source_text": "特雷森轩的荣耀，一定会留在许多粉丝的记忆中。",
      "source_fingerprint": "07e8e73b9ea6f4896a5abc68b44be94ed4b8eda28bf923c6c25872ca2e887080",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "189"
      ]
    },
    {
      "uid": "zhcn:26854791ba481a16986baf6a",
      "kind": "text_data",
      "source_text": "暖身的浓厚味噌大受好评",
      "source_fingerprint": "893574a2a9e1c4da1e2bc798a035453777e80b093e32447f5d4e0fbec81c4fd8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "19"
      ]
    },
    {
      "uid": "zhcn:33fe258cd5d7e784d3ddf67b",
      "kind": "text_data",
      "source_text": "发起最后冲刺，精彩地装点了大团圆。",
      "source_fingerprint": "d24b6dba3a7927feaf38fb50434c13bf9387e91e56dfa92f491e364e20f8870a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "190"
      ]
    },
    {
      "uid": "zhcn:51d4d98b8a520db084049098",
      "kind": "text_data",
      "source_text": "带着炽热情感传递的美味，今后也会被继续传颂吧。",
      "source_fingerprint": "fd72479bf06532846bd40a258ce11b288cddd1ed0d36a33f73005a742bf8165e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "191"
      ]
    },
    {
      "uid": "zhcn:4743cd099375d31c4428bc9e",
      "kind": "text_data",
      "source_text": "驰骋全国的挑战，迎来了鲜亮的尾声。",
      "source_fingerprint": "e1fed7a401a7e93f515ef4258c5110a15d9280d56a2901190d9fb5bf156f43a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "192"
      ]
    },
    {
      "uid": "zhcn:7d9df0c148c65b32b4ef130a",
      "kind": "text_data",
      "source_text": "将报恩的心意寄托在拉面上的旅程，在此完结了。",
      "source_fingerprint": "8e15ff5ba4081b28e777dd1f9205d78ca3e42447fdba395b0d84afe59780e95d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "193"
      ]
    },
    {
      "uid": "zhcn:5385f5aa303643e2048da21a",
      "kind": "text_data",
      "source_text": "成为了一场与特雷森轩最终章相称的精彩活动。",
      "source_fingerprint": "73ddf76f9292608fa8a97abeb3b5ee93c1e604e0212378be583af9986d07dd6a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "194"
      ]
    },
    {
      "uid": "zhcn:b63c8b58921b1558178dd174",
      "kind": "text_data",
      "source_text": "特雷森轩的拉面之道，在此迎来了堂堂正正的完结。",
      "source_fingerprint": "f8f96eb46b5d24f42226f6af37be555bf3abb5ee32d107de4c6b4756e63fa625",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "195"
      ]
    },
    {
      "uid": "zhcn:a5f85f8c794594897d858a54",
      "kind": "text_data",
      "source_text": "成为了一场留在许多人回忆中，最大级别的活动。",
      "source_fingerprint": "2bfd6b9d2114f50dc3b57c4f8be1a3d85b9e02dad6ca86cf9deec5ed8b345ad5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "196"
      ]
    },
    {
      "uid": "zhcn:cb251ca7ad4e8e43e036bda9",
      "kind": "text_data",
      "source_text": "成为了将倾注在一碗面里的炽热情意，广泛传递到全国的总决算。",
      "source_fingerprint": "5d4f9dc810110b92b6da06223d190f1473cd1587056ae030fcd3a25841da9928",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "197"
      ]
    },
    {
      "uid": "zhcn:948fb384721d8cc142f56916",
      "kind": "text_data",
      "source_text": "「猪油的香气激发食欲！正宗的口味！」",
      "source_fingerprint": "b82b3e77dc42aaea89d95ca2c790e2084ef802723562aeee2a984b63a5125bca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "198"
      ]
    },
    {
      "uid": "zhcn:50f3da9d491ff13b10764418",
      "kind": "text_data",
      "source_text": "「大块叉烧和豆芽与浓汤太搭了！」",
      "source_fingerprint": "aeabfbf49e173075cd25643ad9aeaf2b31f1ac3df41c34cab00bc58f7e054be7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "199"
      ]
    },
    {
      "uid": "zhcn:9e74ec5632155fe7055b3b68",
      "kind": "text_data",
      "source_text": "赛马娘们的拉面活动",
      "source_fingerprint": "10984d49de85fb0f70bac1c02c823f3c04960671278ca56605a95cb7600a23f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "2"
      ]
    },
    {
      "uid": "zhcn:cf77ce8ab3578be894478508",
      "kind": "text_data",
      "source_text": "这一碗满载北方大地的美味！",
      "source_fingerprint": "c8e1166bb59add5b259cf43647e2f925c2fc4717d51383e3d777943a51207fca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "20"
      ]
    },
    {
      "uid": "zhcn:3b248004fd77633a7c4d009a",
      "kind": "text_data",
      "source_text": "「浓厚味噌汤底是绝品！吃多少碗都吃不够！！」",
      "source_fingerprint": "47044cb0b16a17bdb3e8c5c27f5a27cec69d779c27eebc7d9d64b85772aa6ae6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "200"
      ]
    },
    {
      "uid": "zhcn:da42f39069bfb7a6bf7cb8a0",
      "kind": "text_data",
      "source_text": "「极粗面与味噌汤底完美调和的逸品啊！」",
      "source_fingerprint": "23f26dee9ee89991d5d4192353f9be98caf5167d35297d9d8793cb0d2513f06a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "201"
      ]
    },
    {
      "uid": "zhcn:f0dcb4272b473cfc231e031b",
      "kind": "text_data",
      "source_text": "「满载蔬菜鲜味的汤底和粗面适配度太高了！！」",
      "source_fingerprint": "4834c67c76d15493f8a613c8a11e6c2aa1c39104327530256138c1792ba3f74b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "202"
      ]
    },
    {
      "uid": "zhcn:a4eaf4435eb5caa8f12bf226",
      "kind": "text_data",
      "source_text": "「以味噌为中心浑然一体的汤底，简直可以称作艺术品了吧」",
      "source_fingerprint": "db8f1520436a5dde01ca0e58c22adc73a3b84e563b899f7a43b4f4effb4c9f2a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "203"
      ]
    },
    {
      "uid": "zhcn:a3aaf69879e5c72281a3a03d",
      "kind": "text_data",
      "source_text": "「升腾起的味噌香气就已经赢了！这味道让人好想配白米饭！」",
      "source_fingerprint": "31596985ea6a3e19c26fc41984aef0375e6af30db7fdfb1bc8ca3b1fc0215680",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "204"
      ]
    },
    {
      "uid": "zhcn:462657c6c8474f102ea5efb7",
      "kind": "text_data",
      "source_text": "「直面爽滑顺喉，一瞬间就消失在胃里了！」",
      "source_fingerprint": "6d4e419fcfea42592e901a5367294c02da8428ba8dea4f98093b3b3cad60c505",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "205"
      ]
    },
    {
      "uid": "zhcn:88fd0462c9ac392e398938b2",
      "kind": "text_data",
      "source_text": "「明明是轻盈的口味，满足度却达到了主赛事级别！」",
      "source_fingerprint": "473da88ce78274b5f95b4ac857423c7f8239e912c921beb20461eb390209eaf0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "206"
      ]
    },
    {
      "uid": "zhcn:dc9308a253f404b407b1558f",
      "kind": "text_data",
      "source_text": "「如清爽的潺潺细流般清澈美味的一碗！」",
      "source_fingerprint": "e361a1adddc9ca82e0928c645eb38a48f7b8476a7f1d97edb19c80c08376e32b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "207"
      ]
    },
    {
      "uid": "zhcn:3a8992002ed17264e856f65e",
      "kind": "text_data",
      "source_text": "「精心熬制的高汤香气优雅，让人欲罢不能！」",
      "source_fingerprint": "5700fcfb5f4b018dedb5592f57ba64abbdab9b46c90d22f70eb0764854affbb9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "208"
      ]
    },
    {
      "uid": "zhcn:0ae4cf5d888d440e39ccde16",
      "kind": "text_data",
      "source_text": "「陶醉于黄金汤底闪耀的美丽中！味道也无懈可击！！」",
      "source_fingerprint": "4febd5d19fe482a53baabda2d9c7572e376ac0e0ba36a67aa894fe663e50676a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "209"
      ]
    },
    {
      "uid": "zhcn:827690c6ba1c784abfd68bc4",
      "kind": "text_data",
      "source_text": "讲究的黄金汤底博得好评",
      "source_fingerprint": "19d099f24ca7b2de60df76873c661b5c576b3f0534888c5615b0361119f1853f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "21"
      ]
    },
    {
      "uid": "zhcn:545cb12db62db7d2e5d30d85",
      "kind": "text_data",
      "source_text": "「清淡又超级好吃，多少都吃得下啊！」",
      "source_fingerprint": "3612ac5c168301f1a978e044abcc9f41971e01a16e0201725d46b7ca261f7b3b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "210"
      ]
    },
    {
      "uid": "zhcn:43beecf82d522bdc83422aba",
      "kind": "text_data",
      "source_text": "「Q弹的面条与浓汤紧紧交织，满足感爆表！」",
      "source_fingerprint": "dc65f677403f2aadaf576ce5c7b386331ade00ce325fe0aeb15128fd00985473",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "211"
      ]
    },
    {
      "uid": "zhcn:c6c8276a7a68d2ed4e17220b",
      "kind": "text_data",
      "source_text": "「洋葱的清脆口感，和浓郁猪背脂的相性太好了！」",
      "source_fingerprint": "fec3828213dfaf9e12b3908aad5a64b5eb2fbc41c4672aad717f82908042c5ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "212"
      ]
    },
    {
      "uid": "zhcn:a4e6f8b61bf43029e867957e",
      "kind": "text_data",
      "source_text": "「漂浮在猪背脂雪原上的岩海苔之岛，这卖相太棒了直接赢了！」",
      "source_fingerprint": "8b99ed22302247ca78536d4c4b3c5f2ecffe8f5b2064009dd6da04573028c528",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "213"
      ]
    },
    {
      "uid": "zhcn:a4d1f1549e4c98e362414090",
      "kind": "text_data",
      "source_text": "「猪背脂小鱼干汤底太入味了～！明年也绝对希望再办！」",
      "source_fingerprint": "ecb7e215392af14869c357fab218c44cee4fc8c23250354456080f6300dd67ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "214"
      ]
    },
    {
      "uid": "zhcn:72fc68850cd78ceafa683448",
      "kind": "text_data",
      "source_text": "「连面条的劲道到汤底的乳化程度都绝妙无比的一碗！」",
      "source_fingerprint": "03a898ef46007fde429ddb9f961fcb6c3be6ff09e07ed97b612e9dba26663321",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "215"
      ]
    },
    {
      "uid": "zhcn:ad430d04acbdde74be79f8a5",
      "kind": "text_data",
      "source_text": "「兼具爽口、鲜甜与醇厚的汤底太棒了！」",
      "source_fingerprint": "cc225c4e61abe2ce3e4eb0888f4d38cc48c9f78be6a2338d5466d36b86804d22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "216"
      ]
    },
    {
      "uid": "zhcn:12c610bc9d5e6ae38db983f4",
      "kind": "text_data",
      "source_text": "「精心准备的叉烧和酱油汤底绝配！」",
      "source_fingerprint": "e83aa248a61a9a58334175ae036ba5511b83fff96c21a84600246fd7c8b4f990",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "217"
      ]
    },
    {
      "uid": "zhcn:3ca5de08061f6b1a5a170940",
      "kind": "text_data",
      "source_text": "「充满透明感的酱油汤底，有着蕴含深厚鲜味的滋味！」",
      "source_fingerprint": "8b219109f08a65ad720a1f341d9a6da4bc75fe810cbfa4a74d114c8cab260225",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "218"
      ]
    },
    {
      "uid": "zhcn:a718ee343fa69b59da1de5be",
      "kind": "text_data",
      "source_text": "「平打面的Q弹口感与汤底交织，让人欲罢不能！」",
      "source_fingerprint": "4d68b814cec8ca1c7af613a46a6b3489579c0db497fb3aa98b000c95ef676a8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "219"
      ]
    },
    {
      "uid": "zhcn:a0c1b9dda880e72dcad1e8a5",
      "kind": "text_data",
      "source_text": "在清透的美味中散发着海洋的香气",
      "source_fingerprint": "2fd1d9cea17f9c252110f31a73a7dba05b329c179b4b133bf0838439c5495315",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "22"
      ]
    },
    {
      "uid": "zhcn:7aa18b5da8470e11fd66f143",
      "kind": "text_data",
      "source_text": "「让我想起了小时候和家人一起吃过的那碗拉面！」",
      "source_fingerprint": "df2426149072d5d61af4329abc95095bc71753a5025e971a9f842627ff59ed4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "220"
      ]
    },
    {
      "uid": "zhcn:ccfff6b08890a2a29655da94",
      "kind": "text_data",
      "source_text": "「用清淡酱油和卷面，充满度过今天所需的活力！」",
      "source_fingerprint": "8d8da1dc3936f505ed9eb25fe14f600035a6667937b8fdb6896872817bf9d572",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "221"
      ]
    },
    {
      "uid": "zhcn:7a860b4d5b4c8865875da71f",
      "kind": "text_data",
      "source_text": "「完美地完成了“天地返”，美味地吃到了最后！」",
      "source_fingerprint": "9820e5f9fda6608d9b4ff3d892689a527465632d3da922a0852dce74197e9b8b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "222"
      ]
    },
    {
      "uid": "zhcn:15c32af4e95ffc14cc288976",
      "kind": "text_data",
      "source_text": "「软嫩的猪肉非常入味，和面条太搭了最棒了！！」",
      "source_fingerprint": "08d2539415cece6549a4d81cf02350fa6e2c17723f3f78a4664e9fba3d2a70b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "223"
      ]
    },
    {
      "uid": "zhcn:5ec7c93affc1b609bd4e91df",
      "kind": "text_data",
      "source_text": "「承接浓汤的硬面条的分量堪称压卷！」",
      "source_fingerprint": "a5d8f9e2d8d524c76b293d583c6574d2ced5073f9525542a2fd8f9517e86f1d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "224"
      ]
    },
    {
      "uid": "zhcn:2d6fb37ac3c8f3f5c13c8070",
      "kind": "text_data",
      "source_text": "「虽然浓厚却不会觉得过重，能让人一口气吃完的一碗！」",
      "source_fingerprint": "f243118c0600bf4c83080c8115737f4eb91eccb8dbc1790bb701bc8624b8b373",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "225"
      ]
    },
    {
      "uid": "zhcn:7bb88b44d5bb6e0984007e5e",
      "kind": "text_data",
      "source_text": "「蔬菜满满超健康的完全食物拉面，帮大忙了！」",
      "source_fingerprint": "673cf7d74f268bc6497e493d9473827f3e66b4d29724f5148e8b504a5ea6569d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "226"
      ]
    },
    {
      "uid": "zhcn:5f29cf8733e7a1275af59064",
      "kind": "text_data",
      "source_text": "「已经没有这蔬菜和猪肉就活不下去了（吸溜吸溜）」",
      "source_fingerprint": "2d866ed90d5f19e230beb5d41889c3b9652687197223c5b8453424431a17c3ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "227"
      ]
    },
    {
      "uid": "zhcn:6382b1096cf63d74b50aff1c",
      "kind": "text_data",
      "source_text": "「这蔬菜的分量……简直就像珠穆朗玛峰一样！！」",
      "source_fingerprint": "95a4bd57e1b78604406c94c1a34aad7efe8569577efc9dfd8d815cb9511f065c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "228"
      ]
    },
    {
      "uid": "zhcn:6c1aec69ca15b9b2a667a4b2",
      "kind": "text_data",
      "source_text": "「对汤底的醇厚感到感激。叉烧也入味好好吃～！」",
      "source_fingerprint": "5f542808deb70dde016b68b7ba0a5c559ba2623de68fe6144dbd8748f897f8e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "229"
      ]
    },
    {
      "uid": "zhcn:78d4cfd32a882fe9fbcf1bcf",
      "kind": "text_data",
      "source_text": "新潟的满腹拉面，直达满足",
      "source_fingerprint": "51ff730be273a771213cb30e0e7fc6b067c7944a8ca4dd9bb89d142c1d0ba488",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "23"
      ]
    },
    {
      "uid": "zhcn:dea8a8888bebdfe3e2ce84e7",
      "kind": "text_data",
      "source_text": "「真没想到酱油拉面还能有这种形态！」",
      "source_fingerprint": "7dd024f798eb43e0c4f31a81ea755ba265ec3f6e95fe23dc2db8459d67fcdbde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "230"
      ]
    },
    {
      "uid": "zhcn:f521b3412a4efd77ad5f3f3e",
      "kind": "text_data",
      "source_text": "「洋葱在黑酱油汤底中迸发的点缀感让人欲罢不能！」",
      "source_fingerprint": "aef2595a2249ce6debf8dfcab95425bc2d33647ad5e6765de8a0b28ecd524d93",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "231"
      ]
    },
    {
      "uid": "zhcn:e9a60f76441f46ffe4b4702a",
      "kind": "text_data",
      "source_text": "「洋葱竟然能展现出如此深度的味道！真是惊人！」",
      "source_fingerprint": "7cc629dd9838bdefb2242dbfaef8c5df345660cb014af7c9c7547307cbf72263",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "232"
      ]
    },
    {
      "uid": "zhcn:70270cab5832d1e993afa330",
      "kind": "text_data",
      "source_text": "「融入了叉烧鲜味的汤底让人停不下勺子！」",
      "source_fingerprint": "753e369a2afeb8c6b604894bf8e2aacd527dae418622ebdd4f3f40758d216cdf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "233"
      ]
    },
    {
      "uid": "zhcn:fee9c03bda8f3197f604e710",
      "kind": "text_data",
      "source_text": "「在辣味与美味的无限循环中，回过神来已经吃光了！」",
      "source_fingerprint": "3aa411589f6917bb891a35785a29b8f1ec1514dd0e37d4c38dad154c7c5ea753",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "234"
      ]
    },
    {
      "uid": "zhcn:0b1e4f95a8ec63fbca8a341a",
      "kind": "text_data",
      "source_text": "「肉沫与韭菜的组合简直犯规，刷新了我对鲜辣的概念！」",
      "source_fingerprint": "747cc5359a9ae1a32e31f74150bc1b8ea4a59e01eaa25691c54b34c58aa33afc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "235"
      ]
    },
    {
      "uid": "zhcn:beccbb8d8596d8d0e56ca094",
      "kind": "text_data",
      "source_text": "「美味鲜辣与推的尊贵感组合，让我眼睛里的汗水停不下来！」",
      "source_fingerprint": "66fbef392f2505f38b19c2fbc9fc4eec5235a68468cc1d8e1e73069cc6f38273",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "236"
      ]
    },
    {
      "uid": "zhcn:d1036098690d045005450ab8",
      "kind": "text_data",
      "source_text": "「肉沫炒得非常讲究，和汤底很搭！」",
      "source_fingerprint": "d4ef00672437a3e4159114a0efd06287f308fede92bb4949ec649502c51e2bef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "237"
      ]
    },
    {
      "uid": "zhcn:273cc766648dc9324dc60e1b",
      "kind": "text_data",
      "source_text": "「韭菜和蒜的香味很足，筷子越吃越快呢！」",
      "source_fingerprint": "fbf220ec5b0ea79e09342f804aea2a06dd27f3a58b7d20d4bd195e15ef8238fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "238"
      ]
    }
  ]
}
