      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "距离资质",
      "source_fingerprint": "8f54aa8dad5c5b148beb45f8fdd6f796980b7fd058beacf91075e2622543d944",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
