        "469",
        "1100"
      ],
      "json_pointer": "/469/1100"
    },
    {
      "uid": "zhcn:8172ecaafa0d6ee16e8585f4",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "自主训练，终曲……！啊啊，化作了一曲美丽的\\n练习曲哦……大概是因为想着你而演奏的吧？",
      "source_fingerprint": "a814d29620a3b0e900a244fd3995b5bf377ea8c39b19bea15610299dabd95fb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
      "json_path": [
        "469",
        "1102"
      ],
      "json_pointer": "/469/1102"
    },
    {
      "uid": "zhcn:fe6f6b3df1cab6df84459336",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "自主训练虽然完成了……但也差不多该采取措施\\n应对千篇一律了吧……。能尽快拜托你定个新菜单吗？",
      "source_fingerprint": "043fc94723dcca6b57d61804dd6b4c31af3bd7b61da8f29148b36a434256c6a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
