        "469",
        "1103"
      ],
      "json_pointer": "/469/1103"
    },
    {
      "uid": "zhcn:321a85df69c9e81af4e3e81a",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "喂——，还在忙吗？你也挺努力的嘛。\\n自主训练已经做完了，一起去喘口气休息一下吧！",
      "source_fingerprint": "f1e80cfb3e0b78df7aef652fe05988f66322d1a0694ad96a90573b35531e7bf1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
