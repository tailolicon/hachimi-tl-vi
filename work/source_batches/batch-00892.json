      "source_text": "友情加成 <color=#ff6d26>150%</color>",
      "source_fingerprint": "8dcd010a28ddf564612bfb5cbb18975e54075857ab47d589dc1411ba4713ce37",
      "source_path": "text_data_dict.json",
