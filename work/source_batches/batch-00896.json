{
  "schema_version": 1,
  "batch": 896,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:0192e4077fc434ccf795e75a",
      "kind": "text_data",
      "source_text": "「简直像是鲜味的激流冲刷而过般的拉面！」",
      "source_fingerprint": "7620483374bd8edd3cbc571d97dc16484a6b3c52835658ad9f8f48731b168f51",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "285"
      ]
    },
    {
      "uid": "zhcn:824a8db16e6130bbec52b9c5",
      "kind": "text_data",
      "source_text": "「冲击感十足的一碗！味觉的感动传遍全身，我都哭了」",
      "source_fingerprint": "de4e15e993287328e1e197d610464c1871f21cbbe76cadd1e94f1e6dc73cf52a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "286"
      ]
    },
    {
      "uid": "zhcn:4e8d6c8b3d8037edfc0e3632",
      "kind": "text_data",
      "source_text": "「太感动了，不自觉地把汤都喝光了～多谢款待！！」",
      "source_fingerprint": "f43956d9927f5ba74a9e44833fc685cf15261fb3a3fb5633eb2330b6110192bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "287"
      ]
    },
    {
      "uid": "zhcn:a2adc78806fd5a8d36795be2",
      "kind": "text_data",
      "source_text": "「配料的摆盘堪称艺术，从外观看就已经很好吃了！」",
      "source_fingerprint": "657c56b894590f623232bf0bd607f4167b96b381cb47c32d30c6180f80531231",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "288"
      ]
    },
    {
      "uid": "zhcn:6e2b4ec515748aa6e1d46c7e",
      "kind": "text_data",
      "source_text": "「绝妙的甩汤让面条劲道十足，和汤底的结合也堪称完美！」",
      "source_fingerprint": "90a0a480dba29a2081eae32546aa067ccb7188c1189a612d0e2b0540ac58daed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "289"
      ]
    },
    {
      "uid": "zhcn:50db802999ddb2cb2eb0afc2",
      "kind": "text_data",
      "source_text": "展现经过反复特训的手艺！",
      "source_fingerprint": "441d12c4fba2357fc0956f6e3bc3a9237be49519981ee3bf4738623b5342c9e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "29"
      ]
    },
    {
      "uid": "zhcn:326d82643b7d04010dc59a61",
      "kind": "text_data",
      "source_text": "「多层次的鲜味，奏响了绚烂的交响乐呢！」",
      "source_fingerprint": "ed13b1c94ba40dbae0f86a64472654e83fd978760f667be6f4745bf2740c248f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "290"
      ]
    },
    {
      "uid": "zhcn:3fc79252198347c10e3864f4",
      "kind": "text_data",
      "source_text": "「全勤打卡！这次远征来也值了！！」",
      "source_fingerprint": "d669f67127571daf0542668be11672c32d72736bd37558d236a5808d1ef50e20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "291"
      ]
    },
    {
      "uid": "zhcn:f88f04bb6f9c8fd977bce777",
      "kind": "text_data",
      "source_text": "「慢慢熬煮出的汤底鲜味，让人欲罢不能！」",
      "source_fingerprint": "63b7d21493328e792a158f4c5129e6e1e42b50016aa4649a5b2e7310c961c843",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "292"
      ]
    },
    {
      "uid": "zhcn:f4fb64df8c0311851ee9c909",
      "kind": "text_data",
      "source_text": "「充满力量的甩汤，让汤汁紧紧挂在面上，真好吃！」",
      "source_fingerprint": "189d344732b78d316fe4d5c80f97efd67842736b0a9e23b6043fca87ab7a29bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "293"
      ]
    },
    {
      "uid": "zhcn:e7432b04e0ab73f007b67ee9",
      "kind": "text_data",
      "source_text": "「简直是面条魔术师！我看到奇迹在眼前发生。」",
      "source_fingerprint": "7f5d25e8e4b7e98b06d56974a41e7873bb83a8edcf1c9432e98475036f0a8541",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "294"
      ]
    },
    {
      "uid": "zhcn:46b094f0b410180a039dbae5",
      "kind": "text_data",
      "source_text": "「像比赛一样充满疾驰感的烹饪过程，观赏性极佳！」",
      "source_fingerprint": "ea74dee06d47379b61aa9c0d16326070c31885d741ff915b1063266a121d343c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "295"
      ]
    },
    {
      "uid": "zhcn:e2e0182f31e97167ecc59c24",
      "kind": "text_data",
      "source_text": "「厨房的配合非常精彩，能在热气腾腾的时候吃到真开心！」",
      "source_fingerprint": "b18b6f9c80c480a7e5050b67b4e2a2ef619b9fb55fe0d728305cce392332a1db",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "296"
      ]
    },
    {
      "uid": "zhcn:6b2b52395793b85e5bf5245b",
      "kind": "text_data",
      "source_text": "「同时具备细腻与力量感的手法太漂亮了！」",
      "source_fingerprint": "cbbcb92e9b228bfcb8b5bc137950545b46c9ef5e432fbe53a2723056e2738076",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "297"
      ]
    },
    {
      "uid": "zhcn:91bea2846bd3f127557a7ba8",
      "kind": "text_data",
      "source_text": "「想赠予“煮面大师”称号的完美火候！」",
      "source_fingerprint": "3224121c4efec07589d2660fd121e11ae50f4864e637a02339d5be7dba9747a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "298"
      ]
    },
    {
      "uid": "zhcn:15d68b4aeb4cc6b7cb0de0bf",
      "kind": "text_data",
      "source_text": "「赛马娘笑着端上来的，美味度倍增。」",
      "source_fingerprint": "25ff8a6b3103f71e50c87fa385229758da756d24477894494488db8fdc802360",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "299"
      ]
    },
    {
      "uid": "zhcn:a888b0d98223e62bd56a6092",
      "kind": "text_data",
      "source_text": "拉面嘉年华启动！",
      "source_fingerprint": "290c79d485c1193afbb823ec56073ed23cc7ac2718398525149df33813ed9f9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "3"
      ]
    },
    {
      "uid": "zhcn:9eda4bc280ef525ceb8e154e",
      "kind": "text_data",
      "source_text": "用拉面编织与粉丝的牵绊",
      "source_fingerprint": "dfce3e4a7c98d10eed2356210b258970bdc784c72b7293020d6a13ec90cf821c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "30"
      ]
    },
    {
      "uid": "zhcn:572aff4de90a5b85e07fb1ac",
      "kind": "text_data",
      "source_text": "「肚子和心都得到了满足。多谢款待！」",
      "source_fingerprint": "9bb7b0cd549d78ff81d94bf0a63e6c8868f32ff30e75a154e0f5a09192625fb5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "300"
      ]
    },
    {
      "uid": "zhcn:a6d40b6f801b698cf930aa3e",
      "kind": "text_data",
      "source_text": "「卡路里和油脂的魔力，我充分领略了～多谢款待！！」",
      "source_fingerprint": "a78ca7f84acd70fba8cc4c5d4f812f9cdac1a6d15ddddbedcfdb79a49139a398",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "301"
      ]
    },
    {
      "uid": "zhcn:9c880f37925034eb22d704b3",
      "kind": "text_data",
      "source_text": "「有了这一碗，感觉连严冬的寒冷都能挺过去了！」",
      "source_fingerprint": "050ea4a152b8f9a600151482d07ffe651528347be79b513cc012a1cbcf138651",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "302"
      ]
    },
    {
      "uid": "zhcn:c727f51713b28d0de6cfd2e4",
      "kind": "text_data",
      "source_text": "「元气满满的招待和热气腾腾的拉面，成为了最棒的回忆！」",
      "source_fingerprint": "f7b0f291c2e2683aadc9bfc478cbabda859656d0674bf5f7eb77824dd473e550",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "303"
      ]
    },
    {
      "uid": "zhcn:326ade97feb192581649123f",
      "kind": "text_data",
      "source_text": "「饱含真心的热汤渗透进了五脏六腑！」",
      "source_fingerprint": "bea0ee8f926a818d71e9e6075a25ce4f5e0cfa82e8e152a8bcaf04bbd92dc730",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "304"
      ]
    },
    {
      "uid": "zhcn:7661007c6d763a93e0d064d5",
      "kind": "text_data",
      "source_text": "「精心制作饱含真心的一碗，多谢款待！」",
      "source_fingerprint": "6d1e5be7b2112c076cbdf2e5d2fb8a37bd7d0482f44bb637647830c9218442c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "305"
      ]
    },
    {
      "uid": "zhcn:42f86e9630af4627f4807f97",
      "kind": "text_data",
      "source_text": "「美妙姿势的皇家甩汤让拉面好吃了十倍！」",
      "source_fingerprint": "35fba60d8060096c3bd7684c5b926af4b05a0486f5b48d6c1ab7883e3bbe48ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "306"
      ]
    },
    {
      "uid": "zhcn:7b0051392286d3c7503c5667",
      "kind": "text_data",
      "source_text": "「用美妙姿势亲传的吃法，非常美味地享用了！」",
      "source_fingerprint": "bfe51ba80554e4f1a5e302850134f7b70b82341ced316adf8bd6ebc209b3eaa2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "307"
      ]
    },
    {
      "uid": "zhcn:47899e592c51a9e295d3d739",
      "kind": "text_data",
      "source_text": "「美妙姿势对拉面的执着，让人感佩……！」",
      "source_fingerprint": "ab451cd02e292650aed80166aae3cbd648e4c34c1dd98844d77772b8f13a0f2f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "308"
      ]
    },
    {
      "uid": "zhcn:3c08abdc0f87eb9b0e0b30f5",
      "kind": "text_data",
      "source_text": "「高雅、优美，同时又充满力量的甩汤，让人看入迷了……！」",
      "source_fingerprint": "0ec1c18b807278609cf5280a4b4a830bdd5ada172124903f669a1e5c9151f8ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "309"
      ]
    },
    {
      "uid": "zhcn:42fb2e5d4ad5035c761a7b5a",
      "kind": "text_data",
      "source_text": "用手工拉面传达感谢",
      "source_fingerprint": "7e55646627df2748b4510610331ec1a6e61bdb0c59508eb8a7e25430e6031ee3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "31"
      ]
    },
    {
      "uid": "zhcn:4f0af89035b8bdc4aac83c3d",
      "kind": "text_data",
      "source_text": "「我懂的……她才是肩负所有拉面未来的人才」",
      "source_fingerprint": "ffc5895359f9ea86dacfb47e703d766dc102a084694e8d697aeb56fb8396f14e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "310"
      ]
    },
    {
      "uid": "zhcn:aeae71ebd6164da343261a51",
      "kind": "text_data",
      "source_text": "「这么年轻竟然能做出专业水准的拉面，太厉害了！」",
      "source_fingerprint": "931f118d01828d9b78a0fc0d52dd1a318fd6390dec1dc19739e5621158cee6cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "311"
      ]
    },
    {
      "uid": "zhcn:cf8bc56682fddff794fa8bf2",
      "kind": "text_data",
      "source_text": "「她那份深爱着拉面的心意，深深打动了我！」",
      "source_fingerprint": "5aff187451786dcad3a40127fbe8db8af295435c1dde55f9549350534ee6c898",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "312"
      ]
    },
    {
      "uid": "zhcn:9ada98c651be96a5aaa39fe2",
      "kind": "text_data",
      "source_text": "「用非常厉害的笑容端上来的拉面，感觉变得非常美味了！」",
      "source_fingerprint": "4c87753772cc605409b9c8d645f6523c00b157ec0be6102035c1a3c7b2bd66df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "313"
      ]
    },
    {
      "uid": "zhcn:6dacfbe9a229ed0629d85a65",
      "kind": "text_data",
      "source_text": "「能感受到成田路专一的心意，是炽热的一碗！」",
      "source_fingerprint": "cee7ae68372f9d4b57382af9e27edcdb27985336ab9568564467a1b82728dfec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "314"
      ]
    },
    {
      "uid": "zhcn:7d295e5108933d5278a5f48a",
      "kind": "text_data",
      "source_text": "「拉面界备受期待的新星，压倒性的委员长，出现了……！」",
      "source_fingerprint": "abd5c789318dd89f0c271c84990ee267cdf03294ed990bb95dd4d09166eb230d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "315"
      ]
    },
    {
      "uid": "zhcn:c7dacbadd36eda8afaa51d95",
      "kind": "text_data",
      "source_text": "「开朗的笑容和清脆的应答，真想把她挖到我们店里啊！」",
      "source_fingerprint": "824889d93b1582985d11aadf24e51c9f5ea9d86daaa79ab6f6d4e9b64136a8ef",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "316"
      ]
    },
    {
      "uid": "zhcn:ddaa365f02b45a0c7fde0709",
      "kind": "text_data",
      "source_text": "「路酱的拉面让人身心都暖和起来了哦！」",
      "source_fingerprint": "800b05aa03920e7212ba99b5466eb2bb5005265c3fa28cd8736afba88827096e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "317"
      ]
    },
    {
      "uid": "zhcn:30fd70c1a9b6bf6e0c286b6f",
      "kind": "text_data",
      "source_text": "「为了不洒出来拼命端着拉面的怒涛太坚强了！」",
      "source_fingerprint": "19af8cf2de6edbef0ac504019af3b839fa114898341d852223f340b3d13341f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "318"
      ]
    },
    {
      "uid": "zhcn:f29ca66412bc52c88740213c",
      "kind": "text_data",
      "source_text": "「她为了送上最棒的拉面而努力的身姿，给了我力量！」",
      "source_fingerprint": "1653cc8092b2384704f2ee914acdbf2e2fedd40ca4541f02936fa1d02949a12d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "319"
      ]
    },
    {
      "uid": "zhcn:40ef7f9627cecfc642bb5dff",
      "kind": "text_data",
      "source_text": "于<region_name>提供浑身解数的一碗！",
      "source_fingerprint": "32bf4a97b50e4c6d9c2642ab3aaec31972625a6f44a16541bcd35b3cfcb802b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "32"
      ]
    },
    {
      "uid": "zhcn:5688e6e2ff6bb855a3371294",
      "kind": "text_data",
      "source_text": "「从这一碗里，我感受到了怒涛酱炽热的心意哦！」",
      "source_fingerprint": "0adb2583ee4552b2415ad0a9c6f27c040e1742485d60b1af1e10d1dad703b2a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "320"
      ]
    },
    {
      "uid": "zhcn:16963a7287a99bca8a6d0dd2",
      "kind": "text_data",
      "source_text": "「和怒涛的超辣拉面对决，是我完败了……！不愧是她！」",
      "source_fingerprint": "b95ca6c009d4a21ce7e0b740d0289d5be006139388d9c0369df41776ca582b09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "321"
      ]
    },
    {
      "uid": "zhcn:41cd86b052f261f3c6867ed2",
      "kind": "text_data",
      "source_text": "「找怒涛点拉面的话，会出现辣度倍增的隐藏菜单哦！」",
      "source_fingerprint": "c29f2264d7cfd1bc175816c7384f86b4439aa03174f6c74a504cfb96491439e1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "322"
      ]
    },
    {
      "uid": "zhcn:aa7b727d1ab4e39c68384849",
      "kind": "text_data",
      "source_text": "「简直要引发音爆的精湛手法！令人脱帽致敬……！」",
      "source_fingerprint": "0b031ff17d57612fa0cec6a8396445b9934c53bfacbbb465cd3162da5d194c18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "323"
      ]
    },
    {
      "uid": "zhcn:7040e26886af74e5c43fee13",
      "kind": "text_data",
      "source_text": "「金镇之光推荐的快煮偏硬面很好吃！」",
      "source_fingerprint": "d3dfc908b23f4c2dae80146389c3a7567964fc39e42010388f5dfe7407676047",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "324"
      ]
    },
    {
      "uid": "zhcn:13f7b8dc3ec971ab1bac05a5",
      "kind": "text_data",
      "source_text": "「还没点单就把拉面端过来了！不愧是最速的赛马娘！」",
      "source_fingerprint": "628bb4dcb7d758688a4b311b9f8b1a6ed66576c4331fa6e6fc6a0cd7abb37fab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "325"
      ]
    },
    {
      "uid": "zhcn:3341a040ecad365338280e0a",
      "kind": "text_data",
      "source_text": "「金镇之光的甩汤简直就是，艺术般的最快直线运动……！」",
      "source_fingerprint": "a789b50ada6f13ea94238031c46ad91d9b1030d1977a6fd1c15b471488cd37ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "326"
      ]
    },
    {
      "uid": "zhcn:184d632b8f1f9df5f314d673",
      "kind": "text_data",
      "source_text": "「第一次见到方形的叉烧！孩子们也很开心」",
      "source_fingerprint": "56b29be5571eb4d160148e97a60b81d9f7d3cfe745b5167f4d7416aa3f3463fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "327"
      ]
    },
    {
      "uid": "zhcn:76946944139364eda6757d6b",
      "kind": "text_data",
      "source_text": "「（提供得）快！（甩汤也）快！（比赛里也）快！」",
      "source_fingerprint": "6e5dd4195b91a7a94372109cede9b969d7a50e2ad220ae0df24ea3e2ba7393ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "328"
      ]
    },
    {
      "uid": "zhcn:b58886d80dd9df66f17dd598",
      "kind": "text_data",
      "source_text": "「她对我说了一句“今天也辛苦了”，疲劳瞬间飞走……！」",
      "source_fingerprint": "750e0e075c31cef88e9102d1bf5b497a250f2b8494a5c5df26ee21516fb1a913",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "329"
      ]
    },
    {
      "uid": "zhcn:3372bc090ed8126aa55c1385",
      "kind": "text_data",
      "source_text": "在<region_name>的反响带来了切实的手感",
      "source_fingerprint": "af37b4989667356406b3e28defc485872d75374557233148b293ca079b42eb89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "33"
      ]
    },
    {
      "uid": "zhcn:657338c5ae9ee5eb0f52b7ac",
      "kind": "text_data",
      "source_text": "「能看到素质酱生龙活虎的样子，真让人开心啊～」",
      "source_fingerprint": "f2324c8588d6a978e1b2e2499c519d0e0e3b5344edfc6340be7832927a3e46de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "330"
      ]
    },
    {
      "uid": "zhcn:7464e1f2255b2dcc9977996b",
      "kind": "text_data",
      "source_text": "「素质姐姐的拉面，很好吃！！！」",
      "source_fingerprint": "026f18a67bfe3c801114bb1496e4649f86344f24c0f3bed93276085d2b9a79a6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "331"
      ]
    },
    {
      "uid": "zhcn:b036c9bc3d537bbb86d62a72",
      "kind": "text_data",
      "source_text": "「小素质拉面，要是开到我们商店街绝对会大卖的！」",
      "source_fingerprint": "bdd53b369eed2bac0ea5ceefc7de4e18ba59e6ba2033fa87ccc5fe95d59e9bd0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "332"
      ]
    },
    {
      "uid": "zhcn:a90f7c161e51478023cde227",
      "kind": "text_data",
      "source_text": "「素质的拉面，有一种让人恋恋不舍的怀旧味道呢」",
      "source_fingerprint": "c045266d2d25ea85ea0c136331ff15e149bb1ed4a47473d4a0b2134fd43dc1f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "333"
      ]
    },
    {
      "uid": "zhcn:483fea1a380b7ad78fca9a74",
      "kind": "text_data",
      "source_text": "「素质亲传的桌上调味料推荐配比，太棒了……！」",
      "source_fingerprint": "487c551d74f56bd35e958c85a0195a8772db90791960372022c9434aa4f90d67",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "334"
      ]
    },
    {
      "uid": "zhcn:6a3ba52ec2207a6fcc431bf4",
      "kind": "text_data",
      "source_text": "大量熬煮当地食材的浓厚味噌汤底，温暖到身体深处的一碗。稍粗的卷面吃起来非常满足。",
      "source_fingerprint": "3c36211dff1ac51531c4e06931d867ffd27617f1f076c263ebe459902d6d6b62",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "335"
      ]
    },
    {
      "uid": "zhcn:831a720bc74ebdd5db3a1432",
      "kind": "text_data",
      "source_text": "清透的黄金汤底中，从鸡架到豚骨再到海鲜，丰富的食材鲜味闪耀。直面的顺滑口感拔群。",
      "source_fingerprint": "433dd7450a362c60c5721467f6732aaf4949e3e5a5a6689415325ab4c7fcffd5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "336"
      ]
    },
    {
      "uid": "zhcn:b56b32547551ef80553c8424",
      "kind": "text_data",
      "source_text": "满是猪背脂的小鱼干酱油汤底，与极粗面非常相配的一碗。香气丰富的岩海苔，加上碎洋葱增添了一丝清爽。",
      "source_fingerprint": "9a4915781da0d7c525517a8558a3e22063abd3ae8c68e2b03164debcc3e57fff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "337"
      ]
    },
    {
      "uid": "zhcn:0d2d6d5f24530ecfc450d965",
      "kind": "text_data",
      "source_text": "充满透明感的酱油汤底，口感清爽且鲜味十足。劲道十足的平打面，与汤底完美交织的一碗。",
      "source_fingerprint": "2aa06838eaad179f4d2c222f35bbc701fe16b0814cf12cb9875a1e188f06e106",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "338"
      ]
    },
    {
      "uid": "zhcn:59971a5ba5575d80084b3e05",
      "kind": "text_data",
      "source_text": "以豚骨酱油为基础的浓汤，与极粗面的相性绝佳。堆积如山的蔬菜和厚切猪肉，食欲MAX的一碗。",
      "source_fingerprint": "92b0d5c5f54ee10339a053c123a59745d551d539246bc64af1f0b9233539033b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "339"
      ]
    },
    {
      "uid": "zhcn:e4ce664151ef34c7de865352",
      "kind": "text_data",
      "source_text": "第2届拉面嘉年华",
      "source_fingerprint": "c5d0f08c1a97d2f846fd5af0cd478959ec671dc3a4ca77f0fdaf5470d7c33f1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "34"
      ]
    },
    {
      "uid": "zhcn:d4da60deb344e79dcfefd36c",
      "kind": "text_data",
      "source_text": "漆黑的酱油汤底，融合了猪肉高汤的醇和滋味。切块的洋葱，加上满满的叉烧，令人愉悦的一碗。",
      "source_fingerprint": "6803aabe6ccd4312124666e8dc92cbd5a37f8f82a451730f48e651bd99f90349",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "340"
      ]
    },
    {
      "uid": "zhcn:5c5d1864fad4cf290a2db208",
      "kind": "text_data",
      "source_text": "辣椒和蒜味十足的汤底，在辛辣中带有蔬菜的醇厚。鲜辣肉沫和韭菜衬托出刺激的滋味。",
      "source_fingerprint": "e3007fa392102d4b83c7c0359ff090d24bb061fb9cb209c6ed3494711edaa3b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "341"
      ]
    },
    {
      "uid": "zhcn:52ee1b98ece15bb150f19211",
      "kind": "text_data",
      "source_text": "融入鸡肉和猪肉鲜味的酱油汤底，浓厚却不会吃腻。撒上的猪背脂与大青葱相映成趣。",
      "source_fingerprint": "4a5d90924f5ca68fc79b04a2861a5b7ba462450705b5c20eb129affc632bbf98",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "342"
      ]
    },
    {
      "uid": "zhcn:b283bb99f978dcc4a429d57c",
      "kind": "text_data",
      "source_text": "熬煮了众多食材的汤底有着独特甜味的柔和滋味。Q弹的细卷面，与豆芽和葱完美契合的一碗。",
      "source_fingerprint": "2abafed24a5bb7e604eb2cafacf995dca7f8c93eefce3fbd31d04da88908a28b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "343"
      ]
    },
    {
      "uid": "zhcn:d3d5abb5fb31d2ccbd6d2f5e",
      "kind": "text_data",
      "source_text": "长时间熬煮的豚骨汤底，醇厚浓郁且如奶油般顺滑。口感爽脆的极细面与汤底相性拔群，绝对需要加面。",
      "source_fingerprint": "880647468e478ab1df996c9cf6accefd8b2b46353d7c2c92ed178210e0f400a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "344"
      ]
    },
    {
      "uid": "zhcn:16e47c8d4071fd01ba541ec3",
      "kind": "text_data",
      "source_text": "倾注了所有感谢的配料快要溢出碗外，王道酱油拉面的集大成之作。是在各地拉面修行的结晶之作。",
      "source_fingerprint": "9202e803a173a46c68ba69756aa89e06df0fe15a92d3dc1d8f87efbe0b74fb5b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "345"
      ]
    },
    {
      "uid": "zhcn:9a0cc4e5c06e7b9c3d50bd22",
      "kind": "text_data",
      "source_text": "醇厚浓郁的讲究味噌汤底上，堆满了各种各样的配料。能尽情享受丰富的味道，服务精神满分的一碗。",
      "source_fingerprint": "7c6ab144fa9566db8e20b234dd180c4eb817660828a218146bc2ecd616369a71",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "346"
      ]
    },
    {
      "uid": "zhcn:1c06509a6e6a0a4b94e73718",
      "kind": "text_data",
      "source_text": "精心熬制的盐味汤底被众多严选食材鲜艳点缀。别出心裁的摆盘，让视觉和味觉双重享受的一碗。",
      "source_fingerprint": "a3586d57fe88b1e3d7a5d04b0d0f612cfb39efd27c3976bf466597309fa2df39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "347"
      ]
    },
    {
      "uid": "zhcn:5c5744c031c78cf390f9b6b0",
      "kind": "text_data",
      "source_text": "引发话题的拉面活动再度来袭！",
      "source_fingerprint": "e2dbc455ce0f31aec805fc5f3a0a19688a993140e59680297d96df1edd052729",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "35"
      ]
    },
    {
      "uid": "zhcn:670cb988250126dbc42774e0",
      "kind": "text_data",
      "source_text": "拉面嘉年华再次到来！",
      "source_fingerprint": "461e0c8bbe0481af24856af5a9b9aff17d1ac6ae0b7ef677c01663d1e14febd7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "36"
      ]
    },
    {
      "uid": "zhcn:70a232b9592491f726912a45",
      "kind": "text_data",
      "source_text": "备受期待的特雷森轩于<region_name>开店！",
      "source_fingerprint": "59b6df1ff9e6a04075802492876ff0b3f64423951bfbd34c0c56bfcceadb3528",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "37"
      ]
    },
    {
      "uid": "zhcn:655db807e1843b7937ec174e",
      "kind": "text_data",
      "source_text": "特雷森轩，于<region_name>出战！",
      "source_fingerprint": "d81e018483f3f0197a65e0a9c3cbad11d3fb5e127759c2327b32bf9e1d8f6ae8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "38"
      ]
    },
    {
      "uid": "zhcn:4d45381816a7ea08f47bf9be",
      "kind": "text_data",
      "source_text": "特雷森轩，第二章开幕",
      "source_fingerprint": "7422be3036350da26ce21c097eebedf599a7415803f20576fe4df70ac4525c9a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "39"
      ]
    },
    {
      "uid": "zhcn:c176af90a892115a57f9048e",
      "kind": "text_data",
      "source_text": "特雷森轩在<region_name>开店！",
      "source_fingerprint": "6682322c474d5b488cdf6afe9db82151bb43e237d29f9e4a39522f24bdab4fe6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "4"
      ]
    },
    {
      "uid": "zhcn:34db91f7e7cdcba649ad534f",
      "kind": "text_data",
      "source_text": "绝品拉面引来粉丝大排长龙",
      "source_fingerprint": "5d60f3a556a03c8d42abc5a16b4cb3a74de6360458faa5c517695464c5b6f411",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "40"
      ]
    },
    {
      "uid": "zhcn:11fe773974d355da3d587650",
      "kind": "text_data",
      "source_text": "正宗拉面洋溢着匠人风范",
      "source_fingerprint": "c59a1708d843053df34f67b8eec3541b726102439e07e6d1213ff2bed9db4e84",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "41"
      ]
    },
    {
      "uid": "zhcn:a0b1111bce8f4f249685c3d0",
      "kind": "text_data",
      "source_text": "<region_name>赛场的粉丝大满足",
      "source_fingerprint": "a8b6602ab6edf91495098c8c7f8bff1db18fde93557ac646177b8daa4f341521",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "42"
      ]
    },
    {
      "uid": "zhcn:153c74c7270181c132fe101d",
      "kind": "text_data",
      "source_text": "用拉面款待<region_name>！",
      "source_fingerprint": "007dd33a05c1646ed9d6a6892a26152bbb47afeea2cea1c68cc2ebf7752f4fd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "43"
      ]
    }
  ]
}
