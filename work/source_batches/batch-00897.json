      ]
    },
    {
      "uid": "zhcn:170ce69fc6ed537cc0a32ea2",
      "kind": "text_data",
      "source_text": "对味道的讲究正在进一步加速！",
      "source_fingerprint": "dd4dfdf3110b5772289a8be695dc7f4257ef8341d9febe0440ae74c511410c75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "45"
      ]
    },
    {
      "uid": "zhcn:409dd2c2e034a00d657b0c4a",
      "kind": "text_data",
      "source_text": "千锤百炼的美味就在这里！",
      "source_fingerprint": "40d2beeb7ce83c2d529a31611d5a1cc463b8f407eb0dab314c15fd644a265a5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "46"
      ]
    },
    {
      "uid": "zhcn:8eccc08cfddbe9cc2751b296",
      "kind": "text_data",
      "source_text": "用美味来展现进化的手艺！",
      "source_fingerprint": "0bad5878b924de098c751459518d2a53f9e8da16e51c7be5839c9faa9eccfd0a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "47"
      ]
    },
    {
      "uid": "zhcn:fe87d295befcf03cc306f88f",
      "kind": "text_data",
      "source_text": "末脚十足！满载成长的一碗",
      "source_fingerprint": "5477ca5c6e3aaf76d4819261e7e4fb6c1f7b5f5cc398d17e69cdebc9e5b2ab2f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "48"
      ]
    },
    {
      "uid": "zhcn:7856b95da59416081d89c231",
      "kind": "text_data",
      "source_text": "超越上次的热烈盛况",
      "source_fingerprint": "6127947c6061b968ae764945ee93f9e2760a3f015c755ca36f0ff580268d2c28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "49"
      ]
    },
    {
      "uid": "zhcn:73a378ce52429894a7be4a12",
      "kind": "text_data",
      "source_text": "特雷森轩，于<region_name>出战！",
      "source_fingerprint": "d81e018483f3f0197a65e0a9c3cbad11d3fb5e127759c2327b32bf9e1d8f6ae8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "5"
      ]
    },
    {
      "uid": "zhcn:5fbba9bd83b5c6f46853f4b4",
      "kind": "text_data",
      "source_text": "在超美味的粉丝福利中笑容绽放",
      "source_fingerprint": "75646659f15431dadb1aa9513cecf0f29a1142530fd2887e1becf49b70e62b84",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "50"
      ]
    },
    {
      "uid": "zhcn:72b437a099003a3c6ec372a8",
      "kind": "text_data",
      "source_text": "香气四溢的热气引来大批来客",
      "source_fingerprint": "aa09dddfba878f20f23daccda8485c530c4902f6e6ba14e69b1be1bac7cb5b07",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "51"
      ]
    },
    {
      "uid": "zhcn:5dca89eda8092ad9d8e587a9",
      "kind": "text_data",
      "source_text": "以浓口酱油的醇厚令粉丝着迷",
      "source_fingerprint": "55dea0fbe4f2f4c8ec3e899b82700b2879e83ea92cddb1f937c282f2974266bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "52"
      ]
    },
    {
      "uid": "zhcn:d27f6e6d778942c942b2326e",
      "kind": "text_data",
      "source_text": "洋葱口感闪耀的漆黑汤底",
      "source_fingerprint": "2c56b328ab923f5cffec2ca363fcf9e2951e025fd86fc85a0d5b75f7250ebb8b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "53"
      ]
    },
    {
      "uid": "zhcn:64471e5f4091723ef7fead08",
      "kind": "text_data",
      "source_text": "鲜辣刺激直击心灵的一碗！",
      "source_fingerprint": "f4108d4f84443d70edb8080b7ee8e1fc592a03e143d7629eb51cc503b3e86971",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "54"
      ]
    },
    {
      "uid": "zhcn:dc4a9b27c8f9f13927b68603",
      "kind": "text_data",
      "source_text": "韭菜与鲜辣肉沫的破坏力！",
      "source_fingerprint": "5593b18664e5f8b69fec9ec16155960f2b53589f64fbb49945238c6bc969f7f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "55"
      ]
    },
    {
      "uid": "zhcn:e22fef41013d0e4407c92c9d",
      "kind": "text_data",
      "source_text": "满满的猪背脂令人极度上瘾！",
      "source_fingerprint": "057cd3775cc41d4c5fd50fec0d40726e7f46099bb70c60d530963cb6f4fe9007",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "56"
      ]
    },
    {
      "uid": "zhcn:e684dd09f398ea9b510c14ed",
      "kind": "text_data",
      "source_text": "大青葱与猪背脂交织的协奏曲",
      "source_fingerprint": "82f045a3586ec2f3ae09f90b339ba7d3dbeb0a479fb76245cd9612a76ca8971c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "57"
      ]
    },
    {
      "uid": "zhcn:b50c07b9b307bfd6729c3472",
      "kind": "text_data",
      "source_text": "食材的鲜甜令人放松身心的一碗",
      "source_fingerprint": "2a585924384a577fe664447c90ac0f67368a5d3e77f7d02c1a1ee3ab5c8bc121",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "58"
      ]
    },
    {
      "uid": "zhcn:a40c490ca184459519dff3a4",
      "kind": "text_data",
      "source_text": "醇和鲜甜浓汤大受欢迎！",
      "source_fingerprint": "a689c9da437997d8360e21d92d4a0055149ed85aefc4138ee401c6e04b9889a7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "59"
      ]
    },
    {
      "uid": "zhcn:d4c669bfa4d4ffe10319aeb2",
      "kind": "text_data",
      "source_text": "特雷森轩，闸门开启！",
      "source_fingerprint": "31b48c14e662af49c8203dfd42cd2b64f4febce4d70ee3d3660b1b3eccafee39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "6"
      ]
    },
    {
      "uid": "zhcn:d29ce1c8ae9a57b10d7282fd",
      "kind": "text_data",
      "source_text": "豚骨的令人上瘾引发加面呼声！",
      "source_fingerprint": "955977d312e33f424737257c1649614c9b2f9409e397bd48b4ba81db4d7720c9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "60"
      ]
    },
    {
      "uid": "zhcn:ad0730e1c4e9b31ba1a54f26",
      "kind": "text_data",
      "source_text": "极细面条交织着浓汤的醇厚",
      "source_fingerprint": "8f653b68ccd0aa37f4969f0151d79751c4bfde5a8a6c4df4f7d9c2c04ecf6fe1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "61"
      ]
    },
    {
      "uid": "zhcn:10ae3800b59f9d9f86cfcad7",
      "kind": "text_data",
      "source_text": "送上更加成长的美味！",
      "source_fingerprint": "49776aa06dc6f2deaf96bca2ee39d8758f1414b4294aa948f579c3fcd0a5ee96",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "62"
      ]
    },
    {
      "uid": "zhcn:97e8890696e1ee307e5fedca",
      "kind": "text_data",
      "source_text": "回应粉丝期待的一碗",
      "source_fingerprint": "2a07cb34eb4f40f11d62bf02b1ad5383e13ad7bf852ad36af2c4bad79a8843a5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "63"
      ]
    },
    {
      "uid": "zhcn:7595ecd60a5d7108e23f14ed",
      "kind": "text_data",
      "source_text": "用拉面扩大对粉丝的感谢",
      "source_fingerprint": "7ebd4c90b9cc42f1c3c10783ca3837446a6d3d0792eab9e834554cabbf6d8d56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "64"
      ]
    },
    {
      "uid": "zhcn:15a56309f847dcd2d5417ec0",
      "kind": "text_data",
      "source_text": "温暖人心的拉面呼唤好评",
      "source_fingerprint": "76567f6370919bf5dd872b824ac664ece242f75f7a96b6648c78f92899ac4749",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "65"
      ]
    },
    {
      "uid": "zhcn:d11150064d475e42224d8bf2",
      "kind": "text_data",
      "source_text": "精益求精的一碗，于<region_name>提供",
      "source_fingerprint": "06a373967fa0d9a9668a3425eaa4c55159240aeae38727920387ce032b8837f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "66"
      ]
    },
    {
      "uid": "zhcn:a8492934895b969a31914246",
      "kind": "text_data",
      "source_text": "超拉面嘉年华极",
      "source_fingerprint": "75b6cd46c431919d1cdf358093571e7686baab2bafecf1afc36706030fc0c536",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "67"
      ]
    },
    {
      "uid": "zhcn:04fd015ecb5392a9ab29e8a8",
      "kind": "text_data",
      "source_text": "让赛场一举染上拉面之色！",
      "source_fingerprint": "1b313272a3aeb03c48928b4b6c24856c40057265dc4071c63f10fa228c6ff4dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "68"
      ]
    },
    {
      "uid": "zhcn:4c401388a06cc87413b6df60",
      "kind": "text_data",
      "source_text": "将拉面之魂发挥到极致的结晶！",
      "source_fingerprint": "69e8cc94e81afdceff33c044218ce4d911fb75efdbb4e9f55ed03cac5f120bf3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "69"
      ]
    },
    {
      "uid": "zhcn:ce4735fd8d6555fe9ae32634",
      "kind": "text_data",
      "source_text": "卷起拉面旋风",
      "source_fingerprint": "6024656af0f3f05f05a0d42e90f4fbc1585edef16b91c4451d0664e6ad4bb09c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "7"
      ]
    },
    {
      "uid": "zhcn:4c3787de6737d3412c54ce33",
      "kind": "text_data",
      "source_text": "纵贯日本的巨大拉面祭典！",
      "source_fingerprint": "b17d83e0baf4500101587c7aa56b2685738826dd08fa1948db3f3eae946ca9df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "70"
      ]
    },
    {
      "uid": "zhcn:059393b3e65312db527d8866",
      "kind": "text_data",
      "source_text": "特雷森轩的集大成之作就在这里！",
      "source_fingerprint": "7aa0b1050d07fd8622870f405a96ad3de48279a6b75ece0d2f9d6e9d5220942a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "71"
      ]
    },
    {
      "uid": "zhcn:58049842f05746d23a5c41e6",
      "kind": "text_data",
      "source_text": "特雷森轩的真本事！",
      "source_fingerprint": "3e8f299c04db6362bf2d7731fcb55fed8ec24b7142501832d96508d8183c9c25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "72"
      ]
    },
    {
      "uid": "zhcn:2534809b1445ee7fcb60e02d",
      "kind": "text_data",
      "source_text": "对前所未有的究极拉面感到惊叹",
      "source_fingerprint": "6351de2048b06c3c62370a5ac47042f2aa4879043d4625d4643a6514711b38ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "73"
      ]
    },
    {
      "uid": "zhcn:bbc630ff5f151cb370daf800",
      "kind": "text_data",
      "source_text": "总动员所有讲究的一碗爆诞",
      "source_fingerprint": "a01f6f109aa7541d15e8f2f302dec6c57bd74846ac868c5db21b25a4b8e23e82",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "74"
      ]
    },
    {
      "uid": "zhcn:7345986aff34df5efe6ba7ea",
      "kind": "text_data",
      "source_text": "全力的「报恩」引发巨大反响",
