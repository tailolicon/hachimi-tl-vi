        "66"
      ]
    },
    {
      "uid": "zhcn:a8492934895b969a31914246",
      "kind": "text_data",
      "source_text": "超拉面嘉年华极",
      "source_fingerprint": "75b6cd46c431919d1cdf358093571e7686baab2bafecf1afc36706030fc0c536",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "67"
      ]
    },
    {
      "uid": "zhcn:04fd015ecb5392a9ab29e8a8",
      "kind": "text_data",
      "source_text": "让赛场一举染上拉面之色！",
      "source_fingerprint": "1b313272a3aeb03c48928b4b6c24856c40057265dc4071c63f10fa228c6ff4dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "68"
      ]
    },
    {
      "uid": "zhcn:4c401388a06cc87413b6df60",
      "kind": "text_data",
      "source_text": "将拉面之魂发挥到极致的结晶！",
      "source_fingerprint": "69e8cc94e81afdceff33c044218ce4d911fb75efdbb4e9f55ed03cac5f120bf3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "69"
      ]
    },
    {
      "uid": "zhcn:ce4735fd8d6555fe9ae32634",
      "kind": "text_data",
      "source_text": "卷起拉面旋风",
      "source_fingerprint": "6024656af0f3f05f05a0d42e90f4fbc1585edef16b91c4451d0664e6ad4bb09c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "7"
      ]
    },
    {
      "uid": "zhcn:4c3787de6737d3412c54ce33",
      "kind": "text_data",
      "source_text": "纵贯日本的巨大拉面祭典！",
      "source_fingerprint": "b17d83e0baf4500101587c7aa56b2685738826dd08fa1948db3f3eae946ca9df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "70"
      ]
    },
    {
      "uid": "zhcn:059393b3e65312db527d8866",
      "kind": "text_data",
      "source_text": "特雷森轩的集大成之作就在这里！",
      "source_fingerprint": "7aa0b1050d07fd8622870f405a96ad3de48279a6b75ece0d2f9d6e9d5220942a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "71"
      ]
    },
    {
      "uid": "zhcn:58049842f05746d23a5c41e6",
      "kind": "text_data",
      "source_text": "特雷森轩的真本事！",
      "source_fingerprint": "3e8f299c04db6362bf2d7731fcb55fed8ec24b7142501832d96508d8183c9c25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "72"
      ]
    },
    {
      "uid": "zhcn:2534809b1445ee7fcb60e02d",
      "kind": "text_data",
      "source_text": "对前所未有的究极拉面感到惊叹",
      "source_fingerprint": "6351de2048b06c3c62370a5ac47042f2aa4879043d4625d4643a6514711b38ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "73"
      ]
    },
    {
      "uid": "zhcn:bbc630ff5f151cb370daf800",
      "kind": "text_data",
      "source_text": "总动员所有讲究的一碗爆诞",
      "source_fingerprint": "a01f6f109aa7541d15e8f2f302dec6c57bd74846ac868c5db21b25a4b8e23e82",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "74"
      ]
    },
    {
      "uid": "zhcn:7345986aff34df5efe6ba7ea",
      "kind": "text_data",
      "source_text": "全力的「报恩」引发巨大反响",
      "source_fingerprint": "df05cafe22201edfb7438629e647b4a23de3f7821f4023fa6cdfdb8130e94b1e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "75"
      ]
    },
    {
      "uid": "zhcn:5a0768971765654987c20b04",
      "kind": "text_data",
      "source_text": "全开冲刺的活动总决算",
      "source_fingerprint": "5b3788e6e908f23ecb9572155fde379eb8eb788c3cfaea33a2d4bfaf90d20ef2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "76"
      ]
    },
    {
      "uid": "zhcn:6050423748c43b30132669e5",
      "kind": "text_data",
      "source_text": "记录下最高潮的盛况！",
      "source_fingerprint": "4100e43063c1dacf63fd57a2be28f2d94ab087a5b2db5843059b86a74a9a0a6d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "77"
      ]
    },
    {
      "uid": "zhcn:aca5703872b443f08accc930",
      "kind": "text_data",
      "source_text": "美味的新传说诞生",
      "source_fingerprint": "c4436332e407f51e25f7c2209a0b8c84b51f2f6d6e00d3e31ea8f271181c6737",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "78"
      ]
    },
    {
      "uid": "zhcn:21fb4d2fe80c72b573a8ec00",
      "kind": "text_data",
      "source_text": "至高的完成度令粉丝齐声喝彩",
      "source_fingerprint": "5e12bbccdabb1493c1fcef24a2d43625522ab3f4efa1e2367c7b507e45c04d0e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "79"
      ]
    },
    {
      "uid": "zhcn:6e76340ad6f141c31f1b5921",
      "kind": "text_data",
      "source_text": "款待饱含真心的拉面",
      "source_fingerprint": "d53cd548a7cc27f7e5599bf0a06f4b1069882b031755643da05d25d944b3a0b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "8"
      ]
    },
    {
      "uid": "zhcn:3cf8af8e4a281fd8443c3c6b",
      "kind": "text_data",
      "source_text": "体现前无古人的美味！",
      "source_fingerprint": "4a472c01a048956865bbb91e9901f36fb468c5d1606e7dc81c9a1c620de5ebff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "80"
      ]
    },
    {
      "uid": "zhcn:17956c7a13f8a2dd60e8dd96",
      "kind": "text_data",
      "source_text": "各地大排长龙的热情不减",
      "source_fingerprint": "a3701f14cd56811b8798cac2ec713fc02161d3c111db80511aa758f4c8a616a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "81"
      ]
    },
    {
      "uid": "zhcn:efcfbbebba1cf30c371155f8",
      "kind": "text_data",
      "source_text": "在美味的旋涡中迎来压轴的尾声",
      "source_fingerprint": "dfefcd615a96352a0ab62f17a44df2ac39689d48d11772ed2505e28785cb7e94",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "82"
      ]
    },
    {
      "uid": "zhcn:a024805022cc0c81bd876d70",
      "kind": "text_data",
      "source_text": "在此堂堂正正地冲线！",
      "source_fingerprint": "f0f8d5a7ab4c2a06fafa46e6e0742ff671e4439f610149f0a4adfc6f6e56509e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "83"
      ]
    },
    {
      "uid": "zhcn:49be3b670c3ebfd90eb2cce1",
      "kind": "text_data",
      "source_text": "最后冲刺炸裂的大团圆",
      "source_fingerprint": "d62f1ddfd5cbdbdb4ec6836048393c307142e15400015373d4a662d61c669cc1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "84"
      ]
    },
    {
      "uid": "zhcn:df748c7e41766106640045dd",
      "kind": "text_data",
      "source_text": "体现酱油拉面的真髓！",
      "source_fingerprint": "faa70083494fcd61738c7772dd43ea3bba148d40a6f9e7c3e762182885b53149",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "85"
      ]
    },
