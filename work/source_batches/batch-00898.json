      "source_text": "用美味向全国传达感谢！",
      "source_fingerprint": "269406091329996a088cdc4b90db5ea9cb017fab2e7791dec8e21d04f494c0a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "92"
      ]
    },
    {
      "uid": "zhcn:dd16c963e1b85ce923542060",
