      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "86"
      ]
    },
    {
      "uid": "zhcn:6a3123d26ff4ffb928a32c8e",
      "kind": "text_data",
      "source_text": "对全部加满的爆量味噌赞不绝口！",
      "source_fingerprint": "0ba278a862ab5291ac1ddca0d555fcc8f5421d219c76fb0200aa5ea5c183f3a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "87"
      ]
    },
    {
      "uid": "zhcn:bc58bfcaf10d079b263e121a",
      "kind": "text_data",
      "source_text": "突破食欲极限的一碗带来超满足！",
