      ]
    },
    {
      "uid": "zhcn:87f6687d36b6714f20e8f72b",
      "kind": "text_data",
      "source_text": "拉面嘉年华",
      "source_fingerprint": "b717e5841539f2f18d1fa5a853004d4cac3f119a3c1d40b56cac4c5cc0ac7330",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "1"
      ]
    },
    {
      "uid": "zhcn:0945bf972f3a6eeaa3dabefc",
      "kind": "text_data",
      "source_text": "以正宗拉面令粉丝着迷",
      "source_fingerprint": "8c50e8f52aff5cabb5c7acee0b523b1f712c871c7ca7ccf2404ddb706b1ea8df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "10"
      ]
    },
    {
      "uid": "zhcn:909555758dcd26804c70244f",
      "kind": "text_data",
      "source_text": "在特雷森轩的招牌下，拉面嘉年华于<region_name>举办！",
      "source_fingerprint": "25d156e4730fd7608a4a03bb83f563dabbaafc1bbe0065713fe58c4df6c9eaee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "100"
      ]
    },
    {
      "uid": "zhcn:ff40a1f3559b9559f0911d56",
      "kind": "text_data",
      "source_text": "为了向各地款待拉面，特雷森轩于<region_name>特别开店！",
      "source_fingerprint": "4f52ba594d87c5b30fc70fdcb498128d20019d0fa440493bfa5e35e7059b47cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "101"
      ]
    },
    {
      "uid": "zhcn:8f16a1a87bf719bf3af55a53",
      "kind": "text_data",
      "source_text": "<character_name>等人款待手工拉面的活动，吸引了众多粉丝到场。",
      "source_fingerprint": "e7cfd8867c7f141c3eebc35f76584defa914ca63d86818f8eace55fde13dcada",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "102"
      ]
    },
    {
      "uid": "zhcn:b0edb946598322580d0a5404",
      "kind": "text_data",
      "source_text": "口味地道的拉面引发了巨大反响，在当地卷起了一股强大的拉面旋风。",
      "source_fingerprint": "206eebf41143cfeee9acb53455f07a5b597b0c172828f2c4025fba23c4f05a84",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "103"
      ]
    },
    {
      "uid": "zhcn:a67c8b8c31094e4d9aa646e7",
      "kind": "text_data",
      "source_text": "款待了亲手制作的<ramen_name>，向粉丝和当地人们传达了感谢。",
      "source_fingerprint": "6a3e7854b3c4e8aa10529cdfe6f3ba94f59beba808b41433b88bded207d67b1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "104"
      ]
    },
    {
      "uid": "zhcn:63452ddd2ad35441e2f60cd7",
      "kind": "text_data",
      "source_text": "施展在修行中磨炼的手艺，充满元气的招待与出色的<ramen_name>大受好评！",
      "source_fingerprint": "9306270b08e8868ec0d85018406e1b22613c9381c1a0a2a08ac723d0b9415db7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "105"
      ]
    },
    {
      "uid": "zhcn:f6e16b012a450c27381355cc",
      "kind": "text_data",
      "source_text": "作为四处品尝与试做成果的<ramen_name>，是连当地粉丝都拍胸脯保证的佳作。",
      "source_fingerprint": "a327ac126cb7ee01d3ac4bbc89c60d663a9c1f4bd10455db754e88d26552c085",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "106"
      ]
    },
    {
      "uid": "zhcn:e957aaeb9920536624b83c5c",
      "kind": "text_data",
      "source_text": "许多人为了品尝<ramen_name>而来，首次举办便让会场迎来了大盛况。",
      "source_fingerprint": "0127ef2cda0b98ed5e2b1a415cb52f7026098ab74a4c2a5649558403f3d70d88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "107"
      ]
    },
    {
      "uid": "zhcn:0d875d2ab3dbafa801b70744",
      "kind": "text_data",
      "source_text": "赛马娘们认真挑战的拉面引发了话题，达成了极高的动员人数。",
      "source_fingerprint": "382eb8c2cd0987d1322a3a73e99766cc0a03ae13c188f63aa500eee72c9de463",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "108"
      ]
    },
    {
      "uid": "zhcn:750db0d6feb49a747eab6807",
      "kind": "text_data",
      "source_text": "这碗旨在用拉面表达感谢、倾注了灵魂的拉面，让众多粉丝赞不绝口。",
      "source_fingerprint": "4f14740e321826a822a2dadbc5d3582602a6b1ed121fabfed9788e9f3389f68e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "109"
      ]
    },
    {
      "uid": "zhcn:1821f42267868559cacb2a0e",
      "kind": "text_data",
      "source_text": "<region_name>因众多来客而热闹非凡",
      "source_fingerprint": "f77bce5e28f1832be02ef3a7d59b994612d0e3555a80a674b9581cdcb4c0b7c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "11"
      ]
    },
    {
      "uid": "zhcn:d7e282a7871ac5e17c86d4d3",
      "kind": "text_data",
      "source_text": "对于满载讲究的<ramen_name>的正宗味道，惊叹之声连绵不绝。",
      "source_fingerprint": "2c7c900ec15e26e689f4602839054cfa3d1ae233771d7273b9dbc8813a2a4838",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "110"
      ]
    },
    {
      "uid": "zhcn:5d5de0f23a745993b8addbb6",
      "kind": "text_data",
      "source_text": "用精心制作的<ramen_name>，以干劲十足的首战装点了精彩的大盛况。",
      "source_fingerprint": "d07e41744cda242b760e7f34a7abace9be852fde3e5f0e4db0774c389bf8f837",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "111"
      ]
    },
    {
      "uid": "zhcn:952d33a063bdd833705a1aca",
      "kind": "text_data",
      "source_text": "以娴熟的烹饪和开朗的招待回应来客，全力款待了饱含感谢的拉面。",
      "source_fingerprint": "ecc4b02099236436f2e09d79bc92f459a4fb3613463282aa483446b4f08dfcfd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "112"
      ]
    },
    {
      "uid": "zhcn:5256565602ace2e4e1244ad6",
      "kind": "text_data",
      "source_text": "虽是崭新尝试的活动，却引发了热烈反响，完成了华丽的起跑冲刺。",
      "source_fingerprint": "707b24bd5a5ed32621c125c478e64b818dc0834bc4f24a6f37af1b0d85cae7ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "113"
      ]
    },
    {
      "uid": "zhcn:c9be6731b8e225445a1358dd",
      "kind": "text_data",
      "source_text": "以<ramen_name>为亮点的动员情况极佳，首次举办便达成了巨大的高潮！",
      "source_fingerprint": "3ded55b5b764d862d6252fe35a6466a356618a420375fd59d459d2063069d34f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "114"
      ]
    },
    {
      "uid": "zhcn:40fbb19cd945a555cd0ede3c",
      "kind": "text_data",
      "source_text": "从熬汤到甩干面汤，通过饱含热情的烹饪，向来场者送上了拉面。",
      "source_fingerprint": "30328021af32d7a3975865d332b6b3aa3fbed7289309a3db8fd774335ad2c090",
      "source_path": "text_data_dict.json",
      "json_path": [
        "464",
        "115"
      ]
    }
  ]
}
