    },
    {
      "uid": "zhcn:8cbd1d8d18dd24937dbc6147",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在比赛中盘时\\n回复持久力,并且稍微提升速度\\n＜作战・先行/居中＞",
      "source_fingerprint": "73a31b8f5fba9ec3df63f278329257e81d88be91196565f2cf7d6563986411de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
