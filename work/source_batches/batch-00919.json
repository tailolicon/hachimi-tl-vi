    },
    {
      "uid": "zhcn:1d8779b64b92d462e83ce9f8",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在比赛中后半段位于第一并拉开差距时\\n稍微加快速度",
      "source_fingerprint": "4c3a64b63994a4467ea7e4a74f4c5ee042b666d602a2501382c1c747266fd05c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
