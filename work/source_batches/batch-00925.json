    },
    {
      "uid": "zhcn:b155e1b01731a8431113f142",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在比赛中段消耗少量体力\\n使速度极大提升＜先行/居中＞",
      "source_fingerprint": "df886333a4a61d714f33fefec969f880c9f413ecdde3a96f433328f535156849",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
