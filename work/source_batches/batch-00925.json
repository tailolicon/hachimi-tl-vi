    },
    {
      "uid": "zhcn:ef3c84cf1c693c94a3a93ee3",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛终盘迫近时\n若位于前方则提升速度\n若是中距离比赛则额外\n稍微提升速度<作战·先行>",
      "source_fingerprint": "f9dd51ce14e9185ba3d887b4d73836c7819bb73d901115c4af11e5e9e405aa00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
