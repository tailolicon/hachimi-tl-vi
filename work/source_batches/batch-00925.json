    },
    {
      "uid": "zhcn:bb6187ee1315652e3436b870",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛中盘时若被团团包围\\n回复持久力,并稍微提升速度",
      "source_fingerprint": "178c8bc712a5c1d40b864f08fb6bf9bb7f664be5ab14d74b7ad69b8e152e96b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
      "json_path": [
