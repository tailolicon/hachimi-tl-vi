        "106201111"
      ],
      "json_pointer": "/48/106201111"
    },
    {
      "uid": "zhcn:1df8914d2213890aa5502186",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛终盘完成超越时,速度提升\\n并且微幅提升加速度、\\n稍微回复持久力＜长距离＞",
      "source_fingerprint": "b3a279ed645e3994f87a8ba7f79c9d37f3a8b2d7c47e91658948ea585e0cf89b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
