    },
    {
      "uid": "zhcn:9df2672065fc4473a8293e41",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在直线一段时间内速度提升\\n＜长距离＞",
      "source_fingerprint": "b4f6e12141d4ac19833c47b429bd218eaec3d6024c365020b6f746a552f58835",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
