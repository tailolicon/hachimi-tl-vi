    {
      "uid": "zhcn:9ac03d4b50851877c294988d",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "临近终盘的时候若位于中后方\\n速度大幅提升＜短距离/英里＞",
      "source_fingerprint": "3d95a40857ab7d2d55a502d0393cf2f94faad58219aba58f593821517ba9deae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
