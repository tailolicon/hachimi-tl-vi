    },
    {
      "uid": "zhcn:ddf088040903fad85f09aa3b",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛中盘时若身处前方\\n则一段时间内速度持续提升＜英里＞",
      "source_fingerprint": "25d7eb2abba4a5969c476b5ad7dde9710acc568b354dc0f24d4f1f7a907e13bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
