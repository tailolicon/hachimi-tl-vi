    },
    {
      "uid": "zhcn:a99340bf2da51c887385abd2",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛中盘以较大差距保持领先时\\n一段时间内速度持续提升＜长距离＞",
      "source_fingerprint": "3b8224228dcac689e886fe8593c2f14a98141f5b7e185171256b81a3c929ef2a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
      "json_path": [
