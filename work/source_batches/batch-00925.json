    },
    {
      "uid": "zhcn:ff55dc641c98984ac1788a06",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在比赛终盘处于第三名快要输掉的时候\\n激发昂扬斗志,速度少量加快",
      "source_fingerprint": "430997572a4b77d2219d7f94104d883bbda0a7ece21eb53c7958cc30aef418ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
