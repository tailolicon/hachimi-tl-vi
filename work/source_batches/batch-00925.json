    {
      "uid": "zhcn:8a1dfb7d7d68484cd51ec34d",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "身处下坡时,加速力提升\\n＜作战・先行＞",
      "source_fingerprint": "e3a8830a3f9bc71f388b1c15ccfa241a32e15411d99a19be309c520e1f75f438",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
