    },
    {
      "uid": "zhcn:3b6969449f3b857f927ffff6",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛终盘时前方遭遇阻挡时\\n一段时间内加速度持续提升\\n＜中距离＞",
      "source_fingerprint": "01bc75d94611e853f04165bd299e957acb3d22aee5e65996ad97817de2c17880",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
