      ],
      "json_pointer": "/48/106202221"
    },
    {
      "uid": "zhcn:a253c80d30d6177312ba5485",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛中期左右处于队伍中团时\\n重新振作,稍微回复持久力\\n并且略微提高速度",
      "source_fingerprint": "c8d2953c69a4be255bb94386a77ff5b36ef55972c9c567ad40451288c2024975",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
