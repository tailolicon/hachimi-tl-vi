    },
    {
      "uid": "zhcn:b7334f95bf8a44ccf70263c0",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "当有赛马娘长时间跟随身后时\\n一段时间内速度持续提升",
      "source_fingerprint": "77e82f431d3cba956e95e93952176ecc287d5db18ace68b708d957d730168742",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
