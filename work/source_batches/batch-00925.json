        "106101111"
      ],
      "json_pointer": "/48/106101111"
    },
    {
      "uid": "zhcn:82ccb1a85a9d0d5b63b1e184",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛中盘时,视野变得广阔\\n并且速度稍微提升\\n＜作战・居中＞",
      "source_fingerprint": "00cc1a5d5f226bfffc65f49c440dbe06feb1063501e1f9e961c4cae143069ae0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
