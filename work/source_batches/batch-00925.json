    },
    {
      "uid": "zhcn:5e788fe6b2e9e65616dc7c13",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛后半阶段时若身处中间集团\\n则一段时间内速度持续提升\\n并且微幅提升加速度＜作战・居中＞",
      "source_fingerprint": "5be81a590c3080fe3d690f2bafdbf6cc53adb4a53763b6b2e85b9d1ecd2cfe68",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105902111"
      ],
      "json_pointer": "/48/105902111"
    },
    {
      "uid": "zhcn:e699489eb3b9df625f81b1b1",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "在比赛后半段迅速向前突进\\n＜作战・居中＞",
      "source_fingerprint": "863754cf6f5dbc0256c799fec3a2aa3557226645240689f6da1ae420bbc23892",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
