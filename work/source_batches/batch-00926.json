    },
    {
      "uid": "zhcn:0e1be7b6b49f4bca92ffe9d0",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "比赛中盘开始时\\n大幅消耗持久力\\n使速度超大幅提升＜作战・领放＞",
      "source_fingerprint": "9da1ab35bc92e4009bfced1db5043128111ce5c15c6ad0c900af6bc2b795b3ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
