    {
      "uid": "zhcn:8995751f75cefcb92e767cf3",
      "kind": "text_data",
      "source_text": "在比赛终盘处于前方并超越对手时\\n会趁势向前突进\\n并且微幅提升加速度",
      "source_fingerprint": "d5075fe6797c70980e44df2895beb361c373dd287cc64d2a95425211a394a266",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "100011"
      ]
    },
    {
      "uid": "zhcn:1d8779b64b92d462e83ce9f8",
      "kind": "text_data",
      "source_text": "在比赛中后半段位于第一并拉开差距时\\n稍微加快速度",
      "source_fingerprint": "4c3a64b63994a4467ea7e4a74f4c5ee042b666d602a2501382c1c747266fd05c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "100021"
      ]
    },
    {
      "uid": "zhcn:6933b78c6e548ad1c6c1cef1",
      "kind": "text_data",
      "source_text": "在比赛终盘缩小与对手的差距时\\n就会在最终直线展现出华丽的步伐\\n大幅提升速度",
      "source_fingerprint": "2c334f8000686d127753f0f3d2af334a4cec990adb1ba967c42682f8df26d7c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "100031"
      ]
    },
    {
      "uid": "zhcn:f8a284cb6f154f170d97970b",
      "kind": "text_data",
      "source_text": "最终弯道后处于前列时\\n就会换挡提升加速度",
      "source_fingerprint": "06d20066ab5f226491c25bf2ed58a50cdd5a817ffa740733931550174067ca0b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "100041"
      ]
    },
    {
      "uid": "zhcn:2978c157d379971d02077c26",
      "kind": "text_data",
      "source_text": "在比赛终盘位于前列并突围时\\n在距终点300米处会变得更加闪耀\\n大幅提升速度",
      "source_fingerprint": "474a74f587e2da7a8340207eaef00399540308dd5ff0d0e7ff79bf0775587877",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "100051"
      ]
    },
    {
      "uid": "zhcn:e9f05ef47dee9a46de2a7127",
      "kind": "text_data",
      "source_text": "在最后200米处于前列时\\n能够开辟道路,很容易突围",
      "source_fingerprint": "25e7ef41d91e16585d8bbe63425dbf7d5ac4311560cce5f36a1981a3832e121b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "100061"
      ]
    },
    {
      "uid": "zhcn:a4403bd2a7bf11011f1b4c0a",
      "kind": "text_data",
      "source_text": "从比赛中段进行长距离冲刺\\n速度略微加快",
      "source_fingerprint": "c4f47551096c00a4eab46568f70391d450f2cdec61f285379fe4021cd894bb7b",
      "source_path": "text_data_dict.json",
      "json_path": [
