{
  "schema_version": 1,
  "batch": 930,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:86d7f26703f22355b8b1d4a3",
      "kind": "text_data",
      "source_text": "比赛中盘完成超越时\\n速度提升\\n并且稍微回复持久力",
      "source_fingerprint": "ed403a9fa97575246bcb927d39b3195a3e82e5eef1dc54755f986c252687b80a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "101902111"
      ]
    },
    {
      "uid": "zhcn:859ea2c6931121b6dc7f5288",
      "kind": "text_data",
      "source_text": "比赛中盘超过别人时\\n速度一段时间内加快\\n＜沙土＞",
      "source_fingerprint": "38cc815fc75a6330bf32ddec679ec9aba4f893f6eb29064e844be4e65b8d4178",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "101902121"
      ]
    },
    {
      "uid": "zhcn:e3d75043c18e3f1c035ae678",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处后方\\n则速度提升\\n并且稍微回复持久力＜沙土＞",
      "source_fingerprint": "a303f9ebefe2be0f48fc6b45c1c0d577d9498723ba780757e333afb726e48902",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "101902211"
      ]
    },
    {
      "uid": "zhcn:75cb57b25b81d74dc73ea336",
      "kind": "text_data",
      "source_text": "比赛中盘若是处于领先位置\\n并拉开较大差距的话\\n则一段时间内速度持续提升＜长距离＞",
      "source_fingerprint": "12694ea2c1ea713c345f1e089c3a423e123f9196cc5bddf6635f65cef7fdcea8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102001111"
      ]
    },
    {
      "uid": "zhcn:6d56cd9066678a657ecb2942",
      "kind": "text_data",
      "source_text": "比赛中盘回复大量体力\\n＜中距离＞",
      "source_fingerprint": "e9fa8273f8fd90274e481e5fb600b6656aa74f993e035782241fb384d48e6e8a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102001121"
      ]
    },
    {
      "uid": "zhcn:a404f178c2134fe2aed7eb80",
      "kind": "text_data",
      "source_text": "比赛中盘若是身处前方\\n则一段时间内速度持续提升\\n＜作战・领放＞",
      "source_fingerprint": "741cec6decc52376064dd4c10846f0e280ae7bf467d757fa4417d336ea5d1f61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102001211"
      ]
    },
    {
      "uid": "zhcn:2094e16da45f069ad2c3550d",
      "kind": "text_data",
      "source_text": "比赛中盘时若是身处前方\\n则速度提升\\n并且稍微回复持久力＜作战・领放＞",
      "source_fingerprint": "afc46449deef6c35ff293331014500432f196b540faae818ac2a2093bc7e3be9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102002111"
      ]
    },
    {
      "uid": "zhcn:f77499cfc2f9ca41ca247bf6",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时,速度大幅提升\\n＜作战・领放＞",
      "source_fingerprint": "7af6f0acf9b7875ddbb38f528408fbdbc53cfa627511371eefe83ad7c517aca7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102002121"
      ]
    },
    {
      "uid": "zhcn:b6218c129c441760d22150f3",
      "kind": "text_data",
      "source_text": "比赛序盘或是中盘被超越或\\n进行位置争抢时速度提升\\n并且稍微回复持久力＜作战・领放＞",
      "source_fingerprint": "06a3f6a0d9f969657efbc1235954fa8af3f61bfd255e6a658d96fced9689accc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102002211"
      ]
    },
    {
      "uid": "zhcn:53ab4cfcbff35d2b7ee99814",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时速度提升\\n若为草地比赛则极大提升\\n＜领放・中距离＞",
      "source_fingerprint": "bb278f1775ddf55e315556143ce805effe329f507644fa4e6707f7d572154438",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102003111"
      ]
    },
    {
      "uid": "zhcn:5d796a8fa18292cc24573f8e",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时速度提升\\n若为草地比赛且智力足够高\\n则极大提升＜领放・中距离＞",
      "source_fingerprint": "a02576080f5693fc1beb5f032c6fe8266db8659f49f0db1c9c2917adcae4febe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102003211"
      ]
    },
    {
      "uid": "zhcn:20f14a6986a62025a55977af",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处中间集团以后\\n速度大幅提升\\n＜作战・居中＞",
      "source_fingerprint": "e81de460b76c95c5a49dd915d9dcecdde36529148f37aad07867063f4419a8df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102101111"
      ]
    },
    {
      "uid": "zhcn:6370a4732cba273835f00718",
      "kind": "text_data",
      "source_text": "比赛中盘时位于中后方时\\n少量提升速度并回复少量体力\\n＜作战・居中＞",
      "source_fingerprint": "8885fb9d36e4c29753161937d53a79fc356589dc22cc28dccc0ef67a1c3f3ff8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102101121"
      ]
    },
    {
      "uid": "zhcn:2a8c6a70c54020ccc873295e",
      "kind": "text_data",
      "source_text": "若是在比赛中盘发动大量技能\\n则速度大幅提升",
      "source_fingerprint": "042f25e123344d005f1bcef54a831769f8373c6f7452f5e393e32ebda7517c66",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102101211"
      ]
    },
    {
      "uid": "zhcn:d57cc76724e9e09a28b05de9",
      "kind": "text_data",
      "source_text": "比赛中盘若身处前方\\n则速度大幅提升＜中距离＞",
      "source_fingerprint": "7a5e52a3db77728a99c08113dd1941bb9ace338e34ba54b1a77475edb2d754a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102102111"
      ]
    },
    {
      "uid": "zhcn:dd062d8cef6dcb93eaa1f198",
      "kind": "text_data",
      "source_text": "比赛中盘完成超越时\\n速度大幅提升",
      "source_fingerprint": "0a434c03afae378d74bb69c3d0459f64d8e93c1593a46ae9e6deb63bfc09eb92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102102211"
      ]
    },
    {
      "uid": "zhcn:868013d5ac7243560c03c404",
      "kind": "text_data",
      "source_text": "比赛中盘超过别人时\\n一段时间内速度提升",
      "source_fingerprint": "8240c367f52b81b93236d10a81d822396ec7ecc096ec7da87c0124c6578fa3fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102102221"
      ]
    },
    {
      "uid": "zhcn:17adf2f48f38fcb352196649",
      "kind": "text_data",
      "source_text": "在最终弯道位于前方时\\n速度大幅提升\\n＜作战・先行＞",
      "source_fingerprint": "bbb50b6fbb743d37c6273d5567ff85d753c50006d464a622ab96df26229bcf5d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102201111"
      ]
    },
    {
      "uid": "zhcn:1724683cba1db9f220eecc28",
      "kind": "text_data",
      "source_text": "在最终弯道位于前方时\\n一段时间内向前突击＜先行・中距离＞",
      "source_fingerprint": "e216498fe8bbb1ddd21865ad0fbbe6f245c4da7535b7e7c91afba8c7c1f8d5ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102201121"
      ]
    },
    {
      "uid": "zhcn:cc384418ef530a5cba92da08",
      "kind": "text_data",
      "source_text": "身处下坡时,提升加速度\\n＜作战・先行＞",
      "source_fingerprint": "4af60dd33afde7e5656e2d58d838386c60629d982e5ec7c1edd6a0f42e4be87e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102201211"
      ]
    },
    {
      "uid": "zhcn:9f4258362409676015fec931",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方\\n则速度大幅提升＜英里＞",
      "source_fingerprint": "fbc0dfd3689847d088a222078746b144e7b80671ed52160c290c7628016d1a73",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102202111"
      ]
    },
    {
      "uid": "zhcn:9a7bcdfa04c29ecb63cfe928",
      "kind": "text_data",
      "source_text": "比赛终盘开始时若身处前方\\n则加速力提升\\n并且视野稍微变得宽广＜作战・先行＞",
      "source_fingerprint": "4650d4d721c6cd35dd2d7985d790c21c3b1dcda4e022d94b1ee4aed797d0f606",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102202211"
      ]
    },
    {
      "uid": "zhcn:cd49fea0d32b4fa991d0eedd",
      "kind": "text_data",
      "source_text": "比赛终盘初段位于前方时\\n提高加速度\\n并在比赛剩余300m之后速度稍微提升\\n＜作战・先行＞",
      "source_fingerprint": "183c886a07257342dce377fad633257250d3845c09f87ce5417920c1fe472fb3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102202221"
      ]
    },
    {
      "uid": "zhcn:09029a8d7dab20b5d8ffb12e",
      "kind": "text_data",
      "source_text": "临近终盘位于前方时速度提升\\n若固有技能已发动,则之后\\n进入最终盘时无视固有技能的条件\\n再次发动一次＜中距离＞",
      "source_fingerprint": "faf4a4c8e765ffa6d41c110b87a680d93caa6239000971514d62b40e68e8c71b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102203111"
      ]
    },
    {
      "uid": "zhcn:d35520e53b0002fa441259b7",
      "kind": "text_data",
      "source_text": "在赛事中盘速度大幅提升\\n＜作战・先行＞",
      "source_fingerprint": "d382b3925d4e68eadd84d0df861c900811837826202d037618ea4bc396ce3911",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102203211"
      ]
    },
    {
      "uid": "zhcn:10fdd9f31f6569cbe8b005b5",
      "kind": "text_data",
      "source_text": "临近比赛中盘时若身处前方\\n则大幅回复持久力＜作战・先行＞",
      "source_fingerprint": "d75d85e1652e3afea83429d16b4b0016132d2aa32eeddfeeb7a96d5aba7e73bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102301111"
      ]
    },
    {
      "uid": "zhcn:2059be29c2dbd936e18b7812",
      "kind": "text_data",
      "source_text": "比赛中盘,大幅回复持久力\\n＜长距离＞",
      "source_fingerprint": "37e8a896714460a28b2f27f0eac774ccc429f81521cc4f51c001f5db78c33a79",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102301211"
      ]
    },
    {
      "uid": "zhcn:0254eab1078ec80a207ae372",
      "kind": "text_data",
      "source_text": "成功完成超越时\\n大幅回复持久力＜长距离＞",
      "source_fingerprint": "4740bcc6aae7dd9bbb81dca8d695499a850d9a3c6f5f11f41a0dc4678c2a5e95",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102302111"
      ]
    },
    {
      "uid": "zhcn:cbbf27352ad048a384a88a7c",
      "kind": "text_data",
      "source_text": "在最后冲击阶段的关键时刻\\n速度大幅提升",
      "source_fingerprint": "5c854cb6ff0d1fb95b6adf56a05abdc1b4253c656e08a06b49e8bddf82d2dafe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102302211"
      ]
    },
    {
      "uid": "zhcn:a585af1bcc9725342df1bf66",
      "kind": "text_data",
      "source_text": "在终盘初期更早时间内\\n消耗少量耐力,极大幅提升加速度\\n＜先行・长距离＞",
      "source_fingerprint": "88471523865bcc48ee84d54864beb594ade212cb3b01ca3039e51511a1f90423",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102303111"
      ]
    },
    {
      "uid": "zhcn:3b5bdaef56058eb5ac3a8ee3",
      "kind": "text_data",
      "source_text": "比赛中盘初期回复耐力\\n之后在临近比赛终盘的位置\\n一段时间内速度少量提升\\n＜先行・长距离＞",
      "source_fingerprint": "124a5f843aeeb89abb07ba838e1c4179e0ef582c6566d587df5cc249ec5e2e1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102303211"
      ]
    },
    {
      "uid": "zhcn:60a5fe905416930cb9be0182",
      "kind": "text_data",
      "source_text": "在中盘直线大幅回复体力",
      "source_fingerprint": "f49dbded22aa6acb840e20e84b9af7202adcaefbb98a62fe52f1bc91df6f4daa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102401111"
      ]
    },
    {
      "uid": "zhcn:5420e9ec89a8fb151e59de75",
      "kind": "text_data",
      "source_text": "在最后冲刺阶段时若前方堵塞\\n变得更擅长回避\\n并且稍微回复持久力",
      "source_fingerprint": "63b94f404897508cd2a5d7830cdb02444b68045ab9fe6ad2952e61c579e2a62b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102401211"
      ]
    },
    {
      "uid": "zhcn:91f22ad64deb7c221b5b6158",
      "kind": "text_data",
      "source_text": "比赛中盘时若前方堵塞\\n则速度稍微提升\\n并剥夺前方赛马娘的体力＜中距离＞",
      "source_fingerprint": "6aa9b5a0847586fefc396771bdb4857f2b6b8546764656e42d92a86e6dd2cb62",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102402111"
      ]
    },
    {
      "uid": "zhcn:ce294c985fb0f8fdd62ee425",
      "kind": "text_data",
      "source_text": "以利落的动作过弯\\n大幅回复持久力",
      "source_fingerprint": "126625a9be697ca6650d16aecf6b7b8c5b58a8f31a2447a7ed3f7baa8d04532c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102402211"
      ]
    },
    {
      "uid": "zhcn:e233548459c06570ad521e4e",
      "kind": "text_data",
      "source_text": "在最后冲刺阶段的直线若位于前三\\n则提升加速度,若此时为第一名\\n则消耗少量耐力将技能持续时间变为2倍\\n＜领放・长距离＞",
      "source_fingerprint": "9fcc6c713e6a5b836143d6ff511964f4178e2a22aeb26b57fab0af26fc56e043",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102403111"
      ]
    },
    {
      "uid": "zhcn:eab4ae6595840a54b1df5617",
      "kind": "text_data",
      "source_text": "在比赛中盘位于前方时\\n一段时间内速度少量提升\\n之后在最终直线稍微向前突进\\n＜作战・领放＞",
      "source_fingerprint": "445d33b9ba9fc69cc9bdeb23ee692a887b4139db090ea71ab490f3a97e0c4d50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102403211"
      ]
    },
    {
      "uid": "zhcn:e969cd5fe9688cb212148533",
      "kind": "text_data",
      "source_text": "最终弯道之后处于前列进行名次争夺时\\n在直线上略微容易突围",
      "source_fingerprint": "1750b242f6d3edb6dc5e9cdbc86714c89bad1123bba29e952fdeb2d5879064c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "10241"
      ]
    },
    {
      "uid": "zhcn:cf2c36e34b37d6efd4db7895",
      "kind": "text_data",
      "source_text": "比赛中盘时若位于中间集团之后\\n回复持久力,并稍微提升速度\\n＜作战・居中＞",
      "source_fingerprint": "f1c38d6d8d7f48e6781319ef94b9d8920b6fb1eb579b8ef0dadada42b3e7446d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102501111"
      ]
    },
    {
      "uid": "zhcn:96c6b98a8145caa9606dd5aa",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处后方\\n则稍微剥夺前方赛马娘的持久力\\n并稍微提升自己的速度＜长距离＞",
      "source_fingerprint": "f66fef462ca5a9aebb8bab00f3b800c666ae7b0c06c436028f76fa3c1edc94d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102501211"
      ]
    },
    {
      "uid": "zhcn:1a760d6e963cf9c933b6f8e2",
      "kind": "text_data",
      "source_text": "在最后冲刺阶段的直线上加速度提升\\n之后在最终直线处速度稍微提升\\n＜作战・追赶＞",
      "source_fingerprint": "e54b9defd6ecf3a14d7fa7ef63b280db05a2a14bbc05173ff0ae61bb7956f7b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102502111"
      ]
    },
    {
      "uid": "zhcn:50598c5d1bd124dcc8f8935b",
      "kind": "text_data",
      "source_text": "在终盘初段余力十足的话\\n向前迅速突进\\n＜追赶・长距离＞",
      "source_fingerprint": "79c1f9345cbcf4cf13d567375f7a7e0a3f41a1c0c3fea5e7dda0fb2511ddb8aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102502211"
      ]
    },
    {
      "uid": "zhcn:2dae72e61866391576072058",
      "kind": "text_data",
      "source_text": "进入最终弯道时向前突进\\n根据爬完上坡的次数\\n最多可增加4次效果时间\\n＜居中・长距离＞",
      "source_fingerprint": "bfa25d6b73eeb246d9a12cb69a942cb2fdaf7961befe7ecc40ade6b76df0c7b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102503111"
      ]
    },
    {
      "uid": "zhcn:7031348818928f626d113067",
      "kind": "text_data",
      "source_text": "若处于最后冲刺中\\n则加速度大幅提升＜居中・长距离＞",
      "source_fingerprint": "4fa7370157c16c0ef41cacc1d11fc99b984b5bc504cb5ada40790647337dc61f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102503211"
      ]
    },
    {
      "uid": "zhcn:103f52f5616a6ab977b60b17",
      "kind": "text_data",
      "source_text": "比赛开始时,大幅提升加速力\\n＜作战・领放＞",
      "source_fingerprint": "857488fa451bef2f49fab1ac5e095a7e36c0b13b2ac300dcba8efdc24aaabf07",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102601111"
      ]
    },
    {
      "uid": "zhcn:74628e751bab1345662265c4",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方\\n则回复持久力,并稍微提升速度\\n＜中距离＞",
      "source_fingerprint": "cf9b07b1b8d3fa27783ba40d24cc62036333a5f2238e9815ec5fd3f0250ca2ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102601211"
      ]
    },
    {
      "uid": "zhcn:0370b1d3929235eb02804f9e",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方\\n则提升速度\\n并且稍微回复持久力＜作战・领放＞",
      "source_fingerprint": "1fdd4c7b347c1308a4164307440bd019f57c0b7231c1c40a211483bf8bfb6b6e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102602111"
      ]
    },
    {
      "uid": "zhcn:59b175f6863fac9ad1b1a9b1",
      "kind": "text_data",
      "source_text": "智力若有十二分高超,则临近\\n比赛终盘位于前方时,一段时间内\\n速度提升＜作战・领放＞",
      "source_fingerprint": "b849981c0459bf83e418abd32bf05fdd4ee7ac1edf008cd956d62216deeb6fe3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102602121"
      ]
    },
    {
      "uid": "zhcn:070a843aa44b251e1d32204d",
      "kind": "text_data",
      "source_text": "起跑晚的时间小幅减少\\n并且所有基础能力稍微提升",
      "source_fingerprint": "8b92e969dda006df8abc13abcb523c810c8a21ab53a6b2ed26094792d2f183e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102602211"
      ]
    },
    {
      "uid": "zhcn:83b539651d4aa2fd57b1422a",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方\\n则速度大幅提升＜中距离＞",
      "source_fingerprint": "6ab865343e8d2cc7bb11ba21bb5f4c18a8900cd98590b35dbb75747988f7955f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102701111"
      ]
    },
    {
      "uid": "zhcn:71bb15d3c2406a570f5723c2",
      "kind": "text_data",
      "source_text": "在最终弯道时从外道完成超越时\\n速度大幅提升＜作战・居中＞",
      "source_fingerprint": "b9c57f3c281bffe2f547b89b8104e230ee00825d1977986fbf1e0a116423d0d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102701211"
      ]
    },
    {
      "uid": "zhcn:f78b4982d6e71025a8322294",
      "kind": "text_data",
      "source_text": "身处下坡时,提升加速度\\n＜作战・先行＞",
      "source_fingerprint": "4af60dd33afde7e5656e2d58d838386c60629d982e5ec7c1edd6a0f42e4be87e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102702111"
      ]
    },
    {
      "uid": "zhcn:1fc0ac849458268708fe7be9",
      "kind": "text_data",
      "source_text": "身处下坡时,速度大幅提升",
      "source_fingerprint": "155a23095188637c0c9c48e70cc4b0bc0bd98834214feccb9d679a4673255b7f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102702211"
      ]
    },
    {
      "uid": "zhcn:bf33bcd2beb4be0df8a71f3c",
      "kind": "text_data",
      "source_text": "在下坡时一段时间内速度提升",
      "source_fingerprint": "44b6f03b421a406cb234693d5e34e36aaf4abecfae3a460e1d1e296447e0f1bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102702221"
      ]
    },
    {
      "uid": "zhcn:1a696489def5ebbb9c146557",
      "kind": "text_data",
      "source_text": "在比赛终盘的弯道中想要冲向前列时\\n提升加速度",
      "source_fingerprint": "7020a63ff37e8a00ba918e07017c6fd8eea90784ca102e9e3f45761c3d08a717",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "10271"
      ]
    },
    {
      "uid": "zhcn:b916cbfb026a134840e847cd",
      "kind": "text_data",
      "source_text": "比赛中盘时,一段时间内路线选择\\n变得更明智,小幅提升加速度\\n并且稍微提升速度＜短距离＞",
      "source_fingerprint": "192417208823660333f6bbb41b1f74c30f1460e370c8cca7f7977596579e8552",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102801111"
      ]
    },
    {
      "uid": "zhcn:2d60b7a2f7dc4fc8435a08ca",
      "kind": "text_data",
      "source_text": "临近终盘时回复少量体力\\n一段时间内速度少量提升\\n＜作战・先行＞",
      "source_fingerprint": "6b5696515d56db87780aace21e284bedfc40ca521d6b75dbb78b7f9d4779ce20",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102801211"
      ]
    },
    {
      "uid": "zhcn:2e6bd61955a7ff5133565430",
      "kind": "text_data",
      "source_text": "在比赛中盘消耗少量体力\\n使速度极大提升\\n＜先行・短距离＞",
      "source_fingerprint": "3cb87c1940c7b6592455b8f94549bd376f8c979fd4b81df9af2d564b234a2ac1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102801221"
      ]
    },
    {
      "uid": "zhcn:50bd00070bd8a26458cc6828",
      "kind": "text_data",
      "source_text": "在比赛中盘速度会大幅提升\\n＜短距离/英里＞",
      "source_fingerprint": "ed92d32868a71d005c4b070e722da806a67b4686553c5ca474f9410571bba1dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102802111"
      ]
    },
    {
      "uid": "zhcn:4b35c2040f7107efd372a48c",
      "kind": "text_data",
      "source_text": "在比赛终盘的初期位于前方时\\n加速力会提升，在短距离或英里\\n比赛中则会大幅提升＜作战·先行＞",
      "source_fingerprint": "13f0355873aaf40ee17ad7f9bb1120d63fb8670310ae92140546daf202c60b89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102802211"
      ]
    },
    {
      "uid": "zhcn:c5cc7b3f8b2f8c459444d743",
      "kind": "text_data",
      "source_text": "最后冲刺阶段时若前方堵塞\\n则一段时间内加速度持续提升\\n路线的选择稍微变得明智",
      "source_fingerprint": "1f3e6add71490750985c4382d2922f0e7ba4d5f8e97a6c11439257ecc5de09f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102901111"
      ]
    },
    {
      "uid": "zhcn:149e5d3fd8e314394f0a478c",
      "kind": "text_data",
      "source_text": "身处下坡时\\n一段时间内加速度持续小幅提升\\n＜作战・先行＞",
      "source_fingerprint": "b0b7ac501fa3794043a17c209d8e88091e296edfe66782d007ba8ef411d151eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102901211"
      ]
    },
    {
      "uid": "zhcn:468ef6debd7af1caf7c0d9f3",
      "kind": "text_data",
      "source_text": "在下坡处加速度少量提升\\n并在比赛剩余300m之后速度稍微提升\\n＜作战・先行＞",
      "source_fingerprint": "90a4b2f59b07db00acf511fa2d12b9294364d72babee25612fc8898dbb26876c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102901221"
      ]
    },
    {
      "uid": "zhcn:148bdedb1d92fcfbe03661c3",
      "kind": "text_data",
      "source_text": "在比赛中盘速度大幅提升\\n＜作战・先行＞",
      "source_fingerprint": "286bca01bfae67bc12dab49130dda371ec7fc0254149faeaf977736cbfa24cf2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102902111"
      ]
    },
    {
      "uid": "zhcn:84a527c4d7961316684c7532",
      "kind": "text_data",
      "source_text": "在弯道提升加速度\\n并稍微提升速度",
      "source_fingerprint": "f824c32a58b2c2a3e51e54fb5e380e693567e0bec5beb8a5c4173cc5413871d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102902211"
      ]
    },
    {
      "uid": "zhcn:f5253999ef466a97308c8f8c",
      "kind": "text_data",
      "source_text": "在最终弯道提升加速度\\n若是草地比赛则一段时间内\\n提升加速度＜英里＞",
      "source_fingerprint": "108cbe81b17a108e27e675d61f6cf13a36eb463ff212bcf45b20e9067855d9e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "102902221"
      ]
    },
    {
      "uid": "zhcn:7b8a743b5e4ada8c73d943ad",
      "kind": "text_data",
      "source_text": "处下坡时,加速度小幅提升\\n并稍微向前突进\\n＜作战・先行＞",
      "source_fingerprint": "e86695e07af0b98e4f11e3c800245b03f117d8a6b3aac72fb49e80d21f1722ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103001111"
      ]
    },
    {
      "uid": "zhcn:488eed2a850a28dab7650283",
      "kind": "text_data",
      "source_text": "比赛中盘时回复持久力\\n并稍微提升速度＜长距离＞",
      "source_fingerprint": "54b629ff3bf9a091a092da93367762a285a481370575d43162d70888b5f84e1c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103001211"
      ]
    },
    {
      "uid": "zhcn:3f9d12f4dcbc975cbb979d50",
      "kind": "text_data",
      "source_text": "临近比赛中盘时若身处前方\\n回复持久力并稍微提升速度\\n＜作战・先行＞",
      "source_fingerprint": "008fd763915d4fedb7d146a371c687b06b27d3c23bce743b5df3eb0b618e1e50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103002111"
      ]
    },
    {
      "uid": "zhcn:b95a52ba61aa679de33246cd",
      "kind": "text_data",
      "source_text": "比赛终盘时若身处前方\\n剥夺后方焦躁赛马娘的体力\\n并稍微提升速度",
      "source_fingerprint": "f9aacb863cab1cc823eea3b3aade383fa0e711e77d1de17781373470a65559ab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103002211"
      ]
    },
    {
      "uid": "zhcn:910078abf17348093c1a2fb5",
      "kind": "text_data",
      "source_text": "在比赛后半段的上坡提升加速度\\n＜作战・先行＞",
      "source_fingerprint": "77b3f6e61222c588b094addfa969c9ee21d871c779a93d243bbc1b77c002eaab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103003111"
      ]
    },
    {
      "uid": "zhcn:66ef47918d47c59ed423df4d",
      "kind": "text_data",
      "source_text": "擅长在京都竞马场的比赛\\n速度、耐力和智力大幅提升",
      "source_fingerprint": "90461cf76395a19a91f854e69f8ab07b8030e67ef0260f310e9c190a6c7d540c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103003211"
      ]
    },
    {
      "uid": "zhcn:aff6711ec48c65dd6c0df023",
      "kind": "text_data",
      "source_text": "身处上坡时回复持久力\\n并且稍微提升速度\\n＜作战・领放＞",
      "source_fingerprint": "348d6a8724b079e0e32c7c7a270ad8307d8fa375b775bf5c65f63738644996f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103101111"
      ]
    },
    {
      "uid": "zhcn:7a5bf9dffaeecfaa875b2778",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方,则一段时间内\\n身后赛马娘的速度持续稍微下降\\n并提升自己的速度＜中距离＞",
      "source_fingerprint": "b6034c43b9f029c49d7ab662bbe10bcf82d5d0bb3cf38e2a999fa8a7a79b61b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103101211"
      ]
    },
    {
      "uid": "zhcn:7608cd7ae3321166b2122efa",
      "kind": "text_data",
      "source_text": "出闸时起跑晚的时间小幅缩短\\n并且所有基础能力微幅提升",
      "source_fingerprint": "98ed797cab576363817bacaf047f30ee1843298e38782dc56f032cb2b5f51a9b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103102111"
      ]
    },
    {
      "uid": "zhcn:1f15384394a7e07d1a3a996f",
      "kind": "text_data",
      "source_text": "在弯道上速度提升\\n并且稍微提升加速度＜作战・领放＞",
      "source_fingerprint": "931f23434624250844d2fa333998ee34336c87924d7310a9ed1783bb529ab2dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103102211"
      ]
    },
    {
      "uid": "zhcn:60e25e0bec12f0591d0c9715",
      "kind": "text_data",
      "source_text": "出闸时加速度大幅提升＜中距离＞",
      "source_fingerprint": "5eab0693322d6094c90ded8fc6c68347e3e2711237c8c136fd3fb724474be0b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103103111"
      ]
    },
    {
      "uid": "zhcn:e18fa97199d852fdf8b6166e",
      "kind": "text_data",
      "source_text": "长时间有紧跟在自己身后的马娘时\\n速度提升,若是中距离比赛\\n则额外稍微提升速度",
      "source_fingerprint": "9e73c8bcc225444b3d8fd71c60c2d700619ea5a4d89ce80bf9eac8994ed716d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103103211"
      ]
    },
    {
      "uid": "zhcn:7f0e4e165b761e7082ea7eba",
      "kind": "text_data",
      "source_text": "比赛终盘时速度大幅提升\\n＜中距离＞",
      "source_fingerprint": "891bee704f1763d0b6bfcecc1b8342428d3b5538b8ef073ea9b12ccb9c775c13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "103201111"
      ]
    },
    {
      "uid": "zhcn:34db6f3c410e930d4daf41fd",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方\\n则回复持久力,并稍微提升速度\\n＜作战・先行＞",
      "source_fingerprint": "adc9c411403cfc8cf437a4bfa8f7259f4f4b46748421e834b1d660d8fc2df04b",
      "source_path": "text_data_dict.json",
