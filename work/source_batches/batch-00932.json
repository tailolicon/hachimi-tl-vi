{
  "schema_version": 1,
  "batch": 932,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:060f324aa3f47f6fcc6a9b8f",
      "kind": "text_data",
      "source_text": "比赛中盘进行名次争夺时速度提升\\n并且稍微回复持久力＜沙土＞",
      "source_fingerprint": "3a27bcd9ecb93bd76f83e267033cc3c2b10ba925dff451cf8de77c53a86b6532",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104601211"
      ]
    },
    {
      "uid": "zhcn:d5bf9e997791d61577072892",
      "kind": "text_data",
      "source_text": "比赛中盘进行名次争夺时速度提升\\n并且稍微回复持久力＜沙土＞",
      "source_fingerprint": "3a27bcd9ecb93bd76f83e267033cc3c2b10ba925dff451cf8de77c53a86b6532",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104602111"
      ]
    },
    {
      "uid": "zhcn:defcc1d7956b17aa48b4ad2a",
      "kind": "text_data",
      "source_text": "在比赛中盘进行名次争夺时\\n速度大幅提升＜沙土＞",
      "source_fingerprint": "96305d04978934cf370d03a79281fa1f717502da12b80e56d04dff7167355f19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104602121"
      ]
    },
    {
      "uid": "zhcn:aa540133fd9808cc6394a04b",
      "kind": "text_data",
      "source_text": "比赛终盘时若身处前方\\n则加速力大幅提升＜沙土＞",
      "source_fingerprint": "b2de559362d11c25afac39f289e0aea3239a840d0a74836e5700e0bb095e4f1f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104602211"
      ]
    },
    {
      "uid": "zhcn:316ee7644b8b8c66febd4b50",
      "kind": "text_data",
      "source_text": "起跑时晚起跑的时间减少\\n并稍微提升加速度",
      "source_fingerprint": "07649f659a8643d156a98e39d75aee769129ab7f0697256723b0b73dc295f9a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104603111"
      ]
    },
    {
      "uid": "zhcn:404c6af5b76bf1c1158f0fd5",
      "kind": "text_data",
      "source_text": "比赛中盘发动技能时速度提升\\n之后在比赛终盘发动技能时,小幅向前突进\\n并额外提供微量加速度＜逃马・泥地＞",
      "source_fingerprint": "7c76804fbdccb8d05990b76c846bcad910ed92f4594ed2fd794ade70e9c60ffe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104603211"
      ]
    },
    {
      "uid": "zhcn:cc1b45b6eb4165358ddeea62",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方\\n则大幅回复持久力\\n＜作战・先行＞",
      "source_fingerprint": "fdf21e7caf36f30669d41a936c00f159b998bcedcd6110c4c5486cf7d428c578",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104701111"
      ]
    },
    {
      "uid": "zhcn:5b8fc5298cb8acda6318618c",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时\\n稍微回复体力并提升速度\\n＜作战・先行＞",
      "source_fingerprint": "efb3e6d14d7880a608cfb58f88e24586721277e89e6eb2f1a96a67be87a79308",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104701121"
      ]
    },
    {
      "uid": "zhcn:13b49e37a004f3d78f01e53d",
      "kind": "text_data",
      "source_text": "身处弯道时,速度大幅提升\\n＜中距离/长距离＞",
      "source_fingerprint": "a15f8686be75acfddab450ba42077abd76831cd91d9d9665ea8564a0da447af2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104701211"
      ]
    },
    {
      "uid": "zhcn:20591545d1458283dd557a9f",
      "kind": "text_data",
      "source_text": "在临近比赛终盘的直线上\\n速度大幅提升\\n＜作战・先行＞",
      "source_fingerprint": "292bda2496d1daa6afb1e2a82060b896c9b03f8cc17f17a20fef5cdbc5fe9535",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104702111"
      ]
    },
    {
      "uid": "zhcn:32b38bd26c649668ab2a9a58",
      "kind": "text_data",
      "source_text": "擅长秋天和冬天的比赛\\n速度和力量大幅提升",
      "source_fingerprint": "bfdf4b5228dd5cfafc757b854208573392aa44b769b274084d85ceb7f4b55d5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104702211"
      ]
    },
    {
      "uid": "zhcn:ce71c349e5e045c470e18580",
      "kind": "text_data",
      "source_text": "比赛终盘开始时加速度提升\\n并且稍微回复持久力\\n＜先行/居中＞",
      "source_fingerprint": "f4052fba43fe0b6d66f7223781320faae559284b885aa3f8868294224b8ebd13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104801111"
      ]
    },
    {
      "uid": "zhcn:315ab0f31d7156d95c66cef1",
      "kind": "text_data",
      "source_text": "比赛中盘时回复持久力\\n并稍微提升速度\\n＜先行/居中＞",
      "source_fingerprint": "586816008a896fe1015664470105c7dbfd665bba72bf66c3fe01378858044a77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104801211"
      ]
    },
    {
      "uid": "zhcn:5668861b3e5c7d6e368dbd48",
      "kind": "text_data",
      "source_text": "在最终弯道位于队伍中后方时\\n加速度提升,若是东京竞马场\\n则额外提升少量速度＜中距离＞",
      "source_fingerprint": "ee9e34b3925c323d89d86b0446b9f3332c6e84dcdb6616ad2994a566cdac3c26",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104802111"
      ]
    },
    {
      "uid": "zhcn:51b5b51954c594de82056ea5",
      "kind": "text_data",
      "source_text": "在最终弯道位于队伍中间时速度提升\\n若是东京竞马场的中距离比赛\\n则额外稍微提升加速度＜作战・居中＞",
      "source_fingerprint": "138f84619234493d16b29a49f2ca5a3f2557a2dddda0398ce632660bde7e6ea4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104802211"
      ]
    },
    {
      "uid": "zhcn:15018a627a9175bbcd0e9510",
      "kind": "text_data",
      "source_text": "比赛终盘初期位于中间集团时\\n大幅向前突进,若是东京竞马场\\n则以极快速度向前突进＜居中・中距离＞",
      "source_fingerprint": "7492d753c5b9abeb99023a67c61daf04fe57d838643abaf6c8337e539763d5f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104802221"
      ]
    },
    {
      "uid": "zhcn:9a6b4851b310cd8c3fbfd907",
      "kind": "text_data",
      "source_text": "在比赛中盘的直线上，一段时间内\\n速度会提升，发动技能时\\n若与领头马相距4个马身以上\\n则效果增加＜中距离/长距离＞",
      "source_fingerprint": "6c19b9c3fa56709d4034231170849f62a90730b7813c022f1b0dbabddfc147b1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104803111"
      ]
    },
    {
      "uid": "zhcn:dfc5d4f4061000dfa6e305a7",
      "kind": "text_data",
      "source_text": "在2000m以上的比赛中，于终盘的\\n最终弯道加速力会大幅提升\\n在长距离比赛中效果会改变，变为\\n在一段时间内略微向前冲出＜先行/居中＞",
      "source_fingerprint": "a334e137832adbbaeac80b5ade113ca58b7a4d5e09a1d321d279dde1984411a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104803211"
      ]
    },
    {
      "uid": "zhcn:ff41a32ffc8c8adaf891d998",
      "kind": "text_data",
      "source_text": "比赛后半阶段时,速度超大幅提升\\n但也有可能同时消耗大幅持久力",
      "source_fingerprint": "91524108568f926d55a6a5bbc316540e9f7606e81610c10dbcf36ca84f455d89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104901111"
      ]
    },
    {
      "uid": "zhcn:2dc8d877f9e17116cd7ad496",
      "kind": "text_data",
      "source_text": "偶尔能在比赛中爆发出更强大的实力\\n速度、力量、根性超大幅提升\\n人气排名越低越容易生效",
      "source_fingerprint": "9ed0658d71cb931b6be2ffb93119bd0a5a901ad00f18ef68b0dd21707fb6ee7b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104901211"
      ]
    },
    {
      "uid": "zhcn:1051fdbf8c76160b51f73bdb",
      "kind": "text_data",
      "source_text": "最终直线位于领头或距离领头4马身以内\n时速度大幅提升，此外\n中距离比赛且在终盘有过超越的话\n则稍微向前突进<作战·居中>",
      "source_fingerprint": "0f4133fcd37fa857499e68419db25869060d747ccbe40f87459cdc86d8abbdd6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104902111"
      ]
    },
    {
      "uid": "zhcn:e64a0664fd100425df411787",
      "kind": "text_data",
      "source_text": "比赛中盘迫近时\n稍微降低速度\n之后在比赛终盘初期\n极大向前突进<中距离/长距离>",
      "source_fingerprint": "c322cafca620f3bb089ea924c6b3dd95465ef1dd83c8f20e79a9a84cedaef725",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "104902211"
      ]
    },
    {
      "uid": "zhcn:235cfd0260311708d95f0746",
      "kind": "text_data",
      "source_text": "比赛终盘时若身处接近最后方的位置\\n则回复持久力,并稍微提升速度\\n＜作战・追赶＞",
      "source_fingerprint": "809a7d665706bed119143f43cd9cb449494394a6e0fe60acd61986275c04cb39",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105001111"
      ]
    },
    {
      "uid": "zhcn:517e81bcf7cc8b69b5fc26ac",
      "kind": "text_data",
      "source_text": "最后冲刺时若身处直线\\n大幅提升加速度\\n并且视野变得稍微广阔＜作战・追赶＞",
      "source_fingerprint": "fdd433095376904c1235d604dd3dc9eb746c0cacc629b4be5401683dada48241",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105001211"
      ]
    },
    {
      "uid": "zhcn:37a2037c4f84ae7c1c285a93",
      "kind": "text_data",
      "source_text": "比赛中盘位于后方时,一段时间内速度提升\\n并选择更好的路线\\n＜作战・追赶＞",
      "source_fingerprint": "62d0f5bf8f3bd22d8fe2b99832502a01b46f285e241d576d4224badbc55d8cce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105002111"
      ]
    },
    {
      "uid": "zhcn:ef9934f21e88937ea6ca8fdc",
      "kind": "text_data",
      "source_text": "比赛终盘时开始时若身处中团以后的位置\\n则一段时间内加速度持续提升＜中距离＞",
      "source_fingerprint": "665274135698d39bc5596f9be296f082a7cdea51f9da3511ef972a6b9d737566",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105002211"
      ]
    },
    {
      "uid": "zhcn:3727000e900706fe05c98857",
      "kind": "text_data",
      "source_text": "临近终盘时若位于中后方\\n则一段时间内速度提升\\n＜作战・追赶＞",
      "source_fingerprint": "ef9166838b1ca484eda94c55bdf7c8081f2cc7cb9806820c18495b14aa1d1248",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105003111"
      ]
    },
    {
      "uid": "zhcn:0cf7e60383b316ddd029ea72",
      "kind": "text_data",
      "source_text": "最终直线处在第二名开外\\n且与领头距离4马身以内时\\n速度极大提升＜作战・追赶＞",
      "source_fingerprint": "379b7524efce91f88f0e6f2e874e0a9d2d27818b6e2e57c1acdf167f4806b26c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105003211"
      ]
    },
    {
      "uid": "zhcn:b787ebd0cfdd6d1dc7e71297",
      "kind": "text_data",
      "source_text": "若为中山赛马场,则在终盘时加速度\\n稍微提升,若在即将进入终盘时与领头\\n相距6马身以上\\n则加速度提升＜追赶・中距离＞",
      "source_fingerprint": "a44e1355880a7daf87e726254db018cf2036433ba30e3a8e0c19fa377de704f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105003221"
      ]
    },
    {
      "uid": "zhcn:6f90048f510c95c79337fccd",
      "kind": "text_data",
      "source_text": "身处直线时速度提升\\n并且稍微恢复持久力",
      "source_fingerprint": "953ecc57e86d409159e742c3bf68e2ebeb77073d5bc7c7ae468a2171d73182bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105101111"
      ]
    },
    {
      "uid": "zhcn:caa29f0ab97560fc6e27465a",
      "kind": "text_data",
      "source_text": "直线上速度大幅提升\t",
      "source_fingerprint": "6da0b422a7dbafd03353f3bbee4a099b4513d3647045de9708c82e46d90b81c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105101121"
      ]
    },
    {
      "uid": "zhcn:8a1dfb7d7d68484cd51ec34d",
      "kind": "text_data",
      "source_text": "身处下坡时,加速力提升\\n＜作战・先行＞",
      "source_fingerprint": "e3a8830a3f9bc71f388b1c15ccfa241a32e15411d99a19be309c520e1f75f438",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105101211"
      ]
    },
    {
      "uid": "zhcn:dc41187a17a534533dc5c074",
      "kind": "text_data",
      "source_text": "在弯道处速度提升\\n并使除自身外的己方队伍成员\\n速度稍微提升＜英里＞",
      "source_fingerprint": "e13406aee6bfe987d7a0ed72d4691d1c619eed6fa6cebcc5056588b6f99164b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105102111"
      ]
    },
    {
      "uid": "zhcn:9adc5ce7facf26037ab4a693",
      "kind": "text_data",
      "source_text": "下坡时速度提升\\n并稍微提升加速度\\n＜短距离/英里＞",
      "source_fingerprint": "2dc74cd2dd15995c96781159a9dd370515b9aad86ba5a3c15d0e06ada6c99bad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105102211"
      ]
    },
    {
      "uid": "zhcn:cd8cb657b0267a2ad04ef7f8",
      "kind": "text_data",
      "source_text": "下坡时速度大幅提升\\n并使除自己外的队伍成员\\n速度稍微提升＜英里＞",
      "source_fingerprint": "428fd9c951709a421c1dd8ad348cf566feacf366dad10013a70569cc43ccbf91",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105102221"
      ]
    },
    {
      "uid": "zhcn:a95856a3730022de78201caf",
      "kind": "text_data",
      "source_text": "在比赛序盘或是中盘时前方被阻挡时\\n大幅回复持久力\\n同时跑道选择更加明智",
      "source_fingerprint": "87f1b85cec4fcf010b9f9f55db2673f137d9112dd7f55c30278e6df243773ed2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105201111"
      ]
    },
    {
      "uid": "zhcn:3b509070d015e302ad57b3d8",
      "kind": "text_data",
      "source_text": "比赛中盘完成超越时\\n回复持久力,并且稍微提升速度",
      "source_fingerprint": "0af972d32580e4988abafa2f2290446fd76ff98b4bccb7d378ac8b63f918f9a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105201211"
      ]
    },
    {
      "uid": "zhcn:035e52bf0861b4289af4ef33",
      "kind": "text_data",
      "source_text": "比赛序盘时\\n跑道的选择变得非常明智\\n并且速度稍微提升",
      "source_fingerprint": "4d691aeb3987ac2c40f97fa133b2dc16709e994be32b6a3911475b38adeb8b3d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105202111"
      ]
    },
    {
      "uid": "zhcn:36c9b16fe20bf6c1f0f0e0fe",
      "kind": "text_data",
      "source_text": "比赛终盘路线选择更加明智\\n并提升少量加速度",
      "source_fingerprint": "1171e911d8475f6a4f52b9a90f266aaa6531f348c62e328865caada55c2286a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105202121"
      ]
    },
    {
      "uid": "zhcn:f302b57caf666f02859546ea",
      "kind": "text_data",
      "source_text": "完成超越时,一段时间内\\n加速力持续小幅提升\\n并且稍微提升速度＜作战・居中＞",
      "source_fingerprint": "547ad226ba1ee04961494f10e6699099a304aa0c57511cf4edcd92048ad05715",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105202211"
      ]
    },
    {
      "uid": "zhcn:575583e0e8ae96723d6e2ee2",
      "kind": "text_data",
      "source_text": "在最终弯道处于靠后位置时\\n会看着附近的赛马娘并恢复持久力",
      "source_fingerprint": "e471b891cacb2cbbcfe4543d6365658e0c3f76fbd05132f0a15e3e1bf506e293",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "10521"
      ]
    },
    {
      "uid": "zhcn:83028112d83b0a7870748224",
      "kind": "text_data",
      "source_text": "在最终弯道外侧完成超越时\\n速度提升并稍微提升加速度\\n＜作战・居中＞",
      "source_fingerprint": "e1244795b934a13012886113ab6c1dbf6f29df3348df0a5cc29da802610e5b8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105301111"
      ]
    },
    {
      "uid": "zhcn:62e22ad2a8c94c8d5800f945",
      "kind": "text_data",
      "source_text": "在最终弯道进行超越时\\n一段时间内向前突进\\n＜居中・英里＞",
      "source_fingerprint": "631412d7f86417a936207a4034eef623e23a63f55e50d6e669026138bd32ed48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105301121"
      ]
    },
    {
      "uid": "zhcn:3191f78640196044b2a59f83",
      "kind": "text_data",
      "source_text": "在最终弯道时若身处后方\\n速度提升,并稍微提升加速度\\n＜英里＞",
      "source_fingerprint": "0dda6661bf53d027fd979f4b810138d63f6be730d4a9d62e8cb623aa612e5b10",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105301211"
      ]
    },
    {
      "uid": "zhcn:5f0a22f94f53e60c59f62dcb",
      "kind": "text_data",
      "source_text": "比赛终盘初段位于中间集团往后时\\n加速度提升,并且在剩余200m处\\n稍微提升速度＜作战・居中＞",
      "source_fingerprint": "737b07738d5e153e513fce0d5b42adf621743661b712446531c47b20508fc180",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105302111"
      ]
    },
    {
      "uid": "zhcn:3792e6846db60bc32a2cc07d",
      "kind": "text_data",
      "source_text": "在终盘加速度提升\\n并且在剩余200m处\\n稍微提升速度＜短距离＞",
      "source_fingerprint": "fbe1b613a9bea916a906772a348bc1184f4e185cf0e800be5bbb5a1669955779",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105302211"
      ]
    },
    {
      "uid": "zhcn:6de50aff079934bb3c6c784a",
      "kind": "text_data",
      "source_text": "比赛中盘时位于队伍中后方往后\\n则速度大幅加快\\n＜作战・居中＞",
      "source_fingerprint": "becee187b98c47be88f28d0b490afd5ae1fdaae3b39b210a8b426a1f1f89c899",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105401111"
      ]
    },
    {
      "uid": "zhcn:3323990de6111bf30d4082b6",
      "kind": "text_data",
      "source_text": "比赛终盘位于后方时\\n速度提升,加速度稍微提升\\n＜短距离＞",
      "source_fingerprint": "c40ae2c02a554df9843da1e22d49925f3af4104f80ee26971666eaf8b473894d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105401211"
      ]
    },
    {
      "uid": "zhcn:ff182e71ab9e36c4388d6a8d",
      "kind": "text_data",
      "source_text": "比赛后半段若从后方进行了超越\\n剩余150m后自身位于前方时\\n在短时间内速度提升",
      "source_fingerprint": "33fb19105fd8e53f587193202f62abe982425a1951c315ccfc9c2ad44db1482b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "10541"
      ]
    },
    {
      "uid": "zhcn:97af0f93b3120f2d1481d5a7",
      "kind": "text_data",
      "source_text": "比赛中盘位于后方时\\n速度大幅提升＜中距离＞",
      "source_fingerprint": "d1553332ec8a74081f081df6cf5341aff145e64c744cc0ea98b5a4202215eb1d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105501111"
      ]
    },
    {
      "uid": "zhcn:4fb7fa6378a1936706cc9896",
      "kind": "text_data",
      "source_text": "比赛中盘位于后方时\\n一段时间内速度提升\\n＜作战・居中＞",
      "source_fingerprint": "d15d89bbe98e48f61fa6932c7f38a104daf110f5389b3354de973ba05dbdd87a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105501121"
      ]
    },
    {
      "uid": "zhcn:4144b4e4fa6bb2661a72c048",
      "kind": "text_data",
      "source_text": "最后冲刺阶段前方拥挤时,会更擅长回避\\n若距离终点尚远,则稍微再向前突进",
      "source_fingerprint": "fdc699840504985ba172a089ba762f06fcdf7ab54fc21c1303c60ccb108afd60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105501211"
      ]
    },
    {
      "uid": "zhcn:433a2cc39dc6d7da969388d4",
      "kind": "text_data",
      "source_text": "在2000m以上的比赛中，比赛期间\\n发动13次技能后会向前冲出\\n天气为晴时则会巨量向前冲出\\n＜作战·居中＞",
      "source_fingerprint": "4259cf61c386a667084e815e074d5a4d5fccb9cce3a211226d4d89584b5d3f80",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105502111"
      ]
    },
    {
      "uid": "zhcn:afa3a2face6810c21d34cdb1",
      "kind": "text_data",
      "source_text": "智力足够高时，智力和速度\\n会提升，若场地状态为「良」\\n则会巨量提升＜中距离/长距离＞",
      "source_fingerprint": "389b301d31e5461de89444a12a856c2fe8ad59756890b4e5fda6bb6d92e45f64",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105502211"
      ]
    },
    {
      "uid": "zhcn:5dff950ad2b422ab40edfc43",
      "kind": "text_data",
      "source_text": "比赛终盘时的一段时间内\\n速度持续提升＜长距离＞",
      "source_fingerprint": "80ede62bc768c35f2fd4dc2a3860302c5c4d4bcb3f1ac538aa2336dbdaeadd96",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105601111"
      ]
    },
    {
      "uid": "zhcn:1e941548da51f03183ecc74a",
      "kind": "text_data",
      "source_text": "枠号为7的倍数时\\n会发生非常好的事情",
      "source_fingerprint": "0ee3871a2dffb2e45f5aa0486b6ac933a4fe94d4b93eab662cc6b54810a90e77",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105601211"
      ]
    },
    {
      "uid": "zhcn:f77f0e0b15387fdf88e4c0a8",
      "kind": "text_data",
      "source_text": "比赛终盘完成超越时,一段时间内\\n速度持续上升,加速度持续\\n微幅上升＜长距离＞",
      "source_fingerprint": "815ccdac2da2dc28610e8944d36ab785a8a022739f2be87cdd78bbd3c45a9b74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105602111"
      ]
    },
    {
      "uid": "zhcn:cb48161e272163efea8df134",
      "kind": "text_data",
      "source_text": "终盘试图超越时\n加速度稍微提升，之后在最后冲刺\n过程中试图超越时\n持续一段时间提升速度<长距离>",
      "source_fingerprint": "7645e8c9940e8e70f50a45d35d8caed1952bcf0d6a31b96d205da3064cece9fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105602121"
      ]
    },
    {
      "uid": "zhcn:45fc5dfb54824b78c4b4de9e",
      "kind": "text_data",
      "source_text": "在最终弯道上身处内侧时\\n一段时间内速度持续提升＜长距离＞",
      "source_fingerprint": "26757f0065f6b2ab87e9614d4edc1ed1dda08e3dfd113a7d5a3b869a8e9b8c6f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105602211"
      ]
    },
    {
      "uid": "zhcn:90afcb49cdbc43cb62a2216d",
      "kind": "text_data",
      "source_text": "在比赛终盘前方受阻时\\n能够借助预言之力开辟道路",
      "source_fingerprint": "7faf7001c95398ff4f3f03bf264663b1c7fc6fe4636ef7c1719b105570651bd7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "10561"
      ]
    },
    {
      "uid": "zhcn:8df17963070ff8814c9895d8",
      "kind": "text_data",
      "source_text": "在最终弯道前的第三弯道上时\\n若身处后方,会向前大幅突进\\n＜中距离/长距离＞",
      "source_fingerprint": "09e9aa1cba8af04c4e6d05969906be17274008293059857f8dca96f37895d620",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105701111"
      ]
    },
    {
      "uid": "zhcn:57cf402bbcae40fd33812e21",
      "kind": "text_data",
      "source_text": "最后冲刺时若身处直线\\n大幅提升加速度\\n并且视野变得稍微广阔＜作战・追赶＞",
      "source_fingerprint": "fdd433095376904c1235d604dd3dc9eb746c0cacc629b4be5401683dada48241",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105701211"
      ]
    },
    {
      "uid": "zhcn:f72b2703e852d2817a17b60d",
      "kind": "text_data",
      "source_text": "在终盘前段较早进入直线时\n或在终盘初段的较早时机\n提升加速度＜追赶・中距离＞",
      "source_fingerprint": "50c5537eac4c0a9de78c7afcc4bcefca9a02ad6b6a65010bb11d88548385faa5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105701221"
      ]
    },
    {
      "uid": "zhcn:f01a9e7c0902b4c239581e3a",
      "kind": "text_data",
      "source_text": "在最终弯道之前的第三弯道处\\n向前突进、若在比赛后半段进行过超越\\n则变为一段时间内向前突进＜中距离/长距离＞",
      "source_fingerprint": "6103e44ca3eebbd30a3a219d642946af4ec84bb06cec582c3c1510f9963061b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105702111"
      ]
    },
    {
      "uid": "zhcn:9b6e5ae219c3c73165ba46ba",
      "kind": "text_data",
      "source_text": "在比赛终盘初期的更早时间点\\n提升加速度,若发动技能时\\n位于中后方,则变为大幅提升加速度＜追赶・长距离＞",
      "source_fingerprint": "22d0bb154817cdbc8d2721bc2f6443d2c2b8b31e7006815d19d89af09e113452",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105702211"
      ]
    },
    {
      "uid": "zhcn:d7bf16116893a9fcdfcbd1ab",
      "kind": "text_data",
      "source_text": "最终弯道时若身处前方\\n则一段时间内速度持续提升\\n＜作战・先行＞",
      "source_fingerprint": "a17ff703477351c015b7ff8d61dbc9b485c5744c28acc899e81c3eec3af755b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105801111"
      ]
    },
    {
      "uid": "zhcn:6382c2c74044fbf97247ebfc",
      "kind": "text_data",
      "source_text": "比赛中盘完成超越时\\n回复持久力,并稍微提升速度",
      "source_fingerprint": "f5ed292a84d778b4f053b0dfaefd16e8f1c16053bcca8efa12eaeb0f2eb32f83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105801211"
      ]
    },
    {
      "uid": "zhcn:966ab896c6b388c8704be8db",
      "kind": "text_data",
      "source_text": "比赛终盘开始时若身处前方\\n提升加速度,并稍微回复持久力\\n＜作战・先行＞",
      "source_fingerprint": "d5787f5f6d3a64af30e468943216fb500d3aea452f37bdee80d1fb8621b95f71",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105802111"
      ]
    },
    {
      "uid": "zhcn:732e8b0b50afad9dcb21e8ac",
      "kind": "text_data",
      "source_text": "比赛终盘初段位于前方时\\n提高加速度,之后在最终直线\\n速度稍微提升＜作战・先行＞",
      "source_fingerprint": "6495a7befcbb5f3178770d04d5e30885652f750a30434f600337c81484eff352",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105802121"
      ]
    },
    {
      "uid": "zhcn:8ed9eb972199b4e4f178d4a6",
      "kind": "text_data",
      "source_text": "身处弯道时回复持久力\\n同时稍微提升速度",
      "source_fingerprint": "04b6cfd8cbcc6a397717884fb318d908985b2213b5f117f393c765eaf690d216",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105802211"
      ]
    },
    {
      "uid": "zhcn:d795b2804e510f88213761e4",
      "kind": "text_data",
      "source_text": "比赛终盘时若身处后方\\n则稍微向前突进,并且剥夺前方\\n赛马娘的持久力＜作战・居中＞",
      "source_fingerprint": "4e2cfed65cd7bc140314def873f04a6f2d9a6705aae1ef9171c2d47c0debab5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105901111"
      ]
    },
    {
      "uid": "zhcn:e992642c16285ecd8c4fae37",
      "kind": "text_data",
      "source_text": "在比赛终盘一段时间内\\n向前突进＜作战・居中＞",
      "source_fingerprint": "37f06956601f1a3ad444419e401f802ad9882cb648a4559944347a1848853543",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105901121"
      ]
    },
    {
      "uid": "zhcn:59a57f521a967f064f332e63",
      "kind": "text_data",
      "source_text": "非常擅长京都竞马场\\n速度、耐力和智力大幅提升",
      "source_fingerprint": "1aef849f96b1a9e3aecf4a7df873e72e6c14136f3ec668b65df99ede7845b7ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105901211"
      ]
    },
    {
      "uid": "zhcn:5e788fe6b2e9e65616dc7c13",
      "kind": "text_data",
      "source_text": "比赛后半阶段时若身处中间集团\\n则一段时间内速度持续提升\\n并且微幅提升加速度＜作战・居中＞",
      "source_fingerprint": "5be81a590c3080fe3d690f2bafdbf6cc53adb4a53763b6b2e85b9d1ecd2cfe68",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105902111"
      ]
    },
    {
      "uid": "zhcn:e699489eb3b9df625f81b1b1",
      "kind": "text_data",
      "source_text": "在比赛后半段迅速向前突进\\n＜作战・居中＞",
      "source_fingerprint": "863754cf6f5dbc0256c799fec3a2aa3557226645240689f6da1ae420bbc23892",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105902121"
      ]
    },
    {
      "uid": "zhcn:47e64b1525afb1cfdb2dc0f1",
      "kind": "text_data",
      "source_text": "比赛终盘开始时若身处中团以后的位置\\n一段时间内加速度持续提升\\n＜中距离＞",
      "source_fingerprint": "174fea82b7df59a86a626106aab800eaac40c9a64c30fe64fe7fdbd87ff46e38",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "105902211"
      ]
    },
    {
      "uid": "zhcn:3b6969449f3b857f927ffff6",
      "kind": "text_data",
      "source_text": "比赛终盘时前方遭遇阻挡时\\n一段时间内加速度持续提升\\n＜中距离＞",
      "source_fingerprint": "01bc75d94611e853f04165bd299e957acb3d22aee5e65996ad97817de2c17880",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "106001111"
      ]
    },
    {
      "uid": "zhcn:76b969592f1654698bd6a4d7",
      "kind": "text_data",
      "source_text": "比赛终盘时,一段时间内速度持续提升\\n＜作战・居中＞",
      "source_fingerprint": "3f466f21d5664bb5e0910aa9c788c5ec7a72b4b590f4f4ab66153694689ccdbe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "106001211"
      ]
    },
    {
      "uid": "zhcn:c6e48b69f6396df800824935",
      "kind": "text_data",
      "source_text": "比赛终盘时\\n一段时间内速度持续提升＜中距离＞",
      "source_fingerprint": "bf0d3fe486a43e7f6e7dcccf7b8f4fc7a21e0f8cae7cd8d1be2b6b5427d35e66",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "106002111"
      ]
    },
    {
      "uid": "zhcn:414de0a46e69a00ce33d79e5",
      "kind": "text_data",
      "source_text": "在最后冲刺阶段时前方堵塞时\\n加速力提升,跑道选择稍微变得明智\\n并且稍微回复持久力",
      "source_fingerprint": "f9c1c2fa54419d44befb38af16f7ddbc191c5481edec53cff1c0a0cdb83db138",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "106002211"
      ]
    }
  ]
}
