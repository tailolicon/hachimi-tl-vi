    {
      "uid": "zhcn:8a453fd091b979945cbd5797",
      "kind": "text_data",
      "source_text": "比赛的最终区域使自己紧盯的马娘\\n紧张感上升＜作战・追赶＞",
      "source_fingerprint": "6192e800e1418c039fe41d74f5d25c25ebb32d01beab3f001e8d795ed75f1b5f",
      "source_path": "text_data_dict.json",
