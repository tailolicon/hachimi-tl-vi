    {
      "uid": "zhcn:c7060ce9177a7a3401313c2c",
      "kind": "text_data",
      "source_text": "枠号为7时会有好事发生",
      "source_fingerprint": "392b384346b1dda42baeaa0a18b68de31345f55fe75b9602f149916190245dcf",
      "source_path": "text_data_dict.json",
