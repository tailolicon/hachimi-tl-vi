      ]
    },
    {
      "uid": "zhcn:8d4f46181f6dc8c60d764edf",
      "kind": "text_data",
      "source_text": "比赛的最终区域使自己紧盯的马娘\\n紧张感上升一点点＜作战・追赶＞",
      "source_fingerprint": "01b50273593732f5a63931c9f07f66162be929566fd73a68072ec395b53c58c1",
