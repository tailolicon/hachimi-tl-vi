    {
      "uid": "zhcn:c0143977303e48bbbe6fcef3",
      "kind": "text_data",
      "source_text": "比赛终盘在后方准备超越时\\n稍微提升加速度\\n＜短距离/英里＞",
      "source_fingerprint": "f02be0509e9907100c89a136d2528ef01ebc0429d02c3821f094d3769660d438",
