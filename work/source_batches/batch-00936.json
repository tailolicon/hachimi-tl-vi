    {
      "uid": "zhcn:bc00bbdef183e19bc63fb491",
      "kind": "text_data",
      "source_text": "在比赛中盘一开始的地方\\n消耗大量体力\\n使速度少量提升＜作战・领放＞",
      "source_fingerprint": "77522894b1d0db9185ea42e159b5df5ccec004199ace832410d1babeca3a2705",
