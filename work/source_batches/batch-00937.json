      ]
    },
    {
      "uid": "zhcn:ca1f9698f7c904efd2b6c50c",
      "kind": "text_data",
      "source_text": "在终盘的最终弯道位于前方时\\n速度提升,若是京都竞马场的\\n长距离比赛,则速度极大提升",
      "source_fingerprint": "e7edfdf2246f3020bc309a22c65e85503a1a5e06846b54d93ab1ed26e2750940",
      "source_path": "text_data_dict.json",
