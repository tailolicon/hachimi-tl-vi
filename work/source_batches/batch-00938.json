      ]
    },
    {
      "uid": "zhcn:859917f16755c5109871f52f",
      "kind": "text_data",
      "source_text": "擅长阪神竞马场的比赛",
      "source_fingerprint": "e127b018bbd8ab4a7de05df1889645b2795b5e349312ad06a920c535395ed0b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200051"
      ]
    },
    {
      "uid": "zhcn:06a06fe5bed0cb6587ae5887",
      "kind": "text_data",
      "source_text": "稍微擅长阪神竞马场的比赛",
      "source_fingerprint": "bdd639346e48bc2368e5bdd87e74716a905a9248009bc921ea28e12039b08342",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200052"
      ]
    },
    {
