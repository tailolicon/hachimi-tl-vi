      "source_text": "稍微不擅长中山竞马场的比赛",
      "source_fingerprint": "ede7f6332b14072fb99d2057b916f6701c561c1cd0892e6e5b4b3e2829cd7d43",
      "source_path": "text_data_dict.json",
