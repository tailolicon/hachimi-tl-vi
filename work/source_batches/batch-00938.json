      "source_fingerprint": "9e5180a0db2dd73a21e8b1fad350bd753a0f563ac4de28199a3a731e1011eb90",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200033"
      ]
    },
    {
      "uid": "zhcn:6deb5e75c58e0804477aa919",
      "kind": "text_data",
      "source_text": "擅长东京竞马场的比赛\\n耐力、智力、速度提升",
      "source_fingerprint": "3877cb8216e8744875692ca9a360e5c8208f247dfd4e035556e9c878e6a8fc69",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200034"
      ]
    },
    {
      "uid": "zhcn:16689200e7058d3cccbe5cf7",
      "kind": "text_data",
      "source_text": "擅长中山竞马场的比赛",
      "source_fingerprint": "3e313b1598fd494945590c768dd7296d55171a4bc7846cda7b9ec0313db665f1",
      "source_path": "text_data_dict.json",
