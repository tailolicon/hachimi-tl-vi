      ]
    },
    {
      "uid": "zhcn:e983cc54d1d70adc18edb73e",
      "kind": "text_data",
      "source_text": "在比赛终盘初期的更早时间内\\n若处于中后方,则加速度\\n稍微提升＜居中・中距离＞",
