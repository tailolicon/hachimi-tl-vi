      ]
    },
    {
      "uid": "zhcn:2f0e1d0f57c5939c7b28667c",
      "kind": "text_data",
      "source_text": "在比赛中盘速度稍微提升\\n技能发动时,若处于中后方\\n则效果变为向前突进\\n＜作战・居中＞",
      "source_fingerprint": "13ca170f8f9897971eba3fc0e51dd663d1f50ab9cdecf3dc6426dcdbde876306",
      "source_path": "text_data_dict.json",
