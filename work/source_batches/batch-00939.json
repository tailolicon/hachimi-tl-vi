        "203712"
      ]
    },
    {
      "uid": "zhcn:0dd08cb6e8022173d26e4e61",
      "kind": "text_data",
      "source_text": "心中怀抱继承下来的强烈心愿\\n在比赛后半段向前突进\\n并稍微回复耐力＜英里/中距离＞",
      "source_fingerprint": "64eb3cca41add66cbf7112d1b435eb3d944ba797d865efe827e44bf72351063c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "203721"
      ]
    },
    {
      "uid": "zhcn:167598d09fa913819c26c734",
      "kind": "text_data",
      "source_text": "比赛中盘初期少量提升速度\\n并少量回复耐力＜长距离＞",
      "source_fingerprint": "1cc088ef158b2f5a29480b35b06702c3019fa21888739c806d4e27385d7183cb",
      "source_path": "text_data_dict.json",
      "json_path": [
