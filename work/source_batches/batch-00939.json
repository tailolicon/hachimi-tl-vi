      ]
    },
    {
      "uid": "zhcn:ef75adf385a8d4c5bb71520d",
      "kind": "text_data",
      "source_text": "在比赛终盘初期的更早时间内\\n若处于中后方,则加速度提升\\n＜居中・中距离＞",
