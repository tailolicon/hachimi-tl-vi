      ]
    },
    {
      "uid": "zhcn:6d1d3e15335a5b7fad3c946c",
      "kind": "text_data",
      "source_text": "最终冲刺的直线上\\n提升加速度＜作战・先行＞",
      "source_fingerprint": "3dfc93736bf040c611c60f718a6cae4e0af98fed222996bfe54395fdda426111",
      "source_path": "text_data_dict.json",
      "json_path": [
