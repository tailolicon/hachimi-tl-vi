      ]
    },
    {
      "uid": "zhcn:e84e00e7092356928bd60971",
      "kind": "text_data",
      "source_text": "没有其他马娘选择与自己相同的战术时\\n能力稍微更容易发挥",
      "source_fingerprint": "ed4e9a12b18f227f237053fe55ff48e2bf8f4768bb3e669379cfc9c0c4f48302",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200272"
      ]
    },
    {
      "uid": "zhcn:2ce21bc8bbf44cb55f58ac37",
      "kind": "text_data",
      "source_text": "很多马娘与自身同一战术时\\n能力容易发挥",
      "source_fingerprint": "c9e4f9b5cd318ca7792edfe59f32879c69befc532f2cd723962cf788374a34d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200281"
      ]
    },
    {
      "uid": "zhcn:382fc1b3f154747b1e227870",
      "kind": "text_data",
      "source_text": "很多马娘与自身同一战术时\\n能力稍微容易发挥",
      "source_fingerprint": "66d53ad69e52f70e18b2f5f98817e26d19348b1f9f162b6af43d34dce134d814",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200282"
      ]
    },
    {
      "uid": "zhcn:1ec6e3000abcd774bb6943d6",
      "kind": "text_data",
      "source_text": "很多马娘与自身同一战术时\\n能力难以发挥",
      "source_fingerprint": "cd828c93a2d9581449dc5e033a0001f88b849ebf7d99d497a74ad30a1d0d2de3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200283"
      ]
    },
    {
      "uid": "zhcn:fe951954793706622895bbc2",
      "kind": "text_data",
      "source_text": "与人气第一的马娘选择相同战术时\\n能力更容易发挥",
      "source_fingerprint": "c12aa933b32aeae960f0d30812204f8ca574bac2b3e8a83fa244746b26ec6af6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200291"
      ]
    },
    {
      "uid": "zhcn:678cee1047cac3d6d1ae1d56",
      "kind": "text_data",
      "source_text": "与人气第一的马娘选择相同战术时\\n能力稍微更容易发挥",
      "source_fingerprint": "9abb8e5e5d901486730e4f4a77af732f0bd0b83ff49a98443046de151286037b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200292"
      ]
    },
    {
      "uid": "zhcn:4b107e19b08e779d9ac69665",
      "kind": "text_data",
      "source_text": "人气第四以下时能力更容易发挥",
      "source_fingerprint": "8c7670144981ea2f70dab036b1092f9ca4583b0615d3ff1502cf598497c2804f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200301"
      ]
    },
    {
      "uid": "zhcn:b2b63a5b8065aa1223215697",
      "kind": "text_data",
      "source_text": "人气第四以下时能力稍微更容易发挥",
      "source_fingerprint": "f84db2a4a5858b756cf3110a564be04fc0df4ba3b27ce737701a14549191da6f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200302"
      ]
    },
    {
      "uid": "zhcn:ad656a7feceb9bf79ed55380",
      "kind": "text_data",
      "source_text": "稍微不擅长\\nGⅠ等大舞台的比赛",
      "source_fingerprint": "48860c32d3ae4794a61af292b6c3fa7765b14c9b45d24c21e83b4437958160a7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200311"
      ]
    },
    {
      "uid": "zhcn:2f774934fba5044d49c346e5",
      "kind": "text_data",
      "source_text": "对成为人气第一感到棘手",
      "source_fingerprint": "369483b2288b317ee0e1d94444fcb3fe7d9a2cadc9b9c433a72278d7c3ba5e90",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200321"
      ]
    },
    {
      "uid": "zhcn:5ce0579a63974d93fe912601",
      "kind": "text_data",
      "source_text": "变得擅长弯道,速度加快",
      "source_fingerprint": "90fb494d9c0305d9643e502e8def68beb500da2feecebea6679e08f075a4e5ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200331"
      ]
    },
    {
      "uid": "zhcn:e3d32b807bc315ddbd764e9e",
      "kind": "text_data",
      "source_text": "变得擅长弯道,速度略微加快",
      "source_fingerprint": "1dd0f93bf09bdcffd91f6a451846de4754d6c0949036604aaa0eb282f7fa1623",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200332"
      ]
    },
    {
      "uid": "zhcn:7d0a17413d9fa3cef81c9962",
      "kind": "text_data",
      "source_text": "变得不擅长弯道,速度少量减慢",
      "source_fingerprint": "b889670d0ab6f630d73e4aeb18f1f089a6a9a92e9575f2af1a4facbabc9520e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200333"
      ]
    },
    {
      "uid": "zhcn:18666518c63c1285ec8a3b0c",
      "kind": "text_data",
      "source_text": "华丽地过弯,加速度提升,",
      "source_fingerprint": "b3edf6c46825bb820604a4b1e9beb805893dd302cf79ce538fadbbdda7f5cdf2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200341"
      ]
    },
    {
      "uid": "zhcn:ae809570c90afba797e1a42f",
      "kind": "text_data",
      "source_text": "华丽地过弯,加速度略微提升,",
      "source_fingerprint": "8d4abd12f258069873fa4acbd4ca09e7d75d19d3c22fc79db079bccdbb0cdf6f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200342"
      ]
    },
    {
      "uid": "zhcn:faf87dd1598f96e566959094",
      "kind": "text_data",
      "source_text": "生硬地过弯,加速度少量下降",
      "source_fingerprint": "287a662b7f69d25f1c9671ccce8803e75480461dbfe75748221c78d41b8ad746",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200343"
      ]
    },
    {
      "uid": "zhcn:326c5e01ebec0fc3dcc1b8ee",
      "kind": "text_data",
      "source_text": "完美过弯,持久力回复",
      "source_fingerprint": "fb0be408fce49ba637f13e700b6a02c737cf68e8674afb725f58bf892c7eb893",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200351"
      ]
    },
    {
      "uid": "zhcn:6322c88756de4aa2f2640c97",
      "kind": "text_data",
      "source_text": "完美过弯,持久力略微回复",
      "source_fingerprint": "2ac5d73d321120987f5a677e50e3fbf210a5cea388e69fe637f98a5400cf7854",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "200352"
      ]
    },
    {
      "uid": "zhcn:927ebd0d534de99b1d54f10a",
