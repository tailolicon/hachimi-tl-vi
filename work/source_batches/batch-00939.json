      ]
    },
    {
      "uid": "zhcn:99cf91f56615af603afd6bae",
      "kind": "text_data",
      "source_text": "在比赛中盘速度稍微提升\\n技能发动时,若处于中后方\\n则效果变为稍微向前突进\\n＜作战・居中＞",
      "source_fingerprint": "d7ced8ed1b38266dee516e2f6f7c872773d0b5df8c35959f3cf7b5f3ee005e1a",
