      ]
    },
    {
      "uid": "zhcn:fee206c048333468755dffd3",
      "kind": "text_data",
      "source_text": "比赛中盘位于中后方时\\n速度提升\\n＜居中・中距离＞",
      "source_fingerprint": "dd6f84d85afa23736eb3e0cc6214953ef29237d73c7c1e32cc6d37d02d1b3730",
      "source_path": "text_data_dict.json",
