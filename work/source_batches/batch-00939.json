    {
      "uid": "zhcn:b10be305e8952a7b82ba42a7",
      "kind": "text_data",
      "source_text": "没有其他马娘选择与自己相同的战术时\\n能力更容易发挥",
      "source_fingerprint": "66ee12fcaac7f437c1789574fbca7aea7d9a887bc6ecc25607f7a79853e49807",
      "source_path": "text_data_dict.json",
      "json_path": [
