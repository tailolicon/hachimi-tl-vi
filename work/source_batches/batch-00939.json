        "203701"
      ]
    },
    {
      "uid": "zhcn:cabdbd7a46d466956d123c45",
      "kind": "text_data",
      "source_text": "比赛终盘初期\\n若余力十足的话,稍微向前突进\\n＜先行・长距离＞",
      "source_fingerprint": "bf02d4bf7bc41d1885f58ab82724f81af28890ec93f040de4f3c686750f6a62f",
