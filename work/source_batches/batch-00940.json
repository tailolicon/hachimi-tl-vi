        "204272"
      ]
    },
    {
      "uid": "zhcn:ac5d9be14b83027596841f88",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方，消耗少量持久力\\n并使速度稍微提升＜短距离＞",
      "source_fingerprint": "a7cce2ece4549716dc874869ba83b3b51b65877cca6104277b6579ad91516a13",
      "source_path": "text_data_dict.json",
      "json_path": [
