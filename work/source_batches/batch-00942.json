      ],
      "json_pointer": "/48/300101"
    },
    {
      "uid": "zhcn:97fea3c7654876804c5e18dd",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "朝着日本第一的赛马娘又近了一步\\n因此稍微更能发挥自己的实力",
      "source_fingerprint": "ce854ed7f8b339172d1b186358f43aa54f15b1309078b6304d9fed53cc485107",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "text_data_dict.json",
