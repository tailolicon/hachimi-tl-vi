    },
    {
      "uid": "zhcn:ccbd629bfa12c66d2c801c61",
      "kind": "text_data",
      "source_text": "比赛序盘自己保持领先时\\n使跟在后方的赛马娘速度少量下降＜沙土＞",
      "source_fingerprint": "4b8f51bdec587ac977d70f2b95a140484f1b9e103e0e1b244fc50b87a3e19a05",
      "source_path": "text_data_dict.json",
