    {
      "uid": "zhcn:fa25e3ff772ade457438badb",
      "kind": "text_data",
      "source_text": "比赛序盘自己保持领先时\\n使跟在后方的赛马娘速度下降＜沙土＞",
      "source_fingerprint": "cb6d1f944fe86c922c2fe925a1c9964a231636ac14d4557b0d669cba62b82ce5",
