      ]
    },
    {
      "uid": "zhcn:2ca01d3105b3dd805adec7c5",
      "kind": "text_data",
      "source_text": "临近终盘位于领头\\n或是距离领头4马身以内时\\n在终盘稍微提升加速度＜先行・长距离＞",
      "source_fingerprint": "6f0f267fc05a3754d79876fd669c1cfd1f921cebbbb477cd14cd84eb3311f45f",
