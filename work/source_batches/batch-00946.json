    },
    {
      "uid": "zhcn:79380ee4648cb62ce9de7777",
      "kind": "text_data",
      "source_text": "临近终盘位于领头或是距离领头4马身以内时\\n在终盘提升加速度＜先行・长距离＞",
      "source_fingerprint": "934c9f4f58a3a5eaa659bb6f1148205cc3d7d9c0e3f4afaf9f93b5244c2daf93",
      "source_path": "text_data_dict.json",
