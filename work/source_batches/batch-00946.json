      "kind": "text_data",
      "source_text": "在比赛中盘时,速度稍微提升\\n＜英里/中距离＞",
      "source_fingerprint": "0c02776263ea96113e2c26b1ac07555fd6179cd1ba5cda19f20e3b8afe87118f",
