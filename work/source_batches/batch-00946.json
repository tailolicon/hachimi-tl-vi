        "48",
        "202352"
      ]
    },
    {
      "uid": "zhcn:2da6623332d7aa56e3fe16b4",
      "kind": "text_data",
      "source_text": "比赛后半时\\n使体力回复的赛马娘畏缩＜沙土＞",
      "source_fingerprint": "7726b9c11c217e476938903ad20196c39c8a91f5a140376954e9fac6809b250f",
      "source_path": "text_data_dict.json",
