        "202521"
      ]
    },
    {
      "uid": "zhcn:70bb0071a2e90bdede5b14bc",
      "kind": "text_data",
      "source_text": "在最终弯道前的第三弯道上位于后方时\\n稍微向前突进＜中距离/长距离＞",
