        "48",
        "202361"
      ]
    },
    {
      "uid": "zhcn:d3d602db4f23027e8aa69320",
      "kind": "text_data",
      "source_text": "比赛后半时\\n使体力回复的赛马娘稍微畏缩＜沙土＞",
      "source_fingerprint": "cf8e71bcf43cb79166b8df2dcbb072e4c55eca19a35d4d05a3bc401ff9eb9d76",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202362"
      ]
    },
    {
      "uid": "zhcn:26d7a6a9d5c47f160ce3457e",
      "kind": "text_data",
      "source_text": "比赛中盘速度提升\\n＜作战・先行＞",
