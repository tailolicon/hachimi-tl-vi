        "204262"
      ]
    },
    {
      "uid": "zhcn:e16d0caacbc1da5fa3278ca4",
      "kind": "text_data",
      "source_text": "在弯道上若身处前方则向前突进\\n＜短距离＞",
      "source_fingerprint": "423b02d55493a56ecf77823d80ec76c663ba46ce0a541f52738e62278e2043f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204271"
      ]
    },
    {
      "uid": "zhcn:448721fe63bcb18e30cab82c",
      "kind": "text_data",
      "source_text": "在弯道上若身处前方则微幅\\n向前突进＜短距离＞",
      "source_fingerprint": "a196a83a20d7372b72f5706dc4af6f4e95b987780644a14ccefeed26c3c91a48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204272"
      ]
    },
    {
      "uid": "zhcn:ac5d9be14b83027596841f88",
      "kind": "text_data",
      "source_text": "比赛中盘时若身处前方，消耗少量持久力\\n并使速度稍微提升＜短距离＞",
      "source_fingerprint": "a7cce2ece4549716dc874869ba83b3b51b65877cca6104277b6579ad91516a13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204282"
      ]
    },
    {
      "uid": "zhcn:32539fe75eaf465410e2b7d8",
      "kind": "text_data",
      "source_text": "若是3000m以上的比赛\\n在比赛中间点附近稍微回复耐力",
      "source_fingerprint": "316308a77e681ba0935938c75b5cda74776ac91df9a5504f0cacd16c717b808f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204292"
      ]
    },
    {
      "uid": "zhcn:b2fa572e12a9a916ea16eeae",
      "kind": "text_data",
      "source_text": "若是3000m以上的比赛\\n在比赛中间点附近极小幅回复耐力",
      "source_fingerprint": "603aa8d0e764bdab295eb0a8b33cdca4cd68d834ba2702d5d276b88a871d2f99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204293"
      ]
    },
    {
      "uid": "zhcn:45c7bcd6ab42302627703de8",
      "kind": "text_data",
      "source_text": "比赛中盘的直线上若身处前方\\n一段时间内速度稍微提升\\n＜先行・中距离＞",
      "source_fingerprint": "3fa58c1f630eadd8a09e377428dd545688bbccb77f133c6c2b7560f4076b0172",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204301"
      ]
    },
    {
      "uid": "zhcn:2a6656b9fe9b1c15b9dca030",
      "kind": "text_data",
      "source_text": "比赛中盘的直线上若身处前方\\n一段时间内速度微幅提升\\n＜先行・中距离＞",
      "source_fingerprint": "6ba7c9fdad99555fb349c2f3f9b49150ffd5833a29cac2e1de5b5afe69d9d640",
      "source_path": "text_data_dict.json",
