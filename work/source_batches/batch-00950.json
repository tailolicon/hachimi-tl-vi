    {
      "uid": "zhcn:28c576649958363e86ad6799",
      "kind": "text_data",
      "source_text": "在比赛最终盘初段\\n若处于最后冲刺阶段\\n速度稍微提升＜作战・领放＞",
      "source_fingerprint": "2e264a88b324c5a46e5e4067203ba5a7ebbcd4f00122a3abc7e15f431d9fb0e1",
