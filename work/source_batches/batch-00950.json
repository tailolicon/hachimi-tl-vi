        "204342"
      ]
    },
    {
      "uid": "zhcn:41a853c15da1bf1e7b25fa8f",
      "kind": "text_data",
      "source_text": "比赛中盘的弯道上处于中间集团及以后时\n一段时间内速度稍微提升\n＜作战・居中＞",
      "source_fingerprint": "0fe5aeb9657b61a924a5e587dab79e725ccadcb9760641205425be11e17fe604",
      "source_path": "text_data_dict.json",
