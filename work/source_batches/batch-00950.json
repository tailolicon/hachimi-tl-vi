      ]
    },
    {
      "uid": "zhcn:8cca163afb04554ad40bb8f7",
      "kind": "text_data",
      "source_text": "若速度属性极高,则速度\\n稍微提升,若智力属性也极高\\n则少量提升＜领放・中距离＞",
      "source_fingerprint": "7e56bdd8bbf895fec3e48152433cf91e3f708c342fcef1c97cdf85289ccc9a4c",
