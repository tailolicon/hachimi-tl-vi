      "kind": "text_data",
      "source_text": "临近比赛终盘时\n若位于前方则速度稍微提升\n＜作战・领放＞",
      "source_fingerprint": "7ebfd73d21149a1249bbd3006dd959123117cbc1845c9ac3f16f27b42e6a482d",
      "source_path": "text_data_dict.json",
      "json_path": [
