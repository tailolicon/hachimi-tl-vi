  "entries": [
    {
      "uid": "zhcn:714d0aec71d6b902ac9ab6cd",
      "kind": "text_data",
      "source_text": "最糟最糟最糟！必败事件发生！\\n变得略微难以发挥能力\\n晚出闸的时间变长",
      "source_fingerprint": "586240eb3700628509a9f8c5cb281bd2c81d38b023e6ce8e4cde97dbc3defd23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204581"
      ]
    },
    {
      "uid": "zhcn:482526f9236de611e6e59687",
      "kind": "text_data",
      "source_text": "急切的心情无法抑制！！\\n由于过度焦急,稍微变得容易焦躁",
      "source_fingerprint": "0c21215de34abe417b6403498be5c4c3ac994e2991cdf1fa22b17f4d7f8574e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204591"
      ]
    },
    {
      "uid": "zhcn:07e90163b526a37e9c2e3c5d",
      "kind": "text_data",
      "source_text": "双腿跟不上急于求成的心情\\n最终直线位于领头时,速度稍微下降",
      "source_fingerprint": "feafeef6e59f236fd0ab28f77edd50ce1684b975e865e507c5d2bf569be3f55a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204601"
      ]
    },
    {
      "uid": "zhcn:720931179846842e3c5e9498",
      "kind": "text_data",
      "source_text": "受命运之声的煽动而斗志溢出\\n智力稍微下降",
      "source_fingerprint": "8b80c506af71eab1fa6a7435747b4844b676cac2f40e04283a6021d456eeaa28",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204611"
      ]
    },
    {
      "uid": "zhcn:105b35d88668462fe6e962e1",
      "kind": "text_data",
      "source_text": "在比赛中盘的随机位置速度\\n略微提升\\n若拥有3个以上继承技能\\n则效果提升",
      "source_fingerprint": "cf7f472be673d60a764f07a5ebc244b538eaeac9c42e71edb231dc36b4893a13",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204622"
      ]
    },
    {
      "uid": "zhcn:9c1d79e489e5dfd7ff051963",
      "kind": "text_data",
      "source_text": "在比赛后半段的弯道进行超越时\\n略微向前突进＜追赶・中距离＞",
      "source_fingerprint": "2c8862baaffb2e6afef7d80caa60d6c358f05642d116bd90d3318743b55ebe89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204632"
      ]
    },
    {
      "uid": "zhcn:650668c72dfe2db5df3f0103",
      "kind": "text_data",
      "source_text": "在最终弯道从外侧进行超越时\\n速度略微提升＜作战・追赶＞",
      "source_fingerprint": "cebf8a5a6371e4bc77e55145b3c334a268d31f7aad1bec9bfaf92565947f1b49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204642"
      ]
    },
    {
      "uid": "zhcn:0bce71c1420384b1779541cd",
      "kind": "text_data",
      "source_text": "在最后冲刺阶段\\n若前方被阻挡则加速度提升\\n＜泥地＞",
      "source_fingerprint": "52b8bc955299100638035fb91cec7191c019747d27c283175dc8891fb28e063b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "204661"
      ]
    },
    {
      "uid": "zhcn:c70211f1e8eb651e622cf46b",
      "kind": "text_data",
      "source_text": "在最后冲刺阶段\\n若前方被阻挡则加速度稍微提升\\n＜泥地＞",
      "source_fingerprint": "1a19401946223931d6ac8133f42e1e1c312862ad2f8ceed93c82d2e22047ee11",
      "source_path": "text_data_dict.json",
