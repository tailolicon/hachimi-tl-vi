      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202711"
      ]
    },
    {
      "uid": "zhcn:5cf59e0ea8d8a4af9d07c7c4",
      "kind": "text_data",
      "source_text": "在终盘的最终弯道位于队伍中间往前时\\n若距离终点尚远则稍微提升加速度\\n＜先行/居中＞",
      "source_fingerprint": "8e78eb3eef174c7816c19e3184421a50ecb38c95e9ebaf2ec25dfd135a51e1f4",
      "source_path": "text_data_dict.json",
      "json_path": [
