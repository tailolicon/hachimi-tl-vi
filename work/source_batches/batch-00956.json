        "202831"
      ]
    },
    {
      "uid": "zhcn:d440c15b4da8d456b1595de0",
      "kind": "text_data",
      "source_text": "比赛中盘发动技能时\\n速度略微提升\\n之后在比赛终盘发动技能时\\n略微向前突进＜沙土＞",
      "source_fingerprint": "23cc17c8e4a7be9ff65c2ae2577f5366dcd0b1e85ba81c1932c719adf7c66fa7",
      "source_path": "text_data_dict.json",
      "json_path": [
