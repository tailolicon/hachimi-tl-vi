        "48",
        "202734"
      ]
    },
    {
      "uid": "zhcn:44d98c17e9f94aee73d9f42c",
      "kind": "text_data",
      "source_text": "位于最终弯道前的第三弯道时\\n若在队伍前方则向前突进\\n＜英里/中距离＞",
      "source_fingerprint": "f5f398638dbc4662bc14391210010c960e07b6d7184a211ae207d79a5f2b43b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202741"
      ]
    },
    {
      "uid": "zhcn:4dc80adbb8d68a2f3abe829f",
      "kind": "text_data",
      "source_text": "位于最终弯道前的第三弯道时\\n若在队伍前方则稍微向前突进\\n＜英里/中距离＞",
      "source_fingerprint": "48ba72128bfe8526d0ce5dafe9406230f233206f411847143883b5c96becb355",
      "source_path": "text_data_dict.json",
      "json_path": [
