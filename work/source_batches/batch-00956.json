      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202861"
      ]
    },
    {
      "uid": "zhcn:3cf45c01ae3f62cdbdd96673",
      "kind": "text_data",
      "source_text": "起跑时加速度稍微提升\\n＜短距离＞",
