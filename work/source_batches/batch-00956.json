      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202771"
      ]
    },
    {
      "uid": "zhcn:498572678b9da745c6790c49",
      "kind": "text_data",
      "source_text": "在终盘初段位于前方时\\n更早时间内稍微提升加速度\\n＜先行・长距离＞",
