      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202882"
      ]
    },
    {
      "uid": "zhcn:442b6980773c5fabb9502e87",
      "kind": "text_data",
      "source_text": "比赛中盘迫近时\n若位于后方则恢复持久力<作战·后追>",
