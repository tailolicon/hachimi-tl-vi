      "json_path": [
        "48",
        "202871"
      ]
    },
    {
      "uid": "zhcn:afe9a0f75e1537730e4ff18e",
      "kind": "text_data",
      "source_text": "在终盘的最终弯道处若位于中后方\\n稍微提升加速度\\n＜追赶・中距离＞",
      "source_fingerprint": "c717c4fd5cbaeacc0df06c930c3068dc60ab985f0589ad4218a90c83268da2e9",
      "source_path": "text_data_dict.json",
