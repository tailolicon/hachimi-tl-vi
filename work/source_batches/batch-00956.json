      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202841"
      ]
    },
    {
      "uid": "zhcn:a07bc04b467571b4b0cbde66",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时\\n略微回复体力\\n＜沙土＞",
