        "202742"
      ]
    },
    {
      "uid": "zhcn:2cd13040d34902aeaf4ad1f4",
      "kind": "text_data",
      "source_text": "临近终盘的时候若位于中后方\\n提升速度＜短距离＞",
      "source_fingerprint": "d075d46aff431c2c289b720b9d1ee7e6a86f8f620d5a64e4a5ba644bec9720f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202751"
      ]
    },
    {
      "uid": "zhcn:30915adbac70525c84930967",
      "kind": "text_data",
      "source_text": "临近终盘的时候若位于中后方\\n稍微提升速度＜短距离＞",
      "source_fingerprint": "861839729d55de53e3b9af97f74b1c6f0df950234fb46d1e0ca30513a96de6d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202752"
      ]
    },
    {
      "uid": "zhcn:fbee42e48a353626e901b323",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时\\n一段时间内速度少量上升\\n＜作战・先行＞",
      "source_fingerprint": "8ec49363886300791c4908da3b85de0956d3f1a8f501def7e883c574d81e0c27",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202761"
      ]
    },
    {
      "uid": "zhcn:c25815b809d8cc92080525db",
      "kind": "text_data",
      "source_text": "比赛中盘位于前方时\\n一段时间内速度略微上升\\n＜作战・先行＞",
      "source_fingerprint": "f2d7ce92db2e2cf235696b346f65743507b00d7eb29fcf808e929b32ad8e2f03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "48",
        "202762"
      ]
    },
    {
      "uid": "zhcn:5dfdb18524ebe8d5664f6acc",
      "kind": "text_data",
      "source_text": "在终盘初期位于前方时\\n更早时间内提升加速度\\n＜先行・长距离＞",
