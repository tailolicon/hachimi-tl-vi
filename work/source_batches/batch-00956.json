        "48",
        "202701"
      ]
    },
    {
      "uid": "zhcn:d8ae42df280ffca45ba0dbc5",
      "kind": "text_data",
      "source_text": "速度有十二分迅速时稍微提升速度\\n智力也十二分超群时少量提升速度\\n＜先行・中距离＞",
      "source_fingerprint": "714faa78fdc2f7396f0b6ea64c5a6767ea77459e1ea26059f87c5a7e20bbe632",
      "source_path": "text_data_dict.json",
