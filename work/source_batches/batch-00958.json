    {
      "uid": "zhcn:31d75b760269338b6781239d",
      "kind": "text_data",
      "source_text": "比赛中盘速度略微提升\\n之后在比赛终盘略微向前突进\\n＜英里/中距离＞",
      "source_fingerprint": "8e3737944a59a05b07c742527fb581b74d3394775aac04fc6ae541cd5c0c175e",
