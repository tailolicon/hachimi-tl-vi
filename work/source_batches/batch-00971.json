      ]
    },
    {
      "uid": "zhcn:350b6580aa7b5000f4f49223",
      "kind": "text_data",
      "source_text": "最终冲刺时向前突进\\n获得的料理Pt总计越多\\n技能效果越好＜短距离/英里＞",
      "source_fingerprint": "5aa7009cb645ab00641b2b6e1750112f48909c9c27e3f69b34d7de01c98f8789",
