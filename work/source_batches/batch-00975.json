      ]
    },
    {
      "uid": "zhcn:6b3ef41dc6b2a02bd0d8f6d5",
      "kind": "text_data",
      "source_text": "骏大祭合宿开始后，便能集中进行演目排练。\\n还请牢记于心，以此考量来选择教诲为好。",
      "source_fingerprint": "c4ccf60c0011575312e0b6bf1a01fb37ede8235d2672a46afbea1a29ad7e2e05",
      "source_path": "text_data_dict.json",
