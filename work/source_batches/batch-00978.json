      ]
    },
    {
      "uid": "zhcn:60d66ab625d4129b34da87fd",
      "kind": "text_data",
      "source_text": "<color=#ff9900>滑动操作</color>可以在屏幕上的任意位置滑动来移动摄像机，\\n通过捏合操作可以缩放画面。\\n如果需要将摄像机恢复到初始位置，\\n请点击屏幕左下方的<color=#ff9900>[摄像机重置]按钮</color>。",
      "source_fingerprint": "d90d9a555b81b2d99114aafc2c22f8c38c955fea9ecbb51ac2f058c370fe9f18",
      "source_path": "text_data_dict.json",
