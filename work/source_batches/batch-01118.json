    {
      "uid": "zhcn:c8e470a2be5cea9c0a22b7a9",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "如果终盘冲刺跑不快的话\\n说不定是速度属性不够哦。",
      "source_fingerprint": "45e0d2a832a4f42a519ac563a3627a1d1790c537fcf8acee7dff44d4dc60365b",
