      ],
      "json_pointer": "/69/8034"
    },
    {
      "uid": "zhcn:e69e4ef68eaa05afcf2ce9c3",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "如果提升育成赛马娘的觉醒Lv，\\n育成开始时会增加可能获得的技能。",
      "source_fingerprint": "0ae613fde0cae13c45efeb80d7dab24b1b2d6bc8a62f3ba687b6113b22c37d87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
