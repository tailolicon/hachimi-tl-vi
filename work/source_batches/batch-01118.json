    },
    {
      "uid": "zhcn:6fe388eaae6e1c3226ee2c44",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "如果金币和强化道具不够用\\n就去试着参加每日比赛吧。",
