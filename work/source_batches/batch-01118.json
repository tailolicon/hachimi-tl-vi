    },
    {
      "uid": "zhcn:5d62d1a581184897af4078e6",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "如果感觉很难进入领先集团的话\\n说不定增强力量会更好哦。",
      "source_fingerprint": "953ca17c5fcdd03b42adf08bfa644b6832978ec446c2054053aceb54a4408d92",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
