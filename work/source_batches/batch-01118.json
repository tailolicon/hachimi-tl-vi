      "json_pointer": "/69/8009"
    },
    {
      "uid": "zhcn:e98a615924a912a82c4ed212",
      "kind": "text_data",
      "source_language": "zh-CN",
      "source_text": "通过上限解锁强化支援卡的话\\n可以得到强力的支援效果哦。",
