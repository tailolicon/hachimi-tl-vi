{
  "schema_version": 1,
  "batch": 1121,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:5f9f41977d22e81200a84e6e",
      "kind": "text_data",
      "source_text": "其实，由于父亲的影响，很了解高尔夫球。",
      "source_fingerprint": "fde494fdcc70746a1067833ef26c48afabd49d4490026c3e7174f588b6b5b7d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9097"
      ]
    },
    {
      "uid": "zhcn:89ca59f53546a647e50572e1",
      "kind": "text_data",
      "source_text": "其实，擅长空手抓蜻蜓。",
      "source_fingerprint": "24ac4c82fcdd092b625719315a7395ee4f360261558597813dca32a936b7828f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9098"
      ]
    },
    {
      "uid": "zhcn:31716cc2974f452dd91d789a",
      "kind": "text_data",
      "source_text": "其实，招财猫『喵桑』和\\n发饰『达摩摩』是祖母送的礼物。",
      "source_fingerprint": "b1846d7837f4b8100bdf9739e858932ca196e43875906e6bdd33c3dc6132b74e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9099"
      ]
    },
    {
      "uid": "zhcn:32feaa809015af43358f7adc",
      "kind": "text_data",
      "source_text": "爆进的将棋讲座",
      "source_fingerprint": "186ae608cf5bb71f364e62dcef1bd466e6af696f601f8e88015fd438e806e064",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "91"
      ]
    },
    {
      "uid": "zhcn:99b21c8c8d9c7b8d99c4227a",
      "kind": "text_data",
      "source_text": "其实，擅长折纸。",
      "source_fingerprint": "408b6556d781822acaa5e26bd9c637bdaeef527facad38689f39f4665c868daa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9100"
      ]
    },
    {
      "uid": "zhcn:fbd72527d4dc5cad943ab10e",
      "kind": "text_data",
      "source_text": "其实，看电视剧的时候\\n会忍不住自言自语地吐槽。",
      "source_fingerprint": "ee70b6152d4f135db10aa326c40c5ce1435e2e8bdfdf01f972fd6d46cd13943c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9101"
      ]
    },
    {
      "uid": "zhcn:2df9894ad379329bab5660aa",
      "kind": "text_data",
      "source_text": "其实，应对严寒或酷热\\n的知识储备达到了专业水平。",
      "source_fingerprint": "4b1dde0d43392e8204cfb9ae3c9c06a5df4545d2dd95d5a4cd75811b077cc418",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9102"
      ]
    },
    {
      "uid": "zhcn:05c5ddc9cf181152a1e30283",
      "kind": "text_data",
      "source_text": "其实，对于章鱼烧机器，是完完全全的直火派。",
      "source_fingerprint": "bff700a31294a59d03285ca6fe84bcee07510b41fe7058c3553426d334e8e8f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9103"
      ]
    },
    {
      "uid": "zhcn:c100a53231d2a1d8363e2fb2",
      "kind": "text_data",
      "source_text": "其实，最近会用小提琴拉\\n『うまぴょい伝説（马儿蹦跳传说）』了。",
      "source_fingerprint": "2520be005a613f773da5fdfdc7ba5ac5ab46f985d4b694dc237ae606ce9af49f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9104"
      ]
    },
    {
      "uid": "zhcn:4883921a5581cb62b58acb38",
      "kind": "text_data",
      "source_text": "其实，5秒就能吃完香蕉。",
      "source_fingerprint": "9e3a270e4479e59068d9ab4904ecc0b67da6d7026494b8a6d9cac09942b3f867",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9105"
      ]
    },
    {
      "uid": "zhcn:314cb650223cf2f2f0707048",
      "kind": "text_data",
      "source_text": "其实，相当了解深海鱼。",
      "source_fingerprint": "ffca4b72bce1e7d0a46209dfaaa3cbb91ccd1b3822881b8c30e51fb9584504a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9106"
      ]
    },
    {
      "uid": "zhcn:27764c2a3acd8535d01a790f",
      "kind": "text_data",
      "source_text": "其实，被自己背过的人评价说\\n『感觉后背相当宽大』。",
      "source_fingerprint": "64e3ed05777ab1713bc7eeaddac14096bd3823bed23ad3d1ae82bdea468f9b12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9107"
      ]
    },
    {
      "uid": "zhcn:dcf9d559c14b9f3f671fc180",
      "kind": "text_data",
      "source_text": "其实，一个人就能完成\\n钓、处理、烤河鱼的工作。",
      "source_fingerprint": "96553ca6fadb13f98fc2bfa21ae5d5c178ca88a71391e38654d3a83c818c4983",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9108"
      ]
    },
    {
      "uid": "zhcn:252e7c0b58df45d8639c2c49",
      "kind": "text_data",
      "source_text": "其实，能够干净利落地完成\\n任何种类箱子的包装。",
      "source_fingerprint": "e48b3b74e741df3b01a629031374888077804919a67aefb445204f5b4af98024",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9109"
      ]
    },
    {
      "uid": "zhcn:94eb7a36e5047c958d900e94",
      "kind": "text_data",
      "source_text": "其实，经常看意大利的\\n职业球赛转播。",
      "source_fingerprint": "97af40d55474a451a26d95a41072659f94410d2180a6bce82737f7b484df79f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9110"
      ]
    },
    {
      "uid": "zhcn:baf0fc9a88161cb7fd75c594",
      "kind": "text_data",
      "source_text": "其实，虽然不喜欢薄荷味\\n但还是会忍着吃下去。",
      "source_fingerprint": "571c61963d4c38f655b58df4e5469d15609fe41acde6e8e701993338cc7012cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9111"
      ]
    },
    {
      "uid": "zhcn:2d284ea3d30c2199475104b2",
      "kind": "text_data",
      "source_text": "其实，无论在哪都能马上睡着。",
      "source_fingerprint": "2d9beadf3166f38b5b29ec5928e12edc52034b572bf73d17e9189b48b28dfc04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9112"
      ]
    },
    {
      "uid": "zhcn:293bbfb9fcb91ecba00d22fe",
      "kind": "text_data",
      "source_text": "其实，很朴素地沉迷于\\n独自野营的相关视频。",
      "source_fingerprint": "fb94f99196c75730f31aa236bc0814b19937526bb77c98c0fa08074dfb3de13f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9113"
      ]
    },
    {
      "uid": "zhcn:fde916d324c90824a589b839",
      "kind": "text_data",
      "source_text": "其实，收藏了好多个\\n有香味的橡皮擦。",
      "source_fingerprint": "9e5c23cd586430b758e81808a913de0cb5b0eb1a586a9eca882985d1ff740792",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9114"
      ]
    },
    {
      "uid": "zhcn:34062060e24cd472010401a9",
      "kind": "text_data",
      "source_text": "其实，能用筷子把\\n嫩豆腐完美地夹起来。",
      "source_fingerprint": "66283e26fb3a93e010dedc2c4523879585b4faedae210bb62b85e8fdf27b525d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9115"
      ]
    },
    {
      "uid": "zhcn:b76e832f59948ad93c429e58",
      "kind": "text_data",
      "source_text": "其实，只靠太阳或者星星\\n就能判断出大体时间。",
      "source_fingerprint": "13b28fa1d98aeec186f1348e7f3f695643cebd77df7e1b2e17caeda93b338822",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9116"
      ]
    },
    {
      "uid": "zhcn:7a61f4cac1c206a5f95dda90",
      "kind": "text_data",
      "source_text": "其实，看着山羊的眼睛\\n就大概能明白它的想法。",
      "source_fingerprint": "e51c9fa13631282f7d30ec52875e4858463b66ebe83e8572a5c7a22830004d18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9117"
      ]
    },
    {
      "uid": "zhcn:98c163d60216083bd10d7956",
      "kind": "text_data",
      "source_text": "其实，钢琴和陪小孩玩游戏的水平\\n相当于幼儿园老师。",
      "source_fingerprint": "9d9e73fc9a628b2f1d55f1ab3417f817f7a66703e272aa7b945031a19c08fd07",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9118"
      ]
    },
    {
      "uid": "zhcn:7bdd0f9152179060072cb714",
      "kind": "text_data",
      "source_text": "其实，偶尔会去猛禽咖啡厅。",
      "source_fingerprint": "d0a861b677429d0d1d06f8057500bde8710af128df6c78f76b03377ea8b7df05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9119"
      ]
    },
    {
      "uid": "zhcn:e44d93287dbe06c1af0eb8d3",
      "kind": "text_data",
      "source_text": "其实，打针的时候会紧闭着眼。",
      "source_fingerprint": "67a89f4ac8a29c52df5f6356eb68c972befcc2d561fdad7b58a40df46cdb1a1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9120"
      ]
    },
    {
      "uid": "zhcn:5841e822a299f7992f2ff18b",
      "kind": "text_data",
      "source_text": "其实，根据面包的不同种类\\n在哪家面包店买也很有讲究。",
      "source_fingerprint": "857f1c0df94ae4bfee3f77302a4750ae1fa1f55a7f665cb6b09c73f7c7985b2c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9121"
      ]
    },
    {
      "uid": "zhcn:7af714ae02d88b636e0daa7c",
      "kind": "text_data",
      "source_text": "其实，憧憬着榻榻米匠人。",
      "source_fingerprint": "10909d8b1cdad6f814825795ffabcbb72fdc23c179b23af04f2354506eff8754",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9122"
      ]
    },
    {
      "uid": "zhcn:695acb32b4b1a31c9de26d32",
      "kind": "text_data",
      "source_text": "其实，持有合气道的段位。",
      "source_fingerprint": "38f0e27c250c2dd88b1efa9b13ebac122df8ee63194d0cbbcc062d189359466f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9123"
      ]
    },
    {
      "uid": "zhcn:73e7d98f24565d258989411a",
      "kind": "text_data",
      "source_text": "其实，相当擅长抓独角仙。",
      "source_fingerprint": "d511befdc7b2c077d8c7f3d116c75396946bc4436139da1d2cc7a5d30a49bea6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9124"
      ]
    },
    {
      "uid": "zhcn:b3cdbb99c3ed617db12ffae3",
      "kind": "text_data",
      "source_text": "其实，只靠车站便当的菜式\\n就能猜出是哪里的东西。",
      "source_fingerprint": "b49fb194640c238d7a7209bb1b721da7fe6fbe44a7395d246edc62220e3f87c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9125"
      ]
    },
    {
      "uid": "zhcn:069e617eeccbe1261d2a1f3f",
      "kind": "text_data",
      "source_text": "其实，刷牙得花10分钟以上。",
      "source_fingerprint": "534716fb4bda6d9cdaa440bd533155c135108ad5d3ad5342a02c7a9378ca1771",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9126"
      ]
    },
    {
      "uid": "zhcn:42b060e636b29346f9e8bda3",
      "kind": "text_data",
      "source_text": "其实，给自己的所有布娃娃\\n都起了名字。",
      "source_fingerprint": "54936d4d70ba3676001572785d14018c08473b50ce2469a231e8ceb8ee1d5628",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9127"
      ]
    },
    {
      "uid": "zhcn:9ff4771230d1ec7b72830ad0",
      "kind": "text_data",
      "source_text": "其实，喜欢有洋酒香味的点心。",
      "source_fingerprint": "0a14321546b6d4b8feac530b5d4c1c3d215345af011f50588c0455891b1c87c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9128"
      ]
    },
    {
      "uid": "zhcn:4c891157bffd886a75707207",
      "kind": "text_data",
      "source_text": "其实，比较相信早晨的\\n星座占卜节目。",
      "source_fingerprint": "6fe832895d5fb15616ef0fb1503f77316f6aae6fdb50a0c3fd3b26c492db6ad0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9129"
      ]
    },
    {
      "uid": "zhcn:9ee731855bd066f5096e608d",
      "kind": "text_data",
      "source_text": "其实，对歌剧略知一二。",
      "source_fingerprint": "7da3cfb968fb92563a7e1cccbbad182a673c0dcb3c8de2dc4f45d7c7bb90eaff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9130"
      ]
    },
    {
      "uid": "zhcn:c5b2b8c3667456acc923eac0",
      "kind": "text_data",
      "source_text": "其实，牙齿相当结实。",
      "source_fingerprint": "1d27441c150120e0a73e53ae37aa1dfbdcf578eace55843dbfb8aa01ed09e87e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9131"
      ]
    },
    {
      "uid": "zhcn:70624605b273aef37dca00d0",
      "kind": "text_data",
      "source_text": "其实，喜欢歌舞伎，经常会去看。",
      "source_fingerprint": "dc3692ac4759db4ed39ef40589617b093318ba5b61204ae4aad479c6cd00cb83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9132"
      ]
    },
    {
      "uid": "zhcn:f15cd173ddf4d13d55d87077",
      "kind": "text_data",
      "source_text": "其实，在命名方面很独特。",
      "source_fingerprint": "5385653bd83a3fd65ddb9d7f1f751d644c533ce5d40d24615fe62929d65e1fd9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9133"
      ]
    },
    {
      "uid": "zhcn:39b91aa1a26d6be30879dbd4",
      "kind": "text_data",
      "source_text": "其实，不懂吃汉堡的方法。",
      "source_fingerprint": "bfeda2cbc96b38d4ce5aeff99f282e7b3eae24a08d4ff18144f21b3940744413",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9134"
      ]
    },
    {
      "uid": "zhcn:1a3c3d000355dcfdd6a2c80a",
      "kind": "text_data",
      "source_text": "其实，会尽可能用质量好的防晒霜。",
      "source_fingerprint": "978870345857d391df2d0dcd01279ea08c45b3795b8fe1eeaf206ecf7b30fddd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9135"
      ]
    },
    {
      "uid": "zhcn:1319fa693c28c6ad1ec649de",
      "kind": "text_data",
      "source_text": "其实，说真的正坐10秒就顶不住了。",
      "source_fingerprint": "9079a2151e91970de1c6e78421972a72194ea4db576099b0aa81f74ff4203011",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9136"
      ]
    },
    {
      "uid": "zhcn:57ce5999137038a68ace480a",
      "kind": "text_data",
      "source_text": "其实，滴眼药水的时候\\n嘴也会不自觉张开。",
      "source_fingerprint": "14bdbbcac770279b8db04d9ea2dbe561a38f9e2ce4d201a49ba97cc002744237",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9137"
      ]
    },
    {
      "uid": "zhcn:98ffca8e9c6b921eab33bfd6",
      "kind": "text_data",
      "source_text": "其实，不太会吸拉面。",
      "source_fingerprint": "347e2fb0bd8f28aa383516e1c23d4e2b7ce8ee950ce680b10b1522a1fab77f06",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9138"
      ]
    },
    {
      "uid": "zhcn:f6c25ab0efade81667e23af3",
      "kind": "text_data",
      "source_text": "其实，一吃起糖果\\n就会停不下来。",
      "source_fingerprint": "f20947252b33f38a706f9299d57173f055a89835ca684a1867f89fe0f3ef40c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9139"
      ]
    },
    {
      "uid": "zhcn:7cf895e43ef6733a8a069efd",
      "kind": "text_data",
      "source_text": "其实，芥末没事但抗不住辣椒。",
      "source_fingerprint": "1e74f17c8f8e60217783ea9c8ef8f415810b7b34553f08a3c6bf353f9922954b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9140"
      ]
    },
    {
      "uid": "zhcn:edf561b294da6d1fae9f4fba",
      "kind": "text_data",
      "source_text": "其实，国内外有好几个\\n常去的台球厅。",
      "source_fingerprint": "d72aaa5e339fbd2de58aa17b8d9cc2dee85c7eb3bd14e76b7d020a75c5f026b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9141"
      ]
    },
    {
      "uid": "zhcn:bd8974e06af4ff4aedccbcd3",
      "kind": "text_data",
      "source_text": "其实，能看上好几个小时的万花筒。",
      "source_fingerprint": "d0b0deb4ac8121b08d7aa151f2614aaf6bec89bb781fa8e344b8d7632abb8fcf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9142"
      ]
    },
    {
      "uid": "zhcn:1b6e708ba0aa457ea01c7e3f",
      "kind": "text_data",
      "source_text": "其实，动物电影光看预告都能哭出来\\n所以不会去看。",
      "source_fingerprint": "a3f4740f216d61162aef358d18b97d58ecd4763d7136459fa448f2c774ee0fc3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9143"
      ]
    },
    {
      "uid": "zhcn:82297b47ea2c7feea9573151",
      "kind": "text_data",
      "source_text": "其实，喜欢看正在飞驰的电车。",
      "source_fingerprint": "0a051b7b54dc271e0f345719b33dd77d8adaf3f61110fab1b3da07d8c52864fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9144"
      ]
    },
    {
      "uid": "zhcn:8b32aa1db4ae64d51eb8ee43",
      "kind": "text_data",
      "source_text": "其实，生气的表情和父亲一模一样。",
      "source_fingerprint": "e1fca58e1253ad820295db85c123f5139a4446871405987091411156043c6219",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9145"
      ]
    },
    {
      "uid": "zhcn:6244b2d8d102277e350b2399",
      "kind": "text_data",
      "source_text": "其实，擅长说绕口令。",
      "source_fingerprint": "11fa9517d3e43e910655783921efdd068d2caba865e0e892f96426d3bd3b658a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9146"
      ]
    },
    {
      "uid": "zhcn:0949ea40f01fb3140167f312",
      "kind": "text_data",
      "source_text": "其实，作为荞麦面美食博主\\n在圈子里很有人气。",
      "source_fingerprint": "517e731ff8357c9094e1b3d4fe128a4ea531594047b3e94322c36cd50bd2b515",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9147"
      ]
    },
    {
      "uid": "zhcn:e8d1542ebb94be8789330af7",
      "kind": "text_data",
      "source_text": "其实，在SNS中只上传\\n买的衣服或自制美甲的照片。",
      "source_fingerprint": "c374a29f9495dc687d1f23f057ef7d6a582f6cac41105412dcdd512fadcb1b0c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9148"
      ]
    },
    {
      "uid": "zhcn:3ea5d506a9a574b37d1c6875",
      "kind": "text_data",
      "source_text": "其实，有开心事的时候\\n会用砂锅煮饭。",
      "source_fingerprint": "d965a6b7eddca7457b7b81b448aa1262f6f6ea53fb98d79a7585c228a16fc746",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9149"
      ]
    },
    {
      "uid": "zhcn:c3252c050769d4b2927e9186",
      "kind": "text_data",
      "source_text": "其实，曾打算往学校食堂引进回转寿司\\n但是被制止了。",
      "source_fingerprint": "b749594301fef5d3651efdad7ee8105e24569066f90dc1ec919c2f3fa6808cd3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9150"
      ]
    },
    {
      "uid": "zhcn:80bfb02e0b98368d3f302853",
      "kind": "text_data",
      "source_text": "其实，能说7国语言。",
      "source_fingerprint": "eda20971313dadb32e647496207bae6247ddd3df20e51b9ede58232774870978",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9151"
      ]
    },
    {
      "uid": "zhcn:25062165e2e273b49129d5c4",
      "kind": "text_data",
      "source_text": "其实，曾因抓到抢劫犯\\n而收到过感谢信。",
      "source_fingerprint": "7d7476b905bb0d570551d0f1d198690dce514f82d9be4099b21e76184562c43d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9152"
      ]
    },
    {
      "uid": "zhcn:15e12b5a3d36602ae3ff0a94",
      "kind": "text_data",
      "source_text": "其实，衣服是自己做的。",
      "source_fingerprint": "dee40a053314d9ac057b8cede899ef0c81fa40f14ead40833976e386540818bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9153"
      ]
    },
    {
      "uid": "zhcn:e5e076c1e4dd6f1b3e51c5a5",
      "kind": "text_data",
      "source_text": "其实，喝两杯以上咖啡\\n就睡不着觉了。",
      "source_fingerprint": "24db779ae77fb3d085a6d9dfe472c2031a6ff34970b93ebe3a44ad145a4fe2c4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9154"
      ]
    },
    {
      "uid": "zhcn:f0190754db71ba3a63a7a23e",
      "kind": "text_data",
      "source_text": "其实，希望有一天能够\\n独自一人旅行。",
      "source_fingerprint": "157c63ff414f5e7c1d2fdfda402f7457ea13d461d4a0e4375edb9b43824d7f04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9155"
      ]
    },
    {
      "uid": "zhcn:f58466b7b11d2f3c97c352ec",
      "kind": "text_data",
      "source_text": "其实，基本上一遇到水坑就想跳过去。",
      "source_fingerprint": "eb57206ca7e294aef72c5ea84f1ff53285c174ec5f4c93149e0214616b8bbd0d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9156"
      ]
    },
    {
      "uid": "zhcn:f6bf204529033419e957b8c3",
      "kind": "text_data",
      "source_text": "其实，因为经常被人问路\\n而暗自感到得意。",
      "source_fingerprint": "6010b0e9e3ad267bb816b230de1c5ed7c232d264d9ac4f349caa586b34e3fa40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9157"
      ]
    },
    {
      "uid": "zhcn:51c35a8099a67295b8a808e0",
      "kind": "text_data",
      "source_text": "其实，吹小号的水平\\n相当好。",
      "source_fingerprint": "aef91e6c2f1dd14b7603db7f2ef6975bd179f9de0b96c3041943e2e7c2969b23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9158"
      ]
    },
    {
      "uid": "zhcn:76c1cc6b944b641c054156af",
      "kind": "text_data",
      "source_text": "其实，喜欢柏饼喜欢到\\n会吃个没完。",
      "source_fingerprint": "65910f04fe2f903f7946d89bfd17e55c1b770c32a347bc42b978286e8f977935",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9159"
      ]
    },
    {
      "uid": "zhcn:6184536879a9c6e9aece149a",
      "kind": "text_data",
      "source_text": "其实，觉得不讨彩头\\n就是最好的讨彩头。",
      "source_fingerprint": "3afba31e267f996f77f0ca324e2ede45ee4216110fe2e8f631965bb78de1bb8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9160"
      ]
    },
    {
      "uid": "zhcn:8fc90d69e347e7c9a3c0096f",
      "kind": "text_data",
      "source_text": "其实，最喜欢的英雄是“远山的金先生”。",
      "source_fingerprint": "1dcb0c10437cb7e3bad2109e749f94db410b0be16064575f9302f249fb8b7463",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9161"
      ]
    },
    {
      "uid": "zhcn:7e6603301fd07b9cfbbae4e5",
      "kind": "text_data",
      "source_text": "其实，为了能够独自一人去观光\\n正在学习法语。",
      "source_fingerprint": "75402d20051cd4a082993f1375ffc5346348a8b212c3a069dc3d8cb54e455ec6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9162"
      ]
    },
    {
      "uid": "zhcn:eba324217f105a7754dfc6f9",
      "kind": "text_data",
      "source_text": "其实，歌声像她的祖母。",
      "source_fingerprint": "d3c933b45d9fe803e0ade0091ee633a250b71eb04fae801ce110649e184f94fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9163"
      ]
    },
    {
      "uid": "zhcn:dcf82d3a63a6a73ef1e14b0d",
      "kind": "text_data",
      "source_text": "其实，『大小姐家的狗，小萨菲\\n超级无敌可爱』。",
      "source_fingerprint": "3eb1001032f78256bf9ca1e4a7031bec85f1983fb8e32dd49ca00d90cbc8bc1d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9164"
      ]
    },
    {
      "uid": "zhcn:02bcb4a4ad4958f8e56a093f",
      "kind": "text_data",
      "source_text": "其实，很擅长模仿\\n但不太会展示出来。",
      "source_fingerprint": "44d5955465160b48434b9d79c220b770c6e86838025df7ac9043fbfd668fd66c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9165"
      ]
    },
    {
      "uid": "zhcn:afd8c5d9758fb4f5b081fee0",
      "kind": "text_data",
      "source_text": "其实，受喜欢的绘本影响\\n身边有许多天鹅主题的物品。",
      "source_fingerprint": "d5fcb360300158f4972bf6f4ad66079df1bde400329a56a025c1f7db270fef82",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9166"
      ]
    },
    {
      "uid": "zhcn:be8b7a5a3abdd72b74575788",
      "kind": "text_data",
      "source_text": "其实，每天早上都会花时间\\n慢慢地梳理刘海上的白色部分。",
      "source_fingerprint": "9c87a868848a3d666fc3b2efeb106e27f6539f9ab1f4510b771633df5fa960f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9167"
      ]
    },
    {
      "uid": "zhcn:1ed9f298876b3226da4cb163",
      "kind": "text_data",
      "source_text": "其实，熟人中有知名赛马娘演员。",
      "source_fingerprint": "aa10d0b1c403d1c2c0dbeeb8cf32534f5afb181c0ec469d16ea434e151dba7cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9168"
      ]
    },
    {
      "uid": "zhcn:b541b1c41f60e4fb33273e30",
      "kind": "text_data",
      "source_text": "其实，是小孩子们的初恋对象。",
      "source_fingerprint": "90b758b19538365c88801a6f720920eefa32ef2455366440d44997da5ab3f733",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9169"
      ]
    },
    {
      "uid": "zhcn:ba1795ae9388f45676f8ab7f",
      "kind": "text_data",
      "source_text": "其实，压力太大时，会往头上\\n放个小东西然后一直发呆。",
      "source_fingerprint": "40bde6c3575d25a14fe77902b87b48e7c76e2fe58df3cf096ad10cb9729da46c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9170"
      ]
    },
    {
      "uid": "zhcn:ce6d5bd4863d3a22a443e5be",
      "kind": "text_data",
      "source_text": "其实，小时候很怕去医院，\\n爸爸妈妈二人合力才把她拖过去的。",
      "source_fingerprint": "518b9756b7db1f28eb017e799000b9d70a51796bec7f0c6dc18f003c0b3550d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9171"
      ]
    },
    {
      "uid": "zhcn:7642707d143a231bad30f0db",
      "kind": "text_data",
      "source_text": "其实，吃烤肉时经常包揽一切烤肉操作。",
      "source_fingerprint": "e3aa55beecf717b8708c3776f976cdaee0d893176dfc25a57917c2269e926548",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9172"
      ]
    },
    {
      "uid": "zhcn:2b03a4d3d75565d38c0e466e",
      "kind": "text_data",
      "source_text": "其实，发饰上的一根缎带的价格，\\n可以买下一套学校的制服。",
      "source_fingerprint": "393e8459ae8ed356f38f602158ff08ccb893b06b7d272a2ec6216899909a0046",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9173"
      ]
    },
    {
      "uid": "zhcn:2eec9050bfeda99fac41b9a8",
      "kind": "text_data",
      "source_text": "其实，梦话挺大声的。",
      "source_fingerprint": "7d91f8dd32c0e95a9cbf04aaa703978a4cf09ee3e648fa047a34432c7dbdbf55",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9174"
      ]
    },
    {
      "uid": "zhcn:3a78d936a4d836904bab15c6",
      "kind": "text_data",
      "source_text": "其实，私底下很喜欢听妹妹谈像大人\\n一样的恋爱话题。",
      "source_fingerprint": "3628d6af388d390e50f79be2dd9ead60b8f69de128376976aa4c9e7c7e8d7e92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9175"
      ]
    }
  ]
}
