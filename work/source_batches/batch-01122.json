{
  "schema_version": 1,
  "batch": 1122,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:3faade5285a3d29f5856030d",
      "kind": "text_data",
      "source_text": "其实，被拍照时总是\\n半睁着眼。",
      "source_fingerprint": "d6cc55562936a40b7c84b5517b9250f0b3f35f44909be07b01efc8c376ecfb8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9176"
      ]
    },
    {
      "uid": "zhcn:b6c6e7f5b91c174bcfb87052",
      "kind": "text_data",
      "source_text": "其实，擅长将亡灵引导到黎明的消遣\\n（其实是变废为宝DIY）。",
      "source_fingerprint": "7d2082cf80cb1c2192de009ff9d04466dbfd3228313181dd935f602af96f469f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9177"
      ]
    },
    {
      "uid": "zhcn:d6e061e0e6e642454fcb94e4",
      "kind": "text_data",
      "source_text": "其实，随身携带着\\n复古眼镜。",
      "source_fingerprint": "2d697b225d2393a7d638c8eedac082955bbd68061fcf839c3325e2c166312bf3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9178"
      ]
    },
    {
      "uid": "zhcn:aa665716a699d4edcc03866d",
      "kind": "text_data",
      "source_text": "其实，喜欢收集雨靴。",
      "source_fingerprint": "aca30d2c36b548293abdd00afa75d3730063406e7bcf7cdb2fcdadd611293748",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9179"
      ]
    },
    {
      "uid": "zhcn:19e1479f40cafd8ad0ed9f34",
      "kind": "text_data",
      "source_text": "其实，有一兴奋就舔嘴唇\\n的怪癖。",
      "source_fingerprint": "8d5b73a3c4d5a00074cb3e45e14b3bc92bb91387603fcd3b3f1dae5f5629ad84",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9180"
      ]
    },
    {
      "uid": "zhcn:df5e24fe7d2ae6f29815795a",
      "kind": "text_data",
      "source_text": "其实，拥有小型特殊载具的驾照。",
      "source_fingerprint": "70545be6788cbd57e253a29de8ac8f782f2b2131ca265101102069d5560c31d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9181"
      ]
    },
    {
      "uid": "zhcn:dc68fd1564df90feff7ec491",
      "kind": "text_data",
      "source_text": "其实，看到消沉的孩子，会背起TA奔跑，\\n给TA鼓舞。",
      "source_fingerprint": "12694eda7896ef61c59456ca4de06c2d71b0e9264a5162c66411e4c09de8a89d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9182"
      ]
    },
    {
      "uid": "zhcn:771139323e45a57463bcb31d",
      "kind": "text_data",
      "source_text": "其实，经常将动物治疗法（特别是猫）运用到\\n教学中，不过通常是本人最被治愈。",
      "source_fingerprint": "4d872f8a5a2fe417504e2988691402b5dec29d4857f03cbf5585bc8b02383f65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9183"
      ]
    },
    {
      "uid": "zhcn:990d86911300a56dee74c62e",
      "kind": "text_data",
      "source_text": "其实，很喜欢模仿鸟的羽毛和翅膀\\n制成的小物件。",
      "source_fingerprint": "db0feb76d7844bba8d12d9755a0381210b139ae2e52e2c58f7050684d9754f59",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9184"
      ]
    },
    {
      "uid": "zhcn:cd6e3f26d902619cc39c56f7",
      "kind": "text_data",
      "source_text": "其实，有高兴的事时，会给在澳大利亚\\n的儿时玩伴打电话。",
      "source_fingerprint": "b9d2da62292afe00ef481818d5674a7f2439210aa77839f7fb2640960b12edf0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9185"
      ]
    },
    {
      "uid": "zhcn:8b60b19284e1a396ca826fb3",
      "kind": "text_data",
      "source_text": "其实，很喜欢日语的拟声词。",
      "source_fingerprint": "76fe61346a45a33dd6731f3a7ae4e0b19d9b421a4fcd70cfcf8cb1b9bbf031a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9186"
      ]
    },
    {
      "uid": "zhcn:da4e24bb55099c6cc916b560",
      "kind": "text_data",
      "source_text": "其实，喜欢跟着拥有友爱之人（朋友）\\n进行巡游（散步）。",
      "source_fingerprint": "7e4b2b9a3815d6943bfb824e64cd351311f4b2ad20b21a8f8850c4fb89fbf8d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9187"
      ]
    },
    {
      "uid": "zhcn:404e9abfcdc41b6fc1185037",
      "kind": "text_data",
      "source_text": "其实，经常不拿手机就出门。",
      "source_fingerprint": "089e123edee3a90d9a18ddd968c7d8eb0974af19663840450ffcbfc6ea8d4e89",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9188"
      ]
    },
    {
      "uid": "zhcn:0d8e45f8e3f416a76e113d1e",
      "kind": "text_data",
      "source_text": "其实，喜欢蒸桑拿。",
      "source_fingerprint": "a4cd3015ef28511ed0f54793d81d43af092ca8de4a0f6215872ea0affc67e8ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9189"
      ]
    },
    {
      "uid": "zhcn:22604086861f29395d065cbd",
      "kind": "text_data",
      "source_text": "其实，睡觉的时候嘴巴会发出咀嚼的声音。",
      "source_fingerprint": "7564d3a6bee118325bdb6dae9550fa4b269a996f6a19ea3dc00a184a2874473a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9190"
      ]
    },
    {
      "uid": "zhcn:d306294bc0a110cfa2e5c834",
      "kind": "text_data",
      "source_text": "其实，非常珍爱有小伙伴们在上面\\n画了画的一面旗子。",
      "source_fingerprint": "e0bfe1b5bc5b4c99b3e1eb0764275356f225f9b64f47115abe6d6f9188e695a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9191"
      ]
    },
    {
      "uid": "zhcn:316bca1f7fef5ba822d86881",
      "kind": "text_data",
      "source_text": "其实，拥有绝对音感。",
      "source_fingerprint": "894105be7fc4e8131db82bad4960a45c51bf38c348ef50dd75a4d3e43f32f898",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9192"
      ]
    },
    {
      "uid": "zhcn:f4608b5d1936b2bf7dcbb5ec",
      "kind": "text_data",
      "source_text": "其实，吃东西喜欢与别人分享一半。",
      "source_fingerprint": "2e8c7d852657efae36cb104853eb392ef03785e35ff687e5cff71432b1c9d4f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9193"
      ]
    },
    {
      "uid": "zhcn:b80698fcd6a1f5d5850db763",
      "kind": "text_data",
      "source_text": "其实，坐电车能坐各站都停靠的慢车，\\n就绝不坐快车（因为有地方坐）。",
      "source_fingerprint": "61b47afa73d67b8f0f16797884fa19dca1310e5f980fb583fd8cf22db03781b0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9194"
      ]
    },
    {
      "uid": "zhcn:610cc6bc54b28f0324a45b35",
      "kind": "text_data",
      "source_text": "其实，绝不会因为倒时差犯困。",
      "source_fingerprint": "4e771d8db6e6b9f1877f4cbabfd04a139a26cc6ba225e1833e29f65d5da1da54",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9195"
      ]
    },
    {
      "uid": "zhcn:9ae525686455d35a4a87145d",
      "kind": "text_data",
      "source_text": "其实，私底下偶尔会因为过于懒散\\n被师傅骂。",
      "source_fingerprint": "bde6068562d6d6696a18c77d07659cf110586873685663ea514ebc40a290aaeb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9196"
      ]
    },
    {
      "uid": "zhcn:14661f13c84a2ed16a6cc0e6",
      "kind": "text_data",
      "source_text": "其实，因为自己很容易得感冒，\\n在室内会穿的很厚。",
      "source_fingerprint": "46c0295eac23a19b9e321114d1c55c61ffe2304bb1a04fca82364bc25147f4b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9197"
      ]
    },
    {
      "uid": "zhcn:b5aa39368337c0b6d28e8f1f",
      "kind": "text_data",
      "source_text": "其实，她相扑非常非常强。",
      "source_fingerprint": "d1211587925b98a1995b3f393193f0fc9628c69666cd67f8538cdedf1b0a58a3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9198"
      ]
    },
    {
      "uid": "zhcn:e5135354222016a2a053d128",
      "kind": "text_data",
      "source_text": "其实，为了未来某天的住宿，\\n准备了亲手制作的星象仪。",
      "source_fingerprint": "07f9a47e5e9ed15eae599fdedc5f24131dcb7d1aef4c476a7f3e3d5724087056",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9199"
      ]
    },
    {
      "uid": "zhcn:df9a4972a6648445e148331a",
      "kind": "text_data",
      "source_text": "温柔的味道",
      "source_fingerprint": "fe9657121371cb9928d42fdbaf9528eb8f673dfe471f55f059eafa86bdaf340d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "92"
      ]
    },
    {
      "uid": "zhcn:ebcf47b633a00ae6af5e4ced",
      "kind": "text_data",
      "source_text": "其实，有过圆圈状的零食卡在手指上\\n拔不出来的烦恼。",
      "source_fingerprint": "36aada51a262a355bf192f36f8f6cb68d041afc51a221a47138ea604762ed878",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9200"
      ]
    },
    {
      "uid": "zhcn:e6ffb04ae78fd94d71012907",
      "kind": "text_data",
      "source_text": "其实，是抱枕派。",
      "source_fingerprint": "17d72cc94ae72eecbdf17903ddb32e8ee954a6c5a29e53bdf4124f293125f29d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9201"
      ]
    },
    {
      "uid": "zhcn:9b6e15b854d848c20221d85c",
      "kind": "text_data",
      "source_text": "其实，说到她作曲时的伙伴那就是\\n『地球仪』。",
      "source_fingerprint": "cad4ccfbea4c877aa18828eb50720a9d74c334430bfc1ba9beb3d68149030bb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9202"
      ]
    },
    {
      "uid": "zhcn:41b0f7ea8a8bfdb5080f9541",
      "kind": "text_data",
      "source_text": "其实，是害虫治理专家。",
      "source_fingerprint": "4386cd15fbe937167e3f9cf6075815d40ffbaf8b3b0985c25498699379ae99a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9203"
      ]
    },
    {
      "uid": "zhcn:3d69e4346a52c2d53e1703df",
      "kind": "text_data",
      "source_text": "其实，说「求求啦♡」的语气变化\\n大概有20种。",
      "source_fingerprint": "f6379f5a1d51718347e30a0bc272b8ec466fa94f6c0a2ec2bd7946cb6fb25aeb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9204"
      ]
    },
    {
      "uid": "zhcn:0a1033dc21ff2d111fba9a6f",
      "kind": "text_data",
      "source_text": "其实，是个相当招晴的女孩。",
      "source_fingerprint": "a0f7deedcdfd149f12e6b08d209e60c75d427a63ac8508e269e28461545a32bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9205"
      ]
    },
    {
      "uid": "zhcn:f268d481cb5ba75072f75e6a",
      "kind": "text_data",
      "source_text": "其实，很擅长心算。",
      "source_fingerprint": "5af4b4017eb4f705ddcec5bb281e395bdb1ac585b71d0d8550ed5b9ba9286ce7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9206"
      ]
    },
    {
      "uid": "zhcn:c7a4d5860455fc2a52571dc4",
      "kind": "text_data",
      "source_text": "其实，对成为玻璃艺术家有些兴趣。",
      "source_fingerprint": "a65d4be4f9ae6b96ac45dcc0c87e7959088c429ee0a9df555b6e612b47c21953",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9207"
      ]
    },
    {
      "uid": "zhcn:f9dcf0035b131bf8d58a15e7",
      "kind": "text_data",
      "source_text": "其实，只靠高抬腿的风压\\n就能吹飞石像。",
      "source_fingerprint": "21bc1942f81d768b8d7045062c5cdfe2f4b767ba61f89bf9bb2787c7d1d0330d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9208"
      ]
    },
    {
      "uid": "zhcn:1974ba5c2ee1d197ef936ca8",
      "kind": "text_data",
      "source_text": "其实，能用脚趾夹碎核桃。",
      "source_fingerprint": "9a56c966ec7ffb8639624e91358cfcc502f75d71ab5706be351e10a5504e032a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9209"
      ]
    },
    {
      "uid": "zhcn:94b996c67bb08e421fe06fdc",
      "kind": "text_data",
      "source_text": "其实，只要是自己熟悉的地方\\n闭着眼也能走。",
      "source_fingerprint": "9bf6636eb67fe430249cdab451d0c963d6d641ce1825d40b3880dd55fefc4e5c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9210"
      ]
    },
    {
      "uid": "zhcn:e439cc86f44d60f01fd211e3",
      "kind": "text_data",
      "source_text": "其实，内心把和凉花小姐一起出门\\n当做一种奖励。",
      "source_fingerprint": "505e8a198ef707a760b4b1969bf52c72cc655aaa85ffd8dcdf6df5533820429a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9211"
      ]
    },
    {
      "uid": "zhcn:2068faa4c765a519b610c272",
      "kind": "text_data",
      "source_text": "其实，吃刺身只蘸芥末。",
      "source_fingerprint": "884e98e4b4331799364e4de3a25935b386310064d300901abeafac31361ea39f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9212"
      ]
    },
    {
      "uid": "zhcn:6087ceddc97c9d067e730cbc",
      "kind": "text_data",
      "source_text": "其实，很喜欢自己翘起来的闪电形状呆毛。",
      "source_fingerprint": "ac3986bc6ddd92ccedd16508bcb1a19b14f342a11394bd060cd45a175552f017",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9213"
      ]
    },
    {
      "uid": "zhcn:785a26726a60a7386b4f9c78",
      "kind": "text_data",
      "source_text": "其实，很喜欢看喜剧片。",
      "source_fingerprint": "0dbcaf0f15a03e05ca22789e04a63e9263f0cc9f5d2d4adfb04c0c17ab362edd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9214"
      ]
    },
    {
      "uid": "zhcn:2e222a883924bc075c5904bb",
      "kind": "text_data",
      "source_text": "其实，头上顶着装了水的水桶\\n也能走得飞快。",
      "source_fingerprint": "36b3574834ce98b5e4d4e6093b17ed86fa4de15badf65661e1ed258f1f5c84e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9215"
      ]
    },
    {
      "uid": "zhcn:e18763321065fd1379258de8",
      "kind": "text_data",
      "source_text": "其实，是鲨鱼电影狂热迷。",
      "source_fingerprint": "a638e7cfcfd107c71e6f46e6bc11fd9976baec142bfbc11cb494d378e97301fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9216"
      ]
    },
    {
      "uid": "zhcn:dc5dae373706d7574090815c",
      "kind": "text_data",
      "source_text": "其实，用喷过古龙水的信笺寄信。",
      "source_fingerprint": "ee31721ee0a3adfd99b6f24c6875593238abdc07a24369d1c48b82f041f1963e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9217"
      ]
    },
    {
      "uid": "zhcn:55bad5dfe1b0f0513ae9cec7",
      "kind": "text_data",
      "source_text": "其实，不爱吃干巴巴的东西。",
      "source_fingerprint": "1bc27f6996edc1ee6017992a3710a2d8a93c356b9a884c26cbefd880f8a8f304",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9218"
      ]
    },
    {
      "uid": "zhcn:189c94adf2777fc5440bdbb5",
      "kind": "text_data",
      "source_text": "其实，在想个子比姐姐们高的时候\\n该怎么撒娇。",
      "source_fingerprint": "dd85b1091964cd47d2b6d734d6512e855313bcaa340230e96cfa28742e67b37a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9219"
      ]
    },
    {
      "uid": "zhcn:060c2d80efe096f51ca6493f",
      "kind": "text_data",
      "source_text": "其实，即使戴着墨镜，\\n也容易在运动中把它弄丢。",
      "source_fingerprint": "fcb52865fb0ad2eba792a9e933a50ee36f5cfb24dc32f506a22355fb57fe1501",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9220"
      ]
    },
    {
      "uid": "zhcn:632f95da1103533f4225d8e2",
      "kind": "text_data",
      "source_text": "其实，是证书收集大师。",
      "source_fingerprint": "93036301d4d118038bf79d05959d025b6f7306c65e31afec1b75b4204ff590fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9221"
      ]
    },
    {
      "uid": "zhcn:d20c9412948321b2c48a1250",
      "kind": "text_data",
      "source_text": "其实，在遇到『姐姐』之前，\\n非常不会撒娇。",
      "source_fingerprint": "d14c826d647f8e9aa73ab58bc83c4bd9f147681d4d474743980da713ec7a3e53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9222"
      ]
    },
    {
      "uid": "zhcn:d9834d1f89f2880742c5262a",
      "kind": "text_data",
      "source_text": "其实，湿气重的日子，\\n睡醒会收获乱糟糟的头发。",
      "source_fingerprint": "89b7257dd7b07b737d8a63437510a1e15bd4b8ceec55901a8d3e6316d1fbf357",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9223"
      ]
    },
    {
      "uid": "zhcn:4894b384f38f7cde83d86cf6",
      "kind": "text_data",
      "source_text": "其实，老家有一个收集人物卡片\\n用的储藏室。",
      "source_fingerprint": "e7495b089473b8f8218de23a54076ba11f5b8303879d3eeedcffa07c1d1adf6e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9224"
      ]
    },
    {
      "uid": "zhcn:4e2ab951a776ccff019e528b",
      "kind": "text_data",
      "source_text": "其实，喝蛤蜊汤决不允许\\n自己剩下蛤蜊肉。",
      "source_fingerprint": "9059ec1fa056e1edce949193d0ea83494dd8a736162c22c8a1b37cd843fd35c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9225"
      ]
    },
    {
      "uid": "zhcn:a361fca0f9b97b30161eef0d",
      "kind": "text_data",
      "source_text": "其实，玩弹珠对战非常强。",
      "source_fingerprint": "14037a6e9a0b620886f30a5b034c881cc52e5035570303045a5e75808b0174d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9226"
      ]
    },
    {
      "uid": "zhcn:2542494a42b391096587941d",
      "kind": "text_data",
      "source_text": "其实，收集小瓷人是她的小众爱好。",
      "source_fingerprint": "a42155224d6e4c81b04be2ae2c335da84e4cb56dece3930d88c4641f7fb417e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9227"
      ]
    },
    {
      "uid": "zhcn:2fdaa198daa781ce251add84",
      "kind": "text_data",
      "source_text": "其实，如果披萨加了菠萝……也行，能吃。",
      "source_fingerprint": "d67f9de201098ce4c6bff2827e8a06ff443aa97fae4adb33ce3dfdd5736804f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9228"
      ]
    },
    {
      "uid": "zhcn:1c14b60d53307b3eaee626bc",
      "kind": "text_data",
      "source_text": "其实，是爬宠咖啡馆的常客。",
      "source_fingerprint": "f130c405b932849bbd1ba010e4d705efe81ae9caad15eb18a5d94686010731d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9229"
      ]
    },
    {
      "uid": "zhcn:f8a431ab81ce34d8203aaa93",
      "kind": "text_data",
      "source_text": "其实，只要啃一口胡萝卜，\\n就能明白是不是船桥产的。",
      "source_fingerprint": "1f7bd4aae11c42e7f73065c8384aa659ce2e75970335fbb53fc191c0444a4932",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9230"
      ]
    },
    {
      "uid": "zhcn:fd7aad3d9cf93d46fdfa2f56",
      "kind": "text_data",
      "source_text": "其实，是栗东宿舍做鬼脸大赛的冠军。",
      "source_fingerprint": "fd38a06de0f4a3ee1eabc2bbd192e457d37845e9c79635351b9aa2e03364b9ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9231"
      ]
    },
    {
      "uid": "zhcn:62ab661cceedbde396e2b3ef",
      "kind": "text_data",
      "source_text": "其实，不爱吃跳跳糖。",
      "source_fingerprint": "2de02a0ceaf136f6b71844ab4119068c5b9085ae66cc749c7502ab8bb55c6ee3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9232"
      ]
    },
    {
      "uid": "zhcn:76f321f8c0524e378ab39876",
      "kind": "text_data",
      "source_text": "其实，个人常备干酪粉。",
      "source_fingerprint": "2b0844f3b3dc00e0f7bf18eb33bef0745d0a6da7efa996775fb93fcf1885b2e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9233"
      ]
    },
    {
      "uid": "zhcn:aa9827621fb76596aed0f3e0",
      "kind": "text_data",
      "source_text": "其实，经常听广播学习英语对话。",
      "source_fingerprint": "f252d44d042804f9f385412e5b4ef54d5fc1f907f134301ba1f5fdaee12d3b88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9234"
      ]
    },
    {
      "uid": "zhcn:883be56a3f8c693971987d39",
      "kind": "text_data",
      "source_text": "其实，在沙滩上总是能想出好对策。",
      "source_fingerprint": "d9d65d8f003ea98922c3b60f7c8c6c235d6200782c4b1acb7765d8b0081d95b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9235"
      ]
    },
    {
      "uid": "zhcn:d941eb128d2099864b8fe248",
      "kind": "text_data",
      "source_text": "其实，有点心吃就幸福。\\n如果还有咖啡，就更幸福。",
      "source_fingerprint": "3eac6a20a20a443b2043a51fd9e6d738b1d164fde800a42f5c069a420af49379",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9236"
      ]
    },
    {
      "uid": "zhcn:4cf4c35002d4b2973ce7953f",
      "kind": "text_data",
      "source_text": "其实，人生第一次\\n『灵光一闪』的对象是姐姐。",
      "source_fingerprint": "dc39a74fb7881be6ab23f7c35244ae2a22fdd7d586da076bf12be096c1ed8f8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9237"
      ]
    },
    {
      "uid": "zhcn:f80b9c6c8b2129b29baba585",
      "kind": "text_data",
      "source_text": "其实，正在研究自制的沙拉酱汁。",
      "source_fingerprint": "b0316a926398a42850c973df048a6cef1d20614e2a112df197dbf98d177f52fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9238"
      ]
    },
    {
      "uid": "zhcn:1349c713322620b3b22fa01c",
      "kind": "text_data",
      "source_text": "其实，■■■■■■■■■■。",
      "source_fingerprint": "b13fed1ec3dd194ca2577fffabade821ec661973f21019545d5a66537d7ce25b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9239"
      ]
    },
    {
      "uid": "zhcn:a749aa5d51c79ca7b44d8f5e",
      "kind": "text_data",
      "source_text": "其实，刘海的白色流星\\n怎么掰直都会向右弯曲。",
      "source_fingerprint": "a126f2d5803c940b0b9a18b20709a526702abbfaf281bb5cd2630fe3b8ebf890",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9240"
      ]
    },
    {
      "uid": "zhcn:a1b1ba851252c660f8f6a21a",
      "kind": "text_data",
      "source_text": "其实，如果番茄不切得非～常薄，她就不吃。",
      "source_fingerprint": "3cf23a23277ab56d5f3b7c639448eaa8aa8aa025f05d32cc9e543d3629ce616a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9241"
      ]
    },
    {
      "uid": "zhcn:caa6684ffb9011ff7cbf2f01",
      "kind": "text_data",
      "source_text": "其实，自从开始一个人生活后\\n和养的小龙虾说话的次数变多了。",
      "source_fingerprint": "92dd393eee34ddf63f31cef02c78ed046a79c137d404e886458a4906b2eab42f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9242"
      ]
    },
    {
      "uid": "zhcn:120d234ca42642b310ba1b65",
      "kind": "text_data",
      "source_text": "其实，对全天候赛道的气味\\n有点上瘾，挺喜欢的。",
      "source_fingerprint": "de0ad0bbe62f0f0540556fb557ec447147e74350df1fcef9af9375bea7ed2706",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9243"
      ]
    },
    {
      "uid": "zhcn:3447aec03cf9af9f455e4554",
      "kind": "text_data",
      "source_text": "其实，每当看到带有中奖券的点心时\\n总是不由自主地买下来。",
      "source_fingerprint": "25ecbec8842b06f7275eb0855537b966100eef4e9ee48b6381c00a942f0e5cbc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9244"
      ]
    },
    {
      "uid": "zhcn:2f452cf191ac9b0ce66f01a4",
      "kind": "text_data",
      "source_text": "其实，被附近的小朋友们\\n起的绰号是『快驹老师』。",
      "source_fingerprint": "1043a6f20404acabacde5fc0b12f5a255fca8eeef6e60f4d15c34ec8cc4466c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9245"
      ]
    },
    {
      "uid": "zhcn:466490d728b98568b07c2501",
      "kind": "text_data",
      "source_text": "其实，正在参加当地的登山爱好者协会。",
      "source_fingerprint": "e52720641cc90e633c3b026423d1e9a6faed0c4bda98893d718c992db67723f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9246"
      ]
    },
    {
      "uid": "zhcn:ea37985cac180943603c663d",
      "kind": "text_data",
      "source_text": "其实，闹钟铃声是\\n法螺贝的声音。",
      "source_fingerprint": "2e00ed122455fce5fca6b8b0a599a6f5d0b75a120deb972635e77b5937099926",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9247"
      ]
    },
    {
      "uid": "zhcn:d24712913cad782448449454",
      "kind": "text_data",
      "source_text": "其实，经常在镜子前练习微笑。",
      "source_fingerprint": "a6d59eb507d0dbdd1f71640f0ca991a57ca17e862bd9d78a1b40c643ad8c3398",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9248"
      ]
    },
    {
      "uid": "zhcn:b817ab3ac84921ef92f647ba",
      "kind": "text_data",
      "source_text": "其实，有点不太喜欢椰枣。",
      "source_fingerprint": "0220aff57175fe8fe07441f511436a71e2b74a90fecc31f96ad3ea1256fa6d74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9249"
      ]
    },
    {
      "uid": "zhcn:e5be78627fd22608f91c199b",
      "kind": "text_data",
      "source_text": "其实，――――――那种事情，\\n如果能直接问就好了。",
      "source_fingerprint": "1cbad0e80238d33f19033369963b6380ab45021a143cc91faea7fa545bd30411",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9250"
      ]
    },
    {
      "uid": "zhcn:f0f874454ef173a0485d5480",
      "kind": "text_data",
      "source_text": "其实，最近发现所有的密码都设成了1111\\n最后全部改掉了。",
      "source_fingerprint": "af4563ae72a2d28a5ba37ee8367176fe27609c85f8442c3dde03387081227ddb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9251"
      ]
    },
    {
      "uid": "zhcn:064ea533e100fd65b665a770",
      "kind": "text_data",
      "source_text": "其实，因为睡相太差\\n把床单撕得稀烂。",
      "source_fingerprint": "78c9af134ec3094a19d18bfbab0c2c2ab5487dd8ca149eff649f1a501f837047",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9252"
      ]
    },
    {
      "uid": "zhcn:2225c794d70b3bfdb0002d38",
      "kind": "text_data",
      "source_text": "其实，自称是抽签高手。\\n（秘诀是从底・下・抽♡）",
      "source_fingerprint": "ce8d85ce66e80eb2be756b9b09ea58315c6579d3eb3739268adb63d878c211f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9253"
      ]
    },
    {
      "uid": "zhcn:ebfaf72d9fba97e7755dc843",
      "kind": "text_data",
      "source_text": "其实，一直定期订阅梦幻可爱角色品牌\\n发行的月刊报纸。",
      "source_fingerprint": "7f304e89f8c9adeab858387c5a751c6a56fe2c5e9b882662fb436bf96aa342e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9254"
      ]
    }
  ]
}
