{
  "schema_version": 1,
  "batch": 1128,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:919f83be234793129a6445f6",
      "kind": "text_data",
      "source_text": "其实，可以做到全学校最漂亮的前空翻。",
      "source_fingerprint": "cbcbdcb40bdec5223ba7c71e3bfe0b079a79183e80bf27884112375e5fb256e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9059"
      ]
    },
    {
      "uid": "zhcn:527533e5dda68b39d3a1f4f6",
      "kind": "text_data",
      "source_text": "其实，有点不擅长坐电梯。",
      "source_fingerprint": "b6ebae240bfdc3365de9ebe046be8dbee1a253921acc63407c2f8720043b5c8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9060"
      ]
    },
    {
      "uid": "zhcn:7e7591c27ad2d2e1c027fd1e",
      "kind": "text_data",
      "source_text": "其实，现在的帽子是第三代。",
      "source_fingerprint": "81f455a253c4b83edcee115d693fe5df881d370777460cbb173db380676aab2c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9061"
      ]
    },
    {
      "uid": "zhcn:731511745b02b745d0ca8367",
      "kind": "text_data",
      "source_text": "其实，三股辫打结的数量是固定的。",
      "source_fingerprint": "b08abddd34663cb39c70113d41b99cdbe0dd67dbc0f959f81fed6cec3a4946a2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9062"
      ]
    },
    {
      "uid": "zhcn:04c771ef927652bf4dbd499f",
      "kind": "text_data",
      "source_text": "其实，把学到的辣妹语\\n全部记在了日记上。",
      "source_fingerprint": "5c275ee14afc122d01724a02a2e9888118d5bf354ed03f496c6df823ec5a4c4e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9063"
      ]
    },
    {
      "uid": "zhcn:cc0149d012589f501d0c60e9",
      "kind": "text_data",
      "source_text": "其实，希望好姬友能在心态暂崩的时候\\n理一下自己。",
      "source_fingerprint": "5f8e32c0ef83d7f0ff57fc615f972ebd8afd34f5e152b6f0a27772dcde1fa036",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9064"
      ]
    },
    {
      "uid": "zhcn:c26ec8fc37af85c7caa6189e",
      "kind": "text_data",
      "source_text": "其实，很擅长太空步。",
      "source_fingerprint": "00b7aff494a26f7b4d8d2c5d60caf5225a1234202e233c0af81b2c68d2111135",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9065"
      ]
    },
    {
      "uid": "zhcn:9ce9b914e382fbb1f337f9ae",
      "kind": "text_data",
      "source_text": "其实，非常珍重从父亲那里\\n得到的点唱机。",
      "source_fingerprint": "9fe0123d9361f69904d0b253372ea695228f8bea3ee34c7dc107fc46cfed1297",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9066"
      ]
    },
    {
      "uid": "zhcn:7fe4403b060d4361b4bd6595",
      "kind": "text_data",
      "source_text": "其实，喜欢的东西大多是一见钟情。",
      "source_fingerprint": "e69a120a2b60cd38f6c08adb8f5b86ed74af79dfa0856aca31ba23df1d0adbb5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9067"
      ]
    },
    {
      "uid": "zhcn:9bb208906bebd4a12db029fc",
      "kind": "text_data",
      "source_text": "其实，红色的车经过时会不自觉地看看。",
      "source_fingerprint": "01cccebc6eb06c511e715e642329b0f0baf2a84c6f21ebf181ab7d7d90d94e2a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9068"
      ]
    },
    {
      "uid": "zhcn:6153e229f71e9132650c686b",
      "kind": "text_data",
      "source_text": "其实，有小型飞机的驾驶证。",
      "source_fingerprint": "8b5777332f733811dfd52fa41f9c7c5b18efc033aa016d9ab2ba61e3b4d6acad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9069"
      ]
    },
    {
      "uid": "zhcn:86c4b3e1f8a33834e4724790",
      "kind": "text_data",
      "source_text": "其实，喜欢看色彩鲜艳的\\n大特价传单。",
      "source_fingerprint": "4b8965a4b567641f91648170581c22a858a4af4af88ad201f04a74b380de99bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9070"
      ]
    },
    {
      "uid": "zhcn:249600d24bb5e84dd0c0a17b",
      "kind": "text_data",
      "source_text": "其实，一旦内心动摇\\n就只能写出幼儿水平的字。",
      "source_fingerprint": "c55bbd05dc5bbd6c251fd3d2f59700c8fe3bfadfe462468ffabd1ac96f23d384",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9071"
      ]
    },
    {
      "uid": "zhcn:b23b525a4a201f44ddc2879a",
      "kind": "text_data",
      "source_text": "其实，很擅长背人\\n被背的人很快就能睡着。",
      "source_fingerprint": "70f2376b39c4b006dbe97f126a4eb30e8afa8108fdfdef8a4359e7b2fa692c9a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9072"
      ]
    },
    {
      "uid": "zhcn:4d5f66cde2131572cfe7324b",
      "kind": "text_data",
      "source_text": "其实，屯了好多双\\n相同的鞋子。",
      "source_fingerprint": "9158d9a69e9d19944297e2b7f5ee0f358b51e5edfe82ed4172fe4c7fc42e73c0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9073"
      ]
    },
    {
      "uid": "zhcn:03487ee07a00cde2778ae23f",
      "kind": "text_data",
      "source_text": "其实，小时候经常去海边玩\\n曾被大家叫做『海滨帝王』。",
      "source_fingerprint": "46fde22b072754ed8a0a6e07434810e11d6676422993e971762ca42d267428f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9074"
      ]
    },
    {
      "uid": "zhcn:3595b2d9be8ac264bdd12d4a",
      "kind": "text_data",
      "source_text": "其实，对于该在什么时机\\n吞下椰纤果这件事上很迷茫。",
      "source_fingerprint": "8d86ad0142f411bca08909c6017af51d2ff2880f55eae349f801bebe2f0555bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9075"
      ]
    },
    {
      "uid": "zhcn:a3d92f5f567f912191c69abc",
      "kind": "text_data",
      "source_text": "其实，经常参加\\n自己粉丝举办的茶会。",
      "source_fingerprint": "40a85eb7afd2bf1c75915bb16a956c2a8cdaae1a34570cd0e4362232abb1b52f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9076"
      ]
    },
    {
      "uid": "zhcn:93e8a67d302ae1ffeb67ed1f",
      "kind": "text_data",
      "source_text": "其实，在未来的志向那一栏填了『土手味噌煮』。",
      "source_fingerprint": "78ebfeb13cc6c15b78e01a38e47a429af07979d3617f644db30bcfe51fb85ff7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9077"
      ]
    },
    {
      "uid": "zhcn:163382ddbff207c7bc3360c4",
      "kind": "text_data",
      "source_text": "其实，会说一堆毫无意义的谎话，\\n但有意义的谎话几乎不说。",
      "source_fingerprint": "a70313b6d90121cabb291d66442c70aaf3363344f235620f22829a765dd7a050",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9078"
      ]
    },
    {
      "uid": "zhcn:e9f9d8fe2a76983928209f74",
      "kind": "text_data",
      "source_text": "其实，正在存压岁钱打算买摩托车。",
      "source_fingerprint": "a8ace69b1f1100b6e0431b1066964af22b79070afaa88400f813476aed719d4c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9079"
      ]
    },
    {
      "uid": "zhcn:ef85d35f9b24c3a08cabbe9a",
      "kind": "text_data",
      "source_text": "其实，经常给喜欢的漫画作者\\n寄粉丝信。",
      "source_fingerprint": "103ddfc9d1f40ca06a606b102f2c0cf7a600ece2f96bde097bd4c68649ba48f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9080"
      ]
    },
    {
      "uid": "zhcn:d5f469a763c89800fff75f89",
      "kind": "text_data",
      "source_text": "其实，在烧烤收尾时\\n喜欢吃汉堡。",
      "source_fingerprint": "505310bf7c53689d9a5a90e27e161bb67616476e4a9defe79e7a43347747b957",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9081"
      ]
    },
    {
      "uid": "zhcn:e2bc30545219469f3f93dad8",
      "kind": "text_data",
      "source_text": "其实，正在烦恼抹茶拿铁\\n算不算一种『和』。",
      "source_fingerprint": "fc555f0a293d9db45b796ef0f896b81e74d02c200cb8cc86a13fa8d1a4c17a9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9082"
      ]
    },
    {
      "uid": "zhcn:b15d462bb93bcda0fd75734d",
      "kind": "text_data",
      "source_text": "其实，请教了后辈之后\\n现在常在Umasta里上传卡通便当。",
      "source_fingerprint": "511733813fc59dd5bf7bcdcad33cc147a8320852cb5b17f8d83d4ef405789064",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9083"
      ]
    },
    {
      "uid": "zhcn:37e6e34173c6f2c7263e876f",
      "kind": "text_data",
      "source_text": "其实，在奶茶方面\\n是先放牛奶派。",
      "source_fingerprint": "d07d4b35b36531e3620718d7338dadd31a3afd3a50bc711898fd3f8a96978eab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9084"
      ]
    },
    {
      "uid": "zhcn:bf848444d757750f8bf8e38f",
      "kind": "text_data",
      "source_text": "其实，很容易感到痒。",
      "source_fingerprint": "d75251e8a3b37770a8d8a910b4abae8ab754737051caea1949aab26f32599899",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9085"
      ]
    },
    {
      "uid": "zhcn:e74edcefae511323078d01ad",
      "kind": "text_data",
      "source_text": "其实，珍爱的小镜子\\n是从小学时代用到现在的东西。",
      "source_fingerprint": "f5d1b2db297e8406c89d01e176f25cc1d9c6cdc0ec7a9ba37415e251079db671",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9086"
      ]
    },
    {
      "uid": "zhcn:44a2571cdfa8b364b8cc8618",
      "kind": "text_data",
      "source_text": "其实，挑战垂直并漂亮地盖印章\\n是文件整理工作中的隐秘乐趣。",
      "source_fingerprint": "bf45461b460883b936955fb1b0b42d078e7c919811bd57c7a5057c067fe997e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9087"
      ]
    },
    {
      "uid": "zhcn:54b6a22d46510bfb54826ae4",
      "kind": "text_data",
      "source_text": "其实，想放松的时候\\n会去听肖邦的CD。",
      "source_fingerprint": "414bb90e0d6ce1a231f79bfa4c7f059de4e5a329a1a32d8f69a94b83fb004ed6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9088"
      ]
    },
    {
      "uid": "zhcn:6e022b8c52fb1ced18481f6c",
      "kind": "text_data",
      "source_text": "其实，不喜欢领子紧的衣服。",
      "source_fingerprint": "ded9e237974bc83d285d335f795817c0ac86548f57622b986261e7af40c98fc6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9089"
      ]
    },
    {
      "uid": "zhcn:bcbc1452178f2989d3aec507",
      "kind": "text_data",
      "source_text": "其实，对动作电影很挑剔。",
      "source_fingerprint": "e77c76d2e8b8220f1d5368d5555069bd8b353dd314d252ce3c0127f70ead9dd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9090"
      ]
    },
    {
      "uid": "zhcn:98dc364bfb598464371fe856",
      "kind": "text_data",
      "source_text": "其实，买衣服一定会先试穿。",
      "source_fingerprint": "962a82242a870847d986f4b92b1c55fe8d9557f687c8239e130387fa46fa76f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9091"
      ]
    },
    {
      "uid": "zhcn:ad783f5059d27147f517406d",
      "kind": "text_data",
      "source_text": "其实，梦想是有一天能买到\\n500色的彩色铅笔套装。",
      "source_fingerprint": "26f2a490e7a629330547f62c7cac1798699c76d74c1e9c59b7ae28fe67c9fbe6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9092"
      ]
    },
    {
      "uid": "zhcn:2b3710d115de2e785a77e5af",
      "kind": "text_data",
      "source_text": "其实，私服是在网上随便买的\\n所以尺码一般不合适。",
      "source_fingerprint": "038891c4e25358d2dd394bc9077bf2f3bb9c1fad6c8adb76cb7701c363e7c9ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9093"
      ]
    },
    {
      "uid": "zhcn:007a8c26441c9646b0a1b6b2",
      "kind": "text_data",
      "source_text": "其实，很了解各种运动的规则。",
      "source_fingerprint": "d5a8da7cac763cda8bc62d4da3c72119d26a088b173c303296b71d740afbf0ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9094"
      ]
    },
    {
      "uid": "zhcn:3e667d4ff6f8511b080d58c9",
      "kind": "text_data",
      "source_text": "其实，看见衣服和化妆品，\\n脑中就会浮现出与之相衬的熟人面孔。",
      "source_fingerprint": "14e6c613a34ed084c20860f0708e6e5991f7e5327d6d09bbb0a81c00d00fd407",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9095"
      ]
    },
    {
      "uid": "zhcn:7d8de2bd992e6a3fc93e874c",
      "kind": "text_data",
      "source_text": "其实，擅长泡绿茶。",
      "source_fingerprint": "dfb1753f22f65b9478312a3445b41892db22a321e217a69cb886e5fcb3ae4651",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9096"
      ]
    },
    {
      "uid": "zhcn:5f9f41977d22e81200a84e6e",
      "kind": "text_data",
      "source_text": "其实，由于父亲的影响，很了解高尔夫球。",
      "source_fingerprint": "fde494fdcc70746a1067833ef26c48afabd49d4490026c3e7174f588b6b5b7d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9097"
      ]
    },
    {
      "uid": "zhcn:89ca59f53546a647e50572e1",
      "kind": "text_data",
      "source_text": "其实，擅长空手抓蜻蜓。",
      "source_fingerprint": "24ac4c82fcdd092b625719315a7395ee4f360261558597813dca32a936b7828f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9098"
      ]
    },
    {
      "uid": "zhcn:31716cc2974f452dd91d789a",
      "kind": "text_data",
      "source_text": "其实，招财猫『喵桑』和\\n发饰『达摩摩』是祖母送的礼物。",
      "source_fingerprint": "b1846d7837f4b8100bdf9739e858932ca196e43875906e6bdd33c3dc6132b74e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9099"
      ]
    },
    {
      "uid": "zhcn:32feaa809015af43358f7adc",
      "kind": "text_data",
      "source_text": "爆进的将棋讲座",
      "source_fingerprint": "186ae608cf5bb71f364e62dcef1bd466e6af696f601f8e88015fd438e806e064",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "91"
      ]
    },
    {
      "uid": "zhcn:99b21c8c8d9c7b8d99c4227a",
      "kind": "text_data",
      "source_text": "其实，擅长折纸。",
      "source_fingerprint": "408b6556d781822acaa5e26bd9c637bdaeef527facad38689f39f4665c868daa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9100"
      ]
    },
    {
      "uid": "zhcn:fbd72527d4dc5cad943ab10e",
      "kind": "text_data",
      "source_text": "其实，看电视剧的时候\\n会忍不住自言自语地吐槽。",
      "source_fingerprint": "ee70b6152d4f135db10aa326c40c5ce1435e2e8bdfdf01f972fd6d46cd13943c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9101"
      ]
    },
    {
      "uid": "zhcn:2df9894ad379329bab5660aa",
      "kind": "text_data",
      "source_text": "其实，应对严寒或酷热\\n的知识储备达到了专业水平。",
      "source_fingerprint": "4b1dde0d43392e8204cfb9ae3c9c06a5df4545d2dd95d5a4cd75811b077cc418",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9102"
      ]
    },
    {
      "uid": "zhcn:05c5ddc9cf181152a1e30283",
      "kind": "text_data",
      "source_text": "其实，对于章鱼烧机器，是完完全全的直火派。",
      "source_fingerprint": "bff700a31294a59d03285ca6fe84bcee07510b41fe7058c3553426d334e8e8f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9103"
      ]
    },
    {
      "uid": "zhcn:c100a53231d2a1d8363e2fb2",
      "kind": "text_data",
      "source_text": "其实，最近会用小提琴拉\\n『うまぴょい伝説（马儿蹦跳传说）』了。",
      "source_fingerprint": "2520be005a613f773da5fdfdc7ba5ac5ab46f985d4b694dc237ae606ce9af49f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9104"
      ]
    },
    {
      "uid": "zhcn:4883921a5581cb62b58acb38",
      "kind": "text_data",
      "source_text": "其实，5秒就能吃完香蕉。",
      "source_fingerprint": "9e3a270e4479e59068d9ab4904ecc0b67da6d7026494b8a6d9cac09942b3f867",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9105"
      ]
    },
    {
      "uid": "zhcn:314cb650223cf2f2f0707048",
      "kind": "text_data",
      "source_text": "其实，相当了解深海鱼。",
      "source_fingerprint": "ffca4b72bce1e7d0a46209dfaaa3cbb91ccd1b3822881b8c30e51fb9584504a4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9106"
      ]
    },
    {
      "uid": "zhcn:27764c2a3acd8535d01a790f",
      "kind": "text_data",
      "source_text": "其实，被自己背过的人评价说\\n『感觉后背相当宽大』。",
      "source_fingerprint": "64e3ed05777ab1713bc7eeaddac14096bd3823bed23ad3d1ae82bdea468f9b12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9107"
      ]
    },
    {
      "uid": "zhcn:dcf9d559c14b9f3f671fc180",
      "kind": "text_data",
      "source_text": "其实，一个人就能完成\\n钓、处理、烤河鱼的工作。",
      "source_fingerprint": "96553ca6fadb13f98fc2bfa21ae5d5c178ca88a71391e38654d3a83c818c4983",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9108"
      ]
    },
    {
      "uid": "zhcn:252e7c0b58df45d8639c2c49",
      "kind": "text_data",
      "source_text": "其实，能够干净利落地完成\\n任何种类箱子的包装。",
      "source_fingerprint": "e48b3b74e741df3b01a629031374888077804919a67aefb445204f5b4af98024",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9109"
      ]
    },
    {
      "uid": "zhcn:94eb7a36e5047c958d900e94",
      "kind": "text_data",
      "source_text": "其实，经常看意大利的\\n职业球赛转播。",
      "source_fingerprint": "97af40d55474a451a26d95a41072659f94410d2180a6bce82737f7b484df79f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9110"
      ]
    },
    {
      "uid": "zhcn:baf0fc9a88161cb7fd75c594",
      "kind": "text_data",
      "source_text": "其实，虽然不喜欢薄荷味\\n但还是会忍着吃下去。",
      "source_fingerprint": "571c61963d4c38f655b58df4e5469d15609fe41acde6e8e701993338cc7012cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9111"
      ]
    },
    {
      "uid": "zhcn:2d284ea3d30c2199475104b2",
      "kind": "text_data",
      "source_text": "其实，无论在哪都能马上睡着。",
      "source_fingerprint": "2d9beadf3166f38b5b29ec5928e12edc52034b572bf73d17e9189b48b28dfc04",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9112"
      ]
    },
    {
      "uid": "zhcn:293bbfb9fcb91ecba00d22fe",
      "kind": "text_data",
      "source_text": "其实，很朴素地沉迷于\\n独自野营的相关视频。",
      "source_fingerprint": "fb94f99196c75730f31aa236bc0814b19937526bb77c98c0fa08074dfb3de13f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9113"
      ]
    },
    {
      "uid": "zhcn:fde916d324c90824a589b839",
      "kind": "text_data",
      "source_text": "其实，收藏了好多个\\n有香味的橡皮擦。",
      "source_fingerprint": "9e5c23cd586430b758e81808a913de0cb5b0eb1a586a9eca882985d1ff740792",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9114"
      ]
    },
    {
      "uid": "zhcn:34062060e24cd472010401a9",
      "kind": "text_data",
      "source_text": "其实，能用筷子把\\n嫩豆腐完美地夹起来。",
      "source_fingerprint": "66283e26fb3a93e010dedc2c4523879585b4faedae210bb62b85e8fdf27b525d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9115"
      ]
    },
    {
      "uid": "zhcn:b76e832f59948ad93c429e58",
      "kind": "text_data",
      "source_text": "其实，只靠太阳或者星星\\n就能判断出大体时间。",
      "source_fingerprint": "13b28fa1d98aeec186f1348e7f3f695643cebd77df7e1b2e17caeda93b338822",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9116"
      ]
    },
    {
      "uid": "zhcn:7a61f4cac1c206a5f95dda90",
      "kind": "text_data",
      "source_text": "其实，看着山羊的眼睛\\n就大概能明白它的想法。",
      "source_fingerprint": "e51c9fa13631282f7d30ec52875e4858463b66ebe83e8572a5c7a22830004d18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9117"
      ]
    },
    {
      "uid": "zhcn:98c163d60216083bd10d7956",
      "kind": "text_data",
      "source_text": "其实，钢琴和陪小孩玩游戏的水平\\n相当于幼儿园老师。",
      "source_fingerprint": "9d9e73fc9a628b2f1d55f1ab3417f817f7a66703e272aa7b945031a19c08fd07",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9118"
      ]
    },
    {
      "uid": "zhcn:7bdd0f9152179060072cb714",
      "kind": "text_data",
      "source_text": "其实，偶尔会去猛禽咖啡厅。",
      "source_fingerprint": "d0a861b677429d0d1d06f8057500bde8710af128df6c78f76b03377ea8b7df05",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9119"
      ]
    },
    {
      "uid": "zhcn:e44d93287dbe06c1af0eb8d3",
      "kind": "text_data",
      "source_text": "其实，打针的时候会紧闭着眼。",
      "source_fingerprint": "67a89f4ac8a29c52df5f6356eb68c972befcc2d561fdad7b58a40df46cdb1a1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9120"
      ]
    },
    {
      "uid": "zhcn:5841e822a299f7992f2ff18b",
      "kind": "text_data",
      "source_text": "其实，根据面包的不同种类\\n在哪家面包店买也很有讲究。",
      "source_fingerprint": "857f1c0df94ae4bfee3f77302a4750ae1fa1f55a7f665cb6b09c73f7c7985b2c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9121"
      ]
    },
    {
      "uid": "zhcn:7af714ae02d88b636e0daa7c",
      "kind": "text_data",
      "source_text": "其实，憧憬着榻榻米匠人。",
      "source_fingerprint": "10909d8b1cdad6f814825795ffabcbb72fdc23c179b23af04f2354506eff8754",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9122"
      ]
    },
    {
      "uid": "zhcn:695acb32b4b1a31c9de26d32",
      "kind": "text_data",
      "source_text": "其实，持有合气道的段位。",
      "source_fingerprint": "38f0e27c250c2dd88b1efa9b13ebac122df8ee63194d0cbbcc062d189359466f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9123"
      ]
    },
    {
      "uid": "zhcn:73e7d98f24565d258989411a",
      "kind": "text_data",
      "source_text": "其实，相当擅长抓独角仙。",
      "source_fingerprint": "d511befdc7b2c077d8c7f3d116c75396946bc4436139da1d2cc7a5d30a49bea6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9124"
      ]
    },
    {
      "uid": "zhcn:b3cdbb99c3ed617db12ffae3",
      "kind": "text_data",
      "source_text": "其实，只靠车站便当的菜式\\n就能猜出是哪里的东西。",
      "source_fingerprint": "b49fb194640c238d7a7209bb1b721da7fe6fbe44a7395d246edc62220e3f87c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9125"
      ]
    },
    {
      "uid": "zhcn:069e617eeccbe1261d2a1f3f",
      "kind": "text_data",
      "source_text": "其实，刷牙得花10分钟以上。",
      "source_fingerprint": "534716fb4bda6d9cdaa440bd533155c135108ad5d3ad5342a02c7a9378ca1771",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9126"
      ]
    },
    {
      "uid": "zhcn:42b060e636b29346f9e8bda3",
      "kind": "text_data",
      "source_text": "其实，给自己的所有布娃娃\\n都起了名字。",
      "source_fingerprint": "54936d4d70ba3676001572785d14018c08473b50ce2469a231e8ceb8ee1d5628",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9127"
      ]
    },
    {
      "uid": "zhcn:9ff4771230d1ec7b72830ad0",
      "kind": "text_data",
      "source_text": "其实，喜欢有洋酒香味的点心。",
      "source_fingerprint": "0a14321546b6d4b8feac530b5d4c1c3d215345af011f50588c0455891b1c87c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9128"
      ]
    },
    {
      "uid": "zhcn:4c891157bffd886a75707207",
      "kind": "text_data",
      "source_text": "其实，比较相信早晨的\\n星座占卜节目。",
      "source_fingerprint": "6fe832895d5fb15616ef0fb1503f77316f6aae6fdb50a0c3fd3b26c492db6ad0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9129"
      ]
    },
    {
      "uid": "zhcn:9ee731855bd066f5096e608d",
      "kind": "text_data",
      "source_text": "其实，对歌剧略知一二。",
      "source_fingerprint": "7da3cfb968fb92563a7e1cccbbad182a673c0dcb3c8de2dc4f45d7c7bb90eaff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9130"
      ]
    },
    {
      "uid": "zhcn:c5b2b8c3667456acc923eac0",
      "kind": "text_data",
      "source_text": "其实，牙齿相当结实。",
      "source_fingerprint": "1d27441c150120e0a73e53ae37aa1dfbdcf578eace55843dbfb8aa01ed09e87e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9131"
      ]
    },
    {
      "uid": "zhcn:70624605b273aef37dca00d0",
      "kind": "text_data",
      "source_text": "其实，喜欢歌舞伎，经常会去看。",
      "source_fingerprint": "dc3692ac4759db4ed39ef40589617b093318ba5b61204ae4aad479c6cd00cb83",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9132"
      ]
    },
    {
      "uid": "zhcn:f15cd173ddf4d13d55d87077",
      "kind": "text_data",
      "source_text": "其实，在命名方面很独特。",
      "source_fingerprint": "5385653bd83a3fd65ddb9d7f1f751d644c533ce5d40d24615fe62929d65e1fd9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9133"
      ]
    },
    {
      "uid": "zhcn:39b91aa1a26d6be30879dbd4",
      "kind": "text_data",
      "source_text": "其实，不懂吃汉堡的方法。",
      "source_fingerprint": "bfeda2cbc96b38d4ce5aeff99f282e7b3eae24a08d4ff18144f21b3940744413",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9134"
      ]
    },
    {
      "uid": "zhcn:1a3c3d000355dcfdd6a2c80a",
      "kind": "text_data",
      "source_text": "其实，会尽可能用质量好的防晒霜。",
      "source_fingerprint": "978870345857d391df2d0dcd01279ea08c45b3795b8fe1eeaf206ecf7b30fddd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9135"
      ]
    },
    {
      "uid": "zhcn:1319fa693c28c6ad1ec649de",
      "kind": "text_data",
      "source_text": "其实，说真的正坐10秒就顶不住了。",
      "source_fingerprint": "9079a2151e91970de1c6e78421972a72194ea4db576099b0aa81f74ff4203011",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9136"
      ]
    },
    {
      "uid": "zhcn:57ce5999137038a68ace480a",
      "kind": "text_data",
      "source_text": "其实，滴眼药水的时候\\n嘴也会不自觉张开。",
      "source_fingerprint": "14bdbbcac770279b8db04d9ea2dbe561a38f9e2ce4d201a49ba97cc002744237",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9137"
      ]
    }
  ]
}
