  "entries": [
    {
      "uid": "zhcn:bcf95f4943d367449a5b790b",
      "kind": "text_data",
      "source_text": "小栗帽的午餐",
      "source_fingerprint": "1d36ef0e4e21b63a57b6673dd8d216b8d15c2dbb7cef81ae3af8d540aec0b972",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "6"
      ]
    },
    {
      "uid": "zhcn:944787340d592ec970be90e6",
      "kind": "text_data",
      "source_text": "不是姐姐！",
      "source_fingerprint": "0291f954124a859c0ee88f6503e451d7befdfd3cff4d3a29be46fd65d2dc005b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "60"
      ]
    },
    {
      "uid": "zhcn:daedf68ed03d8916957cd32b",
      "kind": "text_data",
      "source_text": "对王来说没有放弃",
      "source_fingerprint": "781ced7d90b4bda9d411b50e89c50e64563e4db01c3e6a17befdf18dfca7d8ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "61"
      ]
    },
    {
      "uid": "zhcn:496da93fc6f923fc8cdd8245",
      "kind": "text_data",
      "source_text": "那难道是！？",
      "source_fingerprint": "339a877905ca6f0bee9be9e6627e1624528eda5964d0961aef9eb151bcb05847",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "62"
      ]
    },
    {
      "uid": "zhcn:c3833aed2d03ad3992a72f28",
      "kind": "text_data",
      "source_text": "铁壁管理",
      "source_fingerprint": "e556b66ad9cc86b1fa38d0908f00d93b2bc52abdf794467c5879660ff3038bd4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "63"
      ]
    },
    {
      "uid": "zhcn:a56a108d6e1d9d55eaad0871",
      "kind": "text_data",
      "source_text": "当今难题",
      "source_fingerprint": "da7d727f587c02b73fe948cf62c0389f767760c4c6a1d893361d1c398826a8bb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "64"
      ]
    },
    {
      "uid": "zhcn:fb0e6b92a7e6dc52852b8d01",
      "kind": "text_data",
      "source_text": "Vay谚语！",
      "source_fingerprint": "b1133de22dbecec69adf8f98daec16d3e57edd2485c45e73a29cee26d844c4ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "65"
      ]
    },
    {
      "uid": "zhcn:09a79591621016091433ecb1",
      "kind": "text_data",
      "source_text": "一手好字！",
      "source_fingerprint": "006b3a235d448e10826db1df014be9f24c08a959c98cffc7a6c8684594339da5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "66"
      ]
    },
    {
      "uid": "zhcn:ef1818085ba9b9d6d3dd3c7e",
      "kind": "text_data",
      "source_text": "至今仍不可或缺",
      "source_fingerprint": "9dba6549b635990f3e46c5d4e98b0b40e39c4b85d09e3b97b579f07469197bbf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "67"
      ]
    },
    {
      "uid": "zhcn:5bba9c85a2fb92a399214152",
      "kind": "text_data",
      "source_text": "沾染汗水的拳头",
      "source_fingerprint": "a323eb4e81231f820d6dfecabc73413d39cb4a779bf955b94e9e493048ba0a5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "68"
      ]
    },
    {
      "uid": "zhcn:234441c21bdd3d3abc46e033",
      "kind": "text_data",
      "source_text": "千代王流格言",
      "source_fingerprint": "4d92bbf936796f58c5a1f8b27e7b5663308a884e9505647f57d34bd32f484b47",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "69"
      ]
    },
    {
      "uid": "zhcn:4eb563f2b5dd682250fcca0c",
      "kind": "text_data",
      "source_text": "这不是显而易见的吗！",
      "source_fingerprint": "7d0be5755c267c8babdf96a979ba0701fd927fc843f874da5c06083e71c22dac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "7"
      ]
    },
    {
      "uid": "zhcn:aaf7f8c9db0d3ff1b420dc59",
      "kind": "text_data",
      "source_text": "划清「黑白」吧",
      "source_fingerprint": "901b8d1cba40f7075f2874a6ba7ba981323c6f23c94bf0509aba8e81493600d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "70"
      ]
    },
    {
      "uid": "zhcn:37aa49f2d37156bf84672d5b",
      "kind": "text_data",
      "source_text": "高雅至极…",
      "source_fingerprint": "b2073ee6cf2138bc7a2f2bef3c142bc57a3f0374b7e81d8451995fde4198c133",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "71"
      ]
    },
    {
      "uid": "zhcn:38fea3d14ee01c46c1110dab",
      "kind": "text_data",
      "source_text": "生活即锻炼也",
      "source_fingerprint": "a1db76e85f55d8f4b59974a1bdbae957d4fb495e8174a15786791d5a70a19923",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "72"
      ]
    },
    {
      "uid": "zhcn:3ec3073303cbc5ba96e3349a",
      "kind": "text_data",
      "source_text": "像水母一样",
      "source_fingerprint": "16087c3920ef80ddda75e298ce28283b06906b127223760c9f754154481f659e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "73"
      ]
    },
    {
      "uid": "zhcn:11a5fda40ef8b4f381364dfd",
      "kind": "text_data",
      "source_text": "无名英雄",
      "source_fingerprint": "12ad77c41d9249c4a469f11819aeb9cf3a951f69604c2939dd17e1a7c47c25a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "74"
      ]
    },
    {
      "uid": "zhcn:b014073ec3c47e461d9385ab",
      "kind": "text_data",
      "source_text": "爱有无限大",
      "source_fingerprint": "662729c1def4703708318134446604de00c8990418031dec8813905cd995aec8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "75"
      ]
    },
    {
      "uid": "zhcn:0f054587659d4332126483f5",
      "kind": "text_data",
      "source_text": "超乎常理的热情",
      "source_fingerprint": "11c2c48861c353982bb2ce253a66e20f150c39b44dac12aa5e76d75c5957e39b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "76"
      ]
    },
    {
      "uid": "zhcn:ee16a446225b0eddcce6eb1f",
      "kind": "text_data",
      "source_text": "身怀绝技",
      "source_fingerprint": "4708bcec9a4fb54444f8206d2e972d16d279c3e5704ac3f09c0e085ec347593d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "77"
      ]
    },
    {
      "uid": "zhcn:f4d456e49c91167cdb6802be",
      "kind": "text_data",
      "source_text": "确实有过那么一回事",
      "source_fingerprint": "f1a82acf812ffb18e10d026f22a78b2853bf7ffbfcc3232ef57d980d112d1772",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "78"
      ]
    },
    {
      "uid": "zhcn:4e3f286038735c95469d4191",
      "kind": "text_data",
      "source_text": "练起来很有趣",
      "source_fingerprint": "23badb659f265ce2ce7c4f033408900f34c6046da6fce8412db0a3a5a11b0bba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "79"
      ]
    },
    {
      "uid": "zhcn:8a8f4eac3357563d962ff4ab",
      "kind": "text_data",
      "source_text": "想耍帅的年纪",
      "source_fingerprint": "32bc43850c4cf7592628429cf7c41149c6fb18cb57c9c63f0c2c6a70084f2610",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8"
      ]
    },
    {
      "uid": "zhcn:3ab3a4590a971bdb3dbe2e72",
      "kind": "text_data",
      "source_text": "秘密的治愈感",
      "source_fingerprint": "53f02d3713193a8ed57a6b32b2613cd61e0f836be15e5a6c2d19e30faf8a77b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "80"
      ]
    },
    {
      "uid": "zhcn:c8e470a2be5cea9c0a22b7a9",
      "kind": "text_data",
      "source_text": "如果终盘冲刺跑不快的话\\n说不定是速度属性不够哦。",
      "source_fingerprint": "45e0d2a832a4f42a519ac563a3627a1d1790c537fcf8acee7dff44d4dc60365b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8001"
      ]
    },
    {
      "uid": "zhcn:112036ef46664bba878a9908",
      "kind": "text_data",
      "source_text": "如果一到终盘名次容易下滑的话\\n说不定是耐力耗尽了哦。",
      "source_fingerprint": "6ab2280efff7ae4041eb4e4b22da6bf5027aad56f4c2920d1e2b0d37fa75d318",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8002"
      ]
    },
    {
      "uid": "zhcn:5d62d1a581184897af4078e6",
      "kind": "text_data",
      "source_text": "如果感觉很难进入领先集团的话\\n说不定增强力量会更好哦。",
      "source_fingerprint": "953ca17c5fcdd03b42adf08bfa644b6832978ec446c2054053aceb54a4408d92",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8003"
      ]
    },
    {
      "uid": "zhcn:96cbc43254ad5b23ddb1fa2b",
      "kind": "text_data",
      "source_text": "如果认为终盘追赶很难\\n说不定是根性不够的原因。",
      "source_fingerprint": "77b28a9f520b9397c2952ca96efcb3146e2de90dab625fd0ee43ae52f4f4f2dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8004"
      ]
    },
    {
      "uid": "zhcn:5d6fe4dc7a7b64069441de32",
      "kind": "text_data",
      "source_text": "智力越高似乎越能顺利取得有利的位置\\n也会更容易发挥技能。",
      "source_fingerprint": "c0590e0286c90af73bd9569c3b5a9439107d298b326b143b5bcfd89f035bd836",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8005"
      ]
    },
    {
      "uid": "zhcn:6fe388eaae6e1c3226ee2c44",
      "kind": "text_data",
      "source_text": "如果金币和强化道具不够用\\n就去试着参加每日比赛吧。",
      "source_fingerprint": "6c51daeac2b5d70319a69846260b35068e9b10c4fcf571c32a043fd15c1f9321",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8006"
      ]
    },
    {
      "uid": "zhcn:2ae92ad47f054329c9ba41b7",
      "kind": "text_data",
      "source_text": "强化支援卡和赛马娘\\n对比赛胜利十分重要。",
      "source_fingerprint": "0479b8ae6bad866e93ea158242283b173c651a5c2aa1dd6f7ffaa183bcf1f57a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8007"
      ]
    },
    {
      "uid": "zhcn:5341d5e4c3e9194d7d2c1d34",
      "kind": "text_data",
      "source_text": "比赛的胜负除了天气和比赛局势等因素，\\n有时也会被运气所左右……",
      "source_fingerprint": "0dd5fafcc51b9113360608da813d9534a9debfa8b08cc3f8ca0f74b9fed90f85",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8008"
      ]
    },
    {
      "uid": "zhcn:77caa40a647b8434db656c45",
      "kind": "text_data",
      "source_text": "提高支援卡的等级之后\\n可以获得更好的支援效果哦。",
      "source_fingerprint": "2c8259182031402a6558c3874fc5f80b9ae82e4ba147785bb935aa6d2d3d5411",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8009"
      ]
    },
    {
      "uid": "zhcn:e98a615924a912a82c4ed212",
      "kind": "text_data",
      "source_text": "通过上限解锁强化支援卡的话\\n可以得到强力的支援效果哦。",
      "source_fingerprint": "dcbb86b7ceb722b48425bf665e4af6ab6c56a5a84b703fab9ca7aed6b31bc9ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8010"
      ]
    },
    {
      "uid": "zhcn:5871d8308684ec20025141ea",
      "kind": "text_data",
      "source_text": "关于支援效果「干劲效果提升」，\\n请注意也会提升负效果！",
      "source_fingerprint": "80e390335fd414b3fe43171dc84effe3f2b4f76bae62b8dc69c54c1bca4c342f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8011"
      ]
    },
    {
      "uid": "zhcn:9f12af34802a2166f49a57d7",
      "kind": "text_data",
      "source_text": "支援效果「友情加成」，\\n会提高友情训练的效果。",
      "source_fingerprint": "db2efe877f57d658b443d950c2a38e945ed917a6cabfc7dffa664d5831f56cea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8012"
      ]
    },
    {
      "uid": "zhcn:885030c99bb824ad3b600e1e",
      "kind": "text_data",
      "source_text": "支援效果「属性加成」系列\\n会在对应的训练时发挥效果哦。",
      "source_fingerprint": "28b89575dab18ee94a24287d6648ee48644a767f6fc96517c3eb8ddf9bcd297d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8013"
      ]
    },
    {
      "uid": "zhcn:8db5b81062ef3e4920e72549",
      "kind": "text_data",
      "source_text": "支援效果「训练效果提升」\\n不管在哪项训练都会发挥效果哦。",
      "source_fingerprint": "6ed8acd205f4422dce0ebc8f3c7c5ef63cfd28017d74f1e08ef548702cfc051d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8014"
      ]
    },
    {
      "uid": "zhcn:2076c98cf1179dde6cbad503",
      "kind": "text_data",
      "source_text": "支援效果「初始属性提升」系列\\n能以更高的基础能力开始育成哦。",
      "source_fingerprint": "d51e1ae46baded0509779e52aea1cc5caf62c02c776116a2195c4e847fcc96a2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8015"
      ]
    },
    {
      "uid": "zhcn:21044629f7b5d2d5e28a0e70",
      "kind": "text_data",
      "source_text": "支援效果「初始牵绊值提升」\\n推荐在想早点提升牵绊时使用。",
      "source_fingerprint": "70492079bce9c5bf20aa35d3abd8c0a4afc7317ff3f9bbad3673a2bf376fcc1d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8016"
      ]
    },
    {
      "uid": "zhcn:8145352079335a7e0385ef5e",
      "kind": "text_data",
      "source_text": "支援效果「比赛加成」和「粉丝数提升」\\n的范围也包含目标比赛。",
      "source_fingerprint": "501031b4e99aa9d69871596ce5894730d70c9dffc6660c15cff1439ada78c2fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8017"
      ]
    },
    {
      "uid": "zhcn:106bec27393fcc7f22c68a13",
      "kind": "text_data",
      "source_text": "支援效果「比赛加成」\\n推荐在想获得技能点数时使用。",
      "source_fingerprint": "20834732944892455acc89c315b7263bc19acf2155cecdcb5cb6de98f9b3254a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8018"
      ]
    },
    {
      "uid": "zhcn:a9668c7a5fcea83781822353",
      "kind": "text_data",
      "source_text": "支援效果「折扣 Lv提升」，\\n一次提升的折扣 Lv会变高哦。",
      "source_fingerprint": "b4354a407c18fa931035c9f69c6a950daec083dcb8c84eef07be46a73c3822f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8019"
      ]
    },
    {
      "uid": "zhcn:9912b8932a4c7f89d4251253",
      "kind": "text_data",
      "source_text": "支援效果「折扣触发率提升」\\n会让折扣事件更容易触发哦。",
      "source_fingerprint": "952b13656ac24cfd5b9df6ab66a263b1a1bc8440386792fbf567cf23f69e6956",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8020"
      ]
    },
    {
      "uid": "zhcn:9a4e44c3b46e514c4522aac5",
      "kind": "text_data",
      "source_text": "支援效果「得意率提升」，\\n能更容易在擅长的训练登场。",
      "source_fingerprint": "c068d6624ac845dab93cd12aa280343c496990f392c635230640497eee86a26c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8021"
      ]
    },
    {
      "uid": "zhcn:23850bbb5a4373663484e93e",
      "kind": "text_data",
      "source_text": "支援效果「事件回复量提升」\\n能增加事件的体力回复量。",
      "source_fingerprint": "ec2235d1b16a586ac96518875cc44b3616d6171828f2c3b1d8578548eddd9d31",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8022"
      ]
    },
    {
      "uid": "zhcn:da5954811e5c7a41f52a7644",
      "kind": "text_data",
      "source_text": "支援效果「事件效果提升」\\n会让事件中得到的效果上升。",
      "source_fingerprint": "d307d19dc9217739fcfe8ff7a41a5d9cc6bea73d26db0b6eda8ca74bb0d6c5cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8023"
      ]
    },
    {
      "uid": "zhcn:787817524389a456103123a0",
      "kind": "text_data",
      "source_text": "支援效果「失败率降低」，\\n一起训练时会不容易失败。",
      "source_fingerprint": "e2b2ecf9ab9dde04e10b98004031e928ffc6cf2b22508ad0782e1f031b69c2f9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8024"
      ]
    },
    {
      "uid": "zhcn:dcae7ec4e839bf41785e5988",
      "kind": "text_data",
      "source_text": "支援效果「体力消耗降低」，\\n一起训练时会不容易减少体力。",
      "source_fingerprint": "fdc991575a6a5cba2a4eed361f816b2780b98fd76c3dd980de8843b49baf85d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8025"
      ]
    },
    {
      "uid": "zhcn:a9e9a238675a81290b5e3404",
      "kind": "text_data",
      "source_text": "支援效果「智力友情回复量提升」\\n友情训练时会回复更多体力。",
      "source_fingerprint": "88934da42a8b3a6c464a69ea569a7f431df06c43435edb6c57ee2757757b8703",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8026"
      ]
    },
    {
      "uid": "zhcn:f587ce1c84d2f5b98a067d2d",
      "kind": "text_data",
      "source_text": "牵绊值变成橙色时，\\n便有机会发生友情训练。",
      "source_fingerprint": "1b21a49f6b3fb4d1556c9f784fe3be9e41ea4b975d032695f49fc320e948dd50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8027"
      ]
    },
    {
      "uid": "zhcn:1a1169810cab6635138530a5",
      "kind": "text_data",
      "source_text": "如果同时发生多个友情训练\\n效果会变得更好哦。",
      "source_fingerprint": "f039c1f65b5f6ea818cb43e6cea3b8d7b54f2ded48210cc8faca02f4bb637a2c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8028"
      ]
    },
    {
      "uid": "zhcn:b98d628a06a5d80f9111496c",
      "kind": "text_data",
      "source_text": "编组支援卡，会较容易发生\\n以该卡片为主的事件。",
      "source_fingerprint": "8e57973be91d99fba2dd6175dcdefbb1a64fa896ab618da251b629b0f580382c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8029"
      ]
    },
    {
      "uid": "zhcn:96dfcfe67b33223e3b5b98df",
      "kind": "text_data",
      "source_text": "即使是没有编组的支援卡\\n也可能会触发事件哦。",
      "source_fingerprint": "218ccb9a1eb51097f74423e3f9316c02132533b6544cce2ca79b683fabdb5731",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8030"
      ]
    },
    {
      "uid": "zhcn:bc84457df602a61465fab6b8",
      "kind": "text_data",
      "source_text": "和准备育成的赛马娘相同的支援卡\\n是不能编入的，还请注意。",
      "source_fingerprint": "ca4a40269d978321730b4126ccdde070ba8b2fd075099a251b8729efac49f254",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8031"
      ]
    },
    {
      "uid": "zhcn:4b54f81aa9e9d13ab37c2a0d",
      "kind": "text_data",
      "source_text": "把不需要的支援卡转换成蹄铁，\\n可以在商店中兑换物品哦。",
      "source_fingerprint": "51f3a198c43772d523933619d9c65c22ee84438b9799a019f0738c32945f5c3e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8032"
      ]
    },
    {
      "uid": "zhcn:f89b250962d654422b2cb197",
      "kind": "text_data",
      "source_text": "可以在支援卡详情的「育成事件」中\\n确认可能获得的技能提示。",
      "source_fingerprint": "3fc53df1d1d32a483a5d8c0e2f315985f3ec73e124bfdb17370fbd6a20c26838",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8033"
      ]
    },
    {
      "uid": "zhcn:43e2dbc2b42cb1a8f6096a34",
      "kind": "text_data",
      "source_text": "使用强化道具和金币\\n可以提升育成赛马娘的觉醒Lv哦。",
      "source_fingerprint": "719ab511f75f226fce11b96172f44d4865f831c7075b687c7e165e0e8fc6396d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8034"
      ]
    },
    {
      "uid": "zhcn:e69e4ef68eaa05afcf2ce9c3",
      "kind": "text_data",
      "source_text": "如果提升育成赛马娘的觉醒Lv，\\n育成开始时会增加可能获得的技能。",
      "source_fingerprint": "0ae613fde0cae13c45efeb80d7dab24b1b2d6bc8a62f3ba687b6113b22c37d87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8035"
      ]
    },
    {
      "uid": "zhcn:4c057de65463fb2d7a2fee05",
      "kind": "text_data",
      "source_text": "用来提升觉醒Lv的强化道具，\\n可以通过育成的GⅢ以上比赛\\n取得第1名来得到哦。",
      "source_fingerprint": "42c71f4c51d0cb9e678ab1aef2eb4f0999ee87ae08db92cb01137b30e8d39fc9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8036"
      ]
    },
    {
      "uid": "zhcn:201358bd64ee2fac808a4529",
      "kind": "text_data",
      "source_text": "通过搜集相同的赛马娘碎片\\n可以做到才能开花哦。",
      "source_fingerprint": "ea753810b0894ed4026782b4dd66a04e4b255ae79700d44906f279e79e94f989",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8037"
      ]
    },
    {
      "uid": "zhcn:792968470de964f202c87594",
      "kind": "text_data",
      "source_text": "如果赛马娘才能开花，会提升\\n固有技能的Lv和基础能力哦。",
      "source_fingerprint": "19f01312a6bb33493a93f7428f5d141239c4c5c3f3c377ac6c4e54cf68781645",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8038"
      ]
    },
    {
      "uid": "zhcn:645d61aaf0a2c96ba116a16a",
      "kind": "text_data",
      "source_text": "★2以下的育成赛马娘提升到★3以上后\\n可以获得决胜服哦。",
      "source_fingerprint": "35f5eea9737a369cc9dbaf68c22ce8301ba7c7d0044ee071cf4e352e0cd8e618",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8039"
      ]
    },
    {
      "uid": "zhcn:0b26270c4d8bfb7304cd321a",
      "kind": "text_data",
      "source_text": "把不需要的碎片转换成四叶草，\\n可以在商店中兑换物品哦。",
      "source_fingerprint": "c42e2624eeeb12a9dadf215e0cba375e62bc6e59cca45ab2595c4002d28524b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8040"
      ]
    },
    {
      "uid": "zhcn:058c91b1d98869355181facd",
      "kind": "text_data",
      "source_text": "登入殿堂的赛马娘，可以活用于\\n继承、团队竞技场及各种比赛中哦。",
      "source_fingerprint": "299370b838db79fe20cc946e6c9b05ef79e06e1e52652ec8560441cb0c9029b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8041"
      ]
    },
    {
      "uid": "zhcn:520ee2ee193f321a333cbdd2",
      "kind": "text_data",
      "source_text": "登入殿堂的赛马娘，一旦移籍\\n就无法复原了，还请注意。",
      "source_fingerprint": "5aaf94a44b36b0d48fa66d7b1445b443ef920c96f0d51902b5dbc93cab0b0d68",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8042"
      ]
    },
    {
      "uid": "zhcn:af6bbed5c3ca9f2ac74c447c",
      "kind": "text_data",
      "source_text": "育成结束时的评价点会根据\\n属性的总计值和获得的技能来计算。",
      "source_fingerprint": "58a4a31f726637ee6cfa3fced091c97d8d8f0843a393d5f727d34ce8c20d0629",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8043"
      ]
    },
    {
      "uid": "zhcn:6b00ce9bc0039253019aa506",
      "kind": "text_data",
      "source_text": "登入殿堂的赛马娘，根据育成状况\\n有概率获得相应的因子。",
      "source_fingerprint": "a21c00cee2ad0f94e0bf8b88b629a0e4bc4274c3e6e66e19de6c734a71789d63",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8044"
      ]
    },
    {
      "uid": "zhcn:7530e71f31907d005ada481f",
      "kind": "text_data",
      "source_text": "因子有稀有度，\\n★数越多，效果越高。",
      "source_fingerprint": "a1a1b65e149536a6f716f94affe78a901833370fd0f4aa5f1e8139f474526d9a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8045"
      ]
    },
    {
      "uid": "zhcn:ba6a7405e1449529bdf92d00",
      "kind": "text_data",
      "source_text": "育成出的结果越好\\n越可能获得更多因子。",
      "source_fingerprint": "d02eb3f4f21a6c12f8a5051457a9922c22d38a6468e247e914278cddcf840e0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8046"
      ]
    },
    {
      "uid": "zhcn:286c0fa7fb8522a4360cf450",
      "kind": "text_data",
      "source_text": "因子是在育成开始时的继承事件中\\n发挥效果的东西。",
      "source_fingerprint": "0f47567584e181312c8ef60c0c51981a9cb5a463bc617f6a2e95fd21ebfd691c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8047"
      ]
    },
    {
      "uid": "zhcn:27bcd7344b1c9631db01fa3b",
      "kind": "text_data",
      "source_text": "基础能力的因子发动后\\n属性就会提升。",
      "source_fingerprint": "b4c844bb8c10340af0444e0910a7f7df6ffc14a93fd730b503e8638fdd782744",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8048"
      ]
    },
    {
      "uid": "zhcn:7e2812725b0cbb968e890f27",
      "kind": "text_data",
      "source_text": "适性的因子发动后\\n会提升马场、距离、脚质适性。",
      "source_fingerprint": "9902a409d6eedee40f3c47b185e320270ecea1b08f4e54edb684f7d3cf55d5ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8049"
      ]
    },
    {
      "uid": "zhcn:fb731613d3f7fe8c62596582",
      "kind": "text_data",
      "source_text": "技能的因子发动后\\n技能的折扣 Lv会提升。",
      "source_fingerprint": "709dd149ea6757d2a15f83dcbbf7194cc11b8d34b1a3016282b8601d45debd1e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8050"
      ]
    },
    {
      "uid": "zhcn:17fb2a641732266374e7553f",
      "kind": "text_data",
      "source_text": "比赛的因子发动后会\\n提升属性或技能的折扣 Lv。",
      "source_fingerprint": "950e8e247b9add2976abd37478abcccd076c2c729d6f28a843126bf394e720b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8051"
      ]
    },
    {
      "uid": "zhcn:be1fa080e2bcae966b30e583",
      "kind": "text_data",
      "source_text": "发动了已经获得的因子的继承效果的话\\n会令状态上升。",
      "source_fingerprint": "df1dad931cf4da95a860407e93cc3b07019e8ff013a59ae25bd3cf868230c2b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8052"
      ]
    },
    {
      "uid": "zhcn:00873827f1ff204f7b2221cb",
      "kind": "text_data",
      "source_text": "把赛马娘在育成中用于继承，因为不会消失\\n所以请多加活用吧。",
      "source_fingerprint": "25895fc97fb6b770bdbfb5153a44930c46a7a967a8328e5e8ae5d792e328e9bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8053"
      ]
    },
    {
      "uid": "zhcn:df60ce2284b3f6013694be2a",
      "kind": "text_data",
      "source_text": "继承赛马娘可以通过支付金币\\n从好友处租借哦。",
      "source_fingerprint": "714e9434096ef3b300b66071648afbd1b5fc24f6c8145bf3defaa528d1c003ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8054"
      ]
    },
    {
      "uid": "zhcn:d4468b41871afc1ff87b0962",
      "kind": "text_data",
      "source_text": "继承赛马娘的相性从好到坏\\n以◎＞○＞△的顺序显示。",
      "source_fingerprint": "aa8d7f6d8519a15851039b9375485fb08b0c0652af5b8576239d3485dd91b10a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8055"
      ]
    },
    {
      "uid": "zhcn:0f66131965645993a2b81ab2",
      "kind": "text_data",
      "source_text": "同年级、同寝室、目白家的关联性\\n等因素会影响相性的好坏……",
      "source_fingerprint": "a0b788454d8df01d731ec4de1ed0748da7190bbc9f2cd34162ab701c0954c911",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8056"
      ]
    }
  ]
}
