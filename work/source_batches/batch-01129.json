{
  "schema_version": 1,
  "batch": 1129,
  "batch_count": 1662,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "c0513553da490a692523f45b5f779f99f6cb7e34",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:64ecce5866ca10a50915e07d",
      "kind": "text_data",
      "source_text": "通过从社团成员那里租借继承赛马娘\\n消耗的金币会有所折扣哦。",
      "source_fingerprint": "725ce929fde9d03501d44c29dae6a05056ac91082fd1a76be99177f026b36576",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8057"
      ]
    },
    {
      "uid": "zhcn:86d355ba0e28fb5dad54c434",
      "kind": "text_data",
      "source_text": "偶尔也参考看看好友的\\n「代表赛马娘」育成信息吧。",
      "source_fingerprint": "c584ec1a48e165dfef579f79661c97e6832c23153330ed2976d13ceb05afe84c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8058"
      ]
    },
    {
      "uid": "zhcn:458c860a786aae708e6c544f",
      "kind": "text_data",
      "source_text": "如果进入掛かり（焦躁）状态会加快失去持久力。\\n提升智力的话会更不容易触发哦。",
      "source_fingerprint": "14b3e530c3b592ec3746079108710deb942ea56e11c7c2a88fb4429c2b454c2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8059"
      ]
    },
    {
      "uid": "zhcn:69735c384b9c19d618d2e303",
      "kind": "text_data",
      "source_text": "只要变得擅长争抢赛道，就能较容易\\n躲避前方阻挡的赛马娘而前进。",
      "source_fingerprint": "9e18e5cef9a4537a35ef073878cba42c7a229afe320335c0b9c4005ba233805a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8060"
      ]
    },
    {
      "uid": "zhcn:c513a99dee9e848153ef5a88",
      "kind": "text_data",
      "source_text": "短距离比赛中\\n速度很重要。",
      "source_fingerprint": "d88a3a14d7d7bf7c644f78a188a7d5359a84fba207898d5e53704d084450cc03",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8061"
      ]
    },
    {
      "uid": "zhcn:f1745d6d384586f12d47bfe7",
      "kind": "text_data",
      "source_text": "英里比赛中\\n兼具速度与力量很重要。",
      "source_fingerprint": "83da777e6fd3b9f43951482fe3c222f9a52d0a5ef8661b907d77b2c7eb0c749c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8062"
      ]
    },
    {
      "uid": "zhcn:b681932a92346cd8a2c2ee4e",
      "kind": "text_data",
      "source_text": "中距离比赛中\\n平衡良好的基础能力很重要。",
      "source_fingerprint": "4cc763d84304f8cd5552b7514a06fb1cfbfb182a5b8790c1a4e024246b96f624",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8063"
      ]
    },
    {
      "uid": "zhcn:b97be38679d39334afafde60",
      "kind": "text_data",
      "source_text": "长距离比赛中\\n充足的耐力和根性很重要。",
      "source_fingerprint": "b02ca6e6b561a516f336bcdc7214db3b7b7baed0986c66461499ee2116ad32ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8064"
      ]
    },
    {
      "uid": "zhcn:04a19b63f6d509a2d90a12ff",
      "kind": "text_data",
      "source_text": "马会给出的印记根据◎＞○＞▲＞△的顺序\\n表示受到评价的高低。",
      "source_fingerprint": "601029bb280506c7e7a46ae1b006dff99ce4d23808072624a6945b230987cb6d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8065"
      ]
    },
    {
      "uid": "zhcn:627b7d4447c24d66df7c9d8f",
      "kind": "text_data",
      "source_text": "出门的话，会提升干劲\\n也能回复体力哦。",
      "source_fingerprint": "6a74c93f86b418253d0ac073d56f5126e4c6dee9d407b2b16c3de163c8a0c168",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8066"
      ]
    },
    {
      "uid": "zhcn:a0c57c99dd18295ff8d25d91",
      "kind": "text_data",
      "source_text": "出门去神社的话\\n也许可以消除负面状态？",
      "source_fingerprint": "46425394ee5b1e4780b7ecd18974be2677d506f6d85c8b359e7fe1f621410543",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8067"
      ]
    },
    {
      "uid": "zhcn:462f4608a683ea8f08118f10",
      "kind": "text_data",
      "source_text": "加深乙名史记者的牵绊\\n在URA总决赛中会……？",
      "source_fingerprint": "057ea87a96551570df8b03e241d61737ae2bea0f1cef083e6c2f307416a0f683",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8068"
      ]
    },
    {
      "uid": "zhcn:406088563ec61edabd7a47e0",
      "kind": "text_data",
      "source_text": "继承赛马娘的相性好的话\\n也许更容易得到心意的继承……",
      "source_fingerprint": "3a2eef81e0ba08a03504d30a0e75d1402d4243f8bafd3996ce1fd1e2ea74264d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8069"
      ]
    },
    {
      "uid": "zhcn:9f02880866f663087c1db155",
      "kind": "text_data",
      "source_text": "支援卡的事件中，\\n能够让稀有技能的折扣 Lv提升！？",
      "source_fingerprint": "919e8f0c8ae56b9bc7d807dc719efd2a6f80134021c412e0b4764195e28d1def",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8070"
      ]
    },
    {
      "uid": "zhcn:1d36161e5fada8b7c2490e1c",
      "kind": "text_data",
      "source_text": "「主页（ホーム）」的学园公告板上\\n刊登了赛马娘相关的信息。",
      "source_fingerprint": "5f5ff6eb50703a2cab1a9193f7c405c7420c789098987ef8958c60ac571db574",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8071"
      ]
    },
    {
      "uid": "zhcn:d69293b48b12ef2491aa8a74",
      "kind": "text_data",
      "source_text": "短距离是1400m以下的比赛，\\n英里是1401m～1800m为止的比赛。",
      "source_fingerprint": "26603e8afc70e638c2673cf623cd78af9e90c402a998432dc6782d3741a0c29b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8072"
      ]
    },
    {
      "uid": "zhcn:99aa3c6a1d25f65c2f114724",
      "kind": "text_data",
      "source_text": "中距离是1801m～2400m为止的比赛，\\n长距离是2401m以上的比赛。",
      "source_fingerprint": "98ee87db1d396b2716af293c659c2763687820a899d8ef6f78be162217099f12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8073"
      ]
    },
    {
      "uid": "zhcn:ff9993d88b28d07ca5bb17f6",
      "kind": "text_data",
      "source_text": "马场状态会因为雨雪因素按良、稍重、重、不良\\n的顺序恶化，奔跑会变得困难。",
      "source_fingerprint": "270884a68e93870f411a6fd04014bb904439050d06e55438dc8ea798393086a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8074"
      ]
    },
    {
      "uid": "zhcn:fbd0b2b0c47afaac782ce097",
      "kind": "text_data",
      "source_text": "比赛的级别会依GⅠ＞GⅡ＞GⅢ＞OP＞Pre-OP\\n的顺序提高。",
      "source_fingerprint": "8b9f6197c3f1aa1c918efd18f23fbf9646bd9bad6b9faee0d7cd4d862c588157",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8075"
      ]
    },
    {
      "uid": "zhcn:d3e72d04d4c06c34c17b3511",
      "kind": "text_data",
      "source_text": "级别越高的比赛，\\n强力赛马娘越容易聚集。",
      "source_fingerprint": "383f56bee1067838abe0c98e1118ba4708c8c99a4d3cdb1fc376449c99fe7cfe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8076"
      ]
    },
    {
      "uid": "zhcn:03bf3eaf7c2832bf49d13393",
      "kind": "text_data",
      "source_text": "GⅢ、GⅡ、GⅠ被称为重赏，\\n其中GⅠ是级别最高的比赛。",
      "source_fingerprint": "6d5c9306d3db0fbe75242d7948fe23c4a201bee94836b3861914882147c3f482",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8077"
      ]
    },
    {
      "uid": "zhcn:8ca111ffede151224c1d5886",
      "kind": "text_data",
      "source_text": "育成赛马娘的固有技能因子\\n在★3以上就能获得了。",
      "source_fingerprint": "66628a8f456a8cb88dd2d584b2f881503ad34efff5548cddf6f366c47d378328",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8078"
      ]
    },
    {
      "uid": "zhcn:631cc15df0b085e8348788db",
      "kind": "text_data",
      "source_text": "URA总决赛的赛道是以育成中\\n出走最多的赛道为参考选择的。",
      "source_fingerprint": "06f693f7de75c60358c4e4736c953e373fc81cb969dfe878cd53f45297bc5541",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8079"
      ]
    },
    {
      "uid": "zhcn:0aee524808011c95cc4fb49b",
      "kind": "text_data",
      "source_text": "春古马三冠是取得大阪杯、天皇赏（春）、\\n宝冢纪念这三项比赛优胜的总称。",
      "source_fingerprint": "fdf62179f7e4c0f8e0702c06448c23f46082f1d716f5b6a43b4a506330fc4d88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8080"
      ]
    },
    {
      "uid": "zhcn:e76c5b90c80ab3d07ff66d52",
      "kind": "text_data",
      "source_text": "三后冠是取得樱花赏、オークス（日本橡树大赛）、\\n秋华赏这三项比赛优胜的总称。",
      "source_fingerprint": "484e32de9fbfe2479dc742c72d2d33830a9ad0eeef85cb17695c3a69a5dad693",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8081"
      ]
    },
    {
      "uid": "zhcn:09fbea60c262f18e578cad97",
      "kind": "text_data",
      "source_text": "秋古马三冠是取得天皇赏（秋）、\\nジャパンC（日本杯）、有马纪念这三项比赛优胜的总称。",
      "source_fingerprint": "101528665a0e071f471192e3565f73b958b9431e7406155a7d79b496a77e375c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8082"
      ]
    },
    {
      "uid": "zhcn:79e369254b53d233bde61cf2",
      "kind": "text_data",
      "source_text": "经典三冠是取得皋月赏、日本ダービー（日本德比）、\\n菊花赏这三项比赛优胜的总称。",
      "source_fingerprint": "3faf513e6a385aa10c1078345505f4a3f32a2f35d2578063b9fe9bba9b3dce57",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8083"
      ]
    },
    {
      "uid": "zhcn:e1845a5895463bf22899f25c",
      "kind": "text_data",
      "source_text": "如果不想跳过未读事件，\\n可以去选项中设置。",
      "source_fingerprint": "09435c2c00c3f61e6f31c6dd5361f41e17909a5806fedbe7b1a1ae9dec259b0f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8084"
      ]
    },
    {
      "uid": "zhcn:276b122c7f3653ae3445dc59",
      "kind": "text_data",
      "source_text": "没有解锁的育成赛马娘，通过使用碎片\\n也可以将其进行育成。",
      "source_fingerprint": "907459619ab5e2aadfee79746282cdf788a8210c41e58930d62d394e73eeed97",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8085"
      ]
    },
    {
      "uid": "zhcn:9c06cf1bfcecd1b0a4238869",
      "kind": "text_data",
      "source_text": "成长率可以令训练时\\n基础能力提升的数值增加。",
      "source_fingerprint": "eb11299c4b2fa9a537cddfd2bc68be19485a7e308bf70c82417cc1b1cd03c1f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8086"
      ]
    },
    {
      "uid": "zhcn:a58d902dc5356110e9b5e4a4",
      "kind": "text_data",
      "source_text": "随着折扣 Lv的提升\\n获得技能需要的技能点数会降低。",
      "source_fingerprint": "754b4cf3b5af8b623848c8a83aca52f41b952d01e051c298b257782862e6865b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8087"
      ]
    },
    {
      "uid": "zhcn:79cda59e6622f685c27634bc",
      "kind": "text_data",
      "source_text": "在团队竞技场和房间竞赛等\\n可以确认其他赛马娘发动的技能。\\n也可以在设置中将其隐藏哦。",
      "source_fingerprint": "c2c196538e0a99690722ad7c4a1f3350ceddd08b0c4f82ffb0c39f2dc444ca60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "8088"
      ]
    },
    {
      "uid": "zhcn:440af015cd3ca743946ff3b4",
      "kind": "text_data",
      "source_text": "我自己搬",
      "source_fingerprint": "b80b30697b54a54b78f3c99a2594ca01dd22c203a3ec757a250e8d4fca1d2fcb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "81"
      ]
    },
    {
      "uid": "zhcn:33309c9bbfc409097c1164dd",
      "kind": "text_data",
      "source_text": "体面◎",
      "source_fingerprint": "a004e8b5987eefe399b39abcca92ff580cc7341c98786fcdc10f859600630e9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "82"
      ]
    },
    {
      "uid": "zhcn:be8126b5c87e6aaf658c65b9",
      "kind": "text_data",
      "source_text": "父亲经营的哦",
      "source_fingerprint": "27ec04066a423bb966b265d12a37e0b677080a4f700ceab583449c376f3e2ffe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "83"
      ]
    },
    {
      "uid": "zhcn:06c0c11929a284596c10748c",
      "kind": "text_data",
      "source_text": "按自己女儿的标准送礼",
      "source_fingerprint": "f1394400c24cefe58b3256eb1c612f7713ec262b0ad1c0b526242cf0190ac1d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "84"
      ]
    },
    {
      "uid": "zhcn:dc77bfdfade7985235114196",
      "kind": "text_data",
      "source_text": "奔跑如同呼吸一般平常",
      "source_fingerprint": "bb6a88461f0d9c0f1be35fc9e725be94b98b1229bdf230c7ca0ca2784ee6e3f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "85"
      ]
    },
    {
      "uid": "zhcn:7ab9b4ebc7d50667d52a8d56",
      "kind": "text_data",
      "source_text": "特技：奏效红茶",
      "source_fingerprint": "2fabe20d772ca0d774d9a19546a2ddff1cdd37a0d8898e4dd3e4daf50c1730cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "86"
      ]
    },
    {
      "uid": "zhcn:0bf19b93b02e0dffc7d3c790",
      "kind": "text_data",
      "source_text": "特雷森人情小曲",
      "source_fingerprint": "a6147bce2bcf80646ab6a5819bf1ce63fdc7020ad6fd697546a0f3fdfa36777e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "87"
      ]
    },
    {
      "uid": "zhcn:0517dd3b95dd89cce99164e8",
      "kind": "text_data",
      "source_text": "我也经历过……吗？",
      "source_fingerprint": "a07527411004c3b170106cfe35fbcdd2f7d930c50be7e9a5bcf6c3406e029014",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "88"
      ]
    },
    {
      "uid": "zhcn:c9c6ec96f261373e14d4b272",
      "kind": "text_data",
      "source_text": "栗东电影鉴赏会",
      "source_fingerprint": "b1f14d795a93f6163199eb4d4545bd5b90fc5d7182a023bdd9a2e7880ae87665",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "89"
      ]
    },
    {
      "uid": "zhcn:9f77cfc9aedc765bf673b4e4",
      "kind": "text_data",
      "source_text": "秘密的记事本",
      "source_fingerprint": "3317aa8e9728fa2b18cef204fc001a236091e4ac041c6de3160c715f5179f85a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9"
      ]
    },
    {
      "uid": "zhcn:c8c708e808d4f97ebb5bd8b5",
      "kind": "text_data",
      "source_text": "父亲大人给我的",
      "source_fingerprint": "c58bd3220b798e290deaeb872e10a3c0704c1908df94178a58e7b31109aa75bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "90"
      ]
    },
    {
      "uid": "zhcn:2bfa282ed3ce4acba9faa654",
      "kind": "text_data",
      "source_text": "其实，可以分辨各种牌子牛奶的味道。",
      "source_fingerprint": "3d1dc735328d476f2f5e67b70f4c76f65d04da028d56287e999346cb50b47114",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9000"
      ]
    },
    {
      "uid": "zhcn:de0b025a1232eea592c4d006",
      "kind": "text_data",
      "source_text": "其实，擅长转笔。",
      "source_fingerprint": "176f2fef4f1abb4bb144ed17b494930776b5667392bb865b3257949494fc4c2c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9001"
      ]
    },
    {
      "uid": "zhcn:82dee84ded37925cb236a615",
      "kind": "text_data",
      "source_text": "其实，是历代的最高前屈纪录保持者。",
      "source_fingerprint": "5cb5ee48a05a943ff43eb907b3d899b2c6af083901cf56c7facc0c9477521790",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9002"
      ]
    },
    {
      "uid": "zhcn:e139ba6ced4c76b56f83350d",
      "kind": "text_data",
      "source_text": "其实，坐在副驾驶座会很容易晕车。",
      "source_fingerprint": "c3e45b514c8d36f2d867cff4c794789905b40eb01dc9d7a9971c563b333f9c1d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9003"
      ]
    },
    {
      "uid": "zhcn:4116fdce972270a92ff3ab33",
      "kind": "text_data",
      "source_text": "其实，可以从什么都没有的地方拿出礼帽\\n从礼帽里拿出鸽子。",
      "source_fingerprint": "2a626fbc4989af103a410b387867fbaf9cf6e436c1f503e408b2ab05b98f1cd2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9004"
      ]
    },
    {
      "uid": "zhcn:1a82bf53187ae675cdbea15d",
      "kind": "text_data",
      "source_text": "其实，很擅长把指甲修剪得漂漂亮亮。",
      "source_fingerprint": "54650fc8b5b6990deba25ba979b40f0c09b35e1f51704c8b10b5312dcc824517",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9005"
      ]
    },
    {
      "uid": "zhcn:f0b81e5b112eee7affcb511d",
      "kind": "text_data",
      "source_text": "其实，在杂学猜谜这方面非常强。",
      "source_fingerprint": "150617952b7be23aa31f50b891823b43234ae76165a54fbf6172dd8d3686eb29",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9006"
      ]
    },
    {
      "uid": "zhcn:ed644678a29b14fe84952655",
      "kind": "text_data",
      "source_text": "其实，正在练习在吧台上滑酒杯。",
      "source_fingerprint": "de68c86e68ecb280bf892f859b0ac649b7b3424a11f2657bd0827f25951a39a0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9007"
      ]
    },
    {
      "uid": "zhcn:1a30cc9bb7f2b25e143afa91",
      "kind": "text_data",
      "source_text": "其实，能不使用尺子就画出直线。",
      "source_fingerprint": "e2dcfabcb96ae71c603a66b434eb5804ae1803478b5c401b6c0cbcb79a9f28cb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9008"
      ]
    },
    {
      "uid": "zhcn:df3d78ff80f356a5fa2d8036",
      "kind": "text_data",
      "source_text": "其实，在快速拔枪大会上\\n拿到过冠军。",
      "source_fingerprint": "a25527d0e9759807b64964691a9d110f165e11bab203264db5ca498be544d1fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9009"
      ]
    },
    {
      "uid": "zhcn:9a137139420cc2c124f37815",
      "kind": "text_data",
      "source_text": "其实，对裙子长度\\n有秘密的讲究。",
      "source_fingerprint": "4698323919e28d93b1e66364e5b99db86228265969486680f6dcc7ae39194178",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9010"
      ]
    },
    {
      "uid": "zhcn:f1a6ba48b9b5ab1188364892",
      "kind": "text_data",
      "source_text": "其实，对衬布有独特的审美。",
      "source_fingerprint": "a954970b31dc7e5411da15bb5e4eef47dc6e832d6b3405262035d4e7a5d61c99",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9011"
      ]
    },
    {
      "uid": "zhcn:f0c66c23e930b14707c91e1f",
      "kind": "text_data",
      "source_text": "其实，有时候自己会喊着『飞吧ー！』\\n这样的梦话然后起床。",
      "source_fingerprint": "c5918c2917e85206eaa65d6c2343fd0397ca53992d0944daa0b5ab36a0994988",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9012"
      ]
    },
    {
      "uid": "zhcn:eb300998eda929227229ac4c",
      "kind": "text_data",
      "source_text": "其实，有面具专用的柔顺剂。",
      "source_fingerprint": "46c9a885d5a181108aa9496683aaf20d988fcfa164ffcdb3e1e4395547cadc49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9013"
      ]
    },
    {
      "uid": "zhcn:9797babb48056b7025a05f28",
      "kind": "text_data",
      "source_text": "其实，仅有一次大幅度更改过\\n耳饰的设计。",
      "source_fingerprint": "d9ffd32f905c2391b62a9b6ccebabc5747ee9fd72a11b174ec649eda4b946bbc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9014"
      ]
    },
    {
      "uid": "zhcn:e5d38e02981883ff3741ebb6",
      "kind": "text_data",
      "source_text": "其实，只要见过一次脸\\n就不会忘记对方的样子。",
      "source_fingerprint": "f7340555610dbe567118e87322a9444218933a9b0ea187399eba2860ee157318",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9015"
      ]
    },
    {
      "uid": "zhcn:7d3349c184af8dc923ff0bc1",
      "kind": "text_data",
      "source_text": "其实，虽然讨厌虫子\\n但是喜欢瓢虫。",
      "source_fingerprint": "fffcc99fae60f1469565c4bc50a8bb7b0cc3233d21750239410129215a8ccbea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9016"
      ]
    },
    {
      "uid": "zhcn:d57834cece0f61e486f7ee99",
      "kind": "text_data",
      "source_text": "其实，舌头怕烫到令人吃惊的程度。",
      "source_fingerprint": "1f29abe764ca0a66a51d413e36c647c815f905280f0b66a3427a052b8077d7b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9017"
      ]
    },
    {
      "uid": "zhcn:174b331465efd515887bcfe8",
      "kind": "text_data",
      "source_text": "其实，不管收到什么样的纸\\n都能折成飞得很好的纸飞机。",
      "source_fingerprint": "d2ff2ab66ea06dd87052cb778d4a183b89d0ade13ca57ceeeb3b754298ae8c3a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9018"
      ]
    },
    {
      "uid": "zhcn:b8126aeadc5a3ebbe4ccf5d4",
      "kind": "text_data",
      "source_text": "其实，花了很长时间挑选\\n擦汗用的手帕。",
      "source_fingerprint": "8565e78abc8ce2cd96bb5fcac954091b3b3c5e965487a6e1ed524a66e186853a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9019"
      ]
    },
    {
      "uid": "zhcn:01432bf0b4e9526e787db55e",
      "kind": "text_data",
      "source_text": "其实，仅在早餐时会吃面包。",
      "source_fingerprint": "e48802037e057043917ed1762ea59ca7737befa05b3fc4c9eeaa4bfe5623104f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9020"
      ]
    },
    {
      "uid": "zhcn:cbe51ad8fbaeaa6b02c275bf",
      "kind": "text_data",
      "source_text": "其实，会经常收到\\n从国外寄来的包裹。",
      "source_fingerprint": "d8b235f38b708561a46589999db4e00ea9732c01edc8497193fbdb89826b4337",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9021"
      ]
    },
    {
      "uid": "zhcn:ca13c02b9d7e94357288de03",
      "kind": "text_data",
      "source_text": "其实，非常讲究内衣的选择。",
      "source_fingerprint": "f84517a3847576b39ed6774a864df3bd310a24e4aab09c58769b58afb654d363",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9022"
      ]
    },
    {
      "uid": "zhcn:7f4fa95d07615e257eb19297",
      "kind": "text_data",
      "source_text": "其实，把闹钟设置成每隔2分钟响一次。",
      "source_fingerprint": "02654bed343b5c9803c68cbb427dbd3d0f366577c6565a6eea7da60d170254dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9023"
      ]
    },
    {
      "uid": "zhcn:b51f2e54e1c375ca135357c7",
      "kind": "text_data",
      "source_text": "其实，把将棋的『香車』棋子当做护身符。",
      "source_fingerprint": "583989acc5c18a925290d63a5456de5193a1bb2d5eb9b3b2608d04b27f66ea3e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9024"
      ]
    },
    {
      "uid": "zhcn:3a69b06eb97bc370b1b0df25",
      "kind": "text_data",
      "source_text": "其实，擅长做年糕团。",
      "source_fingerprint": "602728c7cc0a0bf083b7cb298c3f1e568ababfbc0b85f3398b71a57de0c08f5a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9025"
      ]
    },
    {
      "uid": "zhcn:e66c29ee65713df0194eff79",
      "kind": "text_data",
      "source_text": "其实，不太会念『气氛』这个词。",
      "source_fingerprint": "828830aa767b564144a5976831e18e98be71e1d5288e54f68df23b44d9939d02",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9026"
      ]
    },
    {
      "uid": "zhcn:99fc35730f027150abc1b42e",
      "kind": "text_data",
      "source_text": "其实，拥有书法段位。",
      "source_fingerprint": "b9aeea403c3b691e36ff9639358b249d43ae7430c398eb3bd566f99e81048dcb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9027"
      ]
    },
    {
      "uid": "zhcn:f6e4e6ec32f329e4805ac1cc",
      "kind": "text_data",
      "source_text": "其实，是整理冰箱剩余杂物的高手。",
      "source_fingerprint": "7a300bbacc6b4e7b8cb579ad8abeb7ab5a04e37ebe1728811fa00a3a99a91eb2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9028"
      ]
    },
    {
      "uid": "zhcn:5e1a7174d563be5e004907e1",
      "kind": "text_data",
      "source_text": "其实，曾有过在中彩之前一直抽，\\n最后把钱包抽空的经历。",
      "source_fingerprint": "f52d4a201346aa7cf8845c29bb0dddb8f63c6f579e6a28cc7da55823afb993bc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9029"
      ]
    },
    {
      "uid": "zhcn:3c58ad06ce81d99c57ed742e",
      "kind": "text_data",
      "source_text": "其实，跑在队尾时\\n想拿着标语牌。",
      "source_fingerprint": "b2ad3488db2699e350c1e2aa79350e503b3dccc89948229d18e475aec9535c22",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9030"
      ]
    },
    {
      "uid": "zhcn:039e72dd99be42820a865560",
      "kind": "text_data",
      "source_text": "其实，有很多以豆芽\\n和鱼肉饼为主的拿手菜。",
      "source_fingerprint": "6aff682832d350b1c643c60c087c354681cbd69a67e9914d73d4a6f685aee234",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9031"
      ]
    },
    {
      "uid": "zhcn:15215d7621322c709164d95d",
      "kind": "text_data",
      "source_text": "其实，非常擅长颠球。",
      "source_fingerprint": "4bf20719abbc34ef0434ea3c2c68cc3f5525c6e97b65b3002b17ca240522f6cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9032"
      ]
    },
    {
      "uid": "zhcn:39d15a6494c1ca97758536be",
      "kind": "text_data",
      "source_text": "其实，是喷发剂的评论家。",
      "source_fingerprint": "fa50acf77db6856bd4b290f4ccc8595dd5579eb9c830e9d161a77512501add2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9033"
      ]
    },
    {
      "uid": "zhcn:62dd34cfb2807f9656d8f16f",
      "kind": "text_data",
      "source_text": "其实，喜欢登山。",
      "source_fingerprint": "677a634322eb2695182089ac9902cb6e1e35eba62a24d4fbe8d065001b2ee314",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9034"
      ]
    },
    {
      "uid": "zhcn:374f7b7889c9482f591c2414",
      "kind": "text_data",
      "source_text": "其实，因为父亲的玩笑话\\n一直以为打雷时就会被偷走尾巴。",
      "source_fingerprint": "a2b01bfc1908c8844c0fe10ed2f83dbec12b47011b621471d614eae13467cf40",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9035"
      ]
    },
    {
      "uid": "zhcn:5b248742ac9126caea8ce807",
      "kind": "text_data",
      "source_text": "其实，编发的手法像\\n专业发型师一样。",
      "source_fingerprint": "0dfc6950c85894c374ab5387d5d19da42fadfa705b42bc2baaf8219aef1fb44b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9036"
      ]
    }
  ]
}
