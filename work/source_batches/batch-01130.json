{
  "schema_version": 1,
  "batch": 1130,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:dc5dae373706d7574090815c",
      "kind": "text_data",
      "source_text": "其实，用喷过古龙水的信笺寄信。",
      "source_fingerprint": "ee31721ee0a3adfd99b6f24c6875593238abdc07a24369d1c48b82f041f1963e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9217"
      ]
    },
    {
      "uid": "zhcn:55bad5dfe1b0f0513ae9cec7",
      "kind": "text_data",
      "source_text": "其实，不爱吃干巴巴的东西。",
      "source_fingerprint": "1bc27f6996edc1ee6017992a3710a2d8a93c356b9a884c26cbefd880f8a8f304",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9218"
      ]
    },
    {
      "uid": "zhcn:189c94adf2777fc5440bdbb5",
      "kind": "text_data",
      "source_text": "其实，在想个子比姐姐们高的时候\\n该怎么撒娇。",
      "source_fingerprint": "dd85b1091964cd47d2b6d734d6512e855313bcaa340230e96cfa28742e67b37a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9219"
      ]
    },
    {
      "uid": "zhcn:060c2d80efe096f51ca6493f",
      "kind": "text_data",
      "source_text": "其实，即使戴着墨镜，\\n也容易在运动中把它弄丢。",
      "source_fingerprint": "fcb52865fb0ad2eba792a9e933a50ee36f5cfb24dc32f506a22355fb57fe1501",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9220"
      ]
    },
    {
      "uid": "zhcn:632f95da1103533f4225d8e2",
      "kind": "text_data",
      "source_text": "其实，是证书收集大师。",
      "source_fingerprint": "93036301d4d118038bf79d05959d025b6f7306c65e31afec1b75b4204ff590fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9221"
      ]
    },
    {
      "uid": "zhcn:d20c9412948321b2c48a1250",
      "kind": "text_data",
      "source_text": "其实，在遇到『姐姐』之前，\\n非常不会撒娇。",
      "source_fingerprint": "d14c826d647f8e9aa73ab58bc83c4bd9f147681d4d474743980da713ec7a3e53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9222"
      ]
    },
    {
      "uid": "zhcn:d9834d1f89f2880742c5262a",
      "kind": "text_data",
      "source_text": "其实，湿气重的日子，\\n睡醒会收获乱糟糟的头发。",
      "source_fingerprint": "89b7257dd7b07b737d8a63437510a1e15bd4b8ceec55901a8d3e6316d1fbf357",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9223"
      ]
    },
    {
      "uid": "zhcn:4894b384f38f7cde83d86cf6",
      "kind": "text_data",
      "source_text": "其实，老家有一个收集人物卡片\\n用的储藏室。",
      "source_fingerprint": "e7495b089473b8f8218de23a54076ba11f5b8303879d3eeedcffa07c1d1adf6e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9224"
      ]
    },
    {
      "uid": "zhcn:4e2ab951a776ccff019e528b",
      "kind": "text_data",
      "source_text": "其实，喝蛤蜊汤决不允许\\n自己剩下蛤蜊肉。",
      "source_fingerprint": "9059ec1fa056e1edce949193d0ea83494dd8a736162c22c8a1b37cd843fd35c5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9225"
      ]
    },
    {
      "uid": "zhcn:a361fca0f9b97b30161eef0d",
      "kind": "text_data",
      "source_text": "其实，玩弹珠对战非常强。",
      "source_fingerprint": "14037a6e9a0b620886f30a5b034c881cc52e5035570303045a5e75808b0174d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9226"
      ]
    },
    {
      "uid": "zhcn:2542494a42b391096587941d",
      "kind": "text_data",
      "source_text": "其实，收集小瓷人是她的小众爱好。",
      "source_fingerprint": "a42155224d6e4c81b04be2ae2c335da84e4cb56dece3930d88c4641f7fb417e8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9227"
      ]
    },
    {
      "uid": "zhcn:2fdaa198daa781ce251add84",
      "kind": "text_data",
      "source_text": "其实，如果披萨加了菠萝……也行，能吃。",
      "source_fingerprint": "d67f9de201098ce4c6bff2827e8a06ff443aa97fae4adb33ce3dfdd5736804f4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9228"
      ]
    },
    {
      "uid": "zhcn:1c14b60d53307b3eaee626bc",
      "kind": "text_data",
      "source_text": "其实，是爬宠咖啡馆的常客。",
      "source_fingerprint": "f130c405b932849bbd1ba010e4d705efe81ae9caad15eb18a5d94686010731d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9229"
      ]
    },
    {
      "uid": "zhcn:f8a431ab81ce34d8203aaa93",
      "kind": "text_data",
      "source_text": "其实，只要啃一口胡萝卜，\\n就能明白是不是船桥产的。",
      "source_fingerprint": "1f7bd4aae11c42e7f73065c8384aa659ce2e75970335fbb53fc191c0444a4932",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9230"
      ]
    },
    {
      "uid": "zhcn:fd7aad3d9cf93d46fdfa2f56",
      "kind": "text_data",
      "source_text": "其实，是栗东宿舍做鬼脸大赛的冠军。",
      "source_fingerprint": "fd38a06de0f4a3ee1eabc2bbd192e457d37845e9c79635351b9aa2e03364b9ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9231"
      ]
    },
    {
      "uid": "zhcn:62ab661cceedbde396e2b3ef",
      "kind": "text_data",
      "source_text": "其实，不爱吃跳跳糖。",
      "source_fingerprint": "2de02a0ceaf136f6b71844ab4119068c5b9085ae66cc749c7502ab8bb55c6ee3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9232"
      ]
    },
    {
      "uid": "zhcn:76f321f8c0524e378ab39876",
      "kind": "text_data",
      "source_text": "其实，个人常备干酪粉。",
      "source_fingerprint": "2b0844f3b3dc00e0f7bf18eb33bef0745d0a6da7efa996775fb93fcf1885b2e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9233"
      ]
    },
    {
      "uid": "zhcn:aa9827621fb76596aed0f3e0",
      "kind": "text_data",
      "source_text": "其实，经常听广播学习英语对话。",
      "source_fingerprint": "f252d44d042804f9f385412e5b4ef54d5fc1f907f134301ba1f5fdaee12d3b88",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9234"
      ]
    },
    {
      "uid": "zhcn:883be56a3f8c693971987d39",
      "kind": "text_data",
      "source_text": "其实，在沙滩上总是能想出好对策。",
      "source_fingerprint": "d9d65d8f003ea98922c3b60f7c8c6c235d6200782c4b1acb7765d8b0081d95b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9235"
      ]
    },
    {
      "uid": "zhcn:d941eb128d2099864b8fe248",
      "kind": "text_data",
      "source_text": "其实，有点心吃就幸福。\\n如果还有咖啡，就更幸福。",
      "source_fingerprint": "3eac6a20a20a443b2043a51fd9e6d738b1d164fde800a42f5c069a420af49379",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9236"
      ]
    },
    {
      "uid": "zhcn:4cf4c35002d4b2973ce7953f",
      "kind": "text_data",
      "source_text": "其实，人生第一次\\n『灵光一闪』的对象是姐姐。",
      "source_fingerprint": "dc39a74fb7881be6ab23f7c35244ae2a22fdd7d586da076bf12be096c1ed8f8f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9237"
      ]
    },
    {
      "uid": "zhcn:f80b9c6c8b2129b29baba585",
      "kind": "text_data",
      "source_text": "其实，正在研究自制的沙拉酱汁。",
      "source_fingerprint": "b0316a926398a42850c973df048a6cef1d20614e2a112df197dbf98d177f52fa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9238"
      ]
    },
    {
      "uid": "zhcn:1349c713322620b3b22fa01c",
      "kind": "text_data",
      "source_text": "其实，■■■■■■■■■■。",
      "source_fingerprint": "b13fed1ec3dd194ca2577fffabade821ec661973f21019545d5a66537d7ce25b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9239"
      ]
    },
    {
      "uid": "zhcn:a749aa5d51c79ca7b44d8f5e",
      "kind": "text_data",
      "source_text": "其实，刘海的白色流星\\n怎么掰直都会向右弯曲。",
      "source_fingerprint": "a126f2d5803c940b0b9a18b20709a526702abbfaf281bb5cd2630fe3b8ebf890",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9240"
      ]
    },
    {
      "uid": "zhcn:a1b1ba851252c660f8f6a21a",
      "kind": "text_data",
      "source_text": "其实，如果番茄不切得非～常薄，她就不吃。",
      "source_fingerprint": "3cf23a23277ab56d5f3b7c639448eaa8aa8aa025f05d32cc9e543d3629ce616a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9241"
      ]
    },
    {
      "uid": "zhcn:caa6684ffb9011ff7cbf2f01",
      "kind": "text_data",
      "source_text": "其实，自从开始一个人生活后\\n和养的小龙虾说话的次数变多了。",
      "source_fingerprint": "92dd393eee34ddf63f31cef02c78ed046a79c137d404e886458a4906b2eab42f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9242"
      ]
    },
    {
      "uid": "zhcn:120d234ca42642b310ba1b65",
      "kind": "text_data",
      "source_text": "其实，对全天候赛道的气味\\n有点上瘾，挺喜欢的。",
      "source_fingerprint": "de0ad0bbe62f0f0540556fb557ec447147e74350df1fcef9af9375bea7ed2706",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9243"
      ]
    },
    {
      "uid": "zhcn:3447aec03cf9af9f455e4554",
      "kind": "text_data",
      "source_text": "其实，每当看到带有中奖券的点心时\\n总是不由自主地买下来。",
      "source_fingerprint": "25ecbec8842b06f7275eb0855537b966100eef4e9ee48b6381c00a942f0e5cbc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9244"
      ]
    },
    {
      "uid": "zhcn:2f452cf191ac9b0ce66f01a4",
      "kind": "text_data",
      "source_text": "其实，被附近的小朋友们\\n起的绰号是『快驹老师』。",
      "source_fingerprint": "1043a6f20404acabacde5fc0b12f5a255fca8eeef6e60f4d15c34ec8cc4466c2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9245"
      ]
    },
    {
      "uid": "zhcn:466490d728b98568b07c2501",
      "kind": "text_data",
      "source_text": "其实，正在参加当地的登山爱好者协会。",
      "source_fingerprint": "e52720641cc90e633c3b026423d1e9a6faed0c4bda98893d718c992db67723f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9246"
      ]
    },
    {
      "uid": "zhcn:ea37985cac180943603c663d",
      "kind": "text_data",
      "source_text": "其实，闹钟铃声是\\n法螺贝的声音。",
      "source_fingerprint": "2e00ed122455fce5fca6b8b0a599a6f5d0b75a120deb972635e77b5937099926",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9247"
      ]
    },
    {
      "uid": "zhcn:d24712913cad782448449454",
      "kind": "text_data",
      "source_text": "其实，经常在镜子前练习微笑。",
      "source_fingerprint": "a6d59eb507d0dbdd1f71640f0ca991a57ca17e862bd9d78a1b40c643ad8c3398",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9248"
      ]
    },
    {
      "uid": "zhcn:b817ab3ac84921ef92f647ba",
      "kind": "text_data",
      "source_text": "其实，有点不太喜欢椰枣。",
      "source_fingerprint": "0220aff57175fe8fe07441f511436a71e2b74a90fecc31f96ad3ea1256fa6d74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9249"
      ]
    },
    {
      "uid": "zhcn:e5be78627fd22608f91c199b",
      "kind": "text_data",
      "source_text": "其实，――――――那种事情，\\n如果能直接问就好了。",
      "source_fingerprint": "1cbad0e80238d33f19033369963b6380ab45021a143cc91faea7fa545bd30411",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9250"
      ]
    },
    {
      "uid": "zhcn:f0f874454ef173a0485d5480",
      "kind": "text_data",
      "source_text": "其实，最近发现所有的密码都设成了1111\\n最后全部改掉了。",
      "source_fingerprint": "af4563ae72a2d28a5ba37ee8367176fe27609c85f8442c3dde03387081227ddb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9251"
      ]
    },
    {
      "uid": "zhcn:064ea533e100fd65b665a770",
      "kind": "text_data",
      "source_text": "其实，因为睡相太差\\n把床单撕得稀烂。",
      "source_fingerprint": "78c9af134ec3094a19d18bfbab0c2c2ab5487dd8ca149eff649f1a501f837047",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9252"
      ]
    },
    {
      "uid": "zhcn:2225c794d70b3bfdb0002d38",
      "kind": "text_data",
      "source_text": "其实，自称是抽签高手。\\n（秘诀是从底・下・抽♡）",
      "source_fingerprint": "ce8d85ce66e80eb2be756b9b09ea58315c6579d3eb3739268adb63d878c211f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9253"
      ]
    },
    {
      "uid": "zhcn:ebfaf72d9fba97e7755dc843",
      "kind": "text_data",
      "source_text": "其实，一直定期订阅梦幻可爱角色品牌\\n发行的月刊报纸。",
      "source_fingerprint": "7f304e89f8c9adeab858387c5a751c6a56fe2c5e9b882662fb436bf96aa342e4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9254"
      ]
    },
    {
      "uid": "zhcn:88170adcfd2f2bcc44b31aea",
      "kind": "text_data",
      "source_text": "其实，把特惠胡萝卜饼干的空罐子\\n当作宝物盒在用。",
      "source_fingerprint": "80c574a47d0e2a4af19b253c3ba047050971a5f3a7205b6774461aa3a6beec87",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9255"
      ]
    },
    {
      "uid": "zhcn:4171a719ac90611b05a9954b",
      "kind": "text_data",
      "source_text": "其实，很擅长用嘚嘚玩偶进行木偶剧表演。",
      "source_fingerprint": "a0247cc32f78fa9e2b9b0daaeeb56bba402643761252a1fa5788a411eb12b42d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9256"
      ]
    },
    {
      "uid": "zhcn:466bf5aa9145fc12bcbc646f",
      "kind": "text_data",
      "source_text": "其实，很喜欢蔬菜和水果的切片图案。",
      "source_fingerprint": "a113b8c53b2f2ba5d4c1fc0faca2f689715923a700836bcfdab642ea7e53200f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9257"
      ]
    },
    {
      "uid": "zhcn:fe1ba0423bb6b364cf5f75da",
      "kind": "text_data",
      "source_text": "其实，认为最帅的汉字是『哩』。",
      "source_fingerprint": "a80f4bbe8b62cdbf139d45ae25f81b2be4c2db48fb48d871590879912637017a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9258"
      ]
    },
    {
      "uid": "zhcn:fa9088c54fc9dc6633b605b4",
      "kind": "text_data",
      "source_text": "其实，是格斗游戏的高手。",
      "source_fingerprint": "27a05fbebce02114fa3ff8c91d732f61faf87684ad2b42ebe10a9a5de35ed51c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9259"
      ]
    },
    {
      "uid": "zhcn:1e3abfdb01bc78acced245a8",
      "kind": "text_data",
      "source_text": "其实，头发的颜色\\n一年比一年变淡了。",
      "source_fingerprint": "73ee2bed469aaa0d2c033f308fab0fb18be13f65108a26c0ff3bc354414c2ca6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9260"
      ]
    },
    {
      "uid": "zhcn:746cf165f495ce3f54bccf45",
      "kind": "text_data",
      "source_text": "其实，不喜欢香菇的背面。",
      "source_fingerprint": "5105372b052389fd54fce6c1798c75086936fdb447ad72f80b99415a8af8702b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9261"
      ]
    },
    {
      "uid": "zhcn:ec9b68f69ba4b09fdd18c6ea",
      "kind": "text_data",
      "source_text": "其实，把写有梦想的宣纸\\n贴在了床上方的天花板上。",
      "source_fingerprint": "0fce029d8d34108f29b9cc61c859a540f39154fbb7c30e709f5773445eca5a45",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9262"
      ]
    },
    {
      "uid": "zhcn:577f1d1c601f351c9a5383b6",
      "kind": "text_data",
      "source_text": "其实，大喜利投稿用的笔名是\\n『啦啦啦的姐姐』。",
      "source_fingerprint": "5747987e955f25fa59425fb110216956a09f6f77ec5fde081a5a70700a911065",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9263"
      ]
    },
    {
      "uid": "zhcn:d9ce13dbff0f5dc3ea0b6239",
      "kind": "text_data",
      "source_text": "其实，是居合的高手。",
      "source_fingerprint": "f258bdcbddfbc3247006ddf81c8e2223a653a2782b1d32f3a0118682a7383200",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9264"
      ]
    },
    {
      "uid": "zhcn:77463c5a5378d40a589bc97e",
      "kind": "text_data",
      "source_text": "其实，在现役时期经常\\n在冲过终点后因激动而流泪。",
      "source_fingerprint": "759cd60abe28f960313c4c95edf9b1357953a55e650ef967f7fdb14b3de80b25",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9265"
      ]
    },
    {
      "uid": "zhcn:99723acc7a06405dfbff5248",
      "kind": "text_data",
      "source_text": "其实，说到决胜餐就是大蒜料理。\\n（只偷偷告诉大家哦♪）",
      "source_fingerprint": "ba71a368022bbc28068486816adcd2bb0c3999f7cc2f58592f66c11753ef463d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9266"
      ]
    },
    {
      "uid": "zhcn:6d2d7f4639d6127f7ebd45c1",
      "kind": "text_data",
      "source_text": "其实，喜欢网购但是不太会用。",
      "source_fingerprint": "4c68ac7b6886f7378c4c655db981053eaee2b8f3086f2ba2ad14f243bec5493e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9267"
      ]
    },
    {
      "uid": "zhcn:33cd14fca502db06601115e4",
      "kind": "text_data",
      "source_text": "其实，觉得巧克力是\\n引诱堕落的恶魔。",
      "source_fingerprint": "47ed2e5b6aef4fa51d3b87dc34e673cf8059d7de54803fc0f8636eba136dd6ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9268"
      ]
    },
    {
      "uid": "zhcn:228e7daa80719405e34c790a",
      "kind": "text_data",
      "source_text": "其实，收集世界各地以熊为主题的\\n纪念品。",
      "source_fingerprint": "614ecd0ee4c6b7800adf1fc4343aab3389fb5a7c162d5e633d404bdc136f2af9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9269"
      ]
    },
    {
      "uid": "zhcn:ef5bb685e611e392a6a9e1d7",
      "kind": "text_data",
      "source_text": "其实，尝试过戴隐形眼镜，但放弃了。",
      "source_fingerprint": "47b847064808238a892d13c432b5f444e085380cc3744a24ad64af418d4ff0d8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9270"
      ]
    },
    {
      "uid": "zhcn:49bd7bd9da779747e51adaaf",
      "kind": "text_data",
      "source_text": "其实，吹自制木笛时\\n小鸟会靠近身边。",
      "source_fingerprint": "5dcabb917031a17b1166c79a4c716c08e896a166aacd71f4ea29bd9630884949",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9271"
      ]
    },
    {
      "uid": "zhcn:94a0ddf6f1c6276c3bae1781",
      "kind": "text_data",
      "source_text": "其实，只要看到看起来不错的枕头\\n就会立刻买下来。",
      "source_fingerprint": "f7f4294c87bf910ef90f10ee54342cf0140e68983cdab303551f8e053c79e457",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9272"
      ]
    },
    {
      "uid": "zhcn:ae40fb909da77ce5dc0bf33a",
      "kind": "text_data",
      "source_text": "其实，只要听德语歌\\n就会莫名其妙地犯困。",
      "source_fingerprint": "291d75f4da118e49c8f411eafa29f79723e9e42efe29d4d678a247de1d078d96",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9273"
      ]
    },
    {
      "uid": "zhcn:596e73f1130a409626683cf3",
      "kind": "text_data",
      "source_text": "其实，总是莫名其妙地\\n遇到搬家的雁鸭一家。",
      "source_fingerprint": "f1a70c692506c0cce538b6e1af5bc4d2fed52b1fb3aa61f6a138e4d453c60d9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9274"
      ]
    },
    {
      "uid": "zhcn:560e6ee0c8f6b0cddf1fc55b",
      "kind": "text_data",
      "source_text": "其实，上传到UmaSta的照片\\n都超级时尚。",
      "source_fingerprint": "8efe9eb579909fce90b7c145cd7e3eba34cc3a2b0b92039840d5c5fd2ab8a662",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9275"
      ]
    },
    {
      "uid": "zhcn:0254c88982da37bb1ec6f95a",
      "kind": "text_data",
      "source_text": "其实，早上喜欢吃粥。",
      "source_fingerprint": "b5c1a1dfaaa03119ddcb4c8b39598ec635b2ffa3cf46d8f3a97f42192013e1da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9276"
      ]
    },
    {
      "uid": "zhcn:a807cd5acee50a41bda859e1",
      "kind": "text_data",
      "source_text": "其实，入学时买的大号校服\\n很快就变得刚刚合身了。",
      "source_fingerprint": "833fe194a43960c52a8470287a0d0882c948171214c36729664a7b65ba53ddbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9277"
      ]
    },
    {
      "uid": "zhcn:88325733d4c7e25542c95292",
      "kind": "text_data",
      "source_text": "其实，以为是英里结果是海里时，\\n会有点失落。",
      "source_fingerprint": "668653b87cfc5d3c5f84e07e4b9bf85f92492bc86c92f11dc9153e622a1ddecd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9278"
      ]
    },
    {
      "uid": "zhcn:27680f7c8290b39da498d22f",
      "kind": "text_data",
      "source_text": "其实，自从误把梅干当成覆盆子咬了一口后，\\n就对梅干有了阴影。",
      "source_fingerprint": "0a463d3150fe82b05b82a9be74994d007ba0d660217bbb06c7cea9fc228197b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9279"
      ]
    },
    {
      "uid": "zhcn:818d55f164587a8d809f4ed8",
      "kind": "text_data",
      "source_text": "其实，每次过闸机时，\\n脑海里都会不自觉地说「进闸完成……」。",
      "source_fingerprint": "c8bcacf2866de00486175478939ab3d601031231f9c51c6ba0af22a80f4208a6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9280"
      ]
    },
    {
      "uid": "zhcn:667d7af85c071acab0c0275f",
      "kind": "text_data",
      "source_text": "其实，非常擅长平衡游戏。",
      "source_fingerprint": "048d9a53b947905d2d6611754e485b0135d30c610fd8f3d268b6add286bb135e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9281"
      ]
    },
    {
      "uid": "zhcn:570d509dc46b5e49a109e840",
      "kind": "text_data",
      "source_text": "其实，爱好是收集蜡烛。",
      "source_fingerprint": "77667195e808ae224e5cc943ab507475c1bc781dd6551ac9182b8ff02ad28781",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9282"
      ]
    },
    {
      "uid": "zhcn:f56fb1d1f8deb9d185adbe67",
      "kind": "text_data",
      "source_text": "其实，爱好是用红酒杯\n喝葡萄汁。",
      "source_fingerprint": "58f780b078166e02780aa3408ab2d2cbe2eddd05d20df4976b4ad20c13023d6f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9283"
      ]
    },
    {
      "uid": "zhcn:1413e6aa84787dd74040b3db",
      "kind": "text_data",
      "source_text": "其实，在小学的新闻部里\n曾同时连载着5部漫画。",
      "source_fingerprint": "b5441ea06a07a289f6f8a3ca1dbc96dcbde5f65a5bd11ff108a983fa25954998",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9284"
      ]
    },
    {
      "uid": "zhcn:f131fe96f201838e3e20a569",
      "kind": "text_data",
      "source_text": "其实，不论什么样的枕头都能睡着。",
      "source_fingerprint": "611b2defbd954358f478dc280e61b918c653a00e2f5f5bf795ce9c1ed70a4e0b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9285"
      ]
    },
    {
      "uid": "zhcn:3c8b7f6d6834625b702e2546",
      "kind": "text_data",
      "source_text": "其实，小时候曾被姐姐们\n当成换装娃娃玩。",
      "source_fingerprint": "39c22ad2fde0c9afa7f2ad81cc8f7c47ffa6b70c77fe895330f265c868a354f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9286"
      ]
    },
    {
      "uid": "zhcn:09095744d5f0fa206510c809",
      "kind": "text_data",
      "source_text": "其实，最擅长的画材是丙烯颜料。",
      "source_fingerprint": "b957a358bfce1bfc5f65b4c5da185ca02a2a65cd1c4f17747396f25efa3540b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9287"
      ]
    },
    {
      "uid": "zhcn:cd8c26960ca3884c04413aa0",
      "kind": "text_data",
      "source_text": "其实，喜欢的食物是酥脆的\n国王饼。",
      "source_fingerprint": "d60eb45beff3cdc3c54889ab1da211ce0e8e5b0529f2ef26ef2d827e1e3e76bd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9288"
      ]
    },
    {
      "uid": "zhcn:86d61db0627f4dbcdede0009",
      "kind": "text_data",
      "source_text": "其实，有3条正在悉心养护的牛仔裤。",
      "source_fingerprint": "f82531723778dafc03c4234f5d4c2ec6f1686f5786a0448ed6a7a1b87b9af108",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9289"
      ]
    },
    {
      "uid": "zhcn:1ea916766cad7544e9273c29",
      "kind": "text_data",
      "source_text": "其实，套圈圈的技术百发百中。",
      "source_fingerprint": "b0dd831dc4d54a5229cd2f5d91e6b62ee30435dfee667cba16e7256f5a1d9142",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9290"
      ]
    },
    {
      "uid": "zhcn:6e6a6aa48b2eb36377110c10",
      "kind": "text_data",
      "source_text": "其实，小时候曾见过妖精。",
      "source_fingerprint": "48b20839e3a4b0eda770fa8959f3dd0c028edcfedfb9d91483b554046f06365b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9291"
      ]
    },
    {
      "uid": "zhcn:55abda3db182b45133942d9f",
      "kind": "text_data",
      "source_text": "其实，在意大利有一家\n常去的裁缝店。",
      "source_fingerprint": "ef412b67c25d8f605d66a5f29f9b956144c2b14567824d439c462d398df9eaa9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9292"
      ]
    },
    {
      "uid": "zhcn:58075adaea2c4046966b03cf",
      "kind": "text_data",
      "source_text": "其实，每周会去一次\n草裙舞教室。",
      "source_fingerprint": "c57c20295790bf21e38e0cb773c182037b319f159cd9ec5eb2f0581024a9dd61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9293"
      ]
    },
    {
      "uid": "zhcn:69e1c6406d08c4e2d787d6b1",
      "kind": "text_data",
      "source_text": "其实，从几个月前开始就在期待\n年末的搞笑大奖赛了。",
      "source_fingerprint": "863cc6615a0f77bba12901809d0fbc290ee4e850f9f4bd698725e6eb6fcb9633",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9294"
      ]
    },
    {
      "uid": "zhcn:49b4db3c5eac1294f3cbe38d",
      "kind": "text_data",
      "source_text": "其实，偶尔会盯着水族箱\n发呆。",
      "source_fingerprint": "1eebfb8cfccd1c8b39f998e1d0d6d2f43c8330d36e0f159b556f043e4ac48ff7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9295"
      ]
    },
    {
      "uid": "zhcn:a7c5ae96bc2e6ba262ce16f4",
      "kind": "text_data",
      "source_text": "其实，从未设过闹钟。",
      "source_fingerprint": "66dd0e96086d11387de3fa353b19275688a546de1657d280733bd77a5eb26071",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "9296"
      ]
    }
  ]
}
