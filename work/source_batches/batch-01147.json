      ]
    },
    {
      "uid": "zhcn:9e6fa3bd9946c02d9cc441fa",
      "kind": "text_data",
      "source_text": "大西沙织",
      "source_fingerprint": "4bb767c295269cc12e96f17c50bf2c059ea44b0207051311358dab21ec326720",
      "source_path": "text_data_dict.json",
      "json_path": [
