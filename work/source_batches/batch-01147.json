      "kind": "text_data",
      "source_text": "森林合唱会",
      "source_fingerprint": "21c291849022a09a23bee35cd46f5b2ea22651bd04c8629edf9d731331a5b373",
      "source_path": "text_data_dict.json",
      "json_path": [
        "69",
        "99"
      ]
    },
    {
      "uid": "zhcn:3295270aa8c1e012f4e5f4ef",
      "kind": "text_data",
      "source_text": "和气杏未",
      "source_fingerprint": "5ff6b967f5e3b172bce90c00cbbcda746f2dd43db914df887409639819d37ffb",
      "source_path": "text_data_dict.json",
