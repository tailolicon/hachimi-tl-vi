    {
      "uid": "zhcn:98b412c59c2f4e49dfa77925",
      "kind": "text_data",
      "source_text": "栗东宿舍",
      "source_fingerprint": "a8f78cb8cbb47ceb3aa72772fc9d3ab3dda200826de258d672f8525a6a4c9f32",
      "source_path": "text_data_dict.json",
