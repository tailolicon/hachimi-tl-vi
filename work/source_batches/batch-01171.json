{
  "schema_version": 1,
  "batch": 1171,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:db01de2d97b554ec0d8e18c6",
      "kind": "text_data",
      "source_text": "为你而生的故事，现在开幕",
      "source_fingerprint": "37e21374f6e437445ca33707a6b9e71c4d0941df7163b9774b147d6a921c70e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41047004"
      ]
    },
    {
      "uid": "zhcn:7d88a5f061facd37e62c0751",
      "kind": "text_data",
      "source_text": "我所理想的姿态？",
      "source_fingerprint": "4c2095d98518e4940fb81ab0a452573e3a8efd406c3b634ee59b27a27cb8e787",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41047005"
      ]
    },
    {
      "uid": "zhcn:d17eeacac40b2a5ff7a4e8c0",
      "kind": "text_data",
      "source_text": "不想强加于人的愿望",
      "source_fingerprint": "1e01384ff1a6f8e2b9914b7b5aed11ee059c5827812bb911fa1be772713fe7fe",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41047006"
      ]
    },
    {
      "uid": "zhcn:5112a3f19dd92cb397c4a34d",
      "kind": "text_data",
      "source_text": "一如既往的你",
      "source_fingerprint": "47027ab330d9ecc36b7fe9afe1703adbf882a89dd12a4ced9d0b9891468b0c78",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41047007"
      ]
    },
    {
      "uid": "zhcn:41576106f31a8ee302485d0a",
      "kind": "text_data",
      "source_text": "黯淡的世界，沉重的双脚",
      "source_fingerprint": "dcc88717b1d4f7cda03716a140b75168636447a70f751aa86cc6a479c09140b8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048001"
      ]
    },
    {
      "uid": "zhcn:ff2632668be150b33c32afac",
      "kind": "text_data",
      "source_text": "不接近，不交流，单一色彩",
      "source_fingerprint": "e3c4c80f67bbabc10900c15c45314349d5f06dbfebace199d47f8563bed8ab3f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048002"
      ]
    },
    {
      "uid": "zhcn:aab3cb7c3d019bec0043737b",
      "kind": "text_data",
      "source_text": "我的色调",
      "source_fingerprint": "bd55590588a71598e476bce1c7977939ce3e907a954c275c8ae5e3d66d81bbb6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048003"
      ]
    },
    {
      "uid": "zhcn:a5a034ef544172856cff20cc",
      "kind": "text_data",
      "source_text": "那里如极光般缤纷灿烂",
      "source_fingerprint": "7961353867edaf0084408b07f96ca8cf5370693d6a04b354e66ee974f739b06e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048004"
      ]
    },
    {
      "uid": "zhcn:387bfe389128379e107e7013",
      "kind": "text_data",
      "source_text": "没有交集的色调",
      "source_fingerprint": "db01546147ea6ecbd504637f1c53dee2bae3d2568236a034957663d47314184b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048005"
      ]
    },
    {
      "uid": "zhcn:4b462c15eee9d38c8320c6b8",
      "kind": "text_data",
      "source_text": "清澈且纯白，鲜明的法式美甲",
      "source_fingerprint": "e6e70050175999995e4641d45948158bddf9a5b9829c131228be96155bc16e6c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048006"
      ]
    },
    {
      "uid": "zhcn:5d1fa704889d17a5577b15db",
      "kind": "text_data",
      "source_text": "拉近了美甲片厚度的距离",
      "source_fingerprint": "b6a52a96aa1531c10ead567371a2c4cbdd91fad558c18b9abc5b9abf02a2cd60",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41048007"
      ]
    },
    {
      "uid": "zhcn:45a53fe575b9b1d3ebc4a31c",
      "kind": "text_data",
      "source_text": "投身惊涛骇浪中的那一日",
      "source_fingerprint": "87e184d7b166179f37a6414bae06bad5d1d3556fab715028670471326783faae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049001"
      ]
    },
    {
      "uid": "zhcn:d5ffaa075f7cd77eda75ca20",
      "kind": "text_data",
      "source_text": "浮沉于阴云中的老天爷",
      "source_fingerprint": "751cfdb914fec546cf2482f9684aec18c47df0d315c963b4f0e5bd896c2b7adf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049002"
      ]
    },
    {
      "uid": "zhcn:56c26c6ee93936575577a832",
      "kind": "text_data",
      "source_text": "令人神魂颠倒的是……",
      "source_fingerprint": "335d6cf6ed57d0ec7c55106d2258b305e32fc42feef7bacaceea5cfa6d8e5746",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049003"
      ]
    },
    {
      "uid": "zhcn:7c9b2f6ce123654a4365f7ac",
      "kind": "text_data",
      "source_text": "满身泥泞地迎来朝阳",
      "source_fingerprint": "5d862c1f5babf940091927042115335f83f2331c6167e4302421d06b6b2d158c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049004"
      ]
    },
    {
      "uid": "zhcn:88df85a732369a43faf39a7e",
      "kind": "text_data",
      "source_text": "生于浮世，人言纷纷",
      "source_fingerprint": "1eae75748e5d13efc75095790bdc62b8a36218ef99d654a916b62e5e0fae94d1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049005"
      ]
    },
    {
      "uid": "zhcn:ce0410e8b6452010bdae695a",
      "kind": "text_data",
      "source_text": "无论晴雨，随心所欲",
      "source_fingerprint": "7650b809da6bffea5f72c09901df1fe5ebdce20ea84fae56cea9f019112c9ad8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049006"
      ]
    },
    {
      "uid": "zhcn:01541211f4ed069c0e339a8d",
      "kind": "text_data",
      "source_text": "共赴癫狂，共舞至死",
      "source_fingerprint": "51002271cfa8038ee0e1c66290ae4423223a3f50b2365bfdb19a4b34dcf038c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41049007"
      ]
    },
    {
      "uid": "zhcn:e595c679e78ce2432cfaad4e",
      "kind": "text_data",
      "source_text": "No one knows me.",
      "source_fingerprint": "2ad68c1cb6839b0c55357aa02c84ddb0fb785aeeb467f549db5c62a932ed1110",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050001"
      ]
    },
    {
      "uid": "zhcn:3f285691d3a5346cacb06c19",
      "kind": "text_data",
      "source_text": "“No pain No gain”?",
      "source_fingerprint": "1e90dfdb8485ee977753eb5d36999aeda54f58325002e8a362a5ac2c8ad81e7b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050002"
      ]
    },
    {
      "uid": "zhcn:7c7dc37fd9b4b868424681df",
      "kind": "text_data",
      "source_text": "No way but……",
      "source_fingerprint": "67d07f19a5e4f39b94f1a19763d3ad16cb856cee04e0209ecffdf897a5d7c2d9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050003"
      ]
    },
    {
      "uid": "zhcn:b03e95642c89651bd837feb8",
      "kind": "text_data",
      "source_text": "No more waiting.",
      "source_fingerprint": "32847b878e2f8a17ca098297b56eb34162386806836be3e2fc81ac871dcf15ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050004"
      ]
    },
    {
      "uid": "zhcn:6ba4f15ea0b73f069d9b6c82",
      "kind": "text_data",
      "source_text": "Nobody I need.",
      "source_fingerprint": "bb8525ba78df806a87d112c85d65f091a1c88b604b6f7ecea67401b9a143e64c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050005"
      ]
    },
    {
      "uid": "zhcn:fdccef02c756988e2992dd4d",
      "kind": "text_data",
      "source_text": "Nobody goes in.",
      "source_fingerprint": "78c028d6bc31b91d37655e82acffb6e46e8a89a099f6b92cc01d7097a4b759a7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050006"
      ]
    },
    {
      "uid": "zhcn:09d48ffdb460eb61dd49e0b3",
      "kind": "text_data",
      "source_text": "Nobody can change me. so……",
      "source_fingerprint": "b7f94a8896072f5d4bf963a7665c73fcb45ca877be454b9b4ed5224ff5466cde",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41050007"
      ]
    },
    {
      "uid": "zhcn:f8925484f3467aa1d9fb2f3d",
      "kind": "text_data",
      "source_text": "播下的种子",
      "source_fingerprint": "1f20195a4a94033ea1521870adaf469c3b01fdbcce8196707e915ab030c0ee75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051001"
      ]
    },
    {
      "uid": "zhcn:a15cffa05fc6fae9c6d208ac",
      "kind": "text_data",
      "source_text": "新芽萌生前",
      "source_fingerprint": "9d36e17cbac72ff26fde002516a0ce35b6f73da195cd57037d144b3e842641b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051002"
      ]
    },
    {
      "uid": "zhcn:cae959e5bb891d19936313d4",
      "kind": "text_data",
      "source_text": "从大地展露面貌",
      "source_fingerprint": "4235cfb750bfc6d86580c145f7bb1d2c5348a6d59808a2d32fcc1c900b9fae23",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051003"
      ]
    },
    {
      "uid": "zhcn:47c32aacdf93932a538e3cf2",
      "kind": "text_data",
      "source_text": "虽然现在还只是花苞",
      "source_fingerprint": "d80eeb9476cae7e40a77f60be39e18c100d54fb56d65cf70baae17e386fba542",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051004"
      ]
    },
    {
      "uid": "zhcn:ec0aaa8c1293241c292eba47",
      "kind": "text_data",
      "source_text": "等待绽放之日",
      "source_fingerprint": "00e00ed2616864895a625cbe12dabe0db1da70579c8f8e7c79d1fbc8d1da048a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051005"
      ]
    },
    {
      "uid": "zhcn:1ff37dd25aff5668c959c05f",
      "kind": "text_data",
      "source_text": "请滋润这片土地",
      "source_fingerprint": "13f6ec05f2dcfd7fc50c3dbde4a5e11be1edc71a98939af6ddf912195008d640",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051006"
      ]
    },
    {
      "uid": "zhcn:b49d08359b8d74bfcb058e87",
      "kind": "text_data",
      "source_text": "笑容之花绽放",
      "source_fingerprint": "7b7982e2f57f275319015cb94c724ee225d56f97cca7b07f9bde99de3a61c98d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41051007"
      ]
    },
    {
      "uid": "zhcn:11f5a78d73b52a797024075f",
      "kind": "text_data",
      "source_text": "我呀，要拿下第一名哦♪",
      "source_fingerprint": "b4d14bac5fc6e4aea5a18c07e97dc427c9bdb63302e7d8bf2c77ad7d1e14d1e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052001"
      ]
    },
    {
      "uid": "zhcn:680bfad8fadeac2b1a3e7e7c",
      "kind": "text_data",
      "source_text": "上ー门ー，踢馆来了哦☆",
      "source_fingerprint": "fa80c488dcbd8a47f761c86c95b3b0a0a5eba80351083d810a27cbe63065a6df",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052002"
      ]
    },
    {
      "uid": "zhcn:377ee84aa12354f43e2d55d6",
      "kind": "text_data",
      "source_text": "毕竟是梦想，我不会放弃哦！",
      "source_fingerprint": "51c8ea0a0d982f81c155705b606fb2134ab94fc5b0bc93b71c871c05506d6326",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052003"
      ]
    },
    {
      "uid": "zhcn:47859c14576bfe56e89e5e51",
      "kind": "text_data",
      "source_text": "绝对，要赢哦。",
      "source_fingerprint": "df0fa129d96a9221d7d7f5fe72ba0a7812057a9335173b3147a34b7dfba595e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052004"
      ]
    },
    {
      "uid": "zhcn:5ea87ac6c30062048854c849",
      "kind": "text_data",
      "source_text": "冲啊冲啊☆春丽的新纪录",
      "source_fingerprint": "7291c0072d0830faeefba89ca828e7f454caa55ed78754131dd79c8c5c6b7a1b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052005"
      ]
    },
    {
      "uid": "zhcn:e3249aa647783454e289f074",
      "kind": "text_data",
      "source_text": "STOP？春丽的大作战",
      "source_fingerprint": "3b31a37b0dd2e3a9701e65560efa4495875fd0d627b543aee2dbf79479fdbcf4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052006"
      ]
    },
    {
      "uid": "zhcn:2a51b7a43bb3112de813aeb4",
      "kind": "text_data",
      "source_text": "加油！春丽的不屈服",
      "source_fingerprint": "4fb0ed833a4798624391f240f1d3d16c1bac547844e4e830fcc0d22a797803fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41052007"
      ]
    },
    {
      "uid": "zhcn:1bbfc63ae824bde31c603771",
      "kind": "text_data",
      "source_text": "命运般的相遇！青竹回忆！",
      "source_fingerprint": "fa8e45ef2a49de57bb6135baaea103c784ea39164412769830e7bcd844f55ae8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053001"
      ]
    },
    {
      "uid": "zhcn:5ba8b9af84db63b8a1fadcc4",
      "kind": "text_data",
      "source_text": "点燃吧！约定与热情的火焰！",
      "source_fingerprint": "872537da2bcc1c2d99648aed4e6021b505daadce5ca24ae25c3032029b72c1c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053002"
      ]
    },
    {
      "uid": "zhcn:486fbbf38116f36d73055a53",
      "kind": "text_data",
      "source_text": "梦想的力量！强韧的证明！",
      "source_fingerprint": "3156dfb40d9844950988ddaefa0d73432c8da0bd524c4edd395fbfd1376553a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053003"
      ]
    },
    {
      "uid": "zhcn:61b43731a16c652926ed671e",
      "kind": "text_data",
      "source_text": "奔驰吧！通往明天的赛场！",
      "source_fingerprint": "46a624870023e41f70acce1289dd16b96e39b0055b3ade919acf95dffdcaf23d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053004"
      ]
    },
    {
      "uid": "zhcn:6396dd8da2514ec7ae8d9bab",
      "kind": "text_data",
      "source_text": "守护学园！纠察队长奋斗记！",
      "source_fingerprint": "c999d2cdeb43f8a9199162ffd6b96f3d9be156f452c3e871a40ed4bb507c4232",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053005"
      ]
    },
    {
      "uid": "zhcn:bffd8152490a2cd4cc317143",
      "kind": "text_data",
      "source_text": "全心全力！全力以赴放松！",
      "source_fingerprint": "45bc122aa7b7a5f7096bfde31746549b76c2a32460d5a900b3947071e852547d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053006"
      ]
    },
    {
      "uid": "zhcn:b2872f35bd010e835c647592",
      "kind": "text_data",
      "source_text": "发生事件！？奔跑吧，青竹！",
      "source_fingerprint": "9640f13b957dc13a360a24003b2f9b9ec1eef8b9048860d3904e95949add3c41",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41053007"
      ]
    },
    {
      "uid": "zhcn:1672c1df54cb07780f142e82",
      "kind": "text_data",
      "source_text": "見参！ジャスティス・ビコー！",
      "source_fingerprint": "5c1997d3aa28f2f2e417a7ffa817bb117cd4385cf12733f985efe9939f3d9a01",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054001"
      ]
    },
    {
      "uid": "zhcn:9cc392a8085534a11bddb3d3",
      "kind": "text_data",
      "source_text": "むすべ！夢と仲間と共同戦線！",
      "source_fingerprint": "973aaf3e8a06712353f7a0e72e99133051c68ae05f48ed061d888d641d7dca7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054002"
      ]
    },
    {
      "uid": "zhcn:218c6a98a2f4e5037b20b472",
      "kind": "text_data",
      "source_text": "衝撃！憧れは獣のごとく！",
      "source_fingerprint": "ca1b9799606328739dc7e75e7e000560d015fca5444983b1cb9e3a362fcab3e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054003"
      ]
    },
    {
      "uid": "zhcn:cb7b884c0b72f27f8063a647",
      "kind": "text_data",
      "source_text": "ヒーローの条件",
      "source_fingerprint": "a7cef4bab9d369dec6f48fe86ea71820248119ef62d8981a07fc1bfbc19043e6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054004"
      ]
    },
    {
      "uid": "zhcn:867c55a8287ea570859e1b34",
      "kind": "text_data",
      "source_text": "颯爽！みんなのピンチにアタシ、参上！",
      "source_fingerprint": "be88c3afad652131620daf0d1221f27ba0fd9289d94b2642ab4ea1bbc9b956b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054005"
      ]
    },
    {
      "uid": "zhcn:b7812152cb375207ba1dc95f",
      "kind": "text_data",
      "source_text": "特訓！目覚めろ、正義の魂！",
      "source_fingerprint": "448f29d765aa983a92499bbbb7d058bf8047af69cb55b9005871e52a559c0e8c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054006"
      ]
    },
    {
      "uid": "zhcn:28647f06855b52e5241b830c",
      "kind": "text_data",
      "source_text": "変身！新しいヒーロー、新しい自分",
      "source_fingerprint": "eeecac3ec32581b90520c865688dd0452112c034737f8af351464c8b9630fad5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41054007"
      ]
    },
    {
      "uid": "zhcn:22971edc65162f844ba5e2c6",
      "kind": "text_data",
      "source_text": "相遇美丽无比☆",
      "source_fingerprint": "5cbc393131a71ad4c7b8dcdf71ea228cf50137836b0369d6653ef97d70ceb4fc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055001"
      ]
    },
    {
      "uid": "zhcn:9e9ba0543734d0d5c22e12e7",
      "kind": "text_data",
      "source_text": "想告诉你美丽★",
      "source_fingerprint": "a4289a8c876412873dc7eb5918bead5b641e7e86246cc39b9dc81bf344a62254",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055002"
      ]
    },
    {
      "uid": "zhcn:c465bdce31574a2ee54b19c9",
      "kind": "text_data",
      "source_text": "搜集美丽的预感☆",
      "source_fingerprint": "fd565e8a24766d6e68bf8243a46eea444bf8ad143b0926463453bcf658f5f00e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055003"
      ]
    },
    {
      "uid": "zhcn:f3b3a1487af144b1df51a25d",
      "kind": "text_data",
      "source_text": "从这里开始的美丽★☆★",
      "source_fingerprint": "717a6b167a24e2e508b20dc0c31b9fe9737e302ed76e975c84323ea492a60d4e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055004"
      ]
    },
    {
      "uid": "zhcn:1c68d91bc36c2a75f60f64a3",
      "kind": "text_data",
      "source_text": "发现美丽吧☆",
      "source_fingerprint": "42200586a35694c6fd64f1672658b25b0507b98aa0c8ce45212ea3496d093dcc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055005"
      ]
    },
    {
      "uid": "zhcn:9c1b19380aecf616f7fba730",
      "kind": "text_data",
      "source_text": "世界真美丽★",
      "source_fingerprint": "04246b8dfdf4a467ff185e7c39f9c08d782b44976cdd7c1f062649b88a8dde78",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055006"
      ]
    },
    {
      "uid": "zhcn:40514f475d7967c501c2f5d7",
      "kind": "text_data",
      "source_text": "传遍世界的美丽☆★☆",
      "source_fingerprint": "a9f641a4165e019ee3a3e2716f55b30458c6e2bec0b1bcf21c0f97056e838b7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41055007"
      ]
    },
    {
      "uid": "zhcn:cbf2d1c6033fa4c144e35304",
      "kind": "text_data",
      "source_text": "命中注定的人来了！",
      "source_fingerprint": "81b51d574fe2cb09213e0c18a4546587d750fc084d1c2587f110115c1113a7ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056001"
      ]
    },
    {
      "uid": "zhcn:fb2a881dc8af4371a697fc1f",
      "kind": "text_data",
      "source_text": "相信吧，大吉之力",
      "source_fingerprint": "87c9044bcf1d014b41ef99e57597d8370289b5bfe1cf13b477bf4ad5d86fa7f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056002"
      ]
    },
    {
      "uid": "zhcn:376ef04fa90f067164349eae",
      "kind": "text_data",
      "source_text": "选拔赛是大杀界？",
      "source_fingerprint": "7ed374fc5d1fe6b75208a223ab98b94ca0a61a8ef235479272dc6dc592a08ce0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056003"
      ]
    },
    {
      "uid": "zhcn:9bc19d33724df4e683362b4b",
      "kind": "text_data",
      "source_text": "大失败亦是大开运！",
      "source_fingerprint": "89fcce00e17bc1761ec468ec97d738cb357aea5f87a7b5012bfe10c30e6c39f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056004"
      ]
    },
    {
      "uid": "zhcn:95a8a58da6ecaa4578125817",
      "kind": "text_data",
      "source_text": "那份福气，切勿丢弃",
      "source_fingerprint": "728907e4916d39a0c1f4d713f3ff5bfb2e40bd1b8c9b5eaee42234142893b171",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056005"
      ]
    },
    {
      "uid": "zhcn:cd0cec6abba47f5d9e0bf033",
      "kind": "text_data",
      "source_text": "Let's Goー开运之旅",
      "source_fingerprint": "d344ac92e543538e416fb61290e283ae08ddddc23e74fc56644cd484bf0f2122",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056006"
      ]
    },
    {
      "uid": "zhcn:ee2367fc806595a7114b356e",
      "kind": "text_data",
      "source_text": "幸福啊，流去吧",
      "source_fingerprint": "258b0c23b6f30fcf05d1a7ed5ce8d7c711c54e0101976c14f915e7d7c7012046",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41056007"
      ]
    },
    {
      "uid": "zhcn:89382b1e82025bba2846ac60",
      "kind": "text_data",
      "source_text": "你究竟是何许人也",
      "source_fingerprint": "ce29c54df6ca9973f59ea4436190d22b7fb261619aac0459a2bcd680447f52eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057001"
      ]
    },
    {
      "uid": "zhcn:f7bc4687fb985c73fb8d9c06",
      "kind": "text_data",
      "source_text": "不是为了梦想",
      "source_fingerprint": "81cddc927dbd48428b0d891fad45415022b785565125acb34986c324decd647a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057002"
      ]
    },
    {
      "uid": "zhcn:718c310a25514945ed27c6ee",
      "kind": "text_data",
      "source_text": "闭上眼睛就能看见一切",
      "source_fingerprint": "d439ec4ac82b1c9234b4573d9c0f7a6fb0d38d5a004117ddb583ae57d136a35b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057003"
      ]
    },
    {
      "uid": "zhcn:75c5bafc25598046336670dc",
      "kind": "text_data",
      "source_text": "我是千明代表",
      "source_fingerprint": "4889400947dd852795a48293572a6c80f48840daa5bf4fb89ef680dec90fbf09",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057004"
      ]
    },
    {
      "uid": "zhcn:9871f835508fc70b39d8abe4",
      "kind": "text_data",
      "source_text": "晴天、寂静与导演",
      "source_fingerprint": "3fc9566e87187ce1908606d4cdbae55aa88465e7e3762984c10a16060b2f44d4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057005"
      ]
    },
    {
      "uid": "zhcn:07bad928cb078f606e7886f7",
      "kind": "text_data",
      "source_text": "真要形容的话，就像个棘手难题",
      "source_fingerprint": "ea8022bc5a21b1fceb1934117d09a0b41fb300090fa38902676bac3d9c26fe52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057006"
      ]
    },
    {
      "uid": "zhcn:f93277d8420599dc8c913416",
      "kind": "text_data",
      "source_text": "在名为巧合的舞台上共同演出",
      "source_fingerprint": "a5a43aa576beb88422ba95f8ccf39bf8e08ed4bc712d0ad68476d99ba9a6e50f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41057007"
      ]
    },
    {
      "uid": "zhcn:cc4b49076cb8385fb86c4989",
      "kind": "text_data",
      "source_text": "冒失了，对不起",
      "source_fingerprint": "0cf53b100ef7d1c00d6e375a74dd24cc453717bc519c419353d7a947b67cc3e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41058001"
      ]
    },
    {
      "uid": "zhcn:cd628fa88721bdaa4c7ccbf2",
      "kind": "text_data",
      "source_text": "白忙一场，对不起",
      "source_fingerprint": "d2e77973c4e65f0f94af80a35d99f450155998e42dff5844ae3b6732be97776f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41058002"
      ]
    },
    {
      "uid": "zhcn:65a1979ef5da42315fec34f0",
      "kind": "text_data",
      "source_text": "不肯放弃，对不起",
      "source_fingerprint": "915e6ac4fce8398710b2b468402db02e4ff369c9663c554567641f0cd0bbe478",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41058003"
      ]
    },
    {
      "uid": "zhcn:ca4ebfe8686b06f5c4b33590",
      "kind": "text_data",
      "source_text": "对不起，但总有一天――",
      "source_fingerprint": "0354a8f9c7b5eaeb4b838e4dbae326052771b6a052ecf7b499c5a76631782b5f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41058004"
      ]
    },
    {
      "uid": "zhcn:708d13989095e3dbb0417096",
      "kind": "text_data",
      "source_text": "不想，给你添麻烦",
      "source_fingerprint": "3e46a6913cbc5fec4278231fbfdab715d05683b4fbb887ed606636c0e2283899",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41058005"
      ]
    },
    {
      "uid": "zhcn:fe4efccfc10811421d57eace",
      "kind": "text_data",
      "source_text": "给你添麻烦，也没关系吗",
      "source_fingerprint": "5ef6c005375546a6b06e7536e274442a523dc34a003acc5ad94e144c6dfc6b74",
      "source_path": "text_data_dict.json",
