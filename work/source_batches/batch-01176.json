      "kind": "text_data",
      "source_text": "Negotiation",
      "source_fingerprint": "3e18e2dab6f2bdb77a8888916f368ab87ad7a23534560f8159744aff0e245aff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41119003"
      ]
    },
    {
      "uid": "zhcn:1c76d2d8bc7cf0fc6945df06",
      "kind": "text_data",
      "source_text": "Agreement",
      "source_fingerprint": "2dff10f6a8b7e6985b6ad779a205a3cf95f95d5966402e50d288696519bbe2ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41119004"
      ]
    },
    {
      "uid": "zhcn:5d58a5a36f55b814bee80cc0",
      "kind": "text_data",
      "source_text": "Intention",
      "source_fingerprint": "4b6e58f607e5a749fbba665ae1b9061701507ac409008243858c3d72098904da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41119005"
      ]
    },
    {
      "uid": "zhcn:a1640518c902bd8bf881b414",
      "kind": "text_data",
      "source_text": "Malice",
      "source_fingerprint": "af55ccec6442d187de2465816dca170a86217b50c9bed9729e410e41d637a97e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41119006"
      ]
    },
    {
      "uid": "zhcn:9630080def49ac5e153ab9ed",
      "kind": "text_data",
      "source_text": "Trust",
      "source_fingerprint": "ade9248e0132b4112c81e94cce392e1068029bac214f23c79d10693e781a16f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41119007"
      ]
    },
    {
      "uid": "zhcn:012ef940f3113e0979c49257",
      "kind": "text_data",
      "source_text": "驚速！そのウマ娘は光の如し",
      "source_fingerprint": "d7afa9a8a828ba50b4be69de22abf63c3d009ddb85d558d06efb08810b9a371b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120001"
      ]
    },
    {
      "uid": "zhcn:5577bfa5173d576f4d98247b",
      "kind": "text_data",
      "source_text": "打倒！ライバルは偶蹄目",
      "source_fingerprint": "8ef6815586e0d2320bd28de68890d28344fa5b0c027570edca3c472c11611cac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120002"
      ]
    },
    {
      "uid": "zhcn:3c7b1a729fc797e17f2ecaa0",
      "kind": "text_data",
      "source_text": "浪漫！最高速は無二の輝き",
      "source_fingerprint": "4cb93b028646dc2650edec9a721134eeff01a58c9be1cf540f4cfc93fc4a0fb4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120003"
      ]
    },
    {
      "uid": "zhcn:85280590cbc508065978dc7c",
      "kind": "text_data",
      "source_text": "超越！あらゆる生命の先頭へ",
      "source_fingerprint": "7fa9809d42419f8f38bc89e405ce9c5ac3c850feaf3b22d42492dcd500b3c8f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120004"
      ]
    },
    {
      "uid": "zhcn:16c8c969b7e34e4f5cf284e6",
      "kind": "text_data",
      "source_text": "爆走！最速娘は止まれない",
      "source_fingerprint": "901dc49af5aee89c425ee83242dfc634507b2e199db5bc88670cd2bc8799f1a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120005"
      ]
    },
    {
      "uid": "zhcn:a7fecb3acf120982fb7c7808",
      "kind": "text_data",
      "source_text": "合体！パワー二乗はスピード二乗",
      "source_fingerprint": "ad8c0e5fde9c320b2c5babe1c16af48bd0cab20592be56a45f9893ef1daeba7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120006"
      ]
    },
    {
      "uid": "zhcn:830aab46e373832f409cb1c3",
      "kind": "text_data",
      "source_text": "驚嘆！広がる世界は宇宙より速く",
      "source_fingerprint": "58ed612209801e910f1d68caf7101e86ae6b84d850af3e19d4ee27bbcd129165",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120007"
      ]
    },
    {
      "uid": "zhcn:b3e8d479b41842348066af91",
      "kind": "text_data",
      "source_text": "华丽与刚毅！骑士赛马娘，参上",
      "source_fingerprint": "289b81ad9246a37a302a0f146ce4ddd51db2578018dcb366ee35c4fc01d6ffd7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121001"
      ]
    },
    {
      "uid": "zhcn:6844c6f45480c7c57a164311",
      "kind": "text_data",
      "source_text": "『圣剑』一闪！我之王何处寻？",
      "source_fingerprint": "c8284c58d9c443c150971af04eb2821e94014a0c28561df46e173e7076f329fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121002"
      ]
    },
    {
      "uid": "zhcn:ac7f00862889b213c012b29e",
      "kind": "text_data",
      "source_text": "神圣的憧憬！骑士道才是我之道路",
      "source_fingerprint": "63ba3c649c55e43785521799a85c3025aeb2049ee9e422eb4a5309e56eddfed0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121003"
      ]
    },
    {
      "uid": "zhcn:9f38acbc77b1efa7ec8948f6",
      "kind": "text_data",
      "source_text": "骑士授任仪式！我之王乃大器，并且……",
      "source_fingerprint": "ac61163d756f5be97b8143c520ec9d43c6ba18e40380d70a54ccc6e8d3869ca2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121004"
      ]
    },
    {
      "uid": "zhcn:975b3f24a703f1b1220e6b2c",
      "kind": "text_data",
      "source_text": "汝、勿忘此事",
      "source_fingerprint": "cf982cca527b633a313646c486cb75820e8bc636b6d7fee0e9677d5363c1f3ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121005"
      ]
    },
    {
      "uid": "zhcn:4604948058a7b859f4576e41",
      "kind": "text_data",
      "source_text": "汝、勿动摇",
      "source_fingerprint": "2aa7947548756ba36e99d5fbcaeef0c87d4ac5f0bf52a26aa762c0b728cb8da7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121006"
      ]
    },
    {
      "uid": "zhcn:49c4c4d6dba4fbe64ac5de68",
      "kind": "text_data",
      "source_text": "汝、勿避视骑士",
      "source_fingerprint": "c8f06289631a9e151f1ac0072c69307cda5de3cc66720fcf51b24a96021f6c91",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121007"
      ]
    },
    {
      "uid": "zhcn:e4d6d616f3c2d621efef6e2a",
      "kind": "text_data",
      "source_text": "弾ける光",
      "source_fingerprint": "13768328532b98459820cae5f050f8e1e7dc047064aaf36f37adae143fc44f74",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124001"
      ]
    },
    {
      "uid": "zhcn:6776f8520290f0a885050755",
      "kind": "text_data",
      "source_text": "切り込む意志",
      "source_fingerprint": "e827e362cf801ad2973d9181f7fb2e1d499a157a1b6bd3d48ce458f0db577ac1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124002"
      ]
    },
    {
      "uid": "zhcn:faddb78898ec626651df2838",
      "kind": "text_data",
      "source_text": "変わる自分",
      "source_fingerprint": "e285c15d684eaf4dcbe497c0a01d7c2211e623c56a69cc0acb133a8a13615378",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124003"
      ]
    },
    {
      "uid": "zhcn:b48bc69a4a421b6ad4d48de4",
      "kind": "text_data",
      "source_text": "膨らむ夢",
      "source_fingerprint": "e8eaec80886d67f52ba51ad67d98b04fa225dd81dfd2e0f196147a1e80582b8c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124004"
      ]
    },
    {
      "uid": "zhcn:d8c5d7f36749bb55e01adf9b",
      "kind": "text_data",
      "source_text": "怯まぬ心",
      "source_fingerprint": "0374f6291bc0c8b9c88c673e5a04cbbcfc76f359b0459a2088e7b532c9f5afa2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124005"
      ]
    },
    {
      "uid": "zhcn:6cce8f1848c5b5eb3443efca",
      "kind": "text_data",
      "source_text": "掲げる信条",
      "source_fingerprint": "e718d8dad031b9d2a5a7850f94f60fbe6f72d85efd9acb617929841b35b19195",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124006"
      ]
    },
    {
      "uid": "zhcn:ff5d824c8c94346c584f7737",
      "kind": "text_data",
      "source_text": "信じる瞳",
      "source_fingerprint": "399debcbd02e0b2e7f035b87d7a9ae21701fd7682a4e9c870cf93c8c6b6d2844",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124007"
      ]
    },
    {
      "uid": "zhcn:69165ff6818c52495a167a9e",
      "kind": "text_data",
      "source_text": "杏目",
      "source_fingerprint": "b632be927b5d52ab85b0cfae236cdc76e44b41d48ba6e925027a4013417d1d5f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129001"
      ]
    },
    {
      "uid": "zhcn:6c533ef4d99562aa7674cb3f",
      "kind": "text_data",
      "source_text": "渴求胜利的、那双闪耀之瞳",
      "source_fingerprint": "bf3979b26fc16acfbdccf9514e1cca6ba57973faebd33e6277e8631f6a00d503",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129002"
      ]
    },
    {
      "uid": "zhcn:d48d09c6ff0652f96afde4d5",
      "kind": "text_data",
      "source_text": "纵使耀眼得令人目眩",
      "source_fingerprint": "be8fb3034930b23e88b233ea42dbde523a0d90832292a84a0ed4200699be0877",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129003"
      ]
    },
    {
      "uid": "zhcn:67e2fe47a4f03628dacb20ec",
      "kind": "text_data",
      "source_text": "携手走向前人未至的未来",
      "source_fingerprint": "6089125714c76b3890ec24e19af5b1ea5b7175ccf532d4f45180ba0231de0c52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129004"
      ]
    },
    {
      "uid": "zhcn:d3a7610bdc9cccde67dba1b5",
      "kind": "text_data",
      "source_text": "一、二，诱入梦乡",
      "source_fingerprint": "d26dd99079aa0a369ac6b299823cf08dba8c2dc66f6f0ba359fb0696df48f6bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129005"
      ]
    },
    {
      "uid": "zhcn:9bda6f372e00f29f91f47878",
      "kind": "text_data",
      "source_text": "毫不犹豫地，向着那道光芒伸出手",
      "source_fingerprint": "b30950a7617c6e8a2a060c71a912c4ec0a2c59c2f86a2beb094d47983ad12fba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129006"
      ]
    },
    {
      "uid": "zhcn:54bc1ee2775eb7fcbc8317d5",
      "kind": "text_data",
      "source_text": "紧紧抓住心灵，她的名字是——",
      "source_fingerprint": "2fc1ed051cb283f09380261dcd9784f1fe9c223e2d3413ddf0679343c83ded8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129007"
      ]
    },
    {
      "uid": "zhcn:aac59e4f1519d68e4977c983",
      "kind": "text_data",
      "source_text": "春日和煦，初露枝芽",
      "source_fingerprint": "92f97dfb9025af16d9616bdc22b3c69d38343999e292462b5632758b36d2b8d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130001"
      ]
    },
    {
      "uid": "zhcn:8d1e8bab33415175cf9cc8a7",
      "kind": "text_data",
      "source_text": "仍是蓓蕾，于威风中摇曳",
      "source_fingerprint": "ec426a0b8d176889660094b50e7f9179f4b5f0ca2165635b04d4720249ed92c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130002"
      ]
    },
    {
      "uid": "zhcn:71baf0aa404b4fa85ad7b3ed",
      "kind": "text_data",
      "source_text": "暮色沉沉，然拂晓终至",
      "source_fingerprint": "9f1ea93f4a6e176e102ad12a36865e9188e731e87cbfb0f35b7808f6c65f8dfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130003"
      ]
    },
    {
      "uid": "zhcn:1d62b16e2e81cd860f27185b",
      "kind": "text_data",
      "source_text": "盛放之紫丁香，当此时节！",
      "source_fingerprint": "b2b4d61a35053d86efa07883d661c1d4d9378f9390540f1853b3b5d1a5221857",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130004"
      ]
    },
    {
      "uid": "zhcn:cae1e1d9f5e4247734786495",
      "kind": "text_data",
      "source_text": "纵然一朵紫丁香，隐于薄云之中",
      "source_fingerprint": "2817ad044dfece4b779116aeda220284d4fe208910a2401ca1e7d030dc12ce49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130005"
      ]
    },
    {
      "uid": "zhcn:ab3046c094bfb26322fb653b",
      "kind": "text_data",
      "source_text": "清风拂过，阳光满溢",
      "source_fingerprint": "efe45c35a700b129faddf04f69257f1439711881e5fe09d0d515d634fcaedce5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130006"
      ]
    },
    {
      "uid": "zhcn:ca1c21574f488a95f65818bd",
      "kind": "text_data",
      "source_text": "笑颜绽放，幸运的一片",
      "source_fingerprint": "64076e52f5b9ed85c0af89eb1010bcdf296702ddd968ad5d7e0aaf0db26da6ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130007"
      ]
    },
    {
