    },
    {
      "uid": "zhcn:0ea24e90490b44e5be880c28",
      "kind": "text_data",
      "source_text": "Augenblick",
      "source_fingerprint": "a39c783491943194633be4bccbbe330d8a8b4c1ae8ece0ed97ca02c8db8d4698",
      "source_path": "text_data_dict.json",
