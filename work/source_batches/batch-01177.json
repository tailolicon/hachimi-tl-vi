  "entries": [
    {
      "uid": "zhcn:dfb075973cb469b3ed9ad1b6",
      "kind": "text_data",
      "source_text": "至少在任务完成之前",
      "source_fingerprint": "e7b49fefbf8400bde943c50028659cb7efff3deb961b98ae4f708ea9d6e33537",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41030005"
      ]
    },
    {
      "uid": "zhcn:53d9662b7aa38c278f2e1ee2",
      "kind": "text_data",
      "source_text": "看清楚了、觉察到了",
      "source_fingerprint": "ab940459af5bb94ae3fc988377633c6a1fb51d5a027f9de249564a15055a367b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41030006"
      ]
    },
    {
      "uid": "zhcn:9803e83819a8901b4ac13514",
      "kind": "text_data",
      "source_text": "我所不知的，自己的角色",
      "source_fingerprint": "13a363ecaf3b03cc538462c996534ed715ce30850bc29173ae2e46d847fe0c5e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41030007"
      ]
    },
    {
      "uid": "zhcn:38140e59939acf4a38fbeea2",
      "kind": "text_data",
      "source_text": "哈喽哈喽！相遇是突然的",
      "source_fingerprint": "c6fe8a62bcea833a1e559ef606b73974e9c74e3f9e0c855e96fdafdbc9a11964",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031001"
      ]
    },
    {
      "uid": "zhcn:3d2c27ccb4a4678e0f0e8cc0",
      "kind": "text_data",
      "source_text": "心情激动！只有前方绝不让步",
      "source_fingerprint": "f0e0ce9725262ac59899d4326d8ea05306f4abef10c86471633403865e1ec67c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031002"
      ]
    },
    {
      "uid": "zhcn:da44cc87a712c6be1ce84d19",
      "kind": "text_data",
      "source_text": "奋力向上！跟我一起变强",
      "source_fingerprint": "1fe9262eea96a26b1450094523b748a67dd84f9245e2bce1891a327098916094",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031003"
      ]
    },
    {
      "uid": "zhcn:0ea99d4633b9d900f644601e",
      "kind": "text_data",
      "source_text": "闪闪发光！你就是训练员",
      "source_fingerprint": "5205e52884aee5fc8d1b10a989e5e9fc9bccdd76fbac183a98bd92b0b74cb756",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031004"
      ]
    },
    {
      "uid": "zhcn:5ddfa418727eed40b26244f0",
      "kind": "text_data",
      "source_text": "手忙脚乱！房间扫除",
      "source_fingerprint": "74740ea8876758573af3e11d0a61b0155c84de955affaa248dab1114825b39f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031005"
      ]
    },
    {
      "uid": "zhcn:3e7a7120b322eba52d3048f3",
      "kind": "text_data",
      "source_text": "心跳不已！跟你一起过休息日",
      "source_fingerprint": "e4334b3d71ea78afdb9b319ac2010bf6856ee578b6280ad7fe71750571b1114f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031006"
      ]
    },
    {
      "uid": "zhcn:9779f24ffceba55ec98b747c",
      "kind": "text_data",
      "source_text": "约定好了！今后也同你一起！",
      "source_fingerprint": "47c30fa0775d4cf7239a38166df3dbab66325a95336645417f30f1eabd25821d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41031007"
      ]
    },
    {
      "uid": "zhcn:1cc5216225c7df2639dddecd",
      "kind": "text_data",
      "source_text": "蔡格尼克记忆效应",
      "source_fingerprint": "24008fdecdb988af0d4f83f0df4d4d88ab176cf771ad0e2f20f59ffa5fde3f69",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032001"
      ]
    },
    {
      "uid": "zhcn:823ded8a575a4d447aabecaf",
      "kind": "text_data",
      "source_text": "戈尔迪乌姆之结",
      "source_fingerprint": "034f0c20b97335fe91bd26f73a051af71608468f0cc8b04680ca5fb9402ec357",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032002"
      ]
    },
    {
      "uid": "zhcn:be1ac52c774aeeba40424283",
      "kind": "text_data",
      "source_text": "事件视界",
      "source_fingerprint": "6bfe09cf438640b8460585015ff0fbf1b26f43e85b1ae91c55fa9cf8cbba8dfb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032003"
      ]
    },
    {
      "uid": "zhcn:08424e27cdbe7a1d706c1236",
      "kind": "text_data",
      "source_text": "速子",
      "source_fingerprint": "50f277808d2405466dae946fbc80d44bf1078fb66b582f89ee2b7e0968c9a654",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032004"
      ]
    },
    {
      "uid": "zhcn:b186acb365e61e4353a34bf4",
      "kind": "text_data",
      "source_text": "问・梦境抑或现实？",
      "source_fingerprint": "d275cd45b3edc7ead82f7819dfe7148f82fafd4fd81daba06c2a44f073f56c32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032005"
      ]
    },
    {
      "uid": "zhcn:185318d5aa8a6a437cb80a8f",
      "kind": "text_data",
      "source_text": "问・营养抑或正餐？",
      "source_fingerprint": "6d1ff56552f8d5a5bae3a993dbe4d35434e73960a376e78d3a1d01be637289aa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032006"
      ]
    },
    {
      "uid": "zhcn:741426bece93b009b3fea465",
      "kind": "text_data",
      "source_text": "问・实验体抑或同伴？",
      "source_fingerprint": "f21f3d1e2d371a8fd847e00f3f51048492b41ce246a74c9c11b0d8f2e0799061",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41032007"
      ]
    },
    {
      "uid": "zhcn:0bbe55657243772c1b84f47c",
      "kind": "text_data",
      "source_text": "辉煌的新星",
      "source_fingerprint": "7c26a0d90144e01e741fe51780264909130c792913900579bedd2318f50006da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033001"
      ]
    },
    {
      "uid": "zhcn:4eb1c79abb0281cbfe3bb136",
      "kind": "text_data",
      "source_text": "残缺的双子",
      "source_fingerprint": "195f8a09b0d5c641491377e9edab197caf12f673c3eea77b72c1d1fa9c941c98",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033002"
      ]
    },
    {
      "uid": "zhcn:01afd959f8c6e8f6b6b0b597",
      "kind": "text_data",
      "source_text": "被光芒侵蚀殆尽",
      "source_fingerprint": "9c94343ea3ed12d4ebf2688fbfe706a40cbce657e1518cbeaf72e1bed4d92cb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033003"
      ]
    },
    {
      "uid": "zhcn:1373e2df021f527f905d8140",
      "kind": "text_data",
      "source_text": "致以彗星的你",
      "source_fingerprint": "fb6edeecfc4302b5b9bd57fb50722a0b2c626ccfd0c48fd666491acf124449ec",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033004"
      ]
    },
    {
      "uid": "zhcn:d4863d9a470218c3aaee40f1",
      "kind": "text_data",
      "source_text": "在闪烁的夜空下",
      "source_fingerprint": "c62b2735441557856b9110afd41781f7f51a0e965f49bdb0a31d0e6564084028",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033005"
      ]
    },
    {
      "uid": "zhcn:1636e2acf79b90e059583b95",
      "kind": "text_data",
      "source_text": "宛若畅游于星海",
      "source_fingerprint": "6b5e03e30be069d01242570ce918fd1e55f899ba20ac7d2b6b1a2cef86c624ae",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033006"
      ]
    },
    {
      "uid": "zhcn:6b1aaf5875c453aca7fed2d1",
      "kind": "text_data",
      "source_text": "架起跨过星河的天桥",
      "source_fingerprint": "ee70b6141a87acddd68774ff8ab3679e65e0c7c0b868c4aa895ee8ea886a9918",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41033007"
      ]
    },
    {
      "uid": "zhcn:55e64c8d1bb596ae476f5488",
      "kind": "text_data",
      "source_text": "我是江户之子！",
      "source_fingerprint": "18167c0aa5b4bb2be26f1cf587332466607ca6fd674775071e4dc48a7351f88e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034001"
      ]
    },
    {
      "uid": "zhcn:32f18dec278097eeb135fd1c",
      "kind": "text_data",
      "source_text": "潇洒又豪迈",
      "source_fingerprint": "09e8899dad9b1be473cfeffdde77e1320fb23509ea8831211ea2aa55dbc4daa0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034002"
      ]
    },
    {
      "uid": "zhcn:b35e18575c116f0e3a6e8f74",
      "kind": "text_data",
      "source_text": "内心产生了变化",
      "source_fingerprint": "ec3826ace1745cb7f39ad2c0b7e05959e9d09e879ee58b4c0d6dd865f84011ff",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034003"
      ]
    },
    {
      "uid": "zhcn:f220a44729edd1ed1aad4a39",
      "kind": "text_data",
      "source_text": "我会大放异彩",
      "source_fingerprint": "5b9e532c9be2e401a312c08865aa29e24b2eb615a56ab044e1e8027ab2fb8f12",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034004"
      ]
    },
    {
      "uid": "zhcn:2b5f76ec2dfeb3112140ffb0",
      "kind": "text_data",
      "source_text": "总有一天会让江户之花绽放！",
      "source_fingerprint": "89d8d00a7ff93dc2cd1c8aad0b2c1080dfbac7d0d4c760b8e394274117d7f2c0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034005"
      ]
    },
    {
      "uid": "zhcn:8ebbbb9922f09c26d770c3de",
      "kind": "text_data",
      "source_text": "包在稻荷大人身上吧！",
      "source_fingerprint": "6347a688fe5d8016c6bda57737c127241fcd1240bb61e576f94d76a6405afae1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034006"
      ]
    },
    {
      "uid": "zhcn:c56558e7e413ad26598ede78",
      "kind": "text_data",
      "source_text": "对着盛大的烟火欢呼！",
      "source_fingerprint": "aec56941342015992f1049211afbf02bccff58140e6e1a700a12e731441ccc65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41034007"
      ]
    },
    {
      "uid": "zhcn:46be8d23d1349666b1e7bafc",
      "kind": "text_data",
      "source_text": "如果要全力朝德比迈进的话",
      "source_fingerprint": "a84707d8efe2572743617ed48757838736b574f72e754b4f411bb5d3077b0bc0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035001"
      ]
    },
    {
      "uid": "zhcn:b77924b0882a0cf45c69e324",
      "kind": "text_data",
      "source_text": "因为那天让我看见了梦想",
      "source_fingerprint": "0331535e935cec6349b9f33027fdd88af5f72d564d66543051a441cd9d554225",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035002"
      ]
    },
    {
      "uid": "zhcn:b2eb197279bada4c481f6c38",
      "kind": "text_data",
      "source_text": "基本为务实地一步一脚印",
      "source_fingerprint": "327620dfd415575cf4e0df983c5fd618a6bf2346ea02481362f22288eda7a765",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035003"
      ]
    },
    {
      "uid": "zhcn:9fdaefdf2b4ed9253b6e38a4",
      "kind": "text_data",
      "source_text": "两人都能全力奔驰",
      "source_fingerprint": "6ae772a2c7b273eab98b0d0f662dafad3ee717d98a4306a627f2bcdd3dfd83ba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035004"
      ]
    },
    {
      "uid": "zhcn:7799207d80a59a21f7df12e6",
      "kind": "text_data",
      "source_text": "因为是你为我指引的道路",
      "source_fingerprint": "c7fc3be6987ff04de3e67409eecfcaaebdda6b995066b27e30d6e57829acf743",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035005"
      ]
    },
    {
      "uid": "zhcn:588c9151578863854377c951",
      "kind": "text_data",
      "source_text": "那份感动，就在这里",
      "source_fingerprint": "96154c49153d158984666107247a912a12b2fd2396ec2fd8224f7561e5416943",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035006"
      ]
    },
    {
      "uid": "zhcn:fd1ac54cf2b96aec7c7ff226",
      "kind": "text_data",
      "source_text": "若你『全力』闪耀光辉",
      "source_fingerprint": "c582f0fef91a9b46190e202d43805710a56a909e94bcef9b4c19db0f1339a1af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41035007"
      ]
    },
    {
      "uid": "zhcn:c2733b69d90d0c261e1f273f",
      "kind": "text_data",
      "source_text": "脉动着的算法",
      "source_fingerprint": "3b4633a0a924cdb8e9762c9ec7a0653cb0dc0dea36439e564299c593950be08c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41036001"
      ]
    },
    {
      "uid": "zhcn:eaf2b23856194a53f287e784",
