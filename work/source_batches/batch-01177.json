      ]
    },
    {
      "uid": "zhcn:ea36f18ffea6a4c8d8028b19",
      "kind": "text_data",
      "source_text": "可爱的冲击",
      "source_fingerprint": "17d9ef51c9b70a3daeded8d62c031bcbd3b02b8d93693e6c65ff7c868633dc32",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038001"
      ]
    },
    {
      "uid": "zhcn:d41a22e8833df79e83e04375",
      "kind": "text_data",
      "source_text": "可爱的未知",
      "source_fingerprint": "4dbb0f585613ffc457d137289d3aefbabdb1386cd6ac4bd4c867059dc2c4e383",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038002"
      ]
    },
    {
      "uid": "zhcn:079412dadad8970331a2c80c",
      "kind": "text_data",
      "source_text": "可爱的失踪",
      "source_fingerprint": "809701ded63e25ff18edd480ac21853062c712480cc67efab9f61ffeb6a7999c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038003"
      ]
    },
    {
      "uid": "zhcn:ffba6961d199f20f1b458f07",
      "kind": "text_data",
      "source_text": "可爱的宇宙",
      "source_fingerprint": "c7704774711471dab838e5b05c2bd0cd640d64b3c8e41e7141061d1208f3ee7a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038004"
      ]
    },
    {
      "uid": "zhcn:2eb39e666f70c30dcaa19b9f",
      "kind": "text_data",
      "source_text": "可爱的本质！",
      "source_fingerprint": "a9e8401155c5e8c47e31966c9b0f8670b0549cd92ca742abb8a0519dd87967d0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038005"
      ]
    },
    {
      "uid": "zhcn:4fe0a0f06f15baf6544d62ac",
      "kind": "text_data",
      "source_text": "可爱的秘密？",
      "source_fingerprint": "e4109cdfebfc7a1f95640c045687cb934199000ae91a2bf5afe67c9880ddd576",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038006"
      ]
    },
    {
      "uid": "zhcn:fce2daf1a01ab79e7300af5d",
      "kind": "text_data",
      "source_text": "可爱的必然",
      "source_fingerprint": "c851899d1e7322caea3e9fe0eaaeb87dcdf179e258982e5af9713716978bd7f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41038007"
      ]
    },
    {
      "uid": "zhcn:af1e8718467952d4e5e8c84b",
      "kind": "text_data",
      "source_text": "助跑跳后的大危机！",
      "source_fingerprint": "c0887817090903c6396e7c0215742055a37722adf9ba1ef6f4237b1bb777801c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039001"
      ]
    },
    {
      "uid": "zhcn:0d41e2711863403095842d2a",
      "kind": "text_data",
      "source_text": "闪闪发光令人憧憬的身姿！",
      "source_fingerprint": "d4bfe8501a0a2ed1b729dccebdb281a44b50adf9513733dac2276aa4c27412e0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039002"
      ]
    },
    {
      "uid": "zhcn:3d7bea5a5450097d5f263f78",
      "kind": "text_data",
      "source_text": "公主猛烈修行中！",
      "source_fingerprint": "b8da6766ef1168517a6ea9bc250b283e242db682ccfce8d72787a70ce66d9928",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039003"
      ]
    },
    {
      "uid": "zhcn:eb7db5045a82741e397375fe",
      "kind": "text_data",
      "source_text": "我才是公主陛下！",
      "source_fingerprint": "13873f15801b7300e7e542b0dbff4011fcc38e9cc17d56ebb43423a03aa4ce50",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039004"
      ]
    },
    {
      "uid": "zhcn:b1752fb3c333ee5b57df8ba9",
      "kind": "text_data",
      "source_text": "黑暗公主出现！？",
      "source_fingerprint": "1a61e96594eabbbafc3021077b52f6fa50fea01ff5abd8f4c5a772d9f62e210a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039005"
      ]
    },
    {
      "uid": "zhcn:7f6ea295af698763ca75c378",
      "kind": "text_data",
      "source_text": "真正的牵绊是指！？",
      "source_fingerprint": "5e15fe57dc06752c685fd6ab2fe1f562508bac2f3efefd25be1579a229bd0748",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039006"
      ]
    },
    {
      "uid": "zhcn:dd4697cdfc6e16415d68d358",
      "kind": "text_data",
      "source_text": "公主与王子殿下的牵绊！",
      "source_fingerprint": "ab3a1de0edebad0d51b4012a4ea360d22b1c8fdcea54100996f18e9aba86fde3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41039007"
      ]
    },
    {
      "uid": "zhcn:0b2d4968310762e216838d72",
      "kind": "text_data",
      "source_text": "尾花栗毛，随风起舞",
      "source_fingerprint": "5270c81cc1de40a4913cb1fd0bbcf74d3a58fcac5dc462721ae931d2c2a71001",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040001"
      ]
    },
    {
      "uid": "zhcn:847d1bf366a2f56925f876be",
      "kind": "text_data",
      "source_text": "心如鼓雷",
      "source_fingerprint": "7c7aff51e4e40eaa445275a85dde6eea79d02a2bf825219959b7f0d61be445a6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040002"
      ]
    },
    {
      "uid": "zhcn:87ab2877db046ea32822436c",
      "kind": "text_data",
      "source_text": "激昂，而后心碎——",
      "source_fingerprint": "a1af3e053b8dfa85d7942eb8841e337b56b5bd9eeb5a3d325bb6a71c4ac39a4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040003"
      ]
    },
    {
      "uid": "zhcn:712d6942102e549ff1e81b3e",
      "kind": "text_data",
      "source_text": "为了寻求“真我”",
      "source_fingerprint": "70a05769d81240279904c2dce0a8902d93fdc2628f835e2cde6e892d217eae70",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040004"
      ]
    },
    {
      "uid": "zhcn:3d6b47599650410384ccc062",
      "kind": "text_data",
      "source_text": "不适合我的职业",
      "source_fingerprint": "1a962213cb0179cfea4ca42061090e9262409da447e9e5450b06fa14466c6db9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040005"
      ]
    },
    {
      "uid": "zhcn:fe2de7e3ce11093ecfaf66d8",
      "kind": "text_data",
      "source_text": "两全其美什么的，也不是不可能",
      "source_fingerprint": "a4c421afba8ce78253d5db1358d6d1958a35ed8fffcffe8093913c9f8a25c947",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040006"
      ]
    },
    {
      "uid": "zhcn:b64b7cd0c67ea05a51eb90ec",
      "kind": "text_data",
      "source_text": "传递而来的心意，亦是我的力量",
      "source_fingerprint": "4cc4d7e98990117851118c570a3e15a7ef08c8563aecf8dc75d6a1ab715281d5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41040007"
      ]
    },
    {
      "uid": "zhcn:79818bee13f67edb1f61f75f",
      "kind": "text_data",
      "source_text": "爆进！　班长！",
      "source_fingerprint": "157e0f83b3cd11999eae04e0ea40803dbdce723fd05dfb2f7344e5f12947d15c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041001"
      ]
    },
    {
      "uid": "zhcn:fbc81eecdf3b1b18923955f4",
      "kind": "text_data",
      "source_text": "爆进！　模范马娘！",
      "source_fingerprint": "950f75e4d1691225ef3f8083fcb451af549905075c1b33824ebcd77577a646f7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041002"
      ]
    },
    {
      "uid": "zhcn:c706700dc7b22d0069b7982a",
      "kind": "text_data",
      "source_text": "爆进！　胜利的秘诀！",
      "source_fingerprint": "99b3817adcd8d6af58abe020f928fe56ed288e4df4a85c08a1ae9fee7766c384",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041003"
      ]
    },
    {
      "uid": "zhcn:9b39ed05133e9c13a7b92cca",
      "kind": "text_data",
      "source_text": "爆进！　压倒性的速度！",
      "source_fingerprint": "d8f39bf39f5c5439fa49f5793b383c0f837885010613274beb09d2740e37f092",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041004"
      ]
    },
    {
      "uid": "zhcn:3bcaa4500d1ea6caa6f8e641",
      "kind": "text_data",
      "source_text": "爆进！　大胃王比赛！",
      "source_fingerprint": "8cce5c218ac80e97b49cfc183449679ef645c80fb8a5695f88397652ba91c397",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041005"
      ]
    },
    {
      "uid": "zhcn:440099eeeaf6b0e8cc4d25d2",
      "kind": "text_data",
      "source_text": "爆进！　购物！",
      "source_fingerprint": "7dea4667ad13d8e9a54bf22976913ce5543ff02a82d9ade821c53bcbd2e9cf19",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041006"
      ]
    },
    {
      "uid": "zhcn:ff901f638975858d01c6483f",
      "kind": "text_data",
      "source_text": "爆进！　夏日庆典！",
      "source_fingerprint": "d400a103f2f4d09c9787f884ef675abe4fdd6f43e03d539f1a04fe110697f82e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41041007"
      ]
    }
  ]
