        "41060003"
      ]
    },
    {
      "uid": "zhcn:70f60900d4e8a57adc341e41",
      "kind": "text_data",
      "source_text": "说一次『就算如此』吧",
      "source_fingerprint": "1bc0721750b4e2866ff4f3a179ab1e45634236eb5ed8fb7edbc0fb9945b40ac0",
      "source_path": "text_data_dict.json",
