        "41060001"
      ]
    },
    {
      "uid": "zhcn:6062be6c789691dfb0bc610c",
      "kind": "text_data",
      "source_text": "怀旧系赛马娘",
      "source_fingerprint": "7a24659027aa7adf7b5ff9b683526f34d0680202bea7023575d95980030b9367",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41060002"
      ]
    },
    {
      "uid": "zhcn:554c3b59def6ebb2639f35ef",
      "kind": "text_data",
      "source_text": "无法触及的前方",
      "source_fingerprint": "31ec6dc4c9997956abd7cf8f63d6ce585da996faa73024b2bbad50924afa645a",
      "source_path": "text_data_dict.json",
      "json_path": [
