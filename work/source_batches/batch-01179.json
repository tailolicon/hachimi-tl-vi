      "kind": "text_data",
      "source_text": "能战胜我的“对手”",
      "source_fingerprint": "a4f1b4577a27e86ba0ac9a5128ee5d8c6946375ee931054faf001a5186f24b89",
      "source_path": "text_data_dict.json",
