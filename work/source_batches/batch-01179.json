      ]
    },
    {
      "uid": "zhcn:af60fe4eca11189e70daf078",
      "kind": "text_data",
      "source_text": "菊花赏",
      "source_fingerprint": "ba5957c536c5db401a05ece6074696f3dce0e0a3f84f5dd89612a140c68e0a6d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "407"
      ]
    },
    {
      "uid": "zhcn:00abbb90b7c4bdd08744a876",
      "kind": "text_data",
      "source_text": "姐妹的约定",
      "source_fingerprint": "977262fa265756718c1456e3d1dcd11742cbce814a8418d57a032cc3ca3b5349",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "408"
      ]
    },
    {
      "uid": "zhcn:4cedfa5f99c201a6931e58f9",
      "kind": "text_data",
      "source_text": "不停渴求的心　有马纪念",
      "source_fingerprint": "b48183b673b0453598dd5c274f0b1d3b6854fc939f507c6f1361e9532a330991",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "409"
      ]
    },
    {
      "uid": "zhcn:2bfb10348b09cbf2d75cea8c",
      "kind": "text_data",
      "source_text": "永无止境的渴望",
      "source_fingerprint": "55ac56003c397dad343a8d7ad0921c1004dd32b457008ccb7acf95647cf1a354",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "410"
      ]
    },
    {
      "uid": "zhcn:f20b72a7e3cf0d6761bce180",
      "kind": "text_data",
      "source_text": "不会屈服的心",
      "source_fingerprint": "0cf3db5b5ecc568f1a0d571cc3bf030f620188525b2c24be1a58d02c3acd1c27",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "411"
      ]
    },
    {
      "uid": "zhcn:3a133336b642d70996cc2260",
      "kind": "text_data",
      "source_text": "痊愈后的训练",
      "source_fingerprint": "20d7ba697fca74956e8d2e34f346e59b724748002c069a60f1bc29b35b7f2cf0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "412"
      ]
    },
    {
      "uid": "zhcn:8da78a37b1814256d2214741",
      "kind": "text_data",
      "source_text": "逐渐改变的期待",
      "source_fingerprint": "8a3231f422a449907de5442a509ecab3dd1fba822ca9e716566cee402d6cde53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "413"
      ]
    },
    {
      "uid": "zhcn:f8436aa0d5efc6d0b28077b9",
      "kind": "text_data",
      "source_text": "不变的愿望",
      "source_fingerprint": "b8b4c95b6bcdbf8ca66d3af6e4b18d07906763a30767299d69e08e2a00c2be34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "414"
      ]
    },
    {
      "uid": "zhcn:d5450f30cf29ca9f841b0491",
      "kind": "text_data",
      "source_text": "对胜利的渴望愈发强烈",
      "source_fingerprint": "74aace08fa0f9a3c6a8a858f8ff2a4a5308e7a483f9118e1951de669543885b9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "415"
      ]
    },
    {
      "uid": "zhcn:8ead169a439d9bfcd7c5ab36",
      "kind": "text_data",
      "source_text": "永不褪色的记忆",
      "source_fingerprint": "4d811b5904f4e8c3463ee5d310df3d8e482d5953546ea9fbc5b5145251b80ba3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "416"
      ]
    },
    {
      "uid": "zhcn:1e245adb904c6b3a225ec3bc",
      "kind": "text_data",
      "source_text": "烈火",
      "source_fingerprint": "2578226955fb6e9280da5a9ff9a601ff3e6f32f74956199e557bf50b672f1f2b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "417"
      ]
    },
    {
      "uid": "zhcn:8f6bf14c1457cef419d9e63a",
      "kind": "text_data",
      "source_text": "雀跃之心",
      "source_fingerprint": "c5f377e0d4eb6fae360400ac25366e021be9bc107a320bba3430786043402b62",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "501"
      ]
    },
    {
      "uid": "zhcn:5bd554d528306e6b44a73d93",
      "kind": "text_data",
      "source_text": "我的比赛",
      "source_fingerprint": "d0adeec9b1c743d5d1178a0126fdb22e7c189f518dd7ea2bc8f447b997e18ece",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "502"
      ]
    },
    {
      "uid": "zhcn:34ba44eaa6a849793695dad8",
      "kind": "text_data",
      "source_text": "追寻梦想的两位赛马娘",
      "source_fingerprint": "49c6ac8e63b3b63d289e7d92697402dca61b93c27d91b4eb0d209549697c87d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "503"
      ]
    },
    {
      "uid": "zhcn:5aa317cbeab6f66435f136d4",
      "kind": "text_data",
      "source_text": "主角锦标",
      "source_fingerprint": "66c712571ec2688d6d07560e75685246073470a9eaf34cd3144a314ffee47202",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "504"
      ]
    },
    {
      "uid": "zhcn:78bdd25f0116498f24879f61",
      "kind": "text_data",
      "source_text": "渐渐朦胧的“景色”",
      "source_fingerprint": "3c1be162c5241a0f70580e30ddffe818ca0e3a45646a5b7ff31545fd1d394475",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "505"
      ]
    },
    {
      "uid": "zhcn:4393351bbd5460b8db08d7eb",
      "kind": "text_data",
      "source_text": "随心所欲",
      "source_fingerprint": "611b70eb2fdc3da371f679326e37c806ee9aebad5019ffdcfc030d955fc078f3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "506"
      ]
    },
    {
      "uid": "zhcn:5ed8b3da3a7e21597df306c9",
      "kind": "text_data",
      "source_text": "向着梦想共同努力",
      "source_fingerprint": "4e2e73290c6089cb0a991924e0cd9b47bc75f7d0cb50679a0abd95beb1b8b789",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "507"
      ]
    },
    {
      "uid": "zhcn:30f827dda9e5803d487e0a8a",
      "kind": "text_data",
      "source_text": "团队练习",
      "source_fingerprint": "094c2b78706f835419351992954b915b6f29bc4ba245cb21425bc57c1fe6de7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "508"
      ]
    },
    {
      "uid": "zhcn:c5c58156c54d424b26e55763",
      "kind": "text_data",
      "source_text": "梦幻一般的“景色”",
      "source_fingerprint": "9fa730121928090f9d64f077dac4a755119ca12f376fb828e2a53761b22d8f9d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "509"
      ]
    },
    {
      "uid": "zhcn:043afae90bd3340271bed215",
      "kind": "text_data",
      "source_text": "永不停歇的梦想",
      "source_fingerprint": "049f94c811b3300e99be5d5d2ebb3081efd5b8bff6bf5b6bdda8367b0678f29a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "510"
      ]
    },
    {
      "uid": "zhcn:90fe10dfb9cb3caa670a40f5",
      "kind": "text_data",
      "source_text": "逐梦竞走",
      "source_fingerprint": "aacecd50a06eaebeaa556934434efd1925b6c26730c0737e0879da30873d87de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "511"
      ]
    },
    {
      "uid": "zhcn:86a863e549522794c50d6b2e",
      "kind": "text_data",
      "source_text": "可预见的未来",
      "source_fingerprint": "7aec761304f64cb660039868480f35fc926095275ce0dc9b820a6921e991181f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "512"
      ]
    },
    {
      "uid": "zhcn:cf169a5d80783c0c4b83b575",
      "kind": "text_data",
      "source_text": "挥之不去的忧虑",
      "source_fingerprint": "1e8a9db879cdac223c71767e0bcb8f50e7a89b440fbf99201ef28e9351ac8dc9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "513"
      ]
    },
    {
      "uid": "zhcn:6a96517e4ebb87aa0593f8ee",
      "kind": "text_data",
      "source_text": "渐趋膨胀的不安",
      "source_fingerprint": "861f628fc495072e31ff7dd425ed7dbc3eeb418be86050e70939be8a7d8bdf35",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "514"
      ]
    },
    {
      "uid": "zhcn:b7ef54d6f463b9a21a9d0a15",
      "kind": "text_data",
      "source_text": "背负着“思念”的“赛马娘”",
      "source_fingerprint": "1b83ff95c2f1cfc92790aaa6adab1c4232a64874abd3e5febbd7ed2a669f0a8d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "515"
      ]
    },
    {
      "uid": "zhcn:126b9c9bf3220f58a592b5b4",
      "kind": "text_data",
      "source_text": "信任的思念",
      "source_fingerprint": "0486e55b15c078024c5f850b568c6e80dbe05320b876b18351165bc3ac2858c8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "516"
      ]
    },
    {
      "uid": "zhcn:085ec489fc0c03a889994051",
      "kind": "text_data",
      "source_text": "曾追寻的“景色”",
      "source_fingerprint": "9013565d56ad2ca139026184b4db41f8af8ddec68fa1014919084a684fdca376",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "517"
      ]
    },
    {
      "uid": "zhcn:30a2b413cbde96360249bbb4",
      "kind": "text_data",
      "source_text": "以超大的梦想为目标！",
      "source_fingerprint": "8532a498c7ed12014ce79df42b64abb7ece388a86d0a90fb4912735163f14ef7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "601"
      ]
    },
    {
      "uid": "zhcn:7c9e5efb9b447532d2bef1d6",
      "kind": "text_data",
      "source_text": "为了妈妈们！",
      "source_fingerprint": "f7d3717609aca80f48d9f8646183ea92097434e255887048bdb6b0a04b41bd7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "602"
      ]
    },
    {
      "uid": "zhcn:443603308fc5c51dadeb228c",
      "kind": "text_data",
      "source_text": "弥生赏",
      "source_fingerprint": "13948e034c85c124b0b187e6d940616b1e7f914dfb9c51fe596cd1e2c57a7666",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "603"
      ]
    },
    {
      "uid": "zhcn:fb223603201bacf12f61a942",
      "kind": "text_data",
      "source_text": "陌生的挚友们",
      "source_fingerprint": "e75bd2592b49d421b14380d4684c459d323dd438fce61847d2a74e67da5186d7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "604"
      ]
    },
    {
      "uid": "zhcn:89e828d6b7fbb60b255d2137",
      "kind": "text_data",
      "source_text": "胜者一定是我",
      "source_fingerprint": "2625a9a83fc63559b556245e4b82df90a131cab7c0ba3e5f218232e64dbfb8b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "605"
      ]
    },
    {
      "uid": "zhcn:09974e1485d8303d662654a1",
      "kind": "text_data",
      "source_text": "众人皆有我独无",
      "source_fingerprint": "66b30014034675f7105cfcb09bf7b56e0c1205bb26f0b9951903881397abc9ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "606"
      ]
    },
    {
      "uid": "zhcn:1405de06fb0a1b256c0b6091",
      "kind": "text_data",
      "source_text": "思绪万千！日本德比！",
      "source_fingerprint": "d358be77f053ffe307ba4a8f2dc5998e6d349b9eba168b110d8b4f5edd185d30",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "607"
      ]
    },
    {
      "uid": "zhcn:c0e5506c77f8f54306a649bf",
      "kind": "text_data",
      "source_text": "日本杯",
      "source_fingerprint": "fcaee3561f6713c9b9198a833a7839ed1d1b48a4ebc0d4117a1a8a430c007453",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "608"
      ]
    },
    {
      "uid": "zhcn:6c6022952c462a8235d2a4fa",
      "kind": "text_data",
      "source_text": "充满决心的新年",
      "source_fingerprint": "c5d1020710e59f083b593bbdd6764d705112ab9c7866fd71393471664197d6a9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "609"
      ]
    },
    {
      "uid": "zhcn:e018d817f779a995cef8ba78",
      "kind": "text_data",
      "source_text": "朝着各自的梦想——",
      "source_fingerprint": "3958ffb453894ac094bc42668b866b3dc6c69e933240e3217eb84fe172bb049b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "610"
      ]
    },
    {
      "uid": "zhcn:b1ad9779fcca2a1fab8a8806",
      "kind": "text_data",
      "source_text": "这是……什么意思……？",
      "source_fingerprint": "ef577735d2e6350e5cad325d70cee678da8128e81e356b8de1b378bd0c263615",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "611"
      ]
    },
    {
      "uid": "zhcn:20072cf8e4c8275c0cab7ad1",
      "kind": "text_data",
      "source_text": "你的启程之日、我的挑战之日",
      "source_fingerprint": "c9ebc440c4d1cdc3bba8c09217164713b9bdb1786b88b8cee24b92dd3b89f2e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "612"
      ]
    },
    {
      "uid": "zhcn:22060d408e2bd85ed4a50b6a",
      "kind": "text_data",
      "source_text": "阪神大赏典",
      "source_fingerprint": "bd4923c9df829fbd6ed7ecfa2840a128c56931e89b7323307c8a6baad8971358",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "613"
      ]
    },
    {
      "uid": "zhcn:9b5abded35a4cbd2dc5a49db",
      "kind": "text_data",
      "source_text": "请让我一并背负",
      "source_fingerprint": "3969f1be9d1aa3c2b7fb5b83f5feb9cedb86ded67f58de55e48fcd2e3f2dd9e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "614"
      ]
    },
    {
      "uid": "zhcn:607dfee511384cd1833665aa",
      "kind": "text_data",
      "source_text": "特别的比赛",
      "source_fingerprint": "d6db930a7a0cdda258ab58f0df15d924271f66c8901015a318da20041e563bbb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "615"
      ]
    },
    {
      "uid": "zhcn:c7974ed2853b36aa3eaf26e4",
      "kind": "text_data",
      "source_text": "模拟赛",
      "source_fingerprint": "ee11f0c35f1bafa9606f65aa3fa17b778e7432ce794afdf446b02ff3edf03eb8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "616"
      ]
    },
    {
      "uid": "zhcn:3bba11c0acbfb446df9bc883",
      "kind": "text_data",
      "source_text": "化信念为力量！天皇赏（春）！",
      "source_fingerprint": "e585ac1d48c30cc9eac77e216d20594fe5ae7368357668ba7a95a43e40e749af",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "617"
      ]
    },
    {
      "uid": "zhcn:1e76af21e8d9ff9c08ad8a1e",
      "kind": "text_data",
      "source_text": "梦想就在不断追逐的更前方！",
      "source_fingerprint": "be2eda1deb4baf8a1e896f60998dfc5fbc3d3aa03c5b2bb25d36eda299fea626",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "701"
      ]
    },
    {
      "uid": "zhcn:1080aa602a62f0b3aacc13d5",
      "kind": "text_data",
      "source_text": "我所想要成为的模样",
      "source_fingerprint": "c4110f4ad5c2da0b5bc9ff0878ad3b02efda08ab690e6bd63b81f2d02245cba6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "702"
      ]
    },
    {
      "uid": "zhcn:43dceae89b75fb8a4be8363f",
      "kind": "text_data",
      "source_text": "团队练习",
      "source_fingerprint": "094c2b78706f835419351992954b915b6f29bc4ba245cb21425bc57c1fe6de7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "703"
      ]
    },
    {
      "uid": "zhcn:f3adf6886db1ebc5f99fa991",
      "kind": "text_data",
      "source_text": "登峰造极之路　宝冢纪念",
      "source_fingerprint": "c2af17ce76a96bc9b4754c022dbea74fedb8b0f43650819e0c57dde2b0251a8c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "704"
      ]
    },
    {
      "uid": "zhcn:f17337928bf53becaeb610b5",
      "kind": "text_data",
      "source_text": "通往世界最强的舞台　凯旋门赏",
      "source_fingerprint": "9799fbc5b60edd9b64d5a9219614458184ec9fb82a4038c0a66955195e4fd19b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "705"
      ]
    },
    {
      "uid": "zhcn:8fdf94c93cd201767ea68b07",
