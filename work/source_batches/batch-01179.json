        "41059007"
      ]
    },
    {
      "uid": "zhcn:c0d4e912e771695a4651ce91",
      "kind": "text_data",
      "source_text": "你好呀，我是庶民派哦~",
      "source_fingerprint": "f1383bf017e2daf5589477039beb20586ad1db99fbf265d1d9f7a7b43566977c",
      "source_path": "text_data_dict.json",
