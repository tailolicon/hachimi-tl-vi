      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41069004"
      ]
    },
    {
      "uid": "zhcn:d37bb55f4069c39a5a2fad54",
      "kind": "text_data",
      "source_text": "所谓青春，即是绚烂夺目的化学反应",
