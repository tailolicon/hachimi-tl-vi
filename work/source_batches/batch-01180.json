      "source_fingerprint": "d932bd9a7fef50861533150e550db928e792ca55463a28ccace048a621036ac5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41070003"
      ]
    },
    {
      "uid": "zhcn:769f22d5a6eca4c778ca764b",
      "kind": "text_data",
      "source_text": "闪耀的天狼",
      "source_fingerprint": "cb27e9c84cdd59c52294e0088e5469146b49ed50ea68d680ee7a76e833ef708f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41070004"
      ]
    },
    {
      "uid": "zhcn:3f370b5fe2e95bf1ce3fd185",
      "kind": "text_data",
      "source_text": "露出獠牙的狼没有主人",
      "source_fingerprint": "37ba1184ad0b69f34f576d5ff57e2e5f9055cd2657accd046a1009fc6148a5cc",
