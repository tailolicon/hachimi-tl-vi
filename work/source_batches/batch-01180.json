      "json_path": [
        "92",
        "41068003"
      ]
    },
    {
      "uid": "zhcn:3a745835ebbb2b7968cdf54d",
      "kind": "text_data",
      "source_text": "这就是庆典之精神！",
      "source_fingerprint": "740c26c8f8216c28638b337ceeb47b38040de5e5e6ead5807248f91c008c55b2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41068004"
      ]
    },
    {
      "uid": "zhcn:f1749e6e481e6c0b5b95d43f",
      "kind": "text_data",
      "source_text": "寂静的夜里响彻的话语",
      "source_fingerprint": "cb7fcbe83c3f0f2a53ad105715725004a679be4e364b0dd99d9f324761518c31",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41068005"
      ]
    },
    {
      "uid": "zhcn:31da9e0569b0f16b082cb1fd",
      "kind": "text_data",
      "source_text": "红叶秀丽的群山啊",
      "source_fingerprint": "7a6a663dea1e7699cf312b3776e48f8c2ecc62086de3cba2dd1f5db97a9cc7eb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41068006"
      ]
    },
    {
      "uid": "zhcn:05e27033e6da633171241f8f",
      "kind": "text_data",
      "source_text": "热闹庆典中的笑颜之花",
