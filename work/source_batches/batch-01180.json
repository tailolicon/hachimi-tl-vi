      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41069005"
      ]
    },
    {
      "uid": "zhcn:96816417f2f38b7c303c3c6d",
      "kind": "text_data",
      "source_text": "所谓命运，即是2400米之外所见的未来",
