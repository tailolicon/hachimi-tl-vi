      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41069006"
      ]
    },
    {
      "uid": "zhcn:7761bcefb1b19ddf00dd39dc",
      "kind": "text_data",
      "source_text": "所谓未来，即是单靠憧憬不可能触及的道路",
