      "source_text": "与宝石的差距",
      "source_fingerprint": "f535bdf20452464a7998689428f849fe2b20f3aaa235dfb01f51f8911add3e9f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41067004"
      ]
    },
    {
      "uid": "zhcn:f0dcb7aea2e929da4cb136bb",
      "kind": "text_data",
      "source_text": "回忆的灵感",
      "source_fingerprint": "26d9cf614596e68702374c2084efa411cbde671743b544c4eb11466cd82b5ab1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41067005"
      ]
    },
    {
      "uid": "zhcn:be6f85257ea1bd58091a1275",
      "kind": "text_data",
      "source_text": "犹疑的纯真",
      "source_fingerprint": "2439ba17a8c9fdae519e15c7a721bdfc429cc6987ec4453b5e35d005af6a59cc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41067006"
      ]
    },
    {
      "uid": "zhcn:8d31ba0162bab6edc874b2fa",
      "kind": "text_data",
      "source_text": "极致的钻石",
