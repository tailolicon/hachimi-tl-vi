      ]
    },
    {
      "uid": "zhcn:d0ab08fbbbf5fe29b0eb7eb2",
      "kind": "text_data",
      "source_text": "真正的派对咖is赞赞的☆",
      "source_fingerprint": "276d5a058de83c61dd622ecf5670677ca4a90201208cf6ee47954342ed46bc4b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065001"
      ]
    },
    {
      "uid": "zhcn:3db5a48b4fbc43fcdeb0bf56",
      "kind": "text_data",
      "source_text": "人生就是越嗨越精彩♪",
      "source_fingerprint": "619b4e9f04c1059fe63115e96955d3c406c3ebaf7b383927c160ad3cdf34ff53",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065002"
      ]
    },
    {
      "uid": "zhcn:870ffafb25d8edcb420dfa5e",
      "kind": "text_data",
      "source_text": "跟着感觉走☆这样才对！",
      "source_fingerprint": "1de2d5059ae423c875374298a0910ce7903013f5e4fefa610682167d8ab76852",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065003"
      ]
    },
    {
      "uid": "zhcn:5062f323228207de2c208372",
      "kind": "text_data",
      "source_text": "看我在闪耀系列赛大秀一波☆",
      "source_fingerprint": "c8a40c54d66e6caeba1e94fe3ead407cc2dcf4be91462d4d7ad788e76f04a57c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065004"
      ]
    },
    {
      "uid": "zhcn:0e2b6a8da2bb2d4ecad805ff",
      "kind": "text_data",
      "source_text": "让气氛由低转高吧──☆",
      "source_fingerprint": "682b205dcbf303c74566db4082cd84a7b497ac57ef478d2658ec42038d640f4a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065005"
      ]
    },
    {
      "uid": "zhcn:7c88450ca04365fcf2e8fff2",
      "kind": "text_data",
      "source_text": "真假！？阿训认真？",
      "source_fingerprint": "342515fe8b66ace0ffd790b7ccd6dcc39e8eebbfa38f368d5e3c242c3d7a0995",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065006"
      ]
    },
    {
      "uid": "zhcn:efe0faddc35832749a54f76c",
      "kind": "text_data",
      "source_text": "庆典最&赞☆",
      "source_fingerprint": "b436e80fcafea1051832a61fa1bc557014e11a61f0bbfa9314fdbb5efab0c7d6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41065007"
      ]
    },
    {
      "uid": "zhcn:70c3c90db8cc6bb2eeb4270e",
      "kind": "text_data",
      "source_text": "上吧！涡轮全开！轰隆隆隆隆～！！",
      "source_fingerprint": "c7940b54bdcacd808d29fccc1eb5ff11905f4c3e5ef66b818bdb1054e957bfaa",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066001"
      ]
    },
    {
      "uid": "zhcn:68546daf32342d2515df5f82",
      "kind": "text_data",
      "source_text": "一决胜负吧，帝王！！唔嘎嘎嘎嘎！",
      "source_fingerprint": "6a9224dc4878d8ea8088be509e9766554d6df3185e8b31480f24c8320e60831d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066002"
      ]
    },
    {
      "uid": "zhcn:18eef7dd0ecfd9132d05e3b9",
      "kind": "text_data",
      "source_text": "脚质？涡轮爱怎么跑就怎么跑！",
      "source_fingerprint": "968878d957f01285fc1dca20a135ac7f63c2fae2fdf2d596ef00d18408ae0ccc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066003"
      ]
    },
    {
      "uid": "zhcn:104623b54c9005585061166b",
      "kind": "text_data",
      "source_text": "锵锵～！沉睡的才能大爆发啦！",
      "source_fingerprint": "ae186e1ed56f8031ec31688d5bc65e13849079ccded246553b3730a63e40b46f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066004"
      ]
    },
    {
      "uid": "zhcn:d03f162777f582e69e55dbc5",
      "kind": "text_data",
      "source_text": "笑容满面！是朝气的源泉！",
      "source_fingerprint": "1f089aeeb745edb877fe0880ac1643dda8cbc9ebf86f3b2c28f22561eee045e9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066005"
      ]
    },
    {
      "uid": "zhcn:15e86e21f71f0b7023f120ad",
      "kind": "text_data",
      "source_text": "什么什么！这是什么感觉！？",
      "source_fingerprint": "9906ef1bc6ff8591f98f4899d9e1461463e935b935ccbde510d3adf866fdff31",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066006"
      ]
    },
    {
      "uid": "zhcn:dbbbb2dc6dcf0c3f19dc8693",
      "kind": "text_data",
      "source_text": "好高兴！好开心！我们一样！",
      "source_fingerprint": "d926f07722184cfb63a06f188cf29acf5a118ea671db8df0c54d1cba11f4f82f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41066007"
      ]
    },
    {
      "uid": "zhcn:b029d97136d4a5343300639b",
      "kind": "text_data",
      "source_text": "天上的钻石",
      "source_fingerprint": "fb99d412f2f6920cbd7d21b2c145adfd22bbecbf813561cf4d5ddcda5c9c37b6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41067001"
      ]
    },
    {
      "uid": "zhcn:a6b8dbb02b1327ee9deff1e2",
      "kind": "text_data",
      "source_text": "意外的邀请",
      "source_fingerprint": "128c910b5d46e63ac4a87898d9c81f3dd64651943d8c223a1f7bf91406f245b7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41067002"
      ]
    },
