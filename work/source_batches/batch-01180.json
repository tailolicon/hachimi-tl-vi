      "json_path": [
        "92",
        "41068007"
      ]
    },
    {
      "uid": "zhcn:36f39fb18c953969272d95d4",
      "kind": "text_data",
      "source_text": "所谓心动，即是最高速运转的心跳",
      "source_fingerprint": "da375cf040e23b642cf9af25c485b68f4995e3dbc7a8e55306046326a4f157f0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41069001"
      ]
    },
    {
      "uid": "zhcn:efe857f599683efaa1551954",
      "kind": "text_data",
      "source_text": "所谓憧憬，即是海一般的感情",
      "source_fingerprint": "7f1a7eb47899244b6af3d00932c480bc23dab409e178def5c3f16bfb1022c279",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41069002"
      ]
    },
    {
      "uid": "zhcn:27526990c4af80f9daff6425",
      "kind": "text_data",
      "source_text": "所谓钥匙，即是潜藏于箱中的宝物",
      "source_fingerprint": "c515fba620fbb9c4ca95611841ce1efc13cb2198bd784edb71e6a220e6fd9455",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41069003"
      ]
    },
    {
      "uid": "zhcn:493b360f9e04d0c049a014c7",
      "kind": "text_data",
      "source_text": "所谓樱花，即是心中绝不凋零的决心",
