      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41067007"
      ]
    },
    {
      "uid": "zhcn:1287c6324b3e142ee657dff6",
      "kind": "text_data",
      "source_text": "助拳大将，大奋斗！",
      "source_fingerprint": "b5aff1ca49d39b77b747e43118db0ba46ed53fe98db86b8a4bc5e580e779eb5d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41068001"
      ]
    },
    {
      "uid": "zhcn:2963973d3ea50f9590fe7de4",
      "kind": "text_data",
      "source_text": "没有特长就只能算是半吊子",
      "source_fingerprint": "5f1dcf027817bc11b5767b364577d0c0e182aeb38d80d8231eb6053004e64dcc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41068002"
      ]
    },
    {
      "uid": "zhcn:6287c853019321e08d6e3e9f",
      "kind": "text_data",
      "source_text": "走吧，踏过那座雪山！",
      "source_fingerprint": "8a30380213f897a715bf2556e9608494912c95df76a07165d851fd746c322a17",
