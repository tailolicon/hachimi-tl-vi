      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41071001"
      ]
    },
    {
      "uid": "zhcn:dcb053533e8ac4298173746b",
      "kind": "text_data",
      "source_text": "凛然而清澈",
