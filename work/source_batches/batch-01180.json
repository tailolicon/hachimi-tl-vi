      "uid": "zhcn:48a9db9a39e32f1594114ba2",
      "kind": "text_data",
      "source_text": "以崇高之物为目标",
      "source_fingerprint": "3cd75f058f99db21296f4aaca926d78efe591627e5b71f9f6ada46d18e1fb71d",
      "source_path": "text_data_dict.json",
      "json_path": [
