      ]
    },
    {
      "uid": "zhcn:14d79d3b2835a31d90e12861",
      "kind": "text_data",
      "source_text": "第8R",
      "source_fingerprint": "8076899b30b0e42ee09b39b7fdae85d789b755bcf8a01b0ac2d7498747c326e7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "96",
        "715"
      ]
    },
    {
      "uid": "zhcn:20a45bed48e762cb4c3e1089",
      "kind": "text_data",
      "source_text": "基础能力已经足够强大了\\n试着获取技能吧。",
      "source_fingerprint": "c5edc1254f97cba926709e7437ed6470d72ea3a085054d6856f038348ad37bf6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "1"
      ]
    },
    {
      "uid": "zhcn:dca4c9aad99fc54b7a48c781",
      "kind": "text_data",
      "source_text": "根性似乎有些不足\\n试着重点锻炼一下吧。",
      "source_fingerprint": "8989bdaf060da808c893f9d7c4e55374b7701768c9fc1d28273184164cfb0921",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "10"
      ]
    },
    {
      "uid": "zhcn:53a7cb2f9d4f44820af473c7",
      "kind": "text_data",
      "source_text": "再不提升根性的话\\n基础能力可能会失衡。",
      "source_fingerprint": "cbdd6739c40d63b0e0d6b9672f30677a3cdd214fc85b027bb5e37561ff44cc0b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "11"
      ]
    },
    {
      "uid": "zhcn:90bc1ab8a4894ca3092efe30",
      "kind": "text_data",
      "source_text": "智力似乎有些不足\\n试着重点锻炼一下吧。",
      "source_fingerprint": "c7b8693463c7e6367a28751b46d76f3366564ee6dac708abdfdf77d0488d62ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "12"
      ]
    },
    {
      "uid": "zhcn:f321ca837b25c2d4e3527e17",
      "kind": "text_data",
      "source_text": "再不提升智力的话\\n基础能力可能会失衡。",
      "source_fingerprint": "fa41ccc2000733f02f7f9bc78f892bafe613e95ee1c1d468f263cdbf82581fdb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "13"
      ]
    },
    {
      "uid": "zhcn:f967c9e7aa1641a9be0b25b6",
      "kind": "text_data",
      "source_text": "均衡地进行训练吧！",
      "source_fingerprint": "0b6149ede7ce791251cc3a2c860769a0e5adbb231f42abefa7e57f742432f6ea",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "14"
      ]
    },
    {
      "uid": "zhcn:3445ca67cbe131d0c8411b91",
      "kind": "text_data",
      "source_text": "粉丝数不足的话将无法参加目标赛事。\\n去参加比赛吧。",
      "source_fingerprint": "6e24385bdc6eed3df702298f2369cf4a376112a395202543f1672855155af621",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "15"
      ]
    },
    {
      "uid": "zhcn:cec5f69466d25f985a9782f3",
      "kind": "text_data",
      "source_text": "这样下去将无法达到目标粉丝数。\\n去参加比赛吧。",
      "source_fingerprint": "c3686e41eedfc4d8fb93c3182e2d3292f9f4b44e822e63d708741f838249059c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "16"
      ]
    },
    {
      "uid": "zhcn:f504c037d2d7a52a2a30d196",
      "kind": "text_data",
      "source_text": "现在是目标比赛当天呢。\\n接下来只需静候比赛结果了。",
      "source_fingerprint": "f0ccce76db16cd64c8619e7070f66d04d4b33f140452670630c93b75c9bc24b4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "17"
      ]
    },
    {
      "uid": "zhcn:48107c53ff60d1f418d811db",
      "kind": "text_data",
      "source_text": "出现了影响训练的状态\\n去保健室吧。",
      "source_fingerprint": "a317e89c236fb8e00454b7439996311732144b0b6fddc6d6d97059d2bb44e82a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "18"
      ]
    },
    {
      "uid": "zhcn:8d152d4b2a940619e21600c8",
      "kind": "text_data",
      "source_text": "体力低下有受伤的危险。\\n休息也很重要哦。",
      "source_fingerprint": "585a0fee1f9bd9e5b60c198bf993849735ba1b32453b19a5ff9e635eed49d229",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "19"
      ]
    },
    {
      "uid": "zhcn:50a44d16cc95eddd66748d05",
      "kind": "text_data",
      "source_text": "与基础能力相比，技能有些不足\\n获取一下技能如何。",
      "source_fingerprint": "92714d6fdf2ec51dd9c498e303d7300e2bcf67d3cb21b820233d68922494d2dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "2"
      ]
    },
    {
      "uid": "zhcn:19e3b76a954ea771dde06fc7",
      "kind": "text_data",
      "source_text": "体力低下有可能会受伤。\\n外出放松一下吧。",
      "source_fingerprint": "d0ba9669d849f2ef562c406b5bf9537ce4607fa47c8e52750b0073289338bbcc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "20"
      ]
    },
    {
      "uid": "zhcn:5e81d9cdc8181d13824be503",
      "kind": "text_data",
      "source_text": "临近比赛状态却有点差。\\n外出转换心情也很重要哦。",
      "source_fingerprint": "e90f01a224413ef714dd869c190dbb0fcb1db7fedec02dad5fa6fddab26ba959",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "21"
      ]
    },
    {
      "uid": "zhcn:797c2a9facfb0cbc6d4898ba",
      "kind": "text_data",
      "source_text": "现在处于出道前的调整期间。\\n好好训练吧。",
      "source_fingerprint": "4c6a2806163a294cfa3c48878d9ccebeef7bc81798504feab83afa935fb501ce",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "22"
      ]
    },
    {
      "uid": "zhcn:6982a56e49d7303b24144848",
      "kind": "text_data",
      "source_text": "处于未冠状态的话，9月以后将\\n无法继续育成。去取得比赛胜利吧。",
      "source_fingerprint": "471d2eda43abf9ba403b21eedc4a83837c30ae69e6a682fc82a41ca41d595111",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "23"
      ]
    },
    {
      "uid": "zhcn:425dc34096d575c0b21ed3b8",
      "kind": "text_data",
      "source_text": "未取得过胜利，将无法参加目标比赛。\\n去参加比赛吧。",
      "source_fingerprint": "c5068e9d9b50bdc60b11b69adc1ccce184ff228f584d42a009bf8ce66aa10814",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "24"
      ]
    },
    {
      "uid": "zhcn:b25935a38f24a9b76bf135d0",
      "kind": "text_data",
      "source_text": "这样下去的话就完不成目标了。\\n去参加比赛吧。",
      "source_fingerprint": "11f7c3c17ae2cadd2ddf514fd317030cad63d9fca9c7de3ee3745bf4fad3991e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "25"
      ]
    },
    {
      "uid": "zhcn:ef41648648fafa7f780904f7",
      "kind": "text_data",
      "source_text": "这样下去的话将无法达成目标成绩点数。\\n去参加比赛吧。",
      "source_fingerprint": "ef08c790db7a82e6d778530ea096e77ff1fac12a322dcbefc7e415386a042eb7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "26"
      ]
    },
    {
      "uid": "zhcn:65681038c6358e290f2b2944",
      "kind": "text_data",
      "source_text": "这速度真是令人惊叹！\\n保持这个状态继续锻炼吧。",
      "source_fingerprint": "e80ce9e75a967077b376de56766c1f083531fbd66dee25c90fe74a83349a73dc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "27"
      ]
    },
    {
      "uid": "zhcn:c91e048ab05db91d5e82f132",
      "kind": "text_data",
      "source_text": "这耐力真是令人惊叹！\\n保持这个状态继续锻炼吧。",
      "source_fingerprint": "49852c817b73c96be628f5481f543a69cac8e3897dfdc058fa5d90aae6fbd41d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "28"
      ]
    },
    {
      "uid": "zhcn:7b811b13c119ae2a4c3c7515",
      "kind": "text_data",
      "source_text": "这力量真是令人惊叹！\\n保持这个状态继续锻炼吧。",
      "source_fingerprint": "6d9acbbf6b262cc58263dbe1caf1bda55652065ef685a39948fe07960e794494",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "29"
      ]
    },
    {
      "uid": "zhcn:fb2afe1fbbfd8b19649d8f17",
      "kind": "text_data",
      "source_text": "差不多该学习技能了。",
      "source_fingerprint": "23dc7ebd2435396c24c96f7989fae5924811652a89f7519613615e5d082bfe38",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "3"
      ]
    },
    {
      "uid": "zhcn:52bca511df14f110a93f01b4",
      "kind": "text_data",
      "source_text": "这根性真是令人惊叹！\\n保持这个状态继续锻炼吧。",
      "source_fingerprint": "40fe335acfed18c048df16e0832ce9ed4cbacfc69c60302d156a3518c532eede",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "30"
      ]
    },
    {
      "uid": "zhcn:e98532c7186264af505a89a0",
      "kind": "text_data",
      "source_text": "这智力真是令人惊叹！\\n保持这个状态继续锻炼吧。",
      "source_fingerprint": "c96acfc3fa6cb27952fd4ba642e61e79623cbfe96cb4d4ccac6e48bd7103f134",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "31"
      ]
    },
    {
      "uid": "zhcn:a1c7549de5d9881bb8cbcb27",
      "kind": "text_data",
      "source_text": "这样下去将无法达到目标。\\n去获得支援者Pt吧。",
      "source_fingerprint": "19f90abe0e5e1f9c8f0e5ceb1312b7f99aa9c77a11b2e149fa45c4c7ce91f6f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "32"
      ]
    },
    {
      "uid": "zhcn:cfcafb2643cb43565fccfb6b",
      "kind": "text_data",
      "source_text": "现在的状态不利于训练。\\n外出转换一下心情如何呢？",
      "source_fingerprint": "85d60e341ebddda48069217a92039ec292a257084e6495e2980214208ab8a39c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "33"
      ]
    },
    {
      "uid": "zhcn:8a83b7e8854f06729405cea9",
      "kind": "text_data",
      "source_text": "担当赛马娘的状态似乎\\n未达到最佳呢。",
      "source_fingerprint": "4dc69d9a69646b14d992a4415ba5b13bbee6626a908f6a1e7f33d8dd974f537b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "34"
      ]
    },
    {
      "uid": "zhcn:10375324ed723bd61fda12fa",
      "kind": "text_data",
      "source_text": "速度似乎有些不足\\n试着重点锻炼一下吧。",
      "source_fingerprint": "83710bba219322c19b6c6f0a45ea6cdff6305eda44a6fa526579b8f3099cc502",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "4"
      ]
    },
    {
      "uid": "zhcn:fbb64aeb516408f65faf4b14",
      "kind": "text_data",
      "source_text": "再不提升速度的话\\n基础能力可能会失衡。",
      "source_fingerprint": "a8b69bb84eaab15e6aeb7950a476054825a54e8b23c51abd94658f3b72bfd050",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "5"
      ]
    },
    {
      "uid": "zhcn:7839184241d3d080272a9dc2",
      "kind": "text_data",
      "source_text": "耐力似乎有些不足\\n试着重点锻炼一下吧。",
      "source_fingerprint": "0e056c0a86334dbf0e62a4bad762f54a5a120b9625bf646aefc9f8c724fd254d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "6"
      ]
    },
    {
      "uid": "zhcn:bcd1313aa75321369f8ad118",
      "kind": "text_data",
      "source_text": "再不提升耐力的话\\n基础能力可能会失衡。",
      "source_fingerprint": "007058931cc483c9690e27745b9926fa58fa487559aa35444039a79f7f84fca2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "7"
      ]
    },
    {
      "uid": "zhcn:efb75d6dcef050a12a6aa034",
      "kind": "text_data",
      "source_text": "力量似乎有些不足\\n试着重点锻炼一下吧。",
      "source_fingerprint": "a26494097212e095dd5e53fbc91745173dd431fb4e12908f63e758e58bb0e1be",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "8"
      ]
    },
    {
      "uid": "zhcn:ddb9086dfcde12b11df8cdc7",
      "kind": "text_data",
      "source_text": "再不提升力量的话\\n基础能力可能会失衡。",
      "source_fingerprint": "9197dc299e85e2b4a38bcc2780801aeec0abef580a8c826592ab379cd3696644",
      "source_path": "text_data_dict.json",
      "json_path": [
        "97",
        "9"
      ]
    },
    {
      "uid": "zhcn:e52d7723f7047727f948b6fe",
      "kind": "character_system_text",
      "source_text": "绝对会赢的！",
      "source_fingerprint": "f3f86abb17829372e7e16b5175f1320ff3667ae47d982c2178ff5001aa3e3c70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "1000"
      ]
    },
    {
      "uid": "zhcn:66f8253348c03fed1c9c0115",
      "kind": "character_system_text",
      "source_text": "和作为对手的大家一起…\r\n我一定会变得更强的。",
      "source_fingerprint": "7e3f7f595347bf703ea90b343befdd26f2634a4482e71abf6b65d957c920b41a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10000"
      ]
    },
    {
      "uid": "zhcn:cff05c4e28e29edc0cf8cfd5",
      "kind": "character_system_text",
      "source_text": "行ってきます！",
      "source_fingerprint": "5e6c34d6deac81a93e6a4bc4c01159e343249a9b49665c4350b63afde671cd7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "100000"
      ]
    },
    {
      "uid": "zhcn:c292961b09c69fe3b1adf47d",
      "kind": "character_system_text",
      "source_text": "ただいま戻りました！",
      "source_fingerprint": "9f8b04b4edb572764b45e483a28cd1cf6e40442b258dd629e84cb2d8e5633947",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "100001"
      ]
    },
    {
      "uid": "zhcn:a8198325b6218fccffb4d53a",
      "kind": "character_system_text",
      "source_text": "我们的梦想是成为日本第一的赛马娘！\r\n一起将其实现吧，\r\n训练员！",
      "source_fingerprint": "b000ce7320e034b4a29db514af28414fae3b8c6c37e95fffcefef016cf65bbf7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10001"
      ]
    },
    {
      "uid": "zhcn:c19de02d2e875e393d312f87",
      "kind": "character_system_text",
      "source_text": "下次再一起开始附近的\r\n美食探索之旅吧♪",
      "source_fingerprint": "4ea8b36707d9532846b62c48253428adad7b35b1a987df40b6b0685aa9ccb614",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10002"
      ]
    },
    {
      "uid": "zhcn:4fff69868c6d4871a2ec11aa",
      "kind": "character_system_text",
      "source_text": "新年快乐！\r\n因为正月很容易发胖…不注意体重可不行呢！",
      "source_fingerprint": "97265dc06e8cd64ad5cf90a8d099c120f4467e9984856ca9106590063bade239",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10003"
      ]
    },
    {
      "uid": "zhcn:d9816d16ae37027f5728f6d1",
      "kind": "character_system_text",
      "source_text": "情人节快乐！\r\n作为平时的感谢……巧克力，还请收下！",
      "source_fingerprint": "ccef301617f5cf434b48dee6057ba0e6544a069dc0f7ffeaf829ec430af964e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10004"
      ]
    },
    {
      "uid": "zhcn:eef0c9b677bed7ca667d9906",
      "kind": "character_system_text",
      "source_text": "这个巧克力是我用\r\n妈妈教的食谱做的哦！诶嘿嘿。\r\n能够收下吗…？",
      "source_fingerprint": "61ae0a5c555d12a541368e408253e02df67954efd9b7886924657f96a2717c37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10005"
      ]
    },
    {
      "uid": "zhcn:8db0251ab68cca4ea64afb59",
      "kind": "character_system_text",
      "source_text": "是个适合观星的夜晚呢～！\r\n要是能放晴就好了…",
      "source_fingerprint": "ce2dc76f2f20a5fd2d321a1c24ef0e0c240d9f0446885ed59a1ac048bec59abc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10006"
      ]
    },
    {
      "uid": "zhcn:b206b8285a5f5fc8a1205152",
      "kind": "character_system_text",
      "source_text": "我说怎么学园里都是\r\n点心的味道…原来到万圣节了啊！\r\n只要有好吃的，什么节日我都非常欢迎～！",
      "source_fingerprint": "558d3650ad92d948fff68541fee00da41f78daf6551da963844f94f50917def6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10007"
      ]
    },
    {
      "uid": "zhcn:b54b8f9b523453be92e9ad88",
      "kind": "character_system_text",
      "source_text": "想起来小时候不小心把妈妈\r\n脸上的圣诞老人假胡子\r\n扯下来的事了…诶嘿嘿。",
      "source_fingerprint": "1bd2c5d2da7ad62679726c8e5a04b191cc80db34ece6dba1e3c7dcc84f88e6f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10008"
      ]
    },
    {
      "uid": "zhcn:4e5ead20db62b98839abe24b",
      "kind": "character_system_text",
      "source_text": "圣诞节快乐。\r\n要一起去吃加了满满牛奶\r\n的炖菜吗？",
      "source_fingerprint": "f44f6423704774e5583a329f8a10ae5e627847d1acf7ce71a3f4a41cd4eeeffe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10009"
      ]
    },
    {
      "uid": "zhcn:8ddf4ea7ecd78efa86b386ca",
      "kind": "character_system_text",
      "source_text": "诶嘿嘿，赢了！",
      "source_fingerprint": "80a803d415e3ea4be57a0ef9068da4a17d08918417eeaa0e2e262f284c872337",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "1001"
      ]
    },
    {
      "uid": "zhcn:2572f3c8acec263dffc3f35d",
      "kind": "character_system_text",
      "source_text": "今年也不知不觉就过去了呢。\r\n明年的我…要是比现在的我\r\n更强就好了！",
      "source_fingerprint": "e3df7607b726f8ddd09f34985ad124116beefd499a1e72d061c50327d0dddf2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10010"
      ]
    },
    {
      "uid": "zhcn:93da8642c194cf22de4e8a9c",
      "kind": "character_system_text",
      "source_text": "生日快乐！\r\n可以的话一起去尝尝\r\n饭堂的蛋糕吧？",
      "source_fingerprint": "1ee1de0eec694bc81b6e234672dbf17bd559c7b26da2f5ed2e903b89ef119bcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10011"
      ]
    },
    {
      "uid": "zhcn:f73f8850b728e04ace2aeb9d",
      "kind": "character_system_text",
      "source_text": "生日快乐♪\r\n诶嘿嘿…能像这样庆祝别人的生日，\r\n总感觉很幸福呢。",
      "source_fingerprint": "67643dc9aae70fa7868b2f59e77a1aa62331feeeb69ee86cef7bd1dc5e1cd1b7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10012"
      ]
    },
    {
      "uid": "zhcn:049c2150d7e94309e64bb845",
      "kind": "character_system_text",
      "source_text": "从早上开始就收到了妈妈\r\n和大家的生日祝福…\r\n呜呜，真是幸福的生日～！",
      "source_fingerprint": "347857af5012b8d3948448330ce363f6e99ecc764ae525021a1400f3a916d4d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10013"
      ]
    },
    {
      "uid": "zhcn:15f60800224c244be4fce678",
      "kind": "character_system_text",
      "source_text": "谢谢你的生日祝福！\r\n我会更加成长的…\r\n所以还请在旁边好好看着哦。",
      "source_fingerprint": "c600fb50480b8b0aebf58da3229720aec1cf8f904bdfde07f4109ff1baee0f5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10014"
      ]
    },
    {
      "uid": "zhcn:2d22e944cec14cccdcbdf104",
      "kind": "character_system_text",
      "source_text": "训练员！\r\n好像有通知哦！",
      "source_fingerprint": "75c702ce718c887f143b36ab4c03c4fe3f86616abc9e723ab2f44e4a2e982fa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10015"
      ]
    },
    {
      "uid": "zhcn:f27c0a46dffaefc11f4eea83",
      "kind": "character_system_text",
      "source_text": "收到了礼物呢！\r\n里面到底是什么呢～诶嘿嘿！",
      "source_fingerprint": "614901637284c51a29ced02426a98a6a92a2b1f58b817ea906aa3158a6ceff2f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10016"
      ]
    },
    {
      "uid": "zhcn:9d3e1a0a3484de8c3656bdf2",
      "kind": "character_system_text",
      "source_text": "好像有已经完成了的\r\n任务呢！\r\n好ー，我也要加油了！",
      "source_fingerprint": "bb32a38da1d39bece99f80b916d83094fae1de4b18c7cf4062eb1a43dfb70a56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "10017"
      ]
    }
  ]
}
