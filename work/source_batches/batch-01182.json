      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41098001"
      ]
    },
    {
      "uid": "zhcn:8c9a0638c64a60aa36da98fc",
      "kind": "text_data",
      "source_text": "玄学？不对不对☆这是真正的风水",
      "source_fingerprint": "0cc62d5ccabb02e21d4655302593f7be2dccd242093e07a93b9d49cda5cb5abd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41098002"
      ]
    },
    {
      "uid": "zhcn:55fc15f3dea8b8fa2119fc3d",
      "kind": "text_data",
      "source_text": "受挫大危机～？响起吧大地的声音",
