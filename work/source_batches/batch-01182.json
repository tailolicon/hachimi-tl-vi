        "41097003"
      ]
    },
    {
      "uid": "zhcn:688297ca459f87165b6aa269",
      "kind": "text_data",
      "source_text": "“请好好看着我”",
      "source_fingerprint": "4628fb8111c6bb5196b23a11cca82383c67957f8baccca6b13df569df7cace54",
      "source_path": "text_data_dict.json",
