      ]
    },
    {
      "uid": "zhcn:e74f2848232daa437efe7845",
      "kind": "text_data",
      "source_text": "“请不要看着我”",
      "source_fingerprint": "5629876a31cfb1b7750107dc006dbd1f8d372da1903173dfb02c2ca3215fed1f",
      "source_path": "text_data_dict.json",
