      "source_text": "真实的自己",
      "source_fingerprint": "9db0f44c2dc14822c360136411b9a9d885d08c4e3ee65c07949a4ea91ac5c8c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41097006"
      ]
    },
    {
      "uid": "zhcn:0be18d9d8030cd188dc5ec4a",
      "kind": "text_data",
      "source_text": "近乎，欲望一般",
