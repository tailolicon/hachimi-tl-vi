    {
      "uid": "zhcn:012ef940f3113e0979c49257",
      "kind": "text_data",
      "source_text": "驚速！そのウマ娘は光の如し",
      "source_fingerprint": "d7afa9a8a828ba50b4be69de22abf63c3d009ddb85d558d06efb08810b9a371b",
