        "41121005"
      ]
    },
    {
      "uid": "zhcn:4604948058a7b859f4576e41",
      "kind": "text_data",
      "source_text": "汝、勿动摇",
      "source_fingerprint": "2aa7947548756ba36e99d5fbcaeef0c87d4ac5f0bf52a26aa762c0b728cb8da7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121006"
      ]
    },
    {
      "uid": "zhcn:49c4c4d6dba4fbe64ac5de68",
      "kind": "text_data",
      "source_text": "汝、勿避视骑士",
      "source_fingerprint": "c8f06289631a9e151f1ac0072c69307cda5de3cc66720fcf51b24a96021f6c91",
      "source_path": "text_data_dict.json",
