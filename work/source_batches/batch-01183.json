      "source_text": "完璧",
      "source_fingerprint": "32b8a546968e9ca0464eee0c6a27be67970e9d3699fbe26b0c9695e8d08bcd18",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41108003"
      ]
    },
    {
      "uid": "zhcn:ce06f83775604aef2ee7071b",
      "kind": "text_data",
      "source_text": "ほんとうは",
      "source_fingerprint": "3ddf0d39d861a5193020399a9001e6cd0a519c5feb0e580b5aea93b1fc662584",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41108004"
      ]
    },
    {
      "uid": "zhcn:d7f0da8f4550a9811cd843f4",
      "kind": "text_data",
      "source_text": "研鑽",
      "source_fingerprint": "af9a76f6604fca89431b58502da22be6bc5a17e11d3f77c6ac50d3a1911d1e61",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41108005"
      ]
    },
    {
      "uid": "zhcn:82e99abdd5381ffb79e33e0c",
      "kind": "text_data",
      "source_text": "静穏",
      "source_fingerprint": "d23c3f12049df18a27d04bf3cf060734a706f3647cad0f560817efd7f6ea8978",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41108006"
      ]
    },
    {
      "uid": "zhcn:f0bdba74f17df7b9d45699e3",
      "kind": "text_data",
      "source_text": "ともにいる",
      "source_fingerprint": "aa972b3aa3dd11951db821afba010499bb9174d4d0478a242c7c961522a9d83c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41108007"
      ]
    },
    {
      "uid": "zhcn:fd55ef4fcfd05db797561ea0",
      "kind": "text_data",
      "source_text": "如太阳般的少女",
      "source_fingerprint": "b003111d49a4657d6416c2d47138eedba73d64d949d18ea68a25b6fb75eb335a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109001"
      ]
    },
    {
      "uid": "zhcn:130d5192e463845fc7f49947",
      "kind": "text_data",
      "source_text": "因为想要传达",
      "source_fingerprint": "0eb2aeb04df1d66414238df831205d156eae6bc26437adefb003bb7fe3a9533a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109002"
      ]
    },
    {
      "uid": "zhcn:070c6ee8acdbf845e53c2f98",
      "kind": "text_data",
      "source_text": "相互连结，不断传承……",
      "source_fingerprint": "1f29202bc43d85a549914dcc1d105063feea74b35b8ddf412cc5e1149f4320ee",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109003"
      ]
    },
    {
      "uid": "zhcn:e2b5d99f72cc59667dc3860b",
      "kind": "text_data",
      "source_text": "前方的梦想",
      "source_fingerprint": "e52302cef1ecf2d3d57d93277b7e3fc66a9ace9a53cc190a7bd91ec040f16ae7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109004"
      ]
    },
    {
      "uid": "zhcn:e50cc41d0182aa53337b3071",
      "kind": "text_data",
      "source_text": "毫不妥协的少女",
      "source_fingerprint": "f962747d4658f566653cc0bd6462bca7d318c9eb571dd12ed101250b5de9937b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109005"
      ]
    },
    {
      "uid": "zhcn:6ba21783db80cf80949fff67",
      "kind": "text_data",
      "source_text": "马克杯与少女",
      "source_fingerprint": "fd26634e1073533e86ea6c67c170903dda2e4ef0f5d7c91ae926a9b3e0fc736c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109006"
      ]
    },
    {
      "uid": "zhcn:b20318c20bcc7293e0074db1",
      "kind": "text_data",
      "source_text": "夏天、相机与少女",
      "source_fingerprint": "1166cd58e40a1f3503ff3796dadab50ea7d8a67a43a64609b083a63b6c96c236",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41109007"
      ]
    },
    {
      "uid": "zhcn:9439d948458344f432c17233",
      "kind": "text_data",
      "source_text": "我也同样，被变成了鹿",
      "source_fingerprint": "fd718c52978737265a4ed77cc59b53e3cbce18df81fcdc3ff733e31d74482f7c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110001"
      ]
    },
    {
      "uid": "zhcn:edcbc1ab4e38db16eadc0adf",
      "kind": "text_data",
      "source_text": "就算脚下生根也绝不挪步",
      "source_fingerprint": "18211a6ac54f6cfa4367680cdb3e1e3f836e46608c913527f8011a1e3185b267",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110002"
      ]
    },
    {
      "uid": "zhcn:502249a325ab5bb70fc1ddbb",
      "kind": "text_data",
      "source_text": "恋爱的深夜亦如正午",
      "source_fingerprint": "40accfc237117e2641ce37d48c93e1927920be260c0be2d240c23911bfc73e5f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110003"
      ]
    },
    {
      "uid": "zhcn:b4c328034320aad9a0d9d6ac",
      "kind": "text_data",
      "source_text": "与其做愚蠢的智者，不如做明智的傻瓜",
      "source_fingerprint": "994dd5b6c019ea8de9e6ba4bcedc4b7b95b649a67fd3bc2b1ebf153263923975",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110004"
      ]
    },
    {
      "uid": "zhcn:36cc27d730af2d9a2a44ce32",
      "kind": "text_data",
      "source_text": "一张照片的分量，为了终有一日回望之时",
      "source_fingerprint": "93f2ee51dd5ed815c116b2923ba588c93936296aa4d75caf26b17a8cb9386cad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110005"
      ]
    },
    {
      "uid": "zhcn:e5ce34d9b203a6f0f726bd76",
      "kind": "text_data",
      "source_text": "延展至彼方的汪洋，其起点",
      "source_fingerprint": "4ad05383469382dca6136c18308516524c58dcd3c3fdd95187df0035f9305b34",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110006"
      ]
    },
    {
      "uid": "zhcn:d9632d04fa362b0866fa2048",
      "kind": "text_data",
      "source_text": "幕间，然后故事延伸到无尽远方",
      "source_fingerprint": "ba75cb9da29ac645d09e29beef4d5f99b433d78a4aa11108ba815e00ec8cc8a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41110007"
      ]
    },
    {
      "uid": "zhcn:a3a5669fb385af810fac9da9",
      "kind": "text_data",
      "source_text": "『关于空中救世主』",
      "source_fingerprint": "d449631acb2f4451810f45757c23b630652e288eab35061a039dcdaba887a3f8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111001"
      ]
    },
    {
      "uid": "zhcn:3bb418c5b50c7284f8f51471",
      "kind": "text_data",
      "source_text": "『认真、踏实、勤奋』",
      "source_fingerprint": "0acc9700b641cb85d7ace101426e8eede4ea9015213229965eb238e7448013ca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111002"
      ]
    },
    {
      "uid": "zhcn:f1be8da68388ab664abcdea6",
      "kind": "text_data",
      "source_text": "『睿智双眸中，燃烧的意志』",
      "source_fingerprint": "0866aee72ec78a496e2b0d2b87722455a6d47d8b8c99e78c479ef5ba7235aa52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111003"
      ]
    },
    {
      "uid": "zhcn:c4644933bc8ca6251932d34f",
      "kind": "text_data",
      "source_text": "『我所尊敬，珍视的搭档』",
      "source_fingerprint": "7fa3fd545bc7770d4d18d7761f6036c6481ec349c5f4c8e56608fa5984aa724e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111004"
      ]
    },
    {
      "uid": "zhcn:cf01d1cbbaac4527685f1c66",
      "kind": "text_data",
      "source_text": "『今后的课题与隐忧』",
      "source_fingerprint": "55407a57470e06f8af341379012efe8d92c079be9992d8edbded79d73f023a38",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111005"
      ]
    },
    {
      "uid": "zhcn:533afc2d3f3268026e0d049d",
      "kind": "text_data",
      "source_text": "『休养与竞技表现的关系』",
      "source_fingerprint": "15918c6e4fe81163063c56aa5703b58b99ee569415e1c7065ff9ea6ec427e3ac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111006"
      ]
    },
    {
      "uid": "zhcn:1482263ae1a6b950a8791a27",
      "kind": "text_data",
      "source_text": "『从今往后，都想珍惜的羁绊』",
      "source_fingerprint": "5078df9252bb4d6c7eee8756a09b89661294f6f67f0e000a92a09dc11e4f1117",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41111007"
      ]
    },
    {
      "uid": "zhcn:6cf9caef1012f67df9864bfd",
      "kind": "text_data",
      "source_text": "悠哉悠哉的~？是说谁呢~？我吗~！？",
      "source_fingerprint": "3f6bbea50de9fc6c18cb741dcd97a1f7d0b3e6e04e0a578f378d5a8d8370efca",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113001"
      ]
    },
    {
      "uid": "zhcn:57cea3f3608fc94c47b04ca7",
      "kind": "text_data",
      "source_text": "聊一聊！那就，找个别的地方聊好啦☆",
      "source_fingerprint": "b5cec912a22ba167e09d63ffbf01ac961ec515c1d03c59b40e0320b3d342ce21",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113002"
      ]
    },
    {
      "uid": "zhcn:ef1f7025b68432c8da41f831",
      "kind": "text_data",
      "source_text": "哇！好像出现了很强的对手~",
      "source_fingerprint": "db48e949efb772c7814a8fb8b414c7274248dfbabfde6e4668fa48c37d9a3795",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113003"
      ]
    },
    {
      "uid": "zhcn:5bc697ece633adf704000b8e",
      "kind": "text_data",
      "source_text": "我是有梦想的！有的，大概",
      "source_fingerprint": "cab73773959e0b08986360a12b6f6f8e02980922711665699e20e772863e4a1a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113004"
      ]
    },
    {
      "uid": "zhcn:8c57f20f4e2bc4fa0111c204",
      "kind": "text_data",
      "source_text": "感觉闪闪发光的！超羡慕！！",
      "source_fingerprint": "1bb362f8d6d7997451e1c5b3eae775df2bb78525bdc92636bbe04480fedce9f5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113005"
      ]
    },
    {
      "uid": "zhcn:f0b103f2ec2202e1947b0c97",
      "kind": "text_data",
      "source_text": "总之，打打看，摆弄摆弄，再弹弹看♪",
      "source_fingerprint": "65e7ba36ab5598e27514fba225c73d43a28457af47eba829c6fd073220ab0ec8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113006"
      ]
    },
    {
      "uid": "zhcn:611184743f8b6492aaea858c",
      "kind": "text_data",
      "source_text": "我的爱好，在哪呢？在那吗？在这里~！！",
      "source_fingerprint": "f1745737d4f1256646466260155b1660e7d87f3ac4d9f1a20f324673f867a9fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41113007"
      ]
    },
    {
      "uid": "zhcn:eb7ca60d97710f42b255eddf",
      "kind": "text_data",
      "source_text": "『约好了哦』",
      "source_fingerprint": "3009cf200356bc8c8403de343b332063834c3dbdae4cf47adaacccaa1d1728c7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114001"
      ]
    },
    {
      "uid": "zhcn:121612b33c812ea76385ff2b",
      "kind": "text_data",
      "source_text": "『奔跑着、奔跑着、奔跑了』",
      "source_fingerprint": "96b89143802776fa4027b070b47586eb6d8489bdb743beef297889c62fbec4d2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114002"
      ]
    },
    {
      "uid": "zhcn:bb76d5f33b20db7435e68ed4",
      "kind": "text_data",
      "source_text": "『没错，所以说，我也』",
      "source_fingerprint": "75e456dccc360038721839503fda77a2ecabc288ddcd00225d55e53568179e65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114003"
      ]
    },
    {
      "uid": "zhcn:690400dbb772e27f1d69510a",
      "kind": "text_data",
      "source_text": "『从这里，开始启程』",
      "source_fingerprint": "1f0d94fd9d2cb92ff682b67fc8fe855d83fb3e88c0bdb3e4342f792e0ff0bf75",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114004"
      ]
    },
    {
      "uid": "zhcn:aeb40823eb5947cc25573775",
      "kind": "text_data",
      "source_text": "『因为，一直就在身边』",
      "source_fingerprint": "0cbc030098c471ba3b785b7453c4a2437d44dd445d28b4f68b3519088672b631",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114005"
      ]
    },
    {
      "uid": "zhcn:206af7df158182717610ed6d",
      "kind": "text_data",
      "source_text": "『没能见面的那些时间』",
      "source_fingerprint": "8f2201feccb8048af1e5cae70d13386af625379796d024cfed2bbf4796b7681e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114006"
      ]
    },
    {
      "uid": "zhcn:efb293aa109cc2b4dd728373",
      "kind": "text_data",
      "source_text": "『全部，一直，今后也』",
      "source_fingerprint": "6c507f324de6f559d368199f35c1dbf1c3b276580fca1f03928cc9af4f25d809",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41114007"
      ]
    },
    {
      "uid": "zhcn:bcbdf79256d5a2871d37905c",
      "kind": "text_data",
      "source_text": "その脚で大地に跡を刻み",
      "source_fingerprint": "7640a88928b92daddbf0f2de44209c25083a9e665d96ab64cc0d5535a2e7cddf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116001"
      ]
    },
    {
      "uid": "zhcn:46ddf8fa59a46b65a7ecf27b",
      "kind": "text_data",
      "source_text": "その手で全てを変容し",
      "source_fingerprint": "004a464bc0dfc5efc6d4c5fcc730bb68786b2ee979ac7250e755d477e9abd056",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116002"
      ]
    },
    {
      "uid": "zhcn:c844ccc37f401c32015b9b6e",
      "kind": "text_data",
      "source_text": "その背中でかつてない喜びを背負い",
      "source_fingerprint": "5bf2df51176226d09f5cfca55da23e7d1fa3b300d511de1da98c84d74a7e74de",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116003"
      ]
    },
    {
      "uid": "zhcn:8df4776f6aa5e5a443d663f3",
      "kind": "text_data",
      "source_text": "その瞳で心を射抜く",
      "source_fingerprint": "266b814fe3d1fa8667b3536735b3ecce4e1d78c5ca6f2f2fd74c9cfb43ca4a56",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116004"
      ]
    },
    {
      "uid": "zhcn:112151c9187b395eac518fbf",
      "kind": "text_data",
      "source_text": "その思考に己を省み",
      "source_fingerprint": "47f4c17416bf5f639ce2714155464755380751c07cec516978f2d88746e628f2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116005"
      ]
    },
    {
      "uid": "zhcn:2ea62145503bdccd9d6a9f3e",
      "kind": "text_data",
      "source_text": "その声で魂を奮起させ",
      "source_fingerprint": "2de3d9c527723981d5521c24aa4b48d3e352636b8e65706dc83b184e84433a7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116006"
      ]
    },
    {
      "uid": "zhcn:e23c0d80d9bee2fca372b9db",
      "kind": "text_data",
      "source_text": "その微笑みに応えていく",
      "source_fingerprint": "b7f80088b04b3d892a4211b1cea1b8ecc84e67dfef21ca7cd9583e4cccace94d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41116007"
      ]
    },
    {
      "uid": "zhcn:4beaaba2011fbb79ddec68ff",
      "kind": "text_data",
      "source_text": "冰之瞳的赛马娘",
      "source_fingerprint": "3a92c7a6b01a33ce1710702b12b7c3cfcb31c648bafc19d5cf5aeeb84c3f842d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41118001"
      ]
    },
    {
      "uid": "zhcn:762bc65ba0ce268dd3f7283f",
      "kind": "text_data",
      "source_text": "我不需要什么爱",
      "source_fingerprint": "682834a81c3900f821cf168f170b3f16e944805408389c0811a781e4098041f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41118002"
      ]
    },
    {
      "uid": "zhcn:91b54f1df497e4cc04486ebf",
      "kind": "text_data",
      "source_text": "那灵魂正在迷惘",
      "source_fingerprint": "750b27a1607e2fdf63ee11a4aed45a9eb21fc0d5626a087207ec628855b5aed9",
      "source_path": "text_data_dict.json",
