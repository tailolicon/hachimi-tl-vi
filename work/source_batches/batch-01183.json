        "41120001"
      ]
    },
    {
      "uid": "zhcn:5577bfa5173d576f4d98247b",
      "kind": "text_data",
      "source_text": "打倒！ライバルは偶蹄目",
      "source_fingerprint": "8ef6815586e0d2320bd28de68890d28344fa5b0c027570edca3c472c11611cac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120002"
      ]
    },
    {
      "uid": "zhcn:3c7b1a729fc797e17f2ecaa0",
      "kind": "text_data",
      "source_text": "浪漫！最高速は無二の輝き",
      "source_fingerprint": "4cb93b028646dc2650edec9a721134eeff01a58c9be1cf540f4cfc93fc4a0fb4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120003"
      ]
    },
    {
      "uid": "zhcn:85280590cbc508065978dc7c",
      "kind": "text_data",
      "source_text": "超越！あらゆる生命の先頭へ",
      "source_fingerprint": "7fa9809d42419f8f38bc89e405ce9c5ac3c850feaf3b22d42492dcd500b3c8f1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120004"
      ]
    },
    {
      "uid": "zhcn:16c8c969b7e34e4f5cf284e6",
      "kind": "text_data",
      "source_text": "爆走！最速娘は止まれない",
      "source_fingerprint": "901dc49af5aee89c425ee83242dfc634507b2e199db5bc88670cd2bc8799f1a8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120005"
      ]
    },
    {
      "uid": "zhcn:a7fecb3acf120982fb7c7808",
      "kind": "text_data",
      "source_text": "合体！パワー二乗はスピード二乗",
      "source_fingerprint": "ad8c0e5fde9c320b2c5babe1c16af48bd0cab20592be56a45f9893ef1daeba7d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120006"
      ]
    },
    {
      "uid": "zhcn:830aab46e373832f409cb1c3",
      "kind": "text_data",
      "source_text": "驚嘆！広がる世界は宇宙より速く",
      "source_fingerprint": "58ed612209801e910f1d68caf7101e86ae6b84d850af3e19d4ee27bbcd129165",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41120007"
      ]
    },
    {
      "uid": "zhcn:b3e8d479b41842348066af91",
      "kind": "text_data",
      "source_text": "华丽与刚毅！骑士赛马娘，参上",
      "source_fingerprint": "289b81ad9246a37a302a0f146ce4ddd51db2578018dcb366ee35c4fc01d6ffd7",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121001"
      ]
    },
    {
      "uid": "zhcn:6844c6f45480c7c57a164311",
      "kind": "text_data",
      "source_text": "『圣剑』一闪！我之王何处寻？",
      "source_fingerprint": "c8284c58d9c443c150971af04eb2821e94014a0c28561df46e173e7076f329fd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121002"
      ]
    },
    {
      "uid": "zhcn:ac7f00862889b213c012b29e",
      "kind": "text_data",
      "source_text": "神圣的憧憬！骑士道才是我之道路",
      "source_fingerprint": "63ba3c649c55e43785521799a85c3025aeb2049ee9e422eb4a5309e56eddfed0",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121003"
      ]
    },
    {
      "uid": "zhcn:9f38acbc77b1efa7ec8948f6",
      "kind": "text_data",
      "source_text": "骑士授任仪式！我之王乃大器，并且……",
      "source_fingerprint": "ac61163d756f5be97b8143c520ec9d43c6ba18e40380d70a54ccc6e8d3869ca2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41121004"
      ]
    },
    {
      "uid": "zhcn:975b3f24a703f1b1220e6b2c",
      "kind": "text_data",
      "source_text": "汝、勿忘此事",
      "source_fingerprint": "cf982cca527b633a313646c486cb75820e8bc636b6d7fee0e9677d5363c1f3ee",
      "source_path": "text_data_dict.json",
      "json_path": [
