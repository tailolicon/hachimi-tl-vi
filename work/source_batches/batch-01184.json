  "entries": [
    {
      "uid": "zhcn:d8c5d7f36749bb55e01adf9b",
      "kind": "text_data",
      "source_text": "怯まぬ心",
      "source_fingerprint": "0374f6291bc0c8b9c88c673e5a04cbbcfc76f359b0459a2088e7b532c9f5afa2",
      "source_path": "text_data_dict.json",
