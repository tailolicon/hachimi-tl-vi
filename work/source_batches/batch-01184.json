  "entries": [
    {
      "uid": "zhcn:aef1e44726ea3587ce5cc157",
      "kind": "character_system_text",
      "source_text": "是大海～！",
      "source_fingerprint": "281a24b2ee05acea2fac7a4bd0ccdf2650fa75c9b210b3ca1b8d50bbe742b3c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "20047"
      ]
    },
    {
      "uid": "zhcn:197cb51697d9f49cb4f93b90",
      "kind": "character_system_text",
      "source_text": "多亏了训练员，我才能够成长！",
      "source_fingerprint": "352a3e6eabb4ff04ac8167409aed863a0a905b5e568fe94df493306b5f8f2b85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "20049"
      ]
    },
    {
      "uid": "zhcn:fc0c66e14064989cd7ea68c0",
      "kind": "character_system_text",
      "source_text": "训练员，非常感谢！",
      "source_fingerprint": "c2ed3b0b9ec34444ea0647c13bff1574415b95ac40788b298e4a30e187585599",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "20050"
      ]
    },
    {
      "uid": "zhcn:4cd3f29796dbeec6ebb4ce02",
      "kind": "character_system_text",
      "source_text": "坚持不懈地加油吧！",
      "source_fingerprint": "6f618d0dc8b39dfbb4c564a1a54cf48ef55bb789dfe9ec2b891bf3749ace6c53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "20051"
      ]
    },
    {
      "uid": "zhcn:fa2112a3d55dc97e38ec140d",
      "kind": "character_system_text",
      "source_text": "绝对会赢的！",
      "source_fingerprint": "f3f86abb17829372e7e16b5175f1320ff3667ae47d982c2178ff5001aa3e3c70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "2030"
      ]
    },
    {
      "uid": "zhcn:8b0bba19a22bf5c4e84b301f",
      "kind": "character_system_text",
      "source_text": "大家，一起加油吧ー！",
      "source_fingerprint": "09540cfb48ca3d09cb5e3962ff5a096fd2679aaa393a020e57a2efcc984bb9a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "2031"
      ]
    },
    {
      "uid": "zhcn:52ab951b381dbf77ede494e1",
      "kind": "character_system_text",
      "source_text": "训练员，非常感谢！",
      "source_fingerprint": "c2ed3b0b9ec34444ea0647c13bff1574415b95ac40788b298e4a30e187585599",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "2032"
      ]
    },
    {
      "uid": "zhcn:fe4c5f71519c861f9b1c475b",
      "kind": "character_system_text",
      "source_text": "因为是重要的比赛，\r\n所以要好好加油了！",
      "source_fingerprint": "3f90f1b01cabb6872b897d43c1b057d7ee341220d917be1554ed4fa01f31fde5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "2033"
      ]
    },
    {
      "uid": "zhcn:a298a9480f17ced8e052afe9",
      "kind": "character_system_text",
      "source_text": "向着日本第一的梦想，\r\n全力飞奔！",
      "source_fingerprint": "af55c5585174cceeb370af6f3ee40ed3c7f8a5637220df453046916b604f07a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "2034"
      ]
    },
    {
      "uid": "zhcn:7444c6632d248783557d6fa2",
      "kind": "character_system_text",
      "source_text": "训练员，非常感谢！",
      "source_fingerprint": "c2ed3b0b9ec34444ea0647c13bff1574415b95ac40788b298e4a30e187585599",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "2035"
      ]
    },
    {
      "uid": "zhcn:bf66f68ef12d343fc6979144",
      "kind": "character_system_text",
      "source_text": "がんばります！",
      "source_fingerprint": "7bf2ebe2e4a91f296de7073d2e3b6c30949c84adbbb12fbfa83a3dd144e3989e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "23015"
      ]
    },
    {
      "uid": "zhcn:bf75d241e547104e02b51d42",
      "kind": "character_system_text",
      "source_text": "虽然与第1名失之交臂…但我还是很高兴！",
      "source_fingerprint": "c2dea98fed244ed7cb106f89e54ba92f4cf314e40efc72da9b677477dee73dba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30000"
      ]
    },
    {
      "uid": "zhcn:d11fdc1f5824a5cc644b424c",
      "kind": "character_system_text",
      "source_text": "离第1名还差一点…不努力的话可不行！",
      "source_fingerprint": "00e48d34f7880d554d35b473d1e2f627e026d3dea205115a6913dfa2837b7d5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30001"
      ]
    },
    {
      "uid": "zhcn:ce1ba5064a4900132edee5c5",
      "kind": "character_system_text",
      "source_text": "下次我想跑的更好…！",
      "source_fingerprint": "ca105e59a9af045cdfa9910e8e9c6dd8a4a965ce05faa68800088e1f9387801a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30002"
      ]
    },
    {
      "uid": "zhcn:1f818412949981aba9b7449a",
      "kind": "character_system_text",
      "source_text": "呜呜呜～搞砸了～…！",
      "source_fingerprint": "98c845921b96bdf1c08e62a8b9018defb07f75d794b6fdae25f47eddcda6f1c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30003"
      ]
    },
    {
      "uid": "zhcn:31d4de6cbe055797557bba3e",
      "kind": "character_system_text",
      "source_text": "哇啊！太好了～！我是第1名！",
      "source_fingerprint": "4624313aa7c1262fb0606ba903fb9abcfb56842dd5012b95a61df675eb89354b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30004"
      ]
    },
    {
      "uid": "zhcn:954a410a0fb909bd283a4098",
      "kind": "character_system_text",
      "source_text": "哦哦，非常感谢！下场比赛我也会加油的！",
      "source_fingerprint": "99899961abcac4573040e77dce1670511a6b546ac255216c5ee5b7249e58d1ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30005"
      ]
    },
    {
      "uid": "zhcn:4ad4ceb55cfebfb35f2b5bea",
      "kind": "character_system_text",
      "source_text": "真是场盛夏的激战呢！",
      "source_fingerprint": "9006ede2475aaedb810fc0a6cd05f1ac6362228a7fa9afefb97bc8c3814a89f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30006"
      ]
    },
    {
      "uid": "zhcn:ef79f078cf25e9592bd20ff9",
      "kind": "character_system_text",
      "source_text": "哦哦，非常感谢！下场比赛我也会加油的！",
      "source_fingerprint": "99899961abcac4573040e77dce1670511a6b546ac255216c5ee5b7249e58d1ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30007"
      ]
    },
    {
      "uid": "zhcn:9c8553db7bfd7b83fb4dddf7",
      "kind": "character_system_text",
      "source_text": "我现在是……全日本最幸福的人！",
      "source_fingerprint": "d18971892d84390e1385c8d4a2a7b3158dd53bf67112a26e3e768ffff06bfbdd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30206"
      ]
    },
    {
      "uid": "zhcn:9bb7ad2b6aecf2502144b200",
      "kind": "character_system_text",
      "source_text": "哦哦，非常感谢！下场比赛我也会加油的！",
      "source_fingerprint": "99899961abcac4573040e77dce1670511a6b546ac255216c5ee5b7249e58d1ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "30207"
      ]
    },
    {
      "uid": "zhcn:f7eb9f69e565b7f0f3c03c8f",
      "kind": "character_system_text",
      "source_text": "上了！",
      "source_fingerprint": "685c098711a27a637f325eabde144ab41f542d4c61533aa66ba1b9b4e40e6819",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "31000"
      ]
    },
    {
      "uid": "zhcn:6ae7faaf787313ff30c19adf",
      "kind": "character_system_text",
      "source_text": "向着梦想全速奔跑！",
      "source_fingerprint": "449f2ad1b3ae2580f5b9359829821e1d0d15e9381209c03a5d619d3d9b798fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "40000"
      ]
    },
    {
      "uid": "zhcn:832b0c24b5b6b7e89f7b5556",
      "kind": "character_system_text",
      "source_text": "特雷森学园的转学考试，\r\n难度真高啊～…\r\n直到现在都不敢相信自己考过了…",
      "source_fingerprint": "b96531c10f48f832636d102dd04926d1211484be303eb898802b89c1699ada85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400000"
      ]
    },
    {
      "uid": "zhcn:a61469becabc63f74fb45bcb",
      "kind": "character_system_text",
      "source_text": "被马娘们包围也好，\r\n和同龄人们共同生活也好…\r\n第一次的事情太多了啊～…！",
      "source_fingerprint": "77af738426a449e3a7d0fa45475a3904d63b191be7be944fd7b5b5bd58d3ce59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400001"
      ]
    },
    {
      "uid": "zhcn:941564bf024dc5b7de592526",
      "kind": "character_system_text",
      "source_text": "宿舍的食堂里我最喜欢的菜，\r\n已经做好了…诶嘿嘿♪",
      "source_fingerprint": "5822ddc2e69cdf88ee13d1b18ebb5d3e36e7c11d9c32d72c8a917b6fdd6f8d5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400002"
      ]
    },
    {
      "uid": "zhcn:28a21b8cb8a4c7b4f2e724aa",
      "kind": "character_system_text",
      "source_text": "对了，给妈妈写信…\r\n还太早了呢。之前因为没习惯学园\r\n而被骂了…",
      "source_fingerprint": "86aaeb49308320d7159843ab064f3d8a6b2db9cb01382d5d003146de5dd0a06c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400003"
      ]
    },
    {
      "uid": "zhcn:55f38fa7c510cf130a68e391",
      "kind": "character_system_text",
      "source_text": "小草和小鹰，\r\n模拟赛的成绩好厉害…\r\n那两人，都很优秀啊…",
      "source_fingerprint": "18c224a17016ea5d2ee364ffe8b708f63723635374bdda1a7d618b8154dff127",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400004"
      ]
    },
    {
      "uid": "zhcn:2ffc22dab84a420b99d58c1c",
      "kind": "character_system_text",
      "source_text": "…铃鹿同学，会不会觉得\r\n一个人住房间比较安静\r\n会更好呢…？",
      "source_fingerprint": "88f878931f5bee2480f71b947af1c33debd551997f2d13f3e098b1e3681d9fa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400005"
      ]
    },
    {
      "uid": "zhcn:b0080fb30cd470af8459c8ea",
      "kind": "character_system_text",
      "source_text": "…好。好好吃饭，\r\n好好睡觉…然后，我也…！",
      "source_fingerprint": "58898b2ab0b2b2e390e62de8b72799ddddaf825a06185d0da793906881aca164",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400006"
      ]
    },
    {
      "uid": "zhcn:3805294c5472f3ac61f3bab2",
      "kind": "character_system_text",
      "source_text": "帝王同学，小小的又\r\n活泼开朗…但是，\r\n真的是很帅啊。",
      "source_fingerprint": "537629b32b5f41b2b1716ce0bae61b9b7de1c085fc59c83e20d4ebcd4a59d774",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400007"
      ]
    },
    {
      "uid": "zhcn:18ea8f99ccff751405c20a4b",
      "kind": "character_system_text",
      "source_text": "…妈妈。\r\n我…感觉马上就能\r\n充满自信地去写信了…！",
      "source_fingerprint": "f1bb20473e796e536df456d1905a84d5248f33dd7f7cffcbd8c7c70e77439d89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400008"
      ]
    },
    {
      "uid": "zhcn:a59cebfb88e7387ef271321c",
      "kind": "character_system_text",
      "source_text": "对了，马上就要到选拔赛了…！\r\n我会遇上什么样的\r\n训练员呢…？",
      "source_fingerprint": "339b31ed42bde086ec59d0c66e5c5d503536e9d2b3d57c44c5764284fe247226",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400009"
      ]
    },
    {
      "uid": "zhcn:9a0c5ebfdcecf7f652bedb93",
      "kind": "character_system_text",
      "source_text": "哇啊…哈啊～…好ー！请好好看着我哦，妈妈！",
      "source_fingerprint": "9c317be510e9568236f4663b97bf4f3d57bed17be9ab0a6b412b77fe0f9cff22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "40001"
      ]
    },
    {
      "uid": "zhcn:413c1fa943b8b64ff366d260",
      "kind": "character_system_text",
      "source_text": "下个休息日，我要和铃鹿同学\r\n一起出去了！\r\n哇哇哇，去哪里好呢…！？",
      "source_fingerprint": "855b5739399b2234bbf776310561f575f8aae01e0247467fe6b646872c36c385",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400010"
      ]
    },
    {
      "uid": "zhcn:fd3c92a3b8c461024f3a5bd0",
      "kind": "character_system_text",
      "source_text": "小鹰和小草，邀请我\r\n参加放学后的特训…！\r\n嗯…好，加油咯ー！",
      "source_fingerprint": "23e9e9a5800c9357b8865eccb914e7cc0c3c5e15de0710fa3236ba498b090683",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400011"
      ]
    },
    {
      "uid": "zhcn:dfbaa99d68a0aee80a566145",
      "kind": "character_system_text",
      "source_text": "活动虽然已经结束了…\r\n但现在是时候开始，\r\n向着梦想奔跑了！",
      "source_fingerprint": "367097eb4d96694cf7ba1f6c73c17c3ef35b57561cf727bd4a81b4c4b11d33b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400014"
      ]
    },
    {
      "uid": "zhcn:24b39b42d6ae8ea2c995ad01",
      "kind": "character_system_text",
      "source_text": "哎呀！？至今为止，\r\n我是怎么跑的来着！？",
      "source_fingerprint": "053da5e839a15966c8e9067799bc4af339e7ad93cc8ee65cbd7332f0e0c991d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400017"
      ]
    },
    {
      "uid": "zhcn:9c2b586a6e0780c41c5ed98e",
      "kind": "character_system_text",
      "source_text": "我决定了。\r\n我…要认真地去玩！",
      "source_fingerprint": "6efa43bec8e3230b6f3720d897569a27d003562ab455cf6c7b1d6269b0d0bab5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400018"
      ]
    },
    {
      "uid": "zhcn:6a4607893f904b7cd857d9cc",
      "kind": "character_system_text",
      "source_text": "诶！妈妈也去过\r\n泡沫乐园的吗！？",
      "source_fingerprint": "4e88f1478b3a689f0c70eb27120d60ff6dcd323df5185b5535c8f118cae30c57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400019"
      ]
    },
    {
      "uid": "zhcn:8424db7e81cbf5d4984a4cd3",
      "kind": "character_system_text",
      "source_text": "可能是因为练习开心吧，\r\n每天的饭都很好吃！\r\n一不小心就吃多了…",
      "source_fingerprint": "89e60e8b3cda2179a819a81fbfad4e98c55ab72badaa3ba42e8b95f7a82a457e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400026"
      ]
    },
    {
      "uid": "zhcn:f493888b735285078f3838f7",
      "kind": "character_system_text",
      "source_text": "创造出难以忘怀的回忆吧！",
      "source_fingerprint": "4f94f6a1fb8458b7023dd383a99193b5acb4955ec3cbd6a3059a36e22702b7c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "40003"
      ]
    },
    {
      "uid": "zhcn:d79f3dc722eacddea5adc76a",
      "kind": "character_system_text",
      "source_text": "那间神社能结出这么美味的柿子……\r\n一定是个好地方！\r\n好～我也来帮忙～！",
      "source_fingerprint": "dceb5d0927e93565165db2e7d2039d8dbca0a8070332bb0a2e25d56f89324b3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400036"
      ]
    },
    {
      "uid": "zhcn:249016c771eb1921d7fe97d5",
      "kind": "character_system_text",
      "source_text": "尽情享受夏日吧――呜哇！？\r\n啊哇哇ー！？…哇～～♪",
      "source_fingerprint": "92f941d594a04993e2defab4ebe3416389d6d26a09a74bbd5298ac3961e660d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "40004"
      ]
    },
    {
      "uid": "zhcn:af7c6c14c212c5e11a26248e",
      "kind": "character_system_text",
      "source_text": "新年快乐！\r\n听说撒年糕仪式大受好评呢。\r\n耶嘿嘿，我也好想快点吃到！",
      "source_fingerprint": "1d51f6dd4b2d4f7b1cb156f1358f5fd02d8ebdcb5ec6806056d289506cb65018",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "400043"
      ]
