      ]
    },
    {
      "uid": "zhcn:6cce8f1848c5b5eb3443efca",
      "kind": "text_data",
      "source_text": "掲げる信条",
      "source_fingerprint": "e718d8dad031b9d2a5a7850f94f60fbe6f72d85efd9acb617929841b35b19195",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124006"
      ]
    },
    {
      "uid": "zhcn:ff5d824c8c94346c584f7737",
      "kind": "text_data",
      "source_text": "信じる瞳",
      "source_fingerprint": "399debcbd02e0b2e7f035b87d7a9ae21701fd7682a4e9c870cf93c8c6b6d2844",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41124007"
      ]
    },
    {
      "uid": "zhcn:69165ff6818c52495a167a9e",
      "kind": "text_data",
      "source_text": "杏目",
      "source_fingerprint": "b632be927b5d52ab85b0cfae236cdc76e44b41d48ba6e925027a4013417d1d5f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129001"
      ]
    },
    {
      "uid": "zhcn:6c533ef4d99562aa7674cb3f",
      "kind": "text_data",
      "source_text": "渴求胜利的、那双闪耀之瞳",
      "source_fingerprint": "bf3979b26fc16acfbdccf9514e1cca6ba57973faebd33e6277e8631f6a00d503",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129002"
      ]
    },
    {
      "uid": "zhcn:d48d09c6ff0652f96afde4d5",
      "kind": "text_data",
      "source_text": "纵使耀眼得令人目眩",
      "source_fingerprint": "be8fb3034930b23e88b233ea42dbde523a0d90832292a84a0ed4200699be0877",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129003"
      ]
    },
    {
      "uid": "zhcn:67e2fe47a4f03628dacb20ec",
      "kind": "text_data",
      "source_text": "携手走向前人未至的未来",
      "source_fingerprint": "6089125714c76b3890ec24e19af5b1ea5b7175ccf532d4f45180ba0231de0c52",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129004"
      ]
    },
    {
      "uid": "zhcn:d3a7610bdc9cccde67dba1b5",
      "kind": "text_data",
      "source_text": "一、二，诱入梦乡",
      "source_fingerprint": "d26dd99079aa0a369ac6b299823cf08dba8c2dc66f6f0ba359fb0696df48f6bf",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129005"
      ]
    },
    {
      "uid": "zhcn:9bda6f372e00f29f91f47878",
      "kind": "text_data",
      "source_text": "毫不犹豫地，向着那道光芒伸出手",
      "source_fingerprint": "b30950a7617c6e8a2a060c71a912c4ec0a2c59c2f86a2beb094d47983ad12fba",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129006"
      ]
    },
    {
      "uid": "zhcn:54bc1ee2775eb7fcbc8317d5",
      "kind": "text_data",
      "source_text": "紧紧抓住心灵，她的名字是——",
      "source_fingerprint": "2fc1ed051cb283f09380261dcd9784f1fe9c223e2d3413ddf0679343c83ded8e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41129007"
      ]
    },
    {
      "uid": "zhcn:aac59e4f1519d68e4977c983",
      "kind": "text_data",
      "source_text": "春日和煦，初露枝芽",
      "source_fingerprint": "92f97dfb9025af16d9616bdc22b3c69d38343999e292462b5632758b36d2b8d3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130001"
      ]
    },
    {
      "uid": "zhcn:8d1e8bab33415175cf9cc8a7",
      "kind": "text_data",
      "source_text": "仍是蓓蕾，于威风中摇曳",
      "source_fingerprint": "ec426a0b8d176889660094b50e7f9179f4b5f0ca2165635b04d4720249ed92c1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130002"
      ]
    },
    {
      "uid": "zhcn:71baf0aa404b4fa85ad7b3ed",
      "kind": "text_data",
      "source_text": "暮色沉沉，然拂晓终至",
      "source_fingerprint": "9f1ea93f4a6e176e102ad12a36865e9188e731e87cbfb0f35b7808f6c65f8dfc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130003"
      ]
    },
    {
      "uid": "zhcn:1d62b16e2e81cd860f27185b",
      "kind": "text_data",
      "source_text": "盛放之紫丁香，当此时节！",
      "source_fingerprint": "b2b4d61a35053d86efa07883d661c1d4d9378f9390540f1853b3b5d1a5221857",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130004"
      ]
    },
    {
      "uid": "zhcn:cae1e1d9f5e4247734786495",
      "kind": "text_data",
      "source_text": "纵然一朵紫丁香，隐于薄云之中",
      "source_fingerprint": "2817ad044dfece4b779116aeda220284d4fe208910a2401ca1e7d030dc12ce49",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130005"
      ]
    },
    {
      "uid": "zhcn:ab3046c094bfb26322fb653b",
      "kind": "text_data",
      "source_text": "清风拂过，阳光满溢",
      "source_fingerprint": "efe45c35a700b129faddf04f69257f1439711881e5fe09d0d515d634fcaedce5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130006"
      ]
    },
    {
      "uid": "zhcn:ca1c21574f488a95f65818bd",
      "kind": "text_data",
      "source_text": "笑颜绽放，幸运的一片",
      "source_fingerprint": "64076e52f5b9ed85c0af89eb1010bcdf296702ddd968ad5d7e0aaf0db26da6ad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41130007"
      ]
    },
    {
      "uid": "zhcn:b9e9817216a28519c81e0b3a",
      "kind": "text_data",
      "source_text": "隔着屏幕的“爱”",
      "source_fingerprint": "77edb6659c44293269f9ea3d2118cd1f4ea8338419a1580db291453c5d35c73d",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132001"
      ]
    },
    {
      "uid": "zhcn:55e7f816ba4548a390123ea7",
      "kind": "text_data",
      "source_text": "各种各样的“爱”",
      "source_fingerprint": "b4bcc741ca347e2b5f829e7e581e9ef3d89989b9abf4fa691d01cd566cadeec9",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132002"
      ]
    },
    {
      "uid": "zhcn:e3c67758dd6dff2e9bf76091",
      "kind": "text_data",
      "source_text": "为谁而存在的“爱”",
      "source_fingerprint": "22777f98b8b1c018214c1d9c070e0fa288a79f2f4e93058a6d8f41475387384f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132003"
      ]
    },
    {
      "uid": "zhcn:ac3cf2e7374a0cc8be10bf58",
      "kind": "text_data",
      "source_text": "起始的“爱”",
      "source_fingerprint": "25af03beb9df7dc101b0e73a78d99d477dcea23518950ca8727fe723ac3494dd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132004"
      ]
    },
    {
      "uid": "zhcn:0a482ef04fd77dd8be93ef2a",
      "kind": "text_data",
      "source_text": "常伴于身边的“爱”",
      "source_fingerprint": "95fc149948f899ffee4a984077b39260133bbd9f5fdafc00c2c476add5501326",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132005"
      ]
    },
    {
      "uid": "zhcn:63e7d0683c8708cd1dd2beee",
      "kind": "text_data",
      "source_text": "特别的“爱”?",
      "source_fingerprint": "838bb4eb4976c000f1982e08eed12ba30c532c8f41b6e7c839385bb26543118f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132006"
      ]
    },
    {
      "uid": "zhcn:b46c8655902ae10aac44c6fc",
      "kind": "text_data",
      "source_text": "相互连结的“爱”",
      "source_fingerprint": "9d45301f89b741ec34a2cfcc45b2bd238472a603f17a496f75eec2f1fd18a7ed",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41132007"
      ]
    },
    {
      "uid": "zhcn:90a9d66154870634d58052a0",
      "kind": "text_data",
      "source_text": "第1章 近代赛跑的所在地",
      "source_fingerprint": "d7e64802e7bcf346d333057e382c56f471c5373e67f66cde8ec9ef5b766d74e2",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133001"
      ]
    },
    {
      "uid": "zhcn:defba8fcde91e9d85cd81ddc",
      "kind": "text_data",
      "source_text": "第2章 新星的崛起",
      "source_fingerprint": "a389d5af80661112a674d62be2a1370efa909807a5c6fbd6a97edd76d780f7b3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133002"
      ]
    },
    {
      "uid": "zhcn:dbeb6a12670b83a054b69c6a",
      "kind": "text_data",
      "source_text": "第3章 历史所具有的“引力”",
      "source_fingerprint": "ca7a8e160c616e31f648c0433a147ad6c31d8ab3d9125c89eb464ec0c140e235",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133003"
      ]
    },
    {
      "uid": "zhcn:8759b5d37c28aeaaf19a3687",
      "kind": "text_data",
      "source_text": "第4章 创世之黎明",
      "source_fingerprint": "fff16858c63d9be13012286d36cd548c51d118de00d1b567500952a74e5d3a48",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133004"
      ]
    },
    {
      "uid": "zhcn:764a2748f98afc62d0105668",
      "kind": "text_data",
      "source_text": "第5章 预想外的所见之物",
      "source_fingerprint": "cd33d323e25af3af936f93a963336bd31f39468d97881625543b43b0bb278233",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133005"
      ]
    },
    {
      "uid": "zhcn:30b632dfcfe4e391dca38a66",
      "kind": "text_data",
      "source_text": "第6章 源于热情的个性",
      "source_fingerprint": "630418e479ced482100eb293eb30d77f81552c924987eb45fa2d15e1c9d51188",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133006"
      ]
    },
    {
      "uid": "zhcn:c5f4f8894f1f6c7c6c292b29",
      "kind": "text_data",
      "source_text": "第7章 踏寻历史足迹的夏天",
      "source_fingerprint": "623905b67d353766b501f722926df1f44fd03172821ec7ad9e64613144e0525b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41133007"
      ]
    },
    {
      "uid": "zhcn:275729f9cdb34b9e8638f8a5",
      "kind": "text_data",
      "source_text": "纯白香豌豆温柔摇曳",
      "source_fingerprint": "eb4647ae298b948f7263886663e7b7d0063dc35fa9f034846be20b6296fa6c9e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134001"
      ]
    },
    {
      "uid": "zhcn:29b9713f87df5d36a3e6fa07",
      "kind": "text_data",
      "source_text": "宛如散发幽香的山茶花",
      "source_fingerprint": "147bf54691116d04e9be0e22507b2428030f92720e339c01a98863de73dfcf24",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134002"
      ]
    },
    {
      "uid": "zhcn:4e8871f9826b7373da34846f",
      "kind": "text_data",
      "source_text": "依偎在斗篷草旁",
      "source_fingerprint": "08aacf1cee651505303d518a7654e2549afda464e8602cc40476823d30f38244",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134003"
      ]
    },
    {
      "uid": "zhcn:6e7eb2aef1eee47142e2531a",
      "kind": "text_data",
      "source_text": "束起嘉兰百合",
      "source_fingerprint": "59d4e8739d67cd4ca73b7e4ca12500115bfb71b3ba2dfe4a78e3dd8ca6bfff8b",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134004"
      ]
    },
    {
      "uid": "zhcn:b98ad9727bf95a7abb8f5af9",
      "kind": "text_data",
      "source_text": "悄然凝望薰衣草",
      "source_fingerprint": "a19ebcf7cde535cfbdf350f9cce052a58e584098f880c45af1dddb1b10fa54fb",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134005"
      ]
    },
    {
      "uid": "zhcn:cbc95bea1ad545912c7cc784",
      "kind": "text_data",
      "source_text": "绽放的矮牵牛",
      "source_fingerprint": "2ba65fcb7885151faecd89a9c55c31df18ce2b40b6df8ce43be6242dc6e1faab",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134006"
      ]
    },
    {
      "uid": "zhcn:15a736da2ef8a3ce143ba16c",
      "kind": "text_data",
      "source_text": "盛放的粉色天竺葵",
      "source_fingerprint": "725133d7a92a728daa0d42a3594bf1457a4f9306a1cff89fabc03fc7b05c1cad",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41134007"
      ]
    },
    {
      "uid": "zhcn:74d12210dd4a61f86dd01a43",
      "kind": "text_data",
      "source_text": "叙说来自终点的事迹",
      "source_fingerprint": "7e3ab1a069430f5180cd702772f5f054b6ea2ce6bb905c17e7c99f9d54c06258",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135001"
      ]
    },
    {
      "uid": "zhcn:2ff55615984dd16ffa0cfd29",
      "kind": "text_data",
      "source_text": "其名闪烁深沉光芒",
      "source_fingerprint": "4af1178eb79871fae1348ea66cae363b6e94e662a23e7489777e01c0c782b243",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135002"
      ]
    },
    {
      "uid": "zhcn:9a9322f4530868406788721c",
      "kind": "text_data",
      "source_text": "并非此地的彼方",
      "source_fingerprint": "74aff8c93309d464a675597fead99d0fb9593c3902785d36b36049ff2dc8480a",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135003"
      ]
    },
    {
      "uid": "zhcn:3043e3d184012aaaf54dbf63",
      "kind": "text_data",
      "source_text": "永恒的开端",
      "source_fingerprint": "de51464fdb96f48e5921e5df1bea211823bd67281e58a8fd8554e54450cdd74f",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135004"
      ]
    },
    {
      "uid": "zhcn:5a37fb59111e73115ff80990",
      "kind": "text_data",
      "source_text": "那是通往绿洲的桥梁",
      "source_fingerprint": "005499b4279bc3ba7d6ab6fdea37cc9bf480301ff7ece08009b565d8deba86cd",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135005"
      ]
    },
    {
      "uid": "zhcn:26a96eff287b3f5172d35910",
      "kind": "text_data",
      "source_text": "包里装着好奇心与空白地图",
      "source_fingerprint": "bc791c5f51ecf6e723388cf3fa7c9439719527b27819fee4f6eacb62736111a1",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135006"
      ]
    },
    {
      "uid": "zhcn:132098c35414e19936afca86",
      "kind": "text_data",
      "source_text": "旅途有伴世间有情，坎坷亦是黄金路",
      "source_fingerprint": "d59bbf1368aaaa784c0164713356c440b91b8e7a7d02a5395b3da270f4f6c9da",
      "source_path": "text_data_dict.json",
      "json_path": [
        "92",
        "41135007"
      ]
    },
    {
      "uid": "zhcn:aa48632c5b59a9a11da499d0",
      "kind": "text_data",
      "source_text": "圣女的降临",
      "source_fingerprint": "331ecb1620d90aabd4256488025d4fce6a6fe0f63de0adb8a2d715c6f8b7942d",
      "source_path": "text_data_dict.json",
      "json_path": [
