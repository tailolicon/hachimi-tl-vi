      ]
    },
    {
      "uid": "zhcn:9457b495ce825e031d929ab3",
      "kind": "character_system_text",
      "source_text": "从今以后也多多指教了，训练员！\r\n毕竟要实现无敌的帝王传说的话，\r\n可不能没有你啊！",
      "source_fingerprint": "1956704cc257d217e34ffb3dec9b16701a49241948fa3c3ba661cd91ecff851a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
