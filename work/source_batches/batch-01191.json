  "entries": [
    {
      "uid": "zhcn:a9f447483ef49840f1daf566",
      "kind": "character_system_text",
      "source_text": "是大海哒～！",
      "source_fingerprint": "18bf89c2b98da07d2e2403cca244f6433a2acc94223c7d12959fa1030a37b4e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "20047"
      ]
    },
    {
      "uid": "zhcn:c9a830bed11335a4e61022e3",
      "kind": "character_system_text",
      "source_text": "我，很强对吧？",
      "source_fingerprint": "ad2766abb64d197c3d94499f0ea910c60848a0fb2033196e742627617a44bdb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "20049"
      ]
    },
    {
      "uid": "zhcn:6e6a57c3aa051215fffb45ed",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "20050"
      ]
    },
    {
      "uid": "zhcn:c8272141cd2cda1878bf7f96",
      "kind": "character_system_text",
      "source_text": "撒，鼓足干劲地上了哦！",
      "source_fingerprint": "ab6f15798fbfa149fd364d1079852bf66d95ec108522bd6f0c01cf999c9770ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "20051"
      ]
    },
    {
      "uid": "zhcn:fb0054c6c998f1e04c651819",
      "kind": "character_system_text",
      "source_text": "我会赢的哦！",
      "source_fingerprint": "a844393e501319440e2d1cb2c9db2bed92003382707539d348a8b6940ce09696",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "2030"
      ]
    },
    {
      "uid": "zhcn:4a6946f725a0b0437b3f8969",
      "kind": "character_system_text",
      "source_text": "大家、鼓起劲地上了哦——！",
      "source_fingerprint": "92faa69de31812bd3ff893fff63f29f01c0a3ab8470f8c433047933075118951",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "2031"
      ]
    },
    {
      "uid": "zhcn:9d352881bf08dd78904c74ce",
      "kind": "character_system_text",
      "source_text": "谢谢你、训练员！",
      "source_fingerprint": "099986536521a89f332afc67db8e4df1eddb9bfadea0462586262284b167f3a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "2032"
      ]
    },
    {
      "uid": "zhcn:bf35c54b11f2cf558e6e7f12",
      "kind": "character_system_text",
      "source_text": "呜哇～、好想赶紧\r\n“蹦蹦”地跑起来啊～！\r\n我已经等不及想听到比赛开始的信号了……！",
      "source_fingerprint": "986bacb6c278dc1000a118db02430778def93b4085abee7708de644c0e0df567",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b09f259e8354e20942ceb0cd",
      "kind": "character_system_text",
      "source_text": "反正最后的赢家肯定是我，\r\n要不就趁着现在想想\r\n到时候在领奖台时要说什么好了～♪",
      "source_fingerprint": "a04eadf2a539e55666e00b26c3f1ad9629a0f2dabdd6ed8dbb3ef377a64089f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "2034"
      ]
    },
    {
      "uid": "zhcn:51bb069a2390f2bc48c3e69d",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "2035"
      ]
    },
    {
      "uid": "zhcn:f817e62f1eed6a4a01900c37",
      "kind": "character_system_text",
      "source_text": "よ～し！",
      "source_fingerprint": "a545e34018bb476c1937d0e70712c253f155b600f2b41e78e754e284e3615b71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "23015"
      ]
    },
    {
      "uid": "zhcn:c67f7de2747ba07e4b8a1a52",
      "kind": "character_system_text",
      "source_text": "下一次我可不会输了～！",
      "source_fingerprint": "4be9a983ec75596c2ed9ef42bd62d6b17c7709db551781bf8c8a8edb755bb172",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30000"
      ]
    },
    {
      "uid": "zhcn:e15d75ce6de51200f16e8c17",
      "kind": "character_system_text",
      "source_text": "明明就差一点点了～！",
      "source_fingerprint": "cb2839f616f0a0be161e8b28877bef0906cb9cf9f946f7eb6d0433e8c8dc44d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30001"
      ]
    },
    {
      "uid": "zhcn:e38648eeef07abc9bbbb576f",
      "kind": "character_system_text",
      "source_text": "姆～姆，这种结果我可无法接受啊～！",
      "source_fingerprint": "da0c35a4ca5d6c96fc5a60941643a03ba996810747f4592e63ca98efbea565b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30002"
      ]
    },
    {
      "uid": "zhcn:38c89d2809b92a9d3953bfc4",
      "kind": "character_system_text",
      "source_text": "这种事什么的，肯定有哪里出问题了！",
      "source_fingerprint": "e845ec8524602bb6e20fba7c9714d370cb6dd1ff4c6c0188e172f8e2fd01c8bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30003"
      ]
    },
    {
      "uid": "zhcn:b26551524415a1627a523f87",
      "kind": "character_system_text",
      "source_text": "嗯哼，看到了嘛！这就是帝王大人的实力！",
      "source_fingerprint": "3850ecb4d9b20caa9bdca42c4daf5a7b479c59387d5fc2012a88450d6e83b3f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30004"
      ]
    },
    {
      "uid": "zhcn:c8484c8739fe7e1ab7e35412",
      "kind": "character_system_text",
      "source_text": "轻轻松松，下次的第1名！我也会拿下的！",
      "source_fingerprint": "8def2a8a589602b0e19f5313c0efc5f94684da10c2cdd589433aae5a7f337e42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30005"
      ]
    },
    {
      "uid": "zhcn:c6963899f713de681e8f81b8",
      "kind": "character_system_text",
      "source_text": "HOP！STEP！……大胜——利！VV！",
      "source_fingerprint": "e4b0e9fc9688c505afc3f9277c6819ce28a473d44e602f9590ac178852af25c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30006"
      ]
    },
    {
      "uid": "zhcn:c0901bb83813f439e449165c",
      "kind": "character_system_text",
      "source_text": "轻轻松松，下次的第1名！我也会拿下的！",
      "source_fingerprint": "8def2a8a589602b0e19f5313c0efc5f94684da10c2cdd589433aae5a7f337e42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30007"
      ]
    },
    {
      "uid": "zhcn:a2bf04e67a8ac9b673d246da",
      "kind": "character_system_text",
      "source_text": "これにて終幕！\r\nまさに神業、だったでしょ？",
      "source_fingerprint": "4f7dc2ac031375e4b73b6af7da4a433b0df3a86604badd6e06f3ba1589c1a229",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30206"
      ]
    },
    {
      "uid": "zhcn:155b95f0abd8a55fbf3abff3",
      "kind": "character_system_text",
      "source_text": "轻轻松松，下次的第1名！我也会拿下的！",
      "source_fingerprint": "8def2a8a589602b0e19f5313c0efc5f94684da10c2cdd589433aae5a7f337e42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "30207"
      ]
    },
    {
      "uid": "zhcn:faf894939154379c7d645d77",
      "kind": "character_system_text",
      "source_text": "要上了！",
      "source_fingerprint": "1517fbd3c7a4b1a9bc6c0f2a21ca4dcc3ad0db20e4ce267cdba0767e3af1e843",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "31000"
      ]
    },
    {
      "uid": "zhcn:e870aaca4dc686c0ce972933",
      "kind": "character_system_text",
      "source_text": "赢家肯定是我，帝王大人哒！",
      "source_fingerprint": "30a4a53a3e2e689ba772203bf68ac59989b59e4b440ef4dd9e218ac116c5e33c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "40000"
      ]
    },
    {
      "uid": "zhcn:5a89ccef9696b805efd5d104",
      "kind": "character_system_text",
      "source_text": "走るのってホンットにキモチイイ！\r\nこれからもたっくさん、みんなに\r\nカッコいいところ見せるぞ～♪",
      "source_fingerprint": "b5314b4ca18f8f542d2539ffce9ec54ec9850e9b0f76b0c53b0200bf40bfb95a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400000"
      ]
    },
    {
      "uid": "zhcn:345337fd56581ce1e743c4e0",
      "kind": "character_system_text",
      "source_text": "ボクが強い理由？\r\nへへ、それは…\r\nヒミツ♪",
      "source_fingerprint": "912dc2ef795c60a86a49b5617eeb61ec8cf82c36628c3c71d007b762b28e5475",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400002"
      ]
    },
    {
      "uid": "zhcn:e1033542716f38be06e4ee65",
      "kind": "character_system_text",
      "source_text": "不管是比赛或舞蹈，\r\n赢家的宝座都是我的！\r\n这才是帝王大人，对吧？",
      "source_fingerprint": "233373e5a040d6078e4dc6a6dfefb367273af579e0dc866de607961b71ad36e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400004"
      ]
    },
    {
      "uid": "zhcn:6d2bfb4a5e35e49284f7f7b4",
      "kind": "character_system_text",
      "source_text": "正式上场的服装是很帅气\r\n没错啦……嗳～麦昆。至少\r\n蝴蝶结让我绑松一点好不好～？",
      "source_fingerprint": "1a6c4718562887c8fdff9a6a0c7bf156fd5cc2ab4f739559bc47355a6f8db3dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400006"
      ]
    },
    {
      "uid": "zhcn:eaef11664112083b96575a55",
      "kind": "character_system_text",
      "source_text": "目标当然是让所有人\r\n都能开心的完美结局啦！",
      "source_fingerprint": "721bf66b4aed4623310e4f6fddaa2fe7a88dbde56150c019efd02244f529bbd0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400008"
      ]
    },
    {
      "uid": "zhcn:10cad2a29cdcaf9ed09a9f2e",
      "kind": "character_system_text",
      "source_text": "究——极！无敌的——！嘿！帝王舞步哒！",
      "source_fingerprint": "3f81d8071b073729de17839c762ee3f84795c094de7bd9f218e580112382cfb1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "40001"
      ]
    },
    {
      "uid": "zhcn:2e6a8c487b42e39a0501c039",
      "kind": "character_system_text",
      "source_text": "すごい熱気だった…\r\nきっと、歴代で1番だ。…絶対に。\r\n――見てたか、シンボリルドルフ！",
      "source_fingerprint": "a21ca414a5f699d9aa99a6aacee160776779d3ff52b81f28d5aeb50164e8d6c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400010"
      ]
    },
    {
      "uid": "zhcn:d7ed992a62bcdf47628ff095",
      "kind": "character_system_text",
      "source_text": "欢迎来到活动任务。\r\n看来……你不需要我的领导啊。\r\n……嘻嘻嘻，加油哦～♪",
      "source_fingerprint": "50550f893498676b01f4cf10611f4e298e83fa4ac8a7b72ed81b0f9258f6c322",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400012"
      ]
    },
    {
      "uid": "zhcn:b6a0f5581e8d8a244cc0b154",
      "kind": "character_system_text",
      "source_text": "辛苦了。\r\n帝王大人来称赞你的努力～\r\n尽管收下奖励吧～♪",
      "source_fingerprint": "1d9aaae985f6b0d9e31f286a232be9e28b8f996281a2d3866a9d920660a9cca8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400013"
      ]
    },
    {
      "uid": "zhcn:0c6b0c08b5ec86e0b0ca8303",
      "kind": "character_system_text",
      "source_text": "绝对要赢——！",
      "source_fingerprint": "c6096e4ebe68fc27f2f6a93935da80b335e676150475d56f5b6ae37487156627",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "40003"
      ]
    },
    {
      "uid": "zhcn:88a87350de3ed078654d8589",
      "kind": "character_system_text",
      "source_text": "她们三人一起拍的广告真是帅气！\r\n广告里有拍到几处街景对吧？\r\n好想快点实际去玩玩喔～！",
      "source_fingerprint": "c1d1a5b0401724add52dceafd2b95be30b0e4419b07f9c02b1849ca9e27e42cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400031"
      ]
    },
    {
      "uid": "zhcn:f23759c38b6e2d477b367aa5",
      "kind": "character_system_text",
      "source_text": "……用这股力量的话……！\r\n哈啊啊啊啊！帝王传说从这开始——！",
      "source_fingerprint": "112b4c2990d676d373108b873f3f674db0e4a26a76a49ef1006a2979369bb421",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "40004"
      ]
    },
    {
      "uid": "zhcn:45244b95df93fc62c8dda89e",
      "kind": "character_system_text",
      "source_text": "カイチョーの後を継ぐのはボク！\r\nカイチョーを超えるのもボク！\r\n誰にも譲らないもんね。",
      "source_fingerprint": "a50ce0679d08fd1149635a43267daec4129677ea3896034ac0d654737d1c00f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "400061"
      ]
    },
    {
      "uid": "zhcn:ab6475480f46c8b08ef44c95",
      "kind": "character_system_text",
      "source_text": "テイオーの舞い、ご照覧あれ！",
      "source_fingerprint": "baf08b66ad8e311ea38eadec109f9272f2383223a757809f55b8cbbc7184d4ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "40203"
      ]
    },
    {
      "uid": "zhcn:ab51cbd8c659c93c04327994",
      "kind": "character_system_text",
      "source_text": "流麗に舞う胡蝶にして、\r\nその早駆けは旋風の如し――\r\nどう？ボクに見とれちゃった？",
      "source_fingerprint": "f35fc728fb2212d513141e7b599015f3fd175ecdfab2b620474fe80e8644d1d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "40204"
      ]
    },
    {
      "uid": "zhcn:76ec60654cf13efc5254d04b",
      "kind": "character_system_text",
      "source_text": "我要上啰──！",
      "source_fingerprint": "12061afd2ebc3e8665a88908d6a82610379b1355c7d6cacc914896b1be3e2fb1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410000"
      ]
    },
    {
      "uid": "zhcn:3b98e13e029ccbd6b8a84da2",
      "kind": "character_system_text",
      "source_text": "太棒了～！",
      "source_fingerprint": "f7d8f20cc956a8d520b2af7240c22e9b3d9150c1ad2835de85b9a4cf4eab1a44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410001"
      ]
    },
    {
      "uid": "zhcn:e010aa942440692a5a870f3c",
      "kind": "character_system_text",
      "source_text": "耶──耶──！",
      "source_fingerprint": "0976cd6841156d248a388b0c35447ec43110d4297195e6c6cd3b149e0a42f7fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410002"
      ]
    },
    {
      "uid": "zhcn:9dfccd2e961d349c3419e0c9",
      "kind": "character_system_text",
      "source_text": "耶──耶──！",
      "source_fingerprint": "0976cd6841156d248a388b0c35447ec43110d4297195e6c6cd3b149e0a42f7fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410003"
      ]
    },
    {
      "uid": "zhcn:146feab542468d42ca6e0da2",
      "kind": "character_system_text",
      "source_text": "耶嘿嘿。",
      "source_fingerprint": "7db5ada8caa756d2328205c6fde19074b56213baaec8e7fdffa129f28ec54ddb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410004"
      ]
    },
    {
      "uid": "zhcn:6d4d608f3dac4b8a4f59c547",
      "kind": "character_system_text",
      "source_text": "耶嘿嘿。",
      "source_fingerprint": "7db5ada8caa756d2328205c6fde19074b56213baaec8e7fdffa129f28ec54ddb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410005"
      ]
    },
    {
      "uid": "zhcn:e102ccde0daf4a41d5f63fd3",
      "kind": "character_system_text",
      "source_text": "唔～！",
      "source_fingerprint": "e88e313ab43fde0753eff84b849b3f2ebf0fe875805c0f539cc16b75745c9f1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "410006"
      ]
    },
    {
      "uid": "zhcn:6b181a7cd3dad6d907a8d54f",
      "kind": "character_system_text",
      "source_text": "唔～！",
