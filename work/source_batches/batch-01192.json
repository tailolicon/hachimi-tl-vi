    {
      "uid": "zhcn:498effce1eae2fe27b25eb03",
      "kind": "character_system_text",
      "source_text": "笑容、笑容…！呜啊、已经要出场了吗！？",
      "source_fingerprint": "f628155d9edb9a2e8106a7a221fd9f2d5f0c6f4dc12b310ae17fddac41296dd3",
      "source_path": "character_system_text_dict.json",
