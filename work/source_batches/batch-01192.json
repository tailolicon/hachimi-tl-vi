        "70018"
      ]
    },
    {
      "uid": "zhcn:ec0aaa8ea90c1567b5f24368",
      "kind": "character_system_text",
      "source_text": "我会成为日本第一的！",
      "source_fingerprint": "c5d5096ba1f970d465976c240b11c7dcd2c5505ea1b652bc7d25fdc9e5c579ec",
      "source_path": "character_system_text_dict.json",
