    {
      "uid": "zhcn:581181b589e85a7f6c8b18b3",
      "kind": "character_system_text",
      "source_text": "外出准备完成！",
      "source_fingerprint": "a57ac3febf8685896d0b4afb127d5ea62e4207e93f896de811e2601858f94a91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "70020"
      ]
    },
    {
      "uid": "zhcn:c87a410a5f67d50ae549e970",
      "kind": "character_system_text",
      "source_text": "这套衣服可以让我\r\n吃很多东西也不觉得难受！",
      "source_fingerprint": "24fb0b4aad37f5c35962d1392629463c12806a43c1b03bd1db3469a4f6510073",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1001",
        "70021"
