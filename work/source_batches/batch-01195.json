      ]
    },
    {
      "uid": "zhcn:ab9e1495aab56f12620db272",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员♪",
      "source_fingerprint": "9fde7a0b38279fda5aae2f8a16dcc085bdfda380707bcf0d189a203a4da21fe3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "2037"
      ]
    },
    {
      "uid": "zhcn:d2e878c847c5351e123d16ac",
      "kind": "character_system_text",
      "source_text": "頑張るわ！",
      "source_fingerprint": "51ecddcca49db4c81c7552e3ff0938969a08ac595450eb37876db8db544c3299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "23015"
      ]
    },
    {
      "uid": "zhcn:4f8944bd123ee998bd4abe12",
      "kind": "character_system_text",
      "source_text": "呵呵，下次不会让出前面的位置了。",
      "source_fingerprint": "7651e7a1b2bd059af64f2f4edfc0449f4848da5b0636b6f230cd26aa747a307f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30000"
      ]
    },
    {
      "uid": "zhcn:643f692e15790db3b9584737",
      "kind": "character_system_text",
      "source_text": "成绩还算不错吧？",
      "source_fingerprint": "41a90cbb1a233dc1b1ed507a178f0115a9c530bd5c99af4a34525d6e5f6b5e9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30001"
      ]
    },
    {
      "uid": "zhcn:24568190cc9f843ead867086",
      "kind": "character_system_text",
      "source_text": "感觉没能完全使出全力。",
      "source_fingerprint": "6197949cc7866b928a03124ac7188db18ad35711bff1fbc1fb6263e96d5e2776",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30002"
      ]
    },
    {
      "uid": "zhcn:7bb2bcc7dd04b9dae99c7dc6",
      "kind": "character_system_text",
      "source_text": "被看见我狼狈的模样了……",
      "source_fingerprint": "4cc3d955f1b3a9a3abe243992aa417fedfb891f6213fe97c6f67068475b70d19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30003"
      ]
    },
    {
      "uid": "zhcn:5f65dd4b4964699fc8498a85",
      "kind": "character_system_text",
      "source_text": "好棒啊──下次也要尽情享受哦！",
      "source_fingerprint": "e680cb6137806ea3c79ebe69923a40bc56c480df6d9ddc2cd8f55760c0820302",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30004"
      ]
    },
    {
      "uid": "zhcn:2afe0763d4d64e1392ca86ff",
      "kind": "character_system_text",
      "source_text": "呵呵，下次我也会让你看到我跑在最前面的！",
      "source_fingerprint": "cb904685038cca6be1a793e4b0768008f642901c6f77d4c5af07b7c4e1eba516",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30005"
      ]
    },
    {
      "uid": "zhcn:7e10ea39d185832bf6fc2b4f",
      "kind": "character_system_text",
      "source_text": "呼！真舒服的风──\r\n接下来我也要继续努力哦！",
      "source_fingerprint": "45671f3d065e34125da7853fbbc8bf5f8bdf952adee4a3df27e4af8bae698e4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30006"
      ]
    },
    {
      "uid": "zhcn:13e8fefcc36d1b716ea7b43b",
      "kind": "character_system_text",
      "source_text": "呵呵，下次我也会让你看到我跑在最前面的！",
      "source_fingerprint": "cb904685038cca6be1a793e4b0768008f642901c6f77d4c5af07b7c4e1eba516",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "30007"
      ]
    },
    {
      "uid": "zhcn:73979ea233d45562e2221cce",
      "kind": "character_system_text",
      "source_text": "上场咯！",
      "source_fingerprint": "40c938506ee60c916a2da83f41466b1c7f147d2c4f1100b54dfc723ad9911548",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "31000"
      ]
    },
    {
      "uid": "zhcn:7e62152e6a134e211f25bfc7",
      "kind": "character_system_text",
      "source_text": "要全力冲刺咯！",
      "source_fingerprint": "9d5cd906cd1a01d0e633db0c49bdeb93737cb6946e4ea3fdb0497c9206285502",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "40000"
      ]
    },
    {
      "uid": "zhcn:6bf1ca455f4c694d75ea10c3",
      "kind": "character_system_text",
      "source_text": "水当当又卡哇伊的辣妹们，\r\n一起去舞厅和喫茶店吧♪",
      "source_fingerprint": "6c55efbdc3c44234824b10440d9df6cd72db6f0a86f66469454734045b9ec8a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400001"
      ]
    },
    {
      "uid": "zhcn:1d33710223ab80511415175d",
      "kind": "character_system_text",
      "source_text": "唔呵呵?真期待决赛那一天。\r\n况且小千好像也很努力练习呢……",
      "source_fingerprint": "00bb9f393b1fe44c3dd07eb0f5843e4c0d58367f547328674cf6f680ad518f12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400003"
      ]
    },
    {
      "uid": "zhcn:a83cbc7f24e9e45e41bf1626",
      "kind": "character_system_text",
      "source_text": "嗯嗯，我们的状态都很好呢！\r\n这样一定没问题的！",
      "source_fingerprint": "c5d5dd5d438503f0001601a9d39f8af941f6f03b624500f875f409b2104df4d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400008"
      ]
    },
    {
      "uid": "zhcn:cb378b9f1029b0291cbd29b5",
      "kind": "character_system_text",
      "source_text": "原本还想说不知道会怎样……\r\n结果跑得很棒嘛♪",
      "source_fingerprint": "fab6a8ea4cdf94940b2bd107754bc6867d4cb5d7e13ce594513b2caf06f1dac2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400009"
      ]
    },
    {
      "uid": "zhcn:b700cb2a1539da9daa47f5cd",
      "kind": "character_system_text",
      "source_text": "让你看看引擎的差距。\r\n这就是！我的！油门全开！",
      "source_fingerprint": "5ee0f004c83eae5f1134ee9917a31e99eb6fd0e77bd68e0064c98a3da8f69d33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "40001"
      ]
    },
    {
      "uid": "zhcn:9a5da0ea7df4573d2134ceae",
      "kind": "character_system_text",
      "source_text": "多亏有她点燃我心里的火苗，\r\n才让我度过了最棒的夏天♪\r\n讨厌～真不想回去～！",
      "source_fingerprint": "746a7ee7e4d84c4e97af96e99e010d6e79a67ca09972c686ed5b1462d0953a03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400011"
      ]
    },
    {
      "uid": "zhcn:cd135b017c41eb62a76bd0f8",
      "kind": "character_system_text",
      "source_text": "活动任务在这里哦～！\r\n一定要完成才行♪",
      "source_fingerprint": "7f82127060f8b49b0b174c68ce6bb63920f0382e679bbc9c718c1acce919814d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400012"
      ]
    },
    {
      "uid": "zhcn:932d2910b6494bd764f49d7a",
      "kind": "character_system_text",
      "source_text": "活动任务完成，\r\n辛苦咯。\r\n一定要记得领奖励哦♪",
      "source_fingerprint": "4995148bdcb4a3a26d579feba3c213a4faf95c853d54818ecb589f8c00fb8b56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400013"
      ]
    },
    {
      "uid": "zhcn:c5feae31ebef1e2be4e14d29",
      "kind": "character_system_text",
      "source_text": "夏天到了就要狂热一番！",
      "source_fingerprint": "34315821386319b556fc13708c645497a529c4cef941ba2ad83ae9c61778eee6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "40003"
      ]
    },
    {
      "uid": "zhcn:6fc398986ca5e182022949ba",
      "kind": "character_system_text",
      "source_text": "呼──！谢谢海豚♪\r\n……哇啊！啊哈哈哈哈，很棒哦！",
      "source_fingerprint": "ef88a701ba80b77f864a913191605e19bbf832f9c7e06ad7ccc265976796cd62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "40004"
      ]
    },
    {
      "uid": "zhcn:62c8bb91ed4e0ff8d6e0b20d",
      "kind": "character_system_text",
      "source_text": "那我们一起热力四射吧♪",
      "source_fingerprint": "5c6a098149a2b9e0da1c8a11e2805959c6be7debfccc5f26661e981af7c16c34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "60000"
      ]
    },
    {
      "uid": "zhcn:e6377a9ccf19ae841027de77",
      "kind": "character_system_text",
      "source_text": "我要去炒热气氛咯♪",
      "source_fingerprint": "46f660a42ae19d57128abb36df9e8c13a63cce9bd1d3ab4babacb8c06efdf5b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "60001"
      ]
    },
    {
      "uid": "zhcn:d759ebe92955a8df73294f54",
      "kind": "character_system_text",
      "source_text": "要让我体验到很多愉快的比赛哦♪",
      "source_fingerprint": "59711600b395847e99bef51de7a411c29abe8fda8dce676f2dceb7e2e3ecacbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70000"
      ]
    },
    {
      "uid": "zhcn:b74f65f9115015ed402141a5",
      "kind": "character_system_text",
      "source_text": "跟当时比起来，\r\n我现在有像个受憧憬的前辈，\r\n在发光发热吗？",
      "source_fingerprint": "f27ac2d0493a9163c532b042314a68578ad14b48a9e18aae21304b50421edaa0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70001"
      ]
    },
    {
      "uid": "zhcn:45a418dcfefecfebb737d562",
      "kind": "character_system_text",
      "source_text": "我很「稀饭」学园的制服哦！",
      "source_fingerprint": "9a64b58020a9acb4efd1ac8541283f4e0d32acc855b7b7e793989098ce9e19c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70004"
      ]
    },
    {
      "uid": "zhcn:7d5e0d3dbdd695375cecc5ac",
      "kind": "character_system_text",
      "source_text": "只是穿上演唱会的服装\r\n就会觉得干劲高昂！",
      "source_fingerprint": "4e246862f86730dd4831688e3109352cfc9f8bd15fd660e0480acc7ad6857b0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70008"
      ]
    },
    {
      "uid": "zhcn:f5fa0c85a747a4627ceaebb1",
      "kind": "character_system_text",
      "source_text": "火红的决胜服，\r\n连我的心情也跟着燃烧起来了！",
      "source_fingerprint": "6370bbedd40fc87a416c0faf20cbf4b5f3ce1445e029102b9fe66757a0d88a5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70009"
      ]
    },
    {
      "uid": "zhcn:814143320929887b62236418",
      "kind": "character_system_text",
      "source_text": "跟朋友和后辈们一起\r\n共度的学园生活……真是青春啊～！",
      "source_fingerprint": "325c47a0b61f7327c74aec2561a07452520d5ebe94d386e7cec7e0a062b04268",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70010"
      ]
    },
    {
      "uid": "zhcn:8196e1e20c11b9d7764e5162",
      "kind": "character_system_text",
      "source_text": "我会在站台上尽情表现的～！",
      "source_fingerprint": "97269592e6352f0faa4aa833960c6f25e762f8d2165ed4d447e3c9bf0200ef35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70014"
      ]
    },
    {
      "uid": "zhcn:334be6099e11fba088905af2",
      "kind": "character_system_text",
      "source_text": "就让你看看，\r\n我用最高速越过终点的样子！",
      "source_fingerprint": "3f37e8092b9f501414b7d3de19a843e38d24c57dc6636bef9ce522694f187af3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70015"
      ]
    },
    {
      "uid": "zhcn:e235ea967dbb20f055d3aaa4",
      "kind": "character_system_text",
      "source_text": "如何？\r\n是不是又性感又可爱的超炫设计啊？",
      "source_fingerprint": "4330ffd0d98a72262ed1b4b06c56f4399dc4b9c0577c9beb233a80ad72f0af4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70016"
      ]
    },
    {
      "uid": "zhcn:716ae086883238434a216bb2",
      "kind": "character_system_text",
      "source_text": "穿上这个就会忍不住想要跳舞呢～！\r\n咻──咻──！",
      "source_fingerprint": "14264756f79229cccd7c8a2fa5851774d55b051a9cb609eb23c6ae546d098c32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70017"
      ]
    },
    {
      "uid": "zhcn:ca6324957929fc2c696fe7a2",
      "kind": "character_system_text",
      "source_text": "真时髦！",
      "source_fingerprint": "dcad89b46e16af15b9740a6aee8e3a08b7f7dd92ef6f34457ca929ef1d2f3dc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70018"
      ]
    },
    {
      "uid": "zhcn:7ec6414b2f7e29fbf3e33699",
      "kind": "character_system_text",
      "source_text": "引擎全开，全力冲刺！",
      "source_fingerprint": "5abb023b84ec3ca36a0c9efe6718779f5496d1bf56c008a4612d19a30e28ccc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70019"
      ]
    },
    {
      "uid": "zhcn:72fe8dc1139d0e5febe66cc4",
      "kind": "character_system_text",
      "source_text": "你喜欢漂亮的大姐姐吗？",
      "source_fingerprint": "0bd9d07413ba6193bf9a6c9c99718c49a9a2f11da82bbf32320eda4534f1b7b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70020"
      ]
    },
    {
      "uid": "zhcn:8fb31f277f4bca4b0c41b4a6",
      "kind": "character_system_text",
      "source_text": "欢迎随时找我约会喔。\r\n我会空下副驾驶座的！",
      "source_fingerprint": "d442626597b4cd5736f63ada364e708c7cc319fd034c084802cd84c99e261e3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "70021"
      ]
    },
    {
      "uid": "zhcn:7146d634a662afdb3c9e6af0",
      "kind": "character_system_text",
      "source_text": "我很「稀饭」学园的制服哦！",
      "source_fingerprint": "9a64b58020a9acb4efd1ac8541283f4e0d32acc855b7b7e793989098ce9e19c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71004"
      ]
    },
    {
      "uid": "zhcn:1dc26beab9a8f0940106a0d7",
      "kind": "character_system_text",
      "source_text": "只是穿上演唱会的服装\r\n就会觉得干劲高昂！",
      "source_fingerprint": "4e246862f86730dd4831688e3109352cfc9f8bd15fd660e0480acc7ad6857b0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71008"
      ]
    },
    {
      "uid": "zhcn:d718289d6cea2889d19212a2",
      "kind": "character_system_text",
      "source_text": "火红的决胜服，\r\n连我的心情也跟着燃烧起来了！",
      "source_fingerprint": "6370bbedd40fc87a416c0faf20cbf4b5f3ce1445e029102b9fe66757a0d88a5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71009"
      ]
    },
    {
      "uid": "zhcn:994c06ec35a58e66fd283882",
      "kind": "character_system_text",
      "source_text": "跟朋友和后辈们一起\r\n共度的学园生活……真是青春啊～！",
      "source_fingerprint": "325c47a0b61f7327c74aec2561a07452520d5ebe94d386e7cec7e0a062b04268",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71010"
      ]
    },
    {
      "uid": "zhcn:d5be08ad44a4cf2100d1d1f5",
      "kind": "character_system_text",
      "source_text": "我会在领奖台上尽情表现的～！",
      "source_fingerprint": "a3b13d30ba4b8403032d35b426ca95b6bf79d94c9852600cd5af30fd400077ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71014"
      ]
    },
    {
      "uid": "zhcn:8998b73dc02ffa4c9cde5ef3",
      "kind": "character_system_text",
      "source_text": "就让你看看，\r\n我用最高速越过终点的样子！",
      "source_fingerprint": "3f37e8092b9f501414b7d3de19a843e38d24c57dc6636bef9ce522694f187af3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71015"
      ]
    },
    {
      "uid": "zhcn:89e6d4604b57a45918f4e29f",
      "kind": "character_system_text",
      "source_text": "如何？\r\n是不是又性感又可爱的超炫设计啊？",
      "source_fingerprint": "4330ffd0d98a72262ed1b4b06c56f4399dc4b9c0577c9beb233a80ad72f0af4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71016"
      ]
    },
    {
      "uid": "zhcn:997e4c02791b5e3fc20d70e3",
      "kind": "character_system_text",
      "source_text": "穿上这个就会忍不住想要跳舞呢～！\r\n咻──咻──！",
      "source_fingerprint": "14264756f79229cccd7c8a2fa5851774d55b051a9cb609eb23c6ae546d098c32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71017"
      ]
    },
    {
      "uid": "zhcn:09a06b310a097a1db17d46aa",
      "kind": "character_system_text",
      "source_text": "真时髦！",
      "source_fingerprint": "dcad89b46e16af15b9740a6aee8e3a08b7f7dd92ef6f34457ca929ef1d2f3dc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71018"
      ]
    },
    {
      "uid": "zhcn:a20143fa3938c46f4bc06f5c",
      "kind": "character_system_text",
      "source_text": "引擎全开，全力冲刺！",
      "source_fingerprint": "5abb023b84ec3ca36a0c9efe6718779f5496d1bf56c008a4612d19a30e28ccc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "71019"
      ]
    },
    {
      "uid": "zhcn:9a4b81b7e93f28d2f164433a",
      "kind": "character_system_text",
      "source_text": "辛苦了",
      "source_fingerprint": "bd96bf364b8b21a3bb94efcf4ef82feb1bc34cf02203524e7949dbd19151dd13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "80000"
      ]
    },
    {
      "uid": "zhcn:51f38a26d2109e9836d01da3",
      "kind": "character_system_text",
      "source_text": "好，\r\n我要尽情地狂奔咯～！",
      "source_fingerprint": "1f9b56ec14f3a9d3e3b451b16ce211aa0bf8b750d10caef38ffe97b1d817d694",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "81000"
      ]
    },
    {
      "uid": "zhcn:f7d2047a65d9c24e6b06b18b",
      "kind": "character_system_text",
      "source_text": "引擎已经热起来了！\r\n你能跟上我吗？",
      "source_fingerprint": "7bd59405cfc670d6989b6463b78cdcff2cbb5d56dce72f8d422214f26e2a89db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "81001"
      ]
    },
    {
      "uid": "zhcn:c77ead7ca122f266d4d4da88",
      "kind": "character_system_text",
      "source_text": "早啊，训练员君！\r\n我今天也是\r\n整天都要把油门踩到底哦♪",
      "source_fingerprint": "77128709ecb237098600eba3cd25ac52fb1bb505d1e3706313bebfce364f20ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90000"
      ]
    },
    {
      "uid": "zhcn:23d2337b33062b3d8fee128d",
      "kind": "character_system_text",
      "source_text": "要很有精神地迎接一整天\r\n的开始！那我们今天\r\n也尽全力加油加油！",
      "source_fingerprint": "ad057ccf216066aa5377716bebcb7f5d7241437c1e407ec190c277f684452696",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90001"
      ]
    },
    {
      "uid": "zhcn:17be35570f438413ae9cf977",
      "kind": "character_system_text",
      "source_text": "午安！下午的训练\r\n也要打起精神努力进行哦♪",
      "source_fingerprint": "e03dc43dc2c369708923c3b7bbf5fa7223ba45cf35a74c85e0720ec1e3fadcfc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90002"
      ]
    },
    {
      "uid": "zhcn:715dcf6c99e9294c5be1e25f",
      "kind": "character_system_text",
      "source_text": "好啦，训练员君。\r\n我已经做好要训练的准备了哦！",
      "source_fingerprint": "c3d8495d7226a98c7d2d8a73b3a3520a4d5f939c5c2a446d6b958b2652dd1b64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90003"
      ]
    },
    {
      "uid": "zhcn:3d12d07c9d34375bdf38e518",
      "kind": "character_system_text",
      "source_text": "忙到这么晚，你辛苦了。\r\n为了不辜负你为了我的努力，\r\n我也会好好表现的♪",
      "source_fingerprint": "41298e37774b3e00515f49bb1cfd47d357caefaedba7990c5b82efbbc9a8bb73",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90004"
      ]
    },
    {
      "uid": "zhcn:78e6c1a38ac7fb57c1d623da",
      "kind": "character_system_text",
      "source_text": "我知道一个很时髦的夜景景点哦。\r\n等把该做的事情都做完后，\r\n我们就晚上去兜风吧？",
      "source_fingerprint": "7343ee12e85e25d79ca83073ab3435236ebdcc5ab16594b3ea77a11a6a42f7f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90005"
      ]
    },
    {
      "uid": "zhcn:b43029c21fed1a28e41308c2",
      "kind": "character_system_text",
      "source_text": "又到了新进后辈们入学的\r\n时期了呢！我看手纲小姐也\r\n充满干劲的样子。\r\n呵呵，好期待♪",
      "source_fingerprint": "35b02727821692c7a8f893434fcd051d8199bdd3d709eb37782cac0bca6425ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90006"
      ]
    },
    {
      "uid": "zhcn:602b9c24883a47ddc2840056",
      "kind": "character_system_text",
      "source_text": "夏天比起待在室内吹冷气，\r\n还是开车吹风比较舒服。\r\n想在海岸旁的道路上奔驰呢！",
      "source_fingerprint": "b7dbfebb9809f47856aefb0307cc0399808929478b81a03f57ad285026417bd3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90007"
      ]
    },
    {
      "uid": "zhcn:1f2888b36db6d0d4ec03177c",
      "kind": "character_system_text",
      "source_text": "在积满落叶的赛道上\r\n全速奔跑是很有趣的哦。\r\n落叶飞舞的样子超棒的！",
      "source_fingerprint": "23d52789e4a12dc2f50ccf673bb099679ab89db3423c2542ea5131408ef298b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90008"
      ]
    },
    {
      "uid": "zhcn:97849262d767ff8083aab96d",
      "kind": "character_system_text",
      "source_text": "天气变冷的时候，\r\n车上的电池就很容易没电……\r\n要好好保养维护才行！",
      "source_fingerprint": "e1fc55f28c08dfd9999bd217b0ea149a0088cba835fb08c1f04df726af5c3741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90009"
      ]
    },
    {
      "uid": "zhcn:16b154dd01d29bb5cdf623df",
      "kind": "character_system_text",
      "source_text": "早啊──！\r\n哎呀哎呀，你看起来很困呢～\r\n要一起去喝杯咖啡吗？",
      "source_fingerprint": "c069178cb40a628c1ead7aab80e851788cb14f29cde7f7923d4720b6833c64b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90010"
      ]
    },
    {
      "uid": "zhcn:cd9d3ab29b3c736bf1fe5523",
      "kind": "character_system_text",
      "source_text": "早上的游泳池真是安静。\r\n……就我们两个独占这里一下吧？",
      "source_fingerprint": "0dfe084d555d4293d9809bef28c06730821b58f81d0e62c7cf923f46d6d46619",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90011"
      ]
    },
    {
      "uid": "zhcn:71fbd9b8b2d9639cd54a5575",
      "kind": "character_system_text",
      "source_text": "差不多……\r\n想要来去一趟泡沫乐园了呢……！",
      "source_fingerprint": "d364e87de7c832b871f54eef3b834c041ed5de095f57998afb50ce57be93ed07",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90012"
      ]
    },
    {
      "uid": "zhcn:135d5b967ccd202d4307c14b",
      "kind": "character_system_text",
      "source_text": "辛苦咯♪如果还没吃午餐的话，\r\n就和我一起去吃意料吧！",
      "source_fingerprint": "23161d6bf3c540071b183710c9791f9443760e30a674c0581786a0b7be032842",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90013"
      ]
    },
    {
      "uid": "zhcn:a80e7e8b8c55a527fd600aac",
      "kind": "character_system_text",
      "source_text": "妈妈寄来了满满整箱的东西哦。\r\n……呵呵，\r\n感动得有点想哭呢。",
      "source_fingerprint": "e794efb7e9340ede4be01f6b254cfe83f3dafdf8917d6bf64a0aa48954a59e03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90014"
      ]
    },
    {
      "uid": "zhcn:9ad986eacd148e560970b089",
      "kind": "character_system_text",
      "source_text": "我希望可爱的后辈们，\r\n可以总是笑容满面的。",
      "source_fingerprint": "3857f3276274bb1cd0a03a0fa95214e60919ace447c838990b6f9c9049704c7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90015"
      ]
    },
    {
      "uid": "zhcn:375b05305f6ba9461c36f490",
      "kind": "character_system_text",
      "source_text": "虽然白天赏花很好，\r\n但晚上赏花也很棒哦。\r\n……我来负责开车怎么样？",
      "source_fingerprint": "253de2f398e351d07cd0c0e604acd4c44a2bdd30d1e91b62be5d483910f2dcc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90016"
      ]
    },
    {
      "uid": "zhcn:6f1eb77048b285699c228288",
      "kind": "character_system_text",
      "source_text": "蓝天、白云！\r\n我们一起朝泡沫乐园出发吧！",
      "source_fingerprint": "1ae9f0a83286fa2981a043fee763ca2f639de7a879086fe06aa5b60b45b94193",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90017"
      ]
    },
    {
      "uid": "zhcn:d6c0df4703adac45df33fcbf",
      "kind": "character_system_text",
      "source_text": "秋天的月亮真漂亮。\r\n等我能喝酒的时候再陪我喝一杯吧。",
      "source_fingerprint": "ae6c17c21aec9c3f0dc5ad7fb360cb10414e8c846a4b9eb28cffc2f1eed5dbaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90018"
      ]
    },
    {
      "uid": "zhcn:3f61d9999c1b25577d039c93",
      "kind": "character_system_text",
      "source_text": "我绝对不会输给冷天气的！\r\n咻──咻──！唔，好冷！",
      "source_fingerprint": "80af25bc5e3383a89344a990e947b693f0cb1ab8bf68b53a5b4836d17775cddd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90019"
      ]
    },
    {
      "uid": "zhcn:1cbdd7ddc8e1209a88c52ab4",
      "kind": "character_system_text",
      "source_text": "情人节快乐～！",
      "source_fingerprint": "89c30a839f4b3a04cb69b06733e358064fb84cd7e12982a53b1f6375b733a7d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "90020"
      ]
    }
  ]
}
