    },
    {
      "uid": "zhcn:c16dd80d5398b2f7a2898832",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员君♪",
      "source_fingerprint": "8924ff4a0484e448f0050d4216d41be9582d838c6b7ba4f6413eb093690fa4fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "2032"
      ]
    },
    {
      "uid": "zhcn:e943b3e43c8e441fd7d705fa",
      "kind": "character_system_text",
      "source_text": "毕竟是这么重要的比赛嘛，\r\n绝对不能输的！\r\n我的心情正嗨到不行呢！",
      "source_fingerprint": "e3dab940afed28927207d0c7981f2fbe2a58e60a03392cc523374aaf5d2bb5b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "2033"
      ]
    },
    {
      "uid": "zhcn:53875d8a092f54d60f1f2812",
      "kind": "character_system_text",
      "source_text": "你问我状态如何？\r\n那当然是非常好啊！\r\n感觉能尽情奔跑呢♪",
      "source_fingerprint": "1165982e1cb39a52a2c2c1e803deb28f6c52959417942c03133402ea60f7fb32",
      "source_path": "character_system_text_dict.json",
