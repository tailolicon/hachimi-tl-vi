      ]
    },
    {
      "uid": "zhcn:eaa70c1fb1f5100a196a1498",
      "kind": "character_system_text",
      "source_text": "小米浴，要加油咯～……",
      "source_fingerprint": "3de72a23bccb8707f4c43211b26d1f6674c279f8bd4c4b1a30e77f1fee0b6166",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "1016"
      ]
    },
    {
      "uid": "zhcn:0e676cc5cf06b0ac4f733d90",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "11"
      ]
    },
    {
      "uid": "zhcn:84d6bc8dd07684feb3553b5e",
      "kind": "character_system_text",
      "source_text": "哎呀，要训练吗？",
