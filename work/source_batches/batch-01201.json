    },
    {
      "uid": "zhcn:c33aaef15d71ccf18fb67e56",
      "kind": "character_system_text",
      "source_text": "准备好了吗？",
      "source_fingerprint": "3e36fbccc1afd0f573cd3d8f897e3488e4336d872375cc4340fe31a60f44d59c",
      "source_path": "character_system_text_dict.json",
