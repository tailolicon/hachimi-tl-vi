      "source_text": "对手近在咫尺的背影",
      "source_fingerprint": "3e5d86b39b94ca61505d6335b57543864514f7a33eac0ad89d1ec382f232e6b4",
      "source_path": "text_data_dict.json",
      "json_path": [
