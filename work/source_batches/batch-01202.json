        "94",
        "110"
      ]
    },
    {
      "uid": "zhcn:d42030017171b27865f7bf8a",
      "kind": "text_data",
      "source_text": "京都大赏典",
      "source_fingerprint": "a180b444f3bdfbd4b718f08df38f55b6c82258b9af464e1cf016b039dc6cbebc",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "111"
      ]
    },
    {
      "uid": "zhcn:35b3d6fe74e86a686192b8ab",
      "kind": "text_data",
      "source_text": "麦昆是明星赛马娘",
      "source_fingerprint": "4901bd9fa2f4dd78909d390fd4c32f180d89e3b7fbb2708a44b773cc83b9770c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "112"
      ]
    },
    {
      "uid": "zhcn:e626b2f95986d3ec14b6a3ea",
      "kind": "text_data",
      "source_text": "开始错开的齿轮　秋季天皇赏",
      "source_fingerprint": "682c5d01b4870b78c85f8e5581c8a9f39ce6683c6752e512e9b3c699d9edecac",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "113"
      ]
    },
    {
      "uid": "zhcn:b5ab6252371a7ed64fc7431c",
      "kind": "text_data",
      "source_text": "无法放晴的天空",
      "source_fingerprint": "a3ec6b8c746158ee941d59ce178adcddc83dd0dd6f307569d658f3740eba6396",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "114"
      ]
    },
    {
      "uid": "zhcn:13d36b59ba98aa8b1d1ce2bd",
      "kind": "text_data",
      "source_text": "名为“期待”的“障碍”",
      "source_fingerprint": "e4a3b74c500cd2e67da8dd0136035f6e0bfcc5a05c7e0582c024c4453067e6c3",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "115"
      ]
    },
    {
      "uid": "zhcn:e9874b03575847040f8babae",
      "kind": "text_data",
      "source_text": "欢迎回来，“Ace”",
      "source_fingerprint": "9054f359e2141d3ebad4969afe3b6aa45ba1c86e970fddd60f4361b76bbfce3e",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "116"
      ]
    },
    {
      "uid": "zhcn:fcf327af7aab59c8b456d001",
      "kind": "text_data",
      "source_text": "新旧Ace对决 中山 草地 顺时针2500m",
      "source_fingerprint": "fb22e7349e82e2fbe521ba2ea556baa1f2472f40e6b8446ae8f854de3ff611c4",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "117"
      ]
    },
    {
      "uid": "zhcn:f47163c4f23447eb33c83fed",
      "kind": "text_data",
      "source_text": "翱翔天际的赛马娘　目白麦昆",
      "source_fingerprint": "dcd0f129ccf6e806171e2d74303e5018f65b1c1f4259a7bdaa3ab70a5e6289f6",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "118"
      ]
    },
    {
      "uid": "zhcn:c9c4cd6e224ca34905f0f849",
      "kind": "text_data",
      "source_text": "新队员的资质",
      "source_fingerprint": "b89aea911ab5d2d332bd039fa600cd435eb64df7ad7ada15bf04ad7a4dda4278",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "201"
      ]
    },
    {
      "uid": "zhcn:dd6da561a067fac7142bc498",
      "kind": "text_data",
      "source_text": "以胜利为目标的赛马娘　米浴",
      "source_fingerprint": "1220819758f442e215bd4e6591ae2bfa660d2dd14d221033280cfd813ad1811c",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "202"
      ]
    },
    {
      "uid": "zhcn:eb5805cff0b832811b9a2496",
      "kind": "text_data",
      "source_text": "东京优骏",
      "source_fingerprint": "55cac897fe5050d9395e60008f8bef2c68e89619881ea3cbfb4a277694c79b42",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "203"
      ]
    },
    {
      "uid": "zhcn:2630dd1a621fce423857f820",
      "kind": "text_data",
      "source_text": "游乐园的誓言　我想战胜对手！",
      "source_fingerprint": "b0887450a45c27c7eec085c259926dff12c1afce0489c324cc21059b77f38dc8",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "204"
      ]
    },
