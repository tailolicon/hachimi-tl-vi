      "source_text": "干劲十足！　京都报杯",
      "source_fingerprint": "dfbe4ec32d8208a49d1b1a087f1eb2430c11233d51b2bcd78a93fd685f06e8e5",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "205"
      ]
    },
