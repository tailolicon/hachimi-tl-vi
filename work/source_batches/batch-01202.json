      "source_text": "丢失的对胜利的执念",
      "source_fingerprint": "1228f91d9a3d653d551be2c6470ea67bb5192e73e74b7851a11790e54d34a123",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "210"
      ]
    },
    {
      "uid": "zhcn:42ab92b543858eecbef162b3",
