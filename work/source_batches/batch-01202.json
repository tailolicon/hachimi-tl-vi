      ]
    },
    {
      "uid": "zhcn:e2f822b83b6f56e2da030bb9",
      "kind": "text_data",
      "source_text": "阪神大赏典",
      "source_fingerprint": "bd4923c9df829fbd6ed7ecfa2840a128c56931e89b7323307c8a6baad8971358",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "107"
      ]
    },
    {
      "uid": "zhcn:046c9294af143158556921ae",
      "kind": "text_data",
      "source_text": "梦想的大舞台　春季天皇赏",
      "source_fingerprint": "55e994bb6bd0e0bfef679571cfdd5a83a109f98e218e7fa9cca60e45860ddecc",
