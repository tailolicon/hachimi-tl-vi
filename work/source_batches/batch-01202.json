        "94",
        "108"
      ]
    },
    {
      "uid": "zhcn:20bd4e83cd774b13965ff312",
      "kind": "text_data",
      "source_text": "队伍一帆风顺吗？",
      "source_fingerprint": "b955bef88087cb05545bcd397c85931bb9b4c79ff168aa5e446bd62255006f65",
      "source_path": "text_data_dict.json",
      "json_path": [
        "94",
        "109"
      ]
    },
    {
      "uid": "zhcn:b7b2f4434801463c3d547372",
      "kind": "text_data",
      "source_text": "夏天！　大海！　在无人岛集训啦！",
      "source_fingerprint": "ff6a8f7ab2b223c62fa77b9181197aa243701141d1309c38a5561d867668ec02",
      "source_path": "text_data_dict.json",
