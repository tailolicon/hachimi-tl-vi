  "entries": [
    {
      "uid": "zhcn:d7919089b4f4e79ba8f076b1",
      "kind": "character_system_text",
      "source_text": "结果算还可以吧。",
      "source_fingerprint": "dea711ebdd9f5a55b6502c113f39f63ceffa8550c813b6bc37d4041b8a8c9c9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140004"
      ]
    },
    {
      "uid": "zhcn:855725f9a826c33adea978d1",
      "kind": "character_system_text",
      "source_text": "还有下次机会，别沮丧。",
      "source_fingerprint": "8eb53e4d6c4ee7e92ebcc051dd5a9071560e9af85e84af6e3dd9d473b0c77e4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140005"
      ]
    },
    {
      "uid": "zhcn:20f00fa21b4d5d232b82d1ca",
      "kind": "character_system_text",
      "source_text": "很厉害嘛！大丰收呢！",
      "source_fingerprint": "34e98a8b8f696e3a3131bae93a0a0da5746ff3e5b7edb7f95c7da7058ce679f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140006"
      ]
    },
    {
      "uid": "zhcn:4557daecafba7f2f0ead1610",
      "kind": "character_system_text",
      "source_text": "结果算还可以吧。",
      "source_fingerprint": "dea711ebdd9f5a55b6502c113f39f63ceffa8550c813b6bc37d4041b8a8c9c9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140007"
      ]
    },
    {
      "uid": "zhcn:832277e2be4dcbf4889f384e",
      "kind": "character_system_text",
      "source_text": "呵呵呵。",
      "source_fingerprint": "414ae427217adea7b80c6d9166bb6ebc72df2f6b1b370616339ff4156cfba39e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140008"
      ]
    },
    {
      "uid": "zhcn:7fa6492f375dd1c43c4686c4",
      "kind": "character_system_text",
      "source_text": "哼哼──♪",
      "source_fingerprint": "09a5319b6dc8594f7a4fef08ea62d5e97c93e9f70b3dfa5bbf87522c0156a8c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140009"
      ]
    },
    {
      "uid": "zhcn:b86db774c27a2f200b4ba534",
      "kind": "character_system_text",
      "source_text": "呵……",
      "source_fingerprint": "b1e52bc5442e42bcc6b8315294f932e59b3fcebf4ddc63b6b4ecf93764178621",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140010"
      ]
    },
    {
      "uid": "zhcn:e08f761a5af0cc12f1268f30",
      "kind": "character_system_text",
      "source_text": "相当出色！",
      "source_fingerprint": "1430a015cf6d701be62b0977a6ac0062cdc6197b67633a5a3581318bf32e33cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140011"
      ]
    },
    {
      "uid": "zhcn:4ca9dab71201de926f0cbc2b",
      "kind": "character_system_text",
      "source_text": "真有你的。",
      "source_fingerprint": "152898a9b8f98df58e19c23d918cd1d9de4aa0a729c15a1b0d39e8a88080a16f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140012"
      ]
    },
    {
      "uid": "zhcn:7983e2cdd11d589789637d9c",
      "kind": "character_system_text",
      "source_text": "很好！",
      "source_fingerprint": "613dae1fa0f9adf4924870c929bc20aacafcda48b809c6d3932fbccb808ea3d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140013"
      ]
    },
    {
      "uid": "zhcn:8893bd5930193c3028f24cab",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140014"
      ]
    },
    {
      "uid": "zhcn:cac70125d240312f63e9cbb5",
      "kind": "character_system_text",
      "source_text": "哦。",
      "source_fingerprint": "6f7dc1b09e1037d9a7a4e058ea6ea6b489a832214825775418cd382fb3ce90eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140015"
      ]
    },
    {
      "uid": "zhcn:5d2a8ab94afc49c0142c2bf5",
      "kind": "character_system_text",
      "source_text": "可以拜托你吗？",
      "source_fingerprint": "6d914a7c495fe48fe5fd0b51dfafc4b7acf3faab92c51a70b83987c1c41c6ff9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140016"
      ]
    },
    {
      "uid": "zhcn:c17a5477338c2fa0ac3f4640",
      "kind": "character_system_text",
      "source_text": "哇。",
      "source_fingerprint": "1b27f340c33f3faadd93f616a908269c900684ba02cca0f317c840bb92c03a5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140017"
      ]
    },
    {
      "uid": "zhcn:f5119f5e4e5d5b2047d6c7d5",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "140018"
      ]
    },
    {
      "uid": "zhcn:9752a86f0f356b3486fae0c5",
      "kind": "character_system_text",
      "source_text": "明天是这个啊？让人期待呢。",
      "source_fingerprint": "4119f1f52542e9baad5b0d5eeffe31e4613effcef28051f8ad658576984e8cff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "15"
      ]
    },
    {
      "uid": "zhcn:d84dbf50b52986c1e2fd1307",
      "kind": "character_system_text",
      "source_text": "呼……我这么疲惫的样子，\r\n可不能让小马驹们看见呢。",
      "source_fingerprint": "64174d311498db8dcda497c518e82f447ef48ba18456226c789c842e2ba262d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20000"
      ]
    },
    {
      "uid": "zhcn:dcd90d61cbe03f36a35e9ccc",
      "kind": "character_system_text",
      "source_text": "嗯……\r\n身体好像有些疲惫。",
      "source_fingerprint": "d9a329fb826d7ab50efaf898c13efec0f275ddcc2c1d46e24f063f962f858b12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20001"
      ]
    },
    {
      "uid": "zhcn:17051e738e71709911f20174",
      "kind": "character_system_text",
      "source_text": "我们开始吧！\r\n今天的我状态特别好，\r\n感觉能有超越平时的表现哦！",
      "source_fingerprint": "e6a759f49d7a840c625af848b9e7c957b6d21ede8fed629344ef72c8b2687ccf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20002"
      ]
    },
    {
      "uid": "zhcn:1824d322496f10224a4c3c92",
      "kind": "character_system_text",
      "source_text": "任何训练我都能完成的。\r\n今天就让你见识一下，\r\n什么叫做「奇迹」吧！",
      "source_fingerprint": "66e4690f6312ce1e4ff46e1aa2e107b88f04b645f4fec03a4997853fbc310b05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20003"
      ]
    },
    {
      "uid": "zhcn:68aeb49d0783cdfab4ca9242",
      "kind": "character_system_text",
      "source_text": "嗯，状态感觉不错！\r\n再来就看训练员的实力了，是吧？\r\n我说笑的啦！",
      "source_fingerprint": "b228f2528ac8e3e9b3e496b4b96a7ca435cfa9951b3926add3c4af3610c02cf0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20004"
      ]
    },
    {
      "uid": "zhcn:9e42a6bddeeb0ca9339f15c9",
      "kind": "character_system_text",
      "source_text": "刚才小马驹们还来帮我加油呢。\r\n呵呵，让我更有动力了！",
      "source_fingerprint": "26313c151586ab87b1c2550fcccda49ade266f604b3af7ab5398e61b0a23d6e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20005"
      ]
    },
    {
      "uid": "zhcn:d9f75783801b4d7d336db160",
      "kind": "character_system_text",
      "source_text": "我已经都准备好了，\r\n差不多要开始了吗？",
      "source_fingerprint": "836bcfd1c8dfe07d68a79323f1b42918baccd47b9c24812350d83ab2236dcc2c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20006"
      ]
    },
    {
      "uid": "zhcn:f1ebefb6d249f89e3e8de515",
      "kind": "character_system_text",
      "source_text": "嗯，没有什么特别的异状。\r\n就像平时一样好好努力吧。",
      "source_fingerprint": "cd4341ea59cf96f2c60a787775a86cc8d1ad634187af2b2b21d26dee0831c95a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20007"
      ]
    },
    {
      "uid": "zhcn:5cd703b70d103d56fb5d4c6a",
      "kind": "character_system_text",
      "source_text": "伤脑筋……\r\n身体感觉有点迟钝呢。\r\n但我会尽最大努力去尝试的。",
      "source_fingerprint": "48371ee5d7dff830b94bb797c73db3193521c68708416666d7b6bf1d65af6291",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20008"
      ]
    },
    {
      "uid": "zhcn:65ec188c750fd9b7477bcd0d",
      "kind": "character_system_text",
      "source_text": "……哎呀，抱歉。\r\n我好像有点恍神了。\r\n呼……好，今天也加油吧。",
      "source_fingerprint": "dac6e739f979a0273ed8dd0df235422613eb111cb4ea17e795adee18728c7d8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20009"
      ]
    },
    {
      "uid": "zhcn:85a7239cafef5b3345c5f963",
      "kind": "character_system_text",
      "source_text": "或许是累了吧……\r\n好像平时的力气，\r\n都不知道跑哪里去了的感觉……",
      "source_fingerprint": "16b1f67604f152930f3e84f687ec27ce664be7921df1ceb0569b0bab9efdd593",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20010"
      ]
    },
    {
      "uid": "zhcn:458262a37fda9df8ea07095b",
      "kind": "character_system_text",
      "source_text": "……抱歉，我状态不太好。\r\n枉费你还花时间在我身上……",
      "source_fingerprint": "6eedfa951aba8506fe50e6a906fc11bada0ce792ada10fde68a025c53c2f7544",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20011"
      ]
    },
    {
      "uid": "zhcn:64a0a2544e5675d0b8043d38",
      "kind": "character_system_text",
      "source_text": "这次也要参赛吗？……没有啦，\r\n因为一直连续参赛，\r\n让我有点担心脚的状态而已。",
      "source_fingerprint": "4dfa2e5b6ebf554968887df02d805834f706404c8799db7d0cf45f37565d6f07",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20021"
      ]
    },
    {
      "uid": "zhcn:a82f9f5a56549c5a42603cce",
      "kind": "character_system_text",
      "source_text": "要不要先别参赛了？\r\n虽然持续挑战很重要，\r\n但休息也是必须的。",
      "source_fingerprint": "62d8da4200d356b2feb4b18bfef4369fb1190db828302ec57aa114295a681e4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20022"
      ]
    },
    {
      "uid": "zhcn:be007e600f208546d6fbfd2e",
      "kind": "character_system_text",
      "source_text": "将最棒的兴奋感送给现场的大家吧！",
      "source_fingerprint": "1b03af75e307c51a0fe60c7f699a03274a619ef1c2fcf824f9652137558e89f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20023"
      ]
    },
    {
      "uid": "zhcn:b24d693968369bd135c49a12",
      "kind": "character_system_text",
      "source_text": "我做好了不辜负期待的万全准备。\r\n那我就来去给全场一个惊喜吧！",
      "source_fingerprint": "2e41b855581f0e60f877a77b47be613d72e966280fe9575e9b397e0699a21743",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20024"
      ]
    },
    {
      "uid": "zhcn:91a283d05632db76ce50f93b",
      "kind": "character_system_text",
      "source_text": "要在这场比赛中，\r\n让大家看到怎样的「奇迹」好呢……\r\n呵呵，真期待呢！",
      "source_fingerprint": "1b174062ff1881546ac17556e96ff1f1af3eadd27e57fa7199b7abcdb849796b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20025"
      ]
    },
    {
      "uid": "zhcn:83331ef30a9fe1986ebc2129",
      "kind": "character_system_text",
      "source_text": "嗯，状态也调整得很好，\r\n这样应该能顺利达成目标。\r\n加油吧！",
      "source_fingerprint": "faadaa70ca408d5fa81a0faf2f4ba7432f9cd30f2f90a877b597e3865e7a8413",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20026"
      ]
    },
    {
      "uid": "zhcn:5f8dcb43bd4b6c932eb88b6d",
      "kind": "character_system_text",
      "source_text": "我已经做好万全准备了。\r\n接下来就只等正式开始了。",
      "source_fingerprint": "4c919c276adea471288d5990313b3eca2c96c8d3b712cdda53a0b51a490711ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20027"
      ]
    },
    {
      "uid": "zhcn:4498de20989c112cce827c1d",
      "kind": "character_system_text",
      "source_text": "很快就要开始比赛了。\r\n你也好好期待我的表现吧，\r\n我一定会炒热现场的气氛。",
      "source_fingerprint": "3b104780dcb879b4fddeb06d807a680cd96d7e6443f561adf8d118517216f28e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20028"
      ]
    },
    {
      "uid": "zhcn:e636680dfb5c9d9cb32fdf6d",
      "kind": "character_system_text",
      "source_text": "只要能跑出平时的成绩，\r\n就能自然地得到好的结果。",
      "source_fingerprint": "678ad2971c6726daae4660eb949b05d177d50613e4dc1257b54937251e6b3bbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20029"
      ]
    },
    {
      "uid": "zhcn:0b60b529e48981a09298413e",
      "kind": "character_system_text",
      "source_text": "状态算还可以吧。\r\n要抓准进攻的时机才行。",
      "source_fingerprint": "00f32d1c5fc9be90f6deb51c0289030bf2fb7d03f828fdc34c328cbac0c93220",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20030"
      ]
    },
    {
      "uid": "zhcn:3f4392f7bbffd9676b18edef",
      "kind": "character_system_text",
      "source_text": "面对什么对手都要平常心。\r\n我会以跑出自我为目标。",
      "source_fingerprint": "717128aa246510e5943f0ec41d6a1c52e1561b61f5910736b4c56064f7a8dcda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20031"
      ]
    },
    {
      "uid": "zhcn:54b3f47e7219258c7e047e33",
      "kind": "character_system_text",
      "source_text": "虽然也会感到不安，\r\n但比赛是没有任何借口的。\r\n我会尽全力去奔跑。",
      "source_fingerprint": "4d41d36ac39a485cc5ef6f7c5020e13d4cf85d73db24e4c80f0035ee714d8a40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20032"
      ]
    },
    {
      "uid": "zhcn:9d496465b1b997e8bd544d78",
      "kind": "character_system_text",
      "source_text": "以我现在的实力要挑战这场比赛，\r\n虽然没有什么自信……\r\n但也只能上了，加油吧！",
      "source_fingerprint": "5379dc45f278e486ec4596c152d49a1c0f33ffad6440f3e484fc3a56705e931f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20033"
      ]
    },
    {
      "uid": "zhcn:f3dd76753c3b91760cea1ebf",
      "kind": "character_system_text",
      "source_text": "虽称不上是万全的状态，\r\n但也不能因此而放弃。\r\n我会尽全力去克服困难的！",
      "source_fingerprint": "32d3b2d013a2e2931c5ae38d51e86ecee2d37693b96ab7bf4aeb837a7c4a30a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20034"
      ]
    },
    {
      "uid": "zhcn:e59787d1e8c0725e1b331c78",
      "kind": "character_system_text",
      "source_text": "……无论会是什么结果，\r\n都要努力到最后。",
      "source_fingerprint": "893bd1d7ac6e46597f6c18de2229ddb65a05404562999004ffb5ab268599cd17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20035"
      ]
    },
    {
      "uid": "zhcn:d024d09beae29590ef773ef8",
      "kind": "character_system_text",
      "source_text": "虽不是万全的状态，\r\n但我还是会尽自己的全力的。",
      "source_fingerprint": "31467fe2e056fb74ec8d6348ec732166ac9254bbfb4991fca8886d8cc670c156",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20036"
      ]
    },
    {
      "uid": "zhcn:09374250eb1b1c7dc9a35f82",
      "kind": "character_system_text",
      "source_text": "……我得尽可能地\r\n不要让你看到太难堪的表现。",
      "source_fingerprint": "6fa9e854e8739b12409e79c74e19e3554d21aedac32fedb8f0080df30d2ab716",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20037"
      ]
    },
    {
      "uid": "zhcn:8e3f7612bbf517d248a302ef",
      "kind": "character_system_text",
      "source_text": "开始吧！",
      "source_fingerprint": "1f6f9cb6d386b03a59eafb944e976a93775f81d43c59dffa89b8cc34793a942f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20038"
      ]
    },
    {
      "uid": "zhcn:a116a4fd413ebd8f70146270",
      "kind": "character_system_text",
      "source_text": "好，走吧！",
      "source_fingerprint": "a1847dedf2949edc2fec2f68a27f5af020238b67e321cd8178d1f99182cf5bd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20039"
      ]
    },
    {
      "uid": "zhcn:3a6f7e2443efdd4a98444424",
      "kind": "character_system_text",
      "source_text": "加油吧！",
      "source_fingerprint": "31876393918d2a09cbf09ac862a0d61e25fc14e1a94804b9fdccda1669dff3d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20040"
      ]
    },
    {
      "uid": "zhcn:71773177ca020059757e3cb3",
      "kind": "character_system_text",
      "source_text": "原来如此啊。",
      "source_fingerprint": "9d87ae8a3fe05571453f54ea005fee8195796194e0303ace0b21672e31bfeb02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20041"
      ]
    },
    {
      "uid": "zhcn:a85e0732c9ccb716135c77dc",
      "kind": "character_system_text",
      "source_text": "哎呀……",
      "source_fingerprint": "aa590602b03384649277b084cd36d881d4f24707abf056fd0a939443d6e5c4fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20042"
      ]
    },
    {
      "uid": "zhcn:7dd573c34d512e02a7fb96c3",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20043"
      ]
    },
    {
      "uid": "zhcn:0559a6c783b93077a1e03be8",
      "kind": "character_system_text",
      "source_text": "走吧！",
      "source_fingerprint": "92ae3e5dcae9a53056d19b3106de1996e8c400c410dfd1c96cb651012cfebc4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20046"
      ]
    },
    {
      "uid": "zhcn:aa57be08fe63ca2133ee1a74",
      "kind": "character_system_text",
      "source_text": "感觉很开心呢！",
      "source_fingerprint": "92f1d61993cc4c1830ab586db88179b0a7f01a2cee0024619955dc148ddcd356",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20047"
      ]
    },
    {
      "uid": "zhcn:3b26c77e66c45d3b2245d155",
      "kind": "character_system_text",
      "source_text": "因为你，让我拓展了自己的可能性呢。",
      "source_fingerprint": "c86b108725380f4e2cb49429e7e241dd4f1b829f2f6005c09a26d6402fa373c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20049"
      ]
    },
    {
      "uid": "zhcn:66d216a80fad57cc1cf90e27",
      "kind": "character_system_text",
      "source_text": "我觉得很开心哦，训练员！",
      "source_fingerprint": "de818868304a52b14794c2eaede8bbb8e95e4156b6dca584d73ecbdf9af884a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20050"
      ]
    },
    {
      "uid": "zhcn:d6a6ad9cc3084c832d9d7497",
      "kind": "character_system_text",
      "source_text": "那就开始练习吧。",
      "source_fingerprint": "d47b415b691ad96878dfa58bc84dc2811cea3ee34bc31a38bba61826e892a126",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "20051"
      ]
    },
    {
      "uid": "zhcn:034635afff75255997f17628",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "2030"
      ]
    },
    {
      "uid": "zhcn:cb22bb35449f129bb8f9eed1",
      "kind": "character_system_text",
      "source_text": "各位，我们走吧！",
      "source_fingerprint": "6a7c373bad24969da6e32fe6afee7b381fad4af6cc62b0a385fe0793f2faa3b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "2031"
      ]
    },
    {
      "uid": "zhcn:15a2819f0ad019d49c3caba8",
      "kind": "character_system_text",
      "source_text": "我觉得很开心哦，训练员！",
      "source_fingerprint": "de818868304a52b14794c2eaede8bbb8e95e4156b6dca584d73ecbdf9af884a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "2032"
      ]
    },
    {
      "uid": "zhcn:b3352d1031a3ec97a5aa9edc",
      "kind": "character_system_text",
      "source_text": "很快就要开始比赛了。\r\n你也好好期待我的表现吧，\r\n我一定会炒热现场的气氛。",
      "source_fingerprint": "3b104780dcb879b4fddeb06d807a680cd96d7e6443f561adf8d118517216f28e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "2033"
      ]
    },
    {
      "uid": "zhcn:17757347f077b376b3ccdf49",
      "kind": "character_system_text",
      "source_text": "要在这场比赛中，\r\n让大家看到怎样的「奇迹」好呢……\r\n呵呵，真期待呢！",
      "source_fingerprint": "1b174062ff1881546ac17556e96ff1f1af3eadd27e57fa7199b7abcdb849796b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "2034"
      ]
    },
    {
      "uid": "zhcn:6e25a94fe7a1309da8d55058",
      "kind": "character_system_text",
      "source_text": "我觉得很开心哦，训练员！",
      "source_fingerprint": "de818868304a52b14794c2eaede8bbb8e95e4156b6dca584d73ecbdf9af884a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "2035"
      ]
    },
    {
      "uid": "zhcn:b372a0b589b39b783a5746d8",
      "kind": "character_system_text",
      "source_text": "頑張ろう！",
      "source_fingerprint": "71836ef6480c3f1c333af0a309383f93523e40c0a5398a1599f381112bf5b9a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "23015"
      ]
    },
    {
      "uid": "zhcn:51299dc840ca6c2179667b76",
      "kind": "character_system_text",
      "source_text": "是不是有点表现得不够好？",
      "source_fingerprint": "4d6e25bd77e8da63f127ea43dbadc44ba9a45294c9594bc41bce53a77a85add4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30000"
      ]
    },
    {
      "uid": "zhcn:bbb3139a4272574097fabcc8",
      "kind": "character_system_text",
      "source_text": "还要再让现场更热闹才行。",
      "source_fingerprint": "58d371323bb85e141848c5821c02c63912eb7e799f44db5f43548a8bb6a77f9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30001"
      ]
    },
    {
      "uid": "zhcn:3e115ee52f0fdeb7a9bd15e2",
      "kind": "character_system_text",
      "source_text": "距离「奇迹」好像还很遥远呢。",
      "source_fingerprint": "ebb35377e4c1c003d205d361b1f09595c5487a9c17d7b19b5c1af6bab5aedb8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30002"
      ]
    },
    {
      "uid": "zhcn:22b5e1ee1bdad3a5614df2c6",
      "kind": "character_system_text",
      "source_text": "这样实在是太难堪了……",
      "source_fingerprint": "b9e8785de712e9f4bb4c8474859c6c216db801bc553bd595fba79044417ee58e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30003"
      ]
    },
    {
      "uid": "zhcn:741af6161f3d26fc2eec0608",
      "kind": "character_system_text",
      "source_text": "奇迹的舞台有让您感到尽兴吗？\r\n亲爱的客人♪",
      "source_fingerprint": "767cdc9bd8a5fee0d025936201f5749a562f19664cff611c8d49de351172b9d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30004"
      ]
    },
    {
      "uid": "zhcn:59978d155c21f0acb8f8b5c5",
      "kind": "character_system_text",
      "source_text": "谢谢大家为我加油──\r\n感谢各位观众！",
      "source_fingerprint": "a802751533dddf5aeb39f99063287b7235c41105c7635086e96976d5c977addd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30005"
      ]
    },
    {
      "uid": "zhcn:7422dafa129150f948859953",
      "kind": "character_system_text",
      "source_text": "呵呵，你看得入迷了吗？\r\n来，请把手给我。",
      "source_fingerprint": "468ea0065e1d37afecf5efef45c3e488161b8217da63db89514fdddcf5f9e3f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30006"
      ]
    },
    {
      "uid": "zhcn:e313b4c1e507db729a7e53e3",
      "kind": "character_system_text",
      "source_text": "感谢支持──我要向观众席致谢！",
      "source_fingerprint": "26c6dcb6801fc03ca33c5f0339fc9c808a25a42ae241b09273e3af98425f8c06",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "30007"
      ]
    },
    {
      "uid": "zhcn:3c8a1a44552e70fbc9c70eb7",
      "kind": "character_system_text",
      "source_text": "为你献上最棒的比赛。",
      "source_fingerprint": "c59c302e5457da49caeeea839fb4de45600981c27386cf852609721ac3d67178",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "31000"
      ]
    },
    {
      "uid": "zhcn:8d111b51fa71fc919881dd2e",
      "kind": "character_system_text",
      "source_text": "来吧，揭幕的时候到了！",
      "source_fingerprint": "7db3da3180b70c5070cbc03b72d37efb73f308766cb7924f637ff80eb6cdfa42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "40000"
      ]
    },
    {
      "uid": "zhcn:50bf115ce273aa576f0793a9",
      "kind": "character_system_text",
      "source_text": "信赖需要时间累积。\r\n不过……天空是个聪明的孩子。\r\n她会明白我的心意的。",
      "source_fingerprint": "7887b3545cec17465383398a63d82ec47da1dfef13a5b89c851134fdf6367be6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "400004"
      ]
    },
    {
      "uid": "zhcn:a4cabc4225893cb49c5a851c",
      "kind": "character_system_text",
      "source_text": "天空真是的，课程一结束\r\n就立刻睡着……不过我一抱起她，\r\n她就吓得跳起来。",
      "source_fingerprint": "ca2e5d7c8b8652b2467f891388fac4b03d86c06a472b497548fc2b657c3e2167",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "400007"
      ]
    },
    {
      "uid": "zhcn:4e986197c14738e16809a5ae",
      "kind": "character_system_text",
      "source_text": "啊～跳得不够过瘾呢。\r\n好，回宿舍继续表演余兴节目！\r\n希望今天的笑容能延续到梦里。",
      "source_fingerprint": "5f90a7bd5a8d8bfd548e656baf2ba2c2b7a52a36c7df4dc0ed8b04457528c75d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "400009"
      ]
    },
    {
      "uid": "zhcn:dba339002db4b246742b2e01",
      "kind": "character_system_text",
      "source_text": "奇迹的瞬间！感动的光辉！\r\n……走吧，梦想的舞台要揭幕了！",
      "source_fingerprint": "8664a245f3b73b4bc6cb59ba04a521b94c34a2245f8649f2f5c42a4cf9d33d3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "40001"
      ]
    },
    {
      "uid": "zhcn:62418a6f12007b7f9ad464f5",
      "kind": "character_system_text",
      "source_text": "ユニヴァース、お月見楽しめてた\r\nみたいで、よかったな。\r\n…頑張ったね、とても。",
      "source_fingerprint": "e6f4315477b1952c89f2b0d001c6149549f095e4ec03e23a7da0772b6afc3f4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "400011"
      ]
    },
    {
      "uid": "zhcn:f80725e6bd78c0a23a0c3a73",
      "kind": "character_system_text",
      "source_text": "今年の『お月見交流会』も大成功、\r\nかな。みんなのいい顔がたくさん\r\n見られて、私も大満足だよ。",
      "source_fingerprint": "352b5b31f828bae81e3766363129fe9268c9d9d6a664ce5056a85998cb618e1e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "400014"
      ]
    },
    {
      "uid": "zhcn:c27e2a8fe5559c8650121b8d",
      "kind": "character_system_text",
      "source_text": "那就去让大家为我着迷吧。",
      "source_fingerprint": "d9ccb31b7cea47d711352f7cb3eef3085a21ee0e7822534a2d10c8004fe3e255",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1005",
        "40003"
      ]
    }
  ]
}
