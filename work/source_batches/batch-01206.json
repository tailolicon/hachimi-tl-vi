    {
      "uid": "zhcn:1d3b40c12c9b0ca6f33ae55d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "情人节快乐DA☆ZE！",
      "source_fingerprint": "833f8c4d8d580a0807dc9c20e80c743b5af936dad2f2d4397a00cccfc3fea4b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
