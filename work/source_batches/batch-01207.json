      ]
    },
    {
      "uid": "zhcn:316a678f1693e42a7f6d6b5e",
      "kind": "character_system_text",
      "source_text": "哎哟～全是字。",
      "source_fingerprint": "72b790fe8d3a2db841dde420491c20962491cb42f022a203b58bb5140ad75f2f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "110001"
      ]
    },
    {
      "uid": "zhcn:094904f246673718f1fae60f",
      "kind": "character_system_text",
      "source_text": "要报名参加比赛吗？",
      "source_fingerprint": "4904075f4a1722bb60be3ee7a8dc6973ac5a113ff28332e1368533ce91222f56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "110002"
      ]
    },
    {
      "uid": "zhcn:8be87932651f8181bdd07274",
      "kind": "character_system_text",
      "source_text": "就是我们！",
      "source_fingerprint": "c523847915d871b1b03a95a510fe417c3709db5c63ed18d6f41e160567940649",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
