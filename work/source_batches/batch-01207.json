      ]
    },
    {
      "uid": "zhcn:3573c2a42a21d10c8c10d9bc",
      "kind": "character_system_text",
      "source_text": "帅呆了～！",
      "source_fingerprint": "26a0f1a589dfad7093942bddabbe394c1b525fa76bcfdb220d763114bdad1868",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "1171"
      ]
    },
    {
      "uid": "zhcn:e983d560e70be24f48469a5c",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "12"
      ]
    },
    {
      "uid": "zhcn:e773d2028f00012af83328e4",
      "kind": "character_system_text",
      "source_text": "感觉一直有活力在涌现呢！",
      "source_fingerprint": "cd58f55ab876910cf576da7e8240cfb5e9676447449da2dd85cbf4ad4ccfa00a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "120000"
      ]
    },
    {
      "uid": "zhcn:c6add08070bbd94e88d1ae6e",
      "kind": "character_system_text",
      "source_text": "喔，是登录奖励啊。",
      "source_fingerprint": "e5c1c68ddb9afcc55acfac6527bef497e6fc51def61afea3e17d1bd056892abc",
      "source_path": "character_system_text_dict.json",
