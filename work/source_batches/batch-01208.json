      "kind": "character_system_text",
      "source_text": "好！夹到了！",
      "source_fingerprint": "b4b69322568279a65a66d4ea3bfedf645e45c9292092de84c1a61f107c5ad7d1",
      "source_path": "character_system_text_dict.json",
