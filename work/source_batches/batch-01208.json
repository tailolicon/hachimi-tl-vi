      ]
    },
    {
      "uid": "zhcn:94d2e801d6af63d2276e827d",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140002"
      ]
    },
    {
      "uid": "zhcn:12187ed68d19163af1e014ae",
      "kind": "character_system_text",
      "source_text": "嗯，我很满意！",
      "source_fingerprint": "e6e20db3e5fd4506ef10fca6921f5f3ca0e3e479d65e05005e3be28f15f5d80c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140003"
      ]
    },
    {
      "uid": "zhcn:913f34522cce6e07c709532d",
      "kind": "character_system_text",
      "source_text": "竟然能夹到这么多。",
      "source_fingerprint": "9f00cd81fee7cf397a748264608105323f488248b66a8590164a10dcd45cac31",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140004"
      ]
    },
    {
      "uid": "zhcn:13a016146a38ec8fda0d5756",
      "kind": "character_system_text",
      "source_text": "非常困难呢……",
      "source_fingerprint": "c47b0e31a5e401ce92725dcb74010930101972d9856226f46c4eebc1dac58e37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140005"
      ]
    },
    {
      "uid": "zhcn:a27f4b6ab36bec283be4226e",
      "kind": "character_system_text",
      "source_text": "嗯，我很满意！",
      "source_fingerprint": "e6e20db3e5fd4506ef10fca6921f5f3ca0e3e479d65e05005e3be28f15f5d80c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140006"
      ]
    },
    {
      "uid": "zhcn:5d0768b98966683b1387e54f",
      "kind": "character_system_text",
      "source_text": "竟然能夹到这么多。",
      "source_fingerprint": "9f00cd81fee7cf397a748264608105323f488248b66a8590164a10dcd45cac31",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140007"
      ]
    },
    {
      "uid": "zhcn:d5377bbabd7360c04592591c",
      "kind": "character_system_text",
      "source_text": "呵呵",
      "source_fingerprint": "f91365d70302fedaa7a15286c40274f8cef5d00e79953a4260169aa4e40851a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140008"
      ]
    },
    {
      "uid": "zhcn:29b525a7e99a16a0ffbc2367",
      "kind": "character_system_text",
      "source_text": "嗯？",
      "source_fingerprint": "8af85ce981d9ec89ad4d75b1bd062ebe03e9f22dc5edb7cd9b8099f05574c6c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140009"
      ]
    },
    {
      "uid": "zhcn:16d3eb2ae5b87909483a767d",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140010"
      ]
    },
    {
      "uid": "zhcn:774d2f919696f92d2a58af0f",
      "kind": "character_system_text",
      "source_text": "好厉害！",
      "source_fingerprint": "c922c5de8a35921e2086ab355870227069194ca65614c757deb698452d7f0151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140011"
      ]
    },
    {
      "uid": "zhcn:2ae3484a3ab7f320004df5fb",
      "kind": "character_system_text",
      "source_text": "好……！",
      "source_fingerprint": "f93d3b7ef27d7cc0857d72ec2a4909bbb86efae229156b450540a7bebfc972c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140012"
      ]
    },
    {
      "uid": "zhcn:15fb98372d0431d50fe0810c",
      "kind": "character_system_text",
      "source_text": "……唔！",
      "source_fingerprint": "dba16fd47f267409b4aae384b25b779f53e37d9c9b73617f995ac608cac2f371",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140013"
      ]
    },
    {
      "uid": "zhcn:c5edbef15b5c3bc0d58c453f",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140014"
      ]
    },
    {
      "uid": "zhcn:7ab02645d4a7f31cdc808eca",
      "kind": "character_system_text",
      "source_text": "喔喔……",
      "source_fingerprint": "591996db6995360ec360a8e8c6081aaf81a515d6de24369316198c5d22625bb0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140015"
      ]
    },
    {
      "uid": "zhcn:6cac4e5ce4b358ef2cedd641",
      "kind": "character_system_text",
      "source_text": "我要上了……！",
      "source_fingerprint": "2277c2d72e403bcecdeb466b5f6de0ded1847035df490e8e8191d1ca7571eb11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140016"
      ]
    },
    {
      "uid": "zhcn:9f8e61134c577a0ef370c92a",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140017"
      ]
    },
    {
      "uid": "zhcn:44ebc4c7c568a661dd739723",
      "kind": "character_system_text",
      "source_text": "可恶……！",
      "source_fingerprint": "777b4ad8979359adb6db6b7ac3d8844f696089febbf4880ad99e25d4bcfb7c5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "140018"
      ]
    },
    {
      "uid": "zhcn:82a994469d9cb1244cb4bad2",
      "kind": "character_system_text",
      "source_text": "明天好像能拿到这个。",
      "source_fingerprint": "05455df9a61eff2f59cb5dc2bf0840682d0169c42988968da22137fe1da487b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "15"
      ]
    },
    {
      "uid": "zhcn:c482797cee309602695c7bc4",
      "kind": "character_system_text",
      "source_text": "嗯……好像有点疲劳的感觉。",
      "source_fingerprint": "3833123ce1506c70b7695cc7f75a0e007df87aa166510268e1171b4699cbd77d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20000"
      ]
    },
    {
      "uid": "zhcn:3e72238f2785ff5c5bc8e666",
      "kind": "character_system_text",
      "source_text": "抱歉，让我稍微休息一下吧。",
      "source_fingerprint": "dad2cc1c94a6672a50293033bb4a7abc494473440f2ade75ea8f76fef45cac63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20001"
      ]
    },
    {
      "uid": "zhcn:5a839019259886159e7fc31b",
      "kind": "character_system_text",
      "source_text": "吼、吼、吸、呼～！\r\n这个啊？我状态好的时候就会这样喊。\r\n所以你好好期待我的表现吧！",
      "source_fingerprint": "cff92cfa2199608ffcc20719f0896ae5b2e1252fd87e8b9a54491ba23af4c075",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20002"
      ]
    },
    {
      "uid": "zhcn:d23f2af68d01614c809d2f48",
      "kind": "character_system_text",
      "source_text": "这个感觉……嗯。\r\n等不及要开始训练了！",
      "source_fingerprint": "2aaeed8c821f219d245ed380954165f40b80fcaad05e44e62ca4485cbe7dc908",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20003"
      ]
    },
    {
      "uid": "zhcn:1bf5cd1eac77541af70bb0b1",
      "kind": "character_system_text",
      "source_text": "吃了很多东西，\r\n今天的感觉不错哦！",
      "source_fingerprint": "dba52365747f66d702dacf487720ef8855d152c737a8caf347fb52a92b4ec7d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20004"
      ]
    },
    {
      "uid": "zhcn:4ecd74019b1158cae9517682",
      "kind": "character_system_text",
      "source_text": "嗯……今天的感觉不错。\r\n来做更多的训练吧！",
      "source_fingerprint": "fb95ebad9567e69b2444f3348e57582ff821ced3f725dd4361378ee5c9c5b8ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20005"
      ]
    },
    {
      "uid": "zhcn:9d7b1fd81ff6c673a5747a44",
      "kind": "character_system_text",
      "source_text": "那，\r\n我们今天要做怎样的训练？",
      "source_fingerprint": "c086d11da6ff77d36c169bf4aa9b87f19798e06d7e33fff374e146f3873f60eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20006"
      ]
    },
    {
      "uid": "zhcn:cd99ed316d8447de683b74ab",
      "kind": "character_system_text",
      "source_text": "好，今天也要努力哦。",
      "source_fingerprint": "2e8cc2912a78d3951247afae9640a42837d99e05ac45c4f49c9ab445d2d27363",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20007"
      ]
    },
    {
      "uid": "zhcn:3c5a25b3427c4c515c80ac7f",
      "kind": "character_system_text",
      "source_text": "感觉状态不太好。\r\n是不是睡眠不足的关系……",
      "source_fingerprint": "620f84a02d31aef7d533480fb9ab251843a68ffac56987737b3360696137c0f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20008"
      ]
    },
    {
      "uid": "zhcn:57f4ba4d70dd8e739a31ed9a",
      "kind": "character_system_text",
      "source_text": "唔唔……提不起力气。\r\n是不是该多吃一点……",
      "source_fingerprint": "988cd96b338213ae265faeda6f3d3c5f8bc6987e7893ceab16e99778be43f4b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20009"
      ]
    },
    {
      "uid": "zhcn:84c22b8ac3342edad17c9bc0",
      "kind": "character_system_text",
      "source_text": "唔……啊啊，抱歉。\r\n好像怎么也提不起劲……",
      "source_fingerprint": "81101141fb1d736bd6cf317f6b650850674f9b99b721f0b7b2400fba7e78f930",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20010"
      ]
    },
    {
      "uid": "zhcn:d374f9046537be198099d9fc",
      "kind": "character_system_text",
      "source_text": "最近觉得身体好沉重……\r\n我不太会出现这种状态来着……",
      "source_fingerprint": "bce2e0628dfa4d1b196942c7c7b9964835953d3377bec926682255eb85b002fc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20011"
      ]
    },
    {
      "uid": "zhcn:c8033b090b1d3f59438adca1",
      "kind": "character_system_text",
      "source_text": "这次也要参赛吗……知道了。\r\n既然你要我参赛，\r\n我就尽全力去奔跑吧。",
      "source_fingerprint": "0aeda3f832ff03b72aaaab35569850f3a778413d85607247e08a7c0b54d48421",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20021"
      ]
    },
    {
      "uid": "zhcn:967c0af5e662a0665c26410f",
      "kind": "character_system_text",
      "source_text": "这样连续参赛的话没办法有\r\n好的表现……我今天不想参赛。",
      "source_fingerprint": "2d5475965ec5d6975faa5639beb144c565966cdb0a2abe1c940f83993dba6be8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20022"
      ]
    },
    {
      "uid": "zhcn:5fec7081fef5fe00c19509e1",
      "kind": "character_system_text",
      "source_text": "状态极佳。\r\n我很感谢你哦，训练员……！",
      "source_fingerprint": "bd7479f5191ff0369db672b5118235f2b59596229c409420f0a4a7781fcccff1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20023"
      ]
    },
    {
      "uid": "zhcn:b454d6967510976642822930",
      "kind": "character_system_text",
      "source_text": "这场比赛，\r\n我希望家乡的人也都能看到……！",
      "source_fingerprint": "6725afec28c45394dd6c3c242c3a598e23c7af3a8e0b5f903c1ab6cb364d5d5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20024"
      ]
    },
    {
      "uid": "zhcn:277f1f406de29192aee7a74c",
      "kind": "character_system_text",
      "source_text": "吼、吼、吸、呼～！\r\n状态很好！尽管吩咐吧！",
      "source_fingerprint": "7fe15a9b4775b24936170642419878cfd5334bbf8b669beb5bf92365b90253d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20025"
      ]
    },
    {
      "uid": "zhcn:8e2b34ef1b63964f799556b0",
      "kind": "character_system_text",
      "source_text": "状态很好。\r\n再来就只需要去赢得胜利。",
      "source_fingerprint": "f6cc4384a77dd177c1da9d05e631c64876a735c2a0042740e9f31405e341b333",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20026"
      ]
    },
    {
      "uid": "zhcn:c6aab833a806f52b06e3212f",
      "kind": "character_system_text",
      "source_text": "嗯……这样我就能完全放心地用全力奔跑了！",
      "source_fingerprint": "fd89310319535d7cb8b008462fda624aa41768d40af302f930b31083b4dd4685",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20027"
      ]
    },
    {
      "uid": "zhcn:9b95c43651b1d5c59e03988d",
      "kind": "character_system_text",
      "source_text": "好像能跑出好成绩哦。\r\n看着吧，训练员！",
      "source_fingerprint": "d0c1c3dfeb463a609f8966cbaa991904436ba88d6cbf8579c26fced8fcadb445",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20028"
      ]
    },
    {
      "uid": "zhcn:0214660aed61af2cb7c3995f",
      "kind": "character_system_text",
      "source_text": "轮到我上场了。\r\n看着吧，我会努力的。",
      "source_fingerprint": "cbb6399adfe1c0d70815dd48f1333457adbdcded4e00b58de399de1a4bf15514",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20029"
      ]
    },
    {
      "uid": "zhcn:803113752326b97978298b5d",
      "kind": "character_system_text",
      "source_text": "有点紧张……\r\n要小心不要乱了步调才好。",
      "source_fingerprint": "0f753152a3dc4b2833f81cc55e27bc7116ce645bd33868f374cb5bc85a7bcf1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20030"
      ]
    },
    {
      "uid": "zhcn:8e5be0e3fd860e9baa030de9",
      "kind": "character_system_text",
      "source_text": "只要拿出平时训练的实力，\r\n应该就能赢……",
      "source_fingerprint": "c555399c44d69d109e10d350d933e65f1f9f29565c9f452c741ed69d541427d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20031"
      ]
    },
    {
      "uid": "zhcn:2890e41404c0cd9dcebddf85",
      "kind": "character_system_text",
      "source_text": "虽然没有完全准备好……\r\n但我会用全力去跑的。",
      "source_fingerprint": "c007b144f8e32e32eddf932777e1bd98653341d0bc9d8fe6cc919d01afcebd5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20032"
      ]
    },
    {
      "uid": "zhcn:9148aa1cbdb503d0a1fc5a35",
      "kind": "character_system_text",
      "source_text": "状态不是非常好……\r\n训练员，要麻烦你比平时\r\n更用力地为我加油了……",
      "source_fingerprint": "3cf3af269cb16102b48c181c4973946e15fd910743febe6c9878b702f7fe9165",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20033"
      ]
    },
    {
      "uid": "zhcn:4cb5b0d081a8575d5004e6df",
      "kind": "character_system_text",
      "source_text": "就算实力不够，\r\n我也要全力去奔跑……！",
      "source_fingerprint": "e1798dd9fffa4cd192338914ecb72041a8461d8ef85cbc6e7ed560cb550c5f3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20034"
      ]
    },
    {
      "uid": "zhcn:eb9f7b5b719f2092ba025d70",
      "kind": "character_system_text",
      "source_text": "以我目前的实力……\r\n不，无论如何我都会挑战的。",
      "source_fingerprint": "2badc535db8bd95ecc34cb96e365542e68c4658af337904276cf4ba0d0e32c89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20035"
      ]
    },
    {
      "uid": "zhcn:107704fb62ab352473a65369",
      "kind": "character_system_text",
      "source_text": "不知道能不能达到\r\n大家对我的期许……\r\n不，我只需要尽全力去奔跑就对了。",
      "source_fingerprint": "bd362007b3e0b82ec91b2cc5a498d990fcd11a73376327816721b116749cf033",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "20036"
      ]
    },
    {
      "uid": "zhcn:e4ad3ac8acf58d931c88f2ae",
      "kind": "character_system_text",
      "source_text": "对手全都具有实力……\r\n速度也比我快。但不实际跑过，\r\n就无法决定胜负……！",
