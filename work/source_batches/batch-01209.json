      "json_pointer": "/1008/91000"
    },
    {
      "uid": "zhcn:24907f422b03ce72ecad9626",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "啊──好想要有人可以像老爸那样，\r\n跟我一起热烈讨论\r\n排气管的重低音啊～～！",
      "source_fingerprint": "e8a8cbc1322d503f11a4064f8cca75bd4ce71cb90ac2023206406fc575ab2b70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
