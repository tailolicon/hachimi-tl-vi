      ]
    },
    {
      "uid": "zhcn:7e25f4ee629a95cbd5fc885a",
      "kind": "character_system_text",
      "source_text": "请来看看，这是……！",
      "source_fingerprint": "4e80e804906c3097eb7f2903f13e4b5aba004d4f29ce0e49b7c35e3f27d0c8b4",
      "source_path": "character_system_text_dict.json",
