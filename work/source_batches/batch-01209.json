      ]
    },
    {
      "uid": "zhcn:7ed44ce22293b862d50695fb",
      "kind": "character_system_text",
      "source_text": "呵呵，真可爱啊。",
      "source_fingerprint": "f4cf3d110bf50f02d137af370b442da090e0c46c6a62a19b7f313efd197506a9",
      "source_path": "character_system_text_dict.json",
