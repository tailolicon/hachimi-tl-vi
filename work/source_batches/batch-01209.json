        "140008"
      ]
    },
    {
      "uid": "zhcn:48ce9f5cd980e9230e660c63",
      "kind": "character_system_text",
      "source_text": "呵呵……",
      "source_fingerprint": "d880d453ed393bb96ce87b11e9d17cc27e0658af14b02e8f6501c50388b2c4a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140009"
      ]
    },
    {
      "uid": "zhcn:c0b56b31b02135f655f40047",
      "kind": "character_system_text",
      "source_text": "唔唔～……",
      "source_fingerprint": "1c4239dac42fb323a127c65f6da8a02adfd6b8b534c8693b153b5baa1ee03c87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140010"
      ]
    },
    {
      "uid": "zhcn:78827f7398c43b121bf3d890",
      "kind": "character_system_text",
      "source_text": "好厉害……！",
      "source_fingerprint": "e6bb5498226b3d866f26cf0a04d9c2d87ff7eaab73c7dfea7fad2f870ec5d839",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140011"
      ]
    },
    {
      "uid": "zhcn:06d17d83dc29db791fbe9fdf",
      "kind": "character_system_text",
      "source_text": "啊！",
      "source_fingerprint": "81c28a42b8af498807476919251caa5ba6f641f655e63b78274946de67cc1a0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140012"
      ]
    },
    {
      "uid": "zhcn:29bcddb251f24b86a4efa92e",
      "kind": "character_system_text",
      "source_text": "……！",
      "source_fingerprint": "98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140013"
      ]
    },
    {
      "uid": "zhcn:64911984782d508a483ad559",
      "kind": "character_system_text",
      "source_text": "怎么会这样……",
      "source_fingerprint": "8ef3c8c0bd2b8526ca00d8a49481ef2939ed331eafad18d6ba7ba5256c72d292",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140014"
      ]
    },
    {
      "uid": "zhcn:dd0961c5af31d4dd83e0ebf1",
      "kind": "character_system_text",
      "source_text": "哇……",
      "source_fingerprint": "9889da431be37bee33852fa36d1cbd5d42f733cbcabd4311a2d83ea10c896ab6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140015"
      ]
    },
    {
      "uid": "zhcn:f13b937867d8e72414916128",
      "kind": "character_system_text",
      "source_text": "训练员。",
      "source_fingerprint": "b6e43cb91de8b29064a75dfe744d0f3065a21f3b9aa2b2704d67f248168b606b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140016"
      ]
    },
    {
      "uid": "zhcn:c8fe1ddf6efcd7c5b76d67a1",
      "kind": "character_system_text",
      "source_text": "呜……",
      "source_fingerprint": "e23a2a933be63f7992ef78dc97543046307e6306c1a546d698062edb79747a91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140017"
      ]
    },
    {
      "uid": "zhcn:b79d224ed192bf61421b5d87",
      "kind": "character_system_text",
      "source_text": "唔唔唔……",
      "source_fingerprint": "d264d03e7d8e5c9efe5b7f7e0b00b44c8c02904342dffc94475681ccb9893872",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "140018"
      ]
    },
    {
      "uid": "zhcn:4d6c5931d1cc966467f67829",
      "kind": "character_system_text",
      "source_text": "明天的奖励应该是这个。",
      "source_fingerprint": "47f7a2d40d0d7d17413589042625ff07cd1c4cad50ae2a635d19fefe1a152e7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "15"
      ]
    },
    {
      "uid": "zhcn:f61ff0da388d9cc4a9bb8d39",
      "kind": "character_system_text",
      "source_text": "身体很沉……？\n唔，没事的……应该……",
      "source_fingerprint": "d5f0d780c25767a8419c73b665f3996fb127c64201a32de7c70a0e09fe116d18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20000"
      ]
    },
    {
      "uid": "zhcn:b5fd813aea72ae004be060ef",
      "kind": "character_system_text",
      "source_text": "唔唔，使不上劲…\n明明想再跑跑的……！",
      "source_fingerprint": "07d39ae4b2dac6997910a17300574a9ae19950deccf113c018a9cd30aa5887b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20001"
      ]
    },
    {
      "uid": "zhcn:f8f64a2730718b2fcd7f5b02",
      "kind": "character_system_text",
      "source_text": "现在可以开始跑了吗？\n我的脚已经躁动不安了……！",
      "source_fingerprint": "9fe66a3f61f1aa4f9c1d45cbfabdf0c30cfc3f595ccb5467a661511b53a5e7f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20002"
      ]
    },
    {
      "uid": "zhcn:7dd690115b1c7949a16e4e7f",
      "kind": "character_system_text",
      "source_text": "总觉得身体好轻盈……！\n快点开始训练吧？",
      "source_fingerprint": "c604c3e50f90a5128965052e0ef829adc59458b28d0be05b243f46c6defcd7c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20003"
      ]
    },
    {
      "uid": "zhcn:2a62a9acdaa882fe22620d5e",
      "kind": "character_system_text",
      "source_text": "好清爽的风……\n在这阵风里面奔跑，\n好像会很舒服呢。",
      "source_fingerprint": "949124a6939ebdc8b280135e969a19f060667addfcf9951b79e896d75a37d4bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20004"
      ]
    },
    {
      "uid": "zhcn:e1266e624bcab29ebc2ada22",
      "kind": "character_system_text",
      "source_text": "今天会跑怎样的路线呢……\n我很期待呢。",
      "source_fingerprint": "d7ce9edcc7f5574c06381abe4f8f04d032ca0368d73b3cd85fc001489a47ab32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20005"
      ]
    },
    {
      "uid": "zhcn:2fc4d18e45095ef1ab5402f9",
      "kind": "character_system_text",
      "source_text": "已经做好准备运动了。",
      "source_fingerprint": "9c5a8dad2353c748c325dd93cb5893876139158107e95283196591f522926c80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20006"
      ]
    },
    {
      "uid": "zhcn:de9a235009bdbed5bf891e5b",
      "kind": "character_system_text",
      "source_text": "今天要怎么做呢？",
      "source_fingerprint": "f670d2aac65370fe9f671b9d69bd84a5e3772cba47e2f3711f73b482d00609ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20007"
      ]
    },
    {
      "uid": "zhcn:252fb6916eb4dc9039668a0c",
      "kind": "character_system_text",
      "source_text": "身体的动作很奇怪……？\n……啊不，没什么。",
      "source_fingerprint": "61152b83fd935e077f02073b1cfa775a6f78d53e484fa8689f08026c64e8c8b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20008"
      ]
    },
    {
      "uid": "zhcn:ebab373722279a59bd6d9f1d",
      "kind": "character_system_text",
      "source_text": "怎么回事，脚好沉重……",
      "source_fingerprint": "b612eae58e6e7332c76455a20d3765fd0ce183d0faaf091651612d2feb43db91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20009"
      ]
    },
    {
      "uid": "zhcn:67cd14d08fe65ff6272b2f73",
      "kind": "character_system_text",
      "source_text": "没法发挥平时的实力…\n为什么呀……！",
      "source_fingerprint": "c5fdea96c3a083b24c8ed726f69d8dcadb592b2488d6fb91fc9f76cd001a7450",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20010"
      ]
    },
    {
      "uid": "zhcn:567e4711cfeb864651c3ce13",
      "kind": "character_system_text",
      "source_text": "身体使不上劲……！\n这种事情……！",
      "source_fingerprint": "684723be2dda227a3d796eb3143e35534a846e5c1666ee22ae3b6fba6a0e08f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20011"
      ]
    },
    {
      "uid": "zhcn:06a90567ad246a045303dc59",
      "kind": "character_system_text",
      "source_text": "虽然很想继续奔跑，\n但也不能把身体跑坏……\n…好难把控奔跑的量啊。",
      "source_fingerprint": "fb46352630376e387436e3cbe9cc698d5c9e50636af0da9a7de94c5ae9467917",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20021"
      ]
    },
    {
      "uid": "zhcn:ff294ba444e3de1f2fceb8b6",
      "kind": "character_system_text",
      "source_text": "虽然还想继续参加比赛……\n但这样下去的话……身体会……",
      "source_fingerprint": "747ff5abdc89b850ce2251a6391e7b4cbc5652c63ae439257cdfa4146cdc728e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20022"
      ]
    },
    {
      "uid": "zhcn:2f7bf4286250016d30b63ce5",
      "kind": "character_system_text",
      "source_text": "嗯，脚很轻盈呢……！\n让我有种马上就跑起来的冲动呢！",
      "source_fingerprint": "a8a5782368233c41eff4798d711e1968ee41b8997f25a880feedcac43f20c0bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20023"
      ]
    },
    {
      "uid": "zhcn:b91bc1c9cf6099f599a69f63",
      "kind": "character_system_text",
      "source_text": "比赛也很有意思！\n能早点开始吗……呵呵呵。",
      "source_fingerprint": "d533bc9d012e57ec0488796f312c75a4615327921f01a629684ad8aa9ad4ac80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20024"
      ]
    },
    {
      "uid": "zhcn:838d23723a43c03f6cf98d30",
      "kind": "character_system_text",
      "source_text": "最前方的景色……\n我一定要亲眼见证！",
      "source_fingerprint": "34ab565c4c3ff26e3f9d3d24d6cf00089958aec75f35c0671892acc3313aafdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20025"
      ]
    },
    {
      "uid": "zhcn:83da0e691261e51c83953a22",
      "kind": "character_system_text",
      "source_text": "我觉得是场不错的比赛。\n比赛果然很开心啊。",
      "source_fingerprint": "5924f0fe433d40a8e5133e8a5452cb7dea1c4e93a02c61b8d40a67cecbf5fa78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20026"
      ]
    },
    {
      "uid": "zhcn:091d3fe83d26ac6e66c27661",
      "kind": "character_system_text",
      "source_text": "状态感觉不错。\n为了这一天，\n我一直在调整。",
      "source_fingerprint": "e00fe740538003ae69b9fa3f595a723c51c85dfbb3a1666d55962c98b731c994",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20027"
      ]
    },
    {
      "uid": "zhcn:6186f304298b2bd8e6694cf5",
      "kind": "character_system_text",
      "source_text": "今天，\n又能看见怎样的景色呢……",
      "source_fingerprint": "eacd68f81403f9e5f6a7e9a39e052768821383e17e88b96446528dca21e5a2b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20028"
      ]
    },
    {
      "uid": "zhcn:341bfae616066dd62132195a",
      "kind": "character_system_text",
      "source_text": "没有问题。\n能发挥和往常一样的实力。",
      "source_fingerprint": "4eabae70dab0ac641d9f5f1da5e586d2640bbda0f241517b587c6922cf3d6e79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20029"
      ]
    },
    {
      "uid": "zhcn:79f680cee25616e9c221c8df",
      "kind": "character_system_text",
      "source_text": "迄今为止学到的一切，\n都会在这场比赛中发挥出来。",
      "source_fingerprint": "38751120d6747400ff9dba1a1d82a7d738287f8348f0b8a4db0ac68a58672be8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20030"
      ]
    },
    {
      "uid": "zhcn:2e016f1614433b80bbb76c97",
      "kind": "character_system_text",
      "source_text": "请好好看着我。\n我一定会赢给你看的。",
      "source_fingerprint": "b280392f9f277549d9f1f76f48c5d2834568cc2f8c8245c11bc030f58bdf0fcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20031"
      ]
    },
    {
      "uid": "zhcn:75912a4631834366c0481c87",
      "kind": "character_system_text",
      "source_text": "虽然稍微有点不安……\n不过没问题。",
      "source_fingerprint": "61f38312eaf489c1683a472038fc3525d68b27d4f26eec0c7bdc6a6fb4988388",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4772524af0e1b4710b3b6ffb",
      "kind": "character_system_text",
      "source_text": "只要回想起平时的训练……\n只要按平时那样来……",
      "source_fingerprint": "887568dc1b764983de26d00b74e1c3ff69c6c2bacc15e1960ebe454f54052bd0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20033"
      ]
    },
    {
      "uid": "zhcn:021114f4cc48e27157898239",
      "kind": "character_system_text",
      "source_text": "我只会向着前方奔跑……\n除此以外的事情，我从没考虑过。",
      "source_fingerprint": "fa8f4040d2ad629ec8464fc78c6213dd9adcefff800c301afeabefa3e7a3ab23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1002",
        "20034"
      ]
    },
    {
