      "json_pointer": "/1008/91005"
    },
    {
      "uid": "zhcn:245342ab2632269033f663fc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "不、不要一直看啦！还、还有！\r\n你绝对不准说出口哦！\r\n可、可爱这种话！绝对不准说哦！？",
      "source_fingerprint": "4d00391e5e614adad8faec40ec80bae4a5bce32da94dd721c55916215ae09485",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
