      ],
      "json_pointer": "/1008/91003"
    },
    {
      "uid": "zhcn:6563cf770efb8d5100cff081",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "白仁前辈。真的好帅啊～！\r\n有威严又强……但我迟早会超越她，\r\n让她追着我的背影的！",
      "source_fingerprint": "8783571b0ca013791e3fbdd3b2da6c5886909b777ca550b44acf55e84cf31818",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
