      "source_text": "好耶～！",
      "source_fingerprint": "9f2b25aea591789d93c8295b3a2c30110ea2c5eae7faeb34de9ea735a084f5bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1003",
        "140013"
      ]
    },
    {
      "uid": "zhcn:963604bb22a99a6c13b32ae7",
      "kind": "character_system_text",
      "source_text": "唔～！",
      "source_fingerprint": "e88e313ab43fde0753eff84b849b3f2ebf0fe875805c0f539cc16b75745c9f1d",
