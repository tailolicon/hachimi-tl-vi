      "kind": "character_system_text",
      "source_text": "好耶ーー！！",
      "source_fingerprint": "0ec8915668058484684b6bfc7590323e8de49e0e43831fc62e4215c95d188b67",
      "source_path": "character_system_text_dict.json",
