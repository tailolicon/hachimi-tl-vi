    },
    {
      "uid": "zhcn:8342e82e74563da2d1f53f7a",
      "kind": "character_system_text",
      "source_text": "啊哈哈哈！",
      "source_fingerprint": "99cc69cbce0d117afc767b72fdcd7fffdb88401af5f938f08a69067a787a2d18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140009"
      ]
    },
    {
      "uid": "zhcn:db871338a61d90529b804c67",
      "kind": "character_system_text",
      "source_text": "嘿嘿嘿。",
      "source_fingerprint": "6088cb7e902b953c6e0e2820be7444cf3a44799e3a3eeccc33d4579a5f759101",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140010"
      ]
    },
    {
      "uid": "zhcn:235d73b085ea5e9e1f8bc66e",
      "kind": "character_system_text",
      "source_text": "好厉害啊──！",
      "source_fingerprint": "b389554c6686964596d644e342af4f5cf3a9a9cfe9f21d6b49712eb481a41c74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140011"
      ]
    },
    {
      "uid": "zhcn:154ba4a437f99d61c22bdf6e",
      "kind": "character_system_text",
      "source_text": "好耶！",
      "source_fingerprint": "61001b03d3bd62444b0e3108412891d24ae8c73521b01502f1ef914bf0928b70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140012"
      ]
    },
    {
      "uid": "zhcn:3adac5dea67c234dfe068fd1",
      "kind": "character_system_text",
      "source_text": "……唔！！",
      "source_fingerprint": "1613cec1a355a6ed17818aee2fe14a079b7c56a38358b646e218c9262b8c41c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140013"
      ]
    },
    {
      "uid": "zhcn:b12ad637e0181f0eff699533",
      "kind": "character_system_text",
      "source_text": "啊啊～！！",
      "source_fingerprint": "195dc67c98256e9febd22284575050106c9d864311b2b89878bb4d8ce83dd778",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140014"
      ]
    },
    {
      "uid": "zhcn:425383238b1dcc594edd4029",
      "kind": "character_system_text",
      "source_text": "……唔！！",
      "source_fingerprint": "1613cec1a355a6ed17818aee2fe14a079b7c56a38358b646e218c9262b8c41c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140015"
      ]
    },
    {
      "uid": "zhcn:4362e1ddf08c6730c0faa1c0",
      "kind": "character_system_text",
      "source_text": "训练员！",
      "source_fingerprint": "db758361d8551e39a471bf33f6afd51a4ac97f8b37ad978fd6a2ae4b2c6720a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140016"
      ]
    },
    {
      "uid": "zhcn:758ce3ca4c896b6b36256884",
      "kind": "character_system_text",
      "source_text": "呜啊～……！",
      "source_fingerprint": "8b955621cceb1234921dd139c92c671ab04a4176f3fa345d38cb6ea091857814",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140017"
      ]
    },
    {
      "uid": "zhcn:18393ae851a61364f9571e9b",
      "kind": "character_system_text",
      "source_text": "不会吧……",
      "source_fingerprint": "e31c35f70d7c744b83bc72158756412d6e478ca58535d60a4497a46728be4786",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "140018"
      ]
    },
    {
      "uid": "zhcn:eaf33964546374170d7e615b",
      "kind": "character_system_text",
      "source_text": "明天好像可以拿到这个。",
      "source_fingerprint": "79aa3eb8be8928df97d087de08297f0f115cbf90eda07cae7c26ff7bd1b55b9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "15"
      ]
    },
    {
      "uid": "zhcn:19cf91c411624a41b4eb5b27",
      "kind": "character_system_text",
      "source_text": "可恶，提不起力气……\r\n看来最近是真的冲过头了。",
      "source_fingerprint": "ad677b5f4acbe45bc15824af7ff72d9e20adb377a3aa2cff1e685cac2d451abe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20000"
      ]
    },
    {
      "uid": "zhcn:90388485918de78686354ee3",
      "kind": "character_system_text",
      "source_text": "最近我常常走神啊～\r\n有种疲劳一直无法消除的感觉。",
      "source_fingerprint": "819973813d6e846e155bef11fa9f64b97c1328724e277e467f832f78d99a63cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20001"
      ]
    },
    {
      "uid": "zhcn:4574b13596afb51b7a3168c1",
      "kind": "character_system_text",
      "source_text": "哦哦哦哦哦！绝・好・调！！\r\n感觉我现在什么事都办得到！",
      "source_fingerprint": "abbbdfb338df963c258fc2f0fcb9de9ee69849e91e8f91b1dee74591cf84d36a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20002"
      ]
    },
    {
      "uid": "zhcn:5186d174580d5f68aa12b516",
      "kind": "character_system_text",
      "source_text": "轰隆隆轰隆隆ー！\r\n我心脏这颗引擎\r\n已经发热到绝佳状态咯～！",
      "source_fingerprint": "3a116b86882efc23dda6bf58d5e8cb2859f8e1ccbf4d36b228a4b8b11688e225",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20003"
      ]
    },
    {
      "uid": "zhcn:bf47f9d8d7bc1a19918a9921",
      "kind": "character_system_text",
      "source_text": "快开始吧！\r\n我已经等不及要活动身体了！",
      "source_fingerprint": "f6348502261b2ea40865273da4b0b6f30b5ecd3ec5e1581600db2977a8366697",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20004"
      ]
    },
    {
      "uid": "zhcn:19800811b31a14e8993754b6",
      "kind": "character_system_text",
      "source_text": "气势十足！\r\n无论是什么内容都无所谓。\r\n我都会完成给你看！",
      "source_fingerprint": "1ab1f693e07afd367f878cd97d102d1f0067aca1ce46ea52964b3e85fbde5acc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20005"
      ]
    },
    {
      "uid": "zhcn:9e3c87b411cd3f878eb142b4",
      "kind": "character_system_text",
      "source_text": "依照惯例，\r\n全力锻炼吧！",
      "source_fingerprint": "a734edff3c08b87821cab05bdbd0c68432e559c7190610ad16825636c8875770",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20006"
      ]
    },
    {
      "uid": "zhcn:a16327a8d17703d40768d682",
      "kind": "character_system_text",
      "source_text": "哟！\r\n这次是怎样的训练计划啊？",
      "source_fingerprint": "bdc091c6a260cc953834daeea26782bd8915f4ef61d81f926d07623e91b946bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20007"
      ]
    },
    {
      "uid": "zhcn:b02742a012e12eb4d191928f",
      "kind": "character_system_text",
      "source_text": "有没有更帅气的训练方式啊。\r\n这样我也能做得更起劲嘛～。",
      "source_fingerprint": "906dabd0665e0285c23e45d6d6d15a89e6f5c6f653968e6552da1066cd6cac50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20008"
      ]
    },
    {
      "uid": "zhcn:7784159f29aa112482fac234",
      "kind": "character_system_text",
      "source_text": "啊ー！使不出力气啊～！\r\n但这种时候必须撑住才行，对吧！",
      "source_fingerprint": "7d404c97794a9f9ce90e8913d8530b19259207e442f8262a7904e636d6a73275",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20009"
      ]
    },
    {
      "uid": "zhcn:1cbf355f4e987e606c1d3cb5",
      "kind": "character_system_text",
      "source_text": "唉ー，身体好沉重啊ー。\r\n好想骑车转换一下心情……",
      "source_fingerprint": "3aa1007ef3a1214674b8939dc7a10c5ec0767621cb53668f7f443c60daf29303",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20010"
      ]
    },
    {
      "uid": "zhcn:cf19b565233a3e61d00c6f40",
      "kind": "character_system_text",
      "source_text": "提不起劲啊……\r\n可恶，这样真的感觉很逊。",
      "source_fingerprint": "150bbfc2afdc2b9cf81383b19297281575376edd3d832182ab95baa89543c0bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20011"
      ]
    },
    {
      "uid": "zhcn:123bc1a48dc3d3770306f88a",
      "kind": "character_system_text",
      "source_text": "喂喂，又要参赛吗？\r\n也差不多该让我休息了吧……\r\n不然关键时刻怎么还有力气啊。",
      "source_fingerprint": "c4feb7910b370cbd30b082535d9dab316f80b07aa0043c0d4cc4e8de7f1eec37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20021"
      ]
    },
    {
      "uid": "zhcn:1ec6fd7c84fe75c81bdeff13",
      "kind": "character_system_text",
      "source_text": "呃！又～要我参赛！？\r\n……这未免太夸张了吧。\r\n真的，你重新想想吧。好吗？",
      "source_fingerprint": "9259b90c870d06546a2645fa9fca496d04c3c3e0e97bae2163faaebcecdb7b3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20022"
      ]
    },
    {
      "uid": "zhcn:3d835be29b5ac4acfe59838d",
      "kind": "character_system_text",
      "source_text": "目前状态非常好！\r\n让大家见识\r\n我载着胜利女神的结果！",
      "source_fingerprint": "e934288e02dda2dce8f8f80a98183bc93972cae7903e82d7b129a42429250875",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20023"
      ]
    },
    {
      "uid": "zhcn:2cd0925cd8771bb033c9b83a",
      "kind": "character_system_text",
      "source_text": "哇～～！力量一直在涌现啊！\r\n让我用最快速的攻击直冲终点吧！",
      "source_fingerprint": "0cbbc467169a0e3f8afbfbae8f0d5285869d41b78153632aed656081a3e6a6a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20024"
      ]
    },
    {
      "uid": "zhcn:8d9cc4affb2be1a2427d3b46",
      "kind": "character_system_text",
      "source_text": "好啊～！！\r\n我的血液也在轰隆隆地沸腾～！！",
      "source_fingerprint": "e42eb38f25838caf33f33a6fc23f727efbabc7dca6e12cc7030f61c72c233dca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20025"
      ]
    },
    {
      "uid": "zhcn:a8b965e5c14fd30240dc1690",
      "kind": "character_system_text",
      "source_text": "状态也调整得很好！\r\n感觉输不了啊！",
      "source_fingerprint": "2cc12fd31fbbbfe6f0ac4d739a9ca3e543f55061d6ad30148b7dc5d9ae0b6828",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20026"
      ]
    },
    {
      "uid": "zhcn:31d543c0e8ca6732fc66cff4",
      "kind": "character_system_text",
      "source_text": "状态良好！\r\n看来能跟着风一起狂奔呢。",
      "source_fingerprint": "6c19c97680b5582d3285f9c0785aa25048eb8360658991fbb600092b44cb5b0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20027"
      ]
    },
    {
      "uid": "zhcn:a0c74811afb91c388cdc18a5",
      "kind": "character_system_text",
      "source_text": "脚好轻盈啊……嘿嘿！\r\n你好好期待比赛的结果吧。",
      "source_fingerprint": "361236ee6aeb9c40eb61137e168bed67dfcb1714fa2a724ad7530e94b1a0b7b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20028"
      ]
    },
    {
      "uid": "zhcn:866db2fe0743086301a936e8",
      "kind": "character_system_text",
      "source_text": "老样子，我会用这双脚跑赢的！",
      "source_fingerprint": "4959af0bb38b30e90c8f3de6f5b6e6d8e420e63896a27ae945f0df92ea1824e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20029"
      ]
    },
    {
      "uid": "zhcn:f4124258910b1c45f5c92f44",
      "kind": "character_system_text",
      "source_text": "状态还不错，\r\n照平时的跑法应该就能轻松取胜。",
      "source_fingerprint": "786e5a7d4e1ed35279d50dc1c950bc16474f224c226a7d39917fc66f6fbc5065",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20030"
      ]
    },
    {
      "uid": "zhcn:320e20f53de049c11dce676c",
      "kind": "character_system_text",
      "source_text": "这次也没有什么不同，\r\n就是跑赢大家～！",
      "source_fingerprint": "950d85acfd7265a0a9e0925bca1b0fa721bd34a0bc09255ad16eea2028ecdc2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "20031"
      ]
    }
  ]
}
