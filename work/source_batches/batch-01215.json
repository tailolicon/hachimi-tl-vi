      "json_path": [
        "1010",
        "90002"
      ]
    },
    {
      "uid": "zhcn:f7ae1c6764f9b5f2a9d93061",
      "kind": "character_system_text",
      "source_text": "我正想说训练员应该要来了！\r\n我猜对了Death！呼──♪",
      "source_fingerprint": "d2a48a2eb1e94694edbdb1e7248ba20b88c5b87900df0aa9eae74b72fefcbdcc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "90003"
      ]
    },
    {
      "uid": "zhcn:6c5d2e1b862d087115367d16",
      "kind": "character_system_text",
      "source_text": "今天也辛苦你了！\r\n我来帮你松开硬梆梆的身体吧！",
