      ]
    },
    {
      "uid": "zhcn:4b2ff38d6b6eeb4498ea7e34",
      "kind": "character_system_text",
      "source_text": "我会把油门踩到底的！",
      "source_fingerprint": "72755853c6c9f63a9d2e96f504a4bb7ef38482e081f916ac8b7446471276e0dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "60001"
      ]
    },
    {
      "uid": "zhcn:e8e5ce73b8ac0de9e45eeff2",
      "kind": "character_system_text",
      "source_text": "今后也要一起\r\n狂奔到底！",
      "source_fingerprint": "99c8b6af88df357f46f978b67f99333f1ef2b74f3aad25cfbc58f662c029788f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
