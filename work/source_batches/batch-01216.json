        "70000"
      ]
    },
    {
      "uid": "zhcn:c0c648dbe1cb5c8ea41aafb1",
      "kind": "character_system_text",
      "source_text": "你也是个挺了不起的家伙嘛～。\n竟然比谁都先发现了我的\n帅气之处啊。",
      "source_fingerprint": "d0a1e60db7000d7684e70c4ec5ee61e258e658011079ae0e3be61ce35d5b9304",
      "source_path": "character_system_text_dict.json",
