    {
      "uid": "zhcn:cf5309e085262ebdecdc7cde",
      "kind": "character_system_text",
      "source_text": "我会让你感到震撼的！",
      "source_fingerprint": "fa9bec28b9543d72dc0bad5874580a2dff0fa649946a8c90949c129b1f8d1b2b",
      "source_path": "character_system_text_dict.json",
