    },
    {
      "uid": "zhcn:9261ae7787fd2dbf4a2fce4f",
      "kind": "character_system_text",
      "source_text": "哼哼，夹到了很多呢♪",
      "source_fingerprint": "558ca229a728b6df04b685e502e2d04dfd20654f8ceec5e2fda72f6b877aaecd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
