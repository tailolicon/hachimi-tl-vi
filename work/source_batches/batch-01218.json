      ]
    },
    {
      "uid": "zhcn:f55c26f5b10793923b198645",
      "kind": "character_system_text",
      "source_text": "扣子要扣到最上面，我才静得下来。",
      "source_fingerprint": "0276852663fc2e3b8d92ce25e59ac44e07f1630b8d2954d79b8bed9feff4e852",
