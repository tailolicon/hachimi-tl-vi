        "70016"
      ]
    },
    {
      "uid": "zhcn:5463ec9895ea36d6b480123d",
      "kind": "character_system_text",
      "source_text": "诶呀诶呀，您需要回复魔法吗？",
      "source_fingerprint": "9e9e01a350d291039d203e916b1bbc2726bb6c8f5e150f98cdac1f120714f9e0",
      "source_path": "character_system_text_dict.json",
