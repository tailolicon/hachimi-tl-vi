        "1009",
        "410008"
      ]
    },
    {
      "uid": "zhcn:430f91623d647404ea3fc93c",
      "kind": "character_system_text",
      "source_text": "好好享受我的演唱会吧！",
      "source_fingerprint": "46e76e7d7fac4284d13dd19dd686a23926679b86f823fd8d4f1a82b6a9f307b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "60000"
      ]
    },
    {
      "uid": "zhcn:f7246e911707b705ae45fad0",
      "kind": "character_system_text",
      "source_text": "今天要以最热烈的气氛开始表演了哟！",
      "source_fingerprint": "cfde412eee64de2aa39ea17545a469e78b45a6ca25e9111654ba0470bcbd66ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "60001"
      ]
    },
    {
      "uid": "zhcn:db968060c1680782de76e968",
      "kind": "character_system_text",
      "source_text": "好好跟紧我哟！",
      "source_fingerprint": "894fd062f55dd498009822e39455f313608227d721d5252dd6fee3f8f976d090",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70000"
      ]
    },
    {
      "uid": "zhcn:f1ddc3a8922e3f1820121f32",
      "kind": "character_system_text",
      "source_text": "现在一想，你从一开始\n就是个奇怪的家伙呢～……\n真是想忘也忘不掉。",
      "source_fingerprint": "047d1d179460849d2289f4a017d95f435160c2568db35cbf9496ac6e0524843d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70001"
      ]
    },
    {
      "uid": "zhcn:94d6d60d611cc7bfbb1cf31f",
      "kind": "character_system_text",
      "source_text": "怎么样？就算是制服也能穿得很完美。",
      "source_fingerprint": "668af8a054f5701076646cb9ea79fef108db150189aa0e705e313a95d44fa737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70004"
      ]
    },
    {
      "uid": "zhcn:d08edcaefcd35765d2cbb64b",
      "kind": "character_system_text",
      "source_text": "即便在舞台上，也要展示最闪耀的一面！",
      "source_fingerprint": "18b134c188636e85ee1d4d9bca52f09335f6bf3c4e0236a73cb7226d2a35e4e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70008"
      ]
    },
    {
      "uid": "zhcn:49eb2a490f015b7db851344e",
      "kind": "character_system_text",
      "source_text": "我可不想输给任何人！",
      "source_fingerprint": "9e10f4a78899ecc9442987f784540fe31802a8f7d11d67ed920aa03124cc6eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70009"
      ]
    },
    {
      "uid": "zhcn:55ed1c6cc1918694313e775f",
      "kind": "character_system_text",
      "source_text": "这里的制服果然很可爱啊。",
      "source_fingerprint": "5041318e30605c477807feb30a35a5ea868129dc3e72e204649a9a6a2877e4e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70010"
      ]
    },
    {
      "uid": "zhcn:b1c9473329b4c851511304ab",
      "kind": "character_system_text",
      "source_text": "无论什么舞蹈都能跳得完美无缺！",
      "source_fingerprint": "b70e9b66a02e927bad53d4845906f6e57bbb92b159f82b0503c0d364d03f3455",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70014"
      ]
    },
    {
      "uid": "zhcn:c90383bb28ee90cba84a2e25",
      "kind": "character_system_text",
      "source_text": "一定，要成为第一名！",
      "source_fingerprint": "2613f01422827b0dd839e0f7600ec8cbf4de5d02912dcb62b7dad1fdc5669c25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70015"
      ]
    },
    {
      "uid": "zhcn:6cdb379bc946d026158bb712",
      "kind": "character_system_text",
      "source_text": "这么高贵的圣诞老人，\r\n很有我的风格吧？",
      "source_fingerprint": "f06076950dbb146f23c53cb5c29c3de752bacce8cc0dd9fc85f6722185ebf4ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70016"
      ]
    },
    {
      "uid": "zhcn:aad84ef830a4776505ff2b2a",
      "kind": "character_system_text",
      "source_text": "这下随时都能出席派对啰♪",
      "source_fingerprint": "bd09788bd8f774e46cc16e997274f12ed93e908e2e7787a8038960eec5051d9d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "70017"
      ]
    },
    {
      "uid": "zhcn:6cc268671d6c64065a226ba4",
      "kind": "character_system_text",
      "source_text": "哇……！",
      "source_fingerprint": "d74e1c2cd08cd08b6309c3fc0f49ab65656b028659f7127989328d0155b2314e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
