      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "40001"
      ]
    },
    {
      "uid": "zhcn:9a5da0ea7df4573d2134ceae",
      "kind": "character_system_text",
      "source_text": "多亏有她点燃我心里的火苗，\r\n才让我度过了最棒的夏天♪\r\n讨厌～真不想回去～！",
      "source_fingerprint": "746a7ee7e4d84c4e97af96e99e010d6e79a67ca09972c686ed5b1462d0953a03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
