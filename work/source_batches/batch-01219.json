    },
    {
      "uid": "zhcn:b3c2c4c737b5dfc23cb40ce1",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "VR游戏什么的，\r\n玩起来感觉十分地真实，很厉害呢……\r\n不知道有没有关于茶道或是花道的VR游戏呢？",
      "source_fingerprint": "702303ff301b091a13197012ea87ead44feb368891da653954d3810f9051f2f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
