    {
      "uid": "zhcn:c87c8ebe685317817b51dcf5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我很喜欢月光映照出的影子。\r\n比起太阳照射出的影子来说更为朦胧\r\n不觉得这样很有情调吗？",
      "source_fingerprint": "d1a378e841f60acc250608c194d785d0230d53ba4eeba07090aa0ad523a74eb9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
