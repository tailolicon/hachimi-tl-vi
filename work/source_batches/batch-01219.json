      ]
    },
    {
      "uid": "zhcn:f78d7f64629d4659a44f867c",
      "kind": "character_system_text",
      "source_text": "真不甘心啊……下次一定要第一个到达终点！",
      "source_fingerprint": "4f04ad844e48e3694689a5fa40cca7974b9c14029a1a1adbc7a61cb04a6d4b19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f3168b237f90e7117a042bb8",
      "kind": "character_system_text",
      "source_text": "居然是第三名……！？下次一定要赢！",
      "source_fingerprint": "bc5ba468809f33519b43b525b98ecd86a207f36fab55ca03cf5eb19643a74f98",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "30001"
      ]
    },
    {
      "uid": "zhcn:77f9b75486a798364911606a",
      "kind": "character_system_text",
      "source_text": "怎么会……！？勉强入着什么的……！",
      "source_fingerprint": "883fa7f08ed05bc7976017f96a0d38a828d4d217517336fcc407cc9e0af2262e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "30002"
      ]
    },
    {
      "uid": "zhcn:5eaa279696cf99bbf1216057",
      "kind": "character_system_text",
      "source_text": "不行……必须变得更强……！",
      "source_fingerprint": "2c1e7bffdb30ff781510ed012f2dad1b6511a0f4b3e66c6fc78b2adde503fe8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
