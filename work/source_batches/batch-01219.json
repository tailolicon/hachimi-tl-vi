      ]
    },
    {
      "uid": "zhcn:4d38531d79c3288de4c4372a",
      "kind": "character_system_text",
      "source_text": "第一名绝对是我！",
      "source_fingerprint": "c5cef9eeb8c7977c227a95b34e44c78383ea1fb9e87e45c82664ddec360c1d94",
