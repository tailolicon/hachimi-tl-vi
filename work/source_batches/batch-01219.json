    {
      "uid": "zhcn:7f77a86cdb2e249fedaf9d26",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "诶呀？\r\n训练员的肩膀上沾着红叶呢……\r\n呼呼，小小的秋天，被我发现啦。",
      "source_fingerprint": "6faf3cf4a44cb70b4ff147c760e95ae99ee5b37dd525c3edc9cac50c2889b9d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
