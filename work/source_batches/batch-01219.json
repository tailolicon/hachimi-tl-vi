  "schema_version": 1,
  "batch": 1219,
  "batch_count": 1689,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "4c77e29d79c031b121c5d2d0a53ce8b0070eb9a1",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:c6a0083c398a9783f4f426c0",
      "kind": "character_system_text",
      "source_text": "真是的～……",
      "source_fingerprint": "a1bd969b25af397835e6bd573271ddcc24326af6517bb21e88501e606888fe22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "140017"
      ]
    },
    {
      "uid": "zhcn:84063cb1aa2dae7adbe7e8bc",
      "kind": "character_system_text",
      "source_text": "嗯～……",
      "source_fingerprint": "b44f0ced1c9eefcb4c785ebf99fa75fa7a9b475fd90ec6fdc1c54f86243188ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "140018"
      ]
    },
    {
      "uid": "zhcn:732a607ec4dbf209d6b0bcb1",
      "kind": "character_system_text",
      "source_text": "明天好像可以拿到这个呢！",
      "source_fingerprint": "253110f057e4f46e665c9dbc00a4ff9b34e56a5d3483ea46a45621143c409b43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "15"
      ]
    },
    {
      "uid": "zhcn:3a87ccc6e65807a8d8912bc9",
      "kind": "character_system_text",
      "source_text": "嗯……我现在这么疲惫的模样，\r\n要小心不要被后辈们看到呢。",
      "source_fingerprint": "69e1f18927e1eaed6592944bd26949ee060fe99a806c82b26cdbee1692b67f78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20000"
      ]
    },
    {
      "uid": "zhcn:f4c7d6e42aa6c531b8f19a29",
      "kind": "character_system_text",
      "source_text": "疲劳好像一直没能得到缓解呢，\r\n可能没什么精神跑步了……",
      "source_fingerprint": "d0a05b942abb0f00c4644c96527b5f0077319b2bec03380e75b94390ab2f6bc7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20001"
      ]
    },
    {
      "uid": "zhcn:7efbcde71b9a35231db528d3",
      "kind": "character_system_text",
      "source_text": "状态超赞哦！\r\n我是不会踩刹车的，\r\n你可要好好跟上来哦！",
      "source_fingerprint": "a038ce1a6153d7b7d505d68852b9f1e766163ef5d214f0c24524e49fdbc43d5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20002"
      ]
    },
    {
      "uid": "zhcn:f90e4d22573a93acb94a04c9",
      "kind": "character_system_text",
      "source_text": "现在的我可以无限奔跑哦！\r\n好～就让我用最高档速狂奔吧♪",
      "source_fingerprint": "475571290d7bf6992a93d2aa1ffa56a895f370f93ec2ba08dfb90a7ca8a560a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20003"
      ]
    },
    {
      "uid": "zhcn:2c77e86c3bd67449a0762ecb",
      "kind": "character_system_text",
      "source_text": "说不定有可爱的后辈在看，\r\n所以就算只是训练我也要全速前进！",
      "source_fingerprint": "483b2bfd18c1b6aaf98fb25315c30e85a28f004d3fcf841ba9e4e2d005dcf17d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20004"
      ]
    },
    {
      "uid": "zhcn:ed5e40a1b11676bbe613a8e7",
      "kind": "character_system_text",
      "source_text": "今天的状态应该能跑得不错。\r\n我要尽情地奔跑，去感受那阵风♪",
      "source_fingerprint": "1e7e95f1259fe491fc2c3c45eeddef24300dc343da1d042ed5dee2d5d7f2721c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20005"
      ]
    },
    {
      "uid": "zhcn:546b2f4d9a9f1ec54548a5fe",
      "kind": "character_system_text",
      "source_text": "我已经准备好咯！\r\n随时都可以开始了♪",
      "source_fingerprint": "601b83ebfd9b53b503c781c70e190992853676ad05513564b2724abb29048f73",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20006"
      ]
    },
    {
      "uid": "zhcn:c3fd56138907d5da7a1e0644",
      "kind": "character_system_text",
      "source_text": "那我们一起加油吧！",
      "source_fingerprint": "4a263766f002b346e4909968e066523a9ed686bb062eed2ef225b7b753503bfb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20007"
      ]
    },
    {
      "uid": "zhcn:642641fa4ae86e6a452def65",
      "kind": "character_system_text",
      "source_text": "专注力变得有点差……\r\n啊，但你不用在意啦！\r\n我没问题的啦♪",
      "source_fingerprint": "20b69357f9d242e550db19ea084fb22aa511115aa322747e0bc3523a78ead716",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20008"
      ]
    },
    {
      "uid": "zhcn:0fbe30db20a1b4f7e0ea3efe",
      "kind": "character_system_text",
      "source_text": "虽然脚感觉有点沉重……\r\n但不能被看到我狼狈的模样。",
      "source_fingerprint": "cfc0e9287074c5148dacd2feb099ab1dd73089d7d4bf323208c3c0fdd3693698",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20009"
      ]
    },
    {
      "uid": "zhcn:6582d7bdaf45bda5f45d5dc9",
      "kind": "character_system_text",
      "source_text": "抱歉，我心情不太能调整得过来……\r\n虽然说不是你的错啦……",
      "source_fingerprint": "90eed372275d86204939361c0d7cf20a68752ee795eb588e6305e3c55f856018",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20010"
      ]
    },
    {
      "uid": "zhcn:e7dbbe740ffc7b807e3e76ac",
      "kind": "character_system_text",
      "source_text": "无论感受到多少风的吹拂，\r\n我好像都开心不起来呢。\r\n怎么会这样呢……",
      "source_fingerprint": "114b05a5e93359c8d9c213896beebe55b2382b1eca8c779bea8fe4b699afe19d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20011"
      ]
    },
    {
      "uid": "zhcn:beb878e52e1574464909014f",
      "kind": "character_system_text",
      "source_text": "一直参赛虽然也不错……\r\n但偶尔休息也是很重要的哦。",
      "source_fingerprint": "67ccf58c7a9c7bf493d5ce69e3b2cb38f35ad4b147d77c3338d9620ce8685cd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20021"
      ]
    },
    {
      "uid": "zhcn:640dfbe7120df5a827569a39",
      "kind": "character_system_text",
      "source_text": "你这么信任我的能力\r\n确实是很开心啦，\r\n但这样一直连续参赛的话有点……",
      "source_fingerprint": "25a46dc481266754a9aa10f09f34d58d2f764040ac25a10f52dd918db5fa4011",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20022"
      ]
    },
    {
      "uid": "zhcn:ee1f33fc8530e4ddb6349e9d",
      "kind": "character_system_text",
      "source_text": "干劲十足，准备万全！\r\n我要去好好享受风的吹拂了♪",
      "source_fingerprint": "3cf2eceace2f2ea0bcb10698e7cf7292db5754490e305b0e11b9d0d604ddbee3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20023"
      ]
    },
    {
      "uid": "zhcn:f35323bdb4292bfc724cad00",
      "kind": "character_system_text",
      "source_text": "我现在的心情非常好哦！\r\n就用踩穿油门的气势\r\n把所有人甩在后头吧！",
      "source_fingerprint": "6ea73364a7676d85ba689772f27b7a9b25eccb1291a13a2894f201bdb2b7c553",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20024"
      ]
    },
    {
      "uid": "zhcn:479e58730fa2fb7996a2d317",
      "kind": "character_system_text",
      "source_text": "你问我状态如何？\r\n那当然是非常好啊！\r\n感觉能尽情奔跑呢♪",
      "source_fingerprint": "1165982e1cb39a52a2c2c1e803deb28f6c52959417942c03133402ea60f7fb32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20025"
      ]
    },
    {
      "uid": "zhcn:e4cf89190355cbda12ad2b20",
      "kind": "character_system_text",
      "source_text": "有一群后辈一直在注意着我哦。\r\n呵呵，不小心就会太过卖力了呢♪",
      "source_fingerprint": "d8dae6295f058da63550d7b1ae8c4ae7db5b153fb5efd25e6d39becafaa47b8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20026"
      ]
    },
    {
      "uid": "zhcn:4860d51990d527673fad451e",
      "kind": "character_system_text",
      "source_text": "嗯，状态很好。\r\n为了回报你一直以来的陪伴，\r\n我一定会赢的♪",
      "source_fingerprint": "450157e74a8bf05207afae5e7d94b314686d87f9cecc9deb64f5c7ed85ae4216",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20027"
      ]
    },
    {
      "uid": "zhcn:b52e387647f014361ae30965",
      "kind": "character_system_text",
      "source_text": "这么重要的比赛嘛，\r\n我是绝对不可能输的！\r\n心情也调整地非常好了哦！",
      "source_fingerprint": "9cd51deaf810d154e92e29f67df71a856bf4c0bb882f7a542c3a5316131fb533",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20028"
      ]
    },
    {
      "uid": "zhcn:5129c59ab5174808e0f4559d",
      "kind": "character_system_text",
      "source_text": "比赛就快要开始了。\r\n训练员，就「球球」你\r\n好好为我加油咯！",
      "source_fingerprint": "dd0bdf33f9e95ec9ca1548cc7aa50edc4fd1101ef52f4944d1b939d8efc6035d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20029"
      ]
    },
    {
      "uid": "zhcn:375976ea3b574a746ebaa92d",
      "kind": "character_system_text",
      "source_text": "无论对手是谁，\r\n我都只需要尽情地去奔跑！",
      "source_fingerprint": "904b974f4881a9ffc62ec674c8a608f58f62eeca7b86f4aa9062a3a8b1890d39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20030"
      ]
    },
    {
      "uid": "zhcn:c56efa7a7a47ca3e67432532",
      "kind": "character_system_text",
      "source_text": "那我就要上场咯！\r\n你可不要错过我的表现哦？",
      "source_fingerprint": "5152476a8af897eb505994682eb129828ffe1139f94b64b3fc97f427ccd598ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20031"
      ]
    },
    {
      "uid": "zhcn:7dc4e17334a4d444e44cfb17",
      "kind": "character_system_text",
      "source_text": "稍微的准备不足不碍事的♪\r\n你要对我的能力有信心！",
      "source_fingerprint": "1f69c093d4c115711c6e446eed94e70216f74d7a1867182f1a70c48499ce30e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20032"
      ]
    },
    {
      "uid": "zhcn:d5d97a50afee5caba2d8f801",
      "kind": "character_system_text",
      "source_text": "虽算不上是万全准备好了……\r\n但只要有你看着我，\r\n我就一定没问题！",
      "source_fingerprint": "4633240b206c9c9ea1fafd8e91df07e483b29203ec1733110e9fd6b2e5049eab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20033"
      ]
    },
    {
      "uid": "zhcn:b9fd555d8d6c821cb7224891",
      "kind": "character_system_text",
      "source_text": "虽然也不是完全没有不安……\r\n但该做的都已经做了，\r\n剩下的就交给我吧♪",
      "source_fingerprint": "ca4d0bc825be901ebab8037d4e0c31e25bc8ba3d57edda8ec13f96b6e07fc53f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20034"
      ]
    },
    {
      "uid": "zhcn:ef067527ae76c97fad4ce140",
      "kind": "character_system_text",
      "source_text": "总不是每次都能在\r\n最佳状态下参赛的嘛！\r\n但我的心情并不低落，没问题的。",
      "source_fingerprint": "13a5f12bd9929f47e4b4d198787109a3f9f91c210ca0df0eb8e92277677a86aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20035"
      ]
    },
    {
      "uid": "zhcn:16543e2dc2d9aeb5f5b0fd8f",
      "kind": "character_system_text",
      "source_text": "无论状态多么差，\r\n我都绝不会抱着要输的心态去跑的。\r\n还有大家跟你在看着我呢。",
      "source_fingerprint": "93a620604c4be4164426513436bc983cd05db72f9ac5b5199e5bfeef2b15b598",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20036"
      ]
    },
    {
      "uid": "zhcn:d02295b264e21b7600e58918",
      "kind": "character_system_text",
      "source_text": "在这种状态下能尽情奔跑吗……\r\n不，没问题的！",
      "source_fingerprint": "73f588920c4523d33800749c6279b2934bcdbcb29babed9028a91dfaa9d8d31c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20037"
      ]
    },
    {
      "uid": "zhcn:6307891496561a6cab705f77",
      "kind": "character_system_text",
      "source_text": "OK哦！",
      "source_fingerprint": "0718a8ad6b32b7f5d887d4a240b539fe45acc3ee65ded792af4ec0f2be184099",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20038"
      ]
    },
    {
      "uid": "zhcn:4732e1a6aac4cc16b2a0a4b2",
      "kind": "character_system_text",
      "source_text": "我会加油的！",
      "source_fingerprint": "37856990395c2e8d2f93741c5d35fcb43678531f679cbab98ac4667a82bdf516",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20039"
      ]
    },
    {
      "uid": "zhcn:80cf240182188ea8f1662b48",
      "kind": "character_system_text",
      "source_text": "交给我吧♪",
      "source_fingerprint": "9d9aa7d90eab40729e98ee4362976726ae11336fa37396a3cbddcb784b47a556",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20040"
      ]
    },
    {
      "uid": "zhcn:5d52c9fa8183de8e259c79e0",
      "kind": "character_system_text",
      "source_text": "就这么做吧！",
      "source_fingerprint": "ed55896a91ce9fb27f01c61fc08829813f56c7c7f85176544912f96748735bb8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20041"
      ]
    },
    {
      "uid": "zhcn:bfacf8ce5914495fa9d9b34c",
      "kind": "character_system_text",
      "source_text": "唉……",
      "source_fingerprint": "fda4bd33d622bd98ca587ee7d715a334c1539d637bda2840b8a8e6b90025e5cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20042"
      ]
    },
    {
      "uid": "zhcn:38406622d66666dc5ba39fa2",
      "kind": "character_system_text",
      "source_text": "呜～…",
      "source_fingerprint": "6c1006da88249698a22b67f1d9fc5da3573185c190621ec7839b42dc3f704242",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20043"
      ]
    },
    {
      "uid": "zhcn:2ef76ecc5ce7241d697a3113",
      "kind": "character_system_text",
      "source_text": "我们走吧♪",
      "source_fingerprint": "87acf7dceacc0060a2d9da85debd02a2d7310f7a0402644ad624c55b6ef33803",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f8330545405416e1e7aaa87d",
      "kind": "character_system_text",
      "source_text": "Let's Go！",
      "source_fingerprint": "621ded1164a7026d01efbe963ab1eb3f8e95cfec42eb5caf5aa47f19ed78b25e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20047"
      ]
    },
    {
      "uid": "zhcn:e35af16292e4f8d75e60dc3d",
      "kind": "character_system_text",
      "source_text": "我跑得很尽兴哦！",
      "source_fingerprint": "a1d1f5e99557058b2e1197400b25cf59c95139cf517cd2da1170b49797c12e57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20049"
      ]
    },
    {
      "uid": "zhcn:cfb0568de3b5a6be13b3c39f",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员君♪",
      "source_fingerprint": "8924ff4a0484e448f0050d4216d41be9582d838c6b7ba4f6413eb093690fa4fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3f178799018797f2fbe02e1b",
      "kind": "character_system_text",
      "source_text": "那我们一起挥洒青春的汗水吧！",
      "source_fingerprint": "5b02acc4f03a810280e79b8fd3851dbce98fcce8cbe3cb0087ea0fad4bc725e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20051"
      ]
    },
    {
      "uid": "zhcn:78890b7e232ba87e0f498693",
      "kind": "character_system_text",
      "source_text": "状态超赞哦！\r\n我是不会踩刹车的，\r\n你可要好好跟上来哦！",
      "source_fingerprint": "a038ce1a6153d7b7d505d68852b9f1e766163ef5d214f0c24524e49fdbc43d5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "20102"
      ]
    },
    {
      "uid": "zhcn:d74eaba2323affddea19ff11",
      "kind": "character_system_text",
      "source_text": "专注力变得有点差……\r\n啊，但你不用在意啦！\r\n我没问题的啦♪",
      "source_fingerprint": "20b69357f9d242e550db19ea084fb22aa511115aa322747e0bc3523a78ead716",
      "source_path": "character_system_text_dict.json",
