        "91017"
      ],
      "json_pointer": "/1011/91017"
    },
    {
      "uid": "zhcn:c6c2248baa2685d98c7ece17",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "呣……小鹰真是的，\r\n又把作业忘的一干二净了。\r\n……看来又是说教魔法出场的时候了。",
      "source_fingerprint": "593d7a9438951bfac43cb21d503db8189707487f3a7f62e3093b1d52d6ec8c26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
