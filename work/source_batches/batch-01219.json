      "kind": "character_system_text",
      "source_text": "辛苦了。……还不错哦，谢谢。",
      "source_fingerprint": "a7f4b8b3759cb71395a86a26cbdccad377acc4b35ef0d4140742289d557167bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20049"
      ]
    },
