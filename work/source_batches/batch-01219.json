      ],
      "json_pointer": "/1011/91014"
    },
    {
      "uid": "zhcn:b812ef39f9a3c43c5bb5bebc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "ぴりっとした寒さ…こたえますが、\r\n私は結構好きですよ。\r\n身が引き締まる感じがしますから。",
      "source_fingerprint": "977c237cd4577e149b3c8b8d1cb71e56e17fdf2e9c1cd05c77d43d67f7ebc9cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
