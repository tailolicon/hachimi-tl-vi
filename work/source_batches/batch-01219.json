      ],
      "json_pointer": "/1011/91019"
    },
    {
      "uid": "zhcn:c70852a03a1c6119eacc218f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "如果能够使用瞬间移动的魔法的话，\r\n就可以随时参加在全国各地的赛跑场上举办的比赛了……\r\n看来这也是一种很好的武者修行呢♪",
      "source_fingerprint": "ccb2cd567ca00c12208b500335a97b59caccbe89e44169bb8742348760d80f23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
