    },
    {
      "uid": "zhcn:7befa46c95659fac2c5a3b5e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "阿嚏……\r\n难道是花之妖精的恶作剧吗？",
      "source_fingerprint": "831e5e04a5f909fbbd8d2c90a22537133017131ad297082389922ca944fe496f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
