    {
      "uid": "zhcn:4394c83ac295e76be69c9011",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "训练员也看到了吗？\r\n今天的朝阳是那么的美丽。\r\n这就是所谓的“别有趣味”吧～♪",
      "source_fingerprint": "407cbba9108e9d8ed97c26091ee01e0d48a80c5a18bb721b488df61d7bff098e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
