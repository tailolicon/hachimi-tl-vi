      ],
      "json_pointer": "/1011/91016"
    },
    {
      "uid": "zhcn:c74bac4bd139e85a2bda497b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然游戏给了我好像很难的印象，\r\n但通关的时候……\r\n能获得和赢得比赛时完全不同的成就感呢♪",
      "source_fingerprint": "e5888bea1b886402c5667d845e7be22b7e2e8548261034b535a55909fceefec6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
