      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1004",
        "400009"
      ]
    },
    {
      "uid": "zhcn:b700cb2a1539da9daa47f5cd",
      "kind": "character_system_text",
      "source_text": "让你看看引擎的差距。\r\n这就是！我的！油门全开！",
