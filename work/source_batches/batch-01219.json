      "source_text": "姑且向你道一句感谢吧。…谢啦。",
      "source_fingerprint": "e7a4fe3d7a7668ef383a052f953b50cc1b820a2ed3b8dcdc7abfe98bfedf70ad",
      "source_path": "character_system_text_dict.json",
