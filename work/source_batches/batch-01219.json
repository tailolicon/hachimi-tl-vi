    {
      "uid": "zhcn:30fd99d839b9edb64e625c69",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "お疲れ様です",
      "source_fingerprint": "ba6d317ce3a2bfaf3d87ba426113b0a3498828395ba8d093265eb3539b78c491",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
