      ]
    },
    {
      "uid": "zhcn:401388e478c22ddcd150a87d",
      "kind": "character_system_text",
      "source_text": "干劲十足，那么就出发吧！",
      "source_fingerprint": "6d5bb8baefdba1dea28b4ab24e31cf0f43f6d3a23dcfb55374c206f4acf8dc1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
        "2030"
      ]
    },
    {
      "uid": "zhcn:e0ff33ad09662c6becb0346c",
      "kind": "character_system_text",
      "source_text": "真是等不及了啊！",
      "source_fingerprint": "3efbb6d317ff3d558d83c7ba9afb038356c27fb61615da6172ff6973879f52f7",
      "source_path": "character_system_text_dict.json",
