      ]
    },
    {
      "uid": "zhcn:0ab671ecfc09aee3e14ffbef",
      "kind": "character_system_text",
      "source_text": "出发吧！",
      "source_fingerprint": "778f2d205d4eaf97bc7ba75792626a5d8a4695e1fb0cb5ca44b7b560dd525d9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
        "20046"
      ]
    },
    {
      "uid": "zhcn:b9f6844f5eadc724576c84f4",
      "kind": "character_system_text",
      "source_text": "真不错啊！",
      "source_fingerprint": "3b8abb036fae65fa4de32679499356eb7f1edb060f9b71c92b5e085a298b6fb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0390d235b6b51fcecd95c481",
      "kind": "character_system_text",
      "source_text": "多亏有你，让大家都见识到了我热烈的跑姿啊。",
      "source_fingerprint": "11252ffc5c88895c83d46db63e8571dc6ea5bd3dbf957a92936c61b645ddf4c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
        "20049"
      ]
    },
    {
      "uid": "zhcn:d8a30b80c21a1a4677bfca24",
      "kind": "character_system_text",
      "source_text": "能和你作搭档，我很开心哦！",
      "source_fingerprint": "e4ce5e07eb862a57f02daf80ec543e70bb4c6110937b12ea2136dbec1e16b0f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
        "20050"
      ]
    },
    {
      "uid": "zhcn:898a86898e17ef28960071f3",
      "kind": "character_system_text",
      "source_text": "好嘞，那么就来单挑吧！",
      "source_fingerprint": "6ddcbe94679cbd71957fcc2cbf67168a4b4011b42ba7bb270a780aaa56c6b806",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
