        "1012",
        "20042"
      ]
    },
    {
      "uid": "zhcn:dcd7fb6ec386a14dd547a8cc",
      "kind": "character_system_text",
      "source_text": "咕～……",
      "source_fingerprint": "3cc50b1c6943799bb70fe9b180e36f2e91c074d79fc5d41d5a6674b77680e364",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1012",
