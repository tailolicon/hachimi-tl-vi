  "entries": [
    {
      "uid": "zhcn:4c9b8a5051074c930c38434f",
      "kind": "character_system_text",
      "source_text": "啊──！！",
      "source_fingerprint": "3a80647b1d659dd010d5995880af344571f3f0d198b03e28fa7d396d91bc0dad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "140014"
      ]
    },
    {
      "uid": "zhcn:81d762924bc80391f7982316",
      "kind": "character_system_text",
      "source_text": "咦～！",
      "source_fingerprint": "70f6bae6cbff9e5d86ca2981e108ede3836f3ead743b043f685ffb4863b2860a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "140015"
      ]
    },
    {
      "uid": "zhcn:e2df5ab5df20c5027fdb8c1b",
      "kind": "character_system_text",
      "source_text": "Excuse me。",
      "source_fingerprint": "f57aae16de78672cc01136c14886af48d8d2f6aa0ca87e24a20d7283becdd63b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "140016"
      ]
    },
    {
      "uid": "zhcn:a4a52e7a23977c27ae6b04ad",
      "kind": "character_system_text",
      "source_text": "No……！！",
      "source_fingerprint": "a2d9eb6621f638be9bc38e18febfd306d34320b20cd760b7cf7b42f64b5f4d89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "140017"
      ]
    },
    {
      "uid": "zhcn:444a75a4ed9a543ab1ce778f",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "140018"
      ]
    },
    {
      "uid": "zhcn:9d41066a9f9632339c04ac13",
      "kind": "character_system_text",
      "source_text": "明天好像可以拿到这个Death！",
      "source_fingerprint": "cad898f2c9aa2618b68dbc4020ac4bcff6dd69ce6c059c60b91dd2e8b049c67c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "15"
      ]
    },
    {
      "uid": "zhcn:82defb9891715e3ecd7c6c40",
      "kind": "character_system_text",
      "source_text": "No～我的脚跟不上\n我的Heart了Death。",
      "source_fingerprint": "e9a1d3430964e165d4ecd8e9f6f18a3e0699ab80819c0b5e18066e7b3bfc3b8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20000"
      ]
    },
    {
      "uid": "zhcn:b7cdd5466f902bb192ed991c",
      "kind": "character_system_text",
      "source_text": "Well～使不出Power呢……",
      "source_fingerprint": "022ff1059d50aa9eff4c104477044294d90a337aeadfbd762fa5da0445a92614",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20001"
      ]
    },
    {
      "uid": "zhcn:b91a333c03b942d78df068c7",
      "kind": "character_system_text",
      "source_text": "没有时间可以浪费了！\r\n请什么都让我尝试看看吧！",
      "source_fingerprint": "c78f651bbb2cb2cc733086bf64724e1043789ae29e59f4901474a189f0271a79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20002"
      ]
    },
    {
      "uid": "zhcn:0087ad626265a2334ed8983a",
      "kind": "character_system_text",
      "source_text": "包在我身上吧！",
      "source_fingerprint": "b15e9735b4c9dcc213d0dce868f5db1f680ca6301108802d3082dc522a1d84d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20003"
      ]
    },
    {
      "uid": "zhcn:3051739876cb247b417fee35",
      "kind": "character_system_text",
      "source_text": "嗯～好舒服的风Death！\r\n身体也感觉蠢蠢欲动了呢！",
      "source_fingerprint": "9163f98d66da903cbc75e54b7dd29c8ac5458f0caf8d336cd36d54959979da75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20004"
      ]
    },
    {
      "uid": "zhcn:434c4816cba5e580373ac1d8",
      "kind": "character_system_text",
      "source_text": "我期待你安排\r\nNice的训练哦！",
      "source_fingerprint": "da569d4e7d0f424f37a6fb90bddfcf044b8b9207d1b65fad39f135211be2623b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20005"
      ]
    },
    {
      "uid": "zhcn:098773082acf0c127f54182a",
      "kind": "character_system_text",
      "source_text": "今天我也会努力的～！",
      "source_fingerprint": "b43838163a096d11c03d2b49256719b3d6163a338bcae8ff8ce31e5448d5e0f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20006"
      ]
    },
    {
      "uid": "zhcn:a2cc8fd54fa5a4f3f91e4880",
      "kind": "character_system_text",
      "source_text": "请告诉我训练的Menu吧！",
      "source_fingerprint": "e29d63fe5421a7e17dad28e18573efcaa3e8d8e18a101f2ee5d4aff873dda1b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20007"
      ]
    },
    {
      "uid": "zhcn:a353180bedab668a59437653",
      "kind": "character_system_text",
      "source_text": "Well……\r\n想要做愉快的事情Death。",
      "source_fingerprint": "413aee1c355851086515ae4f3e0a2ef8dcccdaaf8f96269ad639f8d777518659",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20008"
      ]
    },
    {
      "uid": "zhcn:4952b77c98c01c3cb09d8af0",
      "kind": "character_system_text",
      "source_text": "啊……是蝴蝶呢！\r\n…Oh，差点忘记自己正在训练。",
      "source_fingerprint": "f9caf0b0cc8cc902bc445b134a8b9dbe1de0d706a0607e30b9f5ae9fe3a42dc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20009"
      ]
    },
    {
      "uid": "zhcn:14851d0a82ab5cefd3b70b11",
      "kind": "character_system_text",
      "source_text": "唉……感觉很Nervous呢Death。\r\n早餐也只吃了五个Hamburger，\r\n就觉得吃不太下了……",
      "source_fingerprint": "8ac1ba1020762771794baff000dc9a866c7338c6d841a3f9aa9bdca4f09f8253",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20010"
      ]
    },
    {
      "uid": "zhcn:aacdbc392a55b66107dfdd99",
      "kind": "character_system_text",
      "source_text": "呜呜……爸爸……妈妈……",
      "source_fingerprint": "205928a7f82a7ff8af922ce3fef682b7476d0ff395691ca031aa6d1477f71a3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20011"
      ]
    },
    {
      "uid": "zhcn:f7b5cb6141c555e96e799ffb",
      "kind": "character_system_text",
      "source_text": "该不会……\r\n又要参赛了吧？",
      "source_fingerprint": "7f6bf96f55711bc57c7c3956d498ce2b60ca6d7b687b625e8c3b3d5e93b53db1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20021"
      ]
    },
    {
      "uid": "zhcn:c8026acaccb8d814c3995db3",
      "kind": "character_system_text",
      "source_text": "暂时不想要再参赛了Death……\r\n请让我休息吧……",
      "source_fingerprint": "433a7dff0cc107a7b4f361a2157403d39d3741ade606f0250531ef0a7eb3bc3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20022"
      ]
    },
    {
      "uid": "zhcn:3ed0dbd70b3c8f5ef4e0771a",
      "kind": "character_system_text",
      "source_text": "我会努力不辜负你的期望！\r\nNo.1是唯一目标Death！",
      "source_fingerprint": "55f9ac6167734d34c5d9c7d38e4718c337b8dc0cbf5101f57264c82fd653a383",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20023"
      ]
    },
    {
      "uid": "zhcn:7fed59f37847f0944adc6a27",
      "kind": "character_system_text",
      "source_text": "任何状况都No Problem！\r\n我会努力专注到最后一刻的！",
      "source_fingerprint": "07120896f764e7a9f7a8c6cfe85f6c2490f45a76fbca72d5e45d92704fc263e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20024"
      ]
    },
    {
      "uid": "zhcn:c7079822a6126dbed869801b",
      "kind": "character_system_text",
      "source_text": "准备得很Perfect了Death！\r\n我随时都可以迎战Death！",
      "source_fingerprint": "f382b03a229e10bf848eb4e8b1354677c056c7ff077f4a2c0ad8c67175e55af8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20025"
      ]
    },
    {
      "uid": "zhcn:2486bde362dedbbe41fa2424",
      "kind": "character_system_text",
      "source_text": "Condition良好！\r\n不用担心的Death！",
      "source_fingerprint": "d80b1097a752ecbff8c20e786d524fd62faf6c9597723b98c6631c702932e6c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20026"
      ]
    },
    {
      "uid": "zhcn:e17c94de5b5e9ddf51986800",
      "kind": "character_system_text",
      "source_text": "脚的状态很Good！\r\n请你期待好的成果吧！",
      "source_fingerprint": "872db9f15259f608ca98d31f7ae9f3bf53eac70974db5bed096a8249386c4f92",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20027"
      ]
    },
    {
      "uid": "zhcn:8b6e6288e20f694b2e7d2335",
      "kind": "character_system_text",
      "source_text": "我感到期待不已呢！\r\n想要快点Gate in了Death！",
      "source_fingerprint": "81674b1839ae75b691009f490302d9533f005c3a14b716aa1d239ded1a69472e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20028"
      ]
    },
    {
      "uid": "zhcn:cbc409fb26cf2d18775c5b8e",
      "kind": "character_system_text",
      "source_text": "那我们走吧！",
      "source_fingerprint": "11c73288d9b7121275d194680c6cb854b10e796aab453c659bdc1ee757d3e723",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20029"
      ]
    },
    {
      "uid": "zhcn:e1c4d322f2d380c8c32019f8",
      "kind": "character_system_text",
      "source_text": "我会让这场比赛\r\n很Exciting的！",
      "source_fingerprint": "7d23ae9bdd5d71107e908f48b32699385f7dcbc2ed9191dd14f54a3fc45a9c20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20030"
      ]
    },
    {
      "uid": "zhcn:9913ca9f0b147ea5ce95cc15",
      "kind": "character_system_text",
      "source_text": "我会像平时一样好好享受奔跑的乐趣！",
      "source_fingerprint": "c57e1583178b5a193db5b6c6da675c5fabe35f98a95092d10c439c93d9593355",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20031"
      ]
    },
    {
      "uid": "zhcn:3436bc084a64b6eb78731661",
      "kind": "character_system_text",
      "source_text": "虽然我比平时还要紧张……\r\n但也很期待哦！",
      "source_fingerprint": "1dd2c29c39983f9893e77c46a07f81fd095917614cae60ad6f8fd10a3cd3dd97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20032"
      ]
    },
    {
      "uid": "zhcn:30aa16bd28a4ad42996f0ac3",
      "kind": "character_system_text",
      "source_text": "What！？比赛已经要开始了吗？\r\n那我要赶快做好心理准备！",
      "source_fingerprint": "34810b1fc4434e3833608939f98d5535f278f332e7a5810e0b17aa6303dcda22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20033"
      ]
    },
    {
      "uid": "zhcn:4ffc5fc1e453df38bed9c1d2",
      "kind": "character_system_text",
      "source_text": "Smile， Smile！\r\n越感到不安就越要露出笑容……Death！",
      "source_fingerprint": "12d721fa01043c378865c76d74b22765d476237744a21ba519685869936ee446",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20034"
      ]
    },
    {
      "uid": "zhcn:b05b6d52bf029cf6352483aa",
      "kind": "character_system_text",
      "source_text": "就算是Bad Condition，\r\n我也不想要跑输……！",
      "source_fingerprint": "19f83158c1fcfbe5413d5b0ba3666d5e8f4fee0b7f5ffa0b489e955943a632b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20035"
      ]
    },
    {
      "uid": "zhcn:481747b919768d8f96c25f09",
      "kind": "character_system_text",
      "source_text": "……就算实力不够，\r\n我也会努力跑完的！",
      "source_fingerprint": "619c807c57235e5ed7fcf7783541f129b780703ef90e8dd6e8d3c38cead114fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20036"
      ]
    },
    {
      "uid": "zhcn:be7c75d90f9af74d4690b55e",
      "kind": "character_system_text",
      "source_text": "到这个地步了，\r\n只能Go For Broke了！\r\n也就是孤注一掷Death！",
      "source_fingerprint": "0de57edc72802032fae999aa04959449617262803a9fd05d4fb154a4c032a58b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20037"
      ]
    },
    {
      "uid": "zhcn:dfdd2a72010f9afe13666241",
      "kind": "character_system_text",
      "source_text": "Here We Go！",
      "source_fingerprint": "b72522e16845d56a28a8d151295d9d76b40048e02e273c2fa92814f3d15181a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20038"
      ]
    },
    {
      "uid": "zhcn:c7ea23851f1942e044f284a8",
      "kind": "character_system_text",
      "source_text": "Yippee-ki-yay！",
      "source_fingerprint": "e8b55125b541173ae8c2f9a2dfeed5619cc930f3e8e10ebb98df5a7bebe2d6cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20039"
      ]
    },
    {
      "uid": "zhcn:d4ef3117d7a12e568c00f886",
      "kind": "character_system_text",
      "source_text": "Let's Do it！",
      "source_fingerprint": "15ff1bbcbc7f1c7b1a40e31ae30a4f5cfc2c7b157dd5a9f3636b9a3fb2a8092e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20040"
      ]
    },
    {
      "uid": "zhcn:29d1b853e785198f2be00544",
      "kind": "character_system_text",
      "source_text": "我会做到的……！",
      "source_fingerprint": "3b99913fe63a0148e5d35d4b56805cc1b0f03b5a83633043d054382fd87bd136",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20041"
      ]
    },
    {
      "uid": "zhcn:65e62286b0b6b5aae6b17014",
      "kind": "character_system_text",
      "source_text": "Ouch！？",
      "source_fingerprint": "b60f677432b3945fe51b3455f43854b20b4c7212e781faa8932c6ca9292c3f3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20042"
      ]
    },
    {
      "uid": "zhcn:c4451b6566619c997bc3a773",
      "kind": "character_system_text",
      "source_text": "Well……",
      "source_fingerprint": "8c4e7bb6a61844b2a933fb10bf8253188f9f1c4e0760154f7a13f54184bc2749",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20043"
      ]
    },
    {
      "uid": "zhcn:1ab2e6fd825cc5e33c6e1bd0",
      "kind": "character_system_text",
      "source_text": "Let's Enjoy！",
      "source_fingerprint": "8d6ed1707bae2dd0e631db3f670d6d914887d61030b99b8d8fa5c32b73789606",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20046"
      ]
    },
    {
      "uid": "zhcn:003b147b3a0d9e5380f15f8a",
      "kind": "character_system_text",
      "source_text": "海啊～！",
      "source_fingerprint": "0ff1e25432c94667ce53d23be9abd0d986450dac40f8766739cb9029ebe37108",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20047"
      ]
    },
    {
      "uid": "zhcn:55298e0906acdc2be54719f5",
      "kind": "character_system_text",
      "source_text": "我变强了！",
      "source_fingerprint": "9e8160e864e2433ee66565c6c9239c907ac34208a8fdd0eb9802e965e850be12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20049"
      ]
    },
    {
      "uid": "zhcn:a033a21ab33a6de8e4a54585",
      "kind": "character_system_text",
      "source_text": "训练员，你辛苦了！",
      "source_fingerprint": "7c608242dd5be06fbce73bd1c326b67e8894c5fa39dd78bb6b36969f8bb5adaa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20050"
      ]
    },
    {
      "uid": "zhcn:e3842926520b4742fbb214b5",
      "kind": "character_system_text",
      "source_text": "一起Enjoy训练吧！",
      "source_fingerprint": "11bd263f72657a49e990654d4a40e9b04827209b7ffad352356c3d3d72830a52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20051"
      ]
    },
    {
      "uid": "zhcn:8a4a6796aa8ea41d4265ee62",
      "kind": "character_system_text",
      "source_text": "我的目标是Victory！",
      "source_fingerprint": "26c20d959a862cce0c8d7bfa27001c05172731976e306bfa29a9bff1c2880be9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "2030"
      ]
    },
    {
      "uid": "zhcn:a5214981e7ef522b55bddd75",
