        "2032"
      ]
    },
    {
      "uid": "zhcn:802217cb03976217d67d5343",
      "kind": "character_system_text",
      "source_text": "感觉会有好的表现呢。\r\n看着吧，训练员！",
      "source_fingerprint": "dffa5239af4f37fcb3d0a59f13f6abfd6eb74cd990eb0fc00295652fcabed7b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1006",
        "2033"
      ]
    },
    {
      "uid": "zhcn:a18f4c9bfe5327df3f133d59",
      "kind": "character_system_text",
      "source_text": "吼、吼、吸、呼～！\r\n状态很好！尽管吩咐吧！",
      "source_fingerprint": "7fe15a9b4775b24936170642419878cfd5334bbf8b669beb5bf92365b90253d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
