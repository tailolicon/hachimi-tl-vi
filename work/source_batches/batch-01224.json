      ]
    },
    {
      "uid": "zhcn:747bfaf247dfd4befcc183d0",
      "kind": "character_system_text",
      "source_text": "尽是些饶有趣味的故事呢♪",
      "source_fingerprint": "985cd6ce09d4807176d7b7da0de0551e5577b3dc04e3ed8515299217e5a0da37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "110001"
      ]
    },
    {
      "uid": "zhcn:dd78805467189e2de241fda2",
      "kind": "character_system_text",
      "source_text": "要去报名参加比赛吗？",
      "source_fingerprint": "343b78e6fdc6dfe2906052ca98f00b3915b5d1b9e90b69b62f080654c80ff299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
