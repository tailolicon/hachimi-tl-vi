    },
    {
      "uid": "zhcn:04be3b9931dd0174e43f028f",
      "kind": "character_system_text",
      "source_text": "冷静地开始吧～♪",
      "source_fingerprint": "ba8fff8a50da6fb432002a6558b921c998ed2e1699e5bf5c4d9c0bc93a4b9371",
      "source_path": "character_system_text_dict.json",
