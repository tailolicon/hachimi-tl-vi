      ]
    },
    {
      "uid": "zhcn:65fbeaa1b812ee2ac80ec43f",
      "kind": "character_system_text",
      "source_text": "要进行怎样的训练项目呢？",
      "source_fingerprint": "5fca5e4bf6ee1f8e02eeb165bc0f629df46d96d1e4d8bb579d7aac37d3dd5665",
      "source_path": "character_system_text_dict.json",
      "json_path": [
