      ]
    },
    {
      "uid": "zhcn:c9c889f756ae218acc923623",
      "kind": "character_system_text",
      "source_text": "呵呵～",
      "source_fingerprint": "5c2b7bb9e5afc265223f2935720e0f47abc4e166cc3bf311de65c1315b6ecd21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140009"
      ]
    },
    {
      "uid": "zhcn:afe115790116f993f0dbd735",
      "kind": "character_system_text",
      "source_text": "嘛啊～，呵呵♪",
      "source_fingerprint": "53283fdab009e6090b38957e522550ee94d3934377bffd430025ca54a534e195",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140010"
      ]
    },
    {
      "uid": "zhcn:aa24f2436db3bb65dddf6bbe",
      "kind": "character_system_text",
      "source_text": "诶呀，嘛啊～！",
      "source_fingerprint": "fb0fa09e4b9ab5646cf3d3cdf6eb7846c2f50d5ed1ad731af6875973baf0912a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140011"
      ]
    },
    {
      "uid": "zhcn:3cafb3602e68b926368c2ab5",
      "kind": "character_system_text",
      "source_text": "嘛啊！",
      "source_fingerprint": "f901023eab678a8b456e8719413f1a18f9e62c75fe756a251851def4d056a318",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140012"
      ]
    },
    {
      "uid": "zhcn:baa97f0fe3a736a8e45653cd",
      "kind": "character_system_text",
      "source_text": "真不愧是训练员",
      "source_fingerprint": "b025aea7392f091085317183e7bb90beb6aad5ec1304f8db28c6379fea0b0fb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140013"
      ]
    },
    {
      "uid": "zhcn:8db9f687931538e354e45702",
      "kind": "character_system_text",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140014"
      ]
    },
    {
      "uid": "zhcn:df9709a7b8dba1e663d6c7d6",
      "kind": "character_system_text",
      "source_text": "嗯嗯～……",
      "source_fingerprint": "193359778c837e8d3a54e34b0d07640f77afc8121eda0a62e16d973e4b3894f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140015"
      ]
    },
    {
      "uid": "zhcn:ae855abc61125ec18987907e",
      "kind": "character_system_text",
      "source_text": "喂～喂♪",
      "source_fingerprint": "14d807217637c5b86f2d4dd9475ac6708b974edd99c54253f92c1ed5ee753570",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140016"
      ]
    },
    {
      "uid": "zhcn:29c6d165f3c480506e0498a9",
      "kind": "character_system_text",
      "source_text": "嘛啊～……",
      "source_fingerprint": "b12a8c16c127a4e172528680603d22acfc16e4e1bc2878fac1972245eff10d9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140017"
      ]
    },
    {
      "uid": "zhcn:abb835e18aa3a3305dda25b8",
      "kind": "character_system_text",
      "source_text": "诶呀，嘛啊……",
      "source_fingerprint": "94627a162e15cdb37659472a27d48379e28d47f1a39f13a0ffc474b25c590b08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "140018"
      ]
    },
    {
      "uid": "zhcn:d83ee319f8b9a2f263a7e338",
      "kind": "character_system_text",
      "source_text": "明天的话\r\n好像能拿到这些哟。",
      "source_fingerprint": "5da1a3770f5845c8206ec935aae5abf0e8c2a785fdabd3944a44cd56633e2539",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "15"
      ]
    },
    {
      "uid": "zhcn:6462fe9aa6e353605f08c6e4",
      "kind": "character_system_text",
      "source_text": "这种程度的疲劳，\r\n怎么说好呢……\r\n还请不要在意。",
      "source_fingerprint": "86a0a33a112ba8f163fe3ed5a92ea736f77c6a126ba7e67296bfdf633690ad68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20000"
      ]
    },
    {
      "uid": "zhcn:c1cf584b6cf0d9c596d2fed9",
      "kind": "character_system_text",
      "source_text": "……好像稍微感觉有点累了。\r\n不过……我还可以继续。",
      "source_fingerprint": "9c279683524edb5e279a87124147856c19252632dd4ed4427eeb1767d26abb09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20001"
      ]
    },
    {
      "uid": "zhcn:af61951649a463dd273ca063",
      "kind": "character_system_text",
      "source_text": "因为太想赶紧跑起来，\r\n心情也变得焦躁不安起来了……\r\n呵呵，这样可不行呢。平常心、平常心♪",
      "source_fingerprint": "9c12718d2f215c41dc52070812d15fe1c2792c85541564c10591c1aa54e48798",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20002"
      ]
    },
    {
      "uid": "zhcn:400381c59756a9561e45d22a",
      "kind": "character_system_text",
      "source_text": "感觉身体变得非常的轻快……！\r\n呵呵，看来今天能够\r\n跑得比平时还要多呢。",
      "source_fingerprint": "83ca57ae6f9964ed9ab91483cfb2234605b5a686f2aaea662bfe10c2851def7c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20003"
      ]
    },
    {
      "uid": "zhcn:a13b8274f7d2169544099234",
      "kind": "character_system_text",
      "source_text": "不管怎样的训练项目也请交给我吧♪\r\n我会悠闲自在地完成的。",
      "source_fingerprint": "287be7c2bb470d34fa2dd80d323114f4ef6d93bda99334b156908d38f2aed109",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20004"
      ]
    },
    {
      "uid": "zhcn:65714977fc1069833965441e",
      "kind": "character_system_text",
      "source_text": "嗯～，天气可真不错呢……！\r\n看来可以轻松自在地跑起来了。呵呵♪",
      "source_fingerprint": "0c5ef1b512e42052c7c4655fcc151fee8b467864dd0101d5cdc087c43d9ad08b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20005"
      ]
    },
    {
      "uid": "zhcn:d97348bd07ce813b7fd19163",
      "kind": "character_system_text",
      "source_text": "常言道“淹死的都是会游泳的”……\r\n虽然身体状态不坏，\r\n但也不能掉以轻心呢～。",
      "source_fingerprint": "056b46fac65594b9c2eb873497fa152a432c6c3f92ce26ac2faf76b65e84b536",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20006"
      ]
    },
    {
      "uid": "zhcn:c59c8c75dbb6a41ec4cdb91e",
      "kind": "character_system_text",
      "source_text": "让我们以冷静的心态保持平常心。\r\n一起努力吧～。",
      "source_fingerprint": "954cc20e68576802a0b2333e836f44e34445352b53e3a1205ebaf6f3e96a56bc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20007"
      ]
    },
    {
      "uid": "zhcn:8fa1232bef7f46dcce7a66cb",
      "kind": "character_system_text",
      "source_text": "正所谓“人生枯荣无常”。\r\n即使现在的状态很不好，\r\n但以后一定会好起来的。",
      "source_fingerprint": "916fd6af1e6d42cfc79767573a27d3b8d25f14f19d6fe0125296075eabfc5c9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20008"
      ]
    },
    {
      "uid": "zhcn:95916f7ee108bf454b67a9ad",
      "kind": "character_system_text",
      "source_text": "虽然身子稍微有些发沉……\r\n但是没关系的，我还可以继续。",
      "source_fingerprint": "412c3d6b979d6d3410ffa3578675de4ebfdee88331b2aa9f1fb464030b09f7ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20009"
      ]
    },
    {
      "uid": "zhcn:82401b697e306d803732877b",
      "kind": "character_system_text",
      "source_text": "“画龙而未点睛”……\r\n大概就是说现在的状况吧……\r\n不想些办法来重整旗鼓的话……",
      "source_fingerprint": "ab57d029077962df51c04df848b3d319263a8a5025592d6794de9610514ab577",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20010"
      ]
    },
    {
      "uid": "zhcn:e2f3f4a3fabc9d7c79468231",
      "kind": "character_system_text",
      "source_text": "明明无论对手是谁……都不想输的……\r\n身体状态这么差的话……我不就……！",
      "source_fingerprint": "96f0e5f299c77ad67342cbd7deaf326ee1d7735431e538ca677bb1b1a4551792",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20011"
      ]
    },
    {
      "uid": "zhcn:722d9b1a13bef5a5771e2910",
      "kind": "character_system_text",
      "source_text": "最近参赛的频率很高呢……\r\n没问题吗……？\r\n没有，因为看您好像有些焦急的样子……",
      "source_fingerprint": "c191873bbc1c54f81033c1f822438c89487fdc041b99167f104f978c969fd651",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20021"
      ]
    },
    {
      "uid": "zhcn:87d62d8b7310e4870d9e9d6c",
      "kind": "character_system_text",
      "source_text": "“过犹而不及”。\r\n凡事都是有个度的。\r\n究竟是否要参加这场比赛，还请仔细考虑。",
      "source_fingerprint": "581f3b5730595b8132eb9fcc9d72b42b326c904dc507a3e409621c2e05ea8318",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20022"
      ]
    },
    {
      "uid": "zhcn:469e18518989d02d281135b8",
      "kind": "character_system_text",
      "source_text": "虽然一直在努力尝试压抑兴奋的心情，\r\n但果然还是难以抑制呢。不过……\r\n正式比赛前还是好好把它隐藏起来吧。",
      "source_fingerprint": "ee676d6064a895ffdca297754edd18639535a4fcf1279675cd9d89bbab3946cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4dcd9cf66b87ffbf6e7f3f6f",
      "kind": "character_system_text",
      "source_text": "反正现在的我也正在势头上，\r\n就算是比赛也能“顺风扯帆”般\r\n顺利夺得胜利的吧♪",
      "source_fingerprint": "5f63d049350ad495f98609ac9a7aea82256b2bb0b08d6b747cf922111214cbab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20024"
      ]
    },
    {
      "uid": "zhcn:08b9cb745d26e4cde125fe57",
      "kind": "character_system_text",
      "source_text": "总感觉力量源源不断地从身体涌出来了……\r\n看来想要保持平常心看来会很困难呢。\r\n……比赛，还没开始吗？",
      "source_fingerprint": "f02bfcf851b98b50b2ac5da48b6789846cf6f77457b34c24b0da74b711901eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20025"
      ]
    },
    {
      "uid": "zhcn:a5d4c00547a07dda97a82976",
      "kind": "character_system_text",
      "source_text": "很快比赛就要开始了哟。\r\n要保持平常心……呼呼，不行呢。\r\n太过于期待比赛了，心里痒痒的。",
      "source_fingerprint": "b3e95a365b4377459d8475a38635667cbb9b8b297c7c345881a3e15851ed1635",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20026"
      ]
    },
    {
      "uid": "zhcn:0b56938c1f022195c57f0d66",
      "kind": "character_system_text",
      "source_text": "面向目标比赛的状态调整也很充分了～。\r\n很期待正式比赛呢♪",
      "source_fingerprint": "e72f20c829d563dfdf15aed23b6d554ea8f861acdae7b0418afafcc3d359e045",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20027"
      ]
    },
    {
      "uid": "zhcn:48bfda44e4a2d879d553b23e",
      "kind": "character_system_text",
      "source_text": "我已经准备万全。\r\n为您献上最棒的跑姿哦。",
      "source_fingerprint": "711e90a4037edff5d92b9a5ff39cafcf1eda542198b93f4ed89fc78698ffc060",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20028"
      ]
    },
    {
      "uid": "zhcn:02b0aa3f22c9714e8ee62a42",
      "kind": "character_system_text",
      "source_text": "终于到了目标比赛的日子呢。\r\n我会沉着冷静，以平常心去参赛的。",
      "source_fingerprint": "09e463bac6a4feb1532bce58dd2741c46bc1d3e2656319227a2342f185fce1e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20029"
      ]
    },
    {
      "uid": "zhcn:03404df47a93ea2c2ead728d",
      "kind": "character_system_text",
      "source_text": "那么，到了正式比赛的时候了呢。\r\n我出发了♪",
      "source_fingerprint": "8684370ae6ed2b670f1175604b177a4cde34c2e68986555debe55dfe0ab25c56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20030"
      ]
    },
    {
      "uid": "zhcn:e1e8faec045b5f966a370bc9",
      "kind": "character_system_text",
      "source_text": "“与往常一样”，才是最好的吧。\r\n即不疏忽大意也不焦躁气馁。",
      "source_fingerprint": "2c32d1604aec0ecbe70c397a659c6a2f285bfc2c178b2af5eab5e45623b671c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20031"
      ]
    },
    {
      "uid": "zhcn:52575a9f25eb2fe56c834c8d",
      "kind": "character_system_text",
      "source_text": "虽然状态多少有些糟糕，\r\n但也应该有着与之相应的跑法。\r\n抱着“背水一战”般的觉悟，我出发了。",
      "source_fingerprint": "590932b04ac9753ae09cf8e00d59c3ef4701e5a65d2ceaf84a5627c5c58f81bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20032"
      ]
    },
    {
      "uid": "zhcn:f5bfea5a5aa63c70e1372f69",
      "kind": "character_system_text",
      "source_text": "虽然现在稍稍有些困难……\r\n但我丝毫没有想要输给对手的心情。",
      "source_fingerprint": "4a108e10c037c62ebab1d2ef71c6ccb582fdf49fee9d531688b5cf2f20b219dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20033"
      ]
    },
    {
      "uid": "zhcn:8415c51e752234c88c518953",
      "kind": "character_system_text",
      "source_text": "我已经做好觉悟了。\r\n不管状态如何，\r\n目标也只有一个……那就是夺得胜利。",
      "source_fingerprint": "6c3a45c6206de461ea68cb9b4d94d21412ffd56243cba4f48d16321de2760578",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20034"
      ]
    },
    {
      "uid": "zhcn:983a1012564a4951ef743dec",
      "kind": "character_system_text",
      "source_text": "“不入虎穴焉得虎子”。\r\n这也是为了寻找出路……\r\n总之我会全力以赴的。",
      "source_fingerprint": "daaf1d1402b0a92169e87a319430206afaca47f4688e182840c470fe2737b9e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20035"
      ]
    },
    {
      "uid": "zhcn:f522881879d22dc801e51f91",
      "kind": "character_system_text",
      "source_text": "困兽犹斗、\r\n穷鼠啮狸。\r\n我也……应该有着能在逆境中爆发出来的力量……！",
      "source_fingerprint": "437efd80571a359817f87f5897ce2cdb089cf7bea82c303032436289f7cb233d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20036"
      ]
    },
    {
      "uid": "zhcn:a5e5d80773fc5fd7f82e3855",
      "kind": "character_system_text",
      "source_text": "不管身体状态有多么的差，\r\n只有这份不想输的气势绝不消散。\r\n我……很讨厌放弃。",
      "source_fingerprint": "9c3812aea959efef1a606796399d24d2a0ab99701e93597f17ae38324f180484",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20037"
      ]
    },
    {
      "uid": "zhcn:6a57cf4253550623fa1fafff",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20038"
      ]
    },
    {
      "uid": "zhcn:dea70201bde696e507d10193",
      "kind": "character_system_text",
      "source_text": "我会加油的。",
      "source_fingerprint": "5e1e04ca0fa6cabf572aaedefcfd9e13cbbafaadb54df1396aaf088b0b4eafbb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20039"
      ]
    },
    {
      "uid": "zhcn:e98f8d30c6aae2121d4b50e8",
      "kind": "character_system_text",
      "source_text": "我出发了。",
      "source_fingerprint": "874e7497e7be8367a4f334f4c7f1d69916bd93469660e8935829876ff0311191",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20040"
      ]
    },
    {
      "uid": "zhcn:66fcd8834aea329a77abc83a",
      "kind": "character_system_text",
      "source_text": "还请交给我。",
      "source_fingerprint": "eb7cf51c28d6b2eacf53aba4f1e11c464febaf6c5b8d2ef07147392114bfa33f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20041"
      ]
    },
    {
      "uid": "zhcn:b2cfbde86b042712361089a1",
      "kind": "character_system_text",
      "source_text": "啊啦啦……",
      "source_fingerprint": "5e2450167a28d91b57529a6f07e9aba293c375f860b854d52567391412305fae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20042"
      ]
    },
    {
      "uid": "zhcn:bfd18ef5d3d67a6637b263df",
      "kind": "character_system_text",
      "source_text": "嗯～……",
      "source_fingerprint": "b44f0ced1c9eefcb4c785ebf99fa75fa7a9b475fd90ec6fdc1c54f86243188ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20043"
      ]
    },
    {
      "uid": "zhcn:77abe3ccbfdf0160726b461f",
      "kind": "character_system_text",
      "source_text": "那么就出发吧～♪",
      "source_fingerprint": "fabf9678575a59af5b6cfd4ba08a99f35dfe3f16fd6719ad47beeb81b0d408ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20046"
      ]
    },
    {
      "uid": "zhcn:847453076736d80fa13ef832",
      "kind": "character_system_text",
      "source_text": "我很期待哦。",
      "source_fingerprint": "85e43867c9c82fc5f814ad3d380ebfd95c4e51a0aea92bfbae82c3d7d8d81a5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20047"
      ]
    },
    {
      "uid": "zhcn:4138e4c0473bef72e6034093",
      "kind": "character_system_text",
      "source_text": "今后也请您多多指导，以及鞭策我了……♪",
      "source_fingerprint": "d13c154eaa8a57a4e369f5c20c45fd66aece65b2a0e20017322991638ba9c861",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20049"
      ]
    },
    {
      "uid": "zhcn:2efe5f6afbb0a680683d41a5",
      "kind": "character_system_text",
      "source_text": "训练员，非常感谢您。",
      "source_fingerprint": "7db73f9d844b29c02a956bf769e9649feaf24c911f853311aac23ef30dc48358",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20050"
      ]
    },
    {
      "uid": "zhcn:1b0533f616364fa9aa58fedb",
      "kind": "character_system_text",
      "source_text": "努力要一点一滴的事情做起呢！",
      "source_fingerprint": "50362f361e3cf6a970003b8002c9c31b57fbfa04c948d4e0c124e0476b0d351b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "20051"
      ]
    },
    {
      "uid": "zhcn:b759436eb7a96359b65706ed",
      "kind": "character_system_text",
      "source_text": "大家，出发吧！",
      "source_fingerprint": "072bc1cfc92553e1583c00df8ccb4b3ecd60ff542b56a93421a2b5627a7f9692",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "2030"
      ]
    },
    {
      "uid": "zhcn:89c1372363c1432de3112da8",
      "kind": "character_system_text",
      "source_text": "如果是我们的话，能赢……！",
      "source_fingerprint": "6cb203e20f5417f569f9c1eb2bab66769a38e68ad612fedba5b0c835d4905df5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "2031"
      ]
    },
    {
      "uid": "zhcn:4f1db1bbeda63ecf4c1d7431",
      "kind": "character_system_text",
      "source_text": "训练员，非常感谢您。",
      "source_fingerprint": "7db73f9d844b29c02a956bf769e9649feaf24c911f853311aac23ef30dc48358",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "2032"
      ]
    },
    {
      "uid": "zhcn:f9b30cc87c521365d7927a11",
      "kind": "character_system_text",
      "source_text": "我已经准备万全。\r\n为您献上最棒的跑姿哦。",
      "source_fingerprint": "711e90a4037edff5d92b9a5ff39cafcf1eda542198b93f4ed89fc78698ffc060",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "2033"
      ]
    },
    {
      "uid": "zhcn:cac9ab59efa61dfbbe061788",
      "kind": "character_system_text",
      "source_text": "总感觉力量源源不断地从身体涌出来了……\r\n看来想要保持平常心看来会很困难呢。\r\n……比赛，还没开始吗？",
      "source_fingerprint": "f02bfcf851b98b50b2ac5da48b6789846cf6f77457b34c24b0da74b711901eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "2034"
      ]
    },
    {
      "uid": "zhcn:8ca4a8a455399fe64c3d1dd1",
      "kind": "character_system_text",
      "source_text": "训练员，非常感谢您。",
      "source_fingerprint": "7db73f9d844b29c02a956bf769e9649feaf24c911f853311aac23ef30dc48358",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "2035"
      ]
    },
    {
      "uid": "zhcn:5014fd0fd2d3335019329918",
      "kind": "character_system_text",
      "source_text": "頑張りますね。",
      "source_fingerprint": "a4b6e1619b61c115576eead420e9729c522e01b54f9d0bf520b3b29d1acbe2ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "23015"
      ]
    },
    {
      "uid": "zhcn:960e5b4b60e9b1c44f34aaa3",
      "kind": "character_system_text",
      "source_text": "只差，一步吗……",
      "source_fingerprint": "694fc6cc1a0a08a747ed5960ff6a494a36b471f9e0075d07718052f80d176188",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30000"
      ]
    },
    {
      "uid": "zhcn:c25fd80c34f2c9e002816e5b",
      "kind": "character_system_text",
      "source_text": "还差得远呢，必须继续精进。",
      "source_fingerprint": "b4417f33bf517c1e9208f207b9a11cc12a77da3116fcafe35c6278ade6f255fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30001"
      ]
    },
    {
      "uid": "zhcn:a3e35c0b627ece17d124116a",
      "kind": "character_system_text",
      "source_text": "被你看到我没出息的样子了……",
      "source_fingerprint": "94cc52bc4fe8748400a944d579b6da568b54450b4d39c486ff85bcbbca30a0aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30002"
      ]
    },
    {
      "uid": "zhcn:dfc9f9b6cbe3890a0dc956bf",
      "kind": "character_system_text",
      "source_text": "比起悔恨……现在更无法饶恕输掉比赛的自己……！",
      "source_fingerprint": "018e4ce944c9fe04d0994799734071f223ab9d5328b70cf3d33cdcdfceb0ff9a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1e91a12db06e584a1fb5bc92",
      "kind": "character_system_text",
      "source_text": "这就是……胜利之舞哟♪",
      "source_fingerprint": "5e70cf7ac5d8caf2e89b524a8704088cbafeb50b44f9f6ad1b61a70cc9d04440",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30004"
      ]
    },
    {
      "uid": "zhcn:177dd02694f17cca4c38c17e",
      "kind": "character_system_text",
      "source_text": "呵呵♪做到了！",
      "source_fingerprint": "21e6f38d8a299a0aa0b84651023a95899e0064627d52948dd60163dbbfc831eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30005"
      ]
    },
    {
      "uid": "zhcn:9c68259f44f49fa67da9f4d6",
      "kind": "character_system_text",
      "source_text": "胜利是最佳的治愈。任务完成♪",
      "source_fingerprint": "95b0214d87ffc87dbfe045cf7c69909ab8585187480bb228cdaa31028e1373e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30006"
      ]
    },
    {
      "uid": "zhcn:6ef713e0e00acded951dadc9",
      "kind": "character_system_text",
      "source_text": "呵呵♪做到了！",
      "source_fingerprint": "21e6f38d8a299a0aa0b84651023a95899e0064627d52948dd60163dbbfc831eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "30007"
      ]
    },
    {
      "uid": "zhcn:51481e35c6afdb7ebb6be19d",
      "kind": "character_system_text",
      "source_text": "那么，即刻出阵。",
      "source_fingerprint": "ee37da707d1b910ba059cac9b97b178153771461d63d3f77b15470e8c1ce193e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "31000"
      ]
    },
    {
      "uid": "zhcn:0947ed61323cd104adb40bd6",
      "kind": "character_system_text",
      "source_text": "要上了，这就是我要踏上的道路……！",
      "source_fingerprint": "00c2be6452ca089b1119c9b0482e45b64d953fc3b592f1cff5ea3b77d3fc31d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "40000"
      ]
    },
    {
      "uid": "zhcn:d74fe8ab43791d1a850e143e",
      "kind": "character_system_text",
      "source_text": "作为纯洁治愈者――要纯洁地\r\n支持大家。",
      "source_fingerprint": "16efddbb6443a79dd02ff2da3fa67b2025bc5161a2cd6fa356c7f2d79da157ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "400002"
      ]
    },
    {
      "uid": "zhcn:2165c1b6832d83a1e0ce0045",
      "kind": "character_system_text",
      "source_text": "打倒邪恶之王的旅程…\r\n治愈必不可少～。",
      "source_fingerprint": "cdf5c8716a62d8f256b19061aa8948b376b51e4a2bf9a8244c8e6bcc29537b66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "400004"
      ]
    },
    {
      "uid": "zhcn:dcf8d7ddc425f97ac391c752",
      "kind": "character_system_text",
      "source_text": "这个世界里――\r\n还有尚未解开的谜题。",
      "source_fingerprint": "79f9fce36864add839432319f051fb49b44b505ccb8a3bbbbbe6fdfec6c3c50c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "400005"
      ]
    },
    {
      "uid": "zhcn:f2b05b9fe77ff31980088dd6",
      "kind": "character_system_text",
      "source_text": "对于穷凶极恶之人，\r\n就要毫不留情地对其降下铁锤♪",
      "source_fingerprint": "3f696d674ab1ec4ad99fccabe1abf421469557ca650189c77a3db4de0f026268",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "400008"
      ]
    },
    {
      "uid": "zhcn:d95fbf21fbf5dbb953959673",
      "kind": "character_system_text",
      "source_text": "要上了，这就是我要踏上的道路……！",
      "source_fingerprint": "00c2be6452ca089b1119c9b0482e45b64d953fc3b592f1cff5ea3b77d3fc31d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "40001"
      ]
    },
    {
      "uid": "zhcn:c07917de2dcac63168c7cbe4",
      "kind": "character_system_text",
      "source_text": "这样就是大团圆了呢。\r\n希望有一天，也能为你献上治愈。",
      "source_fingerprint": "eb4a89ab5f6719fd4c65a41059e630ca9196a9abc2acd2990553055e2b482a96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "400010"
      ]
    }
  ]
