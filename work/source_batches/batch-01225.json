      "kind": "character_system_text",
      "source_text": "哼、哼哼♪",
      "source_fingerprint": "d90f52f997bc863975a4fba6130bc42c1d9bfea4b24ea0afeb4e8710816b8956",
      "source_path": "character_system_text_dict.json",
