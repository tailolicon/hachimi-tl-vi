      ]
    },
    {
      "uid": "zhcn:d1cc6effa7c149627fb3ec47",
      "kind": "character_system_text",
      "source_text": "哎呀……",
      "source_fingerprint": "aa590602b03384649277b084cd36d881d4f24707abf056fd0a939443d6e5c4fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "410008"
      ]
    },
    {
      "uid": "zhcn:6925295533eb8b98e79d1410",
      "kind": "character_system_text",
      "source_text": "为观众们献上即娇艳，又不失柔美的舞步♪",
      "source_fingerprint": "e2520051c935c87eca5e5fd5ccdd1fa45d3683ff84d4526d9b20694c3b5317a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "60000"
      ]
    },
    {
      "uid": "zhcn:3b4bea67f76f47e020ee46ce",
      "kind": "character_system_text",
      "source_text": "要将感谢之情，真切地传达出去呢。",
      "source_fingerprint": "0e507e3c6a17b819cd50ad5c67d4119cf4b51c1b8d8572cd02d4c28b4818e186",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "60001"
      ]
    },
    {
      "uid": "zhcn:54c429a05e2926cc4c7aea43",
      "kind": "character_system_text",
      "source_text": "一同求学，一同前行吧。",
      "source_fingerprint": "032fe01daa01e2d0557020ae93c202f427c57b21bdcd6dc666757e0d5c295c21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70000"
      ]
    },
    {
      "uid": "zhcn:052e1b8916d55355265595ee",
      "kind": "character_system_text",
      "source_text": "那个时候迷路的训练员\r\n居然会成为我的担当训练员什么的……\r\n可谓是“萍水相逢也是前世因缘”呢♪",
      "source_fingerprint": "22598235baffeec743f5f7e91fc8a253fc951f4c3483c7d01657f4e12945904f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70001"
      ]
    },
    {
      "uid": "zhcn:d9440d90200dfc4e73751804",
      "kind": "character_system_text",
      "source_text": "有着悠久历史的传统的制服……真是太棒了呢。",
      "source_fingerprint": "888106fe840af843e7618e3cfb81001062172943b1b384b84e45df4339a82d2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70004"
      ]
    },
    {
      "uid": "zhcn:bca98d0a0a0cf773ff349049",
      "kind": "character_system_text",
      "source_text": "回想起了舞台上的经历呢……",
      "source_fingerprint": "f0d7b658fccd611fc36674b9ae1f54c5f99efbcc0afccbc289179aaa9c5d59f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70008"
      ]
    },
    {
      "uid": "zhcn:c94591b2f9fbff439a2aaa74",
      "kind": "character_system_text",
      "source_text": "感觉身体都紧张起来了呢。",
      "source_fingerprint": "7a8d6bdc171899a6bc65731c3016baf914d01a311bd5e55db0e91defaacab495",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70009"
      ]
    },
    {
      "uid": "zhcn:a0c44d5348f2b81fa6f43dd9",
      "kind": "character_system_text",
      "source_text": "不时刻注意过上端正仪表、有规律的校园生活可不行呢。",
      "source_fingerprint": "b20228bbe82a2ed138ab55cd94ea1f7cb22815b2d4154a637b66ea42a73238e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70010"
      ]
    },
    {
      "uid": "zhcn:787173429daa98427fe5f97f",
      "kind": "character_system_text",
      "source_text": "在胜者舞台上也要诚心诚意地款待大家♪",
      "source_fingerprint": "114ae6c2c406fe9aa9771ef928de1f19981f63720b0dd5b47d18f249cafa583f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70014"
      ]
    },
    {
      "uid": "zhcn:bcdb20e74f5c63c7bfda1370",
      "kind": "character_system_text",
      "source_text": "这最重要的感情，将用这件决胜服所传达……",
      "source_fingerprint": "af8741e74fd1467582fe824bd350ba2fd98077fdda3933d0cb79c8710826eaf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1011",
        "70015"
