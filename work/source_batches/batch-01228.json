      "source_text": "明天的话能拿到这个哦！",
      "source_fingerprint": "15ed09a19424c27de252da1fd21fab7a5f5c74b2d952b65640bb280236be5842",
      "source_path": "character_system_text_dict.json",
      "json_path": [
