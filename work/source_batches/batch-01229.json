    },
    {
      "uid": "zhcn:cb3776b8db2276e58d58984e",
      "kind": "character_system_text",
      "source_text": "啊哈哈哈……",
      "source_fingerprint": "286b0ac9a87ff22c13515897b3a51a264453e81fdb10169c0dec9789e147c679",
      "source_path": "character_system_text_dict.json",
