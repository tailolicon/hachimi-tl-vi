{
  "schema_version": 1,
  "batch": 1229,
  "batch_count": 1682,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "f1c6893d60a8989361cfd9c371f56bc8ec25f81d",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:046bbb4ac2d77c032c652826",
      "kind": "character_system_text",
      "source_text": "门的尺寸大小完全影响不到我！！",
      "source_fingerprint": "0755bc01ecbd4d0cb063453af3265352df07d40d2a2ba097f124f766552116cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "93204"
      ]
    },
    {
      "uid": "zhcn:9def800d4b9530d0c74b9608",
      "kind": "character_system_text",
      "source_text": "Merci beaucoup！Healthy pork！",
      "source_fingerprint": "e5e647a8a6e796ebe1ccd79fea4b397f30339684cf86cd7a2e11e760952d2ae7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "93205"
      ]
    },
    {
      "uid": "zhcn:98a858a2d944e10810e6a3f1",
      "kind": "character_system_text",
      "source_text": "呜哦哦哦哦哦ーー！！",
      "source_fingerprint": "fdc21a91b8937b4c590bcfc48aca53dca13fcc531b884549a42675244a2f43d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95000"
      ]
    },
    {
      "uid": "zhcn:ec7f3ad6f58696060a331692",
      "kind": "character_system_text",
      "source_text": "Explosion！！",
      "source_fingerprint": "8aa36205ff10af507b0092593894365e7edfc670cd308c4d41e019860ca4e7a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95001"
      ]
    },
    {
      "uid": "zhcn:57516d3bcbec4647520106d0",
      "kind": "character_system_text",
      "source_text": "哦，你在呼唤我黄金船大人吗？",
      "source_fingerprint": "a8361f0e69e0b00c3d2cae48283bce2cbded2fd617edba17b12189db41233e98",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95003"
      ]
    },
    {
      "uid": "zhcn:5bba7cba90cee1cd8e551410",
      "kind": "character_system_text",
      "source_text": "交给我金船大人吧！",
      "source_fingerprint": "c446f5fc260045342818947949952b82d178fb8589b932e2a5ee3a60a16313f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95005"
      ]
    },
    {
      "uid": "zhcn:c11d7a434f1009a6fed02e67",
      "kind": "character_system_text",
      "source_text": "现在追上去还来得及！",
      "source_fingerprint": "23d0b4a34f078bc668adeec8c5c712b23bc0d56f3bcaebb67bc230159ca176f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95006"
      ]
    },
    {
      "uid": "zhcn:2fde44b7f2df09ee2617e7f3",
      "kind": "character_system_text",
      "source_text": "咻～～碰碰！阿船烟火！",
      "source_fingerprint": "f8cded8ae30f198727ffc1717dd3c255aa110a8506f0b394df9453f26ac87c66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95007"
      ]
    },
    {
      "uid": "zhcn:af3672a4b485ada1f872f71b",
      "kind": "character_system_text",
      "source_text": "呀呵～～！\r\n灼热阿船诞生啦！",
      "source_fingerprint": "a04b0fb54e746ad4e708aa86376a3cfd370a8a5af5de82d0f01da89e570eb84f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95008"
      ]
    },
    {
      "uid": "zhcn:da16f282702ccf9080609f59",
      "kind": "character_system_text",
      "source_text": "白色云朵、蓝色海洋……\r\n还有金色的我，阿船！",
      "source_fingerprint": "86b16e3fef7b5e6a98a9f8c3406c78215ef57791f80f26b7e04d99887076d9e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95009"
      ]
    },
    {
      "uid": "zhcn:46c9f60fe3295d11de24677b",
      "kind": "character_system_text",
      "source_text": "我是黄金船！你喜欢夏天吗？",
      "source_fingerprint": "fd826cc5d0d3c3ef26e0d3d24369daa5cc4a58069252d0b73eb95bbf29d2c980",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95010"
      ]
    },
    {
      "uid": "zhcn:11b120f195253db70da29042",
      "kind": "character_system_text",
      "source_text": "Oh là là～！看我的隆尚魂～！",
      "source_fingerprint": "57a0334afb78a443d899c2832db6661c756f9bd32ebe0e4d362da4dea5a1a3de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95207"
      ]
    },
    {
      "uid": "zhcn:a7f8e97cd845a911efcee210",
      "kind": "character_system_text",
      "source_text": "大西洋看起来就像小水洼！",
      "source_fingerprint": "f745dbc61886f8357042e179e0c7b08aeb88cd7223c7ce6298b9cde785a4b027",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95208"
      ]
    },
    {
      "uid": "zhcn:2d233056c06879edb6aa9dca",
      "kind": "character_system_text",
      "source_text": "门不是用来钻的！\r\n要从上面飞越过去！",
      "source_fingerprint": "2e0a58e7f9e135852f4b8ce47efa848af8c1bfd7c0b206c2e483670241c7c4e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95209"
      ]
    },
    {
      "uid": "zhcn:046da248bcf23bd07ffa198f",
      "kind": "character_system_text",
      "source_text": "请・给・我・一份黄金船☆",
      "source_fingerprint": "7c5de429fbca2c13a55ee38b6d8f7ae128ede18364811ea1d811d96ae1da22cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1007",
        "95210"
      ]
    },
    {
      "uid": "zhcn:b68878563eb18997650498f6",
      "kind": "character_system_text",
      "source_text": "走吧！",
      "source_fingerprint": "92ae3e5dcae9a53056d19b3106de1996e8c400c410dfd1c96cb651012cfebc4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "1000"
      ]
    },
    {
      "uid": "zhcn:0c5f3c3c098a589be2b52e56",
      "kind": "character_system_text",
      "source_text": "我已经决定再也不放弃了……！\r\n所以、所以我……！\r\n考试也不会放弃的！",
      "source_fingerprint": "572bdbb8da5c8d99548b7e1b5a0faa92605250b096e7fc98c416ec9b78e8ca75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10000"
      ]
    },
    {
      "uid": "zhcn:018b7287ac0e896b798aff2e",
      "kind": "character_system_text",
      "source_text": "行ってくるぜ。",
      "source_fingerprint": "0f06e9d5d4b590fa75db11b1c2431f76a413069b4adaae557632a142ae95ad45",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "100000"
      ]
    },
    {
      "uid": "zhcn:bf91d25e674af1ff913e3c95",
      "kind": "character_system_text",
      "source_text": "ただいまー。",
      "source_fingerprint": "1b9d600edd4c987f3247b3090a622080abe8e88308dcf78eded0477be4bf5d9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "100001"
      ]
    },
    {
      "uid": "zhcn:1d0bb56c1edd8e8bfd5adffd",
      "kind": "character_system_text",
      "source_text": "今后我也会继续把\r\n我的步调变得更帅的。\r\n要好好跟上哦，伙伴！",
      "source_fingerprint": "a76be3ace4d96d7c30bfc775791e06184434f401be2a22a53415afa2da5ca0de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10001"
      ]
    },
    {
      "uid": "zhcn:b26d8895e2c889eb0c6252f1",
      "kind": "character_system_text",
      "source_text": "啊──那个、找一天啦。\r\n等我买了摩托车后，就去海边散心。\r\n……两个人一起去。",
      "source_fingerprint": "880f7bf21ec7a8e9164fe2b608bacaa1341094671f996a0a929a941d74c5f2b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10002"
      ]
    },
    {
      "uid": "zhcn:91063cb860dc49c9bf581fdd",
      "kind": "character_system_text",
      "source_text": "噢，新年快乐！\r\n今年的我也会油门全开，\r\n让大家追不上我哦。",
      "source_fingerprint": "a983dd45e08fde9baae40a33332528f94a0118d5bfe155d25e752888aa5331e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10003"
      ]
    },
    {
      "uid": "zhcn:210cb48303512fac1ff9538e",
      "kind": "character_system_text",
      "source_text": "唔唔，又拿到巧克力了。\r\n虽然知道这没有什么特别的用意，\r\n但、但还是会觉得很不好意思。",
      "source_fingerprint": "1469209ebd9210ca313be645a875c8f0340636ec709ae9af41d1010312ae92f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10004"
      ]
    },
    {
      "uid": "zhcn:f01dd5acd0ac9de12f9089a8",
      "kind": "character_system_text",
      "source_text": "桌上的……你看到了？就、今天不是\r\n嗯，情、情人节嘛……就只是\r\n答谢你平时的照顾啦，不要多想哦！",
      "source_fingerprint": "a94935217573e10b5c8ae331ffa64847de15803a7458d8b56392992bcafd403a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10005"
      ]
    },
    {
      "uid": "zhcn:2b833d1c7037ffb2ccb59ffe",
      "kind": "character_system_text",
      "source_text": "签纸还是用金光闪闪的最好了！\r\n最帅又最显眼嘛！\r\n这样愿望会更容易实现吧？",
      "source_fingerprint": "95ec85d482a5359aed45307f95ea4765884661ef65248f381d67746c29d74b23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10006"
      ]
    },
    {
      "uid": "zhcn:915fd8ecdc6eb546cf598dc2",
      "kind": "character_system_text",
      "source_text": "我又不是小鬼，就算拿到点心\r\n也不会特别高兴……但有准备的话\r\n我也是可以收下啦。",
      "source_fingerprint": "b304b98b60d6b1ddaf6b65ae09c78ea8d333c62aa070799b91dd66978f49d8f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10007"
      ]
    },
    {
      "uid": "zhcn:8cf7b3b5313a2a9a316f6e7c",
      "kind": "character_system_text",
      "source_text": "以前我们家都说圣诞老人\r\n是骑着红色的摩托车。我好像还曾经\r\n向往过能在天上飞的摩托车呢。",
      "source_fingerprint": "7cd715ef4fefcb7ad2d885a5d7ef1152400dd08fa17258f81049ece0f432265a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10008"
      ]
    },
    {
      "uid": "zhcn:94f7f6e7fafeb7607e7ab3cb",
      "kind": "character_system_text",
      "source_text": "圣诞快乐！我们找个地方去吧。\r\n今天是跟重要的人一起过……\r\n是要跟伙伴一起共度的日子，对吧？",
      "source_fingerprint": "31d57ae5081cffc35199a26fdf3d8f13ba37b4aa21765b91fc0e1a05e5fba24d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10009"
      ]
    },
    {
      "uid": "zhcn:072ab9a3d1b377fa330a5a6f",
      "kind": "character_system_text",
      "source_text": "好嘞！",
      "source_fingerprint": "5b8624abed948d0e6a84b94335e1037decef0acf48c44155fdd86e0f5fcff33b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "1001"
      ]
    },
    {
      "uid": "zhcn:7c1fd86dee9415f0f5e2bb63",
      "kind": "character_system_text",
      "source_text": "明天一早我们就出发！\r\n身为一个摩托车手，\r\n怎么能不去看新年的第一个日出呢。",
      "source_fingerprint": "438a0ee9af59b8f7f70b557d2435d8c5abc8192fbd50b2d8f857fdfe561c1b6a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10010"
      ]
    },
    {
      "uid": "zhcn:449f13fa346eec039f47e868",
      "kind": "character_system_text",
      "source_text": "噢，生日啊，恭喜啊。\r\n那我们去吃点什么好吃的吧。\r\n我请客哦，请你喝自助饮料吧！",
      "source_fingerprint": "2989b07f042f5e3a5b7693f22853f164ee60f48c9df1ebaef4570d61e2ff10ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10011"
      ]
    },
    {
      "uid": "zhcn:fac307b6c07b30f251b09e9a",
      "kind": "character_system_text",
      "source_text": "喂、喂，今天是你生日吧。\r\n呃……我有准备蛋糕啦！\r\n你要记得空着肚子等哦……！",
      "source_fingerprint": "20e7fc3fcf2014669de230e14f23dfd0fc00094a0739351225c17f9d1099debc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10012"
      ]
    },
    {
      "uid": "zhcn:76031bfceb457dd7a29ab4a4",
      "kind": "character_system_text",
      "source_text": "今天是我的生日！\r\n我又要变得更成熟、更帅了～♪",
      "source_fingerprint": "ba499e00a032a8e5880ff076b1dd062a6a27ce4c98d36392db62eb17994c1fc7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10013"
      ]
    },
    {
      "uid": "zhcn:c86ee190fcebc3745fa39d79",
      "kind": "character_system_text",
      "source_text": "啥？要出门庆祝我的生日！？\r\n不用啦！这样太羞耻了！\r\n顶、顶多跟你一起吃个蛋糕就好。",
      "source_fingerprint": "1589b0396fb5a3f9883a262d1e3e16dedbd06ff582cbb8e69bcaebcb0f4b4093",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10014"
      ]
    },
    {
      "uid": "zhcn:986fb7026779bd45634564c8",
      "kind": "character_system_text",
      "source_text": "好像有什么新公告哦。\r\n就交给你去确认了～！",
      "source_fingerprint": "c98de07f57779b53b9278368ba717a0b00e93bb700e4eba02d3bbfbbb8cd2f21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10015"
      ]
    },
    {
      "uid": "zhcn:f89b5c9063ccc701d74931d1",
      "kind": "character_system_text",
      "source_text": "哦！有礼物送来了耶！\r\n是什么是什么？也让我一起看啦！",
      "source_fingerprint": "55b6ea649b443d393f304e637998dc45581e475fa5defbb478e3cf5dd0c31847",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10016"
      ]
    },
    {
      "uid": "zhcn:5871867910410dd5f5749c35",
      "kind": "character_system_text",
      "source_text": "很棒嘛，你好像达成目标了哦！\r\n真不愧是我的伙伴。",
      "source_fingerprint": "493a4f07d80b633bbd36cc38a9adfcd9f1342f99d8bdc1ffbf59fee7cd4ef202",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10017"
      ]
    },
    {
      "uid": "zhcn:cb3d7bdb773127cac51bdfb3",
      "kind": "character_system_text",
      "source_text": "好像正在准备要办什么活动。\r\n希望会是帅气的那种～。",
      "source_fingerprint": "3f13d86d2369c52b8264e30b369f506b2a85a50f3b917500368d88bf0b466a7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10018"
      ]
    },
    {
      "uid": "zhcn:0ed33d11dcd0f73b0fb3e3c4",
      "kind": "character_system_text",
      "source_text": "正在举办活动啊！\r\n比任何人都更活跃的……\r\n当然会是我们！没错吧？嘿嘿！",
      "source_fingerprint": "f694f748f121cf29750df2cb2e1e4830d8653d34ffcd3ac1e3d7aed637a24d53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10019"
      ]
    },
    {
      "uid": "zhcn:1eef832a4fd79a5d5d250c33",
      "kind": "character_system_text",
      "source_text": "输了ー！",
      "source_fingerprint": "324bbd1cefd9e601c947217fc0788d39c72292732ebd7d2f3d501f88084f892e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "1002"
      ]
    },
    {
      "uid": "zhcn:386a1b5435d7b8da7d37c079",
      "kind": "character_system_text",
      "source_text": "赛马娘名鉴的等级\r\n好像提升了吧。",
      "source_fingerprint": "1c551ae4e0937453991acea61d5d5b51ef9d85d35d685fd0fea9ce35bc808760",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10021"
      ]
    },
    {
      "uid": "zhcn:88d5ae9c58020de50ebcb441",
      "kind": "character_system_text",
      "source_text": "听说皮衣跟牛仔外套都会\r\n越穿越有味道喔。嘿嘿，\r\n我要把自己的历史刻进服装里！",
      "source_fingerprint": "27c8ee5c9d361da611c7b8526a4d30f816dd170682f5d75baf0a84fb527f85e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10025"
      ]
    },
    {
      "uid": "zhcn:5ba483a32eaee1edf08df95e",
      "kind": "character_system_text",
      "source_text": "我现在的LANE图示是穿着这身衣服\r\n坐在咖啡厅吧台的照片喔。\r\n很性格吧？",
      "source_fingerprint": "eea41a6620aba779e52e659d8880ac1a2f034fd9fe8edeee6dfa3791ee26b0d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "10026"
      ]
    },
    {
      "uid": "zhcn:1a66ac018c164f129b07e6ec",
      "kind": "character_system_text",
      "source_text": "我之前看了部电影，\r\n主角骑的摩托车真的有够帅气～！\r\n我超想要那台车的～！",
