      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "30001"
      ]
    },
    {
      "uid": "zhcn:53398a1c44d9791ba7f03769",
      "kind": "character_system_text",
      "source_text": "我还想继续进攻来着。",
