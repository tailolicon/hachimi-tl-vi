    },
    {
      "uid": "zhcn:95656bf48e6f16a8290ff607",
      "kind": "character_system_text",
      "source_text": "任せろ！",
      "source_fingerprint": "98eedc2a1e4cadc1f6e6bd8d04e68a29a670522868b9138650e5be5d6098cef0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "23015"
      ]
    },
    {
      "uid": "zhcn:38615a0e51127c255a837493",
