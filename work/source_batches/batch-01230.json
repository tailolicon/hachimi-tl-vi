      "source_text": "我这也太逊了吧……",
      "source_fingerprint": "64e0e89b03a58d350e766a3fa5d1494a63f937e2e4c50b49a8117860e4ad2681",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1008",
        "30003"
      ]
    },
    {
