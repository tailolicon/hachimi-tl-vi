      "source_text": "太遗憾了……",
      "source_fingerprint": "2d8a565badea463d7e46dd935fa389e0610161e938859c3aee45106a758a5e58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
