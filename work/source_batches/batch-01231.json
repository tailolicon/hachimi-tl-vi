      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1013",
        "10018"
      ]
    },
    {
      "uid": "zhcn:e0c15d20807691b9c3daffb1",
      "kind": "character_system_text",
      "source_text": "正在举办活动呢。\r\n要过去看看吗？",
