      ]
    },
    {
      "uid": "zhcn:6b3c4944b59520a21a7f55d1",
      "kind": "character_system_text",
      "source_text": "太出色了。",
      "source_fingerprint": "3f2e50b04f53a97d3c8fc68fb6618c8c00126b7a1a68f31cc320a96de53e936a",
      "source_path": "character_system_text_dict.json",
