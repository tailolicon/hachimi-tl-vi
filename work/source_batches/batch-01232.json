      "kind": "character_system_text",
      "source_text": "感觉可以直冲天际。",
      "source_fingerprint": "de01da4369c1f9591c75bdd54cb90631e44ad5a084b4bd3ecb5054f02ce813a7",
      "source_path": "character_system_text_dict.json",
