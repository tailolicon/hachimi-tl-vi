        "1009",
        "140008"
      ]
    },
    {
      "uid": "zhcn:74a8c2dbbf85a425cd622f45",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140009"
      ]
    },
    {
      "uid": "zhcn:3f9d5ac98cc3420a3d72e63b",
      "kind": "character_system_text",
      "source_text": "诶嘿！",
      "source_fingerprint": "ae1fab47d8e7ed0746053c2a9d0db347e7f6e385026266c3908c56ab943f8993",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140010"
      ]
    },
    {
      "uid": "zhcn:31bc0d1e7ca3e697c4e8a499",
      "kind": "character_system_text",
      "source_text": "哇啊……！",
      "source_fingerprint": "bec634000510a468bf0c203a32955f8df432a6fc63b80c98ff19fcd03a69f626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140011"
      ]
    },
    {
      "uid": "zhcn:811a14ea4f458c4ce211608f",
      "kind": "character_system_text",
      "source_text": "啊哈哈！",
      "source_fingerprint": "7990e29ba73adbb25caf3a56bd6650d89178b313c21bbc997967b4db791ccd69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140012"
      ]
    },
    {
      "uid": "zhcn:16f11515dba7849d97520220",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140013"
      ]
    },
    {
      "uid": "zhcn:38388cc1f03b461a8ad9b584",
      "kind": "character_system_text",
      "source_text": "真是的～！！",
      "source_fingerprint": "5d4df94f782687001171432b779d6199d26561f4e1034e712ad01f59db06d452",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b2b2983606cd1112aab2e85a",
      "kind": "character_system_text",
      "source_text": "呣呣呣……",
      "source_fingerprint": "b97f979d1254b94528c18ee9e3b6d448ed4d87f69a132b28098b80cc8f215ba4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140015"
      ]
    },
    {
      "uid": "zhcn:6e8779e919f82cae6f9411da",
      "kind": "character_system_text",
      "source_text": "喂！",
      "source_fingerprint": "60438c74bee56fdcbee7fb02aa13994db2810f5f3f74cf32ac028b7a92a36be6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140016"
      ]
    },
    {
      "uid": "zhcn:825e40d7cecdf1131e507e59",
      "kind": "character_system_text",
      "source_text": "呜……",
      "source_fingerprint": "e23a2a933be63f7992ef78dc97543046307e6306c1a546d698062edb79747a91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140017"
      ]
    },
    {
      "uid": "zhcn:d8a0232164701b3e60b43b48",
      "kind": "character_system_text",
      "source_text": "哈啊！？",
      "source_fingerprint": "7ba12d1aa7dba5b9bf6f9882dfe7045e151c1e3b44dad30a6c7f4e6a3bbb2bbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "140018"
      ]
    },
    {
      "uid": "zhcn:ab5d06af234a5bf724e9e7c5",
      "kind": "character_system_text",
      "source_text": "明天好像能拿到这个。",
      "source_fingerprint": "05455df9a61eff2f59cb5dc2bf0840682d0169c42988968da22137fe1da487b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "15"
      ]
    },
    {
      "uid": "zhcn:ad1dcd0f59ad6b616b07f975",
      "kind": "character_system_text",
      "source_text": "啊啊～，真是的！\r\n心有余而力不足啊！\r\n真让人着急！",
      "source_fingerprint": "ce5ffd5a75017503fd869162a1c5603715b1699133cc8e815add2ce347bc2cd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20000"
      ]
    },
    {
      "uid": "zhcn:85abd9265a3da202599d5f44",
      "kind": "character_system_text",
      "source_text": "什么啊？\r\n我可没有在勉强自己……！\r\n只是……稍微有点累了而已……",
      "source_fingerprint": "609592c406ce4ac0d7711d35f26ac0302656d2115086786634460b9948de8d6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20001"
      ]
    },
    {
      "uid": "zhcn:cabb37a2df2979bf9e06ce30",
      "kind": "character_system_text",
      "source_text": "身体好轻！\r\n现在的话好像什么都能做到了呢♪",
      "source_fingerprint": "4d36b3560da93e4ce2ba0db2b69b98b8ff92ecdcb6b2db4e13e21dfaf1a6f8d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20002"
      ]
    },
    {
      "uid": "zhcn:829a0c697433faa115b6487c",
      "kind": "character_system_text",
      "source_text": "喂，还不能跑起来吗？\r\n快点开始训练吧！",
      "source_fingerprint": "6290beb5812e856cc7e76a7c442cc238aa5bf0f928e001e6cb3d8db3d5a74483",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20003"
      ]
    },
    {
      "uid": "zhcn:94c14c01414c13bb3dc6b3f6",
      "kind": "character_system_text",
      "source_text": "双腿很灵活，状态不错呢。",
      "source_fingerprint": "55847507b63f25dda5891a2dbd120913b0c3ab001671a161ad749f29f5c961bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20004"
      ]
    },
    {
      "uid": "zhcn:1c5b4956403ae4cdba42815e",
      "kind": "character_system_text",
      "source_text": "我的状态还会越来越好哟！\r\n再让我跑一会儿吧！",
      "source_fingerprint": "bb409340b5219743398787b256a918743430ac23125357c0f3696e59f0bb1e3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20005"
      ]
    },
    {
      "uid": "zhcn:dc4ec760fbc866ef3e770cf2",
      "kind": "character_system_text",
      "source_text": "因为我的目标是第一，\r\n不加油可不行呢。",
      "source_fingerprint": "0e9ebf082413ef14192c777d573d8073a569ffc01990206c31d79515f94d5284",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20006"
      ]
    },
    {
      "uid": "zhcn:fd4eb32a965be0bba1d80ccd",
      "kind": "character_system_text",
      "source_text": "今天也会好好跑的哟。",
      "source_fingerprint": "ff59a7d906966b13a101bec7ec931f6da1d645a3eb7803b577617a1ce3d74bfa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20007"
      ]
    },
    {
      "uid": "zhcn:38c7bcd663249bfefc36dbc7",
      "kind": "character_system_text",
      "source_text": "嗯嗯，步子好沉……\r\n得想想办法才行……",
      "source_fingerprint": "9b41b2f59d2bf2ae9c3f4c9de59dcf00ac45079b8e0a09a5ab78d417ecc92a8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20008"
      ]
    },
    {
      "uid": "zhcn:190fae5a600ca16af11d81cf",
      "kind": "character_system_text",
      "source_text": "现在可没有时间在这说丧气话了……！\r\n状态不佳时更要加油……！",
      "source_fingerprint": "a086f82e944cec3af863c20700d2dc84b85cf8b457d3339cd5c54aab2c21231d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20009"
      ]
    },
    {
      "uid": "zhcn:4d864b7483fb56a97e661dfe",
      "kind": "character_system_text",
      "source_text": "我，\r\n真的能成为第一吗……？",
      "source_fingerprint": "3b92d9c17ab014e7c7d26426738d186b876a2fd60f7beb8209feba534f8e2e68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20010"
      ]
    },
    {
      "uid": "zhcn:122e7c0127f1b674d33d3576",
      "kind": "character_system_text",
      "source_text": "身子好重……\r\n难道是过度劳累了……？",
      "source_fingerprint": "2a6af25c335f7d424c22da88cf8d58f2443358d3511fab4f2c8d5a58169753d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20011"
      ]
    },
    {
      "uid": "zhcn:bbb600e1d3e076b284e8e4b3",
      "kind": "character_system_text",
      "source_text": "又要比赛……？\r\n请给我一个合适的理由。\r\n否则的话我可没法接受！",
      "source_fingerprint": "2656ebdbc1d45fd151334f10e8e5bf59b11d3f5fe867947cb8e3c12e1af16a01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20021"
      ]
    },
    {
      "uid": "zhcn:3a458b97ee4063b35f176f94",
      "kind": "character_system_text",
      "source_text": "不会又要和我说什么比赛吧？\r\n你有好好考虑比赛日程吗？\r\n简直就像个傻瓜一样！",
      "source_fingerprint": "f27235c3565245fae3125424786f12fc1719d18fcc7089b306f0250349b1a5ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20022"
      ]
    },
    {
      "uid": "zhcn:c0480d3e1e808bc7a633bde5",
      "kind": "character_system_text",
      "source_text": "哼哼，完美的不能再完美了♪\r\n现在的话感觉不会输给任何人！",
      "source_fingerprint": "ed9ea3e6a545e0d8f907b571227d4ad13968b983268c4ee588d18e95d52cd463",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20023"
      ]
    },
    {
      "uid": "zhcn:0a1785e5a8cf1d328828dc04",
      "kind": "character_system_text",
      "source_text": "无可挑剔的绝佳状态！\r\n好好看着吧，我最棒的跑法！",
      "source_fingerprint": "c980b54578c95bde0f2e22d552f0cb76076d28817db4b00b67b3dbf21ef3f74c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20024"
      ]
    },
    {
      "uid": "zhcn:29b1e85cd361dddc896bbfde",
      "kind": "character_system_text",
      "source_text": "目标除了第一之外别无他物！\r\n我一定会下赢比赛的！",
      "source_fingerprint": "8799a2e9dbb09606a27ca865ba8d45cdb36d2bc3c756e70818a8eb8193d1c25a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20025"
      ]
    },
    {
      "uid": "zhcn:514ac841e2dc6ec91d87db67",
      "kind": "character_system_text",
      "source_text": "嗯，状态不错！\r\n剩下就是竭尽全力了！",
      "source_fingerprint": "e0bbf0e710f9dedc294fd1affc9faddbb9d2004e209b655701d73826f45545a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20026"
      ]
    },
    {
      "uid": "zhcn:1917a3e609bce689bf202f9f",
      "kind": "character_system_text",
      "source_text": "这可是场很重要的比赛啊！\r\n状态也十分不错，\r\n我可不能输啊！",
      "source_fingerprint": "4cdc0a19017208714185da3926ee043e3b02b27428a1c8ed2435bae0ba14963e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20027"
      ]
    },
    {
      "uid": "zhcn:9e69277a5e106498274291af",
      "kind": "character_system_text",
      "source_text": "状态很好！\r\n就请好好期待，我出色的表现吧！",
      "source_fingerprint": "8ac961df8af1a9a08b09b60a061d7626b6bf5eecdc95d4a839bf0cdcdeeabb51",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20028"
      ]
    },
    {
      "uid": "zhcn:4e6a2091cca964ad9c7f8fa0",
      "kind": "character_system_text",
      "source_text": "为了这场比赛\r\n我可是一直在努力。\r\n一定要赢给你看。",
      "source_fingerprint": "95c838ab3a3ab93402e3bb95f43564939ee257ad2b113cfc595b4db1b6fdd949",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20029"
      ]
    },
    {
      "uid": "zhcn:fd1ed70a4b859f0e4c65aa34",
      "kind": "character_system_text",
      "source_text": "身体状况还不错。\r\n应该能够发挥出平时的力量。",
      "source_fingerprint": "f832016b7c5c98f28d98afbc1edbeaba41e2a92c5d76c076d9b9e96d48164bc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20030"
      ]
    },
    {
      "uid": "zhcn:7fd2cae49b4fd0c823ae260f",
      "kind": "character_system_text",
      "source_text": "我可是很擅长大舞台的。\r\n紧张什么的肯定是不可能的！",
      "source_fingerprint": "78728d48d7ec36bc1a993656a306961355351559cea723cc934b2f77d0e032dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20031"
      ]
    },
    {
      "uid": "zhcn:57fd569142cbb953ea96d4ae",
      "kind": "character_system_text",
      "source_text": "怎么了？有什么不放心的？\r\n没问题，我会做到的。\r\n一定……没问题……！",
      "source_fingerprint": "f9002213ffa101bce0d512b8f9df0ef634eadeb5f3d8d96325c7be1ca607f32f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20032"
      ]
    },
    {
      "uid": "zhcn:77da547a524acbb94796f32b",
      "kind": "character_system_text",
      "source_text": "目标比赛呢……\r\n不管状态如何，\r\n以第一名为目标是不会改变的！",
      "source_fingerprint": "53e7a6142b076e43b1e34fd4d61f5b1bbb1fe669768f90d503f36544f13bbe43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20033"
      ]
    },
    {
      "uid": "zhcn:4764e9488f9977c5bc4044c1",
      "kind": "character_system_text",
      "source_text": "我可不能说泄气话啊。\r\n我只会贯彻我的跑法。\r\n仅此而已。",
      "source_fingerprint": "57923580ab9f050cb356ccf8b7c477d88946cf87279988a7fb2433b735c9e3d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20034"
      ]
    },
    {
      "uid": "zhcn:2638fe3f5b5576a7c8df57d4",
      "kind": "character_system_text",
      "source_text": "要以这个状态面对对手……\r\n真头疼啊……\r\n但是，不上不行呢……！",
      "source_fingerprint": "2759e38eb3e2707971a709ccb34d7b0280855757f61162863837847a7d4264fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20035"
      ]
    },
    {
      "uid": "zhcn:ce3602cc3763c7fd7f8b63cd",
      "kind": "character_system_text",
      "source_text": "我可不想拿状态来当借口……！\r\n既然以顶点为目标，无论什么时候\r\n都得好好跑下去……！",
      "source_fingerprint": "dbd17fa394f8c01719fc60c05ba71c12d29a83d600748e7663aaf59e5ff59062",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20036"
      ]
    },
    {
      "uid": "zhcn:716ecb3aa43c2849e113ff25",
      "kind": "character_system_text",
      "source_text": "我不会就这样结束的……！\r\n我会击溃这窘境！\r\n顺带也战胜对手！",
      "source_fingerprint": "c5b90e0bb79d1b98551b5e431cfd84bb53b3a1839adab25003dee9035f6db014",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20037"
      ]
    },
    {
      "uid": "zhcn:b8523b1ccf929ea210b2058a",
      "kind": "character_system_text",
      "source_text": "要上了哦！",
      "source_fingerprint": "7c967e75e39f341bde454f3e389531a0943b2e9cb665d31e66635fcd79e310da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20038"
      ]
    },
    {
      "uid": "zhcn:beac0611196f8962b4b57f8d",
      "kind": "character_system_text",
      "source_text": "做给你看！",
      "source_fingerprint": "0df3f2e0e77dc44f48db7193ffd6190e7e0a137386891752101ca66b6aeee273",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20039"
      ]
    },
    {
      "uid": "zhcn:0f4d52deab74a60d02da4a24",
      "kind": "character_system_text",
      "source_text": "看吧！",
      "source_fingerprint": "03687149a07d502c5b9da8d1fcf236aa2a9f7cac483fc252307d9d3911de06c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20040"
      ]
    },
    {
      "uid": "zhcn:1e3e07d06b75a6035d662f57",
      "kind": "character_system_text",
      "source_text": "必须集中精神！",
      "source_fingerprint": "36ec8fbebacf2637473de28843f5956304e1b7b2bf41a294cfc701b030078988",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1009",
        "20041"
      ]
    },
    {
      "uid": "zhcn:c4324bc947c0a94e1c3610ec",
      "kind": "character_system_text",
      "source_text": "奇怪了……",
      "source_fingerprint": "4354968d449c99e6f8bafb19019db0740547616e78ccb3bff2129bd7e6699fb7",
      "source_path": "character_system_text_dict.json",
