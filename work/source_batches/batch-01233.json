    {
      "uid": "zhcn:15ef8b6ebe25c5e5d0a85c35",
      "kind": "character_system_text",
      "source_text": "哼哼♪",
      "source_fingerprint": "13180522437c6cc592057ba23d1c2eb12ca48b6af31de93222e093c1cd1301a5",
      "source_path": "character_system_text_dict.json",
