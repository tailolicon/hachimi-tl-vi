      "source_text": "Fantástico！！",
      "source_fingerprint": "a13fc60609ae746dc2f48c03633d2c1e6ac37ba0a704cf917dd936f05fc5e842",
      "source_path": "character_system_text_dict.json",
      "json_path": [
