      ]
    },
    {
      "uid": "zhcn:68d4e8c3088f10b617ba787d",
      "kind": "character_system_text",
      "source_text": "耶嘿嘿～",
      "source_fingerprint": "f3657ede5e3757be3df2d42aa8e9ec6243218bfd5b5da1b9eb29ae190c85ff97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140008"
      ]
    },
    {
      "uid": "zhcn:e861d9cb45663adf53b96fbd",
      "kind": "character_system_text",
      "source_text": "啦啦啦～♪",
      "source_fingerprint": "a05b9606853e257a2de14a2a099321bde610d42b509b54c5dd72613bf38b8176",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140009"
      ]
    },
    {
      "uid": "zhcn:1216da3b9044a62e582dd25e",
      "kind": "character_system_text",
      "source_text": "哎呀……",
      "source_fingerprint": "aa590602b03384649277b084cd36d881d4f24707abf056fd0a939443d6e5c4fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140010"
      ]
    },
    {
      "uid": "zhcn:6b2517d54b804508f9f388d8",
      "kind": "character_system_text",
      "source_text": "好厉害Death！",
      "source_fingerprint": "2b26c9ffe0d16d77958f787bf0f49113b23523e635c0b5ed63b3cce73c0bbb21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140011"
      ]
    },
    {
      "uid": "zhcn:27ba40ed910bc4dc70ca161f",
      "kind": "character_system_text",
      "source_text": "完成了！！",
      "source_fingerprint": "98430def65f715d9265e35bb04ee2fd09b09719ee3203b9506ab692c9931d415",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140012"
      ]
    },
    {
      "uid": "zhcn:ebab190eeee8b82fbf1d079b",
      "kind": "character_system_text",
      "source_text": "哇啊……！",
      "source_fingerprint": "bec634000510a468bf0c203a32955f8df432a6fc63b80c98ff19fcd03a69f626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140013"
      ]
    },
    {
      "uid": "zhcn:128fc770aec1d68ff4651593",
      "kind": "character_system_text",
      "source_text": "唔啊——！！",
      "source_fingerprint": "4bbc85a0f8d4cad8148d4dc609cdabed1d579b3f5d6a97660a6fffbcd8038358",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140014"
      ]
    },
    {
      "uid": "zhcn:9c486614a2c21acfee0222d5",
      "kind": "character_system_text",
      "source_text": "呃……",
      "source_fingerprint": "82fec3801d176574a5c73b753c0428097ba4efacd01f74d8bbeb0f256d85692f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140015"
      ]
    },
    {
      "uid": "zhcn:6eb80feb19e4039ba9b3c3ef",
      "kind": "character_system_text",
      "source_text": "来吧来吧！",
      "source_fingerprint": "d97bf0b77d0808cf0b117b444cf6a459c044951519360353f48ac79f6910d9ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140016"
      ]
    },
    {
      "uid": "zhcn:74a178794e74d9b6ff643f5a",
      "kind": "character_system_text",
      "source_text": "怎么这样……",
      "source_fingerprint": "b33e754eb08f945fcd738627973ee0906ef6b3553b24c13a31de6648224dd0c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140017"
      ]
    },
    {
      "uid": "zhcn:2a685d479cb7511efcdd7a5e",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "140018"
      ]
    },
    {
      "uid": "zhcn:d0c47a271289fbabec2c5559",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个哦！！",
      "source_fingerprint": "3cd3de288e23bc1cf0da506d5e4bdcf3cffb7ec9ed87e96a78ba2c4fb836347f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "15"
      ]
    },
    {
      "uid": "zhcn:854841f66a9b19c52395289d",
      "kind": "character_system_text",
      "source_text": "唔，跑起来都没有劲……\r\n明明神鹰的心像太阳一样\r\n在燃烧啊……！",
      "source_fingerprint": "d298890efb4922689f6f5b0fc3196df24f7a71a57239102bfe9c7402c6c4540f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20000"
      ]
    },
    {
      "uid": "zhcn:d8d037c10319c874c8ccbb20",
      "kind": "character_system_text",
      "source_text": "明明还想要继续奔跑的，\r\n但神鹰的脚却动不了Death……！\r\n稍微休息一下，为下次做好准备吧！",
      "source_fingerprint": "dda44b1375e5c8f6da4f631e60a3d504d52fc75a230101d62bd4369f07a50baa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20001"
      ]
    },
    {
      "uid": "zhcn:bf458dfa5906afb3cfc626e5",
      "kind": "character_system_text",
      "source_text": "很好，很棒，状态绝佳！\r\n就拜托训练员\r\n给我最高难度的训练咯！",
      "source_fingerprint": "7815bf316d133cb561a9a85d960234c20874dee4c8e315ae0763b9842fdbb9de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20002"
      ]
    },
    {
      "uid": "zhcn:b2eb76bfdda3b4f12f2ace5e",
      "kind": "character_system_text",
      "source_text": "神鹰的干劲满满！\r\n让你看看什么是世界最强的奔驰！",
      "source_fingerprint": "a415ed02365b23ff86ff103f134aefcfe2ef2e8e3edffd387ce9c430fad07346",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20003"
      ]
    },
    {
      "uid": "zhcn:9bd339132bc45277826db7b2",
      "kind": "character_system_text",
      "source_text": "快点开始训练吧！\r\n赛道，运动鞋，还有神鹰，\r\n全都准备ok了Death！",
      "source_fingerprint": "a3c5036a408dafaff9fc432b040ce78669ef4f9105c6d318d21f1a52c6c3e4c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20004"
      ]
    },
    {
      "uid": "zhcn:483e2a1963418365b3c84a1c",
      "kind": "character_system_text",
      "source_text": "开始感到热血啦！\r\n神鹰希望可以接受\r\n如烈火焚身般的训练！Death",
      "source_fingerprint": "5ece19f406095c6c28c387a9dbeed2336467bf2144b143db31690de41c93ac9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20005"
      ]
    },
    {
      "uid": "zhcn:f1403d393a4d6e194efdb369",
      "kind": "character_system_text",
      "source_text": "神鹰，在・此・登・场・Death！\r\n来吧，今天的训练排程是什么？",
      "source_fingerprint": "2aa03939a118c3823925c033c2c845c4a2239859c0c708fb59992fccef9dc88f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20006"
      ]
    },
    {
      "uid": "zhcn:38ae3fcc6e39237cf109d2ab",
      "kind": "character_system_text",
      "source_text": "那就充满活力，愉快，痛快地\r\n开始训练吧！",
      "source_fingerprint": "8da10712bd287b9c9021392a4cab65bcc8c9550477879dde75fe018a37667270",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20007"
      ]
    },
    {
      "uid": "zhcn:24cd919f06389787fa884170",
      "kind": "character_system_text",
      "source_text": "感觉身体好像有点沉重……\r\n但神鹰应该还是飞得动的Death……！",
      "source_fingerprint": "1bcb493de1bd39e52d754ab75ec7f4a98979519b18a1561ff96f941ee5432408",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20008"
      ]
    },
    {
      "uid": "zhcn:ca814774f0c272ac308ebc19",
      "kind": "character_system_text",
      "source_text": "觉得集中力有点不够……\r\n难道是能量不足了吗！？",
      "source_fingerprint": "bb39ae5d00edf9049e488f3f2e22c5d48924ed65bbcf574c34b6291bf08b1718",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20009"
      ]
    },
    {
      "uid": "zhcn:4ef46b3f87362c17128944df",
      "kind": "character_system_text",
      "source_text": "状态好像不太好……\r\n我，我这样子没脸见爸爸了……！",
      "source_fingerprint": "2cfb0c4470a301c99359e1de14aae6bd8f82ded8216b7a02aff012a1d3cb686a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20010"
      ]
    },
    {
      "uid": "zhcn:cc2ebbf2e5281ff27f9c8c99",
      "kind": "character_system_text",
      "source_text": "我的身体原本有这么迟钝吗……？\r\n到底是怎么了呢……",
      "source_fingerprint": "1183f6dd2739009e3e1427289e67b489a9f7417f1c819663d51c924be580646d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20011"
      ]
    },
    {
      "uid": "zhcn:e813b236bae11d0ea5594bee",
      "kind": "character_system_text",
      "source_text": "今天也要参赛吗？\r\n我不确定自己飞不飞得动呢……\r\n没，没事，既然要参赛我就一定要赢！",
      "source_fingerprint": "b8676a3614d8f5947dd516f2a600d1da697ab483396701c7541692647adf76fc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20021"
      ]
    },
    {
      "uid": "zhcn:7e876b324e5cd2045a6592b8",
      "kind": "character_system_text",
      "source_text": "又要参赛了啊？\r\n兀鹰的翅膀偶尔也是需要休息的……",
      "source_fingerprint": "47a454697c5a517020d564d7106ff047f80d93f03c8661f1173861756638a014",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20022"
      ]
    },
    {
      "uid": "zhcn:4c0afce5424aed889fe32314",
      "kind": "character_system_text",
      "source_text": "终于到正式比赛的这天Dea——th！\r\n神鹰的热血已经熊熊燃起了！\r\n训练员，我们走吧～！",
      "source_fingerprint": "1c9a2ec0f540bb171118f38ec811ab38d59d46c1f1ac24b6dec7d772e2da09a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20023"
      ]
    },
    {
      "uid": "zhcn:ae2eba0a8f0134d90ef79288",
      "kind": "character_system_text",
      "source_text": "神鹰……非常完美！\r\n现在的神鹰能飞得像兀鹰一样快哦！",
      "source_fingerprint": "344104c7d07ff2e625e895e46ae0497d91f2699f94383f1fa2c5fad84e81603f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20024"
      ]
    },
    {
      "uid": "zhcn:ef5a6a336022aca441486a3a",
      "kind": "character_system_text",
      "source_text": "神鹰，进・场・Dea——th！\r\n让大家看看世界最强的奔驰吧！",
      "source_fingerprint": "c6633e7df2a2ed131345bae9dd29dbb1873d6a907648b860da2c12d6ee302bc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20025"
      ]
    },
    {
      "uid": "zhcn:853f283977ba752d10e4a411",
      "kind": "character_system_text",
      "source_text": "拉筋伸展做好了！\r\n运动鞋也准备好了！\r\n我感觉可以跑得比平常还要好Death！",
      "source_fingerprint": "e53be6b22f41359592fa6fcae1656ffe08eee09788304d6d7bcfbf02b96c85bc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20026"
      ]
    },
    {
      "uid": "zhcn:9c5ef6d392fe573201d42035",
      "kind": "character_system_text",
      "source_text": "那么！神鹰就要华丽地飞向赛道了！",
      "source_fingerprint": "a10c5167dcb6f0d48a595058605d193a00de855d426de5842c56f0038bba82a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20027"
      ]
    },
    {
      "uid": "zhcn:1b3bbd89338e2ac1eae28130",
      "kind": "character_system_text",
      "source_text": "今天感觉身体很轻盈呢……！\r\n应该可以比平时还要更尽情飞翔哦！",
      "source_fingerprint": "6bac2335b0f8b1d41745d1d945d72632835abd1b40058a3d5706d0320bcb2b40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20028"
      ]
    },
    {
      "uid": "zhcn:679f6c9e1a52cb7db6ef50c9",
      "kind": "character_system_text",
      "source_text": "好，是比赛的时间Death！\r\n能做的所有努力都有做到，\r\n再来就只需要专心取胜Death！",
      "source_fingerprint": "bdabccb54db195a1b8c9df8d6c729c19e26e7c5276a7674da3464a18259f2f8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20029"
      ]
    },
    {
      "uid": "zhcn:6859beace664b07470335f68",
      "kind": "character_system_text",
      "source_text": "只要能发挥平时的实力，\r\n就绝对不会输！",
      "source_fingerprint": "929618833c421d8dfe82e7136bed89109f154a01101aabc08f9b4165dad62ae6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20030"
      ]
    },
    {
      "uid": "zhcn:5ae602a538010ed9fa060a72",
      "kind": "character_system_text",
      "source_text": "这次是非常重要的比赛……\r\n我会跟平常一样\r\n「咻咻——」地全力奔跑！",
      "source_fingerprint": "a9ec05426f6286e3a9889acd6eda5fe93c08d9c52737266a74bd6c522bf333de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20031"
      ]
    },
    {
      "uid": "zhcn:ed78f38f3815e7b9aef4f243",
      "kind": "character_system_text",
      "source_text": "还没开始就放弃的话\r\n是不可能赢的Death……！\r\n没事，神鹰能飞的！",
      "source_fingerprint": "eb8cb4d70660520a94b4be7fd2bb4796e4706685a3a971833afd86dbcea98ec9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20032"
      ]
    },
    {
      "uid": "zhcn:1baf69a86a1bf60b67ae8d1b",
      "kind": "character_system_text",
      "source_text": "呵呵呵……\r\n状态调整得有点失败也一样能赢，\r\n这才称得上世界最强Death……！",
      "source_fingerprint": "5df46fca109835ece2181183791ed59610d78c18c1f976ab129e02a84bd08da3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20033"
      ]
    },
    {
      "uid": "zhcn:2028535dc0b9093440e96ed7",
      "kind": "character_system_text",
      "source_text": "虽然状态不太好……\r\n但还是影响不了我想赢的心情！",
      "source_fingerprint": "51262bc45d48e6bd981f6b8e01f5eb130de70a8f6fbddd9e28199c303f84a43d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20034"
      ]
    },
    {
      "uid": "zhcn:c2a9d268fa93b483328f8ec6",
      "kind": "character_system_text",
      "source_text": "面临九死一生的危机了，\r\n逆境更让我感到热血啊……！\r\n这时候更要让你见识神鹰的实力！",
      "source_fingerprint": "c64d9f3f6aff2c6380cf564949bda93e41421b3201c91f0574994ea0b0ae2df3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20035"
      ]
    },
    {
      "uid": "zhcn:db5c8f9dac3afa31fbe1846d",
      "kind": "character_system_text",
      "source_text": "毕竟这是重要的比赛……\r\n我会尽全力去跑的……！",
      "source_fingerprint": "b8e5bd61fbf050f4f335dc61cd5c4a77e673cac1f7dc640ef60f914246fd9afb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20036"
      ]
    },
    {
      "uid": "zhcn:79979c93f292d7f630d82452",
      "kind": "character_system_text",
      "source_text": "就一点……一点～点而已哦？\r\n状态有一点点不好啦……\r\n但是没问题！因为我是最强的！",
      "source_fingerprint": "3256b0ac870c7c75c856def121fb950310bcfd94b3f3b3377ffed1dd3512abaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20037"
      ]
    },
    {
      "uid": "zhcn:fc07319bb2661273328a6d85",
      "kind": "character_system_text",
      "source_text": "神鹰入场！",
      "source_fingerprint": "8300eaa7e5b8b403c41876b0743a281af4a6d19aae11095b435412da1290a807",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1014",
        "20038"
      ]
    },
    {
      "uid": "zhcn:c4a419972ac7de0f69012719",
      "kind": "character_system_text",
      "source_text": "要开始咯～！",
