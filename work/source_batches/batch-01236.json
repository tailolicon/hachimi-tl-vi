    {
      "uid": "zhcn:c83001f61b1e954adca73b03",
      "kind": "character_system_text",
      "source_text": "认真Dea——th！！",
      "source_fingerprint": "10f665ffe5ef5b4ce381b1db576292ae148c0e2341aaa699fed3f79817baf510",
      "source_path": "character_system_text_dict.json",
      "json_path": [
