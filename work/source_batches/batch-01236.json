    {
      "uid": "zhcn:18986686078e7fabc383ada3",
      "kind": "character_system_text",
      "source_text": "私服、日常穿、放松～♪",
      "source_fingerprint": "038dbfe21122d91c3a0bd4a8978aa5080a0c3efbfde63966eb7689bcfc036130",
      "source_path": "character_system_text_dict.json",
