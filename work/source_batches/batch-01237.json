        "1017",
        "20030"
      ],
      "json_pointer": "/1017/20030"
    },
    {
      "uid": "zhcn:c1f07c1d248cc90d7af464d7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "比赛的时间到了，\r\n走吧，训练员君。",
      "source_fingerprint": "2fae1c0b7252761dada911d6aef571da3569ca9e3c8e8953f5405c5488226d26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20031"
      ],
      "json_pointer": "/1017/20031"
    },
    {
      "uid": "zhcn:f31b7c8bd233c3b6e4496d3e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然状态没那么理想……\r\n没事，我很清楚自己该做些什么。\r\n总之全力以赴吧。",
      "source_fingerprint": "34fbe7cbc26a4959f95dabb361b54ea2fff1fee1363b90c7950738d5e5f18f87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20032"
      ],
      "json_pointer": "/1017/20032"
    },
    {
      "uid": "zhcn:9ef0dac4609623550be1f7c6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽称不上是万全的状态，\r\n但不能因此退缩。\r\n我会保持坚毅的心态出赛的。",
      "source_fingerprint": "6779583613f23274e6d56d256a012bb6cae477453b23a8680d6cfa9da87223b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
