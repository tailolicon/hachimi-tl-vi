      ]
    },
    {
      "uid": "zhcn:90c3eb86fb4ddd1c43579719",
      "kind": "character_system_text",
      "source_text": "……逆境吗？哈哈，真有意思……\r\n在此获胜才算得上是「霸王」……！",
      "source_fingerprint": "056746c1c559556a676e2aa6c76ce918e9ffd819a644e0bfa0542693d65ebf28",
