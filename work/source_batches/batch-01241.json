        "1018",
        "81001"
      ],
      "json_pointer": "/1018/81001"
    },
    {
      "uid": "zhcn:e24760c8a7d4b7c5fbfe0f84",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "别因为是早上就松懈了。\r\n不打起精神来\r\n可做不了我的训练员哦。",
      "source_fingerprint": "d10ffec2b5c057d09d8ba8fc891c6eefe8e38a2dc67b6d463e7912e7f1c7bd87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
