    {
      "uid": "zhcn:9967b63cacdce85dda3da189",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "展现我「女帝」的跑法！！",
      "source_fingerprint": "84fcf4abf5a332b299238caab3c12d44ff2cd8356e839d5de820892aa417cb1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
