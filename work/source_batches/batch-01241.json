    {
      "uid": "zhcn:aeffd8b8383c23c81d58bb2a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我要认真跑了喔。",
      "source_fingerprint": "ceeef2bbfdd65cc0b2fe2212545cdf5ad0f2377e91a4749694aa4f8ca2fc5ff1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
