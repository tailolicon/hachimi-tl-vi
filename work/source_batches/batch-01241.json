    },
    {
      "uid": "zhcn:082224cb7f0a0324ca86a5f7",
      "kind": "character_system_text",
      "source_text": "全身都……热血沸腾了！",
      "source_fingerprint": "fc9d2ae81c241380ea3ad563e8f218a3bdb24ad5466eacdbc47ff11d57d0c8ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "120000"
      ]
    },
    {
      "uid": "zhcn:7bb955cc06504f20d2425f73",
      "kind": "character_system_text",
      "source_text": "……这是今天的登录奖励。",
      "source_fingerprint": "127dbd288774a40956566a698f8392c9274df2367f89898ee2ecead6196d6ee9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "13"
      ]
    },
    {
      "uid": "zhcn:f4fe88e4d3599e474ed0009b",
      "kind": "character_system_text",
      "source_text": "……盯好自己的猎物吧。",
      "source_fingerprint": "7f4a9a9eeae607e686b33bad39aa1d0f62fae7031feef25a9011d11692b553b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140000"
      ]
    },
    {
      "uid": "zhcn:35aadde09b811cbfdb9b7111",
      "kind": "character_system_text",
      "source_text": "……好。",
      "source_fingerprint": "8e83aa0ebedbafc894362e5d9b45b0cb4ab939fe816a08aef341ea714cebcabe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140001"
      ]
    },
    {
      "uid": "zhcn:e0831b6d3107c1110497a11a",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140002"
      ]
    },
    {
      "uid": "zhcn:16c605a1b2ce6ba6543151d6",
      "kind": "character_system_text",
      "source_text": "狩尽一切猎物了呢。",
      "source_fingerprint": "17572cfd99b3828a38f781c709e997ee6e52574e52f6d7ab9c480a827e0722d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140003"
      ]
    },
    {
      "uid": "zhcn:f8082070964636994b2a3c7d",
      "kind": "character_system_text",
      "source_text": "还不错。",
      "source_fingerprint": "c671c74f1262c22b0ace2c4f45a9eb87b43eec6dae705124b28e1d9980db4756",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140004"
      ]
    },
    {
      "uid": "zhcn:925d1a28c6240f68b9449c33",
      "kind": "character_system_text",
      "source_text": "……就只是这样而已吗？",
      "source_fingerprint": "8c7fa1565fc2f27a798ef224c55f68831b5e597802741e525405d33a84a2d399",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140005"
      ]
    },
    {
      "uid": "zhcn:c49d6d54fb8bd059797260be",
      "kind": "character_system_text",
      "source_text": "狩尽一切猎物了呢。",
      "source_fingerprint": "17572cfd99b3828a38f781c709e997ee6e52574e52f6d7ab9c480a827e0722d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140006"
      ]
    },
    {
      "uid": "zhcn:5e6860b63bf861230a362877",
      "kind": "character_system_text",
      "source_text": "还不错。",
      "source_fingerprint": "c671c74f1262c22b0ace2c4f45a9eb87b43eec6dae705124b28e1d9980db4756",
      "source_path": "character_system_text_dict.json",
