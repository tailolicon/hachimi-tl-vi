      ],
      "json_pointer": "/1018/91006"
    },
    {
      "uid": "zhcn:350672665e7692407958078c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "光靠外观表象的东西可是\r\n撑不起「女帝」的名号。我会在\r\n比赛中让你见识「女帝」的姿态。",
      "source_fingerprint": "7dccdd4180abe82f7caeb55e42641f72fb81c9291b277fbe68ee4831dc73c35c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
