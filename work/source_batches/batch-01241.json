    {
      "uid": "zhcn:f7617b52bd4ff35635d1d985",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "很棒喔！",
      "source_fingerprint": "02c33fd630f9762557b4901bc09551a6cb6fcc915bdd4eb1f2271ec5541068fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
