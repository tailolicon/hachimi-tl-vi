    },
    {
      "uid": "zhcn:e327c73c40906ed22544a513",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "哼，相当不错……\r\n这才像话嘛！",
      "source_fingerprint": "8fd1fa1e155ddc407d010ac0a0d2a60058ccf498e13ae8af9965bf52fd24c82b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
