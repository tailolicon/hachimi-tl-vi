      ]
    },
    {
      "uid": "zhcn:0ec4a47e2b4f723dfc39f807",
      "kind": "character_system_text",
      "source_text": "哼、哼……",
      "source_fingerprint": "0dda6a0eebb1c0bd0353e13cd41054cca10683929083c40faf475a270c2f52ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140008"
      ]
    },
    {
      "uid": "zhcn:cec73e750ead86ba8a5b9076",
      "kind": "character_system_text",
      "source_text": "哼。",
      "source_fingerprint": "758a23ba3b4ff252a4e5eac29e32085c8aaa84f0e672e96ad91d5390fb0aa06e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140009"
      ]
    },
    {
      "uid": "zhcn:b42589f4a154bb0b7a3d4b83",
      "kind": "character_system_text",
      "source_text": "嗯～♪",
      "source_fingerprint": "4b0224cd4f0c6ca945f37d262ba7355355dc0afed22ec2aa854127217187d417",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140010"
      ]
    },
    {
      "uid": "zhcn:9e9e99c7c8799aca22cd2a27",
      "kind": "character_system_text",
      "source_text": "你很厉害嘛！",
      "source_fingerprint": "a18018749875829dc430ff48eef526f47bad4d355e4e9adab2596bc93286893c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140011"
      ]
    },
    {
      "uid": "zhcn:b31783622db24eee0e1136ce",
      "kind": "character_system_text",
      "source_text": "很好。",
      "source_fingerprint": "8e2d53b9afc302fe6193a0f0c17c886a3d13d1fd0a390efb052c4a77ba94a09d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140012"
      ]
    },
    {
      "uid": "zhcn:cbec9e4b6a34378bf639893b",
      "kind": "character_system_text",
      "source_text": "……！？",
      "source_fingerprint": "c852f2a372d80446b99a7c7fe3b82ec07bab9faf8d327ec068aaf7f7392bf0c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140013"
      ]
    },
    {
      "uid": "zhcn:7f0f1c27b6659d5e1bdbc254",
      "kind": "character_system_text",
      "source_text": "什……！？",
      "source_fingerprint": "0024bd9c7e6a1e58e5d93f901b33058afae19cf6531d0d7c9688687f18d2005e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140014"
      ]
    },
    {
      "uid": "zhcn:8643dff8903c9e7292b85849",
      "kind": "character_system_text",
      "source_text": "喔……",
      "source_fingerprint": "f79f7e9ac2e9e41f9906c092a20626889b780256a1fae3d8013b39de095f39af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140015"
      ]
    },
    {
      "uid": "zhcn:8f2a8157ec573c34c9c3fda7",
      "kind": "character_system_text",
      "source_text": "走吧……！",
      "source_fingerprint": "2a238b480d3d3b03a89f94c8a262afa5391cdeb5e27e2403a45c68ff1ba0db50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140016"
      ]
    },
    {
      "uid": "zhcn:7a1160ffa409960ade682a9e",
      "kind": "character_system_text",
      "source_text": "可恶！",
      "source_fingerprint": "20b6ae424ee4b401419c35c536777fe7fbc81ed6c912a347267fb4c85ca3171a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140017"
      ]
    },
    {
      "uid": "zhcn:b48d72a0c82d60e43395fce4",
      "kind": "character_system_text",
      "source_text": "啧……",
      "source_fingerprint": "f067f48da199e272fcff687fcdf4c651840778b12461e92a3b2f3daffefaa1f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "140018"
      ]
    },
    {
      "uid": "zhcn:ea1eee595aeac02c03947dc8",
      "kind": "character_system_text",
      "source_text": "明天好像可以获得这个。",
      "source_fingerprint": "5f3db9b1bfa701a79f152d5b5d9b1f5510b217b5b2af606bac9bade790c9e61f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "15"
      ]
    },
    {
      "uid": "zhcn:81922232e9bdb386f26f48fd",
      "kind": "character_system_text",
      "source_text": "唔……没力了……",
      "source_fingerprint": "45a8b5d5c298fea2e043c80ace18e8a8e696d1911bdf6a77e17186d798e1a529",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20000"
      ]
    },
    {
      "uid": "zhcn:1c9e06b1ba2cb32fdf77a56d",
      "kind": "character_system_text",
      "source_text": "稍微休息一下应该就没事了……",
      "source_fingerprint": "c37d190b58fd02e9db363d791f82e46d2d4b827ff5f719c1fd96630dc4330b2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20001"
      ]
    },
    {
      "uid": "zhcn:39d259fbd63807fb31e99eb0",
      "kind": "character_system_text",
      "source_text": "全身充满了力量。\r\n来，我们开始吧……！",
      "source_fingerprint": "9b2fcc1b76f6b774dc8e28e9f907c4386139f8900f662ef6f36d2cde892bf2f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20002"
      ]
    },
    {
      "uid": "zhcn:de1f49a0b6caa70fe98b52b1",
      "kind": "character_system_text",
      "source_text": "精气神饱满……！\r\n不可以浪费这样的机会。",
      "source_fingerprint": "65bf95e768ff1f665ea441c7dd33afd5a6a663df77783867ebd73d7ac41b4daf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20003"
      ]
    },
    {
      "uid": "zhcn:a229f5102cd4a3d846b54e25",
      "kind": "character_system_text",
      "source_text": "趁现在来提前为比赛做好准备吧。",
      "source_fingerprint": "77c937af18ad8e6082ca03332da59e365a34818346e51b739930302d20e5564b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20004"
      ]
    },
    {
      "uid": "zhcn:945b677ce780c49c4b27ae2c",
      "kind": "character_system_text",
      "source_text": "做比平常严苛的训练也没关系。",
      "source_fingerprint": "704a4cbeabd04ce8381b1cbe9e6bb61f34583a3e31b501d59f385a8fbe99c5d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20005"
      ]
    },
    {
      "uid": "zhcn:be495015b20d731fd11debff",
      "kind": "character_system_text",
      "source_text": "我已经准备好了。",
      "source_fingerprint": "d087a08db86554d7a708865a91cc21eaba38f4d4f9413d7d722d96f70e8fb9b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20006"
      ]
    },
    {
      "uid": "zhcn:d27cd1f61e979b8883d5c242",
      "kind": "character_system_text",
      "source_text": "状态还不错。\r\n……我随时都可以上。",
      "source_fingerprint": "38c83327e911fc9245e1837dec1ad2b7a6630348f039302dd48552401a7c1cff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20007"
      ]
    },
    {
      "uid": "zhcn:603253360f4dcbe8f231e27f",
      "kind": "character_system_text",
      "source_text": "脚竟然这么沉重……？",
      "source_fingerprint": "e8dac0fd50d9301f87a422b48bdbc602938808e3c451cedd761b5d637bba7c4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20008"
      ]
    },
    {
      "uid": "zhcn:f8a116d5333e1078327d7053",
      "kind": "character_system_text",
      "source_text": "唔……身体的反应好迟钝……",
      "source_fingerprint": "1d4210b482df3b1667f69d0a2b8b30b00a763ee431c5abe9bb6aaac4fabdabf3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20009"
      ]
    },
    {
      "uid": "zhcn:849c81faf1544eae57d2c05d",
      "kind": "character_system_text",
      "source_text": "啧……身体出不了力气……！",
      "source_fingerprint": "235b4f519b24a40198f15bd73e9b0cec20addb363b4d1bad24d614706844c8e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20010"
      ]
    },
    {
      "uid": "zhcn:65dedd4caf90a9fdd81990cf",
      "kind": "character_system_text",
      "source_text": "明明我不能在原地停滞不前……！",
      "source_fingerprint": "3a0d59321359c3862f85ec6a5b663c3be1d8af288ca79b7575a327fc793ce18c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20011"
      ]
    },
    {
      "uid": "zhcn:4a8c4e82fe8ddfc1f9afb494",
      "kind": "character_system_text",
      "source_text": "……要参赛是无所谓，\r\n但身体会受到什么样的影响，\r\n你也要仔细地评估。",
      "source_fingerprint": "7e63b6954e38df063b8084ac14a4619aa2c1c72bc51cb17cfd2982cd7398e667",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20021"
      ]
    },
    {
      "uid": "zhcn:a0c0c62fa651a0f81946633a",
      "kind": "character_system_text",
      "source_text": "……你是想清楚了才这么决定的吧？\r\n不然只是浪费时间跟力气而已。",
      "source_fingerprint": "b1916ac3b33612128f691fe7f971b97593a2746cae993c4d46e2e3525ed58a0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20022"
      ]
    },
    {
      "uid": "zhcn:c9f2e60a70c4fc03b85ddbc2",
      "kind": "character_system_text",
      "source_text": "狩猎的时候到了。\r\n……呵，我感到热血沸腾……！",
      "source_fingerprint": "9b9efd3c542277572899d4074cbfeb63ed8506527fc7fb161f1bcd4b7547bdf7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20023"
      ]
    },
    {
      "uid": "zhcn:3bf8d2c989a879d376340cef",
      "kind": "character_system_text",
      "source_text": "对手是谁都可以──\r\n试着让我认真起来吧……！",
      "source_fingerprint": "fc7e43b0d6a91dd11536f25c0bc8c1e47d9c9f13335923c51dbcbd1785622ced",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20024"
      ]
    },
    {
      "uid": "zhcn:bdc642805c7571d279fd692c",
      "kind": "character_system_text",
      "source_text": "热血沸腾……\r\n对决即将要开始了……！",
      "source_fingerprint": "1a582d7375fb7028f4d175b1bd054014a8f6e88977d26e54a56f8030359a1818",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20025"
      ]
    },
    {
      "uid": "zhcn:2bcec58d715498585d342fda",
      "kind": "character_system_text",
      "source_text": "……想被我狩猎的家伙在哪？\r\n我来成全你们。",
      "source_fingerprint": "e720adeedf7d40114910b7058c46ed12389f59f6e6c0add835de1b3b88420638",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20026"
      ]
    },
    {
      "uid": "zhcn:334440f2ffc9dd1f293e9c09",
      "kind": "character_system_text",
      "source_text": "很快就能定出胜负了吧。\r\n──瞬间高下立判。",
      "source_fingerprint": "05e34a28224158cd77a33b272dcb4cb571b55c73007ad04940112bc7fde01591",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20027"
      ]
    },
    {
      "uid": "zhcn:bd0f0d7f80be0575ef832168",
      "kind": "character_system_text",
      "source_text": "我只要用实力压倒所有人就行了。",
      "source_fingerprint": "41463c1c1bd9f723e7470ff0bd8857525fa438955e06adf5abed1199c2cc8473",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20028"
      ]
    },
    {
      "uid": "zhcn:43ae05980764f451457e675d",
      "kind": "character_system_text",
      "source_text": "……拿下胜利。仅此而已。",
      "source_fingerprint": "8c5bc8d32e175800ddf1124454bf01bd0446828a2969e332a20b2cbd75803c74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20029"
      ]
    },
    {
      "uid": "zhcn:28e34b677ee8a557f5404383",
      "kind": "character_system_text",
      "source_text": "发挥一直以来锻炼的成果吧。",
      "source_fingerprint": "11da74ede572e904da6184cbe6a0f574e97d6cf9e269f9c3d38cf2bb8de2f4ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20030"
      ]
    },
    {
      "uid": "zhcn:3cf8361e09e58b8e1cdf06c8",
      "kind": "character_system_text",
      "source_text": "我已经等不及……\r\n要听到开场小号的声音了。",
      "source_fingerprint": "de615668ac7b5c5e37efc8d33ddfb469bf62941a879a9570fea78a28d0a77796",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20031"
      ]
    },
    {
      "uid": "zhcn:2ba0c7b4d06c3bd7bf8a5952",
      "kind": "character_system_text",
      "source_text": "就这种程度……没问题的。\r\n不用特别担心。",
      "source_fingerprint": "3c78a3f25423e0e0a69dc116df14ed7810143f47a07e8091bf7b594db6805ccf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4d3248d96af19b46cf7abb78",
      "kind": "character_system_text",
      "source_text": "虽然会多少影响到我的表现……\r\n……但也只需要去克服而已。",
      "source_fingerprint": "ef549219ce0bf0836368b8e398e6103041620fdcc2ba4f71cb55f22ebcacf8e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20033"
      ]
    },
    {
      "uid": "zhcn:fc2a4a65123e11c76881ba7a",
      "kind": "character_system_text",
      "source_text": "不用过度担心。\r\n专心盯着前方就好……",
      "source_fingerprint": "510bf388e297f4b6195312559ae21a6dc12406b7fcaf546f63f67bd31bb3613a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20034"
      ]
    },
    {
      "uid": "zhcn:a90e0110c8903c717401d2d7",
      "kind": "character_system_text",
      "source_text": "「毒药用好了也能成为良药」\r\n大姐曾这么说过……但究竟……",
      "source_fingerprint": "3fe531f45299cc848b614a2b14020f4e9fdab1a959cf1293d55311ebe1897b9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20035"
      ]
    },
    {
      "uid": "zhcn:96791e6fbc3b367ea90faae5",
      "kind": "character_system_text",
      "source_text": "现在才后悔也已经没有意义了。\r\n……只能全力以赴了。",
      "source_fingerprint": "0bb9211ea239c3153f396d36be0a5bf8ba2b31eeabd1f4ea8f60b097e072f568",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20036"
      ]
    },
    {
      "uid": "zhcn:9bac406df0fc97bb38f65f43",
      "kind": "character_system_text",
      "source_text": "现在还不是我倒下的时候……！",
      "source_fingerprint": "c9d48a81d6e18b640bf92af12b404ce951d4628fb1cd11aa48b1a6ff85cf4c5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20037"
      ]
    },
    {
      "uid": "zhcn:979b5fcaf849cbee105aad18",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20038"
      ]
    },
    {
      "uid": "zhcn:ffda0e30daf435bc3912c82e",
      "kind": "character_system_text",
      "source_text": "……好吧。",
      "source_fingerprint": "52c1743b838216f957d3056e8112f3dd8b15089fcfd0e26e4df719d36a32fe5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
