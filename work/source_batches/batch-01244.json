  "entries": [
    {
      "uid": "zhcn:de518517a6527cd2069af05f",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "11"
      ]
    },
    {
      "uid": "zhcn:c26ba7c5ab1db2fec6880c49",
      "kind": "character_system_text",
      "source_text": "锻炼吗？\r\n日积月累的努力是很重要的。",
      "source_fingerprint": "7e5f37ed7bd7a6c934da919c414243582d7c280c35d990e55f2a9db9377d3675",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "110000"
      ]
    },
    {
      "uid": "zhcn:d4b1519a3cf3309f537e859d",
      "kind": "character_system_text",
      "source_text": "这里充满了赛马娘的历史。",
      "source_fingerprint": "49792f93e16258c27b6391df5d744372eb914f18ba98d5b1958254a8cd73b234",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "110001"
      ]
    },
    {
      "uid": "zhcn:3bbf32050e4ab97e2a2d8b63",
      "kind": "character_system_text",
      "source_text": "要报名参加比赛吗？",
      "source_fingerprint": "4904075f4a1722bb60be3ee7a8dc6973ac5a113ff28332e1368533ce91222f56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "110002"
      ]
    },
    {
      "uid": "zhcn:0c68ddcd370957e7fec399e8",
      "kind": "character_system_text",
      "source_text": "自得。",
      "source_fingerprint": "927f7fd5fdc0372fc0d4698c5d014464f77bdb4c7ad4168fb6be83ee82c0125c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "1119"
      ]
    },
    {
      "uid": "zhcn:5d26e5354622f33dff655d66",
      "kind": "character_system_text",
      "source_text": "你真是有情有义。",
      "source_fingerprint": "5b76ad71c43a4c6823e31c04c86aa03273260ed0adec0e96c090cce11258ea0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "1163"
      ]
    },
    {
      "uid": "zhcn:00bf8bdc3c2c5182edd46c00",
      "kind": "character_system_text",
      "source_text": "所有人的对手。",
      "source_fingerprint": "5cb8e4081d3b8f9e86ff429ef80ef7c2edecad33a08d289258776b59aea67e9d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "1174"
      ]
    },
    {
      "uid": "zhcn:70bbc0d372f48d8cf485eba3",
      "kind": "character_system_text",
      "source_text": "这样就好。",
      "source_fingerprint": "9dd6cfa665188ebddd75282ddf230d532fe61856e86506e268b127c55990dbac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "1175"
      ]
    },
    {
      "uid": "zhcn:11a9c819f4e62489ae3e05e5",
      "kind": "character_system_text",
      "source_text": "いつでも。",
      "source_fingerprint": "46b624a4d63b8696131a739b6055d9b0ce678e4314051dac9df18cadd5eb6c20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "1181"
      ]
    },
    {
      "uid": "zhcn:e76b0e790a2ad6149b01c7c7",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby",
      "source_fingerprint": "0fb57ac68b66f1546f9801f5aaf6a725ec4388807ec83792fcbb5cebd8d3fbba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "12"
      ]
    },
    {
      "uid": "zhcn:7e8807784f3f6b7cb3b2fd8f",
      "kind": "character_system_text",
      "source_text": "彷佛有股看不见的力量在促使我前进。",
      "source_fingerprint": "5eb202a5738b9230dd47c4b9153c690de56bc1629b052b0207d9da29adf04901",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "120000"
      ]
    },
    {
      "uid": "zhcn:aba2d19dec1537ae07e4e8ae",
      "kind": "character_system_text",
      "source_text": "这是今天的登录奖励。",
      "source_fingerprint": "7cc7b99b32d8f34da6bd620973df2ae9a0a57751a69db6f6dffcae6088fc7c17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "13"
      ]
    },
    {
      "uid": "zhcn:e29eebef83d4f12fd8cd2805",
      "kind": "character_system_text",
      "source_text": "我很期待。",
      "source_fingerprint": "fb68552f124570bd5245c78bdd75a028b4df21ce5b7bd41549967729dbf58354",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140000"
      ]
    },
    {
      "uid": "zhcn:b1345863ea33fb17ba978836",
      "kind": "character_system_text",
      "source_text": "成功了。",
      "source_fingerprint": "d274fbb8726de6608c24a61f78c8db4bbc7d74e06bb6efd0e871dfbf618e2a0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140001"
      ]
    },
    {
      "uid": "zhcn:76df2dc3c8848586eae17ca0",
      "kind": "character_system_text",
      "source_text": "很困难呢……",
      "source_fingerprint": "8b05808185a1c8657aab8276ea4f4314085bd4c3f897d568bdd41d560673bdf6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140002"
      ]
    },
    {
      "uid": "zhcn:5c45e26802fbddd7483a451d",
      "kind": "character_system_text",
      "source_text": "我由衷地感谢你。",
      "source_fingerprint": "1bc15ab5ec9636ed0f37a69b3cdac83da239f84e2c92cb71d1bfa7f7245b7d77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140003"
      ]
    },
    {
      "uid": "zhcn:5d7e0cb5b229e6e5280912fa",
      "kind": "character_system_text",
      "source_text": "战果还算可以。",
      "source_fingerprint": "d14c8df5caa4403e0695e931b5eb5274f65a074690f7363dba1289115b2639f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140004"
      ]
    },
    {
      "uid": "zhcn:bfe10faf64248fb19c86ebf8",
      "kind": "character_system_text",
      "source_text": "反败为胜，下次还有机会。",
      "source_fingerprint": "34dafe736bf4c16861abb62bcde816c70b4ce25e8bc0dcf584ffacd834d0ed94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140005"
      ]
    },
    {
      "uid": "zhcn:00d3c214262f8390f1b4c2c4",
      "kind": "character_system_text",
      "source_text": "我由衷地感谢你。",
      "source_fingerprint": "1bc15ab5ec9636ed0f37a69b3cdac83da239f84e2c92cb71d1bfa7f7245b7d77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140006"
      ]
    },
    {
      "uid": "zhcn:c77ff557c0568e74f447aa12",
      "kind": "character_system_text",
      "source_text": "战果还算可以。",
      "source_fingerprint": "d14c8df5caa4403e0695e931b5eb5274f65a074690f7363dba1289115b2639f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140007"
      ]
    },
    {
      "uid": "zhcn:162295528a07e91c42d24df8",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140008"
      ]
    },
    {
      "uid": "zhcn:9fe8be1385141dabd370434e",
      "kind": "character_system_text",
      "source_text": "伤脑筋了……",
      "source_fingerprint": "e153955d6fdf3dbc4b6586c2baa4165d1dad98427e37694612903125ca6cc65d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140009"
      ]
    },
    {
      "uid": "zhcn:28ddeed824618dc6fc5a5fa5",
      "kind": "character_system_text",
      "source_text": "哈哈",
      "source_fingerprint": "7a655569d7aab2029ca20b72aea1237bb7852fc2a5b4a297e9a49b4fed453b2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140010"
      ]
    },
    {
      "uid": "zhcn:70bb62feaf8542e08126f96e",
      "kind": "character_system_text",
      "source_text": "相当出色！",
      "source_fingerprint": "1430a015cf6d701be62b0977a6ac0062cdc6197b67633a5a3581318bf32e33cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140011"
      ]
    },
    {
      "uid": "zhcn:0ab82ad7bd0fa1032bb2c69d",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140012"
      ]
    },
    {
      "uid": "zhcn:54a170812bc67412a317af71",
      "kind": "character_system_text",
      "source_text": "哦哦！",
      "source_fingerprint": "491afe930290ca00537960230e3bbc3448d690ce63dc08b63e2557d06bba67b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140013"
      ]
    },
    {
      "uid": "zhcn:0e594c30f3d68894bdbd6ea1",
      "kind": "character_system_text",
      "source_text": "什么！？",
      "source_fingerprint": "8fae634bd9fed421672fb72e9b24f793384cadde5c35454a04573eec752d6239",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140014"
      ]
    },
    {
      "uid": "zhcn:8f9726ebe144c887d30c2dd2",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140015"
      ]
    },
    {
      "uid": "zhcn:fdf239fbbde8c97445dba860",
      "kind": "character_system_text",
      "source_text": "你看。",
      "source_fingerprint": "1a91ca79e6dd0ec63903f9e874cabb8f0dd74254d15df5fc91ed12a43a6b0ae5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140016"
      ]
    },
    {
      "uid": "zhcn:45403863e02bd0544b8c14a6",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140017"
      ]
    },
    {
      "uid": "zhcn:8306089f662bbb8a7f0c4add",
      "kind": "character_system_text",
      "source_text": "该怎么办好呢……",
      "source_fingerprint": "d04da3a818035c6655b03abbbe3511c5f51b031161da0c84e4fc7942986b36b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "140018"
      ]
    },
    {
      "uid": "zhcn:e04650c8e7a4cb49a3cd131f",
      "kind": "character_system_text",
      "source_text": "明天……是这个啊。",
      "source_fingerprint": "26f9750448a27047c04673482ff5fb6dd08118d13041092c1f959fa2a54acfda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "15"
      ]
    },
    {
      "uid": "zhcn:5758a0f8e9541c92cbff4ad4",
      "kind": "character_system_text",
      "source_text": "若说不觉得累那是不可能的……\r\n也许该重新审视一下，\r\n不该这么执着于缔造成果。",
      "source_fingerprint": "37d110217227d1deceb0d3cafdee421fdb309b0fd4c25f6ff49eb98a6ededa32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20000"
      ]
    },
    {
      "uid": "zhcn:931bc13ed29e06b9fb4664d4",
      "kind": "character_system_text",
      "source_text": "我好像累积了些疲劳……",
      "source_fingerprint": "96056e063a65dc0ba8b93a1fc4615100bd84b8c7c89220e4deb4ce58f7d903ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20001"
      ]
    },
    {
      "uid": "zhcn:76ac74afcb991f638dde6dab",
      "kind": "character_system_text",
      "source_text": "今天的我充满干劲。\r\n看来能跑出不辱「皇帝」名号的成绩。",
      "source_fingerprint": "f275abae1174ec20a3e97efb1967473d0dca45b09893fe51a3ce1c0ea319d007",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20002"
      ]
    },
    {
      "uid": "zhcn:87d8cd8369262cff0a803a77",
      "kind": "character_system_text",
      "source_text": "状态「非常好」。\r\n那我们也「非常豪」迈地去训练吧！\r\n……呵呵，连冷笑话都特别有灵感。",
      "source_fingerprint": "2764ee4932b8c164cae857003ccb820c89c806f1fe965c3ab87fcaf42970a694",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20003"
      ]
    },
    {
      "uid": "zhcn:3a5bf20e509670353dd7502f",
      "kind": "character_system_text",
      "source_text": "「以顶点为目标」\r\n这个目标会使我更加有动力奋斗。\r\n今天也要好好训练来精进自己。",
      "source_fingerprint": "1fd6d8f15cea5fa59d79a2395e7fcca52f33f6202ce957ab074b382bb82d1690",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20004"
      ]
    },
    {
      "uid": "zhcn:aff2acbf4206152684dc65da",
      "kind": "character_system_text",
      "source_text": "只要想着赛马娘们的事情，\r\n很自然地就会充满干劲。\r\n我必须朝着志向继续迈进。",
      "source_fingerprint": "4688711391f49de72f5068d97884a1e001591ba964760739418ea9771d708d3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20005"
      ]
    },
    {
      "uid": "zhcn:17d859c5d7b6eb0ff1a146d2",
      "kind": "character_system_text",
      "source_text": "都已经准备好了，\r\n来开始训练吧。",
      "source_fingerprint": "87d6ba486eca403724d69f7bf3144072b7ba78884d1a50c4ce988c6c5b7170e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20006"
      ]
    },
    {
      "uid": "zhcn:5ca6a795940a63a4bfdf3d3f",
      "kind": "character_system_text",
      "source_text": "日积月累的努力必会成为\r\n朝目标迈进的能量。\r\n今天也要努力进行训练。",
      "source_fingerprint": "35e24c3e720a93ef226ec73ba5c4c69c89518a943267a66c5a64064212f3dfa1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20007"
      ]
    },
    {
      "uid": "zhcn:4908fc1b7895dbef253a8f79",
      "kind": "character_system_text",
      "source_text": "嗯……状态一直不太好，\r\n但也不能因为这种小事而埋怨。",
      "source_fingerprint": "bc280c973256d4c551c01341c81928b990ef05e9093c96c067b4a6f050df2cf1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a9d5b85f34e1bf1c6795a393",
      "kind": "character_system_text",
      "source_text": "今天的集中力不太好。\r\n没事的……就算是这样，\r\n该做的事情我还是会做好。",
      "source_fingerprint": "2511e66fc3d95c4e8e6b34743d8b84d6e3d9398a28cd2e1154e771a0770ff162",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20009"
      ]
    },
    {
      "uid": "zhcn:a5abcd0e918d631a32fcf12c",
      "kind": "character_system_text",
      "source_text": "糟糕……感觉身体很沉重。\r\n但我不想浪费任何一天……",
      "source_fingerprint": "02dc93ee185d35f5581643df2dd3ad7bccf18b94a1d837d0c0892f85dfe28eb0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20010"
      ]
    },
    {
      "uid": "zhcn:ede1c5377e3ffe2b1d3270d2",
      "kind": "character_system_text",
      "source_text": "没办法发挥平时的水平……\r\n虽然我知道不该是这样的表现……",
      "source_fingerprint": "5d318e2f97503e3d6ac99dfcfcb36ccd18adc6b7b0384f89885d7809087241a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20011"
      ]
    },
    {
      "uid": "zhcn:f36c780581be8e6648bc0edc",
      "kind": "character_system_text",
      "source_text": "最近一直连续在比赛……\r\n没事，我会尽我所能的。",
      "source_fingerprint": "5d68417be66d17e531f01d3cc884484609a65a546a36a0d155deffee03edce56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20021"
      ]
    },
    {
      "uid": "zhcn:73961e138dc75573d5044b0e",
      "kind": "character_system_text",
      "source_text": "我会拼命去做……\r\n但这样的努力不一定能达到\r\n预期的成果，希望你能有所觉悟。",
      "source_fingerprint": "0244bd509396a961aa0162ddb9e8bf2caca4bd283d2427a62bfaee18551e348b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20022"
      ]
    },
    {
      "uid": "zhcn:d62bcd8d913bccf07701e825",
      "kind": "character_system_text",
      "source_text": "感觉有股力量从体内涌出。\r\n我会威风凛凛地跑赢这场比赛的。",
      "source_fingerprint": "4932e236bfe42a11ee9f5dabb6767d0f536631bab264aa340d8fc8c4e2d6f050",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20023"
      ]
    },
    {
      "uid": "zhcn:02b4ccffb4f95fc8f2b04adb",
      "kind": "character_system_text",
      "source_text": "虽说比赛是没有「绝对」的，\r\n但现在的我应该能让你看见……\r\n「绝对」的实力。",
      "source_fingerprint": "550b65f3808918ee6288012a25d9edc7c213dc0b07a937e56775736999121675",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20024"
      ]
    },
    {
      "uid": "zhcn:07fa871a2818660c671a0b4c",
      "kind": "character_system_text",
      "source_text": "呵呵，很庆幸能在如此\r\n情绪高昂的状态下参赛。\r\n现在就已经等不及要开跑了。",
      "source_fingerprint": "ae7e996cc54fe7c9e19c61cd08302487eeb620b3645465ff0b9b44b94acbdb88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20025"
      ]
    },
    {
      "uid": "zhcn:b9d18594f3e50a4f2c209457",
      "kind": "character_system_text",
      "source_text": "现在能像这样以理想的状态参赛，\r\n都归功于训练员的手腕。\r\n我会用结果来回报你的努力。",
      "source_fingerprint": "364c0e81f9c6e6d3ac2730c7c47be052a8854100eaf949b08bc7603adc874a40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20026"
      ]
    },
    {
      "uid": "zhcn:cc84eeabce21d43f4f0ae7c2",
      "kind": "character_system_text",
      "source_text": "不用担心，\r\n今天是超越平时的绝佳状态。\r\n感觉能跑出好成绩。",
      "source_fingerprint": "9657544296c2081992340a4755e63b36cbc8269125640fa903f45ba397e9d4de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20027"
      ]
    },
    {
      "uid": "zhcn:dd3d3b32f45a69e63d0f2357",
      "kind": "character_system_text",
      "source_text": "呵呵，心里充满了期待。\r\n看来是能带好消息回来给你了。",
      "source_fingerprint": "eb36d7114161dbb17c9abd09a93b840b217298d2c74e2fd221050b0861878414",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20028"
      ]
    },
    {
      "uid": "zhcn:9cb3b2edc6c40a3718bc078e",
      "kind": "character_system_text",
      "source_text": "即使被誉为「皇帝」也不能骄傲，\r\n必须专心迎战眼前的比赛……\r\n我会用尽全力去跑的。",
      "source_fingerprint": "89bf40b1169282ce69b28739efc378c42b17998a8b6f1c98d221cca49acfe302",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20029"
      ]
    },
    {
      "uid": "zhcn:738db21ffc0b74aed132940e",
      "kind": "character_system_text",
      "source_text": "心情十分平静，\r\n剩下的就只是上场用尽全力奔跑。",
      "source_fingerprint": "83149f255a54735ec54c5dd47e7850e18e64a15a178db0eb2056bbcd7e6fd8fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20030"
      ]
    },
    {
      "uid": "zhcn:c1f07c1d248cc90d7af464d7",
      "kind": "character_system_text",
      "source_text": "比赛的时间到了，\r\n走吧，训练员君。",
      "source_fingerprint": "2fae1c0b7252761dada911d6aef571da3569ca9e3c8e8953f5405c5488226d26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f31b7c8bd233c3b6e4496d3e",
      "kind": "character_system_text",
      "source_text": "虽然状态没那么理想……\r\n没事，我很清楚自己该做些什么。\r\n总之全力以赴吧。",
      "source_fingerprint": "34fbe7cbc26a4959f95dabb361b54ea2fff1fee1363b90c7950738d5e5f18f87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20032"
      ]
    },
    {
      "uid": "zhcn:9ef0dac4609623550be1f7c6",
      "kind": "character_system_text",
      "source_text": "虽称不上是万全的状态，\r\n但不能因此退缩。\r\n我会保持坚毅的心态出赛的。",
      "source_fingerprint": "6779583613f23274e6d56d256a012bb6cae477453b23a8680d6cfa9da87223b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20033"
      ]
    },
    {
      "uid": "zhcn:2c02e65d9ca5238a0b709097",
      "kind": "character_system_text",
      "source_text": "我会带着自信去跑的。\r\n就算状态不好，我也依然是\r\n背负了「皇帝」名号的人。",
      "source_fingerprint": "8345cd757e3f175ffe5c0361c3ff071d989c6b899cc4ae03171aece51bd225ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20034"
      ]
    },
    {
      "uid": "zhcn:06c6f65e9f744f1fe12a965f",
      "kind": "character_system_text",
      "source_text": "状态没有调整好……\r\n但我不会因此放弃比赛。\r\n我会尽我所能全力以赴。",
      "source_fingerprint": "f573f4c5c9300fc26137f1e18cf578b3363bd308bd4e02f435770f89e3615d9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20035"
      ]
    },
    {
      "uid": "zhcn:de849b5992853d665ae20f8e",
      "kind": "character_system_text",
      "source_text": "没想到竟然会在比赛前受到影响……\r\n我会虚心接受这次的教训，\r\n尽力跑完比赛。",
      "source_fingerprint": "675ee12f6e5ac9f639cbaa9e6ffd3a7a3a0cf70e77e8dc175b0340f4e562d85e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20036"
      ]
    },
    {
      "uid": "zhcn:22c0b6a87b2fd82f7c8aa1b9",
      "kind": "character_system_text",
      "source_text": "状态不好是我自己的责任……\r\n我会抱着粉身碎骨的觉悟去迎战。",
      "source_fingerprint": "4bb5350ddb93b1bb46227ef41b5766ce636ef4c87b12453ec628c949da08935d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20037"
      ]
    },
    {
      "uid": "zhcn:ddd031ff04972b4afafff822",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2c5d396881b1268faf7186fa",
      "kind": "character_system_text",
      "source_text": "明白了。",
      "source_fingerprint": "2a2d68c4ff9cf3599c629adf9fd7b4ee5f4b10e6408f421a524401a5087b17b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20039"
      ]
    },
    {
      "uid": "zhcn:e4353ba071f10ede0d5a0ee3",
      "kind": "character_system_text",
      "source_text": "相信我吧。",
      "source_fingerprint": "0676de27273bf73845419fa98e3de6bc5f7b61899b561af3a80b660b380fe3ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20040"
      ]
    },
    {
      "uid": "zhcn:a3e9e08844c724771f9254ab",
      "kind": "character_system_text",
      "source_text": "我知道了。",
      "source_fingerprint": "e4751dd24b1cc01c018d0bfc5e41666107f225b47c76b137af696c4a8217995a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20041"
      ]
    },
    {
      "uid": "zhcn:8183581edfc140729bcd1e65",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20042"
      ]
    },
    {
      "uid": "zhcn:366a993f1df39cc5be8f216d",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f35076bb6069b6648d9f3cad",
      "kind": "character_system_text",
      "source_text": "那我上场了。",
      "source_fingerprint": "60aa19fb3dd8d6ae2ee3947ac73df9b63f1f36247a2a9557a12d92df25acab89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20046"
      ]
    },
    {
      "uid": "zhcn:cde769bd02518321d04e1051",
      "kind": "character_system_text",
      "source_text": "我很期待。",
      "source_fingerprint": "fb68552f124570bd5245c78bdd75a028b4df21ce5b7bd41549967729dbf58354",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20047"
      ]
    },
    {
      "uid": "zhcn:c6a7d6ea0398b2af6f21bb59",
      "kind": "character_system_text",
      "source_text": "是不是离志向更近了一点呢？",
      "source_fingerprint": "7038aefb8a1b68b77d79503f119f4c96a20858a51f23b3af474c9e62610da00f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20049"
      ]
    },
    {
      "uid": "zhcn:e26069473514fee23ca826ea",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员君。",
      "source_fingerprint": "a9af3af62964dff2d2a52e2d154d5948ec8553f2125507d64cdb6fa018e54727",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20050"
      ]
    },
    {
      "uid": "zhcn:c47681165d40aa55e2f3cecb",
      "kind": "character_system_text",
      "source_text": "一起精进吧。",
      "source_fingerprint": "e5522e74daf1b1511624b901c255b6a0b98079e56084182b48693c25ab8d7ca1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "20051"
      ]
    },
    {
      "uid": "zhcn:1fef6197c2c75d6ae7761031",
      "kind": "character_system_text",
      "source_text": "我们团结一致地去完成吧！",
      "source_fingerprint": "978b5bb93c2a978f8835c9b34e3e1982c43215d7fbe5693e8c9129031bd0ebf4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "2030"
      ]
    },
    {
      "uid": "zhcn:d6fc39227994fdb922eb6e5c",
      "kind": "character_system_text",
      "source_text": "奋力一搏，打起精神上吧！",
      "source_fingerprint": "dd6027b99b7f877246512aa7b03b92a44c7990d01b0c1b739633afd56e6424fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "2031"
      ]
    },
    {
      "uid": "zhcn:c80a7c4736caf85e04bfef49",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员君。",
      "source_fingerprint": "a9af3af62964dff2d2a52e2d154d5948ec8553f2125507d64cdb6fa018e54727",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "2032"
      ]
    },
    {
      "uid": "zhcn:db6f97355fa2764f532e47ea",
      "kind": "character_system_text",
      "source_text": "呵呵，心里充满了期待。\r\n看来是能带好消息回来给你了。",
      "source_fingerprint": "eb36d7114161dbb17c9abd09a93b840b217298d2c74e2fd221050b0861878414",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "2033"
      ]
    },
    {
      "uid": "zhcn:a9280302aa411f6934faeb3e",
      "kind": "character_system_text",
      "source_text": "呵呵，很庆幸\r\n能在如此情绪高昂的状态下参赛。\r\n我现在就已经等不及要开跑了。",
      "source_fingerprint": "a4a8c8309751d0d69d2c6db61b26980209a0e7e8800e5a470ddcd8193ec0389a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "2034"
      ]
    },
    {
      "uid": "zhcn:3d3234ec36e61fe6f3235f16",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员君。",
      "source_fingerprint": "a9af3af62964dff2d2a52e2d154d5948ec8553f2125507d64cdb6fa018e54727",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "2035"
      ]
    },
    {
      "uid": "zhcn:0e6752f3df507ce915c0688f",
      "kind": "character_system_text",
      "source_text": "始めよう。",
      "source_fingerprint": "0a91c3a42bee3b610a977d9d276cc865eacf6a6007436b210196e4495453836d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1017",
        "23015"
      ]
    },
    {
      "uid": "zhcn:48ee932f6ddb4701f0950747",
      "kind": "character_system_text",
      "source_text": "下次一定要登上顶点。",
      "source_fingerprint": "725a9d43d20f3f5817f95f9fbc893e3e3e7ea7f59f42b9c1f2d73ec2b5eb25a8",
      "source_path": "character_system_text_dict.json",
