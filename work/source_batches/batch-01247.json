    {
      "uid": "zhcn:2367a9c6f8445c37062685f0",
      "kind": "character_system_text",
      "source_text": "嗯？好像收到了什么新的信息。\r\n你立刻去确认，然后向我汇报。",
      "source_fingerprint": "f70302ef40b3331be81d850d698f5c77ba96912bd62b4751be9634c7dd8136e6",
      "source_path": "character_system_text_dict.json",
