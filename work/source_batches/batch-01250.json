      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1010",
        "20022"
      ]
    },
    {
      "uid": "zhcn:3ed0dbd70b3c8f5ef4e0771a",
      "kind": "character_system_text",
      "source_text": "我会努力不辜负你的期望！\r\nNo.1是唯一目标Death！",
