      "json_path": [
        "1010",
        "20021"
      ]
    },
    {
      "uid": "zhcn:c8026acaccb8d814c3995db3",
      "kind": "character_system_text",
      "source_text": "暂时不想要再参赛了Death……\r\n请让我休息吧……",
