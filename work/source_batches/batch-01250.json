  "entries": [
    {
      "uid": "zhcn:c4015490c6340359f1b96905",
      "kind": "character_system_text",
      "source_text": "我上咯！",
      "source_fingerprint": "72c420633127ee8e5455068140ef1b6599234883f68c6284655daf070887f917",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2b3dc294940df821e545b9e1",
      "kind": "character_system_text",
      "source_text": "开始吧！",
      "source_fingerprint": "1f6f9cb6d386b03a59eafb944e976a93775f81d43c59dffa89b8cc34793a942f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20039"
      ]
    },
    {
      "uid": "zhcn:e6f703102f727f9faa05e271",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20040"
      ]
    },
    {
      "uid": "zhcn:3251e7db27a9faa8ce270e9d",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20041"
      ]
    },
    {
      "uid": "zhcn:427d5c1895129cb024d6e889",
      "kind": "character_system_text",
      "source_text": "搞砸了……",
      "source_fingerprint": "a3c4e4dc3a75cf574e723f5d08fa91dbbe0f080c18a5d51d068002de25bf9f27",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20042"
      ]
    },
    {
      "uid": "zhcn:dda41502a088c74cda9fb6f6",
      "kind": "character_system_text",
      "source_text": "不行啊……",
      "source_fingerprint": "3117407b136cdedd99c190a8a7b64c21ea19135cce886f218d9d726b889c54ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20043"
      ]
    },
    {
      "uid": "zhcn:44f07472cf722bc86635ec14",
      "kind": "character_system_text",
      "source_text": "走吧──！",
      "source_fingerprint": "db75ff260d31894a6ff613a77cb9974041f12a09875173eb1517bffdca1dbc00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20046"
      ]
    },
    {
      "uid": "zhcn:ac0fd4ef19a47d62ffdfe1dc",
      "kind": "character_system_text",
      "source_text": "大海～♪",
      "source_fingerprint": "f45050bfce88d3e6715f25857459f80aa75a0ba6cb172dcd82466b64a53acb47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20047"
      ]
    },
    {
      "uid": "zhcn:4f3927716e1fb0a273868898",
      "kind": "character_system_text",
      "source_text": "这样就有脸去见小不点们了！",
      "source_fingerprint": "b666c79b4b86c76c553c9b4ffac14d7120d16ce0010649f4fcdc1c4643c0af37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20049"
      ]
    },
    {
      "uid": "zhcn:c5b7db5120e8d50d72372918",
      "kind": "character_system_text",
      "source_text": "好开心啊，谢谢！",
      "source_fingerprint": "172fad900e6f99c5abee80695ff1f5bb5f7e5fcd8c49763c23449da487ee01d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20050"
      ]
    },
    {
      "uid": "zhcn:a8dfac0bf2a913ae8f7e1862",
      "kind": "character_system_text",
      "source_text": "来吧，跟我一起做吧！",
      "source_fingerprint": "96a9f0da5663ec5b28d62d9b9d7ab448c03a5588e395ad626b3afc5978037897",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20051"
      ]
    },
    {
      "uid": "zhcn:9d67285e2622c3f965cb920d",
      "kind": "character_system_text",
      "source_text": "成功啦！",
      "source_fingerprint": "6861a1222a83096c184d05beb9eff554b1a5385a4910b681f3bf859f5335b970",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2030"
      ]
    },
    {
      "uid": "zhcn:5cb221281f5c13edc43a5a3d",
      "kind": "character_system_text",
      "source_text": "你要好好跟上脚步喔！",
      "source_fingerprint": "2a91b6ed3dd0f6198d27ef1da9af2e250176e5d1c67a91e3267155ea947b266e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2031"
      ]
    },
    {
      "uid": "zhcn:51627d3b9b9bbe9a2c9d14af",
      "kind": "character_system_text",
      "source_text": "好开心啊，谢谢！",
      "source_fingerprint": "172fad900e6f99c5abee80695ff1f5bb5f7e5fcd8c49763c23449da487ee01d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2032"
      ]
    },
    {
      "uid": "zhcn:81eff3ac538a1e5d14280737",
      "kind": "character_system_text",
      "source_text": "让大家见识我风驰电掣的表现，\r\n感受到火花四射吧！",
      "source_fingerprint": "c9014310174ddc22a86d1527a722a9a0836412444d5408616a24976709deccf5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2033"
      ]
    },
    {
      "uid": "zhcn:9be3fcbd2fe973873100a078",
      "kind": "character_system_text",
      "source_text": "不管对手是大块头，\r\n还是小个子，我都不会输！\r\n让大家见识我的真本事吧！",
      "source_fingerprint": "9952348ff8538c37776f1ea90cc64e541cb9e6909d5339942014182756ce131d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2034"
      ]
    },
    {
      "uid": "zhcn:30673c55f12492cd88a30216",
      "kind": "character_system_text",
      "source_text": "好开心啊，谢谢！",
      "source_fingerprint": "172fad900e6f99c5abee80695ff1f5bb5f7e5fcd8c49763c23449da487ee01d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2035"
      ]
    },
    {
      "uid": "zhcn:e4d642fd3c75056456e1028c",
      "kind": "character_system_text",
      "source_text": "始めよか！",
      "source_fingerprint": "8094473c45dbad64079089259eb22e03f9d6702714965b496059041fe54b6873",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "23015"
      ]
    },
    {
      "uid": "zhcn:7a5a7dd8b41bbc14f5dba7fc",
      "kind": "character_system_text",
      "source_text": "就只差一点点了啊……！",
      "source_fingerprint": "4bd42c65abba1f75de6aaf0419db5289003d47ddbab24e950dd5c8d01407e059",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30000"
      ]
    },
    {
      "uid": "zhcn:d63cd0a4568086656596d844",
      "kind": "character_system_text",
      "source_text": "感觉还可以吧！",
      "source_fingerprint": "77b8db825288ce10bebeefe2850ba6f46f14abea0d9c9c4161e17d7badf8f743",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30001"
      ]
    },
    {
      "uid": "zhcn:3dd0ca450b4c53079feabc2f",
      "kind": "character_system_text",
      "source_text": "感觉不上不下的没有很厉害啊……",
      "source_fingerprint": "9e1bb0e52b93f772ada4f2b0d53aa6eea303788ee78e7fe6e324eb9ea37e1f96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30002"
      ]
    },
    {
      "uid": "zhcn:d5afc67b474d5524100c8aae",
      "kind": "character_system_text",
      "source_text": "不行，得重新锻炼……！",
      "source_fingerprint": "59d04c9e3e2118e5a5c89d6ab882cff35e085a11946dc41301269d4defa612cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1bab9a82df8039680fb422a1",
      "kind": "character_system_text",
      "source_text": "看到了吧！这就是大阪人的意志力！",
      "source_fingerprint": "26c205c51abc6a9041a7224b86e54ee4d00ca6d4b470a9f9a7eb50433cc2f8e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30004"
      ]
    },
    {
      "uid": "zhcn:dfc3eddd592d6f8dc676a9bd",
      "kind": "character_system_text",
      "source_text": "如何！见识到我的意志力了吧！",
      "source_fingerprint": "ebfb658fa8e570e889817ede292744ed3e9e8ac08e0b337d21474248fdfea380",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30005"
      ]
    },
    {
      "uid": "zhcn:686b9b4d3a54cf13ba1b148e",
      "kind": "character_system_text",
      "source_text": "这就是响彻神话时代的闪电！",
      "source_fingerprint": "d43e8371390a70ee67e9d2bf6fa94a2b7e1c080abde4fef811981a2a72911775",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30006"
      ]
    },
    {
      "uid": "zhcn:0eca3c7e30b9be80afed21f5",
      "kind": "character_system_text",
      "source_text": "如何！见识到我的意志力了吧！",
      "source_fingerprint": "ebfb658fa8e570e889817ede292744ed3e9e8ac08e0b337d21474248fdfea380",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30007"
      ]
    },
    {
      "uid": "zhcn:263f1cb373ddb39eddad4bc5",
      "kind": "character_system_text",
      "source_text": "好，走吧！",
      "source_fingerprint": "a1847dedf2949edc2fec2f68a27f5af020238b67e321cd8178d1f99182cf5bd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d3d288e41845f6fbd403a226",
      "kind": "character_system_text",
      "source_text": "这就叫疾风迅雷啊……！！",
      "source_fingerprint": "ac866f845714949655eeaf15ef7b52ac1625d43b63bceff85cc89b63b970bc39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40000"
      ]
    },
    {
      "uid": "zhcn:b176c550fe4de9a453e2be7e",
      "kind": "character_system_text",
      "source_text": "我要当「神马」啊～\r\n老妈听了应该会吓一大跳吧～\r\n……得在家人面前好好表现才行！",
      "source_fingerprint": "518cd21c19cb4c28ebb398e5b44238be836b20eb399dd2f80d1e014f308ab6a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400000"
      ]
    },
    {
      "uid": "zhcn:364b5e8db5c6f7a0b1e93e9e",
      "kind": "character_system_text",
      "source_text": "真是个麻烦的家伙～\r\n好吧，我就一起照顾吧！",
      "source_fingerprint": "a277f067731f29b7cdb33a5eb6b7e17c18f289b22233e4a7da0637d4e5fda705",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400004"
      ]
    },
    {
      "uid": "zhcn:572e3fac6052d1f84ea0dd8e",
      "kind": "character_system_text",
      "source_text": "等着瞧！\r\n我们绝对会跑出一场专属于我们、\r\n最棒的「神马驱」……！",
      "source_fingerprint": "e2838d6fdaec1ed9fc7d521239849a4538ac7bfdc9ec134a70ef834abdf46b0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400006"
      ]
    },
    {
      "uid": "zhcn:c343174da673efc2e3e5a83b",
      "kind": "character_system_text",
      "source_text": "有机会的话，下次叫稻荷举办一场\r\n荞麦面派对吧。至于汤底……\r\n东西边两种口味都准备就好啦！",
      "source_fingerprint": "91861175882dfef92573830853c81c6a9c18e80485273e60a97622a7c5a84b0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400009"
      ]
    },
    {
      "uid": "zhcn:8527ed529f2517082abdc784",
      "kind": "character_system_text",
      "source_text": "要上咯，要上咯，要上咯──！！\r\n风驰电掣的「白色闪电」就是说我啦！！",
      "source_fingerprint": "1c5108c25f571ff318350271ff6edbde3c515bb92e33702f403d4f699ec6b638",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40001"
      ]
    },
    {
      "uid": "zhcn:d3b32207d9fe341f158fa15f",
      "kind": "character_system_text",
      "source_text": "把我送来这所学园时，\r\n妈妈也相信着\r\n「我一定办得到」吗……",
      "source_fingerprint": "31bf716c357765467e8c070a4e51503ba109c5dacf82f48fe322da83753932c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400011"
      ]
    },
    {
      "uid": "zhcn:f1dced12127a87f20fdb2301",
      "kind": "character_system_text",
      "source_text": "接下来还会更热血喔！",
      "source_fingerprint": "1105313a4715dabc58ba687ec2ab02c33ff7673f1b46a028f6a20f7fa6bb247f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40003"
      ]
    },
    {
      "uid": "zhcn:e1619266263ec55c4a770c23",
      "kind": "character_system_text",
      "source_text": "传承下来的意志……就由我让它\r\n响彻云霄！看着吧，这就是\r\n大阪的「升雷」啦──！！",
      "source_fingerprint": "b52a6d8bb5a2d0ba71d1dd18421ca63634ff1a7bb510b14c41b6b686602d0ab1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40004"
      ]
    },
    {
      "uid": "zhcn:b38ab2c967610b49177edb83",
      "kind": "character_system_text",
      "source_text": "炒热气氛就交给我吧！",
      "source_fingerprint": "18c2142fb3b91a2619c8c8025ec13a631e35af2658776d63b438e4f91bb3812e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "60000"
      ]
    },
    {
      "uid": "zhcn:ec42955b8e0dd2dc1a958ade",
      "kind": "character_system_text",
      "source_text": "要发出声音，好好帮忙打气！",
      "source_fingerprint": "46288c62553d5f53f962d8a966df29334331b5eb9bbd80d9c7fc0a9aa5704eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "60001"
      ]
    },
    {
      "uid": "zhcn:2438e379050ca193faf4b1a1",
      "kind": "character_system_text",
      "source_text": "用意志力取胜吧，训练员！",
      "source_fingerprint": "d4feb656be59440167d2789b37061d0878ee743a1becd1872458133783d9ed8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70000"
      ]
    },
    {
      "uid": "zhcn:6d61ae7879df0e813962f8c7",
      "kind": "character_system_text",
      "source_text": "我一开始那么难搞，真抱歉。\r\n现在很感谢你当时\r\n有来找我说话喔！",
      "source_fingerprint": "e0ed872186c4e8a9a6d45e5c53367b4bf89991f94c51aff9d61411d64bd66d09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70001"
      ]
    },
    {
      "uid": "zhcn:a57887e8f4e588bf8891c7ae",
      "kind": "character_system_text",
      "source_text": "以日常服装来说还真讲究啊～\r\n要是在我老家，这就算是最棒的衣服咯。",
      "source_fingerprint": "4cb196617db59c4cf8ea4e714f97876103723a2838e612eb5be0c012bd46b8c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70004"
      ]
    },
    {
      "uid": "zhcn:16b55cfd988837c49a537ca6",
      "kind": "character_system_text",
      "source_text": "哎呀～光是能穿上这么豪华的服装，\r\n就不枉费我努力跑步了，认真的。",
      "source_fingerprint": "a0481837acf6172ad7c9744d3b894deb82c41b830d2852fe8e54b6103a11e692",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70008"
      ]
    },
    {
      "uid": "zhcn:bf99df0127a582bd4ffb1b03",
      "kind": "character_system_text",
      "source_text": "「白色闪电」登场！\r\n……嘿嘿，很有型对吧？",
      "source_fingerprint": "01e0176cab83cde4b2407bd1633fc935dc126d709f6d2059edb62427da9e1313",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70009"
      ]
    },
    {
      "uid": "zhcn:aa78c7afed8fd84edd299af0",
      "kind": "character_system_text",
      "source_text": "用旧的物品居然可以换成新的。\r\n……特雷森学园也太猛了吧？",
      "source_fingerprint": "afc4823e5125e5e768ed95e82f3caf282a4b482f7ac4540277fbc89cac30c4a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70010"
      ]
    },
    {
      "uid": "zhcn:3a310a78b32d76bbfbacb1b6",
      "kind": "character_system_text",
      "source_text": "弹性也太好了吧。\r\n多亏如此，在舞台上也很好活动。",
      "source_fingerprint": "9e372e31498a055cbd703b421c0c97bb0cc66ae785bab9710963fe0f5be2aef9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70014"
      ]
    },
    {
      "uid": "zhcn:ab2bc324861dcc42d8f374a1",
      "kind": "character_system_text",
      "source_text": "这是专属于我的服装，不会让其他人穿。\r\n──跟尺寸无关喔！？",
      "source_fingerprint": "5b1c3a815a98ba9e9b476febe989b1d9f180af4a3616d32f79beef8678adab87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70015"
      ]
    },
    {
      "uid": "zhcn:b6560e0bb6e4d32e09cd57fc",
      "kind": "character_system_text",
      "source_text": "这身打扮怎么样？\r\n很像只要崇拜我就会受保佑吧？",
      "source_fingerprint": "93c7276faf5296372fed592f02b4cd4dabab894f7a5cf697bb840dfdc43475ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70016"
      ]
    },
    {
      "uid": "zhcn:83b0c4024486e1a660402721",
      "kind": "character_system_text",
      "source_text": "不小心靠太近可是会被电得发麻喔！\r\n说笑的啦！",
      "source_fingerprint": "9eb7e7650ee7b66ce508271be8cab8a20fa36e786e45f8841458f7f25de4371a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70017"
      ]
    },
    {
      "uid": "zhcn:ac806c0be91b09b8aa280270",
      "kind": "character_system_text",
      "source_text": "怎么样？这样也不错吧！",
      "source_fingerprint": "104d757b7f4c584fffbdce3d3f958ef514007810cf69b4533de07fd3eb16d694",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70018"
      ]
    },
    {
      "uid": "zhcn:268ed54dded97e892726b3ef",
      "kind": "character_system_text",
      "source_text": "好啊，就去跑一场吧！",
      "source_fingerprint": "f14b0fb64629c555946c5cb641cf00611f873148e37db02fee97b68fdc740636",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70019"
      ]
    },
    {
      "uid": "zhcn:a81bc042deb7ccf6a217f8f8",
      "kind": "character_system_text",
      "source_text": "着替えたで～どっか出かけるん？",
      "source_fingerprint": "53d0f0a18a030b6f583db756f2dbaaf8c8f63b39fc8bf2eaf916edd85b2088aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70020"
      ]
    },
    {
      "uid": "zhcn:deff6742d225ec4c53d087e3",
      "kind": "character_system_text",
      "source_text": "買うた時はもっと背ぇ伸びると\r\n思っとったんやけどな…。",
      "source_fingerprint": "b62f0994f8ca8e39ef0bcc95abcaea72e11fa559bc252e195a5377484e6c5904",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70021"
      ]
    },
    {
      "uid": "zhcn:b0435da836d3987d350ca124",
      "kind": "character_system_text",
      "source_text": "以日常服装来说还真讲究啊～\r\n要是在我老家，这就算是最棒的衣服咯。",
      "source_fingerprint": "4cb196617db59c4cf8ea4e714f97876103723a2838e612eb5be0c012bd46b8c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71004"
      ]
    },
    {
      "uid": "zhcn:0a4fa53d7d99a6d19cc273d1",
      "kind": "character_system_text",
      "source_text": "哎呀～光是能穿上这么豪华的服装，\r\n就不枉费我努力跑步了，认真的。",
      "source_fingerprint": "a0481837acf6172ad7c9744d3b894deb82c41b830d2852fe8e54b6103a11e692",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71008"
      ]
    },
    {
      "uid": "zhcn:c33d49db5fe721775acd9563",
      "kind": "character_system_text",
      "source_text": "「白色闪电」登场！\r\n……嘿嘿，很有型对吧？",
      "source_fingerprint": "01e0176cab83cde4b2407bd1633fc935dc126d709f6d2059edb62427da9e1313",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71009"
      ]
    },
    {
      "uid": "zhcn:929cc7b99ca5cdff2b682535",
      "kind": "character_system_text",
      "source_text": "用旧的物品居然可以换成新的。\r\n……特雷森学园也太猛了吧。",
      "source_fingerprint": "ad34115189244782b18efa4af99efa74c0622d7a44af88eac38709db63b601c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71010"
      ]
    },
    {
      "uid": "zhcn:4e71ba41c8391c2cef882577",
      "kind": "character_system_text",
      "source_text": "弹性也太好了吧。\r\n多亏如此，在舞台上也很好活动。",
      "source_fingerprint": "9e372e31498a055cbd703b421c0c97bb0cc66ae785bab9710963fe0f5be2aef9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71014"
      ]
    },
    {
      "uid": "zhcn:3cad3d540c06b5cc1948f98f",
      "kind": "character_system_text",
      "source_text": "这是专属于我的服装，不会让其他人穿。\r\n──跟尺寸无关喔！？",
      "source_fingerprint": "5b1c3a815a98ba9e9b476febe989b1d9f180af4a3616d32f79beef8678adab87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71015"
      ]
    },
    {
      "uid": "zhcn:449a3caab6c3a12416ac9a25",
      "kind": "character_system_text",
      "source_text": "这身打扮怎么样？\r\n很像只要崇拜我就会受保佑吧？",
      "source_fingerprint": "93c7276faf5296372fed592f02b4cd4dabab894f7a5cf697bb840dfdc43475ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71016"
      ]
    },
    {
      "uid": "zhcn:8089823e2c140b4fbd3ea318",
      "kind": "character_system_text",
      "source_text": "不小心靠太近可是会被电得发麻喔！\r\n说笑的啦！",
      "source_fingerprint": "9eb7e7650ee7b66ce508271be8cab8a20fa36e786e45f8841458f7f25de4371a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71017"
      ]
    },
    {
      "uid": "zhcn:17d013e4a9bf0344332ad4e3",
      "kind": "character_system_text",
      "source_text": "怎么样？这样也不错吧！",
      "source_fingerprint": "104d757b7f4c584fffbdce3d3f958ef514007810cf69b4533de07fd3eb16d694",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71018"
      ]
    },
    {
      "uid": "zhcn:419b7b24da39ccf3eb680043",
      "kind": "character_system_text",
      "source_text": "好啊，就去跑一场吧！",
      "source_fingerprint": "f14b0fb64629c555946c5cb641cf00611f873148e37db02fee97b68fdc740636",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "71019"
      ]
    },
    {
      "uid": "zhcn:908701a77194b113a25e3468",
      "kind": "character_system_text",
      "source_text": "辛苦咯",
      "source_fingerprint": "4de56a033b1c5067e8eaeb2c516b716cf2300b569e4d10e945d3374069551549",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "80000"
      ]
    },
    {
      "uid": "zhcn:a9d9d1ad6820e8ecfa7b1a36",
      "kind": "character_system_text",
      "source_text": "おっ、やるか？\r\nええで、胸貸したるわ！",
      "source_fingerprint": "4bf0a0e1e64b63f05c27a031468b6ff8bb786e4f601e92631aa1b9195f287d25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "81000"
      ]
    },
    {
      "uid": "zhcn:db35c11e87157f1c4daf7597",
      "kind": "character_system_text",
      "source_text": "やるやん！よっしゃ、\r\nウチも気合い入れてくで！",
      "source_fingerprint": "5e304731c2d195b3d4dbe380af67491b30a48a1e44ab1562ebcde9b71f3f8a05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "81001"
      ]
    },
    {
      "uid": "zhcn:e326e965f987fe4662274662",
      "kind": "character_system_text",
      "source_text": "早安啊！\r\n今天也要从早开始全力以赴！\r\n你要好好跟上我喔！",
      "source_fingerprint": "6380c9c308c527ab64d0deeb627568cd11d59c7aed96a47dd1b0b03e4d37e641",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90000"
      ]
    },
    {
      "uid": "zhcn:1a38d1f02bcb8190832cba52",
      "kind": "character_system_text",
      "source_text": "帮我准备早餐，我真的很高兴……\r\n但唯独纳豆……！\r\n唯独那黏黏的口感……！",
      "source_fingerprint": "821a96935b7bc430d4862637c7fa8d580760749b28c2440dfccf39431fc4aa1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90001"
      ]
    },
    {
      "uid": "zhcn:1ae4f9bfc97e7067b5e4940a",
      "kind": "character_system_text",
      "source_text": "状况怎么样？吃过午饭了吗？\r\n不动动身体，小心变猪喔！\r\n人家是这么说的啦，啊哈哈！",
      "source_fingerprint": "804a2bfa12d7342459a91c0262f903db37bfeda112efe66ce08063f7785f351e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90002"
      ]
    },
    {
      "uid": "zhcn:b69139731dcd326dd38b59c3",
      "kind": "character_system_text",
      "source_text": "你有看到小栗午餐的份量吗……？\r\n唔唔……光是回想起来，\r\n肚子就饱得不得了……",
      "source_fingerprint": "4f9bae6d246b52e622cab0bea5d37d77226a0c765491ddbe4babcb35559167ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90003"
      ]
    },
    {
      "uid": "zhcn:4c38f87001dfc5c46db79752",
      "kind": "character_system_text",
      "source_text": "呼哇……你也忙到太晚了吧。\r\n真拿你没办法，就陪陪你吧──\r\n呼哇……",
      "source_fingerprint": "26ebe1a335084b06d42e8d4d2ffdab4850d43cb7853ad887b90685b87e0d11ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90004"
      ]
    },
    {
      "uid": "zhcn:65bbd44c06b6058de4cd0973",
      "kind": "character_system_text",
      "source_text": "我很习惯在深夜被吵起来。\r\n毕竟我都要照顾那些\r\n不是大哭就是吵闹的小不点嘛！",
      "source_fingerprint": "53fe2ab45634d4d4c41e3802f05f2fcb9d0c140cf27090ffb397fee52b72f8df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90005"
      ]
    },
    {
      "uid": "zhcn:ce538f6d0093e23f98154e09",
      "kind": "character_system_text",
      "source_text": "到了身体测量的时期了呢……\r\n我绝不想输给稻荷……！\r\n我可是人小志气高……！！",
      "source_fingerprint": "04fcc5de5af7e7aa446ea6ba237799d10f7045aba2cc87cbb507ae473dc2c1de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90006"
      ]
    },
    {
      "uid": "zhcn:e4224dd8b80d811c3653fc7c",
      "kind": "character_system_text",
      "source_text": "校舍跟宿舍总是开着冷气对吧？\r\n电费……大概多少钱啊？\r\n这问题让我超～～好奇的……",
      "source_fingerprint": "f52347ead499828d586009a93729c53c393e6a8485cb2eb80bf6ccc6db4630dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90007"
      ]
    },
    {
      "uid": "zhcn:8f02e7882cff8d00bcd8ae59",
      "kind": "character_system_text",
      "source_text": "我以前很常捡银杏喔。\r\n现在看到也会忍不住捡起来──\r\n不……实际上有时候就是会跑去捡。",
      "source_fingerprint": "2b46919004b2419f2d21d1094c309a2d485580ff50282c99264887f6a300b79e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90008"
      ]
    },
    {
      "uid": "zhcn:dc4fa74cc85ad86d18c4e800",
      "kind": "character_system_text",
      "source_text": "在老家时即使拿出暖炉桌，\r\n也不会插电。\r\n只要大家都进去就很暖，这样才省！",
      "source_fingerprint": "a43a30cd6e0048e285966c6c6e1274ecd14094a0a1081defcc71f15438b9a904",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90009"
      ]
    },
    {
      "uid": "zhcn:e990f4c101529be17de0cd88",
      "kind": "character_system_text",
      "source_text": "真是清爽的早上啊！\r\n今天也辛苦啦！\r\n得诚心感谢太阳公公才行！",
      "source_fingerprint": "c4792f28b0dc184d425800b19d41d687784535439c3836a259be6a7bcea9416d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90010"
      ]
    },
    {
      "uid": "zhcn:c32c7685e4be5c9d2c9dba66",
      "kind": "character_system_text",
      "source_text": "起个大早去神社散步，\r\n总觉得会让人精神为之一振呢，\r\n你也试看看吧。",
      "source_fingerprint": "34ca3202eea8aae0837d3111af59527039fae51cc8998538011baea0cd9a027b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90011"
      ]
    },
    {
      "uid": "zhcn:7f88d2016e27fa5049e72604",
      "kind": "character_system_text",
      "source_text": "就说我胃口不大了，\r\n餐厅还老爱给我超大份量的餐……\r\n是当作在拜拜吗……？",
      "source_fingerprint": "e438fe2e916db3e7d48ef06431cf1c60e3f4762b2d533ec6f5f099e97d4bb416",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90012"
      ]
    },
    {
      "uid": "zhcn:0557cca5df10ceda866bce56",
      "kind": "character_system_text",
      "source_text": "吃饭前有先说「我要开动了」吗？\r\n对一切抱着感恩的心是很重要的喔！",
      "source_fingerprint": "3de3922a00c6fb6c5e8cf3d46a7fda8654ca0b2a4b55dc9e790ccc0471e2afc6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90013"
      ]
    },
    {
      "uid": "zhcn:b9f0bf818a9d5fe361bab180",
      "kind": "character_system_text",
      "source_text": "忙到这么晚真是辛苦啦！\r\n有困难时就是要互相帮助！\r\n如果有我能做的，我会奉陪到底喔！",
      "source_fingerprint": "4b036e4d5a7acb7e27b73c67575d96d194868189751966796b4f5bf2614f2f54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "90014"
      ]
    }
  ]
}
