      ]
    },
    {
      "uid": "zhcn:f867b35636d6f5c3a4d546b2",
      "kind": "character_system_text",
      "source_text": "ニホンのお月見グルメ、とっても\r\nデリシャス！お月見ハンバーガー、\r\n故郷に持って帰りたいデース！",
      "source_fingerprint": "a956aaba94afacb93ff4d73bcae72ecf0952ca624530829c71203d54a2981fd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
