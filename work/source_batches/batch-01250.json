      ]
    },
    {
      "uid": "zhcn:3b4f198dcf4c39e4804d24a3",
      "kind": "character_system_text",
      "source_text": "ヤッフー！お月見最高デス！\r\nいっぱい食べてお月様のウサギサン\r\nみたいに、力持ちになりまショー！",
      "source_fingerprint": "bfa9fdb38190fd1b9c57b4ba0f98828d2aca102e7a7fef30352d36047c09e36b",
      "source_path": "character_system_text_dict.json",
