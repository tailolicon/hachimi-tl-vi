      ]
    },
    {
      "uid": "zhcn:3ea19cd560adc6977b734f3b",
      "kind": "character_system_text",
      "source_text": "虽然背面也不错啦……呜呜～",
      "source_fingerprint": "8528a4863ec1025cbd3ec1dea5eddd708298523da7956c1a6d4aef10121a5537",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
