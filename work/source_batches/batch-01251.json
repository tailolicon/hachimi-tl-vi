      ]
    },
    {
      "uid": "zhcn:112f69b6b0c4940d1dc63884",
      "kind": "character_system_text",
      "source_text": "还差一点就到最佳位置了！",
      "source_fingerprint": "7ece6c71af72a153928be9981836f9386a29016de243cff93378dc0066389bbf",
      "source_path": "character_system_text_dict.json",
