      ]
    },
    {
      "uid": "zhcn:377c8a2c6832e594e7ded594",
      "kind": "character_system_text",
      "source_text": "やりましょう！",
      "source_fingerprint": "cad7852a5c5aeec01aa0c9c47d3ea898f960f2e81840032e46be93a5edfd526c",
      "source_path": "character_system_text_dict.json",
