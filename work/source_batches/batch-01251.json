      ]
    },
    {
      "uid": "zhcn:ba1e3b939b2fc76dd5afbec5",
      "kind": "character_system_text",
      "source_text": "我吃饱了！",
      "source_fingerprint": "9885a3615f9d018bb9eb01b1e327a40ef9ca4ed64b41d698a006cc70f74d86b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
