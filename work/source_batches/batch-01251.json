      ]
    },
    {
      "uid": "zhcn:aafdd3d7e7d02758056ee2b9",
      "kind": "character_system_text",
      "source_text": "咿～～～！！感谢这样的幸福～～～！！",
      "source_fingerprint": "79cf0e37d57aa35a0addfa57bd702282149cb8302283ef35f37c525fbb35c4ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
