      ]
    },
    {
      "uid": "zhcn:918f9bada679e56ba2560461",
      "kind": "character_system_text",
      "source_text": "这角度不错！",
      "source_fingerprint": "a08e62def92819ab393a39a624f72a36c16d8b3913d2a0dcf6096eb3e0502bb4",
      "source_path": "character_system_text_dict.json",
