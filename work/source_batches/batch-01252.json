      ]
    },
    {
      "uid": "zhcn:3efd0702591c4eb55597d4e3",
      "kind": "character_system_text",
      "source_text": "悉听尊命～♪",
      "source_fingerprint": "71c24d63fedfa86ffebd305b55f8efbb87d012b7a25197979079593fd7fab90a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
