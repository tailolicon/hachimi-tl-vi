      ]
    },
    {
      "uid": "zhcn:fa513df5ccba14bb268206f6",
      "kind": "character_system_text",
      "source_text": "真是激动呀～♪",
      "source_fingerprint": "d2110d5ff4afe3735cc9b378f222b7a09510ccc6160a0e3f3c48c3d0dee4e3ea",
      "source_path": "character_system_text_dict.json",
