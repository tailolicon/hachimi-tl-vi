        "20042"
      ]
    },
    {
      "uid": "zhcn:deef2128ad28720d8c2698dd",
      "kind": "character_system_text",
      "source_text": "哎呀……",
      "source_fingerprint": "aa590602b03384649277b084cd36d881d4f24707abf056fd0a939443d6e5c4fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "20043"
      ]
    },
    {
      "uid": "zhcn:4891c981d46c3bb229b31667",
      "kind": "character_system_text",
      "source_text": "准备出发！",
      "source_fingerprint": "eba17e18672656e52f2dc4ae0ff3b23c9b0add940fdb825744a32fbf39c75d72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f2e68b31580589ea5886fb61",
      "kind": "character_system_text",
      "source_text": "喔，不错嘛。",
      "source_fingerprint": "0c11619192c109efa4f812bfd9a28420eb46e00a31515321a03ad0b3c658902e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0f6658b5e34f3eca6811fd1f",
      "kind": "character_system_text",
      "source_text": "你的表现也挺精彩的！",
      "source_fingerprint": "4e2e265c6ed156b30daa4ba5c2742fc669a7340594ff800d53c456c34735af6e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "20049"
      ]
    },
    {
      "uid": "zhcn:7b31907e90ca338be7931189",
      "kind": "character_system_text",
      "source_text": "感谢你，训练员。",
      "source_fingerprint": "1ec466b65a159d53264b8907bada3a2efe5c80a8fb3a6f403655ff603e261cbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "20050"
      ]
    },
    {
      "uid": "zhcn:53db894d0ca8f65ea0e9976f",
      "kind": "character_system_text",
      "source_text": "我们一起成长吧！",
      "source_fingerprint": "d1b7bd71625cb1552f45befa673174a928d38fd362ff601652d1545bcc5f59e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "20051"
      ]
    },
    {
      "uid": "zhcn:701776d62f29ec77b69c4fa4",
      "kind": "character_system_text",
      "source_text": "华丽地出征吧！",
      "source_fingerprint": "dae79e96aca6616af46e02ede7bc36465695181a7c4b30ad0d6fe1fa1cbee468",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "2030"
      ]
    },
    {
      "uid": "zhcn:9ea1b72f4acbee259168fa01",
      "kind": "character_system_text",
      "source_text": "跟我来吧！",
      "source_fingerprint": "53c4cf22924f9ad91dbed0dd624d9d154868110d944c770e2136af840b478b5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "2031"
      ]
    },
    {
      "uid": "zhcn:31448970f724ac20c38a79fa",
      "kind": "character_system_text",
      "source_text": "感谢你，训练员。",
      "source_fingerprint": "1ec466b65a159d53264b8907bada3a2efe5c80a8fb3a6f403655ff603e261cbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "2032"
      ]
    },
    {
      "uid": "zhcn:91c942b2ed309300c01cc68d",
      "kind": "character_system_text",
      "source_text": "状况真不错。\r\n让我们去掌握灿烂的胜利吧！",
      "source_fingerprint": "bf3d2230babb3ba7f131296c07b92ef52e8631c9760f076050996dc8d234f4e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "2033"
      ]
    },
    {
      "uid": "zhcn:f6463c7b7ef06891bdb6cd83",
      "kind": "character_system_text",
      "source_text": "要用一句话形容现在的我，\r\n没错……就是完美无缺！！",
      "source_fingerprint": "3a126c55fc69e00d24480a324a562a1132d9ebe6707f560cc6a7486f9585800b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "2034"
      ]
    },
    {
      "uid": "zhcn:38f84e804103d971d9ccd437",
      "kind": "character_system_text",
      "source_text": "感谢你，训练员。",
      "source_fingerprint": "1ec466b65a159d53264b8907bada3a2efe5c80a8fb3a6f403655ff603e261cbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "2035"
      ]
    },
    {
      "uid": "zhcn:f833cf4f9b3e3f7034ff27b9",
      "kind": "character_system_text",
      "source_text": "始めよう！",
      "source_fingerprint": "2c28d8c17e90bdb78b07f71914dd1c96c0080d88f35e7f8a8a57add7f9b4925c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "23015"
      ]
    },
    {
      "uid": "zhcn:d0355cd0a76c2e458c6475e8",
      "kind": "character_system_text",
      "source_text": "我的光芒应该没有被盖过吧？",
      "source_fingerprint": "0ad9847a0e3d0be6c459fc9c625058eb78b2923acac8e50b6a33340a14921413",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30000"
      ]
    },
    {
      "uid": "zhcn:bb0eba893fae545b0a088298",
      "kind": "character_system_text",
      "source_text": "没问题，只要能在下次活用就行了。",
      "source_fingerprint": "38b823c52d790cc265fcdddef2c0a1b09ada8558e2d0dab0a781b01a4930062f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30001"
      ]
    },
    {
      "uid": "zhcn:346e57368aa6635eab908da3",
      "kind": "character_system_text",
      "source_text": "我可不会就此满足。",
      "source_fingerprint": "4bb5c1e1dfde5358ec24de82fc98dfdef355dfc1a79a3897533bf1b47f7071cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30002"
      ]
    },
    {
      "uid": "zhcn:e2bad14109b56032382230d8",
      "kind": "character_system_text",
      "source_text": "「霸王」随时都要面对考验的意思吗……",
      "source_fingerprint": "35c6ddb451b8c47650337f8141a97cf6e3930ea9bc5073d41c8d3c41c53cac82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30003"
      ]
    },
    {
      "uid": "zhcn:fe339a08bedcb3c7c74709b9",
      "kind": "character_system_text",
      "source_text": "呵呵呵……我就是最强的！",
      "source_fingerprint": "eecb21f77e41637504f0974412cf0d29ff93ad2ee7a22d40c7f08ef704b24b8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30004"
      ]
    },
    {
      "uid": "zhcn:5e49ea8cc95956afb790bb3e",
      "kind": "character_system_text",
      "source_text": "嗯嗯……这是理所当然的结果！",
      "source_fingerprint": "36280cf1737fbd50bf01d8c3e50949918dfe582e9dab2cbf22c7ab51e3888902",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30005"
      ]
    },
    {
      "uid": "zhcn:a5dffa5f51f7baf80f6c0833",
      "kind": "character_system_text",
      "source_text": "哈──哈哈哈！\r\n我比疾风更快，将春天带来咯！",
      "source_fingerprint": "146eb7674276439b32ced7e11d01d685df56b6e0db336ece27dd7fb0b3bc17d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30006"
      ]
    },
    {
      "uid": "zhcn:6c986fe2ea03913e45b76d9f",
      "kind": "character_system_text",
      "source_text": "嗯嗯……这是理所当然的结果！",
      "source_fingerprint": "36280cf1737fbd50bf01d8c3e50949918dfe582e9dab2cbf22c7ab51e3888902",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "30007"
      ]
    },
    {
      "uid": "zhcn:d8d33e37b34ae583ca1a6def",
      "kind": "character_system_text",
      "source_text": "上场吧！",
      "source_fingerprint": "b33a254fab11bd5c13f77a29969e0a73f385063bb77b92a7f940b8106c726ed7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d0a591e5b6bda3997dfc1f45",
      "kind": "character_system_text",
      "source_text": "排除黑暗……引导至光芒！",
      "source_fingerprint": "10780db1d09459714cb8f08957df44001f3e15917d81b51004eb6b684e9bdba4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "40000"
      ]
    },
    {
      "uid": "zhcn:3386c7fe097423709f58b176",
      "kind": "character_system_text",
      "source_text": "哈──哈哈哈！\r\n看啊，我这个霸王的华丽跑法！\r\n尽管崇拜我吧！",
      "source_fingerprint": "c2ac6149f58c927ab227bf1dd78987c6a9d9f9d53b4e0465bb44c1d115aadfa9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "400006"
      ]
    },
    {
      "uid": "zhcn:9b45b3af49a238d5a068855c",
      "kind": "character_system_text",
      "source_text": "无论是……何种黑暗阻挡在前……\r\n喝！我都会绽放光芒的！",
      "source_fingerprint": "7808fe3523f662bb8a808dcea0cadbefbf288fa0d4e6ac6632ea12b53a31f41c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "40001"
      ]
    },
    {
      "uid": "zhcn:c048b88d02c93321f791d0e6",
      "kind": "character_system_text",
      "source_text": "怎么样啊！\r\n这就是开辟霸王值得庆贺的\r\n新年与新时代的一幕！",
      "source_fingerprint": "2d6ca0451af902b3658eceb725cd8e1464db42189f0b6162a39f74baabc56ef6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "400011"
      ]
    },
    {
      "uid": "zhcn:6505074fa59c2b7eec8bc1f0",
      "kind": "character_system_text",
      "source_text": "一飞冲天吧！要比日出还高！",
      "source_fingerprint": "68c462ffbe98e816f68ae3a29c85d539803f695649c69888697087897f992630",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "40003"
      ]
    },
    {
      "uid": "zhcn:f313f602a68a181cb80531a0",
      "kind": "character_system_text",
      "source_text": "宝船出航吧！啊啊！我这个太阳一飞冲天！\r\n新年快乐────！",
      "source_fingerprint": "58e8ccc03ca3de559091f3754983165d4825eb31b603dacbca0f00e924e3cb88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "40004"
      ]
    },
    {
      "uid": "zhcn:06b6dac0cfc3bd14bca4b596",
      "kind": "character_system_text",
      "source_text": "好了，陶醉在我的光芒之中吧！",
      "source_fingerprint": "56a958d6e74f3e59d3975ebe86aac5ee3c0da5a1a2eca2a19088890f3d24a172",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "60000"
      ]
    },
    {
      "uid": "zhcn:228f30af44dad2037d1a7b16",
      "kind": "character_system_text",
      "source_text": "至高无上的时光将要揭幕了！",
      "source_fingerprint": "00f18d0f2ad1bf428b29677c749bddb4733a10849bd0ad532da1d50f863c1678",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "60001"
      ]
    },
    {
      "uid": "zhcn:b8976fb6484f5f4d38d1d60a",
      "kind": "character_system_text",
      "source_text": "今后也继续看着我缔造传说吧。",
      "source_fingerprint": "861618711cc0b8eeed3783acfbf07717f95aa4c18e793da18fafd8b8e78877a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70000"
      ]
    },
    {
      "uid": "zhcn:0729e103eb4370521633f135",
      "kind": "character_system_text",
      "source_text": "如今回想起来……\r\n和你的相遇就是\r\n一切命运的开端吧。",
      "source_fingerprint": "c5c86118fc9c5c9a6452976bc651aba3c4d26acd2d977726b255dac0b4be9cae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70001"
      ]
    },
    {
      "uid": "zhcn:9d7550506546d68edcafba15",
      "kind": "character_system_text",
      "source_text": "这套服装相当适合学园这个舞台。",
      "source_fingerprint": "5c874ab58330495445492f615613b794d0aedfe6fa39e7e42842b94d7c447745",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70004"
      ]
    },
    {
      "uid": "zhcn:e1900e0ecab3be60f0c56988",
      "kind": "character_system_text",
      "source_text": "啊啊，我听见了……观众在呼唤我的声音！",
      "source_fingerprint": "f39923c5efea5b1a0660f5c81c5b51d47228f1001447d0b89fb16dc7a8da9b69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70008"
      ]
    },
    {
      "uid": "zhcn:3bfc513ce4abf4663ce92f5b",
      "kind": "character_system_text",
      "source_text": "好好见识一下「霸王」的光辉吧！",
      "source_fingerprint": "ff8a38ff2a29c4f5e973d84c985012788f2cf3f69ad2ee618d94b7ec54c0f866",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70009"
      ]
    },
    {
      "uid": "zhcn:4ea026aa951131c9f320e020",
      "kind": "character_system_text",
      "source_text": "不管穿什么服装都耀眼动人……\r\n啊啊，我实在太可怕了！",
      "source_fingerprint": "4c64b918d5ab18118abe85980dfa7dd2f6c2064f8f4dfcb9649949297a591499",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70010"
      ]
    },
    {
      "uid": "zhcn:0d94ad56ae4c842a748a7f37",
      "kind": "character_system_text",
      "source_text": "不论是什么样的舞台，\r\n最耀眼的人都会是我！",
      "source_fingerprint": "a412121fb3e7f6b359920a457a7eb3e3da70ea5d26c7c4068dd5f521fcd86e44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70014"
      ]
    },
    {
      "uid": "zhcn:c35890fe79cfed58a12550f5",
      "kind": "character_system_text",
      "source_text": "你要当心一点，\r\n以免被闪瞎了双眼……！",
      "source_fingerprint": "58d6e8122cdbe18b3cc8678212d1b176e0395de36eedb638a90794b6b4a46b74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70015"
      ]
    },
    {
      "uid": "zhcn:649a30f1b4a44d16762fb4e6",
      "kind": "character_system_text",
      "source_text": "嗯，穿上和服的我也很华丽……！",
      "source_fingerprint": "2a3f83c8935539e27ba735a73676e686dcc53a915005add62b6ecb8b5266357b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70016"
      ]
    },
    {
      "uid": "zhcn:b46c4ebc353cbf0dc109fe9e",
      "kind": "character_system_text",
      "source_text": "喔，你是在祈求霸王的保佑吗？",
      "source_fingerprint": "6d21b41123bab827844e364440f09e44b56e444a943c965e9f4ca957e14ed09f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70017"
      ]
    },
    {
      "uid": "zhcn:886fef519e3bada412519007",
      "kind": "character_system_text",
      "source_text": "我真是太美了……！！",
      "source_fingerprint": "a809b44f254bdf7920178113d2f186d4ede0a7b994da93cb4c53ac1c2eaaa2ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70018"
      ]
    },
    {
      "uid": "zhcn:b28a06eeb2a8bd63e3151209",
      "kind": "character_system_text",
      "source_text": "好好见识一下「霸王」的实力吧！",
      "source_fingerprint": "feae9844a7a172e64ee1a97c80044aee14f6ddbf08d22be7b8ba87dff4a9a0a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70019"
      ]
    },
    {
      "uid": "zhcn:b6a37ba0a96198bff846b735",
      "kind": "character_system_text",
      "source_text": "早着替えは主役の嗜みさ！",
      "source_fingerprint": "5de547f08c11d9b4944c4e5689c9ddda792b9a159155ed37457fd164ce069d68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70020"
      ]
    },
    {
      "uid": "zhcn:eeb6c8bbeda60dbd79b2f375",
      "kind": "character_system_text",
      "source_text": "どの道もボクが歩けば花道さ！",
      "source_fingerprint": "9449ad648a2254f564138394159753689dedf8df3fba5cbc88e2f569b685c5d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "70021"
      ]
    },
    {
      "uid": "zhcn:47d652e573c93ead65998a61",
      "kind": "character_system_text",
      "source_text": "这套服装相当适合学园这个舞台。",
      "source_fingerprint": "5c874ab58330495445492f615613b794d0aedfe6fa39e7e42842b94d7c447745",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71004"
      ]
    },
    {
      "uid": "zhcn:1085c1a252d4f807c31d4ad4",
      "kind": "character_system_text",
      "source_text": "啊啊，我听见了……观众在呼唤我的声音！",
      "source_fingerprint": "f39923c5efea5b1a0660f5c81c5b51d47228f1001447d0b89fb16dc7a8da9b69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71008"
      ]
    },
    {
      "uid": "zhcn:6d31b1938d7e7670017c3815",
      "kind": "character_system_text",
      "source_text": "好好见识一下「霸王」的光辉吧！",
      "source_fingerprint": "ff8a38ff2a29c4f5e973d84c985012788f2cf3f69ad2ee618d94b7ec54c0f866",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71009"
      ]
    },
    {
      "uid": "zhcn:5b3d74b636530c474899ef8b",
      "kind": "character_system_text",
      "source_text": "不管穿什么服装都耀眼动人……\r\n啊啊，我实在太可怕了！",
      "source_fingerprint": "4c64b918d5ab18118abe85980dfa7dd2f6c2064f8f4dfcb9649949297a591499",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71010"
      ]
    },
    {
      "uid": "zhcn:cf4687d6e4a51c51921b84f1",
      "kind": "character_system_text",
      "source_text": "不论是什么样的舞台，\r\n最耀眼的人都会是我！",
      "source_fingerprint": "a412121fb3e7f6b359920a457a7eb3e3da70ea5d26c7c4068dd5f521fcd86e44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71014"
      ]
    },
    {
      "uid": "zhcn:7548c117f9a2ea96290ce238",
      "kind": "character_system_text",
      "source_text": "你要当心一点，\r\n以免被闪瞎了双眼……！",
      "source_fingerprint": "58d6e8122cdbe18b3cc8678212d1b176e0395de36eedb638a90794b6b4a46b74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71015"
      ]
    },
    {
      "uid": "zhcn:e41520c5cc85b058a89678c6",
      "kind": "character_system_text",
      "source_text": "嗯，穿上和服的我也很华丽……！",
      "source_fingerprint": "2a3f83c8935539e27ba735a73676e686dcc53a915005add62b6ecb8b5266357b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71016"
      ]
    },
    {
      "uid": "zhcn:8b835dce2caec7038a758d12",
      "kind": "character_system_text",
      "source_text": "喔，你是在祈求霸王的保佑吗？",
      "source_fingerprint": "6d21b41123bab827844e364440f09e44b56e444a943c965e9f4ca957e14ed09f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71017"
      ]
    },
    {
      "uid": "zhcn:8c53a97a96cde64646e5768e",
      "kind": "character_system_text",
      "source_text": "我真是太美了……！！",
      "source_fingerprint": "a809b44f254bdf7920178113d2f186d4ede0a7b994da93cb4c53ac1c2eaaa2ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71018"
      ]
    },
    {
      "uid": "zhcn:4330b975e6d6efd60d69e79a",
      "kind": "character_system_text",
      "source_text": "好好见识一下「霸王」的实力吧！",
      "source_fingerprint": "feae9844a7a172e64ee1a97c80044aee14f6ddbf08d22be7b8ba87dff4a9a0a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "71019"
      ]
    },
    {
      "uid": "zhcn:2df6f4723ea1826e7dc8b38a",
      "kind": "character_system_text",
      "source_text": "辛苦了",
      "source_fingerprint": "bd96bf364b8b21a3bb94efcf4ef82feb1bc34cf02203524e7949dbd19151dd13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "80000"
      ]
    },
    {
      "uid": "zhcn:4fb8ce17c46d5f7d87f67998",
      "kind": "character_system_text",
      "source_text": "要挑战我是吗？很好，\r\n就让我看看这是真正的勇气，\r\n还是只是愚勇而已吧！",
      "source_fingerprint": "1c6a12a597fd122fb5cac9bd6ec72234e59ef88e747139be4bc86efd05c6d95f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "81000"
      ]
    },
    {
      "uid": "zhcn:57b785a16b5a3669f6acb2ff",
      "kind": "character_system_text",
      "source_text": "很厉害嘛，\r\n但这只是序曲而已。\r\n接下来才是重头戏！",
      "source_fingerprint": "2ac75b3f0b8f6091761f0f04bb5f4dde6418f61c3b9a653d702c70d259abba8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "81001"
      ]
    },
    {
      "uid": "zhcn:38d2b5bbbed746e01af07ddc",
      "kind": "character_system_text",
      "source_text": "我这颗朝阳今天也在照耀大地……\r\n好，熠熠生辉的一天要开始了……！",
      "source_fingerprint": "4a94dc0aaf0bede1145e9b380a39b9876a7dbdcae36cdcb137b269b65191635f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90000"
      ]
    },
    {
      "uid": "zhcn:9516be94b26d8eafe4a69b2e",
      "kind": "character_system_text",
      "source_text": "今天早上的前奏曲已经完成了吗？\r\n……没错，我指的就是早餐。",
      "source_fingerprint": "48c130e16ea6ecb909fcb15ab34a81555df28475030a3c0c7adbb4ea01403779",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90001"
      ]
    },
    {
      "uid": "zhcn:86d2281c2fdeff36a56b0ea3",
      "kind": "character_system_text",
      "source_text": "哈哈哈哈！\r\n这个午后正适合让我\r\n走在霸道上！",
      "source_fingerprint": "c050e93a114c22a7c49f783be02673ae83bdcfd05c572625ec018b7dc096790b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90002"
      ]
    },
    {
      "uid": "zhcn:79cdadb1d28851e56b3d3661",
      "kind": "character_system_text",
      "source_text": "太阳与我，\r\n有两颗恒星在散发光辉……！\r\n啊啊，实在太刺眼了……！！",
      "source_fingerprint": "d09e288309d5e0ccf4432af750dbe7e8d211b82552cdbf9a6d956b71275a193c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90003"
      ]
    },
    {
      "uid": "zhcn:ebb7e2514d36bb1c64c08266",
      "kind": "character_system_text",
      "source_text": "我的光芒在黑夜中会显得更耀眼……\r\n真是抱歉，我太过炫目了……",
      "source_fingerprint": "e6296eb33939e3bb39ea66c6cb42f1181ec04699e83be71777ce4e66ea5ff301",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90004"
      ]
    },
    {
      "uid": "zhcn:a2dccc3832d95444d05345b2",
      "kind": "character_system_text",
      "source_text": "我来唱首歌给你醒醒脑吧。\r\n对了，曲名就叫……\r\n《我与月光的小夜曲》！",
      "source_fingerprint": "4f0145d8121d41afa61a2abdee43731e9654956cf47f921309b25dc89c27ff8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90005"
      ]
    },
    {
      "uid": "zhcn:c41ed1eb8d9620987aafdb86",
      "kind": "character_system_text",
      "source_text": "花坛的花朵传来了甜美的香气。\r\n呵呵，是因为想让我触摸\r\n而散发出芬芳吗？",
      "source_fingerprint": "4fd644b9f60c78de972d86d90dd7403f0be0d65572e5406a212380f54b569d85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90006"
      ]
    },
    {
      "uid": "zhcn:ffed0ad04551ef3bd358da99",
      "kind": "character_system_text",
      "source_text": "居然连飞溅的汗水都如此美丽……！\r\n啊啊，我真是个\r\n罪孽深重的赛马娘……！！",
      "source_fingerprint": "c471988fb52f534f127b355fc56aab06bd811cffc266b10aabcea49d4e59d01f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90007"
      ]
    },
    {
      "uid": "zhcn:26231d757a8f61a96972b8f3",
      "kind": "character_system_text",
      "source_text": "红叶凋谢之际十分优美。\r\n无论如何我都得向它学习──不，\r\n我根本不可能凋零的。哈哈哈！",
      "source_fingerprint": "8d073e0fa90444f70b2bfef9b6f89a4d527dabe10ee5ae2e4a1a266ebd95271e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90008"
      ]
    },
    {
      "uid": "zhcn:fbf72c0743b4926cdc19fe4b",
      "kind": "character_system_text",
      "source_text": "开门的时候我感觉手麻了一下……\r\n是我的光辉终于变成雷光了吗……？",
      "source_fingerprint": "90165c7f141f6a8bbe2224b3f66a1ae6207cf2f22d5fc7ab46f4568a60b2e49c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90009"
      ]
    },
    {
      "uid": "zhcn:8bac39b6e72e7498aed06d55",
      "kind": "character_system_text",
      "source_text": "你有看到今天早上的日出吗？\r\n太阳好像为了成为我背后的吉光，\r\n就匆匆忙忙地早起咯！",
      "source_fingerprint": "9dc6d42d3f67a0bc2d5a4cf1c4dbae0e9b87092de2a728fe710b64b43068d358",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90010"
      ]
    },
    {
      "uid": "zhcn:179fe68ec0ac8ff5b69e38c7",
      "kind": "character_system_text",
      "source_text": "早晨洋溢着玫瑰色光芒！\r\n而我则浑身充满着……\r\n花香跟新年氛围……！",
      "source_fingerprint": "42cbfa5efb7549ea2963963325ceac75e6c187cde442b01928e9fa04fcce6ef4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90011"
      ]
    },
    {
      "uid": "zhcn:ccdc269e480369d90e901ca6",
      "kind": "character_system_text",
      "source_text": "要选年糕还是龙虾……这是个问题。\r\n午餐也得选择豪华菜色，\r\n才配得上现在的我！",
      "source_fingerprint": "4f4f89a876916b5f78c9c3a1bc15efb766f15701622d2079eb59c6a7ee0ab3d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90012"
      ]
    },
    {
      "uid": "zhcn:f75dda1cb0bf152b5c1dda6b",
      "kind": "character_system_text",
      "source_text": "我在元旦立了「要对演唱更加坚持」\r\n这个目标！立刻就为夜晚公演\r\n做发声练习吧！霸～王～♪",
      "source_fingerprint": "3f2679bbd766dbd28e70bd872cbd31d5509574253b8f2d2336234608561811f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90013"
      ]
    },
    {
      "uid": "zhcn:96914147667143740f53eceb",
      "kind": "character_system_text",
      "source_text": "不只是初梦，你知道无论何时\r\n梦到什么是都会是好兆头吗？\r\n一是我！二是我！三是霸王！",
      "source_fingerprint": "a1d706ae2bdd981d3fd691ee48ab9ac1e9d68a25550fd630e9c249285c24b31c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90014"
      ]
    },
    {
      "uid": "zhcn:529371cb4d81de2238fbe46f",
      "kind": "character_system_text",
      "source_text": "通通不准睡……！\r\n不然会错过深夜身穿华服，\r\n亭亭玉立的我……！",
      "source_fingerprint": "5d798c7435d0a3533c8a0b0c157fdf72abe1328fd7b44e97ccba0196d0b65d98",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90015"
      ]
    },
    {
      "uid": "zhcn:df8d97aa3bf4e335e8508ae0",
      "kind": "character_system_text",
      "source_text": "迎新年后过了几天……\r\n春天就来临了呢。不过，只要有我在，\r\n世界永远都是春天就是了！",
      "source_fingerprint": "14e314d950915aac26a80a9bd51249a2a817a4cb4523ae9c0f60e6107ebef943",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90016"
      ]
    },
    {
      "uid": "zhcn:32854e565f6568aabaae1bdf",
      "kind": "character_system_text",
      "source_text": "问我穿冬装会不会太热？\r\n不！只要站在舞台上，\r\n不管何等灼热我都一定会撑住！",
      "source_fingerprint": "e69ac80fd8b24d367c47506449fa9e62a73877278a6e1d41105adc400919c884",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90017"
      ]
    },
    {
      "uid": "zhcn:0a6e1c26e578c7be36f51bb7",
      "kind": "character_system_text",
      "source_text": "这套服装怎么样？\r\n提早反映季节是和服的应有品格……\r\n我也早一步进入了新年氛围！",
      "source_fingerprint": "1079a0ce10432907b9d260da0276d524be3d01ad11181a24d91dab89d473f684",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90018"
      ]
    },
    {
      "uid": "zhcn:7664274650ce30e950fba5c3",
      "kind": "character_system_text",
      "source_text": "看到身穿华服的我，\r\n就会忘了寒冷对吧？\r\n难怪你会如此着迷！",
      "source_fingerprint": "b3741f44bf575679abadeb7e97edbd26b335888961e131c930a7befe846bdb17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90019"
      ]
    },
    {
      "uid": "zhcn:8b519ad67b41d48376e6f163",
      "kind": "character_system_text",
      "source_text": "情人节快乐",
      "source_fingerprint": "9392c70765a5a96081978bc15cd29abd7d78628fdd8840f21389130a9a70469b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90020"
      ]
    },
    {
      "uid": "zhcn:df800c3ba2ed9a25505a5128",
      "kind": "character_system_text",
      "source_text": "情人节快乐",
      "source_fingerprint": "9392c70765a5a96081978bc15cd29abd7d78628fdd8840f21389130a9a70469b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1015",
        "90021"
      ]
    }
  ]
}
