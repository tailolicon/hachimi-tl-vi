    {
      "uid": "zhcn:9a7c5257cbbe30a77a67ed1e",
      "kind": "character_system_text",
      "source_text": "怎么会……！！",
      "source_fingerprint": "9310a563cd7e533607fbcf465a7bd3900697ca4282937c5342dc10e9a384ccf7",
      "source_path": "character_system_text_dict.json",
