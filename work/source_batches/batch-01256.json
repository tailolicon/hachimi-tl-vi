{
  "schema_version": 1,
  "batch": 1256,
  "batch_count": 1682,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "f1c6893d60a8989361cfd9c371f56bc8ec25f81d",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:9f8dd20dcb8a430eebf47ad9",
      "kind": "character_system_text",
      "source_text": "啧……",
      "source_fingerprint": "f067f48da199e272fcff687fcdf4c651840778b12461e92a3b2f3daffefaa1f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20042"
      ]
    },
    {
      "uid": "zhcn:6024ca02de5d0e3749c5f21b",
      "kind": "character_system_text",
      "source_text": "可恶……",
      "source_fingerprint": "ed21a303e5d04ce20dc3019128d0a1b9543f7a003cdb9a3f9ece6e791dcf33a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20043"
      ]
    },
    {
      "uid": "zhcn:e4b22b79b0fa7c083694e5fd",
      "kind": "character_system_text",
      "source_text": "出发了。",
      "source_fingerprint": "cc23146efaa5b9bd82b5ca6bacba270ace6a87e0a701ce2e285077510313307c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f9a48bfcf0d51004120d78d9",
      "kind": "character_system_text",
      "source_text": "……走吧。",
      "source_fingerprint": "14a5831f7940f315e35b7e2b4afa3404611b474084a0e47e055fee99480dba33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20047"
      ]
    },
    {
      "uid": "zhcn:dbd50bdd221dbe151116cfa6",
      "kind": "character_system_text",
      "source_text": "还不错嘛……今后也麻烦你了。",
      "source_fingerprint": "ea5fc24b70b3fd59aa0cf740e9a0bcf06c00a1795a03baa80a32c2a906394ef1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20049"
      ]
    },
    {
      "uid": "zhcn:a400b073360906cc196c573a",
      "kind": "character_system_text",
      "source_text": "……我也算是很感激你的。",
      "source_fingerprint": "014c3298ee8e5ed87daaa46b9b9217a2e22a91c82dd2a93ae612e3660bbf4eb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20050"
      ]
    },
    {
      "uid": "zhcn:68e3d03cea1b1e32aeb4604b",
      "kind": "character_system_text",
      "source_text": "……要比，就拿出全力过来。",
      "source_fingerprint": "7b738d54b70ce466e20cb5468c8d5d5cb8bd5fc70ee2eafc772bdab62970a47a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "20051"
      ]
    },
    {
      "uid": "zhcn:75415d2f28e614f96067b359",
      "kind": "character_system_text",
      "source_text": "我要狩尽一切猎物……！",
      "source_fingerprint": "02f49d3121f1cec7632d911615e09042a9145677fc7d69999b27d294718de55a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "2030"
      ]
    },
    {
      "uid": "zhcn:5d342676fb0a139b946f0ccc",
      "kind": "character_system_text",
      "source_text": "……战斗吧。",
      "source_fingerprint": "2f866fcc5e51565692d6af2a8eac49067047dec7dc999d7278f3a843d0b4cf38",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "2031"
      ]
    },
    {
      "uid": "zhcn:4d5c8c2d2644a470b5b50a04",
      "kind": "character_system_text",
      "source_text": "……我也算是很感激你的。",
      "source_fingerprint": "014c3298ee8e5ed87daaa46b9b9217a2e22a91c82dd2a93ae612e3660bbf4eb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "2032"
      ]
    },
    {
      "uid": "zhcn:83efc972e946b5f2c31edaaa",
      "kind": "character_system_text",
      "source_text": "我只要用实力压倒所有人就行了。",
      "source_fingerprint": "41463c1c1bd9f723e7470ff0bd8857525fa438955e06adf5abed1199c2cc8473",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "2033"
      ]
    },
    {
      "uid": "zhcn:280e2a8747f3c392a49f7e2b",
      "kind": "character_system_text",
      "source_text": "热血沸腾……\r\n对决即将要开始了……！",
      "source_fingerprint": "1a582d7375fb7028f4d175b1bd054014a8f6e88977d26e54a56f8030359a1818",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "2034"
      ]
    },
    {
      "uid": "zhcn:3eb3f14f02c6d02fb478387d",
      "kind": "character_system_text",
      "source_text": "……我也算是很感激你的。",
      "source_fingerprint": "014c3298ee8e5ed87daaa46b9b9217a2e22a91c82dd2a93ae612e3660bbf4eb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "2035"
      ]
    },
    {
      "uid": "zhcn:dd59faff1b6a77c4f8bc720b",
      "kind": "character_system_text",
      "source_text": "行くぞ。",
      "source_fingerprint": "96bd83b0e9e894342bf12c1e7791803a48961af546db047ff8f41cbcdf8bddff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "23015"
      ]
    },
    {
      "uid": "zhcn:db721fcdfebb4be7a7153ca7",
      "kind": "character_system_text",
      "source_text": "……只差一步，没能彻底击垮啊。",
      "source_fingerprint": "18aa6d22be45b0854db25082166a7e830e2481879464e30c5846762db986bfdd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30000"
      ]
    },
    {
      "uid": "zhcn:5cd5e2b26a96f98b32256f4a",
      "kind": "character_system_text",
      "source_text": "……只是这样还无法让我满足。",
      "source_fingerprint": "fd247f0be749349e66aacfaa92d4f82d4fefaa7d206b6e3a89d7f9977ba9ebdf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30001"
      ]
    },
    {
      "uid": "zhcn:d1efa9e6f7b001c559b545e3",
      "kind": "character_system_text",
      "source_text": "这不是值得高兴的结果……",
      "source_fingerprint": "71fc75867d0aba8bc554805fa452b447b35b17e2465a81dc46173713ad86f577",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30002"
      ]
    },
    {
      "uid": "zhcn:32457a950b1cea0a1f753f2e",
      "kind": "character_system_text",
      "source_text": "唔……\r\n这样还不能满足我的欲望……！",
      "source_fingerprint": "6c6cbd9f2c41f9c542cb075bb457e5c97a1d7e466f872e7c03c3809d7d9aad61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30003"
      ]
    },
    {
      "uid": "zhcn:11b3b621b1e1a7481711ec6d",
      "kind": "character_system_text",
      "source_text": "呵……很有趣的一场比赛。",
      "source_fingerprint": "36c87cc9d1df7ac33958b9d6011cc58a7bd66021d38a6834a9ed6d6adcc4dbfb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30004"
      ]
    },
    {
      "uid": "zhcn:3b08f6a38b2c0623fa27bfb8",
      "kind": "character_system_text",
      "source_text": "很好……这就是胜利的滋味。",
      "source_fingerprint": "16adece2ea11e27f3392bf7131de1ae095c68a022ac5715cd4aab4444a8145f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30005"
      ]
    },
    {
      "uid": "zhcn:5552dd68894af3def3d69c73",
      "kind": "character_system_text",
      "source_text": "好了……下一场比赛还没到吗？",
      "source_fingerprint": "87ef908353fd8a21ef3bc400d1a8225055dbfa933b995aa283f793067a4b3425",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30006"
      ]
    },
    {
      "uid": "zhcn:6f0ca2d8274b52138356ad7f",
      "kind": "character_system_text",
      "source_text": "很好……这就是胜利的滋味。",
      "source_fingerprint": "16adece2ea11e27f3392bf7131de1ae095c68a022ac5715cd4aab4444a8145f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "30007"
      ]
    },
    {
      "uid": "zhcn:bf25d04ae50d7f75832ed3aa",
      "kind": "character_system_text",
      "source_text": "……走吧。",
      "source_fingerprint": "14a5831f7940f315e35b7e2b4afa3404611b474084a0e47e055fee99480dba33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "31000"
      ]
    },
    {
      "uid": "zhcn:1cd8150fa2ae390585ef57b4",
      "kind": "character_system_text",
      "source_text": "呼……喝！！",
      "source_fingerprint": "9abef90b47fe4139607b2768139e929102959ca7222abe06633e498b611172cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "40000"
      ]
    },
    {
      "uid": "zhcn:313da710176f064e51a6998d",
      "kind": "character_system_text",
      "source_text": "また親父からの連絡か…。\r\nベースは借りんと何回\r\n伝えたらわかるんだ…。",
      "source_fingerprint": "ec0cf486013b02b353bfbe33bd1960cfaabef4bd9f0130d829116ce9eeb4e053",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400001"
      ]
    },
    {
      "uid": "zhcn:ad495cc8e99537a1ea1194d0",
      "kind": "character_system_text",
      "source_text": "啊啊，可恶……\r\n为什么每次回过神来，\r\n手上都有工作要做……！",
      "source_fingerprint": "aa050847084426e70b3c27ae358e36a89798b1094d5ab2d68e61775139610894",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400002"
      ]
    },
    {
      "uid": "zhcn:c4855c34b97a33610fec06a1",
      "kind": "character_system_text",
      "source_text": "猪肋排、烤牛肉……摊贩的食物\r\n感觉也很美味呢。气槽她……不在。\r\n该从哪一项开始吃呢……",
      "source_fingerprint": "be4314177510842b3ec7751ba6c989bc109b308df008c2290658162adb4a1e14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400004"
      ]
    },
    {
      "uid": "zhcn:84b370762346eecc9cfa29fc",
      "kind": "character_system_text",
      "source_text": "弱くても音がへたれる…\r\n強すぎても弦のビビり音が出る…\r\n加減なしにできる楽器はないのか？",
      "source_fingerprint": "7c4d4979f0eae8ff8256f2aa738f330cb50211e97b365d86fa98f88538366202",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400005"
      ]
    },
    {
      "uid": "zhcn:edc2ece7f803dcb450341e02",
      "kind": "character_system_text",
      "source_text": "「尽情享受」啊……既然你都说了，\r\n可要对自己的话负责喔，\r\n「皇帝」陛下。",
      "source_fingerprint": "1d2eddd604266e591d75797436b98c6426821a736d8a05dd936064d78510cb5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400007"
      ]
    },
    {
      "uid": "zhcn:188b1830772449d23df081dd",
      "kind": "character_system_text",
      "source_text": "这股蠢蠢欲动的感觉……怎么回事？\r\n桂冠，难道你是我的……不，\r\n答案……只会存在于赛场上。",
      "source_fingerprint": "237326e7b8b78e2b4c795c3ff21825f98b4e09552fc031c11808f172b9a0a5f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400008"
      ]
    },
    {
      "uid": "zhcn:6210c86bfcf53762eb2cc508",
      "kind": "character_system_text",
      "source_text": "呼──\r\n呼、呼……散开……！！",
      "source_fingerprint": "3e2968b5f4e883c90e601df32563276b5e23cf233c47216f1f0b5dac565734c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "40001"
      ]
    },
    {
      "uid": "zhcn:a6c09b6e868cb71abd2d2170",
      "kind": "character_system_text",
      "source_text": "アイツらも、自分たちのバンドを\r\nやりきれたみたいだな。\r\n…姉貴も笑って観ていた。",
      "source_fingerprint": "96ec356734f82d14d78b1cac0cb186a769a491958998629611810b5e2c60da30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400010"
      ]
    },
    {
      "uid": "zhcn:102946141e67c869416aaa0c",
      "kind": "character_system_text",
      "source_text": "也把照片传给大姐好了？\r\n……不，还是算了，\r\n她一定会传到家人的LANE群组……",
      "source_fingerprint": "18be35394c5a8fb60ee1cdafde8e2e53216037d8ce0ea4d8cb92e7b09934eee8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "400011"
      ]
    },
    {
      "uid": "zhcn:a434fdba5d3b573222c86830",
      "kind": "character_system_text",
      "source_text": "渴望令我热血沸腾！",
      "source_fingerprint": "acff2212bfef19a01aa78c65187b396a6cfb92a748de1344ed6d95eaad6751e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "40003"
      ]
    },
    {
      "uid": "zhcn:85c7b679dc245b36694bcbf0",
      "kind": "character_system_text",
      "source_text": "阴影、暗夜──在黑暗中徘徊前行，\r\n将渴求化为斗志，横扫四方！",
      "source_fingerprint": "47ca7f591244483de03700fe58b37080833bef489b23266f0330d47c4baf43f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "40004"
      ]
    },
    {
      "uid": "zhcn:7d189f58d87c634d8fa9da25",
      "kind": "character_system_text",
      "source_text": "……要做就要全力以赴。",
      "source_fingerprint": "7ee6ac596e92c0ef7936d3c005ce17e9047b7ca6c6851f96fe947fd0ece90203",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "60000"
      ]
    },
    {
      "uid": "zhcn:a41cfc67b40fefc7824d1e8b",
      "kind": "character_system_text",
      "source_text": "这也算是一种对决吧。",
      "source_fingerprint": "5f37adc6d1657912d10cc821e8d82225ca1988c1e14e15390f83bc131164c40f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "60001"
      ]
    },
    {
      "uid": "zhcn:a1af412a9f38f791312c4885",
      "kind": "character_system_text",
      "source_text": "……已经做好应战的准备了吧？",
      "source_fingerprint": "33163fa0da6b03f9cf85de1572e606a271fed41a05d85cf034849536c981c158",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70000"
      ]
    },
    {
      "uid": "zhcn:6b51ba8d9ac91626cf4130fd",
      "kind": "character_system_text",
      "source_text": "……点燃我斗志的人是你。\r\n你可要好好担起这个责任才行。",
      "source_fingerprint": "68c3ac047be1a0f80ad473bb14f17f1c6d0f783e704a29ef07750c4a3d058878",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70001"
      ]
    },
    {
      "uid": "zhcn:413f747d183d50668840643e",
      "kind": "character_system_text",
      "source_text": "……我常会忘记蝴蝶结，\r\n但没有也没差。",
      "source_fingerprint": "455be9677123b9917c1c7a05dfc12e15b98176dcf3dc0948bad71a49f6d6f13a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70004"
      ]
    },
    {
      "uid": "zhcn:648c6c8df5ab702c554031e9",
      "kind": "character_system_text",
      "source_text": "……要是让我选，我不会选这种衣服。",
      "source_fingerprint": "11a3e10e9ee3aa90669ef5e3e00c0a153b9c8d6f7242cd440be7182bc091b458",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70008"
      ]
    },
    {
      "uid": "zhcn:1db47402b4654f543c65efcf",
      "kind": "character_system_text",
      "source_text": "燃起了我的斗志……！",
      "source_fingerprint": "0eef7abcc922c7b07498d1a27cb831617002038757f42cda47e69b05ee6907ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70009"
      ]
    },
    {
      "uid": "zhcn:990eeb6b74a64492dd7f3800",
      "kind": "character_system_text",
      "source_text": "就不能不要这么多装饰吗……",
      "source_fingerprint": "c1dd7a315c84e3cb8e84ee85378bf90356ecde000d0094f07df1a7904b897a02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70010"
      ]
    },
    {
      "uid": "zhcn:f7bba3161c5029dee3ea2d55",
      "kind": "character_system_text",
      "source_text": "唔，竟然这么花俏……烦死了。",
      "source_fingerprint": "aacc35f2eb4cf41842c00ae6f01b3a9f6d15731f419b6248c7d3764023ace566",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70014"
      ]
    },
    {
      "uid": "zhcn:163bcfd6bf780b5246059dc2",
      "kind": "character_system_text",
      "source_text": "脚的重量……让我感到安心。",
      "source_fingerprint": "81f8bda053a93cb174d09d002c6c66c68d3cbce710b10fe15047bebdf19319bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70015"
      ]
    },
    {
      "uid": "zhcn:6e8100a652f552632c83f3f4",
      "kind": "character_system_text",
      "source_text": "渴望着奔跑而蠢蠢欲动……",
      "source_fingerprint": "ed1821085f97dc4bffa2118507e747bec7108d3e3652e17f0bcf4a09732e2437",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70016"
      ]
    },
    {
      "uid": "zhcn:24d7aed5ff0a062a160ee089",
      "kind": "character_system_text",
      "source_text": "心无旁鹜、贪得无厌。\r\n我就是如此贪求胜利。",
      "source_fingerprint": "8029ca214906e92850dafc14cb819bfeea8fa5d4a1e35a0ee537a9e6df7b5822",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70017"
      ]
    },
    {
      "uid": "zhcn:02056bcba180c0417ee6add0",
      "kind": "character_system_text",
      "source_text": "拉开距离……！",
      "source_fingerprint": "6149abb4aa32b6dadccbb0a4f7cd37d4f0b61524db3253f0812ed6bb47e1cb79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70018"
      ]
    },
    {
      "uid": "zhcn:0c76f56b2c51fce971e418ac",
      "kind": "character_system_text",
      "source_text": "真是吵闹啊……",
      "source_fingerprint": "2b7a8b2d9cfb004306ecb3e850920b3b65e421120f0c7cf5543082688f0c29fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70019"
      ]
    },
    {
      "uid": "zhcn:3b1e064689b94c128eb9d08f",
      "kind": "character_system_text",
      "source_text": "虽然跑起来有点不便，但我并不讨厌。",
      "source_fingerprint": "a4c95acee33058d1d02e70dab56d99647d6a75ad4bbaad421c6a8052b05d08b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70020"
      ]
    },
    {
      "uid": "zhcn:da1623559d5d5cf8618880a6",
      "kind": "character_system_text",
      "source_text": "我比较喜欢长裤。便于行动。",
      "source_fingerprint": "b7ac7d231a54d7d7712b090e8c4abb34e322473d653749afc41c00116cb5aa2f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "70021"
      ]
    },
    {
      "uid": "zhcn:23663d37ba784cd769b08b95",
      "kind": "character_system_text",
      "source_text": "……我常会忘记蝴蝶结，\r\n但没有也没差。",
      "source_fingerprint": "455be9677123b9917c1c7a05dfc12e15b98176dcf3dc0948bad71a49f6d6f13a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71004"
      ]
    },
    {
      "uid": "zhcn:f06de18592faa1c63acfce60",
      "kind": "character_system_text",
      "source_text": "……要是让我选，我不会选这种衣服。",
      "source_fingerprint": "11a3e10e9ee3aa90669ef5e3e00c0a153b9c8d6f7242cd440be7182bc091b458",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71008"
      ]
    },
    {
      "uid": "zhcn:959def76247c9aa5db2b9650",
      "kind": "character_system_text",
      "source_text": "燃起了我的斗志……！",
      "source_fingerprint": "0eef7abcc922c7b07498d1a27cb831617002038757f42cda47e69b05ee6907ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71009"
      ]
    },
    {
      "uid": "zhcn:199be902f4ab93bbe4a6202e",
      "kind": "character_system_text",
      "source_text": "就不能不要这么多装饰吗……",
      "source_fingerprint": "c1dd7a315c84e3cb8e84ee85378bf90356ecde000d0094f07df1a7904b897a02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71010"
      ]
    },
    {
      "uid": "zhcn:a301087ad223f101cfbef2bc",
      "kind": "character_system_text",
      "source_text": "唔，竟然这么花俏……烦死了。",
      "source_fingerprint": "aacc35f2eb4cf41842c00ae6f01b3a9f6d15731f419b6248c7d3764023ace566",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71014"
      ]
    },
    {
      "uid": "zhcn:ef9c1e135f95c2c992a012ff",
      "kind": "character_system_text",
      "source_text": "脚的重量……让我感到安心。",
      "source_fingerprint": "81f8bda053a93cb174d09d002c6c66c68d3cbce710b10fe15047bebdf19319bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71015"
      ]
    },
    {
      "uid": "zhcn:1ebaab04e4e9e8c17dd5695f",
      "kind": "character_system_text",
      "source_text": "渴望着奔跑而蠢蠢欲动……",
      "source_fingerprint": "ed1821085f97dc4bffa2118507e747bec7108d3e3652e17f0bcf4a09732e2437",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71016"
      ]
    },
    {
      "uid": "zhcn:a0cbbfc90b5c5a4ccf359978",
      "kind": "character_system_text",
      "source_text": "心无旁鹜、贪得无厌。\r\n我就是如此贪求胜利。",
      "source_fingerprint": "8029ca214906e92850dafc14cb819bfeea8fa5d4a1e35a0ee537a9e6df7b5822",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71017"
      ]
    },
    {
      "uid": "zhcn:8008c0f3deff42a32ef0fa2f",
      "kind": "character_system_text",
      "source_text": "拉开距离……！",
      "source_fingerprint": "6149abb4aa32b6dadccbb0a4f7cd37d4f0b61524db3253f0812ed6bb47e1cb79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71018"
      ]
    },
    {
      "uid": "zhcn:6e7dffb7ebd870221e470d58",
      "kind": "character_system_text",
      "source_text": "真是吵闹啊……",
      "source_fingerprint": "2b7a8b2d9cfb004306ecb3e850920b3b65e421120f0c7cf5543082688f0c29fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "71019"
      ]
    },
    {
      "uid": "zhcn:808a1274813f41d77d56da93",
      "kind": "character_system_text",
      "source_text": "辛苦了",
      "source_fingerprint": "bd96bf364b8b21a3bb94efcf4ef82feb1bc34cf02203524e7949dbd19151dd13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "80000"
      ]
    },
    {
      "uid": "zhcn:176e4d9fcfaf90dab7744893",
      "kind": "character_system_text",
      "source_text": "…勝負になればいいが。",
      "source_fingerprint": "629352f2fa5839f4d00d47d6b64ab5f9a2072f1f39aaa5184d2596413a0a6916",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "81000"
      ]
    },
    {
      "uid": "zhcn:d83afb90ee19ef7d15cad4a3",
      "kind": "character_system_text",
      "source_text": "面白い、もっと力を見せてみろ。",
      "source_fingerprint": "ed805094e1b42430ad50060834ae19bbf4204da87580064f443fbb1f97b32a17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "81001"
      ]
    },
    {
      "uid": "zhcn:d8f38f2ee605262de9407b9f",
      "kind": "character_system_text",
      "source_text": "……早上了。\r\n我不希望浪费任何一天。",
      "source_fingerprint": "82246d76470400bf83cd44722cc308ceee98cb65602db17c70340c654c71a058",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90000"
      ]
    },
    {
      "uid": "zhcn:f3f2944ec86d6755aa6fedab",
      "kind": "character_system_text",
      "source_text": "早晨的空气感觉很不错。\r\n宁静……就是这种感觉吧。",
      "source_fingerprint": "eec3e358f6510de5158bae3d9eb0dd725d10e7884621c7a0e0e31997594a6a83",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90001"
      ]
    },
    {
      "uid": "zhcn:421b06199324f31a316a49fe",
      "kind": "character_system_text",
      "source_text": "……下午了。\r\n赶快来开始训练吧。",
      "source_fingerprint": "c26289e4e985714f562a248c786796539b23250d83bdddff189dc81af5a4acd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90002"
      ]
    },
    {
      "uid": "zhcn:4bcc57d59090bb7396500688",
      "kind": "character_system_text",
      "source_text": "午餐我都会在校舍后方吃。\r\n……只要能够忽略脚步声，\r\n其实就还满舒适的。",
      "source_fingerprint": "b8e6d86b2a5ae95cc491e464c598949bd98e33f028bd39470e0e9ebe11f96b85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90003"
      ]
    },
    {
      "uid": "zhcn:ee3d13388c131a18131e627c",
      "kind": "character_system_text",
      "source_text": "太阳下山了，要进入黑暗了……\r\n这是自然界里最充满危险的时段。",
      "source_fingerprint": "aef13869dfbc170cc60b30cfd462cf082b72549501bec027dfa8a5018298476d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90004"
      ]
    },
    {
      "uid": "zhcn:23e8d4f9338b4695bbeb465c",
      "kind": "character_system_text",
      "source_text": "乌鸦啼叫时就是该回家的时候……\r\n以前常听人这么说。",
      "source_fingerprint": "f7d0b775b216ce118741f97dec1c1c4af4cddb07076f4720f627f63d5219c093",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90005"
      ]
    },
    {
      "uid": "zhcn:74097f5a80cc9dca243f374b",
      "kind": "character_system_text",
      "source_text": "似乎多了很多新生吧。\r\n会是展翅高飞还是坠落地面……\r\n都要看雏鸟本身的努力。",
      "source_fingerprint": "252c8498a327e96ad27f719c922639f83564c4a5ca60798366590ac993120960",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90006"
      ]
    },
    {
      "uid": "zhcn:7aec1dad9f7ea4ae616fcc53",
      "kind": "character_system_text",
      "source_text": "是蝉蜕啊。我小时候经常收集这个，\r\n都会跟大姐比谁的数量多……",
      "source_fingerprint": "2413a385258d132660dfbf49b1e4c4227c6bdce4607d17b66cd067f6efd42402",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90007"
      ]
    },
    {
      "uid": "zhcn:1404c3dee97b99327bcfe0fe",
      "kind": "character_system_text",
      "source_text": "虫鸣、风声──\r\n……就像是输家的哭声一样。",
      "source_fingerprint": "6349fb3772c6b6558cd033b48fb3a866d6d494931160ef84a9922789bade53c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90008"
      ]
    },
    {
      "uid": "zhcn:b62cb2f51b9f881f4c007433",
      "kind": "character_system_text",
      "source_text": "寒冷是阻挡不了我的。\r\n──只要奔跑，我就会热血沸腾。",
      "source_fingerprint": "05d2c6ebc6cba0241c553b3b28b1d2aff210abc18fd58be1a472234ad3db8b63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90009"
      ]
    },
    {
      "uid": "zhcn:efc2d7a6ae4fc7ff83ddb187",
      "kind": "character_system_text",
      "source_text": "我今天起得太早，就一路练跑，\r\n跑到隔壁镇……呵，回过神来才发现\r\n身边跟着一个意志力十足的家伙。",
      "source_fingerprint": "dce542fa9d92235c455dea264f3a0df85126156b879e7d19904f30fc30ff9732",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90010"
      ]
    },
    {
      "uid": "zhcn:42d3cb069b087a96dbb0b109",
      "kind": "character_system_text",
      "source_text": "你看起来很困呢，去用冷水洗脸后\r\n拿粗盐搓完身体再来吧。\r\n这样做即使不情愿也会清醒的。",
      "source_fingerprint": "87538054c94cb91090560f0e9e60da0fd077d28e4cec95d93caaf43b02786571",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90011"
      ]
    },
    {
      "uid": "zhcn:ed844ca9dc36c6af2bcf3813",
      "kind": "character_system_text",
      "source_text": "记得好好填饱肚子。\r\n下午还要活动身体对吧？\r\n即使没食欲也得吃。",
      "source_fingerprint": "4a6c9e83f3d9bfd329075cf5b353bf8dd5acce62c9a592a7191e63d3e586142b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90012"
      ]
    },
    {
      "uid": "zhcn:182bbc4d88a86365f54bc4fe",
      "kind": "character_system_text",
      "source_text": "我知道听课获得的知识很重要，\r\n但那些对凭借着冲动\r\n奔跑的我来说实在是……",
      "source_fingerprint": "0dffc10d677ca7923d96ce55fd2115e7058dbfbcd1d3bf1809d2baeaf5b43d1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90013"
      ]
    },
    {
      "uid": "zhcn:a5d2781031336d2121c85793",
      "kind": "character_system_text",
      "source_text": "宁静的夜晚感官也会特别敏锐。\r\n正是练跑的最佳时机。",
      "source_fingerprint": "e84d18d237abde219b84437f4d0fbd11ca4bc2fcebc118e6a21fac4e4793dc43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90014"
      ]
    },
    {
      "uid": "zhcn:363006b53136144af2662855",
      "kind": "character_system_text",
      "source_text": "这么晚了你还在工作啊……\r\n真巧，我也是，即使时间不早了，\r\n仍因为想跑步而情绪高涨。",
      "source_fingerprint": "ea4f89bcdac8ee643509f77bac2b8576e6e6c215bbb93f9a24562e8c239adb07",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1016",
        "90015"
      ]
    }
  ]
}
