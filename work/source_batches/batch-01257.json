  "entries": [
    {
      "uid": "zhcn:c440215c262986f9ca8bd154",
      "kind": "character_system_text",
      "source_text": "好厉害……！！",
      "source_fingerprint": "a74544c8eeccc52df57115ba679592a1fb7c5e0ac92570598eebe5075b832f1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140011"
      ]
    },
    {
      "uid": "zhcn:c1cc1d3bfb8db9cdd25ed6c9",
      "kind": "character_system_text",
      "source_text": "了不起啊！？",
      "source_fingerprint": "f5da7b5e11a39e1da3e8335c6cb6a401b9832752a70f48c547dfe290a56db2eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140012"
      ]
    },
    {
      "uid": "zhcn:4809f84bf0f7f76eb5439d62",
      "kind": "character_system_text",
      "source_text": "好机会！",
      "source_fingerprint": "54ec1da823f0c87f6074881d473031b6d90dc8b4228f9b688360c7982332f97f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140013"
      ]
    },
    {
      "uid": "zhcn:c74d92c565b40bba60e83cc5",
      "kind": "character_system_text",
      "source_text": "好可惜……！",
      "source_fingerprint": "81bbfcadc7b096bbec7263c4a502fbc683ad38cf63c74a3d2877521f6a468700",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140014"
      ]
    },
    {
      "uid": "zhcn:46c5fcd0e83c29e1a9095401",
      "kind": "character_system_text",
      "source_text": "嗯～",
      "source_fingerprint": "5f0615f35f7b967cbbbef5e5223e75fb6a03b988771d4067f785cebb30ecf787",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140015"
      ]
    },
    {
      "uid": "zhcn:4436b486a09abf76dbe55ace",
      "kind": "character_system_text",
      "source_text": "我上咯──！",
      "source_fingerprint": "58587e2a39069844a1bb6ce08353ad390ec10f742217cf8914fe1c3c001beacc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140016"
      ]
    },
    {
      "uid": "zhcn:9c32683d50b276f829059594",
      "kind": "character_system_text",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140017"
      ]
    },
    {
      "uid": "zhcn:8a40a0c478df1ae848375af3",
      "kind": "character_system_text",
      "source_text": "啊啊……",
      "source_fingerprint": "67d0eeceded72eace8823cc24b753a0a3007c8ea0e0a4fc8073e9cf559b5eb03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "140018"
      ]
    },
    {
      "uid": "zhcn:65de20f24214c4346783563b",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个哦！",
      "source_fingerprint": "0d10531ce5f2b4467fd7a494caee7d13a9e8445521233bac676c4612785a5e95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "15"
      ]
    },
    {
      "uid": "zhcn:665cd5ef0bb755a0cd774575",
      "kind": "character_system_text",
      "source_text": "不行，我使不上力。\r\n等我一下……",
      "source_fingerprint": "4daffc355f35d9d12b681d001172bb5500d489817644697f510dd8e3e96f546b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20000"
      ]
    },
    {
      "uid": "zhcn:d79a907e59ab81cb7a5a4677",
      "kind": "character_system_text",
      "source_text": "虽然知道现在是该\r\n奋力一搏的时候……",
      "source_fingerprint": "2fb6c678a3b121f82f9617e37d51b83d414667d48bc6d65ae1b295f89844771f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20001"
      ]
    },
    {
      "uid": "zhcn:3c26c87b1245d3abb7ae8ead",
      "kind": "character_system_text",
      "source_text": "干劲跟活力都全满！！\r\n太棒啦～～！！",
      "source_fingerprint": "b28c93b5c7198636f4a2f8118ec246cf8c403bf95b267df750a2e052c330f63c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20002"
      ]
    },
    {
      "uid": "zhcn:9551b8468a7b4239e60fa5a2",
      "kind": "character_system_text",
      "source_text": "我活力满满喔！！\r\n就跟闪电一样！！",
      "source_fingerprint": "233a45945a924a8ea3902b488b1e14a442eba4f8b5f10221da3025f231f6b7e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20003"
      ]
    },
    {
      "uid": "zhcn:96c88ad91ce2c785e5930426",
      "kind": "character_system_text",
      "source_text": "盛大准备，利落进行，\r\n一口气完成吧！",
      "source_fingerprint": "0ec08a309bd53257fec94d0285fd85bd71bce922b53f12557d024330c841c7ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20004"
      ]
    },
    {
      "uid": "zhcn:e81526508de48d64627eeafd",
      "kind": "character_system_text",
      "source_text": "照今天的感觉看来，\r\n稍微重一点也没问题！",
      "source_fingerprint": "41d28bcfc7a31ceec3caecac1bf4b40fefcdb7bb754817007d4ba06ff945387f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20005"
      ]
    },
    {
      "uid": "zhcn:63eeebe418a163a9be324f82",
      "kind": "character_system_text",
      "source_text": "准备OK！开始吧！",
      "source_fingerprint": "b8e2d40e56c4faa2be1bf5bd27773351536324c73fe61a60690900e51583569a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20006"
      ]
    },
    {
      "uid": "zhcn:9e77b93d0487451b65bee7fa",
      "kind": "character_system_text",
      "source_text": "快速解决吧！\r\n跟我来！",
      "source_fingerprint": "98742c00b54a2a3f0425a355000ac62064af72039995ad01a1bd9e941417877d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20007"
      ]
    },
    {
      "uid": "zhcn:bd24d97e110c84cff54a8ea4",
      "kind": "character_system_text",
      "source_text": "就是打不起精神来啊……\r\n……到底是哪里不行？",
      "source_fingerprint": "c122253fb921c100ea84a63def9f20816f8f4282e68ac61023a14b3cbabbc95f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20008"
      ]
    },
    {
      "uid": "zhcn:603ee74bff2ff370db49777b",
      "kind": "character_system_text",
      "source_text": "总觉得，如果有什么事情\r\n能让我情绪高昂起来\r\n就好了……",
      "source_fingerprint": "22c8afc9650df179ff02eeb90faeaca7f166c04c272d2bd24334d74262d40a9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20009"
      ]
    },
    {
      "uid": "zhcn:7f5a9210c884537289689348",
      "kind": "character_system_text",
      "source_text": "总算是靠着意志力……\r\n勉强撑过来了……",
      "source_fingerprint": "fb0d9813fad9cd952541848a02f03f031b37430dd771d7d96feedc0e98bf9be1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20010"
      ]
    },
    {
      "uid": "zhcn:445391bd6153b68d856b05d7",
      "kind": "character_system_text",
      "source_text": "长在赛道上面的草\r\n可不可以吃啊……",
      "source_fingerprint": "96d1ff81ee3c63070e44e696405ff15e3fbabba6c660d484cdd521d9cae6dca2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20011"
      ]
    },
    {
      "uid": "zhcn:c1b2fe943b5fc95a6eeb4758",
      "kind": "character_system_text",
      "source_text": "连续参加比赛不要紧吗……？\r\n之后会不会累趴到起不来？",
      "source_fingerprint": "ac9b44ce46879caf9161a589c506d36c47069f8fbea9cc6b77ab7a9a8571de30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20021"
      ]
    },
    {
      "uid": "zhcn:3aa07fef2f32ff13ddc52ca3",
      "kind": "character_system_text",
      "source_text": "又要比赛实在快撑不下去了……\r\n还是重新考虑一下比较好！",
      "source_fingerprint": "970b282ed4dd3c96e94e592f33d9163cfedad9f14a355e500cbfe0916a86b654",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20022"
      ]
    },
    {
      "uid": "zhcn:de40c4caddebb3675537f170",
      "kind": "character_system_text",
      "source_text": "好，正式上了！！\r\n就来大战一场吧！！",
      "source_fingerprint": "6622cb1b05f00649bdeb10158bc51b261d15d251b5e3cde32987bae7beda02f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20023"
      ]
    },
    {
      "uid": "zhcn:bacfc9d9d9adb2f8852897c2",
      "kind": "character_system_text",
      "source_text": "哎呀～状况太好咯！\r\n搞不好速攻就能解决了！\r\n哇～哈哈哈！",
      "source_fingerprint": "6d48acdbff8a77ffafc9f5dee962647ca606cc89bddbbd8ad700194509feba6c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20024"
      ]
    },
    {
      "uid": "zhcn:012ad71b48c5aa13c9424f00",
      "kind": "character_system_text",
      "source_text": "不管对手是大块头，\r\n还是小个子，我都不会输！\r\n让大家见识我的真本事吧！",
      "source_fingerprint": "9952348ff8538c37776f1ea90cc64e541cb9e6909d5339942014182756ce131d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20025"
      ]
    },
    {
      "uid": "zhcn:b097b1097d283a1494a0cdbe",
      "kind": "character_system_text",
      "source_text": "心情超赞！盛大地上场，\r\n盛大地获胜吧！",
      "source_fingerprint": "1346ba64a69a9f68d06490673e4260e7087ed658f77b1afc0522fb0e487fc6e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20026"
      ]
    },
    {
      "uid": "zhcn:7cbd832e7615348867bd97ce",
      "kind": "character_system_text",
      "source_text": "今天我的口味跟平常不一样喔！\r\n汤汁更多更浓！\r\n……呃，是在说什么来着，啊哈哈哈！",
      "source_fingerprint": "5f630827a83a00b8b252983d63cae2cecfe3c63c5d98fe39d7682c446d8d613a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20027"
      ]
    },
    {
      "uid": "zhcn:f500b8d64f59992ffed078e6",
      "kind": "character_system_text",
      "source_text": "让大家见识我风驰电掣的表现，\r\n感受到火花四射吧！",
      "source_fingerprint": "c9014310174ddc22a86d1527a722a9a0836412444d5408616a24976709deccf5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20028"
      ]
    },
    {
      "uid": "zhcn:1def34d32389919f686c2c49",
      "kind": "character_system_text",
      "source_text": "轮到我了！\r\n好，我上场咯！",
      "source_fingerprint": "c83c17d2ef4af69c6a64f8e831831e13650f7661a9076916ce548adca90e1913",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20029"
      ]
    },
    {
      "uid": "zhcn:dc693189c94df99ddcd5962a",
      "kind": "character_system_text",
      "source_text": "不管对手是谁都好，\r\n我会通通彻底击败！",
      "source_fingerprint": "86ab38ef45cb296a35f2eece7e666ddbdbb6d89aeabc2801e66a7fd798fad79c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20030"
      ]
    },
    {
      "uid": "zhcn:2e98b0bc32b28e2cdb7f068e",
      "kind": "character_system_text",
      "source_text": "将我的胜利之姿\r\n深深烙印在心中吧！",
      "source_fingerprint": "0f7d9025bdd62fd3470c5a8cb1f3f6bac36a4d24530254e1bdc6f4b851418b33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f084deae466f06cc9fbf276b",
      "kind": "character_system_text",
      "source_text": "虽然感觉有点微妙……\r\n但总会有办法的吧……应该啦！",
      "source_fingerprint": "da42c83231ce6acb02c0dda61b37755ae3e01b9857442b254cb2f9f649301e66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20032"
      ]
    },
    {
      "uid": "zhcn:23c7b7d0401a6993daf48a6f",
      "kind": "character_system_text",
      "source_text": "不试试看怎么知道……\r\n可不能一开始就放弃啊！",
      "source_fingerprint": "2f260d5c34e86a75df655e7d231109e1d0b32a45f0cfda8ae5edd23e7fb8f165",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20033"
      ]
    },
    {
      "uid": "zhcn:dd712ec2176ea5c8cedf8b79",
      "kind": "character_system_text",
      "source_text": "糟糕，我变得超在意\r\n微不足道的小事……比如说云的形状，\r\n还有地面的蚂蚁之类的……",
      "source_fingerprint": "1c70be5d2e73717ccdb6dd5b6622b657df71213d110d73ef809670e20412434f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20034"
      ]
    },
    {
      "uid": "zhcn:8e08e3f5e4ad5d338a514001",
      "kind": "character_system_text",
      "source_text": "不要紧，一定会有办法的……\r\n想想小不点们的脸……",
      "source_fingerprint": "44e1fec4fdf8f0f3569200e699e3be3c24092f4f15592b8cbf8535c61e38a905",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20035"
      ]
    },
    {
      "uid": "zhcn:9541fce935124c31f694b84e",
      "kind": "character_system_text",
      "source_text": "我不能在这里认输……\r\n我得咬紧牙关，好好努力……",
      "source_fingerprint": "350b70e341bd3d369acda414206d986e1aea28ebe8ff4372f642421dc55fd8d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20036"
      ]
    },
    {
      "uid": "zhcn:f8d824cd4ede564d2d23359b",
      "kind": "character_system_text",
      "source_text": "振作一点……\r\n深呼吸、深呼吸……",
      "source_fingerprint": "a7f113fc80df149af03984666966e0dc37439f5750dabf71e7aa33ac316e3935",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20037"
      ]
    },
    {
      "uid": "zhcn:c4015490c6340359f1b96905",
      "kind": "character_system_text",
      "source_text": "我上咯！",
      "source_fingerprint": "72c420633127ee8e5455068140ef1b6599234883f68c6284655daf070887f917",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2b3dc294940df821e545b9e1",
      "kind": "character_system_text",
      "source_text": "开始吧！",
      "source_fingerprint": "1f6f9cb6d386b03a59eafb944e976a93775f81d43c59dffa89b8cc34793a942f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20039"
      ]
    },
    {
      "uid": "zhcn:e6f703102f727f9faa05e271",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20040"
      ]
    },
    {
      "uid": "zhcn:3251e7db27a9faa8ce270e9d",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20041"
      ]
    },
    {
      "uid": "zhcn:427d5c1895129cb024d6e889",
      "kind": "character_system_text",
      "source_text": "搞砸了……",
      "source_fingerprint": "a3c4e4dc3a75cf574e723f5d08fa91dbbe0f080c18a5d51d068002de25bf9f27",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20042"
      ]
    },
    {
      "uid": "zhcn:dda41502a088c74cda9fb6f6",
      "kind": "character_system_text",
      "source_text": "不行啊……",
      "source_fingerprint": "3117407b136cdedd99c190a8a7b64c21ea19135cce886f218d9d726b889c54ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20043"
      ]
    },
    {
      "uid": "zhcn:44f07472cf722bc86635ec14",
      "kind": "character_system_text",
      "source_text": "走吧──！",
      "source_fingerprint": "db75ff260d31894a6ff613a77cb9974041f12a09875173eb1517bffdca1dbc00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20046"
      ]
    },
    {
      "uid": "zhcn:ac0fd4ef19a47d62ffdfe1dc",
      "kind": "character_system_text",
      "source_text": "大海～♪",
      "source_fingerprint": "f45050bfce88d3e6715f25857459f80aa75a0ba6cb172dcd82466b64a53acb47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20047"
      ]
    },
    {
      "uid": "zhcn:4f3927716e1fb0a273868898",
      "kind": "character_system_text",
      "source_text": "这样就有脸去见小不点们了！",
      "source_fingerprint": "b666c79b4b86c76c553c9b4ffac14d7120d16ce0010649f4fcdc1c4643c0af37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20049"
      ]
    },
    {
      "uid": "zhcn:c5b7db5120e8d50d72372918",
      "kind": "character_system_text",
      "source_text": "好开心啊，谢谢！",
      "source_fingerprint": "172fad900e6f99c5abee80695ff1f5bb5f7e5fcd8c49763c23449da487ee01d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20050"
      ]
    },
    {
      "uid": "zhcn:a8dfac0bf2a913ae8f7e1862",
      "kind": "character_system_text",
      "source_text": "来吧，跟我一起做吧！",
      "source_fingerprint": "96a9f0da5663ec5b28d62d9b9d7ab448c03a5588e395ad626b3afc5978037897",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "20051"
      ]
    },
    {
      "uid": "zhcn:9d67285e2622c3f965cb920d",
      "kind": "character_system_text",
      "source_text": "成功啦！",
      "source_fingerprint": "6861a1222a83096c184d05beb9eff554b1a5385a4910b681f3bf859f5335b970",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2030"
      ]
    },
    {
      "uid": "zhcn:5cb221281f5c13edc43a5a3d",
      "kind": "character_system_text",
      "source_text": "你要好好跟上脚步喔！",
      "source_fingerprint": "2a91b6ed3dd0f6198d27ef1da9af2e250176e5d1c67a91e3267155ea947b266e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2031"
      ]
    },
    {
      "uid": "zhcn:51627d3b9b9bbe9a2c9d14af",
      "kind": "character_system_text",
      "source_text": "好开心啊，谢谢！",
      "source_fingerprint": "172fad900e6f99c5abee80695ff1f5bb5f7e5fcd8c49763c23449da487ee01d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2032"
      ]
    },
    {
      "uid": "zhcn:81eff3ac538a1e5d14280737",
      "kind": "character_system_text",
      "source_text": "让大家见识我风驰电掣的表现，\r\n感受到火花四射吧！",
      "source_fingerprint": "c9014310174ddc22a86d1527a722a9a0836412444d5408616a24976709deccf5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2033"
      ]
    },
    {
      "uid": "zhcn:9be3fcbd2fe973873100a078",
      "kind": "character_system_text",
      "source_text": "不管对手是大块头，\r\n还是小个子，我都不会输！\r\n让大家见识我的真本事吧！",
      "source_fingerprint": "9952348ff8538c37776f1ea90cc64e541cb9e6909d5339942014182756ce131d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2034"
      ]
    },
    {
      "uid": "zhcn:30673c55f12492cd88a30216",
      "kind": "character_system_text",
      "source_text": "好开心啊，谢谢！",
      "source_fingerprint": "172fad900e6f99c5abee80695ff1f5bb5f7e5fcd8c49763c23449da487ee01d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "2035"
      ]
    },
    {
      "uid": "zhcn:e4d642fd3c75056456e1028c",
      "kind": "character_system_text",
      "source_text": "始めよか！",
      "source_fingerprint": "8094473c45dbad64079089259eb22e03f9d6702714965b496059041fe54b6873",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "23015"
      ]
    },
    {
      "uid": "zhcn:7a5a7dd8b41bbc14f5dba7fc",
      "kind": "character_system_text",
      "source_text": "就只差一点点了啊……！",
      "source_fingerprint": "4bd42c65abba1f75de6aaf0419db5289003d47ddbab24e950dd5c8d01407e059",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30000"
      ]
    },
    {
      "uid": "zhcn:d63cd0a4568086656596d844",
      "kind": "character_system_text",
      "source_text": "感觉还可以吧！",
      "source_fingerprint": "77b8db825288ce10bebeefe2850ba6f46f14abea0d9c9c4161e17d7badf8f743",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30001"
      ]
    },
    {
      "uid": "zhcn:3dd0ca450b4c53079feabc2f",
      "kind": "character_system_text",
      "source_text": "感觉不上不下的没有很厉害啊……",
      "source_fingerprint": "9e1bb0e52b93f772ada4f2b0d53aa6eea303788ee78e7fe6e324eb9ea37e1f96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30002"
      ]
    },
    {
      "uid": "zhcn:d5afc67b474d5524100c8aae",
      "kind": "character_system_text",
      "source_text": "不行，得重新锻炼……！",
      "source_fingerprint": "59d04c9e3e2118e5a5c89d6ab882cff35e085a11946dc41301269d4defa612cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1bab9a82df8039680fb422a1",
      "kind": "character_system_text",
      "source_text": "看到了吧！这就是大阪人的意志力！",
      "source_fingerprint": "26c205c51abc6a9041a7224b86e54ee4d00ca6d4b470a9f9a7eb50433cc2f8e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30004"
      ]
    },
    {
      "uid": "zhcn:dfc3eddd592d6f8dc676a9bd",
      "kind": "character_system_text",
      "source_text": "如何！见识到我的意志力了吧！",
      "source_fingerprint": "ebfb658fa8e570e889817ede292744ed3e9e8ac08e0b337d21474248fdfea380",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30005"
      ]
    },
    {
      "uid": "zhcn:686b9b4d3a54cf13ba1b148e",
      "kind": "character_system_text",
      "source_text": "这就是响彻神话时代的闪电！",
      "source_fingerprint": "d43e8371390a70ee67e9d2bf6fa94a2b7e1c080abde4fef811981a2a72911775",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30006"
      ]
    },
    {
      "uid": "zhcn:0eca3c7e30b9be80afed21f5",
      "kind": "character_system_text",
      "source_text": "如何！见识到我的意志力了吧！",
      "source_fingerprint": "ebfb658fa8e570e889817ede292744ed3e9e8ac08e0b337d21474248fdfea380",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "30007"
      ]
    },
    {
      "uid": "zhcn:263f1cb373ddb39eddad4bc5",
      "kind": "character_system_text",
      "source_text": "好，走吧！",
      "source_fingerprint": "a1847dedf2949edc2fec2f68a27f5af020238b67e321cd8178d1f99182cf5bd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d3d288e41845f6fbd403a226",
      "kind": "character_system_text",
      "source_text": "这就叫疾风迅雷啊……！！",
      "source_fingerprint": "ac866f845714949655eeaf15ef7b52ac1625d43b63bceff85cc89b63b970bc39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40000"
      ]
    },
    {
      "uid": "zhcn:b176c550fe4de9a453e2be7e",
      "kind": "character_system_text",
      "source_text": "我要当「神马」啊～\r\n老妈听了应该会吓一大跳吧～\r\n……得在家人面前好好表现才行！",
      "source_fingerprint": "518cd21c19cb4c28ebb398e5b44238be836b20eb399dd2f80d1e014f308ab6a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400000"
      ]
    },
    {
      "uid": "zhcn:364b5e8db5c6f7a0b1e93e9e",
      "kind": "character_system_text",
      "source_text": "真是个麻烦的家伙～\r\n好吧，我就一起照顾吧！",
      "source_fingerprint": "a277f067731f29b7cdb33a5eb6b7e17c18f289b22233e4a7da0637d4e5fda705",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400004"
      ]
    },
    {
      "uid": "zhcn:572e3fac6052d1f84ea0dd8e",
      "kind": "character_system_text",
      "source_text": "等着瞧！\r\n我们绝对会跑出一场专属于我们、\r\n最棒的「神马驱」……！",
      "source_fingerprint": "e2838d6fdaec1ed9fc7d521239849a4538ac7bfdc9ec134a70ef834abdf46b0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400006"
      ]
    },
    {
      "uid": "zhcn:c343174da673efc2e3e5a83b",
      "kind": "character_system_text",
      "source_text": "有机会的话，下次叫稻荷举办一场\r\n荞麦面派对吧。至于汤底……\r\n东西边两种口味都准备就好啦！",
      "source_fingerprint": "91861175882dfef92573830853c81c6a9c18e80485273e60a97622a7c5a84b0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400009"
      ]
    },
    {
      "uid": "zhcn:8527ed529f2517082abdc784",
      "kind": "character_system_text",
      "source_text": "要上咯，要上咯，要上咯──！！\r\n风驰电掣的「白色闪电」就是说我啦！！",
      "source_fingerprint": "1c5108c25f571ff318350271ff6edbde3c515bb92e33702f403d4f699ec6b638",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40001"
      ]
    },
    {
      "uid": "zhcn:d3b32207d9fe341f158fa15f",
      "kind": "character_system_text",
      "source_text": "把我送来这所学园时，\r\n妈妈也相信着\r\n「我一定办得到」吗……",
      "source_fingerprint": "31bf716c357765467e8c070a4e51503ba109c5dacf82f48fe322da83753932c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "400011"
      ]
    },
    {
      "uid": "zhcn:f1dced12127a87f20fdb2301",
      "kind": "character_system_text",
      "source_text": "接下来还会更热血喔！",
      "source_fingerprint": "1105313a4715dabc58ba687ec2ab02c33ff7673f1b46a028f6a20f7fa6bb247f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40003"
      ]
    },
    {
      "uid": "zhcn:e1619266263ec55c4a770c23",
      "kind": "character_system_text",
      "source_text": "传承下来的意志……就由我让它\r\n响彻云霄！看着吧，这就是\r\n大阪的「升雷」啦──！！",
      "source_fingerprint": "b52a6d8bb5a2d0ba71d1dd18421ca63634ff1a7bb510b14c41b6b686602d0ab1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "40004"
      ]
    },
    {
      "uid": "zhcn:b38ab2c967610b49177edb83",
      "kind": "character_system_text",
      "source_text": "炒热气氛就交给我吧！",
      "source_fingerprint": "18c2142fb3b91a2619c8c8025ec13a631e35af2658776d63b438e4f91bb3812e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "60000"
      ]
    },
    {
      "uid": "zhcn:ec42955b8e0dd2dc1a958ade",
      "kind": "character_system_text",
      "source_text": "要发出声音，好好帮忙打气！",
      "source_fingerprint": "46288c62553d5f53f962d8a966df29334331b5eb9bbd80d9c7fc0a9aa5704eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "60001"
      ]
    },
    {
      "uid": "zhcn:2438e379050ca193faf4b1a1",
      "kind": "character_system_text",
      "source_text": "用意志力取胜吧，训练员！",
      "source_fingerprint": "d4feb656be59440167d2789b37061d0878ee743a1becd1872458133783d9ed8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70000"
      ]
    },
    {
      "uid": "zhcn:6d61ae7879df0e813962f8c7",
      "kind": "character_system_text",
      "source_text": "我一开始那么难搞，真抱歉。\r\n现在很感谢你当时\r\n有来找我说话喔！",
      "source_fingerprint": "e0ed872186c4e8a9a6d45e5c53367b4bf89991f94c51aff9d61411d64bd66d09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70001"
      ]
    },
    {
      "uid": "zhcn:a57887e8f4e588bf8891c7ae",
      "kind": "character_system_text",
      "source_text": "以日常服装来说还真讲究啊～\r\n要是在我老家，这就算是最棒的衣服咯。",
      "source_fingerprint": "4cb196617db59c4cf8ea4e714f97876103723a2838e612eb5be0c012bd46b8c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70004"
      ]
    },
    {
      "uid": "zhcn:16b55cfd988837c49a537ca6",
      "kind": "character_system_text",
      "source_text": "哎呀～光是能穿上这么豪华的服装，\r\n就不枉费我努力跑步了，认真的。",
      "source_fingerprint": "a0481837acf6172ad7c9744d3b894deb82c41b830d2852fe8e54b6103a11e692",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1021",
        "70008"
      ]
    }
  ]
}
