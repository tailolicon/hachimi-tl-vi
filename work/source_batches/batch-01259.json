      "kind": "character_system_text",
      "source_text": "平局啊～",
      "source_fingerprint": "e21fcbff8101495aa54703ed1c70d1d9824b5d78da15a94bd0ff6b396486ca62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
