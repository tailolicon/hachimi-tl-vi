      ]
    },
    {
      "uid": "zhcn:d9d5a44aa4cc2ad382dc302a",
      "kind": "character_system_text",
      "source_text": "哼呣哼呣…♪",
      "source_fingerprint": "fa936b7ce449ab9235e8253ebec3c24fb46e96aa25525666568c681d7ae8b314",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20041"
      ]
    },
    {
      "uid": "zhcn:e572bf54a159c41571b2e025",
      "kind": "character_system_text",
      "source_text": "哇…！",
      "source_fingerprint": "1d7b0d351354d6ea26eb26e88fd8b16593bbeb149b243b2bbad7c4c116d52127",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20042"
      ]
    },
    {
      "uid": "zhcn:e65091c0b8236ae636a1aabb",
      "kind": "character_system_text",
      "source_text": "哎、哎呀…？",
      "source_fingerprint": "92ced37263a07fb0451d2c67342ef9823a873e8db389f639e6138b61855ac745",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20043"
      ]
    },
    {
      "uid": "zhcn:075af3f8e40d0508e3804961",
      "kind": "character_system_text",
      "source_text": "出～发♪",
      "source_fingerprint": "a215dfba5db6b5a5fbc104df72f9054d8c8e7b0e8b562e82102dfb6836653609",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20046"
      ]
    },
    {
      "uid": "zhcn:fe95a41f39a08172fe826030",
      "kind": "character_system_text",
      "source_text": "哇～！好美～♪",
      "source_fingerprint": "d2f6cbb224de68e6031a1c66d16cad976b3c8ce9753cd17e79728b3408544122",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20047"
      ]
    },
    {
      "uid": "zhcn:ab28b2655970d1f74958323b",
      "kind": "character_system_text",
      "source_text": "谢谢你，得好好称赞你的功绩呢♪",
      "source_fingerprint": "dfefa1fc6a0b8a930a9ee349299894490ffed91f4d0d9cee4757446309ae2924",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20049"
      ]
    },
    {
      "uid": "zhcn:555ffbdedec4eb1b7673d643",
      "kind": "character_system_text",
      "source_text": "辛苦了，受您照顾了！",
      "source_fingerprint": "390f62c95ac91b3c780fc6b12485f4673534431bcbafb5f3784fb9bd699b3746",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20050"
      ]
    },
    {
      "uid": "zhcn:343d975f4f01f0df541147cd",
      "kind": "character_system_text",
      "source_text": "一起加油吧～♪",
      "source_fingerprint": "2eebc000cc757ce706c3df66f5a46f8fc63f9ed35688b9509722846204f4b15f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "20051"
      ]
    },
    {
      "uid": "zhcn:6bfe342a5b0506055eee1eef",
      "kind": "character_system_text",
      "source_text": "出战吧！",
      "source_fingerprint": "45e81659c7d8cb25d832a62bba04333afacea8e9fea56c476c86cbc10fe31713",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "2030"
      ]
    },
    {
      "uid": "zhcn:0a5e3c357e52ceabc1e82608",
      "kind": "character_system_text",
      "source_text": "愿三叶草能保佑大家…！",
      "source_fingerprint": "fa1bfa3faded3079ea023a60aa67743ee2724e7bfd3eb7ab2bc0e1e77e807c3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "2031"
      ]
    },
    {
      "uid": "zhcn:f0cdd1a7d57b321f0af0a4a3",
      "kind": "character_system_text",
      "source_text": "谢谢你，得好好称赞你的功绩呢♪",
      "source_fingerprint": "dfefa1fc6a0b8a930a9ee349299894490ffed91f4d0d9cee4757446309ae2924",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "2032"
      ]
    },
    {
      "uid": "zhcn:ecd84c1f5c63ab323ebd0e8a",
      "kind": "character_system_text",
      "source_text": "那么，准备出赛了…！\n一定要取得胜利，\n在大家面前凯旋而归。",
      "source_fingerprint": "5f7b78146b2edf69536a20d91993039ece9fd8710e51c1df4f056f6bf1007e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "2033"
      ]
    },
    {
      "uid": "zhcn:74a3da02d04aa2f6e68b13f6",
      "kind": "character_system_text",
      "source_text": "“好好见证我现在的实力吧！”——\n怀着这种愿望奔跑的话，\n就能给大家留下美好的回忆了……！",
      "source_fingerprint": "5a9011cf5f09d263759650a650bfc879a4d7c5617e20a98517e0e172a01988dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "2034"
      ]
    },
    {
      "uid": "zhcn:cc8ab89aa344bb426c8be270",
      "kind": "character_system_text",
      "source_text": "谢谢你，得好好称赞你的功绩呢♪",
      "source_fingerprint": "dfefa1fc6a0b8a930a9ee349299894490ffed91f4d0d9cee4757446309ae2924",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "2035"
      ]
    },
    {
      "uid": "zhcn:37746747ef395897aa091adc",
      "kind": "character_system_text",
      "source_text": "始めるよ～♪",
      "source_fingerprint": "5d9b405c3f417221d522632b0e089be24abcaed09bc60ed3174a1e27794f3027",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "23015"
      ]
    },
    {
      "uid": "zhcn:7c024bd03714cffbeb90e773",
      "kind": "character_system_text",
      "source_text": "只差一步…！不过是场不错的对决呢！",
      "source_fingerprint": "d0d4d07f0fc1552ce4e25c3baf9cbbdf8151f480dcee8f5a5dfc9fe8551fa08e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30000"
      ]
    },
    {
      "uid": "zhcn:4b2e90ce9f70a181c7c4a974",
      "kind": "character_system_text",
      "source_text": "不错的战斗…吧？下次一定会赢的！",
      "source_fingerprint": "b029c8e672947580425f52067c081512c9214f97f7b981ef713224f84141c92e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30001"
      ]
    },
    {
      "uid": "zhcn:a7ebfbf3de7151ab296123b8",
      "kind": "character_system_text",
      "source_text": "唔嗯～、差点就没入着…！",
      "source_fingerprint": "aed5f642543fa06d410b48b87587fef250fdbbc7644bef75d25c15ae86e5e03b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30002"
      ]
    },
    {
      "uid": "zhcn:13c6478a8f8593809539871e",
      "kind": "character_system_text",
      "source_text": "力不能及…留下了苦涩的回忆呢。",
      "source_fingerprint": "84541a5153d7e3b6d585cb4ee20cdd197d865b66e33630d0083e1ccc8e3f995e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30003"
      ]
    },
    {
      "uid": "zhcn:c688c6142774b9d3915bdc69",
      "kind": "character_system_text",
      "source_text": "哼哼♪我成为大家的骄傲了吗？",
      "source_fingerprint": "b8e9ee8233c32bb93511ad0acfdc1d3bc406fde46af04cd97fccff49b103f947",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30004"
      ]
    },
    {
      "uid": "zhcn:52164079f07d96d38b3f7e27",
      "kind": "character_system_text",
      "source_text": "呵呵…变得很热闹了呢。\n感谢各位的声援哦♪",
      "source_fingerprint": "c9732a9bf905545a143422335d9303bfb83ca697ec46839012c4c20496f26ffd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30005"
      ]
    },
    {
      "uid": "zhcn:83dc30f429347c3246f4e349",
      "kind": "character_system_text",
      "source_text": "盛典就此开始了哦！",
      "source_fingerprint": "ef19c3b347bdbc46a7b602650a6174d1098328ef4b0f35e703cb284572d6471d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30006"
      ]
    },
    {
      "uid": "zhcn:7de56a62f5157cd4e553f716",
      "kind": "character_system_text",
      "source_text": "呵呵…变得很热闹了呢。\n感谢各位的声援哦♪",
      "source_fingerprint": "c9732a9bf905545a143422335d9303bfb83ca697ec46839012c4c20496f26ffd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "30007"
      ]
    },
    {
      "uid": "zhcn:a35700065bf079bb33795060",
      "kind": "character_system_text",
      "source_text": "那么，出赛吧。",
      "source_fingerprint": "87d75ee9829e2f663ac2d5e51b0fc53903193f05f06eb8579ed4b849ef4d4647",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "31000"
      ]
    },
    {
      "uid": "zhcn:de1d72e8850b98bb9b604c3e",
      "kind": "character_system_text",
      "source_text": "请引导我，获得光荣的胜利…！",
      "source_fingerprint": "2fb46328e10a3a63923dce04f2f327e2c90f7fa3ff1c6d7b35fe44562e1ccafc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "40000"
      ]
    },
    {
      "uid": "zhcn:85e92625eb1e95f1d9340360",
      "kind": "character_system_text",
      "source_text": "さぁ、忙しくなるぞ～！\r\nみんなをしっかりサポートして、\r\n…素敵な思い出を残したいな。",
      "source_fingerprint": "a07de0d71fb65c544129748590a38aac72726a35b4d531a1570246638a21e707",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "400000"
      ]
    },
    {
      "uid": "zhcn:2e3670103ea4a4f383088eda",
      "kind": "character_system_text",
      "source_text": "为什么大家都这么想要Beauty小姐的决胜服呢？",
      "source_fingerprint": "928a293e7e0992b8e4dc44e743248e5ab60fa4d755f4fc4913e73522cd1124ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "400001"
      ]
    },
    {
      "uid": "zhcn:9b8ae4b20cc0c7502e599665",
      "kind": "character_system_text",
      "source_text": "タップのお仲間さんたち、本当に\r\n色んな社会経験をなさっていて…\r\nたくさん学ばせていただこうっと！",
      "source_fingerprint": "038df5a21bab47fc31f2ff1345176c619c178997a8df965d1b6f76304f252422",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "400003"
      ]
    },
    {
      "uid": "zhcn:0041c1361fe1e3aa8a7f2af1",
      "kind": "character_system_text",
      "source_text": "这束光…是希望我追上去吗？\n等等…！…看见了！属于我的道路…！",
      "source_fingerprint": "b2926bffd08552118ab20742f65367317efddba3271a5aa052106756093704e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "40001"
      ]
    },
    {
      "uid": "zhcn:2d243adffe464edbc06793d9",
      "kind": "character_system_text",
      "source_text": "解谜游戏可真有趣呀～\r\n留下了很多很棒的回忆哦♪",
      "source_fingerprint": "966a058cf669943db4fec48a32dd89facad7808b3f30686c6b5e90d1f4a4b8bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "400010"
      ]
    },
    {
      "uid": "zhcn:af2acfcf866415e95c6409df",
      "kind": "character_system_text",
      "source_text": "イベントミッションへようこそ！\r\nたくさんクリアできるかな？\r\nしっかり見ているよ～？ふふー。",
      "source_fingerprint": "f6950595ff494f5fc0e8e1a8e06cd434d38b8ecb5235c34d44f7cf88fceaba27",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "400012"
      ]
    },
    {
      "uid": "zhcn:1de5df6cba9650900c60809b",
      "kind": "character_system_text",
      "source_text": "目標までたどり着けたかな？\r\n褒めてつかわそ～う♪\r\n…お疲れさま、頑張ったね！",
      "source_fingerprint": "2555659d6c569469e1b2be3e17064f4b5a7704c3a5eb55623628ef6ba7733f5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "400013"
      ]
    },
    {
      "uid": "zhcn:62a894b017b64d71028a7079",
      "kind": "character_system_text",
      "source_text": "一定会变成幸福的一天的呢！",
      "source_fingerprint": "bcab9f8dc486e7a563d46818a37cb4e99adf7c639660ed3fcd77da077c602cf2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "40003"
      ]
    },
    {
      "uid": "zhcn:a5a44fb5aa16c8aa80cfa2cc",
      "kind": "character_system_text",
      "source_text": "哼哼♪久等啦！\r\n一起举办一场让人难以忘怀的盛典吧！",
      "source_fingerprint": "dc951fbf70b69fe28af9045b7e95c2631bfb36490f440d142a9146e95b38cecf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1022",
        "40004"
      ]
    },
    {
      "uid": "zhcn:91170ece265d05edbcddc0e2",
      "kind": "character_system_text",
      "source_text": "上吧",
      "source_fingerprint": "40b47c19439808270265be2f12339c4384ede1b96dc2880ec05fc1ec1833f2d6",
      "source_path": "character_system_text_dict.json",
