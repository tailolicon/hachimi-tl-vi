        "1022",
        "71009"
      ]
    },
    {
      "uid": "zhcn:43543ed31ccc192e5e21289a",
      "kind": "character_system_text",
      "source_text": "全国多数学生都穿着的、传统的制服……\r\n我的父母也很佩服哦♪",
      "source_fingerprint": "1679456bd9d6092834bfe0dee7141793052b5daa2e5ff52d8a1357e60b987e6b",
      "source_path": "character_system_text_dict.json",
