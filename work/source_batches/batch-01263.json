  "entries": [
    {
      "uid": "zhcn:d87e470162df2e8ad3d96f37",
      "kind": "character_system_text",
      "source_text": "要挑战比赛吗？\r\n那就要来开作战会议了。",
      "source_fingerprint": "102d77d8827d539b578962f3f52f7364fb8f2e556cd0864d3ab746b552974edf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "110002"
      ]
    },
    {
      "uid": "zhcn:a30bdf5df830463dea238f06",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "12"
      ]
    },
    {
      "uid": "zhcn:b13f1f717142fdf2261609d2",
      "kind": "character_system_text",
      "source_text": "这就是……心意的力量吗？",
      "source_fingerprint": "9f09169759bbbfc68b3ed20fc66eacb0a2161c46bdbc526f16aad73548e60957",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "120000"
      ]
    },
    {
      "uid": "zhcn:db3adfe73086e74914f92f86",
      "kind": "character_system_text",
      "source_text": "这是今天的登录奖励。",
      "source_fingerprint": "7cc7b99b32d8f34da6bd620973df2ae9a0a57751a69db6f6dffcae6088fc7c17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "13"
      ]
    },
    {
      "uid": "zhcn:fc256cc1729e059c26de617b",
      "kind": "character_system_text",
      "source_text": "让我看看你的实力吧。",
      "source_fingerprint": "6c321926b48b3c7cabf6035fab4d3b00e82f60ac258a6f1504a8635c364b325c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140000"
      ]
    },
    {
      "uid": "zhcn:c525c7ce06e7bf7a8cd316de",
      "kind": "character_system_text",
      "source_text": "喔喔……太精彩了！",
      "source_fingerprint": "fc1c46550abb51409615810c1beea70ede628a5126143005d7cf60757375c594",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140001"
      ]
    },
    {
      "uid": "zhcn:8b2e2905534a2384697f8e56",
      "kind": "character_system_text",
      "source_text": "啊啊！？",
      "source_fingerprint": "bb9f2099e301f6e7a515f35e0111afe740f7eac6ad8957cc3153f172710bd335",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140002"
      ]
    },
    {
      "uid": "zhcn:31a056bb693c0f7d74d24165",
      "kind": "character_system_text",
      "source_text": "训练员君，你真有一套。",
      "source_fingerprint": "e8751f8649c6cce896896cdf27e500aa168bc6ee8b750f84698b4702c1696c19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140003"
      ]
    },
    {
      "uid": "zhcn:8fbfb7386617559484f25997",
      "kind": "character_system_text",
      "source_text": "太好了，训练员君。",
      "source_fingerprint": "b02c85735e455f73594b014428b5f0e1a8986d0b7ee3e80d0d85ccfb8391262f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140004"
      ]
    },
    {
      "uid": "zhcn:446c6569cf512183eae9ef45",
      "kind": "character_system_text",
      "source_text": "嗯……机率是一半一半。",
      "source_fingerprint": "ecbcd1008cd3f1617ba0822057200e272a933647a6a29bd7843160b732c3ce19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140005"
      ]
    },
    {
      "uid": "zhcn:d72767a02e04da348a992d57",
      "kind": "character_system_text",
      "source_text": "训练员君，你真有一套。",
      "source_fingerprint": "e8751f8649c6cce896896cdf27e500aa168bc6ee8b750f84698b4702c1696c19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140006"
      ]
    },
    {
      "uid": "zhcn:e7f3cebd39d6cac0015ea2e8",
      "kind": "character_system_text",
      "source_text": "太好了，训练员君。",
      "source_fingerprint": "b02c85735e455f73594b014428b5f0e1a8986d0b7ee3e80d0d85ccfb8391262f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140007"
      ]
    },
    {
      "uid": "zhcn:526247228bbe4ca109528293",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140008"
      ]
    },
    {
      "uid": "zhcn:fc4b8867cb12aa12812da8d3",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140009"
      ]
    },
    {
      "uid": "zhcn:d506f4b3fc946fd93d51bf89",
      "kind": "character_system_text",
      "source_text": "呵呵",
      "source_fingerprint": "f91365d70302fedaa7a15286c40274f8cef5d00e79953a4260169aa4e40851a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140010"
      ]
    },
    {
      "uid": "zhcn:38f361b035055f747aa4c268",
      "kind": "character_system_text",
      "source_text": "真是出色。",
      "source_fingerprint": "a5dd27dc281551060a1ddbc720428c04e19b667af150f21e1e66502d291f0002",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140011"
      ]
    },
    {
      "uid": "zhcn:a59323b985b5d903f3136bd1",
      "kind": "character_system_text",
      "source_text": "很厉害嘛！",
      "source_fingerprint": "a4fe55e48ef55a9ce8c2add90f08c94d628535308f3b8f7b4d98f0790e17fdc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140012"
      ]
    },
    {
      "uid": "zhcn:03ee84ac305e20a8c17ea1fa",
      "kind": "character_system_text",
      "source_text": "很好……！",
      "source_fingerprint": "cf5055283e158bef7a6e8fc441801fc3374bf4287fd113d9b70a0be38cabcb12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140013"
      ]
    },
    {
      "uid": "zhcn:e30e538e287e80669a7c960f",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140014"
      ]
    },
    {
      "uid": "zhcn:34543f211b4bb03459f6453b",
      "kind": "character_system_text",
      "source_text": "喔……",
      "source_fingerprint": "f79f7e9ac2e9e41f9906c092a20626889b780256a1fae3d8013b39de095f39af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140015"
      ]
    },
    {
      "uid": "zhcn:7a94455fe81dfa661724445d",
      "kind": "character_system_text",
      "source_text": "来吧！",
      "source_fingerprint": "259094e5a27d8b74ef6c993df596f92eace76ba061f4116e7799ac4847d895f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140016"
      ]
    },
    {
      "uid": "zhcn:0a50a2fe930342fe12b52a97",
      "kind": "character_system_text",
      "source_text": "什么！？",
      "source_fingerprint": "8fae634bd9fed421672fb72e9b24f793384cadde5c35454a04573eec752d6239",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140017"
      ]
    },
    {
      "uid": "zhcn:9729b7b3f41fcb4d30c9af67",
      "kind": "character_system_text",
      "source_text": "啊……",
      "source_fingerprint": "fbe9b8a6562528c71dac2f35e4bb3503757fd80fd15a323c0f3842922f08e2da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "140018"
      ]
    },
    {
      "uid": "zhcn:d4d21d0309c3ef3e60505e98",
      "kind": "character_system_text",
      "source_text": "明天好像可以拿到这个。",
      "source_fingerprint": "79aa3eb8be8928df97d087de08297f0f115cbf90eda07cae7c26ff7bd1b55b9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "15"
      ]
    },
    {
      "uid": "zhcn:747b17d73023682359b4ffd2",
      "kind": "character_system_text",
      "source_text": "嗯？指尖有点麻麻的……\r\n这是身体状况不佳的信号。\r\n得谨慎地观察一下。",
      "source_fingerprint": "7dc54f4921334a06d45274575e767d51ee1bf32788dc840f64d59ca2a6f06e87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20000"
      ]
    },
    {
      "uid": "zhcn:a8e6e3028eac65dee7910a20",
      "kind": "character_system_text",
      "source_text": "呼……不好意思，训练员君……\r\n忍着疲劳进行锻炼实在不合理。\r\n可以让我休息一下吗？",
      "source_fingerprint": "6ca1ea4615067ed712527505e658c141597f68ea0b0c98d3cbde3986659c9a80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20001"
      ]
    },
    {
      "uid": "zhcn:147be703cb8dfed77ec19406",
      "kind": "character_system_text",
      "source_text": "唔……需要重新建构方程式。\r\n不用说，当然是大幅上修。\r\n呵呵，状况太好也是个问题呢。",
      "source_fingerprint": "44b57633a00f017a7a92c652d9986a46e2aa5cf456007737bcb2471ec2c38e8b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20002"
      ]
    },
    {
      "uid": "zhcn:9f36f9b0e9ec4ba5ab55f13c",
      "kind": "character_system_text",
      "source_text": "喂，我可以下场去跑了吧？\r\n直觉告诉我，今天会获得\r\n相当优秀的成果……！",
      "source_fingerprint": "acbf43aaa05525a8cf69eb33764a563dee5a9fa5707c85b32b4563f9967c8e8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20003"
      ]
    },
    {
      "uid": "zhcn:975840aaeab2d44b0296aea5",
      "kind": "character_system_text",
      "source_text": "思绪清晰，身体动作也很利落……\r\n我可以替自己的良好状况打包票。",
      "source_fingerprint": "a4615c8afa8c3396dbb7578d9c1844e9c07c8f5b7130f399ad794614369e136a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20004"
      ]
    },
    {
      "uid": "zhcn:2abdda4cf5532f0f83657122",
      "kind": "character_system_text",
      "source_text": "现在的我应该能\r\n超乎预期地响应你的期待……\r\n说出你的计划来听听吧。",
      "source_fingerprint": "5e1f029c9cbd9c5cfd936a85ec2b8c61321ee12ee58d356dcd0ad9af1e5aacd2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20005"
      ]
    },
    {
      "uid": "zhcn:95ce79ee7767483bac4d9a8b",
      "kind": "character_system_text",
      "source_text": "我稍微做了一下热身运动，\r\n感觉状况还不坏。\r\n随时都可以开始哦。",
      "source_fingerprint": "cb5e1f3a5624f7abbfc5583e6f52b9ea31a9baeef48c21f5675a83efc17cc761",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20006"
      ]
    },
    {
      "uid": "zhcn:876961033a87cdf1591828b7",
      "kind": "character_system_text",
      "source_text": "今天要测试哪一道方程式呢？\r\n就在你挑的场地进行验证吧。",
      "source_fingerprint": "69bebf6e9a554729248685e56887b34d409bdb3f68854c4ac78539ca3d250879",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20007"
      ]
    },
    {
      "uid": "zhcn:40bab6000df5b402f07e69e4",
      "kind": "character_system_text",
      "source_text": "唔……今天还是早点结束吧。\r\n就算再硬逼下去，\r\n似乎也不会获得什么良好的成果。",
      "source_fingerprint": "383c221d980d21694808600b469a82204b5e3510ff5fe1bef80721f1eb41e5ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20008"
      ]
    },
    {
      "uid": "zhcn:ca234ae62fa9607927dbcbee",
      "kind": "character_system_text",
      "source_text": "──啊，抱歉。\r\n我在想一些事情……",
      "source_fingerprint": "0a31c05e180fc3c37a8c33c7c01fe992cb770e8195ec8c56743a20bce785e04a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20009"
      ]
    },
    {
      "uid": "zhcn:c471ad84b1b88bec42855122",
      "kind": "character_system_text",
      "source_text": "哎……实在是提不起劲。\r\n能够通过训练排除这个状况吗？\r\n……八成只会造成反效果吧。",
      "source_fingerprint": "d7f48434b9df30675f6f66834137d1f74a93cc27e9321898f03c34f117b35100",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20010"
      ]
    },
    {
      "uid": "zhcn:dd7c4decd1b3d01c0fff9d91",
      "kind": "character_system_text",
      "source_text": "下一个应该努力的课题是──\r\n唔……不行。我的思绪乱成一团，\r\n想不出恰当的说辞……",
      "source_fingerprint": "c05430da7a06f57f9b2319c9f2863ec215c77ce377d3c4e604099c15754e136a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20011"
      ]
    },
    {
      "uid": "zhcn:96a657fe6e4984c9e0072181",
      "kind": "character_system_text",
      "source_text": "唔，又要比赛？\r\n一直累积疲劳会让胜率……\r\n不，没事。就交给你处理。",
      "source_fingerprint": "aa8f0c643745a4958f50019541318e1ee7d3817c69e68bc283903b1cf618cf2c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20021"
      ]
    },
    {
      "uid": "zhcn:a9d8ce621f3a2e9edd7b892b",
      "kind": "character_system_text",
      "source_text": "还、还要比赛……我相信你应该有\r\n什么策略，不过……我也想拜托你\r\n重新评估参赛行程。",
      "source_fingerprint": "1831af46d1e27a168c8d30f08d74f6389a46c4605e6fb5251d4712ba13d389a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20022"
      ]
    },
    {
      "uid": "zhcn:1ec2dcd217619ccd3f7aba65",
      "kind": "character_system_text",
      "source_text": "呼……调整完美无缺。\r\n胜利就跟手到擒来没两样──\r\n训练员君，你就好好期待吧！",
      "source_fingerprint": "ad9847d5fd05664b942120ed13af0bab5947cf8628a6985ff40c77927278d873",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20023"
      ]
    },
    {
      "uid": "zhcn:ca5643eb391c0fa3ac767eac",
      "kind": "character_system_text",
      "source_text": "一切都是为了这天……\r\n接下来只要向众人证明\r\n我们的理论是正确的就好。",
      "source_fingerprint": "2c88b35b8a374fa4374675f2d23091fbee72fdf872be0b3eadc3b7568239e5ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20024"
      ]
    },
    {
      "uid": "zhcn:aab5f11f7861da142564f3ac",
      "kind": "character_system_text",
      "source_text": "状况良好，再来就是最后的一步……\r\n训练员君，拜托你激励我。\r\n你的一句话就是通往胜利的关键！",
      "source_fingerprint": "eaf3692e581150c8da99743287779b6cdd75602b51fca16a15c1912596535a15",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20025"
      ]
    },
    {
      "uid": "zhcn:c55b2d921fa01cf5ecf28bd4",
      "kind": "character_system_text",
      "source_text": "状态调整得大致如预期。那么……\r\n正式上场时也只要照我们的预测，\r\n拿下胜利这个结果就好。",
      "source_fingerprint": "41d7f765e49814e934c6ad8504877bf13dbe2c35633b6af7a6539cb0f316f79e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20026"
      ]
    },
    {
      "uid": "zhcn:eb93ebcb56acc47a97d4d61f",
      "kind": "character_system_text",
      "source_text": "准备就绪。你也……\r\n嗯，你的表情很不错。\r\n这样我就能放心作战了。",
      "source_fingerprint": "07f53cd0e7348079a23a508f9318eb5739c8484bc426d10a99d531d9b3172a84",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20027"
      ]
    },
    {
      "uid": "zhcn:be00ac7e6300b067cb355eb5",
      "kind": "character_system_text",
      "source_text": "来了……这场比赛就是重要关头。\r\n我要向一路累积而来的努力，以及\r\n一连串的方程式发誓……绝对要赢。",
      "source_fingerprint": "2c6121e3a8997dfe085370664db511ca6438234e8afc4ab87d860dfe7eb63399",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20028"
      ]
    },
    {
      "uid": "zhcn:4561a298284f13236af2eee1",
      "kind": "character_system_text",
      "source_text": "我们是以平均值为基准\r\n进行调整的。换句话说，\r\n即使状况平平也不成问题。",
      "source_fingerprint": "1caa66589deb15a375a2fcd800fdb7a91ae26824b4b528df3e31d86a3148265d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20029"
      ]
    },
    {
      "uid": "zhcn:f466914fc82c7e3bc089123e",
      "kind": "character_system_text",
      "source_text": "状况不好不坏……\r\n就是要考验我在正式比赛时的\r\n临场反应……是吧。",
      "source_fingerprint": "02b758e31e71454f6a1f1956d3be8458d20936a16a44ebe0ec1a3547a7eb69cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20030"
      ]
    },
    {
      "uid": "zhcn:9217b9e2b559ab9d58206f66",
      "kind": "character_system_text",
      "source_text": "就利用这场比赛……\r\n来验证我们的理论是否正确吧。",
      "source_fingerprint": "02d45b0cd2cb04869633fbb64b01ba37db2b8ee0a467874812f596cc2bfc4566",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20031"
      ]
    },
    {
      "uid": "zhcn:1672561191f365ad9bfe00c2",
      "kind": "character_system_text",
      "source_text": "想必没问题……才是。\r\n只要能发挥平常的表现就行。",
      "source_fingerprint": "5197c47d9a0cc31c02ae61dafc4281a4b32c53052343803d30b32dfef5ecaff3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20032"
      ]
    },
    {
      "uid": "zhcn:07e8d641b10c307f3666d989",
      "kind": "character_system_text",
      "source_text": "我对调整不满意，\r\n不过每个人的时间是公平的……\r\n接下来……就靠毅力去挑战吧！",
      "source_fingerprint": "51dc9613082b529c49d88fdc6901eacfa20d64a336cbdb9314385d603070233b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20033"
      ]
    },
    {
      "uid": "zhcn:ba082e82710357a9aff193e2",
      "kind": "character_system_text",
      "source_text": "我对调整怀抱着些许不安……\r\n先把临时改变计划的可能性\r\n也纳入考虑吧。",
      "source_fingerprint": "497eef680e452821b7e818c8e5d19554b9faf3a298c227d6fde9842628927596",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20034"
      ]
    },
    {
      "uid": "zhcn:767f19b313b72f04cc627975",
      "kind": "character_system_text",
      "source_text": "问题越困难，\r\n解开时的喜悦也会越大。\r\n没错，我……不会输的。",
      "source_fingerprint": "864659c4d0e1397775b60814712b3ead2800c5ea83dc55c9c30ebb31056243d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20035"
      ]
    },
    {
      "uid": "zhcn:21e5c8c6adfa7c63321a3d79",
      "kind": "character_system_text",
      "source_text": "……你是在紧张吗？\r\n的确，调整可以说是糟透了。\r\n所以……我才要加油。就是这样。",
      "source_fingerprint": "4e6d464780eb6534b11f70286f947ab2c07758c07d96a6db61de9e6d943cac37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20036"
      ]
    },
    {
      "uid": "zhcn:5d6251c25c219ebfb0863b99",
      "kind": "character_system_text",
      "source_text": "……我不追求什么奇迹。\r\n在跑步的当下我也会重新建构理论。\r\n我想要的就只有胜利。",
      "source_fingerprint": "b66e9b1d4caa3e3b10c30577f2dc68343a662b9b3988420f23b90522b0fbe0e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20037"
      ]
    },
    {
      "uid": "zhcn:65f7245a41bc0f6ed732e096",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20038"
      ]
    },
    {
      "uid": "zhcn:aee2fdfae675ec56b2f5da45",
      "kind": "character_system_text",
      "source_text": "了解。",
      "source_fingerprint": "0157e6aed55c5c02d6a5db10de6381ff48cf5d42afdf83c802629cb18e71b92a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20039"
      ]
    },
    {
      "uid": "zhcn:bf2a07b712f01dd611dbd502",
      "kind": "character_system_text",
      "source_text": "好……！",
      "source_fingerprint": "f93d3b7ef27d7cc0857d72ec2a4909bbb86efae229156b450540a7bebfc972c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20040"
      ]
    },
    {
      "uid": "zhcn:04d26bc1cb4e0b799c06d571",
      "kind": "character_system_text",
      "source_text": "嗯嗯……",
      "source_fingerprint": "26ff4925698843c3792c7f0bc377e245a84f32db565113d4ccaa189fe812f9dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20041"
      ]
    },
    {
      "uid": "zhcn:8f614ab12466ee265ed5f838",
      "kind": "character_system_text",
      "source_text": "什……！？",
      "source_fingerprint": "0024bd9c7e6a1e58e5d93f901b33058afae19cf6531d0d7c9688687f18d2005e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20042"
      ]
    },
    {
      "uid": "zhcn:f00ed88c5f38076b61af95c5",
      "kind": "character_system_text",
      "source_text": "怎么会……",
      "source_fingerprint": "fd6d8458e0d0c283a28cdf0b2904ed93a7dfbc7b68b667ed9ee61b5a7aaf69e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20043"
      ]
    },
    {
      "uid": "zhcn:b55ef498a30de79b90c12ce3",
      "kind": "character_system_text",
      "source_text": "我很期待。",
      "source_fingerprint": "fb68552f124570bd5245c78bdd75a028b4df21ce5b7bd41549967729dbf58354",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20046"
      ]
    },
    {
      "uid": "zhcn:b4ef50cbce88d121efa5e965",
      "kind": "character_system_text",
      "source_text": "天气真好……",
      "source_fingerprint": "975f803e947bf9ffbcfaaef4f8f40dc399863b4571d748b93298cd7656b9edad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20047"
      ]
    },
    {
      "uid": "zhcn:be12f26263fdfed00893a4e9",
      "kind": "character_system_text",
      "source_text": "又离完成更近了一步。",
      "source_fingerprint": "26098eb196c97a1bb0206f2a7afdb1eaff72b8c8e1657396fe9ebee556f6f6e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20049"
      ]
    },
    {
      "uid": "zhcn:00883ed61f2e403d0325d7fd",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员君。",
      "source_fingerprint": "a9af3af62964dff2d2a52e2d154d5948ec8553f2125507d64cdb6fa018e54727",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20050"
      ]
    },
    {
      "uid": "zhcn:a359dd821d3b693e08b00fc1",
      "kind": "character_system_text",
      "source_text": "有效率地进行锻炼吧。",
      "source_fingerprint": "a4ed97b85f9e0d144b8609c3efa5b2099ed04f9c4294744839ac6522138e96ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "20051"
      ]
    },
    {
      "uid": "zhcn:a31f5e0b95b9a9f4cfa88541",
      "kind": "character_system_text",
      "source_text": "好，去挑战吧。",
      "source_fingerprint": "3b1a602f76e0821564afc652f284f3f09fbdb4d7fa777de6ee1a11303e1db441",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "2030"
      ]
    },
    {
      "uid": "zhcn:0811ce8df614a823df038198",
      "kind": "character_system_text",
      "source_text": "那么，就依照作战计划进行。",
      "source_fingerprint": "55341cc92e865a811dce4c4b938250d93fcf47e0da4813270775fe711a2b8ddc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "2031"
      ]
    },
    {
      "uid": "zhcn:dd462d81d3265fc033deda4f",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员。",
      "source_fingerprint": "3fe14dbaa33cedbb8817cc5c67738ef9044c00c157d89590bd87233379d01774",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "2032"
      ]
    },
    {
      "uid": "zhcn:a737a24083fe1027eb3038f4",
      "kind": "character_system_text",
      "source_text": "来了……这场比赛就是重要关头。\r\n我要向累积至今的努力，以及\r\n写下的方程式发誓……绝对要赢。",
      "source_fingerprint": "22a9b51cd2e2a3e18201f1453b992c40cf27ae6297df343ff5f10fce9b1acb19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "2033"
      ]
    },
    {
      "uid": "zhcn:48078405f73bb18fe87b53d8",
      "kind": "character_system_text",
      "source_text": "状况良好，再来就是……最后一步。\r\n训练员，拜托你激励我。\r\n你的一句话就是通往胜利的关键！",
      "source_fingerprint": "3ab6ea923375dae7af78f1557b890e02108150c5ea757b89395f64a5e27bc944",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "2034"
      ]
    },
    {
      "uid": "zhcn:47a860b7f202539680f6e49a",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员。",
      "source_fingerprint": "3fe14dbaa33cedbb8817cc5c67738ef9044c00c157d89590bd87233379d01774",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "2035"
      ]
    },
    {
      "uid": "zhcn:3575cd59f01d150424fc503b",
      "kind": "character_system_text",
      "source_text": "始めようか。",
      "source_fingerprint": "64a83ada31fcd254c92b8bc8e60c0d781207c215eb83bdec94794f4be2e9d8f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b09264200cd70d8312796bcc",
      "kind": "character_system_text",
      "source_text": "我看见通往第一名的轨迹了！",
      "source_fingerprint": "8c6a60d296f5fda854b2f5dcd1b02d3d54a64ab5f4a5ada56a5daaeabef3a572",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30000"
      ]
    },
    {
      "uid": "zhcn:38f89b91f8a73bd4f2102b13",
      "kind": "character_system_text",
      "source_text": "唔，都在预测范围内……不过──",
      "source_fingerprint": "041c7da9588793b0a047ba984db794fe8afe0c462b054ed55db86c2553bf3202",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30001"
      ]
    },
    {
      "uid": "zhcn:6bd7a967e0eb05852392786a",
      "kind": "character_system_text",
      "source_text": "方程式需要进行调整。",
      "source_fingerprint": "380cad4c1cc347bc7936cd6f49fe2780749699559a74698ea6d468ebef711d76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30002"
      ]
    },
    {
      "uid": "zhcn:81ea07ef36dc1c75577c5496",
      "kind": "character_system_text",
      "source_text": "我导出的解答有错……是吗？",
      "source_fingerprint": "fd3f001492ab110754555372beca8c74b712f74d79e1f1b048b2efdc3b3d359f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30003"
      ]
    },
    {
      "uid": "zhcn:66efdb3749c390e3f2ef9454",
      "kind": "character_system_text",
      "source_text": "呵……怎么样，看到没……呃，你靠太近了。",
      "source_fingerprint": "99978b0c341fb4e9c6cb1fec335690c4b78e22a3768b5027bfdac257304999d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30004"
      ]
    },
    {
      "uid": "zhcn:c7f6c8cd770037eee2e1aef5",
      "kind": "character_system_text",
      "source_text": "嗯……我料到了呢。",
      "source_fingerprint": "eee26bb98253b159107f41a782ada2b5647b6f94752b52e426c1d4da60d3ccef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30005"
      ]
    },
    {
      "uid": "zhcn:4fa3f5cc140be0306f5782bd",
      "kind": "character_system_text",
      "source_text": "似乎能听见祝福的铃声……！",
      "source_fingerprint": "f039a7376c20b2aeac1d67e030f1224cb440a979440992037cb6776d90836cdd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30006"
      ]
    },
    {
      "uid": "zhcn:d1bd5dc2fed78d83f3dbc8f1",
      "kind": "character_system_text",
      "source_text": "嗯……可以说是如我所料吧。",
      "source_fingerprint": "cd023921aa99cf33e892f09b83be49f5f8c9f674bc1b342176bb3d1551d4f062",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1023",
        "30007"
      ]
    },
    {
      "uid": "zhcn:c22c8c9625a9920b1d8ccac7",
      "kind": "character_system_text",
      "source_text": "Q.E.D.…\r\n分析通り、だよ。",
      "source_fingerprint": "b2c672ed0578fd7efeb3a141edf5b738d2956a27c5178d7f6924c5cd74c41ef7",
      "source_path": "character_system_text_dict.json",
