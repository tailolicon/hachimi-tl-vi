      ],
      "json_pointer": "/1025/90006"
    },
    {
      "uid": "zhcn:8df23c18e6221ad48cc91d0b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "阳光越是耀眼，\n影子看上去也越是浓重……\n感觉比平时更加接近了……",
      "source_fingerprint": "a6839d672edf57d19703962ef1fa026e53a5b423076df2be334ce45356d2e7e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
