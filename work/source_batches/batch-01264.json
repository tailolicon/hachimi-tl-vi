    },
    {
      "uid": "zhcn:ade2d8dfb1ed5d992b2b2b8e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "祭りの季節は、散歩をよくします…\r\n夏の夜空を彩る万華鏡を、\r\n独り占めできる場所を求めて…。",
      "source_fingerprint": "f916935b54d006a05b2870053caa1e3a2200adb52fbc5678614f3f0a81b29955",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
