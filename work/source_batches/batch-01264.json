    },
    {
      "uid": "zhcn:0e544bbfee89fe0ce09d5448",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "授業中、ポッケさんがうとうとして\r\nいたので…眠気覚ましに、珈琲を。\r\n水筒に入れて持ってきているんです",
      "source_fingerprint": "5b13834f4bf480879dd73456ef42bbd3f917db28c5a27f4d67432ce13334201b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
