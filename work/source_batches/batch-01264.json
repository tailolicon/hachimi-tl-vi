        "1025",
        "90001"
      ],
      "json_pointer": "/1025/90001"
    },
    {
      "uid": "zhcn:582650cf7d14060fa4d11008",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "……您好。\n……阳光真是刺眼呢。\n比起太阳，我更愿意委身于北风啊……",
      "source_fingerprint": "84df1f21f79fbce76ce1b19736fc754f22d410e21e137d0dcd4ed931692671a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
