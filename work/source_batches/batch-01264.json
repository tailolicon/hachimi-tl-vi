      ],
      "json_pointer": "/1025/90014"
    },
    {
      "uid": "zhcn:851b31a3521db5a3ba21b4e6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "夜の和カフェは、お伽噺の世界…。\r\n幻想的な月明かりの庭園を、\r\nいつまでも眺めてしまいます…。",
      "source_fingerprint": "cf402a913325ba085f47ebbe777b0353e15f54da085ccfe0642a73802b6ba65e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
