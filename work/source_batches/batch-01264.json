      ],
      "json_pointer": "/1025/90009"
    },
    {
      "uid": "zhcn:da83da2ca7dde05d45e0a689",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "和菓子と共に、心穏やかな朝を…。\r\nたまには、そのようなひとときも\r\nよろしいかと…。",
      "source_fingerprint": "17daef74dd0cb462ac45c2f9a4fdf46611ab1f826817bb48ef1f40d969651cba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
