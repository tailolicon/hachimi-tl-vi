        "1025",
        "90002"
      ],
      "json_pointer": "/1025/90002"
    },
    {
      "uid": "zhcn:37f97780bab019a83705cae8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "总觉得在白天使不上劲……\n训练也安排在日落之后更好吧……",
      "source_fingerprint": "5719adb4d59bcd78ddf8678404d8b8d2b8682699e68b6d6a26af308891d89b7d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "90003"
      ],
      "json_pointer": "/1025/90003"
    },
    {
      "uid": "zhcn:3bcff391e1c964cc15a520a6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "到晚上了呢……\n与另一个世界的境界线也变得模糊了……\n您听……有声音……",
      "source_fingerprint": "60c07175851de976b2500c9dad5f94a042925320d4893fa722bd48a8f5c5f7e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "90004"
      ],
      "json_pointer": "/1025/90004"
    },
    {
      "uid": "zhcn:1dccac45e302f720a452e865",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "獏是吞噬噩梦的生物。\n这样的话，说不定我也会碰上它们呢……",
      "source_fingerprint": "bb2ff7136207fca2e2d988a208e700401470bf2ff142d43455a1862cc2677e0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "90005"
      ],
      "json_pointer": "/1025/90005"
    },
    {
      "uid": "zhcn:627cdea001cb716a9b6f1612",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "山蕨……荚果蕨……紫萁……\n在这个季节都冒出新芽了……\n……看上去很惹人怜爱呢。",
      "source_fingerprint": "329d9a8c4c2c22db545138b137e21f6cc2474fdcfad51056c501cfed8313d634",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
