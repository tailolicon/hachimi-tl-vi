      ],
      "json_pointer": "/1025/90012"
    },
    {
      "uid": "zhcn:26c79a228e15e4dc164b099b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "午後のおやつはお済みですか…？\r\n猫のお饅頭、耳の形をこだわったら\r\n…作り過ぎてしまって…。",
      "source_fingerprint": "220c6e835e04dcb3e37d2d245f449b1fe5c7d5be9c30f102b422994e2bfd4c10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
