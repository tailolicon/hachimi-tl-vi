    },
    {
      "uid": "zhcn:2c6cc69e3e82d5cdf1bb6cae",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "渋い玉露で、朝食を…。\r\n珈琲以外で朝を迎えるのも…\r\nほっとしますね…。",
      "source_fingerprint": "7c838e099f203963bf633dabaa0d966d66f6e4dd4ca0306476e56750a742d391",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
