  "entries": [
    {
      "uid": "zhcn:a33044296f381c0fac8d50ce",
      "kind": "character_system_text",
      "source_text": "真是太幸福了……！！",
      "source_fingerprint": "88391cf3344987d68cb8a41f1d70064433743361237bcc8660c030b29e364e81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140006"
      ]
    },
    {
      "uid": "zhcn:d49c753756b9f36ae545d8d3",
      "kind": "character_system_text",
      "source_text": "我想守护这个笑容……",
      "source_fingerprint": "cb3490e39aebd016851e4e6d9fca657a778c20a5415bb1f54c585b5440257362",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140007"
      ]
    },
    {
      "uid": "zhcn:7eb4c93dfe73cce9225e7f17",
      "kind": "character_system_text",
      "source_text": "嘿嘿。",
      "source_fingerprint": "6d0212cb1ec9201ff17e6acf0ea2d70e06cf290b6bc356f0e84aed5329a8a9e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140008"
      ]
    },
    {
      "uid": "zhcn:9c8e30a5cb90c89f2d06d6db",
      "kind": "character_system_text",
      "source_text": "嘻嘻～♪",
      "source_fingerprint": "5ee07589d0dafefd683ec555751912c2e0c4dd61b462883cb00db726f9844fcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140009"
      ]
    },
    {
      "uid": "zhcn:f1b7245f256dfa09ebe80d2b",
      "kind": "character_system_text",
      "source_text": "嗯呵呵～♪",
      "source_fingerprint": "21d564d71f4f5acbcef41831f4e23216ef802cdb200fa3db9f83f736a29b14a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140010"
      ]
    },
    {
      "uid": "zhcn:7925d60b65b3fe8d2523aabc",
      "kind": "character_system_text",
      "source_text": "咻～！",
      "source_fingerprint": "ad0011331fc8a6ba3d81558aed62f999676ac033c1a24928b1a8f02d267dd79f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140011"
      ]
    },
    {
      "uid": "zhcn:1de7baf0063ade3e568397f1",
      "kind": "character_system_text",
      "source_text": "感谢感激～！",
      "source_fingerprint": "0fa164c34867a98b0ff5ac6b550e0b4fe857ad5e59d2dcb4b09ffb140aae8e33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6d803272166998bd95afd62a",
      "kind": "character_system_text",
      "source_text": "唔喔！！",
      "source_fingerprint": "b199d992afd58eba93ca59a3ea64f042742e03af4862726fd9eace3d1ce55f46",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140013"
      ]
    },
    {
      "uid": "zhcn:314c86337ba0613408583f15",
      "kind": "character_system_text",
      "source_text": "不会吧……",
      "source_fingerprint": "e31c35f70d7c744b83bc72158756412d6e478ca58535d60a4497a46728be4786",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140014"
      ]
    },
    {
      "uid": "zhcn:2bd81af271d1b9c54348826c",
      "kind": "character_system_text",
      "source_text": "喔～～～～！",
      "source_fingerprint": "452cecfe42a730aaccc88f0784e9113f28a830ee38f3e36604ef8b486f471a62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140015"
      ]
    },
    {
      "uid": "zhcn:14f0fc153392c798c2881f6b",
      "kind": "character_system_text",
      "source_text": "训练员！",
      "source_fingerprint": "db758361d8551e39a471bf33f6afd51a4ac97f8b37ad978fd6a2ae4b2c6720a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140016"
      ]
    },
    {
      "uid": "zhcn:43224b2fb2379749b405b312",
      "kind": "character_system_text",
      "source_text": "唔欸欸欸欸欸～！！",
      "source_fingerprint": "36f97b20b7898296743d713f6104b441b07927b10afd6a1ad08aff93bf33ae78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140017"
      ]
    },
    {
      "uid": "zhcn:4d93e14dabeab9f2e95e462c",
      "kind": "character_system_text",
      "source_text": "哇啊啊啊啊！！",
      "source_fingerprint": "8301aeda4a58ce382e352b738b56223d0e83263685578b7377a07bbe7e22935c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "140018"
      ]
    },
    {
      "uid": "zhcn:fd91123771cc9c8cdfbae271",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个哦～♪",
      "source_fingerprint": "470140509be06ec97f88886f47299438cdf6da38761aa06bcc1a4d6d8ba3d1c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "15"
      ]
    },
    {
      "uid": "zhcn:9028a66e0bf92426d4fd9a54",
      "kind": "character_system_text",
      "source_text": "支持自己的推也需要体力……",
      "source_fingerprint": "6b79bbabff5a5f6ad11a96c7e5ae17f200eec072d9b5a57bd50a28d489b1899c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20000"
      ]
    },
    {
      "uid": "zhcn:a0444d6d1357ff0124386e63",
      "kind": "character_system_text",
      "source_text": "我这样的状态，\r\n实在是太对不起\r\n那些赛马娘了……！",
      "source_fingerprint": "12c76ee0b9cb9e3d7dc712e40c0a97a9dbe0a8f1733aac91c5f8ec6b6b0963cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20001"
      ]
    },
    {
      "uid": "zhcn:2ab2eba0aac1d37919c9d0f7",
      "kind": "character_system_text",
      "source_text": "萌力MAX全开！！\r\n带着源源不绝的力量上场吧！！",
      "source_fingerprint": "54c54e059f3f1807b820258bc00c472a23714c82496304753f26a41b9b80e488",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20002"
      ]
    },
    {
      "uid": "zhcn:ccd34d3575529f9ca0730059",
      "kind": "character_system_text",
      "source_text": "那边跟这边都是赛马娘！\r\n呼～受不了！！\r\n我现在什么都办得到喔～！！",
      "source_fingerprint": "d37d820013c9970271cc0a5c6a164dae3271db64d1a7c739f43818242cc0cd35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20003"
      ]
    },
    {
      "uid": "zhcn:43fad557c1c0820ba4e6b1c8",
      "kind": "character_system_text",
      "source_text": "在我的推附近训练……！\r\n不能松懈呢！",
      "source_fingerprint": "a8458f36f26d59c4d2107ffda369d6e160caf49ce41d40225137fb458822aaa0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20004"
      ]
    },
    {
      "uid": "zhcn:939a3b8b4525a4b46f7240dc",
      "kind": "character_system_text",
      "source_text": "请下指令！\r\n不管你下什么指令，\r\n我都愿意做！",
      "source_fingerprint": "c1ee559dda01d06b9e89b5f53bf020b60f092458d49d1ce694c068d6b6e44fa8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20005"
      ]
    },
    {
      "uid": "zhcn:63fae83905ff38de003c6548",
      "kind": "character_system_text",
      "source_text": "来吧来吧，\r\n今天也要行善积德喔～！",
      "source_fingerprint": "7f99d3b449359aa3f88fcc358cdc91de527173eafe699e488e4b78a44e2b0611",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20006"
      ]
    },
    {
      "uid": "zhcn:ca18edaf191e8068e369ba5e",
      "kind": "character_system_text",
      "source_text": "等该做的事都做完\r\n再来进行推活！来，开始吧！",
      "source_fingerprint": "135e8bb01c198458ca0af2a2e157fbbd017a10c7f096993b25875a3e302cb834",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20007"
      ]
    },
    {
      "uid": "zhcn:79ea339fcc4af1abcc8c13e9",
      "kind": "character_system_text",
      "source_text": "总觉得没什么劲呢……\r\n心情上比起自己跑，更想观战～",
      "source_fingerprint": "c2fc592a667fc8123284863153dd6a352a3d5abe6262d41a7ba83fa4174744a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20008"
      ]
    },
    {
      "uid": "zhcn:e4b2e8e72860ce6d77a6475f",
      "kind": "character_system_text",
      "source_text": "喔嘿……\r\n……啊，对不起，\r\n我刚刚在看旁边的赛马娘。",
      "source_fingerprint": "1092582a7b4b5ba576484869503c9cbb541800002e282b3fe59773e7bf46944d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20009"
      ]
    },
    {
      "uid": "zhcn:587d7167cb6257848393c11a",
      "kind": "character_system_text",
      "source_text": "啊啊……赛马娘的足迹……\r\n我可以看一辈子……",
      "source_fingerprint": "725e751bf2d976e52860a05b499bb15358d6b5957f8d59132caac1bd73d9137f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20010"
      ]
    },
    {
      "uid": "zhcn:4be3af61df3cb3062543ee41",
      "kind": "character_system_text",
      "source_text": "下辈子要是当个种胡萝卜的农人\r\n也不错耶……",
      "source_fingerprint": "a1952e0b861d66dadb46e11d0d91ccc544f7705c24f2a90b6713f84051286144",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20011"
      ]
    },
    {
      "uid": "zhcn:56d13cc8341d5b441ad6c115",
      "kind": "character_system_text",
      "source_text": "虽然很感激能跟我的推一起跑……\r\n但难道不会因为勉强别人\r\n给周遭添很多麻烦吗？",
      "source_fingerprint": "5bf87af3b45a306f5d535193231fb4e3a8efe0aed6a666b2a39c93ccebfef379",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20021"
      ]
    },
    {
      "uid": "zhcn:29cfc8806d96d4cd771cc5e2",
      "kind": "character_system_text",
      "source_text": "真的没问题吗……\r\n以这种状态出赛，\r\n应该会造成旁人困扰吧……",
      "source_fingerprint": "1eaabda26a3fb8c9ee7397e4308db2633f590891688e25a41060f79a69de476b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20022"
      ]
    },
    {
      "uid": "zhcn:f8c965afd03393caa7e9949e",
      "kind": "character_system_text",
      "source_text": "我等这一天等很久了！！\r\n来吧来吧，我会尽全力\r\n感受着赛马娘喔～～！！",
      "source_fingerprint": "a0708f4b6bd419cf6af0c58a355c3e93060417bf84a3b5c61bed9bacb7a030aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20023"
      ]
    },
    {
      "uid": "zhcn:b5b32ab35421aef6f78c24e7",
      "kind": "character_system_text",
      "source_text": "哈～～呼…………！\r\n太兴奋也不行啊！\r\n反而会没办法顺利跑！",
      "source_fingerprint": "b2c1701270ad46b77d18ac16991e18b3ea270aa49e75562dd76276e4c2cffae5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20024"
      ]
    },
    {
      "uid": "zhcn:386e496802aff01acd60ec6f",
      "kind": "character_system_text",
      "source_text": "胜者舞台要用的扇子和手灯\r\n我都准备好了！\r\n嗯，已经做好万全准备咯！！",
      "source_fingerprint": "a8328a532ce64bf82872870bc87aa34b6c9c10412b2e16911bdafef51ae2498a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20025"
      ]
    },
    {
      "uid": "zhcn:b602778662cc96e07e578aa4",
      "kind": "character_system_text",
      "source_text": "今天赛马娘会露出\r\n什么样的表情……！？唔呵呵，\r\n已经等不及要比赛了呢♪",
      "source_fingerprint": "fcc98a2b39824c694a9c0857c0fede0fd0761d925b2c6f4712576c603b683cfa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20026"
      ]
    },
    {
      "uid": "zhcn:7086554656b4775f3e5543ad",
      "kind": "character_system_text",
      "source_text": "既然要跑，就要用尽全力！\r\n我一定会好好努力，\r\n不然对我推的大家就太失礼了！",
      "source_fingerprint": "ebad0c326bc48575b528722491898ed189ec1dedccb80cd82d6635bc5530b1d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20027"
      ]
    },
    {
      "uid": "zhcn:bfdf55e33dff8d12689e3158",
      "kind": "character_system_text",
      "source_text": "相机准备好了吗？\r\n观众席的拍摄角度\r\n就交给你咯！",
      "source_fingerprint": "59c94d67d454a867262b2e64122cbd5ee236c6a7c125421cb825e5501a4c79cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20028"
      ]
    },
    {
      "uid": "zhcn:ff689ea3a5b2b2c0a83fdbe5",
      "kind": "character_system_text",
      "source_text": "谨守着清白正直的分寸！\r\n数码碳要上场咯！",
      "source_fingerprint": "f1e333080c04250fdfdaf3bfc7a1cf7edfdd90afdde6b583c2ff72cf45f36df1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20029"
      ]
    },
    {
      "uid": "zhcn:89aa46c59d80c431dd9c32e9",
      "kind": "character_system_text",
      "source_text": "当然要冷静！\r\n拿出全力投入比赛才是有礼貌的行为！",
      "source_fingerprint": "6fcb8e0af1a139449d0a0e39358a1c112b12df69ad2c73443c64e2be5dddfd12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20030"
      ]
    },
    {
      "uid": "zhcn:6ebf626226541e2213f947e1",
      "kind": "character_system_text",
      "source_text": "之后请告诉我\r\n从观众席观看的感想喔～♪",
      "source_fingerprint": "2ff69ddacb6ec3302d6bb94b9a628c28337a207fba982f5af90254e59d5bf406",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f786702e3ee3a7ea29bfcb40",
      "kind": "character_system_text",
      "source_text": "只要站上赛道，\r\n应该就会开始涌出萌力……！",
      "source_fingerprint": "f65e7c72b8d6379f8ce7e945c5b96945ab6b32ac456c81bc26ab2f5035a8eb48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20032"
      ]
    },
    {
      "uid": "zhcn:9e1463a4eac63fd5d215dd4f",
      "kind": "character_system_text",
      "source_text": "今天的心情\r\n想在观众席看比赛……\r\n不，没什么。",
      "source_fingerprint": "b260e3383ec26970101a7eaf1a6653226c04cccbb6a3869ad9428f7adc64e28e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20033"
      ]
    },
    {
      "uid": "zhcn:4d270ae579952f3a2b7dc858",
      "kind": "character_system_text",
      "source_text": "……你不觉得比赛的参赛名单\r\n永远都看不腻吗？",
      "source_fingerprint": "3e206e4552a0bdb2b9247843877b74c8b3297343aeee71c58ee1dead2eba7789",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20034"
      ]
    },
    {
      "uid": "zhcn:565e8625bb3e1539b934a7b0",
      "kind": "character_system_text",
      "source_text": "唔哇……！请给我\r\n能转换心情的萌图……！",
      "source_fingerprint": "07237d9a69764e062b90d90d9552cd22586cdd6f44adf9e0b2bd8e5abcb2808b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20035"
      ]
    },
    {
      "uid": "zhcn:0c3adef6850f985b36461fc1",
      "kind": "character_system_text",
      "source_text": "不行不行，\r\n我可不能玷污圣地……！",
      "source_fingerprint": "64a577bfa5aba0fa064edd771d124368eb46389078d6b90e34ca075a06435393",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20036"
      ]
    },
    {
      "uid": "zhcn:d063d278ca7d51c34c84c5e8",
      "kind": "character_system_text",
      "source_text": "只要心中抱着对赛马娘的敬爱……\r\n这不算什么……！",
      "source_fingerprint": "2b7dea63595c6dcb7c2079cc6c2a4dc87b825942f1beda11fcdca0e078212683",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20037"
      ]
    },
    {
      "uid": "zhcn:017549a518ea2ffb0c6e0e9c",
      "kind": "character_system_text",
      "source_text": "我上场了！",
      "source_fingerprint": "092de8b679dc1d62be9d0345f00b41ce5d39669391cc434ea8f1c32929be88df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20038"
      ]
    },
    {
      "uid": "zhcn:a8cd8670026348ddc1dceb42",
      "kind": "character_system_text",
      "source_text": "就这么做吧！",
      "source_fingerprint": "ed55896a91ce9fb27f01c61fc08829813f56c7c7f85176544912f96748735bb8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "20039"
      ]
    },
    {
