    {
      "uid": "zhcn:d6642238fe4328b5105c574d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "かまくらは、無彩色の殻…。\r\n冷たくて薄暗い、心落ち着く場所…\r\nよければ、お試しを…。",
      "source_fingerprint": "0d284f27c979d3efe0bf3236322911342059a8976a0c9ef9649ab19d5e36ea4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
