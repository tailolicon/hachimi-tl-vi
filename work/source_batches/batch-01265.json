    {
      "uid": "zhcn:a125bc4c4137816cce63ff04",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "より、味わい深く…。",
      "source_fingerprint": "ba71beab15c04302f24138237c2ec295b75b56c74ec85286d7fdda28e16e5309",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
