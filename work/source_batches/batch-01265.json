      ]
    },
    {
      "uid": "zhcn:31869c536dcdd49b3fc62b73",
      "kind": "character_system_text",
      "source_text": "真是太感谢了──！",
      "source_fingerprint": "ec733b0dd84b4b80c6ac6a39572ea8a9bfc4fd862ae3bb203552364434e33094",
      "source_path": "character_system_text_dict.json",
      "json_path": [
