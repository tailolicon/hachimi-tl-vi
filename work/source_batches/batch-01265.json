      ]
    },
    {
      "uid": "zhcn:377c8a2c6832e594e7ded594",
      "kind": "character_system_text",
      "source_text": "やりましょう！",
      "source_fingerprint": "cad7852a5c5aeec01aa0c9c47d3ea898f960f2e81840032e46be93a5edfd526c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "23015"
      ]
    },
    {
      "uid": "zhcn:112f69b6b0c4940d1dc63884",
      "kind": "character_system_text",
      "source_text": "还差一点就到最佳位置了！",
      "source_fingerprint": "7ece6c71af72a153928be9981836f9386a29016de243cff93378dc0066389bbf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30000"
      ]
    },
    {
      "uid": "zhcn:918f9bada679e56ba2560461",
      "kind": "character_system_text",
      "source_text": "这角度不错！",
      "source_fingerprint": "a08e62def92819ab393a39a624f72a36c16d8b3913d2a0dcf6096eb3e0502bb4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30001"
      ]
    },
    {
      "uid": "zhcn:68f1d2e9ea6284439fb54093",
      "kind": "character_system_text",
      "source_text": "希望能更注意角度！",
      "source_fingerprint": "21bfa795dd7616461029ea274ece1f24923c968ea81d28d3aad58b49032629de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30002"
      ]
    },
    {
      "uid": "zhcn:3ea19cd560adc6977b734f3b",
      "kind": "character_system_text",
      "source_text": "虽然背面也不错啦……呜呜～",
      "source_fingerprint": "8528a4863ec1025cbd3ec1dea5eddd708298523da7956c1a6d4aef10121a5537",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30003"
      ]
    },
    {
      "uid": "zhcn:aafdd3d7e7d02758056ee2b9",
      "kind": "character_system_text",
      "source_text": "咿～～～！！感谢这样的幸福～～～！！",
      "source_fingerprint": "79cf0e37d57aa35a0addfa57bd702282149cb8302283ef35f37c525fbb35c4ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30004"
      ]
    },
    {
      "uid": "zhcn:ba1e3b939b2fc76dd5afbec5",
      "kind": "character_system_text",
      "source_text": "我吃饱了！",
      "source_fingerprint": "9885a3615f9d018bb9eb01b1e327a40ef9ca4ed64b41d698a006cc70f74d86b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30005"
      ]
    },
    {
      "uid": "zhcn:c4ebf89d97230bce06350df3",
      "kind": "character_system_text",
      "source_text": "这份！热情！\r\n用什么符咒都无法制服～～！！",
      "source_fingerprint": "1f21306b3ab944ab5ca59cd98baf7ac1f32e02b0fccd865e16c423dafad15662",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30006"
      ]
    },
    {
      "uid": "zhcn:a1583de510209807b3b1b848",
      "kind": "character_system_text",
      "source_text": "我吃饱了！",
      "source_fingerprint": "9885a3615f9d018bb9eb01b1e327a40ef9ca4ed64b41d698a006cc70f74d86b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "30007"
      ]
    },
    {
      "uid": "zhcn:fa59a7d253e437c1460c7540",
      "kind": "character_system_text",
      "source_text": "我们走吧！",
      "source_fingerprint": "7b58d964d17854a803d16140a894079104ae8c9281e306d5f49a7ec42fc0837d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d9343f6f40104dd72590d71a",
      "kind": "character_system_text",
      "source_text": "赞赞！尊爆！我的女神！",
      "source_fingerprint": "ac797239ca81bf47d7157a20951265d84a8c5d6dca7b5d5158811b1315cd6b37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "40000"
      ]
    },
    {
      "uid": "zhcn:cd14cefd1fcca41ce6d70618",
      "kind": "character_system_text",
      "source_text": "跟、跟赛马娘们同心协力\r\n在圣蹄祭摆摊……！？\r\n青春之光会让我蒸发了啊～！",
      "source_fingerprint": "ef97720ee0eff13cbe20c4587cf7ad59f05ab2af595a420a9cea41b668d95c64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "400001"
      ]
    },
    {
      "uid": "zhcn:9cfb0af361fa54839ce789eb",
      "kind": "character_system_text",
      "source_text": "阿宅是绝对不能对推逾矩的。不过，\r\n如果我们原本就有另一层关系……\r\n不行，我做不出那种事……！",
      "source_fingerprint": "8ab346ee1dfa3fa9d11d34c594ae545aeb490268c0c48f20800fb83e2e1ee2f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "400007"
      ]
    },
    {
      "uid": "zhcn:9d4107368ee8bd6561b6688d",
      "kind": "character_system_text",
      "source_text": "那边！这边！还有那边！\r\n全部！喜欢！好喜欢！\r\n补充萌力，加到MAX！！",
      "source_fingerprint": "18b2feab4bfb7f5d50aa7467a615a6fe9f8dcf2afe4672a93256d4368b298065",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "40001"
      ]
    },
    {
      "uid": "zhcn:b49e4f7c2a0f9f91b9302870",
      "kind": "character_system_text",
      "source_text": "希望明天起我也能时时牢记……\r\n我的推同时也是劲敌，\r\n更是自己的伙伴！",
      "source_fingerprint": "5bdd64dd8ee5ad4a8733f4b7b21244893bb89da3cd5a1c27aabb133e031580c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "400011"
      ]
    },
    {
      "uid": "zhcn:02f1c27a8c2e6011e2253ddd",
      "kind": "character_system_text",
      "source_text": "既然已经创造了快乐回忆……\r\n来吧，本季度也要尽全力\r\n大推狂推猛推各位赛马娘喔！",
      "source_fingerprint": "2a3746f0e705306bc241d3340d17cb53aab1adaf4c882bb6c9dfd59f731ef364",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "400014"
      ]
    },
    {
      "uid": "zhcn:47f2f067650d6aa587cc5221",
      "kind": "character_system_text",
      "source_text": "萌到复活的阿宅殭尸（吸气）……",
      "source_fingerprint": "bff98255ca3c1202f67d679354e4af74953356922b9cb5b0f596aff655e422e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "40003"
      ]
    },
    {
      "uid": "zhcn:dc7ca11c722a6a9ec5a576c4",
      "kind": "character_system_text",
      "source_text": "……我看到了……呜嘎──！啊啊\r\n啊……太～尊～了～～！发粮啦～！\r\n喝！发狂阿宅嘿呀嘿……（倒下）",
      "source_fingerprint": "b48800be867a91515ea48a63aa277ac9326c99829bd147336e0d41994434658d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "40004"
      ]
    },
    {
      "uid": "zhcn:e06d655fa0a508fc199dcdd0",
      "kind": "character_system_text",
      "source_text": "好了好了，演唱会的时间到了！\r\n各位同志，现在是展现热情的时候咯～！",
      "source_fingerprint": "ad527eb3d9c63e65770bd07018f92dc97de31ccb869c2940263fcdf01e9bf4ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "60000"
      ]
    },
    {
      "uid": "zhcn:0c9629cd771cc52505860fef",
      "kind": "character_system_text",
      "source_text": "手灯就拜托你了……！\r\n拜托连我的份一起用力挥……！！",
      "source_fingerprint": "e2e88fcff41d78ff7a684eb09e66b6f501bf08dabc0de0978ff4f70e58d58ea3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1019",
        "60001"
      ]
    }
