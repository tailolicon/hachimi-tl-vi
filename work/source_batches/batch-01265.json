    {
      "uid": "zhcn:197e8b27c0ca51fc6c6462ec",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "情人节……快乐……",
      "source_fingerprint": "a6286e7515e45ee73edfb6ac96e24de5e1bedc073e7fc40ecca5a2b6af533c60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
