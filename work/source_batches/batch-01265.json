        "1025",
        "95007"
      ],
      "json_pointer": "/1025/95007"
    },
    {
      "uid": "zhcn:6d5f0c8650dcd7830e5cf387",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "誰も知らない風味へ…。",
      "source_fingerprint": "2d08850c1ed98e462c8006ca8ead0f482239af3117ddca200ebc07e9c0cc1899",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "95008"
      ],
      "json_pointer": "/1025/95008"
    },
    {
      "uid": "zhcn:6f2074ef1888f77e526c59cc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "1杯の珈琲と、\r\n至福の時をアナタに…。",
      "source_fingerprint": "92aa7689aa02d296020319898a4aedff2be0cc20638c2758f28809e96c8b3723",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "95009"
      ],
      "json_pointer": "/1025/95009"
    },
    {
      "uid": "zhcn:7cc1aca53004a77670521ff4",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "マンハッタンカフェです…。\r\nどうぞ…ごゆるりと。",
      "source_fingerprint": "5bef49bb4f28f24a513ed03c173c3ad35610bd0c3ef200e2836975901c4131c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "95010"
      ],
      "json_pointer": "/1025/95010"
    },
    {
      "uid": "zhcn:9d6490af6bf8804883c3fc34",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "比赛模式，启动。",
      "source_fingerprint": "ca441dc7cc04b4602fb5d0c1bfb8d209aadfc907689aee243adb39340246d0bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "1000"
      ],
      "json_pointer": "/1026/1000"
    },
    {
      "uid": "zhcn:44b0b20c6b95315feb17bfa6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "『成为三冠赛马娘』…此项，已作为\n“目标”而非“梦想”设定完毕。\n…与主人签约那天起就开始了。",
      "source_fingerprint": "569b779e8c05b0c6e5615fd1ee7faacfdba990fa916a027ee6e75ab9ab822843",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10000"
      ],
      "json_pointer": "/1026/10000"
    },
    {
      "uid": "zhcn:8f62cef898438c79e0d313e5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "出発します。",
      "source_fingerprint": "7a4ece5b9dddc32ab5e61e89a32731c83245ec9e506960297a935cf110870a60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "100000"
      ],
      "json_pointer": "/1026/100000"
    },
    {
      "uid": "zhcn:a6eea16ddb3d83b3f78e78a2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "帰還しました。",
      "source_fingerprint": "76d5015233db10712604999b262e5063a8dad535dc0dd2cd8186b7163ccefdda",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "100001"
      ],
      "json_pointer": "/1026/100001"
    },
    {
      "uid": "zhcn:ae8e86099ae00bffc6c3846b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "解析中――我的父亲与主人，\n脸部和声音的数据均不一致。\n…但二人的『温暖』却很相似。",
      "source_fingerprint": "b15c715b39c4a25aae27dd90ce7d603dbf50df64eca43cf487bb0dc8d9c196ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10001"
      ],
      "json_pointer": "/1026/10001"
    },
    {
      "uid": "zhcn:4f6307af9571278a684a2c36",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我的房间并没有什么不完备的。\n因为今天也给『兔子人偶』下达了任务\n――看家。",
      "source_fingerprint": "e4c9b34e0ad03fc5e31dc6da5a1e235f05ea1c7b6a0575a94a81eeb1619d901b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10002"
      ],
      "json_pointer": "/1026/10002"
    },
    {
      "uid": "zhcn:216a38aa063bd2fecb2c1f3f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "新年快乐。\n我的新年愿望是『版本更新』\n我要提供出与去年不同的自己。",
      "source_fingerprint": "843f63f9052af528e3ebacba6e1c43c8014df8bbfba994dcac5be4d159d0f688",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10003"
      ],
      "json_pointer": "/1026/10003"
    },
    {
      "uid": "zhcn:96ce11513f322ef243910473",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "从同班同学那里收到了被称作\n“友情巧克力”的东西…是今天才有的\n特殊能源。",
      "source_fingerprint": "5709c016c1fb375bb99a095629389393be0b3d5d81de839ef97348bc844be8c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10004"
      ],
      "json_pointer": "/1026/10004"
    },
    {
      "uid": "zhcn:b9e8fac198e08b261d690dc8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我也给主人准备了巧克力。\n没有依赖烹饪电器，全部都是\n我亲手做的。…请尝尝。",
      "source_fingerprint": "d266aaad8bdf245858fc99b0081da58d1f16860746b97ac9e86ab473d0561de4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10005"
      ],
      "json_pointer": "/1026/10005"
    },
    {
      "uid": "zhcn:fad1e661f63f2a884c63cb5e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "银河…如果主人就在那里\n等候着的话，那我\n就游过那条河吧。",
      "source_fingerprint": "d9b76dcc97296ef22336265334b6a67fd786b9574b566a1877de6656c29ef7d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10006"
      ],
      "json_pointer": "/1026/10006"
    },
    {
      "uid": "zhcn:5f6b3f1854aaf5874fc4cb86",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我听说万圣节是要\n恶作剧的节日。该对主人做\n什么恶作剧好呢，请下指令。",
      "source_fingerprint": "afbf11c3bf79d43e6af6c9856dd5288886c91df7991a6fdac90c9422a94f98cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10007"
      ],
      "json_pointer": "/1026/10007"
    },
    {
      "uid": "zhcn:ff61e12ddd0b3b8109cdb598",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "各地的彩灯，以及合适的\n散步路线已确认完毕。\n…要出发吗？主人。",
      "source_fingerprint": "03ebbc21528eb0ee79af0e3770d76b44cb97866586c0aba9b24e6e4d0fdf16b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10008"
      ],
      "json_pointer": "/1026/10008"
    },
    {
      "uid": "zhcn:2b7f5e320c898dfea0cfd538",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "就算是圣诞节，我的\n行动优先级也没有改变。\n…我要在你身边追寻梦想。",
      "source_fingerprint": "9f19f9f1e0d1c5a55db3ed576f42dba345c0cfbe2c0109c459ee2c7417840b9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10009"
      ],
      "json_pointer": "/1026/10009"
    },
    {
      "uid": "zhcn:0e28fe499ba9ab589d346901",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "完成。",
      "source_fingerprint": "1fd91b1324f8787c50fab64db2cdd19a9fd7ebadd24f7298de6dead0780e4796",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "1001"
      ],
      "json_pointer": "/1026/1001"
    },
    {
      "uid": "zhcn:a64a02fbd15826d145a6a21a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "空谈来年事，鬼都笑你痴――\n…鬼为什么要笑呢？\n是思考回路发生故障了吗…？",
      "source_fingerprint": "270585e76cc120e15dffe81a9c87f557a9ba90debe5089a8592adfcfa872e1c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "10010"
      ],
      "json_pointer": "/1026/10010"
    },
    {
      "uid": "zhcn:2a734e015bf9dc7aa69b53c3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "祝你生日快乐。\n上位关联词检测到蛋糕。\n可以允许我准备吗？",
      "source_fingerprint": "09d1a27028db0a72cb434152e497ee61cb7982800510ba1de77d6db5ff0f4b56",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
