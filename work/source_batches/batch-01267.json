        "20042"
      ]
    },
    {
      "uid": "zhcn:ed318456f61494780a0618bf",
      "kind": "character_system_text",
      "source_text": "不可解…",
      "source_fingerprint": "85ec1b791701f88782f8a107c923e98279da0ceae38698e630e574c4d1d09453",
      "source_path": "character_system_text_dict.json",
