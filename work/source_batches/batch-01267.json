        "1026",
        "20043"
      ]
    },
    {
      "uid": "zhcn:68235a095268a0ec91100f80",
      "kind": "character_system_text",
      "source_text": "出发。",
      "source_fingerprint": "8167d1d045fa6f23c7c40620b76aa43604b384e653241623afc8b7061394a145",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
