        "410002"
      ]
    },
    {
      "uid": "zhcn:37437b97ca69981232c7792f",
      "kind": "character_system_text",
      "source_text": "成功了",
      "source_fingerprint": "77c15c5bccb0e3d2190915de0c8562d0bccc3050aaa518d35b8fd300ba4c23f5",
      "source_path": "character_system_text_dict.json",
