      ]
    },
    {
      "uid": "zhcn:83a78d5fca65f7d44a2ee9c8",
      "kind": "character_system_text",
      "source_text": "哦？要训练了吗？\r\n很有干劲嘛——",
      "source_fingerprint": "7f14311a8bb069f1c7104fe87cba2c471a351f0f7eba3f2807ef45cba4762104",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "110000"
      ]
    },
    {
      "uid": "zhcn:5a64c51203a74b95476ae1ac",
      "kind": "character_system_text",
      "source_text": "有什么样的故事可以看呢——？",
      "source_fingerprint": "d124007da1570231bcefe671a828e07fed3aea497fe414c8d41e460b823ecba8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "110001"
      ]
    },
    {
      "uid": "zhcn:a9dff0533b47b53664acdabf",
      "kind": "character_system_text",
      "source_text": "要报名参加竞赛吗？",
      "source_fingerprint": "0306fe526351291f54c72920184014879c42c5811dc8a624107ea10c20833e11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "110002"
      ]
    },
    {
      "uid": "zhcn:11487aba3f1ef4fb5f577360",
      "kind": "character_system_text",
      "source_text": "啊嘞嘞～",
      "source_fingerprint": "1cdfc63dc0a4d6d0d99c70a5c48745df2b4555826c0bc21aac8bd44fdfa4201a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "1108"
      ]
    },
    {
      "uid": "zhcn:50eed681dad3d0e7af8c2790",
      "kind": "character_system_text",
      "source_text": "赛马娘，Pretty Derby",
      "source_fingerprint": "a86a86557058b8d162e8d042f363dc8778c874c14f038e08552613c5605f1914",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "12"
      ]
    },
    {
      "uid": "zhcn:3a49bd453e3749d07a825780",
      "kind": "character_system_text",
      "source_text": "哦哦哦……？",
      "source_fingerprint": "e9e6acc632d8d67128344d2b2af88c0d62b89896bc200ca2c4887f5df52a5e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "120000"
      ]
    },
    {
      "uid": "zhcn:c658a73b09db6f3b1cf82823",
      "kind": "character_system_text",
      "source_text": "说是今天的登录奖励呢～",
      "source_fingerprint": "34f9ecb169dc1fc9d10958c71b2baed2891dca8c681f654caa40e45390c6ad4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1020",
        "13"
      ]
    },
    {
      "uid": "zhcn:d7af9a9a3bd2f07113766f06",
      "kind": "character_system_text",
      "source_text": "来吧，选定自己的猎物～",
