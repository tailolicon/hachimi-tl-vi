      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "正因有对大家的『情感』\n我才不会偷懒。\n期待一场认真的对决。",
      "source_fingerprint": "59ef1e1cd71be7d6669626b3adc00f6cf25ed037078a0b16028ca1e5c9225092",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
