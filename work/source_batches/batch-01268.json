    },
    {
      "uid": "zhcn:da720eac448924f14179defd",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "为了补充营养，\n我带来了点心。\n如果需要甜味的话，请告诉我。",
      "source_fingerprint": "11ee73b96593fb4aa7dcff0ddba4458b777e7f6ebf698281afe855a07301c7e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
