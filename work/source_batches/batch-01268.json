      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "1小时后的状态…\n预测会有点『饿』。设定休息时\n进行糖分摄入。",
      "source_fingerprint": "0f21d4f0cfaae7869b81fce13fbd149771076f55899aacd2c7fa34a154c3c864",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
