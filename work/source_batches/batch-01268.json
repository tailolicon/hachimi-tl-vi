    },
    {
      "uid": "zhcn:57bef381172073f39d3b9670",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "『顿悟』是积累了训练\n之后才会出现的东西。\n努力才是最重要的。",
      "source_fingerprint": "8c48af6653d4e731f7878c53af5a1648e5cc0527551aa3e1ebf8befadb37fb4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
