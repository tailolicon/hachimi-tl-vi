    {
      "uid": "zhcn:ef3e1eb16feaa5c21c9d253d",
      "kind": "character_system_text",
      "source_text": "是盛装打扮版小青哦☆",
      "source_fingerprint": "9f7d84673d491451eced1a133bc2f7df83f19bb26e37b895e22ba20e12ef20d0",
      "source_path": "character_system_text_dict.json",
