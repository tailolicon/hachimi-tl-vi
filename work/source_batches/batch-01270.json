      "source_text": "潜心屏气……",
      "source_fingerprint": "7a2c56ec5de757a6d32a5b1928014fdbfcf7d13a3649b4973a919d48509d06bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
