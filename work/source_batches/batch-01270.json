      ]
    },
    {
      "uid": "zhcn:625d34f257cabc34477392bd",
      "kind": "character_system_text",
      "source_text": "よしっ",
      "source_fingerprint": "8afb727c5543bec49be9b7346d3b68dcebed6761e36b5294ff9b2b4a99063cda",
      "source_path": "character_system_text_dict.json",
