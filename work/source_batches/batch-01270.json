      ]
    },
    {
      "uid": "zhcn:7cf5e4870d639b6baddf85a1",
      "kind": "character_system_text",
      "source_text": "えへへ……",
      "source_fingerprint": "ac307a6a97d8e762ef44a8788e0f8257dcd1232922fbc9ff27ecbc1c594fecf3",
      "source_path": "character_system_text_dict.json",
