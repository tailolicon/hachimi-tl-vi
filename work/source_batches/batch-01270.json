      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "12"
      ]
    },
    {
      "uid": "zhcn:b3d00723cd4779721afbff3c",
      "kind": "character_system_text",
      "source_text": "既温暖、又强大的力量……！",
      "source_fingerprint": "08cf4b72adea0206d5c58457a79811ebfcbb57a1cedf2c028c0447ae1adc0e5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1025",
        "120000"
      ]
    },
    {
      "uid": "zhcn:becb5ab69e33ca9ba198b0de",
      "kind": "character_system_text",
      "source_text": "这是今天的登录奖励……",
