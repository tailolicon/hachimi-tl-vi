  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:3bcfddaa877d831cd2e75bac",
      "kind": "character_system_text",
      "source_text": "太棒了！",
      "source_fingerprint": "9517a20ad976235ecbad39bf2f882bf0c18d7ab52b212109dc5ae86d4580ef47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "140013"
      ]
    },
    {
      "uid": "zhcn:b1125f34e9d3aec1a7e2fc69",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "140014"
      ]
    },
    {
      "uid": "zhcn:db0a52b5234dd4048352892d",
      "kind": "character_system_text",
      "source_text": "嗯",
      "source_fingerprint": "821ea6fd74a74c12dfe83babf1c9f495bee9012e2301d5b7f3010fff99b8fd6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "140015"
      ]
    },
    {
      "uid": "zhcn:dbea0ad3013b50ce09795792",
      "kind": "character_system_text",
      "source_text": "主人！",
      "source_fingerprint": "dce392a9b0576ac5294d6a05863df8ed60a4055a5948b26bbc8313744004b644",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "140016"
      ]
    },
    {
      "uid": "zhcn:c6efdfc1105f4076a3724210",
      "kind": "character_system_text",
      "source_text": "啊……",
      "source_fingerprint": "fbe9b8a6562528c71dac2f35e4bb3503757fd80fd15a323c0f3842922f08e2da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "140017"
      ]
    },
    {
      "uid": "zhcn:483841abc378682e2e350faf",
      "kind": "character_system_text",
      "source_text": "呜……",
      "source_fingerprint": "e23a2a933be63f7992ef78dc97543046307e6306c1a546d698062edb79747a91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "140018"
      ]
    },
    {
      "uid": "zhcn:c3aa88c25da361af667c9c7d",
      "kind": "character_system_text",
      "source_text": "明天将得到这些。",
      "source_fingerprint": "13e45f9dda0a7b20fd749a986fe02d315372a876786408a109e3a682b735f616",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "15"
      ]
    },
    {
      "uid": "zhcn:237adcad4214ec7f798e62c5",
      "kind": "character_system_text",
      "source_text": "确认到体力低下。\n问题轻微…还可以运作。",
      "source_fingerprint": "591df6f974e67b8a8b5c64f164e29adfd37973aa4126b6d0280483cf77d92f8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20000"
      ]
    },
    {
      "uid": "zhcn:3fa03ff7920b9b57a477fcfa",
      "kind": "character_system_text",
      "source_text": "…感知到疲劳\n输出可能会降低。",
      "source_fingerprint": "452735444e3f72ec1b3ddb933cb22686efb4e68000e19afb980787f2552b3e04",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20001"
      ]
    },
    {
      "uid": "zhcn:14315e3460ab3f32a70cf89d",
      "kind": "character_system_text",
      "source_text": "全功能正常。\n判断，任何困难\n都可以克服。",
      "source_fingerprint": "bf3c980b31344e34aa155737827d24a1e0f6c3e934d9210b8b7a4d90d5c3b127",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20002"
      ]
    },
    {
      "uid": "zhcn:a0db3bcf064f691b5a4b91ba",
      "kind": "character_system_text",
      "source_text": "感知到状态『高涨』。\n…下达命令后，\n将取得高于一般状态的结果。",
      "source_fingerprint": "920d4ead29c5d6fb9e4a1837124b5cc1b5cb91eae391a89f381248920a34efce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20003"
      ]
    },
    {
      "uid": "zhcn:ff45d7c0e4aa064995fb3120",
      "kind": "character_system_text",
      "source_text": "奔跑功能，良好。\n随时可以起跑。",
      "source_fingerprint": "1733f05929fd27447c101a233a5b07bcf00c7313926a54e88dfb4d4fa23b518f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20004"
      ]
    },
    {
      "uid": "zhcn:34ddac59170549b5d6d7ad9d",
      "kind": "character_system_text",
      "source_text": "能量储存完毕，\n已准备万全。\n随时可以发出信号。",
      "source_fingerprint": "15696d73a11ea7c14e353eed1b5ab65ad9db428ed02f7f2bfbb29f933d1e7ea4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20005"
      ]
    },
    {
      "uid": "zhcn:7c23b2c0c75dc44fcecd8c89",
      "kind": "character_system_text",
      "source_text": "没有检测出问题。\n判断可以达到相应的结果。",
      "source_fingerprint": "81057736d64bb3ce742af84e9a51be8151d1ebf4c7cd728b50a36f140dd034b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20006"
      ]
    },
    {
      "uid": "zhcn:186e68392e821c6af3e9bc82",
      "kind": "character_system_text",
      "source_text": "动作确认完毕。\n一旦接收到新指令，\n将立即执行。",
      "source_fingerprint": "ffb6598d95169dd3fbebb77cc0deb05502909494cbb4e2cb47bdbc60976e9ae0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20007"
      ]
    },
    {
      "uid": "zhcn:0c1b2b09ef94a8f0d2d3fb87",
      "kind": "character_system_text",
      "source_text": "输出存在问题…但是…\n判断仍可继续运作。",
      "source_fingerprint": "751102d2df66ebd341382032622e8f1f27592f0429f138e1cec56956ab0682bc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20008"
      ]
    },
    {
      "uid": "zhcn:0a554893c57eb8dd3075c994",
      "kind": "character_system_text",
      "source_text": "…确认到精力低下。\n预测此状态下\n很难拿出成果。",
      "source_fingerprint": "b5177da0308a69862d6532fe7713784276fba9e18ef089d5dca352b9e9dd42ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20009"
      ]
    },
    {
      "uid": "zhcn:1166c930d5a65053a00db3d9",
      "kind": "character_system_text",
      "source_text": "全功能，输出低下中…\n推测状态为\n『絶不調』…",
      "source_fingerprint": "7673015ad84f11e7c8f178a5cc090b308f083693ac07e36fd57d7f997322c0da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20010"
      ]
    },
    {
      "uid": "zhcn:5f019766f34151e461b74157",
      "kind": "character_system_text",
      "source_text": "不良状态…\n目前状态下，所有\n结果均无法预测…",
      "source_fingerprint": "1242b980c0526f001c6dad63eb1a6bd80e171a2ec06828dbec172cee958cede9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20011"
      ]
    },
    {
      "uid": "zhcn:f3e21b7c56b519e42ee18d39",
      "kind": "character_system_text",
      "source_text": "连续参加比赛中。\n预测到机能低下，\n但我会尽力做到最好。",
      "source_fingerprint": "a0c357e5c16f71815139b1e2da1f357655fdf3c513eb25f0e050ba38739faaae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20021"
      ]
    },
    {
      "uid": "zhcn:caf7f0d68d6ca481926c7dcb",
      "kind": "character_system_text",
      "source_text": "由于连续参赛，奔跑时负担\n增大。极大可能发生问题。\n…尽管如此，我也要…！",
      "source_fingerprint": "39ee1bb1fe3e486ce40e07668963b55ed6b4db8273766280bbad2c1476a4e27b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20022"
      ]
    },
    {
      "uid": "zhcn:5a115fbf08b146686f1b1be2",
      "kind": "character_system_text",
      "source_text": "根据训练\n计算调整结果…\n状态显示『良好』。",
      "source_fingerprint": "98f947de43dd1e9e4cfe1042f7f79f95f846e9a4f275db29b5c3e62622c2c2b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20023"
      ]
    },
    {
      "uid": "zhcn:3a6032db60cfee0814e7957f",
      "kind": "character_system_text",
      "source_text": "判断状态完美。\n能得到最好的结果吗。",
      "source_fingerprint": "5251770a07db988ab71dd1fe558b9ee9c35f28be129a5a954f276fd6f6674841",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20024"
      ]
    },
    {
      "uid": "zhcn:01d9b9b59d05e667f69407a8",
      "kind": "character_system_text",
      "source_text": "调整完备。判断获胜概率\n与状态呈正比。",
      "source_fingerprint": "d10b835f9713af3fdfb17c7398bd78c5eaaecdf21b77ac5e0e30a3eee0c83f0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20025"
      ]
    },
    {
      "uid": "zhcn:feb20a05d23d8a79aa85da1e",
      "kind": "character_system_text",
      "source_text": "根据适当的训练分配，\n确认准备充分。\n…能办到。",
      "source_fingerprint": "644217152dfbd90213061966fe3bd07158420a27ceb8c5de2ae9e61520863575",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20026"
      ]
    },
    {
      "uid": "zhcn:9b9a5fc1728d68a9ede59a51",
      "kind": "character_system_text",
      "source_text": "确认目前的状态。\n判断调整符合预期。\n瞄准第1名。",
      "source_fingerprint": "f58376fbb1979d950aa5ec04275ab7b8704073cf04d9e9354b44ce820c521a68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20027"
      ]
    },
    {
      "uid": "zhcn:dbe468af1f1e106cefa4e37b",
      "kind": "character_system_text",
      "source_text": "目标比赛，分析完毕。\n可应对各种状况。\n请下指示，主人。",
      "source_fingerprint": "c400f6db38cc3e25c4a3b1d312ecbf3f0c007bdeb1393c66ad462b35f1cdaae6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20028"
      ]
    },
    {
      "uid": "zhcn:bccf1afd962c0933873d7f92",
      "kind": "character_system_text",
      "source_text": "认知为重要比赛。\n调整结果『相符』\n…无须担心。",
      "source_fingerprint": "f8598562df178ac50c98060f978c578399f8f96585460600ab209831981c28a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20029"
      ]
    },
    {
      "uid": "zhcn:8a98ffc34f461585df1010b0",
      "kind": "character_system_text",
      "source_text": "维持在正常表现。\n走吧，主人。",
      "source_fingerprint": "ae9092b96f3d724d608ccdffd6e952e898c5b3196e074abf6223b7db6ae83040",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20030"
      ]
    },
    {
      "uid": "zhcn:7709a4b72e3ee0cedb374314",
      "kind": "character_system_text",
      "source_text": "载入迄今为止的\n训练数据。\n启动，已稳定。",
      "source_fingerprint": "fa9083da48b54dee0569e2c1b0704154c3c0de84d72a30447d4ad3dc59570aca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20031"
      ]
    },
    {
      "uid": "zhcn:cf0ce9772561aee9ae6595ed",
      "kind": "character_system_text",
      "source_text": "对奔跑精度持有不安。\n…但是，这种程度的问题\n我会用『努力』来覆盖。",
      "source_fingerprint": "36cdb7bf812cdc68a0a4a8fa42a84a176047161f18f06794d1c3a1414aa85126",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20032"
      ]
    },
    {
      "uid": "zhcn:1d007ec15619bccb75af80e7",
      "kind": "character_system_text",
      "source_text": "…感知到强者的气息。\n主人，请赋予我\n『鼓劲』。",
      "source_fingerprint": "c30944879f92b6736da9deefcc9dc2234513389e3faaf6cc760ec46f7fb70de0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20033"
      ]
    },
    {
      "uid": "zhcn:1ff290d2d8f1aa959778f463",
      "kind": "character_system_text",
      "source_text": "…感知到身体僵硬。\n启动精神统一模式。\n尝试稳定功能控制。",
      "source_fingerprint": "8b4ed20c0ae44fd7d0f8f78f2227f7fe111bb51e0ce126c34333bcfe0ce152e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20034"
      ]
    },
    {
      "uid": "zhcn:184a500e82256c9453a13889",
      "kind": "character_system_text",
      "source_text": "确认到调整状态『不安』。\n…我会在现状下\n尽最大努力。",
      "source_fingerprint": "25e57f679fe8803e4711562797dc9d4e1b948b00cd1ee03d6ec30bf718de9ebd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20035"
      ]
    },
    {
      "uid": "zhcn:9c8244ceb6d18a91d9927e15",
      "kind": "character_system_text",
      "source_text": "状态・胆怯已排除。\n不论什么情况，\n我都一定会胜利。",
      "source_fingerprint": "68b655d858056596e0643f567dd21c213953b975d6089062168f066910d1a868",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20036"
      ]
    },
    {
      "uid": "zhcn:f94a96a747c5c92f52a50366",
      "kind": "character_system_text",
      "source_text": "无论可能性有多低，\n都用努力全部覆盖…\n这就是美浦波旁的跑法。",
      "source_fingerprint": "3b1d0a68c32d66c7e716b36674282d6dd5b46de06f61eef00299d0e98f1bb97d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20037"
      ]
    },
    {
      "uid": "zhcn:f6865ea5e142d297fb7bfdfa",
      "kind": "character_system_text",
      "source_text": "开始。",
      "source_fingerprint": "1b3aec20fad242e07275c683d2426e01e00ff02188e60e8e3680d12d8ddf21aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20038"
      ]
    },
    {
      "uid": "zhcn:abff45ab62c3843a981c1039",
      "kind": "character_system_text",
      "source_text": "执行。",
      "source_fingerprint": "1a6503b4ac9164f036768c6aec1311808a2819dc06fd28e9bf788ecef581cb18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20039"
      ]
    },
    {
      "uid": "zhcn:cb588ba563d8c2e2130f1b02",
      "kind": "character_system_text",
      "source_text": "行动。",
      "source_fingerprint": "30ae736189b1cf8aef3e39b3f8ca5bf320ce6b68fa2693ccf72434f3521a9303",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20040"
      ]
    },
    {
      "uid": "zhcn:5f062f4fc95aa44c4f38e431",
      "kind": "character_system_text",
      "source_text": "集中模式…",
      "source_fingerprint": "363034c03a38b7caa3a9ce05c122ec0c40a5b4b27cdd391d32a7228c3d2d5dc6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20041"
      ]
    },
    {
      "uid": "zhcn:615630cc3d3d7bd4e3d0da81",
      "kind": "character_system_text",
      "source_text": "故障…",
      "source_fingerprint": "8ff27fcbdf7a7b34b2f8e1098f650f88674295e71df562ddf0a4377dc4ee163a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20042"
      ]
    },
    {
      "uid": "zhcn:ed318456f61494780a0618bf",
      "kind": "character_system_text",
      "source_text": "不可解…",
      "source_fingerprint": "85ec1b791701f88782f8a107c923e98279da0ceae38698e630e574c4d1d09453",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20043"
      ]
    },
    {
      "uid": "zhcn:68235a095268a0ec91100f80",
      "kind": "character_system_text",
      "source_text": "出发。",
      "source_fingerprint": "8167d1d045fa6f23c7c40620b76aa43604b384e653241623afc8b7061394a145",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20046"
      ]
    },
    {
      "uid": "zhcn:e3069bfc2d472b6475e3b592",
      "kind": "character_system_text",
      "source_text": "目标设定为『海』。",
      "source_fingerprint": "d5b7c4ed740c6dfe25a9c5b9b511c01f3d8ceb9946198de7cd515491f9e91cff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0fe7d217180b8c6b040dd83e",
      "kind": "character_system_text",
      "source_text": "这都是主人正确指示的结果。",
      "source_fingerprint": "1cdb1351d1c1eacaa983869fc0f26e17b2a217a17bc07bccf8668525356940df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20049"
      ]
    },
    {
      "uid": "zhcn:23c9d0448334db4575f967af",
      "kind": "character_system_text",
      "source_text": "感谢主人。",
      "source_fingerprint": "8c8e09e86832d8758c545823df553acc3bd5544f76580caa28dbfc7890f88916",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20050"
      ]
    },
    {
      "uid": "zhcn:506dfaa4d841793d4775b525",
      "kind": "character_system_text",
      "source_text": "共同任务开始。",
      "source_fingerprint": "a5c30a512fd25a04d0be742761e4f25611e8a2d1cdafc3fc80041eeb958b7633",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "20051"
      ]
    },
    {
      "uid": "zhcn:343368f21e094dd82885119e",
      "kind": "character_system_text",
      "source_text": "比赛模式，启动。",
      "source_fingerprint": "ca441dc7cc04b4602fb5d0c1bfb8d209aadfc907689aee243adb39340246d0bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "2030"
      ]
    },
    {
      "uid": "zhcn:8cfcde03b6f08b469c051b19",
      "kind": "character_system_text",
      "source_text": "目标设定为『胜利』…开始。",
      "source_fingerprint": "f9dbdddebda077c2cdea18ecba5e2d8f6154b5080df15cb17c5e02bc2e10a6d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "2031"
      ]
    },
    {
      "uid": "zhcn:a7dc1abf7a8c18f98a763ea8",
      "kind": "character_system_text",
      "source_text": "感谢主人。",
      "source_fingerprint": "8c8e09e86832d8758c545823df553acc3bd5544f76580caa28dbfc7890f88916",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "2032"
      ]
    },
    {
      "uid": "zhcn:7bf65b3f897c5ad24649fe9a",
      "kind": "character_system_text",
      "source_text": "目标比赛，分析完毕。可应对各种状况。\r\n请下指令，主人。",
      "source_fingerprint": "d2a66fc5c09a32daa122fe938c6f71b910578b0e46eb5b8fb1a8ef98ef4f5ad6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b6bb5ebdaef641ad86e212a0",
      "kind": "character_system_text",
      "source_text": "调整完毕。\r\n判断获胜概率与状态呈正比。",
      "source_fingerprint": "8a8de223f10e4790fbf50a4d1a9a09ef3c72fd5a1bf0efd81625c6fc72c0072b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "2034"
      ]
    },
    {
      "uid": "zhcn:7bd4da80092886d57a8a0ba7",
      "kind": "character_system_text",
      "source_text": "感谢主人。",
      "source_fingerprint": "8c8e09e86832d8758c545823df553acc3bd5544f76580caa28dbfc7890f88916",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "2035"
      ]
    },
    {
      "uid": "zhcn:7ea1ea2685bfc9ab68d539ee",
      "kind": "character_system_text",
      "source_text": "開始します。",
      "source_fingerprint": "e9557c05e610d5a405bf9d75e26c6d48846f74fb2f9e362196930053d3b2823d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b085e897d7a2023d010fa7be",
      "kind": "character_system_text",
      "source_text": "第2名…记录完毕。变更为调整模式。",
      "source_fingerprint": "4c9fee8ffd37400e519311f5d7cc85d0a05c8c02af55edfc7c8e950114b94497",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30000"
      ]
    },
    {
      "uid": "zhcn:97644c0c66549ba8419811ae",
      "kind": "character_system_text",
      "source_text": "过程推察中…下次一定要拿到第1名。",
      "source_fingerprint": "19786cec18a9d830763a7c230a1470430d1a8029d462f7aad0335c54063829cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30001"
      ]
    },
    {
      "uid": "zhcn:558624278dbc4a43856d639c",
      "kind": "character_system_text",
      "source_text": "检测出问题点…来梳理数据吧。",
      "source_fingerprint": "a6a10d1188a474ec0987183166d8ca8a52514ecea1120218054c7bbef4d7ee1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30002"
      ]
    },
    {
      "uid": "zhcn:8fe6fa15e0f00becb692957a",
      "kind": "character_system_text",
      "source_text": "…判断仍有改善余地。",
      "source_fingerprint": "84a6d0e33277ff8d88b0709e02f55af65c407df045b9c88a4d2ab42553ef1ad0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30003"
      ]
    },
    {
      "uid": "zhcn:4fde69915ecd729dc6348df3",
      "kind": "character_system_text",
      "source_text": "全功能确认…全部正常，完美的胜利。",
      "source_fingerprint": "40910564fd274d3ec30116dbb64b8d7bb1700a265e154a2e388a2f0597d6671e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30004"
      ]
    },
    {
      "uid": "zhcn:c754e53bfbca32b27b34a41b",
      "kind": "character_system_text",
      "source_text": "呼…第1名，已达成。",
      "source_fingerprint": "fa3b1085326ef4d3bb8a88abbd54311288ae13ef70e508a2227d126a8363ead0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30005"
      ]
    },
    {
      "uid": "zhcn:ad610e2ee53e13685b13e2cb",
      "kind": "character_system_text",
      "source_text": "成功优化速度。完成了一次完美的『烹饪』。",
      "source_fingerprint": "b3979cde4c84a658436ec5ac2ec4ee6cfa6a5ecc1d3fff42342bea8625d186b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30006"
      ]
    },
    {
      "uid": "zhcn:42911f15992b84f6829f7c2e",
      "kind": "character_system_text",
      "source_text": "呼…第1名，已达成。",
      "source_fingerprint": "fa3b1085326ef4d3bb8a88abbd54311288ae13ef70e508a2227d126a8363ead0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "30007"
      ]
    },
    {
      "uid": "zhcn:e05535ecb2956065389bbbe0",
      "kind": "character_system_text",
      "source_text": "启动。",
      "source_fingerprint": "e87e6b99501e58331026e26813522b089a52eebff0cfc128c30ee2575d73c59c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "31000"
      ]
    },
    {
      "uid": "zhcn:22f8978768e323d085616a5b",
      "kind": "character_system_text",
      "source_text": "全输出加强…美浦波旁，出发！",
      "source_fingerprint": "b7e74db4b305ae065bbc8bc5ec9d728da839aecbe9d01b0995b0f8dd54d7c771",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "40000"
      ]
    },
    {
      "uid": "zhcn:ee795cdd373a62a60051e4d8",
      "kind": "character_system_text",
      "source_text": "任务\n『全宿舍万圣节派对』\n开始。",
      "source_fingerprint": "5abaacc4d5e1151001ef24a96fd3956a43c7c847c5f0d044b38f9acac12a6bc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400001"
      ]
    },
    {
      "uid": "zhcn:850b59f526e264bcb7a4b902",
      "kind": "character_system_text",
      "source_text": "自己的任务自己处理。\n这是…『当然』的。",
      "source_fingerprint": "82175ddc079699fdc0d63668be7ff370b898996d5487dd6f2f9f4d17b5d0bff8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400003"
      ]
    },
    {
      "uid": "zhcn:9295f5c72456f5d20a51e893",
      "kind": "character_system_text",
      "source_text": "从西野花同学的样子\n能察觉到若干『违和感』。\n搜索解决流程――",
      "source_fingerprint": "1498a09766fe4f499be0fd4672abae13195a6d07f1741dd634396d6a82fae8ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400004"
      ]
    },
    {
      "uid": "zhcn:7e8dfa17f4123f9ea8089b5d",
      "kind": "character_system_text",
      "source_text": "和各位共处的时间越多，\r\n队伍的实力也跟着等比例提升──\r\n状态「感觉不错」。",
      "source_fingerprint": "85d1e7e1308e79364a4260b319218479c16b35ca872a595efcbf0062d2f0667f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400005"
      ]
    },
    {
      "uid": "zhcn:7eba683cec391025159419a3",
      "kind": "character_system_text",
      "source_text": "接受来自队伍的命令。\n目标设为『顶点』。",
      "source_fingerprint": "705aaa0d6a9df2732f63a71b19bc9cc90869d7af90f6d7675f8d90c7f438d110",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400007"
      ]
    },
    {
      "uid": "zhcn:cc09284770b5bd8a39173a92",
      "kind": "character_system_text",
      "source_text": "…已经收集了不足的信息。\n剩下的问题是…",
      "source_fingerprint": "68729092273e3e6bf2f7d47130a5a389acc83a594a63e2db66c6a7e6b2aeab0f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400008"
      ]
    },
    {
      "uid": "zhcn:159478a46ea65e4bb6bbe1d9",
      "kind": "character_system_text",
      "source_text": "开始启动，解除限制…设定，全部正常。\n美浦波旁，启动。",
      "source_fingerprint": "3c7474da998363978691dddd5b24d35d01a541ab175296051efc0a3f544cd7cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "40001"
      ]
    },
    {
      "uid": "zhcn:f412c52d6ab2944f1da5b7df",
      "kind": "character_system_text",
      "source_text": "只有我一个人是做不到的。\n正因是我们一起…才做到了。",
      "source_fingerprint": "4d2d574257bbc7bb3ee948c3b79d341918319ccbc570256ca5342467dce52c3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400010"
      ]
    },
    {
      "uid": "zhcn:50187a4f0074c0b05f766ded",
      "kind": "character_system_text",
      "source_text": "辛苦了。搜索今后的流程\n――发现1项。\n『庆功宴』如何呢？",
      "source_fingerprint": "5715cc086152d5f63e7d188af618c79bd71e06e94a037c1e150633bd17f1d681",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400014"
      ]
    },
    {
      "uid": "zhcn:0c930cab837c7142135fb459",
      "kind": "character_system_text",
      "source_text": "确认蛋白酥分离。\n状态为『失败』。\n…需要提高技术等级。",
      "source_fingerprint": "7adacd970b366b092b73358c41317e334918ac112392642111949423206eacb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400022"
      ]
    },
    {
      "uid": "zhcn:9d6736309a3cf9f6c83faa66",
      "kind": "character_system_text",
      "source_text": "『最棒的友情巧克力』赠送完毕。\n任务完成。",
      "source_fingerprint": "a5090a61a8421f6627c9328931069016058f2d0f4aee38d552ce6ababd4f8da9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400023"
      ]
    },
    {
      "uid": "zhcn:848ef1c15d8d2b4807bf1ca8",
      "kind": "character_system_text",
      "source_text": "糖度上升，开始！",
      "source_fingerprint": "5b7a82a29fd73f8648bb4d811339e511dffb4bd8ae26e0889b55a4b70a7d134f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "40003"
      ]
    },
    {
      "uid": "zhcn:f1d5790077599e7f75144850",
      "kind": "character_system_text",
      "source_text": "正常运行中。…？检测到错误。发现巨型巧克力。\n哈！已取得副产物。",
      "source_fingerprint": "19eb4ee0c2a4d48f97cdd82c75e88219da551f02e0ac66566deae3f475a55f75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "40004"
      ]
    },
    {
      "uid": "zhcn:f2976ebeddc850c9cafa0ead",
      "kind": "character_system_text",
      "source_text": "希望小花和米浴\r\n能够全程目睹我们\r\n五个人全体的「活跃」。",
      "source_fingerprint": "a81b8a6dbba5c881b3416e66156826628618d4cd68129375e759638c905a7a62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400051"
      ]
    },
    {
      "uid": "zhcn:64c5f46dec6e1a272cc826d0",
      "kind": "character_system_text",
      "source_text": "获得了奖励「情谊」。\r\n任务达成。\r\n……感谢充实的一天。",
      "source_fingerprint": "17719a53669e0e2e25e6ddd34e4e155fed047d67f27135966f3ef7b2f98891d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "400052"
      ]
    },
    {
      "uid": "zhcn:080b4703ae2fd575d217e7c8",
      "kind": "character_system_text",
      "source_text": "准备完毕",
      "source_fingerprint": "47a192257d85b245ebebdd1b9e19767ca5486bea0b5f2e9388f33efece0589c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1026",
        "410000"
      ]
    }
  ]
}
