    },
    {
      "uid": "zhcn:2ab872f4ae62fe0d66d12643",
      "kind": "character_system_text",
      "source_text": "操作『LIVE中要展示笑容』\n――执行。",
      "source_fingerprint": "a78ed7ce2b19803622cade70c7eaaf5901937bc38f817ab77d16b20be7eb6ef2",
      "source_path": "character_system_text_dict.json",
