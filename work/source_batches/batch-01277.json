    {
      "uid": "zhcn:5082f27f8ba8e092adc961b7",
      "kind": "character_system_text",
      "source_text": "哦哦！要报名参加竞赛吗？",
      "source_fingerprint": "2a17711c779216fad2b398be3f045db55696afee2471dce4b3e510a28ade7890",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "110002"
      ]
    },
    {
      "uid": "zhcn:ca0ab4a55fab93b0ef176bc2",
      "kind": "character_system_text",
      "source_text": "喔喔──！！",
      "source_fingerprint": "0e26c55252bd2183887049997898b033866cb284629e5c5c4d8fe2951bf5068f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "1111"
      ]
    },
    {
      "uid": "zhcn:4f69f9c6c1f9849c3ddb7f77",
      "kind": "character_system_text",
      "source_text": "嗯，说得对！",
      "source_fingerprint": "75d96476ceb0a184eb1c59508fcad74c943e3ccd7b996f73d7002904cba8af4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "1124"
      ]
    },
    {
      "uid": "zhcn:7a99bb1b65f078cfd7cc6d88",
      "kind": "character_system_text",
      "source_text": "うん、行こう！",
      "source_fingerprint": "cc51cb6486078c0c4c03050b483d640c0171099d6ba9bbdec49855ea654428ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "1141"
      ]
    },
    {
      "uid": "zhcn:7da59571d6b42ef87f801907",
      "kind": "character_system_text",
      "source_text": "バッチリだよ！",
      "source_fingerprint": "30285e91175738920f0c8c26b6f3952e5311b0526d94486266d234212e713999",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "1145"
      ]
    },
    {
      "uid": "zhcn:7037d9a221c8dfe26a49d5d4",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "12"
      ]
    },
    {
      "uid": "zhcn:3c970b2e9a93dfcb241cecf4",
      "kind": "character_system_text",
      "source_text": "感觉有股力量一直涌现呢！",
      "source_fingerprint": "bb85a6e6d3108c6a1b65ae619bb32ce597ccbf80d49be316bb330a87d73507bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "120000"
      ]
    },
    {
      "uid": "zhcn:0b9a5d2013508176f45973a4",
      "kind": "character_system_text",
      "source_text": "啊，这是今天的登录奖励！",
      "source_fingerprint": "b6d4d431d09804d6478718cd81b6ee0c9e9ac20a28ec6da1b7a176ce6d104e0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "13"
      ]
    },
    {
      "uid": "zhcn:7b9e7d0b35218bf5354d900c",
      "kind": "character_system_text",
      "source_text": "请加油。",
      "source_fingerprint": "6a0073db61d307b0cf143cacaab07a3f9fac86881bea0840ad304fe021c9f35b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140000"
      ]
    },
    {
      "uid": "zhcn:9e52af7934edd419ad68121f",
      "kind": "character_system_text",
      "source_text": "太好了！",
      "source_fingerprint": "2deba7ca30c98238317c64bb01282f7578b945b19432461c4536c6681ac4b8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140001"
      ]
    },
    {
      "uid": "zhcn:7f6d01b9fe047579226b003b",
      "kind": "character_system_text",
      "source_text": "好可惜！",
      "source_fingerprint": "40075a69f38972bc47a4fd80f6066d17e4d5e588926f493591aa7a84c3ecc49b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140002"
      ]
    },
    {
      "uid": "zhcn:ca7180b726ae0a93535bd680",
      "kind": "character_system_text",
      "source_text": "夹到好多喔！",
      "source_fingerprint": "e437d1cbe89e220d7276c5a0661a3ab61f3672ba3bf5f6692be01d52c05c2efb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140003"
      ]
    },
    {
      "uid": "zhcn:9b45ea8f509380631ce9b178",
      "kind": "character_system_text",
      "source_text": "真了不起耶！",
      "source_fingerprint": "b5ea064d4178c019cdf49d5649326985bd5b35214fb1c404cc201ff02dbd8cb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140004"
      ]
    },
    {
      "uid": "zhcn:2d6ff2468e4ef807a4a81b68",
      "kind": "character_system_text",
      "source_text": "好可惜……！就只差一点点而已！",
      "source_fingerprint": "1130ac745d10608414c259e5eddddbc1491351a555f3ac50fb1284dff336b34b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140005"
      ]
    },
    {
      "uid": "zhcn:c8add73e92912254828a1383",
      "kind": "character_system_text",
      "source_text": "夹到好多喔！",
      "source_fingerprint": "e437d1cbe89e220d7276c5a0661a3ab61f3672ba3bf5f6692be01d52c05c2efb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140006"
      ]
    },
    {
      "uid": "zhcn:b575722008b4f28ea313ce54",
      "kind": "character_system_text",
      "source_text": "真了不起耶！",
      "source_fingerprint": "b5ea064d4178c019cdf49d5649326985bd5b35214fb1c404cc201ff02dbd8cb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140007"
      ]
    },
    {
      "uid": "zhcn:598bad72075d1af137fa0353",
      "kind": "character_system_text",
      "source_text": "嘿嘿嘿……",
      "source_fingerprint": "409e3d62da53302d118685ed070dc9d6e0d0f61c3de4794915775d4afdcf3cca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140008"
      ]
    },
    {
      "uid": "zhcn:48c3c8af9af8d519859dc3a7",
      "kind": "character_system_text",
      "source_text": "呵呵呵。",
      "source_fingerprint": "414ae427217adea7b80c6d9166bb6ebc72df2f6b1b370616339ff4156cfba39e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140009"
      ]
    },
    {
      "uid": "zhcn:f34c49185e60391d50c458d2",
      "kind": "character_system_text",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140010"
      ]
    },
    {
      "uid": "zhcn:fc22075678874505c44a7e5a",
      "kind": "character_system_text",
      "source_text": "哇啊……！",
      "source_fingerprint": "bec634000510a468bf0c203a32955f8df432a6fc63b80c98ff19fcd03a69f626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140011"
      ]
    },
    {
      "uid": "zhcn:b37c21580580a25089e68f16",
      "kind": "character_system_text",
      "source_text": "好。",
      "source_fingerprint": "061dc3a2e5c7e436c621c77aa82c3cb6759345d51a920b40239a336272405fc7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140012"
      ]
    },
    {
      "uid": "zhcn:7691ff503b59a30689dcb743",
      "kind": "character_system_text",
      "source_text": "好舒服啊──！",
      "source_fingerprint": "22a03c3074e85ea73b2a401a1e8b309234bcb5a7e1ecc381df8aee10b8f803d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140013"
      ]
    },
    {
      "uid": "zhcn:1fd65990b020a501de102def",
      "kind": "character_system_text",
      "source_text": "啊哇哇～！",
      "source_fingerprint": "6fc6188b5b900d8bc0b4d69fb439c63c75329c7ab22a74528b163e9afea3e399",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140014"
      ]
    },
    {
      "uid": "zhcn:5a100dee9c12247841338d34",
      "kind": "character_system_text",
      "source_text": "心跳加速……！",
      "source_fingerprint": "e91b9cf9f547ddea06089c94a8409afa5b9bf7c6578880473d82f58a72255b59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140015"
      ]
    },
    {
      "uid": "zhcn:84ac574e8fbc539ecb60a807",
      "kind": "character_system_text",
      "source_text": "那个──！",
      "source_fingerprint": "e87c221cc8321b9c065c2bd60972efca71fd01bf1315a94df283389e247d7043",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140016"
      ]
    },
    {
      "uid": "zhcn:2fe058e1b33321f91a275921",
      "kind": "character_system_text",
      "source_text": "呜呜……",
      "source_fingerprint": "df7d1e97042f6e694e9d045e354f733c9f1d97c54ec0a7c3f42f1552f0046e85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140017"
      ]
    },
    {
      "uid": "zhcn:cdf4b6cc5c11e2e619522fcd",
      "kind": "character_system_text",
      "source_text": "可恶──！",
      "source_fingerprint": "c036f562c6a75a4e27815cd5424c55f5a4bd1b97d2360e4bee2da178142a3654",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "140018"
      ]
    },
    {
      "uid": "zhcn:6dd471639cbc3aeb55ce36ed",
      "kind": "character_system_text",
      "source_text": "明天好像可以\r\n拿到这个！",
      "source_fingerprint": "2c1c04cbc958c1f78a43e8b096bebf9454d12cbb918b5d690bf4493d08d58170",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "15"
      ]
    },
    {
      "uid": "zhcn:f8d64fbe43c5473420463cde",
      "kind": "character_system_text",
      "source_text": "不会吧……难道是肌肉酸痛……！？",
      "source_fingerprint": "91b29de23ca73ba26fc4f91563802a9074aa1c7b5a213878bda21505932f08a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20000"
      ]
    },
    {
      "uid": "zhcn:51a4eb64763395a5faea8c7d",
      "kind": "character_system_text",
      "source_text": "竟然会提不起力气……\r\n看来是自我管理没做好……",
      "source_fingerprint": "13a04dcda72515506e28789c800b4e2f93c07cfa628597677e6b8d7938079e46",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20001"
      ]
    },
    {
      "uid": "zhcn:6c2bbc48d60d57962e8bf689",
      "kind": "character_system_text",
      "source_text": "啊啊，我的深层腹肌开始躁动了……\r\n一直站在这里实在太浪费时间了，\r\n我们赶快开始吧！",
      "source_fingerprint": "9d0fc4f7ffdb0996cbb9113584e8a8b95d89536e237aa9f48a0c2f2f70d7cd1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20002"
      ]
    },
    {
      "uid": "zhcn:138377b617aa89445c388a3f",
      "kind": "character_system_text",
      "source_text": "我已等不及要活动我的肌肉了……！\r\n请务必让我做严苛的训练！！",
      "source_fingerprint": "24413f7c7d5862afcfd254b8598cf06a563e2b5fc146ec200015c60d64b91130",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20003"
      ]
    },
    {
      "uid": "zhcn:31d7b1cfc1de2f5b4aece2bd",
      "kind": "character_system_text",
      "source_text": "感觉力量源源不绝！\r\n尽情地锻炼来挥洒汗水吧！",
      "source_fingerprint": "a5318a29cabaed257a3b668923d55d629edcfb09e9bfca2030b6b32ebc84f462",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20004"
      ]
    },
    {
      "uid": "zhcn:5dd13a48596faf3c70f4e888",
      "kind": "character_system_text",
      "source_text": "Let's muscle！\r\n嗯，感觉今天有从丹田发声，\r\n很不错哦！",
      "source_fingerprint": "8d9599f9cab8b62bebb99f6802bd6cf095bf46693baa1388d1651529b96a91d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20005"
      ]
    },
    {
      "uid": "zhcn:b2d0ec271ea1a09e3fe747fa",
      "kind": "character_system_text",
      "source_text": "今天的训练排程\r\n该不会是要做重训吧？",
      "source_fingerprint": "3ed40baa6274a963cf523515810ade07fb0abb74236abe9bc6352488f6cf72b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20006"
      ]
    },
    {
      "uid": "zhcn:2def643b6abeb012cf20b6d3",
      "kind": "character_system_text",
      "source_text": "我的肌肉都已经准备好了。\r\n请下达指示吧！",
      "source_fingerprint": "39975cac29c98425c4c225b72726f9753071151f1df2704b786056bdd1bfca5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20007"
      ]
    },
    {
      "uid": "zhcn:55aa8554af2b96f89eafe5b6",
      "kind": "character_system_text",
      "source_text": "奇怪，今天的肌肉感觉\r\n没有平常紧实……\r\n是我想太多了吗……？",
      "source_fingerprint": "bf77b8feb95f39a55cd127529077e04e379933e003eabbc873f91f6ba07daea3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20008"
      ]
    },
    {
      "uid": "zhcn:c0336c9613e88550ba04ae24",
      "kind": "character_system_text",
      "source_text": "身体好像有点沉重啊……\r\n没事，我没问题的。",
      "source_fingerprint": "7e6b771a733ff00d2558c5271869231e6dabc49411b3ec44b10adc5278b622a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20009"
      ]
    },
    {
      "uid": "zhcn:4307b070adcef895513089cf",
      "kind": "character_system_text",
      "source_text": "没办法发挥平时的实力……\r\n这样我怎么……！",
      "source_fingerprint": "102bf12922fd82c391dea788dcf641c8de094bdf4425a404f59bcb2435618f1e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20010"
      ]
    },
    {
      "uid": "zhcn:5856b37369e0f57872695314",
      "kind": "character_system_text",
      "source_text": "虽然我知道不能\r\n再裹足不前了，但是……",
      "source_fingerprint": "b87b8d7cd50d10393e067c46c7c5f2ec61dae317f0012b517002b1cd94189361",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20011"
      ]
    },
    {
      "uid": "zhcn:d2275828f6b09f656075998a",
      "kind": "character_system_text",
      "source_text": "虽然我还跑得动，\r\n但太过勉强\r\n是会给肌肉造成负担的……",
      "source_fingerprint": "178b902898a20a8bb6b6ab233d24e775eacd4699a659fd1b0e8b6e67c0ef755f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20021"
      ]
    },
    {
      "uid": "zhcn:6da11a9871318507c33cc466",
      "kind": "character_system_text",
      "source_text": "抱歉，再继续参加比赛的话，\r\n可能会对身体状况造成影响……",
      "source_fingerprint": "547e0bc8d5ccaac5e9d0e523522cf40f32e5db6e3b298022281fea7e4a8198af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20022"
      ]
    },
    {
      "uid": "zhcn:6ec097acfce863a630638cd7",
      "kind": "character_system_text",
      "source_text": "我的股四头肌锻炼到绝佳的状态了！\r\n它感觉在催促我「快跑起来」呢！",
      "source_fingerprint": "5f452a6a5bbd44e089f558bca48d687ac388d61092465bb741512b13e40fa5e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20023"
      ]
    },
    {
      "uid": "zhcn:9b4d12e859a06f28bc9016cb",
      "kind": "character_system_text",
      "source_text": "今天的我，无论遇到什么对手\r\n感觉都能赢……！\r\n你看我的腹肌群，这么硬梆梆的呢！",
      "source_fingerprint": "710af26dde3f2890b612a6b9e5b3030105e57baa8aaa81aa806530e8c9613e97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20024"
      ]
    },
    {
      "uid": "zhcn:3337bc1c2d2b300277fb504f",
      "kind": "character_system_text",
      "source_text": "唔～！！\r\n大腿后肌好像随时都要\r\n跑起来的感觉……！！",
      "source_fingerprint": "18773d09346aa1efc0f3c4d359d8da1dd6ce1ace807fb1c212ec0cfb6708d90b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20025"
      ]
    },
    {
      "uid": "zhcn:ca936bc2cd8c5b222d626fae",
      "kind": "character_system_text",
      "source_text": "肌肉！干劲！\r\n全身的肌肉正在燃烧啊！",
      "source_fingerprint": "f1f3e5a799b0e62d5084c4cd53e523e855dea81ab67914af6a62ddb93ac762f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20026"
      ]
    },
    {
      "uid": "zhcn:5f81e99260944805037bf9c9",
      "kind": "character_system_text",
      "source_text": "我的比目鱼肌说\r\n「今天可以尽情奔跑」哦！",
      "source_fingerprint": "7abcb94491fbc84e6bef446433e99db103d12195ee425530ec8e83a32c668570",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20027"
      ]
    },
    {
      "uid": "zhcn:77a1967ed67f147bbe8b8f4e",
      "kind": "character_system_text",
      "source_text": "努力和肌肉是不会背叛我的，\r\n我要向大家证明这一点！",
      "source_fingerprint": "d7cc578be855d5d09aefddf40af585e780305cdf2cee10d9cb6ffeb0c8096234",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20028"
      ]
    },
    {
      "uid": "zhcn:0de1b8bc725d08e0c610b6a3",
      "kind": "character_system_text",
      "source_text": "今天也要和训练员一起\r\n相信肌肉、继续奔跑！",
      "source_fingerprint": "a94a1b76d2785bd0f551dde34bf9b6affa805a1114ef7605c6ea149bfcb22045",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20029"
      ]
    },
    {
      "uid": "zhcn:c3d6e5ffa043ddfc8241b547",
      "kind": "character_system_text",
      "source_text": "我相信一直以来的努力\r\n一定能让我跑出好成绩的。",
      "source_fingerprint": "645a7e37d7a66ad146c555f6a5336481d25df9299c4fb33ed5613c618e1cac50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20030"
      ]
    },
    {
      "uid": "zhcn:e7bc92888393417b51bfcf1a",
      "kind": "character_system_text",
      "source_text": "我打算不慌不忙地像平常那样去跑。",
      "source_fingerprint": "0f6b3b15d4ab829a9ab3cbec40535f748be0abfd52b88a36d7f6bd7a9300c4e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20031"
      ]
    },
    {
      "uid": "zhcn:fba882ed91dc901c6c12095a",
      "kind": "character_system_text",
      "source_text": "虽然会感到不安，\r\n但只要开始比赛之后，就都不重要了。",
      "source_fingerprint": "79e530b98d644c57171ff07e02684c760ddb39fdd260c55025999632dc11b2d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20032"
      ]
    },
    {
      "uid": "zhcn:c91094f0a045d86e58151e0a",
      "kind": "character_system_text",
      "source_text": "锻炼方式不太够吗……？\r\n……不对，比起在这边后悔，\r\n我应该专心思考眼前的问题。",
      "source_fingerprint": "c39e23fe07ce8855867a3f27f414910f9a34bf6fb27c97fe9fadc61d5cf08638",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20033"
      ]
    },
    {
      "uid": "zhcn:935016ce1cd4e689ae15a310",
      "kind": "character_system_text",
      "source_text": "日积月累的努力造就了现在的我……\r\n所以我一定没问题的……",
      "source_fingerprint": "0bbcc89ed98fc96e9e810bce7940f1224fdb4fc73bb21b56124e3fdf3933672b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20034"
      ]
    },
    {
      "uid": "zhcn:42e3027b9a501358efe2fa34",
      "kind": "character_system_text",
      "source_text": "要想起平时奔跑的感觉才行……\r\n要尽量跟平时一样……",
      "source_fingerprint": "6a6783f9e057a8636515d32d0cd7e0927645ae18a960ae70802c4b6417fb9eb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20035"
      ]
    },
    {
      "uid": "zhcn:237d9d4d8c4f58e608504f79",
      "kind": "character_system_text",
      "source_text": "遇到问题就更该冷静应对……\r\n专注在跑步上吧……",
      "source_fingerprint": "ef530e04d8d4f6f8c9ff8e1d4217a4fcf86758834b346ba69820a3a542202ed5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20036"
      ]
    },
    {
      "uid": "zhcn:ca6458f2074dde643bfa74a1",
      "kind": "character_system_text",
      "source_text": "有人在为我加油……！\r\n就算状态再不好，\r\n我也绝对不想输……！",
      "source_fingerprint": "30a3e4ab7635aaa83918096e823b272354bb568d04f8e6dfe7c58fb7d6ef5f81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20037"
      ]
    },
    {
      "uid": "zhcn:faad34f90251c9662a7d24fb",
      "kind": "character_system_text",
      "source_text": "开始吧！",
      "source_fingerprint": "1f6f9cb6d386b03a59eafb944e976a93775f81d43c59dffa89b8cc34793a942f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20038"
      ]
    },
    {
      "uid": "zhcn:aed2ff5a4a8501cae0df0215",
      "kind": "character_system_text",
      "source_text": "我可以的！",
      "source_fingerprint": "eec2d1c5e39ad06372919431b904049a4e39189d36cb9a69ebde122c825ec0ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20039"
      ]
    },
    {
      "uid": "zhcn:69c17f0662bb1dc6890ec83a",
      "kind": "character_system_text",
      "source_text": "我已经准备好了！",
      "source_fingerprint": "b9e6fab2e0ec9cf73b30d01ceed3d2a4d47ba84afae9cf0d8fda401785979920",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20040"
      ]
    },
    {
      "uid": "zhcn:97ba50330487c030d5ea17b9",
      "kind": "character_system_text",
      "source_text": "我会努力的！",
      "source_fingerprint": "a048816601878f09a8951aadc34edf1f66b7cbb43bb1d5e45d6ee0ce85a4d890",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20041"
      ]
    },
    {
      "uid": "zhcn:458686d81fce7666910d071c",
      "kind": "character_system_text",
      "source_text": "哇，噢……",
      "source_fingerprint": "aa09dcb28cb3aa881c3c7323462c4f6f2053b59033729770117e6923bdabcd8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20042"
      ]
    },
    {
      "uid": "zhcn:2822159b5aabe532c13d9cac",
      "kind": "character_system_text",
      "source_text": "奇、奇怪……？",
      "source_fingerprint": "7ce3cb13489d35794f75c3c08573b9d4945b875f8ba4de242b85011390d70aed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f70dc7b4d419b5f25bebbead",
      "kind": "character_system_text",
      "source_text": "我们走吧！",
      "source_fingerprint": "7b58d964d17854a803d16140a894079104ae8c9281e306d5f49a7ec42fc0837d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20046"
      ]
    },
    {
      "uid": "zhcn:295a800d6161cf027ad9bd01",
      "kind": "character_system_text",
      "source_text": "好想游泳喔！",
      "source_fingerprint": "02e245db7942b4aacf2f1ca84c28706a81ccba65bbc684c62fbf8d0d5ccb73cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20047"
      ]
    },
    {
      "uid": "zhcn:df3f8f0a8f643458b3845310",
      "kind": "character_system_text",
      "source_text": "我不会忘记我们\r\n一起努力过的每一天！",
      "source_fingerprint": "270ca54242a31df632e97787ab153f21bcd90cf006a604e4a99304ce8f667ff1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20049"
      ]
    },
    {
      "uid": "zhcn:8c098cae979c2b2f66780d31",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20050"
      ]
    },
    {
      "uid": "zhcn:12969b3587cd28dac254a804",
      "kind": "character_system_text",
      "source_text": "来吧，Let's muscle！",
      "source_fingerprint": "05d263bba20db2fd461c358c86badfaa0356c9dac84a06fe9f184f7804664a09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "20051"
      ]
    },
    {
      "uid": "zhcn:0866e24bc8965dcd75dab42b",
      "kind": "character_system_text",
      "source_text": "前去取胜吧！",
      "source_fingerprint": "c29dc95012dd6b46b651d819cb7a946b04dd5ada1a160ac35b52d11b7d681c1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "2030"
      ]
    },
    {
      "uid": "zhcn:97429b2207a9e6e79038adc3",
      "kind": "character_system_text",
      "source_text": "各位，我们全力以赴吧！",
      "source_fingerprint": "d83efa9aee0b6bc3aa6709d08370c1925cb731fd7d52326a7379965305c74e75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "2031"
      ]
    },
    {
      "uid": "zhcn:5c8bbee30ec082b946274ba0",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "2032"
      ]
    },
    {
      "uid": "zhcn:12ec58012cdfd177e5bd832d",
      "kind": "character_system_text",
      "source_text": "努力和肌肉是不会背叛我的，\r\n我要向大家证明这一点！",
      "source_fingerprint": "d7cc578be855d5d09aefddf40af585e780305cdf2cee10d9cb6ffeb0c8096234",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "2033"
      ]
    },
    {
      "uid": "zhcn:d84febd66283bb7a5b532f1d",
      "kind": "character_system_text",
      "source_text": "唔～！！大腿后肌好像\r\n随时都要跑起来的感觉……！！",
      "source_fingerprint": "e4f29d5c6ac5f48fb12d8feba685e8bd4c80306bff9e78e8923fd0846dc8db39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "2034"
      ]
    },
    {
      "uid": "zhcn:5243587d8e466151fb272306",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "2035"
      ]
    },
    {
      "uid": "zhcn:3ab08313204db51f004c6d2d",
      "kind": "character_system_text",
      "source_text": "始めましょう！",
      "source_fingerprint": "690c07cec6eb89141bc1d30c56b9875ef465bdb404721c965c822cd54bf6e7cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "23015"
      ]
    },
    {
      "uid": "zhcn:4ab320fec6f8dc4bc9a540b3",
      "kind": "character_system_text",
      "source_text": "好可惜……！就只差一点点而已！",
      "source_fingerprint": "1130ac745d10608414c259e5eddddbc1491351a555f3ac50fb1284dff336b34b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "30000"
      ]
    },
    {
      "uid": "zhcn:86c1ca710ceffc1e8d30a10f",
      "kind": "character_system_text",
      "source_text": "只差一点……还需要再更努力才行！",
      "source_fingerprint": "1041263396723c152e169d0fde7dedda2e0780efac97bcc8161606d52d75622c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "30001"
      ]
    },
    {
      "uid": "zhcn:adbb01108a73dd7b9b577f0c",
      "kind": "character_system_text",
      "source_text": "我不满意这样的结果……我要重新锻炼自己！",
      "source_fingerprint": "605cdf43d848ea6bc15f3bc37b3684dd7e1173c48f1941ec1d827c0a5fc6faa8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
        "30002"
      ]
    },
    {
      "uid": "zhcn:d12e702bb02583f6ff10a22d",
      "kind": "character_system_text",
      "source_text": "虽然已经尽力了，\r\n但还是要好好反省……",
      "source_fingerprint": "fe3921be997995e6f74268d8d81ae12108d0ba4d50d1f3cc140c6e59831f67fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
