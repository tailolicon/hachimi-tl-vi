      ]
    },
    {
      "uid": "zhcn:13a52ec1107f77b422e78fb3",
      "kind": "character_system_text",
      "source_text": "はは……",
      "source_fingerprint": "db5d61662554b61134ae7b25e8270d304456e0980b6298ea31b287073c2a1af5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1027",
