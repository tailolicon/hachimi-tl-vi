      "source_text": "去了…！",
      "source_fingerprint": "e699f4414a41f6de015e498180e3bf43f7504c58b298450a664a474f1b2166e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1030",
        "20039"
      ]
    },
    {
