      ]
    },
    {
      "uid": "zhcn:eb35d1d6b42334b13bc9831c",
      "kind": "character_system_text",
      "source_text": "收集到许许多多的笑容了呢～♪",
      "source_fingerprint": "a9ed074b650c65e7209ddc84c96fa103180869c071f1d7af605bc60fc7635f87",
