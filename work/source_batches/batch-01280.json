      ]
    },
    {
      "uid": "zhcn:1a505d109a5bcd914fbfb109",
      "kind": "character_system_text",
      "source_text": "Go go～♪",
      "source_fingerprint": "6896ec9773964c894d2aafbc7aa57c056faee40a76c0f6fec9f6a53f6dea0eb8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1028",
        "20046"
      ]
    },
    {
      "uid": "zhcn:aa655a830560a037a5965ba2",
      "kind": "character_system_text",
      "source_text": "海产，等着我喔～",
      "source_fingerprint": "5c58d0352ed69c91108250960d15891fa73dadb932a45956ec1ed58c00319759",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1028",
