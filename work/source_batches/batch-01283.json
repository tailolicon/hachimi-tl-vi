        "1031",
        "2033"
      ]
    },
    {
      "uid": "zhcn:6109a44865c1ce4995dc4bfe",
      "kind": "character_system_text",
      "source_text": "我要趁大家还在观察状况时，\r\n向前跑得更远！\r\n刮起一阵最棒的风！",
      "source_fingerprint": "e8726ebb46ae6a4c9537f921fdbee4241c4f90ec8f5745e8916d029df1dd57ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
