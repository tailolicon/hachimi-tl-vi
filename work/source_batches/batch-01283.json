      "uid": "zhcn:f6e3d9beb39a00d843f9870e",
      "kind": "character_system_text",
      "source_text": "短裤穿起来意外地方便活动呢！",
      "source_fingerprint": "8cf6c44cd7f91753cd5b6ed076abe44d04cc4e1d145e784c45396db86ae677a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "70008"
      ]
    },
