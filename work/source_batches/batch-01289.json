        "140012"
      ]
    },
    {
      "uid": "zhcn:58a5e5c913f7b671cf6382f1",
      "kind": "character_system_text",
      "source_text": "紧紧贴在一起……",
      "source_fingerprint": "02f0e5d92b680c83d84ca0393b12880858a3ac4d75db71784dcbf3bfaaae69f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140013"
      ]
    },
    {
      "uid": "zhcn:28618be691c31c73b29fe3f0",
      "kind": "character_system_text",
      "source_text": "啊…",
      "source_fingerprint": "c69a69d134409083b2571486bf2f11af9edeea86eb1ff3cf2e67f3657d70fa6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b0fc3f9ba867f296c8777f44",
      "kind": "character_system_text",
      "source_text": "呣……",
      "source_fingerprint": "b91b1c2f797f548e0ca8ebe74f69167d156757a0ee334d1fe25b9892930dbda3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140015"
      ]
    },
    {
      "uid": "zhcn:945e762ab91b90726e8ddfe2",
      "kind": "character_system_text",
      "source_text": "要瞄准哪个？",
      "source_fingerprint": "e3b2bedd207c06afa14e26e495b3e2c7b0801041c0d226b08b8c34a44ad51fb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140016"
      ]
    },
    {
      "uid": "zhcn:cdf2e84d6156b0e3a78e706a",
      "kind": "character_system_text",
      "source_text": "啊啊……",
      "source_fingerprint": "67d0eeceded72eace8823cc24b753a0a3007c8ea0e0a4fc8073e9cf559b5eb03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140017"
      ]
    },
    {
      "uid": "zhcn:736cb818b1ee1b708275a6f6",
      "kind": "character_system_text",
      "source_text": "……掉下去了。",
      "source_fingerprint": "e1787de21ff976b42187a189e14a1c9394f07cc5ecee543f82a7b8090f420058",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140018"
      ]
    },
    {
      "uid": "zhcn:381c5bbd99485faebed71e64",
      "kind": "character_system_text",
      "source_text": "这好像是明天的奖励。",
      "source_fingerprint": "2cc52300dcdbc0c0f9f9f9e4669553534aeef8cb09a7a9b627a960d44d394a4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "15"
      ]
    },
    {
      "uid": "zhcn:3077aac5c0074f7839157137",
      "kind": "character_system_text",
      "source_text": "……我……不累。\n不用休息。没那个时间……！",
      "source_fingerprint": "006b6dd0211512a1b6f1c3fc154cbb4916068d5d89c13fcf51f347dedcc46357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20000"
      ]
    },
    {
      "uid": "zhcn:1a1d243168d59de8822e6e02",
      "kind": "character_system_text",
      "source_text": "……我还能继续训练……！",
      "source_fingerprint": "92a3c6433e288f66537435cf6813b42395318ee76de86a6ad59d7330cc6f5af1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20001"
      ]
    },
    {
      "uid": "zhcn:ac006c6780f593335d319c12",
      "kind": "character_system_text",
      "source_text": "快点下达指示吧。\n不管怎样的训练，现在的我都应对自如。",
      "source_fingerprint": "9d5af54f6c65fd4f67f24739c8ff0f1341e5611d76c6c8cc358587809675cb20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20002"
      ]
    },
    {
      "uid": "zhcn:a53ab42476ff449efc5d6fbd",
      "kind": "character_system_text",
      "source_text": "我昨晚做了个梦……\n是个非常不可思议……但却非常美好的梦。",
      "source_fingerprint": "52d8437306e2e4bc103a749caafd55c2d32a7e9a153979b9e2442d77924e6591",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20003"
      ]
    },
    {
      "uid": "zhcn:e5c3faccd26103829aa06308",
      "kind": "character_system_text",
      "source_text": "你已经考虑好了最适合我的训练计划了吧？\n毕竟你也是训练员啊。",
      "source_fingerprint": "b47e60ed84991b78f0f9e9ceb5294aff1f66a1da7e401af343668b43aa159d52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20004"
      ]
    },
    {
      "uid": "zhcn:eaf6e98ffc4524b861185346",
      "kind": "character_system_text",
      "source_text": "只要跑一跑就知道我现在状态如何了。\n……要现在试试吗？",
      "source_fingerprint": "213399be25860ecc7f8e530cf5f91a9e22d3dbd7507e2317526d11cd5ae1dcf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20005"
      ]
    },
    {
      "uid": "zhcn:dace1b22aaedde2c880ee071",
      "kind": "character_system_text",
      "source_text": "今天要从什么开始练起？\n……练什么我都无所谓。",
      "source_fingerprint": "e678c9c8ed0ac10d74e387bd1519bfc3916e7a72b46cc92990db0ad4e5ab5b94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20006"
      ]
    },
    {
      "uid": "zhcn:48d1ec9225312abdbf199fd4",
      "kind": "character_system_text",
      "source_text": "热身运动已经做好了。\n……毕竟我比你早来了一会。",
      "source_fingerprint": "145963fbd359b8081f050cfd27be0dbfb92235bd244dbcc9878df8598a65a670",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20007"
      ]
    },
    {
      "uid": "zhcn:2c336699b917d244ee556951",
      "kind": "character_system_text",
      "source_text": "……比赛开始之前别和我说话。\n我得集中注意力。",
      "source_fingerprint": "785889fff4febfdcbfe79ce5462bbe9797e7789fe05b434f57879c672b2c89d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20008"
      ]
    },
    {
      "uid": "zhcn:fe86f46d8ec7a9b311d7aa6c",
      "kind": "character_system_text",
      "source_text": "不用那些多余的关心。\n……我的脚还能动，那就还能继续训练。",
      "source_fingerprint": "992301845dffbb40f4e8b64209e3eb4a1c3f02456658761391c17899a8ad1538",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20009"
      ]
    },
    {
      "uid": "zhcn:3927d61070dcc7e7a359a381",
      "kind": "character_system_text",
      "source_text": "……身体状况应该很好的……\n但为什么身体感觉如此沉重……？",
      "source_fingerprint": "12887ae4b0c9ecc210d5592781a0438e91e50a75a09c886b8cf502f157c8d8f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20010"
      ]
    },
    {
      "uid": "zhcn:4c7290f5bfb0a9d2c196a1d1",
      "kind": "character_system_text",
      "source_text": "不行……\n这样根本配不上做她的姐姐……！",
      "source_fingerprint": "e81b21711319d5b7c492dafa0fb6af59ecb78749c61a7fbe871efc8650973d04",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20011"
      ]
    },
    {
      "uid": "zhcn:03b7e9bdff00787f189c6c1f",
      "kind": "character_system_text",
      "source_text": "连续跑比赛的胜算是……\n不。没事。",
      "source_fingerprint": "2db7e6b1e300f3ee7778e67880906f223ec19dd369279113342de7579924088a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20021"
      ]
    },
    {
      "uid": "zhcn:aea26e340967b9c63e484014",
      "kind": "character_system_text",
      "source_text": "……我的脚没事。\n不会在这里就崩……唔……",
      "source_fingerprint": "80a526e43db63cf2371923a741edd8a3599cc81de0e88298692ef29d0303c1ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20022"
      ]
    },
    {
      "uid": "zhcn:a9467025590c767c38794a1f",
      "kind": "character_system_text",
      "source_text": "……我会赢下来的。\n一定要把胜利的荣光献给她……",
      "source_fingerprint": "2192043ac65873da691556064ab7121010d7c9fd5f7fcb0f85018304753328c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20023"
      ]
    },
    {
      "uid": "zhcn:a0c6c5c4bc7a04cf74b18d4b",
      "kind": "character_system_text",
      "source_text": "完成得很棒……\n至少我是这么想的。",
      "source_fingerprint": "d7f3dad0821fe26c41b1805815e57cff8b50040edf4f4c595eb197fc3c81df0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20024"
      ]
    },
    {
      "uid": "zhcn:4bba185437b43aecc199bb45",
      "kind": "character_system_text",
      "source_text": "姐姐会加油的哦……\n一定要为你……！",
      "source_fingerprint": "dd234ecf843d7cb72e1b3571e6373ac881fe9efd77427d927e7feb3cab7e4ae4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20025"
      ]
    },
    {
      "uid": "zhcn:1eacc7df8e2fde13f135ec78",
      "kind": "character_system_text",
      "source_text": "准备已经完成。\n接下来只等开赛了。",
      "source_fingerprint": "feeb2668d8aea6184a46aa755595de9a825794c0f09d436e7a1a9a4cf71797f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d840b4af0aeda3296f315add",
      "kind": "character_system_text",
      "source_text": "开闸的瞬间……\n嗯。\n该做的事情都好好地记在脑子里了。",
      "source_fingerprint": "8adfd7645adbb2923b406c884272af7776d71fd87ba5090c2c7c21afcd03f063",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20027"
      ]
    },
    {
      "uid": "zhcn:f6690622c374aeae81d6f62e",
      "kind": "character_system_text",
      "source_text": "我的目标……只有第一名。\n除此以外的结果我都无法接受。",
      "source_fingerprint": "88bca3ba3a28a3ac6aee0b630fc57b07566905b0ad5626478dc031ef55551ca9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20028"
      ]
    },
    {
      "uid": "zhcn:9c1c23d66438b7e5ec3fc7b8",
      "kind": "character_system_text",
      "source_text": "只要像训练时那样奔跑，\n应该就能得到不错的结果……",
      "source_fingerprint": "af4458051eee1b7b8791c8530cadfcd98c0c8ce4886dd3dce849d51ef68fd25f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20029"
      ]
    },
    {
      "uid": "zhcn:c4cb86ca578b0d73341ca378",
      "kind": "character_system_text",
      "source_text": "状态不好不坏。\n不过，比赛前就是这种状态比较好吧？",
      "source_fingerprint": "8aef081faa343653dba66820cc628c6771dcc63554d7f6f7c6a17d538297bf6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20030"
      ]
    },
    {
      "uid": "zhcn:df9a5aa25eec6708ebe8c2da",
      "kind": "character_system_text",
      "source_text": "……差不多就该去赛前体检了吧？",
      "source_fingerprint": "7ac850cc5729664890a7a755a608c2ea049f6e789f2ad9ab70e2bbde52ae1bb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20031"
      ]
    },
    {
      "uid": "zhcn:04d350bf560974a98197c259",
      "kind": "character_system_text",
      "source_text": "如果以这种状态出赛的话……\n不……一定有胜算的……！",
      "source_fingerprint": "392e2fca62e595741ffa3b2f9c25091c16bc84026ce263f39ea17f8cb41196a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20032"
      ]
    },
    {
      "uid": "zhcn:2247ef9c823d2446cd7adb59",
      "kind": "character_system_text",
      "source_text": "好像比赛的日子已经到了呢。",
      "source_fingerprint": "e7f7269f3a132aada90beb9f53582e78bb8c7f1fb97e44c438628e3e0cb944cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20033"
      ]
    },
    {
      "uid": "zhcn:19469568e071567bb8f09e51",
      "kind": "character_system_text",
      "source_text": "呼……哈……呼\n得好好调整呼吸才行……\n事到如今还会紧张什么的……",
      "source_fingerprint": "df21914545d777c3a4160c74161f84225a5d5b24652f5404701f606ff54975e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20034"
      ]
    }
  ]
}
