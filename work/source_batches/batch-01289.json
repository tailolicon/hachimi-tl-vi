      ]
    },
    {
      "uid": "zhcn:d2b8cbad4eb0dcd0bc827c33",
      "kind": "character_system_text",
      "source_text": "你还挺厉害的啊。",
      "source_fingerprint": "d987558480fbfb6fb4a78cd1d1b03823787a280a5156c30cfb321a53c66e6b84",
      "source_path": "character_system_text_dict.json",
