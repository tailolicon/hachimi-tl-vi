      "kind": "character_system_text",
      "source_text": "没想到……",
      "source_fingerprint": "27201a5739efbc786e3daae4b2825905c65cd3b8d1d19920f33df6bbf1b153b3",
      "source_path": "character_system_text_dict.json",
