      "kind": "character_system_text",
      "source_text": "抓到了……",
      "source_fingerprint": "1742dc81dfa2eab5e84309be145ebd5540552010671da4f42f09eca2791b814f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140001"
      ]
    },
    {
      "uid": "zhcn:90bc6bd22d752435b1a357dd",
      "kind": "character_system_text",
      "source_text": "真遗憾。",
      "source_fingerprint": "e172f7521a4de44db8fa95e8daa9837967c25aa50f3dd0a6953437efbf46ba63",
      "source_path": "character_system_text_dict.json",
