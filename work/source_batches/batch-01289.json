      ]
    },
    {
      "uid": "zhcn:e7468ed1b92862de66fda79e",
      "kind": "character_system_text",
      "source_text": "……偶尔也是会这样的。",
      "source_fingerprint": "dc0cc33973c1ea593ecee158893e6124459e0ab4b133ad9ad0af6ebb8eed581c",
      "source_path": "character_system_text_dict.json",
