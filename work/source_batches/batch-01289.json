      "kind": "character_system_text",
      "source_text": "……好像已经开始了哦？",
      "source_fingerprint": "11a4d2900994ca7e8b4b3fab7d32adf020be388ebe73af887c64803b618b2d08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
