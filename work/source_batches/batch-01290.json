      ]
    },
    {
      "uid": "zhcn:152c24b3d0058cd6e1df1cbf",
      "kind": "character_system_text",
      "source_text": "嘿嘿嘿～",
      "source_fingerprint": "5cbce7b196e61cd833310604edfd337eb3c1d98374e164748a32976ce89a7988",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140008"
      ]
    },
    {
      "uid": "zhcn:f53ecfb1c7227c3aacb4273f",
      "kind": "character_system_text",
      "source_text": "嗯？",
      "source_fingerprint": "8af85ce981d9ec89ad4d75b1bd062ebe03e9f22dc5edb7cd9b8099f05574c6c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140009"
      ]
    },
    {
      "uid": "zhcn:4b7065be8f626880b51bd270",
      "kind": "character_system_text",
      "source_text": "哎呀……",
      "source_fingerprint": "aa590602b03384649277b084cd36d881d4f24707abf056fd0a939443d6e5c4fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140010"
      ]
    },
    {
      "uid": "zhcn:e7e420a40fc38fd00482871f",
      "kind": "character_system_text",
      "source_text": "喔喔喔……！？",
      "source_fingerprint": "1bcbd79076cef3b25c113743ca8785255200a38a7b5bba8608709011fa721469",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140011"
      ]
    },
    {
      "uid": "zhcn:0fd8b86940d28420ff6a5e30",
      "kind": "character_system_text",
      "source_text": "好厉害！",
      "source_fingerprint": "c922c5de8a35921e2086ab355870227069194ca65614c757deb698452d7f0151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6664ab6d6d3da43bb0c7da74",
      "kind": "character_system_text",
      "source_text": "哇哇哇～！",
      "source_fingerprint": "42f83ca6cb38e0da5eeb207f436b76521f3e421b160a514415fc5ba64eafc5d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140013"
      ]
    },
    {
      "uid": "zhcn:31563b4baea220cb90cbc256",
      "kind": "character_system_text",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140014"
      ]
    },
    {
      "uid": "zhcn:8020235ca07f3f074eff0ba7",
      "kind": "character_system_text",
      "source_text": "上吧～！",
      "source_fingerprint": "ad51313ddb6acfd0e595b635636fa16f8d3999fc7da3e675619b13687b18b218",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140015"
      ]
    },
    {
      "uid": "zhcn:b37163ee8b4592151b487396",
      "kind": "character_system_text",
      "source_text": "嗯？怎么了？",
      "source_fingerprint": "869b92146001f5bc75b78af87c2814c4aadb3db6f5fec7e240efe18ab8dfa8fc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140016"
      ]
    },
    {
      "uid": "zhcn:beb2d8dcb82b74b9633a08a6",
      "kind": "character_system_text",
      "source_text": "啊～！",
      "source_fingerprint": "b1ca97bac33c41dc27633627383cebde309f2e50c905e4e33ce8aeb305b83310",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140017"
      ]
    },
    {
      "uid": "zhcn:bc065b8a597053fb101ff25c",
      "kind": "character_system_text",
      "source_text": "可惜！",
      "source_fingerprint": "8719b3a4e2a6c01d841d2c3849685d8082e042196108ff7956dcaebfa3fb2806",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140018"
      ]
    },
    {
      "uid": "zhcn:a29e0e558011d2a3d233d22a",
      "kind": "character_system_text",
      "source_text": "明天是这个！要确认一下喔！",
      "source_fingerprint": "fe20a7ad7a37517a04349ad9fe31abaf563fea5d853c21273dfcc806d5367586",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "15"
      ]
    },
    {
      "uid": "zhcn:349e1f9bc59a203aa340f168",
      "kind": "character_system_text",
      "source_text": "唔……等这个训练做完后，\r\n再好好睡一觉就行了……对吧。",
      "source_fingerprint": "e91237899e8ad98658e279ddc9734dbf2e5655b9a9f3069d29acaf4f8229c4df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20000"
      ]
    },
    {
      "uid": "zhcn:8321bba1c91ba9cd06506f62",
      "kind": "character_system_text",
      "source_text": "呃～要不要休息一下？\r\n这也是为了让我们之后\r\n能表现得更好，对吧！",
      "source_fingerprint": "27ed47d737a9dac56c51fbb8660bebe7e5fdb020ac3491c63e88bdd5d8b30945",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20001"
      ]
    },
    {
      "uid": "zhcn:118d108469c24bcd051401d2",
      "kind": "character_system_text",
      "source_text": "好～脚的状况很好！心情也很好！\r\n一切都很好！\r\n接下来要做什么都没问题！！",
      "source_fingerprint": "e6e45877ceab88cc6d9666dc7d8284edece6f3fa9dc7d8520d936a94934ab0fc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20002"
      ]
    },
    {
      "uid": "zhcn:c695cdb15e9385896a43d19b",
      "kind": "character_system_text",
      "source_text": "今天一定能跑得很畅快！\r\n先准备好运动饮料吧～♪",
      "source_fingerprint": "747953f2d2c09c4dcb62a0c01f1ba73b5f643b34ef2532f76237ef7e55654108",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20003"
      ]
    },
    {
      "uid": "zhcn:6e52b7e6f5901c3cd68200cc",
      "kind": "character_system_text",
      "source_text": "吹起了顺风，感觉不错呢！\r\n好～鼓起干劲上吧！",
      "source_fingerprint": "0c41a6e6d2b8d099ba08c37c8afc18b9b3d624ca5caf0464c56c74add8b4d54e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20004"
      ]
    },
    {
      "uid": "zhcn:2e721203dcfff36ba4147fad",
      "kind": "character_system_text",
      "source_text": "今天渔船大丰收～♪\r\n我要尽管买、尽管吃～♪\r\n……欸嘿嘿，我已经准备好啰！",
      "source_fingerprint": "b918e6d6f3d2ceea2a7c35960d543b6f448828d15aef67467d728cafaf73759d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20005"
      ]
    },
    {
      "uid": "zhcn:0f898483d783a49ff2a935b6",
      "kind": "character_system_text",
      "source_text": "能量棒补充完毕！\r\n我已经准备就绪啰！",
      "source_fingerprint": "8bd3e18adff493d8d5f3b530440182007fe8d3ddb363282e0bacb25bacbe72ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20006"
      ]
    },
    {
      "uid": "zhcn:b7de8434627ce8cd1df5bec7",
      "kind": "character_system_text",
      "source_text": "嗯～天气真好～！\r\n训练员要不要偶尔也来一起跑？\r\n一起用练跑来好好地地流个汗吧！",
      "source_fingerprint": "aa7a87306b234c728af21ae3805383a38fab72857284447460530fcb70defc4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20007"
      ]
    },
    {
      "uid": "zhcn:bdecfb65a7930a63366ac84d",
      "kind": "character_system_text",
      "source_text": "总觉得心情不太畅快……\r\n去跑一跑应该就会比较起劲吧？",
      "source_fingerprint": "01ace297bf74eec274a6a81e228d247b28408f735aae3c7104a764885d8cf34c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20008"
      ]
    },
    {
      "uid": "zhcn:ff5c73de3007457d6d8c4ed4",
      "kind": "character_system_text",
      "source_text": "……啊，抱歉！\r\n我好像发呆了一下……？",
      "source_fingerprint": "bd25fb317bf214a2fba4921224272a6589c3498cdc272979013fbb62744425fc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20009"
      ]
    },
    {
      "uid": "zhcn:a031b3e52c5fba58858fe669",
      "kind": "character_system_text",
      "source_text": "……感觉不太妙。\r\n怎么跑都提不起兴致……",
      "source_fingerprint": "8786388799b78e6d2df86cc2d2bf0f78082d35be8c34e2f9419ad9cb9ce4ed65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20010"
      ]
    },
    {
      "uid": "zhcn:42a281e3258da5a71d255e8c",
      "kind": "character_system_text",
      "source_text": "那个，我实在不太想让你担心，\r\n不过……\r\n……算了，没事啦！",
      "source_fingerprint": "6cc88b217820c4e853008cfeb6ac5f79731df70e1236aa47d4981842f8c35ea9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20011"
      ]
    },
    {
      "uid": "zhcn:94c638220453c9468f1858b2",
      "kind": "character_system_text",
      "source_text": "训练员，我很高兴你愿意\r\n让我参加许多比赛……\r\n但如果累倒可就得不偿失啰。",
      "source_fingerprint": "a09991310ba0730599449a57795350ea15f3262ca33123c1faf5c9ad37f9fad2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20021"
      ]
    },
    {
      "uid": "zhcn:2d8e1af34eff2fbbfa149dd2",
      "kind": "character_system_text",
      "source_text": "虽然我打工时也曾连续排班，\r\n但可都有在可承受的范围内喔？\r\n现在这样非常！极度！勉强！",
      "source_fingerprint": "e0a4737c74c219cdf8fe1889721430afc61297d39f3c0673c90db00c484e2908",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20022"
      ]
    },
    {
      "uid": "zhcn:c9767580aed03e75712c2640",
      "kind": "character_system_text",
      "source_text": "我会跑得任何人都快，\r\n遥遥领先所有人！",
      "source_fingerprint": "4982a18d134a5289b56a21a95ffdfea3092001635cd977d07f0f5981e1fe9483",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4ff538ef55d91ede68d10527",
      "kind": "character_system_text",
      "source_text": "我早上打电话给家人，\r\n叫他们来看我今天的比赛……\r\n嘿嘿，我得表现出帅气的一面！",
      "source_fingerprint": "6d945ac3bbbef10551b8a37da7e9cddb88538e09608cec2418b37c4b5e160750",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20024"
      ]
    },
    {
      "uid": "zhcn:bf89d3442bde48f9ab49bb24",
      "kind": "character_system_text",
      "source_text": "我要趁大家还在观察状况时，\r\n向前跑得更远！\r\n要掀起一阵最棒的风！",
      "source_fingerprint": "63baaab2745e3da8e695eb9b9b55e18ae0123353b5730a7f64370fad91d41a94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20025"
      ]
    },
    {
      "uid": "zhcn:e7aca7a352173884257d35c5",
      "kind": "character_system_text",
      "source_text": "噗通、噗通……呵呵，\r\n无法压抑内心的悸动！\r\n今天会成为什么样的比赛呢～！",
      "source_fingerprint": "b5d37342b2774a177c0db3e01c466263217408578e8914df5aa5695c27d7323a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20026"
      ]
    },
    {
      "uid": "zhcn:6df180a5fd56f1bccd6306d6",
      "kind": "character_system_text",
      "source_text": "向前迈进，化为强风！\r\n称霸比赛的会是我！",
      "source_fingerprint": "fbe6497e5c9bbef6c8287a9b57886bdaf9067a3d4d36172bce3083aa4d7bc929",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20027"
      ]
    },
    {
      "uid": "zhcn:feccd254b2485018629ee591",
      "kind": "character_system_text",
      "source_text": "训练员，你是不是在紧张？\r\n你尽管放心吧！\r\n剩下的事情就交给我吧♪",
      "source_fingerprint": "15b146214f295d84503c41fb166c20a6aac993f07e874c13e48a75fa5e606605",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20028"
      ]
    },
    {
      "uid": "zhcn:f1ed73507732905d1726204a",
      "kind": "character_system_text",
      "source_text": "嗯，状况普普通通吧！但只要\r\n一开始跑，引擎应该就会热起来啰！",
      "source_fingerprint": "b429c39e4d88986fc6831ca4f1fdac360ecba31a885f225bf03fd88f83b7c93d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20029"
      ]
    },
    {
      "uid": "zhcn:8b48396d6172b96305406fd8",
      "kind": "character_system_text",
      "source_text": "为了避免过度前倾，\r\n必须维持稳定的姿势……很好！",
      "source_fingerprint": "5bd4cf38a85186c1d0c7db239436c098f98e020664227932baf09bc3b4dc0684",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20030"
      ]
    },
    {
      "uid": "zhcn:19462c80f27eb691bd1b331b",
      "kind": "character_system_text",
      "source_text": "帮我加油吧！\r\n训练员的声音，\r\n一定能成为我的极大助力！",
      "source_fingerprint": "9a5b7e8be468db20e854c0adfb117900d7d91cc4f58d35d91c4cd800ee925e2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20031"
      ]
    },
    {
      "uid": "zhcn:377ffae86447db6df88ec083",
      "kind": "character_system_text",
      "source_text": "不可能每次的状况都很完美对吧。\r\n放心，我很擅长应付逆境……！",
      "source_fingerprint": "f8b365560f9552e423e3ab19341be74ab89c9507b23663bb9e3a55bd0024083a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20032"
      ]
    },
    {
      "uid": "zhcn:cde7716495f73cf30a42ef1c",
      "kind": "character_system_text",
      "source_text": "振作一点……妹妹们都在看……\r\n身为姐姐，必须好好向她们\r\n展示帅气的一面……！",
      "source_fingerprint": "df580b117887da2ec3a357a9c18933c2365c56468dd77b37851733019375308d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20033"
      ]
    },
    {
      "uid": "zhcn:13af6dbddfa159a14c5366a9",
      "kind": "character_system_text",
      "source_text": "比赛前小睡一下……\r\n不，应该不至于吧……",
      "source_fingerprint": "b5f9b94c332957eec461732b8826b8e7215cce0af62dadf92ceb837fd5320f60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20034"
      ]
    },
    {
      "uid": "zhcn:51e4428b1863d4f88e03feb3",
      "kind": "character_system_text",
      "source_text": "首先要冷静，然后面向前方……\r\n再来只要跑就行了吧……！",
      "source_fingerprint": "0d3344d3ede4b2eeda232071dd3ddc88176b656527115819034c3e1211c5fb54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20035"
      ]
    },
    {
      "uid": "zhcn:09919aaff1ab0254e2a281d3",
      "kind": "character_system_text",
      "source_text": "……想太多也没用。运气也是\r\n实力的一部分！如果能招来……\r\n不对，我必须招来运气……！",
      "source_fingerprint": "310ca1e048fc8f1dff3efbadfd29f5379d7d0098a850af8347e519684a9bee65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20036"
      ]
    },
    {
      "uid": "zhcn:35e23c2bd236d207ad3bb3a0",
      "kind": "character_system_text",
      "source_text": "爸爸、妈妈和妹妹们……\r\n大家都在替我加油。我想响应……\r\n我必须用自己的表现响应他们……！",
      "source_fingerprint": "fd0713a54460ae837d5f1995da6812d904fac040d3ce5211a9dd688c521f0349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20037"
      ]
    },
    {
      "uid": "zhcn:8b044be397ce380309fe69e4",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20038"
      ]
    },
    {
      "uid": "zhcn:82259c29cbdf3c51ffe08626",
      "kind": "character_system_text",
      "source_text": "包在我身上！",
      "source_fingerprint": "a6a9acd055804ce0f74537dbef9981e46eb5b056161bbf6886f836ddd3d3cb2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20039"
      ]
    },
    {
      "uid": "zhcn:2f7d8961aa4bf9b75c80444e",
      "kind": "character_system_text",
      "source_text": "轻轻松松～♪",
      "source_fingerprint": "ed93b730b8a179b81db0ddbbbd878f43cada86c19efb79aadba8bb37dad8b67c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "20040"
      ]
    },
    {
      "uid": "zhcn:2a684873595a0edcf32f696c",
      "kind": "character_system_text",
      "source_text": "嗯嗯。",
      "source_fingerprint": "c0dad597dc82a31dd69060476ba8d5a0bc081bd7005ed6641f89ca6ade33857a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
