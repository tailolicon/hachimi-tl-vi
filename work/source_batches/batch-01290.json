{
  "schema_version": 1,
  "batch": 1290,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:87900e8ef13dba06be436b16",
      "kind": "character_system_text",
      "source_text": "……我只是在集中精力。\n不用过于担心了。",
      "source_fingerprint": "a0c735ceb27780034d201b796d0a92462f41bfa13042024c468ae504ae27371b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20035"
      ]
    },
    {
      "uid": "zhcn:49bef25f6cdf6ded61422bad",
      "kind": "character_system_text",
      "source_text": "……必须要赢……\n我……不得不赢……！",
      "source_fingerprint": "addb5e284ae76ad76e5ec41669f1d1634902e1c326e35c338b99ed886cc1c522",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20036"
      ]
    },
    {
      "uid": "zhcn:d46f9f2014fcafd71b07b24c",
      "kind": "character_system_text",
      "source_text": "……不想认输……唔……！",
      "source_fingerprint": "759d18e5637fac0a7d2079b03b4e8db5b3393219ffff2ce0332c08376b5b1085",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20037"
      ]
    },
    {
      "uid": "zhcn:2b66e7a5b265904ef19e1a98",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2a7deb3e686bdce36f17de42",
      "kind": "character_system_text",
      "source_text": "我知道了。",
      "source_fingerprint": "e4751dd24b1cc01c018d0bfc5e41666107f225b47c76b137af696c4a8217995a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20039"
      ]
    },
    {
      "uid": "zhcn:1012d3e27bc6031292401c91",
      "kind": "character_system_text",
      "source_text": "……好。",
      "source_fingerprint": "8e83aa0ebedbafc894362e5d9b45b0cb4ab939fe816a08aef341ea714cebcabe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20040"
      ]
    },
    {
      "uid": "zhcn:ad77ba8e55122bbac7dfabdd",
      "kind": "character_system_text",
      "source_text": "资料呢？",
      "source_fingerprint": "9824a800a2a3baf9e89a3181aa9aa937d3db6551dfd8ef10c55012ef304d008a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20041"
      ]
    },
    {
      "uid": "zhcn:c031fa4ff75fa9ca64228fab",
      "kind": "character_system_text",
      "source_text": "身体……！",
      "source_fingerprint": "a0dd6de931186f4acd50fe35047b6348758714bd908669228c1e8421a8786a32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20042"
      ]
    },
    {
      "uid": "zhcn:4e41f3b197227960113939c8",
      "kind": "character_system_text",
      "source_text": "嗯嗯……",
      "source_fingerprint": "26ff4925698843c3792c7f0bc377e245a84f32db565113d4ccaa189fe812f9dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20043"
      ]
    },
    {
      "uid": "zhcn:38907926a35c53e17678cc74",
      "kind": "character_system_text",
      "source_text": "……了解，",
      "source_fingerprint": "80fdb44e8129e1843f11bb6902ca512014f3b3d53d8baa1a768bcaf2b7efce88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f2a76f19c3d64a06e8672d92",
      "kind": "character_system_text",
      "source_text": "是海呢……",
      "source_fingerprint": "f0d0a81190bd66156fd68800a44ab240715e92bc534675bdbb8770fc43bd6cd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0008f2b6481f5876873399b3",
      "kind": "character_system_text",
      "source_text": "……谢谢你的陪伴。",
      "source_fingerprint": "a0320111a9d29ae352083d23d6587b4871beef9693430e9992bcd7b7147dd0d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20049"
      ]
    },
    {
      "uid": "zhcn:36690bce0b0a8ab4b56d39a2",
      "kind": "character_system_text",
      "source_text": "……看来结束了呢。",
      "source_fingerprint": "4d9e793f70548767d672b9584fd95a76d97537035ead0355fbd90614bcae1a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20050"
      ]
    },
    {
      "uid": "zhcn:cdbfcd855abe7d2229afc1bc",
      "kind": "character_system_text",
      "source_text": "可以帮我吗？",
      "source_fingerprint": "357492d9d5e843ca47cf63a36cdf6e44180a917be3cc6baee1e00a90b3ed6179",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20051"
      ]
    },
    {
      "uid": "zhcn:16aa261c69aa209d209fba80",
      "kind": "character_system_text",
      "source_text": "……到我出场了呢。",
      "source_fingerprint": "aaaa46034bee807d6805f99aa9201d489fe785311edd88bd622751b2d670f11c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2030"
      ]
    },
    {
      "uid": "zhcn:1edaae1ec7e83bd84c23507b",
      "kind": "character_system_text",
      "source_text": "上吧。",
      "source_fingerprint": "2eb0d881cd80a16baae5d41c1d7268ab2194b50e1175597b0547df0c45d47e02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2031"
      ]
    },
    {
      "uid": "zhcn:5d13aeb3f57a7a50e58c0dca",
      "kind": "character_system_text",
      "source_text": "……看来结束了呢。",
      "source_fingerprint": "4d9e793f70548767d672b9584fd95a76d97537035ead0355fbd90614bcae1a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2032"
      ]
    },
    {
      "uid": "zhcn:2918d25e2333333650a7aa37",
      "kind": "character_system_text",
      "source_text": "我的目标……只有第一名。\n除此以外的结果我都无法接受。",
      "source_fingerprint": "88bca3ba3a28a3ac6aee0b630fc57b07566905b0ad5626478dc031ef55551ca9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2033"
      ]
    },
    {
      "uid": "zhcn:2aeb8259167f43de4c5f6e36",
      "kind": "character_system_text",
      "source_text": "姐姐会加油的哦……\n一定要为你献上……！",
      "source_fingerprint": "c13f3afaef642b8c9544da332e7095cad1f9b26b9fcba7b219d89bb6940f3a3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2034"
      ]
    },
    {
      "uid": "zhcn:04cd82c9615f5691810eb077",
      "kind": "character_system_text",
      "source_text": "……看来结束了呢。",
      "source_fingerprint": "4d9e793f70548767d672b9584fd95a76d97537035ead0355fbd90614bcae1a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2035"
      ]
    },
    {
      "uid": "zhcn:bba1293bb786e58f11c57602",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "23015"
      ]
    },
    {
      "uid": "zhcn:5918885246693a49c0568e3f",
      "kind": "character_system_text",
      "source_text": "看来这样行得通。那么下次的话……！",
      "source_fingerprint": "cd236fa3f4b169c9050711032b456714d5e12daee8538873ab6f939234ca90f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30000"
      ]
    },
    {
      "uid": "zhcn:daca4456ca04d6f804f8c538",
      "kind": "character_system_text",
      "source_text": "这次……绝不退让。",
      "source_fingerprint": "be43126ad50d6fe72c639095aa4407e3bb932a054bbaa03eb6ac9798d57f85d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30001"
      ]
    },
    {
      "uid": "zhcn:1722c107092f91b335d510e8",
      "kind": "character_system_text",
      "source_text": "更高的地方……！",
      "source_fingerprint": "969d51ef09513dd4ef1e8eabf1415c7fcfc0e6279e846d485750008b9500bd3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30002"
      ]
    },
    {
      "uid": "zhcn:bc21c31529e155395eb3d3e3",
      "kind": "character_system_text",
      "source_text": "怎么会这样……\n这样下去的话……！",
      "source_fingerprint": "a88149b1927ebc751717a7e51fc933f16f650000a8f93dfe2793f774cb87ca5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1483736d634ee70036320cfb",
      "kind": "character_system_text",
      "source_text": "一等星的光辉……就在此处。",
      "source_fingerprint": "1f863317a082b48625ff339f07a8c7276046bb114404737141854600c25bf70a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30004"
      ]
    },
    {
      "uid": "zhcn:9d0b8c0df14476bce7382efa",
      "kind": "character_system_text",
      "source_text": "向着比浮云、比天空更为遥远的你——\n献上这份胜利。",
      "source_fingerprint": "2ca4a989c80d5d08a8f120b189a8fa2ed7b10294805c991ec92435a28f5ea401",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30005"
      ]
    },
    {
      "uid": "zhcn:df66b734c7bc7b9a999dc3ac",
      "kind": "character_system_text",
      "source_text": "真的，已经习惯了吗。\n在这圣夜的星空下……",
      "source_fingerprint": "881641c1e8ee9629e92ba9ac6c37f58ff987f62c50a139ae6a435c5f729f48a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30006"
      ]
    },
    {
      "uid": "zhcn:1a91e88c3c287080e180797e",
      "kind": "character_system_text",
      "source_text": "向着比浮云、比天空更为遥远的你——\n献上这份胜利。",
      "source_fingerprint": "2ca4a989c80d5d08a8f120b189a8fa2ed7b10294805c991ec92435a28f5ea401",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30007"
      ]
    },
    {
      "uid": "zhcn:fd3eeaf222546e2605c20af4",
      "kind": "character_system_text",
      "source_text": "……我会赢下来的。",
      "source_fingerprint": "fa1a465ce81ad92da3d37bfb05290b85264ab48bd466284232a399a88143df7b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "31000"
      ]
    },
    {
      "uid": "zhcn:9a2ba4ab71fa1c99898dd397",
      "kind": "character_system_text",
      "source_text": "一瞬间就能决出胜负。",
      "source_fingerprint": "7908d435d1d6cdeab8d8d23cb2b690bd4c77da26a86330e2e7dae7162635cf5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40000"
      ]
    },
    {
      "uid": "zhcn:92ee3ecf686169de76670486",
      "kind": "character_system_text",
      "source_text": "…最近，机伶总是在聊\n她推荐的店。  \n那到底是怎么回事啊，那个……",
      "source_fingerprint": "5deebd8393a794283e9f73670556a0aba9adb690c990cd1b8f0607f1ea71e52b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400001"
      ]
    },
    {
      "uid": "zhcn:9dd64c7973ade02c1a684ea4",
      "kind": "character_system_text",
      "source_text": "怒涛……有时候，有点努力过头了。",
      "source_fingerprint": "ce2ae30f3b0783e5d1005d579d8b7367761582c23596c26358a14c5593c742b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400003"
      ]
    },
    {
      "uid": "zhcn:a116bdf833a1b2dd77494e89",
      "kind": "character_system_text",
      "source_text": "最近成田路同学一有空\r\n好像就会去听歌剧。\r\n她到底有多认真啊…",
      "source_fingerprint": "0709446d09168ef90e693cf98246d98689bd8fa158cee798f2d95399158e3b2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400004"
      ]
    },
    {
      "uid": "zhcn:b9ea60f7d7000d6341c9a376",
      "kind": "character_system_text",
      "source_text": "一不留神就来了…\r\n怒涛她们没问题吧…",
      "source_fingerprint": "9d028d131294b7ea762fcfc7e815c0aaac84e67a91edcd3bfaab7cf11e5e2bb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400007"
      ]
    },
    {
      "uid": "zhcn:59a0688ffa51d16b2cdee2ef",
      "kind": "character_system_text",
      "source_text": "流星群。我所想要实现的愿望只有一个——\n将我的奔跑，化为祈祷吧……！",
      "source_fingerprint": "d37106144a9cb329c9a32da0f79cc72e6b75f0a8ade59f10299dcfed81599bca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40001"
      ]
    },
    {
      "uid": "zhcn:f9fd1d977b64ab334a92cb08",
      "kind": "character_system_text",
      "source_text": "我真希望\n不要再被卷进去了……  \n不过，这次。也不坏吧。",
      "source_fingerprint": "68bca04d4ed632d713b17454a2042b7c7877363d3b443841b36a378d7e96770d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400010"
      ]
    },
    {
      "uid": "zhcn:cc7c7a422ec2ef94ed82004d",
      "kind": "character_system_text",
      "source_text": "在雪融化之后，的前方……！",
      "source_fingerprint": "1b4f7aadcb16a2621189db01c0a475057e7f875d63692d4bed87d55bd23002ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40003"
      ]
    },
    {
      "uid": "zhcn:9c5654f2bcd2e9359ee7f548",
      "kind": "character_system_text",
      "source_text": "来吧，我们出发吧。\n漫长的黑夜过去，终于迎来了期待已久的……朝霞。\n……冰冷，又温暖。",
      "source_fingerprint": "09bcd5e35cfa7c5f661e45b92f4241da9726859de67bfd935b7455dbcc00d8f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40004"
      ]
    },
    {
      "uid": "zhcn:93433daba95745c47b55b05a",
      "kind": "character_system_text",
      "source_text": "我居然会去主题公园什么的……  \n虽然是一时起意，但还真让人吃惊呢。  \n……不过，都是平时那几个人啦。",
      "source_fingerprint": "2d0884386a6e7ae16e8d19a74a6ff358031a36e59469bc63ceeda3bff606bbeb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400090"
      ]
    },
    {
      "uid": "zhcn:37f4d06d1ec3a078a20819b1",
      "kind": "character_system_text",
      "source_text": "即便只是站在舞台边上，\n也能听见欢呼声呢。",
      "source_fingerprint": "9771551be411c032acd09c1147a7ab50b266ff846a1f0e6e67125600246998eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "60000"
      ]
    },
    {
      "uid": "zhcn:0f822a7ac3420ace2f540a60",
      "kind": "character_system_text",
      "source_text": "……歌曲也是献给她的礼物的一部分。",
      "source_fingerprint": "ffda2bcccab93a0394cf45b60a507622ebb280a0b3c728751033372d6278fda2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "60001"
      ]
    },
    {
      "uid": "zhcn:bb3824f1919f240cb911f85d",
      "kind": "character_system_text",
      "source_text": "请你亲眼见证吧——\n我完成约定的瞬间。",
      "source_fingerprint": "34ed4f74b4e8910493b9ce290f39c6d998134022f4dd9a86b598d53b6b4bd498",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70000"
      ]
    },
    {
      "uid": "zhcn:3026ae52009518e3c6ef66b7",
      "kind": "character_system_text",
      "source_text": "当时并不是受了你的帮助，只是……\n为了前进，必须要有训练员而已。\n只是这样而已。",
      "source_fingerprint": "ce5983fe714d88b7e371ccbde5af07160cc6a1f6140232f182629f19a29cab09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70001"
      ]
    },
    {
      "uid": "zhcn:71c8c707487bca8399b65db7",
      "kind": "character_system_text",
      "source_text": "这身衣服，\n是我通过入校考试的证明。",
      "source_fingerprint": "77fee2dcd44a26838b2fea1cbd07224471044ad164851c59f53b52658219a392",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70004"
      ]
    },
    {
      "uid": "zhcn:d5fd5bbb774382c2b19134c8",
      "kind": "character_system_text",
      "source_text": "Live的练习的话……\n我觉得现在并不需要……",
      "source_fingerprint": "c44048eb3a286e5eb7197fcbb364a6e889712528e3960ddfac55804c85a60e7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70008"
      ]
    },
    {
      "uid": "zhcn:984034b5da4709940ba6f8eb",
      "kind": "character_system_text",
      "source_text": "在这最顶尖的舞台上，\n一定要取得胜利……！",
      "source_fingerprint": "4b9fbdb838e67ef3768e2887d744ada8f6516a9d10345922a8bacbe3b7296f33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70009"
      ]
    },
    {
      "uid": "zhcn:dbe4e871490b0b0b32ff1a48",
      "kind": "character_system_text",
      "source_text": "……从我母亲那一代开始就没变过呢。\n这身衣服也是、这所学校也是。",
      "source_fingerprint": "a37bb30f0106f5461ee10bda864f8a13e9a8fbbc08b19d7d7126a8d21ef691fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70010"
      ]
    },
    {
      "uid": "zhcn:0b1b5f87d4c71ba78bf5be3b",
      "kind": "character_system_text",
      "source_text": "笑容吗……\n在正式表演的时候会尽量微笑的。",
      "source_fingerprint": "68d15084079c3d6cbb129ab3a243260727777724130c9c443693ef78a6755287",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70014"
      ]
    },
    {
      "uid": "zhcn:8ec19060a6d8bdf98a13b8b7",
      "kind": "character_system_text",
      "source_text": "……居然想让群星缠绕于身，\n真是蛮不讲理的愿望。\n但是……",
      "source_fingerprint": "8346084afd9a1c10ac23ab3443f4c64fd2c4917a3eebffa5b7ded97e0bf7a6d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70015"
      ]
    },
    {
      "uid": "zhcn:36607323f45f20cf0fc725fc",
      "kind": "character_system_text",
      "source_text": "纤细、洁净……对我来说，有些太耀眼了。",
      "source_fingerprint": "1dcc4a5fa5c846417bef08c786e1fd3e7f3ac089a65c79bb969d12673c05330d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70016"
      ]
    },
    {
      "uid": "zhcn:17362e250693813e0309cd94",
      "kind": "character_system_text",
      "source_text": "……不由得让人回想起来呢。\n那些大家一起创造的回忆。",
      "source_fingerprint": "6322a758ec0893b76ae2aa02e439fc2744369726c3137044e7ae5eac307e1c7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70017"
      ]
    },
    {
      "uid": "zhcn:2f80807e45b2c3d20c756b68",
      "kind": "character_system_text",
      "source_text": "穿起来感觉也不错。",
      "source_fingerprint": "1ccdf65480fc9ccd72a2ad724a5f966a718f1c02a7661ac451c0cb3903e8eaa8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70018"
      ]
    },
    {
      "uid": "zhcn:6223a2008945e6fe9772552c",
      "kind": "character_system_text",
      "source_text": "换装游戏差不多也该结束了吧。",
      "source_fingerprint": "acf4cb2789d2ef75dd822646023515e6daf31bb15a8dd928e323143e5e223ca8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70019"
      ]
    },
    {
      "uid": "zhcn:c1efa599ee48f32a191fb936",
      "kind": "character_system_text",
      "source_text": "プライベートになにをしようと…\r\nどうでもいいでしょう。",
      "source_fingerprint": "fc76a68718c5392068d93b7ab82752aa24ebf0c6cdf9326c57e53d2220f2cd80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70020"
      ]
    },
    {
      "uid": "zhcn:686f8aea09cb5c9cb7284860",
      "kind": "character_system_text",
      "source_text": "この柔軟剤は、当たりね…。",
      "source_fingerprint": "8d65b9be66f4b2da291428395981ce3d9a2f6b299392b5f658bf5e173babe1af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "70021"
      ]
    },
    {
      "uid": "zhcn:74d60c99c03005c867d6e779",
      "kind": "character_system_text",
      "source_text": "这身衣服，\n是我通过入校考试的证明。",
      "source_fingerprint": "77fee2dcd44a26838b2fea1cbd07224471044ad164851c59f53b52658219a392",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "71004"
      ]
    },
    {
      "uid": "zhcn:0e69a13238d91e1ddb0f8fff",
      "kind": "character_system_text",
      "source_text": "Live的练习的话……\n我觉得现在并不需要……",
      "source_fingerprint": "c44048eb3a286e5eb7197fcbb364a6e889712528e3960ddfac55804c85a60e7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "71008"
      ]
    },
    {
      "uid": "zhcn:539f17d08e589785ed4831b5",
      "kind": "character_system_text",
      "source_text": "在这最顶尖的舞台上，\n一定要取得胜利……！",
      "source_fingerprint": "4b9fbdb838e67ef3768e2887d744ada8f6516a9d10345922a8bacbe3b7296f33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "71009"
      ]
    },
    {
      "uid": "zhcn:6c7e26b457e7255396a0ee8f",
      "kind": "character_system_text",
      "source_text": "……从我母亲那一代开始就没变过呢。\n这身衣服也是、这所学校也是。",
      "source_fingerprint": "a37bb30f0106f5461ee10bda864f8a13e9a8fbbc08b19d7d7126a8d21ef691fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "71010"
      ]
    },
    {
