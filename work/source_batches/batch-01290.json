      ]
    },
    {
      "uid": "zhcn:7269546efd14f7fb0ead9818",
      "kind": "character_system_text",
      "source_text": "别在意，有时候就是会这样！",
      "source_fingerprint": "ad1ed1574beb52ea666bbe364f2771732c13c1cad24cec2c236c3ac0019032dd",
      "source_path": "character_system_text_dict.json",
