      ]
    },
    {
      "uid": "zhcn:a1cd645c2445ed795a98af2a",
      "kind": "character_system_text",
      "source_text": "各位，鼓起干劲上吧！",
      "source_fingerprint": "0ff0a972c846fbff93aa724d573872a0f68b61ff77502319a39b0461a3a87887",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "1008"
      ]
    },
    {
      "uid": "zhcn:7a1d4c3bdadab413288998f3",
      "kind": "character_system_text",
      "source_text": "了～解！",
      "source_fingerprint": "3e54952f7e689d1de159ba3588bfe37b68fde628c3f2ec64b07e2dac5002320d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "1061"
      ]
    },
    {
      "uid": "zhcn:3b648c5f4cc6a8e918390f12",
      "kind": "character_system_text",
      "source_text": "多多关照啰！",
      "source_fingerprint": "943cf3053302bf0a1a828dc112f9a509d117f294c4b692ca68bdc3612c65874a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "1067"
      ]
    },
    {
      "uid": "zhcn:5ae633121bef2eaac970ee15",
      "kind": "character_system_text",
      "source_text": "小赖恩，多多关照啰☆",
      "source_fingerprint": "3cfef681fefb2c63d04c44258054558e13d6f605116f9f40c5bcca5f3e3981b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
