      ]
    },
    {
      "uid": "zhcn:7daa7401a59c956e74011bbf",
      "kind": "character_system_text",
      "source_text": "哇喔，真是厉害！",
      "source_fingerprint": "d8c9719d0330cf9e593b3eb4136c0a772d49a7ea410739dd826ed7cda44d1fb8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
