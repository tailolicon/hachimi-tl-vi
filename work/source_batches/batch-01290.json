      ]
    },
    {
      "uid": "zhcn:1a470c023b0ebc5925c4b73d",
      "kind": "character_system_text",
      "source_text": "太好了！",
      "source_fingerprint": "2deba7ca30c98238317c64bb01282f7578b945b19432461c4536c6681ac4b8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
