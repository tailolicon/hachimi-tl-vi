      ]
    },
    {
      "uid": "zhcn:b9027ab6fe36e72c98c3c53a",
      "kind": "character_system_text",
      "source_text": "夹到好多喔～！",
      "source_fingerprint": "e8d3c2ab9a8e07c7aa820ad2c5409ce2a180699bccd8f91025d742d6e40a3e5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "140003"
      ]
    },
    {
      "uid": "zhcn:c659af83ce6ae54ae74f81c8",
      "kind": "character_system_text",
      "source_text": "哇喔，真是厉害！",
      "source_fingerprint": "d8c9719d0330cf9e593b3eb4136c0a772d49a7ea410739dd826ed7cda44d1fb8",
