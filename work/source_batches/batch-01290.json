      ]
    },
    {
      "uid": "zhcn:53e0685e81fde964a280d9da",
      "kind": "character_system_text",
      "source_text": "哎呀～",
      "source_fingerprint": "f648cc071d9b560d6eaf438e418b83e701f2beac7368232313cd73d3367099ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
