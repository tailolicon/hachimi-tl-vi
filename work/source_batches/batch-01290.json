      ]
    },
    {
      "uid": "zhcn:b67399bd42b4784784fbd56b",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "11"
      ]
    },
    {
      "uid": "zhcn:6aa4917deee9843bc1d5614e",
      "kind": "character_system_text",
      "source_text": "训练？\r\n今天也要畅快地流汗喔！",
      "source_fingerprint": "19732b25c35da948172c13b61a37ce63d9904f541f7ac1f63ccf09b966e29b57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "110000"
      ]
    },
    {
      "uid": "zhcn:227b144c6be3ac9b392cb2f4",
      "kind": "character_system_text",
      "source_text": "入学以后，\r\n和大家一起经历了好多事～\r\n让人感触良多呢。",
      "source_fingerprint": "12ef15cd8aad97665492f01b5f7e9fd8daa86284f0d55fdf79b318568d063708",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "110001"
      ]
    },
    {
      "uid": "zhcn:a1b4e181f8d81f028046dc20",
      "kind": "character_system_text",
      "source_text": "希望报名参赛的人请到这里。\r\n……开玩笑的♪",
      "source_fingerprint": "b41a79c21b9cd4898f446fa24514c1734875de904e99dafe6ee45a02518f3508",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "110002"
      ]
    },
    {
      "uid": "zhcn:f1a06239275ca62a42434f0e",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "12"
      ]
    },
    {
      "uid": "zhcn:01e754feb3189cf7aeebc7b3",
      "kind": "character_system_text",
      "source_text": "我还能跑得更好喔！",
      "source_fingerprint": "fda154c40563fa58c58aa23ed65f042dd8bbfecc14a16aacc098261843fa584b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "120000"
      ]
    },
    {
      "uid": "zhcn:d53467bf62f842808fde0d5a",
      "kind": "character_system_text",
      "source_text": "这是今天的登录奖励♪",
      "source_fingerprint": "97f21c6419a411089b87e74c749bcc1ddf84cefff0257e19bb57280a9c7d4b67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
        "13"
      ]
    },
    {
      "uid": "zhcn:bb8c90d56ebda1e424dc0937",
      "kind": "character_system_text",
      "source_text": "要看仔细喔，加油！",
      "source_fingerprint": "cbd711885cec8bc9ab1dc1f3231ede7adeb8cc99075bd93eb773df02ac1bc2d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1031",
