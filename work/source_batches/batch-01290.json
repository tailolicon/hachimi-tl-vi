      ]
    },
    {
      "uid": "zhcn:aaf9bd8dc8d28ca1ec7754b2",
      "kind": "character_system_text",
      "source_text": "夹到好多喔～！",
      "source_fingerprint": "e8d3c2ab9a8e07c7aa820ad2c5409ce2a180699bccd8f91025d742d6e40a3e5a",
      "source_path": "character_system_text_dict.json",
