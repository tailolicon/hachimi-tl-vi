      ]
    },
    {
      "uid": "zhcn:ad275f42c5c1e90f6213a248",
      "kind": "character_system_text",
      "source_text": "どう？\r\nあたしのバイト先、ついてくる？",
      "source_fingerprint": "7f4fdfde170bcca75d4cde74151ad73f900594e52d61c5340476bdc7cb82db95",
