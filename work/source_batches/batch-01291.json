    },
    {
      "uid": "zhcn:2197340d860d1350cb5d3447",
      "kind": "character_system_text",
      "source_text": "さーて、どこでも付き合うの！",
      "source_fingerprint": "be11b9baded7bbeeadebe3be112f4b2cc2d637de24aead7e017f52af5af2840c",
      "source_path": "character_system_text_dict.json",
