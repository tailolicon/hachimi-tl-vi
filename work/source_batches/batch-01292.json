      ]
    },
    {
      "uid": "zhcn:d181b396595c758d4a8b54b3",
      "kind": "character_system_text",
      "source_text": "状况不错嘛！",
      "source_fingerprint": "cc15474264079dc0cfa141aa7fc51b3116b108464c68651b21fe14c3e990a3ad",
      "source_path": "character_system_text_dict.json",
