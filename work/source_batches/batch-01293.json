    {
      "uid": "zhcn:f0a81b7cb155c6648c51f355",
      "kind": "character_system_text",
      "source_text": "全身都在发热。\r\n…桀桀，仿佛全身的细胞都在命令我奔跑一样。",
      "source_fingerprint": "630e1605bf7e66fc477b8c20b92fdd99d88453c005589c1f279db761f5135a80",
