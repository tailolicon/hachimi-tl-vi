    {
      "uid": "zhcn:11885d0f616d6d6b12d4e63d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "赛马娘名鉴的等级好像是提升了诶！",
      "source_fingerprint": "70ab890bdff8edbeee03c40bf1c80d41f0c3e31a73f172a9e579053bcbcd23aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
