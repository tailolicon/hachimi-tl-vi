  "entries": [
    {
      "uid": "zhcn:7186f3426dafd1ee6d5dc9de",
      "kind": "character_system_text",
      "source_text": "……唔。",
      "source_fingerprint": "996cd512db679cfd8c7583b98310bcfd71ddca0c2cf220557dfae39c75e06410",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140008"
      ]
    },
    {
      "uid": "zhcn:8b10a0e570668cdef3fca22a",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140009"
      ]
    },
    {
      "uid": "zhcn:4b7641d8a6d85e81b25effe3",
      "kind": "character_system_text",
      "source_text": "去吧……唔。",
      "source_fingerprint": "02abd7661a345e525a4e799154916d16d7478618c89a27389ad6ad53bcf7a09d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140010"
      ]
    },
    {
      "uid": "zhcn:a0cf0ff4a2b2992ce92ec475",
      "kind": "character_system_text",
      "source_text": "好厉害…！",
      "source_fingerprint": "a4171fea5297955ee74bf063ebbf4e44837a2de20e3c743747e9fd71a53675a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140011"
      ]
    },
    {
      "uid": "zhcn:af114be4d708f3e861bc0d4a",
      "kind": "character_system_text",
      "source_text": "哇……？！",
      "source_fingerprint": "7b2deb4c95b182205ef306d9441f4ce0a4e5c95ce7c7a1298824b98f3b258807",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140012"
      ]
    },
    {
      "uid": "zhcn:58a5e5c913f7b671cf6382f1",
      "kind": "character_system_text",
      "source_text": "紧紧贴在一起……",
      "source_fingerprint": "02f0e5d92b680c83d84ca0393b12880858a3ac4d75db71784dcbf3bfaaae69f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140013"
      ]
    },
    {
      "uid": "zhcn:28618be691c31c73b29fe3f0",
      "kind": "character_system_text",
      "source_text": "啊…",
      "source_fingerprint": "c69a69d134409083b2571486bf2f11af9edeea86eb1ff3cf2e67f3657d70fa6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b0fc3f9ba867f296c8777f44",
      "kind": "character_system_text",
      "source_text": "呣……",
      "source_fingerprint": "b91b1c2f797f548e0ca8ebe74f69167d156757a0ee334d1fe25b9892930dbda3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140015"
      ]
    },
    {
      "uid": "zhcn:945e762ab91b90726e8ddfe2",
      "kind": "character_system_text",
      "source_text": "要瞄准哪个？",
      "source_fingerprint": "e3b2bedd207c06afa14e26e495b3e2c7b0801041c0d226b08b8c34a44ad51fb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140016"
      ]
    },
    {
      "uid": "zhcn:cdf2e84d6156b0e3a78e706a",
      "kind": "character_system_text",
      "source_text": "啊啊……",
      "source_fingerprint": "67d0eeceded72eace8823cc24b753a0a3007c8ea0e0a4fc8073e9cf559b5eb03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140017"
      ]
    },
    {
      "uid": "zhcn:736cb818b1ee1b708275a6f6",
      "kind": "character_system_text",
      "source_text": "……掉下去了。",
      "source_fingerprint": "e1787de21ff976b42187a189e14a1c9394f07cc5ecee543f82a7b8090f420058",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "140018"
      ]
    },
    {
      "uid": "zhcn:381c5bbd99485faebed71e64",
      "kind": "character_system_text",
      "source_text": "这好像是明天的奖励。",
      "source_fingerprint": "2cc52300dcdbc0c0f9f9f9e4669553534aeef8cb09a7a9b627a960d44d394a4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "15"
      ]
    },
    {
      "uid": "zhcn:3077aac5c0074f7839157137",
      "kind": "character_system_text",
      "source_text": "……我……不累。\n不用休息。没那个时间……！",
      "source_fingerprint": "006b6dd0211512a1b6f1c3fc154cbb4916068d5d89c13fcf51f347dedcc46357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20000"
      ]
    },
    {
      "uid": "zhcn:1a1d243168d59de8822e6e02",
      "kind": "character_system_text",
      "source_text": "……我还能继续训练……！",
      "source_fingerprint": "92a3c6433e288f66537435cf6813b42395318ee76de86a6ad59d7330cc6f5af1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20001"
      ]
    },
    {
      "uid": "zhcn:ac006c6780f593335d319c12",
      "kind": "character_system_text",
      "source_text": "快点下达指示吧。\n不管怎样的训练，现在的我都应对自如。",
      "source_fingerprint": "9d5af54f6c65fd4f67f24739c8ff0f1341e5611d76c6c8cc358587809675cb20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20002"
      ]
    },
    {
      "uid": "zhcn:a53ab42476ff449efc5d6fbd",
      "kind": "character_system_text",
      "source_text": "我昨晚做了个梦……\n是个非常不可思议……但却非常美好的梦。",
      "source_fingerprint": "52d8437306e2e4bc103a749caafd55c2d32a7e9a153979b9e2442d77924e6591",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20003"
      ]
    },
    {
      "uid": "zhcn:e5c3faccd26103829aa06308",
      "kind": "character_system_text",
      "source_text": "你已经考虑好了最适合我的训练计划了吧？\n毕竟你也是训练员啊。",
      "source_fingerprint": "b47e60ed84991b78f0f9e9ceb5294aff1f66a1da7e401af343668b43aa159d52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20004"
      ]
    },
    {
      "uid": "zhcn:eaf6e98ffc4524b861185346",
      "kind": "character_system_text",
      "source_text": "只要跑一跑就知道我现在状态如何了。\n……要现在试试吗？",
      "source_fingerprint": "213399be25860ecc7f8e530cf5f91a9e22d3dbd7507e2317526d11cd5ae1dcf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20005"
      ]
    },
    {
      "uid": "zhcn:dace1b22aaedde2c880ee071",
      "kind": "character_system_text",
      "source_text": "今天要从什么开始练起？\n……练什么我都无所谓。",
      "source_fingerprint": "e678c9c8ed0ac10d74e387bd1519bfc3916e7a72b46cc92990db0ad4e5ab5b94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20006"
      ]
    },
    {
      "uid": "zhcn:48d1ec9225312abdbf199fd4",
      "kind": "character_system_text",
      "source_text": "热身运动已经做好了。\n……毕竟我比你早来了一会。",
      "source_fingerprint": "145963fbd359b8081f050cfd27be0dbfb92235bd244dbcc9878df8598a65a670",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20007"
      ]
    },
    {
      "uid": "zhcn:2c336699b917d244ee556951",
      "kind": "character_system_text",
      "source_text": "……比赛开始之前别和我说话。\n我得集中注意力。",
      "source_fingerprint": "785889fff4febfdcbfe79ce5462bbe9797e7789fe05b434f57879c672b2c89d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20008"
      ]
    },
    {
      "uid": "zhcn:fe86f46d8ec7a9b311d7aa6c",
      "kind": "character_system_text",
      "source_text": "不用那些多余的关心。\n……我的脚还能动，那就还能继续训练。",
      "source_fingerprint": "992301845dffbb40f4e8b64209e3eb4a1c3f02456658761391c17899a8ad1538",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20009"
      ]
    },
    {
      "uid": "zhcn:3927d61070dcc7e7a359a381",
      "kind": "character_system_text",
      "source_text": "……身体状况应该很好的……\n但为什么身体感觉如此沉重……？",
      "source_fingerprint": "12887ae4b0c9ecc210d5592781a0438e91e50a75a09c886b8cf502f157c8d8f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20010"
      ]
    },
    {
      "uid": "zhcn:4c7290f5bfb0a9d2c196a1d1",
      "kind": "character_system_text",
      "source_text": "不行……\n这样根本配不上做她的姐姐……！",
      "source_fingerprint": "e81b21711319d5b7c492dafa0fb6af59ecb78749c61a7fbe871efc8650973d04",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20011"
      ]
    },
    {
      "uid": "zhcn:03b7e9bdff00787f189c6c1f",
      "kind": "character_system_text",
      "source_text": "连续跑比赛的胜算是……\n不。没事。",
      "source_fingerprint": "2db7e6b1e300f3ee7778e67880906f223ec19dd369279113342de7579924088a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20021"
      ]
    },
    {
      "uid": "zhcn:aea26e340967b9c63e484014",
      "kind": "character_system_text",
      "source_text": "……我的脚没事。\n不会在这里就崩……唔……",
      "source_fingerprint": "80a526e43db63cf2371923a741edd8a3599cc81de0e88298692ef29d0303c1ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20022"
      ]
    },
    {
      "uid": "zhcn:a9467025590c767c38794a1f",
      "kind": "character_system_text",
      "source_text": "……我会赢下来的。\n一定要把胜利的荣光献给她……",
      "source_fingerprint": "2192043ac65873da691556064ab7121010d7c9fd5f7fcb0f85018304753328c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20023"
      ]
    },
    {
      "uid": "zhcn:a0c6c5c4bc7a04cf74b18d4b",
      "kind": "character_system_text",
      "source_text": "完成得很棒……\n至少我是这么想的。",
      "source_fingerprint": "d7f3dad0821fe26c41b1805815e57cff8b50040edf4f4c595eb197fc3c81df0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20024"
      ]
    },
    {
      "uid": "zhcn:4bba185437b43aecc199bb45",
      "kind": "character_system_text",
      "source_text": "姐姐会加油的哦……\n一定要为你……！",
      "source_fingerprint": "dd234ecf843d7cb72e1b3571e6373ac881fe9efd77427d927e7feb3cab7e4ae4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20025"
      ]
    },
    {
      "uid": "zhcn:1eacc7df8e2fde13f135ec78",
      "kind": "character_system_text",
      "source_text": "准备已经完成。\n接下来只等开赛了。",
      "source_fingerprint": "feeb2668d8aea6184a46aa755595de9a825794c0f09d436e7a1a9a4cf71797f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d840b4af0aeda3296f315add",
      "kind": "character_system_text",
      "source_text": "开闸的瞬间……\n嗯。\n该做的事情都好好地记在脑子里了。",
      "source_fingerprint": "8adfd7645adbb2923b406c884272af7776d71fd87ba5090c2c7c21afcd03f063",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20027"
      ]
    },
    {
      "uid": "zhcn:f6690622c374aeae81d6f62e",
      "kind": "character_system_text",
      "source_text": "我的目标……只有第一名。\n除此以外的结果我都无法接受。",
      "source_fingerprint": "88bca3ba3a28a3ac6aee0b630fc57b07566905b0ad5626478dc031ef55551ca9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20028"
      ]
    },
    {
      "uid": "zhcn:9c1c23d66438b7e5ec3fc7b8",
      "kind": "character_system_text",
      "source_text": "只要像训练时那样奔跑，\n应该就能得到不错的结果……",
      "source_fingerprint": "af4458051eee1b7b8791c8530cadfcd98c0c8ce4886dd3dce849d51ef68fd25f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20029"
      ]
    },
    {
      "uid": "zhcn:c4cb86ca578b0d73341ca378",
      "kind": "character_system_text",
      "source_text": "状态不好不坏。\n不过，比赛前就是这种状态比较好吧？",
      "source_fingerprint": "8aef081faa343653dba66820cc628c6771dcc63554d7f6f7c6a17d538297bf6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20030"
      ]
    },
    {
      "uid": "zhcn:df9a5aa25eec6708ebe8c2da",
      "kind": "character_system_text",
      "source_text": "……差不多就该去赛前体检了吧？",
      "source_fingerprint": "7ac850cc5729664890a7a755a608c2ea049f6e789f2ad9ab70e2bbde52ae1bb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20031"
      ]
    },
    {
      "uid": "zhcn:04d350bf560974a98197c259",
      "kind": "character_system_text",
      "source_text": "如果以这种状态出赛的话……\n不……一定有胜算的……！",
      "source_fingerprint": "392e2fca62e595741ffa3b2f9c25091c16bc84026ce263f39ea17f8cb41196a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20032"
      ]
    },
    {
      "uid": "zhcn:2247ef9c823d2446cd7adb59",
      "kind": "character_system_text",
      "source_text": "好像比赛的日子已经到了呢。",
      "source_fingerprint": "e7f7269f3a132aada90beb9f53582e78bb8c7f1fb97e44c438628e3e0cb944cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20033"
      ]
    },
    {
      "uid": "zhcn:19469568e071567bb8f09e51",
      "kind": "character_system_text",
      "source_text": "呼……哈……呼\n得好好调整呼吸才行……\n事到如今还会紧张什么的……",
      "source_fingerprint": "df21914545d777c3a4160c74161f84225a5d5b24652f5404701f606ff54975e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20034"
      ]
    },
    {
      "uid": "zhcn:87900e8ef13dba06be436b16",
      "kind": "character_system_text",
      "source_text": "……我只是在集中精力。\n不用过于担心了。",
      "source_fingerprint": "a0c735ceb27780034d201b796d0a92462f41bfa13042024c468ae504ae27371b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20035"
      ]
    },
    {
      "uid": "zhcn:49bef25f6cdf6ded61422bad",
      "kind": "character_system_text",
      "source_text": "……必须要赢……\n我……不得不赢……！",
      "source_fingerprint": "addb5e284ae76ad76e5ec41669f1d1634902e1c326e35c338b99ed886cc1c522",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20036"
      ]
    },
    {
      "uid": "zhcn:d46f9f2014fcafd71b07b24c",
      "kind": "character_system_text",
      "source_text": "……不想认输……唔……！",
      "source_fingerprint": "759d18e5637fac0a7d2079b03b4e8db5b3393219ffff2ce0332c08376b5b1085",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20037"
      ]
    },
    {
      "uid": "zhcn:2b66e7a5b265904ef19e1a98",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2a7deb3e686bdce36f17de42",
      "kind": "character_system_text",
      "source_text": "我知道了。",
      "source_fingerprint": "e4751dd24b1cc01c018d0bfc5e41666107f225b47c76b137af696c4a8217995a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20039"
      ]
    },
    {
      "uid": "zhcn:1012d3e27bc6031292401c91",
      "kind": "character_system_text",
      "source_text": "……好。",
      "source_fingerprint": "8e83aa0ebedbafc894362e5d9b45b0cb4ab939fe816a08aef341ea714cebcabe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20040"
      ]
    },
    {
      "uid": "zhcn:ad77ba8e55122bbac7dfabdd",
      "kind": "character_system_text",
      "source_text": "资料呢？",
      "source_fingerprint": "9824a800a2a3baf9e89a3181aa9aa937d3db6551dfd8ef10c55012ef304d008a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20041"
      ]
    },
    {
      "uid": "zhcn:c031fa4ff75fa9ca64228fab",
      "kind": "character_system_text",
      "source_text": "身体……！",
      "source_fingerprint": "a0dd6de931186f4acd50fe35047b6348758714bd908669228c1e8421a8786a32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20042"
      ]
    },
    {
      "uid": "zhcn:4e41f3b197227960113939c8",
      "kind": "character_system_text",
      "source_text": "嗯嗯……",
      "source_fingerprint": "26ff4925698843c3792c7f0bc377e245a84f32db565113d4ccaa189fe812f9dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20043"
      ]
    },
    {
      "uid": "zhcn:38907926a35c53e17678cc74",
      "kind": "character_system_text",
      "source_text": "……了解，",
      "source_fingerprint": "80fdb44e8129e1843f11bb6902ca512014f3b3d53d8baa1a768bcaf2b7efce88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f2a76f19c3d64a06e8672d92",
      "kind": "character_system_text",
      "source_text": "是海呢……",
      "source_fingerprint": "f0d0a81190bd66156fd68800a44ab240715e92bc534675bdbb8770fc43bd6cd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0008f2b6481f5876873399b3",
      "kind": "character_system_text",
      "source_text": "……谢谢你的陪伴。",
      "source_fingerprint": "a0320111a9d29ae352083d23d6587b4871beef9693430e9992bcd7b7147dd0d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20049"
      ]
    },
    {
      "uid": "zhcn:36690bce0b0a8ab4b56d39a2",
      "kind": "character_system_text",
      "source_text": "……看来结束了呢。",
      "source_fingerprint": "4d9e793f70548767d672b9584fd95a76d97537035ead0355fbd90614bcae1a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20050"
      ]
    },
    {
      "uid": "zhcn:cdbfcd855abe7d2229afc1bc",
      "kind": "character_system_text",
      "source_text": "可以帮我吗？",
      "source_fingerprint": "357492d9d5e843ca47cf63a36cdf6e44180a917be3cc6baee1e00a90b3ed6179",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "20051"
      ]
    },
    {
      "uid": "zhcn:16aa261c69aa209d209fba80",
      "kind": "character_system_text",
      "source_text": "……到我出场了呢。",
      "source_fingerprint": "aaaa46034bee807d6805f99aa9201d489fe785311edd88bd622751b2d670f11c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2030"
      ]
    },
    {
      "uid": "zhcn:1edaae1ec7e83bd84c23507b",
      "kind": "character_system_text",
      "source_text": "上吧。",
      "source_fingerprint": "2eb0d881cd80a16baae5d41c1d7268ab2194b50e1175597b0547df0c45d47e02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2031"
      ]
    },
    {
      "uid": "zhcn:5d13aeb3f57a7a50e58c0dca",
      "kind": "character_system_text",
      "source_text": "……看来结束了呢。",
      "source_fingerprint": "4d9e793f70548767d672b9584fd95a76d97537035ead0355fbd90614bcae1a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2032"
      ]
    },
    {
      "uid": "zhcn:2918d25e2333333650a7aa37",
      "kind": "character_system_text",
      "source_text": "我的目标……只有第一名。\n除此以外的结果我都无法接受。",
      "source_fingerprint": "88bca3ba3a28a3ac6aee0b630fc57b07566905b0ad5626478dc031ef55551ca9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2033"
      ]
    },
    {
      "uid": "zhcn:2aeb8259167f43de4c5f6e36",
      "kind": "character_system_text",
      "source_text": "姐姐会加油的哦……\n一定要为你献上……！",
      "source_fingerprint": "c13f3afaef642b8c9544da332e7095cad1f9b26b9fcba7b219d89bb6940f3a3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2034"
      ]
    },
    {
      "uid": "zhcn:04cd82c9615f5691810eb077",
      "kind": "character_system_text",
      "source_text": "……看来结束了呢。",
      "source_fingerprint": "4d9e793f70548767d672b9584fd95a76d97537035ead0355fbd90614bcae1a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "2035"
      ]
    },
    {
      "uid": "zhcn:bba1293bb786e58f11c57602",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "23015"
      ]
    },
    {
      "uid": "zhcn:5918885246693a49c0568e3f",
      "kind": "character_system_text",
      "source_text": "看来这样行得通。那么下次的话……！",
      "source_fingerprint": "cd236fa3f4b169c9050711032b456714d5e12daee8538873ab6f939234ca90f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30000"
      ]
    },
    {
      "uid": "zhcn:daca4456ca04d6f804f8c538",
      "kind": "character_system_text",
      "source_text": "这次……绝不退让。",
      "source_fingerprint": "be43126ad50d6fe72c639095aa4407e3bb932a054bbaa03eb6ac9798d57f85d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30001"
      ]
    },
    {
      "uid": "zhcn:1722c107092f91b335d510e8",
      "kind": "character_system_text",
      "source_text": "更高的地方……！",
      "source_fingerprint": "969d51ef09513dd4ef1e8eabf1415c7fcfc0e6279e846d485750008b9500bd3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30002"
      ]
    },
    {
      "uid": "zhcn:bc21c31529e155395eb3d3e3",
      "kind": "character_system_text",
      "source_text": "怎么会这样……\n这样下去的话……！",
      "source_fingerprint": "a88149b1927ebc751717a7e51fc933f16f650000a8f93dfe2793f774cb87ca5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1483736d634ee70036320cfb",
      "kind": "character_system_text",
      "source_text": "一等星的光辉……就在此处。",
      "source_fingerprint": "1f863317a082b48625ff339f07a8c7276046bb114404737141854600c25bf70a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30004"
      ]
    },
    {
      "uid": "zhcn:9d0b8c0df14476bce7382efa",
      "kind": "character_system_text",
      "source_text": "向着比浮云、比天空更为遥远的你——\n献上这份胜利。",
      "source_fingerprint": "2ca4a989c80d5d08a8f120b189a8fa2ed7b10294805c991ec92435a28f5ea401",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30005"
      ]
    },
    {
      "uid": "zhcn:df66b734c7bc7b9a999dc3ac",
      "kind": "character_system_text",
      "source_text": "真的，已经习惯了吗。\n在这圣夜的星空下……",
      "source_fingerprint": "881641c1e8ee9629e92ba9ac6c37f58ff987f62c50a139ae6a435c5f729f48a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30006"
      ]
    },
    {
      "uid": "zhcn:1a91e88c3c287080e180797e",
      "kind": "character_system_text",
      "source_text": "向着比浮云、比天空更为遥远的你——\n献上这份胜利。",
      "source_fingerprint": "2ca4a989c80d5d08a8f120b189a8fa2ed7b10294805c991ec92435a28f5ea401",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "30007"
      ]
    },
    {
      "uid": "zhcn:fd3eeaf222546e2605c20af4",
      "kind": "character_system_text",
      "source_text": "……我会赢下来的。",
      "source_fingerprint": "fa1a465ce81ad92da3d37bfb05290b85264ab48bd466284232a399a88143df7b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "31000"
      ]
    },
    {
      "uid": "zhcn:9a2ba4ab71fa1c99898dd397",
      "kind": "character_system_text",
      "source_text": "一瞬间就能决出胜负。",
      "source_fingerprint": "7908d435d1d6cdeab8d8d23cb2b690bd4c77da26a86330e2e7dae7162635cf5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40000"
      ]
    },
    {
      "uid": "zhcn:92ee3ecf686169de76670486",
      "kind": "character_system_text",
      "source_text": "…最近，机伶总是在聊\n她推荐的店。  \n那到底是怎么回事啊，那个……",
      "source_fingerprint": "5deebd8393a794283e9f73670556a0aba9adb690c990cd1b8f0607f1ea71e52b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400001"
      ]
    },
    {
      "uid": "zhcn:9dd64c7973ade02c1a684ea4",
      "kind": "character_system_text",
      "source_text": "怒涛……有时候，有点努力过头了。",
      "source_fingerprint": "ce2ae30f3b0783e5d1005d579d8b7367761582c23596c26358a14c5593c742b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400003"
      ]
    },
    {
      "uid": "zhcn:a116bdf833a1b2dd77494e89",
      "kind": "character_system_text",
      "source_text": "最近成田路同学一有空\r\n好像就会去听歌剧。\r\n她到底有多认真啊…",
      "source_fingerprint": "0709446d09168ef90e693cf98246d98689bd8fa158cee798f2d95399158e3b2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400004"
      ]
    },
    {
      "uid": "zhcn:b9ea60f7d7000d6341c9a376",
      "kind": "character_system_text",
      "source_text": "一不留神就来了…\r\n怒涛她们没问题吧…",
      "source_fingerprint": "9d028d131294b7ea762fcfc7e815c0aaac84e67a91edcd3bfaab7cf11e5e2bb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400007"
      ]
    },
    {
      "uid": "zhcn:59a0688ffa51d16b2cdee2ef",
      "kind": "character_system_text",
      "source_text": "流星群。我所想要实现的愿望只有一个——\n将我的奔跑，化为祈祷吧……！",
      "source_fingerprint": "d37106144a9cb329c9a32da0f79cc72e6b75f0a8ade59f10299dcfed81599bca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40001"
      ]
    },
    {
      "uid": "zhcn:f9fd1d977b64ab334a92cb08",
      "kind": "character_system_text",
      "source_text": "我真希望\n不要再被卷进去了……  \n不过，这次。也不坏吧。",
      "source_fingerprint": "68bca04d4ed632d713b17454a2042b7c7877363d3b443841b36a378d7e96770d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400010"
      ]
    },
    {
      "uid": "zhcn:cc7c7a422ec2ef94ed82004d",
      "kind": "character_system_text",
      "source_text": "在雪融化之后，的前方……！",
      "source_fingerprint": "1b4f7aadcb16a2621189db01c0a475057e7f875d63692d4bed87d55bd23002ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40003"
      ]
    },
    {
      "uid": "zhcn:9c5654f2bcd2e9359ee7f548",
      "kind": "character_system_text",
      "source_text": "来吧，我们出发吧。\n漫长的黑夜过去，终于迎来了期待已久的……朝霞。\n……冰冷，又温暖。",
      "source_fingerprint": "09bcd5e35cfa7c5f661e45b92f4241da9726859de67bfd935b7455dbcc00d8f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "40004"
      ]
    },
    {
      "uid": "zhcn:93433daba95745c47b55b05a",
      "kind": "character_system_text",
      "source_text": "我居然会去主题公园什么的……  \n虽然是一时起意，但还真让人吃惊呢。  \n……不过，都是平时那几个人啦。",
      "source_fingerprint": "2d0884386a6e7ae16e8d19a74a6ff358031a36e59469bc63ceeda3bff606bbeb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "400090"
      ]
    },
    {
      "uid": "zhcn:37f4d06d1ec3a078a20819b1",
      "kind": "character_system_text",
      "source_text": "即便只是站在舞台边上，\n也能听见欢呼声呢。",
      "source_fingerprint": "9771551be411c032acd09c1147a7ab50b266ff846a1f0e6e67125600246998eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "60000"
      ]
    },
    {
      "uid": "zhcn:0f822a7ac3420ace2f540a60",
      "kind": "character_system_text",
      "source_text": "……歌曲也是献给她的礼物的一部分。",
      "source_fingerprint": "ffda2bcccab93a0394cf45b60a507622ebb280a0b3c728751033372d6278fda2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1033",
        "60001"
      ]
    }
  ]
}
