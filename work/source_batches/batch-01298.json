      "kind": "character_system_text",
      "source_text": "在这最顶尖的舞台上，\n一定要取得胜利……！",
      "source_fingerprint": "4b9fbdb838e67ef3768e2887d744ada8f6516a9d10345922a8bacbe3b7296f33",
      "source_path": "character_system_text_dict.json",
