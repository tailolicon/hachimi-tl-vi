{
  "schema_version": 1,
  "batch": 1300,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:79d38d0bf8e17557f7c70ad4",
      "kind": "character_system_text",
      "source_text": "大丰收呢！",
      "source_fingerprint": "3f918eaccc1f231c80485124a7ff9f066098bec90c125aedabb02a39cdef0a60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140006"
      ]
    },
    {
      "uid": "zhcn:2d19e29402654c5e293a2f97",
      "kind": "character_system_text",
      "source_text": "状况不错嘛！",
      "source_fingerprint": "cc15474264079dc0cfa141aa7fc51b3116b108464c68651b21fe14c3e990a3ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140007"
      ]
    },
    {
      "uid": "zhcn:fefc5851c93fc8e9277ccfb7",
      "kind": "character_system_text",
      "source_text": "喔～！",
      "source_fingerprint": "9f69be3847865e4d038b171472208c6c5bea0a6f713ba6400504b5dca582094a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140008"
      ]
    },
    {
      "uid": "zhcn:e5c4e2d0b77e911f30b39be6",
      "kind": "character_system_text",
      "source_text": "真是的！",
      "source_fingerprint": "339b4994041b8d66e6603c6b2af7794afd339928fe9d28b08b3235a52c27e5cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140009"
      ]
    },
    {
      "uid": "zhcn:03407ae765d44f8fc00c5985",
      "kind": "character_system_text",
      "source_text": "就是现在！",
      "source_fingerprint": "548033c5171d46e862bd552bea4f045c77f90f8affc088ccf38befb60523d999",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140010"
      ]
    },
    {
      "uid": "zhcn:f6e1ecd67c931e47308cdeae",
      "kind": "character_system_text",
      "source_text": "真豪迈呢！",
      "source_fingerprint": "0ecbe256fb47bef0942cb3fdf50587076d370038aaccf6f10c5771215a266344",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140011"
      ]
    },
    {
      "uid": "zhcn:9a06c2c347bf9467563d19c1",
      "kind": "character_system_text",
      "source_text": "真了不起！",
      "source_fingerprint": "3d7202f6db1322475dc6863ed540625bdd7bcdf5da4a6a9610cfe4f43dfaafcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140012"
      ]
    },
    {
      "uid": "zhcn:3c3a637dc5253cc7322bc3c5",
      "kind": "character_system_text",
      "source_text": "开始热血起来了！",
      "source_fingerprint": "68df76fa3c122786c795d31505f9822dec009c7322a02fdbc6e0e75965a3deeb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140013"
      ]
    },
    {
      "uid": "zhcn:214c8bdb3b41eefa1e9e6c36",
      "kind": "character_system_text",
      "source_text": "呃啊～！",
      "source_fingerprint": "16b48627160c8bfff3aaa953a94f35fe03f5a07e58d2e607f187a8fc36cda43e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140014"
      ]
    },
    {
      "uid": "zhcn:c7595dd1cc5883904b86a845",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140015"
      ]
    },
    {
      "uid": "zhcn:5a6f9ff2e23a06c60a18d527",
      "kind": "character_system_text",
      "source_text": "喔，怎么了？",
      "source_fingerprint": "29e47c98efaaa50b9b1e2cd73885aa400e35de9f5dd868a45ce2744344cd3867",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140016"
      ]
    },
    {
      "uid": "zhcn:de0e72dff5f6949c494f81a2",
      "kind": "character_system_text",
      "source_text": "哎呀～！",
      "source_fingerprint": "f5a130af1ae2f6c82946ec45e23fccdc80b2717aefb552f1129338be26f08bec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140017"
      ]
    },
    {
      "uid": "zhcn:5a812a01426f36aec2a53227",
      "kind": "character_system_text",
      "source_text": "真可惜～！",
      "source_fingerprint": "5bce8a4b7b467cdd958c8cd4cbfff55203f12e21319e03f8a7b77f4dadaa41d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "140018"
      ]
    },
    {
      "uid": "zhcn:fadddaf599426143676125c8",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个！",
      "source_fingerprint": "e2890caa778c130e4650a911e27f1a3eae08de21e4bb7a627a1a4d0dd4d659e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "15"
      ]
    },
    {
      "uid": "zhcn:4c1ead7a58b70cbaa3e10098",
      "kind": "character_system_text",
      "source_text": "啊～可恶！\r\n怎么做都使不出力气……！",
      "source_fingerprint": "8fe6ebf9c7cc63dd4274c18b8342d271980da25c51d9e062d07f587bfb0045b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20000"
      ]
    },
    {
      "uid": "zhcn:0f89bc9b0a17f234e3848397",
      "kind": "character_system_text",
      "source_text": "真是太丢脸了，\r\n看来状况有点不太好……",
      "source_fingerprint": "4027acd91efe3e873de9b81876531bddad4deaf40c5b2f582266f060ea175fbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20001"
      ]
    },
    {
      "uid": "zhcn:de675e140c9f773162dd5896",
      "kind": "character_system_text",
      "source_text": "大将，今天推荐做什么？\r\n不管什么训练，\r\n我都会全部吞下肚的！",
      "source_fingerprint": "674a3f8ea1213f31f3a5d14b00abf78bee0b2b619baff47aea6857b35224db1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20002"
      ]
    },
    {
      "uid": "zhcn:2ee2d8f167ed76b392b8cc69",
      "kind": "character_system_text",
      "source_text": "私下努力，在重大时刻\r\n潇洒地成功！这也是江户之子\r\n该有的心态！",
      "source_fingerprint": "6a48d291d2be5cffab6a209f1e8fe6b50a9dae1ffca4b32ad510a5555d0ca7b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20003"
      ]
    },
    {
      "uid": "zhcn:0698cbb9e07d4d19d181d729",
      "kind": "character_system_text",
      "source_text": "太阳公公已经等我们很久了！\r\n今天也来开始吧！",
      "source_fingerprint": "49c0ba6d34bbaa5ed2726f852222a9f15aae00d3dea751e0a010749dd9e98ad9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20004"
      ]
    },
    {
      "uid": "zhcn:06f836511d1a8f5b9dba125c",
      "kind": "character_system_text",
      "source_text": "我已经等了很～久，\r\n脑袋都快变得一片混乱了。\r\n快点开始吧！",
      "source_fingerprint": "898480d64e9c6dbc3e9d36021aa16ea8a0a4cf349ffda4f4dcc459d46687df67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20005"
      ]
    },
    {
      "uid": "zhcn:5f78e3e8cf82ffee23a623c7",
      "kind": "character_system_text",
      "source_text": "一、二、三、四！\r\n训练员，\r\n今天也要麻烦你啦。",
      "source_fingerprint": "5ec557614b6fece76d2d7fb1c35ab59b08a2db7de67124024baaa903ec594db7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20006"
      ]
    },
    {
      "uid": "zhcn:476dc48659d426cdcba9be5d",
      "kind": "character_system_text",
      "source_text": "好了，开始吧！\r\n话先说在前头，\r\n我可不需要没劲的训练喔！",
      "source_fingerprint": "9ddb2bf7a45b15b061e85b7fe30b009705fc6cedc2335e23d01c68ae9b425291",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20007"
      ]
    },
    {
      "uid": "zhcn:fe3bc4642d7fe61e7d3d21b1",
      "kind": "character_system_text",
      "source_text": "为什么振作不起来……\r\n这样一点都不符合\r\n稻荷大人的作风。",
      "source_fingerprint": "40899d3c82331936771929fb4c26c8612a3865557a1b4e94cd592fa1149f01ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20008"
      ]
    },
    {
      "uid": "zhcn:1cc69df00fc3febf9e75bcf9",
      "kind": "character_system_text",
      "source_text": "搞什么！不管怎么做都无法\r\n鼓起干劲……我实在太没用了。",
      "source_fingerprint": "46e4ab1c6d16fe76f241f4b49542c175a154c2f1a1850dab60c8494bceb4bf4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20009"
      ]
    },
    {
      "uid": "zhcn:268a3b9f8d9b8647d42919d5",
      "kind": "character_system_text",
      "source_text": "我怎么会这么没劲……\r\n我去洗把脸再回来……",
      "source_fingerprint": "9c35210f34b9b21efdb41e40047d9f42aa88ae1133f8e110d8ac68070beb73b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20010"
      ]
    },
    {
      "uid": "zhcn:d6574da56bcfd5eba86366ee",
      "kind": "character_system_text",
      "source_text": "抱歉，感觉今天\r\n实在无法响应你的期待……",
      "source_fingerprint": "66e36150be1a302a32f75e0562bc7ce512fefa69a003e7f2577b9c003093a41d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20011"
      ]
    },
    {
      "uid": "zhcn:c69d7ea8ecbcff7b93e08675",
      "kind": "character_system_text",
      "source_text": "为什么为什么，\r\n为什么又要参赛？\r\n是不是有点太心急了……？",
      "source_fingerprint": "a4e29bfd77c0313233d98f42d1a8981c16b797ef83794c7851d340be2f46a115",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20021"
      ]
    },
    {
      "uid": "zhcn:c64c67d07c4a3f9b4291f9e7",
      "kind": "character_system_text",
      "source_text": "啊～等一下、等一下！\r\n最近光比赛就饱了！\r\n让我稍微喘口气！",
      "source_fingerprint": "337bc1abf8721ad8cd2923a16cf0631eeb494bb8c500baa01746e520e4ab5dd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20022"
      ]
    },
    {
      "uid": "zhcn:909ef52eaac0f63c7f67b6d1",
      "kind": "character_system_text",
      "source_text": "训练员，托你的福，\r\n我现在状态绝佳！\r\n这就是所谓的专业吧！",
      "source_fingerprint": "31e7b765632f8b71d25fa6970ee0813272dc3da07bd95cb14d32102f71bbddc1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20023"
      ]
    },
    {
      "uid": "zhcn:3586ad9a849ca3915d0ccbad",
      "kind": "character_system_text",
      "source_text": "嘿咻、嘿咻！\r\n我现在的心情，\r\n就像抬神轿时一样亢奋！",
      "source_fingerprint": "2e29b1b75252679912d7cb8277b651defc6daedc8b4885673a9601ef89acaf96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20024"
      ]
    },
    {
      "uid": "zhcn:064b07052cae2ee54aa8dedc",
      "kind": "character_system_text",
      "source_text": "你尽管放心，\r\n把一切都交给我吧！",
      "source_fingerprint": "7595e813b3c5aaf09341cd443114fb4a82500c8b4ee867c3ce2d020c68e437cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20025"
      ]
    },
    {
      "uid": "zhcn:c39f4bdf6fe17e39d79d80e3",
      "kind": "character_system_text",
      "source_text": "用江户之子的方式，\r\n痛快地拿下胜利，\r\n让大家见识一下吧！",
      "source_fingerprint": "2a7dd11981da040401107da35ee1bfeae336b14e0407138cc7a4f254ce76d987",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20026"
      ]
    },
    {
      "uid": "zhcn:4e9dd9c776ce2e97de5a5bdc",
      "kind": "character_system_text",
      "source_text": "这一天终于到了！\r\n嘿嘿嘿，没来看稻荷大人表现的人，\r\n真的是亏大了！",
      "source_fingerprint": "6fd6188cdba06f668470c3b3dc599f3c014533f55ccf13dc2935a2146017d271",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20027"
      ]
    },
    {
      "uid": "zhcn:bf46ea8d3fb6e63e491efed3",
      "kind": "character_system_text",
      "source_text": "热闹的祭典要开始了！\r\n主角当然是……我本人！",
      "source_fingerprint": "956e3385d7477cb58847315500b518f406045221d0dc579dc4bc9c7cd850c32b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20028"
      ]
    },
    {
      "uid": "zhcn:c97eebcabf99719411e3ac19",
      "kind": "character_system_text",
      "source_text": "今天也聚集了许多\r\n看起来跑很快的家伙。\r\n……真是太令人开心了！",
      "source_fingerprint": "593a011f386202b93e21b6176c55820997c1e30a781ffe29d5ade3d94f6f22e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20029"
      ]
    },
    {
      "uid": "zhcn:7a221bc9d877569bdbcedc25",
      "kind": "character_system_text",
      "source_text": "好～那我就去跑一下啦！\r\n嘿嘿嘿，不用慌张，\r\n相信我吧！",
      "source_fingerprint": "1da1aa87dffbdb03110cbc5f7ba4dd63e967cfcc8a0c9387f41d3f8cdea01918",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20030"
      ]
    },
    {
      "uid": "zhcn:e940e4d7db4c5ff55aa2454c",
      "kind": "character_system_text",
      "source_text": "哈啾！怎么回事，\r\n难道是观众们在讨论我的\r\n传闻吗？嘿嘿嘿。",
      "source_fingerprint": "6f2af444acb78685f5f0ec5caf7b09f6b3abcd25f968f7187d6f741cda3a823c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20031"
      ]
    },
    {
      "uid": "zhcn:1d490f8ac168e170696bd8cc",
      "kind": "character_system_text",
      "source_text": "总觉得无法绷紧神经。\r\n这样不行……\r\n明明接下来要登上大舞台。",
      "source_fingerprint": "489a72ff866d970215fa2a8ef49fc1883aa258185b25813c847cc89576925870",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20032"
      ]
    },
    {
      "uid": "zhcn:579974d2699c3deca3f9496c",
      "kind": "character_system_text",
      "source_text": "可恶！我的卖点明明是\r\n豪迈的气势，为什么会\r\n这么提不起劲……！",
      "source_fingerprint": "ec968ce16e510baac1847abbc5dce17d27bb2458b881834ec213e0f55099434d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20033"
      ]
    },
    {
      "uid": "zhcn:8050eb2d67aa2de0eda4e183",
      "kind": "character_system_text",
      "source_text": "我去洗把脸。\r\n至少要重新鼓起干劲。",
      "source_fingerprint": "e31467a8159d2349e20161e989aef40687a3684b8c0f709985e18b9205e82ab6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20034"
      ]
    },
    {
      "uid": "zhcn:e96712d1d7ce14c71b8ea306",
      "kind": "character_system_text",
      "source_text": "如果只跟平常一样就太无趣了……\r\n再怎么说，至少要展现出气魄！",
      "source_fingerprint": "a5dfec4f5387cdb3aef0032f3b90301a67cf9f769b9cd64687e36eabdc03d1d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20035"
      ]
    },
    {
      "uid": "zhcn:9d38c4588d0535c2bc5e8668",
      "kind": "character_system_text",
      "source_text": "总觉得状态不太好，\r\n但这样才更要享受比赛，\r\n不然有损江户之子的名声！",
      "source_fingerprint": "4d0bb5eba8daf467752f4193588b39fcb43923377c8e5eebeb635c8b951f7cb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20036"
      ]
    },
    {
      "uid": "zhcn:bde035dc05bfe7ca30d398cd",
      "kind": "character_system_text",
      "source_text": "即使提不起劲，\r\n江户之子依然不会跑也不会躲，\r\n只会与人正面对决！",
      "source_fingerprint": "1fc0ad55094e02884b683441f5b4ca35e5f1ae08490e1861d1e978c7374553d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20037"
      ]
    },
    {
      "uid": "zhcn:a9cc3a62188b2f3a95351bca",
      "kind": "character_system_text",
      "source_text": "来了！",
      "source_fingerprint": "156457bc54ba27ebeaab1aba3aaf9a68ceea61cd9f05dfb3deffdb2be3ad073e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20038"
      ]
    },
    {
      "uid": "zhcn:af5ece133840fbe781644ef3",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
