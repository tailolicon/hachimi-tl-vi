      ]
    },
    {
      "uid": "zhcn:e5c57797d2344ba07f91fd3f",
      "kind": "character_system_text",
      "source_text": "开始啰！",
      "source_fingerprint": "70f043c92a73ea01d9a6c9583b05ffc9795fcce7ae0ffdb2a100e73fc8ad95f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20040"
      ]
    },
    {
      "uid": "zhcn:0419b1b8814ce0705ca101c1",
      "kind": "character_system_text",
      "source_text": "知道了！",
      "source_fingerprint": "9afeecaf9d8d2dc191e807f43cf94ef42f53160a8fbd7b6874467cebcd375a68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20041"
      ]
    },
    {
      "uid": "zhcn:cd18c39a6d1b26531a8b1874",
      "kind": "character_system_text",
      "source_text": "不妙！？",
      "source_fingerprint": "c84f5d36abaa358a8ba8a147c99c6e9350100bffc189a6160e7be9d798437491",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20042"
      ]
    },
    {
      "uid": "zhcn:a37450adfb2623ff4dbcb24c",
      "kind": "character_system_text",
      "source_text": "搞什么？",
      "source_fingerprint": "f5ba6ea93f75d25a1f08c590b48e926c6937a72ff722b5ae0d06c620e29a66f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20043"
      ]
    },
    {
      "uid": "zhcn:32861292f18f27b1d03f90e1",
      "kind": "character_system_text",
      "source_text": "要出动啦！",
      "source_fingerprint": "73b93d8757810d5114a0ab5597ea3c5582b22c0999d8be09ad6e68695cd3dacd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20046"
      ]
    },
    {
      "uid": "zhcn:60ca2535f227f3f729b1ea06",
      "kind": "character_system_text",
      "source_text": "呀喝──！",
      "source_fingerprint": "914260824057965c08d7f825ac301cd49d40bacf747b5e195a039d2f5da40974",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20047"
      ]
    },
    {
      "uid": "zhcn:6d30bf187d0c65ddda76f01b",
      "kind": "character_system_text",
      "source_text": "说出来就不潇洒了……不过谢谢你！",
      "source_fingerprint": "5f92fb1d4672b87ab3bd77948f6ccfa911962b66789f364f28af9ac3343beb7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20049"
      ]
    },
    {
      "uid": "zhcn:4fcd8296ab51c47677492447",
      "kind": "character_system_text",
      "source_text": "很庆幸我的搭档是你！",
      "source_fingerprint": "8c86d920b17c9923247bbca73e7859f15527f7b35e0c16199ac68aa035a19915",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20050"
      ]
    },
    {
      "uid": "zhcn:98552e16c0665881c41c86f6",
      "kind": "character_system_text",
      "source_text": "来跑一趟吧！",
      "source_fingerprint": "6001a9f46904bac5848e21751e5dfc850ef3bb580dbf096deffb63ef47874d02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "20051"
      ]
    },
    {
      "uid": "zhcn:6fd9526e5d3ec744531e680b",
      "kind": "character_system_text",
      "source_text": "我上场了！",
      "source_fingerprint": "092de8b679dc1d62be9d0345f00b41ce5d39669391cc434ea8f1c32929be88df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "2030"
      ]
    },
    {
      "uid": "zhcn:6769f12ed9b8376b91737c3a",
      "kind": "character_system_text",
      "source_text": "各位，要上啰！",
      "source_fingerprint": "b123d718a3a2e29402c75bbaa91ea7a4d9cd9e8c9a1e1148f7bd9d637bcf53b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "2031"
      ]
    },
    {
      "uid": "zhcn:0dd00ecdae3cf2ab187fae08",
      "kind": "character_system_text",
      "source_text": "很庆幸我的搭档是你！",
      "source_fingerprint": "8c86d920b17c9923247bbca73e7859f15527f7b35e0c16199ac68aa035a19915",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "2032"
      ]
    },
    {
      "uid": "zhcn:277834fede4303aed8ea5dd0",
      "kind": "character_system_text",
      "source_text": "热闹的祭典要开始了！\r\n主角当然是……我本人！",
      "source_fingerprint": "956e3385d7477cb58847315500b518f406045221d0dc579dc4bc9c7cd850c32b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "2033"
      ]
    },
    {
      "uid": "zhcn:0a2cbc377edeba08c6b6fca5",
      "kind": "character_system_text",
      "source_text": "你尽管放心，\r\n把一切都交给我吧！",
      "source_fingerprint": "7595e813b3c5aaf09341cd443114fb4a82500c8b4ee867c3ce2d020c68e437cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "2034"
      ]
    },
    {
      "uid": "zhcn:0b14a7eadf9812e9fea8d07a",
      "kind": "character_system_text",
      "source_text": "很庆幸我的搭档是你！",
      "source_fingerprint": "8c86d920b17c9923247bbca73e7859f15527f7b35e0c16199ac68aa035a19915",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "2035"
      ]
    },
    {
      "uid": "zhcn:31f0df5e6db601a2e331ae95",
      "kind": "character_system_text",
      "source_text": "やるぜ！",
      "source_fingerprint": "05bfb0caef818adc10910869c0499d0fa23c598e18b2555e93f48f643306a300",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "23015"
      ]
    },
    {
      "uid": "zhcn:d5ec7dd297b0acb0a1b89baf",
      "kind": "character_system_text",
      "source_text": "喔，对手也很行呢！",
      "source_fingerprint": "687958c9f4dd447bbbf0a334131a4310ca7643b3412187d5ff60a1da5511dc32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30000"
      ]
    },
    {
      "uid": "zhcn:fb6ae71474da58bebdcb35d5",
      "kind": "character_system_text",
      "source_text": "啊～！输了热血对决还是会不甘心！",
      "source_fingerprint": "8e0cc655fb2718f1d0858848752a272c554d662c05aeee617bc08febc41865b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30001"
      ]
    },
    {
      "uid": "zhcn:8d0c1950290509129c9c5753",
      "kind": "character_system_text",
      "source_text": "真是个不上不下的结果……",
      "source_fingerprint": "f6f5a797a296285da6806682154eced1578eac6b798c6c94301233538fc34692",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30002"
      ]
    },
    {
      "uid": "zhcn:459ce085e892359881a8804d",
      "kind": "character_system_text",
      "source_text": "可恶，我真是太不中用了！",
      "source_fingerprint": "a8ecbc69c128cd53c7c0245dbc24b8d378836ac4513a2b7659c97fa700c55810",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1450afa36fb267450625cf19",
      "kind": "character_system_text",
      "source_text": "用背影传达一切才潇洒！\r\n这就是稻荷大人的风格！",
      "source_fingerprint": "007de1a9afef22202e940365cc22fc02ce07b067e61f134cbda33055e3f96b2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30004"
      ]
    },
    {
      "uid": "zhcn:43c72c8afb8e0e73524d5242",
      "kind": "character_system_text",
      "source_text": "怎么样！就是这么简单啦！",
      "source_fingerprint": "e482bcca3d70cbabb06c83465c7bd455c749ea04cb0be08c95d58b5abb63c438",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30005"
      ]
    },
    {
      "uid": "zhcn:850d8868e7bda36f37ca21e7",
      "kind": "character_system_text",
      "source_text": "此刻我们的奔驰\r\n将连结起永恒的意念！",
      "source_fingerprint": "0c087bbe323d45f233e5cc079baa0787fd4ed2b7450598f6703669174ff48ea2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30006"
      ]
    },
    {
      "uid": "zhcn:6630dba183c399882f2e8d86",
      "kind": "character_system_text",
      "source_text": "怎么样！就是这么简单啦！",
      "source_fingerprint": "e482bcca3d70cbabb06c83465c7bd455c749ea04cb0be08c95d58b5abb63c438",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "30007"
      ]
    },
    {
      "uid": "zhcn:63ab1ce3fd22d3596d4385c7",
      "kind": "character_system_text",
      "source_text": "去大闹一场吧！",
      "source_fingerprint": "66c94b490f0c572ff96f3f5dd400506ac58f546519f1ee6fa47b2fb42e7fc201",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "31000"
      ]
    },
    {
      "uid": "zhcn:52ce8799f53a28a60436951d",
      "kind": "character_system_text",
      "source_text": "那么，好好看仔细了！",
      "source_fingerprint": "4662601e0428d7538d98d6dfc0b469ec8e5810f9390810f33164dfb7d2793ee7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "40000"
      ]
    },
    {
      "uid": "zhcn:df9f008ed28f9bc0621ac6d4",
      "kind": "character_system_text",
      "source_text": "嘿嘿，开始热血沸腾了！\r\n就由我们来让「神马驱」的气氛\r\n炒热到极点吧！",
      "source_fingerprint": "b154d8988ec17cf6fc313fa4fdd645eb293632120f038543e8adcd0a2d5e4ed0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "400001"
      ]
    },
    {
      "uid": "zhcn:ddcc3f388f10b4016788c0f7",
      "kind": "character_system_text",
      "source_text": "小玉明明那么会照顾人\r\n却完全没有自觉呢。\r\n或许这点正显示了她的大将之风吧！",
      "source_fingerprint": "326bfffc736edbd1ec9e11101534ce69a82ac2b2065fc88332cf1a1d329534dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "400003"
      ]
    },
    {
      "uid": "zhcn:565c4d4d859f0ac18687bbf1",
      "kind": "character_system_text",
      "source_text": "一同用餐、一同入浴，正因我们\r\n彼此团结才能达成今日这番光景。\r\n接下来让我们大展身手吧！",
      "source_fingerprint": "130da4e6f731f5536ff5ceecf040d85b7cdabd88160d0e74391e389e9a89b70f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "400007"
      ]
    },
    {
      "uid": "zhcn:7190da43585bc61aca57db8d",
      "kind": "character_system_text",
      "source_text": "看仔细了，亮眼的江户豪迈姑娘！\r\n稻荷大人要开始发威了！",
      "source_fingerprint": "31d00766360fbf4b075eec2763037f4c8da0bff3cc95786672cf046c0ffdb941",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "40001"
      ]
    },
    {
      "uid": "zhcn:b178301e1b7a4bba50ef4c78",
      "kind": "character_system_text",
      "source_text": "吾等心愿啊，奔驰吧！",
      "source_fingerprint": "507f23809dd659123498cd148c7103838ae997009f6f5a647af7fcc1ee776350",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "40003"
      ]
    },
    {
      "uid": "zhcn:9d7ad37c947db5819c67fb3e",
      "kind": "character_system_text",
      "source_text": "串连着过去与未来的「此刻」！\r\n超越时间与空间，\r\n吾等心愿啊，奔驰吧！",
      "source_fingerprint": "bfeb82039dd4ce80bc9acababfb9950bcd36801ecc25c3999d3e1cf9a0ec343a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "40004"
      ]
    },
    {
      "uid": "zhcn:30743c9650892f829fd81c3d",
      "kind": "character_system_text",
      "source_text": "期待已久的重大时刻！",
      "source_fingerprint": "64baf33471b31438fc9021d58a2593389f52a84c63c60b21b9bf9ca1a47eebe5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "60000"
      ]
    },
    {
      "uid": "zhcn:4e074297931d4218d8873033",
      "kind": "character_system_text",
      "source_text": "祭典开始了！打起精神来吧！",
      "source_fingerprint": "b059d45140aba9331d36f36f7e627bcf8aa00c082a81e96f058a1d0d3216a30d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "60001"
      ]
    },
    {
      "uid": "zhcn:c086a8a9a7597b86d591415a",
      "kind": "character_system_text",
      "source_text": "潇洒地跑一场吧！",
      "source_fingerprint": "409b883f2a9392f86d1bdbf15133a8cd7969e25b8d4c8bf1051e6cf9f3d180ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1034",
        "70000"
      ]
    }
  ]
