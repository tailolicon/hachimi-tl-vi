    },
    {
      "uid": "zhcn:617d72ee2125b0e57e833cc2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "完美遵守行程的原因……\r\n因为你让我明白了重要的事情，\r\n真的很谢谢你。",
      "source_fingerprint": "604d793213a3f862f7b55c0748905cc1df51a15fac85cab65b6c72b238ee7981",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
