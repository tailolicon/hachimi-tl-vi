      ],
      "json_pointer": "/1037/10012"
    },
    {
      "uid": "zhcn:963f4dfe64292df1fd63bcef",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "自己诞生的日子……\r\n也是重新审视\r\n自己人生安排的重要日子。",
      "source_fingerprint": "1a71cd374dd3ea55258f3284d433513219f8f005bfeb89824bae875b3b3d195b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
