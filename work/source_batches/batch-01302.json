      "kind": "character_system_text",
      "source_text": "创下最高分啦──！！",
      "source_fingerprint": "b61829a3ffa10aa6d94b4724d0bffaaa69f161641d7d821d4efa1261693fcd5c",
      "source_path": "character_system_text_dict.json",
