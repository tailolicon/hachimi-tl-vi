      ]
    },
    {
      "uid": "zhcn:0ef54af833a2048651752cbf",
      "kind": "character_system_text",
      "source_text": "怎么这样啊～！？",
      "source_fingerprint": "d419a5476e87e630471ff4fb96abfbd001fb3ee9a028ba1402d61d82b80d5e39",
      "source_path": "character_system_text_dict.json",
