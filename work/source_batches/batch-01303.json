        "140007"
      ]
    },
    {
      "uid": "zhcn:565ad42a041a73e8683f0550",
      "kind": "character_system_text",
      "source_text": "啊哈。",
      "source_fingerprint": "1d93eddabd018011e10e1e48a3233cd944998dfcbd8d7660d915eb3831b48668",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140008"
      ]
    },
    {
      "uid": "zhcn:f4db1a0959fb4b6a818eaa7f",
      "kind": "character_system_text",
      "source_text": "啊哈哈！",
      "source_fingerprint": "7990e29ba73adbb25caf3a56bd6650d89178b313c21bbc997967b4db791ccd69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140009"
      ]
    },
    {
      "uid": "zhcn:2437a1599b8568ead486ade5",
      "kind": "character_system_text",
      "source_text": "什么什么？",
      "source_fingerprint": "f2d8a979d687f49aa30529f5f87714a6fc89ee4b7cc23d3a607290781f54b8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140010"
      ]
    },
    {
      "uid": "zhcn:00f226b24ab3c12cb997b470",
      "kind": "character_system_text",
      "source_text": "好棒喔喔喔！",
      "source_fingerprint": "c526f0554667946c46be451c8772bea9bf142a21917d2309f9c39097d957ff5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140011"
      ]
    },
    {
      "uid": "zhcn:44cd77fa191d5bfc895f7064",
      "kind": "character_system_text",
      "source_text": "好耶──！",
      "source_fingerprint": "4d6e8ddf78ab96962ce0d078439426606da213fa68482b193399045a60f7c142",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140012"
      ]
    },
    {
      "uid": "zhcn:51a9f46eb713e0e11ba01f93",
      "kind": "character_system_text",
      "source_text": "呜喔喔喔喔──！！",
      "source_fingerprint": "71b79d7c6d380bc1decacff530c4f14d8d09ad10f5d72faae6831b8586a1ba1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140013"
      ]
    },
    {
      "uid": "zhcn:9e5d2793b2e95689691ea1c9",
      "kind": "character_system_text",
      "source_text": "唔唔唔～！",
      "source_fingerprint": "a6ad9af75249cd8ac42bab6d87c0b4ff23d25bc749a8379598f7a1dc103d4d78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140014"
      ]
    },
    {
      "uid": "zhcn:00f97214d433fca0b4ce9fb6",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140015"
      ]
    },
    {
      "uid": "zhcn:6232c2931ae7d70e55bf4c7a",
      "kind": "character_system_text",
      "source_text": "喂喂喂喂！",
      "source_fingerprint": "b989b90f582de5c335a3585db532d72bc748d7ad53d038cfd545aca2635ee3ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140016"
      ]
    },
    {
      "uid": "zhcn:8a5848e005401bacd83063f3",
      "kind": "character_system_text",
      "source_text": "晴天霹雳……",
      "source_fingerprint": "21da19036aca94b24b977bf31c72253b7e21475767d3aebf1f504a3c7ed09dbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140017"
      ]
    },
    {
      "uid": "zhcn:3e7d645ab8bb1b487319e036",
      "kind": "character_system_text",
      "source_text": "什么────！？",
      "source_fingerprint": "139810e2dba12fecb2a945c16356ff552d5af375d2103389f9baacd08020e062",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "140018"
      ]
    },
    {
      "uid": "zhcn:d2ed7266b98316cefe00a789",
      "kind": "character_system_text",
      "source_text": "明天的奖励是这个！\r\n好期待啊──！！",
      "source_fingerprint": "b14b483c7ddbf11dae3f4f5dbae85fec9ce083c5f58fdaf19f1218c26338fc91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "15"
      ]
    },
    {
      "uid": "zhcn:d3d05951939ebc83c03174a2",
      "kind": "character_system_text",
      "source_text": "呼……唉……\r\n好、好累啊……",
      "source_fingerprint": "e231265acf487ac15b447e25104c0e3028dfd72b55eb02c58aee27c2e14c0a9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20000"
      ]
    },
    {
      "uid": "zhcn:f297f3a9709ab9827bc9e7d5",
      "kind": "character_system_text",
      "source_text": "唔唔唔……训──练──员──\r\n我还想继续努力的……\r\n但是身体动不了了……",
      "source_fingerprint": "403479af6b7268edf2a56cd60a5e32a43c21ed83664597c99d8ee102d9511891",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20001"
      ]
    },
    {
      "uid": "zhcn:f167a37837f0d6a83027bfa7",
      "kind": "character_system_text",
      "source_text": "呜喔喔喔喔──！！\r\n来了，感觉到了！！\r\n我充满了力量啊──！！",
      "source_fingerprint": "14ab4f7c0825c3195c213e4092f1e99b2f12059034817078c0c7a058a0ff3736",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20002"
      ]
    },
    {
      "uid": "zhcn:eac568e6cd1ea5a70dc76358",
      "kind": "character_system_text",
      "source_text": "怎么办啊，训练员！！现在的我\r\n好像很无敌诶！虽然不知道原因，\r\n但感觉很棒哦──！！",
      "source_fingerprint": "cad6ff18ef8aa3bbf64987957f2e86476597757414f4d22e5dabfb6b74ccea73",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20003"
      ]
    },
    {
      "uid": "zhcn:c110e6854381ff9f6a8dc5b3",
      "kind": "character_system_text",
      "source_text": "我有把早餐吃光光再来哦！\r\n今天也要咻咻咻地快速做完哦──！",
      "source_fingerprint": "252fa09dbfede9b1b6b7c803a1f00d10ec270eaf8f4719ea36b8186b5495ea77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20004"
      ]
    },
    {
      "uid": "zhcn:e106a8fe5969336c991ac692",
      "kind": "character_system_text",
      "source_text": "我什么都想要试试看哦！\r\n因为有多努力，速度就会变多快嘛！！",
      "source_fingerprint": "c1e39d5ea70bed85fa7b475e0e3645afd5f797c512179007512ddec8bee25b7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20005"
      ]
    },
    {
      "uid": "zhcn:735f430f5459ef20212aeeca",
      "kind": "character_system_text",
      "source_text": "今天也是很适合训练的天气呢！\r\n那今天也好好努力吧──！",
      "source_fingerprint": "a29704b161f77d6653fb3541c3fbaa4f57e8c362d40779a1789c4c196f3cf4f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20006"
      ]
    },
    {
      "uid": "zhcn:0ba789ae9338d79adcc3b131",
      "kind": "character_system_text",
      "source_text": "嘿嘿──！\r\n我跟平时一样充满活力哦──！",
      "source_fingerprint": "a5424871554674a4fc4e25e7bc05dd2a65373f3f9e1661eebd99ace64cf73714",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20007"
      ]
    },
    {
      "uid": "zhcn:ab2646169b213b705f095688",
      "kind": "character_system_text",
      "source_text": "准备吗？\r\n我准备好了哦！应该吧！",
      "source_fingerprint": "ccedac088ca1b1e33b2bbbe3f256f21cf04e0d8cfc80ae0901ebdd57b0b82365",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20008"
      ]
    },
    {
      "uid": "zhcn:b65b5e76dc8b464b729e3ce6",
      "kind": "character_system_text",
      "source_text": "呼啊……啊，对不起！！\r\n你刚刚说什么？啊，训练啊！！",
      "source_fingerprint": "3bfe9a524eb840977b52c05e7d414b9f545ce1ad5e1a5a6691851958902d146f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20009"
      ]
    },
    {
      "uid": "zhcn:44230031dd622019c96986f0",
      "kind": "character_system_text",
      "source_text": "身体明明很健康却使不出力气……\r\n嗯……真是奇怪……",
      "source_fingerprint": "10d9a82c471667f5e61de9e1dd0af0c9fb32b5a9eca5d831b22a35961e577c97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20010"
      ]
    },
    {
      "uid": "zhcn:00f12f9f0063638c76a020ca",
      "kind": "character_system_text",
      "source_text": "听说早起对身体好，\r\n所以我三点就起来了来着……\r\n怎么觉得状态不太好啊～",
      "source_fingerprint": "4ec3d071b0235feb81baa405e94c97892dcba2f15085c2a16d46b46d21be6192",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20011"
      ]
    },
    {
      "uid": "zhcn:c61117c729208477e7e0f17d",
      "kind": "character_system_text",
      "source_text": "又、又要比赛了啊！？\r\n最近一直在比赛吧！？\r\n虽然跑步很开心，可是……唔唔唔。",
      "source_fingerprint": "fa4f5f494ffb0caa49249124abb027b9c6d6a577570f82cb4e6b772ffee25f4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20021"
      ]
    },
    {
      "uid": "zhcn:dd3d64b0f41326e295f78369",
      "kind": "character_system_text",
      "source_text": "唔唔唔……！连续参加太多比赛，\r\n感觉没办法跑好了……！\r\n是我太软弱了──！！",
      "source_fingerprint": "dcd304adbed527698e1891ed6fe6ef52a87ee096f7bcf374bc265cab34b5d84f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20022"
      ]
    },
    {
      "uid": "zhcn:b807e29d0e13e0b98d8aaf59",
      "kind": "character_system_text",
      "source_text": "所有状态都很棒哦！\r\n我一定会抓住胜利的奖券的！！",
      "source_fingerprint": "425f1d6950901350a27c3fe04b1f0a636ed9ca7c30d5f52a43df36e637019cb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20023"
      ]
    },
    {
      "uid": "zhcn:611f7b226d8e7d1599b3a665",
      "kind": "character_system_text",
      "source_text": "我已经下定决心一定要跑赢了！\r\n我绝对不会输的！\r\n要对我充满期待哦！！",
      "source_fingerprint": "e7d87eddafb53096ec85d84cc81a8a764347fabff7f348f8bc86cf9f94814234",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20024"
      ]
    },
    {
      "uid": "zhcn:eccb0036ac5e7927ab4eba3d",
      "kind": "character_system_text",
      "source_text": "活力满分！气势也十足！\r\n最后的直线\r\n我也会快速冲过哦──！！",
      "source_fingerprint": "33e772dcb266d7163182aeae58ccf2409ee3b215600a6d61d9fc7e96de8512a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20025"
      ]
    },
    {
      "uid": "zhcn:009bb052444cbaf4c7c1b68e",
      "kind": "character_system_text",
      "source_text": "诶嘿嘿，无论是什么比赛，\r\n我和训练员的组合\r\n一定都会很顺利的！",
      "source_fingerprint": "cd66a7af50649219b022abbd059d9cc03b653e5357bad21b850324904cb38847",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20026"
      ]
    },
    {
      "uid": "zhcn:e0c1d8315c09fa23e4bdfd9a",
      "kind": "character_system_text",
      "source_text": "呼……\r\n……嗯，集中力完全没有问题！\r\n再就只需要专心去跑了！",
      "source_fingerprint": "aa7760671048878373bf0238f55201a44d5da137cc9525a0ce859846487925b7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20027"
      ]
    },
    {
      "uid": "zhcn:8d27574321cbb817a13bcd41",
      "kind": "character_system_text",
      "source_text": "状态感觉很好哦！\r\n感觉可以全力用自己的跑法去跑呢！",
      "source_fingerprint": "2b2f18084cab377bb6b16150be7138c15d3bede5f8af665dfef721a55b68a3c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20028"
      ]
    },
    {
      "uid": "zhcn:f15b3f50c8cc2aebdef9c914",
      "kind": "character_system_text",
      "source_text": "就快要比赛了呢──！\r\n不知道会有哪些对手呢？",
      "source_fingerprint": "27f2db5893dc0f9ae4728bc26cab6d24bfe6e498d73c174efbbc919c9152d972",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20029"
      ]
    },
    {
      "uid": "zhcn:1de3c654c5e0a03a2bc0617e",
      "kind": "character_system_text",
      "source_text": "嘿嘿，\r\n比赛前都会觉得很期待呢！",
      "source_fingerprint": "14098362e27c1acb7fc34e48a911af9883c236220b657934a0e4ec5c50ef3380",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20030"
      ]
    },
    {
      "uid": "zhcn:1bc195ddd37d35d7fa23616f",
      "kind": "character_system_text",
      "source_text": "有没有什么忘记准备的？\r\n诶嘿，因为我很常忘东忘西的，\r\n就麻烦训练员确认咯！",
      "source_fingerprint": "417eb6304508b4d5f27d4e357cd2caf0b51ee6279569de84ce3ed4a242e85669",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20031"
      ]
    },
    {
      "uid": "zhcn:6b48465476c04b77a438b543",
      "kind": "character_system_text",
      "source_text": "唔唔～身体好痒啊～！\r\n好紧张啊──！\r\n但我的斗志也燃、烧、啦──！",
      "source_fingerprint": "5169355a13c1397d44dcb3ffa053eb164d9d7a2c8afdf1352f3336b1842a6e28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20032"
      ]
    },
    {
      "uid": "zhcn:6e1e8a4ecf9eba787aa6558d",
      "kind": "character_system_text",
      "source_text": "唔唔唔……这样下去不行！\r\n要拿出气势才行！\r\n喔喔喔喔喔！喔喔喔喔喔喔喔！！",
      "source_fingerprint": "75605a6eeb401c67db02847a4df47b0c5d7bab4ed7ff577528812d6eccb1bebd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20033"
      ]
    },
    {
      "uid": "zhcn:c1cf12c6ed89a6a77b1e7c3e",
      "kind": "character_system_text",
      "source_text": "虽然还有很多不放心的部分，\r\n但我的身边还有训练员在嘛，\r\n不──怕、不──怕！",
      "source_fingerprint": "c619180c834dd4c5644873a570a561266a3ba1f06a7ed23d6e1df4b8e5fb4619",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20034"
      ]
    },
    {
      "uid": "zhcn:7cb4ebf71e90d19915f8e251",
      "kind": "character_system_text",
      "source_text": "如果我输了……\r\n啊──怎么可以有这种想法……\r\n唔唔，可是……啊啊，我好没自信啊～",
      "source_fingerprint": "3d47971ef8e4d8f9e6e206aff670b56c01660777942fa9573d87a5929d0e6cd7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20035"
      ]
    },
    {
      "uid": "zhcn:c5e695872d9908bd957938ca",
      "kind": "character_system_text",
      "source_text": "深、深呼吸好了！！\r\n嘶、嘶～嘶～～～\r\n唔……好、好痛苦……",
      "source_fingerprint": "d7f7d341c30de0a7a71aa70768cff3723e50c78ea6eb00163d23e63afab9f0e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20036"
      ]
    },
    {
      "uid": "zhcn:c0b99e481ba7b6f83b36a1f6",
      "kind": "character_system_text",
      "source_text": "唔唔……大家都绷紧神经的感觉……\r\n唔啊～身体好痒啊～\r\n但还是要拿出气势才行～唔唔～！",
      "source_fingerprint": "1869c7a52a0114601a2f3cc55fbbb9bbb25d2747212a4ab598fc9fdc3e0ae460",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20037"
      ]
    },
    {
      "uid": "zhcn:e94d0b88e7a179f75be453fa",
      "kind": "character_system_text",
      "source_text": "了～解！",
      "source_fingerprint": "3e54952f7e689d1de159ba3588bfe37b68fde628c3f2ec64b07e2dac5002320d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1035",
        "20038"
      ]
    },
    {
      "uid": "zhcn:3dccd04169c4317dda27fc2d",
