      "kind": "character_system_text",
      "source_text": "太棒啦────！！",
      "source_fingerprint": "441dc8989c30ee985e9e81f4aa3635575481474db4b37bae7ef8f4b72e9cf1c7",
      "source_path": "character_system_text_dict.json",
