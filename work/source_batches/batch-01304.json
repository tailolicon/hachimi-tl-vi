    {
      "uid": "zhcn:4e3258242eabd57c4b496512",
      "kind": "character_system_text",
      "source_text": "辛苦了！",
      "source_fingerprint": "20df094ff1112517c623c111a7239f2b6398134743fb570a85aa6a2f9f1f8889",
      "source_path": "character_system_text_dict.json",
