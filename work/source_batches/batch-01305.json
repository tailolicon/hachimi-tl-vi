    },
    {
      "uid": "zhcn:4b6de012dda966a74ed58cc8",
      "kind": "character_system_text",
      "source_text": "今年的机伶很可爱对吧。\r\n明年会让姐姐看到\r\n更可爱的机伶哦♪",
      "source_fingerprint": "77c1ddc3e70fe9830605c3e26d9c7ecfe8af0233d4f3d5c6548fbebd1291eb2c",
      "source_path": "character_system_text_dict.json",
