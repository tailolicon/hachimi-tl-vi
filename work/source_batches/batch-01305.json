      ]
    },
    {
      "uid": "zhcn:401fc75ab54f091f1a6e2941",
      "kind": "character_system_text",
      "source_text": "对机伶来说，\r\n圣诞节就是要和家人一起过。\r\n所以今晚……我就是要找姐姐。",
      "source_fingerprint": "2cb9c90b5ffd8f944d688ab1938f000225dc7bf6a9ff4332253c470ceff7748d",
