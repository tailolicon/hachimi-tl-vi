        "1006"
      ]
    },
    {
      "uid": "zhcn:c1be1fa60e5438382b21cfd8",
      "kind": "character_system_text",
      "source_text": "创下最高分了♪",
      "source_fingerprint": "1288f29b67a3f160eb0f1b8a9d6126945ac0d71e64df6c110ff357d613229464",
      "source_path": "character_system_text_dict.json",
      "json_path": [
