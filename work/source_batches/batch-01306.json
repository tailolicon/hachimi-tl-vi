      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1038",
        "20005"
      ]
    },
    {
      "uid": "zhcn:d7fbb25d287be37eef0d808d",
      "kind": "character_system_text",
      "source_text": "机伶觉得什么都可以。\r\n随你高兴没关系哦♪",
