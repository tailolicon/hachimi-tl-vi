      "kind": "character_system_text",
      "source_text": "ファルコンさんが選んでくれたのですが、\r\n少し大胆でしょうか…？",
      "source_fingerprint": "6d40b323250ca8fc987c3b8a75686bbd053cfa1ba2c55f7aac54b7fb5ba57b81",
      "source_path": "character_system_text_dict.json",
