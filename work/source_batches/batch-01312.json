        "1040",
        "1000"
      ],
      "json_pointer": "/1040/1000"
    },
    {
      "uid": "zhcn:153b8598569bfb032d18c1fb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "不管是模特还是比赛，现在我必须要\n做到两全其美。经纪人估计血压又会\n升高了吧…但我可不会放弃。",
      "source_fingerprint": "d51131348d3bf1930396b78c0fe550d70e1e369f05698b139997114c47bd72a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
