    },
    {
      "uid": "zhcn:101d94582016d6768fae7ad3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "啊…为什么每次一到年初都会这样\n忙得要死啊…\n经纪人也给我接了太多工作了吧…",
      "source_fingerprint": "0579558b2320f522a52603723082df5a716680d5f825500be47e5f626d866bc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
