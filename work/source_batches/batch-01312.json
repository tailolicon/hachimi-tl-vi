      "uid": "zhcn:2682ea45f9eccf781bd6b000",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "ただいま。",
      "source_fingerprint": "c3d9f2c221a037f0a2eb9da22145532ea4b422af42c29694227631ad74c073f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
