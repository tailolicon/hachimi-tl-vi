    {
      "uid": "zhcn:5917402bcf19d6f1b59a53a8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我们已经成为传说了呢！",
      "source_fingerprint": "bd0a357ad168bb65cc9ce1139eb0957d9aa703a24fdeb422c067fabec879c7b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
