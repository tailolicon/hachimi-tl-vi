    },
    {
      "uid": "zhcn:abd655b61bf7100bbdaa708f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这样——等等，你今天生日吧？\n哎？这种事我多少还是记得的。\n姑且祝贺一下吧。生日快乐！",
      "source_fingerprint": "47a1a0e877fe2d3080c343cfa24b852b4779564d6076de4f782dcd70b2e61e35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
