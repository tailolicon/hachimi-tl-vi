    {
      "uid": "zhcn:e6dd90cb93b9c848903561cc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "你看新公告了吗？\n上面有时候会写一些重要信息，\n读一下也没什么损失嘛。",
      "source_fingerprint": "99b4bb2f77c8722a79987633801ee457874633013f379c6687e4bc3981258edd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
