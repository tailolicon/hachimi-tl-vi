      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1039",
        "95009"
      ],
      "json_pointer": "/1039/95009"
    },
    {
      "uid": "zhcn:c07d26fa28feaf23709ec0db",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "カワカミプリンセスです！\r\nこの姫っぷり、ごらんあれっ！！",
      "source_fingerprint": "634c168c1c43e8c0d13abadc304b23ec097c25b4d9a07b2902a26f8083dc66b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
