    {
      "uid": "zhcn:fd8f961af8e0dfda650a6777",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "辛苦了。顺便…圣诞快乐。\n不至于这么高兴吧…\n正常地享受节日就可以啦。",
      "source_fingerprint": "80411f9f430ad1cc3f91938bb112bbae61f4aa7dbe83c24853261c9668db1410",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
