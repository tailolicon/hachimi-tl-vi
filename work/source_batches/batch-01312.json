      ],
      "json_pointer": "/1039/92018"
    },
    {
      "uid": "zhcn:591b0dd27a2a463d50b22263",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "“想い”と共に引き継いだ衣装…\r\n恥じぬ姿で\r\n駆け抜けるつもりですわっ！",
      "source_fingerprint": "716e7459a67429ad186c59795da66d340fd01fe092fc5f437229510234c54ec0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
