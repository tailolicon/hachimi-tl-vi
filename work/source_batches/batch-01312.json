    {
      "uid": "zhcn:f6bffaf40de2362b2ca43b86",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "说到夏天就是海边！集训！王子！\r\n让人情绪高涨了～！！",
      "source_fingerprint": "e2c031255c0daad178eff89c96e6a76fbad0d442da8e5cad3fd4911bf51d60b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
