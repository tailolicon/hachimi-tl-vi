  "entries": [
    {
      "uid": "zhcn:2f7cd0aafcbf0fbe6d48397c",
      "kind": "character_system_text",
      "source_text": "嘛，也不错啦。",
      "source_fingerprint": "09ff7a34685447572dce46238a21c7d4f52d754084de3f0b107abc7531198f97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140007"
      ]
    },
    {
      "uid": "zhcn:4b539e9327a30c1f760dc2fd",
      "kind": "character_system_text",
      "source_text": "哈哈",
      "source_fingerprint": "7a655569d7aab2029ca20b72aea1237bb7852fc2a5b4a297e9a49b4fed453b2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140008"
      ]
    },
    {
      "uid": "zhcn:2581b016bdfa5728cba69129",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140009"
      ]
    },
    {
      "uid": "zhcn:f5bb8b18d6b84eae8d2d643b",
      "kind": "character_system_text",
      "source_text": "嗯～嗯～…♪",
      "source_fingerprint": "c5e9b077e8a1f14dc04a41e737c89a0a1af31d841107278c5e3b23b4e7f097e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140010"
      ]
    },
    {
      "uid": "zhcn:b1a8203bde49c4ce10da6a69",
      "kind": "character_system_text",
      "source_text": "哦…！",
      "source_fingerprint": "861e381766f9c02e67f4fd7c6c7e43e50e3a9ac700f6365ae10bf107e6f8079b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140011"
      ]
    },
    {
      "uid": "zhcn:eb05410c4b3a84ec1c19dfe0",
      "kind": "character_system_text",
      "source_text": "不错嘛",
      "source_fingerprint": "b112658fd90d7e63d60af9c2fcb056b177e6f3de19f078e91d1530bd477a6e00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140012"
      ]
    },
    {
      "uid": "zhcn:3639179f2df24455d4085f8a",
      "kind": "character_system_text",
      "source_text": "好棒！",
      "source_fingerprint": "106d9fb0b65401b4a93353c62b64a274e2ccd23376f9b2ab25c84cb68a69582f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140013"
      ]
    },
    {
      "uid": "zhcn:bf90816eeb40d46a37c63523",
      "kind": "character_system_text",
      "source_text": "哈！？",
      "source_fingerprint": "38e494710f6489cef9e34e4f68cc92749f364d08db45c3cd10862a6bee64a2bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140014"
      ]
    },
    {
      "uid": "zhcn:662f6986d6b1587500cb1113",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140015"
      ]
    },
    {
      "uid": "zhcn:12207afb85f48d7fc8b9e667",
      "kind": "character_system_text",
      "source_text": "上吧上吧！",
      "source_fingerprint": "9d2faafac271e7cb1ffd1fe8174ec58d293056199114b9288fce1c91dc3fbc3f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140016"
      ]
    },
    {
      "uid": "zhcn:9b51079471a97e5779a82a50",
      "kind": "character_system_text",
      "source_text": "啊…真是的…",
      "source_fingerprint": "7a932148acc6354402677215d404f103ac0146bf7efbeb719d36fa46e7c55878",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140017"
      ]
    },
    {
      "uid": "zhcn:be5433191da93d7ac2a6f79d",
      "kind": "character_system_text",
      "source_text": "可恶…",
      "source_fingerprint": "967ba7daaba846761928740bcbfc210b075a98645f1b3607764d03d212afdf81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "140018"
      ]
    },
    {
      "uid": "zhcn:1b26538320b4d4661e660775",
      "kind": "character_system_text",
      "source_text": "明天是这个？不错嘛。",
      "source_fingerprint": "202ac57ccea9a8a2f01f773132c40ef7f15aa6a9118737a0d5536005161280af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "15"
      ]
    },
    {
      "uid": "zhcn:d79c07f6d84d3c87245eeb41",
      "kind": "character_system_text",
      "source_text": "感觉好累啊…\n困了倦了疲了乏了…\n…抱歉，说了一堆借口。",
      "source_fingerprint": "9c61b12cd80102adb2cd6d8e32f18459c23f6de270ec8cbbdb00726a520bdffb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20000"
      ]
    },
    {
      "uid": "zhcn:3cf70c15c0bbce2f777cb022",
      "kind": "character_system_text",
      "source_text": "等下啦。现在还是以休息为重吧？\n就算现在逞强也没什么意义，\n不如先恢复下体力如何？",
      "source_fingerprint": "8ccbb4c2c1f00b4a3a64d9966cfa1dd33c234e56667f6c0e298a8802f09947a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20001"
      ]
    },
    {
      "uid": "zhcn:d453377903281c21c80a7530",
      "kind": "character_system_text",
      "source_text": "现在我感觉很棒哦！\n感觉身体中正涌起无穷无尽的力量，\n状态绝佳呢！",
      "source_fingerprint": "29d1cd1757c5f7b26c1f4f5a4369afb9155c2a84904f05b02b0cf70a64b9ae09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20002"
      ]
    },
    {
      "uid": "zhcn:8f5718d36820aee8da2c8d8e",
      "kind": "character_system_text",
      "source_text": "情绪高涨起来了！\n心情超棒，身体也很轻盈！\n感觉现在可以一直奔跑下去呢！",
      "source_fingerprint": "5f299f985634f3d3afc397fbabfff755b6bd1c02229ff38884e2bec75c2c6a71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20003"
      ]
    },
    {
      "uid": "zhcn:faf3a2c4c0310662a358279c",
      "kind": "character_system_text",
      "source_text": "嗯，状态不错。\n安排些困难点的训练也没问题哦。\n总觉得，现在的我无所不能呢。",
      "source_fingerprint": "2388914798acb44dbff1237fc158bf8c1fc4ae8c90c0164b44eb27a9d08c706e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20004"
      ]
    },
    {
      "uid": "zhcn:46def9ef0a258a1c5f8388ef",
      "kind": "character_system_text",
      "source_text": "哼哼哼、哼哼～♪\n…唔哇，你听见了吗？！\n我就是在哼歌啦！因为心情很好嘛！",
      "source_fingerprint": "946483f472ad5d9f14f321104755f9e0fd7aafc1e587bdffa12c63871ca39517",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20005"
      ]
    },
    {
      "uid": "zhcn:81d89d79d78c31c0f2a74302",
      "kind": "character_system_text",
      "source_text": "好，差不多也该加油啦～\n好好努力，跑出更好的成绩，\n现在必须以更高点为目标啊。",
      "source_fingerprint": "08cc6ef34209b571fb8c3f2afdd43f674d616f1c238d3242b99d5026356c975c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20006"
      ]
    },
    {
      "uid": "zhcn:38f548b49b88c2a2e42f0a84",
      "kind": "character_system_text",
      "source_text": "喂，接下来做什么训练？\n我倒是练什么都可以啦…",
      "source_fingerprint": "133fbc70b19f0f42d830c9c25f67a54c9c86a833d27d4f463a454bd5a5fea4e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20007"
      ]
    },
    {
      "uid": "zhcn:879f5a2a82b8945a67b3ea72",
      "kind": "character_system_text",
      "source_text": "…不做模特工作的时候，\n不用带着那副营业般的假笑也行吧。\n现在没那种心情。",
      "source_fingerprint": "7c72ed50e9ba6fd95ce281a3e480bacfdc43e5185b88ffce1843da5c234b6e40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20008"
      ]
    },
    {
      "uid": "zhcn:89f7ecae70c4d00202da81c2",
      "kind": "character_system_text",
      "source_text": "啊真是的！好烦啊！\n明明心里这么想跑，\n但身体却完全跟不上！",
      "source_fingerprint": "1291af4e9a4758023c941a66ad72aea562d0db3242e3df172d88f707688b4de2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20009"
      ]
    },
    {
      "uid": "zhcn:da355ea55ad2c5b6ac3bb77f",
      "kind": "character_system_text",
      "source_text": "只要不断奔跑、不断奔跑…\n我就能真正成为“我自己”了吗？\n…总觉得，我完全做不到啊。",
      "source_fingerprint": "b0a3b2e37f5fd393dfbff4907601a94fba2aaa76ac290a7922f3c9acac83c5ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20010"
      ]
    },
    {
      "uid": "zhcn:1c58a70f7ff045c70474e297",
      "kind": "character_system_text",
      "source_text": "皮肤状态这么糟，头发也乱成一窝。\n光看一眼我这糟糕的模样就知道我的\n状态有多差了吧。感觉真差劲…",
      "source_fingerprint": "32b25d53de0a3893148779524153f22e89df1275f2c9a4b8809fa25aa431e162",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20011"
      ]
    },
    {
      "uid": "zhcn:5736aae37e6dd6a5ef7db891",
      "kind": "character_system_text",
      "source_text": "诶？还要继续参加比赛吗？\n这不就是连战了吗…\n嘛，要是你坚持要参加比赛的话…",
      "source_fingerprint": "d8e587dd66b74f366c51fb6c785c36ed281b3cfbbf6eff9f8e555840e5029cfe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20021"
      ]
    },
    {
      "uid": "zhcn:5b751fc78d2123f143a2dc77",
      "kind": "character_system_text",
      "source_text": "哈啊…多少也该休息会了吧？\n我的身体可是在悲鸣啊。\n继续参加比赛的话胜算也不高吧…",
      "source_fingerprint": "41a22d06a59dc129785451e14061bb059506fcc20136574d76a75cb7b5b52fdd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20022"
      ]
    },
    {
      "uid": "zhcn:575b15fa847d8bc5a03de494",
      "kind": "character_system_text",
      "source_text": "之前已经好好调整过了，\n现在状态绝佳！\n应该能跑出好成绩哦！",
      "source_fingerprint": "0db55f5d53c14e5dcc843308edfe74dc228017ab4150aeeef4780666e69e3a42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20023"
      ]
    },
    {
      "uid": "zhcn:d5515adbf535eb741f2c7744",
      "kind": "character_system_text",
      "source_text": "…我会好好比赛的哦。\n为了让来观战的人…和你一起\n见证真正的“我”。",
      "source_fingerprint": "b397927573bc523d60c785f2bc53ae236e355a0fb16eaef425520d37a1b98ecc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20024"
      ]
    },
    {
      "uid": "zhcn:a016b27f9c410efbca4d194a",
      "kind": "character_system_text",
      "source_text": "没关系。我会将我的“真我”，\n在这场比赛中毫无保留地展示出来！\n一定能得到好成绩的！",
      "source_fingerprint": "bd910a881fbdcc891a50c0779559daabac81dde11a8b87135a8448b8bb21efff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20025"
      ]
    },
    {
      "uid": "zhcn:30b26e6f1e0ae8c5977b9ded",
      "kind": "character_system_text",
      "source_text": "呼…吸…\n深呼吸…好。感觉不错。\n接下来只要跑出“真我”就行了。",
      "source_fingerprint": "e7593698fa144d5bbf1cd6b80a31edc9e057f0e47259a3c1c69f5cb2b37b883e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20026"
      ]
    },
    {
      "uid": "zhcn:5f6c3c8395a875fd80c5b6e1",
      "kind": "character_system_text",
      "source_text": "我的眼神怎么样？\n…呵呵，感觉很棒对吧？\n放心地守望我的比赛就好啦。",
      "source_fingerprint": "4f8efcc750eeca9215bf850c35997a2c368854f74f97916ae9b5e0dbb5ce849a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20027"
      ]
    },
    {
      "uid": "zhcn:2b2f2cdade90c49710a71b75",
      "kind": "character_system_text",
      "source_text": "状态感觉不错，\n之前的训练中也拼尽全力了…\n嗯，鼓起干劲上吧。",
      "source_fingerprint": "b53db368c0c1f0ddf8fdc5b6edc677a1d571cff91dc66c9e5adb86d2c9412f4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20028"
      ]
    },
    {
      "uid": "zhcn:4f387959d3290367c8beeb7f",
      "kind": "character_system_text",
      "source_text": "终于到比赛了啊。\n就试试能不能拿下第一名——\n嘛，你就看好了吧。",
      "source_fingerprint": "fa1dccba1be410d2f96f300af63d1d3b2a4f398640fca3da073fd25848ceb553",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20029"
      ]
    },
    {
      "uid": "zhcn:2dd0bc24f246bb53a5ad9f9b",
      "kind": "character_system_text",
      "source_text": "就按照平时那样来就行了吧？\n好好，我知道我知道。\n真是的…你操心过头啦。",
      "source_fingerprint": "3ba811a9d94d6294d7ea7dffc88872090f56a267a5a45239fa99edf04692bfd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20030"
      ]
    },
    {
      "uid": "zhcn:428cc875f390d2dc5c450808",
      "kind": "character_system_text",
      "source_text": "喝杯热柚子茶就能放松下来…\n哈哈哈，明明是拍摄前用的放松法，\n没想到比赛前也能派上用场啊。",
      "source_fingerprint": "e2e1d8f85c52b344ff89c51113bc241794b6e1cfcdf7c2496386618404dcd478",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f8b720b5966081b7332b9a64",
      "kind": "character_system_text",
      "source_text": "哈～紧张死了。\n好奇怪啊…\n我在摄影前都没这么紧张过…",
      "source_fingerprint": "07fedc8f252359c6a03e41a1ec5df8d4e859874d6f4879b5fe37632a28b76a70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20032"
      ]
    },
    {
      "uid": "zhcn:b32d92136aea27386207e023",
      "kind": "character_system_text",
      "source_text": "现在还不是低沉的时候！\n已经进行过状态的调整，\n能做的事情都已经做过了…吧。",
      "source_fingerprint": "1a5fe2d3ac1184582b513da84774e2832e05ad45ce74c91da09dc28e749bc19e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20033"
      ]
    },
    {
      "uid": "zhcn:e13bd32e6452968121d014c2",
      "kind": "character_system_text",
      "source_text": "啊～真是的！完全冷静不下来！\n真想早点看见结果…\n现在只想为了奔跑而奔跑而已…！",
      "source_fingerprint": "ce131ab075d9e9d4198ffc7c4d31e0c3ff604d3fe5b892a97c99bad512122fbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20034"
      ]
    },
    {
      "uid": "zhcn:2b9fb996274fa92d278a425a",
      "kind": "character_system_text",
      "source_text": "…抱歉，刚刚你说什么？\n我的大脑一片空白…不过，\n正是这种时候才该加倍努力吧。",
      "source_fingerprint": "b606c5158e915d11df24a5afcdc80176a503c93da6b9f21d50cd19a2433efe65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20035"
      ]
    },
    {
      "uid": "zhcn:df4bc4f67740a61e00a740a0",
      "kind": "character_system_text",
      "source_text": "唔哇…净是些了不得的家伙啊。\n不会吧…不安起来了…\n得加油啊，我…！",
      "source_fingerprint": "d55b936aad0b1e516f9d8f8400f98e16a8628f5d671e79ec53c0c1e72fc1c9e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20036"
      ]
    },
    {
      "uid": "zhcn:c7ee8249c6715ab67a520908",
      "kind": "character_system_text",
      "source_text": "这比赛真让人捏一把汗…\n而且我的心跳是不是激烈过头了？\n不妙哇，冷静点啊，我…！",
      "source_fingerprint": "0836f09b75ff6b25bdf50ce2eb3583fe77cf6510828e63cdfcbe8eca444ab41c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20037"
      ]
    },
    {
      "uid": "zhcn:f3c437fd73dc5063b2f9691b",
      "kind": "character_system_text",
      "source_text": "开始了哦。",
      "source_fingerprint": "0e5dfcde96e372b35e2c0fa2c560a96d28c45a21ff1b29a579226d8b6f082159",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
