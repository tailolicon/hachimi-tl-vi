      ]
    },
    {
      "uid": "zhcn:6a7c49b42420561bf5ca46e1",
      "kind": "character_system_text",
      "source_text": "加油啊，我…！",
      "source_fingerprint": "12750c50405149b87b10c466bcd995aaa0b539571aa619578bed96fb8e9da17a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20040"
      ]
    },
    {
      "uid": "zhcn:03b47e0ad100dc40316f9774",
      "kind": "character_system_text",
      "source_text": "那么…",
      "source_fingerprint": "dc8b3bbf8422f96e189bd9ae9705736aadf5c9e12b7881060b16d27deea4060e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20041"
      ]
    },
    {
      "uid": "zhcn:ce09a6225065f4172157928c",
      "kind": "character_system_text",
      "source_text": "唔哇，不会吧？！",
      "source_fingerprint": "c447eb2971f3882bdc971ce020719663cc90b40c84fef8675710de48d5e41439",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20042"
      ]
    },
    {
      "uid": "zhcn:1f3188f8373e6fe42454ea6b",
      "kind": "character_system_text",
      "source_text": "哎呀～…",
      "source_fingerprint": "a23e42df78bed194a37b8847ae0958ff3eebdc0055f8fb342afd5370cc0d93db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20043"
      ]
    },
    {
      "uid": "zhcn:8b466ff0275ec8fceb171666",
      "kind": "character_system_text",
      "source_text": "好，上吧。",
      "source_fingerprint": "38f5f93f1cfca89d72f34a3a7f9ac61c52d07315f86c971e1717995d25ea22cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20046"
      ]
    },
    {
      "uid": "zhcn:7176207105d3643f74823a5d",
      "kind": "character_system_text",
      "source_text": "唔哇，大海啊～！",
      "source_fingerprint": "612f1f692d27ebedffc86e3bfab483bac102120273f3cfd51c57265a74bb35e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0e0ce419be8020e4c29218cd",
      "kind": "character_system_text",
      "source_text": "多亏有你在啊。这可是真心话哦？",
      "source_fingerprint": "fce8fd3a2c32a460ccc7c762890e1dffbab8eea5c2808b4231f382201efc0e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20049"
      ]
    },
    {
      "uid": "zhcn:bbf1a4981e07b4a3ac49283b",
      "kind": "character_system_text",
      "source_text": "呵呵…辛苦啦。",
      "source_fingerprint": "4d306981b54cf2f6519dbd5b702f67a734efb798b1c47cef50096402f055d135",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3b40683a57dc2af5090e0a23",
      "kind": "character_system_text",
      "source_text": "好，试试看吧。",
      "source_fingerprint": "13a69a844dd5888fbae2c69e4346cbc446bac450d79bc31a70a423097b2d8ec3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20051"
      ]
    },
    {
      "uid": "zhcn:d83d52310ca792e4dd4e7673",
      "kind": "character_system_text",
      "source_text": "要和大家一起拿下胜利。",
      "source_fingerprint": "38d488e63eb219bd8a1efe666634c1080df2d39c9041d8d655b58f3251cb81e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2030"
      ]
    },
    {
      "uid": "zhcn:1d3e523b25393a903d3556a0",
      "kind": "character_system_text",
      "source_text": "那就上了哦～",
      "source_fingerprint": "f189b93f17e8e3f90671a71be2d6efcf5b27e5f65f5eb0b293698c36582854df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2031"
      ]
    },
    {
      "uid": "zhcn:b15a095f46c5777336fe02a9",
      "kind": "character_system_text",
      "source_text": "多亏有你在啊。这可是真心话哦？",
      "source_fingerprint": "fce8fd3a2c32a460ccc7c762890e1dffbab8eea5c2808b4231f382201efc0e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2032"
      ]
    },
    {
      "uid": "zhcn:a9c61657454ba2f73f6f0a4f",
      "kind": "character_system_text",
      "source_text": "状态感觉不错，\n之前的训练中也拼尽全力了…\n嗯，鼓起干劲上吧。",
      "source_fingerprint": "b53db368c0c1f0ddf8fdc5b6edc677a1d571cff91dc66c9e5adb86d2c9412f4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b4b51b1ae06df5f4e4e815ca",
      "kind": "character_system_text",
      "source_text": "没关系。我会将我的“真我”，\n在这场比赛中毫无保留地展示出来！\n一定能得到好成绩的！",
      "source_fingerprint": "bd910a881fbdcc891a50c0779559daabac81dde11a8b87135a8448b8bb21efff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2034"
      ]
    },
    {
      "uid": "zhcn:940ba11f83b73c9ccb810714",
      "kind": "character_system_text",
      "source_text": "多亏有你在啊。这可是真心话哦？",
      "source_fingerprint": "fce8fd3a2c32a460ccc7c762890e1dffbab8eea5c2808b4231f382201efc0e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2035"
      ]
    },
    {
      "uid": "zhcn:99ef1c25dd5442f8484cd3ae",
      "kind": "character_system_text",
      "source_text": "始めるよ。",
      "source_fingerprint": "b15870bd26be7b16e7addb4f8b142a7fd1bd947b5c878dd215aa1b719750b0ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "23015"
      ]
    },
    {
      "uid": "zhcn:ffc17d4ff1f21473260466a8",
      "kind": "character_system_text",
      "source_text": "啊，好可惜！下次一定会赢的！",
      "source_fingerprint": "ac80f17605e1a6f3bacf12d478f075235165781c85b126fe30cc10078640bcc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30000"
      ]
    },
    {
      "uid": "zhcn:cb99a3125bd6a447bb558e3a",
      "kind": "character_system_text",
      "source_text": "算是还行吧。但是…还早得很呢！",
      "source_fingerprint": "293797230765c0108874539879a1aef5152024f82bb2380b3e5338038f9b174c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30001"
      ]
    },
    {
      "uid": "zhcn:a3790029926fe9f58bb73f9f",
      "kind": "character_system_text",
      "source_text": "…好！不过，今后也得更努力才行。",
      "source_fingerprint": "9b123428b862a1f9e86a252a94ebb66b8e53ae0c5ebff08abfd451dba90184d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30002"
      ]
    },
    {
      "uid": "zhcn:70bc2188f74280120a85c479",
      "kind": "character_system_text",
      "source_text": "…哈，好逊。",
      "source_fingerprint": "d08f2e5659309ef5e22f3cbfad47a8fc2a1d9c16489488d2da5657785d22cd71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30003"
      ]
    },
    {
      "uid": "zhcn:85a52509e24007e2c5d4a98f",
      "kind": "character_system_text",
      "source_text": "呵呵…怎么样？这就是“我”哦。",
      "source_fingerprint": "eea6120ef49d0c22e2baa15cc801df7d92c8f7dbd5a74e247183872c3e7b11b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30004"
      ]
    },
    {
      "uid": "zhcn:b919d53ace73023bf2dfe362",
      "kind": "character_system_text",
      "source_text": "还不够啊…还得继续进步才行。",
      "source_fingerprint": "e6c3471d091545058c2164e9485f1689eccfe2f504161881dc387b03f2c9b64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30005"
      ]
    },
    {
      "uid": "zhcn:3e49ea2aa944a22840761bcf",
      "kind": "character_system_text",
      "source_text": "这绝不是随波逐流，\n而是凭我自己的努力而站在这里的。",
      "source_fingerprint": "9a3d06f0527f860222437f9a80a309afec4bd1350122681847c9edab62a81c19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30006"
      ]
    },
    {
      "uid": "zhcn:7da026a76d48e9cd8aa4a9b2",
      "kind": "character_system_text",
      "source_text": "还不够啊…还得继续进步才行。",
      "source_fingerprint": "e6c3471d091545058c2164e9485f1689eccfe2f504161881dc387b03f2c9b64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30007"
      ]
    },
    {
      "uid": "zhcn:cad53bff9e2536d4c785b589",
      "kind": "character_system_text",
      "source_text": "看着我的奔跑吧！",
      "source_fingerprint": "97567d77d1278c5e274e1282bad287f90f984ae5fe6e8bdbc466ae8714acfbca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "31000"
      ]
    },
    {
      "uid": "zhcn:a7636d5d41517da181322ee8",
      "kind": "character_system_text",
      "source_text": "好好看着“我”吧！",
      "source_fingerprint": "da88244a2b9add92f8ff953ea235a38acadd328bb73b3480661bc59f684a3f4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40000"
      ]
    },
    {
      "uid": "zhcn:8031faca73dc83ed2fb8e59e",
      "kind": "character_system_text",
      "source_text": "……飞行模式也设定完毕。\r\n抱歉了，阿经。但我……\r\n现在真的很想尽情玩乐！",
      "source_fingerprint": "6e81f8d5a0ec1557f98b359c88bf9938b49e8854c9532f33f2c18fb3e0a6c9d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400001"
      ]
    },
    {
      "uid": "zhcn:7a8fbaadd467196c6331860a",
      "kind": "character_system_text",
      "source_text": "必须得好好面对这个结果。\n今后可不能一直这么逊呢。",
      "source_fingerprint": "3160d95b3b5bb6de6018f780093058387648f1631e049d2b455153ac590f4e59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400004"
      ]
    },
    {
      "uid": "zhcn:815234f1b2259c65430779d3",
      "kind": "character_system_text",
      "source_text": "这条跑道上的主角，是“我”才对…！\n…都好好看着吧——\n以最棒的奔跑，夺下胜利的“我”！",
      "source_fingerprint": "d981e4c95ce785635a819c7da143fa6c2be31a90f3b10e5463584e8e9f095b0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40001"
      ]
    },
    {
      "uid": "zhcn:3a24f4a51da9e2edb24a2739",
      "kind": "character_system_text",
      "source_text": "嗯…我，做到了哦。\n终于能挺起胸膛说出这句话了。",
      "source_fingerprint": "60217c11987b90d04f24970d6f49df0b2d1d6435258601fb1c15b85fcdf15dac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400010"
      ]
    },
    {
      "uid": "zhcn:e395a4fdd73ef59cf952e0d7",
      "kind": "character_system_text",
      "source_text": "好了，别看啥了哦。",
      "source_fingerprint": "ee48298e85e9f45a09b94a68c2b07f0bd8a48f8a2f3092bedebc4a01bcee87b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40003"
      ]
    },
    {
      "uid": "zhcn:3c847047a24166eafea79d2e",
      "kind": "character_system_text",
      "source_text": "嗯…完美。我问你啊，我与飘飞的红叶…\n哪边更为美艳？",
      "source_fingerprint": "1c55ac71898fa210d3fcb6dea592d0124d040fb4ff1c79a003ae06915dcc2117",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40004"
      ]
    },
    {
      "uid": "zhcn:36fefe30d6d3dc5869a329da",
      "kind": "character_system_text",
      "source_text": "买个伴手礼给阿经好了……应该还是\r\n挑美妆产品吧。那个人总是\r\n以工作为优先，把自己摆在后面……",
      "source_fingerprint": "0a00cb602e7714886dfa2f4b7ca42a35521cb0bf4cf1a3af90dc00903918f93c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400054"
      ]
    },
    {
      "uid": "zhcn:534aaca1963faadc105fb2ca",
      "kind": "character_system_text",
      "source_text": "准备万全。上了！",
      "source_fingerprint": "7c7196c95633b8c53d5108f578a7f41f16ab9562a2bade8d5e9c16ddf3fa9f16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "60000"
      ]
    },
    {
      "uid": "zhcn:864dbcf70cefbdec82855f6b",
      "kind": "character_system_text",
      "source_text": "好。这才是重头戏，好好享受哦！",
      "source_fingerprint": "ea180996bb38ae82f60fd93fcccbdec1d635275a6eea38ecbfd296fa005e7157",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "60001"
      ]
    },
    {
      "uid": "zhcn:5ad0fcc08f0eac5d3d6dcb6e",
      "kind": "character_system_text",
      "source_text": "就以我的风格奔跑吧——和你一起。",
      "source_fingerprint": "2856bdbf31d676a9ebda1d1dd100a6f27220ebee1039565dc8c4680b7c4277e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70000"
      ]
    }
  ]
