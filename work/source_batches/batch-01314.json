        "1038",
        "20121"
      ]
    },
    {
      "uid": "zhcn:adf1797f1854045c88ab77a6",
      "kind": "character_system_text",
      "source_text": "……姐姐，机伶的身心状况\r\n确实都管理得滴水不漏。\r\n可是……你做得太过火了！啪！",
      "source_fingerprint": "190acdf85eb329fea88b5fc1cb3a67ce0d3ff0157dcb4a9bf1cada003b78609e",
      "source_path": "character_system_text_dict.json",
