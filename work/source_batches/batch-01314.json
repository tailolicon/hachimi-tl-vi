    },
    {
      "uid": "zhcn:4b5e474ea49b0cb0868dd49b",
      "kind": "character_system_text",
      "source_text": "活动辛苦了。\r\n呵呵，下次该让你见识\r\n哪一种可爱的机伶呢♪",
      "source_fingerprint": "c880b4235517cf05132c05a532558c031e38fda3dcfbef7e7d7d3c9716ce1398",
      "source_path": "character_system_text_dict.json",
      "json_path": [
