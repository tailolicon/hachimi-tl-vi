    {
      "uid": "zhcn:2bd1818d6225babab343e28a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "穿上后既易于跑步，也能尽情跳舞。\n这位设计师还挺能干的嘛。",
