      ]
    },
    {
      "uid": "zhcn:aab2efa1646c59d018cb9b99",
      "kind": "character_system_text",
      "source_text": "嗯嗯，心情好极了！\r\n接着只差姐姐一句「可爱」，\r\n准备的部分就完美无缺了♪",
      "source_fingerprint": "2fdbc2e4e34bc4da68447b9f52658b03bca877af1f46209f7af39e55a51815d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1038",
        "20123"
      ]
    },
    {
      "uid": "zhcn:4f3ae3660cefece3dfd452f5",
      "kind": "character_system_text",
      "source_text": "姐姐，听我说听我说！\r\n机伶……状况可能挺不错的♪\r\n你可以有所期待哦。",
      "source_fingerprint": "3bd599244426fafbb7d3ea1cdfb93f7824c9df56c05ee0f6dee757cda86a3170",
