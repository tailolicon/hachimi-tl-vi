      "kind": "character_system_text",
      "source_text": "发誓和机伶……命运与共♪",
      "source_fingerprint": "d49975e7741b9ebb545cee65a67738abe8f214efbf39165685d2d399a503e0e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
