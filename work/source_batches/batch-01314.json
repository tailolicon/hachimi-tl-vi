      ]
    },
    {
      "uid": "zhcn:ea856c274a92f04d8e8c3f9a",
      "kind": "character_system_text",
      "source_text": "咦～又要比赛？\r\n噗，姐姐真坏心眼。\r\n……之后要给我奖励哦。",
      "source_fingerprint": "24a45bd101236a09fd2c74460ebd0b726195e0e983abb9de7a3d5037f0742e6c",
      "source_path": "character_system_text_dict.json",
