      ],
      "json_pointer": "/1040/91029"
    },
    {
      "uid": "zhcn:e9cf1a4fafcbd87331c6f46a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今天要从什么开始练起？\n说说看你的计划吧。",
      "source_fingerprint": "8a63b3533f16e247885deddc070330de0fc1b2893215567c9b8f96f04a4704c4",
