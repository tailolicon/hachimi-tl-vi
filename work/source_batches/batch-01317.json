      ]
    },
    {
      "uid": "zhcn:4e5cdb4a84887979a34ad4ce",
      "kind": "character_system_text",
      "source_text": "真了不起！",
      "source_fingerprint": "3d7202f6db1322475dc6863ed540625bdd7bcdf5da4a6a9610cfe4f43dfaafcb",
