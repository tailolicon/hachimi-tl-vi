        "1041",
        "91013"
      ],
      "json_pointer": "/1041/91013"
    },
    {
      "uid": "zhcn:e44dd136cf7305265ae1067e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这个时期我都会利用月光来念书。\r\n因为我听说优等生都会这么做。",
      "source_fingerprint": "1aa712d64136eb91065b73f3a9c6fa096253d9d0e9e5df98f9d59522297750ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
