      "json_pointer": "/1041/910100"
    },
    {
      "uid": "zhcn:7b770ebaec162a3fd06f8346",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我两分钟就写完作业了！\r\n就算不看题目，对我来说这也只是\r\n早餐前小试身手！虽然现在是晚上！",
      "source_fingerprint": "2bbb303e009e75f0ad3a7730b85b37220142652614e2ba1ffb9bff26772a2336",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
