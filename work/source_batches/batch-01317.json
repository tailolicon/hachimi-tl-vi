      ],
      "json_pointer": "/1041/91008"
    },
    {
      "uid": "zhcn:c9bc930cca7ef0a1f2589d87",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "最近上学的时候常常遇到小花同学。\r\n因为我们都是坚强独立的人，\r\n所以互相吸引了是吗！",
      "source_fingerprint": "56898ce543d44abeffc250e4478e152a244391ca5e5704669d554c3d1dbbe5fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
