      ]
    },
    {
      "uid": "zhcn:97f9c355ca5e8a973d145008",
      "kind": "character_system_text",
      "source_text": "怎么会……！",
      "source_fingerprint": "a82398b963e7498f9ce33b7b8d2d1a4fc3ccaaf9a0e2461649635cde1312600a",
      "source_path": "character_system_text_dict.json",
