        "91014"
      ],
      "json_pointer": "/1041/91014"
    },
    {
      "uid": "zhcn:cef70b5560332551a36e22ca",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "再冷我也绝不穿厚重的衣服！\r\n因为这样比较轻盈，才能跑比较快！",
      "source_fingerprint": "95c04cdcc6a865833d526bf9297552c44121cbcd3fe5de2877ca0a294c13cbd4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "91015"
      ],
      "json_pointer": "/1041/91015"
    },
    {
      "uid": "zhcn:d29a975dbb3e3f69b6c364d0",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我鞋子上的樱花布贴\r\n和桂冠同学是同一款的！\r\n怎么样，很棒吧！",
      "source_fingerprint": "8af0eccdc15f3e566cb8db20e9d508fc5fc9f187e0fd6d0efa3a7000d4e3bd6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "91016"
      ],
      "json_pointer": "/1041/91016"
    },
    {
      "uid": "zhcn:760b9d4d6c14e1c59cbfd2c8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我常常和波旁同学一起去\r\n自动贩卖机买饮料喝，所以\r\n我很清楚她喜欢喝什么果汁！",
      "source_fingerprint": "2c34439168cab919421c9dace54dbd6ce3fda833e1954f8c97319f504b556d38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "91017"
      ],
      "json_pointer": "/1041/91017"
    },
    {
      "uid": "zhcn:deaee2dcb2a022f8a95733cd",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "诗歌剧同学真是太棒了！\r\n毅力及韧性都相当出类拔萃！\r\n今年的班长奖是她的了！",
      "source_fingerprint": "94e3543881f0c3998b438a46a16330e1466de5a7a88cdac8f84e8576cfb8fde8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
