      ],
      "json_pointer": "/1041/91018"
    },
    {
      "uid": "zhcn:7410a39cbeb7fe9cfcdbc1da",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "生野同学的包包有魔法！\r\n无论是绷带或消毒药水，\r\n任何医疗用品她都能瞬间拿出来！",
      "source_fingerprint": "f6d32b06550f6af53971e9474535999f9dfc5de24bfe7a4f1985259bcdfbd826",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
