      ]
    },
    {
      "uid": "zhcn:ce91e60633ca2cd97d0c73d5",
      "kind": "character_system_text",
      "source_text": "哎呀！",
      "source_fingerprint": "4d27fba32b4cdf632760230caaf4b4d14ee3299721f6e4c735d9a42b03bba61e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1039",
