      ],
      "json_pointer": "/1041/91009"
    },
    {
      "uid": "zhcn:08d5e07c71d3a68b669eea16",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "您问我上午考试的结果啊？\r\n哈哈，别担心，\r\n我很快就会搞定课后辅导的！",
      "source_fingerprint": "8ebb53b1bc262f7d9b03a722a2475ff1260614f76fca0b7449bec926962de7db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
