      ]
    },
    {
      "uid": "zhcn:52d9e94e529fd7e9abe62881",
      "kind": "character_system_text",
      "source_text": "各式各样的story共创了\r\n无数的历史呢。",
      "source_fingerprint": "4ca231b027ed869335d79604d4b750e766c5ad8b4959de970840ba2054e13fb5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1042",
