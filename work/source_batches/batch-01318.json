      ]
    },
    {
      "uid": "zhcn:94c5ab7fd5561dd3e7cbae36",
      "kind": "character_system_text",
      "source_text": "Great ！创下high score了！",
      "source_fingerprint": "872d167d32bdbc48806c1867b83289508a5c6cc725dcbaf013b9c232dbdb78ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1042",
        "1007"
      ]
    },
    {
      "uid": "zhcn:f79e876e18f832c1cd8ac572",
      "kind": "character_system_text",
      "source_text": "Every one！跟我来！",
      "source_fingerprint": "e1cf4250c38dad5c1191be59ee6d83d19289e614bdffefb480b108a396f97897",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1042",
        "1008"
      ]
    },
    {
      "uid": "zhcn:c9f6d72c41120f2855043f3a",
      "kind": "character_system_text",
      "source_text": "目标当然只有一个！",
      "source_fingerprint": "8cc9278b97c3a3827685b0b3af88d1a468d0fc9ef0b1a715310edb1d9afc5339",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1042",
