      ]
    },
    {
      "uid": "zhcn:73d1b7c5069875a7f98777cd",
      "kind": "character_system_text",
      "source_text": "Uh-huh？不赖嘛。",
      "source_fingerprint": "8be8dfb322a0b656add35c674e33a0baa3350b232d7c2d9fc4926eae42125680",
      "source_path": "character_system_text_dict.json",
      "json_path": [
