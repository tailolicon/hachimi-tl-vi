        "11"
      ]
    },
    {
      "uid": "zhcn:750a8b2a1286edee22b08d29",
      "kind": "character_system_text",
      "source_text": "要训练是吧？\r\n你的那份mind非常good！",
      "source_fingerprint": "59d98ff45c3110068c6b04e4f27b42a8c75b43e1cb8bcec4bf4e22fb4d7a46f7",
      "source_path": "character_system_text_dict.json",
