{
  "schema_version": 1,
  "batch": 1321,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:f3c437fd73dc5063b2f9691b",
      "kind": "character_system_text",
      "source_text": "开始了哦。",
      "source_fingerprint": "0e5dfcde96e372b35e2c0fa2c560a96d28c45a21ff1b29a579226d8b6f082159",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20038"
      ]
    },
    {
      "uid": "zhcn:f257ebdbc47d094bf7a5a92f",
      "kind": "character_system_text",
      "source_text": "好，就这么办！",
      "source_fingerprint": "d19fec6884b2e0aaa08795103fb0b21e3da738ad91f2e214034bcbea4c3c4cbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20039"
      ]
    },
    {
      "uid": "zhcn:6a7c49b42420561bf5ca46e1",
      "kind": "character_system_text",
      "source_text": "加油啊，我…！",
      "source_fingerprint": "12750c50405149b87b10c466bcd995aaa0b539571aa619578bed96fb8e9da17a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20040"
      ]
    },
    {
      "uid": "zhcn:03b47e0ad100dc40316f9774",
      "kind": "character_system_text",
      "source_text": "那么…",
      "source_fingerprint": "dc8b3bbf8422f96e189bd9ae9705736aadf5c9e12b7881060b16d27deea4060e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20041"
      ]
    },
    {
      "uid": "zhcn:ce09a6225065f4172157928c",
      "kind": "character_system_text",
      "source_text": "唔哇，不会吧？！",
      "source_fingerprint": "c447eb2971f3882bdc971ce020719663cc90b40c84fef8675710de48d5e41439",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20042"
      ]
    },
    {
      "uid": "zhcn:1f3188f8373e6fe42454ea6b",
      "kind": "character_system_text",
      "source_text": "哎呀～…",
      "source_fingerprint": "a23e42df78bed194a37b8847ae0958ff3eebdc0055f8fb342afd5370cc0d93db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20043"
      ]
    },
    {
      "uid": "zhcn:8b466ff0275ec8fceb171666",
      "kind": "character_system_text",
      "source_text": "好，上吧。",
      "source_fingerprint": "38f5f93f1cfca89d72f34a3a7f9ac61c52d07315f86c971e1717995d25ea22cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20046"
      ]
    },
    {
      "uid": "zhcn:7176207105d3643f74823a5d",
      "kind": "character_system_text",
      "source_text": "唔哇，大海啊～！",
      "source_fingerprint": "612f1f692d27ebedffc86e3bfab483bac102120273f3cfd51c57265a74bb35e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0e0ce419be8020e4c29218cd",
      "kind": "character_system_text",
      "source_text": "多亏有你在啊。这可是真心话哦？",
      "source_fingerprint": "fce8fd3a2c32a460ccc7c762890e1dffbab8eea5c2808b4231f382201efc0e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20049"
      ]
    },
    {
      "uid": "zhcn:bbf1a4981e07b4a3ac49283b",
      "kind": "character_system_text",
      "source_text": "呵呵…辛苦啦。",
      "source_fingerprint": "4d306981b54cf2f6519dbd5b702f67a734efb798b1c47cef50096402f055d135",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3b40683a57dc2af5090e0a23",
      "kind": "character_system_text",
      "source_text": "好，试试看吧。",
      "source_fingerprint": "13a69a844dd5888fbae2c69e4346cbc446bac450d79bc31a70a423097b2d8ec3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "20051"
      ]
    },
    {
      "uid": "zhcn:d83d52310ca792e4dd4e7673",
      "kind": "character_system_text",
      "source_text": "要和大家一起拿下胜利。",
      "source_fingerprint": "38d488e63eb219bd8a1efe666634c1080df2d39c9041d8d655b58f3251cb81e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2030"
      ]
    },
    {
      "uid": "zhcn:1d3e523b25393a903d3556a0",
      "kind": "character_system_text",
      "source_text": "那就上了哦～",
      "source_fingerprint": "f189b93f17e8e3f90671a71be2d6efcf5b27e5f65f5eb0b293698c36582854df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2031"
      ]
    },
    {
      "uid": "zhcn:b15a095f46c5777336fe02a9",
      "kind": "character_system_text",
      "source_text": "多亏有你在啊。这可是真心话哦？",
      "source_fingerprint": "fce8fd3a2c32a460ccc7c762890e1dffbab8eea5c2808b4231f382201efc0e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2032"
      ]
    },
    {
      "uid": "zhcn:a9c61657454ba2f73f6f0a4f",
      "kind": "character_system_text",
      "source_text": "状态感觉不错，\n之前的训练中也拼尽全力了…\n嗯，鼓起干劲上吧。",
      "source_fingerprint": "b53db368c0c1f0ddf8fdc5b6edc677a1d571cff91dc66c9e5adb86d2c9412f4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b4b51b1ae06df5f4e4e815ca",
      "kind": "character_system_text",
      "source_text": "没关系。我会将我的“真我”，\n在这场比赛中毫无保留地展示出来！\n一定能得到好成绩的！",
      "source_fingerprint": "bd910a881fbdcc891a50c0779559daabac81dde11a8b87135a8448b8bb21efff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2034"
      ]
    },
    {
      "uid": "zhcn:940ba11f83b73c9ccb810714",
      "kind": "character_system_text",
      "source_text": "多亏有你在啊。这可是真心话哦？",
      "source_fingerprint": "fce8fd3a2c32a460ccc7c762890e1dffbab8eea5c2808b4231f382201efc0e50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "2035"
      ]
    },
    {
      "uid": "zhcn:99ef1c25dd5442f8484cd3ae",
      "kind": "character_system_text",
      "source_text": "始めるよ。",
      "source_fingerprint": "b15870bd26be7b16e7addb4f8b142a7fd1bd947b5c878dd215aa1b719750b0ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "23015"
      ]
    },
    {
      "uid": "zhcn:ffc17d4ff1f21473260466a8",
      "kind": "character_system_text",
      "source_text": "啊，好可惜！下次一定会赢的！",
      "source_fingerprint": "ac80f17605e1a6f3bacf12d478f075235165781c85b126fe30cc10078640bcc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30000"
      ]
    },
    {
      "uid": "zhcn:cb99a3125bd6a447bb558e3a",
      "kind": "character_system_text",
      "source_text": "算是还行吧。但是…还早得很呢！",
      "source_fingerprint": "293797230765c0108874539879a1aef5152024f82bb2380b3e5338038f9b174c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30001"
      ]
    },
    {
      "uid": "zhcn:a3790029926fe9f58bb73f9f",
      "kind": "character_system_text",
      "source_text": "…好！不过，今后也得更努力才行。",
      "source_fingerprint": "9b123428b862a1f9e86a252a94ebb66b8e53ae0c5ebff08abfd451dba90184d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30002"
      ]
    },
    {
      "uid": "zhcn:70bc2188f74280120a85c479",
      "kind": "character_system_text",
      "source_text": "…哈，好逊。",
      "source_fingerprint": "d08f2e5659309ef5e22f3cbfad47a8fc2a1d9c16489488d2da5657785d22cd71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30003"
      ]
    },
    {
      "uid": "zhcn:85a52509e24007e2c5d4a98f",
      "kind": "character_system_text",
      "source_text": "呵呵…怎么样？这就是“我”哦。",
      "source_fingerprint": "eea6120ef49d0c22e2baa15cc801df7d92c8f7dbd5a74e247183872c3e7b11b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30004"
      ]
    },
    {
      "uid": "zhcn:b919d53ace73023bf2dfe362",
      "kind": "character_system_text",
      "source_text": "还不够啊…还得继续进步才行。",
      "source_fingerprint": "e6c3471d091545058c2164e9485f1689eccfe2f504161881dc387b03f2c9b64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30005"
      ]
    },
    {
      "uid": "zhcn:3e49ea2aa944a22840761bcf",
      "kind": "character_system_text",
      "source_text": "这绝不是随波逐流，\n而是凭我自己的努力而站在这里的。",
      "source_fingerprint": "9a3d06f0527f860222437f9a80a309afec4bd1350122681847c9edab62a81c19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30006"
      ]
    },
    {
      "uid": "zhcn:7da026a76d48e9cd8aa4a9b2",
      "kind": "character_system_text",
      "source_text": "还不够啊…还得继续进步才行。",
      "source_fingerprint": "e6c3471d091545058c2164e9485f1689eccfe2f504161881dc387b03f2c9b64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "30007"
      ]
    },
    {
      "uid": "zhcn:cad53bff9e2536d4c785b589",
      "kind": "character_system_text",
      "source_text": "看着我的奔跑吧！",
      "source_fingerprint": "97567d77d1278c5e274e1282bad287f90f984ae5fe6e8bdbc466ae8714acfbca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "31000"
      ]
    },
    {
      "uid": "zhcn:a7636d5d41517da181322ee8",
      "kind": "character_system_text",
      "source_text": "好好看着“我”吧！",
      "source_fingerprint": "da88244a2b9add92f8ff953ea235a38acadd328bb73b3480661bc59f684a3f4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40000"
      ]
    },
    {
      "uid": "zhcn:8031faca73dc83ed2fb8e59e",
      "kind": "character_system_text",
      "source_text": "……飞行模式也设定完毕。\r\n抱歉了，阿经。但我……\r\n现在真的很想尽情玩乐！",
      "source_fingerprint": "6e81f8d5a0ec1557f98b359c88bf9938b49e8854c9532f33f2c18fb3e0a6c9d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400001"
      ]
    },
    {
      "uid": "zhcn:7a8fbaadd467196c6331860a",
      "kind": "character_system_text",
      "source_text": "必须得好好面对这个结果。\n今后可不能一直这么逊呢。",
      "source_fingerprint": "3160d95b3b5bb6de6018f780093058387648f1631e049d2b455153ac590f4e59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400004"
      ]
    },
    {
      "uid": "zhcn:815234f1b2259c65430779d3",
      "kind": "character_system_text",
      "source_text": "这条跑道上的主角，是“我”才对…！\n…都好好看着吧——\n以最棒的奔跑，夺下胜利的“我”！",
      "source_fingerprint": "d981e4c95ce785635a819c7da143fa6c2be31a90f3b10e5463584e8e9f095b0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40001"
      ]
    },
    {
      "uid": "zhcn:3a24f4a51da9e2edb24a2739",
      "kind": "character_system_text",
      "source_text": "嗯…我，做到了哦。\n终于能挺起胸膛说出这句话了。",
      "source_fingerprint": "60217c11987b90d04f24970d6f49df0b2d1d6435258601fb1c15b85fcdf15dac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400010"
      ]
    },
    {
      "uid": "zhcn:e395a4fdd73ef59cf952e0d7",
      "kind": "character_system_text",
      "source_text": "好了，别看啥了哦。",
      "source_fingerprint": "ee48298e85e9f45a09b94a68c2b07f0bd8a48f8a2f3092bedebc4a01bcee87b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40003"
      ]
    },
    {
      "uid": "zhcn:3c847047a24166eafea79d2e",
      "kind": "character_system_text",
      "source_text": "嗯…完美。我问你啊，我与飘飞的红叶…\n哪边更为美艳？",
      "source_fingerprint": "1c55ac71898fa210d3fcb6dea592d0124d040fb4ff1c79a003ae06915dcc2117",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "40004"
      ]
    },
    {
      "uid": "zhcn:36fefe30d6d3dc5869a329da",
      "kind": "character_system_text",
      "source_text": "买个伴手礼给阿经好了……应该还是\r\n挑美妆产品吧。那个人总是\r\n以工作为优先，把自己摆在后面……",
      "source_fingerprint": "0a00cb602e7714886dfa2f4b7ca42a35521cb0bf4cf1a3af90dc00903918f93c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "400054"
      ]
    },
    {
      "uid": "zhcn:534aaca1963faadc105fb2ca",
      "kind": "character_system_text",
      "source_text": "准备万全。上了！",
      "source_fingerprint": "7c7196c95633b8c53d5108f578a7f41f16ab9562a2bade8d5e9c16ddf3fa9f16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "60000"
      ]
    },
    {
      "uid": "zhcn:864dbcf70cefbdec82855f6b",
      "kind": "character_system_text",
      "source_text": "好。这才是重头戏，好好享受哦！",
      "source_fingerprint": "ea180996bb38ae82f60fd93fcccbdec1d635275a6eea38ecbfd296fa005e7157",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "60001"
      ]
    },
    {
      "uid": "zhcn:5ad0fcc08f0eac5d3d6dcb6e",
      "kind": "character_system_text",
      "source_text": "就以我的风格奔跑吧——和你一起。",
      "source_fingerprint": "2856bdbf31d676a9ebda1d1dd100a6f27220ebee1039565dc8c4680b7c4277e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70000"
      ]
    },
    {
      "uid": "zhcn:d3a281a44f3829da1cc28c04",
      "kind": "character_system_text",
      "source_text": "没想到你会成为我的训练员啊…\n嘛，也还行吧，\n经纪人好像也认同你了。",
      "source_fingerprint": "fe6e58728b5a301798d5eb2bff8abdba04bdb2b158aa7f0b083f11a8659297e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70001"
      ]
    },
    {
      "uid": "zhcn:412fdee483b60a1e00d4a3d2",
      "kind": "character_system_text",
      "source_text": "呵呵呵…\n要是穿这身去现场的话，大家都会大吃一惊呢。",
      "source_fingerprint": "ceebfc875a6c6310f07b5fe790de66870e0ddf31d1eb27da851e7d60a5444a88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70004"
      ]
    },
    {
      "uid": "zhcn:2bd1818d6225babab343e28a",
      "kind": "character_system_text",
      "source_text": "穿上后既易于跑步，也能尽情跳舞。\n这位设计师还挺能干的嘛。",
      "source_fingerprint": "f7292e1972842fe2ad0b65d386ec80b22d810c722409d76043762f32539a9ce7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70008"
      ]
    },
    {
      "uid": "zhcn:89e8a8074ab6c6619b734cd0",
      "kind": "character_system_text",
      "source_text": "这是象征着“真我”的衣服…\n里面包含着我的心意呢。",
      "source_fingerprint": "77ead678043cc08a474a4a557136ecc330ab1f828ab4c6a86d97a1fe8f5048c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70009"
      ]
    },
    {
      "uid": "zhcn:5d0d6fddcbb8cd9d7ee4c9a1",
      "kind": "character_system_text",
      "source_text": "得注意着装礼仪规范呢～\n毕竟室友是风纪委员长大人啊。",
      "source_fingerprint": "6a7837c5035ab242b322716520e5b502f23164234bcdd9121896efa13d06ea65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70010"
      ]
    },
    {
      "uid": "zhcn:6b43b6bb44955a7d15cb42c3",
      "kind": "character_system_text",
      "source_text": "和大家一样的衣服呢。\n这里才是真正的起跑线啊。",
      "source_fingerprint": "1ddcc4aba7193a528c6a0ddcea0203f8ff0024f51b752b35200fba70509d15ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70014"
      ]
    },
    {
      "uid": "zhcn:54969ea9b3aea6b1bb4eadb2",
      "kind": "character_system_text",
      "source_text": "决定了。\n让经纪人也目睹一下我赛场上的身姿吧。",
      "source_fingerprint": "d108ab584537e72101a6c5af17f08d65f682fdfae2136267cb4bb3350c1d558c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70015"
      ]
    },
    {
      "uid": "zhcn:511eee00b1e1fbb2dcd32f1b",
      "kind": "character_system_text",
      "source_text": "在舞动的时候，\n袖子和下摆都会随风飘舞呢！…哈？\n我才不会因为这种事情就开心呢。",
      "source_fingerprint": "ad2f8bc8a2e02772a1b4ab69fdded3ef24d1cc5f4096701a3f3eee3d1f34c315",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70016"
      ]
    },
    {
      "uid": "zhcn:02537c7d81ae36c96cd13aa3",
      "kind": "character_system_text",
      "source_text": "你看见这下摆的设计了吗？就连脚边的设计\n也没落下，这种渐变色很漂亮对吧。",
      "source_fingerprint": "a284080ae81dbec254d65b454e1c91a24088c6417d457133544c9e12a77dda1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70017"
      ]
    },
    {
      "uid": "zhcn:213961ba171c5339f5e2ab7f",
      "kind": "character_system_text",
      "source_text": "好棒！",
      "source_fingerprint": "106d9fb0b65401b4a93353c62b64a274e2ccd23376f9b2ab25c84cb68a69582f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70018"
      ]
    },
    {
      "uid": "zhcn:91cb50ca81c9e0d577b24252",
      "kind": "character_system_text",
      "source_text": "好好注视着我奔跑的身姿吧！",
      "source_fingerprint": "0f8f4249e1b88f26f62550110e24fdd6ea103427fdfe46453dec3b47842c6276",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70019"
      ]
    },
    {
      "uid": "zhcn:15a8174ac6af024961610e3f",
      "kind": "character_system_text",
      "source_text": "毕竟我是个模特儿，\r\n私生活也是要毫无破绽。",
      "source_fingerprint": "5d97cc43f510bd2d4ccdccd5a27de045109c8476d44437176a033d405c9352d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70020"
      ]
    },
    {
      "uid": "zhcn:e822dbebcf25663bf0fc1cd1",
      "kind": "character_system_text",
      "source_text": "长度和剪裁都很完美对吧？\r\n我很清楚自己最适合什么衣服。",
      "source_fingerprint": "70c26339d331ca5ed43c1d5eccc1664e48e5695df15f54f1f71c06461712d706",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "70021"
      ]
    },
    {
      "uid": "zhcn:e07030722dde2f0465b6a633",
      "kind": "character_system_text",
      "source_text": "呵呵呵…\n要是穿这身去现场的话，大家都会大吃一惊呢。",
      "source_fingerprint": "ceebfc875a6c6310f07b5fe790de66870e0ddf31d1eb27da851e7d60a5444a88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71004"
      ]
    },
    {
      "uid": "zhcn:726ef3ab6ad5332befd4bc6d",
      "kind": "character_system_text",
      "source_text": "穿上后既易于跑步，也能尽情跳舞。\n这位设计师还挺能干的嘛。",
      "source_fingerprint": "f7292e1972842fe2ad0b65d386ec80b22d810c722409d76043762f32539a9ce7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71008"
      ]
    },
    {
      "uid": "zhcn:52d119f89ba0b2c416bde48c",
      "kind": "character_system_text",
      "source_text": "这是象征着“真我”的衣服…\n里面包含着我的心意呢。",
      "source_fingerprint": "77ead678043cc08a474a4a557136ecc330ab1f828ab4c6a86d97a1fe8f5048c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71009"
      ]
    },
    {
      "uid": "zhcn:300a951ba6fe2c30d4ad7539",
      "kind": "character_system_text",
      "source_text": "得注意着装礼仪规范呢～\n毕竟室友是风纪委员长大人啊。",
      "source_fingerprint": "6a7837c5035ab242b322716520e5b502f23164234bcdd9121896efa13d06ea65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71010"
      ]
    },
    {
      "uid": "zhcn:09743f66cb15029b79f631c7",
      "kind": "character_system_text",
      "source_text": "和大家一样的衣服呢。\n这里才是真正的起跑线啊。",
      "source_fingerprint": "1ddcc4aba7193a528c6a0ddcea0203f8ff0024f51b752b35200fba70509d15ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71014"
      ]
    },
    {
      "uid": "zhcn:185c0671e13110f4d28961fc",
      "kind": "character_system_text",
      "source_text": "决定了。\n让经纪人也目睹一下我赛场上的身姿吧。",
      "source_fingerprint": "d108ab584537e72101a6c5af17f08d65f682fdfae2136267cb4bb3350c1d558c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71015"
      ]
    },
    {
      "uid": "zhcn:818d0c371147f08d358f1075",
      "kind": "character_system_text",
      "source_text": "在舞动的时候，\n袖子和下摆都会随风飘舞呢！…哈？\n我才不会因为这种事情就开心呢。",
      "source_fingerprint": "ad2f8bc8a2e02772a1b4ab69fdded3ef24d1cc5f4096701a3f3eee3d1f34c315",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71016"
      ]
    },
    {
      "uid": "zhcn:cc2611ef8df97b9d12103fd5",
      "kind": "character_system_text",
      "source_text": "你看见这下摆的设计了吗？就连脚边的设计\n也没落下，这种渐变色很漂亮对吧。",
      "source_fingerprint": "a284080ae81dbec254d65b454e1c91a24088c6417d457133544c9e12a77dda1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71017"
      ]
    },
    {
      "uid": "zhcn:497af121346fa8fec8b2262d",
      "kind": "character_system_text",
      "source_text": "好棒！",
      "source_fingerprint": "106d9fb0b65401b4a93353c62b64a274e2ccd23376f9b2ab25c84cb68a69582f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71018"
      ]
    },
    {
      "uid": "zhcn:db8b3c538cd814eb82323375",
      "kind": "character_system_text",
      "source_text": "好好注视着我奔跑的身姿吧！",
      "source_fingerprint": "0f8f4249e1b88f26f62550110e24fdd6ea103427fdfe46453dec3b47842c6276",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "71019"
      ]
    },
    {
      "uid": "zhcn:718ad119d09070849d706f1c",
      "kind": "character_system_text",
      "source_text": "お疲れ",
      "source_fingerprint": "edc815c5e1c17c5c8f9166c714fa758e6cd4105c119f858c91288bccbf9a9d85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "80000"
      ]
    },
    {
      "uid": "zhcn:52c2555a135e77cd94d8f5fc",
      "kind": "character_system_text",
      "source_text": "アタシの走りで、魅せてやるから！",
      "source_fingerprint": "435141b91e3c485fdcd5980fd96b8136631d70856ddd48a68f4ca2f819ffa635",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "800000"
      ]
    },
    {
      "uid": "zhcn:ec1fb23f62b359dfb3557313",
      "kind": "character_system_text",
      "source_text": "想和我一起跑跑看？\n…正有此意呢。\n我也有这个打算来着。",
      "source_fingerprint": "0197a9d9711410950e9b07d670625cbb89fb5f0b085c328be3b2d806c79297c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "81000"
      ]
    },
    {
      "uid": "zhcn:0fae597e9279e7b023e7227a",
      "kind": "character_system_text",
      "source_text": "这下变得有趣起来了啊。\n不过有言在先，我可不会输哦。",
      "source_fingerprint": "72f3ef281830add06a063a17bafa78da39fdeae187f7f1746af38380d7defc16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "81001"
      ]
    },
    {
      "uid": "zhcn:c26292c88e079106c045bd2d",
      "kind": "character_system_text",
      "source_text": "……呼哇。\n早啊。今天也加把劲训练吧。\n…虽然还是很想睡觉啦。",
      "source_fingerprint": "8991d649689e7e7e841f9ca4bb87c138998f6378e3894474fb600b8e653e1475",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90000"
      ]
    },
    {
      "uid": "zhcn:7d52c55e4c816b7ceddb2024",
      "kind": "character_system_text",
      "source_text": "…怎么了？有什么事吗？\n你别一大早就盯着人家看啊…\n好好，我已经很清醒了哦～",
      "source_fingerprint": "f663af44527e9a084cc61980791f06d2064b2cf4abcf8c9a91bb2ba9ad2595b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90001"
      ]
    },
    {
      "uid": "zhcn:11906065ab4830bcd91157d9",
      "kind": "character_system_text",
      "source_text": "今天打算怎么安排？\n已经是下午了哦。",
      "source_fingerprint": "91d7062e23cf905008d3d609638c026fb606ce25d07c06b99ade8d8a6a5ff939",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90002"
      ]
    },
    {
      "uid": "zhcn:c8c403bf76810d6f43f5baaa",
      "kind": "character_system_text",
      "source_text": "趁着太阳高挂的时候赶紧训练吧。\n要做的事情那么多，\n但时间却很少哦？",
      "source_fingerprint": "4076e9efce560a087b0086fa49788383b85651dcb750cf5915847994def73a2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90003"
      ]
    },
    {
      "uid": "zhcn:66a43d6737160ad6758e12bb",
      "kind": "character_system_text",
      "source_text": "唔哇？！怎么已经这时候了？！\n真的一眨眼就过去一天了啊。\n要是一天有48小时就好了…",
      "source_fingerprint": "91454be8ba34af02d69db2a55069dd4d5ba74811dc4c6d8a962e9581a7437e72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90004"
      ]
    },
    {
      "uid": "zhcn:52a0afce9c8517afcb3eb354",
      "kind": "character_system_text",
      "source_text": "差不多也该回去了吧。\n还得为明天的事情做准备呢，\n省得明天一大早就慌慌张张的。",
      "source_fingerprint": "8ffe4a897c46c27c7dad2c3464516b37b1854686c063c24c75314b2991707b5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90005"
      ]
    },
    {
      "uid": "zhcn:0089c258ff80e1e71c6998a8",
      "kind": "character_system_text",
      "source_text": "好烦啊，该怎么办呢…\n好想去春季甜品节玩啊…\n但要真去的了话也挺不妙的吧…",
      "source_fingerprint": "7f89c12f6e1a604e9dd4288c34173e74a633727b5ca86a92705386c5b996a4f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90006"
      ]
    },
    {
      "uid": "zhcn:614eecd6824ebf36b9c583d0",
      "kind": "character_system_text",
      "source_text": "涂防晒霜的方法还蛮多的。\n防晒霜不仅分为面部用和身体用，\n还得不厌其烦地反复涂抹呢！",
      "source_fingerprint": "e0fd7835116bdfe5e4835e12466178f31d0870754a4aee0d74e6c8da5d27e359",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90007"
      ]
    },
    {
      "uid": "zhcn:a4a65f4860c77076fc07f285",
      "kind": "character_system_text",
      "source_text": "这个时期总是会出很多衣服啊！\n虽然没法把拍过广告的衣服全都买下\n来，但却是有不少中意的衣服啊…",
      "source_fingerprint": "3e6639fed2840fe6d02cff4037af39b369f7321fea92087a7ad490fe1bfee750",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90008"
      ]
    },
    {
      "uid": "zhcn:4bc0f5e010fff5a4059b13f6",
      "kind": "character_system_text",
      "source_text": "这啥啊不行！完全不行！\n啊…我说的是冬季新品的事情，\n没在说你啦。",
      "source_fingerprint": "d8bea3315f67cef34fb65366ccf96a454abf0e7cb5b0b3f2672b191e9c5a859f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90009"
      ]
    },
    {
      "uid": "zhcn:dc9bf00d2b303eeabcef3ba5",
      "kind": "character_system_text",
      "source_text": "…我醒着的哦。穿着这么多东西\n真的很难睡…咕。\n…你什么都没看见，对吧？",
      "source_fingerprint": "5a0bcc9f454d62e0ca18bc4e345c85aa5271e95652fa87a3704e209350a51950",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90010"
      ]
    },
    {
      "uid": "zhcn:66fee9d1f1cccb4f89879918",
      "kind": "character_system_text",
      "source_text": "只要跳起舞来，脑袋就立马清醒了。\n果然生命在于运动啊。",
      "source_fingerprint": "f111f34ddc01a39dcae7e977e980c5a07e5bce3ae250cb49f03e8c6526ffc4c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90011"
      ]
    },
    {
      "uid": "zhcn:029a800482823c48e58af21b",
      "kind": "character_system_text",
      "source_text": "穿着这身衣服吃东西还挺方便的呢。\n但我也许会太在意自己的行为举止，\n紧张到没法吃进嘴里去…",
      "source_fingerprint": "eed538ee5c396b4e089c49be7e8deb0fbd7b909e97eefcc6b4c321267f173de5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90012"
      ]
    },
    {
      "uid": "zhcn:9412c06330cb2dc46fc58d37",
      "kind": "character_system_text",
      "source_text": "这个时间的阳光很舒适呢…\n偶尔也放空大脑去散散步如何呢…",
      "source_fingerprint": "2d066d231611c23ca61754dfba4b26f6592af93c743db6669ce5fe5fbfa5b8e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90013"
      ]
    },
    {
      "uid": "zhcn:879ebee82c7bfdb825c360be",
      "kind": "character_system_text",
      "source_text": "总觉得大家在集训时特别闹腾啊。\n…我才没觉得寂寞哦。\n真没觉得寂寞。说了没有啦！",
      "source_fingerprint": "651f624c9b48d71914caa06d02accab2ba1458d22d5f39f4cf94f65a59a3e609",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1040",
        "90014"
      ]
    }
  ]
}
