  "entries": [
    {
      "uid": "zhcn:090560094696bd4c38a9f5d0",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "12"
      ]
    },
    {
      "uid": "zhcn:8dd71012f563a4d76a98238e",
      "kind": "character_system_text",
      "source_text": "觉得轻飘飘的喔！",
      "source_fingerprint": "bfaa08b04c1cb40f3b90266115d8dbd430d664ea7422ff4f04e21bf08a7e153e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "120000"
      ]
    },
    {
      "uid": "zhcn:2248afa8f65e176487e1ad5e",
      "kind": "character_system_text",
      "source_text": "哼，\r\n这是今天的登录奖励啦！",
      "source_fingerprint": "f3d3e8e1bcb40871b7f19a8517090516f78e47ab2ca617a7b14a8ade11a240a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "13"
      ]
    },
    {
      "uid": "zhcn:c33687f799f50fd8c9873747",
      "kind": "character_system_text",
      "source_text": "选定猎物～～",
      "source_fingerprint": "75cf4ae9528fb2121cfe2a3c8569e7709c08edd7ca072f394ffc9a5ca56f058e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140000"
      ]
    },
    {
      "uid": "zhcn:d400e2295654c1f7f1866346",
      "kind": "character_system_text",
      "source_text": "一口咬──！",
      "source_fingerprint": "a8960563294bbd4a85223795984d374606bd4bc8f26e9f5f7dadd6d3a3272e4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140001"
      ]
    },
    {
      "uid": "zhcn:fa69162df208a53c112b57a9",
      "kind": "character_system_text",
      "source_text": "什么──！？",
      "source_fingerprint": "84cefedf3026777717bb19c3c3e1f76a85e69ddf8613e3b0824139ea338f38c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140002"
      ]
    },
    {
      "uid": "zhcn:2c7637425358cf82513d4e82",
      "kind": "character_system_text",
      "source_text": "哇啊啊！一次得到好多喔！",
      "source_fingerprint": "ce4f0359ba375e6106c7969eb99e95b988c376f600c0cb5732e26a93a6c49ca0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140003"
      ]
    },
    {
      "uid": "zhcn:3a64db9153e4f203b96fd0dd",
      "kind": "character_system_text",
      "source_text": "还算可以啦！",
      "source_fingerprint": "0c494748638462e6c7c5a53dfb71855ba0ebf78f57559bb99da0c45727dd021a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140004"
      ]
    },
    {
      "uid": "zhcn:45cd564a9491414d72429548",
      "kind": "character_system_text",
      "source_text": "这没用的笨爪子……！",
      "source_fingerprint": "3786f5e15a540cf33852a13a6f5a42ca0a51c1f832e213d703876d8918e1674e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140005"
      ]
    },
    {
      "uid": "zhcn:0c59721e9ae2e8b1cb40733f",
      "kind": "character_system_text",
      "source_text": "哇啊啊！一次得到好多！",
      "source_fingerprint": "4a0eedd39fb6989b3f5811d09737b8670faa6712eb5b0978be6ea0372407b2d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140006"
      ]
    },
    {
      "uid": "zhcn:5070e55d8c2575567b26e658",
      "kind": "character_system_text",
      "source_text": "还算可以啦！",
      "source_fingerprint": "0c494748638462e6c7c5a53dfb71855ba0ebf78f57559bb99da0c45727dd021a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140007"
      ]
    },
    {
      "uid": "zhcn:6da60f1d73ee33b71c92aabb",
      "kind": "character_system_text",
      "source_text": "嗯？",
      "source_fingerprint": "8af85ce981d9ec89ad4d75b1bd062ebe03e9f22dc5edb7cd9b8099f05574c6c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140008"
      ]
    },
    {
      "uid": "zhcn:cc3482168f3aa135f79ca21e",
      "kind": "character_system_text",
      "source_text": "不要看旁边！",
      "source_fingerprint": "93ca07e5726d24a7fa14d08823b4353cf796d41101e511e863f4b0b32ab9d80c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140009"
      ]
    },
    {
      "uid": "zhcn:a0e87869d751f303030cf82e",
      "kind": "character_system_text",
      "source_text": "这猎物真不赖……",
      "source_fingerprint": "d6407f11977157298e8f66f0d4a72fd7f64ff989b630254f00af44959d709c75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140010"
      ]
    },
    {
      "uid": "zhcn:b476b535491c45c4ba76fd05",
      "kind": "character_system_text",
      "source_text": "好厉害！好厉害喔！",
      "source_fingerprint": "050d239cce742cc6cbba408bdd08a42fda0ac337379585e2723b86d9ba662cc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140011"
      ]
    },
    {
      "uid": "zhcn:5f533f2f88168b587c9ea60f",
      "kind": "character_system_text",
      "source_text": "风风要开动了喔。",
      "source_fingerprint": "d85606a20ef155cc4b330887198b43d926a62551ac8702f6f641eae38c104968",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140012"
      ]
    },
    {
      "uid": "zhcn:cfe4a26901c0651be93a7cc4",
      "kind": "character_system_text",
      "source_text": "嘿嘿──！",
      "source_fingerprint": "c74a893056d7c6cb8cd1150d45d81b5b543663e480b861a81ce0059d7b42a2c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140013"
      ]
    },
    {
      "uid": "zhcn:e713934abbb275679a618104",
      "kind": "character_system_text",
      "source_text": "咦咦咦！？",
      "source_fingerprint": "c4acb606868c6b2cb7fdf6200516af964ffed2242d1496e84037e834dd2ea1ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b2a1513768f2fe269d385ea2",
      "kind": "character_system_text",
      "source_text": "我咬我咬……",
      "source_fingerprint": "9fc9edd15996826b889d90cfdb938cf898cee72abf2d1d659c9e021560b940fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140015"
      ]
    },
    {
      "uid": "zhcn:9b533724ef379b51c16120b4",
      "kind": "character_system_text",
      "source_text": "……不怕被咬吗？",
      "source_fingerprint": "1843992521f5eb88db1111e2cc5bfe487f9d14fd4ba72bde47681bc05df9ab6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140016"
      ]
    },
    {
      "uid": "zhcn:5cb99fdcb1d1d685b990337e",
      "kind": "character_system_text",
      "source_text": "原来只是轻咬喔──！？",
      "source_fingerprint": "e60ace147c11c3476480739140c9a8da01bd07573b4b4074d97d7f2ad899e647",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140017"
      ]
    },
    {
      "uid": "zhcn:e81a6f559fa795380f88e77f",
      "kind": "character_system_text",
      "source_text": "太失望啦──！",
      "source_fingerprint": "ce41a0c25e93e12a5612f0f58343b93bb5ea2f520f0744b6662689b854f9752c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "140018"
      ]
    },
    {
      "uid": "zhcn:78e7507536f143ca1a1d5bbb",
      "kind": "character_system_text",
      "source_text": "明天就给你这个吧。",
      "source_fingerprint": "921bb110a639e5407c870c930577539fc22d85fb949b0d1edcf5015d10d950fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "15"
      ]
    },
    {
      "uid": "zhcn:b79835248839693e35ebd332",
      "kind": "character_system_text",
      "source_text": "风风不要训练！\r\n要～休～息～啦～！！",
      "source_fingerprint": "a2d21ee0bd8c710f35d3852f642a99990f7f85b6b7d02ccb3fce2b41d02e9fc1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20000"
      ]
    },
    {
      "uid": "zhcn:92d58b0b1a050c39aadbe02f",
      "kind": "character_system_text",
      "source_text": "训练员……你好像比风风\r\n更有精神喔……太嚣张了喔……！",
      "source_fingerprint": "0600582ef3b26cf3ac15597e9cf97d7d841d998e266734e1ffe197a2bed8c199",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20001"
      ]
    },
    {
      "uid": "zhcn:9a5c42d2503523f6ecd529e4",
      "kind": "character_system_text",
      "source_text": "今天的风风跟平常不太一样，\r\n不，是很不一样喔！！",
      "source_fingerprint": "9ae54c006bd88bfe5984dc1949e9dac709489acccceee0bc98295c66ad5da01f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20002"
      ]
    },
    {
      "uid": "zhcn:591ae89e453f621a4741f538",
      "kind": "character_system_text",
      "source_text": "看啊！这副利齿！\r\n闪闪发光的喔～！",
      "source_fingerprint": "fa49939bba513650d2a948fc417ca295561216ca1854ffeb460dfc7cebdbbe6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20003"
      ]
    },
    {
      "uid": "zhcn:7bff9eb199475cb6b107486d",
      "kind": "character_system_text",
      "source_text": "风风可是丢下功课\r\n立～刻赶来你身边的喔！\r\n快感谢风风吧～♪",
      "source_fingerprint": "244260f6025d13d3746ff949083b675f83c2bb4a8e7c96f79aedad332c1f5532",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20004"
      ]
    },
    {
      "uid": "zhcn:b58425c57cb52ebdb7f2fd7a",
      "kind": "character_system_text",
      "source_text": "要是这家伙\r\n掉进这个地洞陷阱……\r\n噗噗噗，一定很好笑喔！",
      "source_fingerprint": "759885cf22cfbc7e743ad5bce63ebc6114b4a245dfc846bce5613c6b0ed53fac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20005"
      ]
    },
    {
      "uid": "zhcn:fcf80b1533b2fb7c7aed7621",
      "kind": "character_system_text",
      "source_text": "风风早就做完伸展运动了喔。\r\n事前准备很重要，\r\n风风有在恶作剧所以非常清楚喔！",
      "source_fingerprint": "5312841117ee6cf9f408eee624b2dcc58b9e119bee7c229cb6c93d1163de0c8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20006"
      ]
    },
    {
      "uid": "zhcn:4029989192558986f4a8b413",
      "kind": "character_system_text",
      "source_text": "要是敢排些无聊的行程，\r\n风风就要惩罚你喔！",
      "source_fingerprint": "995db53074f980fbf1548cbf4382aebedcb08afc571189057df77ea330d6e636",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20007"
      ]
    },
    {
      "uid": "zhcn:57a662a7c75d9c7b1be3e137",
      "kind": "character_system_text",
      "source_text": "讨厌讨厌讨厌！\r\n这样下去根本\r\n没人会注目风风啦～！",
      "source_fingerprint": "709a0aa226efd07d83c8c57d4be3a8ffaec82c9feb6a8addee91da6da3dc1f74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20008"
      ]
    },
    {
      "uid": "zhcn:93630cfa21bad11942565f0c",
      "kind": "character_system_text",
      "source_text": "好无聊！风风想来点有趣的！\r\n有趣的～有趣的啦～～！！",
      "source_fingerprint": "2f9d13295abf803968cffa08b6638d7cc98ef9e542078e399290368bbab8b6b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20009"
      ]
    },
    {
      "uid": "zhcn:44e0162b07a64349371b25d0",
      "kind": "character_system_text",
      "source_text": "身体……感觉，好重喔……\r\n好怪喔……",
      "source_fingerprint": "6ad2f4b95c548ec519e4bd4fdec744d36d4c42f9731e299812f00d9e8e40c51b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20010"
      ]
    },
    {
      "uid": "zhcn:eb4895e680c6eec8fbf347f6",
      "kind": "character_system_text",
      "source_text": "风风不想被觉得很逊！\r\n绝对不能被小看喔～！",
      "source_fingerprint": "20bc715d904e3e2de427dfb726ff972b87df9cb024a58a4637132277ab5ba40f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20011"
      ]
    },
    {
      "uid": "zhcn:bd8de8063cec3b70216a4407",
      "kind": "character_system_text",
      "source_text": "又要比赛啊？\r\n风风开始觉得腻了啦～",
      "source_fingerprint": "c4a556ccb9bfeef3c0ea89572394368756e4cad0cd47b788df64b7b3b349cbcc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20021"
      ]
    },
    {
      "uid": "zhcn:fcf610d8318cfc0897c668cb",
      "kind": "character_system_text",
      "source_text": "唔啊──！风风不要比赛啦！\r\n不要就是不要啦～～！",
      "source_fingerprint": "b192201338bf4c86b3f905c82dd70d24fe92d824327057a18ee71cf26797c6ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20022"
      ]
    },
    {
      "uid": "zhcn:65d88d8f5772f243188185ca",
      "kind": "character_system_text",
      "source_text": "风风就是最强的～！\r\n最强的就是风风～！\r\n吼──！！",
      "source_fingerprint": "c3e75ce0495e6b99053829671a6ef14375769e0ef34aa4444a15b2411e3c99ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4420a036bb4061c28db36a6d",
      "kind": "character_system_text",
      "source_text": "今天会让你们牢牢记住\r\n风风的实力！",
      "source_fingerprint": "bfdff22c40e546e1f666ac20a5d11a93abc3accbb7da1d83ef9b6047d279da44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20024"
      ]
    },
    {
      "uid": "zhcn:bbf818adb91187fb2672a86e",
      "kind": "character_system_text",
      "source_text": "今天风风也要\r\n独占所有人的注意喔！",
      "source_fingerprint": "49b9ad528a5a49635cd3c6066a44ee387aa50f6424ed04e6d90717427f95d04e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20025"
      ]
    },
    {
      "uid": "zhcn:e27923954e69e367bf1b74f3",
      "kind": "character_system_text",
      "source_text": "听见了吗！？\r\n刚刚有人提到风风喔！\r\n嘿嘿嘿，眼光真好啊！",
      "source_fingerprint": "a5f8ee0b1f243b3614720a1abed1d05d320482e4987ffeb88085193db334eaaa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20026"
      ]
    },
    {
      "uid": "zhcn:8eebc3f6a562ac3aa4e848c2",
      "kind": "character_system_text",
      "source_text": "风风去对一个自以为老大的家伙\r\n做了鬼脸喔！当然比赛中也要\r\n让她吓一跳！",
      "source_fingerprint": "b16730c6a345f667402495b4c718778793134e851fe4740b818096427b85d8a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20027"
      ]
    },
    {
      "uid": "zhcn:875928b41ff9cc443a25b790",
      "kind": "character_system_text",
      "source_text": "哼，每个人的表情都不赖嘛！\r\n虽然还是完～全\r\n赢不过风风啦！",
      "source_fingerprint": "6b4daa5aea5f75969b3a0529d502e7ec3e9e457a89e0ce7cb4de49eff1945e7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20028"
      ]
    },
    {
      "uid": "zhcn:2eb216f70515762e902ad31f",
      "kind": "character_system_text",
      "source_text": "喂，手下！\r\n仔细看着老大的跑姿啊！",
      "source_fingerprint": "be8142d480c0326cb206256810d441d227563bae8778855d5e262bae8d95b299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20029"
      ]
    },
    {
      "uid": "zhcn:ce66b0e8f8e51e6e91c3b9d3",
      "kind": "character_system_text",
      "source_text": "一口气深深咬下！\r\n要在比赛中留下咬痕喔～！",
      "source_fingerprint": "48888689b69df770b39ad02ede9852e6a449ada08957571a5b4bca5079b07e3d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20030"
      ]
    },
    {
      "uid": "zhcn:796b796ff0190e110ab6ce9d",
      "kind": "character_system_text",
      "source_text": "妈妈说她会看转播！\r\n风风要超～级吸睛喔～！",
      "source_fingerprint": "5f39d733a87142a143c52450c4b0d04e9b4b778d4e105d0a13809c13388680d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20031"
      ]
    },
    {
      "uid": "zhcn:359484ac6b0fe8ef638983e4",
      "kind": "character_system_text",
      "source_text": "嗯～？总觉得哪里怪怪的耶。\r\n风风明明把牙齿刷干净了……",
      "source_fingerprint": "0ed1614cb3de2254c94748701e728ffc3a0d63b8702d373083a56163861c06b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20032"
      ]
    },
    {
      "uid": "zhcn:499dd8cbad7efcf7f4ac626b",
      "kind": "character_system_text",
      "source_text": "风风想快点去比赛啦～！\r\n风风觉得无聊了～！",
      "source_fingerprint": "c64a941aa83f6aaef39feb1f684d2a2176274d23cd98aceba8c98f0814e9f717",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20033"
      ]
    },
    {
      "uid": "zhcn:42d2d2d0d34f4e11b8f83b21",
      "kind": "character_system_text",
      "source_text": "好没劲～对了！\r\n训练员，你自己下去跑\r\n应该会更有趣喔！",
      "source_fingerprint": "4b0c284edc05e46c843c46372e9c889cd614557f92b76d0bc95e57b9bc888d9d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20034"
      ]
    },
    {
      "uid": "zhcn:42d765677d7d8da21a50b44a",
      "kind": "character_system_text",
      "source_text": "无论遇到什么危机风风都不会退缩！\r\n不坚持到最后一个步骤\r\n就不叫恶作剧了！",
      "source_fingerprint": "958d45ebf0e33b305368a0048d8b9daf7531f6f5b8cea27219b447fa1fe69a43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20035"
      ]
    },
    {
      "uid": "zhcn:0341fca54f6f365d430bb401",
      "kind": "character_system_text",
      "source_text": "唔唔……风风……\r\n是、最强……的喔……",
      "source_fingerprint": "3f035b04c16b068ed19d4bbee941c5ee355c0d07ddb3d223b02b0de977fa415d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20036"
      ]
    },
    {
      "uid": "zhcn:c649feb68805b8eb55e8d6d1",
      "kind": "character_system_text",
      "source_text": "风风不想就这样结束！\r\n大家……大家，快点……\r\n看过来啊……！",
      "source_fingerprint": "e56f89608331fad33f41d104cbe146ad28dcec7b453895db4b067bc0119cefd3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20037"
      ]
    },
    {
      "uid": "zhcn:10b3d7c457c1561530de7d92",
      "kind": "character_system_text",
      "source_text": "哒哒──！",
      "source_fingerprint": "9b0fd0e823b631eab22caf2344ad0563fc84f860cc85f807430441c05bf1c47d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20038"
      ]
    },
    {
      "uid": "zhcn:97d84c459a9bc4a455d70017",
      "kind": "character_system_text",
      "source_text": "吼──！！",
      "source_fingerprint": "ff1bf19c4d41be675008eba348de111ecda8a4852b247ac305c2f0b2c3a7a4ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20039"
      ]
    },
    {
      "uid": "zhcn:2e38a31e8e8ae941a818f53c",
      "kind": "character_system_text",
      "source_text": "做就对了！",
      "source_fingerprint": "c2d31962fa2b64977e9016466ad7825c54e72650061f563f7b5d4a3722f6807f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20040"
      ]
    },
    {
      "uid": "zhcn:e1daa17e8019e2b41048ac7a",
      "kind": "character_system_text",
      "source_text": "念、念书……",
      "source_fingerprint": "597ceda1fc716da72e2b7e8f3a25f57170fd3eb8872793d131298b3ec19194e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20041"
      ]
    },
    {
      "uid": "zhcn:09e6ae74c74fe18c80200331",
      "kind": "character_system_text",
      "source_text": "唔哇──！？",
      "source_fingerprint": "d2b3a8cbd9e9924b0a2863b0bb78dd8450667bb48fd440e1802583b95918d7bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20042"
      ]
    },
    {
      "uid": "zhcn:3b70da20b3895eecf5730d72",
      "kind": "character_system_text",
      "source_text": "唔啊啊～！",
      "source_fingerprint": "f1edd9d63b48c4d8245b822f3f735b139f7852b078f7dee2563d3d9bc4f6d477",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20043"
      ]
    },
    {
      "uid": "zhcn:572b37dd7416d6158e2d09ed",
      "kind": "character_system_text",
      "source_text": "跟风风来吧！",
      "source_fingerprint": "ee90cf9d3e78522ad2c402c8c8bb3b71bd8b3523f88d6ebd3674fda2001510e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20046"
      ]
    },
    {
      "uid": "zhcn:b76ed35aaab601cdea78eb90",
      "kind": "character_system_text",
      "source_text": " 啪唰──！！",
      "source_fingerprint": "75441c5b7abe27d584573be4e410633843ef4036ce8b8d28a8a6a8d29afa6687",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20047"
      ]
    },
    {
      "uid": "zhcn:c3386502adf8f715fdc14b55",
      "kind": "character_system_text",
      "source_text": "以你的程度来说算是做得不错了喔。",
      "source_fingerprint": "5a0f5c8b5184b4bf8a97684a45af32f92dee42eddda513f0d93919245f91e4b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20049"
      ]
    },
    {
      "uid": "zhcn:f76c2a58c6eca3a4fde10ab1",
      "kind": "character_system_text",
      "source_text": "跑得还算开心啦！",
      "source_fingerprint": "5adb1831e92451470583fd10f479c35e3a24b63dc470db160b223694450a48de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20050"
      ]
    },
    {
      "uid": "zhcn:03dfa46b9228704ec8f6f3bb",
      "kind": "character_system_text",
      "source_text": "跟上风风我的脚步！",
      "source_fingerprint": "4231f25f0ef215435c6aeefef45463e6f09278fb4a0d80e969fbcfe62e3f6178",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "20051"
      ]
    },
    {
      "uid": "zhcn:a26fc410e88c027c44f453fa",
      "kind": "character_system_text",
      "source_text": "一口气向前咬！",
      "source_fingerprint": "daf544a0feaa093887ac76c224c71b25778a97997c516210b64839e9149ba907",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "2030"
      ]
    },
    {
      "uid": "zhcn:b310180dbacaf6600816017b",
      "kind": "character_system_text",
      "source_text": "手下们，上啊！",
      "source_fingerprint": "39a82c038323f87273503ac1e44aa0af9cf3da920803b66bd719ed8b3f88db59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "2031"
      ]
    },
    {
      "uid": "zhcn:9effb560e35fdde54c8755ca",
      "kind": "character_system_text",
      "source_text": "跑得还算开心啦！",
      "source_fingerprint": "5adb1831e92451470583fd10f479c35e3a24b63dc470db160b223694450a48de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "2032"
      ]
    },
    {
      "uid": "zhcn:9403f497f1cc6749315679fd",
      "kind": "character_system_text",
      "source_text": "哼，每个人的表情都不赖嘛！\r\n虽然还是完～全\r\n赢不过风风啦！",
      "source_fingerprint": "6b4daa5aea5f75969b3a0529d502e7ec3e9e457a89e0ce7cb4de49eff1945e7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "2033"
      ]
    },
    {
      "uid": "zhcn:eeb20f77e227f329383c2382",
      "kind": "character_system_text",
      "source_text": "今天风风也要\r\n独占所有人的注意喔！",
      "source_fingerprint": "49b9ad528a5a49635cd3c6066a44ee387aa50f6424ed04e6d90717427f95d04e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "2034"
      ]
    },
    {
      "uid": "zhcn:a19ea8bcde64f11d7f878935",
      "kind": "character_system_text",
      "source_text": "跑得还算开心啦！",
      "source_fingerprint": "5adb1831e92451470583fd10f479c35e3a24b63dc470db160b223694450a48de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "2035"
      ]
    },
    {
      "uid": "zhcn:3959b0bf6cab395f5a4db6cb",
      "kind": "character_system_text",
      "source_text": "やるのだ！",
      "source_fingerprint": "ff6d5503acab0632f194ada06ce54a0d1fbb6a9f48c50e1acc6ecd4d931b2ff1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "23015"
      ]
    },
    {
      "uid": "zhcn:2df452c4216ba04f8ad7dc51",
      "kind": "character_system_text",
      "source_text": "下次要一口气得第一名喔！",
      "source_fingerprint": "ca92404337cfbb6741da918fb6ad1cba5894bf69600bc6f367182ed87587564f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f4ebfd5d8a32bc34cacb8963",
      "kind": "character_system_text",
      "source_text": "把脖子洗干净等着吧～！！",
      "source_fingerprint": "5d94da4eea17c1a1961d467091dc68d5e220cb87a55c2883860326e2fc029b75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "30001"
      ]
    },
    {
      "uid": "zhcn:cceb2b771de1a9172ed9f0e1",
      "kind": "character_system_text",
      "source_text": "也看向风风吧～！！",
      "source_fingerprint": "dc65412f2dccb488aec9d49dd441fc485adb10fd6b21e5cf1736ea4d27147665",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "30002"
      ]
    },
    {
      "uid": "zhcn:12fc8c753597295a33c1e023",
      "kind": "character_system_text",
      "source_text": "我还想再来一次啦～！",
      "source_fingerprint": "621704584edb0c1a5872606773aa2aaea3dc09e82d0cde784dab0176c3c2b91f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "30003"
      ]
    },
    {
      "uid": "zhcn:fab88d0ae034794fa5543470",
      "kind": "character_system_text",
      "source_text": "下一个想被咬碎的……\r\n是谁啊？吼──！！",
      "source_fingerprint": "f41ceeb27a61f230bdeeef1668d14ffbd2542788dbfc4b40ada3a8ddd6b3a2f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "30004"
      ]
    },
    {
      "uid": "zhcn:daca93d7fc2c52eecb55ef3a",
      "kind": "character_system_text",
      "source_text": "看到了吗？看到了吧！风风赢了！",
      "source_fingerprint": "63b1b8308054c206ed376c597a46d7752cd23f73eec6d1270f439a8e9d986d8b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "30005"
      ]
    },
    {
      "uid": "zhcn:33e959e3b01be62b65a21450",
      "kind": "character_system_text",
      "source_text": "在那里等着风风吧！",
      "source_fingerprint": "9786e91ad823dbb6a47c420b84406c2b7f4c6db6adcd80976ad3d6b50c6b0827",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "31000"
      ]
    },
    {
      "uid": "zhcn:a96cb9921a624cd8d98d0556",
      "kind": "character_system_text",
      "source_text": "吼吼吼吼……看风风大口咬！！",
      "source_fingerprint": "3b31d4d342e530f28566aaabac8f80878be1b1c7a077aa86b29b2249cd0a33c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "40000"
      ]
    },
    {
      "uid": "zhcn:603222ecba1f7ff820a12938",
      "kind": "character_system_text",
      "source_text": "大家一起盖出一座\r\n用来崇拜风风的\r\n最强魔王城堡吧～！",
      "source_fingerprint": "bc21a3c176c503680cc64cd4d85ac2967495cf9a1c522435a140b423fb030427",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "400000"
      ]
    },
    {
      "uid": "zhcn:d3fe4399c7d7b7487d4565b2",
      "kind": "character_system_text",
      "source_text": "居然能聚集到这么多仆人……\r\n太强了……太强了！",
      "source_fingerprint": "71fdd63a9f8da4a7e0e8f66949977174543d996cadcbd1b4d572dd15ae5b46a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1043",
        "400005"
      ]
    }
  ]
