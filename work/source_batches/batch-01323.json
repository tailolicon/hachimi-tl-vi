      ]
    },
    {
      "uid": "zhcn:3f6d519e1c81a2bc766d1028",
      "kind": "character_system_text",
      "source_text": "诶嘿嘿～",
      "source_fingerprint": "ccfaa682d562350968e77409fe61353bf8414a30c7e008e48aef4dbaee3459a5",
      "source_path": "character_system_text_dict.json",
