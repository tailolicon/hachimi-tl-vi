      ]
    },
    {
      "uid": "zhcn:b72c1e49d7d7848e05e47b18",
      "kind": "character_system_text",
      "source_text": "诶嘿！",
      "source_fingerprint": "ae1fab47d8e7ed0746053c2a9d0db347e7f6e385026266c3908c56ab943f8993",
      "source_path": "character_system_text_dict.json",
