      ]
    },
    {
      "uid": "zhcn:67acbffc45802d5e73b429f7",
      "kind": "character_system_text",
      "source_text": "真了不起诶──！！",
      "source_fingerprint": "b0fa6784237b4e7d19b7e4906bb0eeab0a14b7a7f434247c6346b7f63c56b1c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
