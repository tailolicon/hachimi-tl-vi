      ]
    },
    {
      "uid": "zhcn:287f9e0cc0c7af61c1cf014d",
      "kind": "character_system_text",
      "source_text": "哈──哈哈哈！",
      "source_fingerprint": "f6630049120f78328e9c4c814009806d49fb29d57761d642dda5d35838b473b3",
      "source_path": "character_system_text_dict.json",
