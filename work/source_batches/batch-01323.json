      ]
    },
    {
      "uid": "zhcn:7ff09daae2e4f6be86f447e4",
      "kind": "character_system_text",
      "source_text": "是！",
      "source_fingerprint": "92c7c80d421e17e0e64227dc915153ae460be7213ab0bfafd9026602c2e67892",
      "source_path": "character_system_text_dict.json",
      "json_path": [
