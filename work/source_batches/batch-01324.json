      ]
    },
    {
      "uid": "zhcn:40cefbb56b7c44c430653036",
      "kind": "character_system_text",
      "source_text": "爆进爆进！",
      "source_fingerprint": "b51d45706c9b66b5f683fb585c52c7ee1a1cd047e4bff02b4b6e07c94d285310",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "71018"
      ]
    },
    {
      "uid": "zhcn:0eca991d5991113bb78c6a2c",
      "kind": "character_system_text",
      "source_text": "让您见识一下，班长的实力！",
      "source_fingerprint": "01cd0eefe2d67531f1ce870dffd2add0d3d31ae0512b985342c1881ded4e6360",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "71019"
      ]
    },
    {
      "uid": "zhcn:6ceec90ea9d65a78b32527d9",
      "kind": "character_system_text",
      "source_text": "お疲れ様です！",
      "source_fingerprint": "dc0667e167f3ce47343e4888de0096ba99a2a9297f3f13b6d50b5ff603092f10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "80000"
      ]
    },
    {
      "uid": "zhcn:4c15f0abb0e2645f898259cc",
      "kind": "character_system_text",
      "source_text": "预备～一起喊！胜利～！！",
      "source_fingerprint": "fb9a2cd4da88854a7241f2e63619c746374853c1ca6f7fa1fbd9ae948435b867",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "8007"
      ]
    },
    {
      "uid": "zhcn:155308a177599d8134325092",
      "kind": "character_system_text",
      "source_text": "哼哼……来向大名鼎鼎的班长\r\n挑战吧！",
      "source_fingerprint": "7d0b28a75b4db80f159b2f4b8c8ef132900409c948550de710474696bd280c1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "81000"
      ]
    },
    {
      "uid": "zhcn:bd933a7a326f641ce819f32e",
      "kind": "character_system_text",
      "source_text": "还没完呢！\r\n让您见识一下爆进的本领！",
      "source_fingerprint": "bec8efa6a5cd16862ce9a630047844200478db651afeb6a7468a207364c139fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "81001"
      ]
    },
    {
      "uid": "zhcn:3d0b2cd29899e5f384d71d86",
      "kind": "character_system_text",
      "source_text": "今天也要很有精神地打招呼！\r\n那就深吸一口气到肚子深处──\r\n早──安──！！",
      "source_fingerprint": "b300396401ef79421f3dd2de7f2712a5cdde3be18f25f430e981cc731ce377ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "90000"
      ]
    },
    {
      "uid": "zhcn:529de35a2ec088bb92ba8ab5",
      "kind": "character_system_text",
      "source_text": "清理黑板、替换花瓶的水……\r\n班长从一早就很忙碌了！\r\n真是的……还真是了不起啊我！",
      "source_fingerprint": "d57c96cc1c85a8098d5d086f0fc959d36afeef178ec1183e54e4aeae163e3346",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "90001"
      ]
    },
    {
      "uid": "zhcn:de0a405e2de719d2e81c970f",
      "kind": "character_system_text",
      "source_text": "训练员！您好！\r\n下午的训练，\r\n我们也打起精神进行吧！",
      "source_fingerprint": "ea22b315874ffcef7654f0d912264c9bf63e2faf58be31de96fe3c0b4f43f809",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "90002"
      ]
    },
    {
      "uid": "zhcn:c740aca3c3d013079aaaa47b",
      "kind": "character_system_text",
      "source_text": "吃过午餐后，活力满满！\r\n看是要进行训练、并跑练习，\r\n还是追逐赛！任君挑选！",
      "source_fingerprint": "8ba55b6b931ee41036b44f5bdb2d236e103ec234cc34f283bff8547de195a13f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "90003"
      ]
    },
    {
      "uid": "zhcn:82752914715c94140f381561",
      "kind": "character_system_text",
      "source_text": "今天一整天辛苦了！……嗯嗯！\r\n知道要慰劳别人的辛苦，我真棒！",
      "source_fingerprint": "15f69c30397f0619d24362d72e04b6855c4521ff0df01e0a3df1f773ba319715",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "90004"
      ]
    },
    {
      "uid": "zhcn:f38881c70677184f7139a592",
      "kind": "character_system_text",
      "source_text": "就算下课、响起放学的钟声，\r\n我也会继续努力！\r\n毕竟我可是班长啊！！",
      "source_fingerprint": "2111c8a46cba572f97373f61a073545d3e81fd8ded4f31ef1f4dfd1baebd3b9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "90005"
      ]
    }
  ]
