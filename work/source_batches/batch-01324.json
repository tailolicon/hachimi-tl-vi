      "uid": "zhcn:de7c0b56a4987bcc0d713110",
      "kind": "character_system_text",
      "source_text": "哼哼，去试试看吧！",
      "source_fingerprint": "ab1b0cc6c84633640b421e409ca3aed123d0091219db7e510da554f489884655",
      "source_path": "character_system_text_dict.json",
      "json_path": [
