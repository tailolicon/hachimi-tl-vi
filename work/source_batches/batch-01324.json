  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:2f2a41d70082104130aa0bbb",
      "kind": "character_system_text",
      "source_text": "……昨天我梦到自己跑最后一名。\r\n但梦只是梦……对吧！？",
      "source_fingerprint": "55d356aed014d6aeff7d8ae6ba61a4f66296e54e343d693cb8f20dfedca446ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20035"
      ]
    },
    {
      "uid": "zhcn:cec0b49fcff397ef468ca5e3",
      "kind": "character_system_text",
      "source_text": "无论身处什么样的困境，\r\n我都有拿第一名的秘诀。\r\n那就是……速度！！",
      "source_fingerprint": "ae785eb5953b55d7d80e77156e3c9787df327fabdccd2e001952ec819703638e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20036"
      ]
    },
    {
      "uid": "zhcn:000e33a86c2a4af72f6e7c75",
      "kind": "character_system_text",
      "source_text": "我可以理解你害怕的心情。\r\n但谁快就谁赢……比赛就是这样！",
      "source_fingerprint": "af4a859a7b0aed9bd81cc6a61233035405606fe47871399b47eb4279dea9ed3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20037"
      ]
    },
    {
      "uid": "zhcn:4d6e800be452f1d5f48fc2bf",
      "kind": "character_system_text",
      "source_text": "我明白了！",
      "source_fingerprint": "4abd4665a269fc5b7d6d557dbfc6fb51a6eb9290ccf8953080806ab59acbdf6e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20038"
      ]
    },
    {
      "uid": "zhcn:6f367407f4cbe41d1a372eeb",
      "kind": "character_system_text",
      "source_text": "爆进ー！",
      "source_fingerprint": "404dc2523816251e9f3b9a8b97ee791b4273930b51fe27c67efde245d7159fe2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20039"
      ]
    },
    {
      "uid": "zhcn:a7353cfabf65b96221a4d7e4",
      "kind": "character_system_text",
      "source_text": "喝呀啊啊啊！",
      "source_fingerprint": "dd21244df89b12209beacc485d588cdc9e500999ec123b242f8fa59dc3d20db6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20040"
      ]
    },
    {
      "uid": "zhcn:0dc15b3a15c39c62ad3ccbf6",
      "kind": "character_system_text",
      "source_text": "嗯嗯……",
      "source_fingerprint": "26ff4925698843c3792c7f0bc377e245a84f32db565113d4ccaa189fe812f9dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20041"
      ]
    },
    {
      "uid": "zhcn:d905e5ca0a8f606e41932dfd",
      "kind": "character_system_text",
      "source_text": "嗯嗯～？",
      "source_fingerprint": "3960d0c6ac3e5fcce71a62a4636e2aac57e005fba3bca1d197b9a698432e9506",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20042"
      ]
    },
    {
      "uid": "zhcn:6b662e20810a80e8a69e34d0",
      "kind": "character_system_text",
      "source_text": "呼哇……",
      "source_fingerprint": "6cec7a36e298493f1d75ff08e31f1d96512331979e25650ca56d116ea35db8da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20043"
      ]
    },
    {
      "uid": "zhcn:669dd4495c868997d429666b",
      "kind": "character_system_text",
      "source_text": "出发啦！",
      "source_fingerprint": "e614f61077baa5c32c3da74aeeadf26136d27b54dd9da15478f03b2843c04ca3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20046"
      ]
    },
    {
      "uid": "zhcn:e283423ef2baab9b18df4b51",
      "kind": "character_system_text",
      "source_text": "很不错嘛！",
      "source_fingerprint": "f22f4df5e59403c4ba0e9f1d17c68a5e106dbb871553e2d7da1a355d0cc56217",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20047"
      ]
    },
    {
      "uid": "zhcn:9cb02cd929f06d532d7688d9",
      "kind": "character_system_text",
      "source_text": "我们的努力开花结果了！",
      "source_fingerprint": "d44d735bd3dd4e4af9b8cadc40a439df2ca7b47c2f0f313e3257fb338e9b57c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20049"
      ]
    },
    {
      "uid": "zhcn:5ddc7a0032047cbf2c1e0559",
      "kind": "character_system_text",
      "source_text": "感谢您的指导！",
      "source_fingerprint": "d21da34551960499b2cb6bec760dd3b26a4b95a6aab03566328daa727fd482a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20050"
      ]
    },
    {
      "uid": "zhcn:d12257221a5560144d9d2f00",
      "kind": "character_system_text",
      "source_text": "哦哦ーー！我一定会做到的！",
      "source_fingerprint": "72014bdd612dff6d300a36a10733977b281985187da6eb64eafbe47420f00c09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "20051"
      ]
    },
    {
      "uid": "zhcn:ef03313609743c3fe2c86b40",
      "kind": "character_system_text",
      "source_text": "跟着班长我冲啊ー！",
      "source_fingerprint": "a45f98a110986a3792d4db2d3020b3849c876f306d29f12ff1ab2589dde1a9e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "2030"
      ]
    },
    {
      "uid": "zhcn:5877a6790bfcf5efb714eca6",
      "kind": "character_system_text",
      "source_text": "看我堂堂正正地爆进！",
      "source_fingerprint": "692b594bc1a288ecdefaa6c8d60df643f9e2bafc2ae0af23092ef052baf6cfe2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "2031"
      ]
    },
    {
      "uid": "zhcn:a1b6abbca00fdcde09c77280",
      "kind": "character_system_text",
      "source_text": "感谢您的指导！",
      "source_fingerprint": "d21da34551960499b2cb6bec760dd3b26a4b95a6aab03566328daa727fd482a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "2032"
      ]
    },
    {
      "uid": "zhcn:e44df2fa6b39044003b112e7",
      "kind": "character_system_text",
      "source_text": "正确的呼吸节奏跟正确的状态！\r\n由我来取胜当然也是正确的结果！",
      "source_fingerprint": "98ec90f31d302d226bde64d53faeed7ba0d2717cb1d5f66f0fe765aa0f144f21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "2033"
      ]
    },
    {
      "uid": "zhcn:1cee45f9f0714c72f91b495b",
      "kind": "character_system_text",
      "source_text": "为了迎接比赛，我已经把状态\r\n调整到最好！现在的我是最强的！\r\n说是已经赢了也不为过！",
      "source_fingerprint": "2008dcaebec115eeca8e27f9bc4cc3cf37616449069e72226d1a2f0789433bb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "2034"
      ]
    },
    {
      "uid": "zhcn:323c2634a998a6c501b1817f",
      "kind": "character_system_text",
      "source_text": "感谢您的指导！",
      "source_fingerprint": "d21da34551960499b2cb6bec760dd3b26a4b95a6aab03566328daa727fd482a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "2035"
      ]
    },
    {
      "uid": "zhcn:833b6e8c510a37ee1dd72c11",
      "kind": "character_system_text",
      "source_text": "バクシーン！",
      "source_fingerprint": "22d0f4926d772e746b9449498cc9b0055b126c8c9e460088626ffbf723f58be5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "23015"
      ]
    },
    {
      "uid": "zhcn:a9ec06a1ef3c81283d1fbc71",
      "kind": "character_system_text",
      "source_text": "嗯ー。果然，我是很优秀的呢！",
      "source_fingerprint": "1940433763a117c5f870eadc4860202908b7fccf4f222296fc199dc3ed92341f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30000"
      ]
    },
    {
      "uid": "zhcn:e125cbbb2c24374d494b2c86",
      "kind": "character_system_text",
      "source_text": "嗯嗯……继续保持让大家崇拜的自己！",
      "source_fingerprint": "6f1880835a47356d1d4b8d40bbbdf087ac288f5592b174e4d670c4d6bb6f609e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30001"
      ]
    },
    {
      "uid": "zhcn:f41dd518e9636998e663ac47",
      "kind": "character_system_text",
      "source_text": "其他人的速度也很快！这点我承认！",
      "source_fingerprint": "71ed91946efe5387cdf622ad97a7f6ad800a78c9f96ad428c1502bc0339e3c57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30002"
      ]
    },
    {
      "uid": "zhcn:274d6f0811c108f6ec6bd9ef",
      "kind": "character_system_text",
      "source_text": "我才没有……闹脾气呢……",
      "source_fingerprint": "14dddf6c5df321b4a2d9198c7f67fa578e6a2ac63633b7e56678d67d959db513",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30003"
      ]
    },
    {
      "uid": "zhcn:2136d0cd40b1b16deb7788ea",
      "kind": "character_system_text",
      "source_text": "完全是爆进的胜利！\r\n哈哈哈哈哈哈哈哈ーー！",
      "source_fingerprint": "c29add3e90ee8bf09f1ac9320e3883bf78a34f834444f500221bc321aff6cb01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30004"
      ]
    },
    {
      "uid": "zhcn:fcbe4106f055f41f4e3aa6f8",
      "kind": "character_system_text",
      "source_text": "因为我是优等生嘛！\r\n哈哈哈哈哈哈哈哈ーー！",
      "source_fingerprint": "5be52d1425bae12712377fdf5ca7702c473857e3aa23ff3225438e1f44cae02c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30005"
      ]
    },
    {
      "uid": "zhcn:22721d358600a982b7ff523f",
      "kind": "character_system_text",
      "source_text": "怎么样、怎么样！\r\n幸好有相信我吧！",
      "source_fingerprint": "389eadb5c5f70639a11834726becff3722e6101a2a2602363a6364f039d32654",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30006"
      ]
    },
    {
      "uid": "zhcn:aa89a3e28e62e752f6c5d173",
      "kind": "character_system_text",
      "source_text": "因为我是优等生嘛！\r\n哈哈哈哈哈哈哈──！",
      "source_fingerprint": "59b51f4dd8138c6aa4d1da6518bc1478305194dc063fcdffed727129a724c30e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "30007"
      ]
    },
    {
      "uid": "zhcn:c1dc5a9aa4c058f534932614",
      "kind": "character_system_text",
      "source_text": "爆进吧！",
      "source_fingerprint": "31b5ae966e51c566233f1c3ad1ba146a1b849b0e31c6100d6bfaf4ed02e54ba2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "31000"
      ]
    },
    {
      "uid": "zhcn:8cb8534dec2a10805c76226e",
      "kind": "character_system_text",
      "source_text": "朝着！胜利！爆进～～！",
      "source_fingerprint": "760d448bd233020b93443cb324721a004e89d1a264f41a8b1b9d598df5f99c13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "40000"
      ]
    },
    {
      "uid": "zhcn:4b68ae9631b957db24dadd57",
      "kind": "character_system_text",
      "source_text": "魔鬼躲避球要比的是持久力！\r\n换句话说，该轮到我这个同时身为\r\n优秀长途跑者的班长出场了！",
      "source_fingerprint": "d411435f16e7c5c72825b22c1cae8e2d4bed523a71da1139f880aa9882eafe05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400003"
      ]
    },
    {
      "uid": "zhcn:4d2b3be146135856e6673bf5",
      "kind": "character_system_text",
      "source_text": "做点心也请交给我吧！\r\n全都会模范地去做给您看！\r\n…哈！　好像有股烧焦了的味儿呢！？",
      "source_fingerprint": "22e8c9244ad4a75a1abc8bf62c46cad11c6aef9ca3fe149d3b2fd5eae92f3ffe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400005"
      ]
    },
    {
      "uid": "zhcn:7a3f7afb10524c5e2b737c7b",
      "kind": "character_system_text",
      "source_text": "各位到场的观众──！\r\n今天我这个班长会让感谢祭\r\n办得热闹滚滚的！",
      "source_fingerprint": "264f763c5ca2d6eb0a7a27f1b75e95f385c5e4fc39546787ac833f78d476f3ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400006"
      ]
    },
    {
      "uid": "zhcn:db52c57ebe48661637e3cb20",
      "kind": "character_system_text",
      "source_text": "带着班长的自豪感，\r\n我要挑战这次大会！\r\n？　您为什么在发呆呢？",
      "source_fingerprint": "bf5d1fb277cc7e55030e94918aa0e8bd99f22d10201b75439f1417a205cf2c1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400007"
      ]
    },
    {
      "uid": "zhcn:653456e178792e419273c9e7",
      "kind": "character_system_text",
      "source_text": "朝着！胜利！爆进～～！",
      "source_fingerprint": "760d448bd233020b93443cb324721a004e89d1a264f41a8b1b9d598df5f99c13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "40001"
      ]
    },
    {
      "uid": "zhcn:d6037512857c9844b1e0135c",
      "kind": "character_system_text",
      "source_text": "フッフッフ…私の好みを反映した\r\nチョコチップ入り桜餅！大人気で、\r\nなんと！定番商品になりましたっ！",
      "source_fingerprint": "8d2196f3c67043adb6ae099c4bb9227291d0fda557f3f1d68744da799a6bb6b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400011"
      ]
    },
    {
      "uid": "zhcn:98dee5fba09b6ea370b8dd2e",
      "kind": "character_system_text",
      "source_text": "惊天大胜利！\r\n下次也邀请千代王同学\r\n到俱乐部比赛吧！",
      "source_fingerprint": "ef2062984c15641bc131489a807fda9d04d4455d0bfa5d14e27fab50dfc9e745",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400014"
      ]
    },
    {
      "uid": "zhcn:7c0b45423ca4b9c7808456d9",
      "kind": "character_system_text",
      "source_text": "哈哈哈！",
      "source_fingerprint": "4ab61fc2c741fef35bf1209344cee2f8291e05b25199b0bb2729775b046dfc9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "40002"
      ]
    },
    {
      "uid": "zhcn:d6e5ca89399a45fe41b49dd2",
      "kind": "character_system_text",
      "source_text": "爆进进──！……哈哈！",
      "source_fingerprint": "214001bcf446ea97241f57b03bd2fc6ea1744a56b502e20d32cc2b6c5f906f4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "40003"
      ]
    },
    {
      "uid": "zhcn:10f236e2b24e5254aba00cdb",
      "kind": "character_system_text",
      "source_text": "唔哇────地登场！呼！\r\n爆进！爆进！爆进进──！\r\n……哈哈！",
      "source_fingerprint": "2e2f4bd778976030d921c0413635fc4bbc62373f99343228971a0f7c521e6f60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "40004"
      ]
    },
    {
      "uid": "zhcn:2fa23647680b60213fa81676",
      "kind": "character_system_text",
      "source_text": "飾りモリモリパフェを食べるコツを\r\nお教えしましょう！こぼれる前に\r\nすくう！スピードがカギですよっ！",
      "source_fingerprint": "1aef655f9429b96c8666427ba90046a051a53bf4f672e1dd50a308984dfafa4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400070"
      ]
    },
    {
      "uid": "zhcn:7b498c74043747cb86bfc85b",
      "kind": "character_system_text",
      "source_text": "谋勇同学肯定没问题的！\r\n因为有勇心同学在！\r\n…委员长之眼是不会看漏的！",
      "source_fingerprint": "9c003b622e9cd3d12b4ab54bcfc04ed973d19396c78f1a5b4daa8498392bb06d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400127"
      ]
    },
    {
      "uid": "zhcn:d8330fbf4041c7397065c558",
      "kind": "character_system_text",
      "source_text": "呀～！是因为奔跑的缘故吗！\r\n脸上好烫！心脏也超爆进！\r\n…看到胸针后更是砰砰爆进！",
      "source_fingerprint": "b747e76413d2a51d79807bd5d636225e19bb9fce26de320d1cfc605da50d0144",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "400130"
      ]
    },
    {
      "uid": "zhcn:03b9bc48d265296ce7f16a66",
      "kind": "character_system_text",
      "source_text": "那就拜托您帮我呼喊班长口号了！",
      "source_fingerprint": "8008e7006bd9ba799adb32304b6fc378098892ff42df0313990c9c3852927489",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "60000"
      ]
    },
    {
      "uid": "zhcn:d2fa2e6e90159da7dce55373",
      "kind": "character_system_text",
      "source_text": "Live，我也会优秀地完成！",
      "source_fingerprint": "a664569ac1cea86f35085cbc1b79fb62dcd734826f32830eb2fa014fb26edd9a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "60001"
      ]
    },
    {
      "uid": "zhcn:a26a2c9a454501641545c064",
      "kind": "character_system_text",
      "source_text": "加油吧！\r\n别担心，还我有在您身边呢！",
      "source_fingerprint": "164922865c1585d36697dd88bfbf98b1c288a34f31be821bd96d29db42fbba55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70000"
      ]
    },
    {
      "uid": "zhcn:b1738eea66d4e4de80ab4e20",
      "kind": "character_system_text",
      "source_text": "与我的相遇，对您来说是\n命中注定的瞬间吧！嗯嗯！",
      "source_fingerprint": "4f86635e18da7daaa0452f32f99c64ea925d114badf5847f37e16708d6a26ef7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70001"
      ]
    },
    {
      "uid": "zhcn:ca9c588920038d76c7f40dd9",
      "kind": "character_system_text",
      "source_text": "比谁都还要适合穿这套制服！\r\n没错，因为我是班长嘛！",
      "source_fingerprint": "c29df0c09427259fe8c51530486680ec12f32118bd5384b86bc2910c294cac44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70004"
      ]
    },
    {
      "uid": "zhcn:c5c53f04c6b1a280621a9a61",
      "kind": "character_system_text",
      "source_text": "挺直！……很好！\r\n这是很适合学园巨星穿的衣服呢！",
      "source_fingerprint": "f45eb57d5bb6fb46a1647bfe122c4cfe4ab9986f16a6a1ba0c0a60858a822a01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70008"
      ]
    },
    {
      "uid": "zhcn:90aae7e786d2e78b43b746c4",
      "kind": "character_system_text",
      "source_text": "无论何时何地的比赛……\r\n我都会让大家看到盛开的樱花！",
      "source_fingerprint": "8c1b4138f0b3983a05453ee713b1da0ffc699e6d388c1dc99e7ed2adca50cf08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70009"
      ]
    },
    {
      "uid": "zhcn:032c85e4025221ba4e006f26",
      "kind": "character_system_text",
      "source_text": "制服，是神圣的服装！\r\n每天我都会把它折好的！",
      "source_fingerprint": "ac497360bb45f4447cf2c4f531ca3f727d137286578bda0a8da36215fbdaa92c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70010"
      ]
    },
    {
      "uid": "zhcn:da59e53babc06eb22903146c",
      "kind": "character_system_text",
      "source_text": "因为会忘记穿法，所以我做了说明书！\r\n……下次一定不会再搞丢了！",
      "source_fingerprint": "62628a35d678d6671d394735bca1415c5c2e0f060c010960e8bcb2cef857b965",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70014"
      ]
    },
    {
      "uid": "zhcn:aa6fb77f08d2b4aa54a6f43d",
      "kind": "character_system_text",
      "source_text": "呵呵呵……\r\n这是多么适合爆进的斗篷啊！",
      "source_fingerprint": "a4f7f5620cb4baad849197a4f3419085aeb79c3f330f7393f7c20fc5cceade11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70015"
      ]
    },
    {
      "uid": "zhcn:a42a2e2808bd9d005285306d",
      "kind": "character_system_text",
      "source_text": "我是比平常还火红的\r\n赤热樱花进王！",
      "source_fingerprint": "ad2f2c827c4898a80aba9272243706d953324b69833c196f2c2a28d7ee0ca024",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70016"
      ]
    },
    {
      "uid": "zhcn:d5fb7ae1930543d134705104",
      "kind": "character_system_text",
      "source_text": "内心熊熊燃烧！\r\n唔哇────！",
      "source_fingerprint": "7a658a3399d200272208333c2d8b5ed96fca7e6535a36f8a84565c03908d826f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70017"
      ]
    },
    {
      "uid": "zhcn:cc08dda6cd653ce0bcc7f774",
      "kind": "character_system_text",
      "source_text": "爆进爆进！",
      "source_fingerprint": "b51d45706c9b66b5f683fb585c52c7ee1a1cd047e4bff02b4b6e07c94d285310",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70018"
      ]
    },
    {
      "uid": "zhcn:fb2db204867541e6897dd3ab",
      "kind": "character_system_text",
      "source_text": "让您见识一下，班长的实力！",
      "source_fingerprint": "01cd0eefe2d67531f1ce870dffd2add0d3d31ae0512b985342c1881ded4e6360",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70019"
      ]
    },
    {
      "uid": "zhcn:5cc1b27caf9129cc3f5e050e",
      "kind": "character_system_text",
      "source_text": "很适合我吗？……嗯哼～！",
      "source_fingerprint": "283eb9354a9b32f5ff5afb0ab3d0fd5ed38b4bc41a7c3efeb6afa473bc7b1739",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70020"
      ]
    },
    {
      "uid": "zhcn:2c20a04461facfd6439b3b7f",
      "kind": "character_system_text",
      "source_text": "你发现了吗？我到处点缀了\r\n樱花的别致玩心！",
      "source_fingerprint": "8427739d4c7631e72b610703ca8e9f3c246dbcfae79abff10ffa8f7a1875b6a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1041",
        "70021"
      ]
    },
    {
      "uid": "zhcn:c9749b3fdee216f3f0926d81",
      "kind": "character_system_text",
      "source_text": "比谁都还要适合穿这套制服！\r\n没错，因为我是班长嘛！",
