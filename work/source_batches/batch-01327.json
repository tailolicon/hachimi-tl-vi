    {
      "uid": "zhcn:f378480f54c9ebdfa6e45517",
      "kind": "character_system_text",
      "source_text": "やるわね…！\r\nバーニングしてきたわ！",
      "source_fingerprint": "c9c08c25f87ea99acd2d0f2bef5979dafd1d9f590463779c38c07e73cfadc41b",
