    {
      "uid": "zhcn:5a2dc2e8cf2516ffe9229f10",
      "kind": "character_system_text",
      "source_text": "哎呀哎呀！会场整个很热闹呢～\r\n呵呵，连我也觉得充满精神了～",
      "source_fingerprint": "104d950c0589bf41f608e702630fc749771255dda815919de061dfa8c6c21989",
      "source_path": "character_system_text_dict.json",
