    {
      "uid": "zhcn:6c0914af90167649814a6337",
      "kind": "character_system_text",
      "source_text": "我度过了一段很愉快的时间～",
      "source_fingerprint": "fd64b3f7403dd3413a6ea7b14569d122ad14568f603ac04eea78731a03589167",
      "source_path": "character_system_text_dict.json",
