    },
    {
      "uid": "zhcn:6a05c5fb2134b9950a3da524",
      "kind": "character_system_text",
      "source_text": "始めましょう～。",
      "source_fingerprint": "77277a8286910498f5a8c5a8d65509bec0713d19b4c546a08d40ef184248a084",
      "source_path": "character_system_text_dict.json",
      "json_path": [
