    },
    {
      "uid": "zhcn:16ee047312a2eb28e0ab7727",
      "kind": "character_system_text",
      "source_text": "哼哼哼～♪哎呀……\r\n不好意思，因为太期待要比赛，\r\n不小心就哼着歌了。",
      "source_fingerprint": "18a3f5fd922a15df2fb01f38ecddd1cd6eaba1d2302f75532941875da214ed73",
      "source_path": "character_system_text_dict.json",
