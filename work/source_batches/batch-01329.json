      "source_text": "哇啊啊！一次得到好多喔！",
      "source_fingerprint": "ce4f0359ba375e6106c7969eb99e95b988c376f600c0cb5732e26a93a6c49ca0",
      "source_path": "character_system_text_dict.json",
