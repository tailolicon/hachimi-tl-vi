      "source_text": "咏唱完毕♪",
      "source_fingerprint": "a3c9f6e0385bf25c66353e79751cc28b618349062c24ad9840747d81fa0d0cd2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
