      ]
    },
    {
      "uid": "zhcn:7fb9aad8f0f6a52d8ee9ded9",
      "kind": "character_system_text",
      "source_text": "怎么可能！",
      "source_fingerprint": "5bf21339b55771e854d8c8eae179d3dd5d468df5e8ae85b43ee10cdb188ffd2f",
      "source_path": "character_system_text_dict.json",
