      ]
    },
    {
      "uid": "zhcn:d5266c9c21ba22cc89c1eff3",
      "kind": "character_system_text",
      "source_text": "魔法少女队，要上场啰──！",
      "source_fingerprint": "be7bf8874c1160de184fbe1565bae64e5232b6a2e3a86a1082e30d000ef9e364",
      "source_path": "character_system_text_dict.json",
