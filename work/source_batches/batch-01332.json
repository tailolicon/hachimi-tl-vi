      ]
    },
    {
      "uid": "zhcn:f4cc8490ddf11d97c14bcf99",
      "kind": "character_system_text",
      "source_text": "表现得还不错嘛。辛苦你了！",
      "source_fingerprint": "ffb179944787bcbfec36de06077db30b20d1cd499ca67b3d6c60820b414fa702",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
