      ]
    },
    {
      "uid": "zhcn:c42a2fe366d1930461ff111d",
      "kind": "character_system_text",
      "source_text": "再努力一点啦～！",
      "source_fingerprint": "5329469c32937e7d986965a5d43acc03481e81e66af532d584b63af886847b60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140005"
      ]
    },
    {
      "uid": "zhcn:ece2b16731c79742cd5e2790",
      "kind": "character_system_text",
      "source_text": "使魔，你挺厉害的嘛！",
      "source_fingerprint": "124c1b90b44c8ae9904d09396bab1e5c43b3cb5d9a40ea645cadc700497b50e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140006"
      ]
    },
    {
      "uid": "zhcn:d6598744021455e93f93724e",
      "kind": "character_system_text",
      "source_text": "哼～表现得还不错！",
      "source_fingerprint": "cdc52fac9ce02649f1afd5db82c8b4e26a0e2a7de220abc6df77ba4bd6aae68f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140007"
      ]
    },
    {
      "uid": "zhcn:6ba85e4c6f39ad0fde8da7b4",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140008"
      ]
    },
    {
      "uid": "zhcn:d60f44b6ac1042807b104bed",
      "kind": "character_system_text",
      "source_text": "怎样啦。",
      "source_fingerprint": "0f2ad11833ac7dd9cf982ea3f14b1bdd0a06e14ec808dba1c670c324a4ed9f40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140009"
      ]
    },
    {
      "uid": "zhcn:7a196bd08d5909c00f805608",
      "kind": "character_system_text",
      "source_text": "嗯嗯。",
      "source_fingerprint": "c0dad597dc82a31dd69060476ba8d5a0bc081bd7005ed6641f89ca6ade33857a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140010"
      ]
    },
    {
      "uid": "zhcn:e1e899b1bdad7779e7bfaa79",
      "kind": "character_system_text",
      "source_text": "好厉害好厉害！",
      "source_fingerprint": "fad46d7e87535cf68d1fc1f82588e12fa2e6297ffec4dc45f6b4f028c81f2c2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140011"
      ]
    },
    {
      "uid": "zhcn:7b17d178b4bfdc17f377d1ba",
      "kind": "character_system_text",
      "source_text": "咒语生效了！",
      "source_fingerprint": "40deb23fe6467479eeb75aeadd193b3f63083ad3cc5177b96debc16a062fc564",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140012"
      ]
    },
    {
      "uid": "zhcn:db658ec44f8e6667f12c9d9b",
      "kind": "character_system_text",
      "source_text": "就像魔法一样！",
      "source_fingerprint": "1ddc35989878577e6e0cd7e77fb30d27841ebd28f98d3bcd08b5469233f38e73",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140013"
      ]
    },
    {
      "uid": "zhcn:a350f2d441017fbe217bdb90",
      "kind": "character_system_text",
      "source_text": "呜呜～！",
      "source_fingerprint": "e7ef4d6a10b40585c8da6ad56c7f1d28ccd306112a0dbbcd61d8fb38f675b0aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140014"
      ]
    },
    {
      "uid": "zhcn:7d5b1ab36b1e04ebd3ef491c",
      "kind": "character_system_text",
      "source_text": "嗯嗯嗯……",
      "source_fingerprint": "cf469639c622d25947af0a3263d2c5f0fa7bb855ec61d73632eee1b2092db301",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140015"
      ]
    },
    {
      "uid": "zhcn:919524ae73f61df92b83d4b4",
      "kind": "character_system_text",
      "source_text": "快点夹啦！",
      "source_fingerprint": "2324c49c01968a91a308eb3f652c8567bb2a37301d72d34dc95ac61d45377c05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140016"
      ]
    },
    {
      "uid": "zhcn:8657aa6b62b1c48e714f49f5",
      "kind": "character_system_text",
      "source_text": "为什么！？",
      "source_fingerprint": "bf00d08f6ce39a075b915f9895688d0d98dee86c3b8924961bfbb2b2ffcda46e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140017"
      ]
    },
    {
      "uid": "zhcn:15eb2d02d57451bd5eb0242b",
      "kind": "character_system_text",
      "source_text": "讨厌讨厌！",
      "source_fingerprint": "2132c106993bf33035c1a93d4d258bf58b36a72b429492b8d856361fb49efcef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "140018"
      ]
    },
    {
      "uid": "zhcn:30e3d605fc04d8108b22dec4",
      "kind": "character_system_text",
      "source_text": "明天是这个！\r\n要记得领取喔！",
      "source_fingerprint": "8506822afd6ad139fc025ef1f45b9835b58128827da19656033843a4f9a72839",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "15"
      ]
    },
    {
      "uid": "zhcn:50bdc670e4fe2c84386d97ae",
      "kind": "character_system_text",
      "source_text": "不～要～！我今天要休息～！\r\n我现在缺乏魔力，所以动不了～！",
      "source_fingerprint": "e88f9e337262793ee037b936db4fc53a06e547184b775847df86872980caa4f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20000"
      ]
    },
    {
      "uid": "zhcn:0e9f4fcee30356c44b01997b",
      "kind": "character_system_text",
      "source_text": "累～死～人～了～！\r\n关心主人的身体状况，\r\n也是使魔的工作吧？你明白吗！？",
      "source_fingerprint": "22bf75b5f87824c05ac093fa58e3f43ec0c5a5e55132027184771815330d9df3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20001"
      ]
    },
    {
      "uid": "zhcn:d280de21ecb05a797ed04ca6",
      "kind": "character_system_text",
      "source_text": "Sweepy今天魔力充沛！\r\n等着看我各种帅气的表现吧！",
      "source_fingerprint": "89aabc31a17da3f319ebcad6e7220d825ae30cdd466dd70416868381aa534147",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20002"
      ]
    },
    {
      "uid": "zhcn:2f0f8ffbed43dcaca3705d49",
      "kind": "character_system_text",
      "source_text": "哼哼♪只要天才魔法少女出手，\r\n不管魔法或训练都是小事一桩！",
      "source_fingerprint": "53dd5e8606463c63f7ab5242d8429bb5d7070f1e2dc85fa57570cde9e57c17c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20003"
      ]
    },
    {
      "uid": "zhcn:04250279b15b6a3fe851148b",
      "kind": "character_system_text",
      "source_text": "快～一～点～！\r\n我现在身上有干劲魔法，\r\n要全力进行训练！",
      "source_fingerprint": "025a6d5a37e866f132f0a30a6bde84175aa0c807c7f79a2a1ff7ad9872e999c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20004"
      ]
    },
    {
      "uid": "zhcn:9c29844c53792482061815c7",
      "kind": "character_system_text",
      "source_text": "快点把事情搞定吧！\r\n我要用剩下的时间练习魔法！",
      "source_fingerprint": "7901cb643492858a2d69748a6605f25a6d116c6790cae7a5f68b644ad02dde6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20005"
      ]
    },
    {
      "uid": "zhcn:0dff3bad8d0c8e52912bfc5f",
      "kind": "character_system_text",
      "source_text": "先说好，我可不想做只会\r\n让人觉得辛苦的训练！\r\n要好好想出快乐的训练喔！",
      "source_fingerprint": "1b27728e44a194d35eb0d685dcf6167b3cdd861a786aa9a8b51b5e9c11930a2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20006"
      ]
    },
    {
      "uid": "zhcn:b590ff9664b56c046a514f6f",
      "kind": "character_system_text",
      "source_text": "快点快点，我要做训练！\r\n祖母也说她以前有进行过训练。",
      "source_fingerprint": "698ad324ace7d83f87bc50f9dc8dbeb3ffe2bfac2cb82fd9586cc7e4c21bb16a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20007"
      ]
    },
    {
      "uid": "zhcn:fdea6f479d87c745c4a57e9e",
      "kind": "character_system_text",
      "source_text": "今天要不要做别的事情？\r\n例如练习魔法或找药草。\r\n明天再训练啦～！",
      "source_fingerprint": "43174a727618b5ea7a462b866ff7248087ae2ff9cc007e7f273ea205dd8bccdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20008"
      ]
    },
    {
      "uid": "zhcn:b43834508b994866d575c91a",
      "kind": "character_system_text",
      "source_text": "呜……就算不进行训练，\r\n我也能靠魔法变强啦…………\r\n应该吧。",
      "source_fingerprint": "0b6edc2272ca5d88e97fada64e8abdb29b97e7ba9a75e25983af28a05f072a2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20009"
      ]
    },
    {
      "uid": "zhcn:cbf2e35fe6bc4c2d71425697",
      "kind": "character_system_text",
      "source_text": "不要不要不～要～！！\r\n我说不要训练，\r\n就是不要训练────！！",
      "source_fingerprint": "ecba459f617625c0a4c55e6cca4c64029afd80994e82c7f46b19e379f6b58c38",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20010"
      ]
    },
    {
      "uid": "zhcn:5148ed939f38ea7689776982",
      "kind": "character_system_text",
      "source_text": "紫菀・翠菊……\r\n暴风雨和闪电，一起过来吧！\r\n让训练取～消！",
      "source_fingerprint": "eb4443860c704a966c0351972be902254e4712f46a6239f25c68cc43b9b6f4bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20011"
      ]
    },
    {
      "uid": "zhcn:a0b0700452d4e3d88c933e59",
      "kind": "character_system_text",
      "source_text": "喂！就算Sweepy是天才，\r\n也连续参加太多场比赛了吧！？",
      "source_fingerprint": "cbc0779f1688c13b214c5f841fa370b802a98a698e9fffb9ee0f4b619206bf64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20021"
      ]
    },
    {
      "uid": "zhcn:274c889ed3f77f597e453a52",
      "kind": "character_system_text",
      "source_text": "我明明都说不要了，\r\n为什么还一直安排比赛！？\r\n我一步都不会离开这里！",
      "source_fingerprint": "1cc8ec9509d7da08d7c86222371899a16bb8d61655e8ca1aefdd03296e5a67c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20022"
      ]
    },
    {
      "uid": "zhcn:8423171babd58442479a55c7",
      "kind": "character_system_text",
      "source_text": "今天是Sweepy会赢！\r\n这种事就算不用魔法也能知道吧♪",
      "source_fingerprint": "4c846490ea41fbc92bf46247fb6d019ab756eedc3a90dda735cc6edb6dcd52c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20023"
      ]
    },
    {
      "uid": "zhcn:0ee1cf3f6baf3bc837897ab4",
      "kind": "character_system_text",
      "source_text": "这一天终于到了！\r\n我要让大家知道，\r\n谁才是最强的魔法少女！",
      "source_fingerprint": "4f1e96285a9d96e4329b17457192530e49866a20fedaab5cf2d76d53c5bdc189",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20024"
      ]
    },
    {
      "uid": "zhcn:b564c71dcc209350cbb68505",
      "kind": "character_system_text",
      "source_text": "呵呵，感觉真不错♪\r\n今天应该能使出厉害的魔法！",
      "source_fingerprint": "cc7e509cfd8b4ebffb3a0a0ffe07c7cce44189d578d923499ea1b7426a97b28c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20025"
      ]
    },
    {
      "uid": "zhcn:dfc394fa3e46d029b7cf00b8",
      "kind": "character_system_text",
      "source_text": "现在的状况？\r\n我的心情和魔力都很稳定！\r\n我果然很厉害呢♪",
      "source_fingerprint": "ada44d53a327538e1e28308a370d3b96e7bb1f33cb8b166a9ed4d48e10c4ef02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d491ef52c7c561631c684d46",
      "kind": "character_system_text",
      "source_text": "发财树・非洲菊・剑兰！\r\n等着看吧，Sweepy将会拿下\r\n今天这场比赛的胜利！",
      "source_fingerprint": "125da2677b3496d30f32a5a391cbb56e47ef360c9930e985040d88b10dac9c28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20027"
      ]
    },
    {
      "uid": "zhcn:9e2f57991c8d5257cfb1c282",
      "kind": "character_system_text",
      "source_text": "天才魔法少女Sweepy\r\n无论何时都会获胜！\r\n先准备好帮我庆祝吧！",
      "source_fingerprint": "2a2bc646223a8506da70ad44d527d7502eb7c54e2e306ad78ba37ebaca3ebb18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20028"
      ]
    },
    {
      "uid": "zhcn:52f771ee35bbc752785f43a5",
      "kind": "character_system_text",
      "source_text": "是时候展现我的魔法了！\r\n有没有可能成为我劲敌的对手？",
      "source_fingerprint": "25bf0839d9449772407f8dabe4aab145f3d99399ce98da3d168f74f1aea9a536",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20029"
      ]
    },
    {
      "uid": "zhcn:66a18094e5759905b947dd93",
      "kind": "character_system_text",
      "source_text": "咒语没问题，\r\n魔法护身符也没问题！\r\n嗯，跟平常一样万无一失♪",
      "source_fingerprint": "498ee65154a8b189c2a80f2a7af6f23038cbe1e41ed5a6b7c4f01e644a5bffb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20030"
      ]
    },
    {
      "uid": "zhcn:67e3fc02ddc6a296f43eb733",
      "kind": "character_system_text",
      "source_text": "听好啰，使魔。\r\n主人的比赛，\r\n你从头到尾都要仔细看喔！",
      "source_fingerprint": "6f56820474b80c91d081f6ff986f05c00973b4259166201a38dde2993c69c0ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20031"
      ]
    },
    {
      "uid": "zhcn:8d5540a43b137e5b8b68c994",
      "kind": "character_system_text",
      "source_text": "总觉得心情不太畅快……\r\n不过只要比赛的时候\r\n能好好跑就没问题了吧！",
      "source_fingerprint": "ccbdb48275896dc9748243ff1e89ddf57271519ac5630a73936b29f12fd4ef63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4f2020e53eec0c73a10ce287",
      "kind": "character_system_text",
      "source_text": "嗯……总觉得状况有点不太好。\r\n喂，你要比平常更努力\r\n替我加油喔！",
      "source_fingerprint": "b63b2254fb9ff0d483932724abca30425768b104804830767a8ab19a712609fc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20033"
      ]
    },
    {
      "uid": "zhcn:8370686f2e76c1df90cc64ad",
      "kind": "character_system_text",
      "source_text": "天才魔法少女没有办不到的事情！\r\n……没错，今天可能只是\r\n会比较辛苦一点而已！",
      "source_fingerprint": "b5f6c1de655c381235a41ae189e038f00b49bd481223e0db0cb34818f9cd36a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20034"
      ]
    },
    {
      "uid": "zhcn:4cd2f0607734846a2183a2b5",
      "kind": "character_system_text",
      "source_text": "呜呜呜～！\r\n我可是天才魔法少女，\r\n我、我会赢啦！一定会的！",
      "source_fingerprint": "10cdd30a57494ce6aab2c850b644ca5b95a598d8e4fd8894424d190a5a3cf631",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20035"
      ]
    },
    {
      "uid": "zhcn:0809602ef8eed7aa46143fe7",
      "kind": "character_system_text",
      "source_text": "你、你干嘛一脸担心的样子！\r\n我就算状态不太好，\r\n也不可能会输啦！",
      "source_fingerprint": "d7d7cad8f468b40e350744d0c91ccbd537c3d4026a24b9c8ba786fcbd505ba20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20036"
      ]
    },
    {
      "uid": "zhcn:2569ddf742bfbb8ffa64ea71",
      "kind": "character_system_text",
      "source_text": "祖母……我应该没问题吧。\r\n毕竟我努力练习过了。\r\n所以一定……",
      "source_fingerprint": "5be79f950e0508f0380791054381f466eb64eb104c3da56b2676ce8a1991f0d1",
      "source_path": "character_system_text_dict.json",
