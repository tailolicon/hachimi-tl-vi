      ]
    },
    {
      "uid": "zhcn:0d53a478c980e7ba6d9e0c0a",
      "kind": "character_system_text",
      "source_text": "咦！？",
      "source_fingerprint": "6878a171cd7c622ff4ce46652aac560c21f087f2463528166016ac47a0c718e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
