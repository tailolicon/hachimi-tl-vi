      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20046"
      ]
    },
    {
      "uid": "zhcn:64cfc608b674818d96891634",
      "kind": "character_system_text",
      "source_text": "是大海耶！",
      "source_fingerprint": "9744130060461a3c7c9adb781383da0c45d86b02a79a7f784bfa7b182bed0f38",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
        "20047"
      ]
    },
    {
      "uid": "zhcn:10bdec6788739ded8cf7c93a",
      "kind": "character_system_text",
      "source_text": "我觉得你努力过了，\r\n所以姑且称赞你一下！",
      "source_fingerprint": "45e41ed5fdd0443847e8cb8930aad0d967f99609eecd3be4d7e20024d1ecd28b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
