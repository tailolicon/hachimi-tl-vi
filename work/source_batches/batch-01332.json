      "json_path": [
        "1044",
        "20051"
      ]
    },
    {
      "uid": "zhcn:1348bbf80b35e9caac3a6457",
      "kind": "character_system_text",
      "source_text": "让大家见识我们的魔法吧！",
      "source_fingerprint": "93114eadea650eda7ab8c00c254672cfada58aa4046ab1e5713aee6e6cbdc384",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1044",
