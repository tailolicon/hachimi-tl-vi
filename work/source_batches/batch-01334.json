        "11"
      ]
    },
    {
      "uid": "zhcn:941c931db449ef463296205a",
      "kind": "character_system_text",
      "source_text": "哎呀哎呀，要训练了吗？",
      "source_fingerprint": "55314fd6d1c804f44577af00558f30edabc3e8425d9c243a3cab878019b496f2",
      "source_path": "character_system_text_dict.json",
