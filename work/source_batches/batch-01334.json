      ]
    },
    {
      "uid": "zhcn:1281e5d53b2bf4d31388e4eb",
      "kind": "character_system_text",
      "source_text": "身体里面一直有力量涌现呢……！",
      "source_fingerprint": "7dec2e46c7c4cb43b96a9adaf5a246705e69f56f8209c0cd6c3d8c73a4d54a98",
      "source_path": "character_system_text_dict.json",
