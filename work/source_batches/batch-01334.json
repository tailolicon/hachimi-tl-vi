      ]
    },
    {
      "uid": "zhcn:8f514e87a324838f935327f4",
      "kind": "character_system_text",
      "source_text": "呵呵呵，回忆真的是很棒的东西～",
      "source_fingerprint": "e3370d1e920a2ec4cc034252b8040d745c492f2cd9654719cb94831a54ad61f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1045",
        "110001"
      ]
    },
    {
      "uid": "zhcn:c6bfc9c704a90df00ffe1080",
      "kind": "character_system_text",
      "source_text": "有你想要报名的比赛吗～？",
      "source_fingerprint": "568412411939b291e79671593524988a03fafb2d6e90705c12e501962f66755b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1045",
        "110002"
      ]
    },
    {
      "uid": "zhcn:451ece5dd4ae438f51ef9ecb",
      "kind": "character_system_text",
      "source_text": "好～好乖好乖♪",
      "source_fingerprint": "e6c113adfcd69eafc7c0e61424474eaf1fb2efcd58b5ccdef868eafa3726a1b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1045",
        "1106"
      ]
    },
    {
      "uid": "zhcn:abf76ab3bc723ea412d5eddb",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1045",
