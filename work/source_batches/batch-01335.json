      ]
    },
    {
      "uid": "zhcn:c39ec623ae9096c695ae69a8",
      "kind": "character_system_text",
      "source_text": "好棒好棒～！",
      "source_fingerprint": "145e6dc45469c9782a23327442378de2b526df106f43d104e87b243976003bf6",
      "source_path": "character_system_text_dict.json",
