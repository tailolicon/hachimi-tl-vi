    },
    {
      "uid": "zhcn:e00fd23424a68674953c392d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "向织姬介绍了几本有关星星的书后，\r\n我们就变得更常聊天了。\r\n……她真的很喜欢星星呢。",
      "source_fingerprint": "90e7b815e3577d96141930d76b63c2fbc4967fd902c22cb4c8e2b835e5a32797",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
