      ],
      "json_pointer": "/1047/91013"
    },
    {
      "uid": "zhcn:73c17899445065408d2abd91",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "秋天气温凉爽，湿度也低……\r\n对我跟书本来说\r\n都是很舒适的季节。",
      "source_fingerprint": "5912b7916fc0d60b399221fb81d4b1677577812f880c792d0c1003e5359faf12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
