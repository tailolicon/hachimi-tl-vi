      ],
      "json_pointer": "/1047/90015"
    },
    {
      "uid": "zhcn:84b6b1c756d8737f63ab1a34",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "夜桜の下を歩いているだけで\r\n物語の中にいるみたいに思える…\r\nとても幻想的で、素敵ですよね。",
      "source_fingerprint": "62f67df5347090d263f211c0e6326362b0b120a6d34a5b1e8118fb43e1059ca7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
