    {
      "uid": "zhcn:d683c2fc302255a4fb11e5ac",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "ハッピーバレンタイン……！",
      "source_fingerprint": "2d2dee3aebc92accd3d836ee63bfb4f9dfa6a4e5b1bb5580ac2652dcc2fd570c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
