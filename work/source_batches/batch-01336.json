        "1047",
        "91012"
      ],
      "json_pointer": "/1047/91012"
    },
    {
      "uid": "zhcn:ceddbcb25e0d888a28d80949",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "呜呜……竟然晒出了眼镜痕……\r\n最近这阵子我无论遇到什么事\r\n都不会拿下眼镜的……！",
      "source_fingerprint": "61a39ac285ff5095db2bb298d2c986eff71563e691bbd0273bfc78b05973065a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
