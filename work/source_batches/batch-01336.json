    {
      "uid": "zhcn:d9c9380fc002257dff2bc748",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "情人节快乐……！",
      "source_fingerprint": "b864b7841af89022e20379f78c16aa3ac36fd63bcfd3cb24ab6d04b749dcdc58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
