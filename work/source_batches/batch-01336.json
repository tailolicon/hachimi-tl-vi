    {
      "uid": "zhcn:3d0f5420e75a4010bed24c17",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "咖啡好厉害喔……！\r\n只要告诉她书本内容，\r\n她就能配合故事挑出适合的咖啡！",
      "source_fingerprint": "52e77bd468b7797e944dffcb0de04bc49c1eadb31def940ff328a7bef319e335",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
