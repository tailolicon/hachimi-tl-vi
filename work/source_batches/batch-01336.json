      ],
      "json_pointer": "/1047/90016"
    },
    {
      "uid": "zhcn:ef4d53293f44988f33f02a61",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "夏をエンジョイできる水着を選んで\r\nくださるとタイキさんが…！わ、\r\n私に着こなせるんでしょうか…！？",
      "source_fingerprint": "3f513cc439ba8f85b0dea825b8ff61f2b50b7bb8ceb2c5caf00395777090c775",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
