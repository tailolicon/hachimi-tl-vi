    },
    {
      "uid": "zhcn:e6f3194fcae1834b88365103",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "眠る前のあの一瞬…夢と現実の\r\n狭間にいる時が、1日の中で最も\r\n素敵な時間かもしれません♪",
      "source_fingerprint": "382774a257ff0687595d4e007438b54a139ce3da5b083d2767ff2f945f9f3bb9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
