      "source_text": "飞鹰子会加油的哦☆",
      "source_fingerprint": "6723fc79cd57207be368ec6b40bbdbe5f5d443db145a80b63f6f74d5ff4c90a8",
      "source_path": "character_system_text_dict.json",
