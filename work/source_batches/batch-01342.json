      "json_pointer": "/1049/70021"
    },
    {
      "uid": "zhcn:47342e512967bcc9ea0b4468",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "穿制服的时候我也是会老老实实的啦……\r\n……马马虎虎吧。",
      "source_fingerprint": "831ba39a3e4c336b551df476c560cea2d3c0c4f5a49f6ffcf0def4939b07e354",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
