  "entries": [
    {
      "uid": "zhcn:4c4fdd1f93acf541fbf15e2e",
      "kind": "character_system_text",
      "source_text": "这场战斗真是势均力敌呢。",
      "source_fingerprint": "e3ced0c9564cc50e536613914a5632590c7fef57129b11d04d1022f264667344",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1006"
      ]
    },
    {
      "uid": "zhcn:f82f9712dfaa9471afa2933b",
      "kind": "character_system_text",
      "source_text": "此刻又写下新的一页……！",
      "source_fingerprint": "f57adb2c374124b81c4d7a3478daa72c3d16335b78b1907eef82eff1d35a32ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1007"
      ]
    },
    {
      "uid": "zhcn:e55cd0ce1f444b573ae4b44f",
      "kind": "character_system_text",
      "source_text": "大家一起同心协力吧！",
      "source_fingerprint": "1155d95d826ed70079c36b679fed2f11968526de59bab4c76e53b97917f6ceda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1008"
      ]
    },
    {
      "uid": "zhcn:9d8a3798dd82310211f5a695",
      "kind": "character_system_text",
      "source_text": "好的……！",
      "source_fingerprint": "f91332ecdc32ec0e3acd1635182bb3c2ab89c5cbafdd4d4e109367918214e129",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1054"
      ]
    },
    {
      "uid": "zhcn:36ecd9a24241a6a4fd41874b",
      "kind": "character_system_text",
      "source_text": "属于我们的故事……！",
      "source_fingerprint": "f50176cbc178e75f381f4619e79148a170f52fd60bf90d25208fa8cef92a1d2f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1066"
      ]
    },
    {
      "uid": "zhcn:4133fc69df064a28b34bfa78",
      "kind": "character_system_text",
      "source_text": "什么！？",
      "source_fingerprint": "8fae634bd9fed421672fb72e9b24f793384cadde5c35454a04573eec752d6239",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1094"
      ]
    },
    {
      "uid": "zhcn:7e78134ef4295d14f4608b89",
      "kind": "character_system_text",
      "source_text": "我、我会加油的……！",
      "source_fingerprint": "6b04d5b7e2a96814bce1f15a5c407b23c50d5163861d7e6ee292d4a82aff2526",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1099"
      ]
    },
    {
      "uid": "zhcn:53b2f5a34bd599a8a76336cb",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "11"
      ]
    },
    {
      "uid": "zhcn:3814adc05c996d5b38b7cd15",
      "kind": "character_system_text",
      "source_text": "勇气的咒语……！",
      "source_fingerprint": "223c79ba9b20d4583e41017b89492b5f6032b76f3a6fc3e74bdc4d7fdd79d6f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1100"
      ]
    },
    {
      "uid": "zhcn:eb850a2eec6d584b318e45e1",
      "kind": "character_system_text",
      "source_text": "要安排怎么样的训练呢？\r\n我会依照训练内容\r\n准备合适的书。",
      "source_fingerprint": "2ec58bf0c22cb9d0ed6a50c4c7da0e9ab7f824823b21ef3493407f44c7a8673e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "110000"
      ]
    },
    {
      "uid": "zhcn:0daae49aa9d08a0629ecd57d",
      "kind": "character_system_text",
      "source_text": "你想知道有关学园的英雄传说吗？\r\n每个故事都很引人入胜喔！",
      "source_fingerprint": "43dccc78b0f1b549c10a1744ab98e466b8f61e293ebbd07de720ea799f3dd213",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "110001"
      ]
    },
    {
      "uid": "zhcn:dc8a83fb8afd5e95f4fbf5db",
      "kind": "character_system_text",
      "source_text": "要登录参赛对吧。\r\n呵呵，不知道这次比赛会创造出\r\n怎么样的插曲呢……？",
      "source_fingerprint": "832bfe7d3034abf44bd051fa8b853c79a13c3e95917e8c0f6e9b1742cf2aea88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "110002"
      ]
    },
    {
      "uid": "zhcn:514b77b56487b1398f695660",
      "kind": "character_system_text",
      "source_text": "好、好的……！",
      "source_fingerprint": "9618e200cda3b2055b7749d381fa802441119d40eeaf97ae14f362aa4fb69367",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1164"
      ]
    },
    {
      "uid": "zhcn:74dac813260ec1b00011a6af",
      "kind": "character_system_text",
      "source_text": "我不会输的……！",
      "source_fingerprint": "3f3c88c3e5f00fd6ce5746853af35d774fcb8e1e70d0a13a853c015b03b00116",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "1167"
      ]
    },
    {
      "uid": "zhcn:b69e72c7b288442cb0b562a3",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "12"
      ]
    },
    {
      "uid": "zhcn:a4aa51ad543376538782d188",
      "kind": "character_system_text",
      "source_text": "充满了力量……！\r\n感觉跟平常的我完全不同……",
      "source_fingerprint": "174fa4c22b1a19971ad2f1fac4e0847743f502eb3db7eddfff3f10b6b41fa3b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "120000"
      ]
    },
    {
      "uid": "zhcn:77b3153bee88c619f871b1fa",
      "kind": "character_system_text",
      "source_text": "那个，\r\n这是你的登录奖励。",
      "source_fingerprint": "ac6329efe6b8bf514cde86483c27e01ef1a8eb835bc625f814c9cf86ce74de42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "13"
      ]
    },
    {
      "uid": "zhcn:9f3cf0b938c9db2ac5da3f84",
      "kind": "character_system_text",
      "source_text": "我、我会为你加油的……！",
      "source_fingerprint": "fe0dc92c841ac535a30824c662d37845a8dd75036757d47822ff91c52c5e91d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140000"
      ]
    },
    {
      "uid": "zhcn:cf9d936b5e8ac0456205c0d7",
      "kind": "character_system_text",
      "source_text": "成功了呢！",
      "source_fingerprint": "d4ee343917a8c038770956ff3311b839e41d406f29ddc1913f16d6977e136061",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140001"
      ]
    },
    {
      "uid": "zhcn:6251bc2d45a604514186d37d",
      "kind": "character_system_text",
      "source_text": "啊啊……！",
      "source_fingerprint": "ca2bfeb016b31251d02d124e40bbc72c49d33cc628f270bda341fc51699d29a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140002"
      ]
    },
    {
      "uid": "zhcn:181c671e063fbd0f6df37b27",
      "kind": "character_system_text",
      "source_text": "这段佳话值得永远流传于后世……！",
      "source_fingerprint": "9a7d3cc7f75cee35ec237dac41da8e4e83ae3b0301e516d420826348b878bad6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140003"
      ]
    },
    {
      "uid": "zhcn:1f00106f627d2c3c3297bd93",
      "kind": "character_system_text",
      "source_text": "来了一位可爱的英雄呢。",
      "source_fingerprint": "648080e8bdc866e4f973a2c83e4344149373cd96074d626a43d1aea3be8f37dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140004"
      ]
    },
    {
      "uid": "zhcn:72956fd7207bd8a6bff80879",
      "kind": "character_system_text",
      "source_text": "下次我会成功的……！\r\n因为这就是故事进展的基本原则！",
      "source_fingerprint": "36e524e8812ae13eacdf93f43556de86bc81b42bbb8c6c07cfdcfb5f2cd4ca7b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140005"
      ]
    },
    {
      "uid": "zhcn:8b137bf75c5b1c4e66775e58",
      "kind": "character_system_text",
      "source_text": "这段佳话值得永远流传于后世……！",
      "source_fingerprint": "9a7d3cc7f75cee35ec237dac41da8e4e83ae3b0301e516d420826348b878bad6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140006"
      ]
    },
    {
      "uid": "zhcn:cd896706fc9e9101a303e56e",
      "kind": "character_system_text",
      "source_text": "来了一位可爱的英雄呢。",
      "source_fingerprint": "648080e8bdc866e4f973a2c83e4344149373cd96074d626a43d1aea3be8f37dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140007"
      ]
    },
    {
      "uid": "zhcn:b6cbc7cd23abbb0a1f9898a0",
      "kind": "character_system_text",
      "source_text": "好的。",
      "source_fingerprint": "092cd95e8a64d58d136c3c650b8d9d7cc23ad4ad69c0c649443874ffaa82fc65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140008"
      ]
    },
    {
      "uid": "zhcn:b889e29978f84ff76e12fec0",
      "kind": "character_system_text",
      "source_text": "咦？",
      "source_fingerprint": "86da1b53b8e9030921223d1116840eec3ad77bbe410b4f3802da0abd63a8d247",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140009"
      ]
    },
    {
      "uid": "zhcn:1d455a9edcf8d680028d49cf",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140010"
      ]
    },
    {
      "uid": "zhcn:51e32459df8162fc8da4cde2",
      "kind": "character_system_text",
      "source_text": "竟然出现如此奇迹……！",
      "source_fingerprint": "e8ef33dcb784ddf9a6c80f57ae4501d2b90f6dedb9bb4ba4af1620f9820fed76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140011"
      ]
    },
    {
      "uid": "zhcn:6373dff591a581ad8ff759e0",
      "kind": "character_system_text",
      "source_text": "好厉害……！",
      "source_fingerprint": "e6bb5498226b3d866f26cf0a04d9c2d87ff7eaab73c7dfea7fad2f870ec5d839",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140012"
      ]
    },
    {
      "uid": "zhcn:fbb61d342bddc4cbeeb248fd",
      "kind": "character_system_text",
      "source_text": "哇哇……！",
      "source_fingerprint": "1582ac7bc304e310316d682ed9bd264f7276cf2f966d9952e4e0ff7b944bcb5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140013"
      ]
    },
    {
      "uid": "zhcn:442e1365c9d186ac439cb884",
      "kind": "character_system_text",
      "source_text": "嗯嗯……！",
      "source_fingerprint": "72f8337f79bb74f2cbf03f35f54f6f201414d28c548e0ae15725c88dac825871",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140014"
      ]
    },
    {
      "uid": "zhcn:35e454a88826e7cdd3f0c519",
      "kind": "character_system_text",
      "source_text": "心跳加速……",
      "source_fingerprint": "c0cf2ae4288d6c9705695b217675751087c21ce7837d34fe8b651e395fadf360",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140015"
      ]
    },
    {
      "uid": "zhcn:e8b92689504cff1718abe3a6",
      "kind": "character_system_text",
      "source_text": "我好期待接下来的发展……！",
      "source_fingerprint": "78f260682ce97f4f1339742229c7dd7a2f6088004052f1b5ec20979f52c5c8b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140016"
      ]
    },
    {
      "uid": "zhcn:ddc4a556310f7c6fe46918e8",
      "kind": "character_system_text",
      "source_text": "怎么会……",
      "source_fingerprint": "fd6d8458e0d0c283a28cdf0b2904ed93a7dfbc7b68b667ed9ee61b5a7aaf69e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140017"
      ]
    },
    {
      "uid": "zhcn:78056db50d3a4ed72f195497",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "140018"
      ]
    },
    {
      "uid": "zhcn:56ea8958f0371c10deebf590",
      "kind": "character_system_text",
      "source_text": "明天好像\r\n可以收到这些奖励。",
      "source_fingerprint": "061610ddae348978fcbd7787fb660ad391aab28d304511783d1c0dae30d8e349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "15"
      ]
    },
    {
      "uid": "zhcn:342295f11a34cbeea20a09d0",
      "kind": "character_system_text",
      "source_text": "呼……呼……抱歉。\r\n我自认不只有着重于读书，\r\n也有兼顾锻炼体力的说……",
      "source_fingerprint": "7a4a30db85a645f792f2b6ae1afac4b97799a70d47e1f10887822e7d349350a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20000"
      ]
    },
    {
      "uid": "zhcn:4aefdc6b3239eab4c1e3cad8",
      "kind": "character_system_text",
      "source_text": "呜呜，体力已经……\r\n要是想当英雄，\r\n得更努力锻炼才行呢。",
      "source_fingerprint": "27e79a160af5a74feee3488e4fa26999dba819c297fb310ae4d2880e0869aff4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20001"
      ]
    },
    {
      "uid": "zhcn:e524aa5258e12c38d160da9e",
      "kind": "character_system_text",
      "source_text": "要做哪项训练呢！？\r\n我总觉得……今天一定\r\n能够看见崭新的自己！",
      "source_fingerprint": "f9854764b3b7eee7d5f2fbc03cf5e48fea07d6848eda885d037198da4fa6e56f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20002"
      ]
    },
    {
      "uid": "zhcn:9198c9c95ec7740d5930c8f7",
      "kind": "character_system_text",
      "source_text": "最近我喜欢的作家\r\n非常努力地创作新作品……\r\n我也不能输呢！",
      "source_fingerprint": "5323de4428b80967f9afcbf9eb388a0e06d4e2942a12247148cb305f9a7afc0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20003"
      ]
    },
    {
      "uid": "zhcn:0faa28dcf0fc0d46ca3814d3",
      "kind": "character_system_text",
      "source_text": "经历的每个训练都是为故事\r\n增添色彩的小插曲……只要这样想，\r\n训练就会变得愉快了起来！",
      "source_fingerprint": "59a7ddeacbfe01fb080b54e13e05396b2454067b80e90ff536a8a074339ad6e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20004"
      ]
    },
    {
      "uid": "zhcn:a2bf703b8d317622904cb6e5",
      "kind": "character_system_text",
      "source_text": "虽、虽然没有根据……\r\n但我总觉得，今天自己一定能够\r\n展现出比平时更优秀的一面……！",
      "source_fingerprint": "a4aa4bdd977ebe01c31ec559ac3f3aa5aa910066985f87ae4993c9b5f96d2523",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20005"
      ]
    },
    {
      "uid": "zhcn:8c1559acd364c4083e61a8e6",
      "kind": "character_system_text",
      "source_text": "目标越高，平时的努力就越重要。\r\n为了成为英雄\r\n我一定要加油……！",
      "source_fingerprint": "5c8ab26b395018fc3feced29295cda91f5a16a2ec4ccef1b0f0cee6179b77c1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20006"
      ]
    },
    {
      "uid": "zhcn:498b8607827c4429272c48d8",
      "kind": "character_system_text",
      "source_text": "要开始训练了吗？\r\n我会照着教学书籍上的\r\n内容去试看看的……！",
      "source_fingerprint": "92942d6ec8b5674cb22882761420454fd62e5473b6f3a5136117ed1ef9db7ecf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20007"
      ]
    },
    {
      "uid": "zhcn:d4465495a455605b3398399d",
      "kind": "character_system_text",
      "source_text": "唉……不知道「罗布・罗伊」\r\n是否也曾像我一样，\r\n有过无法发挥实力的时候呢……？",
      "source_fingerprint": "a02ea447b3d9c826469862a435a857c069953d226343cf603141640363663c04",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20008"
      ]
    },
    {
      "uid": "zhcn:88003ff90a38283decd306ec",
      "kind": "character_system_text",
      "source_text": "明明知道非得努力不可，\r\n但总觉得胸口好沉重……\r\n我果然……还不够成熟呢……",
      "source_fingerprint": "eaac49411411b7ed1fa1ac3ad9554f6d7c2def424d03f7dea2226c9483cbc21c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20009"
      ]
    },
    {
      "uid": "zhcn:52d55013dd55dc99bc2cb943",
      "kind": "character_system_text",
      "source_text": "我得再更积极向前才行……\r\n呜呜……我还以为读点书后\r\n就能重新打起精神了说……",
      "source_fingerprint": "8354e1abaa6232a8822923ce570dd1dc682787c3230feeaf4972f3d8e8f3a883",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20010"
      ]
    },
    {
      "uid": "zhcn:c28a1b583a8c04de8e6da83e",
      "kind": "character_system_text",
      "source_text": "得努力克服的场面……\r\n要是真正的英雄，\r\n绝对不会在此停下脚步的说……",
      "source_fingerprint": "7a159cc45bb6cc3c4989f82baca69601494d4735abe27922f8974844bbab0f5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20011"
      ]
    },
    {
      "uid": "zhcn:7ee360724919ca15a3809821",
      "kind": "character_system_text",
      "source_text": "那个……可以休息一下吗……？\r\n我在战争作品中看到，\r\n太过勉强往往会造成劣势……",
      "source_fingerprint": "caeb32e9a2bd8f82c4d14645725142c96ad8893683c38db711c7ae22615919f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20021"
      ]
    },
    {
      "uid": "zhcn:b51d0d20e143896eadbb8d3c",
      "kind": "character_system_text",
      "source_text": "成为英雄之路从踏出第一步做起。\r\n不过……要是连一步都走不动\r\n是不是就本末倒置了……",
      "source_fingerprint": "6893a32135e1a98ebd7e9892ec1f306a1db29534c3deae6048f8b43e88835aa2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20022"
      ]
    },
    {
      "uid": "zhcn:9febef1db141f6b0773b6257",
      "kind": "character_system_text",
      "source_text": "我要藉由这场比赛\r\n创造将流传于后世，\r\n属于荒漠英雄的英雄传说……！",
      "source_fingerprint": "cb5238eddbd8824b086405d33df2456ed666d7b5c4a4e9384b7eb6824a236bb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20023"
      ]
    },
    {
      "uid": "zhcn:2d60ca4d261cb96d1be6c454",
      "kind": "character_system_text",
      "source_text": "训练员……我的读者，\r\n请见证我一步步\r\n变成英雄的故事……！",
      "source_fingerprint": "68e85aed12ad3d7b76ae62f6d53bf3cc4dc730f3a6f8abc645b104b26039a376",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20024"
      ]
    },
    {
      "uid": "zhcn:eb0ddd54201c64aa4457da71",
      "kind": "character_system_text",
      "source_text": "我已经在脑中描绘出了\r\n赢得胜利的故事。\r\n接下来只要照着做就行了……！",
      "source_fingerprint": "fb094723b7f73a9c2d10d211d5aa12b1474822eed19be3ba4f4f299f0907705b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20025"
      ]
    },
    {
      "uid": "zhcn:c870ecfaef79bcd99dbc37dd",
      "kind": "character_system_text",
      "source_text": "只要赢得比赛\r\n就能离憧憬更近一步。\r\n……很、很好，我要努力……！",
      "source_fingerprint": "b1f40e41c7984b84e3058e505fc3fd2f4fdb53976d9b72c78e73eae0210fdcf3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20026"
      ]
    },
    {
      "uid": "zhcn:6412d6ef52fdc1e54f5833fc",
      "kind": "character_system_text",
      "source_text": "视野好像比平时更清晰……\r\n能清楚地看见大家的一举一动。\r\n要是能在比赛中善加利用的话……！",
      "source_fingerprint": "6a0d0f281a6ecfb867a8e244ec8ababbbefab9c8ce127fc00bb73aa0aeb6ca68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20027"
      ]
    },
    {
      "uid": "zhcn:030ece73c92c80ee422e5581",
      "kind": "character_system_text",
      "source_text": "虽然我可能……无法\r\n表现得像「罗布・罗伊」那样，\r\n但我还是会尽全力奔跑……！",
      "source_fingerprint": "1ffff3c9ec5441ee0d0b9d005d4d368de191604ef69dfe4eb40e5869546bf2ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20028"
      ]
    },
    {
      "uid": "zhcn:55663a8898cac85b8f5eedfb",
      "kind": "character_system_text",
      "source_text": "无论什么状况都不能放弃，\r\n必须坚持到最后……\r\n我很希望能留下成果。",
      "source_fingerprint": "da0b2ad1af9cf3fe3b4678ddbaa0627ec34c6e6a0b13f55a969ff2c3aef790ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20029"
      ]
    },
    {
      "uid": "zhcn:a3e0daf7034af5aecc615506",
      "kind": "character_system_text",
      "source_text": "比赛前真是紧张……\r\n不过我觉得自己能够\r\n保持平常心发挥实力。",
      "source_fingerprint": "f27927217fdf0678eb5b360c4f3cb044a7e0049013c182bbe4d0c436b14ea493",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20030"
      ]
    },
    {
      "uid": "zhcn:6ac59d4119e61c737a68dc1b",
      "kind": "character_system_text",
      "source_text": "为了能在未来被称为英雄……\r\n我得不断累积战绩。\r\n训练员，我出发了。",
      "source_fingerprint": "26b30175c7b1d3c84bed1bf61ca7777dd4950e8a3e5274ff9517c555c3054c2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20031"
      ]
    },
    {
      "uid": "zhcn:3a2fe09a250a1f5984f2680b",
      "kind": "character_system_text",
      "source_text": "虽然还有些许不安……\r\n但我是一路全力以赴努力过来的。\r\n我会尽其所能地去做的……！",
      "source_fingerprint": "37fc70f1fb84e827fae7b3ebd7b7329ea37b46c7f071f179b532a65d384ca767",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4cd99fc54c25785201a50266",
      "kind": "character_system_text",
      "source_text": "只、只要读书让自己冷静下来，\r\n一定会没问题的。\r\n应、应该吧……",
      "source_fingerprint": "8a4fb8783ef5a7879a126eecf7d671ec4a2a9cba0679e6a070d5b150b0eee043",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20033"
      ]
    },
    {
      "uid": "zhcn:b8bf304b8ab70e322974969f",
      "kind": "character_system_text",
      "source_text": "咦？镜片起雾了……\r\n呜呜，怎么挑在比赛前起雾，\r\n害我心情变得好消沉……",
      "source_fingerprint": "b7224e747ae2eb16beb12b8b4ca95d4eefbf5e4780a496e91e6da205af28ccfc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20034"
      ]
    },
    {
      "uid": "zhcn:dcb9e2ba7a98bfd6a59fbd8e",
      "kind": "character_system_text",
      "source_text": "无论状况再怎么糟糕……我都会坚持\r\n跑到最后。因为我相信任何结果\r\n都有助于缔造未来……",
      "source_fingerprint": "1bb828bdd9d11040f1f7ead3021140f8d8cb3f5a044477b461e8a468042d22c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20035"
      ]
    },
    {
      "uid": "zhcn:24531d172c511edd9a9a3312",
      "kind": "character_system_text",
      "source_text": "竞争对手的实力是多么坚强……\r\n我不能气馁，\r\n即使对手再强还是得战斗……！",
      "source_fingerprint": "68a4112059a49f7a97dc53618fd34dfd1fe3c9b1357632e087bc7c326a85d1e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20036"
      ]
    },
    {
      "uid": "zhcn:dd5ab1efebb95746cfbd0278",
      "kind": "character_system_text",
      "source_text": "绝不能气馁……\r\n这样会连配角都当不成的……！\r\n……我很清楚，可是……",
      "source_fingerprint": "99987329b957d17363a35307f6343f05932cfc48946c98a803e8424b36b426d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20037"
      ]
    },
    {
      "uid": "zhcn:4d409575b79595fd21b7a587",
      "kind": "character_system_text",
      "source_text": "我会加油的……！",
      "source_fingerprint": "57839f6433f03c4d1dfcc9a58b67ce28a616c9adaf0c18304dc626c7a29ca94e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20038"
      ]
    },
    {
      "uid": "zhcn:e98de4738a19ffa23e699c50",
      "kind": "character_system_text",
      "source_text": "我上场了……！",
      "source_fingerprint": "fffd697b13a34286473498c1e41912d1a9804c4ee5b334a0ea3e4e5eddfcae80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20039"
      ]
    },
    {
      "uid": "zhcn:5acc79a2fdef160b3f2b4a89",
      "kind": "character_system_text",
      "source_text": "脚踏实地……！",
      "source_fingerprint": "1759deba5bf369876def1665c5d9c78e239aeb841548f602d1a9b84511b63b13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20040"
      ]
    },
    {
      "uid": "zhcn:7ac4eeecaebcf66931c6c202",
      "kind": "character_system_text",
      "source_text": "呃……",
      "source_fingerprint": "82fec3801d176574a5c73b753c0428097ba4efacd01f74d8bbeb0f256d85692f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20041"
      ]
    },
    {
      "uid": "zhcn:3059a08b8c1f2cb4930a4fde",
      "kind": "character_system_text",
      "source_text": "呀……！？",
      "source_fingerprint": "051f0f01c32f36651f0729cb937301589ae120ebe4a673ae9fba57709afcaa45",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20042"
      ]
    },
    {
      "uid": "zhcn:eb48976402d18ca6abb67e98",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20043"
      ]
    },
    {
      "uid": "zhcn:19f99bd84ec07130f35438b0",
      "kind": "character_system_text",
      "source_text": "冒险即将展开！",
      "source_fingerprint": "26af58e8d40d2d6f46af5f948e94f369f949f29415b29b7f1aec0cdf67471c93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f742263a38af51d1d2d4b7f6",
      "kind": "character_system_text",
      "source_text": "是海边耶……！",
      "source_fingerprint": "2f31c7fc956b4578f3286ced10cabaf005a17e4a1dae89a3d9916d78acd0b12b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20047"
      ]
    },
    {
      "uid": "zhcn:f4202ff17203731b3c3f6235",
      "kind": "character_system_text",
      "source_text": "故事还会继续。\r\n……我会让故事继续下去！",
      "source_fingerprint": "a243286296cfb496048097035b27c473fbda20072df45770622fce9de49cb788",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20049"
      ]
    },
    {
      "uid": "zhcn:279636e82beb7f122b981327",
      "kind": "character_system_text",
      "source_text": "受你照顾了……！",
      "source_fingerprint": "2dffcc8803cca7136463544b925efdce16304e6d41ffa49eced5f5990f5a038a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20050"
      ]
    },
    {
      "uid": "zhcn:7f4ebfc4ffeda5c24420084f",
      "kind": "character_system_text",
      "source_text": "由、由我来引领大家……！",
      "source_fingerprint": "a31de3ed1f28ac4e73f5c1a51f54c84674b64cfcf9d44198a787c88cd7e81d45",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "20051"
      ]
    },
    {
      "uid": "zhcn:0e964606606a396ece3ccea2",
      "kind": "character_system_text",
      "source_text": "我们走吧……！",
      "source_fingerprint": "3fb3e8139d8e5ca7738f28f899e42ac3bf1049d6391bcceebdbad663d4864656",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "2030"
      ]
    },
    {
      "uid": "zhcn:df7ade8b980b5a28028c7b21",
      "kind": "character_system_text",
      "source_text": "大家一起同心协力吧！",
      "source_fingerprint": "1155d95d826ed70079c36b679fed2f11968526de59bab4c76e53b97917f6ceda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
        "2031"
      ]
    },
    {
      "uid": "zhcn:295ba3646e20597666f2223e",
      "kind": "character_system_text",
      "source_text": "受你照顾了……！",
      "source_fingerprint": "2dffcc8803cca7136463544b925efdce16304e6d41ffa49eced5f5990f5a038a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1047",
