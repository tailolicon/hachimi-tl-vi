    {
      "uid": "zhcn:b8145c9675ba9cdf7d5cf30e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "辛苦啦。",
      "source_fingerprint": "2844e10231fb1df80ddf92369741a345d71164ac359effd4df72193851603d28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
