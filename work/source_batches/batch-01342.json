      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1049",
        "71004"
      ],
      "json_pointer": "/1049/71004"
    },
    {
      "uid": "zhcn:e0b327d26a5c37939f8ae9cc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然是有点华丽过头，\r\n但作为庆典时穿的衣服倒也不赖。",
      "source_fingerprint": "c8358211d0363bffa46121d896b9a67a2728888f25ae74efc8f344e7cb809852",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1049",
