      ]
    },
    {
      "uid": "zhcn:ed5509bb8dc7db3709986267",
      "kind": "character_system_text",
      "source_text": "我来到学园后，\r\n获得了许多开心的回忆。\r\n希望训练员也能跟我一样♪",
      "source_fingerprint": "a9b03068af5e0747dfdb1bba63912150c208419177da0fdc5f5217e7c3f84221",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1051",
        "110001"
      ]
    },
    {
      "uid": "zhcn:20a0913100e4eb6326fb4696",
      "kind": "character_system_text",
      "source_text": "要报名参加竞赛吗？\r\n我会准备好等你！",
