      ]
    },
    {
      "uid": "zhcn:13235b8f6a51311b0ddd381e",
      "kind": "character_system_text",
      "source_text": "我们会来真的，多指教～",
      "source_fingerprint": "26cb9b307624ebf39f1d35884dcd725d402442d5d45add69166e212c5dab8cb1",
      "source_path": "character_system_text_dict.json",
