      ]
    },
    {
      "uid": "zhcn:d7b1f495c91ae9ccd424794b",
      "kind": "character_system_text",
      "source_text": "那就上场吧──",
      "source_fingerprint": "e15b7803c734b70377378fde3bc31181f0db0934030aa84440265449eea1d2a4",
      "source_path": "character_system_text_dict.json",
