      ]
    },
    {
      "uid": "zhcn:c68e46e61984c7eb30d61c1d",
      "kind": "character_system_text",
      "source_text": "哼……",
      "source_fingerprint": "f21bed79927e5236d335292545e9ebd0f5f41ee49249a49856519a27ee9095c8",
      "source_path": "character_system_text_dict.json",
