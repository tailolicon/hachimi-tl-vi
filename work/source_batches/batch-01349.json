      "source_text": "包在我身上～！",
      "source_fingerprint": "70e40640ba3efdd19ead5b83ef8b97c0f46dd82512e7f9dd804b417ce035adfc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
