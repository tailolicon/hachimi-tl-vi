        "110000"
      ]
    },
    {
      "uid": "zhcn:34dae930d73a40996a5daac4",
      "kind": "character_system_text",
      "source_text": "一起经历了很多事情呢──！",
      "source_fingerprint": "6ac233c2ea614abffcdb96e5f2d0221e5941081208a93ac45586d9173b451d25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "110001"
      ]
    },
    {
      "uid": "zhcn:f119003f685eecd8a3f75b72",
      "kind": "character_system_text",
      "source_text": "无论是哪个比赛\r\n我都要拿到第一名哦──！",
      "source_fingerprint": "c47c9ae8c496f9a9c751bf4c620f0d6a0edf6e9335b401787534e0929710540a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
