      ]
    },
    {
      "uid": "zhcn:e8789d5ddf3bd0eb89627e38",
      "kind": "character_system_text",
      "source_text": "ウチの学園の美化委員ってホント\r\n真面目だよね。…何。別に、花壇\r\n見ればそれくらいわかるじゃん。",
      "source_fingerprint": "473abd3611a759a2b1c1070fedcb2232098aa768fb80a14da631c61b177ed699",
      "source_path": "character_system_text_dict.json",
      "json_path": [
