      ]
    },
    {
      "uid": "zhcn:6893a6854908b2cfba2c85c5",
      "kind": "character_system_text",
      "source_text": "哈哈。",
      "source_fingerprint": "ae0d1ca7000d0a1d6996e337c00c38005469ade66f4e595e4b21b05e784807e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140008"
      ]
    },
    {
      "uid": "zhcn:f71bc654f6bad862e943c660",
      "kind": "character_system_text",
      "source_text": "嘿嘿。",
      "source_fingerprint": "6d0212cb1ec9201ff17e6acf0ea2d70e06cf290b6bc356f0e84aed5329a8a9e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140009"
      ]
    },
    {
      "uid": "zhcn:204e219708492476eea75926",
      "kind": "character_system_text",
      "source_text": "啊──！",
      "source_fingerprint": "fd5719ad6cf29493396894ae5d30c2e808460da5d05105a1392cc6f492815168",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140010"
      ]
    },
    {
      "uid": "zhcn:b15b0170857e3648cace7a8c",
      "kind": "character_system_text",
      "source_text": "喔、喔喔！？",
      "source_fingerprint": "a782e91e3b082a7a55b1591b10e7b56342f738c742cdd5e4dccd246f45db2b1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140011"
      ]
    },
    {
      "uid": "zhcn:49e0201285bfce1f89f311e3",
      "kind": "character_system_text",
      "source_text": "太棒啦──！！",
      "source_fingerprint": "66a453e9cbb98c469572a5ea34eca7c204a890b7bf9ab6d6702dbaed169f5d44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140012"
      ]
    },
    {
      "uid": "zhcn:e13ea9fd6eefd7d626dba74c",
      "kind": "character_system_text",
      "source_text": "唔喔～！！",
      "source_fingerprint": "edf1e8c1eba8e422b0e315b810cf6713e0928771a76215c4a38b32f28c48825c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140013"
      ]
    },
    {
      "uid": "zhcn:c9750eb002d5bc960bcd78bc",
      "kind": "character_system_text",
      "source_text": "啊啊啊～！！",
      "source_fingerprint": "d7c7ea316cbab66022e6fedfce546691657d1795c9996377558a6a0c2104229e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140014"
      ]
    },
    {
      "uid": "zhcn:e0a909791f297a1f2d980c6d",
      "kind": "character_system_text",
      "source_text": "唔、唔唔……！",
      "source_fingerprint": "a9abc92157966200e9f63230e714a158501085185618a4a52895718808538af1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140015"
      ]
    },
    {
      "uid": "zhcn:ccca991ce3e7ee99003a1e51",
      "kind": "character_system_text",
      "source_text": "你还好吗？",
      "source_fingerprint": "3dfeedde9184c80987b283ab4822a1555da5225ce9ef969247afcca0faee8339",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140016"
      ]
    },
    {
      "uid": "zhcn:808ebee61595143e64103d3b",
      "kind": "character_system_text",
      "source_text": "怎么会！！",
      "source_fingerprint": "e221a877c39311ae14217d76543ce3ff4c7047fafa4b93dc631740eb18b68cd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140017"
      ]
    },
    {
      "uid": "zhcn:73a8c6d5fef07f3a530e3486",
      "kind": "character_system_text",
      "source_text": "唔唔唔～！",
      "source_fingerprint": "a6ad9af75249cd8ac42bab6d87c0b4ff23d25bc749a8379598f7a1dc103d4d78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "140018"
      ]
    },
    {
      "uid": "zhcn:a3c3131e888803e93b393086",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个呢！！",
      "source_fingerprint": "241a2339b1fa97be2239d8879f285283fbf70256c56b53ee6743eaa01f1f9a18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "15"
      ]
    },
    {
      "uid": "zhcn:bb7c8c20b229d706f4806d7d",
      "kind": "character_system_text",
      "source_text": "总觉得、好困……\r\n不，我没事……\r\n我还能继续努力……",
      "source_fingerprint": "bb67dad0b9115a8e67b88e992de3e46229deff4b7efc9034e19ee6d72acdcd9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20000"
      ]
    },
    {
      "uid": "zhcn:f01b4a19a2b119953c486598",
      "kind": "character_system_text",
      "source_text": "不行，总觉得好累……\r\n可能是因为我每天都过得很开心，\r\n所以有点太拼命了……",
      "source_fingerprint": "20f6216d63ae6f30869c4665f9ddc4de915b339e3cbab2761aff6b449842af1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20001"
      ]
    },
    {
      "uid": "zhcn:4e835524aa2dbc0f02f7e486",
      "kind": "character_system_text",
      "source_text": "气势和干劲都非常完美！！\r\n我会帅气地好好表现！！",
      "source_fingerprint": "9a325e4bc2052a4349845a3ae573335bf904756030c01476efa79c9554032306",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20002"
      ]
    },
    {
      "uid": "zhcn:980b92f4c4adbf7aacf9e8a3",
      "kind": "character_system_text",
      "source_text": "我现在好想快点跑步！\r\n还没要开始训练吗！？\r\n今天的我可是跟平常不一样喔！",
      "source_fingerprint": "7b2fb3b53d207c5671b85384a28c13c226167edc1669f293b8b06a9e75249f62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20003"
      ]
    },
    {
      "uid": "zhcn:823e5cf7ff14be407e65d7ff",
      "kind": "character_system_text",
      "source_text": "今天要做什么？\r\n不管是什么训练都尽管来吧！！",
      "source_fingerprint": "c3b30da9ce9156dd0232111379cdffb9da37138fa6fae0d64d1bd05b6f83c4f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20004"
      ]
    },
    {
      "uid": "zhcn:9a6ab3708104d17851506579",
      "kind": "character_system_text",
      "source_text": "感觉状态不错！\r\n我现在应该做什么事\r\n都会成功！！",
      "source_fingerprint": "0827892999239d0c94a6dd96f152c507dbf091f196ffe1cdcff46048952b5c25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20005"
      ]
    },
    {
      "uid": "zhcn:23a5f53901c45d8b18d4d9d7",
      "kind": "character_system_text",
      "source_text": "我已经做好准备！\r\n随时都可以开始！！",
      "source_fingerprint": "2f415198571298222d3d8b49157f37c2a618b213bfa5b83954f365435f15a6e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20006"
      ]
    },
    {
      "uid": "zhcn:ead4238640fba5f6fd0f5e5e",
      "kind": "character_system_text",
      "source_text": "一、二、三、四！\r\n热身运动完毕！！\r\n可以开始了！",
      "source_fingerprint": "87030445bba565b18173e042bda8fc69cb2f0c5c37e61f66e9dbc9e9fadf2b3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20007"
      ]
    },
    {
      "uid": "zhcn:789b195a9962cf11fa2a6fe4",
      "kind": "character_system_text",
      "source_text": "感觉脑袋轻飘飘的，\r\n无法集中精神……啊啊，真是的。\r\n我必须振作一点！",
      "source_fingerprint": "bdea5d252643f680987b304df23def8232c070c7d2c026463564feb9c80f8d62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20008"
      ]
    },
    {
      "uid": "zhcn:cfa0a7135b628c9de842798b",
      "kind": "character_system_text",
      "source_text": "实在是提不起劲……！\r\n可以请你帮我重新打起精神吗？\r\n麻烦给我一记当头棒喝吧！",
      "source_fingerprint": "995845eacc23bc26f9d5ff2700acc252fa8a0ccce43b62d17bffd488139d2cca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20009"
      ]
    },
    {
      "uid": "zhcn:549056f35d18649f75cb29db",
      "kind": "character_system_text",
      "source_text": "最近的纪律好像很散漫……\r\n唔～嗯，这样下去学园的和平就……\r\n呜哇～！无法集中精神！",
      "source_fingerprint": "61a5f8ec1fca94f408571e76c703bb47717f3bddf276465047f767b6bfe5602e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20010"
      ]
    },
    {
      "uid": "zhcn:6eb5fb51e85fb5478a5c41dd",
      "kind": "character_system_text",
      "source_text": "唔喔喔喔喔！！呼……\r\n啊、对不起……感觉使不出力气，\r\n所以我才想重新打起精神……呼。",
      "source_fingerprint": "515b5e34c1c7555d7759a344532e120422c41b720b630b8bb25d2d8aaf26d428",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20011"
      ]
    },
    {
      "uid": "zhcn:0b134d30c386ed8226ac718e",
      "kind": "character_system_text",
      "source_text": "要连续参赛吗！？超越自己的\r\n极限……啊，我的脚在微微颤抖！！\r\n这是临阵抖擞吗！？",
      "source_fingerprint": "35149a51eab0d2d3d9065e95b8c2dd74d43aca2256e54f99e5ed787803d522f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20021"
      ]
    },
    {
      "uid": "zhcn:c383d487ad4233c19e08a4b0",
      "kind": "character_system_text",
      "source_text": "要将自己逼到极限……\r\n然后变强……哈哈，意志力，\r\n我要靠意志力撑过去……！！",
      "source_fingerprint": "41b526466a46f9ee421f1f8dee2a1276d803bcf5b07fc57a5adf06416274260f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20022"
      ]
    },
    {
      "uid": "zhcn:5d6044cf4cee9508c1880174",
      "kind": "character_system_text",
      "source_text": "调整得非常完美！！\r\n真不愧是训练员！！\r\n你总是清廉正直地引导着我！",
      "source_fingerprint": "9abe8a9228bf88f65df8036081c88719f2c389969b7ec4aac1f2c12f989786c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20023"
      ]
    },
    {
      "uid": "zhcn:e5fd89609bca6b48e2619e15",
      "kind": "character_system_text",
      "source_text": "我现在状态绝佳吧！？\r\n这样就能堂堂正正地\r\n与人正面对决了！！",
      "source_fingerprint": "382f5dec4c0506876fc023488e48b5e2a9e0d9458a6dd00c27f204150d66ae24",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20024"
      ]
    },
    {
      "uid": "zhcn:db1789c97f37dfefc5c6e0f1",
      "kind": "character_system_text",
      "source_text": "唔喔喔喔喔喔喔！！\r\n今天的我，\r\n状态真是好得不行啊！！",
      "source_fingerprint": "697f11bfe16bc1d278e79635a50bb6f4ecbea69f87dd628d6ad5fc20b456e486",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20025"
      ]
    },
    {
      "uid": "zhcn:9212c67ccf46c874ce4ec4d9",
      "kind": "character_system_text",
      "source_text": "感觉不错呢！\r\n就这样一举拿下胜利吧！！",
      "source_fingerprint": "84511c03b809a87650425a1b39c134d4ef22b009aa632b1c17a26f540fa76fd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20026"
      ]
    },
    {
      "uid": "zhcn:1a27f1ff6f42d697857555a3",
      "kind": "character_system_text",
      "source_text": "调整和服装仪容都很完美！\r\nOK！完全没问题！！",
      "source_fingerprint": "3a8ed98e7e66d6669b769017f6670081bca155472ddce0daa425a43d4d714285",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20027"
      ]
    },
    {
      "uid": "zhcn:f27c15dfd5422462ac987719",
      "kind": "character_system_text",
      "source_text": "纪律散漫会让比赛也变散漫！\r\n好好整顿整顿吧！！",
      "source_fingerprint": "bbebd9d9e330b4c21866f83fcad02fd80757502441ef9743a7b5c475027e3dcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20028"
      ]
    },
    {
      "uid": "zhcn:845146365d46652741f8f289",
      "kind": "character_system_text",
      "source_text": "没有什么问题！\r\n赶紧去一决胜负吧！！",
      "source_fingerprint": "59ce09a73aaea6e4344f62daae46e1a691fcf0a59d5d6d7535b892de6aafb88e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20029"
      ]
    },
    {
      "uid": "zhcn:802dc406aa27a2e0c7e3f434",
      "kind": "character_system_text",
      "source_text": "感觉跟平常一样！\r\n我去堂堂正正地一决胜负了！！",
      "source_fingerprint": "183c7cb2c699029585bb420b498b58a9dc5dd7c12227deb25bc56e794f63a3c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20030"
      ]
    },
    {
      "uid": "zhcn:535c09b5cdaaa0ed6abb3d2e",
      "kind": "character_system_text",
      "source_text": "准备完毕！\r\n我要去全力冲刺了～！！",
      "source_fingerprint": "8b74ae88408b93fb55d7ee1c8374be316b571d07417d57a5483fa9529b11339e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20031"
      ]
    },
    {
      "uid": "zhcn:408c0da6b0cbc5f74c7a62f8",
      "kind": "character_system_text",
      "source_text": "总觉得无法鼓起干劲……\r\n不，这一定是错觉！\r\n不用担心！！",
      "source_fingerprint": "fa7595967b2a3d6c98700d24b8598de7c55c03cacf55a8008195c7fd563b62a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20032"
      ]
    },
    {
      "uid": "zhcn:c285aacb7e24f6911981d34b",
      "kind": "character_system_text",
      "source_text": "虽然状态不太好，\r\n但正因为如此，\r\n我才要全力狂冲！",
      "source_fingerprint": "b3c5bd1f9a4d63057c15bc90c48a27471462f765c380a27259fbd4a41f0c0d8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20033"
      ]
    },
    {
      "uid": "zhcn:e9ede170546729705496e8a6",
      "kind": "character_system_text",
      "source_text": "虽然状态称不上完美，\r\n但我是真心想赢！\r\n我会让你见识到我的真本事！！",
      "source_fingerprint": "4d8dd3f3a5339dd7f3db662b063c3d608e87f4ee4bf661bfe047945dc51c1e75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20034"
      ]
    },
    {
      "uid": "zhcn:5462418c4fe35afb07ad1bc1",
      "kind": "character_system_text",
      "source_text": "呃……啊！？\r\n对不起，我刚才在发呆！\r\n我没事的！！",
      "source_fingerprint": "193228c142d250a8264d77633b2269c3810c4f97b6d034a1050f6465147d025a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20035"
      ]
    },
    {
      "uid": "zhcn:28ab1917e5c9966d8505aff0",
      "kind": "character_system_text",
      "source_text": "虽然有点不安……\r\n但事到如今，\r\n也只能全力以赴了！",
      "source_fingerprint": "289d60903a2bbe2de5e6d73b0e7e7e0d5849edbd287defcb7940d3087bc124a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20036"
      ]
    },
    {
      "uid": "zhcn:6371b86ab58abafe0e83f909",
      "kind": "character_system_text",
      "source_text": "好～！\r\n不管后果如何，我豁出去了！\r\n……咦，不可以这样吗？",
      "source_fingerprint": "b0835bd09a7866a11a43100dcdef689e8fb2fd71ddd137542cc232f5cde1ebd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "20037"
      ]
    },
    {
