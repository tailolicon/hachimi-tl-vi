      ]
    },
    {
      "uid": "zhcn:aa5eccb22e6b4fe8931c19d7",
      "kind": "character_system_text",
      "source_text": "要参赛吗！？\r\n唔喔喔喔，我要加油～！！",
      "source_fingerprint": "73499afc51fc1a30844bf0a8b66bb9f845940df65ad71d5ec03d781fa57ec8e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "110002"
      ]
    },
    {
      "uid": "zhcn:0ac313d8b8da715f0f1e5a69",
      "kind": "character_system_text",
      "source_text": "雷恩！加油……",
      "source_fingerprint": "527b16ff6db6c49be58f699f42bfcfada1558cb42cae39feb3eb9b7c5f207d0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "1111"
      ]
    },
    {
      "uid": "zhcn:6fa0708099a798fcfef71052",
      "kind": "character_system_text",
      "source_text": "打起精神！加油！",
      "source_fingerprint": "ab8cbf4fcfeee538ff444ea14f61563e2feffa830887654dee8f9fbeb8c7e8e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "1112"
      ]
    },
    {
      "uid": "zhcn:be1ca24c0890c4b04c9a66b5",
