    {
      "uid": "zhcn:d0d0598370d1a1d4c6ae0553",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "好！Let's go！\r\n越过原野越过山脉越过河川！\r\n全力冲～刺！哗～真是青春呢。",
      "source_fingerprint": "09edc00784956eb0d11e58b4800f8cd16d2fbd9ae90af1402024d9b9e96b33a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
