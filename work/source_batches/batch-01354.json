    },
    {
      "uid": "zhcn:17aaf42886edd38cc5d87074",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "多接触时令事物，培养健全的\r\n心灵也属于遵守纪律的一环！\r\n所以要不要去欣赏枫叶呢？",
      "source_fingerprint": "5871c8161fce10471428a770f0b68b1a70e7f73ff89b63beb9b0d4673cc339d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
