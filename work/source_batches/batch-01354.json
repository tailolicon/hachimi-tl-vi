        "1053",
        "90006"
      ],
      "json_pointer": "/1053/90006"
    },
    {
      "uid": "zhcn:625e300ad7ebcf118d6ad16f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "天气热的时候，大家很容易\r\n衣衫不整。我必须成为榜样，\r\n把衣领和袖子都扣好……！！",
      "source_fingerprint": "1d0f4585b0b3d3c17e99d09ff14763e185c9490287b0e11b7a1e6807efd1cf34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "90007"
      ],
      "json_pointer": "/1053/90007"
    },
    {
      "uid": "zhcn:fba4aa52bb6a73751da37969",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我之前去商店街帮忙打扫落叶，\r\n但风实在太强了……在风停下来前，\r\n我经历了漫长的苦战！",
      "source_fingerprint": "d816c6e7084f1745063ed8b25c93636ec113642c79c8089125d66af0e9c221cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "90008"
      ],
      "json_pointer": "/1053/90008"
    },
    {
      "uid": "zhcn:073f5525afa442d0a09b759b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "有没有什么办法可以让人在雪地上\r\n顺畅地跑步呢！？\r\n不能靠加速冲刺克服吗！？",
      "source_fingerprint": "7543040b8b216c999ae8d34052e1a5ae745cc6e114f36a389830621d899cdf08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "90009"
      ],
      "json_pointer": "/1053/90009"
    },
    {
      "uid": "zhcn:aa51674867eb96ab864633bb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "早安──！嘿嘿嘿，\r\n或许因为换上了一身全新的打扮吧？\r\n让我觉得早晨的空气也很新鲜！",
      "source_fingerprint": "2fa1df90fd90bc76e82c9e847a498feefd7dd370e252edf4689ec3783ca0d9fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "90010"
      ],
      "json_pointer": "/1053/90010"
    },
    {
      "uid": "zhcn:20452fb72cac4ec600165c70",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "因为刚起床就呆坐着\r\n什么也不做实在是太浪费了！\r\n要不要和我一起去跑一圈啊！",
      "source_fingerprint": "cd3116ed5584de82bfdc1328ca9b0aecd120a9f92f44ab376acd137bb01ef502",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
