      ],
      "json_pointer": "/1053/90014"
    },
    {
      "uid": "zhcn:b69ea9e69bcca7fa7fb36a07",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "若晚上要去散步也让我随行！\r\n我会携带手电筒，\r\n采取万全的戒备体制！",
      "source_fingerprint": "ea855f7f52bde2434d8a02f0a9370dff9928137b6eb809c1d435093204fb8603",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
