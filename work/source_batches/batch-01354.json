      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "好！Let's go！",
      "source_fingerprint": "93b8c9a81959e6d5385ed6bd3918bf6823d1f838d90d942650cb8b9f67f503f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
