        "1053",
        "400013"
      ],
      "json_pointer": "/1053/400013"
    },
    {
      "uid": "zhcn:79f1f1b34dff809a3516dd81",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然明白你的依依不舍，\r\n但我们还是返回学园吧！\r\n毕竟炎热的夏季才刚开始呢！",
      "source_fingerprint": "eebbe66a902cbe5ea9c6bcbbf42a566d07f2a48cd96f09c86fe015fffbe680d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
