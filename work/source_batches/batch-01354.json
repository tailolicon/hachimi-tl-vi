      ],
      "json_pointer": "/1053/90015"
    },
    {
      "uid": "zhcn:edae2054de91533db36644d7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "春天是邂逅崭新事物的季节！\r\n同时也是青春的起点！\r\n或许还会遇见未来的竞争对手呢！",
      "source_fingerprint": "0138afbef7e18191604cf4fa2622a1f5da39e52704b2cc0427460038c8b97c87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
