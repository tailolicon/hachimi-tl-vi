        "1005"
      ]
    },
    {
      "uid": "zhcn:2e0fea611eca30753be9c1f7",
      "kind": "character_system_text",
      "source_text": "就差一步！",
      "source_fingerprint": "573e02ec0d24fbdb60925613e6034141e68c3b7b1a01929b853c73f80b29aa64",
      "source_path": "character_system_text_dict.json",
