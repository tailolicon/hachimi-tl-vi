    {
      "uid": "zhcn:ebe253d6f1d5a7c994294ff3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "要拿下胜利！！",
      "source_fingerprint": "b6d46076f1a9e4a99e35d8b52f1d59f37d07f47bc6a68e1abf4591e8234c95a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
