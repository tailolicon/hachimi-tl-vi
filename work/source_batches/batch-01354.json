        "1053",
        "90011"
      ],
      "json_pointer": "/1053/90011"
    },
    {
      "uid": "zhcn:98dd53bebdd9f4f278fc677b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "偶尔在外面享用午餐也不错呢。\r\n做个大蒜精力便当……\r\n啊！不过气味会危害纪律！",
      "source_fingerprint": "c5457cbb4b2a360f535100f407eb9fec9c9d36ebf07c6139449d74c1a64e67d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
