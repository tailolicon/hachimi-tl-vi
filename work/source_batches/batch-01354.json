    {
      "uid": "zhcn:585ab343c2b2384f8e2329b4",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "把心中所想坦率地大声喊出来！！\r\n我赢了──────！！",
      "source_fingerprint": "3c5717506b64fd2a3f0e2c39c817f43abe40a2a1dc38ac2f74fd78566225aa08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
