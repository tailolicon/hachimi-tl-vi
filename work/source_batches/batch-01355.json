      ]
    },
    {
      "uid": "zhcn:4704371ad6a3117c84da0939",
      "kind": "character_system_text",
      "source_text": "那个……我有一点点紧张……",
      "source_fingerprint": "dbfdee2e7bca8af84dabca66a954448365695366922cbde2f4b294db440dacfe",
      "source_path": "character_system_text_dict.json",
