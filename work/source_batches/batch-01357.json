        "110000"
      ]
    },
    {
      "uid": "zhcn:34dae930d73a40996a5daac4",
      "kind": "character_system_text",
      "source_text": "一起经历了很多事情呢──！",
      "source_fingerprint": "6ac233c2ea614abffcdb96e5f2d0221e5941081208a93ac45586d9173b451d25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
