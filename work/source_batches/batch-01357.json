      ]
    },
    {
      "uid": "zhcn:8038fb4162076f542f97bb5b",
      "kind": "character_system_text",
      "source_text": "很害羞啊～",
      "source_fingerprint": "0bc85f56bc5d9d3f96ebb319666eff651674563c29b80f7ea47640bb44f1ec7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140009"
      ]
    },
    {
      "uid": "zhcn:229794adfc0187361443440b",
      "kind": "character_system_text",
      "source_text": "诶嘿嘿！",
      "source_fingerprint": "80318bc47388d48717d728602d2babad9946ca19489aa95d67290eae4f3a55be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140010"
      ]
    },
    {
      "uid": "zhcn:47c17107d7aa777725f21c72",
      "kind": "character_system_text",
      "source_text": "好棒──哦！！",
      "source_fingerprint": "900dc7659c7c2f43f9784298c017805565988ad52d3d7c1e15be98fcab8b3e2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140011"
      ]
    },
    {
      "uid": "zhcn:8c519315fee55b45ad8dc4eb",
      "kind": "character_system_text",
      "source_text": "好开心哦──！！",
      "source_fingerprint": "45f30b161979611f3a2e3b1cda6515b79827117977b65311490ef39eeea9addb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140012"
      ]
    },
    {
      "uid": "zhcn:f5824eef19d621ff8df88380",
      "kind": "character_system_text",
      "source_text": "太棒啦──！",
      "source_fingerprint": "e80e2e6a9f7e177e849bcb1fece1438b7b3a07e59ade51807323a22a39f47b1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140013"
      ]
    },
    {
      "uid": "zhcn:85302e58f57b04ad5e2397f6",
      "kind": "character_system_text",
      "source_text": "天呐──！",
      "source_fingerprint": "4140063b0a828a925a6c5f7e61ccac6a1a6705bb7a37e75513db3abe7d4dbb2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140014"
      ]
    },
    {
      "uid": "zhcn:9d76f9475cbc5ec24d0c1689",
      "kind": "character_system_text",
      "source_text": "哦哦～！",
      "source_fingerprint": "b08b4fa03f5ad27bf80c41e81418ab7f79cf8e703f971fc41d72b1df9342c066",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140015"
      ]
    },
    {
      "uid": "zhcn:2702a383907e100944711f15",
      "kind": "character_system_text",
      "source_text": "加油，加油，哦──！",
      "source_fingerprint": "660faa1c380ef928e0ad5997ab23fd6cfcd2d391fb265ba2a9c0d6a9727d897f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140016"
      ]
    },
    {
      "uid": "zhcn:7b18d018a38d5188484c5355",
      "kind": "character_system_text",
      "source_text": "唔唔～～",
      "source_fingerprint": "3d8b037b1ac1e749cd712caf587aa9639e32c127ee87e40a504bbeea16c7d1c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140017"
      ]
    },
    {
      "uid": "zhcn:dafe6cd70826d6d281c2819e",
      "kind": "character_system_text",
      "source_text": "怎么办～！",
      "source_fingerprint": "a4d56168a8162ca4f10fa44acd507cb99f9ba82ec59766c6a0e682be646d49e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "140018"
      ]
    },
    {
      "uid": "zhcn:95fe5234d12d20a47b2fd6aa",
      "kind": "character_system_text",
      "source_text": "哇！\r\n明天可以拿到这个呢！",
      "source_fingerprint": "0c06b5e0df3dd6bd3b72103a5fbfa19497604a6a38949397661ce082d01890a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "15"
      ]
    },
    {
      "uid": "zhcn:2d443db0dd59f6da133db46d",
      "kind": "character_system_text",
      "source_text": "嗯……感觉好像累坏了──\r\n都没有力气了啦……",
      "source_fingerprint": "9513f453334b0f3d0543cfac460fefc14dba5b0d4fdb6f8a692433d315063da0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20000"
      ]
    },
    {
      "uid": "zhcn:ee9692d7b5b2c3e777f5d09f",
      "kind": "character_system_text",
      "source_text": "为什么呢……？觉得好想睡觉，\r\n身体越来越没力气……呼啊……",
      "source_fingerprint": "ff9c9da1a6ecfd6a663c55d0abd817ddd244c86b556051e33dfdbe17a79c3fdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20001"
      ]
    },
    {
      "uid": "zhcn:afee631e98a7130cac3f4285",
      "kind": "character_system_text",
      "source_text": "现在的乌拉拉是超级乌拉拉哦！\r\n因为状态超好的♪",
      "source_fingerprint": "c70822ea8f8542fb582e57ccd8b781e3ce004b7440054e65deed89f728b834a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20002"
      ]
    },
    {
      "uid": "zhcn:1f52523e97798b18f8e51228",
      "kind": "character_system_text",
      "source_text": "乌拉拉～♪\r\n干劲满满，绝佳状态！",
      "source_fingerprint": "c6f8c2ef1a8999b1e203081f1564d3816a57e374918dfa0df035af1e2863522c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20003"
      ]
    },
    {
      "uid": "zhcn:610242f782c639e50df29c13",
      "kind": "character_system_text",
      "source_text": "OK──！乌拉拉会做到的──！\r\n你要看好哦♪",
      "source_fingerprint": "821de5c54c38f67b1cfccd78a38e9d2c96b70d326879e24e7338013862856962",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20004"
      ]
    },
    {
      "uid": "zhcn:2c78fbf6b16a77e008da13e7",
      "kind": "character_system_text",
      "source_text": "蹦蹦跳♪感觉身体像\r\n小鸟一样轻盈哦──",
      "source_fingerprint": "0c56cae180933860d085a6753f47e6c91f702b485d979c58adf49c2da6885486",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20005"
      ]
    },
    {
      "uid": "zhcn:5298782d116a04f6d6f571ed",
      "kind": "character_system_text",
      "source_text": "我们要做什么样的训练安排啊？\r\n告诉我嘛～！",
      "source_fingerprint": "403de6c3bb4bdc2330300575db2c71cae79233fb663c54f5f35bfc453f5f8ef2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20006"
      ]
    },
    {
      "uid": "zhcn:b599967516966defd25b805d",
      "kind": "character_system_text",
      "source_text": "希望能做有趣的练习啊，\r\n有这种的吗──？",
      "source_fingerprint": "32648d1236e8419dba94f64ac731b8c5bf8adb1fcf646c898629deb22774c599",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20007"
      ]
    },
    {
      "uid": "zhcn:0c510129d554887d468e9eab",
      "kind": "character_system_text",
      "source_text": "啊唔……训练是很重要的嘛。\r\n没问题的，我会努力的！",
      "source_fingerprint": "81926e6e83754ed0d8878829e78b48fce8f5490298aa27bd354470a46c79f76c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20008"
      ]
    },
    {
      "uid": "zhcn:b6560e1264edd04cc1894c58",
      "kind": "character_system_text",
      "source_text": "我的干劲好像迷路不知道跑哪去了。\r\n可以陪我一起去找吗？",
      "source_fingerprint": "6652ce9aaa9d21953ecbe399052f972e6d74aae213712f562bfec7a0014f2043",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20009"
      ]
    },
    {
      "uid": "zhcn:fbc3e663426b9f94be72d33f",
      "kind": "character_system_text",
      "source_text": "我很有精神哦！\r\n可是耳朵跟尾巴都一直垂着……",
      "source_fingerprint": "1369aa8e35605ef447fdacb0be1a985294609c07d6bdcd2c325c504fe34d0f10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20010"
      ]
    },
    {
      "uid": "zhcn:a7426bd7688499fabcdba891",
      "kind": "character_system_text",
      "source_text": "休息跟玩不能算是训练吗？",
      "source_fingerprint": "f2d008b730e3fd1b0b1c1bd3182cdd3bf76fb041a7f46e625e5812fbf66b466d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20011"
      ]
    },
    {
      "uid": "zhcn:eb2f0185fae4f366f4f0dbc0",
      "kind": "character_system_text",
      "source_text": "好──又要比赛了……\r\n……我、我会努力的……",
      "source_fingerprint": "4bb85be68d4ee411afda59a2777e192f76f1f9ae08fe442ba9e0d1b6adc801b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20021"
      ]
    },
    {
      "uid": "zhcn:b9fc09c7708f880a890246aa",
      "kind": "character_system_text",
      "source_text": "那个，虽然我很开心能参加\r\n很多比赛，但是身体\r\n真──的好重哦……呜……",
      "source_fingerprint": "b4c7d4819d4fdc395722d69e19e8d12728bfa41f12c8b04f8f2616138fc6ddbb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20022"
      ]
    },
    {
      "uid": "zhcn:69b1d6b4bd10243d74262e90",
      "kind": "character_system_text",
      "source_text": "你看着哦，训练员！\r\n我一定会咻──一声\r\n拿到第一名的！",
      "source_fingerprint": "0a644f166250dca36410c2b7cb3ac1277724de8b3803e7966a5346eceae10c26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20023"
      ]
    },
    {
      "uid": "zhcn:52e8a73199781f7cd215e127",
      "kind": "character_system_text",
      "source_text": "因为我吃了很多胡萝卜，\r\n所以状态非常好哦──\r\n好，我一定要拿到第一名！",
      "source_fingerprint": "48c5c21e8e0aa2f800d1c241cb52fa735a54872f31cdf0d18871403f3ccacc80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20024"
      ]
    },
    {
      "uid": "zhcn:f52dd0ba27517c7be395567d",
      "kind": "character_system_text",
      "source_text": "开始前就有一种很乌拉拉～的感觉♪\r\n赢了我们就吃胡萝卜布丁来庆祝吧！",
      "source_fingerprint": "6f1ec41a582cdfc94c2c292a7943e8da11729f0bbd0be12ff26d798670819a52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20025"
      ]
    },
    {
      "uid": "zhcn:a3be25f5766633f3810f07d3",
      "kind": "character_system_text",
      "source_text": "做了很多的训练，状态也很OK嘛！\r\n这场比赛一定会赢的吧♪",
      "source_fingerprint": "d3f8b8294ce691c346747075d3e3e2c4593fa303f2266427f4af525d272ed655",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20026"
      ]
    },
    {
      "uid": "zhcn:ae03b6e55c4264704f6c5e7e",
      "kind": "character_system_text",
      "source_text": "这个感觉应该没问题哦！\r\n还没有要开始比赛吗？\r\n好想赶快尽情地奔跑哦──♪",
      "source_fingerprint": "493b04d5802d6ac060f2a275cc6aa3b6c08a28b7262edb3bf445497965c36c6a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20027"
      ]
    },
    {
      "uid": "zhcn:923e69d7b272b706f3941f09",
      "kind": "character_system_text",
      "source_text": "是叫做状态……吗？\r\n我觉得好像还不错哦！",
      "source_fingerprint": "c87a1e14b31c1312a3569550fbb074d27243db2da0705e1d3e8aae47d8dae097",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20028"
      ]
    },
    {
      "uid": "zhcn:c03e1d4d56e94a517ddf4c27",
      "kind": "character_system_text",
      "source_text": "现在感觉跟平时一样哦！\r\n一定要跑出比之前更好的成绩──！",
      "source_fingerprint": "4e0e49e08e61cee5d999146e02e3de3d79e4d3d45ac9a4396f09c5ac3bd2785d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20029"
      ]
    },
    {
      "uid": "zhcn:5490af1a1dfa4ae8c9e1f0ed",
      "kind": "character_system_text",
      "source_text": "我会像平常一样开心奔跑的，\r\n训练员！",
      "source_fingerprint": "c954d6c89b1f2c40cd196908df451d0e336d5eafce6f392651c6a34a1d6db053",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20030"
      ]
    },
    {
      "uid": "zhcn:58880d71ba85b64e2da41eb7",
      "kind": "character_system_text",
      "source_text": "只要照一直以来的步调跑\r\n就好了对吧！没问题的！",
      "source_fingerprint": "1f4be1a169179b8c8bfc22b99377f387fd30b64d66feecf2292d50ce1f4b721b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "20031"
      ]
    }
  ]
}
