      ]
    },
    {
      "uid": "zhcn:3d6b51656f06d242e6bffec9",
      "kind": "character_system_text",
      "source_text": "哇啊！更新最高分了呢──！",
      "source_fingerprint": "5525d9a530292161695ef34a335f8a7a3638643eee1cdab1eb40e74c69d9808c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1052",
        "1007"
      ]
    },
    {
      "uid": "zhcn:609ee4aa49f08c8dbca8a879",
      "kind": "character_system_text",
      "source_text": "大家──！我们一起加油吧！",
      "source_fingerprint": "a10c39ad59565216852097cb3d64f8e062541e7d536cdc88805db4a86945f5eb",
      "source_path": "character_system_text_dict.json",
