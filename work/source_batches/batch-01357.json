    {
      "uid": "zhcn:e124b908f202606cad2b6da3",
      "kind": "character_system_text",
      "source_text": "可以的可以的♪",
      "source_fingerprint": "33b5cb3fc2c70160bd9322e92cf011009692595763a34b371f5fa6566ec2af54",
      "source_path": "character_system_text_dict.json",
