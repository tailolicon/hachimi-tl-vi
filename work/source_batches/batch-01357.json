    {
      "uid": "zhcn:7866fbfeb2450fd2393429a9",
      "kind": "character_system_text",
      "source_text": "是训练员啊～！\r\n怎么了怎么了？要训练了吗！？",
      "source_fingerprint": "d4e9d1314af5507068d54faf8c9958ba8a8bb1c801828aa40201d39078204b75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
