    {
      "uid": "zhcn:0e41af5a884d1e6badd7d653",
      "kind": "character_system_text",
      "source_text": "训练♪训练♪\r\n一起训练吧～☆★",
      "source_fingerprint": "7c884fe910c5f3476e5a71e323866d077d42d703821c5dccd1ede816c30f31c3",
      "source_path": "character_system_text_dict.json",
