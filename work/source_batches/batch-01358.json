      ]
    },
    {
      "uid": "zhcn:ac4884e86bb840e6f6fe4465",
      "kind": "character_system_text",
      "source_text": "回忆是养分☆★\r\n温馨的回忆、难过的回忆，\r\n这所有的一切造就了我们☆",
      "source_fingerprint": "dd2002ab7a1532f6a280805ad2ab0f3f74200e2e33f5b82c8c3f42d47d426161",
      "source_path": "character_system_text_dict.json",
