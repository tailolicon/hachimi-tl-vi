    {
      "uid": "zhcn:057dbdf4e62f1b46aa8510a8",
      "kind": "character_system_text",
      "source_text": "辛苦了，美丽☆",
      "source_fingerprint": "58814567bbc751d14b20e3b8943ae9a9ff7e86d54f94f5f3da5c678908c36ab0",
