      "kind": "character_system_text",
      "source_text": "我明白了！",
      "source_fingerprint": "4abd4665a269fc5b7d6d557dbfc6fb51a6eb9290ccf8953080806ab59acbdf6e",
      "source_path": "character_system_text_dict.json",
