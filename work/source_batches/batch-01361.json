      ]
    },
    {
      "uid": "zhcn:b778cabb82deac1b91925d88",
      "kind": "character_system_text",
      "source_text": "やるっス！！",
      "source_fingerprint": "9ecbde30c9a29b954d7c4e0ca810ab67560f0edf500306afbf2558e4e452dcdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "23015"
      ]
    },
    {
      "uid": "zhcn:478ad5d571f2ef1ed1fd1432",
      "kind": "character_system_text",
      "source_text": "这不算什么，下次一定要赢！！",
      "source_fingerprint": "aa2dac999341a6197f216de168482ea52f8afaef1d438eb3c664ee9719317793",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30000"
      ]
    },
    {
      "uid": "zhcn:1527c81f08cc25e7cd3aa68c",
      "kind": "character_system_text",
      "source_text": "接下来才是重点！！",
      "source_fingerprint": "d4ea1a04bdf618f186ce3a9f451e9d85a5a8ba19e6263f2dd039eb653f4e5bf0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30001"
      ]
    },
    {
      "uid": "zhcn:895162901f40cb5d6a660d91",
      "kind": "character_system_text",
      "source_text": "我要朝更高的目标迈进！！",
      "source_fingerprint": "2953a0cc25e92d40a5e431a97627d840ff59deb8e0a48196384b4caeb3ce2cea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30002"
      ]
    },
    {
      "uid": "zhcn:5ecc720807398f8c87fa2567",
      "kind": "character_system_text",
      "source_text": "我不会让一切就这样结束！",
      "source_fingerprint": "1155b303691f4bf7f1ef169e652bbbe51d15dec234158cf08c11e447b8cebb51",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30003"
      ]
    },
    {
      "uid": "zhcn:f2e7ba7949b37b36acd280f8",
      "kind": "character_system_text",
      "source_text": "激战！热情！热血沸腾！！\r\n这是最棒的胜利！！",
      "source_fingerprint": "f27ce81eea47017b1b9ba330f16f878936f6c0eb13dcb2c8c4d4945e3a87620c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30004"
      ]
    },
    {
      "uid": "zhcn:de7d269fe28398978c7a3a56",
      "kind": "character_system_text",
      "source_text": "谢谢大家！……嘿嘿。",
      "source_fingerprint": "6a783facffa051e06c7a62cba9db15153f243d4ac08c9caa1e0fc40ae06ccb6a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30005"
      ]
    },
    {
      "uid": "zhcn:585ab343c2b2384f8e2329b4",
      "kind": "character_system_text",
      "source_text": "把心中所想坦率地大声喊出来！！\r\n我赢了──────！！",
      "source_fingerprint": "3c5717506b64fd2a3f0e2c39c817f43abe40a2a1dc38ac2f74fd78566225aa08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30006"
      ]
    },
    {
      "uid": "zhcn:c25b7a5246ef92eea8bba0f7",
      "kind": "character_system_text",
      "source_text": "谢谢！……嘿嘿。",
      "source_fingerprint": "21a5c243c213e814bc433d26c900eb97d24d5de8ae404769d0315b2789bfb753",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "30007"
      ]
    },
    {
      "uid": "zhcn:ebe253d6f1d5a7c994294ff3",
      "kind": "character_system_text",
      "source_text": "要拿下胜利！！",
      "source_fingerprint": "b6d46076f1a9e4a99e35d8b52f1d59f37d07f47bc6a68e1abf4591e8234c95a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "31000"
      ]
    },
    {
      "uid": "zhcn:54b552357b28f798b05fa990",
      "kind": "character_system_text",
      "source_text": "见识我的热情吧！！",
      "source_fingerprint": "f6405af1db759719f94b08c38d0f48f8b58ba08797d37662413da38d5802fb35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "40000"
      ]
    },
    {
      "uid": "zhcn:b0924a71d645434d7e3c42a1",
      "kind": "character_system_text",
      "source_text": "寮内の風紀にも気を配らないと！！\r\nまずは…夜な夜な謎のラップが\r\n聞こえる騒音問題の対処っスね！",
      "source_fingerprint": "234bcedebf2504dff8897837b27817635fd68b8d80242a001654c09e375d49e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400002"
      ]
    },
    {
      "uid": "zhcn:43c36244fbea6bdc4826e9da",
      "kind": "character_system_text",
      "source_text": "我实在很不想弄乱城市帮我\r\n整理好的发型，但……唔哦哦，\r\n海风来啦──！我不会输的──！",
      "source_fingerprint": "3552d65362210bc73c58b2c9ea70e899e11aef7b4d1ccfff5d96d53c4babad11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400003"
      ]
    },
    {
      "uid": "zhcn:411267ec11e7744f2abf1af8",
      "kind": "character_system_text",
      "source_text": "无论是感谢祭前！还是感谢祭中！\r\n纠察队员都不会停止巡逻！\r\n一抓到有人违反规则就吹哨！",
      "source_fingerprint": "203e7f9dac2d5859a36644b8830d8e0e3cbbd76e7b7718d6cf2cdd31940902d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400005"
      ]
    },
    {
      "uid": "zhcn:5d5765dce21e363da3f1da8c",
      "kind": "character_system_text",
      "source_text": "有人求助我必定出手！\r\n有人需要我就一定会出现！\r\n这就是我的原则！",
      "source_fingerprint": "98f77196efc5bfb4970751fa7c9f5eefa695cc82d0050d5b9fd604dfa7be8057",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400007"
      ]
    },
    {
      "uid": "zhcn:560eba61d5f5642f837373ff",
      "kind": "character_system_text",
      "source_text": "内心散漫就代表纪律散漫！\r\n专注于恢复精神也是\r\n纠察队长的重要责任！",
      "source_fingerprint": "d9b43b8037c15a2058ddcd3ac1d577198c97d7d2ab7802962735dcb15a099fef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400008"
      ]
    },
    {
      "uid": "zhcn:fcbee730f90cd4ce683776dc",
      "kind": "character_system_text",
      "source_text": "啊，这是！！\r\n唔喔喔喔喔！！喝啊啊啊！！\r\n又矫正一次纪律了！！",
      "source_fingerprint": "354ace874eaeee5489c1d8be10b78de2ba9af93f114abc021fe98cd2536c4377",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "40001"
      ]
    },
    {
      "uid": "zhcn:489dbcfc15c3b16e283a4e21",
      "kind": "character_system_text",
      "source_text": "こちらはイベントミッションっス\r\n楽しんでるっスか？休憩がてら、\r\n報酬受け取ってくといいっスよ。",
      "source_fingerprint": "4b4a48f195032a4a4c998a8805de467f7bcd0105a06ed69a99e0bf9c992f7b24",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400012"
      ]
    },
    {
      "uid": "zhcn:b394265ae57d5ae0d167b813",
      "kind": "character_system_text",
      "source_text": "お疲れっした！熱い思い出が\r\n作れてたら幸いっス！お土産も\r\n受け取って帰ってください！",
      "source_fingerprint": "62820bd506a3723cfb09c810a655aaa902ef8c2df21ceecf271e3aee3e756576",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400013"
      ]
    },
    {
      "uid": "zhcn:79f1f1b34dff809a3516dd81",
      "kind": "character_system_text",
      "source_text": "虽然明白你的依依不舍，\r\n但我们还是返回学园吧！\r\n毕竟炎热的夏季才刚开始呢！",
      "source_fingerprint": "eebbe66a902cbe5ea9c6bcbbf42a566d07f2a48cd96f09c86fe015fffbe680d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400014"
      ]
    },
    {
      "uid": "zhcn:c407828e6989a8b2948653e7",
      "kind": "character_system_text",
      "source_text": "好！Let's go！",
      "source_fingerprint": "93b8c9a81959e6d5385ed6bd3918bf6823d1f838d90d942650cb8b9f67f503f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "40003"
      ]
    },
    {
      "uid": "zhcn:d0d0598370d1a1d4c6ae0553",
      "kind": "character_system_text",
      "source_text": "好！Let's go！\r\n越过原野越过山脉越过河川！\r\n全力冲～刺！哗～真是青春呢。",
      "source_fingerprint": "09edc00784956eb0d11e58b4800f8cd16d2fbd9ae90af1402024d9b9e96b33a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "40004"
      ]
    },
    {
      "uid": "zhcn:be033e3af433c76010d2a3cf",
      "kind": "character_system_text",
      "source_text": "ヘリオスの熱さ、見届けたっス！！\r\nあとは本番！今までで1番熱く\r\n燃えていかないとっスね！！",
      "source_fingerprint": "09ea1c74ee290bbec6fa0c8d149704b0eaafc3a4763a7d21d96bf1628801dbc0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "400074"
      ]
    },
    {
      "uid": "zhcn:c82a0c6984f51cab16100a15",
      "kind": "character_system_text",
      "source_text": "ッシャー！",
      "source_fingerprint": "e5beb9223340ea055f6ebd4cca204c677bed8fc08abeeb59bc962a1c7439e926",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410000"
      ]
    },
    {
      "uid": "zhcn:40c707d4ffcde67c982dfb28",
      "kind": "character_system_text",
      "source_text": "ヨッシャァー！！",
      "source_fingerprint": "02c88c2958f046cdc4104a0f161d9c20ae7732f0282f54d8f724259f3135ddc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410001"
      ]
    },
    {
      "uid": "zhcn:bfb2d1b9089505f6572c5910",
      "kind": "character_system_text",
      "source_text": "うしっ！",
      "source_fingerprint": "f21adf04ae57e78044148c355b77320d8c9897745cc47d774202a361c090b4d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410002"
      ]
    },
    {
      "uid": "zhcn:c93ab55943bbd51b15196b64",
      "kind": "character_system_text",
      "source_text": "うしっ！",
      "source_fingerprint": "f21adf04ae57e78044148c355b77320d8c9897745cc47d774202a361c090b4d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410003"
      ]
    },
    {
      "uid": "zhcn:9a0bbaf970a36050af0e4ab9",
      "kind": "character_system_text",
      "source_text": "へへっ",
      "source_fingerprint": "3dd4f402dfcbc6c028934e3eda4939faaf7a89b223164a962f2013260256aace",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410004"
      ]
    },
    {
      "uid": "zhcn:16ae67973a7f6c7f01a25497",
      "kind": "character_system_text",
      "source_text": "へへっ",
      "source_fingerprint": "3dd4f402dfcbc6c028934e3eda4939faaf7a89b223164a962f2013260256aace",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410005"
      ]
    },
    {
      "uid": "zhcn:a78e1bf79dc81b762b9b3895",
      "kind": "character_system_text",
      "source_text": "アハハ～……",
      "source_fingerprint": "dc6455e9427b9696ed705c40f1993199e81cf1f531724761a8e80a93da0d61cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410006"
      ]
    },
    {
      "uid": "zhcn:3333a1c79d47940f7d7441a3",
      "kind": "character_system_text",
      "source_text": "アハハ～……",
      "source_fingerprint": "dc6455e9427b9696ed705c40f1993199e81cf1f531724761a8e80a93da0d61cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410007"
      ]
    },
    {
      "uid": "zhcn:04ad755a4fc0451cffd4dd79",
      "kind": "character_system_text",
      "source_text": "アハハ～……",
      "source_fingerprint": "dc6455e9427b9696ed705c40f1993199e81cf1f531724761a8e80a93da0d61cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "410008"
      ]
    },
    {
      "uid": "zhcn:810d3cc223e4cff03537c506",
      "kind": "character_system_text",
      "source_text": "我要去好好表现了！！",
      "source_fingerprint": "4794f87693238565040765e18e1b51aa64f21cfb3a8d28c8f9d5acca1276913f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "60000"
      ]
    },
    {
      "uid": "zhcn:dbad198603bb4c2caaab2b75",
      "kind": "character_system_text",
      "source_text": "我要去向大家道谢！",
      "source_fingerprint": "67d1656c3a662361ccd16bc9b69b866ff6deea92a0d017ddd0c336233f8b117a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "60001"
      ]
    },
    {
      "uid": "zhcn:cac97815fceceff193792ab3",
      "kind": "character_system_text",
      "source_text": "我会身心灵都提起干劲去做的！",
      "source_fingerprint": "1b32c3b08f7dd6cfccd8751029a9573d778d6033b653d07e73faa3d22b632362",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70000"
      ]
    },
    {
      "uid": "zhcn:57db490e57aa670bad5bf64e",
      "kind": "character_system_text",
      "source_text": "你没有边走路边分心做其他事吧？\r\n希望你有乖乖遵守这点！\r\n要是你受伤了我会难过的！嘿嘿。",
      "source_fingerprint": "039e7292ec4a10151847e33011ba80c2d6f321ed89983c5fb9e12f7488a7b0e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70001"
      ]
    },
    {
      "uid": "zhcn:2705e1d48f9cf69f72ecf812",
      "kind": "character_system_text",
      "source_text": "制服还是像这样穿整齐时最帅气！",
      "source_fingerprint": "d6e09d20d05215873c4bf08acad4f4182842688da4ee945164d93bec44385374",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70004"
      ]
    },
    {
      "uid": "zhcn:2c228b1163cd4006f498c4d4",
      "kind": "character_system_text",
      "source_text": "穿着这件衣服和大家一起跳舞时，\r\n会有种团结一致的感觉！",
      "source_fingerprint": "1dd92e50f8eb75544ac9a205f859487d8e847a25a6f97dc8ee0a71066535e4cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70008"
      ]
    },
    {
      "uid": "zhcn:f864c2838094f394c8e6304c",
      "kind": "character_system_text",
      "source_text": "这就是只属于我的决胜服！\r\n唔喔喔，我现在充满干劲～！！",
      "source_fingerprint": "f86bba011db58c8246d016c72a27473ed4d9cebe0ec2dc5c153627922b3d9efa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70009"
      ]
    },
    {
      "uid": "zhcn:75120fbc98b295df2b02ecaf",
      "kind": "character_system_text",
      "source_text": "我不太清楚可不可爱，\r\n但我喜欢这件制服！！",
      "source_fingerprint": "89e66f6b099297915a3679f8d989f755c162f4b2d0a3a3d61ff1c28f41a45aca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70010"
      ]
    },
    {
      "uid": "zhcn:2e86e3b2afb32a98787d1292",
      "kind": "character_system_text",
      "source_text": "观众都在看着舞台！\r\n必须好好检查衣服有没有穿整齐！！",
      "source_fingerprint": "2b95986caa8a793412ddab8ba4de9e7835ae64d7cb9d86acdeef0ddf38927b42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70014"
      ]
    },
    {
      "uid": "zhcn:5e40ce8ed546f39baf863067",
      "kind": "character_system_text",
      "source_text": "有天要与劲敌来场热血认真对决……\r\n这件决胜服包含了这样的梦想！！",
      "source_fingerprint": "c59e9fd90441ca3265796453ae02a78176ca159417c7748e30bc720a9016603c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70015"
      ]
    },
    {
      "uid": "zhcn:9b3da7cb89230087693ea564",
      "kind": "character_system_text",
      "source_text": "不论是竞赛、纪律还是度假，\r\n都要有纠察队长的风范！",
      "source_fingerprint": "bff72b2b7a454eb37001e8ef82a06eea2139f1a41f31ac69d21dd02e58ca0196",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70016"
      ]
    },
    {
      "uid": "zhcn:c64ba88469d1f638a91806d1",
      "kind": "character_system_text",
      "source_text": "哎呀呀！没有绑一字巾，\r\n耳朵很容易垂下来……",
      "source_fingerprint": "fc8fac022ca79848f05b0b13302e11db6bed3bfbf8bcb61efdb08591a4910707",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70017"
      ]
    },
    {
      "uid": "zhcn:57639f22a6f0c61fb390132d",
      "kind": "character_system_text",
      "source_text": "嘿嘿，怎么样啊？",
      "source_fingerprint": "31cb2fc8ebaa5ca3334014b01eaf1b58b53bf5fb28e8b503a4f36e8c384a9d2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1053",
        "70018"
      ]
    }
  ]
