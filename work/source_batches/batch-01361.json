      ]
    },
    {
      "uid": "zhcn:dd6c6497d2650b0a1875c1f6",
      "kind": "character_system_text",
      "source_text": "身上充满了神秘的力量呢！",
      "source_fingerprint": "9b63dacc0b629b843a13a4de48798b791fa44282c6bde7dba1b75f2c60c18e29",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "120000"
      ]
    },
    {
      "uid": "zhcn:a6cfbd3f0e468411cd6b91d8",
      "kind": "character_system_text",
      "source_text": "天外飞来一笔登录奖励呢！",
      "source_fingerprint": "e23cf8953258dc7dedafa51a30d6053b6a5056dabd6f53eb06878db6c0de7ba9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "13"
      ]
    },
    {
      "uid": "zhcn:55024af6099dd69695e92280",
      "kind": "character_system_text",
      "source_text": "胜利女神是站在我这边的！",
      "source_fingerprint": "b423bf86c308486f8dffaef0cae4b85ff502e3cfe4210b2f185d7cd12773bc67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "140000"
      ]
    },
    {
      "uid": "zhcn:c7ecf5bf6862044221a8b872",
      "kind": "character_system_text",
      "source_text": "信者得救啊～～！！",
      "source_fingerprint": "b221143985d52bcf2d771ec64a95d47846cf6cefec65360b839914d401f352ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "140001"
      ]
    },
    {
      "uid": "zhcn:9164162817560bde844bafd6",
      "kind": "character_system_text",
      "source_text": "怎……怎么介样～",
      "source_fingerprint": "abfd034fe490cbe13df1feec0dd18c19b86ffea8adf703fcf686f80f6558ea54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "140002"
      ]
    },
    {
      "uid": "zhcn:88a785856e941320d9534a8b",
      "kind": "character_system_text",
      "source_text": "是「大吉」哦！",
      "source_fingerprint": "79f06acde87fd5dd75b1b77b28835194b2022efd8e081d0c8844ad606117bcdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "140003"
      ]
    },
    {
      "uid": "zhcn:a3ea50598a46c3783ff955ec",
      "kind": "character_system_text",
      "source_text": "这是吉兆呢！",
      "source_fingerprint": "06da5fbab402fa534c97a1420e9e22a5d8b0450ba5555c38a465d2be32e5c07b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "140004"
      ]
    },
    {
      "uid": "zhcn:fd6ed04d63a04af8ed353ea8",
      "kind": "character_system_text",
      "source_text": "这、这……必须要驱除厄运才行了～！",
      "source_fingerprint": "b12a778ea43a9f019cce94e6acb0f3a281d103169bc75d166c6fa09c2c62876b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
