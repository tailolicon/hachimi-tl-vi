      ]
    },
    {
      "uid": "zhcn:c15853b156e8f822e57f7eae",
      "kind": "character_system_text",
      "source_text": "是「大吉」哦！",
      "source_fingerprint": "79f06acde87fd5dd75b1b77b28835194b2022efd8e081d0c8844ad606117bcdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
