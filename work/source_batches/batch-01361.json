      ]
    },
    {
      "uid": "zhcn:8763dfc4965fcb9d17164e30",
      "kind": "character_system_text",
      "source_text": "训练员，谢谢你！！",
      "source_fingerprint": "5c9711c9ab1a92226e34584b76bf6c5cfdb6b63d55ff422e219ef6b968541f53",
      "source_path": "character_system_text_dict.json",
