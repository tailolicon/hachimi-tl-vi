        "70014"
      ]
    },
    {
      "uid": "zhcn:a2f91ba3ca0b73261ab315ec",
      "kind": "character_system_text",
      "source_text": "見ての通り、変身スーツがモチーフなんだ！",
      "source_fingerprint": "8e83e4a7a38b1e9f8aea1dc3be2c43a9f625843f88686cffc226e8fc44eab9eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1054",
        "70015"
      ]
    },
    {
      "uid": "zhcn:498674a7b6349cff69ea442f",
      "kind": "character_system_text",
      "source_text": "へーーーん！しんっ！とうっ！",
      "source_fingerprint": "10a1c638968f9c89c23fb515db6812ac28a98380222723207621e9346e93e9fe",
      "source_path": "character_system_text_dict.json",
