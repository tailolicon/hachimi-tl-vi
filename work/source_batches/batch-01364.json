        "70010"
      ]
    },
    {
      "uid": "zhcn:05291d5f1cff94f0f5d8e170",
      "kind": "character_system_text",
      "source_text": "ひらひらしてて、\r\nハチミープリンセスみたいだ！",
      "source_fingerprint": "9bf1b15ec2820ad955a0e4616bbf0912e5221dbef4cda1007d8fba0db5a2cfcf",
      "source_path": "character_system_text_dict.json",
