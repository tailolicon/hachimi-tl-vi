      "uid": "zhcn:1d39a2eb1229a091a39bd36a",
      "kind": "character_system_text",
      "source_text": "真的好开心呢！",
      "source_fingerprint": "7a915b71b1e21e2e986197d57b58925ffafcd5a80c23914b16c5d7c492444e0f",
      "source_path": "character_system_text_dict.json",
