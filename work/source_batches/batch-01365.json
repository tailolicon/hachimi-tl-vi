    {
      "uid": "zhcn:c7f181059bf4d10264277912",
      "kind": "character_system_text",
      "source_text": "パワーアーーップ！",
      "source_fingerprint": "07e670c410e48305d7f925034a27c16fcb7d61ebac6e11ccdb964e7d1f3da079",
      "source_path": "character_system_text_dict.json",
