        "1058",
        "20001"
      ]
    },
    {
      "uid": "zhcn:661837e491acaa8188160bce",
      "kind": "character_system_text",
      "source_text": "现在的我跟平常很不一样哦～\r\n因为我成功完全不吃螺丝地\r\n完成了好歌剧的模仿……！",
      "source_fingerprint": "c59e51e2e2d8a5d1a1f994cccd85bac43681b1bfdb984f6e05ff43647bdec850",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1058",
        "20002"
