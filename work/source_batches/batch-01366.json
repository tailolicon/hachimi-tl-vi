    },
    {
      "uid": "zhcn:338b9d505fcf4ca40b91f3d6",
      "kind": "character_system_text",
      "source_text": "头晕目眩的……奇怪？\r\n训练员变成了三个、五个……\r\n变得越来越多个了……",
      "source_fingerprint": "2b03e65a3c1e3477bd2a800b77e5444351e117c8be48ef4b806a06af9fdf6f2a",
