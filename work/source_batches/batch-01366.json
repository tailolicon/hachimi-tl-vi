      ]
    },
    {
      "uid": "zhcn:5417d811be61b7aaeb9fbb78",
      "kind": "character_system_text",
      "source_text": "唔唔……我想要休息一下下……\r\n我是个体力很差的赛马娘，\r\n真的很对不起……！",
      "source_fingerprint": "422db3f86fb1f07e26d5e2aea02f3f7bd45ea0f12aecb97059468110e72780c6",
