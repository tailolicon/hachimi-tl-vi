        "1055",
        "70010"
      ]
    },
    {
      "uid": "zhcn:07bbdeafaeb81a0b06f37d76",
      "kind": "character_system_text",
      "source_text": "一样的服装！团结的舞蹈！\r\n珍贵的预感～☆",
      "source_fingerprint": "a1bee8a1d460938d9e64d127e95b8e17ce02f279374b1731e6e87fd0f95999da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1055",
        "70014"
      ]
    },
    {
      "uid": "zhcn:df135f5f6e59a0d48449d7cb",
      "kind": "character_system_text",
      "source_text": "花朵～☆★\r\n开满在裙襬上，真是闪耀动人呢☆",
      "source_fingerprint": "12603b841b31800197a20184679416e5335a396657dac0cd913bcbbfcd9c9bef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1055",
