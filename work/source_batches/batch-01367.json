      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1058",
        "20042"
      ]
    },
    {
      "uid": "zhcn:8b052bf71faa949a9bc4d284",
      "kind": "character_system_text",
      "source_text": "奇、奇怪～？",
      "source_fingerprint": "9227b036f7921549bf0d3061222aeef450e67fa1ba854567295bdfafa2f33230",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1058",
