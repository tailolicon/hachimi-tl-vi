    {
      "uid": "zhcn:a7bd1e80aec0aa0a579f04a6",
      "kind": "character_system_text",
      "source_text": "心念一转！\r\n有什么事就要发生的预感☆★",
      "source_fingerprint": "2da03f3fd5f478bd7440439675a3d7de7e41fe3e7790ac699cb0bcfd072f67af",
