      ]
    },
    {
      "uid": "zhcn:5662d15b792a2e7f0304ad18",
      "kind": "character_system_text",
      "source_text": "锵锵──☆\r\n迅速换装──★☆★",
      "source_fingerprint": "c2e29812549c93df8b32d33678f813d3585f06886ae0b4064324e2a7b2cb0a5d",
      "source_path": "character_system_text_dict.json",
