    },
    {
      "uid": "zhcn:f8bffe95eea89149aeeb948e",
      "kind": "character_system_text",
      "source_text": "非常坚韧！要冒险也很适合☆",
      "source_fingerprint": "21599e5dacc8c41ff1ff5983c323e8a545ba7b25d6364989cd1ab8c1ab4260dc",
      "source_path": "character_system_text_dict.json",
