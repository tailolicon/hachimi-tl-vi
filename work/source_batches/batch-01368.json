      ]
    },
    {
      "uid": "zhcn:37ae311b5ebc1bbb6c85b20e",
      "kind": "character_system_text",
      "source_text": "诶嘿嘿.",
      "source_fingerprint": "c311c9fb79a57001f800256faaddf7f3effbfb35f07fa26516dacd9a02e6d680",
      "source_path": "character_system_text_dict.json",
