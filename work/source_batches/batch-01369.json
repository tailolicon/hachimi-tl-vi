      ]
    },
    {
      "uid": "zhcn:8b70d8a138801ab5a276e0dd",
      "kind": "character_system_text",
      "source_text": "よし！",
      "source_fingerprint": "e270ec23d5b6ff96972f8f7ce419fa9a68cfadaff85b8bd73e39c0e874c4c578",
      "source_path": "character_system_text_dict.json",
