      "kind": "character_system_text",
      "source_text": "あはは……",
      "source_fingerprint": "abda8926af79d75bd9923ad2e4b08f08a27fc02ba06fb4bfdb92258f3043a236",
      "source_path": "character_system_text_dict.json",
