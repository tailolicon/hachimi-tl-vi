        "1059",
        "91025"
      ],
      "json_pointer": "/1059/91025"
    },
    {
      "uid": "zhcn:beae9ac8ea4db4293077cd60",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "听说英国那边的红叶好像反而是黄色的偏多呢？\r\n只是很闲才调查一下而已，\r\n才不是想去玩……",
      "source_fingerprint": "f4fdceb39feae16cd8c3a89a9eea4714edbedf556a5a4c916f7351316663fb9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
