      ],
      "json_pointer": "/1059/91026"
    },
    {
      "uid": "zhcn:080625be6627753132a68e1d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "用缎带挡起来吧……不、不行！\r\n要好好通过锻炼来减肥才行！\r\n就在这个冬天把赘肉全都减掉！",
      "source_fingerprint": "353d1785e4b7b2faf3e9c3fd5703d9656e411b2682a1612530a9a0b77f80e746",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
