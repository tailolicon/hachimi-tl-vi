      ]
    },
    {
      "uid": "zhcn:3684a63cb08882437ea4a383",
      "kind": "character_system_text",
      "source_text": "啊哈哈……",
      "source_fingerprint": "47b5c20abae9548f6a768ce50f0c74ca578f87a9831911d1354fc0b65a452628",
      "source_path": "character_system_text_dict.json",
