        "140006"
      ]
    },
    {
      "uid": "zhcn:75041949e3ea1917aace72ec",
      "kind": "character_system_text",
      "source_text": "好像还蛮有趣的呢。",
      "source_fingerprint": "ae46e7403324c2399cb48d1530ee2b3344c10f93515aa08ec22789af9e378f67",
      "source_path": "character_system_text_dict.json",
