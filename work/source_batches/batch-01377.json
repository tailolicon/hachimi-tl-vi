      ]
    },
    {
      "uid": "zhcn:117b1f30e9685c0c85bd45f6",
      "kind": "character_system_text",
      "source_text": "啊……",
      "source_fingerprint": "fbe9b8a6562528c71dac2f35e4bb3503757fd80fd15a323c0f3842922f08e2da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140009"
      ]
    },
    {
      "uid": "zhcn:35d383748509d10404e6baf5",
      "kind": "character_system_text",
      "source_text": "真是的……",
      "source_fingerprint": "2e024616ec7a2bf1c748a0e016d56f11053ca841cb2a9d941ddb2fa396dd0aba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140010"
      ]
    },
    {
      "uid": "zhcn:31ecf27a50b8b6ebe6148f73",
      "kind": "character_system_text",
      "source_text": "好、好厉害……！",
      "source_fingerprint": "1de21683718b0db4f08ab90afa624e8d9d8c677f48567981c622ff6c8e114aca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140011"
      ]
    },
    {
      "uid": "zhcn:fa107a56a5913236a152122c",
      "kind": "character_system_text",
      "source_text": "做到了呢……！",
      "source_fingerprint": "b9d4525b4a9916feb1781ad947d9c3683c0c587b90b77c111c7356452de1d00f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140012"
      ]
    },
    {
      "uid": "zhcn:66e30993b7b65ac013ef73ea",
      "kind": "character_system_text",
      "source_text": "哇……！",
      "source_fingerprint": "d74e1c2cd08cd08b6309c3fc0f49ab65656b028659f7127989328d0155b2314e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140013"
      ]
    },
    {
      "uid": "zhcn:c8489e85fe2009a6cd66981d",
      "kind": "character_system_text",
      "source_text": "为什么……？！",
      "source_fingerprint": "858f80175b94386c92fa0dba74c7d7aa1fcb9ee62fbb1c91eda47ff3b29ff818",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140014"
      ]
    },
    {
      "uid": "zhcn:9fa3c63aaf6332953872a0d0",
      "kind": "character_system_text",
      "source_text": "嗯嗯……",
      "source_fingerprint": "26ff4925698843c3792c7f0bc377e245a84f32db565113d4ccaa189fe812f9dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140015"
      ]
    },
    {
      "uid": "zhcn:7cb1f7a4678c2121ff5f02ff",
      "kind": "character_system_text",
      "source_text": "你在紧张吗？",
      "source_fingerprint": "e8129d06c35154219997417fa244a6a17610171f8e5ce9571994892493312e3d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140016"
      ]
    },
    {
      "uid": "zhcn:4ca41c426804aecf75341a67",
      "kind": "character_system_text",
      "source_text": "啊啊～！",
      "source_fingerprint": "d222d8e98405f03a4ce9611c56c50b413f34ce6a63307705783d63a266cb7cdd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140017"
      ]
    },
    {
      "uid": "zhcn:e2f27bfe1cc3377fb57e4b5e",
      "kind": "character_system_text",
      "source_text": "等……呜呜……",
      "source_fingerprint": "e3a60b80799250ac66ad3a0af5f656d352cec06ef3c4c0447fac63859e2e62ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "140018"
      ]
    },
    {
      "uid": "zhcn:afe491c1206bc0602eed372f",
      "kind": "character_system_text",
      "source_text": "明天……能拿到这个呢。",
      "source_fingerprint": "eaf36790390c7c57aab78fd990d3833da29d26277b1053cc4a0f6164f7ba0357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "15"
      ]
    },
    {
      "uid": "zhcn:666885ec196501d3383ad970",
      "kind": "character_system_text",
      "source_text": "感觉身体好沉重……啊，不是。\r\n你听错了。那个……别管我就行。",
      "source_fingerprint": "7495cb96b993537255137e3e79ae03edc485f17db7f7c0afd097a867392dfc34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20000"
      ]
    },
    {
      "uid": "zhcn:10c1697481b459b54fbc62c7",
      "kind": "character_system_text",
      "source_text": "稍微……让我休息一下吧。\r\n休息一会，马上就能继续努力了。",
      "source_fingerprint": "170f10f17a50a24ef106c1954d9937a004e14accde24054571b1b0fd751a2aa2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20001"
      ]
    },
    {
      "uid": "zhcn:172509e8925a6c43ddc66c14",
      "kind": "character_system_text",
      "source_text": "现在感觉双脚好轻盈……！\r\n训练还没开始吗？！\r\n我想尽快开始奔跑……！",
      "source_fingerprint": "c7d1529bbe5c854398a39351c1c7d1c6ea3bb32aaf48b695576c3c13642aca0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20002"
      ]
    },
    {
      "uid": "zhcn:cc824e4622745c85eafb4e83",
      "kind": "character_system_text",
      "source_text": "不管怎么跑都冷静不下来……！\r\n现在的我感觉真是无所不能呢！",
      "source_fingerprint": "8565cfa34470eea011222796125725f023ce1453cef76fd62c667a7a1022bc5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20003"
      ]
    },
    {
      "uid": "zhcn:760a175b0915115fa653b0a8",
      "kind": "character_system_text",
      "source_text": "嗯，感觉不错……！\r\n这样的话，一定能收获满意的结果！",
      "source_fingerprint": "be3528d8b410f76d8b61d928f87e0dc1b668971042d43a93016a19482a695840",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20004"
      ]
    },
    {
      "uid": "zhcn:87d5d6baeabe7c58aa950e11",
      "kind": "character_system_text",
      "source_text": "今天训练些什么？尽管说吧。\r\n我一定会完成所有的训练的！",
      "source_fingerprint": "fd6a59884b437cc3b09b5d6359fbe51d09b54d47a6028336127d99d82851001f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20005"
      ]
    },
    {
      "uid": "zhcn:e42816ac82cdd4de93ca72b8",
      "kind": "character_system_text",
      "source_text": "今天也得加把劲才行……\r\n说说看你的计划吧。",
      "source_fingerprint": "4cce0c4e7d8dddf94640a5b0df1a4c0ee075d603693b3945cf2cdf936901d7b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20006"
      ]
    },
    {
      "uid": "zhcn:d366e59fbd78cf4b3617da91",
      "kind": "character_system_text",
      "source_text": "想要不输给别人的话，\r\n必须得加把劲训练才行。\r\n开始吧，训练员。",
      "source_fingerprint": "84dfefed10dcf189e76fba246284e8d7fa20651f0b36b926d414aceaabfac2a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20007"
      ]
    },
    {
      "uid": "zhcn:670cf80e9402412d36d84e5e",
      "kind": "character_system_text",
      "source_text": "……总觉得有点打不起精神。\r\n明明还想再努努力的……",
      "source_fingerprint": "85594cf75c2540b104fe19672451c4f9f3fa9b7640b854e6b81e3b38728d1a0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20008"
      ]
    },
    {
      "uid": "zhcn:ab448465e0c6da47c683dc75",
      "kind": "character_system_text",
      "source_text": "哈啊……怎么了？\r\n不就叹口气而已，我不是经常这样吗。\r\n只是……有点打不起精神而已。",
      "source_fingerprint": "49c47c4d4f546d7b09fd614d48f71ffb9117fcb38c6b904596f5ff9527785145",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20009"
      ]
    },
    {
      "uid": "zhcn:e4ea7863173c3f0e08f46383",
      "kind": "character_system_text",
      "source_text": "来见习的人……是不是有点太多了？\r\n哈啊……真讨厌呀。\r\n这样我根本没法集中精力啊……",
      "source_fingerprint": "2ec2ee1b3307c932766e4e9b1cc2e23abe688ddb6b95e42f6c224d83533f382b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20010"
      ]
    },
    {
      "uid": "zhcn:0c7e0733c9231ac9b425b443",
      "kind": "character_system_text",
      "source_text": "明明脑子清楚该做什么，\r\n但是脚却没法随心所动……\r\n果然我这种人就是……",
      "source_fingerprint": "53a01b8d889c93a3e804305050e60c392adf702c839d27f87f237fb9193cd4f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20011"
      ]
    },
    {
      "uid": "zhcn:503bba6791b29e5917a115c2",
      "kind": "character_system_text",
      "source_text": "诶？你真的想继续跑比赛？\r\n现在的我根本赢不了吧……？！",
      "source_fingerprint": "22f0bae2abf5bdcfbea83e3552e1f55ec8cd18c3c0e348fc5b190f7c1bf6c879",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20021"
      ]
    },
    {
      "uid": "zhcn:57a7ff0283e3830c06731d54",
      "kind": "character_system_text",
      "source_text": "……哈啊。又是连战，\r\n你到底想做什么啊？",
      "source_fingerprint": "87979345f3d6b7b8e023df49866d2ebb30c0425e948a301cbe6a2c59d57722e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20022"
      ]
    },
    {
      "uid": "zhcn:a34e7df14f4847ffc0d96c47",
      "kind": "character_system_text",
      "source_text": "状态调整得不错呢。\r\n这样的话，一定能获胜了……！\r\n好好注视着我的奔跑吧。",
      "source_fingerprint": "3e052280445a4f5432e155d5bcbd0932a383e06659dc5ff915168561a795e0e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20023"
      ]
    },
    {
      "uid": "zhcn:32eb082f627bf62ce5bfa686",
      "kind": "character_system_text",
      "source_text": "是因为做好了准备吗，\r\n就算沐浴在众人的视线下也不会觉得可怕……\r\n嗯，这样的话就一定没问题了！",
      "source_fingerprint": "e7cea17665efec4fa25f02b64bec6ad336c513f385f0e79284e73cb3643ab8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20024"
      ]
    },
    {
      "uid": "zhcn:4fbb37c13be9b6973c4aa5bc",
      "kind": "character_system_text",
      "source_text": "呼……吸……嗯，好了。\r\n一定不会让为今天而付出的努力白费！",
      "source_fingerprint": "770e4310b7826567da67abbc685409f5cc8425da209871b11db1ecc4ff8120cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20025"
      ]
    },
    {
      "uid": "zhcn:ae5e1f6bd72893d5b784addd",
      "kind": "character_system_text",
      "source_text": "我做好准备了哦。\r\n脑子里已经对比赛的发展有了大概的印象，\r\n接下来尽情奔跑就好了。",
      "source_fingerprint": "b866d8e1b4380df28d32abec475539cf0814fd2325013395acd554fde29705f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20026"
      ]
    },
    {
      "uid": "zhcn:3d0d579e23567ea035539e2f",
      "kind": "character_system_text",
      "source_text": "到现在为止都很顺利呢。\r\n……没关系的，没关系。\r\n这个状态的话，照平时那样奔跑就好了。",
      "source_fingerprint": "d788ac7e3846abf29b2e3ac6584273abed8f90f95b466186abb8ce29ef2ce50f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20027"
      ]
    },
    {
      "uid": "zhcn:7b2397b7adc14fc6ca78edbe",
      "kind": "character_system_text",
      "source_text": "呼……现在一点儿也不紧张，感觉不错呢。\r\n接下来就只差气势了……好。",
      "source_fingerprint": "e01ae4a6e7511698a7c34cffbb8a53eca14cc9fd068f97e8e93ccab9b1c7b95b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20028"
      ]
    },
    {
      "uid": "zhcn:d1dd4e323a3c9080de0e13c3",
      "kind": "character_system_text",
      "source_text": "嗯……虽然还有点紧张，\r\n但没关系。准备比赛吧。",
      "source_fingerprint": "fc0422e4994d342d5371d75000543c2cca9b399da04bacc0c87768b8eeeee10a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20029"
      ]
    },
    {
      "uid": "zhcn:0e62349593c454b302065d4e",
      "kind": "character_system_text",
      "source_text": "不用你担心，我没事的。\r\n就像平时训练时的那样，\r\n我按照我的跑法来比赛就好了。",
      "source_fingerprint": "a3d16229ab1d87efd4ad11e647759b7be98ce3c0a84c4bea1d2af13a0c5a91c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20030"
      ]
    },
    {
      "uid": "zhcn:e97e73fc4abcda1c2aebca31",
      "kind": "character_system_text",
      "source_text": "……现在还挺冷静的。\r\n应该能发挥出训练的成果吧。",
      "source_fingerprint": "cb5c2fce8af183475061d2227562b1bd58f58d4faa2bd6845adc2c948b0706d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20031"
      ]
    },
    {
      "uid": "zhcn:222de74e9e40e8395835e3cb",
      "kind": "character_system_text",
      "source_text": "……怎么办，\r\n好像比我预计的还要紧张……\r\n深呼吸、深呼吸……呼……吸……",
      "source_fingerprint": "13733e592919d6ffb3b9b250be55f027262ff78b81b8696b7836e92d17c16942",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
        "20032"
      ]
    }
  ]
}
