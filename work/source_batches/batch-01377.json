      ]
    },
    {
      "uid": "zhcn:efeaf2d04d743d35c4ddaaa4",
      "kind": "character_system_text",
      "source_text": "好厉害，能抓到这么多！",
      "source_fingerprint": "b6313025d3542d0966746deae3f8dd182b3bf187f42deb754693c884506fc668",
      "source_path": "character_system_text_dict.json",
