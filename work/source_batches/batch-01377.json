    {
      "uid": "zhcn:c65db3511ee989aa19487bd2",
      "kind": "character_system_text",
      "source_text": "好像达成任务了。\r\n看来你也是有在努力的嘛。",
      "source_fingerprint": "53dd711290d8d1f2e6da41ef3081c2d22fec87bb6cb0ea46fdf7c3f29143fecb",
      "source_path": "character_system_text_dict.json",
