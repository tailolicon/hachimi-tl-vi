      ]
    },
    {
      "uid": "zhcn:d4302979216c0c2a5b168cae",
      "kind": "character_system_text",
      "source_text": "呵呵……",
      "source_fingerprint": "d880d453ed393bb96ce87b11e9d17cc27e0658af14b02e8f6501c50388b2c4a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1059",
