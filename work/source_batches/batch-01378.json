      "kind": "character_system_text",
      "source_text": "我输了……",
      "source_fingerprint": "be75ef2ceadfbe7d34c8257778aca5e9e8d5eec946d714bf77f49a6d0dd375da",
      "source_path": "character_system_text_dict.json",
