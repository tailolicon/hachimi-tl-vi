      ]
    },
    {
      "uid": "zhcn:fba241c1708c637b6d90f2ce",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "12"
      ]
    },
    {
      "uid": "zhcn:2e43fd1a91ffcb8e12fb7eb2",
      "kind": "character_system_text",
      "source_text": "力量“噗哇”地出现啦～！",
      "source_fingerprint": "98a5ff00a8aa9be83870d539bc7c0c3306922d2e6708319f0ce48411572226e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "120000"
      ]
    },
    {
      "uid": "zhcn:dc59c77006f0dd11aced03a1",
      "kind": "character_system_text",
      "source_text": "今天的登录奖励哦～！",
      "source_fingerprint": "59303f0366accaf8c7eeb0512a6fff3424073737bea66dfa34fd2cb2001f53a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "13"
      ]
    },
    {
      "uid": "zhcn:7ce20be61242bc2be1a50d48",
      "kind": "character_system_text",
      "source_text": "好可爱，能取下来吗！？",
      "source_fingerprint": "eacb8656c51b2c28d49f542f0701d8c22df299842779224b25bd6bc30034421c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140000"
      ]
    },
    {
      "uid": "zhcn:7172482a477cead9f59aa0a0",
      "kind": "character_system_text",
      "source_text": "好耶～！",
      "source_fingerprint": "9f2b25aea591789d93c8295b3a2c30110ea2c5eae7faeb34de9ea735a084f5bf",
      "source_path": "character_system_text_dict.json",
