      "source_text": "新纪录吗！？",
      "source_fingerprint": "66a0c896490da8143e7711373a4cfd8986610a8498e654b18af09d69086773e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "1007"
      ]
    },
