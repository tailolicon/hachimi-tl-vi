      ]
    },
    {
      "uid": "zhcn:1aacc94a908b5a2d68cd587c",
      "kind": "character_system_text",
      "source_text": "やったろーっ！",
      "source_fingerprint": "5b68f388154dd94fd3248c1027c16cac4323f02d2312bba1f1566921c025bd5a",
      "source_path": "character_system_text_dict.json",
