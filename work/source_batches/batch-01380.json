      "source_text": "内恰，出发咯～！",
      "source_fingerprint": "9d754cf59e10cb256885a25970c366998cf6a6f9cae72c6d21396b6f0496d929",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
