      "source_text": "这不是做到了吗…！",
      "source_fingerprint": "b4cb2b4d8d5e5d0fd232aa9e7f5835d6cbe440707810c6a53df6e0d3883e1cf4",
      "source_path": "character_system_text_dict.json",
