      ]
    },
    {
      "uid": "zhcn:7d5905de8e6ea25ce3af2f0b",
      "kind": "character_system_text",
      "source_text": "啊ー、确实呢～…",
      "source_fingerprint": "c69e019d8adfb5e903fc41299f92d622d377a1660e337e0af650a992ccb9375e",
      "source_path": "character_system_text_dict.json",
