      "kind": "character_system_text",
      "source_text": "是登录奖励呢～。",
      "source_fingerprint": "65de1f70e4c6ed1bc651ff36fffdaaf786ee0e420c633a75dd16ff47adb24669",
      "source_path": "character_system_text_dict.json",
