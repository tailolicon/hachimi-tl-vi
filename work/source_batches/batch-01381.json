      ]
    },
    {
      "uid": "zhcn:f70dafcfe9c7d95f08bf35d6",
      "kind": "character_system_text",
      "source_text": "出发啦！",
      "source_fingerprint": "e614f61077baa5c32c3da74aeeadf26136d27b54dd9da15478f03b2843c04ca3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20046"
      ]
    },
    {
      "uid": "zhcn:b0d89e24edd4cf5c59a62d74",
      "kind": "character_system_text",
      "source_text": "大海呀～！",
      "source_fingerprint": "0978a38f97c31bb42956f46991c73b5bebad0403dde1096e6c3221365626dfa4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20047"
      ]
    },
    {
      "uid": "zhcn:818a7d6ace88830d140ce1fd",
      "kind": "character_system_text",
      "source_text": "多亏了训练员，我充分努力哦…！",
      "source_fingerprint": "d2e698d55937dabf8d02f5a743d4514c7f50a79a566b51432835ef7d142667bc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20049"
      ]
    },
    {
      "uid": "zhcn:6b3dec447f25472dad565c4a",
      "kind": "character_system_text",
      "source_text": "真的，十分感谢！！",
      "source_fingerprint": "e4514a4f2de767f5d70c75212cb494a5e89255dea760e41e6073af28282a9e54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20050"
      ]
    },
    {
      "uid": "zhcn:a9a5ad9b7dd92fd7d2aaeb1f",
      "kind": "character_system_text",
      "source_text": "呣！加油～！",
      "source_fingerprint": "8c8aab72b5228a13306c76298bf395b0a96e9cfdd99366174f351b9b8d29fdcd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20051"
      ]
    },
    {
      "uid": "zhcn:2ddc99662b63fc488d2377e6",
      "kind": "character_system_text",
      "source_text": "大家，加油咯ー！",
      "source_fingerprint": "f3bfbffc1bc9d1f595b2f80d07551bfd5f48273972e52bbe97e12d08f4c09c2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "2030"
      ]
    },
    {
      "uid": "zhcn:165a3c94998c5eac3c3c2f12",
      "kind": "character_system_text",
      "source_text": "大家，加油咯～！",
      "source_fingerprint": "d8cbc84f835589156798bf0e5cfb8b49507c3a548ffa015a8c775ef24935c08f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "2031"
      ]
    },
    {
      "uid": "zhcn:3df61b0a0f3b385fe39679b2",
      "kind": "character_system_text",
      "source_text": "真的，十分感谢！！",
      "source_fingerprint": "e4514a4f2de767f5d70c75212cb494a5e89255dea760e41e6073af28282a9e54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "2032"
      ]
    },
    {
      "uid": "zhcn:dde890cdbee5049346237b11",
      "kind": "character_system_text",
      "source_text": "到这里为止都感觉良好，\n没问题的吧。\n接下来就是气势了～呣呣～！",
      "source_fingerprint": "d98cd167f3a5a05c9e3f532568419824e04c88d67516f76c8a48f6a2bde272d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "2033"
      ]
    },
    {
      "uid": "zhcn:830c071b8a60181ad34ea9d3",
      "kind": "character_system_text",
      "source_text": "记下来的笔记也复习完了，\n剩下就是全力奔跑了…！\n好，好好看着吧～！",
      "source_fingerprint": "440d750c59df54f149c566450642790797287328c757b70b835a70239c49bb7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "2034"
      ]
    },
    {
      "uid": "zhcn:79bf5f5c45e24b33ff4a10b4",
      "kind": "character_system_text",
      "source_text": "真的，十分感谢！！",
      "source_fingerprint": "e4514a4f2de767f5d70c75212cb494a5e89255dea760e41e6073af28282a9e54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "2035"
      ]
    },
    {
      "uid": "zhcn:274afbe22098ff65dc02b361",
      "kind": "character_system_text",
      "source_text": "よーし！",
      "source_fingerprint": "e548208329c219ba46218e46dc381f3a2964dbf221f890a7ff2ac40af246165a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "23015"
      ]
    },
    {
      "uid": "zhcn:f99a6b7f1568b91238c1fbcd",
      "kind": "character_system_text",
      "source_text": "哟～！再稍微，再稍微！",
      "source_fingerprint": "788b48f9ce84e41070cdc0bbde0c9a06635809758f5bbb8b67b43501d13d1e1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30000"
      ]
    },
    {
      "uid": "zhcn:1194e45d6a6819918309328f",
      "kind": "character_system_text",
      "source_text": "呣，从现在开始咯～",
      "source_fingerprint": "2f0ce1940f19c74a545aff086fbd214bc35f4fc762c36f83f454e93d3281afc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30001"
      ]
    },
    {
      "uid": "zhcn:e0524cef9b2bf998a7fb7df4",
      "kind": "character_system_text",
      "source_text": "更多更～多，向前方加油！",
      "source_fingerprint": "8c408b190bc52e6be9d03ab493691ebadeaddea65c4893d689a5f4a1349b58a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30002"
      ]
    },
    {
      "uid": "zhcn:9b8eb8c7b18b538b80d14e60",
      "kind": "character_system_text",
      "source_text": "什么嘛，还差得远呢！",
      "source_fingerprint": "962136c42f8142dc476e91e9b0155b7d9118e9d40e7b680868e003c6788acf03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30003"
      ]
    },
    {
      "uid": "zhcn:8f0324f6bd0bf12442c39450",
      "kind": "character_system_text",
      "source_text": "好耶好ー耶，好耶耶ー嘻嘻♪。",
      "source_fingerprint": "8d851e585ba0cbe0622589ea733d6daa06a46e70c4f0e71b0716c61ee84f5226",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30004"
      ]
    },
    {
      "uid": "zhcn:042b41635c2a9ccc201a6d7f",
      "kind": "character_system_text",
      "source_text": "今天的奔跑，一定要好好记住！",
      "source_fingerprint": "86b7f01d22497da9f5e14ac1d42d35f75f907a88383473d1cf8cfca7eb098dc4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30005"
      ]
    },
    {
      "uid": "zhcn:0a29b3ad88394173ecb1e43a",
      "kind": "character_system_text",
      "source_text": "耶嘿嘿……\r\n我有让大家看见我厉害的一面了吗？",
      "source_fingerprint": "8f7cb110823d9586922da276167866cea6e14dca1b04030e313aff17b3bf1997",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30006"
      ]
    },
    {
      "uid": "zhcn:73cdd83127260d4f0dbb1094",
      "kind": "character_system_text",
      "source_text": "得好好记住今天的跑法才行！",
      "source_fingerprint": "305d19571526725f162ddae7aa834ecec2df9fbc244bbf9d8a815e72566b3485",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "30007"
      ]
    },
    {
      "uid": "zhcn:34e8514e04655ece305badee",
      "kind": "character_system_text",
      "source_text": "不会输的哦！",
      "source_fingerprint": "cc71670b822a05337e60f6fd65bd5941f83e26ae8f18fb2472afc9ca941b74e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "31000"
      ]
    },
    {
      "uid": "zhcn:913c5b8accbfdc94f26ceafb",
      "kind": "character_system_text",
      "source_text": "哇等等～，怎么了！",
      "source_fingerprint": "5fdc34319e8122908d4a0918392c984c671f785e3473ef69f22ad0966d9e737b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "40000"
      ]
    },
    {
      "uid": "zhcn:ca4da64513b752ea35894c88",
      "kind": "character_system_text",
      "source_text": "叔叔他总是在观众席上，\r\n挥舞着双手为我加油！\r\n……真想好好回应他呢。",
      "source_fingerprint": "17967beaef855e18127687a6d0d297db7ed665e0b0bc6c085ca7f8bc4a3ae314",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "400000"
      ]
    },
    {
      "uid": "zhcn:4b4c447cf49b480d764cf072",
      "kind": "character_system_text",
      "source_text": "きっと私だけだったら、森の中を\r\n大冒険！なんてならなかったよね。\r\nありがたや、ありがたや～。",
      "source_fingerprint": "da6c70a15b3b62da7b88e17098c7cc6db972ac742dd47d7841a1f1c9a4510346",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "400003"
      ]
    },
    {
      "uid": "zhcn:b50f7e5cf33d312dbcf3ec77",
      "kind": "character_system_text",
      "source_text": "素质说她们也会来帮我加油呢！\r\n这下就得全力以赴永不放弃啦～！",
      "source_fingerprint": "d7da44fdb1c88947e5779c2184110db24751d92b838907ef1d5e774fdc4db792",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "400004"
      ]
    },
    {
      "uid": "zhcn:cee6066ada854e8c51eb0813",
      "kind": "character_system_text",
      "source_text": "みんなとお宝探しなんて、\r\n楽しいソロキャンだー！\r\n…ソロキャン？　…みんキャン！",
      "source_fingerprint": "1e8ef6f54089dca3a8e1f8d6e91d6dfc6066ea25ba8ad3c68e1e8a39f1eb8aa6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "400006"
      ]
    },
    {
      "uid": "zhcn:a3a806d73897c7bcbeca9043",
      "kind": "character_system_text",
      "source_text": "笔记本就绪ー，毛巾就绪ー，\n状态…今天也很～～好！！\n加油咯ー！诶，诶，呣！",
      "source_fingerprint": "31532892c5ffaa9fdfeb06530f284f849b39c3742b9254f11e06fe680c6726eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "400008"
      ]
    },
    {
      "uid": "zhcn:0d714830468587724d505268",
      "kind": "character_system_text",
      "source_text": "这就是生野一直想看到的景色……\r\n耶嘿嘿，对我来说\r\n也成为了特别的回忆！",
      "source_fingerprint": "65d8cd1ec1e72d8b48cdf2c348c3447c282d22e957aa2fdd821079f51ff04f55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "400009"
      ]
    }
  ]
}
