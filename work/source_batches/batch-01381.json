      "kind": "character_system_text",
      "source_text": "不得了！奇迹发生了…！",
      "source_fingerprint": "c09cb60f9e666f928eb8be696918a3207d44e2746d1f32e7eed3d5dc4704c6ff",
      "source_path": "character_system_text_dict.json",
