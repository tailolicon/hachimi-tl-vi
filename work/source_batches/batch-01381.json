        "20042"
      ]
    },
    {
      "uid": "zhcn:d39cc37552481e31ddc555be",
      "kind": "character_system_text",
      "source_text": "咕哇…",
      "source_fingerprint": "2c835eab7cad68a53b6345e77dbc2594b4f0add8cc30d3afdd9a0f0be887213a",
      "source_path": "character_system_text_dict.json",
