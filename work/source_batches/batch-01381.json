      "kind": "character_system_text",
      "source_text": "打起精神来吧！",
      "source_fingerprint": "0f4429653afa9c566a8ee4b5570ccc37845bb0303b4074707626aff4a4d5541d",
      "source_path": "character_system_text_dict.json",
