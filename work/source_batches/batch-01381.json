      ]
    },
    {
      "uid": "zhcn:20229e1b3c33c193c345d3b7",
      "kind": "character_system_text",
      "source_text": "呼呣呼呣！",
      "source_fingerprint": "1ac791234dc1c8a699ec2ee4e96da26c22b7359ae8ded8b5c9375859f9041738",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20041"
      ]
    },
    {
      "uid": "zhcn:e64a9a3230915350dc3f491a",
      "kind": "character_system_text",
      "source_text": "啊呀哇～。",
      "source_fingerprint": "206d52dda559f58812a7870bcd8f2b921ea3b9369a774a1ad7788fa635fac897",
      "source_path": "character_system_text_dict.json",
