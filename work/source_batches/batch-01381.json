      ]
    },
    {
      "uid": "zhcn:9dd97bc1c9eb775f0c29b8ab",
      "kind": "character_system_text",
      "source_text": "真愉快啊～。",
      "source_fingerprint": "42bc582617909b18d3c21c68f675f87bc16d9141c57795b6837dd21ca4ed0b18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140007"
      ]
    },
    {
      "uid": "zhcn:d8c6185f2c1b4bcbf6f52348",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140008"
      ]
    },
    {
      "uid": "zhcn:b07da0f6de0e128c3d32a5f9",
      "kind": "character_system_text",
      "source_text": "あははっ。",
      "source_fingerprint": "faef35818c722995ce0ac1ef38c9a07ca7b218722f2cf83b0bf4e4faa5241b74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140009"
      ]
    },
    {
      "uid": "zhcn:16feff4d0a7123a042959fbd",
      "kind": "character_system_text",
      "source_text": "呣ー！",
      "source_fingerprint": "c4f09281398e528511f9d710b447561ce59f36dcfabc499ba9f9e92291736f86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140010"
      ]
    },
    {
      "uid": "zhcn:663d442cc73432cdc92b54b6",
      "kind": "character_system_text",
      "source_text": "哦哦哦～！？",
      "source_fingerprint": "0924fc9ceb0531b4940cbf9aefc41b79c77ca423893d536e5e2dc0ac57f87ffe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140011"
      ]
    },
    {
      "uid": "zhcn:8cddd8192719c4e5bba9aebd",
      "kind": "character_system_text",
      "source_text": "不要要ー！",
      "source_fingerprint": "c4b9fb1c1b1883fc6ddcb2eeac674c09b8f8eff2d83f47cc4c150cd04f884e4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140012"
      ]
    },
    {
      "uid": "zhcn:b2b329ff2e7252b6c7e740f4",
      "kind": "character_system_text",
      "source_text": "哇啊～！",
      "source_fingerprint": "19a7e8d715c640700e8d81b179d2ec702bab36bb8d77ec39a07f3d4b2ff0e4c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140013"
      ]
    },
    {
      "uid": "zhcn:39c58a899f46d919e74cb00d",
      "kind": "character_system_text",
      "source_text": "怎么这样～！？",
      "source_fingerprint": "c8375749d334c87a473856a71a1a4b42c60cae06783f44e31dbf04636ab663c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140014"
      ]
    },
    {
      "uid": "zhcn:43d6885169caf542c0fa0867",
      "kind": "character_system_text",
      "source_text": "dokidoki…",
      "source_fingerprint": "f0bb1e7855c69133737ebd2b9a8e9cee02550e6eea13d850dbe6f556730a4e97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140015"
      ]
    },
    {
      "uid": "zhcn:55ca9a525a017751808f5c99",
      "kind": "character_system_text",
      "source_text": "在吗在ー吗？",
      "source_fingerprint": "5541a2203fb76c5b79564d854c84a3a923c94a944d78ed12714cc2fb60ebe6fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140016"
      ]
    },
    {
      "uid": "zhcn:1cdfcbf71966d8c175471972",
      "kind": "character_system_text",
      "source_text": "呼哇啊。",
      "source_fingerprint": "df3ca69f5f4d601209858e47a6da568bdb3af0d953f1afff26663ae331014522",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140017"
      ]
    },
    {
      "uid": "zhcn:c6a348a728eb023e33e5270f",
      "kind": "character_system_text",
      "source_text": "啊呜呜呜…",
      "source_fingerprint": "6d128aa27a176c597a824986a5474dc1342f72a9e683c9b75a5f4fa29df2cc7c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "140018"
      ]
    },
    {
      "uid": "zhcn:5f3e00498f4f08c9c39ff87f",
      "kind": "character_system_text",
      "source_text": "明天好像能拿到这个！",
      "source_fingerprint": "a6975cf663d0723fd77a7c75851e609e8cdbdf5d5100ca87706996c84cd7117b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "15"
      ]
    },
    {
      "uid": "zhcn:8439967d0ec7a051b29117ee",
      "kind": "character_system_text",
      "source_text": "诶咯咯咯～…总感觉很累…\n不，我还能行！",
      "source_fingerprint": "d22d38c6d27a447d37d7bdb3e28e0b593a10d66af686d708302284051d70275a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20000"
      ]
    },
    {
      "uid": "zhcn:326307bf0e65eb774809e8c3",
      "kind": "character_system_text",
      "source_text": "啊呜诶…身体好重…\n对不起～，\n请让我稍微休息一下～。",
      "source_fingerprint": "0f8d5130618ab8f6704de7245ef3d7b5316e4484002977a803cefcb70f59c73d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20001"
      ]
    },
    {
      "uid": "zhcn:fb1e9750c0af58404ec2901a",
      "kind": "character_system_text",
      "source_text": "哇ー！总感觉状态\n非常好呢～！？今天\n好像能“叭biu”～地出发！",
      "source_fingerprint": "87c923aa58b04ad977e28b4999d4f23d943462ee893590db78b2b0c5ae2643d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20002"
      ]
    },
    {
      "uid": "zhcn:16562467e3baed64fb5f4bcb",
      "kind": "character_system_text",
      "source_text": "今天的脚十分的轻！\n现在出发的话一定会\n发生不得了的事哦ー！哼哼♪",
      "source_fingerprint": "facd682146c58011cb456611f6078975525ed83e66598f179447dd9537ecfaab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20003"
      ]
    },
    {
      "uid": "zhcn:5485f935ea21bd239a43ac69",
      "kind": "character_system_text",
      "source_text": "今天要做什么？\n不管是什么事，\n都能“叭叭”～地解决哦～！",
      "source_fingerprint": "05478d246c8636c26742a012401754d7e85a685c6c986582d269fbbd479bf96b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20004"
      ]
    },
    {
      "uid": "zhcn:1e1ee92e2bf4f61e87678267",
      "kind": "character_system_text",
      "source_text": "哼哼～♪\n总感觉心情很好。\n今天应该会跑得很舒服！",
      "source_fingerprint": "3bb3c33455a4021bed19f718ca0d7f2fe86a100d907d3aa92b1bdd254d8a2342",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20005"
      ]
    },
    {
      "uid": "zhcn:5c9dd8a90b375e1996ea37e6",
      "kind": "character_system_text",
      "source_text": "今天也要加油啊～！\n好，要做什么吗？",
      "source_fingerprint": "9c555a338fc520c3459c3d7029726a8dd41e950048de4071260497811494a603",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20006"
      ]
    },
    {
      "uid": "zhcn:ddb0bd8fabf4d0d37ed2490c",
      "kind": "character_system_text",
      "source_text": "唔呣。为了不输给大家，\n要好好训练才行！",
      "source_fingerprint": "331ee83f3ae52bf83468ad93093f5dfc59e06fad6174895c0bbc1b7531c9b8e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20007"
      ]
    },
    {
      "uid": "zhcn:499acea7c35a7ee3f8f9c5c7",
      "kind": "character_system_text",
      "source_text": "嗯嗯～？状态好像和平常\n不一样？嗯嗯？？",
      "source_fingerprint": "1bd4dce67bf3a5398deaba3dd2603f110694d7357ae5dd73f5b466b268650b2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20008"
      ]
    },
    {
      "uid": "zhcn:8f48fee8782e98ee4243f43f",
      "kind": "character_system_text",
      "source_text": "哎呀？脚好像不能随意活动？\n为什么呢，好奇怪啊～。",
      "source_fingerprint": "53adecfc9acf179edbf9c9dad621700ab5f068c6d0d93641fd10572c47dca90d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20009"
      ]
    },
    {
      "uid": "zhcn:95975d8aecce5a1cb8a9bbf4",
      "kind": "character_system_text",
      "source_text": "…哈。对不起，\n我好像发呆了…\n………啊，又…",
      "source_fingerprint": "c41a3444fa2f702683afacd35330ca158871e6310934955f641a72c5612bd347",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20010"
      ]
    },
    {
      "uid": "zhcn:0e0713de6dfddd5de667df25",
      "kind": "character_system_text",
      "source_text": "训练笔记…必须记下来…\n但是今天已经…不不，\n必须好好地做…",
      "source_fingerprint": "79c3f7a3e8bcbf1282f7d3f1c9a70cd251e720b9240992126ecb853487bdf3a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20011"
      ]
    },
    {
      "uid": "zhcn:cd2f8c10990400c44539598f",
      "kind": "character_system_text",
      "source_text": "哈呜啊，又要比赛吗！\n奴哦～！做得到吗，诗歌剧，\n做得到吗～！？唔～呣！",
      "source_fingerprint": "758335ef5f94e4efdc65565552a5e7881a9fc0feb9ea08f62ac548d57f0eceae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20021"
      ]
    },
    {
      "uid": "zhcn:e8c82fcbdba9504f4f188855",
      "kind": "character_system_text",
      "source_text": "什什，什么！？\n又要连续比赛吗！？\n哟哟哟哟…真够呛啊～！",
      "source_fingerprint": "e8a2f1792d998ed87999ba86c6a52c743304536f6c5a0be83a98d332fd27392c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20022"
      ]
    },
    {
      "uid": "zhcn:4fa3e2c3c397a0ddbfb5fcc5",
      "kind": "character_system_text",
      "source_text": "好好地调整过了呢。\n出发吧ー…为了这一天\n一直努力着…！",
      "source_fingerprint": "3503bd757d754b00f27fb5ecaa1457a261e191d52414754232f2b251cb965331",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20023"
      ]
    },
    {
      "uid": "zhcn:78a5820ef136c4aadc554737",
      "kind": "character_system_text",
      "source_text": "大口吸气ー呼气ー！\n好好地没问题！\n腿脚和心理的准备都很充分！",
      "source_fingerprint": "f3a19a59d8b88b9b329d9116ceacac8d5ee1492603a9799e2a22c9f62304eeb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20024"
      ]
    },
    {
      "uid": "zhcn:ec2ee557de10a0bb8f286872",
      "kind": "character_system_text",
      "source_text": "记下来的笔记也复习完了，\n剩下就是全力奔跑了…！\n好，好好看着吧～！",
      "source_fingerprint": "440d750c59df54f149c566450642790797287328c757b70b835a70239c49bb7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20025"
      ]
    },
    {
      "uid": "zhcn:7caa7356b9acfc85e28656e1",
      "kind": "character_system_text",
      "source_text": "适当的紧张感…嗯，没问题。\n加油啊，我！\n好好享受比赛吧！",
      "source_fingerprint": "838c757861fcdf2063d00bbca60026c30c0bbae8fdd60b6f2be801fc5381ba62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20026"
      ]
    },
    {
      "uid": "zhcn:91cd05fcac0a9d76df6658de",
      "kind": "character_system_text",
      "source_text": "想象训练，好。\n心理准备也很充分ー。\n呼ー…出发！",
      "source_fingerprint": "0c3bfbc32c96f97168005895616fd1efbf1a5003869905ef6f4f64973e2cbb34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20027"
      ]
    },
    {
      "uid": "zhcn:e63f774f514d1f54751f72d1",
      "kind": "character_system_text",
      "source_text": "到这里为止都感觉良好，\n没问题的吧。\n接下来就是气势了～呣呣～！",
      "source_fingerprint": "d98cd167f3a5a05c9e3f532568419824e04c88d67516f76c8a48f6a2bde272d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20028"
      ]
    },
    {
      "uid": "zhcn:fd36e3e698f838184efb4772",
      "kind": "character_system_text",
      "source_text": "和平常一样的感觉呢。\n好的，我会加油的ー！",
      "source_fingerprint": "604c04bf15f681beca976b272f82839aa14c63704fb3e651a225c6cd06dc6698",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20029"
      ]
    },
    {
      "uid": "zhcn:eb0e9da52252c22ff68f4743",
      "kind": "character_system_text",
      "source_text": "训练的成果…\n我会在，正式比赛中展现的。",
      "source_fingerprint": "4e6f94d9789fc9a0f1792816bb5f0ae143e9507854c0c03f2308388956ea93cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20030"
      ]
    },
    {
      "uid": "zhcn:538c2152191a6c27af809b0d",
      "kind": "character_system_text",
      "source_text": "有点紧张…但是，\n这种程度的话没问题！",
      "source_fingerprint": "d9bf702c6ef2df20bc429c24c022c5674f51d1338daa8fcc5028372e284723b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20031"
      ]
    },
    {
      "uid": "zhcn:effd973538dfa9684536ec18",
      "kind": "character_system_text",
      "source_text": "做好能做到的事\n就行了吧…！即使是\n普通的事，我也一样做好。",
      "source_fingerprint": "4c28efbf7eff7ff4f96a1b2f9f614f3cce0c3cf199bb22e8294d399f9a2f9450",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20032"
      ]
    },
    {
      "uid": "zhcn:01a4a340e92fd0ca2197413f",
      "kind": "character_system_text",
      "source_text": "呜呜，说实话有些时候\n会有点不安，…不不，\n必须要相信自己！",
      "source_fingerprint": "8876f7f5546e684ad96e458f2ac11992f41eaf6df4b9773d98f350fb00000884",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20033"
      ]
    },
    {
      "uid": "zhcn:34777e26818ebaf00357dae6",
      "kind": "character_system_text",
      "source_text": "紧张哟～飞走吧～！\n虽然腿有点抖，\n但还是会注意不摔倒的！",
      "source_fingerprint": "e63025de4fcdb8d828acf479df1cfb0a8863a2301e10d2d8fce0b59fa9108975",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20034"
      ]
    },
    {
      "uid": "zhcn:b08ad577b28dbd37b58374c5",
      "kind": "character_system_text",
      "source_text": "慌慌张张～慌慌张张～。\n呜呜，脚好紧张…\n振作点啊，我～！",
      "source_fingerprint": "aed4730998888324b06706a05f5685f22e1d8d72c1143d89f2c2265cd2591456",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20035"
      ]
    },
    {
      "uid": "zhcn:27699d091da2e64c5c757184",
      "kind": "character_system_text",
      "source_text": "深、深呼吸一下ー…吸ー呼ー，\n吸ー呼ー吸吸…咳咳！\n吸，吸过头了…",
      "source_fingerprint": "98d70daa24f093278070e6eb68e301caa55c49ca43af066cf2f7f9fa55a9341c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "20036"
      ]
    },
    {
      "uid": "zhcn:e2e30a89276c7317188e6bbb",
      "kind": "character_system_text",
      "source_text": "总总，总感觉有点\n紧张…！没关系，\n冷静下来的话就能做到。",
      "source_fingerprint": "1ff9ef341d7345391fb678ef77b82d88d8eec486493ee9e504079dc5d87b3878",
      "source_path": "character_system_text_dict.json",
