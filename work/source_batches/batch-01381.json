      ]
    },
    {
      "uid": "zhcn:548b5f78243b30b1ac33002c",
      "kind": "character_system_text",
      "source_text": "呼呼呼",
      "source_fingerprint": "5aa5ca383c2effa4025754ce9afd8e085b9c071a00228ad86a861c9993e2e374",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140008"
      ]
    },
    {
      "uid": "zhcn:573cf90a282df01057660eab",
      "kind": "character_system_text",
      "source_text": "哼，哼♪",
      "source_fingerprint": "7a815e401c9867c063e44cd8f7f63c92829776dfd8854ed0d3f42a6b2fd095ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140009"
      ]
    },
    {
      "uid": "zhcn:ce108ab2fb2bce3376daa1d7",
      "kind": "character_system_text",
      "source_text": "呵呵…诶～！",
      "source_fingerprint": "2af5ced19edbddf324b7978ac21a1d041d01654a3474039b7f9ec16db5774ddf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140010"
      ]
    },
    {
      "uid": "zhcn:7e905c2059f22ca98ed805e7",
      "kind": "character_system_text",
      "source_text": "真的？",
      "source_fingerprint": "9df9f4afe0797ce197fc463cf573f6445f2fbc79e888518a0bf9d61be9bc36e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140011"
      ]
    },
    {
      "uid": "zhcn:21cd85605be23eafd6a8da2a",
      "kind": "character_system_text",
      "source_text": "哦ー！",
      "source_fingerprint": "dd4785d457169fccd1aecc268d0ba184e660552201a8ea787d704804bea09498",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140012"
      ]
    },
    {
      "uid": "zhcn:f070a3a0f9577f5f8eca0bc0",
      "kind": "character_system_text",
      "source_text": "好强",
      "source_fingerprint": "81fe20dc9eeeda6da1fdac9ed8160e3666b0639ce77ef1983d115bf527f2cb15",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140013"
      ]
    },
    {
      "uid": "zhcn:045aa0da891c710fce5264b2",
      "kind": "character_system_text",
      "source_text": "哎呀ー…",
      "source_fingerprint": "762262617500f4cb377b48b9b3d47e35c63d309df6205ce1456ebba8ef7f94a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140014"
      ]
    },
    {
      "uid": "zhcn:2614ebfa1cfa3691f1176093",
      "kind": "character_system_text",
      "source_text": "哦哦ー…！",
      "source_fingerprint": "65ad0442a9161bcb4477bac83ebfa8b58f21be00573ddaa7cfa099f00869b473",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140015"
      ]
    },
    {
      "uid": "zhcn:b5873f9e99ceb0ab726da60f",
      "kind": "character_system_text",
      "source_text": "嘿！",
      "source_fingerprint": "4f80298f6ad3f06504d125a4a500b2c955c83c5f325b006c292424d190c097f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140016"
      ]
    },
    {
      "uid": "zhcn:2db496c29d59ecd666f7c22a",
      "kind": "character_system_text",
      "source_text": "啊～…",
      "source_fingerprint": "4b404a10ad661cbd1e5c6a66fd2cda12a03e9c93a4a10378d4306d531fcf769c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140017"
      ]
    },
    {
      "uid": "zhcn:42f6221b6749b55427767c1a",
      "kind": "character_system_text",
      "source_text": "这可真糟糕…",
      "source_fingerprint": "f3dfa7c11e5728b823764d21315e95c0a3849ad50446e3f6cea4204ae6d71ee5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140018"
      ]
    },
    {
      "uid": "zhcn:486c96c3af6f0ef3669fcb62",
      "kind": "character_system_text",
      "source_text": "明天好像能拿到这个。",
      "source_fingerprint": "05455df9a61eff2f59cb5dc2bf0840682d0169c42988968da22137fe1da487b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "15"
      ]
    },
    {
      "uid": "zhcn:f0dd06da0657c6f84ef6c50c",
      "kind": "character_system_text",
      "source_text": "呼…可能已经累了。",
      "source_fingerprint": "bdea8981065f871c14c1e17c6df427faf311a43d4ceeee8719e55b2754205942",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20000"
      ]
    },
    {
      "uid": "zhcn:f93cd851e5861a94bb41fe39",
      "kind": "character_system_text",
      "source_text": "哈啊…今天可不要发呆…\n不像样子，要努力啊。",
      "source_fingerprint": "4ff42d47c950fcf6a835659edbd2d3d4bb840aa102246bd9acbf98389cc63837",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20001"
      ]
    },
    {
      "uid": "zhcn:8cddbe140b2ca2d773a7f0d4",
      "kind": "character_system_text",
      "source_text": "哟，要开整吗！\n…啊…抱歉，还是忘了刚才的话吧。\n干劲充足过头了。好羞。",
      "source_fingerprint": "020e8252c3c87cca54f482c53fb2849f56948a2ac15f3e32eeaa60d4670cd501",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20002"
      ]
    },
    {
      "uid": "zhcn:a0243ddedef937ff53577a1b",
      "kind": "character_system_text",
      "source_text": "呵呵，也许可以\n去比较好的地方呢？",
      "source_fingerprint": "dc0f4b8f8d0be9ea7d58510154e6d582e473c2d11ec3fdfd994b349522e82bde",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20003"
      ]
    },
    {
      "uid": "zhcn:3dcb99fdb5edd5a79b87bbb7",
      "kind": "character_system_text",
      "source_text": "脚步好像有点轻快？\n是说状态很好吗。\n…可能是心理作用吧。",
      "source_fingerprint": "20ab6321a90308f7f3d77b9fb4634fb39d781fb572f23db28f9bd97bce1543ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20004"
      ]
    },
    {
      "uid": "zhcn:0edf170517b570d94cf736e9",
      "kind": "character_system_text",
      "source_text": "好的好的。是非常\n精神的内恰哦。\n今天的训练内容是什么呢～？",
      "source_fingerprint": "1b35ca3d1772629d75b7ec15fefc29b8d8f288e8c0e0e7208e81d55ca2fad9e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20005"
      ]
    },
    {
      "uid": "zhcn:4ca2c6d110486ab8a87155c0",
      "kind": "character_system_text",
      "source_text": "那么那么。\n今天也要\n好好的加油啊。",
      "source_fingerprint": "c8d75c59f4f03cf31ae62c9019cb95e69963410b3a310ec525096d2beb2a3223",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20006"
      ]
    },
    {
      "uid": "zhcn:61da24a359ad692941b785ae",
      "kind": "character_system_text",
      "source_text": "好的，什么时候开始？",
      "source_fingerprint": "8a247c9d8aab52eb67223ceec65746c94940163c841998e796ba6f3e96f08d10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20007"
      ]
    },
    {
      "uid": "zhcn:c912ed46bcc0d3185c2c0ba0",
      "kind": "character_system_text",
      "source_text": "嗯ー…\n干劲，是不是掉到哪里去了呢。",
      "source_fingerprint": "6fe60861f5e515a25e4b5e04ea03928f6ff2c795658340be59c7ea4f3a00f570",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20008"
      ]
    },
    {
      "uid": "zhcn:79a3a30481a2c947d39f99b2",
      "kind": "character_system_text",
      "source_text": "哈啊…为什么。\n不知不觉的，已经…没有力气了…",
      "source_fingerprint": "95abd63419d0eea400015eee45ddc40f6e7127e33ac491f03908145d4fea2b94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20009"
      ]
    },
    {
      "uid": "zhcn:763c016c9f3b6f7bccbc1340",
      "kind": "character_system_text",
      "source_text": "啊ー！不行！\n只能想到最坏的结果。\n…必须冷静。",
      "source_fingerprint": "d3159297e58e5e68994d327a674aa818ecfcae73d197c0ca7ec6dead6caa1a1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20010"
      ]
    },
    {
      "uid": "zhcn:ec70e13f5581f5d5c2e78b82",
      "kind": "character_system_text",
      "source_text": "呜，状态好差。\n明明是该坚持的时候ー…",
      "source_fingerprint": "1fda8a8248259aa155429bc486a66ea6a592857e4833a38427c78a03863be66c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20011"
      ]
    },
    {
      "uid": "zhcn:d527232c241258e2d8481e96",
      "kind": "character_system_text",
      "source_text": "诶，又要比赛？…没关系吗。\n希望不会影响到身体状况。",
      "source_fingerprint": "bb5d3bfa76f7e88c5dec3dffe12ecae8b58a989ae022d1a8e68bbe942750a0ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20021"
      ]
    },
    {
      "uid": "zhcn:ecee023953e20da606d56737",
      "kind": "character_system_text",
      "source_text": "比赛果然还是太多了吧？\n为了保持状态良好。\n差不多也休息一下吧。",
      "source_fingerprint": "f400a54413069034caa4878acbdb99c7008d91df90edb59d3ed30685af5b1ad9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20022"
      ]
    },
    {
      "uid": "zhcn:9986f1fcb5b5673ecdf9a9cd",
      "kind": "character_system_text",
      "source_text": "哈啊～、这个时候终于来了呢。\n状态…嘛，还行吧。嗯。\n说不定…之类的呢，啊哈哈。",
      "source_fingerprint": "936b6ca696b74dd20459bfcf4d505e0d0a75c794c810f3b6b503e7e11fa5fd21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20023"
      ]
    },
    {
      "uid": "zhcn:2483019aeac8031484508a6f",
      "kind": "character_system_text",
      "source_text": "努力得也差不多了，\n胜算…我想应该有。\n…不如说，我想有啊！",
      "source_fingerprint": "5ca20d3a37396c54ec28b636210c56ad778c3d9779864ea93f0bd84175688484",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20024"
      ]
    },
    {
      "uid": "zhcn:83d4f9973d414da0eef011de",
      "kind": "character_system_text",
      "source_text": "状态也还不错，只要努力了的话就…啊。开，开玩笑！玩笑玩笑～。",
      "source_fingerprint": "d3928ef9d5130dda6c8303044acf85435c492a24d2d52404c11c7bb36084ac75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20025"
      ]
    },
    {
      "uid": "zhcn:b2c6e0b776b494724c5f511e",
      "kind": "character_system_text",
      "source_text": "嘛，能做的事都做了。\n之后就看跑的怎样了！",
      "source_fingerprint": "fbc016307b2039e5e1f64676621a7c3c0cd941390ae3a58d4f4be3ffa8bb9f86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20026"
      ]
    },
    {
      "uid": "zhcn:28a3724f956b2a00ab96f32b",
      "kind": "character_system_text",
      "source_text": "我觉得冷静地跑，\n跟着人流就行了。\n啊…差不多吧，马马虎虎！",
      "source_fingerprint": "cf6faddb74510098b3a6d93781637e74bffb6db92acd2248f727dc85afcba7ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20027"
      ]
    },
    {
      "uid": "zhcn:d4776a947b3e086bddd3b308",
      "kind": "character_system_text",
      "source_text": "对我来说，做得很好了。对我来说呢！ 这个，真的很重要。",
      "source_fingerprint": "3c2e264ade3d29dea005dd2915295fbb0ac47ea0e0eb984d3771f0ec350859a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20028"
      ]
    },
    {
      "uid": "zhcn:301551c4c38e34afc1e6a50c",
      "kind": "character_system_text",
      "source_text": "好像能和平时一样奔跑呢…\n这是好事还是坏事呢…",
      "source_fingerprint": "27f0fc45a8bded11587d340f914c4906392dd0dd53530787e376e3e206ecacca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20029"
      ]
    },
    {
      "uid": "zhcn:5a3f1575a02b6444d4f46282",
      "kind": "character_system_text",
      "source_text": "因为是和平时一样的状态，\n所以…也和平时一样\n期待着就行了。",
      "source_fingerprint": "36a9e721dfc51fd8f50f46c44dea80bddf51234b7f3b3a28ccf4d398ad73b75f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20030"
      ]
    },
    {
      "uid": "zhcn:435ab5e235905716883c0b5b",
      "kind": "character_system_text",
      "source_text": "状态不好也不坏。\n能好好比赛就好了啊ー。",
      "source_fingerprint": "e36e71e585f53bf6cfe8e7a63dbd4311c78c68b58c70df45acb54fca971d6f34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20031"
      ]
    },
    {
      "uid": "zhcn:77fca24c547cd85ba355e293",
      "kind": "character_system_text",
      "source_text": "已经到正式演出了吗。\n嗯…既然到了这个时候\n就只有平心静气了吧…",
      "source_fingerprint": "c7c7d03e742b6d74feb85e4ba9e0ccf2885e638498989f9958e81b6d822b5509",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20032"
      ]
    },
    {
      "uid": "zhcn:8ff112febb38476e74096964",
      "kind": "character_system_text",
      "source_text": "啊ー…加油跑的话\n奇迹什么的会发生吧～？",
      "source_fingerprint": "e2404905e5b0d0837ce9d019aedca680fb3273bd0c21c3f15fdb11b7a9207a50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20033"
      ]
    },
    {
      "uid": "zhcn:51da1ff6932681eab5fb4999",
      "kind": "character_system_text",
      "source_text": "不管怎么抱怨，\n现状都不会改变的。\n调整好心态，继续跑吧",
      "source_fingerprint": "2a96eb833a0b9903de2d331eb305df38674fa09fb06a01984e04043406981a47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20034"
      ]
    },
    {
      "uid": "zhcn:098bce81a9632ab35a66e2d8",
      "kind": "character_system_text",
      "source_text": "哎呀ー。说实话我很不安…\n但能做的事我一定会做好的。",
      "source_fingerprint": "ff079704cb56cc3c3bad13949db95318f47bad26bb5df8141a12321e458bbe92",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20035"
      ]
    },
    {
      "uid": "zhcn:7df423d9c715c82722f50afa",
      "kind": "character_system_text",
      "source_text": "嗯…都到这里了\n如果还对自己没有信心的话，\n也说不过吧？大概。",
      "source_fingerprint": "238e24e45679ca15e74d61977cb39984682aaf28ca97e4db13bc460d656e6cdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "20036"
      ]
    },
    {
      "uid": "zhcn:a961467bcef0b3107617a56d",
      "kind": "character_system_text",
      "source_text": "努力到这种地步了，\n怎么也要留下点痕迹啊。",
      "source_fingerprint": "5c610e17674dc005bfc349c0f631515d7d6b65b4dac1c9bda6062cfb48fd709d",
      "source_path": "character_system_text_dict.json",
