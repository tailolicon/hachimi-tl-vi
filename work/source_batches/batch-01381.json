      ]
    },
    {
      "uid": "zhcn:610c8013d14f6fbfa0c6e60b",
      "kind": "character_system_text",
      "source_text": "别在意别在意！",
      "source_fingerprint": "881f7b5b03a92e71cc98c5ea0405e9dc82698168e5f42df42d207bb54b599c7c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1060",
        "140005"
      ]
    },
    {
      "uid": "zhcn:706a3158fb3f0341cdb8f611",
      "kind": "character_system_text",
      "source_text": "不得了！奇迹发生了…！",
      "source_fingerprint": "c09cb60f9e666f928eb8be696918a3207d44e2746d1f32e7eed3d5dc4704c6ff",
      "source_path": "character_system_text_dict.json",
