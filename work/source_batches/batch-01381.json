      "source_text": "加油咯。",
      "source_fingerprint": "5ceddc16f7d720db2f78331384b57277e53823adda66daaa5b8e27f1aad39bff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
