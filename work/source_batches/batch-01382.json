      ]
    },
    {
      "uid": "zhcn:1c4b25aea5132a577b4fb580",
      "kind": "character_system_text",
      "source_text": "穿上这件衣服的我，\n能被大家记住就好了。",
      "source_fingerprint": "26b254fa30e1ecbd5cb86444f48b76e455b331998c2a284a1a1b126048504269",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
