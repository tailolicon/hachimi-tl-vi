{
  "schema_version": 1,
  "batch": 1384,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:a66e9cf2c6edadb471021edc",
      "kind": "character_system_text",
      "source_text": "難度は高かったですから…。",
      "source_fingerprint": "b40d7a824b6467c842ee16b916725ac1c7b67b630ed921c24f42f25765a8f78a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140005"
      ]
    },
    {
      "uid": "zhcn:6a59caf59d329194edf90573",
      "kind": "character_system_text",
      "source_text": "お見事です！",
      "source_fingerprint": "71fe93f577cde2476c1cc9ea4e671a3c94f880fd16ce1f766af5b1d01e477741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140006"
      ]
    },
    {
      "uid": "zhcn:748ef727d3507b68d61e340b",
      "kind": "character_system_text",
      "source_text": "こんな才能をお持ちとは…。",
      "source_fingerprint": "094d7a7e07ce8d9467e6fc2ae7177f85456a0606047cd8350f2f625d393953c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140007"
      ]
    },
    {
      "uid": "zhcn:dfb3a58d6e61cee942484d04",
      "kind": "character_system_text",
      "source_text": "ふふっ。",
      "source_fingerprint": "dbc78ca5d65302a8b38bec657661270c58ae9fac943c1c718a7fa71c2d75ec30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140008"
      ]
    },
    {
      "uid": "zhcn:1ad2319f3c528daab6b9d249",
      "kind": "character_system_text",
      "source_text": "んん…。",
      "source_fingerprint": "213a7633b40c57dd79bd554bd3e66aecd2890e1c312bdae01e72fb62f283bb7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140009"
      ]
    },
    {
      "uid": "zhcn:896ab5a90ac6df8425cfa321",
      "kind": "character_system_text",
      "source_text": "む。",
      "source_fingerprint": "b98e289944aa43753187806cbd6977d5097f8b31fb305c58eb62572608825cd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140010"
      ]
    },
    {
      "uid": "zhcn:78018a2a1f79cc487d948208",
      "kind": "character_system_text",
      "source_text": "チャンスです！慎重に…！",
      "source_fingerprint": "62aaa9df32e8912431e4accec378c8ccec46cd519dcc0ad87ba8137a1969f7d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140011"
      ]
    },
    {
      "uid": "zhcn:ef67a57859fe27307febec6d",
      "kind": "character_system_text",
      "source_text": "なんという…！",
      "source_fingerprint": "1bab22c78ffa7632fce6c57000ec257c7e18ca793915a86a7a46eb2a02ed5ef4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140012"
      ]
    },
    {
      "uid": "zhcn:f21f2fc52a2b221e9cf83333",
      "kind": "character_system_text",
      "source_text": "素晴らしい。",
      "source_fingerprint": "8e934a62b37525801eb70bc01539679d41030aa44b40e88ec2cd7094d0750fe4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140013"
      ]
    },
    {
      "uid": "zhcn:5c6820bf086c743a6ce3a659",
      "kind": "character_system_text",
      "source_text": "あっ！",
      "source_fingerprint": "11c7fa2e8ca165bf7b84e9505989c5dd8d95e375903d51850708d69a745ba142",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140014"
      ]
    },
    {
      "uid": "zhcn:e6e07e1aedd182cba30f7150",
      "kind": "character_system_text",
      "source_text": "ふむ…。",
      "source_fingerprint": "7cc85de9baa6672c2c81baee59b07561bae8d6e1b887a3e92e1cd1b692282626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140015"
      ]
    },
    {
      "uid": "zhcn:59bcb18291e3c34233a65f20",
      "kind": "character_system_text",
      "source_text": "さあ、どうぞ。",
      "source_fingerprint": "aa34476a13ef58d62d559b43d08cf126611a3182754c76dd8c1641479df260cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140016"
      ]
    },
    {
      "uid": "zhcn:299b906ec650d4d924cf504d",
      "kind": "character_system_text",
      "source_text": "なっ…！",
      "source_fingerprint": "a6057e38bffc9b8b1ac2789a1b261be32229344ac84a55242c1d49aff2b2ec74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140017"
      ]
    },
    {
      "uid": "zhcn:b9c8b2d8ee1c71422d1b1355",
      "kind": "character_system_text",
      "source_text": "ままなりませんね…。",
      "source_fingerprint": "a5daba97326da9fe22599d043f9bd79b91c6727509c4cc30b587a19d702f963e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "140018"
      ]
    },
    {
      "uid": "zhcn:7189738788fc18d2791e92f5",
      "kind": "character_system_text",
      "source_text": "明日はこちらの予定です。",
      "source_fingerprint": "682cf9ddc5c926451a337996ee05f9ec5328863aeaf2282acc41dab938a5de9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "15"
      ]
    },
    {
      "uid": "zhcn:a4d9b4800b18a64b6bfbd724",
      "kind": "character_system_text",
      "source_text": "っ…若干ですが疲労が蓄積している\r\nようです。今後のリスクを考え、\r\n休養も選択肢のひとつかと…。",
      "source_fingerprint": "4da6420b1ef6a41828d5bceffd7ad47520079fb20fafed7ec43fe9c94b4c30d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20000"
      ]
    },
    {
      "uid": "zhcn:e0e9d38b205206213dc31a18",
      "kind": "character_system_text",
      "source_text": "現状のままですと…行動に支障を\r\nきたす可能性があります。その点は\r\nご認識おきいただけますと…。",
      "source_fingerprint": "8453e5be5a9cbcb51afe54483568214a673a950c93acbdc2cb59ef1da34fd46c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20001"
      ]
    },
    {
      "uid": "zhcn:0bf53f8464168e0565a83a2f",
      "kind": "character_system_text",
      "source_text": "この軽やかさ…！グリスアップを\r\n施した翌日に匹敵しますよ！\r\nあ…つまりは絶好調という事です。",
      "source_fingerprint": "03c6e6fd78ec4061ec836dcbc35eb6aa9a9475897fa1133e52aaa3722155e306",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20002"
      ]
    },
    {
      "uid": "zhcn:0b8193cfc429e2ebb8289446",
      "kind": "character_system_text",
      "source_text": "膝が笑っているようです。いえ、\r\n疲労ではなく走ることへの期待…\r\nつまり“うずうず”しているのです",
      "source_fingerprint": "6f0d52ee9b7ec91ec239b2c719dcbaac49abd39f157c4f22ea4191d85a7c3d7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20003"
      ]
    },
    {
      "uid": "zhcn:75a5fb9e3f5a28d6d2ae2385",
      "kind": "character_system_text",
      "source_text": "コンディションは平均より良好。\r\n想定以上の成果を上げられるかと。\r\n負荷上限を見極めるよい機会です。",
      "source_fingerprint": "bc1d1a9a15e216a69aa74c438333743310e88ae3edf161464fa6235485f3ae54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20004"
      ]
    },
    {
      "uid": "zhcn:6d56b19d9b05b294c3e81bd1",
      "kind": "character_system_text",
      "source_text": "心身共に好調です。伴いまして、\r\nモチベーションも高まっています。\r\n期待していただけますと。",
      "source_fingerprint": "1b6ecd8669251bd4ebdc8597af7870420f89f771151635d8b86c1a72825eefca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20005"
      ]
    },
    {
      "uid": "zhcn:3e9c43e7711ac8812f3c834b",
      "kind": "character_system_text",
      "source_text": "本日も平素と変わりありません。\r\n予定通りのトレーニングで\r\n問題ないかと思います。",
      "source_fingerprint": "37a36161a3a68fbfe610189de523184ee20e20def8140f69885a2e337a6d4284",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20006"
      ]
    },
    {
      "uid": "zhcn:b7d93648917cd5e11b2eb40b",
      "kind": "character_system_text",
      "source_text": "調子の如何にかかわらず、\r\nやるべきことをやりましょう。",
      "source_fingerprint": "8537a660ba3ea925095c57347460563a8dd6bffb1720ac0f4a712ea8d0502b56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20007"
      ]
    },
    {
      "uid": "zhcn:a107aa434ea7f712e42a7ef2",
      "kind": "character_system_text",
      "source_text": "む…例えるならば、変速が\r\nスムーズにいかない感覚です…。\r\n様子を見つついきましょう。",
      "source_fingerprint": "43a2bb733430cfdedb6041c8e266cc1de1d42c3e753481f80ef32ea68b2dacfd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20008"
      ]
    },
    {
      "uid": "zhcn:696283d083068be206496714",
      "kind": "character_system_text",
      "source_text": "いつものように…というわけには\r\nいきそうもない調子です。\r\n…ケガには気をつけなければ。",
      "source_fingerprint": "b560ec890b378e1e880c72eaea7574529e4b090332bbb3e34226f16aaaed4295",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20009"
      ]
    },
    {
      "uid": "zhcn:ea530730ca7e774ac6b404a3",
      "kind": "character_system_text",
      "source_text": "本日の予定は――\r\nえー…しばしお待ちください。\r\nすみません…。",
      "source_fingerprint": "c269c4a729436f0c9151acb8692c2ac18546c3c168a7f347c4513caf0ac27ee3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20010"
      ]
    },
    {
      "uid": "zhcn:ad95a1c6bf9c40c39fa32da7",
      "kind": "character_system_text",
      "source_text": "くっ…不調であっても…。\r\n今日のデータをもとに、\r\n今後に役立てるまで…。",
      "source_fingerprint": "8e0edf498b29f82b4dffc00c5358c996b8da3df4376b2b94d7f11336ac6d3705",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20011"
      ]
    },
    {
      "uid": "zhcn:7308e09a58fbc088d7fc7790",
      "kind": "character_system_text",
      "source_text": "連続出走ですか…。どうしてもと\r\n仰るならば、意図に関しては\r\n明確なものをご提示くださいませ。",
      "source_fingerprint": "1860537c74bb56fc1a425df9445e40ea4a8a0966b2482c4bc21630d116ea4991",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20021"
      ]
    },
    {
      "uid": "zhcn:a9b4e1cdc455679ff1945b41",
      "kind": "character_system_text",
      "source_text": "更なる連戦ですか…承知しました。\r\n絶対の勝機を見出されたのでしたら\r\n…この身を削ってでもお応えします",
      "source_fingerprint": "611969c8d4816dfe6c90a0a41740dbdff2360b620d45b4934fb84d95bfbcfdca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20022"
      ]
    },
    {
      "uid": "zhcn:793efdef4e780fd443d44d70",
      "kind": "character_system_text",
      "source_text": "調整は万全。気力も充分…。\r\n万事順調に事が運びました。\r\nあとは、勝利を収めるのみです。",
      "source_fingerprint": "83f2914e8c137856cbebadbc7a8defaffff798041ee6f8d5f4378c08261aa831",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20023"
      ]
    },
    {
      "uid": "zhcn:22af299aa9cc5455ef709e94",
      "kind": "character_system_text",
      "source_text": "ここまでの調整は想定通りです。\r\nレースに際しても、\r\nそれが覆ることはないでしょう。",
      "source_fingerprint": "b96f3c67c593290a8195ee13d718465c9a37746c34f612628f89b4be52fce7da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20024"
      ]
    },
    {
      "uid": "zhcn:ebdd302ef774d5f2c153346e",
      "kind": "character_system_text",
      "source_text": "万全を期して、ここに至りました。\r\nあとは実践に挑むのみです。さあ、\r\n私たちの成果を披露しましょう！",
      "source_fingerprint": "a19c1c550ef820053ab2ad83c5f787fa1a853fa8fd3bcb6c41cba73ba4d1ee4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20025"
      ]
    },
    {
      "uid": "zhcn:fe07df7a81359145b8915197",
      "kind": "character_system_text",
      "source_text": "状況は、概ね想定した通りです。\r\nイレギュラーが生じなければ、\r\n勝利への道筋は明るいでしょう。",
      "source_fingerprint": "9015978e4e5402624ac6738afef30eab07c21870ddcdeefaabe2cdebbc28a02f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d35b44a79cbaa9c6a233acfe",
      "kind": "character_system_text",
      "source_text": "私は勝つ…！そう思えるのです。\r\n精神的な強さは勝敗を左右します。\r\nであれば、明言するのが得策かと。",
      "source_fingerprint": "71dbcbf12723fa180580c0e7ec613bed524c9553ae9cbb9551ded8a07344ddbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20027"
      ]
    },
    {
      "uid": "zhcn:e0eec8bf01ccb02e1db14e75",
      "kind": "character_system_text",
      "source_text": "日々、努めてきたからこそ、\r\n今言える言葉があります。\r\n必ずやご期待に添ってみせます…！",
      "source_fingerprint": "11df45b1b5e05a9a38e40e27463a39d990f1ad0c156fd8ec0ce78caf6d83c9e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20028"
      ]
    },
    {
      "uid": "zhcn:202f5598e5faa82fe19efb8b",
      "kind": "character_system_text",
      "source_text": "調整に問題はなく。ですが、不測の\r\n事態も考えられます。油断せず、\r\n気を引き締めてまいりましょう。",
      "source_fingerprint": "9f04247dda70d40e7c9e1b3248e7fcac3c7b935671ae4cf0b463233218163677",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20029"
      ]
    },
    {
      "uid": "zhcn:10b746543019dc22069b1bfd",
      "kind": "character_system_text",
      "source_text": "なすべきことは変わりません。\r\n好不調がない時こそ、\r\n勝利を見据え走るのみ。",
      "source_fingerprint": "48a3cf3bffd6ed99583a1855b0375440abfa99234cd516f4e889bef54613cef3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20030"
      ]
    },
    {
      "uid": "zhcn:4763a7dc08c4bec85607c837",
      "kind": "character_system_text",
      "source_text": "私自身に変わりはありません。\r\n事の運びは外的要因によりけり…\r\nといったところでしょうか。",
      "source_fingerprint": "1f643eda3cd72415466f255a0ac10d5b71845c0286f90f5a30dd7771b90a375a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20031"
      ]
    },
    {
      "uid": "zhcn:13d4f56963adf2d546893157",
      "kind": "character_system_text",
      "source_text": "万全でないとはいえ…対処の\r\nしようはいくらでもあります。\r\n体の不調は…頭脳で補います。",
      "source_fingerprint": "4bd666795e1e6b09835fd023ef3835fa660f9b2105ad569542faad1f56e84b1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20032"
      ]
    },
    {
      "uid": "zhcn:d1b644ae0fb07d45ef77189a",
      "kind": "character_system_text",
      "source_text": "調整不足と言わざるを得ませんが…\r\n不測の事態であれ、積み重ねてきた\r\nものは揺るぎません…！",
      "source_fingerprint": "6edbb590fac562b9be086641344a403a1a7c99e575042cfc1d4b165628f19cac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20033"
      ]
    },
    {
      "uid": "zhcn:09b12129b637174586a80d7a",
      "kind": "character_system_text",
      "source_text": "私ならば勝てる…！\r\n…不調をカバーする\r\n自己暗示のようなものです。",
      "source_fingerprint": "41ab4776d67a89b0838b148b2d54508eeff1cb08b376db96f33d1f6e13c8fa10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20034"
      ]
    },
    {
      "uid": "zhcn:7485b525062d3cc8e4b96b5b",
      "kind": "character_system_text",
      "source_text": "どんなに綿密な計画を立てても、\r\n上手くいかない事もあります…。\r\n問題は、どう立て直すかです。",
      "source_fingerprint": "78711c51e03e3bdc01f7420a334cb4bbe159131760d6ccad10c31818de743c90",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20035"
      ]
    },
    {
      "uid": "zhcn:98094649977a1dbe3bccbd35",
      "kind": "character_system_text",
      "source_text": "…芳しい状態ではありませんが、\r\n諦めては、元も子もない。\r\nここまでの積み重ねを信じます。",
      "source_fingerprint": "0ed0386ceb990cb7aa0cc36cac9d09644b0679b6ce2ade9949ae2a27ff8d4e48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20036"
      ]
    },
    {
      "uid": "zhcn:75c0ff34defced247e7fd643",
      "kind": "character_system_text",
      "source_text": "んん…集中できない…\r\nレース前だというのに…\r\nゴールだけ見据えるイメージを…！",
      "source_fingerprint": "ce1a22f31fb0e5136b055ec4f2d4a08854658bb13525405a887ac62ec3236f70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20037"
      ]
    },
    {
      "uid": "zhcn:bbf9ff19bfc834b3b9b9faa4",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20038"
      ]
    },
    {
      "uid": "zhcn:0abbaab8dedcf84244628948",
      "kind": "character_system_text",
      "source_text": "承知です。",
      "source_fingerprint": "454ffbb46c2a2bf1f525b88f5dcac18ebe59f7b0b431281d2cee0d6075f1ed5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20039"
      ]
    },
    {
      "uid": "zhcn:5fbe338a3c90454f1f00a32f",
      "kind": "character_system_text",
      "source_text": "なるほど。",
      "source_fingerprint": "e6060d825a6076f13a47cc304d64491b431764116f93db22e8a3eb419858f2a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20040"
      ]
    },
    {
      "uid": "zhcn:a98c0021b3a3f7c487f08e6e",
      "kind": "character_system_text",
      "source_text": "お任せを。",
      "source_fingerprint": "cd56fc89933c98f2d405367498050ad3882b076dea9dea406b582ac41fe93472",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20041"
      ]
    },
    {
      "uid": "zhcn:86426e61a7068f841ca85333",
      "kind": "character_system_text",
      "source_text": "ああ…！？",
      "source_fingerprint": "83997e676457c2ca6ac6e81715f7ed1d1742a08535dbc42afb02428dc208218d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20042"
      ]
    },
    {
      "uid": "zhcn:288ba6be119f6b6c1cc5f85c",
      "kind": "character_system_text",
      "source_text": "ううん…？",
      "source_fingerprint": "e4610d2a837390411f3238a308fa9072f79329f8363540d99251a9a6a91d3f51",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20043"
      ]
    },
    {
      "uid": "zhcn:21dafd3857a50238e9fb2dc4",
      "kind": "character_system_text",
      "source_text": "外出ですね。",
      "source_fingerprint": "7201a945e63e53717d278e6d3a574b3c742b1fddf8155b902f026e2e6e99280d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20046"
      ]
    },
    {
      "uid": "zhcn:5cab98457b2c9d23ac44ca36",
      "kind": "character_system_text",
      "source_text": "いい風ですね。",
      "source_fingerprint": "d36843ebf2b2c1975f52edcd08e5914805448ce92f4fcab4848d2d51595e74a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20047"
      ]
    },
    {
      "uid": "zhcn:8b5aec146741fcef0a9cf05e",
      "kind": "character_system_text",
      "source_text": "想定通りの結果をおさめることができました。",
      "source_fingerprint": "85e668009703f039307ad9fad55234db4fa864d58f6391f0540c777d2bb004de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20049"
      ]
    },
    {
      "uid": "zhcn:22ffe37fa1b0cb78ae63d224",
      "kind": "character_system_text",
      "source_text": "ここまで導いていただき感謝しております。",
      "source_fingerprint": "c8fd07a7000f90a5156df6bcf493c84524d50e6673fb6782a63d85255f3c556b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20050"
      ]
    },
    {
      "uid": "zhcn:24bb5f480cd1bf8d46046cc2",
      "kind": "character_system_text",
      "source_text": "我会完美地配合。",
      "source_fingerprint": "cb191ad486406858483d5912ad34017a72ff61928209c898888a176070f048a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20051"
      ]
    },
    {
      "uid": "zhcn:f71414d610c6ece4c8e39304",
      "kind": "character_system_text",
      "source_text": "時間です。",
      "source_fingerprint": "3c2c1bcc72a4ae9f88060fcccb1a351bee84241e14492d09ca0748435672cdc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2030"
      ]
    },
    {
      "uid": "zhcn:896b9158efcafe0ec5afee22",
      "kind": "character_system_text",
      "source_text": "各自、打ち合わせ通りに。",
      "source_fingerprint": "2367b7edfae471eaa9bbd3fe84dd82e102af9a9bbf9780d3f1fe7e583120f017",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2031"
      ]
    },
    {
      "uid": "zhcn:3f6b4c684a6c52eb63a19e3c",
      "kind": "character_system_text",
      "source_text": "ここまで導いていただき感謝しております。",
      "source_fingerprint": "c8fd07a7000f90a5156df6bcf493c84524d50e6673fb6782a63d85255f3c556b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2032"
      ]
    },
    {
      "uid": "zhcn:c96293c0e87e1daeaf90dcb4",
      "kind": "character_system_text",
      "source_text": "日々、努めてきたからこそ、\r\n今言える言葉があります。\r\n必ずやご期待に添ってみせます…！",
      "source_fingerprint": "11df45b1b5e05a9a38e40e27463a39d990f1ad0c156fd8ec0ce78caf6d83c9e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2033"
      ]
    },
    {
      "uid": "zhcn:8b934b38babf7d53970c0ebf",
      "kind": "character_system_text",
      "source_text": "万全を期して、ここに至りました。\r\nあとは実践に挑むのみです。さあ、\r\n私たちの成果を披露しましょう！",
      "source_fingerprint": "a19c1c550ef820053ab2ad83c5f787fa1a853fa8fd3bcb6c41cba73ba4d1ee4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2034"
      ]
    },
    {
      "uid": "zhcn:5c56c407f934c42c21820dce",
      "kind": "character_system_text",
      "source_text": "ここまで導いていただき感謝しております。",
      "source_fingerprint": "c8fd07a7000f90a5156df6bcf493c84524d50e6673fb6782a63d85255f3c556b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2035"
      ]
    },
    {
      "uid": "zhcn:a25c8caf68b56f411133a235",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b9876a5026bf7840667785b9",
      "kind": "character_system_text",
      "source_text": "あと1歩を超える方法を見出さねば…！",
      "source_fingerprint": "9ecc71a8c3dd773f19cdddd170a5cc8906167f9c396db09f0ace120b7a7f40b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30000"
      ]
    },
    {
      "uid": "zhcn:05fa587dcc6ad128e2f4d8cd",
      "kind": "character_system_text",
      "source_text": "敗因を分析し、次こそ勝ちましょう。",
      "source_fingerprint": "1cea3fe74f976a5ee26ce3ae3ecc648e0c9949eed030fc40aa4f4b4559e828c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30001"
      ]
    },
    {
      "uid": "zhcn:37a0c20fb8a47899e8d8acd2",
      "kind": "character_system_text",
      "source_text": "想定内の結果ではあります、が…。",
      "source_fingerprint": "fbd79c3de52125da1ea115a5ac11282d7de8c2298e142503902d7260ef749ad6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30002"
      ]
    },
    {
      "uid": "zhcn:086475ac4bd4b3640f6dd74e",
      "kind": "character_system_text",
      "source_text": "計画の見直しが必要ですね…。",
      "source_fingerprint": "dba97c2c6a0d692f08702fb33b9e1f94d9488ecb2842e5aa213de5750bf76374",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30003"
      ]
    },
    {
      "uid": "zhcn:ffeed32cbdbb44256215209f",
      "kind": "character_system_text",
      "source_text": "首尾は上々…全て、狙い通りです。",
      "source_fingerprint": "92fa2fb10a229fb1519b68ef1f83f006b7b00b25c4330094d9807105b31990c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30004"
      ]
    },
    {
      "uid": "zhcn:ad290de33e04d44f16de00fa",
      "kind": "character_system_text",
      "source_text": "ふむ、想定通りかと。",
      "source_fingerprint": "791414b3240268619ffd571607f9af4da4b64bdab00f22a884a7c8fd6808888a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30005"
      ]
    },
    {
      "uid": "zhcn:303c64cdb656e0f1c9a7e762",
      "kind": "character_system_text",
      "source_text": "では、参りましょう。",
      "source_fingerprint": "6d3ba4722e079c2e7404f6e4b444c3e186c3cff49cbce910edc4013df00690fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "31000"
      ]
    },
    {
      "uid": "zhcn:51258e25debbf69347ed95c7",
      "kind": "character_system_text",
      "source_text": "熱く鍛えたのは…この時のためっ！",
      "source_fingerprint": "cd9698f323c4d73b2dfe0c70a1f90669736eac4d99c9ae86672a165fecac82db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "40000"
      ]
    },
    {
      "uid": "zhcn:fe74a51e812d8d77961b4ce1",
      "kind": "character_system_text",
      "source_text": "我想支持大家的干劲……\r\n管理的事项\r\n请全权交给我处理。",
      "source_fingerprint": "68317dec86e5e6d80d8d4143d6edcabdc70b95f1f4e960f52a46c9a477a0198a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400002"
      ]
    },
    {
      "uid": "zhcn:9e6b4b5eb0e933c1f5f270bf",
      "kind": "character_system_text",
      "source_text": "绝不可心急。\r\n维持我们的作风稳扎稳打地……\r\n确实地一一克服吧。",
      "source_fingerprint": "931bf80e2252bcc68ecf209f95d8af59d0297e21a4e015af73f5238b3ecd4c8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400004"
      ]
    },
    {
      "uid": "zhcn:daede4e1a67f59139898efb5",
      "kind": "character_system_text",
      "source_text": "一起全力以赴到最后一刻吧！\r\n希望大家都能获得理想的结果……",
      "source_fingerprint": "63894b75dc4bfbb7b5c317df3d02a57d25f85d5c206c07737ba8462b1dd6fe95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400007"
      ]
    },
    {
      "uid": "zhcn:1d994f01db01bfb89df556bd",
      "kind": "character_system_text",
      "source_text": "熱く鍛えたのは…この時のためっ！",
      "source_fingerprint": "cd9698f323c4d73b2dfe0c70a1f90669736eac4d99c9ae86672a165fecac82db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "40001"
      ]
    },
    {
      "uid": "zhcn:a62bca7145bcc67a123c59b3",
      "kind": "character_system_text",
      "source_text": "真是美好的景色……\r\n想必那个舞台，也会在今后\r\n成为支持着我奔跑的动力吧。",
      "source_fingerprint": "221e7c68705a7b8d036357849528f4de91cf1226e88141db88325c6bbbad6cf5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400011"
      ]
    },
    {
      "uid": "zhcn:6b95d645fee3a8b9577490da",
      "kind": "character_system_text",
      "source_text": "这边是活动任务。\r\n采取稳健的行程来进行吧。",
      "source_fingerprint": "492910b97a68add2a92ef0c7d380a3d887a161042ae211903bb4a017805e16b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400012"
      ]
    },
    {
      "uid": "zhcn:46db86995aa78782d21f84bc",
      "kind": "character_system_text",
      "source_text": "有没有忘记领取的东西？\r\n可以的话，让我与你\r\n一起确认吧。",
      "source_fingerprint": "197a210b2a98763d6a59cbd6b8170927df1b18ba19740b5deb0a19babaaeed82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400013"
      ]
    },
    {
      "uid": "zhcn:2383cf5ca68ba6ccbd399ff0",
      "kind": "character_system_text",
      "source_text": "ここで決めましょう…！",
      "source_fingerprint": "5c44ed023ab80c6982819380de726ed68b494a79f6ebe0d36143407fe6115504",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "40002"
      ]
    },
    {
      "uid": "zhcn:43e65967312a8c2c7b874ea8",
      "kind": "character_system_text",
      "source_text": "動きはすべて予習済みです。\r\n完璧にこなせるかと。",
      "source_fingerprint": "2db6687ef71b7782c7cf23e5af43106bb2647d089a5817cf001ead0e3db1ccdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "60000"
      ]
    },
    {
      "uid": "zhcn:b745e3fb412019ffc7ca8613",
      "kind": "character_system_text",
      "source_text": "恩返しできるよう、\r\n楽しませますよ！",
      "source_fingerprint": "f34aa6ef7b63356c029418eea55d16eaa6ff8842cb5c0292655026adae4d8e08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "60001"
      ]
    }
  ]
}
