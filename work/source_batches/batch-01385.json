      ]
    },
    {
      "uid": "zhcn:a1f54b499fbe97bb637ffa0d",
      "kind": "character_system_text",
      "source_text": "摩擦耐性があれば、このまま\r\n自転車にも乗りたいのですが。",
      "source_fingerprint": "cf270a273d40843649899a372a17e464c1cd4d0a9ef0a551d27c89e7206a7949",
