    {
      "uid": "zhcn:25099ea539fb19244bac5639",
      "kind": "character_system_text",
      "source_text": "真是可惜呢～",
      "source_fingerprint": "3520415b5d555e3854c82aedd9b2d95fb32dff1d72bffc0a7c58c7f78766c4e3",
      "source_path": "character_system_text_dict.json",
