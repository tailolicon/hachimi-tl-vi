      ]
    },
    {
      "uid": "zhcn:f5be7160ce073be8206d65a4",
      "kind": "character_system_text",
      "source_text": "真是才华洋溢的设计对吧？\r\n尽管看到出神都没关系喔！",
      "source_fingerprint": "32c7075ea9794eb922923cc2fade4c1e31ce581271b91298ddb989ffa9f3b312",
      "source_path": "character_system_text_dict.json",
