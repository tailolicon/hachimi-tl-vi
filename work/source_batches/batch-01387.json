    {
      "uid": "zhcn:2338469b20cc6c085c4b17b9",
      "kind": "character_system_text",
      "source_text": "成就学业！",
      "source_fingerprint": "1251dddd40417c459f1433bb3f2d0ee302b784291f2484c9eba3f41cdf99c786",
      "source_path": "character_system_text_dict.json",
