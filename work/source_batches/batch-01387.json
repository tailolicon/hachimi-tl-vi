      ]
    },
    {
      "uid": "zhcn:d30d2699edfdde784407f8b6",
      "kind": "character_system_text",
      "source_text": "奇、奇怪～？",
      "source_fingerprint": "9227b036f7921549bf0d3061222aeef450e67fa1ba854567295bdfafa2f33230",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20042"
      ]
    },
    {
      "uid": "zhcn:6583cb75c6b19652b12be105",
      "kind": "character_system_text",
      "source_text": "我已经不行了……",
      "source_fingerprint": "64e8d1211cca4f9e2ac98315f54695e5223180f97fe02cf6cfb9644268c02753",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20043"
      ]
    },
    {
      "uid": "zhcn:726ccc021d94eddfd9016434",
      "kind": "character_system_text",
      "source_text": "要出发了！",
      "source_fingerprint": "7d4df1c378c6691186569a6c765800e1e53a23e172fab507412af50571f5b0f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20046"
      ]
    },
    {
      "uid": "zhcn:5627b2f5430f359b257a2284",
      "kind": "character_system_text",
      "source_text": "很不错嘛～！",
      "source_fingerprint": "6f8afac0d333129f688e28348f411d057c4801b9d47c4a77055035542d27eb70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20047"
      ]
    },
    {
      "uid": "zhcn:ae43bd49efbabffc403f97fe",
      "kind": "character_system_text",
      "source_text": "幸好我有相信你而努力！",
      "source_fingerprint": "9e2b3e309704faf40b1d46b1ce16bf9b8ebb9ea691b03ae326aa8787b9446b2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20049"
      ]
    },
    {
      "uid": "zhcn:6fc1dcb69fa2c3ccecc331b8",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20050"
      ]
    },
    {
      "uid": "zhcn:7e891440b9c74de202ca12fc",
      "kind": "character_system_text",
      "source_text": "来吧，跟我一起进入神的领域！",
      "source_fingerprint": "08a2b1fd1fccccd0b929c70360a71f41ea21eb4705101801a50c2e5e13315f12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "20051"
      ]
    },
    {
      "uid": "zhcn:342e8d7f1d5f6b3bc68fd5ef",
      "kind": "character_system_text",
      "source_text": "南无，菠菜！",
      "source_fingerprint": "43156ca9db7a3b350bf96c8414d752f6fcad155cc247b529ebde9008179bc2ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "2030"
      ]
    },
    {
      "uid": "zhcn:00be2569b8f767654121e603",
      "kind": "character_system_text",
      "source_text": "胜利女神是站在我这边的！",
      "source_fingerprint": "b423bf86c308486f8dffaef0cae4b85ff502e3cfe4210b2f185d7cd12773bc67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "2031"
      ]
    },
    {
      "uid": "zhcn:8181c68d5c2565be78bf3eab",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "2032"
      ]
    },
    {
      "uid": "zhcn:5a476c69aad009ce773e40e6",
      "kind": "character_system_text",
      "source_text": "我老家那边的神社\r\n寄来了必胜祈愿的护身符！\r\n有这个我一定能赢的！",
      "source_fingerprint": "ba4878671d09889d266b6b7226f3283e83f90d5df59b80b83e5b6812a63757ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b6f647423dc6a8ad1da6707f",
      "kind": "character_system_text",
      "source_text": "好、好惊人……！不管是哪种占卜，\r\n结果都全是好的……！\r\n我完全没有会输的可能！！",
      "source_fingerprint": "856a5ea7f76badd627198e0717e4047aabf5516b9fefc7fc643962cf98696afe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "2034"
      ]
    },
    {
      "uid": "zhcn:2a2777a58b87de149229ceb5",
      "kind": "character_system_text",
      "source_text": "谢谢你，训练员！",
      "source_fingerprint": "c78181d7abd84c3a061c42a49bc280cd76506f4c065b8afa69a10e097496add5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "2035"
      ]
    },
    {
      "uid": "zhcn:1b6fb62d130820ef3791b418",
      "kind": "character_system_text",
      "source_text": "始めましょう！",
      "source_fingerprint": "690c07cec6eb89141bc1d30c56b9875ef465bdb404721c965c822cd54bf6e7cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "23015"
      ]
    },
    {
      "uid": "zhcn:c73d39a1cb71a903a89c1382",
      "kind": "character_system_text",
      "source_text": "好可惜！下次一定要第一名大吉……！",
      "source_fingerprint": "7894718a45599af3bd14bcc997977840b00d03e2aac81c1721b97d35510e2ee3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30000"
      ]
    },
    {
      "uid": "zhcn:6eb71f801b3fbbdc5961a601",
      "kind": "character_system_text",
      "source_text": "好像运气有点不太够……！",
      "source_fingerprint": "97943d61f2e41801d020c68c5ebc2af85024f04edbc41cc8eecc90a1645b7015",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30001"
      ]
    },
    {
      "uid": "zhcn:56bce5028a83e7928108d683",
      "kind": "character_system_text",
      "source_text": "是末吉啊……！下次我会努力的……！",
      "source_fingerprint": "183a25182fbaddd427be5f4ca464e0347d215ae9af692e9ac4fc12b97ce2827a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30002"
      ]
    },
    {
      "uid": "zhcn:3f99dcc301a0bec2250611ea",
      "kind": "character_system_text",
      "source_text": "得提升运气才行……",
      "source_fingerprint": "62b614f6b585347131ec1ce269bb13c47efe9c2a57081c1d9b904f24442e3d52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30003"
      ]
    },
    {
      "uid": "zhcn:865870ea75ad96c3c7233d7e",
      "kind": "character_system_text",
      "source_text": "Happy Come Come！福气……降临！！",
      "source_fingerprint": "3a858bbbc624bb66cc138cf14275e64fe4035df3433b7b0afbec97502cc598cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30004"
      ]
    },
    {
      "uid": "zhcn:7ba37221cd11c0c4a53d8be0",
      "kind": "character_system_text",
      "source_text": "感谢大吉的效果──♪",
      "source_fingerprint": "4d85b49d40b124fb921d641ee3b33894cdbf8f6f9ee24653ac55cc5e64d6adaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30005"
      ]
    },
    {
      "uid": "zhcn:c129d68be60d7f731b3f783d",
      "kind": "character_system_text",
      "source_text": "你看到了吗！？\r\n成功招来了大吉哦～！",
      "source_fingerprint": "e795ea746b8cd1bb04ec52bc5aca90a936fbc371eee0ecf18d3de6b396fba1f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30006"
      ]
    },
    {
      "uid": "zhcn:bcfb312668e6c4509ee7e81c",
      "kind": "character_system_text",
      "source_text": "感谢大吉的效果──♪",
      "source_fingerprint": "4d85b49d40b124fb921d641ee3b33894cdbf8f6f9ee24653ac55cc5e64d6adaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "30007"
      ]
    },
    {
      "uid": "zhcn:349329993b8375fcbb13f6c0",
      "kind": "character_system_text",
      "source_text": "Shiraoki大人，请赐给我力量……！",
      "source_fingerprint": "1204a9688e913083d0855cb9a082f7e84203d459fcf4d1d343f39f6333ae17d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "31000"
      ]
    },
    {
      "uid": "zhcn:03822e525036d645a208696f",
      "kind": "character_system_text",
      "source_text": "大吉大吉……大・大・吉！！",
      "source_fingerprint": "7b8bcad46481803cb43769cec0c3faacf92b7058eeef67273d01fa9ce4439417",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "40000"
      ]
    },
    {
      "uid": "zhcn:b09a334c85c458f98e38099e",
      "kind": "character_system_text",
      "source_text": "喔呵呵呵呵！参加歌牌大会\r\n竟然就能开运，\r\n这是新年的特大好运喔～！",
      "source_fingerprint": "50205b42b4d03e0e32b8cbfd21e3918480298aeef59649647f6c8b485a1a1eb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400000"
      ]
    },
    {
      "uid": "zhcn:4446d9aa6b41e9aa57db2280",
      "kind": "character_system_text",
      "source_text": "はいはいっ！小さい頃からお囃子や\r\n大太鼓に触れておりますので！\r\n打楽器には自信あります！",
      "source_fingerprint": "7aa47031331ac9666d0d6228fdd56e25c08751b0dcc8d9782d7cb447640b530b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400004"
      ]
    },
    {
      "uid": "zhcn:bec471f0dc001daaa3fc8a79",
      "kind": "character_system_text",
      "source_text": "不需要想这么多～\r\n开心去做就行了！\r\n好好享受才是最重要的。",
      "source_fingerprint": "1e0c1f1127d93afd9e2f55d85454cc88622838fd5178b8d0aabacf5f5d47d584",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400005"
      ]
    },
    {
      "uid": "zhcn:c654b421e6a2a44298a699c4",
      "kind": "character_system_text",
      "source_text": "実家でお参りも済ませましたし、\r\nあとは本番に臨むだけっ！みんな\r\nハッピーに秋を迎えましょー！",
      "source_fingerprint": "854206e2789e6bd251cac448d7e2536f5d503bebbee29d18f037fa9a429b115a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400007"
      ]
    },
    {
      "uid": "zhcn:2a5324303ec7827d83ff19fa",
      "kind": "character_system_text",
      "source_text": "大吉大吉……大・大・吉！！",
      "source_fingerprint": "7b8bcad46481803cb43769cec0c3faacf92b7058eeef67273d01fa9ce4439417",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "40001"
      ]
    },
    {
      "uid": "zhcn:be74acd9c2857d0cf59f9b0e",
      "kind": "character_system_text",
      "source_text": "竟然！得到优胜！\r\n才刚新年就超过大大吉，\r\n是超级特特大吉呢！",
      "source_fingerprint": "7799d5e4909dc5a8c7ab73312c47bc6e669c49929a5e5ef595770e149f8a9c9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400010"
      ]
    },
    {
      "uid": "zhcn:9656c56c7e5e5cc9ffae7bf6",
      "kind": "character_system_text",
      "source_text": "こちらイベントミッションです！\r\nなんとまあご褒美つきだそうで…\r\nやればやるほど大吉ですねぇ…♪",
      "source_fingerprint": "f5bdb389aba92b2508903fa96cc74c913b7fcf3e918fd4efa127235f829b0d56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400012"
      ]
    },
    {
      "uid": "zhcn:fa852a0fc3c3b0a413d3c447",
      "kind": "character_system_text",
      "source_text": "おつとめ、お疲れ様です！\r\nまだまだこの先も！未来も！\r\n一緒に笑って過ごしましょうね。",
      "source_fingerprint": "e6b11bc4ba9c906d072c4a7e8157c8c7c9b62bb175fbff6fc7173282fc05e719",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "400013"
      ]
    },
    {
      "uid": "zhcn:b9d92c4b842f62405ffecc94",
      "kind": "character_system_text",
      "source_text": "现在～就是一决胜负的时机！？",
      "source_fingerprint": "75a881818a925e88582403e23e21633398ce696ccf883d9fc8139a29633b2648",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "40002"
      ]
    },
    {
      "uid": "zhcn:2a9a7315cea2e1771b1100ae",
      "kind": "character_system_text",
      "source_text": "我的护身符军团！拜托你们了！",
      "source_fingerprint": "aa025425a434af6f7e146fc5c53b09ce29fe90ff0268d6390a575800a620d95c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "40003"
      ]
    },
    {
      "uid": "zhcn:2a64cee8eb8305993e812122",
      "kind": "character_system_text",
      "source_text": "充满福气的精英们～请给我力量……\r\n啊哇哇哇！？\r\n我、我的护身符军团！拜托你们了！",
      "source_fingerprint": "e0519d8186c152fe5e0dbaa322564ce279cf254200d389136e65cd58e00d79fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "40004"
      ]
    },
    {
      "uid": "zhcn:3aea4a17b52c9d77a6d17e80",
      "kind": "character_system_text",
      "source_text": "よ～し！",
      "source_fingerprint": "a545e34018bb476c1937d0e70712c253f155b600f2b41e78e754e284e3615b71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1056",
        "410000"
      ]
    },
    {
      "uid": "zhcn:a7dcb725a7dbcee4e5eec5dd",
      "kind": "character_system_text",
      "source_text": "やりました！",
      "source_fingerprint": "f68943765281867e884b65fbd4503ab4cb5caace8b9cf8048fc83331dc9e2403",
      "source_path": "character_system_text_dict.json",
