  "entries": [
    {
      "uid": "zhcn:19679b9d10709731c1975794",
      "kind": "character_system_text",
      "source_text": "哎呀呀……",
      "source_fingerprint": "ff2fc41fc2a37ee08441f40c67d9ba7a9c82aa96fa79524ef44330e764709db9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20042"
      ]
    },
    {
      "uid": "zhcn:a8dc907e808c5e06317dc663",
      "kind": "character_system_text",
      "source_text": "我认输了～",
      "source_fingerprint": "0cd5cba4e8ca616b4a6588b0d10a70495d97ae5837d785c5cfc648b4eddb2a7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20043"
      ]
    },
    {
      "uid": "zhcn:7cd414116abc6cd7383a233e",
      "kind": "character_system_text",
      "source_text": "走吧走吧♪",
      "source_fingerprint": "0c1f818f7ec0344e41504fbb0fea0e37b480c0946360da4f4773ffb6ac404c4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20046"
      ]
    },
    {
      "uid": "zhcn:86f3bc835dc86548e56ee417",
      "kind": "character_system_text",
      "source_text": "好棒的海！",
      "source_fingerprint": "8a8676add9c421c5dac028e81309b7d8847e3add5ace160834af31b69a203858",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20047"
      ]
    },
    {
      "uid": "zhcn:7603d7c7ada4dd306a9e9468",
      "kind": "character_system_text",
      "source_text": "谢啦～真是美好的青春啊♪",
      "source_fingerprint": "7b383bab2676b61fcaca289f6937b71d984237bdc84c62b7e6beefb78b810fc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20049"
      ]
    },
    {
      "uid": "zhcn:15626efaef877681d500f944",
      "kind": "character_system_text",
      "source_text": "辛苦了，训练员。",
      "source_fingerprint": "0e341b37152f4d4f3ba56e10fd6a64c90c6b82a1b5259828ca89442a02e66bd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20050"
      ]
    },
    {
      "uid": "zhcn:1991a3aca00ec576859ca20a",
      "kind": "character_system_text",
      "source_text": "OK，走吧！",
      "source_fingerprint": "0904a40bcb6ae4b9ce6b8add43f1b510d1a02a5d2d6bec2749323ec5fc42c192",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "20051"
      ]
    },
    {
      "uid": "zhcn:f6139e7a8b336c48fb192aaa",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "2030"
      ]
    },
    {
      "uid": "zhcn:d62553cd5b7ca118ad290d0f",
      "kind": "character_system_text",
      "source_text": "大家，嗨起来喔～！",
      "source_fingerprint": "5071036c5a40ae18b6057b41cea7ef4b5c6e1cea46809fc08cfd6a33eb4a9b52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "2031"
      ]
    },
    {
      "uid": "zhcn:1b7019b520a1d7600d17af82",
      "kind": "character_system_text",
      "source_text": "辛苦了，训练员。",
      "source_fingerprint": "0e341b37152f4d4f3ba56e10fd6a64c90c6b82a1b5259828ca89442a02e66bd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "2032"
      ]
    },
    {
      "uid": "zhcn:aa2f0eb3ebdac6c8c73925d4",
      "kind": "character_system_text",
      "source_text": "等下优胜后受访，\r\n拍照时该摆什么姿势呢～？\r\n……呃，我想太远了吗！？",
      "source_fingerprint": "f52e09b7d46f15fadcbd3257616ebfaf96a7c7c5f2f996a886102ba699e0b21b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "2033"
      ]
    },
    {
      "uid": "zhcn:bd8e61fdc1b9ac52ebc831b3",
      "kind": "character_system_text",
      "source_text": "我有种预感，\r\n今天一定可以用自己的方式，\r\n无比自由地比赛！",
      "source_fingerprint": "52d4dee0ff9283579c942258a42bc1b263c4055577e9df94ef931d2ffad5b747",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "2034"
      ]
    },
    {
      "uid": "zhcn:9efa6dd7565bf6bfd317f8e0",
      "kind": "character_system_text",
      "source_text": "辛苦了，训练员。",
      "source_fingerprint": "0e341b37152f4d4f3ba56e10fd6a64c90c6b82a1b5259828ca89442a02e66bd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "2035"
      ]
    },
    {
      "uid": "zhcn:a9b81c97a1d9b9eba9a69963",
      "kind": "character_system_text",
      "source_text": "やりますか！",
      "source_fingerprint": "b52a1f593af23d2907c6ebdf7d6aa66d9e1fdcd1d24b7dc708a0e2722a77a357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "23015"
      ]
    },
    {
      "uid": "zhcn:8675bfbe7dcdca835dd6900f",
      "kind": "character_system_text",
      "source_text": "优胜从手中逃走了……嗯，下一场！",
      "source_fingerprint": "e171bb12284cfad3928c20a4b1ee9eeea785bdc8e35b798642f956021c286f0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30000"
      ]
    },
    {
      "uid": "zhcn:27cc741267bdc3e7597208d7",
      "kind": "character_system_text",
      "source_text": "这成果就像是高尔夫的最近洞吧！",
      "source_fingerprint": "f1505bb2b29cf2f47573b28da635f6304dc18da108deac58dd9b7a750ccefcea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30001"
      ]
    },
    {
      "uid": "zhcn:dbca42db8dea3a1adb1db721",
      "kind": "character_system_text",
      "source_text": "接下来可得嗨起来啰！",
      "source_fingerprint": "dd7ec1540235b88d41cece63819b45f622b9fa6d3a66369c7f44ddcfe6874955",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30002"
      ]
    },
    {
      "uid": "zhcn:f82ec0ba6b6aa53e3f251c8c",
      "kind": "character_system_text",
      "source_text": "啊～真是的！我在搞什么啊！",
      "source_fingerprint": "aba875900491a42b420a877c19e694dffbcdf21c5b4d3e600c3a8356b782ab52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30003"
      ]
    },
    {
      "uid": "zhcn:456cf3b38bc057eb96daa733",
      "kind": "character_system_text",
      "source_text": "不得了吧？\r\n这就是我的实力！",
      "source_fingerprint": "886b123934701be44ff9d125e9e3a18218d029210f0d0cadfed72ac74c852b1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30004"
      ]
    },
    {
      "uid": "zhcn:6fa6a0374daedfbcd2eb303f",
      "kind": "character_system_text",
      "source_text": "耶──！我真有一套！",
      "source_fingerprint": "9b00cdd4a735b7318697b8fc809f0dbdc6bb953cecb92821c3c9df0c312fa9e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30005"
      ]
    },
    {
      "uid": "zhcn:603237ca7868fa478ac01179",
      "kind": "character_system_text",
      "source_text": "運んできたよ～、私たちの勝利をっ！",
      "source_fingerprint": "e08e4fbf9d72c3881861cbdfd5bddf174ebbde103a968e738109d0300e5188fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30006"
      ]
    },
    {
      "uid": "zhcn:8a73bdffe6ae03c7c5a10a2c",
      "kind": "character_system_text",
      "source_text": "イェーイ！私やるぅ！",
      "source_fingerprint": "b2f66908800a6d942c53f7474c403c9644349cbffc80eddf4132c745537e7760",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "30007"
      ]
    },
    {
      "uid": "zhcn:084d411e56cc5163dcb56d2a",
      "kind": "character_system_text",
      "source_text": "我要出招啰！",
      "source_fingerprint": "35c44ba7695c4e0b3a6c6568c8548cc965184b86f84849f3496fc4b3d34291b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "31000"
      ]
    },
    {
      "uid": "zhcn:2a21f57733c71d0e8a94bada",
      "kind": "character_system_text",
      "source_text": "我要抓住属于我的自由！",
      "source_fingerprint": "9bcd27feaa72ece3079a4d4093a4b076f544c5ca4cb96082ab856aba9eb467c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "40000"
      ]
    },
    {
      "uid": "zhcn:bfe82c37135d789a60bda8e2",
      "kind": "character_system_text",
      "source_text": "参考までにヘリオスにクリパ案\r\n聞いてみたらさ…ラップバトルて。\r\nいや～、それやったら勇者でしょ！",
      "source_fingerprint": "6f75285fc2cfbf573e4d11df56f739f0a6faead445684c38bf836263b77798dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400000"
      ]
    },
    {
      "uid": "zhcn:d534fc4d418fdc4a39890fd6",
      "kind": "character_system_text",
      "source_text": "你说休息也很重要？说得也是！\r\n那就尽全力休息吧！\r\n该怎么装潢魔王城呢♪",
      "source_fingerprint": "db990bc88633a38dcd45cad42cae34a4edcd0a6ac68dcb461dc774bd51634b32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400003"
      ]
    },
    {
      "uid": "zhcn:02e266a7bb56127b32f9cf74",
      "kind": "character_system_text",
      "source_text": "大姐姐，要不要和我一起玩啊？\r\n……太轻浮了？欸，和我一起……\r\n做遍夏天的开心事吧……也不对？",
      "source_fingerprint": "0e38b5ae6973b0c33743649cfab2f5bec3c69c295d93d28a2ba2664001dd8844",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400004"
      ]
    },
    {
      "uid": "zhcn:a421f772d7f3a63b26b23a05",
      "kind": "character_system_text",
      "source_text": "就算是朋友啊，也分成很多种……\r\n但对我来说都是相当重要的存在，\r\n因为能够让我保持理想的自己呢。",
      "source_fingerprint": "80fb0cff08a7e0a42dfa4082be5b2568986b6bd740f8a9fbae6681e44965022a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400006"
      ]
    },
    {
      "uid": "zhcn:cbea2f09431f815685066ced",
      "kind": "character_system_text",
      "source_text": "耍任性看似简单，\r\n其实很需要勇气呢。\r\n……风风果然很厉害！",
      "source_fingerprint": "ea8c11612c5772200158cf3f5843ab5d00d2ea353ba756771ff784211b12931d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400008"
      ]
    },
    {
      "uid": "zhcn:96e8412fd1ff9c10669e85d1",
      "kind": "character_system_text",
      "source_text": "メジロ家に風穴開けられたかな？\r\n…私だから、できたんだよね。\r\nやってやったぞー！あははははっ！",
      "source_fingerprint": "0ccbd7720e4875c922069269eca6009892e8aaf1c93f5f37d3ffae54d19d71f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400009"
      ]
    },
    {
      "uid": "zhcn:d9255e53134a4416e2982390",
      "kind": "character_system_text",
      "source_text": "喝啊啊！……我一定要……克服！\r\n我要……获得……自由……啊啊啊！\r\n哈哈，怎么样啊……！？",
      "source_fingerprint": "e771cce050d0c5ffe8b34a904750d9e61588df31a68ac9dd7e1bf258accc282a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "40001"
      ]
    },
    {
      "uid": "zhcn:31801ba64cfc3756eeffac37",
      "kind": "character_system_text",
      "source_text": "クリパはこっからっしょ！",
      "source_fingerprint": "7c46d13e31648149aa8ff598b141dd6065da2236402304b6fc922c711a92ced6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "40003"
      ]
    },
    {
      "uid": "zhcn:f5775a1f5dbd212086d63310",
      "kind": "character_system_text",
      "source_text": "メリクリー！はーい、おかわりどうぞー！\r\nお！となり失礼♪じゃ、改めて…メリクリ。",
      "source_fingerprint": "68599862a811796a5c39033652012e15c9379cda513d1913d11a38b8ad9a23bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "40004"
      ]
    },
    {
      "uid": "zhcn:09399b615f500efbf98ce5fd",
      "kind": "character_system_text",
      "source_text": "通常版メジロカレンダーは勝負服で\r\n撮ったんだ！…限定版がほしい？\r\nならクリスマス・ナイトにおいで！",
      "source_fingerprint": "559c90c139b8b5bc57dbf63fb717b9167719df7d4d3fe473d3fdaa3a9e550a90",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "400064"
      ]
    },
    {
      "uid": "zhcn:14b928645ab7dbeb33c1adc5",
      "kind": "character_system_text",
      "source_text": "耶耶～♪\r\n我要来一场最棒的演唱会表演喔！",
      "source_fingerprint": "c48faf5abcdbe7b471c8b9f29921c69ffbc8f2786b64e8da32353c5fb542c65a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "60000"
      ]
    },
    {
      "uid": "zhcn:949149061d850adb2662fa28",
      "kind": "character_system_text",
      "source_text": "善信已经\r\n整个嗨起来啰♪",
      "source_fingerprint": "a7ebdc693b69e790803c7f8b9e155779e040403b0e492ccf29b79611261210b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "60001"
      ]
    },
    {
      "uid": "zhcn:bb0879182b352acd0955b380",
      "kind": "character_system_text",
      "source_text": "好啦，就放轻松一点吧。",
      "source_fingerprint": "c3c7bb1e4d35312ff4f8c9209114dd716f49bfaf064654b474d3d69cfe7359f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70000"
      ]
    },
    {
      "uid": "zhcn:3548f0a0533fb048fda5258b",
      "kind": "character_system_text",
      "source_text": "当时我是担心你才会向你搭话。\r\n但现在你已经是个出色的\r\n训练员了呢……啊哈哈♪",
      "source_fingerprint": "f1aaf59fb8030a9a02b11dcd5c0e6847ad43a0d99947be36e9b86b4955bb0979",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70001"
      ]
    },
    {
      "uid": "zhcn:5ece512700dd8aab5ea9ddcf",
      "kind": "character_system_text",
      "source_text": "很适合吧～\r\n正式服装也不赖呢！",
      "source_fingerprint": "605cc077165de15fd03576c50604d8129bee4307a9360db06c458cbb15a8aa2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70004"
      ]
    },
    {
      "uid": "zhcn:ac5a993734b5192f235cccec",
      "kind": "character_system_text",
      "source_text": "唱歌跳舞的善信！\r\n要为台上的我加油喔！",
      "source_fingerprint": "a0b94844b6a7d1e2883b09be0f9c822493df69eb470cd921b8e58d40fe0fa352",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70008"
      ]
    },
    {
      "uid": "zhcn:9ccb9f10efc3b649668deac6",
      "kind": "character_system_text",
      "source_text": "怎么样啊？美国风格♪\r\n果然令人感到很嗨呢！",
      "source_fingerprint": "31ab87edbcfb8292663e7104df8a649850b0afa54a1e6da8267ef9f3ebcf9d47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70009"
      ]
    },
    {
      "uid": "zhcn:dee63f45568353203b826161",
      "kind": "character_system_text",
      "source_text": "怪了，衣服上的折痕呢？\r\n我明明折出线后熨烫过的～",
      "source_fingerprint": "982cf5d08894007f0b259a5829a842305fceeb5ef382b27fded1341126e714ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70010"
      ]
    },
    {
      "uid": "zhcn:c59496cbc07277a86b338d63",
      "kind": "character_system_text",
      "source_text": "穿这样拍的「咖哩乌龙面挑战」影片\r\n真的爆红了！",
      "source_fingerprint": "93365a1226421997d552bce563d4c6df5cc1440d982f5f419dcec1295b85c867",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70014"
      ]
    },
    {
      "uid": "zhcn:a5bb9b297d9e9d22252f3ab7",
      "kind": "character_system_text",
      "source_text": "不错吧？休闲又自由的感觉。\r\n一定可以来场神速领头！",
      "source_fingerprint": "36ab75c2514c38f663a4fd4fc93f9215b2a8ff49b63a4759389bf998c7e2f271",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70015"
      ]
    },
    {
      "uid": "zhcn:3086b0d53ad826301acad25c",
      "kind": "character_system_text",
      "source_text": "袖口の肌触りがあげみざわ～って感じ！？",
      "source_fingerprint": "1e6ff99bcbf8fc510c36b955f012d79172be1e9d10c8d195a8e0528f3bb8fcd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70016"
      ]
    },
    {
      "uid": "zhcn:f4a2d425cbdeb0a4c841667b",
      "kind": "character_system_text",
      "source_text": "クリパのはしごとかしちゃう？",
      "source_fingerprint": "91d6b2cec567fc416304adbcf018eaa05b9c4c49a787b3af40b257e3201166c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70017"
      ]
    },
    {
      "uid": "zhcn:2f888000137e9ac6371d7012",
      "kind": "character_system_text",
      "source_text": "很适合吧？怎么样呀～♪",
      "source_fingerprint": "31eeb4909537506aca4634a8efa34ef354c6e0d2aa2c4a40ff2b2df61003eefa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70018"
      ]
    },
    {
      "uid": "zhcn:b112b97809b02af115a927f3",
      "kind": "character_system_text",
      "source_text": "嗯，具有特别意义的服装！",
      "source_fingerprint": "a70c518ef6dc82fafb35e3184023f9deb484f2c55453de993a0093c94facd671",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70019"
      ]
    },
    {
      "uid": "zhcn:bac0b2661c1bbabf8bbc15b4",
      "kind": "character_system_text",
      "source_text": "你好！\r\n我是其实很高雅的善信哦～",
      "source_fingerprint": "9cb1f6b068feb86a3d73106977a827c5462ce475d6c9d59d4f78e62c20fc42bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70020"
      ]
    },
    {
      "uid": "zhcn:f0c85adcee14f394a0489336",
      "kind": "character_system_text",
      "source_text": "我总是都挑一些\r\n色系比较沉稳的风格呢。\r\n要不要再加入些玩心呢？",
      "source_fingerprint": "d0221c5db675155e841818ad836c896f314565f11641b5b93fc2142ee3579ccc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "70021"
      ]
    },
    {
      "uid": "zhcn:049b292ee57cc985027abdb9",
      "kind": "character_system_text",
      "source_text": "很适合吧～\r\n正式服装也不赖呢！",
      "source_fingerprint": "605cc077165de15fd03576c50604d8129bee4307a9360db06c458cbb15a8aa2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71004"
      ]
    },
    {
      "uid": "zhcn:e1a528791d93611509711301",
      "kind": "character_system_text",
      "source_text": "唱歌跳舞的善信！\r\n要为台上的我加油喔！",
      "source_fingerprint": "a0b94844b6a7d1e2883b09be0f9c822493df69eb470cd921b8e58d40fe0fa352",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71008"
      ]
    },
    {
      "uid": "zhcn:e70260982496e184e174bb2d",
      "kind": "character_system_text",
      "source_text": "怎么样啊？美国风格♪\r\n果然令人感到很嗨呢！",
      "source_fingerprint": "31ab87edbcfb8292663e7104df8a649850b0afa54a1e6da8267ef9f3ebcf9d47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71009"
      ]
    },
    {
      "uid": "zhcn:421b47e87f958b3ad50a25f4",
      "kind": "character_system_text",
      "source_text": "怪了，衣服上的折痕呢？\r\n我明明折出线后熨烫过的～",
      "source_fingerprint": "982cf5d08894007f0b259a5829a842305fceeb5ef382b27fded1341126e714ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71010"
      ]
    },
    {
      "uid": "zhcn:4e71228c8492a3d46ec43f82",
      "kind": "character_system_text",
      "source_text": "穿这样拍的「咖哩乌龙面挑战」影片\r\n真的爆红了！",
      "source_fingerprint": "93365a1226421997d552bce563d4c6df5cc1440d982f5f419dcec1295b85c867",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71014"
      ]
    },
    {
      "uid": "zhcn:bcb727a3cbe2cc1ae599353d",
      "kind": "character_system_text",
      "source_text": "不错吧？休闲又自由的感觉。\r\n一定可以来场神速领头！",
      "source_fingerprint": "36ab75c2514c38f663a4fd4fc93f9215b2a8ff49b63a4759389bf998c7e2f271",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71015"
      ]
    },
    {
      "uid": "zhcn:75c9c2003c9df8e61df5a97f",
      "kind": "character_system_text",
      "source_text": "袖口の肌触りがあげみざわ～って感じ！？",
      "source_fingerprint": "1e6ff99bcbf8fc510c36b955f012d79172be1e9d10c8d195a8e0528f3bb8fcd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71016"
      ]
    },
    {
      "uid": "zhcn:56e06d0764b3858dd026a490",
      "kind": "character_system_text",
      "source_text": "クリパのはしごとかしちゃう？",
      "source_fingerprint": "91d6b2cec567fc416304adbcf018eaa05b9c4c49a787b3af40b257e3201166c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71017"
      ]
    },
    {
      "uid": "zhcn:270aa4e3bcbd247a3ac69462",
      "kind": "character_system_text",
      "source_text": "很适合吧？怎么样呀～♪",
      "source_fingerprint": "31eeb4909537506aca4634a8efa34ef354c6e0d2aa2c4a40ff2b2df61003eefa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71018"
      ]
    },
    {
      "uid": "zhcn:22fb7d66be63676d95f96acf",
      "kind": "character_system_text",
      "source_text": "嗯，具有特别意义的服装！",
      "source_fingerprint": "a70c518ef6dc82fafb35e3184023f9deb484f2c55453de993a0093c94facd671",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "71019"
      ]
    },
    {
      "uid": "zhcn:24d82650af07503c2e260cd0",
      "kind": "character_system_text",
      "source_text": "辛苦啦。",
      "source_fingerprint": "2844e10231fb1df80ddf92369741a345d71164ac359effd4df72193851603d28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "80000"
      ]
    },
    {
      "uid": "zhcn:a377861a130340998816027f",
      "kind": "character_system_text",
      "source_text": "若不来真的立刻就会被我甩掉，\r\n做好心理准备吧！",
      "source_fingerprint": "6f02aef176275664528070bc569393141ce9e3e624112100aa127104b1741dd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "81000"
      ]
    },
    {
      "uid": "zhcn:b4acf01bb841e8e137412209",
      "kind": "character_system_text",
      "source_text": "喔，挺行的嘛～\r\n善信小姐也开始加速吧！",
      "source_fingerprint": "ee889a0ee71167be5edad62511dd1b2909c3f58e82f8f00e3a1a38a56565d59a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "81001"
      ]
    },
    {
      "uid": "zhcn:a1e88e085ae75c6d11c75b50",
      "kind": "character_system_text",
      "source_text": "早～安啊……哦，\r\n感觉好新鲜！因为我跟熟朋友都是用\r\n「欧耶～」打招呼嘛！",
      "source_fingerprint": "3fefd1aabfd1930b6a8850fea09d68332ce437036acc8af66349158d4f72168d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90000"
      ]
    },
    {
      "uid": "zhcn:c5fe24cff2d6c75f6804f3a8",
      "kind": "character_system_text",
      "source_text": "小时候我常帮光明整理她睡乱的\r\n头发呢……她那满头乱翘的头发\r\n超可爱的啦！",
      "source_fingerprint": "1ee63d787ff8659e29844b392753f0f140d70f893eaa5dadb3839ef441d97610",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90001"
      ]
    },
    {
      "uid": "zhcn:f024f3c125b3b8fd26a8d429",
      "kind": "character_system_text",
      "source_text": "呼啊～中午睡魔袭来，\r\n连善信我都逃不掉。",
      "source_fingerprint": "e353b42b3bd8bb8157035f16fc88d766d6eb7221b95ee9438ca416a14aad9ab2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90002"
      ]
    },
    {
      "uid": "zhcn:db15d4d69fa5df870e5b264c",
      "kind": "character_system_text",
      "source_text": "我经常会去找没有一起\r\n吃过饭的学生吃午餐喔。\r\n目标是集满全校学生！",
      "source_fingerprint": "bb8f59bc3b2b1670397e8be2f1282a37d3709b328c547e8df5b89115254226da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90003"
      ]
    },
    {
      "uid": "zhcn:6eb058db477ea8650e3496f2",
      "kind": "character_system_text",
      "source_text": "好安静的夜晚……这时候最适合打\r\n高尔夫了，振臂高挥让球飞得远远的\r\n一定会很舒畅呢……（偷瞄）",
      "source_fingerprint": "81314a30b42d0a00ffdef0106b0b7853cd66981b46ba8bee448db2b7eca94eec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90004"
      ]
    },
    {
      "uid": "zhcn:760a6126a6ed1a40c3aef7c9",
      "kind": "character_system_text",
      "source_text": "一到晚上找我商量的信息就会变多。\r\n看来大家都在这段时间感到不安呢～\r\n好，来努力回复啰！",
      "source_fingerprint": "21372906c75a3e6238926a640971ac530198f043e34250ced4f6a36bce09d653",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90005"
      ]
    },
    {
      "uid": "zhcn:3168519ac288796f47879048",
      "kind": "character_system_text",
      "source_text": "每年我都会跟麦昆、赖恩一起赏花。\r\n我们还开了一个LANE群组，\r\n叫做「花组」喔～",
      "source_fingerprint": "72b56bbecb7746d4238fc2f999435de8491927e0a28871582909e79c48ac342a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90006"
      ]
    },
    {
      "uid": "zhcn:326bc6f71f274c9aeadc3936",
      "kind": "character_system_text",
      "source_text": "呼～今天也好热喔。\r\n要不要一起去目白家的度假别墅\r\n悠闲地泡泡海水浴啊？",
      "source_fingerprint": "3530d047e7994ce45328b072bcd20c746cc953d103494b18a2adab227c2acd59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90007"
      ]
    },
    {
      "uid": "zhcn:e6dad53ec1ba8626f41cf35c",
      "kind": "character_system_text",
      "source_text": "秋天真棒呢，可以拍到很多美照♪\r\n枯山水庭院中落叶纷飞，大自然\r\n就是最强的美景，太棒啦！",
      "source_fingerprint": "010f99135c13daf67163ac91f38ae86f37c143bc362ceb6fe09f55498dda7c07",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90008"
      ]
    },
    {
      "uid": "zhcn:d36b86847343e300d97e587f",
      "kind": "character_system_text",
      "source_text": "你有看见太阳神吗？她拿走了我的\r\n高尔夫球杆的杆头套子！我明明说过\r\n拿来当手套还是会冷的！",
      "source_fingerprint": "59e5375626ac77823246a2af9b3093f155428a1bbde491699be06ab10116c1bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90009"
      ]
    },
    {
      "uid": "zhcn:29505e148c96c7009afb854e",
      "kind": "character_system_text",
      "source_text": "おっはよー！枕元チェックした？\r\nプレゼントあるかも…って思って\r\n起きると、毎朝楽しいよ♪",
      "source_fingerprint": "b7dd7bafb50240d8196b9f4e41883762c9216108940fccf1790cf045910dd359",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90010"
      ]
    },
    {
      "uid": "zhcn:ffae4cf512b82d066a4003ab",
      "kind": "character_system_text",
      "source_text": "う～ん…片側で髪結ぶからさ、\r\n毛先が綺麗にそろわないんだよね。\r\n朝から何回やり直したことか…。",
      "source_fingerprint": "d3d39f95d92246a733a8a919adc3734cbfc408348fa814831032456bb319864d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90011"
      ]
    },
    {
      "uid": "zhcn:0a88f083ff7d0437497c113a",
      "kind": "character_system_text",
      "source_text": "昼に出る時は、日傘がマスト！\r\nないと肩とか焼けちゃうから。\r\nもちろん日焼け止めも欠かさないよ",
      "source_fingerprint": "83472dd4e271d8ec290e5b4c2449ee53a635c95adfa74238b79e1ed47ce912b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90012"
      ]
    },
    {
      "uid": "zhcn:bd3e4b47384aaddae62082aa",
      "kind": "character_system_text",
      "source_text": "ランチは勝負だよ。白い衣装を\r\n着てる時は…特に！！はぁ…\r\n染み抜きホント大変なんだから…。",
      "source_fingerprint": "2acf867e257c001867c0a1746a97570d07638a7f951e2b0e812ff8ab60a17047",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90013"
      ]
    },
    {
      "uid": "zhcn:0b7b725bb12cdfe53cad0d5a",
      "kind": "character_system_text",
      "source_text": "この格好なら、夜空も走れそうな\r\n気がしてさ。流れ星と競走とか…\r\n夜を自由に走るのって、楽しそう！",
      "source_fingerprint": "b596066c540784c7a30d7d029bce5de2705bf00c165a42f5933776376513bc51",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90014"
      ]
    },
    {
      "uid": "zhcn:d39c57098ae67c559fae6bc5",
      "kind": "character_system_text",
      "source_text": "お仕事頑張るよい子には、私から\r\nプレゼント～！机にお菓子置い\r\nといたから、あとで食べてねっ♪",
      "source_fingerprint": "6f3d0b4fbb5b23e4ec6e97665108adb7930735d6dc16a359d483af77b0103e86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90015"
      ]
    },
    {
      "uid": "zhcn:1a37d9726d2b0f866bf4a4f4",
      "kind": "character_system_text",
      "source_text": "う～ん、春風って気持ちいいね。\r\n読みにくいのもあるけど…それも\r\n春ゴルフの醍醐味ってね♪",
      "source_fingerprint": "c6891cc6ac122620774f18aad2c622623b2ecead5ac8c91fe09d5c61043ddbe2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1064",
        "90016"
      ]
    }
  ]
}
