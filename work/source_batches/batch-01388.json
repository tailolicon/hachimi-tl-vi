        "140000"
      ]
    },
    {
      "uid": "zhcn:7172482a477cead9f59aa0a0",
      "kind": "character_system_text",
      "source_text": "好耶～！",
      "source_fingerprint": "9f2b25aea591789d93c8295b3a2c30110ea2c5eae7faeb34de9ea735a084f5bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
