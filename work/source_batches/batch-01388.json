      ]
    },
    {
      "uid": "zhcn:dc59c77006f0dd11aced03a1",
      "kind": "character_system_text",
      "source_text": "今天的登录奖励哦～！",
      "source_fingerprint": "59303f0366accaf8c7eeb0512a6fff3424073737bea66dfa34fd2cb2001f53a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
