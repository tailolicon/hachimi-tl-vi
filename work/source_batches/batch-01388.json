      ]
    },
    {
      "uid": "zhcn:0f39c6e39b57eeedd779bff9",
      "kind": "character_system_text",
      "source_text": "诶，诶！",
      "source_fingerprint": "cebf04ad88554ce4a28f5249f72d2064ff6c876f160a925901d311fe63ae734d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1062",
        "1135"
      ]
    },
    {
      "uid": "zhcn:622ffa4c10150605e9cacf01",
