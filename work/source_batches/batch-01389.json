  "entries": [
    {
      "uid": "zhcn:516814754d6ca0eb5b053d48",
      "kind": "character_system_text",
      "source_text": "Fu～！大家最棒了～！",
      "source_fingerprint": "3683edc27f8eb5cbea6aa318478f9cbfa8cfe592ab6192311f8cb1de113ef1d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "1001"
      ]
    },
    {
      "uid": "zhcn:13e165fa18f3ee8d04efb7fd",
      "kind": "character_system_text",
      "source_text": "我要跟姐妹们们一起跨年倒数！\r\n佐敦说会帮忙挑披萨和饮料！\r\n她真的太神了～！",
      "source_fingerprint": "52ed08c227017bd09f91206484f831babcb8de92dae088450372bbe880ce1b2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10010"
      ]
    },
    {
      "uid": "zhcn:2bbaed3ca83766d20db007b5",
      "kind": "character_system_text",
      "source_text": "阿训训生快～～！\r\n来办庆生派对吧☆\r\n做个汽水塔！大闹一场吧～☆",
      "source_fingerprint": "e7be412384c1aa775943ed48f63210868c0d361fabe2da131625f5ddff09b1a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10011"
      ]
    },
    {
      "uid": "zhcn:d6e33dd5e3ccfd36d18c498f",
      "kind": "character_system_text",
      "source_text": "生日礼物是～小阳阳特制蛋糕！\r\n上面的装饰是我们的脸！\r\n色彩鲜艳的阿训，很可爱吧！？",
      "source_fingerprint": "79562e0cffff92d28e5c5e07a0eedf2a5d5d529ad037089a4705d4ed67b0f268",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10012"
      ]
    },
    {
      "uid": "zhcn:dfaebaf72806112e30968b95",
      "kind": "character_system_text",
      "source_text": "收到善信送的生日礼物，好开熏～！\r\n是我超想要的饰品耶！\r\n好麻吉之力太让人感动了！",
      "source_fingerprint": "22f2fa73dabc02d3427ffac597391a4ab624549566faf589ca7ca411b5a7f4fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10013"
      ]
    },
    {
      "uid": "zhcn:abcb2b4d010da16ee84af7b9",
      "kind": "character_system_text",
      "source_text": "欸～欸～！\r\n你可以当我的庆生派对主持人吗！？\r\n果然只有阿训才能胜任啊☆",
      "source_fingerprint": "58400b059243ff91aadb28c00ee54b96a5c35cc37446ef46eadee6fc18a0da88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10014"
      ]
    },
    {
      "uid": "zhcn:5fa8c2a06013666b6cda23ba",
      "kind": "character_system_text",
      "source_text": "好像有新公告？\r\n快快看完＆快快回复吧～☆",
      "source_fingerprint": "a00ebcbfc260402c889dc445d9afa7864295a66bad43501c76d18d63a7329b5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10015"
      ]
    },
    {
      "uid": "zhcn:b0e416f4b2efdf29db7099a2",
      "kind": "character_system_text",
      "source_text": "喔耶～！有礼物！\r\n太令人开熏了～～！",
      "source_fingerprint": "81244cfc2ba40489037b8343a157e9166e6271780486d699449a7cb8fb3e589a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10016"
      ]
    },
    {
      "uid": "zhcn:f567a00f4bc1c9ffa4584f4a",
      "kind": "character_system_text",
      "source_text": "咻～达成任务了！\r\n真不愧是小训训☆",
      "source_fingerprint": "0c9e7a820d7dac30221ff463da2ac3ebfb0a1df805505cb53276d70a9564832c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10017"
      ]
    },
    {
      "uid": "zhcn:ddb7b9a02c33b6f8fddd9ed2",
      "kind": "character_system_text",
      "source_text": "活动要开始了！？嗨起来～！\r\n我等不及了～！",
      "source_fingerprint": "8be426df087ff024b53c0d2a875069c7f525c7db6ddc900b72960983281c911e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10018"
      ]
    },
    {
      "uid": "zhcn:88556602653b0451ac87dfad",
      "kind": "character_system_text",
      "source_text": "阿训训，快点过来♪\r\n一起来参加活动狂嗨吧☆",
      "source_fingerprint": "c230941f912cc6759865a5bc008757d8d972ec931ab9c1587c20554193c109d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10019"
      ]
    },
    {
      "uid": "zhcn:23ef543c071168480f59ef70",
      "kind": "character_system_text",
      "source_text": "唔喔！太不甘心了！",
      "source_fingerprint": "77795fe98a1e799f655f44908f30a3924cc39f3249d0da230f1c5322cb76120b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "1002"
      ]
    },
    {
      "uid": "zhcn:3e4b79a98ff78643900b17a8",
      "kind": "character_system_text",
      "source_text": "名册等级提升了耶！\r\n继续不断提升吧～！",
