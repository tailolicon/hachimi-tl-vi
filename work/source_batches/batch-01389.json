      "source_fingerprint": "4ee40e6a2a91b2c2b7dfca89932da376417f711c7a710098bf445a3c0c596b97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140012"
      ]
    },
    {
      "uid": "zhcn:ba3897f06a0f02d3b7f93f20",
      "kind": "character_system_text",
      "source_text": "呀哈哈哈！天啊～！",
      "source_fingerprint": "e6b47a9fc522381d7f6a73fefb463ecf84496fd5fa0e0d770a6f5aadc3e42075",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140013"
      ]
    },
    {
      "uid": "zhcn:db1031a422f9852d2dd11bf3",
      "kind": "character_system_text",
      "source_text": "呃啊～！",
      "source_fingerprint": "16b48627160c8bfff3aaa953a94f35fe03f5a07e58d2e607f187a8fc36cda43e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140014"
      ]
    },
    {
      "uid": "zhcn:424fa9cc8eb871f0b9024649",
      "kind": "character_system_text",
      "source_text": "上啊上啊～！",
      "source_fingerprint": "d661a5d56c7f97ddb5d4a1073229e5b437e7c75e24b9b955e9a16de5465845a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140015"
      ]
    },
    {
      "uid": "zhcn:ca8ec017d8ff5a722a336a8f",
      "kind": "character_system_text",
      "source_text": "要上吧？要拚一下吧？",
      "source_fingerprint": "f09fa71b3804b2d74eed5a432ce884ff9eab3f782465ea32814264bc50422936",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140016"
      ]
    },
    {
      "uid": "zhcn:5b7d5027161bcf9fac7d855c",
      "kind": "character_system_text",
      "source_text": "呃啊～！太可惜了！",
      "source_fingerprint": "3c9095e5ea8464e3b96dd3300ac458b4ab5d10cb8a524956f86cb5c652e6ba44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140017"
      ]
    },
    {
      "uid": "zhcn:b838f3446a5708107ee8e1c4",
      "kind": "character_system_text",
      "source_text": "喔喔！",
      "source_fingerprint": "3698f7bf45bf8f30b355ffabce5c3240f1ec7b1ee583961830a0bde53969ac1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "140018"
      ]
    },
    {
      "uid": "zhcn:1c225fd0eb1e784fb007f4bc",
      "kind": "character_system_text",
      "source_text": "明天是这个！太令人期待了吧！？",
      "source_fingerprint": "c644e6d4d7bb4577faac8e34b7f15621f388161d55dc0daf82bbb9723e201ad8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "15"
      ]
    },
    {
      "uid": "zhcn:489946a10eb3406ef87923b0",
      "kind": "character_system_text",
      "source_text": "喔耶～要做什么～！？\r\n再累也要砰砰，嗨起来砰咚～？\r\n转圈转圈砰砰哔～～？？？？",
      "source_fingerprint": "e54ca5646aaa54f5e6b7b60c5ca01c384b7c311051d0f44e0d736cf6d6ccca77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20000"
      ]
    },
    {
      "uid": "zhcn:2ce9b20098095cb4a282f3ea",
      "kind": "character_system_text",
      "source_text": "今天、也要、嗨到不行──\r\n……呼、呼，我、我没事，\r\n只是有点喘、而已……！",
      "source_fingerprint": "b7e331db1bedb1666623a064884d0cffbfec93c3014660554a1f71a2ee9baba0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20001"
      ]
    },
    {
      "uid": "zhcn:e643b1d7f5a818459be2b938",
      "kind": "character_system_text",
      "source_text": "听我说听我说～！\r\n我现在状态特别神！\r\n阿训也用地狱模式吧！",
      "source_fingerprint": "572c495c60e315f6fae08b7437cb65d814cba257e7a36ddf24ad52ef59930c1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20002"
      ]
    },
    {
      "uid": "zhcn:bc5d9407f6d7138f692eb046",
      "kind": "character_system_text",
      "source_text": "砰砰砰～！\r\n我最近好像超级猛！？\r\n好像只能遥遥领先了！？",
      "source_fingerprint": "da3a7a1b7f65ab67dfa31a4e68fecee2cbaeb692998d27fff9938f3867c48b19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20003"
      ]
    },
    {
      "uid": "zhcn:d5dff714eba84525fb1f837d",
      "kind": "character_system_text",
      "source_text": "好耶好耶，好耶耶～！\r\n尽管来吧☆",
      "source_fingerprint": "19251174e7c51034384d73d81c58852bc3ec8bcd5b6f7045c0e7404e88d91d75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20004"
      ]
    },
    {
      "uid": "zhcn:808194e856ea8520c5a52010",
      "kind": "character_system_text",
      "source_text": "要上啰，嗨到不行的打call！\r\n燃起草根性吧～！",
      "source_fingerprint": "2206da0b9d716606149ed89a7ada031eb92de5e54ef4d3a9ba7fb1d5356615ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20005"
      ]
    },
    {
      "uid": "zhcn:93b7fb714a4fa9d094fd6b84",
      "kind": "character_system_text",
      "source_text": "DJ太阳神喔耶～☆\r\n今天也要跟它拚了！赞啦～！",
      "source_fingerprint": "eaa46fac390e8379a1909f79bae8de42dbf62dd140e67a6708870415c8cb7a3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20006"
      ]
    },
    {
      "uid": "zhcn:17b0d9236ffd184d7ab0823b",
      "kind": "character_system_text",
      "source_text": "今天要跟姐妹们一起唱歌～♪\r\n所以要加油呗☆",
      "source_fingerprint": "69c3e723bff3fe444dea25b8419fd3716a4c0b7c8238a4f2a27ed152c50c0dc7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20007"
      ]
    },
    {
      "uid": "zhcn:e6f27ecd9c088f1a7016d927",
      "kind": "character_system_text",
      "source_text": "真假？今天有安排行程吗？\r\n糟糕～是什么？？脑袋无法思考～！",
      "source_fingerprint": "c8e3c9e37d09acf1df6c675898f5a00d17138eced19f1d87fa222b54f2dc0edd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a3a5da90c38448cfc2ee1735",
      "kind": "character_system_text",
      "source_text": "干劲跌到谷底～\r\n这下只能嗨一波了吧？",
      "source_fingerprint": "6efffb9648c0da2e1a82916f719d1b408b871cdb55bd4ec80212e30e2dac9119",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20009"
      ]
    },
    {
      "uid": "zhcn:159690e05b281160dabc6d2c",
      "kind": "character_system_text",
      "source_text": "状态哭哭～～！\r\n好想喝珍奶～～！",
      "source_fingerprint": "e7a3787d8af982b5b19e3c8875fd597c0ab5b84c018ad6e4e3eb268e231f9163",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20010"
      ]
    },
    {
      "uid": "zhcn:80c67c82cfa9a28114d4333d",
      "kind": "character_system_text",
      "source_text": "唔哈哈～总之先笑再说～？\r\n我阿姨也说过，\r\n这种时候要把郁闷全吐出来！",
      "source_fingerprint": "2bb079bd6fe81632eb35e321784691df2b708718e2948fcf0ce8736cf1f79a33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20011"
      ]
    },
    {
      "uid": "zhcn:56225fd0bb7c758e53e5106c",
      "kind": "character_system_text",
      "source_text": "连续参赛也太好笑了～！\r\n阿训训会不会太斯巴达了！？",
      "source_fingerprint": "e9bf5fa1ea1e1e777821322018bd4eb127beb2ba36b225f40f319476252c1f22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20021"
      ]
    },
    {
      "uid": "zhcn:98f35e424b6c83ed90f5000d",
      "kind": "character_system_text",
      "source_text": "真假～！？参加太多比赛了吧！？\r\n这已经超越哭哭跟哇哇大哭，\r\n变成气噗噗了～！",
      "source_fingerprint": "871edab5b4bdd9fe062fc547f2dd5c12e9bff952998a9d7f3e5a04bd52b7ed0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20022"
      ]
    },
    {
      "uid": "zhcn:877f3aea59587bbf3c7ac50e",
      "kind": "character_system_text",
      "source_text": "嗨～～～～到不行啊！\r\n感觉我将掀起一阵风暴！\r\n不如说我就是风暴！？",
      "source_fingerprint": "3cb8a8e1f2bbacf7be49f9ca1ba2aa6a1760476d2a5f8c754a1e5e36984b9d24",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20023"
      ]
    },
    {
      "uid": "zhcn:6df365acb741bb4319f48832",
      "kind": "character_system_text",
      "source_text": "我现在强到爆炸喔砰砰砰～！\r\n我会超越所有人！交给我吧～☆",
      "source_fingerprint": "bfc6e5d97310a75b300b0fd2ef4281ec92fbdf810c8aa4ebc28c3c786939e0b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20024"
      ]
    },
    {
      "uid": "zhcn:9cbb9e926cea4af7ad266ead",
      "kind": "character_system_text",
      "source_text": "小训，谢啦！\r\n我现在超认真觉得自己不会输！！",
      "source_fingerprint": "4529edc4112ae3023df1ca8a99119dd62aa77bb368704a9b79d99a75c90624f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20025"
      ]
    },
    {
      "uid": "zhcn:a7abca0693f4a9e3c9e60bfb",
      "kind": "character_system_text",
      "source_text": "嗨一波啦～～！！\r\n小训训，从贵宾席\r\n把手都举高～☆",
      "source_fingerprint": "7c9294e7425f4e075ce5fcebff50bcfadf6548eaf86ba841aeb2ce5a90bdec67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20026"
      ]
    },
    {
      "uid": "zhcn:0b26052c4acb8f5a8b526cf3",
      "kind": "character_system_text",
      "source_text": "喔喔～观众们都跟着嗨起来了～！\r\n总之先在亮相圈与粉丝互动吧☆",
      "source_fingerprint": "177c69304525cf4efc45f73e1dfadaaf8a3079f2a0ef4d02d07c9f5768726151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20027"
      ]
    },
    {
      "uid": "zhcn:e2576f086875e88a998f8f52",
      "kind": "character_system_text",
      "source_text": "呜～～感觉整个人静不下来！\r\n该怎么形容？像在舞池里一样？\r\n兴奋期待抖啊抖啊抖～～！",
      "source_fingerprint": "bb583ebb804878fd89102c142238d66adae3d17438e30b8310ef07f7047168b7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20028"
      ]
    },
    {
      "uid": "zhcn:65b6d460c3b80fec64ccbad8",
      "kind": "character_system_text",
      "source_text": "我在UG收到了热情的支持留言～\r\n不让自已更嗨怎么行啊～～！？",
      "source_fingerprint": "cb82568c43a7c49badd73006620d33da73279a71e98d879ca392c1d4994f8a6e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20029"
      ]
    },
    {
      "uid": "zhcn:54e14f975f201fc2bc2730d9",
      "kind": "character_system_text",
      "source_text": "像平常那样嗨一波吧！\r\n看过来☆",
      "source_fingerprint": "4fd5f77cf03bf18e779f981ef6bfd55d56f6910a85e27406e0e5fcb4a41f7a84",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20030"
      ]
    },
    {
      "uid": "zhcn:102fa4e97f288967f042d126",
      "kind": "character_system_text",
      "source_text": "那我要跟平常一样去与粉丝互动了！\r\n要上啰～？FuFu～♪",
      "source_fingerprint": "a44828e06d2827371f108486ab4e98a4bfcb9b8060a1468a8828d48959d35e67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20031"
      ]
    },
    {
      "uid": "zhcn:bb480a6477af4a5510a97a54",
      "kind": "character_system_text",
      "source_text": "状态？一点都不好喔！啊哈哈！\r\n没差，船到桥头自然直！\r\n是说，我会想办法的啦 。",
      "source_fingerprint": "a1f8c8ed90a0b2346401e0009cd9babfa8c83783e036ea0cedb48c9666a1dd94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20032"
      ]
    },
    {
      "uid": "zhcn:5fdffc54123d884840ea6d21",
      "kind": "character_system_text",
      "source_text": "嘿～嘿～FOO～♪\r\n小训也一起来跳舞吧？\r\n嗨起来吧～！",
      "source_fingerprint": "a7ea7276344a0e707b23b0e2b708ac52c14d7a4bff99cbeab76fda38db02ebaa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20033"
      ]
    },
    {
      "uid": "zhcn:319768bb813383751d2b788b",
      "kind": "character_system_text",
      "source_text": "啊～坦白讲状态不太好。\r\n但不嗨也很吃亏吧？\r\n总之只能尽情享受了！",
      "source_fingerprint": "690cba7cb8e0342a5c82403e0c88bd4be072282ab567d325841c49f2bfbcbd14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "20034"
      ]
    }
  ]
}
