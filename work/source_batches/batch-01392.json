  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:98094649977a1dbe3bccbd35",
      "kind": "character_system_text",
      "source_text": "…芳しい状態ではありませんが、\r\n諦めては、元も子もない。\r\nここまでの積み重ねを信じます。",
      "source_fingerprint": "0ed0386ceb990cb7aa0cc36cac9d09644b0679b6ce2ade9949ae2a27ff8d4e48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20036"
      ]
    },
    {
      "uid": "zhcn:75c0ff34defced247e7fd643",
      "kind": "character_system_text",
      "source_text": "んん…集中できない…\r\nレース前だというのに…\r\nゴールだけ見据えるイメージを…！",
      "source_fingerprint": "ce1a22f31fb0e5136b055ec4f2d4a08854658bb13525405a887ac62ec3236f70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20037"
      ]
    },
    {
      "uid": "zhcn:bbf9ff19bfc834b3b9b9faa4",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20038"
      ]
    },
    {
      "uid": "zhcn:0abbaab8dedcf84244628948",
      "kind": "character_system_text",
      "source_text": "承知です。",
      "source_fingerprint": "454ffbb46c2a2bf1f525b88f5dcac18ebe59f7b0b431281d2cee0d6075f1ed5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20039"
      ]
    },
    {
      "uid": "zhcn:5fbe338a3c90454f1f00a32f",
      "kind": "character_system_text",
      "source_text": "なるほど。",
      "source_fingerprint": "e6060d825a6076f13a47cc304d64491b431764116f93db22e8a3eb419858f2a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20040"
      ]
    },
    {
      "uid": "zhcn:a98c0021b3a3f7c487f08e6e",
      "kind": "character_system_text",
      "source_text": "お任せを。",
      "source_fingerprint": "cd56fc89933c98f2d405367498050ad3882b076dea9dea406b582ac41fe93472",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20041"
      ]
    },
    {
      "uid": "zhcn:86426e61a7068f841ca85333",
      "kind": "character_system_text",
      "source_text": "ああ…！？",
      "source_fingerprint": "83997e676457c2ca6ac6e81715f7ed1d1742a08535dbc42afb02428dc208218d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20042"
      ]
    },
    {
      "uid": "zhcn:288ba6be119f6b6c1cc5f85c",
      "kind": "character_system_text",
      "source_text": "ううん…？",
      "source_fingerprint": "e4610d2a837390411f3238a308fa9072f79329f8363540d99251a9a6a91d3f51",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20043"
      ]
    },
    {
      "uid": "zhcn:21dafd3857a50238e9fb2dc4",
      "kind": "character_system_text",
      "source_text": "外出ですね。",
      "source_fingerprint": "7201a945e63e53717d278e6d3a574b3c742b1fddf8155b902f026e2e6e99280d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20046"
      ]
    },
    {
      "uid": "zhcn:5cab98457b2c9d23ac44ca36",
      "kind": "character_system_text",
      "source_text": "いい風ですね。",
      "source_fingerprint": "d36843ebf2b2c1975f52edcd08e5914805448ce92f4fcab4848d2d51595e74a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20047"
      ]
    },
    {
      "uid": "zhcn:8b5aec146741fcef0a9cf05e",
      "kind": "character_system_text",
      "source_text": "想定通りの結果をおさめることができました。",
      "source_fingerprint": "85e668009703f039307ad9fad55234db4fa864d58f6391f0540c777d2bb004de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20049"
      ]
    },
    {
      "uid": "zhcn:22ffe37fa1b0cb78ae63d224",
      "kind": "character_system_text",
      "source_text": "ここまで導いていただき感謝しております。",
      "source_fingerprint": "c8fd07a7000f90a5156df6bcf493c84524d50e6673fb6782a63d85255f3c556b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20050"
      ]
    },
    {
      "uid": "zhcn:24bb5f480cd1bf8d46046cc2",
      "kind": "character_system_text",
      "source_text": "我会完美地配合。",
      "source_fingerprint": "cb191ad486406858483d5912ad34017a72ff61928209c898888a176070f048a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "20051"
      ]
    },
    {
      "uid": "zhcn:f71414d610c6ece4c8e39304",
      "kind": "character_system_text",
      "source_text": "時間です。",
      "source_fingerprint": "3c2c1bcc72a4ae9f88060fcccb1a351bee84241e14492d09ca0748435672cdc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2030"
      ]
    },
    {
      "uid": "zhcn:896b9158efcafe0ec5afee22",
      "kind": "character_system_text",
      "source_text": "各自、打ち合わせ通りに。",
      "source_fingerprint": "2367b7edfae471eaa9bbd3fe84dd82e102af9a9bbf9780d3f1fe7e583120f017",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2031"
      ]
    },
    {
      "uid": "zhcn:3f6b4c684a6c52eb63a19e3c",
      "kind": "character_system_text",
      "source_text": "ここまで導いていただき感謝しております。",
      "source_fingerprint": "c8fd07a7000f90a5156df6bcf493c84524d50e6673fb6782a63d85255f3c556b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2032"
      ]
    },
    {
      "uid": "zhcn:c96293c0e87e1daeaf90dcb4",
      "kind": "character_system_text",
      "source_text": "日々、努めてきたからこそ、\r\n今言える言葉があります。\r\n必ずやご期待に添ってみせます…！",
      "source_fingerprint": "11df45b1b5e05a9a38e40e27463a39d990f1ad0c156fd8ec0ce78caf6d83c9e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2033"
      ]
    },
    {
      "uid": "zhcn:8b934b38babf7d53970c0ebf",
      "kind": "character_system_text",
      "source_text": "万全を期して、ここに至りました。\r\nあとは実践に挑むのみです。さあ、\r\n私たちの成果を披露しましょう！",
      "source_fingerprint": "a19c1c550ef820053ab2ad83c5f787fa1a853fa8fd3bcb6c41cba73ba4d1ee4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2034"
      ]
    },
    {
      "uid": "zhcn:5c56c407f934c42c21820dce",
      "kind": "character_system_text",
      "source_text": "ここまで導いていただき感謝しております。",
      "source_fingerprint": "c8fd07a7000f90a5156df6bcf493c84524d50e6673fb6782a63d85255f3c556b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "2035"
      ]
    },
    {
      "uid": "zhcn:a25c8caf68b56f411133a235",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b9876a5026bf7840667785b9",
      "kind": "character_system_text",
      "source_text": "あと1歩を超える方法を見出さねば…！",
      "source_fingerprint": "9ecc71a8c3dd773f19cdddd170a5cc8906167f9c396db09f0ace120b7a7f40b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30000"
      ]
    },
    {
      "uid": "zhcn:05fa587dcc6ad128e2f4d8cd",
      "kind": "character_system_text",
      "source_text": "敗因を分析し、次こそ勝ちましょう。",
      "source_fingerprint": "1cea3fe74f976a5ee26ce3ae3ecc648e0c9949eed030fc40aa4f4b4559e828c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30001"
      ]
    },
    {
      "uid": "zhcn:37a0c20fb8a47899e8d8acd2",
      "kind": "character_system_text",
      "source_text": "想定内の結果ではあります、が…。",
      "source_fingerprint": "fbd79c3de52125da1ea115a5ac11282d7de8c2298e142503902d7260ef749ad6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30002"
      ]
    },
    {
      "uid": "zhcn:086475ac4bd4b3640f6dd74e",
      "kind": "character_system_text",
      "source_text": "計画の見直しが必要ですね…。",
      "source_fingerprint": "dba97c2c6a0d692f08702fb33b9e1f94d9488ecb2842e5aa213de5750bf76374",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30003"
      ]
    },
    {
      "uid": "zhcn:ffeed32cbdbb44256215209f",
      "kind": "character_system_text",
      "source_text": "首尾は上々…全て、狙い通りです。",
      "source_fingerprint": "92fa2fb10a229fb1519b68ef1f83f006b7b00b25c4330094d9807105b31990c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30004"
      ]
    },
    {
      "uid": "zhcn:ad290de33e04d44f16de00fa",
      "kind": "character_system_text",
      "source_text": "ふむ、想定通りかと。",
      "source_fingerprint": "791414b3240268619ffd571607f9af4da4b64bdab00f22a884a7c8fd6808888a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "30005"
      ]
    },
    {
      "uid": "zhcn:303c64cdb656e0f1c9a7e762",
      "kind": "character_system_text",
      "source_text": "では、参りましょう。",
      "source_fingerprint": "6d3ba4722e079c2e7404f6e4b444c3e186c3cff49cbce910edc4013df00690fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "31000"
      ]
    },
    {
      "uid": "zhcn:51258e25debbf69347ed95c7",
      "kind": "character_system_text",
      "source_text": "熱く鍛えたのは…この時のためっ！",
      "source_fingerprint": "cd9698f323c4d73b2dfe0c70a1f90669736eac4d99c9ae86672a165fecac82db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "40000"
      ]
    },
    {
      "uid": "zhcn:fe74a51e812d8d77961b4ce1",
      "kind": "character_system_text",
      "source_text": "我想支持大家的干劲……\r\n管理的事项\r\n请全权交给我处理。",
      "source_fingerprint": "68317dec86e5e6d80d8d4143d6edcabdc70b95f1f4e960f52a46c9a477a0198a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400002"
      ]
    },
    {
      "uid": "zhcn:9e6b4b5eb0e933c1f5f270bf",
      "kind": "character_system_text",
      "source_text": "绝不可心急。\r\n维持我们的作风稳扎稳打地……\r\n确实地一一克服吧。",
      "source_fingerprint": "931bf80e2252bcc68ecf209f95d8af59d0297e21a4e015af73f5238b3ecd4c8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400004"
      ]
    },
    {
      "uid": "zhcn:daede4e1a67f59139898efb5",
      "kind": "character_system_text",
      "source_text": "一起全力以赴到最后一刻吧！\r\n希望大家都能获得理想的结果……",
      "source_fingerprint": "63894b75dc4bfbb7b5c317df3d02a57d25f85d5c206c07737ba8462b1dd6fe95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400007"
      ]
    },
    {
      "uid": "zhcn:1d994f01db01bfb89df556bd",
      "kind": "character_system_text",
      "source_text": "熱く鍛えたのは…この時のためっ！",
      "source_fingerprint": "cd9698f323c4d73b2dfe0c70a1f90669736eac4d99c9ae86672a165fecac82db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "40001"
      ]
    },
    {
      "uid": "zhcn:a62bca7145bcc67a123c59b3",
      "kind": "character_system_text",
      "source_text": "真是美好的景色……\r\n想必那个舞台，也会在今后\r\n成为支持着我奔跑的动力吧。",
      "source_fingerprint": "221e7c68705a7b8d036357849528f4de91cf1226e88141db88325c6bbbad6cf5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400011"
      ]
    },
    {
      "uid": "zhcn:6b95d645fee3a8b9577490da",
      "kind": "character_system_text",
      "source_text": "这边是活动任务。\r\n采取稳健的行程来进行吧。",
      "source_fingerprint": "492910b97a68add2a92ef0c7d380a3d887a161042ae211903bb4a017805e16b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400012"
      ]
    },
    {
      "uid": "zhcn:46db86995aa78782d21f84bc",
      "kind": "character_system_text",
      "source_text": "有没有忘记领取的东西？\r\n可以的话，让我与你\r\n一起确认吧。",
      "source_fingerprint": "197a210b2a98763d6a59cbd6b8170927df1b18ba19740b5deb0a19babaaeed82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "400013"
      ]
    },
    {
      "uid": "zhcn:2383cf5ca68ba6ccbd399ff0",
      "kind": "character_system_text",
      "source_text": "ここで決めましょう…！",
      "source_fingerprint": "5c44ed023ab80c6982819380de726ed68b494a79f6ebe0d36143407fe6115504",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "40002"
      ]
    },
    {
      "uid": "zhcn:43e65967312a8c2c7b874ea8",
      "kind": "character_system_text",
      "source_text": "動きはすべて予習済みです。\r\n完璧にこなせるかと。",
      "source_fingerprint": "2db6687ef71b7782c7cf23e5af43106bb2647d089a5817cf001ead0e3db1ccdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "60000"
      ]
    },
    {
      "uid": "zhcn:b745e3fb412019ffc7ca8613",
      "kind": "character_system_text",
      "source_text": "恩返しできるよう、\r\n楽しませますよ！",
      "source_fingerprint": "f34aa6ef7b63356c029418eea55d16eaa6ff8842cb5c0292655026adae4d8e08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "60001"
      ]
    },
    {
      "uid": "zhcn:57a9d6b899e4b2a2cf430b6c",
      "kind": "character_system_text",
      "source_text": "也欢迎咨询管理方面的事情。",
      "source_fingerprint": "189c05300e0f17e40c5b2b1178e1015f1aa39ae4b503a6fe5733fae14c2dab67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70000"
      ]
    },
    {
      "uid": "zhcn:79b2edaec5dda72d942adaf0",
      "kind": "character_system_text",
      "source_text": "これからも私は走っていける…。\r\n貴方との出会いがあったからこそ、\r\nそう言えるのでしょうね。",
      "source_fingerprint": "7b80a6d00fd0efe9bac69f3109f429de9415a78ef0bbccee54b97185fe8a166a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70001"
      ]
    },
    {
      "uid": "zhcn:115ecabdb3c43b01a3e3068b",
      "kind": "character_system_text",
      "source_text": "この無駄のなさ…まさに機能美ですね。",
      "source_fingerprint": "a206419bfec4b7534a020d4341bb465101dd2dc55c8525829726b21c6feb1cbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70004"
      ]
    },
    {
      "uid": "zhcn:0f91b640e84de6948082bd0f",
      "kind": "character_system_text",
      "source_text": "衣装もパフォーマンスの一部。\r\n大切に扱わなければ。",
      "source_fingerprint": "1614ce3d4852f9d2299ed1528076068c0931dbd75a2879946de4748d5c50de63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70008"
      ]
    },
    {
      "uid": "zhcn:7fa2b39c1e0f9425931f616a",
      "kind": "character_system_text",
      "source_text": "長く走り、勝ち続ける…\r\nこの勝負服と共に…！",
      "source_fingerprint": "80a9518f45b43472833916d1e9c3422413f3197851b8618a87fa6ab805f6e575",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70009"
      ]
    },
    {
      "uid": "zhcn:065edeba173c57058b8d1598",
      "kind": "character_system_text",
      "source_text": "摩擦耐性があれば、このまま\r\n自転車にも乗りたいのですが。",
      "source_fingerprint": "cf270a273d40843649899a372a17e464c1cd4d0a9ef0a551d27c89e7206a7949",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70010"
      ]
    },
    {
      "uid": "zhcn:e325d4d80e8bd895f6360a91",
      "kind": "character_system_text",
      "source_text": "表情のレッスンは…不得手ですね。",
      "source_fingerprint": "d1eae3e8964b87de595da2605555053895f36083d4900e9065bba3d41f894594",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70014"
      ]
    },
    {
      "uid": "zhcn:8b58405120911efd7a2f8ebd",
      "kind": "character_system_text",
      "source_text": "これを着ると、\r\n鉄の如く揺るぎない自信に満ちます。",
      "source_fingerprint": "b79123fdab63eb41a6f497ba8c5c721192d6eda150a90d700b4982a2d7547719",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70015"
      ]
    },
    {
      "uid": "zhcn:f907e1020b24b99ee01f3225",
      "kind": "character_system_text",
      "source_text": "なるほど…興味深いですね。",
      "source_fingerprint": "0643b2768379e81277d59c699380c4917b839b6513f672dc9abbfa769bb4d4d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70018"
      ]
    },
    {
      "uid": "zhcn:ee569f4d49e0b3c45c148fe0",
      "kind": "character_system_text",
      "source_text": "着崩れなどしていないでしょうか…？",
      "source_fingerprint": "ed07688e227b23f2f13648e2396b5fcbd6575ed9e8f1b3edcbc7aa4aa2be9d1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "70019"
      ]
    },
    {
      "uid": "zhcn:46babc405dea713ca3bba077",
      "kind": "character_system_text",
      "source_text": "この無駄のなさ…まさに機能美ですね。",
      "source_fingerprint": "a206419bfec4b7534a020d4341bb465101dd2dc55c8525829726b21c6feb1cbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71004"
      ]
    },
    {
      "uid": "zhcn:c53749c1e3be051db05ddebb",
      "kind": "character_system_text",
      "source_text": "衣装もパフォーマンスの一部。\r\n大切に扱わなければ。",
      "source_fingerprint": "1614ce3d4852f9d2299ed1528076068c0931dbd75a2879946de4748d5c50de63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71008"
      ]
    },
    {
      "uid": "zhcn:91b739a2481292fdd2877b4f",
      "kind": "character_system_text",
      "source_text": "長く走り、勝ち続ける…\r\nこの勝負服と共に…！",
      "source_fingerprint": "80a9518f45b43472833916d1e9c3422413f3197851b8618a87fa6ab805f6e575",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71009"
      ]
    },
    {
      "uid": "zhcn:a1f54b499fbe97bb637ffa0d",
      "kind": "character_system_text",
      "source_text": "摩擦耐性があれば、このまま\r\n自転車にも乗りたいのですが。",
      "source_fingerprint": "cf270a273d40843649899a372a17e464c1cd4d0a9ef0a551d27c89e7206a7949",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71010"
      ]
    },
    {
      "uid": "zhcn:d252c482c3b05512febb5b7c",
      "kind": "character_system_text",
      "source_text": "表情のレッスンは…不得手ですね。",
      "source_fingerprint": "d1eae3e8964b87de595da2605555053895f36083d4900e9065bba3d41f894594",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71014"
      ]
    },
    {
      "uid": "zhcn:114e49bbc1728f2c85ed6fec",
      "kind": "character_system_text",
      "source_text": "これを着ると、\r\n鉄の如く揺るぎない自信に満ちます。",
      "source_fingerprint": "b79123fdab63eb41a6f497ba8c5c721192d6eda150a90d700b4982a2d7547719",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71015"
      ]
    },
    {
      "uid": "zhcn:154ad6f188d558c911db57f7",
      "kind": "character_system_text",
      "source_text": "なるほど…興味深いですね。",
      "source_fingerprint": "0643b2768379e81277d59c699380c4917b839b6513f672dc9abbfa769bb4d4d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71018"
      ]
    },
    {
      "uid": "zhcn:9f721966dbecea1d1e3220a5",
      "kind": "character_system_text",
      "source_text": "着崩れなどしていないでしょうか…？",
      "source_fingerprint": "ed07688e227b23f2f13648e2396b5fcbd6575ed9e8f1b3edcbc7aa4aa2be9d1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "71019"
      ]
    },
    {
      "uid": "zhcn:1275f49be78040cb4f00d465",
      "kind": "character_system_text",
      "source_text": "お疲れ様。",
      "source_fingerprint": "85c8a6b2f0abbf065d0569dfd8a4d25d15eb8c8f4eaab1e7871c29f6ec129094",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "80000"
      ]
    },
    {
      "uid": "zhcn:505ea6463a6eb89c27058ffe",
      "kind": "character_system_text",
      "source_text": "本日の予定を机に置いております。\r\nあ、机上に資料が散乱していました\r\nので、用件ごとに分けておきました",
      "source_fingerprint": "b8ec5a3bf464dc2c78ca5e74e26812372d9fe58f90ad5309b312ea91548c6275",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90000"
      ]
    },
    {
      "uid": "zhcn:0c43bc9a7d628a574a07d844",
      "kind": "character_system_text",
      "source_text": "…トレーナーさんの昼食の傾向は\r\n炭水化物に偏っていました。朝食は\r\n野菜を中心にしてみるとよいかと。",
      "source_fingerprint": "9c0e4346f319fa06da22f6d1f0b36b70c34e3eae8861b13fcd971feacd5df669",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90001"
      ]
    },
    {
      "uid": "zhcn:deb4bf70dcddba4348128729",
      "kind": "character_system_text",
      "source_text": "昼休みは教室で仮眠をとろうかと。\r\n休む時は休む…円滑に予定をこなす\r\nにはメリハリが大切ですので。",
      "source_fingerprint": "736f312f3a210c25ef1607737bb1766757d57c131227afc40d6a33c55f596374",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90002"
      ]
    },
    {
      "uid": "zhcn:20bd195bbeef40b4f0aa2d93",
      "kind": "character_system_text",
      "source_text": "また失敗しました…。コツをつかむ\r\nどころかボロボロこぼれてしまう…\r\n難しいですね、ハンバーガーは…。",
      "source_fingerprint": "4507ab31d57846b6ae32064350e0ad771e4e1cf5ddd6a6a351ed0b0998c8f74e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90003"
      ]
    },
    {
      "uid": "zhcn:ef4c14579653ef0e0cffec35",
      "kind": "character_system_text",
      "source_text": "目の下にクマが…睡眠不足は集中、\r\n免疫、思考力を低下させます。仮眠\r\nをとられては？私が起こしますよ。",
      "source_fingerprint": "ee8edb44255378f68e70624d969cb1990bed47516ea4054ff6c14598299e22dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90004"
      ]
    },
    {
      "uid": "zhcn:409d464c14ac5cb2c2f3a097",
      "kind": "character_system_text",
      "source_text": "遅くまで残られてお疲れでしょう。\r\n疲労回復には糖分です。\r\nチョコレートでもいかがですか？",
      "source_fingerprint": "1215474e0bf30f47c3081d1d4a4a8fdb96cd9ed0a570e46c3a78c65f0babc5c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90005"
      ]
    },
    {
      "uid": "zhcn:d6fe34664897b98b522c2c30",
      "kind": "character_system_text",
      "source_text": "春は始まりの季節。私の予定も\r\n全て作成済みです。全体計画の他に\r\nレース、行事などタスク毎のものも",
      "source_fingerprint": "d542faa70b56c194a645dcfe95458956ca0b450e5ad8f4f6b5f53ad6285b44db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90006"
      ]
    },
    {
      "uid": "zhcn:4b203fbf6aced85aec22839c",
      "kind": "character_system_text",
      "source_text": "夏は水分に加え、ミネラルも必須。\r\nスポーツ飲料もいいですが塩分を\r\n豊富に含む梅干しもおすすめです",
      "source_fingerprint": "7d32717c2562d31f3f6839602c4728496c5d8704001b14c571c4de8d630b6676",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90007"
      ]
    },
    {
      "uid": "zhcn:937eaab7ec7d4f49b9fcb9d6",
      "kind": "character_system_text",
      "source_text": "秋は催し物が多い季節。総務委員\r\nとして、生徒と学園の間に入り、\r\nスムーズな運営に努めなければ…！",
      "source_fingerprint": "560026c108fae60665e0dfd0731979907f3fcc094e3641b33826222b1a1657dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90008"
      ]
    },
    {
      "uid": "zhcn:1b0dce19fceb2d70c059dffc",
      "kind": "character_system_text",
      "source_text": "冬のマラソン、おすすめですよ。\r\n私は冷たい空気で頭が冴えるのが\r\n心地よく。健康にもいいですしね。",
      "source_fingerprint": "63f598c664dd918bfd9b9607b8759bb7830e9fc0d78d1bc6d579fe78380f771f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90009"
      ]
    },
    {
      "uid": "zhcn:db8a945849a125d14347d28e",
      "kind": "character_system_text",
      "source_text": "ハッピーバレンタイン、です。",
      "source_fingerprint": "4928b89820dcd257934f26864c868bf6be793128610f5fdcf4bc15a143348f28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "90020"
      ]
    },
    {
      "uid": "zhcn:522df23c205b0a3a28a816f7",
      "kind": "character_system_text",
      "source_text": "ネイチャさんは心が読めるのでは？\r\nあの気づかい力はそうとしか…いえ\r\nそれとも…私がわかりやすい…？",
      "source_fingerprint": "7adf29a2c84d304a205a2b187237b49abee6924b92a329831093f01dd9f19f96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91000"
      ]
    },
    {
      "uid": "zhcn:2128392913fc5d85527cd27f",
      "kind": "character_system_text",
      "source_text": "『ターボはターボ』\r\n…実に、真理をついた発言です。\r\nターボさんから学ぶことは多い。",
      "source_fingerprint": "6b8e59afdd0807b42552095873eb0086b3ab6ac34dfe4ee75150989ab7c197a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91001"
      ]
    },
    {
      "uid": "zhcn:c91ba23e345b8f06506866d8",
      "kind": "character_system_text",
      "source_text": "父の影響で工具の扱いは得意です。\r\nボルトを回す際は最適な大きさの\r\nレンチをすぐに提供いたしますよ。",
      "source_fingerprint": "6955dbeade1cd0b269c8e239efa092f3531c2d162e64a2c7b84fd52ec2061266",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91002"
      ]
    },
    {
      "uid": "zhcn:432e995a42e299e1c313120a",
      "kind": "character_system_text",
      "source_text": "タンホイザさんの前向きさには誰も\r\nが救われています。トラブル時さえ\r\nその慌てぶりで笑顔にしてくれます",
      "source_fingerprint": "1a61a481a3d326b7c00c90fd36c7de2858f87804aa504b4691382977a3d05911",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91003"
      ]
    },
    {
      "uid": "zhcn:d9e957faf361623d4f4fbdb5",
      "kind": "character_system_text",
      "source_text": "私の眠りはとても静かだそうです。\r\n…静かすぎて、マックイーンさんに\r\n呼吸を確認されたこともありました",
      "source_fingerprint": "e8dd01225682cf1400a866469c3fd7f79628e260fdec1b27ead035984db63811",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91004"
      ]
    },
    {
      "uid": "zhcn:496a783b717ef4442c379e7f",
      "kind": "character_system_text",
      "source_text": "完璧なパフォーマンスを提供する。\r\nそれが応援してくれる方々への\r\n何よりの礼になると思うのです。",
      "source_fingerprint": "341d671b6cb196c6debe4ca32a759743dd16864e6be467acca418d7b9b9fa105",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91005"
      ]
    },
    {
      "uid": "zhcn:ec485a1e3fcfa145c209799f",
      "kind": "character_system_text",
      "source_text": "統一衣装で見せる息の合った動きも\r\nライブに求められるもの。常に\r\n全体へ意識を配っておかなければ。",
      "source_fingerprint": "16b92e939c7ff4231c35821b97d471bf27f46dd46eec6ac6946c0b84172ffc13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91006"
      ]
    },
    {
      "uid": "zhcn:a2cf5542c1ba43074473d4c3",
      "kind": "character_system_text",
      "source_text": "体にフィットして、どんな動きを\r\nしても支障がない。スマートで\r\n機能的な勝負服を追究したのです。",
      "source_fingerprint": "9e4d1e731b943c42405f23a7c48cbdf8121758b0d97022a1e49acf5ff8958119",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91007"
      ]
    },
    {
      "uid": "zhcn:4d3ce2409990092db7b173c9",
      "kind": "character_system_text",
      "source_text": "勝負服を着ていると気力が満ちて\r\nくる気がします。自然と胸を張って\r\nしまうような…高揚を覚えるのです",
      "source_fingerprint": "933f112332fcee8cf4ddbec6e96deffdc031f46b68c792d4683b8d90a7f3df0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91008"
      ]
    },
    {
      "uid": "zhcn:9c4714eed6fd9a0a9eaedb0c",
      "kind": "character_system_text",
      "source_text": "かっとばせー！マックイーンさんの\r\n知人の誘いで野球観戦に行くのです\r\nそれで、朝練しながら応援練習を…",
      "source_fingerprint": "56e522dc38e642617d05c10bddb3a99c47df73df673b06495163af63e7ac5255",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91009"
      ]
    },
    {
      "uid": "zhcn:6199fb1af4bab8ba6fecbae8",
      "kind": "character_system_text",
      "source_text": "ターボさんの昼食は栄養が偏り\r\nすぎていて…。絵本は通用しなく\r\nなってきましたし…次は劇…？",
      "source_fingerprint": "490b80e0977d0422238a62326d797317543526c24a4a008d9933efad047612d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91010"
      ]
    },
    {
      "uid": "zhcn:fbe3df0d79dff9f4e8d0015e",
      "kind": "character_system_text",
      "source_text": "夜食…でしたら、おかゆなど消化の\r\nよい物がいいかと。塩分は控えめで\r\n卵を溶いて入れるとなおよいですね",
      "source_fingerprint": "0933ae95be1fbd568a7b56f5f1ff6ead9404a87fe4d351aef6b1a026cd42a722",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1063",
        "91011"
      ]
    }
  ]
}
