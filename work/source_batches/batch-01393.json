        "10018"
      ]
    },
    {
      "uid": "zhcn:7676a9d4bb65581497aa9233",
      "kind": "character_system_text",
      "source_text": "喔，正在举办活动嘛。\r\n全力享受吧！\r\n玩得最高兴的才是赢家嘛！",
      "source_fingerprint": "f61962f96c1e88aaf991c2cfe62c3757d17801db26b385591addf63b165be305",
      "source_path": "character_system_text_dict.json",
      "json_path": [
