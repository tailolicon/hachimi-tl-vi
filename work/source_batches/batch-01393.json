      ]
    },
    {
      "uid": "zhcn:5dbed129f6fff03f343306e5",
      "kind": "character_system_text",
      "source_text": "虽然当时啊！\r\n没能把涡轮的挑战书送到帝王手上！\r\n但这就是所谓的因过得服吧！",
      "source_fingerprint": "3c495df27ad31cbf8b5903c19985b74bdb5aba7dd94aecc298c24808963c7d25",
