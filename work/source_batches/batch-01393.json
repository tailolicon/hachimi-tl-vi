      "kind": "character_system_text",
      "source_text": "这套衣服让涡轮好兴奋呢～\r\n引擎全速运转啦！",
      "source_fingerprint": "a0edfccc7e0c632ec0b3a9bac684ce2b935a8ba73bd90b7ae87dc5366fe79f6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
