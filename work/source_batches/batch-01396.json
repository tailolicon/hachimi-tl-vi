      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "10021"
      ]
    },
    {
      "uid": "zhcn:ee6b86f57e2543c3ab650706",
      "kind": "character_system_text",
      "source_text": "总之衣服的颜色就是要多到爆！\r\n才能喔耶又可爱又超嗨对吧！",
      "source_fingerprint": "54538f97f35dbff44251d0abb626d8d86cb86ea3a3dd8534819b820acfbeac78",
