      "json_path": [
        "1065",
        "10025"
      ]
    },
    {
      "uid": "zhcn:cca338c2dc5f0f689fae8198",
      "kind": "character_system_text",
      "source_text": "超可爱指甲油喔耶☆\r\n这是和善善互挑的\r\n好麻吉色哦♪",
