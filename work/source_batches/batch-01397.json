  "entries": [
    {
      "uid": "zhcn:1f1acf4c6866a4cc49602ee6",
      "kind": "character_system_text",
      "source_text": "啊哈哈！",
      "source_fingerprint": "7990e29ba73adbb25caf3a56bd6650d89178b313c21bbc997967b4db791ccd69",
      "source_path": "character_system_text_dict.json",
