        "1065",
        "2034"
      ]
    },
    {
      "uid": "zhcn:edf85432c70032fc1da12f33",
      "kind": "character_system_text",
      "source_text": "小训训，辛苦啦～！",
      "source_fingerprint": "838fa5f89b99031f70cf4ddeab5e70211a6ddc0f819191b18c443d7076dc6b4c",
