      ]
    },
    {
      "uid": "zhcn:8c98c8d2a8e1ef58a62e7db5",
      "kind": "character_system_text",
      "source_text": "小训训，辛苦啦～！",
      "source_fingerprint": "838fa5f89b99031f70cf4ddeab5e70211a6ddc0f819191b18c443d7076dc6b4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "2032"
      ]
    },
    {
      "uid": "zhcn:d487132228017b53afa7b53a",
      "kind": "character_system_text",
      "source_text": "呜～～感觉整个人静不下来！\r\n该怎么形容？像在舞池里一样？\r\n兴奋期待抖啊抖啊抖～～！",
      "source_fingerprint": "bb583ebb804878fd89102c142238d66adae3d17438e30b8310ef07f7047168b7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
        "2033"
      ]
    },
    {
      "uid": "zhcn:f64ccbf2cff775866daa5072",
      "kind": "character_system_text",
      "source_text": "小训，谢啦！\r\n我现在超认真觉得自己不会输！！",
      "source_fingerprint": "4529edc4112ae3023df1ca8a99119dd62aa77bb368704a9b79d99a75c90624f4",
      "source_path": "character_system_text_dict.json",
