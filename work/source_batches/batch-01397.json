      ]
    },
    {
      "uid": "zhcn:5a79dddfd05e787c68d08b8f",
      "kind": "character_system_text",
      "source_text": "おしゃおしゃ～！",
      "source_fingerprint": "2dee4b8bead40a6756c7c2a15843d328b7bd911b4775dabb730e99b851b54e36",
      "source_path": "character_system_text_dict.json",
      "json_path": [
