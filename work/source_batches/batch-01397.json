        "23015"
      ]
    },
    {
      "uid": "zhcn:64b15653acd03260f4798978",
      "kind": "character_system_text",
      "source_text": "太热血了吧～！",
      "source_fingerprint": "f1371860d4678b25f06b179abdb25d56c4a170d6243b4eb648d03c2485df1934",
      "source_path": "character_system_text_dict.json",
      "json_path": [
