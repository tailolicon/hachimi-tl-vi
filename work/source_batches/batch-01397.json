      ]
    },
    {
      "uid": "zhcn:654cdfa20fe6dbebccd1db0a",
      "kind": "character_system_text",
      "source_text": "还想继续拚下去～～！",
      "source_fingerprint": "57b51ebc34b0de5cbd56ffdedddcbd80a71e2923c096d127e65cc2cdbb7f40de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1065",
