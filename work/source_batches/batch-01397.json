      ]
    },
    {
      "uid": "zhcn:751bd6f0b40566028e05a7de",
      "kind": "character_system_text",
      "source_text": "喔耶～好期待喔☆",
      "source_fingerprint": "0c30405e297f8c043476af97d3e7b5d7fb8f6558e123cef73b41f10b1b907dae",
      "source_path": "character_system_text_dict.json",
