      ]
    },
    {
      "uid": "zhcn:35b09a3dd9669d597e8bc7d5",
      "kind": "character_system_text",
      "source_text": "第一次见到阿训训时，\r\n就觉得「真好笑～！！」这样。\r\n笑死～！",
      "source_fingerprint": "5d4c70a0acbb1fa1704cc3512636b8586e046c3059529ef23565a4123ec89e84",
