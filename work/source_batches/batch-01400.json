      "source_text": "太棒了太棒了！",
      "source_fingerprint": "5a7bdcb9879f34e6df5928a6c049e7f9a2437bd52360507b2a3fb453c63fa221",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
