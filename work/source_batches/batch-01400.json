      ]
    },
    {
      "uid": "zhcn:be45e2f17491e2f2adef1f89",
      "kind": "character_system_text",
      "source_text": "目前的引擎没办法获胜吗！？",
      "source_fingerprint": "22fd0b855a812d26b41a967dfd8a09ab8e367037a5d266848aa8ddef5746be4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
