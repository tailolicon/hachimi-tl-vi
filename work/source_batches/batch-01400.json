      ]
    },
    {
      "uid": "zhcn:e6ea727039e8e5751e7fe82f",
      "kind": "character_system_text",
      "source_text": "好刺激啊！",
      "source_fingerprint": "f3f5f4d594ed53313b82f00f87d680f4b0cbc3f4d3f9fda4c1f517a07fb014bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "140013"
      ]
    },
    {
      "uid": "zhcn:83a7c1fc760e9fa23cb2b21f",
      "kind": "character_system_text",
      "source_text": "奇怪～！？",
      "source_fingerprint": "667dbeda0bba324b9380b2c69977a5beab041d22da12215915c24e3433d8919a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "140014"
      ]
    },
    {
      "uid": "zhcn:41bfaa1dd4a4b90435a8181e",
      "kind": "character_system_text",
      "source_text": "兴奋期待！",
      "source_fingerprint": "6572157daf9e16c4082289da1a3b554142eebc30493aae47889f8ca59b8b28e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "140015"
      ]
    },
    {
      "uid": "zhcn:8fdc88de3bd3ff5254450bcb",
      "kind": "character_system_text",
      "source_text": "欸～训练员！",
      "source_fingerprint": "68d571a47d51283c14ca4499a156ec3422ce8b2bd154fbbff21ed61171f9f3e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "140016"
      ]
    },
    {
      "uid": "zhcn:b796242d708691d6491e4ce1",
      "kind": "character_system_text",
      "source_text": "别逃走啊～！",
      "source_fingerprint": "2d9b9d588fbbad42313853fa785f90fb16f2710ffca670f0f60e9080d25566e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "140017"
      ]
    },
    {
      "uid": "zhcn:7054aded9f79b0b330f74820",
      "kind": "character_system_text",
      "source_text": "吼唷～！",
      "source_fingerprint": "c515123741585eec7deae405f9ecc4fc8c4d4d0d5eb87f2764c1e9bbb7368702",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "140018"
      ]
    },
    {
      "uid": "zhcn:60afde23ac50e8e3a9012687",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个喔！",
      "source_fingerprint": "355b58df670a84c0d92a8b4643c8d2db35bbf767c2d4171b83b3321733fed7bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "15"
      ]
    },
    {
      "uid": "zhcn:6a01c7ca4cbf888529faa7b9",
      "kind": "character_system_text",
      "source_text": "呼哟哟……！涡轮快不行了……！\r\n好、好累啊～呜咿咿……！",
      "source_fingerprint": "523d32eb391fc2ad9d1cc38ecd54b49d71c2f0a4fee8b6bde5601a3907d8a830",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20000"
      ]
    },
    {
      "uid": "zhcn:d8f6f3a00b3ad478248320be",
      "kind": "character_system_text",
      "source_text": "呼……呼……！\r\n涡、涡轮的燃料不足啦……！",
      "source_fingerprint": "6ca478bfb4d8be3e7175d0aed1fdbc98cff39a41e5c942d88a96220f7a070b70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20001"
      ]
    },
    {
      "uid": "zhcn:b42cbd3738bd48d3bc99926d",
      "kind": "character_system_text",
      "source_text": "涡轮引擎的状态绝佳！\r\n把油门踩到底冲吧～！",
      "source_fingerprint": "8e0b580008dc2d702235292974c0aeece2e4ba2595024d5cc0f3beffdab3f720",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20002"
      ]
    },
    {
      "uid": "zhcn:9e1f7776e97701884072077f",
      "kind": "character_system_text",
      "source_text": "轰隆隆！训练员！\r\n你听见状态绝佳的引擎声了吗！？\r\n那是从涡轮体内不断发出来的哦！",
      "source_fingerprint": "4d498dda6709c24612169ca832d3564ffbbc9209d80b8989a5e7721091723764",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20003"
      ]
    },
    {
      "uid": "zhcn:7d2fcbfe0518193b2dce6fc5",
      "kind": "character_system_text",
      "source_text": "今天也充满活力～！\r\n涡轮每一天都要持续变强哦！",
      "source_fingerprint": "bf8475188fb2a8451469a4928791657f71a3b369a6f4872e910a98867bea4b80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20004"
      ]
    },
    {
      "uid": "zhcn:001bb712bf9785eef929c489",
      "kind": "character_system_text",
      "source_text": "因为涡轮兴奋过头，\r\n不小心跑了赛道一圈！\r\n引擎超烫的啦～！",
      "source_fingerprint": "1642ba8ebed54de488b453c3329910539d54da00c9bfeca5672d0e40e599280b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20005"
      ]
    },
    {
      "uid": "zhcn:e8bda3003a151e13b7041a72",
      "kind": "character_system_text",
      "source_text": "涡轮上课时一直很兴奋哦！\r\n因为很期待突破极限的训练！",
      "source_fingerprint": "52e95bc3525458020e7d5e16f6ea02d6d36d1f3dda99bcf32c4221b633accc5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20006"
      ]
    },
    {
      "uid": "zhcn:eff33e35885160d4ae5ce47d",
      "kind": "character_system_text",
      "source_text": "要上啰要上啰～！\r\n大家快被涡轮的跑法吓到吧～！",
      "source_fingerprint": "ee2cd56f22b76b4c64b4310653714d2d92b6702fc9f1a0b072bad7f99e9d0a71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20007"
      ]
    },
    {
      "uid": "zhcn:764e5df8c02471a697eb898d",
      "kind": "character_system_text",
      "source_text": "今天的涡轮也是火力全开！\r\n照理来说应该是这样的……\r\n但引擎却没办法运转啊～",
      "source_fingerprint": "4afcca0588d14e4b8e1cc95788e06c4de7e5903b1621ed0a6534ac89da3513a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20008"
      ]
    },
    {
      "uid": "zhcn:cef6e1a0d5defb710e7b4a08",
      "kind": "character_system_text",
      "source_text": "为什么呢～感觉心情很浮躁……\r\n这样涡轮没有办法狂奔啦～",
      "source_fingerprint": "a2af0ca85ac646bcbc344214e95ba8cf4d5080e6d63f316dc957b44839abd845",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20009"
      ]
    },
    {
      "uid": "zhcn:2dd150247ccf2ef6ef59fbee",
      "kind": "character_system_text",
      "source_text": "涡轮刚刚啊，\r\n在赛道旁边发现一只草蜥。\r\n害我现在一～直很在意它～",
      "source_fingerprint": "f588baee82c30164d8a6bd858d011365af8a1e70007c00133ab45cfecc19de73",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20010"
      ]
    },
    {
      "uid": "zhcn:55fcd76582e80884930242bf",
      "kind": "character_system_text",
      "source_text": "噗咻……涡轮的引擎\r\n没办法发动啦……",
      "source_fingerprint": "200db6439a37d3766a8dde5613cf5b75699dbfbed5de036e5fa128dd7d62e3de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20011"
      ]
    },
    {
      "uid": "zhcn:323e2e7e6f6bc90549de4e4c",
      "kind": "character_system_text",
      "source_text": "唔唔唔……又要参加竞赛啊……！\r\n虽然涡轮喜欢逼近极限的感觉，\r\n但真的没问题吗……？",
      "source_fingerprint": "63a6757528f21e77fbdff1f502e03dd5ea6339ba880bc1fcd9632ac198f87aa8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20021"
      ]
    },
    {
      "uid": "zhcn:f690e54442748e3254f20d49",
      "kind": "character_system_text",
      "source_text": "……不要！涡轮不要再参加竞赛了！\r\n涡轮想要心情畅快地涡轮全开！\r\n这样只能发挥一点点力量啦！",
      "source_fingerprint": "5ca838399c532b585c9415c4d111f843834355aa0ed410e21825fd1f53377cff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20022"
      ]
    },
    {
      "uid": "zhcn:e166c6c325bfd9abf7cffab9",
      "kind": "character_system_text",
      "source_text": "要上啰要上啰要上啰～！\r\n涡轮从头到尾\r\n都要跑在最前头哦！",
      "source_fingerprint": "9b003470ad7de981de4555f10778f16883626a04749c5df18a610a83dbe6731f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20023"
      ]
    },
    {
      "uid": "zhcn:e4a06c53b030ebd494d54b87",
      "kind": "character_system_text",
      "source_text": "哼哼！状态绝佳！\r\n涡轮起跑后就要全力冲刺啰！",
      "source_fingerprint": "2bff849b287c8d30f4aef3680839e7e511ca6ee55b508fea15ea25f672c3d140",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20024"
      ]
    },
    {
      "uid": "zhcn:74f7650309052b730bc59831",
      "kind": "character_system_text",
      "source_text": "不知道能够拉开多少距离呢～？\r\n毕竟涡轮一～定！会大获全胜嘛！",
      "source_fingerprint": "5d2c135c01148b7f4151b2861fae588db7e499f2c3849deab09828876b67603d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20025"
      ]
    },
    {
      "uid": "zhcn:87743673bee6b22c2f1481cb",
      "kind": "character_system_text",
      "source_text": "涡轮会用背影告诉大家！\r\n让大家见识一下\r\n甩开所有人的最强身影！",
      "source_fingerprint": "f4eba9553c5479aa2a53608f96b00d295012249cbac23d7a88af4e11f64f8bf4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d7cb2077230c757345b2edd5",
      "kind": "character_system_text",
      "source_text": "状态不错！在起跑前，\r\n都要维持引擎热度～！",
      "source_fingerprint": "6a1b80c9a3639ba9568d8902822b7519f6e250fda13dd46ee5ae40c8b84531e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20027"
      ]
    },
    {
      "uid": "zhcn:b69b7e51040a405ebe292579",
      "kind": "character_system_text",
      "source_text": "欸欸，拿到第一名要做什么才好？\r\n干脆设立极限全开超爆走杯吧！",
      "source_fingerprint": "cf59cdb982bfdef9fa2020694068cdf98fdab602a372adc66c085ad9dcf4909b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20028"
      ]
    },
    {
      "uid": "zhcn:8b2c2beed0901ec3f79c607e",
      "kind": "character_system_text",
      "source_text": "接下来只要突破极限就好了～！\r\n热血沸腾！热血沸腾起来啦～！",
      "source_fingerprint": "92eb285d820f728ad6c21fa1980ce8a55dee93689c481fde154aacbcd4690f91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20029"
      ]
    },
    {
      "uid": "zhcn:18fb3aecf362af2be8aa2ef3",
      "kind": "character_system_text",
      "source_text": "没有任何的战术！\r\n涡轮要做的只有展现\r\n自己是最快的给大家看！",
      "source_fingerprint": "ca382277e1ff55834f58a3c90eb44de2198ff9cd81773b48c609c4bb5a0b1f84",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20030"
      ]
    },
    {
      "uid": "zhcn:77d9639876aef98e4ec194bd",
      "kind": "character_system_text",
      "source_text": "看好啰！\r\n涡轮引擎所向无敌～！",
      "source_fingerprint": "e62d8bb95f8f13980579e0a60cee669a799d4cc294883448933407dce0e6f2ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20031"
      ]
    },
    {
      "uid": "zhcn:744240ec8dfd252214503392",
      "kind": "character_system_text",
      "source_text": "感觉今天\r\n引擎的状态不太好……\r\n为什么呢……？",
      "source_fingerprint": "a40e98c9229e6ff42052b299fef462a26e0a0a480efab57b2bc09d9d89efca25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4e3f4e544cd728400e89ea08",
      "kind": "character_system_text",
      "source_text": "唔唔唔，好像遇到瓶颈了……\r\n不、不用担心！这样涡轮反而\r\n更有干劲！别担心喔！",
      "source_fingerprint": "e4b56fd6d5ad79ccc381878a1eebcf69c68a9d3bcc4e8435581e767fd1b65f0f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20033"
      ]
    },
    {
      "uid": "zhcn:de49054e1e9b2ad927513efe",
      "kind": "character_system_text",
      "source_text": "如果吃超辣的食物，\r\n会让引擎也跟着点火吗……？\r\n训练员，帮涡轮准备点什么～！",
      "source_fingerprint": "bb6e3d25ef334dd1b5b1e681a315ed91e4e6fc5a640df72a9420f0233e53a897",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20034"
      ]
    },
    {
      "uid": "zhcn:744981384f0d2fb767226406",
      "kind": "character_system_text",
      "source_text": "轰隆隆隆隆……轰隆隆隆隆……\r\n唔唔唔……调整失败了吗！？\r\n……跑、跑一跑就会点火了啦！",
      "source_fingerprint": "cd29253c0a161a3300335fb7f5dd3a34e13dcefcfad8677cfa6e950fb33bc7a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20035"
      ]
    },
    {
      "uid": "zhcn:5b879b73fa6dce0c3baddfbd",
      "kind": "character_system_text",
      "source_text": "噗咻咻……呜呜～\r\n在开始之前就到极限啦……！\r\n不、不过涡轮才不会认输呢！",
      "source_fingerprint": "03bc92722194e9b7955e3e226eab636ae70d29128762ca815c517a6d25dcfbe7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20036"
      ]
    },
    {
      "uid": "zhcn:da85798b3a4b8e30e5a11344",
      "kind": "character_system_text",
      "source_text": "唔呜呜……吼～涡轮要忘掉自己现在\r\n状态很差！只要想着拚尽全力就好！\r\n孤注一掷啦～！",
      "source_fingerprint": "9fe035ee1708775b09df536dbd6cde006adb994f9470d014127d37df2e97901a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20037"
      ]
    },
    {
      "uid": "zhcn:6517a9792fec8f7e0fb9ffd4",
      "kind": "character_system_text",
      "source_text": "要上啰～！",
      "source_fingerprint": "df72dcabf3a602cfc5061a8fae762de8077c5fd9bba0cd97cb95c493bbc395ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20038"
      ]
    },
    {
      "uid": "zhcn:a11769bf4b977d22deacd4c2",
      "kind": "character_system_text",
      "source_text": "开始！",
      "source_fingerprint": "3a1bc8931ce94cb5b2de86270e03f2d4b9a446effa7ceaa56679c173e0781ab6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20039"
      ]
    },
    {
      "uid": "zhcn:1ee69ae8331fc2b1e280e74f",
      "kind": "character_system_text",
      "source_text": "加油！",
      "source_fingerprint": "54ce5981946278daacd326ac0aa9463334476cc4c88beeec688628a4bb2fb3d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20040"
      ]
    },
    {
      "uid": "zhcn:5659de6ac643792c3a59af9a",
      "kind": "character_system_text",
      "source_text": "一百分～！",
      "source_fingerprint": "ac803fec5d5256cefe0dd873a7d7858651e4d91710ad60b6c1fd717abc350322",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20041"
      ]
    },
    {
      "uid": "zhcn:201a7bcfd0b8f7fb833f57fa",
      "kind": "character_system_text",
      "source_text": "哎呀！？",
      "source_fingerprint": "e7523a9e48d63e72f2e050b875720b859401b4fa2c48d277ea7edb9ab7bc4799",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20042"
      ]
    },
    {
      "uid": "zhcn:5f705a3b4a748871930fb308",
      "kind": "character_system_text",
      "source_text": "这是什么？",
      "source_fingerprint": "a9e51f28b7ac3b67b5fa0dece797dcc605957f37f42ca5ce827dc8aaae8d4223",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20043"
      ]
    },
    {
      "uid": "zhcn:981568a9c4f265215acd8212",
      "kind": "character_system_text",
      "source_text": "轰隆、轰隆隆！",
      "source_fingerprint": "2eb7df9264fe5b4b90f87420b78864c5ccdaedf4cdeb0c991642ad0df3dcfdb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20046"
      ]
    },
    {
      "uid": "zhcn:a5e5586c529f748e6802c292",
      "kind": "character_system_text",
      "source_text": "来玩吧来玩吧──！",
      "source_fingerprint": "8e4654aeefc7a4327e001d3229f413d7c1c5ea649e413bfd538a8cd24804d328",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20047"
      ]
    },
    {
      "uid": "zhcn:94e11f597d06296080d48149",
      "kind": "character_system_text",
      "source_text": "一～切都很开心！",
      "source_fingerprint": "11973a39448fa84881883cf648f78b5cd67e8e0c5c0588a0a8c5060396c43978",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20049"
      ]
    },
    {
      "uid": "zhcn:cde12c0e7d18528bc50b6ab6",
      "kind": "character_system_text",
      "source_text": "涡轮尽力了！",
      "source_fingerprint": "a8c1adc14d8964e4d2572bbbc0e8fc924ace8d7aa12161ff4b0c31f80a42e241",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20050"
      ]
    },
    {
      "uid": "zhcn:e376f606e0f5511a3c33bb37",
      "kind": "character_system_text",
      "source_text": "跟上涡轮吧！",
      "source_fingerprint": "a52e30078cc0c0336469ae41d2d1a894ba24b2c637605c28055b46d65cfca68a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "20051"
      ]
    },
    {
      "uid": "zhcn:9441a66ed2a39a416d4ea343",
      "kind": "character_system_text",
      "source_text": "大家一起超越极限吧──！",
      "source_fingerprint": "37ddc9dbc777cf671e5287a33f7b4d9ebec86b29981c289f9b097aa29d56c26c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "2030"
      ]
    },
    {
      "uid": "zhcn:62f09b99a38e2e7f79459bdb",
      "kind": "character_system_text",
      "source_text": "所有人爆速起跑啦──！",
      "source_fingerprint": "63f8eb739efc6eb11ec5a4286b4b9688f58de4b6fd97f71237602ee6ea1bd991",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "2031"
      ]
    },
    {
      "uid": "zhcn:25806e74646491fafce3fdeb",
      "kind": "character_system_text",
      "source_text": "涡轮尽力了！",
      "source_fingerprint": "a8c1adc14d8964e4d2572bbbc0e8fc924ace8d7aa12161ff4b0c31f80a42e241",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "2032"
      ]
    },
    {
      "uid": "zhcn:85af37ac057254b3d53c50fc",
      "kind": "character_system_text",
      "source_text": "欸欸，拿到第一名要做什么才好？\r\n干脆设立极限全开超爆走杯吧！",
      "source_fingerprint": "cf59cdb982bfdef9fa2020694068cdf98fdab602a372adc66c085ad9dcf4909b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "2033"
      ]
    },
    {
      "uid": "zhcn:52130248a3c3effda48123c2",
      "kind": "character_system_text",
      "source_text": "不知道能够拉开多少距离呢～？\r\n毕竟涡轮一～定！会大获全胜嘛！",
      "source_fingerprint": "5d2c135c01148b7f4151b2861fae588db7e499f2c3849deab09828876b67603d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "2034"
      ]
    },
    {
      "uid": "zhcn:df98a3574bc8d13887fd540e",
      "kind": "character_system_text",
      "source_text": "涡轮尽力了！",
      "source_fingerprint": "a8c1adc14d8964e4d2572bbbc0e8fc924ace8d7aa12161ff4b0c31f80a42e241",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "2035"
      ]
    },
    {
      "uid": "zhcn:cbd9cdf27d77f820acc780fa",
      "kind": "character_system_text",
      "source_text": "いっくぞ～！",
      "source_fingerprint": "b1b2408f2b8d0c51f05e6fd3de7693d760d57f05160c6acf1ccd700213669ebe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "23015"
      ]
    },
    {
      "uid": "zhcn:fcff597b0c06872c92367bcc",
      "kind": "character_system_text",
      "source_text": "下次涡轮会甩掉所有人啦！",
      "source_fingerprint": "19ec858d89ea97b0cdd09414b15b77ab667598cf77551ca8e51c11b8c31db5b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
        "30000"
      ]
    },
    {
      "uid": "zhcn:621709059b1d227d1d23bffa",
      "kind": "character_system_text",
      "source_text": "唔唔唔……下次一定一定会赢啦！",
      "source_fingerprint": "aaa01885ce3338df442a3505937d9ec0534dd1f21958fcb3210a495a6445aa83",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1066",
