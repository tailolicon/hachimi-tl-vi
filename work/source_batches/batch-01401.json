      ],
      "json_pointer": "/1068/91221"
    },
    {
      "uid": "zhcn:8347ed08b9ad506e9d9863ba",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "下午的英语课，好像比平时\r\n变得更努力了些！因为我想让外国的观众\r\n也能感受到祭典的气氛！",
      "source_fingerprint": "245c6a0971aa7f9450db5834b39e9c086bca7f301b0bee093777f7e0b09a2a2d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
