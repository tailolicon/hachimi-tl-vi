    },
    {
      "uid": "zhcn:804b50263efc29f72dd358b7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "训练员会因为看到我的笑容而笑……\r\n我觉得这种情谊非常棒！",
      "source_fingerprint": "cc3d1ba879bb1060a3de5977a6a15995b47d7d6d294b675cba2c52616a8a79ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
