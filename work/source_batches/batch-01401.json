    {
      "uid": "zhcn:5da0d0d14370eb03f9bbe37f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然我不像帝王一样厉害……\r\n但只要脚踏实地努力，\r\n一定也能……！",
      "source_fingerprint": "ade7d9c7b619d20b849b600749e3393a4dfda8c8f8896fca56d576b0745cd9dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
