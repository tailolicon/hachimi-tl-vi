    {
      "uid": "zhcn:a4a4f80b93c996a5c805abbc",
      "kind": "character_system_text",
      "source_text": "啊哈哈哈～……",
      "source_fingerprint": "0d7f5275898ccd45c94f085a740fc2265892cdd6387d9810f88845bb939bd091",
      "source_path": "character_system_text_dict.json",
