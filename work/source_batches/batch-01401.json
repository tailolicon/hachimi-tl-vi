      ],
      "json_pointer": "/1068/91216"
    },
    {
      "uid": "zhcn:cbd42d5bf7a9b7a62137f6a3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "唔…好想让小高也一起享受\r\n祭典呀。但她喜欢\r\n安静的地方…那 午睡祭之类的…？",
      "source_fingerprint": "418068ce2bda91d34d7b7ffbdc38c6d595bde30c3fc70aa60976c6627ec93c5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
