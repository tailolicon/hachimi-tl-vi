    {
      "uid": "zhcn:02dbd7b9de766fc33a35be3a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "頑張るぞー！",
      "source_fingerprint": "3dbc2842c3016d019ad3d16ba9de8e7ba512d3802e70bf64467d3af5bee806cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
