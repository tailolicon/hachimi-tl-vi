      ]
    },
    {
      "uid": "zhcn:9a4b5839a6fc7da2f03daf09",
      "kind": "character_system_text",
      "source_text": "呼呼呼",
      "source_fingerprint": "5aa5ca383c2effa4025754ce9afd8e085b9c071a00228ad86a861c9993e2e374",
