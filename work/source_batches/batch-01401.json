      ],
      "json_pointer": "/1068/91222"
    },
    {
      "uid": "zhcn:ff086bfe2cf8b0a2dffc815f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "夜晚的宿舍特别热闹！\r\n尤其是小钻外出远征的时候\r\n真是帮大忙了呢。诶嘿嘿。",
      "source_fingerprint": "0e60e86a35cca552b1032c21b54ee90fd32fb53941196281cb37e1f42a8635a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
