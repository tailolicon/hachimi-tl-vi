    },
    {
      "uid": "zhcn:a9c0feb243cb6e64c661f1bb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我对自己强健的身体很有自信！\r\n所以呢，训练员，你就尽情\r\n严格地锻炼我吧！",
      "source_fingerprint": "ced8d45a86106acbcd513dd04be9d5106fb9af7f6b368e6210c6a3c2e1ca0940",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
