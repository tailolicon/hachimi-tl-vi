    },
    {
      "uid": "zhcn:72153711a1313246c4177c6f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "好～我要全力以赴──！！\r\n……啊，身体太往前倾，\r\n又差点撞到鼻子了……！",
      "source_fingerprint": "20def3d072a59d0c627bc50e61757dfcf4d7468a36155ef13a3e14666eba586b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
