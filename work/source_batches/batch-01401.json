    },
    {
      "uid": "zhcn:a0348920156e0c3334d2a054",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "公主，请由我来守护您！\r\n…开玩笑的！圣蹄祭我出演的\r\n角色是王子殿下，真开心呀♪",
      "source_fingerprint": "1d2dc9877fa88d2a405397af3f4f36d5b169d5796107719924cda912afeb2343",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
