      "source_text": "せっかく着たし！\r\n外遊びにいきたい！",
      "source_fingerprint": "31b9c805d592fdb702ef0ef44bd01ee0e604eea0622321d6edf8e715e09d8210",
      "source_path": "character_system_text_dict.json",
