    },
    {
      "uid": "zhcn:049813612f4c64ccd7bbb5ac",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "做伸展运动时要像鹤一样优雅地\r\n伸展身体……想象是在展开翅膀！\r\n……好！今天也要拜托你了！",
      "source_fingerprint": "a0299f878c357ae7b53a714aec78cfb4aa370419d542e2b6975896ca4752fed9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
