    {
      "uid": "zhcn:19ba2abea5c865ec02a05db3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "打成平手了吗…没想到\r\n会是这样一场激战…！下次的将棋\r\n我会赢过你的，小冠！",
      "source_fingerprint": "e58b614034dd0719d482337d757714b63a5615dcd86416d6f0ac96bae4ced1fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
