    },
    {
      "uid": "zhcn:d023eb88034d99078fbacb73",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "冬天寒冷的空气，总能感觉胸膛在发热。\r\n因为会想起 我想打造成祭典的比赛…\r\n『有马纪念』！",
      "source_fingerprint": "d7bbe291c6e525653ab661a52380ea1866584e0d86ba3b37196b3c3ddc7d2941",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
