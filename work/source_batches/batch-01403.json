    },
    {
      "uid": "zhcn:b45c768f310a42132206ab28",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "了解！",
      "source_fingerprint": "2d80dcf567869b6df59c7fb9863926bbb48adeadf1441ae11d6bbfe42e632e42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
