    },
    {
      "uid": "zhcn:f06432225db97f74984dc2da",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "要上啦！",
      "source_fingerprint": "f5db7fe11fb5ccbaebcaef2bd7bb8466771b67518232630e757aa464e9a929f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
