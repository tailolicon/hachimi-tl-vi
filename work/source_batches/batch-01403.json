    {
      "uid": "zhcn:d7bbd5a6fdcc4bc1a824c5bc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "啊啊～…",
      "source_fingerprint": "c841b0301d3ba2a7985bf8e66771c35eabe282546d205a0379472e831f52eb19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
