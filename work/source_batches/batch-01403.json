    {
      "uid": "zhcn:ca207346256ab5dd63cccc46",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "出发啦！",
      "source_fingerprint": "e614f61077baa5c32c3da74aeeadf26136d27b54dd9da15478f03b2843c04ca3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
