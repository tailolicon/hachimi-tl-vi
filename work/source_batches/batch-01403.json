      ],
      "json_pointer": "/1069/20035"
    },
    {
      "uid": "zhcn:b66141291baf6da77318d66c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这样下去可不行……\n得想想采取怎样的战术比较好……",
      "source_fingerprint": "9b2d21247759d2b53f9941224bee44b38d38aea6e2d6493561cdf16191ab89cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20036"
      ],
      "json_pointer": "/1069/20036"
    },
    {
      "uid": "zhcn:156c41f3f6c1de90cc021a9e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽说『樱叶亦是樱』――\n难道我连樱叶都……\n……呜呜呜……",
      "source_fingerprint": "8b14b0819408c4f57c4fce163dc8eea0b76d93bca20ac358e1c4133ad53bae91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
