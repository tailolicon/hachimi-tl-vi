    {
      "uid": "zhcn:de8d5c76ea01f54a55cb80f6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "啊哇哇哇……唔……",
      "source_fingerprint": "2d1758b003c9faf92c0d13bdd1c1083d28808f385b928784d45e394112a22aba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
