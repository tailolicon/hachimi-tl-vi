    {
      "uid": "zhcn:6c0321dc344cbc9482300a52",
      "kind": "character_system_text",
      "source_text": "祭典不能光用看的！得实际参加！\r\n来吧来吧，我们走！\r\n由我来带领你！",
      "source_fingerprint": "5384ffa9735cd4ea00c6c9d37847713daad6d946890e64b3101c10b9d6e6ee51",
      "source_path": "character_system_text_dict.json",
