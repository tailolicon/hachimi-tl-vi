        "10019"
      ]
    },
    {
      "uid": "zhcn:bb2f43f7c1678e8720f6e2bf",
      "kind": "character_system_text",
      "source_text": "可恶～真不甘心！",
      "source_fingerprint": "8ede380eb14a3cb28508773e94e3bf74bf00b630c6773551666a90eebef5fa6a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "1002"
      ]
    },
    {
      "uid": "zhcn:b78925250a41378bc912151f",
      "kind": "character_system_text",
      "source_text": "赛马娘名鉴的等级\r\n好像提升了！\r\n要去确认看看吗？",
      "source_fingerprint": "d5f40dc1bb185389b5224df78f91a80a75f08affddf18c2782f446a384509fd3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "10021"
      ]
    },
    {
      "uid": "zhcn:c5bd84dd702805639ddef339",
      "kind": "character_system_text",
      "source_text": "我喜欢这袖子上的线条！\r\n红色代表热情，黄色代表幸福！\r\n嘿嘿嘿，很有我的风格吧！",
      "source_fingerprint": "ee4fe82e957a519b173197545fc8e4afa30ca09524b060a38cbe5e7e66aeff2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "10025"
      ]
    },
    {
      "uid": "zhcn:cbd3c65330a095999ced99a2",
      "kind": "character_system_text",
      "source_text": "小钻就算和我交换衣服穿\r\n还是充满高贵气质……\r\n让我觉得好佩服啊！",
      "source_fingerprint": "11b2f7378e41fac37911dcc6e9215ae9d13a8b283753b85dae84bd1af2abdb4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "10026"
      ]
    },
    {
      "uid": "zhcn:85e85a6415f45059d2f2e6b2",
      "kind": "character_system_text",
      "source_text": "小指上的尾戒跟小钻的一模一样喔！\r\n我一定要实现我们两人\r\n对着戒指许下的梦想！",
      "source_fingerprint": "765dc1aa509c5f0211bdae8f3107bfcf27ee51e5a079c9c3f5e7ce4391234a8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "10027"
      ]
    },
    {
      "uid": "zhcn:fdb33c24531680c3856364c9",
      "kind": "character_system_text",
      "source_text": "真是场精彩对决！",
      "source_fingerprint": "8bdabefac4a75e0b335394b36bec7d003edf24fffaf64e0af982376b65c3cb24",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "1003"
      ]
    },
    {
      "uid": "zhcn:6f1bbd024e8237ff31a38565",
      "kind": "character_system_text",
      "source_text": "我赢了！嘿呀！",
      "source_fingerprint": "771079f382897d580d66dd57a2dbae191f2ff8dad6e71ec09b7df2cd08d30a73",
      "source_path": "character_system_text_dict.json",
