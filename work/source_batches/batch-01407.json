    {
      "uid": "zhcn:2d70cd00fd60dcdaaf7e106b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "辛苦了。",
      "source_fingerprint": "2f747fdfd41fdd19d5e6205e2563472ecb3e45190ea9201c283e895272ee13e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
