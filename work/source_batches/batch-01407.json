    {
      "uid": "zhcn:32e192edf799a20b7552c5ab",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "你只需……将你所制定出\r\n最完善的训练项目拿来给我就好。\r\n想必一定能让我满意吧？",
      "source_fingerprint": "2db192c8b8d5ab409d00f38d0ca7f9b738c715e91f01a123a496b95d869bd2bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
