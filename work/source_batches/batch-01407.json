        "1071",
        "10006"
      ],
      "json_pointer": "/1071/10006"
    },
    {
      "uid": "zhcn:8a72088e1dc3aee69190120a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我们能不能给真正的妖怪\n点心呢？他们的感情，意志…\n我很想了解",
      "source_fingerprint": "64b832f313341d2ec362b8960b1c12b4b80aadbf88a32a088cf1412ea91c04b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
