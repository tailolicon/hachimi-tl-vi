    },
    {
      "uid": "zhcn:a18502a7b91125a43ce8ead4",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "你想追求困难的挑战吗？",
      "source_fingerprint": "d7fda1599e573fc31fa02143a2148c7b6e96aff5649cbc294870bbc756bbcdcf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "95005"
      ],
      "json_pointer": "/1070/95005"
    },
    {
      "uid": "zhcn:784c216eb0cd824211ae871b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "要我上场就不会放水喔？",
      "source_fingerprint": "89cb09db568dc77ccdf7461af48fe8d4c28b8a9a80b15ec9710e011beec7fca8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
