    },
    {
      "uid": "zhcn:13fe104fae31c5c39fa4aa47",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "训练员，那个…可以\n陪我一下吗？　\n…这是，给朋友巧克力的练习…",
      "source_fingerprint": "ac49c19d22831c566b5c65a712921dbc3b368b1863cb2573a8a9ea0ea7ae7b84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
