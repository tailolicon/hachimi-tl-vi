    {
      "uid": "zhcn:01f5f11992e8b15c22437e9b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我的前方没有任何阻碍！",
      "source_fingerprint": "413deb63e8d492d7f73f85e21ac47e4d57f59d5c5355d36b58921e9769059898",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
