        "1071",
        "100001"
      ],
      "json_pointer": "/1071/100001"
    },
    {
      "uid": "zhcn:ed02be87d70facb2f0a790bb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "练习结束后，要不要绕个远路？\n昨天和朋友在咖啡厅度过了…\n那一刻如果你也一起度过就好了。",
      "source_fingerprint": "b1e63c2532b9d64fa6830f23374d9c54fe393de60b3b13889fbb3197aebad10e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "10001"
      ],
      "json_pointer": "/1071/10001"
    },
    {
      "uid": "zhcn:21133529135c13acebc033b2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "您的肩膀非常温暖…\n如果能倚靠在这棵树上面的话，\n我好像无论到哪都能振翅高飞。",
      "source_fingerprint": "8d16d2062607f5c6ca3ac493aec966232fd810c1f866e1c8021060bed921edd6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
