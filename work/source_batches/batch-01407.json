    {
      "uid": "zhcn:4dbbc86f825c1948dcff55fd",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "早上是搜集情报的最佳时机。\r\n你也该用原文去了解一下\r\n海外的新闻，知道吗？",
      "source_fingerprint": "da7c44b66c205e5ff16c713b72e0e8b3ce03888ed592670b0b8bb8b034fea940",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
