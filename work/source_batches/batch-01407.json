        "1071",
        "1000"
      ],
      "json_pointer": "/1071/1000"
    },
    {
      "uid": "zhcn:f7390a018ebeab047a51ff6c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "全部都是为了『现在』――这一瞬间\n的光辉。将我与您重叠的觉悟，\n印刻在这条轨道上吧。",
      "source_fingerprint": "2dd00cc05574ae7f271a5bdd2b7ea4be6fd74d6465659bdfa7b12e71518226b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
