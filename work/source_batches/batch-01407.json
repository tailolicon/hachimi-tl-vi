    },
    {
      "uid": "zhcn:66602f6f48b6e13fa49a0fa2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "给您准备了奶奶\n亲手做的点心。想让你\n尝到温暖的味道。",
      "source_fingerprint": "197b70953756be6c450a3f923317bb25e2fea0fe4944fb12211877cff1182a1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
