    },
    {
      "uid": "zhcn:5d9beff069cabc0db44949be",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "是夏季集训的训练资料？\r\n让我看看，拿来参考一下。",
      "source_fingerprint": "45253f14644476a68d43112baae1f377d6456cc2ac01789a4305468533fc2e94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
