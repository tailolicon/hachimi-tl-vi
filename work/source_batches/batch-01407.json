      ],
      "json_pointer": "/1070/95003"
    },
    {
      "uid": "zhcn:7add4d13014a7d995c16700e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "大言不惭？我偏要说！\r\n站在世界顶端的……会是我！",
      "source_fingerprint": "d4ae49ce2307e1a13a7cc012ac2b2a3875db97bc45403d95790c81fefd005ed4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
