  "entries": [
    {
      "uid": "zhcn:e7fc63ef7473c5f28df6584a",
      "kind": "character_system_text",
      "source_text": "一路赛跑到海边！",
      "source_fingerprint": "0814eeb66c73308d63fef478910b89f6ddabe4e36a03d36c27566d9cdb5fd917",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "20047"
      ]
    },
    {
      "uid": "zhcn:d5e286df31695fca4e20eb62",
      "kind": "character_system_text",
      "source_text": "我有让你露出笑容了吗？",
      "source_fingerprint": "f015aee019d86f060d49c8bd17f09ebabbfe0dfd36bf8708247988b287e819e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "20049"
      ]
    },
    {
      "uid": "zhcn:4b5fd0b8d2bd891dae0c99ed",
      "kind": "character_system_text",
      "source_text": "训练员，谢谢你！",
      "source_fingerprint": "95a0d3053061f77d918d4d25ca704cb16a7d195cd4edb3c8dc9cccfb75dfaf21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "20050"
      ]
    },
    {
      "uid": "zhcn:07b6efb008184f1582e71eaf",
      "kind": "character_system_text",
      "source_text": "我们鼓起干劲吧！",
      "source_fingerprint": "a8bdcaea6f0fdfb0f129ea9990ac6e5c40c45bb80c3e89b188f9917ef81acbea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "20051"
      ]
    },
    {
      "uid": "zhcn:89746ea6d16a78d7874df9fe",
      "kind": "character_system_text",
      "source_text": "比赛就是祭典！",
      "source_fingerprint": "1041ceeffb66463507282725f8c0e80850ef0bfefb6ab2a02d2620499caff603",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "2030"
      ]
    },
    {
      "uid": "zhcn:306fb0dcc247f35d9ec5279c",
      "kind": "character_system_text",
      "source_text": "充满气势地前进吧！",
      "source_fingerprint": "ab9d2f93e36d770b5ea897477abbbba0133088c08ba9ff529c239b5e825102c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "2031"
      ]
    },
    {
      "uid": "zhcn:4712f5fdc0156f126973354e",
      "kind": "character_system_text",
      "source_text": "训练员，谢谢你！",
      "source_fingerprint": "95a0d3053061f77d918d4d25ca704cb16a7d195cd4edb3c8dc9cccfb75dfaf21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "2032"
      ]
    },
    {
      "uid": "zhcn:2c99bc8b0bac75c5a86cd162",
      "kind": "character_system_text",
      "source_text": "我会让大家看到我出色的背影，\r\n让爸爸妈妈为我感到骄傲！",
      "source_fingerprint": "58bb70b837a6d71e0860ffacba8cd07d8131a63f746bdeb771d45561819bebac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b2175416e9115919b736b862",
      "kind": "character_system_text",
      "source_text": "啊啊～～啊！！！\r\n很～好，喉咙与身体都状态绝佳！",
      "source_fingerprint": "88a5fc1e2c32c2558a8ea39e9d3808bb3cd6caa6fbca7b2d54d5a58e539ed436",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "2034"
      ]
    },
    {
      "uid": "zhcn:183648a5aa44b3e0873948b1",
      "kind": "character_system_text",
      "source_text": "训练员，谢谢你！",
      "source_fingerprint": "95a0d3053061f77d918d4d25ca704cb16a7d195cd4edb3c8dc9cccfb75dfaf21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "2035"
      ]
    },
    {
      "uid": "zhcn:4bce4967e0184f9c784bd62b",
      "kind": "character_system_text",
      "source_text": "セイヤーーー！！",
      "source_fingerprint": "1fa564b1586ed7bfc4ef3aa91110b59e8df89169665e7df873f382f99b10fb30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "23015"
      ]
    },
    {
      "uid": "zhcn:a19f745dedee00da780b4333",
      "kind": "character_system_text",
      "source_text": "真可惜～！\r\n但这是能让我自豪的成果了！",
      "source_fingerprint": "4bdcece04949aba0ac88de11adc15249e3e760b78aada785137d6988802fec96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f3c7e84da9e1f3ccfe3b82af",
      "kind": "character_system_text",
      "source_text": "下次一定要将胜利的烟火射上天空！",
      "source_fingerprint": "21710ed2c70e9cf9196dfce9cd8d1239b8ef323887e23d2497a256cc2dbf7d80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30001"
      ]
    },
    {
      "uid": "zhcn:aee3f5772a5ee7ee6b7ce9eb",
      "kind": "character_system_text",
      "source_text": "我以自己的方式好好努力过了！",
      "source_fingerprint": "8d7b2d20b330f60080bb8f26e130daf10cbeb3c00a4978d62ff4913e2bb15d4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30002"
      ]
    },
    {
      "uid": "zhcn:7b236bf6a4a23e81dcb253e6",
      "kind": "character_system_text",
      "source_text": "得将这份不甘化作动力才行！",
      "source_fingerprint": "5baf53fdf8e76711de12c135f10abc47673013c7985e783bfc83db9ab763be02",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30003"
      ]
    },
    {
      "uid": "zhcn:8e9660b43ba5406983d4f4be",
      "kind": "character_system_text",
      "source_text": "我要唱出感谢之意！呃、还没啦！",
      "source_fingerprint": "859c88606e65d60f4955b7715af1f5b569a6372e536308f0923fe8d365ce2bda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30004"
      ]
    },
    {
      "uid": "zhcn:e8ecdcf27a5a8853f070d1d8",
      "kind": "character_system_text",
      "source_text": "总有一天要用这双脚带给大家勇气！",
      "source_fingerprint": "7fa7f618c15706abc97c800fdba2439596a0b3a75d8e7bfa9011bb446432bdb5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30005"
      ]
    },
    {
      "uid": "zhcn:42ef64f82631c703aa5fb640",
      "kind": "character_system_text",
      "source_text": "我的灯火，会照亮所有人！",
      "source_fingerprint": "6a3d16fd5bc5829c7dd7cb9bf073185d42e462fd4d93f7f7f574d0adcfd77cd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30006"
      ]
    },
    {
      "uid": "zhcn:2e594733480f9f7c35ec9551",
      "kind": "character_system_text",
      "source_text": "总有一天要用这双脚带给大家勇气！",
      "source_fingerprint": "7fa7f618c15706abc97c800fdba2439596a0b3a75d8e7bfa9011bb446432bdb5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30007"
      ]
    },
    {
      "uid": "zhcn:68b9898c818969ec2e0a3761",
      "kind": "character_system_text",
      "source_text": "あたしがお祭りにしてみせます\r\n…何度だって！",
      "source_fingerprint": "281504b039f71134fb895ae7ebc85ef6c139c6cbae4dc188b0b9d765baf0fdb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30206"
      ]
    },
    {
      "uid": "zhcn:2473377f45581920f2593afb",
      "kind": "character_system_text",
      "source_text": "いつかこの脚で、みんなに勇気を！",
      "source_fingerprint": "9801c3850f3b4a5b717d8f8596048edde3a1132a1f635b5b9f6449565a372ba9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "30207"
      ]
    },
    {
      "uid": "zhcn:d6c1c3266be7d690cac9a7d0",
      "kind": "character_system_text",
      "source_text": "我要继续炒热气氛啰！",
      "source_fingerprint": "378222d4381ff95209faad78772dd372e336935d367224e60a0c23edab5f9f35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "31000"
      ]
    },
    {
      "uid": "zhcn:2bebfdacce812f92239cbe0e",
      "kind": "character_system_text",
      "source_text": "嘿呀喝啊，嘿呀～！",
      "source_fingerprint": "3d257befbc65b89c708366fc9562c1b0503ce53185f32ce6849504338d2e03aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "40000"
      ]
    },
    {
      "uid": "zhcn:2a0e836e2863f36db9ddf8fa",
      "kind": "character_system_text",
      "source_text": "嗯～还剩两个人……不快点决定的话\r\n就要赶不上报名期限了……\r\n得找小钻商量才行！",
      "source_fingerprint": "06a8f7bcd4a353f377a0e1ece4a938c13c943acc8b4fb46909114110b2daaaa9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400000"
      ]
    },
    {
      "uid": "zhcn:7abd24c230afd1d9c6a40b7e",
      "kind": "character_system_text",
      "source_text": "特雷森学园……\r\n一点也不普通！",
      "source_fingerprint": "8244abc35eea758ce3143b5c4573c4f62eadee0247d82734b27d609e70d69eef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400003"
      ]
    },
    {
      "uid": "zhcn:e6fa0dd7d49a1987e2bbe299",
      "kind": "character_system_text",
      "source_text": "才刚入学就遇到接二连三的麻烦！\r\n不过，有朋友在一起\r\n就尽管来吧！",
      "source_fingerprint": "233a625044969ebd880f547eac0417e06a771d2e039c13153ad0db52c79e2ff9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400005"
      ]
    },
    {
      "uid": "zhcn:4ffd1b30af742dc66e5ffa08",
      "kind": "character_system_text",
      "source_text": "有好多难缠的对手……！\r\n呜呜，要不要紧呢？",
      "source_fingerprint": "a2682d48009ee9bb5ce4b698eb9a5269f2e218346e976620a5bc0a88aa6b3fd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400006"
      ]
    },
    {
      "uid": "zhcn:565726a9ce7834a375639c7c",
      "kind": "character_system_text",
      "source_text": "帝王，请你等我吧。\r\n我绝对会在这所学园……\r\n变强的！",
      "source_fingerprint": "b74531796990815825efb71d2a9b65d3cc0a563d01a3ac8a6c8782959a362db7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400009"
      ]
    },
    {
      "uid": "zhcn:340908466d74294f9960a36e",
      "kind": "character_system_text",
      "source_text": "久等了，祭典女孩登场！\r\n容我先冲一步了，嘿呀嘿呀！！",
      "source_fingerprint": "2718a169fe23772de393a576285bdfe66efca7f8f9b151094e74e6035e673c9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "40001"
      ]
    },
    {
      "uid": "zhcn:b82bbb427226692c0a3767c6",
      "kind": "character_system_text",
      "source_text": "新年もよろしくお願いします！\r\n1つの祭りが終わっても、まだまだ\r\nいっぱい祭りを起こしますから！",
      "source_fingerprint": "caa1f59799018edd401ca9b83528d3dd16eeca68c69808093ac4b4a0015396cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400010"
      ]
    },
    {
      "uid": "zhcn:e3b6a65fec1308b7a6b1fbf1",
      "kind": "character_system_text",
      "source_text": "往后的路想必相当艰辛。\r\n不过……有朋友在一起\r\n就尽管来吧！",
      "source_fingerprint": "b5cda7473d87c6fa5ebf910919c3af40130774d96a39413e03d7bf9848f0b55a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400011"
      ]
    },
    {
      "uid": "zhcn:7dc6b1d7574cce8e09db31ad",
      "kind": "character_system_text",
      "source_text": "啊～活动结束了……\r\n不过之后就更让人期待了。\r\n因为有崭新的日子在等着我！",
      "source_fingerprint": "9eb57836c15aec66ea59758b174fddcfd3d58408b5dd71594857998ff3e1fe74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400014"
      ]
    },
    {
      "uid": "zhcn:ba3a5545a3ea4c78cfbeabf5",
      "kind": "character_system_text",
      "source_text": "这场大赛让我学到了很多事！\r\n我会铭记在心，\r\n持续奔跑下去！",
      "source_fingerprint": "6d3052ec9baa4bfa5bcdc6a70d33076d04a94d026fcc1206522ef1425db95c4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400024"
      ]
    },
    {
      "uid": "zhcn:8a4822e053260fd9823baae1",
      "kind": "character_system_text",
      "source_text": "活动辛苦了！\r\n大赛真是太开心了～！\r\n我还想继续跟大家一起跑呢！！",
      "source_fingerprint": "7a18da55f094d9960ce3e48475933dcd57aac37b8802502f3274a208a90fe21a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400025"
      ]
    },
    {
      "uid": "zhcn:0c1becfa89063f5ea93e7714",
      "kind": "character_system_text",
      "source_text": "我会让大家获得幸福！",
      "source_fingerprint": "048c77ffdf8b7d34f5a5da69b535f4555ceb6056c77503db4090f41ec74c21db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "40003"
      ]
    },
    {
      "uid": "zhcn:93380ed92f4b037424b97645",
      "kind": "character_system_text",
      "source_text": "虽然年底非常忙碌，\r\n但我是大家的助人大将！\r\n我会努力执行「神社复活计划」！",
      "source_fingerprint": "e0bdc72f2c1b6dd72edd3f4283f91d7588d2e02b2f2918af019f80d2d56b92a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400035"
      ]
    },
    {
      "uid": "zhcn:368d08cde5db8b9a2e6261bd",
      "kind": "character_system_text",
      "source_text": "赛马娘巫女参拜，终于开始了！\r\n只要和小钻一起，\r\n就一定能成功……！",
      "source_fingerprint": "7e320f29e89fb20d6ac1e9ed8b9f03167ba7e0cfb4c3245f21c098319afc0b5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400038"
      ]
    },
    {
      "uid": "zhcn:2e9ce919e83752c5323ead2c",
      "kind": "character_system_text",
      "source_text": "来祈祷大家能够幸福吧～！\r\n无病无灾！新春万福！新年快乐！",
      "source_fingerprint": "5c2f3cd2c9ce582edaa42bdb3d2e490b36f072249aa01d69b5451d8dab5d4284",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "40004"
      ]
    },
    {
      "uid": "zhcn:9bd8adf1b20ee2ce0eb5f779",
      "kind": "character_system_text",
      "source_text": "「神社复活计划」大获成功！\r\n幸好有鼓起勇气做出改变，\r\n才能迎接最棒的新年。",
      "source_fingerprint": "19c9ce0558f511a822fc59470b924e79075a08bf30639e065b212c1bf2626277",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400041"
      ]
    },
    {
      "uid": "zhcn:1c7373976eda3f40c46cffe5",
      "kind": "character_system_text",
      "source_text": "来てくれてありがとうございます！\r\n気をつけてお帰りくださいね。\r\n今年もよろしくお願いしまーすっ！",
      "source_fingerprint": "aae23a3c473eaaa1d770fd7e89739f308361125eed6c990d84289ff71fbfe8ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "400068"
      ]
    },
    {
      "uid": "zhcn:45080db30877f85092015365",
      "kind": "character_system_text",
      "source_text": "誰よりもきらきらに…！",
      "source_fingerprint": "2bbcf2c3dd05d4748152b18df5ac4715ad245620c69db77054bd1728028f64d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "40203"
      ]
    },
    {
      "uid": "zhcn:7c4f01e72e8dbd61133d3e91",
      "kind": "character_system_text",
      "source_text": "みんなを照らすために、勝ちたい…勝つんだ！\r\nこれが！スターの輝きだぁぁーーーーッ！",
      "source_fingerprint": "aa43e2cab72db47c603f880d77c19f0be8b61e6a9beb349e79e673c13c58f87c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "40204"
      ]
    },
    {
      "uid": "zhcn:90191a5bd2e9f76cdfaa3c8c",
      "kind": "character_system_text",
      "source_text": "頑張るぞー！",
      "source_fingerprint": "3dbc2842c3016d019ad3d16ba9de8e7ba512d3802e70bf64467d3af5bee806cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "410000"
      ]
    },
    {
      "uid": "zhcn:2b7e7e625d38bf0cbaecb3d8",
      "kind": "character_system_text",
      "source_text": "よーしっ！！",
      "source_fingerprint": "f78e0691e1bd6cec962345bcdd606c92efc6b11813116078ed0277e3d6ec7a5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1068",
        "410001"
      ]
    },
    {
      "uid": "zhcn:4384a36c70f0d8d4f8d28a50",
      "kind": "character_system_text",
      "source_text": "やったね！",
