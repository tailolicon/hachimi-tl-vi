    {
      "uid": "zhcn:3dd6ad160c571a157b7d27c9",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我要是不喜欢就不会穿了。",
      "source_fingerprint": "08668d32f027fb88038ea4d3481585f4d11875278c17d9fcdb60d40054d0e7a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
