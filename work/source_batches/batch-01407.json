    {
      "uid": "zhcn:b17599d6469c040d6c935951",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "很好……再来！",
      "source_fingerprint": "9ae622292112ca935e46aa81fdae76d8d7e8ccb20bc3f6b92d0864e6a51494e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
