    {
      "uid": "zhcn:33bdbd70a14b4d8b372aeba7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这片景色不错吧？\r\n……训练员。",
      "source_fingerprint": "7339349a3146647fd0c863489148a2ee00ad379949d4b41d0861642a015daa71",
