        "1071",
        "10000"
      ],
      "json_pointer": "/1071/10000"
    },
    {
      "uid": "zhcn:c0432e3058ab97dfd6691c88",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我出发了。",
      "source_fingerprint": "874e7497e7be8367a4f334f4c7f1d69916bd93469660e8935829876ff0311191",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
