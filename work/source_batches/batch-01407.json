        "1071",
        "10007"
      ],
      "json_pointer": "/1071/10007"
    },
    {
      "uid": "zhcn:c987038df912b0a2f853fc4c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "听说今晚宿舍的圣诞老人\n要到房间来。接待的红茶，\n要怎样准备呢？",
      "source_fingerprint": "8b02b507dc1de477dd6caf07e9107dbf12d90b8735fd0d745e12ac206398f13a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
