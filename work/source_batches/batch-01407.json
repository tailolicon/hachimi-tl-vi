        "92000"
      ],
      "json_pointer": "/1070/92000"
    },
    {
      "uid": "zhcn:7bde659f839accf24d7b7935",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "行くぞ！",
      "source_fingerprint": "3b7d69ab49fc0641e5767000f10585546cf0c7394a41814a45559c8645634a6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "920000"
      ],
      "json_pointer": "/1070/920000"
    },
    {
      "uid": "zhcn:06d1a80a2c27e5f96c34d8b5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "让我听听你的规划吧，「训练员」？\r\n你不必顾虑太多，快说啊？",
      "source_fingerprint": "01c77cc067c2b835e2b37dc107de76d70ce8ca06b3c595638f8d7063d68a7f80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "92001"
      ],
      "json_pointer": "/1070/92001"
    },
    {
      "uid": "zhcn:78e2ab2482cc5a5c8165d886",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "告诉我现在该解决的问题\r\n是什么？每天缜密地完成目标，\r\n不就是实现最终目标的快捷方式吗？",
      "source_fingerprint": "44cf0e2bac397f53044868d6d58c25013ee4020672856a2361f9ac05947c01a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "92002"
      ],
      "json_pointer": "/1070/92002"
    },
    {
      "uid": "zhcn:096fbd4f81edb2bec682ead4",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "没有比训练更直接的东西了。\r\n只要遵循完美的计划，就能得到\r\n想要的结果。哼……还真是有趣呢？",
      "source_fingerprint": "a697b011ca370d1c2223d45cb64fb94bf1cb82ebd7bd33bc1c1af419d7ce0f5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "92003"
      ],
      "json_pointer": "/1070/92003"
    },
    {
      "uid": "zhcn:873c641a286f1906981e4acc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "你自己好好判断什么时候该说话，\r\n什么时候该闭嘴……\r\n期待你的表现啰？小狗。",
      "source_fingerprint": "997cbe80ccf50727935e2f00a775c67c6d6c4120cd6046236e2fbf8d1184058b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "92005"
      ],
      "json_pointer": "/1070/92005"
    },
    {
      "uid": "zhcn:f7a850173423b64e91e9a39c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "每个选择都会创造结果……\r\n要谨慎考虑喔？因为要等到未来\r\n才会知道今天的决定是对是错。",
      "source_fingerprint": "c09939777588b88cadae7626aa2c8ecdc641bb0b72939dc3793addbf84d0c5d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
