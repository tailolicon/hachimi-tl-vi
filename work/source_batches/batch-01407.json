    },
    {
      "uid": "zhcn:beeb2f62bd1d1e41b06f525c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我是天狼星象征，\r\n就陪你玩玩吧。",
      "source_fingerprint": "6337ceb4b3070182fdd1c6e69893851c3c923c0fa98c2c126b816b947f10bf96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
