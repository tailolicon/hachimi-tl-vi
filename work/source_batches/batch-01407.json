      ],
      "json_pointer": "/1071/10005"
    },
    {
      "uid": "zhcn:a03c248913f56cbf5adcbad4",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "一年之中，只有一天。\n牛郎星和织女星刹那的相逢。\n强烈的思念在那一瞬间也会闪耀。",
      "source_fingerprint": "a0690004b60f227485981a56dba0934b8b651fcc0f588aabf90815f6d272e976",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
