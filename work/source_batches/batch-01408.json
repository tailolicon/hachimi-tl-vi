      "kind": "character_system_text",
      "source_text": "一起，同心协力。",
      "source_fingerprint": "0c44e28a283dd94754a2e27e9237df1675bc872829d5c5c7c644904503e66a2f",
      "source_path": "character_system_text_dict.json",
