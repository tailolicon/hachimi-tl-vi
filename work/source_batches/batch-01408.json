  "entries": [
    {
      "uid": "zhcn:1d00c4aa003dd6379b91ce14",
      "kind": "character_system_text",
      "source_text": "承蒙关照的裁缝师傅总是会\n给我带合心意的上等布料……\n嗯，这件衣服也是多亏了他。",
      "source_fingerprint": "a48125c753988885d515d6b2ce3998af5403dbe67cd04ee783c3538246c62165",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "10026"
      ]
    },
    {
      "uid": "zhcn:108205501435062599cb9721",
      "kind": "character_system_text",
      "source_text": "前几天善信邀请我吃了可丽饼……\n呵呵，结果我们俩都把奶油抹到了\n鼻子上……",
      "source_fingerprint": "e04076b1ebdd73ff503f89fffe133608c0e7199cccba144dd479940ee8510c7c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "10027"
      ]
    },
    {
      "uid": "zhcn:379dab70c9f6b531e48faa01",
      "kind": "character_system_text",
      "source_text": "还过得去吧。",
      "source_fingerprint": "ce0029a0b784d725dd04c5eaf1001da52e2a215d8678f32d268832ac14c86cf4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "1003"
      ]
    },
    {
      "uid": "zhcn:b0dac547297d3b403640197a",
      "kind": "character_system_text",
      "source_text": "感谢大家。",
      "source_fingerprint": "c58f37ebed132406638abcab186df2b37eae2c6e35c899538c35b9fb5d1bcaca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "1004"
      ]
    },
    {
      "uid": "zhcn:9aa03d6354e9bae0cdb49894",
      "kind": "character_system_text",
      "source_text": "非常抱歉…",
      "source_fingerprint": "b2b02cb9f4863ecc4c714c082beae5f41a16aa7a9c91cfd24cb1046082082035",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "1005"
      ]
    },
    {
      "uid": "zhcn:addf7bc4be64fb82b0c0015b",
      "kind": "character_system_text",
      "source_text": "还过得去吧。",
      "source_fingerprint": "ce0029a0b784d725dd04c5eaf1001da52e2a215d8678f32d268832ac14c86cf4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "1006"
      ]
    },
    {
      "uid": "zhcn:302298807a77de37fab48d18",
      "kind": "character_system_text",
      "source_text": "这是意外之外的结果呢。",
      "source_fingerprint": "4b5aee9b37a3fe7b29a20bf079fbdb21393d54b59d6b49caef192d8f41d3c706",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1071",
        "1007"
      ]
    },
    {
