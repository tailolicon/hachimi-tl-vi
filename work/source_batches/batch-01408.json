      ]
    },
    {
      "uid": "zhcn:02289b9c24495474120d192e",
      "kind": "character_system_text",
      "source_text": "好激动啊。",
      "source_fingerprint": "73a0e7da97c78707ec66b92ffd0378b42ca6afb43e16f165c6cd08782c21874e",
      "source_path": "character_system_text_dict.json",
