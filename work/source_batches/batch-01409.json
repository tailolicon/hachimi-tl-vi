    },
    {
      "uid": "zhcn:991b055f10653a5d8f8af2f4",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "知己知彼百战不殆。\n要重新审视自己和对手…才行。",
      "source_fingerprint": "3405c39a08edb055bb7c1c67440a91f8e26643ab70b2d539531a90dd08a19825",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
