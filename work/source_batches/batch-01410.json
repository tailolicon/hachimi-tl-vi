      "uid": "zhcn:8fe05da92443d42fa134b9c3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "感觉现在的我，\r\n可以站上任何舞台。",
      "source_fingerprint": "e954e0ded59ac6da0518084ac0044b60b645f32a0e145890ce712429bbd4111d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
