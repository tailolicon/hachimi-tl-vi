      ],
      "json_pointer": "/1072/10005"
    },
    {
      "uid": "zhcn:2f1cdf98eaa3c8006acd89f5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "每年我都会对着银河许下\r\n同一个愿望。\r\n我一定要变得更强……！",
      "source_fingerprint": "63d9dfe337b59d0add09ff7255fc7755bee349f0c08a12d946a605122a4961eb",
