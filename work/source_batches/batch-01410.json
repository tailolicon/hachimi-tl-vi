      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "让这一瞬间的光辉…更加强烈…！",
      "source_fingerprint": "511f200336dd54d8f520c1c2526eee3dc707e7880510290dea41120a77e9d860",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
