    {
      "uid": "zhcn:ec6a2fdeff2aa22b97edc14e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "你领导得相当出色。",
      "source_fingerprint": "1e4a9ef4a8c4a1acd72f3382f8fcb90594ca2b69cea969a76275697394446c8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
