      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "嗯，我是目白阿尔丹。",
      "source_fingerprint": "0d09dd1f70478f1ab8b8e85fc4cbc95816aa4c778e3a7e9fdb4e7423a3e9df09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
