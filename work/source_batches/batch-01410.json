      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "在这个『现在』。\n为了这一瞬间的光辉――！",
      "source_fingerprint": "267027e57d0cecf96c814bec590ee3ea7e2079bccb7011fbcf09bf5bdfeab08d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
