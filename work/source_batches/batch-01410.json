    {
      "uid": "zhcn:9ad818b66b200b91c25673a2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "让我们携手共进──\r\n迈向下一座舞台吧。",
      "source_fingerprint": "f2033673498477694ce606426e779801374566ec9d841680d08263f6b4c61b06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
