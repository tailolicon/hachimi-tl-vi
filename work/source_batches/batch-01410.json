      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "戻りました。",
      "source_fingerprint": "e7cc6951a920e8084573735e4a0908d6d6b34e24b6a55a0aeb4ac698d3b94d9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
