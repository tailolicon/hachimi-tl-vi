    {
      "uid": "zhcn:1d2338204b3fdb7a5dadcde9",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "有股内心雀跃的感觉。",
      "source_fingerprint": "39c4797f861f3f3a823168c0e77e71f9d1294dc30b4017a09d733fdcd62af4c7",
