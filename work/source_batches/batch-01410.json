        "1072",
        "10003"
      ],
      "json_pointer": "/1072/10003"
    },
    {
      "uid": "zhcn:0a87d3d9a6383b2ff5089bbd",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我带着对师父的「情义」制作了\r\n巧克力！不是人情巧克力，而是\r\n情义巧克力……敬请笑纳！！",
      "source_fingerprint": "2e4f0b0e8504653e6780def43afe2ae5fee69cd76d65a0d797cdabc128d1953b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "10004"
      ],
      "json_pointer": "/1072/10004"
    },
    {
      "uid": "zhcn:923128cb3f060fa02b783783",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我、我为了今天准备了\r\n美丽的蔷薇与郁金香！！\r\n请多多指教！！",
      "source_fingerprint": "bd27fdd74a905d5f5d021d51846aec4f72d35ec67d9d9ccb10610e80dfca4714",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
