      ]
    },
    {
      "uid": "zhcn:7ed4380a90a161484d1cfd35",
      "kind": "character_system_text",
      "source_text": "哦……",
      "source_fingerprint": "12a5d2b3593df4ba0e0d2caafe81cae836b2d228218d6c7f726f62dac575d8c9",
      "source_path": "character_system_text_dict.json",
