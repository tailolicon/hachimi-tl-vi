      ]
    },
    {
      "uid": "zhcn:dc79698bf5832a4ddee6fb36",
      "kind": "character_system_text",
      "source_text": "哎呀？",
      "source_fingerprint": "1ffd86181f99bb201430319f3ea81b2a0a385cf1b40520738cae2644fb61703d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140009"
      ]
    },
    {
      "uid": "zhcn:2f13c58ecec624e0e3a099c5",
      "kind": "character_system_text",
      "source_text": "什么？",
      "source_fingerprint": "12a3d75820fc4414b98f3d27daf9918f1ed7624f3f238be344ff606794b30ba3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140010"
      ]
    },
    {
      "uid": "zhcn:4658abfb3bb8bbe963a04773",
      "kind": "character_system_text",
      "source_text": "啊，好可爱……",
      "source_fingerprint": "f8f8b5ddd3bfd834806802bdc75d925eddd4ba65d0febe939198c62fb33d1a16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140011"
      ]
    },
    {
      "uid": "zhcn:b4e366f062f062f0c6c51e1b",
      "kind": "character_system_text",
      "source_text": "一网打尽……！？",
      "source_fingerprint": "913e001c52ec22c185807c67f9abf3cc6f4971d7d79f33c4b4c9fa85b5223bd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140012"
      ]
    },
    {
      "uid": "zhcn:5691f26d5a5dccf564cff72a",
      "kind": "character_system_text",
      "source_text": "什、什么！？",
      "source_fingerprint": "811233ad9f77c125209f657ee49d586ec0c6aca43a0e7bc84aab38ddbfda509c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140013"
      ]
    },
    {
      "uid": "zhcn:e8cb91ae1e9cab70f3f86b18",
      "kind": "character_system_text",
      "source_text": "唔呜！？",
      "source_fingerprint": "f53bdee37b27c8d505ae030c1a2215f55716818a877fdf064536a44afeed4277",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140014"
      ]
    },
    {
      "uid": "zhcn:3cc6dc77fc791900691f5576",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140015"
      ]
    },
    {
      "uid": "zhcn:cc201c10a2cc093e93a97f85",
      "kind": "character_system_text",
      "source_text": "请问怎么了吗？",
      "source_fingerprint": "c40ed3678a968d15bddc83cf062a70ed93af71f796d5b986c4679ba09cab3ccd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140016"
      ]
    },
    {
      "uid": "zhcn:689cf6ec50fdbc2bf5d82bff",
      "kind": "character_system_text",
      "source_text": "诸行无常……",
      "source_fingerprint": "49c6beb8d38a44efb087289a7460c8f09c3e32263e4cb7b1b7d978d1fc790e79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140017"
      ]
    },
    {
      "uid": "zhcn:afc7825f6391e4931b6b3ef5",
      "kind": "character_system_text",
      "source_text": "唔喔！？",
      "source_fingerprint": "782e8141ee32005101cf8f86ae3024976c66796bc0bf56ac16d19c162ea92a2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140018"
      ]
    },
    {
      "uid": "zhcn:8b2f1dbbf8734a7c487afb7b",
      "kind": "character_system_text",
      "source_text": "明天准备了这些奖励。",
      "source_fingerprint": "d2c27cda7f517532fff9e9c27f674c5ae4524a245e793033ec88419e97bbcf23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "15"
      ]
    },
    {
      "uid": "zhcn:f97b3199502f37ec70362dc0",
      "kind": "character_system_text",
      "source_text": "呜……身体好沉重……！\r\n虽然并不熟练，这时候是不是该\r\n刺激穴道以求效果……！？",
      "source_fingerprint": "01ff4e7087b53b5276f52a0b7799588db414306a0b434e85d444aa02a90d5155",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20000"
      ]
    },
    {
      "uid": "zhcn:456845857089ba2898157ea3",
      "kind": "character_system_text",
      "source_text": "干劲可以驱动身体。不过……\r\n若问我是否能发挥万全的效果，\r\n实际上是如何……",
      "source_fingerprint": "da4207a05cdc2571ed06b0d6eb018e751459dddcbef2d8ce5e0acbfcf0275054",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20001"
      ]
    },
    {
      "uid": "zhcn:3bacbf064c1a9da6cf8df500",
      "kind": "character_system_text",
      "source_text": "沸腾……热血沸腾！\r\n普通的训练根本不足以发泄\r\n这股「烈火」般的情绪！",
      "source_fingerprint": "527ce34733b47fd9931ee5b6f4a91b76430e230c3460f36216c8ae9af6ce36f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20002"
      ]
    },
    {
      "uid": "zhcn:6dd86258ed056cf6aa298fcf",
      "kind": "character_system_text",
      "source_text": "向神明敬礼！向训练员敬礼！\r\n喝啊！！请多指教！",
      "source_fingerprint": "7b084e3b1b73ea5a6e0ee53d285cde482e03db4d68caf45a67ffcdcdca66fe57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20003"
      ]
    },
    {
      "uid": "zhcn:9395482fe13cd535afe86eb1",
      "kind": "character_system_text",
      "source_text": "每日的修行是否有意义，\r\n全取决于自身心态影响。\r\n看来今天能来场充实的修行。",
      "source_fingerprint": "09e0d5c7b6691dd2c519b12a8caab60a1b93c49001dc915bc37f6e29da529628",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20004"
      ]
    },
    {
      "uid": "zhcn:7113a5beb62647e0ead68553",
      "kind": "character_system_text",
      "source_text": "我已演练过一遍所有的「形」\r\n顺便兼作放松，准备已万全。",
      "source_fingerprint": "7c235982c81483e483452e398a322b861d9d9f1a1b65186f1bb56586253cdfa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20005"
      ]
    },
    {
      "uid": "zhcn:143fc589db3d3805a79e5205",
      "kind": "character_system_text",
      "source_text": "跑步的「形」也绝非一朝一夕\r\n即可成就。如我有何不完善之处，\r\n敬请不吝指导。",
      "source_fingerprint": "66202ef455d9d4cd6ce995098b53f09f3bb5098d598474dee5a6abf0c9050beb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20006"
      ]
    },
    {
      "uid": "zhcn:3e5c1a3a1d25aff1f2242894",
      "kind": "character_system_text",
      "source_text": "首先将全身的氧气换过一轮。\r\n吸…………吐…………好！",
      "source_fingerprint": "a9d9a20671b3863ff8ceaccdfa74bbca5df9ec96ad45f3b8e9f36dd42caeca6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20007"
      ]
    },
    {
      "uid": "zhcn:a172f0aca4b2857a118a5930",
      "kind": "character_system_text",
      "source_text": "喝啊……喝啊、喝啊、喝啊！！\r\n……我重新提振好精神了。",
      "source_fingerprint": "72b467ce9d76e0e25c29fccd0ff11ca27945124d80713fedb55dc739d627d4af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20008"
      ]
    },
    {
      "uid": "zhcn:e6ada947d3049d1d62fa1672",
      "kind": "character_system_text",
      "source_text": "无法抹去邪念……！\r\n……喝！",
      "source_fingerprint": "1b281155aceae205f4852b15bac56f0696fd8037705ae8b2dcad8cdfc3fa0f39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20009"
      ]
    },
    {
      "uid": "zhcn:f8c34c8a048a43fbbc780662",
      "kind": "character_system_text",
      "source_text": "总觉得难以投入练习……居然无法\r\n控制自己，我真的太不成熟了……",
      "source_fingerprint": "34836dd2494ba11f18435c212339d8d99f6b4aa5daa6fa15fb4d671521bd55de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20010"
      ]
    },
    {
      "uid": "zhcn:9c102a6b1d513b5333e5b5de",
      "kind": "character_system_text",
      "source_text": "喝啊、喝啊、喝哇！\r\n呜……请、请当作没听见！",
      "source_fingerprint": "c3b49ba9bdeaf4cf12c99501b9757ac13d37d95ecd25cf4ae2a23ca00efa58db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20011"
      ]
    },
    {
      "uid": "zhcn:12d9a1af9a71edf44111507f",
      "kind": "character_system_text",
      "source_text": "金刚八重垣流中也有对练一千次的\r\n修行。想起那样的修行，就会觉得\r\n不该因为这点训练就累倒……唔！",
      "source_fingerprint": "b3212a04a4c81e7e67297f168c47d1c81db79d126d7d37a836529a8dec001e8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20021"
      ]
    },
    {
      "uid": "zhcn:2e010f1ec69224fcddd75823",
      "kind": "character_system_text",
      "source_text": "尽管艰辛，灭得心中火自凉……！\r\n这点程度的苦难，\r\n我一定有办法克服……！",
      "source_fingerprint": "5ced8fa4da8b19b55e25f97a9856e681f282ac6cf12be1d205032da6cf71beaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20022"
      ]
    },
    {
      "uid": "zhcn:6d4974054025f54d9f12f7fb",
      "kind": "character_system_text",
      "source_text": "钻研柔之理、以自身记住常理之外的\r\n刚强，刚柔并济正是八重垣流之道。\r\n其真正的价值，现在由我来体现！",
      "source_fingerprint": "d9551ddf6a06142c95a65de8bb0132df5fbb9947ce5c9246244754a477350d85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20023"
      ]
    },
    {
      "uid": "zhcn:5a7dfeaf8cfb8cf9d9ec2e2a",
      "kind": "character_system_text",
      "source_text": "现在我感到十分舒畅……\r\n这就让我亲自展现\r\n「火水合一」的精髓吧。",
      "source_fingerprint": "edd51fff28b3377f7af53da89f9650d1c5153220d5811c8e74f342cf7f9e946c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20024"
      ]
    },
    {
      "uid": "zhcn:555694e3931e676403fc9777",
      "kind": "character_system_text",
      "source_text": "力量涌现……全身彷佛正散发出\r\n源源不绝的斗气！",
      "source_fingerprint": "c4e60095f367617b1b056c0b7ddf205798e9182f3e33d4a7206065c4aa619b93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20025"
      ]
    },
    {
      "uid": "zhcn:14655fad0227e14ce3a5ff08",
      "kind": "character_system_text",
      "source_text": "究竟我是否能够习得\r\n「止水」之心呢？\r\n请让我用今天这场比赛确认吧。",
      "source_fingerprint": "090641d6eff055653429ec6b464b25756fd11e0393ac8b9499167b79508b6a12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20026"
      ]
    },
    {
      "uid": "zhcn:335ad57b92c67ea978c27395",
      "kind": "character_system_text",
      "source_text": "知彼知己，百战不殆。\r\n所以我认为今天\r\n这场决战我绝不会输。",
      "source_fingerprint": "cbb013cbbc46e25f124d1377f183783cd7c92c7a033fbe8c39af82797f60a2c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20027"
      ]
    },
    {
      "uid": "zhcn:254133a880c51706773961ae",
      "kind": "character_system_text",
      "source_text": "向全天下展现平日修行的成果……\r\n换句话说，这也是在展现武艺。\r\n我心中没有任何疑虑！",
      "source_fingerprint": "019d187d7e959211a075736d3d0e3c9358f099deea9a7c0a1ec2b13d602dbe69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20028"
      ]
    },
    {
      "uid": "zhcn:61947e57c2e162b096a58948",
      "kind": "character_system_text",
      "source_text": "人事我已尽力。\r\n接着就只能祈求上天赐予武运了。",
      "source_fingerprint": "fb268cfd8719826742897f80262259959ca3afe50d50279e37c79a0a6e42fbd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20029"
      ]
    },
    {
      "uid": "zhcn:3a2619dc187f5e0d43ef36cf",
      "kind": "character_system_text",
      "source_text": "吸～～吐～～！\r\n……这是金刚八重垣流的呼吸法，\r\n能让心情平静下来。",
      "source_fingerprint": "0abdbfe0024f3487eb99f3661db9a57a217fe5793346228fe86358735389b825",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20030"
      ]
    },
    {
      "uid": "zhcn:bd67b1bf59c4bdbb3c14605b",
      "kind": "character_system_text",
      "source_text": "今日我将会把师父的教导\r\n化为我的血肉，\r\n上场奋力迎战！",
      "source_fingerprint": "8cd5cda5f56d24d41b2f3bf65d277965c1b6e21924d181ad8f304cd688e9ade0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f78e7c776a6734e0d302ae17",
      "kind": "character_system_text",
      "source_text": "这一切都是与自己之间的胜负。\r\n只要拥有坚强的心，\r\n一定能找出胜机……！",
      "source_fingerprint": "364fa7543e9df07186a075ce15b015b2b6d5e866a8127bb641e7212e4098ed99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20032"
      ]
    }
  ]
}
