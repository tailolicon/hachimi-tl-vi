    {
      "uid": "zhcn:ac851de2ef4a5875a1d56ef2",
      "kind": "character_system_text",
      "source_text": "成功了呢！",
      "source_fingerprint": "d4ee343917a8c038770956ff3311b839e41d406f29ddc1913f16d6977e136061",
      "source_path": "character_system_text_dict.json",
