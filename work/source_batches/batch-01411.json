      ]
    },
    {
      "uid": "zhcn:b909d8bc4dcefe48cb9a4fbc",
      "kind": "character_system_text",
      "source_text": "实在是太精彩了……！",
      "source_fingerprint": "4e42109da41e150fce7149965cecba8743c4c365e93548b3502cfb2f922d110a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
