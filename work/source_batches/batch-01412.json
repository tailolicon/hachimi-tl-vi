    {
      "uid": "zhcn:649d9bd3fafb841cea7f096c",
      "kind": "character_system_text",
      "source_text": "唯有深入虎穴，\r\n才能获得难以动摇的极意。\r\n来场有意义的对决吧。",
      "source_fingerprint": "1ee434e373155eb80ef2a8e6bc90723ff7abe5edb6db6f53d96a48db8949ac98",
