{
  "schema_version": 1,
  "batch": 1412,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:f84f693826c83e9525147769",
      "kind": "character_system_text",
      "source_text": "在困境中找出稍纵即逝的生机……\r\n只要克服今日的难关，\r\n我就能变得更强！",
      "source_fingerprint": "d926c4ed35fac354c3aa2a4d8d3941a2cffe9abcd12585ac0de2ea568d7db00b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20033"
      ]
    },
    {
      "uid": "zhcn:040f2de8d3db6cd0526d744a",
      "kind": "character_system_text",
      "source_text": "回想至今日夜的修行的话，\r\n区区这点程度的身体不适……！",
      "source_fingerprint": "bf16d6db15917dc39765488819b3c184d6b7245b66e513d5086ff34e440fbcbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20034"
      ]
    },
    {
      "uid": "zhcn:7abb258217b51da2f4d0044d",
      "kind": "character_system_text",
      "source_text": "无论状况再不佳，\r\n比赛就是比赛……！\r\n只须全力以赴应战！",
      "source_fingerprint": "d291123dbc606c45798f0b4e1faa5089a8214887367dabd24fe735c61146eb8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20035"
      ]
    },
    {
      "uid": "zhcn:9361497b53a7c4b6432daaa2",
      "kind": "character_system_text",
      "source_text": "以背水一战的决心，\r\n瞄准能够起死回生的胜机！",
      "source_fingerprint": "102bb8269e33df0811f2b525869b0ed3fb48f08d8cb86615b7aa3480e5952e86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20036"
      ]
    },
    {
      "uid": "zhcn:39a13e4096fc49a289827cb8",
      "kind": "character_system_text",
      "source_text": "……我办得到吗？\r\n我能在此孤注一掷，\r\n展现全力吗……！？",
      "source_fingerprint": "8551a42940b158a1c540f9a8451f8d2681e82b12f3c17b48e5727b5a236ac49a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20037"
      ]
    },
    {
      "uid": "zhcn:15e05164e96f83e81ac22a3f",
      "kind": "character_system_text",
      "source_text": "喝啊！",
      "source_fingerprint": "087e620e84bddd10660185fb26dd641301ab5430b398073f62fd71099cb4546e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9f7e7ffc5c826eea97adb65a",
      "kind": "character_system_text",
      "source_text": "请多指教！",
      "source_fingerprint": "95345e686a2624db3212f49b882d52b89822b2acf5f23012304ac01721ec5930",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20039"
      ]
    },
    {
      "uid": "zhcn:73609be68bd8ac0afd74b316",
      "kind": "character_system_text",
      "source_text": "出发！",
      "source_fingerprint": "663f67e6d36e16231932887bb1e3eb2db26e1fb205d758f58e5da16072deb3e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20040"
      ]
    },
    {
      "uid": "zhcn:bda95191a51e922b194abddb",
      "kind": "character_system_text",
      "source_text": "文武双全！",
      "source_fingerprint": "d22ee361f852cef98d1fba74027c095851022b67032825fa8007b2ba3445e186",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20041"
      ]
    },
    {
      "uid": "zhcn:e7c8881a96b162e0fd21c4a0",
      "kind": "character_system_text",
      "source_text": "我太大意了！",
      "source_fingerprint": "9aa99c6296ed2e8461566e0b6cefc2a01d71fe6b3f8c61b9da5a052d0137d8a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20042"
      ]
    },
    {
      "uid": "zhcn:1c2a759b8bc68c28d320aa17",
      "kind": "character_system_text",
      "source_text": "尚待磨练……",
      "source_fingerprint": "95261669e436f5a3e7aaf684ffeb92bd6ec75b7a63d816096dcaa1f6ded93311",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f73b459b70da63d01f0fd622",
      "kind": "character_system_text",
      "source_text": "我们出发吧。",
      "source_fingerprint": "c3864e9473832146609b6ca6bdb0b249e490876d8260a714cff7a38028b9d836",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20046"
      ]
    },
    {
      "uid": "zhcn:a717ad61c1098a875abcebf1",
      "kind": "character_system_text",
      "source_text": "踏上战场！",
      "source_fingerprint": "3d10de9cfe2047459dcc2e224676d30441cd197715ad8cf9d92746e98d430a1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20047"
      ]
    },
    {
      "uid": "zhcn:1a0a347cac9a20be60545dea",
      "kind": "character_system_text",
      "source_text": "能有现在的我一切都要感谢师父。",
      "source_fingerprint": "520389aa2056d78e33fa53267d1e45860c9cb82c2507a6df65643ef3f7131e47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20049"
      ]
    },
    {
      "uid": "zhcn:e0e1d1e062db85040d72c954",
      "kind": "character_system_text",
      "source_text": "非常感谢你的引领。",
      "source_fingerprint": "89290aa35a33241b91e14dac18e28805678467acc0533ba3d56ab90e362d9df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20050"
      ]
    },
    {
      "uid": "zhcn:aad9616d0042ecb8164f2add",
      "kind": "character_system_text",
      "source_text": "那就麻烦你陪我完成了！",
      "source_fingerprint": "2cb63afa489c05ef42989b3f3b413f4312096e5e82a6ba63fef03206e5907998",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20051"
      ]
    },
    {
      "uid": "zhcn:38744588e45a7dc3857b44d5",
      "kind": "character_system_text",
      "source_text": "赌上一切！",
      "source_fingerprint": "90df567e96e3ab7406cdfa567da35eb6ce611c0cb82cc5a58f902be9eedf2663",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2030"
      ]
    },
    {
      "uid": "zhcn:ad5133c6e460359d5a6c5136",
      "kind": "character_system_text",
      "source_text": "祝各位武运昌隆！",
      "source_fingerprint": "77ea19800a233f7111106f2c71190f164abc494f4ee78d8269294232c7cbed70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2031"
      ]
    },
    {
      "uid": "zhcn:53c451bf0eeb731eee14a8f2",
      "kind": "character_system_text",
      "source_text": "非常感谢你的引领。",
      "source_fingerprint": "89290aa35a33241b91e14dac18e28805678467acc0533ba3d56ab90e362d9df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2032"
      ]
    },
    {
      "uid": "zhcn:46dcc70e705bb8bfd10b2866",
      "kind": "character_system_text",
      "source_text": "向全天下展现平日修行的成果……\r\n换句话说，这也是在展现武艺。\r\n我心中没有任何疑虑！",
      "source_fingerprint": "019d187d7e959211a075736d3d0e3c9358f099deea9a7c0a1ec2b13d602dbe69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2033"
      ]
    },
    {
      "uid": "zhcn:fdfefb3f115aad79b574ba3b",
      "kind": "character_system_text",
      "source_text": "力量涌现……斗志不断化为\r\n源源不绝的色彩！",
      "source_fingerprint": "f6127c51d0addfc46a10e31827ef17e67218504def1eff4095e29471e7a8c6e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2034"
      ]
    },
    {
      "uid": "zhcn:6f8334f6747e4a01775a19c5",
      "kind": "character_system_text",
      "source_text": "非常感谢你的引领。",
      "source_fingerprint": "89290aa35a33241b91e14dac18e28805678467acc0533ba3d56ab90e362d9df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2035"
      ]
    },
    {
      "uid": "zhcn:232c42452f9ed7ec42088651",
      "kind": "character_system_text",
      "source_text": "押忍！",
      "source_fingerprint": "b9c274116d2e46146710df150b6e70d8474b8cb1fd618ec6360dfc28943b6606",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "23015"
      ]
    },
    {
      "uid": "zhcn:94950e932cbf7cfd6ac7938a",
      "kind": "character_system_text",
      "source_text": "感谢这场有意义的比赛。",
      "source_fingerprint": "294a6d5d1869362536132ede5eb6d0243155fd90225c66d2067d6b01f3ef6744",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30000"
      ]
    },
    {
      "uid": "zhcn:0d8e1b6736741616b0a52410",
      "kind": "character_system_text",
      "source_text": "我的实力还不足啊……得持续精进！",
      "source_fingerprint": "7df26ff724955518094e936609f2ecb5965b9c7508815b1d337eac0a9b9d5638",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30001"
      ]
    },
    {
      "uid": "zhcn:39c0ac61aade82926da380d4",
      "kind": "character_system_text",
      "source_text": "我八重无敌还尚待磨练……",
      "source_fingerprint": "c2ee4a96e52287613ca3e7144f00d46b4b2951a294b138aafc1f5050b1e81c43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30002"
      ]
    },
    {
      "uid": "zhcn:99b6371a1587b05b2ef17a9c",
      "kind": "character_system_text",
      "source_text": "此刻，我只为自己感到羞愧……！",
      "source_fingerprint": "cc1709749f7a88215a9cd9a3196a83b0f29b784ac007bcc17894497b1e3d9438",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30003"
      ]
    },
    {
      "uid": "zhcn:d68d5f9a91ed28dd3fbfad49",
      "kind": "character_system_text",
      "source_text": "冷静并炙热！\r\n这就是「火水合一」的境界！",
      "source_fingerprint": "4393f33bdd2eb647880006761cee9008e188cc4568c1f25d6ddc4f33414aa201",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30004"
      ]
    },
    {
      "uid": "zhcn:e52c300b1cf0a241c21375fa",
      "kind": "character_system_text",
      "source_text": "吸气……喝！！\r\n非常感谢！",
      "source_fingerprint": "12e90a087df6fba74d5eb9eeb2cd55d1876abd9431409f375c4d0e1d1cae9340",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30005"
      ]
    },
    {
      "uid": "zhcn:db83033f9bdbc0f029385189",
      "kind": "character_system_text",
      "source_text": "手強き敵将たち…全員討ち取ったり！",
      "source_fingerprint": "bb86ee904b239515ba8596fefc193f3ce8c78e6dbbf2d86aaba97731e7502190",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30006"
      ]
    },
    {
      "uid": "zhcn:1db39556a3dc4cd7a8e8be5f",
      "kind": "character_system_text",
      "source_text": "スゥゥ～…ハッッ！！\r\nありがとうございました！",
      "source_fingerprint": "0c33578c0f0969e5c1565ff8f61b73a4124a54cdfbb9ee5c5ca7a15c2b3441d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30007"
      ]
    },
    {
      "uid": "zhcn:3d0559e875fe2530f09537ab",
      "kind": "character_system_text",
      "source_text": "上场了！",
      "source_fingerprint": "4fa31a7114beb8c66ef02818ffe46722b8b4861ceec53c89aa95c95386a0cccb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d384c467a8dc635d34fba7fb",
      "kind": "character_system_text",
      "source_text": "熊熊燃烧有如「烈火」……！！",
      "source_fingerprint": "d17db381ff1d272e018db04df1230a18f03a9d19fe14fb0ace736f47d7d42887",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40000"
      ]
    },
    {
      "uid": "zhcn:abd6bf8185e799b19e463d93",
      "kind": "character_system_text",
      "source_text": "無刀取りならば心得がありますが、\r\n今回の競技は敵の刀身に触れては\r\nならぬ決まり。どう動くべきか…？",
      "source_fingerprint": "0330c97c79486fc4ba9db355ca355445fe4f4fee7638253b71c6ba96d86e394a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400000"
      ]
    },
    {
      "uid": "zhcn:c657c48a1dc7ccf574ec329f",
      "kind": "character_system_text",
      "source_text": "不能让大家被我内心的\r\n激情拖累……我必须严以律己，\r\n认真练习！",
      "source_fingerprint": "856d5c1b4f4fb42cdcfd929a0a83509d11f320a300a3c53056ffe834cf8de6f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400004"
      ]
    },
    {
      "uid": "zhcn:de0d94dd2f6668d63a72b52f",
      "kind": "character_system_text",
      "source_text": "ノーリーズンさんとは相部屋なので\r\n長い付き合いになりますが…\r\nいったい、何を考えているのやら！",
      "source_fingerprint": "87e1c7adf292504a12ebb39e68ea0609f625cc774753442ad73f293d35b4d223",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400006"
      ]
    },
    {
      "uid": "zhcn:d26c9c9523801d621e6d009e",
      "kind": "character_system_text",
      "source_text": "我必须胸怀先人们的祈愿，\r\n守护奔驰于当下与未来的，\r\n所有赛马娘的意志才行……！",
      "source_fingerprint": "758ffbbac9403b3a78722af7a687d80ac33e619d7edadae52f79cc2b23f54dcd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400008"
      ]
    },
    {
      "uid": "zhcn:4e93efd843c12331e56e1835",
      "kind": "character_system_text",
      "source_text": "心情常保「止水」境界──但斗志！\r\n要如同「烈火」！！始得光明──",
      "source_fingerprint": "996a7316264743463d80674a4d79deb5294ce7675fecbf0ff6514b2055510483",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40001"
      ]
    },
    {
      "uid": "zhcn:b0d74c9e66462f4c1b9af466",
      "kind": "character_system_text",
      "source_text": "努力は目的にあらず。『勝利』こそ\r\n真の目的。私はもう迷いません。\r\n次はターフで、彼女を倒しに参る！",
      "source_fingerprint": "f33813190c07636820471098b4018aef26890b9682117e086745fcd4546a1389",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400010"
      ]
    },
    {
      "uid": "zhcn:7067d4b72c2008c6316504af",
      "kind": "character_system_text",
      "source_text": "我不会忘记──\r\n「神马驱」让我亲身感受到，\r\n能奔跑在当下是多么值得感谢……！",
      "source_fingerprint": "2b8267b35df6845708f54bfa10e12e89b53e653d2dfa4a7ffe30569e2562e9af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400014"
      ]
    },
    {
      "uid": "zhcn:4f2ce5ea39259927f363cc63",
      "kind": "character_system_text",
      "source_text": "切り捨て御免っ！",
      "source_fingerprint": "05e8126e9aa313e03a4458a4501b42fad77a3a1ef1c1d4623d6f118b32bc5998",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40003"
      ]
    },
    {
      "uid": "zhcn:050ee302f90a036b492c61a0",
      "kind": "character_system_text",
      "source_text": "どんな強敵が相手でも…！私こそが天下無双！\r\n今こそ果たすのです、下剋上を…っ！",
      "source_fingerprint": "323640ace89bb0ed6c5a18b14d1d04c7a0e3bd3957f3a0973239498b0696f327",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40004"
      ]
    },
    {
      "uid": "zhcn:4b25ec791efa7a9f8ea65de2",
      "kind": "character_system_text",
      "source_text": "さあ参りましょう！",
      "source_fingerprint": "590004e8ffe14f36b3327eca3bef963de1493e25ae9652bf658e8484ef981af6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "410000"
      ]
    },
    {
      "uid": "zhcn:dcef8de6caa40c7848de7114",
      "kind": "character_system_text",
      "source_text": "やりました！",
      "source_fingerprint": "f68943765281867e884b65fbd4503ab4cb5caace8b9cf8048fc83331dc9e2403",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "410001"
      ]
    },
    {
      "uid": "zhcn:ab42fea3f27968204b99c83c",
      "kind": "character_system_text",
      "source_text": "よし",
      "source_fingerprint": "9f7de1e4115dc5176ae083086b9d83e2d44b0fb0ec6a4a4edfcdc66547a6678f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "410002"
      ]
    },
    {
      "uid": "zhcn:4da497d59ae9e48ca5aaf4c1",
      "kind": "character_system_text",
      "source_text": "よし",
      "source_fingerprint": "9f7de1e4115dc5176ae083086b9d83e2d44b0fb0ec6a4a4edfcdc66547a6678f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "410003"
      ]
    },
    {
      "uid": "zhcn:52dfe3fd495be2c9ef875a70",
