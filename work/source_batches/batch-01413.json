      "kind": "character_system_text",
      "source_text": "挺厉害的嘛。",
      "source_fingerprint": "7c182ffdaa9c3f1574a08682217ba59ddc30e2eec660580e43b34fe7818e3baf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "140001"
      ]
    },
    {
