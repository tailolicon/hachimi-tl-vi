      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "15"
      ]
    },
    {
      "uid": "zhcn:e9339f03cda995e65651c13b",
      "kind": "character_system_text",
      "source_text": "……啧。\r\n今天要提前结束了。\r\n我状态不太好。",
      "source_fingerprint": "86f6f6491978dc1479597899bd46256d48f30300280736fcebfed31df5b442a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1070",
        "20000"
      ]
    },
    {
