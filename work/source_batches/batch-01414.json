    },
    {
      "uid": "zhcn:72111021ad3d58d791ec63d2",
      "kind": "character_system_text",
      "source_text": "想要我陪你玩吗？小狗。",
      "source_fingerprint": "369a1af9dc0dd35db7556c6256b4345be3f0192bcb8b91e1acc50c280021fa6f",
      "source_path": "character_system_text_dict.json",
