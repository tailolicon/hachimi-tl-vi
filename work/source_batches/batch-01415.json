      "json_path": [
        "1073",
        "30003"
      ]
    },
    {
      "uid": "zhcn:155ae4347f82c4f9e807640f",
      "kind": "character_system_text",
      "source_text": "不气馁、不挫败、不放弃！\r\n这是不断进步得到的结果！！",
