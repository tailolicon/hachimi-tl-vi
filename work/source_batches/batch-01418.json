        "90004"
      ],
      "json_pointer": "/1074/90004"
    },
    {
      "uid": "zhcn:c5ce426f523b2bf7012610a9",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我住在老家时，睡前挑选睡衣\r\n是我每晚的乐趣。\r\n蕾丝睡衣跟丝质睡衣我都很喜欢～",
      "source_fingerprint": "cc8705d189909e40c7bb15cb4b31792f2489f93f3962cb1710a12eaece7e19d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
