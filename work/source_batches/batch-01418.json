        "1074",
        "90016"
      ],
      "json_pointer": "/1074/90016"
    },
    {
      "uid": "zhcn:c4b87e161c16db5304dfcd92",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "プライベートビーチで、フロートに\r\n乗ってまったり浮くのが好きですわ\r\n無人島に着いたこともありますの～",
