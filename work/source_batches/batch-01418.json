        "90001"
      ],
      "json_pointer": "/1074/90001"
    },
    {
      "uid": "zhcn:e9ad7860ae26c333546910ff",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "福来嘴里老是\r\n喊着「菠菜」呢～\r\n所以下次我想送她一些当礼物～♪",
      "source_fingerprint": "9a9c048c24286002e136317d19473b3f796e561dd68f4e027eadb461d79d4508",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
