    },
    {
      "uid": "zhcn:5e2c7e4b91af5d24e488be89",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "每天早上我一张开眼睛就会立刻开窗\r\n尽情沐浴阳光。然后又会\r\n因为太舒服开始想睡～",
      "source_fingerprint": "248159c21f7605ebef6ac086ace4819c529eb1e3c31e63864cfc3a71af6a2adc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
