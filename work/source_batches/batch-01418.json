        "1074",
        "90008"
      ],
      "json_pointer": "/1074/90008"
    },
    {
      "uid": "zhcn:4c2933627f695932a02c58cb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我的妹妹们都很能干～\r\n冬天出门前，她们常拿出\r\n布料将我层层包起来呢～",
      "source_fingerprint": "22cc5de556ec7fbfa40da1bb0a590198f2a586c5618ba33ebd1c3891eb98c90b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1074",
        "90009"
      ],
      "json_pointer": "/1074/90009"
    },
    {
      "uid": "zhcn:14f9ed37c2e8f4d9b4efdcc8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "わたくし、早起きしますのよ～。\r\nツルちゃんさまが、声を枯らして\r\n起こさなくともよいように。",
      "source_fingerprint": "9814fb15bbe8bc8ab32f1f78a7607858d84cf50fd18b61512aac74ccc09eb3a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1074",
        "90010"
      ],
      "json_pointer": "/1074/90010"
    },
    {
      "uid": "zhcn:ad8614df78579cb28013f23e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "あら、トレーナーさまの御髪が～。\r\nふふ、櫛で直して差し上げますわ。\r\nマキちゃんみたいに可愛くしますの",
      "source_fingerprint": "abb02a14805b8f321b88883a47023ec3f7917cebfc253fcd5cfc49519a805caa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
