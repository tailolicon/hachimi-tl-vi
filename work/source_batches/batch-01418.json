        "90007"
      ],
      "json_pointer": "/1074/90007"
    },
    {
      "uid": "zhcn:c3c4622c50376c08068a4cbd",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "翻开从去年就开始阅读的书，\r\n发现里面夹了一片红叶～\r\n这书签是来自去年的礼物呢～",
      "source_fingerprint": "16ff5e1f0cf9ddc69563ac464af0ad35f142d2e9e77298fdc0f3b097424a134c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
