    },
    {
      "uid": "zhcn:f068e9a486cb31020981333d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我正在等待时机喔～\r\n等待自己最能绽放光芒的那一刻。",
      "source_fingerprint": "a4b4cacf68df3935396194ce0d8c5eca6af58c82915b7ea8bcf87a12d19509a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
