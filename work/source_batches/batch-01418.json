        "1074",
        "90005"
      ],
      "json_pointer": "/1074/90005"
    },
    {
      "uid": "zhcn:029821acd22bca9ea5194eca",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "春天，草木与繁花都萌生新芽……\r\n我也该起身走向\r\n那道向往的光芒了～",
      "source_fingerprint": "9ef7bde8fb8b8bf2bb6e47cd6622dc1f79a69fc35bbf3e73098ca718fbe779ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
