      ],
      "json_pointer": "/1074/90011"
    },
    {
      "uid": "zhcn:f58f43c3a7b925554d1b76b7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "ジンジャークッキーを作ると、\r\n型抜きの時には生地がカピカピで\r\n…お手伝い、お願いできますか？",
      "source_fingerprint": "c9cc1ac83e86f184aa53204e3a58decd70bd687761773958fc7fbae19df5feb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
