        "90006"
      ],
      "json_pointer": "/1074/90006"
    },
    {
      "uid": "zhcn:16617eef40f1922c33c3b6b8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "天气炎热时才更适合泡个热水澡，\r\n畅快地流汗～\r\n洗完澡也别忘了喝杯茶喔♪",
      "source_fingerprint": "b967a9757b3e03ab69c3dc801c97fdd462510a96253d535bd9130a1ed20733bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
