{
  "schema_version": 1,
  "batch": 1419,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:9055bfe568f3d1bdc18fb1c6",
      "kind": "character_system_text",
      "source_text": "实在是太精彩了……！",
      "source_fingerprint": "4e42109da41e150fce7149965cecba8743c4c365e93548b3502cfb2f922d110a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140006"
      ]
    },
    {
      "uid": "zhcn:ac851de2ef4a5875a1d56ef2",
      "kind": "character_system_text",
      "source_text": "成功了呢！",
      "source_fingerprint": "d4ee343917a8c038770956ff3311b839e41d406f29ddc1913f16d6977e136061",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140007"
      ]
    },
    {
      "uid": "zhcn:7ed4380a90a161484d1cfd35",
      "kind": "character_system_text",
      "source_text": "哦……",
      "source_fingerprint": "12a5d2b3593df4ba0e0d2caafe81cae836b2d228218d6c7f726f62dac575d8c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140008"
      ]
    },
    {
      "uid": "zhcn:dc79698bf5832a4ddee6fb36",
      "kind": "character_system_text",
      "source_text": "哎呀？",
      "source_fingerprint": "1ffd86181f99bb201430319f3ea81b2a0a385cf1b40520738cae2644fb61703d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140009"
      ]
    },
    {
      "uid": "zhcn:2f13c58ecec624e0e3a099c5",
      "kind": "character_system_text",
      "source_text": "什么？",
      "source_fingerprint": "12a3d75820fc4414b98f3d27daf9918f1ed7624f3f238be344ff606794b30ba3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140010"
      ]
    },
    {
      "uid": "zhcn:4658abfb3bb8bbe963a04773",
      "kind": "character_system_text",
      "source_text": "啊，好可爱……",
      "source_fingerprint": "f8f8b5ddd3bfd834806802bdc75d925eddd4ba65d0febe939198c62fb33d1a16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140011"
      ]
    },
    {
      "uid": "zhcn:b4e366f062f062f0c6c51e1b",
      "kind": "character_system_text",
      "source_text": "一网打尽……！？",
      "source_fingerprint": "913e001c52ec22c185807c67f9abf3cc6f4971d7d79f33c4b4c9fa85b5223bd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140012"
      ]
    },
    {
      "uid": "zhcn:5691f26d5a5dccf564cff72a",
      "kind": "character_system_text",
      "source_text": "什、什么！？",
      "source_fingerprint": "811233ad9f77c125209f657ee49d586ec0c6aca43a0e7bc84aab38ddbfda509c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140013"
      ]
    },
    {
      "uid": "zhcn:e8cb91ae1e9cab70f3f86b18",
      "kind": "character_system_text",
      "source_text": "唔呜！？",
      "source_fingerprint": "f53bdee37b27c8d505ae030c1a2215f55716818a877fdf064536a44afeed4277",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140014"
      ]
    },
    {
      "uid": "zhcn:3cc6dc77fc791900691f5576",
      "kind": "character_system_text",
      "source_text": "唔唔……",
      "source_fingerprint": "1dfb96d163733959e5250b066fab803d16c85e8be2ca2413aca9f44e91be5c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140015"
      ]
    },
    {
      "uid": "zhcn:cc201c10a2cc093e93a97f85",
      "kind": "character_system_text",
      "source_text": "请问怎么了吗？",
      "source_fingerprint": "c40ed3678a968d15bddc83cf062a70ed93af71f796d5b986c4679ba09cab3ccd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140016"
      ]
    },
    {
      "uid": "zhcn:689cf6ec50fdbc2bf5d82bff",
      "kind": "character_system_text",
      "source_text": "诸行无常……",
      "source_fingerprint": "49c6beb8d38a44efb087289a7460c8f09c3e32263e4cb7b1b7d978d1fc790e79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140017"
      ]
    },
    {
      "uid": "zhcn:afc7825f6391e4931b6b3ef5",
      "kind": "character_system_text",
      "source_text": "唔喔！？",
      "source_fingerprint": "782e8141ee32005101cf8f86ae3024976c66796bc0bf56ac16d19c162ea92a2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "140018"
      ]
    },
    {
      "uid": "zhcn:8b2f1dbbf8734a7c487afb7b",
      "kind": "character_system_text",
      "source_text": "明天准备了这些奖励。",
      "source_fingerprint": "d2c27cda7f517532fff9e9c27f674c5ae4524a245e793033ec88419e97bbcf23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "15"
      ]
    },
    {
      "uid": "zhcn:f97b3199502f37ec70362dc0",
      "kind": "character_system_text",
      "source_text": "呜……身体好沉重……！\r\n虽然并不熟练，这时候是不是该\r\n刺激穴道以求效果……！？",
      "source_fingerprint": "01ff4e7087b53b5276f52a0b7799588db414306a0b434e85d444aa02a90d5155",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20000"
      ]
    },
    {
      "uid": "zhcn:456845857089ba2898157ea3",
      "kind": "character_system_text",
      "source_text": "干劲可以驱动身体。不过……\r\n若问我是否能发挥万全的效果，\r\n实际上是如何……",
      "source_fingerprint": "da4207a05cdc2571ed06b0d6eb018e751459dddcbef2d8ce5e0acbfcf0275054",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20001"
      ]
    },
    {
      "uid": "zhcn:3bacbf064c1a9da6cf8df500",
      "kind": "character_system_text",
      "source_text": "沸腾……热血沸腾！\r\n普通的训练根本不足以发泄\r\n这股「烈火」般的情绪！",
      "source_fingerprint": "527ce34733b47fd9931ee5b6f4a91b76430e230c3460f36216c8ae9af6ce36f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20002"
      ]
    },
    {
      "uid": "zhcn:6dd86258ed056cf6aa298fcf",
      "kind": "character_system_text",
      "source_text": "向神明敬礼！向训练员敬礼！\r\n喝啊！！请多指教！",
      "source_fingerprint": "7b084e3b1b73ea5a6e0ee53d285cde482e03db4d68caf45a67ffcdcdca66fe57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20003"
      ]
    },
    {
      "uid": "zhcn:9395482fe13cd535afe86eb1",
      "kind": "character_system_text",
      "source_text": "每日的修行是否有意义，\r\n全取决于自身心态影响。\r\n看来今天能来场充实的修行。",
      "source_fingerprint": "09e0d5c7b6691dd2c519b12a8caab60a1b93c49001dc915bc37f6e29da529628",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20004"
      ]
    },
    {
      "uid": "zhcn:7113a5beb62647e0ead68553",
      "kind": "character_system_text",
      "source_text": "我已演练过一遍所有的「形」\r\n顺便兼作放松，准备已万全。",
      "source_fingerprint": "7c235982c81483e483452e398a322b861d9d9f1a1b65186f1bb56586253cdfa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20005"
      ]
    },
    {
      "uid": "zhcn:143fc589db3d3805a79e5205",
      "kind": "character_system_text",
      "source_text": "跑步的「形」也绝非一朝一夕\r\n即可成就。如我有何不完善之处，\r\n敬请不吝指导。",
      "source_fingerprint": "66202ef455d9d4cd6ce995098b53f09f3bb5098d598474dee5a6abf0c9050beb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20006"
      ]
    },
    {
      "uid": "zhcn:3e5c1a3a1d25aff1f2242894",
      "kind": "character_system_text",
      "source_text": "首先将全身的氧气换过一轮。\r\n吸…………吐…………好！",
      "source_fingerprint": "a9d9a20671b3863ff8ceaccdfa74bbca5df9ec96ad45f3b8e9f36dd42caeca6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20007"
      ]
    },
    {
      "uid": "zhcn:a172f0aca4b2857a118a5930",
      "kind": "character_system_text",
      "source_text": "喝啊……喝啊、喝啊、喝啊！！\r\n……我重新提振好精神了。",
      "source_fingerprint": "72b467ce9d76e0e25c29fccd0ff11ca27945124d80713fedb55dc739d627d4af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20008"
      ]
    },
    {
      "uid": "zhcn:e6ada947d3049d1d62fa1672",
      "kind": "character_system_text",
      "source_text": "无法抹去邪念……！\r\n……喝！",
      "source_fingerprint": "1b281155aceae205f4852b15bac56f0696fd8037705ae8b2dcad8cdfc3fa0f39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20009"
      ]
    },
    {
      "uid": "zhcn:f8c34c8a048a43fbbc780662",
      "kind": "character_system_text",
      "source_text": "总觉得难以投入练习……居然无法\r\n控制自己，我真的太不成熟了……",
      "source_fingerprint": "34836dd2494ba11f18435c212339d8d99f6b4aa5daa6fa15fb4d671521bd55de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20010"
      ]
    },
    {
      "uid": "zhcn:9c102a6b1d513b5333e5b5de",
      "kind": "character_system_text",
      "source_text": "喝啊、喝啊、喝哇！\r\n呜……请、请当作没听见！",
      "source_fingerprint": "c3b49ba9bdeaf4cf12c99501b9757ac13d37d95ecd25cf4ae2a23ca00efa58db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20011"
      ]
    },
    {
      "uid": "zhcn:12d9a1af9a71edf44111507f",
      "kind": "character_system_text",
      "source_text": "金刚八重垣流中也有对练一千次的\r\n修行。想起那样的修行，就会觉得\r\n不该因为这点训练就累倒……唔！",
      "source_fingerprint": "b3212a04a4c81e7e67297f168c47d1c81db79d126d7d37a836529a8dec001e8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20021"
      ]
    },
    {
      "uid": "zhcn:2e010f1ec69224fcddd75823",
      "kind": "character_system_text",
      "source_text": "尽管艰辛，灭得心中火自凉……！\r\n这点程度的苦难，\r\n我一定有办法克服……！",
      "source_fingerprint": "5ced8fa4da8b19b55e25f97a9856e681f282ac6cf12be1d205032da6cf71beaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20022"
      ]
    },
    {
      "uid": "zhcn:6d4974054025f54d9f12f7fb",
      "kind": "character_system_text",
      "source_text": "钻研柔之理、以自身记住常理之外的\r\n刚强，刚柔并济正是八重垣流之道。\r\n其真正的价值，现在由我来体现！",
      "source_fingerprint": "d9551ddf6a06142c95a65de8bb0132df5fbb9947ce5c9246244754a477350d85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20023"
      ]
    },
    {
      "uid": "zhcn:5a7dfeaf8cfb8cf9d9ec2e2a",
      "kind": "character_system_text",
      "source_text": "现在我感到十分舒畅……\r\n这就让我亲自展现\r\n「火水合一」的精髓吧。",
      "source_fingerprint": "edd51fff28b3377f7af53da89f9650d1c5153220d5811c8e74f342cf7f9e946c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20024"
      ]
    },
    {
      "uid": "zhcn:555694e3931e676403fc9777",
      "kind": "character_system_text",
      "source_text": "力量涌现……全身彷佛正散发出\r\n源源不绝的斗气！",
      "source_fingerprint": "c4e60095f367617b1b056c0b7ddf205798e9182f3e33d4a7206065c4aa619b93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20025"
      ]
    },
    {
      "uid": "zhcn:14655fad0227e14ce3a5ff08",
      "kind": "character_system_text",
      "source_text": "究竟我是否能够习得\r\n「止水」之心呢？\r\n请让我用今天这场比赛确认吧。",
      "source_fingerprint": "090641d6eff055653429ec6b464b25756fd11e0393ac8b9499167b79508b6a12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20026"
      ]
    },
    {
      "uid": "zhcn:335ad57b92c67ea978c27395",
      "kind": "character_system_text",
      "source_text": "知彼知己，百战不殆。\r\n所以我认为今天\r\n这场决战我绝不会输。",
      "source_fingerprint": "cbb013cbbc46e25f124d1377f183783cd7c92c7a033fbe8c39af82797f60a2c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20027"
      ]
    },
    {
      "uid": "zhcn:254133a880c51706773961ae",
      "kind": "character_system_text",
      "source_text": "向全天下展现平日修行的成果……\r\n换句话说，这也是在展现武艺。\r\n我心中没有任何疑虑！",
      "source_fingerprint": "019d187d7e959211a075736d3d0e3c9358f099deea9a7c0a1ec2b13d602dbe69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20028"
      ]
    },
    {
      "uid": "zhcn:61947e57c2e162b096a58948",
      "kind": "character_system_text",
      "source_text": "人事我已尽力。\r\n接着就只能祈求上天赐予武运了。",
      "source_fingerprint": "fb268cfd8719826742897f80262259959ca3afe50d50279e37c79a0a6e42fbd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20029"
      ]
    },
    {
      "uid": "zhcn:3a2619dc187f5e0d43ef36cf",
      "kind": "character_system_text",
      "source_text": "吸～～吐～～！\r\n……这是金刚八重垣流的呼吸法，\r\n能让心情平静下来。",
      "source_fingerprint": "0abdbfe0024f3487eb99f3661db9a57a217fe5793346228fe86358735389b825",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20030"
      ]
    },
    {
      "uid": "zhcn:bd67b1bf59c4bdbb3c14605b",
      "kind": "character_system_text",
      "source_text": "今日我将会把师父的教导\r\n化为我的血肉，\r\n上场奋力迎战！",
      "source_fingerprint": "8cd5cda5f56d24d41b2f3bf65d277965c1b6e21924d181ad8f304cd688e9ade0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f78e7c776a6734e0d302ae17",
      "kind": "character_system_text",
      "source_text": "这一切都是与自己之间的胜负。\r\n只要拥有坚强的心，\r\n一定能找出胜机……！",
      "source_fingerprint": "364fa7543e9df07186a075ce15b015b2b6d5e866a8127bb641e7212e4098ed99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20032"
      ]
    },
    {
      "uid": "zhcn:f84f693826c83e9525147769",
      "kind": "character_system_text",
      "source_text": "在困境中找出稍纵即逝的生机……\r\n只要克服今日的难关，\r\n我就能变得更强！",
      "source_fingerprint": "d926c4ed35fac354c3aa2a4d8d3941a2cffe9abcd12585ac0de2ea568d7db00b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20033"
      ]
    },
    {
      "uid": "zhcn:040f2de8d3db6cd0526d744a",
      "kind": "character_system_text",
      "source_text": "回想至今日夜的修行的话，\r\n区区这点程度的身体不适……！",
      "source_fingerprint": "bf16d6db15917dc39765488819b3c184d6b7245b66e513d5086ff34e440fbcbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20034"
      ]
    },
    {
      "uid": "zhcn:7abb258217b51da2f4d0044d",
      "kind": "character_system_text",
      "source_text": "无论状况再不佳，\r\n比赛就是比赛……！\r\n只须全力以赴应战！",
      "source_fingerprint": "d291123dbc606c45798f0b4e1faa5089a8214887367dabd24fe735c61146eb8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20035"
      ]
    },
    {
      "uid": "zhcn:9361497b53a7c4b6432daaa2",
      "kind": "character_system_text",
      "source_text": "以背水一战的决心，\r\n瞄准能够起死回生的胜机！",
      "source_fingerprint": "102bb8269e33df0811f2b525869b0ed3fb48f08d8cb86615b7aa3480e5952e86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20036"
      ]
    },
    {
      "uid": "zhcn:39a13e4096fc49a289827cb8",
      "kind": "character_system_text",
      "source_text": "……我办得到吗？\r\n我能在此孤注一掷，\r\n展现全力吗……！？",
      "source_fingerprint": "8551a42940b158a1c540f9a8451f8d2681e82b12f3c17b48e5727b5a236ac49a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20037"
      ]
    },
    {
      "uid": "zhcn:15e05164e96f83e81ac22a3f",
      "kind": "character_system_text",
      "source_text": "喝啊！",
      "source_fingerprint": "087e620e84bddd10660185fb26dd641301ab5430b398073f62fd71099cb4546e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9f7e7ffc5c826eea97adb65a",
      "kind": "character_system_text",
      "source_text": "请多指教！",
      "source_fingerprint": "95345e686a2624db3212f49b882d52b89822b2acf5f23012304ac01721ec5930",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20039"
      ]
    },
    {
      "uid": "zhcn:73609be68bd8ac0afd74b316",
      "kind": "character_system_text",
      "source_text": "出发！",
      "source_fingerprint": "663f67e6d36e16231932887bb1e3eb2db26e1fb205d758f58e5da16072deb3e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20040"
      ]
    },
    {
      "uid": "zhcn:bda95191a51e922b194abddb",
      "kind": "character_system_text",
      "source_text": "文武双全！",
      "source_fingerprint": "d22ee361f852cef98d1fba74027c095851022b67032825fa8007b2ba3445e186",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20041"
      ]
    },
    {
      "uid": "zhcn:e7c8881a96b162e0fd21c4a0",
      "kind": "character_system_text",
      "source_text": "我太大意了！",
      "source_fingerprint": "9aa99c6296ed2e8461566e0b6cefc2a01d71fe6b3f8c61b9da5a052d0137d8a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20042"
      ]
    },
    {
      "uid": "zhcn:1c2a759b8bc68c28d320aa17",
      "kind": "character_system_text",
      "source_text": "尚待磨练……",
      "source_fingerprint": "95261669e436f5a3e7aaf684ffeb92bd6ec75b7a63d816096dcaa1f6ded93311",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f73b459b70da63d01f0fd622",
      "kind": "character_system_text",
      "source_text": "我们出发吧。",
      "source_fingerprint": "c3864e9473832146609b6ca6bdb0b249e490876d8260a714cff7a38028b9d836",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20046"
      ]
    },
    {
      "uid": "zhcn:a717ad61c1098a875abcebf1",
      "kind": "character_system_text",
      "source_text": "踏上战场！",
      "source_fingerprint": "3d10de9cfe2047459dcc2e224676d30441cd197715ad8cf9d92746e98d430a1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20047"
      ]
    },
    {
      "uid": "zhcn:1a0a347cac9a20be60545dea",
      "kind": "character_system_text",
      "source_text": "能有现在的我一切都要感谢师父。",
      "source_fingerprint": "520389aa2056d78e33fa53267d1e45860c9cb82c2507a6df65643ef3f7131e47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20049"
      ]
    },
    {
      "uid": "zhcn:e0e1d1e062db85040d72c954",
      "kind": "character_system_text",
      "source_text": "非常感谢你的引领。",
      "source_fingerprint": "89290aa35a33241b91e14dac18e28805678467acc0533ba3d56ab90e362d9df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20050"
      ]
    },
    {
      "uid": "zhcn:aad9616d0042ecb8164f2add",
      "kind": "character_system_text",
      "source_text": "那就麻烦你陪我完成了！",
      "source_fingerprint": "2cb63afa489c05ef42989b3f3b413f4312096e5e82a6ba63fef03206e5907998",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "20051"
      ]
    },
    {
      "uid": "zhcn:38744588e45a7dc3857b44d5",
      "kind": "character_system_text",
      "source_text": "赌上一切！",
      "source_fingerprint": "90df567e96e3ab7406cdfa567da35eb6ce611c0cb82cc5a58f902be9eedf2663",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2030"
      ]
    },
    {
      "uid": "zhcn:ad5133c6e460359d5a6c5136",
      "kind": "character_system_text",
      "source_text": "祝各位武运昌隆！",
      "source_fingerprint": "77ea19800a233f7111106f2c71190f164abc494f4ee78d8269294232c7cbed70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2031"
      ]
    },
    {
      "uid": "zhcn:53c451bf0eeb731eee14a8f2",
      "kind": "character_system_text",
      "source_text": "非常感谢你的引领。",
      "source_fingerprint": "89290aa35a33241b91e14dac18e28805678467acc0533ba3d56ab90e362d9df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2032"
      ]
    },
    {
      "uid": "zhcn:46dcc70e705bb8bfd10b2866",
      "kind": "character_system_text",
      "source_text": "向全天下展现平日修行的成果……\r\n换句话说，这也是在展现武艺。\r\n我心中没有任何疑虑！",
      "source_fingerprint": "019d187d7e959211a075736d3d0e3c9358f099deea9a7c0a1ec2b13d602dbe69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2033"
      ]
    },
    {
      "uid": "zhcn:fdfefb3f115aad79b574ba3b",
      "kind": "character_system_text",
      "source_text": "力量涌现……斗志不断化为\r\n源源不绝的色彩！",
      "source_fingerprint": "f6127c51d0addfc46a10e31827ef17e67218504def1eff4095e29471e7a8c6e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2034"
      ]
    },
    {
      "uid": "zhcn:6f8334f6747e4a01775a19c5",
      "kind": "character_system_text",
      "source_text": "非常感谢你的引领。",
      "source_fingerprint": "89290aa35a33241b91e14dac18e28805678467acc0533ba3d56ab90e362d9df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "2035"
      ]
    },
    {
      "uid": "zhcn:232c42452f9ed7ec42088651",
      "kind": "character_system_text",
      "source_text": "押忍！",
      "source_fingerprint": "b9c274116d2e46146710df150b6e70d8474b8cb1fd618ec6360dfc28943b6606",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "23015"
      ]
    },
    {
      "uid": "zhcn:94950e932cbf7cfd6ac7938a",
      "kind": "character_system_text",
      "source_text": "感谢这场有意义的比赛。",
      "source_fingerprint": "294a6d5d1869362536132ede5eb6d0243155fd90225c66d2067d6b01f3ef6744",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30000"
      ]
    },
    {
      "uid": "zhcn:0d8e1b6736741616b0a52410",
      "kind": "character_system_text",
      "source_text": "我的实力还不足啊……得持续精进！",
      "source_fingerprint": "7df26ff724955518094e936609f2ecb5965b9c7508815b1d337eac0a9b9d5638",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30001"
      ]
    },
    {
      "uid": "zhcn:39c0ac61aade82926da380d4",
      "kind": "character_system_text",
      "source_text": "我八重无敌还尚待磨练……",
      "source_fingerprint": "c2ee4a96e52287613ca3e7144f00d46b4b2951a294b138aafc1f5050b1e81c43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30002"
      ]
    },
    {
      "uid": "zhcn:99b6371a1587b05b2ef17a9c",
      "kind": "character_system_text",
      "source_text": "此刻，我只为自己感到羞愧……！",
      "source_fingerprint": "cc1709749f7a88215a9cd9a3196a83b0f29b784ac007bcc17894497b1e3d9438",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30003"
      ]
    },
    {
      "uid": "zhcn:d68d5f9a91ed28dd3fbfad49",
      "kind": "character_system_text",
      "source_text": "冷静并炙热！\r\n这就是「火水合一」的境界！",
      "source_fingerprint": "4393f33bdd2eb647880006761cee9008e188cc4568c1f25d6ddc4f33414aa201",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30004"
      ]
    },
    {
      "uid": "zhcn:e52c300b1cf0a241c21375fa",
      "kind": "character_system_text",
      "source_text": "吸气……喝！！\r\n非常感谢！",
      "source_fingerprint": "12e90a087df6fba74d5eb9eeb2cd55d1876abd9431409f375c4d0e1d1cae9340",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30005"
      ]
    },
    {
      "uid": "zhcn:db83033f9bdbc0f029385189",
      "kind": "character_system_text",
      "source_text": "手強き敵将たち…全員討ち取ったり！",
      "source_fingerprint": "bb86ee904b239515ba8596fefc193f3ce8c78e6dbbf2d86aaba97731e7502190",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30006"
      ]
    },
    {
      "uid": "zhcn:1db39556a3dc4cd7a8e8be5f",
      "kind": "character_system_text",
      "source_text": "スゥゥ～…ハッッ！！\r\nありがとうございました！",
      "source_fingerprint": "0c33578c0f0969e5c1565ff8f61b73a4124a54cdfbb9ee5c5ca7a15c2b3441d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "30007"
      ]
    },
    {
      "uid": "zhcn:3d0559e875fe2530f09537ab",
      "kind": "character_system_text",
      "source_text": "上场了！",
      "source_fingerprint": "4fa31a7114beb8c66ef02818ffe46722b8b4861ceec53c89aa95c95386a0cccb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d384c467a8dc635d34fba7fb",
      "kind": "character_system_text",
      "source_text": "熊熊燃烧有如「烈火」……！！",
      "source_fingerprint": "d17db381ff1d272e018db04df1230a18f03a9d19fe14fb0ace736f47d7d42887",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40000"
      ]
    },
    {
      "uid": "zhcn:abd6bf8185e799b19e463d93",
      "kind": "character_system_text",
      "source_text": "無刀取りならば心得がありますが、\r\n今回の競技は敵の刀身に触れては\r\nならぬ決まり。どう動くべきか…？",
      "source_fingerprint": "0330c97c79486fc4ba9db355ca355445fe4f4fee7638253b71c6ba96d86e394a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400000"
      ]
    },
    {
      "uid": "zhcn:c657c48a1dc7ccf574ec329f",
      "kind": "character_system_text",
      "source_text": "不能让大家被我内心的\r\n激情拖累……我必须严以律己，\r\n认真练习！",
      "source_fingerprint": "856d5c1b4f4fb42cdcfd929a0a83509d11f320a300a3c53056ffe834cf8de6f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400004"
      ]
    },
    {
      "uid": "zhcn:de0d94dd2f6668d63a72b52f",
      "kind": "character_system_text",
      "source_text": "ノーリーズンさんとは相部屋なので\r\n長い付き合いになりますが…\r\nいったい、何を考えているのやら！",
      "source_fingerprint": "87e1c7adf292504a12ebb39e68ea0609f625cc774753442ad73f293d35b4d223",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400006"
      ]
    },
    {
      "uid": "zhcn:d26c9c9523801d621e6d009e",
      "kind": "character_system_text",
      "source_text": "我必须胸怀先人们的祈愿，\r\n守护奔驰于当下与未来的，\r\n所有赛马娘的意志才行……！",
      "source_fingerprint": "758ffbbac9403b3a78722af7a687d80ac33e619d7edadae52f79cc2b23f54dcd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400008"
      ]
    },
    {
      "uid": "zhcn:4e93efd843c12331e56e1835",
      "kind": "character_system_text",
      "source_text": "心情常保「止水」境界──但斗志！\r\n要如同「烈火」！！始得光明──",
      "source_fingerprint": "996a7316264743463d80674a4d79deb5294ce7675fecbf0ff6514b2055510483",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40001"
      ]
    },
    {
      "uid": "zhcn:b0d74c9e66462f4c1b9af466",
      "kind": "character_system_text",
      "source_text": "努力は目的にあらず。『勝利』こそ\r\n真の目的。私はもう迷いません。\r\n次はターフで、彼女を倒しに参る！",
      "source_fingerprint": "f33813190c07636820471098b4018aef26890b9682117e086745fcd4546a1389",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400010"
      ]
    },
    {
      "uid": "zhcn:7067d4b72c2008c6316504af",
      "kind": "character_system_text",
      "source_text": "我不会忘记──\r\n「神马驱」让我亲身感受到，\r\n能奔跑在当下是多么值得感谢……！",
      "source_fingerprint": "2b8267b35df6845708f54bfa10e12e89b53e653d2dfa4a7ffe30569e2562e9af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "400014"
      ]
    },
    {
      "uid": "zhcn:4f2ce5ea39259927f363cc63",
      "kind": "character_system_text",
      "source_text": "切り捨て御免っ！",
      "source_fingerprint": "05e8126e9aa313e03a4458a4501b42fad77a3a1ef1c1d4623d6f118b32bc5998",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40003"
      ]
    },
    {
      "uid": "zhcn:050ee302f90a036b492c61a0",
      "kind": "character_system_text",
      "source_text": "どんな強敵が相手でも…！私こそが天下無双！\r\n今こそ果たすのです、下剋上を…っ！",
      "source_fingerprint": "323640ace89bb0ed6c5a18b14d1d04c7a0e3bd3957f3a0973239498b0696f327",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1072",
        "40004"
      ]
    }
  ]
}
