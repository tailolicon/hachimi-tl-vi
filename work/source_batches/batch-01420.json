      ]
    },
    {
      "uid": "zhcn:da0bfac40ccef302f748e70c",
      "kind": "character_system_text",
      "source_text": "はははは……",
      "source_fingerprint": "d9147c07d55b684900fbe56eccbc6c11c6506226b7d1952b59dbf9905312c7e3",
      "source_path": "character_system_text_dict.json",
