      ]
    },
    {
      "uid": "zhcn:ff72f207c420746ba436f29f",
      "kind": "character_system_text",
      "source_text": "在想事情吗？",
      "source_fingerprint": "dcf6c384c80f7e43d5046c972f6adc8277c8414e43e175a3dc5aa17375418f80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1073",
