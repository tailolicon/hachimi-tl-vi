    },
    {
      "uid": "zhcn:709cceb80fa76314c87eb16c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "多么充满活力的蔚蓝啊……！\r\n呵呵，让人心旷神怡呢！",
      "source_fingerprint": "27b8b14f2b913befb3749e6b0af6151b010e5888a2e9f385e4a62f93f493b927",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
