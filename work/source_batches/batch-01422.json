    },
    {
      "uid": "zhcn:f169bbad01583660594b0171",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "一边倒了有另一边撑着。\r\n因为相信我们永远都会互相扶持……\r\n我才能尽情地奔跑喔！",
      "source_fingerprint": "e64ff77a475d7a6a464ed3486ad6b68f4999c01802bd39c780650414494e9235",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
