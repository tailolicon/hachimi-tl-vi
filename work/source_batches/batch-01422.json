    {
      "uid": "zhcn:ac564f0f72eb715f1895ac54",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "比那天看到的光芒还要强烈……！",
      "source_fingerprint": "212bbecc99b1a66dd91145b6745db35d800881126fd4f1bfe55d43de0efb9fe8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
