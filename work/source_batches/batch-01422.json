    },
    {
      "uid": "zhcn:dcf68ea99e10de43d9cb1a5f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "不哭泣不气馁不放弃！\r\n我是樱花桂冠！",
      "source_fingerprint": "6dee687c7c128f3722e20f8da61bcfea9dd73a7712bc04e9279d4fc437ccc4c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1076",
        "95003"
      ],
      "json_pointer": "/1076/95003"
    },
    {
      "uid": "zhcn:dc2d6d9f24d9ba3b653102fc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "站起身来，向前迈进。\r\n等到总有一天──会鲜艳盛开！",
      "source_fingerprint": "4bba1e8da5c6fcd5782c6d93f29957b4b902d9908ef291a42984f36b7c9ea4e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
