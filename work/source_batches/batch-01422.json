    {
      "uid": "zhcn:eaf92ff636b8a0de21508bb3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "跌倒了多少次，就能往前走得多远！",
      "source_fingerprint": "dbc6d368421fd13a99df7688320bb6c9618bced7f878c19d2fe2566c215316b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
