    {
      "uid": "zhcn:b28821f7a942cb8bb1273ed1",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这是超乎预期的完美结局！",
      "source_fingerprint": "c05ef116c41537395c9df1aa3ed485b61b38fee3fd5c7b20fb33e384b575ee5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
