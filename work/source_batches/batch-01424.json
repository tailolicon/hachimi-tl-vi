      ]
    },
    {
      "uid": "zhcn:8fc300b87bde86d25b99c8b0",
      "kind": "character_system_text",
      "source_text": "请慢慢地～\r\n好好地～地培育我喔♪",
      "source_fingerprint": "01c38d1114f84951da7c4510c97cc6e11bdeaebbfdb3ff8b457700b9ee04be78",
      "source_path": "character_system_text_dict.json",
