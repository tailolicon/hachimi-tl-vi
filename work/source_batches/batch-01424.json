      ]
    },
    {
      "uid": "zhcn:e753b608f3089bb59c620c9e",
      "kind": "character_system_text",
      "source_text": "每个孩子\r\n都好可爱呢～",
      "source_fingerprint": "e43968e871d830f7487cfa2a2d69077aee0950905197b20efbdcdfa17cc1de7c",
      "source_path": "character_system_text_dict.json",
