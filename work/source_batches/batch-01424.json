      ]
    },
    {
      "uid": "zhcn:a8c0736f13e4c37309a41c6b",
      "kind": "character_system_text",
      "source_text": "哎呀，太出色了～",
      "source_fingerprint": "d846279282846bbfe67b57ac3f814318c44c596367c8dcb764c3691169aa4c59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1074",
        "1007"
      ]
    },
    {
      "uid": "zhcn:693961334e2857676038714b",
      "kind": "character_system_text",
      "source_text": "各位～都准备好了吗？",
      "source_fingerprint": "07994cfde89746b9886c0ba91eea6461a95aa88df65de4b79e4117f4878533f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1074",
        "1008"
      ]
    },
    {
      "uid": "zhcn:137a386d02df5c911a42ba48",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1074",
