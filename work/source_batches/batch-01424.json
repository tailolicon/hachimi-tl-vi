      "source_text": "展现我们的决心。",
      "source_fingerprint": "7e97bd4fe17a2097a967be51d8aed18c278778cc7558aafcfc989d847be20423",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1074",
