      ]
    },
    {
      "uid": "zhcn:32784b1a3e76da7bfb20adcb",
      "kind": "character_system_text",
      "source_text": "你想\r\n报名参赛是吗～？",
      "source_fingerprint": "a2ef910cde8a2d80d26502dcde8355180b3f0a64dc632d1c620e273b950d8614",
      "source_path": "character_system_text_dict.json",
