      ],
      "json_pointer": "/1078/20008"
    },
    {
      "uid": "zhcn:b18b6e0f90175a221b923389",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "牡丹……花林糖……盐豆……\r\n啊，抱歉，我有些心不在焉了。\r\n我刚刚在替小鸟们取名字。",
      "source_fingerprint": "4e0b581de58d51cc45e91d963a1503fcf0c66c60f9c871dff8345a6a68c99fdd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
