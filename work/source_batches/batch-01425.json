        "1078",
        "20007"
      ],
      "json_pointer": "/1078/20007"
    },
    {
      "uid": "zhcn:21c87d425059771d3bdc4df0",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "现在，还不太适合起跑……\r\n看来只能等待春风……",
      "source_fingerprint": "ebd55bf4a8ca6f6be8cfab50decb7466946a813c0b06613bf1c8fd171e7752de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1078",
