      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我上场了。",
      "source_fingerprint": "ad1f9cae30791da93459ed415bd493b478715233c9de670a5777e0bb84856163",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
