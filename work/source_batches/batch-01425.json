    },
    {
      "uid": "zhcn:6cacb11d500dff3a96f39850",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今天的风……很平静。\r\n既不狂野，也不需要害怕。",
      "source_fingerprint": "e25815e17cda25e15556f8e5341a2dd8caf67987bd4df8adcebe8d621c25af6a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
