        "20027"
      ],
      "json_pointer": "/1078/20027"
    },
    {
      "uid": "zhcn:830d05c7cb08d99d41a9355a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "如雄鹿般强劲，\r\n如夏风般轻快，\r\n敬请期待我急驰的脚步声。",
      "source_fingerprint": "7f8c9c2de6fc0aa12e0867b2efcf556c1c39a05b6709c2853f6bd51bcf1ccf67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
