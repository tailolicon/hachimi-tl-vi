    },
    {
      "uid": "zhcn:729583c184c87bbd1abb9d4d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "感觉无论怎么吸气，\r\n都无法呼吸……风和我……\r\n都非常不流畅。",
      "source_fingerprint": "8333898aa8c38c8adda7005ffb725066d82311d8ed678d2f72dbba9daf27c664",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
