    {
      "uid": "zhcn:05f813a85c09341706807820",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "与风一同嬉戏……",
      "source_fingerprint": "0bff444a8e55d6f35ca6857c7f5077d4a710a0801886c4a0bcc079ec48976f3a",
