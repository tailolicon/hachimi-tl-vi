      "uid": "zhcn:5a0f3847d389ba8e56239b7b",
      "kind": "character_system_text",
      "source_text": "不用担心！我不会迷失方向的。",
      "source_fingerprint": "8c01f48f6d60d0b12cf209e0f2334af36fbb8005487a5b5233f4ed4f5b4f833e",
      "source_path": "character_system_text_dict.json",
