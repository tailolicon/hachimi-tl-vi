      ]
    },
    {
      "uid": "zhcn:f7f122dd988a27567cc20d98",
      "kind": "character_system_text",
      "source_text": "好开心～♪",
      "source_fingerprint": "c99b21accc97913abeac4998e4135279c8caf1e691b602fcb705167f1e893b57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140007"
      ]
    },
    {
      "uid": "zhcn:f0a77617939436f4971fb199",
      "kind": "character_system_text",
      "source_text": "哇哇！？",
      "source_fingerprint": "1b81eb3f2b0ce518b691f268cd24fe36ee29b8055b0ec0126b87b3965e2a6cf2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140008"
      ]
    },
    {
      "uid": "zhcn:12cddde19e1529603ae1ed34",
      "kind": "character_system_text",
      "source_text": "诶嘿嘿…",
      "source_fingerprint": "f920c46df106dd2e0a1e8327e0df788a336374e55e8d9c96f81459a4b596ff4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140009"
      ]
    },
    {
      "uid": "zhcn:db5510fbbeab94105bf2cc49",
      "kind": "character_system_text",
      "source_text": "在♪",
      "source_fingerprint": "820a4736d2b4eb014efb01250b9b30c97c3a144b6649f599450dd39a93570c3f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140010"
      ]
    },
    {
      "uid": "zhcn:4911687e942537a2c852f8f2",
      "kind": "character_system_text",
      "source_text": "抓到好多娃娃呢！",
      "source_fingerprint": "dffe08880fa550674a9148ad9992708374ba2ddfdf6c6258983fcde7ef49026a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140011"
      ]
    },
    {
      "uid": "zhcn:c74e4a6c71ff862207ba9f7d",
      "kind": "character_system_text",
      "source_text": "好机会！",
      "source_fingerprint": "54ec1da823f0c87f6074881d473031b6d90dc8b4228f9b688360c7982332f97f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140012"
      ]
    },
    {
      "uid": "zhcn:e60afbc78b0c0ccdf8fccbbf",
      "kind": "character_system_text",
      "source_text": "呼呼呼♪",
      "source_fingerprint": "ce78aff5b338bf8796bd0b51811a3457b917af37ea2fb85feeba8e2309786f3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140013"
      ]
    },
    {
      "uid": "zhcn:5f7fa7c8f1302d685a44b449",
      "kind": "character_system_text",
      "source_text": "哇…！",
      "source_fingerprint": "1d7b0d351354d6ea26eb26e88fd8b16593bbeb149b243b2bbad7c4c116d52127",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b417712fe93395299c2a1ceb",
      "kind": "character_system_text",
      "source_text": "那个……",
      "source_fingerprint": "2ef614ee14f09c43bde33e8203ed864410d4ffeda729fb97787d1e0fd28d9310",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140015"
      ]
    },
    {
      "uid": "zhcn:28e42c940eb10c3862a56b48",
      "kind": "character_system_text",
      "source_text": "那个～！",
      "source_fingerprint": "c1f2cf5e0c7e531b5009af205540f57d66f73ec05956dd021281d13c7f01ac49",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140016"
      ]
    },
    {
      "uid": "zhcn:763fc045c56f78f23950b40c",
      "kind": "character_system_text",
      "source_text": "哈…！",
      "source_fingerprint": "9c384ed029ba21fa52578ef43233d7b6ac2311a4e1bc74f067c9186b53db98c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140017"
      ]
    },
    {
      "uid": "zhcn:d9374a508f093eb6f6de1fbe",
      "kind": "character_system_text",
      "source_text": "唔唔～…",
      "source_fingerprint": "43b4f89c8d861dda911cc04bda2f2461bc9357163ea6ae5cfec11b6d963a6d46",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "140018"
      ]
    },
    {
      "uid": "zhcn:1629cda59f6ece8ce25c4363",
      "kind": "character_system_text",
      "source_text": "明天的话能拿到这个奖励哦♪",
      "source_fingerprint": "a5d248c75fb7d9cd588c0d450f7d82acbe979aa9e794cff331d21fdb54ed8ac4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "15"
      ]
    },
    {
      "uid": "zhcn:d81dfcdc4828343a21678e01",
      "kind": "character_system_text",
      "source_text": "『没有胡萝卜的话就没法锻炼』…\n稍事休息也是很重要的呢…",
      "source_fingerprint": "7083c872a47eae285e33ef1c2d639357e3133abdb830595c6dec6624b7b6412c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20000"
      ]
    },
    {
      "uid": "zhcn:402c3f78dd0d4da35259a28d",
      "kind": "character_system_text",
      "source_text": "我还能继续努力哦——\n虽然是想这么说啦……",
      "source_fingerprint": "fcd6745841121f6cea4ecd979aab545a49d808de24192dbaf3b381d4e534af6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20001"
      ]
    },
    {
      "uid": "zhcn:d4bd7e9166031ae6743311f3",
      "kind": "character_system_text",
      "source_text": "我现在精神饱满哦！好啦好啦，\n快点开始训练吧～♪",
      "source_fingerprint": "135fc010e8456442b8d0d497d4bf10a9994785bd1317ebe1b298755ae1434f8c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20002"
      ]
    },
    {
      "uid": "zhcn:e43556a72e6f1df861c80d90",
      "kind": "character_system_text",
      "source_text": "加油～OH！千代・OH！\n嘿嘿！因为马上就可以跑步，实在是太开心了！",
      "source_fingerprint": "f34c000ea01614808cfe6513592d139e940be74c7e2a7c9f66d86496b3cbb451",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20003"
      ]
    },
    {
      "uid": "zhcn:a0591e54e74f7126b5690bec",
      "kind": "character_system_text",
      "source_text": "今天想做的事情也多得跟山一样呢！\n那我们快点开始训练吧！",
      "source_fingerprint": "a771fdfb6a91ce87acbfaa008152c04625ce82038cf098a8c89e3bc1144d4f2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20004"
      ]
    },
    {
      "uid": "zhcn:caf4b9549a33723676fed8ff",
      "kind": "character_system_text",
      "source_text": "到休息时间了呢，我去准备些海带茶♪\n待会训练员也来一起喝吗？",
      "source_fingerprint": "a12b65a97114ab87b272473a4aa175a4ed50d3ff3f2f7ca354b878a623228c7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20005"
      ]
    },
    {
      "uid": "zhcn:a4c8f78b6240adb00f22fdab",
      "kind": "character_system_text",
      "source_text": "在！樱花千代王就在这里哦！\n随时听候您的指示。",
      "source_fingerprint": "d9eca5b6ebe71081bbbed2da515a0949fe4ec686f9112c7ae6921cc066291462",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20006"
      ]
    },
    {
      "uid": "zhcn:32edf3b331a653e4ca4e8314",
      "kind": "character_system_text",
      "source_text": "不断努力，\n静候樱花满开的那一天——",
      "source_fingerprint": "a062725b5a599105264483732b0bee1e80cab09a2bb91cff7e0d2082c6b0e43e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20007"
      ]
    },
    {
      "uid": "zhcn:016d48e16be0bf62c8d92932",
      "kind": "character_system_text",
      "source_text": "正所谓『只要努力磨的话白萝卜也能变成泥』\n只要继续努力，我也一定――！",
      "source_fingerprint": "3af0cbf7a17ed3b22619d6327a8241823064f7ad98b063d3913ebc8d3772fb13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20008"
      ]
    },
    {
      "uid": "zhcn:3b320c21667fd4b9729899b7",
      "kind": "character_system_text",
      "source_text": "只要开始训练的话，\n就肯定没问题了……吧……",
      "source_fingerprint": "faf8ad9386f5d4dced5b489b1cfca92fbe69d2796fdb4147a20151188a5047aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20009"
      ]
    },
    {
      "uid": "zhcn:14a80a88c710c94475ea102e",
      "kind": "character_system_text",
      "source_text": "要是不绞尽全力的话，\n我根本追不上其他人的步伐……\n虽然我知道这个道理，但是……",
      "source_fingerprint": "d956f385850c9c3a9057b7069f7063a9d58a45d475da9e28139ebcd75bb5c614",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20010"
      ]
    },
    {
      "uid": "zhcn:83de726b98d314a99a43e5ea",
      "kind": "character_system_text",
      "source_text": "我马上就能打起精神，\n所以请稍等片刻……",
      "source_fingerprint": "b44dab907233396ea40d17cb52f4bfa802eb697610dcfe0d932b695da73af2f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20011"
      ]
    },
    {
      "uid": "zhcn:d9b9c7c75a03a7455277a46f",
      "kind": "character_system_text",
      "source_text": "还要继续跑比赛吗……\n虽说我也不是不想跑……不过……\n现在也许别太勉强比较好……吧……",
      "source_fingerprint": "78c4f245568a24452bb7532cfd3d8ea10be85cdcd07b14c6457209fc9f45ff2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20021"
      ]
    },
    {
      "uid": "zhcn:e4df13f2cb240a0ed227b7d1",
      "kind": "character_system_text",
      "source_text": "要是在这里燃尽的话，\n本来能达成的目标也会离我远去的……\n……可以请您重新考虑一下吗？",
      "source_fingerprint": "87fb31624f7ee12153a66b91ee47dae0b2e1b73a9dab67c2b5045eca23f5e02a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20022"
      ]
    },
    {
      "uid": "zhcn:ca55728f23c735d0bdd10721",
      "kind": "character_system_text",
      "source_text": "如今正是樱花满开之时――！\n感觉浑身的血都燃烧起来了呢！！",
      "source_fingerprint": "e3c1e4ccab9e1a3f47adb6d099e04ffcc25c701e6afeba723c891fc7499c7948",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4370cd083d62a87c96fa4957",
      "kind": "character_system_text",
      "source_text": "力量涌上来了呢！\n堂堂正正——\n一决胜负吧～！！",
      "source_fingerprint": "bcd012cc5a09062c5997992c80a5404582b35a9f3bfd61df12b6e7bf46efbd3f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20024"
      ]
    },
    {
      "uid": "zhcn:734e68eea3fd6f5e21bd8b14",
      "kind": "character_system_text",
      "source_text": "『只要沉下心来用千代般的耳朵倾听，\n鼓号曲便萦绕在耳畔』――\n就是说，胜利已经近在眼前！",
      "source_fingerprint": "2f325cf886429bdc098f72c276912df10cf8fe9d8553aa20869b6885a088a8b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20025"
      ]
    },
    {
      "uid": "zhcn:9fec6f19af8deaa3e26de5eb",
      "kind": "character_system_text",
      "source_text": "请您安心地拭目以待吧♪\n为了能在比赛中尽情绽放，\n我们都已经付出那么多努力了哦！",
      "source_fingerprint": "71b89dc1ca92841fd637bf45d6703b4c3255356d6f0a53f7bc662226bc5bffbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20026"
      ]
    },
    {
      "uid": "zhcn:83f4b16298809efc0f523c0e",
      "kind": "character_system_text",
      "source_text": "虽然我成不了『超级跑车』，\n但要做到轻型轿车的程度还是没问题的！",
      "source_fingerprint": "a4483843219c9e752c831c8ed8dcd2bf752d647014a3c35facaabdd1d07e8a43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20027"
      ]
    },
    {
      "uid": "zhcn:9197ed62754e4096f9961e4c",
      "kind": "character_system_text",
      "source_text": "要是我奔跑的身姿，\n也能残留在谁的心里就好了…！",
      "source_fingerprint": "9800dd32b86eab25ce2607de83362c1e30aa32b33fd370f6b520cad527365277",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20028"
      ]
    },
    {
      "uid": "zhcn:97970a7ef78740925692bbf6",
      "kind": "character_system_text",
      "source_text": "只要正常发挥的话就没问题哦！\n毕竟我们也跑了这么多比赛了呢♪",
      "source_fingerprint": "c3b63dbc448895aa92cfbc49c16fb032c30d17907520a30bb2c4caa49a97aa57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20029"
      ]
    },
    {
      "uid": "zhcn:025b9b4a359599bda4b9fd55",
      "kind": "character_system_text",
      "source_text": "马上就要开闸了…！\n稍微有点紧张呢～！",
      "source_fingerprint": "ff8ae1b55ee0ce1bdbf3121734f77ee82d2390b75a8f0d710a4ba2bf2f03b614",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20030"
      ]
    },
    {
      "uid": "zhcn:032b152cac281f748a32ba2b",
      "kind": "character_system_text",
      "source_text": "啊！在比赛开始之前，\n得先翻翻看千代笔记呢！",
      "source_fingerprint": "e93213ca7b84b0a3a8d055eb012a165dca0f89bf760261c0de29dbe26612a123",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20031"
      ]
    },
    {
      "uid": "zhcn:c2584fe3e106d4c09a2c908a",
      "kind": "character_system_text",
      "source_text": "虽然还有些不安……\n但要是不迈步前行的话，就只能原地踏步了……！",
      "source_fingerprint": "3739673341c7d0b269cb220b99a363ccfc8c10a087056bddb31b9c2f5509efbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20032"
      ]
    },
    {
      "uid": "zhcn:0aa02c8dfb7f85cc31f45781",
      "kind": "character_system_text",
      "source_text": "那个……能请您在观众席为我加油吗？\n这样的话，就一定――",
      "source_fingerprint": "497a4a57c603c8e1aee937a86defc77e21b97485a21bb32462238985600240f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20033"
      ]
    },
    {
      "uid": "zhcn:d7d54ee8723481764ee7fdba",
      "kind": "character_system_text",
      "source_text": "我能做到的事情……\n就只有拼尽全力地奔跑而已。\n现在必须这么想……",
      "source_fingerprint": "9b643a0d8f5f49d78a81131fe2c75fbea64b3a14a7421b83100ecdb7ba57c127",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20034"
      ]
    },
    {
      "uid": "zhcn:17d960b60b03d6fba179f916",
      "kind": "character_system_text",
      "source_text": "千代笔记第88页……\n『只要忍耐的话，就算是3浪也不过等于1浪』……\n只要坚持下去的话……",
      "source_fingerprint": "89c1337307fa1de4b602e78929f6be5d9cc102a11e46d28a21997133a41d85f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20035"
      ]
    },
    {
      "uid": "zhcn:b66141291baf6da77318d66c",
      "kind": "character_system_text",
      "source_text": "这样下去可不行……\n得想想采取怎样的战术比较好……",
      "source_fingerprint": "9b2d21247759d2b53f9941224bee44b38d38aea6e2d6493561cdf16191ab89cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20036"
      ]
    },
    {
      "uid": "zhcn:156c41f3f6c1de90cc021a9e",
      "kind": "character_system_text",
      "source_text": "虽说『樱叶亦是樱』――\n难道我连樱叶都……\n……呜呜呜……",
      "source_fingerprint": "8b14b0819408c4f57c4fce163dc8eea0b76d93bca20ac358e1c4133ad53bae91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20037"
      ]
    },
    {
      "uid": "zhcn:758e94f4decf65e80d692330",
      "kind": "character_system_text",
      "source_text": "要上了哦！",
      "source_fingerprint": "7c967e75e39f341bde454f3e389531a0943b2e9cb665d31e66635fcd79e310da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9b8b3b94bfd9f4a50ca7896a",
      "kind": "character_system_text",
      "source_text": "是！",
      "source_fingerprint": "92c7c80d421e17e0e64227dc915153ae460be7213ab0bfafd9026602c2e67892",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20039"
      ]
    },
    {
      "uid": "zhcn:f06432225db97f74984dc2da",
      "kind": "character_system_text",
      "source_text": "要上啦！",
      "source_fingerprint": "f5db7fe11fb5ccbaebcaef2bd7bb8466771b67518232630e757aa464e9a929f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20040"
      ]
    },
    {
      "uid": "zhcn:b45c768f310a42132206ab28",
      "kind": "character_system_text",
      "source_text": "了解！",
      "source_fingerprint": "2d80dcf567869b6df59c7fb9863926bbb48adeadf1441ae11d6bbfe42e632e42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20041"
      ]
    },
    {
      "uid": "zhcn:de8d5c76ea01f54a55cb80f6",
      "kind": "character_system_text",
      "source_text": "啊哇哇哇……唔……",
      "source_fingerprint": "2d1758b003c9faf92c0d13bdd1c1083d28808f385b928784d45e394112a22aba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20042"
      ]
    },
    {
      "uid": "zhcn:d7bbd5a6fdcc4bc1a824c5bc",
      "kind": "character_system_text",
      "source_text": "啊啊～…",
      "source_fingerprint": "c841b0301d3ba2a7985bf8e66771c35eabe282546d205a0379472e831f52eb19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20043"
      ]
    },
    {
      "uid": "zhcn:ca207346256ab5dd63cccc46",
      "kind": "character_system_text",
      "source_text": "出发啦！",
      "source_fingerprint": "e614f61077baa5c32c3da74aeeadf26136d27b54dd9da15478f03b2843c04ca3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20046"
      ]
    },
    {
      "uid": "zhcn:9b14087ffc4c34ba407e10ba",
      "kind": "character_system_text",
      "source_text": "跑得真开心呢♪",
      "source_fingerprint": "73f9ee2ff659a4acda71bbbeea4548ad76111d0fa18ee38486a88a516b2ce7f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20047"
      ]
    },
    {
      "uid": "zhcn:aa0089349ef81af60adf5627",
      "kind": "character_system_text",
      "source_text": "感觉，离梦想又近了一步呢！",
      "source_fingerprint": "3876d9899403def00125acae7816e1e0f19fba49dea995d544e2731285edeb38",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20049"
      ]
    },
    {
      "uid": "zhcn:58d3dff7fc605816f24d181c",
      "kind": "character_system_text",
      "source_text": "这是努力的成果呢！",
      "source_fingerprint": "fe967fc62209ef28193aacae44f6390b7f246777b6a9ff789bb191f9d298c854",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3a7d5763b2fe2435881ff38b",
      "kind": "character_system_text",
      "source_text": "继续加油吧！",
      "source_fingerprint": "5e5cbbc7d525995bba4f903a0a267af4864a666ae01c8b461a5f1ae0de1db7ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20051"
      ]
    },
    {
      "uid": "zhcn:6c6bd8bfaec980cdefb279f3",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "2030"
      ]
    },
    {
      "uid": "zhcn:e525e7499789019276c00cb7",
      "kind": "character_system_text",
      "source_text": "以大金星为目标！\n（注：大金星是相扑术语，意为低段位选手战胜最高段位的选手）",
      "source_fingerprint": "0a62367d97276f3f41cdcd3dda76212223c31b2539f566c6ee2aec193cea6c12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "2031"
      ]
    },
    {
      "uid": "zhcn:522d213a3b61d9b29b94f9ae",
      "kind": "character_system_text",
      "source_text": "这是努力的成果呢！",
      "source_fingerprint": "fe967fc62209ef28193aacae44f6390b7f246777b6a9ff789bb191f9d298c854",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "2032"
      ]
    },
    {
      "uid": "zhcn:60b4ed46e48075972fddec5b",
      "kind": "character_system_text",
      "source_text": "要是我奔跑的身姿，\n也能残留在谁的心里就好了…！",
      "source_fingerprint": "9800dd32b86eab25ce2607de83362c1e30aa32b33fd370f6b520cad527365277",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "2033"
      ]
    },
    {
      "uid": "zhcn:4c2df1ee1b606d2311285bd6",
      "kind": "character_system_text",
      "source_text": "『只要沉下心用千代般的耳朵倾听\n鼓号曲便萦绕在耳畔』――\n就是说，胜利已经近在眼前！",
      "source_fingerprint": "e72388918178ae22b1d586db6862a0340a02d695d10e4648f20ae8dbf0c9afef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "2034"
      ]
    },
    {
      "uid": "zhcn:c5abc39bda80e0429afdb79a",
      "kind": "character_system_text",
      "source_text": "这是努力的成果呢！",
      "source_fingerprint": "fe967fc62209ef28193aacae44f6390b7f246777b6a9ff789bb191f9d298c854",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "2035"
      ]
    },
    {
      "uid": "zhcn:3936aa7c0aeaf402bf9561fb",
      "kind": "character_system_text",
      "source_text": "出发吧！",
      "source_fingerprint": "778f2d205d4eaf97bc7ba75792626a5d8a4695e1fb0cb5ca44b7b560dd525d9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "23015"
      ]
    },
    {
      "uid": "zhcn:831d8fba116482ecd10440cd",
      "kind": "character_system_text",
      "source_text": "还差一点就能满开了…！",
      "source_fingerprint": "657bb0f7ba6ece19364f7ad8e65792942ab143ff937e3dda4fe32b5903382fe3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30000"
      ]
    },
    {
      "uid": "zhcn:ec62dcc096ec69937919ef12",
      "kind": "character_system_text",
      "source_text": "接下来也得努力了呢！",
      "source_fingerprint": "a4acbad8377184ce1172d683e5d14e9979c6169745d07b2b1175ded184e508c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30001"
      ]
    },
    {
      "uid": "zhcn:55fb4b07fc64727a349cdb06",
      "kind": "character_system_text",
      "source_text": "这样也算是半开了吧……",
      "source_fingerprint": "978d3eea7980b838ce70309fb04f6deed23fd9c9fc84590ac022a6ec2b59be50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30002"
      ]
    },
    {
      "uid": "zhcn:f90efdeb67e001d6a72842dd",
      "kind": "character_system_text",
      "source_text": "距离那个心中憧憬的模样，我还差得远啊……",
      "source_fingerprint": "64dbeaa4c55b53b0f23321e11f8f5c01d9155cd724d69569f24303036b4c61be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30003"
      ]
    },
    {
      "uid": "zhcn:93e513c1345ec1d4b1043346",
      "kind": "character_system_text",
      "source_text": "迄今为止的努力……一定能让我盛放于此！",
      "source_fingerprint": "4692cab997da650295eaf77dc4840c620422a18efadf7c5cd13ddc1f9334e089",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30004"
      ]
    },
    {
      "uid": "zhcn:1a6c9cdba7fbf80fb3fa4d19",
      "kind": "character_system_text",
      "source_text": "我……现在能盛放吗？",
      "source_fingerprint": "3c05a2e6a7e175c0b0da1037f0e8efdab6f888dfcf7ca2cafcc7b3873d60f97f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30005"
      ]
    },
    {
      "uid": "zhcn:915504c345decd46926637a2",
      "kind": "character_system_text",
      "source_text": "只属于我的步伐比任何人都华丽！",
      "source_fingerprint": "5c604d315abeea53887cb8f0ec67a06071d6bb4925c57c095b2b92e9432206ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30006"
      ]
    },
    {
      "uid": "zhcn:3f88afb9ecd19dfb768cf643",
      "kind": "character_system_text",
      "source_text": "我是否盛开了呢？",
      "source_fingerprint": "dfc2fc78e9a4d57399e4d10acc85ffe9e3fa7e96dacf63b59c74fb7604b43aff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "30007"
      ]
    },
    {
      "uid": "zhcn:a8f4953b31f8ffe4490fd2a1",
      "kind": "character_system_text",
      "source_text": "以满开作为目标！",
      "source_fingerprint": "133b73061919b928115354e078a197bd831f2499bf14681e6bf8bef1476ee2f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "31000"
      ]
    },
    {
      "uid": "zhcn:75f8c3927ae20a96e9181850",
      "kind": "character_system_text",
      "source_text": "现在正是满开之时——！",
      "source_fingerprint": "7b9755533a77a4a2dc87286c1a8d55883a46ad851fa81ec9b50752f5111d21a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "40000"
      ]
    },
    {
      "uid": "zhcn:5c14f15250e4eab8864d040f",
      "kind": "character_system_text",
      "source_text": "「种下种子，白萝卜长成白萝卜，\r\n胡萝卜长成胡萝卜！」。\r\n我的目标是成为最佳舞伴！",
      "source_fingerprint": "014f2d147f13ddb87cac4dd2b5a92e7725ffa5aadc5e433fd24d718b07a22d7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "400000"
      ]
    },
    {
      "uid": "zhcn:95da175f670a0a74556433f9",
      "kind": "character_system_text",
      "source_text": "我会好好努力通过预赛的！\r\n不知道丸善斯基前辈\r\n会不会也为我开心呢……？",
      "source_fingerprint": "49ac15d96c3c2582b2dc2fbd2f03087a3ffc2d14baf8b9be292db119f35b6659",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "400002"
      ]
    },
    {
      "uid": "zhcn:2cf128bb7a696e2e48d8d1b1",
      "kind": "character_system_text",
      "source_text": "我本以为自己明白这所学园有许多\r\n「特别」之处……但原来真的还只是\r\n「自以为」而已……！",
      "source_fingerprint": "f109e4c1e434e9603588c3ef9fb729c0a8dc71c1ab5b40ffc03fb74d30bfe4ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "400003"
      ]
    },
    {
      "uid": "zhcn:16e2a1ce8b1615c6c320c815",
      "kind": "character_system_text",
      "source_text": "该买什么礼物好呢～？\r\n我想要能跟丸善斯基前辈凑成一对的东西，\r\n开玩笑的……嘿嘿。",
      "source_fingerprint": "09d364ca8dfda77be8e39e5256ab94bd3b31f5551fc8b373233ffaab87d1c8f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "400009"
      ]
    }
  ]
}
