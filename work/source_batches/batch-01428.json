      ]
    },
    {
      "uid": "zhcn:757bd6a5930f53e755860cc3",
      "kind": "character_system_text",
      "source_text": "对不起……",
      "source_fingerprint": "76a228f4c70cc0347268384ed24614e77c1d969fbcbe57d8162f8e86aa7bc671",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1076",
