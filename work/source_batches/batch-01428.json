      "source_language": "zh-CN",
      "source_text": "唔……！",
      "source_fingerprint": "88b08a445830f60f831cc69715bfe607a664dd20f0eb7a6b5add5663dfe83b11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
