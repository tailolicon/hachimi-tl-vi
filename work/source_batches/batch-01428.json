    {
      "uid": "zhcn:db1f2ff2c3d4d6ac61a9c2cb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "来吧……！",
      "source_fingerprint": "486457e67e0b18714bcb7a5eb90056853607e701498cec3056487ea7555162ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
