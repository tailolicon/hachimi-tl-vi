      ],
      "json_pointer": "/1079/20036"
    },
    {
      "uid": "zhcn:9c11e32dbee8f0c6225ef8c7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "训练员……。\r\n能请您为我祈祷吗？\r\n……祈祷我的胜利，祈祷故乡的未来。",
      "source_fingerprint": "5598185b9e3ba46d82e4fe1e5a0bce8833275f0eb1a2fcb1e0b042a92e03a890",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1079",
