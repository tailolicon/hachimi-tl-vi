      ],
      "json_pointer": "/1079/20037"
    },
    {
      "uid": "zhcn:2104921b5f4298620d48dbde",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "好的。",
      "source_fingerprint": "092cd95e8a64d58d136c3c650b8d9d7cc23ad4ad69c0c649443874ffaa82fc65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
