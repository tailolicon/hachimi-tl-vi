      "source_language": "zh-CN",
      "source_text": "唔嗯……。",
      "source_fingerprint": "9062a0de186b4f6a95540f6636fa11e8e929f282f4d453be0f38efede1fe0bd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
