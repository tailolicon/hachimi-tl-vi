      ]
    },
    {
      "uid": "zhcn:b2fba0ec7043524c9b444f3c",
      "kind": "character_system_text",
      "source_text": "真的，真的非常感谢！",
      "source_fingerprint": "dfbce9c9f744e8c766a6641bbb5449e34681f851b8cdc8e31349276527803359",
      "source_path": "character_system_text_dict.json",
      "json_path": [
