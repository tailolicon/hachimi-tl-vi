      ]
    },
    {
      "uid": "zhcn:99c1309c6765b3b41af8432f",
      "kind": "character_system_text",
      "source_text": "没关系的，我一定能像训练员期待的那样\r\n不…是比预期中还要好的那样！",
      "source_fingerprint": "14ecf1282ea128cb2098b4767722e57ea01f2607661ed0d86a92a54d77b823a2",
