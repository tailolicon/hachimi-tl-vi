      "kind": "character_system_text",
      "source_text": "啊咦！？",
      "source_fingerprint": "e543304f43c746346e6bd5f994692b5b9743426b0dddfd1d56c60f2ffe7bf1ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1077",
        "20042"
      ]
    },
    {
      "uid": "zhcn:03d09d26c0816277e9687810",
      "kind": "character_system_text",
      "source_text": "呃～唔？",
      "source_fingerprint": "2207b813677b9077c1e522005a807b6922a719816c915b87bec06e3b98a19cb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1077",
        "20043"
      ]
    },
    {
      "uid": "zhcn:442be9b225bbd3831838d593",
      "kind": "character_system_text",
      "source_text": "好期待啊…！",
      "source_fingerprint": "8705fe0fe2f8340812f9afb13ba67fd634111917b5b39bd34635bf3ed8da1933",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1077",
