      ]
    },
    {
      "uid": "zhcn:dc58810199eca0fe3be6144b",
      "kind": "character_system_text",
      "source_text": "大家都有进步…\r\n但是我觉得\r\n我自己也完全没有落后！",
      "source_fingerprint": "f9baaf385016760ee6bc885edd41c32f2ba17a0d1ae45915bdd29068c8709a59",
      "source_path": "character_system_text_dict.json",
