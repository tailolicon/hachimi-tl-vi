  "entries": [
    {
      "uid": "zhcn:51d2b28e133a6d01f78fa9d6",
      "kind": "character_system_text",
      "source_text": "イルミネーションが一望できる、\r\n隠れスポット見つけてきたよん。\r\n2人で独占しちゃおうぜい。",
      "source_fingerprint": "1b23ad427b1432c415be6626b0e3a7a2c7660bf4fe9b335656949dc2b57516cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10009"
      ]
    },
    {
      "uid": "zhcn:e2d4126c4c85cb67148de698",
      "kind": "character_system_text",
      "source_text": "ウチらの勝ちー。",
      "source_fingerprint": "73f786fde1195ce23a9772ec97112f9f49d4f8a5aa1360dc7916fefa9ad6b4ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1001"
      ]
    },
    {
      "uid": "zhcn:3f727169013f6f21a756f733",
      "kind": "character_system_text",
      "source_text": "年末セール、どれに手を出そう…。\r\n最新家電…いやいやレア物も――\r\n…全部いっちゃうか！",
      "source_fingerprint": "488c942b4313333ec1b0dd965461a379fc103c03985948238b32578f8aedbfa2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10010"
      ]
    },
    {
      "uid": "zhcn:ac90e21508557d3fb9e3602c",
      "kind": "character_system_text",
      "source_text": "おたおめ～。トレちゃんが好きな\r\nB級映画の続編、仕入れたよん。\r\nケーキ食べながら見よ見よ～。",
      "source_fingerprint": "1874c567dc3cd37b35b91e17bcdcbcd6eed9be217392e4a5fe94a5c2fa1b21bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10011"
      ]
    },
    {
      "uid": "zhcn:18a3f37e721f7f2d3e6bc9f8",
      "kind": "character_system_text",
      "source_text": "最新のアイウォーマー送ったから、\r\n疲れを取るよーに。ずっと一緒に、\r\nゾクゾクを楽しみたいじゃん？",
      "source_fingerprint": "c54e30b2cc373b7b9de41da47d1a00058d2277b15ba986a7df0a9211850fd89e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10012"
      ]
    },
    {
      "uid": "zhcn:5e8a28888a4297f6ce4003e8",
      "kind": "character_system_text",
      "source_text": "ビビッドでかわいいメガネケース\r\n見つけてさ。誰かプレゼント\r\nしてくれないかな～…ちらっ。",
      "source_fingerprint": "81c593b4c9b09f38fad23f2d0c94d8989a222475bb9354974299c3a5ddacdc32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10013"
      ]
    },
    {
      "uid": "zhcn:98e6a63a48dbefa11267dcc0",
      "kind": "character_system_text",
      "source_text": "誰にも言ってない秘密教えてよ～。\r\nトレちゃんのこと知るのが\r\n1番のプレゼント、つってね。",
      "source_fingerprint": "5e8c99e56b65722a4e84383604095b082daa4f6cfc4dea568d865ea75d2ff363",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10014"
      ]
    },
    {
      "uid": "zhcn:38650abec6003de6c6fb0e81",
      "kind": "character_system_text",
      "source_text": "お、新情報じゃん。\r\nウチもチェックするする～。",
      "source_fingerprint": "bd7a58789c06b37950a84f339b71daac5aae2fcdb4f3b416f968fe26cf905aba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10015"
      ]
    },
    {
      "uid": "zhcn:9a5d17cbd9afbf8de60b144c",
      "kind": "character_system_text",
      "source_text": "お届け物きてるよーん。\r\n開封の儀、する？",
      "source_fingerprint": "66a6455ddfdfc928a0d101a9a3414ea96aa4c4b6c7aae38249cfacf476025585",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10016"
      ]
    },
    {
      "uid": "zhcn:5f37cae0b59b7abbfe18ce64",
      "kind": "character_system_text",
      "source_text": "ミッション達成～。\r\nウチの情報、役に立ったっしょ？",
      "source_fingerprint": "edcf0d4da5a7c7e304d00140e406c9a9d0c9320125bc5986e08080d3c4c16890",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10017"
      ]
    },
    {
      "uid": "zhcn:ec1808b1551ec7adcd4630c6",
      "kind": "character_system_text",
      "source_text": "イベントのお知らせゲット～。\r\n何書いてあんだろ、早く読も。",
      "source_fingerprint": "da3148449c460d0f48c0409e0452411475cd18fa5e1aebbf5f53651480dc6ce1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10018"
      ]
    },
    {
      "uid": "zhcn:b5047f1770b704c36ed53096",
      "kind": "character_system_text",
      "source_text": "楽しげなイベント始まってるよん。\r\nトレちゃん気に入ると思うな～。",
      "source_fingerprint": "11838b9be930115d5ab0b6ec60ac6760d27ade7fb289b20ad33f63e9db6f450a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10019"
      ]
    },
    {
      "uid": "zhcn:e251e1e5a954729c2371a424",
      "kind": "character_system_text",
      "source_text": "ふむむ、やるなぁ。",
      "source_fingerprint": "0ad05533d2a6d13d5c8d8bb2b02c6bbbbce3d8f8e15665397a22ac5ae5b45c81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1002"
      ]
    },
    {
      "uid": "zhcn:81d4fe91ca18ad0a6eeb98dc",
      "kind": "character_system_text",
      "source_text": "名鑑レベル、上がったってさ。\r\nおめおめ～。",
      "source_fingerprint": "9c3123c14fe8924eec67fd9e339c2827ecb90acfe639dd1c67bc6a9822650810",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "10021"
      ]
    },
    {
      "uid": "zhcn:3999412d22c55857ab3da964",
      "kind": "character_system_text",
      "source_text": "五分五分かぁ。",
      "source_fingerprint": "f76e39d45ed041b5725804ce96d68a65fddb04bd41649da384930a58d46a6ac3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1003"
      ]
    },
    {
      "uid": "zhcn:637ec520cd7616068ed0396f",
      "kind": "character_system_text",
      "source_text": "みんなのおかげだよん。",
      "source_fingerprint": "eaa35ccfd0c7f849ab92e2252c01db7c5a802588fa5453f0669a02b465207ed2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1004"
      ]
    },
    {
      "uid": "zhcn:1cdba741e766c43f1587cbe9",
      "kind": "character_system_text",
      "source_text": "ふむむ、やるなぁ。",
      "source_fingerprint": "0ad05533d2a6d13d5c8d8bb2b02c6bbbbce3d8f8e15665397a22ac5ae5b45c81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1005"
      ]
    },
    {
      "uid": "zhcn:9eb7ed7b3024ebcf0434ebbe",
      "kind": "character_system_text",
      "source_text": "五分五分かぁ。",
      "source_fingerprint": "f76e39d45ed041b5725804ce96d68a65fddb04bd41649da384930a58d46a6ac3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1006"
      ]
    },
    {
      "uid": "zhcn:b00edf240806f594ef95358c",
      "kind": "character_system_text",
      "source_text": "お、スコア伸びてる～。",
      "source_fingerprint": "081954eb8cd8e0fe63d13d2b002cfef32c4339bcc7b892d6eb49a5bd350120ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1007"
      ]
    },
    {
      "uid": "zhcn:34153beb10927d2df21c2795",
      "kind": "character_system_text",
      "source_text": "じゃ、いこっか。",
      "source_fingerprint": "990c07543865fa096e579149ca14ccdadfec78abc7ceb8927e290a992d06a489",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1008"
      ]
    },
    {
      "uid": "zhcn:368b81a3bc0d1c6da13a3a43",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "11"
      ]
    },
    {
      "uid": "zhcn:1ee322907cd49ff639131e7b",
      "kind": "character_system_text",
      "source_text": "最先端のトレーニング法、\r\nちゃ～んと仕入れてるよん。",
      "source_fingerprint": "314cd16c2bcee8be039066970b4bd684af82233d05e5be3b552725c1aa21ec61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "110000"
      ]
    },
    {
      "uid": "zhcn:8fe4c82d5879c162fe418d9c",
      "kind": "character_system_text",
      "source_text": "情報の山だな～。\r\nトレちゃんも漁る？",
      "source_fingerprint": "aca8088e8aa6d7eb3fd4e7b85bd7e5bb7291b705d6cc7ff136b4d867dc503d0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "110001"
      ]
    },
    {
      "uid": "zhcn:26bf7f8b4abacd97b0407060",
      "kind": "character_system_text",
      "source_text": "お、レース？\r\nワクワクするのよろ～。",
      "source_fingerprint": "30b29962fef524f6d4ce87c4c6a108bcde56242666ecd831178576b9e79a5c7b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "110002"
      ]
    },
    {
      "uid": "zhcn:cecd20e65ee7d19f9b5f6ebe",
      "kind": "character_system_text",
      "source_text": "ぼちぼち。",
      "source_fingerprint": "76ed340078394dcfa3e6a66aadd766035d10288e33277b1f5272e73658472e6e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1197"
      ]
    },
    {
      "uid": "zhcn:039bac83bb4b48fd9077b49c",
      "kind": "character_system_text",
      "source_text": "いえ～い、コラボ！",
      "source_fingerprint": "a701ac89f910dc286fedaa8f976dbb95bb9897213ddb9acdc6598fc7181fa64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "1198"
      ]
    },
    {
      "uid": "zhcn:12c8cd53c9b3b4982992c44e",
      "kind": "character_system_text",
      "source_text": "ウマ娘、プリティーダービー！",
      "source_fingerprint": "0cfce02d59976c4a687f79d00d7894df0b5a6c879fbee1d653e3f267a88ff06d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "12"
      ]
    },
    {
      "uid": "zhcn:cd356cab49f6ea1f7975ef14",
      "kind": "character_system_text",
      "source_text": "おおおっ、噂以上じゃん…！",
      "source_fingerprint": "aef95d82f1931321014793f829578d6ddee1b3beb880b3c8c8c36362d0d174af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "120000"
      ]
    },
    {
      "uid": "zhcn:7292accfe825ccdd392bec5c",
      "kind": "character_system_text",
      "source_text": "今日のログインボーナスだよん。",
      "source_fingerprint": "637adb455c56dfc5edc46423c39dfb78ee5478715c3881815397db7fa8ea74fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "13"
      ]
    },
    {
      "uid": "zhcn:c81038d93a97cff58fd8bd48",
      "kind": "character_system_text",
      "source_text": "どれいっちゃう～？",
      "source_fingerprint": "9a91990cba2dcfb8c25d2b3053760109ba86390451a0184923e96bc49322c820",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "140000"
      ]
    },
    {
      "uid": "zhcn:b5e99658fae064f8336f796b",
      "kind": "character_system_text",
      "source_text": "やるぅ～。",
      "source_fingerprint": "dd5e88c8e0fe3ba3fc85164fc64bda9b1a0cf238d89defaaa99cf634414ee5cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "140001"
      ]
    },
    {
      "uid": "zhcn:355eda223935988815d08e4a",
      "kind": "character_system_text",
      "source_text": "あれま。",
      "source_fingerprint": "22833cad1abd8ea5fb889be433fc946a5e1331eab97e20d8f27a3a9fd32d3980",
      "source_path": "character_system_text_dict.json",
