        "1080",
        "20049"
      ]
    },
    {
      "uid": "zhcn:78efb89066088db5706b894b",
      "kind": "character_system_text",
      "source_text": "おつおつ～。",
      "source_fingerprint": "d8212a038c58c35c07d6bfc7ae2ecb121fd6ce9381618202f298765572fcd5de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "20050"
      ]
    },
    {
      "uid": "zhcn:06286f94b10f19d5c22feda7",
      "kind": "character_system_text",
      "source_text": "やりますか～。",
      "source_fingerprint": "7ddfa6a8b8fa76ef639759cc8d4d7fa4805ca79e3d1ad63f5f68d765d9d98467",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "2030"
      ]
    },
    {
      "uid": "zhcn:0e717951a6ce0246c257ed4c",
      "kind": "character_system_text",
      "source_text": "じゃ、いこっか。",
      "source_fingerprint": "990c07543865fa096e579149ca14ccdadfec78abc7ceb8927e290a992d06a489",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "2031"
      ]
    },
    {
      "uid": "zhcn:954f884337572b81a7c633d6",
      "kind": "character_system_text",
      "source_text": "おつおつ～。",
      "source_fingerprint": "d8212a038c58c35c07d6bfc7ae2ecb121fd6ce9381618202f298765572fcd5de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "2032"
      ]
    },
    {
      "uid": "zhcn:fd7db44d22c7bc6a9cec3832",
      "kind": "character_system_text",
      "source_text": "情報通り、み～んな仕上げて\r\nきてるねぇ。…んでまあ、ウチらは\r\nその上をいっちゃいましょーってね",
      "source_fingerprint": "eca777a4e57c26e65b4aeee8184b00878b55afa27ec601df5cdd70e029d18d71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "2033"
      ]
    },
    {
      "uid": "zhcn:0f25bda4245c43ed31c82cf3",
      "kind": "character_system_text",
      "source_text": "気分いいから、\r\nカメラ目線で走っちゃおっかな～？\r\n新感覚楽しめそうじゃんね。",
      "source_fingerprint": "f50c75c407aae113a8d1efb117ae6609b0d9ab0923749b1325ba71605b65f745",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "2034"
      ]
    },
    {
      "uid": "zhcn:150631b1ef63dea2412420eb",
      "kind": "character_system_text",
      "source_text": "おつおつ～。",
      "source_fingerprint": "d8212a038c58c35c07d6bfc7ae2ecb121fd6ce9381618202f298765572fcd5de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "2035"
      ]
    },
    {
      "uid": "zhcn:cba3b59674c0a9f55be9053d",
      "kind": "character_system_text",
      "source_text": "さて。",
      "source_fingerprint": "4ccc0a4c1d8553a1216b70a22cc2817117c30e5db50980ed67df860ae5ad58f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "23015"
      ]
    },
    {
      "uid": "zhcn:48db657a33d9bf3726e263f7",
      "kind": "character_system_text",
      "source_text": "収穫はあったよん。次こそ…！",
      "source_fingerprint": "fa743534787fd8d6a0630aee73a8384b6738bcae07716f1efdc6ae40f20d744e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f50dd8aa21534cfb8a29da3e",
      "kind": "character_system_text",
      "source_text": "まだまだこっからっしょ。",
      "source_fingerprint": "4b344e777f7805e25999ddb1aa807a73d32cad947e4233a97b63a69bc965f44d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "30001"
      ]
    },
    {
      "uid": "zhcn:ef5b5cc56836579451c66fb8",
      "kind": "character_system_text",
      "source_text": "情報、アプデしないと…。",
      "source_fingerprint": "15d5384ca3e823ca37108641670eaf390a0a79080c04ad51b3490c6c054827c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "30002"
      ]
    },
    {
      "uid": "zhcn:16a9e203e07b57a41e9987d7",
      "kind": "character_system_text",
      "source_text": "もっとワクワクしたいのに～…！",
      "source_fingerprint": "dd60060d028ed3f6214a96922310f5118c8f201baf0471b4951ed583584b3772",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "30003"
      ]
    },
    {
      "uid": "zhcn:2d8e4734240ff2d3531e1f5c",
      "kind": "character_system_text",
      "source_text": "う～～ん…！\r\nゾクゾクしたぁ。",
      "source_fingerprint": "9a701ad87d0f233c2feccf3083d12504cadeddfb292c710e34e411c7202eaa31",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "30004"
      ]
    },
    {
      "uid": "zhcn:c2dd5c85c431f59b493990f7",
      "kind": "character_system_text",
      "source_text": "大勝利～。\r\nこれ、特ダネっしょ？",
      "source_fingerprint": "f7e94d40e4880a0169b6f5809a13e0ddbb036fc282d452462338357513c4a518",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "30005"
      ]
    },
    {
      "uid": "zhcn:b52926722abf0d6fc3f279e1",
      "kind": "character_system_text",
      "source_text": "行きますか～。",
      "source_fingerprint": "9b184c7bb1eeb3775f27f6ca44b5d4aa66ff598852775379db99aa5fbee99af1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "31000"
      ]
    },
    {
      "uid": "zhcn:a2fdc982d07a232d955a1bdc",
      "kind": "character_system_text",
      "source_text": "ほい、いただき～。",
      "source_fingerprint": "c1c818b251d83c349eea8adff87a3be707a805348dbeb04d4fea62d89b9e204e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "40000"
      ]
    },
    {
      "uid": "zhcn:5df97ba36a5dc263f9804c88",
      "kind": "character_system_text",
      "source_text": "知りたい…もっと知りたい。\r\n激やば情報、未知の世界…！\r\nあはっ、最高～。",
      "source_fingerprint": "d70ab2d650c04a902a8f8d58b1d2d0398d47597168c4b2c5fb376862c194e353",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "40001"
      ]
    },
    {
      "uid": "zhcn:b76476514699f971f6c2afda",
      "kind": "character_system_text",
      "source_text": "ねね、まだ～？\r\n先飛び出しちゃうぞ～？",
      "source_fingerprint": "f96d42f8d631a4606d3b8623fe385ee5b684a641a060bb99fd222055326f1267",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "60000"
      ]
    },
    {
      "uid": "zhcn:bbb9ea9c9cc9003e3aaa52e7",
      "kind": "character_system_text",
      "source_text": "息苦しいくらいの熱気！\r\n～～っ、ゾクゾクしちゃうね～。",
      "source_fingerprint": "80d29ea61f20a66aa63c36e14dbd4f15d2f79883f19187bfd427a26eb2961933",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "60001"
      ]
    },
    {
      "uid": "zhcn:a26ba164642546c7df3b30d9",
      "kind": "character_system_text",
      "source_text": "トレちゃん、次はなに試す？",
      "source_fingerprint": "01016fd962cbb2f49c5aec344f303302c8b408387c18a2d11602f242cafc23d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70000"
      ]
    },
    {
      "uid": "zhcn:63f3923371066995ce050f8e",
      "kind": "character_system_text",
      "source_text": "ウチらのつき合いも\r\n長くなったよね～。\r\nおかげさまで、まー楽しいよ。",
      "source_fingerprint": "91d27ba5c6bbe941b7c417d9e373ec9db0b27c0ba58385bcdb9588346098b903",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70001"
      ]
    },
    {
      "uid": "zhcn:811aecf75a325f553fe526c5",
      "kind": "character_system_text",
      "source_text": "学園生って信用あるじゃん？\r\n制服だと聞き込みが楽でよき～。",
      "source_fingerprint": "91cbc872576575c4fad373def3cbb73603b889857b3e1998e5b68a84a53138d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70004"
      ]
    },
    {
      "uid": "zhcn:bd699742016af6fa32f138bc",
      "kind": "character_system_text",
      "source_text": "かわいいっしょ～？\r\n正直に言いなって～。",
      "source_fingerprint": "2f2048104b0264acae550becc3e3f0e580b7ebbeb0f2bd16c18c6cf3dcb55f0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70008"
      ]
    },
    {
      "uid": "zhcn:322793156dc7676e9cf0558b",
      "kind": "character_system_text",
      "source_text": "やっぱベルトは巻いてなんぼ。\r\nもっと足してもいいかも～。",
      "source_fingerprint": "62b2f663d5b3af73fbea9c18b61e70d4ae5514080290f9c6be7607ee54ee5651",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70009"
      ]
    },
    {
      "uid": "zhcn:b37e1a5580967f7182bc0939",
      "kind": "character_system_text",
      "source_text": "フィット感がたまらんねー。\r\n素材に秘密アリと見た。",
      "source_fingerprint": "3155eb349e7ed7b8b63d7b7f586d20912710878e0dab6711241fbe70db017e51",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70010"
      ]
    },
    {
      "uid": "zhcn:1caf4b89beb9d3edf91ebc0a",
      "kind": "character_system_text",
      "source_text": "センターのドキドキ、\r\n病みつきになっちゃってさ～。",
      "source_fingerprint": "1d10516f7faa22d55748c324cbfdfde3fca940467474fa6339553ffc420be6d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70014"
      ]
    },
    {
      "uid": "zhcn:2d11fdb1ea57ecfc4ee1c90e",
      "kind": "character_system_text",
      "source_text": "レース中は伊達眼鏡オ～フ。\r\nガチだかんね。",
      "source_fingerprint": "749a52abbd78117d81b6693633be85eda88a0d23ba612d294a9a542eba1bf830",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70015"
      ]
    },
    {
      "uid": "zhcn:c0e1eb9bacb78b5e43a59dc3",
      "kind": "character_system_text",
      "source_text": "面白い作りだね。\r\n調べてみよ～っと。",
      "source_fingerprint": "333da50d4db4c79e17c88d1b8c15ebc73d33a1a552c156ce4b84711dfa98150b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1080",
        "70018"
      ]
    },
    {
      "uid": "zhcn:2a6055df4d9894adbce0ec62",
      "kind": "character_system_text",
      "source_text": "どこに電子メモしまおっかな～。",
      "source_fingerprint": "a36110d415c4652fa0621308fe8325fe21878f63fad28f964aecaf211787d6e8",
