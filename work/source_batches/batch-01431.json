      ]
    },
    {
      "uid": "zhcn:7d57a1d7f55e72a58310314d",
      "kind": "character_system_text",
      "source_text": "やっぱ相性いいよね、ウチら。",
      "source_fingerprint": "132fc76bae7a007f08d3e3c60be5d8add3bfaf34f810e0668b9131f149592e77",
      "source_path": "character_system_text_dict.json",
