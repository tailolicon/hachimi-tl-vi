      ],
      "json_pointer": "/1081/20030"
    },
    {
      "uid": "zhcn:126b9d14634706dddcac006c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "唔呜～～……。\r\n——才、才没有紧张呢！\r\n这可是战栗不已的干劲啊混蛋！",
      "source_fingerprint": "3b79117d2232826bf6ee5fd9e391a1d03bcc11fb8c40e59dc16c04df01c73f26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20031"
      ],
      "json_pointer": "/1081/20031"
    },
    {
      "uid": "zhcn:f4109b238eaa69a22c62588e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "那什么表情。是想说我状态不好吗！？\r\n别瞧不起人，来单挑啊！",
      "source_fingerprint": "1a3fb608a1824bb524efa04f0a915ddf16ec0707f9f1ba7cead827f622d80f32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
