    {
      "uid": "zhcn:b2151bf6a7861e98d2f2b38d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "起跑加速、节奏把控……\r\n得一个一个搞定才行。\r\n……怎么，有意见吗？",
      "source_fingerprint": "cc5d71bcd7792450de120495501bea8891196492d40edbbb69e7039b23577536",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
