      "json_pointer": "/1081/20033"
    },
    {
      "uid": "zhcn:36d907a59335b476abd37808",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "是我比较强……！\r\n绝对，绝对……！\r\n这就证明给你们看……！",
      "source_fingerprint": "ea8242721f03004f1e7ec244f0996b29a074a2f8be5a9c5556aa15eb06ca94fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
