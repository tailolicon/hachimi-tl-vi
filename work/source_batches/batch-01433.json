      ],
      "json_pointer": "/1081/20032"
    },
    {
      "uid": "zhcn:6f761693e0904342450199c0",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这种程度的逆境，轻松就能甩掉！\r\n老子才不是那种因为状态不佳\r\n就会被压垮的弱鸡！",
      "source_fingerprint": "5c3792b92cf2b48a6c4d2883e87d3ec5eb24899402380d00bee2dd7baaf505da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
