      ],
      "json_pointer": "/1082/20005"
    },
    {
      "uid": "zhcn:05363adb4e3e41602f4b75e7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "地道な努力がいつか実を結ぶ…\r\nわたしのペースで、\r\n前進あるのみですね。",
      "source_fingerprint": "df6b0ea2409b001093a62f6c3d60edd900be0970caa1c3f48746dba339df2a03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
