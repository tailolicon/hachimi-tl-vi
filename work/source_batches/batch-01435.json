        "1082",
        "20003"
      ],
      "json_pointer": "/1082/20003"
    },
    {
      "uid": "zhcn:c82a3c14f92853959d1caf4f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "うん、いい調子。\r\n風に揺れるスカートのように\r\n脚がとっても軽いです。",
