    },
    {
      "uid": "zhcn:15519d66cd30f8fc41d34b8f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "新しいアイディアが浮かんだとき\r\nみたいに、ワクワクしています。\r\nいい成果を出せそうです！",
      "source_fingerprint": "9a6fe5b1688c16f8d2d25bbd961792c8562776cb18b7ad41c42a61495d208c33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
