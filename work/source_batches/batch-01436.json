        "1082",
        "400012"
      ],
      "json_pointer": "/1082/400012"
    },
    {
      "uid": "zhcn:2d704c2ef0ec15d9fc5915db",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "服装も気持ちも、最後まで\r\nビシッと決めていきましょう！\r\n報酬の受け取りもお忘れなく。",
      "source_fingerprint": "86fb57b07b60f773902735b96dff3d7ab51594de7b37016d62d79e6d115e1d56",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400013"
      ],
      "json_pointer": "/1082/400013"
    },
    {
      "uid": "zhcn:7c5f499d6bc6d4fb2d3c0825",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "金花酱在分别时送给我的\r\n香囊…散发着温柔、温柔的香气\r\n――谢谢你，我会加油的。",
      "source_fingerprint": "ecbff96f86c7d63781c1ca101b8d4d6543a1972695715a77baf1190f3b363bbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400128"
      ],
      "json_pointer": "/1082/400128"
    },
    {
      "uid": "zhcn:aafccffbba43ac7c820e15fb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "誰よりもまぶしく輝いちゃいましょう。",
      "source_fingerprint": "494e18eeb4bf9a60f58dc8fce5e7617384a4364fd57e8d2940771736acce298f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
