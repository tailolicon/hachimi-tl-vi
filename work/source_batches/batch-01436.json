    },
    {
      "uid": "zhcn:cd2040468ef46f08917de5b9",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "おはようございます！\r\n今日の気分に合わせたコーデ、\r\nいっしょに考えませんか？",
      "source_fingerprint": "c9ca2d175269d4f8aee5da3b9f518758a4ce1805e9ea695edf2969eb8a539110",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
