    {
      "uid": "zhcn:d7f450a809199e40bda6c9a8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "お疲れさまです",
      "source_fingerprint": "4dbe6383c3cb7e0c632e2d7584ca291cdc7fcd493f936c1caeff6f5ca6323ea5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
