      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20001"
      ]
    },
    {
      "uid": "zhcn:d4bd7e9166031ae6743311f3",
      "kind": "character_system_text",
      "source_text": "我现在精神饱满哦！好啦好啦，\n快点开始训练吧～♪",
