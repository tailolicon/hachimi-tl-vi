      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "110002"
      ]
    },
    {
      "uid": "zhcn:4815717c229d13c877359ffb",
      "kind": "character_system_text",
      "source_text": "只要努力的话……！",
      "source_fingerprint": "7de66f8efc4f12b0b005cb431ffb06976b59d7361d70f186c8168db51519d84a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
