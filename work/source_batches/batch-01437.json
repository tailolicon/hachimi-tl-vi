      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1069",
        "20002"
      ]
    },
    {
      "uid": "zhcn:e43556a72e6f1df861c80d90",
      "kind": "character_system_text",
      "source_text": "加油～OH！千代・OH！\n嘿嘿！因为马上就可以跑步，实在是太开心了！",
