    {
      "uid": "zhcn:01997c8bf1b623ba7320c67c",
      "kind": "character_system_text",
      "source_text": "Show time──对吧……",
      "source_fingerprint": "b61cd657cd4d0f1a461b66eed510df27ab37a39d3266d18ec7660c565b15fcdb",
      "source_path": "character_system_text_dict.json",
