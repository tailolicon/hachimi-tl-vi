      ]
    },
    {
      "uid": "zhcn:0805b512ed0c9804bad043c2",
      "kind": "character_system_text",
      "source_text": "知道厉害了吧，噢啦！",
      "source_fingerprint": "a8fa91c86a4fc96caf688e26accad8987732cdd1b4fabc3f12109d5264f1c5ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "2035"
      ]
    },
    {
      "uid": "zhcn:b506309603ef21a821553f44",
      "kind": "character_system_text",
      "source_text": "噢啦噢啦！",
      "source_fingerprint": "ad0d56b4acee54b11beec52fc09744768ac7e258973e78fca66cdacb864ea192",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "23015"
      ]
    },
    {
      "uid": "zhcn:ec728c03190f19783c2f3a71",
      "kind": "character_system_text",
      "source_text": "下次绝对要甩开所有人！",
      "source_fingerprint": "11295734f138a34632372f67e2a8a727c99777ec068405cded12f09f2fbc7eeb",
      "source_path": "character_system_text_dict.json",
