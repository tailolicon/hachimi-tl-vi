      ]
    },
    {
      "uid": "zhcn:b636393401f74b490e7bfc55",
      "kind": "character_system_text",
      "source_text": "做得很好。",
      "source_fingerprint": "236e525eaf465869104480728930d1a18ea575a313bfddfa361a15b518a23e56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140004"
      ]
    },
    {
      "uid": "zhcn:7f575f1e835331a41e818360",
      "kind": "character_system_text",
      "source_text": "被黑暗吞噬了啊……",
      "source_fingerprint": "fa912f0f1708efb7de88f615ba7e199a9836a3f243b353b08a814f04045fe81f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140005"
      ]
    },
    {
      "uid": "zhcn:028eedc839ec67ff515ad44a",
      "kind": "character_system_text",
      "source_text": "传颂吧。",
      "source_fingerprint": "7c577350b085d0cac44c3b1e0ef314e8f4532cc3d7b26e438c5eb7edfaf2e3e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140006"
      ]
    },
    {
      "uid": "zhcn:b2c2734329ff2b4b07565966",
      "kind": "character_system_text",
      "source_text": "做得很好。",
      "source_fingerprint": "236e525eaf465869104480728930d1a18ea575a313bfddfa361a15b518a23e56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140007"
      ]
    },
    {
      "uid": "zhcn:9385adfca886b3d88ad7c8db",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140008"
      ]
    },
    {
      "uid": "zhcn:239fd69247823a952ccb1c9b",
      "kind": "character_system_text",
      "source_text": "哈──哈哈！",
      "source_fingerprint": "b606fb34bf848de805742a125f2904cb099d9e31ad81a0ac3f8448c21c7c4fae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140009"
      ]
    },
    {
      "uid": "zhcn:f29df0f765e958a3da7394e9",
      "kind": "character_system_text",
      "source_text": "呵！",
      "source_fingerprint": "e358f3890b1a24b9bcb6526889cfb39fb6444a5068f0fe4d0662096fd4a6d151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140010"
      ]
    },
    {
      "uid": "zhcn:d38392598b294bb4f7565f03",
      "kind": "character_system_text",
      "source_text": "哦……！",
      "source_fingerprint": "e8a047e6d033874db4c41eea1841321bf4c7b84166b9be8490dc39921d6d502b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140011"
      ]
    },
    {
      "uid": "zhcn:08ae5a3a3248df58f3a1c618",
      "kind": "character_system_text",
      "source_text": "什么！？",
      "source_fingerprint": "8fae634bd9fed421672fb72e9b24f793384cadde5c35454a04573eec752d6239",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140012"
      ]
    },
    {
      "uid": "zhcn:1fb0e757e7e920fff601956a",
      "kind": "character_system_text",
      "source_text": "哦哦！",
      "source_fingerprint": "491afe930290ca00537960230e3bbc3448d690ce63dc08b63e2557d06bba67b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140013"
      ]
    },
    {
      "uid": "zhcn:4c4d3158b1d0892f2c3109b7",
      "kind": "character_system_text",
      "source_text": "唔。",
      "source_fingerprint": "533af1ec55aaabd2fb64979f1b375b53b2aa3d91c5132bfaaf1eceef39f399ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140014"
      ]
    },
    {
      "uid": "zhcn:5cc4e331611947147aafec6a",
      "kind": "character_system_text",
      "source_text": "哼……",
      "source_fingerprint": "f21bed79927e5236d335292545e9ebd0f5f41ee49249a49856519a27ee9095c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140015"
      ]
    },
    {
      "uid": "zhcn:5774d2258014a95e29cbfde0",
      "kind": "character_system_text",
      "source_text": "快上吧！",
      "source_fingerprint": "f5ff5cce81279530c135c050e17109de8add1ffa81928fb66087b20c046edd58",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140016"
      ]
    },
    {
      "uid": "zhcn:b27f661a9a9df3c30706eb45",
      "kind": "character_system_text",
      "source_text": "唔……",
      "source_fingerprint": "57a4e1df408b325e7498dd0dbd16dfa65e96cd654a4bab6bba7b78f0a47f36a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140017"
      ]
    },
    {
      "uid": "zhcn:957416d4410c51a80728613e",
      "kind": "character_system_text",
      "source_text": "啊啊……",
      "source_fingerprint": "67d0eeceded72eace8823cc24b753a0a3007c8ea0e0a4fc8073e9cf559b5eb03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "140018"
      ]
    },
    {
      "uid": "zhcn:29908c47a2285c3ee21d5c4a",
      "kind": "character_system_text",
      "source_text": "明天好像能拿到这个。",
      "source_fingerprint": "05455df9a61eff2f59cb5dc2bf0840682d0169c42988968da22137fe1da487b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "15"
      ]
    },
    {
      "uid": "zhcn:eacb5032be4f43979188c29b",
      "kind": "character_system_text",
      "source_text": "喔喔，全知的神啊……！\r\n请赐吾一滴活力……！",
      "source_fingerprint": "8ab257dee9693c33c243f22058ccafd4e770c3d787f328087f1110a823269d82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20000"
      ]
    },
    {
      "uid": "zhcn:9e11ceab7d719483acbd6f1c",
      "kind": "character_system_text",
      "source_text": "……唔？喔，是你啊。\r\n……我刚做了场白日梦。",
      "source_fingerprint": "ff5a10ea74d6d838a4d5868225bbe88d19b322ce3e39e02a7e0beaf0bce3553c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20001"
      ]
    },
    {
      "uid": "zhcn:c3c42a8d6c7e3dfcc839eab2",
      "kind": "character_system_text",
      "source_text": "哈──哈哈哈哈！\r\n破坏冲动直冲脑门！\r\n栅栏！栅栏！哪里有栅栏！",
      "source_fingerprint": "f31329e8fa7e357bc221deaeb0e4f21bcf152554f61416168f3efb8a88e9734a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20002"
      ]
    },
    {
      "uid": "zhcn:af513a457c7d252e19de8585",
      "kind": "character_system_text",
      "source_text": "开始吧！\r\n若凭借着吾与你的恶梦──\r\n要颠覆世界也谓是轻而易举！",
      "source_fingerprint": "ef0582ac566f263dbac9b68a1ca0fa7fd5b10f85b90f562f0e3075610a8e7503",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20003"
      ]
    },
    {
      "uid": "zhcn:2ae4463290eb5a7fa1fb9ca3",
      "kind": "character_system_text",
      "source_text": "西风向吾低语──\r\n要吾化作划破天空的风！\r\n上吧，开始训练了！",
      "source_fingerprint": "42090eaaf3081f1643ac8041d5ceb0521fde1e1c2c4c0c47c6893fbeb838d36e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20004"
      ]
    },
    {
      "uid": "zhcn:4a7ea98682e5c3132066342f",
      "kind": "character_system_text",
      "source_text": "训练项目就交给你决定。\r\n尽管改写我的剧本吧！",
      "source_fingerprint": "ea660077aec20bba5ce905898bc857c964a2df3f6effd37061ed735928feff94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20005"
      ]
    },
    {
      "uid": "zhcn:efc6d25b72cf2304f3d249d3",
      "kind": "character_system_text",
      "source_text": "亘古不变的日子也不赖。\r\n好了，今天要描绘点什么呢？",
      "source_fingerprint": "cb341e09b276e752c6f8b88ca0d9e453954af9567803867c9682abd50dfe6840",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20006"
      ]
    },
    {
      "uid": "zhcn:6bc7ef2e1f752624c95dbc7f",
      "kind": "character_system_text",
      "source_text": "风平浪静──没什么，\r\n只是这句话突然浮现在脑中。",
      "source_fingerprint": "75ec663dfd0f9c63ae34a941e046d7921688c40ba4f1df927a8511b47814b0fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20007"
      ]
    },
    {
      "uid": "zhcn:2896acf27fe8636530f7009f",
      "kind": "character_system_text",
      "source_text": "唔……！深渊的安宁\r\n呼唤着吾……！",
      "source_fingerprint": "e824fc278c8c1e389c306703d21b8b4b712a4e5ebc6962941b9e9a968fb58c8e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20008"
      ]
    },
    {
      "uid": "zhcn:499b0076add02186c8822ed8",
      "kind": "character_system_text",
      "source_text": "啊啊……力量在……！\r\n咒术啊，难道你要吞噬我吗！",
      "source_fingerprint": "93f4bf8a29ba95f5ae80be26c9eba5d322de082cbe1d45519fe696632eb7c402",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20009"
      ]
    },
    {
      "uid": "zhcn:58b790b01af6c004b0efb3c6",
      "kind": "character_system_text",
      "source_text": "……呵。\r\n……今天打烊了。",
      "source_fingerprint": "0155de8c283c16dc3a6dd62ec2c1d737544fd51633456ae157485d5df3138d72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20010"
      ]
    },
    {
      "uid": "zhcn:115e9e96a7a1e7385e8bfeea",
      "kind": "character_system_text",
      "source_text": "……好想喝爸爸调制的\r\n无酒精热鸡尾酒……",
      "source_fingerprint": "2414870a39ea4db9afdc0242ef3df80e007de0f323f48dc30857e424883b9cd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20011"
      ]
    },
    {
      "uid": "zhcn:639a04ac08df28ac25a389fd",
      "kind": "character_system_text",
      "source_text": "我有天赋。\r\n但并非是半神半人──！\r\n别急着下决断，深思熟虑吧。",
      "source_fingerprint": "d1fb0f2651c3770a020fd6a5788bac0ceef7e6baeecaf087b0f07d5362a53d11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20021"
      ]
    },
    {
      "uid": "zhcn:40a39e0a2ea0eb523e56694c",
      "kind": "character_system_text",
      "source_text": "真是愚蠢……醒醒吧！\r\n难道你迷失了自己的使命吗！",
      "source_fingerprint": "d785793b33a53af84245a7ed0617c6bdc25cc25f07d357d39421944685c9981c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20022"
      ]
    },
    {
      "uid": "zhcn:75dbc6c9fc1f91e521ce6c33",
      "kind": "character_system_text",
      "source_text": "哈──哈哈哈！\r\n时机成熟了！\r\n来吧，出航前往理想乡！",
      "source_fingerprint": "02a41e104226e60df452328e3b1f7e534543127e2212dabd6f5da4714b684774",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20023"
      ]
    },
    {
      "uid": "zhcn:1040c254d2bba68acbe033aa",
      "kind": "character_system_text",
      "source_text": "我的状态已达颠峰！\r\n有如身披灼热的炼狱火焰！让我在\r\n赛场上烙下永世无法抹灭的痕迹吧！",
      "source_fingerprint": "d1176dafb3c7178b4d0867eb0e1e8278ecbe0b540a924b1a83e4320fbd69b207",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20024"
      ]
    },
    {
      "uid": "zhcn:cba0ee3ed02b8343f05c358e",
      "kind": "character_system_text",
      "source_text": "呵呵呵……！哈──哈哈哈！\r\n烙印在大脑、视网膜、记忆中吧！\r\n这就是吾的存在意义！！",
      "source_fingerprint": "4ec5a67e8871495b5b269665d1d813548a483f1cfe518d4372f95e72b5df050b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20025"
      ]
    },
    {
      "uid": "zhcn:0a4f911c045eb164fed673bf",
      "kind": "character_system_text",
      "source_text": "我已完成了理想的调整。\r\n来，一起携手等待终焉吧！",
      "source_fingerprint": "2070a1e5ebeef8f584129db1a64be967175c7438408ddf3c5c5a380683de42b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1084",
        "20026"
      ]
    }
  ]
}
