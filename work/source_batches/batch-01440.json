  "entries": [
    {
      "uid": "zhcn:f7b1eec40d5245b795f2b829",
      "kind": "character_system_text",
      "source_text": "给他们点颜色看看，你们几个！",
      "source_fingerprint": "7d5fddf92a3ac0658b42a2231a8a16fac1e28c8aea6f6fc003c2f8ab2ce5e332",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "1008"
      ]
    },
    {
      "uid": "zhcn:271ac055ce02254f6588275f",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "11"
      ]
    },
    {
      "uid": "zhcn:d5e0c651f5842e0d63e62db8",
      "kind": "character_system_text",
      "source_text": "训练……？\r\n不管什么都尽管来啊！！",
      "source_fingerprint": "efa4acad374710adea01a6b3d943390bf2230087264b7b319907f1db7a1ebd4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "110000"
      ]
    },
    {
      "uid": "zhcn:9ba6547fb8bab0115733b314",
      "kind": "character_system_text",
      "source_text": "学院的历史啊。\r\n那种东西，老子来改写给你看！",
      "source_fingerprint": "8a2cedaf2e0c7d53119c9072c5791b606635238867ed7fc1963546f83bbc2603",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "110001"
      ]
    },
    {
      "uid": "zhcn:7c1de328e365c926710ca798",
      "kind": "character_system_text",
      "source_text": "比赛啊！\r\n让你见识一下什么叫最强！",
      "source_fingerprint": "b36a2fb9ed08afa671ee0b149c56c0f3caae0a88c4abd12666aba97dd79e3aeb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "110002"
      ]
    },
    {
      "uid": "zhcn:53d001785b632f9168b69d15",
      "kind": "character_system_text",
      "source_text": "赛马娘，Pretty Derby！",
      "source_fingerprint": "bb83cf4ef414ba1498ca22eb71c89743df595040a09f9d503fb2e9db9beca0d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "12"
      ]
    },
    {
      "uid": "zhcn:5fb904328a9a849429ebc597",
      "kind": "character_system_text",
      "source_text": "总感觉，整个人都燃起来了！",
      "source_fingerprint": "9f5f04d74f08145fdc5706488e68c26b5796e8dfabcf575b1a03011580c353ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "120000"
      ]
    },
    {
      "uid": "zhcn:aa5195dae55f87018592a94d",
      "kind": "character_system_text",
      "source_text": "别怂啊！！",
      "source_fingerprint": "af178074a4761518a2eb14b840c2c2a5d98435542d0bd6b11d741693573b3588",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "1221"
      ]
    },
    {
      "uid": "zhcn:b483156e63897cd9e604d099",
      "kind": "character_system_text",
      "source_text": "把你干碎！",
      "source_fingerprint": "aec8112e291124a7f7300158a1f014f3429ae4bbc447b296b93325caff10ca1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "1243"
      ]
    },
    {
      "uid": "zhcn:ce33b12e83a8c51b1de59d0f",
      "kind": "character_system_text",
      "source_text": "撞烂他们！",
      "source_fingerprint": "5fdc56c886c2171b43112b887a8309d06614b9d6b266ba485f0710bc29b5ea85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "1244"
      ]
    },
    {
      "uid": "zhcn:1cb283de77b7f1d38004c553",
      "kind": "character_system_text",
      "source_text": "说是登录奖励哦。\r\n喂，赶紧给老子领了。",
      "source_fingerprint": "1d63a68bfc43177a99611fff27c63b557ed66f1dcba3f14832ab8d50077c8704",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "13"
      ]
    },
    {
      "uid": "zhcn:8eb0df76267cf846377d0377",
      "kind": "character_system_text",
      "source_text": "把那帮家伙连根拔起，噢啦！",
      "source_fingerprint": "f3bf3962ff439d22526eb1f77083f57022fc979a35ca9a200fd8f818215c82cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140000"
      ]
    },
    {
      "uid": "zhcn:275ff7f672a54e221601e04c",
      "kind": "character_system_text",
      "source_text": "好耶！",
      "source_fingerprint": "61001b03d3bd62444b0e3108412891d24ae8c73521b01502f1ef914bf0928b70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140001"
      ]
    },
    {
      "uid": "zhcn:d90b440dde3dd95d5cd32ce2",
      "kind": "character_system_text",
      "source_text": "可恶！",
      "source_fingerprint": "20b6ae424ee4b401419c35c536777fe7fbc81ed6c912a347267fb4c85ca3171a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140002"
      ]
    },
    {
      "uid": "zhcn:19ca0f9209bb38ea2ba4cbd6",
      "kind": "character_system_text",
      "source_text": "哼哼，大丰收大丰收！",
      "source_fingerprint": "66abab6121dfe7685a899caa63e44bc11e2bed0a96e64c00bdeda3ac4ae52187",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140003"
      ]
    },
    {
      "uid": "zhcn:c6332a1b78deb9e777697060",
      "kind": "character_system_text",
      "source_text": "嘛，也就这种程度吧。",
      "source_fingerprint": "36af851c319bc2e198e2be7c81435e21e337db71a388f1a61399aa6f5b78020c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140004"
      ]
    },
    {
      "uid": "zhcn:4413a87bd6329842cd983ca4",
      "kind": "character_system_text",
      "source_text": "绝对要复仇！",
      "source_fingerprint": "0734239956e82ec5f335ec1d2353a5ade734ae9861a9ec9a0260c8129474a56e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140005"
      ]
    },
    {
      "uid": "zhcn:86f5a8b310df8bfc49549640",
      "kind": "character_system_text",
      "source_text": "哼哼，大丰收大丰收！",
      "source_fingerprint": "66abab6121dfe7685a899caa63e44bc11e2bed0a96e64c00bdeda3ac4ae52187",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140006"
      ]
    },
    {
      "uid": "zhcn:1308a62d48ff0ac7962835bc",
      "kind": "character_system_text",
      "source_text": "嘛，也就这种程度吧。",
      "source_fingerprint": "36af851c319bc2e198e2be7c81435e21e337db71a388f1a61399aa6f5b78020c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140007"
      ]
    },
    {
      "uid": "zhcn:a7ab736c87faad7e02397d48",
      "kind": "character_system_text",
      "source_text": "给老子撞碎它！",
      "source_fingerprint": "7d144ab520a4b92fe546a348e34f084d6af30f6a8a9833c870aa8a94bcf25221",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140008"
      ]
    },
    {
      "uid": "zhcn:860e92159d05b1971dd8a94b",
      "kind": "character_system_text",
      "source_text": "还是大的比较好吧。",
      "source_fingerprint": "0c4d87b4f15d7e50f68322e34db9fe8e41a2d74c9136b4221095496159143a57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140009"
      ]
    },
    {
      "uid": "zhcn:614408ce4d0f92dcf99228c0",
      "kind": "character_system_text",
      "source_text": "嗯～……",
      "source_fingerprint": "b44f0ced1c9eefcb4c785ebf99fa75fa7a9b475fd90ec6fdc1c54f86243188ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140010"
      ]
    },
    {
      "uid": "zhcn:324b5dbcca6c36d52ba29305",
      "kind": "character_system_text",
      "source_text": "太好了！",
      "source_fingerprint": "2deba7ca30c98238317c64bb01282f7578b945b19432461c4536c6681ac4b8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140011"
      ]
    },
    {
      "uid": "zhcn:84f7993cbb8f40e3779d91cc",
      "kind": "character_system_text",
      "source_text": "好嘞，拿下了！",
      "source_fingerprint": "d1023fec6b099de3a2279889bd6116e0c1619b7cd5a159c25221288f876b2e5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140012"
      ]
    },
    {
      "uid": "zhcn:862ef04b6d2d18643c3c09b7",
      "kind": "character_system_text",
      "source_text": "噢啦噢啦噢啦噢啦！",
      "source_fingerprint": "1517060d28e8750c9ab72906d8295015aa757d172662bd85dc8c03da7236e9ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140013"
      ]
    },
    {
      "uid": "zhcn:7f52bbd133c80628769a694e",
      "kind": "character_system_text",
      "source_text": "啊，逃走了！",
      "source_fingerprint": "ae89a92e764ecc9b9fc8d773d77e76d80366f7ece1e4d14d8cf0a014d85190be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140014"
      ]
    },
    {
      "uid": "zhcn:dc21d1fa97639c7fa0af5251",
      "kind": "character_system_text",
      "source_text": "上吧……！",
      "source_fingerprint": "fffa89d48f387e8f26e4be734fffbb101d7c11ea4da29970e28fa7eb3d00c047",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140015"
      ]
    },
    {
      "uid": "zhcn:da872a2abd675ea05737b840",
      "kind": "character_system_text",
      "source_text": "喂，别发呆啊。",
      "source_fingerprint": "26250f9f8862e4d8cf85232228621bebd3bc79512268a60d5324266ff38dc3ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140016"
      ]
    },
    {
      "uid": "zhcn:40abc6dc4e6690dc368c05dd",
      "kind": "character_system_text",
      "source_text": "为什么啊——！！",
      "source_fingerprint": "2b533ff310f596856e1c4350b64ab278495a06633fae67143fd92ed7bbc8bc61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140017"
      ]
    },
    {
      "uid": "zhcn:0e0e74f0cea4ce4a96e037f4",
      "kind": "character_system_text",
      "source_text": "唔唔唔唔……！",
      "source_fingerprint": "80cf22f59621131d9329909005bacc3183bd7be2eab93c85eb0ca243074110ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "140018"
      ]
    },
    {
      "uid": "zhcn:a66e8ed9125dd3b24bf96b80",
      "kind": "character_system_text",
      "source_text": "明天能领的是这个。",
      "source_fingerprint": "d1eb8b293dd01a68d9de92c085cc2ca8cf2de7c62c8de78c633129c55240a072",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "15"
      ]
    },
    {
      "uid": "zhcn:927f0e21ac768689b77f59b9",
      "kind": "character_system_text",
      "source_text": "呼————……。\r\n——啊！？这不是因为我虚弱了！\r\n老子游刃有余着呢！",
      "source_fingerprint": "3d014f5061c1c423feada149070f2d7250970efebb72dd965cd3893fd86a2255",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20000"
      ]
    },
    {
      "uid": "zhcn:9be7bda5b8dafa0b1ea0168e",
      "kind": "character_system_text",
      "source_text": "喂，你该不会打算今天也要训练吧！\r\n给我稍微休息一下啊，你个大、大、大笨蛋！",
      "source_fingerprint": "4f2e9aa265eda0117697e03f2d664993b67f84c6acbe4f9962b310755f11dc63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20001"
      ]
    },
    {
      "uid": "zhcn:7961e605c94e4670508572db",
      "kind": "character_system_text",
      "source_text": "今天我要拼命锻炼！\r\n把最硬核的菜单拿出来！",
      "source_fingerprint": "0600675976099eeda45993819afde81af5c1f5c44afbff87c79e987174eb8cd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20002"
      ]
    },
    {
      "uid": "zhcn:d3ecf8922c314c24b398364c",
      "kind": "character_system_text",
      "source_text": "噢啦噢啦！不管什么都来吧！\r\n无论你出什么任务，我都会\r\n轻轻松松地搞定！",
      "source_fingerprint": "364e706073cc81ec5f1e12483f4ecb1a0d71f1bb9f110592fb5b5e0c015fe024",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20003"
      ]
    },
    {
      "uid": "zhcn:36ace876f40a49b9521f99c0",
      "kind": "character_system_text",
      "source_text": "好嘞，先来第一把！\r\n给他们点颜色看看，\r\n吓死周围那帮家伙！",
      "source_fingerprint": "3e640d0b1c491b8e3f28aa705a30928cbc4747acd0684a91eda732ba6061bad5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20004"
      ]
    },
    {
      "uid": "zhcn:4481a17cc1f0beca813dea50",
      "kind": "character_system_text",
      "source_text": "哼哼，今天的我可是超强的哦？\r\n要疯狂刷新个人纪录！\r\n不管是斜坡冲刺还是捏爆铁球！",
      "source_fingerprint": "08a784f48798044eb7d25921d812f1f63d0e0d892adaa687bb40fc223f9cfff3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20005"
      ]
    },
    {
      "uid": "zhcn:d9fa74c4a2e4387c703f11a2",
      "kind": "character_system_text",
      "source_text": "喂，今天先练什么。\r\n要不要先开个作战会议？昂？",
      "source_fingerprint": "6bb15de2b343a9826f3fca070713c1271affc71a5d73fac9a8b11fff6a559928",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20006"
      ]
    },
    {
      "uid": "zhcn:b2151bf6a7861e98d2f2b38d",
      "kind": "character_system_text",
      "source_text": "起跑加速、节奏把控……\r\n得一个一个搞定才行。\r\n……怎么，有意见吗？",
      "source_fingerprint": "cc5d71bcd7792450de120495501bea8891196492d40edbbb69e7039b23577536",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20007"
      ]
    },
    {
      "uid": "zhcn:15e8fddc317ff9679ca423f7",
      "kind": "character_system_text",
      "source_text": "……啊！？怎么，你是想说我状态不好吗！\r\n跟你没关——不对……虽然确实有关就是了……！",
      "source_fingerprint": "f08a85c4d38c6c7724593aaaacb7b82d7473cb824aca6fae80f38a05cea2fdd2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20008"
      ]
    },
    {
      "uid": "zhcn:316e25f66fb0d57583b15ce0",
      "kind": "character_system_text",
      "source_text": "啊，真烦……。\r\n快点结束吧。",
      "source_fingerprint": "d06ea321d629fd249ade9a7c786501650a36c81b3fd48342c9ba4bb9731a9df0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20009"
      ]
    },
    {
      "uid": "zhcn:419c98766bc5beb757dec6b6",
      "kind": "character_system_text",
      "source_text": "可恶可恶可恶！！完全不在\r\n状态……！——啊！？看什么看\r\n混蛋！别管我！",
      "source_fingerprint": "570384bcb333e0fffb4ef7ff64423e3a5a36fa72674a94125426d02c11588e3f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20010"
      ]
    },
    {
      "uid": "zhcn:58c8cf44dd41a4ae62151d35",
      "kind": "character_system_text",
      "source_text": "——……。\r\n……啊？……没事。啥也没有。",
      "source_fingerprint": "f929d86927b39aa642d292f702a18c3e8e6207e5cd3bc292fbb0bc52929e8c93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20011"
      ]
    },
    {
      "uid": "zhcn:8a23b8f3f8281f7a6b01f110",
      "kind": "character_system_text",
      "source_text": "喂混蛋，不是塞得越多越好！\r\n这点道理，你应该明白的吧！",
      "source_fingerprint": "0d90c473324f31793750fd81906d080d321add5c3625836107363ee201845aef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20021"
      ]
    },
    {
      "uid": "zhcn:9b4d8e2526fe7f21ae0b0cb7",
      "kind": "character_system_text",
      "source_text": "既然跑了那就是奔着赢去的……\r\n但是……混蛋，你完事了给我等着……",
      "source_fingerprint": "721d5fcf05e6af6f09924b2b7904e6662a19269f4210a8a3236023124d2cfdfd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20022"
      ]
    },
    {
      "uid": "zhcn:7a997efdbac53a32cc185739",
      "kind": "character_system_text",
      "source_text": "嘿嘿，状态完美！\r\n我已经没什么好怕的了！\r\n把他们全干碎！",
      "source_fingerprint": "7ef18ff97b9e29b49f5cf298f5677b4c15454a713f1714c154d44dbc900d45ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20023"
      ]
    },
    {
      "uid": "zhcn:9c901fed4d7e9834b40e80cd",
      "kind": "character_system_text",
      "source_text": "老妈也在看着。\r\n今天就让她见识一下我超强的奔跑！",
      "source_fingerprint": "e5cc693bc402eb9154d8ac3470f9caa90f6fb9cde2f7562caa0084eb9e0697a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20024"
      ]
    },
    {
      "uid": "zhcn:49a15fe9f0c818e5d97aa5fd",
      "kind": "character_system_text",
      "source_text": "厉害了……感觉有一股超强的力量\r\n涌上来了！我这……\r\n今天不是要牛逼炸了！？",
      "source_fingerprint": "73e3fc3e88191a0c2218e05c92b70268c915b66bbb53dc8613c14a0911f07ba4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20025"
      ]
    },
    {
      "uid": "zhcn:83f182d9266cf943c67a25c4",
      "kind": "character_system_text",
      "source_text": "虽然那帮家伙看起来都干劲十足……\r\n但哼，这种程度是不可能吓到我的。",
      "source_fingerprint": "291838368ff44cd8a2e505f0ed800762e574bd65f8971daa7d102ef15fec79d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20026"
      ]
    },
    {
      "uid": "zhcn:23ba1861491ff7fd50549553",
      "kind": "character_system_text",
      "source_text": "蹄铁完美。早饭也吃得饱饱的。\r\n作战也和你练得妥妥的！\r\n好嘞，老子没有弱点！",
      "source_fingerprint": "c116306343c1b657dff1c9c17bb1186222fd3b85067736da6cd6ee7e05482e16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20027"
      ]
    },
    {
      "uid": "zhcn:ce47f39fb1e4f6e2e0f8ed34",
      "kind": "character_system_text",
      "source_text": "不管是对手还是那帮观众，\r\n全都要让他们明白——\r\n老子才是最强的！",
      "source_fingerprint": "b67a6c273cf9ddefef1e31d83ca962a338628719004814892cba4cdae56faf64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20028"
      ]
    },
    {
      "uid": "zhcn:b0e20944e778b1dfb3feaba2",
      "kind": "character_system_text",
      "source_text": "上吧。\r\n要用谁都挑不出毛病的奔跑！\r\n把那些瞧不起我的家伙全闭嘴！",
      "source_fingerprint": "da302d886c62ebb3250eb8f978c5d92f6e4e3faba37cd481c61357d73d90ae88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20029"
      ]
    },
    {
      "uid": "zhcn:88d625e7f91e7815b2101a26",
      "kind": "character_system_text",
      "source_text": "只要相信做过的一切就好。\r\n我很强，变强了，绝对能行……！",
      "source_fingerprint": "d88b250b17e9e2a742c464da0cc3bbd97b3660ef9a7a5670cb8cea53aaccc534",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20030"
      ]
    },
    {
      "uid": "zhcn:126b9d14634706dddcac006c",
      "kind": "character_system_text",
      "source_text": "唔呜～～……。\r\n——才、才没有紧张呢！\r\n这可是战栗不已的干劲啊混蛋！",
      "source_fingerprint": "3b79117d2232826bf6ee5fd9e391a1d03bcc11fb8c40e59dc16c04df01c73f26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f4109b238eaa69a22c62588e",
      "kind": "character_system_text",
      "source_text": "那什么表情。是想说我状态不好吗！？\r\n别瞧不起人，来单挑啊！",
      "source_fingerprint": "1a3fb608a1824bb524efa04f0a915ddf16ec0707f9f1ba7cead827f622d80f32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20032"
      ]
    },
    {
      "uid": "zhcn:6f761693e0904342450199c0",
      "kind": "character_system_text",
      "source_text": "这种程度的逆境，轻松就能甩掉！\r\n老子才不是那种因为状态不佳\r\n就会被压垮的弱鸡！",
      "source_fingerprint": "5c3792b92cf2b48a6c4d2883e87d3ec5eb24899402380d00bee2dd7baaf505da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20033"
      ]
    },
    {
      "uid": "zhcn:36d907a59335b476abd37808",
      "kind": "character_system_text",
      "source_text": "是我比较强……！\r\n绝对，绝对……！\r\n这就证明给你们看……！",
      "source_fingerprint": "ea8242721f03004f1e7ec244f0996b29a074a2f8be5a9c5556aa15eb06ca94fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20034"
      ]
    },
    {
      "uid": "zhcn:95d055b03bfa1f88152ec645",
      "kind": "character_system_text",
      "source_text": "……没问题吧，我……。\r\n～～切，快说没问题啊！\r\n这样我才能……给他们点颜色看啊……！",
      "source_fingerprint": "28417cf396e72690343023da078db87b262e58324a408e8bed1887f1ab5c1b91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20035"
      ]
    },
    {
      "uid": "zhcn:7b18cf302e212ef6af9fc3af",
      "kind": "character_system_text",
      "source_text": "吓吓吓吓吓、\r\n才没有被吓到呢！？\r\n状态也是……绝佳啊噢啦！",
      "source_fingerprint": "2d15ab236395899bc201c48f16d56d4a9cb7fd2a8d3c3f9bd14a159007ba0888",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20036"
      ]
    },
    {
      "uid": "zhcn:a322c82ef253b981f2183fc0",
      "kind": "character_system_text",
      "source_text": "可恶……这帮家伙全都在\r\n给我施压……！\r\n别瞧不起人啊，老子……！",
      "source_fingerprint": "a01889ea811b3940b3e6c6aca057f35e9aea7ad44d6298aef5e4354b559f83a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20037"
      ]
    },
    {
      "uid": "zhcn:f0162bc7895ace3ac4567b03",
      "kind": "character_system_text",
      "source_text": "噢啦噢啦！",
      "source_fingerprint": "ad0d56b4acee54b11beec52fc09744768ac7e258973e78fca66cdacb864ea192",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20038"
      ]
    },
    {
      "uid": "zhcn:c386bde7df18a7485dc0b724",
      "kind": "character_system_text",
      "source_text": "放马过来！",
      "source_fingerprint": "5ece7abb9b3b78fdf98ec0e77f70d05dfcef172e72abe47d205f60b3219f0862",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20039"
      ]
    },
    {
      "uid": "zhcn:77deec60c6baf0b4d9e60321",
      "kind": "character_system_text",
      "source_text": "给我看好了！",
      "source_fingerprint": "9fa3d8a15c6dc2eb83dc79017951b2a3184dbebef00e5497a3b1e843bc539be7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20040"
      ]
    },
    {
      "uid": "zhcn:c6d776a0c00f246449c35ff4",
      "kind": "character_system_text",
      "source_text": "轻轻松松。",
      "source_fingerprint": "9cf6b737d9ab02e93c045129ffb6b68c9c358e619eaa34f925a87a00b397f512",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20041"
      ]
    },
    {
      "uid": "zhcn:5bf77be733943e2227948423",
      "kind": "character_system_text",
      "source_text": "可恶……！",
      "source_fingerprint": "777b4ad8979359adb6db6b7ac3d8844f696089febbf4880ad99e25d4bcfb7c5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20042"
      ]
    },
    {
      "uid": "zhcn:4846597c32d4dc7f4d8f3752",
      "kind": "character_system_text",
      "source_text": "唔唔唔……",
      "source_fingerprint": "d264d03e7d8e5c9efe5b7f7e0b00b44c8c02904342dffc94475681ccb9893872",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20043"
      ]
    },
    {
      "uid": "zhcn:8311bc5e30ef1262f981ad58",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20046"
      ]
    },
    {
      "uid": "zhcn:bc4203d0d04d3c9d7593cd46",
      "kind": "character_system_text",
      "source_text": "不妙，好强……",
      "source_fingerprint": "f8a975127f30ea5f52d55017dbd972b893e0f18736cad7de67e43be2a8b1f325",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20047"
      ]
    },
    {
      "uid": "zhcn:44aedd97928d47f15c9a25d8",
      "kind": "character_system_text",
      "source_text": "我已经证明了自己的强大了吧！",
      "source_fingerprint": "7ed7d30be8f986371feeb15b21ad9ededf18a702ac2a510657df78e795e80086",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20049"
      ]
    },
    {
      "uid": "zhcn:221e3986ebb2dc2b8d92b734",
      "kind": "character_system_text",
      "source_text": "知道厉害了吧，噢啦！",
      "source_fingerprint": "a8fa91c86a4fc96caf688e26accad8987732cdd1b4fabc3f12109d5264f1c5ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20050"
      ]
    },
    {
      "uid": "zhcn:2d2d17ac4c5ca59a5040473b",
      "kind": "character_system_text",
      "source_text": "哼，别瞧不起人。",
      "source_fingerprint": "128f78963dd2e18d69dd9c86fe733a8aff994bc0f44ebfccd6e43cca412a5beb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "20051"
      ]
    },
    {
      "uid": "zhcn:1aa56e44dfae0fc0dc41fa1b",
      "kind": "character_system_text",
      "source_text": "冲啊！",
      "source_fingerprint": "ea9e4fde89d6720f162282db99bf4c2a384ec91c4b23d4f3c57ca3c210fa51a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "2030"
      ]
    },
    {
      "uid": "zhcn:13741f6187be83ac7ce99be7",
      "kind": "character_system_text",
      "source_text": "给他们点颜色看看，你们几个！",
      "source_fingerprint": "7d5fddf92a3ac0658b42a2231a8a16fac1e28c8aea6f6fc003c2f8ab2ce5e332",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "2031"
      ]
    },
    {
      "uid": "zhcn:1a48d302f28e5fa73911da77",
      "kind": "character_system_text",
      "source_text": "知道厉害了吧，噢啦！",
      "source_fingerprint": "a8fa91c86a4fc96caf688e26accad8987732cdd1b4fabc3f12109d5264f1c5ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "2032"
      ]
    },
    {
      "uid": "zhcn:d266b3a861fecf294e151913",
      "kind": "character_system_text",
      "source_text": "不管是对手还是那帮观众，\r\n全都要让他们明白——\r\n老子才是最强的！",
      "source_fingerprint": "b67a6c273cf9ddefef1e31d83ca962a338628719004814892cba4cdae56faf64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
        "2033"
      ]
    },
    {
      "uid": "zhcn:faf3841303bab0220996691e",
      "kind": "character_system_text",
      "source_text": "厉害了……感觉有一股超强的力量\r\n涌上来了！我这……\r\n今天不是要牛逼炸了！？",
      "source_fingerprint": "73e3fc3e88191a0c2218e05c92b70268c915b66bbb53dc8613c14a0911f07ba4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1081",
