        "1085",
        "10003"
      ],
      "json_pointer": "/1085/10003"
    },
    {
      "uid": "zhcn:a45f54b2e68aa45f6933bb56",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这个……是我的一点心意。\r\n还请笑纳。",
      "source_fingerprint": "1dbc6a1a8dda0c43db08a40543a1c26a152a53ae84e4284bdb9dda6f7793320d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
