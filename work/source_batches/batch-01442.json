  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:2605c4cdf172ec9dd57a1e72",
      "kind": "character_system_text",
      "source_text": "行ってきます。",
      "source_fingerprint": "793275eb5254d9ee0aa95daa33c90a973bec2e4a987e75c094e5b5d339927bef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "100000"
      ]
    },
    {
      "uid": "zhcn:b12b3041c50bf2736bd27654",
      "kind": "character_system_text",
      "source_text": "戻りました。",
      "source_fingerprint": "e7cc6951a920e8084573735e4a0908d6d6b34e24b6a55a0aeb4ac698d3b94d9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "100001"
      ]
    },
    {
      "uid": "zhcn:929a2c33ed5587fc5e40098a",
      "kind": "character_system_text",
      "source_text": "いつか未知の輝きをまとったとき、\r\nその煌めきを広げてくれるのは…\r\nきっと、あなたなんだと思います。",
      "source_fingerprint": "465f63946ebae114b4e035d224351a7d6683b44cda917fe444799831895fd9b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10001"
      ]
    },
    {
      "uid": "zhcn:44550f578c269f6fdbed2bf6",
      "kind": "character_system_text",
      "source_text": "今日より明日、明日より明後日…\r\n一緒にいればいるほど、きっと\r\nわたしたちの輝きは増すんです♪",
      "source_fingerprint": "04f09cf832a0f4990904accd8be90a135264a1e8cc698699a1d22b9ff2a6f1e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10002"
      ]
    },
    {
      "uid": "zhcn:66210bdfa20fc6a253a82898",
      "kind": "character_system_text",
      "source_text": "着物を今風にアレンジして楽しんで\r\nみませんか？小物を工夫する\r\nだけでも、全然違って見えますよ！",
      "source_fingerprint": "e8cb6d2e4420a78fca9b625f2616da49765c021d5cd26948ddbcb38093a66b77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10003"
      ]
    },
    {
      "uid": "zhcn:38b2c27ebea465236c1f7863",
      "kind": "character_system_text",
      "source_text": "パティシエの技は芸術的ですね。\r\nチョコや飴細工で、ドレスだって\r\n宝石だって象れてしまうんですから",
      "source_fingerprint": "5e102a524381ddda15827b55481bb09f89e8a54c7405fecd2276f89f62beb75d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10004"
      ]
    },
    {
      "uid": "zhcn:1ad8ae240337c368d9af0a14",
      "kind": "character_system_text",
      "source_text": "想いを込めたらうっかりハート型\r\nばかりに…えへへ。アイシング\r\nクッキー、受け取ってくださいね？",
      "source_fingerprint": "db167542813c2a10355703e48e7a1ec435039b4afec5381ea48ba2ebe19f6dfa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10005"
      ]
    },
    {
      "uid": "zhcn:2651aac2288618927de4eec7",
      "kind": "character_system_text",
      "source_text": "織姫と彦星も、会うときには\r\nどんな着物にしようかなって\r\n悩んだりするんでしょうか？",
      "source_fingerprint": "4cda6544daf20ac1bf8057e3c28849e7eec5b31f91a805d3497910a7e620702e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10006"
      ]
    },
    {
      "uid": "zhcn:ed3ad71532cd66ccf581110b",
      "kind": "character_system_text",
      "source_text": "仮装は特に個性が光りますね！\r\nミイラも吸血鬼も獣人も、特徴を\r\n活かしたスタイルでキメないと。",
      "source_fingerprint": "4e08a4f5bfe9c6c1d70cdee10db1c70340d560cf7831321f7e80230eadd1d2cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10007"
      ]
    },
    {
      "uid": "zhcn:a1173d9ed9d04b3ae653d1a7",
      "kind": "character_system_text",
      "source_text": "お友だちに頼まれてクリスマス\r\nコーデをしたんですが…ふふふ。\r\n服も瞳もキラキラになりました♪",
      "source_fingerprint": "fe9a41fddfdd76cd935e100e0a22a394407b127056ed2c1b912620a315f80e3f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10008"
      ]
    },
    {
      "uid": "zhcn:63309615b65c03b9134c49d3",
      "kind": "character_system_text",
      "source_text": "今日は大人カワイイで決めよう\r\nかと…トレーナーさんと過ごす\r\n大切なクリスマスですから♪",
      "source_fingerprint": "34dc8c6f6fc9666544d87e421b44054946e78ae5c8f008decbf572eca783e75c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10009"
      ]
    },
    {
      "uid": "zhcn:2374c0d151fcb4b28bef9178",
      "kind": "character_system_text",
      "source_text": "やりました♪",
      "source_fingerprint": "9a4f9e40671dbf06b88f17d7e7dd9aff0b04a727a4775d8855a5dc9a3d244ace",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1001"
      ]
    },
    {
      "uid": "zhcn:7d8d836d3c770eda9aa5cbe9",
      "kind": "character_system_text",
      "source_text": "来年はどんなファッションが\r\n流行るんでしょう？\r\nふふふっ、当てっこしましょうか。",
      "source_fingerprint": "395b2bacb5ab0027ebeee2e65ad671bed3c6166b250f0a9ddc5eb935ac96a53d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10010"
      ]
    },
    {
      "uid": "zhcn:d178882ed4a3af184c4ddec3",
      "kind": "character_system_text",
      "source_text": "お誕生日おめでとうございます！\r\n今日はいつもと違うコーデにして\r\n新しい自分を見つけてみませんか？",
      "source_fingerprint": "7793551d8721cc54c194584862745a26eb027bb592ecc14b426ac5435c617a4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10011"
      ]
    },
    {
      "uid": "zhcn:ab941d42d11a9e10b75e4b76",
      "kind": "character_system_text",
      "source_text": "お誕生会の飾りつけもごちそうも、\r\nいっしょに考えて用意したいです。\r\n他にない特別な1日になるように。",
      "source_fingerprint": "091f628291dda4bdf12f71f880dd693645f171276f05cdac4df9276b7da58c01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10012"
      ]
    },
    {
      "uid": "zhcn:8f44fb1f35d1ff168f39c98f",
      "kind": "character_system_text",
      "source_text": "今日はトレーナーさんがわたしの\r\n服を選んでくれませんか？\r\n心を込めたバースデー・コーデを♪",
      "source_fingerprint": "42b0be7576de90a6cc1c66e895bc5f6ed5d2f4e21fdce0c1ced32ae037045e5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10013"
      ]
    },
    {
      "uid": "zhcn:cad4f784d09ffbd0b2a6b6e0",
      "kind": "character_system_text",
      "source_text": "気持ちがこもったプレゼントは\r\nどんなものよりも価値があります。\r\nだから今年も…最高の誕生日です。",
      "source_fingerprint": "e2c84b6cefc91c3cc018f3e6b0282a8b7ba45bbf1e13e4611141796b8a1125fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10014"
      ]
    },
    {
      "uid": "zhcn:154554343246a3a65fed6413",
      "kind": "character_system_text",
      "source_text": "お知らせがきています。\r\n早めのチェックが大事だって\r\nお姉ちゃんが言ってました。",
      "source_fingerprint": "4c90c21e43eed8c6f8cbd44c464bb7d9ce4c802f6d9d731afdf844affee88440",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10015"
      ]
    },
    {
      "uid": "zhcn:f83b98b4476619a72116af84",
      "kind": "character_system_text",
      "source_text": "プレゼントがあるみたいです。\r\nふふっ、どんな煌めきを\r\n持っているのか楽しみですね。",
      "source_fingerprint": "6dcfa9a1bb45937a41c08f2db318b4bf2baceedc551229e2f060fe4c4cde3979",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10016"
      ]
    },
    {
      "uid": "zhcn:7b2d3bc4268b80d0c3111356",
      "kind": "character_system_text",
      "source_text": "ミッションクリア！\r\n素晴らしいです。\r\nまた輝きが増しましたね。",
      "source_fingerprint": "57aa92593ce6874df42997bdf344eaba3014bfe591e0e417eb222914b2603b26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10017"
      ]
    },
    {
      "uid": "zhcn:e5b332bdd9448a0be98bd7d3",
      "kind": "character_system_text",
      "source_text": "イベントがあるようです。\r\nどんなコーデで参加するか、\r\n考えておかなくちゃ！",
      "source_fingerprint": "b14b2bf0ae366f2b90110540700f0b3d882a7740b8c8a19f9a8040e1194aff38",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10018"
      ]
    },
    {
      "uid": "zhcn:8fb3e387e79fae9142f798f9",
      "kind": "character_system_text",
      "source_text": "イベントが始まっていますよ。\r\n賑やかで楽しそうです。\r\n見に行ってみませんか？",
      "source_fingerprint": "33ad0e4d51a3bf3ae9dcc460741756dd62a0b1e04a2f3d36b4f32c9096c0f7d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10019"
      ]
    },
    {
      "uid": "zhcn:34091f010c203038e1321e9a",
      "kind": "character_system_text",
      "source_text": "次こそは、ですね。",
      "source_fingerprint": "3b879712ea6f482f273a67a8ae206147d9833adb87b43de6c5d18d1e2ede65e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1002"
      ]
    },
    {
      "uid": "zhcn:9c9e93035b8867ca010f7894",
      "kind": "character_system_text",
      "source_text": "名鑑レベルが上がりましたね。\r\nさすがです！",
      "source_fingerprint": "10a842d9a3dbfb8d398d4b0a1dc0bf6760cc025eb363155683366d8e6e1b24da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "10021"
      ]
    },
    {
      "uid": "zhcn:e05f12bb76eb40830125749b",
      "kind": "character_system_text",
      "source_text": "互角でしたね。",
      "source_fingerprint": "d82aeb1ce472cd8baa30e032809c5f4c0e4e9675133dfad033e83929caa0d27d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1003"
      ]
    },
    {
      "uid": "zhcn:a32de44991ed5c602a344105",
      "kind": "character_system_text",
      "source_text": "勝利です♪",
      "source_fingerprint": "fa83ceab8b0f7ddcb00f05d705cc634d08aaa30ed5330c1bff5433ce58145d49",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1004"
      ]
    },
    {
      "uid": "zhcn:cddbd013fc8d6cb960e1a606",
      "kind": "character_system_text",
      "source_text": "次こそは、ですね。",
      "source_fingerprint": "3b879712ea6f482f273a67a8ae206147d9833adb87b43de6c5d18d1e2ede65e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1005"
      ]
    },
    {
      "uid": "zhcn:9967dc4130acfa528db6515f",
      "kind": "character_system_text",
      "source_text": "互角でしたね。",
      "source_fingerprint": "d82aeb1ce472cd8baa30e032809c5f4c0e4e9675133dfad033e83929caa0d27d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1006"
      ]
    },
    {
      "uid": "zhcn:b2fff60555c59fcf4d089228",
      "kind": "character_system_text",
      "source_text": "記録更新です！",
      "source_fingerprint": "53180df418ef02a8975384c5dffb2649485d82c9943837df096619915bf6ed0f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1007"
      ]
    },
    {
      "uid": "zhcn:9e095979f3f320529c609e33",
      "kind": "character_system_text",
      "source_text": "わたしたちなりの輝きで！",
      "source_fingerprint": "b7c70a2103044aad89429a1a4517f5f8c0d17f0cba8255e6d7383b5d0ebea219",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1008"
      ]
    },
    {
      "uid": "zhcn:1c700337399466f15dd8e2c6",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "11"
      ]
    },
    {
      "uid": "zhcn:bf994bc9e38af2335f90b338",
      "kind": "character_system_text",
      "source_text": "煌めきを纏うために、\r\n素材を磨きましょう♪",
      "source_fingerprint": "c0d629b99721cc2a19b3cd2b638f81624fef715b26f6d54ddb60f72bc55ae2fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "110000"
      ]
    },
    {
      "uid": "zhcn:28d64ce3edf17a191472a6bb",
      "kind": "character_system_text",
      "source_text": "多くの輝き、それぞれの光。\r\n本当にまぶしいですね。",
      "source_fingerprint": "8731701a13c303b4335237fa3ebde4f02ee7d2c91510f790afa5dca0cda73484",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "110001"
      ]
    },
    {
      "uid": "zhcn:0595241e7865c3248c3c84b9",
      "kind": "character_system_text",
      "source_text": "レースですか？しっかり\r\n準備をしなくちゃですね。",
      "source_fingerprint": "9056f097158d0501ea2a7739ce27462eca446cf0bbda365dc97e11b7071c65ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "110002"
      ]
    },
    {
      "uid": "zhcn:8e4832fb23929ab1d0667a28",
      "kind": "character_system_text",
      "source_text": "ウマ娘、プリティーダービー！",
      "source_fingerprint": "0cfce02d59976c4a687f79d00d7894df0b5a6c879fbee1d653e3f267a88ff06d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "12"
      ]
    },
    {
      "uid": "zhcn:2def92b8c11a0bf35d74a872",
      "kind": "character_system_text",
      "source_text": "力が、あふれて…！",
      "source_fingerprint": "66126cc828271a2df4efc4ccd951e5e3935eae863659db7b15d0f93a71ff7d6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "120000"
      ]
    },
    {
      "uid": "zhcn:a2261a1ec98331d3e64fa479",
      "kind": "character_system_text",
      "source_text": "ナイスコーデ♪",
      "source_fingerprint": "b1e35869679c181fe06633d904fc2f5774c462d02b6a77363b15056f3d29ecef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1203"
      ]
    },
    {
      "uid": "zhcn:3ae810b7d915b5b985fc28e0",
      "kind": "character_system_text",
      "source_text": "おしゃれ番長と。",
      "source_fingerprint": "3dea910da0939ebf8ccab668a063ef14fcf328e8ff20ba758692475f48b54848",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "1204"
      ]
    },
    {
      "uid": "zhcn:85091e3f0294bb5934a8a7bf",
      "kind": "character_system_text",
      "source_text": "わぁ、ログインボーナスですね。",
      "source_fingerprint": "d5975c718ac946b00beecd5dd3a30538ff972027cacf4e3f846d1cf94b26475b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "13"
      ]
    },
    {
      "uid": "zhcn:2379b2ad539afc4713965bb4",
      "kind": "character_system_text",
      "source_text": "スタート、です♪",
      "source_fingerprint": "9dfd4c14cdd3ad1809095a351886ab92d418da6f30beab8499337f2cc31b8993",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140000"
      ]
    },
    {
      "uid": "zhcn:51f6676136fd55a816dc07cd",
      "kind": "character_system_text",
      "source_text": "やりましたね。",
      "source_fingerprint": "75d556c74211441a4c0c2f4fd74c5364a8a9f8ac3ceba5c7bba0ba63b648ba9a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140001"
      ]
    },
    {
      "uid": "zhcn:3c88cae50478a2c6259b2a35",
      "kind": "character_system_text",
      "source_text": "あらら。",
      "source_fingerprint": "261e292fc25ae770e17103cbe9999e304a8af35793d600b0c7ea9ddda775bc40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140002"
      ]
    },
    {
      "uid": "zhcn:1048610b19792be2bfb89f5c",
      "kind": "character_system_text",
      "source_text": "お見事です♪",
      "source_fingerprint": "3a1816980cafe3f8b3a43152fd16307e0b528ef240c22b7ce4dfed386f54ace1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140003"
      ]
    },
    {
      "uid": "zhcn:19d2fb821f5a077afb324b13",
      "kind": "character_system_text",
      "source_text": "いいですね！",
      "source_fingerprint": "08e5bfcc984d1e9c899368a2253f28c77d29f0626fd2a66e2a309bc38bb5b57e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140004"
      ]
    },
    {
      "uid": "zhcn:965117b6350a6e6206cc9cfb",
      "kind": "character_system_text",
      "source_text": "次がんばりましょう。",
      "source_fingerprint": "0347d7af0748f0f0ceb92118bb041145090ce254504e4bae307ea495bbacf635",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140005"
      ]
    },
    {
      "uid": "zhcn:9456a4b5d4840971b1ad8272",
      "kind": "character_system_text",
      "source_text": "お見事です♪",
      "source_fingerprint": "3a1816980cafe3f8b3a43152fd16307e0b528ef240c22b7ce4dfed386f54ace1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
