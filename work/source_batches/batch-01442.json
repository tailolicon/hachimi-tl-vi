      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然我认为自己不需要\r\n非社交目的的庆生会。\r\n……但还是感谢你的体贴。",
      "source_fingerprint": "f17bf1e04772c01a0335ac43c7a74e5e122605fc9baad43c750b23cc67a12017",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
