      ]
    },
    {
      "uid": "zhcn:1e0d1cbf7ec8e0b9357f3a03",
      "kind": "character_system_text",
      "source_text": "いいですね！",
      "source_fingerprint": "08e5bfcc984d1e9c899368a2253f28c77d29f0626fd2a66e2a309bc38bb5b57e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140007"
      ]
    },
    {
      "uid": "zhcn:d7772b474376a374ec33ef0a",
      "kind": "character_system_text",
      "source_text": "どうしたんですか？",
      "source_fingerprint": "3114232fe53163e7e865b92ba0e38b3ac3cf77cbb674c33266b3ed0444921893",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140008"
      ]
    },
    {
      "uid": "zhcn:9f98c0541f8bb8c9c6402c7b",
      "kind": "character_system_text",
      "source_text": "ふふっ。",
      "source_fingerprint": "dbc78ca5d65302a8b38bec657661270c58ae9fac943c1c718a7fa71c2d75ec30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140009"
      ]
    },
    {
      "uid": "zhcn:0191d06ce0d9d88eeb739931",
      "kind": "character_system_text",
      "source_text": "はい？",
      "source_fingerprint": "053ae917d74137d85cafb57b43538c038903213c9d82ce789e40cda6cd61cbc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140010"
      ]
    },
    {
      "uid": "zhcn:1bd56517d34e21a59ce89fce",
      "kind": "character_system_text",
      "source_text": "すごいです！",
      "source_fingerprint": "529d2a82f27b0063dec0d734ffaa1b0f672ce9545021bc4e14d84530dcb7e1f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140011"
      ]
    },
    {
      "uid": "zhcn:e671eae9c3f4871bdcd7092f",
      "kind": "character_system_text",
      "source_text": "そのまま…。",
      "source_fingerprint": "54e70ca5a9902d0d12cb51d1cd1ded107ceba188b45d376da9914807e8589c1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140012"
      ]
    },
    {
      "uid": "zhcn:0b1093b6539b018ea0793e60",
      "kind": "character_system_text",
      "source_text": "すごいです！",
      "source_fingerprint": "529d2a82f27b0063dec0d734ffaa1b0f672ce9545021bc4e14d84530dcb7e1f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140013"
      ]
    },
    {
      "uid": "zhcn:3d1c8b51f6692a61dc4e7621",
      "kind": "character_system_text",
      "source_text": "あっ…。",
      "source_fingerprint": "3a21ce840bf9ddc986be8e888c7b451979daa2ab024ea08e5cc2c77b4a08b12e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140014"
      ]
    },
    {
      "uid": "zhcn:01483b2679092232698839a9",
      "kind": "character_system_text",
      "source_text": "わぁ…。",
      "source_fingerprint": "575497b95576069235af3a45ffbd5518cefe6f8ad231422501c3294f3fab92f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140015"
      ]
    },
    {
      "uid": "zhcn:e67d3f50daee7e168359d064",
      "kind": "character_system_text",
      "source_text": "悩み中ですか？",
      "source_fingerprint": "23c88f4b9bd5827c640170288b142a29e286ffca8a03058d5370fccd1b435de5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140016"
      ]
    },
    {
      "uid": "zhcn:ad3a9e2f2970671e8dc501d9",
      "kind": "character_system_text",
      "source_text": "ああっ…。",
      "source_fingerprint": "5c3761bf5cd785cee68bde51c0ce0900d23014779c1b9e12d7fbbb0a99f226f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140017"
      ]
    },
    {
      "uid": "zhcn:678c08e7d450c71795733be0",
      "kind": "character_system_text",
      "source_text": "残念…。",
      "source_fingerprint": "d2534e13c2a102de521d7665410f5d6c5771fcb6c8ad98b3b1a9ecbe87e2008f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "140018"
      ]
    },
    {
      "uid": "zhcn:ada9dae638ea0559b259dbc8",
      "kind": "character_system_text",
      "source_text": "明日はこれがもらえるみたいです。",
      "source_fingerprint": "16df5f8f8c14e6448becf1e0ae571dc8f64cdbd7881ee1ba51f57496c382ea4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "15"
      ]
    },
    {
      "uid": "zhcn:1c6ea632a747a6d03b02b1e9",
      "kind": "character_system_text",
      "source_text": "…あ。すみません、考えごとを。\r\n大丈夫です、始めましょう！",
      "source_fingerprint": "e8a39a8bd36cb196d35410178a92f397b6342c6d6aeb8bd35901a11db3fdfa70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20000"
      ]
    },
    {
      "uid": "zhcn:6b14d18a5bda0a31a9bf2eac",
      "kind": "character_system_text",
      "source_text": "…疲労が…でも、お姉ちゃんも\r\nきっと応援してくれてる…\r\nうん、がんばらなくちゃ。",
      "source_fingerprint": "e905082630a0fa8382c6ca1d2fc249e932d380f3c82acea8bdab7c7ea7443bd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20001"
      ]
    },
    {
      "uid": "zhcn:1f9c516a8c6d52ff0d994188",
      "kind": "character_system_text",
      "source_text": "始めましょう、トレーナーさん！\r\nふふふ。見ての通り、わたしの\r\nやる気がウズウズしていますっ。",
      "source_fingerprint": "cde1d961f7b394f1673cfeb261a70263e820e72c336ade1ce6e5c2663c481c72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20002"
      ]
    },
    {
      "uid": "zhcn:5c022ec7510ec700e99f46d5",
      "kind": "character_system_text",
      "source_text": "心が弾んでいるみたい…\r\n新しい自分に出会えそうな、\r\nそんなときめきを感じます♪",
      "source_fingerprint": "739874884fe4f65f56401344a33abed1bd209930d2ac09ad9f1ffd33ae5c2180",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20003"
      ]
    },
    {
      "uid": "zhcn:c82a3c14f92853959d1caf4f",
      "kind": "character_system_text",
      "source_text": "うん、いい調子。\r\n風に揺れるスカートのように\r\n脚がとっても軽いです。",
      "source_fingerprint": "b5ad658ad3fe88a83feb98c5129a37d88ad0af4ee7ab74cfafe8e4cca9dc217d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20004"
      ]
    },
    {
      "uid": "zhcn:15519d66cd30f8fc41d34b8f",
      "kind": "character_system_text",
      "source_text": "新しいアイディアが浮かんだとき\r\nみたいに、ワクワクしています。\r\nいい成果を出せそうです！",
      "source_fingerprint": "9a6fe5b1688c16f8d2d25bbd961792c8562776cb18b7ad41c42a61495d208c33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20005"
      ]
    },
    {
      "uid": "zhcn:05363adb4e3e41602f4b75e7",
      "kind": "character_system_text",
      "source_text": "地道な努力がいつか実を結ぶ…\r\nわたしのペースで、\r\n前進あるのみですね。",
      "source_fingerprint": "df6b0ea2409b001093a62f6c3d60edd900be0970caa1c3f48746dba339df2a03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20006"
      ]
    },
    {
      "uid": "zhcn:3967682038f1e62204d66fef",
      "kind": "character_system_text",
      "source_text": "コンディションに問題は\r\nありません。さぁ、今日も元気に\r\nときめきを探しましょう！",
      "source_fingerprint": "e49080c555545c1f8c817b34a3fdb1ae5c7e43aa964791a888f54b59f44f562d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20007"
      ]
    },
    {
      "uid": "zhcn:036cff999300108d0d9bca9a",
      "kind": "character_system_text",
      "source_text": "…ううん、なんだか\r\n集中できない…ダメダメ、\r\nしっかりしなくちゃ。",
      "source_fingerprint": "568758d282bbe1ea34f1ff208d2408ff873aaa6f8de9f12ab9326b07982b772e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20008"
      ]
    },
    {
      "uid": "zhcn:98c40a6f6431e6a07e09659a",
      "kind": "character_system_text",
      "source_text": "気持ちが沈んでいるような…\r\nこれじゃ成果は得られませんね。\r\n気合い、入れ直し！",
      "source_fingerprint": "7b547469fd8ecd0d8ed440bf41446bf841c459fc9eec5deed130b88f1cfa86aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20009"
      ]
    },
    {
      "uid": "zhcn:52ee701a5d49eb26f0c94c9f",
      "kind": "character_system_text",
      "source_text": "ときめきが眠ってしまった\r\nみたい…うう、起きて、\r\nわたしの心…！",
      "source_fingerprint": "41b7ac83469f876626a0e39bc632ba24b88d21bf4bba81c37c65d38443fb7330",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20010"
      ]
    },
    {
      "uid": "zhcn:fd3d1d4835e32cfd2b23add1",
      "kind": "character_system_text",
      "source_text": "気分が落ちているときは\r\n無理に動こうとしても\r\nダメなんですよね…困りました…。",
      "source_fingerprint": "fcac41e71e8e6a0e1236c05197b93912359336eacb8e1d35b08502cea86810d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20011"
      ]
    },
    {
      "uid": "zhcn:07f2468717ebc6ee1720ac4a",
      "kind": "character_system_text",
      "source_text": "得策とは思えません…\r\n自分らしさを保つためにも、\r\n無理は禁物だと思います。",
      "source_fingerprint": "03ed5100691a4887577caad8a1dd2a639ec086ee3c56663c0ee0491616cfa232",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20021"
      ]
    },
    {
      "uid": "zhcn:aa3770454eb5652886a9f7bb",
      "kind": "character_system_text",
      "source_text": "ときには自分を見直す時間も\r\n必要かと。考えましょう。\r\n今がまさにそのときです。",
      "source_fingerprint": "360183bfbcddbf505f0ffa5dbd0e9017ee96bc735fa9d85ce0d80dd3b2a16ae9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20022"
      ]
    },
    {
      "uid": "zhcn:8bcfa359682a3133af2b236f",
      "kind": "character_system_text",
      "source_text": "ばっちり決まっていますか？\r\nふふっ、おかげさまで\r\n最高のわたしをお見せできます。",
      "source_fingerprint": "6880c9bc2bf1598e544ecbc78d02e9e230b46f09c478ecab3de421059a9c1d94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20023"
      ]
    },
    {
      "uid": "zhcn:0442e0a52e1b8d60d1e7d9d2",
      "kind": "character_system_text",
      "source_text": "多くの人の声が聞こえる…\r\n胸にあるドキドキが、\r\n今にもあふれ出しそうです♪",
      "source_fingerprint": "431e05f64cf509a6f6d5e85e1a4e8069665643c46e0cff6930942c6a9ee26608",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20024"
      ]
    },
    {
      "uid": "zhcn:f372009362c1e54759cd4c9a",
      "kind": "character_system_text",
      "source_text": "コンディションは最高…\r\n怖いものなしの\r\nキラキラモードです！",
      "source_fingerprint": "3bbe233b61382a067c3e57b7a13a7270ee33cf8b3388e4979db7396e99ccaa56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20025"
      ]
    },
    {
      "uid": "zhcn:2fa4dbb4ab68f84153314dd3",
      "kind": "character_system_text",
      "source_text": "いい感じ♪トレーナーさんから\r\nもらったアドバイス、\r\n上手く活かせそうです！",
      "source_fingerprint": "c2d08f2a282c52e79a6b5cbd4bf3af9285c9015838224789c673859d1f3dd83a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20026"
      ]
    },
    {
      "uid": "zhcn:f32f0b2dec69ebc8df23cb16",
      "kind": "character_system_text",
      "source_text": "わたしの走りを見た人が、\r\n輝きたいと願えるような、\r\nそんなレースにしたいです。",
      "source_fingerprint": "23de3c9697f252dbfb00c7d0c895085b1ed0b4b852778c6faf28f52e0df175f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20027"
      ]
    },
    {
      "uid": "zhcn:0b772ea8a814d25feee280e9",
      "kind": "character_system_text",
      "source_text": "いっしょに試行錯誤して\r\nここまで来たんです。\r\n脚は止めません！",
      "source_fingerprint": "b1315893f87041cb2ee96c4cd4c73549c8eaf131cb02f0e0ee386c70a8345b47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20028"
      ]
    },
    {
      "uid": "zhcn:d3610d788181445a1ef15a59",
      "kind": "character_system_text",
      "source_text": "いつも通りのわたしで、\r\nキラッと行ってきます♪",
      "source_fingerprint": "38cf6491ff4cf4e405b5a89bbf07b54af47e9b851b06ba23c1a6c1dbb97eed75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20029"
      ]
    }
  ]
}
