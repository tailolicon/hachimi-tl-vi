        "1085",
        "10002"
      ],
      "json_pointer": "/1085/10002"
    },
    {
      "uid": "zhcn:fccfffbee59b08b23ade29e1",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "新年时，我们家族会齐聚一堂，\r\n定下该年度的目标。\r\n来接我的时候请绝对不要迟到。",
      "source_fingerprint": "6b5c38724a8abc5bc19c3345c021e6f2b31be21fc19715e5ad2f1f03fc3ee4c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
