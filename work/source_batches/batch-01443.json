  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:8bded0c987c1e3eb080b37a5",
      "kind": "character_system_text",
      "source_text": "今日の最善を引き出せるように、\r\n応援していてくださいね。",
      "source_fingerprint": "01223a4273e462c67e0927e9d1fb788d7116881a59135869a59f5f5d48d4426f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20030"
      ]
    },
    {
      "uid": "zhcn:7722b11cd1afabff3b0610ea",
      "kind": "character_system_text",
      "source_text": "緊張のドキドキもワクワクも\r\nわたしの背中を押す力なんです。",
      "source_fingerprint": "ce60e260e449fc4568b766acb6289095a65522a5e700cd7a1af0bed056f09b9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20031"
      ]
    },
    {
      "uid": "zhcn:685cfb7035320b52a9d1f05e",
      "kind": "character_system_text",
      "source_text": "わたしが『わたし』を\r\n好きになれるよう…\r\nせいいっぱい、がんばります。",
      "source_fingerprint": "1ea8f6ac9354e65932358c1df0e0c97be1d0dda8cfd97a504e5c965a4be0f6e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20032"
      ]
    },
    {
      "uid": "zhcn:96986e803b9d47a180192b59",
      "kind": "character_system_text",
      "source_text": "未来は決まっていませんから、\r\nできることをやるだけです。",
      "source_fingerprint": "7f21d3147c6e07a0ec7706dfb887b22a45d1ce22ffb9d315afe4a21cf98dbb7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20033"
      ]
    },
    {
      "uid": "zhcn:0019ed450d8e7e6d6cfc5b2f",
      "kind": "character_system_text",
      "source_text": "ピンチだからこそ輝く…\r\nわたしは諦めません！",
      "source_fingerprint": "fb5a1acd171e2bc1ba13d049b4a52d7bc85f34e590be1a4a5e332f7b34c9f9d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20034"
      ]
    },
    {
      "uid": "zhcn:f06b8a4f118b91207e4ef4a9",
      "kind": "character_system_text",
      "source_text": "不安はあります…\r\nでも止まることはできない…！",
      "source_fingerprint": "d88db9049bc9ba94edfa2b097b102f18cef62cabadb2044285b72e3bcb26f6b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20035"
      ]
    },
    {
      "uid": "zhcn:ac939445190820bae54d5b02",
      "kind": "character_system_text",
      "source_text": "わたしがここで輝けるように、\r\n祈っていてくれますか…？",
      "source_fingerprint": "81a67f56f8993a77da0e088111db15bce8afbd791192ed33e9a6c280b29983a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20036"
      ]
    },
    {
      "uid": "zhcn:f02b353eb47f5bb9b94cc833",
      "kind": "character_system_text",
      "source_text": "どんなときだって、\r\nキラキラしたわたしで\r\nいられるように…やらなきゃ。",
      "source_fingerprint": "b6bd282672b8a3b8049d5b66f09d458498cd329d7785a1805cad00e1f8bf2a5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20037"
      ]
    },
    {
      "uid": "zhcn:f0308288655e2801d0c8e2b2",
      "kind": "character_system_text",
      "source_text": "いきますっ。",
      "source_fingerprint": "129a4783aeb3150b06a2b9348b2beb9cc7a0600f30f481f5ab0dae26cdecaae1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20038"
      ]
    },
    {
      "uid": "zhcn:76b3e422ea6af7b1f299b19f",
      "kind": "character_system_text",
      "source_text": "キラッと！",
      "source_fingerprint": "15388e966e016eceb41ee098ef84bf1be2ec4a72e4f3911e15792abf2e4681f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20039"
      ]
    },
    {
      "uid": "zhcn:e7acbe173408f41feaa2a511",
      "kind": "character_system_text",
      "source_text": "スタート！",
      "source_fingerprint": "56168e4c96e45494fb01d8c8ca4769e00143d91c911c0e479147002100980cb1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20040"
      ]
    },
    {
      "uid": "zhcn:15e82ea74cfb7d6e359bb51b",
      "kind": "character_system_text",
      "source_text": "始めます。",
      "source_fingerprint": "3a33be5d182910b07f33d048e963b267fea02b8cc4bafdbc2bfce1f5574ee935",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20041"
      ]
    },
    {
      "uid": "zhcn:5f76fd03f22c8d5e67381163",
      "kind": "character_system_text",
      "source_text": "あらら？",
      "source_fingerprint": "5ba2e1900d98bab6a5060ede0e11b8f84b8a8b96f7f93dec320221253d2c9f7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20042"
      ]
    },
    {
      "uid": "zhcn:6fd578831c632b6e650da02d",
      "kind": "character_system_text",
      "source_text": "あぁ…。",
      "source_fingerprint": "ec923a4dd6bef434934c826519961efb7a2a5f6c9685dc2c004484d53cc62483",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20043"
      ]
    },
    {
      "uid": "zhcn:3fbcb2ee6e6271667688b188",
      "kind": "character_system_text",
      "source_text": "出発です♪",
      "source_fingerprint": "fba5768f600b7932c61cccafeabfc7dee6025ed01ba4c8d8e07691ca347fc347",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20046"
      ]
    },
    {
      "uid": "zhcn:4baf833832e57347b18b06d1",
      "kind": "character_system_text",
      "source_text": "ステキな青！",
      "source_fingerprint": "c3ff43ecbbd1f1310f0f83e0c32d66439f0ee88802414e3779bf2d71d04e75fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20047"
      ]
    },
    {
      "uid": "zhcn:585fa968213eee46340acca2",
      "kind": "character_system_text",
      "source_text": "きらめく時間を過ごせました♪",
      "source_fingerprint": "127f97631bd3576e8069c47a88d992c71f1b8d613aca58d81b2024e5b3d8855e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20049"
      ]
    },
    {
      "uid": "zhcn:ff2997fabf57d1d71fa9dcda",
      "kind": "character_system_text",
      "source_text": "ふふ、楽しかったですね。",
      "source_fingerprint": "67ee401d176a280f3feb30e7d41f12cc20a23f47592fb60e3fd04b7f0090a6cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20050"
      ]
    },
    {
      "uid": "zhcn:f03b73adb5f2af948065c7b5",
      "kind": "character_system_text",
      "source_text": "あなたらしく輝いて！",
      "source_fingerprint": "fd574e265fd30dc2e753b13e9f2b7ba712e6285f04161e4ef5b0f4854c2eca03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "20051"
      ]
    },
    {
      "uid": "zhcn:5fdfdef225d3549b6ae71113",
      "kind": "character_system_text",
      "source_text": "ときめきを胸に！",
      "source_fingerprint": "372c9338da6689aa9e9d895d5c04453264e6b167b2a8b9a20bf9dfcf3f1710c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "2030"
      ]
    },
    {
      "uid": "zhcn:dc7919a7d759e671a74bc94e",
      "kind": "character_system_text",
      "source_text": "わたしたちなりの輝きで！",
      "source_fingerprint": "b7c70a2103044aad89429a1a4517f5f8c0d17f0cba8255e6d7383b5d0ebea219",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "2031"
      ]
    },
    {
      "uid": "zhcn:adb9de1a78a4c6ccc58c0109",
      "kind": "character_system_text",
      "source_text": "ふふ、楽しかったですね。",
      "source_fingerprint": "67ee401d176a280f3feb30e7d41f12cc20a23f47592fb60e3fd04b7f0090a6cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "2032"
      ]
    },
    {
      "uid": "zhcn:4c6b7815bce7fac97e75a237",
      "kind": "character_system_text",
      "source_text": "いっしょに試行錯誤して\r\nここまで来たんです。\r\n脚は止めません！",
      "source_fingerprint": "b1315893f87041cb2ee96c4cd4c73549c8eaf131cb02f0e0ee386c70a8345b47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "2033"
      ]
    },
    {
      "uid": "zhcn:0bc761c72e433c7c7b2837b4",
      "kind": "character_system_text",
      "source_text": "コンディションは最高…\r\n怖いものなしの\r\nキラキラモードです！",
      "source_fingerprint": "3bbe233b61382a067c3e57b7a13a7270ee33cf8b3388e4979db7396e99ccaa56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "2034"
      ]
    },
    {
      "uid": "zhcn:da120e1d0b33c3559f4a01b5",
      "kind": "character_system_text",
      "source_text": "ふふ、楽しかったですね。",
      "source_fingerprint": "67ee401d176a280f3feb30e7d41f12cc20a23f47592fb60e3fd04b7f0090a6cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "2035"
      ]
    },
    {
      "uid": "zhcn:c4b499157188bb887c257fe1",
      "kind": "character_system_text",
      "source_text": "スタート！",
      "source_fingerprint": "56168e4c96e45494fb01d8c8ca4769e00143d91c911c0e479147002100980cb1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "23015"
      ]
    },
    {
      "uid": "zhcn:2876e0043b3a07f6eaaea38b",
      "kind": "character_system_text",
      "source_text": "次は今より輝けるように！",
      "source_fingerprint": "3f4cafcaa0e8c8a0fd9ba3c2d91c06f859fae6cfc39d45dee1a724184acf50fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f265fe15bfe8a25da1ed7655",
      "kind": "character_system_text",
      "source_text": "これで満足はできませんっ。",
      "source_fingerprint": "c87d5c9b8a911038dfe0655f18545aa23df12e0208e8e7fec5355aff99ac703d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "30001"
      ]
    },
    {
      "uid": "zhcn:333101fd8fb5730f66a6e2bc",
      "kind": "character_system_text",
      "source_text": "リベンジあるのみですね。",
      "source_fingerprint": "18ceaf1ef6ff39aa459f4bd32208432849c200deb496f49c7a74b4698f4ccc80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "30002"
      ]
    },
    {
      "uid": "zhcn:52c66e0a2325278ff09aeff5",
      "kind": "character_system_text",
      "source_text": "『わたし』を見つめ直さなきゃ…！",
      "source_fingerprint": "34e282c65f2982a5f65918f55f3de291ed83e03338290185389c8c2c019fcb93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "30003"
      ]
    },
    {
      "uid": "zhcn:b90e2f930f18a5eda37ca1e9",
      "kind": "character_system_text",
      "source_text": "最高のランウェイを飾りました♪",
      "source_fingerprint": "340836764b8d9bfc6da53e58c646cd67321062a45a3c059592642037446bbfc0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "30004"
      ]
    },
    {
      "uid": "zhcn:de186d31af8833bd2dd704f0",
      "kind": "character_system_text",
      "source_text": "輝きをあなたにも♪",
      "source_fingerprint": "7aeb7c822eb16cf0d8affe88c776cfb5f4f643461acbb99d25ed04989c3c687e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "30005"
      ]
    },
    {
      "uid": "zhcn:0d5366ec9b1784a6b8845b72",
      "kind": "character_system_text",
      "source_text": "出番ですね！",
      "source_fingerprint": "4b3f8013c5c1b7a743b93c6f63ccbca064ac6d0292093e0780d07aaefde213e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "31000"
      ]
    },
    {
      "uid": "zhcn:2e7413fb050ddbb51ab84187",
      "kind": "character_system_text",
      "source_text": "煌めきをまとって、いざ！",
      "source_fingerprint": "40d3b367cd3074ee46b08a2a5cf6a4a1fe74878233b449d27c0ac2a719e911db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "40000"
      ]
    },
    {
      "uid": "zhcn:65e7accc4b77a21b5836a81d",
      "kind": "character_system_text",
      "source_text": "爆进爆进爆进！\r\n爆进爆进爆进！\r\n…呵呵！真想也随着这首歌跳舞呢♪",
      "source_fingerprint": "f3a61679831bc3676882bf28f29cd7083ce14535483ba51937185851c0dc28dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400001"
      ]
    },
    {
      "uid": "zhcn:6a139ff82cb785be4c8a6f22",
      "kind": "character_system_text",
      "source_text": "チケットさんのファッションは\r\n遊び心があるんですよね。だから\r\n遊べるアイテムを選んでみたんです",
      "source_fingerprint": "d7a9daaef5e5a896120142e2dc6a55599a8a5f80dc977e2fa5fc6a0596e4e031",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400002"
      ]
    },
    {
      "uid": "zhcn:591953df924b3bbc363bac69",
      "kind": "character_system_text",
      "source_text": "ファッションでも、リサーチは\r\n大切ですので。街ですれ違う方々の\r\n服装はいつもチェックしていますよ",
      "source_fingerprint": "0b9921004331dd6d6297913383ea677c2972e3a0639b702256dc16763abbcd6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400004"
      ]
    },
    {
      "uid": "zhcn:78def37d607c42285f308346",
      "kind": "character_system_text",
      "source_text": "わたしたちの衣装は、華美に\r\nならないよう気をつけました。\r\n主役は和菓子ですからね♪",
      "source_fingerprint": "f065d660f39a2dab5165b240b3bacf1bd3b5a96d76569993fe4c85543f09cbb5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400008"
      ]
    },
    {
      "uid": "zhcn:4566f0b7e75bfcb19aaad4ea",
      "kind": "character_system_text",
      "source_text": "ふふっ…個性、彩り、ときめき…\r\n自分だけの輝きを求めて、\r\n可能性は広がっていく――！",
      "source_fingerprint": "4a77bda92e63023af41074a34242243313cb62a267e4a46b02673a359b26ee3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "40001"
      ]
    },
    {
      "uid": "zhcn:7ba60b86441233cae232f8e7",
      "kind": "character_system_text",
      "source_text": "イベントミッションはこちら！\r\n難しくても、活路はあるはず。\r\n最後までファイトですよ！",
      "source_fingerprint": "8df1c098d4e47e8d67e7a6265e0a95ae475af07eebf1a64809fc39fe7b712d31",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400012"
      ]
    },
    {
      "uid": "zhcn:2d704c2ef0ec15d9fc5915db",
      "kind": "character_system_text",
      "source_text": "服装も気持ちも、最後まで\r\nビシッと決めていきましょう！\r\n報酬の受け取りもお忘れなく。",
      "source_fingerprint": "86fb57b07b60f773902735b96dff3d7ab51594de7b37016d62d79e6d115e1d56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400013"
      ]
    },
    {
      "uid": "zhcn:7c5f499d6bc6d4fb2d3c0825",
      "kind": "character_system_text",
      "source_text": "金花酱在分别时送给我的\r\n香囊…散发着温柔、温柔的香气\r\n――谢谢你，我会加油的。",
      "source_fingerprint": "ecbff96f86c7d63781c1ca101b8d4d6543a1972695715a77baf1190f3b363bbb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "400128"
      ]
    },
    {
      "uid": "zhcn:aafccffbba43ac7c820e15fb",
      "kind": "character_system_text",
      "source_text": "誰よりもまぶしく輝いちゃいましょう。",
      "source_fingerprint": "494e18eeb4bf9a60f58dc8fce5e7617384a4364fd57e8d2940771736acce298f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "60000"
      ]
    },
    {
      "uid": "zhcn:98d5d8263390a0709d2c4c0d",
      "kind": "character_system_text",
      "source_text": "ありったけの光を届けます！",
      "source_fingerprint": "a7020c8293af3be5551934ecf2eda0103b01f3f1cc89888958e7b0e2bd5d3558",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "60001"
      ]
    },
    {
      "uid": "zhcn:7c83c55e642d1c51cc735f4b",
      "kind": "character_system_text",
      "source_text": "わたし史上最高を更新します♪",
      "source_fingerprint": "9f6d653896f117398c1f8c41d85ab23e096a8d96503c63763d9ec8d0acbca162",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "70000"
      ]
    },
    {
      "uid": "zhcn:e7a5eeda28d3e9f8a93e7c94",
      "kind": "character_system_text",
      "source_text": "わたしからのアドバイス…\r\nトレーナーさんの助けに\r\nなりましたか？",
      "source_fingerprint": "c2e48fd032872f66775c6a8b14d5b2e3bc0edab234edd9fe73bb19138af3e52f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1082",
        "70001"
      ]
    },
    {
      "uid": "zhcn:5eea2de51c269816e713ac8f",
      "kind": "character_system_text",
      "source_text": "無理にアレンジしなくても\r\nとってもかわいいですよね。",
      "source_fingerprint": "5dd34c57021b9cc296678999134cf1984b46544b12ad8d1d14d4b7e14f71ec12",
      "source_path": "character_system_text_dict.json",
