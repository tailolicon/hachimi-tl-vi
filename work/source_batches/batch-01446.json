{
  "schema_version": 1,
  "batch": 1446,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:f80bd159fa45a91bb9d77e16",
      "kind": "character_system_text",
      "source_text": "ん…。",
      "source_fingerprint": "03e850be378bdf5a0209875ba59221208332eff2bb0ec0f59d887ef8fd12cfa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "140015"
      ]
    },
    {
      "uid": "zhcn:8a095d33f4a93166a7601351",
      "kind": "character_system_text",
      "source_text": "どうかなさって？",
      "source_fingerprint": "fa629d852f8c9108e447c58f83fd007cf481fce2033896b68435722ae9a8eb61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "140016"
      ]
    },
    {
      "uid": "zhcn:a1841c4bbde66178193e1321",
      "kind": "character_system_text",
      "source_text": "残念。",
      "source_fingerprint": "47f686705a9e5bd8c5d387edda4418a6a998a9478bcbc00ee15432f10cabfea2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "140017"
      ]
    },
    {
      "uid": "zhcn:d5a174b02c5bfb4e22e4f113",
      "kind": "character_system_text",
      "source_text": "失敗ね。",
      "source_fingerprint": "3fad5890a787d196fe232f751302061d39162bd7842add5b3c66e6c6200a271f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "140018"
      ]
    },
    {
      "uid": "zhcn:1b88042f212416e97a7388c4",
      "kind": "character_system_text",
      "source_text": "明日はこちらですわ。",
      "source_fingerprint": "2b409361245c35c1a0f8acfaff3a6d8c3aa90831938b8e368f36bb342d2ac9e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "15"
      ]
    },
    {
      "uid": "zhcn:4e68f78b41a349d24a36c363",
      "kind": "character_system_text",
      "source_text": "…トレーナーとしての、\r\n賢明な判断を期待しますわ。",
      "source_fingerprint": "29921b734fe1d8cf2d6bd156450d6b0a08832dacfb391989c7671f6327bc2f99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20000"
      ]
    },
    {
      "uid": "zhcn:2c66fc5b3cef2c1609995584",
      "kind": "character_system_text",
      "source_text": "…疲れてるの。\r\nご覧の通り。",
      "source_fingerprint": "73975ed905aab0b9e79d0d08154f1b6aacbd2c4064e4626abd8f2bb675bce574",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20001"
      ]
    },
    {
      "uid": "zhcn:80bb65e8cbcf1e310328e877",
      "kind": "character_system_text",
      "source_text": "ふふっ…。\r\n今よりも強くなれるのが、\r\nとっても楽しみ。",
      "source_fingerprint": "4a0965da68d855e3fd9bf40913701292bd772f25eb321212244ab0fd3bcdbaec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20002"
      ]
    },
    {
      "uid": "zhcn:bda486121982a9ad9e3d99e8",
      "kind": "character_system_text",
      "source_text": "くす、いいわよ…\r\n見つめていても。",
      "source_fingerprint": "527650f88cc83a9820145714413ee318c0c760c8913c95df51d41ef05b6b411a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20003"
      ]
    },
    {
      "uid": "zhcn:0b5cce783073a93dc0ab02b8",
      "kind": "character_system_text",
      "source_text": "いい天気ね。\r\n走るにはうってつけ。",
      "source_fingerprint": "c865522536cf64336aaa0bc82c63b70267095e27dfd793f753f064ef7506bc8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20004"
      ]
    },
    {
      "uid": "zhcn:5eb64133c4feb96828d2b69b",
      "kind": "character_system_text",
      "source_text": "コースがいいけれど…\r\n貴方のご意見は。",
      "source_fingerprint": "405261ccfc914a3d03717f147c02531e1e525fadb482956c632a3be90deaa2f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20005"
      ]
    },
    {
      "uid": "zhcn:cc9c739523a1e0203969438d",
      "kind": "character_system_text",
      "source_text": "何から始めましょうか。",
      "source_fingerprint": "2a2bb2fe7ad1f3e5cbe4482196a320ac0c13b6309945b0dd60a4d0d299a908ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20006"
      ]
    },
    {
      "uid": "zhcn:85c61cb9312da7556e57d665",
      "kind": "character_system_text",
      "source_text": "よく考えて、\r\n選んで頂戴な。",
      "source_fingerprint": "41d44f8164852eccae8515dc5d4267d16e4e345b95c0387920c00af5e728b333",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20007"
      ]
    },
    {
      "uid": "zhcn:f0bbb5dfc576ddb5ed7f123f",
      "kind": "character_system_text",
      "source_text": "お喋りは不要よ。\r\n指示をくださる？",
      "source_fingerprint": "86b87028e9a1c01a158c8c34ae336cad2fa7c69bd48371d7f55b0d019330efb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a6dc6a7d8a9e5a2601b5e8e1",
      "kind": "character_system_text",
      "source_text": "ウォーミングアップは、\r\n外周でもよろしいわね。\r\n少し気分を変えたいの。",
      "source_fingerprint": "94a708cfe9c9d289f5b5a3b38915595d8b9ca6e874337b5b327e3f899010fef6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20009"
      ]
    },
    {
      "uid": "zhcn:01348bd5e39c1410f3b42d4f",
      "kind": "character_system_text",
      "source_text": "…………。\r\n要らないわ、その視線。",
      "source_fingerprint": "bbef186b7adf7ff5e3e129ecd2924473ff928c570cb56019a26e20e0eb7a869a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20010"
      ]
    },
    {
      "uid": "zhcn:710b79f3b6387dcb1614e3d8",
      "kind": "character_system_text",
      "source_text": "ふぅ…。\r\n最低な気分…。",
      "source_fingerprint": "3c3611c6ddbe723decc8961a1ac860f575f298ab340696419390922e08ec1d33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20011"
      ]
    },
    {
      "uid": "zhcn:93abbbb01abea8cbc527e249",
      "kind": "character_system_text",
      "source_text": "…先の見通しと、勝算があると、\r\n自信をもって言えるのならば。",
      "source_fingerprint": "a7582bda384850996a59a622d4348e9462f295d3f7706941dde4b0f4529b17bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20021"
      ]
    },
    {
      "uid": "zhcn:7cddea03d4abfab33947dfb2",
      "kind": "character_system_text",
      "source_text": "貴方、レースを愛していないのね。\r\nとっても残念…本当に。",
      "source_fingerprint": "dad1ffdecc1e2a1215bb4a902553ded9f7d80b8b95f22a78c1aab99bcb829fd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20022"
      ]
    },
    {
      "uid": "zhcn:7db22e047cafc43a5fb3f9db",
      "kind": "character_system_text",
      "source_text": "予感がするの。\r\n今日のレースは…\r\n素晴らしいものになるわ。",
      "source_fingerprint": "d39d6e29c81885b12bc5a15adde66b3898c76b24ddf58540b87dab21cdbf81f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20023"
      ]
    },
    {
      "uid": "zhcn:f873efdd8d851caa4087aef2",
      "kind": "character_system_text",
      "source_text": "ああ、心がときめく…。\r\n待っていてね、私の愛…。",
      "source_fingerprint": "ab56cf322115b167c064f499c2e227ba7601df3a1415ed7debebf7c5caeda0c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20024"
      ]
    },
    {
      "uid": "zhcn:be62dacce6721f39c00e25cb",
      "kind": "character_system_text",
      "source_text": "完璧に準備をして、\r\n完璧な私に成った。\r\n相応しい結果は…1つだけ。",
      "source_fingerprint": "893ef9baf8bd978eba1ee0d503900851f713f4af3de96e50ad333523f91c08e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20025"
      ]
    },
    {
      "uid": "zhcn:25920989176343fb9977711a",
      "kind": "character_system_text",
      "source_text": "いい気分…。ターフに吹く風も、\r\nきっと私を歓迎してくれる。",
      "source_fingerprint": "6831375a3ad83d31c5b3d02408b8efe4daecdc887a01bb70b0448865f16f7bcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20026"
      ]
    },
    {
      "uid": "zhcn:dea543a9570bf30aad0aedd6",
      "kind": "character_system_text",
      "source_text": "場内の興奮が…伝わってくる。\r\n素敵なレースになりそう。",
      "source_fingerprint": "479367839e59134d604f015757697998452c759f5e75856aadf53786d3542b08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20027"
      ]
    },
    {
      "uid": "zhcn:19b3a5dbb3ef0233906f7f43",
      "kind": "character_system_text",
      "source_text": "ゲートの中で、スタートを待つ…\r\nあの瞬間の、胸の高鳴り。\r\n思い出すだけで、ぞくぞくする…。",
      "source_fingerprint": "a546ee78bfa3ab9bcac849cf081fb4c2d84b1a4a2df449a52901c5864ea3d623",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20028"
      ]
    },
    {
      "uid": "zhcn:55c593d06d1251a60ae1cfe4",
      "kind": "character_system_text",
      "source_text": "どうかなさって？\r\nレースへ参りましょう。",
      "source_fingerprint": "6e3f11ffa6b3c05a22fe6926a8a9c0b19727125cdbf0ee9889f18b68cb72d7ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20029"
      ]
    },
    {
      "uid": "zhcn:f9ef4d2b21c3718dfec6731a",
      "kind": "character_system_text",
      "source_text": "さあ…レースが、\r\n私を待っている。",
      "source_fingerprint": "6617c9054918b8279a406a5c1799745bb3ff00e8261c469bfcda771ab22e0a34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20030"
      ]
    },
    {
      "uid": "zhcn:e1f93aec316eda4c6b7ea541",
      "kind": "character_system_text",
      "source_text": "緊張…なぜ？\r\n私は私の積み重ねたものを、\r\nよぅく知っていますわ。",
      "source_fingerprint": "59ff47c0b8485c4d1bcee6fb9ed51b6627fd893e1a396594125ea1417a142863",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20031"
      ]
    },
    {
      "uid": "zhcn:aa2b4aab6ca927205225d224",
      "kind": "character_system_text",
      "source_text": "絶対的に完璧とは、到底言い難い…\r\nけれど…レースに絶対もない。",
      "source_fingerprint": "48759e8b344f12cd5b7488363f82407594f12f03fe35307ffff57d0acfadc3da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20032"
      ]
    },
    {
      "uid": "zhcn:88cdadce06cb5a7ae9662a6e",
      "kind": "character_system_text",
      "source_text": "間に合わなかった。\r\n想定以上の力を出さなければ…。",
      "source_fingerprint": "b9b1f3ec1228759d58213d5f53c63cadb57682b41ef365c850a22a3b33750196",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20033"
      ]
    },
    {
      "uid": "zhcn:3e493165141205bd61a8355b",
      "kind": "character_system_text",
      "source_text": "全ては杞憂に過ぎない。\r\n愛が…この胸で燃えている限り。",
      "source_fingerprint": "2e8cc79ff4549a2c073f574601d63c339633d83ec1033a7ff457468b6ec95a82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20034"
      ]
    },
    {
      "uid": "zhcn:28e80cd8e3d0be8a68736cb0",
      "kind": "character_system_text",
      "source_text": "…それでも挑まなければ。\r\n勝利は得られないのだから…。",
      "source_fingerprint": "31cb6e19fb2cce6a0492491dea6cc45da0695fbbe13875ce23cc06dc1af1b06a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20035"
      ]
    },
    {
      "uid": "zhcn:c91110e65b2adc4b7f3f574d",
      "kind": "character_system_text",
      "source_text": "ええ、調子は最悪よ。\r\nそれがどうだと言うの…\r\n時間は戻らない。進むだけよ。",
      "source_fingerprint": "3aacd01caae8e7fa3d7003058b6bd91e73d7e595929cca1e027b0f101ea7d532",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20036"
      ]
    },
    {
      "uid": "zhcn:ead2bf120db30a7fa86c7418",
      "kind": "character_system_text",
      "source_text": "…集中しているの。\r\nわかりませんこと？",
      "source_fingerprint": "bf5228d46e2806862f65361704fac9c843cf1b146997b97d71d2590643afa879",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20037"
      ]
    },
    {
      "uid": "zhcn:a3f6ef1773c83c556544b313",
      "kind": "character_system_text",
      "source_text": "ええ。",
      "source_fingerprint": "30224d71f95afa967c387b6513d7bcc534c393cc15c36334b132286ff5d66c36",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9d4cbd223e7fc33bc16410b8",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20039"
      ]
    },
    {
      "uid": "zhcn:0c26a04decc585361a928a55",
      "kind": "character_system_text",
      "source_text": "よろしくてよ。",
      "source_fingerprint": "4cdbaa72700c529234e3b23187a7fccd3056f460e8889ca481e33052a8442043",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20040"
      ]
    },
    {
      "uid": "zhcn:60c80ed3bdf7745a84a4128b",
      "kind": "character_system_text",
      "source_text": "ふぅん…。",
      "source_fingerprint": "8bb0127cc7083205851d9589a9431467919e9345a924b6e45beffaa5c451f3ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20041"
      ]
    },
    {
      "uid": "zhcn:9c51b07fdb3466a738015445",
      "kind": "character_system_text",
      "source_text": "ふぅ…。",
      "source_fingerprint": "6bebf8dbf5c5bbfe6ecdf5e756feef588f17fb090752cd7323dd261355166aac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20042"
      ]
    },
    {
      "uid": "zhcn:cf4f787600daad04cfb3ec44",
      "kind": "character_system_text",
      "source_text": "はぁ…。",
      "source_fingerprint": "0c8314545e95415cbadeb18610f29c1e28d72193a66a67e8c50153c22f50af68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20043"
      ]
    },
    {
      "uid": "zhcn:9f3a4cd5e522ada25178dc6a",
      "kind": "character_system_text",
      "source_text": "どうぞ。",
      "source_fingerprint": "ae7e8f34fe71d3ae18864b7730e7af1a25ad69072b0f4a056be1c6628a539d35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20046"
      ]
    },
    {
      "uid": "zhcn:a0b080eb20a5f551221563db",
      "kind": "character_system_text",
      "source_text": "眩しい…。",
      "source_fingerprint": "f6e878a006d30fb508f6a6d4c35b3a6a5932db579b054a7c63d9d4ff39106595",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20047"
      ]
    },
    {
      "uid": "zhcn:b6f9f1889deed07b94a932d0",
      "kind": "character_system_text",
      "source_text": "悪くなかったわ。",
      "source_fingerprint": "a0f2223967188f3daee57029492020310e04124ff9e6ce91c5fe6036b131dde3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20049"
      ]
    },
    {
      "uid": "zhcn:f6cb0f968bc32c38eafa5a63",
      "kind": "character_system_text",
      "source_text": "どうも。",
      "source_fingerprint": "43cd30b7114057250c29af21f28d1fa995522109c6afb615d389d0746d8d147b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3ac5d944c274bd522c081253",
      "kind": "character_system_text",
      "source_text": "哎呀，真有热忱呢。",
      "source_fingerprint": "6d087053cce4cff1a47477576e61b44039d3325da0e6e015114e5f2872b7bfd8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20051"
      ]
    },
    {
      "uid": "zhcn:e9f92009fb1cbc215e32b7a1",
      "kind": "character_system_text",
      "source_text": "参りましょう。",
      "source_fingerprint": "550ae0cca8ce02f21c817336ea537feb3001ba9442ddf10f4fb8bbc3e372fb1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "2030"
      ]
    },
    {
      "uid": "zhcn:621fa8bbc00d6a4ba79d7781",
      "kind": "character_system_text",
      "source_text": "望むのは…勝利だけよ。",
      "source_fingerprint": "a6749b6aaaa9093d29055a563dee8469530046cb8d1f9fcf9cca0902e8b2ae48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "2031"
      ]
    },
    {
      "uid": "zhcn:96a70b3b4dcab82fb7d752e4",
      "kind": "character_system_text",
      "source_text": "どうも。",
      "source_fingerprint": "43cd30b7114057250c29af21f28d1fa995522109c6afb615d389d0746d8d147b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "2032"
      ]
    },
    {
      "uid": "zhcn:6239fa8c97ccb17995b48562",
      "kind": "character_system_text",
      "source_text": "ゲートの中で、スタートを待つ…\r\nあの瞬間の、胸の高鳴り。\r\n思い出すだけで、ぞくぞくする…。",
      "source_fingerprint": "a546ee78bfa3ab9bcac849cf081fb4c2d84b1a4a2df449a52901c5864ea3d623",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "2033"
      ]
    },
    {
      "uid": "zhcn:ca1ebba0faa0ae6b65d1af36",
      "kind": "character_system_text",
      "source_text": "完璧に準備をして、\r\n完璧な私に成った。\r\n相応しい結果は…1つだけ。",
      "source_fingerprint": "893ef9baf8bd978eba1ee0d503900851f713f4af3de96e50ad333523f91c08e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "2034"
      ]
    },
    {
      "uid": "zhcn:eaf60545fd65cfd1674dd5b4",
      "kind": "character_system_text",
      "source_text": "どうも。",
      "source_fingerprint": "43cd30b7114057250c29af21f28d1fa995522109c6afb615d389d0746d8d147b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "2035"
      ]
    },
    {
      "uid": "zhcn:403738ed2c7cf2547c50b115",
      "kind": "character_system_text",
      "source_text": "始めましょう。",
      "source_fingerprint": "5f65feadc5df3a67388e0b0611e8001d48fdc3726284e5fc828766adeb5793e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "23015"
      ]
    },
    {
      "uid": "zhcn:8acadb45fe3131fac13a452d",
      "kind": "character_system_text",
      "source_text": "あともう少し…。",
      "source_fingerprint": "bab878f318cbdad4c0415a2dd7ae0e2c936022d76a854429c978070603a69a3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "30000"
      ]
    },
    {
      "uid": "zhcn:a33fc62d6b514e1f722615e7",
      "kind": "character_system_text",
      "source_text": "次こそは…完璧に。",
      "source_fingerprint": "99c8d6bfe0b1da4c0ddf4e94a2e39a5178f568037df3f0aa94928fb4e2bded5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "30001"
      ]
    },
    {
      "uid": "zhcn:b91cf215c16d3e94d337b33e",
      "kind": "character_system_text",
      "source_text": "未熟ね…。",
      "source_fingerprint": "f8e41a08d1417e760d4b967fd09d51ecc39e9f1bce0145577e3f97aed6dc83da",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "30002"
      ]
    },
    {
      "uid": "zhcn:f82e040a42144eae81f2a496",
      "kind": "character_system_text",
      "source_text": "不完全な…許せない…。",
      "source_fingerprint": "5ea76bd7223afec7474808208049b222f703cded401e21dd57544e9719a964c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "30003"
      ]
    },
    {
      "uid": "zhcn:29ffe7dd57a97845b59d664c",
      "kind": "character_system_text",
      "source_text": "ああ…愛してる。",
      "source_fingerprint": "aa087a7ef5a2c616f3ee52293bcd4f1a5642e811885e0a8f4f30736140d9ab53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "30004"
      ]
    },
    {
      "uid": "zhcn:11d2e27981c749741bea1dd5",
      "kind": "character_system_text",
      "source_text": "楽しかったわ、とっても…。",
      "source_fingerprint": "f79f9f7fb9d68aa6ba47b146376479917cfb48e7ded20cc59c8e0f3126b153ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "30005"
      ]
    },
    {
      "uid": "zhcn:38d0b874f5bc9b83b945873d",
      "kind": "character_system_text",
      "source_text": "行くわ。",
      "source_fingerprint": "4ffe92127f8fd4a0e25621c5f78efd7fa4ef72af8e6225bc82f47077917c1d8e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "31000"
      ]
    },
    {
      "uid": "zhcn:bfd4d07541efb6ec60865a21",
      "kind": "character_system_text",
      "source_text": "愛が私を、導くの…！",
      "source_fingerprint": "3bf9a6821a54bfb4294dcbb749dd1c8ff191b931c46d15a498eb7c3ed966dd21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "40000"
      ]
    },
    {
      "uid": "zhcn:fbee4cf09ca32b726c3f1a52",
      "kind": "character_system_text",
      "source_text": "我想办一场美好的仪式。\n完美、至高无上的…\n还要点缀上稚嫩的花蕾……呢",
      "source_fingerprint": "d69366d882adfedc6c48eff3cfe3a717c2b33ba55efbd0d5f2089fb1d34ad9bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400000"
      ]
    },
    {
      "uid": "zhcn:589b4e9cfd2a25ab9d037e3a",
      "kind": "character_system_text",
      "source_text": "クリスマス・ナイトは布石。\r\n――煽ってあげるわ。",
      "source_fingerprint": "b19bf315722a5843ae07c29369cfc6ff50ca0b6d5ec492fcbdd9553d03398c8b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400005"
      ]
    },
    {
      "uid": "zhcn:25b21a9d579379648344320c",
      "kind": "character_system_text",
      "source_text": "现在就让我好好期待吧。\r\n……期待那与灿烂「未来」的邂逅。",
      "source_fingerprint": "685a2f15c2c31bf262d2658f3c2c313241624b6fe180f66debda4aec663cdbe9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400006"
      ]
    },
    {
      "uid": "zhcn:c1954aa00dc493127b435bad",
      "kind": "character_system_text",
      "source_text": "次の逢瀬が楽しみだわ。\r\nどんなめくるめく景色が\r\n見られるかしら。",
      "source_fingerprint": "fe27f31552ca2c4039290a8707bbf36e010d2f46f0974c73308a6829ca636363",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400008"
      ]
    },
    {
      "uid": "zhcn:1ffcfee240181c4f990a3e9e",
      "kind": "character_system_text",
      "source_text": "この脚も、速さも、強さも、全て…貴方のもの。\r\n待っていて、今――勝つわ。",
      "source_fingerprint": "e9850746807af364c8a423578f22e667a2c7847c1c122f7e2c3bcb842482731b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "40001"
      ]
    },
    {
      "uid": "zhcn:5e76cd5d118dee241eb5c53a",
      "kind": "character_system_text",
      "source_text": "她们真可爱啊。\n迷茫、挣扎着——拼命绽放自己的花朵。\n那就让我来摘下吧，无论多少次都可以。",
      "source_fingerprint": "61c81b54eafb3980d798ab1bf34e7659a4477e8823b2af6c6a423a9fbdc9c17a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400011"
      ]
    },
    {
      "uid": "zhcn:993505536134391e86f228eb",
      "kind": "character_system_text",
      "source_text": "我先告辞了。\r\n让我们在某个未来再相见吧。",
      "source_fingerprint": "2c8f94b7fce010762d371df8f2643d8cb3112b11b632465d1d491eba984fb569",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400014"
      ]
    },
    {
      "uid": "zhcn:1769423dfecb74753345dd3b",
      "kind": "character_system_text",
      "source_text": "余韻を味わっているのかしら。\r\n――よほど甘美なのね。",
      "source_fingerprint": "535abc2f1743a91209bf45c76d8cfa9e0fc9cc74d41f21d0fc268bdfe58950ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400067"
      ]
    },
    {
      "uid": "zhcn:2e23a0a96d99dd2bab87a011",
      "kind": "character_system_text",
      "source_text": "……哈啊。明明度过了那么美好的时光，\n可现在却已经如此难受了。\n好想见你——你真是罪孽深重啊。",
      "source_fingerprint": "f59c09bada2815e44fa3aa1cf775fc153e9fb257dc2ccf79c9be2adf3ca3f7a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "400112"
      ]
    },
    {
      "uid": "zhcn:8fa68dda80a81a2c58337a94",
      "kind": "character_system_text",
      "source_text": "お望み通り、演じてあげますわ。",
      "source_fingerprint": "947a338fbafe3a5466d2f60ca287d4af8e65d9f46ed7d5af325bc73894a5adf0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "60000"
      ]
    },
    {
      "uid": "zhcn:08efe3c95313c43ffaaad4d9",
      "kind": "character_system_text",
      "source_text": "退屈しのぎね…。",
      "source_fingerprint": "b91bedd9aa037bd3d68a15ef3d84a7dbdd2bdff1bdc6f8287f0d6e3b41c29894",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "60001"
      ]
    },
    {
      "uid": "zhcn:34434393d234108505411747",
      "kind": "character_system_text",
      "source_text": "你想怎么做请随意，\r\n我只会埋首于跑步哦。",
      "source_fingerprint": "e7350c1eb70f9195e2673a380850cf4f641057cba2df67d03e602f09c58ea360",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70000"
      ]
    },
    {
      "uid": "zhcn:114a2529cc41c26760184e31",
      "kind": "character_system_text",
      "source_text": "私が覚えていられるように…\r\n示してくださる、貴方の資質。",
      "source_fingerprint": "5c032c83ddf414da41b5f4bb40cd178fab141f062a1160660ba4992ac6d0db19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70001"
      ]
    },
    {
      "uid": "zhcn:a0dba7d344474b4263cf6b9e",
      "kind": "character_system_text",
      "source_text": "愛らしいデザインよね。",
      "source_fingerprint": "8bdf4348d8019c3837cd682f065f442b3ba4c1d27429c0e0dcfb9aded41a7c7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70004"
      ]
    },
    {
      "uid": "zhcn:5082fa0ab800269aae47eac3",
      "kind": "character_system_text",
      "source_text": "華やかね。",
      "source_fingerprint": "30402706e7544a1a0e839a9f048fbdcd36c2dc5eb13b4aa376a07bfeb4ede031",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70008"
      ]
    },
    {
      "uid": "zhcn:635b222a67afb4f67dadfae8",
      "kind": "character_system_text",
      "source_text": "完璧なアシンメトリー…美しい。",
      "source_fingerprint": "45913271819b47b76c7aa2096d4095b7a5b2cfeb11e03caa2f3dde0a45087729",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70009"
      ]
    },
    {
      "uid": "zhcn:b1e4408a269f32670e3e150d",
      "kind": "character_system_text",
      "source_text": "規則だもの、従うわ。",
      "source_fingerprint": "6454bed639c68401c429169df0829625df0203d17c8d99e5aeb7715afc9cb1e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70010"
      ]
    },
    {
      "uid": "zhcn:9785854fa34cb2739d03e7ef",
      "kind": "character_system_text",
      "source_text": "体のラインがよく見えるところ、\r\n好きよ。",
      "source_fingerprint": "dc43ec178ac38759fd824df2f5ea2fb7e1f217464eba7f2b67273037d300e7ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70014"
      ]
    },
    {
      "uid": "zhcn:58b9525c9148f0e25c313e8b",
      "kind": "character_system_text",
      "source_text": "レースに捧げる、愛のデザインよ。",
      "source_fingerprint": "0062be63c1a6427800dc67c490c0170e0f999b9bd5b42843a3219fed352ab19c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70015"
      ]
    },
    {
      "uid": "zhcn:61e315b047ae43782a459e56",
      "kind": "character_system_text",
      "source_text": "これがお好きなの？",
      "source_fingerprint": "e32cd518853fe6fccd1d5d01899a0f801f0a2301357ad5f22f3ba8f8f17ebe3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "70018"
      ]
    }
  ]
}
