    {
      "uid": "zhcn:ae2fdd8e4d6930b59d94fda0",
      "kind": "character_system_text",
      "source_text": "要更加努力。",
      "source_fingerprint": "326d0edb11e9270e502b18c97ebb6c26297ce0fc11c619418bba9646d1d9f02b",
