{
  "schema_version": 1,
  "batch": 1451,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:0a6442646e72896bac958bb2",
      "kind": "character_system_text",
      "source_text": "请交给我。",
      "source_fingerprint": "bbccca85f058e7982fa407c9b21ad49d10f46f78cd350ee68ab04b7abed52c40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20040"
      ]
    },
    {
      "uid": "zhcn:339033db20fa77e6d5cf1019",
      "kind": "character_system_text",
      "source_text": "好的。",
      "source_fingerprint": "092cd95e8a64d58d136c3c650b8d9d7cc23ad4ad69c0c649443874ffaa82fc65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20041"
      ]
    },
    {
      "uid": "zhcn:eab8986be221b3cfa7913e31",
      "kind": "character_system_text",
      "source_text": "唔……！",
      "source_fingerprint": "88b08a445830f60f831cc69715bfe607a664dd20f0eb7a6b5add5663dfe83b11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20042"
      ]
    },
    {
      "uid": "zhcn:1f1957cf51ede49c070515a8",
      "kind": "character_system_text",
      "source_text": "为什么……",
      "source_fingerprint": "3d8160a5d5173c64bf6663ecdf0abbdb4366485a3dfae0391cf8dc62dfd961ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20043"
      ]
    },
    {
      "uid": "zhcn:ba6ef42225788a3f168d99d1",
      "kind": "character_system_text",
      "source_text": "我们出发吧。",
      "source_fingerprint": "c3864e9473832146609b6ca6bdb0b249e490876d8260a714cff7a38028b9d836",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20046"
      ]
    },
    {
      "uid": "zhcn:155b986bc371422e38c1fcd1",
      "kind": "character_system_text",
      "source_text": "好美的地方……",
      "source_fingerprint": "7463d61fb27a90112327386267a1a98c9f41398967fbda780cfff03f7afc7d11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20047"
      ]
    },
    {
      "uid": "zhcn:3799a0830ed0a359ea1fe6dd",
      "kind": "character_system_text",
      "source_text": "我已经看到你的觉悟了。",
      "source_fingerprint": "8811783d6ef62344ca36a8f3453c0e1cb436bafa28f06a41fa00ff3b53d13fe9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20049"
      ]
    },
    {
      "uid": "zhcn:fbf36166108e6049dd252b29",
      "kind": "character_system_text",
      "source_text": "感谢这段缘分。",
      "source_fingerprint": "13b97518e433937890fba002e879338ceb6d40e66cf3dc4b3517569607cb4bec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20050"
      ]
    },
    {
      "uid": "zhcn:38802ca6bb30842f1aa3cf4e",
      "kind": "character_system_text",
      "source_text": "这也是我的职责。",
      "source_fingerprint": "98cace2535599b69272362579a7dd4eb7ca356d167c182784d00b0ee5cabf516",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "20051"
      ]
    },
    {
      "uid": "zhcn:a12e3c23d85f20f988f9667a",
      "kind": "character_system_text",
      "source_text": "抬头挺胸，上场吧。",
      "source_fingerprint": "1c1a3a21b9c1b3dd278436bb3ee2e6e0f8ceae566714bbf90920957dd9eb2f71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "2030"
      ]
    },
    {
      "uid": "zhcn:3ddb410524815fc79b8a2af1",
      "kind": "character_system_text",
      "source_text": "完成自己的职责吧。",
      "source_fingerprint": "42d7f04e28c610ea6ae569b6911a33ac64b34a6e1c43c6e677bab6a02b249a5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "2031"
      ]
    },
    {
      "uid": "zhcn:4e61c671ea007050653a5059",
      "kind": "character_system_text",
      "source_text": "感谢这段缘分。",
      "source_fingerprint": "13b97518e433937890fba002e879338ceb6d40e66cf3dc4b3517569607cb4bec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "2032"
      ]
    },
    {
      "uid": "zhcn:9955f119bc3d148f77eda7c2",
      "kind": "character_system_text",
      "source_text": "这一切都是为了我们华丽一族。\r\n母亲……我出发了。",
      "source_fingerprint": "0cf23d3b509b33f43e78f9de5217421f47968d9b03e909b2c6270d67826ef588",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "2033"
      ]
    },
    {
      "uid": "zhcn:0ddfadeb38a76e6114c71d59",
      "kind": "character_system_text",
      "source_text": "目标只有一个──绚烂的胜利。\r\n我会赢得与家族相衬的殊荣。",
      "source_fingerprint": "5538e6fb09556d608bd629662a09aa1d1e3ad4ac68327c569d26e512523e9086",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "2034"
      ]
    },
    {
      "uid": "zhcn:d4d80dbcf6e67137026d1990",
      "kind": "character_system_text",
      "source_text": "感谢这段缘分。",
      "source_fingerprint": "13b97518e433937890fba002e879338ceb6d40e66cf3dc4b3517569607cb4bec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "2035"
      ]
    },
    {
      "uid": "zhcn:002911bdff22ade2b062180b",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b59cda3dc4290a88197d0173",
      "kind": "character_system_text",
      "source_text": "下次绝对只能获胜……！",
      "source_fingerprint": "9cfbb002d99b9242d7b3231bd1c8db7f491a93d7c9de199f91c4523494ab72be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30000"
      ]
    },
    {
      "uid": "zhcn:7287d17800d44f9e8f57af3e",
      "kind": "character_system_text",
      "source_text": "还不够，还远远不够……！",
      "source_fingerprint": "6ee9a88a1c99f3e36b00591f363450a594f8e1e8e61b9356f76268f29b18951c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30001"
      ]
    },
    {
      "uid": "zhcn:4f3094a2103004102ebca65e",
      "kind": "character_system_text",
      "source_text": "至少，要抬头挺胸……",
      "source_fingerprint": "c3c739315da04d1f889ea3d6409e5656ff98ed52cbcb37fb3158f1a5ec228525",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30002"
      ]
    },
    {
      "uid": "zhcn:ea5cf15eb6f915e8573b4ec7",
      "kind": "character_system_text",
      "source_text": "……我，做了什么……",
      "source_fingerprint": "54804eb73bcf183b8a75425724f3633f4c416581a30ca3849d5a7bac534d3b20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30003"
      ]
    },
    {
      "uid": "zhcn:812f03a37572bfebd8498020",
      "kind": "character_system_text",
      "source_text": "呼……累积更多荣耀，\r\n迈向理应抵达的完美。",
      "source_fingerprint": "23c66a11c5de069ca67e8848fc4010944ff9a6ac6576ea9c6467d6d989157d71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30004"
      ]
    },
    {
      "uid": "zhcn:b21c044ef2c2a486b114796d",
      "kind": "character_system_text",
      "source_text": "目标只有至高无上的胜利。\r\n这是职责。",
      "source_fingerprint": "5caf7bf14c2083da1c52280a3bbca05c529927c27e8e9816266f0ebc25f4faa9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30005"
      ]
    },
    {
      "uid": "zhcn:8c1522b11d197d9ebcf361bf",
      "kind": "character_system_text",
      "source_text": "……护送的准备，做好了吗？",
      "source_fingerprint": "906b1a1c37a5d87ab20a87e697a6630b89fba69ff1f2b426745b2257f54feca4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30006"
      ]
    },
    {
      "uid": "zhcn:6da4be7347caa1a467ee9b2a",
      "kind": "character_system_text",
      "source_text": "目标唯有至高的胜利。这是我的职责。",
      "source_fingerprint": "5712789172096d7c653938b10712891549febc5ca8c0ee746d74426adea0ab7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "30007"
      ]
    },
    {
      "uid": "zhcn:ca6ae29e6b8a13fbff9be481",
      "kind": "character_system_text",
      "source_text": "跑出最华丽的比赛。",
      "source_fingerprint": "5ab22b493e4825ed30ccb46dd34c31b08e2ed117e188c4284533a2fce1b97ebf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "31000"
      ]
    },
    {
      "uid": "zhcn:274ada8e67dbbb0634cc3af0",
      "kind": "character_system_text",
      "source_text": "现在正是绽放至高光芒之时……！",
      "source_fingerprint": "ab87e81ca2fed15d0a2df5b48f604a607f79b41cf67c358f6b447ee3d0954467",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "40000"
      ]
    },
    {
      "uid": "zhcn:93827fe0ca38b95c89851dde",
      "kind": "character_system_text",
      "source_text": "华丽的母亲的舞蹈。仿佛将整个场\n域的空气都变得清澈美丽……\n――这是我，所憧憬的。",
      "source_fingerprint": "56c45b426f5d28d91e4c64e900138082ed834eaaa02aeaed53102a3232bcf0cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "400003"
      ]
    },
    {
      "uid": "zhcn:67a5fdb7a3ced2354ece5941",
      "kind": "character_system_text",
      "source_text": "「保持华丽。保持至高。\r\n时时刻刻绽放最耀眼的光芒」……\r\n意思是要亲手夺得鲜明的胜利！",
      "source_fingerprint": "1690335201d73f3ddef96659b892efabfdfa965924b5347f3d7278d6721b5d39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "40001"
      ]
    },
    {
      "uid": "zhcn:8c106dd9f3f08c76c674ff8d",
      "kind": "character_system_text",
      "source_text": "我们完成了应做之事。  \n所获得的东西弥足珍贵。  \n……对每个人而言，一定都是如此。",
      "source_fingerprint": "028112914fabfd3962bf3a21c3a846093c2e1a49be63f69c57b52fba9db85bf8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "400010"
      ]
    },
    {
      "uid": "zhcn:8160f3671d6a7f5ec0ce46a4",
      "kind": "character_system_text",
      "source_text": "让我的热情将你染红……",
      "source_fingerprint": "158009dcd34236adc027d597c456bd0cc782064e1258f8bc1dbccea440b33bbf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "40003"
      ]
    },
    {
      "uid": "zhcn:ae632390b1fc59f7927643a0",
      "kind": "character_system_text",
      "source_text": "深沉、炽热、鲜明……  \n让我们用蔚蓝的火焰，为一切染上色彩。",
      "source_fingerprint": "441a431b355ebd9b4c6cc371770ebc7d7e221505b93185576dc66e78d94cf0f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "40004"
      ]
    },
    {
      "uid": "zhcn:47a5a07dfa8c4a90c4677f6d",
      "kind": "character_system_text",
      "source_text": "我会华丽且优雅地，\r\n回应观众的声援。",
      "source_fingerprint": "f8091ea8743b973a588210b0a0b1941ebec0ed2856bbbb6a125ddb950ead5441",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "60000"
      ]
    },
    {
      "uid": "zhcn:2afb3eaacbf8aaa37ba68d84",
      "kind": "character_system_text",
      "source_text": "即使并非身在赛场，\r\n我也理所当然做好了万全准备。",
      "source_fingerprint": "8aa2c495fe99d2cd603f86ef3212bdfb445b29b70a09a5d6b9d838e7a60a8369",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "60001"
      ]
    },
    {
      "uid": "zhcn:ac4bdba25885343513f0e643",
      "kind": "character_system_text",
      "source_text": "我只追求最闪耀的光辉。",
      "source_fingerprint": "60003f3550a68a82e1ebaac5ea086c15623eef6da1857e7575564e8b87ebf431",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70000"
      ]
    },
    {
      "uid": "zhcn:41a2df8f47184210e2deee57",
      "kind": "character_system_text",
      "source_text": "选拔测验的内容\r\n当然都有背后的意义。\r\n而选拔理由也一样。",
      "source_fingerprint": "b3699536852d2abfc7f171e949287fe3fc11b3d73e8b5c28cf2d3600168a8b12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70001"
      ]
    },
    {
      "uid": "zhcn:65ffe5a70decd1dff3861563",
      "kind": "character_system_text",
      "source_text": "表现出品格的设计……\r\n真不愧是名门特雷森学园。",
      "source_fingerprint": "a18d66765bacdcd4d297538909f57fa1ce735edb07a34d11fadb6b3258d22f1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70004"
      ]
    },
    {
      "uid": "zhcn:0aceccb156e1e7e75727582f",
      "kind": "character_system_text",
      "source_text": "这构造跟设计……让我感受到\r\n设计者为使身着之人能够更加\r\n华丽起舞的那份矜持。",
      "source_fingerprint": "06a27a1f7a5e9f8e22291706dabff59dbe6f43a2eef94ee9bf75b06863e543c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70008"
      ]
    },
    {
      "uid": "zhcn:257abf76c4472220ead7eb22",
      "kind": "character_system_text",
      "source_text": "视线向前，抬头挺胸。\r\n只要保持应有的姿态向前走就好。",
      "source_fingerprint": "fcc70afa49793d695e647a1d825ee0b4c51c8fbd1f085777f510c642e0838fa7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70009"
      ]
    },
    {
      "uid": "zhcn:ad8feb69c7908f8b2a57099e",
      "kind": "character_system_text",
      "source_text": "怎么了吗？\r\n……这身穿着有什么问题吗？",
      "source_fingerprint": "2c370a02a5d3f037ac18184b44ffbc76ca3f373713f9f78eea45a314379f1318",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70010"
      ]
    },
    {
      "uid": "zhcn:84743c8b913a5d34612f6cf6",
      "kind": "character_system_text",
      "source_text": "即使没预想到会有这样的机会，\r\n我也当然会记住所有的舞步。",
      "source_fingerprint": "6e2c66888c195121eafddbe6816d78fa5c35a0df132d8cf262ad15c01ab9c2a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70014"
      ]
    },
    {
      "uid": "zhcn:9e9d79da29fb49295677c59f",
      "kind": "character_system_text",
      "source_text": "为了时时追求「胜利」，\r\n我请人用红宝石加以点缀。",
      "source_fingerprint": "80058c4a3628584ae635f0196a49bbd428e91df75f5dc5beb797d0b9a3ae364f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70015"
      ]
    },
    {
      "uid": "zhcn:574bfcae1130bab7dbd6b859",
      "kind": "character_system_text",
      "source_text": "我认为热情是各自拥有不同色彩的东西。",
      "source_fingerprint": "5a4caf58013e45a43d1f82bd5604da809d738ecedd660f3b3cceffbd07c77bab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70016"
      ]
    },
    {
      "uid": "zhcn:86687f10a10e8944d890ff31",
      "kind": "character_system_text",
      "source_text": "作为一族的代表，于此立下坚定不移的决心……",
      "source_fingerprint": "1d0dc3f15935622389e59f3cecf12ce065eacd7e805d1649699672f3e7f084dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70017"
      ]
    },
    {
      "uid": "zhcn:d82e5ccf387d5842b170fd0b",
      "kind": "character_system_text",
      "source_text": "我换好服装了。",
      "source_fingerprint": "8de7d97207b2f687fe7d274f01d7b01b6d82c0563fc63db928f60ec5e31b6386",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70018"
      ]
    },
    {
      "uid": "zhcn:6e2782a3324be8c656fa833c",
      "kind": "character_system_text",
      "source_text": "这套服装有什么问题？",
      "source_fingerprint": "126e43141b904edb2376d5b7845893b1bb8cf92287ff51ab9ee00921fb303d54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70019"
      ]
    },
    {
      "uid": "zhcn:0d8cedb9ccc763d7bd70c057",
      "kind": "character_system_text",
      "source_text": "即便是私下的时间，  \n所背负之物也不会改变。",
      "source_fingerprint": "d185b0258afadc3c4cd4411774c849ab6e6fc842d4e93d461ce644983ef90a8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70020"
      ]
    },
    {
      "uid": "zhcn:465ceeb76df11a871944afd6",
      "kind": "character_system_text",
      "source_text": "不过于朴素也不过分华丽……  \n应该是适合各种场合的装扮吧。",
      "source_fingerprint": "36c467783cbdc2387c63539c6f3eae1c4fff973e7658de35381334579637e52b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "70021"
      ]
    },
    {
      "uid": "zhcn:4f049dc3f60fe172daa1b4b6",
      "kind": "character_system_text",
      "source_text": "表现出品格的设计……\r\n真不愧是名门特雷森学园。",
      "source_fingerprint": "a18d66765bacdcd4d297538909f57fa1ce735edb07a34d11fadb6b3258d22f1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71004"
      ]
    },
    {
      "uid": "zhcn:cac26788669d81f59108f022",
      "kind": "character_system_text",
      "source_text": "这构造跟设计……让我感受到\r\n设计者为使身着之人能够更加\r\n华丽起舞的那份矜持。",
      "source_fingerprint": "06a27a1f7a5e9f8e22291706dabff59dbe6f43a2eef94ee9bf75b06863e543c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71008"
      ]
    },
    {
      "uid": "zhcn:6adfd0df9d11a706525abc3f",
      "kind": "character_system_text",
      "source_text": "视线向前，抬头挺胸。\r\n只要保持应有的姿态向前走就好。",
      "source_fingerprint": "fcc70afa49793d695e647a1d825ee0b4c51c8fbd1f085777f510c642e0838fa7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71009"
      ]
    },
    {
      "uid": "zhcn:441998082f50ea709d3dad0a",
      "kind": "character_system_text",
      "source_text": "怎么了吗？\r\n……这身穿着有什么问题吗？",
      "source_fingerprint": "2c370a02a5d3f037ac18184b44ffbc76ca3f373713f9f78eea45a314379f1318",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71010"
      ]
    },
    {
      "uid": "zhcn:ef28a197ce16742ab74ed8e0",
      "kind": "character_system_text",
      "source_text": "即使没预想到会有这样的机会，\r\n我也当然会记住所有的舞步。",
      "source_fingerprint": "6e2c66888c195121eafddbe6816d78fa5c35a0df132d8cf262ad15c01ab9c2a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71014"
      ]
    },
    {
      "uid": "zhcn:6a130e7a803d1986079541a4",
      "kind": "character_system_text",
      "source_text": "为了时时追求「胜利」，\r\n我请人用红宝石加以点缀。",
      "source_fingerprint": "80058c4a3628584ae635f0196a49bbd428e91df75f5dc5beb797d0b9a3ae364f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71015"
      ]
    },
    {
      "uid": "zhcn:787546c98928a3c419de73a5",
      "kind": "character_system_text",
      "source_text": "情熱とは、それぞれの色を持つものと存じます。",
      "source_fingerprint": "b9f06129f3246f0cb6d34e54ca1657ea6187850c99fa541de67b011f39b0fdb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71016"
      ]
    },
    {
      "uid": "zhcn:bfa6d46eaa811a96eb5df61a",
      "kind": "character_system_text",
      "source_text": "作为一族的代表，于此立下坚定不移的决心……",
      "source_fingerprint": "1d0dc3f15935622389e59f3cecf12ce065eacd7e805d1649699672f3e7f084dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71017"
      ]
    },
    {
      "uid": "zhcn:3294750980e86b4fd95c4e8b",
      "kind": "character_system_text",
      "source_text": "我换好服装了。",
      "source_fingerprint": "8de7d97207b2f687fe7d274f01d7b01b6d82c0563fc63db928f60ec5e31b6386",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71018"
      ]
    },
    {
      "uid": "zhcn:8c3055ea5922fba74f4bf2a7",
      "kind": "character_system_text",
      "source_text": "这套服装有什么问题？",
      "source_fingerprint": "126e43141b904edb2376d5b7845893b1bb8cf92287ff51ab9ee00921fb303d54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "71019"
      ]
    },
    {
      "uid": "zhcn:f91417ff941ce9de6edfe12a",
      "kind": "character_system_text",
      "source_text": "辛苦了。",
      "source_fingerprint": "2f747fdfd41fdd19d5e6205e2563472ecb3e45190ea9201c283e895272ee13e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "80000"
      ]
    },
    {
      "uid": "zhcn:9a129a3d14e78f675cd247ce",
      "kind": "character_system_text",
      "source_text": "无论您是谁，我的职责都不会改变。",
      "source_fingerprint": "5c8f1b7ebf697183b1ea3a825b16472f3c2c634eaf3587ab8caed53063ec2d8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "81000"
      ]
    },
    {
      "uid": "zhcn:95ccbe6fdab986a92e79aaf4",
      "kind": "character_system_text",
      "source_text": "我不会退让的。\n因为失败是不需要的。",
      "source_fingerprint": "db7535fb232fe1cd0e1bf2e2c6aa2448897d082b22a2495bd933a3f3710fe8eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "81001"
      ]
    },
    {
      "uid": "zhcn:f86b2103874844856684614e",
      "kind": "character_system_text",
      "source_text": "小时候起，为了送忙碌的双亲出门，\r\n我便会配合他们的时间起床。\r\n就算到了今天，我也不需要闹钟。",
      "source_fingerprint": "8732603554b0f54ded7922e2cd67bd4f82d2006560617ec395ceb1b08e4c0f66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90000"
      ]
    },
    {
      "uid": "zhcn:9311f06fe233577462e50529",
      "kind": "character_system_text",
      "source_text": "你看过今天早上的报纸了吗？\r\n上面登了我们家族的报导，\r\n还请你务必一读。",
      "source_fingerprint": "e96af3b0eea52d61e827d2ca98ef53af16c8a332af39f517997228fe3fd9bde5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90001"
      ]
    },
    {
      "uid": "zhcn:d1fe4b1b00abf395306f833e",
      "kind": "character_system_text",
      "source_text": "我午餐要一个人吃。\r\n如果没有事情要讨论的话，\r\n就不需要坐在一起。",
      "source_fingerprint": "66d6baa3f2cc752c9c87128ac2f7bb9f442274e707882403b337602b5991a564",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90002"
      ]
    },
    {
      "uid": "zhcn:aa5655cd8843827eab730c79",
      "kind": "character_system_text",
      "source_text": "休息时间吗？因为我有在上\r\n家庭教师的在线课程，\r\n因此会用来完成外语的作业。",
      "source_fingerprint": "f04c7019705a48105df4127d4ce788fad890769d9f7fae4a34c06d07aad44baa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90003"
      ]
    },
    {
      "uid": "zhcn:a70c795bf8981efa2ca9e545",
      "kind": "character_system_text",
      "source_text": "关于明天的行程，\r\n由于餐会的时间有所变更，\r\n再麻烦帮我安排追加练习。",
      "source_fingerprint": "c3642b6298cba005f56d178666dcf24c3d7cacd2f3d1521ab34aba6b174eed68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90004"
      ]
    },
    {
      "uid": "zhcn:c16972375e8ffc48bba23e9d",
      "kind": "character_system_text",
      "source_text": "睡眠不足会影响判断力。\r\n睡不着的时候，请采取\r\n喝花草茶等助眠方法。",
      "source_fingerprint": "2336b355ddb80b51c9be23bf1c45d1f55825f403fb88d787c81feddaa5c910ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90005"
      ]
    },
    {
      "uid": "zhcn:b8afdd204d08ad1143370625",
      "kind": "character_system_text",
      "source_text": "我春天会见到形形色色的人。\r\n让我留下印象的人，\r\n果然多半都成为了组织的核心。",
      "source_fingerprint": "ae1afe3c28ae32442a5b5fd3945e1512634185d91cfe48480ab36db4e78f8f21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90006"
      ]
    },
    {
      "uid": "zhcn:2c2603db1347e84923c6ff10",
      "kind": "character_system_text",
      "source_text": "爱用的阳伞是母亲送我的。\r\n就算在艳阳高照的日子里，\r\n也能够避免出糗，非常方便。",
      "source_fingerprint": "8ea7ac096a57989fac434287e5d8f274a7434403c0d600b45861cf2218459c10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90007"
      ]
    },
    {
      "uid": "zhcn:fe9d7da358ebace69ddbd084",
      "kind": "character_system_text",
      "source_text": "学园的藏书虽然齐全，\r\n但我家的图书室更是万全。\r\n秋天时我常常沉浸在里面。",
      "source_fingerprint": "b31a79b710123f36f2c524e6cb2d18305095b8633fd0e203d5651f9c356cf0bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90008"
      ]
    },
    {
      "uid": "zhcn:53018dffda80e394726ad29c",
      "kind": "character_system_text",
      "source_text": "「我的理想工作是即使在寒冬之中，\r\n也能让大家面带笑容迎接新的一年」\r\n……父亲常常这么说。",
      "source_fingerprint": "c67531d85c9b589d9a4c7054235e5c1daab2921a04213f4a2d9b84d1e0778ab0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90009"
      ]
    },
    {
      "uid": "zhcn:a34cd6bfed7a1388e5b2579a",
      "kind": "character_system_text",
      "source_text": "早上好。\n今天也一如既往，\n打算履行家族的职责。",
      "source_fingerprint": "656bbf4d1c003bb55eaeb4b6c99b8df62320ee9e98f04a573bf0417df3ac14e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90010"
      ]
    },
    {
      "uid": "zhcn:9ee928d4fa70cff3cbbf01fd",
      "kind": "character_system_text",
      "source_text": "从管家那里收到下个月的日程表了吗？\n确认后，请尽快安排训练计划。",
      "source_fingerprint": "c82b7e259322db0f3075dd5bf950ea4b0c1802378eb9d53f89070e21ddce06c0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90011"
      ]
    },
    {
      "uid": "zhcn:1fd9255b298cc75a089812e4",
      "kind": "character_system_text",
      "source_text": "休息时间也是宝贵的学习机会。 \n跳一些轻松的舞蹈的话， 即使是在饭\n后也不会感到负担。",
      "source_fingerprint": "88237949139403f10a8ba145d827a38eacbf6c0a791b031a9aafe1c3437fd2e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90012"
      ]
    },
    {
      "uid": "zhcn:cb4732a3035f4929e526971f",
      "kind": "character_system_text",
      "source_text": "营养学我已经学过了。\n因此，学园中的饮食菜单，\n由我亲自管理。",
      "source_fingerprint": "91b3a252f082c38f82d9487a81edcd80d908d3afa661f0dfd01e47704b08cba7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90013"
      ]
    },
    {
      "uid": "zhcn:3bbc59a1d13df6d8c9a2a387",
      "kind": "character_system_text",
      "source_text": "夜晚的寂静是适合集中精神的环境。  \n让我们为明天做好准备吧。",
      "source_fingerprint": "c6fbe9cd829ce6ba3814e3e24d704d2b6eca3cb04c37e877170dfd550ae98dc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90014"
      ]
    },
    {
      "uid": "zhcn:516f91b8c7a927c39414c35a",
      "kind": "character_system_text",
      "source_text": "深蓝色的夜空……\n那些星辰的热度，终有一日\n会传达到地面上吗？",
      "source_fingerprint": "afaec790338a537471a8f870b2694e043263b5c8922ca39f96d2da5e79132369",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90015"
      ]
    },
    {
      "uid": "zhcn:25a95f29e5b18df1403026ec",
      "kind": "character_system_text",
      "source_text": "有人把春天视为焕然一新的季节，\n但在我心中，并没有什么可以改变。",
      "source_fingerprint": "aee915434a2650a53e874c9e9a6fc32e2f155c4722e9d34703056ec10c3b9978",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90016"
      ]
    },
    {
      "uid": "zhcn:77f5c07ca4e4da861df47aef",
      "kind": "character_system_text",
      "source_text": "红宝石有时也被称为太阳之石。\n……那么理所当然地，名字相配的灿烂光辉。",
      "source_fingerprint": "ba70ff4c8b2ec4f0fdf965300dc5a4379d309222f8b9d585f1d6ed86d6166c1e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90017"
      ]
    },
    {
      "uid": "zhcn:b6c6f3baeec0079c46f965fc",
      "kind": "character_system_text",
      "source_text": "枯叶发出的声音像一首曲子一样，\n对于这种想法，奇迹小姐…却从未这样想过。",
      "source_fingerprint": "665a9898d5dca855ee2693558a1a246fd69076489ca4facefda3c2473ff97ea1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90018"
      ]
    },
    {
      "uid": "zhcn:8da54f7dcb14ece0e38a6d5b",
      "kind": "character_system_text",
      "source_text": "青色乍看之下令人联想到冰冷的空气…\n然而，在其中隐藏的热度\n是绝对不会熄灭的火焰。",
      "source_fingerprint": "b7e840d1cddefb4828aa6e01363fd2414266d8fc5cd4c6ebe3d7df33bbb88285",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1085",
        "90019"
      ]
    }
  ]
}
