      ]
    },
    {
      "uid": "zhcn:6fbe9a71906bcb5c04bf87d2",
      "kind": "character_system_text",
      "source_text": "赢给你看！",
      "source_fingerprint": "14c574a9367b75f23f1cc25a265f9ff7951a2bab238c0f41c73d33cc7496abc4",
      "source_path": "character_system_text_dict.json",
