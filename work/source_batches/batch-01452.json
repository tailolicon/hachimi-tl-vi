    {
      "uid": "zhcn:d6d20a4153262f8420258ae8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我的叫醒服务怎么样？\n用小铜锣铛地一声！……这种♪\n姐姐也评价说一发就能叫醒哦！",
      "source_fingerprint": "94915a3ab371f4b040ed5c46a4d5193fc6a3d8259f24389317e43c76a1a03060",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
