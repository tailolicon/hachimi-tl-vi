    },
    {
      "uid": "zhcn:592c77faecf974fccc25830f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "现在正是关键时刻哦。\n有没有人想喝作为努力奖赏的\n高级热带饮料！？",
      "source_fingerprint": "93194876b392b4f72aaaa44bad4871e4269a82524980630bcff202f1795361f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
