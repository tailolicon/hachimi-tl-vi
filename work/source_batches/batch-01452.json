    {
      "uid": "zhcn:44f1362e024f9974a60ff6f7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "小测验里出了没修读过的内容，\n但对我来说并无大碍。\n靠基础的应用与预习就能完美回答！",
      "source_fingerprint": "b7535cec06fb13a0369b07c21bce1934ceb3a716829f0800f827f9602300bead",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
