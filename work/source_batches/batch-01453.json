      ]
    },
    {
      "uid": "zhcn:1b88042f212416e97a7388c4",
      "kind": "character_system_text",
      "source_text": "明日はこちらですわ。",
      "source_fingerprint": "2b409361245c35c1a0f8acfaff3a6d8c3aa90831938b8e368f36bb342d2ac9e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "15"
      ]
    },
    {
      "uid": "zhcn:4e68f78b41a349d24a36c363",
      "kind": "character_system_text",
      "source_text": "…トレーナーとしての、\r\n賢明な判断を期待しますわ。",
      "source_fingerprint": "29921b734fe1d8cf2d6bd156450d6b0a08832dacfb391989c7671f6327bc2f99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20000"
      ]
    },
    {
      "uid": "zhcn:2c66fc5b3cef2c1609995584",
      "kind": "character_system_text",
      "source_text": "…疲れてるの。\r\nご覧の通り。",
      "source_fingerprint": "73975ed905aab0b9e79d0d08154f1b6aacbd2c4064e4626abd8f2bb675bce574",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20001"
      ]
    },
    {
      "uid": "zhcn:80bb65e8cbcf1e310328e877",
      "kind": "character_system_text",
      "source_text": "ふふっ…。\r\n今よりも強くなれるのが、\r\nとっても楽しみ。",
      "source_fingerprint": "4a0965da68d855e3fd9bf40913701292bd772f25eb321212244ab0fd3bcdbaec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20002"
      ]
    },
    {
      "uid": "zhcn:bda486121982a9ad9e3d99e8",
      "kind": "character_system_text",
      "source_text": "くす、いいわよ…\r\n見つめていても。",
      "source_fingerprint": "527650f88cc83a9820145714413ee318c0c760c8913c95df51d41ef05b6b411a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20003"
      ]
    },
    {
      "uid": "zhcn:0b5cce783073a93dc0ab02b8",
      "kind": "character_system_text",
      "source_text": "いい天気ね。\r\n走るにはうってつけ。",
      "source_fingerprint": "c865522536cf64336aaa0bc82c63b70267095e27dfd793f753f064ef7506bc8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
        "20004"
      ]
    },
    {
      "uid": "zhcn:5eb64133c4feb96828d2b69b",
      "kind": "character_system_text",
      "source_text": "コースがいいけれど…\r\n貴方のご意見は。",
      "source_fingerprint": "405261ccfc914a3d03717f147c02531e1e525fadb482956c632a3be90deaa2f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
