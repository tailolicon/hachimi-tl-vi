      "kind": "character_system_text",
      "source_text": "どうかなさって？",
      "source_fingerprint": "fa629d852f8c9108e447c58f83fd007cf481fce2033896b68435722ae9a8eb61",
      "source_path": "character_system_text_dict.json",
