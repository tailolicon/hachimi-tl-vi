      "kind": "character_system_text",
      "source_text": "レースに捧げる、愛のデザインよ。",
      "source_fingerprint": "0062be63c1a6427800dc67c490c0170e0f999b9bd5b42843a3219fed352ab19c",
      "source_path": "character_system_text_dict.json",
