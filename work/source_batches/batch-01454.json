      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1089",
        "20009"
      ]
    },
    {
      "uid": "zhcn:4e363e7ea31616b0c1db51e0",
      "kind": "character_system_text",
      "source_text": "不管做什么…感觉都没有成效。\r\n…果然是因为我不行吗。",
      "source_fingerprint": "933aa3f4521efba9391163547c8ea43b52e257ef36cec1ba65803d461846c80a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1089",
        "20010"
      ]
    },
