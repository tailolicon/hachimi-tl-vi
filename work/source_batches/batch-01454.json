      ]
    },
    {
      "uid": "zhcn:66361da64dfa8055026a1894",
      "kind": "character_system_text",
      "source_text": "体のラインがよく見えるところ、\r\n好きよ。",
      "source_fingerprint": "dc43ec178ac38759fd824df2f5ea2fb7e1f217464eba7f2b67273037d300e7ac",
      "source_path": "character_system_text_dict.json",
