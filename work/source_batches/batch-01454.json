      "kind": "character_system_text",
      "source_text": "華やかね。",
      "source_fingerprint": "30402706e7544a1a0e839a9f048fbdcd36c2dc5eb13b4aa376a07bfeb4ede031",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1086",
