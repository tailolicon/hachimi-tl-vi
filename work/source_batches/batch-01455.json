      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1087",
        "110000"
      ]
    },
    {
      "uid": "zhcn:006cf558d44506ce029f2e8a",
      "kind": "character_system_text",
      "source_text": "在这间学园的历史中，\r\n小真目前算是什么等级的存在呢？",
      "source_fingerprint": "652e546f3f29451089fb9e4d22f9aa721b2854ded8bc24b3b82483a657971d68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
