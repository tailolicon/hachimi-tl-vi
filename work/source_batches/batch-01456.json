      ]
    },
    {
      "uid": "zhcn:9b0f07c385547f1171d41370",
      "kind": "character_system_text",
      "source_text": "原来如此～",
      "source_fingerprint": "12fc792c46a351f3173f3389961bf9ab5ffafa74b7f326e6b3b42fc6ac08af03",
      "source_path": "character_system_text_dict.json",
