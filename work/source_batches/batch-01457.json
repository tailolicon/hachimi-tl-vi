      ]
    },
    {
      "uid": "zhcn:bd6bce4c88adcaebd1f450e6",
      "kind": "character_system_text",
      "source_text": "好像还有奖励呢！\n是什么呢？是甜点吗～？\n我们快点去拿吧☆",
