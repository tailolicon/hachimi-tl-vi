      ]
    },
    {
      "uid": "zhcn:7edf75c8244c5ae846d0f594",
      "kind": "character_system_text",
      "source_text": "どしたん？",
      "source_fingerprint": "bef8ecfc4d5e5e785735981f64e2754867f0913f7c59d01ee31e2c11949b8cfd",
      "source_path": "character_system_text_dict.json",
