      ]
    },
    {
      "uid": "zhcn:d0ad4cc59ac312b7777a9dd1",
      "kind": "character_system_text",
      "source_text": "真不错呢♪",
      "source_fingerprint": "7a11803102be6a33859f532c32997a9e2c166850c857cc68d35f67105b65f70f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1088",
        "20047"
      ]
    },
    {
      "uid": "zhcn:5895b149492c66255ed15f4d",
      "kind": "character_system_text",
      "source_text": "多谢！真是获得了宝贵的经验！",
      "source_fingerprint": "b62af1e5b7d6ab3c65dccc1c5bd9d41c0c95ea5aaeb96921550b48c536e10190",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1088",
        "20049"
      ]
    },
    {
      "uid": "zhcn:a4f3bd2a54afc8f59e738693",
      "kind": "character_system_text",
      "source_text": "谢谢你一直陪我走下去。",
      "source_fingerprint": "c649459b2f5deb4156afcdcdfca871a53e06f58516aeedb834db5cf84b19a50a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1088",
        "20050"
      ]
    },
    {
      "uid": "zhcn:6fbe9a71906bcb5c04bf87d2",
      "kind": "character_system_text",
      "source_text": "赢给你看！",
      "source_fingerprint": "14c574a9367b75f23f1cc25a265f9ff7951a2bab238c0f41c73d33cc7496abc4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1088",
        "2030"
      ]
    },
    {
      "uid": "zhcn:009d6a03856599a3f22b4568",
      "kind": "character_system_text",
      "source_text": "挑战的时刻到了！",
      "source_fingerprint": "7ad661d1395b6023d9923bf77991e25ce020b9f88ae41d60c59a4c8e77ae9ab1",
      "source_path": "character_system_text_dict.json",
