    {
      "uid": "zhcn:c1c915b21ef0a2a393d15f24",
      "kind": "character_system_text",
      "source_text": "下次一定要赢回来！",
      "source_fingerprint": "12c863cf6258ed34e9cf09f61a23b73e430b5e8975dc8230ef701c5ebadc3372",
      "source_path": "character_system_text_dict.json",
