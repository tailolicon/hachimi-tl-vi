    },
    {
      "uid": "zhcn:b1e29173889d0bc28b7e449d",
      "kind": "character_system_text",
      "source_text": "スコア、更新です…！",
      "source_fingerprint": "2e9fc3e1b8f9076af603aa06f8c93abcabe70823dbdbeeb933f5cfeeb30aa0b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "1007"
      ]
    },
    {
      "uid": "zhcn:d5c31e80c96e971f1438c316",
      "kind": "character_system_text",
      "source_text": "うん…みんな、行こう！",
      "source_fingerprint": "78df9570d08420c31c154d2d85189a60480667cba1ce695d610d9a843328d7ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "1008"
      ]
    },
    {
      "uid": "zhcn:1762af895c885bd1b555c08f",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "11"
      ]
    },
    {
      "uid": "zhcn:43eedbd5672774f8a482dae9",
      "kind": "character_system_text",
      "source_text": "トレーニングですか？\r\nなら、先に行って\r\n準備、しておきます！",
      "source_fingerprint": "58b457de77712d979f4f9308407a7ae8e6bf279710351c7dbd1c7be262f2be87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "110000"
      ]
    },
    {
      "uid": "zhcn:de67507b49e580a1b2f6b897",
      "kind": "character_system_text",
      "source_text": "人の数だけ、\r\n“奇跡”があるんですよね…。",
      "source_fingerprint": "7df0f61eb86e61d06b4ce45f9b39d6782c70b0086d67b87a65f59946db63f949",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "110001"
      ]
    },
    {
      "uid": "zhcn:5628920eae6ea8901ee86fbf",
      "kind": "character_system_text",
      "source_text": "はい、レースですね。\r\nこれまでの成果、\r\nしっかり出し切ります！",
      "source_fingerprint": "887eeecc281cbcd88d2e97415a6d17d10c56b644be5b572e3a12e7e469d06410",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "110002"
      ]
    },
    {
      "uid": "zhcn:7522012756bf63b84c7b8ce8",
      "kind": "character_system_text",
      "source_text": "“奇跡”を…！",
      "source_fingerprint": "228172222763c93b74da865198c81b27922146e752059ebca4ddb638dc5e49e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "1152"
      ]
    },
    {
      "uid": "zhcn:f289076090d375f0372c7c8c",
      "kind": "character_system_text",
      "source_text": "うん、行こう。",
      "source_fingerprint": "acc14356402f48baf5b256fae462b62fa0a909c6704731e84e1122806b212d71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "1161"
      ]
    },
    {
      "uid": "zhcn:f145da3b23d5060e76ff5f43",
      "kind": "character_system_text",
      "source_text": "準備はいい？",
      "source_fingerprint": "cd9bc9a524196cf8b23494f65a37ff0c18fa5b7bbb1e976cb1666e1b53d3ef69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "1179"
      ]
    },
    {
      "uid": "zhcn:e654fd72a7b5bd56cd8964cf",
      "kind": "character_system_text",
      "source_text": "ミラクル？",
      "source_fingerprint": "c422957d459d2fa97790dba95fd3c15cd2d877324222a79aee88cb90b7a8c467",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "1180"
      ]
    },
    {
      "uid": "zhcn:bad5eb4a6fd78bbf52305071",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "12"
      ]
    },
    {
      "uid": "zhcn:442e032154e285d955e0b5dd",
      "kind": "character_system_text",
      "source_text": "みんなの奇跡を、ありがとう…！",
      "source_fingerprint": "b1391b55d2a51bf1128c32d90909bb5f7fbd075e68a0e4774618289e4109c260",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "120000"
      ]
    },
    {
      "uid": "zhcn:baa654293f523be1adb67c70",
      "kind": "character_system_text",
      "source_text": "今日のログインボーナスです。",
      "source_fingerprint": "3483bb35d224a76d9dbbad71fca8a2820b15d3b4aaff9adda0c36ac1bf88939b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "13"
      ]
    },
    {
      "uid": "zhcn:1d2863ae0f6550ebdea42b2a",
      "kind": "character_system_text",
      "source_text": "落ち着いていきましょう。",
      "source_fingerprint": "e2e1cf9509c8b1246ec0c1bf3e5f56a66c921bab5d7272b73cdf7a9261a343c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140000"
      ]
    },
    {
      "uid": "zhcn:2abd0f6c629dc87ab8d8afc1",
      "kind": "character_system_text",
      "source_text": "わ、やった！",
      "source_fingerprint": "4973c6bd18bf7d9380bf915a7354ef6e46bf07faaa097e5c816c0f72a0a66b4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140001"
      ]
    },
    {
      "uid": "zhcn:8b8d07955db636292787742c",
      "kind": "character_system_text",
      "source_text": "まだいけますよ！",
      "source_fingerprint": "7fbde87f486e4973a936adeafe52f8d48bab5f4bd759480967003f6cf5b74c0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140002"
      ]
    },
    {
      "uid": "zhcn:f17b7f86d96942b5571f2417",
      "kind": "character_system_text",
      "source_text": "すごい、たくさんですね！",
      "source_fingerprint": "aea10fa89f917e085b40d724b004734d9a88065a3ce8ce0657cf32c5c0173c57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140003"
      ]
    },
    {
      "uid": "zhcn:7f04b902126ba3fa34875db6",
      "kind": "character_system_text",
      "source_text": "上手なんですね…！",
      "source_fingerprint": "e435ffe575bb0beb40ee7038b1ac42fb841aa415f2ee8a56b1838db82294b177",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140004"
      ]
    },
    {
      "uid": "zhcn:5095948f060d6034f2bfd5d4",
      "kind": "character_system_text",
      "source_text": "きっと、次があります…！",
      "source_fingerprint": "b9d5802231864f8d6a4ddff46292b4a1ab562b77d6b5a89d2a47731e84304a61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140005"
      ]
    },
    {
      "uid": "zhcn:9cdb028a4b3f3238487f0407",
      "kind": "character_system_text",
      "source_text": "すごい、たくさんですね！",
      "source_fingerprint": "aea10fa89f917e085b40d724b004734d9a88065a3ce8ce0657cf32c5c0173c57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140006"
      ]
    },
    {
      "uid": "zhcn:b2e3bf999cc219677bd43f30",
      "kind": "character_system_text",
      "source_text": "上手なんですね…！",
      "source_fingerprint": "e435ffe575bb0beb40ee7038b1ac42fb841aa415f2ee8a56b1838db82294b177",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140007"
      ]
    },
    {
      "uid": "zhcn:e07221d75b92ac510637511e",
      "kind": "character_system_text",
      "source_text": "ふむ…。",
      "source_fingerprint": "7cc85de9baa6672c2c81baee59b07561bae8d6e1b887a3e92e1cd1b692282626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140008"
      ]
    },
    {
      "uid": "zhcn:2deffb6b7a65773f50921c03",
      "kind": "character_system_text",
      "source_text": "ふふっ。",
      "source_fingerprint": "dbc78ca5d65302a8b38bec657661270c58ae9fac943c1c718a7fa71c2d75ec30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140009"
      ]
    },
    {
      "uid": "zhcn:212b4f06148391468ccb551f",
      "kind": "character_system_text",
      "source_text": "はい！",
      "source_fingerprint": "c8437da922b05a66a006272ae646cc70f57e96453c9e5b620e3abbd8e90368f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140010"
      ]
    },
    {
      "uid": "zhcn:cabb8c5b7ec4a2a35add994f",
      "kind": "character_system_text",
      "source_text": "仲良しだ…！",
      "source_fingerprint": "ba3d142ef36124f29155782d5f0789f7ccd8a8a501d124bc68a9d73b50773194",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140011"
      ]
    },
    {
      "uid": "zhcn:0228409f1c54d2f835387fc4",
      "kind": "character_system_text",
      "source_text": "かわいいなぁ…。",
      "source_fingerprint": "6f2455b1d772b1d8202f8db07a78fea9bbbd8b4403e77575bae563ef98fd02ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140012"
      ]
    },
    {
      "uid": "zhcn:947c7785916ea6fa744bad96",
      "kind": "character_system_text",
      "source_text": "このまま一緒に…。",
      "source_fingerprint": "6602df280a3f6337fbec65e7ff4c6d7668ec56ed1fcda8857596d95d2e020124",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140013"
      ]
    },
    {
      "uid": "zhcn:51584b82fe439f99a66b8cb9",
      "kind": "character_system_text",
      "source_text": "残念…！",
      "source_fingerprint": "16763c6a14f4d81c3cc0be6de4b43a41c52af70b759e27a7e33f212241854707",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140014"
      ]
    },
    {
      "uid": "zhcn:18e573b2eef9c380d5f8bc3d",
      "kind": "character_system_text",
      "source_text": "ん…。",
      "source_fingerprint": "03e850be378bdf5a0209875ba59221208332eff2bb0ec0f59d887ef8fd12cfa5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140015"
      ]
    },
    {
      "uid": "zhcn:a33f80e54b83a842e4e60a5b",
      "kind": "character_system_text",
      "source_text": "考えるのも大事ですよね。",
      "source_fingerprint": "3019badf908fd71fa44547fbc3d08f576416f22b724c91ecadc2c288c98dabc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140016"
      ]
    },
    {
      "uid": "zhcn:a977c236ed9c7079108a064b",
      "kind": "character_system_text",
      "source_text": "あっ…。",
      "source_fingerprint": "3a21ce840bf9ddc986be8e888c7b451979daa2ab024ea08e5cc2c77b4a08b12e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140017"
      ]
    },
    {
      "uid": "zhcn:df07c55f2099d509ffd727b3",
      "kind": "character_system_text",
      "source_text": "頑張れっ…！",
      "source_fingerprint": "38afa3f1c7ae28c92c8780ae15201e2db6f2a2566644b33a9b45c5bf610e5a80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "140018"
      ]
    },
    {
      "uid": "zhcn:06a6c3d950afe847a99ca615",
      "kind": "character_system_text",
      "source_text": "明日は、\r\nこれを用意して待ってますね。",
      "source_fingerprint": "dffdfa78db29dfd3e69c03dea3c33b2c4db8836c4fd63f4b49e8a74cf4a45b44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "15"
      ]
    },
    {
      "uid": "zhcn:700726557184b080c6852956",
      "kind": "character_system_text",
      "source_text": "え、顔色…？悪いですか？\r\nそうかな…。",
      "source_fingerprint": "29222e98167ec2961f7521f6175b9adf0f6c0df0337a23126f965ff1981a002c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20000"
      ]
    },
    {
      "uid": "zhcn:dc26849f8ec50a9fb6a1e63b",
      "kind": "character_system_text",
      "source_text": "…どうしたんですか？\r\n大丈夫ですよ。おれ、やれます…\r\n元気、ですよ。",
      "source_fingerprint": "237029db348603baf04c384b29383f6eb8e618eec6caa1fe4ef07cc2dc6291a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20001"
      ]
    },
    {
      "uid": "zhcn:25a4432c589bbeaba782c492",
      "kind": "character_system_text",
      "source_text": "今日、いくらでも走れそうな\r\n気がするんです。トレーニング、\r\nもっと増やしてもいいですか？",
      "source_fingerprint": "7ab53a466d965e54475d8688c75a8289e3b1224a743e78de6ed121adda45843c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20002"
      ]
    },
    {
      "uid": "zhcn:b44abff479f488e4faacea2b",
      "kind": "character_system_text",
      "source_text": "あの！もう走ってもいいですか？\r\nなんだかうずうずして…今なら\r\n最高のスピードが出せそうです！",
      "source_fingerprint": "839c88ca2a58e4226765904ffd14b880d1c94eb0e5ec26fde4d6892592309e35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20003"
      ]
    },
    {
      "uid": "zhcn:61d244abe7fa5a3a9592c370",
      "kind": "character_system_text",
      "source_text": "うん、いい感じ…！\r\nおかげさまで、\r\n今日もめいっぱい走れます！",
      "source_fingerprint": "bf72599a2104d71828772735e59ff447683d9afd22922ff482ae9db392a251c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20004"
      ]
    },
    {
      "uid": "zhcn:c5720eda0b34bae5b2766ecb",
      "kind": "character_system_text",
      "source_text": "いつもより、脚がすいすい動く…\r\nふふ、まさに本調子です！",
      "source_fingerprint": "6ccefb66ba97dee0d1c138035b8f0406b1266bcbb17490da5f20ee4242074f74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20005"
      ]
    },
    {
      "uid": "zhcn:0693d187cfe0b8bd54f6567f",
      "kind": "character_system_text",
      "source_text": "よしっ、\r\n今日もよろしくお願いします。\r\nおれ、頑張りますね。",
      "source_fingerprint": "b90a960ff8a94b91ff218c24cddd66076a4989c87f0e76ab29eccd2b731f22b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20006"
      ]
    },
    {
      "uid": "zhcn:18836f22d389ac4cc0400869",
      "kind": "character_system_text",
      "source_text": "トレーナーさんとみんなに\r\n支えてもらってること。忘れずに…\r\n1日を大切に、今日も走ります！",
      "source_fingerprint": "d28983a6aea7c8d2b7b8f8e3a9fabae6c40deb53cf1461afc26b04223903ae6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20007"
      ]
    },
    {
      "uid": "zhcn:9f4dc985344eb0ac0c0adbf0",
      "kind": "character_system_text",
      "source_text": "まだ…まだやれるはずだ…\r\nやれなくちゃダメだ…！",
      "source_fingerprint": "1494dd39c5c4bb1930848341b02830fc197d772558fd00e5dbdac1e2ab60970c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20008"
      ]
    },
    {
      "uid": "zhcn:4e76d06d742d94fda775b1d0",
      "kind": "character_system_text",
      "source_text": "す、すみません！遅れました…！\r\nなんでか、ぼーっとしちゃって…\r\nもうしませんから…！",
      "source_fingerprint": "cf266b51c2025be166de554938cfa467fd0faf03222e1cdcf312ed4adad95466",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20009"
      ]
    },
    {
      "uid": "zhcn:2065fee2460f56021abb419d",
      "kind": "character_system_text",
      "source_text": "もっと走りたい、もっと動きたい…\r\nなのに、なんで…！",
      "source_fingerprint": "f5485a7b0b0765b7e8a37f021a908e47c675a2cae18f0f71052065a4fdda3785",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20010"
      ]
    },
    {
      "uid": "zhcn:a7c74f1d21873ffcfe5e7184",
      "kind": "character_system_text",
      "source_text": "これだけ助けてもらっておいて…\r\n何やってるんだ…！",
      "source_fingerprint": "cc5904943bf8ad2c80c3ab78f577f9e8454e45c8c5973ee0f6a5bef46f081e30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20011"
      ]
    },
    {
      "uid": "zhcn:817d70cea603e0220d22faa6",
      "kind": "character_system_text",
      "source_text": "…。…えっ？あ、はい！\r\nわかりました、レースですね…っ！",
      "source_fingerprint": "75341a2b617d112dd185719f8970ac16a4f6488993dda3a1565a52f3b812e29e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20021"
      ]
    },
    {
      "uid": "zhcn:61a92f0c7b80319c1e8e4c6b",
      "kind": "character_system_text",
      "source_text": "はい、レースですね…あれっ？\r\n変だな、ごめんなさい。\r\nなんで体、動かないんだろう…。",
      "source_fingerprint": "cbb123025e386cc7fea6cfac988c44685b92e4b12121b68058b20333e5b469c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20022"
      ]
    },
    {
      "uid": "zhcn:48d6d1c5417dc5a1387e050a",
      "kind": "character_system_text",
      "source_text": "みんなが、トレーナーさんがくれた\r\nこの脚で起こす、奇跡。\r\n…見ててくださいね、絶対！",
      "source_fingerprint": "7ceff634e8a3254f1eef483e253515704d1e12c6344fc55842300586620e235b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20023"
      ]
    },
    {
      "uid": "zhcn:9313a4c3125e80f55f3a5951",
      "kind": "character_system_text",
      "source_text": "今日、すごく調子がいいんです！\r\nもっと速く、もっと、もっと…\r\nどこまでだって、行けそうで！",
      "source_fingerprint": "2def9d678ccdc9f9298d2f2f6a7523901c41d77cf3765b6a9dfb99b3eb25d8c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20024"
      ]
    },
    {
      "uid": "zhcn:c11c062ce44eecbb865a3530",
      "kind": "character_system_text",
      "source_text": "任せてください。\r\n今日のおれ、\r\nきっと1番速いですから！",
      "source_fingerprint": "a02db1d057d23caf2db4873b5570ec288e496d6ffb3739f55e41e3a23c57df87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20025"
      ]
    },
    {
      "uid": "zhcn:16211accdc886b100a77f788",
      "kind": "character_system_text",
      "source_text": "この体の全部、底の底まで使って…\r\nみんなへの感謝、伝えます。",
      "source_fingerprint": "3845824c743e5df5cb306c073a8f0b90d0ccc0977fa8879be9b032254cf86ad1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20026"
      ]
    },
    {
      "uid": "zhcn:a16b89eafd138c66019aed2a",
      "kind": "character_system_text",
      "source_text": "胸を張って走ってきます。\r\nトレーナーさんが\r\n強くしてくれた、おれですから！",
      "source_fingerprint": "2d6283f2663f105f739ea96085e4003191d1fd5e48c32b181ec688d43abe3aee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20027"
      ]
    },
    {
      "uid": "zhcn:3bf1691f53c944f20a371d1d",
      "kind": "character_system_text",
      "source_text": "みんなが起こした“奇跡”と、\r\nトレーナーさんとした“努力”…\r\n合わさったら、絶対負けません。",
      "source_fingerprint": "1543dbd0f4c77485e5156aa6b0f69412863084ca90a88681a4f4ee95f11a8aa1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20028"
      ]
    },
    {
      "uid": "zhcn:03515d839d24d1e48b95cb3d",
      "kind": "character_system_text",
      "source_text": "あなたと研ぎ澄ました\r\nおれのスピード、\r\n見せつけてきます。",
      "source_fingerprint": "a88968f477de1840c2ebe0e398d82a4f3e634560a9e01d721d24b7403de49244",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20029"
      ]
    },
    {
      "uid": "zhcn:f8e18aa050a19aa16ccbcdc4",
      "kind": "character_system_text",
      "source_text": "レースに出る機会をくれて…\r\n本当に、ありがとうございます。",
      "source_fingerprint": "98cf47bd0280549eba25c113b0f725b192e1b015b9e35cd395d53ccf17dd0237",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20030"
      ]
    },
    {
      "uid": "zhcn:f3998fe98f22ef20c46760e0",
      "kind": "character_system_text",
      "source_text": "今日までに積み重ねた全部、\r\nからっぽになるまで\r\n出し切ってきます。",
      "source_fingerprint": "f32dc3c927cfdfb5fe1ed4ce90048631c5744db29b2b9bb272db2afb62897fff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20031"
      ]
    },
    {
      "uid": "zhcn:8544cdd318eb95d8f44e9655",
      "kind": "character_system_text",
      "source_text": "こんな調子ですけど…できます。\r\nせっかくここまで、\r\n連れてきてもらったんですから…！",
      "source_fingerprint": "4564105a16631a1e091054c2042c82b5b344ce5104db20da3a94430179e1784b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20032"
      ]
    },
    {
      "uid": "zhcn:ce5e55627e74cf66ffef7283",
      "kind": "character_system_text",
      "source_text": "…そんなに、\r\n調子悪そうに見えます？\r\n勝つ気ありますよ、おれ。",
      "source_fingerprint": "217771ebe765b4aa70435ee2a7047fc9cb2fb0ae7f7371cadeb743f679be48e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20033"
      ]
    },
    {
      "uid": "zhcn:1222859a1ed900696447c6f4",
      "kind": "character_system_text",
      "source_text": "このくらいの不調、よくあること…\r\nだから今日も、きっと大丈夫…！",
      "source_fingerprint": "f4292ddd6bc19987d7fb296cb449c203a9082f769d02a6edf09b8af48ed5db00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20034"
      ]
    },
    {
      "uid": "zhcn:b078d0f783c2aa761826a668",
      "kind": "character_system_text",
      "source_text": "走ることは、できる。\r\nなら、きっと…やれるはず…！",
      "source_fingerprint": "1d6dcd7ee69f80ece0c35442b15b6454cc355ab947c6070de513129e30ffc312",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20035"
      ]
    },
    {
      "uid": "zhcn:4110282f7ebc77816814e4f7",
      "kind": "character_system_text",
      "source_text": "…はい、任せてください。\r\n走れます。大丈夫…ですから。",
      "source_fingerprint": "97784f639a0b3d600774c168bdf2a197df763d08f9f0ea45fe5ccf7dd9ee11ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20036"
      ]
    },
    {
      "uid": "zhcn:7a29df29e15d047499392c27",
      "kind": "character_system_text",
      "source_text": "何があるかはわからない…\r\nでも、走るのだけは、\r\nやめるもんか…！",
      "source_fingerprint": "a26241a68aa9416a3c49de530b17b543dfa39ca43339255cffffd1c2364f20f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20037"
      ]
    },
    {
      "uid": "zhcn:7725dfb5725e8691bd96adbe",
      "kind": "character_system_text",
      "source_text": "はいっ。",
      "source_fingerprint": "4cdf426c11016bcf36aa3d52bedda8105a2b628163da1e38d75650958d536a82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9891b8ba8e1f1a4f5b12aef4",
      "kind": "character_system_text",
      "source_text": "行けます！",
      "source_fingerprint": "cd34eed60cc81bd1c599abc2aede887997cf68af42c8e7c31b97e1044f538e4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20039"
      ]
    },
    {
      "uid": "zhcn:b21e0970896225028cdee5ac",
      "kind": "character_system_text",
      "source_text": "頑張ります。",
      "source_fingerprint": "f464475ead61cacfa6bea987653976126da00e64ef9dec225ea1233750e29dfd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20040"
      ]
    },
    {
      "uid": "zhcn:a17ec0465b33f55d38d562e1",
      "kind": "character_system_text",
      "source_text": "ふむ…。",
      "source_fingerprint": "7cc85de9baa6672c2c81baee59b07561bae8d6e1b887a3e92e1cd1b692282626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20041"
      ]
    },
    {
      "uid": "zhcn:38b9f68484941a3366faa63e",
      "kind": "character_system_text",
      "source_text": "くっ…！",
      "source_fingerprint": "5bca6da8ecb6aaeab02e5a22863fa5110f97d666065235a519e4697647e7f875",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20042"
      ]
    },
    {
      "uid": "zhcn:32c39191109126927a0bd916",
      "kind": "character_system_text",
      "source_text": "あれ…？",
      "source_fingerprint": "700b60b81736f0d5344d9bd2f87a676e54130477b67d1ea6b3418c9a22a49632",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f8dda42a5b464d14f572ddb1",
      "kind": "character_system_text",
      "source_text": "出発ですね。",
      "source_fingerprint": "ec04f6635d9b277f81552785bbb91dde59d60afcca4ac146e2189d7ea2c09308",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20046"
      ]
    },
    {
      "uid": "zhcn:b13dae73d6243c3bd43664d1",
      "kind": "character_system_text",
      "source_text": "気持ちいい…。",
      "source_fingerprint": "a82b9c345c37d09b7bc500a754031d73d9d138dd24200aa93ef354007842aa30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20047"
      ]
    },
    {
      "uid": "zhcn:1d5bbad02a6780714eb3664c",
      "kind": "character_system_text",
      "source_text": "トレーナーさん、みんな！\r\nありがとうっ…！",
      "source_fingerprint": "0d038b12df2ab780c88e970bbd1ab7aed89f71b80cc5cf375c4e21dec2861946",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20049"
      ]
    },
    {
      "uid": "zhcn:5868e258aadb8233869bdede",
      "kind": "character_system_text",
      "source_text": "ここまで来られて、よかった。",
      "source_fingerprint": "7f81c08ac7ea85efa87e83309223dee4c8daa07c6ee22aaf10fb562a7c4325c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20050"
      ]
    },
    {
      "uid": "zhcn:81b32d2b240636bd0f25e142",
      "kind": "character_system_text",
      "source_text": "おれで助けになれるなら…！",
      "source_fingerprint": "26f7c8fddf927ccba136ff57a0e85727c67cd5348cd724ad711409da80820211",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "20051"
      ]
    },
    {
      "uid": "zhcn:67fb78bf19b7cfd87c2964e8",
      "kind": "character_system_text",
      "source_text": "全力で、いきます！",
      "source_fingerprint": "0edfce041c74dd68a9b45fd554801f6bf60a50343da20a560e7de361e5c1989a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "2030"
      ]
    },
    {
      "uid": "zhcn:cba49ee2bca7d10828eaff8e",
      "kind": "character_system_text",
      "source_text": "うん…みんな、行こう！",
      "source_fingerprint": "78df9570d08420c31c154d2d85189a60480667cba1ce695d610d9a843328d7ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "2031"
      ]
    },
    {
      "uid": "zhcn:747e466612a335cdb6ed45eb",
      "kind": "character_system_text",
      "source_text": "ここまで来られて、よかった。",
      "source_fingerprint": "7f81c08ac7ea85efa87e83309223dee4c8daa07c6ee22aaf10fb562a7c4325c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "2032"
      ]
    },
    {
      "uid": "zhcn:5131f43120a2483e2788abbe",
      "kind": "character_system_text",
      "source_text": "みんなが起こした“奇跡”と、\r\nトレーナーさんとした“努力”…\r\n合わさったら、絶対負けません。",
      "source_fingerprint": "1543dbd0f4c77485e5156aa6b0f69412863084ca90a88681a4f4ee95f11a8aa1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
