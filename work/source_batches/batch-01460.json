      ]
    },
    {
      "uid": "zhcn:020b1d0c5d4c4a5d9d718989",
      "kind": "character_system_text",
      "source_text": "任せてください。\r\n今日のおれ、\r\nきっと1番速いですから！",
      "source_fingerprint": "a02db1d057d23caf2db4873b5570ec288e496d6ffb3739f55e41e3a23c57df87",
      "source_path": "character_system_text_dict.json",
