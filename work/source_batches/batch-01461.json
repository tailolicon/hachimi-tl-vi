      ],
      "json_pointer": "/1093/70015"
    },
    {
      "uid": "zhcn:4dff627ca002d5879af6aa29",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "着替えてみました…どうでしょう？",
      "source_fingerprint": "a3ee08c55a751bb57b189641c930b40ad6456ad561355ac8b10f5db3600849c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1093",
        "70018"
      ],
      "json_pointer": "/1093/70018"
    },
    {
      "uid": "zhcn:687e70b1d567ce879104f6c3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "素敵な服を着せてもらえて、\r\n感謝ですね。",
      "source_fingerprint": "eaa0ef2e1f7fdcaf79027d5db6dd374bb165602e44f64540265c293e8617998b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
