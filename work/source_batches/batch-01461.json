    },
    {
      "uid": "zhcn:9db265416d3ff7436db997e8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "素敵な服を着せてもらえて、\r\n感謝ですね。",
      "source_fingerprint": "eaa0ef2e1f7fdcaf79027d5db6dd374bb165602e44f64540265c293e8617998b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
