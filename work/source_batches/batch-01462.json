{
  "schema_version": 1,
  "batch": 1462,
  "batch_count": 1645,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "d2656fb43e00556ee3186c852692cfa26a722dbc",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:3c2541ed779e78fbe6d794ae",
      "kind": "character_system_text",
      "source_text": "行ってくるぜ。",
      "source_fingerprint": "0f06e9d5d4b590fa75db11b1c2431f76a413069b4adaae557632a142ae95ad45",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "100000"
      ]
    },
    {
      "uid": "zhcn:f2be4cc3e390097dba64d010",
      "kind": "character_system_text",
      "source_text": "帰ったぜー。",
      "source_fingerprint": "98b3827a60410454db92086ecf75acc2a90391f3378ed47ce2dd4a1472475c21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "100001"
      ]
    },
    {
      "uid": "zhcn:919bd7d77f964586575453f0",
      "kind": "character_system_text",
      "source_text": "俺は俺の道を進む。けどよ、スジが\r\n通んねーと思ったら止めてくれ。\r\n任したぜ、お前に。",
      "source_fingerprint": "87bbeed51a9a547ba5e0a947f9af6555e6fbaf9acd166187ac45d49189362f14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10001"
      ]
    },
    {
      "uid": "zhcn:ca6645c64685d8a18441f2c2",
      "kind": "character_system_text",
      "source_text": "お前は、やる時はやるヤツだ。\r\nもっと胸張れよ――相棒！",
      "source_fingerprint": "d61f99e6d1eec3a786f5420521f93d6cba1573040c41d2341b3189f36e2c0731",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10002"
      ]
    },
    {
      "uid": "zhcn:613e280de63991c8445619a1",
      "kind": "character_system_text",
      "source_text": "新年早々、果たし状かよ。\r\nしゃーねぇ…\r\n景気よくぶち抜いてくっか！",
      "source_fingerprint": "81623bf42f4d6ee2de530cfd9b46e88b5f0127208ffaa960a9eb4ad9c414504d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10003"
      ]
    },
    {
      "uid": "zhcn:7cfe1b380b3586925ca642e3",
      "kind": "character_system_text",
      "source_text": "チョコパーティーすっから来いよ！\r\nすんげー数用意してっからさ、\r\nどれが1番か決めようぜ♪",
      "source_fingerprint": "fd6e0fe621d0c3de7a86d127b2df396a0baae63786b09572a111d211366bdc43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10004"
      ]
    },
    {
      "uid": "zhcn:0a46044d800aef8d9db5523c",
      "kind": "character_system_text",
      "source_text": "美味ぇチョコ色々探したんだが、\r\n選びきれねーってか…全部やるよ！\r\n好きなだけ食ってくれ。",
      "source_fingerprint": "62f211f9bcc3f41ce595a83b0117706115005b2a4d53c420c57085d98aa5a58a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10005"
      ]
    },
    {
      "uid": "zhcn:aa32063500dd5c6d3e2767dd",
      "kind": "character_system_text",
      "source_text": "誰だよ…俺よりたけーとこに\r\n短冊結んだヤツ？オイ、肩車しろ！\r\nもっと上に掲げてやらァ！",
      "source_fingerprint": "ac70a7860b2fbf7e5edb437160aaad989a8748de815d746b472b76856d435949",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10006"
      ]
    },
    {
      "uid": "zhcn:fbe6bc1b4f6fba88fd74568e",
      "kind": "character_system_text",
      "source_text": "な、なあ！オバケの仮装だらけで\r\nビビってんだろ！？しゃーねぇ、\r\n側にいてやるよ！なっ？？",
      "source_fingerprint": "cc08e32381ffd4694085945db1ac193b0f7f815af28ca77cdfa278171a092896",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10007"
      ]
    },
    {
      "uid": "zhcn:76002535b487329777697e9d",
      "kind": "character_system_text",
      "source_text": "家じゃアニキがサンタ役でよ。\r\nそんなんが嬉しかったっけ…。\r\nあー、今日くらい電話してやっか！",
      "source_fingerprint": "46b93066ab649f05a87b496886d26bf2bd51cb7814e9d4ae76e33288c039676d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10008"
      ]
    },
    {
      "uid": "zhcn:8620e6c6a97eb9a3db2f93db",
      "kind": "character_system_text",
      "source_text": "…お前のためだ…今回は譲る。\r\nいいか、ありがた～く食えよ…\r\nクリスマスケーキに載ったサンタ！",
      "source_fingerprint": "cb5ce9da4008c021a5155424e352b05d761add37d40273c1c4579936afde5db3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10009"
      ]
    },
    {
      "uid": "zhcn:e5a1a7939a6de82ff90cba2a",
      "kind": "character_system_text",
      "source_text": "へっ、やったな。",
      "source_fingerprint": "dc393df6ffec3d43d29bfcb6f461393ba1bc99c6edc2a15a5d3bfaa425c4cc8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1001"
      ]
    },
    {
      "uid": "zhcn:653f8f89bcaee608544815dd",
      "kind": "character_system_text",
      "source_text": "来たな、お笑いの年末が！\r\n漫才、コント、トークショー…\r\n徹夜だ徹夜ァー！",
      "source_fingerprint": "07bf6dbca8215378a3ac81cb5d9e66998482e0fe576acb23c5a10f035725c00f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10010"
      ]
    },
    {
      "uid": "zhcn:b72ea38fe705dc8e85322d86",
      "kind": "character_system_text",
      "source_text": "誕生日おめっとさん！\r\nいっぱいツレ呼んでよ。\r\nパーッと行こうぜー！",
      "source_fingerprint": "3a6fbdc7cff0bc4d06f6277e242a45e9986c7f4c33b0609acd2f89e1b9757c00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10011"
      ]
    },
    {
      "uid": "zhcn:e06ec4b6403053569020daaa",
      "kind": "character_system_text",
      "source_text": "プレゼント持ってきたぞー。\r\n揃いの特服だ…ヘヘッ。\r\n相棒にゃピッタリだろ！",
      "source_fingerprint": "f829b026777ba1409136fa7bd7f01d810fbbecae7217601bba61e15c63c8eea9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10012"
      ]
    },
    {
      "uid": "zhcn:d03fcb2dce1bd5a34d838098",
      "kind": "character_system_text",
      "source_text": "いやー、仲間からのプレゼントが\r\n止まんねーの！明日も\r\n誕生日になんねーかなぁ♪",
      "source_fingerprint": "2a8e11fbe8158d6b8b813a7fc52300de1f5ea69c839c65eb72b37e0dcdbf5f7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10013"
      ]
    },
    {
      "uid": "zhcn:de5b1765d30b67bc5a420be2",
      "kind": "character_system_text",
      "source_text": "おう、お祝いサンキューな。\r\nなにが変わるワケでもねぇけどさ。\r\nま、これからも頼むな、マジで。",
      "source_fingerprint": "d22ec8d7705d22531f61a55d20568a379030d34692a9b74146673d951a44158c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10014"
      ]
    },
    {
      "uid": "zhcn:51c625fe20bb20ac67b0a1f7",
      "kind": "character_system_text",
      "source_text": "新しい知らせが来てんな。\r\n果たし状なら受けて立つぜ？",
      "source_fingerprint": "1d1a1fdc68a8f93f004a0864d6699b06b1a6c70eda4edc058b9b4a9ff22c5463",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10015"
      ]
    },
    {
      "uid": "zhcn:0315ba80e911bbeb50c45cc1",
      "kind": "character_system_text",
      "source_text": "お、プレゼント届いてんぞ。\r\nいいもんじゃねーか！？",
      "source_fingerprint": "03bbe8a63e9fa741f0096ae82182f0aaaed2c44a2df66ac0f0a61bb84d9e50d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10016"
      ]
    },
    {
      "uid": "zhcn:e62554f44e9c4099f804105a",
      "kind": "character_system_text",
      "source_text": "ミッションクリアか、やるなー。\r\nさっすが俺の相棒だ！",
      "source_fingerprint": "eeb0df167bf2d30315b2bb7f8223f9886b0d2f2b90af5dd8fc96020e5d03cd99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10017"
      ]
    },
    {
      "uid": "zhcn:e088fcf7d25769250ad5e017",
      "kind": "character_system_text",
      "source_text": "おお、今度イベントやるって！\r\nいつだよ？早く来ねーかなー！",
      "source_fingerprint": "57ce19a8bd6469be9e8859e882e12e7694c23270d68e940646b4f9aa41f3b7a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10018"
      ]
    },
    {
      "uid": "zhcn:2bc80aec24f56f64c1b74486",
      "kind": "character_system_text",
      "source_text": "ほら、イベント行こうぜ。\r\n楽しまねーと損だろ？",
      "source_fingerprint": "064b9b498758d814d05d213dbcec69123d96ad92c20599c436260b03523808ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10019"
      ]
    },
    {
      "uid": "zhcn:db2b17328af062b6f45b2150",
      "kind": "character_system_text",
      "source_text": "次はぜってー勝つぞ。",
      "source_fingerprint": "1079ca3f86b17a7bfba2c8da67222af6503fd37be6d92cf2ece028ad87145a9d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1002"
      ]
    },
    {
      "uid": "zhcn:2d775171815fd50d4c09b1a8",
      "kind": "character_system_text",
      "source_text": "お、名鑑レベル上がってんな！\r\nやるじゃねェか。",
      "source_fingerprint": "afe0d39efd8abac5d37cdb910ba1a5615c1f989e98a1eb7c219955b772ecd3ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "10021"
      ]
    },
    {
      "uid": "zhcn:a254cc718afe60a62fc9aacc",
      "kind": "character_system_text",
      "source_text": "やるじゃねェか。",
      "source_fingerprint": "f3b419b29f62b88284ed4fba68ab6aebd261a073053580463df604d40aa4ab00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1003"
      ]
    },
    {
      "uid": "zhcn:1782aea43df545a2652daf10",
      "kind": "character_system_text",
      "source_text": "どんなもんだ！",
      "source_fingerprint": "f564a92be979d0bfae35a8c081f01a2db335e6cdd79684f4893ebfee11dc18e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1004"
      ]
    },
    {
      "uid": "zhcn:501ab151eb40d2e5f53ac6c6",
      "kind": "character_system_text",
      "source_text": "次はぜってー勝つぞ。",
      "source_fingerprint": "1079ca3f86b17a7bfba2c8da67222af6503fd37be6d92cf2ece028ad87145a9d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1005"
      ]
    },
    {
      "uid": "zhcn:f9b9864a05f9739b27300aa1",
      "kind": "character_system_text",
      "source_text": "やるじゃねェか。",
      "source_fingerprint": "f3b419b29f62b88284ed4fba68ab6aebd261a073053580463df604d40aa4ab00",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1006"
      ]
    },
    {
      "uid": "zhcn:0a7451e2a6a9caa941b44833",
      "kind": "character_system_text",
      "source_text": "俺たち無敵だな！",
      "source_fingerprint": "fb02f0451c3c4ddf4d0e8247282a323293f902d38cd828813c5a639b0cb76da8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1007"
      ]
    },
    {
      "uid": "zhcn:75aba2ca146a8eeb2add34ff",
      "kind": "character_system_text",
      "source_text": "ま、俺に任せとけって。",
      "source_fingerprint": "947d66144eca5113af0f12f88112a6d8c0eba6386af585907fc98d4bc283efd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1008"
      ]
    },
    {
      "uid": "zhcn:95ddff341f2fd33bcdb5d499",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "11"
      ]
    },
    {
      "uid": "zhcn:2fb4ba876dfface4e0920bf9",
      "kind": "character_system_text",
      "source_text": "トレーニングだな。\r\n目指すぞ、最強！",
      "source_fingerprint": "46159389e430c9161bd98ab9b7e15293342758343c2e9cdde7aac797eb7b9e0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "110000"
      ]
    },
    {
      "uid": "zhcn:fe3a45916ece773a6a93bc62",
      "kind": "character_system_text",
      "source_text": "おもしれぇ話ばっかだなー。\r\nお前も読んでみろよ！",
      "source_fingerprint": "00db2b12b20afe741c44276a09b22fabacabed2d3718206151d8dace6cf5d0e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "110001"
      ]
    },
    {
      "uid": "zhcn:92c16921368b3b9ce0b74e53",
      "kind": "character_system_text",
      "source_text": "レース上等！\r\nかましてやろうぜ。",
      "source_fingerprint": "be40b12abd28329d53e862a68f6dc7d436e8451e060053387fed7bb428523a52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "110002"
      ]
    },
    {
      "uid": "zhcn:aee4c450cc1b3364117ed8ef",
      "kind": "character_system_text",
      "source_text": "“最強”獲んぞ！",
      "source_fingerprint": "67e6b121b8a9336995f82e04a3dc3062bdafd5a4bdffd26fb104e7fa1ff6e6b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1178"
      ]
    },
    {
      "uid": "zhcn:86676dbf36abff4ca11fe60d",
      "kind": "character_system_text",
      "source_text": "ウマ娘、プリティーダービー！",
      "source_fingerprint": "0cfce02d59976c4a687f79d00d7894df0b5a6c879fbee1d653e3f267a88ff06d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "12"
      ]
    },
    {
      "uid": "zhcn:e54895038f767f0f789eca62",
      "kind": "character_system_text",
      "source_text": "すっげえ力…\r\n最高だな！！",
      "source_fingerprint": "3f5dbb53158f1fc8d8676fe7ce83a4010dd8e800b8b37a97069dbce1eed7be0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "120000"
      ]
    },
    {
      "uid": "zhcn:a0bbe351b150368e6a2a3f7b",
      "kind": "character_system_text",
      "source_text": "さて、やるか。",
      "source_fingerprint": "212c07d81b0a458db13f0a95c67cf2e230fcc8352f6d08fe7535afb2d5c615c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "1205"
      ]
    },
    {
      "uid": "zhcn:434a588b41d014723d1c043b",
      "kind": "character_system_text",
      "source_text": "ほら、今日のログインボーナスな。",
      "source_fingerprint": "01a9a15188bcf7df542278297d1065f3dfec130a4429a37203413b3f9c2c17a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "13"
      ]
    },
    {
      "uid": "zhcn:beed582bfc230a60b2de6ae6",
      "kind": "character_system_text",
      "source_text": "よく狙えよー？",
      "source_fingerprint": "3a24cf4e91428cc6c78eb816717bcd14a464d633477f39e4613d44c0e1556619",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140000"
      ]
    },
    {
      "uid": "zhcn:6636401e187595547f9fdb87",
      "kind": "character_system_text",
      "source_text": "やるなー！",
      "source_fingerprint": "ce72d3728ff716daf34a392799bb9dfeae71f5a5d1840385a78e15d11d325d4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140001"
      ]
    },
    {
      "uid": "zhcn:f3ddf66c399f2b72707dc535",
      "kind": "character_system_text",
      "source_text": "ぬあっ！",
      "source_fingerprint": "4fe7f671274feeb6bb26daaf5c622c4e5b9b444b160aadea65bfa2ed5e92ef99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140002"
      ]
    },
    {
      "uid": "zhcn:ce921e482e3675000b0a0a4a",
      "kind": "character_system_text",
      "source_text": "すっげー！！",
      "source_fingerprint": "5dfd18d4ef971267c394d9e0a100af0ed8a52c6206c628dd054decc016b4841a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140003"
      ]
    },
    {
      "uid": "zhcn:43e1a5e892deba8ef9637bdd",
      "kind": "character_system_text",
      "source_text": "上々だな！",
      "source_fingerprint": "a6237884357c7398041cd763c10fc1f43e2cb24b6a2fa634a59a99b2e5ebac05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140004"
      ]
    },
    {
      "uid": "zhcn:14897c63e94f74be60c7141d",
      "kind": "character_system_text",
      "source_text": "ドンマイ",
      "source_fingerprint": "d19679b3867e0d4e4265dcb11b85bc33ef4bfd2032154462ed94e7f0a108273e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140005"
      ]
    },
    {
      "uid": "zhcn:f9e9fbbbc837214a030546b2",
      "kind": "character_system_text",
      "source_text": "すっげー！！",
      "source_fingerprint": "5dfd18d4ef971267c394d9e0a100af0ed8a52c6206c628dd054decc016b4841a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140006"
      ]
    },
    {
      "uid": "zhcn:a985d676fa5be7529e084c65",
      "kind": "character_system_text",
      "source_text": "上々だな！",
      "source_fingerprint": "a6237884357c7398041cd763c10fc1f43e2cb24b6a2fa634a59a99b2e5ebac05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140007"
      ]
    },
    {
      "uid": "zhcn:5619aae810ee08c8a6d11b15",
      "kind": "character_system_text",
      "source_text": "ハハッ！",
      "source_fingerprint": "9c1e1df0085ff4af368d1b38f5e4d59356233a942de9c923fe15116f47741b79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140008"
      ]
    },
    {
      "uid": "zhcn:2dc145df1e00ce6f89ba7956",
      "kind": "character_system_text",
      "source_text": "へぇー。",
      "source_fingerprint": "a00aacf07ca740d2f5f07b497b731a126fe5edb39022ce12b9c7e33ff17b6dc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140009"
      ]
    },
    {
      "uid": "zhcn:4fda62f8cf5d8335738c07f9",
      "kind": "character_system_text",
      "source_text": "そーそー！",
      "source_fingerprint": "721b4370ab149672af12f806cd262bcea209e1b793c74ea708d47b75abeca03b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140010"
      ]
    },
    {
      "uid": "zhcn:a87c18b014f8532c1152e702",
      "kind": "character_system_text",
      "source_text": "やりぃ～！！",
      "source_fingerprint": "aa38f2db229057fc1ceeca394e452ec76225cbea8d4fac05a55918650fa98f94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140011"
      ]
    },
    {
      "uid": "zhcn:21e499653ef4b517721f8a43",
      "kind": "character_system_text",
      "source_text": "うお！？",
      "source_fingerprint": "2a140bc572235560340e883c4ce0824c3380ce1a9521e008ab4b82555a151338",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6c65a5226ad1c7d34a2cf6f8",
      "kind": "character_system_text",
      "source_text": "すげーな！",
      "source_fingerprint": "40c6b21860f1c41c5d28f879de276134dbc6652d139af5125f2f771f29683ac7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140013"
      ]
    },
    {
      "uid": "zhcn:d23e7c9cd310989ea49df250",
      "kind": "character_system_text",
      "source_text": "おっと。",
      "source_fingerprint": "d5c945514b64144e14d63b9d375b0e71612c3c084211b5ed5101838cb184c008",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140014"
      ]
    },
    {
      "uid": "zhcn:97f15ddc085e0b1d438a34ca",
      "kind": "character_system_text",
      "source_text": "お～。",
      "source_fingerprint": "87785e14b7780ff16f45d058a9b4579cf740c661bf1ef93e9d7107bdfe188874",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140015"
      ]
    },
    {
      "uid": "zhcn:0aa33319872517c75d59dc5d",
      "kind": "character_system_text",
      "source_text": "どした？",
      "source_fingerprint": "da23d730b30d5f3c0f28b4ddb89d6f2e51705618e98e6791b6d78317f0522d2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140016"
      ]
    },
    {
      "uid": "zhcn:abeb5756e973605871b11ae5",
      "kind": "character_system_text",
      "source_text": "くっ！",
      "source_fingerprint": "340d7ec2761b623270c67dfe3302e368f40827ba1c40260b5c070b1e97f5889f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140017"
      ]
    },
    {
      "uid": "zhcn:ad789b3521be4cc98b736edb",
      "kind": "character_system_text",
      "source_text": "だぁ～。",
      "source_fingerprint": "ac43f4a5ca9c9af57ec8d3272d3c1fd2b5b6ea26a4277950591190e6e28a21a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140018"
      ]
    },
    {
      "uid": "zhcn:b5bebb1a99e8597ee0689ef7",
      "kind": "character_system_text",
      "source_text": "明日はこれだってよ。",
      "source_fingerprint": "638f68369311f8cc7b3cc5cc76f8dc94b77bd5b4f1f64b570025e57ad3bd8721",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "15"
      ]
    },
    {
      "uid": "zhcn:3e4466230bd3b5850d9ee2fa",
      "kind": "character_system_text",
      "source_text": "休みくれよー！な？な？\r\nいいじゃんかよー。",
      "source_fingerprint": "e3d242a048496d7331e1dc1ed906e80a5181a6155189b7363a70ba4d52fa88e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20000"
      ]
    },
    {
      "uid": "zhcn:31dd3a2c94f993f2dfe0d8b1",
      "kind": "character_system_text",
      "source_text": "あっち向けよ。\r\n…情けねーとこ見せたくねェ。",
      "source_fingerprint": "1a3a5114ee522a9a1acdd423475a7a00fa103484b68e9fb13cfe814f554b3cb4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20001"
      ]
    },
    {
      "uid": "zhcn:4edcd74fc0c6a2ec175d4b6c",
      "kind": "character_system_text",
      "source_text": "遠慮はいらねぇ。なんでも来い。\r\n全部クリアしてやっからよ！",
      "source_fingerprint": "da0eac3f6ade01508ae66f6501e7f36a6f36b75b69164214893b02d389b53670",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20002"
      ]
    },
    {
      "uid": "zhcn:be86aeae4cd5794b460ba662",
      "kind": "character_system_text",
      "source_text": "おら、始めんぞ。\r\n一緒に目指すんだろ、最強！",
      "source_fingerprint": "5058f8267a3b115e338c0bf0e41000a9b4a90fc4dcf4fe908a62fb0a2e7e1195",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20003"
      ]
    },
    {
      "uid": "zhcn:788ff83d90fd17e49469eba2",
      "kind": "character_system_text",
      "source_text": "俺はもっと強くなる。\r\n証明してやろうぜ！",
      "source_fingerprint": "a5318f2973c7e717306e8accf7bb19e74e3ccc8383d0ea9b81e3f9bcf4c55826",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20004"
      ]
    },
    {
      "uid": "zhcn:d95517cc9afdf1bd5a9389e9",
      "kind": "character_system_text",
      "source_text": "周りがビビるくれぇ\r\nすげぇトレーニング、\r\nやってやろうぜ！",
      "source_fingerprint": "2a2f59574cd59afbbb4f44e132c55bce3320ef1a3191969a292292a779b1c951",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20005"
      ]
    },
    {
      "uid": "zhcn:fd06b74173d7fd90645957f5",
      "kind": "character_system_text",
      "source_text": "トレーニング上等！\r\n全部片してやらぁ！",
      "source_fingerprint": "4a5386d9199f4cc9f91550b809eeb9eab98a7e69f0aa90b3274381ef79e21f0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20006"
      ]
    },
    {
      "uid": "zhcn:4eef4097d3c29756ca809422",
      "kind": "character_system_text",
      "source_text": "とにかくおもしれーの頼んだぜ！\r\nタイマンとかチキンレースとか、\r\nそういうのな！",
      "source_fingerprint": "a85cfd41c0223d5eaa3fc901eac49ef1269139ce1cc23068224ee997d76d2f3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20007"
      ]
    },
    {
      "uid": "zhcn:5d1f07cac842af9684d15b82",
      "kind": "character_system_text",
      "source_text": "考えんのはヤメだ。\r\nやってるうちになんとかなんだろ。",
      "source_fingerprint": "8dc27740fc54b4ec22742b68a47b2b6c8548372bd60b7d8328992032e5cf265e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20008"
      ]
    },
    {
      "uid": "zhcn:f5ef732ac740b5a69b7023f4",
      "kind": "character_system_text",
      "source_text": "調子がどーとか、関係ねー。\r\nお前も甘い指導なんかすんなよ…！",
      "source_fingerprint": "1ef71261a068799850c9b4d7d17163f706c60a459191c4e3528572048c6a8e17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20009"
      ]
    },
    {
      "uid": "zhcn:54f6106c01b0861e4504be2e",
      "kind": "character_system_text",
      "source_text": "俺のことは気にすんな。\r\nてめぇのことはてめぇで片つける。",
      "source_fingerprint": "749a0d05b27c6e5087d5d683baa224826383f1ef6cdd9bd1ad0ca86d2b89c40c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20010"
      ]
    },
    {
      "uid": "zhcn:f503ed75671aaa73fba63969",
      "kind": "character_system_text",
      "source_text": "やる気がねーって、大一番でも\r\n言い訳すんのか…ちげーよな。\r\nやるぞ。",
      "source_fingerprint": "e91ecda89638f22259df11870518fad4b5efd69841f0cdac5962fdb2446ed859",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20011"
      ]
    },
    {
      "uid": "zhcn:c3990a25ff50d3f8dee5bc22",
      "kind": "character_system_text",
      "source_text": "ばかすかレース組みやがって。\r\n限度ってもんがあんだろ！",
      "source_fingerprint": "0764f2014471e47b078bf668d795c3b2d177fa238436b3ca94ecccb29a38417a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20021"
      ]
    },
    {
      "uid": "zhcn:d10e1e0f1b3975981308c6ae",
      "kind": "character_system_text",
      "source_text": "どんだけレース走らせんだ…\r\nまだ足んねーか？あ？\r\n答えてみろよ、『トレーナー』。",
      "source_fingerprint": "92a773bc126d53557812dd84417161e0a0a47edf3acc3bebd2bac19a56058eba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20022"
      ]
    },
    {
      "uid": "zhcn:704828081a291cb34327cd44",
      "kind": "character_system_text",
      "source_text": "作戦なんざいらねェ――\r\n俺が勝つ！俺がぶち抜く！\r\nまとめて畳んでやるよ！！",
      "source_fingerprint": "e7f286c340e69d1a40c8dd30fff1f8bc26d79110214f9f33c65abc7084d991b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20023"
      ]
    },
    {
      "uid": "zhcn:8c55cbab9395ce266310bda0",
      "kind": "character_system_text",
      "source_text": "今日の客はラッキーだな。\r\n絶好調の俺が見られるんだぜ？\r\n最強の走り、焼きつけてやんよ。",
      "source_fingerprint": "23aab53c35fc23b0fcf97e8d1a9ff3d6930b8400aaeb9284c109fddf24b8fbb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20024"
      ]
    },
    {
      "uid": "zhcn:2d5cb1520bdbd7fa5ec409a4",
      "kind": "character_system_text",
      "source_text": "おー、おー。どいつもこいつも\r\n殺気立って――へへへッ！\r\nめちゃくちゃ楽しめそーだな！！",
      "source_fingerprint": "7330cadad76ccf1787d1c9b519628fcb12e6bcfdf19946433db0693148af9f3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20025"
      ]
    },
    {
      "uid": "zhcn:8dba7ab4261f406406f4952f",
      "kind": "character_system_text",
      "source_text": "強そうなのがそろってんな。\r\n…ま、俺ほどじゃねーけど。",
      "source_fingerprint": "336f937c8cd24b53bc54fd7550c0e1862331f2f2f91459ed9047353592a54690",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20026"
      ]
    },
    {
      "uid": "zhcn:336fb6d7b7aa67f07a5751b8",
      "kind": "character_system_text",
      "source_text": "ビシッと勝ってくっから。\r\n祝いの言葉、考えとけよ！",
      "source_fingerprint": "1eae0682d53809c4700d1a15fae57ad3113a874a890460f859d3a96e5a242f55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20027"
      ]
    },
    {
      "uid": "zhcn:9bfef2fd9c191778f7ae6ee4",
      "kind": "character_system_text",
      "source_text": "勝つのは当然として、\r\n問題はどう勝つかだよなー。\r\nどうせなら沸かしてーだろ？",
      "source_fingerprint": "44fcb9f8cb5c05f500940e0aa8f4ffa063ae389bac2ad68c1efe8663ad306a78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20028"
      ]
    },
    {
      "uid": "zhcn:3c784a98a7b0a194f5834d04",
      "kind": "character_system_text",
      "source_text": "ヘヘッ、やっと走れんのか。\r\n楽しもうぜ、トレーナー！",
      "source_fingerprint": "bfc4d014233d783ce5702113f35c714ae2d9f290c0afbb4679870129156de3c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20029"
      ]
    }
  ]
}
