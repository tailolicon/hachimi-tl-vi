        "1094",
        "92003"
      ],
      "json_pointer": "/1094/92003"
    },
    {
      "uid": "zhcn:37487f0b5b78ad29294f3960",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "なあ、今日はどんなことすんだ？\r\n遠慮せずビシッと言えよ。\r\nちゃ～んと強くしてくれんだろ？",
      "source_fingerprint": "df09989ead7dd8c618e2be063956f055ec3dd7778d60e67ec545ef2553afce45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "92005"
      ],
      "json_pointer": "/1094/92005"
    },
    {
      "uid": "zhcn:4cd7efc113d0f19c3ca7bda2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "なっちまおうぜ、伝説に。\r\n俺たちなら目指せるって、\r\nマジで思ってんだ。",
      "source_fingerprint": "b8e637f36679a2564d0fc0608922a25a2322697bd0e48e3ee3e189437553f3f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
