      "source_text": "只要和你在一起！",
      "source_fingerprint": "f5209a3fad54f5e3fcfe283c4132ee2cb3908ab78f321b84c6a2c5524638e257",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1091",
        "1189"
      ]
    },
