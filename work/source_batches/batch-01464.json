      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "92001"
      ],
      "json_pointer": "/1094/92001"
    },
    {
      "uid": "zhcn:0cce59961cca3004cdb6c317",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "オラ、お前も根性入れろ！\r\n空っぽになるまでやんぞ！",
      "source_fingerprint": "08a52e58cee9ccc48a24f2bd32140ed049cdcd5f327aac744a78260ed4bfdc03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
