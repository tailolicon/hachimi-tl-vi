    {
      "uid": "zhcn:28865ddcc6b2d540ef5b59f2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "俺たちが“最強”のコンビだ！",
      "source_fingerprint": "afc653f67dea89558275e92ba84103e47cf972dfa62393c158b116b1a500f4da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
