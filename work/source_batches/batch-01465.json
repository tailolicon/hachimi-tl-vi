    },
    {
      "uid": "zhcn:d844a233391c2644099747ae",
      "kind": "character_system_text",
      "source_text": "呣呀呣呀……\r\n开始变困了……\r\n呐，训练员亲~送我到宿舍吧~",
      "source_fingerprint": "af9a21be36be9c081a44585e5b7244a7b1ee88c36fc1f1ab89b8c2be5fa375b2",
      "source_path": "character_system_text_dict.json",
