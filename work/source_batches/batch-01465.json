  "entries": [
    {
      "uid": "zhcn:a4d83ca092c5105126e2f5b1",
      "kind": "character_system_text",
      "source_text": "沸腾、燃烧…啊啊…！",
      "source_fingerprint": "9937a42e0345d9fe07ab364c37a30dfe1d43399d43e9dc9b78535a714d6b1bbb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "120000"
      ]
    },
    {
      "uid": "zhcn:ee14f45c0f94e8b12f44ab94",
      "kind": "character_system_text",
      "source_text": "可恨的人…",
      "source_fingerprint": "9e3c809406547fe2120b4c952387c22b26a2bbd301020fd8d89cecefa31c3a36",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "1241"
      ]
    },
    {
      "uid": "zhcn:d116f9ee27dbe57e7ab71f67",
      "kind": "character_system_text",
      "source_text": "魔物的同类。",
      "source_fingerprint": "6e50c845cc25480c6dec6c87cdc888f4f8990d4edd05fcf4d2c917b3b4bb7667",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "1242"
      ]
    },
    {
      "uid": "zhcn:afe54450b205cb2165ec854c",
      "kind": "character_system_text",
      "source_text": "今天的登录奖励\n似乎是这个。",
      "source_fingerprint": "094872d2c5e8b99a005fa2e12e93e84a645eacfc5d6defcbfb43a1042e2076ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "13"
      ]
    },
    {
      "uid": "zhcn:031f7953512ad70eee5a29ae",
      "kind": "character_system_text",
      "source_text": "我会守护着您。",
      "source_fingerprint": "5edac699661da7bbfd11c3d0bdc9f9837392a499fb001ca54a77280f69eca24d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140000"
      ]
    },
    {
      "uid": "zhcn:c965a69473ebf720f9e6132d",
      "kind": "character_system_text",
      "source_text": "您真厉害。",
      "source_fingerprint": "66c95d86ff70bd3aaac0c2748aa343bd7cbcc294ac9895d90d9f45235e3e8863",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140001"
      ]
    },
    {
      "uid": "zhcn:f322de37029de73de4c00a0e",
      "kind": "character_system_text",
      "source_text": "哎呀…",
      "source_fingerprint": "d17809827b0889e5a0b80dbad0f7eef8501c7ca15d5376b38cd26eaa7264a2e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140002"
      ]
    },
    {
      "uid": "zhcn:2187d65f3877aedea03b5cea",
      "kind": "character_system_text",
      "source_text": "真不愧是您呢…♪",
      "source_fingerprint": "3037069c88f62816898c1e48138f679c86b244e4079e6abee8992940258c9a72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140003"
      ]
    },
    {
      "uid": "zhcn:8a0572a9f8ba346862774282",
      "kind": "character_system_text",
      "source_text": "真是漂亮。",
      "source_fingerprint": "9c4731874e8dce5947497524bffc2ae65b0fb92aa592a3435724b2940633d426",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140004"
      ]
    },
    {
      "uid": "zhcn:8af4fc3c38b0453fab3ae321",
      "kind": "character_system_text",
      "source_text": "支援未能及时…",
      "source_fingerprint": "cea27f47bcda2d905580519f5a777b5474a203ebe8b9634dc431f3d5f9a0dee3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140005"
      ]
    },
    {
      "uid": "zhcn:1d42bdfbf56d1a5c134e656e",
      "kind": "character_system_text",
      "source_text": "真不愧是您呢…♪",
      "source_fingerprint": "3037069c88f62816898c1e48138f679c86b244e4079e6abee8992940258c9a72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140006"
      ]
    },
    {
      "uid": "zhcn:ada325871944e8bda61a6bd1",
      "kind": "character_system_text",
      "source_text": "真是漂亮。",
      "source_fingerprint": "9c4731874e8dce5947497524bffc2ae65b0fb92aa592a3435724b2940633d426",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140007"
      ]
    },
    {
      "uid": "zhcn:dbd90932b1ea3c226c6f59dd",
      "kind": "character_system_text",
      "source_text": "嗯？",
      "source_fingerprint": "8af85ce981d9ec89ad4d75b1bd062ebe03e9f22dc5edb7cd9b8099f05574c6c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140008"
      ]
    },
    {
      "uid": "zhcn:16879d92ebc09ba8c9e21a14",
      "kind": "character_system_text",
      "source_text": "呵呵…",
      "source_fingerprint": "eb4f0c0725cac8f30cd2af10f97eff49b8b7c18642b01f30701bdbc0b7213329",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140009"
      ]
    },
    {
      "uid": "zhcn:5f378de8aeb511954c07a192",
      "kind": "character_system_text",
      "source_text": "请加油…",
      "source_fingerprint": "50e3db225703353a98684069153d9a84b7327dfdc9eec874dbf9b01b5cfdd020",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140010"
      ]
    },
    {
      "uid": "zhcn:a107300d6a368fcfb8af74ae",
      "kind": "character_system_text",
      "source_text": "真是令人惊讶…！",
      "source_fingerprint": "90ca5cef8320323b81ca9b954331fdfde4e488f561c8a25bb4df1acd5c12d2e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140011"
      ]
    },
    {
      "uid": "zhcn:92c5bbc93b9d712bd2be9e5e",
      "kind": "character_system_text",
      "source_text": "是机会呢。",
      "source_fingerprint": "9bac98a518392631d1bab807e1833afb31952fa923db78b75759daf607433623",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140012"
      ]
    },
    {
      "uid": "zhcn:9e64b90474f5b68011f02ad0",
      "kind": "character_system_text",
      "source_text": "哎呀呀…！",
      "source_fingerprint": "fe46ccd4487f3d9b4823620578b46e8849c3cbde8dda1c1e0699939437f1b7f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140013"
      ]
    },
    {
      "uid": "zhcn:a717046926f4bdae9e0bb918",
      "kind": "character_system_text",
      "source_text": "啊…",
      "source_fingerprint": "c69a69d134409083b2571486bf2f11af9edeea86eb1ff3cf2e67f3657d70fa6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140014"
      ]
    },
    {
      "uid": "zhcn:55f89d051a5e616887c80495",
      "kind": "character_system_text",
      "source_text": "嗯…",
      "source_fingerprint": "c2b1385a78684f8c6250497cd373b68b34b56c3152bdab9e427a4605f7d03f14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140015"
      ]
    },
    {
      "uid": "zhcn:60df270967e0a328c75dbebf",
      "kind": "character_system_text",
      "source_text": "您觉得如何？",
      "source_fingerprint": "f41b79a58ab44cf4e04f7c5467a55a12cfa60a24cd4c4571a12e10db7064636f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140016"
      ]
    },
    {
      "uid": "zhcn:e95c9989dd8e3f8098dc8015",
      "kind": "character_system_text",
      "source_text": "可惜…",
      "source_fingerprint": "4441c01168900818ac075ac7a66297457874f771e69016556f3d7f8d1f494b64",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140017"
      ]
    },
    {
      "uid": "zhcn:4d8b4b04e0144687353fe99f",
      "kind": "character_system_text",
      "source_text": "逃掉了呢…",
      "source_fingerprint": "f807849caf95a9b6f6f0c4aa1e12e8b2dc96ed003822953d99a1affd8d475af6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "140018"
      ]
    },
    {
      "uid": "zhcn:729048f39a555c4fb120ae38",
      "kind": "character_system_text",
      "source_text": "明天似乎能由我们收下呢。",
      "source_fingerprint": "415922b5f0e02498c16efd30d1b9496a85b6e077decc4b4615cbbed9cf9f0269",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "15"
      ]
    },
    {
      "uid": "zhcn:facb9a7e4e6984386a869cfc",
      "kind": "character_system_text",
      "source_text": "现在，如果那孩子狂暴起来的话\n…感觉腿会支撑不住呢…",
      "source_fingerprint": "a10f351bfea6a0ae2d18677a9e1c82028ee0c85c297d93c9a39563144bcc8cae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20000"
      ]
    },
    {
      "uid": "zhcn:6da99983cd213f6672acc38a",
      "kind": "character_system_text",
      "source_text": "…身体，不听使唤…\n呜，让您失望了，\n非常抱歉…",
      "source_fingerprint": "f6cd68a95c0158e4dd405032494bf3237b41d9671bbd6ad58048ac1984a9acd3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20001"
      ]
    },
    {
      "uid": "zhcn:7cff227f622c0e8f825479b2",
      "kind": "character_system_text",
      "source_text": "已经受够等待了…\n来吧…！…呜，不行…！\n还，太早了…！",
      "source_fingerprint": "229f10498a19cef2bd6dd3c8280c57abc7e2e15665afe5ae7a8dbb9e42dfa40b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20002"
      ]
    },
    {
      "uid": "zhcn:7b429d57172f1cdfcaef35db",
      "kind": "character_system_text",
      "source_text": "双腿，渴望着奔跑…\n啊啊…那孩子的心情，\n现在…或许稍微能理解了。",
      "source_fingerprint": "d8191624d48ce3473aa03f396b9373a0f6ea0bedf0a829a66a25919caf410ca0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20003"
      ]
    },
    {
      "uid": "zhcn:01d8a52d269401dfa54b26b7",
      "kind": "character_system_text",
      "source_text": "…正看着呢…那孩子。等待着\n能够吞噬一切的肉体…\n完成的那一刻。",
      "source_fingerprint": "57adfced2abb76400401dc9fcce46a7e043055bebb5aeb3b5ae1a296f2e930fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20004"
      ]
    },
    {
      "uid": "zhcn:fd18ce755fe691200606e130",
      "kind": "character_system_text",
      "source_text": "准备运动期间，身体也在躁动…\n…不快点…奔跑的话——\n快点，快点…更快。",
      "source_fingerprint": "094682a55f09e63144f9d2050ad97142c6e7466dc51137492a218470d048ad44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20005"
      ]
    },
    {
      "uid": "zhcn:637f7f31779f7bd604d298be",
      "kind": "character_system_text",
      "source_text": "准备工作就稳步推进吧。\n积蓄得越多…在赛场上，\n那孩子就越是狂暴。",
      "source_fingerprint": "5fd92f77a0e88d613a28ccc302af37df49e533b15c5f3c7226c5d82dcd2bf98d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20006"
      ]
    },
    {
      "uid": "zhcn:fc7f7e7d801d2fea5808979c",
      "kind": "character_system_text",
      "source_text": "与您一起，将内心的存在\n逐步驯服吧。\n…直到解放的那一瞬间。",
      "source_fingerprint": "523ce740717f4712fa83aee59099185accb83fdd588af3014f4d772d4a43deb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20007"
      ]
    },
    {
      "uid": "zhcn:56fe1f76bbc2cc7638458357",
      "kind": "character_system_text",
      "source_text": "感觉不到往常的兴奋\n…异常地，那孩子很安静呢",
      "source_fingerprint": "9c6351ea3770c5024b825adb86507284c54ff18f17ccca3492456317847681d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20008"
      ]
    },
    {
      "uid": "zhcn:3504ee0387ce30b157d16716",
      "kind": "character_system_text",
      "source_text": "…必须振作起来呢。\n这种时候，\n果然需要苦咖啡吧…",
      "source_fingerprint": "23c3e0b39a0cd8ee3829442dbbb6520debcc789891282ab54ac0dffc5a44fe58",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20009"
      ]
    },
    {
      "uid": "zhcn:216fc748e62648a9f56d70ab",
      "kind": "character_system_text",
      "source_text": "腿没有颤抖…胸口，也没有疼痛…\n…没有渴望奔跑吗…？",
      "source_fingerprint": "9bff4a524fed64dda4f1dca6271310ac96687e7ad85dfa8bcbcd0099593b8aa7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20010"
      ]
    },
    {
      "uid": "zhcn:f235b41fd0e1fed52bc54523",
      "kind": "character_system_text",
      "source_text": "…非常抱歉。\n可以稍微，让我在\n阴凉处休息一下吗…？",
      "source_fingerprint": "44f423ba2fec7819574bd6589d731c802fbb1c87e9973526f5bb098d94bbfd61",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20011"
      ]
    },
    {
      "uid": "zhcn:7ed0aa50d557dcb50b523146",
      "kind": "character_system_text",
      "source_text": "是不是稍微，让那孩子\n狂暴过头了呢…如果失去了\n控制的方法…会发生什么…",
      "source_fingerprint": "f14138a094a631978621da1aa37e400f9f1e4981faee5fae4ce56a7a870e7ddc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20021"
      ]
    },
    {
      "uid": "zhcn:e16d0114eac013aeab2956bc",
      "kind": "character_system_text",
      "source_text": "…开始，不明白了…。\n狂暴的怪物，试图抑制的我…\n真实的…是哪一个…？",
      "source_fingerprint": "c421b3f7fb664cefcc23b10e3b8ed4463ace92cc4f4ac91519baeadde551d1ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20022"
      ]
    },
    {
      "uid": "zhcn:978fdef5f72b6c187cb2a1c3",
      "kind": "character_system_text",
      "source_text": "…渴求。无法抑制地，\n饥饿着。啊啊…束缚那孩子的\n锁链，马上就要断裂了…",
      "source_fingerprint": "f44e52da93b29a3b98a75a9dfc01751655e547225c498ed6182e56ef0ed32dc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4f60dd1b175a439760e9b7f3",
      "kind": "character_system_text",
      "source_text": "没关系。已经，可以了。…可以吗？\n真的？…呵呵，呵呵呵，呵呵呵\n呵呵呵呵。已经不用忍耐了…",
      "source_fingerprint": "ba821363faae54b15d1ff63449399d27b9314d4a4ffc9983e1ec5a5ef826428a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20024"
      ]
    },
    {
      "uid": "zhcn:62d649b87678d918acaf348f",
      "kind": "character_system_text",
      "source_text": "今天一定抑制不住…想要展露\n卑劣丑陋的模样…只有您，\n会接受我吗…？",
      "source_fingerprint": "68387c0dd642d40268ec75f55a433f47974baaa2bac3361f3756fc12a3162b91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20025"
      ]
    },
    {
      "uid": "zhcn:e3c8106d6a3cb6244c2ff537",
      "kind": "character_system_text",
      "source_text": "真不可思议。明明应该害怕，\n和您一起行走时脚步却变得轻快…\n一同，前去吧。",
      "source_fingerprint": "422e66d6976b1d26d8b7156ca3db5788f5ec344af8f1f421283238bebb75bffd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20026"
      ]
    },
    {
      "uid": "zhcn:39d5af4af0a6c677b3e6d866",
      "kind": "character_system_text",
      "source_text": "…已经，可以吃了吗…？\n随心所欲地…呵呵，\n呵呵呵呵呵呵呵。",
      "source_fingerprint": "061c88a55ae5b98380c2945dde582916fc6afb737959d6ec7b2fc2cb3226fa49",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20027"
      ]
    },
    {
      "uid": "zhcn:005a11afcedb5f7b66200cc4",
      "kind": "character_system_text",
      "source_text": "啊啊…必须道谢呢。\n因为您邀请我参加了\n佳肴满席的美妙宴会…♪",
      "source_fingerprint": "2f2aed8c5cafb6e21ca780a1cea051de9cb72737e79f43a1b77bfedb5ad5d186",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20028"
      ]
    },
    {
      "uid": "zhcn:166c263bff62a38ecb1bb077",
      "kind": "character_system_text",
      "source_text": "锻炼出的双腿，是我的武器…\n那孩子的獠牙。必定…取得\n第一名，回来。",
      "source_fingerprint": "49dd97680080f98765927d77c5668c16e915028960e40eaef9c153c4616c270f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20029"
      ]
    },
    {
      "uid": "zhcn:49fd4fe6897c0c41a18a5eac",
      "kind": "character_system_text",
      "source_text": "我们，或许是两人一起养育了\n怪物…即便如此，\n也好。只要能为您带来胜利",
      "source_fingerprint": "13a370b132c360b59cbc8b3622fd3cbb0c95fde671ecee04e7d26fc7a1fd2f9a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20030"
      ]
    },
    {
      "uid": "zhcn:2197857d59cc8b93db082df8",
      "kind": "character_system_text",
      "source_text": "有吗。强大的孩子，快速的孩子\n…美味的孩子…啊哈。",
      "source_fingerprint": "3857d312c7db98551b1eade9284eff7e525023d0202b4be15c1a123a6cd250ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20031"
      ]
    },
    {
      "uid": "zhcn:a61a18d04040ee3285a28a89",
      "kind": "character_system_text",
      "source_text": "…您在担心我吗？\n没关系的…那孩子，\n獠牙也没有失去…",
      "source_fingerprint": "e077289b77869adaba5929125cd2190742537284b6be2ee3fa35faac63fd3793",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4c83192c31d8c9e520f85300",
      "kind": "character_system_text",
      "source_text": "我，我们可以战斗。\n…即使无法相信自己，\n也能相信您。",
      "source_fingerprint": "beeac73f35bd0b17586035f67d1811bc17e769c3be5312bc4e15510f5711151e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20033"
      ]
    },
    {
      "uid": "zhcn:6c550de16b0d6866fd045664",
      "kind": "character_system_text",
      "source_text": "请您不必担心…\n您所做的事情\n的正确性，我会证明给您看。",
      "source_fingerprint": "fa106e5e79a0cbb20a274a3c11aaa553d49be5534245e59ee7688e0c4230f5e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20034"
      ]
    },
    {
      "uid": "zhcn:0941cf446967cc48ce945b17",
      "kind": "character_system_text",
      "source_text": "和您在一起就没有可怕的东西…\n即使…等待的是\n深渊也罢…",
      "source_fingerprint": "31bf95add9508cf87f58ed0861f279ca68558dc1fbe86a31def76e656f33f894",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20035"
      ]
    },
    {
      "uid": "zhcn:02615c75987e875f5641debf",
      "kind": "character_system_text",
      "source_text": "…可以牵住我的手吗。\n那样的话一定…\n颤抖也会停止。",
      "source_fingerprint": "e9c104cd61d6bb9c4a2a065e75d83f89d24a392ea9a0fcff6b44b23383f9e051",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20036"
      ]
    },
    {
      "uid": "zhcn:cdffa77ff448d799d17000e4",
      "kind": "character_system_text",
      "source_text": "那孩子，失去了力量…\n那么…即使只有我一个人，\n也必须努力试试看…",
      "source_fingerprint": "30c9c56644c139a58719f370d43e099f379c91cd930e0e6478c7633ff4522988",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20037"
      ]
    },
    {
      "uid": "zhcn:5ae4a6ba0be98e9babfd1536",
      "kind": "character_system_text",
      "source_text": "那么…",
      "source_fingerprint": "dc8b3bbf8422f96e189bd9ae9705736aadf5c9e12b7881060b16d27deea4060e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2ef88eb0dee0563c7f105723",
      "kind": "character_system_text",
      "source_text": "我来了…",
      "source_fingerprint": "d8cd473f45c92a27ecc35ef1018638325f32b3e17271b4d7b8d451388c2d29dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20039"
      ]
    },
    {
      "uid": "zhcn:a0deb64523124af243beb0c4",
      "kind": "character_system_text",
      "source_text": "啊哈哈！",
      "source_fingerprint": "7990e29ba73adbb25caf3a56bd6650d89178b313c21bbc997967b4db791ccd69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20040"
      ]
    },
    {
      "uid": "zhcn:f1d9ce8f12cc4a6577b603d6",
      "kind": "character_system_text",
      "source_text": "那么…",
      "source_fingerprint": "dc8b3bbf8422f96e189bd9ae9705736aadf5c9e12b7881060b16d27deea4060e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20041"
      ]
    },
    {
      "uid": "zhcn:832b54fca57fca669699cc9d",
      "kind": "character_system_text",
      "source_text": "呀…",
      "source_fingerprint": "1d1b0cdc14da066d58dfe3b939cf0f73449b37886c84d86b22b3923b42d04d0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20042"
      ]
    },
    {
      "uid": "zhcn:8d26982cda63cd9e0c41e0c8",
      "kind": "character_system_text",
      "source_text": "哎呀…？",
      "source_fingerprint": "55d62764ccc18450bc29a87356c49484cd31be597f6410d65689ef109e2fc74d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20043"
      ]
    },
    {
      "uid": "zhcn:0f47a920fdc076bb6ce38699",
      "kind": "character_system_text",
      "source_text": "一起…",
      "source_fingerprint": "d1cf8179495fb289eabd0217fa3c6e98bab4806a995603bdb060d70b25708b33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20046"
      ]
    },
    {
      "uid": "zhcn:a437ca9ed6f70a87ada03842",
      "kind": "character_system_text",
      "source_text": "好美…",
      "source_fingerprint": "6bf05df74f97ca9a9e38aaac811431ceb39baac2d69b797ed2ef6104b7b302ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20047"
      ]
    },
    {
      "uid": "zhcn:e8effc42fc7b11bb6cfbfebb",
      "kind": "character_system_text",
      "source_text": "正是在您身边才有我们的幸福。",
      "source_fingerprint": "5a6a60a4a024bfe32be9d82037ba8a4984fc3482ab0ce8baed74369f3058386f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20049"
      ]
    },
    {
      "uid": "zhcn:75dd1833f0313bb31aca2536",
      "kind": "character_system_text",
      "source_text": "承蒙关照，非常感谢。",
      "source_fingerprint": "16f08dff13b56cc6eab7a156fba2f9f4c13368ae7f8a61318acbbf52bdbe0863",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3634296cd4381b8adb3b72a3",
      "kind": "character_system_text",
      "source_text": "是的…如果我可以的话。",
      "source_fingerprint": "af037b0c2ec640dc19131fe31a0791400dca5fbf0707ba70dd7431090a7f0639",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "20051"
      ]
    },
    {
      "uid": "zhcn:e1abf5cd108ea1de2f297c12",
      "kind": "character_system_text",
      "source_text": "啊啊…要出来了…！",
      "source_fingerprint": "1b24766b4b5dbfc8d7067501a98df3c0dfb2f510819c16200e2586ce6b4e8713",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "2030"
      ]
    },
    {
      "uid": "zhcn:6e71753f062dfa7a786a1963",
      "kind": "character_system_text",
      "source_text": "最美味的家伙…是我的。",
      "source_fingerprint": "472753229542a3eb5b14beb74d33447b5fa0c7ede12709e07b3dd3bb5bd5baae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "2031"
      ]
    },
    {
      "uid": "zhcn:8a55b0c53aa4d4410e54898b",
      "kind": "character_system_text",
      "source_text": "承蒙关照，非常感谢。",
      "source_fingerprint": "16f08dff13b56cc6eab7a156fba2f9f4c13368ae7f8a61318acbbf52bdbe0863",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "2032"
      ]
    },
    {
      "uid": "zhcn:ee7aee8c974d8c23de2d9e25",
      "kind": "character_system_text",
      "source_text": "啊啊…必须道谢呢。\n因为您邀请我参加了\n佳肴满席的美妙宴会…♪",
      "source_fingerprint": "2f2aed8c5cafb6e21ca780a1cea051de9cb72737e79f43a1b77bfedb5ad5d186",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "2033"
      ]
    },
    {
      "uid": "zhcn:8311525625c8e413611c4efc",
      "kind": "character_system_text",
      "source_text": "今天一定会抑制不住…想要展露\n卑劣丑陋的模样…只有您，\n会接受我吗…？",
      "source_fingerprint": "e1d9823a9ad01d3ac1a10c2fdcdda0cf105d3332fe8be3fff458aade418f9c0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "2034"
      ]
    },
    {
      "uid": "zhcn:3e807231a69ee43d5884e796",
      "kind": "character_system_text",
      "source_text": "承蒙关照，非常感谢。",
      "source_fingerprint": "16f08dff13b56cc6eab7a156fba2f9f4c13368ae7f8a61318acbbf52bdbe0863",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "2035"
      ]
    },
    {
      "uid": "zhcn:96eb7e0872a00d7239cb9d5d",
      "kind": "character_system_text",
      "source_text": "我来了…",
      "source_fingerprint": "d8cd473f45c92a27ecc35ef1018638325f32b3e17271b4d7b8d451388c2d29dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "23015"
      ]
    },
    {
      "uid": "zhcn:3b09e065223bc066e5634e71",
      "kind": "character_system_text",
      "source_text": "嗯！接下来，是打算…吞噬到底呢…",
      "source_fingerprint": "27fb5e7474cbe442c8a7b5a04a14ee7192b2af2d63912ee64d9230a83720ef86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "30000"
      ]
    },
    {
      "uid": "zhcn:8e47f779aedfd3a75cd56a03",
      "kind": "character_system_text",
      "source_text": "腿在颤抖呢…。还想，更狂暴一些吗…？",
      "source_fingerprint": "b5bd66b415e37eda9f24c26c1e76f9a8b6ea21647af8862ac326f055078035cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "30001"
      ]
    },
    {
      "uid": "zhcn:bd801d81f943cf4424e2c16b",
      "kind": "character_system_text",
      "source_text": "简直，还没吃够…！",
      "source_fingerprint": "5ff71c824c525d1dc94427c2c3a8c3cdd25362480608534a495ea0b9f8917b5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "30002"
      ]
    },
    {
      "uid": "zhcn:10eca069d978be2bbd518377",
      "kind": "character_system_text",
      "source_text": "如果那孩子不狂暴的话…就这样吗…？",
      "source_fingerprint": "446815848b4120a598cda117aa92a388d025833a678b68a8b6e247ff9dca6c75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "30003"
      ]
    },
    {
      "uid": "zhcn:3f76394dfaa894890d48d678",
      "kind": "character_system_text",
      "source_text": "美妙的全套大餐…\n直到最后一滴，都享受到了——",
      "source_fingerprint": "7659272617d22921b931299cbe5e93215c60e78ffeec65ac1ffa5f5ebc5b29e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "30004"
      ]
    },
    {
      "uid": "zhcn:dcf11d7d3ff323cef3a6127b",
      "kind": "character_system_text",
      "source_text": "感谢精彩的比赛…甜美的灵魂，多谢款待。",
      "source_fingerprint": "1a1371729a43c9090eb357de29ac7f6821e2f1c234ceb6a1e7f3863711817e23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "30005"
      ]
    },
    {
      "uid": "zhcn:2ed2eaebafe1b20cf3b2a527",
      "kind": "character_system_text",
      "source_text": "忍不住了…！",
      "source_fingerprint": "3600d3dcfb490427dbc8c310bf1b77deec1335b4781d424acc231a2bf2e8f8a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "31000"
      ]
    },
    {
      "uid": "zhcn:84fde8c016c24e8ae85d96c3",
      "kind": "character_system_text",
      "source_text": "给我…！你的全部！",
      "source_fingerprint": "f9182d993230b43f3b2977e4d856df7a657733738d3e8bfb7bba19bb781331f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "40000"
      ]
    },
    {
      "uid": "zhcn:e2f8e4e703fd45e1b8393a27",
      "kind": "character_system_text",
      "source_text": "啊啊…多么美丽…一切…所有…全部…\n好想全部吞噬殆尽…！",
      "source_fingerprint": "48c76e93322b69a6ed08839d4ee6c501cc5a101bba6d8a92f9e3bc3103a7daca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1097",
        "40001"
      ]
    }
  ]
}
