    {
      "uid": "zhcn:2b1ab1a54b8747e9cf5edad5",
      "kind": "character_system_text",
      "source_text": "辛苦了~",
      "source_fingerprint": "8e62298369a4228b477ab0e7181ca53a2ffad7633d7821b0fbd28b7816e94772",
      "source_path": "character_system_text_dict.json",
