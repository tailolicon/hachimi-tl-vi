      "source_text": "すごい、たくさんですね！",
      "source_fingerprint": "aea10fa89f917e085b40d724b004734d9a88065a3ce8ce0657cf32c5c0173c57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
