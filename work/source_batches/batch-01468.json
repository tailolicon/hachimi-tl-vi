    {
      "uid": "zhcn:bfdf0446850cfffd7e9b70b3",
      "kind": "character_system_text",
      "source_text": "Go~☆",
      "source_fingerprint": "7932a4b2da46567d328eeb4811bba547bddeae5f4678b40c6a2061103ddfcf5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
