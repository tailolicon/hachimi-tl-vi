      ]
    },
    {
      "uid": "zhcn:312020e43da94605134b6962",
      "kind": "character_system_text",
      "source_text": "从风水上来看是对手比较有利……\r\n必须设法靠我的表现\r\n改变不好的运势！",
      "source_fingerprint": "858c1404120c4a58c0a6940d42eb2ec9896425e147579b902e3c06834adb553a",
