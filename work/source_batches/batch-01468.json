    {
      "uid": "zhcn:87f7c4d24ee482acff364612",
      "kind": "character_system_text",
      "source_text": "虽然训练进展得不顺利……\r\n但可以靠风水弥补！",
      "source_fingerprint": "780e1369ae7edbe64daea5150a7077b4153dbc5725bfd5f5fa30f8567af973ac",
      "source_path": "character_system_text_dict.json",
