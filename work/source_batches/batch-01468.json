      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30006"
      ]
    },
    {
      "uid": "zhcn:1d66724e46c61df921031ad5",
      "kind": "character_system_text",
      "source_text": "你看！风水很厉害的吧☆",
