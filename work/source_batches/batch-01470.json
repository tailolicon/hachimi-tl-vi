    {
      "uid": "zhcn:a985d676fa5be7529e084c65",
      "kind": "character_system_text",
      "source_text": "上々だな！",
      "source_fingerprint": "a6237884357c7398041cd763c10fc1f43e2cb24b6a2fa634a59a99b2e5ebac05",
      "source_path": "character_system_text_dict.json",
