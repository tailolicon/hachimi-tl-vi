      ]
    },
    {
      "uid": "zhcn:5619aae810ee08c8a6d11b15",
      "kind": "character_system_text",
      "source_text": "ハハッ！",
      "source_fingerprint": "9c1e1df0085ff4af368d1b38f5e4d59356233a942de9c923fe15116f47741b79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140008"
      ]
    },
    {
      "uid": "zhcn:2dc145df1e00ce6f89ba7956",
      "kind": "character_system_text",
      "source_text": "へぇー。",
      "source_fingerprint": "a00aacf07ca740d2f5f07b497b731a126fe5edb39022ce12b9c7e33ff17b6dc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140009"
      ]
    },
    {
      "uid": "zhcn:4fda62f8cf5d8335738c07f9",
      "kind": "character_system_text",
      "source_text": "そーそー！",
      "source_fingerprint": "721b4370ab149672af12f806cd262bcea209e1b793c74ea708d47b75abeca03b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140010"
      ]
    },
    {
      "uid": "zhcn:a87c18b014f8532c1152e702",
      "kind": "character_system_text",
      "source_text": "やりぃ～！！",
      "source_fingerprint": "aa38f2db229057fc1ceeca394e452ec76225cbea8d4fac05a55918650fa98f94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140011"
      ]
    },
    {
      "uid": "zhcn:21e499653ef4b517721f8a43",
      "kind": "character_system_text",
      "source_text": "うお！？",
      "source_fingerprint": "2a140bc572235560340e883c4ce0824c3380ce1a9521e008ab4b82555a151338",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6c65a5226ad1c7d34a2cf6f8",
      "kind": "character_system_text",
      "source_text": "すげーな！",
      "source_fingerprint": "40c6b21860f1c41c5d28f879de276134dbc6652d139af5125f2f771f29683ac7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140013"
      ]
    },
    {
      "uid": "zhcn:d23e7c9cd310989ea49df250",
      "kind": "character_system_text",
      "source_text": "おっと。",
      "source_fingerprint": "d5c945514b64144e14d63b9d375b0e71612c3c084211b5ed5101838cb184c008",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140014"
      ]
    },
    {
      "uid": "zhcn:97f15ddc085e0b1d438a34ca",
      "kind": "character_system_text",
      "source_text": "お～。",
      "source_fingerprint": "87785e14b7780ff16f45d058a9b4579cf740c661bf1ef93e9d7107bdfe188874",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140015"
      ]
    },
    {
      "uid": "zhcn:0aa33319872517c75d59dc5d",
      "kind": "character_system_text",
      "source_text": "どした？",
      "source_fingerprint": "da23d730b30d5f3c0f28b4ddb89d6f2e51705618e98e6791b6d78317f0522d2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140016"
      ]
    },
    {
      "uid": "zhcn:abeb5756e973605871b11ae5",
      "kind": "character_system_text",
      "source_text": "くっ！",
      "source_fingerprint": "340d7ec2761b623270c67dfe3302e368f40827ba1c40260b5c070b1e97f5889f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140017"
      ]
    },
    {
      "uid": "zhcn:ad789b3521be4cc98b736edb",
      "kind": "character_system_text",
      "source_text": "だぁ～。",
      "source_fingerprint": "ac43f4a5ca9c9af57ec8d3272d3c1fd2b5b6ea26a4277950591190e6e28a21a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "140018"
      ]
    },
    {
      "uid": "zhcn:b5bebb1a99e8597ee0689ef7",
      "kind": "character_system_text",
      "source_text": "明日はこれだってよ。",
      "source_fingerprint": "638f68369311f8cc7b3cc5cc76f8dc94b77bd5b4f1f64b570025e57ad3bd8721",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "15"
      ]
    },
    {
      "uid": "zhcn:3e4466230bd3b5850d9ee2fa",
      "kind": "character_system_text",
      "source_text": "休みくれよー！な？な？\r\nいいじゃんかよー。",
      "source_fingerprint": "e3d242a048496d7331e1dc1ed906e80a5181a6155189b7363a70ba4d52fa88e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20000"
      ]
    },
    {
      "uid": "zhcn:31dd3a2c94f993f2dfe0d8b1",
      "kind": "character_system_text",
      "source_text": "あっち向けよ。\r\n…情けねーとこ見せたくねェ。",
      "source_fingerprint": "1a3a5114ee522a9a1acdd423475a7a00fa103484b68e9fb13cfe814f554b3cb4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20001"
      ]
    },
    {
      "uid": "zhcn:4edcd74fc0c6a2ec175d4b6c",
      "kind": "character_system_text",
      "source_text": "遠慮はいらねぇ。なんでも来い。\r\n全部クリアしてやっからよ！",
      "source_fingerprint": "da0eac3f6ade01508ae66f6501e7f36a6f36b75b69164214893b02d389b53670",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20002"
      ]
    },
    {
      "uid": "zhcn:be86aeae4cd5794b460ba662",
      "kind": "character_system_text",
      "source_text": "おら、始めんぞ。\r\n一緒に目指すんだろ、最強！",
      "source_fingerprint": "5058f8267a3b115e338c0bf0e41000a9b4a90fc4dcf4fe908a62fb0a2e7e1195",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20003"
      ]
    },
    {
      "uid": "zhcn:788ff83d90fd17e49469eba2",
      "kind": "character_system_text",
      "source_text": "俺はもっと強くなる。\r\n証明してやろうぜ！",
      "source_fingerprint": "a5318f2973c7e717306e8accf7bb19e74e3ccc8383d0ea9b81e3f9bcf4c55826",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20004"
      ]
    },
    {
      "uid": "zhcn:d95517cc9afdf1bd5a9389e9",
      "kind": "character_system_text",
      "source_text": "周りがビビるくれぇ\r\nすげぇトレーニング、\r\nやってやろうぜ！",
      "source_fingerprint": "2a2f59574cd59afbbb4f44e132c55bce3320ef1a3191969a292292a779b1c951",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20005"
      ]
    },
    {
      "uid": "zhcn:fd06b74173d7fd90645957f5",
      "kind": "character_system_text",
      "source_text": "トレーニング上等！\r\n全部片してやらぁ！",
      "source_fingerprint": "4a5386d9199f4cc9f91550b809eeb9eab98a7e69f0aa90b3274381ef79e21f0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20006"
      ]
    },
    {
      "uid": "zhcn:4eef4097d3c29756ca809422",
      "kind": "character_system_text",
      "source_text": "とにかくおもしれーの頼んだぜ！\r\nタイマンとかチキンレースとか、\r\nそういうのな！",
      "source_fingerprint": "a85cfd41c0223d5eaa3fc901eac49ef1269139ce1cc23068224ee997d76d2f3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20007"
      ]
    },
    {
      "uid": "zhcn:5d1f07cac842af9684d15b82",
      "kind": "character_system_text",
      "source_text": "考えんのはヤメだ。\r\nやってるうちになんとかなんだろ。",
      "source_fingerprint": "8dc27740fc54b4ec22742b68a47b2b6c8548372bd60b7d8328992032e5cf265e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20008"
      ]
    },
    {
      "uid": "zhcn:f5ef732ac740b5a69b7023f4",
      "kind": "character_system_text",
      "source_text": "調子がどーとか、関係ねー。\r\nお前も甘い指導なんかすんなよ…！",
      "source_fingerprint": "1ef71261a068799850c9b4d7d17163f706c60a459191c4e3528572048c6a8e17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20009"
      ]
    },
    {
      "uid": "zhcn:54f6106c01b0861e4504be2e",
      "kind": "character_system_text",
      "source_text": "俺のことは気にすんな。\r\nてめぇのことはてめぇで片つける。",
      "source_fingerprint": "749a0d05b27c6e5087d5d683baa224826383f1ef6cdd9bd1ad0ca86d2b89c40c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20010"
      ]
    },
    {
      "uid": "zhcn:f503ed75671aaa73fba63969",
      "kind": "character_system_text",
      "source_text": "やる気がねーって、大一番でも\r\n言い訳すんのか…ちげーよな。\r\nやるぞ。",
      "source_fingerprint": "e91ecda89638f22259df11870518fad4b5efd69841f0cdac5962fdb2446ed859",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20011"
      ]
    },
    {
      "uid": "zhcn:c3990a25ff50d3f8dee5bc22",
      "kind": "character_system_text",
      "source_text": "ばかすかレース組みやがって。\r\n限度ってもんがあんだろ！",
      "source_fingerprint": "0764f2014471e47b078bf668d795c3b2d177fa238436b3ca94ecccb29a38417a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20021"
      ]
    },
    {
      "uid": "zhcn:d10e1e0f1b3975981308c6ae",
      "kind": "character_system_text",
      "source_text": "どんだけレース走らせんだ…\r\nまだ足んねーか？あ？\r\n答えてみろよ、『トレーナー』。",
      "source_fingerprint": "92a773bc126d53557812dd84417161e0a0a47edf3acc3bebd2bac19a56058eba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20022"
      ]
    },
    {
      "uid": "zhcn:704828081a291cb34327cd44",
      "kind": "character_system_text",
      "source_text": "作戦なんざいらねェ――\r\n俺が勝つ！俺がぶち抜く！\r\nまとめて畳んでやるよ！！",
      "source_fingerprint": "e7f286c340e69d1a40c8dd30fff1f8bc26d79110214f9f33c65abc7084d991b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20023"
      ]
    },
    {
      "uid": "zhcn:8c55cbab9395ce266310bda0",
      "kind": "character_system_text",
      "source_text": "今日の客はラッキーだな。\r\n絶好調の俺が見られるんだぜ？\r\n最強の走り、焼きつけてやんよ。",
      "source_fingerprint": "23aab53c35fc23b0fcf97e8d1a9ff3d6930b8400aaeb9284c109fddf24b8fbb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20024"
      ]
    },
    {
      "uid": "zhcn:2d5cb1520bdbd7fa5ec409a4",
      "kind": "character_system_text",
      "source_text": "おー、おー。どいつもこいつも\r\n殺気立って――へへへッ！\r\nめちゃくちゃ楽しめそーだな！！",
      "source_fingerprint": "7330cadad76ccf1787d1c9b519628fcb12e6bcfdf19946433db0693148af9f3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20025"
      ]
    },
    {
      "uid": "zhcn:8dba7ab4261f406406f4952f",
      "kind": "character_system_text",
      "source_text": "強そうなのがそろってんな。\r\n…ま、俺ほどじゃねーけど。",
      "source_fingerprint": "336f937c8cd24b53bc54fd7550c0e1862331f2f2f91459ed9047353592a54690",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20026"
      ]
    },
    {
      "uid": "zhcn:336fb6d7b7aa67f07a5751b8",
      "kind": "character_system_text",
      "source_text": "ビシッと勝ってくっから。\r\n祝いの言葉、考えとけよ！",
      "source_fingerprint": "1eae0682d53809c4700d1a15fae57ad3113a874a890460f859d3a96e5a242f55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20027"
      ]
    },
    {
      "uid": "zhcn:9bfef2fd9c191778f7ae6ee4",
      "kind": "character_system_text",
      "source_text": "勝つのは当然として、\r\n問題はどう勝つかだよなー。\r\nどうせなら沸かしてーだろ？",
      "source_fingerprint": "44fcb9f8cb5c05f500940e0aa8f4ffa063ae389bac2ad68c1efe8663ad306a78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20028"
      ]
    },
    {
      "uid": "zhcn:3c784a98a7b0a194f5834d04",
      "kind": "character_system_text",
      "source_text": "ヘヘッ、やっと走れんのか。\r\n楽しもうぜ、トレーナー！",
      "source_fingerprint": "bfc4d014233d783ce5702113f35c714ae2d9f290c0afbb4679870129156de3c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20029"
      ]
    },
    {
      "uid": "zhcn:10f95824c1a591c7c3744426",
      "kind": "character_system_text",
      "source_text": "勝ち以外見えねーよ。\r\n安心して待ってな。",
      "source_fingerprint": "01646037a4d82b1d38f2694b41b74454b66e439cbd937e345e34a88ee9ad1ce2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20030"
      ]
    },
    {
      "uid": "zhcn:a353610387a3dae0d2e80b13",
      "kind": "character_system_text",
      "source_text": "ここまで来たら、\r\n俺の全部をぶつけるまでだ。\r\n出たとこ勝負でブッちぎる！",
      "source_fingerprint": "f964aab756188c7f3c9d7c7600ff63a93a7f433d01735ae7d4073afc7760e1e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20031"
      ]
    },
    {
      "uid": "zhcn:e35831a46a3752943f64ccdf",
      "kind": "character_system_text",
      "source_text": "調子なんか気にしても仕方ねえ。\r\nむしろ、いいハンデくれーに\r\n思わねえとな…！",
      "source_fingerprint": "7d9fc01d75be231319194cf65b450f53f56cbf30430e6dbbf4ff708620efb6ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20032"
      ]
    },
    {
      "uid": "zhcn:9b42f780b426b99c90d7b4cb",
      "kind": "character_system_text",
      "source_text": "分が悪いほどおもしれー。\r\n楽しもうじゃねーか！",
      "source_fingerprint": "c0f513a0fa0636ca8793400b2a7e92d6e212f9fdb77585605a73418c9b0635d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20033"
      ]
    },
    {
      "uid": "zhcn:3e8553629ee7c324a3cacedb",
      "kind": "character_system_text",
      "source_text": "具合なんざどうでもいい。\r\nやってやらぁ…！",
      "source_fingerprint": "6ec9caf471ce2c5245284e237a5e4d63b56aca79a206d649414cd42dbb4d9b74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20034"
      ]
    },
    {
      "uid": "zhcn:53605dd240fbe22927b3e7b2",
      "kind": "character_system_text",
      "source_text": "デキは最悪…いいね。\r\nこのくらいのほうが燃えんだよ！",
      "source_fingerprint": "09af634a1379950b3c91fb348cdb68d4c21e0a109eff9b0a4c0313e4583f5a2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20035"
      ]
    },
    {
      "uid": "zhcn:e8e77c2dbfede1aae925f5bd",
      "kind": "character_system_text",
      "source_text": "これより、底はねェからな。\r\nはい上がってやるよ…！",
      "source_fingerprint": "87cd03f6d1e468a5a42e7fc0c76f4badbc2749b7912b4c80421b4e0660f4f9a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20036"
      ]
    },
    {
      "uid": "zhcn:c2ef2c1fb95100693ae1eb13",
      "kind": "character_system_text",
      "source_text": "俺は、どんな時も負けねェ…\r\nそれが最強ってもんだろ…！",
      "source_fingerprint": "378d7381524f31baf10e08de454f53ed1d38ce93f2530f9b6de614a99f0b2eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20037"
      ]
    },
    {
      "uid": "zhcn:dce7ef22f3b79706b339adf9",
      "kind": "character_system_text",
      "source_text": "オラァ！",
      "source_fingerprint": "e922d56195bab46ba110099cf503f665dc40592278a11d62c508680b3a585bbb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9b41dd15bb4b83762c95d09f",
      "kind": "character_system_text",
      "source_text": "おう！",
      "source_fingerprint": "b5b20dbf03c04583c34840757f14deaaf5b7b782796ba7738947d3d5e6d6cf8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20039"
      ]
    },
    {
      "uid": "zhcn:73ed1b92ce35dfddf9a3adff",
      "kind": "character_system_text",
      "source_text": "シャア！",
      "source_fingerprint": "1cdd4c35d3060ecd51190a79379de6e0c0dae93b9bd8d908effaa67cfb471b53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20040"
      ]
    },
    {
      "uid": "zhcn:72aca82db261ceb6f118d138",
      "kind": "character_system_text",
      "source_text": "んー。",
      "source_fingerprint": "0f048f991e93a8a8a6f6f2ed57170c95c129ba53ec8508b4f8ed12946133f5dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20041"
      ]
    },
    {
      "uid": "zhcn:fccdc5854aa5c0fa1c26055d",
      "kind": "character_system_text",
      "source_text": "チッ！",
      "source_fingerprint": "fe07394e88de3a473674048ca76679e705828291ef49059e5ed4085f73a69683",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20042"
      ]
    },
    {
      "uid": "zhcn:31690ac7b61ee0cc4a19b9cc",
      "kind": "character_system_text",
      "source_text": "はぁ？",
      "source_fingerprint": "ac806de19aa427efcec38c886821e4284549eebe89ad843311ae8454e02668dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20043"
      ]
    },
    {
      "uid": "zhcn:3f6a92424e644ce611707a15",
      "kind": "character_system_text",
      "source_text": "行くか！",
      "source_fingerprint": "4971bc4dc6c560ad594688036d477f413545620663404563f13d0bd069ed2a55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20046"
      ]
    },
    {
      "uid": "zhcn:291e9ebe8570a1d70a1be284",
      "kind": "character_system_text",
      "source_text": "ハハッ！",
      "source_fingerprint": "9c1e1df0085ff4af368d1b38f5e4d59356233a942de9c923fe15116f47741b79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20047"
      ]
    },
    {
      "uid": "zhcn:f91e147114bec81030dbfc96",
      "kind": "character_system_text",
      "source_text": "ヘヘッ、悪くねぇな。",
      "source_fingerprint": "74d31fddfb3b6dd63079e5ffde4b59ca02ae4802a692094935d76745bc64bd40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20049"
      ]
    },
    {
      "uid": "zhcn:a0c8b60f9ad18e952b7e5aa5",
      "kind": "character_system_text",
      "source_text": "あー楽しかった！",
      "source_fingerprint": "4fe1d018bfef21e10973db63c3b315a79b8a32e96be64bebfdc2b52cd3f84e35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20050"
      ]
    },
    {
      "uid": "zhcn:060f0fc1608d385f038c46bb",
      "kind": "character_system_text",
      "source_text": "哦，跟我来一下吧。",
      "source_fingerprint": "c1463e2b8c8141787652fae89380b9f1fc1521433ff3b9e54b6f71473415c8a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "20051"
      ]
    },
    {
      "uid": "zhcn:11d7057dcc3e72d7ec1ef8ad",
      "kind": "character_system_text",
      "source_text": "任しとけ！",
      "source_fingerprint": "4d3b7a263ece17766655fe5984b47c303bc95e32b16709bf7d9e28faf78d1a06",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "2030"
      ]
    },
    {
      "uid": "zhcn:96c38ece0d99576258a01489",
      "kind": "character_system_text",
      "source_text": "ま、俺に任せとけって。",
      "source_fingerprint": "947d66144eca5113af0f12f88112a6d8c0eba6386af585907fc98d4bc283efd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "2031"
      ]
    },
    {
      "uid": "zhcn:0bfdb153fa95087968c1b29f",
      "kind": "character_system_text",
      "source_text": "あー楽しかった！",
      "source_fingerprint": "4fe1d018bfef21e10973db63c3b315a79b8a32e96be64bebfdc2b52cd3f84e35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "2032"
      ]
    },
    {
      "uid": "zhcn:8910fd4f9bfeaf7c1c47758e",
      "kind": "character_system_text",
      "source_text": "勝つのは当然として、\r\n問題はどう勝つかだよなー。\r\nどうせなら沸かしてーだろ？",
      "source_fingerprint": "44fcb9f8cb5c05f500940e0aa8f4ffa063ae389bac2ad68c1efe8663ad306a78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "2033"
      ]
    },
    {
      "uid": "zhcn:780bfeb541fe370449be4a02",
      "kind": "character_system_text",
      "source_text": "おー、おー。どいつもこいつも\r\n殺気立って――へへへッ！\r\nめちゃくちゃ楽しめそーだな！！",
      "source_fingerprint": "7330cadad76ccf1787d1c9b519628fcb12e6bcfdf19946433db0693148af9f3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "2034"
      ]
    },
    {
      "uid": "zhcn:7ab0aa02466e9c371d3659c7",
      "kind": "character_system_text",
      "source_text": "あー楽しかった！",
      "source_fingerprint": "4fe1d018bfef21e10973db63c3b315a79b8a32e96be64bebfdc2b52cd3f84e35",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "2035"
      ]
    },
    {
      "uid": "zhcn:0b967e95231487c3646f2688",
      "kind": "character_system_text",
      "source_text": "おう！",
      "source_fingerprint": "b5b20dbf03c04583c34840757f14deaaf5b7b782796ba7738947d3d5e6d6cf8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "23015"
      ]
    },
    {
      "uid": "zhcn:ca130d06fb6b84cb4092e439",
      "kind": "character_system_text",
      "source_text": "やるじゃねーか…次が楽しみだよ！",
      "source_fingerprint": "ec612a00a3b1c741e47e36d307a015fe9a9dca1ab0bb317e16dd322479a0621e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "30000"
      ]
    },
    {
      "uid": "zhcn:cf5c9d42a43741a7e3df7be1",
      "kind": "character_system_text",
      "source_text": "待ってな…すぐ追いついてやんよ！",
      "source_fingerprint": "59975a81b0da011dcc5669dbc3e86b36793375d1abbf96e0d72f32bcc80beb44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "30001"
      ]
    },
    {
      "uid": "zhcn:4f9ecd1f2829eeac8f03a838",
      "kind": "character_system_text",
      "source_text": "まだだ、俺はこんなもんじゃねー！",
      "source_fingerprint": "a9d15d5543fa0a9304cf47e85cd183943925e024e8708684de3c533e931cddd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "30002"
      ]
    },
    {
      "uid": "zhcn:499e810d283ca381e7530b5e",
      "kind": "character_system_text",
      "source_text": "クソ…こんなんで終われっかよ！",
      "source_fingerprint": "328f556308cd81a5594a3fd6d98d8c204a5a027f65c0320cbe77c3cbaf988f56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "30003"
      ]
    },
    {
      "uid": "zhcn:57aeabdda5748886eb813aba",
      "kind": "character_system_text",
      "source_text": "っっしゃあああああっ！！見たか、オラァ！",
      "source_fingerprint": "386f0aaecf4c24a96eeb2b0f939bf1658ac4b3c497c4366d0dd35be100d51358",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "30004"
      ]
    },
    {
      "uid": "zhcn:f3afe18085975e17e26fbef9",
      "kind": "character_system_text",
      "source_text": "ハハッ！最高だな、オイ！",
      "source_fingerprint": "8621211a129dfe9c4e8f4bee38726afeea0e8b52322ba548eeaafc73ce8dc581",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "30005"
      ]
    },
    {
      "uid": "zhcn:470f15984843a54321176beb",
      "kind": "character_system_text",
      "source_text": "おう、行ってくるわ。",
      "source_fingerprint": "c8464ddd056940763001e1e92062bccd9ce8f7c89d754911e491397e55bd144e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "31000"
      ]
    },
    {
      "uid": "zhcn:3920ad13f46ad624778f7cc3",
      "kind": "character_system_text",
      "source_text": "時代なんざ、こじ開ける！",
      "source_fingerprint": "55631f88dd9cb4216c82757b0723e71bd3b07dc89c9e9da3a9b545e049baae69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "40000"
      ]
    },
    {
      "uid": "zhcn:b94d78dca84f763684478dcd",
      "kind": "character_system_text",
      "source_text": "跟我同房的家伙看起来很忧郁，\r\n害我实在是在意到不行啊。\r\n我可要毫不客气地去缠着她啰？",
      "source_fingerprint": "bcc3f96d44da7b2be8273d35d4e31ab3d5b4f5918f53b37d81fd7b71a266efcc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "400003"
      ]
    },
    {
      "uid": "zhcn:4fc1baed22e064c63167180b",
      "kind": "character_system_text",
      "source_text": "虽然不知道是打哪来的家伙……\r\n但竟然敢盯上我的死党，\r\n胆子倒是不小嘛。",
      "source_fingerprint": "8f115b1936974805e84cb13d5a1949bfa3b6211af0101271e5ed0194d2ef979c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "400005"
      ]
    },
    {
      "uid": "zhcn:15073ddb7f9be94d6531682b",
      "kind": "character_system_text",
      "source_text": "你问我想在康乐活动上做什么？\r\n唔～只能是沙滩排球了吧？\r\n把球打出去的感觉超痛快的啊。",
      "source_fingerprint": "24c0367010d6625ebb40be1cf8730fe87718be5c502d7886595a1b466c2a9475",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "400006"
      ]
    },
    {
      "uid": "zhcn:ef2e3fb0d2afa388a51ef787",
      "kind": "character_system_text",
      "source_text": "テッペン獲るまで止まるかよ。どんな扉もこじ開ける！\r\nおらぁぁぁあああっ！俺が！最強だ！！",
      "source_fingerprint": "bd5df4a70fd294a070867438ddbbf19b2aa58f2e6be70a2c4c7e436b22f83840",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "40001"
      ]
    },
    {
      "uid": "zhcn:7545d58aef2a2e318cd98d16",
      "kind": "character_system_text",
      "source_text": "御託はいらねェ。楽しむぞ！",
      "source_fingerprint": "19acae8b930d16a7b4f91b11fa28588d32a2f650af204181093dbd1c4e6b9b28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "60000"
      ]
    },
    {
      "uid": "zhcn:d0282799a5189c9670f57b2d",
      "kind": "character_system_text",
      "source_text": "おうおう、集まってんな。\r\nヘヘッ、かますか！",
      "source_fingerprint": "3d3380dde1935a452126980bee4bbd67682d4444b9cc23cce91aea30eb766a8b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "60001"
      ]
    },
    {
      "uid": "zhcn:3615b7d1495159d51c1ee0c5",
      "kind": "character_system_text",
      "source_text": "目标是最强，也就是巅峰！！",
      "source_fingerprint": "3c7382728fb0d27d570f22277dc6b1d029067c94cd3ebe413fe3bb8590e52346",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "70000"
      ]
    },
    {
      "uid": "zhcn:bb52420ca252d1f1257a15cd",
      "kind": "character_system_text",
      "source_text": "夢見るあんたと、最強の俺。\r\n出会っちまったな～。\r\n運命ってヤツか！？",
      "source_fingerprint": "c8542d0e4ad9dd8a2673fd7648568df16e12092b7a51c76444b4fb68ad1d495d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1094",
        "70001"
      ]
    }
  ]
}
