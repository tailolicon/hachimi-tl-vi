    {
      "uid": "zhcn:77a34475be582f4a98e428a5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "无论状态如何，\r\n我都非赢不可……！\r\n我会努力的！",
      "source_fingerprint": "f98db19f8e8696f9bb2da1070d6e9799b16b43377fdb8627512cb8384b6c257b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
