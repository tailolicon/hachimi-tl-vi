      "json_pointer": "/1099/20032"
    },
    {
      "uid": "zhcn:52524c1e1c1d2acacba2903e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这点程度的逆境，我一定会克服的。\r\n因为故乡还有更大的逆境，\r\n等着我去克服……！",
      "source_fingerprint": "d2fd757effdcb7846fa5e035c1c0696c253d3a4cdb75c92a71b220d636a3f497",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
