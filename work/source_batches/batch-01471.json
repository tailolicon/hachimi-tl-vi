      "json_pointer": "/1099/20030"
    },
    {
      "uid": "zhcn:6b6e72614289a454163afdf8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "为了获胜，我已经和训练员一起\r\n积累了许多努力。\r\n我会用胜利来回报你。",
      "source_fingerprint": "232fb2b540dc00c57d6df2e8209e8e65876ac0bde76bf0a7f771658ac8473831",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
