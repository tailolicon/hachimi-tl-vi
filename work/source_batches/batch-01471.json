    {
      "uid": "zhcn:9b604292d8139414f41aff2c",
      "kind": "character_system_text",
      "source_text": "結構動きやすくってよ。\r\nタイマンもよゆーだ！",
      "source_fingerprint": "d2ac999f8e94a2d6072fbbe2150a6fddcfa30a186d7cd3ded806f09086d235b4",
      "source_path": "character_system_text_dict.json",
