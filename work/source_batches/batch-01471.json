    {
      "uid": "zhcn:5373e9e59c25ba729962037b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "托你的福，\r\n我今天才能以最佳状态上场。\r\n我一定会响应大家的期待！",
      "source_fingerprint": "83a8e476b44d4a881a671dcc8807ed814250445ac598dfc6ce43097ee759bdec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
