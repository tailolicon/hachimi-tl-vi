      ]
    },
    {
      "uid": "zhcn:47c168a00c0d3f20b6d9851a",
      "kind": "character_system_text",
      "source_text": "嘿嘿！",
      "source_fingerprint": "3f9aa2ca2c6d3f4602b2e12434f180c89d1cd84bd8dfd6394bd3df10d2d0608b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140009"
      ]
    },
    {
      "uid": "zhcn:9b4eadd787978176826e2bbb",
      "kind": "character_system_text",
      "source_text": "嗯嗯！",
      "source_fingerprint": "c4c286c02f62355c7d41f684d51a8da2d669df1770b3dc820cfa123a9cd2be1b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140010"
      ]
    },
    {
      "uid": "zhcn:64a047d04f2e5bc441863b3e",
      "kind": "character_system_text",
      "source_text": "太好了！",
      "source_fingerprint": "2deba7ca30c98238317c64bb01282f7578b945b19432461c4536c6681ac4b8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140011"
      ]
    },
    {
      "uid": "zhcn:b42b643edf98474a300606b1",
      "kind": "character_system_text",
      "source_text": "Lucky☆",
      "source_fingerprint": "fce4b74d9ba13fbfa2978ea791de0e9dff9b02fdfaae4121c081d1dfd9d1d603",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140012"
      ]
    },
    {
      "uid": "zhcn:4d50c61bdfe245c1acfdeda5",
      "kind": "character_system_text",
      "source_text": "好厉害好厉害！",
      "source_fingerprint": "fad46d7e87535cf68d1fc1f82588e12fa2e6297ffec4dc45f6b4f028c81f2c2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140013"
      ]
    },
    {
      "uid": "zhcn:e8c96d7853ba690b1801e406",
      "kind": "character_system_text",
      "source_text": "哎呀～",
      "source_fingerprint": "f648cc071d9b560d6eaf438e418b83e701f2beac7368232313cd73d3367099ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140014"
      ]
    },
    {
      "uid": "zhcn:ff5b798bb4d5d6db3cb2c9aa",
      "kind": "character_system_text",
      "source_text": "哼哼。",
      "source_fingerprint": "1354e126adfa2a5953f8f27091c1ee22bfcf9421ee0efd9cf6d07334773e2183",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140015"
      ]
    },
    {
      "uid": "zhcn:b5c8a20314629b0b18942d27",
      "kind": "character_system_text",
      "source_text": "CopaCopa☆",
      "source_fingerprint": "81380c4099274704b873ffd7f128f7bba18167ca1386799a010a37c93f1c2d33",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140016"
      ]
    },
    {
      "uid": "zhcn:ff9b57b5ea6db15d4d7bc02b",
      "kind": "character_system_text",
      "source_text": "哇啊！",
      "source_fingerprint": "79b2e97503c0c49da0799907595a6c55dfb43301636454e613d59bec8fdc2a8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140017"
      ]
    },
    {
      "uid": "zhcn:004f4f696a5f56ecd0579846",
      "kind": "character_system_text",
      "source_text": "不会吧！？",
      "source_fingerprint": "0150349925fa12b492e09d591519bc63cdcfb1ade174a1e788e2fc284d313825",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "140018"
      ]
    },
    {
      "uid": "zhcn:91e250a8f79a3b7100c371ef",
      "kind": "character_system_text",
      "source_text": "明天是这个！\r\n我等着你喔！",
      "source_fingerprint": "e692154ec1391087c3e194bddec6dfef6b48ebb0aa729dc82b8ac1a3ec06513e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "15"
      ]
    },
    {
      "uid": "zhcn:4a08e63a81b810cd95a2ecd2",
      "kind": "character_system_text",
      "source_text": "今天也要Copa地……\r\n奇怪～？\r\n感觉气正在不断……流失……？",
      "source_fingerprint": "7005b08281208fba0a4dc4441a52ecd769d4c56b57a966de2c92fdc1a765feb2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20000"
      ]
    },
    {
      "uid": "zhcn:12566109b16e004c02902393",
      "kind": "character_system_text",
      "source_text": "最近身体感觉很沉重……\r\n不好的气还是尽早斩断比较好……\r\n可以的话，我有点想休息一下。",
      "source_fingerprint": "a09e570ff39c664a221c5d4ec68ff88d90bbeb3adcbb9fe83625f24c63eba7f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20001"
      ]
    },
    {
      "uid": "zhcn:9c6c3c41e0153a7c0766819b",
      "kind": "character_system_text",
      "source_text": "状态绝佳！\r\n训练场所也充满生气！\r\n嗯～！CopaCopa的感觉来啦！",
      "source_fingerprint": "8fe07fd43232392c5a1a8f4c38158027a442e354fd0e7e8354918064e2149787",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20002"
      ]
    },
    {
      "uid": "zhcn:d43db1d12eeda8989bb471b4",
      "kind": "character_system_text",
      "source_text": "按照这个气的流向，\r\n没有我办不到的事情！\r\n来吧！把想做的事情全做一轮！",
      "source_fingerprint": "823dc7383b681db86f8030cece20a7b044b473ffd0d05c58966714d294a36bb5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20003"
      ]
    },
    {
      "uid": "zhcn:b4b758239146763f5edbaf3e",
      "kind": "character_system_text",
      "source_text": "很好。今天的环境\r\n有罗盘挂保证！\r\n训练的效果应该会很不错！",
      "source_fingerprint": "2c62eb7cbed96793a6094ba1e295b439b795e2b72fbb329375510136470bb353",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20004"
      ]
    },
    {
      "uid": "zhcn:664ca48992d231b4c22caa79",
      "kind": "character_system_text",
      "source_text": "干劲充足！运气充足！\r\n今天的训练感觉结果会很happy！",
      "source_fingerprint": "86c1616e2d90631f9431803224dbe71cf76e24935fb39fa88b7c6d5064175b62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20005"
      ]
    },
    {
      "uid": "zhcn:bb22fdc56fa4cc60060f6395",
      "kind": "character_system_text",
      "source_text": "吉与凶──无论风水得出什么结果，\r\n只要配合结果做出相对的努力，\r\n就能开辟道路！",
      "source_fingerprint": "6d463275f08c547481947c48f4360989e3d6b4d71597ec46712dd861435a03be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20006"
      ]
    },
    {
      "uid": "zhcn:131e48ca4b88e856c9f3e2b5",
      "kind": "character_system_text",
      "source_text": "好啦好啦！\r\n要开始Copa地训练啰～☆",
      "source_fingerprint": "8b4fe47a7d9fa72f6be0d1724d6861bc5dd31121bce434cdc8e7b562415c152a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20007"
      ]
    },
    {
      "uid": "zhcn:c335c0cffa594ecb8c67cd3a",
      "kind": "character_system_text",
      "source_text": "唔唔唔……可以晚点再训练吗？\r\n我想先转换心情，\r\n改变不好的运势！",
      "source_fingerprint": "daf9dbb5ad185a467320a6b11480daaab46de7d863ec31b02af96a2f933e4eb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20008"
      ]
    },
    {
      "uid": "zhcn:461a42df5de70959d640ddb1",
      "kind": "character_system_text",
      "source_text": "今天的吉位在那边！\r\n嗯～意思是外出或休息会比较好吗？",
      "source_fingerprint": "00e6048cf02b06fd4feef68e6aa4c4463d4701f00ff6ba80daab7cf7b93b5a83",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20009"
      ]
    },
    {
      "uid": "zhcn:6507edfde9d708bbef1b6a96",
      "kind": "character_system_text",
      "source_text": "怎么会……\r\n好的气、正逐渐脱离身体……",
      "source_fingerprint": "72a01aaddd50ea9d91da42a03caed8342a55ecd51a1c10a3ffcb54f1fc666bfe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20010"
      ]
    },
    {
      "uid": "zhcn:3faf3c9986bbb3dcbd21dbf5",
      "kind": "character_system_text",
      "source_text": "呜呜……即使运势不佳，\r\n应该也能靠行动扭转……",
      "source_fingerprint": "fcdb3ee948b040be26d82ed781e26b46fa95a63ec2cd05a87691f8fe9b5e48d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20011"
      ]
    },
    {
      "uid": "zhcn:f987127c53400c3f8c41baa6",
      "kind": "character_system_text",
      "source_text": "最近会不会太常参加比赛了？\r\n风水也一样，\r\n幸运物放太多是不好的喔。",
      "source_fingerprint": "8dc2e39ef1af2f7f03c9fe1904f432e0822bb9e9b1f804e4f68e735852463626",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20021"
      ]
    },
    {
      "uid": "zhcn:3f7a3750ce01362537414bc7",
      "kind": "character_system_text",
      "source_text": "疲惫会让人流失运气！\r\n差不多该休息一下，\r\n调整状态和气的流向了！",
      "source_fingerprint": "a759dd02ef3f287a76b1ecea3f01ac8a81aaacbf8572158bb11ad2218c826e41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20022"
      ]
    },
    {
      "uid": "zhcn:c5d4981f26387a933cf4571e",
      "kind": "character_system_text",
      "source_text": "我能清楚感觉到──\r\n回绕龙脉的力量流向！\r\n我绝对会拿下这场比赛！",
      "source_fingerprint": "7e71ad3b25e673a26a72ca3715f2188e07fe38270083bf524f77d378c55b1fe1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20023"
      ]
    },
    {
      "uid": "zhcn:cdf19b363064b92faa79fbf5",
      "kind": "character_system_text",
      "source_text": "峦头、理气──\r\n我已经看透这块地！\r\n接下来只需要获胜！",
      "source_fingerprint": "1350953ab5def78be858049058c37766aa908f909e158dc4cf410688948c5948",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20024"
      ]
    },
    {
      "uid": "zhcn:c3e2088b386aaf953fefede6",
      "kind": "character_system_text",
      "source_text": "Rickey☆Lucky☆\r\n快乐的竞赛！训练员，\r\n你要好好看着我喔！",
      "source_fingerprint": "2a69a4224d0c9e508a843387b1eef3d00c7cb6925f00af80bc37669803b03100",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20025"
      ]
    },
    {
      "uid": "zhcn:7439e982cfdba64ed4065599",
      "kind": "character_system_text",
      "source_text": "催吉、化煞──\r\n能做的事情都做了。\r\n嗯，我能赢我能赢！",
      "source_fingerprint": "f324818ce9abedeaa17c7de1e5f660cd27138022342dd0bf53ad6f4780d6c61b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20026"
      ]
    },
    {
      "uid": "zhcn:e887c3c24a4d68f97adf41fd",
      "kind": "character_system_text",
      "source_text": "即使拿对手来做对照，\r\n罗盘算出来的结果也不算坏。\r\n应该能跑出一场精彩的比赛！",
      "source_fingerprint": "a6df1f8c1af330e6b2a9349de6db6164f080eaa1ffddda0243b99f4e3cd29b89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20027"
      ]
    },
    {
      "uid": "zhcn:a09eb5c01f518d6bf28050d1",
      "kind": "character_system_text",
      "source_text": "状态和气的流向都很稳定。\r\n这样应该行得通！",
      "source_fingerprint": "88ec726e2f16aaf296fcef51f990dbefce913565b9be74bbd13de0b09df5caa2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20028"
      ]
    },
    {
      "uid": "zhcn:784e8999a9a9a22458e31210",
      "kind": "character_system_text",
      "source_text": "如果我能获胜，\r\n大家应该会对风水产生兴趣吧！\r\n太好了～！",
      "source_fingerprint": "4b4d6f4163fc611bf01d701fea1b08213295994768ca97755fac92d61c7fb084",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20029"
      ]
    },
    {
      "uid": "zhcn:e5cc43fbb8ec629949b18715",
      "kind": "character_system_text",
      "source_text": "再来只需要按照风水引导出来的\r\n计划奔跑就好。\r\n请你Copa地替我加油吧！",
      "source_fingerprint": "c839b4497a99c453c5af7d8e8ef4b6607e508f82e99a9f8b20fccfd97acc9172",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20030"
      ]
    },
    {
      "uid": "zhcn:2282e42c64c3117971dad929",
      "kind": "character_system_text",
      "source_text": "气的流向已经调整好了！\r\n训练员，我去让大家happy啰！",
      "source_fingerprint": "10c89937a6522364586ade65dc2b52ee73e1df485fb63d9fc1121efdb225e4a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20031"
      ]
    },
    {
      "uid": "zhcn:f29c45ab9d1e262e4d9bb3ae",
      "kind": "character_system_text",
      "source_text": "虽然还有些不安，但我已经尽可能\r\n远离不好的气了……嗯，\r\n运势应该已经有所变化才对！",
      "source_fingerprint": "60beccdb98d16e1a2cdf4e6f769ebf0ad2753161509462f7902fe14dd7555cc1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20032"
      ]
    },
    {
      "uid": "zhcn:d0c732bd1df80e1416fcd097",
      "kind": "character_system_text",
      "source_text": "今天的运气……坦白讲不算好。\r\n必须好好准备迎接挑战！",
      "source_fingerprint": "ddba7ee1274da03820f2988e74ccccd1fce70835f3a7ee28dcceebd914509947",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20033"
      ]
    },
    {
      "uid": "zhcn:2db462a2680c371b734b8036",
      "kind": "character_system_text",
      "source_text": "能克制我的对手也会出赛吗……\r\n拟定战术来应对吧！\r\n我才不会认输！",
      "source_fingerprint": "32e77ca946bb8086c9c7c146616b5ec8846e10148a4964db5e2bd42c6e5ada86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20034"
      ]
    },
    {
      "uid": "zhcn:87f7c4d24ee482acff364612",
      "kind": "character_system_text",
      "source_text": "虽然训练进展得不顺利……\r\n但可以靠风水弥补！",
      "source_fingerprint": "780e1369ae7edbe64daea5150a7077b4153dbc5725bfd5f5fa30f8567af973ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20035"
      ]
    },
    {
      "uid": "zhcn:fcd684bac6d5b4fafd1e5b30",
      "kind": "character_system_text",
      "source_text": "有不好的气在流动……\r\n但我至今累积的经验，\r\n一定会响应我！",
      "source_fingerprint": "47a23d2f3ca7b1eb320f97b171cd284a6ee760822dd6eba446b142f5e70a1660",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20036"
      ]
    },
    {
      "uid": "zhcn:312020e43da94605134b6962",
      "kind": "character_system_text",
      "source_text": "从风水上来看是对手比较有利……\r\n必须设法靠我的表现\r\n改变不好的运势！",
      "source_fingerprint": "858c1404120c4a58c0a6940d42eb2ec9896425e147579b902e3c06834adb553a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20037"
      ]
    },
    {
      "uid": "zhcn:7af2356371adfcf4f6274c87",
      "kind": "character_system_text",
      "source_text": "走吧！",
      "source_fingerprint": "92ae3e5dcae9a53056d19b3106de1996e8c400c410dfd1c96cb651012cfebc4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20038"
      ]
    },
    {
      "uid": "zhcn:b99f795a92ecc4ab6e0774b5",
      "kind": "character_system_text",
      "source_text": "现在就是吉时！",
      "source_fingerprint": "0b50599d093c29cf93c2ecaa912c2f86a4090e85b2373a0cafae14cb961515f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20039"
      ]
    },
    {
      "uid": "zhcn:5428202a29cbc3a22ca67b7b",
      "kind": "character_system_text",
      "source_text": "Go～☆",
      "source_fingerprint": "423584e9a564bbcff21277eb8db64bbb5e2c77448ffa897f12e999ed16c7a429",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "20040"
      ]
    },
    {
      "uid": "zhcn:b84874ec1ef8906f7b1cd1de",
