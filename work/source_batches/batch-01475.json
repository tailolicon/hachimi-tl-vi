      ]
    },
    {
      "uid": "zhcn:bfdf0446850cfffd7e9b70b3",
      "kind": "character_system_text",
      "source_text": "Go~☆",
      "source_fingerprint": "7932a4b2da46567d328eeb4811bba547bddeae5f4678b40c6a2061103ddfcf5f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "23015"
      ]
    },
    {
      "uid": "zhcn:7389a9f2b0519beb61a19ef8",
      "kind": "character_system_text",
      "source_text": "下次我会拿第一！\r\n因为运势正偏向我这里嘛！",
      "source_fingerprint": "738c6418b4556d36a79c7f78baa33b275ed3bd1933d601086dd2a7e5f2105adb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30000"
      ]
    },
    {
      "uid": "zhcn:9c97731e860674ad13b61493",
      "kind": "character_system_text",
      "source_text": "还没完呢！\r\n风水的力量可不只如此！",
      "source_fingerprint": "e8870ee3729eeec21399bcc7790b940a3caa0d5256c68f70500c89e3cfa63165",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30001"
      ]
    },
    {
      "uid": "zhcn:a42b88274c74bab55a6e6f56",
      "kind": "character_system_text",
      "source_text": "我没能完全发挥力量……！",
      "source_fingerprint": "6fcdac5db7f85e4a388dd225a3238e30a36c48ebee62a6bfc2db1126b00e2ffd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30002"
      ]
    },
    {
      "uid": "zhcn:ab50fd6d372bd6b8737fb40c",
      "kind": "character_system_text",
      "source_text": "我听不见「声音」……",
      "source_fingerprint": "eafede72cc2dd090528b9f678ac8a9fc8822aa4779a68e4eba8fd2a6f71734f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30003"
      ]
    },
    {
      "uid": "zhcn:dac2f2618e563afffb53f437",
      "kind": "character_system_text",
      "source_text": "最棒的地势与最强的运气！\r\n我早知道我一定会赢！",
      "source_fingerprint": "d9ba271593ab56cc34dafd0c5a677157f64a01daa7a2f4af32b62cb45e82dce7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30004"
      ]
    },
    {
      "uid": "zhcn:2a037083d9d5233c84fb8167",
      "kind": "character_system_text",
      "source_text": "你看，风水很厉害吧☆",
      "source_fingerprint": "463ae8f3cccb737465ea3bb4e7d244a10dd73ceeef5f55516cb8cbef0e5ff281",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1098",
        "30005"
      ]
    },
    {
      "uid": "zhcn:4a3f6196fb8efd76ab15e836",
      "kind": "character_system_text",
      "source_text": "这是开运的旋律！\nRickey☆Lucky☆Harmony☆",
