      ]
    },
    {
      "uid": "zhcn:49c1d20923b275d4c1e6f08c",
      "kind": "character_system_text",
      "source_text": "一起提高运势吧！",
      "source_fingerprint": "726505059c3cd3a5a79fa5a6b0f35e756c626272a1d3bcc0cbb8187b717ad681",
