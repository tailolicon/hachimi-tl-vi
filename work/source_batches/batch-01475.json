      "kind": "character_system_text",
      "source_text": "运势不错！",
      "source_fingerprint": "fc335cb160e0b9fd2ee495228d706092d4d9fa4cc90322108e1dee5423fe1489",
      "source_path": "character_system_text_dict.json",
