    {
      "uid": "zhcn:fba27115e7150c4eb479ff16",
      "kind": "character_system_text",
      "source_text": "唔嗯嗯。",
      "source_fingerprint": "9d569469611384854219d320bbeea379e5d68a4ecff8aa8c34b3698b8156be6f",
      "source_path": "character_system_text_dict.json",
