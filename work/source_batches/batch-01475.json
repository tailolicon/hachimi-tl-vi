      ]
    },
    {
      "uid": "zhcn:f8b36ab9b00e7896cad39260",
      "kind": "character_system_text",
      "source_text": "Rickey☆Lucky☆\r\nHappy的竞赛！训练员，\r\n你要好好看着我喔！",
