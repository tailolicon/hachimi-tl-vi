    },
    {
      "uid": "zhcn:161ac0ef546fbfacab79e0a2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "そら！",
      "source_fingerprint": "701099fe9604d59ecc3b35d187611ee55942fe64a465ae1e2884d4d24e8a1e75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
