    {
      "uid": "zhcn:09fedca1d53c024a907f4645",
      "kind": "character_system_text",
      "source_text": "Rickey☆Lucky☆\r\n换衣服啰！",
      "source_fingerprint": "b198fcadad29711f62c215cbbb0bc1af0edb130140d6426ef2ac899ba3666518",
      "source_path": "character_system_text_dict.json",
