        "1102",
        "60001"
      ],
      "json_pointer": "/1102/60001"
    },
    {
      "uid": "zhcn:cda1ce23d0e0dd7914379b16",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "さあコンチェルトを奏でよう！",
      "source_fingerprint": "6b88169a216f92f1852d724191fa9bfa87c21f112f80d6f28d3765a146fa6d50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
