    {
      "uid": "zhcn:183754ed919f6c2742f80f99",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "音を纏う気分だ…ライブを感じるよ！",
      "source_fingerprint": "d3b7a8acd3ba785d6ddbfb974fba8c0570e6ff301dc9db33fe2a9b6a306f3e96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
