    },
    {
      "uid": "zhcn:8a726cb22097dc83ebabf74f",
      "kind": "character_system_text",
      "source_text": "好耶，成功了！",
      "source_fingerprint": "5f9587c4f2c554037e177704d3cd155b82e6784134f6fe0632f7488db4e4e469",
      "source_path": "character_system_text_dict.json",
