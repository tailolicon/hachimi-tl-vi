      ]
    },
    {
      "uid": "zhcn:a465e46becd9ffb4fe9d4f73",
      "kind": "character_system_text",
      "source_text": "真是可惜啊……",
      "source_fingerprint": "8e094df2bf184fa929e4d180ef01ce7f513ff52c43a9ad40b51a7be3675f6a53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140005"
      ]
    },
    {
      "uid": "zhcn:c965790951b3cedffc827290",
      "kind": "character_system_text",
      "source_text": "你做到啦！对吧！",
      "source_fingerprint": "4759a9b1a15af736f7d6955f389d0af4949bbc00d7550de928f0e73f4fa5e7e8",
      "source_path": "character_system_text_dict.json",
