      ]
    },
    {
      "uid": "zhcn:95b7e1ad90aea8c71f6a7da4",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140009"
      ]
    },
    {
      "uid": "zhcn:d480062fd3f5b48918c6337b",
      "kind": "character_system_text",
      "source_text": "嗯嗯。",
      "source_fingerprint": "c0dad597dc82a31dd69060476ba8d5a0bc081bd7005ed6641f89ca6ade33857a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140010"
      ]
    },
    {
      "uid": "zhcn:991d7af8be60f3f5db7788e1",
      "kind": "character_system_text",
      "source_text": "好厉害！",
      "source_fingerprint": "c922c5de8a35921e2086ab355870227069194ca65614c757deb698452d7f0151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140011"
      ]
    },
    {
      "uid": "zhcn:f6d109a7216e438108a1e3a6",
      "kind": "character_system_text",
      "source_text": "好机会！",
      "source_fingerprint": "54ec1da823f0c87f6074881d473031b6d90dc8b4228f9b688360c7982332f97f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140012"
      ]
    },
    {
      "uid": "zhcn:83c777074b58001617c47b44",
      "kind": "character_system_text",
      "source_text": "啊啊，拜托不要掉下去！",
      "source_fingerprint": "f2f0e8553765440a0ebc7f0a31dfc7b703fdd44bc2f7106fc8d345dbcd695a89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140013"
      ]
    },
    {
      "uid": "zhcn:ddc3f4fbb720bed3332c6026",
      "kind": "character_system_text",
      "source_text": "啊呜！",
      "source_fingerprint": "94cf97b2aac56a083ec9515264c379389bfd41229b5c3d971df3d74863b37a70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140014"
      ]
    },
    {
      "uid": "zhcn:ac20058f80da26cbddfff6de",
      "kind": "character_system_text",
      "source_text": "轻轻地……",
      "source_fingerprint": "8384550c41e539b4a5bf03f4ce75beaa85c2ff9c1afc980e3e1b8ea2be3f03bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140015"
      ]
    },
    {
      "uid": "zhcn:ec71ca1d7efd6fcefa33b660",
      "kind": "character_system_text",
      "source_text": "好了，上吧！",
      "source_fingerprint": "977b5682ab8701c6a750e42106cf5d73658606961aa7d8e87a4a0a0e4794ff16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140016"
      ]
    },
    {
      "uid": "zhcn:d014c4ba20049cdee8ee9fe2",
      "kind": "character_system_text",
      "source_text": "哎呀！",
      "source_fingerprint": "4d27fba32b4cdf632760230caaf4b4d14ee3299721f6e4c735d9a42b03bba61e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140017"
      ]
    },
    {
      "uid": "zhcn:095740c0b239f1fd52d906df",
      "kind": "character_system_text",
      "source_text": "唔──",
      "source_fingerprint": "772b462aadcabf0829cccbfdf4b07e0ef0d990b48ef434b35231f43b37d45d5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "140018"
      ]
    },
    {
      "uid": "zhcn:fc02475b51bede05a050d2c2",
      "kind": "character_system_text",
      "source_text": "明天可以拿到这个呗☆",
      "source_fingerprint": "808f39aad9507ecc163b1974572773894c117c8c4e408ec90fe390ff24cce04c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "15"
      ]
    },
    {
      "uid": "zhcn:e7fa9a794bfa7229931c89d9",
      "kind": "character_system_text",
      "source_text": "虽然有点疲惫……\r\n不，我会加油的……！",
      "source_fingerprint": "9f98bd1d8d0da9a9ac1acbf06e6e7f36a929b234e7f2e2dd446a5bd92ac0b179",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20000"
      ]
    },
    {
      "uid": "zhcn:08ce8993716dc9263fb8fa7b",
      "kind": "character_system_text",
      "source_text": "真、真奇怪……\r\n感觉就像晕船一样，\r\n头晕目眩的……",
      "source_fingerprint": "cb6a352499b7464f2b56f808c7da0dc17650a1d18328c0cf19b5a34c84aaaae4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20001"
      ]
    },
    {
      "uid": "zhcn:1b9b66962b231b64fd76eb58",
      "kind": "character_system_text",
      "source_text": "我要用我的表现发扬苫小牧……！\r\n不论是多么辛苦的训练，\r\n都尽管来吧！",
      "source_fingerprint": "a7f835c051aa9885b8b6eca63f12ad1d91267e794d89d1e8186f048843a440aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20002"
      ]
    },
    {
      "uid": "zhcn:3e3015b383762ddfd1bc4448",
      "kind": "character_system_text",
      "source_text": "啊～苫小牧，\r\n白色的大地，纸片纷飞……♪\r\n啊，我心情一好就忍不住……！",
      "source_fingerprint": "a2e006cc91f58ec3cf2341dd299476c50aaae96955d2deccb8427b7cda450935",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20003"
      ]
    },
    {
      "uid": "zhcn:cceb58cdac6f184bec79bb6a",
      "kind": "character_system_text",
      "source_text": "我感觉心里的开关已经\r\n确实被「打开」了。\r\n应该能跑出不错的表现！",
      "source_fingerprint": "a068dcd1a453bdbbbc4d55cede6bc1a5755189fff16156c670e7023c8be9c46d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20004"
      ]
    },
    {
      "uid": "zhcn:6720ed0aa40f0487df7c6be8",
      "kind": "character_system_text",
      "source_text": "如果想实现目标，\r\n就少不了专家的计划！\r\n训练员，告诉我这星期的行程吧！",
      "source_fingerprint": "45648406fce72f69602687d9306977347919d489e425655020e3563fe9bee58a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20005"
      ]
    },
    {
      "uid": "zhcn:73796ed85e698cc1337ee19d",
      "kind": "character_system_text",
      "source_text": "「行动则成，不行动则不成，\r\n凡事皆同」！\r\n今天也要持续朝目标迈进！",
      "source_fingerprint": "4aabd890d9383a64754bdda07d52aff94896a47a2114e7e263f42f2e2a795aa1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20006"
      ]
    },
    {
      "uid": "zhcn:5f7ac6f5673d1e3d5dc6ebb8",
      "kind": "character_system_text",
      "source_text": "我的状态没有问题。\r\n因为我今天早上和中午\r\n都有吃蓝靛果补充营养！",
      "source_fingerprint": "4002926ad57241f76f4eda278e789c5de8f54026f7be3afd08d3e624ac07fd5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20007"
      ]
    },
    {
      "uid": "zhcn:dbc059441657afe260247457",
      "kind": "character_system_text",
      "source_text": "感觉今天一直无法集中精神……\r\n啊～真是的！专心、专心……！",
      "source_fingerprint": "e60470d3d6b78a9709e2c75a59b1157a453b4985b3add4f03c9ef511ea5a5b0f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20008"
      ]
    },
    {
      "uid": "zhcn:38279cd4162091541606eada",
      "kind": "character_system_text",
      "source_text": "无法打起精神……\r\n既然如此……只好切换成工作模式！\r\n侬要全力……加油呗！",
      "source_fingerprint": "8c1e7c5ba74a4a4392a7ff8e21e3610a05caeb25a89c5d89e1773d23e2b3571e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20009"
      ]
    },
    {
      "uid": "zhcn:9c455c13d3a73ac0d29ce68e",
      "kind": "character_system_text",
      "source_text": "状态不太好呢……这种时候，\r\n就要靠自制的苫小牧写真集\r\n补充活力……！",
      "source_fingerprint": "9a37ee1af6f43d1dd96242489ade7abaf2e69c4622e5334ffee914fa22f22b50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20010"
      ]
    },
    {
      "uid": "zhcn:fb85e80f238047bbbca9fd36",
      "kind": "character_system_text",
      "source_text": "为了苫小牧，我现在明明应该努力\r\n挑战更高的目标的……\r\n我真是没用……",
      "source_fingerprint": "41c59c630e7e71449ece79cc4ba695a5db0b8e5e409a465f377d5484f9c8b0f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20011"
      ]
    },
    {
      "uid": "zhcn:6606d55915b841b94ef4f326",
      "kind": "character_system_text",
      "source_text": "即使短期间内能靠意志力来弥补，\r\n但勉强自己还是会在后续留下\r\n影响的……这点在工作上也一样。",
      "source_fingerprint": "407c5e561ef48ff4606793ddce35c7ab4f488ebea9771f7b2a5086eb6a30aa1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20021"
      ]
    },
    {
      "uid": "zhcn:bff6ec87e28e5aa092f1f4bf",
      "kind": "character_system_text",
      "source_text": "……我不认为只要一直拼命\r\n挑战比赛就能获得成果。\r\n……应该要重新调整计划。",
      "source_fingerprint": "20a30d61a26fe58458dc577b6c4f5a2f6b77a9f49a31b4141063bd459fd5e2b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20022"
      ]
    },
    {
      "uid": "zhcn:5373e9e59c25ba729962037b",
      "kind": "character_system_text",
      "source_text": "托你的福，\r\n我今天才能以最佳状态上场。\r\n我一定会响应大家的期待！",
      "source_fingerprint": "83a8e476b44d4a881a671dcc8807ed814250445ac598dfc6ce43097ee759bdec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20023"
      ]
    },
    {
      "uid": "zhcn:e525933ed611580dfd3c3e32",
      "kind": "character_system_text",
      "source_text": "为了让大家对苫小牧留下深刻的\r\n印象，我必须以精彩表现拿下胜利。\r\n现在的我……一定办得到！",
      "source_fingerprint": "d315821f2cf4e1574bbdd5d7599d3a86a26a0aeba73717d1a930805a69cc95e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20024"
      ]
    },
    {
      "uid": "zhcn:52cd8948d2b1ec037ca32493",
      "kind": "character_system_text",
      "source_text": "无论是作为地方偶像、\r\n苫小牧观光大使，还是参赛选手……\r\n现在的我都是无敌的！",
      "source_fingerprint": "5c8557ee265ee3671c542782710a26ab853c2ff61ac98b9c829cfcbd37b5127a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20025"
      ]
    },
    {
      "uid": "zhcn:be817e838b47ffd3ef528550",
      "kind": "character_system_text",
      "source_text": "这双由苫小牧孕育出来，\r\n经过训练员锻炼的脚……\r\n是不会输给任何人的。",
      "source_fingerprint": "bc83bde5a9158e629933845ba6d065d85c74d13bbbb12dae6b954747cf400e4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20026"
      ]
    },
    {
      "uid": "zhcn:863b06d6530eb50f8082437a",
      "kind": "character_system_text",
      "source_text": "目标是第一名，还有C位！\r\n我要让大家在回去前\r\n都能记住苫小牧的光辉。",
      "source_fingerprint": "b4ebfbfb18b0ae8bfa146dcf34012e94282208d4f963bee37dc613088fa63f0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20027"
      ]
    },
    {
      "uid": "zhcn:dd64c216aa963402bebb71c7",
      "kind": "character_system_text",
      "source_text": "无论跑步或演唱会，状态都调整得\r\n很完美……这样就能尽情宣传了。\r\n再来只剩专心取胜！",
      "source_fingerprint": "e5c6bd232aa5ddea6118b79093a2013ae9d9ab1effe1a2dc2c989257e412fced",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20028"
      ]
    },
    {
      "uid": "zhcn:fdf9e12a37d4d8ac15bc120a",
      "kind": "character_system_text",
      "source_text": "故乡的大家，\r\n一定都在看着我。\r\n我绝对……会拿下胜利！",
      "source_fingerprint": "6e0310f54c82a9d8e3faeec558106e3f1976124fb266be319d1a86b94c53430a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20029"
      ]
    },
    {
      "uid": "zhcn:62001312cf264eebf75fe651",
      "kind": "character_system_text",
      "source_text": "侬是苫小牧的候鸟，火山☆\r\n……为了今天的演唱会想的招呼词，\r\n我不会让它白费的！",
      "source_fingerprint": "b0bc8b7687c1ba7a320583826f21c7bf7cabf8560e6099b0f0dfca6d26bff7e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20030"
      ]
    },
    {
      "uid": "zhcn:6b6e72614289a454163afdf8",
      "kind": "character_system_text",
      "source_text": "为了获胜，我已经和训练员一起\r\n积累了许多努力。\r\n我会用胜利来回报你。",
      "source_fingerprint": "232fb2b540dc00c57d6df2e8209e8e65876ac0bde76bf0a7f771658ac8473831",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20031"
      ]
    },
    {
      "uid": "zhcn:77a34475be582f4a98e428a5",
      "kind": "character_system_text",
      "source_text": "无论状态如何，\r\n我都非赢不可……！\r\n我会努力的！",
      "source_fingerprint": "f98db19f8e8696f9bb2da1070d6e9799b16b43377fdb8627512cb8384b6c257b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20032"
      ]
    },
    {
      "uid": "zhcn:52524c1e1c1d2acacba2903e",
      "kind": "character_system_text",
      "source_text": "这点程度的逆境，我一定会克服的。\r\n因为故乡还有更大的逆境，\r\n等着我去克服……！",
      "source_fingerprint": "d2fd757effdcb7846fa5e035c1c0696c253d3a4cdb75c92a71b220d636a3f497",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20033"
      ]
    },
    {
      "uid": "zhcn:54e512c87f342ae9509e7f8c",
      "kind": "character_system_text",
      "source_text": "这种时候，苫小牧的大家\r\n一定会叫我不要勉强吧……\r\n但唯独今天，我必须勉强自己！",
      "source_fingerprint": "0d0afe6da8a757a963be53e1990b0c09b8952293147515c361a336d4c6420867",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20034"
      ]
    },
    {
      "uid": "zhcn:275321b88a1932272085d523",
      "kind": "character_system_text",
      "source_text": "虽然有点不安……但我不会气馁。\r\n……为了回应苫小牧的大家，\r\n我会奋战到最后！",
      "source_fingerprint": "8d4ea75e6bc7ccb103658fcf23921b500e62ed98fd26e582711fa3b8d69c4b62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20035"
      ]
    },
    {
      "uid": "zhcn:b990a7b0987817d1a8b1b4e7",
      "kind": "character_system_text",
      "source_text": "虽然状态调整得不太顺利……\r\n但我会赢。因为我的胜利，\r\n不只是为了我自己……！",
      "source_fingerprint": "7637fae53e16fb3c20944b956e4d9c1f14484ea4256824dba74d70a829a2a383",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20036"
      ]
    },
    {
      "uid": "zhcn:74d399d6c59666ecb87f242a",
      "kind": "character_system_text",
      "source_text": "坦白讲，我的状态不太好……\r\n但如果这时候演出逆转戏码，\r\n一定很有宣传效果……！",
      "source_fingerprint": "3fb97a2881bd972e53aca7f42d45f1ca5d74a6842b1ae982568b6c817e591c0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "20037"
      ]
    },
    {
