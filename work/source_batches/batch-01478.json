      ]
    },
    {
      "uid": "zhcn:e985d528bae86888892d3f83",
      "kind": "character_system_text",
      "source_text": "好耶，成功了！",
      "source_fingerprint": "5f9587c4f2c554037e177704d3cd155b82e6784134f6fe0632f7488db4e4e469",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140007"
      ]
    },
    {
      "uid": "zhcn:db67a3481e358f2debc11f91",
      "kind": "character_system_text",
      "source_text": "嘿嘿。",
      "source_fingerprint": "6d0212cb1ec9201ff17e6acf0ea2d70e06cf290b6bc356f0e84aed5329a8a9e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140008"
      ]
    },
    {
      "uid": "zhcn:562c0c0b8d2abefecc77e86d",
      "kind": "character_system_text",
      "source_text": "哦。",
      "source_fingerprint": "6f7dc1b09e1037d9a7a4e058ea6ea6b489a832214825775418cd382fb3ce90eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140009"
      ]
    },
    {
      "uid": "zhcn:e34fe5fe3e899048b680998c",
      "kind": "character_system_text",
      "source_text": "专心专心！",
      "source_fingerprint": "ed14624dcca7daed1e81b52f15ac3dc5c00b959f9860905466365811b16cbb2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140010"
      ]
    },
    {
      "uid": "zhcn:393469bc9e9fa7f6f1d2a7af",
      "kind": "character_system_text",
      "source_text": "好机会──！",
      "source_fingerprint": "2865ed881bb8fd51d71b9cc9e7c4144d3109098e5673a060a0565696eac43d71",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140011"
      ]
    },
    {
      "uid": "zhcn:8ad4d40f7647f6c5ca348f02",
      "kind": "character_system_text",
      "source_text": "真好运～！",
      "source_fingerprint": "47fcce901443f146ce8a608e3c7ec513ac5e1d958504650f37a9aa89b865bd41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140012"
      ]
    },
    {
      "uid": "zhcn:8b34058f72a2e5a7ad7ba01e",
      "kind": "character_system_text",
      "source_text": "好耶，上钩了！",
      "source_fingerprint": "94be8a30556e649f41905f50c504bafe5e7b1b2d16eec5a243fffff4210e7380",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140013"
      ]
    },
    {
      "uid": "zhcn:e2accc45e7cc8ef24e5a40d9",
      "kind": "character_system_text",
      "source_text": "啊啊……",
      "source_fingerprint": "67d0eeceded72eace8823cc24b753a0a3007c8ea0e0a4fc8073e9cf559b5eb03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140014"
      ]
    },
    {
      "uid": "zhcn:21b2a92646ce275702c9cb40",
      "kind": "character_system_text",
      "source_text": "呼……",
      "source_fingerprint": "859051e831aa125febaf30affc00b2a41c40ac4b8d2ac6c3e681bad9b0d37a18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140015"
      ]
    },
    {
      "uid": "zhcn:3d78fc480a5f35f677589531",
      "kind": "character_system_text",
      "source_text": "怎么了？",
      "source_fingerprint": "8b931cbbc5ff834d619d16792036706cc06f14cf1a2024230235d3263006af89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140016"
      ]
    },
    {
      "uid": "zhcn:228ff69e6d6ba79c1f418042",
      "kind": "character_system_text",
      "source_text": "嘎啊──！",
      "source_fingerprint": "76abf89e5369c44d2d365716d2554de9714eb85ff68123d057b14c185301c091",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140017"
      ]
    },
    {
      "uid": "zhcn:f23d8fae65fdcda097fa6669",
      "kind": "character_system_text",
      "source_text": "别在意！",
      "source_fingerprint": "8fcb72cdf28cdf4adeecddf965e32cd7b596eb99e727da26f7ef27d5ae7d4d10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "140018"
      ]
    },
    {
      "uid": "zhcn:0d9284cecacc081748522150",
      "kind": "character_system_text",
      "source_text": "听说明天的奖励是这个喔！",
      "source_fingerprint": "7340d91123cfdcbd1efaadd771712fb8238e23535c72ee6dac3ed272bafea809",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "15"
      ]
    },
    {
      "uid": "zhcn:ebc2cbb8663c95daf0b212e3",
      "kind": "character_system_text",
      "source_text": "身体真沉重哪……\r\n要不要稍微休息一下？",
      "source_fingerprint": "175d6b2b3f91f09bc34cc411cf44f9acfbc81a95736432f4b49c97e4a66d12f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20000"
      ]
    },
    {
      "uid": "zhcn:68144c02405b6f8ca4ec3dce",
      "kind": "character_system_text",
      "source_text": "嗯唔呜呜呜……！\r\n啊啊～使不上力……！\r\n看来疲劳还没完全消除……",
      "source_fingerprint": "bcdeb557ad41bfd7ac659c66788ca49d1a8ce8982ae849216fd6e2a7532f6ed9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20001"
      ]
    },
    {
      "uid": "zhcn:e2f3ef312747148705b2e47a",
      "kind": "character_system_text",
      "source_text": "今天的我状况绝佳！\r\n不论什么训练我都奉陪到底！\r\n看我三两下就轻松完成！",
      "source_fingerprint": "75b1685b2ebcf4c64d41bfb3923151678cc04defb0806da7208fe2913fb5f39d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20002"
      ]
    },
    {
      "uid": "zhcn:ee11270fe477402f5d1b3e62",
      "kind": "character_system_text",
      "source_text": "心情好到极点啦！\r\n我要在训练中展现王牌的气魄！\r\n开始啰！",
      "source_fingerprint": "5fb713a640bef38d9f66d5018ac59de2487e53fc591b874f32a4d882f7925186",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20003"
      ]
    },
    {
      "uid": "zhcn:9bdd4942003f6eab543b0a70",
      "kind": "character_system_text",
      "source_text": "很好，今天感觉还不错！\r\n帮我安排些有挑战性的训练项目吧！\r\n我想尽情地流一身通体舒畅的汗！",
      "source_fingerprint": "e84a866efb394920d3dc26572542c5e828a3aaf89dbdcc79e43be48334e2a213",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20004"
      ]
    },
    {
      "uid": "zhcn:278c2273263f4c5aa96ec4a0",
      "kind": "character_system_text",
      "source_text": "哼哼哼～！……哎呀，\r\n状况不错我就会忍不住哼起歌啦。\r\n这可不代表我不认真哦？",
      "source_fingerprint": "783be45830e7c9a2c2b9d1c7d962378ea84aa448f9a1bc186c44d3bb8b283e4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20005"
      ]
    },
    {
      "uid": "zhcn:b6b294f1223d094f460d8d24",
      "kind": "character_system_text",
      "source_text": "状况算是普普通通吧。\r\n我可以先去稍微小跑一下，\r\n让身体暖起来吗？",
      "source_fingerprint": "12acd0a27acdb512cea5126c4f03c815fd399130714db010ea1055df1781df7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20006"
      ]
    },
    {
      "uid": "zhcn:9f68e0c9f4e83ca5e1af60cc",
      "kind": "character_system_text",
      "source_text": "嗯～状况说不上很好，\r\n但也不坏就是了。不过那不重要啦！\r\n我们快点开始吧。",
      "source_fingerprint": "ff841bdbb61ada795c8aa4faa7fc32fac5d3c4f96a73379b74b8bac9e71119ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20007"
      ]
    },
    {
      "uid": "zhcn:371e6cbd03fc25044a3889f1",
      "kind": "character_system_text",
      "source_text": "训练员，你如果状况不太好时，\r\n都会怎么做？……没有啦，\r\n我没什么特别的意思……",
      "source_fingerprint": "35bdc0f7172a067629008e474fe1386ba892fccb48f26724952d9b4c913100a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a83033208a09bb390834228d",
      "kind": "character_system_text",
      "source_text": "嗯嗯……提不起干劲……\r\n明明都已经用超冰的水\r\n洗过脸了……嗯……",
      "source_fingerprint": "cfd1183de4f99ceb1248b96d53f88d211d0a36004d079f45775c633ef3affc68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20009"
      ]
    },
    {
      "uid": "zhcn:414996778272b99e23cdc25c",
      "kind": "character_system_text",
      "source_text": "……可恶，身体不听使唤。\r\n内心火苗也很微弱……不行不行，\r\n怎么能受这些小事影响……！",
      "source_fingerprint": "2295531b4e2ef54131c0aa95edf822da740a0f5c95a1f322cd5ae5e59c92965a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20010"
      ]
    },
    {
      "uid": "zhcn:d46824c95dd8539774019617",
      "kind": "character_system_text",
      "source_text": "…………啊，别误会！\r\n刚刚我不是在装死啦……\r\n只是发呆了一下……",
      "source_fingerprint": "59aad1133409f765e639aa52e7049853542f1f117e5404a5e8be39fbac815499",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20011"
      ]
    },
    {
      "uid": "zhcn:9bceaa83c84e00def77c77f7",
      "kind": "character_system_text",
      "source_text": "喂喂，又要比赛啊！？\r\n我知道你很有干劲啦……\r\n但我可不想太乱来喔。",
      "source_fingerprint": "2f0a7a2eb718bdb8bfa30bae701458d4fa6d6826fe226bb0f7d9fd608b457cb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20021"
      ]
    },
    {
      "uid": "zhcn:23684b493330baad2b2ac1d8",
      "kind": "character_system_text",
      "source_text": "喂，你是不是太焦急啦？\r\n努力可不等于乱来喔。\r\n听好了，严禁乱来！",
      "source_fingerprint": "ee523124949a3f31a49b3ff1b3d45a69515f799b94b8ad8440b95edcef082b6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20022"
      ]
    },
    {
      "uid": "zhcn:11822efaee00bc458a32ca1d",
      "kind": "character_system_text",
      "source_text": "心情绝佳！\r\n出发吧，我要让所有人见识到\r\n将赢得今天比赛的王牌跑法！",
      "source_fingerprint": "f613c478e4f9d852f0376312239d79b663535a27359cb48ed1f268709b10e18a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20023"
      ]
    },
    {
      "uid": "zhcn:ed5f020180a1d1f2d4b2ff11",
      "kind": "character_system_text",
      "source_text": "一股无与伦比的力量\r\n在我体内涌现了出来……！\r\n我这就去向众人展现王牌的背影啦！",
      "source_fingerprint": "f14d6177a220e3e9acf5450194dc1917366fe8808c22dd9c1f6b5821ed0516ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20024"
      ]
    },
    {
      "uid": "zhcn:263fe6c3603ef142a14d3b20",
      "kind": "character_system_text",
      "source_text": "无论对手有多强我都求之不得！\r\n肉体和心灵都在熊熊燃烧……\r\n让我恨不得立刻就大显身手一番！",
      "source_fingerprint": "7daa9ad42e8af9910182216faafa93fe716796b578b6d8c57c514a95e7fc6f26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20025"
      ]
    },
    {
      "uid": "zhcn:0665a81d01d4d2296dd9aa18",
      "kind": "character_system_text",
      "source_text": "状态调整得很好！\r\n接下来就只待释放这股\r\n沸腾已久的斗志了！",
      "source_fingerprint": "ddf6271349cf24c134749617433a5e523de888e17e63266e806a71ae174b1096",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1104",
        "20026"
      ]
    }
  ]
}
