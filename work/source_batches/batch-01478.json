      "kind": "character_system_text",
      "source_text": "唯有持续努力！",
      "source_fingerprint": "2d1bfa2a62ba7580851c73771c64e276cfa3e7e605c2aa36d543ec7aba868331",
      "source_path": "character_system_text_dict.json",
