      "source_fingerprint": "634c7d4f10eff57cecef73e5105bf5a7491a180046dd9763b4e25ae7eb120543",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1099",
        "71004"
      ]
    },
    {
