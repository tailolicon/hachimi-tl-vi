      "source_text": "“ランデブー”。",
      "source_fingerprint": "f0055e1615e45fa5e30135e2b9a453b438124b3df3d4e6d65fd1de841a7f00fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
