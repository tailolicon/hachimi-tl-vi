      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "110001"
      ]
    },
    {
      "uid": "zhcn:566a9b1a662d618b0e998ecf",
      "kind": "character_system_text",
      "source_text": "我能与大家「连结」吗？",
      "source_fingerprint": "5f7455725b3eabbc584a8d08847585400282e08c97abf688708a42551d3cc360",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "110002"
      ]
    },
    {
      "uid": "zhcn:c8d54e8a40a49d522700a319",
      "kind": "character_system_text",
      "source_text": "无论对手是多大的「巨星」。",
