    {
      "uid": "zhcn:17e70643f3fac386126f174f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "…くしゅっ。トレーナー…\r\n希求――“夏につながるドア”。\r\n一緒なら、『見つかる』かも…。",
      "source_fingerprint": "51b2e656be92e0e4442294b507ca4fcaf1f5b5d5f6774eae966ad545796c60dc",
