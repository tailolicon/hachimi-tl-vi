    {
      "uid": "zhcn:8716edcb83efdb235494d131",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "要让我「慰劳」你哦。",
      "source_fingerprint": "59938443b2c442273ffc439c38145af8a5c6c859d32cd4c4a672f42f5eeb53ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
