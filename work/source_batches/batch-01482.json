    {
      "uid": "zhcn:1f44858eb2ed8b7fea6383e8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这套服装造型模仿了整流罩。\r\n能够降低摩擦，令人放心。",
      "source_fingerprint": "d8a83d05f2ce186178f54ebc576fa759094014e66ef25b70a232c6eeaed11e49",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
