      ],
      "json_pointer": "/1105/71009"
    },
    {
      "uid": "zhcn:c3d9cdd28145b00c3c05ed40",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "一回房我就会立刻脱离长袜。\r\n身心感到解放。",
      "source_fingerprint": "159d34db80e4d3ab561b6f2648895af0ba48e20fa0d13614b24644bd5c064d69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
