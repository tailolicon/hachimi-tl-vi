    {
      "uid": "zhcn:2e6e566cee6c0d8e861ec665",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "裙子形状好像威斯特彗星。\r\n大家齐聚一堂时真是美丽。",
      "source_fingerprint": "ba43e15bd9c7cad578d1f3b324f5b75454b64471c50ad3dee90196bb9cefd86f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
