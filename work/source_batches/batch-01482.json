      ]
    },
    {
      "uid": "zhcn:66429a227a06e7a2f42975b4",
      "kind": "character_system_text",
      "source_text": "あらら……",
      "source_fingerprint": "97d65f95b57535f0688503bf7c5a2dc78a5e969d73eda5f9a2921eadcf61e316",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "410007"
      ]
    },
    {
      "uid": "zhcn:061e851f7268c00aeb5e05ff",
      "kind": "character_system_text",
      "source_text": "あらら……",
      "source_fingerprint": "97d65f95b57535f0688503bf7c5a2dc78a5e969d73eda5f9a2921eadcf61e316",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "410008"
      ]
    },
    {
      "uid": "zhcn:f197a138c6a6df81c22bc180",
      "kind": "character_system_text",
      "source_text": "希望能让观众们看得很开心～",
      "source_fingerprint": "ccc62bd86120f374e640bf865937886b9ca6b8b425b0c1eec7abff1273234af0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "60000"
      ]
    },
    {
      "uid": "zhcn:012a85710b53dd3fdb56ac2f",
      "kind": "character_system_text",
      "source_text": "再确认一次\r\n动作比较快的舞步吧。",
      "source_fingerprint": "05e3146a2fc3e54468f1729a743a9f51cb4bd097566d45caa5b5dac0f43eb83e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "60001"
      ]
    },
    {
      "uid": "zhcn:159d11c8a2a7f37fea628b18",
      "kind": "character_system_text",
      "source_text": "一起实实在在地努力吧～",
      "source_fingerprint": "4b8d5f806338fca03371d49d44cb3cbde9b0eebbfc6685960a59874b86dc95cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70000"
      ]
    },
    {
      "uid": "zhcn:4210d52def8b459403970902",
      "kind": "character_system_text",
      "source_text": "训练员当时看起来非常苦恼，\r\n所以我才忍不住向你搭话的喔。",
      "source_fingerprint": "62a127bd1120ea69fab6c3e5bab93e35a606fe807cae8b5325372073a3c71931",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70001"
      ]
    },
    {
      "uid": "zhcn:3a469d070efb83d044911bde",
      "kind": "character_system_text",
      "source_text": "大大的缎带\r\n很可爱呢～",
      "source_fingerprint": "6c14bfe59346bcc9700c40ddff0659378645f725fb6abcee3d28250bd2a8ffca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70004"
      ]
    },
    {
      "uid": "zhcn:f4afe911b78a322727ec072f",
      "kind": "character_system_text",
      "source_text": "肚肚露满多出来的呢～",
      "source_fingerprint": "69d2e36fa6b131370d92fbaa60d05d2002b4199210edefff0e90d20c93fb118d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70008"
      ]
    },
    {
      "uid": "zhcn:ed2a04ecd2bc0ea7e9642907",
      "kind": "character_system_text",
      "source_text": "这会让人绷紧神经呢。",
      "source_fingerprint": "dd3c0d12bb0e8043704f94ced7485b52cb84701c42084b32f294e804cabcb4cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70009"
      ]
    },
    {
      "uid": "zhcn:b4e602073068f143625da849",
      "kind": "character_system_text",
      "source_text": "长袜很保暖，\r\n真不错呢～",
      "source_fingerprint": "73074094a1fcfb93c779771402c6b9d165cc1d215fff5c3fb9b3d608a8c0a27c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70010"
      ]
    },
    {
      "uid": "zhcn:f571d18d07061ce724b66634",
      "kind": "character_system_text",
      "source_text": "得练习跳舞才行呢～",
      "source_fingerprint": "9d8976833ca4c5e69443408cf5ff8f0daa4f12d650348051c2495678fb353eec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70014"
      ]
    },
    {
      "uid": "zhcn:1137ad6683747380b7c49e2c",
      "kind": "character_system_text",
      "source_text": "柔和的粉红色看起来很温暖，\r\n真不错呢～",
      "source_fingerprint": "20ac98184d48e1463ff54a11b4ace5f39db0c705a808a2c37b7593fd151088ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70015"
      ]
    },
    {
      "uid": "zhcn:f87102b88521d5f47689c193",
      "kind": "character_system_text",
      "source_text": "我换好衣衣啰～",
      "source_fingerprint": "91b07ad22e309281398d11b9f0c010cd04eaa8ed70de1e889c5329095af9c4d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70018"
      ]
    },
    {
      "uid": "zhcn:b4c7e09cb96af86cd8dd1678",
      "kind": "character_system_text",
      "source_text": "可爱的服装\r\n会让人觉得很雀跃呢。",
      "source_fingerprint": "7492f1e664a920bf16ba2c6b8a4293bcd517906b213e89f7dc9b0ae538253fc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70019"
      ]
    },
    {
      "uid": "zhcn:2a986476229a4956100c721f",
      "kind": "character_system_text",
      "source_text": "のんびりお散歩でも\r\n行こうかしら。",
      "source_fingerprint": "7e2fee0b89bb0310038c7c7005cbf88b2b6b7479904243d2c0113d920f6dc69a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "70020"
      ]
    },
    {
      "uid": "zhcn:9635d3e9a0a3cc004f84f610",
      "kind": "character_system_text",
      "source_text": "編み物してたら\r\n休日なんてあっという間ねぇ。",
      "source_fingerprint": "e3d2524d497945d9aee883927b374efc3a1853868681de23a8b0e3ec256f4cb5",
      "source_path": "character_system_text_dict.json",
