    {
      "uid": "zhcn:9c8d65eebef7630e858358a0",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今天是情人节呢。",
      "source_fingerprint": "a0ede3d62de262aa3d0584fc168a26b69b0c9e044b40007511a7627788b06a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
