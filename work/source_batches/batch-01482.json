        "1105",
        "91015"
      ],
      "json_pointer": "/1105/91015"
    },
    {
      "uid": "zhcn:7519e7b4a66c927e1cb532cc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "“探査中”感取した“GDAE”…\r\nあの波長…『カンタービレ』は――\r\nふふ、サウンズオブアース…だね。",
      "source_fingerprint": "456f79993084a54fa9c7067f2eec78f5263c7da6988e081ed8ae75ca76847b23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
