    {
      "uid": "zhcn:7c7cfe177b2a074733c9e945",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "トレーナー…『お月見』、する？\r\n“天球模様”は不問…\r\n“ワームホール”、経由するから。",
      "source_fingerprint": "a5651754d3ec390cd514e6953580c6f51ffdc07bdb879e4bd89c52457239d027",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
