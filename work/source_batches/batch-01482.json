      ],
      "json_pointer": "/1105/91016"
    },
    {
      "uid": "zhcn:c8198423da43441a5b7b3ee6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "自動ドア…『2人がかり』でも\r\n無反応…スティルインラブは\r\n“ニュートリノ仲間”だよ…。",
      "source_fingerprint": "aaf2064548cd71fa845f987bbd41c9b1cdb133c35e1d39426053c2ee060b2a6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
