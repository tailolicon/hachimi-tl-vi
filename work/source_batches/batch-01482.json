    {
      "uid": "zhcn:cd933ee55a50204899b4d944",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "『見えた』――“スペースサイン”\r\nあれは、ゼンノロブロイたちの――\r\n“F”“U”“J”…ふふ、そっか",
      "source_fingerprint": "3e11b4661a8dfdec4618a4fbbf61408923d6ba4e6508e5ec4fd3e994f956ce64",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
