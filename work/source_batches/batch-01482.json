      "kind": "character_system_text",
      "source_text": "ふふふっ",
      "source_fingerprint": "12e7eef62aaa62de5bcf3d27009562d4eacaff770beadf5a4675927e39705a93",
      "source_path": "character_system_text_dict.json",
