    },
    {
      "uid": "zhcn:f06729997962f58e0aa7d430",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "ネオユニヴァースは『読書の秋』、\r\n実行中…『面白い』を発見したら、\r\n“Wow!”するね。",
      "source_fingerprint": "e6c4b634a622bb94dc5ce86c5f43d21fc4570efb52eb07f25bfb62f9884ada97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
