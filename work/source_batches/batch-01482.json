    {
      "uid": "zhcn:fa2e291f1ee2e86ecf153a4d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "“ラメーン”、『おいしい』の\r\n季節…でも“ビジョン”が『曇る』\r\n季節でもある――ジレンマ、だね。",
      "source_fingerprint": "0050bef1c41e7dcb5311a54c87b9393d33efd9cf9978e36cc326696650870e16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
