    {
      "uid": "zhcn:9405440b8cee11d539aa9e0e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "『ベレー帽』装着でも、\r\n“アンテナ”は“オープン”…\r\n“宙間波”、“阻害”するから――",
      "source_fingerprint": "472da4f61f17f19e4340066aa1bcedb831f03952b4dd9c4cc24070bed8e532be",
