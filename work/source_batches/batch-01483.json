      ]
    },
    {
      "uid": "zhcn:5778049a3d17f98e5a34c923",
      "kind": "character_system_text",
      "source_text": "惚れ惚れするね。",
      "source_fingerprint": "1018c74a75d6d55727b1bfd5b0c18b959042bc617615665c7b1b9dbdbeecfbaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140004"
      ]
    },
    {
      "uid": "zhcn:11805c266899248f68e364bf",
      "kind": "character_system_text",
      "source_text": "悲しまないで。",
      "source_fingerprint": "e4814d1aaf7c7f9a2891bc732c5de04de513ddb48c8b9e56a63cf38df1ae335d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140005"
      ]
    },
    {
      "uid": "zhcn:248481962484e84e89988608",
      "kind": "character_system_text",
      "source_text": "見事な指揮だったよ！",
      "source_fingerprint": "76cfebfdb2ed136817c1b59c001b6630823dca879a0ae7c90b372e33ce7d37d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140006"
      ]
    },
    {
      "uid": "zhcn:9048c87eb91b9b6a0cac5b0f",
      "kind": "character_system_text",
      "source_text": "惚れ惚れするね。",
      "source_fingerprint": "1018c74a75d6d55727b1bfd5b0c18b959042bc617615665c7b1b9dbdbeecfbaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140007"
      ]
    },
    {
      "uid": "zhcn:c0d90befeee8d417328f5a22",
      "kind": "character_system_text",
      "source_text": "ふふっ。",
      "source_fingerprint": "dbc78ca5d65302a8b38bec657661270c58ae9fac943c1c718a7fa71c2d75ec30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140008"
      ]
    },
    {
      "uid": "zhcn:9fd95326c29428cf718c1a07",
      "kind": "character_system_text",
      "source_text": "うん？",
      "source_fingerprint": "7c59608752f267d6180b140d18e7d63d6eab88ec8f53b1bf3132cb2afda45b46",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140009"
      ]
    },
    {
      "uid": "zhcn:9dfd0c4b9b95eae223a6fb1a",
      "kind": "character_system_text",
      "source_text": "ラ～♪",
      "source_fingerprint": "e2dec7f3e4502b2750213206d6bcd0f673757d7b0980a3172b6f47d72c6b4bcd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140010"
      ]
    },
    {
      "uid": "zhcn:2f76548e9b17523769c83de0",
      "kind": "character_system_text",
      "source_text": "連符だ！",
      "source_fingerprint": "3eec23dc9c7816be34ccc6ef7184b40847a3fdbf2f1a43b392df01a2f67d1a4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140011"
      ]
    },
    {
      "uid": "zhcn:fea58f3fe7d3e44806428464",
      "kind": "character_system_text",
      "source_text": "いいね！",
      "source_fingerprint": "1e449d624257b03e141c0d079d48161b8145f4a8f9573daf9ff588fa6710b769",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140012"
      ]
    },
    {
      "uid": "zhcn:7794c8f77404d1e4f7a2189f",
      "kind": "character_system_text",
      "source_text": "こんなことが！",
      "source_fingerprint": "cb705c7684335412252c5d61e0e01c4f71fbe94813147b5f24aeef5e76a00ac4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140013"
      ]
    },
    {
      "uid": "zhcn:47eab38e0b93829eecb20c32",
      "kind": "character_system_text",
      "source_text": "おっと！",
      "source_fingerprint": "c80f8f80cff771dcb400a168842318d62facf76f97ebef4aaabf4072bddc5e72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140014"
      ]
    },
    {
      "uid": "zhcn:96f0e3b392521c4ce81589b2",
      "kind": "character_system_text",
      "source_text": "ふむ。",
      "source_fingerprint": "9ca17ef88ffa43250463c9310b566294cb0518dd986bdcfe3f3a1f06e4305d37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140015"
      ]
    },
    {
      "uid": "zhcn:5dca0a31c43a677849935ff1",
      "kind": "character_system_text",
      "source_text": "休符かい？",
      "source_fingerprint": "423dc05b57fe5f19d923c341993856b6338c1cfe402167c4520c1b8ec9550cf1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140016"
      ]
    },
    {
      "uid": "zhcn:5cc2bce11b7dfb6a62c5d60f",
      "kind": "character_system_text",
      "source_text": "惜しい…！",
      "source_fingerprint": "c34cfd89763d0f7a8a0eabd9d994ec5894d78ca2a1cc873f01608d7cb351eb54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140017"
      ]
    },
    {
      "uid": "zhcn:5ac9bfd746fd754f8d62b835",
      "kind": "character_system_text",
      "source_text": "顔を上げて。",
      "source_fingerprint": "85ad8b1e3e684f342cb070dd12b264c659d2e3e12c89e8c63bf8bf750ce31a54",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140018"
      ]
    },
    {
      "uid": "zhcn:ce9d90581635a8f65e789fa6",
      "kind": "character_system_text",
      "source_text": "明日はこれさ。待っているよ。",
      "source_fingerprint": "e213d8b6c417544eb512fe61e8a84cf7ed5ac4e23271b6bc380e555fcca3e678",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "15"
      ]
    },
    {
      "uid": "zhcn:d17482d9a2615604866b61db",
      "kind": "character_system_text",
      "source_text": "休んでもいいかな…ちょっと\r\n疲れがね。このまま君に、\r\nノイズを聴かせるのは嫌なんだ…。",
      "source_fingerprint": "a4f35521c9fe48c533fcecaf1091fba0d74c5c644a91cf3228969d8937b3c9a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20000"
      ]
    },
    {
      "uid": "zhcn:bc27b5587790aa31e8707d4d",
      "kind": "character_system_text",
      "source_text": "ラ、ラララ、ラ～…♪\r\nんんっ、今日は響きづらいな。\r\nいいスオーノを聞かせたいのに…。",
      "source_fingerprint": "37aff5e9ee423ccdf6f14632d6250f8a34a60130b742704c1af8ec9c92991c6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20001"
      ]
    },
    {
      "uid": "zhcn:4f1ab04a48bbd62f5e080591",
      "kind": "character_system_text",
      "source_text": "今の私なら豊かに表現できる。\r\nあらゆるスコア…超絶技巧練習曲\r\nでさえも奏でてみせよう！",
      "source_fingerprint": "820bdc4ff92d24952f0eff81bd0080a181e6f73a3ff9a67dd74da07a6ededdc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20002"
      ]
    },
    {
      "uid": "zhcn:cef5a35465b677812131f99e",
      "kind": "character_system_text",
      "source_text": "感じる、鮮やかな音の戯れ！\r\n足音から息遣いまで――全て\r\nエチュードにのせ、モノにしよう！",
      "source_fingerprint": "565d4d333d0e9c7d1e5d9b61b41b860751f51430eeb4b403d696a93a8648ec04",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20003"
      ]
    },
    {
      "uid": "zhcn:9e6930085b893023afea1c67",
      "kind": "character_system_text",
      "source_text": "トレーニングは本番さながらに。\r\nあらゆる感情とドラマをぶつけ、\r\n全身で奏でようじゃないか！",
      "source_fingerprint": "43dcfced7176143cb15c96f45a7c3039757809a9a2323933188e7d8c61fd97dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20004"
      ]
    },
    {
      "uid": "zhcn:25e77212c9f59b8fa3730a6d",
      "kind": "character_system_text",
      "source_text": "今日は調子がよさそうだ。ほら、\r\n心に耳を傾けると…う～ん、ベネ！\r\n勇ましい大合奏が聞こえるよ！",
      "source_fingerprint": "7dc4456052e3c295bb5b7a1f68ce0e434ab2ab47013ae51b350258ec0fef71e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20005"
      ]
    },
    {
      "uid": "zhcn:98151078d4e1d12c89da5643",
      "kind": "character_system_text",
      "source_text": "さあ、始めよう！\r\n指揮者がバケッタを振るように、\r\n私を導いてくれるかい？",
      "source_fingerprint": "3bbde74f459e4bf803c337550b210dec0b0767a0ad28c0293ceabbd7bfd4d081",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20006"
      ]
    },
    {
      "uid": "zhcn:8394979a1fea084db7a71c44",
      "kind": "character_system_text",
      "source_text": "フッフッフ、ホッホッホ…\r\nハァ～～～…よし、息は整った。\r\nいつでもいけるよ！",
      "source_fingerprint": "7f4e07c9cd80a09679e82fd25b0639cec3288ef2c42f78725a2c65898503c01e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20007"
      ]
    },
    {
      "uid": "zhcn:a373c88ef6bc25b560c4cecf",
      "kind": "character_system_text",
      "source_text": "ふぅ…頭に音が入ってこない。\r\n今は君のサポートが頼りだ…\r\n代わりに譜面をめくっておくれ。",
      "source_fingerprint": "2a04d40f032858b4e4194b0419d1582de14651295d35f426bbc6e3c976d47be6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a408a11d8f37e0abb36c9de9",
      "kind": "character_system_text",
      "source_text": "んんん…おっと、すまない。\r\n知らぬ間に耳を\r\n閉ざしていたみたいだ。",
      "source_fingerprint": "5b94069d6e1802db4b1ed6859e279b42e1bcba46a1e33d10cd203b791df60492",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20009"
      ]
    },
    {
      "uid": "zhcn:a5db71ad8ecd15732c824523",
      "kind": "character_system_text",
      "source_text": "くっ、これからトレーニングだと\r\nいうのに…なぜなんだ…！\r\n響かない…心に…何も…。",
      "source_fingerprint": "49e4bf95297180f40f585734291a06c1550d7e814fa547f1d84457ecb6149f56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20010"
      ]
    },
    {
      "uid": "zhcn:a64893d2248294233e582fab",
      "kind": "character_system_text",
      "source_text": "何か、優しい音色をドルチェで\r\n流してくれないか。そうしたら、\r\nトレーニングを頑張れそうだ…。",
      "source_fingerprint": "585b7439a595dfbf6c3cc92a70acd77e47b86ce8b8282641f08be1900d4680a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20011"
      ]
    },
    {
      "uid": "zhcn:2c0ed3f658617776fcd7a729",
      "kind": "character_system_text",
      "source_text": "私だって、レースで何度も\r\n観客の耳を喜ばせたい…でも、\r\n今は静かに過ごす時じゃないかな？",
      "source_fingerprint": "6d39681aa4dd3def0fc4ab5c339259d476a95adfd27cbede7ca5a40b2ad62f53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "20021"
      ]
    }
  ]
}
