        "140000"
      ]
    },
    {
      "uid": "zhcn:4696425a506d41faa59dc55f",
      "kind": "character_system_text",
      "source_text": "素晴らしい！",
      "source_fingerprint": "57abbd744eb1ce776d84b6c9a2a56731e56a93872f722ed88e254c40ea3cf6ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140001"
      ]
    },
    {
      "uid": "zhcn:3e87c78b3ad364db6f640b73",
      "kind": "character_system_text",
      "source_text": "まだまださ！",
      "source_fingerprint": "07547aef272ddae5d05931b869993a6e04d86e0d5f3ad3a38edfdd594519b96c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
        "140002"
      ]
    },
    {
      "uid": "zhcn:37c3ddc57e68f43bc970abac",
      "kind": "character_system_text",
      "source_text": "見事な指揮だったよ！",
      "source_fingerprint": "76cfebfdb2ed136817c1b59c001b6630823dca879a0ae7c90b372e33ce7d37d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1102",
