      ]
    },
    {
      "uid": "zhcn:9a20a0e3710f759778fb14f7",
      "kind": "character_system_text",
      "source_text": "リズムにのって！",
      "source_fingerprint": "b72a2363fe988e7bcacffbe15dfd1dd01a008777ded8e95768527e5e86a9b46e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
