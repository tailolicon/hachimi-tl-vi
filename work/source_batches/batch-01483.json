    {
      "uid": "zhcn:dfc86fb03fd105ea4ad6e467",
      "kind": "character_system_text",
      "source_text": "マルチャのように！",
      "source_fingerprint": "dec75ee0bbb890ac926f7930a041294ccfc67f2de15eedec9c0d551614ee453d",
      "source_path": "character_system_text_dict.json",
