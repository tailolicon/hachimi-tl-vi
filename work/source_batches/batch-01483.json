  "entries": [
    {
      "uid": "zhcn:ee9b966f23801d242bba258d",
      "kind": "character_system_text",
      "source_text": "甩，甩开咯！",
      "source_fingerprint": "067615aba4eb3d9dbf61f90321baecebec4e301a5439b7e17be348d434a918b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "1206"
      ]
    },
    {
      "uid": "zhcn:6b28e42bfc1ead5ec107bee4",
      "kind": "character_system_text",
      "source_text": "要上的话！",
      "source_fingerprint": "3ecdab82fccf4583cbe426f26e5d11856d97075213f2fd578ae8579faa6baf3f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "1248"
      ]
    },
    {
      "uid": "zhcn:996f56bd2bc2d9d2b825dda3",
      "kind": "character_system_text",
      "source_text": "一起赢下来…。",
      "source_fingerprint": "99625e148b79680c069b2508144802262b7a14e26955d384cc65e23afc2b3004",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "1249"
      ]
    },
    {
      "uid": "zhcn:6f716547343ec3c1384c8ede",
      "kind": "character_system_text",
      "source_text": "今天的登录奖励\r\n就是这个哦！",
      "source_fingerprint": "1f10638dd810d4f6a5f0e6ed3872df07186836df0b399448f5b2989bf2e86ee4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "13"
      ]
    },
    {
      "uid": "zhcn:6b41c7495a86ed45ac0f9fed",
      "kind": "character_system_text",
      "source_text": "加油！",
      "source_fingerprint": "54ce5981946278daacd326ac0aa9463334476cc4c88beeec688628a4bb2fb3d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140000"
      ]
    },
    {
      "uid": "zhcn:9b03ec798115b5a5ea8207d1",
      "kind": "character_system_text",
      "source_text": "不愧是您呢！",
      "source_fingerprint": "939fc7314008270c9046e60c8b5910a264609fbcb16999fcc0fc0a88866d7c03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140001"
      ]
    },
    {
      "uid": "zhcn:d2f20cab48f2da1711f553c7",
      "kind": "character_system_text",
      "source_text": "可惜…！",
      "source_fingerprint": "df5363c44b69bf38e6e1108f68cb23da2d99105abbe049b2e9d0dd2538a99eb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140002"
      ]
    },
    {
      "uid": "zhcn:45128f131ae52037573767e4",
      "kind": "character_system_text",
      "source_text": "真专业呢！",
      "source_fingerprint": "7a606a07310c2d587da76cdbc4bcd075eb3abe07fe67e86b0359971cb417994c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140003"
      ]
    },
    {
      "uid": "zhcn:945950babd7735069bfeef73",
      "kind": "character_system_text",
      "source_text": "好厉害呢…！",
      "source_fingerprint": "0b81b05e778c96705e548d3763e6d6694e65240b4a0704822bc9182b391b8c2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140004"
      ]
    },
    {
      "uid": "zhcn:50008ffbd9e5dce8f5288254",
      "kind": "character_system_text",
      "source_text": "没关系的…。",
      "source_fingerprint": "0761a95e4210f122fc07f2b4f4fa225251c8717aabab1c50dc730d8f079fc6ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140005"
      ]
    },
    {
      "uid": "zhcn:115253fbc37624a2c2459c7e",
      "kind": "character_system_text",
      "source_text": "真专业呢！",
      "source_fingerprint": "7a606a07310c2d587da76cdbc4bcd075eb3abe07fe67e86b0359971cb417994c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140006"
      ]
    },
    {
      "uid": "zhcn:83734e2691d675a5988a4bf3",
      "kind": "character_system_text",
      "source_text": "好厉害呢…！",
      "source_fingerprint": "0b81b05e778c96705e548d3763e6d6694e65240b4a0704822bc9182b391b8c2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140007"
      ]
    },
    {
      "uid": "zhcn:114df8b38c84e1a6b4d6766d",
      "kind": "character_system_text",
      "source_text": "嗯嗯。",
      "source_fingerprint": "c0dad597dc82a31dd69060476ba8d5a0bc081bd7005ed6641f89ca6ade33857a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140008"
      ]
    },
    {
      "uid": "zhcn:490f607d266f3d66e08e12d9",
      "kind": "character_system_text",
      "source_text": "唔～嗯…。",
      "source_fingerprint": "0b74459af7ec589d9f310d8ce377a16270efe744cf72dd448eddc6e1d89f4fb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140009"
      ]
    },
    {
      "uid": "zhcn:2db8fafa60164d7836447d15",
      "kind": "character_system_text",
      "source_text": "我看看？",
      "source_fingerprint": "59b7d4cbbbc7a7b347ee73bdfe08959d5fcac00b9cd272d16944f954dd761928",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140010"
      ]
    },
    {
      "uid": "zhcn:b3650d3e06dba124582290ad",
      "kind": "character_system_text",
      "source_text": "哇啊！？",
      "source_fingerprint": "10be977f31df1e46adc09787dbdd00b70a6dc9bf88d757d3b56385ddc573ffd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140011"
      ]
    },
    {
      "uid": "zhcn:b0871b1a3d996113aa7225fc",
      "kind": "character_system_text",
      "source_text": "好多啊！",
      "source_fingerprint": "f8fb9ca35996a1d0c74ba9601d3cf1f51f050084e2e2b7efb71ed3f26cca231c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140012"
      ]
    },
    {
      "uid": "zhcn:c6f6aa055ebc07974f35626f",
      "kind": "character_system_text",
      "source_text": "机，机会来了哦！",
      "source_fingerprint": "48d25a9380ce746b2656a2b489dd1c8118fed97ba893cfd37a3405cdf5cf2a76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140013"
      ]
    },
    {
      "uid": "zhcn:41f5f1ee6ee026b63f6f20e1",
      "kind": "character_system_text",
      "source_text": "啊啊…。",
      "source_fingerprint": "160d02f9733e54748c323b42843a35e366d7b110517032d612ec579384bf2291",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140014"
      ]
    },
    {
      "uid": "zhcn:2c03281f5e2aa5c02fbe1f7b",
      "kind": "character_system_text",
      "source_text": "加油加油！",
      "source_fingerprint": "85e96c13bc11dfa4fb9bad5e7e60075ea7cb3ad9436177e204404cfefe1eb1ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140015"
      ]
    },
    {
      "uid": "zhcn:ddf47f3cd9b0fb2b9c25ae04",
      "kind": "character_system_text",
      "source_text": "怎么了吗？",
      "source_fingerprint": "eb75f8d097324489df9101b9fb1301ac4112567bf0af3df0f690cd98a27eee1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140016"
      ]
    },
    {
      "uid": "zhcn:1a0e188e7dee98fd2060933e",
      "kind": "character_system_text",
      "source_text": "咦咦…！？",
      "source_fingerprint": "485af4cd169d0fd9bdfff3cfb86521a13c656b1aca5480e4da13165e030c5c6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140017"
      ]
    },
    {
      "uid": "zhcn:747229ab703cd0126515d828",
      "kind": "character_system_text",
      "source_text": "错过了啊～…。",
      "source_fingerprint": "679a8193ad2d225dcaf5da9dcb450f8c0d68e121bab830b33ca344eda2bf193c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "140018"
      ]
    },
    {
      "uid": "zhcn:d16a3921ea6379240e601957",
      "kind": "character_system_text",
      "source_text": "明天的也准备好了哦～！",
      "source_fingerprint": "71ae44d640c4e23f335cd964769beaf51c0d6a56ee5b32ea50208ecedd2ca428",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "15"
      ]
    },
    {
      "uid": "zhcn:0519ebc3c861c3893e95dad0",
      "kind": "character_system_text",
      "source_text": "这种时候就想喝牛奶\r\n一下恢复……但事情\r\n没那么顺利呢…。",
      "source_fingerprint": "b840dcd587333b9ee6e7ca3b4689745d028098621e614312ce5b61966e483ad8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20000"
      ]
    },
    {
      "uid": "zhcn:7eb0b1ff9f64c7ecfb230536",
      "kind": "character_system_text",
      "source_text": "有，有点累了……\r\n不过，或许正是要跨过\r\n这种状况，才算成长吧…。",
      "source_fingerprint": "b5e0ce44243f9042e5587cc523bb7bae4a6bb71db4fb7f0c89a59eb812a1a5b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20001"
      ]
    },
    {
      "uid": "zhcn:451d141c0840453782e39558",
      "kind": "character_system_text",
      "source_text": "总觉得身体里有力量涌出来…！\r\n这一定是…！一定是……\r\n昨天，早睡了吧…！？",
      "source_fingerprint": "e64f1705e6433376aee92a3e6745c504aa77cf923ac92cc2c1ae3e609a104ec7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20002"
      ]
    },
    {
      "uid": "zhcn:bf280b33919416782ad410ad",
      "kind": "character_system_text",
      "source_text": "今天的训练\r\n说不定能取得不一般的成果，\r\n对吧？呵呵…。",
      "source_fingerprint": "5c5767759859640ec3ba1dfa6c2858081371abf3c487d9827ff379591c88c649",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20003"
      ]
    },
    {
      "uid": "zhcn:0afdf7028dcf66936ce049d4",
      "kind": "character_system_text",
      "source_text": "虽然不算很厉害，也谈不上出类拔萃\r\n……但我还是会按自己的方式，\r\n继续向前走的哦！",
      "source_fingerprint": "ac50b395e5152271d5c3c7290522730bd139ae5f570cdf27feede51b65891cdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20004"
      ]
    },
    {
      "uid": "zhcn:b67a7aa9164405d5a0dcbc83",
      "kind": "character_system_text",
      "source_text": "今天从热身开始状态就很好！\r\n怎么样？我的眼神，是不是比平时\r\n更有斗志？",
      "source_fingerprint": "7dfd96c5c63f9f9bed2c8ad99d7725438acb8688b7bbb303fb7b3e1df98105c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20005"
      ]
    },
    {
      "uid": "zhcn:a955bcdc1eae5312a9722fdf",
      "kind": "character_system_text",
      "source_text": "上吧！未来的主角就是我！\r\n……那个，每天这么说的话，一定\r\n就能成真了吧，之类的。",
      "source_fingerprint": "b523e6ac230428e8d454d870711d0897ba6663989bb888b7518d9f4e151a4a9b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20006"
      ]
    },
    {
      "uid": "zhcn:52432475b31b9431391e58ad",
      "kind": "character_system_text",
      "source_text": "训练到极限，结束后就喝牛奶\n冲蛋白粉！……呵呵。现在就\n开始期待了～。",
      "source_fingerprint": "49b098e4b133f63a4efe9004bd6766726b968d6a0e1ac1e999df4131f80ac833",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20007"
      ]
    },
    {
      "uid": "zhcn:820d7c315faeeb167ae8b08d",
      "kind": "character_system_text",
      "source_text": "我能行，能加油，\r\n能撑过去的！…唔～嗯，\r\n自我暗示还挺难的呢…。",
      "source_fingerprint": "d6f8a5e49cab2978379a72f055882c50b3f124d32326037e5ca970c95a6ec256",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20008"
      ]
    },
    {
      "uid": "zhcn:76c3d04cbfeb968dfd753c3a",
      "kind": "character_system_text",
      "source_text": "正是这种时候，才更应该接受比平时\r\n更严格的训练…！\r\n……唔，我是不是有点着急了…。",
      "source_fingerprint": "165ef30dd8f4c77f6b639261d686b258a66733c1b34603a958bd41b0578c8bfa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20009"
      ]
    },
    {
      "uid": "zhcn:6e5c654626092c27505ae035",
      "kind": "character_system_text",
      "source_text": "……不行不行。通往主角的路又远又\r\n险……所以每天哪怕只走一点，\r\n也得继续走下去…！",
      "source_fingerprint": "2b608b716277e6a67b4ded1f1131bdbdc6075fbb3ea5fcb70b4c1ac28a325c98",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20010"
      ]
    },
    {
      "uid": "zhcn:0070a4e664ddfa775134c7e7",
      "kind": "character_system_text",
      "source_text": "想象自己站在舞台正中央…！\r\n……不行啊。想起小时候，演话剧只分到\r\n树的角色了…。",
      "source_fingerprint": "270edc27b1290f508807ea33562df6da0f41ef0c5b82cf0d174c522a50a6c4bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20011"
      ]
    },
    {
      "uid": "zhcn:8e670d0926bed9c485ed4327",
      "kind": "character_system_text",
      "source_text": "还能再努力，我是这么想的。\r\n…虽然这么想……可这……\r\n就是通往主角的路，吗…？",
      "source_fingerprint": "558ebaaedf43d95500c02d5f62abe352d918507fb73c53070acdcef46f50b179",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20021"
      ]
    },
    {
      "uid": "zhcn:68fbe3cf346f42bb9f1ebd1b",
      "kind": "character_system_text",
      "source_text": "如果是主角的话也许能跨过去……\r\n也许吧……对不起……\r\n我果然，还是不行吗",
      "source_fingerprint": "c1b89943aa8d25814d2a43c6f6556599e54857109eae96c0130680e3ad12badc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20022"
      ]
    },
    {
      "uid": "zhcn:9bbfdde1a93a7e4abe6b0872",
      "kind": "character_system_text",
      "source_text": "我的自信，满得快溢出来了！\r\n我有自信今天的主角就是我！",
      "source_fingerprint": "2de307d9825c23594d140794913925fcdc7fc87be285ed806efe44f9b35290b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20023"
      ]
    },
    {
      "uid": "zhcn:bc973654cd17e680d3df040b",
      "kind": "character_system_text",
      "source_text": "一路走来的每一步，\r\n都是为了这一天……\r\n我要拿出结果，证明这句话！",
      "source_fingerprint": "a76c40ccd271b431061b1c805450919b9d2b355900af1ffac28de5a701e828fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20024"
      ]
    },
    {
      "uid": "zhcn:90492c8d569c4fcb613894e8",
      "kind": "character_system_text",
      "source_text": "大家都盯着主角的位置……\n但是，论这份心意，我也不会输…！\n……我会赢回来的！训练员！",
      "source_fingerprint": "83b30f13984844090031d682dc6a5e2adbc0f3b7897a14243e780fc8fd0378c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20025"
      ]
    },
    {
      "uid": "zhcn:c5d2761f26ecb73292dab2e8",
      "kind": "character_system_text",
      "source_text": "啊……有人正在搬音响设备，\r\n就在那边呢。…今天演唱会的主角，\r\n是我。嗯……已经能想象到了",
      "source_fingerprint": "63c46d9f38c90144e7769d5f4ea8fad85f6f2af4a1adc7db0f94037e74b9588a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20026"
      ]
    },
    {
      "uid": "zhcn:49ae6748e0ffff0acb29a2c7",
      "kind": "character_system_text",
      "source_text": "能以这么好的状态迎接比赛\r\n这份谢意，我暂时不说。\r\n……因为我会用结果来表达！",
      "source_fingerprint": "961d1807ddb0917ab104f6438fe2f0177fde4ab31223139ace63b8b8cb002260",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20027"
      ]
    },
    {
      "uid": "zhcn:e223547e43ba3c009a755ef8",
      "kind": "character_system_text",
      "source_text": "哇～，好多人啊…！虽然紧张\n……但要是能在这里成为主角\n的话，一定最棒了吧。",
      "source_fingerprint": "73a0dd9f6f4036b5876cbf61aee16046ca130ba9eef68719506dfb99f1ce77a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20028"
      ]
    },
    {
      "uid": "zhcn:b5d9d2143a78b64fd1c0a208",
      "kind": "character_system_text",
      "source_text": "训练一直持续到\r\n现在了……我，能行的！\r\n……请相信我哦。",
      "source_fingerprint": "b0e20c922023ec5766021905d28d7eaa8a864608c454beae4c3c76b659bc94f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20029"
      ]
    },
    {
      "uid": "zhcn:9e151070274be18ae21b990e",
      "kind": "character_system_text",
      "source_text": "有人在为我加油……粉丝们，\r\n还有训练员。那么，\r\n当主角的条件已经齐了……我会赢的！",
      "source_fingerprint": "06af0e4273d8371b74df981720869aa549396d9318a017cd5206db7d08cf042d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20030"
      ]
    },
    {
      "uid": "zhcn:82f3c7d71f93909678017304",
      "kind": "character_system_text",
      "source_text": "好像聚集了很多厉害的对手……\r\n啊，不对！我也是\r\n很强的……对吧，训练员",
      "source_fingerprint": "df9d6d4ac6f08de64bc4431a0cb7714f966013ba6655c7dacd30cb46e43289af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20031"
      ]
    },
    {
      "uid": "zhcn:dcef15ecd106f6d4e7f265a1",
      "kind": "character_system_text",
      "source_text": "在右手写上『马』……一口吞下！\n…我从早上就一直这么做可紧张还是\n没缓解…。",
      "source_fingerprint": "4392b7c6e1133648c2c1f953f05d553d2111ec9fae974e1e2f6a5065ad12c6bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20032"
      ]
    },
    {
      "uid": "zhcn:1195cc35a75f5dac93a07c7e",
      "kind": "character_system_text",
      "source_text": "现实里，并不是什么都能顺利……\r\n正因为如此，才值得瞄准\r\n那闪闪发光的顶点宝座",
      "source_fingerprint": "62c71c3f4d3840e5dc61c79fad322fe16be69b0aeda5aa61c60449d7b207da23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20033"
      ]
    },
    {
      "uid": "zhcn:0a5a678c5e534fad3fcf92a8",
      "kind": "character_system_text",
      "source_text": "相信自己和训练员，\r\n才走到了这里……现在怎么可能\r\n放弃呢！",
      "source_fingerprint": "022f980773a7ba6b31cf65c9af7b28b13dc7ddd10f6442bbd0aa2d00f45dcb1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20034"
      ]
    },
    {
      "uid": "zhcn:9153e0846f7e667a312f3515",
      "kind": "character_system_text",
      "source_text": "要说优点大概只有能努力这一点\r\n……正因为如此，今天也\r\n能不放弃地战斗…！",
      "source_fingerprint": "e79ac4d69b8b13b75751d486bc1dc703eecf3d66b3f52f13bf78df8a0f228d89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20035"
      ]
    },
    {
      "uid": "zhcn:9b5081b164abcbf4d7ad3eec",
      "kind": "character_system_text",
      "source_text": "绝境中的大逆转……那种事也许只是\r\n漫画里的世界……可要是真做成了，\r\n就是“主角”了吧。",
      "source_fingerprint": "7069c06a4aaa9c511947b8d69af1a56701d0117f8f77dcb3da5b3401cabe65fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20036"
      ]
    },
    {
      "uid": "zhcn:b63179836da5218d2fb94d67",
      "kind": "character_system_text",
      "source_text": "我的故事……既然已经决定要\r\n跑到最后…！\r\n就不会在这种地方结束…！",
      "source_fingerprint": "4cd7ffec6baa5889afb5378722ce6490488369d5c3c1a4cf207210d54b362949",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20037"
      ]
    },
    {
      "uid": "zhcn:116d4c61b3fbe6f61d02ba5e",
      "kind": "character_system_text",
      "source_text": "加油！",
      "source_fingerprint": "54ce5981946278daacd326ac0aa9463334476cc4c88beeec688628a4bb2fb3d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20038"
      ]
    },
    {
      "uid": "zhcn:5fa90c985ca9379d897a589f",
      "kind": "character_system_text",
      "source_text": "要上咯～！",
      "source_fingerprint": "a332ab74e9cf916afd11d68600b858faaf832c4c8e92dc6630355161c3ed1a44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20039"
      ]
    },
    {
      "uid": "zhcn:f85a15b0ccaf3d97d535663e",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20040"
      ]
    },
    {
      "uid": "zhcn:212517e9752d32b830f5cdc0",
      "kind": "character_system_text",
      "source_text": "嗯嗯。",
      "source_fingerprint": "c0dad597dc82a31dd69060476ba8d5a0bc081bd7005ed6641f89ca6ade33857a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20041"
      ]
    },
    {
      "uid": "zhcn:0dd583f3b61470b786e8eddd",
      "kind": "character_system_text",
      "source_text": "诶诶～！？",
      "source_fingerprint": "7d5ffd33e2cd31d0562bcc49aa833d374ecdd12255067f7fb789e63964b12a0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20042"
      ]
    },
    {
      "uid": "zhcn:cd92256fd55bb0b36a64b3d5",
      "kind": "character_system_text",
      "source_text": "唔唔～…。",
      "source_fingerprint": "3b3c13ab99e8b5024b515b840934279d6f15dbc7046ef90b06a9d677fc53fe48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20043"
      ]
    },
    {
      "uid": "zhcn:aae38912cca4259b956d01dc",
      "kind": "character_system_text",
      "source_text": "出发吧！",
      "source_fingerprint": "778f2d205d4eaf97bc7ba75792626a5d8a4695e1fb0cb5ca44b7b560dd525d9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20046"
      ]
    },
    {
      "uid": "zhcn:71bf9d577483ec87f1783db5",
      "kind": "character_system_text",
      "source_text": "好宽敞！",
      "source_fingerprint": "5226b2883ce03dc536199844c5723436a5fa04b0fef0b872648a050d22d4afdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20047"
      ]
    },
    {
      "uid": "zhcn:26bc8846f07ee33c226567b5",
      "kind": "character_system_text",
      "source_text": "用这双脚，好好地往前走了！",
      "source_fingerprint": "5566687dec043d21b2ea943eb7214dff42e5172b21a8a9d05d4e1cec2aea31db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20049"
      ]
    },
    {
      "uid": "zhcn:a5acf073407b76dc4c3e3735",
      "kind": "character_system_text",
      "source_text": "托您的福我才能坚持到现在！",
      "source_fingerprint": "d9bdc8e61f0f608d7d1b85f0bd328a7df6e6621b0fac3d67dcf48103d0fc0270",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20050"
      ]
    },
    {
      "uid": "zhcn:3f950e6d8f1e490a3d24919e",
      "kind": "character_system_text",
      "source_text": "好～的，我来帮忙哦♪",
      "source_fingerprint": "88dd5332c87990375859193204129d2f7460c5fdf6b0b3fbd8f4b3b9ca6d2842",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "20051"
      ]
    },
    {
      "uid": "zhcn:9ff7fac1b9a699cbb280095b",
      "kind": "character_system_text",
      "source_text": "开始紧张了～…！",
      "source_fingerprint": "3f57e4c0f62171346061d8dcfad68692d7e50cb694e73e6ce63fd32169eab3d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "2030"
      ]
    },
    {
      "uid": "zhcn:dc5916a2395a0b65760eabfe",
      "kind": "character_system_text",
      "source_text": "大家，一起加油吧！",
      "source_fingerprint": "f271104311b6a4f560215183e96f985902a8005901c389898a651f0a43bf6989",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "2031"
      ]
    },
    {
      "uid": "zhcn:c4e6a03957fb29b0ef14fac2",
      "kind": "character_system_text",
      "source_text": "托您的福我才能坚持到现在！",
      "source_fingerprint": "d9bdc8e61f0f608d7d1b85f0bd328a7df6e6621b0fac3d67dcf48103d0fc0270",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "2032"
      ]
    },
    {
      "uid": "zhcn:8cdba7cf303a84e127a3116a",
      "kind": "character_system_text",
      "source_text": "哇～，好多人啊…！虽然很紧张\n……但要是能在这里成为主角，\n一定会是最棒的吧。",
      "source_fingerprint": "9852f9d5449adf5936cf95222fcf3e280e9498b9c1f12ba0963a0c488a178938",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "2033"
      ]
    },
    {
      "uid": "zhcn:fe70ba9eb7988871fc340567",
      "kind": "character_system_text",
      "source_text": "大家都盯着主角的位置……但是，\r\n论这份心意，我也不会输…！\r\n……我会赢回来的！训练员！",
      "source_fingerprint": "696ceae17e613d7a3bea4c601b3d0f070f7ffb5b92c31a5ab6fe8d67167e1571",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "2034"
      ]
    },
    {
      "uid": "zhcn:7df291651aa1531565e35412",
      "kind": "character_system_text",
      "source_text": "托您的福我才能坚持到现在！",
      "source_fingerprint": "d9bdc8e61f0f608d7d1b85f0bd328a7df6e6621b0fac3d67dcf48103d0fc0270",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "2035"
      ]
    },
    {
      "uid": "zhcn:b9f000beac49015750a324a5",
      "kind": "character_system_text",
      "source_text": "加油！",
      "source_fingerprint": "54ce5981946278daacd326ac0aa9463334476cc4c88beeec688628a4bb2fb3d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "23015"
      ]
    },
    {
      "uid": "zhcn:5936aac6b3b7f060476ee695",
      "kind": "character_system_text",
      "source_text": "下次，下次一定要当上主角…！",
      "source_fingerprint": "fee6efab0e738536898ce00422278414031e619ca86d4f68a8ded1abe60f5eb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "30000"
      ]
    },
    {
      "uid": "zhcn:ea64be5e955ff33165969bec",
      "kind": "character_system_text",
      "source_text": "现在，还触及不到吗……我的梦想…！",
      "source_fingerprint": "174befacfe53f939a030d4395aca0bb409a8a7fa6cd6a75f6d28d32b8d350e53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "30001"
      ]
    },
    {
      "uid": "zhcn:0e26d8a8123809312fef2562",
      "kind": "character_system_text",
      "source_text": "别说主角了，连对手都算不上…。",
      "source_fingerprint": "2da7f786a1b70ce1be910ad6862ae5dfd6bf8f4c06ed91edb6eb6c2d87bea609",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "30002"
      ]
    },
    {
      "uid": "zhcn:f8f4e7ec89f7dc9379daaf37",
      "kind": "character_system_text",
      "source_text": "果然，只是配角吗…？",
      "source_fingerprint": "393adba00ecc334e5168b22890696f25283cbb7532a131f9dd8dc6348d054fbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "30003"
      ]
    },
    {
      "uid": "zhcn:af17492563c3181cdf5109ca",
      "kind": "character_system_text",
      "source_text": "今天的主角是我！…诶，嘿嘿…！",
      "source_fingerprint": "826317d7eb08e37a38072564998545bc8fe2ac43d2fb96da9774e469fb1abd26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "30004"
      ]
    },
    {
      "uid": "zhcn:5b8f915d13f04388b7f9ecdf",
      "kind": "character_system_text",
      "source_text": "大，大家好…！我，我是今天的主角！",
      "source_fingerprint": "9fcf6d4b4a3f8b0051950fa45b877edf94fd516741faf5891c5ed93de4b6c7f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "30005"
      ]
    },
    {
      "uid": "zhcn:7c0096d3974f92c1105c9225",
      "kind": "character_system_text",
      "source_text": "总之就是努力！",
      "source_fingerprint": "a5c0a48acfffdb5ab56f1fd49fdbe2462c9fbef58c289715e74c122777fd7493",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "31000"
      ]
    },
    {
      "uid": "zhcn:3711d961e0a41c74c9ed43d0",
      "kind": "character_system_text",
      "source_text": "我，要成为主角！",
      "source_fingerprint": "ea8d9b4c8a3e736db433ddd7aa76eccf0784c423082b23b714a9d897334286d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "40000"
      ]
    },
    {
      "uid": "zhcn:aacc287f00a1a5701f97314a",
      "kind": "character_system_text",
      "source_text": "现在的我，怎么样？\r\n希望能用『欢迎回来～』，反过来\r\n让前辈感到温暖……呵呵。",
      "source_fingerprint": "3c0bea7374ad9a9290ec2fb0eacc6799744c0ac6cd7efe6b676c3b9c230755b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
        "400007"
      ]
    }
  ]
