      ]
    },
    {
      "uid": "zhcn:da938c268420371f111a4c72",
      "kind": "character_system_text",
      "source_text": "在舞台中央跳舞……真好啊，好憧憬呢。",
      "source_fingerprint": "fc94a510a549af066402453f2aacdb5e2406853b6c5e073ea9595f9815360c99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1092",
