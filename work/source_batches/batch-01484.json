    {
      "uid": "zhcn:2922d72477b535c3d4cf0f39",
      "kind": "character_system_text",
      "source_text": "果然还是大一号的尺寸比较……不不。",
      "source_fingerprint": "eadd30b498368cff9a3b01a6f3c96ffa54132ed5a42bce7d9abd4bb98629d51b",
      "source_path": "character_system_text_dict.json",
