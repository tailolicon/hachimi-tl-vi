  "entries": [
    {
      "uid": "zhcn:dbcaa4cf49166fff7b3e0ba4",
      "kind": "character_system_text",
      "source_text": "レースか！ロマンを求めて\r\n走りだそうぜ！",
      "source_fingerprint": "446fdda0483edf792c61261d299b29c64dc7b7f48641b73f436b5f827c02db15",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "110002"
      ]
    },
    {
      "uid": "zhcn:8867815dea9b2c543be59aec",
      "kind": "character_system_text",
      "source_text": "魅せてやるさ！",
      "source_fingerprint": "030189a169c959c9cc40f9c1f5015791e64cc226f054bea12b07af214b3b84df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "1183"
      ]
    },
    {
      "uid": "zhcn:002d1d9882750b2eb0ac9050",
      "kind": "character_system_text",
      "source_text": "Let's get this show on the road!",
      "source_fingerprint": "ec55bd055d180894516a364cec9cfbb3830ac64be174616c1e1615018619fbb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "1184"
      ]
    },
    {
      "uid": "zhcn:65eedb0e48e8ea77478b6e01",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "12"
      ]
    },
    {
      "uid": "zhcn:9a10d079c4b16e41f26fc7ca",
      "kind": "character_system_text",
      "source_text": "力がみなぎる…情熱が踊る！",
      "source_fingerprint": "cb1b4b1a0bd30c2d181bce374dcf04d9fbdbf8fa6c84a3a896e5df1bcb177c8b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "120000"
      ]
    },
    {
      "uid": "zhcn:914c89431cdb14cfd86b8d8f",
      "kind": "character_system_text",
      "source_text": "Yeah!\r\n今日のログインボーナスだ！",
      "source_fingerprint": "c4d8f8a8130a400b21ee0ac9803d2e18bf65a7f0cce15e8d80e46100cea600ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "13"
      ]
    },
    {
      "uid": "zhcn:e446a94943c659213a189e86",
      "kind": "character_system_text",
      "source_text": "Let's start！",
      "source_fingerprint": "d29b4ec43f0c03b0a0ac48497f22c160a7f20bf67eb0ac243b5a71ab6627794c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140000"
      ]
    },
    {
      "uid": "zhcn:17d79fb185c166449c5185a7",
      "kind": "character_system_text",
      "source_text": "Yes!",
      "source_fingerprint": "8aff5108a050bcfab25817bf86c37c2660c09db0c5cbea06cb49565c6644e7d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140001"
      ]
    },
    {
      "uid": "zhcn:aa7ed837ddde6645222de5c9",
      "kind": "character_system_text",
      "source_text": "Oh….",
      "source_fingerprint": "8d028f424a88ee0d992d896c31e34f12f3111b44ed306399951554eaadbd57f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140002"
      ]
    },
    {
      "uid": "zhcn:af4ac48808124ec1daf9ace5",
      "kind": "character_system_text",
      "source_text": "Awesome!",
      "source_fingerprint": "67f68a72462bca9b1642747164bcc1fac7a3d5340059f4ce99dc77ee9829bb6c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140003"
      ]
    },
    {
      "uid": "zhcn:8d0e6facbac6d2ff84db8c2a",
      "kind": "character_system_text",
      "source_text": "ヒュウッ！器用だなアンタ！",
      "source_fingerprint": "a387dee352f99f044ff9c86d5ca34535691a5009dff3ae8a6ed16e59fb025144",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140004"
      ]
    },
    {
      "uid": "zhcn:a6f2d2962df67d12a0e6fa51",
      "kind": "character_system_text",
      "source_text": "…ま、そう落ち込むなって！",
      "source_fingerprint": "3a0bfe68b2e60495332ee78f51b580718dafe16df81aa698be4a98d31baa16be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140005"
      ]
    },
    {
      "uid": "zhcn:99cf1828dd758b9e7f65e383",
      "kind": "character_system_text",
      "source_text": "Awesome!",
      "source_fingerprint": "67f68a72462bca9b1642747164bcc1fac7a3d5340059f4ce99dc77ee9829bb6c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140006"
      ]
    },
    {
      "uid": "zhcn:0e3fabc0cdf883bd49c2a109",
      "kind": "character_system_text",
      "source_text": "ヒュウッ！器用だなアンタ！",
      "source_fingerprint": "a387dee352f99f044ff9c86d5ca34535691a5009dff3ae8a6ed16e59fb025144",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140007"
      ]
    },
    {
      "uid": "zhcn:e6b6a5e3732b720532a7ba25",
      "kind": "character_system_text",
      "source_text": "んっ？",
      "source_fingerprint": "d4d329b3f70eaec316e16399002d7d92c4a4f648732904888cb6034acd2901e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140008"
      ]
    },
    {
      "uid": "zhcn:e1fb986eb256e2c4a826399c",
      "kind": "character_system_text",
      "source_text": "よーく狙っていこうぜ。",
      "source_fingerprint": "f3ac60ff0382023bdc19450fba86601cb6e5cb6d397c264d15cfad388883316b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140009"
      ]
    },
    {
      "uid": "zhcn:5b89a8075ee0dcef9a70a194",
      "kind": "character_system_text",
      "source_text": "なんだい？",
      "source_fingerprint": "0e65cff605edb191f605f6529ba697205afa2d7c033794841a458d601b06d81f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140010"
      ]
    },
    {
      "uid": "zhcn:22a97f8cf840bc32ed536d76",
      "kind": "character_system_text",
      "source_text": "よし逃すな！",
      "source_fingerprint": "97b07397a92bbf95ff0d2bab8ef6d9cd6b13ff18439b4d99fa39a31e9855348d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140011"
      ]
    },
    {
      "uid": "zhcn:512085f015dfee35ca177351",
      "kind": "character_system_text",
      "source_text": "おっし！大漁！",
      "source_fingerprint": "8c28052e9f8d5cbe4a098954fa898373795004d555cad5469e7b4a6d7307a82e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140012"
      ]
    },
    {
      "uid": "zhcn:f5a38ded6056a1faa4b109d2",
      "kind": "character_system_text",
      "source_text": "よーし、いい子たちだ！",
      "source_fingerprint": "b9adb40377888b632baf262e92b2afcae67a7594c7fde1a9bdd4eac3b49ac879",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140013"
      ]
    },
    {
      "uid": "zhcn:c759c7409b970b8c26015b62",
      "kind": "character_system_text",
      "source_text": "Crap!惜しいっ！",
      "source_fingerprint": "6af55a0f52ea3113f5fbee1715b1c27919260ca648dd247de9ea6173a9056241",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b5dd88c6aad71045591f95c4",
      "kind": "character_system_text",
      "source_text": "ふっふ～ん♪",
      "source_fingerprint": "4fa7608959416c94eece652a1b2d031a7f441785b932f422b1893eb76f31d2f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140015"
      ]
    },
    {
      "uid": "zhcn:71de4f6b3e39953ea2c3d617",
      "kind": "character_system_text",
      "source_text": "腹は決まったか？",
      "source_fingerprint": "94447e3f3a5641bd236eb3c79719bc06203ee7007dfb8e5c3c14ecc8a7804879",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140016"
      ]
    },
    {
      "uid": "zhcn:49a3af5eae8a08f6214b95fa",
      "kind": "character_system_text",
      "source_text": "あっ！もったいねぇ…！",
      "source_fingerprint": "866d7db7a5bbfefb3b3d1bd02e265b38c31b45b1c75b9be6bbfa4ebb8b055ea7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140017"
      ]
    },
    {
      "uid": "zhcn:2cbd7ba2a0056534f36bec2c",
      "kind": "character_system_text",
      "source_text": "クソッ。",
      "source_fingerprint": "bed3efd125e281e6983ef6b313386aa9f084cd46b752d03d288e0c6dd3ba8544",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "140018"
      ]
    },
    {
      "uid": "zhcn:0a68da40dd07fdcb88bda7bb",
      "kind": "character_system_text",
      "source_text": "明日のお宝もお楽しみにっ！",
      "source_fingerprint": "6af008dc02d5af73de0f01e0b3c9d2f95450988e7bef97986c22bcf154b50fb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "15"
      ]
    },
    {
      "uid": "zhcn:5a06d8f340c5f4b18ebd2bc9",
      "kind": "character_system_text",
      "source_text": "ん～、ステップが冴えない…\r\nもう今日はノらない！\r\nや～す～ま～せ～ろ～！",
      "source_fingerprint": "626cd4ce0720ffc7d17c5516034fe006613f34eaf07cd27829fee8694ee48170",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20000"
      ]
    },
    {
      "uid": "zhcn:6b6a02242257711fca1b20a0",
      "kind": "character_system_text",
      "source_text": "オール後よりしんどいな…\r\nおーい、今日はオフでいいだろ？\r\nなぁってば～…。",
      "source_fingerprint": "a6f078d4ec56786824a6cbb76d41637f2fa263f498a8a7aaf23cddac882599ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20001"
      ]
    },
    {
      "uid": "zhcn:609932212895d800ba17cde4",
      "kind": "character_system_text",
      "source_text": "Okay!いつでもいいぜ！\r\nアタシが軽くリズムを刻めば、\r\n最高記録も躍り出るってな！",
      "source_fingerprint": "ab36307cdd6183eed96f73fd6a634847cfaafa65365c00acc0788d2a9dbad0ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20002"
      ]
    },
    {
      "uid": "zhcn:54fb429b149f34229bb763f6",
      "kind": "character_system_text",
      "source_text": "ここに最っ高の状態のアタシが\r\nいる。ということは？さあ、\r\nどんなメニューでも聞かせてみな！",
      "source_fingerprint": "e9837db2f5a2289cef25a533fd61608214985467008ff763e912cf744298ad1e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20003"
      ]
    },
    {
      "uid": "zhcn:61dccd09070967832851722c",
      "kind": "character_system_text",
      "source_text": "ついさっきまで、教室で菓子パを\r\nやってきたんだ！騒いで笑って\r\n元気チャージ完了さ！",
      "source_fingerprint": "3aba1b5815d060a96511aece9ac561358a9be8eab52b994e3c503601b3c3e16b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20004"
      ]
    },
    {
      "uid": "zhcn:4403503eb16d034a8fdeff56",
      "kind": "character_system_text",
      "source_text": "Yo ho！アンタの考えた\r\nメニューを見せなよ。\r\nそいつが今日の航海図だ！",
      "source_fingerprint": "e3f383994b8e72c68d8328a38a247fad1f5d4ba019069d9b91c62d62782e64b0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20005"
      ]
    },
    {
      "uid": "zhcn:8dbaaa264ade3db0d5e72bf5",
      "kind": "character_system_text",
      "source_text": "ま、ボチボチ始めるか。\r\nビートとパッション、それに少しの\r\n汗があればノれるってもんだ！",
      "source_fingerprint": "5a74eb9ac0ffb19ec35d8000a22cda8aa852dfe3e01679275d460fddda958e60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20006"
      ]
    },
    {
      "uid": "zhcn:d890060f78f50a4dbc5c373d",
      "kind": "character_system_text",
      "source_text": "ん～、もうちょい勢いが欲しいな…\r\nそうだ、ご機嫌な音楽を流そう！\r\n少しは気分も上がるだろ。",
      "source_fingerprint": "c7c5f1697108258b0f286bf53d662d20f31760aec8a93782c141afb05bf14c3b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20007"
      ]
    },
    {
      "uid": "zhcn:fa449078c7f14be3b5a49915",
      "kind": "character_system_text",
      "source_text": "…パッとしないな…\r\nこういう時はパーティーだ！\r\n景気づけに今すぐ開こう！",
      "source_fingerprint": "2ce4eb4ce6dbbe69961f6d93faee6a7a7772bfa1c619a8f8a77d05f4824a1e44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20008"
      ]
    },
    {
      "uid": "zhcn:7eff61d44d4c47136de06a50",
      "kind": "character_system_text",
      "source_text": "Um…よし、様子見て切り上げも\r\nアリだ！気分がノらない時は、\r\nスパッと切り替えるのも大事だ！",
      "source_fingerprint": "66cf83ce7b08bc0824a8a62f6f686838ad46aaac896288716fcbcd4e6d12a725",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20009"
      ]
    },
    {
      "uid": "zhcn:49faf8f4a0241237ba48c17e",
      "kind": "character_system_text",
      "source_text": "航海士殿～、今日はよさないか？\r\nノらない時に走ったって、\r\nつかめるもんは少ないだろ？",
      "source_fingerprint": "df5abfc319c12f2f03ccebb1fdf068859dcd044197b7eb32ddef4280b6e70d5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20010"
      ]
    },
    {
      "uid": "zhcn:d85801c1c5120f8f1b8663ae",
      "kind": "character_system_text",
      "source_text": "なんか景気のいい話、頼む～…\r\nじゃなきゃ、やってらんねぇ～…。",
      "source_fingerprint": "7242f40a184b55dc5b4f594d624e3b22f643b6205821a62aba6b4cbc66368e0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20011"
      ]
    },
    {
      "uid": "zhcn:17a8bc05a66403824299bb21",
      "kind": "character_system_text",
      "source_text": "Seriously?\r\nこんなに続けてレースなんて、\r\nアンタどういう心づもりだ？",
      "source_fingerprint": "c6d77a2278567d6c901ad5bdb61160e29f227f281989510c417d2c78b65214b7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20021"
      ]
    },
    {
      "uid": "zhcn:2b2c86babc4c22a5421e5509",
      "kind": "character_system_text",
      "source_text": "船が沈んだら元も子もないぜ？\r\n考え直せよ。",
      "source_fingerprint": "d91839411fe349399aebc83a7fb404c6be43f7d07ecd9efb9465e1e95fd85658",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20022"
      ]
    },
    {
      "uid": "zhcn:21f7c79155bdbd7dba88eba8",
      "kind": "character_system_text",
      "source_text": "調子はベスト、舞台は整った！\r\n待ってろよ、everyone！\r\n最高のレースの幕開けだ！",
      "source_fingerprint": "5e6859bc2692e71bec5706a679d339c944dd08b7e7f8eaf3e53c57d1963cd11f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20023"
      ]
    },
    {
      "uid": "zhcn:74b296777cc7f1771e11e16d",
      "kind": "character_system_text",
      "source_text": "今日は会場中が沸き立つだろうな！\r\nアタシの走りを見たら、誰もかれも\r\n熱狂せずにはいられないはずさ！",
      "source_fingerprint": "1e408d302c727cea406279486acaa33700c7699e2c5572567c54a692b1c3b68d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20024"
      ]
    },
    {
      "uid": "zhcn:1e77fafa5c7e00963558eb49",
      "kind": "character_system_text",
      "source_text": "ハハッ、今なら手に入らないもんは\r\nない！さあ、ロマンも名声も\r\nアタシがいただくぞ！",
      "source_fingerprint": "86c0f079810a54bf2c2e0cf6a153d0737450bbb6d2a59e5badbb024d13675cbe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20025"
      ]
    },
    {
      "uid": "zhcn:179636caac404bc0239abca6",
      "kind": "character_system_text",
      "source_text": "風向き上々！いい船旅ができそうだ\r\n出航と行こうか、トレーナー。\r\n向かう先は…勝利！そして名声だ！",
      "source_fingerprint": "d185663d04baab48780b2808a325c070bfa0f771e7d81d47c7e1c760d8dffbe5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20026"
      ]
    },
    {
      "uid": "zhcn:ba2c5fb4e2338c206dbc1a77",
      "kind": "character_system_text",
      "source_text": "なかなかの調整だ！\r\nみんなアタシのリズムに釘付けに\r\nなるだろう！もちろん、アンタも！",
      "source_fingerprint": "67207ec8b844671e40d9d2abac88e590a11316fdf6dea313e89f3609b99f0096",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20027"
      ]
    },
    {
      "uid": "zhcn:e93d31f8e5ae82450ebbf5dc",
      "kind": "character_system_text",
      "source_text": "これだけ整っていれば十分！\r\nさ、始めようじゃないか。\r\nロマンを求めて、今日も走るぞ！",
      "source_fingerprint": "387f21e79c9d21b6f84930a050c3f9c24495378cd79ae73a43891102cb1525df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20028"
      ]
    },
    {
      "uid": "zhcn:ad32f5a84eca2ac8f449b132",
      "kind": "character_system_text",
      "source_text": "ま、今は燃えていなくても問題ない\r\nボルテージならこれから上げて\r\nいくさ！アタシの、この脚でな！",
      "source_fingerprint": "ae715c43ef2314f9c13c248268a40a77e5c33935944436fb18673c85201b8402",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20029"
      ]
    },
    {
      "uid": "zhcn:1f997eb0bcddc6b37c3ac757",
      "kind": "character_system_text",
      "source_text": "どこでも笑えるのがアタシの\r\n強みだからな。今はパッとしなく\r\nても、レースが始まれば…さ！",
      "source_fingerprint": "2ae90d261e54b603ae4bc6cac9e1169551d89174ee4419824903d8907a1fcb06",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20030"
      ]
    },
    {
      "uid": "zhcn:fddc054818187ac8ff95b1ce",
      "kind": "character_system_text",
      "source_text": "Hm…調子は良くも悪くもなく。\r\nそれじゃ、ここから上げていこう！\r\n波に乗らないと、だろう？",
      "source_fingerprint": "ef5d3b14f2bb20dd972b0ff624a51d9643ae914662033934d88148607642ce4d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20031"
      ]
    },
    {
      "uid": "zhcn:4af1d3bd7d02a2f230bcfe7f",
      "kind": "character_system_text",
      "source_text": "調整不足とか、細かいことはもう\r\n気にしても仕方ない。今を楽しめ！\r\n今を感じろ！それだけさ！",
      "source_fingerprint": "a453f07981c13a1ad0e09d164492fa34ece55e94c564380ba9438746d10318a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20032"
      ]
    },
    {
      "uid": "zhcn:a614f59e66cd84c9b7df4bb1",
      "kind": "character_system_text",
      "source_text": "調整はイマイチだが、どんな航海に\r\nだって嵐は待ち構えているものさ。\r\nむしろ燃えるってもんだ、ハハッ！",
      "source_fingerprint": "df1bc72b68cc535f2a7c88299fef93aae01c8a8accf8d4f60c43a9fc5553f9d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20033"
      ]
    },
    {
      "uid": "zhcn:4695f3aceb9f927b6f12ba15",
      "kind": "character_system_text",
      "source_text": "調子がイマイチでも、いつだって\r\nそこにいるヤツらと楽しむって\r\n決めてんだ。さあ、宴に向かおう！",
      "source_fingerprint": "7969e88ec409a2d43949b3b6ad30c9eace525d71de13778d5282f8746b4cb7d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20034"
      ]
    },
    {
      "uid": "zhcn:1c55c81844724b9f62ae0308",
      "kind": "character_system_text",
      "source_text": "せっかくのショータイムに、\r\nこんな重い脚で来ちまった！\r\n…ま、逆境だってオツなもんさ。",
      "source_fingerprint": "8503d3b06237d8a58defc8b0c4693898d18c813a45f747b570802b8ee4d7f7c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20035"
      ]
    },
    {
      "uid": "zhcn:7d1345f4d4a77857fc7caf29",
      "kind": "character_system_text",
      "source_text": "調子っぱずれな曲が足元を\r\n狂わせているような…そんな感覚だ\r\nまあ、イマイチでもやってやるさ。",
      "source_fingerprint": "3e0d8a054e034efe3b5bf4a7145defc58cc8d30d1f6545e7a4d8f31aed5edafd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20036"
      ]
    },
    {
      "uid": "zhcn:7e4c2f8f97587bdc711958d8",
      "kind": "character_system_text",
      "source_text": "試されてるのか…？まあ、いいさ。\r\n城も、夢も、ロマンも…全部手に\r\n入れるとこ、見せてやる…！",
      "source_fingerprint": "cfcbaeeded80f98dc45f46e17c31d8e83d40e3cc9e1ca97e62f22812953ddbc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20037"
      ]
    },
    {
      "uid": "zhcn:35cee1ef616f2062fa5474b0",
      "kind": "character_system_text",
      "source_text": "始めよう！",
      "source_fingerprint": "2c28d8c17e90bdb78b07f71914dd1c96c0080d88f35e7f8a8a57add7f9b4925c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20038"
      ]
    },
    {
      "uid": "zhcn:8742f606210cdb47ea342b70",
      "kind": "character_system_text",
      "source_text": "任せな！",
      "source_fingerprint": "df2a172c7ac6302292c63714f233a333f6ef8ed0c1385142b9e410bd13b48644",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
        "20039"
      ]
    },
    {
      "uid": "zhcn:7acf77bc4ed2d52e9956d704",
      "kind": "character_system_text",
      "source_text": "My Turn!",
      "source_fingerprint": "e32542d78ce1a8a954bc41f3a412651cf3dcfa297f7b79ef6519229b2f6f4190",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1107",
