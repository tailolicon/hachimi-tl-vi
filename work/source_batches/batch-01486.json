      ]
    },
    {
      "uid": "zhcn:48453d6da632f08a03e1f453",
      "kind": "character_system_text",
      "source_text": "羽目を外すぞ！",
      "source_fingerprint": "24fc22dbe138fad2a05f328f3c9006a7275acdc12d6db860bdcb497f2ce49857",
      "source_path": "character_system_text_dict.json",
      "json_path": [
