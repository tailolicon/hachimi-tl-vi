      "kind": "character_system_text",
      "source_text": "还不错。",
      "source_fingerprint": "c671c74f1262c22b0ace2c4f45a9eb87b43eec6dae705124b28e1d9980db4756",
      "source_path": "character_system_text_dict.json",
