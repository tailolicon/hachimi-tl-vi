      "kind": "character_system_text",
      "source_text": "地表的流星雨……！",
      "source_fingerprint": "82a791a4ecbcbb25f70a4f9df0c9ae2f1eaaf362cfe1726e8ae7cfe4eadf210b",
      "source_path": "character_system_text_dict.json",
