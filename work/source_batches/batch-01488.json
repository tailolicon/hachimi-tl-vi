      ]
    },
    {
      "uid": "zhcn:36b95cb0efd08c88c1dc5770",
      "kind": "character_system_text",
      "source_text": "互相吸引……！",
      "source_fingerprint": "7e40cf1398a313b1b866be0056bd918f8da6e4d71dde2152aa7855a30bc8d4fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
