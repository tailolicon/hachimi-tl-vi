{
  "schema_version": 1,
  "batch": 1489,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:04230772d76abc607636bd80",
      "kind": "character_system_text",
      "source_text": "呵啊……",
      "source_fingerprint": "f281048bdf225d6f2537028fb2d0671e422c20dac30bd492273634be14101bbd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "20043"
      ]
    },
    {
      "uid": "zhcn:565e00b6611c59901708fae4",
      "kind": "character_system_text",
      "source_text": "朝「信号」出发。",
      "source_fingerprint": "921a38cbf11e4143bb5dffa8bf6cbf7549fca00c04e4743ae9639043fc6a2b9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "20046"
      ]
    },
    {
      "uid": "zhcn:eeb416566e6166ebc321ca85",
      "kind": "character_system_text",
      "source_text": "解放自身吧。",
      "source_fingerprint": "1c6f84f08da52af32e27a838c44fee6bd41420a2c7340116e987d69b9d7acc39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "20047"
      ]
    },
    {
      "uid": "zhcn:2df21fb086621c9e465cad75",
      "kind": "character_system_text",
      "source_text": "已抵达拉格朗日点。谢谢你。",
      "source_fingerprint": "3c4f9e180529b145575bb8d16fbda308b84f04b13150c856b3cd1390d5938bc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "20049"
      ]
    },
    {
      "uid": "zhcn:97b9702d2589214e10b4a912",
      "kind": "character_system_text",
      "source_text": "又证明了一个理论呢。",
      "source_fingerprint": "3ab8a37bfef206b8938613237003cee11f12b9c4bd9c67b88650cacb9148fb14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "20050"
      ]
    },
    {
      "uid": "zhcn:848ffd65565eecd26f1e809e",
      "kind": "character_system_text",
      "source_text": "この座標で、連なるよ。",
      "source_fingerprint": "e0bad4f22d3b1befcbfa62f62bbeaeccadfa8957b2d6d898abe32cc52b14ca90",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "20051"
      ]
    },
    {
      "uid": "zhcn:4416ee344a2522fee56341c2",
      "kind": "character_system_text",
      "source_text": "开始倒数。",
      "source_fingerprint": "c8221b3cc29ad43be1328cc2df3e14feff6c04081f5298facc5137131ca79386",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "2030"
      ]
    },
    {
      "uid": "zhcn:49fcd275ce99fbd5cbbcf4b1",
      "kind": "character_system_text",
      "source_text": "我将展现……莫比乌斯环。",
      "source_fingerprint": "b2a4763b37b4e1e7bb54c376fd3d5cdfc96fcb0fffda06f1a470362af3594c29",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "2031"
      ]
    },
    {
      "uid": "zhcn:953951a2d073077d7abc7a51",
      "kind": "character_system_text",
      "source_text": "又证明了一个理论呢。",
      "source_fingerprint": "3ab8a37bfef206b8938613237003cee11f12b9c4bd9c67b88650cacb9148fb14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "2032"
      ]
    },
    {
      "uid": "zhcn:551e4cfcc643e87215ed5dcc",
      "kind": "character_system_text",
      "source_text": "调整的「向量」相当良好呢。\r\n希望能表现得超乎预测。",
      "source_fingerprint": "a13014b01738a0d8375d75236eb875ead46752bd04365ed42af32256b6616453",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "2033"
      ]
    },
    {
      "uid": "zhcn:409318834fa9334f11fe8356",
      "kind": "character_system_text",
      "source_text": "地球重力帮了我一把……\r\n凭借着这股气势进行「重力助推」。\r\n我「似乎能够跑出」最佳表现哦。",
      "source_fingerprint": "4ccdaf310d4c1e5c61a63d0f07250942357ebba49c4c43850d38adeeb85ce352",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "2034"
      ]
    },
    {
      "uid": "zhcn:72a34e4706a948548d8edc9a",
      "kind": "character_system_text",
      "source_text": "又证明了一个理论呢。",
      "source_fingerprint": "3ab8a37bfef206b8938613237003cee11f12b9c4bd9c67b88650cacb9148fb14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "2035"
      ]
    },
    {
      "uid": "zhcn:97d1efc31f56b36f8a688daa",
      "kind": "character_system_text",
      "source_text": "実行する。",
      "source_fingerprint": "3695ecd8288905f62e3f0b73e4bd64d4f6c9b821e3afce4fb116fbc6e2edaf6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "23015"
      ]
    },
    {
      "uid": "zhcn:3ff18a2f4b4e83ad7f8f6a52",
      "kind": "character_system_text",
      "source_text": "理想的近似值。\r\n下次还要更加接近……！",
      "source_fingerprint": "f1b9f096c119223e00d95ad8fa2bb3bbd2e26434e4056e39c9434290a2570a10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30000"
      ]
    },
    {
      "uid": "zhcn:e3519ba1ad807adcea0bfa92",
      "kind": "character_system_text",
      "source_text": "我想超越「半人马小行星」，\r\n变得更加明亮。",
      "source_fingerprint": "4f8ad9873109ca263d41c8dabd172ec0fd4277c90f823802f5b813c4698693c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30001"
      ]
    },
    {
      "uid": "zhcn:042c2afe25ba35de3978550c",
      "kind": "character_system_text",
      "source_text": "低于预测落点……\r\n将于下次修正。",
      "source_fingerprint": "de26e0913494c895e85168eaf8e8dd8249f62d2fe5fb9591cb608f997adf0d45",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30002"
      ]
    },
    {
      "uid": "zhcn:8dc08de81d6c9a8aa63a367f",
      "kind": "character_system_text",
      "source_text": "信号不佳……「通讯」失败……",
      "source_fingerprint": "43861b6d76d14233232dd1066676c81815d09d042814e1000ef7068fdde484a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30003"
      ]
    },
    {
      "uid": "zhcn:6b85325f548132913c9cdb35",
      "kind": "character_system_text",
      "source_text": "哈啰、哈啰。\r\n「我」感到很「满足」喔。",
      "source_fingerprint": "aa9ea15cad0e210c753085a088a85cea89203d5b7549fa38af2eee087c00eb95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30004"
      ]
    },
    {
      "uid": "zhcn:7f75b6d3c544911fa39238cc",
      "kind": "character_system_text",
      "source_text": "「我」也实现自己的\r\n「星辰闪烁」了。",
      "source_fingerprint": "4329a74f4d0d34cf8b4b55022453d3e6e57fd668367df69f3678d330a150ce6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30005"
      ]
    },
    {
      "uid": "zhcn:d0c7353a6fde187e9ac63d9f",
      "kind": "character_system_text",
      "source_text": "歓喜――月まで“リフトオフ”『できそう』だよ。",
      "source_fingerprint": "c708211a3d0f94a74701d3352f7c287bbdb82e78b1fd7f1ff76ecdc0aa79b2ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30006"
      ]
    },
    {
      "uid": "zhcn:d24315ade6b56a6a04a5d8a1",
      "kind": "character_system_text",
      "source_text": "到達したよ。『わたし』の\r\n“シンチレーション”。",
      "source_fingerprint": "4b5b8f93b9f24e80fc35d33a114e11dfcd704948d1f00cee4ea745da1844a771",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "30007"
      ]
    },
    {
      "uid": "zhcn:7912b52aab2e8b1024ba1efc",
      "kind": "character_system_text",
      "source_text": "准备要来一趟逼近飞行了呢……！",
      "source_fingerprint": "b848e0cec865402d785f8bdf075715d21515f7d4de7aad408af0e2aefcaa5f4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d957dce1611259e58718f9d4",
      "kind": "character_system_text",
      "source_text": "肯定，就从这里开始……！",
      "source_fingerprint": "4372e5868408da77fbac866e66f076d77f9e967f2d689aae40c5220120988737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "40000"
      ]
    },
    {
      "uid": "zhcn:9cc271d1bc6f5537b5420a81",
      "kind": "character_system_text",
      "source_text": "明日…ゼンノロブロイへの\r\n“GIVU”は『納豆シャーベット』\r\n『差し入れ』“JST”目指したい",
      "source_fingerprint": "7d99a9951cdb269996cb06223a508d866ac715054f3b90d90eea0594475a67d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "400003"
      ]
    },
    {
      "uid": "zhcn:0689573e87f2a93ae18b44db",
      "kind": "character_system_text",
      "source_text": "“冥王星のレジオ”“220,284”\r\n“ZEER”“EVEU”――\r\nスィーノック…今なら、『届く』？",
      "source_fingerprint": "cfa1a2e241aac398b6630f2e792e4a17af221bfae383000b6a2320479a8038bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "400008"
      ]
    },
    {
      "uid": "zhcn:96f7fdfe374035e0cf25ef18",
      "kind": "character_system_text",
      "source_text": "“窓”の向こう…“ペルセウス”の\r\n光彩は見えてる。この宇宙の\r\nロブロイなら“FLM”できるね。",
      "source_fingerprint": "0c6f8676968963976cc1d07382a4f2d8899c631745814270b5a6803b4bcd071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "400009"
      ]
    },
    {
      "uid": "zhcn:54e227bc1d58286c8889ade1",
      "kind": "character_system_text",
      "source_text": "……感受到大家的「信号」……！\r\n开始吧……「太空会合」！",
      "source_fingerprint": "e3b670230c756b97a903456144eba628c25a03e106917d330824807280c7637f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "40001"
      ]
    },
    {
      "uid": "zhcn:ccdb315bf2239cef5fa30b6c",
      "kind": "character_system_text",
      "source_text": "“METI”、『半分こ』――",
      "source_fingerprint": "d8d54c96bde46b3a1b1cc304303d1fc9f72ff39cf4ae92dbb09419954caab185",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "40003"
      ]
    },
    {
      "uid": "zhcn:9f185b6607e139a536bc1bc3",
      "kind": "character_system_text",
      "source_text": "あ…『届いた』――！\r\n『あなた』と…\r\nずっと『したかった』んだ――『半分こ』。",
      "source_fingerprint": "d1233ad4d20d3d989d3bd6604dd62dafd735ba07244ce1a6e04047a27318cb09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "40004"
      ]
    },
    {
      "uid": "zhcn:f56332bc5a42470a39caa95a",
      "kind": "character_system_text",
      "source_text": "在地表发光的无数星星\r\n逐渐包围住我。",
      "source_fingerprint": "8b59b443dd3833027fbe6fab3c8829e0e6eebb15e78118156a4acf852cd6189b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "60000"
      ]
    },
    {
      "uid": "zhcn:3a302df232e3a9a96a6f689d",
      "kind": "character_system_text",
      "source_text": "我这就尽情去进行「享受」啰。",
      "source_fingerprint": "36a441f0141960b3352cab6273b69c7a1408311d1f54bf7eba590dace2ab767d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "60001"
      ]
    },
    {
      "uid": "zhcn:1a7619a9370445ecd7dcff84",
      "kind": "character_system_text",
      "source_text": "再一起开始吧。",
      "source_fingerprint": "3bca7e86399e2b77b1d49dc6fb19717ae2297f395fa9c77e3431e92bf9e038f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70000"
      ]
    },
    {
      "uid": "zhcn:1dae66e590de6c65b31343ff",
      "kind": "character_system_text",
      "source_text": "当被记忆下的「链接」的「轨道」，\r\n与被解开的「代码」相连的那瞬间，\r\n崭新的时间便已开始转动了喔。",
      "source_fingerprint": "74928a2465350c9762acc6b4acaca1f2fbd2a895a59213012f407f3838e35488",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70001"
      ]
    },
    {
      "uid": "zhcn:056baf580d30b9a7114a6b08",
      "kind": "character_system_text",
      "source_text": "制服……跟大家一模一样哦。",
      "source_fingerprint": "b73a348d1f22d5db3dfc2c74ef7e8b1974077e5c321fe42b0681038d3e1c54e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70004"
      ]
    },
    {
      "uid": "zhcn:f1bf0f154ccc3d7fd2862635",
      "kind": "character_system_text",
      "source_text": "裙子形状好像威斯特彗星。\r\n大家齐聚一堂时真是美丽。",
      "source_fingerprint": "ba43e15bd9c7cad578d1f3b324f5b75454b64471c50ad3dee90196bb9cefd86f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70008"
      ]
    },
    {
      "uid": "zhcn:8c4c2e58bf11789fa105a242",
      "kind": "character_system_text",
      "source_text": "这套服装造型模仿了整流罩。\r\n能够降低摩擦，令人放心。",
      "source_fingerprint": "d8a83d05f2ce186178f54ebc576fa759094014e66ef25b70a232c6eeaed11e49",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70009"
      ]
    },
    {
      "uid": "zhcn:d09cd68e9f7772180ef04679",
      "kind": "character_system_text",
      "source_text": "一回房我就会立刻脱离长袜。\r\n身心感到解放。",
      "source_fingerprint": "159d34db80e4d3ab561b6f2648895af0ba48e20fa0d13614b24644bd5c064d69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70010"
      ]
    },
    {
      "uid": "zhcn:25a4adbd97a9d914b9d0de8e",
      "kind": "character_system_text",
      "source_text": "舞台是种「共振」。\r\n我想好好珍惜呢。",
      "source_fingerprint": "d823ab45fdba7d992fb64dd51f73e5293856fe84fa8dfd5da039d2cf39553447",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70014"
      ]
    },
    {
      "uid": "zhcn:12e018143eb401e67fa8bde3",
      "kind": "character_system_text",
      "source_text": "决胜服很坚韧。\r\n在其他星球是否也能通用呢？",
      "source_fingerprint": "08e10326235ed5ef22c321d76c885ea5a4a3c879e317ed5f154531cd4fdc4b34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70015"
      ]
    },
    {
      "uid": "zhcn:a7a5ef0cf9f593f74b67a1bb",
      "kind": "character_system_text",
      "source_text": "装着――ゼンノロブロイの“ビジョン”。",
      "source_fingerprint": "d0fdd3a6cab2f9be2c5975b701f259a3b1fe25d38fdcc85a87f6c91fa92940ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70016"
      ]
    },
    {
      "uid": "zhcn:4e9ef651894122a3acf9526b",
      "kind": "character_system_text",
      "source_text": "『おそろい』のチャーム、\r\n揺れるたび、スフィーラ。",
      "source_fingerprint": "e36a58ede3f864ad23d655e421e2c98a15a1f76012bf315779cb1340d660a984",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70017"
      ]
    },
    {
      "uid": "zhcn:b30c29dd6809d0b1ec3b49bf",
      "kind": "character_system_text",
      "source_text": "适合我？还是怪怪的？\r\n我很好奇你的评价。",
      "source_fingerprint": "b42ae6c995b2769e6dc6d8282cc1539747a1e70219e6a33bfaaaa5bd1baa31bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70018"
      ]
    },
    {
      "uid": "zhcn:4f85a61131379072938f9ec7",
      "kind": "character_system_text",
      "source_text": "难道你在「观测」？\r\n……我似乎不太习惯这样。",
      "source_fingerprint": "dbf06472c6fed616ce092d20e6710eafe85c591b5731961e24e0fb2943594390",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "70019"
      ]
    },
    {
      "uid": "zhcn:354d63f470a3234c223bc3b4",
      "kind": "character_system_text",
      "source_text": "制服……跟大家一模一样哦。",
      "source_fingerprint": "b73a348d1f22d5db3dfc2c74ef7e8b1974077e5c321fe42b0681038d3e1c54e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71004"
      ]
    },
    {
      "uid": "zhcn:2e6e566cee6c0d8e861ec665",
      "kind": "character_system_text",
      "source_text": "裙子形状好像威斯特彗星。\r\n大家齐聚一堂时真是美丽。",
      "source_fingerprint": "ba43e15bd9c7cad578d1f3b324f5b75454b64471c50ad3dee90196bb9cefd86f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71008"
      ]
    },
    {
      "uid": "zhcn:1f44858eb2ed8b7fea6383e8",
      "kind": "character_system_text",
      "source_text": "这套服装造型模仿了整流罩。\r\n能够降低摩擦，令人放心。",
      "source_fingerprint": "d8a83d05f2ce186178f54ebc576fa759094014e66ef25b70a232c6eeaed11e49",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71009"
      ]
    },
    {
      "uid": "zhcn:c3d9cdd28145b00c3c05ed40",
      "kind": "character_system_text",
      "source_text": "一回房我就会立刻脱离长袜。\r\n身心感到解放。",
      "source_fingerprint": "159d34db80e4d3ab561b6f2648895af0ba48e20fa0d13614b24644bd5c064d69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71010"
      ]
    },
    {
      "uid": "zhcn:a3b435279ba9a2a82c96126a",
      "kind": "character_system_text",
      "source_text": "舞台是种「共振」。\r\n我想好好珍惜呢。",
      "source_fingerprint": "d823ab45fdba7d992fb64dd51f73e5293856fe84fa8dfd5da039d2cf39553447",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71014"
      ]
    },
    {
      "uid": "zhcn:dc9a0705bffa142acac93617",
      "kind": "character_system_text",
      "source_text": "决胜服很坚韧。\r\n在其他星球是否也能通用呢？",
      "source_fingerprint": "08e10326235ed5ef22c321d76c885ea5a4a3c879e317ed5f154531cd4fdc4b34",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71015"
      ]
    },
    {
      "uid": "zhcn:509808c3f0e9cf27b27e5afe",
      "kind": "character_system_text",
      "source_text": "装着――ゼンノロブロイの“ビジョン”。",
      "source_fingerprint": "d0fdd3a6cab2f9be2c5975b701f259a3b1fe25d38fdcc85a87f6c91fa92940ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71016"
      ]
    },
    {
      "uid": "zhcn:1add74bdd12f50f4dc2fe960",
      "kind": "character_system_text",
      "source_text": "『おそろい』のチャーム、\r\n揺れるたび、スフィーラ。",
      "source_fingerprint": "e36a58ede3f864ad23d655e421e2c98a15a1f76012bf315779cb1340d660a984",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71017"
      ]
    },
    {
      "uid": "zhcn:f2cd7489fe33e35f46037914",
      "kind": "character_system_text",
      "source_text": "适合我？还是怪怪的？\r\n我很好奇你的评价。",
      "source_fingerprint": "b42ae6c995b2769e6dc6d8282cc1539747a1e70219e6a33bfaaaa5bd1baa31bd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71018"
      ]
    },
    {
      "uid": "zhcn:fc5d5e8a5f50f8c6e7d55b65",
      "kind": "character_system_text",
      "source_text": "难道你在「观测」？\r\n……我似乎不太习惯这样。",
      "source_fingerprint": "dbf06472c6fed616ce092d20e6710eafe85c591b5731961e24e0fb2943594390",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "71019"
      ]
    },
    {
      "uid": "zhcn:8716edcb83efdb235494d131",
      "kind": "character_system_text",
      "source_text": "要让我「慰劳」你哦。",
      "source_fingerprint": "59938443b2c442273ffc439c38145af8a5c6c859d32cd4c4a672f42f5eeb53ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "80000"
      ]
    },
    {
      "uid": "zhcn:ced46d3ccb952ba68dba5c8a",
      "kind": "character_system_text",
      "source_text": "拂晓的城市染上了「恒星」的光芒，\r\n既「静谧」又令人「心跳加速」。\r\n让我有种即将迎接崭新开始的预感。",
      "source_fingerprint": "492b575393f30c313b566e6a5922ebb0dd115555f2b2b54521abdd21f7681953",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90000"
      ]
    },
    {
      "uid": "zhcn:311a6f1857db64516e5a806e",
      "kind": "character_system_text",
      "source_text": "我对AM的营养补充没有特别讲究。\r\n吃谷物或谷物加工食品都无所谓。\r\n但是一定要有「豆腐味噌汤」……",
      "source_fingerprint": "8ed5d76323ce0e8fd10095fe754540a87d6a85383aede7ed1500d19eded6bca5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90001"
      ]
    },
    {
      "uid": "zhcn:641b7fe6882616fbfa8ea4c6",
      "kind": "character_system_text",
      "source_text": "我的目标是……\r\n每天跟「同学」进行「对话」。\r\n目前进度……该「急起直追」了。",
      "source_fingerprint": "04c0b49fc6cb361fece938c49af5e6acda458e88e70709eb0b8ee3a5bea9e751",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90002"
      ]
    },
    {
      "uid": "zhcn:3b1cec0e4f45a8c6a6d23a55",
      "kind": "character_system_text",
      "source_text": "我把「纪录媒体」缴交给老师……\r\n收到回复「难懂、无法解读」……\r\n写出「好懂的笔记」真不容易呢。",
      "source_fingerprint": "4a1315d6b1dac448cd25399727d2e17914ccb1705450ab2d456864ac2984df47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90003"
      ]
    },
    {
      "uid": "zhcn:d2d7d0b7eb6c09ea0f2fc9e0",
      "kind": "character_system_text",
      "source_text": "好热闹……听得见多达100垓的\r\n声音喔。他们在宣示自己的存在，\r\n让我知道自己不是一个人……",
      "source_fingerprint": "d092d37435a78627c6bdf3729882652981d15841b187f5b6affe1de5b59a24be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90004"
      ]
    },
    {
      "uid": "zhcn:79281cae5a2cd8867df20590",
      "kind": "character_system_text",
      "source_text": "训练员还在执行「任务」吗？\r\n……与你「同行」会比较好吗？\r\n在漆黑的宇宙中会感到「寂寞」吗？",
      "source_fingerprint": "d95a701b35119f604f26858b4012bd018f4374dc0edababdcf9d15b3b20fe20e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90005"
      ]
    },
    {
      "uid": "zhcn:1a3b94c16a3950166eec5e2e",
      "kind": "character_system_text",
      "source_text": "解除「人工冬眠」。\r\n生命开始活动的季节到来了。\r\n「我」该从什么开始做起呢？",
      "source_fingerprint": "0e2e4bb30cd34fde26ba2b666d042f01496ce10b6dcd9ae84f5c9ed943c7d046",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90006"
      ]
    },
    {
      "uid": "zhcn:65b9a000478aec8ddc27410b",
      "kind": "character_system_text",
      "source_text": "训练员，你感到「炎热」了吗？\r\n那就与我「同行」吧。\r\n夜晚观测星星很「凉爽」喔。",
      "source_fingerprint": "b0260b46d39860cfec4a4c18605d385a285506997c807304aebf1cbc82618d77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90007"
      ]
    },
    {
      "uid": "zhcn:751e60d3806c1bebca34fe40",
      "kind": "character_system_text",
      "source_text": "众人一起食用「月亮」的季节……\r\n新宇宙也「喜欢」。加了蛋黄的\r\n荞麦面、赏月汉堡、赏月团子……",
      "source_fingerprint": "f7092aa59de04977bf21862b258e02b85a930f8ba6749199b956dce24b97dc30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90008"
      ]
    },
    {
      "uid": "zhcn:ec61c6b192342b892f387ac6",
      "kind": "character_system_text",
      "source_text": "真想快点变得「温暖」……\r\n「INTI」……把指尖放到\r\n训练员的口袋里「避难」……？",
      "source_fingerprint": "6a0e3180d998457436417a7ee2f1e7c9c0662304bd457c66973834207599d250",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90009"
      ]
    },
    {
      "uid": "zhcn:49b91a616036160e60d67fcb",
      "kind": "character_system_text",
      "source_text": "『三つ編み』…毎朝のミッション。\r\n――“NPB”、ゼンノロブロイに\r\n構築法…『教わる』したから。",
      "source_fingerprint": "4b0efe703794b75a6daf4b1f4905b9d2ed942fc89193ab65da74108cec2d0d7c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90010"
      ]
    },
    {
      "uid": "zhcn:7aa777abd10ffd7d3f286af7",
      "kind": "character_system_text",
      "source_text": "“アップクォーク”。\r\n証左に、今朝は“イオンテイル”\r\n…わかる？",
      "source_fingerprint": "c6fc4f8085588e84f4d795e7b0ce9d70c5c9e308e70778ea6df9b88dfbf90e7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90011"
      ]
    },
    {
      "uid": "zhcn:29067a886b069fa9b1b84a96",
      "kind": "character_system_text",
      "source_text": "効率的太陽光享受法を…\r\nラインクラフトからラーニング。\r\nトレーナー…『ポカポカ』、試す？",
      "source_fingerprint": "e3c6ea1a946034c80dfe73b6316d8be86025922eb126776ce1aeb57861534804",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90012"
      ]
    },
    {
      "uid": "zhcn:6f2f142e4afcef85d26a5736",
      "kind": "character_system_text",
      "source_text": "“SND”、試作中だよ…\r\n『おいしい』に到達できたら、\r\n『ふるまう』するね…“JAM”。",
      "source_fingerprint": "98c8adcfda785771c94f86596ce00842060a6a0725f2d0d98a69b7ad4d6c35a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90013"
      ]
    },
    {
      "uid": "zhcn:b60f1e35f445a5cd470ccffc",
      "kind": "character_system_text",
      "source_text": "『お疲れさま』だね…――鞄に\r\n…『甘蕉』、“保持”…“GIVU”\r\n『元気でる』のフレーバーだよ。",
      "source_fingerprint": "114e99dc2a4176e79a6b6406f373dcd72bdb349fd9449bf65f6c2efec365537a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90014"
      ]
    },
    {
      "uid": "zhcn:7c7cfe177b2a074733c9e945",
      "kind": "character_system_text",
      "source_text": "トレーナー…『お月見』、する？\r\n“天球模様”は不問…\r\n“ワームホール”、経由するから。",
      "source_fingerprint": "a5651754d3ec390cd514e6953580c6f51ffdc07bdb879e4bd89c52457239d027",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90015"
      ]
    },
    {
      "uid": "zhcn:4fa74befe57cb4da0d33fac5",
      "kind": "character_system_text",
      "source_text": "“飛行物体”、“確認”したら…\r\n『天道虫』だった――\r\nふふ、『のどけし』だね。",
      "source_fingerprint": "13cb6b25396902b5ec9818394509969bcdb6285477266a9b4f890fb8d357f4de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90016"
      ]
    },
    {
      "uid": "zhcn:d924837ad70413575fbc4be3",
      "kind": "character_system_text",
      "source_text": "水分の“補給”は“QOAX”…！\r\n『檸檬』“三日月”にするといい…\r\nビタミンCも、摂取可能になるよ。",
      "source_fingerprint": "4759bba57e47158f92737cd4504040f98a25f0b14fd7132cc6697236291ccc7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90017"
      ]
    },
    {
      "uid": "zhcn:f06729997962f58e0aa7d430",
      "kind": "character_system_text",
      "source_text": "ネオユニヴァースは『読書の秋』、\r\n実行中…『面白い』を発見したら、\r\n“Wow!”するね。",
      "source_fingerprint": "e6c4b634a622bb94dc5ce86c5f43d21fc4570efb52eb07f25bfb62f9884ada97",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90018"
      ]
    },
    {
      "uid": "zhcn:fa2e291f1ee2e86ecf153a4d",
      "kind": "character_system_text",
      "source_text": "“ラメーン”、『おいしい』の\r\n季節…でも“ビジョン”が『曇る』\r\n季節でもある――ジレンマ、だね。",
      "source_fingerprint": "0050bef1c41e7dcb5311a54c87b9393d33efd9cf9978e36cc326696650870e16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90019"
      ]
    },
    {
      "uid": "zhcn:9c8d65eebef7630e858358a0",
      "kind": "character_system_text",
      "source_text": "今天是情人节呢。",
      "source_fingerprint": "a0ede3d62de262aa3d0584fc168a26b69b0c9e044b40007511a7627788b06a66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90020"
      ]
    },
    {
      "uid": "zhcn:aaaebb57465d6fd8c12873f4",
      "kind": "character_system_text",
      "source_text": "バレンタインデー、だね。",
      "source_fingerprint": "6fd2e6ef923c646e48482d2727599a06ad66805b1dc99cd49e08c4087fe3c4f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "90021"
      ]
    },
    {
      "uid": "zhcn:5ea9c04afaedcdc570380e3c",
      "kind": "character_system_text",
      "source_text": "荒漠英雄很「热爱」恒星的故事。\r\n但她也一样既炙热又明亮，\r\n是颗相当出色的「恒星」喔……",
      "source_fingerprint": "36ca56e93b74051c89c02bc9af4614bcbc1d80249d7221aac33b0a0165a14dd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "91000"
      ]
    },
    {
      "uid": "zhcn:3860dba6f0754f2e4266dc6c",
      "kind": "character_system_text",
      "source_text": "我偶然……与荣进闪耀同时吃午餐。\r\n甚至一样都吃「纳豆定食」……\r\n呵呵，真是奇迹般的「接触」呢……",
      "source_fingerprint": "60f4719b90a814f5746a6f320582f42d75b25231d4ae90cb4b5f589c3e33857b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "91001"
      ]
    },
    {
      "uid": "zhcn:320845f124dc705c0566caab",
      "kind": "character_system_text",
      "source_text": "爱慕织姬正在与某人「通讯」。\r\n那「声音」既温柔又哀伤。\r\n……希望她能获得「安宁」。",
      "source_fingerprint": "b144701f9d013bc0b918b51ad9b6435b0aa694c123e233fbf1c527d458460719",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "91002"
      ]
    },
    {
      "uid": "zhcn:e27432a793e5f24fefce6296",
      "kind": "character_system_text",
      "source_text": "美丽☆美丽～★☆\r\n为什么她就能引发UAP呢？\r\n我跟她有何不同……？",
      "source_fingerprint": "d810ec4608d46c222d9a6e706b5d79b263948c5c713a36b3b11b91278b7cb02c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1105",
        "91003"
      ]
    }
  ]
}
