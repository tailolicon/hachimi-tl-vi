  "entries": [
    {
      "uid": "zhcn:b1513d324cf3e64ddd7a6cc3",
      "kind": "character_system_text",
      "source_text": "呜啊……！",
      "source_fingerprint": "c07b206c2fc6d6dda4428633c661516ded285418afa5892b30f31956ceb4a86b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1002"
      ]
    },
    {
      "uid": "zhcn:f9d38c5c606f22621327d66e",
      "kind": "character_system_text",
      "source_text": "啊，有事报告。\r\n赛马娘名鉴的等级好像提升了喔。",
      "source_fingerprint": "361bdaea75b8c0385c1e54dc5198ceeecfd289f86085a61f619597a495386a89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "10021"
      ]
    },
    {
      "uid": "zhcn:34fa202779b0d68797590c34",
      "kind": "character_system_text",
      "source_text": "デニムフリルは個人的に結構\r\n冒険だったかな…ま～でも無難に\r\nまとまってますよね。うんうん。",
      "source_fingerprint": "ae7f8a18f4375eda62b0b37799b5e9b94cb0c51936b1871f26a43ff40f17fcdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "10025"
      ]
    },
    {
      "uid": "zhcn:0c013bc59c1265c39b26aee7",
      "kind": "character_system_text",
      "source_text": "似合う似合う、って店員さんの営業\r\nトークに敗北したわたしですけど。\r\nや～、褒められちゃうとやっぱね～",
      "source_fingerprint": "05a4da21d702f52e0261797e1de3e771abf033a0714a84c07b263dc59d80eb76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "10026"
      ]
    },
    {
      "uid": "zhcn:e6ec92d811144b805ae4a940",
      "kind": "character_system_text",
      "source_text": "友だちとお好み焼き食べに行ったら\r\nソースが襟についちゃいまして…\r\n色的にセーフ？…セーフですよね？",
      "source_fingerprint": "754498ebb6627335af86142c09580b86b367168ddb3bb01a9fd2efd3a3f525e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "10027"
      ]
    },
    {
      "uid": "zhcn:90dc1ab02a494936b5ce2fc4",
      "kind": "character_system_text",
      "source_text": "平手啊～",
      "source_fingerprint": "361e31236926d9e4e417ac7d93095cd11535b489d21b1e7295d00065a2d8ea2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1003"
      ]
    },
    {
      "uid": "zhcn:0b60474a2a41797f3d2a35a6",
      "kind": "character_system_text",
      "source_text": "好厉害！是奇迹！？",
      "source_fingerprint": "d39ec1d0f23850f87057a84ea4ad005142be93673d868f8e2d82636b0f576289",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1004"
      ]
    },
    {
      "uid": "zhcn:3565bec330f5a694592e3e38",
      "kind": "character_system_text",
      "source_text": "呜啊……！",
      "source_fingerprint": "c07b206c2fc6d6dda4428633c661516ded285418afa5892b30f31956ceb4a86b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1005"
      ]
    },
    {
      "uid": "zhcn:c5e18e28605d01654c7f175e",
      "kind": "character_system_text",
      "source_text": "平手啊～",
      "source_fingerprint": "361e31236926d9e4e417ac7d93095cd11535b489d21b1e7295d00065a2d8ea2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1006"
      ]
    },
    {
      "uid": "zhcn:63dd979cc21c114e3176252e",
      "kind": "character_system_text",
      "source_text": "好像更新高分纪录了呢～！",
      "source_fingerprint": "38400610fdb25f23722269512cd0963634825c6722bb118b3279bf06263628a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1007"
      ]
    },
    {
      "uid": "zhcn:3a3741b5d947c54fcdbd843d",
      "kind": "character_system_text",
      "source_text": "总之努力看看吧！",
      "source_fingerprint": "47c21f2b14e5434c09d98fb92915bb99139580f1d53e0cdccca748a7fd84a4c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "1008"
      ]
    },
    {
      "uid": "zhcn:d2dbffb63e0409ab89f5a748",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "11"
      ]
    },
    {
      "uid": "zhcn:28179cb4eb20f415154bb58f",
      "kind": "character_system_text",
      "source_text": "训练最重要的是持续不间断。\r\n……但同时也是最难办到的一点呢～",
      "source_fingerprint": "b7e4eea0d281f17e3ef319c7785da13b8b1a15d2fabf35c1c23600fd0d6ca64b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "110000"
      ]
    },
    {
      "uid": "zhcn:9229b35338829f18634fb25c",
      "kind": "character_system_text",
      "source_text": "学园的历史啊～\r\n我是还满爱看电视上播的\r\n那种纪录片啦。",
      "source_fingerprint": "c3658effd691c2eed3275f6ea803e30bb75325df133494b55dc2a656a9eed983",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "110001"
      ]
    },
    {
      "uid": "zhcn:d7fe05a249730c0ebbee0ad4",
      "kind": "character_system_text",
      "source_text": "咦，要报名参加竞赛吗？\r\n糟糕糟糕，热身运动热身运动。",
      "source_fingerprint": "58b19bedc66c1e5ab5628517240675c6e3d520e92a8c032504f152528db0157c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "110002"
      ]
    },
    {
      "uid": "zhcn:b8e59ee448236d227a67b9fc",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "12"
      ]
    },
    {
      "uid": "zhcn:eb86e4dcf3609ea879d01909",
      "kind": "character_system_text",
      "source_text": "好、好像有股力量……！？\r\n怎么会发生这种事！？",
      "source_fingerprint": "9a70cfe6369bff84d1bad43a6f7eb34ae806758fc043f2e51bfcca851f86dbe4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "120000"
      ]
    },
    {
      "uid": "zhcn:b8e630f4530ef95352c485d7",
      "kind": "character_system_text",
      "source_text": "锵～\r\n这是今天的登录奖励～",
      "source_fingerprint": "c47652e3782b02439b376719c5c4514285625fc49f3d2ac1b47c8ae9cdb4b28c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "13"
      ]
    },
    {
      "uid": "zhcn:18a21030f74ae79dd3efaaaf",
      "kind": "character_system_text",
      "source_text": "要加油喔～",
      "source_fingerprint": "d268f2be9a60acd784178cac9b3cce86bbf98b888c176b65a4054b81d2853221",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140000"
      ]
    },
    {
      "uid": "zhcn:088d980a7d682a77608c8276",
      "kind": "character_system_text",
      "source_text": "OKOK～！",
      "source_fingerprint": "b3f584d34e54ccfe7e5d2211b0add92728010cf58834565a4fd118d5edde9516",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140001"
      ]
    },
    {
      "uid": "zhcn:de94ac7866793751e1414bbf",
      "kind": "character_system_text",
      "source_text": "哎呀呀呀……",
      "source_fingerprint": "3761eb449f7da124317bdb9b128a96e5eb3e1485f1422eae02f98ecc4fc23e7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140002"
      ]
    },
    {
      "uid": "zhcn:5be3aba44377cdf788711df1",
      "kind": "character_system_text",
      "source_text": "咦～真的假的！？好厉害！",
      "source_fingerprint": "f9a40b9ba9c29a70962ad2ea263efdd96b308dbc3043abb07166ffc2ba472c1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140003"
      ]
    },
    {
      "uid": "zhcn:542a6c79eeb69eeee7563b59",
      "kind": "character_system_text",
      "source_text": "收获不错呢～♪",
      "source_fingerprint": "e340511e40ac0ac119f1aafb2085a6335adf6b083c395517281847cf2a2dcf11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140004"
      ]
    },
    {
      "uid": "zhcn:78d36f7883f23d07a4751467",
      "kind": "character_system_text",
      "source_text": "别在意啦～这种东西本来就这样啦。",
      "source_fingerprint": "6a02126c10d2b930c1459f4de92fa8295dc66dd113a1374311aebae74801962e",
      "source_path": "character_system_text_dict.json",
