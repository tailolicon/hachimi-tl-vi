      ]
    },
    {
      "uid": "zhcn:1e546cb66b07b7053c8dd495",
      "kind": "character_system_text",
      "source_text": "收获不错呢～♪",
      "source_fingerprint": "e340511e40ac0ac119f1aafb2085a6335adf6b083c395517281847cf2a2dcf11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140007"
      ]
    },
    {
      "uid": "zhcn:5c12c47cad101704624d9b59",
      "kind": "character_system_text",
      "source_text": "啊哈。",
      "source_fingerprint": "1d93eddabd018011e10e1e48a3233cd944998dfcbd8d7660d915eb3831b48668",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140008"
      ]
    },
    {
      "uid": "zhcn:8a332741546bb2b2b9c38e9b",
      "kind": "character_system_text",
      "source_text": "上啊上啊～",
      "source_fingerprint": "d1c64d50e0322ed12c8611879f053d21c8fd601c963de46f4d2c6691de6301a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140009"
      ]
    },
    {
      "uid": "zhcn:78cca8d68a1ce9f9c0670540",
      "kind": "character_system_text",
      "source_text": "嗯～？",
      "source_fingerprint": "e2944f833f87e071448caf189b2be12563c8c1f296f674fe6cd1a3c089e55f63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140010"
      ]
    },
    {
      "uid": "zhcn:4f07fb83b9f44cae97b80662",
      "kind": "character_system_text",
      "source_text": "哦，好机会！？",
      "source_fingerprint": "0863a9a7fd8534ac13fb81fb12c31db3ac12dbb05b81d4b983752a230ccf8ae3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140011"
      ]
    },
    {
      "uid": "zhcn:be6034de1ccee8fd7dedc3fb",
      "kind": "character_system_text",
      "source_text": "太嗨了吧～！",
      "source_fingerprint": "f3a3f654b527b8bbb2dff1586a4b8f77f27d3cbc883c07f7df70e78998a432fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6f4099ec2e7ff58f70dd4b56",
      "kind": "character_system_text",
      "source_text": "哦！？有机会吗！？",
      "source_fingerprint": "95bf42369deccea9ffddf4582cf025c6046c436edbf5990ba4264fd2b610a7e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140013"
      ]
    },
    {
      "uid": "zhcn:4ca2934f139587760a68fa3d",
      "kind": "character_system_text",
      "source_text": "啊～溜走了。",
      "source_fingerprint": "272b6955054297a94debbf39255d3bb90cc7a9b0f86bfc53a7d80a7d747c3608",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140014"
      ]
    },
    {
      "uid": "zhcn:43c5ee67aa84ecb32f5491b6",
      "kind": "character_system_text",
      "source_text": "Go～go～",
      "source_fingerprint": "b47f16dd895e7e19fa3b08135ebc8e8233f11b21d4fa273d1eb7d97229763746",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140015"
      ]
    },
    {
      "uid": "zhcn:191cce953966101ad074f8cc",
      "kind": "character_system_text",
      "source_text": "咦，怎么了吗？",
      "source_fingerprint": "ccba2355e52034ce15d865d00331d424a2ef58fbce890145d7adb4068f8e66f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140016"
      ]
    },
    {
      "uid": "zhcn:6dd569b0b1ff7ae4a0170f29",
      "kind": "character_system_text",
      "source_text": "再～见了。",
      "source_fingerprint": "960ada1bd07b5c756ef6f2a0bb7aff5be7cffddd341fe2fc2a156b418738097d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140017"
      ]
    },
    {
      "uid": "zhcn:1ad7fe5e20e5422e60efbd5d",
      "kind": "character_system_text",
      "source_text": "好想哭啊。",
      "source_fingerprint": "cc29cb42db0c43c8112da5b42d40f014f46cb7f38e6cfe22c4b53be44a58aff6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "140018"
      ]
    },
    {
      "uid": "zhcn:720a43da430a2448efd0b997",
      "kind": "character_system_text",
      "source_text": "明天好像可以拿到这个呢。",
      "source_fingerprint": "f4b50dd9ea584035c95a171fa1796d9a1303803a9ba907ddfa1517c78438cee4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "15"
      ]
    },
    {
      "uid": "zhcn:c7c31fdec886071305c7fbca",
      "kind": "character_system_text",
      "source_text": "啊啊～\r\n总觉得突然非常想飞扑到大抱枕上。",
      "source_fingerprint": "68f9e4afbe8bf450b03f1196a7a067bf35e6b32667b1bb87d295915d9af59f0f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20000"
      ]
    },
    {
      "uid": "zhcn:3cece69f8dcfa2ce67cc730a",
      "kind": "character_system_text",
      "source_text": "这下不妙了啦……\r\n这完全不是能够\r\n努力的状态啊～",
      "source_fingerprint": "4c1dd1f9ea2d6f2a59d18986f4d0f6704cefe0eebc4c42bac6b6be768fd9f7fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20001"
      ]
    },
    {
      "uid": "zhcn:fd5152c487182d3fe2983792",
      "kind": "character_system_text",
      "source_text": "会是因为平时备受称赞的缘故吗？\r\n总～觉得今天的我……\r\n干劲整个多到满出来耶。",
      "source_fingerprint": "37f367ec4283ca0ffc5e56239a1edddf46195a7fd212f25c1d159233fb58f873",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20002"
      ]
    },
    {
      "uid": "zhcn:deaa107b60ee7c3ac96ad572",
      "kind": "character_system_text",
      "source_text": "唔哇～怎么回事！？总觉得今天\r\n有种充满奇迹的感觉，真不像我……\r\n不是，虽然我本名就叫做奇迹啦。",
      "source_fingerprint": "9ee3089015bc1af9c1950396b7bdc9766c39058e5294b4de690698cbe7df2516",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20003"
      ]
    },
    {
      "uid": "zhcn:c3c5dcc0951eb1e514075000",
      "kind": "character_system_text",
      "source_text": "很～好很好，干劲十足。\r\n这就是所谓适合努力的日子吧。",
      "source_fingerprint": "389880aaf4e9d69c0ed58f310a0ecd51a776249eb117f9a845543e51a58fbeb3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20004"
      ]
    },
    {
      "uid": "zhcn:2c21c6d390ba782093ad0ad3",
      "kind": "character_system_text",
      "source_text": "很好，今天很有干劲。\r\n……虽然我不希望你对我抱有\r\n过度的期待就是了，啊哈。",
      "source_fingerprint": "088748d8044e69c026423a17f9d3638b0f3a7b2a7d941236efb8cf5bbd955710",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20005"
      ]
    },
    {
      "uid": "zhcn:9e4862a8fda2aa1f8742dbca",
      "kind": "character_system_text",
      "source_text": "好～了。我又像平常一样，\r\n没想太多就顺着习惯\r\n换好衣服做完热身了～",
      "source_fingerprint": "63f3547ebbf92d86f3e5248fd36de85d5dc7b2920496479a8ed1eb3cee99fc10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20006"
      ]
    },
    {
      "uid": "zhcn:36e40ac03251780f3c62328a",
      "kind": "character_system_text",
      "source_text": "今天呢，真的普普通通～\r\n我说完了。……啊哈。",
      "source_fingerprint": "a8631c3d661d0aca2f19b1ae22d627ada70802c747a59fb1ed6b96efa7e4358e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20007"
      ]
    },
    {
      "uid": "zhcn:5a8469575322a0d4a271466f",
      "kind": "character_system_text",
      "source_text": "嗯～总觉得没什么动力耶……\r\n连平时就懒懒散散的我都这么说了，\r\n可见这次非同小可喔。",
      "source_fingerprint": "0368c615f6cd1bcb8f4e415f93b89cad289e9fd6bb23601783358daa1ffd5342",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a41b4849b112d2ce985a1156",
      "kind": "character_system_text",
      "source_text": "嗯～虽然说我本来就这样啦。\r\n……不过呢～毕竟我还有目标啊。\r\n还是得加油啊……",
      "source_fingerprint": "8223a57497d00abf358b42fc9cd27a9ef117b3be9b0e4b1e97bfb8181bf12641",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20009"
      ]
    },
    {
      "uid": "zhcn:6396ed7d029f51ab526dc4b0",
      "kind": "character_system_text",
      "source_text": "……啊……糟糕。\r\n无法停止去想……以前去过的\r\n温泉的温水按摩浴缸……",
      "source_fingerprint": "0f105e381b1e2ee49dc5d7a918aeeef4f453b3edee9725c86c8852578fc83a2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20010"
      ]
    },
    {
      "uid": "zhcn:5914b3ae7fd91438e9caa878",
      "kind": "character_system_text",
      "source_text": "我已经……不行了。\r\n无论你再怎么夸我……\r\n我都不觉得自己动得了。",
      "source_fingerprint": "ca09b326b4711102d14e8aedc47d5946929e6a3f7125911d05966b38289f0330",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20011"
      ]
    },
    {
      "uid": "zhcn:9a41940ed6dc4180210dc2b4",
      "kind": "character_system_text",
      "source_text": "与其说有～点跑得太频繁了……\r\n不如说你应该知道我并不是个\r\n对自己那么严苛的人吧～？",
      "source_fingerprint": "302d7124f5b47954c3df05addbe0accbad2f1317daa6e7545a31c4ce0364949f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20021"
      ]
    },
    {
      "uid": "zhcn:e27cd2af5ebf877daafab679",
      "kind": "character_system_text",
      "source_text": "呜哇～救命啊……\r\n热血魔鬼训练员在欺负我啦……！",
      "source_fingerprint": "5bd920ed6d709ec2be4385fa472b59c656d6f39a014709b4b021280567bc8269",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20022"
      ]
    },
    {
      "uid": "zhcn:7e8d5a63b3f73c50f67e6816",
      "kind": "character_system_text",
      "source_text": "如果现在立刻接受采访，\r\n我感觉自己似乎能够说出\r\n超上进的发言喔……！",
      "source_fingerprint": "eb929779729f9230285153d5a0e47de3f9c7a6ac820b9842136fe66a2cac5228",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20023"
      ]
    },
    {
      "uid": "zhcn:b5bcc98c716844844ee2a11b",
      "kind": "character_system_text",
      "source_text": "秘藏的力量，此刻正是觉醒之时！\r\n……听起来像漫画看太多，\r\n但我现在真的状态绝佳！",
      "source_fingerprint": "6d52dea5262689c5fc4d9025d8e7f78bc55c44d62ec97375a6c4880be0e4043f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20024"
      ]
    },
    {
      "uid": "zhcn:5a9207b53142730b9d05d2b2",
      "kind": "character_system_text",
      "source_text": "不觉得我看起来感觉不太一样吗？\r\n我现在的状况可是绝佳到\r\n就算身旁冒出气场也不奇怪呢！",
      "source_fingerprint": "cb3585dc8356772a88c77df6e7265a22c41ff9aa427a0aad064028d5e37a0cfe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20025"
      ]
    },
    {
      "uid": "zhcn:56ded3f688d50e3dcf4b5d4b",
      "kind": "character_system_text",
      "source_text": "咦？这次似乎意外地颇有胜算！？\r\n……我怎么说得像事不关己一样。\r\n啊哈。",
      "source_fingerprint": "9698ca367e2b2a1cd493dd56b107615b7831f2b908ea9adbf6e9b1de459823db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20026"
      ]
    },
    {
      "uid": "zhcn:4f831a0a0b8a924d4d191648",
      "kind": "character_system_text",
      "source_text": "感觉真不像我。\r\n总～觉得……\r\n好像有一点点自信！",
      "source_fingerprint": "2205adbf93dfcff58d5f8a8cddc0943de7a8c64478edb9e9a69bebfe0524352e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20027"
      ]
    },
    {
      "uid": "zhcn:d6648cd8dc47f22c1ff9786a",
      "kind": "character_system_text",
      "source_text": "训练员真的很会夸奖人呢。\r\n……多亏了你，\r\n我现在状态调整得还不错哦。",
      "source_fingerprint": "fc11c3dbd10eaa3a52934b30e20dd9823c3a35ada48c76ffb638d3a7a37c6c5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20028"
      ]
    },
    {
      "uid": "zhcn:8a61c6480435a208f932465c",
      "kind": "character_system_text",
      "source_text": "现在感觉非常普通。\r\n正式上场前……\r\n这样是不是反而比较好啊？",
      "source_fingerprint": "28357d716eb1e6ef013575ec45e26f6c1ae25bc765a1fb0de7d974890b1af1c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20029"
      ]
    },
    {
      "uid": "zhcn:2f6372322495b1c2b6635a92",
      "kind": "character_system_text",
      "source_text": "只要拿出我平时应有的表现，\r\n就够OK了……对吧？",
      "source_fingerprint": "f70d1e5cd7ad919fd69ee6a6647bc139309c116e61c1b5e13402274755bcefd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20030"
      ]
    },
    {
      "uid": "zhcn:929bee40308d45ee66a20596",
      "kind": "character_system_text",
      "source_text": "我还是觉得心跳好快啊～可能也是\r\n因为刚刚稍微做了些热身吧。\r\n……终于要正式比赛了啊～",
      "source_fingerprint": "5c4057cb113765b019b8bde6663b0aeba91849a70762a28922f4b9b804f73a77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20031"
      ]
    },
    {
      "uid": "zhcn:aa29dec7a6e6a6fff7c8b801",
      "kind": "character_system_text",
      "source_text": "虽然准备得不太顺利，\r\n不过算了～人生就是这样嘛～\r\n……我在说什么啊？啊哈哈。",
      "source_fingerprint": "97b0d3a3889e60ac77a7e190acea5217fd044b9ae855282cef554541ea74a0d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20032"
      ]
    },
    {
      "uid": "zhcn:37b304d4c2a7352a022cd0ba",
      "kind": "character_system_text",
      "source_text": "虽然说事事都是听天由命啦～\r\n但上场后我还是会尽量发挥\r\n至今累积的努力喔。",
      "source_fingerprint": "0c0c46b7f6994fa0923ef5c74b42999001bd8ba4f901b5e6df83ad36e1a53b50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20033"
      ]
    },
    {
      "uid": "zhcn:591bc9677c2f2e1954ed5141",
      "kind": "character_system_text",
      "source_text": "无论是哭是笑，命运的时刻\r\n终究注定到来……就像没读书\r\n就直接裸考的定期考试一样……",
      "source_fingerprint": "fae1dd4bd372d3ccf83584dc679b5044e023168dd710182a8228078d1f953f74",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20034"
      ]
    },
    {
      "uid": "zhcn:80370e3dbb5a3c06895228fe",
      "kind": "character_system_text",
      "source_text": "……我想说些积极乐观的发言，\r\n但脑中尽是浮现些负面言论……\r\n唔唔……",
      "source_fingerprint": "46ad3b79b1b0b522f14b883fce94756143f65c668d3220b1c1dc86dcbcdf378b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20035"
      ]
    },
    {
      "uid": "zhcn:ff89b7808f4420c4286329f0",
      "kind": "character_system_text",
      "source_text": "总觉得情绪迟迟上不了轨道……\r\n多想些有益处的事吧……赢了就能\r\n泡温泉、赢了就能吃美食……",
      "source_fingerprint": "0881526841a95b8cd7ab838aad2e9fa30a4c859528ea27d8314cdccd9907eead",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20036"
      ]
    },
    {
      "uid": "zhcn:b45f323091e7cac1a7e3afc7",
      "kind": "character_system_text",
      "source_text": "要是以这个状态获胜，我真的会\r\n忍不住觉得自己很厉害喔……\r\n但我想很难发生那种奇迹吧。",
      "source_fingerprint": "2e2db98a3fd74c13f46a8cb25790c08c9f8d2618d87f77471ea7af8cda49936a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20037"
      ]
    },
    {
      "uid": "zhcn:23a752ec26d05a40a52fccd0",
      "kind": "character_system_text",
      "source_text": "我要上了～",
      "source_fingerprint": "d7097bd6846c831b6195bf9fc81a5c49368ca72ae6e3e615d6539423ebe37b1a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20038"
      ]
    },
    {
      "uid": "zhcn:aec83b901c1aa36f9607199f",
      "kind": "character_system_text",
      "source_text": "轻松地go～",
      "source_fingerprint": "739c0fc6fe5f6e3ee7bd552e1f98fd82f48bee76d7459457672637ee870ddb39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20039"
      ]
    },
    {
      "uid": "zhcn:56d353d86a4ecfea70371ea0",
      "kind": "character_system_text",
      "source_text": "来啰来啰～",
      "source_fingerprint": "4c1fad261aaf9e4f3e5ad5ad015e3fb09c4335d78d872134d32c1001c873692c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20040"
      ]
    },
    {
      "uid": "zhcn:ffc0626d3b52d71fc9261074",
      "kind": "character_system_text",
      "source_text": "开始吧～",
      "source_fingerprint": "f748cbedee3dbec2c71793b331189d3b4b18994e03be5c7f04532449ec2754fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20041"
      ]
    },
    {
      "uid": "zhcn:06511d19bca42a00786d7540",
      "kind": "character_system_text",
      "source_text": "唔哇……",
      "source_fingerprint": "72cdb5d63d5e512669cedddea8331659b4249359645b6d1c94acc8cbc0e23d94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20042"
      ]
    },
    {
      "uid": "zhcn:643b7408bdfe2c68ae7b6a32",
      "kind": "character_system_text",
      "source_text": "嗯，搞不懂。",
      "source_fingerprint": "bf0938760c010d94f699ada3daa334b5b25b71257072a39c10f24829e6f8311f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20043"
      ]
    },
    {
      "uid": "zhcn:57f575e190b054e5173b9a0c",
      "kind": "character_system_text",
      "source_text": "我出发啰～",
      "source_fingerprint": "8996e19110f63b5dbd3ac2668d6ebad420ea30c8baafe64b02479a3612a416ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20046"
      ]
    },
    {
      "uid": "zhcn:244d15b65f686018e9a8a25c",
      "kind": "character_system_text",
      "source_text": "玩得好满足～！",
      "source_fingerprint": "475cc92adddc46587d3e2807e1e7119d0910270f40330f393fc73525645637cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20047"
      ]
    },
    {
      "uid": "zhcn:0d0921e677767d39990c11ce",
      "kind": "character_system_text",
      "source_text": "你真的是很懂得怎么夸奖我耶～",
      "source_fingerprint": "b9bd4025342760891b3bfa4f07fa70ac6b434eb8b9d0b82910c07f792479324d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20049"
      ]
    },
    {
      "uid": "zhcn:1f5f071207a54a55fc148f09",
      "kind": "character_system_text",
      "source_text": "真是受你照顾了呢～",
      "source_fingerprint": "2fa9f6f1d64c0887e30adeb46416496c313b750ca7f3005bba8d1b84d1a28938",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20050"
      ]
    },
    {
      "uid": "zhcn:9fc380ff7a4bc53032196992",
      "kind": "character_system_text",
      "source_text": "はい、よろしくです～。",
      "source_fingerprint": "ae977a49dd5c963e17187591b3bd95c645fe31e170b38cae6d3d8a0029ddd8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "20051"
      ]
    },
    {
      "uid": "zhcn:4aa2c588eaab909fc74c38d0",
      "kind": "character_system_text",
      "source_text": "我会试试！",
      "source_fingerprint": "c6fe75069e7989f761bedcaedde6c898f706aa6fa5a332245266990cfa90f9e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "2030"
      ]
    },
    {
      "uid": "zhcn:590361d6eeae2315ff7749d7",
      "kind": "character_system_text",
      "source_text": "总之努力看看吧！",
      "source_fingerprint": "47c21f2b14e5434c09d98fb92915bb99139580f1d53e0cdccca748a7fd84a4c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1106",
        "2031"
      ]
    }
  ]
}
