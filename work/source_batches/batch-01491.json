  "entries": [
    {
      "uid": "zhcn:c01a4ed9cc6f4609653eb508",
      "kind": "character_system_text",
      "source_text": "慢慢来。",
      "source_fingerprint": "00982313bbafed81aef7e5475ea83ad2a45565cec0be6fdad74ed1371d873c6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140010"
      ]
    },
    {
      "uid": "zhcn:a0b094a21c28382fa9b5f421",
      "kind": "character_system_text",
      "source_text": "好厉害！",
      "source_fingerprint": "c922c5de8a35921e2086ab355870227069194ca65614c757deb698452d7f0151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140011"
      ]
    },
    {
      "uid": "zhcn:cb9da1657a51c6895c022f51",
      "kind": "character_system_text",
      "source_text": "就这样就这样~",
      "source_fingerprint": "a269059e2e0f750c25d859bfcdd24ed11609d5463cad915001a7282b15d924de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6da76cd9303ca112413545b1",
      "kind": "character_system_text",
      "source_text": "哦哦！",
      "source_fingerprint": "491afe930290ca00537960230e3bbc3448d690ce63dc08b63e2557d06bba67b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140013"
      ]
    },
    {
      "uid": "zhcn:56b3fdc01def475bd5c5b651",
      "kind": "character_system_text",
      "source_text": "哇哇！",
      "source_fingerprint": "ec94a89c3124f4bfbf497743a5850ae2b160bba7651e6f7f6cc904b7b3b0e77c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140014"
      ]
    },
    {
      "uid": "zhcn:b8943ca7afde6fb4d7a64e9b",
      "kind": "character_system_text",
      "source_text": "呣。",
      "source_fingerprint": "f4ae6796c49d7ff7bf74b48a7ac55f1de6a73e391bb31df305f28fab08faea36",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140015"
      ]
    },
    {
      "uid": "zhcn:a57cf9a84a6aa10980acf7c2",
      "kind": "character_system_text",
      "source_text": "休息时间到~。",
      "source_fingerprint": "309f83c1ea61b13521ca6f9e120752aa5a4b04e4932330e1035bea11d201920b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140016"
      ]
    },
    {
      "uid": "zhcn:fe7cab39dfd1ffdffdf2a86d",
      "kind": "character_system_text",
      "source_text": "可惜了！",
      "source_fingerprint": "636a96a506d3ad51007741cd08d94f762fd93f461f9ec27417fe5896e1bc5ad3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140017"
      ]
    },
    {
      "uid": "zhcn:b14f098ad66a7ab3f1ee56be",
      "kind": "character_system_text",
      "source_text": "咕~！",
      "source_fingerprint": "1032fa16ba05cfae5db0e9f21364c3dac4fe545e47f7f6fbc54afd0f269209e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140018"
      ]
    },
    {
      "uid": "zhcn:db499d042ddde56538dddf3f",
      "kind": "character_system_text",
      "source_text": "明天的奖励是这个哦♪",
      "source_fingerprint": "4d2cd320655720e99fdb2a8fa68e1671a563697d39dee267d76bcc701452dda8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "15"
      ]
    },
    {
      "uid": "zhcn:9cf0aa1f558edb9802abcd3f",
      "kind": "character_system_text",
      "source_text": "打起精神~~……不行啊~\r\n是努力过头了吗……",
      "source_fingerprint": "7a5d690f973b123bf5c86dbfec09421f3b75aefe6aad7185f12ebc78afa07648",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20000"
      ]
    },
    {
      "uid": "zhcn:5cba91750c0e1f38bc9e21e3",
      "kind": "character_system_text",
      "source_text": "“要上喽”明明有这样的心情，\r\n身体却不听话……\r\n呜，真让人心急~……！",
      "source_fingerprint": "e8b52898d35d100681c13f7dccbc6f7a0184a455d0e81f09a33142fbd4c9efdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20001"
      ]
    },
    {
      "uid": "zhcn:155c604efc6bdbf80f2fb59b",
      "kind": "character_system_text",
      "source_text": "太阳公公之力，充电完毕！\r\n随时准备着哦！",
      "source_fingerprint": "a348b9fb301782614b4a69f6dea56ee4e3cea4fe67d0d0b2575228dcd02f4ca1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20002"
      ]
    },
    {
      "uid": "zhcn:05e5da523f9c71dff909780a",
      "kind": "character_system_text",
      "source_text": "如果有想尝试的训练，我都可以。\r\n不，请务必让我试试！",
      "source_fingerprint": "9364593d62f21c13626c56e78d6d8dd667b48cb1f721002d286b64acde2cea29",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20003"
      ]
    },
    {
      "uid": "zhcn:5729a2b9f7b687a4d44a6c63",
      "kind": "character_system_text",
      "source_text": "能在比赛中迅速脱离集体的话，\r\n感觉会更容易取胜！\r\n朝着这个方向努力锻炼吧！",
      "source_fingerprint": "27e4e7bc37b37a225911e9156abf0820e54a8eca0996a59093c4fd0d26133c23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20004"
      ]
    },
    {
      "uid": "zhcn:d48ad97ff31d3f746018f781",
      "kind": "character_system_text",
      "source_text": "嗯嗯，感觉不错♪\r\n光靠平时的训练大概是不够的！",
      "source_fingerprint": "aa3f4eebeded47dde53a1fcecb2da5bf8b3e7c41b6ac12d8cc94ddeb1466812d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20005"
      ]
    },
    {
      "uid": "zhcn:8819c83089d959cedd5a0ee5",
      "kind": "character_system_text",
      "source_text": "天气真好啊~\r\n正是训练的好时刻！",
      "source_fingerprint": "3ce7b6b86da1f7176f20aef844a3bd9539ee966076df85d656816fd8d4bef3e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20006"
      ]
    },
    {
      "uid": "zhcn:6c5183bebba3a481e798cc9b",
      "kind": "character_system_text",
      "source_text": "多多训练，和憧憬的前辈们并肩作战。\r\n目标是，强大而华丽的赛马娘！",
      "source_fingerprint": "e565ba4cd5e8964f8d1945941cd0f2fbe5e89823ee2a5064dc4c1cc30fd63640",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20007"
      ]
    },
    {
      "uid": "zhcn:7b855b64460c199e60b0ef90",
      "kind": "character_system_text",
      "source_text": "……嗯诶？\r\n哇，对不起！我有点发愣了……",
      "source_fingerprint": "1e2d4d8dcc77bac402e2a4e6504505ae50d0a7da3f8d7b20a5b93d6961896ecc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20008"
      ]
    },
    {
      "uid": "zhcn:8085152f48beaec6a8d5ac3e",
      "kind": "character_system_text",
      "source_text": "气氛阴沉沉的……但是，\r\n训练还是要好好做呢！",
      "source_fingerprint": "d8a9e949f6716b28d3cdc9136d1002b50525366781d497a8c36034c3964857cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20009"
      ]
    },
    {
      "uid": "zhcn:c3b2ca0d4384f57a313a0553",
      "kind": "character_system_text",
      "source_text": "今天的训练，\r\n那个~……散步之类的……\r\n可以吗？",
      "source_fingerprint": "94a66db5d94e0f10436293a7503ed3604ea06d2bd05b170f533a2cc549a4dc8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20010"
      ]
    },
    {
      "uid": "zhcn:e1fa825d8e5109c1c7dafdf5",
      "kind": "character_system_text",
      "source_text": "动起来啊我~……\r\n这么不中用的话，\r\n可没脸面对后冠之名啊~",
      "source_fingerprint": "c6a801e46bb9f745e95e99e92ae9aaf5d346cb3bea9de85ebac66b07cad44c13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20011"
      ]
    },
    {
      "uid": "zhcn:155da9b4feae490a39ef3154",
      "kind": "character_system_text",
      "source_text": "我很喜欢闪闪发光的比赛。\r\n但是现在却觉得赛跑很辛苦……\r\n很讨厌，明明不想这样的……！",
      "source_fingerprint": "3a4af4dfedbe3119c1716ddefed7c1330eccc3a0787c5453a763430f54bd439b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20021"
      ]
    },
    {
      "uid": "zhcn:8bdfdae3d9a13e2b7604de4b",
      "kind": "character_system_text",
      "source_text": "可以先休息一下吗……？\r\n我一定会复归，然后变得\r\n能挑战任何赛事的！",
      "source_fingerprint": "9192ad06174a406bbfb62b65772a38c702622785a60b60fb527f313e7e38f4a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20022"
      ]
    },
    {
      "uid": "zhcn:49f695067c841cf6cce01287",
      "kind": "character_system_text",
      "source_text": "火力全开！\r\n这是努力后的成果，\r\n我要充分地展现出来！",
      "source_fingerprint": "fdcb44917a048ba3ccb87238a3b8d5c9ba84eacd0393b92ca3c31f893e79cf14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20023"
      ]
    },
    {
      "uid": "zhcn:094110f41c40a71d46decf8a",
      "kind": "character_system_text",
      "source_text": "今天的我，\r\n感觉能达成史上最速！\r\n跑出一场能被传颂的比赛……！",
      "source_fingerprint": "056a37f2a6c51642742614b7463f48ff3caedb2c43c5bade43177e79f5bb9d10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20024"
      ]
    },
    {
      "uid": "zhcn:20528e2a3418698298b359ee",
      "kind": "character_system_text",
      "source_text": "心里就像太阳一样熊熊燃烧着！\r\n这样的话能赢！一定能赢！",
      "source_fingerprint": "4a4edc8fc26fc8c42ac32445db05e43f3b03d178c707c65454814977c9e7aa9a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20025"
      ]
    },
    {
      "uid": "zhcn:2447be63b35ca59f461ed72d",
      "kind": "character_system_text",
      "source_text": "感觉不错♪\r\n就以这样的气势，\r\n从一开始飞奔起来吧~！",
      "source_fingerprint": "5a02fc4d9c908d850e905bc122cb1fb0d4093c1f31f91ce78099a8bdc41d6df7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20026"
      ]
    },
    {
      "uid": "zhcn:99f9123f2ce4503d1d476c38",
      "kind": "character_system_text",
      "source_text": "状态很好！\r\n接下来只要好好走自己的路就行了！",
      "source_fingerprint": "36ca826a3e99ce227d6994a9f5091e4d23434fb187c6a250fe6e6485d36b968d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20027"
      ]
    },
    {
      "uid": "zhcn:798b924a19b4c4bd966fe0c8",
      "kind": "character_system_text",
      "source_text": "今天的比赛，我能拍照片留念吗？\r\n保证会拍出好作品的！",
      "source_fingerprint": "501076a7207b0c171cf3c51f7e8f3cdd1db308d3287975b31610bb7fbd5dbd6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20028"
      ]
    },
    {
      "uid": "zhcn:99a2f23e3ee1f491a402d7ee",
      "kind": "character_system_text",
      "source_text": "和后冠之名相称的奔跑，\r\n我要以此让大家大吃一惊！",
      "source_fingerprint": "ef31f99b271448f7e0ce40d85468e592d618b8102bebd29903971a9ecc8d3193",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20029"
      ]
    },
    {
      "uid": "zhcn:f6fec9d90e768f89f3376d0e",
      "kind": "character_system_text",
      "source_text": "这次的结果会影响到下一次……\r\n可不能输啊！",
      "source_fingerprint": "cd94c51ab0fd5119fcd1dd638b95720d7c0ed6b58c5681d0d98bed64de7837b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20030"
      ]
    },
    {
      "uid": "zhcn:74dafe5a390878a51ba9e95f",
      "kind": "character_system_text",
      "source_text": "这场比赛，\r\n只要赢了就能够开拓未来！",
      "source_fingerprint": "94bb042d70fe34ad83e35baa72e06bc4ac085211c0948b3e53fc31db80fe6e06",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20031"
      ]
    },
    {
      "uid": "zhcn:c4089990d3c43bcc5b0bbd50",
      "kind": "character_system_text",
      "source_text": "即使状态不好，也不能低着头。\r\n只要看着前面就好！",
      "source_fingerprint": "eeec15de7edad172615271e7007886246a28361e0aa0e64203d1b17c78ed8f6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20032"
      ]
    },
    {
      "uid": "zhcn:672081271b68fc97c75431cd",
      "kind": "character_system_text",
      "source_text": "嗯~可能是阳光不足了。\r\n晒太阳的时间…啊哈哈，没有呢~",
      "source_fingerprint": "2db7669b0e79869dc86046e47dddcb37da8f1cec2ee872c4b96e766a87c0531a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20033"
      ]
    },
    {
      "uid": "zhcn:8aa134f18d4ac2fc3f71a872",
      "kind": "character_system_text",
      "source_text": "冷静下来……像往常一样，\r\n像往常的我一样…………\r\n往常的，是什么样呢！？",
      "source_fingerprint": "7f601f116a594365ff830a62cf0e4473ede843c89f8a65ee6f01c5a267ceb11b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20034"
      ]
    },
    {
      "uid": "zhcn:5ceb7dac070c8e111becf396",
      "kind": "character_system_text",
      "source_text": "或许不能希望有好结果……\r\n啊，不行不行！还是想想\r\n怎样把拥有的东西都倾泻出来吧！",
      "source_fingerprint": "c07d5e1467a6b404d19ee0fbd60b6f6e99c7e93ae5f271c27d7adbf7b8b4033d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20035"
      ]
    },
    {
      "uid": "zhcn:8a5c1c723b7ac99b394ebb70",
      "kind": "character_system_text",
      "source_text": "平时的状态都发挥不出来了~\r\n可能是因为练习太过头了吧……\r\n呜，现在后悔也晚了啊。",
      "source_fingerprint": "880d99a0ce681c404a57d67cb8f578d0b7f7aec4d6a350d724dc0f384e3bcd22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20036"
      ]
    },
    {
      "uid": "zhcn:918a1edb02e2a1ad5eaafbcc",
      "kind": "character_system_text",
      "source_text": "即使状态不好，也应该有\r\n能做的事情。后冠赛马娘们，\r\n一定也是这样挺过来的……！",
      "source_fingerprint": "473d76fff119fdc28649f56d8b2a623992db3fd2cbe1aa4c5826d442d5621781",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20037"
      ]
    },
    {
      "uid": "zhcn:10e4b292546230c98104db3f",
      "kind": "character_system_text",
      "source_text": "好了！",
      "source_fingerprint": "0b45c5021c51050d5dfc664eefc04d795ec85bdaa386e291e2b0ddd9b9d55142",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20038"
      ]
    },
    {
      "uid": "zhcn:cd4737c6d0935ac56e3a3e2f",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20039"
      ]
    },
    {
      "uid": "zhcn:9bd6c826267e59fbd7b2cfbd",
      "kind": "character_system_text",
      "source_text": "好的！",
      "source_fingerprint": "49dffd45dbcf3cbb7b2debd6497fb9bed179e4b28d71fa232c2a34524481b72d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20040"
      ]
    },
    {
      "uid": "zhcn:bee5adc5bc6502f6512bb254",
      "kind": "character_system_text",
      "source_text": "嗯~！",
      "source_fingerprint": "6e5df34e7578a0cddfe14f277572345cc1a98b0dbcbcb7308c27338fce605b6e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20041"
      ]
    },
    {
      "uid": "zhcn:06f8116fae0128f4bd566a34",
      "kind": "character_system_text",
      "source_text": "诶！？",
      "source_fingerprint": "1a8873d59e2478743259ca3d94e9becb9f39d6efd3e33856c29ba60881a92e91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20042"
      ]
    },
    {
      "uid": "zhcn:4e3c651bfd24abae2363b333",
      "kind": "character_system_text",
      "source_text": "啊呜……",
      "source_fingerprint": "ec9510babac054e7c407ef5aa0246c43f620214eff20c52274a9a071ec721a62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
