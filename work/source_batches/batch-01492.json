        "1109",
        "90002"
      ],
      "json_pointer": "/1109/90002"
    },
    {
      "uid": "zhcn:a3a8a0bfb335637da9d7053c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "后冠之路没有捷径。\r\n下午的训练还请严格指导！",
      "source_fingerprint": "ec334463ae8bcb84d82987666795b90c64cb8ee9b0cef460fed15419a4e9318c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90003"
      ],
      "json_pointer": "/1109/90003"
    },
    {
      "uid": "zhcn:94d2605552a5bd54ece82c0d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "还得早起，读书什么的先忍忍……\r\n但是要到和魔王战斗的精彩场面了\r\n……只、只是一下下的话……！",
      "source_fingerprint": "da00720cfbc5ff9189bdf99a948ae8a75ae0a3323b7c3cf8a98ee5dd34648b0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90004"
      ],
      "json_pointer": "/1109/90004"
    },
    {
      "uid": "zhcn:81abfadc9d54297710fd8f0c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "西沙里奥的手，\r\n让人感到温暖又心情舒畅~\r\n今晚也让她帮我吹干头发吧♪",
      "source_fingerprint": "370422940ce1692bafdcf32aed30a90747d5fc32da3833f269a34d0b1c3f6dd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90005"
      ],
      "json_pointer": "/1109/90005"
    },
    {
      "uid": "zhcn:c4efbbc16e97deb06f2a551d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "和新入学的孩子尽情聊了\r\n后冠的话题。那孩子的梦想，\r\n要是也能实现就好了啊~",
      "source_fingerprint": "2faf4eac8328ea9500648b2feaf108ea986a5b550e699e40010f096efaa9006b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90006"
      ],
      "json_pointer": "/1109/90006"
    },
    {
      "uid": "zhcn:14dd8e4ef55da38257595e5b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "夏天独有的风景真棒啊！\n闪闪发光又帅气——\n打雷什么的，真的让人喜欢到不行！",
      "source_fingerprint": "16c722cfae34e3ff3cbf17abec73003f9d5ecc38ff461c6f28a1fe56bdec413b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
