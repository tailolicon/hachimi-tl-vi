    {
      "uid": "zhcn:5cf7867b54e018965f946d9f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "早晨的阳光，真让人受不了啊~\r\n柔柔的，暖暖的——呼喵~……",
      "source_fingerprint": "1d4250778409c5b6cffd3db03f12918514fc5ef7d6dad6155b52bfad8e818cb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
