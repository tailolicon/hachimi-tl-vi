      ]
    },
    {
      "uid": "zhcn:dcbdb44c52c5fb4a0082c7c0",
      "kind": "character_system_text",
      "source_text": "哪怕是一点点，\n也让我们积累起来吧。",
      "source_fingerprint": "dd566dfdc23ba285889f7febdf68afba67a313a89bb23ef1771601623cf0cbb4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "110000"
      ]
    },
    {
      "uid": "zhcn:b6d156fcd7aeb666910af664",
      "kind": "character_system_text",
      "source_text": "有多少步就有多少历史……\n那每一步，都是构筑当下的基石呢。",
      "source_fingerprint": "87a507913709f83fc6a310f1ca49463a81b7c37b29a02b093d03482bc704a863",
      "source_path": "character_system_text_dict.json",
      "json_path": [
