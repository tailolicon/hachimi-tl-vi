      ]
    },
    {
      "uid": "zhcn:a6f2d2962df67d12a0e6fa51",
      "kind": "character_system_text",
      "source_text": "…ま、そう落ち込むなって！",
      "source_fingerprint": "3a0bfe68b2e60495332ee78f51b580718dafe16df81aa698be4a98d31baa16be",
      "source_path": "character_system_text_dict.json",
