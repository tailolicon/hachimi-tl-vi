      ]
    },
    {
      "uid": "zhcn:8d0e6facbac6d2ff84db8c2a",
      "kind": "character_system_text",
      "source_text": "ヒュウッ！器用だなアンタ！",
      "source_fingerprint": "a387dee352f99f044ff9c86d5ca34535691a5009dff3ae8a6ed16e59fb025144",
      "source_path": "character_system_text_dict.json",
