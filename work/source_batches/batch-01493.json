      "source_text": "——那么，走吧。",
      "source_fingerprint": "b7e4a84f1ef26b5ae1716f4e13e6f249140c0ae3439ecc210682e9f04edd0959",
      "source_path": "character_system_text_dict.json",
      "json_path": [
