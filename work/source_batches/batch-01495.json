      "source_text": "呵呵，真帅气啊♪",
      "source_fingerprint": "d796ea2c1c7876ee9da5c7e00b530ffdd1765f167f3223f239090b1eed4670e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
