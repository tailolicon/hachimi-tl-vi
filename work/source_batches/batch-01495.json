      ],
      "json_pointer": "/1110/91021"
    },
    {
      "uid": "zhcn:0ce6a0fbd7521bd115f3d496",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "饭后的蛋糕，要来一份吗？\n首推是我们特别讲究的蛋白霜哦。\n……期待您的感想呢♪",
      "source_fingerprint": "5f960ce952ea2e568878923d31fda2d31038fd56753ce451bf7dc1f69cb7e7a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
