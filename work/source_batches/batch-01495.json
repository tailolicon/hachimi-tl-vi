      ],
      "json_pointer": "/1110/91020"
    },
    {
      "uid": "zhcn:4a12339ca03d6d35ac09f63a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "早上散步的时候，孩子们眼睛闪闪发光地\n对我说好漂亮！……我成为那些孩子的光了吗。",
      "source_fingerprint": "2d733b3ac32cd03feb910000e228da3ac5d9513f314412cf6565767dd8389c82",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
