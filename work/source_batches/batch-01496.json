        "1110",
        "92018"
      ],
      "json_pointer": "/1110/92018"
    },
    {
      "uid": "zhcn:19c7afeec1c0790d521069a2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "共同鸣钟吧。\n愿这充满希望的嘹亮钟声，\n能传达到遥远的未来！",
      "source_fingerprint": "0991bbd47719c070ca0691bbc4064feaf1be67c1de8bfe26158122adaa7c5b43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "92020"
      ],
      "json_pointer": "/1110/92020"
    },
    {
      "uid": "zhcn:69604f78d34993774a98aa05",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "无论是什么样的道路我都不会停下脚步。\n没有无法实现的思念……只要有您\n在身边，我就能如此坚信。",
      "source_fingerprint": "71aa192832837d2a1cefa6ce35ad1b8c94002cb031e8b77f70ed381bbc42dc34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "92021"
      ],
      "json_pointer": "/1110/92021"
    },
    {
      "uid": "zhcn:d5feb96dcc2a2975ecf0e359",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "直到构筑起充满幸福的未来为止。\n与您编织故事这件事——\n我在此起誓。",
      "source_fingerprint": "6342859f8d6a46786caa9b5d1c26f377fc9851fde265316fcda4526091982c1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "92022"
      ],
      "json_pointer": "/1110/92022"
    },
    {
      "uid": "zhcn:173064c52f5a4c8f398725db",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "如果是与您一起，无论在世界的何处，都能战斗！",
      "source_fingerprint": "729f6db1e1cff1b227e0f4ae5039e4a2202fdeb68668db5b60778441c4fb1ac7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "93000"
      ],
      "json_pointer": "/1110/93000"
    },
    {
      "uid": "zhcn:40123c7fdd5ad6c901642a93",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "这份思念也将，连绵不断。",
      "source_fingerprint": "41da0887819642691a85d12454550b76a464ffb9c2f88543ca5458f302969885",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
