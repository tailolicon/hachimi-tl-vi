    {
      "uid": "zhcn:f3ad2edd643c51d9f60fb958",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "Oh no!",
      "source_fingerprint": "241a3380b7970c555c98ca9c9f8fc5c56c7cc70ead56a768354302d64d6e1f0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
