      ]
    },
    {
      "uid": "zhcn:9b03ec798115b5a5ea8207d1",
      "kind": "character_system_text",
      "source_text": "不愧是您呢！",
      "source_fingerprint": "939fc7314008270c9046e60c8b5910a264609fbcb16999fcc0fc0a88866d7c03",
      "source_path": "character_system_text_dict.json",
