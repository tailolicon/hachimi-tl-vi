      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "10017"
      ]
    },
    {
      "uid": "zhcn:c9d61669fbaa343eac3e2a41",
      "kind": "character_system_text",
      "source_text": "活动马上要来了哦！\r\n后冠路线的前辈们会来参加吗！？",
