      ]
    },
    {
      "uid": "zhcn:6bbbb64e6826ba6325592778",
      "kind": "character_system_text",
      "source_text": "光是穿上就紧张……不过干劲也上来了！",
      "source_fingerprint": "16c3484e216751a0e1f9e4c2d2bbef61f3bc5482c71ad6a25bb5ae961c598494",
      "source_path": "character_system_text_dict.json",
