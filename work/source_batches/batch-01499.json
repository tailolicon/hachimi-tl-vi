    },
    {
      "uid": "zhcn:cc299bd94a01fa4ffa659e02",
      "kind": "character_system_text",
      "source_text": "呐好闲啊。\n大家在比赛前都会做什么呢？\n……Umasta？",
      "source_fingerprint": "75d5785a950ab613845ab79792eaf463cf93863c163fbca90ab8c7f4a22e151f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
