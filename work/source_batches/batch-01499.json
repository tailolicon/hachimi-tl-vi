        "1109",
        "20042"
      ]
    },
    {
      "uid": "zhcn:4e3c651bfd24abae2363b333",
      "kind": "character_system_text",
      "source_text": "啊呜……",
      "source_fingerprint": "ec9510babac054e7c407ef5aa0246c43f620214eff20c52274a9a071ec721a62",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20043"
      ]
    },
    {
      "uid": "zhcn:dd83b43d28ee17705ece9ac4",
      "kind": "character_system_text",
      "source_text": "哇~♪",
      "source_fingerprint": "363e65f4d4485787657929fbc72f4f911dfe6f1e1d493c647cd14d6f672153ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20046"
      ]
    },
    {
      "uid": "zhcn:6bb8c9be553c0d9cfc71e3e1",
      "kind": "character_system_text",
      "source_text": "go——！",
      "source_fingerprint": "4d9f139e1eadc3c717fb7124e1528ce6e7b438e01afa26ac0ec4ab9db7cc5681",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20047"
      ]
    },
    {
      "uid": "zhcn:8bbc329f9dc4c7f739a972c1",
      "kind": "character_system_text",
      "source_text": "这就是，我的轨迹……！",
      "source_fingerprint": "eec8cf5a510a6bbe44256153fd259da30f9cd35cbb892249e61f4108d5020e69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20049"
      ]
    },
    {
      "uid": "zhcn:543a8c5076f85be1fc09c453",
      "kind": "character_system_text",
      "source_text": "有更接近我的憧憬了吗？",
      "source_fingerprint": "4002f529fea7abbfa14f932ef151cd9133a7c3b934feede6b0c76d00fc450a4f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20050"
      ]
    },
    {
      "uid": "zhcn:0eeb30fbe38c863898910a29",
      "kind": "character_system_text",
      "source_text": "奉陪到底哦！",
      "source_fingerprint": "efeac453563ccca047d5a4062e819c3d0f756f6a285b1469b317a4c0bc603097",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "20051"
      ]
    },
    {
      "uid": "zhcn:155d1cf27d12907a6c4d0712",
      "kind": "character_system_text",
      "source_text": "好了，出发吧！",
      "source_fingerprint": "95ef3b7ecf7b554f835c7c37f5680de67f6628381e334b08237939214f949fe8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "2030"
      ]
    },
    {
      "uid": "zhcn:6f09d24c099c95541b0f48c1",
      "kind": "character_system_text",
      "source_text": "一定要赢！",
      "source_fingerprint": "12518491d06523566ed3a987a3e8b422e85c553814e04211a044d6f9999bb170",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "2031"
      ]
    },
    {
      "uid": "zhcn:3513f9168779a6932f114f44",
      "kind": "character_system_text",
      "source_text": "我有更接近自己的憧憬了吗？",
      "source_fingerprint": "0a79b5be23b7d3202d6a7bd2c5762ee48582db9c25b62a27e00cafd857f10cae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "2032"
      ]
    },
    {
      "uid": "zhcn:831bfab26937ac18f64ecc3a",
      "kind": "character_system_text",
      "source_text": "今天的比赛，我能拍照片留念吗？\r\n保证会拍出好作品的！",
      "source_fingerprint": "501076a7207b0c171cf3c51f7e8f3cdd1db308d3287975b31610bb7fbd5dbd6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "2033"
      ]
    },
    {
      "uid": "zhcn:93219fdba34c3c1dacb5d5b0",
      "kind": "character_system_text",
      "source_text": "心里就像太阳一样熊熊燃烧着！\r\n这样的话能赢！一定能赢！",
      "source_fingerprint": "4a4edc8fc26fc8c42ac32445db05e43f3b03d178c707c65454814977c9e7aa9a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "2034"
      ]
    },
    {
      "uid": "zhcn:9c42403fe82ba09f185c55d2",
      "kind": "character_system_text",
      "source_text": "我有更接近自己的憧憬了吗？",
      "source_fingerprint": "0a79b5be23b7d3202d6a7bd2c5762ee48582db9c25b62a27e00cafd857f10cae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "2035"
      ]
    },
    {
      "uid": "zhcn:feeab657b8cf459e2a5c3e6a",
      "kind": "character_system_text",
      "source_text": "好了！",
      "source_fingerprint": "0b45c5021c51050d5dfc664eefc04d795ec85bdaa386e291e2b0ddd9b9d55142",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "23015"
      ]
    },
    {
      "uid": "zhcn:2b9f418b171be1bddf670b87",
      "kind": "character_system_text",
      "source_text": "下次一定不会让出第一名！",
      "source_fingerprint": "bf1de7467691f78d809aebb263b3d169474de38d0a0def91319e93d78fe26b22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f7e137a323248722c7f5c77b",
      "kind": "character_system_text",
      "source_text": "我所憧憬的……还在更前方！",
      "source_fingerprint": "927f586e58a7db614eea6e1f895d98ebc4eb9b2648c26b8f5031c7b0ee776d56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30001"
      ]
    },
    {
      "uid": "zhcn:962bd80deae3baa469cdd85a",
      "kind": "character_system_text",
      "source_text": "我会继续挑战……无论多少次！",
      "source_fingerprint": "9d777c2f1486a7723118c0ba050b6647f5c5e018545cd643ff1c6bd56fd2a07d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30002"
      ]
    },
    {
      "uid": "zhcn:0da6242b94d93ed098257213",
      "kind": "character_system_text",
      "source_text": "我还没有放弃！",
      "source_fingerprint": "c67e41ac074a92f0cf71dcf6f281178e50ab96227502b5500524aabad2f5c87a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30003"
      ]
    },
    {
      "uid": "zhcn:787153dd549ada02743da210",
      "kind": "character_system_text",
      "source_text": "希望这场胜利，能留在某人心中！",
      "source_fingerprint": "dec609233332b45887fef572b8e1e9f29c337656a794241b3e27627d30abdd43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30004"
      ]
    },
    {
      "uid": "zhcn:f9063a41e3cc7d6d1bc22b3d",
      "kind": "character_system_text",
      "source_text": "这是连接未来的胜利，对吧！",
      "source_fingerprint": "afd02674f3036b92ab4a998e425eaa79cd972f0110ca58b49ab05ab211387066",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30005"
      ]
    },
    {
      "uid": "zhcn:575fd2e8a6b6f536ce1a43d7",
      "kind": "character_system_text",
      "source_text": "希望这次奔跑，\n能够成为通向未来的接力棒！",
      "source_fingerprint": "4ddbd0165a2d06948862f15602ff9bba78d9197efeed65e1a22a46a7a8c95352",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30006"
      ]
    },
    {
      "uid": "zhcn:233f1f24f60724f1edb66b61",
      "kind": "character_system_text",
      "source_text": "这是通向未来的胜利呢！",
      "source_fingerprint": "27d94851cce8470a412f2b97413b6ffd22728f2f6ff7c25ff90a1cdaa25803a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "30007"
      ]
    },
    {
      "uid": "zhcn:7c13cf144afbe5801c46abef",
      "kind": "character_system_text",
      "source_text": "要上了！",
      "source_fingerprint": "1517fbd3c7a4b1a9bc6c0f2a21ca4dcc3ad0db20e4ce267cdba0767e3af1e843",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "31000"
      ]
    },
    {
      "uid": "zhcn:fc1ec510b584eda2c9a29005",
      "kind": "character_system_text",
      "source_text": "去开拓吧！",
      "source_fingerprint": "027cbe523212aa24da035e91bfd620bd5baaa73a29c5b04a14fca469430f7de8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "40000"
      ]
    },
    {
      "uid": "zhcn:6dd0019f20ac5ebe3f719edf",
      "kind": "character_system_text",
      "source_text": "高峰小姐的樱花赏，无论看多少次，\n都觉得优雅又完美……啊～真的\n和她一起成为了缪斯啊……",
      "source_fingerprint": "a30ef1509707a306e2c7ea084b595c2749a82847beed98a32031b10e12d5ef65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "400002"
      ]
    },
    {
      "uid": "zhcn:8327ac43a02968a6f6ca1ab5",
      "kind": "character_system_text",
      "source_text": "颅骨矫正……和比赛有没有关系\n我不太确定，但如果能像高峰小姐\n那样变得漂亮的话，或许可以试试看。",
      "source_fingerprint": "050ce6397d35b2bfb2ddd594f4dcfca77f1e7a79a3424e2a6465d2cd2569dc25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "400004"
      ]
    },
    {
      "uid": "zhcn:8677243ba6dbd41bf3c10c96",
      "kind": "character_system_text",
      "source_text": "对三后冠的热爱，谁也比不上我！\n因为我是最强的！\n……必须怀着这样的心情去挑战才行呢！",
      "source_fingerprint": "fb9962e1d4aef5bcaea9efee504c8f76c3ef24bf30ab7922947a1f5fcc08dd01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "400008"
      ]
    },
    {
      "uid": "zhcn:117e6a6f32df4b03bbdaeed7",
      "kind": "character_system_text",
      "source_text": "就像某个人曾经向我\r\n展示过的那样。我也要开拓\r\n属于自己的新道路和未来！",
      "source_fingerprint": "fcc52d4d786a0bf70098fdc2992895ad0f0da1e9b4be9b08f8b0d2d33c8b1571",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "40001"
      ]
    },
    {
      "uid": "zhcn:3e1b46a59588502ceb1a6690",
      "kind": "character_system_text",
      "source_text": "无论何时……尽情闪耀吧！",
      "source_fingerprint": "6ff59001d2d794bed30b56499f4d670355cd13a9f702992643fd58ea6616ddd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "40003"
      ]
    },
    {
      "uid": "zhcn:3f29ab218fd4e020d789e091",
      "kind": "character_system_text",
      "source_text": "愿这份光辉，\n穿越时空，永不止息——闪耀吧！",
      "source_fingerprint": "1dd76b43310d8299ee6a1951e1c9321f95fdc93233144ac347091296bf82ae5c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "40004"
      ]
    },
    {
      "uid": "zhcn:86655c50370f369ae069a6f7",
      "kind": "character_system_text",
      "source_text": "这场Live，\r\n一定也会成为某人的憧憬……\r\n一定得让它成功！",
      "source_fingerprint": "d3c724dbe14483af6c4a020b5b624c52ed736b17f5077ac405afa748d98f0b09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "60000"
      ]
    },
    {
      "uid": "zhcn:6282e502a2f9ab197be8c960",
      "kind": "character_system_text",
      "source_text": "不能留下难看的样子。\r\n要把现在拥有的东西全都展示出来！",
      "source_fingerprint": "6cfbcf4784d20a233ae43bd2ed69bc1476e325c1f0d3f0b12fc23d2320523a01",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "60001"
      ]
    },
    {
      "uid": "zhcn:d0f9242cf2b99986b6d2edcf",
      "kind": "character_system_text",
      "source_text": "我的心意，将其连结！",
      "source_fingerprint": "90fbcd5f4ffcef67d143316af5be8c444bcada19e53b65552edba03b81e777eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70000"
      ]
    },
    {
      "uid": "zhcn:4248dfe58d449e2b6b07d0a7",
      "kind": "character_system_text",
      "source_text": "后冠赛马娘既强大，又华丽……\r\n啊，之前也说过这话呢！\r\n……欸嘿嘿。",
      "source_fingerprint": "6f44b676aaff99ee67af7c106bebe394d563d11411db38e9efd12fa3ab9ba3ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70001"
      ]
    },
    {
      "uid": "zhcn:3a6e415efaaa2fa996dfedf3",
      "kind": "character_system_text",
      "source_text": "制服也有被继承的历史呢。",
      "source_fingerprint": "271425e5842292909662a1049552f45b0406a51a7f40c33b87d4ecc9f2e7782d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70004"
      ]
    },
    {
      "uid": "zhcn:e67d304e767b2135ad3eb8a0",
      "kind": "character_system_text",
      "source_text": "真想举办一场\r\n和前辈们一样的Live啊~",
      "source_fingerprint": "47384efc59f11e8f3b2b3130d8b54e16cf7d9f7eef0d54fa6ebaa5456fb5628a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70008"
      ]
    },
    {
      "uid": "zhcn:1722d7a3a0ab3241021adce1",
      "kind": "character_system_text",
      "source_text": "总有一天，\r\n请为我戴上头冠拍下照片！",
      "source_fingerprint": "4da30afa7c5b9300c677daa7f8e935d743b54005fb44fe5dd60fbd5d5b6bd8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70009"
      ]
    },
    {
      "uid": "zhcn:7a693cfebe787b81968d3bae",
      "kind": "character_system_text",
      "source_text": "爽快干脆地被西沙里奥锻炼了♪",
      "source_fingerprint": "2162031458e7c50969a538c21111362cad656acd21c19d550b45784e02b4c964",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70010"
      ]
    },
    {
      "uid": "zhcn:2359b2be7724aca1cff90600",
      "kind": "character_system_text",
      "source_text": "day by day~♪\r\n果然得是这首曲子呢。",
      "source_fingerprint": "e257be48b35338653e75216120f91436b1b3fdb64afd43108a2481949314633e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70014"
      ]
    },
    {
      "uid": "zhcn:4cbe9f4d4b8ebc633e53ad83",
      "kind": "character_system_text",
      "source_text": "这副身姿要是也有人憧憬就好了。",
      "source_fingerprint": "1af3c556435b8fe8c1385508a9ddebfdf482037d1a4da2677ee9d6cb2b04a4a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70015"
      ]
    },
    {
      "uid": "zhcn:5b25dea2a79e85b3e0826644",
      "kind": "character_system_text",
      "source_text": "头冠的中间和翘起的头发\n合在一起，然后就。",
      "source_fingerprint": "b3773fe5d5bf20fe18bcfe0724611ffb6fa8bc46a213386d194fbab2c5590cf8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70016"
      ]
    },
    {
      "uid": "zhcn:ce10b6b4f067d6cf6f0c60bf",
      "kind": "character_system_text",
      "source_text": "欸嘿嘿。\n想以城堡为背景拍张纪念照呢。",
      "source_fingerprint": "20734e80cfd250642502e050a112d9141ba89f430be0774296ab8da2b152eb70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70017"
      ]
    },
    {
      "uid": "zhcn:789e05afd576805aafa36923",
      "kind": "character_system_text",
      "source_text": "哦，是新的感觉！",
      "source_fingerprint": "a0030f87b7d00551c14de8cdf08723b3752d630b622d0283b13e3c5f529d4c0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70018"
      ]
    },
    {
      "uid": "zhcn:a206d0a030470287a2360b94",
      "kind": "character_system_text",
      "source_text": "这种路线也不错呢♪",
      "source_fingerprint": "13460b2364817c87a41dbdfa0e101c717df840bb917ea3517bb417c547e8c9cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70019"
      ]
    },
    {
      "uid": "zhcn:0aece2f5bc3043f65481b72a",
      "kind": "character_system_text",
      "source_text": "一起悠闲自在地度过吧~",
      "source_fingerprint": "7bd4d7a52340fdae63165ce926dfb55095cfdaa1f3002d8f4ee2cabe33d1d4c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70020"
      ]
    },
    {
      "uid": "zhcn:7b1fb21a421f3c018041280a",
      "kind": "character_system_text",
      "source_text": "出门喽出门喽~♪",
      "source_fingerprint": "85350beadf928a9ad32874b8bbf1608b345bef9142187c7a09b22de50bf82096",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "70021"
      ]
    },
    {
      "uid": "zhcn:8a0410a7c4212e5090b18cee",
      "kind": "character_system_text",
      "source_text": "制服也有被继承的历史呢。",
      "source_fingerprint": "271425e5842292909662a1049552f45b0406a51a7f40c33b87d4ecc9f2e7782d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71004"
      ]
    },
    {
      "uid": "zhcn:aa222f767bf049cb72b1a8cb",
      "kind": "character_system_text",
      "source_text": "真想举办一场\r\n和前辈们一样的Live啊~",
      "source_fingerprint": "47384efc59f11e8f3b2b3130d8b54e16cf7d9f7eef0d54fa6ebaa5456fb5628a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71008"
      ]
    },
    {
      "uid": "zhcn:02cb4afc05c7b7385cb255e0",
      "kind": "character_system_text",
      "source_text": "总有一天，\r\n请为我戴上头冠拍下照片！",
      "source_fingerprint": "4da30afa7c5b9300c677daa7f8e935d743b54005fb44fe5dd60fbd5d5b6bd8ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71009"
      ]
    },
    {
      "uid": "zhcn:b75d878b11bb4db90490ebab",
      "kind": "character_system_text",
      "source_text": "爽快干脆地被西沙里奥锻炼了♪",
      "source_fingerprint": "2162031458e7c50969a538c21111362cad656acd21c19d550b45784e02b4c964",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71010"
      ]
    },
    {
      "uid": "zhcn:27770024d0ee4c36ff1cfc50",
      "kind": "character_system_text",
      "source_text": "day by day~♪\r\n果然得是这首曲子呢。",
      "source_fingerprint": "e257be48b35338653e75216120f91436b1b3fdb64afd43108a2481949314633e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71014"
      ]
    },
    {
      "uid": "zhcn:2678d1d30d51dc9ab7ec0f75",
      "kind": "character_system_text",
      "source_text": "这副身姿要是也有人憧憬就好了。",
      "source_fingerprint": "1af3c556435b8fe8c1385508a9ddebfdf482037d1a4da2677ee9d6cb2b04a4a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71015"
      ]
    },
    {
      "uid": "zhcn:722b4d3b84035a0c63eb8210",
      "kind": "character_system_text",
      "source_text": "头冠的中间和翘起的头发\n合在一起，然后就。",
      "source_fingerprint": "b3773fe5d5bf20fe18bcfe0724611ffb6fa8bc46a213386d194fbab2c5590cf8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71016"
      ]
    },
    {
      "uid": "zhcn:48dddb730ebe77adc2c6eea2",
      "kind": "character_system_text",
      "source_text": "欸嘿嘿。\n想以城堡为背景拍张纪念照呢。",
      "source_fingerprint": "20734e80cfd250642502e050a112d9141ba89f430be0774296ab8da2b152eb70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71017"
      ]
    },
    {
      "uid": "zhcn:a1502ef1ba4d1ac9e3e79aac",
      "kind": "character_system_text",
      "source_text": "哦，是新的感觉！",
      "source_fingerprint": "a0030f87b7d00551c14de8cdf08723b3752d630b622d0283b13e3c5f529d4c0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71018"
      ]
    },
    {
      "uid": "zhcn:b68a3532673e6bbe809194ce",
      "kind": "character_system_text",
      "source_text": "这种路线也不错呢♪",
      "source_fingerprint": "13460b2364817c87a41dbdfa0e101c717df840bb917ea3517bb417c547e8c9cd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "71019"
      ]
    },
    {
      "uid": "zhcn:d1b7c5786d7fc4e2ef2ac81c",
      "kind": "character_system_text",
      "source_text": "辛苦了！",
      "source_fingerprint": "20df094ff1112517c623c111a7239f2b6398134743fb570a85aa6a2f9f1f8889",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "80000"
      ]
    },
    {
      "uid": "zhcn:e361fc1d956bd3ce84b3d544",
      "kind": "character_system_text",
      "source_text": "早上好！今天也要以后冠为目标，\r\n诶，诶，Go——Go——♪",
      "source_fingerprint": "97fa93ebf89e09b34bd57954f0f2e2d68b5df80d0cb7b71a8d9e7d6e3a14747b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90000"
      ]
    },
    {
      "uid": "zhcn:5cf7867b54e018965f946d9f",
      "kind": "character_system_text",
      "source_text": "早晨的阳光，真让人受不了啊~\r\n柔柔的，暖暖的——呼喵~……",
      "source_fingerprint": "1d4250778409c5b6cffd3db03f12918514fc5ef7d6dad6155b52bfad8e818cb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90001"
      ]
    },
    {
      "uid": "zhcn:a2cc494e1e3f7585d90c92d7",
      "kind": "character_system_text",
      "source_text": "Hi, good afternoon~！\r\n……怎么样，怎么样？\r\n是不是很像心心同学？",
      "source_fingerprint": "011867e35e93a0cac764f4eb49136d06767cc74b21155841cd0760ca9df238d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90002"
      ]
    },
    {
      "uid": "zhcn:a3a8a0bfb335637da9d7053c",
      "kind": "character_system_text",
      "source_text": "后冠之路没有捷径。\r\n下午的训练还请严格指导！",
      "source_fingerprint": "ec334463ae8bcb84d82987666795b90c64cb8ee9b0cef460fed15419a4e9318c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90003"
      ]
    },
    {
      "uid": "zhcn:94d2605552a5bd54ece82c0d",
      "kind": "character_system_text",
      "source_text": "还得早起，读书什么的先忍忍……\r\n但是要到和魔王战斗的精彩场面了\r\n……只、只是一下下的话……！",
      "source_fingerprint": "da00720cfbc5ff9189bdf99a948ae8a75ae0a3323b7c3cf8a98ee5dd34648b0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90004"
      ]
    },
    {
      "uid": "zhcn:81abfadc9d54297710fd8f0c",
      "kind": "character_system_text",
      "source_text": "西沙里奥的手，\r\n让人感到温暖又心情舒畅~\r\n今晚也让她帮我吹干头发吧♪",
      "source_fingerprint": "370422940ce1692bafdcf32aed30a90747d5fc32da3833f269a34d0b1c3f6dd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90005"
      ]
    },
    {
      "uid": "zhcn:c4efbbc16e97deb06f2a551d",
      "kind": "character_system_text",
      "source_text": "和新入学的孩子尽情聊了\r\n后冠的话题。那孩子的梦想，\r\n要是也能实现就好了啊~",
      "source_fingerprint": "2faf4eac8328ea9500648b2feaf108ea986a5b550e699e40010f096efaa9006b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90006"
      ]
    },
    {
      "uid": "zhcn:14dd8e4ef55da38257595e5b",
      "kind": "character_system_text",
      "source_text": "夏天独有的风景真棒啊！\n闪闪发光又帅气——\n打雷什么的，真的让人喜欢到不行！",
      "source_fingerprint": "16c722cfae34e3ff3cbf17abec73003f9d5ecc38ff461c6f28a1fe56bdec413b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90007"
      ]
    },
    {
      "uid": "zhcn:3b45a103c0f36b703a4b7a8b",
      "kind": "character_system_text",
      "source_text": "哈呼~只有到了秋天，\r\n才能这么悠闲地读书呢~……\r\n咦？书忘记带了！？",
      "source_fingerprint": "e4588aac406d548f53434eb64eb796987572d1d2a3cb42b61ec83643083b5f2f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90008"
      ]
    },
    {
      "uid": "zhcn:c0b4fdf42d2b7cfcdca7b549",
      "kind": "character_system_text",
      "source_text": "凉凉的空气，逐渐被太阳包围……\r\n哈啊~~~\r\n春天很棒，冬天也不错，对吧~♪",
      "source_fingerprint": "372dff62e04b5109a97bda81f23d7561aed90c571ea715e1a659241e7e29ff21",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90009"
      ]
    },
    {
      "uid": "zhcn:9d96cca7cc5bd8462f5865da",
      "kind": "character_system_text",
      "source_text": "早上好！……啊\n看起来很困呢。\n那就去晒晒太阳醒醒神吧！",
      "source_fingerprint": "e7889f1a6ec719ed5940f359e4f89ca3823d24ca91098a226ac43ca8e371a67d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90010"
      ]
    },
    {
      "uid": "zhcn:276a5d19c8b712ad2d9f7bea",
      "kind": "character_system_text",
      "source_text": "今天的晨练我很有干劲哦！\n虽然训练是为了自己……\n但后辈也还在看着呢！",
      "source_fingerprint": "ef44d99bf47cbafb10c417a3e267c80564048615e4b5058b25181566f0310d94",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90011"
      ]
    },
    {
      "uid": "zhcn:4df8b9995fe79945b97ef846",
      "kind": "character_system_text",
      "source_text": "潘多拉同学可会撒娇了……\n一起吃午饭的时候总会不由自主地\n不停给她夹菜……",
      "source_fingerprint": "3e692ee9476503b2bf5b2e4785ac322dc43498b54313e1e1adc2010bedfecba6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90012"
      ]
    },
    {
      "uid": "zhcn:53ed32227dee86c19e0a6ff6",
      "kind": "character_system_text",
      "source_text": "饭后的晒太阳，点心后的晒太阳……\n虽然都很不舍得，\n但我还要学习和训练所以……！",
      "source_fingerprint": "4c410038e05671c3e39c75a6200dcc0b300e7820d2282310e59aca94d658d7e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90013"
      ]
    },
    {
      "uid": "zhcn:4a8e6969f34ff823207be715",
      "kind": "character_system_text",
      "source_text": "一流的人，直到钻进被窝前都是\n一流的……遵循圣王前辈的语录\n虽然有点犯困但我还能坚持！",
      "source_fingerprint": "dffee733b7d64c01648d1fe6cf53eba44ea3fe404a6e15359ae556d98bd2a334",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90014"
      ]
    },
    {
      "uid": "zhcn:603818695196e55c8b2a48dd",
      "kind": "character_system_text",
      "source_text": "月色真美啊……\n月光浴也很有梦幻感很浪漫呢！",
      "source_fingerprint": "ef56a036dc879b70efe380f15e127c53e56632a85e413d75638bc9eb47bcaf16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90015"
      ]
    },
    {
      "uid": "zhcn:38c2269ec70d9777652866fc",
      "kind": "character_system_text",
      "source_text": "这种新事物不断萌发的氛围……\n感觉学园会迎来很棒的新生呢！",
      "source_fingerprint": "90b46274f5478e219a71705ade1a49a6781db443b282e3d499b0b709052d7362",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90016"
      ]
    },
    {
      "uid": "zhcn:0e95e3801885d1ce438bd7e1",
      "kind": "character_system_text",
      "source_text": "驱虫喷雾、蚊香、再种上薄荷……\n对策万全！今年就不用担心蚊虫了！\n……大概。",
      "source_fingerprint": "c1146d54609fa3eeb29a70c23bfe9b3ef71495085609e37759ce4f7cfc4bddcd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90017"
      ]
    },
    {
      "uid": "zhcn:8b60e9f954fbb7ad25620b4a",
      "kind": "character_system_text",
      "source_text": "难得的读书之秋，\n我要读赛跑相关的书来充实自我！\n……其实偶尔也会读读儿童绘本啦！",
      "source_fingerprint": "1119c20f3356c7f47742238766031c43d44717ca8e80f6a49fdc744efd7516c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90018"
      ]
    },
    {
      "uid": "zhcn:029dc3cd5579c000d041dd38",
      "kind": "character_system_text",
      "source_text": "即使在寒冬太阳也不会休息！\n我也要永远以最坚强的模样\n把能量传达给大家！",
      "source_fingerprint": "46f837feaf0c2f556e7171665b54100f902b52cb4849cbe5ff5f6460ebba2357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90019"
      ]
    },
    {
      "uid": "zhcn:e2d6a6cae85e37775ffc8f30",
      "kind": "character_system_text",
      "source_text": "情人节快乐！",
      "source_fingerprint": "d9e338ecc741ac949d3f240a82f8cc83ab075127e1514b8c6ff32e4c943f6fc6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90020"
      ]
    },
    {
      "uid": "zhcn:25d9b37f1e533254f5644acf",
      "kind": "character_system_text",
      "source_text": "情人节快乐！",
      "source_fingerprint": "d9e338ecc741ac949d3f240a82f8cc83ab075127e1514b8c6ff32e4c943f6fc6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "90021"
      ]
    }
  ]
}
