      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "15"
      ]
    },
    {
      "uid": "zhcn:133ca3cdf608768a2d411fa9",
      "kind": "character_system_text",
      "source_text": "今天的训练菜单是。\n……训练菜单是——\n……咦，咦？",
