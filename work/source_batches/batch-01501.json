  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:8ffa58a82ebf8bcdc733cb49",
      "kind": "character_system_text",
      "source_text": "情人节快乐♪",
      "source_fingerprint": "84545e9d062a703e60cf0240a4c6690b3f86c69931c0b8d072086c92aed0b29d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "90021"
      ]
    },
    {
      "uid": "zhcn:be7254e12a96153ca740e582",
      "kind": "character_system_text",
      "source_text": "哎~真是搞不懂宝穴前辈！\n明明自己动不动就喜欢拍肩膀，\n为什么就讨厌抱抱呢~！？",
      "source_fingerprint": "44bafb2f454597d35755973197956e6ece7eb99ae2d055cc8a907351f90b730d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91000"
      ]
    },
    {
      "uid": "zhcn:4319641e47cd38509132a5af",
      "kind": "character_system_text",
      "source_text": "小目的便当到手~♡\n吃了这个我的天才力就能提升♪\n下次休息日再让她帮我做好了♡",
      "source_fingerprint": "8086845d257ad8448bb118bf252b56f0fb30c0c7b7e42cbe099250714ab96076",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91001"
      ]
    },
    {
      "uid": "zhcn:ed4dc6b0f27ec06e705e2667",
      "kind": "character_system_text",
      "source_text": "华丽又闪闪发光的东西\n我都超~~~~喜欢♡♡\n公主战士的联名化妆品我绝对要买♡",
      "source_fingerprint": "01e2a2c5ad7d9c9b7634424afce39d139eefd59054e60aead680868e7d1ef3a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91002"
      ]
    },
    {
      "uid": "zhcn:f7228997a150461129c49769",
      "kind": "character_system_text",
      "source_text": "呐~你知道我的耳机跑哪去了吗？\n真是糟透了……我超喜欢这副耳机的\n……嘛，再去买一副就行了☆",
      "source_fingerprint": "25442bd0ee3fc94d28a04d4629d5a08370c687ffc22d5751b9e77a9c9ce86e6c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91003"
      ]
    },
    {
      "uid": "zhcn:692edb1b2d97acde65a484b4",
      "kind": "character_system_text",
      "source_text": "怎么了？别因为\n人家可爱就看得这么入迷啦~♡\n……欸不是吗？别害羞嘛~！",
      "source_fingerprint": "c62eb9db594a986f48aa127a7e9c99f35f8763986dddda0a1581229fa3791eff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91004"
      ]
    },
    {
      "uid": "zhcn:a3716dbd934a36d5b43652ab",
      "kind": "character_system_text",
      "source_text": "怎么样？很合适吧~♡♡\n虽然会更喜欢更华丽一点的……\n不过我长得这么天才完全没问题♡",
      "source_fingerprint": "012329b45743968956323073daf3d53473ff4f1dddafae358ce41d7d7c46dc81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91005"
      ]
    },
    {
      "uid": "zhcn:b2845489955aa22086eb1d4a",
      "kind": "character_system_text",
      "source_text": "难得有配套衣服~\n想找人一起拍个Umatok呢♪\n欸嘿嘿~要找谁呢♡",
      "source_fingerprint": "106ee4154d691dbe1e84bed9a2df2b63cf44fe1d7a0f0ae27277300ffce9aab6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91006"
      ]
    },
    {
      "uid": "zhcn:2ef8e8b321e5a024cb9f68cf",
      "kind": "character_system_text",
      "source_text": "欸嘿嘿~这套决胜服真天才♡\n袖子的透明感~花边和蝴蝶结~\n还有身为设计者的我全都很天才♡♡",
      "source_fingerprint": "fb06074a2ab9c1371f8883b76b45bcdf483cdf1e13cfbe8be4c71e5ca90f8344",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91007"
      ]
    },
    {
      "uid": "zhcn:947ccc418f68d213ac92146a",
      "kind": "character_system_text",
      "source_text": "呜~太失败了！\n装饰做得太多了啦~~！！\n清洗时要一个个取下来麻烦死了！",
      "source_fingerprint": "6b11c5cb013c393bc4d78e255651cecad73dac6917f0a02c414d609e9b836909",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91008"
      ]
    },
    {
      "uid": "zhcn:3199b13b18d46fbd6757bdc8",
      "kind": "character_system_text",
      "source_text": "……真是的~干嘛啦。\n早上起来脸肿了，\n不过肿了也很可爱就是了。",
      "source_fingerprint": "0f88705863b8b9d2adf47af8694780927d5273ea2b77c7e29a83709c1dff793c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91009"
      ]
    },
    {
      "uid": "zhcn:47fbc4e89188d7829e1ed6eb",
      "kind": "character_system_text",
      "source_text": "唔哇啊啊啊啊啊啊。\n……嗯~好想午睡。\n去训练员室睡好了~……",
      "source_fingerprint": "a02b984fa1e45f00345b464df0d25ac0b3fcc4f5587487389c73277d5da1fdd4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91010"
      ]
    },
    {
      "uid": "zhcn:3e6b52d67012b70e7c067727",
      "kind": "character_system_text",
      "source_text": "哼、哼、哼！\n能赢过本天才少女潘多拉酱吗~？",
      "source_fingerprint": "4f257f4b4c46cb5edb06a54c5d319e5b04e624e202bd57878d5ebd357ffc216b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "910100"
      ]
    },
    {
      "uid": "zhcn:311e7ecde7906d2b8abb78ba",
      "kind": "character_system_text",
      "source_text": "呐~~！说好的一起看剧呢~~？\n还不行吗？都到这个时间了~！",
      "source_fingerprint": "182d9f51f3aa8b5ab86d0092f2f543611c446fb1aca4583889350d1925c9851e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91011"
      ]
    },
    {
      "uid": "zhcn:310aa61538174be619203837",
      "kind": "character_system_text",
      "source_text": "哼哼哼~♪ \n下次要穿什么样的衣服呢~♪\n春天到了……露点皮肤之类的？♡",
      "source_fingerprint": "cc3497a1bdbe41ca190c694a29e54944bf2f697da71e73aef0c2fd128ec39b75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91012"
      ]
    },
    {
      "uid": "zhcn:0f4c48586517b5db672f8443",
      "kind": "character_system_text",
      "source_text": "呐呐！今年一定要去爸爸的度假村\n训练好吗！我会每天都穿\n不一样的可爱夏装给你看的……！",
      "source_fingerprint": "94b5de79ed5e825bec477b5fed957099c02802c9d158e4b495836062016a57d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91013"
      ]
    },
    {
      "uid": "zhcn:4d7ee251007449b7a0c36064",
      "kind": "character_system_text",
      "source_text": "呜~温差太大了~~~~\n真的要感冒了。\n只要吃了东西就能马上好~",
      "source_fingerprint": "127fc55d9433b51ca474d0d2f26ca73240ba0c59aa56ef6b349415cf14141aab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91014"
      ]
    },
    {
      "uid": "zhcn:47e5278ce67423e1a36e718e",
      "kind": "character_system_text",
      "source_text": "超天才的我可不能输给那些\n打算用上暖宝宝的人……\n……不，我应该能！？",
      "source_fingerprint": "9ec4d354d3b41d0bde8c696e611d20d170c301ffb2e14cb9aef618fb58077854",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91015"
      ]
    },
    {
      "uid": "zhcn:7d282b81824cd8357fb4f775",
      "kind": "character_system_text",
      "source_text": "买了一大堆点心~♡\n……不是，才不是我贪吃啦！\n这是为了让小目开心~！",
      "source_fingerprint": "9df710a37925ab3b490e39d2d8bce958669eac437e69c0215b359523b5c87cdf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91016"
      ]
    },
    {
      "uid": "zhcn:5ae6591cd976a61d33e75f99",
      "kind": "character_system_text",
      "source_text": "镜子啊镜子~第二可爱的人是谁？\n这么说了之后被吐槽了~\n毕竟第一可爱的都不用问吧？",
      "source_fingerprint": "d93feec29e27de2c893e6a9f354c218746b25767a0aed6fed8bc05e23fb164ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91017"
      ]
    },
    {
      "uid": "zhcn:340adb13c5c556f1592dcde2",
      "kind": "character_system_text",
      "source_text": "和统治前辈玩桌游超~开心的！\n不过之前被我完虐后\n她就把自己关进房间了呢~",
      "source_fingerprint": "2de4b104786301c1d1b1cb5906df44d0419dc325422b6072398f89218a9bfa6b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91018"
      ]
    },
    {
      "uid": "zhcn:442fee5c54aacb87f223538a",
      "kind": "character_system_text",
      "source_text": "和川上前辈去看了公主战士的演出\n超开心的♪\n之后又在宿舍大厅聊了3个小时！！",
      "source_fingerprint": "0e70f5ea46bc5fd8182d33d57644f5c19f4311775ae1608c2656367f13523904",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91019"
      ]
    },
    {
      "uid": "zhcn:e986674571c5c69282eeb65e",
      "kind": "character_system_text",
      "source_text": "房间变脏也能瞬间干净的魔法☆\n……之类的，不知道小东商\n会不会愿意教我呢~",
      "source_fingerprint": "d7ee9203b7c71592da320a9096100d9a26cc37bb6758d5b7d46cd79dbd3a755b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91020"
      ]
    },
    {
      "uid": "zhcn:c186b10fe9366e4cc94c8e56",
      "kind": "character_system_text",
      "source_text": "小心心，讲真…早上也太早了…\n好困，不行，撑不住了…！呐~枕头。\n你坐那边…坐下嘛~！就现在~！",
      "source_fingerprint": "34d1782ba10512a5fa0fca9391cfeeaa389713951f80b200fb0b4c45719aa3e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91021"
      ]
    },
    {
      "uid": "zhcn:f823c4fa3fc72ff266e95630",
      "kind": "character_system_text",
      "source_text": "穿这身吃午餐的话，果然得是\n夏威夷盖饭！欸——想去夏威夷~\n带我去吧♡坐头等舱去♡",
      "source_fingerprint": "21206caf7dfebd86bc82bdb3664823923c32f3789ecd7b0e02bf242df751fec8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91022"
      ]
    },
    {
      "uid": "zhcn:a788c7fd2f00eced90fb4d8a",
      "kind": "character_system_text",
      "source_text": "小茵前辈的paka玩偶，\n抱着能睡得很香呢！\n有种暖暖的感觉~！呵呵♡",
      "source_fingerprint": "a5ec218e0240d53523192720ac5401737dd13123f472156e8e32de431e908197",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91023"
      ]
    },
    {
      "uid": "zhcn:7a63aa1ecc690c1a3917bd67",
      "kind": "character_system_text",
      "source_text": "欸——新生们都超~可爱！\n我也要展现一下前辈风范~♪\n首先是~……嗯~……晒太阳！",
      "source_fingerprint": "a7066407e9fef81dc48310bd25fdab5e635e7f9abd1e9aa512cdf539f590bf47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91024"
      ]
    },
    {
      "uid": "zhcn:16fc38fa0e5a3e32ab38fd8b",
      "kind": "character_system_text",
      "source_text": "唔哇~好热~……想喝蜜瓜苏打~！\n里面放有樱桃、蜜瓜、芒果……\n再撒上金粉的那种！",
      "source_fingerprint": "e24ce608bf8b82f6131389178fbdac862558e8a7ada03f4f4bb4902952726d3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91025"
      ]
    },
    {
      "uid": "zhcn:af46e5cfc6bcbf726066da39",
      "kind": "character_system_text",
      "source_text": "我本来很怕不良漫画~但从宝穴前辈\n那里借来读过之后……简直迷上这种\n愛羅武勇（I love you）的感觉了！",
      "source_fingerprint": "a0d66533faf3406cca325279466acfd2d53b8db561bc54fb0b4e79c74f838563",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91026"
      ]
    },
    {
      "uid": "zhcn:54fc6ed74f30379ccbeb405d",
      "kind": "character_system_text",
      "source_text": "我正在努力收集狗狗玩偶！\n真希望爱慕律动前辈\n也能来参加暗锅女王杯呢！",
      "source_fingerprint": "cecbae20acc656c6580de705375f8f599c16b7567655d483d7b4461ac6d2c6a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91027"
      ]
    },
    {
      "uid": "zhcn:88d38bde9f0a987395fa97eb",
      "kind": "character_system_text",
      "source_text": "做了以小目为印象的挑染~！\n这下我们就一样了~\n简直是最强闪亮亮组合~！",
      "source_fingerprint": "8ad84554e8d31fb5f076811de5ac674b6a32c5465ddf6ddac035815adad7b8fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91028"
      ]
    },
    {
      "uid": "zhcn:121bca1953898944e29510e5",
      "kind": "character_system_text",
      "source_text": "这套泳装超可爱的吧！？\n还有穿着它的我也是……♡\n……呐——就没什么想说的吗~？",
      "source_fingerprint": "41db7c66aef64781862a0ac5dabdb71f4b0d0dc960e53ef841e781025c3804dc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "91029"
      ]
    },
    {
      "uid": "zhcn:d6a123f8db3c4a5d1a170705",
      "kind": "character_system_text",
      "source_text": "喂我说啊！别让天才等啊~！\n真是的~……不过我的胸怀\n也像天才一样宽广，就原谅你了♡",
      "source_fingerprint": "9568f4e5955572284ff6b708cfe6a1f865246f12df6f9f342fe91ced005fc34f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92000"
      ]
    },
    {
      "uid": "zhcn:e162dcef82d492d28d384342",
      "kind": "character_system_text",
      "source_text": "一直待在学园也太无聊了……\n要不今天出门吧？好不好？好主意♡\n顺便再去喝一下新品拿铁好啦♪",
      "source_fingerprint": "19829e96dc5b46ba0d7480afb413b2b8f92d9c7c6647c50134f5f084b10db3a7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92001"
      ]
    },
    {
      "uid": "zhcn:956dd2bb7e03c8b6d05d2d05",
      "kind": "character_system_text",
      "source_text": "嘛—嘛—\n只要努努力就能赢的啦~！\n毕竟是我嘛♡♡",
      "source_fingerprint": "de0fc0739ee5bc7840d4b9d8329ca8f9f1c84f8e79024af0afac425ab0367bd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92002"
      ]
    },
    {
      "uid": "zhcn:cb8fde7cbd5360249e455040",
      "kind": "character_system_text",
      "source_text": "啊~真是的，到底要怎么办呢~~~\n维持现状？开创新风格？\n每次做发型都好烦恼啊……",
      "source_fingerprint": "21a05d03cbb27b43e20406137373061bc1e81ae27f61511e3b04fab398ea91ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92003"
      ]
    },
    {
      "uid": "zhcn:9e04da2d656ee793fe941f41",
      "kind": "character_system_text",
      "source_text": "呐~今天的训练会很严格吗？\n会很累吗？可以稍微轻松一点吗？\n泪眼汪汪……♡",
      "source_fingerprint": "f5b64fea962515aef180b44b167cde08fae02acd097f91f7efa6aa24f90647c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92005"
      ]
    },
    {
      "uid": "zhcn:97d8204778e7298ae186ca20",
      "kind": "character_system_text",
      "source_text": "好嘞！今天要好好加油！\n……嘻嘻♡ 就算是我\n也会有能鼓起干劲的日子啦！",
      "source_fingerprint": "9b0408cd658166bd7b606c01373e674376d28813e4e6ec68836ddf7557248a39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92006"
      ]
    },
    {
      "uid": "zhcn:b42c2c215b40eabb70ec7564",
      "kind": "character_system_text",
      "source_text": "辛苦也没关系哦~\n这是你制定的日程不是吗？\n所以，我会好好认真加油的。",
      "source_fingerprint": "0d1eba8e51fa1b538a3d482b15ae8843072a0e5871d2088feefc7de015338396",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92007"
      ]
    },
    {
      "uid": "zhcn:13341414565f871ef4fd8827",
      "kind": "character_system_text",
      "source_text": "好热~……训练员，我要遮阳伞~\n还有卫衣和防晒霜~\n再加一份街边摊的胡萝卜冰沙。",
      "source_fingerprint": "71a3d6eebd0ec16fb49eca4059bdd8f15af42200209c5d8fefde4b9e18a3bc1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92011"
      ]
    },
    {
      "uid": "zhcn:11b5592187c2efb691af2573",
      "kind": "character_system_text",
      "source_text": "怎么样？差不多该办场时尚秀了吧？\n超有魅力潘多拉专属的那种♡\n……诶！！不办吗！？",
      "source_fingerprint": "4eb8ddb8b1ca251b8829baf58d5c568cf6adf6a6f482202c596b4a377ebdcfca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92015"
      ]
    },
    {
      "uid": "zhcn:e516b2e03764eb43245fc6cc",
      "kind": "character_system_text",
      "source_text": "今天我来决定训练内容！\n那个~……嗯~……\n……总之先去海边？",
      "source_fingerprint": "ae40de4b83807a6e192431fb08e2cc99d46b98bd686ece2895a6c1159d51c314",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92016"
      ]
    },
    {
      "uid": "zhcn:5e7ff581b87ad28ceb082a27",
      "kind": "character_system_text",
      "source_text": "哒啊啊啊啊！……呼。宝穴前辈\n说过，大声喊出来就会很有干劲！\n好，心满意足该回去啦♪",
      "source_fingerprint": "ffe015d4ec255faa90184dad9d28edb937b6b4681c88c6d6b5c05542aed4841f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92017"
      ]
    },
    {
      "uid": "zhcn:59c1015188121c5571ee84f7",
      "kind": "character_system_text",
      "source_text": "有好好给努力的潘多拉\n准备奖励吗？冰淇淋~果汁~\n……还有一星期的假期♡",
      "source_fingerprint": "7a2816f14de16e3915add0029746a81c1d988b309d8f99709a6da5ba787af5d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92018"
      ]
    },
    {
      "uid": "zhcn:dd5a30824cf3f23caf83d0a8",
      "kind": "character_system_text",
      "source_text": "只是按你说的试了一下，\n用时就变少了……\n呐！难道说……你也是天才？",
      "source_fingerprint": "085abff40d44a3ae7b5939940bab1f081d4d40342085663ef60e7436342c28a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92020"
      ]
    },
    {
      "uid": "zhcn:7ec2be75dadad86e3a15b007",
      "kind": "character_system_text",
      "source_text": "嘛，如果是你和我的话，\n总会有办法的♪\n毕竟，我们可是天才啊！",
      "source_fingerprint": "455e89c0844867dc9084a468e34365b4dcf117c742dd19aaec84e7e8f1121813",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92021"
      ]
    },
    {
      "uid": "zhcn:56e866720af0347bfc4f1f49",
      "kind": "character_system_text",
      "source_text": "最信赖你的人绝~对是我！！\n……怎么~？\n害羞了吗？害羞了吗~~？？",
      "source_fingerprint": "cfffb539f58767f1a452a667cc2ba8596c57e5bb1c44416cc6368fb70c26ba88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "92022"
      ]
    },
    {
      "uid": "zhcn:b0edcc3dff64c3075e53a70f",
      "kind": "character_system_text",
      "source_text": "嘿嘿！我也好，你也好，都是天才☆",
      "source_fingerprint": "da9a0ac10da107404c7d8ff297536a98c808f49322e6ed85ae8454cb0695407c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "93000"
      ]
    },
    {
      "uid": "zhcn:6d00d824ca09258c7c5c895f",
      "kind": "character_system_text",
      "source_text": "快看！很天才吧？♡",
      "source_fingerprint": "acdad64a6ef5d1c180b4b23dd9b89aa39d46774c03d5601ed37702b95dc22da5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "93001"
      ]
    },
    {
      "uid": "zhcn:b5d5ad305ecaa1d90cfb49da",
      "kind": "character_system_text",
      "source_text": "这么闪闪发光的回忆，不会忘记的！",
      "source_fingerprint": "f6bac149ab2be5afa4a79f0291e49be839c0b0996d515ea641ab3a08b801a95d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "93004"
      ]
    },
    {
      "uid": "zhcn:fe1a7c89bf8febdb849020e0",
      "kind": "character_system_text",
      "source_text": "我可是超努力的~一起去度假吧！",
      "source_fingerprint": "78865704e90e2581da95d2921a2de2b8978b1f92a265484078575da64fe7c830",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "93005"
      ]
    },
    {
      "uid": "zhcn:17a81515e65ea1bbe57b3543",
      "kind": "character_system_text",
      "source_text": "让订阅人数猛增起来吧♪ 然后，\n拿到很多奖励，还会被狠狠夸奖哦♡",
      "source_fingerprint": "09a6e4d15b5419dd5baba5af1a8a98b34abb994dce1f5c883dbb52f2bce15f55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "940000"
      ]
    },
    {
      "uid": "zhcn:6ec00370362325fb13ebfa4a",
      "kind": "character_system_text",
      "source_text": "等看完全部视频，就去要奖励好了♡\n找爸爸撒娇庆功宴要在高级餐厅\n举办！",
      "source_fingerprint": "eb32556b0c9b60bb3c2761537a42df7f30329c0603443f12824b5c5f085af04e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "940001"
      ]
    },
    {
      "uid": "zhcn:df921bfc3177abf172bb0c68",
      "kind": "character_system_text",
      "source_text": "欸嘿嘿！夸夸我也可以的哦~♡",
      "source_fingerprint": "bb7499d069b1fe26a23a6b1fd6963f7b1c9365110d0e738289b22f41ac3db3d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95000"
      ]
    },
    {
      "uid": "zhcn:83bf09ce6cc97b8064965067",
      "kind": "character_system_text",
      "source_text": "我果然是天才……♡",
      "source_fingerprint": "0fbe96e6647a87a95072693f4cce19bd55cb05029240c7c79222905e30333cd0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95001"
      ]
    },
    {
      "uid": "zhcn:d9982f8f9fafd792f7bc6311",
      "kind": "character_system_text",
      "source_text": "来~啦！超绝天才少女♡\n房一潘多拉登场♪",
      "source_fingerprint": "bbffc1b8314381e41a0df8f6788a27ba65470951a34c50250b7d80409524bd47",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95003"
      ]
    },
    {
      "uid": "zhcn:bbe9823afb6f3c71145802f1",
      "kind": "character_system_text",
      "source_text": "嘛—嘛—，我可是天才♡\n传说，就让我来创造吧，我说真的☆",
      "source_fingerprint": "f12b3c331c9af11205c6ffd2753e06a91f6a6afd05dc6b9c075055f3a56abe6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95004"
      ]
    },
    {
      "uid": "zhcn:45b3a5bc6b28c35203365008",
      "kind": "character_system_text",
      "source_text": "噢，不愧是我~♪",
      "source_fingerprint": "f259114cd99c6d69e303957054cde6a748ec092631da71086f01bdb4de2c6f85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95005"
      ]
    },
    {
      "uid": "zhcn:4271af8c292c998ef68e6a78",
      "kind": "character_system_text",
      "source_text": "我果然很有才能嘛♪",
      "source_fingerprint": "c2ad50625b671fa673ce7bf8b120620e8ea62737451c9b1827fea635df67930d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95006"
      ]
    },
    {
      "uid": "zhcn:560861cd907cb53bc30e9da3",
      "kind": "character_system_text",
      "source_text": "超~开阔的感觉♡",
      "source_fingerprint": "144e27ebcd5bdb20254d2a770d743bc838cf00470536a36f3b8e5756e12131f0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95007"
      ]
    },
    {
      "uid": "zhcn:b653d2259b9965e95811a863",
      "kind": "character_system_text",
      "source_text": "极限这种东西~我都不知道哦！♡",
      "source_fingerprint": "490e18247b6e69236f7d6734ea50eafeeaa7f205c66662085dc7d741a80a0b78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95008"
      ]
    },
    {
      "uid": "zhcn:35f3819d7bee47ab8e2f4e5d",
      "kind": "character_system_text",
      "source_text": "勇往直前天才少女，降临♪\n太耀眼了真是抱歉♡",
      "source_fingerprint": "905edfb3ae483199aa2f6c9072e7b5cd7131535baf303b48c89f2ef0e622ada6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95009"
      ]
    },
    {
      "uid": "zhcn:aff35e3e708b7b3c33c31f83",
      "kind": "character_system_text",
      "source_text": "我是房一潘多拉~♡\n是要去度假吗？",
      "source_fingerprint": "fa1689d1a7c1c83d9c323d7144aae9d4e1b2f0f9bdafa71b9059a7cedbf350b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1113",
        "95010"
      ]
    },
    {
      "uid": "zhcn:c69f271d92d5f873c3250714",
      "kind": "character_system_text",
      "source_text": "一起加油吧！",
      "source_fingerprint": "27034d160af1c1f09dc5bc82dd514313c27a89258641f741350dfcc49d329de0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "1000"
      ]
    },
    {
      "uid": "zhcn:911365fe3c91eabd3d7b8c8a",
      "kind": "character_system_text",
      "source_text": "当时听到你说临时签约虽然吃惊\n……但反倒安心了一些。\n这表示，你有在认真对待梦想呢。",
      "source_fingerprint": "067455c1106c7d6d93148a0ec6f538962ab99835d1eeef38364cdc26ef72a89f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10000"
      ]
    },
    {
      "uid": "zhcn:df3ddb04a6aaa492cb9f8207",
      "kind": "character_system_text",
      "source_text": "我出发了。",
      "source_fingerprint": "874e7497e7be8367a4f334f4c7f1d69916bd93469660e8935829876ff0311191",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "100000"
      ]
    },
    {
      "uid": "zhcn:4bf63e4df3be11e4696ce76c",
      "kind": "character_system_text",
      "source_text": "我回来了。",
      "source_fingerprint": "4f3f071de3a132d55ed31edf557b362afda8ef29b618fd0f52a13920ed7d26bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "100001"
      ]
    },
    {
      "uid": "zhcn:e5e21595815d4a91e87bd541",
      "kind": "character_system_text",
      "source_text": "叫你训练员的时候，\n心里还是会有些扑通扑通跳呢。\n不过我想，过阵子就习惯了吧。",
      "source_fingerprint": "ca0cb8ab9b34fc87a7c59a7b8c2a758cd18825fff52ab041c987b9dcac45dc68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10001"
      ]
    },
    {
      "uid": "zhcn:b3f625558bd50dd9c6c69da5",
      "kind": "character_system_text",
      "source_text": "下次再一起看烟花时，\n眼前的景色也会变得不同吧。\n……一定会映照出更璀璨的光芒。",
      "source_fingerprint": "bb6ab443e638c576f8bbdb4eddb9ae043d8b882e87076dcd54598f2a2677688f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10002"
      ]
    },
    {
      "uid": "zhcn:45a1fd3633857eefa6ed247b",
      "kind": "character_system_text",
      "source_text": "妈妈送来的年糕，\n我会做成杂煮带过去的！\n已经能再现出家里的味道了哦♪",
      "source_fingerprint": "5414347b502e8b4d50607f3e61101038dcc5703731c69c6e18a1169d246da209",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10003"
      ]
    },
    {
      "uid": "zhcn:21f36d956ebb1e4f553920e0",
      "kind": "character_system_text",
      "source_text": "情人节快乐♪ 我家……\n还有你家送来的东西都在我这里，\n等下就交给你哦！",
      "source_fingerprint": "68b7bedeea8dcd0341fdd104e389ca31cf704c8e0b75338b6aaf380e2ead0681",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10004"
      ]
    },
    {
      "uid": "zhcn:67d207b03135d9aeb82d7343",
      "kind": "character_system_text",
      "source_text": "巧克力先留个悬念……♪\n做得比去年更符合哥哥的口味了，\n敬请期待哦！",
      "source_fingerprint": "001844c778750de61ceaadc930a07efcac350e194a40204758c0e4bc7adc4432",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10005"
      ]
    },
    {
      "uid": "zhcn:df730129cb21792caf9edbde",
      "kind": "character_system_text",
      "source_text": "织女牛郎……\n希望他们今年也能重逢\n天各一方实在太让人寂寞了。",
      "source_fingerprint": "463a1775ae25e1b71867580d67838ce828e2d4d7d5141fca74eb82c67492c3ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10006"
      ]
    },
    {
      "uid": "zhcn:699960f443906b61b379b564",
      "kind": "character_system_text",
      "source_text": "万圣节装饰，有些恐怖呢。\n……啊，不过我不会再哭鼻子了哦！\n……真・的！",
      "source_fingerprint": "1deeee960ac69cb22630940e3a3d1b4616e48cc71fe62200be0e9fea29e6f165",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10007"
      ]
    },
    {
      "uid": "zhcn:166cd76beecde1b352b63828",
      "kind": "character_system_text",
      "source_text": "多亏闪耀同学帮忙，终于会做\n史多伦蛋糕了。搞不好还能再现\n住在德国的奶奶那份味道♪",
      "source_fingerprint": "410560724da0e71076f6b0bbe0bee8db706810feb7a7ae5c464f05a175c7a1a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10008"
      ]
    },
    {
      "uid": "zhcn:2cc8c40a4da65ec0430bf473",
      "kind": "character_system_text",
      "source_text": "虽然够不上圣诞大餐……\n但我会亲手做出心意和味道\n都不输大餐的料理哦！",
      "source_fingerprint": "07f048e08b69349b6273a01c86128902d1ac802b82ef16d48bf5c4d71645e721",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10009"
      ]
    },
    {
      "uid": "zhcn:85a842e1d0452ca4429e858a",
      "kind": "character_system_text",
      "source_text": "各位，我们做到了呢！",
      "source_fingerprint": "bf84e52237d543f1482f3064a49adeaf773b406d4c1d836c7a093bf7a3c982ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "1001"
      ]
    },
    {
      "uid": "zhcn:6689671f73ee6f7705600653",
      "kind": "character_system_text",
      "source_text": "除夕会在家里过年啊。那样的话，\n我大概傍晚送年菜过去可以吗？",
      "source_fingerprint": "34edc7c777d520860a589ed8aceb84d29595e088a02917bff160310e22e8e7b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10010"
      ]
    },
    {
      "uid": "zhcn:bc924badce35ca1e0d8435f4",
      "kind": "character_system_text",
      "source_text": "生日蛋糕啊礼物啊……还有很多哦！\n要把分开时错过的都补回来\n好好庆祝一番。",
      "source_fingerprint": "41abc624a5b30412852b56a00815ea8032463b9d3210a210f0c62810f72ef917",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10011"
      ]
    },
    {
      "uid": "zhcn:0337116cf4d72263bc6efd75",
      "kind": "character_system_text",
      "source_text": "又长大一岁了呢。看来是要变成\n越来越可靠的哥哥了吧……呵呵。",
      "source_fingerprint": "b753629bba9cef01ee12bec4353887e8930e03c7f4dee5f914168027865ad4ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10012"
      ]
    }
  ]
}
