{
  "schema_version": 1,
  "batch": 1502,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:f4cb8a960ec975655167ec5c",
      "kind": "character_system_text",
      "source_text": "要复习呢。",
      "source_fingerprint": "cb5c2a444647d039ebd1890f8b3c47987a845c55d24def4889f1d667125b3f15",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20043"
      ]
    },
    {
      "uid": "zhcn:3fcfb67d19ecb58cbdf6b0fe",
      "kind": "character_system_text",
      "source_text": "出发！",
      "source_fingerprint": "663f67e6d36e16231932887bb1e3eb2db26e1fb205d758f58e5da16072deb3e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20046"
      ]
    },
    {
      "uid": "zhcn:66ffa0e51209fc082ffb9ebc",
      "kind": "character_system_text",
      "source_text": "哇，好凉呢♪",
      "source_fingerprint": "b117f32231cb01473521d12453fc21f42b89f41529e4a03312484bbc7de2c026",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20047"
      ]
    },
    {
      "uid": "zhcn:a84433c986594f33e792299e",
      "kind": "character_system_text",
      "source_text": "感谢您的献身。",
      "source_fingerprint": "836622c2efe593037be1b1e8a1fb4326e16cdbf71f6048d3d898ac59f7496648",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20049"
      ]
    },
    {
      "uid": "zhcn:48ee4736694041e691802709",
      "kind": "character_system_text",
      "source_text": "将这份经验，也化作精神食粮吧。",
      "source_fingerprint": "c830075becd75ccbdf52718b2b91aa89781c814488947d338e778d8378b38741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20050"
      ]
    },
    {
      "uid": "zhcn:4e06f4edaea547ed34e7bf9c",
      "kind": "character_system_text",
      "source_text": "共同钻研……！",
      "source_fingerprint": "4dc3cc4d8e94b4b2aa0af10e6ca5c7f8c07b2091bb30e578136a5aab9346968d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20051"
      ]
    },
    {
      "uid": "zhcn:d02d0b27b6f99526b94a23bc",
      "kind": "character_system_text",
      "source_text": "让我们彼此，跑出一场精彩的比赛吧。",
      "source_fingerprint": "c9ffed4c89a0badfdfdf5bd7d66dbfe0aa8f2e1f5865b9c107931338f86e9948",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2030"
      ]
    },
    {
      "uid": "zhcn:2d7bb9ebe89db543c2d56dcf",
      "kind": "character_system_text",
      "source_text": "——那么，走吧。",
      "source_fingerprint": "b7e4a84f1ef26b5ae1716f4e13e6f249140c0ae3439ecc210682e9f04edd0959",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2031"
      ]
    },
    {
      "uid": "zhcn:81a4d2c4d2acf68be8f1e150",
      "kind": "character_system_text",
      "source_text": "将这份经验，也化作精神食粮吧。",
      "source_fingerprint": "c830075becd75ccbdf52718b2b91aa89781c814488947d338e778d8378b38741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2032"
      ]
    },
    {
      "uid": "zhcn:c19cb8e0f4353c62b7cf4b35",
      "kind": "character_system_text",
      "source_text": "吸、吸、呼～。……我在调整，\n以免情绪过于高涨。\n吸、吸、呼～……。",
      "source_fingerprint": "11fef1215111f4832559a32fabf4ebe309578784eaa32d9ffc41fef2a54764ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2033"
      ]
    },
    {
      "uid": "zhcn:fe4feff5ec4aab9a22e6879c",
      "kind": "character_system_text",
      "source_text": "历史，未来，皆由比赛诉说。\n而我——唯有怀抱志向，奔跑不息。",
      "source_fingerprint": "9016bfded67c55876c130cf9a391624194a2bcb664fe475c32db2e84fb1bf2b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2034"
      ]
    },
    {
      "uid": "zhcn:a843292ae0b6d5d3ffa86504",
      "kind": "character_system_text",
      "source_text": "将这份经验，也化作精神食粮吧。",
      "source_fingerprint": "c830075becd75ccbdf52718b2b91aa89781c814488947d338e778d8378b38741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2035"
      ]
    },
    {
      "uid": "zhcn:01dedb3a1e45c79258bd9e61",
      "kind": "character_system_text",
      "source_text": "开始！",
      "source_fingerprint": "3a1bc8931ce94cb5b2de86270e03f2d4b9a446effa7ceaa56679c173e0781ab6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b01074f3e10b78fe9da83317",
      "kind": "character_system_text",
      "source_text": "还差一步，却拱手相让了……！",
      "source_fingerprint": "9094cb2c78184d23c3f575eae342711da3c2f1b32794b53e282e4c677a22b363",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30000"
      ]
    },
    {
      "uid": "zhcn:918e65984a35e331a5fb84a1",
      "kind": "character_system_text",
      "source_text": "哪怕是一点点，也要脚踏实地。",
      "source_fingerprint": "46ce1d3eb80f8799812f7f173851a4bd6d24f534e8cb51898c875859b85ac921",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30001"
      ]
    },
    {
      "uid": "zhcn:f109e045e4fdea0fb7ae0178",
      "kind": "character_system_text",
      "source_text": "不能停下脚步。",
      "source_fingerprint": "bb6a6f742544798a2dfff0b8302fa242d1e285604adffc9586fd866ea41e4675",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30002"
      ]
    },
    {
      "uid": "zhcn:67b84a8de742d39d507f991e",
      "kind": "character_system_text",
      "source_text": "原来只是梦话吗……？",
      "source_fingerprint": "59c3a84af7733c0a2f4092f87106c096e85980606c8fc644e6e2e850b457de6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30003"
      ]
    },
    {
      "uid": "zhcn:49cf7e33cab34a9e0b15d1d8",
      "kind": "character_system_text",
      "source_text": "积累起来吧……\n直到那一天所讲述的梦想——开始为止♪",
      "source_fingerprint": "532332a548189ab836f594625f7296084bd9bde1d79905a72955afdff8440595",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30004"
      ]
    },
    {
      "uid": "zhcn:52cf6adcd2db61b0a9b24dd6",
      "kind": "character_system_text",
      "source_text": "积累起来吧，向着梦想！",
      "source_fingerprint": "dc1fd6652f3df94f03fcf7f81405844fe615f157decccd5c007118c5a85e208b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30005"
      ]
    },
    {
      "uid": "zhcn:71d9df2fe085a420998e343e",
      "kind": "character_system_text",
      "source_text": "向着大河的彼岸。向着充满幸福的未来！",
      "source_fingerprint": "eb28553c31eb419f9cff1bb403f30bd71d30bb0df9713675130680a341057e32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30006"
      ]
    },
    {
      "uid": "zhcn:dffa2c680f5b4bba59a096bb",
      "kind": "character_system_text",
      "source_text": "积累起来吧，向着梦想！",
      "source_fingerprint": "dc1fd6652f3df94f03fcf7f81405844fe615f157decccd5c007118c5a85e208b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "30007"
      ]
    },
    {
      "uid": "zhcn:81b721bd60890dc30f69ad53",
      "kind": "character_system_text",
      "source_text": "——绝不退让。",
      "source_fingerprint": "4bbc1d0f203814470820a7f903c6f7782ca73c6bee984db3a0414a9cd13fe8bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "31000"
      ]
    },
    {
      "uid": "zhcn:a1237027ed16445689d55a1b",
      "kind": "character_system_text",
      "source_text": "用这一步，编织未来！",
      "source_fingerprint": "cfc2bcb4efbc73560022e6cd3a192dc4ab451a41a9c24dd5ae40858b615de1fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "40000"
      ]
    },
    {
      "uid": "zhcn:fb07eaf8c62b4c21c72c7f7d",
      "kind": "character_system_text",
      "source_text": "能与高峰小姐并肩，\n以“缪斯”的身份站上舞台……\n必须打起精神，全力以赴才行。",
      "source_fingerprint": "c1f9eb09a37978961a1e98cba7d1845c100537f59243ce67901de9946b9280f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "400001"
      ]
    },
    {
      "uid": "zhcn:ffece5d90cc4832c06991a60",
      "kind": "character_system_text",
      "source_text": "精神对肉体产生的影响……\n作为训练理论很有研究价值呢。\n首先必须亲身体验才行。",
      "source_fingerprint": "622ab34d85f11ab638fcb73670b53d86ab4d4edfe889ec41d516cadcafaa4ae8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "400006"
      ]
    },
    {
      "uid": "zhcn:78d4562ec611cddee07800b0",
      "kind": "character_system_text",
      "source_text": "总有一天，也想传达给\n孩子们呢。不光是技术\n——还有这份『爱』的珍贵。",
      "source_fingerprint": "d8d9289918ed25b0dcf0e34d35d6151e147956a67fe091794019e46d66181158",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "400009"
      ]
    },
    {
      "uid": "zhcn:d13154ab5b498f8da89f4edb",
      "kind": "character_system_text",
      "source_text": "奉献吧。此身，此脚，此荣光。\n一切为了所爱的——未来的光芒。",
      "source_fingerprint": "1ae778b8d55201fed98bb3e760e6a5ed0ad29de896d402ce91d59fda4774fd14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "40001"
      ]
    },
    {
      "uid": "zhcn:aedc8ef03a04f108e396ac11",
      "kind": "character_system_text",
      "source_text": "这条路，与您一起。",
      "source_fingerprint": "37cc30ed7fc16e8dc9d0f593b26a54b6f3628bd8df464dde71ff416d10d40362",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "40003"
      ]
    },
    {
      "uid": "zhcn:f6c71938ece5f9cb7f99d566",
      "kind": "character_system_text",
      "source_text": "就像小水滴相互融合，终将汇聚成大河一样。\n我想与您……共同编织。",
      "source_fingerprint": "c1cd58ec7daf17a4681cd3e11913da74cbd0a1c8beeafbe0e29d53c9e6ec5365",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "40004"
      ]
    },
    {
      "uid": "zhcn:5da13e957ab79cf23aa66a46",
      "kind": "character_system_text",
      "source_text": "大家的声音，传达过来了哦……！",
      "source_fingerprint": "87302cfc6fb330d3a2b6085c34cb818b8c3399e955036c37faad6dc8056ee422",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "60000"
      ]
    },
    {
      "uid": "zhcn:ca02ca29630e4c6e168dc7c5",
      "kind": "character_system_text",
      "source_text": "那么，我出发了。",
      "source_fingerprint": "261f70482d0af7dab527339c80dabfc34a0068ab5c0e15752ad49399b7369b52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "60001"
      ]
    },
    {
      "uid": "zhcn:1cd3032733141d0722988b8a",
      "kind": "character_system_text",
      "source_text": "共同——培育未来吧，好吗？",
      "source_fingerprint": "27e99f00128a1de194fc4da9283544dd33067bf59ebc9f0aa56a91e78a9dd431",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70000"
      ]
    },
    {
      "uid": "zhcn:3fbcc818e095d151f1757dc7",
      "kind": "character_system_text",
      "source_text": "就像牵起训练员的手的那一刻，\n如故事一般……如梦一般的一幕……。\n呵呵！真美好啊……。",
      "source_fingerprint": "578a47eb2abd539375cb10744c3e09f7863b74ad6cfe5e6d83f7be16762eac0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70001"
      ]
    },
    {
      "uid": "zhcn:8806fcbd3a04a3848c38a714",
      "kind": "character_system_text",
      "source_text": "莱茵，\n作业写完了吗？",
      "source_fingerprint": "25424c5a9c6656b56e083663fd8bb65c54c9c475480775f4da03442f2ef160d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70004"
      ]
    },
    {
      "uid": "zhcn:b8baca4a07c7d80a1f6ab0a9",
      "kind": "character_system_text",
      "source_text": "丝带刺绣啊，\n无论看多少次都会令人着迷呢♪",
      "source_fingerprint": "73c4ae7da5a8bbfedab08890c1accb88ad69a96457d4e8e5e95594e29367578c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70008"
      ]
    },
    {
      "uid": "zhcn:edbefccb432c1bdde734eea3",
      "kind": "character_system_text",
      "source_text": "呵呵，真帅气啊♪",
      "source_fingerprint": "d796ea2c1c7876ee9da5c7e00b530ffdd1765f167f3223f239090b1eed4670e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70009"
      ]
    },
    {
      "uid": "zhcn:f82f952394d6234392a4e0cf",
      "kind": "character_system_text",
      "source_text": "没有褶皱，平整挺括。\n这是母亲教我的。",
      "source_fingerprint": "f855c1ee81f420586695edf44957d7e0d5efd608457f50db316aa552bc1102e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70010"
      ]
    },
    {
      "uid": "zhcn:59fcebfb3d3035696f5f4c22",
      "kind": "character_system_text",
      "source_text": "这套服装也是，传承之物。",
      "source_fingerprint": "af810d1582846af4630733e41df4184959dbb42f1a8d1472c3ef4c75ad377a76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70014"
      ]
    },
    {
      "uid": "zhcn:8e6b87817b4b51fce984facd",
      "kind": "character_system_text",
      "source_text": "戴上后冠，然后迈向未来……！",
      "source_fingerprint": "e75b947410462839c0ee3b0142e647390752af51ead10e39d24151f26783d44f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70015"
      ]
    },
    {
      "uid": "zhcn:996fbc0c5ab0da15d433b986",
      "kind": "character_system_text",
      "source_text": "如果是这件礼服，一定能通往光辉的未来……",
      "source_fingerprint": "b9e3d971fe2f9d2868207885b66275b3ee834daf5be4120d7bef52bcdbe3c327",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70016"
      ]
    },
    {
      "uid": "zhcn:d468e5219e6841222532ed09",
      "kind": "character_system_text",
      "source_text": "呵呵……护送任务，就拜托您了哦。",
      "source_fingerprint": "6ec3a2ddd52646bea32b1bf69572d524eaa5a9759558296659a80c6e324a67d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70017"
      ]
    },
    {
      "uid": "zhcn:2c080ef496af73c82ef000c8",
      "kind": "character_system_text",
      "source_text": "这个也很棒呢！",
      "source_fingerprint": "7d1f6a55a277efb2e3e3baffc65797f96946acdd70bd8d76cabc105f3c50d075",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70018"
      ]
    },
    {
      "uid": "zhcn:0241beb9feabbeae4bd58f8d",
      "kind": "character_system_text",
      "source_text": "有没有什么遗漏呢。",
      "source_fingerprint": "a24366beb23672c88ec1287ca2844bd63b4ec41cb72d175678242e43fd580ca3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70019"
      ]
    },
    {
      "uid": "zhcn:e7900113d85bbb47e41aea53",
      "kind": "character_system_text",
      "source_text": "手帕，纸巾，\n针线包是不可或缺的♪",
      "source_fingerprint": "59647a41910ac4dada8c28221689c6001c5b9f8fe611f388888c005f62004562",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70020"
      ]
    },
    {
      "uid": "zhcn:e59729f7a263955a18303c0c",
      "kind": "character_system_text",
      "source_text": "出门的时候，\n随身行李不知不觉就会变多。",
      "source_fingerprint": "59bade7cee4ebb8d4500ce8b18d4d62ee1c105742d82c04b150ae376a442b846",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "70021"
      ]
    },
    {
      "uid": "zhcn:16d3361e3c746804f1d87778",
      "kind": "character_system_text",
      "source_text": "莱茵，\n作业写完了吗？",
      "source_fingerprint": "25424c5a9c6656b56e083663fd8bb65c54c9c475480775f4da03442f2ef160d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71004"
      ]
    },
    {
      "uid": "zhcn:1c6eccb7120fdc9e7617b0a8",
      "kind": "character_system_text",
      "source_text": "蝴蝶结的刺绣，\n无论看多少次都会令人着迷呢♪",
      "source_fingerprint": "2a48ee823b84bd92cc963d67230afcb37f5bbeb4565e83dd67c56e72978cf9a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71008"
      ]
    },
    {
      "uid": "zhcn:9e8359a59bcccf917214d364",
      "kind": "character_system_text",
      "source_text": "呵呵，真帅气啊♪",
      "source_fingerprint": "d796ea2c1c7876ee9da5c7e00b530ffdd1765f167f3223f239090b1eed4670e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71009"
      ]
    },
    {
      "uid": "zhcn:0ecff17161ec28a964982b62",
      "kind": "character_system_text",
      "source_text": "没有褶皱，平整挺括。\n这是母亲教我的。",
      "source_fingerprint": "f855c1ee81f420586695edf44957d7e0d5efd608457f50db316aa552bc1102e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71010"
      ]
    },
    {
      "uid": "zhcn:9fea2cd2f195a17abfdb9329",
      "kind": "character_system_text",
      "source_text": "这套服装也是，传承之物。",
      "source_fingerprint": "af810d1582846af4630733e41df4184959dbb42f1a8d1472c3ef4c75ad377a76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71014"
      ]
    },
    {
      "uid": "zhcn:1fef53704006a9fa35b8d2e8",
      "kind": "character_system_text",
      "source_text": "戴上后冠，然后迈向未来……！",
      "source_fingerprint": "e75b947410462839c0ee3b0142e647390752af51ead10e39d24151f26783d44f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71015"
      ]
    },
    {
      "uid": "zhcn:92aeb8f125777f4f6c65924a",
      "kind": "character_system_text",
      "source_text": "如果是这件礼服，一定能通往光辉的未来……",
      "source_fingerprint": "b9e3d971fe2f9d2868207885b66275b3ee834daf5be4120d7bef52bcdbe3c327",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71016"
      ]
    },
    {
      "uid": "zhcn:6d135b9e1f23b0def3175527",
      "kind": "character_system_text",
      "source_text": "呵呵……护送任务，就拜托您了哦。",
      "source_fingerprint": "6ec3a2ddd52646bea32b1bf69572d524eaa5a9759558296659a80c6e324a67d5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71017"
      ]
    },
    {
      "uid": "zhcn:dcfc35146d95a7b435adebab",
      "kind": "character_system_text",
      "source_text": "这个也很棒呢！",
      "source_fingerprint": "7d1f6a55a277efb2e3e3baffc65797f96946acdd70bd8d76cabc105f3c50d075",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71018"
      ]
    },
    {
      "uid": "zhcn:278bdc30e44f8ae10efd3650",
      "kind": "character_system_text",
      "source_text": "有没有什么遗漏呢。",
      "source_fingerprint": "a24366beb23672c88ec1287ca2844bd63b4ec41cb72d175678242e43fd580ca3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "71019"
      ]
    },
    {
      "uid": "zhcn:288a46befae8d0acae39c436",
      "kind": "character_system_text",
      "source_text": "辛苦了。",
      "source_fingerprint": "2f747fdfd41fdd19d5e6205e2563472ecb3e45190ea9201c283e895272ee13e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "80000"
      ]
    },
    {
      "uid": "zhcn:139ded4f6eb8295e2c0e179e",
      "kind": "character_system_text",
      "source_text": "早上好，训练员。\n……呵呵，看起来还很困呢。\n要我为您冲杯咖啡吗！",
      "source_fingerprint": "6139da3083d1c67020bb01cd2ca5a41cea18c182de0c360f16ae67c35d6bd8fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90000"
      ]
    },
    {
      "uid": "zhcn:a8a712a5335cf5747c52d135",
      "kind": "character_system_text",
      "source_text": "今天早上莱茵的流星有些萎靡，\n看来湿度会很高。\n体温调节会变得困难，请多加留意。",
      "source_fingerprint": "c2b151aa24c5c8f6abceb497d74073492beb0aed49be1606c286a849d25498b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90001"
      ]
    },
    {
      "uid": "zhcn:6d93ab9f6bb85001dd8f6e91",
      "kind": "character_system_text",
      "source_text": "虽然很想就这样开始训练！\n但是还有课……\n真是让人迫不及待啊♪",
      "source_fingerprint": "eb3ccb3cc4e93207c7ee4e5b90f8469b6173c8635d8c8ee29b8a6f6257f364cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90002"
      ]
    },
    {
      "uid": "zhcn:8a0114b4698cdd294152b82a",
      "kind": "character_system_text",
      "source_text": "……看来，您稍微有些累了的样子。\n如果不嫌弃的话，\n我来陪您转换一下心情吧。",
      "source_fingerprint": "d754e63b0daae64ae95e4f5549e097776f8bb791496774474c8b64fccdf34fec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90003"
      ]
    },
    {
      "uid": "zhcn:28d277c39498ea0617f661c9",
      "kind": "character_system_text",
      "source_text": "训练员，肚子饿了吗？\n我在冰箱里放了夜宵……\n啊，但是……禁止暴饮暴食哦？",
      "source_fingerprint": "898f76282ce907ff504e2cbd5d01bded94f4c66b813c0cd8859e0e3d9b2cdb1c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90004"
      ]
    },
    {
      "uid": "zhcn:ea89fb0e6bbc8a12537e1094",
      "kind": "character_system_text",
      "source_text": "……睡不着吗，训练员？\n既然如此，那就共叙夜话吧。\n无论是今天的事，还是未来的事。",
      "source_fingerprint": "9ad87beea0e566c0525aae041e3889d64ce5aafbc63c58a22257f3ef6cc7a489",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90005"
      ]
    },
    {
      "uid": "zhcn:ecf9394d7e65e181db363856",
      "kind": "character_system_text",
      "source_text": "虽说『春眠不觉晓』，\n但春天正是最适合训练的季节。\n今天也要鼓起干劲……哈啊……失、失礼了。",
      "source_fingerprint": "dd526000b0a7200077860bffa7686a7de7695cca32a497c2b0a99fe946092254",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90006"
      ]
    },
    {
      "uid": "zhcn:1f758847bd921fd7d4811687",
      "kind": "character_system_text",
      "source_text": "暑假的公园，真不错呢。\n孩子们做体操、玩耍……\n呵呵，这会成为我坚持跑步的动力。",
      "source_fingerprint": "a58b29340794cc8fae2ddab6e04ca4599b14cba4ec14aa0e9d8de0d5e30462ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90007"
      ]
    },
    {
      "uid": "zhcn:e2f436eb1c0efc89d64b428d",
      "kind": "character_system_text",
      "source_text": "是因为度过了严酷的夏天吗。\n我迫不及待地盼望着比赛……不知不觉，\n好几次都在保养决胜服。",
      "source_fingerprint": "998934c3b05be5bfd3b4286af460070adb01b892bc28369c99f72f4eecaaafcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90008"
      ]
    },
    {
      "uid": "zhcn:5f6d2d801632138744006f61",
      "kind": "character_system_text",
      "source_text": "火锅♪火锅♪……呵呵呵。\n今天和同期的大家一起吃火锅哦！\n这次要做什么装饰锅好呢",
      "source_fingerprint": "a1a2880b2ed66ff9bea0bb9499feea86cf3c191d5f647c169ba96b78ddc25bbb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90009"
      ]
    },
    {
      "uid": "zhcn:7170decfd72bb90d67b8b96d",
      "kind": "character_system_text",
      "source_text": "嗯，包和服装都没问题。\n那么……今天也两个人，\n一起走下去吧。",
      "source_fingerprint": "d01b0f38c06435fafb35a6736b33c0c6bf3ed76ef409f9cef2e8345172a76b46",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90010"
      ]
    },
    {
      "uid": "zhcn:026a926e06cc91a186060bfe",
      "kind": "character_system_text",
      "source_text": "能完成早上的First Look，\n真是太好了。为了光辉的未来，\n今天也一起励精图治吧。",
      "source_fingerprint": "560ce69fd430a83150e1ee148cf6ac47d3ee4b274a2b52504011f38b25d8cdf6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90011"
      ]
    },
    {
      "uid": "zhcn:fdca31b7879182d8fe01ee76",
      "kind": "character_system_text",
      "source_text": "便当，我放在桌子上了。\n营养，还有您喜欢的东西。\n装得满满当当的哦！",
      "source_fingerprint": "b75aae79ab4c90321c66cb53c44c76f1a2294dddae8fb46dcb4e086d2b6989b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90012"
      ]
    },
    {
      "uid": "zhcn:b0a733d614d75af849a62549",
      "kind": "character_system_text",
      "source_text": "放学后，偶尔会去教会。\n庄严的气氛会让心平静下来。\n……穿着这件礼服就更是如此了。",
      "source_fingerprint": "585c80bc45522214c2cabc961f14f6fc40ce2a6906ab7a6873fb737075862179",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90013"
      ]
    },
    {
      "uid": "zhcn:7a0857b42d7cf7fd18f771db",
      "kind": "character_system_text",
      "source_text": "如果您累了，请把手交给我。\n就像追寻月光一样，\n我会护送您的……开玩笑的♪",
      "source_fingerprint": "bfa8b118bf6536268caadd22d50a3a587a8fa6d7588395c619981f1606316fc4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90014"
      ]
    },
    {
      "uid": "zhcn:db7d952a598eab4ff042f697",
      "kind": "character_system_text",
      "source_text": "竟然还有在做自主训练的后辈\n……稍微去看看情况吧。\n说不定我能为她指明道路。",
      "source_fingerprint": "6eb052c8059018959bbd16ec7231215413190b7e09e75c88b8e6f6b9883243e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90015"
      ]
    },
    {
      "uid": "zhcn:c18a329d50651ff1762957c0",
      "kind": "character_system_text",
      "source_text": "新生们的启程，吗。\n……作为构筑未来的人，\n我不由得绷紧了身心。",
      "source_fingerprint": "9cec13fbc87ee663df0d45f5f93fc7343c10fa715550901784a05c2a320f56b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90016"
      ]
    },
    {
      "uid": "zhcn:7f39c1f3513ccdb194f54e9a",
      "kind": "character_system_text",
      "source_text": "要勤于补充水分哦？\n特制运动饮料的话\n马上就能做好，请别客气♪",
      "source_fingerprint": "3374f5c3a26355d675a5ad4a0bb61244afe5fc2acbcedbfe85e4d02ab664faa8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90017"
      ]
    },
    {
      "uid": "zhcn:156dfccf7eb68453145b0e0e",
      "kind": "character_system_text",
      "source_text": "铺满落叶的道路，\n简直就像婚礼甬道一样……\n走在上面感觉有点浪费。",
      "source_fingerprint": "9d1735f09c0512be7308d6eef7f59f8be13152e2417324312eaaad0f58e52068",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90018"
      ]
    },
    {
      "uid": "zhcn:30467aec354275c8a56f0e27",
      "kind": "character_system_text",
      "source_text": "寒风好强啊……。如果不介意的话，\n一起喝杯热咖啡怎么样？\n我想在身体暖和起来之前，和您聊聊天。",
      "source_fingerprint": "37303d0a0a6c6f9290cc55bdc51a4840452083444c1105c27fde9ddfd87c7857",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90019"
      ]
    },
    {
      "uid": "zhcn:b5a7f2d411e4ed27f1dd8014",
      "kind": "character_system_text",
      "source_text": "情人节快乐♪",
      "source_fingerprint": "84545e9d062a703e60cf0240a4c6690b3f86c69931c0b8d072086c92aed0b29d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90020"
      ]
    },
    {
      "uid": "zhcn:7adcbea6443d8e50521edf37",
      "kind": "character_system_text",
      "source_text": "情人节快乐♪",
      "source_fingerprint": "84545e9d062a703e60cf0240a4c6690b3f86c69931c0b8d072086c92aed0b29d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "90021"
      ]
    },
    {
      "uid": "zhcn:1aac7b0b9839759ac10eb3dc",
      "kind": "character_system_text",
      "source_text": "吉兆小姐，果然说英语的时候\n好像比平时更健谈。\n呵呵，下次聊什么好呢。",
      "source_fingerprint": "b17415a1f5d9fc991ce14eedb89d5e73387ea97e325e04c653ce940a8995b4c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "91000"
      ]
    },
    {
      "uid": "zhcn:e8ce27f4e2f497d1dc94793e",
      "kind": "character_system_text",
      "source_text": "和景致小姐的外出，是在车站前集合吗……\n必须早点到达才行。\n……在她为了找我而迷路之前。",
      "source_fingerprint": "5f4b78df1d1e32d06e28d900b749ef563163cb5b2f8c19c37d0d1ab82b0154f3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "91001"
      ]
    }
  ]
}
