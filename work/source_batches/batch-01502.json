      ]
    },
    {
      "uid": "zhcn:37470920560192b28f5a3111",
      "kind": "character_system_text",
      "source_text": "下次还想对决！",
      "source_fingerprint": "1ad87f37de39915525d2b71689443d936605b840bc1a39c32850694c7a109dcd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "1006"
      ]
    },
    {
      "uid": "zhcn:8ce77f0f5496dfcd5e9562db",
      "kind": "character_system_text",
      "source_text": "好厉害，最高分……！",
      "source_fingerprint": "6545460baaa177fa1da4006f8c3d308766cdc2d604c3f3152818920074ae846b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "1007"
      ]
    },
    {
      "uid": "zhcn:75adb5e89dbabd76d9b9896a",
      "kind": "character_system_text",
      "source_text": "我们的话没问题！",
      "source_fingerprint": "34d1070fcfb23394b80811f0eaf5380e29c64925365f0298bc7abd87631c2e79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "1008"
      ]
    },
    {
      "uid": "zhcn:b6ce76d9507aecac1121e179",
      "kind": "character_system_text",
      "source_text": "巧克力先留个悬念……♪\n做得比去年更符合姐姐的口味了，\n敬请期待哦！",
      "source_fingerprint": "439ff0a5de25c7697cda897e42e80cfd1ec997c7b60e57344bfa6c9347d417f7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "10105"
      ]
    },
    {
      "uid": "zhcn:d87d8cd6738b38d8504dff97",
      "kind": "character_system_text",
      "source_text": "又长大一岁了呢。看来是要变成\n越来越可靠的姐姐了吧……呵呵。",
      "source_fingerprint": "d0f8b88fbb0111b6cd5cc35fd1796a83f9fec1ea12fe4e3f10df1d871a23b36c",
