      ]
    },
    {
      "uid": "zhcn:9a07beaf2ab5c078c21d57dc",
      "kind": "character_system_text",
      "source_text": "我们有所成长了呢。",
      "source_fingerprint": "a7c469e57a4496f9528e401a9a50135361a7c3e3149a049387d67534f77ebd8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "20050"
      ]
    },
    {
      "uid": "zhcn:e21d7cf14bf689fa8f035808",
      "kind": "character_system_text",
      "source_text": "一起加油吧……！",
      "source_fingerprint": "3ad1c0e0857bce4cf553024380b2a49755752106372acf829b6da8220679ace0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "20051"
      ]
    },
    {
      "uid": "zhcn:46ef37f5c9225a019adf441c",
      "kind": "character_system_text",
      "source_text": "一起加油吧！",
      "source_fingerprint": "27034d160af1c1f09dc5bc82dd514313c27a89258641f741350dfcc49d329de0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "2030"
      ]
    },
    {
      "uid": "zhcn:5ed6a0e987db442f9cd8b294",
      "kind": "character_system_text",
      "source_text": "我们的话没问题！",
      "source_fingerprint": "34d1070fcfb23394b80811f0eaf5380e29c64925365f0298bc7abd87631c2e79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "2031"
      ]
    },
    {
      "uid": "zhcn:88e5691521ca5549ff41fbc9",
      "kind": "character_system_text",
      "source_text": "我们有所成长了呢。",
      "source_fingerprint": "a7c469e57a4496f9528e401a9a50135361a7c3e3149a049387d67534f77ebd8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "2032"
      ]
    },
    {
      "uid": "zhcn:a405861c17d7e00524ad65f4",
      "kind": "character_system_text",
      "source_text": "紧张？……不，完全没有！\n今天会遇见怎样的光辉呢……\n我满脑子都在想这个。",
      "source_fingerprint": "5cdc4e01fab59ea3fa11852270fb11cadede9ff3ca428142174789034bf34029",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "2033"
      ]
    },
    {
      "uid": "zhcn:1d064f2bfd1f5b89e3a38b9e",
      "kind": "character_system_text",
      "source_text": "只要有大家的支持和你的心意——\n无论到哪里我都能奔跑下去哦！",
      "source_fingerprint": "cbaecb33b130a9de572403a5640db5c3f9d6b77e945f2cb71bb9c3af8116c439",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "2034"
      ]
    },
    {
      "uid": "zhcn:1eb813923dd8ec5a92e63182",
      "kind": "character_system_text",
      "source_text": "我们有所成长了呢。",
      "source_fingerprint": "a7c469e57a4496f9528e401a9a50135361a7c3e3149a049387d67534f77ebd8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "2035"
      ]
    },
    {
      "uid": "zhcn:d521626bd5d0997fc55ce8bb",
      "kind": "character_system_text",
      "source_text": "好！",
      "source_fingerprint": "49672a086a169b187b16a389c63cf25fceada147d32b3aa866520c2b922fd86c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "23015"
      ]
    },
    {
      "uid": "zhcn:df613d0957416307249b32a6",
      "kind": "character_system_text",
      "source_text": "达成那片景色，还差一步……！",
      "source_fingerprint": "9e10348cb238ff9e804bde636d364b79933891d52c3443197cd459594d7f0a80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "30000"
      ]
    },
    {
      "uid": "zhcn:8e4a06f75e4a29c6a3ae5454",
      "kind": "character_system_text",
      "source_text": "看着吧，下次会更加闪耀！",
      "source_fingerprint": "fba5fed582f192c22c2cb23bfaf86a890fc54d51d93a705291039ab253ac87a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "30001"
      ]
    },
    {
      "uid": "zhcn:bfbe9fc112c6909494b0216f",
      "kind": "character_system_text",
      "source_text": "我们必须向前更进一步……！",
      "source_fingerprint": "e49655cfcc3887dd0831f48b633c940a502cfa84ffe86e8e3cf222a6eff40bd6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "30002"
      ]
    },
    {
      "uid": "zhcn:429ea3914d99ef35ca4c791d",
      "kind": "character_system_text",
      "source_text": "被看到丢人的一面了……",
      "source_fingerprint": "fc49cc6ef454b4224da5befcc63a3ff1ee7aa71f404627d34056415c050fb22d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "30003"
      ]
    },
    {
      "uid": "zhcn:0131b7be82673a4803ec9c1e",
      "kind": "character_system_text",
      "source_text": "你也看见那片“绝景”了吧……！\n……呜……",
      "source_fingerprint": "835f060df6a76cae3a94b709b82b3292edd46feefb79595a67583a6748d3545e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "30004"
      ]
    },
    {
      "uid": "zhcn:ba23ff55e964a38d104a1c0d",
      "kind": "character_system_text",
      "source_text": "谢谢支持……\n大家的声音都成了我的力量……！",
      "source_fingerprint": "7d02ae2fcc2330971172b78740fb86753d7c88cde30cea30f2235d8e126bdf0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "30005"
      ]
    },
    {
      "uid": "zhcn:cf293bbdd8f2611d584af128",
      "kind": "character_system_text",
      "source_text": "我出发啦！",
      "source_fingerprint": "7a81719318f354a289fa32effff3e0060c6af596527f262f806d5f1b7f27b877",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "31000"
      ]
    },
    {
      "uid": "zhcn:abe2e8bb64a0e9bf16a8087e",
      "kind": "character_system_text",
      "source_text": "和你一起……！",
      "source_fingerprint": "0177db8d422477ea9e6ce1baf2e66e59e717e34dda217aa42b208e08708aae7d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "40000"
      ]
    },
    {
      "uid": "zhcn:3e0c9268fe7c5fe421f9e728",
      "kind": "character_system_text",
      "source_text": "想法枯竭的话先来喝茶吧。\n低糖蔬菜蛋糕，\n宿舍的大家都很喜欢哦♪",
      "source_fingerprint": "de34169dc61e11cd4a590c0e8ebd452308aa2ff1f2d312c4f3fb9132ee09673b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "400002"
      ]
    },
    {
      "uid": "zhcn:8386dc93af1da7d2018f8021",
      "kind": "character_system_text",
      "source_text": "咳、咳、嗯。哟……哟兄弟伙。\n……啊，好像比上次\n说得顺畅些了……？",
      "source_fingerprint": "a4a6ce0f9c9ace07d4ce0aeb2b7c8892408f2494cca76b6cce32656c251c8838",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "400005"
      ]
    },
    {
      "uid": "zhcn:809fe1d141f1c5d668a4982e",
      "kind": "character_system_text",
      "source_text": "那个约定，至今仍刻在心中——\n绝对要和你一同抵达……！",
      "source_fingerprint": "266051bf62fe6f8d25d49696dac1cfd83d0aaef8144833edab7db27f9ee83378",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "40001"
      ]
    },
    {
      "uid": "zhcn:dd91bfb479b6953be35007b2",
      "kind": "character_system_text",
      "source_text": "传达出的点点光芒，实在\n太过美丽……这充满回忆的照片，\n我想设为手机壁纸♪",
      "source_fingerprint": "faca058ddc4351b88747d58591def226836974e8996128c853783ced53af328d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "400014"
      ]
    },
    {
      "uid": "zhcn:1dda74e920cfe25d027fd181",
      "kind": "character_system_text",
      "source_text": "要把『谢谢』传达给大家！",
      "source_fingerprint": "16bf4c7d58168102fa01342ac34bf31a16d1d0c7a19e9343d7c8b607972734df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "60000"
      ]
    },
    {
      "uid": "zhcn:09bba97a8d2b28909f62c328",
      "kind": "character_system_text",
      "source_text": "即使在舞台上，\n也要把最棒的景色……！",
      "source_fingerprint": "1563babbfd2bf0f41cd3d544745fa0f6cd1b8f63838bee72dd5762f4a393070d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "60001"
      ]
    },
    {
      "uid": "zhcn:5b1393d8f80312fa885e01ca",
      "kind": "character_system_text",
      "source_text": "那片景色，一起去见证吧。",
      "source_fingerprint": "225a02a8978bb315112c7f61b32f630a3f720224dab0252f68e88f992a3a36eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70000"
      ]
    },
    {
      "uid": "zhcn:5543d986a90c8d2c472545a3",
      "kind": "character_system_text",
      "source_text": "有着同样的梦想——\n能够共同追逐憧憬的“绝景”……\n有这样的人在我真的很幸福呢。",
      "source_fingerprint": "9d245a1daaeabd502982ced120e016fc244e5ab0fd8ee66f25a934253d2ba2b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70001"
      ]
    },
    {
      "uid": "zhcn:07c7e93b7693d49bf158245d",
      "kind": "character_system_text",
      "source_text": "这套制服是努力的证明。\n就和你的徽章一样呢！",
      "source_fingerprint": "5189287b9070b4709de05ecedf2d4f1874f95bbca54807554ac954953dd28340",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70004"
      ]
    },
    {
      "uid": "zhcn:b65bd089761eea6a76ce935f",
      "kind": "character_system_text",
      "source_text": "即便在Live上，\n也想让大家看到绝景！",
      "source_fingerprint": "3226896045fd3fcfb044a46447a4115b9d46091b681ab39b3819ee27106827b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70008"
      ]
    },
    {
      "uid": "zhcn:cd90ad570a24f86ebd6b67dc",
      "kind": "character_system_text",
      "source_text": "就用这套决胜服，\n来实现我们的梦想！",
      "source_fingerprint": "83af9d3798d1020b1235858d47f6067ee54cad1a1907b31d92d8317f5b71b687",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70009"
      ]
    },
    {
      "uid": "zhcn:67a9e3ea3ba843532438d4f1",
      "kind": "character_system_text",
      "source_text": "能一起来到特雷森学园，\n真的像做梦一样！",
      "source_fingerprint": "1c3fb99c2007f3d5efd61e6b0ba2b63a4d94381cb3e6f64559ea607ef68351ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70010"
      ]
    },
    {
      "uid": "zhcn:248f666265df279e19201f01",
      "kind": "character_system_text",
      "source_text": "即使穿着和大家一样的衣服，\n你也能马上找到我吧。",
      "source_fingerprint": "2d557c66d7af6f7d686f844477a9aa8ff5f1ac8fd15d92e7b7bd1b4fc4d42ea6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70014"
      ]
    },
    {
      "uid": "zhcn:f21a08935d4970edfff46203",
      "kind": "character_system_text",
      "source_text": "衣服上的腰带，\n一紧张就会忍不住去抓呢……",
      "source_fingerprint": "d1dbb2b16ef5a1831eda04386b584331cfaa29b896435db938d8b6e98cb53652",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70015"
      ]
    },
    {
      "uid": "zhcn:77264d2980c5d317ed819562",
      "kind": "character_system_text",
      "source_text": "哇，好漂亮的衣服！",
      "source_fingerprint": "4cb28125eddaa1960041d122e354ffd7515aee6e714ecd7f2a4c934bac809d81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70018"
      ]
    },
    {
      "uid": "zhcn:20c5fae92cf477e12bafa626",
      "kind": "character_system_text",
      "source_text": "怎么样？\n……有变得和平常不一样吗？",
      "source_fingerprint": "873f581e62d58bf071c02f0ad35d2d66e9883ebd280c11fb9e32c5860a2bc6a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70019"
      ]
    },
    {
      "uid": "zhcn:14da0cb98a98c86f1ba01238",
      "kind": "character_system_text",
      "source_text": "呐，一起出门吧？",
      "source_fingerprint": "07874cf38e99727b7ede81df4eb644d63dd9747967e0ecad768069c803a53c3d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70020"
      ]
    },
    {
      "uid": "zhcn:ba889078d19c7278fe79dd20",
      "kind": "character_system_text",
      "source_text": "我的喜好一直没变哦。\n还是很喜欢可爱的衣服！",
      "source_fingerprint": "8d8fb58c87d3ae61742365ea12f750b9de7648a6be86773441f8374e3da05f52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1114",
        "70021"
      ]
    },
    {
      "uid": "zhcn:1d1ae67d2c0db9f465434db2",
      "kind": "character_system_text",
      "source_text": "这套制服是努力的证明。\n就和你的徽章一样呢！",
      "source_fingerprint": "5189287b9070b4709de05ecedf2d4f1874f95bbca54807554ac954953dd28340",
      "source_path": "character_system_text_dict.json",
