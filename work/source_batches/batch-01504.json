        "140001"
      ]
    },
    {
      "uid": "zhcn:6377147a891aed49feb64937",
      "kind": "character_system_text",
      "source_text": "…あら。",
      "source_fingerprint": "6fa11d718553d22c8fda562028fbb620aa98a3deba0469522509afdc03705f39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1116",
        "140002"
      ]
    },
    {
      "uid": "zhcn:e274324bb69352bb74f9138c",
      "kind": "character_system_text",
      "source_text": "ふふっ、上々ね。",
      "source_fingerprint": "63bd84c1bca5fe62ca5f167205b02c3c13216d031ec0827508507d9151419303",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1116",
        "140003"
      ]
    },
    {
