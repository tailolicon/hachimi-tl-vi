      "kind": "character_system_text",
      "source_text": "お上手。",
      "source_fingerprint": "fca16f969f1be115d50147541efde450347cb3e660ac39c439f828bbaf60d062",
      "source_path": "character_system_text_dict.json",
      "json_path": [
