      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "1002"
      ]
    },
    {
      "uid": "zhcn:df2da42b4639e57814b89c8c",
      "kind": "character_system_text",
      "source_text": "Nice one!赛马娘名鉴的\r\n等级提升了哦！",
