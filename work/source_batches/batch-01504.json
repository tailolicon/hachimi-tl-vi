    {
      "uid": "zhcn:3d4b099c7fd2919bda5542e7",
      "kind": "character_system_text",
      "source_text": "我的生日派对，你大可\r\n轻松空手过来哦。\r\n——因为你本身就是最好的礼物。",
      "source_fingerprint": "8ac11b26c86a40ee156f6faf988465092378e19cb4325b042aae4b36641531fb",
      "source_path": "character_system_text_dict.json",
