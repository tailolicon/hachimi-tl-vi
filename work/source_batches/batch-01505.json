      ]
    },
    {
      "uid": "zhcn:21c23354f3513fe84d949969",
      "kind": "character_system_text",
      "source_text": "走吧！",
      "source_fingerprint": "92ae3e5dcae9a53056d19b3106de1996e8c400c410dfd1c96cb651012cfebc4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20046"
      ]
    },
    {
      "uid": "zhcn:b01bc8d9a53458748e9dd46c",
      "kind": "character_system_text",
      "source_text": "It's beautiful!",
      "source_fingerprint": "394f014b2c463e5bf899885309f2eb9a6279ea416b205dd0ae3547d8a642c64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20047"
      ]
    },
    {
      "uid": "zhcn:8610dc0bcd18feadff4af3a5",
      "kind": "character_system_text",
      "source_text": "向你的support表示敬意！",
      "source_fingerprint": "be18a412696ca535d8f8bf9daabef46f8d6d644a9679e475c301e94029c0bb77",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20049"
      ]
    },
    {
      "uid": "zhcn:815c42d49b656d1599dfcf12",
      "kind": "character_system_text",
      "source_text": "真是段最棒的日子。",
      "source_fingerprint": "25111737fa6f5384f442d5c98743b51d82b431b91f8fdb487ead9027c1d03ba3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20050"
      ]
    },
    {
      "uid": "zhcn:5b4c4fb349efe9de56734897",
      "kind": "character_system_text",
      "source_text": "Here we go!",
      "source_fingerprint": "cac608ad4e2e746047e9a3c06ee666cafd5b02fa6ec6fb36f16f20d997367111",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20051"
      ]
    },
    {
      "uid": "zhcn:03014ef71207161106be1daa",
      "kind": "character_system_text",
      "source_text": "大家，上吧！",
      "source_fingerprint": "1549c847d674bffca5b8a80dea6fddd5ebfcad7057e99d588df7830057c80bcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "2030"
      ]
    },
    {
      "uid": "zhcn:e7ee62598705b7c37754b4df",
      "kind": "character_system_text",
      "source_text": "大干一场吧！",
      "source_fingerprint": "4a40f4a466cea5f7797efa6f46b9a886b74038d0ba035b6470c3f980e2d1cd59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "2031"
      ]
    },
    {
      "uid": "zhcn:813c02f1a6dab6b29ea3449d",
      "kind": "character_system_text",
      "source_text": "真是段最棒的日子。",
      "source_fingerprint": "25111737fa6f5384f442d5c98743b51d82b431b91f8fdb487ead9027c1d03ba3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "2032"
      ]
    },
    {
      "uid": "zhcn:df6d726e39c6afa3a7043be3",
      "kind": "character_system_text",
      "source_text": "大家表情都很不错…感觉都做了\r\n万全的准备。…啊，\r\n马上就要正面交锋了呢…！",
      "source_fingerprint": "1bc4b0fe0787be149431adf7a3c271426b84ac697c57e3183726fb5d2653f333",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "2033"
      ]
    },
    {
      "uid": "zhcn:8358a54265a9c934b649e048",
      "kind": "character_system_text",
      "source_text": "I feel amazing!\r\n能为我准备好\r\n胜利的派对吗？",
      "source_fingerprint": "f72dcbbae94a8dcd32ee29d43b06737d060b4f0d32dfb2585c4aad369004ec37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "2034"
      ]
    },
    {
      "uid": "zhcn:180e000d20aeab3de4a1d6a5",
      "kind": "character_system_text",
      "source_text": "真是段最棒的日子。",
      "source_fingerprint": "25111737fa6f5384f442d5c98743b51d82b431b91f8fdb487ead9027c1d03ba3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "2035"
      ]
    },
    {
      "uid": "zhcn:9015c10aa8c7944d94a97697",
      "kind": "character_system_text",
      "source_text": "Let's do this!",
      "source_fingerprint": "466c747c026bc81d50dc3c312ae4bb184db929d66b72aa95a6361d32198f57fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "23015"
      ]
    },
    {
      "uid": "zhcn:671f1535cf34b7bca0deb855",
      "kind": "character_system_text",
      "source_text": "就差一步了呢…！",
      "source_fingerprint": "1e2a6c4f141c61970a851fb7c2843522981e7d3694905be5be62ac516fae2ceb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "30000"
      ]
    },
    {
      "uid": "zhcn:eb6448bd0e8c3316b1df7a5d",
      "kind": "character_system_text",
      "source_text": "以此为鉴，下次一定…！",
      "source_fingerprint": "e62d0d9c1f26104790d232dbca17a988374c83fce9e428a723b65247d18a08c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "30001"
      ]
    },
    {
      "uid": "zhcn:b70c21c0d57f1388b15b2052",
      "kind": "character_system_text",
      "source_text": "开反省会了，训练员。",
      "source_fingerprint": "77abb69501114f7dfb008095fe18509645e200ffa17870a660b8d9d3c77bf73b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "30002"
      ]
    },
    {
      "uid": "zhcn:30b0c1ef6188109d7fbf1eb1",
      "kind": "character_system_text",
      "source_text": "我绝不能就这样狼狈下去…！",
      "source_fingerprint": "af9a19f8249567b4b6c9c1a12e7fdee892d3708cc8613a96eb651cdd9718778d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "30003"
      ]
    },
    {
      "uid": "zhcn:7905a5fd6c9936d85757abc0",
      "kind": "character_system_text",
      "source_text": "This is my Queendom!我会贯彻到底的！",
      "source_fingerprint": "559ef0a5ca125ba6e7690c417e9f2875f1467b5911da77f66964c9d2dd265038",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "30004"
      ]
    },
    {
      "uid": "zhcn:669dbf8948cc26051161d1c0",
      "kind": "character_system_text",
      "source_text": "你能跟上我吗？直到前方的queendom为止！",
      "source_fingerprint": "67676b7e7f36636354be02162d9a4d18c6c9b885514f94b044d1fdedbaef5062",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "30005"
      ]
    },
    {
      "uid": "zhcn:4e1080796d2c59cdf68c7b1e",
      "kind": "character_system_text",
      "source_text": "要全力以赴了！",
      "source_fingerprint": "0a7b248cfda935eeba6de9842e2c0fe467bcb021247b71b25a4cd2971b4ae1c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "31000"
      ]
    },
    {
      "uid": "zhcn:3fc2ba6ef6de4a4e3c7ad4a7",
      "kind": "character_system_text",
      "source_text": "我一定会成为女王的！",
      "source_fingerprint": "7ef3d8484ed02ac207a466ed61596d1c273bc6ca6d772667b563acc0ba52598f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "40000"
      ]
    },
    {
      "uid": "zhcn:6c213b36c5f6e50556a319e7",
      "kind": "character_system_text",
      "source_text": "那个人，到底在想些什么呢……——\n啊，不行不行，表情！\n得把嘴角扬起来才行！嗯——！",
      "source_fingerprint": "9e125a03fa9e02465b83c2b706721a35ea2f7c0a5a7a72208d3a01d58aba39bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "400003"
      ]
    },
    {
      "uid": "zhcn:3a3dd2207a3e557f854df5c5",
      "kind": "character_system_text",
      "source_text": "那孩子，爬树的技术真的很棒呢\r\n…不愧是连snow monkey\r\n都能赢过的对手。",
      "source_fingerprint": "1bd8bd6062afd7564507f4bd325648bf18ece126dba3851dd4b1504cf7c9f6ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "400004"
      ]
    },
    {
      "uid": "zhcn:c2571c08dcf2666cf5af6f03",
      "kind": "character_system_text",
      "source_text": "呵呵！之前还为服装烦恼了那么久，\r\n没想到最后竟然决定得这么顺畅呢。\r\n…真是个坦率又Cute的孩子。",
      "source_fingerprint": "af1eb975e9069722fce70277133c69a70d39ffd4286cf209dcbcf97cd404b715",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "400006"
      ]
    },
    {
      "uid": "zhcn:08e258577c667b1a55c92b38",
      "kind": "character_system_text",
      "source_text": "一定会闪闪发光的——通过碰撞、磨炼、雕琢！\r\n我要成为，配得上后冠的heart！",
      "source_fingerprint": "9ccb2d0118f6545d48f33d032ef81557973079bdad552b3b4ebd1853f8a3616e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "40001"
      ]
    },
    {
      "uid": "zhcn:db210ba89686ee177ee24cf6",
      "kind": "character_system_text",
      "source_text": "高峰小姐真是太压倒性了……\n——真棒啊。目标越高远，\n这颗心就会燃烧得越炽热！",
      "source_fingerprint": "583ca06ca77f39e822bd6512a41ad69c4bce5933f42a557d764c249c0949ad27",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "400010"
      ]
    },
    {
      "uid": "zhcn:28b4a9d92e5bc17e9aa3fa03",
      "kind": "character_system_text",
      "source_text": "头戴花冠，再加上莱茵她们送来的\r\n『祝福花束』…呵呵！\r\n感觉就像是变成了公主一样呢♪",
      "source_fingerprint": "41973eb79c9e2f38d9551f263061a2894971fc5a17e89cadeb5d2d875bd1ab3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "400129"
      ]
    },
    {
      "uid": "zhcn:cb46a77f16a312fd8cd5af98",
      "kind": "character_system_text",
      "source_text": "让你见识一下最棒的我♪",
      "source_fingerprint": "15ae35fc6e9fa7ced88c05e8b2c7b8c86fa162cdc76373c952b9f40db63b985d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "60000"
      ]
    },
    {
      "uid": "zhcn:ed3efa66895fe6f6f3f64674",
      "kind": "character_system_text",
      "source_text": "Keep your eyes on me!我会让你成为我的俘虏",
      "source_fingerprint": "dcb3fae5987cf0956cf10ae429a47efa99714ee16b59c0ec2bd77d3914d8f61d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "60001"
      ]
    },
    {
      "uid": "zhcn:0d70b6af1fce0e3ed26d99a4",
      "kind": "character_system_text",
      "source_text": "Are you ready?　跟上来吧♪",
      "source_fingerprint": "497a243a823c8d6f86463bc32fe7aef281b99a2fa4ed7c309172adc0f7974e11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70000"
      ]
    },
    {
      "uid": "zhcn:4659539371076605c12ca705",
      "kind": "character_system_text",
      "source_text": "你以为是你最先看中我的吗？\r\nNope，是我先注意到你的…\r\n那份分析能力，我可不会放过哦♪",
      "source_fingerprint": "f2ad6056b29ba74b1abdc0ef4ff9dba87095ab94efdfe20eb063252d41fa8c56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70001"
      ]
    },
    {
      "uid": "zhcn:c95e3006c46bb98f5d0e7830",
      "kind": "character_system_text",
      "source_text": "日本的校服真cute呢！简直像化妆舞会一样！",
      "source_fingerprint": "b84b90a9bc157c30326a98d5c2b043ef244c6903084cf6d90a20a7b9d9c1a454",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70004"
      ]
    },
    {
      "uid": "zhcn:1f421196def17c76f19853f0",
      "kind": "character_system_text",
      "source_text": "我的穿搭也是第一名，对吧？",
      "source_fingerprint": "66eb68a23b0ac6d9f460ae4368c39e31d4d2d5275c136363d0e3ac53b2111c8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70008"
      ]
    },
    {
      "uid": "zhcn:e07357a572e16841dc419036",
      "kind": "character_system_text",
      "source_text": "在草地上非常显眼的、鲜艳漂亮的黄色，对吧？",
      "source_fingerprint": "120011f60d7b67dc05c8b8b8da9d4c3629fa65ed146957b97a8e3ef122635c6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70009"
      ]
    },
    {
      "uid": "zhcn:8daa326bd4bd235ea7474ffa",
      "kind": "character_system_text",
      "source_text": "想知道让蝴蝶结显得蓬松的诀窍吗？",
      "source_fingerprint": "5f8f59b51b235ab7204f4d235f7ceeb9e3ff08cf836a7d34a00d713f95bb5efc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70010"
      ]
    },
    {
      "uid": "zhcn:fa5835eecc0d67fc351adfd2",
      "kind": "character_system_text",
      "source_text": "蝴蝶结我和朋友互相检查过，所以很完美哦",
      "source_fingerprint": "846591451d6aebb647ec534777070370ad34ffe4a42f7d086cb188e0199fb26e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70014"
      ]
    },
    {
      "uid": "zhcn:e0f3eb51b968481f944140bc",
      "kind": "character_system_text",
      "source_text": "女王的宝座，我一定会夺到手。",
      "source_fingerprint": "dc58fa4a934ecb2f9733f7de0cf7f738b310034444439f7d91a4979d1b1368bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70015"
      ]
    },
    {
      "uid": "zhcn:0938d9846f70f81a697ff360",
      "kind": "character_system_text",
      "source_text": "我可是什么衣服都能轻松驾驭的类型哦♪",
      "source_fingerprint": "6f814d73a6333e2cf1a8a0503e219ca288df00c6b72b741a8cf940488843f64c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70018"
      ]
    },
    {
      "uid": "zhcn:6d8442b49ab309a6189eba22",
      "kind": "character_system_text",
      "source_text": "难得有机会，要不要就这样去约会？呵呵。",
      "source_fingerprint": "edc5ad96f0a8e11554cbbf5a5e57cce5861883e17152f442b1e23363ee325a27",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70019"
      ]
    },
    {
      "uid": "zhcn:e0ecec7a5379fca132988727",
      "kind": "character_system_text",
      "source_text": "我用最喜欢的品牌统一了穿搭哦♪",
      "source_fingerprint": "a4a77e70dd5c58284f66f8279f570ac2117a3d33f0529f83e800b766c7d2321e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "70020"
      ]
    },
    {
      "uid": "zhcn:c8ec822e587590cdbbdbe9f4",
      "kind": "character_system_text",
      "source_text": "发呆的话假日可是会溜走的哦？",
      "source_fingerprint": "f7fd3056c02fd122af19081298e1869295dff2daedf12e7b261023a220ee5b0d",
      "source_path": "character_system_text_dict.json",
