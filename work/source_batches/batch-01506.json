        "1118",
        "10007"
      ],
      "json_pointer": "/1118/10007"
    },
    {
      "uid": "zhcn:1f366a18ef7a20202ab8d8eb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "还是来了啊，圣诞节……\r\n今天我要早点回房间。我可受不了\r\n被卷进骚动里。",
      "source_fingerprint": "3bef56e4df95cc9bd70de6869baa5a99890ea8b21aefeab5b9969dcb33479043",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
