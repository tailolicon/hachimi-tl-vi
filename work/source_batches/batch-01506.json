      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "您回老家的时候，请把训练\r\n计划表留下来。\r\n我会留在学园里的。",
      "source_fingerprint": "757160ed6e765be5cf3428f861480760fb18933812517d98e574fb586982fb33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
