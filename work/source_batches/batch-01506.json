    {
      "uid": "zhcn:34b0f50343cb33bdfc05eae0",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "……快点结束吧。",
      "source_fingerprint": "021787757c33b7bd391462d2273eff62752824bede31e96ec11ae13a32ee948c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
