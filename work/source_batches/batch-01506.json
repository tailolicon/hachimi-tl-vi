    },
    {
      "uid": "zhcn:fc39728910157597dcee788d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "……难道说当训练员\r\n不爱多管闲事是不行的吗？\r\n……肯定是不行的吧。",
      "source_fingerprint": "0704761d32ec1aa9df891c41f595e69b899b4246194315b96adbee7504654016",
