  "entries": [
    {
      "uid": "zhcn:e8870f5ba5000d07c7020618",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby！",
      "source_fingerprint": "c68d1ccbe412517d037eba3349a53caf52ee4216f3314987c5d59645520f8f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "12"
      ]
    },
    {
      "uid": "zhcn:6ebcfd730add038665b4a94f",
      "kind": "character_system_text",
      "source_text": "有什么，正流淌进来……",
      "source_fingerprint": "71b43545108dcc1926d7960a21e8cf146ce43cd44bb5cb891df8ea0d87ef02c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "120000"
      ]
    },
    {
      "uid": "zhcn:508e69d70ca0487eca21406b",
      "kind": "character_system_text",
      "source_text": "唯有获胜……！",
      "source_fingerprint": "5e574d585ceed3e9996529a5acb583fdcc8d14d32f785fd756acdb191cdcc68e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "1264"
      ]
    },
    {
      "uid": "zhcn:d4572a5476fd6d1f0ac6c7c9",
      "kind": "character_system_text",
      "source_text": "我上了。",
      "source_fingerprint": "980a7ec4edfa6d1adf15641f4347f9c2840126ff143da4b3a0db3ad63034d737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "1265"
      ]
    },
    {
      "uid": "zhcn:a5d91598e10a3e8cfceaa989",
      "kind": "character_system_text",
      "source_text": "这是今天的登录奖励。",
      "source_fingerprint": "7cc7b99b32d8f34da6bd620973df2ae9a0a57751a69db6f6dffcae6088fc7c17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "13"
      ]
    },
    {
      "uid": "zhcn:23e6ea3b96a2fe9ae5916fae",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140000"
      ]
    },
    {
      "uid": "zhcn:56592ecf27115bbe3f71eac6",
      "kind": "character_system_text",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140001"
      ]
    },
    {
      "uid": "zhcn:5cb4a952367abebc76373818",
      "kind": "character_system_text",
      "source_text": "呼……",
      "source_fingerprint": "859051e831aa125febaf30affc00b2a41c40ac4b8d2ac6c3e681bad9b0d37a18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140002"
      ]
    },
    {
      "uid": "zhcn:48b2a1271cfb63068ea958c1",
      "kind": "character_system_text",
      "source_text": "你很擅长呢。",
      "source_fingerprint": "5bd57330a7679c8974a0a663013f897f35d253463f1246037d16f672cebafabe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140003"
      ]
    },
    {
      "uid": "zhcn:ff2bf4e3ae63f82d090a3714",
      "kind": "character_system_text",
      "source_text": "……居然能抓到呢。",
      "source_fingerprint": "61567a6596a0326a704b31559a83bd674230b0f8a3f5c2a3362a60f2d5601531",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140004"
      ]
    },
    {
      "uid": "zhcn:63326b92d3c48100d3b3d498",
      "kind": "character_system_text",
      "source_text": "不过如此吧。",
      "source_fingerprint": "c372cea42868441d7f0a066e37ed1b58ae0399e7b07b3c718c16a6dc7f60017c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140005"
      ]
    },
    {
      "uid": "zhcn:ef806fa8250640ae7f884cbc",
      "kind": "character_system_text",
      "source_text": "你很擅长呢。",
      "source_fingerprint": "5bd57330a7679c8974a0a663013f897f35d253463f1246037d16f672cebafabe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140006"
      ]
    },
    {
      "uid": "zhcn:71ba826679b87f9be870b088",
      "kind": "character_system_text",
      "source_text": "……居然能抓到呢。",
      "source_fingerprint": "61567a6596a0326a704b31559a83bd674230b0f8a3f5c2a3362a60f2d5601531",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140007"
      ]
    },
    {
      "uid": "zhcn:2267bd2ec5ec471071921326",
      "kind": "character_system_text",
      "source_text": "有什么事？",
      "source_fingerprint": "8eb060fbec30bddbb8e692398fbc4efee7bca1c5a853f94a1f484aae372a54df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140008"
      ]
    },
    {
      "uid": "zhcn:7465bf7327692abc1c4faff0",
      "kind": "character_system_text",
      "source_text": "……哈啊。",
      "source_fingerprint": "c4dfe5c185621fdbbcf6b51ebcea7015f1a31d65529a7fe1e85f73af04d0085c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140009"
      ]
    },
    {
      "uid": "zhcn:d789163b4cacb3ffe3399be5",
      "kind": "character_system_text",
      "source_text": "不需要动一动吗？",
      "source_fingerprint": "aacf3b7ae0821aa4fb07dcf3f966c9c2f66fe06742f0b0150570a8b119a4351d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140010"
      ]
    },
    {
      "uid": "zhcn:88639a83187aebfd73535f43",
      "kind": "character_system_text",
      "source_text": "连在一起了……！",
      "source_fingerprint": "40bb7538178bdc24abb626778ad77b9d903bfaf752c8aa0cf022e2deafe89255",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140011"
      ]
    },
    {
      "uid": "zhcn:bef00bb5b56da5daaeb5b61b",
      "kind": "character_system_text",
      "source_text": "靠得太近了……",
      "source_fingerprint": "f58e5570a90bdf7ed6a10de63b37a4579c6f5e3719611d7a93a96b9bda11a644",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140012"
      ]
    },
    {
      "uid": "zhcn:1943f7eecdecef3114d7d681",
      "kind": "character_system_text",
      "source_text": "居然这么……",
      "source_fingerprint": "ba7523ff4954f2c428b6bd2af77990981893fb9025aed1c246a3ef90eafd4255",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140013"
      ]
    },
    {
      "uid": "zhcn:d77e15cd5f4322e571b5d043",
      "kind": "character_system_text",
      "source_text": "呃……",
      "source_fingerprint": "82fec3801d176574a5c73b753c0428097ba4efacd01f74d8bbeb0f256d85692f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140014"
      ]
    },
    {
      "uid": "zhcn:a9ea172388b275cf5f1d2a09",
      "kind": "character_system_text",
      "source_text": "嗯……！",
      "source_fingerprint": "65376b8a86e35a0752a2faa889379d09ec563657e83fcdf098797820fd01d8ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140015"
      ]
    },
    {
      "uid": "zhcn:8d23549bd04e3bb9582a8080",
      "kind": "character_system_text",
      "source_text": "这是在浪费时间哦。",
      "source_fingerprint": "f75498803596c973f4e0fc758f8277ad98ca9ebecaa197b897c899dc305f97c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140016"
      ]
    },
    {
      "uid": "zhcn:46e315ab394ed77b9aab2e4d",
      "kind": "character_system_text",
      "source_text": "真是的……",
      "source_fingerprint": "2e024616ec7a2bf1c748a0e016d56f11053ca841cb2a9d941ddb2fa396dd0aba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140017"
      ]
    },
    {
      "uid": "zhcn:91a420ee14118ff28d656961",
      "kind": "character_system_text",
      "source_text": "啊，分开了……",
      "source_fingerprint": "6271bd2355eee651f0ebd6e2adc7edfe9b81c5ccbd86d6d4f500645c7d1bb372",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "140018"
      ]
    },
    {
      "uid": "zhcn:52ea8ef733afecec51a3badf",
      "kind": "character_system_text",
      "source_text": "明天的是这个。",
      "source_fingerprint": "4b6911b60c85f9b0fde1828d6077e7fd57595f123fb7ffd3267bcfcec39fbae9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "15"
      ]
    },
    {
      "uid": "zhcn:3ff736c9d73c7666f75cc327",
      "kind": "character_system_text",
      "source_text": "……唔，怎么了……\r\n请开始吧……不把自己逼到绝境的话……\r\n是无法变强的……！",
      "source_fingerprint": "60a9b92b00fd13d0b960fe3f3e2267fe6143e8b6543427cba47a389f3a8513e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20000"
      ]
    },
    {
      "uid": "zhcn:4ee90a8e80a86c7104087d74",
      "kind": "character_system_text",
      "source_text": "……已经习惯了。\r\n这点程度……我能承受。\r\n……没问题。",
      "source_fingerprint": "d6d1a11069ef0637331630fbafea9c7b5993218631dd399759334d84e6e56d98",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20001"
      ]
    },
    {
      "uid": "zhcn:40f7f16edfd1372b785492ea",
      "kind": "character_system_text",
      "source_text": "比任何人都要强，向着更高处——\n如果是我的话，\n正因为是我才能到达。",
      "source_fingerprint": "dadd9696f44f312507025938bf7ff12d7cd38485a6be4c040aee40710bbbe548",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20002"
      ]
    },
    {
      "uid": "zhcn:fce02e05f94797f6db9a7730",
      "kind": "character_system_text",
      "source_text": "……我很集中。\r\n集中到一切都能清晰地感觉到。",
      "source_fingerprint": "d58bff96587eb37bce86eb18e3d67f3ad0239130e3de6315f7cf48dba1ab1645",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20003"
      ]
    },
    {
      "uid": "zhcn:34addcf13c6246cfd2c19ebf",
      "kind": "character_system_text",
      "source_text": "……鞋带，松了哦。\r\n……看你好像没注意到的样子。",
      "source_fingerprint": "a478de9ec30f42414783d7f28e9088d57a51f70ee082bbb149a88d725f550b7f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20004"
      ]
    },
    {
      "uid": "zhcn:c9b5ade5b4e0d4d27471ccaf",
      "kind": "character_system_text",
      "source_text": "桌上的训练用品\r\n目录里，我已经贴好标签了。\r\n请您过目考虑。",
      "source_fingerprint": "620ae6a486f66449d1d125bc3817a0f395a5e087c9118fc2592833f74592c488",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20005"
      ]
    },
    {
      "uid": "zhcn:b8732c2f13d4fa955bf60dd4",
      "kind": "character_system_text",
      "source_text": "……在开始之前，我可以听会儿音乐\r\n吗？我想集中精神。",
      "source_fingerprint": "0c360cdf7df535cc5c25deff6a92d949db2c0a313a46a4902e7d2c880b0eec8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20006"
      ]
    },
    {
      "uid": "zhcn:d3afe2759b534f9b3f99aff8",
      "kind": "character_system_text",
      "source_text": "……爱如往昔同学。\r\n……！",
      "source_fingerprint": "a9e12a0e30417b6413685ac6da0bfd9c563b9f643d4bdc6cc8760183eb3b996d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20007"
      ]
    },
    {
      "uid": "zhcn:ca97229b85bd7996ff8ab1b5",
      "kind": "character_system_text",
      "source_text": "不需要，您的关心……\r\n现在，请别跟我说话……\r\n我想，集中精神。",
      "source_fingerprint": "65557b3d65b9e16acad9911eb239f981cc70ce2bd1ad7924ae1826004f9a2443",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20008"
      ]
    },
    {
      "uid": "zhcn:f37a3e4e649f1d4141924f19",
      "kind": "character_system_text",
      "source_text": "请离我远点。\r\n……为了彼此好，请离开……",
      "source_fingerprint": "12b0d73104e50fe9d67e0f6fe6786e42f79ab6bb8978929bd7e139c6904e8172",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20009"
      ]
    },
    {
      "uid": "zhcn:f70ef7076e6500d6975f31cf",
      "kind": "character_system_text",
      "source_text": "……什么事？",
      "source_fingerprint": "e0e901474453dfd48fb2ad3d9c6e688e8c12049783bde275d447a3d2a92cea41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20010"
      ]
    },
    {
      "uid": "zhcn:5b8d1402310b045aa8deb0e4",
      "kind": "character_system_text",
      "source_text": "……要开始的话，就快点。\r\n会混入杂念的……\r\n……那是无聊的，软弱的心……",
      "source_fingerprint": "9a83d7499d973b6cea732a243a195faf71419419ad7471566f72c8e14a6d02b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20011"
      ]
    },
    {
      "uid": "zhcn:0b7b552049fd4f16599a338b",
      "kind": "character_system_text",
      "source_text": "……是吗，这就是你的想法吗。\r\n合不来呢。和我。",
      "source_fingerprint": "824e8924e9600cf9beb86ab6c0709c6e445740d8c3244331938201de68dad4cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20021"
      ]
    },
    {
      "uid": "zhcn:e03ad14b5ffcc2957d401f01",
      "kind": "character_system_text",
      "source_text": "……请不要和我说话。\r\n……因为我会忍不住轻蔑你的。",
      "source_fingerprint": "26906e3423a2afa124e19a7491936da2af62471093bf8bd723746a784b7554e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20022"
      ]
    },
    {
      "uid": "zhcn:6504469b1e08914fafb3e677",
      "kind": "character_system_text",
      "source_text": "宛如冻结视线所及的一切\r\n——我将在此，展现出\r\n那压倒性的强大。",
      "source_fingerprint": "aae4c17d971132dc96803cf9e8ab93fad198c4291beb6d5d4a7c04646bcc9628",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20023"
      ]
    },
    {
      "uid": "zhcn:ff104682359538997791bdeb",
      "kind": "character_system_text",
      "source_text": "您只要考虑好赛后的\r\n流程就行了。剩下的……\r\n我会带着结果回来的。",
      "source_fingerprint": "f190ce634549fa3d535763483be47d2de3affde03085766fb6de26fd5972fce4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20024"
      ]
    },
    {
      "uid": "zhcn:1c324187339ec2041b3cce79",
      "kind": "character_system_text",
      "source_text": "我不会让任何人追上。我所积累的东西\r\n比任何人都要多……\r\n不容许有任何松懈……！",
      "source_fingerprint": "9fefb1354b08e66974e9a972ab461c8ec3e130fa32043db7782353b3e8678f8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20025"
      ]
    },
    {
      "uid": "zhcn:88a82cfefc1da1c584c95058",
      "kind": "character_system_text",
      "source_text": "剩下的事，我一个人能搞定。\r\n请您去座位上吧。\r\n……您都没怎么休息吧。",
      "source_fingerprint": "17568dc133b87eef83606289f8e11a2088cd89fd67f84faa6752aa366f75d3f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20026"
      ]
    },
    {
      "uid": "zhcn:f3bc18fc6d2d5cbe9dc62e23",
      "kind": "character_system_text",
      "source_text": "我想保持这种状态，\r\n如果有人来搭话，\r\n应对工作就全交给您了。",
      "source_fingerprint": "75e1204578de019affcdc81d6ca19cfe1f01877401716d5f875817f9a206fa92",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20027"
      ]
    },
    {
      "uid": "zhcn:df5eb95ef01c2518b9404ab3",
      "kind": "character_system_text",
      "source_text": "耳机，带了。\r\n歌也存进去了……嗯。\r\n在休息室里也能集中精神了。",
      "source_fingerprint": "e59a66e490d01165a26571e71583c2680ae348c969f022e7aaac03faae68be4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20028"
      ]
    },
    {
      "uid": "zhcn:4349bf2e565b11d1ab55103b",
      "kind": "character_system_text",
      "source_text": "决胜服开线的地方昨晚已经\r\n补好了，也没有快掉的装饰……\r\n看来缝纫套装是用不上了。",
      "source_fingerprint": "18d9d6755c3c38d4960e744bd6e423b417a2378066878c8770c00f1a7b1ce2c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20029"
      ]
    },
    {
      "uid": "zhcn:4afd84faa23e5f3036b4ef8c",
      "kind": "character_system_text",
      "source_text": "状态很充分。\r\n……再加上\r\n我的实力的话……就能达到。",
      "source_fingerprint": "39377fdecddb16c7b7f5beed9c0ee88a80dd0e6fb4825e986272fe27d7ca2996",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20030"
      ]
    },
    {
      "uid": "zhcn:e6d20409ab222f212c70614a",
      "kind": "character_system_text",
      "source_text": "……声援什么的，就免了。\r\n……我该听的话，全都在\r\n训练中听过了。",
      "source_fingerprint": "1308c36cfb5e9cbd75bf1ea34d35e2ea976dd27679d59283672aef5e6a2f0b52",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20031"
      ]
    },
    {
      "uid": "zhcn:5535b1eaad3206dec2f903ee",
      "kind": "character_system_text",
      "source_text": "调整没赶上。\r\n……那又怎样。\r\n唯有获胜。我，无论何时……",
      "source_fingerprint": "d60fc4305b2a42920b44324c1b94c4dd920e610dc413e09c735cdd83d4b48f23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20032"
      ]
    },
    {
      "uid": "zhcn:6999b2a1ca3aa4d5b5038110",
      "kind": "character_system_text",
      "source_text": "……啊啊，震得耳朵疼……\r\n这欢呼声，不能想想办法吗……",
      "source_fingerprint": "392259635f47c7e311882091488d3e7d0c6936946d83adc02945d081c089ad05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20033"
      ]
    },
    {
      "uid": "zhcn:e6e536958d27ff571f8df11b",
      "kind": "character_system_text",
      "source_text": "呼…………——\r\n……走吧。\r\n出战时间可不会等人。",
      "source_fingerprint": "ca5ce1ed4002d58288bdbf3cf48529d7d019f6ae5e7cf330ed59e11b754e836e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20034"
      ]
    },
    {
      "uid": "zhcn:0adea9c75265fc87ee6b7261",
      "kind": "character_system_text",
      "source_text": "……好冷……\r\n……唔，不振作……一点的话……",
      "source_fingerprint": "26e74baaf9f526f214040fe3b9524670ed06f746a80fd12c9e00903d60128653",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20035"
      ]
    },
    {
      "uid": "zhcn:6b8fd99401c41aa81d68b71e",
      "kind": "character_system_text",
      "source_text": "我很强……已经变强了。\r\n毕竟，是这样吧……？",
      "source_fingerprint": "28fb1389407d2f3913d18fe6413caca711b40836eb3112fc7fe7a16d9731c953",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20036"
      ]
    },
    {
      "uid": "zhcn:4298dd903607b2b0670c41bd",
      "kind": "character_system_text",
      "source_text": "赢，赢，赢……！\r\n赢赢赢……！\r\n……唔，我，一定能赢的……！",
      "source_fingerprint": "2da06b16cffaa40cce780045f8520fa32b108768c0efb0aca7f5e2ef65c12a80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20037"
      ]
    },
    {
      "uid": "zhcn:9e4a779804f168bdf4add09a",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20038"
      ]
    },
    {
      "uid": "zhcn:70bcd17e195a71993816492f",
      "kind": "character_system_text",
      "source_text": "哈啊……！",
      "source_fingerprint": "7e71c83007cb4102d68fd4f343d2c98d7d1fb25c41be4fdeb173ca7eda918d7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20039"
      ]
    },
    {
      "uid": "zhcn:1073ba8488a7fb7b4affd02c",
      "kind": "character_system_text",
      "source_text": "嗯。",
      "source_fingerprint": "5c7a9f97adb5bed9d4c6aca666dffd0e37fda970ebcfc2c8c0060523a483e295",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20040"
      ]
    },
    {
      "uid": "zhcn:7757250d266c4f4f82d9ba0e",
      "kind": "character_system_text",
      "source_text": "哼……",
      "source_fingerprint": "f21bed79927e5236d335292545e9ebd0f5f41ee49249a49856519a27ee9095c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20041"
      ]
    },
    {
      "uid": "zhcn:feb61d9b14c1f80146be8819",
      "kind": "character_system_text",
      "source_text": "呃！？",
      "source_fingerprint": "1ea67438b42beba60fa787e249a61303034c569b4024749cf2d8f0cab75af1cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20042"
      ]
    },
    {
      "uid": "zhcn:23229b4de98f70b539b3962f",
      "kind": "character_system_text",
      "source_text": "头……",
      "source_fingerprint": "cf5b60b53a3f1bbf49d00d40c89fe4f8a57b24c00739201f3ff1f6193b1e0729",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f45422b7b2f7485133d942a4",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20046"
      ]
    },
    {
      "uid": "zhcn:0bb8722a5fb24b2d580420da",
      "kind": "character_system_text",
      "source_text": "真拿你没办法。",
      "source_fingerprint": "c917649c9190b4e2d17ebadc1dbb3b64de54e83235018a44dc92cc3e8a67f641",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20047"
      ]
    },
    {
      "uid": "zhcn:ed6cf7428447d4844bedbaf4",
      "kind": "character_system_text",
      "source_text": "感谢您的观看……",
      "source_fingerprint": "61d0ddf7b3dc24fe4884e53a06e0af7eab007cd10d9138b1f0bb37e3813718b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20049"
      ]
    },
    {
      "uid": "zhcn:50e26966d31f0d92e3c865c3",
      "kind": "character_system_text",
      "source_text": "受您照顾了。",
      "source_fingerprint": "9c26dbd47850b3db4af939815161583cd3f5cd1c566fc5cad29ffbdb9e899aab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20050"
      ]
    },
    {
      "uid": "zhcn:a1abb0f2a46baa5cf0026a05",
      "kind": "character_system_text",
      "source_text": "干脆利落地解决掉吧。",
      "source_fingerprint": "db6e13c595863f9e5b61f1152cb875b8dffa6665b98361022fa4d1fa373e7737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "20051"
      ]
    },
    {
      "uid": "zhcn:c29db7a7aad620a11209fdc3",
      "kind": "character_system_text",
      "source_text": "……快点结束吧。",
      "source_fingerprint": "021787757c33b7bd391462d2273eff62752824bede31e96ec11ae13a32ee948c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "2030"
      ]
    },
    {
      "uid": "zhcn:05a9e436162217c3ad80b080",
      "kind": "character_system_text",
      "source_text": "请多关照……",
      "source_fingerprint": "76e546beb607c78391a13a35fae42de155540fc89abd524192b761dd1d1f1747",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "2031"
      ]
    },
    {
      "uid": "zhcn:26c16cc8c140ae6e807e009b",
      "kind": "character_system_text",
      "source_text": "受您照顾了。",
      "source_fingerprint": "9c26dbd47850b3db4af939815161583cd3f5cd1c566fc5cad29ffbdb9e899aab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "2032"
      ]
    },
    {
      "uid": "zhcn:168955c0caa503fe1c2882da",
      "kind": "character_system_text",
      "source_text": "耳机，带了。\r\n歌也存进去了……嗯。\r\n在休息室里也能集中精神了。",
      "source_fingerprint": "e59a66e490d01165a26571e71583c2680ae348c969f022e7aaac03faae68be4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "2033"
      ]
    },
    {
      "uid": "zhcn:0927dfd8b610c5aa3ee9c61d",
      "kind": "character_system_text",
      "source_text": "我不会让任何人追上。我所积累\n的东西比任何人都要多……\n不容许有任何松懈……！",
      "source_fingerprint": "a2f288cc33700456d24a9187eacafb2c9c5fb6436a17d3b264e57f7d117c652d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "2034"
      ]
    },
    {
      "uid": "zhcn:7fa54867cfbabc99f6166148",
      "kind": "character_system_text",
      "source_text": "受您照顾了。",
      "source_fingerprint": "9c26dbd47850b3db4af939815161583cd3f5cd1c566fc5cad29ffbdb9e899aab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "2035"
      ]
    },
    {
      "uid": "zhcn:688286336393d17ace39838e",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "23015"
      ]
    },
    {
      "uid": "zhcn:541e39012387d1d5b75ded3f",
      "kind": "character_system_text",
      "source_text": "……为什么，在眼前错失了……！",
      "source_fingerprint": "c2fa97b47d0294ffd794c2c461942b39adee603a771863342c718b3b39e5e2db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "30000"
      ]
    },
    {
      "uid": "zhcn:4872310e14a80b0e971d435f",
      "kind": "character_system_text",
      "source_text": "第3名……真是，难看。",
      "source_fingerprint": "9507bbab7703068aced17e7989df59a7bd675c0de184731b947b020e06345195",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "30001"
      ]
    },
    {
      "uid": "zhcn:57cb52888e54ad56df72f44f",
      "kind": "character_system_text",
      "source_text": "太不像话了……",
      "source_fingerprint": "1127a1c722f9b799402b702c7f6492b7e778b76fd051cb057b17d45a0d6c61d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "30002"
      ]
    },
    {
      "uid": "zhcn:6b8b8d8174dfec000f2b0e00",
      "kind": "character_system_text",
      "source_text": "不可原谅……这样的话，我……！",
      "source_fingerprint": "6259a7a0ee0a67539b242aa91a126cfacd18dd9ad7e439ced6bac194a9ab6b48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "30003"
      ]
    },
    {
      "uid": "zhcn:076ab192399a157d83a1fe96",
      "kind": "character_system_text",
      "source_text": "能达到至高境界的只有一人——那就是我。",
      "source_fingerprint": "9247b9a44c5bdb2ecd990ca3d79a94d342f4174cc617eed103a97168a48cf618",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "30004"
      ]
    },
    {
      "uid": "zhcn:cf196f6b54f47522ccf59461",
      "kind": "character_system_text",
      "source_text": "胜利是理所当然的。要强大到，能让人产生这种想法的程度……！",
      "source_fingerprint": "0b87e7253a91e2844635af31da84df8c3d41b704f4dda66d677d8b5f48c472fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "30005"
      ]
    },
    {
      "uid": "zhcn:a2eea6ca29e0ec0acd34972d",
      "kind": "character_system_text",
      "source_text": "我只要全部赢下就好。",
      "source_fingerprint": "67f370e797cb395ab9d5de671689580fd2feb1726fff67e52a8207baab568a0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1118",
        "31000"
      ]
    },
    {
      "uid": "zhcn:36556f6c2d625abea0b6ca93",
      "kind": "character_system_text",
      "source_text": "来吧，尽情颤抖吧。",
      "source_fingerprint": "018a4cca605cfccfa6eac8c4a364aa8c92bb04dabe5b907fb70d32a04f9b0aa9",
      "source_path": "character_system_text_dict.json",
