        "400012"
      ]
    },
    {
      "uid": "zhcn:0b1197ddf8d7761038fac240",
      "kind": "character_system_text",
      "source_text": "辛苦啦～☆诶，这不是\r\n超努力了吗？是不是也太棒了？\r\n送你一个飞吻～。啾哇♡",
      "source_fingerprint": "23f49277d8a7bf62b2a35231553cc226103bd2c797e04d7ec60bf0990e1ad78f",
      "source_path": "character_system_text_dict.json",
