      ]
    },
    {
      "uid": "zhcn:5162e3fee8ecc005f753affa",
      "kind": "character_system_text",
      "source_text": "呵……\n后背看起来也天才般的可爱吧？",
      "source_fingerprint": "d1732664a65f16b588056f57eb14eeef4bb2fbe092ba5c553204704111afd568",
