    {
      "uid": "zhcn:c81d2ea0a324dec2f5878848",
      "kind": "character_system_text",
      "source_text": "系蝴蝶结我超拿手的♡",
      "source_fingerprint": "291dee1fab34d37e20b1550641538a59f8bac568ff30aaeff3e334c2c2621510",
      "source_path": "character_system_text_dict.json",
