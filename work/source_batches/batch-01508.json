    {
      "uid": "zhcn:cdf8854b243a7d8d1fcc48c0",
      "kind": "character_system_text",
      "source_text": "欸嘿♡可爱吗？我懂~♡♡",
      "source_fingerprint": "e9182b72275de74c7e7bb90e810ed1c83f47f65b99526c96d7dc008f8fc0fc7e",
