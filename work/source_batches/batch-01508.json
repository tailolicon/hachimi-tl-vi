      "source_text": "天才少女・房一潘多拉闪亮登场♡",
      "source_fingerprint": "212200ac7f29064ae3fcbcc29ed6190d8be772c3c58845f13a876f379f06308f",
      "source_path": "character_system_text_dict.json",
