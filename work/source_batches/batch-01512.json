  "entries": [
    {
      "uid": "zhcn:db173c1e056b489059787ce0",
      "kind": "character_system_text",
      "source_text": "最高速へ。",
      "source_fingerprint": "3013dca86d81a72837206f7803a617f6ddf6ffc109dc58b9970e8314eca2d8d6",
      "source_path": "character_system_text_dict.json",
