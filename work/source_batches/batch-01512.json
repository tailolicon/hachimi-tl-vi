      ]
    },
    {
      "uid": "zhcn:e5cc6313533ea89c93232b18",
      "kind": "character_system_text",
      "source_text": "最高速でいく。",
      "source_fingerprint": "4cf00ed6fef3144ad4935d9c59ddd6df1f47c8a7dc4e25d0ba5b6ed955652aba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "1213"
      ]
    },
    {
      "uid": "zhcn:61f60f9b5748015a56fbfd7c",
      "kind": "character_system_text",
      "source_text": "本日のログインボーナスは\r\nこちらです。",
      "source_fingerprint": "1750f99ce5e11edad2e11b11c022f44281faa43563f05538560f4ab69a26f77a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "13"
      ]
    },
    {
      "uid": "zhcn:54d1ec21682792f59bd466dd",
      "kind": "character_system_text",
      "source_text": "さぁ、取りまくりです！",
      "source_fingerprint": "b4c1a7fd7f75f777487f0d665829e5b1303c3b423bf4d34d2842c61d58204181",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140000"
      ]
    },
    {
      "uid": "zhcn:05064c92fb6ba5a983b6206d",
      "kind": "character_system_text",
      "source_text": "きたきたっ！",
      "source_fingerprint": "f848205bf9aca04d64b9835013ddb03c62b42ba392cba47179073512b942803e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140001"
      ]
    },
    {
      "uid": "zhcn:228607eee5b3867e2ca8a238",
      "kind": "character_system_text",
      "source_text": "くっ…！",
      "source_fingerprint": "5bca6da8ecb6aaeab02e5a22863fa5110f97d666065235a519e4697647e7f875",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140002"
      ]
    },
    {
      "uid": "zhcn:ee6abb9f20ebaec70017636d",
      "kind": "character_system_text",
      "source_text": "やっほーー。",
      "source_fingerprint": "97b43d52a5426622ab228edd553f61026dc518609642da41494736bc42573dfd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140003"
      ]
    },
    {
      "uid": "zhcn:4b69cc2ffbb2eebf5bf43296",
      "kind": "character_system_text",
      "source_text": "フッ、なかなかですね。",
      "source_fingerprint": "850c26390e805f6052c637ea656c459182d7c06f16148deeb53c0df8d8736bf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140004"
      ]
    },
    {
      "uid": "zhcn:e32e5805310f1a76f5e2a02f",
      "kind": "character_system_text",
      "source_text": "気を落とさず。",
      "source_fingerprint": "768ca619c4fd13990cf304edb438c84da1f15a6f7e85cb98f1db4a1a8b162634",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140005"
      ]
    },
    {
      "uid": "zhcn:41c2e559ba6c491b3ab6ecdb",
      "kind": "character_system_text",
      "source_text": "やっほーー。",
      "source_fingerprint": "97b43d52a5426622ab228edd553f61026dc518609642da41494736bc42573dfd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140006"
      ]
    },
    {
      "uid": "zhcn:4f398742b36991d639c5d3b6",
      "kind": "character_system_text",
      "source_text": "フッ、なかなかですね。",
      "source_fingerprint": "850c26390e805f6052c637ea656c459182d7c06f16148deeb53c0df8d8736bf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140007"
      ]
    },
    {
      "uid": "zhcn:638d0394fa7028318413c9cc",
      "kind": "character_system_text",
      "source_text": "フッ。",
      "source_fingerprint": "caed08f480c9dfbce59cfe623a2b1d7feafa2d5ab231e00d7c2c7d2c984c48b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140008"
      ]
    },
    {
      "uid": "zhcn:e6fcbba3e658e6fc4d6c45aa",
      "kind": "character_system_text",
      "source_text": "行きましょう。",
      "source_fingerprint": "6a651bfb029986fd12b0df87899450e7dfee294261171c169759f9164b1f855f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140009"
      ]
    },
    {
      "uid": "zhcn:b3322158e156d239a65d8322",
      "kind": "character_system_text",
      "source_text": "速攻あるのみ！",
      "source_fingerprint": "898313a14d8a7e521fd4373ed80cc95335fa17d9e6199c75445a923a5e8dc43d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140010"
      ]
    },
    {
      "uid": "zhcn:e54f3fc2e2fe857cbb0b7f00",
      "kind": "character_system_text",
      "source_text": "激熱です！",
      "source_fingerprint": "d8aa118fce677f8405ec91e8f479ad4d610862dcd782e58f861845ac2948afae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140011"
      ]
    },
    {
      "uid": "zhcn:3bf6cb1f6a59549fed3a9528",
      "kind": "character_system_text",
      "source_text": "来た来た来たぁ！",
      "source_fingerprint": "11eb70032b8e06feed46a313a03f5d1330c078adb746f665a8b6f19bc06588d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140012"
      ]
    },
    {
      "uid": "zhcn:37c991ee88aa7c4edb9ddca5",
      "kind": "character_system_text",
      "source_text": "一気ぃ！",
      "source_fingerprint": "c93caaa4e3ac628ff5dfd1889d7010dd0c7a604e22b9ab5f9e059839066cf86e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140013"
      ]
    },
    {
      "uid": "zhcn:f277a135d08101b9a645c57a",
      "kind": "character_system_text",
      "source_text": "なっ！？",
      "source_fingerprint": "f2d8bfa60dd0b93804b6f0e1b99dfc49d01cebafd6dac9df7fd909eb89d81055",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140014"
      ]
    },
    {
      "uid": "zhcn:63673c378ef6c4b0211a56b6",
      "kind": "character_system_text",
      "source_text": "ガバッと！",
      "source_fingerprint": "19b66f8cc0b05f6d524aa9e255d0f6611d413b1eb0ff17bf216a3c2ef8f86ea2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140015"
      ]
    },
    {
      "uid": "zhcn:2d32f88f527d5cc26ddaf825",
      "kind": "character_system_text",
      "source_text": "さぁ速く！",
      "source_fingerprint": "61a7d60bb219d54f29392c6d485efb954ed9936463d3140fc33618b156c49fde",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140016"
      ]
    },
    {
      "uid": "zhcn:c661b2d57f288da75474eea1",
      "kind": "character_system_text",
      "source_text": "ああっ！？",
      "source_fingerprint": "4e6cafc8a40a4267b54b70088ec0d17da7ee81c023edd73f2bd686b814c132ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140017"
      ]
    },
    {
      "uid": "zhcn:e4430562204e34a348cb4fcc",
      "kind": "character_system_text",
      "source_text": "さらば！",
      "source_fingerprint": "c8c710fb34c84ac3b0a6b571a165e586f491aac0a5c9b1807ad6e83c90eaad82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140018"
      ]
    },
    {
      "uid": "zhcn:cb5718082735f7f9f4181170",
      "kind": "character_system_text",
      "source_text": "明日はこちらが。\r\nくっ、早く欲しい！",
      "source_fingerprint": "61df293a4507d69df010123c24cf0b53c916b8c291e66d2f16490378c1e689a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "15"
      ]
    },
    {
      "uid": "zhcn:a58473473d3cc39af5cbbc7d",
      "kind": "character_system_text",
      "source_text": "はい。ふらふらです。\r\n仮眠用布団は持ってきているので、\r\nいつでも最速で横にはなれますが？",
      "source_fingerprint": "ad8887a4cf6a84c01aba86bcbcc1262a32804288c92a6da78bc744b7a9dc9a89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20000"
      ]
    },
    {
      "uid": "zhcn:2bb4b2a8521ceb3f97f5dfa2",
      "kind": "character_system_text",
      "source_text": "ぐぅぅぅぉぉぉぉぉ…！\r\nはっ、いかん！光速で\r\n寝落ちしてしまった…！",
      "source_fingerprint": "6af9114da653cca98e9b09a03af277bfd00fc3e7cca7f6236aa21403ff4339d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20001"
      ]
    },
    {
      "uid": "zhcn:c5bdf3e44e4295e7e98054bf",
      "kind": "character_system_text",
      "source_text": "フッ、貴方が来る前にガゼル、\r\nキリン、パタスモンキーを倒して\r\nしまいましたよ。脳内レースで。",
      "source_fingerprint": "adf6b75ba7dac24bfb4b93361f6d339504ef06d4ec49c016061ee884fe8f712a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20002"
      ]
    },
    {
      "uid": "zhcn:176c46b2d7b8970cfcdc900c",
      "kind": "character_system_text",
      "source_text": "私のやる気グラフはぐんぐん\r\n斜め上！今日も己の最高速を\r\n塗り替えていきますよ！",
      "source_fingerprint": "1352c69792f4417aaf89128c87f8bbb5e7a46c3fd62cbff827f3583911c1e22b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20003"
      ]
    },
    {
      "uid": "zhcn:8253456c5a6555ebfc7aa646",
      "kind": "character_system_text",
      "source_text": "髪直線、折り目も直線、\r\nやる気はもちろん一直線！\r\n始めましょう、トレーナー！",
      "source_fingerprint": "2bd7ebbd7d129c08f31eb86118a919ef01d1a49cd0c2a203ff52caa460edcb69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20004"
      ]
    },
    {
      "uid": "zhcn:1fd6c8f1dbb545c9ac6efaa9",
      "kind": "character_system_text",
      "source_text": "トレーナー、私の姿は見えて\r\nいますか？よかった、知らぬ間に\r\n光速になっちゃってたかな、と。",
      "source_fingerprint": "b2be69a95551dcb980c283e116e23f07b7ce6b278075a5c89c8a6a5d4a0f1f5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20005"
      ]
    },
    {
      "uid": "zhcn:27f2ccd321d004e402d0996a",
      "kind": "character_system_text",
      "source_text": "気づいたら体がウォーミング\r\nアップを済ませていましたよ。\r\n私の体は思考をも置き去りにする。",
      "source_fingerprint": "61440ba67771b876529fe4448c3a876f7b8a1d693b38761f9a86cabfbc227c39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20006"
      ]
    },
    {
      "uid": "zhcn:f8431b8d941641ed2d9c2bc3",
      "kind": "character_system_text",
      "source_text": "太陽光線…いつか、お前の\r\n速さも超えてみたいものだ。",
      "source_fingerprint": "6584e698f11547ee955cf6970e724ac6e459c824361bd9e8eae324f670dc3640",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20007"
      ]
    },
    {
      "uid": "zhcn:7e15cbc1ab4f21d52bade3b0",
      "kind": "character_system_text",
      "source_text": "私のモチベが垂直落下…！\r\nくっ、ここは曲線に堕ちようと\r\n上向きへ回復を狙うべきか…。",
      "source_fingerprint": "41da222b9f97bd007be0f6d5c12b2b664ca0cc2748da3c4de3c537903bd8f543",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20008"
      ]
    },
    {
      "uid": "zhcn:f4bbede2ef7b0e6dce570300",
      "kind": "character_system_text",
      "source_text": "どうも気分が…くっ…、昨日\r\n割りばしを真っ直ぐ割れなかった\r\nのを引きずっているのか…私！？",
      "source_fingerprint": "b45d10847e497c6d415ec0adc8051e7557c394d68d2d66cb92221974c84d922f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20009"
      ]
    },
    {
      "uid": "zhcn:38a894c8b22fe5beceffbc0a",
      "kind": "character_system_text",
      "source_text": "今の私は亀…いや、ナマケモノ。\r\nはたまた秒速0.04cmしか出ない\r\nタツノオトシゴ…？な気分です。",
      "source_fingerprint": "97ea560c56fba39f2e6405dca0acefa5fd226bd3de6759e38428d2f4daec8fd0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20010"
      ]
    },
    {
      "uid": "zhcn:b58436c632badcc9d8b56647",
      "kind": "character_system_text",
      "source_text": "…いや、私はいつも通りです。\r\nただ体が重くて気も重くて脚も\r\n重くて思うように走れないだけで。",
      "source_fingerprint": "1f4ab42c58f7e7a8b6be2f2e94037c2802c74e73723a91f3570f25932587a000",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20011"
      ]
    },
    {
      "uid": "zhcn:9701348217ba34dea673dadf",
      "kind": "character_system_text",
      "source_text": "またレースですか…いえ、そろそろ\r\n休みましょう。なんなら温泉。\r\nなんなら脚揉み120分コース。",
      "source_fingerprint": "6cd78803cebf264fbc0efd1195cdead748efe48495cafe817920be63cded852e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20021"
      ]
    },
    {
      "uid": "zhcn:368e9a0405265fd42f7f78b8",
      "kind": "character_system_text",
      "source_text": "出走しすぎでへとへとです。\r\n今は眠りたい。横になりたい。\r\nなにも考えずゴロゴロしたいーっ！",
      "source_fingerprint": "f7bb4b47f0e6972ffbb8ed3eff5dc9fd2162697a34dc224977e8108d4872e7ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20022"
      ]
    },
    {
      "uid": "zhcn:389de46ecacef13de10a2a85",
      "kind": "character_system_text",
      "source_text": "地球最速の生物とは誰か。\r\nまさに今日、それが\r\n決まることでしょう！",
      "source_fingerprint": "4fe8e7f762147ff8a0578d870894c51011ec6f5c0338f3fe0a91dc7a14724357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20023"
      ]
    },
    {
      "uid": "zhcn:00f8e009b237cfd981a51a34",
      "kind": "character_system_text",
      "source_text": "今こそターフに刻んできます。\r\n光の軌跡…摩擦で消えない足跡を！",
      "source_fingerprint": "4428557895258daf069ce71b36dbfddb30de4cb27387fd833eda4dfcd718c493",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20024"
      ]
    },
    {
      "uid": "zhcn:bfae9444ecaff9fff1a62157",
      "kind": "character_system_text",
      "source_text": "いくら眩しくても目は閉じないで\r\nください。今日お見せするのが\r\n光速を超えた、私の最高速です！",
      "source_fingerprint": "4d57990bc9eb7a96973cd4c618293c550518d4ede6ea6c968a3f44c9fea3230e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20025"
      ]
    },
    {
      "uid": "zhcn:cafde63b7922042c8ce48dad",
      "kind": "character_system_text",
      "source_text": "フッ、今日のお客さんは幸運だ。\r\n誰も見たことのない速さ、\r\nそのお目目に刻むといい！",
      "source_fingerprint": "6e4dad56e2c96b554159f184ec3e54662f430dcfabec838213268309195a3b42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20026"
      ]
    },
    {
      "uid": "zhcn:9d48f2589fed3d64a0bc234c",
      "kind": "character_system_text",
      "source_text": "うーむ、心配です。…私、速すぎて\r\nカメラに映らないのでは、と…。",
      "source_fingerprint": "7145f2b0c14f5a28f8e04c4d0f19649fe35e6dc560dbb3c3c4e56346c68a9730",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20027"
      ]
    },
    {
      "uid": "zhcn:34c57bd9d87386ad5ed26f31",
      "kind": "character_system_text",
      "source_text": "少し気合いを入れます。\r\n…やってやるぜぇぇぇ！\r\nうん。いい感じです。",
      "source_fingerprint": "22b08c5f538325e35fd18d6fc03671ed1e534b0987a69a8276411743316988bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20028"
      ]
    },
    {
      "uid": "zhcn:1e1e560cfd2776b7bc6571c4",
      "kind": "character_system_text",
      "source_text": "心配はありません。勝利後\r\nインタビューで語る内容は\r\nきっちり暗記してますから。",
      "source_fingerprint": "3d126790334c014c614ab6f4892d4c051ef1d6e302e6c0116e38416f7b1a0288",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20029"
      ]
    },
    {
      "uid": "zhcn:10af0cdaa89af7ba9cdce256",
      "kind": "character_system_text",
      "source_text": "ついに来ましたね。\r\n今日こそ光となる時。",
      "source_fingerprint": "2a7ef224e62dd1386e9fb371d159c227f230e6d46af371d90c229ca9c1e9da39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20030"
      ]
    },
    {
      "uid": "zhcn:98fa3cb87aa55f062c48101c",
      "kind": "character_system_text",
      "source_text": "目指すは最高速一直線。\r\n私の速さで度肝を抜いてきます！",
      "source_fingerprint": "c054046faf16d21ac6a48bb6381d7bacca35d48283910e82e9cd282f91398c75",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20031"
      ]
    },
    {
      "uid": "zhcn:45443d51f5288702a0920e06",
      "kind": "character_system_text",
      "source_text": "多少の不調は関係ないです…。\r\n一直線はお任せを。一直線は…。",
      "source_fingerprint": "1f1527a290f67a0abfdfa073b9da7e9da9934d3f504e7ab9c0ac45aa8961e73a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20032"
      ]
    },
    {
      "uid": "zhcn:907a96a524a9caad115b7575",
      "kind": "character_system_text",
      "source_text": "今は少しでも速くなれるイメージが\r\n必要。ここはプロングホーン…いや\r\nチーターのイメトレで…ぐるるる。",
      "source_fingerprint": "996b11c2c0f0e09783b244b9c0a942140eb67e5034ca6218fb697bdf263fab88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20033"
      ]
    },
    {
      "uid": "zhcn:d994e6083438929fe71d9a27",
      "kind": "character_system_text",
      "source_text": "目指す光は、まだ見えている…！\r\nならば追いついてみせるのみ！",
      "source_fingerprint": "56f1913d59bed8c3e2fbfefa972d954cb5870660a5d458b0bbf73a072e87455d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20034"
      ]
    },
    {
      "uid": "zhcn:d19ec90ca8f9d0e6c8bffc41",
      "kind": "character_system_text",
      "source_text": "今の私を、脳内アニマルたちが\r\n嘲笑っている…！脳内コヨーテや\r\n脳内ヌーが…！負けてたまるか！",
      "source_fingerprint": "b0ca0faad3f821023a4c6d7a0413c9e9ef66efa1456d6f5d9a99667459d0f3c8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20035"
      ]
    },
    {
      "uid": "zhcn:de8660d1ae8d5ce0d8d4a47c",
      "kind": "character_system_text",
      "source_text": "歩きすらふらふら曲線状態！？\r\nくっ、トレーナー、直線コールを！\r\n私は直線、一直線！…はい！",
      "source_fingerprint": "06c8815555dd9ff15ec16c2e373806fa024bee1813a56ceaaa3101f92985ae5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20036"
      ]
    },
    {
      "uid": "zhcn:34816c0aec99177f7657e3e6",
      "kind": "character_system_text",
      "source_text": "万全でなくていい…\r\n直線…直線ですべてを\r\n突き放せさえすれば…っ！",
      "source_fingerprint": "3583ad0bd5e5e165412b391193f4bcd0c3fafdf5b57995f26f4d9103ed888245",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20037"
      ]
    },
    {
      "uid": "zhcn:3684a38e340741c7bc980627",
      "kind": "character_system_text",
      "source_text": "えいや！",
      "source_fingerprint": "09c33cfeacb7dab7382d653749354a5e37ccd559003c543d3044ab2d364e9500",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20038"
      ]
    },
    {
      "uid": "zhcn:9c28fd1724bfcadc0adc72b4",
      "kind": "character_system_text",
      "source_text": "うぉぉ！",
      "source_fingerprint": "a17115eca75a1845b4e8ee62c215c5c0454e812f070fe1d5d11a892eb7834ad1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20039"
      ]
    },
    {
      "uid": "zhcn:1a1276d54ce22af73b008d52",
      "kind": "character_system_text",
      "source_text": "いくぞ！",
      "source_fingerprint": "cba7776c7f432b141e5a619b9f8e42077ad110b65fd916413b0b5d7b49ddc152",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20040"
      ]
    },
    {
      "uid": "zhcn:5aff81efcd5289597b063f22",
      "kind": "character_system_text",
      "source_text": "余裕！",
      "source_fingerprint": "4339a5cc600cae21fa23e4176ce6559833bfc94768db4825f944029f9ae09f22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20041"
      ]
    },
    {
      "uid": "zhcn:c9850bd6ab9562806b70ca69",
      "kind": "character_system_text",
      "source_text": "なにっ！？",
      "source_fingerprint": "be4736805c0fc356b99e1810165d4dc458af6a94f60de28e41227a506b81823d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20042"
      ]
    },
    {
      "uid": "zhcn:47c75ecb258d9fc532813dd8",
      "kind": "character_system_text",
      "source_text": "わからん！",
      "source_fingerprint": "673119318ade9ce0d3dde8991e283aab6b1eaed52dbaaeac622f20eed952120b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20043"
      ]
    },
    {
      "uid": "zhcn:0375c6c23aed8d431be634d7",
      "kind": "character_system_text",
      "source_text": "早く速く！",
      "source_fingerprint": "55594fd14d198a4416c5fcfdc69aa3780dc340d8884302ff1f1a038fafd24919",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20046"
      ]
    },
    {
      "uid": "zhcn:005ca87d864317ff89bf46d2",
      "kind": "character_system_text",
      "source_text": "ばっしゃぁーん！",
      "source_fingerprint": "d4a1ea63a6afd1b0a09d6da3100f5c34e8124cd8334ac75ca0df750433ea7364",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20047"
      ]
    },
    {
      "uid": "zhcn:2cd4467728bffc54ee8424a6",
      "kind": "character_system_text",
      "source_text": "ご一緒した時間、光のように輝いていました。",
      "source_fingerprint": "b818a8d714d85432f26ca814c01d8c2e0a758f64d52cb12c9ca73b810ccd0ee4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20049"
      ]
    },
    {
      "uid": "zhcn:9a2f1389d745949db13c65ce",
      "kind": "character_system_text",
      "source_text": "ご指導ありがとうございました！",
      "source_fingerprint": "fce8804b80bc4bca14c035bc8af214a3c6ee66d8fe782a65cc55a5925d0f5389",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20050"
      ]
    },
    {
      "uid": "zhcn:7a5fc861874ce4382c70ee0b",
      "kind": "character_system_text",
      "source_text": "では…加速ッ！",
      "source_fingerprint": "6725ac44f271c41ac62edfcdddbc622404c5130f527fd09f6d667a8d777db92e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "2030"
      ]
    },
    {
      "uid": "zhcn:cbab7746aa7d2a1c90e21ea0",
      "kind": "character_system_text",
      "source_text": "行くぞ、光速チーム！",
      "source_fingerprint": "9c955ae95e6e2086698d4cc336236c5d6ac0f72121160ae0d496d3ac278b8148",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "2031"
      ]
    },
    {
      "uid": "zhcn:f9d9162b4fc6d1e53dd5b436",
      "kind": "character_system_text",
      "source_text": "ご指導ありがとうございました！",
      "source_fingerprint": "fce8804b80bc4bca14c035bc8af214a3c6ee66d8fe782a65cc55a5925d0f5389",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "2032"
      ]
    },
    {
      "uid": "zhcn:9f2bdc2a93fdcafad6e354f4",
      "kind": "character_system_text",
      "source_text": "少し気合いを入れます。\r\n…やってやるぜぇぇぇ！\r\nうん。いい感じです。",
      "source_fingerprint": "22b08c5f538325e35fd18d6fc03671ed1e534b0987a69a8276411743316988bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "2033"
      ]
    },
    {
      "uid": "zhcn:a0d076bc1696c80738c9d463",
      "kind": "character_system_text",
      "source_text": "いくら眩しくても目は閉じないで\r\nください。今日お見せするのが\r\n光速を超えた、私の最高速です！",
      "source_fingerprint": "4d57990bc9eb7a96973cd4c618293c550518d4ede6ea6c968a3f44c9fea3230e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "2034"
      ]
    },
    {
      "uid": "zhcn:f300bf26e73d3c2231bce7ae",
      "kind": "character_system_text",
      "source_text": "ご指導ありがとうございました！",
      "source_fingerprint": "fce8804b80bc4bca14c035bc8af214a3c6ee66d8fe782a65cc55a5925d0f5389",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "2035"
      ]
    },
    {
      "uid": "zhcn:6ef67406c388f39dd1782e88",
      "kind": "character_system_text",
      "source_text": "いくぞ！",
      "source_fingerprint": "cba7776c7f432b141e5a619b9f8e42077ad110b65fd916413b0b5d7b49ddc152",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "23015"
      ]
    },
    {
      "uid": "zhcn:21d062cb2a2765e17e7dd1dd",
      "kind": "character_system_text",
      "source_text": "いける…次こそ、光の先へ！",
      "source_fingerprint": "edb3d75ce480aa06c7d1368f583b29e2078fe84f0a43302660e700c1f6dca36e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "30000"
      ]
    },
    {
      "uid": "zhcn:e93981ec293f36f371ad8100",
      "kind": "character_system_text",
      "source_text": "光は、見えた…！",
      "source_fingerprint": "e26fa96cdc78580edf5b60625830df80537845447d1778221fb2618a4c6fecc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "30001"
      ]
    },
    {
      "uid": "zhcn:5ab5d17526aa6e2075441b5d",
      "kind": "character_system_text",
      "source_text": "最高速には至らず、か…！",
      "source_fingerprint": "028bbbb62559c59b214ce3b31759aba27a1e683fe13c840ea86f485da32bf866",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "30002"
      ]
    },
    {
      "uid": "zhcn:549d00a33d5df81fe2dbe5df",
      "kind": "character_system_text",
      "source_text": "く…これではインパラにも笑われる…！",
      "source_fingerprint": "01080e97ab372d07d706a8839aac278e08260d03fc09b9a9847388fbe5a0bf7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1891a20ff64672bb11f1d3c4",
      "kind": "character_system_text",
      "source_text": "見えた。光を超えた世界…！",
      "source_fingerprint": "05c5630a1ef9e942000d76a129b988b98f3efe46f7d659ddfaf99043b8fc6b14",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "30004"
      ]
    },
    {
      "uid": "zhcn:b6d2d3bcb5f81a53aea591f1",
      "kind": "character_system_text",
      "source_text": "フッ、捉えられたかな。これが光の速さ！",
      "source_fingerprint": "aa285f8548615a98f4dc4949664fd22fb39b68676772bfa2d2d7de4867a99e20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "30005"
      ]
    },
    {
      "uid": "zhcn:2986c4aac15fe308115fa331",
      "kind": "character_system_text",
      "source_text": "最高速へ！",
      "source_fingerprint": "74602b5a3c6a768f3357faf413bdfe3adf2939e51265640c82e5aceb15b4f6f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "31000"
      ]
    },
    {
      "uid": "zhcn:d9fed72ea645f8f975b52b6c",
      "kind": "character_system_text",
      "source_text": "光より…速くッ！",
      "source_fingerprint": "4bb271a66ae58c32441a9e4386142fc81c94991842e8b583cb186dfbdfbf2af3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "40000"
      ]
    },
    {
      "uid": "zhcn:8afcc05b25f96e3a8d834d21",
      "kind": "character_system_text",
      "source_text": "風よりも、音よりも、光よりも…私はッ！\r\n…速い。",
      "source_fingerprint": "a8c5704120e56573fc581c45c75f96cdbcf1d0924ebd122964f445e6467efd92",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "40001"
      ]
    },
    {
      "uid": "zhcn:82941faec616a3d6fc8cf18b",
      "kind": "character_system_text",
      "source_text": "フ、ステージの上にも光跡を残してくるか。",
      "source_fingerprint": "1e5fd3ca344ec15eb9dda6f9ba21ca679869c62747e65e64649fef95bf03a2e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "60000"
      ]
    },
    {
      "uid": "zhcn:9c36e3bb68b05ed83a060c24",
      "kind": "character_system_text",
      "source_text": "皆さんに見てもらいます！ビカビカに輝く私を！",
      "source_fingerprint": "31240a463116ea9c7abf6e6e5bc0c8dd820fb9d6599689fab886e91650d4b931",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "60001"
      ]
    }
  ]
