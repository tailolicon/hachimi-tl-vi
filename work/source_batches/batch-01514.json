    {
      "uid": "zhcn:e17264485e48832a6c595d5e",
      "kind": "character_system_text",
      "source_text": "真是精彩！",
      "source_fingerprint": "a6538069df50f1be843a848911fef6896479375c55f6d784871a87f4cf9d1c7f",
      "source_path": "character_system_text_dict.json",
