      ]
    },
    {
      "uid": "zhcn:1b89cfd0dd2fafa66d9191a6",
      "kind": "character_system_text",
      "source_text": "不用担心。",
      "source_fingerprint": "109117d1692ff2a558db40bef24c9a0a7a4205953005231a567f620037c16247",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140009"
      ]
    },
    {
      "uid": "zhcn:bb8ed9ee001cde7e2ef71701",
      "kind": "character_system_text",
      "source_text": "哦……",
      "source_fingerprint": "12a5d2b3593df4ba0e0d2caafe81cae836b2d228218d6c7f726f62dac575d8c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140010"
      ]
    },
    {
      "uid": "zhcn:394cfcb76e6916ce94720a93",
      "kind": "character_system_text",
      "source_text": "真是太棒了！",
      "source_fingerprint": "24d3f39f9dd84402aa7e32e0457cb9e3fc7b33cd32735ba65061dc863a05c79d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140011"
      ]
    },
    {
      "uid": "zhcn:4d04bbb345ac1a46a8f46aaa",
      "kind": "character_system_text",
      "source_text": "怎么会发生这种事……！",
      "source_fingerprint": "53c3529a2e1323a39ece348699ff086f8b0fa1a6ed87141d305e3af7ce13da0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140012"
      ]
    },
    {
      "uid": "zhcn:a5374a1e65dfff27fbb80495",
      "kind": "character_system_text",
      "source_text": "不要慌，慢慢来……！",
      "source_fingerprint": "bc89133164be7394a5d515c356e4b60ddd3b00e657435ee79e660aa0f3c8ddd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140013"
      ]
    },
    {
      "uid": "zhcn:7f490d2f744633c3d4152db3",
      "kind": "character_system_text",
      "source_text": "啊啊……！",
      "source_fingerprint": "ca2bfeb016b31251d02d124e40bbc72c49d33cc628f270bda341fc51699d29a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140014"
      ]
    },
    {
      "uid": "zhcn:fd8d7cbeaae4eaf745d44cf2",
      "kind": "character_system_text",
      "source_text": "嗯，嗯……",
      "source_fingerprint": "ca00113e85df71b20aab8568ae185c15a5c397f35871c4d1e67361ddfa0ed258",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140015"
      ]
    },
    {
      "uid": "zhcn:1e83793aaf0d8287c1a3b259",
      "kind": "character_system_text",
      "source_text": "怎么了？",
      "source_fingerprint": "8b931cbbc5ff834d619d16792036706cc06f14cf1a2024230235d3263006af89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140016"
      ]
    },
    {
      "uid": "zhcn:a19cfbde5157369a99766bef",
      "kind": "character_system_text",
      "source_text": "啊，怎么会……",
      "source_fingerprint": "a2cc3fe7dc21fef2aeb89feb85f5a28c08b3b7fd4fd0ca440b87b4948ddaebc9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140017"
      ]
    },
    {
      "uid": "zhcn:c39ddd420315a372e1d4da61",
      "kind": "character_system_text",
      "source_text": "可惜了……！",
      "source_fingerprint": "2d9fa92e5cfaaa7166d7842391c34581d0236fdd1908606589454aab73daddce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "140018"
      ]
    },
    {
      "uid": "zhcn:2ab86f3b85f7f0c10b11e84c",
      "kind": "character_system_text",
      "source_text": "明天我会为您准备这个。",
      "source_fingerprint": "f8246de2c2722b6f157d8fee86c93e37548f1cede2d3327a483206008441fe3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "15"
      ]
    },
    {
      "uid": "zhcn:0b14072e58d8990e11cbc849",
      "kind": "character_system_text",
      "source_text": "呼……啊，抱歉。\r\n没事的。\r\n无需担心，这点疲劳不算什么。",
      "source_fingerprint": "853b2f0fa8a4f1fa922cd092d914062385d6de1e80f0e93373e4dc9abab41b32",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20000"
      ]
    },
    {
      "uid": "zhcn:9a3688d0771cd712e7d85206",
      "kind": "character_system_text",
      "source_text": "有您在看着我……\r\n身为骑士，不能退缩……\r\n不能退缩……呼。",
      "source_fingerprint": "41a7d9c9243353cd5f0c03b119ed1dab60f680be5fb5e95645ccf52aea39a662",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20001"
      ]
    },
    {
      "uid": "zhcn:4356a81358e9ca06be942d8b",
      "kind": "character_system_text",
      "source_text": "我会全力以赴。\r\n这是骑士的职责。\r\n请下达指令吧。",
      "source_fingerprint": "f6cbc6de6e351ae8feef968a5cdb79c2ed8b455d789f5f6448650f805a1b79b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20002"
      ]
    },
    {
      "uid": "zhcn:17f41b4a45b13edad589b6f4",
      "kind": "character_system_text",
      "source_text": "身体变得轻盈了……\r\n全身仿佛化作利剑，\r\n变得更加锐利。",
      "source_fingerprint": "0304e19fc5e883195a0d6238c83f8a6c68f8972cff65985046a20a7f448064a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20003"
      ]
    },
    {
      "uid": "zhcn:35b73c5885af7b1465ae0dfa",
      "kind": "character_system_text",
      "source_text": "没问题。\r\n时刻保持万全是作为骑士理所应当的责任。",
      "source_fingerprint": "eef1c7f8b98259e3633b28ee1ab7779d2e4c2ba50b6f561be47edba564ef682f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20004"
      ]
    },
    {
      "uid": "zhcn:13950685c4566e8898c16454",
      "kind": "character_system_text",
      "source_text": "尽管吩咐。\r\n我将以我那锋利无比的奔跑，\r\n来为您展现。",
      "source_fingerprint": "4e02a1b7eb61015437346f38a5d1c5abfbbd2e6f27f5ad7ab56c5645e4076786",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20005"
      ]
    },
    {
      "uid": "zhcn:8d2007a9a99b043414908ed6",
      "kind": "character_system_text",
      "source_text": "基本功很重要。\r\n必须反复练习，\r\n直到身体记住为止。",
      "source_fingerprint": "be127e330294d74fe493e06d6a73768f1459f955ccad2e8a601546634131c857",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20006"
      ]
    },
    {
      "uid": "zhcn:49159c5e8a86cea8495cb28e",
      "kind": "character_system_text",
      "source_text": "准备就绪了。\r\n让我们一起去锻炼吧。",
      "source_fingerprint": "e25c5f8f6c88989a2a738e6fd54c68d269671342af45956d1dbe1b13cd7dd267",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20007"
      ]
    },
    {
      "uid": "zhcn:be00c51c48c6d288d639e90d",
      "kind": "character_system_text",
      "source_text": "无论何时都不能松懈……\r\n必须更加坚定。",
      "source_fingerprint": "ae2ec03080d79612af624796c529cc72f517b00f4cdfee2e95decb5ce2e1c9ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20008"
      ]
    },
    {
      "uid": "zhcn:2de66ab9dd0d0ea46d810739",
      "kind": "character_system_text",
      "source_text": "得更加努力……\r\n这样下去，怎么配得上『骑士』的称号……！",
      "source_fingerprint": "478b9a4ab14807c4cdd158ca5cab0800da08f285ab8c7b92a44e04af881c37f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20009"
      ]
    },
    {
      "uid": "zhcn:368bde6e70f757879d59918d",
      "kind": "character_system_text",
      "source_text": "骑士精神就是……\r\n永不放弃……\r\n绝不……唔……",
      "source_fingerprint": "3c61ba397463fa6a13038e62c5edfc7dfb6cce926cced70fdc7c41b2e803f0b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20010"
      ]
    },
    {
      "uid": "zhcn:6a3c294b0cc02bc45b9a91e6",
      "kind": "character_system_text",
      "source_text": "……一点问题都没有……\r\n我一如往常……\r\n完全没问题……真的……",
      "source_fingerprint": "496aec3d618650be150ba10f0abf1a43d975c76d79b39fe0eac984121e7b2322",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20011"
      ]
    },
    {
      "uid": "zhcn:8de23031dfa450e1cb8b6902",
      "kind": "character_system_text",
      "source_text": "主君，\r\n战斗接连不断。\r\n请务必三思。",
      "source_fingerprint": "f3bc655aa78735ea7be1f02e28915e5327dced84137be8d6c000415789a9b305",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20021"
      ]
    },
    {
      "uid": "zhcn:099ae3079ff1a00edc74f002",
      "kind": "character_system_text",
      "source_text": "不可这样，主君。\r\n随意挥剑是得不到胜利的。请重新考虑。",
      "source_fingerprint": "fedf2abe75c49de34929885060d528ee9745f8fb1aa6e4f70018990b67438ef1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20022"
      ]
    },
    {
      "uid": "zhcn:3615f027a842db5401f656d1",
      "kind": "character_system_text",
      "source_text": "我的『圣剑』是不灭的利刃……\r\n无人能折断。\r\n让我们一起走向顶峰！",
      "source_fingerprint": "063b0cd75d56cc6dde1ae25df5d05aa8ac2df1233b0027eb13644dae4b4fd73e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20023"
      ]
    },
    {
      "uid": "zhcn:9ec04d97aecd5a7a5b72643b",
      "kind": "character_system_text",
      "source_text": "我将以骑士之名，\r\n展示一场堂堂正正的比赛。\r\n为了我的荣耀和主君！",
      "source_fingerprint": "d73e8293a5c459a778fc14b43f6e5f5bb9a7515417b28c86fd973a96f3cf9b58",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20024"
      ]
    },
    {
      "uid": "zhcn:e94218621539c4285229d79d",
      "kind": "character_system_text",
      "source_text": "若能赢得胜利，\r\n让主君高兴……\r\n那一切就都值得了……！",
      "source_fingerprint": "ea3146589e7b3f59c466c941f16a90535a81a39110551da51c5e1034c4d4492c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20025"
      ]
    },
    {
      "uid": "zhcn:0b49f7d8ceb2ecdd2ca215be",
      "kind": "character_system_text",
      "source_text": "胜利将献给您。\r\n请相信我，稍作等待。",
      "source_fingerprint": "1d7e3141a65ddcc865bd809f8735383055a8497f7ef772a58378dc3f00f73904",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20026"
      ]
    },
    {
      "uid": "zhcn:23c6791a9e1886a25a8b1a72",
      "kind": "character_system_text",
      "source_text": "我不会成为败者。\r\n因为有我珍贵的主君\r\n在等待我的胜利归来！",
      "source_fingerprint": "250ac1e919827620d8954d8ffab21687bd38be4c1319673c6584f9eab5a524d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20027"
      ]
    },
    {
      "uid": "zhcn:00a9ab34f4d5fc62e7f4abef",
      "kind": "character_system_text",
      "source_text": "无所畏惧。\r\n我已为此付出无数的锻炼。",
      "source_fingerprint": "51a90e75f345eee832620642ff4eb5fe5dc766583b29115da42d3792697550c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20028"
      ]
    },
    {
      "uid": "zhcn:7cce2b0a3188ce40cb3484bf",
      "kind": "character_system_text",
      "source_text": "请放心。\r\n我不会让您担心我的奔跑。",
      "source_fingerprint": "f79c57401e4e47064211df07b42c2dce45a79d2c7cdb755c224577dc82771056",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20029"
      ]
    },
    {
      "uid": "zhcn:70efb03bd09f931c6ab6f4c4",
      "kind": "character_system_text",
      "source_text": "哈，要开始了。\n四剑之一，狄奥尼修斯的雷戟……\n现在，就让您见识一下吧。",
      "source_fingerprint": "b5c23c2c2af48136b290e9d7a35a3c1a5502d5bf75766edb652285e408023289",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20030"
      ]
    },
    {
      "uid": "zhcn:291d94fe306dedc64bb9b86f",
      "kind": "character_system_text",
      "source_text": "磨砺过的剑中闪耀着光芒……\r\n没错，\r\n那正是现在的我。",
      "source_fingerprint": "734346e2027a24a25c0cc4eacddf7eaedc79bc08d9135decedc7788cb88b2342",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20031"
      ]
    },
    {
      "uid": "zhcn:7257bd28e9e61c733dade5b0",
      "kind": "character_system_text",
      "source_text": "即便前路满是荆棘，\r\n骑士的职责是为主君劈开道路……\r\n呼。",
      "source_fingerprint": "1c1e6ed92e17c1fcffb7827f2bf63335777f91817fc173e779a5cee8ca86420b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20032"
      ]
    },
    {
      "uid": "zhcn:7b02cbd264cd9f3484859df2",
      "kind": "character_system_text",
      "source_text": "虽然未到最佳状态，\r\n但我会尽全力赢得胜利。",
      "source_fingerprint": "91a11c6b0b9a986d47aba466261fa8e3dce3934f0bf674151c43f51e38fc6938",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20033"
      ]
    },
    {
      "uid": "zhcn:64e7435092f9c00b67f2dd33",
      "kind": "character_system_text",
      "source_text": "正是在逆境中才能发光……\r\n对吧，\r\n骑士多旺达……！",
      "source_fingerprint": "b46638459c0d30e89006d9a82381e34bb9023c61fefeb8f11b29419d04535e53",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20034"
      ]
    },
    {
      "uid": "zhcn:ebba0be21e7df35e39c93837",
      "kind": "character_system_text",
      "source_text": "呼……没事的，肯定没问题。\r\n我可是骑士啊……！",
      "source_fingerprint": "9c7d02b88e27237b5d76c9d712fa5cf060a3e2d7396b7df0e0626c0927fd240e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20035"
      ]
    },
    {
      "uid": "zhcn:6b15afa6d55c36a4d8b45cae",
      "kind": "character_system_text",
      "source_text": "不，您不用担心。\r\n不管遇到什么情况，\r\n我都会是您的剑与盾……！",
      "source_fingerprint": "cfc32d44042b39494210af9199668e47c1d65a42888aed9354bcddbdcd64922f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20036"
      ]
    },
    {
      "uid": "zhcn:0ecd1634307049a092035d65",
      "kind": "character_system_text",
      "source_text": "不想让您看到我的软弱……\r\n毕竟，\r\n我理想中的骑士……应该更加……！",
      "source_fingerprint": "429a35ff0bccee772350aff1f91126c2b760969ef075aa663d806f7d7b858782",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20037"
      ]
    },
    {
      "uid": "zhcn:1f8b6b5b1d2038c83886ab57",
      "kind": "character_system_text",
      "source_text": "出发。",
      "source_fingerprint": "8167d1d045fa6f23c7c40620b76aa43604b384e653241623afc8b7061394a145",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20038"
      ]
    },
    {
      "uid": "zhcn:a36925d9e0d20014c62648b7",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20039"
      ]
    },
    {
      "uid": "zhcn:09cbec1a5f2f3a1c5bada8df",
      "kind": "character_system_text",
      "source_text": "我们走吧。",
      "source_fingerprint": "2b52ec6a51ea86f04e77eb47b539df83710d70ffb623152a29d619d493402def",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20040"
      ]
    },
    {
      "uid": "zhcn:22cbdaf309dd3a0174f14e1f",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20041"
      ]
    },
    {
      "uid": "zhcn:9e0c015546750d7981eac848",
      "kind": "character_system_text",
      "source_text": "就这点程度……！",
      "source_fingerprint": "3e98f3b642179db4634ce4c3e12dd1728cbfe117e143a796f8a93ad9b94c1c4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "20042"
      ]
    }
  ]
}
