      ]
    },
    {
      "uid": "zhcn:8c1541f40d080bd8494ff972",
      "kind": "character_system_text",
      "source_text": "哼哼。",
      "source_fingerprint": "1354e126adfa2a5953f8f27091c1ee22bfcf9421ee0efd9cf6d07334773e2183",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
