    },
    {
      "uid": "zhcn:0aeb5339b4551a67717a5df6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "既然是阅读的秋日，\r\n不如向我那做书店店员的父亲问问有什么好书推荐吧。",
      "source_fingerprint": "eb393cc16da0cb28281c27f19126cd62b1cf94c350ce879b4e3c8c5dde6d9eef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
