      ]
    },
    {
      "uid": "zhcn:96b91ec2d93cffd1cbe035c4",
      "kind": "character_system_text",
      "source_text": "よぉし",
      "source_fingerprint": "8962088c9a53ad4e49e8ae554ff5674255d79bf13f5395cba64a36ef730f1e66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "410003"
      ]
    },
    {
      "uid": "zhcn:b4dd0bb95ac634350bb6cca2",
      "kind": "character_system_text",
      "source_text": "ふふふっ",
      "source_fingerprint": "12e7eef62aaa62de5bcf3d27009562d4eacaff770beadf5a4675927e39705a93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "410004"
      ]
    },
    {
      "uid": "zhcn:67102e3972b20ac8f0582771",
      "kind": "character_system_text",
      "source_text": "ふふふっ",
      "source_fingerprint": "12e7eef62aaa62de5bcf3d27009562d4eacaff770beadf5a4675927e39705a93",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1100",
        "410005"
      ]
    },
    {
      "uid": "zhcn:dee836ff8483ef425d25e590",
      "kind": "character_system_text",
      "source_text": "あらら……",
      "source_fingerprint": "97d65f95b57535f0688503bf7c5a2dc78a5e969d73eda5f9a2921eadcf61e316",
      "source_path": "character_system_text_dict.json",
