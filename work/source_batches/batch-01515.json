    {
      "uid": "zhcn:d7dfe0b9625248ab26f25ba3",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "好的早晨，今天有什么计划呢？\r\n无论何时何地，我都会侍奉在您身边，\r\n请安心。",
      "source_fingerprint": "c86235268eae159014ff2d996cb303f1cf5af667b329cd24d5493ff4d605aefc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
