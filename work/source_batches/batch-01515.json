      ],
      "json_pointer": "/1121/91014"
    },
    {
      "uid": "zhcn:098ecd1e9e054e6850c722bb",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "在这干燥的季节，\r\n正如母亲所教导的，\r\n绝不能忽视指甲与皮肤的保养。",
      "source_fingerprint": "2e2ba34a9c526d53fc1b2306df52a29e68a8d0401af60826941a17e4b2e3ab15",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
