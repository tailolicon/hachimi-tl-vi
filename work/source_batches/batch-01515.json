      ],
      "json_pointer": "/1121/91012"
    },
    {
      "uid": "zhcn:09f478785831e2b11a9768a2",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "照耀大地的夏日阳光，\r\n也会在我『圣剑』的光辉下黯然失色吧。",
      "source_fingerprint": "63430084380a31570298a63209fd7b38ab0d13072416aad0e5a2590992b8106a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
