      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "作为骑士，\r\n我应学习的还有很多……",
      "source_fingerprint": "ce15580cd88067fa077cedb23166439a62c32ad102a757b883fd7e24e06d4b92",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1121",
        "70004"
      ],
      "json_pointer": "/1121/70004"
    },
    {
      "uid": "zhcn:4e1c156d2c5232a905ea41c0",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "随着动作摇曳的裙摆……\r\n是为舞蹈而设计的。",
