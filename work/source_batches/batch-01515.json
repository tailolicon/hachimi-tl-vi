    },
    {
      "uid": "zhcn:3def2cf67acaed2c33215b7e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "金镇之光告诉我整理头发的方法是『啪嗒』，\r\n但这『啪嗒』到底是什么意思呢……",
      "source_fingerprint": "6f9b7819d39aa3673c74b82d4de5aa07466a716540ba090ac9bb7f2318b1df18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
