      ],
      "json_pointer": "/1121/91015"
    },
    {
      "uid": "zhcn:275532220ef875c8995098c8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然被称为『最快三人组』之一，\r\n但我不会满足于此。\r\n让我们开始吧！",
      "source_fingerprint": "839ba88aa76bf8e6cd9dc2b20914fbb7c299bc50e2210587b6e09db2f203e52b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
