    },
    {
      "uid": "zhcn:7703acedc64631a705e9bea1",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "每晚睡前我都会大声重温骑士誓言。\r\n内容？……呵呵，这是秘密哦。",
      "source_fingerprint": "67d27166142a9145c4a3b10923ac2e8780547c7812591d0435f1c1edcb25e668",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
