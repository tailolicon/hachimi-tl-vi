      ],
      "json_pointer": "/1121/91009"
    },
    {
      "uid": "zhcn:ef2ca3bf428743fb19d3e886",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "无论何时都要优雅而高贵。\r\n即使肚子饿了，\r\n也不能……咕。",
      "source_fingerprint": "2534f4aa96e67992925dae5d95be9552f10074f18a9cb195fbea71c327f569a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
