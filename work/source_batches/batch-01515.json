    {
      "uid": "zhcn:14f888f762033a3a173ba076",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "以我的骄傲担保！",
      "source_fingerprint": "5ba1a43b0b90824bade3d010a7a3675d5779edbfd07c4f3095a8bb09d35e718b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
