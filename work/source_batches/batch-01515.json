    {
      "uid": "zhcn:6b365069807dfb8f321d4f3e",
      "kind": "character_system_text",
      "source_text": "辛苦啰。",
      "source_fingerprint": "819a6bb1f201e68088ea2f70c76ca8023e635e7bb0e842bb22f4170e7f843331",
      "source_path": "character_system_text_dict.json",
