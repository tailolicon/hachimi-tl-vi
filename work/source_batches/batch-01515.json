    },
    {
      "uid": "zhcn:6ea2a2f8c210319e34812edc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "每样东西都有它的使命，\r\n这件衣装的使命或许就是在舞台上让我们闪耀吧。",
      "source_fingerprint": "2840b54fcdb00c0a7f31f9b4d2d2177e5ecfe5824e7b4aa71010413f5e4165b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
