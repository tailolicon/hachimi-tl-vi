      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "请务必保证水分充足。\r\n若您有什么不测，\r\n我的心定会破碎。",
      "source_fingerprint": "51183f82df41326427cf6ab5bcfaaaf257116ba34aae75156d72af6b03d67c47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
