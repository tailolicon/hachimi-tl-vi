      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "情人节快乐！",
      "source_fingerprint": "d9e338ecc741ac949d3f240a82f8cc83ab075127e1514b8c6ff32e4c943f6fc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
