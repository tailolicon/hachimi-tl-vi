      ],
      "json_pointer": "/1121/90005"
    },
    {
      "uid": "zhcn:01fb0facafa2d7538606da5a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "温柔而包容的力量……\r\n春天是决断的季节，\r\n某种程度上，这也像极了您呢。",
      "source_fingerprint": "8886a56924e8137a9818fcbaa9920b03262ec08abb4c1d4d481f9a825f54bc13",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
