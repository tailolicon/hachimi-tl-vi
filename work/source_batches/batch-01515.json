    },
    {
      "uid": "zhcn:baa1b5c5a9b69d5a47bc892c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "来吧，接受挑战吧。\r\n我会让我的『圣剑』染上你的血迹！",
      "source_fingerprint": "346f3737307cba748b7833d9fe24f9688dbeec3f38cdaaa2760c2a101b27f23c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
