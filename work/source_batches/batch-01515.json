    },
    {
      "uid": "zhcn:f2f2e9453086ec00da08e800",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "金镇之光在取菜的时候，\r\n总是把菜摆成一条直线，\r\n那真是一门技艺啊……",
      "source_fingerprint": "654db98b679bee0e533ae19124406d3e2963d621c29a53fff711af9c3d2e941f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
