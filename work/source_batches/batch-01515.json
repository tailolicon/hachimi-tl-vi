    },
    {
      "uid": "zhcn:299f7b17e0fd5855c5de458d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "啊，到午餐时间了……\r\n为了挥舞『圣剑』，得先补充能量呢……！",
      "source_fingerprint": "f1e1c9f71a713a5b694349acd268eecc04625d4857c570897feb414a634fd8c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
