    },
    {
      "uid": "zhcn:f6cd4c1a06549123ed416f17",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "千年的漫漫长路，愿与你同行……。",
      "source_fingerprint": "d0a269529d46dc52111d44fd4c3c9186ea29eaed54c71633bd8aac2a6b25bf78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
