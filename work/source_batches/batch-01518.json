        "95006"
      ],
      "json_pointer": "/1126/95006"
    },
    {
      "uid": "zhcn:a9caf7b8e9b93f7e42f6f18b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "好了，要出发了！",
      "source_fingerprint": "849c0c3b42eb2774cbe0975112a27fbd3b244514467ef4ff9ae527ddc51556b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
