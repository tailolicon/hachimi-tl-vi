        "1129",
        "1002"
      ],
      "json_pointer": "/1129/1002"
    },
    {
      "uid": "zhcn:8cf92e59156e9a93e274a3df",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "名鉴等级提升了。\n是我们的成果呢！",
