        "1129",
        "10009"
      ],
      "json_pointer": "/1129/10009"
    },
    {
      "uid": "zhcn:24cdec7fda2a02e2b79b9d62",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "胜利！",
      "source_fingerprint": "c328cf26a3fd5d995a83e439c1e6d7bf2c420c5f59add386c869518c1a236d8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "1001"
      ],
      "json_pointer": "/1129/1001"
    },
    {
      "uid": "zhcn:40cdb0e9c5f9b955c41f1b4d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "距离新年还有一段时间呢。\n比赛、学业、私事，\n没做完的都要做，全部！",
      "source_fingerprint": "b1bed9528df46b1c683a95476479ca424fae8fe377da4d9278d849d66a111e84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10010"
      ],
      "json_pointer": "/1129/10010"
    },
    {
      "uid": "zhcn:224016d2843fabe510f41710",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我准备了沐浴用品的礼物哦。\n薄荷味的沐浴露，\n清爽怡人，很推荐的♪",
      "source_fingerprint": "4a425d440055f432d59ee0526de0b910e3e7072364436075f9db538aa6050c62",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10011"
      ],
      "json_pointer": "/1129/10011"
    },
    {
      "uid": "zhcn:08eb540f39ab30a1db69062d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今天…我想听听\n你关于自身梦想的想法。只要\n两人伸出手，一定能抓住的。",
      "source_fingerprint": "a925de9c393aa50149b0034812ace30b284c68ab7e7a19bcc5036634e6ea5c5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10012"
      ],
      "json_pointer": "/1129/10012"
    },
    {
      "uid": "zhcn:4cc5187af473a54d37563076",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今天被潘多拉同学叫去了。\n好像是惊喜…呵呵，\n什么事我大致能猜到呢。",
      "source_fingerprint": "b1da59bb9e445958f0a14bcb2537ecf4d103aa6698699f33dbb32da1b3adbcf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10013"
      ],
      "json_pointer": "/1129/10013"
    },
    {
      "uid": "zhcn:4203d9689ab4fe12ef3e9f36",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "呵呵，没想到你把训练员室\n装饰了一番呢。今天的\n会议，看来会很有趣♪",
      "source_fingerprint": "c0a7483702d5d197dc6eddb31acdbfce3115724403cc6f2fc0fc088b77ed409d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10014"
      ],
      "json_pointer": "/1129/10014"
    },
    {
      "uid": "zhcn:5eeef25a78c55a8f359d7505",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "有通知呢。来，\n趁现在确认一下吧！",
      "source_fingerprint": "c94e1f60ecbf415f531d460a760f2d664e1d8b209bd937758083bee574c3be24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10015"
      ],
      "json_pointer": "/1129/10015"
    },
    {
      "uid": "zhcn:a926fa39228e83fbc569af5e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "有礼物送到了！\n开封看看，先确认一下\n里面是什么吧。",
      "source_fingerprint": "7288d46f189417f75e1846432a9333b651e877b7d55205bf23e94e156781bc35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10016"
      ],
      "json_pointer": "/1129/10016"
    },
    {
      "uid": "zhcn:271edc50032a250980e395e7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "任务成功！\n呵呵，不妥协的态度，\n我觉得很好哦。",
      "source_fingerprint": "7023e65c4ccf742f4b86ac984032f3ba5ead6a284eaba91d82f81c06d61628a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10017"
      ],
      "json_pointer": "/1129/10017"
    },
    {
      "uid": "zhcn:1358cebc834ebe7a583f94a7",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "活动快开始了呢。\n为了能以万全的状态参加，\n好好准备一下吧！",
      "source_fingerprint": "f7d0ce990e5ee13e0fbe674ebf60c410209c7e13f5fd1193d65522ea078bb250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10018"
      ],
      "json_pointer": "/1129/10018"
    },
    {
      "uid": "zhcn:c171e4293247e8adeff9e2cf",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "活动已经开始了呢。\n慢悠悠的话会赶不上的。\n好了，快走吧！",
      "source_fingerprint": "1be87c0c498b0b2ee17df7d0f6b7c20150b70cebeb0496c9eaef2467ed371164",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
