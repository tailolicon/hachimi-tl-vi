        "1129",
        "100000"
      ],
      "json_pointer": "/1129/100000"
    },
    {
      "uid": "zhcn:bd24a1b93aeb74bc0443da46",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我回来了！",
      "source_fingerprint": "a0911e22207ebd4e5b2465a4d2378a3328e0057ddd0a0764d77344297201735f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "100001"
      ],
      "json_pointer": "/1129/100001"
    },
    {
      "uid": "zhcn:5bdadc1934d653abe5ead50e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我跑了多远，你也一起\n前进了多远…呵呵，我们的话\n到底能走到多远的地方呢！",
      "source_fingerprint": "d5f6a29f181eb1cc003a93f119d2075cbe703fd7c934173e26702a79fec7af59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10001"
      ],
      "json_pointer": "/1129/10001"
    },
    {
      "uid": "zhcn:03c7ef9dfc15217e13a1b37a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "拍Q丸的广告，\n真的好新鲜啊。追求\n0.1秒的世界…就像比赛一样呢。",
      "source_fingerprint": "f0480fa4dbb34bc1089decd948784405cdb517ce57a3d3ae2d191d660a35d086",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10002"
      ],
      "json_pointer": "/1129/10002"
    },
    {
      "uid": "zhcn:35fa59e92ed3d48921a302dc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "虽然要回老家一趟，但我打算\n早点回来。可不能把时间\n全花在休息上！",
      "source_fingerprint": "6f5a5002694c8057c39b9ff5e9c95a484f2ff202f58f5f46f5c502faf1ece4d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10003"
      ],
      "json_pointer": "/1129/10003"
    },
    {
      "uid": "zhcn:628cb012fcdaa8b29667b1f5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "粉丝来信好像比平时\n更多了。大家温暖的心意…\n深深地渗透进心里了呢。",
      "source_fingerprint": "c7df3a09babb627aa45abc1bcd81ac733a918684b2258dbf1ebd2e941c9465e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10004"
      ],
      "json_pointer": "/1129/10004"
    },
    {
      "uid": "zhcn:126e2a9b32b55d5761e55492",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我做了布朗尼呢。\n经过了反复的练习，\n味道方面我有自信哦。",
      "source_fingerprint": "e89e4a154338bfa1ff08680f3d3195bab1f282e32c6f23e4d491c03c78b858bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10005"
      ],
      "json_pointer": "/1129/10005"
    },
    {
      "uid": "zhcn:cd0dbc64fdf476417201159f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "向星星许愿固然美好，不过——\n让身心熊熊燃烧，成为\n星辰本身，不是更美妙吗？",
      "source_fingerprint": "bd05480ac8828e773143c7deeb1f2f116e39d5e68645cc6c12b5da96266b556d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10006"
      ],
      "json_pointer": "/1129/10006"
    },
    {
      "uid": "zhcn:c064627ede1f11cf5332739f",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "鬼怪护士装…唉…\n你觉得呢？虽然是潘多拉同学的提议，\n但也未免太嗨过头了吧？",
      "source_fingerprint": "640b8da72ab7690032f56a547fd60e8bcfb87eb24697a9b12deaf32c3ebec819",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10007"
      ],
      "json_pointer": "/1129/10007"
    },
    {
      "uid": "zhcn:7cc1e0dda10bc716291ab8b5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "庆祝的气氛让赛道都\n空荡荡的呢。得趁现在赶紧跑！\n你当然也会来对吧？",
      "source_fingerprint": "73e676ee6c7092885c2425e388f30c5e3bf9261f021d915a6988ced1d811c348",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "10008"
      ],
      "json_pointer": "/1129/10008"
    },
    {
      "uid": "zhcn:8542f46b1bcfb42dcd15aff9",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "训练结束后能给我一点\n时间吗？我有东西想给你。\n…咦，你也有？是吗，好期待♪",
      "source_fingerprint": "6f07a15709f9bad3470db20051cce29971d11041f96d2d421d1fc001c5f5901c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
