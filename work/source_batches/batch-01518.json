    {
      "uid": "zhcn:cbd5a50e09a06e66203aec2d",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "いいよ、宣言する！\r\n『絶対に私が勝つ！！』",
      "source_fingerprint": "3a42ad88387c470ac0dd747dc8bd29e97f6c197f89ae7849e064550f47d6d97b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
