      ]
    },
    {
      "uid": "zhcn:e32e5805310f1a76f5e2a02f",
      "kind": "character_system_text",
      "source_text": "気を落とさず。",
      "source_fingerprint": "768ca619c4fd13990cf304edb438c84da1f15a6f7e85cb98f1db4a1a8b162634",
      "source_path": "character_system_text_dict.json",
