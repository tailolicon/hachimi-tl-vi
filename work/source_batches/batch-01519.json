  "entries": [
    {
      "uid": "zhcn:f5165f96b47fcc1bb1c521ed",
      "kind": "character_system_text",
      "source_text": "嗯，不错呢！",
      "source_fingerprint": "649392e73a6a304828c768039e6b66e1c449d49519f9618a9bfd777e73dfe467",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140001"
      ]
    },
    {
      "uid": "zhcn:b7de088da2325102b6e01468",
      "kind": "character_system_text",
      "source_text": "啊…。",
      "source_fingerprint": "edde3a8d21b92c27a5c507c923669ab158c7e313c638cf35c7fcfc2b08ad7741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140002"
      ]
    },
    {
      "uid": "zhcn:514dae0e756799075c8415e0",
      "kind": "character_system_text",
      "source_text": "太厉害了！",
      "source_fingerprint": "34d1e940aec13dd525563c00293fe3cbcea3cb287332293cb503694c8ec17304",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140003"
      ]
    },
    {
      "uid": "zhcn:fc734a1f8331cc93e565b8e6",
      "kind": "character_system_text",
      "source_text": "做得很好呢。",
      "source_fingerprint": "38fba3c4e4ac9f6800d97d2a1dbb962289fdc2d2c70033d3cc6c8b8cad71c3b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140004"
      ]
    },
    {
      "uid": "zhcn:4f4720e73ff6075f97653b53",
      "kind": "character_system_text",
      "source_text": "下次再接再厉，吧。",
      "source_fingerprint": "71e84963ff56435ec3ab2146d0bbb0fd27d3ac994743f78ee326f2ff78c3b335",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140005"
      ]
    },
    {
      "uid": "zhcn:24a5f65c292a8d650d39b415",
      "kind": "character_system_text",
      "source_text": "太厉害了！",
      "source_fingerprint": "34d1e940aec13dd525563c00293fe3cbcea3cb287332293cb503694c8ec17304",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140006"
      ]
    },
    {
      "uid": "zhcn:d6037a062e938b0d65010b8e",
      "kind": "character_system_text",
      "source_text": "做得很好呢。",
      "source_fingerprint": "38fba3c4e4ac9f6800d97d2a1dbb962289fdc2d2c70033d3cc6c8b8cad71c3b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140007"
      ]
    },
    {
      "uid": "zhcn:6f15b717ae74bbbe33995b11",
      "kind": "character_system_text",
      "source_text": "哎呀？",
      "source_fingerprint": "1ffd86181f99bb201430319f3ea81b2a0a385cf1b40520738cae2644fb61703d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140008"
      ]
    },
    {
      "uid": "zhcn:f1fa8ec2750ab5dced34ac42",
      "kind": "character_system_text",
      "source_text": "怎么了？",
      "source_fingerprint": "8b931cbbc5ff834d619d16792036706cc06f14cf1a2024230235d3263006af89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140009"
      ]
    },
    {
      "uid": "zhcn:318b73936cde888e88e664fa",
      "kind": "character_system_text",
      "source_text": "真是的…。",
      "source_fingerprint": "6cf411efdd1a3fc04b3872e75ae8458c86e142411d4ac253db477b540476c165",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140010"
      ]
    },
    {
      "uid": "zhcn:acd3487aaf6769a9d9bd8051",
      "kind": "character_system_text",
      "source_text": "机会来了！",
      "source_fingerprint": "c619ea1c0666ba860fcaff3a55e2e7260093caf80ce6070df37eda5a0d9529a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140011"
      ]
    },
    {
      "uid": "zhcn:9ee14688480b823283ef0a2c",
      "kind": "character_system_text",
      "source_text": "好厉害啊…！",
      "source_fingerprint": "115221d5d28935bb65109b0a882ce8a889e1dff7a77eba7aaa61db1e95402406",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140012"
      ]
    },
    {
      "uid": "zhcn:3fe59eb01f574bcc93265388",
      "kind": "character_system_text",
      "source_text": "就这样…。",
      "source_fingerprint": "cda503822f886cb24610be9e165a11d8311224ea0aa7df3d30cb637b84bf3370",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140013"
      ]
    },
    {
      "uid": "zhcn:508045753125d38958a8dca0",
      "kind": "character_system_text",
      "source_text": "啊…！",
      "source_fingerprint": "9ad0243b825a35943ac53be5793f305c0e6880cc447bde1e8dd30c9f769995a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140014"
      ]
    },
    {
      "uid": "zhcn:09b0a2ae1fee6885890d85b1",
      "kind": "character_system_text",
      "source_text": "嗯…。",
      "source_fingerprint": "a4e8d20aa5151334b4c38a65a505a9374b636972b6acc835853e25c1ff32890f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140015"
      ]
    },
    {
      "uid": "zhcn:6cbd04deb55f08e7d241f905",
      "kind": "character_system_text",
      "source_text": "我来做可以吗？",
      "source_fingerprint": "f6e06ed049a309ee2b07c06238a9b3f5cde13bd9ca937dc74197c89d54dac5a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140016"
      ]
    },
    {
      "uid": "zhcn:cfb8d6c29bd2c8d12cb44d94",
      "kind": "character_system_text",
      "source_text": "唔…。",
      "source_fingerprint": "9852121b46bc3ea60cc2bf9ba1e1633b23e248d37c2f7aeca6a1854e4d6ab164",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140017"
      ]
    },
    {
      "uid": "zhcn:542cc7117e28bdfc00e1c809",
      "kind": "character_system_text",
      "source_text": "啊…。",
      "source_fingerprint": "edde3a8d21b92c27a5c507c923669ab158c7e313c638cf35c7fcfc2b08ad7741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "140018"
      ]
    },
    {
      "uid": "zhcn:0ec12b919b5f93a83c5bdb4a",
      "kind": "character_system_text",
      "source_text": "明天能拿到这个哦。",
      "source_fingerprint": "edcc225df8a449436b040cb95aec3186c7b3c65f9ce7196721046f5c7674ff9f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "15"
      ]
    },
    {
      "uid": "zhcn:b09555ee137b124ddc0b659f",
      "kind": "character_system_text",
      "source_text": "唔…脸好烫呢…\n要不要喝点冷饮…。",
      "source_fingerprint": "e76a1ddd4c701c1b0a6d75662611024c55e136d080114c02d1ab3ca3d17425a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20000"
      ]
    },
    {
      "uid": "zhcn:ff8d17e5375d0b56e71bae29",
      "kind": "character_system_text",
      "source_text": "没关系的，不用客气。\n我还能行…还能好好跑的…！",
      "source_fingerprint": "2dcb076dbe302ee832266fc2ab126e9fda24c26358c2d05c3d0ffb173c5f8259",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20001"
      ]
    },
    {
      "uid": "zhcn:c0ff15c34770bdbdfbd46bcb",
      "kind": "character_system_text",
      "source_text": "早点开始的话，\n就能比别人更领先一步。\n来吧，现在马上开始训练！",
      "source_fingerprint": "e98c497cc9324bb04debd7e353f3a32352543f874b4a983f436dcc0eadce3870",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20002"
      ]
    },
    {
      "uid": "zhcn:f600fdc4ec7ba5be53b97d68",
      "kind": "character_system_text",
      "source_text": "意象已经完美成型了！\n停下来都觉得浪费，\n目标之处我看得一清二楚！",
      "source_fingerprint": "7f30c2e9c408a5fb1cbc90cea79d9b63c99d7a0fe1f84186bd3986c20b913ff4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20003"
      ]
    },
    {
      "uid": "zhcn:49e8230605bb008d7fb594ad",
      "kind": "character_system_text",
      "source_text": "大家已经跑起来了…！\n喂，我也该出发了\n可以吧？我已经准备好了！",
      "source_fingerprint": "a6d61dd79e8d749244e0751d1b2b2030f27a9f833ff45249d763f1abf5fba27f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20004"
      ]
    },
    {
      "uid": "zhcn:4101c5d00a3e406d82e6af74",
      "kind": "character_system_text",
      "source_text": "假如有能分开大海的杖…\n呵呵，我想一路跑到\n地平线的那一头呢！",
      "source_fingerprint": "3d54b60d65ac0f5b428db1499277aadee2393b67c6f314b0eeb1d7ad448089f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20005"
      ]
    },
    {
      "uid": "zhcn:0cf8574ceddfd49523558e45",
      "kind": "character_system_text",
      "source_text": "冰敷用的护具也有…\n嗯，准备好了。",
      "source_fingerprint": "1c2394b10fd9ea3edf0b2b14b52d79827f213cabecc6bd277b0326de31f77691",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20006"
      ]
    },
    {
      "uid": "zhcn:132fedac6e97375143743b26",
      "kind": "character_system_text",
      "source_text": "今天从什么开始？\n你的话，\n应该有方案吧。告诉我。",
      "source_fingerprint": "ff32e099d3c5009f613f36e1964d4d72a8411e810071eab06062ba25e6bf36af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20007"
      ]
    },
    {
      "uid": "zhcn:53af32df32430dc2b8ce495c",
      "kind": "character_system_text",
      "source_text": "脚指甲，怎么剪得\n这么短啊…真是的…。",
      "source_fingerprint": "2c8cd6599a9f4a88ee8eec8cf65686ebe37f02d6cd676e44289dc65c6a52f7a2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20008"
      ]
    },
    {
      "uid": "zhcn:5eeea5cefb438be6caa37ac7",
      "kind": "character_system_text",
      "source_text": "没关系，继续吧。\n…难得的时光\n浪费了太可惜了。",
      "source_fingerprint": "50d982a47fac4c40b887c63ba9727374364cee1735ba02d81864b1f452d6155c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20009"
      ]
    },
    {
      "uid": "zhcn:6a279ecb2c868f2b111719f7",
      "kind": "character_system_text",
      "source_text": "啊，沙尘…\n唉…风好像有点大呢…。",
      "source_fingerprint": "6f1405db094dbe5e398f83d1b5c0411bc899a422247c65f05b6c830f5e28bc98",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20010"
      ]
    },
    {
      "uid": "zhcn:1143bf93cd44f73ccef9aec7",
      "kind": "character_system_text",
      "source_text": "…那个孩子的鞋子，好好地\n沾满了泥土。而我——\n不行啊，这样下去。",
      "source_fingerprint": "49f56a4b92cb148503f87b6c21af76f67ae744f5c060885d88d88fd621da2197",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20011"
      ]
    },
    {
      "uid": "zhcn:9919ade199b25a118ed84fb9",
      "kind": "character_system_text",
      "source_text": "你真的觉得应该这样做？\n那告诉我理由。把彼此的意见\n好好地统一一下吧。",
      "source_fingerprint": "2133b255bf9ba7f7f1179818a57d5a5488ccc8cfed76afcc59ef28ed59317ee7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20021"
      ]
    },
    {
      "uid": "zhcn:d0f4ffd0b63b8c1242ff470b",
      "kind": "character_system_text",
      "source_text": "…无法赞同。继续这种\n胡来的做法，一定会有极限的。\n我不喜欢那样。——绝对不要。",
      "source_fingerprint": "2762b5151efe637f376d804df41a7286445f2834659e27b6c58a184dec84f105",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20022"
      ]
    },
    {
      "uid": "zhcn:f98f39e87354210a4055fde5",
      "kind": "character_system_text",
      "source_text": "无以复加的\n完美状态！\n就这样直线冲刺——迈向胜利！",
      "source_fingerprint": "60a8d9018024edda562f5e8bddf51c7c47dd0646b4f00fe02dc8bb4947242463",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20023"
      ]
    },
    {
      "uid": "zhcn:1c8290a895fe5b5c14650fe1",
      "kind": "character_system_text",
      "source_text": "只要一直强烈地渴望，\n无论什么地方都能到达。\n就像渡海而来的蝴蝶一样！",
      "source_fingerprint": "f4956b59092a4a61163e86efea0ed76e60d1a7022bf6e6de1ff1955d0d9cb842",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20024"
      ]
    },
    {
      "uid": "zhcn:75580c712e75ac2e6aae0bf6",
      "kind": "character_system_text",
      "source_text": "没有什么无法超越的。\n只要心中深处\n怀有强烈的信念！",
      "source_fingerprint": "a61b6a7b895410ba5ee08e3334502bef0efdc31b6eec49aa664505cb34cfbdbf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20025"
      ]
    },
    {
      "uid": "zhcn:5374afed39f70bf52924c8b4",
      "kind": "character_system_text",
      "source_text": "好多人——各种各样的声音，\n在呼喊着我的名字…\n呵呵，好受鼓舞呢！",
      "source_fingerprint": "7e0e283f831340bc3cc7d66efb95770ee2025d4803ca8e9eb1b6c663672f7594",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20026"
      ]
    },
    {
      "uid": "zhcn:cd5696573e4c255aa984a0d7",
      "kind": "character_system_text",
      "source_text": "想要的东西，\n我会一直伸出手去。\n直到抓在手中的——那个瞬间！",
      "source_fingerprint": "b8d46be0dc3427c56d586b1a508c02e9d1075b310930452766e05b28c62cf7f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20027"
      ]
    },
    {
      "uid": "zhcn:8eb49932ced2b38196126dd6",
      "kind": "character_system_text",
      "source_text": "准备万全哦。\n无论什么情况\n都能灵活应对！",
      "source_fingerprint": "3900985fac1b6133652b90e6f8016332d7060ba8a33b32ea8617e64d4f3bd84a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20028"
      ]
    },
    {
      "uid": "zhcn:8b29ee7d6083fccfdd01e6f1",
      "kind": "character_system_text",
      "source_text": "无论是怎样的诅咒还是常识，\n都与我无关。\n用这双腿，我只为取胜。",
      "source_fingerprint": "293a29d6360ca77dd97a4ce4ab4283acdc591b7c0e16f54d91bc0d6856bd22d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20029"
      ]
    },
    {
      "uid": "zhcn:1cbf4eddbeb77d77ae5ea115",
      "kind": "character_system_text",
      "source_text": "无论从哪都能一举超越给你看。\n我就是为此而奔跑的。\n每一天都是为了这个。",
      "source_fingerprint": "cc5ad827a7200aa833a910f506f0d48419d7f52ce602722b2bbe4c59f2ae5304",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20030"
      ]
    },
    {
      "uid": "zhcn:207e590b23d3bc496245f9ae",
      "kind": "character_system_text",
      "source_text": "奔跑的理由只有一个。\n——因为我就是想赢！",
      "source_fingerprint": "ebf88e41aa963bb2c382830f111888bbc69ccc791054175894f1db8ac1b8f1d0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20031"
      ]
    },
    {
      "uid": "zhcn:e7205da6ab2c1888b03109f1",
      "kind": "character_system_text",
      "source_text": "这点程度的颠簸在预想之内…\n没问题，我能驾驭得住…！",
      "source_fingerprint": "5913f7302035a07b90c0b9ddc0fdbae37eca3c158e6a233d6416a71d2a2c386a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20032"
      ]
    },
    {
      "uid": "zhcn:4847fe277ae6c66daff74fae",
      "kind": "character_system_text",
      "source_text": "我知道只要坚持自我，\n任何事情都能跨越…！",
      "source_fingerprint": "b013d90e50c445b710fe4150974f720840c2b6a26d1c5c462dc52f239e985bb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20033"
      ]
    },
    {
      "uid": "zhcn:8445c0a0b9bfae8377c04073",
      "kind": "character_system_text",
      "source_text": "我不想输。\n无论是对谁…包括对我自己。",
      "source_fingerprint": "35d1d865f6312a2ef0f18ef51015e8cadc0520498f24cb420006561feac11349",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20034"
      ]
    },
    {
      "uid": "zhcn:ffcd93eb11bb7e13e299b98d",
      "kind": "character_system_text",
      "source_text": "我能行的，我…！\n因为，我从未认为\n自己做不到…！",
      "source_fingerprint": "2d1030b031e549642fae9e80be4f3fe774a677a8b8594878f1cac764c165551b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20035"
      ]
    },
    {
      "uid": "zhcn:bbb523c0da0ebd2060611fd3",
      "kind": "character_system_text",
      "source_text": "我绝不怀疑\n自己的强大…！无论何时！",
      "source_fingerprint": "6ca9547d8737d07921639b01eb5ded015cc28235c31404d1ed06b4f51bac2a08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20036"
      ]
    },
    {
      "uid": "zhcn:f6782ec8b7a24b8f9f714b4b",
      "kind": "character_system_text",
      "source_text": "没问题…\n我不会摇晃的…\n绝对没问题的…！",
      "source_fingerprint": "c32682ad9dfd64274bfc28e60a57b30689d5aaaed0010f3b984a75c28d1ea794",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20037"
      ]
    },
    {
      "uid": "zhcn:93de92d356e6e155595fddaa",
      "kind": "character_system_text",
      "source_text": "走了！",
      "source_fingerprint": "fc2b0db28278f979f108f6e626eeaf8ff4553286870fbc94ddfa52a96348396a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20038"
      ]
    },
    {
      "uid": "zhcn:3129ae9d2753e3bd2557dbd5",
      "kind": "character_system_text",
      "source_text": "开始了！",
      "source_fingerprint": "96bfa07bcbc2af5c82be8a3f8a660d82a8af34152ea8aa0b87d81c424d76c637",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20039"
      ]
    },
    {
      "uid": "zhcn:757e211c7583c8bf31cab66d",
      "kind": "character_system_text",
      "source_text": "来吧。",
      "source_fingerprint": "d0fb22d63cfcb2e2e78399b13eaa4eff734162d1507e6bfb93a1a695cb8e40a6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20040"
      ]
    },
    {
      "uid": "zhcn:2d8a1d45ed97d922f04da49d",
      "kind": "character_system_text",
      "source_text": "好了。",
      "source_fingerprint": "8c1bb480ed0811432e377c03a073021704dea1af4170f367125bc0d9553854df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20041"
      ]
    },
    {
      "uid": "zhcn:db48f4b973442cfd347beba1",
      "kind": "character_system_text",
      "source_text": "诶诶！？",
      "source_fingerprint": "1d56bc1436af70c5ee5f61b07ea7fbe279895fb581c60b13476b29d6f4e350e4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20042"
      ]
    },
    {
      "uid": "zhcn:6fea58e3f189d7fafa46419e",
      "kind": "character_system_text",
      "source_text": "哎呀…？",
      "source_fingerprint": "55d62764ccc18450bc29a87356c49484cd31be597f6410d65689ef109e2fc74d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20043"
      ]
    },
    {
      "uid": "zhcn:1c2615149489af718b9726b7",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20046"
      ]
    },
    {
      "uid": "zhcn:ae98fa695157e94361da8779",
      "kind": "character_system_text",
      "source_text": "好期待呢。",
      "source_fingerprint": "684bfed99b8b8f954dca2f5169c4763a964877f3b4647f311b33387865e35a80",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20047"
      ]
    },
    {
      "uid": "zhcn:bf3ddd61bd30cbb34df1e742",
      "kind": "character_system_text",
      "source_text": "以这份经验为食粮，今后也要继续前进。",
      "source_fingerprint": "8f4a2bfe690c94b7b340b0990698a60ded963484728cf73783052b40c59b0d10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20049"
      ]
    },
    {
      "uid": "zhcn:8ff76445214d78b88987b2ba",
      "kind": "character_system_text",
      "source_text": "谢谢你陪我一路走来。",
      "source_fingerprint": "fa3afcd5cd8a0d4cd6503d25ad305710c3e588bc72a7d7a2605fb2e66633dbc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20050"
      ]
    },
    {
      "uid": "zhcn:ab3b369f03a4a92ce6ccbae5",
      "kind": "character_system_text",
      "source_text": "我可不会手下留情！",
      "source_fingerprint": "b8c6faa27e0713740a69c04d2581d36eed0726d8dfe74f0707615c8ccaa1206b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "20051"
      ]
    },
    {
      "uid": "zhcn:73f5f7600c633c3bef72f39f",
      "kind": "character_system_text",
      "source_text": "好了，要出发了！",
      "source_fingerprint": "849c0c3b42eb2774cbe0975112a27fbd3b244514467ef4ff9ae527ddc51556b7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "2030"
      ]
    },
    {
      "uid": "zhcn:9e5b53aea64c5f8304f0b41e",
      "kind": "character_system_text",
      "source_text": "大家都准备好了吗？",
      "source_fingerprint": "2bd62305465b83e9e8f57e9731002c19939ec50ac4ee6b53b035815eaa94a9ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "2031"
      ]
    },
    {
      "uid": "zhcn:ca95ecce571fc5a8631322d8",
      "kind": "character_system_text",
      "source_text": "谢谢你陪我一路走来。",
      "source_fingerprint": "fa3afcd5cd8a0d4cd6503d25ad305710c3e588bc72a7d7a2605fb2e66633dbc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "2032"
      ]
    },
    {
      "uid": "zhcn:8ab3870dfe6ec696f7ecebfa",
      "kind": "character_system_text",
      "source_text": "准备万全哦。\n无论什么情况\n都能灵活应对！",
      "source_fingerprint": "3900985fac1b6133652b90e6f8016332d7060ba8a33b32ea8617e64d4f3bd84a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "2033"
      ]
    },
    {
      "uid": "zhcn:b1d60f62640c948f92abc640",
      "kind": "character_system_text",
      "source_text": "没有什么无法超越的。\n只要心中深处\n怀有强烈的信念！",
      "source_fingerprint": "a61b6a7b895410ba5ee08e3334502bef0efdc31b6eec49aa664505cb34cfbdbf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "2034"
      ]
    },
    {
      "uid": "zhcn:7ed8aff55ae037d11399260d",
      "kind": "character_system_text",
      "source_text": "谢谢你陪我一路走来。",
      "source_fingerprint": "fa3afcd5cd8a0d4cd6503d25ad305710c3e588bc72a7d7a2605fb2e66633dbc5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "2035"
      ]
    },
    {
      "uid": "zhcn:50cfa031dda380f60d55295f",
      "kind": "character_system_text",
      "source_text": "走了！",
      "source_fingerprint": "fc2b0db28278f979f108f6e626eeaf8ff4553286870fbc94ddfa52a96348396a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "23015"
      ]
    },
    {
      "uid": "zhcn:f80374745873cb6e5a888a7d",
      "kind": "character_system_text",
      "source_text": "下次一定要赢给所有人看！绝对！",
      "source_fingerprint": "8d38a85d4cc915173bb3b20e3a4d6e33ee239d7b3405ca96c49062a05355d24f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "30000"
      ]
    },
    {
      "uid": "zhcn:f45da9144019553f836bb86d",
      "kind": "character_system_text",
      "source_text": "下次要更加更加强大，绽放光芒给你看！",
      "source_fingerprint": "1d93daa45677bb51e0a84fac32978d092c4cb5675627644587a95544a2dc3a56",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "30001"
      ]
    },
    {
      "uid": "zhcn:0df2b4347d7ae205d452b72e",
      "kind": "character_system_text",
      "source_text": "这不是终点…因为我还没有放弃！",
      "source_fingerprint": "8f1d8791cb58f3cb5a8ecf115d12843c9daac3d961c7ec549704e4723942895b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "30002"
      ]
    },
    {
      "uid": "zhcn:e121d01fb2e907d1fdd386cd",
      "kind": "character_system_text",
      "source_text": "无论多少次我都会重新站起来…不管多少次…！",
      "source_fingerprint": "6de809865cf25f27109dd8fb86162032bebc6f66b98fd0e8107645248d77f425",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "30003"
      ]
    },
    {
      "uid": "zhcn:8af7b46a161e3c6f074351d3",
      "kind": "character_system_text",
      "source_text": "杏目，绝不会输！",
      "source_fingerprint": "c2a1c592bdcc035331497013820317955718eadfc645a69000a53acdcd8c9c26",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "30004"
      ]
    },
    {
      "uid": "zhcn:01976cbf12981538b7bf89bf",
      "kind": "character_system_text",
      "source_text": "没有什么是我这双手抓不住的。",
      "source_fingerprint": "f679e2d7680fa986b33d4999693a7fcec310bea1cccdd930950053dffc947dcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "30005"
      ]
    },
    {
      "uid": "zhcn:6b69c1287151ca900fe9c4c1",
      "kind": "character_system_text",
      "source_text": "决胜的时刻！",
      "source_fingerprint": "61abca981c523b9c5cf0cba11ab77d05cecc5f37ba5ebe56c1bd23c831c6e46a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "31000"
      ]
    },
    {
      "uid": "zhcn:88b829139f4075e4529ef425",
      "kind": "character_system_text",
      "source_text": "不会输的，我可是杏目！",
      "source_fingerprint": "c2cf477ccdd95316a8e17f4cf9f8f2790c65af8cf960dd8ded80bc32399101f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "40000"
      ]
    },
    {
      "uid": "zhcn:ad020b4043a1c189dc277364",
      "kind": "character_system_text",
      "source_text": "唔，好耀眼……不过，我也\r\n绝不打算输给夏日的烈日。\r\n防晒霜的准备可是万无一失的哦！",
      "source_fingerprint": "e83f7f8e29c066f36176c3b59470d9e2b7228f088abf3cc1fe7c12434086361d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "400001"
      ]
    },
    {
      "uid": "zhcn:dd777ead3c1f378980555134",
      "kind": "character_system_text",
      "source_text": "哈～～～！居然什么都没做！！\r\n这么怠惰的夏天，有生以来还是第一次呢。\r\n――好啦，从明天开始加油吧！",
      "source_fingerprint": "91efd11175ab72b26636edd62ee006ef9ff21d1d354d66f84564833383b92446",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "400009"
      ]
    },
    {
      "uid": "zhcn:d4ccb4058dd40c9769199183",
      "kind": "character_system_text",
      "source_text": "赢下去，赢下去，一直赢下去…\n将谁都不曾见过的辉煌\n握在这双手里！",
      "source_fingerprint": "5afcb616ca8ebedc117ff08dc2c2842c546800684659f61b19679fe0407d8541",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "40001"
      ]
    },
    {
      "uid": "zhcn:f642102bcdbbf3b6baf941a1",
      "kind": "character_system_text",
      "source_text": "咕……天空小姐居然还在向我\r\n炫耀她在钓鱼大赛赢了的事……！\r\n明年，我绝对会赢得胜利的！！",
      "source_fingerprint": "21439ee053b6e9ab6695f68a6af1dd5775389308dabb7908ce63f791de1add5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "400014"
      ]
    },
    {
      "uid": "zhcn:a67be37220f1087eceeefa1d",
      "kind": "character_system_text",
      "source_text": "表现方面我也有自己的讲究。好好看着吧。",
      "source_fingerprint": "1dc63a3e24f87363d3902f905621ee2312c63ebafb7250a0f2b4aafd45471c7b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "60000"
      ]
    },
    {
      "uid": "zhcn:3452a49de9eb86707f5dc2eb",
      "kind": "character_system_text",
      "source_text": "摄像机的位置是这里，那里，还有…。",
      "source_fingerprint": "84c2261755f004da06e388b8384a9c2cb927169fedb686cf23fa870014399f3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1129",
        "60001"
      ]
    }
  ]
}
