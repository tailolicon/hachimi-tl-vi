      ]
    },
    {
      "uid": "zhcn:b2b022fbea8137cfec465a9c",
      "kind": "character_system_text",
      "source_text": "下一次一定，呢",
      "source_fingerprint": "3f461dade347a75d17886735d6ee754f96e38edf4539d7a81b8c5f6cb2c9c698",
      "source_path": "character_system_text_dict.json",
