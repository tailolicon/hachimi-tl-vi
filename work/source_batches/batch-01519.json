      ]
    },
    {
      "uid": "zhcn:41c2e559ba6c491b3ab6ecdb",
      "kind": "character_system_text",
      "source_text": "やっほーー。",
      "source_fingerprint": "97b43d52a5426622ab228edd553f61026dc518609642da41494736bc42573dfd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
