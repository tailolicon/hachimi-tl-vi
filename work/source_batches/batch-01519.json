        "140007"
      ]
    },
    {
      "uid": "zhcn:638d0394fa7028318413c9cc",
      "kind": "character_system_text",
      "source_text": "フッ。",
      "source_fingerprint": "caed08f480c9dfbce59cfe623a2b1d7feafa2d5ab231e00d7c2c7d2c984c48b8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140008"
      ]
    },
    {
      "uid": "zhcn:e6fcbba3e658e6fc4d6c45aa",
      "kind": "character_system_text",
      "source_text": "行きましょう。",
      "source_fingerprint": "6a651bfb029986fd12b0df87899450e7dfee294261171c169759f9164b1f855f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140009"
      ]
    },
    {
      "uid": "zhcn:b3322158e156d239a65d8322",
      "kind": "character_system_text",
      "source_text": "速攻あるのみ！",
      "source_fingerprint": "898313a14d8a7e521fd4373ed80cc95335fa17d9e6199c75445a923a5e8dc43d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140010"
      ]
    },
    {
      "uid": "zhcn:e54f3fc2e2fe857cbb0b7f00",
      "kind": "character_system_text",
      "source_text": "激熱です！",
      "source_fingerprint": "d8aa118fce677f8405ec91e8f479ad4d610862dcd782e58f861845ac2948afae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140011"
      ]
    },
    {
      "uid": "zhcn:3bf6cb1f6a59549fed3a9528",
      "kind": "character_system_text",
      "source_text": "来た来た来たぁ！",
      "source_fingerprint": "11eb70032b8e06feed46a313a03f5d1330c078adb746f665a8b6f19bc06588d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140012"
      ]
    },
    {
      "uid": "zhcn:37c991ee88aa7c4edb9ddca5",
      "kind": "character_system_text",
      "source_text": "一気ぃ！",
      "source_fingerprint": "c93caaa4e3ac628ff5dfd1889d7010dd0c7a604e22b9ab5f9e059839066cf86e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140013"
      ]
    },
    {
      "uid": "zhcn:f277a135d08101b9a645c57a",
      "kind": "character_system_text",
      "source_text": "なっ！？",
      "source_fingerprint": "f2d8bfa60dd0b93804b6f0e1b99dfc49d01cebafd6dac9df7fd909eb89d81055",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140014"
      ]
    },
    {
      "uid": "zhcn:63673c378ef6c4b0211a56b6",
      "kind": "character_system_text",
      "source_text": "ガバッと！",
      "source_fingerprint": "19b66f8cc0b05f6d524aa9e255d0f6611d413b1eb0ff17bf216a3c2ef8f86ea2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140015"
      ]
    },
    {
      "uid": "zhcn:2d32f88f527d5cc26ddaf825",
      "kind": "character_system_text",
      "source_text": "さぁ速く！",
      "source_fingerprint": "61a7d60bb219d54f29392c6d485efb954ed9936463d3140fc33618b156c49fde",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140016"
      ]
    },
    {
      "uid": "zhcn:c661b2d57f288da75474eea1",
      "kind": "character_system_text",
      "source_text": "ああっ！？",
      "source_fingerprint": "4e6cafc8a40a4267b54b70088ec0d17da7ee81c023edd73f2bd686b814c132ad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140017"
      ]
    },
    {
      "uid": "zhcn:e4430562204e34a348cb4fcc",
      "kind": "character_system_text",
      "source_text": "さらば！",
      "source_fingerprint": "c8c710fb34c84ac3b0a6b571a165e586f491aac0a5c9b1807ad6e83c90eaad82",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "140018"
      ]
    },
    {
      "uid": "zhcn:cb5718082735f7f9f4181170",
      "kind": "character_system_text",
      "source_text": "明日はこちらが。\r\nくっ、早く欲しい！",
      "source_fingerprint": "61df293a4507d69df010123c24cf0b53c916b8c291e66d2f16490378c1e689a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "15"
      ]
    },
    {
      "uid": "zhcn:a58473473d3cc39af5cbbc7d",
      "kind": "character_system_text",
      "source_text": "はい。ふらふらです。\r\n仮眠用布団は持ってきているので、\r\nいつでも最速で横にはなれますが？",
      "source_fingerprint": "ad8887a4cf6a84c01aba86bcbcc1262a32804288c92a6da78bc744b7a9dc9a89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20000"
      ]
    },
    {
      "uid": "zhcn:2bb4b2a8521ceb3f97f5dfa2",
      "kind": "character_system_text",
      "source_text": "ぐぅぅぅぉぉぉぉぉ…！\r\nはっ、いかん！光速で\r\n寝落ちしてしまった…！",
      "source_fingerprint": "6af9114da653cca98e9b09a03af277bfd00fc3e7cca7f6236aa21403ff4339d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20001"
      ]
    },
    {
      "uid": "zhcn:c5bdf3e44e4295e7e98054bf",
      "kind": "character_system_text",
      "source_text": "フッ、貴方が来る前にガゼル、\r\nキリン、パタスモンキーを倒して\r\nしまいましたよ。脳内レースで。",
      "source_fingerprint": "adf6b75ba7dac24bfb4b93361f6d339504ef06d4ec49c016061ee884fe8f712a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20002"
      ]
    },
    {
      "uid": "zhcn:176c46b2d7b8970cfcdc900c",
      "kind": "character_system_text",
      "source_text": "私のやる気グラフはぐんぐん\r\n斜め上！今日も己の最高速を\r\n塗り替えていきますよ！",
      "source_fingerprint": "1352c69792f4417aaf89128c87f8bbb5e7a46c3fd62cbff827f3583911c1e22b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20003"
      ]
    },
    {
      "uid": "zhcn:8253456c5a6555ebfc7aa646",
      "kind": "character_system_text",
      "source_text": "髪直線、折り目も直線、\r\nやる気はもちろん一直線！\r\n始めましょう、トレーナー！",
      "source_fingerprint": "2bd7ebbd7d129c08f31eb86118a919ef01d1a49cd0c2a203ff52caa460edcb69",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20004"
      ]
    },
    {
      "uid": "zhcn:1fd6c8f1dbb545c9ac6efaa9",
      "kind": "character_system_text",
      "source_text": "トレーナー、私の姿は見えて\r\nいますか？よかった、知らぬ間に\r\n光速になっちゃってたかな、と。",
      "source_fingerprint": "b2be69a95551dcb980c283e116e23f07b7ce6b278075a5c89c8a6a5d4a0f1f5a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20005"
      ]
    },
    {
      "uid": "zhcn:27f2ccd321d004e402d0996a",
      "kind": "character_system_text",
      "source_text": "気づいたら体がウォーミング\r\nアップを済ませていましたよ。\r\n私の体は思考をも置き去りにする。",
      "source_fingerprint": "61440ba67771b876529fe4448c3a876f7b8a1d693b38761f9a86cabfbc227c39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20006"
      ]
    },
    {
      "uid": "zhcn:f8431b8d941641ed2d9c2bc3",
      "kind": "character_system_text",
      "source_text": "太陽光線…いつか、お前の\r\n速さも超えてみたいものだ。",
      "source_fingerprint": "6584e698f11547ee955cf6970e724ac6e459c824361bd9e8eae324f670dc3640",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20007"
      ]
    },
    {
      "uid": "zhcn:7e15cbc1ab4f21d52bade3b0",
      "kind": "character_system_text",
      "source_text": "私のモチベが垂直落下…！\r\nくっ、ここは曲線に堕ちようと\r\n上向きへ回復を狙うべきか…。",
      "source_fingerprint": "41da222b9f97bd007be0f6d5c12b2b664ca0cc2748da3c4de3c537903bd8f543",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20008"
      ]
    },
    {
      "uid": "zhcn:f4bbede2ef7b0e6dce570300",
      "kind": "character_system_text",
      "source_text": "どうも気分が…くっ…、昨日\r\n割りばしを真っ直ぐ割れなかった\r\nのを引きずっているのか…私！？",
      "source_fingerprint": "b45d10847e497c6d415ec0adc8051e7557c394d68d2d66cb92221974c84d922f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20009"
      ]
    },
    {
      "uid": "zhcn:38a894c8b22fe5beceffbc0a",
      "kind": "character_system_text",
      "source_text": "今の私は亀…いや、ナマケモノ。\r\nはたまた秒速0.04cmしか出ない\r\nタツノオトシゴ…？な気分です。",
      "source_fingerprint": "97ea560c56fba39f2e6405dca0acefa5fd226bd3de6759e38428d2f4daec8fd0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20010"
      ]
    },
    {
      "uid": "zhcn:b58436c632badcc9d8b56647",
      "kind": "character_system_text",
      "source_text": "…いや、私はいつも通りです。\r\nただ体が重くて気も重くて脚も\r\n重くて思うように走れないだけで。",
      "source_fingerprint": "1f4ab42c58f7e7a8b6be2f2e94037c2802c74e73723a91f3570f25932587a000",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20011"
      ]
    },
    {
      "uid": "zhcn:9701348217ba34dea673dadf",
      "kind": "character_system_text",
      "source_text": "またレースですか…いえ、そろそろ\r\n休みましょう。なんなら温泉。\r\nなんなら脚揉み120分コース。",
      "source_fingerprint": "6cd78803cebf264fbc0efd1195cdead748efe48495cafe817920be63cded852e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20021"
      ]
    },
    {
      "uid": "zhcn:368e9a0405265fd42f7f78b8",
      "kind": "character_system_text",
      "source_text": "出走しすぎでへとへとです。\r\n今は眠りたい。横になりたい。\r\nなにも考えずゴロゴロしたいーっ！",
      "source_fingerprint": "f7bb4b47f0e6972ffbb8ed3eff5dc9fd2162697a34dc224977e8108d4872e7ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20022"
      ]
    },
    {
      "uid": "zhcn:389de46ecacef13de10a2a85",
      "kind": "character_system_text",
      "source_text": "地球最速の生物とは誰か。\r\nまさに今日、それが\r\n決まることでしょう！",
      "source_fingerprint": "4fe8e7f762147ff8a0578d870894c51011ec6f5c0338f3fe0a91dc7a14724357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20023"
      ]
    },
    {
      "uid": "zhcn:00f8e009b237cfd981a51a34",
      "kind": "character_system_text",
      "source_text": "今こそターフに刻んできます。\r\n光の軌跡…摩擦で消えない足跡を！",
      "source_fingerprint": "4428557895258daf069ce71b36dbfddb30de4cb27387fd833eda4dfcd718c493",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20024"
      ]
    },
    {
      "uid": "zhcn:bfae9444ecaff9fff1a62157",
      "kind": "character_system_text",
      "source_text": "いくら眩しくても目は閉じないで\r\nください。今日お見せするのが\r\n光速を超えた、私の最高速です！",
      "source_fingerprint": "4d57990bc9eb7a96973cd4c618293c550518d4ede6ea6c968a3f44c9fea3230e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20025"
      ]
    },
    {
      "uid": "zhcn:cafde63b7922042c8ce48dad",
      "kind": "character_system_text",
      "source_text": "フッ、今日のお客さんは幸運だ。\r\n誰も見たことのない速さ、\r\nそのお目目に刻むといい！",
      "source_fingerprint": "6e4dad56e2c96b554159f184ec3e54662f430dcfabec838213268309195a3b42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20026"
      ]
    },
    {
      "uid": "zhcn:9d48f2589fed3d64a0bc234c",
      "kind": "character_system_text",
      "source_text": "うーむ、心配です。…私、速すぎて\r\nカメラに映らないのでは、と…。",
      "source_fingerprint": "7145f2b0c14f5a28f8e04c4d0f19649fe35e6dc560dbb3c3c4e56346c68a9730",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1120",
        "20027"
      ]
    }
  ]
}
