      ]
    },
    {
      "uid": "zhcn:b4158de5eebbc02b34ea1052",
      "kind": "character_system_text",
      "source_text": "抓到了好多呢！",
      "source_fingerprint": "3dbd2b65dbcfdeb2288eeca4b02f874363cefb23867d2bc19aa4882d304a9cb8",
      "source_path": "character_system_text_dict.json",
