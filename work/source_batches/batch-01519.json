      ]
    },
    {
      "uid": "zhcn:f11dd3a2e32e1ee459a9baa6",
      "kind": "character_system_text",
      "source_text": "呵呵，哪个孩子都很可爱呢♪",
      "source_fingerprint": "bacaf6a483fccb385513681f9d23c43103b1beab34fa7331faf0c39ccab246ad",
      "source_path": "character_system_text_dict.json",
