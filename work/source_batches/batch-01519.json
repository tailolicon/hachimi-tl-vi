      ]
    },
    {
      "uid": "zhcn:43c458d4a474b0e74713c066",
      "kind": "character_system_text",
      "source_text": "呵呵。",
      "source_fingerprint": "c261f8470e6b951068e0d77063c43fa4dad0595f35b1742681492d1a2f963251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140008"
      ]
    },
    {
      "uid": "zhcn:44891fb7490d261d19b2a8fb",
      "kind": "character_system_text",
      "source_text": "那个。",
      "source_fingerprint": "f8718a774e82bf0d0567f91b1ad1c262e88c616da40600ba104bed8a79cabc36",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140009"
      ]
    },
    {
      "uid": "zhcn:7170e55b44565ffed2114821",
      "kind": "character_system_text",
      "source_text": "呵呵呵，我看到了哦！",
      "source_fingerprint": "35f4f04ac209471c5bd2e2fa512eb1ea9ddda52eae49e208a7e897c3bbc0dbcc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140010"
      ]
    },
    {
      "uid": "zhcn:cd43651ae9d21f0016e40a4c",
      "kind": "character_system_text",
      "source_text": "哇，好厉害……！",
      "source_fingerprint": "e10dae33a54654cd7c0fb6159cbc1c41b07ec679e42adc6e1f00b59c3113843f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140011"
      ]
    },
    {
      "uid": "zhcn:082e63dc10435363de6e01af",
      "kind": "character_system_text",
      "source_text": "真让人心跳加速呢……！",
      "source_fingerprint": "08e8cf86b6c8f4259164f617322f92d5339f5c945ad8eee68aa711e6e972ceb7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140012"
      ]
    },
    {
      "uid": "zhcn:9f708678cb42eaa386736c77",
      "kind": "character_system_text",
      "source_text": "慢慢地，慢慢地……。",
      "source_fingerprint": "321d8fc6bbd9be7061eafd016df84f2b71e284790136b4fa4422e42ca31a86a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140013"
      ]
    },
    {
      "uid": "zhcn:3013aeb6a7c2eee24c280583",
      "kind": "character_system_text",
      "source_text": "啊！",
      "source_fingerprint": "81c28a42b8af498807476919251caa5ba6f641f655e63b78274946de67cc1a0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140014"
      ]
    },
    {
      "uid": "zhcn:9a1a9e8c8beab139bde16b11",
      "kind": "character_system_text",
      "source_text": "唔～。",
      "source_fingerprint": "185e5912692e62349d49c372e1c237699ccf93f7e02103e3077ce4c27c3a4f7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140015"
      ]
    },
    {
      "uid": "zhcn:ba25d9232d66747b131962ce",
      "kind": "character_system_text",
      "source_text": "看清它吧！",
      "source_fingerprint": "1db0db129198cbec69aaea391955a7144839e693a04d7d6ef13966cbffd3a713",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140016"
      ]
    },
    {
      "uid": "zhcn:1325ad9c5f7dc8959cd1b494",
      "kind": "character_system_text",
      "source_text": "真遗憾～。",
      "source_fingerprint": "becefb4b50b79e69c398d4b309a4da36261d9df3ae06cd5b172d731b2a3202b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140017"
      ]
    },
    {
      "uid": "zhcn:078be05e7e7354bddce2efc0",
      "kind": "character_system_text",
      "source_text": "再见。",
      "source_fingerprint": "06263c2d6ffcb55ac60d57cc5c4aa66e6d80645255d42754eea992819e6ecfb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "140018"
      ]
    },
    {
      "uid": "zhcn:e03aff67c885819c826b1966",
      "kind": "character_system_text",
      "source_text": "明天我会为您准备这个。",
      "source_fingerprint": "f8246de2c2722b6f157d8fee86c93e37548f1cede2d3327a483206008441fe3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "15"
      ]
    },
    {
      "uid": "zhcn:133ca3cdf608768a2d411fa9",
      "kind": "character_system_text",
      "source_text": "今天的训练菜单是。\n……训练菜单是——\n……咦，咦？",
      "source_fingerprint": "c64ccb8e044d8a44011c6e14fd6a014116be01c1bb94b4de1b1b793fddc357fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20000"
      ]
    },
    {
      "uid": "zhcn:42df66916f63727aa2fcd31b",
      "kind": "character_system_text",
      "source_text": "……这里是必须强行突破的局面吗。\n必须对受伤细心注意。",
      "source_fingerprint": "5eb29a8b62c2f817071a479ec2f75a181b09a5322d52c6538e6de2d8a6753617",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20001"
      ]
    },
    {
      "uid": "zhcn:6e5804f0d303081f0ff4c340",
      "kind": "character_system_text",
      "source_text": "呼……。\n……氧气遍布了全身。\n如果是现在，似乎连大海也能跨越。",
      "source_fingerprint": "659a8ecf5ef1427094bc0cea1d76a5bd26fd2bf5771302d69fc89f1a85b6f120",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20002"
      ]
    },
    {
      "uid": "zhcn:682f6a0bf8b1853784c1cbd5",
      "kind": "character_system_text",
      "source_text": "我也准备好了完美的辅助食品！\n我们要进行大量的训练哦，\n训练员！",
      "source_fingerprint": "bde64011e22c14aa882e39a76f39477ff567db702ded081889a2552aa281fb89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20003"
      ]
    },
    {
      "uid": "zhcn:78a82ddd8a65e9dfeb5af3eb",
      "kind": "character_system_text",
      "source_text": "开始吧。今天，\n感觉能获得新的发现。",
      "source_fingerprint": "eed3b115a9183a6ca7cd85d96bf4efa033fe46b258bfc4e098c67379d62c31e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20004"
      ]
    },
    {
      "uid": "zhcn:821145653cc7940ef72d3a61",
      "kind": "character_system_text",
      "source_text": "今天的编发\n比平时编得更漂亮了♪\n这是个好兆头！",
      "source_fingerprint": "8ffd2325038f497b105debae7746429c2da68c0814142fe9e11297d12dc65170",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20005"
      ]
    },
    {
      "uid": "zhcn:4278945cbf286233d27e6f62",
      "kind": "character_system_text",
      "source_text": "平坦的道路好走但也容易厌倦。\n因此……平日的休息必不可少。\n转换心情，也纳入考量吧。",
      "source_fingerprint": "f324320b359a2139deb7b24dfa82cd3cfc3ab9a52c6271dda981320a8e4fbbac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20006"
      ]
    },
    {
      "uid": "zhcn:47cda28efbff5736785e7da9",
      "kind": "character_system_text",
      "source_text": "嗯～天气真好啊，训练员！\n把被子拿出来晒真是太好了！\n莱茵力量也会很开心的吧。",
      "source_fingerprint": "e5ede13ed7a4534915b33aa693f3043e857df8d07d922405cb028f15f8dab0b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20007"
      ]
    },
    {
      "uid": "zhcn:e988a94cb9ca444dbbf47601",
      "kind": "character_system_text",
      "source_text": "今天，身体稍微有点不适……。\n麻烦您了，可以请您调整一下\n菜单吗？",
      "source_fingerprint": "9ffe1949c056f24e9f41abbe9675c9e18543835e353ca4486c274557daacf824",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20008"
      ]
    },
    {
      "uid": "zhcn:43be3759353ea80b9c0f1c19",
      "kind": "character_system_text",
      "source_text": "……如果尽情地\n搅拌鲜奶油的话，\n会不会稍微丝滑一点呢……？",
      "source_fingerprint": "5f440d54343be886b96e1a8d4080e8bd67d10d178c1ca065433d349eb260e1f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20009"
      ]
    },
    {
      "uid": "zhcn:663a0b74e353ca9715e476a7",
      "kind": "character_system_text",
      "source_text": "……啊。呃——……嗯。\n差不多该开始了吗，训练员。",
      "source_fingerprint": "88ea4fa00710bb5aab125a871e2b7c0e04fbc56c0cef57cd0effd9887ebc265e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20010"
      ]
    },
    {
      "uid": "zhcn:5b5572a83ecc06ddcacca679",
      "kind": "character_system_text",
      "source_text": "呼……。\n……不要因为这种程度就停下脚步，\n西沙里奥。",
      "source_fingerprint": "0d8ce9c90a717f967f1f11c3fe6c1285add8ef772c7d0f3970c9b4302297eaf2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20011"
      ]
    },
    {
      "uid": "zhcn:67c781dcb1ca8580ee9bdbc3",
      "kind": "character_system_text",
      "source_text": "请在权衡风险之上，\n再探讨一次。训练员。",
      "source_fingerprint": "463feafded3d099479064813cced410acf4642916555efb17cf475a65514d84f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20021"
      ]
    },
    {
      "uid": "zhcn:e76889a833190d9a91ba9973",
      "kind": "character_system_text",
      "source_text": "……训练员。那个选择的前方，\n有我们的梦想吗？",
      "source_fingerprint": "a25000ebd6c936d0369e2d4affa3569bbbeb06522cb2517a2c4e914c2a58fdcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20022"
      ]
    },
    {
      "uid": "zhcn:3a5380887b75d06ec7ba2201",
      "kind": "character_system_text",
      "source_text": "……完美的调整，训练员。\n作为将来志在成为指导者的人，\n我甚至对此抱有憧憬。",
      "source_fingerprint": "9443571a37a5aa85fffce4b42df2ff0ddcd66376336c912d7124af61775d440c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20023"
      ]
    },
    {
      "uid": "zhcn:6185219599147e38e639ab13",
      "kind": "character_system_text",
      "source_text": "骄傲是最大的敌人。\n要比平时更绷紧神经……\n赢下来吧。",
      "source_fingerprint": "44ccb511806c6365fbeb52cb5e76b01cb387c828b2ed8a196499985d31542702",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20024"
      ]
    },
    {
      "uid": "zhcn:2dce76a7a238faaec9410d1a",
      "kind": "character_system_text",
      "source_text": "历史，未来，皆由比赛诉说。\n而我——唯有怀抱志向，奔跑不息。",
      "source_fingerprint": "9016bfded67c55876c130cf9a391624194a2bcb664fe475c32db2e84fb1bf2b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20025"
      ]
    },
    {
      "uid": "zhcn:0f2dd59481b82d8e4af8d722",
      "kind": "character_system_text",
      "source_text": "身体状况万无一失。\n……我会十二分地发挥您的教导，\n定将胜利赢取到手。",
      "source_fingerprint": "2c94a6c26d799ab583cadc72aee13e302234325d531ec9886830339ebd9d5908",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20026"
      ]
    },
    {
      "uid": "zhcn:242a3be348261cece0eeccac",
      "kind": "character_system_text",
      "source_text": "……以胜利为目标是理所当然的，\n但今天我还能享受比赛本身。\n我有这种预感。",
      "source_fingerprint": "a69f3fa386afdf5e3a5242b4a35ea61b3c21b83d50026027082e30aa18da2496",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20027"
      ]
    },
    {
      "uid": "zhcn:17f6d7b86120eead0d0061d9",
      "kind": "character_system_text",
      "source_text": "吸、吸、呼～。……我在调整，\n以免情绪过于高涨。\n吸、吸、呼～……。",
      "source_fingerprint": "11fef1215111f4832559a32fabf4ebe309578784eaa32d9ffc41fef2a54764ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20028"
      ]
    },
    {
      "uid": "zhcn:5b9e2d0b3e19c6db9ecfd4c6",
      "kind": "character_system_text",
      "source_text": "训练员。准备，完成了。\n——出发吧。",
      "source_fingerprint": "cc35923f113ba595cb10a85850894b6066a610e2acfa71eef8f8737d50b4f1c3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20029"
      ]
    },
    {
      "uid": "zhcn:6e955633f34e2343172931ff",
      "kind": "character_system_text",
      "source_text": "状态不好也不坏……但是\n除了『好』以外全都是『坏』。\n不要骄傲，挑战吧。",
      "source_fingerprint": "9947bd517832584ad8d89672dbc29a6fd681cd9288f8feb65ffbe5b3af817784",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20030"
      ]
    },
    {
      "uid": "zhcn:657cc7ce415c9ea543ce684c",
      "kind": "character_system_text",
      "source_text": "平日的姿态，\n正是许多人视为榜样的身姿。\n哪怕是一秒，也不能松懈。",
      "source_fingerprint": "0b3e6b4cbaeac980ce3de5eb76ba4ff88509ed9895d25652cc3919c40440ef87",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20031"
      ]
    },
    {
      "uid": "zhcn:7770187683b5c919afd3c5d2",
      "kind": "character_system_text",
      "source_text": "这种程度的不佳，\n总能挺过去的吧。\n……所以请放心，训练员。",
      "source_fingerprint": "d42555d6d21f4bdb4a693c9e9f18d1fa4ab2eb23937d50ccc5aad44ed5c60684",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20032"
      ]
    },
    {
      "uid": "zhcn:c818fb0e18c7bf34703c648a",
      "kind": "character_system_text",
      "source_text": "不佳的原因是……不。\n首先要集中精力在眼前的比赛上。\n——吸……呼——……。",
      "source_fingerprint": "1a442d46d981cb02adae3a06fc3d14bfba3261c1661db32dbc74ed29790ddbc7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20033"
      ]
    },
    {
      "uid": "zhcn:ba14668b9c58b219b0ed81ef",
      "kind": "character_system_text",
      "source_text": "『逆境给人带来的教训，\n没有比这更美好的了』……\n无论什么结果，都将其化作精神食粮吧。",
      "source_fingerprint": "796499c4ad02e6ca6129b58bae2341fa71ef907bf7195c22a51542f222d5c335",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20034"
      ]
    },
    {
      "uid": "zhcn:5029762927d47731f2b81776",
      "kind": "character_system_text",
      "source_text": "如果是和您一起，就能跨越过去。\n即使跌倒，也能重新站起。\n……所以我，奔跑。",
      "source_fingerprint": "e720d5e80dfc07acccceb0dda7759833f4d5b88bd641c56ac278fff798347bad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20035"
      ]
    },
    {
      "uid": "zhcn:41e5aeb0c426878f205f6afb",
      "kind": "character_system_text",
      "source_text": "……纵使狼狈，也要挣扎。\n这也是，能向未来展示的姿态。",
      "source_fingerprint": "153a400164839ebcdc3163b3dc5e2d7b747c3ecdd602a5c975f80adaf41d5cf3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20036"
      ]
    },
    {
      "uid": "zhcn:9a62ae75e0c5c11f340b1201",
      "kind": "character_system_text",
      "source_text": "……我会发挥出现在的全力。\n至少，要跑出能让观看的人，\n对下一次抱有希望的步伐。",
      "source_fingerprint": "ccce0457d66907cbb99ba442a799b369bfe340256255f921e9d1591f4af9e60b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20037"
      ]
    },
    {
      "uid": "zhcn:84c542538c7282f745c5743e",
      "kind": "character_system_text",
      "source_text": "开始！",
      "source_fingerprint": "3a1bc8931ce94cb5b2de86270e03f2d4b9a446effa7ceaa56679c173e0781ab6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20038"
      ]
    },
    {
      "uid": "zhcn:031ae151f851cd39a250e2c2",
      "kind": "character_system_text",
      "source_text": "了解。",
      "source_fingerprint": "0157e6aed55c5c02d6a5db10de6381ff48cf5d42afdf83c802629cb18e71b92a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20039"
      ]
    },
    {
      "uid": "zhcn:e2ada30d88276ba60971ac03",
      "kind": "character_system_text",
      "source_text": "走吧。",
      "source_fingerprint": "f0f0665e0a69c08888c3252e4588492414e62eb2a101e0b2a5a81f3189d824bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20040"
      ]
    },
    {
      "uid": "zhcn:ea2cd623b6d67c85a4ddb1b6",
      "kind": "character_system_text",
      "source_text": "呃……。",
      "source_fingerprint": "fd976ee0fc827bf53e8b4dfd600cac2a35380cea7cfb32aa3ccade75d5c23801",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20041"
      ]
    },
    {
      "uid": "zhcn:3bb96926d72240011f680663",
      "kind": "character_system_text",
      "source_text": "咕！",
      "source_fingerprint": "68df8ac3c6b4cc5069d950e02912c1a576c88068cad9615e83ba632bfd038539",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20042"
      ]
    },
    {
      "uid": "zhcn:f4cb8a960ec975655167ec5c",
      "kind": "character_system_text",
      "source_text": "要复习呢。",
      "source_fingerprint": "cb5c2a444647d039ebd1890f8b3c47987a845c55d24def4889f1d667125b3f15",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20043"
      ]
    },
    {
      "uid": "zhcn:3fcfb67d19ecb58cbdf6b0fe",
      "kind": "character_system_text",
      "source_text": "出发！",
      "source_fingerprint": "663f67e6d36e16231932887bb1e3eb2db26e1fb205d758f58e5da16072deb3e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20046"
      ]
    },
    {
      "uid": "zhcn:66ffa0e51209fc082ffb9ebc",
      "kind": "character_system_text",
      "source_text": "哇，好凉呢♪",
      "source_fingerprint": "b117f32231cb01473521d12453fc21f42b89f41529e4a03312484bbc7de2c026",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20047"
      ]
    },
    {
      "uid": "zhcn:a84433c986594f33e792299e",
      "kind": "character_system_text",
      "source_text": "感谢您的献身。",
      "source_fingerprint": "836622c2efe593037be1b1e8a1fb4326e16cdbf71f6048d3d898ac59f7496648",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20049"
      ]
    },
    {
      "uid": "zhcn:48ee4736694041e691802709",
      "kind": "character_system_text",
      "source_text": "将这份经验，也化作精神食粮吧。",
      "source_fingerprint": "c830075becd75ccbdf52718b2b91aa89781c814488947d338e778d8378b38741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20050"
      ]
    },
    {
      "uid": "zhcn:4e06f4edaea547ed34e7bf9c",
      "kind": "character_system_text",
      "source_text": "共同钻研……！",
      "source_fingerprint": "4dc3cc4d8e94b4b2aa0af10e6ca5c7f8c07b2091bb30e578136a5aab9346968d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "20051"
      ]
    },
    {
      "uid": "zhcn:d02d0b27b6f99526b94a23bc",
      "kind": "character_system_text",
      "source_text": "让我们彼此，跑出一场精彩的比赛吧。",
      "source_fingerprint": "c9ffed4c89a0badfdfdf5bd7d66dbfe0aa8f2e1f5865b9c107931338f86e9948",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1110",
        "2030"
      ]
    }
  ]
}
