        "20030"
      ],
      "json_pointer": "/1130/20030"
    },
    {
      "uid": "zhcn:f8700b978c7ab54ea47c2ee5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "（没有呆毛翘起来吧？\r\n…有些在意。稍微确认一下吧）",
      "source_fingerprint": "008062b626f923aa0f2c752c2a8dd7636fcb00052f044c88f4639aab01207718",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
