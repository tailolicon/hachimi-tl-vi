      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "刷新纪录了呢。",
      "source_fingerprint": "bbd54b5d65ed7ad95de265a239cd7e0357feca6ed137778f4af2090df7519eb4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
