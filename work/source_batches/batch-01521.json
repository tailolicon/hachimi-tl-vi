    },
    {
      "uid": "zhcn:c96c98ce534393df23b56ac8",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
