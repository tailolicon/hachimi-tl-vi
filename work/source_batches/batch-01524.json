      ]
    },
    {
      "uid": "zhcn:901f2ea8e597d8e2bc4ae927",
      "kind": "character_system_text",
      "source_text": "ふふっ。",
      "source_fingerprint": "dbc78ca5d65302a8b38bec657661270c58ae9fac943c1c718a7fa71c2d75ec30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140008"
      ]
    },
    {
      "uid": "zhcn:180a773fb0874deb0ff0bac5",
      "kind": "character_system_text",
      "source_text": "おお。",
      "source_fingerprint": "814ef8057d42a4cc032810c30b97f2680826f426f26b6019f67fd1e04c31283c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140009"
      ]
    },
    {
      "uid": "zhcn:df82ba98c11137e7b3179d1f",
      "kind": "character_system_text",
      "source_text": "頑張れ～。",
      "source_fingerprint": "64cccb9748ff2ba13e4c4edec43858ad672a39fbb1f414e87f3fc5921b942219",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140010"
      ]
    },
    {
      "uid": "zhcn:0d21443945b18e4e57ff891f",
      "kind": "character_system_text",
      "source_text": "仲良しだね♪",
      "source_fingerprint": "721e24a81fde8c8502d763c8de29f105759c8059b0f707bd9d85660223f83d3d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140011"
      ]
    },
    {
      "uid": "zhcn:34f1e1a430c3c173b4f45fe8",
      "kind": "character_system_text",
      "source_text": "おおっ、そのまま…！",
      "source_fingerprint": "88efee236d3e301741a85dcbc3643f8bab4217eea185bdb40b0c9c0fd3af6e8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140012"
      ]
    },
    {
      "uid": "zhcn:ce4c7a326d1654157618c610",
      "kind": "character_system_text",
      "source_text": "カワイイ、カワイイ♡",
      "source_fingerprint": "2f4b039911b5c85cf7f9d958ce1b5ba5cc9f5993a7e30d13b331019da41add5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140013"
      ]
    },
    {
      "uid": "zhcn:d9344e435a6e5cf0d45b02b5",
      "kind": "character_system_text",
      "source_text": "あぁ～…。",
      "source_fingerprint": "1c6a912ff16639f71ab3fb0ee324efad244e72493124a682ad31d2a234315ac9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140014"
      ]
    },
    {
      "uid": "zhcn:d47cd69a856ae0d0cb1eacc4",
      "kind": "character_system_text",
      "source_text": "いけ～。",
      "source_fingerprint": "2d26ab508d752311a80bd57d009827b7ccfa666dda4549d4db619d1cacfbd958",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140015"
      ]
    },
    {
      "uid": "zhcn:00ba29c1b77e19afeef0875a",
      "kind": "character_system_text",
      "source_text": "どうしたの？代わろうか？",
      "source_fingerprint": "74de1b297de8b8585ec9ac8986af7c034e69a927f7b8a25c146fbdf59441f2b5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140016"
      ]
    },
    {
      "uid": "zhcn:77fbdd32511e58d3287c4aed",
      "kind": "character_system_text",
      "source_text": "ごめ～ん～痛いよね～。",
      "source_fingerprint": "97481a8e5feed836d402670d477d872c51c443251546478fe8e482b45f2df12d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140017"
      ]
    },
    {
      "uid": "zhcn:bc6efc642ddace01147ff11b",
      "kind": "character_system_text",
      "source_text": "はっ！",
      "source_fingerprint": "dd64f4a5b653f7f2d0a46a7face8239f04bafad1cb2dabfd4404ed16d78ec5a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140018"
      ]
    },
    {
      "uid": "zhcn:bc6b8917188991aec4d1d41d",
      "kind": "character_system_text",
      "source_text": "明日はこれだって。楽しみだね。",
      "source_fingerprint": "9601230d9eb91834c7ead305cc18569bf05c5d77d8b6ca3df77095e18f86d5ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "15"
      ]
    },
    {
      "uid": "zhcn:b0d0fd179580b5f99d0d1c13",
      "kind": "character_system_text",
      "source_text": "『やれる…私はやれる…』\r\nこの程度の疲れなら、まだ。",
      "source_fingerprint": "0e16e55417c6dccd2e6c6c0dd3d57433b2c696878d9ca51dfd14ac175486557f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20000"
      ]
    },
    {
      "uid": "zhcn:c491a078062595fce23a479d",
      "kind": "character_system_text",
      "source_text": "この状態でのトレーニングは\r\n効果的とは言えないかも…。\r\n休養を挟むのはどうかな？",
      "source_fingerprint": "759d009939249296da9126bc042247727c844afe6966c1f3692040105d527e63",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20001"
      ]
    },
    {
      "uid": "zhcn:dfb7779e82315c2f53434e71",
      "kind": "character_system_text",
      "source_text": "『私は最高の成果を上げる！』\r\n…よし、始めよう！\r\nいいトレーニングができそうだ！",
      "source_fingerprint": "93f26a759d30629f446ef09fe7746a8e05f6ea6b29304776db5b6a8e84a55c9d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20002"
      ]
    },
    {
      "uid": "zhcn:783e0e3838619f7a141cd107",
      "kind": "character_system_text",
      "source_text": "うん、わかる。今日はやれる！\r\n期待してくれていいよ、\r\nトレーナーさん。",
      "source_fingerprint": "3e9ca234ea4b6c0a3872528bb004a9e9070371a6206c274253c96e2b03bf3e76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20003"
      ]
    },
    {
      "uid": "zhcn:bc8c4c4cbbd84c9b0eccbe6c",
      "kind": "character_system_text",
      "source_text": "トレーニングあるのみ！だよね。\r\n基礎を大事に積み重ねていくのが、\r\n1番の近道だ。",
      "source_fingerprint": "dba938199d11082234a01a09483639a1a9a0aefa8bc7ad9a4d3bc3b73588ef0d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20004"
      ]
    },
    {
      "uid": "zhcn:39222de9acaa55f071653c18",
      "kind": "character_system_text",
      "source_text": "今ごろ幼馴染のみんなもどこかで\r\n頑張ってるんだろうな…。\r\nふふっ、負けられないね！",
      "source_fingerprint": "c91a97c65f738a0d20f852cd7c1dc88ca4ff5e5ad70b79e9dab2e26c24d382fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20005"
      ]
    },
    {
      "uid": "zhcn:cea0cffd24bfb900da98e836",
      "kind": "character_system_text",
      "source_text": "準備はできてるよ。\r\nいい感じにリラックスできてる。\r\nさあ、やろうか。",
      "source_fingerprint": "354a8a03fb52ebee84c83cb063713c3486747721dfeda34cb79d0f8c592e3f3d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20006"
      ]
    },
    {
      "uid": "zhcn:8cabffac1ae3e3416e51be72",
      "kind": "character_system_text",
      "source_text": "今日も頑張っていこうか！\r\n指示を頼むよ、トレーナーさん。",
      "source_fingerprint": "92240440ecc62b46cf80a31d3a9674de1002abf50c4452ddf6ac68c9b3ae17c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20007"
      ]
    },
    {
      "uid": "zhcn:f565f7e9c979c19f6ed0aee5",
      "kind": "character_system_text",
      "source_text": "んー、ちゃんと\r\n糖分補給はしてきたんだけど、\r\nどうにも集中できないな…。",
      "source_fingerprint": "1d9e2bb36c3716b89e0e76beaf35e7056aadb338ee6eaa2b99defc9b3be8abdd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20008"
      ]
    },
    {
      "uid": "zhcn:af45e53f5da79e97471bfaed",
      "kind": "character_system_text",
      "source_text": "宣言するよ。\r\n『私はすぐに調子を上げる』\r\nだから…きっと大丈夫。",
      "source_fingerprint": "0904144a4ce38eae411d38ad43e63ec0c2268098fcafa4e705028221cd318747",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20009"
      ]
    },
    {
      "uid": "zhcn:a573753b6b963fc007b8cffd",
      "kind": "character_system_text",
      "source_text": "ううーん、ガム、ガム…、\r\nあぁ切らしてた…はあぁ～～…。",
      "source_fingerprint": "2e0dd38ab8df63740f188d2160c3156227ffd25baa40566854504a4c14ff135d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20010"
      ]
    },
    {
      "uid": "zhcn:6a1e8fe17bb124fa0ba20707",
      "kind": "character_system_text",
      "source_text": "宣言…は、できる気分じゃないな。\r\nはぁー…。",
      "source_fingerprint": "e9ec9c275eb762d2d1728bd060ceae87a00c3a06e799d2960ec5c1aea0daf42c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20011"
      ]
    },
    {
      "uid": "zhcn:3ec913620a4863bef49c36f8",
      "kind": "character_system_text",
      "source_text": "トレーナーさん、\r\n焦って無茶するのは、\r\n切り込む勇気とは別だよ。",
      "source_fingerprint": "b14c753ceec836968742fa2aeac25bb847db730ce6f287f3c273217bbd0845b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20021"
      ]
    },
    {
      "uid": "zhcn:4cd11648dfebcb09c516516b",
      "kind": "character_system_text",
      "source_text": "リスクは高いと思う。\r\n考え直してほしいな。",
      "source_fingerprint": "193d7a8d5e51b869b39369e48195e0734bb2e54c19277af92913dd207171844d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20022"
      ]
    },
    {
      "uid": "zhcn:a657f24d5fc5c450f6e2ba7e",
      "kind": "character_system_text",
      "source_text": "調整はバッチリだね！\r\nしっぽの動きもキレがいい！",
      "source_fingerprint": "de69eae14c0a6a779bb9ed0a9656ad69224bea6ba6c10bc57c94b6814b2dd378",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20023"
      ]
    },
    {
      "uid": "zhcn:72d477f8b3f1b26e005a1b15",
      "kind": "character_system_text",
      "source_text": "トレーナーさん、宣言するよ。\r\n『私は、絶対に勝ってくる！』\r\n信じて見守っていて。",
      "source_fingerprint": "47198cd77d08701af76eb492bdded5ce6fe5ba9a117d2d1b614d772339664cab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20024"
      ]
    },
    {
      "uid": "zhcn:a63be117a0edb46bb6e21460",
      "kind": "character_system_text",
      "source_text": "全身の力が有り余ってる…！\r\n爆発しそうなくらいだよ。\r\n絶対に今までの私を超えられる！",
      "source_fingerprint": "16a6da67cae2888ca52f659a6d4b11bf61e09b4f2ba0a9061bfa6d5e1cd5f9be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20025"
      ]
    },
    {
      "uid": "zhcn:dd6e5fc1f6ef63756969949d",
      "kind": "character_system_text",
      "source_text": "『道は私が切り開く！』\r\n胸を張って戦ってくるから、\r\n応援よろしくね。",
      "source_fingerprint": "1785c3879f5ff36edf5f4a58161b83964ade484074348d64c59c60c70cb117c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d89f11e51404536a9e6e2a5b",
      "kind": "character_system_text",
      "source_text": "ついに本番か！燃えるね！\r\nわくわくしてきた…！\r\nさあ、勝ってこようか！",
      "source_fingerprint": "852563ede7164fba21c2e1ca5717a431d515a594f76db11830afb48af947a540",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20027"
      ]
    },
    {
      "uid": "zhcn:0b7f948a271345e5710398d0",
      "kind": "character_system_text",
      "source_text": "イメージ通りの走りさえ\r\nできれば、絶対に勝てる。\r\nわかるんだよ、私には！",
      "source_fingerprint": "037fe604f68daeb73e359b21463f7bda7c5363e82c324fff764ccfa187ceeec1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20028"
      ]
    },
    {
      "uid": "zhcn:4becbbb7787eea5a90c8a67d",
      "kind": "character_system_text",
      "source_text": "調整はいい感じだよ。\r\n落ち着いてレースできそうだ。\r\nいつも通りの実力を出せると思う。",
      "source_fingerprint": "dc68de23025278772a90690f9ee6a2942c7c25d3251186fc0a9998bed1c08c28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20029"
      ]
    },
    {
      "uid": "zhcn:9b96f29004595b30839d9702",
      "kind": "character_system_text",
      "source_text": "今日もすごい数のギャラリーだね。\r\n見られてる、って思うと\r\n気合いが入るよ。",
      "source_fingerprint": "12c2a27f585e4fad7e7fe0d901e0451fa06c5ad5c21189054caf026fc883bf28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20030"
      ]
    },
    {
      "uid": "zhcn:4af3e1b813558f8575078bba",
      "kind": "character_system_text",
      "source_text": "可もなく不可もなく…\r\nこういう日は、\r\n本来の実力を試せそうだね。",
      "source_fingerprint": "f6832e2b72269579f8d58d82d5bfca406ba5cb5d702ec7f1879f26a07ba6dfd9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20031"
      ]
    },
    {
      "uid": "zhcn:0dfe69783a30b834ab45c301",
      "kind": "character_system_text",
      "source_text": "受けて立つよ…。\r\n調子が悪いとか、関係ない。\r\n正々堂々、小細工なしだ。",
      "source_fingerprint": "31751af6531e353f27f8e5c0e6856fa10f9e11aed4c96027fdee1f896f5ee38d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20032"
      ]
    },
    {
      "uid": "zhcn:cd705c4af05729a5cb0bb205",
      "kind": "character_system_text",
      "source_text": "万全…とは言い難いけど、\r\n全力でぶつかってくるよ！\r\nしっかり見ていてね。",
      "source_fingerprint": "ca6de3f06e12ea566315b6989af7c5be0c4f098e75f4de6f2e795f7879979757",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20033"
      ]
    },
    {
      "uid": "zhcn:5a0f3261d3e524f3e66110a1",
      "kind": "character_system_text",
      "source_text": "正直、少し調子は振るわないけど、\r\n自覚があるぶん対応できるはず。\r\n諦めずにベストを尽くすよ。",
      "source_fingerprint": "e5462a09df281b94209b0bb637a72ee8a828c4e99a679785be9764691f054cda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20034"
      ]
    },
    {
      "uid": "zhcn:9ba876cf5488bcb57a6128e0",
      "kind": "character_system_text",
      "source_text": "う゛ぅ…鼻が…んん…すんっ…。\r\nダメな時はいつもこうだ…\r\nこんなことで負けられないのに…！",
      "source_fingerprint": "b88a150032d62ba185200307181bcf20d9ce07eb1f66822fe38e0119ebf342d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20035"
      ]
    },
    {
      "uid": "zhcn:baab35091b6c10745f0ea85d",
      "kind": "character_system_text",
      "source_text": "はぁー…あぁいや、大丈夫。\r\n心配しないで。\r\n集中できないのは私の問題だから。",
      "source_fingerprint": "5aa279dd7e72a813267e35c4d2647da6cd8f9cf1860cbaeecf4fc7486fd7fecc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20036"
      ]
    },
    {
      "uid": "zhcn:07de1a35033cf071738efd7e",
      "kind": "character_system_text",
      "source_text": "宣言する。『やれるだけやる』…\r\n無謀でも、誇りを持って挑むんだ。",
      "source_fingerprint": "d7f62b407e6dd782c565d614afd5899926aef3c1eefc0111f9e6d103e7d8047f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20037"
      ]
    },
    {
      "uid": "zhcn:1e65c2039f96f19dbc70686e",
      "kind": "character_system_text",
      "source_text": "はぁっ！",
      "source_fingerprint": "7888d33857ad22efbf3ece6256d4f1855cb8810b0c371f9cb4459fdc201f130b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20038"
      ]
    },
    {
      "uid": "zhcn:a1d93a135ea13e98f9d40e28",
      "kind": "character_system_text",
      "source_text": "始めよう。",
      "source_fingerprint": "0a91c3a42bee3b610a977d9d276cc865eacf6a6007436b210196e4495453836d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20039"
      ]
    },
    {
      "uid": "zhcn:398058c816cef1da9c5c9419",
      "kind": "character_system_text",
      "source_text": "よしっ！",
      "source_fingerprint": "30e28360c52fb9c3f6b9a96c8e4ece7924de57f6ba6cc2f1e53636e02353838c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20040"
      ]
    },
    {
      "uid": "zhcn:e399254715d1487d7d94cc25",
      "kind": "character_system_text",
      "source_text": "ふむふむ。",
      "source_fingerprint": "d43e9bc5fbf5c8c7eb1d0ecc0465b9194638fb4c7dd03d2133cf20315e561787",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20041"
      ]
    },
    {
      "uid": "zhcn:96ff50028b17021d56536a8e",
      "kind": "character_system_text",
      "source_text": "くっ…。",
      "source_fingerprint": "08080d0dc13e1bb0fb46fe11df4f2326cb366f722564377edc2adf3abf0020f6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20042"
      ]
    },
    {
      "uid": "zhcn:adbbda8ca7a9006338914c95",
      "kind": "character_system_text",
      "source_text": "うう…。",
      "source_fingerprint": "a39326157fead47b57080bf61b507848826ac373b5b9c5267a7869cc84efc3ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20043"
      ]
    },
    {
      "uid": "zhcn:a592f0ce7aa819c56b597ca1",
      "kind": "character_system_text",
      "source_text": "行こうか。",
      "source_fingerprint": "e0313322c5e8915991a86547220dc75f658986ecf42c2518e17d756637a60912",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20046"
      ]
    },
    {
      "uid": "zhcn:f97c6df4afccee03e8a26b87",
      "kind": "character_system_text",
      "source_text": "綺麗だね。",
      "source_fingerprint": "3e2bef02d1d264c2e9e6b7b878f8d5c8c7ef5bc3dba55cbe8761796621a77770",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20047"
      ]
    },
    {
      "uid": "zhcn:1b4c7323952a73a62c975815",
      "kind": "character_system_text",
      "source_text": "夢はまだまだ膨らむね。",
      "source_fingerprint": "b2444020dba79848fa13d5ca6a8548782536a4bad33cca7f6e503fee32aa6ca9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20049"
      ]
    },
    {
      "uid": "zhcn:d2b0c6da205b18da9fd04e1c",
      "kind": "character_system_text",
      "source_text": "世話になったね。",
      "source_fingerprint": "57bb574ea2c524c9189819ba6ae588f9acf26b1b43991738361a88d3607f6d99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "20050"
      ]
    },
    {
      "uid": "zhcn:a4e97b364e74058ecaddd9c1",
      "kind": "character_system_text",
      "source_text": "いいレースにしよう。",
      "source_fingerprint": "8c9d412c20ebd9938a61fe8a3a721fc218760ab9ca38e63d52111255502b4737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "2030"
      ]
    },
    {
      "uid": "zhcn:30d7919da94bd884eedb5f68",
      "kind": "character_system_text",
      "source_text": "みんな、私に続いて！",
      "source_fingerprint": "0994009a5df118d1f9c593064b6c4fc2c846f89cf3060dfc052d843bdf840f3e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "2031"
      ]
    },
    {
      "uid": "zhcn:4ddd83de635b3929c7fef5bd",
      "kind": "character_system_text",
      "source_text": "世話になったね。",
      "source_fingerprint": "57bb574ea2c524c9189819ba6ae588f9acf26b1b43991738361a88d3607f6d99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "2032"
      ]
    },
    {
      "uid": "zhcn:af75f88f54dd1e19d52885b6",
      "kind": "character_system_text",
      "source_text": "イメージ通りの走りさえ\r\nできれば、絶対に勝てる。\r\nわかるんだよ、私には！",
      "source_fingerprint": "037fe604f68daeb73e359b21463f7bda7c5363e82c324fff764ccfa187ceeec1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "2033"
      ]
    },
    {
      "uid": "zhcn:fe2c012c16b4aaad8a32e641",
      "kind": "character_system_text",
      "source_text": "全身の力が有り余ってる…！\r\n爆発しそうなくらいだよ。\r\n絶対に今までの私を超えられる！",
      "source_fingerprint": "16a6da67cae2888ca52f659a6d4b11bf61e09b4f2ba0a9061bfa6d5e1cd5f9be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "2034"
      ]
    },
    {
      "uid": "zhcn:abca19e72d034f9d38682d47",
      "kind": "character_system_text",
      "source_text": "世話になったね。",
      "source_fingerprint": "57bb574ea2c524c9189819ba6ae588f9acf26b1b43991738361a88d3607f6d99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "2035"
      ]
    },
    {
      "uid": "zhcn:cb98f1098f9e501045a8f850",
      "kind": "character_system_text",
      "source_text": "よしっ！",
      "source_fingerprint": "30e28360c52fb9c3f6b9a96c8e4ece7924de57f6ba6cc2f1e53636e02353838c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "23015"
      ]
    },
    {
      "uid": "zhcn:5f4b147c9d8e220f9b7094b9",
      "kind": "character_system_text",
      "source_text": "あと1歩か…！",
      "source_fingerprint": "7498b6f26ba06426bcba5c9aefc35c5c8eda948218b2ef460fa3028893756409",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "30000"
      ]
    },
    {
      "uid": "zhcn:ea96641ed546b8e3ea486439",
      "kind": "character_system_text",
      "source_text": "もっと、上を目指すんだ…！",
      "source_fingerprint": "1a97acb6214833002cc71f1e508ffb4c411ed9503483ce07ecc0c9a8f70819b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "30001"
      ]
    },
    {
      "uid": "zhcn:e435a80996509f3bb730b792",
      "kind": "character_system_text",
      "source_text": "次は、負けない。",
      "source_fingerprint": "afda0fe1e208d375b483c9db90de4116e19d649fe94fe013c24356361fa7e56f",
      "source_path": "character_system_text_dict.json",
