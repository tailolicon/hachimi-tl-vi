      ]
    },
    {
      "uid": "zhcn:32aa9c0f01e9976a476d55ac",
      "kind": "character_system_text",
      "source_text": "みんなカ～ワイイっ！！",
      "source_fingerprint": "70cc8fdba50e9f171b1498e43737f7cd6c92e1c81cc1217f534d86c614210d0e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140003"
      ]
    },
    {
      "uid": "zhcn:e2f695aa458ee41a492e3141",
      "kind": "character_system_text",
      "source_text": "おお～とれたね。",
      "source_fingerprint": "8258539114376a6a77181c1f9b4b293ca96b06ddc3be6dad13c0c368bafbf25f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
