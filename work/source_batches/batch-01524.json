      ]
    },
    {
      "uid": "zhcn:19a0cafe49a18b3adf1f92ba",
      "kind": "character_system_text",
      "source_text": "残念だったね。",
      "source_fingerprint": "4f1a80197dcd613bdf4a24ab6cc152ba0573c47c2c1f66e4502741558783072f",
      "source_path": "character_system_text_dict.json",
