      ]
    },
    {
      "uid": "zhcn:a19bae7d150ee483c20bcc19",
      "kind": "character_system_text",
      "source_text": "みんな、私に続いて！",
      "source_fingerprint": "0994009a5df118d1f9c593064b6c4fc2c846f89cf3060dfc052d843bdf840f3e",
      "source_path": "character_system_text_dict.json",
