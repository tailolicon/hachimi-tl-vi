      ]
    },
    {
      "uid": "zhcn:849f4c69851970ae22ec1c24",
      "kind": "character_system_text",
      "source_text": "みんなカ～ワイイっ！！",
      "source_fingerprint": "70cc8fdba50e9f171b1498e43737f7cd6c92e1c81cc1217f534d86c614210d0e",
      "source_path": "character_system_text_dict.json",
