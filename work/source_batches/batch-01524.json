      "json_path": [
        "1112",
        "20001"
      ]
    },
    {
      "uid": "zhcn:058431c2d7b2c546db2a239a",
      "kind": "character_system_text",
      "source_text": "Today is my day!现在的话，\r\n就算是飓风或者鲨鱼袭来\r\n我感觉也能对付得了！",
      "source_fingerprint": "815b532eada7854f842352c50d55eecf79e6829b325f5fcd2e854a4ae1e937ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20002"
      ]
    },
    {
      "uid": "zhcn:47d48c3388653698a24f1294",
      "kind": "character_system_text",
      "source_text": "训练员！仔细～看看我？\r\n我是什么表情？…呵呵！没错，\r\n是渴望最棒训练的表情哦！",
      "source_fingerprint": "450fa2ff6b729089d897d1b8b68b19c270503a446e3a8dff917afe6a148132b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "20003"
      ]
    },
