      ]
    },
    {
      "uid": "zhcn:4bf60d97e9d6cd6f37743037",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "11"
      ]
    },
    {
      "uid": "zhcn:60f720fdce1ad4270d9912f1",
      "kind": "character_system_text",
      "source_text": "トレーニングは、悩むより\r\nまずやってみるのが大事だよね。",
      "source_fingerprint": "8d9863b25972810e374f3f7713bde0a6a8ff9eaac6ee65795a6517a08b94578a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "110000"
      ]
    },
    {
      "uid": "zhcn:0e77bb08f0dfd5b7c470753d",
      "kind": "character_system_text",
      "source_text": "学園史上初の…とか\r\nカッコいいよね！\r\n歴史のロマンを感じるなぁ。",
      "source_fingerprint": "331ecbe4d2bdc82014cd13b67b9609d8d5389e4605a017006417dcd6715c3694",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "110001"
      ]
    },
    {
      "uid": "zhcn:283a8acafa85804049ba2596",
      "kind": "character_system_text",
      "source_text": "レースへの出走…迷ってる？\r\nまずはやってみるといいよ！",
      "source_fingerprint": "024f4df237641ff3eccef18bbd0688d673fe847765dabfb9d6354fb51f4e336f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "110002"
      ]
    },
    {
      "uid": "zhcn:e6c1fc22088be77c37cc4c36",
      "kind": "character_system_text",
      "source_text": "ウマ娘、プリティーダービー！",
      "source_fingerprint": "0cfce02d59976c4a687f79d00d7894df0b5a6c879fbee1d653e3f267a88ff06d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "12"
      ]
    },
    {
      "uid": "zhcn:585c45cdd66fdf9b00f0df04",
      "kind": "character_system_text",
      "source_text": "力が溢れて…爆発しそうだ！",
      "source_fingerprint": "ee6bfc8664cdad60d08e4ff4c0fa5f604ea73e5f9b173e47af460c83702a91c2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "120000"
      ]
    },
    {
      "uid": "zhcn:6c6b9b536e002519ba57bbcb",
      "kind": "character_system_text",
      "source_text": "切り開く！",
      "source_fingerprint": "776d8fa3f9a595b6251bd8ab3528f8bfd753bbb8ae2544fd6bbd52ba8f0d3d06",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "1215"
      ]
    },
    {
      "uid": "zhcn:236691a6bb6c581d94d267a0",
      "kind": "character_system_text",
      "source_text": "今日のログインボーナスだよ。",
      "source_fingerprint": "b6ca21ed574a8d5ccb948bbf337fc3c2745dbcc22e2041ed31464cfe15ff8f6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "13"
      ]
    },
    {
      "uid": "zhcn:0c72653d737836bf767f824d",
      "kind": "character_system_text",
      "source_text": "期待してるよ。",
      "source_fingerprint": "875e3698cf5d4b5ec8bef67b34808e1ec0bb509ee0423c52d35970290dc1b918",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140000"
      ]
    },
    {
      "uid": "zhcn:15018138925f441fa24b48ec",
      "kind": "character_system_text",
      "source_text": "よしゲット！",
      "source_fingerprint": "1613970dd973b0910c823ab84f36a4d2242867ebf0e65d9694610a4ed4b6684a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "140001"
      ]
    },
    {
      "uid": "zhcn:283df6941c76f6137e0fee73",
      "kind": "character_system_text",
      "source_text": "ああぁ～！",
      "source_fingerprint": "76512966466663ff74a5fb893d688f0c75aab6a6a5c81549b3e6f29e9afa5bfb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
