  "entries": [
    {
      "uid": "zhcn:44af8bc980376e44cc174b9f",
      "kind": "character_system_text",
      "source_text": "情けないな…。",
      "source_fingerprint": "af33ad0887921fee967f7be59d9e28c5a5aecf77e3304ccd0b5738b6de1d8534",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "30003"
      ]
    },
    {
      "uid": "zhcn:b09eb01d306282838dd64ba1",
      "kind": "character_system_text",
      "source_text": "私の起こす旋風は、\r\nまだこんなものじゃあないよ！",
      "source_fingerprint": "36c49f48e4654cba2b6125c2eb553ae1bf6c1b3bb8f469fec3dbe9fc3f9b443b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "30004"
      ]
    },
    {
      "uid": "zhcn:71c7d42936b860d8da517002",
      "kind": "character_system_text",
      "source_text": "宣言通り、『私の勝ち』だね！",
      "source_fingerprint": "ec6aebf1b93dd1b561d5c86c771de03cc1a701e35c6d09022f3148895049d9d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "30005"
      ]
    },
    {
      "uid": "zhcn:dc1458afc4e930da9f7c10e0",
      "kind": "character_system_text",
      "source_text": "行ってくるよ。",
      "source_fingerprint": "7da79748cc0c78260452eff6f93ce5c5aa46913a8d4199c892b59c4e329c3594",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "31000"
      ]
    },
    {
      "uid": "zhcn:8a70cf8d23aad375238bd08c",
      "kind": "character_system_text",
      "source_text": "私が切り込む！",
      "source_fingerprint": "a46fae01256eff31fa7de1524bb03d81204e49a1993b7a3795c907fc99ab1da1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "40000"
      ]
    },
    {
      "uid": "zhcn:e1b322d6313ab8ae9a7a81ae",
      "kind": "character_system_text",
      "source_text": "んっ…よし。無謀だなんて言わせない。\r\n私が示す！さあ、ついて来て。",
      "source_fingerprint": "a879430e71789c910c394a330d5e748e96974f2b60751d182413bf01571d0357",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "40001"
      ]
    },
    {
      "uid": "zhcn:ee495bdd4cd0c840dadc181f",
      "kind": "character_system_text",
      "source_text": "盛り上げてくるからね！",
      "source_fingerprint": "a64cf9cdc26681799d31c334a76f04503086254845dbea3619ae2a7f2aa346b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "60000"
      ]
    },
    {
      "uid": "zhcn:5d518eb5894e96d18d3c1fea",
      "kind": "character_system_text",
      "source_text": "さあみんな、行こうっ！",
      "source_fingerprint": "2b2a0e7324be0f8dbf770cd2b93b798ee2064ecdc3a32dedec118972b881c805",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "60001"
      ]
    },
    {
      "uid": "zhcn:c769e25667733ea928d41888",
      "kind": "character_system_text",
      "source_text": "私が切り開いてみせる！",
      "source_fingerprint": "b873a1d077e6dc5da6d175f9b281f582ac8814f2d787c41e27b2be97054f2026",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70000"
      ]
    },
    {
      "uid": "zhcn:a389e0d6a55f65fc0d29e821",
      "kind": "character_system_text",
      "source_text": "自分の名前が聞こえてきたから、\r\n思わず声かけちゃったけど…\r\nあの時、切り込んで正解だったよ！",
      "source_fingerprint": "79068df8021a6244662689072ad5300b035303717f5485b9c74420ac221d4269",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70001"
      ]
    },
    {
      "uid": "zhcn:f8e4262b99e61d17f0c77f1a",
      "kind": "character_system_text",
      "source_text": "名門校のトレセン学園制服…\r\n誇らしいね！",
      "source_fingerprint": "54a668fb2f85927c960baf728f0bafa45180160fdea3c006f5d0a1ce46ab10fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70004"
      ]
    },
    {
      "uid": "zhcn:120018591718b4fb197bda72",
      "kind": "character_system_text",
      "source_text": "幼馴染たちとも、\r\nこれ着て並んでみたいな…。",
      "source_fingerprint": "4d68f043e9f17dc0c3d272f4aac7eb00a5db21b358078f8976059fb84edc0a8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70008"
      ]
    },
    {
      "uid": "zhcn:84fad381d1061face8264d24",
      "kind": "character_system_text",
      "source_text": "すっごく軽いんだ、この服！\r\n風の抵抗も少なそうでしょう？",
      "source_fingerprint": "e5577f048c86464b4232ce01169a6c90fdf8e387a5b3e8807ae4779c9288f82e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70009"
      ]
    },
    {
      "uid": "zhcn:d1199f55ecaa6d909b7bf840",
      "kind": "character_system_text",
      "source_text": "裾のフリル、カワイイよね～！",
      "source_fingerprint": "139a7a82d573c9c097bbb650010bd67de3771bbd5f03014aa3fa3be656bc1bf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70010"
      ]
    },
    {
      "uid": "zhcn:2b84839710b3939519561f32",
      "kind": "character_system_text",
      "source_text": "ライブでも、私が率先して盛り上げるよ！",
      "source_fingerprint": "ddfd6c2e3f991b7f75048b4ec4752608f93ed009f437b4ef7d386bdba7c2029e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70014"
      ]
    },
    {
      "uid": "zhcn:a2e1d1aeaa44c5e7b7af57dc",
      "kind": "character_system_text",
      "source_text": "ウエストポーチにはガムを常備してあるんだ！\r\n噛めばいつでも元気チャージさ。",
      "source_fingerprint": "49a1fa7d5d3d2a01ab8becbfa261e676c4df2450579d2d5bd5dfa7d10cd93b4b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70015"
      ]
    },
    {
      "uid": "zhcn:72503aa4568ca7ad123e9db3",
      "kind": "character_system_text",
      "source_text": "どんな服でも着こなしてみせる！",
      "source_fingerprint": "4a6e6ed83d9d057b386e4fca79174831ce4ab93cb2ec6076f75e55c9f074d06f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70018"
      ]
    },
    {
      "uid": "zhcn:71d86885fff42864b8d24b02",
      "kind": "character_system_text",
      "source_text": "新しい衣装って、テンション上がるね。",
      "source_fingerprint": "84fdd31e87a03f88b63da9013659a2af97c6abbacf5b0aad1d4141a7ccd511e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "70019"
      ]
    },
    {
      "uid": "zhcn:86b4e95017a7e2fd052e661b",
      "kind": "character_system_text",
      "source_text": "名門校のトレセン学園制服…\r\n誇らしいね！",
      "source_fingerprint": "54a668fb2f85927c960baf728f0bafa45180160fdea3c006f5d0a1ce46ab10fa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "71004"
      ]
    },
    {
      "uid": "zhcn:129a11b962f9e6c42898aa16",
      "kind": "character_system_text",
      "source_text": "幼馴染たちとも、\r\nこれ着て並んでみたいな…。",
      "source_fingerprint": "4d68f043e9f17dc0c3d272f4aac7eb00a5db21b358078f8976059fb84edc0a8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
        "71008"
      ]
    },
    {
      "uid": "zhcn:5558b121de0a9723318edfc9",
      "kind": "character_system_text",
      "source_text": "すっごく軽いんだ、この服！\r\n風の抵抗も少なそうでしょう？",
      "source_fingerprint": "e5577f048c86464b4232ce01169a6c90fdf8e387a5b3e8807ae4779c9288f82e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
