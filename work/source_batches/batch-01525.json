      ]
    },
    {
      "uid": "zhcn:48e0122928bf70fccdf597be",
      "kind": "character_system_text",
      "source_text": "裾のフリル、カワイイよね～！",
      "source_fingerprint": "139a7a82d573c9c097bbb650010bd67de3771bbd5f03014aa3fa3be656bc1bf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1124",
