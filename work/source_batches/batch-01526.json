        "10025"
      ]
    },
    {
      "uid": "zhcn:4fa0ff347f56ad90c920b023",
      "kind": "character_system_text",
      "source_text": "被赛场拉面店的老板记住了……\n最近会在点餐前就对我说\n『老样子吧！』……",
      "source_fingerprint": "4cf5ea889435bdff7abdc59be616ea3cbce5da70e18e20620d2b4f00636c54c7",
