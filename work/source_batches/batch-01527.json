{
  "schema_version": 1,
  "batch": 1527,
  "batch_count": 1689,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "55de4ce263af14817647562a7fd0854a4cb17a23",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:a2f765a7fffc2784570d6653",
      "kind": "character_system_text",
      "source_text": "集中…！",
      "source_fingerprint": "7bff235cbd56d61f8db993a69087d4b009346098cfe6911c1784d88d540e1fc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20041"
      ]
    },
    {
      "uid": "zhcn:953adfcb0a3f6f723d0b4141",
      "kind": "character_system_text",
      "source_text": "怎么会…！？",
      "source_fingerprint": "775fe60a572e7cf25196570778a4fa5118d3dc8ea49ab59a9e0adefcd9b3b6aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20042"
      ]
    },
    {
      "uid": "zhcn:5c4d49efc52b9eb113291b31",
      "kind": "character_system_text",
      "source_text": "不会吧…？",
      "source_fingerprint": "09dfdbc2f050a6acd444a03509eaab43889cce0ff5024d256581e097b23ba4ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20043"
      ]
    },
    {
      "uid": "zhcn:ff8f0e01b4239c43221aaa9c",
      "kind": "character_system_text",
      "source_text": "享受吧。",
      "source_fingerprint": "274a3da3e58eaa13529ad9596cee6a8b8500694d845adb3df972f0ca0234a9d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20046"
      ]
    },
    {
      "uid": "zhcn:027f402c62b8eb552e403877",
      "kind": "character_system_text",
      "source_text": "好美…！",
      "source_fingerprint": "45fa812fa9d24213fa793afd26bc5164f1f9a921cdcde08987ce475117432486",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20047"
      ]
    },
    {
      "uid": "zhcn:9f69215047740ae565097398",
      "kind": "character_system_text",
      "source_text": "承蒙指导，衷心感谢。",
      "source_fingerprint": "f4930cc6bc5d100578fd3837b8d36439931de7505ce938d4bff5507c0899766a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20049"
      ]
    },
    {
      "uid": "zhcn:12539f6e7f8f1ea75d384204",
      "kind": "character_system_text",
      "source_text": "这段时间，承蒙关照了。",
      "source_fingerprint": "9002f48edd1bd6977df66f78737ab6ef4465193a9f9f39b30f2106fbbe03b4aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20050"
      ]
    },
    {
      "uid": "zhcn:f95e83ca9b6c7d4d448ab539",
      "kind": "character_system_text",
      "source_text": "稳步地、踏实地。",
      "source_fingerprint": "38649674b8ced8133bcf6ecf5d2c86b06037dc26d41a694b262e2806cfc3d80d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "20051"
      ]
    },
    {
      "uid": "zhcn:aa0ee3d57b9b731c59ba0003",
      "kind": "character_system_text",
      "source_text": "那么，出发吧。",
      "source_fingerprint": "10d75e3fc5936a1264a118742ee8879f0bd608d88f86db003bc2a3fff32ca93b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "2030"
      ]
    },
    {
      "uid": "zhcn:9eb344d974e97c75134766b1",
      "kind": "character_system_text",
      "source_text": "一起赢下来吧。",
      "source_fingerprint": "0bd29f7815fed211ed0e1c5c798a905cb8289d493609b5d6015ab2ec000187dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "2031"
      ]
    },
    {
      "uid": "zhcn:c82812479c0b74467df99f64",
      "kind": "character_system_text",
      "source_text": "这段时间，承蒙关照了。",
      "source_fingerprint": "9002f48edd1bd6977df66f78737ab6ef4465193a9f9f39b30f2106fbbe03b4aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "2032"
      ]
    },
    {
      "uid": "zhcn:1bfea6a9af43dd7941bcb54f",
      "kind": "character_system_text",
      "source_text": "这场比赛，我不会让人说出\r\n『可惜』。我要得到的评价\r\n是对母亲所留下之物的赞颂。",
      "source_fingerprint": "0d01d7c1d4cc855aa4056f7eba9309e2bd81727f02c7b0c5d0ed1fbe26e7826a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "2033"
      ]
    },
    {
      "uid": "zhcn:0717b01d50341ac6ca74b29f",
      "kind": "character_system_text",
      "source_text": "训练员\r\n请安心等候。\r\n一定，会带着胜利回来。",
      "source_fingerprint": "da1fbb7cfdabf19be45264d6f9280815231df2c08ada3d0d61b65b0deafcf88c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "2034"
      ]
    },
    {
      "uid": "zhcn:14d0006e09d7279f37a79748",
      "kind": "character_system_text",
      "source_text": "这段时间，承蒙关照了。",
      "source_fingerprint": "9002f48edd1bd6977df66f78737ab6ef4465193a9f9f39b30f2106fbbe03b4aa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "2035"
      ]
    },
    {
      "uid": "zhcn:ddeb48b7be6682584268ddbb",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "23015"
      ]
    },
    {
      "uid": "zhcn:3373d2691b416b4c99b27a38",
      "kind": "character_system_text",
      "source_text": "下次不会再让人说『可惜』。",
      "source_fingerprint": "f12185ef0553d71915a204d7d9fc42a764ee6f18c1eb763f0a2170caeeffa9a1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "30000"
      ]
    },
    {
      "uid": "zhcn:8e28f1c11c565a81cbecfcab",
      "kind": "character_system_text",
      "source_text": "努力好像还不够…。",
      "source_fingerprint": "df54d4340fb62869bcb478a49d98d46a49b970f82f1068b24225530c0fe8ddd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "30001"
      ]
    },
    {
      "uid": "zhcn:37b0698e490e524ac376f147",
      "kind": "character_system_text",
      "source_text": "我会尽快制定对策。",
      "source_fingerprint": "801a99db663700be7d4d35b85745afc68eea94d9649e3d42ad864c7f42086a43",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "30002"
      ]
    },
    {
      "uid": "zhcn:6328026373b839afe4d1e138",
      "kind": "character_system_text",
      "source_text": "实在惭愧…。",
      "source_fingerprint": "f6de4c3c543a372ff93cca75ee2a8d42dac04be10209aaf24ab261c2d826c371",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "30003"
      ]
    },
    {
      "uid": "zhcn:12a329c86d789bb6deed7e5a",
      "kind": "character_system_text",
      "source_text": "这就是母亲所传的心意――力量。",
      "source_fingerprint": "314962ea4598a6cb766dc16849bca2731ef4b176386aeba3d68e13ce590f5327",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "30004"
      ]
    },
    {
      "uid": "zhcn:d124e5004d7a182963ac4127",
      "kind": "character_system_text",
      "source_text": "这就是一路积累下来的成果。",
      "source_fingerprint": "faa94b6e3d5c32ee8c26d5483dfb413ec3800d1b5f793976d57a3c298cd20524",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "30005"
      ]
    },
    {
      "uid": "zhcn:c55e442e3c66c08caf9fadcc",
      "kind": "character_system_text",
      "source_text": "我不会把胜利让给任何人。",
      "source_fingerprint": "6b4fe881448fe133f1956709c3cbd9bce5fee52184795bd7343dbba6e55cda07",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "31000"
      ]
    },
    {
      "uid": "zhcn:26b4ea73b95e2e5b37eb81d5",
      "kind": "character_system_text",
      "source_text": "踏实地，一步步向前――！",
      "source_fingerprint": "f897648f28f75a3cb25391183111ce9041b1ebccd3c2cc1d41918610287e08f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "40000"
      ]
    },
    {
      "uid": "zhcn:a08bc555300d06714ba4eccb",
      "kind": "character_system_text",
      "source_text": "说到『恋爱』，班上很受欢迎的\r\n少女漫画里有位举止粗野却心地善良\r\n的人……让我觉得有些亲切。",
      "source_fingerprint": "e1e3398d5686f34b8fa622d79c4e9b541825ef69071f75a8e7435882e19eaf44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "400005"
      ]
    },
    {
      "uid": "zhcn:434ba4fb73f006f672997fdc",
      "kind": "character_system_text",
      "source_text": "我想起了和母亲一起，第一次\r\n去赛跑教室的那天――\r\n草地的气息很舒服……也很温暖",
      "source_fingerprint": "511aed832eb545c678b81047fdf1d90ba0d436afe28308420f0ce74d4dd4be85",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "400007"
      ]
    },
    {
      "uid": "zhcn:30401e68b6898760c5be5ac2",
      "kind": "character_system_text",
      "source_text": "踏实地，一步步向前――\r\n我要让它绽放在孕育万物的大地上。\r\n让那朵传承心意的绚烂之花…！",
      "source_fingerprint": "6574acce997943c6658c0e09b87e9efbe50cb3a6284789a875eaaa9abbc8ccbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "40001"
      ]
    },
    {
      "uid": "zhcn:37a3d3dec0ed883f7b81567c",
      "kind": "character_system_text",
      "source_text": "活动任务，已经设定好\n目标点了吗？\n让我们一步一步按计划完成吧。",
      "source_fingerprint": "4785d7b4f02c37d9ce2a98fb859d299f2d9214ab2a18601e663178da87d5f4b3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "400012"
      ]
    },
    {
      "uid": "zhcn:978cbcaf1470cc30bb9a871e",
      "kind": "character_system_text",
      "source_text": "辛苦了。努力的成果，\r\n请记得领取。",
      "source_fingerprint": "41e0bc8d99b5e8ba46fa8c20951dc4217f2a8a25cf3a61d2e15d70a5d69a8dac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "400013"
      ]
    },
    {
      "uid": "zhcn:7b98ea36b4315aae247e90dd",
      "kind": "character_system_text",
      "source_text": "我会做到",
      "source_fingerprint": "b56eb85358fe25a0165b7734914ec89f8031c814351df2cdba9a9ba2576dbf79",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410000"
      ]
    },
    {
      "uid": "zhcn:b1f2900f1d0b431c2329f0ac",
      "kind": "character_system_text",
      "source_text": "做到了",
      "source_fingerprint": "03eaee2459966502503c3f3bd10faf3f8d371306fe38dc67826283050099127e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410001"
      ]
    },
    {
      "uid": "zhcn:5cf4961324e84ca57663aedf",
      "kind": "character_system_text",
      "source_text": "好",
      "source_fingerprint": "f867f34178594f891eb70a4260f62b1d9289cfa60394f9fee1cbbe4a8b4bf436",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410002"
      ]
    },
    {
      "uid": "zhcn:8f5066fbe58c2eb6403dbb18",
      "kind": "character_system_text",
      "source_text": "好",
      "source_fingerprint": "f867f34178594f891eb70a4260f62b1d9289cfa60394f9fee1cbbe4a8b4bf436",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410003"
      ]
    },
    {
      "uid": "zhcn:4af9a14aa3b08d7945535f94",
      "kind": "character_system_text",
      "source_text": "呵呵呵",
      "source_fingerprint": "a7aaa160b5622557af530f2787cdbaf3a769f866f20a025fea7fc38682c2dc19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410004"
      ]
    },
    {
      "uid": "zhcn:ee83718a687b22ba82fe6206",
      "kind": "character_system_text",
      "source_text": "呵呵呵",
      "source_fingerprint": "a7aaa160b5622557af530f2787cdbaf3a769f866f20a025fea7fc38682c2dc19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410005"
      ]
    },
    {
      "uid": "zhcn:aaf0ed0b52b5de7a46437471",
      "kind": "character_system_text",
      "source_text": "嗯",
      "source_fingerprint": "821ea6fd74a74c12dfe83babf1c9f495bee9012e2301d5b7f3010fff99b8fd6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410006"
      ]
    },
    {
      "uid": "zhcn:9ed87ad7ee11170125ef2d8f",
      "kind": "character_system_text",
      "source_text": "嗯",
      "source_fingerprint": "821ea6fd74a74c12dfe83babf1c9f495bee9012e2301d5b7f3010fff99b8fd6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410007"
      ]
    },
    {
      "uid": "zhcn:fcbf430c514fa967ec91f8fd",
      "kind": "character_system_text",
      "source_text": "嗯",
      "source_fingerprint": "821ea6fd74a74c12dfe83babf1c9f495bee9012e2301d5b7f3010fff99b8fd6f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "410008"
      ]
    },
    {
      "uid": "zhcn:66a972bce23d39921ea3a5c2",
      "kind": "character_system_text",
      "source_text": "将感谢之意，献给各位。",
      "source_fingerprint": "bba44269fa754e7e41e2b7e7c13c9743f5aff79af6c0b326974c02e1bb240b05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "60000"
      ]
    },
    {
      "uid": "zhcn:942efda3843dee47e734b65a",
      "kind": "character_system_text",
      "source_text": "多次练习积累的成果，请您过目。",
      "source_fingerprint": "1a13183db46212fc02bb273a393a19b6c137605311ad3de5df03eef2d3891199",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "60001"
      ]
    },
    {
      "uid": "zhcn:672356b4c7566db8d9a6e794",
      "kind": "character_system_text",
      "source_text": "让我们一起，延续这份荣光。",
      "source_fingerprint": "1222959fc444939a5aa654a28df6304f53aa884b79f6091042266c13fdb106b9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70000"
      ]
    },
    {
      "uid": "zhcn:2ba3bb6394e599595b36f997",
      "kind": "character_system_text",
      "source_text": "那次集训您让给我的书，\r\n现在也珍惜地保存着。因为您的\r\n温柔让我很高兴…。",
      "source_fingerprint": "7c178e124f65fb0e95ed28e4c9ec4fb10c8b63899967290dc11d6a6a959b01ab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70001"
      ]
    },
    {
      "uid": "zhcn:e90df4400340b9157a463e0d",
      "kind": "character_system_text",
      "source_text": "保养工作，一天也不能落下。\r\n因为制服是学园的象征。",
      "source_fingerprint": "54a7ec08b7a3a0a4a8c4f7b080e6cb40f61b6460e456b96726ef43c7b8ac7795",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70004"
      ]
    },
    {
      "uid": "zhcn:232012d327e782f84b9f2d96",
      "kind": "character_system_text",
      "source_text": "和平时穿的衣服不同，\r\n腰腹一带的设计很大胆……呢。",
      "source_fingerprint": "9e0f79c064d553c105cb15b487fe77f922f03dc4d9458c11d4df8a5f0eb24a09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70008"
      ]
    },
    {
      "uid": "zhcn:1c80252494decdd06b9a68bc",
      "kind": "character_system_text",
      "source_text": "我向这套服装起誓。\r\n会为此付出不懈的努力。",
      "source_fingerprint": "26f7497e3cc244ce1d1390be914e237295ae641c55dc5b0eb742547b7cf6b46e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70009"
      ]
    },
    {
      "uid": "zhcn:199cb7cf28701eda37b6d485",
      "kind": "character_system_text",
      "source_text": "相册里的母亲看起来很开心……\r\n所以我一直向往着学园生活。",
      "source_fingerprint": "c10a02c7df2026e8dc4b4b93ec3ae5e233b2048c5db68125af6100107496825b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70010"
      ]
    },
    {
      "uid": "zhcn:39f36056298c5bb85d4eaf59",
      "kind": "character_system_text",
      "source_text": "为了能在任何位置起舞，\r\n我得预习…。",
      "source_fingerprint": "7576b42ad2cbb14446cefcb1a3241844d96b43e9bbe873ed7813524108fcea44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70014"
      ]
    },
    {
      "uid": "zhcn:92cabd433d6d55d086483744",
      "kind": "character_system_text",
      "source_text": "我一定会带回来。\r\n把那顶后冠，献给母亲――",
      "source_fingerprint": "9026f12d9209d1d490b978d5a9eb2709cb9e0dc3fb9e31197d7fa0aca3cc696d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70015"
      ]
    },
    {
      "uid": "zhcn:b22e33ff8664eaf697a2070f",
      "kind": "character_system_text",
      "source_text": "适合我……吗？",
      "source_fingerprint": "15a00f29acb31e39ddab9cf89b7824fcd36f93d39592c9179e17d9a5b01d3f41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70018"
      ]
    },
    {
      "uid": "zhcn:19bd91cecb315c5742cc22e6",
      "kind": "character_system_text",
      "source_text": "举止要配得上这套服装。",
      "source_fingerprint": "6081d4ab63317144ec4c2f91a1cdc79286fdc577d0097482ca6661b5a94537d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70019"
      ]
    },
    {
      "uid": "zhcn:2fb2705caa0cad9b7f501be2",
      "kind": "character_system_text",
      "source_text": "今天，要试哪种\r\n休养用品呢。",
      "source_fingerprint": "f20fb7713e2b500d38e41fed3296055830c63a18b84f42da849aab1eda0629ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70020"
      ]
    },
    {
      "uid": "zhcn:6da59d3010484c941d46035d",
      "kind": "character_system_text",
      "source_text": "我有一家店想推荐。\r\n那里的麝香葡萄芭菲堪称绝品。",
      "source_fingerprint": "6e3286c0883aa3ec63979d1eee587daf5208fa95f0e9ab7b35c5bbfa21ca0a41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "70021"
      ]
    },
    {
      "uid": "zhcn:629e476919e42a8e6d250aee",
      "kind": "character_system_text",
      "source_text": "保养工作，一天也不能落下。\r\n因为制服是学园的象征。",
      "source_fingerprint": "54a7ec08b7a3a0a4a8c4f7b080e6cb40f61b6460e456b96726ef43c7b8ac7795",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71004"
      ]
    },
    {
      "uid": "zhcn:a87f7d5ec6df4f1f8c180809",
      "kind": "character_system_text",
      "source_text": "和平时穿的衣服不同，\r\n腰腹一带很大胆……呢。",
      "source_fingerprint": "4e79185db7d3c1695e9251f122cc17bca1e2e5d10c72a4ce3dca5d3e0c647cfc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71008"
      ]
    },
    {
      "uid": "zhcn:0a93cc1383e442269b5d126a",
      "kind": "character_system_text",
      "source_text": "我向这套服装起誓。\r\n会为此付出不懈的努力。",
      "source_fingerprint": "26f7497e3cc244ce1d1390be914e237295ae641c55dc5b0eb742547b7cf6b46e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71009"
      ]
    },
    {
      "uid": "zhcn:e587e310e88c042bcbf41415",
      "kind": "character_system_text",
      "source_text": "相册里的母亲看起来很开心……\r\n所以我一直向往着学园生活。",
      "source_fingerprint": "c10a02c7df2026e8dc4b4b93ec3ae5e233b2048c5db68125af6100107496825b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71010"
      ]
    },
    {
      "uid": "zhcn:fb9bfebdd353e80c191ba120",
      "kind": "character_system_text",
      "source_text": "为了能在任何位置起舞，\r\n我得预习…。",
      "source_fingerprint": "7576b42ad2cbb14446cefcb1a3241844d96b43e9bbe873ed7813524108fcea44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71014"
      ]
    },
    {
      "uid": "zhcn:4040b99579f30d2580d3df9c",
      "kind": "character_system_text",
      "source_text": "我一定会带回来。\r\n把那顶后冠，献给母亲――",
      "source_fingerprint": "9026f12d9209d1d490b978d5a9eb2709cb9e0dc3fb9e31197d7fa0aca3cc696d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71015"
      ]
    },
    {
      "uid": "zhcn:827a9ed6bcc5edf6239e9dca",
      "kind": "character_system_text",
      "source_text": "适合我……吗？",
      "source_fingerprint": "15a00f29acb31e39ddab9cf89b7824fcd36f93d39592c9179e17d9a5b01d3f41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71018"
      ]
    },
    {
      "uid": "zhcn:45bb3b64c1e4316dd1f201d8",
      "kind": "character_system_text",
      "source_text": "举止要配得上这套服装。",
      "source_fingerprint": "6081d4ab63317144ec4c2f91a1cdc79286fdc577d0097482ca6661b5a94537d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "71019"
      ]
    },
    {
      "uid": "zhcn:c1a82e0839ad53e58382a7f7",
      "kind": "character_system_text",
      "source_text": "辛苦了",
      "source_fingerprint": "bd96bf364b8b21a3bb94efcf4ef82feb1bc34cf02203524e7949dbd19151dd13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "80000"
      ]
    },
    {
      "uid": "zhcn:b21e766e40177183f82d7d03",
      "kind": "character_system_text",
      "source_text": "在教室里，我很喜欢安静做准备的\r\n那段时间…。平时我都会尽量\r\n提前30分钟到校。",
      "source_fingerprint": "0b6f90a1368aa74b54d0de4b01ab5cbd425c120202b9a83496650fe8f350799b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90000"
      ]
    },
    {
      "uid": "zhcn:362894f255a727468968639b",
      "kind": "character_system_text",
      "source_text": "忘带东西的经验……不，\r\n没有呢。随身物品的准备全部\r\n会在前一晚完成。",
      "source_fingerprint": "977942788891e1b03ee5c69f27e33f212a818c4f51f19285688d21cae23c3f81",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90001"
      ]
    },
    {
      "uid": "zhcn:3ebf3c38b645521b0f547947",
      "kind": "character_system_text",
      "source_text": "课间我都会按压穴位来缓解疲劳。\r\n做起来很简单，所以\r\n很想推荐给您",
      "source_fingerprint": "9206bf03333cee547698a8b862b7e0995d6a39ccb0ab4284a9072c828c917f78",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90002"
      ]
    },
    {
      "uid": "zhcn:af0b9a648bf36517f8fed5ba",
      "kind": "character_system_text",
      "source_text": "今天我带了便当\r\n是母亲亲手教我的煎蛋卷……\r\n您愿意的话要尝尝吗？",
      "source_fingerprint": "618346972cf401c16e75d990e79b16fd7a2e1220884a534b272c1adb4ebe4ade",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90003"
      ]
    },
    {
      "uid": "zhcn:b4e4808a5be4ea0fce8e2bfc",
      "kind": "character_system_text",
      "source_text": "今晚要在……莱茵同学她们的\r\n房间集合。四人对战游戏，\r\n我也会稳扎稳打到最后。",
      "source_fingerprint": "056569594e89c682ca2bb01ede35a84d8ecd565f475a7734c3a6f65a05f3196a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90004"
      ]
    },
    {
      "uid": "zhcn:50817dd4b17b422fddaeffda",
      "kind": "character_system_text",
      "source_text": "如果您睡不着，要不要给您\r\n一副蒸汽眼罩？这是我试过的\r\n安眠用品中最推荐的一款",
      "source_fingerprint": "2636265aa822bc94c0576c00a4000d8ac92ec027dac28706b289cbbf7e1da447",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90005"
      ]
    },
    {
      "uid": "zhcn:d90290b011203fe77c14dd40",
      "kind": "character_system_text",
      "source_text": "湿纸巾和垃圾袋……还有\r\n膝毯好像也不错呢。\r\n下次赏花之前得准备好。",
      "source_fingerprint": "bad79a7d15c026145a88c4d3062846b0f1b3119fe28dea6330a59ff8aa5b7224",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90006"
      ]
    },
    {
      "uid": "zhcn:147d330ecdb39bca0f13783b",
      "kind": "character_system_text",
      "source_text": "到了麝香葡萄美味的季节。\r\n尤其是吃过苏打水浸泡的葡萄\r\n清爽的甜味便会迸开，令人幸福。",
      "source_fingerprint": "0048703965d98125cd17b5ee15c4f1db4cbf39c98874d63c2694391ffc8fdb91",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90007"
      ]
    },
    {
      "uid": "zhcn:885dfa3dcad381332134f941",
      "kind": "character_system_text",
      "source_text": "天气凉快了，要不要一起\r\n运动运动？父亲是篮球\r\n教练，所以我略有心得。",
      "source_fingerprint": "edf6ac320fe764ea8efe6a2d20fe2e79aac0f45bcd5e113bcd596230be249ec1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90008"
      ]
    },
    {
      "uid": "zhcn:6d041e83d5c7b394c62a7d26",
      "kind": "character_system_text",
      "source_text": "我要和同期的大家一起吃黑暗火锅\r\n放什么食材好呢？\r\n大胆些，放点可食用的苔藓之类…？",
      "source_fingerprint": "e58a84842155739e7086b175eb61ed1bad58a9176a1a8b1171855cfd99a62b03",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90009"
      ]
    },
    {
      "uid": "zhcn:a6c5d0329a0888863a0151a3",
      "kind": "character_system_text",
      "source_text": "情人节……快乐",
      "source_fingerprint": "4b7e11dcf7d36399b15d230c810a93a48bd78c089bc62a3db49804ea1160b8b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "90020"
      ]
    },
    {
      "uid": "zhcn:f105dd646c437f8da7468f71",
      "kind": "character_system_text",
      "source_text": "真是的，强击同学…。\r\n我都说过了，被兄弟姐妹以外的人用昵称叫\r\n会很难为情…。",
      "source_fingerprint": "a9a696aeeed1129c0eadd34426702086ed62ce5198b06ebc5bb667847b2236a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91000"
      ]
    },
    {
      "uid": "zhcn:fbc1971afd4aacd5f741ec25",
      "kind": "character_system_text",
      "source_text": "摆弄天平会让我平静。\r\n在努力让两边保持均衡时，\r\n会自然地集中精神，变得心无杂念…。",
      "source_fingerprint": "04b966a8b1514956effa0187d4d0b53e55a4397b5d0285c76cea86b59e8f05cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91001"
      ]
    },
    {
      "uid": "zhcn:d56ba62f8175060f2f5e9a52",
      "kind": "character_system_text",
      "source_text": "小时候我非常怕生…。总是\r\n躲在母亲身后，紧紧攥着\r\n她的衣摆",
      "source_fingerprint": "2b5984fd0d9b97755cda28e41fd7fcced102dce80c915271a09cb5986b4c918d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91002"
      ]
    },
    {
      "uid": "zhcn:423b8337a41f00b9202e0b31",
      "kind": "character_system_text",
      "source_text": "偶尔，会和在韩国留学的哥哥\r\n打电话。他总会教我很多事，\r\n聊起来很开心。",
      "source_fingerprint": "d5e1fadc7f6f127be2f7ad51dba2b3781b5e199825ca2d5e743e500db3664375",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91003"
      ]
    },
    {
      "uid": "zhcn:6a68809071b0690f6b2c6c27",
      "kind": "character_system_text",
      "source_text": "神宫同学喜欢的音乐……\r\n每一首都很刺激。固有观念仿佛被\r\n摧毁，让人获得重生…。",
      "source_fingerprint": "bbe4a458a06187b959087fd67077d801158257d9b67dc386f4b68b7188a32ac1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91004"
      ]
    },
    {
      "uid": "zhcn:8a7ba6f8ef7b6e456d015051",
      "kind": "character_system_text",
      "source_text": "无论被安排怎样的编舞\r\n我都一定会掌握。坚持每天\r\n练习，不断积累。",
      "source_fingerprint": "35fa88f178fbd5f1ff655d321ae671ebfb284398f861fbdc05c3b16da56c0c48",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91005"
      ]
    },
    {
      "uid": "zhcn:a2b47fb12b811971b72e2632",
      "kind": "character_system_text",
      "source_text": "以能让支持我的粉丝们\r\n全都露出笑容……这样的演唱会\r\n为目标，我会不断前进。",
      "source_fingerprint": "daf2062115c228a979080af1a765ea7624bfcb76cf51503e2a39250f0b49a64e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91006"
      ]
    },
    {
      "uid": "zhcn:e7031c3e6dc77785f9edbc8a",
      "kind": "character_system_text",
      "source_text": "黄色是象征光的颜色。这套服装，\r\n彰显的是让母亲传给我的一切\r\n绽放光芒的决心。",
      "source_fingerprint": "574da29435a0329c480a4d15103e0cb3b98bff3bd499101ff631075c355f835b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91007"
      ]
    },
    {
      "uid": "zhcn:8f28f074cd857968004b54e4",
      "kind": "character_system_text",
      "source_text": "决胜服是赛马娘的灵魂。\r\n每天都必须检查它的状态，\r\n看看有没有开线或破损。",
      "source_fingerprint": "738436288185ff730c011fff088fd31ae57483eca189e209610317fc1969ab96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1111",
        "91008"
      ]
    }
  ]
}
