        "1109",
        "140012"
      ]
    },
    {
      "uid": "zhcn:6da76cd9303ca112413545b1",
      "kind": "character_system_text",
      "source_text": "哦哦！",
      "source_fingerprint": "491afe930290ca00537960230e3bbc3448d690ce63dc08b63e2557d06bba67b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
