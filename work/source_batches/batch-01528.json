      ]
    },
    {
      "uid": "zhcn:c8879bb49ab1985127e45872",
      "kind": "character_system_text",
      "source_text": "我能掌控的道路是~",
      "source_fingerprint": "1076467cdd85709ab509b99247861244845e16df44246b716afd8d09faaf83e1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
