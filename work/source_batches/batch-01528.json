      ]
    },
    {
      "uid": "zhcn:b8943ca7afde6fb4d7a64e9b",
      "kind": "character_system_text",
      "source_text": "呣。",
      "source_fingerprint": "f4ae6796c49d7ff7bf74b48a7ac55f1de6a73e391bb31df305f28fab08faea36",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
