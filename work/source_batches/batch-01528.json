      ]
    },
    {
      "uid": "zhcn:a0b094a21c28382fa9b5f421",
      "kind": "character_system_text",
      "source_text": "好厉害！",
      "source_fingerprint": "c922c5de8a35921e2086ab355870227069194ca65614c757deb698452d7f0151",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140011"
      ]
    },
    {
      "uid": "zhcn:cb9da1657a51c6895c022f51",
      "kind": "character_system_text",
      "source_text": "就这样就这样~",
      "source_fingerprint": "a269059e2e0f750c25d859bfcdd24ed11609d5463cad915001a7282b15d924de",
      "source_path": "character_system_text_dict.json",
