      ]
    },
    {
      "uid": "zhcn:56b3fdc01def475bd5c5b651",
      "kind": "character_system_text",
      "source_text": "哇哇！",
      "source_fingerprint": "ec94a89c3124f4bfbf497743a5850ae2b160bba7651e6f7f6cc904b7b3b0e77c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
