      ]
    },
    {
      "uid": "zhcn:a105ac908201278ffe727825",
      "kind": "character_system_text",
      "source_text": "做到了呢！",
      "source_fingerprint": "6c06afc0357e3d4db5dd000e11dda6436e5929ae261df0ef219bc893f78ca1e9",
      "source_path": "character_system_text_dict.json",
