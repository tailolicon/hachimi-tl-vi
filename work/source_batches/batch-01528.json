      ]
    },
    {
      "uid": "zhcn:57cd9a28ce89ef01587e21fe",
      "kind": "character_system_text",
      "source_text": "欸嘿嘿。",
      "source_fingerprint": "b9dd9e13169cb704e4877daa3f12ccdccc776e5e2fbbfe4952163291d0c70087",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
        "140009"
      ]
    },
    {
      "uid": "zhcn:c01a4ed9cc6f4609653eb508",
      "kind": "character_system_text",
      "source_text": "慢慢来。",
      "source_fingerprint": "00982313bbafed81aef7e5475ea83ad2a45565cec0be6fdad74ed1371d873c6d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1109",
