    },
    {
      "uid": "zhcn:b19bcfbf099f878c4be8dbbf",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "下次我一定——会完成给你看。",
      "source_fingerprint": "66913ee670190d2e1639f01021cec7fd92efba49a05f6c1f9dd23ecafad8dc96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
