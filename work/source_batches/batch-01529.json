        "1134",
        "30004"
      ],
      "json_pointer": "/1134/30004"
    },
    {
      "uid": "zhcn:69933a180b3bc7ef266e02c5",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "请看着我们束起的光辉。",
      "source_fingerprint": "03d88d07915bdd00afed2061ba1c3aca22a1dfc7fcc63d7026fc82da7fb5c47f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30005"
      ],
      "json_pointer": "/1134/30005"
    },
    {
      "uid": "zhcn:2660296c6f2d8c92174f7a3a",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我去了。",
      "source_fingerprint": "ebb3b5747aac5d1f6d21b9c56938d0539c4409611d4bf07658d1e6e8f33c407a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
