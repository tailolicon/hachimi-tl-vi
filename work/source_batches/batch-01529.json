      ],
      "json_pointer": "/1134/70014"
    },
    {
      "uid": "zhcn:463284b62457c5747c5f943e",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "我的誓言绝不会动摇——黑色就是它的体现。",
