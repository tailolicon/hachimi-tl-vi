    },
    {
      "uid": "zhcn:6b438838fbc2497ed6e6bd76",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "没有时间——沮丧了。",
      "source_fingerprint": "a81c1659fa60685fdbc1e57c680c8487117c3a317deb5db6e05eb7e7b1493aa7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30002"
      ],
      "json_pointer": "/1134/30002"
    },
    {
      "uid": "zhcn:422d5e0723811afb15fecb31",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "必须更加——努力才行。",
      "source_fingerprint": "ee7c398c65792af6ff982c834ac3ffd79aa3a21069d98a10b05215e4662bf829",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
