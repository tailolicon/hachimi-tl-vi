    },
    {
      "uid": "zhcn:fa88a71212e2db9058583d31",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今天诞生的欢呼之花——\n正是你的献身结出的证明。\n请尽情——收下吧。",
      "source_fingerprint": "85d97ed8297a43df514285998e05ab4e7d4d3946edde2507ce209b61911d2877",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
