        "1134",
        "70001"
      ],
      "json_pointer": "/1134/70001"
    },
    {
      "uid": "zhcn:5ff93e15b8afbe7e22510159",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "紫色与白色的配色——像三色堇一样漂亮呢。",
      "source_fingerprint": "0ca9cc92d4e6c417078ad92f108f6755431db5442ab3745d53fd313db32af0a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
