    {
      "uid": "zhcn:ca43d5100114ad0b7c1c52aa",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "明明离花束——只差一步了…。",
      "source_fingerprint": "8381afd2625a45ca40d865128391cdbfdf0fc827a7db33dcefe6d0781cceaf31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
