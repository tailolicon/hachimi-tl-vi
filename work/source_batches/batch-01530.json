      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "调和与，色彩……。",
      "source_fingerprint": "a005a3c136079d05ac1c266c36aa87ee0fbbfbf5f0158d31fa62b7cf1a52662b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
