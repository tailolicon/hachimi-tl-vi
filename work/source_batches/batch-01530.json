    {
      "uid": "zhcn:4549c1c9eb3956cad448b47b",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "花艺的搭配，就像这样……。",
      "source_fingerprint": "bdd2536eee407f1bb2b308a0d096506f3a738ad5d9bc967a8b9d28f3eda2aeb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
