    },
    {
      "uid": "zhcn:709daacf2f6069627e6bfec6",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "最好把我盯紧一点哦。\n别让我冲过终点后，就这样\n飞到什么不知名的地方去了！",
      "source_fingerprint": "b19fc7af13eb818bf93bc471c665932faa0074c8c0fd0614b2da0cda5d3b43c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
