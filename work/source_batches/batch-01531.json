      "json_pointer": "/1135/20002"
    },
    {
      "uid": "zhcn:d9d27b9c6f1d65b61837afad",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "训练员，别太让我心急啊。\n今天我想好好动一动……\n再不快点，我就要擅自开始了哦！",
      "source_fingerprint": "dccfc94a055e03c834ccbd0fbb138fd7e3379751ef9e63b1664e746273374552",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "20003"
      ],
      "json_pointer": "/1135/20003"
    },
    {
