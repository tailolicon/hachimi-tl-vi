        "1135",
        "20023"
      ],
      "json_pointer": "/1135/20023"
    },
    {
      "uid": "zhcn:603939d2ebf01a065b9d4390",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "如果有什么会改变的话……\n或许就是今天了呢。\n……请在特等席上，见证到最后哦？",
      "source_fingerprint": "fc0e141a2735848d7c1ef25b15433a27e415682226c98cb8b2d5665ce6acc277",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
