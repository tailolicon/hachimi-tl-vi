{
  "schema_version": 1,
  "batch": 1531,
  "batch_count": 1703,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "e986962879d48100c079e1a81335b9de9e25b281",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:ccae1722eb3d2fa59922debf",
      "kind": "character_system_text",
      "source_text": "这就是，继承而来的力量――",
      "source_fingerprint": "b7f6f1cb0e6ddc9c2ed46814d085ea5bbfae0d2809d25d3326f871ed6612c96e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "120000"
      ]
    },
    {
      "uid": "zhcn:88ca6c5bddb2549ff5275160",
      "kind": "character_system_text",
      "source_text": "这是今天的登录奖励。",
      "source_fingerprint": "7cc7b99b32d8f34da6bd620973df2ae9a0a57751a69db6f6dffcae6088fc7c17",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "13"
      ]
    },
    {
      "uid": "zhcn:174017ea6c9d53549b07e48f",
      "kind": "character_system_text",
      "source_text": "开始吧。",
      "source_fingerprint": "5340d32cafefeb07fb71f273be0d9e41c17a0c3f97ce3ec0784aa70ad39fd299",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140000"
      ]
    },
    {
      "uid": "zhcn:dfab802454aa20857976c2ed",
      "kind": "character_system_text",
      "source_text": "好……！",
      "source_fingerprint": "f93d3b7ef27d7cc0857d72ec2a4909bbb86efae229156b450540a7bebfc972c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140001"
      ]
    },
    {
      "uid": "zhcn:03350cc85e13b1c4c0c77217",
      "kind": "character_system_text",
      "source_text": "唔。",
      "source_fingerprint": "533af1ec55aaabd2fb64979f1b375b53b2aa3d91c5132bfaaf1eceef39f399ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140002"
      ]
    },
    {
      "uid": "zhcn:852d4b1af970d3ea014a557b",
      "kind": "character_system_text",
      "source_text": "这么多……！真是出色的专注力！",
      "source_fingerprint": "b5a198e3ea7de6a4acf83da8ae396c6718ecae4330e5efda90578913271cc3c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140003"
      ]
    },
    {
      "uid": "zhcn:8f27917c2ba06d6238f1efa8",
      "kind": "character_system_text",
      "source_text": "……真可爱。",
      "source_fingerprint": "29653d0dac00d4197471f9b6a3276198c62a212e79bdf213d02578c7a819d572",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140004"
      ]
    },
    {
      "uid": "zhcn:f9f0936f841fc45e73186b53",
      "kind": "character_system_text",
      "source_text": "……用到下次吧。",
      "source_fingerprint": "2ef78ed4b9553017b32da676571637bbd2f3bec8085bcb54b9a94542c956f66b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140005"
      ]
    },
    {
      "uid": "zhcn:a0a922567d9bc413fd256196",
      "kind": "character_system_text",
      "source_text": "这么多……！真是出色的专注力！",
      "source_fingerprint": "b5a198e3ea7de6a4acf83da8ae396c6718ecae4330e5efda90578913271cc3c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140006"
      ]
    },
    {
      "uid": "zhcn:923f6ded15891544b437b7bd",
      "kind": "character_system_text",
      "source_text": "……真可爱。",
      "source_fingerprint": "29653d0dac00d4197471f9b6a3276198c62a212e79bdf213d02578c7a819d572",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140007"
      ]
    },
    {
      "uid": "zhcn:5de2e2c376074fcbfb8493df",
      "kind": "character_system_text",
      "source_text": "那么……。",
      "source_fingerprint": "146069b643c6668acc74944c0a932644d0aaa363332a146c873f12a15bd68de7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140008"
      ]
    },
    {
      "uid": "zhcn:fa2451d8c42e75d01ad4b509",
      "kind": "character_system_text",
      "source_text": "嗯……。",
      "source_fingerprint": "6bd7674ae15dc5c25811d101fc522c48bef95dcff5df37c8affcde958805dcdc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140009"
      ]
    },
    {
      "uid": "zhcn:c66507daa5983421541069ab",
      "kind": "character_system_text",
      "source_text": "集中。",
      "source_fingerprint": "b65bda3e4804f46ed70197c5ef2281d1e5ad51cbe99f4b35590bcdbd0698abc1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140010"
      ]
    },
    {
      "uid": "zhcn:f288452d5e314c0732dc41eb",
      "kind": "character_system_text",
      "source_text": "连在一起……！？",
      "source_fingerprint": "77d3fac527939fe0d8a576401a95b5e9e735e97b054d97d2f2f3852c5509fd3c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140011"
      ]
    },
    {
      "uid": "zhcn:dbb551265c75866e57f50702",
      "kind": "character_system_text",
      "source_text": "成功了……！",
      "source_fingerprint": "5a45daa99d47f792f2e008a4d0f0b1b9ac1f29d1a3b8800e80d5d08a8e678d39",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140012"
      ]
    },
    {
      "uid": "zhcn:7531de37178e1b35198065eb",
      "kind": "character_system_text",
      "source_text": "就这样……！",
      "source_fingerprint": "c107239d46d94844e729b0f9db5541e4dda7f29df7594f043462707cc931fba5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140013"
      ]
    },
    {
      "uid": "zhcn:2a7f779f038658f959666cf5",
      "kind": "character_system_text",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140014"
      ]
    },
    {
      "uid": "zhcn:0908484ded49187581c3225f",
      "kind": "character_system_text",
      "source_text": "呼……。",
      "source_fingerprint": "f81d129916de8c3ba2ae94389e277a5e59ddda1de2c5af0e0d67323fb5a78727",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140015"
      ]
    },
    {
      "uid": "zhcn:3398021a7d95930f579cfa9a",
      "kind": "character_system_text",
      "source_text": "不玩吗？",
      "source_fingerprint": "cc304fadcd6becac564f5785fce2864eba507fa5d1be809a2a506cafaae0909b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140016"
      ]
    },
    {
      "uid": "zhcn:4474a56e5e6b8f29b9c80773",
      "kind": "character_system_text",
      "source_text": "唔！",
      "source_fingerprint": "e25fbfb5adf006063d769535cca5c4bf887ead87e21d1fb7929b3b1028061378",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140017"
      ]
    },
    {
      "uid": "zhcn:b07a34857c2e951bec410e76",
      "kind": "character_system_text",
      "source_text": "啊啊……。",
      "source_fingerprint": "30e2d95119bde6568d56818441797a798cd7d8143a5690f18751dd3be7ad0628",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "140018"
      ]
    },
    {
      "uid": "zhcn:36093af121fadc08b6f408ac",
      "kind": "character_system_text",
      "source_text": "明天似乎是这个。",
      "source_fingerprint": "9fed1e5dc328f84eeb3cea132edfbdad24cc0dcd3a4c4dbe62ed02381a47b07e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "15"
      ]
    },
    {
      "uid": "zhcn:fcba7ff2c3287533b828c4a6",
      "kind": "character_system_text",
      "source_text": "……我建议休息。这样下去，\r\n会影响训练表现。",
      "source_fingerprint": "75feeb7c7009a6bf4500d7979e8b38e31f4bc887db6885441f2b9bbfa23787bc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20000"
      ]
    },
    {
      "uid": "zhcn:54e9d16ed12ea79deb8d6817",
      "kind": "character_system_text",
      "source_text": "……以现在的状态继续训练，\n难以期待成果。\n最好先调整一次。",
      "source_fingerprint": "4ceb3398ab010358a1ed454b316d2ef64058a91336cd8c6049e1773d0b9eeb6c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20001"
      ]
    },
    {
      "uid": "zhcn:f281aee8a1dd8b497b0e575e",
      "kind": "character_system_text",
      "source_text": "……所有感觉都协调一致。\r\n即使比平时更艰苦的训练\r\n也能顺利完成。",
      "source_fingerprint": "2140c2fca29f34206e0f30060919b8f598fdd113eb835b2d394ca5d1621245d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20002"
      ]
    },
    {
      "uid": "zhcn:909dba1bd3b904cb017bec01",
      "kind": "character_system_text",
      "source_text": "为了达到与那些光辉璀璨，名留历史的\r\n先辈相同――不，\r\n更高的境界……！",
      "source_fingerprint": "35688383131f3eaaeda4d1b22222c83dd288eeb9e0a01cb8122933308ea5f251",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20003"
      ]
    },
    {
      "uid": "zhcn:f881cc73211ac8d4e542b8b5",
      "kind": "character_system_text",
      "source_text": "我想稍微改变一下跑位路线。\r\n开始冲刺的位置也一样――\r\n想要，彻底找出最优解。",
      "source_fingerprint": "cf6022ea8834c724d5ccd75eee6c8631bb01e681b7d898af3b44ab1ee87d144d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20004"
      ]
    },
    {
      "uid": "zhcn:1abf578240a1ccd133d052d4",
      "kind": "character_system_text",
      "source_text": "为了以最强之姿君临\r\n――开始吧。",
      "source_fingerprint": "0a9423f4ef03bb19e0e065742be12c58b25f20b575e37248c35a7e37acaecfcf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20005"
      ]
    },
    {
      "uid": "zhcn:4bf720032eeaa0fe8638d610",
      "kind": "character_system_text",
      "source_text": "始终，做该做的事。\r\n父亲也，祖父也。都是靠不懈努力\r\n留下了前无古人的成绩。",
      "source_fingerprint": "be647f5681dd0e745a90d1400f7803a0389053dac22223639c5e7de1a52de981",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20006"
      ]
    },
    {
      "uid": "zhcn:e16c88884916d02053b247a1",
      "kind": "character_system_text",
      "source_text": "既不狂躁，也不一味沉静\r\n――只是，做该做的事",
      "source_fingerprint": "fe290da575e3b765df6cb884e57176afdccce4f9bbbbc00dd65bc2fa12beff10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20007"
      ]
    },
    {
      "uid": "zhcn:3ea07a85cd6d0834ecff4e1c",
      "kind": "character_system_text",
      "source_text": "呼……，不必在意。\r\n我刚才在冥想……。\r\n稍微，有些杂念。",
      "source_fingerprint": "295d55fd930986c5d93f5af994b8cdb3792e0d4c5189734fe3922610eb91f9ed",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20008"
      ]
    },
    {
      "uid": "zhcn:a174c9de9b1d5519837cc129",
      "kind": "character_system_text",
      "source_text": "听节奏快的歌曲，\r\n能让我做好训练前的心理准备。\r\n……不过，感觉不到效果……。",
      "source_fingerprint": "f586e01c287f68508534d12b2a5692918c5ed12eeb92943b48e3858a09307ca5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20009"
      ]
    },
    {
      "uid": "zhcn:1bba2061d7bcf9da8e41fa43",
      "kind": "character_system_text",
      "source_text": "……别被其他事物分心。\r\n集中精神……。",
      "source_fingerprint": "820add72587f09444dedae49e41fe8f48ddb3f957856deeae6bbb53887079315",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20010"
      ]
    },
    {
      "uid": "zhcn:9458bed534f907a209841b12",
      "kind": "character_system_text",
      "source_text": "抱歉，我马上准备……\r\n……呼，吸……。",
      "source_fingerprint": "8d35d4aa702e073a1c9d7a02eeab6407be21e7b58e59c93ba9eae93693f244a0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20011"
      ]
    },
    {
      "uid": "zhcn:cfc0273afd83d6aed1960a2c",
      "kind": "character_system_text",
      "source_text": "……最近连续参赛。\r\n腿和精神都会承受负担……\r\n之后的调整会不会需要很长时间",
      "source_fingerprint": "e38a13aa68b5806121e4116c2250bec8a3a59a1755bf1bf8c64e96321b04259f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20021"
      ]
    },
    {
      "uid": "zhcn:03d8377bc383c5303c953a62",
      "kind": "character_system_text",
      "source_text": "……积累的疲劳和参赛带来的\r\n风险，已经不容忽视。\r\n虽然危险……真的，要挑战吗？",
      "source_fingerprint": "9f32fd401e82918443ac4099678d26fc3769e3870967996c53a2ab0778458e44",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20022"
      ]
    },
    {
      "uid": "zhcn:f662fd0f11ebee760ce3ccb4",
      "kind": "character_system_text",
      "source_text": "双腿轻盈，心率也无可挑剔……\r\n这样的话，应该能发挥出\r\n最佳表现。",
      "source_fingerprint": "99336377d801f90f871a256628cb6cc933f3d149f5c65a5107cfc718c295e666",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20023"
      ]
    },
    {
      "uid": "zhcn:ecc0f16d7e36f9d789ea7340",
      "kind": "character_system_text",
      "source_text": "可以说状态，无限接近理想。\r\n――我出发了。",
      "source_fingerprint": "56a391a2bf543047fd37c9a3aa2a647a5c2eb5ade2b406faecd8b6fd01a60dc7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20024"
      ]
    },
    {
      "uid": "zhcn:ae904fb0fc72eef13afd3463",
      "kind": "character_system_text",
      "source_text": "狂野地，激烈地――\r\n随着高昂的心跳，出发。",
      "source_fingerprint": "da5857acc5e53bccde2da78049b674e2bb48a64bd2b9b0b0ed2319e964c50ffb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20025"
      ]
    },
    {
      "uid": "zhcn:e5ce85fb9526fe3a1f2b2137",
      "kind": "character_system_text",
      "source_text": "调整得很好。接下来，\r\n只需相信这血脉中蕴藏的力量……！",
      "source_fingerprint": "12698dc554ebae4d1a5185d72946582e183381b061290561dc8b3836a465e389",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20026"
      ]
    },
    {
      "uid": "zhcn:856a88effbb9cc02b9cd017c",
      "kind": "character_system_text",
      "source_text": "用成绩证明，“最强”――\r\n证明名为我的，结晶。",
      "source_fingerprint": "aebf2a28f1ef231d61ed4c96d860f4935a9aff85f80f285c76d96ae9eb440d09",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20027"
      ]
    },
    {
      "uid": "zhcn:53ffaaa436e1405b3bad7f06",
      "kind": "character_system_text",
      "source_text": "作为家族的一员，\r\n交出足以自豪的成绩。\r\n向这沸腾的，血脉起誓――",
      "source_fingerprint": "8279736709c7ad474f9424e7c12b3598ba27049f38ca4e864f0efe5d961f3783",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20028"
      ]
    },
    {
      "uid": "zhcn:9626f478ce690f57d4811197",
      "kind": "character_system_text",
      "source_text": "状态不好，也不坏――\r\n但，最强必须始终如一。",
      "source_fingerprint": "f747967d479a7c7c8bf9ea687d6bb31b0d2c2bd53fa5c1c5bb3bafdbdbe2528e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20029"
      ]
    },
    {
      "uid": "zhcn:7864e216d26b6811b83313d2",
      "kind": "character_system_text",
      "source_text": "调整没有问题。\r\n日积月累的训练\r\n会直接化为力量。",
      "source_fingerprint": "877d8567ba74c77b8c3fc012406bd5852ee38b24ef65d42415d1512052b68982",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20030"
      ]
    },
    {
      "uid": "zhcn:02ffb6e3a45f5507ad1dc11a",
      "kind": "character_system_text",
      "source_text": "状态不差。\r\n总之别太用力，保持平静……\r\n不，应该说，不要太在意",
      "source_fingerprint": "828729629765b4aa795ce5b76eeaa317a6821b196e7928bd9b6186c73f02b312",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20031"
      ]
    },
    {
      "uid": "zhcn:38721c7e58fe4fc366c07ba1",
      "kind": "character_system_text",
      "source_text": "调整没能赶上，不过……\r\n不能，辜负期待……。",
      "source_fingerprint": "80fa723dd9ba7b3fb841ed6ddcad40ea064df57a2e35e3701b9f6e5aba686db9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20032"
      ]
    },
    {
      "uid": "zhcn:7bdbcf932b36ce353adde7a5",
      "kind": "character_system_text",
      "source_text": "……呼……。\r\n稍微……有些紧绷。\r\n必须在正式比赛前调整好……。",
      "source_fingerprint": "02d69db4c81dcda985fbf8b38780fe8d6bc3620478d8307ca019827bf578530b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20033"
      ]
    },
    {
      "uid": "zhcn:9488708b4662fbca04594fa3",
      "kind": "character_system_text",
      "source_text": "注意力，稍微有些乱……\r\n努力不会背叛我。……应该如此。",
      "source_fingerprint": "b505681698d341273249ceb57f3b2e960f12316cb10596f4d8cc03c67a457edd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20034"
      ]
    },
    {
      "uid": "zhcn:798056fde0689945b670d181",
      "kind": "character_system_text",
      "source_text": "即使状态没有调整好，\r\n正式比赛也不会等我……。\r\n――即使，不完美。",
      "source_fingerprint": "8cf2c0c9b1dc51d708a2e934b7e821ad239d7806220e9ef3f4845c920bc01fe1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20035"
      ]
    },
    {
      "uid": "zhcn:404037f08f6ad09d77c621e6",
      "kind": "character_system_text",
      "source_text": "……必须，交出成绩。\r\n不能，辱没家族的名字……。",
      "source_fingerprint": "1910e2c8ef21ab70f2cfe6d02621576f5457d93ef04dba7b2f01f5769ba55ca0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20036"
      ]
    },
    {
      "uid": "zhcn:92a634eddeeebbf979e5367d",
      "kind": "character_system_text",
      "source_text": "不能，交出不争气的成绩。\r\n无论如何……绝对……！",
      "source_fingerprint": "302e56c7d6f9c97f3801582baa938fcaa3026fab33eefac4bb887371a126724b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20037"
      ]
    },
    {
      "uid": "zhcn:c1042bfacfa2a8e3a62aa9ea",
      "kind": "character_system_text",
      "source_text": "哈啊！",
      "source_fingerprint": "987facfa0bd632334d8a05553b9672e89a8a7394f0bec63972d3ebacb7853c88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20038"
      ]
    },
    {
      "uid": "zhcn:2814a20bca541a09436d09fe",
      "kind": "character_system_text",
      "source_text": "了解。",
      "source_fingerprint": "0157e6aed55c5c02d6a5db10de6381ff48cf5d42afdf83c802629cb18e71b92a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20039"
      ]
    },
    {
      "uid": "zhcn:86dd504a6cb1b491b9306e87",
      "kind": "character_system_text",
      "source_text": "没问题。",
      "source_fingerprint": "46c203e08ee64dda5507916e97e364a579280d5df6f82c856df6d771b5c8bee3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20040"
      ]
    },
    {
      "uid": "zhcn:4756db939f3fb0bc9715dc23",
      "kind": "character_system_text",
      "source_text": "理论课吗。",
      "source_fingerprint": "76b6d57fbf4e19d8e5e5775d253ac1dc9dc5e2cb0008497a2d0caed6425449fd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20041"
      ]
    },
    {
      "uid": "zhcn:1c1cb1914ecb8628c6e2dac6",
      "kind": "character_system_text",
      "source_text": "唔……！",
      "source_fingerprint": "88b08a445830f60f831cc69715bfe607a664dd20f0eb7a6b5add5663dfe83b11",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20042"
      ]
    },
    {
      "uid": "zhcn:fb4e243157036411e61150d9",
      "kind": "character_system_text",
      "source_text": "唔唔……。",
      "source_fingerprint": "25494e0ac35a5d9a33a3e3fc26b271c9b18f36d94b7fa445ba75b0fd858609be",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20043"
      ]
    },
    {
      "uid": "zhcn:de91bbf9783385b3a1b8a6d8",
      "kind": "character_system_text",
      "source_text": "出发吧。",
      "source_fingerprint": "b0e503174d4061b5a441fdf881cb3104cb5ae97793c7d54f43b96980f665783a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20046"
      ]
    },
    {
      "uid": "zhcn:755d68d70383652e1bae22dd",
      "kind": "character_system_text",
      "source_text": "大海啊……。",
      "source_fingerprint": "9621d39b7c59161d747eb39b928d6430993ae6f9c90aee43c1a8a10a7eb7a692",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20047"
      ]
    },
    {
      "uid": "zhcn:dfa079a45db3af863aeb467d",
      "kind": "character_system_text",
      "source_text": "感谢你，为我指明道路。",
      "source_fingerprint": "fe362ae48d7efa05e6ac7e070020048db0a667b3daa19f66db2f7fbd6ed24cfb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20049"
      ]
    },
    {
      "uid": "zhcn:e1ae2a45a41ac1d2790cdfbb",
      "kind": "character_system_text",
      "source_text": "谢谢你，陪我走到这里。",
      "source_fingerprint": "3d50daff362f4a18cc3a1a8813ed875f0c398581cdefee70ee5a6d3acc12d584",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20050"
      ]
    },
    {
      "uid": "zhcn:b1a14e9ac90c5203b74a6aad",
      "kind": "character_system_text",
      "source_text": "稍微狂野一点――",
      "source_fingerprint": "30983c6df932ecf721e69a0b3070ab81f54b61558f74a7531bbe8c698ca3489e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "20051"
      ]
    },
    {
      "uid": "zhcn:8a1bfe10061a740a327b2974",
      "kind": "character_system_text",
      "source_text": "――出发。",
      "source_fingerprint": "c963e152abff7e182db29d21b6dd64d75a237557c55784c43388e18d8c803d5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "2030"
      ]
    },
    {
      "uid": "zhcn:ed2ab2ff27627c105decaea9",
      "kind": "character_system_text",
      "source_text": "狂野地，前进――",
      "source_fingerprint": "89db2fb30b6bbc2ced11a77be8876453c006df809085aeb26bca93a3d2563269",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "2031"
      ]
    },
    {
      "uid": "zhcn:f56a53fcaf5ffc7519dba435",
      "kind": "character_system_text",
      "source_text": "谢谢你，陪我走到这里。",
      "source_fingerprint": "3d50daff362f4a18cc3a1a8813ed875f0c398581cdefee70ee5a6d3acc12d584",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "2032"
      ]
    },
    {
      "uid": "zhcn:a3acaded8cf60eb31ee87855",
      "kind": "character_system_text",
      "source_text": "作为家族的一员，\r\n交出足以自豪的成绩。\r\n向这沸腾的，血脉起誓――",
      "source_fingerprint": "8279736709c7ad474f9424e7c12b3598ba27049f38ca4e864f0efe5d961f3783",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "2033"
      ]
    },
    {
      "uid": "zhcn:49231fb7861a1e9fb32e5dcd",
      "kind": "character_system_text",
      "source_text": "狂野地，激烈地――\r\n随着高昂的心跳，出发。",
      "source_fingerprint": "da5857acc5e53bccde2da78049b674e2bb48a64bd2b9b0b0ed2319e964c50ffb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "2034"
      ]
    },
    {
      "uid": "zhcn:8b0f98ac575bde43221422be",
      "kind": "character_system_text",
      "source_text": "谢谢你，陪我走到这里。",
      "source_fingerprint": "3d50daff362f4a18cc3a1a8813ed875f0c398581cdefee70ee5a6d3acc12d584",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "2035"
      ]
    },
    {
      "uid": "zhcn:9d2c82b8807c5a1211188bb8",
      "kind": "character_system_text",
      "source_text": "没问题。",
      "source_fingerprint": "46c203e08ee64dda5507916e97e364a579280d5df6f82c856df6d771b5c8bee3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "23015"
      ]
    },
    {
      "uid": "zhcn:4a4d09f16dff91b0a285d974",
      "kind": "character_system_text",
      "source_text": "……没能追上……！",
      "source_fingerprint": "f6d5cff762cb12c1bd98f4ec6a751c92395f8a4f41942fbe4051c4f4f6e4c570",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30000"
      ]
    },
    {
      "uid": "zhcn:e3d98a44d9cd6fc0515bfcc6",
      "kind": "character_system_text",
      "source_text": "……唔，实力不够吗……！",
      "source_fingerprint": "4832d290a2ee8fade8ca83ad300f0d1e6ab0634475471c5729b010636e2bd940",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30001"
      ]
    },
    {
      "uid": "zhcn:514b040bf678d17d914959ab",
      "kind": "character_system_text",
      "source_text": "入围，已是极限了……？",
      "source_fingerprint": "e2abf4132f3729645ce282f481e30c0352d4cf5a1573484d4617f468b6277167",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30002"
      ]
    },
    {
      "uid": "zhcn:f63a5f65e590ebbbf79c92f1",
      "kind": "character_system_text",
      "source_text": "离最强，还差得远……。",
      "source_fingerprint": "a571e7bf10dcf0f47cf7288ec3e89273f6345cccc4e80eee2dd5086c5ce8a62b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30003"
      ]
    },
    {
      "uid": "zhcn:2d323075f2994af046495ab6",
      "kind": "character_system_text",
      "source_text": "所有人都深信不疑。\r\n这，就是所谓“最强”。",
      "source_fingerprint": "9b348a2e5cbf5611ec5d4b88c9a5deb9ee935425b8d2d829f42a52e5688e12f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30004"
      ]
    },
    {
      "uid": "zhcn:693dd6040968922db5ad086e",
      "kind": "character_system_text",
      "source_text": "展现最强――因此，是理所当然的结果。",
      "source_fingerprint": "933baa002295d8ddb6c67887d166fe12b43aa95e7d51b71eb64dbfe22ede6612",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30005"
      ]
    },
    {
      "uid": "zhcn:06aac3db1c891c8be41d6c43",
      "kind": "character_system_text",
      "source_text": "尽情烙印在眼底吧，将这高贵的“最强”。",
      "source_fingerprint": "03571132e5ae1b86929516b3f9388f5540410e91dd5422830ec244acbe2900c7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30006"
      ]
    },
    {
      "uid": "zhcn:07aa352d3f79c977deeb5c57",
      "kind": "character_system_text",
      "source_text": "旨在展现最强――因此，这是理所当然的结果。",
      "source_fingerprint": "e8b6d9f8b18bb4872c4504da68e3ac7673ec26721fbc2e9ba0bc4b284618c7e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "30007"
      ]
    },
    {
      "uid": "zhcn:57a2cd4b84bf7b5715cbbc14",
      "kind": "character_system_text",
      "source_text": "――“压倒性”地……！",
      "source_fingerprint": "90a176624d2c7b350277108046458eceff5b6b6245f3a223f2712456851f3ec1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "31000"
      ]
    },
    {
      "uid": "zhcn:aeffce766cd93f6df3f139e5",
      "kind": "character_system_text",
      "source_text": "此刻，贯彻――最强！",
      "source_fingerprint": "0bd22d487adc4395e312d608cd3678b353149a6750cd89e955f57956dcf4ff8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "40000"
      ]
    },
    {
      "uid": "zhcn:dfda3b598d45dcaa9ae22307",
      "kind": "character_system_text",
      "source_text": "展现最强……。\r\n即使是『回应粉丝』，也一样。\r\n这就是我的使命。",
      "source_fingerprint": "e2fb0da3878755b35f9732f7cb40d94283e23283c0502589c3fe86a818470c66",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1108",
        "400000"
      ]
    }
  ]
}
