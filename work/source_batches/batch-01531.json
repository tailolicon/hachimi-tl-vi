      ],
      "json_pointer": "/1135/20025"
    },
    {
      "uid": "zhcn:2d39b045a57f96d183057623",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "起风了……强烈且真切。\n嗯，今天……感觉能把握住。",
      "source_fingerprint": "e2bc21790683e6ff488f80e434519dbcea860aae4e1183ab85397bac9c5bd01e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
