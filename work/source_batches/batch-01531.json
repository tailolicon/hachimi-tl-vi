    },
    {
      "uid": "zhcn:00e516ffac1baacff35eb870",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "坦白说，现在的状况并不理想。\n……将这视为命运的旨意并全盘接受，\n或许才是良策……吧。",
      "source_fingerprint": "7fa1896b5f9575dcd88cf4aaafabd73077f4903d39c0e4bfd968a45def7a170f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
