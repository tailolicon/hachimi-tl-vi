    },
    {
      "uid": "zhcn:a831cf7997baa4e6a2693a9a",
      "kind": "character_system_text",
      "source_text": "今日赛跑，开始！",
      "source_fingerprint": "e996dfbe67d12ffdece76d35ae8d25af6bcaec9830e95b8f3b4289137a42a734",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "31000"
      ]
    },
    {
      "uid": "zhcn:4f34a2f3aa8801c9086417c1",
      "kind": "character_system_text",
      "source_text": "将世界照亮吧，Big Love！！",
      "source_fingerprint": "a37ccb0e229a52fdaebf67772d2fb0172d3e88eeba3c5d39af7327fbf8f14b4e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "40000"
      ]
    },
    {
      "uid": "zhcn:5f3b30347144340f22f96e9e",
      "kind": "character_system_text",
      "source_text": "充实心灵的宝物。\n照亮世界的温暖。\n那就是，我们的Love！",
      "source_fingerprint": "de596e57bc2f557bcb983a0c92e09391db2444eb78ca77f0b7547af7fdeaec8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "40001"
      ]
    },
    {
      "uid": "zhcn:59df6f91c6d2b45a817764ba",
      "kind": "character_system_text",
      "source_text": "聚在这里的大家~！\nLove you♡",
      "source_fingerprint": "b865b659575408691db99c2366e6adb3a910318f8fa1cf4efe48599b2eb5dd7b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
