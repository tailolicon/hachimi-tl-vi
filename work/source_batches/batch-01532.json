      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "60001"
      ]
    },
    {
      "uid": "zhcn:a21cd12098c48e9e788899c5",
      "kind": "character_system_text",
      "source_text": "就是这样！一起上吧~♡",
      "source_fingerprint": "543cd221e67474f5855c460a5b2b8e8efb1621eb5245fc66db9d4526babac35f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "70000"
      ]
    },
    {
      "uid": "zhcn:f2f3be1624034b678163fbf7",
      "kind": "character_system_text",
      "source_text": "Love总是在意想不到的地方\n守护着我。……和你相遇的时候，\n我是这么想的。",
