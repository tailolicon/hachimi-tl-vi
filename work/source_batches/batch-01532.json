      ]
    },
    {
      "uid": "zhcn:9e090127a9221c58c6b5fe12",
      "kind": "character_system_text",
      "source_text": "虽然不甘心，但还是……\n大家，辛苦了！",
      "source_fingerprint": "603515cf039c7e6877ab04ec578a7b1c44fd0e6dfcd64fced711c774deb56255",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "30001"
      ]
    },
    {
      "uid": "zhcn:745dfa3318e21c98d399fabf",
      "kind": "character_system_text",
      "source_text": "真想给大家回报\n更多更多的爱啊……",
      "source_fingerprint": "a8748b7e4fddef1015c8e514c7166e6caecc814a48061f64474f21ff06017379",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "30002"
      ]
    },
    {
      "uid": "zhcn:9b59af6d703e0087ca400281",
      "kind": "character_system_text",
      "source_text": "是不是把“爱”弄丢在哪了呢……",
      "source_fingerprint": "2d3945f4dd9c11f780b3ec60b12b33173fb27390ac47e4885410dec8521c1353",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "30003"
      ]
    },
    {
      "uid": "zhcn:6bf3a8104f4fd68469c1d0a2",
      "kind": "character_system_text",
      "source_text": "都是因为我和大家\n无敌的Love呢！对吧♡",
      "source_fingerprint": "495d72e792fc833d188a31f79fdb52495225de4af293e74f494aa41bbf251896",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1132",
        "30004"
      ]
    },
    {
      "uid": "zhcn:ed982145e3d9feb097a2d2a0",
      "kind": "character_system_text",
      "source_text": "Love me♡  Love you♡\n这是一场充满爱的比赛呢！",
      "source_fingerprint": "559380539a17e5fb64eb430612634b52a93b1e2d1fb0c96f6770a694a5ff0667",
      "source_path": "character_system_text_dict.json",
      "json_path": [
