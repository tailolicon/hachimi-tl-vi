    },
    {
      "uid": "zhcn:70eb54a468d0decffacb170a",
      "kind": "character_system_text",
      "source_text": "收到的“爱”……\n暂时没能回报出去呢。",
      "source_fingerprint": "23058107a70284005b691dd164ff7a7b3173db2c30e5304ac667460f1e686a61",
      "source_path": "character_system_text_dict.json",
