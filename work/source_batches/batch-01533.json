    },
    {
      "uid": "zhcn:b092cdbdcc45b0730ad9c046",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "全身涌现出勇气！\n来吧，高举拳头——\n『勇者冲击』！！",
