    {
      "uid": "zhcn:b1d32bc371aabc67c58dc626",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "呵呵呵……\r\n今天就让你见识一下，\r\n我的『神业』吧！",
