      "kind": "character_system_text",
      "source_text": "勝者に相応しい華を、と\r\n中世のパニエに倣いましたわ。",
      "source_fingerprint": "91e4943b795317fc1c7a6a390f07c081d63a2154efdf82d12e2e93137193a94c",
      "source_path": "character_system_text_dict.json",
