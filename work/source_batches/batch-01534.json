    },
    {
      "uid": "zhcn:4d3adb1ea10b486439ee3b87",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "今日旭日亦从东升！\r\n风儿亦向明日而吹！\r\n嗯，看来会是美好的一天～！",
      "source_fingerprint": "502a3041831d1e7dd41f46d669dcd75bd6b35d96bdb0a66bda68b03f14bbeb22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
