      ],
      "json_pointer": "/1137/90005"
    },
    {
      "uid": "zhcn:cb5f91f4f6c4c11ea4b1cdbc",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "在宿舍门口就开始吵架的新生们……\r\n不错不错……！如果是你们，\r\n总有一天能成为最棒的宿敌……！",
      "source_fingerprint": "662aca0aaf591d296db84661df952a7db101292d80f6888f758a7b8ead1ee30d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
