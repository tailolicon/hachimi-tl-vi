      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1137",
        "400006"
      ],
      "json_pointer": "/1137/400006"
    },
    {
      "uid": "zhcn:c726f247a7a460ee0f4cfc4c",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "名留青史之战将由我，由我……由我来创造！\r\n赌上性命——燃尽灵魂吧！！",
      "source_fingerprint": "8c5e0da73b2a408b74502dfc0d9940ccf1c4f15d1267e33e954735138b59560c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
