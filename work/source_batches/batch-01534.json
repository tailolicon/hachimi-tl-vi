        "90002"
      ],
      "json_pointer": "/1137/90002"
    },
    {
      "uid": "zhcn:0dbe50d70662456fc19a6db1",
      "kind": "character_system",
      "source_language": "zh-CN",
      "source_text": "收到老妈的LANE消息，她说今天的\r\n推荐电影是科幻功夫片！\r\n……她的品味真的每次都很棒呢♪",
      "source_fingerprint": "3cd994d0a47ab7d74f1c11121964d53c4fdaa304e9f2984b2fc2d066f086a7a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "character_system_text_dict.json",
