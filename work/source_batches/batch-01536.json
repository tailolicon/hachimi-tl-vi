{
  "schema_version": 1,
  "batch": 1536,
  "batch_count": 1652,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "33cae8524551c593c4a9016580345724140f0481",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:912668e5d61ab398d201bc39",
      "kind": "character_system_text",
      "source_text": "调和起来——成为全新的我。",
      "source_fingerprint": "94fe3fac82147a7664f3462f8253c7f92915c611cd6aded0df910b5aa36d9b41",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "120000"
      ]
    },
    {
      "uid": "zhcn:641aeae38c2e809a6943f7ed",
      "kind": "character_system_text",
      "source_text": "华丽地…。",
      "source_fingerprint": "71d4856319e1c748938ac1ebef60d65e077a45569ad0077d28b26ea8b104fff0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "1270"
      ]
    },
    {
      "uid": "zhcn:c165a8c6a69637ebdb295d96",
      "kind": "character_system_text",
      "source_text": "尽情绽放吧。",
      "source_fingerprint": "551c5c6cecf9a66aa09f8240f9c313a316f06bf1b23b751f5230c1ec096630f5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "1271"
      ]
    },
    {
      "uid": "zhcn:188c27924c98d9a0cad8f0e3",
      "kind": "character_system_text",
      "source_text": "今天的登录奖励是\n——这个。",
      "source_fingerprint": "68100451b8d9bda1833bf0e5e003f00473e8e1d304db42b8ad15095cc1302b40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "13"
      ]
    },
    {
      "uid": "zhcn:e01dcb18fc9ecb4cb08794f8",
      "kind": "character_system_text",
      "source_text": "我会——为你加油。",
      "source_fingerprint": "3c6d63bfe5b6b1ccd97749d4c3d13b87977da790129eebdb9944d7e537b90540",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140000"
      ]
    },
    {
      "uid": "zhcn:a1718731ef4a237ffb290bb1",
      "kind": "character_system_text",
      "source_text": "太棒了。",
      "source_fingerprint": "4630ff91614a71d4231c39b2dc2eb6df3b988cde634293116a8f17e4371acdbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140001"
      ]
    },
    {
      "uid": "zhcn:e21a9ef468568dc2da931f18",
      "kind": "character_system_text",
      "source_text": "啊…。",
      "source_fingerprint": "edde3a8d21b92c27a5c507c923669ab158c7e313c638cf35c7fcfc2b08ad7741",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140002"
      ]
    },
    {
      "uid": "zhcn:c8c8606a4a11de28f13d1169",
      "kind": "character_system_text",
      "source_text": "真的是——非常漂亮的手法。",
      "source_fingerprint": "6d101ea2791f9c96061f799fd23e66f5df67694c10b336cb6f71af1f3edca75c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140003"
      ]
    },
    {
      "uid": "zhcn:d9774936e0c184680a5fb0c1",
      "kind": "character_system_text",
      "source_text": "连在旁边看的我也很开心。",
      "source_fingerprint": "384ee887ae32d07ed9ca6efe0d4a9eed52cf8aee6b565535927c562b80a12d1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140004"
      ]
    },
    {
      "uid": "zhcn:bd965c2feabfa15367dacf50",
      "kind": "character_system_text",
      "source_text": "下次一定——",
      "source_fingerprint": "b61faeba57a3757d68f3adfae973cd04cefa04b3634b2bdf1236b37f2c6fb698",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140005"
      ]
    },
    {
      "uid": "zhcn:8abdc4b17ca739c9266e4f4f",
      "kind": "character_system_text",
      "source_text": "真的是——非常漂亮的手法。",
      "source_fingerprint": "6d101ea2791f9c96061f799fd23e66f5df67694c10b336cb6f71af1f3edca75c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140006"
      ]
    },
    {
      "uid": "zhcn:c3ce44985bfb261710d163bd",
      "kind": "character_system_text",
      "source_text": "连在旁边看的我也很开心。",
      "source_fingerprint": "384ee887ae32d07ed9ca6efe0d4a9eed52cf8aee6b565535927c562b80a12d1d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140007"
      ]
    },
    {
      "uid": "zhcn:fa2868c27791badd204e4cea",
      "kind": "character_system_text",
      "source_text": "——怎么了吗？",
      "source_fingerprint": "5119dedfc09be228d30320508a9a170f025268de267dbb27655e5c199c415323",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140008"
      ]
    },
    {
      "uid": "zhcn:5e3d7740bb6c58dcbc58875a",
      "kind": "character_system_text",
      "source_text": "放松下来。",
      "source_fingerprint": "fb5b7d1b589781b79cab3f64a61d0cfc062b72296f311f826b6c06d1ecc3583d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140009"
      ]
    },
    {
      "uid": "zhcn:24f6f3bc99f5e53dc21978b4",
      "kind": "character_system_text",
      "source_text": "我相信着。",
      "source_fingerprint": "e0c388d9892863d48052f48d06b989ed116eccb6417e7e214244523ed8ad3c3a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140010"
      ]
    },
    {
      "uid": "zhcn:f6b8e5abdf15f016ba974abe",
      "kind": "character_system_text",
      "source_text": "哎呀——真厉害。",
      "source_fingerprint": "b1d0121276cda86163d50d088c0ebace6cab48904e14f17af14185ba93b707ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140011"
      ]
    },
    {
      "uid": "zhcn:7d31e353b82348162382d40c",
      "kind": "character_system_text",
      "source_text": "太棒了…！",
      "source_fingerprint": "59cc707a8b560688f43a8918cdcf3087c8556a92126e6204071bc593d28b1532",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140012"
      ]
    },
    {
      "uid": "zhcn:87086bb3d15e2028345db3b6",
      "kind": "character_system_text",
      "source_text": "就这样，慢慢地——",
      "source_fingerprint": "25f19433db4b20a0b75f199568b3d1378cbceccd6a7b678fdb176365ac834141",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140013"
      ]
    },
    {
      "uid": "zhcn:cab735f79968ea984edb146c",
      "kind": "character_system_text",
      "source_text": "还远远不够…。",
      "source_fingerprint": "75585c95bed47deeea58186ce7990f40bbfb54bf899c689a00f7c810490b2134",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140014"
      ]
    },
    {
      "uid": "zhcn:30b76550f886109acae0aa9a",
      "kind": "character_system_text",
      "source_text": "嗯…。",
      "source_fingerprint": "a4e8d20aa5151334b4c38a65a505a9374b636972b6acc835853e25c1ff32890f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140015"
      ]
    },
    {
      "uid": "zhcn:9b28705daa7dabe5d18441bb",
      "kind": "character_system_text",
      "source_text": "要不要稍微歇一口气？",
      "source_fingerprint": "ee33f8c66358afbdc475dec3359abdfe87bd15f1605024423e1d630fd574d286",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140016"
      ]
    },
    {
      "uid": "zhcn:3ba70fd770f4827ba8ba304f",
      "kind": "character_system_text",
      "source_text": "可惜了…。",
      "source_fingerprint": "fe3661a132d6c1c70ddae03f94e11f02c972be5b387e934f53f5dddba55b8467",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140017"
      ]
    },
    {
      "uid": "zhcn:2ad605385eec8f02e0ef5076",
      "kind": "character_system_text",
      "source_text": "没事——的。",
      "source_fingerprint": "1af9492c3e80c140ce70645ad668f3309f639700ae60f5edab40fcd302da4c49",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "140018"
      ]
    },
    {
      "uid": "zhcn:ac0e438a6e1d1c86f1573984",
      "kind": "character_system_text",
      "source_text": "明天是这个。\n——我会等着你的。",
      "source_fingerprint": "d711b9ee7d3d53b83bcd4df4638b6fe5b3bac7441724926f188b557df19c7b88",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "15"
      ]
    },
    {
      "uid": "zhcn:1f5f42f7251270be7bebb744",
      "kind": "character_system_text",
      "source_text": "啊——不好意思。\n我不小心被地上的花吸引了…\n——我们开始吧。",
      "source_fingerprint": "3fbd575be2ab2538df090a35c3dbe660d8613946eb6a7dbe2e69b8a04a59545e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20000"
      ]
    },
    {
      "uid": "zhcn:e9f78b471f036d8aa46083cc",
      "kind": "character_system_text",
      "source_text": "！不，只是稍微——\n有些晃了一下而已。\n请不用在意…！",
      "source_fingerprint": "b39bbd1c9180b9998a0db8ad47ce8c124f8f5658536cfe3c6eb017c1d212ebb4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20001"
      ]
    },
    {
      "uid": "zhcn:a6f40ce345e951a816a649d4",
      "kind": "character_system_text",
      "source_text": "今天，我试着做了杏目同学\n亲授的热身。也许是因为这个，\n身体暖洋洋的——效果立竿见影呢。",
      "source_fingerprint": "f19049287e8c54f0cfa97bfb3fe733fe8b1f262e9906c4ed55fbd6cb0c88351e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20002"
      ]
    },
    {
      "uid": "zhcn:2548a04dd6abcbc879a7b907",
      "kind": "character_system_text",
      "source_text": "我培育的花朵们——\n今天早上漂亮地开花了。\n我也不能输给它们呢。",
      "source_fingerprint": "61a4bd0ce4f467d80ab0defdc113c734ebdddb72389fef70a8678d3e31bdd447",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20003"
      ]
    },
    {
      "uid": "zhcn:34f4604d31515f58fe48caf9",
      "kind": "character_system_text",
      "source_text": "呵呵——整个训练场\n都充满了活力呢。我也必须\n像大家一样努力才行。",
      "source_fingerprint": "c78210a5adf478fa1ffaee246ae21b4c5376f14b05415cdf3acec31388902a37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20004"
      ]
    },
    {
      "uid": "zhcn:6fef8e8080db03894b0cfe90",
      "kind": "character_system_text",
      "source_text": "无论多远，我都能继续前进。\n直到愿望开花——那一刻为止。",
      "source_fingerprint": "03c47dfd135bf671e622904f99ad8efa0c1906f5480296ff6f91a7eeccb112bc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20005"
      ]
    },
    {
      "uid": "zhcn:6541f73b061c8e794417b13e",
      "kind": "character_system_text",
      "source_text": "运动和休息都要保持平衡——\n我想稳扎稳打地增强实力。",
      "source_fingerprint": "747587890e6629c080f223f35a31742aace745fa7a42dfad1bcde539f550353b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20006"
      ]
    },
    {
      "uid": "zhcn:0cd3fd6167425e64ee83a067",
      "kind": "character_system_text",
      "source_text": "和创世驹同学一起热身也好、\n并跑也好，都很合拍——呵呵，\n也许我们彼此波长很合。",
      "source_fingerprint": "05e441ee02e9339300dc4147f5be05450ab7eecaf14537993a7c605a011b0238",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20007"
      ]
    },
    {
      "uid": "zhcn:9cbf5eabb56238e35ae73d63",
      "kind": "character_system_text",
      "source_text": "连薰衣草的香气也不起作用。\n——呼，必须想想办法才行…。",
      "source_fingerprint": "57de4322b28b60134b89a5dac36aea3f769edda3164cd4f9a973cdf68ac6c5f2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20008"
      ]
    },
    {
      "uid": "zhcn:274b98866780812be7f1fe25",
      "kind": "character_system_text",
      "source_text": "抱歉——\n总觉得思绪有些散乱。\n连花束也做不好——",
      "source_fingerprint": "e0e8e566906daf1b6765090b81fd0a6de25fda69652031ace8d5fa556205e59b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20009"
      ]
    },
    {
      "uid": "zhcn:7fdc3627d9f45c84d49d8fc3",
      "kind": "character_system_text",
      "source_text": "明明想献给训练员的。\n可我这样，是不是——不行呢。",
      "source_fingerprint": "0cd6e7e188cde2e2da482706ac6c5b84385f23cf3b3bc68bcf973036626b49de",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20010"
      ]
    },
    {
      "uid": "zhcn:b4eddbbd78ab0fc829d1f911",
      "kind": "character_system_text",
      "source_text": "要散开了——\n明明必须整理好的。",
      "source_fingerprint": "af6cb9dd3fe75ff44ad3b83e8aa94b3cc9359dec6acfb68b6ff1dc444ced9e8f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20011"
      ]
    },
    {
      "uid": "zhcn:96f7b4ef9eae5c7923993dfe",
      "kind": "character_system_text",
      "source_text": "负荷过重的话——会产生反作用。\n为了防止负面的调和——\n现在还是停下来吧。",
      "source_fingerprint": "6496cbbbcd9ae8084ccc720a3fc1573f11cc88c6ffa8cce7cb42f3228d623f7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20021"
      ]
    },
    {
      "uid": "zhcn:387109accca1dc671d0cde7d",
      "kind": "character_system_text",
      "source_text": "——要不要先谈一谈？\n连续出赛，对现在的我们来说，\n究竟是不是最好的道路——拜托了。",
      "source_fingerprint": "5680ba02cdfe47bbdb3ed3f4969d9755af8c8875bd17acbf48e91e15a3c9c28e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20022"
      ]
    },
    {
      "uid": "zhcn:8970ce4a77457f8c4f5b89cf",
      "kind": "character_system_text",
      "source_text": "我会比任何人都快——束起喝彩，\n将它送到你身边。\n这是——约定。",
      "source_fingerprint": "1dc58c42b4482a46b34efc827144bf1b2b6952198cf28b481d351d58bd4644d7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4818cfadb96eb329172cd086",
      "kind": "character_system_text",
      "source_text": "充满荣光的黄金花束——\n如果是现在的我——一定\n能够献上。我是这样觉得的。",
      "source_fingerprint": "dceca8dc5362515b7b72a46f1e708b4c65f92b5853dde0c383c797ef7ceadfdb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20024"
      ]
    },
    {
      "uid": "zhcn:d002c9d788298c595ba5732a",
      "kind": "character_system_text",
      "source_text": "今天诞生的欢呼之花——\n正是你的献身结出的证明。\n请尽情——收下吧。",
      "source_fingerprint": "85d97ed8297a43df514285998e05ab4e7d4d3946edde2507ce209b61911d2877",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20025"
      ]
    },
    {
      "uid": "zhcn:4e31ee1dbda1d8e92410cff1",
      "kind": "character_system_text",
      "source_text": "愿大家都能感受到——\n你能力的出色。\n我一定会留下好成绩的。",
      "source_fingerprint": "0cc335538b54e44ec8dfe571f87360e23869e049cd7ec7dc0842fe3d6a0978f8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20026"
      ]
    },
    {
      "uid": "zhcn:7fc36818b4005c86e5f8eb0b",
      "kind": "character_system_text",
      "source_text": "状态——已经仔细\n调整好了。气势很好。\n接下来——只要拿出结果。",
      "source_fingerprint": "779fc21bd7b3c3707e6ea8c0a7c57849f71bdcf6286ba6866b53f246e9f34c05",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20027"
      ]
    },
    {
      "uid": "zhcn:b3bd1a79bd6dbf7f2875dbea",
      "kind": "character_system_text",
      "source_text": "关键时刻果然还是——母亲亲授的\n卡苏埃拉最合适。身体会调整好，\n心情也会——振作起来。",
      "source_fingerprint": "f7078aaa62f547cb91798a007fef2971271c895d93041115e7a4bfda57f8cd57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20028"
      ]
    },
    {
      "uid": "zhcn:ffc5111674d18600e2286014",
      "kind": "character_system_text",
      "source_text": "身体状况和平时一样——\n已经调整好了。\n应该能发挥至今积累的成果。",
      "source_fingerprint": "7645b545ed0822efc98803b6fa056e4378beee9982a7341d9abd608679e3362a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20029"
      ]
    },
    {
      "uid": "zhcn:4627e946a8944d9b199cbbe0",
      "kind": "character_system_text",
      "source_text": "为了能放松下来——我带来了香囊。\n训练员如果愿意的话——\n要不要也来一个？",
      "source_fingerprint": "1ab97fa8d526e158c60be6151767cc221d9ab20125a791a271d1254a37277a37",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20030"
      ]
    },
    {
      "uid": "zhcn:b9232b33904122de635c3b88",
      "kind": "character_system_text",
      "source_text": "仔细观察整体——\n把局势调整成我能获胜的走向。\n我会冷静地——跑完这场。",
      "source_fingerprint": "1f496fe0d2a09354ff036978210847b62dd330ddfda974fc02f1c88e68f613c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20031"
      ]
    },
    {
      "uid": "zhcn:5a288a0829a3bca7ef7f3679",
      "kind": "character_system_text",
      "source_text": "大家——都好好地\n完成了调整呢…。\n即便如此，我也必须获胜——",
      "source_fingerprint": "e41db35753a3a2a634df360e316b2b56ee4b7a196ea6c4fe537f6b7acf9331cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20032"
      ]
    },
    {
      "uid": "zhcn:874de4ec6de216e875464d90",
      "kind": "character_system_text",
      "source_text": "虽然很难说是万全——\n但能做的，我都做了。\n我一定会为你——献上花束。",
      "source_fingerprint": "43906ab0d408e6878ba561a077175315fbc615b50425887848e9547e880a8788",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20033"
      ]
    },
    {
      "uid": "zhcn:3a5378a5ace8780101442084",
      "kind": "character_system_text",
      "source_text": "即使还算不上盛放的大花——\n我也会把胜利献给你。\n这一点——绝不会动摇。",
      "source_fingerprint": "27d744fbc1e1314f5ac119dd99f2575b6ed0965efa393895053f9f0cb0e465d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20034"
      ]
    },
    {
      "uid": "zhcn:8ae34f9f7f55f547169a6c6b",
      "kind": "character_system_text",
      "source_text": "——必须获胜。\n不管状态多么不好，\n我都要献上——花束…！",
      "source_fingerprint": "89ed2a68384a6aff2217b97f9b187ba7c68b4e4291698cb60dc1221d1a105f10",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20035"
      ]
    },
    {
      "uid": "zhcn:c2fd99775273eeb42bc168be",
      "kind": "character_system_text",
      "source_text": "内心的紊乱会产生负面的调和，\n进而导致更严重的不调——正因为艰难，\n才必须保持冷静…对吧。",
      "source_fingerprint": "52d962150afee0b15f9c5d15ed1ae3600c70439cc7e6b2b697ffa7b236c5cf7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20036"
      ]
    },
    {
      "uid": "zhcn:309c931b3143e262a8c792c6",
      "kind": "character_system_text",
      "source_text": "基于目前状态不佳这一状况——\n把场面调整好。\n我会想办法做到的。",
      "source_fingerprint": "aec0ba0884a1bbb0502defabb492c645898040db3899ec8cb723a2788f6ea22f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20037"
      ]
    },
    {
      "uid": "zhcn:81bbcb5d971eb4d2263fd093",
      "kind": "character_system_text",
      "source_text": "我上了。",
      "source_fingerprint": "980a7ec4edfa6d1adf15641f4347f9c2840126ff143da4b3a0db3ad63034d737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20038"
      ]
    },
    {
      "uid": "zhcn:15f1e2bd5688d8bee1172c80",
      "kind": "character_system_text",
      "source_text": "那么——",
      "source_fingerprint": "a97c33b8d7b2ae4f4d1a39dacbe3891ec15f5b33d67eb9f50db9244995595c70",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20039"
      ]
    },
    {
      "uid": "zhcn:0aa487fd9d8644d2bdb10ac8",
      "kind": "character_system_text",
      "source_text": "哈…！",
      "source_fingerprint": "9c384ed029ba21fa52578ef43233d7b6ac2311a4e1bc74f067c9186b53db98c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20040"
      ]
    },
    {
      "uid": "zhcn:60ea1acd4ef0a177764bbbd7",
      "kind": "character_system_text",
      "source_text": "原来如此——",
      "source_fingerprint": "8dcd4d784649f6ce82867f6104f1430297789f0e50bbcaf26c4ad47cddb66ecb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20041"
      ]
    },
    {
      "uid": "zhcn:743efa7bc3958e5c3e941a86",
      "kind": "character_system_text",
      "source_text": "唔…。",
      "source_fingerprint": "9852121b46bc3ea60cc2bf9ba1e1633b23e248d37c2f7aeca6a1854e4d6ab164",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20042"
      ]
    },
    {
      "uid": "zhcn:629c9c001387cd001987adb2",
      "kind": "character_system_text",
      "source_text": "哎呀…？",
      "source_fingerprint": "55d62764ccc18450bc29a87356c49484cd31be597f6410d65689ef109e2fc74d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20043"
      ]
    },
    {
      "uid": "zhcn:becb3421406f421a3ee9f172",
      "kind": "character_system_text",
      "source_text": "一同——",
      "source_fingerprint": "59d54526dd9684b5f00ddf6d7bbbff9960ca483ae87e163e936efd14283d7645",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20046"
      ]
    },
    {
      "uid": "zhcn:cf98619cf56a0ea28060f6da",
      "kind": "character_system_text",
      "source_text": "海风——",
      "source_fingerprint": "2966b2741eeafce232d14488e1a8fb662cf77ae0c4adde027166a1fd1580767e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20047"
      ]
    },
    {
      "uid": "zhcn:8d20c751479730796b3f5b1c",
      "kind": "character_system_text",
      "source_text": "能与你这样温柔的人一同前行——我很幸福。",
      "source_fingerprint": "8b4ed81ef4f7430efbc6520513f183cdef2369c35b003c4e3c39e05edf90546b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20049"
      ]
    },
    {
      "uid": "zhcn:fb7864d376e77241c5df8cd3",
      "kind": "character_system_text",
      "source_text": "承蒙你——关照了。",
      "source_fingerprint": "96304bec971780ad39b0b9373d87341bd2f575f8bfb629409002e256c99b92ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20050"
      ]
    },
    {
      "uid": "zhcn:7875faca933adcd106b34fea",
      "kind": "character_system_text",
      "source_text": "我会竭尽全力，以此策励——！",
      "source_fingerprint": "678efcf9e9e7c06371f3b807861f82b7b5143a241397709db8cd62381e170124",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "20051"
      ]
    },
    {
      "uid": "zhcn:5c3c95bb8979e9889682316c",
      "kind": "character_system_text",
      "source_text": "与大家一同——",
      "source_fingerprint": "c1ef149c3a519c99453ca882f231990b92d01de81aa685c1aeebb81063c70111",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "2030"
      ]
    },
    {
      "uid": "zhcn:c5e7fc6a87a84a0784095b8f",
      "kind": "character_system_text",
      "source_text": "让波长合在一起——",
      "source_fingerprint": "cffaa31481a7ddc53ad6fcffac44000aaa75c260a674d41946c23cde6739d36f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "2031"
      ]
    },
    {
      "uid": "zhcn:61d2e85a256a7f2c331e67ec",
      "kind": "character_system_text",
      "source_text": "承蒙你——关照了。",
      "source_fingerprint": "96304bec971780ad39b0b9373d87341bd2f575f8bfb629409002e256c99b92ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "2032"
      ]
    },
    {
      "uid": "zhcn:f3cd9a603aa16e597dec5e54",
      "kind": "character_system_text",
      "source_text": "关键时刻果然还是——母亲亲授的\n卡苏埃拉最合适。身体能调整好，\n心情也会——振作起来。",
      "source_fingerprint": "704c76e26569da6f25347610d76833239e28afaf43f8638d79abd7408b1fcead",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "2033"
      ]
    },
    {
      "uid": "zhcn:fa88a71212e2db9058583d31",
      "kind": "character_system_text",
      "source_text": "今天诞生的欢呼之花——\n正是你的献身结出的证明。\n请尽情——收下吧。",
      "source_fingerprint": "85d97ed8297a43df514285998e05ab4e7d4d3946edde2507ce209b61911d2877",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "2034"
      ]
    },
    {
      "uid": "zhcn:6a2a3f2e6c336a0806049286",
      "kind": "character_system_text",
      "source_text": "承蒙你——关照了。",
      "source_fingerprint": "96304bec971780ad39b0b9373d87341bd2f575f8bfb629409002e256c99b92ef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "2035"
      ]
    },
    {
      "uid": "zhcn:e6e638ff8c2eae11fff4102f",
      "kind": "character_system_text",
      "source_text": "我上了。",
      "source_fingerprint": "980a7ec4edfa6d1adf15641f4347f9c2840126ff143da4b3a0db3ad63034d737",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "23015"
      ]
    },
    {
      "uid": "zhcn:ca43d5100114ad0b7c1c52aa",
      "kind": "character_system_text",
      "source_text": "明明离花束——只差一步了…。",
      "source_fingerprint": "8381afd2625a45ca40d865128391cdbfdf0fc827a7db33dcefe6d0781cceaf31",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30000"
      ]
    },
    {
      "uid": "zhcn:b19bcfbf099f878c4be8dbbf",
      "kind": "character_system_text",
      "source_text": "下次我一定——会完成给你看。",
      "source_fingerprint": "66913ee670190d2e1639f01021cec7fd92efba49a05f6c1f9dd23ecafad8dc96",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30001"
      ]
    },
    {
      "uid": "zhcn:6b438838fbc2497ed6e6bd76",
      "kind": "character_system_text",
      "source_text": "没有时间——沮丧了。",
      "source_fingerprint": "a81c1659fa60685fdbc1e57c680c8487117c3a317deb5db6e05eb7e7b1493aa7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30002"
      ]
    },
    {
      "uid": "zhcn:422d5e0723811afb15fecb31",
      "kind": "character_system_text",
      "source_text": "必须更加——努力才行。",
      "source_fingerprint": "ee7c398c65792af6ff982c834ac3ffd79aa3a21069d98a10b05215e4662bf829",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30003"
      ]
    },
    {
      "uid": "zhcn:1a600018923d32435791be54",
      "kind": "character_system_text",
      "source_text": "这束喝彩的花束——献给你。",
      "source_fingerprint": "7341c0cb08ba22a8e60ce3ec415e4e135b5f4ae1e60008e34794599e7e83af9e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30004"
      ]
    },
    {
      "uid": "zhcn:69933a180b3bc7ef266e02c5",
      "kind": "character_system_text",
      "source_text": "请看着我们束起的光辉。",
      "source_fingerprint": "03d88d07915bdd00afed2061ba1c3aca22a1dfc7fcc63d7026fc82da7fb5c47f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "30005"
      ]
    },
    {
      "uid": "zhcn:2660296c6f2d8c92174f7a3a",
      "kind": "character_system_text",
      "source_text": "我去了。",
      "source_fingerprint": "ebb3b5747aac5d1f6d21b9c56938d0539c4409611d4bf07658d1e6e8f33c407a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "31000"
      ]
    },
    {
      "uid": "zhcn:23fe4b50099a6ef436b3e671",
      "kind": "character_system_text",
      "source_text": "献上胜利的——花束！",
      "source_fingerprint": "94f9a742de69a00273de18e5d3a5c7306e9f343c13b8c0366411f0323b28deef",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "40000"
      ]
    },
    {
      "uid": "zhcn:dc2d89ed7bf6ca9605f637e8",
      "kind": "character_system_text",
      "source_text": "『万能帮忙券\n～为您收集灯笼裤的资料与视频～』？\n哎呀…欢呼你们真是的――呵呵♪",
      "source_fingerprint": "0c713a44d41a766fe5abbae8eaaa96da015c9f42bd37b2bbccbe21b4b0a04040",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1134",
        "400000"
      ]
    }
  ]
}
