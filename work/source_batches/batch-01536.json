      ]
    },
    {
      "uid": "zhcn:a263fdd47216ad6b3c3b9d4f",
      "kind": "character_system_text",
      "source_text": "这里，也记录着历代\r\n“女王”的成绩呢…。",
      "source_fingerprint": "fd6ea00a61c492b1b1249f10e02822f41736b81a40d0a1392118758df9dfa9ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "110001"
      ]
    },
    {
      "uid": "zhcn:549a2edfb889d9bed9bf1d63",
      "kind": "character_system_text",
      "source_text": "Let's do this!\r\n我会让这成为最棒的赛事的！",
      "source_fingerprint": "6c7dc31bbe74cb4f4a4acd28329482b4d337c59cf81b61b8d6ba0904c3c3de1f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
