      ]
    },
    {
      "uid": "zhcn:f64be85e22898e85189f80c0",
      "kind": "character_system_text",
      "source_text": "是训练呢。\r\n来吧，无比能干的你。\r\n能给我最棒的训练菜单吗？",
      "source_fingerprint": "a88555a158b737a518666a89652272a16e10ab505aae768893c4d7467fcc803d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
