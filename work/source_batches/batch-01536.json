      ]
    },
    {
      "uid": "zhcn:cee22dbf8d199f9bc9c544e5",
      "kind": "character_system_text",
      "source_text": "下次一定要…！",
      "source_fingerprint": "7fbb15d7bd3f4aba7056d31637d455e44ed01f889c91d237437928ab668993d2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1112",
        "1005"
      ]
    },
