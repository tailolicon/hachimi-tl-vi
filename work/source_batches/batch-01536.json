      "uid": "zhcn:9eb0d0563627441015ad92b8",
      "kind": "character_system_text",
      "source_text": "一场精彩的比赛。",
      "source_fingerprint": "d9da25e28448e65f3a40020be302737ef36f335ad9cdaa978b1e7fdf4725a2b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
