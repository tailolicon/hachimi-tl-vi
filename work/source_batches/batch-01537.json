      ]
    },
    {
      "uid": "zhcn:2656a60ba0f26d32ee89212a",
      "kind": "character_system_text",
      "source_text": "好厉害…！",
      "source_fingerprint": "a4171fea5297955ee74bf063ebbf4e44837a2de20e3c743747e9fd71a53675a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
