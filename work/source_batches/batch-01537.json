      ]
    },
    {
      "uid": "zhcn:57d0c4a8d7dc57ac9888bf04",
      "kind": "character_system_text",
      "source_text": "那个…。",
      "source_fingerprint": "0603aba7cd982f0a048556bf5116f81c31c728e73de79f2e59e378bc38a68fe9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
