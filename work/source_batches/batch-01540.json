      "json_path": [
        "2001"
      ]
    },
    {
      "uid": "zhcn:743f3e8d211da3bfd8e71f36",
      "kind": "race_jikkyo_comment",
      "source_text": "春季短跑王的候选之首就是这位赛马娘了呢",
