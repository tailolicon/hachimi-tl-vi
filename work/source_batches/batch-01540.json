      ]
    },
    {
      "uid": "zhcn:f507a4d2e2a96843059e6efc",
      "kind": "character_system_text",
      "source_text": "活动举办中。\r\n战斗终于进入了高潮！\r\n这一月号也不要错过哦——！！",
      "source_fingerprint": "77546c0c02e01ff135d8400d801766f62425fdfa068e616defe71bd967ed21e7",
      "source_path": "character_system_text_dict.json",
