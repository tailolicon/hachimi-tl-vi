      ]
    },
    {
      "uid": "zhcn:2f63afa65b56e955d18e46a8",
      "kind": "character_system_text",
      "source_text": "活动快要开始了。\n神业不为人知的秘密终于要\n揭晓了——！？敬请期待下一号！",
      "source_fingerprint": "7ff08742d7479330f3d54ada670cf2aea9e9133de96d2cc66773655cd44ab2ab",
