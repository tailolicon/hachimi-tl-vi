      "json_path": [
        "2002"
      ]
    },
    {
      "uid": "zhcn:cf504d360ccb081cf93bf00f",
      "kind": "race_jikkyo_comment",
      "source_text": "希望她能拿下春古马三冠的第一冠\n来证明自己的实力",
