    {
      "uid": "zhcn:c1adfa38e4a1f0da04d056ed",
      "kind": "character_system_text",
      "source_text": "任务达成！要不要以此为奖励，\r\n进入漫画时间？",
      "source_fingerprint": "dc383a008ad01e23732858c7071dc0c7e76b834427673f3e48acb18508beb506",
