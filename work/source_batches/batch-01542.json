  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:efd2e6b38c6ac05378be48a5",
      "kind": "character_system_text",
      "source_text": "还算可以……吧？",
      "source_fingerprint": "c0f07b1bea567ae1ce6bac58601807acebf20bc1858f1e4f416e6fd96a63467e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "30001"
      ]
    },
    {
      "uid": "zhcn:842b141805edc99eaf35e5e5",
      "kind": "character_system_text",
      "source_text": "重新开始吧。",
      "source_fingerprint": "955d8a9402557e34a433bdd8bd8dbf321591f96070bc0966ad0306688715119e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "30002"
      ]
    },
    {
      "uid": "zhcn:c7e8f02c2c3c719984360215",
      "kind": "character_system_text",
      "source_text": "……真无趣。",
      "source_fingerprint": "2bc1d531b4d4ed725bae7bbe79e5ec940eaaeb0f85d4003411aed4763fcca1df",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "30003"
      ]
    },
    {
      "uid": "zhcn:7a1cf67cb757ee01933af9ce",
      "kind": "character_system_text",
      "source_text": "真是一场不错的旅行……那么，接下来该前往何方？",
      "source_fingerprint": "d45be84f3bca4a4bf55716d27af91fbb155a96efffd42de85510ae5a0ce5a922",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "30004"
      ]
    },
    {
      "uid": "zhcn:66dc6cc2f84b10e98d8e7f3f",
      "kind": "character_system_text",
      "source_text": "让我乐在其中了哦。",
      "source_fingerprint": "33df01a2e167469c313072ee14a4eec177abf214cad94e86afd86f4c103511a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "30005"
      ]
    },
    {
      "uid": "zhcn:59a4bf8e953a926599c11c29",
      "kind": "character_system_text",
      "source_text": "准备好了呢。走吧。",
      "source_fingerprint": "bd52a8bf7905e4e17bb63cdaac7025a3feee617af4626a2f8a41a7a7ee2c827e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "31000"
      ]
    },
    {
      "uid": "zhcn:c024fd2f064d532a3682cee4",
      "kind": "character_system_text",
      "source_text": "那么——继续我们的旅行吧。",
      "source_fingerprint": "f98e800b0a3f021ce069181d386399d73703f465ff1955d040e8d99b1535c19a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "40000"
      ]
    },
    {
      "uid": "zhcn:8affbc454d4458496dcdce35",
      "kind": "character_system_text",
      "source_text": "走下去，走下去，只向着前方。\n通往黄金的旅程——直到那尽头。",
      "source_fingerprint": "9024065394114f3ecae7d6fae2c545b7954ec28a24bbbeace8d49ba797bd4423",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "40001"
      ]
    },
    {
      "uid": "zhcn:ee828e980c3c3e78e56a5879",
      "kind": "character_system_text",
      "source_text": "哎呀，真是一场不错的聚会呢。\n哈哈，一个个都净爱胡来……\n你们啊，还真是“一点没变”呢。",
      "source_fingerprint": "2c05dc17814086bab6bd85bddbfc5559cb6fe75ab0d080a010c89e339c7d5b2c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "400014"
      ]
    },
    {
      "uid": "zhcn:52fcb01388854d416135fc34",
      "kind": "character_system_text",
      "source_text": "保持自然，享受其中就好。",
      "source_fingerprint": "86ff47737f3e1b7b193e50950f5f5b2bb58883fc70af422583b1bf79df00b8c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "60000"
      ]
    },
    {
      "uid": "zhcn:b4115ed9e993526e18a1930e",
      "kind": "character_system_text",
      "source_text": "歌唱吧，起舞吧……随心所欲。",
      "source_fingerprint": "429adae03453ed7f4aedba5d10441b9c323dca31e1f106fd8a896a1c320e77ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "60001"
      ]
    },
    {
      "uid": "zhcn:5ed0e3cf705a587423a28ba9",
      "kind": "character_system_text",
      "source_text": "真期待啊，下一次旅行。",
      "source_fingerprint": "a82e2a6a36d63cc0876cbc6ed1316e212adad65854254ac5a36ef57674df689a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70000"
      ]
    },
    {
      "uid": "zhcn:774577f3c7f5c5b8bacf050d",
      "kind": "character_system_text",
      "source_text": "与你的相遇……是必然，\n是命运的纠缠……还是灵魂的呼唤。\n……此刻就在这里。唯有这才是答案。",
      "source_fingerprint": "d0283e4f19ef81dd9f8fdbdf8abc94659719fd8b8f89623e06d4495f090760b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70001"
      ]
    },
    {
      "uid": "zhcn:128a25fb15ed33cc062f5607",
      "kind": "character_system_text",
      "source_text": "我当然会穿哦。……毕竟，我是“赛马娘”嘛。",
      "source_fingerprint": "11cf7b907b9203fdfedf76da68654987e46c9e4aaea8b8a19c7987c5848622d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70004"
      ]
    },
    {
      "uid": "zhcn:7ee5da6e365baeebc8526592",
      "kind": "character_system_text",
      "source_text": "穿着整齐的衣装跳舞，还挺壮观的呢。",
      "source_fingerprint": "c26df972b9ca9d2f685f323e2eacf0ad27a1f85d1b803c49bb0b8dc3e4777e2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70008"
      ]
    },
    {
      "uid": "zhcn:aec7f517574eb1ae5a7da06c",
      "kind": "character_system_text",
      "source_text": "决胜服是旅行的搭档……我也是很爱惜它的。",
      "source_fingerprint": "dbf53882c1bd974addcc45c60679c7e96a4f244e4a08f33ac69dd17ef294f481",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70009"
      ]
    },
    {
      "uid": "zhcn:ae4688894aae32af04717be5",
      "kind": "character_system_text",
      "source_text": "被误认成跳级生了呢。我顺势点头承认了。",
      "source_fingerprint": "a8130bd30e96de81e312a2817e3e196a9467fbce22561fa90ac4ef80ac29f56f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70010"
      ]
    },
    {
      "uid": "zhcn:e719cf3e946dac815a8b1892",
      "kind": "character_system_text",
      "source_text": "喔——明明是夹克却很柔软……。",
      "source_fingerprint": "db687c1f02db44ae25a48a34cb7f9a6b8ff1b6a47725f993cf28a773056cdb76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70014"
      ]
    },
    {
      "uid": "zhcn:545a81b2882b08d148880bda",
      "kind": "character_system_text",
      "source_text": "在环境恶劣的地方奔跑时，护目镜是必需品。",
      "source_fingerprint": "657d1e3c21017a4c75e58ef63ef5ff2d13dfe8adf3bddbcbc2435fc07e85517b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70015"
      ]
    },
    {
      "uid": "zhcn:813c2d7b8097dacbee9f3e1f",
      "kind": "character_system_text",
      "source_text": "你还真是个怪人啊。",
      "source_fingerprint": "220bcff1c1d490706dd1bfaa066ebb4be86be383ab92214f946cd6fb4a8c5b08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70018"
      ]
    },
    {
      "uid": "zhcn:b72b6b332ffe74ce9335285d",
      "kind": "character_system_text",
      "source_text": "……还要继续吗？",
      "source_fingerprint": "e6e408edf9156548ae948f625ac0cc433732c40b3692a25e9b51a4fde8fd12a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70019"
      ]
    },
    {
      "uid": "zhcn:6a5dba161406e9adac001801",
      "kind": "character_system_text",
      "source_text": "嗯，果然很通风。",
      "source_fingerprint": "52d1d4cd4d7bb9d58eedbfc085a37d043504f49209889a1f120b53b9e1001bf9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70020"
      ]
    },
    {
      "uid": "zhcn:412b934f9aac3474e0b55588",
      "kind": "character_system_text",
      "source_text": "有想去的地方吗？",
      "source_fingerprint": "1d261d8556cd08319e825d782cbb43bceb583f77ee82b1c0184b9965afdeadc8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "70021"
      ]
    },
    {
      "uid": "zhcn:5a3a5aade98c3bd8ac031dd3",
      "kind": "character_system_text",
      "source_text": "我当然会穿哦。……毕竟，我是“赛马娘”嘛。",
      "source_fingerprint": "11cf7b907b9203fdfedf76da68654987e46c9e4aaea8b8a19c7987c5848622d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71004"
      ]
    },
    {
      "uid": "zhcn:46c8178b8723216974a34307",
      "kind": "character_system_text",
      "source_text": "穿着整齐的衣装跳舞，还挺壮观的呢。",
      "source_fingerprint": "c26df972b9ca9d2f685f323e2eacf0ad27a1f85d1b803c49bb0b8dc3e4777e2e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71008"
      ]
    },
    {
      "uid": "zhcn:0894e1f6adb9eee5cf9d0c11",
      "kind": "character_system_text",
      "source_text": "决胜服是旅行的搭档……我也是很爱惜它的。",
      "source_fingerprint": "dbf53882c1bd974addcc45c60679c7e96a4f244e4a08f33ac69dd17ef294f481",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71009"
      ]
    },
    {
      "uid": "zhcn:18d7b0205c401327cef638fa",
      "kind": "character_system_text",
      "source_text": "被误认成跳级生了呢。我顺势点头承认了。",
      "source_fingerprint": "a8130bd30e96de81e312a2817e3e196a9467fbce22561fa90ac4ef80ac29f56f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71010"
      ]
    },
    {
      "uid": "zhcn:a76a82cb4950044dbae887fe",
      "kind": "character_system_text",
      "source_text": "喔——明明是夹克却很柔软……。",
      "source_fingerprint": "db687c1f02db44ae25a48a34cb7f9a6b8ff1b6a47725f993cf28a773056cdb76",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71014"
      ]
    },
    {
      "uid": "zhcn:cc333e0ffb70ec55a3bcd7c7",
      "kind": "character_system_text",
      "source_text": "在环境恶劣的地方奔跑时，护目镜是必需品。",
      "source_fingerprint": "657d1e3c21017a4c75e58ef63ef5ff2d13dfe8adf3bddbcbc2435fc07e85517b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71015"
      ]
    },
    {
      "uid": "zhcn:7efefc214ca3fac94f4c4f3a",
      "kind": "character_system_text",
      "source_text": "你还真是个怪人啊。",
      "source_fingerprint": "220bcff1c1d490706dd1bfaa066ebb4be86be383ab92214f946cd6fb4a8c5b08",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71018"
      ]
    },
    {
      "uid": "zhcn:2036c5aa6f88dc0fe3d638fb",
      "kind": "character_system_text",
      "source_text": "……还要继续吗？",
      "source_fingerprint": "e6e408edf9156548ae948f625ac0cc433732c40b3692a25e9b51a4fde8fd12a3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "71019"
      ]
    },
    {
      "uid": "zhcn:2a0a4da894742ed2a4c51485",
      "kind": "character_system_text",
      "source_text": "辛苦了",
      "source_fingerprint": "bd96bf364b8b21a3bb94efcf4ef82feb1bc34cf02203524e7949dbd19151dd13",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "80000"
      ]
    },
    {
      "uid": "zhcn:64977cb59fd91d3a9cd89c59",
      "kind": "character_system_text",
      "source_text": "清晨出发去旅行也挺不错的。\n能尽情享受尚未苏醒的街道中，\n那份慵懒的空气。",
      "source_fingerprint": "82ce04536eac50aa3ba2f9f2dd276e0c524f25b40fcfa389d39e3dbf6ecfdbd1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90000"
      ]
    },
    {
      "uid": "zhcn:e207d6814166d512f1868c4c",
      "kind": "character_system_text",
      "source_text": "睡个懒觉也不赖。毕竟梦里的旅行\n也很有趣。要是旅途太长而\n被劈头盖脸训一顿，嘛，也算一桩趣事！",
      "source_fingerprint": "dd6f095e6dd099180c728e74adb2c36a89a345dc6a30b438d6b1dbae422c998d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90001"
      ]
    },
    {
      "uid": "zhcn:4398943e940528515b6e819d",
      "kind": "character_system_text",
      "source_text": "中午了啊……真想偷偷溜出去，\n找一家隐秘的名店啊。\n下午的计划——没办法。嗯。",
      "source_fingerprint": "98b533d841f335534944c1f8ea69dd138954f340654c902850d62dc314c4a476",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90002"
      ]
    },
    {
      "uid": "zhcn:71e1472f3f0c7048e907049a",
      "kind": "character_system_text",
      "source_text": "其实，我藏了一个午睡用的吊床。\n你要用吗？\n……啊，不过那是我的尺寸哦。",
      "source_fingerprint": "080796a620fd5f2b8c8cd778ad753bcb68c161a6445e96f0053260c63d911143",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90003"
      ]
    },
    {
      "uid": "zhcn:e25178acd2d982f747f35b07",
      "kind": "character_system_text",
      "source_text": "篝火真的很不错。寂静的夜晚，每当\n薪柴爆裂的声音响起，沉睡在心底的\n记忆就会接连苏醒过来。",
      "source_fingerprint": "17d2620e868d44209e1f71fa0b10e3b27aa45fc1f908f46dbbcde9798b927f16",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90004"
      ]
    },
    {
      "uid": "zhcn:d28931d2a625bf5f42fcabd4",
      "kind": "character_system_text",
      "source_text": "你意外地是个熬夜派？挺好。\n那……我们稍微溜出学园，\n去寻找一下从未见过的天空吧。",
      "source_fingerprint": "e99d904f7e4f3bba956e2b8a6743bbd83913815855f1954be38622e75526bffe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90005"
      ]
    },
    {
      "uid": "zhcn:910444ebb45167b63d5daa1f",
      "kind": "character_system_text",
      "source_text": "梦旅帮我占好了赏花的位置……\n也有你的座位。你会给她个面子，\n过去坐坐吧？",
      "source_fingerprint": "de2e97cbd6c13d631f3b55c791dfd2ff3fd7cfbb61e9fa337d0b7034bd8f1b40",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90006"
      ]
    },
    {
      "uid": "zhcn:69df49389bce3f513830b2ed",
      "kind": "character_system_text",
      "source_text": "想再去乘凉呢……去那个湖边。\n从第一次去的时候起，\n不知为何就觉得是个让人怀念的地方……。",
      "source_fingerprint": "b3ecb3c1e70abe9dfb150de663ae2a034bcfd2d9dc90dfa2421578a7b2bc1776",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90007"
      ]
    },
    {
      "uid": "zhcn:c965fbb156299a9656acf45f",
      "kind": "character_system_text",
      "source_text": "这个时节红叶应该很漂亮吧。\n下周一起……啊，现在出发也\n可以吧？……啊，我可是认真的哦？",
      "source_fingerprint": "4aa7ba2cd6c3cff845161e8e0866e935ac9cab07902220a6c31dda9d4bc8fbae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90008"
      ]
    },
    {
      "uid": "zhcn:d9c654e423093d71c6a64356",
      "kind": "character_system_text",
      "source_text": "看到外面那个巨大的黄金船雪雕了吗？\n建议往眼睛里的松果塞进灯泡的人，\n就是我。……呵呵呵。",
      "source_fingerprint": "2797c5789bea09f968098d487d8ddd5a48c5c2b7d66c6e1aaf30b664575171ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90009"
      ]
    },
    {
      "uid": "zhcn:c437b7be84cc99d657aa6b4e",
      "kind": "character_system_text",
      "source_text": "祝你情人节快乐，就这样吧",
      "source_fingerprint": "486f48a3fb0a34f1c0a014244fb161fec55e02bfecc012db24d854acf3db0322",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "90020"
      ]
    },
    {
      "uid": "zhcn:e01a6cc414f243bfb80a2008",
      "kind": "character_system_text",
      "source_text": "旅行之前，偶尔会和中山庆典打赌。\n赌我会不会忘记带伴手礼。\n……那家伙，其实很想要吧。",
      "source_fingerprint": "463edd73a6fa9c04885a91f11421ec96a444f33b04004d34abd4465be1c972c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91000"
      ]
    },
    {
      "uid": "zhcn:35dad4545d24150fed22bbb9",
      "kind": "character_system_text",
      "source_text": "梦旅是个好孩子。总是\n照顾着其他那些家伙……\n我是不是该再夸夸她呢。",
      "source_fingerprint": "4aa49e9e61b629ca402b3c31e2e4439de646a4929ed911519f9b72c8cf1d3493",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91001"
      ]
    },
    {
      "uid": "zhcn:0070f8d6dc73f4e6c6e17e70",
      "kind": "character_system_text",
      "source_text": "超常骏骥之前因为怀疑黄金船携带了\r\n芥末气球而追赶她……然而，\r\n原件其实正由我保管着呢。",
      "source_fingerprint": "18aaa19b5eacf22a92f3709247c356ebaa89cec9c06bbaec3f38a05dfed739ba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91002"
      ]
    },
    {
      "uid": "zhcn:ac5a843eb225378ecccd4118",
      "kind": "character_system_text",
      "source_text": "要讨黄金巨匠欢心的话……对了，只\n要帮她的尾巴梳毛她就会很高兴哦。…\n啊，不过她可不会随便让谁碰的。",
      "source_fingerprint": "69aec6069b81c92726c3e7d27d763dfd4d2a4a270bf22bb5d9db66b13f6df480",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91003"
      ]
    },
    {
      "uid": "zhcn:307eba6bc45875314d93a2f6",
      "kind": "character_system_text",
      "source_text": "别看我这样，以前可是个孩子王哦……\n不，现在在别人眼里其实也差不多？\n那……呵呵，倒也不坏。",
      "source_fingerprint": "e3c6309b902b54e561e571c94f3799544587cf66fd6b08229d816485428f5eda",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91004"
      ]
    },
    {
      "uid": "zhcn:857ded425c90deea252b448f",
      "kind": "character_system_text",
      "source_text": "既然要办演唱会，那么……\n我也想让大家看看，能永远\n留在记忆里的绝美风景啊。",
      "source_fingerprint": "7938ad64d1e3fd9543c2f61869249e3d5ffe16c6c831d642a640f22bc88e1faa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91005"
      ]
    },
    {
      "uid": "zhcn:d0a99aeb7cff0b68c60f74c0",
      "kind": "character_system_text",
      "source_text": "调动观众情绪这种事我可是很有\n信心的。毕竟，随性发挥可是我的\n拿手好戏……呵呵。",
      "source_fingerprint": "41be950db6a3063e2d1314981327c5f2396df54f0eaac334846ef620d757f914",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91006"
      ]
    },
    {
      "uid": "zhcn:2a0d08b14b34198ac7c0fc2c",
      "kind": "character_system_text",
      "source_text": "旅行的用具我已经全部备齐了。\n至于为什么……你不觉得这能让我，\n随心所欲地奔向任何地方吗？",
      "source_fingerprint": "75dcc84691e4b41c5c43a6b6875de53baa97f0f0ba19f554cb9ff3e8bc51788a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91007"
      ]
    },
    {
      "uid": "zhcn:92cc7bf0ac904926e7dc3e0d",
      "kind": "character_system_text",
      "source_text": "磨损也是经历过长途旅行的证明……\n所谓工具，就是这样\n才会逐渐散发出韵味的吧。",
      "source_fingerprint": "85246d62af554163bfebd7968c87ec66b395a5862dbf43cc4366960304f917cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91008"
      ]
    },
    {
      "uid": "zhcn:77a10cd803590b3f3ab490d6",
      "kind": "character_system_text",
      "source_text": "上学的时候打招呼说早安，经常会\n让人吓一跳呢。大概是觉得，“啊，\n原来今天她居然在啊”这种感觉吧。呵呵。",
      "source_fingerprint": "9456ec1dac5bd24738bf3bdef0e12a0a774c9b3e614cd4516fab93c7d21e8bbc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91009"
      ]
    },
    {
      "uid": "zhcn:e0078d5555aaeb2fbf759ce8",
      "kind": "character_system_text",
      "source_text": "……总觉得啊。大白天的像这样\n待在室内，总觉得\n有一种亏大了的感觉呢。",
      "source_fingerprint": "3b22bb83ba34dce07d830224e9005699caf9119b18848fe726de50dd959f9bd3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91010"
      ]
    },
    {
      "uid": "zhcn:d0bb23b1c0f57c20e2efdbd1",
      "kind": "character_system_text",
      "source_text": "……说起来还没吃晚饭呢。\n嘛，要是肚子里的家伙说想吃的话\n我就会吃的。嗯。",
      "source_fingerprint": "59f1ffa42bbc341eacb928062c6ac4464178a885a153ab80b6b8a530d7ea9129",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91011"
      ]
    },
    {
      "uid": "zhcn:85813f439b6a0af4ae4c3d59",
      "kind": "character_system_text",
      "source_text": "天气变得相当暖和了。随性地、\n穿件便装就能出远门——\n哈。真是个不错的季节啊……。",
      "source_fingerprint": "17754422d08ca954b82fd5306bcb786dad5df2c9ff8247992ec2da588a8e47a5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91012"
      ]
    },
    {
      "uid": "zhcn:5e4244211faf589240d34d9c",
      "kind": "character_system_text",
      "source_text": "说起来梦旅好像弄到了个大家伙。\n难得有机会，大家一起玩吧……\n蒙眼劈西瓜。",
      "source_fingerprint": "9733f610d561d355a132ab0ab2b1b7c058be4e4e4e67a6cf1081995823daecde",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91013"
      ]
    },
    {
      "uid": "zhcn:8aec1d8eb48c714bc3b2f170",
      "kind": "character_system_text",
      "source_text": "差不多到采蘑菇的好季节了……\n那种像是在山里探险寻宝的感觉\n真让人兴奋啊。你能懂吧？",
      "source_fingerprint": "11aaf5db66129d7704d9d68f68288167575e01254150a39af16c4869c29be194",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91014"
      ]
    },
    {
      "uid": "zhcn:024280b8095e14f067e57b1b",
      "kind": "character_system_text",
      "source_text": "你见过漫天雪景吗？\n真想让你体验一下……双脚踏入\n纯白地毯时的那种雀跃感。",
      "source_fingerprint": "e239caec5dd614f1377ce43c9c8f930e2f532c210024cfbef4ecc8817f60019c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "91015"
      ]
    },
    {
      "uid": "zhcn:3efa36e562c9104eb27900fa",
      "kind": "character_system_text",
      "source_text": "嘛，开心地做吧。\n旅行的醍醐味，\n可是全都蕴含在过程之中哦。",
      "source_fingerprint": "f460539de7250a7fba6eb3fa0b9ac1a6cf831dfc6c240943f5a5b994f7d76b20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92000"
      ]
    },
    {
      "uid": "zhcn:5a2ddc417c0a86ef58cc601d",
      "kind": "character_system_text",
      "source_text": "好了，今天的训练\n会发生什么呢……让我们试试看吧。",
      "source_fingerprint": "937978700aa8cfc1e69bc64d6da774682787ff2fd1ab6cc94a521b1eea0490d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92001"
      ]
    },
    {
      "uid": "zhcn:ff5c4af0e54e6f0dfff88813",
      "kind": "character_system_text",
      "source_text": "慢悠悠地开始吧。……放心，\n我不会偷懒的。毕竟我也一样，\n渴望一场有趣的较量啊。",
      "source_fingerprint": "54b173d535d3d475893f2573454357e56d344201b4de5f878af5f0864509b04e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92002"
      ]
    },
    {
      "uid": "zhcn:5c53189d84caf2f0bf1823c2",
      "kind": "character_system_text",
      "source_text": "唔——天气真好，空气也清新……\n在外面跑跑也不错……虽然我也可能\n就那样直接去旅行了。",
      "source_fingerprint": "5e3576ad0bb4143a4476e57e7f59910c4b689c81c8d7878b9c995dda2eecb1e6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92003"
      ]
    },
    {
      "uid": "zhcn:b8cc4aaa9541967ff0993e6b",
      "kind": "character_system_text",
      "source_text": "你正兴奋着呢。\n挺好。对于旅行的伙伴来说，\n那可是必不可少的要素。",
      "source_fingerprint": "26bcdc1801b270f46ed1ee5b1068cf74280f2d40785a4ffeb2f0f629eab423ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92005"
      ]
    },
    {
      "uid": "zhcn:2b1955d2b4fccfbdee8b3403",
      "kind": "character_system_text",
      "source_text": "与你的这场旅行，究竟会抵达何方呢\n……真想在这漫长的途中，\n彻底品味个够啊。",
      "source_fingerprint": "148ceb3f89c41384f752f80885ff65db703ae90f937eb2be7a4244e67fc71eab",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92006"
      ]
    },
    {
      "uid": "zhcn:a11c39ace62622d1734dbe86",
      "kind": "character_system_text",
      "source_text": "旅途要有伴……虽然不知道\n是谁说的——但和你在一起，\n我也明白这句话的意思了。",
      "source_fingerprint": "97bb8d3572653fbf84b2803aa55b16a8c548e0f4bbb212da23e909ee06829879",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92007"
      ]
    },
    {
      "uid": "zhcn:ab55512ad1f1963dde35d50d",
      "kind": "character_system_text",
      "source_text": "好热……不过，真是个不错的地方。\n等太阳下山后，我们去看看\n海岸线到底延伸到哪儿了吧。",
      "source_fingerprint": "b74f56aab0f57788b1a728e9434ad6827c7cf811d18938c7d9b7e1d3122b3b57",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "92011"
      ]
    },
    {
      "uid": "zhcn:e8f0372164922f4e50656711",
      "kind": "character_system_text",
      "source_text": "那么，接下来要去哪里呢……你会来的吧？当然。",
      "source_fingerprint": "3b1a5757a725c4eeea1e1f9769ce9070132c0bd0dd363578c5d906380ea3782d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "93000"
      ]
    },
    {
      "uid": "zhcn:fe039529a60b6815e88f2e64",
      "kind": "character_system_text",
      "source_text": "我不会忘记的。那是一段，绝佳的旅程。",
      "source_fingerprint": "8d4d0d618859e5d0a22bccac654c83f69fb7993057b7acf893306ffee9c59a67",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "93001"
      ]
    },
    {
      "uid": "zhcn:fced84b276e4b83c48c64684",
      "kind": "character_system_text",
      "source_text": "旅途的终点……或许能看见呢。",
      "source_fingerprint": "ddc3b3d027b5cb72f8db5050596f90d1f9289a8e6874fb49f727807becbd399b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "95000"
      ]
    },
    {
      "uid": "zhcn:2a03ae68b23deaed241d90f0",
      "kind": "character_system_text",
      "source_text": "可以说是，新的旅途已经开启了吧。",
      "source_fingerprint": "99419fde5f5e0dbcffb1b91bc6ce21b8e59b8007af0171ec9a0b00adcf226861",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "95001"
      ]
    },
    {
      "uid": "zhcn:21a3876bf303c001eba265e9",
      "kind": "character_system_text",
      "source_text": "我是黄金旅程。让我们来一场精彩的旅行吧！",
      "source_fingerprint": "97ac89d8492d98590b73277067b6a60b94b8c8e6982c4f10adce0b75ea6a879d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "95003"
      ]
    },
    {
      "uid": "zhcn:81838e1c310df75349ced86f",
      "kind": "character_system_text",
      "source_text": "那么——这次又会抵达何方呢？\n要跟上来吗？跟上这趟黄金之旅。",
      "source_fingerprint": "e5e85c44596d5a36f1a36986e58725c296f369993fc1f59026fd580936f1e224",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "95004"
      ]
    },
    {
      "uid": "zhcn:da9607f28c0be606e89f973d",
      "kind": "character_system_text",
      "source_text": "那么，下一个目的地是……。",
      "source_fingerprint": "9c42853f960d447d4578474f66f48bf0f3f45c7c932fd933b6502ec396e3b7af",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "95005"
      ]
    },
    {
      "uid": "zhcn:498cdba7304f7fbf5413d657",
      "kind": "character_system_text",
      "source_text": "看看能走到哪儿去吧。",
      "source_fingerprint": "ce7814c8b7b8f2b70978433d3e102c37461592ccb2d9f881c4b9c2297fdb9bee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1135",
        "95006"
      ]
    },
    {
      "uid": "zhcn:c2af56e92599561aa54d3e39",
      "kind": "character_system_text",
      "source_text": "由我来施以救赎。",
      "source_fingerprint": "cf3f00d9ac6ccffb60c8e959aef24cc40813e8d4e84cccc96c66f0eca90a2273",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1000"
      ]
    },
    {
      "uid": "zhcn:dc3ddebed0de8375f1959eb7",
      "kind": "character_system_text",
      "source_text": "誓约已牢不可破地缔结。\r\n还请您全力指导我。\r\n一切考验我都必将克服！",
      "source_fingerprint": "293362df7e8c5f9942e2e308a5dc6aa435ecfcdecfd9d120fd580ac235973323",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "10000"
      ]
    },
    {
      "uid": "zhcn:a4705b29c4e739cc48865db5",
      "kind": "character_system_text",
      "source_text": "我出发了。",
      "source_fingerprint": "874e7497e7be8367a4f334f4c7f1d69916bd93469660e8935829876ff0311191",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "100000"
      ]
    },
    {
      "uid": "zhcn:4cdf149af1be7d5deedbfda5",
      "kind": "character_system_text",
      "source_text": "我回来了。",
      "source_fingerprint": "4f3f071de3a132d55ed31edf557b362afda8ef29b618fd0f52a13920ed7d26bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "100001"
      ]
    },
    {
      "uid": "zhcn:198461bb78f90c40f5863c8b",
      "kind": "character_system_text",
      "source_text": "若是在异界迷失了方向，\r\n我便会叩问驻留于心中的您。\r\n因为您就是我的光芒。",
      "source_fingerprint": "ec23b811cb3649184dd0ed3be2ee9887c48e0813a931afd524f0c4f2d3df655a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "10001"
      ]
    }
  ]
}
