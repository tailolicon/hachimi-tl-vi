      ]
    },
    {
      "uid": "zhcn:317a1e57de187d49b255b028",
      "kind": "race_jikkyo_message",
      "source_text": "灿烂的阳光之下，%course\n良状态的马场上飞舞着沙尘",
      "source_fingerprint": "8f5be29a69115297198874ed9b9532d9751cf62d7a7edb946686e46516354e61",
      "source_path": "race_jikkyo_message_dict.json",
