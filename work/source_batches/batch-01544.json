      ]
    },
    {
      "uid": "zhcn:8c13bf074db98f2020391199",
      "kind": "race_jikkyo_message",
      "source_text": "各赛马娘，进入闸门调整好了状态",
      "source_fingerprint": "0be3fd729954adbad03f6ab1be962463e24fad4ce7c68a4a9e2aadc9e2d8d92b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "100"
      ]
    },
    {
      "uid": "zhcn:52e45fad9637db49b5670ec7",
      "kind": "race_jikkyo_message",
