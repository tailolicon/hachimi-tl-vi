      "source_text": "%horse1此时冲上来了！",
      "source_fingerprint": "a7ff6fa900e44ea67221f9488567340f83f14ad20196f6d0e64b30a896f4a4a1",
      "source_path": "race_jikkyo_message_dict.json",
