    {
      "uid": "zhcn:084b3795326f28819b64ba04",
      "kind": "race_jikkyo_message",
      "source_text": "上方的天空布满灰色，%course\n天气并无过多变化，马场状态为良",
      "source_fingerprint": "105866c17fc822bf5d9ae479507ddef7173a80024f09cafadb10254b900f6b5d",
