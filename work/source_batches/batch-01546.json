      "kind": "race_jikkyo_message",
      "source_text": "占据领先位置的是%h_rank_ta1",
      "source_fingerprint": "6d46367ff7ba7f18d4c70d1f9352fdc621fdfa4502f5d9943706b1876b031c5f",
