  "entries": [
    {
      "uid": "zhcn:e6a763e667d04245449c12e9",
      "kind": "character_system_text",
      "source_text": "太阳渐渐升起了！",
      "source_fingerprint": "9836a4d116e28cd00a373a324c5c9b18ed9b34ef2855a281477b45e9b01476c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9040",
        "95006"
      ]
    },
    {
      "uid": "zhcn:e8939dfacf1d601528de636a",
      "kind": "character_system_text",
      "source_text": "能跟我一起努力吗？",
      "source_fingerprint": "9f7715f7b3b17cfc5a8c9036f75bb72a78db0fe0c30cec01237e894a03f1cdad",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9041",
        "20051"
      ]
    },
    {
      "uid": "zhcn:be5868837f070738fe606977",
      "kind": "character_system_text",
      "source_text": "你在想些什么呢？",
      "source_fingerprint": "a55d71389ef5face749fad5b0a6ebe2133f8061fda41d59f89e0c488382bd4db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9041",
        "70000"
      ]
    },
    {
      "uid": "zhcn:6ce7bc63f4e0151e88aa26f2",
      "kind": "character_system_text",
      "source_text": "千万别落后了！",
      "source_fingerprint": "f97f480162c20865ee2e3a45b0d118f3666abed034eb4046bbf0299f9d564291",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9042",
        "20051"
      ]
    },
    {
      "uid": "zhcn:0d12e9134cc32e11268e99ae",
      "kind": "character_system_text",
      "source_text": "让我见识你的实力吧。",
      "source_fingerprint": "51ea7218088fba6614dfa29d5cd4a3abd60c5520c0cab50a4fa370d144716163",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9042",
        "70000"
      ]
    },
    {
      "uid": "zhcn:2e7bee2c1dc93b35531330f8",
      "kind": "character_system_text",
      "source_text": "鼓起干劲吧！",
      "source_fingerprint": "5a16930073ab91508df85df232f9e23fdf25e22b637dd6f69605e742a7e76233",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9043",
        "20051"
      ]
    },
    {
      "uid": "zhcn:bfe9ee330f2b84af2f5c98c7",
      "kind": "character_system_text",
      "source_text": "无论高山还是低谷我都要翻越！",
      "source_fingerprint": "bee5fcf2910fb4ef222d1e5c661d4970b120ce967e5e6ff45c1142508641de8d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9043",
        "70000"
      ]
    },
    {
      "uid": "zhcn:8cf552355a9a3f3b67481acf",
      "kind": "character_system_text",
      "source_text": "幕后工作就交给我吧。",
      "source_fingerprint": "760b0827f732c0622dcb89f2770882ecdbfd3244fe9d556d55f3ef372dd89128",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9043",
        "95005"
      ]
    },
    {
      "uid": "zhcn:6ceea9c9c96f6a1bc84fb178",
      "kind": "character_system_text",
      "source_text": "目标瞄准巅峰吧！",
      "source_fingerprint": "63d1bad0f475744e65cb25c6d6e0406f5fdf0352eab726be14227c7db45bb11d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9043",
        "95006"
      ]
    },
    {
      "uid": "zhcn:a9b6025936e8aa0878b969a9",
      "kind": "character_system_text",
      "source_text": "最高の仕事にしましょう。",
      "source_fingerprint": "8325a25b5d7466d0aa674fd5476b45bbf45a61953a02b5f80db70bcbd3a269c9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9044",
        "20051"
      ]
    },
    {
      "uid": "zhcn:7db6a718ab300932b69ff7f1",
      "kind": "character_system_text",
      "source_text": "新たなエンターテインメントを、共に。",
      "source_fingerprint": "8f348f782f9c0f096a617268a38e4bae6ac2fae0ff70fd6fb06d1c68a56ca816",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9044",
        "70000"
      ]
    },
    {
      "uid": "zhcn:3e17188c1e1f197338e3d206",
      "kind": "character_system_text",
      "source_text": "より効率的に動けますね。",
      "source_fingerprint": "70f9f478c279ca7df674a61039348844ba8cdd2af24646a6bcc4b3bc4d3505fb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9044",
        "95005"
      ]
    },
    {
      "uid": "zhcn:bd6e210cffe24c26ee69db3f",
      "kind": "character_system_text",
      "source_text": "素晴らしい仕事ができそうです。",
      "source_fingerprint": "b99b8511d0c90e8b42e498c43c1e050317c315c513de1087431316f73668b77a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9044",
        "95006"
      ]
    },
    {
      "uid": "zhcn:4e1efd4dbda28aeebfe60d91",
      "kind": "race_jikkyo_comment",
      "source_text": "交战的舞台已经准备好了",
      "source_fingerprint": "91dce37417718c5d69efab2f6e2e38c0435d419b9d116bde343ac586560148dd",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1"
      ]
    },
    {
      "uid": "zhcn:4acf24e1ef34745308b37f19",
      "kind": "race_jikkyo_comment",
      "source_text": "相当难办的马场啊\n得注意一下路线选择了",
      "source_fingerprint": "593c04382d98bb7fad8a9af4d8ac6d95f03371a701d583cbe4b48ca43b132b10",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "10"
      ]
    },
    {
      "uid": "zhcn:cf47fd4cb00d1030e450b3e4",
      "kind": "race_jikkyo_comment",
      "source_text": "看来会是一场可以充分发挥实力的比赛呢",
      "source_fingerprint": "42d36d8ecc46dda1dcf6c52260f938e8ecf3a4909e17bcfee80695bbafcdc405",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1040"
      ]
    },
    {
      "uid": "zhcn:ec51c340e0b8d267370789fa",
      "kind": "race_jikkyo_comment",
      "source_text": "期待各赛马娘精彩的表现",
      "source_fingerprint": "fed918253b454a336f6218c6554ff4767eb13301508befcebb887c3f62a847c7",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1041"
      ]
    },
    {
      "uid": "zhcn:8f117369c1e789421b6cca0b",
      "kind": "race_jikkyo_comment",
      "source_text": "马场一直很干燥\n这将会是一场力量的对决",
      "source_fingerprint": "74a4ad3d24327230e0d096013f8d25f8e3f189eab041a7a88d760873c905a6c7",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1042"
      ]
    },
    {
      "uid": "zhcn:4a08783c921245c3bcaed03f",
      "kind": "race_jikkyo_comment",
      "source_text": "看来可以毫无保留地\n发挥出沙土巧者的实力呢",
      "source_fingerprint": "ef9e699a6953fa63168463e173b2ba56ce27dbaadbfb3197b73b2fe538e3bd76",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1043"
      ]
    },
    {
      "uid": "zhcn:610a0c654253c6f1a7c4de10",
      "kind": "race_jikkyo_comment",
      "source_text": "这两人掌握比赛的能力很值得关注呢",
      "source_fingerprint": "d7386d10535bd57b639815e5209450c9bb865b6c8e7db82ed7ff9b06cc434321",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1044"
      ]
    },
    {
      "uid": "zhcn:79088ac2553ff73bdd909e27",
      "kind": "race_jikkyo_comment",
      "source_text": "后方马娘该如何应对\n这两人的节奏呢",
      "source_fingerprint": "07b43af3838031aa502c2c706a199a5cb7d1c7e6e8c0f1033fc482726c09e40c",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1045"
      ]
    },
    {
      "uid": "zhcn:b9c5922f175178c6aac7179b",
      "kind": "race_jikkyo_comment",
      "source_text": "位置争夺看来会很激烈呢",
      "source_fingerprint": "c8f1d7d01cc77836c8b95219b3b7f1aa4fc6bfd6364b4a6339a288561f5cc4f3",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1046"
      ]
    },
    {
      "uid": "zhcn:3b573ce6940214b8f522c7ed",
      "kind": "race_jikkyo_comment",
      "source_text": "谁能占据领先，让我们拭目以待吧",
      "source_fingerprint": "bb1eefedc00ab35c3415f8e3fc14d44b891917a478d9f17b0baceff856327553",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1047"
      ]
    },
    {
      "uid": "zhcn:086bea248ff09cfa1dc0fa3d",
      "kind": "race_jikkyo_comment",
      "source_text": "看来这两人想主导比赛呢",
      "source_fingerprint": "88fa7887e365daf1764d99155b4e38c7b4bc407c88f2416de2afaf86a0b4ba0c",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1050"
      ]
    },
    {
      "uid": "zhcn:0c203e7f53c94da1f5fa69a8",
      "kind": "race_jikkyo_comment",
      "source_text": "比赛局势也可能会朝着快节奏发展",
      "source_fingerprint": "5a1bb05eca50e51b2f41632c5c1a9966fab0159684aaf1b1cd5e14e6c78cdb82",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1051"
      ]
    },
    {
      "uid": "zhcn:b9a025d52b0fdfea7da3e02e",
      "kind": "race_jikkyo_comment",
      "source_text": "这是想把胜负赌在直线赛道吧\n期待她在终盘的表现！",
      "source_fingerprint": "757263ae08acf7f9617efb85e9aa43b1d8226a212d71146be17f3c43c07e1510",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1052"
      ]
    },
    {
      "uid": "zhcn:213f9a6e8478a8e76d2c8f2f",
      "kind": "race_jikkyo_comment",
      "source_text": "看来很难突出重围啊",
      "source_fingerprint": "c06a88ab217cf2154be96c01314aee8a4875f5efd1bd3730c013594150887355",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1053"
      ]
    },
    {
      "uid": "zhcn:ce34724e61aa8330502a07b1",
      "kind": "race_jikkyo_comment",
      "source_text": "她们似乎在互相牵制",
      "source_fingerprint": "44762a35639fbd15e5f7e1140d21471d89d392792900c910838cd1fd742bc072",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1054"
      ]
    },
    {
      "uid": "zhcn:11d10ad0efcc23c75081eba5",
      "kind": "race_jikkyo_comment",
      "source_text": "各赛马娘似乎都保持着自己的节奏",
      "source_fingerprint": "ba9e389ab22c124844069f3b8e9a054523100377f42a288aeb11cd0eb8072d3d",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1055"
      ]
    },
    {
      "uid": "zhcn:7a4ab2fd6c78a9762b349875",
      "kind": "race_jikkyo_comment",
      "source_text": "后方的赛马娘能跟得上吗\n距离差距可不小",
      "source_fingerprint": "c69871016d714bef64afe270563e70859305e50d442ce78eb1bfbdb3d6bee394",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1056"
      ]
    },
    {
      "uid": "zhcn:48a7abf08645a349f5b4a33d",
      "kind": "race_jikkyo_comment",
      "source_text": "从内道来，还是从外道来！\n最后的局面了！",
      "source_fingerprint": "7e3cecab8cb4a556c3a9b1a79a8b3239377d8ad312d1b85276f11df6cd0cb5c6",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1057"
      ]
    },
    {
      "uid": "zhcn:2b48d74aa09c013708b051fb",
      "kind": "race_jikkyo_comment",
      "source_text": "赛马娘们会如何行动\n无法移开目光！",
      "source_fingerprint": "04e7da775d42ee4bcd1e9d2b714d3cac86e843163eebf87c11f9326f20edbf8f",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1058"
      ]
    },
    {
      "uid": "zhcn:a42b73e98459b3af5495df42",
      "kind": "race_jikkyo_comment",
      "source_text": "冲刺阶段！\n局势瞬间发生了变化！",
      "source_fingerprint": "a2ca0705e0b96e830fb0a2fd80d26addb644626a3e20f8b82b62dcd708231a56",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1059"
      ]
    },
    {
      "uid": "zhcn:a921cb5ac12454ed10b93338",
      "kind": "race_jikkyo_comment",
      "source_text": "很担心她耗尽耐力啊",
      "source_fingerprint": "6b87d453a3175e45798404a1b06011b73666d9cdaef4ac00451e4131b9c34b86",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1060"
      ]
    },
    {
      "uid": "zhcn:0cffe7dcc8606c77ec543f69",
      "kind": "race_jikkyo_comment",
      "source_text": "如果能冷静下来就好了",
      "source_fingerprint": "59ea8154192a11aab72257bef9d1d8c495a7acde012f97b4c54fd92b12f72a18",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1061"
      ]
    },
    {
      "uid": "zhcn:c0687f9a694c40dd06369213",
      "kind": "race_jikkyo_comment",
      "source_text": "这么密集的话\n可能会造成混乱",
      "source_fingerprint": "3ca85cc5b781d5993bb6aac2168232728cbccd517f2936f1b851280e24af802d",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1062"
      ]
    },
    {
      "uid": "zhcn:c254fc751d0ec62bf39c46f9",
      "kind": "race_jikkyo_comment",
      "source_text": "看来很难突出重围啊",
      "source_fingerprint": "c06a88ab217cf2154be96c01314aee8a4875f5efd1bd3730c013594150887355",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "1063"
      ]
    },
    {
      "uid": "zhcn:9eb965c4654ca8bf02f007f0",
      "kind": "race_jikkyo_comment",
      "source_text": "天气如此恶劣的话\n很难预测比赛将如何发展",
      "source_fingerprint": "dbc095b9df3ec4cf3779150777ace892d110ac245842f700ff6d0d97046a6791",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "11"
      ]
    },
    {
      "uid": "zhcn:e62196e5659a0599c9bfe79b",
      "kind": "race_jikkyo_comment",
      "source_text": "现在的马场状态似乎相当难跑呢",
      "source_fingerprint": "48adf7050fc49cdbadbcb48aed382108b784cfda69bef19b0973c71d65bea365",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "12"
      ]
    },
    {
      "uid": "zhcn:784c74ac51281b0f0dcdba97",
      "kind": "race_jikkyo_comment",
      "source_text": "她看起来很焦急啊\n是在在意和前面的距离吗",
      "source_fingerprint": "9d6107366c86d5b4a9c149dbc6714b037e761333d97a1957c5a2df3c6599b9e9",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "121"
      ]
    },
    {
      "uid": "zhcn:69cc34ebd06e52cc62087589",
      "kind": "race_jikkyo_comment",
      "source_text": "很担心大雪会给比赛带来怎样的影响啊",
      "source_fingerprint": "3692a00b2c323011c3cda686d03c97a3bb556688e87ebdc338da6441b05f5da0",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "13"
      ]
    },
    {
      "uid": "zhcn:246b3b0b96de9ad2ca39d778",
      "kind": "race_jikkyo_comment",
      "source_text": "奔跑的时候也得考虑大雪的影响呢",
      "source_fingerprint": "9941ecebafdd3beffa6a7976d5d72a19407c9114e98ed80224e1b87e52f9c739",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "14"
      ]
    },
    {
      "uid": "zhcn:75f7e55173f5b83831fd7fd4",
      "kind": "race_jikkyo_comment",
      "source_text": "虽然“银装”一词听起来很美，\n但对要赛跑的马娘们来说相当麻烦呢",
      "source_fingerprint": "a93dadfc6b34c46ec41b0a5b397b6815045a26255ddb5338f79752017e8aa35d",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "15"
      ]
    },
    {
      "uid": "zhcn:96d67ff1bd2ba64c66a9c438",
      "kind": "race_jikkyo_comment",
      "source_text": "这场雪究竟是敌是友\n考验赛马娘们适性的时候到了",
      "source_fingerprint": "b753eaaede287f6eff26d23d22ff145940e6153dea5d179af206db954c18d254",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "16"
      ]
    },
    {
      "uid": "zhcn:5b0a9d3bfb0cb5bbe82052f3",
      "kind": "race_jikkyo_comment",
      "source_text": "干劲十足！　表情很不错呢！",
      "source_fingerprint": "4129967bc46e2560e630034af15ac708e3233a184f698e4c35acd5c4f8ff3d67",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "18"
      ]
    },
    {
      "uid": "zhcn:fe1f1e557563f7c88924c6af",
      "kind": "race_jikkyo_comment",
      "source_text": "让我们期待一场火花四溅的激烈斗争吧",
      "source_fingerprint": "96c00dba82581484f661f118c999364eb1abb3a2ba3278f84134fa37440536a3",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "19"
      ]
    },
    {
      "uid": "zhcn:6f4fda27e748082003efec6b",
      "kind": "race_jikkyo_comment",
      "source_text": "马场现在非常干燥\n说不定会脚下打滑",
      "source_fingerprint": "d475da43753c78fcefd58dd409ca3320145d5ae41782f43573111d214f9c4694",
      "source_path": "race_jikkyo_comment_dict.json",
