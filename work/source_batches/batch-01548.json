      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "3015"
      ]
    },
    {
      "uid": "zhcn:d1a2f33575c0706ea96c56a1",
      "kind": "race_jikkyo_comment",
      "source_text": "群雄逐鹿的精彩比赛\n完全不想把视线移开！",
