      "json_path": [
        "3016"
      ]
    },
    {
      "uid": "zhcn:0a94d3242c6b53f2129f918f",
      "kind": "race_jikkyo_comment",
      "source_text": "能够领先冲线的究竟会是哪位赛马娘呢\n终于到了起跑时间！",
