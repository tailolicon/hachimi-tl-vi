      "json_path": [
        "4017"
      ]
    },
    {
      "uid": "zhcn:fcc6c51c1345f92d4d8369e3",
      "kind": "race_jikkyo_comment",
      "source_text": "凯旋门赏的对手们都很强大，\\n希望她展现出不输于她们的跑法。",
      "source_fingerprint": "48014daa18bc44cd816b87850a5ffe1d2f90dd0ee3ab1ca3a03b901f1bd10c17",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "4018"
