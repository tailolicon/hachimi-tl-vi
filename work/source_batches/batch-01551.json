      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "4054"
      ]
    },
    {
      "uid": "zhcn:258dcda93d31274ea61d2e26",
      "kind": "race_jikkyo_comment",
      "source_text": "至今为止势不可挡的日本选手\\n希望她也能乘胜追击，赢下这场胜利",
      "source_fingerprint": "d653b016047a4064ac66941e3b1d5209a833b3939132969511b835da6df580d9",
      "source_path": "race_jikkyo_comment_dict.json",
      "json_path": [
        "4055"
      ]
    },
