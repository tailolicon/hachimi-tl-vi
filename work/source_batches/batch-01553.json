      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "1236"
      ]
    },
    {
      "uid": "zhcn:10d0cefbcfa80d92182266d5",
      "kind": "race_jikkyo_message",
      "source_text": "各赛马娘，一同展示了漂亮的起跑！",
      "source_fingerprint": "296bd91e0e87bc1df8313c6eb375392f9bf8afad3289c8b30dc87b5213769ba0",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "124"
      ]
    },
    {
      "uid": "zhcn:585da826ecb0471ec25fab4a",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\n以惊人的脚力冲了上来",
