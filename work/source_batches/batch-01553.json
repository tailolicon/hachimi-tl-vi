      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "121"
      ]
    },
    {
      "uid": "zhcn:f70d3e55d2864c0ffbde2606",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，起跑晚太多了",
      "source_fingerprint": "096ff49f04d4c6a56d03054d3b56913c4ef2a7be6ba437d626d29d17a6103737",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "122"
      ]
    },
    {
      "uid": "zhcn:803e91cf98b191c7a3f63e88",
      "kind": "race_jikkyo_message",
      "source_text": "起跑稍微有些混乱",
      "source_fingerprint": "17c989dc5dfab2fe1d78bc2ed667955a52d2d9736da6ce455b4e0fc746d5e652",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "123"
      ]
    },
    {
      "uid": "zhcn:18864b36fce48dbbe62e6c2c",
      "kind": "race_jikkyo_message",
      "source_text": "后方马娘一口气缩小了差距",
