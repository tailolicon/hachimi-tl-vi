      "source_fingerprint": "8fb2a96827a60ba2a1389bc45e85e1ed60c414c016567ec1fcebce887e793abd",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "125"
      ]
    },
    {
      "uid": "zhcn:0d021d2e1198f7bf69087f83",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\n接下来就是冲刺阶段了",
