      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "1270"
      ]
    },
    {
      "uid": "zhcn:dc82bff2bc9eb39e60108e8b",
      "kind": "race_jikkyo_message",
      "source_text": "跑完第一圈，马娘们来到看台前直线赛道",
      "source_fingerprint": "b4ae5a5e2129a798c81018d39e5137906631baeeabc7458bffb9f85657f62196",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "1271"
      ]
    },
    {
      "uid": "zhcn:4cbb58d2db61b69d05d5730c",
      "kind": "race_jikkyo_message",
      "source_text": "跑完第一圈，马娘们进入了看台前直线赛道",
