    {
      "uid": "zhcn:3f9d1dd7b8dfa4dfdcf8f154",
      "kind": "race_jikkyo_message",
      "source_text": "哎呀！　%horse1\n是起跑晚了吗！？",
      "source_fingerprint": "735876f548a0061a25121791dee074e9b50af020488558e322b741529d4e32fe",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "118"
      ]
    },
    {
      "uid": "zhcn:4793369af8e076792276f840",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\n因为起跑晚，现在处于队伍最后方",
      "source_fingerprint": "6c16819301ad6c8e5598c8c0346c60c29406daa3d8981d97d82dba48f374b74a",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "119"
      ]
    },
    {
      "uid": "zhcn:2c7852384710b6917038178e",
      "kind": "race_jikkyo_message",
      "source_text": "比赛在晴天下举行，%course\n由于反复降水的天气\n现在马场状态为稍重",
      "source_fingerprint": "8f06a6dfefea871585f67059b1ae73da15214d45862647e20da8c7f4f4fd7a67",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "12"
      ]
    },
    {
      "uid": "zhcn:6700b2cfdcee50884f890636",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\n处于有些尴尬的位置从后方开始追赶",
      "source_fingerprint": "8760ca3a10f8456e3c0906a3849800ec53ed725949e1ad062b1f4ea66537d1ea",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "120"
      ]
    },
    {
      "uid": "zhcn:a49148100350ffa363abc51f",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，稍微有些起跑晚了",
