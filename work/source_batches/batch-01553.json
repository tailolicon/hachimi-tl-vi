      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "1250"
      ]
    },
    {
      "uid": "zhcn:07234f91bc5031dc25c31cf8",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1现在领先",
      "source_fingerprint": "f6e10aa999dacfe2aca2dea0b0651fbdbb845529a6ac998eeea0896b49c05ef0",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "127"
      ]
    },
    {
      "uid": "zhcn:045988f5aa5cac6817d95dbb",
      "kind": "race_jikkyo_message",
      "source_text": "落在了最后方\n%a_h_player，没问题吗！？",
