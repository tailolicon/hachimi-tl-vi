    {
      "uid": "zhcn:d52b281a89c6c7c5901761af",
      "kind": "character_system_text",
      "source_text": "请登记3名\r\n要参赛的赛马娘。",
      "source_fingerprint": "ac0d0c7bdb8bc912dd5b808778309984eb769a4189381713312107659d67c439",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9001",
        "2016"
      ]
    },
    {
      "uid": "zhcn:30963929b497484e9995611d",
      "kind": "character_system_text",
      "source_text": "决胜赛将会一场定胜负。\r\n报名参赛，匹配一段时间后，\r\n比赛就将正式开始！",
      "source_fingerprint": "ab2010327dc4fb5a435b63cca248f2d99536a46f9810e44c5c2f98536bb7963e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "9001",
