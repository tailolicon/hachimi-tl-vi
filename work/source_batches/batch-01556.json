  "entries": [
    {
      "uid": "zhcn:8155ce6c6e898b0be5acbd8f",
      "kind": "character_system_text",
      "source_text": "我相信你！大概100英里！",
      "source_fingerprint": "0933418436de98df85a0fe9e64ecac1ef907b261ae6bb782caab4fcf25734f4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140004"
      ]
    },
    {
      "uid": "zhcn:722cd22083e2c2f4c8b1290f",
      "kind": "character_system_text",
      "source_text": "下次一定能夹到！",
      "source_fingerprint": "5fab1591d97e74a782ae9d6003d936b7f01222f3f956c4ea3dbf9d348b60221b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140005"
      ]
    },
    {
      "uid": "zhcn:77ddbdf1bf6d5bb7206d2b25",
      "kind": "character_system_text",
      "source_text": "好厉害！最强游戏玩家呢！",
      "source_fingerprint": "6f4bc078fba15970e8fc54267d3d5623f8d427dcffd4429d03a39a7856398d30",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140006"
      ]
    },
    {
      "uid": "zhcn:86e38188f4d8b06cdbc0f05e",
      "kind": "character_system_text",
      "source_text": "我相信你！大概100英里！",
      "source_fingerprint": "0933418436de98df85a0fe9e64ecac1ef907b261ae6bb782caab4fcf25734f4a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140007"
      ]
    },
    {
      "uid": "zhcn:5ab10060de592ade6934a3ad",
      "kind": "character_system_text",
      "source_text": "呵呵♪",
      "source_fingerprint": "be5bbe234521b4a03ca4c74a7307dfb298bf52b5fb88c43c06a8d76faa5c623e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140008"
      ]
    },
    {
      "uid": "zhcn:ca784002e651026507873cc4",
      "kind": "character_system_text",
      "source_text": "请加油！",
      "source_fingerprint": "6a173c48bc7f40f0f4168e612d91504ee466fc02ae17e991f49c5563b5cf0a86",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140009"
      ]
    },
    {
      "uid": "zhcn:448ff4196310e30124c32491",
      "kind": "character_system_text",
      "source_text": "相信自己！",
      "source_fingerprint": "5fd081e5ad8611ae0a227e7dadb00cacfd0bcf1fccf0958b8851c64f7d14c7a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140010"
      ]
    },
    {
      "uid": "zhcn:27bc81b20ca67b6603495670",
      "kind": "character_system_text",
      "source_text": "不愧是你！",
      "source_fingerprint": "eeec4fc164e4dc24cd6d2d4b8f80cbb778e92f23841717c57bc4da0d6002667b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140011"
      ]
    },
    {
      "uid": "zhcn:7b73c88d8aa7174111a44b5c",
      "kind": "character_system_text",
      "source_text": "千载难逢的机会！",
      "source_fingerprint": "8fbcfa4243189c4696666700b21e91bc3e081f63ccde139d7765e2efc28f4c0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140012"
      ]
    },
    {
      "uid": "zhcn:daf6b47fc7e8482fea251536",
      "kind": "character_system_text",
      "source_text": "一口气跑到终点！",
      "source_fingerprint": "2a8f7e981df61a5e097effa103c4d525e36d4c3161461a49d0280d9c5eddc482",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140013"
      ]
    },
    {
      "uid": "zhcn:2b09ceb5b2f62858fb37c6c5",
      "kind": "character_system_text",
      "source_text": "啊！",
      "source_fingerprint": "81c28a42b8af498807476919251caa5ba6f641f655e63b78274946de67cc1a0c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140014"
      ]
    },
    {
      "uid": "zhcn:c443c3b075dbb6f4074d9e35",
      "kind": "character_system_text",
      "source_text": "唔唔唔～……！",
      "source_fingerprint": "74bda116304b01b335cd6243ce685cf55f51f6b5307567e84c9c470748d62df2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140015"
      ]
    },
    {
      "uid": "zhcn:94ba2c702a44f1edc01984c6",
      "kind": "character_system_text",
      "source_text": "喂，训练员？",
      "source_fingerprint": "77feab16924d95864ca0da4ef588c699f9177579746c052a9e58821476f82515",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140016"
      ]
    },
    {
      "uid": "zhcn:603874019509631108e37dab",
      "kind": "character_system_text",
      "source_text": "呜哇！",
      "source_fingerprint": "8871489a77c6146d46511c92d03ccfcb2da98befcd81a0b4d3db6f3ada3860cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140017"
      ]
    },
    {
      "uid": "zhcn:fc59b4b0fca9833964f1a436",
      "kind": "character_system_text",
      "source_text": "呜啊～！",
      "source_fingerprint": "6f3d5123a4fc1314db02f67d044a0f5e6a115914c79d004da3a0f4cbb7d4d3bf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "140018"
      ]
    },
    {
      "uid": "zhcn:3783f5c360573e89577be983",
      "kind": "character_system_text",
      "source_text": "明天也要来领取哦！",
      "source_fingerprint": "97217c56fe2822ce8bd596160d37353a241850a042d3b33132e568678cc63eae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "15"
      ]
    },
    {
      "uid": "zhcn:409e55d2cec76e84a3665674",
      "kind": "character_system_text",
      "source_text": "……总觉得，身体……\r\n有点奇怪。平时明明更能\r\n自然而然地动起来……嗯……。",
      "source_fingerprint": "b6105064b62f1cc8d650b09895de3d93f44ad8a507f5cfa620d92335b7f74b7c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20000"
      ]
    },
    {
      "uid": "zhcn:997744e5329dab343be64f0e",
      "kind": "character_system_text",
      "source_text": "我，可能想稍微休息一下！\r\n把今天当作作战会议日，\r\n怎么样？",
      "source_fingerprint": "f86f7da84ff5c55f56568e6ee62e586b1c58249cef69da2d6c98863040cbbe50",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20001"
      ]
    },
    {
      "uid": "zhcn:f2c52901c5ec4a0ae214f503",
      "kind": "character_system_text",
      "source_text": "比训练员先到达，靠这一条\r\n今天已经完成第10条英里规则\r\n了！呵呵呵，状态绝佳！",
      "source_fingerprint": "0a2361f434b301dbb76124fd0519c818fa457858a16f558e05eca2fbe5e0ea83",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20002"
      ]
    },
    {
      "uid": "zhcn:9b4ecaa191c8ca235b40d7b0",
      "kind": "character_system_text",
      "source_text": "……啊。这是我，\r\n状态特别好的时候。……呵呵\r\n你想期待多少都可以哦？",
      "source_fingerprint": "895405e2f77077ecd7e7d9424f9e09ddc0b26f78f9d542809d40ab218a404c2d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20003"
      ]
    },
    {
      "uid": "zhcn:7c7a2907cdff461827cfbc14",
      "kind": "character_system_text",
      "source_text": "今天的训练……呵呵\r\n感觉比平时，更能应付任何内容♪\r\n有挑战性的训练，请尽管安排☆",
      "source_fingerprint": "b69589ead563604e919791541e8d344dd38d58835f6cea7a7ea0a7b5feefc79b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20004"
      ]
    },
    {
      "uid": "zhcn:f94869b2d57fba11958325aa",
      "kind": "character_system_text",
      "source_text": "好，要上啦要上啦♪总觉得\r\n今天，100英里……不！\r\n200英里！力量满满！",
      "source_fingerprint": "dc2178cf58d0be03a042912d406c8693fcc0989d1ca71cbcbf6c15cc35365451",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20005"
      ]
    },
    {
      "uid": "zhcn:62123b6ac136870cbeb2eaf6",
      "kind": "character_system_text",
      "source_text": "嗯！状态和平时一样！\r\n就是平时那个，强大的我☆",
      "source_fingerprint": "d57307433473d0f205a7de3992cde21842005e49528ca9ce2a4ff08779d1f363",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20006"
      ]
    },
    {
      "uid": "zhcn:169af0d0563d07d3a3e23f96",
      "kind": "character_system_text",
      "source_text": "正是平日的训练，才不能\r\n松懈！嗯，这是理所当然的！\r\n连定成英里规则都不需要！",
      "source_fingerprint": "8f8e1d160042962afafc267d18741a28496b0b0b54af4591386236c58f2d750a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20007"
      ]
    },
    {
      "uid": "zhcn:d8672be0ca5321102f4bf2ca",
      "kind": "character_system_text",
      "source_text": "状态稍稍有些不好……\r\n我会努力！一边训练，\r\n一边想办法调整好♪",
      "source_fingerprint": "00d141c35e976c0a7f45f1d931db615d673fb63428673a6b5097364aa171c90c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20008"
      ]
    },
    {
      "uid": "zhcn:533c82f908fbeafadfe78a03",
      "kind": "character_system_text",
      "source_text": "英里最强。英里跑者才是最强。\r\n……我必须证明这一点。所以\r\n可不能拿心情之类的当借口！",
      "source_fingerprint": "7a963245121a8f270a73650e7ad51864cf2d42f8135791d1e324b1365d4e6296",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20009"
      ]
    },
    {
      "uid": "zhcn:d252d9eab87b0aa058b1851a",
      "kind": "character_system_text",
      "source_text": "……嗯。很差呢，状态。\r\n非常差。但我会做。\r\n即使如此也能做到的，就是我。",
      "source_fingerprint": "5877213e73b78e8adb24bf6fa270875b4a38834a58242cee6a73fd58de2f35ee",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20010"
      ]
    },
    {
      "uid": "zhcn:eadfb5c7e861c0133bb74481",
      "kind": "character_system_text",
      "source_text": "好！我会努力的！！\r\n……我也清楚自己完全不在状态，\r\n至少得先鼓起干劲！",
      "source_fingerprint": "85b5a569e388f326b27c97eaad64c7073498593d342ce9a65691c889235dc8eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20011"
      ]
    },
    {
      "uid": "zhcn:2a17c9c48d870944bfe6bbbb",
      "kind": "character_system_text",
      "source_text": "最近，说到要参赛，\r\n我的期待却是0英里。\r\n……能重新考虑一下吗？",
      "source_fingerprint": "a8d939e76b8c38c38e8eab25815fc757594f36e50afab86accaf9d375ca29298",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20021"
      ]
    },
    {
      "uid": "zhcn:537efcf0fd3b98b9f779c284",
      "kind": "character_system_text",
      "source_text": "……训练员。\r\n你不是那种非得我明说\r\n才懂的人吧？",
      "source_fingerprint": "d208901d7fb76a18ed47c0fc5e246138c5c295a4b9615908edca3dc84b7b1ef0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20022"
      ]
    },
    {
      "uid": "zhcn:a087f01ca57ec02e5bb86ee8",
      "kind": "character_system_text",
      "source_text": "嗯……呵呵♪我的身体也\r\n在说，状态绝佳！\r\n或许根本找不到会输的理由。",
      "source_fingerprint": "fc5adae5c2cdaf6cb18a4470056f84a882c36404ce01d8b4d4e9b0179688ec27",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20023"
      ]
    },
    {
      "uid": "zhcn:33d20fbc6075d9884a2e9f57",
      "kind": "character_system_text",
      "source_text": "满溢而出了，对英里的热爱！\r\n好！最强英里跑者的实力，\r\n我要让大家好好见识！",
      "source_fingerprint": "6dd64d838224b1b8fb84a6648f05eb2d4bf5526069ba20513f70ce623226aa59",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20024"
      ]
    },
    {
      "uid": "zhcn:785f21e0283b93f214ff372e",
      "kind": "character_system_text",
      "source_text": "训练员！请好好\r\n看着哦？看我，\r\n会拉开多少身位。",
      "source_fingerprint": "61c650401c8de16a8e296f87dc134932510b78be3b0bdc348f08448177b32c72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20025"
      ]
    },
    {
      "uid": "zhcn:ee2b7fdf1701c5310241b7c4",
      "kind": "character_system_text",
      "source_text": "呵呵，真期待呢♪今天，\r\n我要让大家见识到。\r\n――放声欢呼的强大！",
      "source_fingerprint": "b7015c2f96fabb36f406231e5e5c64d792b2b7e47f58478ca1ce5aca8247c742",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20026"
      ]
    },
    {
      "uid": "zhcn:d0373155ab1497fcf96a2ea8",
      "kind": "character_system_text",
      "source_text": "热血沸腾得，连汗都冒出来了！\r\n怎么还没到参赛时间？\r\n期待100英里☆",
      "source_fingerprint": "ff8c0b9f40d6f3b149466c977a2f50bd5eda0be6de9c9d143b5ff65a21742049",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20027"
      ]
    },
    {
      "uid": "zhcn:b67810b5dc02fb5b68b9e7ff",
      "kind": "character_system_text",
      "source_text": "状态好的时候更要，想想比赛后的\r\n沙拉！这正是，\r\n为了胜利的英里规则！",
      "source_fingerprint": "c1e7ff29433a301f3e67a3a6d66c261ef4f04164ee103e102ffa35e2599a5b7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20028"
      ]
    },
    {
      "uid": "zhcn:8f467339b766f74679b6d81f",
      "kind": "character_system_text",
      "source_text": "嗯，状态和平时一样……\r\n吧？\r\n――那就，不会输。",
      "source_fingerprint": "885c277299ec00a72c7643eb9a3db18358dbd3ab27151bdd234392e3324c616a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20029"
      ]
    },
    {
      "uid": "zhcn:52bc3a33503f04ada8a48feb",
      "kind": "character_system_text",
      "source_text": "我们两人的英里规则，你没忘\r\n吧？呵呵……那么，比赛后再见！",
      "source_fingerprint": "5c15448331370fa4c29e8c08d9580fff00487fe47dd2a411e4fddd34fa612b20",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20030"
      ]
    },
    {
      "uid": "zhcn:b0b58a50fc415a08c847bb77",
      "kind": "character_system_text",
      "source_text": "吸，呼……呵呵。\r\n这份高昂的心情真舒服！\r\n我会跑出自己的风格，去去就回！",
      "source_fingerprint": "4134b8c9481821d750cc351d9364321ba8f9a191bf4123c85ce3589e909d9de4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20031"
      ]
    },
    {
      "uid": "zhcn:fbd823f3a523bab1ec18fea2",
      "kind": "character_system_text",
      "source_text": "或许状态不算完美……\r\n但即便如此，也一样。\r\n结果，请好好看着哦？",
      "source_fingerprint": "d551f0e9b4576969d0f3d2a48d4af9611cbd9390bccfe09326518a8a5b352ae1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20032"
      ]
    },
    {
      "uid": "zhcn:943ff60dccf4a12ac1ba0bd0",
      "kind": "character_system_text",
      "source_text": "就快要参赛了呢。\r\n……以防万一，再确认1次\r\n蹄铁，是否有问题吧。",
      "source_fingerprint": "16e10dddc443bdd7acaba63bd74f70dc5c6ddc15d19097813c415543785ff973",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20033"
      ]
    },
    {
      "uid": "zhcn:ee94cd129963948ef8d101cd",
      "kind": "character_system_text",
      "source_text": "……嗯，如果能在奔跑中，\r\n找回状态就好了。\r\n是我的话，一定能做到！",
      "source_fingerprint": "82489b6bdff92520c0b662c64358f9fcb1006319a269e12263c6028b5cf72486",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20034"
      ]
    },
    {
      "uid": "zhcn:f81da58bda7a500c0c7804ba",
      "kind": "character_system_text",
      "source_text": "状态不好的时候，就看向老家的\r\n方向！……嗯，只要遵守这条英里规则，\r\n就一定……。",
      "source_fingerprint": "7e0b4e6e70f738de270264d5d8b9528cc1cf5c76ff7b1f444c98aafcb3adedfa",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20035"
      ]
    },
    {
      "uid": "zhcn:331ae59c2cbb2a6b5b744822",
      "kind": "character_system_text",
      "source_text": "……我的状态，\r\n我自己最清楚。不过……\r\n我绝不退让。唯独胜利！",
      "source_fingerprint": "de2f69deba9174522b0b5950cac0b428e7b7ff481b0ebecd83ccea71173db29a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20036"
      ]
    },
    {
      "uid": "zhcn:e7d6242aa8e0f60e16471b58",
      "kind": "character_system_text",
      "source_text": "……要成为真正的英里女王，\r\n就必须跨越难关。因为我，\r\n可是放声欢呼。",
      "source_fingerprint": "d30e04083e987d918337e6963f57730fbad0e838896f4f5dc83936bdccf6b95e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20037"
      ]
    },
    {
      "uid": "zhcn:6f393f04e6ad38cad6b2d795",
      "kind": "character_system_text",
      "source_text": "好嘞！",
      "source_fingerprint": "5b8624abed948d0e6a84b94335e1037decef0acf48c44155fdd86e0f5fcff33b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20038"
      ]
    },
    {
      "uid": "zhcn:b2694c0879e5ff61f4b625df",
      "kind": "character_system_text",
      "source_text": "哈！",
      "source_fingerprint": "fc0501efee4b0f3383bb7aec7aad844316d4c933d1bdf46490754f5510264817",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20039"
      ]
    },
    {
      "uid": "zhcn:3591fb11a0d72d60bcafd73c",
      "kind": "character_system_text",
      "source_text": "英里跑者！！",
      "source_fingerprint": "5f59aaa55d948b1481162cc11ade4a274d76b07e5de2f7947e7ca2b3db930257",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20040"
      ]
    },
    {
      "uid": "zhcn:ce97ea922f24c263f52bd5db",
      "kind": "character_system_text",
      "source_text": "嗯嗯。",
      "source_fingerprint": "c0dad597dc82a31dd69060476ba8d5a0bc081bd7005ed6641f89ca6ade33857a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20041"
      ]
    },
    {
      "uid": "zhcn:ea60e6e8f877f1c8796b615c",
      "kind": "character_system_text",
      "source_text": "咦？",
      "source_fingerprint": "86da1b53b8e9030921223d1116840eec3ad77bbe410b4f3802da0abd63a8d247",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20042"
      ]
    },
    {
      "uid": "zhcn:82455c78df85dd0f6d668851",
      "kind": "character_system_text",
      "source_text": "唔……。",
      "source_fingerprint": "041ba8b8603a00b4e44cd331a21ab7fd8b9ea6dc6184c6a547b16419da56322f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20043"
      ]
    },
    {
      "uid": "zhcn:a3eae5353b3f88e5ae6bbaf9",
      "kind": "character_system_text",
      "source_text": "走吧！",
      "source_fingerprint": "92ae3e5dcae9a53056d19b3106de1996e8c400c410dfd1c96cb651012cfebc4c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20046"
      ]
    },
    {
      "uid": "zhcn:209a1466d03f76625b7ad362",
      "kind": "character_system_text",
      "source_text": "大海！",
      "source_fingerprint": "d3f916e4f827fbc0b13ecf7fa48468de755eefe3c14c315647bc4aa1fd818be1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20047"
      ]
    },
    {
      "uid": "zhcn:99ff5d2cbc0ba59299b12956",
      "kind": "character_system_text",
      "source_text": "100英里的感谢，献给训练员！",
      "source_fingerprint": "5edf9dbdaf343c78aec82cf8be824ef349898e2419b8188f9d79721df8bde4d9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20049"
      ]
    },
    {
      "uid": "zhcn:89057c399ee4ce502f27073d",
      "kind": "character_system_text",
      "source_text": "谢谢你，与我一同追逐梦想！",
      "source_fingerprint": "83cf16dd8057fb86874c80bdda43b429ec5bb96379b1776f9e984c6f5c5608ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20050"
      ]
    },
    {
      "uid": "zhcn:10ad704e361d9fdd7ecd7c4b",
      "kind": "character_system_text",
      "source_text": "多少英里都没问题！",
      "source_fingerprint": "005d95586fbcfdde6048601aa59415eb57f6ec5a14995f15e75089dbbab40044",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "20051"
      ]
    },
    {
      "uid": "zhcn:311fc8d0e25f0438ee164b65",
      "kind": "character_system_text",
      "source_text": "来，去赢下比赛！",
      "source_fingerprint": "1577dd77e575ab25a3d8e70ad9a0d219fb75f8c7467372878632d31d35e2e48f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "2030"
      ]
    },
    {
      "uid": "zhcn:2c06f53769b74d65ebdfd603",
      "kind": "character_system_text",
      "source_text": "目标是，全英里制霸！",
      "source_fingerprint": "fc128abde14a89511d73a5feb7310e0c8b9e296c8b85a55ae4e2fbec4817ecae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "2031"
      ]
    },
    {
      "uid": "zhcn:b4e7af3dce91ef4e0dcf60c1",
      "kind": "character_system_text",
      "source_text": "谢谢你，与我一同追逐梦想！",
      "source_fingerprint": "83cf16dd8057fb86874c80bdda43b429ec5bb96379b1776f9e984c6f5c5608ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "2032"
      ]
    },
    {
      "uid": "zhcn:d8fa60eab7cf84a094d775bc",
      "kind": "character_system_text",
      "source_text": "状态好的时候更要，想想比赛后的\r\n沙拉！这正是，\r\n为了胜利的英里规则！",
      "source_fingerprint": "c1e7ff29433a301f3e67a3a6d66c261ef4f04164ee103e102ffa35e2599a5b7a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "2033"
      ]
    },
    {
      "uid": "zhcn:80ea2366ba8278c88fa8aaa0",
      "kind": "character_system_text",
      "source_text": "训练员！请好好\r\n看着哦？看我，\r\n会拉开多少身位。",
      "source_fingerprint": "61c650401c8de16a8e296f87dc134932510b78be3b0bdc348f08448177b32c72",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "2034"
      ]
    },
    {
      "uid": "zhcn:e376f271621bd51dbfff5586",
      "kind": "character_system_text",
      "source_text": "谢谢你，与我一同追逐梦想！",
      "source_fingerprint": "83cf16dd8057fb86874c80bdda43b429ec5bb96379b1776f9e984c6f5c5608ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "2035"
      ]
    },
    {
      "uid": "zhcn:1a7b8d56d9f4c2325f92001e",
      "kind": "character_system_text",
      "source_text": "好嘞！",
      "source_fingerprint": "5b8624abed948d0e6a84b94335e1037decef0acf48c44155fdd86e0f5fcff33b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "23015"
      ]
    },
    {
      "uid": "zhcn:13dbf876ebcf2f6d40f1ec0f",
      "kind": "character_system_text",
      "source_text": "……下次英里赛，可不会让给你！",
      "source_fingerprint": "36b46861148be1be49dbf8ec35292240ee028f63dba51664d91fa53207fdceca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "30000"
      ]
    },
    {
      "uid": "zhcn:35354f19b63bb46346f95787",
      "kind": "character_system_text",
      "source_text": "……得重新锻炼！再多练些！",
      "source_fingerprint": "28a091bb300df116afb8ad16387c8f03905929d30c42de44296d644ab91e298e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "30001"
      ]
    },
    {
      "uid": "zhcn:eea19d9d622006c6ccdf1a09",
      "kind": "character_system_text",
      "source_text": "……还远远不够！得追求更高处！",
      "source_fingerprint": "20631d10e10bb8064bab976094f4dc4c286c962d4d5cc628ad13f3991151db2a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "30002"
      ]
    },
    {
      "uid": "zhcn:7f968751ca1b93644ea6b294",
      "kind": "character_system_text",
      "source_text": "……回去后，至少得跑10英里！",
      "source_fingerprint": "e6266b7c8edc371c9f330a057c7de8a331a0c4b29bf0ab15d852e239a81efdd2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "30003"
      ]
    },
    {
      "uid": "zhcn:d02bc5ba006290eced02252d",
      "kind": "character_system_text",
      "source_text": "证明给你们看了吗？\r\n我不会输，只要是英里赛！",
      "source_fingerprint": "d62d594d6477a36a7003c365d2d6512b67d5b0e43895d4143c92301a226ae91b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "30004"
      ]
    },
    {
      "uid": "zhcn:0c2956596e5664bfbb89dea1",
      "kind": "character_system_text",
      "source_text": "嘿嘿，理所当然。\r\n因为我是最强英里跑者！",
      "source_fingerprint": "547a9baf09c0f526689bbdaeb5f374e533462aee3bf9fb7dd2f3fe2747ef0e68",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "30005"
      ]
    },
    {
      "uid": "zhcn:e0df803dcd38bffb4f6e6fed",
      "kind": "character_system_text",
      "source_text": "干劲100英里！",
      "source_fingerprint": "ed1206f22550be4673af7d389ce6437b056ed0318b53c506bee040b6b49049b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "31000"
      ]
    },
    {
      "uid": "zhcn:3bdf0ce23292b3ecf29d7509",
      "kind": "character_system_text",
      "source_text": "英里赛不会让给你。绝对！",
      "source_fingerprint": "1cb5a5e6d572e7fed722b5db3bbf59216ef6ee786c1e178e5cd07d542bc0cbea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "40000"
      ]
    },
    {
      "uid": "zhcn:d631d90e979134d33864a505",
      "kind": "character_system_text",
      "source_text": "呵呵呵……我和光钻同学已经想好\r\n对策了！拍照前用力闭一下眼睛\r\n……就不会拍成半闭眼了！",
      "source_fingerprint": "82ec2c989f3c6c1e6909a4cf4a2c73d93634a820de0185fc197ec96c497ffb5e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "400002"
      ]
    },
    {
      "uid": "zhcn:9be52192aa91094b5f754141",
      "kind": "character_system_text",
      "source_text": "……即使三种距离也能称霸。\r\n想跨越的事物，都能跨越。\r\n只要我始终，还是我！",
      "source_fingerprint": "1fa3f14708b840e8689156492c6ef9b8d255acd8fe536cae3030019b4087f48f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "400006"
      ]
    },
    {
      "uid": "zhcn:669fe8a7b6ccd66bc004ef13",
      "kind": "character_system_text",
      "source_text": "英里才是我的舞台！强大的对手也好，\r\n快速的对手也好，劲敌也好，我要把大家都超越――\r\n成为，英里女王！",
      "source_fingerprint": "8ed1ff8984e909e2bf2ccc33644ae8c63f82e7ddcaa057aec93a65fe8304fdd2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "40001"
      ]
    },
    {
      "uid": "zhcn:0102a0ea79047c95f8fee253",
      "kind": "character_system_text",
      "source_text": "上啦",
      "source_fingerprint": "25a9ca7fc07775b6f337dde3e4caee9a21bd44b7c35b63b4f8a411502172a58c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "410000"
      ]
    },
    {
      "uid": "zhcn:d811b850f4f68c4ff6ab4806",
      "kind": "character_system_text",
      "source_text": "太好了！！",
      "source_fingerprint": "3d2c49b5691bc61adacb34d430f2a295bfaa1b61231cad41e87aaa8baf3a7cf4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "410001"
      ]
    },
    {
      "uid": "zhcn:b57fb692bf339d05fa48d21b",
      "kind": "character_system_text",
      "source_text": "真不错",
      "source_fingerprint": "f592c345f7fb3d579e737a4de8a673f78f26ae30ef76a19fd37dea242e0330b6",
      "source_path": "character_system_text_dict.json",
