      ]
    },
    {
      "uid": "zhcn:cbd596c221552bf17cad0063",
      "kind": "character_system_text",
      "source_text": "我很喜欢它让人能灵活行动！",
      "source_fingerprint": "b96fcb65db073efcaa226ff5b251f20bf6ef8719b0700646dff0ad4adca0e394",
      "source_path": "character_system_text_dict.json",
