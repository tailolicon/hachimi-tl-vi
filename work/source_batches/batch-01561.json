  "entries": [
    {
      "uid": "zhcn:30b583f677f4f32059bc625d",
      "kind": "character_system_text",
      "source_text": "请看，这缎带上的装饰。\r\n明丽的金芒乃是纯洁的光辉……\r\n在商店里我一眼便相中了呢♪",
      "source_fingerprint": "3e69858a44a6e232cd78cb3a69ae38a8f02e699a20d812be5a27600da4011412",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "10026"
      ]
    },
    {
      "uid": "zhcn:c1007dfda0348827a2e398b3",
      "kind": "character_system_text",
      "source_text": "休息日我都会手洗衣物。\r\n在专注洗净污渍的过程中，\r\n心中的杂念沉渣也能一并涤除。",
      "source_fingerprint": "a70d5c75a75e89a53817e771a7fa5508f9928ffbdf43649061633a2df710114c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "10027"
      ]
    },
    {
      "uid": "zhcn:a2a2282c364e07ae00992f7a",
      "kind": "character_system_text",
      "source_text": "均衡并未打破……",
      "source_fingerprint": "57ef408d5854306431c451741bfc638c01becabae64a42dc0a4ae453d9cb9572",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1003"
      ]
    },
    {
      "uid": "zhcn:9989ec5b9286f9ae32ae1649",
      "kind": "character_system_text",
      "source_text": "衷心献上祝福！",
      "source_fingerprint": "71942f2c1de2b9222db11abc4cf438750d19b9d7d412ddcb99e6983022ba471b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1004"
      ]
    },
    {
      "uid": "zhcn:91d9c253ac338d0e61d63995",
      "kind": "character_system_text",
      "source_text": "当下当经受试炼……",
      "source_fingerprint": "8239cfada974a71e05fd8300104b65db6dff528ca6f20ed282a0fcbb4f44f4ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1005"
      ]
    },
    {
      "uid": "zhcn:f01ff66505cd2e8b3a2c2eb9",
      "kind": "character_system_text",
      "source_text": "均衡并未打破……",
      "source_fingerprint": "57ef408d5854306431c451741bfc638c01becabae64a42dc0a4ae453d9cb9572",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1006"
      ]
    },
    {
      "uid": "zhcn:ef5a01bc4a5481a8bc26c14d",
      "kind": "character_system_text",
      "source_text": "迈向全新境界！",
      "source_fingerprint": "8181202ae17db822d34bd9490cbb2a98be60c9f2bc4f7b2a2b8ded4a775e0b19",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1007"
      ]
    },
    {
      "uid": "zhcn:f927ec85ca33797ece43c6d3",
      "kind": "character_system_text",
      "source_text": "朝着崭新的世界。",
      "source_fingerprint": "5acddbc10f4831edfaee510df0a3d75935d13135bf8c399856f69f507c7f5db3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1008"
      ]
    },
    {
      "uid": "zhcn:14037679bec5ebe38fe05107",
      "kind": "character_system_text",
      "source_text": "Cygames",
      "source_fingerprint": "70f9f2ba202c631078563014e7f2f960d547e1d0cd4d1c18319f102cf5a87fcb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "11"
      ]
    },
    {
      "uid": "zhcn:3de7ff97db4c0216ecac1cfe",
      "kind": "character_system_text",
      "source_text": "投身于锻炼之中吧。\r\n为了通往真正的圣女之路。",
      "source_fingerprint": "55637fc9251cecb9cd44bc2878f891c8efa55edbb77e323801b89647569b5c8a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "110000"
      ]
    },
    {
      "uid": "zhcn:966434534004b7252e47ba2a",
      "kind": "character_system_text",
      "source_text": "这莫非是……新的教义……！\r\n真是耐人寻味！",
      "source_fingerprint": "b30cea8a063e69b6c8c19f5a602015be620e2e9632c9418b48b962f69303e849",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "110001"
      ]
    },
    {
      "uid": "zhcn:339f9b3996d25197cc6426a3",
      "kind": "character_system_text",
      "source_text": "是要去迎战相争竞逐的宿命呢。\r\n让我们一同前往吧！",
      "source_fingerprint": "2db15c5597df930a3bb3433f495d5d4b8e136b366ea76dbc52570d093f73fdc2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "110002"
      ]
    },
    {
      "uid": "zhcn:1d1a3e5f2ecd5d2a59b5934c",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby",
      "source_fingerprint": "0fb57ac68b66f1546f9801f5aaf6a725ec4388807ec83792fcbb5cebd8d3fbba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "12"
      ]
    },
    {
      "uid": "zhcn:109df037e6b4a47b664e598e",
      "kind": "character_system_text",
      "source_text": "蒙受恩宠了……！",
      "source_fingerprint": "baa6f46525e99056bca2662558d88467bcd6a30707b33d79cef52e3e58a1ac55",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "120000"
      ]
    },
    {
      "uid": "zhcn:d96dbb2918429e5bfe9df2f9",
      "kind": "character_system_text",
      "source_text": "请指引我吧！",
      "source_fingerprint": "43ceed5818ee3950016418438bbeda3cd0753cf70587f36ffd642f4c265c4a42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1268"
      ]
    },
    {
      "uid": "zhcn:e6b84619c562effbf857d35c",
      "kind": "character_system_text",
      "source_text": "赐予我神圣之力。",
      "source_fingerprint": "d96858a81f757d475838466f49e5d9e0930787f342712e9d92bfacd1e936d3b1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "1269"
      ]
    },
    {
      "uid": "zhcn:16dcff0d5c1a48a1d5cabf24",
      "kind": "character_system_text",
      "source_text": "这是登录奖励。\r\n感谢这份恩惠。",
      "source_fingerprint": "f0537a818f84b06f9ad53756206deb8d35c9aba82fc77c9ad99d4d80e5bde5ec",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "13"
      ]
    },
    {
      "uid": "zhcn:b96841df161fca9f2fed34c2",
      "kind": "character_system_text",
      "source_text": "就由我来拯救大家吧。",
      "source_fingerprint": "7d576f223aef863878d63e48c3c7822afb5a403f72fd51053db7427c4fd22680",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140000"
      ]
    },
    {
      "uid": "zhcn:eeba6b169116f59b21c4e828",
      "kind": "character_system_text",
      "source_text": "精彩绝伦。",
      "source_fingerprint": "2bd22029f2fedbdfb64b116b941c24c10c78717d30ee7fb325e4059d4519a91d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140001"
      ]
    },
    {
      "uid": "zhcn:61c663df9efef07f1c371a16",
      "kind": "character_system_text",
      "source_text": "祈祷未能传达……",
      "source_fingerprint": "570832da43b9f65067f82fa2b207238d8e554937ab2ea300837deac27736a790",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140002"
      ]
    },
    {
      "uid": "zhcn:504f8bf14323ceaa305d1764",
      "kind": "character_system_text",
      "source_text": "感谢这份恩惠♪",
      "source_fingerprint": "5f8d9235cc707aa406a1d0b91183a59fa094aecb9bec91edf59638988fea3fe8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140003"
      ]
    },
    {
      "uid": "zhcn:bbdf5d6dbfbf68bede97b25b",
      "kind": "character_system_text",
      "source_text": "引路极佳。",
      "source_fingerprint": "102fd20b1ca11c6e02d9e211d70c070e5f1dfd49a572439cd30554f0475c110b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140004"
      ]
    },
    {
      "uid": "zhcn:92e54e8378cf8a70b64fbc2d",
      "kind": "character_system_text",
      "source_text": "这不过是时运使然。",
      "source_fingerprint": "b1985468acbb9da04828dbaf28ee667b9b4b051b96aa12ddf3d240f650f493e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140005"
      ]
    },
    {
      "uid": "zhcn:540b9c0a15c4d8657fb4fbca",
      "kind": "character_system_text",
      "source_text": "感谢这份恩惠♪",
      "source_fingerprint": "5f8d9235cc707aa406a1d0b91183a59fa094aecb9bec91edf59638988fea3fe8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140006"
      ]
    },
    {
      "uid": "zhcn:360e5d7aff7af1ba71f495fa",
      "kind": "character_system_text",
      "source_text": "引路极佳。",
      "source_fingerprint": "102fd20b1ca11c6e02d9e211d70c070e5f1dfd49a572439cd30554f0475c110b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140007"
      ]
    },
    {
      "uid": "zhcn:fe1af18c519cf28b6cb3c2a6",
      "kind": "character_system_text",
      "source_text": "呵呵呵。",
      "source_fingerprint": "414ae427217adea7b80c6d9166bb6ebc72df2f6b1b370616339ff4156cfba39e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140008"
      ]
    },
    {
      "uid": "zhcn:d7ee436121590225a04bef2a",
      "kind": "character_system_text",
      "source_text": "让我们祈祷吧。",
      "source_fingerprint": "9c68ee8d34f6d9cc25b8b577ea60d2410f6fd4c20dc98e4d7bdc9ed8ec6d60dd",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140009"
      ]
    },
    {
      "uid": "zhcn:ef6ba460b44479984d9eddf4",
      "kind": "character_system_text",
      "source_text": "没事的哦。",
      "source_fingerprint": "da483537116a619e5b6c6470c6295f9c526fb21cad9523e1a10e9464c37066ff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140010"
      ]
    },
    {
      "uid": "zhcn:af2b36faedb636dbf0d6bf34",
      "kind": "character_system_text",
      "source_text": "简直是奇迹……！",
      "source_fingerprint": "007e40ec40e8b8ac829fceccad0e654d2f3cf04c90edcf17b72911db68a093a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140011"
      ]
    },
    {
      "uid": "zhcn:e55907d6f88c07e671a9141e",
      "kind": "character_system_text",
      "source_text": "注入心愿！",
      "source_fingerprint": "b7a229900eaf3ef233e3a7e0a5a38d9b867febf140b7b1e992f64b38de4d9166",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140012"
      ]
    },
    {
      "uid": "zhcn:62d5f683629e1d247bf87473",
      "kind": "character_system_text",
      "source_text": "坚信不疑吧。",
      "source_fingerprint": "d4e29b288e76a9dc71fe4fe7f61d093ca1196015f212db2ae18c62973e5a2511",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140013"
      ]
    },
    {
      "uid": "zhcn:9394b2f2e8e4b5ef7c7f3d0d",
      "kind": "character_system_text",
      "source_text": "救赎之手……",
      "source_fingerprint": "129fdf1b3a16264c1ee39ddc258cb5a5f8dc80ecdddf218b493388985d24b45d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140014"
      ]
    },
    {
      "uid": "zhcn:8d996710a3024480dad9dc5a",
      "kind": "character_system_text",
      "source_text": "那么……！",
      "source_fingerprint": "e6fe24f2f3c66352ab4820d461f8273d7fe5237e93a7f8a467fc486ca20c2ca9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140015"
      ]
    },
    {
      "uid": "zhcn:1bf745adb0d7540303357a9e",
      "kind": "character_system_text",
      "source_text": "您正在集中精神吗？",
      "source_fingerprint": "0ec9a8d6831c814fdd162513aba952b8178edf7800b63dd3d83b8cab0a442c65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140016"
      ]
    },
    {
      "uid": "zhcn:d10f3ff74d3bd8346a2c0c11",
      "kind": "character_system_text",
      "source_text": "怎会如此……！",
      "source_fingerprint": "9b6eb4ab495bf7bc925f68b73b6edb9ee16551f5c3964a4f39073ea1761b8ded",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140017"
      ]
    },
    {
      "uid": "zhcn:cba95102100efd41c4f1ac1b",
      "kind": "character_system_text",
      "source_text": "来日方长……",
      "source_fingerprint": "ff578add2eeb1db5d0650a79a282a68e0719039e5187f463a54a5dcf75c12b5d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140018"
      ]
    },
    {
      "uid": "zhcn:9fcc8c9e399c2e17eebd0500",
      "kind": "character_system_text",
      "source_text": "明日亦可获赐此物。",
      "source_fingerprint": "50a61c3db53ad30f9cfc821ae82a4e2101bfa103fb2590ad1bcb16a7f196a492",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "15"
      ]
    },
    {
      "uid": "zhcn:5a5dcffa349184e942f7ff6b",
      "kind": "character_system_text",
      "source_text": "唔……这也是试炼，\r\n我必能跨越给您看……呜呜。",
      "source_fingerprint": "a8b1b644a88d786fb24cb7551a6d7218f9f7062a0d93a6e57d57273f37ff935d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20000"
      ]
    },
    {
      "uid": "zhcn:0c508970d63d639eb78c9943",
      "kind": "character_system_text",
      "source_text": "哦……深渊正在向我招手……！\r\n必须献上祈求康复的祷告……",
      "source_fingerprint": "bf4032ea9c1a694ca7416c4d42ca8c763c0d78f369a13e2a19e8d58d1dcef182",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20001"
      ]
    },
    {
      "uid": "zhcn:806b8b02e700c60ec351e08e",
      "kind": "character_system_text",
      "source_text": "此身充盈着祝福之光，\r\n即便超乎常理的特训亦不足为惧。\r\n任何使命我皆坦然受领！",
      "source_fingerprint": "3c6ede9388601b94e89aa9b6af0f2bfa273235db6ff63d1b4c33487a2d677caf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20002"
      ]
    },
    {
      "uid": "zhcn:f95ac8fdc87e12b6866312e6",
      "kind": "character_system_text",
      "source_text": "肥沃的大地啊。澄澈的天空啊——\r\n凭借获赐的庞大玛娜，\r\n纯洁之身必将开辟崭新境界！",
      "source_fingerprint": "b1f96fb86d55331e248cb557b0ec482c4e65d5680adeda2861356789d4bca742",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20003"
      ]
    },
    {
      "uid": "zhcn:60f70d0e2c9c3f8475b99675",
      "kind": "character_system_text",
      "source_text": "无须迷茫。\r\n您所选择的道路正熠熠生辉，一切\r\n都通向那片朗朗无云的峰顶。",
      "source_fingerprint": "7eca44a2d5dcba0517663f038d4be21f4923d1c9644d4d3bd41bb7db6eb51b42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20004"
      ]
    },
    {
      "uid": "zhcn:b898dcf2173157457c5f016a",
      "kind": "character_system_text",
      "source_text": "是要奔跑？还是要研学？\r\n必须抓紧时机，挑战试炼！",
      "source_fingerprint": "31c81e76cae3bda5e0067f9d26f51277627c2190c243664ef541d085ef0ccfc0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20005"
      ]
    },
    {
      "uid": "zhcn:dae46d370b3ae08d30463f0b",
      "kind": "character_system_text",
      "source_text": "“那片圣地”尚在遥远彼方，前路荆棘密布。\r\n然而只要迈步向前便能逐渐接近。\r\n让我们心无旁骛地朝它前行吧。",
      "source_fingerprint": "dbab77474289a12892188485260df816d05e68f33c2115d03bf94a557d077cb1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20006"
      ]
    },
    {
      "uid": "zhcn:2137cb73534332d7c2a3934a",
      "kind": "character_system_text",
      "source_text": "面对您降下的试炼，\r\n我将倾尽身心、赌上一切去跨越。\r\n一切皆为成为真正的圣女。",
      "source_fingerprint": "74c4936646a0f92319fa56e69e1096629b8895ad7cc7903d0ec852e8229a8da4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20007"
      ]
    },
    {
      "uid": "zhcn:195d5cf07891711dbb80a8a2",
      "kind": "character_system_text",
      "source_text": "此处已为地狱……正伫立于渊薮之畔。\r\n为了不偏离正道，\r\n请多加小心前进吧……",
      "source_fingerprint": "3eedb0d5454adc8f3e323db2cfc3373a880ae4757dc5e1ebdd39dc7880cf579e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20008"
      ]
    },
    {
      "uid": "zhcn:3d52868a119c606d851e3ec2",
      "kind": "character_system_text",
      "source_text": "唔……必须聚集玛娜。\r\n寄托微茫的希冀，献上祈祷……！",
      "source_fingerprint": "83f0ec5470d6b53dc626fecf530f3e8fc20d4d39b5e2ac7b460e0324e7080d0a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20009"
      ]
    },
    {
      "uid": "zhcn:63cca31282ef33d130fe23f3",
      "kind": "character_system_text",
      "source_text": "噫！有股邪气在背上爬……！\n…咦，只是一片树叶啊…哈啊…",
      "source_fingerprint": "058064ad242600c43c584ce8fb35717c46acf7c88ac1eaa37cb85f7fbe6bb2c4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20010"
      ]
    },
    {
      "uid": "zhcn:1b8ee9dfad0587722e2f4937",
      "kind": "character_system_text",
      "source_text": "呜呜……竟然没收拾房间\r\n就跑出来了……\r\n我已经……堕入黑暗了……",
      "source_fingerprint": "0a153202df96862aafb0f7d4845d5ab661d16360080b33a9e754ec4f86adf3ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20011"
      ]
    },
    {
      "uid": "zhcn:6201b3edea7c24bc9b50c977",
      "kind": "character_system_text",
      "source_text": "心魔正试图乘虚而入……\r\n请务必赐予我祈祷的时间，\r\n让我从赛事中休歇片刻吧……",
      "source_fingerprint": "7001dd991d254156366d1cef33107e8c8064770491e2a9b982631f60dcb56541",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20021"
      ]
    },
    {
      "uid": "zhcn:71a41b57f5a24ee63dfdc8a6",
      "kind": "character_system_text",
      "source_text": "请赐予我休歇吧。趁着天怒、\r\n地裂、海啸肆虐之前……",
      "source_fingerprint": "a15e3f43dfefc8f1ac37573adbd90c38cb38ab5d4305e6025ee62622e64af81b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20022"
      ]
    },
    {
      "uid": "zhcn:0ba7fd955e494ad64681d4b7",
      "kind": "character_system_text",
      "source_text": "这正是天赐的加护，光之祝福！\r\n若是此刻，我仿佛能随心所欲地\r\n救赎万物！",
      "source_fingerprint": "1eaf785282224ededa70bcac60d88d178ce86502583e3c291bc0e30e9ce96cc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20023"
      ]
    },
    {
      "uid": "zhcn:e4ffc35e186bad9e2419b713",
      "kind": "character_system_text",
      "source_text": "我将点亮世间所有人心中的灯火。\r\n驱散黑暗，照亮遥远彼方的\r\n神圣之火！",
      "source_fingerprint": "50ebc3d70d8bcd19fafb05eba58779ffaf0e5d67773013bb556ed4db51cda9a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20024"
      ]
    },
    {
      "uid": "zhcn:25e364c6f842e83c38d35c15",
      "kind": "character_system_text",
      "source_text": "哦，看到了！我看到了！\r\n那道指引我们通往荣耀的命运之光！\r\n来吧，让我们同行！",
      "source_fingerprint": "1708e42410a24f0f35fe2600eeffbdcc5da7d372972efe5a356c937bba749f2b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20025"
      ]
    },
    {
      "uid": "zhcn:da5e73bfae8b5f74be482498",
      "kind": "character_system_text",
      "source_text": "此身与此心，皆蒙玛娜加护。\r\n余下的，唯有顺从信念，\r\n向渴求的心愿伸出手去！",
      "source_fingerprint": "494fca68a59f8e2a2b02e33267855abc9342bb9e99352079fa711569097485c1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20026"
      ]
    },
    {
      "uid": "zhcn:dda7a947bd79522004391259",
      "kind": "character_system_text",
      "source_text": "得益于您的助力，我已克服了\r\n无数的试炼。\r\n今天，我将向您奉上这份成果！",
      "source_fingerprint": "9fa911b462d5004c5c3b192586b85a9d7614b247c1473e7e27e40e44ee1d13fe",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20027"
      ]
    },
    {
      "uid": "zhcn:3ce41c5f5b175e25558c4b40",
      "kind": "character_system_text",
      "source_text": "训练员，\r\n请安心见证吧。\r\n我所踏上的这条光辉之途！",
      "source_fingerprint": "060886a85c7688a1c1c4d2a6aaec07abb9dd64eff0ebb4ef963da64eeb91686a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20028"
      ]
    },
    {
      "uid": "zhcn:cb330e8baa75c4b975f987d5",
      "kind": "character_system_text",
      "source_text": "赛事原本就是残酷的考验。\r\n正因如此，我也早已做好了\r\n以身相拼的觉悟。",
      "source_fingerprint": "2c8a835fbce18866bf5639b74771341e15853d746d60a6af66d99d6e000bb6ea",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20029"
      ]
    },
    {
      "uid": "zhcn:e68de30b60133ddab3cafc5f",
      "kind": "character_system_text",
      "source_text": "让我们祈祷所有人都能平安地\r\n结束这场战斗吧。\r\n因为再也没有比这更令人欣慰的事了。",
      "source_fingerprint": "54b23730a68a821dd86b472b43cd921899d24d72a3bb6140243548bcca11aef8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20030"
      ]
    },
    {
      "uid": "zhcn:71cf3167ed92f28ad92654d4",
      "kind": "character_system_text",
      "source_text": "请回顾一下走过的轨迹。\r\n过往的修行无可动摇。\r\n坚信希望，与我共同战斗吧。",
      "source_fingerprint": "cabe471beafee8b70509911f06c0de869e0ebdd0ca9c035fcdcbb8e5d0382a25",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20031"
      ]
    },
    {
      "uid": "zhcn:9303ab08e239af3fa68b28d0",
      "kind": "character_system_text",
      "source_text": "唔……好强的邪气……但是……！\r\n心中的阴霾，\r\n我必用神圣之光将其祓除……！",
      "source_fingerprint": "165723d2124d53dd927ff39205bb240904774ecbccaf31b02151ff000ad509d6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20032"
      ]
    },
    {
      "uid": "zhcn:eb87c848314d8ccb4dbdf15d",
      "kind": "character_system_text",
      "source_text": "苍天啊，您是让我在这场\r\n白日梦中继续前行吗……",
      "source_fingerprint": "d715f2c8eb235049cdda1e6b95cf2d8c4158649e47a5a5a83046c164afa24817",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20033"
      ]
    },
    {
      "uid": "zhcn:5ffdb178f5a654132b30cc14",
      "kind": "character_system_text",
      "source_text": "我绝不会屈服于戏言……\r\n折磨着我的恶魔低语啊，\r\n退散吧……！！",
      "source_fingerprint": "913881ff9988238c45ca020dd2e84ccd22f530ae1c97f527109a594c2b7e2890",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20034"
      ]
    },
    {
      "uid": "zhcn:49db3a119efba52656333339",
      "kind": "character_system_text",
      "source_text": "失去了精灵的加护，苍天的光辉亦已\r\n隐退。如今正该展现身为圣女的\r\n真正价值……！",
      "source_fingerprint": "53061cbdc973899e875e707bbcec83fe3d73b483653daeb7ffb0be81b24a79d4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20035"
      ]
    },
    {
      "uid": "zhcn:178fe87394f323c4726b5f41",
      "kind": "character_system_text",
      "source_text": "我的意志，绝不会就此被击碎。\r\n我反而要感谢这番困境与试炼，\r\n全力驰骋到底……！",
      "source_fingerprint": "114c5e64acc1175f8c41097a5fba13b73475013077d2c75ec0107f2d7b2663f4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20036"
      ]
    },
    {
      "uid": "zhcn:e5f1b3775358f3877197f8eb",
      "kind": "character_system_text",
      "source_text": "黑暗正笼罩着此身……然而，\r\n哪怕仅有一丝玛娜的火光也已足够。\r\n我将毫不迟疑，继续前进……！",
      "source_fingerprint": "14607124128467f10936b6607230b88ee2c8c684e85d31754bfe2e0dacc9c46d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20037"
      ]
    },
    {
      "uid": "zhcn:2fd4bbac0b600f219816e056",
      "kind": "character_system_text",
      "source_text": "那么。",
      "source_fingerprint": "639ec917f68ca8864ddb2ad4eb800eccca968da99504ad48a5e78de236d94f73",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20038"
      ]
    },
    {
      "uid": "zhcn:52007d99eba70632b02786f4",
      "kind": "character_system_text",
      "source_text": "我出发了。",
      "source_fingerprint": "874e7497e7be8367a4f334f4c7f1d69916bd93469660e8935829876ff0311191",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20039"
      ]
    },
    {
      "uid": "zhcn:efe950fbcdb2a89959296051",
      "kind": "character_system_text",
      "source_text": "请赐予指引。",
      "source_fingerprint": "7d1e8de04e9dda74dd5b039272e04d75d88b2acb8b222060bcf9c829020eed5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20040"
      ]
    },
    {
      "uid": "zhcn:54854109432d54596289ca04",
      "kind": "character_system_text",
      "source_text": "这是研习。",
      "source_fingerprint": "db1026f5db25f926b1c1f0ba6d907f682b0c4812201cee912e59b962e91523c5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20041"
      ]
    },
    {
      "uid": "zhcn:81a8bc9035b280e3c09c293e",
      "kind": "character_system_text",
      "source_text": "怎会如此……",
      "source_fingerprint": "e7a011901dab6c8bce33ed131001ab950a4522498e3dd417be02378b0da7cbe0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20042"
      ]
    },
    {
      "uid": "zhcn:2cab43e272731a91041a78bf",
      "kind": "character_system_text",
      "source_text": "哎呀……？",
      "source_fingerprint": "fdba625e48012ccb9ad71877721cc10414ee827e304b5a1a6b72f395d5735f23",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20043"
      ]
    },
    {
      "uid": "zhcn:fa60225bf4670754f9c4f37a",
      "kind": "character_system_text",
      "source_text": "让我们去巡访吧。",
      "source_fingerprint": "f069a999fab5852a9ce5129ce8c7facf21c2b8a9a86e6580ef72ca3bfa841565",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20046"
      ]
    },
    {
      "uid": "zhcn:cc87ede17e9ea2537e3bd5f7",
      "kind": "character_system_text",
      "source_text": "真是恩赐呢。",
      "source_fingerprint": "7cb825929486c047932d54bb1246ecaf5a9b01c3ef56594ed690869e3317b545",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20047"
      ]
    },
    {
      "uid": "zhcn:75aad1773c8a6af65f4a586f",
      "kind": "character_system_text",
      "source_text": "愿未来常伴祝福。",
      "source_fingerprint": "cdaedcd7c43336ff01c98c8107add079fa6d8b45a564db9f553eedc846cd417f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20049"
      ]
    },
    {
      "uid": "zhcn:ef55a3e379bc27bd4441ea5c",
      "kind": "character_system_text",
      "source_text": "我绝不会忘记您的教诲。",
      "source_fingerprint": "2df60054e1f676133d2463038688ef79f7a831945a6bec1b14b12d2fefc46988",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20050"
      ]
    },
    {
      "uid": "zhcn:c4896f04cb5868c87b8c3068",
      "kind": "character_system_text",
      "source_text": "将祝福献予您——",
      "source_fingerprint": "e7b0a404b38117afd90b2aac4d2e7980cdc18d90b1f08fe49e1da83bfcfd7739",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "20051"
      ]
    },
    {
      "uid": "zhcn:c777588a406667f988564673",
      "kind": "character_system_text",
      "source_text": "由我来施以救赎。",
      "source_fingerprint": "cf3f00d9ac6ccffb60c8e959aef24cc40813e8d4e84cccc96c66f0eca90a2273",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "2030"
      ]
    },
    {
      "uid": "zhcn:5334e401ab49a17a765dcdad",
      "kind": "character_system_text",
      "source_text": "朝着崭新的世界。",
      "source_fingerprint": "5acddbc10f4831edfaee510df0a3d75935d13135bf8c399856f69f507c7f5db3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "2031"
      ]
    },
    {
      "uid": "zhcn:37eec753a30ce51192c7d567",
      "kind": "character_system_text",
      "source_text": "我绝不会忘记您的教诲。",
      "source_fingerprint": "2df60054e1f676133d2463038688ef79f7a831945a6bec1b14b12d2fefc46988",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "2032"
      ]
    }
  ]
}
