      ]
    },
    {
      "uid": "zhcn:4965ed13b6c69e7c41fbef2d",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank_l1，秋季三冠达成！\n在秋季GⅠ战线取胜\n成功名垂青史！",
      "source_fingerprint": "1259aa439aa0e8a4f49a76d1df42c66d7dfafbcffb11fe5dab7ddbb9c7371097",
