      ]
    },
    {
      "uid": "zhcn:e10b58745a9a62f82c762107",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank_l1，精彩地达成了三冠！\n在这里，最强的赛马娘诞生了！",
      "source_fingerprint": "8559a33f6a630acfbf8f8b85ba10b2304135006497f07bee962104763276e491",
