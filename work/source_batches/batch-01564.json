    },
    {
      "uid": "zhcn:aa8e2e165de44b751cf1a5d3",
      "kind": "character_system_text",
      "source_text": "我要登顶……那无人能及的巅峰。",
      "source_fingerprint": "7c53a1d0c3fcf140a2601810222e2cc52fc6892110cdfee897a5ee7339f5f281",
      "source_path": "character_system_text_dict.json",
