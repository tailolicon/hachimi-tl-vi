      ]
    },
    {
      "uid": "zhcn:4403d398d6da9ccc5e3ec39d",
      "kind": "character_system_text",
      "source_text": "我要好好地，去宣传英里！",
      "source_fingerprint": "0a6a3cbb1294d37652330c5af2fee4a0694d7f7ee083dd9112796b64c8456e7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "60001"
      ]
    },
    {
      "uid": "zhcn:f9b46a57820089a11edd1870",
      "kind": "character_system_text",
      "source_text": "任何英里都交给我！",
      "source_fingerprint": "7e9f65008795bcde41a3ff1badadaab7322fb5e6dd635c04d4347ad350fcc76b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70000"
      ]
    },
    {
      "uid": "zhcn:78e5e068e1dc489d62472360",
      "kind": "character_system_text",
      "source_text": "那么符合我英里规则的人\r\n训练员还是第一个！\r\n……梦想，一起实现吧！一起！",
      "source_fingerprint": "c7d385f66470fd2eb313a39c2fe3bc0912d1da390fa38680e4052d0ed3033bd5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70001"
      ]
    },
    {
      "uid": "zhcn:ed38dd799fa40c9395548b0b",
      "kind": "character_system_text",
      "source_text": "制服无论何时，都要保持整洁利落！",
      "source_fingerprint": "786965f59ff3638d09d5356982d5cd6ae728a0f11ab210bb52b7e7ae402c884f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70004"
      ]
    },
    {
      "uid": "zhcn:2544c0fe81fd17291e3c4cc2",
      "kind": "character_system_text",
      "source_text": "在中央唱歌的模样，请看着哦？",
      "source_fingerprint": "8cf408a6bf5bd125384ac432cdaa4057dfb22fa45fdeb094041aef7a597b6d12",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70008"
      ]
    },
    {
      "uid": "zhcn:72f3b30c30b5b323f9c473f2",
      "kind": "character_system_text",
      "source_text": "怎么样？请尽情为我欢呼吧！",
      "source_fingerprint": "f99ce408141d2d3a32a0b6685e7dcc660e71047780a72982532c5f9216dcfe60",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70009"
      ]
    },
    {
      "uid": "zhcn:a1ef2e7befc87f2a796c8ec4",
      "kind": "character_system_text",
      "source_text": "在学校，真开心！大家也都是好孩子♪",
      "source_fingerprint": "38d71ac6be1b6353f019c84bd8b977f954100d9d7b75b4972a701a593b7018b2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70010"
      ]
    },
    {
      "uid": "zhcn:02a2a0623ca79b466f19075c",
      "kind": "character_system_text",
      "source_text": "下次要表演什么舞步，给大家看呢？",
      "source_fingerprint": "e178c8c1b00048710160615053eb4692c7eeaa56ad5f05a6f04bd147204912f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70014"
      ]
    },
    {
      "uid": "zhcn:5475a92df06e939b5d14e4bf",
      "kind": "character_system_text",
      "source_text": "其实是亲手做的！早安英里布贴！",
      "source_fingerprint": "d67af892e436659ce34e4644512d503d36a8be802298eb191d80045e0de0c581",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70015"
      ]
    },
    {
      "uid": "zhcn:7ccdff6ed304cd82c4c10367",
      "kind": "character_system_text",
      "source_text": "真棒！兴奋120英里☆",
      "source_fingerprint": "bc8df1bf18fcf3336f1df9aea86ae3e1ba95f3294d7759e2e829f7bc4fa0aec8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70018"
      ]
    },
    {
      "uid": "zhcn:e1224cf30204bc83f1bed915",
      "kind": "character_system_text",
      "source_text": "很适合我吧，这种风格也一样！",
      "source_fingerprint": "9a0c3b8911767a15ab752821295f001ee2a6a9c3b7017cf135300e2556d6b6b4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70019"
      ]
    },
    {
      "uid": "zhcn:cbd596c221552bf17cad0063",
      "kind": "character_system_text",
      "source_text": "我很喜欢它让人能灵活行动！",
      "source_fingerprint": "b96fcb65db073efcaa226ff5b251f20bf6ef8719b0700646dff0ad4adca0e394",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
        "70020"
      ]
    },
    {
