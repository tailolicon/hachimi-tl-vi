      "kind": "character_system_text",
      "source_text": "下次一起怎么样？两个人出去玩！",
      "source_fingerprint": "6e6c2356a62409db0c9224e58c8144f050356cb5e970c2538234df3872f2b54c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1131",
