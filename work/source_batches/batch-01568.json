      "kind": "character_system_text",
      "source_text": "期待有无限英里☆",
      "source_fingerprint": "33c5b75f0983dde42c12f4c82623dfdf30cba03e03082160e59d4aba2aba7f2d",
      "source_path": "character_system_text_dict.json",
