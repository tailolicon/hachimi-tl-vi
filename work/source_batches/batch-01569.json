      ]
    },
    {
      "uid": "zhcn:3d5f85f8d2eb3315bb5dca9d",
      "kind": "character_system_text",
      "source_text": "……呼呼。其实我和社区民商量过\n决定要为你举办生日直播啦！\n主角，就拜托了！",
      "source_fingerprint": "fd851e901b9c6ac753045dd5de9d3e67b7ec85ff2ec5c5deafb1339881a8e6e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
