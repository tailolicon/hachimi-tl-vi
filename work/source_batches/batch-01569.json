      ]
    },
    {
      "uid": "zhcn:45b1f51fdd2b4111e18fdbe0",
      "kind": "character_system_text",
      "source_text": "对于珍惜着一年间Love的人，\n作为奖励♪\n今天我来当你的圣诞老人哦♡",
      "source_fingerprint": "216a5675afe6fe992d43563c55787e6db5d5c5c6d2b6401c428e4ee8d162b7e9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
