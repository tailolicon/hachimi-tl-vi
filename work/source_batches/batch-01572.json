      ]
    },
    {
      "uid": "zhcn:2cb4ad8f2b92dbd05bbd7ce7",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank_ta1制霸了第二场比赛！\n她精彩的奔跑为团队带来了胜利！",
