      "json_path": [
        "3012"
      ]
    },
    {
      "uid": "zhcn:f26888eda2e6ace066580e80",
      "kind": "race_jikkyo_message",
      "source_text": "对决已接近尾声，第四场比赛！\n面向最后的舞台，能够取得好结果吗！",
