    {
      "uid": "zhcn:59cffb42dfb393e02666b1a5",
      "kind": "race_jikkyo_message",
      "source_text": "从艰苦的战斗中\n脱颖而出的是%h_rank_ta1！\n%h_rank_no1\n挑战将从这里开始！！！",
