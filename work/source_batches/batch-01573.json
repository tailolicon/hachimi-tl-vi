      ]
    },
    {
      "uid": "zhcn:b7eaf6e61cc750c00839c1fd",
      "kind": "race_jikkyo_message",
      "source_text": "赢得处女座的是\n%h_rank_ta1！\n在新赛季中，挑战白羊座吧！",
