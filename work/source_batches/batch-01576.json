    },
    {
      "uid": "zhcn:3e9f48221454e494811c8662",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank_a2%h_rank_to1\n纠缠着冲过了终点！",
      "source_fingerprint": "c73ed95f322263b46693722828f16b08bd3b48ec5dd565daca02a0576769d259",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
