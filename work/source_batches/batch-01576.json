      ]
    },
    {
      "uid": "zhcn:ccfab3d76cd60edb59efde43",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1\n%h_rank2追过来了\n两人并列冲线！",
      "source_fingerprint": "a5ebbee7e00e7500d3c9a6ee7a84575b1d190fc1a3a262c50459a8c1ac5f888b",
