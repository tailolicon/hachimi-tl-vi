      ]
    },
    {
      "uid": "zhcn:e8e9825b1c08d095d937b51c",
      "kind": "race_jikkyo_message",
      "source_text": "即将来到第四弯道转弯处",
      "source_fingerprint": "b54a9bb26b608751dd3995f01bbc975f9e9a29ad4563659c03866058c5de1297",
