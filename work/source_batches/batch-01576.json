      ]
    },
    {
      "uid": "zhcn:93737a78b54c1eddabaaee9c",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank_l1！　斩获了胜利！",
      "source_fingerprint": "e3acf4a61278b94d4594131a0ef09d7cf5245278685115e6e17acec57ea2ab96",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
