      ]
    },
    {
      "uid": "zhcn:707a78422c5e3bee6ff02cca",
      "kind": "race_jikkyo_message",
      "source_text": "从容的奔跑！\n她迅速甩开了对手\n保证了领先地位！",
      "source_fingerprint": "666edd0672d1b5a533c4269c582c407cbeddc3a0b0820e530712cf107888913b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "5015"
      ]
    },
    {
      "uid": "zhcn:17a2fa53677d42a480be834f",
      "kind": "race_jikkyo_message",
      "source_text": "从容的奔跑！\n第二名没能缩小与她的差距\n已经是压倒性胜利了！",
      "source_fingerprint": "65a2308aa03918f1bb431fb35122c5ae436a58bf9f49994ad747663b9aca1051",
