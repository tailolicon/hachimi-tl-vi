      ]
    },
    {
      "uid": "zhcn:3bed8d043013a82345f49705",
      "kind": "race_jikkyo_message",
      "source_text": "获胜的是%h_rank_ta1！\n她战胜了劲敌，\n成功取得了巨大的胜利！",
