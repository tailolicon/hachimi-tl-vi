    },
    {
      "uid": "zhcn:530532670b0259e2fa571c62",
      "kind": "race_jikkyo_message",
      "source_text": "前方依然是%a_h_rank1",
      "source_fingerprint": "db664a853773b1a80556cd9cf1084048b39ffac9b28efaac9f65376316d1624c",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "5008"
      ]
    },
    {
      "uid": "zhcn:39bcb663caecbe091341040e",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1，好强的脚力！",
      "source_fingerprint": "c8ee209375bb5fc44694390d7fc510ca5f046d8e066af44f6f85db1091a8cae7",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "5009"
      ]
    },
    {
      "uid": "zhcn:36a12d0ce9ff7e629fbecfd4",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank_a2%h_rank_to1\n两人并列冲线！",
      "source_fingerprint": "5d57f6385380374d3627864460a8142965e6987fcbd960ce895d99f4edcb7fc7",
      "source_path": "race_jikkyo_message_dict.json",
