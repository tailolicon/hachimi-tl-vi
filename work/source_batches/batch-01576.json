      "json_path": [
        "5019"
      ]
    },
    {
      "uid": "zhcn:97ed4e87b29569bcb503c9ce",
      "kind": "race_jikkyo_message",
      "source_text": "与未来相连的重要一战\n赛马娘将全身心投入比赛！",
      "source_fingerprint": "9bc2a0d0d17c826db91a388983dedb62d927a4997158829b9ea3abda199a0b93",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
