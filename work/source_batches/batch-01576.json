      "json_path": [
        "6357"
      ]
    },
    {
      "uid": "zhcn:0913db3d3a8800a9332527cc",
      "kind": "race_jikkyo_message",
      "source_text": "3人几乎同时冲线！\\n%h_rank1，冲线姿态略占优势吗！？",
      "source_fingerprint": "e526e58bb5f4f0fe76cbafd5c74a19244d3d4afaa071af030236f04665ff27ef",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6358"
