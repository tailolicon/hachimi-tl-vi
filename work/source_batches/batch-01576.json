      "json_path": [
        "6356"
      ]
    },
    {
      "uid": "zhcn:32a436a86b6a3361d60539a5",
      "kind": "race_jikkyo_message",
      "source_text": "3人并列冲线！！\\n%h_rank1，冲线姿态有微小的优势！？",
