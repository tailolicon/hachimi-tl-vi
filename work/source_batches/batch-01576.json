      ]
    },
    {
      "uid": "zhcn:3fb852149d0052a36ad762ba",
      "kind": "race_jikkyo_message",
      "source_text": "胜者是%h_rank_ta1！",
      "source_fingerprint": "bf386423b65ef0adb84d8a73997554d31f7991258877c493322538308b5ff24d",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
