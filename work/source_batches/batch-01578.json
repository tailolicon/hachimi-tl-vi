      "source_fingerprint": "007e40ec40e8b8ac829fceccad0e654d2f3cf04c90edcf17b72911db68a093a9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140011"
      ]
    },
