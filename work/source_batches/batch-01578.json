      "source_fingerprint": "b7a229900eaf3ef233e3a7e0a5a38d9b867febf140b7b1e992f64b38de4d9166",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1136",
        "140012"
      ]
    },
    {
      "uid": "zhcn:62d5f683629e1d247bf87473",
