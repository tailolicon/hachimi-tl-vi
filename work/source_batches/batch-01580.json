  "entries": [
    {
      "uid": "zhcn:6d85ee6d3010fea698d8a609",
      "kind": "race_jikkyo_message",
      "source_text": "神鹰太强了！\\n现在已经没人能跟得上她了！",
      "source_fingerprint": "ce77d6509fbfddd919bfd69c3d1a4b5892b6dc0e071a71e2d2a2cc5828c6020e",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6660"
      ]
    },
    {
      "uid": "zhcn:e562fa72c316092bd1f74582",
      "kind": "race_jikkyo_message",
      "source_text": "中山庆典来了！\\n中山庆典，现在终于到了梦想实现的时刻！",
      "source_fingerprint": "f662dffbf52c29ff1ea36b29896d8022985b5db6505729ac38b91fd9ed641e36",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6661"
      ]
    },
    {
      "uid": "zhcn:d521aa40289bef8bb776bd36",
      "kind": "race_jikkyo_message",
      "source_text": "我们的赛马娘从外道追上来了！\\n是日本的黄金巨匠！",
      "source_fingerprint": "35f649bccdf87ab25e6dc26c7d699e98b6daa65ee14fe9d357bd830b13236fe2",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6662"
      ]
    },
    {
      "uid": "zhcn:515dc701a446642473245368",
      "kind": "race_jikkyo_message",
      "source_text": "通向顶点的最后几步！\\n还剩400m！",
      "source_fingerprint": "3b0562d12bc5520d251e1a64d4e1346d02f4560e5c23d0a9b902cd6d77c7abb0",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6663"
      ]
    },
    {
      "uid": "zhcn:c9ee0faf1813434086d87f24",
      "kind": "race_jikkyo_message",
      "source_text": "距离最高的荣誉现还剩200m！",
      "source_fingerprint": "a6d7902efe0ef3be2b219ded1c0585e9e8983f27e2f2dc2be6735bf13aa99f4f",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6664"
      ]
    },
    {
      "uid": "zhcn:0212bd972c9a482bb788f8cd",
      "kind": "race_jikkyo_message",
      "source_text": "在看台的欢呼声中，\\n各赛马娘一齐冲了出去！\\n现在开始！　凯旋门赏！",
      "source_fingerprint": "df591b2b06bd28d39ade8e5f44c1835b811363c6d68bd69adcd28f49d5fc4089",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6665"
      ]
    },
    {
      "uid": "zhcn:90702ef9f57c096c1588df63",
      "kind": "race_jikkyo_message",
      "source_text": "脱颖而出的是%h_rank_ta1！　日本的希望！\\n但是后方仍在紧追！",
      "source_fingerprint": "05ad9ac1e6be3fb70346b3ef2f1efc26f28a81c574f59778e78745db45b492c1",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6666"
      ]
    },
    {
      "uid": "zhcn:8ef0543c9495b77f7ff6d6c1",
      "kind": "race_jikkyo_message",
      "source_text": "%horse_ta1从内道开始加速！\\n她能打破世界的障壁吗！",
      "source_fingerprint": "078f7b76437738edc970f359034611bba474872a27702742b01313da5e677eee",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6667"
      ]
    },
    {
      "uid": "zhcn:da893779f4a7ec15b9eef988",
      "kind": "race_jikkyo_message",
      "source_text": "%horse_ta1开始行动了！\\n日本的赛马娘飞奔而来！　",
      "source_fingerprint": "7554465b4600ffe18650f2781fa26515310a0da04bd603e0ba36fc3592d86f94",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6668"
      ]
    },
    {
      "uid": "zhcn:a9090930a815ebad1a3eb10c",
      "kind": "race_jikkyo_message",
      "source_text": "从外侧冲上来的是%horse_ta1！\\n这就是属于日本的潜力！",
      "source_fingerprint": "7ff849ac651f4b6b0230d08c7b711e4aa050e7a7a5316466d13f25745735161a",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6669"
      ]
    },
    {
      "uid": "zhcn:7ac06371fdff969ff872dd51",
      "kind": "race_jikkyo_message",
      "source_text": "%horse_ta1从最外道一口气冲了过来！\\n冲啊！　%horse1！\\n会就这样获胜吗！",
      "source_fingerprint": "417d8d0c5ae987c7ea115717019566a275682415419c7e4e2100af3c4155f172",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6670"
      ]
    },
    {
      "uid": "zhcn:d14d527e5075ae2feb66cd88",
      "kind": "race_jikkyo_message",
      "source_text": "%a_horse1领放中领放中！\\n会继续这样领放下去吗！",
      "source_fingerprint": "33cbed4bf1c4079fc172baf8bcca8c7c1f3e90a46cc0de688885fd46112a31ad",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6671"
      ]
    },
    {
      "uid": "zhcn:d387f01b791f4489d75bebed",
      "kind": "race_jikkyo_message",
      "source_text": "在19人前领头\\n%a_horse1逐渐拉大优势！",
      "source_fingerprint": "93b0452dc9c12ce4770030a062a74ef2b0c67a359294ffd0d5069207ee1f4715",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6672"
      ]
    },
    {
      "uid": "zhcn:69ce0bd073f852a55f391199",
      "kind": "race_jikkyo_message",
      "source_text": "绝不让出凯旋门赏的荣光！\\n激烈的对决！",
      "source_fingerprint": "641e143dc35219bbc880f9b0e2604ed73b31011f192e164dae0193edb485a275",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6673"
      ]
    },
    {
      "uid": "zhcn:a4b5ca7c2a12f29c7c55a628",
      "kind": "race_jikkyo_message",
      "source_text": "加油！　%horse1\\n虽然艰难但要坚持下去！",
      "source_fingerprint": "50d0425d772216622a3414354f5b4f6a3397214f22d85b99c9b63f2848cf156e",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6674"
      ]
    },
    {
      "uid": "zhcn:542d7f82cf131dbeb73bec5f",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1！　拉开了差距！\\n冲啊！　胜利就在眼前！",
      "source_fingerprint": "3da16ff5caec0834cca22ff4e681ad00fc62063d28db4d06dabea846f68a421a",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6675"
      ]
    },
    {
      "uid": "zhcn:93c157924a18fd5f029d2b7a",
      "kind": "race_jikkyo_message",
      "source_text": "胜者是%h_rank_ta1！\\n今天，日本粉丝们的梦想实现了\\n所有从业者们的梦想，全都实现了……！",
      "source_fingerprint": "a664aef241f2983ebf4981ab8ce1d7bdb21843342883707d724ecd0cbd0c6baf",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6676"
      ]
    },
    {
      "uid": "zhcn:6cbb2eefc30132abc6e38843",
      "kind": "race_jikkyo_message",
      "source_text": "黄金巨匠快胜！\\n以无愧于“金色暴君”异名的跑法，\\n出色地达成了日本长久以来的夙愿！",
      "source_fingerprint": "75b3f249033e9528e96658de55a64048958230f72837a0a83ad4b1a2070c8778",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6677"
      ]
    },
    {
      "uid": "zhcn:d4a32f19f7a163f469d82347",
      "kind": "race_jikkyo_message",
      "source_text": "人气第19，%ban1%h_pop19",
      "source_fingerprint": "5b0cb93a4214dffdaac5997b3554368c262b16c7c2a32036d8e5431679fc3708",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6678"
      ]
    },
    {
      "uid": "zhcn:5efe2aaffe718c5ad80438a5",
      "kind": "race_jikkyo_message",
      "source_text": "人气第19是%ban1%h_pop19",
      "source_fingerprint": "cf8619bb8629cf963873042e5078aa1de4013908c4c38154de81bc82b27cb82a",
      "source_path": "race_jikkyo_message_dict.json",
