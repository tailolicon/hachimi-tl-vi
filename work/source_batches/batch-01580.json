      ]
    },
    {
      "uid": "zhcn:2969bb46f5ae9ecd173737b3",
      "kind": "race_jikkyo_message",
      "source_text": "胜者是%h_rank_ta1！\\n赢得了世界最高峰的比赛！",
      "source_fingerprint": "db23856e1ad11971d10ad09627040f0dbc4ebb82c7cb7e9c011095736b5b2104",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6684"
      ]
    },
    {
      "uid": "zhcn:7e6f701db5a93165eda3077f",
      "kind": "race_jikkyo_message",
      "source_text": "现在开始就是决胜时刻！",
      "source_fingerprint": "62445344e8cae691d4e87eb475bee5af8f264a7a92d64610c709087374e6036c",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6685"
      ]
    },
    {
      "uid": "zhcn:8dd91e002b742d92d8b578b9",
      "kind": "race_jikkyo_message",
      "source_text": "终点近在眼前，速度又加快了一档！",
      "source_fingerprint": "f52efde46a4688237f425e9e1498c1bb10378b12583507461d9fe51f79430644",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6686"
      ]
    },
    {
      "uid": "zhcn:0115535dfc8f98fbf86ccd28",
      "kind": "race_jikkyo_message",
      "source_text": "终点近在眼前，各赛马娘一同突飞猛进！",
      "source_fingerprint": "801c60a8283b47afa3cf8e945d26cfbac3ffcedd131b505f642e839450478fa7",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6687"
      ]
    },
    {
      "uid": "zhcn:1d75803b3cac74753a22b7cd",
      "kind": "race_jikkyo_message",
      "source_text": "胜负将在最终直线上见分晓！",
      "source_fingerprint": "ce6aa64d59e288f7e7229f127c351c1face1a18a8eb85809a0cb66f3f4d3b8e5",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
