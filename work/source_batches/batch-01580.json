    {
      "uid": "zhcn:e9a30bdeebd0d21304934347",
      "kind": "race_jikkyo_message",
      "source_text": "上天赋予的试炼之雨，暗流涌动的%course\n%ground%distance%race\n终于要开始了",
      "source_fingerprint": "a91fd6ee127f71ad8d4ef42f89ab78e96f43aaad5856dc25960e1168e97ea450",
