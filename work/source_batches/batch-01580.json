    {
      "uid": "zhcn:7d982b4b0cd7e5224947d790",
      "kind": "race_jikkyo_message",
      "source_text": "虎视眈眈地紧盯前列\\n人气第三是%a_h_pop3",
      "source_fingerprint": "e8f3cc08483d5027d114750cb729e978685303cfe63f2b78dda84446f717c83b",
