    {
      "uid": "zhcn:f56f33ad003f6935c2f7349d",
      "kind": "race_jikkyo_message",
      "source_text": "最终的第5场比赛，观众的热情达到了最高潮！\\n让我们期待一场最棒的比赛吧！",
