    },
    {
      "uid": "zhcn:e89f287378f8bed5971cb6b7",
      "kind": "race_jikkyo_message",
      "source_text": "获胜的是%h_rank_ta1！\\n这是一场值得流传千古的\\n传说般的比赛！",
