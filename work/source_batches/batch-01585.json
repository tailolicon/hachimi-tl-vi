    },
    {
      "uid": "zhcn:556d2284bcaa58d72ea4a529",
      "kind": "race_jikkyo_message",
      "source_text": "第1名是%h_rank_l1！\\n众多观众的注目下，\\n她展现出了最棒的跑法！",
      "source_fingerprint": "a7da0d9abe78f07b08c8b650c8da4d05f093ff64e12b9890be991cd1864838be",
