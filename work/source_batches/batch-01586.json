      "uid": "zhcn:41b013406f4d97040b09be0c",
      "kind": "race_jikkyo_message",
      "source_text": "很远距离之外\\n目前第二名是%a_horse2",
      "source_fingerprint": "fa33c46eedf5c588a31dee5e2c48c471257734877e84fa261642a3c4eb6d39ca",
      "source_path": "race_jikkyo_message_dict.json",
