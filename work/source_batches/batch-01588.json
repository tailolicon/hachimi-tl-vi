  "entries": [
    {
      "uid": "zhcn:f126b44ffd62d794531a1386",
      "kind": "character_system_text",
      "source_text": "赛马娘 Pretty Derby",
      "source_fingerprint": "0fb57ac68b66f1546f9801f5aaf6a725ec4388807ec83792fcbb5cebd8d3fbba",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "12"
      ]
    },
    {
      "uid": "zhcn:54a21060e9a8b0303eeb81bb",
      "kind": "character_system_text",
      "source_text": "胜负直觉正逐渐磨砺得愈发敏锐……",
      "source_fingerprint": "ed6380e798fed62e1b2ee7c908399cec0816664841649865ec77a989003c6b0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "120000"
      ]
    },
    {
      "uid": "zhcn:45ce7ab30c07c0078ff6dad1",
      "kind": "character_system_text",
      "source_text": "一网打尽！",
      "source_fingerprint": "a5340b331ed3310aeb049eddc530cdb8d7cfdbaf0cd082b17de104471fdf9f9c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "1255"
      ]
    },
    {
      "uid": "zhcn:ba2aa0e727350c52374dc360",
      "kind": "character_system_text",
      "source_text": "我看穿了！",
      "source_fingerprint": "351510423ae0dba92a20b17a18abd13b44a5587705fde1b44b691cc41590d77b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "1272"
      ]
    },
    {
      "uid": "zhcn:f869389a964ad8a5b62caf55",
      "kind": "character_system_text",
      "source_text": "以王后之名。",
      "source_fingerprint": "47304bda778ff4b0ece5a9fb3fad9ff62ae6d6cc20d7736de0a0ee8e56dae2e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "1273"
      ]
    },
    {
      "uid": "zhcn:36c09c1677baf0d4c2de5573",
      "kind": "character_system_text",
      "source_text": "给，这是登录奖励。\r\n赶紧来对局一把吧。",
      "source_fingerprint": "39b79c9e3fe99b00fc742ad86481363082e6e64bb44c20e1372c68cc637ac257",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "13"
      ]
    },
    {
      "uid": "zhcn:abb070bdeee58cbaf239f128",
      "kind": "character_system_text",
      "source_text": "按照战略好好发挥啊。",
      "source_fingerprint": "9716ee4ef9f4790af5a48ffbfe4efcec4ed3a5237901b01b39d6b4fa96afa7bb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140000"
      ]
    },
    {
      "uid": "zhcn:f5acc00b1eb39bb5d3607c10",
      "kind": "character_system_text",
      "source_text": "干得漂亮嘛。",
      "source_fingerprint": "37e5b8a49e9db73978d2a14f576f9066422b6044778cd03e567dd5f6c7a66bc3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140001"
      ]
    },
    {
      "uid": "zhcn:7b4b4b534e0cb588662215a7",
      "kind": "character_system_text",
      "source_text": "真可惜啊……",
      "source_fingerprint": "88cc20bc6ad67ef1cbefd4ae8a11235934b5a3e67f8e5b25b7e5f1b60885d13a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140002"
      ]
    },
    {
      "uid": "zhcn:59a4572d3d6160b30fc29fb4",
      "kind": "character_system_text",
      "source_text": "简直是完美绝杀！",
      "source_fingerprint": "ae62cc191a9e22b6d0fc99344255d0d3eadc681d9678c123c931f912021fd188",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140003"
      ]
    },
    {
      "uid": "zhcn:dd9d776b8e0e3ae3eb578917",
      "kind": "character_system_text",
      "source_text": "这招走得挺妙的嘛。",
      "source_fingerprint": "db3b86c805d93f479b8275d5ae3a09d255404e201ac1946107e525d5ccfc9306",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140004"
      ]
    },
    {
      "uid": "zhcn:6cc9ad5e5c066fb77bab4901",
      "kind": "character_system_text",
      "source_text": "重新制定战略吧……",
      "source_fingerprint": "da1f27d7d086434f571c464990d6f76275f3a7c151527a3767f44029040914db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140005"
      ]
    },
    {
      "uid": "zhcn:fb7d357a3262bae30f45213b",
      "kind": "character_system_text",
      "source_text": "简直是完美绝杀！",
      "source_fingerprint": "ae62cc191a9e22b6d0fc99344255d0d3eadc681d9678c123c931f912021fd188",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140006"
      ]
    },
    {
      "uid": "zhcn:784cf2a84f4a62791787ca34",
      "kind": "character_system_text",
      "source_text": "这招走得挺妙的嘛。",
      "source_fingerprint": "db3b86c805d93f479b8275d5ae3a09d255404e201ac1946107e525d5ccfc9306",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140007"
      ]
    },
    {
      "uid": "zhcn:47e94e44d893aff34a1dd090",
      "kind": "character_system_text",
      "source_text": "怎么了？",
      "source_fingerprint": "8b931cbbc5ff834d619d16792036706cc06f14cf1a2024230235d3263006af89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140008"
      ]
    },
    {
      "uid": "zhcn:24eddd4706a89de11b8477b5",
      "kind": "character_system_text",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140009"
      ]
    },
    {
      "uid": "zhcn:c27acb76242fa5c4dd148d9b",
      "kind": "character_system_text",
      "source_text": "哈哈。",
      "source_fingerprint": "ae0d1ca7000d0a1d6996e337c00c38005469ade66f4e595e4b21b05e784807e8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140010"
      ]
    },
    {
      "uid": "zhcn:c402b2e32892c86f8ab44d23",
      "kind": "character_system_text",
      "source_text": "暴击命中！",
      "source_fingerprint": "112743e02fb8f7a7bbf566a8a06d98cd6069005f5ddd1882dc09e542b95ece5b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140011"
      ]
    },
    {
      "uid": "zhcn:4f8154bd7cefff8b442b456e",
      "kind": "character_system_text",
      "source_text": "堪称神级操作。",
      "source_fingerprint": "2250c8b244cf40ebcb20f3837ce175a76ab2e9e220a594eae1e743170976f21c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140012"
      ]
    },
    {
      "uid": "zhcn:06a970343eeb329a5376f5d2",
      "kind": "character_system_text",
      "source_text": "啊哈哈哈，完胜！",
      "source_fingerprint": "effc1c3cfda2262195a78b04be118f5e72b7240b0ea2860942dfa28692601d0b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140013"
      ]
    },
    {
      "uid": "zhcn:7942d0fefeedf05003137833",
      "kind": "character_system_text",
      "source_text": "搞什么粪作啊！！",
      "source_fingerprint": "5046e56b8ee5f3a83a9146bafe1344b668de6e76a6a7e8c98d252c5a68795cb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140014"
      ]
    },
    {
      "uid": "zhcn:0a460cf8199ca4ff569f0bd2",
      "kind": "character_system_text",
      "source_text": "冲啊冲啊……！",
      "source_fingerprint": "f7c082b70a31de7a8d2033705caebf88dc59e7ef93f8749c96957b1e9fdbadb9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140015"
      ]
    },
    {
      "uid": "zhcn:2fae2be3fb5ed0a992ef3704",
      "kind": "character_system_text",
      "source_text": "你长考的时间可真够久的啊。",
      "source_fingerprint": "fdd50ab9b13e2a7335fbf7d860dd945e5df4cf694b2627e3da80ae3ae9a94ec9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140016"
      ]
    },
    {
      "uid": "zhcn:fde59af57936ad5109ea85d5",
      "kind": "character_system_text",
      "source_text": "嗷啊啊啊啊啊――！！",
      "source_fingerprint": "09012962f61d8900bd0645ca4f842fb1cf8ea9759c7f851c33b880af329e166f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140017"
      ]
    },
    {
      "uid": "zhcn:8f992e7a52bfdd5bac5ea303",
      "kind": "character_system_text",
      "source_text": "怎么会这样啊……",
      "source_fingerprint": "1763c42f529f7a07fe75e31c650a2c4b37873f19aa29d404f5d6f1d3c154500a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "140018"
      ]
    },
    {
      "uid": "zhcn:6f06cbc4f2b3ae24432d7935",
      "kind": "character_system_text",
      "source_text": "明天能拿到这个。\r\n把这考虑进去，好好谋划战略吧。",
      "source_fingerprint": "3a2e9412e5738a7d82e46add0d910d6d16c9f47516437bc14b6bd0b5a0b019ca",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "15"
      ]
    },
    {
      "uid": "zhcn:3e71b3a68b62b87a0784a61b",
      "kind": "character_system_text",
      "source_text": "不行了……电量见底了……\r\n想闭关自闭个三天左右……\r\n认真的……切切实实地……",
      "source_fingerprint": "51e64fa604f347bffd6df6505fee3f1b2d54d74ce60b511cacde021b29527a18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20000"
      ]
    },
    {
      "uid": "zhcn:229bc97416d06c1c12094a96",
      "kind": "character_system_text",
      "source_text": "一味猛攻可不是明智之举。\r\n特意空过一轮，以谋求下个回合\r\n收益最大化，不也是一种策略吗？",
      "source_fingerprint": "a9aca5f3643fc3361c3f42f5300201c1d4f2251972b11c7d6f5bd0a7ad327927",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20001"
      ]
    },
    {
      "uid": "zhcn:002f01288427771b1a02c178",
      "kind": "character_system_text",
      "source_text": "无论面对怎样的训练菜单，\r\n我都会以最佳着法取得成果。\r\n来吧，尽管拿出来吧。",
      "source_fingerprint": "99e3f9d12a7721f2554ced5676988dcb511ce20d566977ce626eff382f3a928d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20002"
      ]
    },
    {
      "uid": "zhcn:43ca2ba659ad590d17ad44e9",
      "kind": "character_system_text",
      "source_text": "呵――你就看着吧。\r\n今天我要跑出个人最好成绩。\r\n因为盘面我已经完全“看穿”了……！",
      "source_fingerprint": "f0e208c33af85885d4f524006e795a2850d8f26a21612db916c594878ba2f8d8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20003"
      ]
    },
    {
      "uid": "zhcn:cede666264038db4c2395573",
      "kind": "character_system_text",
      "source_text": "状态和干劲都很良好……\r\n只需轻松运子，\r\n就能收获充分的成果吧。",
      "source_fingerprint": "5b16c9fdeaa8850280209eed2208d3f37a46a1b3efd4e484fb565572632c79e2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20004"
      ]
    },
    {
      "uid": "zhcn:4215988e5d01521384c14b83",
      "kind": "character_system_text",
      "source_text": "我的战术每天都在不断进化……\r\n即便是加入了变体规则，\r\n我也能完美应对给你看。",
      "source_fingerprint": "23ac63fd933b7c5aecffb3cb231de4d8a05659e9fc01ebe9ab273acfcd40742e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20005"
      ]
    },
    {
      "uid": "zhcn:19960ff8a3ae2fac8f0235d5",
      "kind": "character_system_text",
      "source_text": "目前和赛前准备的分毫不差。\r\n……嘛，我的战略不可能失误。\r\n可以说是理所当然的进度。",
      "source_fingerprint": "57b883061dbbcbbe6d156f398bcae65ab50190ad0cc3a9de7e65e727549da20b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20006"
      ]
    },
    {
      "uid": "zhcn:c5381727e09e2efc5ab66d71",
      "kind": "character_system_text",
      "source_text": "赶紧利落地搞定，剩下的时间\r\n去下黑白棋。正是这种张弛有度，\r\n才能让下一局的攻势更加犀利。",
      "source_fingerprint": "9390608ecab4b5a17024b438476b58e6f40f1bda7594b9644f6f508fdb70aa18",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20007"
      ]
    },
    {
      "uid": "zhcn:5f55d62e735a92a849925839",
      "kind": "character_system_text",
      "source_text": "啊……就是那种……感觉就像\n连着十把抽卡都非酋爆了一样……\n你能懂的吧……？",
      "source_fingerprint": "95c5cea6bc7016a81e312ca7402910748de35fcfbac003de6db8473b0bd27224",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20008"
      ]
    },
    {
      "uid": "zhcn:7d1181cbe5f4101fc80c574b",
      "kind": "character_system_text",
      "source_text": "啊哈哈哈，总感觉～～\r\n完～～全没法集中精神啊。\r\n今天打烊了打烊了，收工。",
      "source_fingerprint": "dc541fa7c07b0001944ed24d7bbffb1b7df53a5b7f7f68a33b6a6ccc9e1ac28e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20009"
      ]
    },
    {
      "uid": "zhcn:24f4c374d8bdefe1b9dbf892",
      "kind": "character_system_text",
      "source_text": "………………………………想回家。",
      "source_fingerprint": "88177c58305220c9829cc0ca984e8b8c48bd00abfa7ac254f9e1db41ceddcfe2",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20010"
      ]
    },
    {
      "uid": "zhcn:31e789bc959a9afc6526caec",
      "kind": "character_system_text",
      "source_text": "下棋输了，脚趾踢到了，\r\n干劲也没了，真是样样都不顺，\r\n森罗万象全是粪作啦！！",
      "source_fingerprint": "8dc565638b6c70c2a3ba7270051d33fe8b392f1f9140c47b901f1e50a535d5ce",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20011"
      ]
    },
    {
      "uid": "zhcn:968309c9644e9a4ec3ed49d3",
      "kind": "character_system_text",
      "source_text": "冷静一点，训练员。\r\n时机、状态，万事俱备方可行动……\r\n这可是战略的常识吧？",
      "source_fingerprint": "ec6029b1e9b2c52ddefba19f28fd79a67abc1ccae395272af760d59b57d0c136",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20021"
      ]
    },
    {
      "uid": "zhcn:b9ade49eea05d751cff0f339",
      "kind": "character_system_text",
      "source_text": "不要。我拒绝。让我回去。",
      "source_fingerprint": "8aa03bd32c01e650e7f2a27d655606faad8bf25e7f6728aac2ebf556003b07cc",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20022"
      ]
    },
    {
      "uid": "zhcn:a2341dbdee3683e2ab1c9235",
      "kind": "character_system_text",
      "source_text": "若能将我的战术与你的慧眼\n融为一体，定能构筑出\n最完美的战型……你说对吧？",
      "source_fingerprint": "ebc1f62c5fd7aee188c7c53eeab0ad93ab9df55bcf201b7e9ad2291a1760381d",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20023"
      ]
    },
    {
      "uid": "zhcn:4802e1a15b08e889a276fbe5",
      "kind": "character_system_text",
      "source_text": "今天可不能以俗手收场。\r\n为了谱写出更具艺术性的将死，\r\n全神贯注地去上吧。",
      "source_fingerprint": "56f953963d1132150111216c5790db05434eb23f5c9355f495a45c0319d8f270",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20024"
      ]
    },
    {
      "uid": "zhcn:7129b2c79d4c9fe9e931e0ae",
      "kind": "character_system_text",
      "source_text": "我已经看到致胜序列了。\r\n剩下的就是付诸行动。",
      "source_fingerprint": "ccb52e38f8944b3178d10b4bb31bd3f6a2cd186f6f399fecd279d4d2f4a4935c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20025"
      ]
    },
    {
      "uid": "zhcn:ff5cd84fc25bad64dcec25d5",
      "kind": "character_system_text",
      "source_text": "布石早已落定……\r\n看我稳稳当当地拿下胜利吧。",
      "source_fingerprint": "90fc66c4caec0051d9af3404dad6f6339df1e1b9a189886155d22f465483ac2f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20026"
      ]
    },
    {
      "uid": "zhcn:231d42cdce26053eeebae01d",
      "kind": "character_system_text",
      "source_text": "我真是得了个优秀的左右手啊……\r\n那么，现在就让我用结果\r\n来回应你的奉献与憧憬吧。",
      "source_fingerprint": "3fbdd725e3ba49a588538623efedb42e22d34006e28e15b505a2e031e88e2649",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20027"
      ]
    },
    {
      "uid": "zhcn:e221ab14a614ec1bd0013416",
      "kind": "character_system_text",
      "source_text": "盘面已经一清二楚了――\r\n接下来直到将死为止，\r\n行云流水地下完即可。",
      "source_fingerprint": "c86e1a7c24199e451ef51a8dbf8c8962d7a2d9fc9295b944a4ab20df2969b106",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20028"
      ]
    },
    {
      "uid": "zhcn:b0519c1dae22a92eb2084117",
      "kind": "character_system_text",
      "source_text": "即便不受定式束缚，\r\n只要见招拆招导出最佳着法就行。\r\n没有任何好担忧的。",
      "source_fingerprint": "61173a765f08ee51140bbae8bfedf013929847444d756744ceae9e77fac3ac99",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20029"
      ]
    },
    {
      "uid": "zhcn:922c3436788e09f1678dc6c5",
      "kind": "character_system_text",
      "source_text": "战略构筑周全，\r\n棋子稳步推进……\r\n接下来只需悠然等待终局即可。",
      "source_fingerprint": "0d75bdbd69d86f4d0f3ad0de2c1e284fff217f7553cd9f1d2f4a048be05b0c42",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20030"
      ]
    },
    {
      "uid": "zhcn:7f774a03914c124c0ea2a928",
      "kind": "character_system_text",
      "source_text": "被紧张吞噬，不过是三流的证明。\r\n沉着应对便好。",
      "source_fingerprint": "d7c976cd5fada1bdafd5485bfa6b9d6721b918ea9da5f429a72357e67b33e2d1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20031"
      ]
    },
    {
      "uid": "zhcn:05de516587ffb3e0adb6fb8c",
      "kind": "character_system_text",
      "source_text": "虽然会是一场苦局……\r\n不过你看着就好。局势往往\r\n就是用来逆转翻盘的。",
      "source_fingerprint": "09e5432a7bc0f3a82e1e214529c85c9a9e486e69a9977d14bf1053bcc795c6f1",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20032"
      ]
    },
    {
      "uid": "zhcn:422eb0dd9e07661f169e051f",
      "kind": "character_system_text",
      "source_text": "我又不是说截至目前的战略有错！\n完全游刃有余好吗！我本来就打算\n照这个节奏赢下来的！！",
      "source_fingerprint": "4561a08e886dc710a70e7ef7bf6035c03a0914df79739e03dd021badfd9a5ef6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20033"
      ]
    },
    {
      "uid": "zhcn:ef9d79cf5b60acc605259448",
      "kind": "character_system_text",
      "source_text": "哈哈哈……你怎么搞的，一副忧心忡忡的\r\n样子……诶？因为我的脸色太惨白了？\r\n……别戳穿我啊…………。",
      "source_fingerprint": "68056f54582938ba8ef484e0adc52a3067700994ce32bc77c2ffe4230d64afb6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20034"
      ]
    },
    {
      "uid": "zhcn:2a9ea7adef3fcbecba1ea771",
      "kind": "character_system_text",
      "source_text": "说实话我真想在闸门里住上两年\n左右…………开玩笑的，我出啦，\n会好好出闸的。我出了闸你得夸夸我……",
      "source_fingerprint": "22c75b755dea03afce5d046181d7565b46c4a7959db66d187787886be09dfe22",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20035"
      ]
    },
    {
      "uid": "zhcn:3fbcfb4243c9029aaeaab712",
      "kind": "character_system_text",
      "source_text": "哈哈，哎呀算漏了，正赛的状态\n居然这么烂！――太糟了……\n但也只能硬着头皮上了……。",
      "source_fingerprint": "e43f3881f57d307eaecc2d6a64b0102d8041a15af53e17143fa1761d2b8530e3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20036"
      ]
    },
    {
      "uid": "zhcn:d11bcc03e1d128f811f24bbd",
      "kind": "character_system_text",
      "source_text": "………………哈？\r\n我才没有……我状态好得很……\r\n落子绝不会有一丝犹豫……。",
      "source_fingerprint": "ad4fe9a8b775610d301f4c1638423e9c31e99e819d7252cedb62b3f542779a29",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20037"
      ]
    },
    {
      "uid": "zhcn:1b1998adf78f804d1c238191",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20038"
      ]
    },
    {
      "uid": "zhcn:7a8923031e7d82e73e7fcbae",
      "kind": "character_system_text",
      "source_text": "我的回合！",
      "source_fingerprint": "1b54a8a880cdaf223c732f6564c3e721206715cbf8417cf37b05f0e1350718cf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20039"
      ]
    },
    {
      "uid": "zhcn:7360ad5ed64c97e1eca44d2b",
      "kind": "character_system_text",
      "source_text": "好吧。",
      "source_fingerprint": "02c27b671abd96656d55c23c4947eec0a2ed3d25244933af767d238e5f01c465",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20040"
      ]
    },
    {
      "uid": "zhcn:e06be1c631522beb2da0a28b",
      "kind": "character_system_text",
      "source_text": "小菜一碟。",
      "source_fingerprint": "a071378b87789fc619e4061ae44a1920948d8acd4b8fd629ba0c197ff9b422d3",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20041"
      ]
    },
    {
      "uid": "zhcn:87804bd5cbfe561e13676024",
      "kind": "character_system_text",
      "source_text": "死局了……",
      "source_fingerprint": "345038d883a8a812323c6785f4530fdb90466c064db865df8c4b0a7bc2a54ddf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20042"
      ]
    },
    {
      "uid": "zhcn:0dec0146c56109a6632114c2",
      "kind": "character_system_text",
      "source_text": "认输投降～。",
      "source_fingerprint": "1086bca977c06672e120e81532861bff3d815e795ac1d4da424b9632ad4c22b6",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20043"
      ]
    },
    {
      "uid": "zhcn:c61117bb9f0ea12b6d1bf2f1",
      "kind": "character_system_text",
      "source_text": "我上啦～……",
      "source_fingerprint": "ae87a7cd150ccd6c05164da25831f754488189abb87b92fb31381c4b4c039747",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20046"
      ]
    },
    {
      "uid": "zhcn:ffe38c6e926b18c2ec470323",
      "kind": "character_system_text",
      "source_text": "嘛，至少姿态是优美的。",
      "source_fingerprint": "3ca403466a5c50b62245e9dd1995c83a2a0f19353222e218aa663dc330586c92",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20047"
      ]
    },
    {
      "uid": "zhcn:56595623874d205ca49d374c",
      "kind": "character_system_text",
      "source_text": "向我的左右手的奉献致敬。",
      "source_fingerprint": "f683639cf86bef50c3da6e8aa240fcb1e505bb786f91f5205b1e22b1a0402ae4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20049"
      ]
    },
    {
      "uid": "zhcn:8c1a1a306068d3e83cb6c084",
      "kind": "character_system_text",
      "source_text": "真是一场不错的游戏呢。",
      "source_fingerprint": "8e29cb9714875cec54786245ee612fe2abb9624ad7ad5e65f14f99436ab52040",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20050"
      ]
    },
    {
      "uid": "zhcn:9c6e05f39f4b6e020d46a3d2",
      "kind": "character_system_text",
      "source_text": "Game Start――",
      "source_fingerprint": "19fffe9cce1130753a18f471a70111d653778b76ca64223a3da138336d4dede5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "20051"
      ]
    },
    {
      "uid": "zhcn:436926f9449ce9fc78acf440",
      "kind": "character_system_text",
      "source_text": "用最佳着法拿下胜利吧。",
      "source_fingerprint": "5b3e0fc10da02f00fb50aec7f9bb2af7f31f1f954907e08756c48a875a55a8e5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "2030"
      ]
    },
    {
      "uid": "zhcn:cc3cfadabb2771c43358dd85",
      "kind": "character_system_text",
      "source_text": "那么，来对局一把吧。",
      "source_fingerprint": "773ecd63b1694007765b4f6f95bf369b2ccffa349f5936bae40f7a3543a2b8cb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "2031"
      ]
    },
    {
      "uid": "zhcn:0b1f02e90386527b413c1b9a",
      "kind": "character_system_text",
      "source_text": "真是一场不错的游戏呢。",
      "source_fingerprint": "8e29cb9714875cec54786245ee612fe2abb9624ad7ad5e65f14f99436ab52040",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "2032"
      ]
    },
    {
      "uid": "zhcn:94dbd7a19165aa0b61224920",
      "kind": "character_system_text",
      "source_text": "盘面已经一清二楚了――\r\n接下来直到将死为止，\r\n行云流水地下完即可。",
      "source_fingerprint": "c86e1a7c24199e451ef51a8dbf8c8962d7a2d9fc9295b944a4ab20df2969b106",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "2033"
      ]
    },
    {
      "uid": "zhcn:eb85398f3f4c061fc6474e8a",
      "kind": "character_system_text",
      "source_text": "我已经看到致胜序列了。\r\n剩下的就是付诸行动。",
      "source_fingerprint": "ccb52e38f8944b3178d10b4bb31bd3f6a2cd186f6f399fecd279d4d2f4a4935c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "2034"
      ]
    },
    {
      "uid": "zhcn:adece4e35890777fc810890c",
      "kind": "character_system_text",
      "source_text": "真是一场不错的游戏呢。",
      "source_fingerprint": "8e29cb9714875cec54786245ee612fe2abb9624ad7ad5e65f14f99436ab52040",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "2035"
      ]
    },
    {
      "uid": "zhcn:e04be75378ef9d0d5b4447bf",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b6a539ee9bb3d0fe804ff38c",
      "kind": "character_system_text",
      "source_text": "就差最后一步了啊……！",
      "source_fingerprint": "d9806ac415b4edfcb5d0ec9606f46dafd604e5ec86273ea0cfc14671eeafc4f9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "30000"
      ]
    },
    {
      "uid": "zhcn:9a12dcdb4dadbd736d0d8c7c",
      "kind": "character_system_text",
      "source_text": "调整一下战略吧。",
      "source_fingerprint": "966a1099e4150773afe0da9a04dcdfe6e536fd1052f12845f3998f84426e57eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "30001"
      ]
    },
    {
      "uid": "zhcn:6c7f0e987e11ce426abe9f96",
      "kind": "character_system_text",
      "source_text": "区区一局而已，动摇不了我……",
      "source_fingerprint": "8922936ec6eaaf72c22e8434896c29a319672ae3bbcbc3a0e88d956b2b4b8278",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "30002"
      ]
    },
    {
      "uid": "zhcn:c398d4e7b6801b906443d7a3",
      "kind": "character_system_text",
      "source_text": "死局了～～！！为什么啊～～！？",
      "source_fingerprint": "bf1f213af09b2eb92c8b3bd19df55e7eeae0cc5f36afc3d9f0f43ec3d7935287",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "30003"
      ]
    },
    {
      "uid": "zhcn:49902d7d4391b3a97c710570",
      "kind": "character_system_text",
      "source_text": "怎么样，这盘面很优美吧？",
      "source_fingerprint": "a3d3308e138d47e85784901b4aeeeb6888721d41b939cd11cd56ff1d3f6adeaf",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "30004"
      ]
    },
    {
      "uid": "zhcn:dfd865462ac42e8622faa715",
      "kind": "character_system_text",
      "source_text": "这场胜负，在开始之前就已经结束了。",
      "source_fingerprint": "62f42935846dfb4f162d1e589afcc04819a1e7e103e6dde262285466563a4183",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "30005"
      ]
    },
    {
      "uid": "zhcn:c149b1f93e0305e6ce1899d1",
      "kind": "character_system_text",
      "source_text": "来切磋一局吧。",
      "source_fingerprint": "2adb9e152c9d007b7b8f86492e20a8f3fd4beb1cf40befbca2533cbc173b4db4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1145",
        "31000"
      ]
    }
  ]
}
