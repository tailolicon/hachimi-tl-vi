      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "9052"
      ]
    },
    {
      "uid": "zhcn:e9160690db31bedb4c352684",
      "kind": "race_jikkyo_message",
      "source_text": "晴朗天空下开始的\\n%course，\\n%ground%distance %h_num_no赛马娘前来挑战",
      "source_fingerprint": "7419fe1ca7213015354660c088a0fa13fb543bc195dbcdb1c189406f60190748",
