      "json_path": [
        "9053"
      ]
    },
    {
      "uid": "zhcn:f12d6667e5f2bfd9548da653",
      "kind": "race_jikkyo_message",
      "source_text": "各赛马娘，沿山坡赛道下坡\\n进入主直线赛道",
