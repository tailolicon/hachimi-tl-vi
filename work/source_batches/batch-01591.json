  "entries": [
    {
      "uid": "zhcn:c64c41fd64d80d4af0fc38bf",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20038"
      ]
    },
    {
      "uid": "zhcn:c7025f7cc6d8e56e328c0643",
      "kind": "character_system_text",
      "source_text": "要开始了。",
      "source_fingerprint": "50f188e86f3a8e4b11e3889195a5e78696dec7efbbec196eb54940fe3288b9a8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20039"
      ]
    },
    {
      "uid": "zhcn:730206e172e138b5d06bffcc",
      "kind": "character_system_text",
      "source_text": "了解。",
      "source_fingerprint": "0157e6aed55c5c02d6a5db10de6381ff48cf5d42afdf83c802629cb18e71b92a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20040"
      ]
    },
    {
      "uid": "zhcn:a905b2b34257bd7c1c3d5e20",
      "kind": "character_system_text",
      "source_text": "轻而易举。",
      "source_fingerprint": "d7bac9d59c451d7f3dfdc1f3c3d08d20c3252d0f635fbdedd7c3ffe1e7792aff",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20041"
      ]
    },
    {
      "uid": "zhcn:c0f3e12b301c6e8ae5e79e4e",
      "kind": "character_system_text",
      "source_text": "太难看了……。",
      "source_fingerprint": "40d3c40e2c391dd11e86f5cd8829810c340db14aab68094cfc4ad555f9aac78c",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20042"
      ]
    },
    {
      "uid": "zhcn:a5963cd74c18352cd2beb0dc",
      "kind": "character_system_text",
      "source_text": "必须重新审视一番了……。",
      "source_fingerprint": "e8aacf83f10418bef2bc3275a180941d364fa56124d083d8a6874585f1274ea5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20043"
      ]
    },
    {
      "uid": "zhcn:f8a6515672bed1041d223b4f",
      "kind": "character_system_text",
      "source_text": "出发吧。",
      "source_fingerprint": "b0e503174d4061b5a441fdf881cb3104cb5ae97793c7d54f43b96980f665783a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20046"
      ]
    },
    {
      "uid": "zhcn:04d77630d060ee51afd7cfc4",
      "kind": "character_system_text",
      "source_text": "去游泳吗？",
      "source_fingerprint": "1e6585b5ab1452aea783b9234123b16b8ddec61c38092bc805e1554194bcea7e",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20047"
      ]
    },
    {
      "uid": "zhcn:abae6b82c79824c7b6c4e603",
      "kind": "character_system_text",
      "source_text": "向你道谢。我收了个好徒弟。",
      "source_fingerprint": "a08589631cf881d62d99203c9cd4492faecaa3ab74013118d9934cd27c98aaf0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20049"
      ]
    },
    {
      "uid": "zhcn:4fa70cdbfd63a3fdcb40cbfa",
      "kind": "character_system_text",
      "source_text": "你要继续精进，不可懈怠。",
      "source_fingerprint": "e1b7f76a0eb04d3849e08f4fe677c88b6aeef326eec45970ccd4ab76bff667e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "20050"
      ]
    },
    {
      "uid": "zhcn:5eb2da241eb15464d819ae85",
      "kind": "character_system_text",
      "source_text": "出发吧。",
      "source_fingerprint": "b0e503174d4061b5a441fdf881cb3104cb5ae97793c7d54f43b96980f665783a",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "2030"
      ]
    },
    {
      "uid": "zhcn:05f222f0c4b1b8f76ccd5f3a",
      "kind": "character_system_text",
      "source_text": "让你见识一下，那名为胜利的大轮之花！",
      "source_fingerprint": "7e6e3948b0adb7b8ad6481d8d6bb055b546fa38cc2d12a0b583e097b4a8088ae",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "2031"
      ]
    },
    {
      "uid": "zhcn:dcc3cf6a95085fa8d185ba44",
      "kind": "character_system_text",
      "source_text": "你要继续精进，不可懈怠。",
      "source_fingerprint": "e1b7f76a0eb04d3849e08f4fe677c88b6aeef326eec45970ccd4ab76bff667e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "2032"
      ]
    },
    {
      "uid": "zhcn:361d4fbd47fec9d6a150aa1d",
      "kind": "character_system_text",
      "source_text": "能毫无后顾之忧地奔跑，\r\n是何等的幸福……这个机会，\r\n我绝不会白白浪费。",
      "source_fingerprint": "17c561d586b2d161fa415288404b10250395e5c76392a35606b4faed39bb6697",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "2033"
      ]
    },
    {
      "uid": "zhcn:d9a2087a67db99a7a992d886",
      "kind": "character_system_text",
      "source_text": "胜利乃是必然。\r\n即便如此，我也绝不会掉以轻心。绝不。",
      "source_fingerprint": "9c80f9e9bc0db7c59190ff562803567928dfd52ce5f67650ae159fc90ea2b749",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "2034"
      ]
    },
    {
      "uid": "zhcn:08953f1efb246268e1e1ac88",
      "kind": "character_system_text",
      "source_text": "你要继续精进，不可懈怠。",
      "source_fingerprint": "e1b7f76a0eb04d3849e08f4fe677c88b6aeef326eec45970ccd4ab76bff667e7",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "2035"
      ]
    },
    {
      "uid": "zhcn:a410461baf64eb13410fcb72",
      "kind": "character_system_text",
      "source_text": "上吧！",
      "source_fingerprint": "3eb5b5f74ef2384c6c0a89d001ced307776a3b463e8ad6c297c9c98980420a95",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "23015"
      ]
    },
    {
      "uid": "zhcn:b5d35d594e198dd2e2bc00a0",
      "kind": "character_system_text",
      "source_text": "是我预估得太乐观了……唯有继续精进。",
      "source_fingerprint": "72c679d7bd9147edb982b87ead241db92836ce441a46bc6845c022b7b110e6a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "30000"
      ]
    },
    {
      "uid": "zhcn:d891b21e1cacc68f0c845979",
      "kind": "character_system_text",
      "source_text": "……虽说没丢人现眼，但还是太难堪了。",
      "source_fingerprint": "3bd0ce861478563da7e2657adfcf7b749bb8e02bea3ec7aa481ee4e965d24720",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "30001"
      ]
    },
    {
      "uid": "zhcn:b0a1f4e14af1d42b3a361ac6",
      "kind": "character_system_text",
      "source_text": "哈……就这点本事还自称为师，真是个笑话。",
      "source_fingerprint": "fa99f89a221ad3055d1dad73136411cd947bb1ad6008940c5c263b56d0684cb8",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "30002"
      ]
    },
    {
      "uid": "zhcn:36d01df513026641e91304f0",
      "kind": "character_system_text",
      "source_text": "这个……软弱之徒……！",
      "source_fingerprint": "37e59bf67cc725a9651278b5edcbb935ecbb1b002c32ab148f8c94050428f67f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "30003"
      ]
    },
    {
      "uid": "zhcn:3ec96312c36d82f2514f48fe",
      "kind": "character_system_text",
      "source_text": "我们凭执念让其绽放的花朵，真是美丽啊。对吧？",
      "source_fingerprint": "1c176709bc5981b55ae14f488a5f2c33c8cdbc65de131abead27a9fe6739eb89",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "30004"
      ]
    },
    {
      "uid": "zhcn:d64ed83cd41ebc470d8c03c7",
      "kind": "character_system_text",
      "source_text": "以此胜利为粮……去绽放出更为巨大的花朵吧！",
      "source_fingerprint": "408899d6fc25ed4fd2b1944f716c7acd695e4f97fdee0678baec1a23edc2e429",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "30005"
      ]
    },
    {
      "uid": "zhcn:bd5f78267749af79879b1523",
      "kind": "character_system_text",
      "source_text": "来交手吧。",
      "source_fingerprint": "4370c67e8b45309b1aa6e7975e2f2fc03cd3943e75f98c1eafbac9449008fec5",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "31000"
      ]
    },
    {
      "uid": "zhcn:3e23ea489f870ccf16e28a73",
      "kind": "character_system_text",
      "source_text": "此时不绽放，更待何时！",
      "source_fingerprint": "2d3e4e19f0ab4709fdb6e6f557b83ee3100f106a31d78fb129b86dacf8ba01eb",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "40000"
      ]
    },
    {
      "uid": "zhcn:3c3abae2d3ce846839fb0e89",
      "kind": "character_system_text",
      "source_text": "去报答吧。报答让我萌芽的大恩。\r\n绝不会让这一切以一场庄周梦蝶告终——\r\n这，就是我的觉悟！",
      "source_fingerprint": "7eb262c286e35239140c307c9aa7259f576d2957454b9335569d1b9804e2b2a4",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "40001"
      ]
    },
    {
      "uid": "zhcn:691ada285df67a96285c8f93",
      "kind": "character_system_text",
      "source_text": "那么——在这里也绽放一朵花吧。",
      "source_fingerprint": "fd2e662d28e6f08575b6e9d9ad504d68701db662331f94da4edb68f873b851ac",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "60000"
      ]
    },
    {
      "uid": "zhcn:593961ad8e949018d18e9ba5",
      "kind": "character_system_text",
      "source_text": "让你见识一下吧。这通过剑舞千锤百炼而成的绽放之姿。",
      "source_fingerprint": "9b696777b17e4611c694558dce50587f235065570a6b172e27e72f22b1efe68f",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "60001"
      ]
    },
    {
      "uid": "zhcn:156bfee9494a078180f6c264",
      "kind": "character_system_text",
      "source_text": "刮目相看吧，这花儿的生存之道。",
      "source_fingerprint": "721306949ae5a5e062655d095d03040983becdfeb0f2da3edb2cd4eaa13df0db",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70000"
      ]
    },
    {
      "uid": "zhcn:29890d537380f82ac32f9b31",
      "kind": "character_system_text",
      "source_text": "……呵。真没想到，\r\n居然会收训练员为徒。\r\n可别辜负了为师的期待啊。",
      "source_fingerprint": "0d619b1fce9eed5243b71449138ae465f0d1c8a88477ae9f53fee09c69162222",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70001"
      ]
    },
    {
      "uid": "zhcn:103400349c6d1dacd834f4cd",
      "kind": "character_system_text",
      "source_text": "这是有着悠久传统的制服。要带着骄傲穿戴整齐。",
      "source_fingerprint": "c837d0d9beb67877c030ad1f8c205d4272a51468e9732ffe1122e7790a80e809",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70004"
      ]
    },
    {
      "uid": "zhcn:4be73b97928a746557373969",
      "kind": "character_system_text",
      "source_text": "随观看角度不同，韵味也会改变，真是套充满意趣的服装呢。",
      "source_fingerprint": "daaa1bbf3f975f7a78148c6fea93dee19fcd11c9c8a0db3b4cc715149f165073",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70008"
      ]
    },
    {
      "uid": "zhcn:ca318cbdb73b6326b4a43fa6",
      "kind": "character_system_text",
      "source_text": "真不错啊……感觉我的心中也绽放出了花朵。",
      "source_fingerprint": "a157e21fd5cfa695062fd422d65913c783772447d99e4c5ce1960854e5a2c1e0",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70009"
      ]
    },
    {
      "uid": "zhcn:9d16e05c9480e191f9f6fa06",
      "kind": "character_system_text",
      "source_text": "我打的蝴蝶结，可是以绝对不会松开而闻名的。",
      "source_fingerprint": "f336751b2119b045430071a2ee28d110734d4518bff0d45d01d4c44fb2b8f205",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70010"
      ]
    },
    {
      "uid": "zhcn:7516097b9ba8b3465e569415",
      "kind": "character_system_text",
      "source_text": "呵……偶尔你也要不要试着跳一舞？",
      "source_fingerprint": "3f9f6ef5227500e6c60d28897cdee435bb21c3bdee31d2661dbc350b01c54e28",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70014"
      ]
    },
    {
      "uid": "zhcn:f52cfbc576aa579b59788a8f",
      "kind": "character_system_text",
      "source_text": "每一次重新系紧腰带时，我都在叩问自己的觉悟。",
      "source_fingerprint": "6f5793809dc94b03f108d3a7c01046ee4baca7669134ce10ab3880650fab0759",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70015"
      ]
    },
    {
      "uid": "zhcn:5c9ce098263eee3875e2ecb4",
      "kind": "character_system_text",
      "source_text": "裁制得真好。做这件衣服的人手艺很高超啊。",
      "source_fingerprint": "e530ae20d0f4f984f8af76e8127c2aef08dd1997a55918befcd52a51b96a2b65",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70018"
      ]
    },
    {
      "uid": "zhcn:14107aed9405713cc8254cd3",
      "kind": "character_system_text",
      "source_text": "打算挠我痒痒吗？胆子倒是不小。",
      "source_fingerprint": "d9e57ec3511b7732d40692614d162a453a5bc9c7a3e01e85f894645b12df4658",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70019"
      ]
    },
    {
      "uid": "zhcn:1c3f9cf76950889368e6f537",
      "kind": "character_system_text",
      "source_text": "这极具气势的设计，让我对它一见钟情呢。",
      "source_fingerprint": "03ff5e4e7c5111a0b5151640020aa460366b72c7976bda8280d8564554575ae9",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70020"
      ]
    },
    {
      "uid": "zhcn:ce89ef048c9c197c5f265f4a",
      "kind": "character_system_text",
      "source_text": "御寒措施万无一失。不用担心。",
      "source_fingerprint": "09a81fd87fbeb94f4f69eb16842c3c77e7ee809eef8b644c49a20a3da3a1490b",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "70021"
      ]
    },
    {
      "uid": "zhcn:68a26853158facc5c5e13556",
      "kind": "character_system_text",
      "source_text": "这是有着悠久传统的制服。要带着骄傲穿戴整齐。",
      "source_fingerprint": "c837d0d9beb67877c030ad1f8c205d4272a51468e9732ffe1122e7790a80e809",
      "source_path": "character_system_text_dict.json",
      "json_path": [
        "1149",
        "71004"
      ]
    },
    {
      "uid": "zhcn:e3d0f770d2cb52baf49538a7",
      "kind": "character_system_text",
      "source_text": "随观看角度不同，韵味也会改变，真是套充满意趣的服装呢。",
      "source_fingerprint": "daaa1bbf3f975f7a78148c6fea93dee19fcd11c9c8a0db3b4cc715149f165073",
