  "batch_count": 1674,
  "source_repo": "Hachimi-Hachimi/tl-zh-cn",
  "source_commit": "c0843a2d48250bf43b290794d39bc866bb741857",
  "source_language": "zh-CN",
  "entries": [
    {
      "uid": "zhcn:83da9c870a4f2a87a1df9ebb",
      "kind": "race_jikkyo_message",
      "source_text": "来看看前方情况如何",
      "source_fingerprint": "d4f8250fccd72b4f5443c5f7b5fcf07b393498b8865b0a61dfc5d773117e3f96",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6121"
      ]
    },
    {
      "uid": "zhcn:3184e51bc6aff746f188d772",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1，保持领先！\\n这可真是有趣的发展！　她能保持这样前进下去吗？",
      "source_fingerprint": "784eebf94543fb3410ee359838fb8f6770e72c58a270b78aca8938f02cd099f7",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6122"
      ]
    },
    {
      "uid": "zhcn:591e4979c543b5effd508cb8",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1，依然保持领先\\n到底会如何？",
      "source_fingerprint": "8ea0802d48e6268aed173428a54044558da15d4b2de5573d25ea337b6a2f90bc",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6123"
      ]
    },
    {
      "uid": "zhcn:dbf44f51b0b947143755ffa8",
      "kind": "race_jikkyo_message",
      "source_text": "正得意扬扬地保持领先\\n%h_rank1！\\n这种展开如何呢！",
      "source_fingerprint": "58c02cb89929558da90eb6d19d501e2bf89070404e06e0d362cb421780a26a4f",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6124"
      ]
    },
    {
      "uid": "zhcn:7ca576242d956e36cf2e92b5",
      "kind": "race_jikkyo_message",
      "source_text": "各赛马娘挤成一团\\n展开了大混战！",
      "source_fingerprint": "deb8cd28c2817db1981c8d3dd46980e8aeeb983ca6ff9ddd5595c406bfcbd464",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6125"
      ]
    },
    {
      "uid": "zhcn:2f3446223a2f6f04e014ca9f",
      "kind": "race_jikkyo_message",
      "source_text": "是第一名稍微有些快吗，不知为何\\n队列变得纵长了",
      "source_fingerprint": "c0ec780363ef35c63611281077d922f7de611876190fc7a343751caba355c699",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6126"
      ]
    },
    {
      "uid": "zhcn:d3090785633bd25cea0da84b",
      "kind": "race_jikkyo_message",
      "source_text": "是第一名稍微有些快吗，不知为何，队列纵向展开了",
      "source_fingerprint": "507eb933c0063e92479a5451793562202646edfd86abcd50d1e59dedc86a8b27",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6127"
      ]
    },
    {
      "uid": "zhcn:cd9090043827de6ba6d17102",
      "kind": "race_jikkyo_message",
      "source_text": "是第一名稍微有些快吗，不知为何，队列在缓慢展开",
      "source_fingerprint": "a3456fc875c311f4cb864240c0ca42fcef27eeccc6c8d767aa584246ff3fb9fa",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6128"
      ]
    },
    {
      "uid": "zhcn:f83594d796735eb015467953",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1！\\n太强了！　还留有余力！",
      "source_fingerprint": "3de6e890f4fea61b925e0345289dfd6c8bdda8bcef706d809b8c57f218a5786e",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6129"
      ]
    },
    {
      "uid": "zhcn:832c609b8bc2e23a5033d03e",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1要在这里一口气突围吗！",
      "source_fingerprint": "e5b6c422c479723092b5a3ea00f0e101e6981d989249329b26c80b6d56c13a79",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6130"
      ]
    },
    {
      "uid": "zhcn:c3b86c32cbc9e909f52b65c2",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1好快！　太快了！\\n一马当先了！　已经一马当先了！",
      "source_fingerprint": "28ca50193514be4e06cf29d2e8332f48db6f11ff910f8473f6ecf80931ea6b0d",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6131"
      ]
    },
    {
      "uid": "zhcn:8fadca023454ca7742e771c4",
      "kind": "race_jikkyo_message",
      "source_text": "%a_horse1冲了上来！！\\n要一口气缩小距离吗！？",
      "source_fingerprint": "14b7a9b4ac378754948df389ff536821ec9ba97c433e533d9e4adc60e74b56ad",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6136"
      ]
    },
    {
      "uid": "zhcn:6aa5b970a753b6ecdc2108b3",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\\n从夹缝中突破",
      "source_fingerprint": "f80701a9ef7b54830c55341cf01a4c295ecd9e4e7d321d67b609f425a476479f",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6137"
      ]
    },
    {
      "uid": "zhcn:c82c3ca0f2cc493782aea23d",
      "kind": "race_jikkyo_message",
      "source_text": "被其他马娘从最外道赶超了\\n%a_horse1\\n即便如此她仍在奋力追赶！",
      "source_fingerprint": "96edf3854ad4a144d5e7216fa885eb6e74bc0a277a6eff5abafcbf27786bfb93",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6143"
      ]
    },
    {
      "uid": "zhcn:5788f60a099266727785c390",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1要赶超了吗！",
      "source_fingerprint": "bbd1175ac5e41085a2f60a72cee5e48195158c558baaf6144dd9d22ab3468740",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6144"
      ]
    },
    {
      "uid": "zhcn:fe6c9d3669d11594ebb8b752",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\\n正朝领头队伍前进！",
      "source_fingerprint": "b66442b655757d995728caad8f1633492c0a09daf88d5bf8d78343459757a3c3",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6145"
      ]
    },
    {
      "uid": "zhcn:d9453c27699894fc5c3cb254",
      "kind": "race_jikkyo_message",
      "source_text": "几乎没有差距！",
      "source_fingerprint": "d6add30bfd5298f867df2c0139d15a011e0acd2d83a9a5219ef88931bbb5b03b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6147"
      ]
    },
    {
      "uid": "zhcn:ce5d788a8bae715e66761c09",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\\n脚步完全停了下来！\\n有点疲惫了吗",
      "source_fingerprint": "84e382966005c5834ba7c647141d021dc77666455cbcaab997b5fb841512a0a9",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6148"
      ]
    },
    {
      "uid": "zhcn:f671d930685481a4cb1fe77d",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，停下了脚步！？\\n后方集团可在迅速靠近啊！",
      "source_fingerprint": "3ee83e29f2932d1d42e17fb5659cea338b680c5cf6fe7c276811dbaa1fd34078",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6149"
      ]
    },
    {
      "uid": "zhcn:51fa88985194332eec7be6d1",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，陷入到了后续集团里！",
      "source_fingerprint": "1f1bb7d09302f84fd390249a72bdc5ed30f88e76346983ba47ba75490b82bed6",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6150"
      ]
    },
    {
      "uid": "zhcn:9f247c371d18072d98da2361",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1拼命追赶着",
      "source_fingerprint": "bea49fa14f0fe92a099fe6ac5f59d14e5a0061e847bf179834bd35c5bb80b57a",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6151"
      ]
    },
    {
      "uid": "zhcn:0dcc47ff64ce132bc8411a0d",
      "kind": "race_jikkyo_message",
      "source_text": "要有所行动了吗，%a_horse1！\\n这样下去会很难追得上吧！？",
      "source_fingerprint": "b019c86cb261bbf7f60ca2b91e534374dd29c4ea2233a87a3187c1353ab99de0",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6154"
      ]
    },
    {
      "uid": "zhcn:6d6731892594d4a5f2ded3b7",
      "kind": "race_jikkyo_message",
      "source_text": "夜雨使人有一种动荡不安的预感，%course\\n%ground%distance%race\\n%h_num_no赛马娘前来挑战",
      "source_fingerprint": "24869fa8171b0f6125dd0d3fad5078eb37dd8f81a57eb4f486edfe2709ff4bb8",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6155"
      ]
    },
    {
      "uid": "zhcn:4ae83236a9c02c89a4f775a2",
      "kind": "race_jikkyo_message",
      "source_text": "这是想立于领先之位的气势！",
      "source_fingerprint": "e14b4a1d6eeb0a7cca727890f02e617a879a97b0ec9784160801a84535a39a27",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6156"
      ]
    },
    {
      "uid": "zhcn:31fc1ed5bada15400ce63fcd",
      "kind": "race_jikkyo_message",
      "source_text": "%h_player，正瞄准前方",
      "source_fingerprint": "137f59be5083362d6df43f46a64cb7b1746d9434838033b1e610da680742bc90",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6157"
      ]
    },
    {
      "uid": "zhcn:79b2ad08eeae467747ba2e49",
      "kind": "race_jikkyo_message",
      "source_text": "拥有潜力的赛马娘们现在\\n站上了起跑线！　GROW UP RACE！",
      "source_fingerprint": "7ad1552943c2d1849d5a817c051c08318a5a46dadedf273a6d995b27fcd614e9",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6158"
      ]
    },
    {
      "uid": "zhcn:1c5dd785fe7766df0bc040e3",
      "kind": "race_jikkyo_message",
      "source_text": "第一名是%h_player\\n让我们看到了她的巨大潜力！",
      "source_fingerprint": "0ff8aead5458172d125140fbf1d54274801acf5dd82b86e27fa635c5afb4b0c3",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6159"
      ]
    },
    {
      "uid": "zhcn:c92ec6ffcbfc838046b4e7d8",
      "kind": "race_jikkyo_message",
      "source_text": "令人屏息的速度对战，一流短距离选手们\\n即将在WBC的舞台上展开角逐！",
      "source_fingerprint": "1e9946cef30a00d9438bed09202df1d290cc9d298039f0f845abc385d490416b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6160"
      ]
    },
    {
      "uid": "zhcn:26dd3b113d121204ea0f3cd9",
      "kind": "race_jikkyo_message",
      "source_text": "以速度自豪的赛马娘们聚集于这里\\n请关注好这出令人屏息的好戏！",
      "source_fingerprint": "91f00f8fd4a7abd8e3b01cd55b8bff3c8dc459ff73471a7be6dff79298b36f3b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6161"
      ]
    },
    {
      "uid": "zhcn:628b26b9ba757c22ec1f7c21",
      "kind": "race_jikkyo_message",
      "source_text": "聚集于这华丽舞台的精锐们，\\n即将以英里赛之顶点为目标展开激烈竞争！",
      "source_fingerprint": "f684edf5b183475def4d8626c76eb37d2d8b322862b0fd881e15f21a99ec2eaf",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6162"
      ]
    },
    {
      "uid": "zhcn:9cea8863867d4d1bcdd0f9cf",
      "kind": "race_jikkyo_message",
      "source_text": "仅凭速度可无法称霸这英里赛事！\\n赛马娘们汇聚于此，即将展开火花四溅的对决！",
      "source_fingerprint": "3c3a7754e39087d36c92ea274c679abbc098d995ee54e46f7081b8a8e30f690c",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6163"
      ]
    },
    {
      "uid": "zhcn:ae407b876339a96d16570a4a",
      "kind": "race_jikkyo_message",
      "source_text": "考验速度与耐力的WBC CLASSIC！\\n齐聚于这个大舞台上的赛马娘们\\n今日将展现出怎样的奔跑呢！",
      "source_fingerprint": "49d5b0a47acc608eb177ca0ee698967a753aeda07d03244588aac5c807a0040c",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6164"
      ]
    },
    {
      "uid": "zhcn:6ce922f134c530657eb3bc1f",
      "kind": "race_jikkyo_message",
      "source_text": "此为追求速度与耐力的大舞台！\\n能率先迈进SWBC的会是哪位赛马娘呢！",
      "source_fingerprint": "5a26fe8d58695356eccbdc8024c87f38f9046330ec7a47210925d7855ef949f8",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6165"
      ]
    },
    {
      "uid": "zhcn:ad431ba3b60893443a1688da",
      "kind": "race_jikkyo_message",
      "source_text": "以耐力为傲的赛马娘们聚集于此。\\n\\n在这WBC舞台上，\\n我们究竟能见识一场怎样的比赛呢！",
      "source_fingerprint": "9275238dde52ae2782f1d546458dae2cd67c678334252406616db5e295fe2599",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6166"
      ]
    },
    {
      "uid": "zhcn:04e9d2c1e9d62ded7484e93b",
      "kind": "race_jikkyo_message",
      "source_text": "以耐力而闻名的赛马娘们才可挑战的WBC LONG\\n在这舞台上能够斩获胜利的\\n究竟会是哪位赛马娘呢！",
      "source_fingerprint": "eca28e370144db94f16f81c17a73f22fd912c02f77d9ceeefb625ab404e981b1",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6167"
      ]
    },
    {
      "uid": "zhcn:b26dc0dd6d6907ebdda4167e",
      "kind": "race_jikkyo_message",
      "source_text": "赛马娘们在此沙土大舞台齐聚一堂！\\n这场比赛定会变作各位沙土\\n豪杰针锋相对的激战！",
      "source_fingerprint": "81bd47a222bdf9bfce1e87278ccd4a311283ea916bec5fa6a929ac0589d02c18",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6168"
      ]
    },
    {
      "uid": "zhcn:acc9839386be146dfc658012",
      "kind": "race_jikkyo_message",
      "source_text": "齐聚了沙土强豪的比赛，WBC DIRT！\\n能拔得头筹的究竟是哪位赛马娘呢！",
      "source_fingerprint": "18fd7ed76c112c09352ef79dd061cd5adc4e552bd135c95b40ab8794f1eba187",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6169"
      ]
    },
    {
      "uid": "zhcn:1fe9cbd4f5a945327006ae05",
      "kind": "race_jikkyo_message",
      "source_text": "第一名是%h_player！\\n她成功称霸WBC，将胜利的荣光紧握于手中！",
      "source_fingerprint": "dd16e14bc9b6f1654377f430c1c2bea715003bba99deea2feb56c385413f27be",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6170"
      ]
    },
    {
      "uid": "zhcn:c27bd7e6bf2f35fc1c13fd82",
      "kind": "race_jikkyo_message",
      "source_text": "以速度而著称的强者们将在这SWBC上一较高下！\\n以更高顶点为目标的闪电战，现在开幕！",
      "source_fingerprint": "06e20ea6211f647294ce43894869b71f7f275c5d4970537da0a981ba37a4994b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6171"
      ]
    },
    {
      "uid": "zhcn:0ec3f8e33d069072ca999238",
      "kind": "race_jikkyo_message",
      "source_text": "等待出战的赛马娘均以速度为傲！\\n瞬息万变的闪电战即将开幕！",
      "source_fingerprint": "d217072cc618e9348c3bd197b444926137e7d56b95ec7fc2f50ac07e551974aa",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6172"
      ]
    },
    {
      "uid": "zhcn:4472aef0e25258251457c9b7",
      "kind": "race_jikkyo_message",
      "source_text": "以SWBC的头筹为目标的英里马娘们汇聚于此，\\n让我们聚焦于今日她们将要献出的精彩比赛吧！",
      "source_fingerprint": "06e5fa96fafdc7f26df675d6774cc01c9750c2a5d784fd81a2709761b1ea49d1",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6173"
      ]
    },
    {
      "uid": "zhcn:f0b5069020cdea10c3bde9ab",
      "kind": "race_jikkyo_message",
      "source_text": "让我们好好期待这场顶尖英里马娘们\\n即将献上的表演吧！\\n能够称霸这场SWBC的，究竟会是哪位赛马娘呢！",
      "source_fingerprint": "c4703cd120081706eb0faabc91dda56f65e4c5efbd97868d2f7d400c5071e9b0",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6174"
      ]
    },
    {
      "uid": "zhcn:22bf36acf4ddace173bed772",
      "kind": "race_jikkyo_message",
      "source_text": "速度与耐力兼备的赛马娘们\\n在这场SWBC中会拿出怎样的表现？让我们拭目以待！",
      "source_fingerprint": "58748397194cc37fce2d60f70864d38fdff158d908954ccdecefb92a45fb2625",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6175"
      ]
    },
    {
      "uid": "zhcn:cfc62dcd192ad8f293c42832",
      "kind": "race_jikkyo_message",
      "source_text": "被选中的赛马娘们将会凭借速度与耐力交锋！\\nSWBC CLASSIC，即将开幕！",
      "source_fingerprint": "f48683acbe6da848985acac155a9af67f7c0a2ee2e3a4d006bcec69cf017522d",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6176"
      ]
    },
    {
      "uid": "zhcn:5c8ab3330b0ae2da361bba7c",
      "kind": "race_jikkyo_message",
      "source_text": "以耐力为傲的赛马娘们就此展开决战，SWBC LONG！\\n能够称霸这长距离赛道的究竟会是哪位呢！",
      "source_fingerprint": "0caa1084ffd6aee0e6e9aea90595b721e52b4974e804110c798933f0dee85234",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6177"
      ]
    },
    {
      "uid": "zhcn:ed22b5e2c980cfafe3fabced",
      "kind": "race_jikkyo_message",
      "source_text": "以耐力为傲的精锐们集结于此处，\\n赌上SWBC的荣光，SWBC LONG开幕！",
      "source_fingerprint": "de634faf25aaddfa611d07d93559a2fbcc3e04c665eaea14bdd3bd16aa9e089d",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6178"
      ]
    },
    {
      "uid": "zhcn:4c1ad4db0489a173c899bb22",
      "kind": "race_jikkyo_message",
      "source_text": "砂尘中映照而出的，正是SWBC的荣誉！\\n如今，赛马娘们在此挑战SWBC DIRT",
      "source_fingerprint": "11ab725c67699734df4b246a0a947cf13f7d3f07e0614e747464641f2e4fe529",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6179"
      ]
    },
    {
      "uid": "zhcn:586aca5d95a163ea2fc6c5c3",
      "kind": "race_jikkyo_message",
      "source_text": "离前方很远的是%a_horse2",
      "source_fingerprint": "91355083bfd5c3796e6674471673f50c0c2dc70cdf896181c941c27b47bda8b7",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "618"
      ]
    },
    {
      "uid": "zhcn:3d94a2a81a45c9ebdbb4bede",
      "kind": "race_jikkyo_message",
      "source_text": "所有人都因这场赛马娘们的对决而心潮澎湃！\\n能够称霸SWBC DIRT的到底是哪位选手呢！",
      "source_fingerprint": "70e65200e857513d55b8b060a63ba5c5dc76a604a5aaafd9f6bd8fc17efdf13d",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6180"
      ]
    },
    {
      "uid": "zhcn:c23bdd51496bf47f6fa67fff",
      "kind": "race_jikkyo_message",
      "source_text": "%h_player_ta荣摘桂冠！\\n她做到了！她做到了！她终于称霸SWBC大赛了！",
      "source_fingerprint": "9392d366d020f67881e0a71eab7ad911a1145579529ba9567da899280dc01f84",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6181"
      ]
    },
    {
      "uid": "zhcn:69b9f3b337ece364bfa0bc4c",
      "kind": "race_jikkyo_message",
      "source_text": "集結以臻至极境的速度为武器的赛马娘们集结于此，\\n赌上这至高无上的荣誉，\\nGrand Masters SPRINT即将开幕！",
      "source_fingerprint": "b55276b459b21da96464261512bee5953414722ed20be9eb0484d3b271ec1149",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6182"
      ]
    },
    {
      "uid": "zhcn:2ed1d2ffd16a2cb0bdcccc08",
      "kind": "race_jikkyo_message",
      "source_text": "在三女神的守望下，\\n闪电战Grand Masters SPRINT即将开幕！\\n能够将“最快”之称纳入囊中的会是哪位赛马娘呢！",
      "source_fingerprint": "03d753460bff968e26548e326583103c2bc3f23e3a3b03530ee650e12f438931",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6183"
      ]
    },
    {
      "uid": "zhcn:7868262e33450e558ebed7af",
      "kind": "race_jikkyo_message",
      "source_text": "足以在历史上留名的精锐们，\\n今日齐齐在这场英里级赛事中登场！\\nGrand Masters MILE即将开幕！",
