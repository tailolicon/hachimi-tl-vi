        "636"
      ]
    },
    {
      "uid": "zhcn:68d944c1c7d445aba558e41d",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1领先\n第二名，第三名也紧跟不放！",
      "source_fingerprint": "d179d66429b8dbb8ab1474a03fc39a1634ea0a43b061a35302ffa89c02ea9510",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6363"
      ]
    },
    {
      "uid": "zhcn:850584e6226edee2cf242829",
      "kind": "race_jikkyo_message",
      "source_text": "最前方是%h_rank1，\\n但第二名，第三名正穷追不舍！",
      "source_fingerprint": "5942ae29be2497134b5903b026c0a224c1b332fa9a6a5ac010ec3be1c759c19f",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6364"
      ]
    },
    {
      "uid": "zhcn:f4aba38adc427aadcacd4a87",
      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1领先！\\n不过她与第二名，第三名的差距很小！",
      "source_fingerprint": "07466a8ea6b43256e90cacdf98856a4ff14e7c092de69332d55762d93e98198b",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6365"
      ]
    },
    {
      "uid": "zhcn:66f7838017bd3f4bb0ec1006",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，要被其他马娘吞没了，\\n她现在还有机会突围吗",
      "source_fingerprint": "44fed52bbd20411f570cf9ff795674fae9087c13a9cd033794f0bc89c33f86f6",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6366"
      ]
    },
    {
      "uid": "zhcn:680848d7c04c5f0986ea4970",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\\n脚步相当沉重！\\n陷入困境了吗？！",
      "source_fingerprint": "9a776bb232ca2854efb18f125c7dc1ce67c2b4ac36d0e27b2badd802a3a435c8",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6367"
      ]
    },
    {
      "uid": "zhcn:8ede48c3998e61caf4b5021c",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\\n在这里停住了脚步！",
      "source_fingerprint": "a24a3321ddd9c27b33645be42e36193870734eeafd9bb53f3ef583660051f3ba",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6368"
      ]
    },
    {
      "uid": "zhcn:16184601d58114589981f748",
      "kind": "race_jikkyo_message",
      "source_text": "哎呀，%horse1！\\n再次就耗尽体力了吗！",
      "source_fingerprint": "9ae1812ddad6c6a8c8dd94d664dd56516312a858f464f4b068898cf535a66945",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6369"
      ]
    },
    {
      "uid": "zhcn:259e3120e64e8abf88067c6f",
      "kind": "race_jikkyo_message",
      "source_text": "%a_horse1依然领先",
      "source_fingerprint": "af23508e6b5aba8cab4cf68c0af6b8b486d91285ade32b06352e625673e4b7c5",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "637"
      ]
    },
    {
      "uid": "zhcn:74474e157f0b8abfdd78312b",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，好像失去了冷静！",
      "source_fingerprint": "f1c3183cf1da28f28b1d31bb1e8b780979cbb33c5a86c2cdd14af160c2691b68",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6370"
      ]
    },
    {
      "uid": "zhcn:77e0eb631171e031e79f0457",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，冲上前来！",
      "source_fingerprint": "c1b5e1863539cab9329d21127f9e940fef9117d737b43840a9f282429125a3b5",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6371"
      ]
    },
    {
      "uid": "zhcn:d420c5a48b479d848fbc46a2",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，步调相当之快！",
      "source_fingerprint": "278d9da72450a66d271dac0e302f0f51dfaa169d4adde2aeed99920a77567dbd",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6372"
      ]
    },
    {
      "uid": "zhcn:501488d0046e6a386a6f82c0",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1就到此为止了吗！",
      "source_fingerprint": "257dc209aee9de23bf6adf20836935e15ea98f975c2e8140acafa9367b0c0b81",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6373"
      ]
    },
    {
      "uid": "zhcn:1cc257293c6a543e1293c070",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1\\n彻底停下了脚步！\\n是有些疲惫了吗？",
      "source_fingerprint": "cb51c3317f9e7d25ca9403250b27300f8de3e74dc35bf816b7065afc5c08c279",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6374"
      ]
    },
    {
      "uid": "zhcn:69cf1741016d02020f7f6033",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，停下了脚步！？\\n后方集团可在迅速靠近啊！",
      "source_fingerprint": "3ee83e29f2932d1d42e17fb5659cea338b680c5cf6fe7c276811dbaa1fd34078",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6375"
      ]
    },
    {
      "uid": "zhcn:bda82c6d98700f894092d4a8",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，陷入到了后续集团中！",
      "source_fingerprint": "78ca7e478a5be66d229ac834b97f59a910594f36a1a4ec1e161b43b06dcbfb0e",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6376"
      ]
    },
    {
      "uid": "zhcn:fe29fb74f34e6f82aab256e0",
      "kind": "race_jikkyo_message",
      "source_text": "%horse1，陷入了集团之中！",
      "source_fingerprint": "eba4285a6cacaab40b9fcf52a17f376fda62eee23dde1cb54edd629d1cebc1a5",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6377"
      ]
    },
    {
      "uid": "zhcn:4b5cfc08d90bf03ddad151a2",
      "kind": "race_jikkyo_message",
      "source_text": "要有所行动了吗，%a_horse1！\\n这样下去会很难追得上吧！？",
