      "kind": "race_jikkyo_message",
      "source_text": "%h_rank1能坚持下去吗！",
      "source_fingerprint": "e38e738563fd59007c3dc57f8142636824e96118ef4e332f5a4ab9866e706e29",
      "source_path": "race_jikkyo_message_dict.json",
