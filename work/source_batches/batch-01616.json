    {
      "uid": "zhcn:0e86f1dfa1ec511a5b4275eb",
      "kind": "race_jikkyo_message",
      "source_text": "在多云天气和躁动的空气中进行，\n%course\n%ground%distance%race\n%h_num_no赛马娘前来挑战",
