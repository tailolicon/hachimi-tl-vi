    },
    {
      "uid": "zhcn:6ccae5695ad47feba4ec2a7f",
      "kind": "race_jikkyo_message",
      "source_text": "上天赋予的试炼之雨，暗流涌动的%course\\n%ground%distance%race\\n终于要开始了",
      "source_fingerprint": "d0c9981184e87d2409af044e38690758b78e65e6da8702f0d4c14c4d77954442",
