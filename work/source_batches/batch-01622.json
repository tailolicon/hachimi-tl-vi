      "kind": "race_jikkyo_message",
      "source_text": "第3弯道转向下陡坡\\n各赛马娘陆续下坡",
      "source_fingerprint": "0c770c6b8a65d7ff2cf305c9737ea4f73e2b3303699f02af336fafd48bb60256",
      "source_path": "race_jikkyo_message_dict.json",
      "json_path": [
        "6486"
      ]
    },
    {
