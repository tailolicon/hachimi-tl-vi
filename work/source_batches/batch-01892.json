    {
      "uid": "zhcn:7c1c0186f2cd025e3e483836",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就决定是『日本德比』了！",
      "source_fingerprint": "1624000af03a1ed9913656e52319e196f23814da4d49c8b7087e2920caccd8ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
