      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:cd2e77ae05248e4d0d6daeb8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "魔法使一边盼望着能让大家更幸福，\n一边朝着外面的世界启程了――",
      "source_fingerprint": "c35d8efbb7e4deb3012fcd140fc9efd3e0a370d8469fcd1c3e4c0922891a32f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0002/storytimeline_020002011.json",
      "json_path": [
