      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日，『日本德比』！？",
      "source_fingerprint": "dafd5b92ddf345a129a10000c965e3a501f89e511034bed695ba749dedee16b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
