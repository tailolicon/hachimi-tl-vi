    },
    {
      "uid": "zhcn:9cf28be826d536b4aa3bf420",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴那悲鸣似的喊叫，仿佛让人联想到\n她今后的疾驰一样，穿过了训练场的跑道。",
      "source_fingerprint": "1a1f8725cfd7b9cd6adeddbcbcb5e4546ba8bde42a877182fb568715245e56b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0002/storytimeline_020002011.json",
      "json_path": [
        "text_block_list",
        61,
        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:ee8cc44006cce6eca22d826f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天亮之后，\n太阳公公照耀着外面的世界。",
      "source_fingerprint": "7111e0718762811baf77e32ae43232fa8282a2e18123e4d117382f7c8497033d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0002/storytimeline_020002011.json",
      "json_path": [
        "text_block_list",
