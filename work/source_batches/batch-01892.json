    },
    {
      "uid": "zhcn:18833a8320bab448c0075993",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就决定是『日本德比』了！",
      "source_fingerprint": "1624000af03a1ed9913656e52319e196f23814da4d49c8b7087e2920caccd8ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
