    },
    {
      "uid": "zhcn:443f4ad6a7786ef4ddb3b1f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴",
      "source_fingerprint": "d99d52ed25db0eb937105063cfedfb65e5d199dc54c299f063e87411d9cb2f20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
