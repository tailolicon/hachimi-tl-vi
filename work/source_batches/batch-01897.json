    },
    {
      "uid": "zhcn:10ac2696f19b42da01a9f331",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，到处都在谈论波旁同学呢。",
      "source_fingerprint": "8445a2139b2e71f4d620e47070ee362db138821cd58daf776eb5d9608792cacc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
