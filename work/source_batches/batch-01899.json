      "source_text": "但是我今天已经累了，就先回去了。",
      "source_fingerprint": "b288367956afd23d58ffab16c825de2c0d690d98e576ec7e4b71725ed23d7791",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
