      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "魔法使说道。\n『我想用魔法让大家变得幸福』",
      "source_fingerprint": "86fee7c68ef955b1323d4b8f07dd8ac0f913bc560528ab8f2549770e81fd16fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
