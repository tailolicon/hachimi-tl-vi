      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是这样的，关于『天皇赏』有件事想拜托训练员。",
      "source_fingerprint": "225ab52ec1da73016966ea656217f95c84ee65d88ff999aa42cd25f157b282fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
