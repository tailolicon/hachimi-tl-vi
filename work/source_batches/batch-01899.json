    {
      "uid": "zhcn:2912aa7344c78e16f50d275f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就在我们称赞米浴时，\n挂着横幅的气球飞了上来。",
      "source_fingerprint": "f03d82df38d5061821ef0e424468000a0e41dcb4ed2d1263ad2719f970f4ba5e",
