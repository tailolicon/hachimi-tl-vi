      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请让米浴同学也参加那场比赛。",
      "source_fingerprint": "60e9d5c2b51982b604a187bc1445b6c00130df8f86b0651dc285c12c4629ee93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
