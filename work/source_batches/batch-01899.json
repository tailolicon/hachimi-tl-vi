    },
    {
      "uid": "zhcn:0e87796ee860f90e48f08888",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "人们害怕世界的常识\n会因魔法而改变。",
      "source_fingerprint": "df01b7c79d77c59b2cc251ca5e0e67670077f3e01176b94815efe438e4a7012e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
