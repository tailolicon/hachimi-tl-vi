        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:473590b2f1e80535e0c7de78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，人们更加害怕了\n都躲着魔法使。",
      "source_fingerprint": "3024f7118ad8672eae03004d1d4fd84a30c56622e88526f3a61b60dac218ae71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
