    },
    {
      "uid": "zhcn:0da66e009530194a155bc882",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大半夜突然到访的目白麦昆。\n她的表情比平时要严肃许多。",
      "source_fingerprint": "38b09b3f5a712a51b9f48bd551c283f76f053626ae137f6deee052ed69928569",
