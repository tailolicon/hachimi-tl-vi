    },
    {
      "uid": "zhcn:ebf5d00a563f535ad62ec4f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴没有看向任何人，\n就这样低着头走出了房间。",
      "source_fingerprint": "e163f33f88c695fa9b7910cbd7df1454388b548b39f2f380febc287978d88d3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
