    {
      "uid": "zhcn:292db97066357ba1b85f44a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了证明自己的话，她用魔法飞上了天空。\n『你们看，这样的话想去哪儿都可以哦』",
      "source_fingerprint": "b4823f55af9e460bea7882c19c357be72f6b842ea9cf215d8e94b7eb254ef4f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0002/storytimeline_020002071.json",
      "json_path": [
