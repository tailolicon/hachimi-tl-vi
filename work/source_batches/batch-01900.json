    {
      "uid": "zhcn:965cf256af9b3f7b9bb26789",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对目白麦昆来说有着重要意义的春季『天皇赏』。\n让米浴也参加的目的是什么呢。",
      "source_fingerprint": "9594d1c41fb19a6954f9d478522b543224778a1e993cd3dd197b62abddaf3412",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0002/storytimeline_020002081.json",
      "json_path": [
        "text_block_list",
