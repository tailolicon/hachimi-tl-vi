      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:e1ed6f958094fd70a527e388",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成绩还不错。可是一旦变成竞争性训练\n她就怎么也赢不了。",
      "source_fingerprint": "a70b034dace9026e05120bd8455af8e0e9f43b70f338451838e960eb777f6f0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0002/storytimeline_020002081.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:51989e32ad9db173d3d572b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "果然由于『菊花赏』那一片嘘声，\n她的取胜心被削弱了吧。",
      "source_fingerprint": "5537db5820221d0897ef7f45883b95e7f43b24dcfe6fba5f20ffaf3f6c3771b6",
