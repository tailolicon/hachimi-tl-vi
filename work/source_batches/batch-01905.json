      "source_path": "assets/story/data/02/0002/storytimeline_020002111.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:41d3e961abad55ff41040422",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是所有人都盼望着魔法使能好起来，\n能再次使用幸福的魔法。",
      "source_fingerprint": "cb7c58d195cd010f5d68a34afaabe03ec94cda627f2d0f3894b7877cbe03efbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
