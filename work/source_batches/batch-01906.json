    },
    {
      "uid": "zhcn:5a805ae534373dc0dbaacd3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——尽管如此，已经有好几场比赛都没拿到好结果了。",
      "source_fingerprint": "7a0e746c53d7d3c657d1d19f37f30c303754372340ab9fefe324b0ed4a2bed5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
