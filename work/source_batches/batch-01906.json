      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:265cd768afc2480e46c3ed98",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春季『天皇赏』获胜的时候，\n确实米浴的想法变得积极了。",
      "source_fingerprint": "05272aba86294bbbae62a3c59de194b70ac0fe5c0c8a01f9f1e74974fe9b9963",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
