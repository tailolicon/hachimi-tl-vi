      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:59da1ba4a06c3925bb795c81",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "魔法使在众人注目下，定下决心使用魔法。",
