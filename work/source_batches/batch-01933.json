        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:c2c0693c932e264ff20d3916",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁擅长紧随领先集团进行比赛。\n因此，所处位置的优劣程度非常重要。",
      "source_fingerprint": "dd33f1a2b8bbf3614232752d31db906c8c214138b28c6b6d615787afb3c47c25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0004/storytimeline_020004031.json",
      "json_path": [
