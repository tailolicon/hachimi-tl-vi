      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明明是为了抚平心中的不安才开始调查的，\n但越是调查，心中的不安越是膨胀。",
      "source_fingerprint": "5bfd99cab057a4d4c311eca6654ef1f52fc1679b98c7a6f78dc6bb4ecd2d35ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
