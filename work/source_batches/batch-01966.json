    },
    {
      "uid": "zhcn:d07cceec30af9ccf63f68a98",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿起跑后立刻一口气加到了最高速度。",
      "source_fingerprint": "5b739da8fff9e94c2dadefb9d6c11c7a8e6dae0dca55abd6ed1a55e90e5a1efb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0005/storytimeline_020005112.json",
      "json_path": [
