    {
      "uid": "zhcn:7dc072a3fe3435dbfc93fc3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿不安地注视着我。",
      "source_fingerprint": "298344782d9054e45be3958697f2bd3d92cddc3a6d0fd23aff07609183a398f6",
