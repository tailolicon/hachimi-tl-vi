      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，我们在『宝冢纪念』上再见证一次那片“景色”吧。",
      "source_fingerprint": "ed6b16258a161b21b0d6aa3d70739f5f975be5176a5d101d082b8bcb2379b7a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
