      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和无声铃鹿一起，追寻至今的“景色”——",
      "source_fingerprint": "f63c56552daf2307bb9460faed04f3741c8331bc256c8190fd2d23f86814ceb8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
