    },
    {
      "uid": "zhcn:c71c8e00630103774f062f8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "该不该阻止她那一心怀揣梦想的步伐，\n我的脑中像是蒙上了迷雾，找不到答案。",
      "source_fingerprint": "5d0c91178c5e19a71cc135eb47699dd0c11f82f4cbc9d4c3364880fae801975d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
