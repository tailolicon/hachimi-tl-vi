      "source_language": "zh-CN",
      "source_text": "但是，我不打算满足于此。\n对于奔跑的渴望，至今仍在促使着我前行。",
      "source_fingerprint": "349887c3b56fe81faef7eac6f853d085ded35c9040ae05db37efab1a073ad2e0",
