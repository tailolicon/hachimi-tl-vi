      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也拜谒了她先前的比赛，实在是令人印象深刻的精彩表现呢～",
      "source_fingerprint": "8ac025137eab165b038917de7ac24ff0e31cc1030a80a37689df419fd241bf32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
