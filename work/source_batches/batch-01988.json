      "json_pointer": "/text_block_list/55/name"
    },
    {
      "uid": "zhcn:d82bed45362e484f611840c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……小特。铃鹿的奔跑始终萦绕在你心中，\r\n所以你也想要像她那样奔跑对吧。",
      "source_fingerprint": "9754fe01482d9c087b386d266176d1ea19d0e9af3dcbd9bc68b28d2554040a37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006101.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:46233d43ae090e65d5de44d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周",
