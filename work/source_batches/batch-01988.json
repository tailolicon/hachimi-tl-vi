      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那，你为什么对铃鹿的奔跑念念不忘呢？",
      "source_fingerprint": "ca3e48a81104f7e9374ef138b681b30ba7f0535defc104ae74ed48c6aa203ba9",
