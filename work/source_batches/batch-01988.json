      "source_language": "zh-CN",
      "source_text": "是的……！就是这样！\r\n铃鹿同学的奔跑，总是能凌驾在我们的期待之上！",
      "source_fingerprint": "3f2255876636963953938a8534169018ecab705cf029c9c6413eda0f39486234",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
