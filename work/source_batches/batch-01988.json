      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以才会不自觉地沉浸进对她的想象中，\r\n想要亲眼见证以后的她会带来怎样的奇迹……对吧。",
      "source_fingerprint": "af9cb543b29966c1ba1e1223e33fc41dcd17ebb6afa0e4128d119384640433a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
