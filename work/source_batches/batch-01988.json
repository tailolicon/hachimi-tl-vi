    },
    {
      "uid": "zhcn:81da593ae99759850dce076d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白光明",
      "source_fingerprint": "0cce4d859896c50ae77983029951d94a41ba9369dc531a5184d37f6b802e9b98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
