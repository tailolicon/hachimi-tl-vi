      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且无论何时，都不懈地追逐着自己的梦想——",
      "source_fingerprint": "3288619657b9b89734101c74150e75893a3a42b322b440adb61d6e693d4455fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
