    {
      "uid": "zhcn:c3bd7c643257f885f1a36464",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，训练员直率的话语总能将我从逆境中拉起、\r\n推动我前进。",
      "source_fingerprint": "19ac30bad7d0e1eb518e3b5d45298a36f9276b91bb76cb1b9576298f3eeff15e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
