      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:795011a26158a1f7cfbe626d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我根本找不出她会低沉到这种地步的原因……\r\n我将我的处境告诉了一直默默聆听的无声铃鹿。",
      "source_fingerprint": "54847ec712e8ce5c687193b1a0f138f4a51c2ed713d1af493db8a05fbcbf044f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
