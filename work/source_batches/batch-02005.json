    },
    {
      "uid": "zhcn:8b3f439dd6ed957922a6b132",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们都是最明白训练员的——\r\n训练员把我们看得比任何事都重要。",
      "source_fingerprint": "f317411ad7d03e3a1e29229c0d4aee7bdf0ce47ab0185c054d9154accc941621",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
