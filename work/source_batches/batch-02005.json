    },
    {
      "uid": "zhcn:39d4a1f77708940576ff2ff6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我究竟，是怎么看待特别周这个赛马娘的呢？",
      "source_fingerprint": "20fd7228807723e60c2e074c5f170758313e4703926f7f32710b50844fa01cf9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
