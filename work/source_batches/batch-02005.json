      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的奔跑总是洋溢着活力——",
      "source_fingerprint": "49eb5810c2c30204cad20f989a34e80380db967a44c392f819c29044401ccb3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
