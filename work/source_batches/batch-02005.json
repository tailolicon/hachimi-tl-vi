        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:63adc4755d34692b95023d34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的……想法。\r\n该告诉特别周的话语——",
      "source_fingerprint": "e60413b9b9b21a7d78d3e22432156a5d8f5769c7f51fe28ceae240bf4191a639",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:c32d82fbe403d2355157e69c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的……想法。\r\n该告诉特别周的话语——",
      "source_fingerprint": "e60413b9b9b21a7d78d3e22432156a5d8f5769c7f51fe28ceae240bf4191a639",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
