      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "单纯地喜欢着奔跑、同时也非常执着——",
      "source_fingerprint": "ae3db315acab67f726e50eff9f497628e74c6793789de95cf6fc548cfed938dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
