    {
      "uid": "zhcn:aaeaa37c1145fa968e6a5832",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周",
      "source_fingerprint": "d2006eb90c4483cd2444ac5e7378edb673044470d41a5dd967aaabbc498929a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
