      ],
      "json_pointer": "/text_block_list/61/name"
    },
    {
      "uid": "zhcn:0c308afbbfbebb03bf975ff1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我还远远算不上日本第一，考虑这种事情也没用；\r\n现在应该别管这些事情好好努力，这些道理我都明白……",
      "source_fingerprint": "8ceeeda62c3edf92ae51bba9a4aa0a8b7b86b723d6e38d2d17cb9d8457f626d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
