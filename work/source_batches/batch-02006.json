        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:57275d652829cce9e2a975e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周",
      "source_fingerprint": "d2006eb90c4483cd2444ac5e7378edb673044470d41a5dd967aaabbc498929a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        62,
        "name"
      ],
      "json_pointer": "/text_block_list/62/name"
    },
    {
      "uid": "zhcn:a6c59bc327bf4d136fbb51bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我就是会忍不住去思考……\r\n“成为日本第一的赛马娘”，这到底有什么意义呢。",
      "source_fingerprint": "9385d95e42c20294c8183420feecc4ef71b33804101b4f58821f26c91a43da9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        62,
        "text"
      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:167fbae386cfc3c2d86635e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周",
      "source_fingerprint": "d2006eb90c4483cd2444ac5e7378edb673044470d41a5dd967aaabbc498929a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        63,
        "name"
      ],
      "json_pointer": "/text_block_list/63/name"
    },
    {
      "uid": "zhcn:332717ef9cf377215a957834",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我所做的一切，又有什么意义呢。\r\n继续奔跑下去，究竟有什么意义呢……",
      "source_fingerprint": "b5278d848c73e8d87aee9bde176662af0b661cf6ab97c135651091288f61802e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        63,
        "text"
      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:64856a226e536fcaf69976e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "遭遇败绩、海外远征计划的破产、\r\n再加上被视作目标的挚友也战败——",
      "source_fingerprint": "bb8b43d644619a1dace935087681efa1062ce2612761cf34db8c6b9aa617a023",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        64,
        "text"
      ],
      "json_pointer": "/text_block_list/64/text"
    },
    {
      "uid": "zhcn:97591717e41cc2c0cb899fc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接连而来的打击，已经让不懈朝着梦想奔跑的她彻底陷入迷惘。\r\n既然这样的话……",
      "source_fingerprint": "a155b8be7cfd24d23705bb05ddcd948ca6d54401fcc28eebc1e911ede41a7867",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        65,
        "text"
      ],
      "json_pointer": "/text_block_list/65/text"
    },
    {
      "uid": "zhcn:97c937e3b1ae5afeee7d5a2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        66,
        "name"
      ],
      "json_pointer": "/text_block_list/66/name"
    },
    {
      "uid": "zhcn:03435982ab72f210ee8dd222",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——在第一次见到那个赛马娘的时候，\r\n我觉得她是个相当不靠谱的姑娘。",
      "source_fingerprint": "b000a5b77d2ae6166a2845da82839ea7d9d0f0f345a632a456481da2f3f6507f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        66,
        "text"
      ],
      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:f3b6145e57462f02bb6b13c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周",
      "source_fingerprint": "d2006eb90c4483cd2444ac5e7378edb673044470d41a5dd967aaabbc498929a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        67,
        "name"
      ],
      "json_pointer": "/text_block_list/67/name"
    },
    {
      "uid": "zhcn:d1ec0bf64b2af10303f592d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……诶？",
      "source_fingerprint": "f161f665efce1e5ee1df388903c168da302fe1992cff1b29667536a61e16027e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        67,
        "text"
      ],
      "json_pointer": "/text_block_list/67/text"
    },
    {
      "uid": "zhcn:247ce7b18bf5ac665f584fd0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        68,
        "name"
      ],
      "json_pointer": "/text_block_list/68/name"
    },
    {
      "uid": "zhcn:4f5e089cdbfb1312130251dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，我也觉得她是个未来可期的姑娘。",
      "source_fingerprint": "6c1bb04449027942cffb09ef18a7f78b56ffe3e73b0e40a6fc877f1891ad7e98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        68,
        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:da67ab94a01b655a438d2af1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        69,
        "name"
      ],
      "json_pointer": "/text_block_list/69/name"
    },
    {
      "uid": "zhcn:75fc1efca21d103eb79a4c78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她凭着一腔热血就从北海道跑到这儿来，\r\n就连比赛是什么都不知道——",
      "source_fingerprint": "50722c2e0986bde79bab3cdc095431f8a40a3b5842ce3ddad40417bea62542ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        69,
        "text"
      ],
      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:8e95c18f23210107425c498e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在比赛中的奔跑与她一直以来表现完全不同——\r\n她简直像是忘却了自己奔跑的理由那般，仅仅是在比赛里挪动双腿而已。",
      "source_fingerprint": "1c509a4aaf1d520f2856bc37832b9c7aa148e2a12d13f30c6d157a02d9672433",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:9589eddc463c198fde1d6fa3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        70,
        "name"
      ],
      "json_pointer": "/text_block_list/70/name"
    },
    {
      "uid": "zhcn:a30e2117e4c3735ccee61c0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是她永远都朝着梦想全力奋进。\r\n光是看着她的努力，我似乎也被鼓舞了。",
      "source_fingerprint": "b841a9a5a9b0507487fd4cc7f3cce093711cd872981ab45f59a97f71f315dcb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:b7e1a399856b5794c6d02e5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        71,
        "name"
      ],
      "json_pointer": "/text_block_list/71/name"
    },
    {
      "uid": "zhcn:0d020b4b25c563e2e73bee6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她简直就像是传说故事的主人公那般，\r\n跨越无数苦难、永远心怀希望地向前迈进，\r\n人们不知不觉间就被她奋进的身姿所吸引……",
      "source_fingerprint": "f6b6d1ddaccafcf7c68f47256ae7abc038326548a5667cda7dbebc5d784f8a45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        71,
        "text"
      ],
      "json_pointer": "/text_block_list/71/text"
    },
    {
      "uid": "zhcn:60cee28d6c527a0827c4b9a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        72,
        "name"
      ],
      "json_pointer": "/text_block_list/72/name"
    },
    {
      "uid": "zhcn:eb17f60def65cdf79b3f274a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……小特，你刚才说，不知道自己所做的一切究竟有什么意义对吧？",
      "source_fingerprint": "fa8638a18a69b0550f1b7dd671d224523a4d78e0bf9a04379388c7225173b1f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        72,
        "text"
      ],
      "json_pointer": "/text_block_list/72/text"
    },
    {
      "uid": "zhcn:9308da06af0404ea7147022f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0006/storytimeline_020006191.json",
      "json_path": [
        "text_block_list",
        73,
        "name"
      ],
      "json_pointer": "/text_block_list/73/name"
    },
    {
      "uid": "zhcn:356a68c850a7478f035e804c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——你所做的一切，\r\n为我带来了活力、给予了我希望……\r\n同时，也创造了我的梦想。",
      "source_fingerprint": "ff517ec1949840756ea458a00983f1b618b14a80ce1398d461df5ea1caff667f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
