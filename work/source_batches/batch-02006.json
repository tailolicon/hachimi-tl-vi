    {
      "uid": "zhcn:dfe55ff4dedfd5007165b120",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "果然“日本第一”也就不过如此……\r\n我听到的尽是这种丧气话……",
      "source_fingerprint": "619696faeee933aff9cf91e5819bcac0128574676d0d2af7ef35d4716bf854d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
