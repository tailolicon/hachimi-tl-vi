    {
      "uid": "zhcn:a0a4367352a045eb9c9c823f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我――",
      "source_fingerprint": "d1c9835170aafd51851681608f8bfab85c6a08c5b86b534385a551ce10f23096",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201071.json",
      "json_path": [
