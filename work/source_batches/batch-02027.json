      "json_pointer": "/text_block_list/17/choice_data_list/0"
    },
    {
      "uid": "zhcn:3a2b0d7403dc82cbc0c7804b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，对于西沙里奥来说，\n那必须是最优先考虑『应对莱茵力量』的训练计划。",
      "source_fingerprint": "874de08a1f6065693587bbf82ae14bad7f8c9d3afa72062cc77aa9c2ea319b2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201071.json",
      "json_path": [
