    {
      "uid": "zhcn:1bd0df5aa0caa41b4cbcea9e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好……！那我们开始吧！",
      "source_fingerprint": "e4dcbb5c5608b6082fbf07a6e034f0c439af81f442259520b7c8dd4b1f025cfe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
