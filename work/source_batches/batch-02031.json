      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥",
      "source_fingerprint": "4368033ee11e70f9e85c989f7996583bc525328c9bc3374bbf30f33c6c962b0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
