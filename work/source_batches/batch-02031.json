    },
    {
      "uid": "zhcn:a1d0ca45543740f202cd2787",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的名声似乎响彻了特雷森学园，胜利庆祝会举办期间，\n又有许多赛马娘前来――",
      "source_fingerprint": "bc1032635f80e6f688aaf2557331f4d2eb02e07b51377ea19dbee2288a8558a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201091.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:db135b1ad3ad6237d856df93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
