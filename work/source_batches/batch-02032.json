    },
    {
      "uid": "zhcn:a3db420b0c744e6bcf3a12db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "未来？",
      "source_fingerprint": "8de4104b0587a38a6198cf91d5b1e3da989c32cc12ee9a45f4ca0cd0047b460c",
