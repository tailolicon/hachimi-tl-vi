      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请不要再懊悔下去了――\n不要再这样侮辱我的训练员了。",
      "source_fingerprint": "733d7d4375f2f584044d7d9ec99d5cb9467c82bd99d51a809c6a6937f80b2e19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
