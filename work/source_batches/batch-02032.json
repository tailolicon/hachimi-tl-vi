      "source_language": "zh-CN",
      "source_text": "训练员。我有种感觉……只要和莱茵一起，\n就能实现美好的未来……",
      "source_fingerprint": "bd238a37a3092cdb10939612f6e9fe863906c68574b166ae2717c546b91db9f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
