      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        22,
        "name"
      ],
