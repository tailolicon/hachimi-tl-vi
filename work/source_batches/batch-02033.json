    {
      "uid": "zhcn:6c14c73a2c9bfcb8e13313d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我知道。是适性方面的事吧",
      "source_fingerprint": "aa60bdddaa5b308e2bf1349d684ab8c269bcee40d48dd3c4ab59282cfc077fe7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
