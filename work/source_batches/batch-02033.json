      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:893482d7b593ceea06832709",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "扬名历史的女王赛马娘们出现在画面上，\n电视放映着她们从容接受采访的样子。",
      "source_fingerprint": "b25ec00e449c524124ab20d86d149efff6fc47fc28b4466efa5bd244b091d822",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
