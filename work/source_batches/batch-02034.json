    {
      "uid": "zhcn:82763e19a428d43e213fb748",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花赏时的莱茵……真的太厉害了",
      "source_fingerprint": "953d169c9dd9a048189251e76495af77e8181fe86aafb54b580d10bf68402874",
