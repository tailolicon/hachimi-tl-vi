        35,
        "name"
      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:4e227ec67a14f71c8892f7f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只有那种，将自己逼到极限――哦不，\n是必须超越极限的比赛，才最能让我变强。",
      "source_fingerprint": "c8ea6e45d968255b7a12cc0042a2f794fef4deb855e502114d9156082ad755b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:7e4a8e72d7fdc1c880100048",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱亚马逊",
      "source_fingerprint": "9e46e1b1d0b91c1ce1fa11c6823587aa41504c815d8da191f269c6fd336b6c12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        36,
        "name"
      ],
      "json_pointer": "/text_block_list/36/name"
    },
    {
      "uid": "zhcn:2c8306459e23569929e83538",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以啊，偶尔有人问我怕不怕，我是一次都没怕过！\n不如说我高兴得很，兴奋和激动停不下来！",
      "source_fingerprint": "46cc347fcb12e3cc65eaee03892740d74d9ae6c1c862a45216c9fc64c54a123c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:5a78a271eba0bec16a6ae9ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱亚马逊",
      "source_fingerprint": "9e46e1b1d0b91c1ce1fa11c6823587aa41504c815d8da191f269c6fd336b6c12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        37,
        "name"
      ],
      "json_pointer": "/text_block_list/37/name"
    },
    {
      "uid": "zhcn:a8ba4a5e2fe141b54b68aa03",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和那个“怪物”搏斗的时候也一样！\n我啊，在单挑的时候，就是最强的！！",
      "source_fingerprint": "e93ecaa67b7f8de20bf1fa9672fdab66870c174f125a6b2303642ebdb57b0638",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:213d8616adfcee9ca5cac6cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱亚马逊。虽然没能参加樱花赏和橡树杯，\n但取得重赏5连胜，而且赢下了伊丽莎白女皇杯――",
      "source_fingerprint": "68dcb7d826efec4babbd1f0791c8167f37ec5885b3d3d5d2988853a78f4fef29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:3a3ba1e7d2f281b72b2dcc4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为时代的女王闪耀，以其独一无二的豪脚，在『有马纪念』中\n是唯一一个，只身与“怪物”成田白仁肉搏的赛马娘。",
      "source_fingerprint": "bd24d7f3d7729a0814b2426b18f3b5ada9d4d372f48e1d0df411ed05ebbd8810",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:fa43dc1d203cf355d117824c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但是――）",
      "source_fingerprint": "d61a180ae721f4e3b8887db1ea74e4a1701954e1e65b0f149ba0874ba38c88a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        4,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/4/choice_data_list/0"
    },
    {
      "uid": "zhcn:fe6df54a6cfb77b583fd8c2b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<username>",
      "source_fingerprint": "2414b340167d18f7f395d0abe85eba52db9d10870c84e4d7056ed2309246e334",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:a3bb3d7f324b4b88da99e9cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（因为这个，我也想过提出更适合莱茵的方案……\n给她一个新的选择会比较好……）",
      "source_fingerprint": "56e7e54721e5eda0919e72bdcc8686c92c9078cb46e7dfe0027904248e9c6323",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:b672b413ab28db2ca4cba58c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        40,
        "name"
      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:008b43f5e5f4dd573f50e4cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我有一位曾经荣登“女王”之座的母亲。\r\n当我踏出第一步……或者说在此之前，我就已经下定决心。",
      "source_fingerprint": "f517c61cb46bc40f9233b964bc32c5f978f9c44d64bfe62f915a6d3402cf8e12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:d389ad966c383cec693e3e0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        41,
        "name"
      ],
      "json_pointer": "/text_block_list/41/name"
    },
    {
      "uid": "zhcn:1060a441d469a5c86919fcab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成为至高的引路者。成为所有赛马娘的『理想』，\n成为为所有奔跑者绽放无上光辉的灯塔。",
      "source_fingerprint": "99cf1c09a1b89ae6eb022e4fbe73c0d32e8e6ad23837919f10a168bb2bca95fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:3eadbb4e55010ca1922565f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        42,
        "name"
      ],
      "json_pointer": "/text_block_list/42/name"
    },
    {
      "uid": "zhcn:4b95d8ead777e6d831cc901f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就是我的使命。\n我作为“女帝”而存在的理由。",
      "source_fingerprint": "17ca705578f45a465826d8eeb76a2995abf6785295b97bfbb48729095ff20456",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:ba24b6e2c9c77ee37a942da2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        43,
        "name"
      ],
      "json_pointer": "/text_block_list/43/name"
    },
    {
      "uid": "zhcn:a3b9746b54b8cd0445e9cc79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此，我不允许自己退缩。不管是怎样的战场――\n哪怕是『天皇赏（秋）』，哪怕是『日本杯』。",
      "source_fingerprint": "5d83e042a14cfc964e22131b5fabaf53dccc995ce35acc5e4e8458cd89b17de3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:0f29932596c43142b33b8256",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        44,
        "name"
      ],
      "json_pointer": "/text_block_list/44/name"
    },
    {
      "uid": "zhcn:8ecf4bc0b13ad59f73ca0b88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "威风堂堂地赴身战场，赌上此身一切力量，去夺得胜利。",
      "source_fingerprint": "b80f617cbea570b1dc8019d0a0c780f09bbbf65f2575df4393a9a1fb85d7f27b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:699821cc5799e28064e1e804",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        45,
        "name"
      ],
      "json_pointer": "/text_block_list/45/name"
    },
    {
      "uid": "zhcn:e36238cdf78fcfd3cdc8bf21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只有不断挑战的背影，才能让后继者们最为之振奋――\n这份确信，推动着我向巅峰前进。",
      "source_fingerprint": "30d110fb32481f9a8ba36651c318c5d4b9636615e129a37e12772052dd91faa3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:ec9d03836e9676e24cb9592f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽。作为后冠路线出身者，首次制霸中距离『天皇赏（秋）』，\n成为了众多名赛马娘的指导者。",
      "source_fingerprint": "bfa0b78d6c6812529f54d7c334668fa66ca1f2b90791f84c7063c8b8f2d37827",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:dcee504e3fa6fb0245e6a634",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是走出了自己的道路",
      "source_fingerprint": "f759a0facbc3c640234aa46ec66aac6049c2858c2e4181825ed51a2431b73585",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        47,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/47/choice_data_list/0"
    },
    {
      "uid": "zhcn:f74dee71765a73b3e645c947",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我死死盯着画面，绞尽脑汁思考着。\n将名字刻在历史上的伟大赛马娘们。她们的共通点――",
      "source_fingerprint": "f325b5daa1d0255d7e1df62e444bb4bed3dace5e2edc8198d40aa6b53cd91080",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:8f4b2512bdece6fd729ed28a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们对自己的梦想，目标，和使命都抱有强烈的信念，\n并为了贯彻这些――下定了决心。",
      "source_fingerprint": "4810e3843f302c522b1febbec3e102ed2b97b43686c6d3f84e151bb1035b5f0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0201/storytimeline_020201101.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
