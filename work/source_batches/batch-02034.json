      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（所以，现在……莱茵力量才会在这里。\n才会选择走在这条道路上）",
      "source_fingerprint": "fa3cddea18558b909b1ef6ec64b42c0f9d4667bea7d57006b976351f5b506908",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
