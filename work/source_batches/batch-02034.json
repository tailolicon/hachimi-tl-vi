    },
    {
      "uid": "zhcn:6ba56f21f9fc559c520aad38",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们自己思考，决定，并选择了道路。\n然后――",
      "source_fingerprint": "534dd03d32b2ebb896e6911dbf0910749a87ad1dc00ad3ce765f3560255d1f4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
