      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:2051dcc858877e2098aa927a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一直揣在怀里，不知如何处置的一封信。\n也许这就是――",
      "source_fingerprint": "06adb01052730abfd4d055cd215132b53007d9eff77c7b432f2b8447337c51f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
