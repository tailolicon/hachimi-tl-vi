      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:09624dd0ca1b641fe826c64a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "深深陷入烦恼的西沙里奥。\n现在的我应该为她指一条明路。",
      "source_fingerprint": "a168a6ad31e202b20dc409e6b443bd7ed53140a4f86c07e6ff0b6f67ce385584",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0202/storytimeline_020202041.json",
      "json_path": [
        "text_block_list",
        46,
