    {
      "uid": "zhcn:d07595ebfc1ab441f02ca319",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是……我该怎么做？",
      "source_fingerprint": "f8467b1b3495112691e915f0f17fc276f2aba62a7186d01f898611643da9683f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0202/storytimeline_020202041.json",
      "json_path": [
        "text_block_list",
