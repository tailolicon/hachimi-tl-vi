    {
      "uid": "zhcn:1c35c0572eeeaf4a5bf22714",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也想为后世留下胜利！\n将我坚定的决心，化作后冠！",
      "source_fingerprint": "0691960e0495353e057285637c09b20ca1490b1f019574d4b70efce23ae61f56",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
