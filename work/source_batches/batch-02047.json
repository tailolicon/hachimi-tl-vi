    },
    {
      "uid": "zhcn:67b052f3c104f1c772ca3933",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个人给的建议有着不可估量的价值。\n无论如何，就算是要推迟赴美，我也得请教那个人。",
      "source_fingerprint": "c1d36a7bbfc29962a70bc5954936c180245e34839b03fd4197bc77a6952de542",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
