      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想了很久。\n至今为止做过的事，以及今后想做的事。",
      "source_fingerprint": "ebe4a37b2136f9628a50210abadac76fb349642a0505b1a0912f80533b531f1f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
