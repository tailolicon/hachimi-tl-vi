      "source_language": "zh-CN",
      "source_text": "我注意到了奔跑以外的道路。\n我已经得到了足够的回报……",
      "source_fingerprint": "510332ca62f9e5fdd8862cf77564f738cd166cf38672fe5d5fa84cf7173da945",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
