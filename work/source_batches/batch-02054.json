      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救主",
      "source_fingerprint": "85ef53fb8635b9aefa68abe48d871020a3010e8df2728dd8746fd9211a7c327c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/02/0202/storytimeline_020202091.json",
      "json_path": [
