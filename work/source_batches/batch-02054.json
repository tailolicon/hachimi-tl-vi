      "source_language": "zh-CN",
      "source_text": "让我觉悟了。我完成了蜕变，\n超越了自己，才赢得了胜利。",
      "source_fingerprint": "f624af8a8373557bfbd603b4febee043a98815e6c0c98947b984b64f927c5536",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
