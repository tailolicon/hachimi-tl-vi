      "source_language": "zh-CN",
      "source_text": "可能是因为……在夏季庙会这样快乐的地方，\n和最喜欢的人一起吃吧！",
      "source_fingerprint": "ae54fdb05696fea8886be8b93ecb0ddca6841f968ea1adb5f434e748ac509987",
