      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:968f7a6b7978befbd0976f3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，我坐上了丸善斯基的“伙伴”――",
      "source_fingerprint": "9a1d7437f6fc0d012863b7c684e75fa9d6e348b2105d5eb74ff3732c3e3c827b",
