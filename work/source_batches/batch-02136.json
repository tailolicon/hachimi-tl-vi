    {
      "uid": "zhcn:26cf2a0ed0b707f037232aa4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员。如果你愿意的话……\r\n从今以后，你也能继续去引导我吗？",
      "source_fingerprint": "845538efb632b5bdc6087d6c8c5d228b18d3d649a32744145d3afb3cb9fe4749",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1005/storytimeline_041005004.json",
      "json_path": [
