      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:8d36e8ff87ebf79c9284de4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你还好吧？",
      "source_fingerprint": "824bc6f567ef6813a6980544b62d03779e676fe122f124a7e174fc0e48c7a64d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
