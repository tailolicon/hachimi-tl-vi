    },
    {
      "uid": "zhcn:ac855fc597b319c49b067e5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你现在的梦想是？",
      "source_fingerprint": "9ab57afabf6c20fd082a1cad11a3f9ed0c7a6772af6bfbbac056f73753486b0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1005/storytimeline_041005005.json",
      "json_path": [
