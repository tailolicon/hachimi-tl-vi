    },
    {
      "uid": "zhcn:fb41582c43e08b33fe8fdc45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你现在的梦想是？",
      "source_fingerprint": "9ab57afabf6c20fd082a1cad11a3f9ed0c7a6772af6bfbbac056f73753486b0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
