      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:ce31d76cadf2b2971e44c4a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然！请多指教！！",
      "source_fingerprint": "675869e6919c89fff0d4ebfb72c835016ce8afd49d082a2ce9d9058f76556921",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1005/storytimeline_041005004.json",
      "json_path": [
