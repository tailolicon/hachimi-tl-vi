    },
    {
      "uid": "zhcn:0d136d67bfedf8f80c142689",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "托付给我『身为马娘的梦想』――吗。",
      "source_fingerprint": "2c32087e7595d3dc9bd9cb7e7b602fde0d7565977af2be67d5fdbb23572e2576",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1005/storytimeline_041005005.json",
      "json_path": [
