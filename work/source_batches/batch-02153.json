      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她起跑还可以，位置也还算不错，比赛就这样进行下去――",
      "source_fingerprint": "845432c108f6e61bf70271e4ef0b0f39681c95e8ba422960bb6a8c8f9c0ac502",
