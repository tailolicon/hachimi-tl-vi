      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽管被她耍得团团转，但看着离去的黄金船的身影时，\r\n我开始想她会怎么跑。",
      "source_fingerprint": "ded1ffca895b264a9e604d965e47dc5cf99bcec2cc1c79ee2bc05b1b085c8a1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
