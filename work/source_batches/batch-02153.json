    },
    {
      "uid": "zhcn:4d921304d8ca6dd2b77a891b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，黄金船的出道战开闸了！",
      "source_fingerprint": "7c0309f9e39f2166f7c5c314b9b70e9f8baac662788053204e360d5ff5b4f8bd",
