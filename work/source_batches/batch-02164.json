      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:c2310aba245cb2db3bc78daf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你能教我什么才是真正的帅气吗？\n你可是唯一一个，能懂我的帅气的训练员。",
      "source_fingerprint": "d60cd20c867e98b9d685721312957ccec03d4356d64815da5572c935b8e148d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008005.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:78f0e288bfbf138e2c004296",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "知道了，我试试看！",
      "source_fingerprint": "782ab9a299dbbb234453be39ba82f2c07fab15094f2c3a6f536d3ecc4b367cdf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008005.json",
