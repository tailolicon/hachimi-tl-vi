    },
    {
      "uid": "zhcn:d32f3a710030b8edee9937cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "他一直都在这样教导，说这样很帅气。",
      "source_fingerprint": "ddec75f4e280383fbefdf16663b41046334fb528717f2677d72d6e71a66fed75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
