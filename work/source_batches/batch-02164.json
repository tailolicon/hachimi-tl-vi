    },
    {
      "uid": "zhcn:292a95de6b9fdd998d522dbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，现在这副模样，总感觉太逊了。\n我可不想成为光说不练的家伙。所以说训练员！",
      "source_fingerprint": "164e56fc80ffbaf19c8833ac1c5d1cbba080395fc4a23706943d24d75dfae643",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008005.json",
      "json_path": [
        "text_block_list",
