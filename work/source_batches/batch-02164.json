    },
    {
      "uid": "zhcn:dda260fae16699eb51c225ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
