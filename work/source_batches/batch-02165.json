      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:9f0cc1c5fec4d5f6b32a0c5d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是啊。但是我正追随着的，是老爸的身影。\n就像这样追下去，到底是不是个办法啊。",
      "source_fingerprint": "5e115633ff9239999f212eca7b8afc872e5a08c7b72dcea7204da59c797e5cf9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
