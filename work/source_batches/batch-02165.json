      "json_pointer": "/text_block_list/29/name"
    },
    {
      "uid": "zhcn:e81cd12540ac90c90812179c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但老妈则是完全不同的类型了！\n总是狠狠打着老爸的屁股，好好料理着家务，而且――",
      "source_fingerprint": "02d906bb2e9d6602ba0f756e9bf2c79c85d6d27a88961b42a0b26f8de1f7bb21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:e383029bb2c7d06c5bb73716",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要驾车远游吗？",
      "source_fingerprint": "1830427676b7c652ec4ceb814c992349e17ca0ebb1b463b770726fc5cc90f211",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
