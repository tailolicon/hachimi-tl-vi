    },
    {
      "uid": "zhcn:95029c30cb6816e408460a36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一些以前我没考虑过的事偶尔浮上心头，\n害得我心痒痒。　……咱们差不多该回去了。",
      "source_fingerprint": "208d38a7199dabda698eb20d9cc80184f2b5db6a3d09b6d34c9d430307464a33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:427c221443fb331cb8bfb75c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――在回去的路上。",
      "source_fingerprint": "d89be5e87b3a6d4dca3bbb1d4cf4909062df0759b3db7c7419a91e69dd5841db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
