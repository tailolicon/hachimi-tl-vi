      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:75058f8b153890b0372b3918",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:3ac9cf09712df00d8cffe271",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但改去追随强大的老妈是不是理想的，\n还让我一时下不了定论……",
      "source_fingerprint": "2c67c8747e58bfcf18f29ae7ba9fb2c30c79443cc9a9eb36e69bad55f1bc5820",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:2934b894e03de32c2977fe9b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一点也不奇怪哦",
      "source_fingerprint": "060d4c7fce377d0d590856adcff59b244829e7eb21c0d438dc00c1a8614194f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
