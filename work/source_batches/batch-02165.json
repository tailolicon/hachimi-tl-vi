        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:508437f9b47ff0a686953f97",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有那么厉害啊",
      "source_fingerprint": "e8899760b5309b22fa85b2b70a703770bc49b8b15879360209bd9b670c911372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
