    },
    {
      "uid": "zhcn:ff795090d567642315ba4832",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对了！　这种时候，就该来点爽的才对。\n摩托车啊摩托车！",
      "source_fingerprint": "c291c0d4a0d7ebf1afa2b7e086f77682f91061ea07b4d2eec3b0446f3e9a929d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:db49ab20a7154950b7079a44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有那么厉害啊",
      "source_fingerprint": "e8899760b5309b22fa85b2b70a703770bc49b8b15879360209bd9b670c911372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008006.json",
      "json_path": [
        "text_block_list",
