    },
    {
      "uid": "zhcn:0f6843622c3d73bc6a67478e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这样吗。既然训练员都这么说了，\n那，应该是也没太离谱吧。",
      "source_fingerprint": "f089686af56716c59679393a748ab0a2fa866570a0a4fc7e6323b8dc0154f0da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
