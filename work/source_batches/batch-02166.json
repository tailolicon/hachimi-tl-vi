      "json_pointer": "/text_block_list/25/name"
    },
    {
      "uid": "zhcn:dfeea0aa6896ada3e57fcab7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我，可是非常擅长做炒面的哦。\n很久以前，我在老爸的朋友开的路边摊上帮过忙。",
      "source_fingerprint": "be83be593322b21ccc4c971bd0781bcb708c547343a45709158d60b506ad91cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008007.json",
      "json_path": [
