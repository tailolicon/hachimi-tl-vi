      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:ca33b83817da7f7de01f32cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两者？",
      "source_fingerprint": "edaf90af4971cacb90d646fe224266e5cae708ac5fb63e87258b850464d5e48a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
