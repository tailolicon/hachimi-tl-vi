    },
    {
      "uid": "zhcn:4dc9f4d7e89bf4e2b946e2a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，那些事都无所谓了。\n训练员，集训的时候谢谢你了。",
      "source_fingerprint": "52c922d7a84891c2162c3262173cf258b332f3e2dc2dc1fd9f856bf65e645bed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
