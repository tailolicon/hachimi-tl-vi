    },
    {
      "uid": "zhcn:ef46c2491209ed114b5fc4a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后集训也接近尾声。\n庙会结束之后――",
      "source_fingerprint": "e91e26f76b071a1c2cfc32d2f2f25a7f8b5422da5af02cee3ff545638c15eb1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008007.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:11f862a1851e505ede48562d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不是吃够了？",
      "source_fingerprint": "75d21befc6453f60e23638bebabc243781ab338778e2b918a2f7eabe8d17630a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
