      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对！　老爸的“帅气”和老妈的“强大”。\n只要两者都有就行了。",
      "source_fingerprint": "f891f498f331ace3fb8adcd943c80b9fb7fb3cbd0b27708efc40a21fc3d4deda",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1008/storytimeline_041008007.json",
