    {
      "uid": "zhcn:9c3cc03e19b9561e3ae33c63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "由我继承的两轮",
      "source_fingerprint": "eb41a581649f6363ed35fb9dcf8a6b282e90332a0ca1f6243676ae7b7d238d36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
