      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这，这样的速度真的没问题吗！？\n就算是大和赤骥也……！",
      "source_fingerprint": "b507080af8d297346bfff31de893fd28e6c783e28a282a0c358fc53afe77ea87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
