      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个态度是有点……\n就算能力再高也很难办啊……",
      "source_fingerprint": "d7260c626086add84c45e8515e210061530773ea7bcf44ca8e9fb95dfb097480",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
