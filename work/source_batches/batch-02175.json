    {
      "uid": "zhcn:16f7fdf2c280d2f180e0dc93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥稍微有些摇摇晃晃地\n回宿舍去了。",
      "source_fingerprint": "5b2dc65dcbd8d99606102099761cfa9a919f89f73beb42a98001a5a7a48f621d",
