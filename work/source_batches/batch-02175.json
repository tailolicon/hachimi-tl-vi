      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，是赤骥的训练员。\n难道说，你要找那个孩子吗？",
      "source_fingerprint": "f3ca461ae79a1d5663c4291bfe92cae8faf474b6a02f26c4a393f4d15df8c3f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
