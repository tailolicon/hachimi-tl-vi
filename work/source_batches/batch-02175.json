    {
      "uid": "zhcn:380a1c9012e09f221fefbccd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得她没在房间里哦。\n就在刚才，我看见她往玄关的方向去。",
      "source_fingerprint": "6c0269da1bd60a1e818d63ab9cc0cd7d9f427fd9c7babc085061c22c1083cac5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
