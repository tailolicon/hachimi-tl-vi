      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼～。到这里的话，\n就离学园不远了哦。",
      "source_fingerprint": "87c8f10f65972fbb184a0c4a364a75762c38dea71a7f637b978703035af745c8",
