    {
      "uid": "zhcn:4e2ded6a162b40feadd2b47b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，我也正好要回去。\n所谓『出门靠朋友，处世靠人情』♪",
      "source_fingerprint": "cb17e4e1c68c115183b15fb55ce92d3ae9a5c8f5f3a17762f0e18c50168771ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
