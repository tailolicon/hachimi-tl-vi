      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恭而有礼",
      "source_fingerprint": "9c80897c03fec6dea92018df2e33f017f411ba656054d606b7f83e59b788ce86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
