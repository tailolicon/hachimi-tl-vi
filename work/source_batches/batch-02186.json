      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:8ed157b38a73eef02a2bb277",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在众人瞩目之下，草上飞出场的\r\n比赛终于开始了……！",
      "source_fingerprint": "8d9a41715e7e07b217ffe89079fb9cda87f26a6dfc2bfc0fd97e6014620953ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011002.json",
      "json_path": [
