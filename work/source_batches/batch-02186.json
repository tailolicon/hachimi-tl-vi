    },
    {
      "uid": "zhcn:3d818f69077b537bf83c96ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "资深训练员A",
      "source_fingerprint": "c562a69cc80221d7226c73b0d8845c937fe686b8cb2fc46366892017d0bd14c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
