    {
      "uid": "zhcn:4c1b3d7cd2b722d586976908",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在，我们回学园去吧♪",
      "source_fingerprint": "4ce9a1396b29f05204e08a0411e11981157398d3b65d33b07b4c956369d78134",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011001.json",
      "json_path": [
