        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:e0a97bcd5200724f883c8df9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "话说回来，您看起来好像很为难，\n是怎么了吗？",
      "source_fingerprint": "1372c6b27defca6a752b7c7f19a180724869dd348eba5d688f116ce0f4db0636",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011001.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:993871cf598a56b2a208ac14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面对亲切询问我的草上飞，我老实告诉她，\r\n其实自己是第一次来这里然后迷路了……",
      "source_fingerprint": "919e3a7fd1d29a6d92bcb55b1b5bfa580b908854e2dfcd144b0278ef16cf5d9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011001.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:8a43f834f9eccbac66be1635",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "草上飞",
      "source_fingerprint": "fe3ba1631152984791543a0369db2cd482292820d8f58be72b12657fe41e9879",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
