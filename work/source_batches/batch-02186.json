    },
    {
      "uid": "zhcn:d8622762bcffcca6fabff2ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以出道为目标的马娘们，向训练员们展现自己的实力，\r\n争取能够被发掘的『选拔赛』。",
      "source_fingerprint": "e37bf3d1906753312da007b0c826ce09569124be8a26cb7f77bb97ff10dba966",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011002.json",
      "json_path": [
