      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:a571277d70410415a7e6a8d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其作为特雷森学园的一大活动，今天就要开始了！\r\n我马上往赛场走――",
      "source_fingerprint": "633b19ea1cb2e1812bec350d03546b93ad1098f5e9e2d5b5303ba6ead857099a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
