        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:e3148487d3d5f7c7a307152a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不久后，在训练员之间就开始有了这样的传言……",
      "source_fingerprint": "004f5a233bbbca6aa3adf07b6f1dacd9e12f96187126eed554faf7bc7dfc750d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011003.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:46db71173783932e401a777e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有一天――我看到了草上飞和神鹰\r\n一起并跑的场景。",
      "source_fingerprint": "a778024b9a252867ae40fbb3b1ee9c58d0ca8453fe300c691717685218c7a119",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011003.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:9bd7b43317ab7fd70bef3181",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天也是，我走在林荫道上，\r\n正看到草上飞被邀请入队――",
      "source_fingerprint": "f3f0463ff1f86cdc33d00f3ecfb6ba235c8402400946a79e0163dac21e97ff46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011003.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:7def52694d2f25341abaad32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神鹰",
      "source_fingerprint": "795f13602f1e9cddca3fec6d57b66ab4924d833a2a706e841577ffebe02c9437",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011003.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:0de2c1c1dcc6e1712d7dcd35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼ー。谢谢你陪着我，小草！\r\n小鹰我差不多该去休息了哦。",
      "source_fingerprint": "7caedce128985dab95a8747d1b0fa7f2965165cff3213531e2adfedc24e41854",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011003.json",
      "json_path": [
