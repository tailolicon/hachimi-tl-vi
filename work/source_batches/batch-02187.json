    },
    {
      "uid": "zhcn:58d944a114320a0cbe348ee4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯ー，要是没有执着于胜利的态度的话，\n就有点难办了呢……",
      "source_fingerprint": "d557d7dfcf2b02af95527395285b189cd1daa961eea148006fe31fed3b8116e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011003.json",
      "json_path": [
        "text_block_list",
