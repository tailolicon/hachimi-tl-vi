    {
      "uid": "zhcn:b5f3c45df5989e0cffb3edda",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是。\n那么……很抱歉，我先失陪了。",
      "source_fingerprint": "9faaa5c368b748a1d1e025bfdcace51c4141969ced466603aa155701014b5510",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
