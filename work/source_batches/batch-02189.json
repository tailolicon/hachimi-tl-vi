      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:8886267cae164328cc3209f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你怎么也无法原谅输掉了的自己？",
