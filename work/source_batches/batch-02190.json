    },
    {
      "uid": "zhcn:39de781a7bb4379d4fed8156",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "草上飞取得了压倒性胜利。\n于是，她的周围开始聚集了许多孩子。",
      "source_fingerprint": "f91331fd60f8c354c2914e7d555e06df77f784a5f27a9499a9148f3ed79ce7c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
