        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:87b27831bee179f27d731abb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然草上飞说『稍微』，但她可是那种在自己满意前\n一直拒绝训练员邀请的性格。",
      "source_fingerprint": "91abcc00e6a36b74e6a4355bef019539a88ddf5909d9fe67e3115ef1281809ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011005.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:f478054916c1f53456cf2371",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便只是模拟赛，只要她想赢就肯定会去全力以赴……\n我边这么想着边去看她的情况――",
      "source_fingerprint": "a40c75893bcfce29e6937ac08a6981f142bb11f5d4d5acc3ed7d233ac05a0626",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
