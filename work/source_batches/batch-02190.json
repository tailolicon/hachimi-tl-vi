    {
      "uid": "zhcn:cc87fbfe0e8d9ed8204cd128",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员您先回去吧。\n做调整的话我一个人也没问题的～。",
      "source_fingerprint": "898bb4761ffcdf4c6635fe78f4de88add03793dc4bcbc18630bd89dab43e3d09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011005.json",
      "json_path": [
