      "uid": "zhcn:8fd9fe4c376727ef590b4499",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不出所料，她进行着和赛前一样程度的训练。",
      "source_fingerprint": "e0914ef94b3f2f966cec4b5f23e2645c083013e2d290d3e417ad6025b03ee000",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
