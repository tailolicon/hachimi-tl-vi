      ],
      "json_pointer": "/text_block_list/22/name"
    },
    {
      "uid": "zhcn:cf09df7a83d0f9b6216b053f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好快好快！！\n草上飞，直线上瞬间全力冲刺！！",
      "source_fingerprint": "4fa0a9894d9b8fd9fc2c213ae072fd6eef79d67d646eba1c41b942994231ecad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
