      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:2b56aa289cf3eab7826cb53b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我明白她对于胜利的渴望。既然如此，我决定只是默默守护\n不让她乱来。然后――",
      "source_fingerprint": "758e54a6b554e52a3eb9e9f253f4007571dcbb8d3a5361474b68faa89adeac03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011005.json",
