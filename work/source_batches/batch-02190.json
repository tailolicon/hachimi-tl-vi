      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:d61bf250ff6b3414ecca158e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实况的马娘",
      "source_fingerprint": "8a3baf640272e904d2f5a0800c8dae71ed15992d63ad6c2453bab16282d015a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1011/storytimeline_041011005.json",
      "json_path": [
