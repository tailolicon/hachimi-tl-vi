        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:43b71d81fa1b63340826e605",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟她解释因为知道什么好吃，\n所以才会老是选这几道菜……",
      "source_fingerprint": "b6ef608e76ae115825bb9f2972670cd6fb05b6aa60023a2183c9343f762394f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
