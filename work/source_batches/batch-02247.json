      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这场比赛……由我拿下！！",
      "source_fingerprint": "a7b9fd3f7458260250b94f1727fc76706424bde1f867aa7308879131b859374f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
