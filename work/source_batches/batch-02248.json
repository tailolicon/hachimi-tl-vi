      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我尽量。",
      "source_fingerprint": "c2c200ba95d98d4123d06c1334aca3b0cecfd83b8534b4388bba8aafb1e29c4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
