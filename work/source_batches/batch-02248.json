      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么会……！　为什么！？\r\n要想在比赛中取得成绩的话，就该舍弃掉多余的时间啊！！",
      "source_fingerprint": "adf9a872035ebb1b272cf0641173e941f4b7305142c429ea0f6e8debe2aaf8e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
