      "json_path": [
        "text_block_list",
        13,
        "name"
      ],
      "json_pointer": "/text_block_list/13/name"
    },
    {
      "uid": "zhcn:696cc6870bce5b2a715fd2ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等等，你听我说！\r\n我只是希望，你能够不把时间浪费在无谓的事情上……！",
      "source_fingerprint": "39dae85e0e8fac69b676ae5455e1a0f3e40394f1ab2bd5eb10229a40d337e922",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1018/storytimeline_041018002.json",
      "json_path": [
