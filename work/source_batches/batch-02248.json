    },
    {
      "uid": "zhcn:26be6f9790b0a5e6d877757c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽的签约训练员",
      "source_fingerprint": "c0ee740a2c3bb111ea9942d36b39dd2e9bd6eb9eac3c8e1213877d862e742e20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
