    {
      "uid": "zhcn:05b20886c5d670fb2d97404d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么……你还真够自作主张的啊。",
      "source_fingerprint": "6928f99c19b182c2aa79796450a247746a215db1f05c6a3eb5efe5726fe13cf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1018/storytimeline_041018002.json",
      "json_path": [
