      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
