    {
      "uid": "zhcn:440c5f79ec07f33b59740320",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的母亲，经过激烈的竞争，\r\n最终获得了“女王”的称号。",
      "source_fingerprint": "cc0f7d374e4167fe54e6cafaea2a87f6e5f54d548f5a3b78b734b65ac82d4f44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1018/storytimeline_041018004.json",
