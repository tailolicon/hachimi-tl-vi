      "source_language": "zh-CN",
      "source_text": "――特雷森学园。是培养能够在『闪耀系列赛』中活跃的\n马娘的教育机构。",
      "source_fingerprint": "c2ba4ea20f5547532df097445a2a465784d1363e1f05e5a537392abef709e461",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
