    {
      "uid": "zhcn:9845c09c9bbd94b1de0863ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实啊……数码碳我，已经\n和这边这位训练员预约签订担当契约了！",
      "source_fingerprint": "dac724bd18c25d0ecf342e9d1e44111f3f41de2d3c78d86054ef90e90e58878e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
