    {
      "uid": "zhcn:2e333cfa627c31fb2ee59259",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我说训练员。\n你是不是偶尔会被人说“很狡猾”啊？",
      "source_fingerprint": "f4c94627ccc3a092d2901cbceef1b521c81d2bdf041bfd79b42ffd80a64d3692",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
