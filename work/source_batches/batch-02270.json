    {
      "uid": "zhcn:1083c7e9e4f11aaef455a108",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青云天空四处张望，\n看起来有点心神不宁。",
      "source_fingerprint": "c22fff6d10368f2cc042ca85494fbf82e9c316e64b374a5b84ed5cda394e1495",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
