    {
      "uid": "zhcn:12989f9bfa21cc2b6ca30ac8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后我和陷入沉默的青云天空，\n一起钓了一段时间的鱼。",
      "source_fingerprint": "b6e01a9b08a6e3359f48d0927afd475d8c73da12718bfc44d8ba51aff709a575",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
