    {
      "uid": "zhcn:5790f5cf7b847840d5cf3e43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我、我不是什么可疑的人啦……",
      "source_fingerprint": "071144ffaf5b37901ba805c1abc46916dc10fd802f208d7d6436ce1b94d20e80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1021/storytimeline_041021001.json",
