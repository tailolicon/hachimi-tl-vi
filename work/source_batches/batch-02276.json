      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──我必须要赢。\n绝不能……输在这里……！",
      "source_fingerprint": "8de6c9bd523e200d2b95111d23d88d90496eff6d80c28243cb5751cb3be304a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
