    {
      "uid": "zhcn:f3f73afa8f3a2042062d0ed5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玉藻十字已经极限了吗！？\n从领先的位置逐渐落后了──！！",
      "source_fingerprint": "a3f969d8b8c3b51d30e887d6e45e68fb38f51e97139a72cdd9e8c3521a87f706",
