    },
    {
      "uid": "zhcn:2bda36d6ac2333e92c9c32b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玉藻十字整个人的感觉和初遇当天完全不一样，\n我虽然感到有点在意，但比赛也即将要开始了──",
      "source_fingerprint": "1459b43c3c083d287de08870ec458b1076d975840a6a9eb4384fc1539b9589be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
