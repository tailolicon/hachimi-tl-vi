    {
      "uid": "zhcn:b507de13285493c920b4a021",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……呼……呼……！！\n我要赢……！绝对、绝对要赢……！",
      "source_fingerprint": "722562204cd47c00dca2071d8e796bd6727ae4e4f2df74338df7cfcdddbb3a0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
