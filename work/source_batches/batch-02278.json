      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:e20a539a8c4d1ad4adb615ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我将昨晚拼命赶出来的──\n以赢得选拔赛为目标的她的个人专属训练排程拿给她看。",
      "source_fingerprint": "edc725caa803bfb9bf9194ef3bc878f86e01fd2e06d640bcb5eaac642fd3293f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
