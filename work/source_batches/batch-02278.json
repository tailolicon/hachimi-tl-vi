      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──那我们要从什么开始做起？\n我就等着看你表现咯。",
      "source_fingerprint": "3dc5fcebaed2685c34a3589d23fd3cf54e256944ca79ac16731c33a452a48373",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
