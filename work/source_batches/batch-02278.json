    },
    {
      "uid": "zhcn:9464fee3cea24e975e624479",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我下定决心后，便开始在学园内寻找玉藻十字的身影。\n而我来到训练赛道时──",
      "source_fingerprint": "c135475183ae737ebc9daa4ffd21a610417c5461cb2e18863378b5ea830f51d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1021/storytimeline_041021002.json",
      "json_path": [
