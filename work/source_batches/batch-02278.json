        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:91abec444b1c62b419c8692e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隔天，我和玉藻十字首次一起训练的日子──",
      "source_fingerprint": "90d897890573c87d2a38711ceb75e0a9837bd673b53b8c50e43a12839077aacf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1021/storytimeline_041021002.json",
      "json_path": [
        "text_block_list",
