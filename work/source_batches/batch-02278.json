    {
      "uid": "zhcn:1fce6338e2184d3d5c956823",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是在玉藻十字的提议之下，\n我们签下了以在选拔赛雪耻为目标的“暂时契约”……！",
      "source_fingerprint": "ccd3ba0be3c1c2651f68b2919d971adf5865d59577c5e25ab2be62745160927a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1021/storytimeline_041021002.json",
      "json_path": [
