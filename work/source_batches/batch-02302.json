      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:d383c159755d29d6eaab7f46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……一想到琵琶晨光以前曾经涂抹大量发蜡，\n那可爱的举动让我不禁笑了出来。",
      "source_fingerprint": "0db295384bb91d3262f3c3c7bb2f8a4d5a7f4cdf05af3ae7d224093e77d7b0ea",
