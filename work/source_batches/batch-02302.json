      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:406ae8c9f38fd052a0d858b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后的一段时间，\n琵琶晨光不断地述说她对自身发质的抱怨与辛酸……",
      "source_fingerprint": "2926875492febf3663bf34b71e6c788922ddea8587debf328788ab4bc3601a4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
