    },
    {
      "uid": "zhcn:0989f82301d63fa8dc05bdc9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……看她冷静沉着的样子，我的担心或许是杞人忧天。\n正当我这么心想时──",
      "source_fingerprint": "83b650c20e1b9c1a24dd35dd3b92afc382a2539eea0ea886347063dd7a43665a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1023/storytimeline_041023007.json",
      "json_path": [
        "text_block_list",
