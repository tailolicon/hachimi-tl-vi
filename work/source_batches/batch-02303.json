      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，训练员也辛苦了。\n那我们回集训宿舍吧。",
      "source_fingerprint": "3ff91586c768e2645c476f83f71aaf7bdfa712f0707c04aa8ec5df2fd1c6e927",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
