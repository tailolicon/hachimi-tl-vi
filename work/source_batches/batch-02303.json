      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光",
      "source_fingerprint": "3b8fa7e9d29e8512dcd4f68f1ba91cc31eef66c9e56adf5ae07aa10a7856d013",
