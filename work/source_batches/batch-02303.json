    {
      "uid": "zhcn:89d38a049039b176d0f18d61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她一定不会挑选道路。无论那条路有多么险峻，\n她都会磨练与生俱来的杰出双脚……到达顶点。",
      "source_fingerprint": "08d90b49385285c65eafea4cc6e12198323b3520073ad48f80e27fcd720a69d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1023/storytimeline_041023007.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
