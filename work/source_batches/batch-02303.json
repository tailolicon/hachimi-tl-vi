    {
      "uid": "zhcn:5a4edbbf0afc920bf1ae9b44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的头发确实很蓬松，但并非特别容易引人注目。\n有必要这么注重保养吗？就在我感到疑问时──",
      "source_fingerprint": "7f395e3e81cd4be5c25eea1bdc273862a26c496b8714b790bf3104b76d4be87a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1023/storytimeline_041023006.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:c7d174d45a496ef737665b09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确切的魅力",
      "source_fingerprint": "17a7e474287479597e2fbd7a2b39c81ccd565dc2fc28ffd47ac2126081f11f62",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
