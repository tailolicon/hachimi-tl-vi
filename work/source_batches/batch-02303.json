    },
    {
      "uid": "zhcn:ee2e45307e09251b99671c4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光这么微笑的表情看不出放弃的神色。\n那是她面对并接受自己后的开朗微笑。",
      "source_fingerprint": "fc135326e51e0275c9711b2585b838198f3ba1ab6f846f1a6dd97ecbaeaecc30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
