    {
      "uid": "zhcn:3c9088b393852c5f930fbddf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光照她所说的，\n沿着计划憨直地继续体干训练──",
      "source_fingerprint": "381573ee5c5319d626357b0d6739dcc68215798db32821f56b15d6512fc28374",
