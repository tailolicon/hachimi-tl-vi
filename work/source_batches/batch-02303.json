      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过──这样就行了。\n因为我终究就是“这样的人”。",
      "source_fingerprint": "2f8f9d96f7da3a0e4f174f7903d9b31507094ba32eb5c77a935303ebf1effe3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
