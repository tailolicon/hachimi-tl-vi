      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真的吗？！非常感谢您……！\r\n在GⅠ比赛中获得优胜一直都是我的梦想！！",
      "source_fingerprint": "ad2900072aa7af494f70838c2cc920ce6e64374d016667b1e24c6ae62375fbfb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
