      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我就是喜欢……和你一起奔跑……",
      "source_fingerprint": "87eadbc203a8934631554857199f0a49dc4a412c8da16554de0270d22e9cd5b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
