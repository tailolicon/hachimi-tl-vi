      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——在我终于发现手机不见了的时候，\r\n太阳已经落山了。",
      "source_fingerprint": "d0496c2a567383ac4d5e9c9093c8cb4fdc690f215cb4ebbdfa9df00eff0a8276",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
