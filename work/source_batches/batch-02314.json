      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:704d24ee221ecb7872781278",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听着她说的话，我想起了昨晚发生的那些事情。",
      "source_fingerprint": "a84b18651768d4c2a5874c1ece179325fe87fef641013b229b114bcc73e7b843",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1025/storytimeline_041025001.json",
