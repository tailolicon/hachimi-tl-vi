        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:1383404ef2869730757035d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曼城茶座身上的谜团愈发扑朔迷离，\r\n夜晚再度降临了。",
      "source_fingerprint": "73f7d3a7419ec3eb47f9ecb43e03942adfa263d40acc834ec924f6c429f56b48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
