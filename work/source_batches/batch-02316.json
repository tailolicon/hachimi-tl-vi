    {
      "uid": "zhcn:e5f6f919fec6b067c8ce354b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……也许她还没对我放下警戒心吧。\r\n还得多多接触她，获得她的信任才行。",
      "source_fingerprint": "e91d4b4067522f50b44984b7b9c928fd3c47aa700d54f59e8bd456650651262d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
