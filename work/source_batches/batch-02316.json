    {
      "uid": "zhcn:a004cacdd1173247870f2f10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曼城茶座向我轻声道别，接着便离开了这儿。",
      "source_fingerprint": "ae7873ab1e482bf38c7d68a65af413510260b8fd995f9aac69d4ed3a9dce489c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
