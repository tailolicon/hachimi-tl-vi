        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:141eda89f1234b1855b8223f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同时，茶座也逐渐习惯了我的存在……",
      "source_fingerprint": "c0e3d2fe8952222868744c2050feec4ce2d3004a12f9f546d3d20a06ae6d81a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
