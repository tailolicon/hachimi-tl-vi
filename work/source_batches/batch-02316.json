        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:7352f17dd87e6d748510089f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然，一个人也没有。",
      "source_fingerprint": "f66a72df2645ea3f896910854eeb5e97653c64cc4da6f364af93273fa98c3ca8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
