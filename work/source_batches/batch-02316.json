      "uid": "zhcn:70d46cb04c7d71c54bd210b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈哈，习惯啦！",
      "source_fingerprint": "1be3ca190f238f2ccceaf1a0cd79319bda86c261b8383c7c044d8e297ecd15f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
