    },
    {
      "uid": "zhcn:76b942fda340e8469d93c317",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是我们为了参加多项目竞技大赛，\n展开了努力训练的每一天。",
      "source_fingerprint": "b067169f10a62c18e955298da48e823cc9d9a27352def10a599a3c633fa88be7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
