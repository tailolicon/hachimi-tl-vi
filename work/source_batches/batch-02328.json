        0
      ],
      "json_pointer": "/text_block_list/17/choice_data_list/0"
    },
    {
      "uid": "zhcn:808410053430f199ac371453",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所谓“多项目竞技大赛”是特雷森学园举办的校内竞赛。\n可以自由地选择喜欢的项目参加，也是来场观众相当多的活动。",
      "source_fingerprint": "4a6af6f60bf027146a1e0631ed575b4f2df2ba8a7a17c70208062edb90449c1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1026/storytimeline_041026004.json",
      "json_path": [
