    },
    {
      "uid": "zhcn:c8048d8bbea548cb6a31bb09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁",
      "source_fingerprint": "d31aaadb85fb817a2c53dd55829df1a4c71dc82c8dd7c457754c51af5729ede3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
