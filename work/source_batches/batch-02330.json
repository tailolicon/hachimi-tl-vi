    {
      "uid": "zhcn:67445f5156732e3a466f3b15",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁看似明确地知道自己在做什么，\n但当中似乎有不少的误解。",
      "source_fingerprint": "34721628a9fe1f4f156272dc494e310ddd7ba30a8d7204da51d2be8222565ef8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
