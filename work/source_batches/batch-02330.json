    },
    {
      "uid": "zhcn:15e61fc4935b25c75ed1d766",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你双亲的意思是──",
      "source_fingerprint": "da42e7c6402b9d8e444bb058d08fb54a1664db85ea85764144edbdc2b5c016e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1026/storytimeline_041026005.json",
