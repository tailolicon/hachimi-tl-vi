    },
    {
      "uid": "zhcn:f9048582b68273eb3d525d0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以我一直都找不到签约训练员……",
      "source_fingerprint": "40cf9327e4044f9784b54605c90ff0b37360e3f2d2ce3624c9392e483ebbefc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
