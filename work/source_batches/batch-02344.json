    },
    {
      "uid": "zhcn:3bf81fbc25d0e621ad144b59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱曙",
      "source_fingerprint": "74ec598a7a59e8ab3c03eddc51a564135cafc6d72200153668de53d40be0ba69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
