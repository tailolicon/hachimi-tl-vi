      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好烫！啊哈哈，生火果然有点难呢～\n――啊，发现螃蟹了！",
      "source_fingerprint": "b4ca91594b1a7054afa3d448bb11104eb121867dd341ddf0802f1c6845eb817f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
