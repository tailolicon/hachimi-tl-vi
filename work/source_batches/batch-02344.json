    },
    {
      "uid": "zhcn:9ba9186338346bd4f2e18d47",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果你愿意当我的训练员，我想想……\n我可以每天都去帮你做味噌汤喔～！",
      "source_fingerprint": "91d180e61e8431269162b7bb914b52f98b5a56afb6ce1c2a2e82d52978bfabbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1028/storytimeline_041028001.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
