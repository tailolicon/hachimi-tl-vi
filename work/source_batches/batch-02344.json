        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:d2ac5ad7bb625eb36b9af435",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱曙熟练地架设好厨具，并生起了火――",
      "source_fingerprint": "3c3cde951573fba3effee4faf24fa635e9a50dafa4bada279cb33fdb17bbeaa8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
