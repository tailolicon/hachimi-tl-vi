    },
    {
      "uid": "zhcn:cadb7c58282aff074a4bd245",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她转眼间就把不知何时抓到的大鱼分解完毕――",
      "source_fingerprint": "e1cb988b15281a675bf0b9d57ab04bf4396177f682ad802bd4c4193eac2f9861",
