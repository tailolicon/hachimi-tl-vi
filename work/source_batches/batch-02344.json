    },
    {
      "uid": "zhcn:97b80fc6b784833fa73b9f10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "耶嘿嘿，今天真是来对了～\n今后请多多指教咯，训练员！",
      "source_fingerprint": "89011162f17616a76ae0ec5c8a1a9706e7ec19de94d73114b3acca488631d5f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1028/storytimeline_041028001.json",
      "json_path": [
        "text_block_list",
        47,
