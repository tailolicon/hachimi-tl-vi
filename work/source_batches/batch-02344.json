        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:13b7d860bdf03345d75836a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦！？",
      "source_fingerprint": "6878a171cd7c622ff4ce46652aac560c21f087f2463528166016ac47a0c718e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
