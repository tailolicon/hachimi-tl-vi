    {
      "uid": "zhcn:a0ea3daa18c10a9a188192bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，我先来生火吧～☆",
      "source_fingerprint": "23e1a74d65cffc1cd20f82069debd0bc7f42b1bba7bf973b1d7646343349eb45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
