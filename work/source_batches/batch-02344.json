    },
    {
      "uid": "zhcn:4fd000f30a28353423d94560",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1028/storytimeline_041028002.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:6ce073484e08e89eb401f386",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自从在无人岛上被反签约，我成为菱曙的签约训练员后，\n再经过一阵子的某个周末──",
      "source_fingerprint": "49a8479932ca355d9c15eb0d030dbe97747b5941ffdca582c9113214a86df90d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1028/storytimeline_041028002.json",
      "json_path": [
