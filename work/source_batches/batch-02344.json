    {
      "uid": "zhcn:09f7411bff7ea9b9f986b693",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇！可以吗！？太棒了～♪",
      "source_fingerprint": "980b89a2a08e3bfb116968a2acdff03cdd48c5113fddc2b505eebedc64d42c1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
