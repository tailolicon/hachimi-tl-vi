      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "反正我带了野草图鉴，\n于是决定去找些食材。",
      "source_fingerprint": "f59d30f5e7b1af7472896e1623586f1fc82266cca9c6dcdb7ce6484e8ca837d7",
