      "source_language": "zh-CN",
      "source_text": "雪之美人",
      "source_fingerprint": "a93d47fc7a462ee0b7578fcc33fd1856d8dc5cb9ef84083d6322a1a712d80d6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
