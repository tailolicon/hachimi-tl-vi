      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:43ddd3d1b4d9884618212d27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本来我是为了让她比较好说出“心底话”，\n才带她去了一些感觉她会喜欢的店，但……",
      "source_fingerprint": "d89b0dfe8ef39b629dc25e4432adac33bcbc0b7b2648e4e4ab2bf19d7ead08cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
