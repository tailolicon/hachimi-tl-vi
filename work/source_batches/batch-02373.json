    },
    {
      "uid": "zhcn:daa1c317a827d35fa6a81308",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "麻烦来两份『普通份』的。",
      "source_fingerprint": "e8a0c9fb1b02bed7cc0ce6e446f92550ef03abdc8fe689d9a10d7d43d742bb78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
