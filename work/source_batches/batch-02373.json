      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――啊哈ー……能站起来了吗？",
      "source_fingerprint": "107fe68a4ef58960c8595029f184940c0d922bec497afd978ad4280ef3fef87d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
