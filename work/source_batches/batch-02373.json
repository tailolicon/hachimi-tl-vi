    },
    {
      "uid": "zhcn:66a20e29d320554dddcd8030",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "缠着绷带的马娘",
      "source_fingerprint": "52fdcf8301f9df380424ba898cba5c8dfc488aa4e414d15b07a735088fac9c55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
