    },
    {
      "uid": "zhcn:a1475cbb9a29b25665edb21d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好ー！\r\n『普通份』两碗ー！",
      "source_fingerprint": "c14f8de92d753aeff2722f418948fa499c572effe43c46216376e89f5a367bfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
