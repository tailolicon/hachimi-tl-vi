      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欢迎光临ー，请点餐ー！",
      "source_fingerprint": "77c5bf33c4c1b4797f34ceaa94408732da97434dfa2aae02b6fcbcef33e782f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
