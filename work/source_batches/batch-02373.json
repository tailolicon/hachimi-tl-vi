    {
      "uid": "zhcn:254d769601313e1c058e0e8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员同事",
      "source_fingerprint": "a660510a0aa115fd2ba8795f5a41462a6a71496fba00797e1a68d4f56dd6c479",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
      "json_path": [
        "text_block_list",
