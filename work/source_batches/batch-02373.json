        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:9b7dec6f5e7272fa660a9f12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈喽哈喽！相遇是突然的",
      "source_fingerprint": "c6fe8a62bcea833a1e559ef606b73974e9c74e3f9e0c855e96fdafdbc9a11964",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ef445632461c95be9f0fcd1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031002.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:3d9f84d43d1d7dac72f14b58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第二天。我的迷惘还没有消散，但总之先去了操场……\r\n这儿在进行模拟赛，而且好像比往常都热闹的样子。",
      "source_fingerprint": "0a95db4755de106e83260e248ebe8def1f46b2354ec2817b09c5a8f223b36801",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031002.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1eb8f8fbbcafa84348a54f14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白赖恩",
      "source_fingerprint": "27f6e72e0c5efa49958dfacdc8da250e2490660afaa33a92ed97b52f06851b85",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031002.json",
      "json_path": [
