      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:5f6ce73adfccfcd6458cc2d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说到底提出那种乱来的训练方案的\r\n不就是训练员你吗！",
      "source_fingerprint": "8e2216c0ea27ff8413dac444dbd22d182479c95561c0602a48fc288d0d94c36b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
