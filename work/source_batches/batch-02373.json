      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:cdc475576fb3b12241ec5017",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇啊，千明同学本尊在跑呢！\r\n马上就要到最终弯道了――！",
      "source_fingerprint": "b6245d67f8796d07a4ec4d075cf82aaa5498af718d164195200466abd3117f0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031002.json",
