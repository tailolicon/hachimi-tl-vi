    },
    {
      "uid": "zhcn:af12a69a307efb92cb801061",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "缠着绷带的马娘",
      "source_fingerprint": "52fdcf8301f9df380424ba898cba5c8dfc488aa4e414d15b07a735088fac9c55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
