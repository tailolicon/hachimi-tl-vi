        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:ff8ccca51989ac687d8a529c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我听说咯，你跟人签约的时候犹犹豫豫的。\r\n怎么啦，你是没有信心吗？",
      "source_fingerprint": "259fb98569f4f47c2a919bcab2849239d7d970a8d017cd25fe3362c4bd2fae70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:36b515fa45d86745b14d0eb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员同事",
      "source_fingerprint": "a660510a0aa115fd2ba8795f5a41462a6a71496fba00797e1a68d4f56dd6c479",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
      "json_path": [
        "text_block_list",
