      "source_text": "大拓太阳神",
      "source_fingerprint": "0f674377b83dac19093bba6ea2724d4eadc2ccd13a070e9d651967969bd200ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031002.json",
      "json_path": [
