      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:867e84769ef97a21e2324a37",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神",
      "source_fingerprint": "9dc9369440a9b696bdc605b98c8ab781a251bb4149a0083c969293a17093fbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
