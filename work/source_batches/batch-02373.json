      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……\r\n……『训练员』还真辛苦呢。",
      "source_fingerprint": "15c501cebb2e73c013ad3b45f7d0f68634db70cfd749b1f221658a192e7c53d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
