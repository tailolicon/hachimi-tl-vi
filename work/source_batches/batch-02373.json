    },
    {
      "uid": "zhcn:7af2d6f325003895da2c14ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "发生那件事的几天后，我跟训练员同事\r\n一起去周围的拉面店。",
      "source_fingerprint": "70d7dc6e4f7b7d990000c41e1a45f984c71061408552361a3b906f68011e61f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031001.json",
      "json_path": [
