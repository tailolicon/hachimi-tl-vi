      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊！　我也ーー！",
      "source_fingerprint": "920f14471a61bf6c9555ed6a28373cce9b1dd1894ea83ad0f6dd0138b3bd1f0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
