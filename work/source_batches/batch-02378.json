    {
      "uid": "zhcn:e6c2535bec7e813067db50ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯的母亲",
      "source_fingerprint": "e4f6404b15198410af4a3dd72a4ced9b3fcc3302350cb6b5fb85ff28ea18edf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
