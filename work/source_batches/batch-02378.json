        "name"
      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:48d3226cabaee9e3cdda8f27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "慢慢地她跟周围孩子的实力差距也就越来越大了。话虽如此，\n那孩子也确实帮到了我许多……我过着一段干着急的日子。",
      "source_fingerprint": "9b052384b16756cd56cec6dccc8243d6c847e6e3d1c89441764d651fefb0ef29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031004.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:8baf8794e280ad4bebd55b7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯的母亲",
      "source_fingerprint": "e4f6404b15198410af4a3dd72a4ced9b3fcc3302350cb6b5fb85ff28ea18edf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
