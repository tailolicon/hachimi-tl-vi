      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "初夏时节，\r\n我渐渐习惯了与艾尼斯风神齐头并进的生活。",
      "source_fingerprint": "9d9a91ef9d9316a3170dfdee03014311aa3619f968a64f72b67b8d43e6194177",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031005.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
