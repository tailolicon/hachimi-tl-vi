      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――此时，观众席上的嘈杂声渐渐安静下来。\n大家目光投向闸门……比赛开始了。",
      "source_fingerprint": "60a5d3bb610319a7b18b7d908f48147c41d80078bde8c61a20d8d2f7b075a656",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031004.json",
