    },
    {
      "uid": "zhcn:cfc9686c143bb94dc515aa3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“能对她有帮助的地方”――说起来，\r\n我想起我们还有一个地方没去。",
      "source_fingerprint": "a5d97cbea9fca96d5eb2f4a9af9dc89f53c3b7b36c7b2da4d38ef7f98981c8f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
