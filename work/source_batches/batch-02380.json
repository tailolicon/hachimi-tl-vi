      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其他的还有被堵住，\r\n终盘没力气了之类的情况……",
      "source_fingerprint": "f1f5067f0683ea69dc4d7abdd3401a3d9f579b41ef22e944e0f788da652a679e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
