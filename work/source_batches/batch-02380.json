    },
    {
      "uid": "zhcn:649dce3ee85aa24d18a80695",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就是啊ー，如果只是消磨时间的话我一下子就\r\n能想到些地方，但如果是整整一天的话……",
      "source_fingerprint": "a5a99c7868eb59a9131fb21cae01c971e514937ce590182c27ccafd436eaf4b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031006.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:bf887afcd95c4fe0be982058",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么就着重力量和耐力――",
      "source_fingerprint": "ba26b1cdf81841766ffadf4342af19a3ec85a74c6ebbe9d367b7f583492272fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031006.json",
