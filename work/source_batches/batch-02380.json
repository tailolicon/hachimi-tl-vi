    {
      "uid": "zhcn:3acb13c4998b19ae6812aa8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我再一次意识到了。\r\n我……果然还是喜欢一逃到底的跑法！",
      "source_fingerprint": "c65770c55a58cb3b1632d7f950259d9cd52a2e98ca30dd60627d772f76c8c110",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031006.json",
      "json_path": [
