        "name"
      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:9440500a357374de9f7d749f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然！\r\n领放的跑法最关键的就是在开始呢！",
      "source_fingerprint": "3dd0f4235303abe0c175a7f152a0c779a09bc751a88ff7efa78d7af055930743",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031006.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:8be2c045e0c21b3c0b0c4ea9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神",
      "source_fingerprint": "9dc9369440a9b696bdc605b98c8ab781a251bb4149a0083c969293a17093fbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031006.json",
      "json_path": [
