      ],
      "json_pointer": "/text_block_list/39/name"
    },
    {
      "uid": "zhcn:2c7b85aa656656cee6fcb8ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "刚才有的孩子起步晚了冲不出来了呢……\r\n我也该小心这一点！",
      "source_fingerprint": "0ef4e4688999dd1adeb7588532219bd9214c3a1044e44a2cae5f9025d7f77828",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1031/storytimeline_041031006.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
