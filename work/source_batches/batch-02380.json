    {
      "uid": "zhcn:5f3702d6d3c6617f658658fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我意思不是说不好！\r\n你那份真心地想让我赢～的心情，已经传达给我了――",
      "source_fingerprint": "9f429581ce4bb89e32c19b8e9884858786b36ab8e70840070200c78ea985a6dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
