      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么说呢……\r\n果然你是一位训练员啊。",
      "source_fingerprint": "aac935c819332b45fbeb9759ab3d1d8cda21f2429b88b0ef394e09e88bdcaaf2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
