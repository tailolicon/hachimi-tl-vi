    {
      "uid": "zhcn:f073c49ae292fed764d61fb5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然想起来了，但也记起来眼前的这位\n貌似就是在教室里放黑烟的罪魁祸首……",
      "source_fingerprint": "666a0e21c8f1c819255280a5d21d668a64b30a46a310c8411bc001ab28dcab0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032001.json",
