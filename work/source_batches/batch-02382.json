    },
    {
      "uid": "zhcn:20208e422e1eafca3d29ea47",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（咯吱……）",
      "source_fingerprint": "e969aa1ca19d05ae4fba5ab78a8b51c15ebd5c4393f17222a727ae34883953dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032001.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:bc46b90199e8d236cbd31ce6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我什么时候被绑在椅子上的……！",
      "source_fingerprint": "cd085dd1269ac26cb1a4d016bb85c54c2cbd1c05c4ce6e7532fb6875eb5a8cee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
