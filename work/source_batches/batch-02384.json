    {
      "uid": "zhcn:330276f6ff55925c2d735b20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫",
      "source_fingerprint": "518141f549ec17c68539558e989d6e1e1572a826491709a731c97a2fe4f1603f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
