    },
    {
      "uid": "zhcn:998fce7f8363fc8a624ecbb6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（爱丽速子……！？）",
      "source_fingerprint": "52dbc285e825100556afac25b3a71f3bc00708e060f385fcca89b0171f9590e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
