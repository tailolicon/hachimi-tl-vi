    },
    {
      "uid": "zhcn:f0edd9953eb1193d8c6cb236",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对训练员来说，选拔赛是寻找发掘对象的场所，\n对马娘来说，选拔赛是展示实力的地方。",
      "source_fingerprint": "309d233c720efefbb4250a77fee9b0c91a8be827bbeebdba3d72eab090b5b276",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:7a872cacc564e450a894a1bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
      "json_path": [
