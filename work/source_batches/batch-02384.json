      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:06c5ebeb5e1cc392c1e97817",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶，爱丽速子！？\n是实力虽然很强但相当危险的那个孩子吗……！？",
      "source_fingerprint": "d327b7586777717c512a06966e12b4ffae73d8bfbfd8c43a81c7b0e80fd0595e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a80796c64faad111e4196330",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
