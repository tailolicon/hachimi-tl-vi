      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说到底我们马娘的存在本身至今仍然很神秘呢。",
      "source_fingerprint": "f83196578787b46066921d6421b372e5822b78f0560b5e8061afd420c9d1ae5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
