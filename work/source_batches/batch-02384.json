    },
    {
      "uid": "zhcn:5414197225374c51514bd862",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦呀……？\n你――这不是前几天的新人训练员君嘛！",
      "source_fingerprint": "4ed315f4a55e5882216a8b218e30ea4d64f24988ec5666e96995c9b1365cc0d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:dc2076d5b299efb210032cde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不是不是不是不是！",
      "source_fingerprint": "0fb5e9b8939ff5154415c6c30144198f3c86531dbbf593c3ecd11782094044e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
      "json_path": [
