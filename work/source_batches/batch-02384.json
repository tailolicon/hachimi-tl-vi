    },
    {
      "uid": "zhcn:c723cb21060bc13c2fd0128a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前几天的恐怖记忆突然苏醒，后背一阵凉意。\n然而――",
      "source_fingerprint": "623fd363256121ed309097c6eb190cced5d0a31bf35c0222ade404877eace99b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032002.json",
      "json_path": [
