    {
      "uid": "zhcn:525456f8c58262c94b0ee95d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……但是啊，你这光实验，不正经上课、不去参加选拔赛、\n不让训练员发掘，当然也不会出道。",
      "source_fingerprint": "654a3a22b32174e9af49821610cca61b9b922f0d94638747a911baef8ac2e2e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
