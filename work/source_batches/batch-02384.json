    },
    {
      "uid": "zhcn:4022da1fb313eb286dedd8cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是为了这件事啊。那么很遗憾，我并没有参加的意愿哦。",
      "source_fingerprint": "b89af861ee0d68a625a6c156c8686f8fb3ee04189c00b93fb6cdb05385d3d437",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
