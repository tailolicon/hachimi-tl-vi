        "name"
      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:9bcc9673512fa9ea44b78b0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过现在我感觉自己并没有向训练员们展示\n自己实力的必要。因此我不参加。以上。",
      "source_fingerprint": "6cb23e75443f48f3c320cd8acc73f9ac190d7a90d6a83a63c9fd5761e28aed48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
