    {
      "uid": "zhcn:56cc5ef5ae642ae157becdb1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――你这家伙在学园的立场，会变得很不妙哦。",
      "source_fingerprint": "7a542c65b3e9d72780c6e30bd248aa5048e6c287bce799df31ac2994490edb12",
