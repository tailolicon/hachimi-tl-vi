      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "突然怎么了。有倒是有。",
      "source_fingerprint": "5a65b69885ba78246c13d041187a1e378237dde11c4f8dc03b20ddcd6e29a187",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
