      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有着相当――疯狂的颜色呢",
      "source_fingerprint": "f406603497cf44c3dffbecefce761f469d68c94855c7fd212a82cf6145532a7a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
