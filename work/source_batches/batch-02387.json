      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:1479f18fcf2e494999be4aa7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子这样说着，拿出了一瓶颜色\r\n极其怪异的药物，我一把将其夺了过来――",
      "source_fingerprint": "096ecc5fae4f6fe02b948d7442b05fc2db8524b173235615a85cf32d215df66e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1032/storytimeline_041032004.json",
      "json_path": [
