      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想要──签约她！",
      "source_fingerprint": "705ae23c3ea5c530744999d92bb7a56630668cef7fa312e49ec56816337b0b08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
