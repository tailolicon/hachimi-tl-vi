    {
      "uid": "zhcn:c26573f020dbc1c271e24205",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稻荷一领先！稻荷一领先！2身距、3身距，\n逐渐拉开与身后选手的距离！！冲啊稻荷一、稻荷一！！",
      "source_fingerprint": "5158629a56638d1c7c054cae29b08b5641486e0c55de844c596279c4a558aab8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
