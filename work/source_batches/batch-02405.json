        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:76d1c9809b80a845cd0a2bed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看来师傅要我来观战的“一场比赛”……\n就是稻荷一与他队上新人们的模拟赛。",
      "source_fingerprint": "aeff34678ee656e81014a972dd543f346359ea51af6c87a79b0bb198c52447a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1034/storytimeline_041034004.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:aff06750bcd14738a803bd1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我环顾四周，师傅似乎还叫了许多庶民区的居民们来场。\n我看到荞麦面店的大婶、和善的店主还有猫老大……",
      "source_fingerprint": "74747a6dd63828fd75dd6b4315c0d2e84132954891ba9a7ea4331b1c43d55479",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1034/storytimeline_041034004.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:99c3831972e40b967100e2ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在大家的笑容见证之下──比赛开始了。",
      "source_fingerprint": "486811267ccb0ef4f559b9590b2c3fd71dd583f58c7839993c8362e67ea79f32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
