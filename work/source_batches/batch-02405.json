    {
      "uid": "zhcn:75a019d0940d1f9213cb882c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这还用说吗！！好──今天起我大显身手的地方，\n就从大井换成闪耀系列赛了！！",
      "source_fingerprint": "70c4f9864f249e3f8f4eef8dfbfab4cffae5a6d93c53a39d0678d181173e30f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1034/storytimeline_041034004.json",
      "json_path": [
