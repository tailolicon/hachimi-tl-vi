      "source_text": "呼、呼、呼、呼……！",
      "source_fingerprint": "89de2c380a6f2332e7ddbf790217237c721aaffe763c546f74b85c300009cc8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
