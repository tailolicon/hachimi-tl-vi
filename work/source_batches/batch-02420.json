      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:fa3ad902c5619cb55068bbe7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不如说……她应该是把自己放在了一个，\r\n可以集中精力做她认为很重要的事的环境中。",
      "source_fingerprint": "afeb1413420faaf90b553917a32db7fa88b08d023f07f57a6962fab1a1415623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
