    {
      "uid": "zhcn:a21f77cea31cfc72dab69a53",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有个孩子表情严肃地看着跑道上的马娘们，\n偶尔在笔记本电脑上输入着些什么。",
      "source_fingerprint": "cbdcc5bb756580bfa6dfb81d1fd0f31c7aa47145f6f1b6beb399d90e02e20077",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
