    },
    {
      "uid": "zhcn:c8890dd5069d3ac29d21e687",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不愧是优秀马娘云集的特雷森学园。\n我感到振奋的同时，偶然间看了看旁边――",
      "source_fingerprint": "0d2d1bd140efa71f8eceea7724250ebd28859c2c7db2fd404456aa757d38b67b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
