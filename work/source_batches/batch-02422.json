    },
    {
      "uid": "zhcn:723d75774ae2d60ad65f44d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……！？）",
      "source_fingerprint": "c89151ccc11e54671bcf28180092e08c44ffeb827761efdc42c80d1ca07d1712",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
