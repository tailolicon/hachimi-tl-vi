    {
      "uid": "zhcn:7ddc0f50c363433dab0de8f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（真厉害……）",
      "source_fingerprint": "3abbb2113a383bbfcb4ddff87e9e89c1a946d799146ce291fbad121fc72428cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
