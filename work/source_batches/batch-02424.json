    {
      "uid": "zhcn:8dcce99459742c63fb9bd622",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你突然蹦出来！　装成个救世主！！\n就凭你丫……能做些什么啊……！！",
      "source_fingerprint": "45fb76fd2e9c90eed9b56c2719d7ece9d25c602ab3a64289aae1dfd48ee2b6ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036003.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:a3fe355f642c0fb756f55bf9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（“我”还什么都没做呢！）",
