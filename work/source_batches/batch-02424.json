      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（入学后立刻做完的『Parcae』，是我最棒的伙伴。\n它获取的数据越多，所推导出的答案精度就越高――）",
      "source_fingerprint": "818d003cf2cf5f0ce5239ac143ca8178fcf6c86f5196dd6f0c9ca4abf61db464",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
