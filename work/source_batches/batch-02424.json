    },
    {
      "uid": "zhcn:2cf7f1d0f20c2e5581644903",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――想了解关于空中神宫的事……？\n那么，为什么要来问我。",
      "source_fingerprint": "e420c3cacfa2dbe2c14d4bc69b8c86277a07ad0ec92c678a5cea167f6bd5c503",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
