    {
      "uid": "zhcn:ac923dba29c97c0e958185bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的愤怒和悲痛直接冲着我来了。她的主张，应该是深深植根于\r\n她所经历过的事吧。这点我无权去否认她。但是――",
      "source_fingerprint": "b1ce1cb69c0c4bc075eaba8ab0de3518a7002a7754f50bcf249114186d388a63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036003.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:baf68d9e3ab74100a1246d8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……首先我得去了解她）",
      "source_fingerprint": "f331abf1a445685a75a62ad3cab4223bde0f2d10001b898bb227f894359b0d56",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036003.json",
      "json_path": [
        "text_block_list",
        53,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/53/choice_data_list/0"
    },
    {
      "uid": "zhcn:241210f067eed3a7c488db04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫",
      "source_fingerprint": "518141f549ec17c68539558e989d6e1e1572a826491709a731c97a2fe4f1603f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036003.json",
      "json_path": [
