    {
      "uid": "zhcn:9f4d8cbb6da15faf426539b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……总而言之，就是这么回事。\n明白了的话你就别再来缠着我。",
      "source_fingerprint": "e5fefeaf41f024d0a8ea793977d218361a731b5a46e876b70af1a364c5e7c6e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036003.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:e49e58bcefb3a78b55adcadd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
