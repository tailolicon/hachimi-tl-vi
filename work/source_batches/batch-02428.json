    {
      "uid": "zhcn:18d765f9104f88f78d00e23e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "白天你就一副坐立不安的样子。\n你以为我没注意到么？",
      "source_fingerprint": "81fbeb2379bfd61e384f3291661d125d9e6d90e86d9f3cc9dc3ee6daf26eabc1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
