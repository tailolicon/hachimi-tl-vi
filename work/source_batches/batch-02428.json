      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:4f2c5deea22dead3ed9ad1d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要跑了，你计时。\n……喂，发什么呆呢。",
      "source_fingerprint": "87090b7159363d248423286c292ed1f9bfc8d8aaacb010bcdf2636988bebf862",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036007.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6dd8b14c610d617dddf1e00a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我、我不是可疑人员！",
      "source_fingerprint": "53143bc9be708fea0ab77c31e40ab670efabe88108a1bc32e04de2502d2c41c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036007.json",
      "json_path": [
        "text_block_list",
        20,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/20/choice_data_list/0"
    },
    {
      "uid": "zhcn:376128847d2578d896786e4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？？？",
      "source_fingerprint": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036007.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:d0341ac5cecd42961d83691c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喂，那边那个可疑人员，停下来。让我看看身份证。\n……接到通报，你好像最近经常半夜在这附近游荡啊。",
      "source_fingerprint": "ef0968412eeae71314781ded9312de0c8817d998fb83779fb7a472ecd419cb94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
