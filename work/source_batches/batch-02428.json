    {
      "uid": "zhcn:8d33baa24dfee08c71ef255a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，你在干什么呢。",
      "source_fingerprint": "7499e88617ed57f03c6af5737677841d9c31685e8d30be565e9c5bd799428f63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036007.json",
