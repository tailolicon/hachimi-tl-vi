    },
    {
      "uid": "zhcn:a4aa3f939a02dc39dc39fac5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "似乎是瞒不过她了。\n我就把找萤火虫的事及其原因全都坦白了。",
      "source_fingerprint": "2419c986f6fde899d00f93a197dfc4c02b3b9269fcdcd35e0629856198b3e08e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
