    },
    {
      "uid": "zhcn:5ab36d2a152412b4834f59b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只是因为，你很重要",
      "source_fingerprint": "ec243bc36ef57abb90b73502edaab7f1c2287e137fa8f57661791adce09427cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
