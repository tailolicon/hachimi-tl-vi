      "source_language": "zh-CN",
      "source_text": "如果我真怒了你打算怎么办。\n那就不只是拒绝而是断绝关系了。",
      "source_fingerprint": "639c69117f13da7d93b24fb1de056eff764cddb993eb0b8ca142dc43f5ed5cdb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
