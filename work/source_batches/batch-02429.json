    {
      "uid": "zhcn:93576e9cb122ce39a947722d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "答案其实很简单，简单到连我自己\r\n都感到一丝困惑。",
      "source_fingerprint": "a4618dd4b3d7403ddc611817e91a33ce0f84f574d3fd9f3b5b19c5b51fa4033b",
