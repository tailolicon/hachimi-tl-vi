    {
      "uid": "zhcn:d2a23870e1c78c59e3a8cb50",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟她不是那种心软的性格。\n如果她真讨厌我，我现在应该早就不是她的签约训练员了。",
      "source_fingerprint": "db96dd2e0bccd31c93e95f9e58ccb097e77daefd095e2ebb80d2c10ec846df76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
