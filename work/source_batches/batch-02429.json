    {
      "uid": "zhcn:3eeb35688d9a68ed35c7f7b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是什么让你这样做。\n信条么？　使命感么？　还是最近流行这种手法？",
      "source_fingerprint": "12753300a5092850a54adfd43ebdd049f89d36b42776079c28247efa9bdcad9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1036/storytimeline_041036007.json",
