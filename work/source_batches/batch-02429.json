      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………哈？",
      "source_fingerprint": "b62bbdaf3f3189a8fdc6d63de231df7860754e2c4f11228a612a4f78a5aaa9a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
