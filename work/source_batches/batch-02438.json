    },
    {
      "uid": "zhcn:35a85346fbca4c151d74a107",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次，我还有继续逛蛋糕店的计划……\r\n我还会邀请训练员您，可以吗？",
      "source_fingerprint": "9c2cfe7a9107434f8850d64ad6344b37003f7e8ced4d15816ca3954165ca0990",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
      "json_path": [
        "text_block_list",
