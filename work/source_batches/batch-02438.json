        "name"
      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:14caa2f1cbcde311310f2e06",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "平常，荣进闪耀除训练之外几乎不怎么讲话，\r\n我想这会是个了解她的机会，于是就拜托她――",
      "source_fingerprint": "4e1331a1bb40168085ebc70e2348c67d1d7a729af7ce1f3fc81ac9dcb83fe8fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
      "json_path": [
