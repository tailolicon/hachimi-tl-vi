      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我感觉自己与荣进闪耀间的距离\r\n有稍微缩短了一些……",
      "source_fingerprint": "5d81ff7f3003c163e05f9d13a6c7cf2c5cdba4737c8ccc4f51fe1b007b7fbcb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
      "json_path": [
        "text_block_list",
        57,
        "text"
      ],
      "json_pointer": "/text_block_list/57/text"
    },
    {
      "uid": "zhcn:812d66cb503fb478833a0fe8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来如此……",
      "source_fingerprint": "3d06f5a891ba2624277731a988574bb9f2f48b7bccc320f0c352e6f3e08904e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
