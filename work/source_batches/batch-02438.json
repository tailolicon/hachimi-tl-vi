      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这多亏了意料之外的事呢。",
      "source_fingerprint": "1bc2fa6decf1d417f6baab554c9e19a794eee83ea4c7e251de5546213708db6a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
