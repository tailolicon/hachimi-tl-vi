    {
      "uid": "zhcn:efe5caa7f2e7d5fd6e228b36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "非常感谢。\r\n那么，我就把您作为同行者编入日程中了。",
      "source_fingerprint": "c6e38a42ce6164e84b21162c969e90530836b0e32182a71e323ce0e5f41e1f5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
