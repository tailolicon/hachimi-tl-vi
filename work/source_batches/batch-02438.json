    {
      "uid": "zhcn:1889b38be9e3355ff986fa81",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是指今天我偶然遇到了训练员。\r\n结果是，我获得了超出计划的收获。",
      "source_fingerprint": "77b25ca814bb1b7624a001bf1a6ca2242fcd0e8b8574b96e549b1e3bbf8094d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
