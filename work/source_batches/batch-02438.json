    {
      "uid": "zhcn:3412727edd3537f10b38d677",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以说，我当然是喜欢蛋糕，但更准确地说，\r\n应该是『喜欢蛋糕店』呢。",
      "source_fingerprint": "a7416733d3714af155f1d213048e78983edbaa1408f217deaab4c94584be9fd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
