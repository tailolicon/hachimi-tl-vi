    },
    {
      "uid": "zhcn:738cbe025a9748cb3d307800",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……只是，我不愿意承认去依赖偶然的结果是好的。\r\n因此，我应该从这次的结果中得出的是――",
      "source_fingerprint": "3e5b247a555e0cb1bd734c2cdf7b153141e515f991d078fa40b9d5e014237d06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:9ea8681bdee99027e4dacd47",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那当然！",
      "source_fingerprint": "ffcdd4271c8f826e06ddbfb1254144aa9eb74ce291dfe8937a4d4b6ea819a012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1037/storytimeline_041037006.json",
      "json_path": [
        "text_block_list",
