    {
      "uid": "zhcn:7a72b9e9148efc6ca13deaf5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我才意识到了公主需要的是气质和优雅！\r\n所以我才去模仿圣王同学――",
      "source_fingerprint": "888736ae748d76e590fd281ed8d9ad8feaf77c541cfd064dfc30d1933437ceba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1039/storytimeline_041039003.json",
      "json_path": [
