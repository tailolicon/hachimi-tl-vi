    },
    {
      "uid": "zhcn:100fd28cac144c07f12f5c55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "模仿，比方说？",
      "source_fingerprint": "9a44c3d83513721baca4603a24ec8c90af945f625c7b68548fbc7dacc8bf3818",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
