      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "二人目光注视着川上公主。\r\n她一边喝着红茶一边在休息――",
      "source_fingerprint": "33232c7cab7c6becc6867abe0eeb43ce007de8a24c67f7ad764f7d006d845161",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1039/storytimeline_041039003.json",
      "json_path": [
