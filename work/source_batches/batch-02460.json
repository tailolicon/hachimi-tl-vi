        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:7f489fea4c3f895951b77d76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从领先队伍的后方一口气加速上来……\r\n冲出来的，是那个马娘！",
      "source_fingerprint": "9083d9082d860e8d0b117f509daa1700b2877b100a52957f0b5846404a5c14f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
