      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:fe92e44054ee27cc29f7d780",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "罗马卷的赛马娘",
      "source_fingerprint": "b717ba14f8386138a7eb9ea6a7669a2902f80486faae5f95d4ae76d9bc8e3da4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1039/storytimeline_041039007.json",
      "json_path": [
