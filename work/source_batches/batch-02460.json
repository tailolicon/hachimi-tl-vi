      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "担当实况的学生",
      "source_fingerprint": "118e4a3c7640eb779e346ae073fd327e81322c79b3c55bdbffbb4859a2e353b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
