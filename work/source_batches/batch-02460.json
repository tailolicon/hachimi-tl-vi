    {
      "uid": "zhcn:0383b50b42956f0db9d611f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――好～，比赛进入中盘！　在炽热的太阳下，体力的消耗\r\n可没法跟平常比哦！　这种情况下谁能脱身而出呢！",
      "source_fingerprint": "6767c75ac8526f50988d3e95a53146a9664a6c438afe471625301f893ec6ecf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1039/storytimeline_041039007.json",
      "json_path": [
