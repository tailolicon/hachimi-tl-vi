      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是指史上最快售罄的意思吧……？",
      "source_fingerprint": "117d21f63efa69afc2ba887a6bda58131ec11105a4cd9b592c501833f44f9f10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
