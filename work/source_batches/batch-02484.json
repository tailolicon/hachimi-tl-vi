      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是──我不想只依靠才能的理由，\n也是我刻意挑战不可能的理由──Understand？",
      "source_fingerprint": "dd7a1b4686b519a0a37c4d8558bd8564b76b9bb17153de96c933cf020bb9452d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1042/storytimeline_041042004.json",
      "json_path": [
