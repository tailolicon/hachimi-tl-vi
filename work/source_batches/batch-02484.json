    },
    {
      "uid": "zhcn:a6d3493080da088e5ceeecac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "采珠",
      "source_fingerprint": "b0589b9ffcd8d20fe1764810bd01425a20cb1331d718258942cea39c70163e02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
