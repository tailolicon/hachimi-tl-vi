    },
    {
      "uid": "zhcn:423914d64db51621d2f359b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那你的目标是……？",
      "source_fingerprint": "3c33d1b65bc1eb8e24982de4eec79c153136570e400d1cb8596736d5b3cf2ccb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
