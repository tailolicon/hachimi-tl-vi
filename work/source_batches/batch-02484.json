    },
    {
      "uid": "zhcn:363876f309c97db333ff6986",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "采珠",
      "source_fingerprint": "b0589b9ffcd8d20fe1764810bd01425a20cb1331d718258942cea39c70163e02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1042/storytimeline_041042004.json",
      "json_path": [
