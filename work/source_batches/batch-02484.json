    },
    {
      "uid": "zhcn:fcf2e2bec40803b23acd0f85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──赛跑。奔跑、竞争、追求胜利，就是这么简单。\n每个国家都知道这种原始的运动。",
      "source_fingerprint": "844f7f15ccf52cb97cff966fdae8ca827e72a6283e14eb283f073d886273ec9a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1042/storytimeline_041042004.json",
      "json_path": [
