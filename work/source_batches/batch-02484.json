    },
    {
      "uid": "zhcn:bfce4be9caf1869cb48e723b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的奔跑能将全世界的大地连系在一起！\n我要在六块大陆！以及所有岛屿之间！架起possible的彩虹！",
      "source_fingerprint": "ad96fc6b36541b638b5055aa81d8fdc149ca9cb8c6c86c6e5c88a1e217bc0632",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1042/storytimeline_041042004.json",
      "json_path": [
