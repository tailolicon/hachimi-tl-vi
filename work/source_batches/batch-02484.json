        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:2a0be890ea7ca9ade6fcb271",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "采珠",
      "source_fingerprint": "b0589b9ffcd8d20fe1764810bd01425a20cb1331d718258942cea39c70163e02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1042/storytimeline_041042004.json",
      "json_path": [
        "text_block_list",
        25,
        "name"
      ],
      "json_pointer": "/text_block_list/25/name"
    },
    {
      "uid": "zhcn:ead8ece32ad21a92e73e2119",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要转播我克服各种困难拿下胜利的身影，\n就能成为世界共通的消息。",
      "source_fingerprint": "f9d179259940e58e1ed1763e5d3f282a6aff0f15b2f4ab50db658164980a0d8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1042/storytimeline_041042004.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:ff5a560ae0fa0a2d26363926",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "采珠",
      "source_fingerprint": "b0589b9ffcd8d20fe1764810bd01425a20cb1331d718258942cea39c70163e02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
