    },
    {
      "uid": "zhcn:a6e0cb303eb246c098723398",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要跑赢比赛来增加自信就好、只要能重新快乐地奔跑就好，\n直到上一秒我都还只是这样的想法──",
      "source_fingerprint": "67e1ebf12594a65a53ce1e5621429d08a62116617e4f61896d9a7973e6841ab6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1043/storytimeline_041043004.json",
      "json_path": [
