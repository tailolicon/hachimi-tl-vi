    {
      "uid": "zhcn:8f4683db8bd0146f13ccc919",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么样怎么样──！你们这些人都知道了吧！\n风风可是很厉害的喔──！！……嘻嘻嘻！",
      "source_fingerprint": "38fa52bdf412a4b159efe8eee09bda3804110ef7b09b3f3d3b97798d008faff3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1043/storytimeline_041043004.json",
      "json_path": [
