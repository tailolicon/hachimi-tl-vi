        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:e65f16cbd22c378b071d0874",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新光风的这场比赛结束后……\n她精彩的表现震撼了我。",
      "source_fingerprint": "0277fb44c098f7aafbefc40451a15aae0f806ccfadbbd2f413baab657fb315ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1043/storytimeline_041043004.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:dcf912c559ab9b9c47f6750e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那像是要撂倒一切的气势。\n更让我为之所动的是让她顺利取胜的那股执着。",
      "source_fingerprint": "ab7cecc2ddaedad8ccd6db6553857e7e9e070cccaa234578ada687ef7cbc90f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1043/storytimeline_041043004.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:73c5a57be0307d13c9070974",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的资质明显是鹤立鸡群的……！",
      "source_fingerprint": "54145732af715394a6b5cd468b458b86b9b499b43df6073b07f4c0bbe7add2cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1043/storytimeline_041043004.json",
