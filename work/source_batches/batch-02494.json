        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:a666219cdbf0f2c08007b545",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我本来就知道她有天分，但绝不仅仅是有天分而已。\n她绝对是能大有所为的天才……！",
      "source_fingerprint": "25ad37af9ff45e72e2991e63569de6284cdde5167c990bac763467e938c475b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
