      "source_language": "zh-CN",
      "source_text": "你将来也要成为大坏蛋喔。\n成为一个像风风一样的恶作剧天才！",
      "source_fingerprint": "abf6bb5e293cf6ccd10f3e8afc42beb750d2bc42755c82c3063dba5436c99b4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
