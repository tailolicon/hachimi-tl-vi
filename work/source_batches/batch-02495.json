      "source_language": "zh-CN",
      "source_text": "有没有什么方法可以活用她丰富的创意呢？\n我甚至一度开始思考这个问题……",
      "source_fingerprint": "987f366ef3aa9367f3c698654aea897c6c7cdcb745af4a82ab73fa773aaf41a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
