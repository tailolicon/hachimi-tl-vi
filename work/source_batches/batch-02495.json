      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原本打算抓住新光风的我却反被她抓住，\n硬是被上了一堂恶作剧的课。",
      "source_fingerprint": "2fe769de1abc8acbb3dbdfc5323ee58f1afbbef1340f31de02888e9d318511af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
