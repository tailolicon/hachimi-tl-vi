    },
    {
      "uid": "zhcn:512a7473bfe2367fa2df821a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总有一天，我也会像那样，作为马娘偶像熠熠生辉。\r\n总有一天，我也会站在舞台上为大家带来感动！",
      "source_fingerprint": "084c30023c136ad02328071f39880c85a44674e02b345973b2fda7dfe8612009",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:da9a8625e3c1ac6e6b6dbe2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "飞鹰……",
      "source_fingerprint": "c12e24333c3d53a67298873437a9fbefe526aa6a1cb0cefe51af25373848deeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
