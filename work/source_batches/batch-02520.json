      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:f737a7481ffdd7d28e955809",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——“就是这个！”\r\n在那瞬间，我就这样想了！赛马娘最为闪耀的时刻便是比赛，\r\n而胜者舞台，就是她们光芒所凝成的结晶！",
      "source_fingerprint": "77e6cfe8a713865f2aefe8b0a3771ecbc8a4313eadb663cb98473678cd3efe96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:ca2b17eff5c51ab734b3d1ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰",
      "source_fingerprint": "bb8018c249226ea876eeb5e8d071221a5848be1adb4b103c686c1c89ba93746d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:a550989bdb4ddcf1fab1dbb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以……我决定了。我也想要像她们一样……不对！\r\n我想要成为比任何人都更加闪耀，给予人们希望的马娘偶像！",
      "source_fingerprint": "4cc7e8db709e7e7420740efdbd424b905eec40470a63f4ca82ae4df05ce6e340",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:6773e0d645fd91d1edf4d226",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰",
      "source_fingerprint": "bb8018c249226ea876eeb5e8d071221a5848be1adb4b103c686c1c89ba93746d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
