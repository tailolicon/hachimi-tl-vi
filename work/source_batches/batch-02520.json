        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:148df8f4e7ca7f8fce73dace",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——对……就像今天的铃鹿那样。\r\n我也想要在无数观众面前赢下大型比赛，在胜者舞台中站在C位！",
      "source_fingerprint": "0cfcf651e3d86f12f58907955826361fe54f5105ca59a9dc18923e258ebcec43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:d79d38674e9462835628b491",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰",
      "source_fingerprint": "bb8018c249226ea876eeb5e8d071221a5848be1adb4b103c686c1c89ba93746d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
