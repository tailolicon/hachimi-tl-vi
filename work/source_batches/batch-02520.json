    },
    {
      "uid": "zhcn:c895fa859e55732de72a5a63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荣进闪耀",
      "source_fingerprint": "dddbabf0a14340be785a6989ad9c1b0d7af7714ae783df71e025920875aeeda6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:a28b359a3c3212f32a8bffad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，我也无法确认她能否接到电话。\r\n这个时间的话，她的手机应该正切断电源待机中。",
      "source_fingerprint": "57180ba26aadd382bf5d32b38aa7edbede8b8ea66d8581e111364119724086fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
