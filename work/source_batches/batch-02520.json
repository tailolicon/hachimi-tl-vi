      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:f4482f0f683d15b86ab27eb4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "沙土跑道的比赛关注度太低了……",
      "source_fingerprint": "6a0d01776461f71516eb43575344895bf6e3ac7520490a45f96610fbabaf08e0",
