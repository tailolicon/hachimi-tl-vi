    },
    {
      "uid": "zhcn:2707272c0869d3d1f670a10e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她上哪儿去了呀？",
      "source_fingerprint": "e596bc41617ae03dd06e4f4e719811860fbf725bb767e4f7888d2994fde236df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046003.json",
