    {
      "uid": "zhcn:f3c4c12ace26ed9ff096490f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰",
      "source_fingerprint": "bb8018c249226ea876eeb5e8d071221a5848be1adb4b103c686c1c89ba93746d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
