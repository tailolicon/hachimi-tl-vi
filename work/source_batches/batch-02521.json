      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你说过，不想被『适性』所束缚对吧？",
      "source_fingerprint": "c431590bcebc2de90f1cb9ee2a701570dbf1540dba0c78bc9702e07f535c9d9f",
