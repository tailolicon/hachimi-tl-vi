    },
    {
      "uid": "zhcn:9b7a1a75b2ab60ef1a0b2025",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要打动他人的心灵，与草地跑道或沙土跑道无关。\r\n但我之前却觉得……沙土跑道就……",
      "source_fingerprint": "132e4ae260297c2b6e11ec463117a8374aa07114fb67babfed700dfea401d698",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046004.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:136ff1eb6fac216538cbcbbb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在你怎么想呢？",
      "source_fingerprint": "b9000d9be85f61314e6d4527c9966635133792e28c73d81c1302e73f56c8d633",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046004.json",
      "json_path": [
        "text_block_list",
        16,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/16/choice_data_list/0"
    },
    {
      "uid": "zhcn:1a76428e2824c59943874a54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰",
      "source_fingerprint": "bb8018c249226ea876eeb5e8d071221a5848be1adb4b103c686c1c89ba93746d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046004.json",
      "json_path": [
