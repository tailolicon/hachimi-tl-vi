    {
      "uid": "zhcn:0b0243c0e87256ee45a7e0bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "仅仅因为不是“顶尖”，所以一直不为人所知。\r\n总觉得非常可惜呢～",
      "source_fingerprint": "0b9fe21d7113e45f8554a0ceca052d604332e776c03f1e0cf6f946e18a3c58a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1046/storytimeline_041046004.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:528ee4d1e44a976f3d157324",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你看了就懂了。",
      "source_fingerprint": "5bec999bf3771758e90bec9cb544957be7c70968449ac5f65737c23eaf4bbfdc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
