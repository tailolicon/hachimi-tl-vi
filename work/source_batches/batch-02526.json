      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "适合沙土跑道的赛马娘",
      "source_fingerprint": "a7cc3e57618e0827729ba7ff10c196ca99a11adc063e3c575359f8b46b41f79b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
