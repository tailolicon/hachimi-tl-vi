    },
    {
      "uid": "zhcn:39ee9d0ba0a2a2579fa70487",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        13,
        "name"
      ],
      "json_pointer": "/text_block_list/13/name"
    },
    {
      "uid": "zhcn:50e750f9c648abbdc8ad61cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为，\r\n后世的人们将这些故事作为『英雄的故事』传颂的那一刻起！\r\n英雄传记便成为了英雄奇谭！",
      "source_fingerprint": "4fc53aa840f390f4001d7f6e887179f1822b7a65d76bb9e0139c7f443dc89287",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:d991b247cd051474c4dd8509",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
