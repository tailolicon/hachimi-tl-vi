        "name"
      ],
      "json_pointer": "/text_block_list/14/name"
    },
    {
      "uid": "zhcn:8a9c9535f7e86ca6285dd8ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊！呃……这……不是……不是的……\r\n不好意思。",
      "source_fingerprint": "e4fb66dc436b804e5f505784121a68f0a5dcbcbe13908bc6c9e82e975d68e323",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:6e98440be31a6c548f39c3bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……？谢谢……",
      "source_fingerprint": "fff222771de7c23c3c99111cb51acb938c20f8e66b8389f090dc3bc106824595",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        15,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/15/choice_data_list/0"
    },
    {
      "uid": "zhcn:5fc367be11d1dd4a4561b8e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
