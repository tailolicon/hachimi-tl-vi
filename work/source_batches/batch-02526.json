      ],
      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:c8d690d6ce7ef8591a822c36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我又一个人自顾自地兴奋起来了……\r\n啊，摆放传记类作品的书架……就在这边。",
      "source_fingerprint": "0a0f592f71437e320b473fa1b2395e53edfb7adae41a3b51393b127670912f7b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:3b1ccc066765e02a2bc8f2ee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        16,
        "name"
      ],
      "json_pointer": "/text_block_list/16/name"
    },
    {
      "uid": "zhcn:0539c5751d5d04211fb93440",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不用谢……不好意思，我先失礼了……！",
      "source_fingerprint": "e81105cc01b1fbcee729f7420a6af4d937cbc946d9d7a28ac2265cf36d736845",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:c9331d3f907e7dbf1d112bfa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "突然就跟泄了气一样整个人都蔫儿了……\r\n虽然她刚刚说『不是的』，\r\n但我认为她并不是不喜欢英雄奇谭。",
      "source_fingerprint": "270ef7d0541d6f6d8149de1f2fd77fa1ab55a6fde57d11b1d9706acafd3fccaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:7e73955b5a897c079df4648e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她为什么要否定自己的喜好呢？\r\n——这个问题虽困扰着我，但我决定还是先从她刚刚\r\n指给我看的书架上找些书来看。",
      "source_fingerprint": "b68e2efdc19ae6fed9b267d7e840f7c9217f38e519314ba2ccf23b0b0c33f1c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:ef41418960fc1f453c9344f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "读得差不多了。虽的确是有不少虚构的内容，\r\n但即便是去掉它们，依旧是扣人心弦的英雄奇谭……！",
      "source_fingerprint": "bd1d39f21a25732026c5e848886b15a9fb40c2c1f45248d82000e8fb1ff3fe89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:45beb3f23d936f983bf82bc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……英雄……",
      "source_fingerprint": "53196d8113783be4eaff709f081b65ce6626efda020d44e9f1b71e91599c0793",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        2,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/2/choice_data_list/0"
    },
    {
      "uid": "zhcn:9ec514cefc4a76044db79961",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她奔跑的姿势虽粗暴而笨拙，却也显得异常高洁。\r\n那破阵而出、一往无前的模样，简直就是——",
      "source_fingerprint": "a30aed651d0454ca2c4e435ec5c20e5d1e7fe569ed504b3c4655989f6fd73538",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:92e0125efd8a9a7305643932",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:d30052c3f0e1bd42eb27a5d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……所谓英雄奇谭，是人们开始传颂英雄故事的那一刻起，\r\n才能被称作英雄“奇谭”……",
      "source_fingerprint": "79e33f6e4651f02a119797cca2aec5c9101f51d167510f04b4c24955a2aed693",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
