    {
      "uid": "zhcn:a978a894ba446ac4de7b98ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯嗯……吉兆小姐在……啊！在那里……！\r\n她、她好像已经在训练了！",
      "source_fingerprint": "bc28fa6c15a0f414c6b51c4ec862bf1b14d54082d98c1b0213e52f29ea34ddd7",
