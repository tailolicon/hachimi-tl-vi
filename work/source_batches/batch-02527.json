      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……您喜欢英雄奇谭吗？\r\n",
      "source_fingerprint": "607105b1cc1bf8beafebd2f9d5018a7dd51bf0d0efeb20ffa87c6ab9af62eb96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
