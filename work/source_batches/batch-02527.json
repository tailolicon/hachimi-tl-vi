    {
      "uid": "zhcn:c834c9128483f32bdc8194c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶？！不、不是……\r\n今天我已经请假了！",
      "source_fingerprint": "0239a91422095477113c01a28b522df42a5636cfa2ce261454944e608f59d744",
