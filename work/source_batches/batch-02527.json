    },
    {
      "uid": "zhcn:69f7a0811999791bd2183960",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那、那个……请问您……需、需要帮忙吗？",
      "source_fingerprint": "dc9a351aaffd920af9f7f17efaed787dd5e5bb5da57c3b27a04772ef74739ff7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
