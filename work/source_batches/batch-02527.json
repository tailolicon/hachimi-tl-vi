      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:30338f90a3fc406c8defffc7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在我们共同展开『追寻英雄之旅』之后的某天，\r\n我与罗布罗伊放学后在图书馆碰头。\r\n（译注：下文都会以罗布罗伊称呼荒漠英雄）",
      "source_fingerprint": "02fc98e3a2c42fcdba0071d339c96044837f4a81761b149ce2a9c51b9c27444b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
