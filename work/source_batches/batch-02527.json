      "uid": "zhcn:df5331d64014eecba6fe84a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我对查找资料略有心得，关于英雄的知识也略懂一二！\r\n我一定能帮上您的忙的！",
      "source_fingerprint": "a1c79ba171aabf49ab5b069a2d6f2183dee7ead4c0ea237b8b6af69a6c84314d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
