      "source_language": "zh-CN",
      "source_text": "啊……没、没事！总之，这也是为了我自己好。拜托您了……！",
      "source_fingerprint": "69fecb7aa02f73f6bf09711946222b51e980eb14f7b29f460059fce46e99f976",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
