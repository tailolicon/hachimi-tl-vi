      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:c7c727b84934d5a18a5b8ae4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她紧盯着训练中的吉兆，眼神异常严肃，\r\n连耳朵与尾巴也随着训练场上的哨声一同摇晃着。",
      "source_fingerprint": "585b5f9a4803c61cf00bdbbd469a7364316daad5678e1c8cf47ea84f4a211df1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:4ad654f76d9b314b4d04ed18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——你也想去跑一跑吗？",
      "source_fingerprint": "d12f19c3bea83445dddc3d102404636b0bdae6a8915824a9751b6225574569ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
        22,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/22/choice_data_list/0"
    },
    {
      "uid": "zhcn:17e07609425c0605f906ad2b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这看上去，简直就像是——",
      "source_fingerprint": "621d4a9fc8f91aab77f30cf6b27080e838499fb73a093e7ceccff53f370d25d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
