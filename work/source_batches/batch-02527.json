      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我！想为您的『追寻英雄之旅』尽绵薄之力！",
      "source_fingerprint": "af166c163203c4443582f37059d333e8350cb5ed7bdda092db3ad620c7b9fd38",
