    },
    {
      "uid": "zhcn:c63a8c840b45a564cb40e78a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "それは叙事詩にも似て",
      "source_fingerprint": "377308508ac9bec16803cc1b16574dd6224f785071e1775813e27a090f913b95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
