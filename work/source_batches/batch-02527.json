    },
    {
      "uid": "zhcn:13a2a51e7b17bd656226a734",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……寻找数月之后，我却仍连她名字的第一个字都没查出来。",
      "source_fingerprint": "467845210b875af4d89aa1a2c120239e88fffdcc9145cba9c4bd6f69fb3526d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047001.json",
      "json_path": [
