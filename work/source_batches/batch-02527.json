    },
    {
      "uid": "zhcn:91f9062d641690d0c36b7940",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是……？",
      "source_fingerprint": "0b56e85df34a3fbf397d9d2f1ee9b83b967ae8d34cdb489306891713e74b4f1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
