    },
    {
      "uid": "zhcn:e83caaaf5ff56d668a47ac92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（好强的压迫感……！）",
      "source_fingerprint": "917fcff3d80dbf86e03219440bdb3a331b0a75eebe7152d437b4ab480d9f748b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
