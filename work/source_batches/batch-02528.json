    },
    {
      "uid": "zhcn:fc3c3ac74c1aec83baf561f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶？",
      "source_fingerprint": "23c77ae11b382a58b7dd122bfd8c62421f5b91ca57d2b03a2544490330e909e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
