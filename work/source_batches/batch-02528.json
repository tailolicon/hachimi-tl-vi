        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:37e7c788e0a8a569c1872cec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，原来是这样吗……对不起，我太唐突了。\r\n其实，我经常会执教罗布罗伊同学的训练——",
      "source_fingerprint": "2dc89ba481f0d3e806ff03b496f032200642c06cbbf49f91361a084f0e1674a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
