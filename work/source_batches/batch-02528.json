    {
      "uid": "zhcn:22d2e0b5978614b41787aefb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那、那么……我先回去了！\r\n失礼惹！",
      "source_fingerprint": "5d58a6422fdf85642e7f55e5e416bdf53ac26c819c5547c3ffb589b27c479b9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
