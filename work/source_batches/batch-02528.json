        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:94883861160052ff4fce54c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很温柔的教官",
      "source_fingerprint": "2aec3630ad85848311010380037039b2f595cd6bc9a2a2b471c0ceebd0f99d44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
