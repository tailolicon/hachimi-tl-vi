      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:0f21a0e62f63bb35398a5412",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，对不起……既、既然这样，咱们先换种思路吧！\r\n先去旁观一下其他人训练时的场景，您看怎么样呢！",
      "source_fingerprint": "d1123e846bd998e68a735d03f0a09d7e5fe0426adc6849219438e209d423943c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:6f00938692fa4ee8562abde3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很温柔的教官",
      "source_fingerprint": "2aec3630ad85848311010380037039b2f595cd6bc9a2a2b471c0ceebd0f99d44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
