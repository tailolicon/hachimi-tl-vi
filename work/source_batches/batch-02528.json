    },
    {
      "uid": "zhcn:adbc99cbb345e54704946415",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那……那个～！　您好！！",
      "source_fingerprint": "19805e8aea7f3c0f3180a36b8851de82674a28459e8cb9422d6858cc8dbdbb32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:7cc09c99c39198831bbc3680",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不是的，我只是正巧因某事在与她同盟。",
      "source_fingerprint": "4bbbbca4483cdc11c66392b95f4da87fd46107789e74998a5ae300377a1409f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047002.json",
      "json_path": [
        "text_block_list",
        32,
        "choice_data_list",
        0
