        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/23/choice_data_list/0"
    },
    {
      "uid": "zhcn:4c13eba8498e7af55bf8df8b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟……罗布罗伊，你很不擅长『放弃』吧？",
