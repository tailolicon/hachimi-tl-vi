    },
    {
      "uid": "zhcn:36634e6258021486b714b1b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我……我自幼开始便从未有过任何过人之处。\r\n爱好也只有读书，所以一直……\r\n一直都非常不起眼。",
      "source_fingerprint": "e5d24ed62b5a5725febaf4e1fea5ac5fb4f6aac828f243ecefda858642b95373",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047003.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:1625326b2ef6d0ef999d830d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伝説を語り継ぐように",
      "source_fingerprint": "fb81d739ed843ad48a1e5c464be46d9bf2d54a9ff5a59df2046e086967fbdf15",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
