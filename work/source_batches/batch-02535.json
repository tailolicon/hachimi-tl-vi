    },
    {
      "uid": "zhcn:8feb77e205af276a91c4b8d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
