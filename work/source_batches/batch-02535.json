    },
    {
      "uid": "zhcn:ba1877581306bcb92480cce1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……",
      "source_fingerprint": "f297853ef1b1b7db68c78ec4d2b8a22265e660e6d8cfc87bc1e707b608964801",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
