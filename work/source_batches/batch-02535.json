    },
    {
      "uid": "zhcn:14c83448a1ddddd864ed04e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不、不过……我真的一点也不累。\r\n不如说体力还很充沛——",
      "source_fingerprint": "75d2d260325dc36ac5bd34ac6aebed3036987146e46943f3c586751ba898e953",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
