        46,
        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:eb3b6f651f529b925eed715f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……哈…………呼……那……那个……呃……\r\n那个……训练员……您为什么会在这里呢？",
      "source_fingerprint": "94f094b2f1cfc52550b1f99bc97bf40971770939e03e08b5955b74db1410b594",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:e9f9bc7547e55bb415402a55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要是能让罗布罗伊也开心起来就好啦……",
      "source_fingerprint": "f5679229e5fab334df526180a1c57977d152d6adc3dc38d14b7ffd9055909e9f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        47,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/47/choice_data_list/0"
    },
    {
      "uid": "zhcn:cdf9e2584fc98dcaf44d9ab9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽说有些犹豫是不是该说出来……但既然她都担心成这样了，\r\n我还是老实说吧。人们只要看见美丽的景色，就能打起干劲来；\r\n所以——",
      "source_fingerprint": "9818706f84b0fd8849ee8240b5bc83267fc489b291e81fe47f1565c0f82015a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:0e08115b51b56fbf2312cd75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        48,
        "name"
      ],
      "json_pointer": "/text_block_list/48/name"
    },
    {
      "uid": "zhcn:9007e1ecef62c2056143b36a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……\r\n都是因为我的错——",
      "source_fingerprint": "4c5f61a71e87bbc2699a0e4f04b9b04e21ad65f2fd36ff29af15f84fc6aba5fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:25e2afa31b773d179316a939",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——在这刹那，烟花自空中绽放，吞没了罗布罗伊的话语。\r\n在烟花的反复爆响声中，罗布罗伊再度开口了。",
      "source_fingerprint": "8b824d0e483daf0a4551266e3feec73b70459dee1a00cb6dee5cb4909cda1f5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:625bb46fa71ba67023144c78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的步伐已经相当不稳，即便只是单纯的跑步都已经出现\r\n严重的时间偏差，更遑论安定地进行其他训练了。",
      "source_fingerprint": "d001a24935fa087363a621e1e5d70e2112d5c2081310ab58c3146bc521fb981e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:da217c578a1cf8e9f68e6baa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        50,
        "name"
      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:b9897b2ef6f2f5ce6c019216",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不。您做的一切……\r\n都是为了我……对吧。这才是……训练员。",
      "source_fingerprint": "3281089280f96e0fa8cc2f26d45f4b9b7e375aac978349d3f5a47ea45a5cc609",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:7c74add28a1af7be75d569d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "表演告一段落。天空暂时陷入寂静之中。\r\n一时间，只有温柔的海浪声回荡于耳畔——\r\n这时，我看见罗布罗伊脸上浮现出柔和的笑容。",
      "source_fingerprint": "069cbc2b921d2769fbc28adf41b43e7188d7338d1b9c49b498b7148f23f12b4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:9e6ffee93366d18c58509ba9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        52,
        "name"
      ],
      "json_pointer": "/text_block_list/52/name"
    },
    {
      "uid": "zhcn:e590949038256d01791b5ef8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，您早就是我理想的对象了。\r\n既温柔、又努力，而且——",
      "source_fingerprint": "d7ff4b35a6395741bd985d3590214bf0836073049568d5a79a9b98c492a6ef65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:f92cd6d7c9a9bd0d365657c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        53,
        "name"
      ],
      "json_pointer": "/text_block_list/53/name"
    },
    {
      "uid": "zhcn:21f2aa41fdd447a34967ed6b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是位对英雄而言，无可取代……\r\n想要以心相交的，温暖人心的人。",
      "source_fingerprint": "9eb5b0c99264d51787f149006dc8075d0f653e7ca02708ade153e06843ae5248",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:e3bb32cd251e066746643dfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后一朵花朵绽放于夜空。\r\n罗布罗伊仰望着耀眼的夜空，其侧脸正闪烁着五色的光彩。",
      "source_fingerprint": "fda259270c101a554a9387dc487a2e907fe2534ebe235bd1930f00a3ae7e5ee9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:b3b940c41b0ed287c83c8b92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "英雄也是要喘口气的哦。",
      "source_fingerprint": "2dac3e27d3daeb3426f26a73cfd77d2755d6f36cef2c91a6c74990e603ba903b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
        "text_block_list",
        6,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/6/choice_data_list/0"
    },
    {
      "uid": "zhcn:b66bf0ef0cf61e49bba412f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1047/storytimeline_041047007.json",
      "json_path": [
