      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是……算了。\n反正烟火很漂亮……",
      "source_fingerprint": "9fd29af45c40e3539508bbba521ec60bd3965e1c4939295b290e9d73d06368a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
