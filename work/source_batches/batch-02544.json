      "uid": "zhcn:ea45a6de0eee51fc9f675a5d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本来应该是这样的──",
      "source_fingerprint": "f54d30192f7d78cd9ae96e5f4df294eaafc35643d73931b3e39336279e4b3b9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
