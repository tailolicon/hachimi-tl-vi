      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:e82c1e9138024f5c7603a4ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "整理训练资料吧",
