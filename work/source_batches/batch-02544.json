      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:0bafd684dd29c839861d8ecc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我明白了！",
      "source_fingerprint": "4abd4665a269fc5b7d6d557dbfc6fb51a6eb9290ccf8953080806ab59acbdf6e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
