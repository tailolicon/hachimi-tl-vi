    {
      "uid": "zhcn:d700748fc224c844a3213f60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔，找到你了～训练员，我们走吧。",
      "source_fingerprint": "fc362d940ef4d080e4299cad93b28b70dad5544ae834657c043393704d3e3340",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1048/storytimeline_041048007.json",
      "json_path": [
