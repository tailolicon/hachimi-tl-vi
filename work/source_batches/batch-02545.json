      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她紧紧拽住我的后背，力道之大令我一时间喘不过气来。\r\n在离我们不远的地方，传来摩托轰然落水的声音。",
      "source_fingerprint": "b96ec4bd4f30e9841c6397de04adcdafcd38a3bcc44232de00d9b4bda4ff85a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049001.json",
      "json_path": [
