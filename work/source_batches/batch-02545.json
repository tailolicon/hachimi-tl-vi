    {
      "uid": "zhcn:65e3387bebe69627fb00cfee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "刹车的时机非常完美。\r\n这样一来，我的位置一定会比对方更接近海——",
      "source_fingerprint": "35e9e77f667a301c0c2565fe5a018b12f567738bda4ef15b8b4bcd79e1d598a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049001.json",
