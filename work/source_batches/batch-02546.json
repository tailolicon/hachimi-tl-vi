        0
      ],
      "json_pointer": "/text_block_list/31/choice_data_list/0"
    },
    {
      "uid": "zhcn:a154c04acdc256570af94f20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是……？",
      "source_fingerprint": "0b56e85df34a3fbf397d9d2f1ee9b83b967ae8d34cdb489306891713e74b4f1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
