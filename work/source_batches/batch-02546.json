    },
    {
      "uid": "zhcn:f4f1aa83bc6253c0ec99830c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征递给我一张纸条。\r\n我谢过她之后，她咂着嘴离开了。",
      "source_fingerprint": "2256ff8cc50a0ae7b65dc14d9bb7ac21854846c9797f80ac6911c8424fdb738d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
