    },
    {
      "uid": "zhcn:c128b67968717c2e4fde117c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高谈阔论这么大一堆……结果就这样。\r\n我还以为她多少也算是个令人愉悦的家伙啊。",
      "source_fingerprint": "34a4cca1f5142ac8e8d67ce3fe0cef8396f3a53da5f9a8df451df166a85885ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:8ae2ff112ff2a0b4dbb12ef7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老师？",
      "source_fingerprint": "0ee767e1a6d93813145f270530598ff2e6fce5af4abcef1d05d3b769b1d9d352",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
