      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征。\r\n……然后呢？你就想知道我的名字？不止吧？",
      "source_fingerprint": "9c9c26477ebfbaf7040aa7235f76bb0ece4ef368e46de91d0e5ca80c83e9f06b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
