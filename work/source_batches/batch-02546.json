    },
    {
      "uid": "zhcn:2d3d1462031b4e246d49472d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前辈训练员",
      "source_fingerprint": "28368bc5f3c0a28228256a15f37d5afcd7aa93e7f6889b318a2b7110a64bafb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
