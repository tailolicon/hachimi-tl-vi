        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:4eee9e5e5addab09aa217e7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（明明要求已经低到什么情报都行了……）",
      "source_fingerprint": "757604d9933f536b65986398cc5331d961855f99b2ff2b89b6bbac2a4b4b2bb9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
      "json_path": [
        "text_block_list",
        30,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:0484c9628b68a5114363d163",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我叹着气拍了拍身上的灰。\r\n很遗憾……今天没有调查到任何关于中山庆典的情报。",
      "source_fingerprint": "5f2dbebd05b03c0e4fb66f14b665f92c7eede0a61ffeb6389d1ed35772bd7038",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:10c1716934720b211029f72c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是……？",
      "source_fingerprint": "0b56e85df34a3fbf397d9d2f1ee9b83b967ae8d34cdb489306891713e74b4f1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
