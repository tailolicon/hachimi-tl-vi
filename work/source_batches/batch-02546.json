      "json_pointer": "/text_block_list/41/choice_data_list/0"
    },
    {
      "uid": "zhcn:81009b0ca4acf63f3b904e79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
