    {
      "uid": "zhcn:54b9f99249ddb722b6993613",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……听好了，那家伙有个致命的“缺陷”。\r\n医院里有个人称“老师”的家伙好像知道这事。",
      "source_fingerprint": "7d1e1a21404e3d5411c4cbfb4865b2afa78af1b068c3c2fca2374111d8c8950d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:e1cedb8d22708e67915301f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
