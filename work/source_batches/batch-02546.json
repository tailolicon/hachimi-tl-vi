    },
    {
      "uid": "zhcn:b881928518e33814fe9bb5ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这里是自由竞技场。\r\n只要想跑的人都能上场比一比的法外之地。",
      "source_fingerprint": "f50233a77186a4aa1d109a0c37b02689f9d956687022f5d6c6758429110747cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049002.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:f8fd8fc147f096086ce22753",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "难道她今天就在这里……？",
      "source_fingerprint": "44fe0e42f34600abca7c8ed866e3c479cad01c6fe1046df17fad2cbd1f87c5ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
