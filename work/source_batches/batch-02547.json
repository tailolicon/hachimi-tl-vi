    {
      "uid": "zhcn:7fc99fcf202ba44405744c0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        12,
        "name"
      ],
      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:4417c539db8d4daff38f1354",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大概是在一瞬间突破了身体的限制所带来的副作用吧。\r\n但她以一介出道前赛马娘的体能，将世界级的赛马娘——",
      "source_fingerprint": "a3b7dcee925d7da3cc46ec8e4359f2815b32d279ef5ffc4d8268ca3d5dc215a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:2f9b7e7689a2c67af86d17dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您没事吧？！",
      "source_fingerprint": "f90401387f3c9867cb45845c8a764d66c4af78645e48bd2319116a8ac04156ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
