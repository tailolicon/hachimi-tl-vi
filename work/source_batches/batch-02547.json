    {
      "uid": "zhcn:33b68d6ae4fa21c2e7fe2027",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典",
      "source_fingerprint": "53c202db2755a9750c0769d373f4610457612e8abd3feb5044ef7914f3c657dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
