        "name"
      ],
      "json_pointer": "/text_block_list/14/name"
    },
    {
      "uid": "zhcn:62a14f3907ce3046160458ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对、对不起……我太兴奋了……\r\n咳……咳…………\r\n……失礼了。",
      "source_fingerprint": "5cf0e0f76ba32c41c88a63bd714eb23a031a33eaee05dd81a976bcddb96df0d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:877366e89e3e8d74c9054114",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        15,
        "name"
      ],
      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:dcbf827c4ef9bab4bca5e3ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……训练员。\r\n请您让她……『活过来』吧。",
      "source_fingerprint": "cc030df4236e0c6cf4a9c5c95bb89e4a39324da1b133b22cda891cc423fec584",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:72f1f9d75b9ac7bb3fd0483f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        16,
        "name"
      ],
      "json_pointer": "/text_block_list/16/name"
    },
    {
      "uid": "zhcn:4f586e3eaa009b489b23c64c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那孩子曾与后巷混混们厮混在一起，沉迷在一些危险的游戏中。\r\n因为她觉得只要和那些坏朋友待在一起干些违法乱纪的事情，\r\n就能轻易地感觉到心脏的跳动。",
      "source_fingerprint": "24e73a5ad31739d66b69f426968ff002f72e492b12436f8fd92bec7720050c43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:b8d4bb76a05e50d47596b866",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        17,
        "name"
      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:2efcc66aa4b5e39102819949",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但那种程度的刺激，对她而言也不过是玩乐而已。\r\n她内心真正追求的是——",
      "source_fingerprint": "bc784f5ea7cf0cfe5e729a6d22981ccb0b757099eebd87489884e8f869012614",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:6d919ff7d5805cb3a4677ca0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……让本能尽情燃烧的比赛……",
      "source_fingerprint": "7ef5be3995616c5aca2b551469a26846a389c5e1844992ec15484741abf4ad18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        18,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/18/choice_data_list/0"
    },
    {
      "uid": "zhcn:3ec949244eaf67108879acb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        18,
        "name"
      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:3841b2c96aee457826677d1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——能让她的斗争本能尽情燃烧的，只有比赛。\r\n只有在比赛中，她才能感到一瞬间的解放感。",
      "source_fingerprint": "4872a0176780313c294d143c26da5629502aa319ec8e0b1756366132c819ddec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:b8cd43bcfc4c2dcad75e659b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便离开了医院，方才录像里中山的身影依旧挥之不去。\r\n那和她在选拔赛上展现出来的实力截然不同。",
      "source_fingerprint": "77c67e6369bbe12532481aed32071c57c6752b44d797e59ced3563f316f09a21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:2d63a59879a4cdd7060e469b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶？！",
      "source_fingerprint": "6e108c325e5b41fddab27ae0037f75d99a6513f292216b1222bd24d0ca26af90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        2,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/2/choice_data_list/0"
    },
    {
      "uid": "zhcn:3fe106dc1b33c364a4cc5d40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:6cbfed41f49a733737226ad1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成为了一个法国出身、已经名满世界的赛马娘的比赛对手。",
      "source_fingerprint": "284b85932e9f469c64206dbcfab54d440bf89111c21094e1a06cbeef60b8691e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:844d9ab0aa382bf9eff08f97",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（比如录像中的那场比赛……）",
      "source_fingerprint": "ca4aa273b50494640c145570a77d219b63792c10ae70371b03a2fd9ecc8b153e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        20,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/20/choice_data_list/0"
    },
    {
      "uid": "zhcn:41329a47c8b137865e3efe1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我已经明白问题所在了。\r\n对她而言，比赛的分类只有“能点燃本能的比赛”和“其他比赛”。",
      "source_fingerprint": "f9d0446397fac21dbc587f1f9727af9fe1d733acef62baa19955f110b2179863",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:d766a64a78b650a1fa57be56",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这种豪赌才能点燃她的本能吗……",
      "source_fingerprint": "98b95c5afad231d0bcbbf1c28584543770e9ea114e192123ecc31ea558b702d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        21,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/21/choice_data_list/0"
    },
    {
      "uid": "zhcn:5cd42f860e9b4286a86facfc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这种豪赌才能点燃她的本能吗……",
      "source_fingerprint": "98b95c5afad231d0bcbbf1c28584543770e9ea114e192123ecc31ea558b702d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        21,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/21/choice_data_list/1"
    },
    {
      "uid": "zhcn:93bb5cc2c1fbfae6d03f3edb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对手明显过于强大。无论再去问多少人，也不可能有其他人愿意去做那个赛马娘的对手。\r\n但是，如果……如果她真的赢了的话——",
      "source_fingerprint": "d803229e707905d3dda06655bca01dd0955e9ec9694fad7c08ce050a417ffa9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:efb02e53fec4034d5b25cab3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那如果我能再次创造出这样一场豪赌的话……\r\n中山庆典也许能够再次感到自己“还活着”。",
      "source_fingerprint": "27c904d189a2857e034c3fff076235502ee827047e843178f3b1858ced8a8623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:361b2223f9d412e77cf7c90f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果，我能让她“活过来”的话——",
      "source_fingerprint": "d379bf51519ff897a0cd4d2de8c8fc66d1dfbdab72c73328de09326c3d17a44f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        23,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/23/choice_data_list/0"
    },
    {
      "uid": "zhcn:1448281e83ae77b3ff43a118",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果，我能让她“活过来”的话——",
      "source_fingerprint": "d379bf51519ff897a0cd4d2de8c8fc66d1dfbdab72c73328de09326c3d17a44f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        23,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/23/choice_data_list/1"
    },
    {
      "uid": "zhcn:628f26e21fdb0905d8906f77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "口干舌燥。\r\n我从干燥的口腔中咽下最后一滴唾沫，再强忍着干呕的感觉将之挤入喉咙。\r\n……接下来我所思考的一切都不过是妄想，是假设：",
      "source_fingerprint": "aa5680ad5566631ca032d74a6558cff88e6d7f7afa5d356b1637eacf79a28780",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:52d2f85f418132be75c85a20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我就能以我一介新人训练员的身份，将那足以与世界一战的才能，\r\n“亲自”引领至真正的顶点之上……！",
      "source_fingerprint": "bc26076313d06ed4b675cda1023698b5113fed699adee69fe0d47feb68a3de7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:64a48617b7bc50c932c19759",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是夜。在美浦宿舍宿舍长的首肯之下，\r\n我站在宿舍大门前等候着她的出现。",
      "source_fingerprint": "14d8c2af4a1e359171a1e425cb28cb59877e50beef4ca98572e0dff9303fedcf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:bd8c40cbf287ba6a997fa483",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我就觉得等在这儿总能遇到你。",
      "source_fingerprint": "9b0221103170c13905e0f0dc60a4d0aa0c86f8bd5a283692ff8b6acc17230d1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        26,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/26/choice_data_list/0"
    },
    {
      "uid": "zhcn:0f35fa04a15a348448d6998d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我就觉得等在这儿总能遇到你。",
      "source_fingerprint": "9b0221103170c13905e0f0dc60a4d0aa0c86f8bd5a283692ff8b6acc17230d1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
