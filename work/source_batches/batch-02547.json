    {
      "uid": "zhcn:6750a277ac176a997418ef42",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以那天我真是吓了一跳。\r\n明明都进了特雷森学园，她却一点儿也没有变。\r\n庆典在那天——",
      "source_fingerprint": "1839bb0e5be5e7208c3a6c6e9085578b03e975ae8057218fe184c4909aac31d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:7da56cc92b6f89c8328e198d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……还活着？）",
      "source_fingerprint": "d8c03fcc473e65498513fa481393f0a1e19492838bd54ff89397fb7221392dfd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
