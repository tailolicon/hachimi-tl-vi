    },
    {
      "uid": "zhcn:bd04f718280c4afe9225c392",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……咳、咳咳……！",
      "source_fingerprint": "8564b3ff7a46a4ff6303e30bb4df3493f09ddadd6629039c9a0baace34f52da6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049003.json",
      "json_path": [
