      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『——还活着啊。』",
      "source_fingerprint": "6ecc66244c63e23d18f401bc8e6fbfb5b01f2ecdbd17a2c321043e9b830c31d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
