      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——…………哈？",
      "source_fingerprint": "0e7c38977951f1f88dd8eb62e209bd34d828c20eeb334b391e4849cf52798823",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
