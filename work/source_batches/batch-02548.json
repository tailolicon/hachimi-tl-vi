        17,
        "name"
      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:b9f696b42666c700aa25d18e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典的速度减慢了！\r\n她已经跟不上神鹰的节奏了吗？！",
      "source_fingerprint": "44cfdfd3f06d805f7b3da1ffdcebaa93552704f1b1ac466f39a7e4c2c5aa88fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
