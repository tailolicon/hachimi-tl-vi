        18,
        "name"
      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:880d47636f471630f94e9cd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那就由我来引领比赛的节奏吧！！",
      "source_fingerprint": "4755ef9ce14833c788df95887da2b1414a868bada2f22bf30ec3a4afcd57b700",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
        "text_block_list",
