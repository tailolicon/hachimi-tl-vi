    {
      "uid": "zhcn:d58b77e03b2cf78bb5b61874",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山的原班主任",
      "source_fingerprint": "a041ed342547346684eb2e96b916fdcb947663684b2c80d97fc16dd9fbc77012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
