    {
      "uid": "zhcn:00bdb2779a8e12fcc35e338c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后就这样把全世界都拖下水！",
      "source_fingerprint": "d7132964cf0ea31ad89b880f40e4b5539f8d7b274b57fce08e28c9d23d4c7761",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
