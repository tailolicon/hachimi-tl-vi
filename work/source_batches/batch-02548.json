    },
    {
      "uid": "zhcn:887f07bc38d54f05bc48c584",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神鹰",
      "source_fingerprint": "795f13602f1e9cddca3fec6d57b66ab4924d833a2a706e841577ffebe02c9437",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
