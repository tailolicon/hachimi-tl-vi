      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典",
      "source_fingerprint": "53c202db2755a9750c0769d373f4610457612e8abd3feb5044ef7914f3c657dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
