    },
    {
      "uid": "zhcn:a4bc32e44cc79bfc38507ea4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
