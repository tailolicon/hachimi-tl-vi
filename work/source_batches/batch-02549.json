    {
      "uid": "zhcn:8d4916d64b96e55970459255",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（这就对了！向死而生的豪赌！热血沸腾了吧？！心潮澎湃了吧？！\r\n这才是比赛！这才是对决！这才算得上——）",
      "source_fingerprint": "fd3f723dcb30c8d96509c839452e25cb782b7a9f927d7eabfc2e100b27888739",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
        "text_block_list",
