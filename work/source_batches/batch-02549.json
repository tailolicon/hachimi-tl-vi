      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……？哦哦，训练员啊。\r\n……你怎么脸色发白啊？",
      "source_fingerprint": "d26a2ea18a0cc87bece739a24767f0622636170625cb7f9ca6c870f8ccbf66c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
