      "json_pointer": "/text_block_list/12/choice_data_list/0"
    },
    {
      "uid": "zhcn:b93e28434e83750e474f7775",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不仅如此，我还听说了不少关于她的流言。\r\n按理来说，她应该不会——",
      "source_fingerprint": "2ab7db7f7adbdc0de8819374afccd5c9e9b94e0d8238ac2c8f19f0e4659980a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049005.json",
      "json_path": [
        "text_block_list",
        12,
