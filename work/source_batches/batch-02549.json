        0
      ],
      "json_pointer": "/text_block_list/10/choice_data_list/0"
    },
    {
      "uid": "zhcn:7af90bf5bb1dbf31352623a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "痞里痞气的马娘",
      "source_fingerprint": "5576c9fd269a6d274ce490d9080c4435dbae32689f6a8e51407b7a7b5b9d8698",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049005.json",
      "json_path": [
        "text_block_list",
        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:53b0ce15a1f5b12d9a9f5436",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "他们可是脸都气歪了哦。\r\n啊啊～要是中山被逮住了的话大概就惨了吧。",
      "source_fingerprint": "730cee4a187e96f411f5dc3704a63030264a2afa75e089484e35512ed64bbd7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
