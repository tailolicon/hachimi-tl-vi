      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主持人",
      "source_fingerprint": "f6ed44ed7a95b06e53444ad1a2cea67fb11356a9cc0cf6e05d4901cd3887226f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
