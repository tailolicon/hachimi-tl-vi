      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:65f97e14c28d3cdfb13adaea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后，我继续寻找着传闻里中山庆典曾经现身过的地方，\r\n但始终瞧不见她的身影。",
      "source_fingerprint": "6fb50d242abf4126811ba23b93e197157c96dfe7ecd81451d4d99c92af18fc4a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049005.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:d52d7d5905484f2cb4587a3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，中山！！",
      "source_fingerprint": "1dfe5b001c0a30a29507962f9750d52b2b8bf1b74b31b5570e58a511bb0cfd5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049005.json",
      "json_path": [
