    {
      "uid": "zhcn:4f1a4c3c3a0e784578feee58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
        "text_block_list",
        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:59fca1e6c41067b462ce2e94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "满足了吗，神鹰？在大众面前上演一出热血沸腾的复活剧，\r\n再一次吸引众人的目光……怎么样，有抓住这一线生机吗？",
      "source_fingerprint": "144c72cc76d5155528f794c62861fd8500323d7f73323088355eb4b9ab881e23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049004.json",
      "json_path": [
