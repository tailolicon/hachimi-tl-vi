    },
    {
      "uid": "zhcn:563922568ab30048244c5d5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "泥まみれて朝日に向かえば",
      "source_fingerprint": "c289c2295959632e32dde070fe5f9fb415428c997714f691c44681dd76e7bb29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
