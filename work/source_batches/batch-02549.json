      "uid": "zhcn:7f63a71a13d200f2ebbdec84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实……",
      "source_fingerprint": "6cf8ecea00ec797f91baf9b1b6f8d477b00571ce94bdd883229f93a44ea96b5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
