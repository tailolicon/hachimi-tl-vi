      ],
      "json_pointer": "/text_block_list/34/choice_data_list/0"
    },
    {
      "uid": "zhcn:975b7b646b3a8fe43c1eb891",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "快点吧，我都快站感冒了啊。",
      "source_fingerprint": "bbc63e74084b7b209801ef252f903b9bc452f1c18141d6113600eb1d95237b1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
