      "source_language": "zh-CN",
      "source_text": "……！！",
      "source_fingerprint": "75c76618ea30039a0fb2f14669e6e322cf914e6ad71893b72e49aab3cca0041a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049006.json",
