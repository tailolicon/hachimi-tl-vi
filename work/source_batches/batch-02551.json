      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:8f7697f4baf39a3819bc7299",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来啦中山！你点的牛肠煮！",
      "source_fingerprint": "ccc4d7e9e17931de692fc413e994503010f7a6d6f3c780d318e1f316b83a8e67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
