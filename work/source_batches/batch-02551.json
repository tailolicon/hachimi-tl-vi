    {
      "uid": "zhcn:daecce67914cbbd77cc0597d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "领头的男人",
      "source_fingerprint": "73a19ec7780bfe81bf2316d6ac89d3c3cb2687973229cdff697fa661045a9530",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049006.json",
      "json_path": [
        "text_block_list",
        31,
        "name"
      ],
      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:a046abf609382a8880b3ba4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……看你那徽章，是她的训练员啊。\r\n既然你喜欢出风头，那咱们就在中山之前先把你收拾掉吧？",
      "source_fingerprint": "8280c22e4fe0fada603024c75380a0a527c3e411d8e43e0c16f1fd665d5a8228",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049006.json",
      "json_path": [
