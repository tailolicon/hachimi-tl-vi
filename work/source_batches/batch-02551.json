    },
    {
      "uid": "zhcn:1341ac75f36adb59417142b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "领头的男人",
      "source_fingerprint": "73a19ec7780bfe81bf2316d6ac89d3c3cb2687973229cdff697fa661045a9530",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
