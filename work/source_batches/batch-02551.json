    {
      "uid": "zhcn:18a3dc71362d7dac6b80d4cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不良打扮的男人B",
      "source_fingerprint": "b67dd8dca2a72bf9cf447ff252b0c1d5df5ac3713cdc528ae17b4983fefefb0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
