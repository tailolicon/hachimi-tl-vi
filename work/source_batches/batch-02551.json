      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:2cb5c046e3d23400b8f3ff5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟着中山一起，晃悠到了巷子里的一家小餐馆旁。\r\n这家餐馆的生意红火到了屋外也摆着不少桌椅板凳——",
      "source_fingerprint": "1961d965cbad79b03f454cb032228b8f98ea089359a584ceb26c42c6624f5d62",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049006.json",
      "json_path": [
