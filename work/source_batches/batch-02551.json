      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来啊！！",
      "source_fingerprint": "6b08256284574b8159e71d15183c095c142d727e4abe90ddf9d5668b0ae10e05",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
