    },
    {
      "uid": "zhcn:3641a9064948251a9a565b70",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "狂わばもろとも、死ぬまで踊れ",
      "source_fingerprint": "63ae0edd9b7eadb8194c02b7420078a578796709527585988b8e95cded23422f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
