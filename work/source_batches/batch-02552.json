    {
      "uid": "zhcn:dc58f0c0d94388cacdd3e500",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "！！来了！！开跑吧！！",
      "source_fingerprint": "7036f9735ec7d8e564215a76101b72502e0ff1f8cf5fbf6097778aeb350672e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049007.json",
      "json_path": [
