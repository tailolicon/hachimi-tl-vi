    {
      "uid": "zhcn:f383c6d5ab077dde4cab3e34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大方向没问题……\r\n接下来，朝着森林的另一头前进就行了。",
      "source_fingerprint": "c5795593ef23dd9c7d0503bc676f3487f630eb9c81c57bf1648c75d70bf3d6bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049007.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:85b5a1b7bc1e9cc6ebae566e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典",
      "source_fingerprint": "53c202db2755a9750c0769d373f4610457612e8abd3feb5044ef7914f3c657dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
