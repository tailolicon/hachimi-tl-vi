    {
      "uid": "zhcn:f8d5f248d6c8fde657e14c82",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……和那天回家时的感觉一样——）",
      "source_fingerprint": "f33eed95e93887d44591697cd5fc283b6cef91934ac33eb238c1a15217f5556a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049007.json",
      "json_path": [
        "text_block_list",
