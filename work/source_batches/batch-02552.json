    },
    {
      "uid": "zhcn:64f9c26dcdf440f272fb7c5d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈哈哈……啊啊，没错……没错啊。\r\n现在就只能全额下注，置死地而后生啦！",
      "source_fingerprint": "2836546b297081a4afc408a5fb8f72347e0e11f541cc856b1b49ca98ed7de355",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
