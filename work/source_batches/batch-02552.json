    },
    {
      "uid": "zhcn:352cd75f2e7ca010c3dc21a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……走吧。",
      "source_fingerprint": "14a5831f7940f315e35b7e2b4afa3404611b474084a0e47e055fee99480dba33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
