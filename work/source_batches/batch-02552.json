    {
      "uid": "zhcn:afc9e80b830467ca7388625b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈哈哈……你是那种很不擅长掩饰自己想法的家伙啊。",
      "source_fingerprint": "d5b4d603327ddfacb897056cac9bc0fc6b9b74581aadcaedfa0d496f2f45445c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
