    {
      "uid": "zhcn:8598675291a172e0ba6b66fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿嘿……跟我来吧。",
      "source_fingerprint": "fcafda3c7bb50ce9366651926cd570bffc106be9fa128b41bbfc66c598d6571d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
