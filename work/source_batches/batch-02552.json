    {
      "uid": "zhcn:13c9ca3dc9d1e4d6a4c90bb4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不止没吃到苦头，反而还得寸进尺了啊。\r\n也行吧。那——",
      "source_fingerprint": "08509e4171af941db00f9187a84f8ab8b3629881050d55908718aac695780484",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
