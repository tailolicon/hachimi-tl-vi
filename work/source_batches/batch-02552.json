      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（咕噜噜噜……）",
      "source_fingerprint": "09dfd3485c2a20511355097be8309b11ec45ff3921a8d6b94abe18a009aa45c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
