    {
      "uid": "zhcn:cbb267944cf0ff71c19b2e33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这下……可算得上是咱们的大获全胜了。",
      "source_fingerprint": "fd2d5480541d97e65cac1aafba57d7af1eafb005255e221bf5cc06fb31b8804b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049007.json",
