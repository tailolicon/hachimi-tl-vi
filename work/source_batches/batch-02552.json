      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈、哈、哈、哈……\r\n沙、沙滩……",
      "source_fingerprint": "5abf861e51188be57adc5cd1882c6cfac873a67483e7b3eb24b6fb6f1590e324",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
