    {
      "uid": "zhcn:951b7a22491623f8493308bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊哈哈哈……哈哈哈哈哈！！！对吧，我说得对吧……！！\r\n哈哈哈哈哈哈……！！",
      "source_fingerprint": "923f35efac2171221ecb51870a915c81139314179df16c95262e9b5e3e2e9db4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
