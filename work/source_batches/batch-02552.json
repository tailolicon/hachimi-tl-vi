    {
      "uid": "zhcn:b403eb9380b213c10a7bd012",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要我来让你再兴奋一点吗？\r\n来，看看你的面前吧——",
      "source_fingerprint": "13f4f7eb6c4562c17eb5aa30e26079c39165686429e3ec30e2bd5e7fe55ff3c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
