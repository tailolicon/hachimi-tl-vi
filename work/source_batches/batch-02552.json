    },
    {
      "uid": "zhcn:0e8de3175a88dbb1e173517a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……中山。咱们是要以沙滩为目标对吧？",
      "source_fingerprint": "5545bda6226339bd0b4245d08902a88efe8c101dcfdfe08ba190510a66e03e5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
