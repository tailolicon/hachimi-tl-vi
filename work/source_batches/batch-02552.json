        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:c7ca32ba43a9a621e8cbe703",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我看向镜中的自己时——\r\n我看见的是，仿佛已经了却此生所有愿望一般，幸福而兴奋的『笑容』。",
      "source_fingerprint": "598a1a6a45b4564ee233bd1030aec791b038b5d373158f076aaf881b125a002b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1049/storytimeline_041049007.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:8134f9bfda1118fbf932b804",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我……是在兴奋啊……",
      "source_fingerprint": "baa7fb7c8a9f653550ee119f49e1a4fa02ce864c44e1dc51e2c3d288cce0bb66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
