    {
      "uid": "zhcn:64920076c6f38d4a16bb9f03",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈…………哈…………操…………\r\n那狗日的熊……突然就追过来…………\r\n果然，这种赌局——",
      "source_fingerprint": "dde38dde8df97cbc1393f74cc1acf0cdcd8b218a413319a8c02c515bf70116f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
