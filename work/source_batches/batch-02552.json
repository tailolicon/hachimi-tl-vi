    },
    {
      "uid": "zhcn:87e894f30cffdf8ef42c47d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈哈……喂喂，你现在才注意到吗？\r\n迟钝过头了吧。",
      "source_fingerprint": "256522dbca5ca94710bfa70d380a832b2cad3c1429edbad273b8855a20a81605",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
