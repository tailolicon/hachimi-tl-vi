      "uid": "zhcn:4451d0c79759f946e6b9e771",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我……是在兴奋啊……",
      "source_fingerprint": "baa7fb7c8a9f653550ee119f49e1a4fa02ce864c44e1dc51e2c3d288cce0bb66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
