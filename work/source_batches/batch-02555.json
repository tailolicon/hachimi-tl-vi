    {
      "uid": "zhcn:45830bc80aece863c4a4f1d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就因为一些无聊的理由瞧不起我，\n弄得我也一点不想和这群人打好关系。",
      "source_fingerprint": "c3ab70760d32b7157c3b0e7cbd670c35cc193ed96194140f4a9df0cf0b11d0e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
