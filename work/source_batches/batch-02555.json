      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（只要能冷静下来迈开双腿的话——！）",
      "source_fingerprint": "03a2f719728efec0dd785d441bee64c0ec630a90357d5f1fb8f85ae370b6e70d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
