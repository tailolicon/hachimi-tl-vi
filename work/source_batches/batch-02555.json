    {
      "uid": "zhcn:7d1a7e57582783409955f1ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样每天都满腔怒火、每天都满心怨恨。\n但是，正因如此——",
      "source_fingerprint": "b3e2eddb4c17cf48c1dd56881eaba31c22d93ac16a72f119186f8c33ebcb051a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
