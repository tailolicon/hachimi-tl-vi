      "uid": "zhcn:3987133e162ccd3b5479cca8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没关系的！这只是现阶段。\n我接下来会好好努力，尽量追上大家的！",
      "source_fingerprint": "483651350c498f9a414e3e035b3106d38e22847b78dd24e4525972a414d1df31",
