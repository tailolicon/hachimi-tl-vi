      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:f2f4142e7c6ab01670e0b816",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说什么妨碍，怎么会……？",
