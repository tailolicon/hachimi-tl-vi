      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你怎么自己躲在角落？",
      "source_fingerprint": "c70ecf0afb04fa5bce79991d003ed867ce05bf7146aeef38480dcc59921f7dec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
