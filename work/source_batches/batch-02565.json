      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要在这里实现我的梦想……！",
      "source_fingerprint": "24bc8f425812757828bb8c934f8ae7fe2a94987b9d518d34d13c6e5a2a77f31d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
