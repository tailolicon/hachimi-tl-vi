    },
    {
      "uid": "zhcn:760d2b72e2e42a005e308709",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我再次感谢她上次的帮助，并把脑海中浮出的疑问试着问出口。\n我看她好像自己一个人在进行训练──",
      "source_fingerprint": "c7f5b13031ecd1addd8524676a5f5869a8bc26a7897b8170969b4b6551144256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051002.json",
      "json_path": [
