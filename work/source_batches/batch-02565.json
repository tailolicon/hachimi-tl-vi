      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然进步幅度不大，\n但我每天都比昨天更进步一点了喔，嘿嘿。",
      "source_fingerprint": "6d473784e83201ef8880ab146b742991356d1db4da702972a4d4548d2dafed30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051002.json",
