    },
    {
      "uid": "zhcn:2de26864376cd65162a60a3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她该不会是……",
      "source_fingerprint": "52b99863442488721ca2a62306cafbcf7b84ad545ee644c7632c76453b66b148",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
