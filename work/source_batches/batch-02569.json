    {
      "uid": "zhcn:b0350836592acc1a8a2b58ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西野花鞠了个躬后便离开了。\n收到便当我当然很开心，但她制作起来应该很费工吧──",
      "source_fingerprint": "b92305fcea34e6419136a70f754fd06e0b4909d1d73db9315c5e6be90a51f2fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
