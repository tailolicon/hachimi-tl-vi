    },
    {
      "uid": "zhcn:5b01acc4e3c86dfe0cd5a265",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "将便当吃光后，我便跑去了校门前。",
      "source_fingerprint": "a22f9d39e058886446244651407461b680c81f75555e21cbb97e31fce8ee3644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
