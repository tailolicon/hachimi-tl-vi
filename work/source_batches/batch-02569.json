      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（明天该做些什么菜呢？去问问妈妈，\n她一定会再教我新的便当菜食谱──）",
      "source_fingerprint": "0b7e743b04145e3b30ebf34985f973c5c7168509ded955cb864852977b2d8a00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
