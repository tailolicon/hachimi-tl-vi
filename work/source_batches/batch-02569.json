      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:0cdc8259301d225783406172",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前辈训练员A",
      "source_fingerprint": "6583ad5672e6e9dc9ccd08747721380a5360486c8357b043e2c953d8c730bf0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
      "json_path": [
