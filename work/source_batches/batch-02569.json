    },
    {
      "uid": "zhcn:19887f878e77069d0260d939",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在回应我昨天的那句感想“让人每天都想吃”吧？",
      "source_fingerprint": "de911e7e0509123ea5d96d50cffcf9945b9aac1aa74c86fd7e9cf6073ce68cee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
      "json_path": [
        "text_block_list",
        19,
