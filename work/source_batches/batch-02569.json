    {
      "uid": "zhcn:f68b3f853d3187c008610f7b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。其实，昨天妈妈教了我新食谱！\n所以我就想做给训练员吃吃看……！",
      "source_fingerprint": "b3fb3ce849bb826abe5232031d49c0b10d1587752af4bbe29e6abf498bc628b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
      "json_path": [
        "text_block_list",
