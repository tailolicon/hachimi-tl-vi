      "json_pointer": "/text_block_list/21/name"
    },
    {
      "uid": "zhcn:06f1a8a237d1b47dee1f1161",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“辛苦啦～！最近一样忙着努力吗？要不要一起吃个饭，\n顺便聊一下彼此近况？要的话到校门前集合吧！”",
      "source_fingerprint": "175b546dc25ea9bb949f2f0309576119b3dd790c1248a00b0b567e952f98dbfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:646ff4d27c4b1f77db9a5b73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是我回复说现在立刻过去……",
      "source_fingerprint": "4165933c623db5081c331ce53e3219d73bd58dbddeacd76bc867c351279f5b76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1051/storytimeline_041051005.json",
