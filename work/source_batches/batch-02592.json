    },
    {
      "uid": "zhcn:fd3326a85cbc94d636e92514",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦……训练员……？\n……哈哈，总觉得这好像梦境的后续……",
      "source_fingerprint": "5a807b0dae40efc8856a0317e0cfa0415706d8e2cded009665eeb0799b5dc65e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
