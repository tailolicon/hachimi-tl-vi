    },
    {
      "uid": "zhcn:87bd7f51bd986b8169d184ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论是打上了蜡，滑溜溜的走廊──",
      "source_fingerprint": "7c9915212cb23d0414ffa52fa94ac3ed501fa0a8b566e6afacd135ce536fc33a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1055/storytimeline_041055003.json",
      "json_path": [
