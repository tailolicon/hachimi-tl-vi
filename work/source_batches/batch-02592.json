    {
      "uid": "zhcn:2d89500581713225e5e48551",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美妙惊喜……听她这么一说，\n我似乎明白让我好奇的“美丽”是什么意思了。",
      "source_fingerprint": "84da96e4ed78eb0b3576081664dea62c8a45ff057e57048b0cfef0f02818a86f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1055/storytimeline_041055003.json",
      "json_path": [
