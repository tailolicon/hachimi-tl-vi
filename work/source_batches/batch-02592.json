        26,
        "name"
      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:c89e3ac6463c8a16871284ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我曾认为每天都是无聊的日子。也不曾尝试在生活寻找光芒，\n然后擅自认为世界不愿带给我光芒并为此失望。",
      "source_fingerprint": "56dfc963d3d8a2eecb3959f652ce768de026c9e4162bac4ebcec476cfa945eb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1055/storytimeline_041055003.json",
      "json_path": [
        "text_block_list",
