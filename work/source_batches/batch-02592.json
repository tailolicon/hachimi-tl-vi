      ],
      "json_pointer": "/text_block_list/29/name"
    },
    {
      "uid": "zhcn:4915e02b6c50ddb0540c94b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "相当快乐……是来到特雷森学园后，让我感到最充实的时光！\n我明白了美丽就是指美妙的惊喜──而她便是美妙的惊喜！",
      "source_fingerprint": "f53bd57383af651818f270d2e5abab2459673ded12f232a38b271ddc8db676e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
