    },
    {
      "uid": "zhcn:899d62b0536ac7739d8a89e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（所以我才会深深受到她的吸引啊……）",
      "source_fingerprint": "d0a719db9b8a2530d27d0b66c3c7d6381dfd8aac2e7be74c0b06bfef88af7072",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
