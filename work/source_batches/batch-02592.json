        27,
        "name"
      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:5b5af1643001a324445fe4bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但生活中的美妙惊喜无处不在。只要张大眼睛仔细寻找，\n这世界将会变得无比闪耀！",
      "source_fingerprint": "87e827a1dd0b70fce7e59680d7fd803f862d250c08b20a725cc651236b896ebe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1055/storytimeline_041055003.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:f89d7d00412a3e488f05726b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
