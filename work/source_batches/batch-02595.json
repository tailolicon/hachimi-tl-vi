    {
      "uid": "zhcn:6591019a886a8e8600a294c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想把世界上存在着美丽这点──\n传递到更远的地方，让更多人知道……所以！",
      "source_fingerprint": "51f94aa8d32cdd9a22c15feff6104ca612e8118abc8707ef7e754aa7e4921eca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
