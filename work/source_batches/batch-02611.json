    {
      "uid": "zhcn:6a3015779444039cead20038",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要双方可以顺利协调，\n就能轻易解决这个问题──",
      "source_fingerprint": "e36e29a423da3f0244ccfd39f8aad4ce141bfb97ca8fac13305ba0e585d23837",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
