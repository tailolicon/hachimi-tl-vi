      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（这样啊……）",
      "source_fingerprint": "0747234f2517899eb330308e59cdea06a1c97263f191342160d7b83c0fe240ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
