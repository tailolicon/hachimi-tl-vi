      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:ae7fa82be327b3308016b6e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但她就是因为办不到，所以才感到烦恼吧）",
      "source_fingerprint": "670131f8c1d72c087eae8abadf6b1f66e496390354a4342c87395fe424cc7a96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
