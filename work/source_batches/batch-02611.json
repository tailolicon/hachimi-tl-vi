        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:9c072f143cb47bcb17e443ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她无法以训练员所期望的“获得GⅠ胜利”或“三冠赛马娘”\n为目标，那么，要是由训练员去配合她的价值观──",
      "source_fingerprint": "4ab73d0c36dd54d4f4df98c9647ffa29ba7416878e2e6f552d4493f0611db369",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:36f71fd41d81e4eb30f73113",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
        "text_block_list",
        34,
        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:89e638bc5af852acb3903c2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果能够变得和她一样纯粹热爱比赛就行了吧。",
      "source_fingerprint": "f1926c55bfc9b8d7fa5f6362e6ad40c1e468e0d21345604428c74087159ce953",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
