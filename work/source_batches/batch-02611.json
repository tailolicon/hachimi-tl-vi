    {
      "uid": "zhcn:4eee7302015f9c8055c53e23",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但对我来说，那里不是那样的地方。\n那里是只为了跑步而存在的。",
      "source_fingerprint": "05d2ff2b33a8d98d93bd849fd0817734c391ad6481a059b4ad0f13ab40d6312b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
