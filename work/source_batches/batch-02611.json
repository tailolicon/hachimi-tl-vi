    },
    {
      "uid": "zhcn:6bdb6c03d713eaabfe25f9c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果无法接受就没有办法前进，不论如何她都无法对自己说谎。\n她明明给人自由奔放的感觉，个性却似乎相当笨拙。",
      "source_fingerprint": "4a9734197575c296537e273c191754bcfa8d71fc3724f98845783425716e771b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
