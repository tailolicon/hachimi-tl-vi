    {
      "uid": "zhcn:aa92d13797914fba930d145f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她是为了跑步而生。\n她最根本的价值观，与世人有很大的差异。",
      "source_fingerprint": "8f07f91f9dd5f759a62e9be93ba5507fc328c3fb6159435f9eb1976ce1c6653b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
        "text_block_list",
