    {
      "uid": "zhcn:7a4b6b71fed19250d898ab96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就在我回想起千明代表说的那些话，并开始思考时……\n我突然察觉一件事。",
      "source_fingerprint": "b730b95a9866b667b9c28fd503dd7b7f0006d5f0825210d1d55f9b9a2342a78a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
        "text_block_list",
