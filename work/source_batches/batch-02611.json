    {
      "uid": "zhcn:22e839ca29d4cdad79af4f71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……虽然我还是有点担心，但在这里待太久也不好。\n就在我匆匆准备回去时──",
      "source_fingerprint": "04b6e45bab7e98ae74873c6c5187f3a1037a31fee653695577dc6bc4baa43e66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1057/storytimeline_041057003.json",
      "json_path": [
        "text_block_list",
        3,
