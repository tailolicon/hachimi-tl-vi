      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？！",
      "source_fingerprint": "6e78ad4e295a8556cd58740ff999e622dd1a1a4ef5d397b15c3a365bf71d4514",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
