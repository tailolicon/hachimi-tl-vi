      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（根本没来啊……）",
      "source_fingerprint": "aa0b21c30fe29de8a045748511776422c91a57a6e79d5519a11afa8ef97ed3e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
