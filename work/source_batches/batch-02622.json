      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同学Ａ",
      "source_fingerprint": "1177bd7d43577d42ec44fb15bc2a95092790f0cf1b096f642e84d076a3a6bd8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
