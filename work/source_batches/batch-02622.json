      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天是跟名将怒涛训练的日子，\r\n然而……",
      "source_fingerprint": "9d56e3b68cb336c5414385b6d6da0a520fbcec33a6596142790162a66214a937",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
