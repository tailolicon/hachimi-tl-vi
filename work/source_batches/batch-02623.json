    {
      "uid": "zhcn:33bae3982f7536012dbc719f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一点也不好～！！",
      "source_fingerprint": "61b5df444db3ee200f4a12a10c7116587d83189b052322351ae960730b870c9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1058/storytimeline_041058005.json",
      "json_path": [
        "text_block_list",
        19,
