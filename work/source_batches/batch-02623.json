    },
    {
      "uid": "zhcn:8cf8669690196f66a5f335c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "名将怒涛",
      "source_fingerprint": "567703d9275812a37613cd54f05008f5fba9ac6c5086fcadc58481ab61c51fce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1058/storytimeline_041058005.json",
      "json_path": [
