      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，目白多伯与气槽的并跑训练开始了！",
      "source_fingerprint": "dfbb862025be4f36b021befbb51f7f129c334120bc5859a3f9f6e63790e9a3c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
