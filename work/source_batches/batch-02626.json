      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:9ddeecf002f6c277a7520a3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这次并跑训练的对手，是享有“女帝”之美誉的气槽。\r\n是一位母女都曾称霸GⅠ『橡树大赛』的强者。",
      "source_fingerprint": "954c0888a55a4e4f140583fd8e0f83236b62dc3fce05092e65af315e454c8775",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
