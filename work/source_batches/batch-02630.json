      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没事的哦……没事的。\r\n你的话……",
      "source_fingerprint": "4c53c9acb1741a1639300b78b62a914681f89f34711b2d48c6f8f6b61356d520",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
