    {
      "uid": "zhcn:5307fee853971a2ed36bdb35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白多伯说着，\r\n将她在手机上在线预约的电影票展示给我看了看。",
      "source_fingerprint": "6fb0d5c23645fe3a326053c561557b4c55211f6455e4008c1cd54ae3895447f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
