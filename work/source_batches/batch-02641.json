      "source_path": "assets/story/data/04/1060/storytimeline_041060003.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:e42ed8ed40aff910448c02cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不好……！\n总之先去训练室看看吧！",
      "source_fingerprint": "3803c5d88691836846964f0311fd1cc0dd29644aea16a8b0e5d1a466193117e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
