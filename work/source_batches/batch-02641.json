    {
      "uid": "zhcn:fe4fd73861563de122458c85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明明已经过了门限时间一小时了，可是内恰还没\n回房间呢。关于她去了哪里，你有什么线索吗？",
      "source_fingerprint": "d6adbefc6cbcf9106368965fb36f8b1b86c41ccd55a25a5bb462c9ca2b6df4e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
