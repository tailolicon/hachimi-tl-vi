      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，在夜晚的学园里一路狂奔，\n来到训练室前——",
      "source_fingerprint": "d0ea9059e7741df3e0b416c594c67a0988220215f80720d3a31a353745d40405",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1060/storytimeline_041060003.json",
