    },
    {
      "uid": "zhcn:a8d8533e8732796e24cd3d03",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一定能赢，来证明我的才能。我会得到\n配得上我的结果，然后让她承认我才是一流的……！",
      "source_fingerprint": "501050c13dda0def79991e605846425a0a98cbf11f35a73ddcf4bc2d4f5990a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:7f9f2d353fce64776d7bacf9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
