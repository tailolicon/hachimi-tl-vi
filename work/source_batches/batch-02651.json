        42,
        "name"
      ],
      "json_pointer": "/text_block_list/42/name"
    },
    {
      "uid": "zhcn:3c183c13836ae08e42808a3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。无论怎样被非议和嘲笑，\n我，都会继续自称“一流的圣王光环”。",
      "source_fingerprint": "705feead6f0fcc032142d6df79758085af23d1aa463eda86bba9bd08847e07d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:cd3aa2c20d20385e80e57685",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        43,
        "name"
      ],
      "json_pointer": "/text_block_list/43/name"
    },
    {
      "uid": "zhcn:3acaf6828c13c9f24192523f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王是绝不后退、也决不低头的。\n我是抱着这样的觉悟来到这里的。",
      "source_fingerprint": "6613a81e2877fb95ba8e03cba8d783bd8817c2df5bb1d5ec3bf1eaacece7a38f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:fbefada17105334712259030",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        44,
        "name"
      ],
      "json_pointer": "/text_block_list/44/name"
    },
    {
      "uid": "zhcn:2f4602469ee73fe4913d8197",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不管被别人怎么说、怎么想，我都会一直自称是\n一流的马娘……也一定会用“胜利”来证明它的。",
      "source_fingerprint": "fdeac8bf618a987f9a35569931fbf3522f5faf3a733f8b816fcad44d0a3748c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:1552fc4a62c80ee8b15c8358",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的声音里，饱含着坚强的意志。",
      "source_fingerprint": "16940e45956d6298b41face9655e0b9d7c78ba1db65adee4659a5cc45e4ded7b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:ba57e306c09eb7b8b1910fe2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环用坦荡到了滑稽的态度自称一流，不断树立着\n远大目标……然而，这正是她那觉悟的体现。",
      "source_fingerprint": "e1c22b0cc3f080ee046ef04aaa4df8edf954c2213dadb3b7c08ce8091d6823e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:493102ace6c16c45d7b90465",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        47,
        "name"
      ],
      "json_pointer": "/text_block_list/47/name"
    },
    {
      "uid": "zhcn:731687d0435892a33cb464ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――所以，在训练员的选择上，我不会妥协。",
      "source_fingerprint": "0e2af7e47d47d0a8376d7656b93ad14067ae88318e7000a66c26d11a4608f48f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:f395525fb2b9fabd384e9a21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        48,
        "name"
      ],
      "json_pointer": "/text_block_list/48/name"
    },
    {
      "uid": "zhcn:9c24ea9306c3d4ee35cb341e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果不是和我拥有同样觉悟的一流训练员，\n我绝不会认同。",
      "source_fingerprint": "c08bd81676109a5569399aa51c027c17cf2451a1c44cce19977597b467eeda95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:8bac3912bec83fd9b81e0dc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        49,
        "name"
      ],
      "json_pointer": "/text_block_list/49/name"
    },
    {
      "uid": "zhcn:37a9a29a6e18534910b5eab8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……说得有点太多了呢。\n我得回去训练了。",
      "source_fingerprint": "1d291eb599793cc2462ecaa8c61e615995ff272358af101fc4ff82e72fc4c014",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:4cac5c8a8213dc8976f4dcc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        5,
        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:77ddc18851fc580ae6e707fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎……不行。完全不行啊，你们这些人。\n不要再浪费圣王的时间了！",
      "source_fingerprint": "fa482d94a27822da1b228f530bd85db368e1768acd605748b0283d1a235279d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:69b5e969bedf2cce57246f86",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        50,
        "name"
      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:b2b3af7b2fbb1c9c3aa13267",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，我失陪了。",
      "source_fingerprint": "bf3f6aa697081cec5f019864c4f340eaceea3cb1cfea11a80216a2eaacde9a93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:692fb8f268af612196d4d0cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环迈着毫不动摇的步伐离开了。我一边注视着\n她的背影，一边久久思索着她所说的『觉悟』……",
      "source_fingerprint": "55911375a554df73a05e61fe052d5e30f4f2835479c42a23faf57dc82ee374a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:ce8e44246f28608c10eede1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――那一天，从傍晚到第二天早上，大雨下个不停。",
      "source_fingerprint": "0eac6469491f464568e7ae81f4169a6542b074817d77f7c67d1ec9ca5eac999c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:945c7930498ec30145ef10ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要想成功和圣王光环签约，似乎很困难。",
      "source_fingerprint": "a753c1863cb17b2ec141ffb07643ef7f98003c52d583e3d5b637172bd5546556",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:c274b74a042e44a9ebb5b4c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我一边烦恼着如何是好，一边用着餐的时候――",
      "source_fingerprint": "f142c3947bf35461d4a1c931308c7f9cccdb2414728b3c1b09efe6c14cb6da77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:b36da2303105bfa576b4f96b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中坚训练员A",
      "source_fingerprint": "d6f17149be1baf99904bf56cae9f938b72e86aa07f3a8a4643fbb0676d06e1a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        8,
        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:86bea9670f92ecc2e4e0d3f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么了，又是那个任性的千金的事？的确多少能感受到她\n继承自母亲的能力，但是那个坏脾气的话以后会很难办的。",
      "source_fingerprint": "66af7f3aaf21f118287a1d7d57531a382180db22a304c12bda9f3eaf33200d26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:6b22ec62f0c745a92157bc77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，她在大舞台上也一定能大显身手",
      "source_fingerprint": "9b4a2bc503a3fa3d07e984b0d3c5740de49553d8cd4ce3a55ad15ed2e7414387",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        9,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/9/choice_data_list/0"
    },
    {
      "uid": "zhcn:05a9bebca4117ae1395dc3a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中坚训练员B",
      "source_fingerprint": "55ebd8578a0a4758842c8ea0ecc2edb094216d38bd2d2b7dbd0f146877baa865",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1061/storytimeline_041061003.json",
      "json_path": [
        "text_block_list",
        9,
        "name"
      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:5cca4aaf95eb3c5cddd3b537",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "脾气那么臭，实力却不太强。虽然现在能拿个第二名，\r\n但要是在经典级遇上那些真正的强者，恐怕完全无法匹敌吧。",
