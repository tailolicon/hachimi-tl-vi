      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对弈的结果──是里见光钻获得压倒性胜利。\n这让我看见她有别于文静千金的另外一面。",
      "source_fingerprint": "b3d1fb3ea6f9af69cbb8bedecc8685975912b99d05b3f39fb4f0abb9e9f81ffa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067002.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
