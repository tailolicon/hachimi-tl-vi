      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也是因为他们“格外慎重”的关系。\n里见，我说得没错吧？",
      "source_fingerprint": "7b8b7ffacd96e4bedb36cd8e5e79ccd0f29d603350d834d3515e6e2a00ad3ff5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
