      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "魔咒──看来她似乎遇到类似迷信的事物时就会想将之破除。\n正当我在琢磨她的个性时──",
      "source_fingerprint": "e0f5ebf16d29bba0c320e7b84fb8b7a3338d94a5cfa582e1372fd7ac0e7f101b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067002.json",
      "json_path": [
        "text_block_list",
