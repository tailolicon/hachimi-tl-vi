    {
      "uid": "zhcn:61254070589519879932257c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是的。一切都是为了完成家族的宿愿。\n所以我才想用各种方式，找到能和我一起背负这个梦想的人。",
      "source_fingerprint": "ce24a03f47ebddcee155173e0f63c9f017af03bb8822ed85f9360f329a5f82ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067002.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:98125d6d083e9aab04929959",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067002.json",
      "json_path": [
