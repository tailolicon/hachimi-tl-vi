    {
      "uid": "zhcn:da7b197a73724abb1d61a9e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新人训练员A",
      "source_fingerprint": "e829f9d4dc056512054ee3af7d16ee643fea041192ab34f55f5b5f4bdc406a95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
