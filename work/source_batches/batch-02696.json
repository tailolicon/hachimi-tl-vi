      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是，会吧……",
      "source_fingerprint": "b12a57494f9ad7f71f908311b556e9ca4dc43ae48da097c9f56daf0b53f6ad54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
