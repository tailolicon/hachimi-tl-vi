      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请问我不符合你期望的部分是什么呢？\n……是不是觉得我资质不够好呢？",
      "source_fingerprint": "5deeda43baa31fbd3ccde4a3e831cdc33e3dc583513acd2899e85dd69acd24f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
