      ],
      "json_pointer": "/text_block_list/57/text"
    },
    {
      "uid": "zhcn:1bc600572f0062ee68be83f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有别于文静千金的印象，她的态度相当坚定。\n在我点头答应之前，里见光钻迟迟不肯松开我的手。",
      "source_fingerprint": "c46be9005f447c359ba72005c40bda69878a0932a5fc9cd59f4eb3f1854d69c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
