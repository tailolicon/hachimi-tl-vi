      "json_pointer": "/text_block_list/45/choice_data_list/1"
    },
    {
      "uid": "zhcn:224ed0a781ad2a4dca9d5c4d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
