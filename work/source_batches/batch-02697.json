      "source_language": "zh-CN",
      "source_text": "决定了，我已经决定好了。\n你会接下这份工作吧？对吧？会吧？",
      "source_fingerprint": "29d927fcbf5ad560530b2f6f68d2b20d71dce95bedc75832292f14eb6d562118",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
