      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的训练员就是他！只有他能胜任。\n虽然照理说这件事应该需要慎重商量，但──",
      "source_fingerprint": "e5cd610c31f67f9983eab7f65d14166cba55f172d4d8fa03c4c9ba81eabb88ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067002.json",
      "json_path": [
