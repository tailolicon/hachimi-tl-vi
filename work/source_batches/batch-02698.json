        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:a9731a0c851d0babdfab9aa9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以、所以拜托你了，训练员。\n请你好好锻炼光钻吧。让我们能够得到麦昆的认可！",
      "source_fingerprint": "02065a877c6bcedd192ee9db947fb67b5e154c9dde5f3d0018de06f5c54e5cd8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:1933064c1502dd0bf36b4797",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
        35,
        "name"
      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:3ece516740c920a9ab720c7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不要再继续了，小钻！再这样子会受伤的！\n训练员也一起阻止她啊！",
      "source_fingerprint": "39ca514b2c8ac8e6b2b61d27dba29b106a4f96a857420fa0e2a624187e7619f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:e4cae285698e40f035a7521e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她俩的认真态度与悲叹在现场交错……这是命运的分岔路口。\n我必须要有所选择、有所舍弃──决定出一个方向来才行。",
      "source_fingerprint": "3b2ca7cfa4db06bca73b8814b5c8ae1e57282c66af3093084b5f2c6d02c6c62b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
