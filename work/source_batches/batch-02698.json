      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:e21f7d667bec740f012e13df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我……我一定要……和训练员一起走这条路。\n走上挑战闪耀系列赛的路。",
      "source_fingerprint": "fce631f15fc769cb99660eb0847759dda1719a898578900bd29a03ee84f656b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
