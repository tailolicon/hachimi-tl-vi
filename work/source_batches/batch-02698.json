      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9787e5cdfb5d47fcf43c1991",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身为她的搭档，我不能骗她。\n只能冷静地告诉她实情。",
      "source_fingerprint": "3e60110b42cb228e2263e370d3933326e486ef75ee1a53718ae25c41f1f72489",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
