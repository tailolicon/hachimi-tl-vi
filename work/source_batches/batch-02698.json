    },
    {
      "uid": "zhcn:a2b85858892412ffa055bc55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，必须要让你……\n不，是让你们两个接受测验。",
      "source_fingerprint": "b2f6744c697b6c6cf5f366e6b97b51f35593b41f9c9d0381e23069bf00ab41be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
