        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:263650d5e3d17cd42e8935fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果不能跟你一起跨越这道难关，梦想一定就无法实现了……\n我的梦想、里见家的梦想，甚至是我出生的意义也就……",
      "source_fingerprint": "65875a9195a9429b9bc488c38d2636c8ededdba2d876c33d65dabc9429ebcd80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:67df1792f0cfcbe65048c241",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
