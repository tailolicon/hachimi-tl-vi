      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:82e82c25ede9b5a59d526a28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在做出左右命运的决断的几天后。\n──考验一切的日子终于到来了。",
      "source_fingerprint": "e7baac06dc58cd401c8e077b97e1ff0d485ae1a940260cd61a87c3dfccf4c2ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1067/storytimeline_041067003.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:344a02a534659ea59dc452c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆",
      "source_fingerprint": "9001c462cda02e04688042965b70cf8db0bfc021e262b0efa9c3c3adc791b7da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
