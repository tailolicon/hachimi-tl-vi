      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:12134e1b49f62972323e5e85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "别急！还是有我们该做的事情要做！",
      "source_fingerprint": "db2e1e7f671ed92adef187bdff7a78ba90dfb8ac80d16e4415b361488178b9f5",
