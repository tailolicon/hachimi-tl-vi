      ],
      "json_pointer": "/text_block_list/45/name"
    },
    {
      "uid": "zhcn:b066e8bc246bc06e2663fa13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼，还真是为难呢……\n是等到温暖的季节再说呢，还是……",
      "source_fingerprint": "37760f044254759400b9eb34f068436d86e74bb538a3b46a79fa90d2bf9b0bfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
