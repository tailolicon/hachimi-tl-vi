    },
    {
      "uid": "zhcn:467b0f5b3699effc46631519",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爸爸？",
      "source_fingerprint": "04ff1dbc77bb25ab4585b03c18bbb1dad8e7ffdd47bb349744d3ca7865e5af38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
