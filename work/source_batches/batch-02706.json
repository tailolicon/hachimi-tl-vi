    },
    {
      "uid": "zhcn:8d411039ef3646c140e00e6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        46,
        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:3a4885d8dc6c6264afc9fce4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "麦昆，在困扰什么呢？　啊，听说你\n前几天和小北比赛了？　是那件事？",
