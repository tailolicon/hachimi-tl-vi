    {
      "uid": "zhcn:1c3745231add483f5fd3a8e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总有一天想成为那样的存在――\n我明明一直想成为像爸爸那样的人……",
      "source_fingerprint": "bce08354239dc32e28aada20f5028cb7c335ff22c3036f13f9c39b1bfa7126fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
