    },
    {
      "uid": "zhcn:db84a2795a9263298cabaea9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是，我的爸爸，是一名演歌歌手。\n粉丝和弟子们都很仰慕他……",
      "source_fingerprint": "d3d3f18de47c72cebdbfb78a7926f6e029edcb8483e63688f1fc7d96d8b83ff9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
