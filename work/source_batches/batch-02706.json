        "name"
      ],
      "json_pointer": "/text_block_list/39/name"
    },
    {
      "uid": "zhcn:2a4716268c2333040cd31bf8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但现在连自己的优点都找不出的我，是不可能成为\n那样的人的。我能做的只有帮助有困难的人……",
      "source_fingerprint": "82df28b63090f3b90dd108587b3dca7105c31d960fcbf2bd751c1b2e09d98232",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:b9ad52a96634e46b0a2b7db1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:a7f0e9704a915e19b51f97f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总之，我还没有接受邀请的资格。\n毕竟现在的我就跟见习中一样……",
      "source_fingerprint": "f5e5044ecc64427e3b7fc418d52728f94acc9c1e34efc96b77e2bda8b5d82922",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:6ac822a61f7f52f6ab5b217a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        40,
        "name"
      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:087d9407a93c543a1b8f4b79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是。这种事谁都做得到吧？\n单纯只是我有些多管闲事而已。",
      "source_fingerprint": "30bd3e0851f9b9e2f75afb14850ad6aceb5db0ad1f4afcf5ea3c2532b83c1e57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:9f853200d99b0847abb11b02",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹很是失落。\n在这回比赛中，确实能看到明显的力量不足——",
      "source_fingerprint": "d839e57de5e4c5f01864095222c505ff430b020eac913e11be86fd3a95e77232",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:7f03042f78dc633724b3e5ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1068/storytimeline_041068002.json",
      "json_path": [
