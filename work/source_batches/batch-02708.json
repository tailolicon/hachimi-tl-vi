      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们团结一心。将我们想得到的训练内容都以最高强度\n去做，不分昼夜地投入全部的体力与精力――",
      "source_fingerprint": "e14bc9bd8f3e43accb4f82b404ffed86a9213a04dc7711b748ac0daf21db9b25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
