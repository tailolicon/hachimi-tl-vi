    },
    {
      "uid": "zhcn:5cfcc9dc1dd26dd9ee1ff5af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，我知道了。干吧！",
      "source_fingerprint": "d6b7e754df5bdbea6d6fcd6259748dd59cf3f0610a73dc3afdff0e9834ae1f3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
