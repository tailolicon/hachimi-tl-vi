      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:e4b734bcac226a5b15164022",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，拜托了……！！　今后也要一直，一直一直\n一直！！　请当我正式的训练员，今后无论何时都！！",
      "source_fingerprint": "22e7dd2d4766dc50c751d474682e62425fc58921288e33e567b8bdc54fd0a799",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
