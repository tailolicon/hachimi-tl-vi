    },
    {
      "uid": "zhcn:3920ab0e505b7beac9ca6e67",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，继续训练吧！",
      "source_fingerprint": "fc11cbfd21e56cda9682ecaa1093e2bf7e44f6dba8697e4c5c128f7c1b17ab25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
