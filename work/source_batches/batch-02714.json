    {
      "uid": "zhcn:765d0419ee99ed3f58a80552",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从入学以来就一直很喜欢您！\r\n我对您奔跑的模样已经一见钟情了！",
      "source_fingerprint": "59fae8b767c30317d313986a525c18817c2ef14156ef00d0f486264d7043a9f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
