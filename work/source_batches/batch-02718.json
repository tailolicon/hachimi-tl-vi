    {
      "uid": "zhcn:42ef75a10305f1509da797c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个……那个那个！\r\n能请您成为我的训练员吗？",
      "source_fingerprint": "0d34994805460870d6aee6bcbd34365d24155f8c14d567b97d57de9b80daabde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1069/storytimeline_041069004.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
