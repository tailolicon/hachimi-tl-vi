      "uid": "zhcn:496bf84b23f47de82ddafad9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呵呵！当然可以啦！",
      "source_fingerprint": "7de76b811fc6bb39a3dade822a89f4b973611079059bfdd660639d3f3c6815c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
