    },
    {
      "uid": "zhcn:5bed91b2e29a292505acf8e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛结束，我在返回训练员室的路上时——",
      "source_fingerprint": "992ff7e53c3d82de2cb21ed432d226e50bf119c241732e1bb4d34289dc738192",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1069/storytimeline_041069004.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:4ce4a4b57bfb35555a22cb9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶？",
      "source_fingerprint": "23c77ae11b382a58b7dd122bfd8c62421f5b91ca57d2b03a2544490330e909e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
