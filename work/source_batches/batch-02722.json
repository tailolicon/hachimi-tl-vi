      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:5e09744309e8207464a26ead",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你跑得真是太出色了……！！如果是你的话\n一定能挑战称霸经典三冠！！我发誓会将所有经验都教给你！",
      "source_fingerprint": "a2b43bfadf860f6b288b3ae3c3f3886cc20338f333cf4504d8d6e550b6d7fd9a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
