      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:a132b310b27eefd35009e4e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不，既然都输了，那就没办法了",
