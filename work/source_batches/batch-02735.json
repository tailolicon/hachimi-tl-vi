    },
    {
      "uid": "zhcn:b088e12cce545257e5a3a910",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹抬起脸来。\n那双蕴含着坚定决心的双眼，正紧紧地盯着我。",
      "source_fingerprint": "83b0da61a7d730dbf9a68583651d7c68744be95c4466913bcb50136c73dc6990",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
