    {
      "uid": "zhcn:1083b2d2bb1a8e38e0d8dbaf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我们离开美术馆、在餐厅中休息时，\n目白阿尔丹轻轻地开口了。",
      "source_fingerprint": "7943bf0f670b916f3632314612b72d56f6b67d1245d78b2a6af44c93cad578d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
