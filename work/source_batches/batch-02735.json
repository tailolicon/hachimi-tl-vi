    {
      "uid": "zhcn:d6a54447d94a4e7c338c3abd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是，就这样――",
      "source_fingerprint": "5484de256db9f268545235d8a8ad3f177d2a647b5cb1483efecc4a48ccff8264",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
