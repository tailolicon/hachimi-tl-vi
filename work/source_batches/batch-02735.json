    },
    {
      "uid": "zhcn:38e81f91743b969c4007e0a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
