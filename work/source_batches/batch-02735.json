        "name"
      ],
      "json_pointer": "/text_block_list/30/name"
    },
    {
      "uid": "zhcn:88efc21c45854e4c4e5823bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的姐姐虽然拥有与我一样的体质，但依旧奇迹般地康复了。\n也正是因为如此，我也对自己抱有一线希望——",
      "source_fingerprint": "4f7658839b651001276f9189b11f6fa2358af93e73656067be8b314e26002b77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:99ce8fb059f4ef446ede643c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        31,
        "name"
      ],
      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:bcc9b066eb7910a2bc839274",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……但看来，是我将事情想得太过理想化了。\n这也是所谓的世事无常吧。",
      "source_fingerprint": "9688ca649661db8cf3143dfae3291c4bf22f27126bf8aaf99718d1e67a554815",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:a4e57e697b7cf2a2ee96660e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:84efb500cc63ebc1b81ef57d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主治医生也对我下达了『一言蔽之，就是无法承受比赛强度的身体』\n『一旦受伤，就可能会不断反复发作』的诊断。",
      "source_fingerprint": "4b00b683c4602e39228c59d58c5e352bdc541e969c508a057b5119b5322368e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:b00789b8f66bb2f1172be51d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:fb6aea72d7dda4a8c2150700",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我的双亲，直至今日也依旧反对我参加竞技比赛。\n她们实在是太过于担心会在比赛中失去我，\n前几天打电话的时候还哭了起来呢。",
      "source_fingerprint": "aae0c792a1fb0911c3434dce6d92d5aa8872be4693760a455a1844fcc57f5f25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:6d2e4cd19fd7ca66336b317e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071004.json",
      "json_path": [
