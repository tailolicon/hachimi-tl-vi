    },
    {
      "uid": "zhcn:4ebf394b98e5efcf278e21c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是……尽管如此——就算如此，训练员。",
      "source_fingerprint": "8f77c73873e54820a71898976cd4e6b22ed069f0fc92811b9af008ea1a007101",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
