        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a8cd093e458cb2d21e7fa8cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，我就出门了。\n等我回家的时候我再联系您。",
      "source_fingerprint": "cff0cdcb5b3eb7626eadbc11cd6e7bd3d71713763cb7ccf4f0a1d01f90f74c8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071006.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:4fa49c7a576d585890778bdc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在的话，说不定能看见那座城堡哦？",
      "source_fingerprint": "c1a8725e83fc0dc7a0171662decbf4a2c361ebcd71c23a1f2271e3690ae2f5bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071006.json",
      "json_path": [
        "text_block_list",
        20,
        "choice_data_list",
