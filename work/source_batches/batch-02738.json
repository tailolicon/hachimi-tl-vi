    {
      "uid": "zhcn:c5cf7aae9059a3510c5d6495",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实，在小的时候，\n我会把自己想象成白天所观看的剧目的角色哦。",
      "source_fingerprint": "88b3a039b49a06b525a6e06e73346b7f97b514b67f59db56c966a6a4288d6960",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071006.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:b5adbc334b8b0cc391f35dde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1071/storytimeline_041071006.json",
      "json_path": [
