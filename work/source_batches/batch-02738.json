    },
    {
      "uid": "zhcn:0efacd5e982564d91fc9df89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵呵……若是真的能见到的话就太棒了呢。",
      "source_fingerprint": "46015e0bb22e94a1a5c4e9c7b8ca00680c1527a11bc070e0b9ac57583fa64754",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
