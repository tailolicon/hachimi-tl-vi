    {
      "uid": "zhcn:3f75afe49ce670d6058014fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………啊，真是令人舒畅的风啊。",
      "source_fingerprint": "c08a75393826177a10b1071fc987a4d52842e5012e5ea4e18eafcf2c8e46d77c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
