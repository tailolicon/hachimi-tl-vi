        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:8b717622288e0685404ddd1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你特别想见见那位幽灵吗？",
