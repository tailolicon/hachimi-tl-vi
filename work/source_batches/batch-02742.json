    },
    {
      "uid": "zhcn:e7117802fdf6f4827cf38fec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是“竞赛”吧……！",
      "source_fingerprint": "d63aa704f144d6febf56a40433a5fc15ffb8a0346778a1755f9039c1f949026f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1072/storytimeline_041072002.json",
      "json_path": [
        "text_block_list",
        25,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/25/choice_data_list/0"
    },
    {
      "uid": "zhcn:9b92a520d947cf60294d5bcb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是“竞赛”……！",
      "source_fingerprint": "7571abf2c3830b8d4306eff8ac72ae9623c517a22678c62ac12a31f52b77efbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
