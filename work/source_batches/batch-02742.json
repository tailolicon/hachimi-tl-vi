      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "开始参加竞赛后，我宛如找到自己该走的道路般欢喜。",
      "source_fingerprint": "53829d8e69b7d00c0c27f1136806876ae893747138eaf5af835f6455ed7818f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
