      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:f01e9977280beef066c456d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我也想请问你。\n你知道祖父这个问题的答案是什么吗？",
      "source_fingerprint": "b30b6e871610ebc0ff18770671d811ea679f031bdc17abcaabe905473da9dbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1072/storytimeline_041072002.json",
      "json_path": [
