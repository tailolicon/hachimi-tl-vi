      "source_language": "zh-CN",
      "source_text": "……！你是──",
      "source_fingerprint": "68e37865bdae253e88c6f6fa195c784e4220297a0fc8cecb26c54777e498c535",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
