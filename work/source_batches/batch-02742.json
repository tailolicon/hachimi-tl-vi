      "json_pointer": "/text_block_list/22/name"
    },
    {
      "uid": "zhcn:816004c7e62e8fa8021927dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我害怕它有一天会再次肆虐，伤害其他人，\n某天，祖父问我一个问题。",
      "source_fingerprint": "5ae1280c4cc7da5e2f11207f27bf45d925379cdc90f49d6fa3d17243fb3b0598",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1072/storytimeline_041072002.json",
      "json_path": [
