    {
      "uid": "zhcn:9606e5b8458ea702e730942c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我领悟了“止水”，\n但我心里的“烈火”实在过于猛烈……",
      "source_fingerprint": "60fa6bc35dd70992dbe60c69e403d68e7039504c25b756ee5fe39005684af53b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
