      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌的祖父",
      "source_fingerprint": "6c1f6b712abb8bf64e62b93d0394e6ae9912813260854a1d00503319f5536375",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
