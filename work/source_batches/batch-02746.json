      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:743a70ddba1586ad835cfe00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我这天就这样和她道别……\n不过八重无敌真的有办法“中断修行”吗？",
      "source_fingerprint": "20d31ab690bf8f1f390bb03f85eb8ec337cf987d11ffe4c0903e874d086854d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1072/storytimeline_041072005.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:35a4fc67f8dbd9469b3ef740",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隔天，\n也就是八重无敌的第二天休假。",
      "source_fingerprint": "9f185ccc59d6ee910f79af5a223945fcd773b2b3570404d7797aee11dc4e3552",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
