    {
      "uid": "zhcn:a4707cd95e1cd19386e94136",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白家的活动在热烈非凡的气氛中落幕了。\n我跟目白光明两人一起沉浸在余韵之中踏上归途──",
      "source_fingerprint": "bc993812210f4704bf3b082bfdd092a1d87dbf7376f6b527ce096f8b38f7a634",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1074/storytimeline_041074004.json",
