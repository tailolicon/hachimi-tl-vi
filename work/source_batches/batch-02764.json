        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:15a95d016eae8e12dbcbeaf2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "专心集中在自己的步伐跟取位上吧",
      "source_fingerprint": "4d49e6b207bb5f2b2816422f91c706001f398592aa7b8b3c2c3662de4e43281a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
