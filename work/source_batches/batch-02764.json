    {
      "uid": "zhcn:0cd75c2147c4802fe5a03bb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "各位，请看……！我将向各位展现目白家的威望──\n我就是新的光芒！",
      "source_fingerprint": "7c293d92dcff9deda8b4074937bb6694fcba92da6be40bf924be39b4bf9b084e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1074/storytimeline_041074004.json",
      "json_path": [
