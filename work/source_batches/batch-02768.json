      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:978cc6bacc5461aba39cc720",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而目白光明虽然一如往常地悠哉，\n但她似乎也很享受集训，训练状况绝佳。",
      "source_fingerprint": "d8e779dddc84cae0e03e092e3329e23fbce56b4501538b21cd7a5d58dcc3f020",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1074/storytimeline_041074007.json",
      "json_path": [
