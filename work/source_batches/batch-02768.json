    {
      "uid": "zhcn:f37775eb37a17ba4bd77089d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而水母在海洋中浮浮沉沉的。\n我在海边呆呆地一直望着水母漂浮喔～",
      "source_fingerprint": "884a84b5a5b90cbf9890d8a42c58a38089585a17208e3a5a602bb89cdd199292",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1074/storytimeline_041074007.json",
      "json_path": [
