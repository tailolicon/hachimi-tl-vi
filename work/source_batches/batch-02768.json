      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……已经这么晚啦。该回去了！",
      "source_fingerprint": "c6d7cf482de1923094ce7386a435563eea7691a931eba05efebf2ac599e8936d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
