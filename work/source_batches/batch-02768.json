    },
    {
      "uid": "zhcn:42cc217afe61850de20b48b3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了能一起去祭典玩，我得先处理完其他工作！\n首先得重新调整好练习项目！",
      "source_fingerprint": "c180fc22bd22cd0ca09a2d28fec8febf003e03f2faf8483525c3dd094c4e8b78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1074/storytimeline_041074007.json",
