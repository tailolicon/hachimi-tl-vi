    {
      "uid": "zhcn:139b35c0e216cc36d5561e76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我陆续处理好各种工作，\n当我勘查完明天练习用的林中小道时，太阳已经开始西下了。",
      "source_fingerprint": "f000389936f9585b748c36dc9f6860905e1695300ea10e2b7cb791a7d53d1aa3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1074/storytimeline_041074007.json",
