    {
      "uid": "zhcn:16f44860d329387f3b4e6923",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多亏你，我找回我们的步调了。",
      "source_fingerprint": "74b51e26550f310b4652d99a68eb5acf9113c97b0560b6aaa7060ca18f0f17c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
