      "source_language": "zh-CN",
      "source_text": "呵，你来了啊，亚马。\n希望你能多少满足──我内心的饥渴。",
      "source_fingerprint": "1603d5bc386e5c3d4eca2aa68c0bff007b4703825a300927fc56fd0456d0d199",
