    {
      "uid": "zhcn:82758fe3af97501b4e1026dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──或许这是她的一丝希望。\n雨天草地湿滑，不利于踩稳脚步……",
      "source_fingerprint": "8f64eff557dba25f1046576ee4a1572759c92ae62d638d682625c7e856945d43",
