    },
    {
      "uid": "zhcn:48cae351e1590e9f316b72af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠",
      "source_fingerprint": "8c31c0fde3346564421d9d2eae5169ea9db0122a511fb223e176c94a126e486d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
