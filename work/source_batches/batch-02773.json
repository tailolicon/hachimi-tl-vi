    },
    {
      "uid": "zhcn:34d9d0026697b9ac50dbc403",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想赢得那场比赛。不，光赢还不够，\n我还要用最棒的方式获胜。",
      "source_fingerprint": "05e4e8d968429e6dd1dabc3fcf8e73e0d693891603951e05c0a84e90b45811d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1076/storytimeline_041076004.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:5cfe4b0847719719611c266e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那场比赛……叫做？",
      "source_fingerprint": "d949a1bd7deec3994a363d0d95ff3dc75b7978c4f8bb21a0215ad784cde56b20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
