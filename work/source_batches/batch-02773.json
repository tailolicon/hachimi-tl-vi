    {
      "uid": "zhcn:bad9c4a9f511f930b5ec9117",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我──生为赛马娘。\n而赛马娘们自有属于赛马娘的顶尖。也就是最高峰的比赛。",
      "source_fingerprint": "4411a84204637b74a72c95b239307fc5ec970daf084ee7260fd6e786314a9ad7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1076/storytimeline_041076004.json",
      "json_path": [
