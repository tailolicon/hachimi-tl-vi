    {
      "uid": "zhcn:3860e162f14041cc21a0cf5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "久等了～\n这是您点的猪内脏肠跟罗克福蓝起司沙拉。",
      "source_fingerprint": "3617a2143e19582f03a9d913d7105edbc1dffd64efa7d0cd98ca13f5a2491f73",
