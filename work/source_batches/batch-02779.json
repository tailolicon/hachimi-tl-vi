    {
      "uid": "zhcn:b0c109154ed8228888777dec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊哈！一开始都会紧张吧……！\n我刚刚进入特雷森学园的时候也是这样！",
      "source_fingerprint": "ec0aa0784985c6fd67811d51936682d0b78ca85ea9c23804fa07e27c10944d74",
