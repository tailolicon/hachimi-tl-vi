    {
      "uid": "zhcn:bd6f669c2e10e59944ec1d3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小后辈看得也很兴奋呢。下次一定要跑得更好。\n这样的话，得加紧训练了！",
      "source_fingerprint": "0d51262d38f9c0466fc2add8cd4cb5ae7c5840762d601a6f32934a8cf504d3c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077001.json",
      "json_path": [
