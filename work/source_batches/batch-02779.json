        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:0e57ec3f9c8945166d939a9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我没办法马上改变自己的想法和习惯，\n做出挺起胸膛告诉她我是专业训练员这种事情。",
      "source_fingerprint": "bfa9cb07761d1afa567fce9ab4fbae945087e89c89c57b86cf37b0169f9f779c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077001.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:e3c503db65c121ec4e7c925a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "期待吗……",
      "source_fingerprint": "6dab875d3b338fd8bb269d896fc7ff4e2cefdc9e1475bf6a5a4353d2a408f877",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077001.json",
      "json_path": [
        "text_block_list",
