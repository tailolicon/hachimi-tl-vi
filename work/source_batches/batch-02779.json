    },
    {
      "uid": "zhcn:1bce68ae27129fc296b56e43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田路",
      "source_fingerprint": "988a071d6223b7f19ac194fb48e747cae2ebec8525c415e4d4d92ec1443cca38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
