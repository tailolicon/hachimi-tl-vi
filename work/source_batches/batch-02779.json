    {
      "uid": "zhcn:006a1ee5c85f5bd60a036095",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "先生",
      "source_fingerprint": "cd98e43da31bb1b90dc152851c85c7d266d47ba97bc5ff7bd137c5920429d467",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
