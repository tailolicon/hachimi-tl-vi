      ],
      "json_pointer": "/text_block_list/4/choice_data_list/0"
    },
    {
      "uid": "zhcn:e2d7bc98a7ecf1fcf16dd70a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……看见了我这幅惨样，老师他依然在期待着我，\n没有丝毫的怀疑。",
      "source_fingerprint": "33d0b768fc30f7e259bb3e35a9fc048c4d950d6d1b685e27b844f0ced4707341",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077001.json",
      "json_path": [
