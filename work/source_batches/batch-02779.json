    {
      "uid": "zhcn:117df8636225209fe1aa80c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――啊，训练员。\n非常感谢刚刚并跑时候您打的开始信号！",
      "source_fingerprint": "6a4ef9b61775480d6cb03a1268561be64d8d9eccc5cd9ce993059a576c89e7c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077001.json",
      "json_path": [
