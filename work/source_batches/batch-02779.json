    },
    {
      "uid": "zhcn:5dc800b59a99dea4dc330f5d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……真好啊！\n哼哼，虽然是突然安排的并跑，但是还是好开心！",
      "source_fingerprint": "aa709f3621623dc19842e710969cf830d24bce5a0a1cc071c27b2642381ccc57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077001.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:61624249c3f15a3bccca93f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田路",
