    },
    {
      "uid": "zhcn:c64779ad0f83cb59631b5381",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个训练计划不仅是为了你克服自己的弱点。\n准确来说，里面的内容是为了增加你能做的事情。",
      "source_fingerprint": "e9e324e1af9b6119edf36c49d10c1abd23d0c8ee7e10b1410f63c0abeba89af1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
