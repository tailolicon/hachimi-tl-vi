      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明白了！不能太过刻意的去关注。\n感谢，那我去了！",
      "source_fingerprint": "cd373f6b8e57eb36c7e7064d0b82ae5e015c8b26d5bc3596efaa940e89c60e98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
