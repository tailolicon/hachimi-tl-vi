    },
    {
      "uid": "zhcn:540ac76d81c71b6962ae6e1b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不擅长的……是吧？",
      "source_fingerprint": "8b3622ece38e6314bd42933ba0d5787ba6611562874b16924fff2d15ff62ba39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
