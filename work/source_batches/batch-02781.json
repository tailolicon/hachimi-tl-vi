      "source_language": "zh-CN",
      "source_text": "训、训练员！？\n怎么了，您为什么会在这里。",
      "source_fingerprint": "4521b6528365e2e181e4e0cf02f86fb2c98657ef5f6af7299291cc6b58357c25",
