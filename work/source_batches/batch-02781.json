        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:3a44b503c8e3ee18f302ffff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来看看训练成果如何吧……哦？看这个背影好像很紧张呢？\n是因为作为训练员第一次参加比赛吧。",
      "source_fingerprint": "b95ac9af58745663504414d8a4813912256127847af2f1b354d9bb3dee67ac1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077004.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:4c6ad7caef0e6decc63b5bc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我立刻意识到说错了话，说了声糟糕，然后捂住了嘴。\n我做了一件作为训练员不该做的事情。",
      "source_fingerprint": "a6d4e611a9406dd1f835933be5959a29185ad14b6676d78dfdbfc42cea1f1121",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077004.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:d35b0228389e3cb138fa8cca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不管自己感受到了多大的压力，\n都不应该把这种压力带到比赛上――",
      "source_fingerprint": "1d64b1a2a0aa1edf20074b87ca02acf97fc1085200a363b9c73d42c4fd58b2d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077004.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:34e4d9131367fa8acddc9aa7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――",
      "source_fingerprint": "85b4e57cfb65ac4c03f193f7a21e745cbc1b55259994bcccb1759a1c7591ef3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077004.json",
