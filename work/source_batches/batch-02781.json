        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:e39d8333440b358db611aa93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "注视前方，不要把视线放低",
      "source_fingerprint": "a300ba1160beeb9f39cb83241faecd5c3abb1e2cfb9f46b45befb79f6d60c6a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077003.json",
      "json_path": [
        "text_block_list",
