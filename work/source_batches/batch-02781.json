    },
    {
      "uid": "zhcn:552c2aa591c5c81510ade54b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那是……",
      "source_fingerprint": "c02e9f14cf5102bf8dad5b9ac22e2cb990dd8825ff4f026fcd125168e56c3cab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
