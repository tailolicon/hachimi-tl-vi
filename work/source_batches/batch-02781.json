    },
    {
      "uid": "zhcn:8ac8d9527820336097909b91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我抬起头看着成田路奔跑的身影。\n刚刚的建议，也是给我自己的。",
      "source_fingerprint": "73a28d991231a3f2acc02eae06c8e038048faa4acd2419337ba92729271e1952",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
