    },
    {
      "uid": "zhcn:b7e1085d80ba5b6988efd0c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没问题。训练的项目就是为了这些问题而做的。",
      "source_fingerprint": "6e97ab147df04bf1b958727f6d7d9ac4de3ada7b1983b883fbef4285a0452e6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
