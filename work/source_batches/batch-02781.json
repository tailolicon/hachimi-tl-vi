    },
    {
      "uid": "zhcn:3c92c64c157931f191890a65",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田路",
      "source_fingerprint": "988a071d6223b7f19ac194fb48e747cae2ebec8525c415e4d4d92ec1443cca38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
