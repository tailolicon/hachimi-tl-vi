    {
      "uid": "zhcn:c22dfaa925b67fe631e436b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "完全不会！因为，我由衷地觉得高兴！",
      "source_fingerprint": "341a1003db51361c4b64449b30d69442782ef1a4b2ee0c0fa91fa8666d03b45c",
