      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:abc0d3f7e1da63e0f9fae393",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天以后，成田路在日常的训练时间结束以后\n也会进行自主训练。",
      "source_fingerprint": "b721d0e3331c8a4aaeaf049be7d7711908dac654e08927c834d49d1df8995673",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
