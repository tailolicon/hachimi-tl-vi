        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a900dec394666ce9aa095de8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田路",
