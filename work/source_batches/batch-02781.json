    },
    {
      "uid": "zhcn:44487e2b5cc549e19c2efd5e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……对不起。如果我能再灵活一点的话――",
      "source_fingerprint": "4d508a1f7b4949d3b369eca5b28dd0a0f5d1bc9cc7efcee24f3900bf7122953b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077003.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:0c7a2654810f8be3014a48d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "把这些当做重点来训练吧！",
      "source_fingerprint": "6308a6ccb146ab035c598a7cee59a54dcacce1b9e7075a0db57a8fd6c79beec3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077003.json",
      "json_path": [
