        "name"
      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:4fc782e19cb0ee4bf59c1e00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，是的。老实说，这种事情我不擅长。在比赛开始的时候从人群里面脱身，\n还有突然地冲刺跟放缓节奏，这些都不擅长……",
      "source_fingerprint": "03995ff7d051199a7316e2e36e64274451e1cbbce778ba57f5a08fcd8f8224ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077003.json",
      "json_path": [
        "text_block_list",
        6,
