    {
      "uid": "zhcn:2ed4ec5d1672ac456fbcce65",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "阿路班长ー！训练的时候要ー加ー油ー哦ー！！",
      "source_fingerprint": "ee317465a7ef5e0fe861e844470b51b56228e7b26f1dd4ba36d9e74c85574d27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
