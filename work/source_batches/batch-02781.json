    },
    {
      "uid": "zhcn:94d66d63e2242d1826d7e33f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了抵达期望的终点",
      "source_fingerprint": "8e1634383ccc8eed1bb7b2a3a4ea5eb84ca7cf43ccad05abf54848185dd29439",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077003.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:fc637ec0df51718c7c361f91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "模拟赛当天……来参观的人数远比想象中要多。\n不仅是只有成田路的朋友们――",
      "source_fingerprint": "d441da7f500e67c9e79992cb9028187c4921fa979f5c50d4c49fc98d20fb69cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077004.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:19b847eaffc94708be9e21ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "先生",
      "source_fingerprint": "cd98e43da31bb1b90dc152851c85c7d266d47ba97bc5ff7bd137c5920429d467",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077004.json",
      "json_path": [
