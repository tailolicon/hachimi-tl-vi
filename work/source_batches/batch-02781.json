      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:41d1f1e9e3aa17f22ea04051",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在资深马娘也会参与的模拟赛中，\n我到底……能让她跑出来她想要的结果吗。",
      "source_fingerprint": "71478c88ece5067559157d6d8af52c8b6125fa5866c01d48c1fd4835f6f04e2a",
