      ],
      "json_pointer": "/text_block_list/8/choice_data_list/0"
    },
    {
      "uid": "zhcn:fa1298997e8836dbd4ea4cb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而，在我走到垃圾场附近时――",
      "source_fingerprint": "1bd37f1ef54369342e2c5b46c9e255eff765f04fc81193a3a84e4af8a635d2c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077005.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:cb5a385b3311e88030341e6a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在垃圾场前，成田路呆呆地站着。\n覆盖垃圾的防鸟网上面，站着好几只乌鸦。",
      "source_fingerprint": "26e30a4e7c2c74a5eca5fd74823fc1a37259c90baed38beeeae463532d8bf06e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1077/storytimeline_041077005.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:e7c13b80a405819e40640557",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "挡路的黑色身影",
      "source_fingerprint": "86ac395331158989482c8fa5ded741cc7232901e31c4b6102c016ac02a261418",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
