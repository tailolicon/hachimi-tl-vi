      "source_path": "assets/story/data/04/1077/storytimeline_041077006.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:7aa4f6d51b5b7604fb4ef979",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要到哪里去吗？",
      "source_fingerprint": "5cb41c13c038a8c9b4e12344a8ea0a94c34e92c1947052985f29b6783b3e1afc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
