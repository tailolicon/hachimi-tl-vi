    },
    {
      "uid": "zhcn:0a286bb2ea42cdc2a7bb792e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某个休息日的时候我在外散步。\n正好碰上了干劲十足的成田路。",
      "source_fingerprint": "5cacebb13b1b6c0071e01d82670ac05ab3ecf0cdba941caa0bfcb889e450a3eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
