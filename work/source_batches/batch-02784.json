      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，那这样的话，我来帮你丢垃圾！\n你快去老师那边吧！",
      "source_fingerprint": "20321a77b3cc448f7ef92e026b01a88d3d9b1c44530107499476a8a0dab85b22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
