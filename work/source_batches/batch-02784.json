    {
      "uid": "zhcn:94597316eb0293eefdd4d3b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我也要努力了！）",
      "source_fingerprint": "d83ef71c72ed8f3f5899df88f28688f418822f4a733596d84d8b702f37993ce5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
