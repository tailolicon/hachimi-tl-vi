    },
    {
      "uid": "zhcn:7e0410f29c1e57aaa43c2bed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她就像在说服自己地说着，但仍旧掩饰不了慌张。\n究竟是什么东西挡住了她的心门──",
      "source_fingerprint": "2e3a9dd38fe0ad31598b2229720faac5a8019e6de815a373a41a853e088180dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1078/storytimeline_041078004.json",
      "json_path": [
