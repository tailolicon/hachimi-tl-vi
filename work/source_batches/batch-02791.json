    {
      "uid": "zhcn:7d29c94e647ed7be24bd279c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没事的，我很清楚。多亏有训练员在，\n这段时间我做了相当丰富充实的训练……",
      "source_fingerprint": "957d5d3dc420da3309747caa71fb62653e91ad788206041f5c1c57f2bb077a75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1078/storytimeline_041078004.json",
