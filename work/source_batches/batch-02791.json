        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:1768e2746bb8d73a85e8e0d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟这是她第一次参加选拔赛，我不免有点担心，\n但她看起来似乎也不紧张。应该没有问题吧。",
      "source_fingerprint": "bccda1bc68acd3c565bf394583b5d8011560e7bbaa91b5f1731dab8a0897cab5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1078/storytimeline_041078004.json",
      "json_path": [
