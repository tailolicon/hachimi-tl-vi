    },
    {
      "uid": "zhcn:3ad81756781f5dec5679b121",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我很乐意陪你！",
      "source_fingerprint": "fd0af497ba8d5768af9de8935190142bf1d42d7cb7c0464d334fff5503deb8e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
