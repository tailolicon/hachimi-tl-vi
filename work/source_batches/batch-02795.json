      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉",
      "source_fingerprint": "e241061c6d3be82b56b46887c60272b882830f32a9026e07600d2ab0cc419fad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
