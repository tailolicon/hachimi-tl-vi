    {
      "uid": "zhcn:0403ee0527a783dc4b0020b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――船桥赛场。\n与狂怒乐章的相遇是在『鲜红惨剧』那天。",
      "source_fingerprint": "55af49025f1ff5f14ab506ddf7bdba829f6496a3b95e2de3282eba514950e547",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
