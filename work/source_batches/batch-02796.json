      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:f1a5e7fa5df75201b84d9002",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "GⅡ『大尾光纪念赛』……。\n我们一定能赢！　一定！",
      "source_fingerprint": "fbf3c8671db8cad0b2046c5fa3109060aca4208096861644dc10d6f748352dfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e9f220f97520374e1e53b0a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我目瞪口呆地看完了比赛……。\n我自己也是地方船桥特雷森学园的训练员。",
      "source_fingerprint": "3fc3dce510c5b805afc84f07867a4a0bb6cd778641df6eb5d163d1eee828f45a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:1627ad213f728064f854416d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不管是赛马娘还是训练员，属于船桥的所有人看到的，\n毫无疑问是“鲜红的噩梦”。",
      "source_fingerprint": "5d3aa4d501ccdce787acfb95aa204ddac7aead4f640a8d9b8da8c4714c1a8027",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
