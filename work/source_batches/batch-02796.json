    {
      "uid": "zhcn:80677b3eee3caafa1cb91a09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "狂怒乐章",
      "source_fingerprint": "ebdaabb0ece5e8b8e1afccbe16bf8d974868d01eb81f67693a52c8d5e4a19176",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
