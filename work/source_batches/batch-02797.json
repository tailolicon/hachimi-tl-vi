      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "盼望！　终于与你见面了啊。\n我是中央特雷森的理事长秋川。",
      "source_fingerprint": "81d6170493a42f9b7b649e8796f1d07af7c7cbeadc9e5ca6dd864f725f679d9a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
