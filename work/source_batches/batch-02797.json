    },
    {
      "uid": "zhcn:5324dffdaaa1cb05f2f13ec3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『大尾光纪念赛』，现在冲线！！\n第一名是――",
      "source_fingerprint": "af27ca47ff276b885db14d00fd378826ba44e2e7724fb65db224c904acceacc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:4ac7b3598e08132edea1280c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――！？",
      "source_fingerprint": "8fd511a0a9487c360ad419d8a9ac8a6030c5af472967319045106c26615c13eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        40,
