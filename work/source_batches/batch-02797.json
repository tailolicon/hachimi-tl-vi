    },
    {
      "uid": "zhcn:b9e439ba43749af48ef453bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是，是吗……。\n果然不会这么轻易就接受啊……。",
      "source_fingerprint": "9b7ede09e1e0b46d52cf374f93a409ac22e729675ba383a473706e08e4ce7e1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
