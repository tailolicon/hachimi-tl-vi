      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶……！？\n中央特雷森的……理事长！？",
      "source_fingerprint": "9190798f7ea1457e3ee1854e95d1dba059644f465e302919b6af1927ced47982",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
