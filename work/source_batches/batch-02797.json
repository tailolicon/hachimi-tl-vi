      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:ffc4b00fcc968deea73e8981",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她想要我们正式的答复，于是我们来到了中央特雷森学园。\n在这里，狂怒乐章斩钉截铁地说出了这句话。",
      "source_fingerprint": "e4fffff40acb5824d59bba27a5147327ea047532728fa42de61730c3cb80b12b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:8bea60c4594ebbfe8506e22c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
