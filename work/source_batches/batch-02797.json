    },
    {
      "uid": "zhcn:c85b93886ef1d79a2b8c4cdd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "解说",
      "source_fingerprint": "9ca0a41d5cdb419c4fd19aae6febfbb7f658ff014636b5d29d31bc0d0771b290",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
