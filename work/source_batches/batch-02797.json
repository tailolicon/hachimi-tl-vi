    },
    {
      "uid": "zhcn:352add4c806c24dc3ea803c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恕我拒绝！",
      "source_fingerprint": "0d3853bceb7e633648c3f3e6eea88c252ef9e941350895c0078b9b3014063716",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
