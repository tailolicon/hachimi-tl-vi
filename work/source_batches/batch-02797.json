        0
      ],
      "json_pointer": "/text_block_list/40/choice_data_list/0"
    },
    {
      "uid": "zhcn:7cb3c477ed99ab56d1c36239",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        40,
        "name"
      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:ba41b4705e17602eb5d0f52b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "打听！　我想邀请你从船桥转入中央。\n能否加入我们这边的特雷森学园呢？",
      "source_fingerprint": "ccf2af56493b4891d8ed48280fe09a885a660ed83371f423bd0e59e23f875aa4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:a5187c13b598c09d86dadde0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "远道而来的秋川理事长，发出了意想不到的邀请。\n但是――",
      "source_fingerprint": "0a00bc53f4e3e72f2cf3139c187b34d1f25821b81bbe15c74c4396e6ceb5bcd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:88707d97e187f04777fa8854",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "狂怒乐章",
      "source_fingerprint": "ebdaabb0ece5e8b8e1afccbe16bf8d974868d01eb81f67693a52c8d5e4a19176",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079001.json",
