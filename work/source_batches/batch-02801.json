      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "带着惭愧，我打电话给了委托人。\n可以的话，能否让座谈会延期举办……。",
      "source_fingerprint": "f8f745523a4dc66263bfbe0ec2ff16d80a13d128ee4475961f0ed1619a319ac9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
