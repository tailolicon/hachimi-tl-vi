    },
    {
      "uid": "zhcn:8d8b0606f5aeaeee832cf672",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让养育了我们的船桥街头上。\n响起震耳欲聋的欢呼。",
      "source_fingerprint": "423d00cf79ee7662041b38f7fc7b6c9127d53cc86781f0c409d7d16fa4300b8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
