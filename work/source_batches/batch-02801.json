      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一定能战胜，一定能！",
      "source_fingerprint": "035f412b2e794c12c0e5d520006cd54f64ea17162cb336253ba86d54d3537aab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
