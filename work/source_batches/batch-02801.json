    {
      "uid": "zhcn:eaeac8f9c170a5eccb1b671c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两个人的心愿只有一个。战胜中央的赛马娘。\n以及总有一天，一定会――",
      "source_fingerprint": "bb312bf328beda7d27eca647346c7bb6144381e9d61ae71f40a7e61331c4cbfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1079/storytimeline_041079004.json",
      "json_path": [
        "text_block_list",
