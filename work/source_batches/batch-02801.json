      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不能相聚的话，我就不去中央了！\n没有你的话，我也不跑了！",
      "source_fingerprint": "48fba0a926d9f8d95633eac526966db083f11d4f375860bc485c79f99444759f",
