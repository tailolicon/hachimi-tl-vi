      "source_language": "zh-CN",
      "source_text": "──的确，她是位既温柔却也有些笨拙的赛马娘。\n或许会因此受人误解。",
      "source_fingerprint": "b809c2e39054f5788205d8dc95168b7bd6674488cadaa7d82af629bcff7a91fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
