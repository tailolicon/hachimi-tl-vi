      "source_language": "zh-CN",
      "source_text": "从她那坚毅却面无表情的脸上，确实难以看出她真正的想法。\n但是──",
      "source_fingerprint": "09b337962b4018c29cd17be42cd6b42fd98dfb194058dadf76dacd014b68101f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
