    {
      "uid": "zhcn:77a2ab4b8e6e502e9d2a10f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（后面的海滩啊……）",
      "source_fingerprint": "3d018506d8dc7c42e43408bf8cec597bcbafc53770a3fe83b0d401f448eeb338",
