    },
    {
      "uid": "zhcn:12543bd3c9825e5787dc04fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "晒痕很显眼的赛马娘",
      "source_fingerprint": "9ba6cc51239ffc1498b39a5c0b5bbc0465e15832c5619f3994ce2ee9a9a952f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
