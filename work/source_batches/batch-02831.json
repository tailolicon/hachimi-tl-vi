    {
      "uid": "zhcn:746317e5ad15fbbbf729188a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回家后，我翻开图录查询第一红宝石凝视的那幅作品。\n画作名称为“心宿二”──也就是夏季星座，天蝎座的心脏。",
      "source_fingerprint": "891461d8da051f739a82556439b61d88d64c7206ae1a33626f1dea186ff0ebd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1085/storytimeline_041085006.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:98f8c40adf8eb4332c231f7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红宝想买什么书？",
      "source_fingerprint": "d732d48565d7b6865ae3205485c91755b40351cf6a082ac1495c0dd080c292ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1085/storytimeline_041085006.json",
      "json_path": [
        "text_block_list",
        4,
        "choice_data_list",
