      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为事前做好万全的准备，才是最高敬意的表现。",
      "source_fingerprint": "c5b4997d8e5a37431e03bd7f73d9fbd1ca1984f8c7713ab12c1611b790cc3f7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
