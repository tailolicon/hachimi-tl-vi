      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "早知道就该先问它喜欢什么颜色呢。\n真弓搞砸了。",
      "source_fingerprint": "2833f0516dcc8a0b950e2d60ab567990b6266508ab14d550af4f9e082c21d1c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
