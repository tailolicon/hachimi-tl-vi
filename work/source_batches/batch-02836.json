      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放心吧，我已经帮你拍下影片跟照片了。\n真弓绝对不会忘记悠悠的。",
      "source_fingerprint": "78b9728b36e5bd1688c2b6f3de5e39c93b2c6eef7483288819d310560571a29c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
