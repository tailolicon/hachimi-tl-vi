    },
    {
      "uid": "zhcn:e9bf91ddd577eefa0e3cb004",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她带着“好友”悠悠的遗体消失了踪影，我还以为她会\n沉浸在悲伤之中呢。我诚实地告诉她。",
      "source_fingerprint": "b624b87d199ec8bc3ef04f9445ceb4a7e5c24350490a9d858a8beb5b53dd1a6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
