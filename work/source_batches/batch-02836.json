      "uid": "zhcn:6e8c78a2a59e83de13035e55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为我是赛马娘啊，身体比人类还要结实喔。",
      "source_fingerprint": "8182800af5f45fc994a263de2f30ba035bd9e04f82e101902372475d2faa9676",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
