    {
      "uid": "zhcn:6db7050b432cc782e0dbb4c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真弓快车表现得很冷静。她脸上不见哭过的迹象，\n淡淡地对着墓碑说话。",
      "source_fingerprint": "6ba674822c5dc958739d0122a579cfecdf306e024d397c80b044febffc6f7ea8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
