    },
    {
      "uid": "zhcn:ab8555380a5807bdc50bd9dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那我先走了――再見！",
      "source_fingerprint": "d982fd00f37d928d30a6e08f69ea60232c4009bf59a4331efccd4f69003ca351",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1088/storytimeline_041088001.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:ddff0f440415c14f547133ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（“一见钟情”啊）",
      "source_fingerprint": "16e966c3ebb3d464949d67e9e5c425b2c827cb14e93c440e16e74219faa0868a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1088/storytimeline_041088001.json",
