      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――在想着这些事的时候，\n比赛开始了。",
      "source_fingerprint": "bd31712c0feef4f96516e061752131c9b6d2a862d93dcc8f9b5432d16d881908",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
