      "source_language": "zh-CN",
      "source_text": "请看好今天我的表现。\n等我本格化了，不久后就该你了！",
      "source_fingerprint": "ce7d09b781ae9971874367c6ae4ca717066967200eb913731ec9c56441f4e4c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
