      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――哈啊，哈啊，哈啊，哈啊……！",
      "source_fingerprint": "bbb633320fd32c87050190486e0207c564d167733b5260375c8057f3a1dd4bed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
