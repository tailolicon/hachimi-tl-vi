        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:6c37477d067b9c0258cea999",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还有别的原因",
      "source_fingerprint": "22cdfea3081b1948be187189a18d3d563e0f1f509dabbcdb3f05fbc7146ab343",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
