        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:4b3126b19dcd7631653c85e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "暂时没打算去吧",
