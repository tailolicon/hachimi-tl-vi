        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:49e1e63101debb4e1906ce4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后，我们不停地写着在香港想做的事情，\n写满了整个沙滩，就这样度过了夏日的夜晚。",
      "source_fingerprint": "ec149e7ee90f4c051f074549c07ecd126f617cc86e360164e3fef7eb98ff4187",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1088/storytimeline_041088007.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:b183e06caf962d42d363e8eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特意选训练后跟我谈，\n想必是私人相关吧。",
      "source_fingerprint": "c71db0709f12c00eb7dbe740c3b2f02f088d8a314916666954e38028c0640aa5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
