    {
      "uid": "zhcn:9f3d28373546fc2165d4d6c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高尚骏逸",
      "source_fingerprint": "7a040d8ec3e02a18482ec0c43d3c1c3d865082cc8d8e9b7ec74362d3a63e7fcd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1089/storytimeline_041089002.json",
      "json_path": [
