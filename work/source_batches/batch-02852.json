    },
    {
      "uid": "zhcn:10b3cd872507ec1469cf0187",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被完全笼罩在三冠赛马娘的光辉之下的，\r\n不知名的赛马娘。",
      "source_fingerprint": "5116ccd8b4b9f5ad1ff0fefd7bdb91a7e91391d30e786b58102861a74059be99",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
