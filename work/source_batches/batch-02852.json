    },
    {
      "uid": "zhcn:c7672494707e5aaaf58f8b14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "年幼的高尚骏逸",
      "source_fingerprint": "fb016c3d8067c8d17ddac656b8d846efa2b597371fb03db76c3aad0fd39dad93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
