    {
      "uid": "zhcn:4a8b728257360bd98521f5f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高尚骏逸",
      "source_fingerprint": "7a040d8ec3e02a18482ec0c43d3c1c3d865082cc8d8e9b7ec74362d3a63e7fcd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
