      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我可以陪你一起训练一段时间吗？",
      "source_fingerprint": "72c7f306cd286034a8784f7557f8992e0e84b678db6668c39f8dce3e9701388f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
