    {
      "uid": "zhcn:6bf03dc337fdff16213daf61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她怎么能自卑成这样的啊……）",
      "source_fingerprint": "c9f20f013eadf80a222b5a1c57fefadb1af170aa17a5910aed4c962128994d6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
