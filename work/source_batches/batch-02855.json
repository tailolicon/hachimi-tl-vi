    {
      "uid": "zhcn:61726ea8d36f2a5c5500373c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶。",
      "source_fingerprint": "29583d9e5caf0f60d5c034ab95d901b32ed2578e06e6d23c3ff7a0a3027122ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1089/storytimeline_041089003.json",
