      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "教官A",
      "source_fingerprint": "bea37fbfcc6be0bcdd015d647c925eccb13e59064ea59312be718fea84ee70f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
