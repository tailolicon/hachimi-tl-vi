    {
      "uid": "zhcn:5a482ad3bd344e65f457eade",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想要成为……世界上最伟大的赛马娘……！",
      "source_fingerprint": "5d1ad0fe259a640c9068163e60ef62aa1a0255b87b1ce5c07c8e0d7f899f89bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
