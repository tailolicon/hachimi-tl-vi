        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:553d5b6b1f282581fadb825d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此这几天，我把她和她的两个姐姐——\n“极峰”和“高尚骏逸”相关的资料\n都调查了一遍。",
      "source_fingerprint": "b6172cea68a7cd1f5fdcc0f3bf2eb25c994e7536537ecbc55c1d4bdb4664177d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1091/storytimeline_041091003.json",
