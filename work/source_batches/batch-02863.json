    {
      "uid": "zhcn:d893e89c976c6797ede26ef8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "模拟赛过了几天后。\n为了帮她实现去迪拜比赛的梦想，\n我打算寻找能正确指导她的资料——",
      "source_fingerprint": "ce1449445e6cb640c3eeb0cf369c555052391073e526f26733790cdf296019c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1091/storytimeline_041091003.json",
