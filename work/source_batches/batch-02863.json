    },
    {
      "uid": "zhcn:dba8ea7be900e363fe1a8fe8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（要说有什么顾虑的话……）",
      "source_fingerprint": "8e11a9b34b8d11e0f4b9d0de157faf4bcc77084c3f04c46896b3ca7264d39d48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
