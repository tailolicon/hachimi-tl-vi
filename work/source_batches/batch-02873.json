      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以及直到今天，一次也未曾\n和她一起以“主角”为目标的事实。",
      "source_fingerprint": "80812b834f49f3f50ab2caf89fd604588305f3997643f69ac003111465fe7dfb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1092/storytimeline_041092003.json",
      "json_path": [
