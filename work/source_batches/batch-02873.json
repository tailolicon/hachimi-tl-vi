      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "关于出道的事不用担心。我已经安排好了",
      "source_fingerprint": "3883c2d12d11bc17564f07ad84fcad29f2c8367d820c7b16d7e78fd983b2d80a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
