      "source_language": "zh-CN",
      "source_text": "……好痛……！",
      "source_fingerprint": "b8d5a45a7071eac3040c9c925d324a3c922df12d38994e78910b3a32b6b17602",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
