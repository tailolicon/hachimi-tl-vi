        0
      ],
      "json_pointer": "/text_block_list/10/choice_data_list/0"
    },
    {
      "uid": "zhcn:baee2877a090ae14773a7dd7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，你是怎么知道我房间的？",
      "source_fingerprint": "f81b94c783c2d50d44641aa0c651e0e6b848937bdf895b92c2fca2af3c48a82e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
