    {
      "uid": "zhcn:da0c64e5b9c9f51661d6a102",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明明一直一起走到入口……\n环顾四周，却怎么也找不到她的身影。",
      "source_fingerprint": "6de3eaceebd1a3d1366b070c93041f64847efd9b8a07e3ac1f237f28ecce3e79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1097/storytimeline_041097002.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:46d3fbc825fefd801cd79e12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，你怎么知道我房间的？",
      "source_fingerprint": "875f606fd3f3c2c1cee9819e66fc4b16bc6184cc0562e87fdf70a81dc2649662",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
