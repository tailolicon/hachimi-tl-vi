    {
      "uid": "zhcn:e70e37dd1b48ea589ff8c984",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只是……那个，真的很抱歉……。\n……你没事吧？　――昨天……",
      "source_fingerprint": "bcdf221330e9ad0500c98ab663a32512c7f8079e3b5a08826e335490e44c2318",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
