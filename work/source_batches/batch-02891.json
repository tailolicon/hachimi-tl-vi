    },
    {
      "uid": "zhcn:7086b1bb5888f7c2f05d0005",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "参赛马娘们的意识，都被吸引到了乾的方向。\n所有人的气都集中在“背水一战，一攫千金”的方位上，自然就――",
      "source_fingerprint": "bcaaa953db5d7c7e4c88ef4d6cf7a0be4fdef529b49874e9670bae710469129a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098002.json",
      "json_path": [
