    },
    {
      "uid": "zhcn:5d5d0f2362139029b978557a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
