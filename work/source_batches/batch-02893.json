    {
      "uid": "zhcn:aee3062bc8c7b1ae98d78bdf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――就像这样，风水可以把人从微小的困惑\n或是停滞中拯救出来哦。",
      "source_fingerprint": "edf135736c4510a37d3718676a6d162c417a310c7317ef98d582edbc0b18e520",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
