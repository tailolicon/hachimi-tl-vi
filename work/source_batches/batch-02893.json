      "source_path": "assets/story/data/04/1098/storytimeline_041098003.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:f44d1b4af5aa14b573341803",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中餐厅的店主多次点头致谢后离开了。",
      "source_fingerprint": "dfdbf84747230e2c55f016b26b4d6b26a2f0129f1e81dd33fc2247a34df6061d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
