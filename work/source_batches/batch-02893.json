    },
    {
      "uid": "zhcn:161751e732036795fb2093e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，训练员！　嗯，既然让大家看到了我不争气的那一面，\n我就该在训练中注入更多的气了吧！",
      "source_fingerprint": "52dd78717963dfbb741e0da60bcd6ab9a6667cbdc629c005b1b05684043237e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
