      ],
      "json_pointer": "/text_block_list/51/choice_data_list/0"
    },
    {
      "uid": "zhcn:ea6bea3ad84b74d3685a3e34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
