      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:4ce22dff7b09921ba1c85807",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你在比赛中，听不到大地的声音的原因",
      "source_fingerprint": "74e80d3072455548266a04612debbc87ff20397a7bfa33ce189409676628aeae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
