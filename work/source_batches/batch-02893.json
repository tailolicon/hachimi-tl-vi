    },
    {
      "uid": "zhcn:253e164f78732ea4223670d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，为了我父亲还有那些常客，\n还有劳你再多提些风水建议了！",
      "source_fingerprint": "ccf1df4d6103503a5035e9010ade3cbf1279a68c8f32d63e5d39926135a97fd2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
