      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……？　怎么了吗？",
      "source_fingerprint": "36ee3e68b6117faa0dc30f36a4148694447294dabca11c610af9224ee3f8d1de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
