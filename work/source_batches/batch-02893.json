    },
    {
      "uid": "zhcn:d0895a3fa5988c6a90fa85d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从大地的视角，感受到了『这样跑就好』。\n气的流向，周围环境的动向，我全都详细了解了。所以……！",
      "source_fingerprint": "cf85bdfc80b22f0ccf233f674f2444519cfd509f9a22a83ceb4c9681821c9b91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
