    },
    {
      "uid": "zhcn:9bf26d20deeb351991e7a315",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说是为了大家有些夸张了，不过我果然还是\n希望大家都能开心吧？",
      "source_fingerprint": "d8e56988d5a8432fe217f55ef9a537e1740dc745cf17fe9a4875971721058d61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098003.json",
      "json_path": [
        "text_block_list",
