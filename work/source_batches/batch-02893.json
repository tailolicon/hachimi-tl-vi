    },
    {
      "uid": "zhcn:0eb808e6cd6a13cbba0e2827",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以我想要真正赢下一场比赛，\n让大家明白那份力量的厉害♪",
      "source_fingerprint": "a43da09d3046b1fadca4522d032dc7b4099e6f2257de2e46ef3eeb79ca31f0d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098003.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:10501376a5b0ef02628da275",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
