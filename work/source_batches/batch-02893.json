    {
      "uid": "zhcn:d07be279914c74dd34a12426",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶诶诶诶，真的？",
      "source_fingerprint": "0cf62669d86e7712a31a90de114479f61ca2cd2e9bf627905b12c77f6638bbf4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098003.json",
      "json_path": [
