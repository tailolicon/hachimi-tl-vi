    {
      "uid": "zhcn:a27ef5854176a577e3f87ac4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我自己也是如此，我也看到了许多同样有困难的马娘。\n如果我用风水轻轻推她们一把，她们往往就变得顺利了。",
      "source_fingerprint": "d779471d348f93ddc5168983b10f420a3c3f295e84595dfe3c7b0f4cf2ed06cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098003.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:e284d804b34dd24c042e0ef9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098003.json",
      "json_path": [
