      "source_language": "zh-CN",
      "source_text": "真的！？　太好了ー！　其实啊，前几天我是\n把训练员房间里的『横梁压床』给去掉了！",
      "source_fingerprint": "9b5a3db840dcbeb96e73c65fa466ce6f1ebb119d7f729544518ce3e862607924",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
