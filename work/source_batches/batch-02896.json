        "name"
      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:ff78f30909bf7d4a7a25114f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………啊。是吗……是吧。\n那个……以前啊，爸爸也这样说过我。",
      "source_fingerprint": "18b9d0514d04a002724f146efcdfe6f667e9b87675e0f8aaf65e3d5b3402cdf8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098006.json",
      "json_path": [
