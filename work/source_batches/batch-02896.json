    },
    {
      "uid": "zhcn:7eafce5b84d46c15ee35e398",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……诶……",
      "source_fingerprint": "c2a070c21fc1cfa1f238cc0c02bd27b9454bf7031e1a278478e9ed2353c1b3b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1098/storytimeline_041098006.json",
      "json_path": [
        "text_block_list",
