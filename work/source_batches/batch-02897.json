      ],
      "json_pointer": "/text_block_list/42/choice_data_list/0"
    },
    {
      "uid": "zhcn:facd98ad6102d62739c200df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇束手无策了。\n恐怕，现在的她，最需要的是单纯地去面对吧。",
      "source_fingerprint": "d49c2ea6308491d372a14311c893d52d278e9361b7134c62da25cdf362039f17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
