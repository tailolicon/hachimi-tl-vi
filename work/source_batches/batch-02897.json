      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:2937a6a01b9c1fb2cd87001a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那时候，你是什么心情？",
      "source_fingerprint": "b05af6ce8a22490af9562cf2f28427a248f6f079605913683f6a82729cd6c6a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
