    {
      "uid": "zhcn:ee9ed38e99dcc5445037ac45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "火山，关于刚才的话题――",
      "source_fingerprint": "e01b4e3b2d98c02b974ce00cd5cda359e70f2a4b15c584d0a1976ab4c76e5506",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
