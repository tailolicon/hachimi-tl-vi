    },
    {
      "uid": "zhcn:211764e63f1ea312027d7167",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
