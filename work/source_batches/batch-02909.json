    },
    {
      "uid": "zhcn:bfbe0960757bc0bf24136770",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦？这不是奇锐骏的训练员吗？\n你要找奇锐骏的话，她在这里喔。",
      "source_fingerprint": "19c90502273de519b4a3a9dec90863607a45665f3d77614ab7c0ebe5bac138d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
