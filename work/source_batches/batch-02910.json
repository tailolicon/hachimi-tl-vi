    },
    {
      "uid": "zhcn:18b3d65e3da6410ea63c3732",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏",
      "source_fingerprint": "a207abcfd80fb4fb6f8d31f126614b1c06f6c929c600c2ce53b7c13145067eb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1100/storytimeline_041100002.json",
      "json_path": [
