      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:271662aa7e67c5439a54ed11",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员没告诉我的话，我也不会注意到我有属于自己的武器，\n真是感激。",
      "source_fingerprint": "8a8426f11188912655db784f8c91ce3c619e9410926f93b21aa346471fbf46e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
