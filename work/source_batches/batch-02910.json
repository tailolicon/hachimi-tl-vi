      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:5e84a80b172469a3a2c0a470",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏",
      "source_fingerprint": "a207abcfd80fb4fb6f8d31f126614b1c06f6c929c600c2ce53b7c13145067eb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1100/storytimeline_041100002.json",
      "json_path": [
        "text_block_list",
        8,
        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:b6ca8adac3c6b655542cc08e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎唷喂呀，看你这样，又在想新的训练项目了吧？\n没问题喔～不管多少训练我都会完成的。",
      "source_fingerprint": "1b415dfa28e4a6217692dfcfa0c5b2f78a7ef39107588b1512c88b77f16eba4c",
