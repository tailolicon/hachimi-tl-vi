      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:c7372b16f3451af473d3ae27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在不是发呆的时候了。为了不让她至今的努力白费，\n我也得想想自己能做什么──",
      "source_fingerprint": "6f2c875bc796e7d0cd6cdb4b89553fa191758cefa78890b1b7ca8d69bed9cee4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1100/storytimeline_041100002.json",
      "json_path": [
        "text_block_list",
