    {
      "uid": "zhcn:5c12d9a4ae154cbfe7fb1c01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，接下来要做的是什么呢？\n……哎呀？训练员？",
      "source_fingerprint": "97297dbbbca3c0ad2f3362f7aaf896f4460cfe407cbd76b0618de85fb3e93121",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
