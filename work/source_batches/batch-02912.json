    },
    {
      "uid": "zhcn:ec872ef5fe8366ee73853a1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "解说员",
      "source_fingerprint": "4008bec707b5da8466b977449da2d4b922f1f6bbab6cceca9982aaa914d2e188",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
