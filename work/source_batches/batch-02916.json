    },
    {
      "uid": "zhcn:d1958b30d335c43c1c3cfd3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在夏季集训过了一半时的某一天。\n当我们顺利完成训练后──",
      "source_fingerprint": "923fa37c168f1e6c4ea81cc937ab1f6657d01ea44e58d1ae2c2e6231275e1c12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
