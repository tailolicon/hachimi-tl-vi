      "source_language": "zh-CN",
      "source_text": "“活动举办中！能在这个配置下进球吗！？\n机会只有两次！会赠送成功的人豪华奖品喔～！”",
      "source_fingerprint": "a58c93a6d77809dfb9e576cf168dfb8d63beff35efe7a4c6154ce51c11564c50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
