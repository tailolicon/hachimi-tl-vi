      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "悠悠哉哉，两人的空闲时光",
      "source_fingerprint": "ae659956f43cf43a092ae17f8c41b874f5b65f917e54a77967db44f3236ddd90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
