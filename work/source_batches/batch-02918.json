      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:b01c3e03f48690dd7bdaae09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊。我觉得是琵琶晨光吧。\n和其他赛马娘相比，她的实力明显高出一截。",
      "source_fingerprint": "c52049d33ea11d3af3b166591552794d4838005043f9363150dec1440fc847e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
