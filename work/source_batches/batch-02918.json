    },
    {
      "uid": "zhcn:43a6c7414a2944d48f619aea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田大进",
      "source_fingerprint": "204941ee58ec74ab51ea683e874cdfd052fe9fb71969a94626862947377fa292",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
