      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱斯莱斯不在吗……",
      "source_fingerprint": "c2fbcfce1707f27b367c68266223be86c71d0e484ce788e704077d1041650f63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
