      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吵死了……！我可不想跟人亲亲热热。\n选拔赛上我们可是敌人吧。",
      "source_fingerprint": "96f485c89757ad1c433ac741b4ff584f42cdf012e6a0a72b1fcfedd5d23d4b85",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
