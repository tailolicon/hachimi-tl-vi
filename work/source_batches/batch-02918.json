      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:80e3d7a8147c974e4f80ac89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新人训练员",
      "source_fingerprint": "c2814acf58cca54d150211830eeae5640e61a7c568c13143d2e948409a8072f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103002.json",
