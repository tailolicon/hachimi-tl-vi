      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:b5106de62910622b43b22744",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喂，晨光、大进！一起并跑吧！\n难得3个人都在嘛！联合训练！",
      "source_fingerprint": "c5af01d76ce94fd6df40cb4718821f683f621a1fd55a67bbadedba56aaad0002",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103002.json",
      "json_path": [
