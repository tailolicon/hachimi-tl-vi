      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱斯莱斯不在啊……",
      "source_fingerprint": "b6f08454e7445e7f2acaae201088f2382fca3a07a371d7cb5f122916e6baabc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
