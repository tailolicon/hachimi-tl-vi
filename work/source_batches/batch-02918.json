      "source_language": "zh-CN",
      "source_text": "这想法该说是角度刁钻……真是个奇怪的孩子",
      "source_fingerprint": "f94bb92de7d4704409071f50c7d9db713cf2cd989e50274bae856906ad0c9708",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103002.json",
