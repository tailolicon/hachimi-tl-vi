    {
      "uid": "zhcn:fc113c4ec1496021c85b543d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好了好了，有什么不好。我赞成。\n只要准确掌握现状，就能做出更有效的调整。",
      "source_fingerprint": "12b5481900d79d10b7eb542b10c5eb3788d3a6c9598949215f38a3b4e043188e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
