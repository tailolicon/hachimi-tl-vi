      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:fa610ca4b40a439ac36cedc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个疑问怎么也挥之不去，\n于是我决定直接问问她。",
