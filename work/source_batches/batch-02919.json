    },
    {
      "uid": "zhcn:5ee2cbc78ffc5ebd1afc78fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某天――\n莱斯莱斯向训练员们发布了一项告知。",
      "source_fingerprint": "e0e86860b0bc2e5d4068ef2be4d272f409536dcfefa08ce092a71179fb4eec06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103002.json",
      "json_path": [
