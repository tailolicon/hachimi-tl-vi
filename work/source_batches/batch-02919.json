    {
      "uid": "zhcn:cef4a9b97f9a361ca8eab091",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我，莱斯莱斯――\n决定不公开面向选拔赛的赛前训练！",
      "source_fingerprint": "d68a5bd6a7e1a9447bfaafddaade795e8dd20ac7dbc63336da792165433eefd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
