    {
      "uid": "zhcn:7a156e63831b8e1eddca9677",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要你愿意替我保密，就没问题。\n……我……相信训练员先生哦！",
      "source_fingerprint": "5cde74b57a69167fb43728e45adfbf479884ffac28d304a61000a0cb01cd697c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
