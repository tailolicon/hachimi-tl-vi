        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:58bc0ac0fd0877aa9c1ed402",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "选拔赛时，训练员也会把赛前训练作为招募参考。\n不公开赛前训练，就等于放弃这份事前评价。也就是说――",
      "source_fingerprint": "2346047ca671748279f4f6da875a9adfe6da051cca6a9746c3ed2c045041dbe7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103002.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:35ef0a6a6cc962d53e70250f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱斯莱斯",
      "source_fingerprint": "0eeda0f0ac51753df9a5de9baca9a93a1ad4d3c27a6ec2c8ef1c18d8635943b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103002.json",
      "json_path": [
