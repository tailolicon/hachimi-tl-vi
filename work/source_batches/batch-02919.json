      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当天，请只看我在选拔赛上的奔跑！\n再考虑是否招募我！",
      "source_fingerprint": "64d4deeebe7e249bd64b87752cc8d624ed5ed1513cbe6812c141abbd2cf6590c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
