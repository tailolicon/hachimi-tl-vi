    },
    {
      "uid": "zhcn:5875c08da42ea001a37f6423",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中坚训练员",
      "source_fingerprint": "44a34931cc602589e873be74227a6e41b3d1912d31684f0db4e6ce1da01bd519",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
