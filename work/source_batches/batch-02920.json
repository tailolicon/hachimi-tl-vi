      ],
      "json_pointer": "/text_block_list/13/name"
    },
    {
      "uid": "zhcn:b9acb95341c6dcb9efba7bd9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "承蒙厚爱，可以的话，还请让我按顺序听各位说明。",
      "source_fingerprint": "dbfe44375d67cc17b4dd32623ff0e4f95f3fc1c56e71d1b4335d8d8fceb9f4de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
