    },
    {
      "uid": "zhcn:48a166221a1723539649c9cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇哇哇！这些全都是来邀请我的！？咦，怎么办——！？",
      "source_fingerprint": "be238d06c27276c1775399c0e26db84dde43a4e3fa63716b68d4446411eac0cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
