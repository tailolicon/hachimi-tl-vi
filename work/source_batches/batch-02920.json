    },
    {
      "uid": "zhcn:bb601fa73371c4fb83769384",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱斯莱斯",
      "source_fingerprint": "0eeda0f0ac51753df9a5de9baca9a93a1ad4d3c27a6ec2c8ef1c18d8635943b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
        "text_block_list",
        18,
        "name"
      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:af63957f30b3bf8448fb3558",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就和告知里写的一样。我希望大家凭正式比赛的表现来评价我。\n……要是只凭赛前训练就被判定没希望，那我可受不了。",
      "source_fingerprint": "0914ca79b796dea904d20504f2adb6b1d6081ae5522f8653288ca573e5bc0d71",
