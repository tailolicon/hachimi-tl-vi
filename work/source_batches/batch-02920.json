    {
      "uid": "zhcn:0afae87ae8fab9f7514dcb26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正式比赛一决胜负，她就这么有自信吗？",
      "source_fingerprint": "2cba6118d3782d823cb3a0965f48f54118aae7284345ebaecef983ef46417d9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
