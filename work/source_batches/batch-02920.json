    {
      "uid": "zhcn:982d722b81b6265f1cf0a559",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正式比赛一决胜负，她就这么有自信？",
      "source_fingerprint": "09ecd04932f3d441650e92545cc837a674cfef5b1d1d0d3a3a9e3795afaa1d50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
