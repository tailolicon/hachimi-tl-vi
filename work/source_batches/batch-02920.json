    {
      "uid": "zhcn:e3e828d108fd15b477bb79dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱斯莱斯",
      "source_fingerprint": "0eeda0f0ac51753df9a5de9baca9a93a1ad4d3c27a6ec2c8ef1c18d8635943b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
