      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "追逐银影",
      "source_fingerprint": "e40e32a65ecc2dea89fe19f4c36f50988ad692193dfbbfec9e8dcdc4db6ce80e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
