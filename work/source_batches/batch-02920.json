    },
    {
      "uid": "zhcn:997dcbb846616b06f2deabd0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利奖券",
      "source_fingerprint": "cf9b1efecb14e46d153e2ddf7d077e5a0a9e0a4345e01355c5dc33bb97cfb15a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
