      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:7c57305cbee36bdf3d4fc037",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……有什么事？应该不是来邀请我担当的吧？",
      "source_fingerprint": "070e96098d5ec939dbb5566118e5c82caaf6c22cacc5b4a226d3ad069409a4cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
        "text_block_list",
