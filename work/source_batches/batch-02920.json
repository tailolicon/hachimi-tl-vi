      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果不那么执着，老老实实训练的话",
      "source_fingerprint": "8f8102a9a623cc58100e85a3a48fdeec1e8a94ac83b28310e402cf66495898d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
