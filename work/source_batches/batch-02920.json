    },
    {
      "uid": "zhcn:55bfb0de0383cafddb12dd52",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光",
      "source_fingerprint": "3b8fa7e9d29e8512dcd4f68f1ba91cc31eef66c9e56adf5ae07aa10a7856d013",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103003.json",
      "json_path": [
        "text_block_list",
        13,
