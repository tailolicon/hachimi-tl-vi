    },
    {
      "uid": "zhcn:73539c61b71756db129af969",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……首先，我想让担当赢下1胜",
      "source_fingerprint": "e206e9e63a5e2b3e9f2f5feb3b533769fdaf41774dd0e46ee3ba3d8deff00158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
