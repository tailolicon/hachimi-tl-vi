      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:ac79a948a1713414e8ea75de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我清楚自己的斤两。事到如今，也不会被客套话冲昏头脑。\n但在内心深处，我也不想以芸芸众生的一员结束。",
      "source_fingerprint": "e4c88fc4d4fc1aec7372e7494142a05128a5a0b16b298252ed31e191cfa4f77b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103004.json",
      "json_path": [
