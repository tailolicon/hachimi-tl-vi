        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:3e4064d67f1bdd298d0ea4f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "考虑到体面，我克制住了，没有把那份欲望说出口。\n许多人都会这样吧。可是她……。",
      "source_fingerprint": "37f2b758f567959b9cd641b50d34761deff375c42cfe742288a5dadecc5ed721",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
