    {
      "uid": "zhcn:2cd22a20ed7cfa49a48f6ba6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看着她时，我胸口总会难以抑制地骚动，\n无法置之不理——",
      "source_fingerprint": "c3ee9bf9fd41ec52af71989c010d1befc98d6b604618d44c81cb42eecf3f2d10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
