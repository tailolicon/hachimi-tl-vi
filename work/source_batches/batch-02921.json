    {
      "uid": "zhcn:5a321bead76f33d556c206d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是我的梦想。我的真心。\n……你觉得怎么样？",
      "source_fingerprint": "565d33998bdd73bcdb898d41f2d7b5e8511c2777b457dd3b6190af27d689bdf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
