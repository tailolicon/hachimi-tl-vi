    {
      "uid": "zhcn:373afb11d815de5d8fa25355",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听说你在训练员养成学校成绩很优秀嘛！\n<username>训练员。你的目标是什么？",
      "source_fingerprint": "4194a06f56a7eebefbfc493d5367d03f837da93760231eee72006799ae5d1e74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103004.json",
      "json_path": [
