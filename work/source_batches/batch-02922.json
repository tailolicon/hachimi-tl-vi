      "json_pointer": "/text_block_list/39/choice_data_list/0"
    },
    {
      "uid": "zhcn:dfd942782b6be30cf5c2cb8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我向你保证，一定会引导你成为“最强”！",
      "source_fingerprint": "52f878a0fe73ac090aaddba1b94f55f42747b4f3d585262aa9198976c3854c6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103004.json",
