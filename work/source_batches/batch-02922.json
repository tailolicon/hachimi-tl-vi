      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请让我支撑你的“最强”之梦！",
      "source_fingerprint": "bb25398162707e61768e66c1ebe8fa4d96fbe0633c75389b98dbb9f9bef345eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
