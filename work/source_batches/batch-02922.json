    {
      "uid": "zhcn:a7ee8448474a2c254f802a2e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我保证，一定会引导你成为“最强”！",
      "source_fingerprint": "2f500a8c82360fe810cb7e4a235365feacac1f76699b4863071f6e6899c73553",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103004.json",
      "json_path": [
        "text_block_list",
