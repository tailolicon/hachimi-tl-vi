      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:c28e369b349923814322120b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果莱斯莱斯能够成为“最强”的存在——\n她一定能给予那些和她一样的赛马娘希望。",
      "source_fingerprint": "3a27a37785f0119579c668d2d9eb15ec725ff567604a599705f762c9b67edf32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103004.json",
      "json_path": [
