      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:3bde71edefc19151cbb7b6e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "凭她的头脑和自我包装能力，只要以SNS为立足点，\n她应该能亲手开辟出一条成为被传颂之人的道路。",
      "source_fingerprint": "8bdf70e5792ef8247fdec8aef5dc17200d35ddc148a20e56d00074c491e083cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1103/storytimeline_041103004.json",
      "json_path": [
        "text_block_list",
        40,
