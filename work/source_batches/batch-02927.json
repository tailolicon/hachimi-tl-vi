      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……\r\n如果是一致的存在……就应该“追求”。",
      "source_fingerprint": "ff056483859a6ff07b8b86346d0c38446bcabe436486527ccc03fd19799f4b73",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
