    {
      "uid": "zhcn:2dbcb3f3cce4e8c8ed8da1f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为……新宇宙很『中意』此时造访的音阶。\r\n与其产生深层共鸣……让人『安心』。",
      "source_fingerprint": "9d248ad65c1221e9f0779297170de7420a66f403629f5b983b73e251e33c8c59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105001.json",
      "json_path": [
