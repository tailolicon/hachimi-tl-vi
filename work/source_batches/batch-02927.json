      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:ff7c52bf7d6da712130721e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她似乎想诉说什么。\r\n但是，她却无法用我能够理解的语言表达自己的想法。",
      "source_fingerprint": "d2d34c327ec198d2885051b6df187ce6df1f007c733950f5827e982fb89c1060",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105001.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:bca474f125a16fc7193aa18a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个有着马娘模样的少女“新宇宙”，\r\n到底想做什么呢……？",
      "source_fingerprint": "fad2b73d0b1e0ea08b6290634b1c3b697d105f020cf8a40c064833f118d09c43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105001.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:878242b55798d546f44114eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105001.json",
      "json_path": [
