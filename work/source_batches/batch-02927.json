      "source_language": "zh-CN",
      "source_text": "我所看见的是——",
      "source_fingerprint": "dc82f89ecb6b96b68f08b47520189a58c00cdf13b775407f1ec412637c5ed77d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
