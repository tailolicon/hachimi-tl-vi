      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:ccdb776f8d5f46d04e13847c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这声音是……从天台传来的？",
      "source_fingerprint": "016690efd0ee550224ad302ca090e5d46cd38afaca661d514c8c7f9983c463bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105001.json",
