    {
      "uid": "zhcn:72dda697ef7adf836d23ee92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这声音是……从天台传来的？",
      "source_fingerprint": "016690efd0ee550224ad302ca090e5d46cd38afaca661d514c8c7f9983c463bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
