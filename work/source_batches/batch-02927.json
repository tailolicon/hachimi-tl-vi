      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对“竞赛”的观测……\r\n不……包括更之后的“永恒”……",
      "source_fingerprint": "0333ae6b10ca83f9d917000fbee37ca451f31090c27e118d419111efafbbd732",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
