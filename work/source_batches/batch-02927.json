    {
      "uid": "zhcn:f118ee55e66c962f25618516",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“观测”……失败……『？？？』……",
      "source_fingerprint": "ff278de0922fdef61a1986924f79542eccde88e3ff54d687763bccb791dbfb61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105001.json",
      "json_path": [
        "text_block_list",
        22,
