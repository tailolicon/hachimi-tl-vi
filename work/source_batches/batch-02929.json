    {
      "uid": "zhcn:f32306a53189b49c12545f17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，我从没看见过她穿制服的模样……",
      "source_fingerprint": "429d54b92fc82ce49750bc4e2d04e5d2861f22f19328985e70506204b7585b61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
