      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:7edfe5e173fc3f7b1f4ac33e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没事，在想事情而已……",
      "source_fingerprint": "536f10602c1ba71aff5851a009e3b0098636055d72edcafdfc8c5a24a97335b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
