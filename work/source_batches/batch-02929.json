      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄，你了解她吗？",
      "source_fingerprint": "d9dda3cec9bf7a3690bcf3adda18980b1e24f921760479f13c3218dea8628b28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105003.json",
