      "source_language": "zh-CN",
      "source_text": "已经……“拥有”……",
      "source_fingerprint": "beff5feb3595659bc5e7a6e653518b7034e3becc956b508569d54ac1def67e6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
