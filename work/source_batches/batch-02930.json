      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比如说……",
      "source_fingerprint": "58f24968afee7edc2a2fe62e6244136a80a3478ed9829ce2442a10ef283f1bab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
