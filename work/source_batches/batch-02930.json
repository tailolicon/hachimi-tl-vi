    },
    {
      "uid": "zhcn:2157e9b7a25c0b25703bdc28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她总算是说出了一句我可以理解的话——\r\n她希望能与我交流。",
      "source_fingerprint": "241f5cb08f8dd5c9a6f081581aa11694120bda7d77daeaf3b554408d8fa612b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
