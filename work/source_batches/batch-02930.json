    },
    {
      "uid": "zhcn:929f8f32edddc1717d8d0202",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我能帮上你的忙吗？",
      "source_fingerprint": "37a4cc2c2395dade0ba5d4d5e02b79f02ec0d52d7f25ee4f10e51e923cbf9894",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
