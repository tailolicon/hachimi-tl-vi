    {
      "uid": "zhcn:ad503ee19a5f6585acda03ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙……仅仅想要“追求”这些……\r\n但却……“STDA”……",
      "source_fingerprint": "74cec7f784cb2b80d1c1b5cc58b929d14ca71ebcdfbabcb9b35768a69cc5bde1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
