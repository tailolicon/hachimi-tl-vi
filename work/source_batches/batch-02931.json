    {
      "uid": "zhcn:51154215824ddbc148870b82",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……说对了么？",
      "source_fingerprint": "06441a774918572cf4dbfb6d6ee80d69cab5bf3e242dadeaa4f2089972bbe14d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105005.json",
      "json_path": [
