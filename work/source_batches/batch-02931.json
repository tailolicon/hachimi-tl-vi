    },
    {
      "uid": "zhcn:1365ad11ba5d64c5e7627c3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说对了哦……",
      "source_fingerprint": "36ee50a52a641d07a08c36f1190007f8fb9dc988e027fb035a658e78af9c15f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
