    {
      "uid": "zhcn:68e02b84c1f64c861d8fe028",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您是“养成者”……被称作训练员的存在。\r\n是让新宇宙“乘上轨道”的『人』。",
      "source_fingerprint": "fd6ff375d6875574bfc8975e600f5579df8e5719c648cdc211bb32570f103e49",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
