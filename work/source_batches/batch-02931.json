    },
    {
      "uid": "zhcn:a71626b93279bd775b70471e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………",
      "source_fingerprint": "b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105005.json",
      "json_path": [
