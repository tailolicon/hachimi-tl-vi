    },
    {
      "uid": "zhcn:687b2e1320782967899502eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你……你要不直接过来吧？",
      "source_fingerprint": "284e5d6486d87115f7525df43121f4569e2d93e4571a4e85d22860c1d255fd6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
