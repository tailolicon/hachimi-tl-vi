      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:6e9fe52dbd7760d9a797c5f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙如此宣告之后，视线仍然锁定在我身上。\r\n……虽然还是很难从语言来理解她的目的，\r\n但或许从行动来了解她的想法也不错。",
      "source_fingerprint": "bf616986d6a3197e125beb152e063f9f30cc3430d6f803f35a71ff64be6cc4f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
