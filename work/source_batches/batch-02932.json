    {
      "uid": "zhcn:2d775594a95c922e73fd3ab4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。『过来』了哦。\r\n……会在您身边，继续观测您。",
      "source_fingerprint": "acc9fb1d5633e3610a713968141475633c644ac0f282a90bf63c121b1ee1872a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
