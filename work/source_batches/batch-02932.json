      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就……Affirmative。\r\n……请您『多加关照』了呢。",
      "source_fingerprint": "5b759cf4f14bd383e1c3e7fba623d931fd9f0d316e5a185aea8c36605d9b8edd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
