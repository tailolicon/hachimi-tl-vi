      "source_language": "zh-CN",
      "source_text": "……“Psc”……把嘴巴……伸出水面……\r\n需要“补给”吗？",
      "source_fingerprint": "b261ad353f7f2c300f7500043f2306244b3d36a0c7e5bf94e725256eb27e1afb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
