    {
      "uid": "zhcn:07985b3c7bfc18d3b6a542aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她仿佛是害怕错过什么信息似的，\r\n满眼不安地紧紧盯着我。",
      "source_fingerprint": "5bfc055bda0ca065af0fe41e4817f6e19e2b13dd5ccda58e9e2ec769a7063f18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
