    },
    {
      "uid": "zhcn:45428274ac7927dd657e3d05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就按平时那样——",
      "source_fingerprint": "9ce3cd76d73c9a06f48eed46c895174af6f755d25633952c13c8abad2b92885d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:abf2f7c37b3c61449b73990f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你还想去哪儿玩吗？",
      "source_fingerprint": "08b1c310f634309ac334be5e8db3dd00dec25cb4438e61d93eadd7c2ef2fa349",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
      "json_path": [
        "text_block_list",
