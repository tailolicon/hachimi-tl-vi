    },
    {
      "uid": "zhcn:bf87f6a5d0a4583116863e26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙将面前的鲜榨果汁饮尽之后，突然提问。",
      "source_fingerprint": "72e341722cf777f6dc8d81ecd3deeeb95ce5f469ce034626bca84d29f38876e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
