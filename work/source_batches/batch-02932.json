        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:82217a6268a5c97a5beb3415",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然她不愿说，那我也没必要继续打听了。\r\n我们离开商城，继续散着步。",
      "source_fingerprint": "3164817205785aa51df5958a107dfa948f940c60e39bde385aa6b076445a18b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:321d368d3a2a8e0a85950c4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好，咱们找家餐厅吧！",
      "source_fingerprint": "14c6cde7aa71a29c8dde31a01529597fdbc662525680ccc89f98ead3ede9dfcb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
