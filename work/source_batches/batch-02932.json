      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说起来，从第一次相遇的时候开始——",
      "source_fingerprint": "3d6a4e70071e3eb15244ab8a1ed605d7f1b6d65caf512346c277632bbc52f7b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
