      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:7e679c750d0112213f3e46e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在第一次见面时，她身上的气质便让我觉得……\r\n她明明近在眼前，却如此触不可及——",
      "source_fingerprint": "381c57ba3ae10f96ac9beb782f69d62ed0921c1e3c7e729c11cf4a9bcded9345",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:2b67685abe2c0024e24ae29f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等工作终于告一段落之后，便到了午餐时间。\r\n在学校餐厅里吃的话，还能和同事们一起交流一些情报，\r\n顺便聊聊天……",
      "source_fingerprint": "123beed611202cd166adbaa0dbf500548b769a04d0ffc229684be35957dcef50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
