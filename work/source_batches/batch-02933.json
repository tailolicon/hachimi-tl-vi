      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天玩得开心吗？",
      "source_fingerprint": "e9a8f330131a6271d1704c26e9a065c60db5b6b982fd7f088c55bde5fa2c20b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
