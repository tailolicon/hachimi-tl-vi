    {
      "uid": "zhcn:cf74cd7a078ffd523d5cd69d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………新宇宙……没想过『开心』……",
      "source_fingerprint": "8f89b47cd307c596afc5a8688c5c57a1f34ba62dd2250dfd19005b7daafa9645",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
