    {
      "uid": "zhcn:6f47ffa9800dc4cae5542d4e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这样吗。",
      "source_fingerprint": "3064ceab53b6c5f3d0e0d8bf39d8b50792d4c598627c5e39d569684f0d4dc57e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105006.json",
