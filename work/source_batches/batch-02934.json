      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:684a4d4b75eb057af7622d6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我是说，以训练员的身份在观测！",
      "source_fingerprint": "1eec635970041ad2d6d1a9d74f2dc4c490713601f8466a6eab3a10850d97797d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
