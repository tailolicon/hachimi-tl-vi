      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:51c59be7f118b73a1dded344",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "按下遥控器上的暂停键后，\n影片也随之停止。",
      "source_fingerprint": "04151e121efddc7344b80c31da421ffdb0d81d7e39042489adcb9aeef3f330e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1106/storytimeline_041106001.json",
      "json_path": [
