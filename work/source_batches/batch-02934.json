      "uid": "zhcn:508b7fad4281ecea5e332461",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……",
      "source_fingerprint": "fbe9b8a6562528c71dac2f35e4bb3503757fd80fd15a323c0f3842922f08e2da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
