    {
      "uid": "zhcn:24677987c3f97e3c37cd87f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实呢——",
      "source_fingerprint": "90d7babf579756e93c0f4b8c738ad08ca2fd81bf4d0d066e7244aca11526f912",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
