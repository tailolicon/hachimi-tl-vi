    },
    {
      "uid": "zhcn:c4a31ef8cb9d1208e9670053",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我向新宇宙开了一个玩笑。\r\n我告诉她，“我也在观测新宇宙哦”。",
      "source_fingerprint": "ab2de4faf8c586bede04f0bb7ce048bda7d04baf459bc4a4e8aeb0b0eea1025e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
