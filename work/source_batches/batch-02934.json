      ],
      "json_pointer": "/text_block_list/47/name"
    },
    {
      "uid": "zhcn:659479dd7134e7fcb3199e91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……新宇宙，就在这里哦。",
      "source_fingerprint": "6d6137e4782af0bbc6e8e24012c74afaa4372b906c29407a810f46d86eab3fa7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:a7b7d7ba0330d366cee7d775",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……谢谢。",
      "source_fingerprint": "9ac818ccb0e8089349de1a330b5b5174d029206740e791653051d1392dec2d1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
      "json_path": [
        "text_block_list",
        48,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/48/choice_data_list/0"
    },
    {
      "uid": "zhcn:da6359c37e34d4fde569943f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙仿佛是要扶住我一般出现在我眼前。\r\n她眼神飘忽不定，透着一丝不安与期待，\r\n仿佛是在观察我的反应。",
      "source_fingerprint": "2e5a07bdc1972e9771781742267cb88550455c9c5ec44aef951632244e539625",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
