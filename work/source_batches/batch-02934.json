    },
    {
      "uid": "zhcn:7f1bc4abd93890ccaea48880",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在……“观测”新宇宙……？\r\n训练员吗……？",
      "source_fingerprint": "8c777ff03360908e5641ea21c6ef6585f551bed9843749aafe1086a19cbc04f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
