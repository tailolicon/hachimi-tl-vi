      ],
      "json_pointer": "/text_block_list/7/choice_data_list/0"
    },
    {
      "uid": "zhcn:5cb1d8f44761d72eedc1dedb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1105/storytimeline_041105007.json",
      "json_path": [
