    },
    {
      "uid": "zhcn:c483e66c543221f510da6f38",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呃，你还记得啊……！\n那个～我感觉现在的状态还不错，想再去跑一圈～！",
      "source_fingerprint": "9998d72426e54339bc57ea9f4726907f3c0a40f667d55ce4b6cd83cd0b3d5235",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1106/storytimeline_041106001.json",
