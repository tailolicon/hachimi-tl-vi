      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:78bf20bd5de64874168ac60f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼、呼……好耶，我赢了！\n按照约定，回去的路上你要请我喝蜂蜜特饮喔……！",
      "source_fingerprint": "d7580a58f5a7375bc240e45696d1552398cef940ce7e4d6a4ec8d9519cf16409",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1106/storytimeline_041106001.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:df2f3ed2d7a93b30d9a1c4c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "悠闲的赛马娘",
      "source_fingerprint": "95d639042f72ca6f2881171999cfd542c110ad8cbd4d324630df41423cb0650a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
