        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:e0ec1f90f4c8169df28522e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那位赛马娘在并跑练习结束后再次跑了起来，\n她跑得比刚才还要轻快……而且跑得很出色！",
      "source_fingerprint": "3857dc08703e84fe9e232ef2b5d03429a8cca322ffd5a2db90d786e5e9d7896e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1106/storytimeline_041106001.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:99dcc4f981bf09a7aff5b238",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "难得跑得这么出色──\n却没有人在关注已经做完训练的她。",
      "source_fingerprint": "80fc865975f4299722341ff18f5abfde92d1745056a70a3df7a43158f8281172",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
