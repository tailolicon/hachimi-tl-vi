      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总觉得有其他令人在意的地方啊……",
      "source_fingerprint": "d27c83c64e9e157e7312ba54a101232a49ed97413789a5d40aebfaf485b47f7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
