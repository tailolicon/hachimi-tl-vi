      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她的体能果然非常好。\n我决定之后要抽出时间再来看看。",
      "source_fingerprint": "734c24333757f41a19ca6bb56ed3353c99285ba5c0d26cd01d8f783e3b6fadd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
