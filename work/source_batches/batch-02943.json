      "uid": "zhcn:f5f72d197cf20c71ba523190",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实根本就不需要什么谢礼。\n光是知道她想要回应我的期待，就让我很开心了。",
      "source_fingerprint": "9eb32e69af1dd6b78c3102c7f107bd2ae6cb224810d151c82acd822be0f4237f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
