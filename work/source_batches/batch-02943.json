      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且那根本不能算是谢礼吧！？\n有需要的话，平时就能增加训练啦。",
      "source_fingerprint": "51836843d69bbc0a32014fd3c15ea32035e6d4700d9b31f7bd6ee1da31258796",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1106/storytimeline_041106007.json",
