      "source_language": "zh-CN",
      "source_text": "这样的风评以及能够证明这一点的比赛结果，\n在历史上不断地积累，使其俨然成为了事实。",
      "source_fingerprint": "c9ef3d14fddbdc504d6780c657e7cf31e387bb9c67faff1539b038b79aeea59d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
