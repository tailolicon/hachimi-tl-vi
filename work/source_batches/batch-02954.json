    {
      "uid": "zhcn:cbb646044d397d73bf936f57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？怎么了？",
      "source_fingerprint": "ce00b911dcf20729db413bd78ee32bec31f148ea81d8bcaa6db7a6d1d7345007",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
