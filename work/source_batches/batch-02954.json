    },
    {
      "uid": "zhcn:ea3c3d675c79f573e5c64fba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "资深训练员A",
      "source_fingerprint": "c562a69cc80221d7226c73b0d8845c937fe686b8cb2fc46366892017d0bd14c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
