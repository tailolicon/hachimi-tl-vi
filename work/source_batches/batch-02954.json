        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:f2f8baf07121b1ee8f4a2fca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "手一滑，打翻了喝到一半的杯子。\n饮料在桌上扩散开来，从边缘滴落。",
      "source_fingerprint": "5633aaa7557edb9cf65624d87fd411e1c0694270fafdc72be5b365c64f50986a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
