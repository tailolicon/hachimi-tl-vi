      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:a7c8407f6b54fbbb3f36bc3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曾经遥不可及的她如今就在眼前……。正当我苦恼着，该如何向她开口时\n桌子和外套便已恢复整洁……。",
      "source_fingerprint": "e6204a73895eee09ee5837ceb245c2c8a432b099e1e60a8b5395f6a9a42675dc",
