    },
    {
      "uid": "zhcn:91995081e9aab6e2f524a97b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多么锐利的末脚啊……！！",
      "source_fingerprint": "e11ae08b84a1142ecf45993adeb0bba94164a92ef001c03a52e9dd0fd1f70826",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
