    },
    {
      "uid": "zhcn:8e03d759185f03e4a997b167",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊。之后找时间好好聊一聊吧。\n指导方针我也会在那之前准备好资料。",
      "source_fingerprint": "a652c0f841f837a2ace0d776f01159d1ad1e31b1fca1c11bda24b247f53f5cb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
