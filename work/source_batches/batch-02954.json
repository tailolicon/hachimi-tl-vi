    },
    {
      "uid": "zhcn:5660725f17895b01bb1b58fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是莱茵力量和勇敢之心！\n两人都占据了好位置！",
      "source_fingerprint": "17b0be9056b715e8716c0a488adb47ad1fd649b8045a676a15cbb082558c096f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
