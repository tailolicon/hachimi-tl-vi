      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ca704525ca46c52957800f2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "资深训练员B",
      "source_fingerprint": "c4df92ed2a7c596de1ab1aead46e4c6d69f9bc4859a1aa0a600d279bf3a7db93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:230265d8879275d30b6c3276",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥同学，请让我成为你的担当训练员！\n后冠路线我有经验。绝对不会让你后悔的！",
      "source_fingerprint": "1611d40df48817f64a5e4c96ae8215c55407a2f1817c9c38d29d5c22473981d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:dbc43ded78b7cf23d7c2f34d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
        "text_block_list",
        21,
        "name"
      ],
      "json_pointer": "/text_block_list/21/name"
    },
    {
      "uid": "zhcn:1d5516b25853df1eafdbdffb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "承蒙各位热情相邀，在此谨致谢意。\n我也希望以签约为前提，进一步了解各位。",
      "source_fingerprint": "27d3e6970cbd75246c33fcffd41c55a4dde0cac000f601158e36ca07950dd96f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:b092c4a436c0c7ac53d1d986",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
