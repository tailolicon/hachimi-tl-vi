      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "结果还是没能搭上话啊……啊！",
      "source_fingerprint": "4d30742a2da440dbcafc6c948eaf4181e79423653431c318459db4171f4ecbd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
