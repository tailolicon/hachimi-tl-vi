      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢！西沙里奥，好温柔～！",
      "source_fingerprint": "74c0aa4209a9010ece2d28a8f48470ed1577302de48e5b85ded13749b868ab43",
