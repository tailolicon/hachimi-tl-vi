    {
      "uid": "zhcn:48a16056368855c87c2118dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您也要休息一下吗？\n我有带毯子，可以借给您。",
      "source_fingerprint": "521441e057acf828849ef834a32f41b04b60baff30944c86e79ec5f51912496a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
