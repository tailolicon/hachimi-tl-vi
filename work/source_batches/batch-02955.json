      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:0dfe010e815efbd28be3f11d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥将我伸出的手，用双手包住后用力按下。\n这突如其来的举动让我吃了一惊，但痛中带着舒畅的刺激令头脑清醒起来。",
      "source_fingerprint": "86bd380e71c0cc89a681d7efec51f7f93a37c9a052b883696b33105cc8ce8440",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
