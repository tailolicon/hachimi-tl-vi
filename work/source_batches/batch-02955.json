      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:5c27add215f42a211c9ef92b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这场比赛，到底谁会胜出――",
      "source_fingerprint": "ca8936034d8fd6ff699e308d117f329cf1c37d1e00ff9a094e9fada7efa7bb5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
