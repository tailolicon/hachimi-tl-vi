      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "照料她们的似乎也是赛马娘。\n大概是在这一带活动的培育俱乐部。",
      "source_fingerprint": "b5f69cba9084c3834104ae752b2aa84b5cfa6d2228151211272aea470bff10aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
