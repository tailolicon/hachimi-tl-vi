    {
      "uid": "zhcn:d085f94c15b30786c2798636",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
