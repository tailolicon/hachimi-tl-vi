      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "按压这里的穴位，就能缓解疲劳哦。\n觉得有些累的时候，很推荐您试试。",
      "source_fingerprint": "6d4184c8013b1d2f368fa7af8abc7dea2d37d85c7f45a1fa52dda571b08b258b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
