    {
      "uid": "zhcn:38938d6d98532738e575868a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是吗……。那么，能否把手伸出来？",
      "source_fingerprint": "b59b273cbda89943fb329c09f5642a3d3ce7cc4ec0f6171e014dc5f608648fff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110001.json",
      "json_path": [
        "text_block_list",
