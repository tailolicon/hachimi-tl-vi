      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:8a400cb5879be3e8cffaf5a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "险些就被她圣母般的微笑牵着走了，\n可我身为大人不能在这种地方睡觉。于是慌忙摇头。",
      "source_fingerprint": "e606394b132e855e754720bae77fd3fea10cd74e95547e4c5af49deb4da8c8b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
