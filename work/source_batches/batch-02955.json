    },
    {
      "uid": "zhcn:3ae74bb6ee986abd140d899e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "脸庞，只有一张。声音，也只有一个。然而表情，却有双重。",
      "source_fingerprint": "3d3eb1bfba2e15b3e5daa8089833d5f65fa9749ddffced65e86ba5df064a4409",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
