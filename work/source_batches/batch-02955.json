      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:c27c2ded4848f0f161dc48e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正如早晨与夜晚合而为一才构成一天，这两副相反相成的面孔才是她本来的样子。\n面对这样的存在，我又怎能不被吸引呢……。",
      "source_fingerprint": "9e5e63aab468e423947e47f0b8ada5625132c8e6fdcc4d94ed4ae30746dc1e58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
