      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:a8854e6cb5fe8852a67227d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。大家都是这样，在某人的引导下成长为独当一面的赛马娘。\n奔跑之姿如大河般代代相传，实在令人崇敬……。",
      "source_fingerprint": "ef0cfe524f98d515c5bff40916fa4e958a9d9acc5109764dde6f96fa87a71a54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:87c28c96d8b7370f693d97a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得你很适合呢",
      "source_fingerprint": "df35ccc07dd7a87592bcebd611343e01d8df92f3d1f29fa047328878212408a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        35,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/35/choice_data_list/0"
    },
    {
      "uid": "zhcn:ca242527aec3aa487c8f5bd9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
