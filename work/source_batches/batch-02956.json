      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:c9ba21bcd0f04a0754559e39",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在学园担任学生会副会长，经常看到她在台上讲话的身影。\n在校内遇到时，她也总是被人群包围着。",
      "source_fingerprint": "9361d899bcaae788cd93ec31f0af37d35d44c68c2dae02222dca7f2b88c0b1f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
