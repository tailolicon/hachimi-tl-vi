    {
      "uid": "zhcn:afabcb56e3bd752b2bed8291",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没想到会听到这么重要的话题，\n。老师『这两个字』，竟承载着如此沉重的分量。",
      "source_fingerprint": "3145d35472835d71a60273b7034c0a941da52a6e05ac4e13fcf24c77d56270d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
