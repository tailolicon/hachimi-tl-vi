    {
      "uid": "zhcn:1c8978698aa7af07373dbd72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回想起来我也是如此。从『老师』那里继承了奔跑，\n才终于能够朝自己想去的方向……好好地奔跑。",
      "source_fingerprint": "e7a0a52a5f5d5939d3fab4fe3c03babd208a55dfd86dd6d998d2465ff837389f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:826937c004ed68f3932d4c6b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
