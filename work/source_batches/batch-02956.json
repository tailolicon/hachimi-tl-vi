    {
      "uid": "zhcn:e0ff0490912261cfa0459127",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "循声望去，西沙里奥正和一个年幼的少女开心地奔跑着。\n仔细一看，那孩子有着赛马娘的耳朵和尾巴。",
      "source_fingerprint": "bc2feb764fdd51fc57e2fa3bbafda5ee311ccfa235c8050c2ab411ba1cefac4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:4af57c8725074e2dc0ab2f7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "难道是……梦想？",
      "source_fingerprint": "621fca4d5e24d6d6cafa75b079b4491a6808e9821a4a12c654f16c62c5673a26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        30,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:171616bb9a8ef66519d6ac4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
