        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:b7cbe332727bcabe4bfa9e96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        37,
        "name"
      ],
      "json_pointer": "/text_block_list/37/name"
    },
    {
      "uid": "zhcn:c6b04635b7548fd5982a8ddf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她能高兴成这样，足见那份憧憬有多深。\n话说回来『基石』啊。选拔赛后她也提过这个词呢。",
      "source_fingerprint": "32d49bd37a5014cdfed2498c7f3ededd703fd40136a2a3745c385df635987929",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:4d5f073f590670af35285497",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        38,
        "name"
      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:7f19337d31addd297cd7b951",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就是，成为未来赛马娘的基石――\n因此我，为了展现器量，必须在比赛中获胜。",
      "source_fingerprint": "c845e48561b011c2acfd57af2c8a6bcccbee1245777c7351d4fe5e0390a778b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:dea737d803a77961fc43b634",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110002.json",
