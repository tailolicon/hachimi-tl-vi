      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来那句话，是说她想成为『老师』并引导许多赛马娘。",
      "source_fingerprint": "a25dab78258cb109a2463b9ff54c16f8956ed80adfa58ad7a0c3a268505af48f",
