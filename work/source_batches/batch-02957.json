    },
    {
      "uid": "zhcn:8e20c8e6eaf5923de9c11285",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与西沙里奥分别之后，心脏仍在吵闹地狂跳。",
      "source_fingerprint": "487a19401e6ce61ecb03a80b3c33ddcae60922957eecf24665c0b8ebc0a1dd2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
