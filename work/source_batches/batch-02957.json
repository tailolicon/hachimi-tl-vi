        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:196592036ec8ff09015c0f0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（『伙伴』……吗）",
      "source_fingerprint": "77a4d8d10898533b71563f3d4c75b108889a34b29e74de031ff416a515dbdc43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
        "text_block_list",
        34,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/34/choice_data_list/0"
