    },
    {
      "uid": "zhcn:fc26debb7cb81d7d85911f8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那般伟大的梦想，我想用这一生来亲自实现。",
      "source_fingerprint": "148fd10bb10ab0d0351acdc476c1d9e02a2b7d7575996e8dea19919f2aaa5f50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
