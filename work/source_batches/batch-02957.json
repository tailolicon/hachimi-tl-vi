    {
      "uid": "zhcn:f8149c8cf42fc4fab6471d39",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "换句话说，就是可以被称作贯穿一生的『伙伴』的存在。\n想请能让我这么觉得的人，来做我的训练员。",
      "source_fingerprint": "7143caa35c41148e56f4b808f3e07f6b481871481556851569d4a553a25e24ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
