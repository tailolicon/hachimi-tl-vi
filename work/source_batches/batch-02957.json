    {
      "uid": "zhcn:b2d2aad7ee59966c1db580c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的，我很清楚，这是个宏大的梦想。",
      "source_fingerprint": "b71f3401b4cffec8c699d324566180d3aef3287fb96da385107464d5efe716ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
