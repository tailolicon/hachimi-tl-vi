        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:8f0f32ffeaf215a00d7c33af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她进入状态了……！！）",
      "source_fingerprint": "fd1df64ead4dda9e854cccf62bcc217da01bd038f3338eea7ac0933d773563ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
