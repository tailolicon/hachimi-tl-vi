        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:8efdec3815ce04e314ef79a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这并非单纯成为前辈，而是成为『基石』的第一步。\n要实现这份展望，就必须一步一个脚印地前进。",
      "source_fingerprint": "1e3cfb9d97680f46effc0ac3aba7e1d951928959e2f27fe973ea55d3c305b047",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
