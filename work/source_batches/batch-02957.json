      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是……和西沙里奥在一起的训练员吧。\n跑得上气不接下气是有什么事？",
      "source_fingerprint": "f79463e76bd5ec008afb8dd4df86fd68a9ba1037147417e89e6dcbede4428ac5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
