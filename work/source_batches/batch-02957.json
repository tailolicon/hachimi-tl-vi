    },
    {
      "uid": "zhcn:9ace05f675ed119e99f28c11",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正如您所说。所以……我想慎重地选择训练员。",
      "source_fingerprint": "72069dcfb997bc514de9495fc0d51386c01f569c027a2bf83583bf770098d1e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
