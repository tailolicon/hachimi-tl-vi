    {
      "uid": "zhcn:a586d749ec1036edcff6be6b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使一个人的梦想很小，但这些梦想汇聚起来\n就会成为伟大的梦想。那真是一件……非常美好的事！",
      "source_fingerprint": "c9330dce382c7140a75a19d51da4fbfa3cf1b6c3153977a59aafd52c1394dbc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
