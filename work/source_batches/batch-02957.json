    },
    {
      "uid": "zhcn:be32d5ab16de99c636eeae4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………大鸣大放，你的成长真是惊人啊……。",
      "source_fingerprint": "33e679718402cfe85f25badc31ba4d90a9d6961a5490c969812aa920367e01bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
