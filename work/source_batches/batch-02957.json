        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/29/choice_data_list/0"
    },
    {
      "uid": "zhcn:4f02d0e185148a8f99c014ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……『也就是说要有足以成为』基石，的器量呢",
      "source_fingerprint": "a153d136f8038335f5932fea7ae94ba805ad33829efcf34177d1f59559e5e5fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
