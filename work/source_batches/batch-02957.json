    {
      "uid": "zhcn:ceae7cf555470935e2a83061",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "过于争强好胜这点，从学生时代就一点都没变啊。\n不过，这才是大鸣大放吧。",
      "source_fingerprint": "a48bf8112b879577d7422aa49156cd68d4ee1fe52b1c82c541d3ea23cd622f66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
