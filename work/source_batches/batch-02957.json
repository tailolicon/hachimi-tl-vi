      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:505b8e66be15a612654827eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但是，这里亮如白昼）",
      "source_fingerprint": "7bff2a4a2053f92ecef28fe9952a6dfc09f19d23b5436ae1f42b0c657f513439",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
