      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥所憧憬的人……她的话！",
      "source_fingerprint": "35365c35363c77662c44937a8e087bcffd0538057d056060be6be45f7b5b9ff2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
