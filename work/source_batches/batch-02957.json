      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:f7ec556f6f9a93bb3d0cbed7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后还要去训练对吧？\n要不要久违地一起并跑一下？",
      "source_fingerprint": "0f5f79349e0d95ba48c86ff6d1f30af29f1478237f1143065dda3191d8c62aba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:f8a92df2b6dc57fff36badee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她曾多次表示，为证明自己的器量而想赢得三后冠，\n尤其想赢下『橡树大赛』。",
      "source_fingerprint": "5dcdd828c9e910e60973491c54f58fcc9e8c3cfc6ad1a1e08fc5c7dede871785",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
