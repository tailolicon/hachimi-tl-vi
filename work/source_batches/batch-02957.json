    },
    {
      "uid": "zhcn:a04fa325edce1f780268a979",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不仅仅是能够指导我在比赛中展现器量，\n还能够贴近我的梦想――那样的人。",
      "source_fingerprint": "f2f3a9f7410398f88d113a7f150412032f0e12db56e5a9151b36ba10fb33cfa6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110003.json",
      "json_path": [
