    {
      "uid": "zhcn:93a49f1a3e39d9a1e64e7ae6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……？是什么意思呢？",
      "source_fingerprint": "ad001c017f0da190df250ce86cfd20f2f3e3eb5ef9db6f524c95aac2769fd1ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
