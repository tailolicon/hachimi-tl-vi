    },
    {
      "uid": "zhcn:c393e60093ce0873f6d61a93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那正是――我所追求的『老师』的形象。\n在后冠路线上成就伟业，展现作为指导者的器量。",
      "source_fingerprint": "f67646577629362defcde245f5db5a7f09f253e0449640097b1ebab96c4cfbbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110004.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:28bdde3c0071a3c4c505b196",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110004.json",
      "json_path": [
