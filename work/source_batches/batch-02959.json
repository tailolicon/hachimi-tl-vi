    },
    {
      "uid": "zhcn:9740535cd30b80e5499b37b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。但是，达成并非易事吧。\n训练员也亲眼目睹了才对。",
      "source_fingerprint": "f53068293332126e2cfd19e6ce504353aa69fda9a0aee8706ba49987056ebe78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1110/storytimeline_041110004.json",
      "json_path": [
