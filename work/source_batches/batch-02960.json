      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "望着开心的西沙里奥，我心想。\n自己也要更深入地了解她，让彼此更加信任――我如此期许。",
      "source_fingerprint": "533707354d8b818917a78def38967d0c64af6b12bb641880547b26a71076ed90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
