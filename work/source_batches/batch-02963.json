      "source_language": "zh-CN",
      "source_text": "而后赢得光荣的胜利，证明我拥有成为『基石』的器量。",
      "source_fingerprint": "272a721e75ff6fa64a3f34b63d794138c392d3728405b3ddc243d807507931f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
