      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊。我一定不会辜负你的",
      "source_fingerprint": "a57babae334cec366ac0a425c21f151997f3b12fcadc1c211cf9006e066d688c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
