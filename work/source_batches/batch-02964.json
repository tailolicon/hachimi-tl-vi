    },
    {
      "uid": "zhcn:7f074163b9cb085bdffb3a6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "差一点……是吗？",
      "source_fingerprint": "e829892aff9441b69d398fd75cdfa71425bac987bdec13840bad6f98fc6cc8d4",
