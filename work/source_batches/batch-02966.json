      "source_language": "zh-CN",
      "source_text": "我并不出类拔萃。也没有惊人之举。\n朴素、正直，还一板一眼。",
      "source_fingerprint": "e0dc1b0a6fe1b04bb05fe5edd6c8285e7553248e7fe06b8c2c0c620f15297c98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
