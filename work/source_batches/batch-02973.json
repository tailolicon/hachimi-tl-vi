      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:a22a02ad6bd41abf0c5f40ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感谢大家陪着我心血来潮闹了一场！\n――……怎么样？　你也热血沸腾了吗？",
      "source_fingerprint": "11c65637afe46e46e9043106a114702a5d6b7a7d16edb62d8c48066d7a81a91d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
