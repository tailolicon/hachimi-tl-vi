    },
    {
      "uid": "zhcn:8709922a23873ce4bee532dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即将参加赛事的朋友",
      "source_fingerprint": "f26b8eb6d06d3709fb7eebd7a981bd3ec18d9c24dd8e94af881beaa840e50cfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112001.json",
      "json_path": [
