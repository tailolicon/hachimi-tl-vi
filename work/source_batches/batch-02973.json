      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我……真是个胆小鬼啊）",
      "source_fingerprint": "71df3b0dd22c1a7772dcb77b1d324cb04a3b778be995547574b95bd323b233b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
