      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……！　我现在充满干劲了！　谢谢你，勇心！！",
      "source_fingerprint": "0b812566cdec28e098d48217f03b05cb33fe601b8b7128d8c2011c4a36675a5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
