    },
    {
      "uid": "zhcn:23058745a28959799c360068",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看了日本的三后冠赛事后……\n我在心里暗暗起誓。我也一定要戴上那顶花冠！",
      "source_fingerprint": "085dc4761beb4f5425169a99ca73d0d9658e714be71c8cd921a2303a7102b05c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112002.json",
      "json_path": [
