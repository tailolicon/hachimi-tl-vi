        "name"
      ],
      "json_pointer": "/text_block_list/29/name"
    },
    {
      "uid": "zhcn:8c0a642f7951714aee776f5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……再过不久，我就要和同样志在后冠路线的同期生进行模拟赛了。\n这是宿命的对手们齐聚一堂的初次舞台。――正因如此。",
      "source_fingerprint": "3de7069ba0fe6161d8c94638ea7243a58d88c5fb7662e73229a3af8764cea745",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112002.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:74ddfa9a32546240cbc89eea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇心的朋友D",
      "source_fingerprint": "96606d91c9ac473d7ab327580489d5df38406c4730b67ab60d13d2e7e21ef192",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112002.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:c6438653879ae754d28e2ca0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "模拟赛是指……和莱茵力量她们一起的那场！\n听说她们超级强呢～。不过，如果是勇心的话肯定没问题啦♪",
      "source_fingerprint": "2879f52ea8ae2609ae6512993c4429425d2133cae68c793ae64a87d7bc4e858a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112002.json",
      "json_path": [
