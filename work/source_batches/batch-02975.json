    {
      "uid": "zhcn:2b4c84dc2dd6d19966b966c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，我的目标是，三后冠。",
      "source_fingerprint": "f6f8750e6c9f8e3d71e3568221b3b25bd375b96bcdd429c1360480c0b08a580d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
