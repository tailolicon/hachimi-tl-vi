    {
      "uid": "zhcn:1db41ac9d646c201ae97f00a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "三后冠——这是赋予在经典级阶段制霸『樱花赏』、\n『橡树大赛』和『秋华赏』这3项赛事的人的称号。",
      "source_fingerprint": "2e4c255a0d33e678934e97ab6829001e0a80032ea9ea41c75982835b0b9e0703",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112002.json",
      "json_path": [
