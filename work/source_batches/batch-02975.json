    {
      "uid": "zhcn:ba4b86fc8dc2c8cd07ab12e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇敢之心",
      "source_fingerprint": "9a26c04a8af8557f331ed7076671e2fce274ed0afd52fdd6e88b73fe92f7c8e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1112/storytimeline_041112002.json",
      "json_path": [
