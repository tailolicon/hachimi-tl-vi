    {
      "uid": "zhcn:18eb584c4ef920d57624a119",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目的地已经定好了。\n——很久以前开始就定好了。",
      "source_fingerprint": "b9b7235755718f829c44309f3df763820f3334754f474a745ae927736786971b",
