    },
    {
      "uid": "zhcn:5c79f10c51f1635688fce89f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "俱乐部训练员",
      "source_fingerprint": "cf2c2e2b0ac6da8000e18994217a63c983bbce7be7d9830b0a898675f5b04084",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
