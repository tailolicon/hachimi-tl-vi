      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的，接下来！模拟赛要开始了哦~\n大家准备好了吗？那么，预备……咚！！",
      "source_fingerprint": "394f642e4d9136fe365280f6f5829cbcf0167fc6be076e242c79147fcfddc82b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
