    },
    {
      "uid": "zhcn:5cb5db41939ce4da0801d8ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被雷鸣般的欢呼声包围着的我——悄悄握紧了双拳。",
      "source_fingerprint": "6e0adf220dce42ac148b15ee09e886bae6181ed6fbeaa775e477b3fd23e88c64",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
