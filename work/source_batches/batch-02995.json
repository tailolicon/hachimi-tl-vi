    {
      "uid": "zhcn:16c07a14abae4d369549dde3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要说当时的我，拼命学习进入培养学校的日子\n比想象中辛苦得多、艰难得多，每天都在挣扎。",
      "source_fingerprint": "d1fc7829837e9da88c079325b3c172bf0ab3b6af474f745ecca2722c56f621ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
