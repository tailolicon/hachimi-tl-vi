      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（觉得成为训练员的日子很遥远）",
      "source_fingerprint": "8702768b15e709b152f5ca0f73068d1ec3438bd1f012c15ea34c4dda9d7ebe8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
