        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:93ded7c036d3aefaf5e55bcc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，不……因为之前感觉你们在并跑——",
      "source_fingerprint": "edae9bd4d593ef24a1f05c284b11d49358b9d2c80f8b56207e5a5aecca8a1d0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
