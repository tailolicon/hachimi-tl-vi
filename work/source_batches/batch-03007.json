    },
    {
      "uid": "zhcn:e9bf1361aa5cc00dc59fcdd0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在声明自己并不清楚详细原委之后，\n向她讲述了刚才目击到的并跑的事……",
      "source_fingerprint": "f6feea29154ddd5f38a64472a59939e0aa3f2cc626fad31ae0c816bcb1fbd267",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
      "json_path": [
