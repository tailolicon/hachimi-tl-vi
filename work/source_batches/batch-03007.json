    {
      "uid": "zhcn:2dc4e4654de412a0578ddad1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "算了。\n以后如果发现什么情况，请告诉我一声。",
      "source_fingerprint": "ce7b05585d12916133ca26f1ac037275764eabe6f02bea4f980cd6c9896b138f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
