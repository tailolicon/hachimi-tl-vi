        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:7de9e6d97ba635594f027d08",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你很担心她呢",
      "source_fingerprint": "13dc3b481d3366c32404b5d7ff52608ff7c5b239cbf482d31c75603feec5d0b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
      "json_path": [
        "text_block_list",
        16,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/16/choice_data_list/0"
    },
    {
      "uid": "zhcn:45385f09a92a246e93ca1355",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你好像很担心她呢",
      "source_fingerprint": "c0516a1f931bb21a601814eb34d5e787c5f5d15c05234ac8d7d74a87e841cd33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
