        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:dbefd3af19aa0e89e414d15a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在极其惊险的情况下击退爱如往昔，终于制霸GⅠ……！\n称霸『伊丽莎白女王杯』的，是爱慕律动……！",
      "source_fingerprint": "bd3f3b6787f165a0df7277a42dd0ddc86a9559de0bf19382232d4975931d1ad3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
