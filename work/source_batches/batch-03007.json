    {
      "uid": "zhcn:9fc77f2a0090a8538c93b575",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——嗯。听你这么说，只是“和某人并跑，并且赢了”。\n单论事实，仅此而已吗。……目前还不好说呢。",
      "source_fingerprint": "fd347a671c2c865862ffbe3e1d390f9e2d2dc134f9d8e3c5a2c10f1ad5e83387",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
      "json_path": [
        "text_block_list",
