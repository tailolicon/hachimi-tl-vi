    },
    {
      "uid": "zhcn:280a2f619553d460811cd637",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对手是……爱如往昔吗？",
      "source_fingerprint": "36b9d191059606ad2c7c585a32f9abedaf281820f27d19cb53c7231c1cf8d400",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
      "json_path": [
        "text_block_list",
        38,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/38/choice_data_list/0"
    },
    {
      "uid": "zhcn:e4a32557b83e5b29de903704",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没想到爱慕律动也做了类似的梦。\n不过，“被她夺走”的话……结局似乎有所不同。",
      "source_fingerprint": "d43afd5754829044f07bb05ae979f0cde2dd2a224bffc21d5dd0dc0b587cbe04",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
      "json_path": [
