        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:5eceef5485b0cda2107511e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "解说员",
      "source_fingerprint": "4008bec707b5da8466b977449da2d4b922f1f6bbab6cceca9982aaa914d2e188",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1118/storytimeline_041118003.json",
      "json_path": [
