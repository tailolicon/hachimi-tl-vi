      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，到了。王宫的最深处！\n剩下的……只有她一个了吗。",
      "source_fingerprint": "c9cf863c860855a622e02026e82aaddc6cecfc163aa29d3f3d29545c13178195",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
