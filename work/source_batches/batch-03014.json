    },
    {
      "uid": "zhcn:dafb40ca2f92dfbd2ebf5c46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在粉丝感谢祭上表演的剧目，\n让人完全沉浸在中世纪的骑士故事中。",
      "source_fingerprint": "bc75f785963e23c4da83b0486937b87639f24797fd085e66bd88c524813f55ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
