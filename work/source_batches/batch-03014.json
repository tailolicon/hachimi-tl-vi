    },
    {
      "uid": "zhcn:0f0bc9f271295d618cd7447a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，真的很感动！太精彩了！",
      "source_fingerprint": "a89a3880fecb3ed34a099fb56ede52a6998ad41c2418abb468eb04004d7d9980",
