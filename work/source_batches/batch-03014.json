      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我鼓起勇气，决定去和多旺达说话。\n也许她不会理我，但……",
      "source_fingerprint": "caaefeca685cf8dee1b1fad113b4a1c5c3236bda7a911cb11bd917df35fe593c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
