    },
    {
      "uid": "zhcn:f8b5ce83513a3bb44c3cb240",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出演主角的赛马娘是『多旺达』。\n是有着在法国史诗中，所记述圣剑的名字的赛马娘。",
      "source_fingerprint": "5e259ea3a39c15e300a9125c51676bdca68a24f0ec25c52f05901092b945d2b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1121/storytimeline_041121001.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
