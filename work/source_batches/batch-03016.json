        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:08e501d3f2d9ac10d241b260",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自己必须站出来！\n我绝不能，让那样的潜力被埋没。",
      "source_fingerprint": "00917dad97d16d2ae06de0298a6f48e4a2f45cafff12d4766744e5eaaddabfa9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
