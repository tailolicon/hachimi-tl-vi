    },
    {
      "uid": "zhcn:bcbec5bade2733cc3cd1c4b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多旺达一直憧憬的骑士授任仪式，终于由我们两人完成。",
      "source_fingerprint": "3e00fbe0b5802d96c49cad7d7c16ad4b1ec6e1ba4853c083bd47b4f899aab46e",
