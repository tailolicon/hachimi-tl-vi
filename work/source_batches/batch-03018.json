    {
      "uid": "zhcn:f24d2116a27df389660da403",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，当然。乐意之至",
      "source_fingerprint": "345e983043293e99c71a1dc7af995487259f91c47fcc30decb4b09aa3f75c35e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1121/storytimeline_041121004.json",
