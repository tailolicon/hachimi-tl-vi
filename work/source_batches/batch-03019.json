      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员殿下。\n关节的检查和柔韧训练，已经完成了。",
      "source_fingerprint": "f74b53eaa11617dec3f9225267da3ddae8ab59bc2e9334f33fd22c7f90c6bb2a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1121/storytimeline_041121005.json",
      "json_path": [
