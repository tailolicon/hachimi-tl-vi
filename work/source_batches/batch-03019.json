    },
    {
      "uid": "zhcn:1404987787b74e67a9dd2708",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（果然一开始就非常稳健。\n但是不能着急，先按平常的节奏走。）",
      "source_fingerprint": "b2645a87e772753b0f73f0a640958da6342de63c8970e3384328aa312be24280",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
