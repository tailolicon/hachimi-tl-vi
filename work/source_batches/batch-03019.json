      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:bfd8d1d63e427eb28c4d6475",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前辈训练员",
      "source_fingerprint": "28368bc5f3c0a28228256a15f37d5afcd7aa93e7f6889b318a2b7110a64bafb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
