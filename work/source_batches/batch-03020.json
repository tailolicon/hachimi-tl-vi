    {
      "uid": "zhcn:e49f3eb2363877e0eaa80554",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『多旺达，我将赐予你祝福』",
      "source_fingerprint": "38f371e9964999abbc34b783b47f1dafce0e7bc7c5dae92fca30f731831e4b05",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
