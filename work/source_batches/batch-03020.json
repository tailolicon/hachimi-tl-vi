      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:f63d8c2c38ce2b41c4c10e99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『——胜利、荣耀、欢喜。愿你作为赛马娘，\n履行一切使命，成为众人的守护者』",
      "source_fingerprint": "d791e9d80c2347ccab794b784df08722ed72fc87602f61f373952e6e30dc2084",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
