      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前辈，您来看我了吗！",
      "source_fingerprint": "cc8084b0312e51d4295567c5f14af1cc8c95a84178666421d681836fe8df4858",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
