    {
      "uid": "zhcn:767af9edf2bd486d4cea4f78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "开口跟我说话的是那位让我立志成为训练员的，\n我敬爱的前辈训练员。",
      "source_fingerprint": "9d7f2f77edcbeee4b002f9747e61fd65e35aef5d08b6ad60bf383de7c54b6720",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
