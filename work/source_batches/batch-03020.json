      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然啦，现在可是备受瞩目的组合训练嘛。\n……不过，多旺达还是老样子吧？",
      "source_fingerprint": "c025f9cc0e486c9d16156c73931e271452b43ba2830a4bb1edccce7d3818d213",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
