    },
    {
      "uid": "zhcn:55906b5aa61f38b233b6ae7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的，她一直在尽力履行作为一名骑士的职责！",
      "source_fingerprint": "9de8637f0a8973db39f73245d05b5f3c5d24e8b0c7bbe095c86be89301abd442",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
