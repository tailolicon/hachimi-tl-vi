      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我已经下定了决心。无论前方有怎样的苦难，\n我都会以我的荣誉，誓死保护我的君主。",
      "source_fingerprint": "1afe99f33733b1b0edd55bb8c6b34b828e28ebe211ae497d67f6973206aeda51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
