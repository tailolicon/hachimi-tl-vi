        "name"
      ],
      "json_pointer": "/text_block_list/14/name"
    },
    {
      "uid": "zhcn:f4eac15485785dc7c4aa6b6f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，我出发了……训练员。",
      "source_fingerprint": "57d50b18a5e7eae3ffc2e7b41763fe9f2e791fc6cd8d5c5fe748fbcb90d2c560",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:17f7bf090d4c59f181eca145",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目",
      "source_fingerprint": "b632be927b5d52ab85b0cfae236cdc76e44b41d48ba6e925027a4013417d1d5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        15,
        "name"
      ],
      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:8fef6ef02223268cd5db9be0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。\n我会赢的。赢得一切。",
      "source_fingerprint": "9b4ad7a710040e68dc4a3905a11e8a04c61bf4f89a16c1edb97146ac9480c6c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:e9372160469d28ef8fe8d3c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "时代即将更迭。\n——这不是希望。而是确信。",
      "source_fingerprint": "38aa2f2830847cfdd754a2ecd5ce95feadff77aa6b1ff29da5e482ef947a1a09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:237b5f48b30fff5891548ac7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，一切的开始——是几年前的事。",
      "source_fingerprint": "18556462da38842d5f4e28c9326566fc8cea43f451f261b84005b6b1646755e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:f1eb84f98dcce78209c1d525",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（终于，站在起跑线上了！）",
      "source_fingerprint": "07b99800090992860cc33ad8d59cf98b8767e875b075963d9d03ac92009bd8d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        18,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/18/choice_data_list/0"
    },
    {
      "uid": "zhcn:c6847a4a5d4b1a2890f3ae8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "————终于。……终于，终于！",
      "source_fingerprint": "9ad1bfd5b170776f08b726334cd789178f7175082a700e8f07c7529d8e9bea20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:4972976c08c047b34dd4b822",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "拿到了中央训练员的执照，\n终于成为了特雷森学园的训练员！",
      "source_fingerprint": "155e313356e5b55a11113e1f081b735836e923bdfb0ac7efbbe4928aca9417cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:12a90fecd609ba869186f2a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实况",
      "source_fingerprint": "50349a592c466fb97eeafeb81fd3fa65c8c3b2e779463937300c4c8f97230140",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:6f279e00cac2358b125cd0db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "深受大家喜爱的赛马娘，北部玄驹！在『菊花赏』夺得GⅠ首胜后，\n又达成了天皇赏春秋连霸等成就，在无数比赛中绽放了绚烂光彩！",
      "source_fingerprint": "8bb1a76abf5ab04c0f88a9410b3b31f9869d390a73c89872bda5bfef83bbd99f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:e638391abf31ea36254f9d9d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（必须尽可能做好准备）",
      "source_fingerprint": "439a1fb767288400bdb8c6775cc870068dc8edaf7f1702e0dee303bcc9bae778",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        20,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/20/choice_data_list/0"
    },
    {
      "uid": "zhcn:22f64797f29a9fee28da27ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（得尽可能做好准备才行）",
      "source_fingerprint": "a5ba5a77652bfe22346a614f741aa3c14b3c4f635b207111a1bdc1baff0d739b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        20,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/20/choice_data_list/1"
    },
    {
      "uid": "zhcn:afc754884f06c76380b2660c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "心情雀跃而有些飘飘然，正为了今后能派上用场在找相关的书籍。\n比赛教科书、营养学、解剖学——手里的书越堆越高。",
      "source_fingerprint": "b2035ac9f95de72690a535c62a59cab79aaaa1902dd1ea34a70da42823c6c909",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:562756f68847fc020bec560f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——有时，赛马娘会被形容为\n『承载着大家的愿望而奔跑的存在』。",
      "source_fingerprint": "1fcc9c88c1f0cfa1d55cbb55b33f41666b358e240daac17081e601512fd4cdc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:f6cfb771b28b36d4aa1c1c32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "例如，堪称戏剧性的复活剧。又例如，在重视效率的\n时代下背道而驰，笨拙却又惊天动地的比赛。",
      "source_fingerprint": "165af4e56eb4ae4e4429fd427bc82deec4b83837abc413ea3c0fd0522a2df86a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:2c5988c30f0ee6d1d34cf980",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我想要毫无妥协地支持下去）",
      "source_fingerprint": "00449a858e79ab3a33c72af75f1c43d42e918cabec362882167c309ffd62cd02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        23,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/23/choice_data_list/0"
    },
    {
      "uid": "zhcn:b61cbbb206b5b0e340312b87",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我想要毫无妥协地支持下去）",
      "source_fingerprint": "00449a858e79ab3a33c72af75f1c43d42e918cabec362882167c309ffd62cd02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        23,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/23/choice_data_list/1"
    },
    {
      "uid": "zhcn:7615f2756644acfcc12e1fe7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "愿望化作奔跑，甚至终有一日能救赎他人的心。\n正因如此——",
      "source_fingerprint": "a809f8bf4049c6007a2d8b45afa649b4974f0aa2fd2fbb909fb8e9b1eb2c2d32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:ee0ecf3a7214069c985657de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让今后邂逅的担当赛马娘能发挥最大的潜力实现梦想，\n并让那份梦想散发出足以实现他人愿望的光芒……！",
      "source_fingerprint": "56bb64f2c738700b073bc75e3b9bbdb9295f022c3a341f16eeda12ebea1bee0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:faf7e924286b0a9017445d6b",
      "kind": "story",
      "source_language": "zh-CN",
