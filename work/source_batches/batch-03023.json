    {
      "uid": "zhcn:eb97fedc7ac08ecc301ab3fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "猛地一抬头……书店的屏幕上正播放着\n《月刊闪耀》定期推送的访谈节目。",
      "source_fingerprint": "c556ec3c507639bfa61e4cf4d49abad5a1fdfca8c4a9180bf41e8a0561de1c20",
