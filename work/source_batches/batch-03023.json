    },
    {
      "uid": "zhcn:2a9ee6105bfb3ec3528b223f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一阵疾风掠过。\n一名赛马娘正从高架桥下飞奔而过。",
      "source_fingerprint": "1365422aff820ccfd3f8df9784adf95fcf56b6172416ad0b0627acb1db48c6d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
