      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……该说是喜出望外吗。\n能获得这样的机会，按捺不住心中的雀跃呢。",
      "source_fingerprint": "c75f85f5b7660e168d6f67ac8f47e5e4b7987d46e9477aa4f0afcb383e77e01f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
