    },
    {
      "uid": "zhcn:5bf149f44521cf7a183198c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "带着这样的想法踏上了归途。就在这时……",
      "source_fingerprint": "09af19ec89baac3b5cded8ca9a3967621e79eca24d3544b58b5befa8da8b5ee3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:ddcb16e23a5b3be3a1e188ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "河滩的尽头，有一只蝴蝶正无力地飞舞着。",
      "source_fingerprint": "096cd6e35b6350be6afa5186650646932babc655a67c8e2b571776024e6724bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
