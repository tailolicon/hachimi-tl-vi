        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:284c6c4fe7d897907e52d788",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看着它摇摇欲坠的样子有些担心，便不由自主地跟了过去。\n走下堤坝寻找蝴蝶的身影。这时——",
      "source_fingerprint": "45967ef59cdf713007b05cd4ac6b01de439ba41e10c3f03972508169aa2a34dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1129/storytimeline_041129001.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:200bb5fa8406f8fff2c881ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？？？",
      "source_fingerprint": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
