      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一定能飞过去的。无论被怎样的惊涛骇浪所裹挟——\n只要心中有向往的目的地，就一定能。",
      "source_fingerprint": "6338326268090aedc575ca225ae69410bcd75def34e32c4d499dc6bbe40e07b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
