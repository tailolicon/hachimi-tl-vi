    },
    {
      "uid": "zhcn:970c720e581cb947c1a65a15",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（那是……未出道的新人吗？）",
      "source_fingerprint": "af7cbe205ffcfd1d4208953c8ea4d63c93296a2ad3b2c0634a0d9b3ec8cb5291",
