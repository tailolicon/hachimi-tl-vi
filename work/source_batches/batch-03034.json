      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春日和煦，初露枝芽",
      "source_fingerprint": "92f97dfb9025af16d9616bdc22b3c69d38343999e292462b5632758b36d2b8d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
