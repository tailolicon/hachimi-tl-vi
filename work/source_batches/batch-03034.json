      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——所以，你才会来找我搭话啊。\n谢谢你这么关心我的事。",
      "source_fingerprint": "83cdb5c949a1eabe982636d0c284de53f8235b5e15b5e1226e1289def1bebdf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
