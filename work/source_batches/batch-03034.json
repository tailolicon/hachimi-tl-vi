    },
    {
      "uid": "zhcn:02d48a024a6c1cdebac4c2ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130002.json",
      "json_path": [
        "text_block_list",
        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:5b8d3b46a8cdeec4742eea46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——黄金巨匠同学。\n是我……向往的存在。",
      "source_fingerprint": "a0503059ea422df6f7713f1630cf1b338c46e2b186600822719d202859855150",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
