    {
      "uid": "zhcn:0ef8d9c80467bb8233667f19",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（那么……我也开始吧）",
      "source_fingerprint": "5d9b1568c51d4f108cada16664909f433f8ce501f4098bfc2da952d061ecff0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130002.json",
