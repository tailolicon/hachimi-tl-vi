      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:7cf497e6a12e3bad306ea346",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——教官，接下来可以让我试跑吗？",
      "source_fingerprint": "38b701efefb90cf6e202b32336cfbb6baa13337cc4f27c6e16957de3fa847a97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130001.json",
