      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "希望你能让我看看你的训练",
      "source_fingerprint": "1e1809390e56df2d6cc8a7059cab294bcab3ffe0f524ba3df46f0543db9062da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
