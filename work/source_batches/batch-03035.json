    {
      "uid": "zhcn:dadef70c13904cc21ee777df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果您有什么发现的话，请随时告诉我。\n只要还没被黄金巨匠同学放弃，我就会一直在赛道上的。",
      "source_fingerprint": "5e9c8856f4c5d3b739c254dfd5cbadac0a1b839e7d80f9dd10fd1aacacaf7427",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130002.json",
      "json_path": [
        "text_block_list",
