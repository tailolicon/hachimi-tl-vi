      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:94e385fdd85b184cde9a334f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（让她放松一下肩膀……之类的……！？）",
      "source_fingerprint": "831be38aea97b2ca754289e54b87c2cda23b83b18558d0b1ad4b65eb9e07dc1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130002.json",
      "json_path": [
