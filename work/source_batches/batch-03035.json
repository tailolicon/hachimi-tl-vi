    },
    {
      "uid": "zhcn:1d8df9f472cdcd30e157dcf0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员？\n您有什么话想说吗？",
      "source_fingerprint": "d5563777752ea0f68d911a33ae9b1cb2d46a7088719cf4ccf0ceba9fb8df1867",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130002.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:daf42e302f03ffb811b0ff13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因、因为是Night，加上没有什么的………",
      "source_fingerprint": "5f7b54f1b31467a98cd677075d9812dadcf8e0c77642a3cab284ed9b9163f3b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
