    {
      "uid": "zhcn:8aaa5018bbf8668ddd92abca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那是……指和黄金巨匠同学的比赛吗？\n还是说……是指我呢？",
      "source_fingerprint": "94919ee81a4d957ab3149b6bd09a310e0f09339f4bd74e8e67e98beada618f77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130002.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:e01c9de5973c0f3f46d7f672",
      "kind": "story",
