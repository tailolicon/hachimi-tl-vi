    {
      "uid": "zhcn:efef0fdb75f22228ced70282",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，我改变了自己。\n因为——端庄得体一点，才更有明星的派头嘛！",
      "source_fingerprint": "4dd0b52aab4dc6d5070ca3d85dd159b3a9adf6523a5eb716d29bf29e99c28791",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
