      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:cbc87d176e983d510b7b6b01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，完美♪　『身为英里跑者，就应将英里披挂于身』！\n双马尾的高度～……今天是16英里！太棒啦♪",
      "source_fingerprint": "d446952cabc889127854bca7731b2ab4238309a2576325ff17216f7e56a22ffc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130003.json",
      "json_path": [
        "text_block_list",
