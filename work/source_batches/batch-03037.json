    {
      "uid": "zhcn:15c1a50ff9f8d123bfc1704e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不不，也就一般水平啦。\n刚刚那些，也只是从电视上现学现卖的。",
      "source_fingerprint": "813d419f6147dcd12c229e6e27fceab44da02b14a87480adcaadd68772e2998b",
