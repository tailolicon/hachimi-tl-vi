    {
      "uid": "zhcn:8edc9d187758e248935d91b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（那个时候，我随意地装了一下傻，接着——）",
      "source_fingerprint": "6adeea8bbcf5c95acd360947452ddc4ad456d487f586efe6de219fe774d2c436",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130003.json",
      "json_path": [
