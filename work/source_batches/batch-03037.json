    },
    {
      "uid": "zhcn:1464836dda4a4135f8b05c9b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "引出对方的长处……这同样适用于赛马娘与训练员的关系。\n在那一刻，我突然——回想起了白天的训练。",
      "source_fingerprint": "414f78ee1bafc8673da1269f6b6de650bfc81ca98e88a71db91a0ab2cd744a2d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130003.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:97413a03ac6ca9d16e9b617b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（简直就像是，黄金巨匠一样……）",
      "source_fingerprint": "5bc39a0baeae036acf3b4e588f61a4b92fd159e89d329a031568efb659a65fae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
