    },
    {
      "uid": "zhcn:0ad10ecc69a04749d0f3e3f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁摆出了一个奇妙的手势。\n紧接着，她展现出了极佳的加速。",
      "source_fingerprint": "1dad629d36acb6a5a23cbf08840f9db38385662af8f5f3543e67a5615b605620",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130003.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:32c64322041facef5ac87e5c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放声欢呼",
      "source_fingerprint": "f6f9d4474a6735b6f626fab88bdf3039da94d23a4c9c8c9f6d7f45e584ff4250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130003.json",
      "json_path": [
