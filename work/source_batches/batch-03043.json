    {
      "uid": "zhcn:271d60ed43517aae1f9e366f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我慌忙否认，但旺紫丁的表情，却透着些许温柔。\n她向我投来柔和的微笑，我感觉到自己的心也跟着舒缓了下来……",
      "source_fingerprint": "df97a8e54b729d94d8ce5cfba19cca5ab79071d3712854853fe02dd1e074a553",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130007.json",
      "json_path": [
