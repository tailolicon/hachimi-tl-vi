    {
      "uid": "zhcn:a0a67f2599d2474c91e77a7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "噗…………呵呵！\n……果然，您还是想装傻对吧？",
      "source_fingerprint": "6f798b428da45bd954f3785affcb43575f3abef917630a5c90666957c7da7239",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
