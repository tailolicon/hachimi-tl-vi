        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:a7ec38436e960600309f1572",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有，有那么好笑吗……？",
      "source_fingerprint": "b12461475def185cb7d89796b9fb4a85d674a662aadba758f1457ab1ade21e88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
