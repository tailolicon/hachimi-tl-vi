    {
      "uid": "zhcn:4f54270642b870d25c3f7d09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为，您是为了我才一直努力练习装傻的吧？\n还在训练笔记上，写了那么多东西。",
      "source_fingerprint": "b8ca8ab460f3435769b49ba5245313419fd98de123777c914f0fe4664db7252b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
