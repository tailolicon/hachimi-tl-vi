      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:abde018cf5321835fc4d5c38",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她那只为我而说的话语，渐渐地打动了我的心。\n我一时语塞，说不出什么漂亮话来……只有海浪的声音，在周围回荡着。",
      "source_fingerprint": "81f529936cfbf167619f38df91efade5d6e5955993146871005657244b8dc1f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130007.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:0335b935e1594dba50285fae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "………………哎！？",
      "source_fingerprint": "7f5887f2c529bf465e5986bed14da00d823616361d158f645b12a75b9fe03638",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
