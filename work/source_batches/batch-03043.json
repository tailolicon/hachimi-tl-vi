      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………好，来吧！",
      "source_fingerprint": "1086dca0752ecd3a33fd833918fefbdfee19062b26e34a0ab3b045d708f1a514",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
