    },
    {
      "uid": "zhcn:18b626c3648730b2b501ff57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，素材已经攒了不少了",
      "source_fingerprint": "55c7c41596e005d71fbdf3a91c57468138f2fc1338e7ba9c7436bdf93db11ac1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
