    {
      "uid": "zhcn:3d65d703b67ccaefdf5748f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，我也想去回应您。\n——回应您的这份心意。",
      "source_fingerprint": "9019765c56dffd5ab6f4873c82fac5ab9cb8bb29fa1d61ad80c78b1456695965",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
