    {
      "uid": "zhcn:3409c8710cd7bec32591d170",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "抱歉，好像莫名戳中我的笑点了……。\n大概是因为，在那种场合下突然冒出来吧。",
      "source_fingerprint": "92f0fc32c8d0f56aaa77e4af3391e1a00d8168eac30ced429ff1fe1cfa8cf419",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1130/storytimeline_041130007.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
