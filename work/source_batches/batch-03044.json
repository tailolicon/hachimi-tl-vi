    },
    {
      "uid": "zhcn:0f4fe543400030355de87beb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这个直播间里聚集的是马娘唯独爱你的粉丝。\n即她所运营的社区成员们。",
      "source_fingerprint": "17176d8e87860eaa3be2814cb8512ed4990b1dcad0487c3f6903564db81758b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
