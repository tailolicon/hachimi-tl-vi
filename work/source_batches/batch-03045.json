      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『那么下次见♪\nLove me♡  Love you♡  以上来自唯独爱你♡』",
      "source_fingerprint": "2298ca085e4bee98db101387122e10ff792ca1313fb29d4eff8e1b415db217e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
