      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我作为训练员迈出重要一步的唯独爱你。\n以及给予了我勇气的伙伴们。",
      "source_fingerprint": "ae0350cd4940011d3f74d3d772f077fe76e60f5be8a6ad0c7ead5b7ccd229fda",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
