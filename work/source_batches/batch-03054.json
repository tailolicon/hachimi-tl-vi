    },
    {
      "uid": "zhcn:45b0ced3de27347cbe1d75cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不仅介绍历史，还会介绍与之相关的现役马娘。\n将当下联系起来，正是这篇专栏的魅力所在。",
      "source_fingerprint": "30d764e666847bee83a945a9d0d40ed8af8510f552bac4d4b9bd0ed02ad4b1be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133001.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:8862dfd8495fc19e880c7d76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正好有空，去看看吧！",
      "source_fingerprint": "0cf2a7ad0d6a1ce8b7078aabea2c94867d96e23abc3a187d949af7b3b686ccd7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
