    {
      "uid": "zhcn:2b2fe5e177e552df89ecc61c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当天，因为距离比赛还有一段时间，\n去参观马娘博物馆时……",
      "source_fingerprint": "ef74f71c68d3f46539fabb59be3bc51757513f3f29f3612d4c320de393dacdd8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
