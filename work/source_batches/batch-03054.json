    {
      "uid": "zhcn:23aad5df06d863df5659d2f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "执笔者……撰稿人C是谁呢？",
      "source_fingerprint": "889c437b66b01fa9ecd3764728a64c27ad1dee35401528f8ce316eb135c93a87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133001.json",
      "json_path": [
