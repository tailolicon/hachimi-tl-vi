    {
      "uid": "zhcn:8cc53765f6b4a899d07284d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一边喃喃自语，一边确认着日历。\n——专栏里刊登的马娘好像会在开年后的星期五参赛。",
      "source_fingerprint": "194c21ae745bfe49fdd2c0611c068a11018c97cf60989f62f1c808dfc5f53af7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
