    {
      "uid": "zhcn:4633b9586c14536fbce28cd9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这场是『阪神两岁雌马大赛』……\n我参考迷人景致同学获胜的那次选择了跑位策略。",
      "source_fingerprint": "e2540713dad9516326287713cd6ba1629d1efa7fdaa0538482861cf8816ee924",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:302eb7dbeaf9e7d1d4f7a05b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "创世驹",
      "source_fingerprint": "90932cce823b85e597f107613b32325b1dbc51568e2b07571ff7b2f6790461db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
      "json_path": [
        "text_block_list",
