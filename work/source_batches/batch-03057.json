    },
    {
      "uid": "zhcn:a1b39191f15338746a29aa8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……要不然去赛马娘博物馆看看？",
      "source_fingerprint": "139e673fc376d39fc00c25f1b851621833f30834b62b6ac920b44699070675fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
