    },
    {
      "uid": "zhcn:0004c7fa97e1962552e05618",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "创世驹",
      "source_fingerprint": "90932cce823b85e597f107613b32325b1dbc51568e2b07571ff7b2f6790461db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
      "json_path": [
        "text_block_list",
        26,
        "name"
      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:6b95bb4063ccf05ea0009787",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。因为历史是“既有的事实”……\n我想没有不利用这一点的理由吧……",
      "source_fingerprint": "909be0469e3352971d529dcd61e61b37f5aaafb90afe8c9e3f23a91d219da5c4",
