      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……训练员。",
      "source_fingerprint": "f0e96cbfc8b6d3f38b2241c490c76ff5cc84d50c4b1a961687f7718ddd48f111",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
