        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:1b2eb1c42454ad1d91eed6e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……说实话，我很迷茫。景致同学之后的第二年，\n获胜的又是从内侧追上来的马娘，所以在想应该参考哪一场……",
      "source_fingerprint": "f9c32272f0b12055544484fa1e35317ce94829fafda186c8931316ac8b5df669",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:459ba6f3177cf030173e7420",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你平时都是像这样边想边跑吗？",
      "source_fingerprint": "716b133b8c17fdfda4e80ba8817c9e8d17a040b5f6516d3693ac1d40521d2510",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
      "json_path": [
        "text_block_list",
        25,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/25/choice_data_list/0"
    },
    {
      "uid": "zhcn:8bb0a2b88a52d77559dfbd76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "创世驹",
      "source_fingerprint": "90932cce823b85e597f107613b32325b1dbc51568e2b07571ff7b2f6790461db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1133/storytimeline_041133003.json",
      "json_path": [
