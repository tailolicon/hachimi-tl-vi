    {
      "uid": "zhcn:eb5ddde4d33dd3d0ea7b0811",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "能不能请您——成为我的训练员……！",
      "source_fingerprint": "c68ed6b184660cb340df8627e908ec855e373f176f02b34fdbb4051178d539d2",
