    },
    {
      "uid": "zhcn:0f1019825d0be605c66c81fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（——好惊人的欢呼声……大家，都是为了来看杏目同学的。\n要与如此备受瞩目的杏目同学作为对手……，但是——！）",
      "source_fingerprint": "8c4fc148519886dd2fd14d8dbbf61cb21191cd3453ea83ecba200d3d606d01d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
