    },
    {
      "uid": "zhcn:a5c89dfc67baa73760e31739",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛事粉丝B",
      "source_fingerprint": "322df4404e787be98be4fc4a350355e379ef94185ce0e165cb97c868a8d44598",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        17,
        "name"
      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:c5a6289eec201010d9190b9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小杏——！\n期待你那令人惊叹的末脚哦——！",
      "source_fingerprint": "0343cdc68867ec6eb4fc1851a49da500a26b8c945403ceb9da2115a818dd8a95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:39509818e9446944f9c7a2dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
