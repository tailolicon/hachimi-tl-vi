        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:c865d50ebf7e453141350682",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        19,
        "name"
      ],
      "json_pointer": "/text_block_list/19/name"
    },
    {
      "uid": "zhcn:de3fa0d997a613dddc073603",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个……，杏目同学！\n今天的赛事，请多指教……！",
      "source_fingerprint": "22a3fd548306694e9d52be3601722d1fa81d256c3646307e8b6f401072541e7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:95d64e72d2aac12d136fded7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——这太突然了。\n我做梦也没想到她竟然会希望和我签订专属合约。",
      "source_fingerprint": "89f78912cea5780af77cde4c43f2fbbb0f29adb1a167a0b3721fccf5270bdda1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:62b69f9d90aaf0f2a3450599",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目",
      "source_fingerprint": "b632be927b5d52ab85b0cfae236cdc76e44b41d48ba6e925027a4013417d1d5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:078ce0d2fd9504730c9f93d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，请多指教。我是不会输给任何人的哦！\n金花酱，就算对手是你也一样！",
      "source_fingerprint": "19999b089ed9c80b45211467d447433a7799b6cbb17e0c0b7bc97162e4511169",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:87fb6f40ccd643bf5f7843ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——赛事开始，杏目在起跑时出现了迟起跑，\n机伶金花则在先头集团占据了有利位置，局势就此展开。",
      "source_fingerprint": "7f673e9a1e609061b626906dee6048ad76379eb9f13e17b856f3c55b39dd1de6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:4d65319615d833606d47b710",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目",
      "source_fingerprint": "b632be927b5d52ab85b0cfae236cdc76e44b41d48ba6e925027a4013417d1d5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
