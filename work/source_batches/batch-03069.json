    },
    {
      "uid": "zhcn:d4f10cad0cadb502c8914500",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——我想将那闪耀着黄金光芒的花束，献给您。",
      "source_fingerprint": "9825ff600fd649b9b7d3cff40c7ecd3963e9ac64b70e1726a1a6aec4533da751",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
