    },
    {
      "uid": "zhcn:0b77dc3b0fbe1c37ce785f74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，将这双手快要溢出的，胜利束在一起。",
      "source_fingerprint": "56cb13bd4ee8f23833dcd934328d6000acffc5d8f7116c6a953107b988958196",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:bffeefe64dfcc61e6a94d0ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
