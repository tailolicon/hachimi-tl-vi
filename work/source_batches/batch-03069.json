      ],
      "json_pointer": "/text_block_list/44/name"
    },
    {
      "uid": "zhcn:4978d63a32cf283697f68074",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，无论如何——\n请成为我的训练员吧……！",
      "source_fingerprint": "e9defce877c617928601640e07c39013412f610ae39bed885f0e63824594eb3c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:b88c461df10eeaad3b416ffe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（这一定是，她所迈出的最初的勇气）",
      "source_fingerprint": "6786e65fcf2e3392a7c08fabebea8bc3aed7600eacfd80bc5604365e9bd6b0e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
