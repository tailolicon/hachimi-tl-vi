      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:e1ab933931768eac58ca8061",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134004.json",
      "json_path": [
        "text_block_list",
