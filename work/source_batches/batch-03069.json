    {
      "uid": "zhcn:25a737824ccf96f35f93d438",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——！　……训练员……！",
      "source_fingerprint": "cdcf812200e5fcfb6293619ca50867c88463b97a445a0aa91d27a0a4952b7d84",
