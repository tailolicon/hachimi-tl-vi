    {
      "uid": "zhcn:a52eca1abab84b9d2ff04694",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——我本想通过获胜，让您看到我的觉悟的。\n好不甘心……",
      "source_fingerprint": "c643c8636d746474521edf8097b05bf8e44e1f4d7ecbcf5fc387849d94d4e399",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
