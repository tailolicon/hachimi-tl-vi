      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个，你的意思是你正在考虑出道吗",
      "source_fingerprint": "747f11ed71c21c775fce8f7156c16484717d154ed669b6c9d5f071c8a3927318",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
