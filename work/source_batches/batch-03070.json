      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "花的香气吗。挺治愈人的，我也很喜欢呢",
      "source_fingerprint": "a55a0b32a7a166722e0a21371352219033c73ce9d655ef0bab0c722be12393cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
