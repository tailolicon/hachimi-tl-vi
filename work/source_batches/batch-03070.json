    },
    {
      "uid": "zhcn:d89a8a3c8ede74cc793ea6b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——谢谢您。\n承蒙您的关心——我很开心。",
      "source_fingerprint": "74713e29adc699fca93a197ed9b706200fbfcfed36c2d27879fa918e755635a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134005.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:19f689d9103e36414d774d9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
