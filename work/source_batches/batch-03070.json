    },
    {
      "uid": "zhcn:52759153bca6305f01484d31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是——没关系的哦。\n我很喜欢照料花朵，您的心意我心领了——啊。",
      "source_fingerprint": "37146c3b7017a122b55d23a21ee004cb89117c5ea6f34553ec8841f8cbccf81c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134005.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:174f087c480f80321b8c525a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样啊……我知道了！我会再来的",
      "source_fingerprint": "ac0c710713d5dd0f63a501bb7935cc6a2f35cdc04e71fe21c6d6ad045249956b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134005.json",
      "json_path": [
        "text_block_list",
