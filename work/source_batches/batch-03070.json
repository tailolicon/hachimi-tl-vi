    },
    {
      "uid": "zhcn:032e470f8718852398a99504",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个，如果不介意的话——您能再来这里看看吗？\n花朵们，如果有人欣赏的话……我想它们也会很高兴的。",
      "source_fingerprint": "54fbf1d122242763a1121024e72d5caf04321e03c4f06331fd39a48e774a5f29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1134/storytimeline_041134005.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:ea7ca3b5d7cbd425792c4b59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
