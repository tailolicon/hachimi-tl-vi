      "source_language": "zh-CN",
      "source_text": "土壤——嗯，没有干。\n看来不用浇水了——",
      "source_fingerprint": "2f2db42490d1ec576a5b1706ae0d0c86bac9a5c81c765b527d17470d3bca8ca3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
