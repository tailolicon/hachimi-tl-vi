    },
    {
      "uid": "zhcn:63153ad2a25ba8f59ae4dc33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶……？",
      "source_fingerprint": "90ee136f9002ca365cd94631fb494ae2b110de6a701e7c10482b1351bc6a12aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
