    },
    {
      "uid": "zhcn:a2cb078354460ac9fb7334be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好……既然这样，我也————！！",
      "source_fingerprint": "2d610173b56057af6db99a147dada1a7f3bfdf83bbe891ed37ab356bfaac490d",
