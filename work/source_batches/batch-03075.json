    },
    {
      "uid": "zhcn:6ac5dec6ef647ca3fa62fc8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这还真是没办法了啊……！",
      "source_fingerprint": "0ad774cc87f139f60ec48ad2ca93cfc57ba93e84f63d4e4525168d23b82b59ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
