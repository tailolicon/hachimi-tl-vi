        "name"
      ],
      "json_pointer": "/text_block_list/44/name"
    },
    {
      "uid": "zhcn:edb32e303e933adddcdb4025",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知不觉间，我的兴趣已经转移到了黄金旅程本人身上，\n而那股冲动，正驱使着我踏上某段旅程——",
      "source_fingerprint": "c71a7c3417f11d464fc3e23277f2100557df0b790d8d9226f4c9d7b48fada5da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135002.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:3ffac169e790c6a52a493590",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？？？",
      "source_fingerprint": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
