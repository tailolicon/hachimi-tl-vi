    },
    {
      "uid": "zhcn:28ff86a3bee46e918f67a855",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……历经数年，在漫长旅途的终点，在那片异国他乡。\n那家伙终于……抓住了那份独一无二的荣光——",
      "source_fingerprint": "006b63a1a4e008a808d1979afbd8383f17f80848307a23fb50cbee613334f0d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135002.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:ec028ad5be783a1e488c4a57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？？？",
      "source_fingerprint": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
