      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:2b1d7b7ff6b522cf8eec059d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老实说，我可能觉得有些兴奋",
      "source_fingerprint": "deb693b48a0ecaca8fd77dc2ffd0301de8a2c88395cf9210106b7384296b05d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
