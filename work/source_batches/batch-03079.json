        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:aedd44e8c88a8a6b545c5164",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得那样，未免太可惜了",
      "source_fingerprint": "5fab76a1f289b071b2ace57edd8dd4afabe09442cbbc4d9d019090067f4f09e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135004.json",
      "json_path": [
        "text_block_list",
        34,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/34/choice_data_list/0"
    },
    {
      "uid": "zhcn:67881d8361deab4cb9bb3d91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得那样，未免太可惜了",
      "source_fingerprint": "5fab76a1f289b071b2ace57edd8dd4afabe09442cbbc4d9d019090067f4f09e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
