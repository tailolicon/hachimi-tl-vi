      "json_path": [
        "text_block_list",
        37,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/37/choice_data_list/0"
    },
    {
      "uid": "zhcn:502bba29659c9fc6a10f284c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为训练员，我想要实现它。让她超越另一个世界的自己，\n走到最远的地方，抓住全新的荣光。所以——",
      "source_fingerprint": "4fed8211748c5e67066bb66ae596710bb106847cf167647d17b56ef43a58bc12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
