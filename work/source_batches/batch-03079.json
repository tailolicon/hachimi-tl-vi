        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:0e481780dd060a4c610072d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知为何，从出生起这些就被刻在了这里。\n……嘛，虽然有些部分很清晰，有些部分并非如此。",
      "source_fingerprint": "59048d0a705419b5ab3fe1c0da5b6cee7b7268ba30aa385b8d8d14ae48713cf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135004.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:5c611171450e2260fd844719",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "解说",
      "source_fingerprint": "9ca0a41d5cdb419c4fd19aae6febfbb7f658ff014636b5d29d31bc0d0771b290",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135004.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:fea936c8d85a16c49e94c972",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好了，马上就要经过第4弯道了！\n黄金旅程在这里，冲到了前方！",
      "source_fingerprint": "0b4748abb53d7e1a92e7a15a612f73e54329084dd509c6fd412ec7d8bf300358",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135004.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:e2ba80fb557544aadfff3a91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金旅程",
      "source_fingerprint": "7fef5d2663b1ecd0a83b6099bc2404725a8014ed3026be24cf29a2dbd3ead384",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135004.json",
      "json_path": [
        "text_block_list",
        21,
        "name"
      ],
      "json_pointer": "/text_block_list/21/name"
    },
    {
      "uid": "zhcn:9ba1a59d6c2a9e4d2b5f461c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――……来吧，我们走！",
