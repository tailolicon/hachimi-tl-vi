    },
    {
      "uid": "zhcn:8ed69a261099a616a8259f17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我们开启一场，足以打破所有过去的全新旅程吧！",
      "source_fingerprint": "351d8074d5258a4bf9caf17cf52fa245ab21dc338370b84cfee6ed4d6f950b73",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
