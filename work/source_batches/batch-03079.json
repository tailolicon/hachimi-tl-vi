    {
      "uid": "zhcn:ce1e341af68439858c5451d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "提议？……什么样的？",
      "source_fingerprint": "b807f247236d71303481ea1a8567e482d568620affc627995181e3f7bb8d5d50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
