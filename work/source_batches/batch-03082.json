      ],
      "json_pointer": "/text_block_list/23/choice_data_list/0"
    },
    {
      "uid": "zhcn:f0c60efcc27dd39275fdf495",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被黄金旅程带到的\n『多国籍料理店』，充满了未知与——不可思议。",
      "source_fingerprint": "52247e021e39760828e54c8a944918048ce8cbc0cd1c7cf959287d367cb7ce17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135006.json",
      "json_path": [
