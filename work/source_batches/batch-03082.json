      "source_language": "zh-CN",
      "source_text": "黄金旅程",
      "source_fingerprint": "7fef5d2663b1ecd0a83b6099bc2404725a8014ed3026be24cf29a2dbd3ead384",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
