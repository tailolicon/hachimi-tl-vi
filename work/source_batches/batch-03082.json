      ],
      "json_pointer": "/text_block_list/27/choice_data_list/0"
    },
    {
      "uid": "zhcn:6b84c568095901668a2cda38",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然看起来相当写实……但还是抱着对生命的感谢，\n战战兢兢地尝了一口。",
      "source_fingerprint": "297d8c2d6f5cbf62e29b1e8d1007bc4952a400e50ec16cb15803e3ec21a83a61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1135/storytimeline_041135006.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:6a45c1510792e9470916926b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦，像仙贝……一样，意外地挺好吃",
      "source_fingerprint": "f6ee0fb9580f0c93767b7d842aa8ca9d513b386f176ed6151a542379f6e655ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
