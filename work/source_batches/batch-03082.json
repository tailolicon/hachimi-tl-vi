    {
      "uid": "zhcn:81d27ab9809bd083442ad7bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——闻所未闻的辛辣香气。\n从未见过的文字，以及从未见过的料理卖相。",
      "source_fingerprint": "5a16d9041db663caab02aecd2fc0ae27b7a1cc006d455981a35cd188e6a210fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
