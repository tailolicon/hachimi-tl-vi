    {
      "uid": "zhcn:d827f0d90cf4771277129fd5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔……！我可不会输……！\n哈啊啊啊啊啊——！",
      "source_fingerprint": "70306f088d1cbe76e967935f744ff5966684b9dffca913d9a9bf4188eefacf93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136001.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:83de515ea9a295dfc7c38038",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（难不成，会就这样冲线……！？）",
      "source_fingerprint": "efc48cf65ffec1e0ae7490b732de53c0c868a735a01d05bde5528c6762553a4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136001.json",
      "json_path": [
