    },
    {
      "uid": "zhcn:7d724263beee78927a1db456",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟是以那般自信满满的状态发起挑战的。\n原以为哪怕是红色梦想也会大受打击，没想到……",
      "source_fingerprint": "ee1e8af8c2bc8e973c484aee8919f63971676210cc3fd3dbf47ae9c810acb2a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
