    {
      "uid": "zhcn:4ac32f007b4ade572460fb55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家，今天请多指教啦。\n我会为了跑出一场精彩的比赛而加油的！",
      "source_fingerprint": "22040fc45041a62bfd3c41efa087afce5b9a4d91707478a6b17d19691030f0ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
