    },
    {
      "uid": "zhcn:e26efdc829d41318ba93ca2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致",
      "source_fingerprint": "8d00a4803d17b32d08d3d9ae9844b52810f0b4162c25dd8d8a1226ea163081d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136001.json",
