      "source_path": "assets/story/data/04/1136/storytimeline_041136001.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:cc9858288d16ccfe3355800c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的名字是迷人景致。早早就被视为明年后冠路线的\n头号热门，是下一代“女主角”的候选人。",
      "source_fingerprint": "ffa0e1a92f829a71a12b363ad76d3d054d34250e8d76735e1782a819e4fbe0f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136001.json",
      "json_path": [
