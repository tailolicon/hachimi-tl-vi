    {
      "uid": "zhcn:ecf99721a78c9be54232d20d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我以前好像也有过那样的时期啊……",
      "source_fingerprint": "881658821eb004c2497b8f8e41257f6b4e6476c62b5d2caba5e0b06b933b3fa1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
