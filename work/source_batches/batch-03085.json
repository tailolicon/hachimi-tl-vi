      "uid": "zhcn:3e3a78a272f66e6f00fe20a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——下一次，我绝对不会输。\n因为我，可是圣女呀。",
      "source_fingerprint": "7198029245c05a05562925a8e044eb907202367609f8dd0348724ca35e14fcc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136001.json",
      "json_path": [
