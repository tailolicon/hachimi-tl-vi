      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……呼……\n终究还是，没能触及吗……",
      "source_fingerprint": "68a22de99b101988878c5ff4c8bd0b926958958430c86fdd4536c0ffef63cd0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
