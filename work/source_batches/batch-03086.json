    },
    {
      "uid": "zhcn:3b12d8fb27e575c68f16f712",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个，我能跟去看看吗？",
      "source_fingerprint": "f37abb58aa09de63b53293e0e00c67a98f16c9e0ffa0a6b35265927bf49301c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136002.json",
      "json_path": [
