      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——哎呀，有人在呢。\n您对圣女的奔跑……产生兴趣了吗？",
      "source_fingerprint": "e58bf9f646207170dabfe4ff79ba35498731a34d1f4d1728db462a16e9f8a28a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
