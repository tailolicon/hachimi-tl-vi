      ],
      "json_pointer": "/text_block_list/18/choice_data_list/0"
    },
    {
      "uid": "zhcn:caff33720a982afa69337621",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她是打算在校外继续进行训练吗？\n我很在意她这次又打算做些什么。",
      "source_fingerprint": "b25e4d700c8fd741f520cbd537548a4fb1d3668747152bb61262c7ebe530f3c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
