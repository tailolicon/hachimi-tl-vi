    },
    {
      "uid": "zhcn:d69875b57f456c5de4ad262b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "举止粗鲁的赛马娘",
      "source_fingerprint": "2a6d39b95c7faea9e53335524157a458a484f24c0cb3d09c249f2848de3e0733",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136002.json",
