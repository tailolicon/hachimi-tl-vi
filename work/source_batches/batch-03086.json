      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天在校内的训练就到此为止了。\n我准备外出一趟，先失陪了。",
      "source_fingerprint": "c03a8565ccb75e2fcca38320d483bc8d20ea4b44263496d2b9a7b95cb5190ec0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136002.json",
