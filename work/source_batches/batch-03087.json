      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，当然可以。\n请尽情见证圣女红梦的奋战吧。",
      "source_fingerprint": "9666f37a8d46317e283a2e8a590485a967efdf17474ae9bce959a44edd1b6be2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
