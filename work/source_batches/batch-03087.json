    },
    {
      "uid": "zhcn:29671c2596f06ca04c1da67f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其中，她的比赛才能更是出类拔萃，令大人们都叹为观止。\n备受鼓舞的少女踏上了赛事之路。可是……。",
      "source_fingerprint": "8f665d143fb26d5236e2d86aca390e6e0fa955319c82f5cce36b2422aab466fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:33ec2474de5ddc4913a51f9b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "教练",
      "source_fingerprint": "4fc1343aa793eed667383e128a93c25d4bc68914bb222c917311fb8a8442fa18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
        "text_block_list",
        14,
        "name"
      ],
      "json_pointer": "/text_block_list/14/name"
    },
