    {
      "uid": "zhcn:30906d811ec1f6460e4da82b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
