      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:a3354dd0fc415b22e21a6c2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……异、『异世界』？",
