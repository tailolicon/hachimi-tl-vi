    {
      "uid": "zhcn:12d9bc459c3adfe6618a0ca1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……！我还……不会气馁……。\n必须变得更强才行……否则，就无法抵达异世界！",
      "source_fingerprint": "2bbab65793f360c7acf2c656d2cb4c56bb0a22e6a045358748fcb24c295c2cc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136002.json",
      "json_path": [
