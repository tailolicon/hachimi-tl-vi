    {
      "uid": "zhcn:5ed890bef96eb3de8fdb7847",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实我，在小时候曾得到过天启。\n得知自己有朝一日将会转生，成为拯救异世界的圣女。",
      "source_fingerprint": "659a1ab27fc651358b5000e0d12d38d35a4b97e51df5b5e308d7e3956d946629",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136002.json",
      "json_path": [
        "text_block_list",
        9,
