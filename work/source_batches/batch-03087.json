    {
      "uid": "zhcn:fd2c4384ada6a43608b503ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎呀……！您听到了吗？\n啊，听到这样的话，确实会让人很好奇吧。",
      "source_fingerprint": "baf07c5980f3742058c790b4a4bef1c71b32e253f18cbed46ed194f8f96e988e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
