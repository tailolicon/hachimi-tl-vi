      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:a68864a22f9d89a53c6b257d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣女的奋斗",
