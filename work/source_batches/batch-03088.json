        0
      ],
      "json_pointer": "/text_block_list/5/choice_data_list/0"
    },
    {
      "uid": "zhcn:13908cfa283116d13fd3e39d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自己并非什么特别的存在。\n明明早就已经坦然接受了这一事实……。",
      "source_fingerprint": "f50bb18fbdb76af992fe3be9a072b98d4fd45c5b0942ba41ff13215f39496ac1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:81dd8fc0925d0c82d88c4105",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自己究竟是不是个『凡人』，现在定论还为时尚早。\n哪怕跌倒无数次，或许总有一天，我也能散发出属于自己的耀眼光芒。",
      "source_fingerprint": "090424ddbdf9a04bad808367182e9dd01d1d6b844cb594e349f9ba8b74433e4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
