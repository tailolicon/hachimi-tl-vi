    },
    {
      "uid": "zhcn:c7a2228dc5aa491e98446290",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "便让我，为您降下圣女的祝福吧。\n赐予您能重新坚信自我的……祝福。",
      "source_fingerprint": "8c8b8a47599c04d5c9390dfe0b8d28d66663a495912dbb278028912962363360",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
