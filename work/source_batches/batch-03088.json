      ],
      "json_pointer": "/text_block_list/46/choice_data_list/0"
    },
    {
      "uid": "zhcn:35d9ac724672a80073fffdf1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我还想试着相信……相信自己吗……？）",
      "source_fingerprint": "39f4fb7ee2bbd989a08ca44710616312728839f8a59efe4881cc5ea253e8b40d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
