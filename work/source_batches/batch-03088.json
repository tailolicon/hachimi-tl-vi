    {
      "uid": "zhcn:8c4d4a5725a4aa23f3b0e6d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为何这番话，会如此深深地震撼着我。\n难道说，在我的心底，其实依然……",
      "source_fingerprint": "9c6d162c4eeefc2386499cc340a1ea83d4d5378485b565bf01aca796d842c43c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:c2c3d840e31b6b5f7d5f4054",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
        "text_block_list",
