      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:e77c34ac94fc4614d2892681",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也……试着去努力一把吧",
      "source_fingerprint": "344c964f9fec4a2882317866f34375ff85696206480d3879b8f889a48cd994c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
