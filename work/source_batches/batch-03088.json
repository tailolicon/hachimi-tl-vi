    },
    {
      "uid": "zhcn:196be4a519dc07cde36791f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是答案。忧愁彷徨的人啊。",
      "source_fingerprint": "b0892040b5a6fdd1ff8bab9d8ccb352987cf0f1ac5050862e00e1ba270b2758c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:acd9f810cdc1b1a198b3b241",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我还想试着相信……相信自己吗……？）",
      "source_fingerprint": "39f4fb7ee2bbd989a08ca44710616312728839f8a59efe4881cc5ea253e8b40d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136003.json",
