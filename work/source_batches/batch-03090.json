      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的！",
      "source_fingerprint": "49dffd45dbcf3cbb7b2debd6497fb9bed179e4b28d71fa232c2a34524481b72d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
