    {
      "uid": "zhcn:b017a264a503e6b574b14c7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为我——可是被命运选中的圣女呀！",
      "source_fingerprint": "36efb8e7d8599c6ea0fcb90e1444f495a70dbdf1080b0338cfa125bab70ab6c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:e4c06954ec68ccf8a9da44de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
