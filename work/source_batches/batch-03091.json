    {
      "uid": "zhcn:87d18916f73185ffd0600db5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……无论面对怎样的灾难，都能将其当作“考验”来积极面对的\n红色梦想。她那强大的内心，确实非常值得我虚心学习。",
      "source_fingerprint": "14c49d48fa301f4b73e5d2f081843ea6dc5723dba4c8c9a323e2fc6a491d0733",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:d8d248e40ef19a8fcf0aa186",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
