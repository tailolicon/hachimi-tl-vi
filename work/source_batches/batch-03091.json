    {
      "uid": "zhcn:1d6d85cf0a0e4f84e71cb5ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——那么首先，先把长手柄的工具挪到角落吧。\n底部要放比较轻的东西，对吧。",
      "source_fingerprint": "f6a777f33bafeeba0b4ff6dab231367009f055192e453e50e582b308f68f223b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:7579149360539c436645af1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "整理柜子，我也来帮你吧",
