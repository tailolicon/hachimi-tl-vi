        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:d15834a465e317d902024579",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天呐……！这项考验，您愿意与我共同前行对吧！\n那么，首先——可以请您先把那边的拖把捡起来吗？",
      "source_fingerprint": "e49be15e5179682407d19e8fe647f65c2a064e385a5161bb7f51fec3bbd89028",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:72889671d113ca5701516f8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要是不介意，我帮你一起找吧？",
      "source_fingerprint": "c682cf0f685aac756361c94bac0adb8794a58942a310d9a99c7387435ce00c0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
        "text_block_list",
        4,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/4/choice_data_list/0"
    },
    {
      "uid": "zhcn:dce7b0ae1272b583ebd51cbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
