    },
    {
      "uid": "zhcn:c1ffbf6d0b5e75850ed1fa67",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我已经找到了『中世纪胡萝卜大全』和『世界古城巡礼』，\n但不知为何，唯独找不到那本『关于赛马娘的传说辞典』。",
      "source_fingerprint": "22a686aa5ac65700857916a68af19e35186614542893a4c6173192c9fa716bbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136005.json",
      "json_path": [
        "text_block_list",
        4,
