    },
    {
      "uid": "zhcn:01a923415fed483388417f5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
