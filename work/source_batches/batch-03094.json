      "uid": "zhcn:dbcaeb9089d5f52b7060dd29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而能与我携手的人，不是别的人——唯有您。",
      "source_fingerprint": "42549fe257c7f4c564e2f7211076214aaf201e4e2a30cdd54707bdce49ea5b42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136007.json",
      "json_path": [
