        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:1933c3f8597b2cf1c138ae8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136007.json",
      "json_path": [
