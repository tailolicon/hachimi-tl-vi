      ],
      "json_pointer": "/text_block_list/51/name"
    },
    {
      "uid": "zhcn:d470d1aa9066ae598c736890",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，我做了一个决定。\n为了不让心头被“阴影”所遮蔽，我要在体内，不断宿入温暖的“光芒”。",
      "source_fingerprint": "a8e6c176c353b61d6f51d4a565ce46d1dd341e302e0f1c8a80ab6aaf42762f00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136007.json",
      "json_path": [
