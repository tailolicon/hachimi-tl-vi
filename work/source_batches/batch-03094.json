        "name"
      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:e91b0a230a538bcf292e3625",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便如此，我也决不会停下前行的脚步。\n因为我，可是肩负着使命的圣女呀。",
      "source_fingerprint": "f21b2f7498abfdc7633b41e84cdc2ca116d68b02963b4679b33c09f19733e5cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
