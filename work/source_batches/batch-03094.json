    },
    {
      "uid": "zhcn:65fab2145341c5c06253457c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真的吗！？既然如此，那请务必！\n让我们一同踏上旅程吧！",
      "source_fingerprint": "f574023366a24ecbc4f4197ca3bb400b2cebb867404f373728d16f96d8f07fef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1136/storytimeline_041136007.json",
      "json_path": [
        "text_block_list",
