    },
    {
      "uid": "zhcn:9ee42697743d80e07c7ff3eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……放弃的话就结束了！主人公是不会放弃的！！\n所以故事才会……――变得精彩！！",
      "source_fingerprint": "a61228fac3b79ca5eb48c47244aa7a8a3060f944266ed3cf03868ceb2a63627c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
