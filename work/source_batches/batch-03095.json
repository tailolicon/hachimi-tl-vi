    },
    {
      "uid": "zhcn:6cf7cc3c7eb2681ee2cb2bc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "什么时候，为什么！？\n而且，那个位置――",
      "source_fingerprint": "f40b723bf8a27c51d550870b8efe8ccba80ad42be87d2bf2861328b3b51664ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
