        0
      ],
      "json_pointer": "/text_block_list/14/choice_data_list/0"
    },
    {
      "uid": "zhcn:f9fd054584258b02faaa19f7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定胜负的是最高速度的差距。\n虽然名为神业的赛马娘结果上是败北了……。",
      "source_fingerprint": "7f0c6a38cdc59036245d642281af6798a35fcabb19b8fc4750e9f7226caf062b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:68ddd913e7a5256236fdf46b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成长空间还很大。希望她能继续磨练腿脚，再次挑战――\n作为学园的训练员，我抱有着这种理所当然的期待。",
      "source_fingerprint": "ef7e423a2562096c0bed3b5fa3588bacaef2737beb6e78b3996066d8a3cf284f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:536e6c4df4457094842c1a8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那是第二天的事情。",
      "source_fingerprint": "335e40f9a4470237d786204bd045a0ffdfd291251c1320947399b667d4421fea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:4c4123d1cbb84a6e1dd7f389",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "才隔了一天，就在决胜负了！？",
      "source_fingerprint": "f99e50a55e5bf805a9c2d76f1b26143f1e76dae8108548e31f636d761ab3606f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        17,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/17/choice_data_list/0"
    },
    {
      "uid": "zhcn:96fefc507d2e7356ccbbd692",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奔跑的赛马娘们",
      "source_fingerprint": "a37fc3ca28628901ca63d3cbfbd1fca7da0856c81b0b1157f4e8582ceb05e938",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        17,
        "name"
      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:fe2bd380d16e94caaa09d4f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呀啊啊啊啊啊啊啊啊啊！\n哈啊啊啊啊啊啊啊啊啊！",
      "source_fingerprint": "76c2314a8b89b188c137832dee9b1a7f4d32d8ebe603e71632376a450328f1fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:902d78344212d84d63dd7418",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前辈赛马娘",
      "source_fingerprint": "2e7645dc276fc124757cddb14e278062a801b936eefcde6300e438f02adb09b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        18,
        "name"
      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:dbde5fab304b5341e4017200",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真是的～好缠人！放弃吧！",
      "source_fingerprint": "f85da751d89bf17d6acd8e09e5f61561264ee43318ea99b902281a2a01bad783",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:3f30002e6f84bdbb9a7bbcef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        19,
        "name"
      ],
      "json_pointer": "/text_block_list/19/name"
    },
    {
      "uid": "zhcn:a3fcd54200ee5a589dcc7c40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，我神业！绝不认可败北就是『腰斩』！！\n欧拉欧拉欧拉欧拉欧拉欧拉欧拉啊啊啊————！",
      "source_fingerprint": "d3910329114c1aefc85b29cc3b93d75600720fe36d318d99f4501530804b277b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:cf9d3f532a8935c8bb4e1bbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "★――下期，神业疾驰！刻下震撼心灵的蹄印！！",
      "source_fingerprint": "63c54b498708fc7cd5d47be3a08d6545d0aac1928d01f724af518a6a6a9a1fdc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:4bdc2a02ada7743abea9c6bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（虽然想表扬那份执念……！）",
      "source_fingerprint": "dfdf5cca6b23ec7f76c1d43caf1d5a97d105df1657300d61c5ce45f60c19a258",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        20,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/20/choice_data_list/0"
    },
    {
      "uid": "zhcn:4ab61ef4be46c234339c8736",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，力量的差距显而易见。\n无论她多么不屈不挠，恐怕也只能再次品尝和昨天一样的败果吧。",
      "source_fingerprint": "a62151b7a1a045ec5e002540f088b1ebc4e4a2a15795b3a734d59684eec55bc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:8b912d083c97b84c01629455",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是的，这时我是这么想的。以为她是死缠烂打\n在做无谓的挣扎。这在学园的赛马娘中是常有的事――",
      "source_fingerprint": "ae9619bcb6fecbac282f11fd45869fc3719ac45e72016b7ce0c3173f880cf613",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:d5c4a4f860c3b10914dae7c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――！？速度提上来了！？",
      "source_fingerprint": "d6c1c2d4a30b22f15dce3fb3e384276cc90b40a1de6e9cf4963df131efa6deaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
