    {
      "uid": "zhcn:2a01220345374f61916fed64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，阿勒勒！？啊～～咧～～～～！？",
      "source_fingerprint": "40a1a7e17eb0fa184995f39525c33dccae23ef346e43b9009779b24731a11593",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
