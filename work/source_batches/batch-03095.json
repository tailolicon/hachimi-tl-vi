      ],
      "json_pointer": "/text_block_list/25/name"
    },
    {
      "uid": "zhcn:42a531c11fc71a6a30c7f2c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毫无损耗地！将你！超，过，去，啊——————！",
      "source_fingerprint": "bdb9815e75dd79f157d4e43c0936938bfc606b87d90ed70675b0ca704c48eada",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:e203b63d5dab6adcf066aa0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她瞄准的是最短距离。对手向外侧膨胀，节奏被打乱了。\n……仅凭一瞬间的差距，她就将胜负逆转了。",
      "source_fingerprint": "ad7594c7d284872b27c118f8996ddb6fc1e123edd413c2500fd66c2abd453b84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:0939f7f004d62852aed3f5a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        27,
        "name"
      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:848320fad7487bcfa22c56b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好耶——！大・胜・利！\n…………嘿嘿……！",
