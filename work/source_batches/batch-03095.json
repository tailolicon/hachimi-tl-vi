    },
    {
      "uid": "zhcn:6b587278524836abc1d74af1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前辈的内道我就收下了！\n留给我的逆转关键，就在前方的弯道……！",
      "source_fingerprint": "fac7b1773910c2703e6e370ae0a613e4794e224d7c301a9565220708918cfa7b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:689a535ae75522b3411158f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
