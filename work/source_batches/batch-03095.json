    },
    {
      "uid": "zhcn:06c98e71f6ef071989927d1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……跑得不错啊）",
      "source_fingerprint": "70e3ef99a56309e9239b464b3be667a6012c7f7c89be712a6c152ed8b378cde4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
