    {
      "uid": "zhcn:063f04078d40fd0952088358",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我有，想要让你看的漫画。\n我觉得……你一定会喜欢的。",
      "source_fingerprint": "a5d8df0a241c38a2ceefafa3f14d419fc61f7e70ad1f99f6bcef2fda5aa25841",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
