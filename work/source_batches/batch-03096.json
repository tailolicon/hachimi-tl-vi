      "uid": "zhcn:a2f8b363d664d341d0c0a04d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――所以说，训练员！！",
      "source_fingerprint": "d5f2c20d6db3f1450d2bd511f8878823e5bea429e1f2197e436f4413138de7e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
