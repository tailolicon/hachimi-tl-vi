      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:fd5901fc938640a97e107768",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以你为主人公的……！",
      "source_fingerprint": "1ee8bcbf68eda1332bc6f5c232d94beecca8c7d48c401ac5527bc06585a303f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137001.json",
      "json_path": [
        "text_block_list",
