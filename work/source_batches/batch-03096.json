      "uid": "zhcn:aa5fa66fa5c95abddc333dde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有想要我看的漫画？",
      "source_fingerprint": "b2e38816542d9916e53480f673aa78c684110679b742f4202623129f47fe9723",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
