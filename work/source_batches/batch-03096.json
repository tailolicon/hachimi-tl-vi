      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……等待着神业的，是过高的障碍。",
      "source_fingerprint": "90605cf513cff1dc614777a7e65c88493692d572a1ec372f9bf8710c992ee1e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
