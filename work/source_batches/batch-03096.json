      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:e083a8053b9e9cfd797c1a06",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业将她拿着的平板递了过来。\n那里显示的漫画是……。",
      "source_fingerprint": "7f47d78d64166b6fb784bd13e96fc1f9f64b1c02cf5a2e83331fea6a61f2097d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
