    },
    {
      "uid": "zhcn:983dc563d448b057cb6c0496",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――……这是，我的『故事』。",
      "source_fingerprint": "84a04ab969c6498653e4aca0b5643265b2821b484f8ce72d1d3d99b87b83ce6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
