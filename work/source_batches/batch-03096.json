      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想要成为那部作品的主人公！\n赢得比赛……作为胜者闪耀！",
      "source_fingerprint": "123ab9b6e745017a20bdfbafb3d789d87794db486f1bb871449fde85b4428995",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
