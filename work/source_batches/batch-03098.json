    {
      "uid": "zhcn:ee83ae42c6c325f0ebbb4916",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "到底是有多期待啊！？你这个人！！",
      "source_fingerprint": "c5d647b6010f532c756cfa07562fcc9235901825bb6915232cd5793268116aba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137003.json",
