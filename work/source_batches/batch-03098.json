      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个保留，这个废弃……",
      "source_fingerprint": "80e1111ec5a4bfa30f31d1ca4e784739bf03e4386c65af8319560ba11eb3c663",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
