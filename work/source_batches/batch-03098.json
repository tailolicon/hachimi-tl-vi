    {
      "uid": "zhcn:066b1092c95e7ca7b0296ff6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是在赛车漫画里看到的！说是比赛中过弯速度和直线最高速度\n一样重要！所以――",
      "source_fingerprint": "492672dab0bc308e8747ca8adef943b65015672bb1b1815a3e9e0791ed6bb545",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137003.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:b624e2da560d64ef2526a5aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，我不是单纯想废弃它！",
      "source_fingerprint": "b0377f311a2769331841dcb4bbfb8638927a1e761302dfb08b67b283b6e29118",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137003.json",
      "json_path": [
        "text_block_list",
        12,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/12/choice_data_list/0"
    },
    {
      "uid": "zhcn:5af778749bd04bbcdb04565b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137003.json",
      "json_path": [
