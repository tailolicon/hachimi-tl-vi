    },
    {
      "uid": "zhcn:5354a8f5548e6cfaff3475b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "闪、闪现了一个不得了的方案！\n――总之请听我说！！",
      "source_fingerprint": "9a1165d3dddc9489ab70645b1b3b282be082a584030f9fa724565c2ffc6a8da1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137003.json",
      "json_path": [
        "text_block_list",
