    {
      "uid": "zhcn:f09ce3414ce3f8f92a5d3ab9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――唔，训练员！果然还是抱歉！\n那个，平板上的方案果然还是作废吧拜托了！",
      "source_fingerprint": "fd80ef78e8b1f7ad84df7d0ce142cbab13440e73b9c24d86d6ffe4dc20eebc83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
