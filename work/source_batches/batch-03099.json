    {
      "uid": "zhcn:739e8e8979af1fbaa714f107",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――唔！！",
      "source_fingerprint": "66a4c6dddf166eec9f353e3c096db194dd1e5d4d53f390033dbc6a149aa583a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137004.json",
      "json_path": [
