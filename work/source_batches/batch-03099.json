    {
      "uid": "zhcn:2b4b38fda4f95e951e04943e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――……数周后的现在。\n对于和她一起构筑的方案，神业也感到兴奋期待。",
      "source_fingerprint": "e03fd14269e1cff23262f083f2e8ead3e6946b1f4116f8d7af9f7e1f15a18a1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
