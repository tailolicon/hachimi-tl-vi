    {
      "uid": "zhcn:66d32b34842ef75a0275eb56",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然已经迷上了她的奔跑，自己也不能输。",
      "source_fingerprint": "bcebf7e9cad61c6bf2328b282377c237c1e53d252c6c774baa32b7d0b1b0c2a7",
