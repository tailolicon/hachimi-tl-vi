    },
    {
      "uid": "zhcn:a662ff8d83473c053d910f13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈……哈……――……还没！　还远远不够！！",
      "source_fingerprint": "36edac42d358567a84f78e82b94297794d3b3fe0231089372d05ddbab88cb04b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
