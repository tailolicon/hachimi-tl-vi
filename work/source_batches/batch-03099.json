    },
    {
      "uid": "zhcn:0b4d4924502d8537cb7aabe2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也必须，全力地面对她！！",
      "source_fingerprint": "766a9a028255d1e0b9e16eb74480d9c7f8dce29c3c94a827548d00958d14dc5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
