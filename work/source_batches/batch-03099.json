      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:4cb3b3de9c491b931f4f1aa1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "冲啊……、神业……！",
      "source_fingerprint": "f2b3ada9e6886a5362c3b28b1e9f9030a7b6698325a7fcc9e25d59c5fc7efacb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137004.json",
      "json_path": [
        "text_block_list",
        28,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/28/choice_data_list/0"
    },
    {
      "uid": "zhcn:63d0f1d75dda5227f3af347c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "去吧……、神业……！",
      "source_fingerprint": "e600217566a029d8fd0640d14b23515d2ce4ce781e2940a7ead6e4bf63256b4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1137/storytimeline_041137004.json",
      "json_path": [
        "text_block_list",
