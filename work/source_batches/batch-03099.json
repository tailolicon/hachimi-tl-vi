    },
    {
      "uid": "zhcn:4fb1b73c44dc88d3d2ea464b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（这是，训练员这边的“战斗”）",
      "source_fingerprint": "18e4566ff3b362523841dda1f12945c76a7e2304dfb5507ac9a979227d0725db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
