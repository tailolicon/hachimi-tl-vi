    },
    {
      "uid": "zhcn:f876a735d21dd41a162720cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的，我们是这么认为的",
      "source_fingerprint": "eb39d63e0ac2b5fed71ae4b499226a8d2fd456547ead9d54b860e6558538bc1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
