    {
      "uid": "zhcn:003727fd9608606216d2caa5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最最有趣，最最热血。\n宛如漫画一般的――神业的故事。",
      "source_fingerprint": "cb7d6b82ecfa4fdb4e02c5dee420957a408de3c8bfa41ec68ca2a7cbd03fcffe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
