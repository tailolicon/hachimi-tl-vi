      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "资深训练员",
      "source_fingerprint": "f0e5584c3cb99d8bdca31a777c0c8b05644dd3c6a9cdf1918b8423e3053861bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
