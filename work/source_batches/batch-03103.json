    {
      "uid": "zhcn:58cf936ea3d3c1a2b504d705",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看来你获得了很好的经验呢！",
      "source_fingerprint": "85bc9e04351051f7c0b05f04d5fcf2813001103be35636d143f80ed6a0d1636f",
