    {
      "uid": "zhcn:d69b8deb2830b09e6d2c65c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中盘的，那个百货商场的场景？我特别喜欢！",
      "source_fingerprint": "de1128b70b80a8badfb7d4dd016cc38c8bd22b8f345ea40bb0de4068030e801b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
