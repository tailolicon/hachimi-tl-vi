        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:9ebb5bdf3354acf9274b1c21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……为什么会有赛马娘在这里？）",
