      "uid": "zhcn:5dffa6651053401e0d25c842",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（正式签订契约也是在那之后的事了）",
      "source_fingerprint": "b8f9ec816e9a12bd2893d087c9d9cfaaef3f853149b50042c35554a0a6a938ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
