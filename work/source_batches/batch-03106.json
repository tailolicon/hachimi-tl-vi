      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:c7203e105aa0d3cae1e91bd0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "倾听命运之声！",
      "source_fingerprint": "da69afda341cc1426fc6fe22fe80a0852ee6e8b9dd29c2b082639725aff9c2ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141001.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:482b72c6d9821b486e2c822e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（不对不对，光凭冲动可不行吧！）",
      "source_fingerprint": "df007f32d0936cecee9d406b9a419278c335b0994c428b1e1da6b5923da6d06c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
