    },
    {
      "uid": "zhcn:b4e4dc58f0717c04dcb19a95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "悄悄走进来的，是特雷森学园的赛马娘。这堂讲座，\n本该是训练员学习如何妥善指导赛马娘的才对……",
      "source_fingerprint": "dd24b8bd55ef7eb77034ed03006db9f17739705639a08369ad29600d916ee551",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141001.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:ec189a58bba3a7315db26e30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（在那之后，她应该一直在休养才对……）",
      "source_fingerprint": "17145c9db4c7c9b81bc3a1755d7361779da52b858df6744031adda8275b44da8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
