    },
    {
      "uid": "zhcn:c3aa753b5910db31d53820c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神威启示",
      "source_fingerprint": "e735e598796fe57089822ae34f1e2c5445cbb00ef02bd5fa7e58c55b26fa696c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        22,
        "name"
      ],
      "json_pointer": "/text_block_list/22/name"
    },
    {
      "uid": "zhcn:6f2dae8b1a3b31d53f0c07d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——……哈啊……哈啊……！\n……原来如此，只要像吉兆那样更加用力踏步的话……——",
      "source_fingerprint": "c328c3df46c6e033a0a31d45c0f0b76544eb17ce35d71f653b54ee9179841d96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:65642370232b75ed1437dc5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "命运……",
      "source_fingerprint": "d2b1a3d92ea785fc0198d02e2228baab2e14e8de8df04a688fcc54f1bf8f5695",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
