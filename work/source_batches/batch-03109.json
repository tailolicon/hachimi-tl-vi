      ],
      "json_pointer": "/text_block_list/23/choice_data_list/0"
    },
    {
      "uid": "zhcn:b5cab194b033c828ec4aeb8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        23,
        "name"
      ],
      "json_pointer": "/text_block_list/23/name"
    },
    {
      "uid": "zhcn:85edfc52d37fe5c93caec31c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吉兆同学用她的背影，而我则细心地用言语……\n我们两个人，一直在引导着神威同学。——因为被她的命运所吸引。",
      "source_fingerprint": "cada94d915d45b516c0daf36edc3f904cba7c36c029f6cf31dddd62cc9062bf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:5dbee18e19e2f4c409f6e527",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        24,
        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:f80e67f195f3f0282110d903",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之前为了学习指导技巧，我向未出道的孩子们搭话时……\n神威同学主动自荐了。——她说『感觉到了命运』。",
      "source_fingerprint": "795cadaaa36234da27c4f3b35e5dac8b5f058505524eeea5bf487270e6cdaf23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:eb45ae5a88f32cb28fc0d634",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        25,
        "name"
      ],
      "json_pointer": "/text_block_list/25/name"
    },
    {
      "uid": "zhcn:86eb539cbb1567c48eaccd22",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一开始我也很困惑。但是，神威同学非常拼命地跟随我的指导，\n而且……面对吉兆同学，她也咬紧牙关，从来没有松懈过。",
      "source_fingerprint": "1039a7c49cd667e0b423e5a2c26c20d5bba990a14782cc1713027ed16b4a94d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:7d9f101bc82417720c6523b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        26,
        "name"
      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:d42c03f6c6116be4c9507b2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她一次都没有屈服过……无论何时，都相信自己，不断向前迈进。\n带着那股势如破竹的冲劲，将任何阻挡在前的墙壁统统粉碎……",
      "source_fingerprint": "268c9c7900449141a7dabbe347ebeb597d60b8f42ba92b47e285e762185f4f3a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:4561855dd62b29e85ff4033b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        27,
        "name"
      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:4b0fc7398085d17d6cb0cadc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽管如此，总有一天她会撞上无法打破的高墙。到那时她所需要的，\n绝非身处同一赛道的我们……而是能够抑制住那团烈火的引导者。",
      "source_fingerprint": "a0794eb4f9bb700e88adf3d67b1bb66562b48eb0c1e9150ed42f244818a1f568",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:8bca7590db6be327925bdb16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是，这种事……根本没有任何根据……",
      "source_fingerprint": "7c8f97c97d70b4ce64497488b97e0cba56020a8ecc49ec1a3a4a48addaff12e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        28,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/28/choice_data_list/0"
    },
    {
      "uid": "zhcn:4eeb3b38cdc7c29e0580ebcb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
