      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:4fb6674ee246315497d1d052",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……！",
      "source_fingerprint": "8e34abed1ddb126fde54bfedaf035b92aac16d1e143243cc656102c6ded090c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
