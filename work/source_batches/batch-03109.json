      ],
      "json_pointer": "/text_block_list/28/name"
    },
    {
      "uid": "zhcn:c031689f03e139faee4b6b48",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而现在……你出现了。\n——这个被那孩子亲自称为命运的你……",
      "source_fingerprint": "0ca695ef527b3ce7607b6bf24d0bbccffa7e4b5c4afdebccb0c9b2224d369475",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:e1451cbac15fdd0c17732149",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉到的东西……",
      "source_fingerprint": "514300c4867a85c1889b11c3167d1b5cdb177e6e9bc185316070268cb4890220",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
