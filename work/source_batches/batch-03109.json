      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:613bf07d5f54c2681d66f4e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，正因为……她是这样的神威同学。所以我们，\n才会想要去见证她的未来吧。……你看。",
      "source_fingerprint": "db017048877a879ef61e861ea477dfafcb522b56d4b59e16fdaf1255bd59c86d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:c55b536bdbd25e957478e13f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1141/storytimeline_041141003.json",
