    {
      "uid": "zhcn:64b9f8ad94999eb4ca8a3828",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金发赛马娘",
      "source_fingerprint": "75941cf15f86c852b9b7bd466056dd01fa84167a182f1acb9e0014fee4c041e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1143/storytimeline_041143001.json",
