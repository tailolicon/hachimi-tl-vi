    {
      "uid": "zhcn:b56ad383b6b4ae288525f93f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这孩子……一定是很怕人吧。\n而且，它好像哪里不舒服，所以就更害怕了。",
      "source_fingerprint": "1bfc980f354780b2bc137ab8ecfc02793387f425a0094d09ab60a111739b9721",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
