    },
    {
      "uid": "zhcn:1d7820a0e64a204d120c83f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——她对于奔跑这件事，确实抱有着\n强烈且单纯的“开心”与“快乐”的情感。这一点毫无疑问。",
      "source_fingerprint": "69ef02160091e5cb1a986b90e5d117e4b190dffa2a398fb5dee30ed2860d5457",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
