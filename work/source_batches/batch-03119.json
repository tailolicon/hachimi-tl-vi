    {
      "uid": "zhcn:bf8eebd4570ce0fdb9e36ffc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？？？",
      "source_fingerprint": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1143/storytimeline_041143002.json",
      "json_path": [
