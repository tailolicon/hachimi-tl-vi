      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自暴自弃的女性",
      "source_fingerprint": "3e8a87a0dca07e6abe8cde65ab696930633ccd05b47db6902115ecb6f9eb3c26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
