      "source_language": "zh-CN",
      "source_text": "在模拟比赛前，我们两个人一起改进这个跑姿吧。\n一定还能提升成绩的。",
      "source_fingerprint": "3e2e28a78732c1ebe680d614f2991a8a7a9f60eb3c7cbc61bb7e5eeccd6f79f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
