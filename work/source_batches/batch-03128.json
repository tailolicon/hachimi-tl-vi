        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:37086b6f993d5260ee1256ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不愧是domi大佬！真是精妙绝伦的战术啊！",
      "source_fingerprint": "0ecc0a0ca673975f9ac7a7f3b93300767318f941f5a1cc15a14a9b2e7b10cb37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
        "text_block_list",
        41,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/41/choice_data_list/0"
    },
    {
      "uid": "zhcn:da722e5a018bebf2ad53b034",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说起来在选拔赛事时也是，出赛前和比赛途中她都表现出要强不服输的态度。\n只要“局势在按照自己预想的推进”，她的兴致或许就会高涨起来。",
      "source_fingerprint": "f571b16b9c37b2287d84f560880f5c948604b1e051892cd9949e25c756c8bbbe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:23d22720ef8a1bc1d1ea6c12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一边不断地拍马屁让她保持好心情，\n一边试着不露痕迹地将话题转移到赛事上——",
      "source_fingerprint": "9e96adf045b54666f54611a74bd74a14bae91d59842bf385b189fe92eca1d928",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:5a76562355b9f3f23ad35eda",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听说你的国际象棋也非常强！",
      "source_fingerprint": "0e811a25a22a6f5ef05cd771d3e3bdeee88996d16c0cea05340d8b2506c83370",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
