    {
      "uid": "zhcn:cff1c589fc92183249534bf5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………只能玩一把哦。",
      "source_fingerprint": "95ab3796da541c577eda2bd8f8e435dc45dced607af5a758c29af07531e2a0ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
