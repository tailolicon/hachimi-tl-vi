    },
    {
      "uid": "zhcn:56f562f6131a5aa21d2d5641",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "休想！",
      "source_fingerprint": "4c7eb4b73f29394c5affbe22098a3a19edadc3a74eb3f0dc0f83ebd93a482aa6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:a6b1bfbabb90652a55091a89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "随着游戏渐入佳境，她的心情也完全好转了。\n……难道说，她是那种只要进展顺利就会变得更积极的类型吗？",
      "source_fingerprint": "a956015197966c9f578a786aa8277ec35b63f74c90a15145b3067d82cac17175",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
