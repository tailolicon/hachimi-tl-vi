    },
    {
      "uid": "zhcn:b770abe2ec4441f77b2b4004",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然统治地位的声音听起来无比别扭，\n但好歹是答应了对战。",
      "source_fingerprint": "d675e855905bea182b915c3a63576c260544c6ff9bbe172e686c41cfbba24a30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
