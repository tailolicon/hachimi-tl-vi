      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "统治地位",
      "source_fingerprint": "ec85cad9328ee0b111926357aac4c3a170b45eb8b28b57355bf49d22cf30ab46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
