      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:4e92c0300afede25134a2a60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那狼人杀类的游戏是不是也一样强？",
