    {
      "uid": "zhcn:943845361748ffe5ffce93ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我拒绝。那就这样，晚安。",
      "source_fingerprint": "1baf8bd8dbd294e54b272f1fcd14d9964e5231371ce6361b608163d71eec9bef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
