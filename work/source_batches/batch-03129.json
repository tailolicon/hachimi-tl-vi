      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:12f037cf16ea8d1d913ff479",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被冷酷地拒绝后，只留下了我一个人呆在语音频道的房间里。\n现在的她，为何会对赛事抱着如此消极的态度呢……。",
      "source_fingerprint": "4d3c431d983e6418facd8b7adc27668ad91b9d13a6f1a6131e7ba911b7e8d1fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145002.json",
      "json_path": [
