      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:2f14fc2be5246ec0d5758a99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『再一起去攻略赛事吧，肯定会很有趣的哦』",
      "source_fingerprint": "e044c70c116cb6fba13c6b488b8fcdc5f46d1c85c3bdc3b9a89d7580c405c34e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
