      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "别说些莫名其妙的胡话了，给我站直了！",
      "source_fingerprint": "9911e5be16dec71c42674f6845ec217462d1c47d8d851f2bcca5241519a2809a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
