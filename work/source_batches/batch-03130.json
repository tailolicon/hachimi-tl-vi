        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:a47421dab420ddf60f67758d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（一定能赢的……如果是她的话！）",
      "source_fingerprint": "c0cb16d2566e75dd1bdb765cc01c12623716ea5a6b3c0da480a4ef44f7b136cb",
