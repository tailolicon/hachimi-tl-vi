    {
      "uid": "zhcn:bdb2af8909097dbdb73f58ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——没想到那个蠢货竟然会主动报名参加选拔赛事……。\n结果究竟会如何呢……。",
      "source_fingerprint": "62e06b35c09dd0f7640e2c2c433906a0e171bb4b8737ec4e63a5a1fd30755c42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
