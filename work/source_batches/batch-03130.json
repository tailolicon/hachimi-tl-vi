    {
      "uid": "zhcn:36526eaad0ceb5d813eede13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您这话问得可真奇怪，气槽前辈。\n在这个地方能做的事除了训练还能有什么呢。",
      "source_fingerprint": "8158dbdf587682abdc41d01d1631be46b34675a74224c4cbbaccc6ae123287f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
