    },
    {
      "uid": "zhcn:13de6f0dcd22713d63c7b435",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正如天气预报所说，选拔赛事的当天不巧下起了雨。\n我和气槽一起，在观众席上注视着统治地位。",
      "source_fingerprint": "d100f5e49a0f13dd4b24cb4d745d0e89c519e7b0272d194d93efbf224ef111ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145004.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:18df7647f116bc8a74a81e0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/04/1145/storytimeline_041145004.json",
