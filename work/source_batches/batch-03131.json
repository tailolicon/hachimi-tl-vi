      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……交给你了。拜托了。",
      "source_fingerprint": "4c21febfc14b550aa704d3690e8e842461472258864ec29bad23c02407ca3f5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
