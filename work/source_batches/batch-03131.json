    {
      "uid": "zhcn:7c501f8d8a1307da61a65aa1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，我就跟你签约吧。\n作为我的右臂，以后就多多指教了，训练员。",
      "source_fingerprint": "2943aad88a7e3ee687ca0da994247c6af6fc160161335ded9645a0c050dea7ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
