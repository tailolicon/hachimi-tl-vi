    {
      "uid": "zhcn:198e03fa786430103bc591b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哼……好吧。你的觉悟，我收到了。\n既然如此，那就请你陪我奉陪到底吧。",
      "source_fingerprint": "7aa3a26900ebda1a57c1627dbbca7e09fc2bd6af65628d21dc6872ec017e49d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
