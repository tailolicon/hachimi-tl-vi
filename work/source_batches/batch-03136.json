    {
      "uid": "zhcn:3824fa4b664ae20b13db3c1b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了我能干的右臂，\n我是不会吝惜时间来陪你的。明白了吗？",
      "source_fingerprint": "45ec1782e16f4df67806f677240ac61fbbaeaf1b8dab197c18ff90c3ddf472f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
