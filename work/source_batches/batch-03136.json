      ],
      "json_pointer": "/text_block_list/57/text"
    },
    {
      "uid": "zhcn:c55606f0bf547b8f52c07dfe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——因为我被她的奔跑深深吸引，\n这是毋庸置疑的事实！",
      "source_fingerprint": "fbb4377a23775d9852fd660589b2b9714510eb031f9d2f291f88c524a7c0e869",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
