    {
      "uid": "zhcn:7a940ca4d94aaed72913b38e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在我的赛事所交织出的这局棋盘上……直到终局！",
      "source_fingerprint": "29239a7a19d122ede19d6efeb6230df0455dc6387a38ad97fedced82e87e48ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
