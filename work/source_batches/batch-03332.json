    {
      "uid": "zhcn:332263bd5075d33fb818ccc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌",
      "source_fingerprint": "de3656ba07dd9368850ce26c63bb79082f1316261fe58ad07b81cfe0e318be71",
