    {
      "uid": "zhcn:51c1938a6c7677ee25842796",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "花开，梦现。\n愿未来在无人知晓之径等待各位的是平稳与荣耀──",
      "source_fingerprint": "bfbfd77078d04eda831c5b661829cc58ebf7bdb8a0bf3d36919b05bbd54432a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
        "text_block_list",
        47,
