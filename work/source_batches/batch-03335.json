    },
    {
      "uid": "zhcn:d08b5626914d5a1dd2879029",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玉藻十字",
      "source_fingerprint": "541b8029e44091e1713e6e0fc5f3c06b07ed9b78f8f91053f7b2f5a481281919",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
