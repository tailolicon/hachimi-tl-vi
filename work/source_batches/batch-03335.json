    },
    {
      "uid": "zhcn:0890752356a0e665c1519a7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……会长当时二话不说便把史料借给我们，\n是期许我们自愿进行研究吗？",
      "source_fingerprint": "5ac64ec0eacf3517b9ad7ebeb4691d3d7555dc1323e73cb9c8ce18223e13a306",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
