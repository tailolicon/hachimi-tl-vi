    {
      "uid": "zhcn:47e8c1092ec2f4e17b1636d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "各位的期盼，以及心愿──\n得火之热，绽放于此！",
      "source_fingerprint": "b2be463e3a9af2b0c72a1c56f00619c973d40a0f32d294973bf07efdfbcc33ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:46f794d9b87c96a17d6f8363",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
