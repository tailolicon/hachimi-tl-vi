    },
    {
      "uid": "zhcn:f8ecf5482f4c02ae9d411fa5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最终发表会结束后。\n到了准备从集训宿舍返回学园的时候──",
      "source_fingerprint": "729df5a1351803cb58be7395fb1fb261143a088aa227c340a2faf3fc5230efe4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:ae6281c34cbce11c64bce8cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向日会长",
      "source_fingerprint": "17ae7f07167eb826514e8e1d658ea29c3c862233bc0b20f51c389369cd1caa09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
        "text_block_list",
        6,
        "name"
      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:7e3baf97b9b1f2f268738610",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──再次向各位说一声，集训辛苦了。\n我很高兴各位完美证明自己有资格成为“神马”。",
      "source_fingerprint": "122a2b049560dffe7dd9ec36d81c8abab22955bfe5f9b78c95e411ba66f2e36c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:3e3b40d0dcac43233b48f37b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向日会长",
      "source_fingerprint": "17ae7f07167eb826514e8e1d658ea29c3c862233bc0b20f51c389369cd1caa09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
