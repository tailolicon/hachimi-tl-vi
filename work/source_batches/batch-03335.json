    },
    {
      "uid": "zhcn:275e731b5af36a55c76c875c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "心之所望",
      "source_fingerprint": "60b68d4abd1a25661bfb22a28b03f80ad5eda75bc6160bb660bcec8ab22f0732",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
