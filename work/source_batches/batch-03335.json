    },
    {
      "uid": "zhcn:489bd5418add2c15d99e0dce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──“称慰文”朗诵完毕，接下来“神马”会进行配花，\n将美丽的花饰发送给各位观众。",
      "source_fingerprint": "7589a3c9736dfe873e5acbf4b939b5254505d48aca3f461e287e75234427687a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0019/storytimeline_090019007.json",
      "json_path": [
        "text_block_list",
