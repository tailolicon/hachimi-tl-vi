    },
    {
      "uid": "zhcn:e8704888ef19a47dcb6764b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向日会长",
      "source_fingerprint": "17ae7f07167eb826514e8e1d658ea29c3c862233bc0b20f51c389369cd1caa09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
