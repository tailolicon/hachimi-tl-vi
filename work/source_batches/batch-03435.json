    },
    {
      "uid": "zhcn:52abd4b01c9248ed76f7bb24",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "＜机械人偶＞",
      "source_fingerprint": "45ce916b585cb7501fe52f6b20e7122159b658cc15b2b6a7d3646aaca437cfc0",
