    },
    {
      "uid": "zhcn:3d6bd1cf5587b1b7b9f1b726",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "＜恶魔＞",
      "source_fingerprint": "dd7dd40144ffbb2f6572838d35c4a29d5bdef09e6aa95be1241f5803c982fa3f",
