      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "＜创造主＞",
      "source_fingerprint": "49eb08941c447fb78b7a11516cdc2ccdba6514a6e11272289f55897ace1976a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
