    },
    {
      "uid": "zhcn:49114e9f69c9d7b0a0228073",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "＜诗人＞",
      "source_fingerprint": "221192838335e141e3cdb8d92aedecdce7798f3b4f62c5edb9e7263c829093f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
