    },
    {
      "uid": "zhcn:37eb9d7f17f5866de41ce2bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "＜恶魔＞",
      "source_fingerprint": "dd7dd40144ffbb2f6572838d35c4a29d5bdef09e6aa95be1241f5803c982fa3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
