    {
      "uid": "zhcn:42b3639469188133eac3ebfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那来复习一下吧。\n听好了？　这是白拍子师徒之间的继承故事――",
      "source_fingerprint": "56e352ee04ec56b379c949287eea2a4e2ef260b20d2bbcf4c06214cba3c304a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
