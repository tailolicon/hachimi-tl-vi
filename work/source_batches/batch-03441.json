        "name"
      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:bd14137ccfafa0a07048518f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿～！！\n当江湖艺人真是开心呢！！",
      "source_fingerprint": "6d1b5d5582320e97bac887b28e0124ce7fda778f642bda9243acb8eec14653c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:b3c4fcc105bb2af8ee99ddd9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
