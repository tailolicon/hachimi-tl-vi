    },
    {
      "uid": "zhcn:8385a297c6cfffae73882bcf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
