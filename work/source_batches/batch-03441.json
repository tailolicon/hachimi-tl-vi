        46,
        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:7d1c4d4fd03a19215f1dfde0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "师傅病倒后，为了继承师傅的技艺，白拍子在深山闭关修行。\n在那里她遇到了鹤丸和帝王扮演的蝴蝶双子。",
      "source_fingerprint": "1146023e5af21ec2a02e9022da7a8d8620ee1cf9c49233c816b04f55d2b04f70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:dc058872b905e3c16b8bbdd7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        47,
        "name"
      ],
      "json_pointer": "/text_block_list/47/name"
    },
    {
      "uid": "zhcn:b6307a7bb654ee88da16befe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然她们经常捉弄白拍子，但其实她们是三女神的使者哦！\n有时也会给出启发，在一旁见证着白拍子的成长。",
      "source_fingerprint": "a27edd72e5eb2a26d92ca5e9195c4f67c8ed12a36c0a4f0028dcde0b2013d9b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:14b2628e5dbbe60c00eb6f2e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        48,
        "name"
      ],
      "json_pointer": "/text_block_list/48/name"
    },
    {
      "uid": "zhcn:c13b522c3a14ef399b81de29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后江湖艺人们又碰巧在山里经过。\n她们的经验也给了白拍子很多启发。",
      "source_fingerprint": "242341e39a44f5dcd6d0ea85620c4af51dc58f18c0e485382e498ca618a449a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:ed31da760779f3df737bed73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        49,
        "name"
      ],
      "json_pointer": "/text_block_list/49/name"
    },
    {
      "uid": "zhcn:c30299bee3226efb3261c961",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "江湖艺人虽然没有从师傅那里继承到技艺，但她们用独特的剑舞赢得了人们的喜爱――\n她们的舞姿让白拍子想起表演的快乐。",
      "source_fingerprint": "84d976ec07c1252b38da57681849d761648b2852011400072e7eaa0b74465cb9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:03c5e228e3b27e3928f70471",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奉纳剧的讲师",
      "source_fingerprint": "2663da2fbde0f63538c4be38115d782b666ba2f8fa1b1b30839904fbd6064787",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        5,
        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:935a18d19fad42e6572dc377",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。主人公是一位白拍子，以歌舞为业的赛马娘。\n这个故事的主题是她与她师傅之间的艺术传承。",
      "source_fingerprint": "eafa7e3e26bc1d47f83c0da1fa670c95c2c1b4bb4d587db38cb97bcfcc443211",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:8463f03bbd9346424444713d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽",
      "source_fingerprint": "ead52de8a28bca47cc3766a1d8f9d13fb6418b886c3d67c4cfb46ba54a745ff7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0030/storytimeline_090030002.json",
      "json_path": [
        "text_block_list",
