      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:d01be911edfe0e42fd58358e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北方飞翔",
      "source_fingerprint": "972ca290e506302b4890a4580d0f99c92f3b093898c437c93e6cf1756cb2ec6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0033/storytimeline_090033002.json",
