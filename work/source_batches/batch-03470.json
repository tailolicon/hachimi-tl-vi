      ],
      "json_pointer": "/text_block_list/21/name"
    },
    {
      "uid": "zhcn:84a477e001ad8cb1cc241510",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等，等一下……还是算了吧。\n哪能让你们年轻人为了这么寒酸的店……！",
      "source_fingerprint": "ef93346579608a94ef145e2c92f680b999637f0bc3cc4c930a546e3d9756dc0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0033/storytimeline_090033002.json",
      "json_path": [
