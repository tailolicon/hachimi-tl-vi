      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――不。您的店才不寒酸。\n这家店，充满着传统与各位对传统的热爱。",
      "source_fingerprint": "ae4793ebcddcfe2451381b0cad9a4041cc13719e419f386648594a20b2dbf8ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
