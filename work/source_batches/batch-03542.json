      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欲望的尽头是希望。展现你的本性！\n没有什么好羞愧的。让我来告诉你罪恶的甜美滋味吧。",
      "source_fingerprint": "553208d3ebf489a21173dd451e160164468d2fdf5e3cb25cacae5fc81a3e3f6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0040/storytimeline_090040003.json",
      "json_path": [
