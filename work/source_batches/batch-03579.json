      "source_language": "zh-CN",
      "source_text": "我会证明自己，也证明母亲的坚强。\n以这份坚定的敬意与爱。",
      "source_fingerprint": "ded8e00a63b4339caee8748fa4b1781876b2f5cd5c413ddf02df033ca387e5f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
