    {
      "uid": "zhcn:2f54f9cd52377d9d06d57ef1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以说！既然敲定了最棒的主题，\n接下来就来决定分工吧！首先――",
      "source_fingerprint": "c04e2e4820ed28962d24180e5f34a7504bf10da0b518b59175b6d236926f6c83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052001.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:27de7e54022291ef8061166d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王",
      "source_fingerprint": "fb83f0cfd91efed693a0e2da1635e6fbe976243d887008d948a31b60847aa357",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052001.json",
      "json_path": [
