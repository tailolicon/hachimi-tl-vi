    {
      "uid": "zhcn:d9273304f6111e29133397d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我们以『祝福』为主题――进行构思的时候。\n我们脑海中立刻闪现的――就是两位的身影。",
      "source_fingerprint": "b556efea7ce3a78f8ba0fdc323bbf5ba69e353feb2812649a1214f33ca49238c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
