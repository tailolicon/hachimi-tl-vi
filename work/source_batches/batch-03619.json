      ],
      "json_pointer": "/text_block_list/13/name"
    },
    {
      "uid": "zhcn:cfdcbc58c12abe255977f451",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "什么！竟然希望我和飞翔同学在表演秀上共舞吗！\n明白了，我们接受了！！",
      "source_fingerprint": "d3a8f4df9bc94092b9e2657353bb692385a7e4d6e9cbb861c248e7a927f9ba0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052001.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:1f4b829aeecd0619b886c7fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
