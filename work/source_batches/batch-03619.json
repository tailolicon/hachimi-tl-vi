    },
    {
      "uid": "zhcn:22eebd464e3e41e6cd406f00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――呵呵。是呀。如果不嫌弃的话，我非常乐意接受♪\n不过，为什么要选我和进王同学呢？",
      "source_fingerprint": "8c2d787512f4d6fe464b433c394127f2115c7cc60dfd7436f22bd812ed089760",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
