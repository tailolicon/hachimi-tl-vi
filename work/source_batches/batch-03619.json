    {
      "uid": "zhcn:b7df277977c776153e0d1762",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎，居然这么快就决定了……！\n这样――真的好吗？飞翔同学也……？",
      "source_fingerprint": "81ffefb2259672df85d99d9b3725b3b147c061d529998857130ceab6c6c67a05",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052001.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:91da79c68686fabb6132d70a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北方飞翔",
      "source_fingerprint": "972ca290e506302b4890a4580d0f99c92f3b093898c437c93e6cf1756cb2ec6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052001.json",
      "json_path": [
