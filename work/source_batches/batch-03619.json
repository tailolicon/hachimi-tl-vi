        11,
        "name"
      ],
      "json_pointer": "/text_block_list/11/name"
    },
    {
      "uid": "zhcn:baf3edce3c0e97ccf167b4fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，嗯……！这个主题果然非常棒啊！\n花束这个概念也很棒！真想把会场用鲜花填满啊～！",
      "source_fingerprint": "c7010a29adbb8a064536a56a562e557afde207489787361962c16b92afd5dd8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052001.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:19fe441810f8a7fc3612d2a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "舞会执行委员长",
      "source_fingerprint": "f92fdc4cf69228491fdbecb38074ef0f81a480d05a20ae9428c567d7becc723f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
