      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宇宙同学给我的心意――『加油』。\n怀揣着这份心意，我顺应着『想要加油』的冲动，挑战了高强度的练习哦。",
      "source_fingerprint": "ecae5effb356dfb055f224023c260051a6f3f99eb79c550edef45631ae4d3b04",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
