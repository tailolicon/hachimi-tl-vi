      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:025ffa6bbb728605a33972db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『Oh……你是，特雷森学园的新生吗？\n明明才刚入学不久，居然在难得的休息日来搞野外生存？』",
      "source_fingerprint": "4ead038c82d68ae54d1b1f876e8fdf210ddd146b1dc6e39aa3ac49c521b32b65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:01e1a3d08dd5bef640bf2b6f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谋勇兼备",
      "source_fingerprint": "81e7e5f239140a662b4a334e8107f7bd73a645ab650044c01e635e380e10d623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        41,
        "name"
      ],
      "json_pointer": "/text_block_list/41/name"
    },
    {
      "uid": "zhcn:10f0f718100c0dd4a3119687",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『是的。入学后再次感受到了周围大家水平的高超。\n……我觉得必须在这里，重新锤炼自己一番』",
      "source_fingerprint": "f89303efdb2cb500a8480ff9f1fd3d57c508d9318ddfe42ebb8db408992b0db3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:64d8f6ea6fb7b391deaf3fed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谋勇兼备",
      "source_fingerprint": "81e7e5f239140a662b4a334e8107f7bd73a645ab650044c01e635e380e10d623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        42,
        "name"
      ],
      "json_pointer": "/text_block_list/42/name"
    },
    {
      "uid": "zhcn:dfca87344363617280a4e06d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『大自然——总是能教会我许多重要的东西。\n活着、能够继续奔跑的美好——以及它的严酷』",
      "source_fingerprint": "9a4e4702e9fa58c482028fa48cc036ad3e010c09b33b5061c704cb65517c5fbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:95b8d3644c3117fa9e5a5c09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谋勇兼备",
      "source_fingerprint": "81e7e5f239140a662b4a334e8107f7bd73a645ab650044c01e635e380e10d623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        43,
        "name"
      ],
      "json_pointer": "/text_block_list/43/name"
    },
    {
      "uid": "zhcn:7fe5c17ab473cc2e7f0852e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『正因如此。我才能回想起接受严酷、重新站起的坚韧——\n以及无畏前行的勇敢』",
      "source_fingerprint": "526de140e76026a256018aba3ab935e165bea7677c6227796770ecba62c65c89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
