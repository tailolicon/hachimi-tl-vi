    },
    {
      "uid": "zhcn:1cb76d17c9f910a1a9b5c0c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谋勇兼备",
      "source_fingerprint": "81e7e5f239140a662b4a334e8107f7bd73a645ab650044c01e635e380e10d623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
