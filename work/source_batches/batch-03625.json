        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:db34bb11d532a51a86c17b00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇敢之心",
      "source_fingerprint": "9a26c04a8af8557f331ed7076671e2fce274ed0afd52fdd6e88b73fe92f7c8e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0052/storytimeline_090052005.json",
      "json_path": [
        "text_block_list",
        44,
        "name"
      ],
      "json_pointer": "/text_block_list/44/name"
    },
    {
      "uid": "zhcn:268f0ff9780c2a9548e91b3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——呐，谋勇。在你眼中，我是什么样子的呢？\n你是怎么看待我的呢。",
      "source_fingerprint": "c53acc4ea00d4e41a2f227f3f0d4dc83b5b8bff415450e2f807abfe0a121560b",
