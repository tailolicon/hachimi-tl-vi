      "source_language": "zh-CN",
      "source_text": "曼城茶座",
      "source_fingerprint": "d954d0142b37975f0fc4d92f09ba75f9d3a0fd440959bda37bcf818148a467be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
