        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:9d7124fb6abaa8ad37efe60b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很久以前遇到的人，现在能接触到的身边的人。在他们之中——\n也许就有期待着我的幸福的“人”存在呢。",
      "source_fingerprint": "35a8ffc96d32adeaa423bf480ad032ffc3281fcffa14ddc3719b44bb89af11fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:4cd2867026ac417cc0a3a2fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "防爆装束",
      "source_fingerprint": "43e05969356932a58485976bf3f4c0b3c52f0b3e7a503010dcf761893f8238c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        21,
        "name"
      ],
      "json_pointer": "/text_block_list/21/name"
    },
    {
      "uid": "zhcn:a17fda44aab21e140247ed24",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果觉得幸福，就说出『幸福』吧。传递出去吧。\n也许你遗忘的某个人，正在等待着你的幸福呢。",
      "source_fingerprint": "96df4a25fbfc3b404cd526164c85efebfc518f1682020b1b4ab769505a82d56c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:1d2cd72a6d3edae2245e35e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
