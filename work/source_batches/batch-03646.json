    {
      "uid": "zhcn:ab574c76eec1d89abe14c2d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "防爆装束",
      "source_fingerprint": "43e05969356932a58485976bf3f4c0b3c52f0b3e7a503010dcf761893f8238c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
