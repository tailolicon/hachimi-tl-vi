    },
    {
      "uid": "zhcn:5c071f84bcc5801336cef35f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之所以会羡慕，之所以会不甘，\n是因为你心中已经萌生了『我也想获得幸福』的力量！",
      "source_fingerprint": "94e44c5ad34702c78a44d159ae972c7591137c2188b42180d70710184ea2e9e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:4db0eca4603c806459453903",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
