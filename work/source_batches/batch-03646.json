      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………我知道。……我这边才是，对不起。\n总有一天，我也一定会成为比你更幸福的新娘的。",
      "source_fingerprint": "845f42c4159429e48e326882de24fbdcdf3d5f4397cf2f5b2ec3c283c36c7c7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
