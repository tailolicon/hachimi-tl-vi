        22,
        "name"
      ],
      "json_pointer": "/text_block_list/22/name"
    },
    {
      "uid": "zhcn:e8458b06baeda5907424da7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――还有心生怨恨的，你也是。\n不要让一切仅以嫉妒告终。",
      "source_fingerprint": "753858f18aff090c2ccf66405349ec162ae0804aa3ed1b34cb8c27acf1c47636",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:1a46dccc8ab1cf912bd126b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        23,
        "name"
      ],
      "json_pointer": "/text_block_list/23/name"
    },
    {
      "uid": "zhcn:3cb8a9427a2bbe27e0ff5825",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请正视自己的不甘，直视对方的幸福吧。\n即使将其咽下的过程会很痛苦……也要鼓起勇气去祝福。",
      "source_fingerprint": "64a888ef33a74c7d58957427d6f4879bff51b122b6cc2ccce4dfec24437dc1be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:195f5b0aee8f5c8e458d097d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        24,
        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:04076496df1ceed5a3506604",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要这么做，你一定也能如此想的。——『下次就轮到我了』。\n总有一天，我也一定要像那位一样，体会到喜悦的心情！",
      "source_fingerprint": "f275f89ef3d6a2554113b8a696d58ae106a76e4505ab8059d7a6d18b7c19447c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/09/0054/storytimeline_090054006.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:6537f6d9a938b8ad70ab60a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
