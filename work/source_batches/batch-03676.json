    {
      "uid": "zhcn:dce43f6b5f93fdb8772f9091",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好歌剧",
      "source_fingerprint": "0e675a751a02376dc54b1b2892d4a4f859f0505240d1cc6277fe26728ca618f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
