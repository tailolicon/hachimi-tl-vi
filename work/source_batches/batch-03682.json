    },
    {
      "uid": "zhcn:93811a7c66511cd2050026fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量",
      "source_fingerprint": "0cc0478397dddaf29860878e611e32a8803c3deb73f318f6dbdfb06a653d53cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
