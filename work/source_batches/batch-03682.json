    },
    {
      "uid": "zhcn:f0fce7b2b18470574f2ffad1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "乙名史记者",
      "source_fingerprint": "6608d92ddc656fae1809234e30f843c4d4997172c24834da9be168a1a6d80ee5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
