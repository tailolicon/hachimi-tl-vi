      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说起来……两位之后有时间吗？\n如果不介意的话，一起玩桌游吧。",
      "source_fingerprint": "2fcd47002167620c44b7bbefcbae39f639042945d0215589053e3f419e9c59e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
