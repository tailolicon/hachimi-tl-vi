    },
    {
      "uid": "zhcn:f1463d68dd6e2d572b2cf1eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨胜驹",
      "source_fingerprint": "9beb50d57d7703a64ba6e9d70094d69e3edf1f53654ce1b6055f0ddd7c2b63d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
