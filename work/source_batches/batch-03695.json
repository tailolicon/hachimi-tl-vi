      "uid": "zhcn:cdb4d6beb2fab5eb6d5758d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神威启示",
      "source_fingerprint": "e735e598796fe57089822ae34f1e2c5445cbb00ef02bd5fa7e58c55b26fa696c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
