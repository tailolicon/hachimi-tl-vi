    {
      "uid": "zhcn:ccb8714386e7f5cbc60cf60c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神威启示",
      "source_fingerprint": "e735e598796fe57089822ae34f1e2c5445cbb00ef02bd5fa7e58c55b26fa696c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
