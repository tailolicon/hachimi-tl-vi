    },
    {
      "uid": "zhcn:08d530de3fe7b1c8c1c9f6e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大鸣大放",
      "source_fingerprint": "aba3eb8761f7ef4beb01267c45acb895f083c7b7f45770e09d03e5f495431e3d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
