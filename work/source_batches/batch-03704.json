      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "创升",
      "source_fingerprint": "18eaf21204bdbb809789e4710211d62eb27faa7c04c4063716f9c4e1df89a1bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
