    },
    {
      "uid": "zhcn:ea31e962cfe70db0f4ce48bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多旺达",
      "source_fingerprint": "91c409e22872af3fab02c98efd80664f501d1f4c1d317efbefe1ec70454942d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
