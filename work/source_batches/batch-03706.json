    {
      "uid": "zhcn:884b200161d888f0f2df0522",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "梦之旅",
      "source_fingerprint": "cf8724919ad561d2fc2975485b8a693f3f4ccfa3c3219ef0d80b886d506c1223",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
