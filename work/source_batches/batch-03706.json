    {
      "uid": "zhcn:cb7a916985557dfa3465b5ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "凯旋芭蕾",
      "source_fingerprint": "62f5bc9ff51e1b8d432c968ee364b73aa6aa768ef36ec9142fbcc36b46acd5c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
