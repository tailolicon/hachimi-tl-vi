      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:def3ec945a26d852a936cc39",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请收下这份，我献上的忠义之证——\n若能得到您的感想，我将不胜荣幸。\n那个……这是为了今后能更精进。是的。",
      "source_fingerprint": "b1816cd683ab8041da9646370bb424075e43b1dbcab7d620ce8c5616ab2a19f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
