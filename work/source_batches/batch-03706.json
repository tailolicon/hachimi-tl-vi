    {
      "uid": "zhcn:c268a80e0b98e51a8391c047",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金镇之光",
      "source_fingerprint": "b96cec08f96fd9bf6d1dc53dba4a16e6786911e917eb4efd7e949783b2eaf84e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
