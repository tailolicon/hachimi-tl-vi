    {
      "uid": "zhcn:d7bba2bf726a2b5658d7b09a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超常骏骥",
      "source_fingerprint": "f5c574d2a865f4eb4c6720353a664d067085d4debfef3c38de6b6828c025ca9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
