    {
      "uid": "zhcn:cbfab2e1b731676f8dec0857",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吹波糖",
      "source_fingerprint": "c37be5dc9e0974190ff728d80c3a5ed258d7deea56b364cb267345f4f37e2e54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
