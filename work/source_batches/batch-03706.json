      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:4ffc795a60ec5e37acb83b33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "带回家？为什么？\n现在吃掉不就好了。赶快的。\n就在这咔嚓一口吞掉，然后呀呼地兴奋起来吧！",
      "source_fingerprint": "52974a601222872749cbe51b0d350d2fc4d1985fe8ae2dc9cb04f6b8e4f7bb9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
