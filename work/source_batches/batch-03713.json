    {
      "uid": "zhcn:ce9141c44b0a7dcf3b9c7690",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "由于即将展开与赛马娘的生活，\n我收到了来自“骏川手纲”的建议。",
      "source_fingerprint": "d5009df120d1c48f2c726bbd87555c665b28f5776083a1a8cdf3ae7192281aa1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
