    },
    {
      "uid": "zhcn:85c3a17a4f99311416825aa1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对于即将到来的“出道战”，\n我重新提起了干劲。",
      "source_fingerprint": "8a40da08823786189fa82daff172809e2bb994a48a5cd434498b2206b9064f8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
