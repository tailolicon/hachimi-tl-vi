      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我帮忙农田的工作吧",
      "source_fingerprint": "8bdfe4c8f6ba6aed8c93ff03df8e6284a66083333fb0163c3b9171275374c0ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
