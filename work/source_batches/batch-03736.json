      "source_language": "zh-CN",
      "source_text": "能力所及之事都要尽全力去做。\n直到大家成熟茁壮……那天为止！",
      "source_fingerprint": "c7c7bbdc54e72c780d09807f6dde27d76ddc34a99816a6bfe366778488d24aa8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
