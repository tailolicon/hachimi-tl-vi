        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:2bdedc7745958dd98f8f1af5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们本来都是自己一个人吃饭，\n我好惊讶！",
      "source_fingerprint": "28b6cd844805311e4334ec6d8c8eecaf9f92e1000ce1e25850d89cd18bcc8b3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9573af4b799899cf803ddf84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长或许知道些什么。\n于是我和队伍成员与＜First＞队一起，\n来到秋川理事长面前。",
      "source_fingerprint": "6756732990707d85a8a8fb694328185174c771b38cfabb4e4a76f364b8b5e7cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:9f249ca1619b71ad83f4d241",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "话题进展得很快。",
      "source_fingerprint": "0049b85db24e3dc024beb1c4032e0048d05f8617bf93764f5a81fb5a965c021c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:735ea19452903861299ac3a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:dffcbda4ccad121c19b2a502",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来如此，了解！\n各位有权利知道！",
      "source_fingerprint": "661d05bdd2bcb9cc0139da45a81bae3493801f9bbfa3486d71d9a8a59808977d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:a4485081ef3493e23245c610",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:58d00f502cf0849a267ef604",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我说给你们听吧！为何！\n她对赛马娘们会如此过度管理！\n其背后原因！",
      "source_fingerprint": "5e6cda9fcea7b65132f145038b5c242e5a966f08ad103f048dbd52f424349c14",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:34f90d7a3c3ed13a992fe72d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "根据秋川理事长的描述──过去的㭴本代理，\n原本是个尊重赛马娘自由的训练员。",
      "source_fingerprint": "f6b38a5478a0e6fb831a27bc43695e81b9cd0eb4e8ebd1c5837f2de86e4afd2d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:56e51afa4ee3284e4e722d20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与签约赛马娘建立了深厚的\n信赖关系，并在闪耀系列赛\n留下了优秀的成绩。",
      "source_fingerprint": "c986e4ca172ed02327c0f18b8099606f6256b9af8956e4da07e81dc49b66ee94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:214be01b603aee68c1cf4f21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就在这时，举办了“青春杯”，\n开始了队伍对抗赛。",
      "source_fingerprint": "8af9f51ffef581ff3eb1fe468f8229d5d277cbdf4d1a9ab0fd2d3d02ede2dabc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:a8eca60e7d00903ad1aba05c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "签约赛马娘",
      "source_fingerprint": "fffcf5d87c556c9c4d73f2aae2ae53efdf8a309cf63c12bb2ef13269c2735769",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        37,
        "name"
      ],
      "json_pointer": "/text_block_list/37/name"
    },
    {
      "uid": "zhcn:df39a45eadaca970ebb2b082",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "用队伍的方式对战，会是什么样子呢！\n大家会一起做训练吧！？",
      "source_fingerprint": "c36515ded93526306b84f98d57936624bfb67c453274ea3e2f6cef67d0c290a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:d265b636f42a2a4d9e20ed3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "签约赛马娘",
      "source_fingerprint": "fffcf5d87c556c9c4d73f2aae2ae53efdf8a309cf63c12bb2ef13269c2735769",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        38,
        "name"
      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:e16b6441aa6fe6f7ba32978f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我……那个……到目前为止\n都没有什么朋友……所以我非常期待！",
      "source_fingerprint": "64c842a5df0bfeaeb3230c82cc5f098b1ce1d7b4d2f797003e3a53b37fd7d08d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:59df1e78d7d6fa25f5d7bf8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "㭴本理子",
      "source_fingerprint": "8e73181a7e51e7b12f2ed531c20b941b82a94f94c330157fee939a2c2298bb0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        39,
        "name"
      ],
      "json_pointer": "/text_block_list/39/name"
    },
    {
      "uid": "zhcn:d073e70cf8b10469b9672c41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊。\n我也很期待你的成长。",
      "source_fingerprint": "188fa28d05d0f865fc79e1ad20e16c429ac5c1b1332187e9db4ba4116c0a9dba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:9fd0865bd6496be9f320f29c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某一天，我和大树快车结束训练后，\n一起在回程的途中──",
      "source_fingerprint": "bad2b9efed8fe920b66b7cadc3f63bc9f4af70e68bb61e26246aea8c4255fe87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:dd9596a40018ebbdde97a1d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是……\n集结的队伍成员实力在平均以下。\n与签约赛马娘的实力有很明显的差距。",
      "source_fingerprint": "2aeec7c39b84ae2173c4abed25634b3dee8fef39028b21abce0cd3c15f8c4525",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:de81a39ba15f9c1be64a2d09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "㭴本理子",
      "source_fingerprint": "8e73181a7e51e7b12f2ed531c20b941b82a94f94c330157fee939a2c2298bb0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        41,
        "name"
      ],
      "json_pointer": "/text_block_list/41/name"
    },
    {
      "uid": "zhcn:d8d2bde9fd7a447ceeefcf12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要追加队伍的自主训练，是吗？\n但是──",
      "source_fingerprint": "cee4383b5cb3dde15605fac76486e41d4824956eb5e59371fbcd017641024a83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:17dc07e8eb20f7a2bc101e7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "签约赛马娘",
      "source_fingerprint": "fffcf5d87c556c9c4d73f2aae2ae53efdf8a309cf63c12bb2ef13269c2735769",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        42,
        "name"
      ],
      "json_pointer": "/text_block_list/42/name"
    },
    {
      "uid": "zhcn:f196cd5dca9af8084e6d900d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也很清楚，\n现在是闪耀系列赛的紧要关头！",
      "source_fingerprint": "5bf440a8d8fe7549775c223ec62e5e749e48b0d9b66dab14e4e7889fb546b806",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:f5ab19c7e27da4273cb91e49",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "签约赛马娘",
      "source_fingerprint": "fffcf5d87c556c9c4d73f2aae2ae53efdf8a309cf63c12bb2ef13269c2735769",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        43,
        "name"
      ],
      "json_pointer": "/text_block_list/43/name"
    },
    {
      "uid": "zhcn:2878c912ec040e0d63eddbba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，有很多地方是我可以教她们的……",
      "source_fingerprint": "f857bb59f5080f094aef7fa6b6e1e84d386118734dd28779378dfa9dae4dd271",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:24325e26e8ebbff2e3ec0f0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "签约赛马娘",
      "source_fingerprint": "fffcf5d87c556c9c4d73f2aae2ae53efdf8a309cf63c12bb2ef13269c2735769",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        44,
        "name"
      ],
      "json_pointer": "/text_block_list/44/name"
    },
    {
      "uid": "zhcn:44dba081890b0b8359439e66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果是我能办到的事，我想帮大家的忙！\n拜托了！",
      "source_fingerprint": "53c6ffd5946f9c9108415ce6f32a5d1ca8c9fc0ac10e0b104f913b3f79303140",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002025.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:6cfab76433fa6f18ce1b24e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "队伍成员们努力想填补实力差距，\n那位签约赛马娘也为了她们尽心尽力。",
      "source_fingerprint": "094945b07968773a462f5a6014be58afa21c7b595a45195f919aef97650138c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
