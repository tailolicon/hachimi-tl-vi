      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:9f7228f91c64997c2e96c1ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小小蚕茧",
      "source_fingerprint": "6f36ab4bbc7094be655ad178a01f38c0e7a1597fc0595ebaa3a7fa36071de850",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
