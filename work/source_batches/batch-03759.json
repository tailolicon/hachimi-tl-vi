        "text"
      ],
      "json_pointer": "/text_block_list/58/text"
    },
    {
      "uid": "zhcn:ad82421c0a595d2105393240",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "㭴本理子",
      "source_fingerprint": "8e73181a7e51e7b12f2ed531c20b941b82a94f94c330157fee939a2c2298bb0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
        "text_block_list",
        59,
        "name"
      ],
      "json_pointer": "/text_block_list/59/name"
    },
    {
      "uid": "zhcn:508f1dc85a5bdd07154de3c4",
      "kind": "story",
