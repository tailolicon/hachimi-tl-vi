    },
    {
      "uid": "zhcn:c1344d77801d2445fd63b3aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以我才非常排斥队伍对抗赛。",
      "source_fingerprint": "4115e2210fb58c00d5a899d39510eb6c767f266a7244b16fda2b553c46da2ab2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
        "text_block_list",
        54,
