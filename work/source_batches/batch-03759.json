    {
      "uid": "zhcn:599240973abea7f5e58f5579",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为那一句话，我成了大家的敌人。\n经过几次类似的事情，\n有一天我被训练员叫了过去。",
      "source_fingerprint": "c2ab6450fa160e23cfc1dfd2a50436939557761d19c624a68bfbf60328fe2fc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:0322b34bfb16360afe7b9199",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新人训练员A",
      "source_fingerprint": "e829f9d4dc056512054ee3af7d16ee643fea041192ab34f55f5b5f4bdc406a95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
        "text_block_list",
        52,
        "name"
      ],
      "json_pointer": "/text_block_list/52/name"
    },
    {
      "uid": "zhcn:8ff580e5f79b39715b1aa826",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你太顽固了。\n稍微努力一下，试着跟大家好好相处吧。",
      "source_fingerprint": "2504b982f8ec3d0b55a9ec7975d75c2edffef77f72be73a0a54952cdc13fdee5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:97dfef51e69490eeae3fea36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小小蚕茧",
      "source_fingerprint": "6f36ab4bbc7094be655ad178a01f38c0e7a1597fc0595ebaa3a7fa36071de850",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
