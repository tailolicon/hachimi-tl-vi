    },
    {
      "uid": "zhcn:5644dd906843ad251a9292a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后我脱离了队伍，\n并成了“无法适应队伍的赛马娘”。",
      "source_fingerprint": "04389077b608fec2445186afb3158db06aff8893cad88978ce67546e33613ac9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002026.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:95c3f5d572d46d72b42e5839",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小小蚕茧",
      "source_fingerprint": "6f36ab4bbc7094be655ad178a01f38c0e7a1597fc0595ebaa3a7fa36071de850",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
