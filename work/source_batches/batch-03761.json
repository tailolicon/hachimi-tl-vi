      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为这就是“训练员”",
      "source_fingerprint": "137d0503e7a9908e4cad70807b34e111b9918f70aa584047308f602fba9a145b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
