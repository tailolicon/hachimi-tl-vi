        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:3041d1f1e0ddfe325f67ce68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还有，“青春杯”是队伍战。\n当然，必须召集队伍成员。",
      "source_fingerprint": "fe73f89a20d10e5a98ab928d245bc8e7814e5cadc6bfa0707ae6b15cb449b69d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:00ffb6436a22bc663b90d25e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:ee9c425b2c24f5eb4a8aff3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "邀请支援卡片成员，\n或透过季前赛竞赛中的活跃表现，\n吸引对队伍感兴趣的人加入。",
      "source_fingerprint": "4284412744b9e85a5a83da97c8035fc4e19897de0bbc364bb07c9667156598de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:8b3255ffd65f0faf4af65c78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:a4ff460fa34de286024a0686",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另外，必须决定队伍名称。\n受到手纲小姐的激励，\n我再次下定决心要好好努力。",
      "source_fingerprint": "8e3b68b5d94aaa4e08f39842f647d7aa86612fce62dc905bee497d5f185a33ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:fd5aa1a332c5bef9413e6240",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "什么是“青春杯”？",
      "source_fingerprint": "e33c348c6597edd68cfea2184c388499e21292121dbdf38173e2b6e1e9a20131",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:16eef1f89e4a82061425b6d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练中遇见了一名从未见过的女性。\n那名女性提出了尖锐的评论，\n表示“训练内容太嫩了”。",
      "source_fingerprint": "16b0511e84e32336ae7d6ef63ede437f2daf6f286a08ad5567b843b146d3db93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:019b9e4a456359cccf978ba1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她继续提出冷酷的批判，说学园尊重\n赛马娘自主性的教育方针是个错误。",
      "source_fingerprint": "ea3134e0a99e215a9bde33c83f3c3381ac28cc4131412cdca4a3af9ae469d536",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:76245e883e24661f42840973",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她又说，远方可见的那座森林，\n是因为人为的管理才能保有美丽样貌。\n这点赛马娘也是相同的。",
      "source_fingerprint": "79f7ec5e0e6434e3ca388d1f8dbfcd4aa88a5e11c9132296ec492d01d33111d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1c52e29deff3cfc4cbfb97e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，她正是作为代理理事长被派遣至此的\n“㭴本理子”。",
      "source_fingerprint": "f3f6bcae726f72f36dee54bf490ed861f4608ce580a1a7fc3c1203375c52b2be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a4758f2f196430a703b255e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与代理理事长相遇",
      "source_fingerprint": "1831a6332292c6498197bb0372ca88c7a53422f58dec32c1219022a112587125",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:cdc4be1b6f711f87ee17fe37",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "早上的集会。㭴本代理刚到任不久，\n便谈起当前学园里的“松懈”状况。",
      "source_fingerprint": "a7dc2f58001a1f22cdc71380adea73920e03f0baffed4060013929fb37b85a32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:35e9f27d243f26652798786e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，提出了从训练到饮食内容，\n皆需彻底管理的\n“管理教育纲领”。",
      "source_fingerprint": "eee148ff83787c7710f1d8a9347b32a7fa94f897024ab31724bbe241aaba83f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b9648055a3b2937e9b181c33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "并表示队伍赛“青春杯”，\n可能招致青春期的团体失控，\n发表了预定将其废止的宣言。",
      "source_fingerprint": "45009d7a4d7325248625e3622e8827413f55f84d4e8b8c8d34a6955f7c04f48e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ade30745609d2720114b919f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此起彼落的嘘声，\n以及大树快车都表示反对严厉方针，\n但最后还是无法反驳㭴本代理。",
      "source_fingerprint": "03c469244aa4370e3e65781eda48cdb94c280d76e9cdafb2037b7cf3d1a2b893",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:762f470a739cd5730218971b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特雷森学园大改革！？",
      "source_fingerprint": "c6f73f8796d521ded0466725b14b809dc357616792970bea47fd35b91307d976",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:818d59cfe54a9dfa1ccd0ea0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对管理教育纲领感到不安的\n赛马娘们，与大树快车一起\n直接找上㭴本代理谈判。",
      "source_fingerprint": "82c270c1372e9d70cee446de64625a5cc699a93557d0a7e34e3de2b793b62bb8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e5d9ad62093f354743ec2b9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是㭴本代理承诺，只要和她的队伍\n在“青春杯”比赛并拿下第1名，\n她就接受谈判的要求。",
      "source_fingerprint": "05096c81ba96a253e3e1e3439be3a8ea9d6d037de443bb55157212b746721c7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:003250d8a179a01703e972ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后㭴本代理组成了一支赞同彻底管理、\n以苦涩糖衣与小小蚕茧为首的\n精锐队伍。",
      "source_fingerprint": "c9b38829ccda23fbb557314e20f9b707561a181cd40a64542ba41721e1468e8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:af3c20afba09789b7fbf3e77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以特雷森学园的自由做为赌注，\n训练员也为了召集队伍成员\n四处奔走。",
      "source_fingerprint": "08c50ca3fbc90387607b658480af58e076882f26659fe3384f5f871564ab99b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:18074473ccc3b7e251df94f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与代理理事长的“赌注”",
      "source_fingerprint": "1d699323d24a198691737b5f1ab38f6b172213851153513640387d3d8077c437",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002404.json",
