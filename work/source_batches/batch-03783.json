    {
      "uid": "zhcn:9e79119ac69bcdc0f9d872f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青春杯分为“季前赛”和“正式赛”。\n首先，试着在“季前赛”争取前段名次吧。",
      "source_fingerprint": "24da32197a4da6346cc2d778170517d568137aba939ec6f32addae6b7aa47e13",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002401.json",
