      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:ad0459af71fefc0b11176cab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从那以后，\n她便抱持必须彻底管理，\n才能保护赛马娘的坚定信念。",
      "source_fingerprint": "b0b37d1157d89b498e1374534fbf5e1fba224b692facf53f46e50dbdd7a04f4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
