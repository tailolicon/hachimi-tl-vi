    {
      "uid": "zhcn:dc2157b63c4e7afc4c8a4630",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着“青春杯”第五战！\n终于来到与＜First＞队决战的这一天。",
      "source_fingerprint": "625c5c53264d6d3c65183ca897423363e3edeb6a05af30025b8a66f7b5b23ab7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
