      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隐藏的过去",
      "source_fingerprint": "d4c17b7030440e1bd6ee242084e66b656826906be90fa59bde37278b52706077",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
