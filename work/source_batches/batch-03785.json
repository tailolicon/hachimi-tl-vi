    },
    {
      "uid": "zhcn:678eb055d4e73758fd20f22a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了㭴本代理团结一心的小小蚕茧们，\n终于打破了目标时间纪录。",
      "source_fingerprint": "f4dfd55c118967eddbb2081b1fcb411363d814bd1ac645bc8f89db11159fd96b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
