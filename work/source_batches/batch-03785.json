    {
      "uid": "zhcn:7ae33b6b319931f979c8f94f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小小蚕茧与苦涩糖衣，\n不断思考让㭴本代理重新觉醒的方法。",
      "source_fingerprint": "54edbb2ffbf4e1d3ac8f8c5f205600044c1e980b1b9f4b6352645fbff8f6ee60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0002/storytimeline_400002429.json",
      "json_path": [
        "text_block_list",
