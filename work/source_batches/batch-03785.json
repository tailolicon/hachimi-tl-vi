      "source_language": "zh-CN",
      "source_text": "新天地",
      "source_fingerprint": "d138cd7eab64b166b327d64f395eae04db859e5fabf766dbefd41c35f97a851a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
