    {
      "uid": "zhcn:522c610116d19cf8b592804b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰高兴地跑过来说，\n演唱会用的歌曲终于完成填词了！",
      "source_fingerprint": "0dae9cd0e340c2f597bcd8ade9b46edcaf78186d44f9f8c51496100a097acfaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
