        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:139d5710ae2467a81ac05dc6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "粉丝说，能在演唱会上一起发声，\n怀抱同样的心意，令人很高兴。\n而且，那也是能说“欢迎回来”的地方──",
      "source_fingerprint": "0f21f29b5728e6e46e80085b6a8711ac2a5ec72b564ee4c7ec51b42644742f31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8129059b0e594dc209bdaf60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003404.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:ab9523d7b150525ca96f65ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "竞赛的观众们，都希望\n无声铃鹿平安回来。\n正因如此，才想大声喊出“欢迎回来”。",
      "source_fingerprint": "1966140d5f366501a344afc38cdff4199ff825e0e8ef68cf3204eefe23ca20c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:17ac9c5375ff1d6f8e0a6415",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003404.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:035c260bfbbb37671bb3f752",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿听了这些话之后，\n决定在下次的演唱会上，\n试着去听那些支持着自己的人们的声音。",
      "source_fingerprint": "4d7b7b06bcc3cb7988fd27180236740e801849d4ce41676ef074a57629d44ee1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:03899d95bad250a3f36ade76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "传达给你的方法",
      "source_fingerprint": "ef8a0034f5cfcd015b4644e8cd2ab37ee4a351061ea899ac4887af739596a518",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:f88594e3cddb6873ecd09286",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003405.json",
      "json_path": [
