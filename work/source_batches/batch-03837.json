    },
    {
      "uid": "zhcn:6be855702e3ed49e77c4c291",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Grand Live的准备也进入了最后冲刺。\n每个人都忙于各自的工作，\n并且确认要在演唱会上唱的歌曲。",
      "source_fingerprint": "a802b3f800188b3902e1d0d459d055dd9d7214e86389f3b73886fac09b89cead",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
