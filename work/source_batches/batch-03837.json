    },
    {
      "uid": "zhcn:8ff88453fe747fe97d6c3304",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人的演说打动了赛马娘们的心。\n会场里总算开始出现希望参加的声音。",
      "source_fingerprint": "34f0fdf9ac29cb93b3840c600cca4ebdc4776c4bbe195e4cbed45d7ebe7c20c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003409.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:dd6691ec75d7b6ef452a522e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对我们而言",
      "source_fingerprint": "38b1ba6cdadfe8d1a76acc67c6e428800aba271a76c21a96a8c2918a1137b6df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003409.json",
