      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一起打造吧",
      "source_fingerprint": "0c52831d93a89abd95945238fb964221865ca5b87e4bef517fab1e2922b1409c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
