    },
    {
      "uid": "zhcn:063216ca8a716181178b0c80",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个愿望属于何人",
      "source_fingerprint": "8586ff23201f6440e20c9a7d0b49906485cfee511197125dcdedcca029d5b296",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003412.json",
