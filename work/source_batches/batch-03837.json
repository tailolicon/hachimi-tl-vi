      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向“成功”",
      "source_fingerprint": "836c99dd11c7fad07304308fd343268cd822cb9b5986a9463a4f354c03ba7351",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
