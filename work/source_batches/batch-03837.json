        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:840e02bc60a5276e9f412bb4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了“针对Grand Live再思考一次”，\n我们决定先重新思考它的理念。",
      "source_fingerprint": "30c57406b30e4b40fadaf35e828c154aa5c6ba434f273b2bc430a9e78d970d95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
