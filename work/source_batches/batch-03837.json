      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a507b32c1a70b9e21fb88519",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子也在一旁帮腔。\n她说，赛马娘想要传达给粉丝的心意，\n应该不光只有感谢。",
      "source_fingerprint": "925a7ee78344ee357b82fae0991ad6b8af73e0d834ddcde54658cc931a393f9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
