    },
    {
      "uid": "zhcn:d34d3d4ae5155263987679ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Grand Live筹备的协力者增加了许多，\n其中也包括曾经抱持否定态度的赛马娘……\n看来她也有想传达给粉丝的心意。",
      "source_fingerprint": "b8ad30772e89e2553efba60cb501654e9b702f7880a3b6900a7a52ca468da4b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003410.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
