    },
    {
      "uid": "zhcn:b18308935758056a07164036",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "轻柔致意听了，喃喃地说──\n难怪创办Grand Live的赛马娘选择了\n“唱歌”这个方法。",
      "source_fingerprint": "9e4841a0f1957e4d251bca57683295fa8d423d4ba3aabe6bb92de3f0772ae53b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003427.json",
      "json_path": [
