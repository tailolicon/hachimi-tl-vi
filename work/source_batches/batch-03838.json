        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1856a8047543a0dbefe2e992",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了打造成连系彼此的演唱会，\n大家齐心协力，一起让Grand Live成功吧！",
      "source_fingerprint": "604d2f1ab99050d45e84ff4d0e28b18ddf7f4cd527210ced11955702f8644e60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
