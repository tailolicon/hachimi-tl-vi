      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:0846732641b26ec512106d90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘和粉丝虽然不能一起奔跑，\n但唱歌的话就可以一起出声了。\n透过歌曲可以和粉丝产生“连系”。",
      "source_fingerprint": "77f36611127df6ec32916f0126afd21b81cc987115c68da9d080940c1e841590",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0003/storytimeline_400003427.json",
      "json_path": [
