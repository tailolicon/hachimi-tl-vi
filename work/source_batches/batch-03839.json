      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "4th Live，开始！",
      "source_fingerprint": "782cee6063057a1fbfd17ee2adcf5afc24e8ef0103a60d27575fd917dbc16a76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
