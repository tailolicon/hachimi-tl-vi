      "source_language": "zh-CN",
      "source_text": "从此我就再也不碰田径了。\n身为人类还妄想赢过赛马娘，\n真是太愚蠢了……！",
      "source_fingerprint": "95c555b1b873e1d3aa4851d0b2366de4f4e3cdb84adf585dc6364d1dd54f1039",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
