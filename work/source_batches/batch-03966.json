      "source_language": "zh-CN",
      "source_text": "<chrname>终于确定\n能参加“闪耀明星巅峰赛”了！",
      "source_fingerprint": "061abc183a39c178f416358920d4653083ddd7edd3c909850ccd5993343da526",
