      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "㭴本训练员与小小蚕茧，\n决定齐心协力磨练个性。\n达利阿拉伯也非常重视个性。",
      "source_fingerprint": "98ccae5ee84ccc88d91fb20ded41fed37cfc6b88497ebf8bdb416b3414a44d93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
