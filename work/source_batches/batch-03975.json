      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听了三人的对话，\n让我觉得所谓的个性指的就是赛马娘本身吧。",
      "source_fingerprint": "08d2624dd253d94fc27a3f9e9eb21cf0f76207d4c6bef62859444b7155d829f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
