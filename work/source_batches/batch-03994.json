      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，你们还打算继续奔驰吧？\n下次要让我们见识到你们站上顶点的身影喔！",
      "source_fingerprint": "52f3f8495c4d59efe9d4c719dadde63f0752187ee89c50c964209914fa657e80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
