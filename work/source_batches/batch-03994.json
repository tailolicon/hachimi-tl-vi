      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:b4e4df8e19d2220cf8b24519",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，\n赛马娘们今天也继续努力不懈地进行日常训练。",
