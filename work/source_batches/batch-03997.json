      "source_language": "zh-CN",
      "source_text": "像是在回应她的想法般，\n㭴本训练员决定将接下来的\n目标设定为经典赛的大舞台。",
      "source_fingerprint": "c0bd6be52e376d6eb934dd3ada6258ffc5b2f39f1b0d283f421a661c2770d7c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
