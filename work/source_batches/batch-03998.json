    {
      "uid": "zhcn:0e44ff4cb6970b6cae8768e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，训练员和<chrname>\n深刻感觉到自己的成长，为新马级划下句号。",
      "source_fingerprint": "8872f9b2982074b4039aa6b9ff28302aa83870b0c5b8dd976db90fa9e965d7a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
