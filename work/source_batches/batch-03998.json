    },
    {
      "uid": "zhcn:d920e413fc29c8a583ed8860",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，\n㭴本训练员的两位签约赛马娘，\n也在“成长赛”展现了她们至今累积的成果。",
      "source_fingerprint": "af0556e052bae4d61f29196802f9065a63b5f671a3859a7dee8084c13e96f01c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005407.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
