      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员们在第一年中，\n都各自体会到三女神的支援带来的恩惠。",
      "source_fingerprint": "5d7d7afc9b18881673c9081df78b6fca65172880aa66bccdf80a5a83dcde3d9f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005407.json",
      "json_path": [
