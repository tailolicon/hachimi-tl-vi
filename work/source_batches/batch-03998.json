    {
      "uid": "zhcn:affee93405866e916f8c7f75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "<chrname>漂亮地在“成长赛”\n获得胜利。三女神也对这个结果\n给予极高评价。",
      "source_fingerprint": "4ab4d95bb1a3167fe600f7985f7ef000de2fb7dbd5b49252e5e8e75ff1968c78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
