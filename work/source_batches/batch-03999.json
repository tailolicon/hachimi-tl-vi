    },
    {
      "uid": "zhcn:9bff714269abfdf601588c51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "㭴本训练员的武器是用心面对赛马娘，\n并为了她们而贯彻的管理能力。\n这创造出了超出预料的结果。",
      "source_fingerprint": "b7c00bc2eba7055bd22d8d12321a758303b448fadefa618eeb7b25e86cdc5ed7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005419.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:00e8d54eadf6579b8a5d55a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
