      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:94bf95615d2bf8576fb50ca1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当晚──在空无一人的训练赛道上，\n快乐米可想像着与训练员一起获胜的样子，\n默默埋头练跑。",
      "source_fingerprint": "09355a89ee9a0e438c5557066a32eb05361af618adc16ff1cdef4a39cd5b9b07",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005417.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:ac1e7845f8828a0646d4ae49",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "善变的天气",
      "source_fingerprint": "43c820d13bde449cd62bc255989147e992e7d07144b4af4e6e9fa6208689cfeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005417.json",
