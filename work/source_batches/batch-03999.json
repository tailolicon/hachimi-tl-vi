      "uid": "zhcn:f0ae33edd5a6d74b2d64cfdb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想用过去的跑法获胜，\n就必须进行过度训练，\n那将会伴随受伤的风险……",
      "source_fingerprint": "768e6cba63aa99c3b4287829a9ddf4448ec45e0d7d468088be8aee5199035ffa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005419.json",
      "json_path": [
