    },
    {
      "uid": "zhcn:0cc3776743fd6997b9c1b79a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "㭴本训练员下定决心让苦涩糖衣\n采取不一样的跑法──\n建议她从重视体能改成重视战术。",
      "source_fingerprint": "29fa7ff31bd5a8e6d76bf87dbda7f48c6f5816827358c0a9887374d1a5ebb525",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
