      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:8ae19cfadc29b8d5ae98ba42",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而，高多芬阿拉伯表示\n快乐米可的搭档就只有桐生院一个人，\n并以过去的赛马娘为例开导她。",
      "source_fingerprint": "d78157742ddd8f6cf5e44b7654a04903a0652d82484e909fe366b3b47b23d2a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005418.json",
      "json_path": [
