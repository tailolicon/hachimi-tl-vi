      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:ecb5f8948c54c3edaa114a02",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曾有位赛马娘因为信赖训练员而名留青史──\n为了成为那样的训练员，\n桐生院决定回应快乐米可的心意。",
      "source_fingerprint": "ae383e1c836ec3fa018d3320ee033c707ffdeff2c2c2eb6f9f6d405dfde932c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005418.json",
