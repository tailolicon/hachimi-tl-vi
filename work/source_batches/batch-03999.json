      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:62435621c5220d20132246bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今年一定要达成过去未能实现的目标──\n两人忍不住怀抱着这样的期待。",
      "source_fingerprint": "bb14ddcd7304a164622d9045263b9b3a058278e062ad7306a64a04d344db322b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
