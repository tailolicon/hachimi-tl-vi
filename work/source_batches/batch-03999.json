    {
      "uid": "zhcn:a133b6a42d219f1c572a2cbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总算能够好好奔跑所带来的喜悦，\n以及过去一直压抑在心里，\n“想让训练员开心”的想法──",
      "source_fingerprint": "15841250be64e80956af4cb069aea6f2a51deeb928101c863eb08bbc722545a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005418.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:66c336d85e6656554adf70eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005418.json",
