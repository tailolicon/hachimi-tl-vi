    {
      "uid": "zhcn:0a6897f53673b77abf485788",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "快乐米可的才能开始开花结果，\n桐生院训练员的生活也变得非常充实──",
      "source_fingerprint": "894ff7e96bd82f0376a50412ccb002d12836c36f5224958e859582dff1e63e9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0005/storytimeline_400005418.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:9817b9311791c83fc334e52f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
