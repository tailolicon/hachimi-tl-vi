    },
    {
      "uid": "zhcn:a77ca4b24db7027cb8689291",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为无法控制这些心情，\n快乐米可瞒着桐生院训练员进行自主训练。",
      "source_fingerprint": "2578f5619eabe9c64e899932d66ff6d0588aa500b088355cb44ffbe8a9102dc3",
