        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:8ef910c889b1777b24e1a029",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小小蚕茧见状，\n便劝告苦涩糖衣应该向㭴本训练员\n说出想贯彻自己跑法的心情。",
      "source_fingerprint": "fc055572dc68f92c0d27ac27f653fd090f7a1fa3f38ad4bc207e746d4ec3c2cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
