      "source_path": "assets/story/data/40/0007/storytimeline_400007000.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:a6e88e389ec6358952eb3874",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
