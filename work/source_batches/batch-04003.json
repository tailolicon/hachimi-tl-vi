    },
    {
      "uid": "zhcn:4a13a078211ed3c738458d28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我们共同竞争，共同进步，\n开拓马娘运动员的新可能性！！",
      "source_fingerprint": "755314d187c71d577db836ba3f8b0aacd608c0dcf24eaa85926b0c185737cb74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007000.json",
      "json_path": [
        "text_block_list",
