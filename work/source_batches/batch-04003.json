    },
    {
      "uid": "zhcn:0ccac328fe50e3e8d86b13c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家，非常感谢你们抽出时间来\n参加『U.A.F.』的说明会。",
      "source_fingerprint": "673a9eaab8b69b7b3012bfdde7e5c06f2d7e2bb3be8030cacb8933b0695e5177",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007000.json",
      "json_path": [
