      "json_pointer": "/text_block_list/88/text"
    },
    {
      "uid": "zhcn:2e4c0099b163425d964bdc8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从如此说着的都留岐凉花的眼睛里，\n可以窥见强烈的意志——",
      "source_fingerprint": "72424ae16c43bcf28958276753e7616a0c9b4221aa4a019cead76f2bba39ce12",
