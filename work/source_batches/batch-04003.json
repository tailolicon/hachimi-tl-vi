    {
      "uid": "zhcn:0877d570ed7de4e2e3c24c92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我们一起创建一个\n让所有人都激动不已的新娱乐项目吧。",
      "source_fingerprint": "8b52ed17d135123c2c408bb1ab15aacb4b8d22460282618e1a9150e153f9b4b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
