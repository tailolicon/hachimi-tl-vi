    },
    {
      "uid": "zhcn:c19036443382beb7bd7aff80",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『哒哒！超超超超大跳箱！！』",
      "source_fingerprint": "15c05a9f98aa522dfba40faed1edbd7f09fbf9148b986b578a14e7c76c154e66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007000.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:c3e1b5933342385313946e16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那将会是<chrname>独有的，\n用于攀登顶峰的宝贵经验！",
      "source_fingerprint": "2e4d648d832287defd37b42a8827317dba2473c2418de658578f454ae3e09e4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007000.json",
      "json_path": [
