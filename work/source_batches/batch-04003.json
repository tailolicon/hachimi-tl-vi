    {
      "uid": "zhcn:ce4d608c4620deaac09b6650",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "详细信息稍后会发送到大家的工作邮箱，\n有兴趣的人请注意查收。",
      "source_fingerprint": "3ab205d1ee2fa1633b201aad98d06c6d7c5b31f3b7aab4731cc1b74b862d4a41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
