      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:8e7075349d8bb8a5a46b1662",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "都留岐凉花",
      "source_fingerprint": "00721665c6db017fd5a1331712effd9d9766a5f418c589a3cc53bd055d3ae4bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
