      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "索侬艾尔菲",
      "source_fingerprint": "bc9b12fdd304a650e8ee9687fb50026b44caddb262a88aace81294f220f407d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
