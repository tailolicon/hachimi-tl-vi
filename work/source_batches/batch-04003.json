    },
    {
      "uid": "zhcn:7846bc649bf43bfa51e4a1eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "都留岐凉花",
      "source_fingerprint": "00721665c6db017fd5a1331712effd9d9766a5f418c589a3cc53bd055d3ae4bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007000.json",
      "json_path": [
        "text_block_list",
        72,
        "name"
      ],
      "json_pointer": "/text_block_list/72/name"
    },
    {
      "uid": "zhcn:d724cca3995a1536aefcc682",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "基于先前发放的资料，\n我来说明一下今后的发展趋势——",
      "source_fingerprint": "41f6a40a439be7ba38bfa57b0778c7a3ea25130f1f5d60516369792e8178ba6e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
