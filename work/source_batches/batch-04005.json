      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正是因为马娘独具的力量，\n才体现出其名称中的“动力”。",
      "source_fingerprint": "4c8fad5349b7b787553fa3607590c13ec5b5080bba52104869750f7a10180c7a",
