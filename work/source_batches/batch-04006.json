      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:755f6f7558513010d1cd2f1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "选手需要在岸上拿球，然后进入泳池，\n向水面上的目标投篮。\n比试的是在规定时间内完成的次数。",
      "source_fingerprint": "7c42456fa26a87e1eeba843307ebfe54805c998d4b11fa5be0d5ffac350e5470",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007002.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
