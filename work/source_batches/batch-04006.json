    },
    {
      "uid": "zhcn:509bce5ee165724235450478",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——之后，到了最后一项竞技，\n『地狱水球』的拍摄。",
      "source_fingerprint": "314687b1d4bd1ce263be73468c7449fa094db8ae2bd8f247fa4d448a116c2bd0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0007/storytimeline_400007002.json",
      "json_path": [
