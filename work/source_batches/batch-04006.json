    {
      "uid": "zhcn:8fb29e7011e8986d8817c0d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——艾尔菲用像是拥有分身一样的速度，\n把周围的木板几乎全部击碎了！",
      "source_fingerprint": "aa7b230cccbf260dae8ce2d6aa60dfb21a871f5990b7a147221f761a71108dbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
