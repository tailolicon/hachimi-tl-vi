    {
      "uid": "zhcn:e43c8ed6cc5119486bd77c5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果参加的话，也许可以得到能在<chrname>\n的比赛中发挥作用的“某物”。\n首先在测试大会中确认这一点吧。",
      "source_fingerprint": "1792af2aeba1276acff4d4877af4074ae7854a500e33df94330f139c11ea3731",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
