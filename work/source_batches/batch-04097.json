    },
    {
      "uid": "zhcn:2fec195bf0fe7491200bd353",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样过了几天――",
      "source_fingerprint": "cfc5b5072b157cea7b81697da343b888efe6b3ecba5e470018eed5432aa21bd4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0008/storytimeline_400008322.json",
