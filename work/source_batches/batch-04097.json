    },
    {
      "uid": "zhcn:c433fb64523c66330a43c9ee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你……真的很好吃！",
      "source_fingerprint": "14574cf9ddfe4bb528624ca693c6e67240786d6c3d9cb1ddbe9b3fe2cd889b35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
