      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嘿嘿，我知道了！\n那明天我也会做给你吃哦。",
      "source_fingerprint": "087bde449f6d0cb31172543181c083c11cc4fca4beec0f984014828fdbb5d4d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
