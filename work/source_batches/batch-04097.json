    {
      "uid": "zhcn:84d5814b3bab73aad2adc962",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好耶！多亏了你的便当！",
      "source_fingerprint": "17784bc613d83878e03b56e93deffbeddbab09b6c4b7bf3ce3ba57dbd2f331b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
