      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0008/storytimeline_400008322.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:01bc912208169d515356cd3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最近，特别周经常给自己\n做午饭……但是量很多。",
      "source_fingerprint": "9d7783b0b21f32e0ba4d36fb6163b5766914ef1e233d6975cb1fe550fe50c635",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0008/storytimeline_400008322.json",
      "json_path": [
