    {
      "uid": "zhcn:8150464f36d60b7c76db94e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶，还要吃吗？　减肥的时候，\n都吃了这么多次了……这样就可以了吗？",
      "source_fingerprint": "67eca960a0946ad82aa58ee289b921affe34004f1c683f92f1e90121d55484a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
