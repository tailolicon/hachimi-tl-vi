    },
    {
      "uid": "zhcn:fc3861d15cc343d003b8b2b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我对她点了点头。最近每天最期待的\n就是吃那份便当，\n更重要的是――",
      "source_fingerprint": "dcdf1692a8f8469bc004b31a24844c741192edce6086a322b53a4f891e6d9f78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
