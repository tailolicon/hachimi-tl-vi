      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:28497b6d23e58502fab60617",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不仅仅是好吃。\n这还是能感受到她关怀的便当。",
      "source_fingerprint": "2d3b523d2427e87743b115a7dff5d36c28808a964fdc43dd1da36711e338d8a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
