    {
      "uid": "zhcn:97c37190172447581863c8f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吃着吃着，就喜欢上了",
      "source_fingerprint": "0231eb70e9303c5df995f55145a1b6d35b75b1fc972cf9f5a5f21af49182665e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
