    {
      "uid": "zhcn:c398b6c44c90eefecc61b4bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿嘿……你能这么说我很高兴！\n吃了这个继续加油哦！",
      "source_fingerprint": "696181b0f5bf31f5e35a14a604a542a188fe165bf4ba7bfef84e0ef065ee4472",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
