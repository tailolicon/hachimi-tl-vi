      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:fdcf1dc102e94d094097e9c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周",
      "source_fingerprint": "d2006eb90c4483cd2444ac5e7378edb673044470d41a5dd967aaabbc498929a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
