      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我去找擅长自我管理的人――\n问了她们最适合减肥的菜谱！",
      "source_fingerprint": "d6f56d719504de89a5238afd0b869e7131976876eb130a095dc57f9a4be2b880",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
