      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这样子我也能，\n稍微帮上训练员的忙了吧。",
      "source_fingerprint": "f92300ccf8bdb906aa854db292392e669604f6976e634ba386b2dfc811543e1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
