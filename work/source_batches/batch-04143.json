    {
      "uid": "zhcn:fc25a1c83ab910729d20630b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "ビワハヤヒデ",
      "source_fingerprint": "330fcc73f15df6a7b84facceeed8d601245136f1cd1e422f8b5826a07734016b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
