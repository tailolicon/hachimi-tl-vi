        "text_block_list",
        1,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/1/choice_data_list/0"
    },
    {
      "uid": "zhcn:8d71ff18e6ec928a20bedc27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫凑过来看网上拍卖会\n的画面，皱起了眉头。",
      "source_fingerprint": "2d2fc8c2fe929cc4494a656dad3cafde5a90ad219cabdc5e16b3482a25e03083",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
