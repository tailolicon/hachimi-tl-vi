      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:22bc58d62e7b90452b4fda37",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是――",
      "source_fingerprint": "882b871b451bb344f472368b77ea4f0a3d543b47e3ddec20d4d572d59d51a0ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
