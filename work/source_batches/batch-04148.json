      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――然后到了周末。\n首先在学校图书室集合！",
      "source_fingerprint": "28a7e45da3832a0473882e18ed639e856dbb7a654c47aad53250211dd637dd6f",
