    {
      "uid": "zhcn:447c462a7ed81a1f3e2d6b2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『传说训练员留下的电脑』？\n什么玩意。搞笑吧。",
      "source_fingerprint": "eb4a40319f315cdd68c631e8f7ae616bb03a5acf3d0c4bf663ca0d4cb559076e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
