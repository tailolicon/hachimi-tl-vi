    },
    {
      "uid": "zhcn:39234bdea5446b83810ca685",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我有点好奇",
      "source_fingerprint": "d80bc925de961e750dec70313e9f108a6d380090518a9979aa1c185edfc5b6c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009308.json",
