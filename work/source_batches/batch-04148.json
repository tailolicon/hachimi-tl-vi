        "text_block_list",
        12,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/12/choice_data_list/0"
    },
    {
      "uid": "zhcn:d98967ba344ed6f4812bff71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『传说训练员』写下的东西。",
      "source_fingerprint": "201280cd2811b19774f43064f44f66bb164cfeb960d31a304e029206dbb24884",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009308.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:7edcd2b27a0a76bcde9297f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "笔记只写有这一句话。\n考虑到简介写着，\n希望将电脑交给现役训练员……",
      "source_fingerprint": "e13d2ce5ecb5e0f0899a8dbec4d245ef5414f1758792d9e89561e98f75f83837",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009308.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:7b4fc825acf908e62550c746",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可能留有很厉害的数据呢",
      "source_fingerprint": "b9796ea5da4bc84546cffd85b1470b9bde38ea6f1b1bca1093ccb475b2d0dcdb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009308.json",
      "json_path": [
        "text_block_list",
        14,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/14/choice_data_list/0"
    },
    {
      "uid": "zhcn:8317376806564b37f662e3a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "未来……可能是说电脑里的数据，\n有助于为追寻梦想的赛马娘\n安排训练。",
      "source_fingerprint": "43b1750507da5bcca575cb1894c613772abadc28670059cd65e4d5471f14693a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009308.json",
      "json_path": [
