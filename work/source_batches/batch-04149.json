      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:4f9acb09f93e48add3e7d47d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我无奈地笑了笑，但还是很在意。\n而且这个价格，就算被骗\n也就当买个笑话了。",
      "source_fingerprint": "0af705067ebf03592eb6e6c233a35df5b3175d4a9d750d40d6bcc607204f8dd4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
