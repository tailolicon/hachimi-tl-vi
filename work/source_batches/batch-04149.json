      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:d68ebacdecda303e6c81c2b3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫厌恶地说。\n这是浪漫――如果我这样说，\n她一定会更嫌弃我的。",
      "source_fingerprint": "fa8f82b1c2216133fee119645a32d420b458d64fa947151947c8efd0a79f3b3c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
