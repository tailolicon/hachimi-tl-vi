      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎……别给我做一些没意义的事啊。",
      "source_fingerprint": "2e5b6b07e03b52db7c83da5d4d5c7ec1542826348cb0c467609ee5a38fed0488",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
