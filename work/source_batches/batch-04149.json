    {
      "uid": "zhcn:9a9ad3783a430dda1b5be873",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她依然说着平常那句冷漠的话，\n但是话语中似乎流露出一丝温暖。",
      "source_fingerprint": "3e9d536d5b372e2e707691b25eac8010af2aa8960617aee5d761a1ac05ced9f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
