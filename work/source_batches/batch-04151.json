    {
      "uid": "zhcn:98275e9f7ec92b9e8e913279",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那一瞬间我盯着她伸出的手，\n立刻就明白了她的意思，急忙牵起她的手。",
      "source_fingerprint": "b5ef1296fb1542fbf9c0377de68073a28291a7ae4b209f50c4f8d8548fa5eabd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009311.json",
      "json_path": [
