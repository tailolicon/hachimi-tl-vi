      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:dfbee09c33c90a3551834d7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这杯鸡尾酒，口感清爽且不会太辛辣。\n黑加仑的甜味很突出……！",
      "source_fingerprint": "afe6e678326dfa9cf2ced0a2f38f94244b252105e0810412d713c0e567bffd2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
