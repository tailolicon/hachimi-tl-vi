    {
      "uid": "zhcn:0ba0f1f26d078e685ac2d462",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是我，并非渴望自我陶醉。\n――我是要让别人陶醉。",
      "source_fingerprint": "c25eaf1e47be0dd65d8897932a50824885f1faef4984e9d4b4e15e10785bd7da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
