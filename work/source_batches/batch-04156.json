    },
    {
      "uid": "zhcn:3f889eda6569ffcbda4ada80",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "！？这声音是――",
      "source_fingerprint": "fe284b58fe083eef36e431df376b7f6c593db1a4ae8a51b03af61a2df16fe9a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
