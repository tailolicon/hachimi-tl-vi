    {
      "uid": "zhcn:5faeddb935e3a9bb80db5933",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此，这第1杯……柯尔酒，无酒精版。\n含义是――『陶醉』。",
      "source_fingerprint": "09581d1a894dce64d27f7a53711578188547faa2821394bd93c566260231093e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
