      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『哇，这个骷髅好可爱——！\n我想买一个！』",
      "source_fingerprint": "7137447f2d23010b982299795f516c157207e09f43b096da655950bb9fa4d8c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
