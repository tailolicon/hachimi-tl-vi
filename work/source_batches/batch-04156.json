      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（嘎吱……倒塌……）",
      "source_fingerprint": "18cef751e3fc696030ea643782b3c513e37f3631a6cbfb32c07e58f5f8c9929a",
