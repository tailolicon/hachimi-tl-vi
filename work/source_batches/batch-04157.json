    {
      "uid": "zhcn:1d7589f1a1a9d07ae47f45fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比起鸡尾酒，更像是在喝汤。\n竟然会有这么奇特的味道与体验……。",
      "source_fingerprint": "64c12e206e93b2df6b633d2d3a40c60bc45b47e36c7bcb64fa6e115be928ef58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
