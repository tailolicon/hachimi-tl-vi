        "name"
      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:0b32dd825e51a67ee662e468",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我决定了，训练员！！\n我要开一家让世界酩酊的酒吧！",
      "source_fingerprint": "22529d38c4f4c328c956df9a4b586744d3f5c5be030693207c19d53f8877a6ab",
