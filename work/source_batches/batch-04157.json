    {
      "uid": "zhcn:01c17e6058b5dc33996211ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈——哈哈哈！　你看到了吗，\n地狱之井！　但是你，\n只不过是站在深渊的边缘罢了！",
      "source_fingerprint": "e31243db8fb8ced24431af21aea077ea77715d23508de9ff0f8c0f013c420ffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
