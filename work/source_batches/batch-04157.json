    {
      "uid": "zhcn:606942b58add625a2c8dc8a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……啊，没错。我怎么遗漏了\n亚历山大的灯塔呢！？　没错，我……。",
      "source_fingerprint": "5247153fcd0fab0e1666a3027afe762cf6de1ad24b9281ed8359a1178fccacd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
        34,
