        27,
        "name"
      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:fee9dd1adf4d814f7faa9bde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有多少酒神侍从，就存在多少秘方――\n根据客人的喜好，一种酒也有不同变化！\n因此必定会存在『属于自己的一杯』！",
      "source_fingerprint": "ac6f9923d935ba2f3fbee3d08c8be7ce9551e688f12c43655269d10dd6bae0b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:de604076ea0ce352df07f625",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
