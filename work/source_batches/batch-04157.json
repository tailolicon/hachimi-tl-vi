    {
      "uid": "zhcn:cd30cf68aa1226f21a9df67d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此，第2杯是公牛弹丸。无酒精\n调制。含义是――『一成不变的日子』。",
      "source_fingerprint": "a9cc3284bef0bdf335bfe710e168e676c4079b218daa0a73be1aa8a9d7845d74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
