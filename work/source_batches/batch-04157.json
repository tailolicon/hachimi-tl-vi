    {
      "uid": "zhcn:7560fd7081e194c6a0a7547d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――表情真不错。",
      "source_fingerprint": "857d05dc6c42736c56164b6022677037cc30c62f9f61178501352019eb3dec55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:75e7c5d124398b7075582083",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
