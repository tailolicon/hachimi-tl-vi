      ],
      "json_pointer": "/text_block_list/28/name"
    },
    {
      "uid": "zhcn:dc7196659a7db2da417e61bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "例如――训练员。我来为你\n提供，你真正追求的刹那瞬间吧！！",
      "source_fingerprint": "e9b215835901fb27cbc0dd90eb0b407fbb068f0c2f7f989e20d00fca88bce3fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:9a219739f87abd8eae138785",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
