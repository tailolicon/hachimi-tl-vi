      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:6d82c6c1e9ca016f0e0f61a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不是因为葡萄酒之神。\n而是因为我的一杯酒……\n为我而酩酊的，那副表情――",
      "source_fingerprint": "53b1a2619c8d0e027e5c8698f80f5ee4f6240a45e1373c1b12b4f7a6382b96f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:65f56cdbdde020b1f09a2136",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琴，琴蕾？",
      "source_fingerprint": "a7712de2be5e3e1560ff94c9602137a312fb4024af90739926ec7d4748fe4b94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009317.json",
      "json_path": [
        "text_block_list",
