    {
      "uid": "zhcn:ca5bb88004c811b0042eac5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我不会让您后悔的，这位女士。",
      "source_fingerprint": "96e2f5e70765db757563f92344be6f3b97d06508333367f1f8c22722cef974ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
