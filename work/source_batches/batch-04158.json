    },
    {
      "uid": "zhcn:9464edb721000cde67901deb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "………………呵。",
      "source_fingerprint": "7d2c30d6d357e09f5c06a3a523afc02a3fb96009849b8d265bd48c269b21544f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
