    },
    {
      "uid": "zhcn:3028521adac8a096e251b400",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:3140aa1e83cc9dfebb545966",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来吧――无酒精的点单就交给我！\n木已成舟。将命运掌握在自己手中！",
      "source_fingerprint": "6ec5bad020b0ed6f49cb00c259abf66c6e517da316f4080e5e015a29aa60e215",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
