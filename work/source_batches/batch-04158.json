    {
      "uid": "zhcn:9754d890fc56efe06ae55249",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是吗――我本以为你已经发现了。",
      "source_fingerprint": "7bd13bbab53b406e4f0da710ee3267e1509ca7a7e81dee643382d9d3f5520703",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
      "json_path": [
        "text_block_list",
