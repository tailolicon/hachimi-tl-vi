        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:a984cae0306b2439d7c17be4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您必将获得无边无限的酩酊。\n我向冥河斯堤克斯发誓！！",
      "source_fingerprint": "67403f6b7b3f40978d3f0c345d02e4dd07df6b9a58d560a6511b46642f781a64",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:bbd4854f7a6d6e950a8074a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "客人，请先入座",
      "source_fingerprint": "aeffdaf13c303f22717cf6c6253b890ecd2f206f5e7a2457fa329422644733ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
      "json_path": [
