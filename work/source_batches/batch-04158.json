    },
    {
      "uid": "zhcn:2f9cd6128056a35e32722aab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊……今夜似乎能做出，\n――连月之女神都陷入狂醉的1杯。",
      "source_fingerprint": "2f9b491e23b9d919f64f818a2edfcf31abeb3f2f81f10b1adf728d4cc7fe6b42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
