    },
    {
      "uid": "zhcn:ba9f702c9747a948e86a8a04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是你的希望，切盼，热情。\n才能让我――到达刹那的瞬间。",
      "source_fingerprint": "34b517bffddcf4c75fea26a63f7f161dbff2ee57f54da987a63942e9d1e29c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
      "json_path": [
        "text_block_list",
