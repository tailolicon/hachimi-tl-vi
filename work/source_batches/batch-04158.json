      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:13401531baa0e0d13bc98560",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009318.json",
