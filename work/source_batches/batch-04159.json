      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想在一旁见证谷水琴蕾的梦想。\n这个想法从以前开始，始终如一。因此――",
      "source_fingerprint": "dd1d64f91db53e58c305c2954af01e8f1e0ac66e085a0b9deeeeb6ab999d818a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
