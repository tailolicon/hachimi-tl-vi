    },
    {
      "uid": "zhcn:06528026bd89b67979e2e82b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊……我的幻梦。指引世界的彩虹桥。\n关于这件事……训练员。",
      "source_fingerprint": "e59ad5c924c007e38a1359e9151962da448413dc7d329701fabf6f3129a117e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:041ef1fc70d222100688275e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………诶？",
      "source_fingerprint": "f33c7026de8190317612fbb9d2f3ebf343f48f54a579f73574cf0f2a64efdd56",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
