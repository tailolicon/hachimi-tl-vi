    {
      "uid": "zhcn:4ad6ea5e0bff52e422654d26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真正的酩酊，不在于酒精。\n――我会向世界展示自己，证明这一点。",
      "source_fingerprint": "e265ff8d28e9bf2d31018dec631ea75c72307e87c92a1cb854524f72b59fcbbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
