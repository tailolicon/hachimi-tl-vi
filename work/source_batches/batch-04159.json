    },
    {
      "uid": "zhcn:5db27c9c22fcc6edd97c1294",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――跟我一起来吧。",
      "source_fingerprint": "30c0bef436d1ea70289142411fdd55e4ce9230bbccfae7a462f290ae150937ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
