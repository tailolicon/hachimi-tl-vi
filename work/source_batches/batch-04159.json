    {
      "uid": "zhcn:b153d47ebf914e885231656c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
