      "source_language": "zh-CN",
      "source_text": "没错，这就是我渴望的刺激！！\n通往黄金乡的最后一张地图！！",
      "source_fingerprint": "0045cb9d6433346d3a74440444008dcc22ae8162f508449389c364ffd77ed35f",
