    {
      "uid": "zhcn:dd24987ec0b1e48a814512ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想与你，倾注同一个梦想（共进一杯）。",
      "source_fingerprint": "b8e6a97bd7f4691e50882b7c034ef896b5be5b176a50538496412bb3e7727801",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
