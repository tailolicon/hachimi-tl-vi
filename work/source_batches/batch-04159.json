        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:0b9a2c5b399f035305cbdf45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然很高兴，但她的追求\n我想都没想过，因此变得有些畏缩不前……！\n希望能给我一段时间考虑――",
      "source_fingerprint": "5bc04f484958ea56489ddb343df5c770ff150fcacfcba70c59abe84265b326ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:6d5512a740f98b6084a573ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
