    {
      "uid": "zhcn:c6adee843bfe3f481f460acd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈——哈哈！！　你也能理解吗！\n这种技术！！　积年累月的烈酒！！",
      "source_fingerprint": "c9f73af7cd22af84249ce18b95dc7511589f5f44bdfc81cfad5b70d2e530f65f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
