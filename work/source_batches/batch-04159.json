    },
    {
      "uid": "zhcn:d126a6207155d536abb87e0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就是你啊！！　理解我――让我理解！\n甚至可以说是我不可替代的另一半，\n我的训练员啊！！",
      "source_fingerprint": "60dd3a1d1224c85789cb5baf55293d24ec9bcef899f103734e61164f4d512ae3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:20aaea073570979f9ed0f672",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呃，那个……你等我一下……！",
      "source_fingerprint": "8b056124f1d00313e6e23c4564be6ef5211269435eda9cade9c3c0e261d0ba08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
