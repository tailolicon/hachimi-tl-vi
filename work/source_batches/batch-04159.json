      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵――反正，你已经给出答案了吧？\n那就将理性一饮而尽！　宣泄你的冲动！",
      "source_fingerprint": "1d3da4441b22fc5bfd1fd937c12c856d3c7f5cdcce97aa8bfc12979918439617",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
