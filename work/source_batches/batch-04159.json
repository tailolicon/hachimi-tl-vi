    },
    {
      "uid": "zhcn:1a6d43a34197f046bce5d7c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "偶尔会关心我，欺骗我――指引我！\n信赖，厚爱。为我找到了新的梦想――――",
      "source_fingerprint": "b589287e57961b4c93318281e5363507c96ae76cc2f09975bccf4464af1b9a77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:ebce43a0a785da9e4ff06419",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷水琴蕾",
      "source_fingerprint": "0f369ca4b88e8e1e112bbdc6350fea562c8b217773a6c67f202a3296b773c9d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
