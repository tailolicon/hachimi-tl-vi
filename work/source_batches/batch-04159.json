    {
      "uid": "zhcn:80ae3f5c328f16c7863c1e7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为此我需要什么？　那还用说吗。",
      "source_fingerprint": "adbc5a804674e6963e0c0d89bc8edf1c618c9c1614dd0f8d50bdfe913790c129",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0009/storytimeline_400009319.json",
      "json_path": [
        "text_block_list",
