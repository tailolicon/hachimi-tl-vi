      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:2286d5419fe887dbdc2d5ece",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算这是因她沉醉的冲动……\n在我清醒之前。我开了口。",
      "source_fingerprint": "7cc7b18dd5dbaf83f22527f4866eb15c28b3183cf499597f30d7fea3a33f11da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
