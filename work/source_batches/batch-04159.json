    {
      "uid": "zhcn:adc1b34593bf2561ccc0f7a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我喝了一口谷水琴蕾\n给我点的酒。然后，我开始谈论\n今天她达成的成就。",
      "source_fingerprint": "52df0c3c31f6c2600fa8ec75bf9c3a6806dfad41bbe655796557d08e387834e2",
