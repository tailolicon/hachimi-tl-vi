      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（说起来，她是不是有点与众不同……？）",
      "source_fingerprint": "ec8a23307c85c21358415f633a38b392d30fd89c929b6f6d2ce924cb739da794",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
