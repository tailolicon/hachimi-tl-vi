      "source_language": "zh-CN",
      "source_text": "我的助手……吗？",
      "source_fingerprint": "7d1840b643b9f9b4cca00ddace18c5da4133c8cd205370f4d204a798242bd432",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
