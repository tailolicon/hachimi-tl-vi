      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在演唱会前的这段时间，\n我决定成为她的助手，\n近距离观察海塞克，探寻她的魅力所在。",
      "source_fingerprint": "fa81e39f5bf67ab442d05ada6b1d5a707d572a8834f54f8ec16843d348e7c2c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
