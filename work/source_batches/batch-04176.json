      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:5dc958e1954abc10f99c7237",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使是这两位留下传奇历史的马娘，\n也未能获得的胜利……即便如此，\n她们依然能以充满梦想的眼神谈论着——",
      "source_fingerprint": "92c21e12d603f86d7b58815f2858741b6d699bcb428782189140421b05846f0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0010/storytimeline_400010009.json",
