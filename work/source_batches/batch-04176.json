      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……想让她赢！）",
      "source_fingerprint": "7da378ab7e4fdd12d15595f1451a3e2a8690926a1e4216ce0ef79e15c2021f64",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
