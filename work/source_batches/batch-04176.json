    {
      "uid": "zhcn:7bd4e979c9ff29077b03382d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯嗯，没错！\n还有，那时候的德比也——",
      "source_fingerprint": "65ba58a903aa04a8b9b0140015631a756d4508d71895fa302b6c281ca55a8616",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
