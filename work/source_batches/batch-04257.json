    {
      "uid": "zhcn:8716583a003c43d592233723",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么会这样……！\n被迫面对了一直以来视而不见的现实。",
      "source_fingerprint": "a4d1e0a0bb2f107063ee2a043acb80a4b8ead526e0ac083da58f645388b852a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
