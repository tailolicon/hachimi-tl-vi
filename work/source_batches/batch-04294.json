    },
    {
      "uid": "zhcn:51d444c3b4a299d4b457830a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "资深记者",
      "source_fingerprint": "89ea3cb46f5b9de5195dbd51c4ee66fd550f0b271fb57e129d5f6967db2fe092",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
