    },
    {
      "uid": "zhcn:66000caac3b721c830151dba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夺金旅途",
      "source_fingerprint": "20bbda5954931205d2dfd81e20488d5353e7c76b9f462d09ffc9b6a33a9e24e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
