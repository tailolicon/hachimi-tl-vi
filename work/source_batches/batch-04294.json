    },
    {
      "uid": "zhcn:26c1aaa315369367170e680a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是坚信自己双脚潜藏的“特别”，\n并将其磨练到极致的人们抓住梦想的地方。",
      "source_fingerprint": "7aae2f6846235ecd8047d880f1dac652c3341a18b00a5bf280a162cdd9929718",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
