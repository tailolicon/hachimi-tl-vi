      "uid": "zhcn:e819f0b210ecbd6634a93315",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……梦想小姐。",
      "source_fingerprint": "3bdf05aa5ba768debd94160011b82e0da7b673e4e42e1c6cebf51e8bfd7a4609",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013004.json",
      "json_path": [
