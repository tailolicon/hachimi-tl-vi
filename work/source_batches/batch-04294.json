    {
      "uid": "zhcn:19232fdf2db32ff465c638df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊，是啊。\nBC只属于像你这样拥有强烈意志的人。\n因为——",
      "source_fingerprint": "c931cd2440c0c8bd0410b4b18798cb5a2845445a03499a0b2a9851c6025b4c90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
