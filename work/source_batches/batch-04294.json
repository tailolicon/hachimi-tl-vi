    {
      "uid": "zhcn:9d7d12b30662bceb08c114aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夺金旅途",
      "source_fingerprint": "20bbda5954931205d2dfd81e20488d5353e7c76b9f462d09ffc9b6a33a9e24e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
