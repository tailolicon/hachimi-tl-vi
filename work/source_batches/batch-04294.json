    },
    {
      "uid": "zhcn:00d4e35a0b87f2c0d6a5e0b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夺金旅途",
      "source_fingerprint": "20bbda5954931205d2dfd81e20488d5353e7c76b9f462d09ffc9b6a33a9e24e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013004.json",
      "json_path": [
