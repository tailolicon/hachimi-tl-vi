    {
      "uid": "zhcn:fc2b2d61dbe347b9a6c66f4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "BC自开办以来至今为止，\n一直都是赛事界的American Dream——",
      "source_fingerprint": "e66da11adb329b11e52298802e6f484c6565366a72a36e790b5afab1ae33e5d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013004.json",
      "json_path": [
