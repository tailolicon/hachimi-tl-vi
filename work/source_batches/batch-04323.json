      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:2a75117392eec7814a6ba558",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不要因为\"潜力股\"的评价就沾沾自喜，\n要永远向着更高处迈进！",
      "source_fingerprint": "0e67923efe6259fb1d58df4c583364c2345b82f8625035ca521b202a650e0acb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013112.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:f61287ec6efbf328ac4d4dab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "盛夏的慰问探访！",
      "source_fingerprint": "f61bb34923ed215b02f460ed1c047545632caffdbc462fb3526fa6398a5dc599",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
