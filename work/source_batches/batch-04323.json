    },
    {
      "uid": "zhcn:62a972d8edbdb4ed2a1c6814",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯！\n不满足于现状，切勿骄傲自满。",
      "source_fingerprint": "fc92f6462258a0e13ba31a552914ded43bb21f18f22c466aa901289569bc15dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
