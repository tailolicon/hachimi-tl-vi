        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:30cc99d6fe6a01fffcd18763",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旁白",
      "source_fingerprint": "101f6e6d6095ef5e9c57dc2f71e38d0f4d62423cc5fa4d0b069ac78434020272",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:a29c27f06781b8481eeb64e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『——美国GⅠ赛事的盛典，BC。\n在这座难以攻克的大舞台上，挑战者们蓄势待发』",
      "source_fingerprint": "726142d5760277e1bc3dc6d1c7b2a2f3f0b26947e0b96c1744f1128b45b2192a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1ebb80e4cde9ec6efaeedce1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旁白",
      "source_fingerprint": "101f6e6d6095ef5e9c57dc2f71e38d0f4d62423cc5fa4d0b069ac78434020272",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:36983b34910610ec984b666a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『本节目将追踪她们的身影，\n为秋季的BC正赛做好准备——』",
      "source_fingerprint": "0ffeaff6ebf644a1d747899f507f4bcd1048cf4d23f66b42dcd3789c63514784",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:7dc4c4de83e70dcbe8e1a4b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "希望她赢，希望她们赢——\n背负着这样的\"梦想\"，征战世界。\n这就是『DREAMS』的赛马娘。",
      "source_fingerprint": "dbc861a6e01714d29ad8d0026e81f2a1c43f9921846dffa83858dcfaad5f955f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:22fd55a80692f8fd31cb67a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——看完节目，再次深切感受到\n自己背负着众多人的梦想。",
      "source_fingerprint": "fa73ece6b0b421d1e60653c1e3fcde423d06d21b4b882290627d2b381f206392",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:031b59e85a3a6c5ec292f4ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "距离BC还有八个多月。\n打起精神来吧。",
      "source_fingerprint": "688056773f57d3dd30740d1aa33a2f2b2fc2894e595e69e223fcd6a46e2af526",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:948ebaee38a33bf4573ea440",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为训练员的自己镜头特别多，\n感觉有些不好意思——",
      "source_fingerprint": "f5a541cdf1ab3b478d82589ae2b83e3d382dbda4f8c1cf683bb5efa02e8f9c65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:5584cb7899cfdda474f55936",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果采访班长时间驻扎，\n在训练之外造成负担就本末倒置了。",
      "source_fingerprint": "edc2d8c7cc7c48a45d9a5170a4969c6b898ec44821262fbfa91596dd46b81c61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:4716d62014a148cd746a3072",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且她和伙伴们有多么出色，\n我比任何人都更有自信去理解。",
      "source_fingerprint": "d35bdc7ce4e17ac0b9de20e6a736003fa890061471bfa054c411b4025801453f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:c9697d70b90e4d9ed4144c82",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以一不小心就说了好多。\n……虽然最后被剪掉了很多。",
      "source_fingerprint": "258061e40771c00f17e4214fc884087e2f0847f9b041043573e8ab122b3a1362",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:a5dbbd5298f07b9d663a7a91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，讲述她出色之处的机会，\n在BC夺冠之后要多少有多少。",
      "source_fingerprint": "8b12e255efc2f779c9dbf3c33629d2fef42ecd557ad4a06cad9fc90d1514c1e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:072f4f68fc00bf427780fe16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "到那时，回顾光辉胜利的画面，\n尽情畅谈吧。",
      "source_fingerprint": "34198aa3a6a2f9af82cf294c9c123a86be608eeb81a9c98f27bc0212c090b6d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:ef881ea543aec57075eb98cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "受URA的邀约，『DREAMS』的\n纪录片节目得以制作，\n今晚正在播出。",
      "source_fingerprint": "07c8b0cf8ec74df235244356306371c2a8bc302edadec95efde285e6199e36bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:7c074f29e0d596065a64ec39",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确实，周围对她的期待非常高",
      "source_fingerprint": "00713342aee8c5e1eb2b952d341677fe251bd9dab1e52e561d117f0094050f8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        3,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/3/choice_data_list/0"
    },
    {
      "uid": "zhcn:455b813630149296fe0d5917",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "能造势是好事",
      "source_fingerprint": "42a73b2f3da57626e5c287dd342a209cc091ab387a27720eed7599fbab84c381",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        3,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/3/choice_data_list/1"
    },
    {
      "uid": "zhcn:6f86ea5f27e5f2738b25f5cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为担当被跟拍还是有点不习惯",
      "source_fingerprint": "c163bda456c38ab5ec96b3b83a02f4f7696c6319c84cdf8a2f6cbba527e56427",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        3,
        "choice_data_list",
        2
      ],
      "json_pointer": "/text_block_list/3/choice_data_list/2"
    },
    {
      "uid": "zhcn:492a57b471730240eaf5406c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如今成员们已是实绩充分。想必是为了造势吧。\n<chrname>似乎是其中\n最受关注的一个。",
      "source_fingerprint": "1c47eced1b1bb2544ea809ff8a5bf3e4dbf280914e2a2d0fcf9de7a1b643e951",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:059f246d1a3b123c78eb098c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说起来，去年夏天秋川理事长好像\n也说过类似的话……。",
      "source_fingerprint": "f5eb198f10fe7c21e04b613ff950084802efe691e0cfa50c37493d9e0a8d6d8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:dd2efcec3ea176afaa75fb8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所有人都期待着，她的胜利能开启\n历史新的一页吧。",
      "source_fingerprint": "ac0a94e01250d5535c63c7bb7db931dd672e9abfd5e99764404fbc171fa62f28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013113.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:534e9a070cdc39a0a26e2adb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她如今已是『DREAMS』的核心支柱。\n我自己也这么认为。",
      "source_fingerprint": "c72dbe1d4a3aca55981bc994694fc10c7ab307fcdf64815312e5321b3085125f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
