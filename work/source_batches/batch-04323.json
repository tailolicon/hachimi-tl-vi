    },
    {
      "uid": "zhcn:d1d69a2ef6d416e152beaf94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0013/storytimeline_400013112.json",
