      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――为了让我能一直保持最速。\n――为了继续成为不会燃尽的光。",
      "source_fingerprint": "44f0bf214e1de0a1338f4a3c51be7d7d83fd78cec6fdcf0fc18f2795dc254e28",
