      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………――那么首先，从今天的忏悔开始。\n有悔意的人啊。向拉面碗祈祷吧。",
      "source_fingerprint": "932a24905d2b2fbaf66790d64d82fd7dbaeaec640ceae30e5ac235ca4894ceeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
