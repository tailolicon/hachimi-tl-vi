    {
      "uid": "zhcn:74c0dc27e219604ad89199a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是『学习·维护』的简称啊。\n哈哈，什么嘛。不是很普通的研讨会吗。",
      "source_fingerprint": "530e916866f163b73e26077bc32a501f5c68d3be3bcb44b88ae5b9f4bb07948f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/40/0014/storytimeline_400014317.json",
