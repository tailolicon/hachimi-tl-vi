      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（『为了继续成为光』……吗）",
      "source_fingerprint": "fb4e6544c6f8192cf6a30293ac38259634746e87a811ad6ec55589bef11546b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
