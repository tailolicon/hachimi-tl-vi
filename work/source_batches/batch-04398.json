      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是呢。我也饿了，吃完再回去吧",
      "source_fingerprint": "bc1aee31a42a2684222c364544bec746a02d4bb6a3bc304e967141aaa2b60e13",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
