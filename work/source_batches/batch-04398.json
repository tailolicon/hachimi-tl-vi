    },
    {
      "uid": "zhcn:1fd24a103f801eebc4c7042d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊。我也饿了，吃完再回去吧",
      "source_fingerprint": "6acead2cfb45b168e19f4935ac9b50ee00e5a18a066bc8d50f92927543c2857e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
