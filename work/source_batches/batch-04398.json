      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "硬面堂店主赛马娘",
      "source_fingerprint": "aa5af204161950be678910fbf49dcee41bfbee3dc0fd782ac493824690a637c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
