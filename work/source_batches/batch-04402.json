      "source_language": "zh-CN",
      "source_text": "特别周说完，给了我一张用毛笔写着\n“要成为日本第一赛马娘！”的宣纸，\n字迹看起来强而有力。",
      "source_fingerprint": "9f9622d69c48fe5a91ed7b9fde110f063910410178f0e7be818ba23f58e2ef23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
