    },
    {
      "uid": "zhcn:0dd04c1319e76cf21bf0ad44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周登场！",
      "source_fingerprint": "6b5b438c9f3bd8f79431f9e73fd7d71b18983daca115e19017e68acf748537af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
