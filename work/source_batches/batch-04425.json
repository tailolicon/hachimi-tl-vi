    },
    {
      "uid": "zhcn:3f9621447a34b52d2ead3486",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特别周似乎因为那句话而若有所思的样子。",
      "source_fingerprint": "508c77b54d178502cf9ca3e92d5a212dfaebb71e94837bc5ba6b29a9ddaba8af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1001/storytimeline_501001401.json",
      "json_path": [
        "text_block_list",
        2,
