    },
    {
      "uid": "zhcn:33dcec7eae3ccd5033f32270",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她说“日本德比会是回应\n训练员信赖的绝佳舞台”──",
      "source_fingerprint": "06093ad31bff2b6bc7fa1a4011541fb636485cfdae762f2b276f67201014bd7a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1001/storytimeline_501001401.json",
      "json_path": [
