    },
    {
      "uid": "zhcn:bd38e9b119618e9df71e7e87",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在朝日本德比迈进而充满干劲的某天，\n我们被鲁道夫象征出声叫住。",
      "source_fingerprint": "292d166e6aa653a83841ac5bf89b4a24635f192aae68a7b9ea161361cb3065f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
