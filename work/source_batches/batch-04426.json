      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怀抱着这份不甘心，\n特别周继续朝下一个新舞台迈进。",
      "source_fingerprint": "5635303230fe7eea67739bd3f346f060b99c4bc6afcf8d8c384010d1a364b114",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
