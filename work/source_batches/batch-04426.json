    {
      "uid": "zhcn:60c806d7056cd459c3336356",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在“日本杯”的比赛中，\n特别周赢过了神鹰。",
      "source_fingerprint": "43c2b4d5271773d707d6778021e2eec9598637d5ac5f4a2ebbba9aa829361950",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
