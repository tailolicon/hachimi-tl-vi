      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，这次的经验让她有了很大的进步。",
      "source_fingerprint": "584a972972efb155355c001618a34dd81ea78ea049138bafe675b7044f1d5004",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
