      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然输给了神鹰，\n但这次的经验让特别周\n点燃了绝不放弃的热情。",
      "source_fingerprint": "97145f7a63a6f5b50c3f331e3b7991d60febdc3534bd14a5de97bc4a83c4c786",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
