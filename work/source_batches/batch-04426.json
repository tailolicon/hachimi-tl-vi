    },
    {
      "uid": "zhcn:26e22b6eb4340fb2bc9e72f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本杯结束后・迈向顶点！",
      "source_fingerprint": "86a5436b30cbdb102b8ebb7792ede2af81ee89d261473af2c7dc997e57ea0953",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
