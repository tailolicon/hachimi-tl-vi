        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:d6dd01ca0587cd222a04fb26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "知道了，就设为明年的最终目标吧！",
      "source_fingerprint": "c4f981dbd44da8c7bd818c12fc4923e8304b1a180a044e11866b389162641670",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1002/storytimeline_501002306.json",
