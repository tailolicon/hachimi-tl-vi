      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:666fe5ff561a79017758e0d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我想好好重视她自己提出的目标。\n而且对于具有中距离实力和天分的她来说，\n要登上那样的大舞台绝非不可能。",
      "source_fingerprint": "b839dbca20e346e7e97efc831db828dc66ef47f2da084ce68af99b7c3fce58e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1002/storytimeline_501002306.json",
      "json_path": [
