    {
      "uid": "zhcn:61696aef60584c94dc8253f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿",
      "source_fingerprint": "eb75d8172527b3c333e07414fc28cbbd82f876b513cb7854a257f05f5e6b2ba3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
