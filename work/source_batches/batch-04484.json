    {
      "uid": "zhcn:525b18a3bc036ecf03188784",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──是至今为止，最宁静、最美丽的……！",
      "source_fingerprint": "a3a67b83da272f6636a2d6b5b4eaf90948b01848abbd538abcca853d8a4adbdd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
