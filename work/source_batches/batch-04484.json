    },
    {
      "uid": "zhcn:33b4630550ab569e71f9e8ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏天……来到集训的季节。",
      "source_fingerprint": "d3c2b24a6770b1cd2349e44809aef604db919ce329ee7795be90310e45e3be00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1002/storytimeline_501002408.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:c645b7068c72bdced4b27041",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然无声铃鹿很怕热，\n但她展现出想要增加持久力的企图心。",
      "source_fingerprint": "636c25010c4e4267fab315ec1c6a470b98a5faa5d9dea98bf6335b5ab64cec81",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1002/storytimeline_501002408.json",
      "json_path": [
        "text_block_list",
        1,
