      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:fa043d143819003566b8232c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和她的第二次夏季集训开始了！",
      "source_fingerprint": "bb6a9edd233be67d6ec2e169d8d47973b448b557b2206a632eadcb24e58c7110",
