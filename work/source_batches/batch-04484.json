    {
      "uid": "zhcn:ee73f24c026790f42c81e23c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "穿过众多赛马娘的心跳声……\n冲过这些更往前奔驰所抵达的地方──",
      "source_fingerprint": "5837c5a8be9cf3da57899da052ccae65b1573e49ca5745eb32854af0620aeb4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
