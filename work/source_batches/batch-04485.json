      "source_language": "zh-CN",
      "source_text": "迎向金鯱赏",
      "source_fingerprint": "9b54cec505cf296b5d72c10e4c1631d5eea5e023e4d143f67f434ddb1580965e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
