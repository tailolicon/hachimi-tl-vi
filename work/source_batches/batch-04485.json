      "source_path": "assets/story/data/50/1002/storytimeline_501002422.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:dfb4aec36cb89e62e477c35f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "称霸这场跨世代激战的，\n是速度又变得更快，\n宛如“疾风”般奔驰于赛场的无声铃鹿。",
      "source_fingerprint": "e63920716ec279a64a03f9327c3d809f42bed7aa1547f0fcdd631c27224e01ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1002/storytimeline_501002423.json",
      "json_path": [
