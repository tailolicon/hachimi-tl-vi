      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6be65847a7d77398d34c3253",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她说着非常期待今天的比赛，\n以及往后要跑的所有比赛，\n一面迈向“出道战”的舞台。",
      "source_fingerprint": "19f89c955e8f4fb41eb0b65f6e689acf5117bf2dc43ee9be4f4c06629ff0cfeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
