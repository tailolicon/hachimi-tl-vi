      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每日王冠结束后・接着迈向“光”",
      "source_fingerprint": "d423e8b67e4da0018c5f37949acdeb78996b0ebb891f1051035263af095fe412",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
