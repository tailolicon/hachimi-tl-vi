      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于来到无声铃鹿\n参加“出道战”的日子。",
      "source_fingerprint": "1954332b68a5e20c865423e35dd490a1857b1b897e677e5b90870df3f6faea0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
