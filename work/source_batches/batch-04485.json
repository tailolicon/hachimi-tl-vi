      "source_language": "zh-CN",
      "source_text": "到了“神户报杯”的比赛当天。",
      "source_fingerprint": "2988c57f3afbb5fab1bc744d2fd642419c1b47895e20e16c32e1b8270f9b165e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
