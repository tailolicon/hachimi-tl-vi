      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:701bad0723959c49ed63c454",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向神户报杯",
      "source_fingerprint": "2047d80d3d6e217e4f566228885f8dfde0d56ccc768a85dc9e78dfaf189f42bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
