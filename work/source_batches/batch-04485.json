    },
    {
      "uid": "zhcn:21fc422dd84b9346017b0adc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・胜负的结局",
      "source_fingerprint": "c5e2236d822cea000cb491ee8c7ef4220de4b3110be578cb1b4f2172a9cf373f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
