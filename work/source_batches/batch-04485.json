    },
    {
      "uid": "zhcn:08b3e3a76cf37851fc77371a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿并未多说什么……\n只是一脸忧愁的样子踏入比赛场地。",
      "source_fingerprint": "fa02ab29ea93334b23b33b0bc9cda84b5666ad2b9d8a6f8332ecefe6feda18c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
