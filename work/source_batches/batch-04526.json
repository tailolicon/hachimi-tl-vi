    {
      "uid": "zhcn:6fceded2fafad067f99c7e48",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王成功超越了\n她视为目标的鲁道夫象征。",
      "source_fingerprint": "60b7ae614be11bc19470ad45d2eede83b68ece442906311615a6e1a03f2f259b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
