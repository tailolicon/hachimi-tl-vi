    },
    {
      "uid": "zhcn:be70abaa9a4b78aea3fe89e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你教了我好多我不知道的事、\n给我建议，\n帮助我成为理想中的自己。",
      "source_fingerprint": "8d897c3cd7d1b053ed77d30dbe35e7e757c5494c3adcdcaa7f129578c6b50c38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
