        "name"
      ],
      "json_pointer": "/text_block_list/39/name"
    },
    {
      "uid": "zhcn:6779e860f4d1ac58c0fc7be8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不是超越“皇帝”的“帝王”，\n而是与“皇帝”不一样的“帝王”──！",
      "source_fingerprint": "b18af84069a88ae6f74661972fbbaf881d198e0bd2e010921b38e0614bc9a8c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:da0a4a8d9a1e19573ffea506",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王提过，\n等闪耀系列赛告一段落，她就要拿着这张\n温泉旅游券找人一起前往……",
      "source_fingerprint": "6de409bb2eb4a4b24f0160bb91d91279c73ccd4ea4ebd14f978a8696bea394cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:4ad665956bb21cd0ec6917a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王天真无邪的表情，\n一瞬间看似有点成熟。",
      "source_fingerprint": "8a4f247925dbce752fc7b8fed7e251a94902c6f2213ab0813c6774cf9d71e252",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:116e0a6af81cddb02334f23b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王的确有所成长。\n不过，那只是在跑步的方面──",
      "source_fingerprint": "cd83b9c79de5af60a5d0848b5f6ef50f42a5b9a1fda777aefad411aa8584fd5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:a7797242bc83d98e93fe35e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的内心想必才刚从少女的阶段\n踏出了第一步。接下来她将会蜕变为\n出色的赛马娘……",
      "source_fingerprint": "e485610d1bd4d2c3ac8dde5a5a903df5193c3d2d26c6b0e3a7711ce9a3803f0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:3f8cc74fd905d0aa4b1985aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        43,
        "name"
      ],
      "json_pointer": "/text_block_list/43/name"
    },
    {
      "uid": "zhcn:9ab105a242d565b71350f037",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿嘿嘿，今天跟训练员一起来，\n真是太好了。",
      "source_fingerprint": "5d40a2b42a5ba5ddb9461f2dacb0726bdf5b6680671b6b15eed13e4c512c7376",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:e0bcba99f8c18cc4b62f7475",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在这里，你不会介意吗？",
      "source_fingerprint": "49f93658f55ac211dffc432bdbb361141739ffc9e67c0d7fd6b771c6293f6fdd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        44,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/44/choice_data_list/0"
    },
    {
      "uid": "zhcn:2f7d0239e790752893e8260e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在这里，你不会介意吗？",
      "source_fingerprint": "49f93658f55ac211dffc432bdbb361141739ffc9e67c0d7fd6b771c6293f6fdd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
