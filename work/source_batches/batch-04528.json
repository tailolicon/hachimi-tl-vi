      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:946204135d448308594ab0b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
