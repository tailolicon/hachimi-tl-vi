      ],
      "json_pointer": "/text_block_list/48/name"
    },
    {
      "uid": "zhcn:96ccb2d398fac6251f21e104",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只有训练员你跟其他人不同，\n你不是外人……",
      "source_fingerprint": "1c347cdc77223e834b526672b0c3a24a2d978c1e184327ce824eb64c5383a68b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:d66b3e40face289830dab13f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        49,
        "name"
      ],
      "json_pointer": "/text_block_list/49/name"
    },
    {
      "uid": "zhcn:4ccc30bb444a73c2bd201416",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为训练员是让我成为\n东海帝王的人！",
      "source_fingerprint": "3f1f2f3effd470e525163133c235a1d343cd765476dd13c75654743118d7bb88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:c1a03cac8e82b7e16d9fa863",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我当然有谨慎地保管。\n当我准备从口袋拿出来交给她的时候──",
      "source_fingerprint": "d0c6da1d5a49f82b85a2c5b566af2e8c6d4a7b83cdae4632b4ddf5e58dfd1c47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:5ab96b0182d611b0694ae7dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的双眼闪耀着对我的深厚信任。",
      "source_fingerprint": "b85eaf994866822b0c9e5a25adbf7820485c6c036a13186fc508bc9acd3f79c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:39fec758f45a2aef899cc4b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论东海帝王今后会成为高雅的淑女，\n还是活泼的姐姐……",
      "source_fingerprint": "9eb22060ce5c8a96baa1b6904b049d255d8ff6b512c9c3e77d132208bac11091",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:a48d7cec58a84f914c1e2c6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她这双率直的眼眸，\n是绝对不会改变的吧。",
      "source_fingerprint": "f1b553e319006df4e7abd39adeabd6ea8df04344d45332354958d0d4f5274ee5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:2801d68617f7ed10aac203d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        53,
        "name"
      ],
      "json_pointer": "/text_block_list/53/name"
    },
    {
      "uid": "zhcn:c4e094febcaed46e42f8c760",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "走吧，训练员，接下来要吃饭了！\n好像有我不认识的菜色。",
      "source_fingerprint": "2437011ed506fa6ac7b05f6679a630e21eccedd16a2572ba7272991141b07697",
