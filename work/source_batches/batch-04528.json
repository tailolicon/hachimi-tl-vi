    },
    {
      "uid": "zhcn:7cce8225c41359bfd73b525b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跟其他人来的话，\n肯定不会有这样的感觉。",
      "source_fingerprint": "37306e6295fef15eebad3af93b94f42b884dd031ad2c7c260aa6219201c427cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:6ed0c7e96e77d25e609d07db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果想要独处，\n我在这里应该也是一种干扰……",
      "source_fingerprint": "6f97449e3071fb6eecce77158f709353f37b8fe1421132362d4b805d61af7335",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003112.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:29b0702fc31c28ce7e8e24cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王",
      "source_fingerprint": "6ebfebdaf1aad8f3c9a6b0ce510a7e48e7d98beeed5195167049ee29ff5aa4ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
