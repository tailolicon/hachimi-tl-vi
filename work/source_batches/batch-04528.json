    },
    {
      "uid": "zhcn:ec755c4a9928ef8197ab4a90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员的话没关系。\n因为……你是训练员嘛。",
      "source_fingerprint": "33de4d0f8653edbc6655b5005a7439f11b3f79916d3b687b3e6e3a342f7fd360",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
