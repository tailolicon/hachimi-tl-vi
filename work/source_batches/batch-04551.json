    },
    {
      "uid": "zhcn:a2900cccf945de017f3c6371",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦，小北！\n你是来道贺的啊♪",
      "source_fingerprint": "62855afdf88e1a26fc562bec950cadf34e7ce181a81854819467454fcdd7fa30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
