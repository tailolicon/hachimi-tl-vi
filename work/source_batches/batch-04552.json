    },
    {
      "uid": "zhcn:57dd4f0d07f97949a39f0470",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（春）结束后・为什么？",
      "source_fingerprint": "3495317057e46cbd4b59a7ca465c1111fb8aa1d1ea11a46477352409d11887b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1003/storytimeline_501003427.json",
