      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在夏季的福岛",
      "source_fingerprint": "eba222bf3fbd33eba68edb799d7eeaf1bd12029c8c62b814e0dde2ac8988638d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
