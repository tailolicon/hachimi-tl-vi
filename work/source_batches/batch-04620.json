      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:32ea29697d0692dff00839f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不在后辈面前丢脸，\n丸善斯基对“皋月赏”发动了内心的引擎。",
      "source_fingerprint": "43144335e0bf87d09bc560bc6280558f31705ba3ae33ce2229581bd45c7185ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004402.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:c673a2e7474ff5926f17e535",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让大家看见我的背影",
      "source_fingerprint": "e0ae2f9252b237a4edd69d0903ddc8b45135bec8ead9af03d4ff18bfc345fc5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:84be4a9c9533ad7610132d7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正当丸善斯基为下一场比赛“大阪杯”\n不断累积训练时，鲁道夫象征上前搭话。",
      "source_fingerprint": "ff15188f2ea0a7dfd769095671343fd341fa47cc1fc7cc2a448c0e050a3d2ae1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:d4ffd7fe25cf0c7f7b0e5937",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她称赞丸善斯基在后辈面前\n持续展现理想的模样，\n并表示自己想要单纯地与她一分胜负。",
      "source_fingerprint": "aa6578a75ed65f9f45e7a256e6c1fb07f7e87ea1e551d0e320e3f908dadae2c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:d3b5a6066bef86b553f4226f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "人称“皇帝”的鲁道夫象征提出对决的要求后\n丸善斯基想像起两人的比赛，开始心生期待。",
      "source_fingerprint": "dfa103a43183473e24659ce10eee3bfa84098bf2e0bfe272ca7d45408c18b349",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ac30d801f183fd6bf1279ea9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天后……鲁道夫象征为了与丸善斯基对决，\n也报名了“大阪杯”。",
      "source_fingerprint": "5224aa74f08c28e1e2e23a5f9564714f6ffc1a28ebbde6fc1bb60b53e626e3a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:3530de28c9d033d545f37799",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "更让人崇拜",
      "source_fingerprint": "889ddbbae05905bfbbe96868e132af106ea8693f1ad6eb5af2c9f7e365aac61c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:44422ccb7aa9837e5958b2a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“大阪杯”结束后，\n丸善斯基比过去更努力投入训练。",
      "source_fingerprint": "464203cfd296e3e78b67c72de8bba9bc73538825c2e6bc128f727866c144a91b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:3ab2f4240fcf8504b32a5868",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，看似把自己逼得很紧的\n草上飞和特别周让她感到担忧。",
      "source_fingerprint": "8f93447736cf82c3ca1f5ce5c09fe343ee58d034b93c7483b945f46ecbab855f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:1cff8ed0841ed3cb49f73e5d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而这份担忧，\n以草上飞受伤的形式应验了。",
      "source_fingerprint": "918c80ffa684b42be372696176cde6a46d3c35d9e24ab262c64753f1d07b4e7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:3422eb8dfc05cfd7cbc682ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看不下去的丸善斯基，\n对因为太焦虑而不断勉强自己的她们\n说明了享受训练过程的重要性。",
      "source_fingerprint": "1e72180f22380ca8c09fecaa6dc06d8351a8312da1a70ef157a8aa0a85cbfda5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:4d104443c01e205355755d41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人听完她的建议后，\n也顺利地恢复正常状态了。",
      "source_fingerprint": "30905fec9d0de468046d7ebc4d8c01db3e39972f46e4f6f3bd010f85f614bf10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004404.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:251d82811bff73946852d488",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "快乐的比赛",
      "source_fingerprint": "b93898525b040ff9376863d5a0ed0ee9e1ed4332e005ffd283730ad4e1ba5c11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:2f8f96cc6579210f03bd6e0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了近在眼前的“天皇赏（秋）”，\n丸善斯基努力不懈地进行着训练。",
      "source_fingerprint": "dbdbfc5211745000be49cf3171639e2ff8fc1621218fd04d1b5cc6e252377998",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e46ec14c21c168c924b1c06a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天后，参加这场比赛的成员们\n举行了记者会──",
      "source_fingerprint": "914b0d54ee43de88c1165b4654cb8bde994b99116c5b9de46b65776e883063f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004405.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:5c12da939a18615bed205db5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而成员之一，竟然有总是只在远处注视\n丸善斯基背影的特别周。",
      "source_fingerprint": "50bdd8ff8a3557e0a66b24b146a637a59d02082811cb1e2b1db7e4fb3aaeb991",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004405.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:561e8c480de9aa0d7680ee79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与她对决的机会终于来临，\n并且即将在最棒的舞台上实现……\n丸善斯基难掩喜悦地露出了笑容。",
      "source_fingerprint": "0757972c357547ca3f16722a01ff9202196b55df4295871a7f3cff1d6b7c37f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004405.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:885aa5526ecf26fdfc822c75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正合我意",
      "source_fingerprint": "6129d1c87f1fc573b3d171ca15b61d46cd437206a8375a920684c62611c0e26b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004405.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ee155c7ac3e274e3d26440e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基和训练员两人开着爱车\n率先抵达集训宿舍。",
      "source_fingerprint": "544ea6790a096607968dad7ecc787fffd25fc1ccdd4927ad1e286ddec6d8ff69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004406.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:763e07c0ed912485f3f59a63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了好好享受“有马纪念”这个大舞台，\n以最棒的跑姿为目标，迎向夏季集训。",
      "source_fingerprint": "633f695a43c18ed2bc046a1f2191b5e44ba19768f31c3a3490298411d3fc9c65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004406.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:518430e976b9ecf3d799c920",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第二年）开始！",
      "source_fingerprint": "2e193ad94ba56712a8e92ed87a15587d1a6af48670f61e354efcb818a0837f0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
