    },
    {
      "uid": "zhcn:bdf36727eab7f313c4d7c89d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她决定参加“朝日杯未来锦标”，\n当作代表第一步的比赛。",
      "source_fingerprint": "04d347a4ae5ea642f7d7a5bc0635c29ebc315fcbcf8da1b48408d722c61d483c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
