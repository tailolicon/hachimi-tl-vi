      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在丸善斯基打从心底享受比赛的同时……",
      "source_fingerprint": "78886073e10ec5b8e4a1bfab8062faa0dc9658b071e819467869b96dfe4cec9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
