    },
    {
      "uid": "zhcn:5895677dc75104dcae02812c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“皋月赏”当天。",
      "source_fingerprint": "a532a78c73a8f545bec661d059984d8394d19998c2f8c77e2fa2009271773b39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004411.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:b1232cebc54eb22dc08bdd14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于能站上经典赛的舞台，\n让丸善斯基沉浸在感慨之中。",
      "source_fingerprint": "e9a2de2e01c590282928d81392e9f8b1c641cedfccdf3adaf789cf3afa0a05dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004411.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:1acde9708fdbc4e8379f7f3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了成为人人崇拜的赛马娘，\n她朝会场迈出了步伐。",
      "source_fingerprint": "a4bcd3f29d6403a81f417c1000e1a247b453a342a9273dc87b79a9b0c5d3fbdf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
