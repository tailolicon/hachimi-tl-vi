      "uid": "zhcn:528f99de1773e58f7f5980c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯结束后・望尘莫及的高超跑姿",
      "source_fingerprint": "d8dfae8a4d6f92a3262c429aa137a092de310020e4dbf9d93f32ead674c8bc8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
