      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她表示经过充实的竞赛后，\n今后应该也能继续开心地跑下去。",
      "source_fingerprint": "94669a9b4d5d2274e1c9357eb82c7d7917422f7da1a7539330991c7ee8cb14ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
