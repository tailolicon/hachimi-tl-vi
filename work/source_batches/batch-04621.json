      "source_language": "zh-CN",
      "source_text": "结束比赛的丸善斯基回顾今天，\n表示自己一样跑得非常开心。",
      "source_fingerprint": "51921fea0c75048eb0bc1bfe4a067d2c99f8985a6d4a7f88348a3896ff1529bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
