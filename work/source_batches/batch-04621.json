    },
    {
      "uid": "zhcn:79aaeb94ee32e9a9aa3f369f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向朝日杯FS",
      "source_fingerprint": "c58d0a8ed9da5f98ec7710e3088881050acc605b7600f6ec929511efc05e1d7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
