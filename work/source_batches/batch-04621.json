    },
    {
      "uid": "zhcn:9f7b856bfde359f738ab0d10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在开始比赛前，\n丸善斯基一边安抚紧张的训练员，\n一边走向了会场。",
      "source_fingerprint": "662cb41d874a356fb8e978b7508a35abf182611dd3a94fcc005b0dacdb0985e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
