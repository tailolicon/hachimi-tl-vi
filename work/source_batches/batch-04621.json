      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本德比结束后・传递魅力的舞台",
      "source_fingerprint": "e7726b92f0a3ad636d7dba313040622cfe5c22ea2cf56fb5d22dc3c2b9965712",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
