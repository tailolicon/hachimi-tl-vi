      "uid": "zhcn:893ed31479733c7e1e07c1e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "心情非常好的她为了朝经典赛前进，\n决定参加“春季S”。",
      "source_fingerprint": "42fc183f008fe1734a8972c69c74f780059f33f2b616b5b2a635b7d8008c6996",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
