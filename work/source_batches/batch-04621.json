    },
    {
      "uid": "zhcn:328612b1a73fb4d4e72e58f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接受同期赛马娘的挑战，\n丸善斯基她──",
      "source_fingerprint": "52e83ac32c14f7dc9e8323a332710ca35c65c584648e2e004cdced89235cabea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004409.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a06e23698b08ee21b0c37cda",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说要全力享受今天的比赛，迈向了会场。",
      "source_fingerprint": "aad42c865f15aed7070e7490423df54514ba440159e5073e8b36f914fa58e428",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
