    },
    {
      "uid": "zhcn:5f6482368d3a04a1969b9939",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一直深受丸善斯基跑姿吸引的她坦承，\n希望总有一天能再与丸善斯基\n参加同一场比赛。",
      "source_fingerprint": "ac8c68a4d2a5d6826db014cbbee048af641d6fc1492ad448e4f0fae459bc51f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004413.json",
      "json_path": [
        "text_block_list",
