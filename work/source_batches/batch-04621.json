      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在训练员眼中，\n她和现在的丸善斯基形成了明显的对比。",
      "source_fingerprint": "f535368aeae2f5e92358535ffd0e2928a2d392684e1ac7189b20d5644606612e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
