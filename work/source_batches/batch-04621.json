    },
    {
      "uid": "zhcn:abba30c7e3534a0477b17835",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基油门全开，尽情地享受比赛，\n最终也拿到了好成绩。",
      "source_fingerprint": "3e3813dee549b9fc615286841c64080cef252dbfa6a511ffb52d367445c6cd42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
