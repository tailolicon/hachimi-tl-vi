        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e8c3e95c5e46473143df33eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定新马级王者的\n“朝日杯FS”当天终于到来。",
      "source_fingerprint": "f5492559e15a44ec34075bbad555e519b5cf9fdddf41b71cb62a736247e68087",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
