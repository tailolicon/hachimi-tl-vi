    },
    {
      "uid": "zhcn:6d7e7f948fec374873790c13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基在与草上飞的激烈竞争中获胜了。",
      "source_fingerprint": "7b51923ee3a8a09d4e1a207508a3448ab70da7e3248f0823f3a5185094f53f4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004424.json",
