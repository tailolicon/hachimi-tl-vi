      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“日本德比”当天终于到来。",
      "source_fingerprint": "d459ddf0e157cdf9efe8ce40b6e4cb26e2512cccfda823199b92fb9ce01a693e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004412.json",
