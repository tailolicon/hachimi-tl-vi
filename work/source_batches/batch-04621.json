      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・最棒的感触",
      "source_fingerprint": "c10eb310c97f5b12b235177d4d04a0860b93a05907823bc3cf0c0befdaac1946",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
