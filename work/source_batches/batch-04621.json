      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基的“出道战”终于到来。",
      "source_fingerprint": "62747e0f79740d4767623ccf3333e9f928a62a251047611d7b00245e8540dcfb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
