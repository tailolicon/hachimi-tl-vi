    {
      "uid": "zhcn:b25d95231e5d7152cb115814",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经典级与古马级的高手齐聚一堂的\n年底最大比赛──“有马纪念”。",
      "source_fingerprint": "2838fe389f207d2c147d7fb642bf917a2969c6ba9835f21e3354c385fbfe5428",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004413.json",
      "json_path": [
