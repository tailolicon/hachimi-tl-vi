    },
    {
      "uid": "zhcn:83374ed28c7dd778265effcd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基尽情享受了\n一生只能跑一次的“日本德比”。",
      "source_fingerprint": "d094d88ff43e241ef827f324ea9a2389ee79229ea43d4478407e67a301215509",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
