      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以前曾逃避与她比赛的那位赛马娘，\n在亮相圈叫住了丸善斯基。\n",
      "source_fingerprint": "ec390fcbe4c925c861e26f1bb0f960b013c1e8d915baddaa45e8bca045a0c9a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1004/storytimeline_501004413.json",
      "json_path": [
        "text_block_list",
