    {
      "uid": "zhcn:c1ee7fb29c47115ea6693f4e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我除了挺身挑战之外，没有其他选择！\n──所以，我想和你一起再次下定决心。",
      "source_fingerprint": "8fe063f6d865cfd2dbf2e2dc999f97a2f46e06ba63f7b64ab9df161f1c11abdd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
