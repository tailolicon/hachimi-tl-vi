    },
    {
      "uid": "zhcn:2534cadcad2cf406bbbd4ae1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "值得高兴的是，\n有很多女孩对我抱持着期待。",
      "source_fingerprint": "cdfa84a6e350552a0434b6ee82997f680de7ad6e74ef0e8c4989a5ee8a289e27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005100.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
