      ],
      "json_pointer": "/text_block_list/55/choice_data_list/0"
    },
    {
      "uid": "zhcn:d2257df594b83dbdcaa23edd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "更重要的是，不辜负签约赛马娘的热忱\n是训练员的责任。那么──",
      "source_fingerprint": "e7cb6430c6cae389d5060ea68eacef017a72e0b5f5046e6bc6c96291a089909a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005100.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:4bd658aeac3fd5a28e70a5f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005100.json",
