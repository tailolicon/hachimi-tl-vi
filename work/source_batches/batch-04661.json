    },
    {
      "uid": "zhcn:d1564f714f5afde953734fab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，谢谢你！\n我就知道你会这么说的。",
      "source_fingerprint": "15a595678d6d2c39d2f8ee1b86e3a0e274c915fb8f30649f9f3500454996b40a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005100.json",
      "json_path": [
        "text_block_list",
        56,
        "text"
      ],
      "json_pointer": "/text_block_list/56/text"
    },
    {
      "uid": "zhcn:c5583def02e65513f78ef229",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你连之后的事都想好了吗……！？",
      "source_fingerprint": "f859830e0676b95556fc2cc7a1815c68a479b6fbaff3e0d2168bf6b39e747d10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
