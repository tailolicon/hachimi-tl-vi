      "source_language": "zh-CN",
      "source_text": "抱着“富士奇石啊，请让我见证奇迹”\n的期盼──！",
      "source_fingerprint": "f247ba871cf480f3b5e37715c2dcba27403af1ab508c2ddb98261f1a537fed95",
