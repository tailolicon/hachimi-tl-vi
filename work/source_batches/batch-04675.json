      "json_pointer": "/text_block_list/57/name"
    },
    {
      "uid": "zhcn:607b73304fcda16496458a63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "意思是“日本德比”和“菊花赏”的距离\n对她来说很吃力？她会变更路线吗……？",
      "source_fingerprint": "b576aae9f6a4daab3a0ca75c4567769dc76e391ab48ec9345a43cdd0971d9e30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
