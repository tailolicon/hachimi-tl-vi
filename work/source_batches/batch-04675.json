    {
      "uid": "zhcn:2fbc350071a5de9e46a7bb20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石威风凛凛的嗓音，\n响彻吵吵嚷嚷的记者会场。",
      "source_fingerprint": "3b6f34f3e41b02d2d7d557818990538f04f88896e557a79e3f31b86f13d115bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005113.json",
      "json_path": [
