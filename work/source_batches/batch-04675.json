    },
    {
      "uid": "zhcn:d898bebc636c4211ca59958c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
