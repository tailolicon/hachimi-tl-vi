      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:95d8067dc1cd43fb2b1a0cc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
