        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:0497f65f4ddb39dc33a2e3cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许富士奇石真的有可能办到。\n哪怕是多么乱来的挑战也一样。",
      "source_fingerprint": "8801943512879e974e3d5535f05a0e8b3bda1624fd8c14ee11f550846aa3595b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
