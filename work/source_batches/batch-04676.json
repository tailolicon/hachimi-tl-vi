      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（可能只是我多心了……）",
      "source_fingerprint": "ef78b9b9c027d8f826ff93983ba29af73c5442e5ccc5b00ba42afa4199339bf1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
