        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:850d605afecfbd4d13fb7a33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之前曾向富士奇石吐露内心不安的\n那位后辈赛马娘来了。",
      "source_fingerprint": "22472e548deeaec992fb25a114b2e30032ffb5378c46c784af0e94e95514e627",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005114.json",
      "json_path": [
