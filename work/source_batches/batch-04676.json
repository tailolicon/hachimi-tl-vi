      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石看向我的表情跟平时一样开朗。",
      "source_fingerprint": "bdf0e769e91fc1262470ee7b88e3eef2376d90cbe8ae27e1acb267678afb3a8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
