      "uid": "zhcn:c6040c602e4f0937a3d7e3fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我把那股突兀感吞了回去，\n接着前往训练员室听她要说什么。",
      "source_fingerprint": "e714290bc17e0728439b983c6519e1fb26fcb842e6d6336fc6aa60ce15bf5534",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
