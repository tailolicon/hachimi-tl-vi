        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:6902da6df7af1f8c21fc40d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在经典级的亮眼表现，就如同她的目标──\n不，她所带来的娱乐表演，\n群情鼎沸的程度超过了她的预期。",
      "source_fingerprint": "b53a84f03be894c95867882a9c42decee8acf248fb64766fc5b8d23601e3ef8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005114.json",
      "json_path": [
