        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:763db98a7d87024fbb82ec76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我再次感受到，\n富士奇石身为一名娱乐表演者的潜力。",
      "source_fingerprint": "0fe4877b7e3c15c2d873c146726ab2d757054f11d16e56ebc8ccdaf68f54aa50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
