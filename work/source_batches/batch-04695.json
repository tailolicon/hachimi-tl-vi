      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她跑步的模样实在太有魅力了……！）",
      "source_fingerprint": "9036cecf65b5c3548e2950b4d97e806f9da53bad93b84d193853fde93745433a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
