      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经典级竞赛皆会受到媒体的大肆宣传及转播，\n其中这场比赛又是规模最大的一场。",
      "source_fingerprint": "ff1a16f5ea93d31c5f1c1bb9b1af8eb4073640dde7d242f2dfcd08d3add5071c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
