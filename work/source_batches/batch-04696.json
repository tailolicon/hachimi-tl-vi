      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我准备的惊喜可不只是这样。\n我指着在夕阳上方熠熠生辉的那颗星星。",
      "source_fingerprint": "12a7d78977f617faf92ac5d4a774309c8d9a37f1fd5ab0ae346c67d150fa73a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
