    },
    {
      "uid": "zhcn:cec726d1bf3a853c52a18910",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没想到事与愿违，胸针从我的手上滑落，\n这个惊喜计划最后以失败告终……！",
      "source_fingerprint": "7fd09b8f7f4a14668c4bee77d3123e7487264e1abb5c6a8dc0e072b6f554f65d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
