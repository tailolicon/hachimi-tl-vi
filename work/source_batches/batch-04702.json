    },
    {
      "uid": "zhcn:62f0e5c880ce7a189126c3ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这项决定还有很多地方不明朗……\n不过想必她心中有自己的计划吧。",
      "source_fingerprint": "f767c274d18f0c44ba24bc84339a1bae0051b04980dc2371f4f61dcfd0048cbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
