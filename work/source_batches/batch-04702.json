      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:b17e72780992812039c8f17f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道了",
      "source_fingerprint": "348f1cf1243e74bc40ca0788530d6e72653e75544a25a8262a96b9f37d24c2ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005310.json",
