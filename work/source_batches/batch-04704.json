    },
    {
      "uid": "zhcn:e01d78864a67c011ff377688",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！",
      "source_fingerprint": "98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:fef9b7c853174355048644e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "的确，坊间的报导全都热情地称赞她的表现，\n让人不禁都要畏缩起来了。",
      "source_fingerprint": "bc76842aeb9885d8c4b1cc2abb874930972894c7a7e5a87c9fe4aa3d923854ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:2cec1b19cf33f4c051e564bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
