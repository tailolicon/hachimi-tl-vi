      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:944867ff89fe460bdca25115",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花赏结束后・却是个圆满的结果",
