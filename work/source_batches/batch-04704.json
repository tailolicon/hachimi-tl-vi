        "name"
      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:ed0273996efdcebc68534c2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次会参加哪一场呢？“有马纪念”之类的？\n我会很期待的──！",
      "source_fingerprint": "bf9156a878196524a58bc6d82d75dd0049cc4b3defd58b17890532501496c1b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:dedf633c6d1e62be4643838d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽管与胜利失之交臂……\n观众席还是称赞着富士奇石可圈可点的表现。",
      "source_fingerprint": "9c9479f2003465376ce02fa38f014634bcf99b74eca8dafdd5965a67dfe348d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:ad2a2f6f70155a55e7b9c247",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "热情如火的热烈掌声笼罩着富士奇石。",
      "source_fingerprint": "86cf4e37077906a01d8f7f74154b7e53a410f6a9f1dd9a059e5803d2323d3d76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:951f5f775190e4c27abed8e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黑枣色头发的赛马娘",
      "source_fingerprint": "6551c1cdce33e11647d158c9772eed657782467aa4bdbcd868de0c6cb93e12d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        9,
        "name"
      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:4765fa72c4021336f2042c38",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好厉害……",
      "source_fingerprint": "e6c143da13d23fa8fa3415f44e5ea4e664d66a867bcd554cd22c23b97232e9a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
