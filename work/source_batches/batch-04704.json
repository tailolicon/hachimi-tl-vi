    {
      "uid": "zhcn:3e51b2af0ae4ffa37b2316e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“今后的活跃也相当值得期待。\n虽然她尚未发表参赛计划──”",
      "source_fingerprint": "04054f4000c973123d166bc3073a6b6d7a4b6992ff2b72af8b9c42fcd3b2d3b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
