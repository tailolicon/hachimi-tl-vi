    },
    {
      "uid": "zhcn:d4b3963999b51339fd1febcb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“不过所有人都对她的‘表演’\n抱持着深深期待”──呵呵，真让人有点害臊！",
      "source_fingerprint": "01f5bf859d91b7c14b5d02bd94d70feb3428a79e3469740fa36bda9ecc774f6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
