    {
      "uid": "zhcn:7d404dd0a5ca3221cdf7eb5e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "关于下一场比赛，\n参加“高松宫纪念”怎么样？",
      "source_fingerprint": "b0690faae63f2c3dcb49d80d887a6be938c2b53ae30a1641389ae7f40337c3ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005313.json",
      "json_path": [
