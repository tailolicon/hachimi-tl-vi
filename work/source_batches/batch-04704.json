      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔……详情我之后再慢慢告诉你好吗？\n我想先自己理出头绪！",
      "source_fingerprint": "fc85d4367167d1f17c33d879dbe4ae297a18d614826d357b61f235c0ecd01c42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
