        "name"
      ],
      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:8728e8dfd0d858db8cce4dad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们顺利迎接了圆满的结果。\n挑战比想像中还要成功！",
      "source_fingerprint": "d327c1683e2d420d6c281f337a75a8a3888f6cef901bee59e9c4de5082e9a982",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:3b84c4e136643abd73f62288",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005312.json",
      "json_path": [
