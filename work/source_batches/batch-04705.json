      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:aaacf5a87e2afe3c72f817c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "许许多多的报导和精华剪辑影片，\n像是雨后春笋般不断问世。",
      "source_fingerprint": "2a093d4bb336e7c350c8f4e65e599169eeb276084bfad777e61af3914899eb65",
