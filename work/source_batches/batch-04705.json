    {
      "uid": "zhcn:d79e5b76cf09097a6f2f6bf7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后，外界对她的赞美持续了好一阵子。",
      "source_fingerprint": "42dc87964ca77fa66de9ff0241eb8b1c837cbfc57391a205ccf13be177537d4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
