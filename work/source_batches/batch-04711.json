    {
      "uid": "zhcn:a4bfd8bc1798a356cde24b79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使如此，富士奇石依然感到心里很温暖。\n接着终于就是“皋月赏”了──",
      "source_fingerprint": "ddec27dae4aefe64df357af5e4d5646729e641f7b0780cf1ecfcbab867c92ad0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005422.json",
      "json_path": [
        "text_block_list",
        3,
