    {
      "uid": "zhcn:2d1755057c1f1e74d7380a26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有位记者兴奋不已地临时提出要求采访。\n不过富士奇石仍然帅气机敏地进行对应。",
      "source_fingerprint": "64f3f8f1ac7fdafe46929bb4b18cf32b33f4e1d97b64025ae203299feaf47c6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005421.json",
      "json_path": [
        "text_block_list",
