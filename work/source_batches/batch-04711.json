    {
      "uid": "zhcn:9acecfb846c53b0e70b1027c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石在“朝日杯FS”拿下好成绩。\n周遭也越来越期待她达成“三冠赛马娘”。",
      "source_fingerprint": "9ad3c8acc8d1572953bdb942586e7d7ecd0612b1f1817c7188e423897fb5ab1f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005421.json",
      "json_path": [
        "text_block_list",
