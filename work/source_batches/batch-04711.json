        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:50d43438c632d4c2ca3b504d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・希望启航",
