    },
    {
      "uid": "zhcn:7e086eb3e576f64f81cdadd7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──结果让她知道，比起中长距离，\n自己果然比较适合跑英里赛。",
      "source_fingerprint": "bb55ee6b4708d3f9ae4337f8631b6d5a39bf00e184d05aec1b1b74c7295d811a",
