    {
      "uid": "zhcn:86ada410884dafdfd7753add",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石以热情的话语炒热场中气氛。她承受\n外界高涨的期待，接着向“朝日杯FS”挑战。",
      "source_fingerprint": "09c269244c85b69ff8e49593dde74f00f68a79bfc912542dd911ca4f337efc91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005420.json",
      "json_path": [
