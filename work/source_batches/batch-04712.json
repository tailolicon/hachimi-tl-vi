    {
      "uid": "zhcn:c515d9c98683e87fbd118bbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石漂亮地称霸了“高松宫纪念”。\n粉丝们开始期盼她有更进一步的活跃……",
      "source_fingerprint": "7d6666d456421a369369efe09fa56d756820b1b9c5cabd95387efac1edbfc7d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005431.json",
