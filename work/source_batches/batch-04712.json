        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1551b4f69cc1347ecd714198",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是从那之后，她的模样就怪怪的。\n感觉心不在焉的样子……",
      "source_fingerprint": "6a48110f9f1c7a1c15b260aea37e1aaa8bba67eab14532228aa50583c24276bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
