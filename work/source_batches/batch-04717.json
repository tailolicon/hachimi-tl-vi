      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，\n我要向你和这套决胜服发誓。",
      "source_fingerprint": "3c2adba961505d747e49f270af990555f6b50a4eda64bef34fa58e1c60cf93bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
