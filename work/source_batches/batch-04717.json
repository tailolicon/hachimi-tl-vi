      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:4df80543f6f69cd2ff1dfca8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "围观的赛马娘A",
      "source_fingerprint": "4c5e62dad931005469a24e8ffb2c64cb1e84d23f8b23d6bc5d98472db33cacd7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
