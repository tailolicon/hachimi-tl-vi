      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:ab69f3511489690b8118ac61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石的惊喜还是一样对心脏不好。\n我沐浴在观众们欣喜的尖叫声之中，\n再次涌现这种感受。",
      "source_fingerprint": "bdf89d7e97b75e0c0baeafb66ec6712d9784db0974e16bcea790f526488e536c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005513.json",
      "json_path": [
