    {
      "uid": "zhcn:b851a4b05cf700d01ee66970",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵……求婚是吗？\n她这么说耶，训练员。你的回答是？",
      "source_fingerprint": "382e2c29789febb0c151935c32de94eaaef1f2a6bb2b7608ebd8852c7532ecad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005513.json",
      "json_path": [
        "text_block_list",
        36,
