    },
    {
      "uid": "zhcn:fbf036817b9dc6badce67a7c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当、当然是……我愿意",
      "source_fingerprint": "d22b90e87c8beca545bd857f35de4ff3c47aa0012210f7613402c6df4b65a355",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
