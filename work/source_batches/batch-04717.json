    {
      "uid": "zhcn:9182598359a1fcff3f6787bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，到我实现梦想之时，\n你愿意再和我一起合照吗？",
      "source_fingerprint": "27c679c38c9feb3f855128e25b78983bd73b64a196135e9558963ed7fb9bb300",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
