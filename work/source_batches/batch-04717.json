    },
    {
      "uid": "zhcn:05876911e1b474d3818d0854",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士前辈真棒……！\n好像在求婚一样……！",
      "source_fingerprint": "796c4b4995fbc3dcc5fb4d0ea0c2e27bb03c94455b88c9923de7e5372cb3edba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
