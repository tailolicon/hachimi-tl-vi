    },
    {
      "uid": "zhcn:ffaa5b3009ddafeeadb28542",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉有点期待那一刻到来，\n又好像有点担心……",
      "source_fingerprint": "e3d28e9452eb1274d41eaab1eedf43a76cf72a3023b768626ac1f2e2a1d4e4fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005515.json",
