    {
      "uid": "zhcn:120835bdf4096570cacb5f5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你愿意等我吗，我的茱丽叶？\n……如何呢♪",
      "source_fingerprint": "d9fdd467d9314e1439eea24ae6f7d191fc6fa6c3f3ca2504fdebc3ecfa96194c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
