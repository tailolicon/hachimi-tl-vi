      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005515.json",
      "json_path": [
        "text_block_list",
        8,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/8/choice_data_list/0"
    },
