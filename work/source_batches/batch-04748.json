    },
    {
      "uid": "zhcn:d2d19989cd46d07cbb6dbdc6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来如此，训练员这一整天，\n都在想着我啊。",
      "source_fingerprint": "6ee5928c2a25dbf6a78897969468288113bdd3ea95dd72c540f1f1c989fd5c6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
