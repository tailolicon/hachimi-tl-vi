    {
      "uid": "zhcn:1d73af211d1b58df4d58f91c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我很乐意，女孩！\n既然你选择了我，\n我绝不会让你感到后悔喔。",
      "source_fingerprint": "7f3ee14dafa0ed3118b56770a1336a3dc72325fb5bf9d156075f8dc49b6adb6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
