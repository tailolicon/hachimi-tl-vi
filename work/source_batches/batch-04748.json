    {
      "uid": "zhcn:550df7c52c544b99f11bc669",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那我们走吧。\n累了要说，不要逞强。知道吗？",
      "source_fingerprint": "41ec855fe6fbb4c4b50f4b3e11eab243c86f86b1a36de3ff5efe6a3e492e7327",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1005/storytimeline_501005802.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:8c04b4885488b8dd794cc469",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当、当然没问题！",
      "source_fingerprint": "d0e50047058aef47fe82c3275196cc9b1ac53feb2e01e4f21533c109e5930c9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
