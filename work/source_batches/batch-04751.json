      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“有马纪念”是只有深受粉丝期待\n而获选的赛马娘才能参加的竞赛。",
      "source_fingerprint": "8434bdfaef18f076d0b8db6c174091f8020bdef4305e52dae30056c211915372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
