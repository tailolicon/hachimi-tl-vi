      "source_language": "zh-CN",
      "source_text": "──原来如此，采访啊。",
      "source_fingerprint": "7ba74ee5ffd0c24666495421a3dfd0aba4924b2cb7234adf93454d270817613f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
