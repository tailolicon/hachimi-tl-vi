      "source_path": "assets/story/data/50/1006/storytimeline_501006113.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:af64d5b04615e20588ec8d28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽简单介绍之后，\n他们便热情地欢迎我。\n跟我之前听到的一样，大家都很亲切。",
      "source_fingerprint": "9ff6c7d7918703877364b7aaae579b501c6bfd4813808608dd14b51c8e56a96d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006113.json",
      "json_path": [
