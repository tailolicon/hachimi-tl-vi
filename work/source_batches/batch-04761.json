    },
    {
      "uid": "zhcn:5ab07d46d8750defd8035e88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真的吓了我一跳……\n还以为自己不小心回到故乡了。",
      "source_fingerprint": "2827221aea6ad895428ebc9bb94e6045af980c5b28a97ec2f15de3f6dcc4b3d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
