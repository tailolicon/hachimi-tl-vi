    },
    {
      "uid": "zhcn:c4ebaeaa076c7158bc550534",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿嘿，吓了一跳吧？\n“惊喜”大成功！",
      "source_fingerprint": "f2a24edecc2c1710e897208abd8f1ec31871cbd6940fd767f2e44578e4e7f200",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
