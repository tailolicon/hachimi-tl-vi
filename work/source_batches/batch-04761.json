    {
      "uid": "zhcn:cd61ee65ea8c5fc31789c2eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……不好意思，现在才向你介绍。\n他们是我故乡的人。",
      "source_fingerprint": "10ddf19798f48a8d9af7ac151de15bdf729421c5d431fec0d093b5825b0d63c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
