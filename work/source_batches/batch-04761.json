        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:8a3a0c32a828e86eada97700",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽不断参加比赛。\n粉丝渐渐增加的她，\n收到了一项邀约……",
      "source_fingerprint": "e50696b26e8d3aca956c6fc874905587dd0b7746a320b6989c290b58d1bdb4a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
