      "source_path": "assets/story/data/50/1006/storytimeline_501006113.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:7855415eae047da3ab2f485b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽，这几位难道是……",
      "source_fingerprint": "a16403c5e8907d4e2ab5a686795902c7467608883594401cdedd1bdf57e9342d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006113.json",
