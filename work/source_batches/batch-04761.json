      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，一定要赢",
      "source_fingerprint": "904ee0bd3fde99d1e6ca9d3229731a981b5134f136f137ac32044b27f5495751",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
