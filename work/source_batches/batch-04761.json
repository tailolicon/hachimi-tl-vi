        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:9f76b8eac986e57984c474e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽",
      "source_fingerprint": "11eb326551def639a05cc8c2fabf151803cd99057ccfbaa0c6ba89756bb8c765",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
