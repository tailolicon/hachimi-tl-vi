    {
      "uid": "zhcn:d0ca783592c46d14d9c5b7e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家，尽情呼唤、喊出我的名字吧。\n你们的声音……能使我变得更强！",
      "source_fingerprint": "0d2640668420c2b163ebbc537a63510ccf6f73d4a8a162d99ff849a2c5ec940d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
