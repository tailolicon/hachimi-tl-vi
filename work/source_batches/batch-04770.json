      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:29974074bcee6e00b6321ab8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──学园后方的森林。\n这里是小栗帽非常喜欢的地方。",
      "source_fingerprint": "9724c809821bf06d2e23647afb827295e2211eee107ddc11d3c6804eab9a53a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006205.json",
      "json_path": [
