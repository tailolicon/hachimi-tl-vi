      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也有来自地方的怪物──\n“小栗帽”的名字。",
      "source_fingerprint": "9ad325bfd9d9be7d91bf3a1f35353162375cae095c5b2744fa0962040c091868",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
