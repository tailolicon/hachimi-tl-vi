        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:148b693e3c542e157109a975",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "敬告各大媒体",
      "source_fingerprint": "d5ac87f04c66315a82f3663b4c96871e42e3beafc1663a7fc1c170497bbd2c62",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ef9fc8895666144e50bd5734",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "顺利地不停参赛的小栗帽，\n她的实力已经是无庸置疑的了。",
      "source_fingerprint": "9bec5fdfa360b58c7ea2aa9477ec74ca48b84861d18fc4419d084cb6b44b693d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:a784f6264d509d649d5c3b1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个目标是“有马纪念”，\n我和小栗帽再度展开了训练生活！",
