      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:260c84ab6f6a3e4869e85195",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“我要回应替我加油的大家的期待”\n──她默默地下定决心。",
      "source_fingerprint": "7e47bb2c18fb335a99c47cac2015317636346354b16795fcae4b987b50850c95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
