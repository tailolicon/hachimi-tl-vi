        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:b0db6b580955c798a4d527d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，一定要赢",
      "source_fingerprint": "904ee0bd3fde99d1e6ca9d3229731a981b5134f136f137ac32044b27f5495751",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006403.json",
      "json_path": [
        "title"
      ],
