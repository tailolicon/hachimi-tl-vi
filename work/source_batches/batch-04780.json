    },
    {
      "uid": "zhcn:13daf0c212ef9de080a278ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天开始终于要和小栗帽正式展开训练。",
      "source_fingerprint": "fc0ce5d84cbff2f4ae32c8fa4de0959531c3253b9e1eca73645641dc62667afe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
