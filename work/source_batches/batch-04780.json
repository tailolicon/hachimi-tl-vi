        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:4abc8f66824c934685cea927",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛的距离她在故乡已经跑惯了──\n小栗帽似乎能放松去跑。",
      "source_fingerprint": "b3c1e8a58da4146ac2d75d497dca52f616aa74de67edca39de4f1b3b4cc2285c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
