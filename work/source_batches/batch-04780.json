    },
    {
      "uid": "zhcn:a3f6cf5fce2dabc3049aed00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽的\n“NHK英里杯”即将开始。",
      "source_fingerprint": "a4baa1bb98fd3219b33f00535b5f4518134b6d4e2b150acd3da61a084cce76e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006407.json",
      "json_path": [
