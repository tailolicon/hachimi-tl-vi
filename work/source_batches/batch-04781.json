    },
    {
      "uid": "zhcn:f974db6361d1c8114c3fc748",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在高手云集的“有马纪念”上，\n站上顶点的是小栗帽。",
      "source_fingerprint": "485d2baab0b547dc72cc9ce1a1815b48fb4d71a7ebe9362e5be15ced2fc77186",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006424.json",
      "json_path": [
        "text_block_list",
