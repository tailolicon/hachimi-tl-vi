    },
    {
      "uid": "zhcn:5fe629f60b8222463a3a70b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・小栗栗！？",
      "source_fingerprint": "3e07e64283278025a5bc02e64514a4131a81d22d8e88170058d999bde72de97a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006419.json",
