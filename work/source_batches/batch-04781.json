    {
      "uid": "zhcn:84dc23ef5eb42848b1ee8427",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为下个目标“天皇赏（秋）”做准备，\n让她大吃一顿养精蓄锐。",
      "source_fingerprint": "4506defbd874e58eecf6a65bc2f5c26f61ec69c9e65ab42de60bb912e614b4c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
