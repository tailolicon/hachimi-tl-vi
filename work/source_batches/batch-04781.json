    },
    {
      "uid": "zhcn:175528f14f3eead113b2c63d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗前辈，谢谢你。\n那我先走了！",
      "source_fingerprint": "757250ff6ecbc5c2b25265e3cd321524e3f609b5b23510c5afd23801ee4448c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
