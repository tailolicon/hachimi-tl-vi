        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9b011d84c27985b529feaf53",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了引颈期盼自己变强的人们，\n小栗帽发誓要不断赢下去。",
      "source_fingerprint": "99f4b39466ccf3cef394443e56d6050f49eccf2a58b9538cf00093ddc6593603",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
