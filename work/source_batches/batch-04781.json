      "source_language": "zh-CN",
      "source_text": "我不太擅长向别人表达，不过最近……\n嗯，说得比以前稍微好了。",
      "source_fingerprint": "897f1215d68fdde603ec4adf6924dd8ab9c29447d4ec14c9129e550dd26ecf29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
