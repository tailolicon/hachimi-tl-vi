      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:a074891e9938a37c561f3079",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "震耳欲聋的热烈欢呼声，\n全都是朝向当今霸主的小栗帽。",
      "source_fingerprint": "577bddaa5fbd993fa2b5efe36c9ccc1cd226b461a714f15d4a119a480feba87f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006424.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e231b49a2248b25205d191c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“谢谢你们替我加油”\n──这短短的一句话，\n包含了她内心的百感交集。",
      "source_fingerprint": "3f5d50912cc075047c0ec1bb42545a79403207306ff5f2c30ed580afe23f6624",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006424.json",
