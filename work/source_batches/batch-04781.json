    },
    {
      "uid": "zhcn:5148073493d1921c87b23ca0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听见玉藻十字成功超越了十五个人，\n小栗帽感到心神不宁。",
      "source_fingerprint": "9690b344bfe90baf50ae7578a9ef6c192619562be825359f65d83cc8d564b975",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006416.json",
      "json_path": [
        "text_block_list",
        0,
