      "source_language": "zh-CN",
      "source_text": "激战到最后，\n赢下“天皇赏（春）”的人是小栗帽。",
      "source_fingerprint": "69e26df9fce96477b23814a3690bf25a04df0f7974c736891bf0f08b6365d0fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
