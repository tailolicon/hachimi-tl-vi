      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・突如其来的闪电",
      "source_fingerprint": "9871ab635b363f560c6b1a25f8b2e08b36d230c55c5e839afc777c1c2af20835",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006414.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
