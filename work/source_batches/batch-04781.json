      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・惜败与闪电",
      "source_fingerprint": "d714cb03a03f6a6c67773f2f5fc82122188e3bc223243297a5c2e7efe7fd255b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
