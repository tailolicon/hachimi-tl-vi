      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:565dfd178babd7a7666067fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "刚才那是？",
      "source_fingerprint": "dfd8e2f7ef460c52f544fa8b6e427c25ba6a4eb0bef56c2228e79a7c84fa90fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
