      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1fcb1cf381f695785d5d5c8b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在超级溪流和稻荷一的说服下，\n她决定要敞开心胸和玉藻十字坦白──",
      "source_fingerprint": "72e90c8f2f8edbd376aa7fbb4f085766765d8be55cc73b80fc0e01379820c551",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
