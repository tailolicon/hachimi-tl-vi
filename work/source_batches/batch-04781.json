      "source_language": "zh-CN",
      "source_text": "她来问我跑法的事情。",
      "source_fingerprint": "ac89415ed2648521eca742be0e9b87aeb42c9e67814270e862dc426c6923ec48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
