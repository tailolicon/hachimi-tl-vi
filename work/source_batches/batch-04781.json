    },
    {
      "uid": "zhcn:91d82939a1e7536ebb3753f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在比赛开始前，\n双方的情绪早已开始沸腾了。",
      "source_fingerprint": "e8d6e84c03c74b3be7df027875b95ab26136d9d4c5b2113f21e97802f015be20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
