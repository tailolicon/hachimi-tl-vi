      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在“有马纪念”输给超级溪流的小栗帽，\n发誓下次一定要雪耻。",
      "source_fingerprint": "19abea642b3b316ffe947ed5a63618dc461597a917297b22e8f044c9d0bc5381",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1006/storytimeline_501006415.json",
