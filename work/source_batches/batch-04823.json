      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:8cbb61b0e26ac926b84eeb17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金船准备的杉木，全长似乎高达30米──",
      "source_fingerprint": "2d9e6e9ed0d28f091f2ed74d2fe3ccb7081eb21133a3f2b20b5c7685e1b44d7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
