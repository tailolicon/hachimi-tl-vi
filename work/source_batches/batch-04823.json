    {
      "uid": "zhcn:948ba74315d0b334e1bf953e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对啊。我带了一棵超大的杉木过来。\n我们一起突破天花板，把树种在这边吧。",
      "source_fingerprint": "0fb224f040194bbeadbd2d601f20f9bccb093c9f8ca0ddb2f316587ea2f02774",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
