      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:ebf3a466c8e31b6efd0b4ab5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我郑重地回绝了放进自己房间的提议，\n并将这棵树送给学园拿去用在圣诞节活动。",
      "source_fingerprint": "b52992923739b35ac5144027b6e55efc9c9f5e468983c94ab8c60be3a6d5cd6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
