      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我表示之所以会说恭喜，\n是因为她在这段时间表现非常优异──",
      "source_fingerprint": "5a51a9326ef0195db63caf4a2055f34d4f9aee83fdc9911f98db048ba32a4646",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
