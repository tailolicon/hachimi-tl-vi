    {
      "uid": "zhcn:de6d564de85dcc815e6f9042",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实我也已经完全不记得\n我们为什么会跑到海边来了啦……",
      "source_fingerprint": "3e17560f03c538423dd9111b24c62c5cd8e1c4e3b40e8ccfbeb078c90e34006f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
