    {
      "uid": "zhcn:df42075299757a37e5b5e59f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在暗红色的天空之下，\n一波一波的海浪声令人心旷神怡……",
      "source_fingerprint": "b5aeaad585198dd82e76ceb85d4ffaf76c90e6bb7ba41bceb51addb160d14f40",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
