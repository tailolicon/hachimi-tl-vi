    {
      "uid": "zhcn:af33681f2c4099921c2cdcbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "归根究柢，我们都是受大海所孕育，\n或许……最终注定要回归海洋吧。",
      "source_fingerprint": "76555ced20005114f471b64c95b418caa43310a4c9bdfa1a32c9ea3bc81d0854",
