      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对特雷森学园的赛马娘来说，\n最初的三年是非常重要的。",
      "source_fingerprint": "94c26c46314e5cc768483982934d1a9099f1ca187cc2a7f0fbff3190536e8b83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
