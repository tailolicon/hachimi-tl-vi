      "json_pointer": "/text_block_list/25/choice_data_list/0"
    },
    {
      "uid": "zhcn:f11b9dd766ae918a85ec0c64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但有一件事情……\n无论如何我都一定要说出口。",
      "source_fingerprint": "b85ee8aa882662b205428c9d750f6e10599ad8523e9f611e79d6361cc227f498",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
