        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:6f8385708f23a6e51cfaa369",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说到这里我才想起来──\n一直被她牵着鼻子走，都忘记了最重要的事。",
      "source_fingerprint": "6bf7f10993167d024786d94a770d55a191158a2bbeabd049ca3d06c086ae94e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007111.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:6dfc4a85afeed9b91e24d38a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恭喜你，黄金船",
      "source_fingerprint": "e895481867897409637fc438013caf39712355bf389009632e69ee23f810142d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
