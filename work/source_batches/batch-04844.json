        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:ce207e9396ec30867e579b50",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人的孽缘亘古流长，以前曾经\n为烤鸡串的酱汁该有多浓而大吵一架……\n（※以上内容纯属黄金船虚构）",
      "source_fingerprint": "8ca9715ed87f9488bc82bf70fb42a66c58b7794ca1ab849a3a4bf7590fd5f6a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007422.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:2b2a8cd90dcf6e72421889d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金船以几近找碴的形式，\n让两人决定一决高下。\n胜负将在竞赛中决定！",
      "source_fingerprint": "9444bc87c6a46599909b04e9b7c42832ff6be8f272717d893746b8adac65b6e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007422.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9c22f5cbb0a22a2282ef7764",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（春）结束后・关键字①",
      "source_fingerprint": "9c85a34f01fd5ab61b44603f155502e75c2d28adb4dd7b59280bac7c2f5f7b8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
