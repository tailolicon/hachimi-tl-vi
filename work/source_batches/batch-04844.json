    },
    {
      "uid": "zhcn:76575afe1677fb95b210953e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空战！！陆战！！车站！！网站！！",
      "source_fingerprint": "5fc0f2e2b49c298cce820654e7fe733dc2105b912ec5e285a72cb42fd15908f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
