    {
      "uid": "zhcn:61dee86af7f6bebb4ae1bef9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "厉害到可以名留青史",
      "source_fingerprint": "7007caf7e7293b182577a8c665c1e32a2488b65de7e432e2977d83245bd993e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007424.json",
      "json_path": [
