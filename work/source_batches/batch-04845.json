      ],
      "json_pointer": "/text_block_list/3/choice_data_list/1"
    },
    {
      "uid": "zhcn:fa3671302b5b80e8a2d783cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这时，会场内传来了恭贺黄金船\n达成“宝冢纪念”二连霸的声音。\n训练员也对她的壮举感到高兴。",
      "source_fingerprint": "8cdd4c6c9833214fc9d2a7f3af457376f43dbce6ba4b7ef639cb9af86f820aa8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007424.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:7d986f692762755ee1fabd88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金船对此感到开心，\n决定买红白馒头回去吃，并把皮分给训练员。\n只有皮哦……",
      "source_fingerprint": "610a39e15b7648a676cded7fe15698edb3e0d78966ca7f14ee728475446d7111",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007424.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:7ab4dfaf607710e2dd3d301d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金船对此感到骄傲，但还是不满足，\n于是催促训练员多多夸奖她。\n这家伙怎么这么可爱！",
      "source_fingerprint": "abe0b1ea3042428cb9a8c2f7d79671f1d39f6b6ed5347407be6c89ec9f292d9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007424.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:19d883c139fbb0019b340564",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她也因此斗志满点，\n决定明年要拿出烧毁闸门的气势\n让会场更热血沸腾。拜托不要！",
      "source_fingerprint": "4fea568816a5e13bf75ea28680237d746c3433c0731bd0010416525ee2f27206",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007424.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:e1e77010f8383d5643c7b6a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・关键字②",
      "source_fingerprint": "0a742214e54c85a36fa2547f13e65db4c18d2b87e1d61b7e2632e4ecfbb19bf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007424.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:42a89c526f757cf335755917",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与劲敌之间的切磋较量让黄金船获得胜利──\n只有在最适合吃栗子的季节才能有\n如此浪漫够栗的展开……她到底在说什么啊？",
      "source_fingerprint": "98f488f0ecdee99ae93d79f5731fc86a688133b9586235ba75d3bffe230dc8b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007425.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:4ec71ec8254d0323dd2ae369",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过天皇赏（秋）拿到第一名绝无虚假。\n与东瀛佐敦誓言来日再战后，\n新的关键字也翩翩落下。很好！",
      "source_fingerprint": "1df10938c65d6d4c063c1533f959c54582f6f5c6ba3ec22289b75004edc7b714",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007425.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:372a9b6f17215320f0640394",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "竞赛结束当晚，黄金船又做了那个梦。\n称呼黄金船为金色船只的声音，\n其真实身份至今仍然成谜。",
      "source_fingerprint": "6be6a4e58e9214a2dadb535a1571bd29ae70f7cbb0574d43fa8473b5cc03e315",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007425.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a94be31a2fbeb6f099e8a7d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "后来黄金船发现梦里的声音\n似乎跟中山庆典很像，\n梦境的真相正一步一步被揭开。",
      "source_fingerprint": "f75f4a494bbd72ce5c9c9ef1518d4b5748adb78eca7971231da4689b7684eabe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007425.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e3a7664ed4717b8379187f9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・关键字③",
      "source_fingerprint": "535544479ba86f0b38a668d795efb123a49f3944d18b48899d5950acaf208b6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007425.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:21e57e8de132ac8a40c778cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“有马纪念”大获全胜。\n跨越了名为劲敌的山脉，\n黄金船终于攻上了山顶！",
      "source_fingerprint": "f39356ad0ad3bb4e989d9faafec6d674f7219c5bce7cdcbebafa7e88f345c030",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007426.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:38590cdeb69c47b76382dac3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接下了最后的关键字后，\n通往伊甸园的康庄大道\n终于在黄金船眼前敞开了。",
      "source_fingerprint": "53c3c8664751bf1ea2112aafdfe350c5aad50edcdf9487c7c2de7bfb214e555c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007426.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:20abbac1716b8be949762a3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・最后的关键字",
      "source_fingerprint": "6febcfc70964d3366513efce1b4dc32c4843ef55a11180bbf917741cfd233021",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
