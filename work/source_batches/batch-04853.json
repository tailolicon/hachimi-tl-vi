        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:1da964af7c168e381d80c47b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在粉丝信当中，夹杂了一封令人在意的信。\n里面的内容是……",
      "source_fingerprint": "549ad1bab3ba2dfdb6c0e83a999698146e869139782e010064046aeb02f1ee47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007515.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:477df9e34e7567c242f47302",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“你后来都很自在地走过来了嘛。\n我今后也会继续看着你自由地活下去的。”",
      "source_fingerprint": "818566e1831d2ce71e7b14731dfbe0dba0af25100b8ef326b63b850364cb416a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007515.json",
      "json_path": [
        "text_block_list",
        56,
        "text"
      ],
      "json_pointer": "/text_block_list/56/text"
    },
    {
      "uid": "zhcn:b90c4f5fedd5d185f22ba802",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……信上没有写寄件人，只有这一段话。",
      "source_fingerprint": "59baea3d3974287f14584ca616aa2263279d6af42e5421d6c840bbc21536860c",
