      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "按照刚才的故事，\n那个赛马娘应该比黄金船还要年长几岁。",
      "source_fingerprint": "123e728e5530231afd20ee2632b465a3fefc02e5381b4bd0d1fbfd135fbf8f6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
