      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在已经几乎忘记这件事情的某一天──\n发生了一件奇怪的事情。",
      "source_fingerprint": "54ae537899294307635d3a087fa13f88b5f9f7bd857b7835e4575ba87cbb821b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007515.json",
      "json_path": [
