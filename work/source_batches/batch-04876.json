      ],
      "json_pointer": "/text_block_list/36/choice_data_list/1"
    },
    {
      "uid": "zhcn:f4afeb3d206b0b920503e91c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，放任黄金船想怎么做就怎么做，\n也让我有很多不安。究竟该放手让她玩，\n还是想办法劝劝她呢──",
      "source_fingerprint": "70d702b7e82566f2294d6897cff1bb06fb7919b231789dbb1f959f4181b9dab7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007800.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
