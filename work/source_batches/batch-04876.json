        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/36/choice_data_list/0"
    },
    {
      "uid": "zhcn:f9ca68d03602ebe67fecc3c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我来想办法劝劝黄金船吧",
      "source_fingerprint": "9db06a1db9dcffed15dc4114025ba1ca54c7600feb1a9cb44ffbe953b8718828",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007800.json",
      "json_path": [
