      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:c17512e963364c3487360b94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就让黄金船尽情去玩吧",
      "source_fingerprint": "c0fb1746ec0608c9a655d6b525e25a1a16be2829d122d687c1b6a5fbc36fe387",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1007/storytimeline_501007800.json",
      "json_path": [
        "text_block_list",
