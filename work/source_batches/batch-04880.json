      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，怎么样！你是想要回去！\n还是想跟阿船一起成为勇者！？",
      "source_fingerprint": "7b5ea4f421daa18a6060bd37ae0f2ffb4b70d9b0d76e56d54d01a327e2d997d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
