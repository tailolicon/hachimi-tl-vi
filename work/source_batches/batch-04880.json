    },
    {
      "uid": "zhcn:294dce801a9c8ad8722dd02c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……唔、唔～？",
      "source_fingerprint": "1694deac0c6d5f141c33eacbfebc621a53d40538722389de6c8e8ccce01bbbc0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
