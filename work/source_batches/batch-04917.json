      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:d1e9cba307d3cf0dc41dcbfc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我还是两边都无法舍弃。要是之前的我，\n可能就干脆地放弃跟她决战──",
      "source_fingerprint": "417d49222cda45da02f6334a9e3a8dfb421d11189af385a61249b411c7bc40ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:2b7f36b4f350d70b1b68f2ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
