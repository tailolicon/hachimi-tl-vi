    {
      "uid": "zhcn:8470096bc65dc1a4bb7ed83c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许没有正确答案。\n但我得跟伏特加两人一起找出解答。",
      "source_fingerprint": "be4bbd2a37ac4fad0342ae7e4627201624c9bd7f20db89e7bda134968c18e60d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
