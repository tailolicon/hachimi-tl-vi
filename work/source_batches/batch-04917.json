      "json_pointer": "/text_block_list/39/name"
    },
    {
      "uid": "zhcn:e44f42e92dbfae322177f0d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──训练员，我想到一个办法。\n你愿意听听看吗？",
      "source_fingerprint": "c4ccba47cf3280b96f0ae9da3fa30c46cd9d02819482a40a0db28d73659e2430",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:f59f4a01f8491facb22fc68f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥",
      "source_fingerprint": "4368033ee11e70f9e85c989f7996583bc525328c9bc3374bbf30f33c6c962b0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:e6920dd8e91856d58606347c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，出道战之后的我，\n已经不是你知道的那个我了。",
      "source_fingerprint": "759a45bf72c535a6caec21137941196c2b9a96d1a34e1099c99235f606c8bc5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:b33b238c1755fd7029ee804a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
