      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的声音带着觉悟。\n虽然现阶段就下定论还太早……",
      "source_fingerprint": "c8b5a6d9550340192ffc99dd1d0dc0d0d49ea827010127c025df8013177ff245",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
