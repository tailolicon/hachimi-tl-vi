      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我、我没说要放弃！但是……",
      "source_fingerprint": "a03ca426daf4d60f09adbdd740cb4350cef9630c490862f0b97377bec92709c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
