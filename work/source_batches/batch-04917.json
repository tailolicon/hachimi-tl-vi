      "json_pointer": "/text_block_list/41/name"
    },
    {
      "uid": "zhcn:4b9401b53e4afadfb6e05d9d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但今天赤骥的表现跟往常不一样。\n我感觉到她的气势不只是嘴上说说，\n还有令人畏惧的未来性。",
      "source_fingerprint": "5464e086360e7c9767b5db4f7e0c6bc8db25aa350ff95e0f31d0bd1a6052bb96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:3aff1bf0d9b261212f6f6348",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008306.json",
      "json_path": [
