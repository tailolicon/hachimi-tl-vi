      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样的话，比起多用策略的中长距离赛事，\n参加能够专心奔跑的短距离赛事比较好。",
      "source_fingerprint": "b3d1b79973d03326e80bde9093b999f1dcad74cbad6dde6f3d8ff97a86ac3a5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
