    {
      "uid": "zhcn:9ca80342cc5ad8e1ef36db90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她狂妄地紧盯天空。\n那锐利的眼神，让我的背脊一阵战栗。",
      "source_fingerprint": "23e153dc769d26fb52b1b9bacf9bc8a8b931be4ee88abc21d41308623a230551",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
