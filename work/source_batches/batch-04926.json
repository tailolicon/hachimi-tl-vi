      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不断精进自己的伏特加，\n毫无疑问地已经到达了她的终极目标。",
      "source_fingerprint": "73e01f5199fbca8f507f375d5dc5c2e7e6707ce5c514d996d9ebf79cbed9c14e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
