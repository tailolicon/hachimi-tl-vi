      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要瞬间痛宰她们。\n现在的我──不会输给任何人。",
      "source_fingerprint": "e73857c64beb6952c38eeef35c77c82baea9678ce1133e7774797b7ca570abff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
