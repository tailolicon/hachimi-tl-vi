      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:8db4c563e6e4d9aa1f9170ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加",
      "source_fingerprint": "936b913dcb1f27dbee46a97574310aa298d979e5c981016503a536df039379e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        7,
        "name"
      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:5fab2bf97704f7089c67b504",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多亏有你，我才能实现梦想──！\n太棒啦，太棒啦──！！",
      "source_fingerprint": "dc71dc7323b71d3832dc36890f5085101841b551c76e2a466bed28605861c63c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:dec5150c9f570511334716ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        8,
        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:49cad5df9c63a5c544efc73a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一边欢呼，一边紧紧抱住对方，\n力道之大几乎都要喘不过气了。",
      "source_fingerprint": "e1b0a9edc56039b3d303929964a944f4aaf3b67256c9b7e90f3478992c48d56f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:a56e5051f02d8100d4eb104b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        9,
        "name"
      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:de11dbef0e7fe85b39def0e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "酷帅的她，身体却炙热得\n似乎可以点燃东京的草皮。",
      "source_fingerprint": "4a86a52a7b50de2ef640dfb2430a609920f470b7b79f0416785d237c15bc8660",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:605a5b66b5d7d2bb444583c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・正因活出自己",
      "source_fingerprint": "bf34462426b4203d0058c61c8cbedad43d66b96d5ff216279117bddefd95021b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008320.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a5651ccbcb8101ac4c98a6e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "年幼时观赏了“日本德比”的伏特加，\n对激烈的德比心怀向往，\n立志成为帅气的赛马娘。",
      "source_fingerprint": "b909c8bd17862533dc66d4ad36a8645f935f330072323880f92b7501f568514e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008400.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:26ecdd4eea27c5ead567f927",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了被憧憬的成田白仁认可，\n并甩开总是对自己纠缠不休的大和赤骥──",
      "source_fingerprint": "3848fa25f08337aed4dbac76c4a564afbada4b17d8829ef48b3f6315ecea24e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008400.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a10bde1328ad497e5ddf8acf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在伏特加站上闪耀系列赛这条起跑线，\n隆重地发动心中的引擎。",
      "source_fingerprint": "075f4aca74eef3e8b3bcb59f2f5e7b61d3a10041fbba9c33cb232f4c1643b52b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008400.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:468d73bede0dc461399470d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加登场！",
      "source_fingerprint": "b8aa1bbabc1fa13ca40f3463556a1d412420de37d47599bdbeddfbd0326164b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008400.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:bfeabe30b6a337dfd98368c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加一心向往“日本德比”，\n而大和赤骥一路跑来只为了获得三后冠。",
      "source_fingerprint": "30a53ac242568d949052f98dea3d8f8697599d43f15d490fdd524614edc20ee3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008401.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:bfa6a1a4df25bc0287fb601a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但受到挑衅的伏特加决定参加“郁金香赏”。\n原本以不同路线为目标的两位劲敌，却将在\n意料之外的赛事上对决，这就是宿命吗？",
      "source_fingerprint": "e2798011cb54cc8148a04426f8a20ad5e54043c8731cf0c4aed2c869426601f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008401.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:15952dae5d5de33aa08cb60f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每当她们想认真讨论，最后总是\n会发展成互相叫骂。直到比赛举办当天，\n每天都过着这种吵吵闹闹的生活。",
      "source_fingerprint": "36c2977ee1418c5619c3f24acd057924ba362894c6e4edfe039e4f7119cfb545",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008401.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:699165d91622dfb7c9ecaab6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "开战的十字路口",
      "source_fingerprint": "aeb5d536e3189fb66cf1e9e948445e4b9219801ca3ed9f07542e67263ce5316c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008401.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:9e709f3b92927ef448575fd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从“樱花赏”前进“日本德比”……\n伏特加一直烦恼着\n是否要做出这种史无前例的挑战。",
      "source_fingerprint": "2f3f252e69ddcc11e2159dc24cd0091719a0690ff378c2834ca94bc0abd814aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:d4979fa8a7cfd81ce3b7bfff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加虽然向经历过“日本德比”的\n成田白仁请教……却只得到一句建议。\n她要伏特加遵循本能向前奔驰。",
      "source_fingerprint": "0e7f93d2ffe9e674dcdbc118ca8b3ecb1a96a7c200d0cf7bd02d29bde3dd66d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c44d9d237801e7b8299c68e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这句话让伏特加再度检视自己……\n她发现就算鲁莽，也要无所顾忌地持续追寻，\n才是自己的风格。",
      "source_fingerprint": "28140db9c514a36553d09de959a4ef5266e4f98b6299602347043c697fe0f72e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:52815f6980bbb5034e3ebfe0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是……为了贯彻自我，\n她选择不参加能与宿敌对决的“橡树大赛”，\n而是决定出赛“日本德比”。",
      "source_fingerprint": "5415ba421b04a61fee5dca96231cdecc29bb1d2196c4a940bb635615d17ee232",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:3c466671132f86fc3c4e1c1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "梦想的交叉点",
      "source_fingerprint": "42063b8936e533f289e6e7fa792a25783628203ba46c560557efbc49aae6471e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:7d1faf80accea0b61815cf0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天是出发前往外国的日子。\n但即将出发时，\n想耍帅却失败的伏特加扭伤了脚。",
      "source_fingerprint": "393b55765fc1ce764ac22c41e586af533a6fdcf412ec49dc7d341f289df7da66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:2f57ee4f35ba31e219a345ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "国外远征计划破灭，\n大和赤骥对伏特加十分傻眼。",
      "source_fingerprint": "dc7419cb3e1611aad563b68665a0e1450607419f0c66cad27fb1054bea65bfe4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:ddb7bac31b362a806a5548ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥坦率地对伏特加说出，\n她是因为看了“日本德比”一战，\n心中才会燃起竞争意识。",
      "source_fingerprint": "e85f19f5b108204b939bade2e167983d7f9fd3bbe2f359dcaa1f44d6e1dfdcf4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:3211ddd88109428f61417625",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加为了跟她对决，\n以及在国内东山再起……经过几天静养，\n她决定挑战“秋华赏”以回应劲敌。",
      "source_fingerprint": "600241c056e1698c518e7a8bf716bf4ee7c56f6df794cd3f8cc11327a911182c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:50537b937e906b029e3bc0da",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天晴地滑",
      "source_fingerprint": "f41c10ab38662429ecf83d144313a2f92d8f9e05221c7974a1ee6f46c25ffb08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:4c2e20ffe2656d69fb575261",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加开始寻找自己该追寻的目标，\n已经一阵子了。",
      "source_fingerprint": "d5d3f347421f57908df7106972375a1ea8551cd4062b8cb77426091c3f9a2dba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:86c3d25032ada0c535870db3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她跟大和赤骥不一样，\n比起脚踏实地努力，\n伏特加容易被眼前的华丽事物吸引。",
      "source_fingerprint": "fa433e8aa4ccb5e9b3dcedf48c12f08947fd7093e5cdbefad829035e87fcb54d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:6d306f375894e837cc973a0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加很烦恼，她不确定\n自己这种孩子气的心态\n是否足以跟强敌们对抗。",
      "source_fingerprint": "3333b13398efe26190b68a3eb009b54a2c5e3cc8968f79dce131c17a25fc3908",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1ad4503c547bf0bb21adce83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员告诉烦恼的伏特加，\n她应该继续坚持自己的“帅气之处”，\n鼓励伏特加继续前进。",
      "source_fingerprint": "a357ff314013532871b49b3d63fe973510472e8797862bdfed5e71c2ce236b8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:dfe3bd8e91553bd7516fcaff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "再度偏离常轨",
      "source_fingerprint": "4d4c955b6d2d816a48ab8f7e33c50cb40d39be1dfe2cb5dc0c5405d7f2e13009",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:fad06e065ec8cdd9d112b87a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“天皇赏（秋）”即将到来前的某一天。\n伏特加与大和赤骥在天文馆道出彼此的心声。",
      "source_fingerprint": "115525b0d26de9393bc15c95e6a793a67ad0e992e06f9fc654ec912a34e60e42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0d3a4c9bf5e210ba10156316",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥脚踏实地前进，\n准确地将星座连成“线”。",
      "source_fingerprint": "1d1ac5e39c8c472e34e84d9a7f482bf8ac229104e93f738cc7914339ee74e50e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008405.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:46049ab0863934124155e138",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "反之，伏特加则是以超乎常识的经验，\n将“点”连成专属于自己的星座。",
      "source_fingerprint": "1a90b3d712bfd89c7c88dd1b3a03c20d82adac2b989b71db47d2f946b9280462",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008405.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:9c2f41b5236272e14d30ecfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这两个完全相反的星座，\n即将在大舞台上激荡出火花。",
      "source_fingerprint": "568b153703c93ce85875b74fb635a1f92c6df129ab6ed363ed3bd85001c7ac80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008405.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:dbac498b3a9bfd07603f4f38",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "星尘的巨星之路",
      "source_fingerprint": "71ef24cd843c57e5c4ece7867479cd5268a30632e2b19795b1e36ebfee4b1a1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008405.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:c0a564b81c84e372709471d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“夏季集训”开始了。其他学生都干劲满满，\n只有伏特加说着\n“我才不想去什么集训──”而打算翘掉。",
      "source_fingerprint": "f5f59b03303d5c25491c16e9a86274cef92e6bcc515e621e1a71d30cc4b2bddc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008406.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:bd3679bd80ae7c2cce63b690",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她遭父亲说教后，\n虽然超过集合时间才到，\n还是搭上了前往集训宿舍的巴士。",
      "source_fingerprint": "8c5fb51db48914203c35025af4887211017b31cdf21d8116a8481e7d993f419e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008406.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:d4ce5c0aa120e31d4a3e489a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了跟“伙伴”共创夏日回忆，\n伏特加的热血集训拉开序幕！",
      "source_fingerprint": "a9cb9943bd6130940bf7dfba6d2bddc9681005db3130034023d38eae48a05d02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008406.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:2c12375bc11f0ef957d75eed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第2年）开始！",
      "source_fingerprint": "225375376c5fdf8404800f01bfae8c6ed9a9204cddd553a5978ed5b2c0cbe9a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008406.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:f9b550547fe293e5b3e147b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "又到了集训的季节。\n伏特加一如往常地偏离常规，\n骑着摩托车比巴士还快到达集训宿舍。",
      "source_fingerprint": "150e26697a672ffa2608361be2c7af5539c07f1157ad59890305805676910222",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008407.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:35120c1e623309f157dcd39f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但实际上那是她父亲的摩托车。\n她为了展现自己帅气之处，\n请父亲骑车载她到集训宿舍。",
      "source_fingerprint": "c4fbc945c501f50769cc96ba43f243bc47552c18f07f8402bddcbdb5d66e5034",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008407.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:6d062d7a8f174c616e6ad483",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我与如此爱逞强的她，\n又再次开始夏季集训了！",
      "source_fingerprint": "80e0e27f7faa847e56c7ade113ca1396fb68ecab546c30aaeda349ce81bdf87c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008407.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d6b6df7418aa3ec6e50b05b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第3年）开始！",
      "source_fingerprint": "2018daecd587b3acd573214a2b2c9e4607f1262610f0ce7cb9324e673d98a91d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008407.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:3b6580fcecc996273e7b1a29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“出道战”即将开跑，伏特加热血沸腾。\n但看到同期们都毫无紧张感，\n她不禁因不符想像而感到失望。",
      "source_fingerprint": "5ba9ed4b64356f734c0df5b46b89dde241852b20bd657602bc20419814139d87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008408.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:de8fd0675d0e5872658ac4b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，要是输给这些一派悠闲的同期，\n就会变成“逊毙了”的赛马娘。",
      "source_fingerprint": "d89e31f3666e4258329249a0d0c5ad543b1bfecf7c08e2aa6f2209d04404e4d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008408.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:02f6f4ad46d335228ac28b4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不让自己的出道战变成一场半吊子比赛，\n伏特加铆足干劲踏入赛场。",
      "source_fingerprint": "4b28ad611f278043200489bbc6ede1b2c0fe16fa7474eb21a00fcbd8e1fc63a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008408.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:01d79c3a9bf650819776ed41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向出道战",
      "source_fingerprint": "4ea754365577b70c3247fb413fa7b90388e1e4a185a1da5f6c50ef25fe13c496",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008408.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:4a822c3daeb3ab5593081cec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "强者云集的“阪神JF”当天。伏特加\n被实力明显远超过自己的赛马娘们包围，\n气势不禁败下阵来。",
      "source_fingerprint": "8e1c303957cd2ef3c73930f0aa4df68b33620c45228c3bcde2b361adfe113e71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1008/storytimeline_501008409.json",
