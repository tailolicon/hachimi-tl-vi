    },
    {
      "uid": "zhcn:3f20a2833e1e89548286b13d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错──我很帅气！\n我成功当上最帅气的赛马娘了──！",
      "source_fingerprint": "e5bdd4e88101e53f5f299da7d1bd787a0ecace2a9194c3ac793fd07de008c34d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
