    {
      "uid": "zhcn:1ae5fe9f806c49023ac2a80f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥虽然落败，但她仍不气馁地宣告\n会更加磨练自己的武器，打败伏特加。",
      "source_fingerprint": "da8f7dc0c0da1d36bda1a83707c95775353a56e7be1c0d21ce1842edbf1e969a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
