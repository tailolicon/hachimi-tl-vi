      "source_language": "zh-CN",
      "source_text": "郁金香赏结束后・先制胜利！",
      "source_fingerprint": "f13fffa9b5c992543826ccb3d67698de0894c109f99dd0c8ce4c2c39d723fab5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
