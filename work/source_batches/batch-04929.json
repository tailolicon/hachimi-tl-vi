      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一般来说，不会有人走上后冠路线后，\n又中途变更路线……",
      "source_fingerprint": "49d8f84dcd27ec26214189a3fa00d12ccb866eb5c7b6afb1f0de20285dc083d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
