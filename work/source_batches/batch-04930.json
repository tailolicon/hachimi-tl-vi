      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:c332c6d9ae7427ffe62b5d0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加决定，到比赛之前要利用这段时间……\n好好摸索自己该追寻的目标。",
      "source_fingerprint": "8853accd2a354236e16e234623510b5ff5bd9ce94ffa8e4071fd6d1155f27e4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
