      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e4c5f2a821a773cc158e3201",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员建议她参加\n能以速度正面对决的英里竞赛──\n“维多利亚英里赛”。",
      "source_fingerprint": "e80cec20d8b2b459dcb0fba6c4590d4eba9a0045bda3c2d3776a4b7fc4e48902",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
