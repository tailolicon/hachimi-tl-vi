    },
    {
      "uid": "zhcn:363e4498c4870e35b92e2f77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着，我在她的强势主导下，\n享受了一段久违的假期……",
      "source_fingerprint": "cb9a3bdb51c8032bd9fa122fd25a8711fa335903456a1ddce73212d304021e77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
