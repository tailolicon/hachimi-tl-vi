      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:0374b3164adbdae68770e6ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──不用说，后来回到工作岗位时，\n我们已经彻底恢复精神。\n……当然，是两人一起努力。",
      "source_fingerprint": "17e89f347f3a4d260f95cfbe83f0efdb8b66d5757c2666fbf68b5bb4229b25bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
