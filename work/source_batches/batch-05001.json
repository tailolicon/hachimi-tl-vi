      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e3f479cb37a53aebbebc8763",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥终于要参加“出道战”──",
      "source_fingerprint": "78b888a29d235e0a33a09acd49e30368078b11c8285165b137879f6f793af3e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009401.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:fddc1e66155a5b7933b5b7c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她立下誓言要有精彩的出道表现，\n让所有人都想追着她的背影前进。",
      "source_fingerprint": "bd0b87f18e599cc3106b1e69fb4cc1e9790a25d37f0fb1a63a6acfc93a0c75ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009401.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:6d70b418316b53e6d1aa264e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向出道战",
      "source_fingerprint": "4ea754365577b70c3247fb413fa7b90388e1e4a185a1da5f6c50ef25fe13c496",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009401.json",
      "json_path": [
        "title"
