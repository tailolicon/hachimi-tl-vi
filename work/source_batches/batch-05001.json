    },
    {
      "uid": "zhcn:8db283ab8fc996c56e4ade99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥在“郁金香赏”拿下“第一”──",
      "source_fingerprint": "f0a7c1adee0a19ac1a79b1ba69a17de40a73319f38dd9b247651c054a2b9460b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:3bb0b1c781cc91a7d8cc00dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009405.json",
      "json_path": [
        "text_block_list",
