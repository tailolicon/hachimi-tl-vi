      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:862e52b5520ac484f73df631",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以“第一赛马娘”为目标迈进──\n我与大和赤骥相处的日子就此开始！",
      "source_fingerprint": "e809d38c28df4ffc225c6e426af9b851697d3f13bd9a9b635543433d117f9238",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009400.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:d75092b1e0fbdcc1e87a83d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥登场！",
      "source_fingerprint": "cf775432039fe90d9928d1a90ba3035ae62e2fd3fc419171852541a9c8aa5375",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
