        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:469781a14344cada3bbfc80f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在“未来的皇后们”特辑中被列为第二，\n让大和赤骥心有不甘──",
      "source_fingerprint": "05c967dd44ead388bb6d7f24a050a2ecf02114069c2f4f4cd407de673a4f28c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:7f2c4c768c0a9d64439aa9c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她因此发誓，\n要在经典级的首战风光拿下第一。",
      "source_fingerprint": "b1bdc61e6f01a68ead30ad70f9cbeda0d01ec8bc80f547371f3cadf5705053d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:baf5b5ced9a0dbd7ddc7f632",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一只能有一个人",
      "source_fingerprint": "1b74f103beac6d1ce0bccdb70c128fbaecbfaa5b5ecb161e1ec4c3379bcd793b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:eed786e244b1b52fceef832b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥面对“郁金香赏”干劲十足。",
      "source_fingerprint": "be599bf08d01dd068640e0453774c16b170d4e7ba42096e1ea83778a97107ba9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:f9005272940ef240164cbad5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽管得知劲敌伏特加也要参赛，\n让她有点惊讶──",
      "source_fingerprint": "882ce80f53a1833cf0b60be3ab5e0ebc50fb9f55cdf0f1fa54d356132d287032",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:70d277196a4e0497a8b2c418",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她表示要赢过伏特加，\n证明自己才是“第一”。",
      "source_fingerprint": "f183f84a75327a55a5fe4416b7e1858dbe1978d07bedd37a99d7e050caf63688",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009404.json",
      "json_path": [
