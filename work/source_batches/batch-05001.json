      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………唔！",
      "source_fingerprint": "4b492d0be52954575302163669dd455ebbbf4d0a85120d85d6bd8eb0a471f07a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
