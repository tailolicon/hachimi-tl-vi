      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向郁金香赏",
      "source_fingerprint": "7f7a6fcc98e788585d8ba8be1499fb8bfe9bce5605f8f1b2a8f21111698224bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009404.json",
      "json_path": [
        "title"
      ],
