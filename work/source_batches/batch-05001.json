    {
      "uid": "zhcn:e27c76270dcd9949f334bc0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着大和赤骥便哭了出来。",
      "source_fingerprint": "48664b380b20960d3c479f577a6e9342abd3df1ddde52f41c6555f43135d4432",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009322.json",
      "json_path": [
        "text_block_list",
