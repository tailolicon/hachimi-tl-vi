        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:e71db67fc1740f52a579c99d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气势如虹的她表示，\n接下来的“樱花赏”也会夺得“第一”。",
      "source_fingerprint": "a9c6b4a08036a3a16322e26b06fbf0a47fbd3824853cfa30b98e67977311b49a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009405.json",
