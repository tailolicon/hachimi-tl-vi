      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:441646c73e9c4642974d5224",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在只有竞赛获得第一名的赛马娘\n才得以进入的优胜者区域中。\n在源源不绝的祝福声下。",
      "source_fingerprint": "8e47155cc5f0cc71b81446c4406ef708bbdfdce3cc62207097dc394506f96375",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009322.json",
      "json_path": [
