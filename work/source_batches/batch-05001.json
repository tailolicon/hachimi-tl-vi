      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:6ddd4e8d0b84a4c11a4d88b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她终于成为“第一的赛马娘”。",
      "source_fingerprint": "f4eba83ce73ae3c712390358b50c292ac21ac59bf2f2999f89892ddbf0ec2d3d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009322.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:513627657d3417e2f1c234c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・“第一”的赛马娘！",
      "source_fingerprint": "ee4e18e30bd7ff0c7ffa818afa5e7fb6b3a76ff93ad6e8696927c13dc4390bb8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009322.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:cf39f6af782af590571232d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天开始，终于要和大和赤骥正式展开训练。",
      "source_fingerprint": "8c38276d8650505c759a2b59475263224a93d765d080a90a892e959c5fc22379",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
