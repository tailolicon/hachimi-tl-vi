      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不再让伏特加夺得先机，\n大和赤骥表示要再一次跑赢她。",
      "source_fingerprint": "244873368d8e8db3687acc199cf305700462728d897edf3c662dc705b41b5472",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
