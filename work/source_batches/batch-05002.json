      "uid": "zhcn:b233e91a9e0fc81e055c7a79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个目标是“秋华赏”，\n三后冠的最后一场赛事。",
      "source_fingerprint": "58f786bff2e47743fa8347b5f6d6ed1365a0769804649681d3dafff1d67cf2bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009415.json",
