      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥在“日本德比”\n成功赢过了伏特加──",
      "source_fingerprint": "fe7eee7169ca527eb7bec19f640e94a085b86d16456a10ad663c25ab08e11b70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
