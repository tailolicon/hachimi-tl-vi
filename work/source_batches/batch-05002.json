    },
    {
      "uid": "zhcn:cf2bdaa5b2894f8fc5caedc9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她脑中尽是伏特加气势逼人的奔驰模样，\n以及她成为“第一”的情景。",
      "source_fingerprint": "fbaa43adb3a55a2f54055a28bf563a0e766c8c20baf099bdb90ed50467587a68",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009415.json",
      "json_path": [
