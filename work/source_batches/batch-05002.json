    {
      "uid": "zhcn:8f0a8b4347e68fbf489e0ea8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了在“橡树大赛”获得“第一”，\n开始努力投身训练。",
      "source_fingerprint": "9403f724b2dfa2cb3ad898dc51ec08f230c41615cb8e643a6b1903047f65617b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009411.json",
