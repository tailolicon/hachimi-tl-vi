    },
    {
      "uid": "zhcn:d7152548447552e03a95c1bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向日本德比",
      "source_fingerprint": "e4074326c9093437fbf37c8e5b00d67df67963c2eed1109506df4b11f06953bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
