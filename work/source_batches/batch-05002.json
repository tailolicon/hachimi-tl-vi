      "source_language": "zh-CN",
      "source_text": "大和赤骥在“樱花赏”没能获胜，\n还输给了伏特加──",
      "source_fingerprint": "d4963f193d2e09e297a218b352dd931ca142f3264c551e100675ee68845f08a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
