      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:1a78ed3da5af4666326b4bdc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯结束后・迎向“第一”",
      "source_fingerprint": "b5ec7fd51d5c0d6789018c08597bc33eaf5d3f498c1705d3e822e040780a1bfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009430.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e7c0c4d38c41a5eedd5debc4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今年又来到“夏季集训”的时期。",
      "source_fingerprint": "135a64f0b089bcdf1ac41e746739906bc4f3f6aada824627f63b551a069e0f24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009431.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:7b6aa9f51338940efccb0022",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥听说劲敌伏特加\n也会参加这次的集训──",
      "source_fingerprint": "d2dffff0604ef94a96a62334d5610ee4e077989e0e36b40e04070681fb019b75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009431.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:59491b95e2bacd6cf77ed0b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下定决心要在这个夏天累积实力，\n并在“天皇赏（秋）”成为“第一”。",
      "source_fingerprint": "2f92246966e49adb38933f4adb7aea343fa5092525baa961f8fc1ce68fc02bf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009431.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:4cdf73205c16cdc284b68f4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第3年）开始！",
      "source_fingerprint": "2018daecd587b3acd573214a2b2c9e4607f1262610f0ce7cb9324e673d98a91d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009431.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:919a2bc6e5b1f6829532d7fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于迎来“天皇赏（秋）”。\n比赛开始之前──",
      "source_fingerprint": "9463bbb2e27409ca88a6d95455d5baffb5491056a705329547a795e4c68c3ca3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009432.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:c0a599a3670a79bb1375b546",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "互为劲敌的两人不再像以往剑拔弩张，\n而是平静地表示自己将会获得胜利。",
      "source_fingerprint": "6d28a743a9e8b06f05c5fa77a3471e79fe05dd2146340394e41010e635976115",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009432.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:90eb799c1ec3b9ad83d0cda3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向天皇赏（秋）",
      "source_fingerprint": "acd583fd839f6680a57f75e09880ff12f48e50ac7beeab6d01036df8eff7ff5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009432.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:dbdf320057d3fd49d5a3ae92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥在“天皇赏（秋）”\n这个重要舞台获得胜利──",
      "source_fingerprint": "bd014ddd22db97a6a945a6c169246cf9c396a94024f48e4b8b7bd6a7218ae0f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009433.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6c681fbe8998d9decd39aaed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她发现自己期望的“第一”，\n是指能持续留存在大家记忆中的赛马娘。",
      "source_fingerprint": "3ff5b95ba48e14fea9c6e6fb6ca922290332628b72b72b956781fdbf7a7c758d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009433.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:fdf57cd28fabec537118c04d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个目标是“有马纪念”。\n大和赤骥意念坚定，\n誓言在那里也要成为“第一”的赛马娘。",
      "source_fingerprint": "256793fab092151c4d11ef69df7ef5811c9b47ef4fd1f541aebb056ec775bd25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009433.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:eea4a9026058ff76b585a66b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・一如往常的两人",
      "source_fingerprint": "6a3a13e1a78f279292d7c24f1343e720d7a2bbefd27c1a26f185d3e50a34f00b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009433.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:562c0e2b4b6f9507463bf6e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大和赤骥向出国在即的伏特加\n坦承自己真正的想法──",
      "source_fingerprint": "685cb5b2525e062009505f8d2445bff4b07f976a19c24166f3e3198731cb64ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009434.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0697562b44ccd0a39335b425",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在“有马纪念”的记者会上，\n她像是一扫迷惘般自信地说出自己的目标。",
      "source_fingerprint": "5ea5ec55007b81c5ea3ba86167962c2d7ac44b21b2264e827bfd3ddd9c32d750",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1009/storytimeline_501009434.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:4475f69ab9e7738d23636134",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身为第一劲敌",
