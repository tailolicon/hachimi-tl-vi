      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──伏特加亲眼见证到她的表现，\n也默默地认可了她的实力。",
      "source_fingerprint": "6a4912fe9bd7373ad5c424f79a497869e82a21237c5fb25029d14d50734be723",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
