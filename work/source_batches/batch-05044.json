      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使如此，\n她也不可能挡下无声铃鹿的气势。",
      "source_fingerprint": "c9d9ce84e5e1a92b611d354e4ed617cdfc2be1f4571d72911ef1b2c8a6926ca9",
