      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在GⅠ竞赛碰上她，\n是个相当大的威胁……",
      "source_fingerprint": "279ab9cf9c54b74c12325cf5d26ad90c342b16048c89943ccb1c214de7e2598e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
