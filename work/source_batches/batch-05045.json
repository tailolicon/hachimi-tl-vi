      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，假如大树快车能够赢过这样的她──",
      "source_fingerprint": "554dc9b1e787cc1b85d3787375e6c1bfaea94400c6c2a43ba06b146148a455c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
