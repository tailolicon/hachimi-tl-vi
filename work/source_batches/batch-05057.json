    },
    {
      "uid": "zhcn:cb81899ff9de225b3b3f0d49",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从香港回来后，她的比赛表现都好惊人！\n根本是great of great的赛马娘！",
      "source_fingerprint": "db351d260d72e8b36d1f63e821115f067609f82ab032e031547826c4ecdaf5e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010315.json",
      "json_path": [
