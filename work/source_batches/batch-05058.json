    },
    {
      "uid": "zhcn:ee66b5a2817195b9daf7cbf9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・最大的魅力",
      "source_fingerprint": "c9a3c8ae00256364bf1e16120f9ec2f46a8b82c33b9b39e05a1936fcdd70be62",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
