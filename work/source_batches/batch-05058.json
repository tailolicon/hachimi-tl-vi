    },
    {
      "uid": "zhcn:666d3eb9c8df482b0ef55306",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是两人决定参加冬季英里赛\n“神赞纪念”！",
      "source_fingerprint": "614052f954667b93094283c096e9547f0ca2f994a95187fd1eedecc13918e5f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010416.json",
      "json_path": [
