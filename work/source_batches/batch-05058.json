        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:f5a430b5565cd10b602e675e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要在这场比赛赢过无声铃鹿，\n就代表在短距离GⅠ竞赛中获得连胜。\n而且还有可能成为“年度代表赛马娘”。",
      "source_fingerprint": "d1dc8b9bf3e1d86bbd3a9fc06220210073193e62707102f9accd60c85aba85f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010415.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
