      "uid": "zhcn:2b0968d5d9aa1f145e45ff13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定春季英里王的“安田纪念”当天，\n很不巧地下着大雨。",
      "source_fingerprint": "7c50e0089f5447854df7bb9802bf58726fd0a48e47cc477802fc2c46d001fb03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010413.json",
      "json_path": [
        "text_block_list",
