      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此便报名参加“NHK英里杯”\n以角逐新马级英里王的名号。",
      "source_fingerprint": "63d2d54b2e536d3fb74c3bfa9a523be2e29c311052cd74c78f94610bfef6e1bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010417.json",
      "json_path": [
