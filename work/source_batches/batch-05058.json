    },
    {
      "uid": "zhcn:4f1fc1730865484f746548e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被许多观众投以期待，\n大树快车发愤要赢得这场比赛。",
      "source_fingerprint": "b2a4884342fba212ff6608d9903d43657365551b5352f93562c8e8f6c300cfcb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
