      "source_language": "zh-CN",
      "source_text": "迎向安田纪念",
      "source_fingerprint": "40faa17dcdcc78010dfdb54e170136a09461b2a4f83f216658d669031f8da30e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
