      "source_language": "zh-CN",
      "source_text": "终点前有坡道严阵以待的中山赛场，\n十分适合大树快车发挥其自身特色！",
      "source_fingerprint": "7cd30584217e6f6d3f01656ffec52977828205fc604f45c5f4563a921bb9a8d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
