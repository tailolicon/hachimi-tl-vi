        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a3ead4389897896902c6a61e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向英里CS",
      "source_fingerprint": "9e000cb39e6ad6cc7160191f317779c075bdf528f3b0231716cd4759668b4bb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010415.json",
