    },
    {
      "uid": "zhcn:0c8c8aba00994c67bc7cc1a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了成就自己的梦想……\n大树快车决定勇往直前！",
      "source_fingerprint": "3a8a57b0a5fbf84f27b860acc6ed1e982f32dccaede20d46fb79d8e38dc38008",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
