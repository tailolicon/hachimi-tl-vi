      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向英里CS",
      "source_fingerprint": "9e000cb39e6ad6cc7160191f317779c075bdf528f3b0231716cd4759668b4bb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
