      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:ff1bdc0a8f3a3b3d0e99c7de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大树快车想像着赛后派对的情形，\n开心地出赛了。",
      "source_fingerprint": "c100995678b87fead7df6d1a7aee34612273b2c8a330065d9634b22b66059bb2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
