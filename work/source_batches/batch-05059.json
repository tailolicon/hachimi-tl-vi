    {
      "uid": "zhcn:4a084a2071e2f007229e78a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿，觉醒①",
      "source_fingerprint": "ca55546d7c45749dff55fd433a9495633db6a8299cd9541bcb8d24b73fd59597",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010425.json",
