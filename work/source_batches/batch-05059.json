    },
    {
      "uid": "zhcn:7feb063dddb2ac37b38d31f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她的心意让我很感激，\n不过我在心中发誓，得在被别人误会前\n教她学会使用正确的日语才行。",
      "source_fingerprint": "d460e35d185c8f2183c564c9a106b30d2f79f0ed89f858f9304e9fae942f9412",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010500.json",
