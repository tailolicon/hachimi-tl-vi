    },
    {
      "uid": "zhcn:dab6ba240c7998666bbfe246",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一前往赛道，\n大树快车便开开心心地过来找我。",
      "source_fingerprint": "5bf8e279ae05d9052e0939d4f63a736d6fd64bc450d3eaf7b9a807e7d5cac346",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
