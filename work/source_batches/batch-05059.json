      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e1696e88bc902808034d5217",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大树快车",
      "source_fingerprint": "4781b57651b31dcb9d23ee7dc5d8198d1f71c4e9f003322ae62804981e9c0e0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010500.json",
