      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:1911959e25b7b57f1905bc30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，请你听我说！\n又有人拜托我做并跑练习了！",
      "source_fingerprint": "451f5fc4c1bc60725f940da9ee191c8888559c1c09d27d7e50f32ae69b8d2d02",
