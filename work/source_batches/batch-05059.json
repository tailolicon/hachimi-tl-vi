      "source_path": "assets/story/data/50/1010/storytimeline_501010500.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:97795669009ab2b4e5c7a83b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大树快车",
