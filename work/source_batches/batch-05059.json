    },
    {
      "uid": "zhcn:87ac5a84f57865caae05583f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为这是我们一起创造的未来！\n如果你失约，我会把你BANG掉哦！",
      "source_fingerprint": "eb9d29c4cb4d49f62efc3f8f0e78c1ab4f0ea76910e0fdf531409b44cde850f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
