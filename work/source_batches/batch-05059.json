        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:2aec064dfc5e137dc87568dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "受乙名史记者之邀，\n大树快车前来观看宝冢纪念。",
      "source_fingerprint": "ee1e419e815061f1fe693992a3cce3ad35591267ca6432df5886f3f5b08c824e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010426.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:c821ba7ce08b06df6427a9a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这场比赛最引人注目的，\n是“年度代表赛马娘”气槽\n与最受欢迎的无声铃鹿之间的对决……",
      "source_fingerprint": "8b99a6ef976275dbdf3ecf93b5a584c2313593b263b033f63e368f8c0e921d71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010426.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:bff2af928178878d9f522a7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后是由无声铃鹿以精湛的领放跑法胜出！\n她又跑出了一场令人“印象深刻”的比赛。",
      "source_fingerprint": "3c2a2d4612b31953da8d0bf0202633933c4b1872b1c1cab44f12e217279518a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010426.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:813b66234daad98bacf66bff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿，觉醒②",
      "source_fingerprint": "a19e5793d1567e1bf702e0be9ad1bd89fca81dec1e43df243b51e52fc4640db2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010426.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:40de644ce96b33eba73814e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "受到了草上飞、神鹰、\n以及无声铃鹿参赛的影响──\n东京赛场热闹非凡。",
      "source_fingerprint": "83f827054e79c6fdd4799a85bf11af160cb6403204afabfccb1bf9f1554089f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010427.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:aa7bdb8bdee672ed58d4de24",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这时，大树快车再度与乙名史记者\n前来观赏比赛。",
      "source_fingerprint": "18cbeb54449846337e906273ee5f1f64adc8e5345c10c0e2718cf035732f77fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010427.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:06d5c560fa1496c60ed18ecc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在众多粉丝关注下，无声铃鹿一开跑就采取\n领放策略，并在最后的直线进一步加速，\n最终以彻底领放的方式获胜了。",
      "source_fingerprint": "273ec9d806827987d89fa38c9fdc898851e75985aff988ff1a6cde57724d133b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010427.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d379b81f647ff79db4d00705",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只有她才办得到的独特跑法，\n让观众都感到“印象深刻”。",
      "source_fingerprint": "ca02ce5fb41ffe49840eacd9ac63915eaf0f19ea6b5bd5f85e5d45aa1ae1899f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010427.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a80d3994fc9f7b3cbd2417c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿，觉醒③",
      "source_fingerprint": "a474bc4607032993715352aef9a043bc71dc5cb207289c5e470e37cd54fff65b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010427.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:91d14ef2cf55fe8624883a4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "十月的赛场上，超人气赛马娘疾驰的身影，\n让包含大树快车在内的观众们都为之疯狂。",
      "source_fingerprint": "2ccc4c20d17f3f6441eedf7cbccf0b1b0d8de5fe9aed69b9fcbd72f8bffc2164",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010428.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:9b8ac28120486b7ad05fc9be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“异次元逃亡者”……无声铃鹿。\n她在这场竞赛中，依然使用大胆的\n“领放”策略拿下了胜利！",
      "source_fingerprint": "7a0c6a91eeedbb478fa2a8b6d1fcbcb7b54757807fca26463e96d6a8cb3a7e48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010428.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e465b50bc5386a0d000b183e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑法令人“印象深刻”的无声铃鹿，\n在优胜者区域里接受众人赞扬她的胜利。",
      "source_fingerprint": "85b4c9cebfb830297aebb1961118d8d8484053548e70914f5396f1dff6075633",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1010/storytimeline_501010428.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:cce6d02206f040eb446b265c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿，觉醒④",
      "source_fingerprint": "78bf10d4ae0fed972e93235de84fcd6d5de048a6050993820f8312f5d145f5ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
