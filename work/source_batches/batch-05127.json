    {
      "uid": "zhcn:7dae25ddfd61eeefee190e36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "草上飞在比赛留下了\n优异的成果。",
      "source_fingerprint": "d25ad85a92351161e06ab0e0648b85790d84c8e50fa7024d6eaa3f344e333e48",
