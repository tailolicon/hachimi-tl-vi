      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "草上飞出言安慰，\n并且谢谢她拿出真本事与自己较量。",
      "source_fingerprint": "3060a6acb02caf39bb8e5ccf54ecd9ad5df99baf6fd61ea64d2134ba244470a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
