      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "全力以赴却输了比赛的特别周\n最后忍不住掉下眼泪。",
      "source_fingerprint": "615c0f1f9350696be877d8eaab31e57c101e94ba8261e59d885e430f18c94960",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
