      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是，她心中仍然抱有\n无法与丸善斯基比赛的遗憾。",
      "source_fingerprint": "383b942f86a3e718e428dbb179a78a59ace7ea88ec84695fe7a4c9df043785d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
