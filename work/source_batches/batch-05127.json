    {
      "uid": "zhcn:d603a967d06e5bd543074bd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "草上飞在出道战中\n表现得令人印象深刻。",
      "source_fingerprint": "193eaca8b3b20196d1a00df526ecd231653ef20c25f59b538701b1726d1e2af1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1011/storytimeline_501011415.json",
