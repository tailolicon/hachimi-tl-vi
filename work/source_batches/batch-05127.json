      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很遗憾的，草上飞没有获得胜利。",
      "source_fingerprint": "3bd97ad0a34603153e3a0458aa751e70d4434645a03c17f13e212e2426ebb978",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
