        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:e5fdad06f7cc0bed2a7dbce9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "草上飞毫不退缩地\n接受了挑战。",
      "source_fingerprint": "c7561e99cade3ccf44d8a51b6ed10173b22cf71ee4a5502b5d4f571d3de1ad09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
