    },
    {
      "uid": "zhcn:5ae0dea247238794c955cc1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总觉得你有点浮躁，\n或者该说是摇摆不定……不，不对。",
      "source_fingerprint": "641cbe6aed9a7fb4a4be735abe6800208ef216cccb655a571ef502ea69d8e277",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
      "json_path": [
        "text_block_list",
