    {
      "uid": "zhcn:29d92a022eb7a9caec73b8e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你是感到不安吗？",
      "source_fingerprint": "4bd9a0090f49baa97fd78e58ce97c5aef3674fe14731561f6cd8f93df93dcdf2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
