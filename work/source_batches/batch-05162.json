      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:00f75e8ab3e8a797271653fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不、不是……！",
      "source_fingerprint": "d37ad7b010b6f0f03202d89f4294298ab19e403941e471f4cc9929d6df2322a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
