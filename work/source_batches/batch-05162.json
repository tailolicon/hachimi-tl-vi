        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:d8de6e62ed24c87029245b24",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她散发着不容分说的气势逼我坐在阴影处，\n然后模拟赛便开始了。",
      "source_fingerprint": "aa239b6370940293e6a3d604928a2fbe6e99c84f4c023e62ca618dfae37f056a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
