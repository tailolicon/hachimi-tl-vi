        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:c5911c1c44437fb3fee70136",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训也过了一半。\n菱亚马逊对“秋华赏”与“有马纪念”\n怀有热切的执着，每一天都会进行自主训练。",
      "source_fingerprint": "cfbaf25a0d07f25d583b729c4c9b2751a9b2ea2ee2c4788e6f82b8ca12543c6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:2e879ed6c23aa4b53bf2466e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不想干扰到她的训练。",
      "source_fingerprint": "0cef587b1ceef1a6d2685f97a63ee938b9b0fd16bf9554a2c459e969ea9b7fad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:e32734964df08b41366b3516",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是我转移话题，\n开始介绍昨天我从资料中摘录下来的，\n适合在沙滩进行的躯干训练。",
      "source_fingerprint": "9c4af116a401c402346e31f70103456491a7b15fd660fcc0d656967c93bc79b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:5256ddadb701b0f936085e0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……菱亚马逊？",
      "source_fingerprint": "ed4cc574205f8a13f5621f29564c4eef211e8830b1db9939c3c7ec20e367aac5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
