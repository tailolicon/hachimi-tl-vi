      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:021547824290342155f7e983",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟会长讨论后，\n决定送给优胜者一年份的高级乳清蛋白。",
      "source_fingerprint": "0ac3b062c279281fc02ffe6abd3a2aacc8c5d169821bfabd757637bab94e981c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:54c32c28148c8698813d9fc2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱亚马逊",
      "source_fingerprint": "9e46e1b1d0b91c1ce1fa11c6823587aa41504c815d8da191f269c6fd336b6c12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012104.json",
