    {
      "uid": "zhcn:07b102eb3c729c7fdc20295d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "仔细想想，现在这状况也很奇怪。\n你最近怎么每天都会介绍新的训练方式啊？",
      "source_fingerprint": "ee7c872fa6472e93412c19e431b69375ebe73679fd208ef6c42a69ac06b5a983",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
