    },
    {
      "uid": "zhcn:c6eb073adbb46c9278585c32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你先冷静点",
      "source_fingerprint": "3befbeda82fd39170d9b2ce0bdb859b8a0b8d6a579c334c80a9ae9d6e7cfc7a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
