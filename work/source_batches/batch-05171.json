    {
      "uid": "zhcn:a08e2bbb320ad2f6bd391938",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样的我\n连“菱亚马逊”都不是……！",
      "source_fingerprint": "d49aee2c66ad3eaba8f2556ece70c59aaecf17de66239d06ea42cc7f926e27da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012113.json",
      "json_path": [
        "text_block_list",
