    },
    {
      "uid": "zhcn:6c79ad97941c0eb71981de7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱亚马逊",
      "source_fingerprint": "9e46e1b1d0b91c1ce1fa11c6823587aa41504c815d8da191f269c6fd336b6c12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
