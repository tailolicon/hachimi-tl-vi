    },
    {
      "uid": "zhcn:4ce467d9e81d8f7b8203dbed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后我就知道了。",
      "source_fingerprint": "33e0f9fa69ad6c52702bf7c69f0a6ad75aeaeafb9652baba5659b0d887740453",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
