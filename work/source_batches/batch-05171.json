    },
    {
      "uid": "zhcn:b8845454bfdaa862aeeb50f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "操场上炽热无声，充满了激昂的情绪。\n在场所有观众大气都不敢多喘一口。",
      "source_fingerprint": "89d62c83af48512648ce98298aea63b37fdf96aae68006eedf47b2d2832e6a7d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012113.json",
      "json_path": [
        "text_block_list",
        50,
