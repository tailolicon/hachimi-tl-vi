    {
      "uid": "zhcn:53c9eaf489138c7aca98b274",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，\n我想那时她吐露的心声并没有虚假。",
      "source_fingerprint": "1c157eb31afc7639a399f60e4e21e45e7208d3223e468882b2a87b01672330ed",
