    {
      "uid": "zhcn:1d600eea767261e6787a28b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也、也是，而且有很多赛马娘\n受伤之后还能回到赛场……！",
      "source_fingerprint": "6bff42f41ca1d88f8b69327e29dc768c9825ea8014ed7ab8d1181143dfa14675",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
