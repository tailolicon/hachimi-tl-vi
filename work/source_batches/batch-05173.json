      ],
      "json_pointer": "/text_block_list/9/choice_data_list/0"
    },
    {
      "uid": "zhcn:25e84ccedb531da81922bc84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她现在非常卖力地，\n想要成为强劲又崇高的“菱亚马逊”。",
      "source_fingerprint": "f2eb0286fa5b28c880c6839c88922698397cf147eb24b71b1272f7d447592f9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012114.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:6410bd017a989d7d6c21895b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的对决，你的对决",
      "source_fingerprint": "c64d1169de7228ff57868c04595fac8070c760e843ee81471b2d3c2bdda71297",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012114.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:2f5b82a32027546285e03b28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我们正为了即将到来的GⅠ竞赛，\n以及对成田白仁的复仇战\n努力练习的某一天。",
      "source_fingerprint": "c180ecc860ef42ec7e99ac09a24375e2ade3d6daa4bf890723fdca411024b5f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
