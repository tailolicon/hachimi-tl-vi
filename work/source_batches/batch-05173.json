    {
      "uid": "zhcn:554d185f5ca3367b3177504c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我现在能为她做的事情……）",
      "source_fingerprint": "1e41a6054e51b44a00d667145d33dd350cf68c2fad991319ae860df38f5a00f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
