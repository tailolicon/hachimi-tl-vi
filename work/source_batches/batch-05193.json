    },
    {
      "uid": "zhcn:9bdee719f2278040f0bce075",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想超越的背影",
      "source_fingerprint": "3aa59ce7ffca995bf75a7475526b970aa97937d36f4c05376c7c959b30913fe5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012403.json",
      "json_path": [
        "title"
