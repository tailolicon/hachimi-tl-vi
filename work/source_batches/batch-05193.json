    },
    {
      "uid": "zhcn:72178b1e6be0c0baff1cfa58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁似乎接受了这个回答。\n因为在她的心里，\n始终也有个想要超越的背影……",
      "source_fingerprint": "57230bae5621e25f247129c86388152ee1d815133a1cf1c5dde5cdabc736b7a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
