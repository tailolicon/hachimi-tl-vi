    },
    {
      "uid": "zhcn:375a3d83c2c5e990fa1b202a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱亚马逊感受到训练员的真诚，\n身为他的伙伴更加寄予深厚信赖。\n“樱花赏”，就在眼前──",
      "source_fingerprint": "2512c52b16a49334a087ba5ab312d2bfa73a996f3e0b3b94d4b0019b2414f67a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:b99bd2959fed8c3740bd489d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的对决，你的对决",
      "source_fingerprint": "c64d1169de7228ff57868c04595fac8070c760e843ee81471b2d3c2bdda71297",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1012/storytimeline_501012402.json",
      "json_path": [
