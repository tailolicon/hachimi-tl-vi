      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以我想要支持她。\n希望能够让她实现愿望。",
      "source_fingerprint": "b00f64234074d5a2845a3ffc861062337a1facd38776e99d2a27184014718b86",
