      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔，不错耶！\n你的舞步变流畅了。",
      "source_fingerprint": "9d79c732a16b3a9cc4f8a9799f007116df7a989865ef8e989e41c97ea83ab577",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
