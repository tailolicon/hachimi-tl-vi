      "source_language": "zh-CN",
      "source_text": "先牵起彼此的手，\n然后把手放在我的肩膀上。",
      "source_fingerprint": "ca01a45b77da9a282d466933d8c9a2d22b6b340aebbc6da81d2ed8d2edc89fef",
