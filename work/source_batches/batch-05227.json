      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我开始能够配合她的动作，\n让她自由地跳舞。",
      "source_fingerprint": "a8d0ffc8a596e2322abcba09a0dd85d8b429b18e35b3238f9e4ef3c54592dafe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
