    },
    {
      "uid": "zhcn:59f09d19e5b5dd36626b657b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“宝冢纪念”的气氛\n比“菊花赏”时还要热烈。",
      "source_fingerprint": "823aa5915659404d1baf514f15f34fb53391daf4fb94178f15c36a50977d8deb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
