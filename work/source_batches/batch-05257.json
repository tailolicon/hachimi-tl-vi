    {
      "uid": "zhcn:7a1ac1c2c4901993cfcaaafb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“天皇赏（春）”终于到来。",
      "source_fingerprint": "e03396b278d01cca38f6a93a21fe264e055853c44eafee0b7d8f1302dc52d4da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013411.json",
