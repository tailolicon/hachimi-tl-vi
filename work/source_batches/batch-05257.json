        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:d499f1b4bd16317d2a9eca96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向天皇赏（秋）",
      "source_fingerprint": "acd583fd839f6680a57f75e09880ff12f48e50ac7beeab6d01036df8eff7ff5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013413.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:629009c92453e5e2c657c2a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "历经出道战后，距离“天皇赏”更近一步的\n目白麦昆沉浸在感慨里。",
