    },
    {
      "uid": "zhcn:68c0b3c95fee922bd1fd69db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向天皇赏（春）",
      "source_fingerprint": "787a30dcdda7188675e08b67055e274860a6c1346bc76e36d7243b3c8364986b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013411.json",
