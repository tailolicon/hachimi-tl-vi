    },
    {
      "uid": "zhcn:e526e9786a0ef6a3763918c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "凡是赛马娘无不憧憬的三冠竞赛。\n“菊花赏”当天……",
      "source_fingerprint": "494f480702e0a06fc4b40c498d93c53021ed4bf71402c51729cbe3012bb4dcd7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013410.json",
      "json_path": [
        "text_block_list",
