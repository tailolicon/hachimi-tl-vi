      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆即将迎接出道战，\n她内心感到既紧张又激昂。",
      "source_fingerprint": "cdabe67098ddafb31762638957b8cf2d983b2efdb0cacb78e7d2f02dd12c6bae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
