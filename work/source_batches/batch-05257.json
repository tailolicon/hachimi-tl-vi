      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:502abf41b4d8a594f7e4f3e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让目白赖恩明白自己的决心，\n目白麦昆前往赛场准备与她一决胜负，\n这已是她们不知第几次彼此较量了。",
      "source_fingerprint": "317fe40764ac65e8263e923077e2b74186b551ebb74327b56123a1df74f51efd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013412.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:da519ca386338d4b082fc486",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向宝冢纪念",
      "source_fingerprint": "4743315d92bef0a1d3815aad5f8b1374f193f12e0416639bccc69a7a0dc88f06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
