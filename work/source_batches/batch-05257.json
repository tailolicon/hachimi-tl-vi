    },
    {
      "uid": "zhcn:5f8b6f371c83c73ada9a1341",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆一边回想至今的训练，\n并在脑海中模拟比赛过程。",
      "source_fingerprint": "78d4f740fdbdbc3fda923e5780b6296d28d515edbc7874ec475ffa3ad7ce8b0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013409.json",
      "json_path": [
        "text_block_list",
