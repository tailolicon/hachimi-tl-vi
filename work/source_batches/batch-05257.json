      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e7e396f08636616ea253c005",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她表示自己将会拿下优胜，\n并动身前往赛道。",
      "source_fingerprint": "c9490e65c44cdece77d86b2a65f3208e4886a6f1aa4bd2c8cebbb215ebd697b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
