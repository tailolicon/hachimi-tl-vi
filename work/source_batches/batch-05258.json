      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽管目白麦昆奋力一战，\n仍在对决中输给了目白赖恩。",
      "source_fingerprint": "7ddfd5c029658cbd56cb28534d8e09a76ea15bf2935e6c7efda140fadee52cfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
