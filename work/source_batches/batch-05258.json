    },
    {
      "uid": "zhcn:41be805390839d85b11c13ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "历经出道战后，距离“天皇赏”更近一步的\n目白麦昆沉浸在感慨里。",
      "source_fingerprint": "585107c42ca153b2ff2de979dfb98deeba3e6f1b71d5048a2681153ff93d1ac9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013424.json",
      "json_path": [
