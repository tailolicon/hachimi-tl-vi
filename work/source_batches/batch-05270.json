    },
    {
      "uid": "zhcn:ea60a6c62c8337d2d0045387",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆的兴趣是电影。\n以千金小姐来说，这兴趣让人有点意外。",
      "source_fingerprint": "8bc8a357f1813ca798adb1f3862ee9ca7a5555b01bd98e1a786e907fcd9eb877",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013702.json",
      "json_path": [
