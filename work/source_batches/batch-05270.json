    {
      "uid": "zhcn:a97c622ec3afcbcb3966e488",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实我很喜欢看电影。",
      "source_fingerprint": "02547091b657136c44d44dedc5d773ee0b3cf4a7e83dbc6f94075377607491bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013702.json",
