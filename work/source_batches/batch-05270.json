    },
    {
      "uid": "zhcn:a19552ef3ae123677eeb5693",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "屏幕的两人",
      "source_fingerprint": "47fa7d72ddcc130625c01da4ac01c823f83dfcd159b681563c9540b23eebe1fc",
