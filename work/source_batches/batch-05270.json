      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要不要看场电影？",
      "source_fingerprint": "5717f2dc311dca6f5b548833349aad83c550ee00db79676d2c3c8bf05eb90b83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
