      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然都来到电影院了，\n直接回去也满空虚的，于是──",
      "source_fingerprint": "c2948a60e1fd37d7234aa233c59bce8d6f538934ad8222d00200fb8f5c5d2d1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013702.json",
