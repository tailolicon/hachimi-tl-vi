      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，还是等下次有机会再说吧。\n训练员，我先告辞了。",
      "source_fingerprint": "9a14733cda6d7b7d21eab4012fcf6d12eb24ff6fdd3e9a79183a248501c1ed7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
