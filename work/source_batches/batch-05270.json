    {
      "uid": "zhcn:1837403b571c9367f78142b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错！其实我非常喜欢看棒球比赛，\n尤其是看现场的球赛！",
      "source_fingerprint": "6dd6b3fc472653f4571b229433d403a9e1eb81c613cb5f4d8693b0ad6b9ed26d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013703.json",
      "json_path": [
