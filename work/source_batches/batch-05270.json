    },
    {
      "uid": "zhcn:0f1a7c37392fc6b891565111",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "位在同一区域的巨蛋球场内，\n传来了阵阵欢呼，这么说──",
      "source_fingerprint": "781ea2e0ef8c6e9cad95390df65ad39efc8349c359ad1cf1295e0d4a9d59f583",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
