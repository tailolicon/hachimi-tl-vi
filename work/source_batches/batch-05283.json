      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:404e7ace1d987279b02c896d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你知道自己怎么会这么累吗？",
      "source_fingerprint": "893a8ca911ce30dcf98c190cba0c61ab60219b0a868253a4bf569ed7d52a5150",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1013/storytimeline_501013800.json",
