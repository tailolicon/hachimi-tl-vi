    {
      "uid": "zhcn:387f23115e35ae88e5fbfa01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，真要说的话，\n麦昆才是很棒的朋友。",
      "source_fingerprint": "bb4a722f7fc856b8ab92edd4fc1b9a06fb5d47269216d203d96279f5864fda2d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
