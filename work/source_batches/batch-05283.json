    },
    {
      "uid": "zhcn:9b2430e03ce242b33079f39f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是训练结束后，为了让她放松一下，\n我带她来到食堂。",
      "source_fingerprint": "8ce01758a4d97be3c1fa56c04f3d620d8db84d84468379a93858d05de4778749",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
