    },
    {
      "uid": "zhcn:f7e13501eb00f537a2edc087",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……没想到在这意外的时机，\n生野狄杜斯开始大谈特谈她的管理论调。",
      "source_fingerprint": "deb99fef7e3e67c3325cc27ade8fbde05581393ad9849ad657e635361c5613e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
