      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多少能懂你的意思",
      "source_fingerprint": "544db12976e4ef6fa898c0332ea0ce34e118896e41e8a9960029d7f48d4c2103",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
