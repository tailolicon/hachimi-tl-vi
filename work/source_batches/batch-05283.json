    {
      "uid": "zhcn:0f8ea982894feb244d0cdd3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……真、真是的，\n你们两个自己聊得那么热烈。",
      "source_fingerprint": "1c7df2f69d694d757434502d795efd043a16675da4c1e98e339c8d40c75e6127",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
