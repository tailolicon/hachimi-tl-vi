    {
      "uid": "zhcn:2bd7f018635bb5731e286925",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "先别聊我了，\n生野请专注在自己的事情上吧。",
      "source_fingerprint": "3e7fd6ae719c40cea2b17a46f72ee0b62ed7c54375cbce906b33f01efea55710",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
