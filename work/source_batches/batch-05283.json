      "uid": "zhcn:b997bebf9272317469f9faab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呼，训练员。\n真是谢谢你宝贵的意见。",
      "source_fingerprint": "35a8747807ffb5ae2a54431dd744368bb7035352ce328cd16ee389266abcc85f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
