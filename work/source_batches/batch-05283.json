    },
    {
      "uid": "zhcn:1dc491a6685533c78d0f52f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆",
      "source_fingerprint": "9001c462cda02e04688042965b70cf8db0bfc021e262b0efa9c3c3adc791b7da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
