      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这对有在关注她的人来说，\n可是会觉得相当感激的。",
      "source_fingerprint": "000804eb732618c9738d9ddd62108c7dc523edc5cb349bfd3dc7ab6078e51723",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
