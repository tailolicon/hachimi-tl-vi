    },
    {
      "uid": "zhcn:f2cc70588a5bcc14cbbc01ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会跳的，小鹰！\n虽然我不知道自己能跳得多好。",
      "source_fingerprint": "c05be3d067cd4345585cee2fb6da40117ad154e3f2b3d64704da3ec7b31b2ab4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1014/storytimeline_501014116.json",
      "json_path": [
        "text_block_list",
