      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不是为了隐藏自己\n才戴上这个面罩。",
      "source_fingerprint": "a8e980e3d764d0d13a5d58093917d16733552a5485fb3fe68f364795fdf1e5b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
