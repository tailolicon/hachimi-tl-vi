    },
    {
      "uid": "zhcn:290fc4a02501cd8fc4feb03b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神鹰在月光下脱去面罩，\n轻轻地放在岩石上。",
      "source_fingerprint": "40da328ffd9e2a6ce431fcc024944d2cc3c9bfb847f74edcfb2672d133637796",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
