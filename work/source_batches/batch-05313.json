    },
    {
      "uid": "zhcn:135b315e924086d574bf5057",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神鹰",
      "source_fingerprint": "795f13602f1e9cddca3fec6d57b66ab4924d833a2a706e841577ffebe02c9437",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
