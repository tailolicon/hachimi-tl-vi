      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（哇啊啊啊啊啊啊啊啊啊啊啊啊！）",
      "source_fingerprint": "80eec584851168ccabcd991c8849afe70543b17a792563e4e7711264125d618b",
