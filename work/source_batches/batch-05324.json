    {
      "uid": "zhcn:89cabdb9f6e696de2138b9bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "距离大概是介于英里的1600米与\n中距离的2000米之间。既然如此……",
      "source_fingerprint": "a1f66c8fab3b4d9c5b0f7f6408d6df78e0814946bb43d9ac98787509020b412a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
