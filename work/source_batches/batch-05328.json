      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你觉得“每日王冠”怎么样？",
      "source_fingerprint": "f81b9eb4a4a2f6fac873d7ce17ac91c9c6590553233c793c467c6e661e5183eb",
