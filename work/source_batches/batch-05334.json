      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神鹰获得了能与同期伙伴们\n一决胜负的宝贵机会，\n整个人变得更有活力了。",
      "source_fingerprint": "c30b8a3ca83b38d650486a5046933493163712af7e4209ecc922446064d336f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
