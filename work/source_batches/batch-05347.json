    },
    {
      "uid": "zhcn:8877051d69d3efac7b510066",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我无法拒绝笑咪咪的神鹰，\n只好带她去吃好几公斤的烤肉了……",
      "source_fingerprint": "b83939df935ec3819fb18e97fd6038abec0474d97bf6a4bc974297f8b48e7e37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
