      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听到是神鹰崇拜的摔跤手，\n我不可能不在意。",
      "source_fingerprint": "44324a44502461d55fb9294231b19dc802b0c91c912935ac43da7a278dd0ac2a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
