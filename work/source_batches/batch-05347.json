      "source_language": "zh-CN",
      "source_text": "如果训练员愿意的话，要不要\n和我一起去替她加油呢！？",
      "source_fingerprint": "8726dfbf2359ceb50020c731439ac8ef18be579fcc23edeb4a5506592c3b7911",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1014/storytimeline_501014702.json",
