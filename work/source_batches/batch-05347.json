    },
    {
      "uid": "zhcn:4ba08775cab0204c6263e75c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然要！",
      "source_fingerprint": "036d5475b186c9036a8468eab6fa5e9d3ec64abab299aaa07147b5e1814d0bd8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
