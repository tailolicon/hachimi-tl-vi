    },
    {
      "uid": "zhcn:f08eb9b476fea1f770b12dcb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──新年快乐。顶尖巨星威风凛凛地登场，\n把日式氛围全都推到了一旁。",
      "source_fingerprint": "9111beccd98c3c1665f7f477bd1b532828a10ccdb19acdb4d4f0cc10c4e29533",
