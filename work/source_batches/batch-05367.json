      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好歌剧登场！",
      "source_fingerprint": "f4d5415e60617063f6b2b52a6073efa49c12814f7e8b85f5ad3b1b05088790a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
