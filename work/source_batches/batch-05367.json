      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好歌剧终于确定能够参加闪耀系列赛了。",
      "source_fingerprint": "f9a7f80ddd163808aeb8ec3806a038e715bba240db119c467495bb26086e7948",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
