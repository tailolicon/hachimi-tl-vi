      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈──哈哈哈！来吧，大家都来为我祝贺吧！\n祝贺我迈向新的阶段──！",
      "source_fingerprint": "01a74aededa2753e8c156775739cf656efba9356ad44e99a8865d7715aa614ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
