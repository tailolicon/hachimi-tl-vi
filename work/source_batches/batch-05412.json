      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了向臣民们传达我的喜悦，\n我演出了长达八小时的歌剧表达谢意！",
      "source_fingerprint": "765612c104811509cab9ce6c61ace95f16aca5c9362901304c2c757f15f9c81b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
