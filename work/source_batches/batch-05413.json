    {
      "uid": "zhcn:3d2a2997bad65482aeffd231",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利者“霸王”的蹄铁──\n终于与前世代的英雄们并驾齐驱了！",
      "source_fingerprint": "d9455bddc13ae728fd63e4eee71d6621e36c5bfa743c7f6b57b9f64bce800157",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
