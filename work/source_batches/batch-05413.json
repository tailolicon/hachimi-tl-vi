    },
    {
      "uid": "zhcn:e9ba64c70df910332e6b51ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・称霸与慧眼",
      "source_fingerprint": "1a7b0c42358c053b96b0f91ef9eb36bfe6819f571058afe1c05af9ff2bf214ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
