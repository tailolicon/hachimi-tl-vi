    },
    {
      "uid": "zhcn:608a0bec7be0711f029047e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "发表招揽粉丝结果的这一天──\n会场来了许多支持我的民众。\n以举兵进击的阵容来说无可挑剔！",
      "source_fingerprint": "0d7c7268d32e915d8a587570129ba898590cb4e8759b99b7925c2ca1fe24c2a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1015/storytimeline_501015417.json",
      "json_path": [
