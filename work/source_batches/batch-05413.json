      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:8204105fd3e90eaf779c4e5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・迈进经典赛",
      "source_fingerprint": "3a25dd5be5ec38bf0eb09b9c42705e857c8dc1c8b3dab1a9c61098950c30370d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
