    {
      "uid": "zhcn:077cdf7cfcfd92931d12e752",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──来吧，各位！\n“世纪末霸王诞生剧”的终曲要上演了！",
      "source_fingerprint": "875e687395e2f05cf93936d1cc4477e666d7fc69bbb8bb9e77223ade5a145075",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
