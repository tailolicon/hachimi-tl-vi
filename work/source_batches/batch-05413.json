    },
    {
      "uid": "zhcn:6f16466e00dbc1e0e661f7db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "眼下的目标，是经典三冠之一。\n──新绿萌发的中山・皋月赏！",
      "source_fingerprint": "46e65b683e394ccd73f2e6dc0c1f9a49eedd922cf6aabdc35770d0bf4c24f1c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1015/storytimeline_501015417.json",
      "json_path": [
