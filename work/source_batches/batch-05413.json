    },
    {
      "uid": "zhcn:86201db8697744242ce22a4d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天将会成为“世纪末霸王”\n的加冕之日吧……他们如此说道。",
      "source_fingerprint": "d4e8680e53df655eb41f1ff07e2b9b4af55707e90e6e4f15866e3c036e5fe2cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
