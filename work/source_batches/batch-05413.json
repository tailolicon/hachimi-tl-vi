    },
    {
      "uid": "zhcn:84e7e6b32b98847a688717ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个目标决定了──我要拯救他们。\n让还不认识我的不幸众生，\n用“霸王”的奔驰令他们成为我的粉丝……！",
      "source_fingerprint": "2778bed2d65e1551a4cee9ec741c8e97e9b814e75daaca19d1ca5b4144345d4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1015/storytimeline_501015416.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:eeb0ee1c443387f0f194bdaa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・迈向伟大的第一步",
      "source_fingerprint": "41634a21531aae9361055815ffa09994cfedb1f98eb51cd6f5bfafd9eb2353a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1015/storytimeline_501015416.json",
