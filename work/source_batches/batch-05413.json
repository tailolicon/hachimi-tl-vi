      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵呵……也就是说，\n我作为“霸王”的成败今后才要见真章！",
      "source_fingerprint": "274c806a5880bc896ef8b28297652aef357a9efa9a309601926d7cb281feefbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
