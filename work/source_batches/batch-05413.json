    {
      "uid": "zhcn:c2465c477b5648c3714ce21f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，我迈向下一个阶段……\n适合让王者一举扬名的“日本德比”！",
      "source_fingerprint": "c5f1919b1c2f3519e18c07d2fca04613efa5600dc6a7718377d133a6a76fcbf6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
