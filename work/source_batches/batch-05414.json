    },
    {
      "uid": "zhcn:80626d15ba8e0d68bf2465d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在正是找出生路，建立我的王朝之时。\n建国宣言的舞台就在──“日本杯”！",
      "source_fingerprint": "4bd833fe2f65c10a2ea73bd5156a276540f7e07adac0685a097206910d133ab9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1015/storytimeline_501015425.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:1387e9151bae20be2d1c41be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・殒身革命！",
