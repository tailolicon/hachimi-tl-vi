    {
      "uid": "zhcn:00e43d02c4a27e35a2dcec27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "希望今天务必要让我慰劳你。\n我们就去坐摩天轮放松一下吧。",
      "source_fingerprint": "884918b56b621fad9d610e673a6b9adb9afd734f4bb90b610fcb8bf91ab3eb0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
