    {
      "uid": "zhcn:e121fc03c9360373b322e927",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来，尽情欣赏吧！\n欣赏我从天上注视地表的美丽侧脸！",
      "source_fingerprint": "15a9767d58c96644aa99c07e0bd32dad50aa23bd75c5807e1cc3ac6c36cd2c0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1015/storytimeline_501015511.json",
      "json_path": [
