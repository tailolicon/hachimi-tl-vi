    {
      "uid": "zhcn:8126064d74975f973a8157fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，在这短暂的时光中，\n只让你一人的眼眸，看见我的身影……！",
      "source_fingerprint": "5817dd30a83620865dd7ea615f9e5af699db3579a2ff4bc04bfdb9aa51a02b1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
