    },
    {
      "uid": "zhcn:2143f7920c0a64412609f612",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我只好急忙照顾起似乎\n又背负了另一项罪孽的她……",
      "source_fingerprint": "3e110e7294715590206aa3f9bf5e89c96d999fdaf07a613ca997444a48a4536b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
