    {
      "uid": "zhcn:f89c82ed3e45339f123cee04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我真是……何等的……罪孽深重。\n……我不行了。",
      "source_fingerprint": "ea0c8bf9ee7e5fbd0f0fa75562444e5101b2992a8934e351a19dc0827a81c222",
