      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:47fe97bc67dee8976ebcbcbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她体会到了更大的实力差距。\n是因为过度自信才会战败吧。\n她与训练员吸纳这次的经验，化为变强的动力。",
      "source_fingerprint": "a3eb27d699a6a5c9151eef434447e45bf15c7ac4a1e0ced6bc719ca7462cdc3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
