    },
    {
      "uid": "zhcn:1455a43d474e51b7bd3bc60c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁登场！",
      "source_fingerprint": "6f10dd7fe3f624e8a4b940feef9bd02bf7f95bb3b8b6d8126eb4ae90fab3f5ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
