      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以高手云集的闪耀系列赛为目标，\n成田白仁的战斗开始了──",
      "source_fingerprint": "987dbc9dfaa652d8767625fade71a09a994ceb6817d7a66fd45bdc3b77f5a16b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016400.json",
      "json_path": [
