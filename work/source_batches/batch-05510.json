    },
    {
      "uid": "zhcn:14af749a993ff7130e3815bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然她受注目的程度比起至今的强敌略低一些，\n但成田白仁绝对不会大意。",
      "source_fingerprint": "e3bf20186ed5f896a111d38b7ba401bd09d6dd7d06f4a7c416b6d8451bd8df18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016406.json",
      "json_path": [
