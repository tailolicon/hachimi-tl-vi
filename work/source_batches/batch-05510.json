    },
    {
      "uid": "zhcn:49fc9ee4b739de4f75364c0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016406.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:1cf3b9db5a249ad18662ccd8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光勉励勤奋练习的成田白仁，\n但她那宛如自己不会下场，只会在旁守护的口气，\n令成田白仁感到不对劲。",
      "source_fingerprint": "3cbc1441aab631e0cf1715084072849d3829dbdf90900f46d0578cbe0c40ce82",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016406.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6cd1cc0c31297f7422145f8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋",
