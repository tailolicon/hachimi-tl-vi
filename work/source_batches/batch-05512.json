    {
      "uid": "zhcn:76b5496ae21e5c895a95c1c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她本人却只把注意力\n放在下个目标“日本德比”上。",
      "source_fingerprint": "83ca1f7edd4c70024e0b90150792d749301485923afff235c353dcc8370625bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
