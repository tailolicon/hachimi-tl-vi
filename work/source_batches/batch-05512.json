    {
      "uid": "zhcn:0041db993bd32fe20a840fa6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁还想要变得更强，\n于是训练员建议她参加经典三冠路线。",
      "source_fingerprint": "1d134db359750611a7f2b25e095447f68201fea0a962f99e6cbae7a3dd794182",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016430.json",
      "json_path": [
