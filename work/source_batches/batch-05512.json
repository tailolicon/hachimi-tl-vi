    },
    {
      "uid": "zhcn:05cc1ad168f0a25600accb1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・征兆",
      "source_fingerprint": "003ca0da298f2b365e53452df705b63c505bfff657131098f24bd87ccb0037aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
