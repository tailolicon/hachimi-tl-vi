    },
    {
      "uid": "zhcn:62bcaf8432f3f145c69d11d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "朝日杯FS结束后・斗争",
      "source_fingerprint": "9503fe96572d1afeb8e0bd0a9ac5ad3dd305ec973d3c45534fa2e91d84aff765",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016430.json",
      "json_path": [
        "title"
