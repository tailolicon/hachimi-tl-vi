    {
      "uid": "zhcn:52e5ad30a5c9bd0b87db60be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要与强敌竞争，应该就能变得更强。\n成田白仁与训练员\n决定要先以“皋月赏”为目标。",
      "source_fingerprint": "6cb233be6cb49f93ebd944db007435ff7670402ffd761ea100e8c8d11b40a87d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1016/storytimeline_501016430.json",
      "json_path": [
        "text_block_list",
        2,
