    {
      "uid": "zhcn:5db37a98f424a95e649d08f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦哦！“奔跑而去的姿态\n宛如狩猎中的大鹫”呢……！",
      "source_fingerprint": "ac4820f06d9adccdfc96f6122026147b177c2db69ae9be6637a14d7b1ffd68f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
