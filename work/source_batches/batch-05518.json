    {
      "uid": "zhcn:e8315de19977e5134c581370",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的！我要写关于技压群芳的最强赛马娘，\n转生到奇幻世界的故事──",
      "source_fingerprint": "aff92952996d242b6b1d4b2d7bad9172e33c91cea60e672d443f8c9b4ca1db7d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
