    {
      "uid": "zhcn:a2047621b71c161a09f159ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊！请稍等一下！既然这样，\n就开车追她，等她休息的时候──",
      "source_fingerprint": "168b84a05124b521a50dc4c51666a66173756ecc3655f827c641164b2af00f5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
