    {
      "uid": "zhcn:ad2c96c2ca62aaedeec5784f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她、她什么时候才要停啊？\n难道这份持久力就是她那股气魄的真面目吗？",
      "source_fingerprint": "4372f80bc892dca28ce206336d88286eb8d7779cc2b5607a94ab6803b3c35fb3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
