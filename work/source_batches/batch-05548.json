    },
    {
      "uid": "zhcn:df40d594ddc2fd79cbdd5971",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "女路人",
      "source_fingerprint": "fe61a9bdf3cf0cc5dea3e5e4282a180f2b63ce92b9b7f6afee5ea356cd123b88",
