      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "往后也尽管放心地依靠我。\n没问题吧？",
      "source_fingerprint": "0a531fca3626570761daef7d2a24eee13252073f6984671811ce1ed153d922e4",
