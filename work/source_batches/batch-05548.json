      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:ffb0efca038ae91dcd0554f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征",
