      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:08f0642329182ac05363f5be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征",
      "source_fingerprint": "ba58fa29016f4366679b31c483127417c7d74c51f8dbea2e0de6e4b65088d5e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017100.json",
      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:69aaa615e55ccb891e79592b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以。对我现在最重要的课题是，\n成为实力不容置疑的“皇帝”。",
