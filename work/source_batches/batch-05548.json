      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:0f324267e323208d71190fb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "各位，早安。\n你们一早就朝气蓬勃的呢。",
      "source_fingerprint": "b99cc1aef050a92f989a2f0bcde97e2132fa78c33f243d4984a3b21c58768242",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017100.json",
      "json_path": [
