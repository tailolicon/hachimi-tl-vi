      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:b606447717c4d930b6f2f8be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她直盯盯地看着我。\n那眼神就像是在说\n“我不接受半吊子的决心”。",
      "source_fingerprint": "6c6f6e8f9999a7747b086a4ee7b5f14ac056d516af6dc252bba05e964462b33b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
