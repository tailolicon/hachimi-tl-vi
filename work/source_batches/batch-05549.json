      "json_pointer": "/text_block_list/44/choice_data_list/0"
    },
    {
      "uid": "zhcn:326540a3757453d1d2ec2f2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，我才想帮助她开拓出一条路。\n没错，自从她选了我的那一天开始──\n我早就下定决心了！",
      "source_fingerprint": "59571ae5c822b32f5ca80a1d0df308a83cf80d5554fd042e6c35a09bac4292d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
