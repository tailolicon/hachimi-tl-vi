        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:afea5a9cc58ebdbb9ad1e865",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的目标太过高远，\n要一个人扛下，\n实在太过沉重。",
      "source_fingerprint": "4f12ecf6356fdff5ea7361b6773d3d5aa2e1b9ae163977d273d63feba362228a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017100.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:dae0b3e72052b8c0842d8f88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是！",
      "source_fingerprint": "92c7c80d421e17e0e64227dc915153ae460be7213ab0bfafd9026602c2e67892",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017100.json",
