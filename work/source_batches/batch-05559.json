      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵……嗯，\n看来我找到了不错的搭档呢。",
      "source_fingerprint": "d3ff6ab661ea8670b4c9c94f2a7cc1ce4a1e4d892428ae75af8ed4943928c76c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
