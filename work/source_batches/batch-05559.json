      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "似乎是一大群赛马娘正在庆祝。\n就在这时──",
      "source_fingerprint": "b5a3bd15183305c9471cb766f006c019a9a27eff612fcf265165d2bce6ac9dd4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
