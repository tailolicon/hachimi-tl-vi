    {
      "uid": "zhcn:4c4449e0cda0b6d17812ed67",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在那之后，我们享受了一场两人舞蹈会，\n直到鲁道夫象征心满意足为止……",
      "source_fingerprint": "f88acf615d01f4b63e7290a6e95d148c513bbf3402ab66e8d2a1d9f42f2b7b80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
