      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:809c3db6ec8bf9c724a067f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不协和音",
      "source_fingerprint": "85126f2e2024a3299f744885e6541ccf1a10630b0f28ab98815fee7fc47d08c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017115.json",
      "json_path": [
