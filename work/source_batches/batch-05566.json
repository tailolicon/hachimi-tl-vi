      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:378332ebe82b283aadd5fdec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征",
      "source_fingerprint": "ba58fa29016f4366679b31c483127417c7d74c51f8dbea2e0de6e4b65088d5e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
