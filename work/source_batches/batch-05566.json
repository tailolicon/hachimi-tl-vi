    },
    {
      "uid": "zhcn:7c383aac23d0cc6de7e4d004",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "输给比赛的严苛与残酷，对自己深感失望时，\n特别容易被家人的温暖影响。\n……她们会选择放弃也是人之常情。",
      "source_fingerprint": "f6ec4612362ecff2f8b6929d01dd9d1b65e95e31e345b5c91bfc5a188fb18c6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017116.json",
      "json_path": [
        "text_block_list",
