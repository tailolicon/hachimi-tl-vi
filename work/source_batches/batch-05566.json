      ],
      "json_pointer": "/text_block_list/11/name"
    },
    {
      "uid": "zhcn:90c2e576ff5997eff91ac0fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……往年，总是会有同学回到\n有家人陪伴的老家后，便不再返回学园。",
      "source_fingerprint": "e27e4bc0e855516169506d834df1de5e5fae4ad97dd1c6537b42fb2ed6cea1bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
