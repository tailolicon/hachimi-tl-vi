      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……谢谢、你们。",
      "source_fingerprint": "0b28a3cef2ce95cf3bb33f5e54cf17fb080e471e4eb339883d4ee6560fdb71f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
