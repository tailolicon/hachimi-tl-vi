    },
    {
      "uid": "zhcn:c88abef4e952674f6c5c158f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果这么做对她而言真的是一种帮助，\n我会为她的崭新旅途送上祝福。",
      "source_fingerprint": "f8d42390d7aecd99dfbfeff16e948422391c39aaf0f84f0822a5826113afa463",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
