      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请务必让我接受采访，\n那么请各位按照顺序来吧。",
      "source_fingerprint": "c093fceca4ee68d4668be6ff03535e582d21847f9e999b1e20dde0ee224148c0",
