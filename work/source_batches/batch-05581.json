    },
    {
      "uid": "zhcn:5641646e70ab9bab76e98201",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……没关系吗？",
      "source_fingerprint": "21d630216006549f32feabc7d9add04249f321682993c03be4dee9692aae85a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
