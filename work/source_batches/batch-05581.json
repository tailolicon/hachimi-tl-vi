      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恭喜你出道了！\n请说句话表达现在的心情吧！",
      "source_fingerprint": "a5eb6c9113a06a9842560da2a8ab5bcb9fce58b6a4aa502213046e0b2f775d5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
