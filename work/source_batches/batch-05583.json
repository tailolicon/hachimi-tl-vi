      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:b567dcca2567906aaa0dfbf0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过撇除这一点，有机会的话……\n我也想看她以“鲁道夫象征”的身份\n奔驰在赛场上的模样。",
      "source_fingerprint": "750a6434c64ea104a13f58dfebd8254a3ba5cafa5b12cdfce90d199273f421ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
