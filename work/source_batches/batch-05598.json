    },
    {
      "uid": "zhcn:3e9a75583edc088400966978",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我想不出来啊",
      "source_fingerprint": "88c22c30345dc5f0158c8a5b090177448cce3d8f30cb5cbbbee63f9d8989d906",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
