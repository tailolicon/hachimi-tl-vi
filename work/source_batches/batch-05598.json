    {
      "uid": "zhcn:d9a586fffc6805667ecb7033",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对了，你不觉得做出成果的我们\n需要一些奖赏吗？",
      "source_fingerprint": "bcfb613682627dcf72fa09c7ae5545353f01c37a82642d494995442a70e621a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
