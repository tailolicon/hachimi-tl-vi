    },
    {
      "uid": "zhcn:26ec20bf9b026dee4563562f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，是吗？\n老实说啊，训练员。",
      "source_fingerprint": "5da5236846b9de8f8c4c1f1e9f19fbcd0ebcbd95c790edcc760185b33ba5f0fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
