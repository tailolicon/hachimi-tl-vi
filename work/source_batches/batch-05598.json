    {
      "uid": "zhcn:82ba5dbb61281e09da9c1d65",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征",
      "source_fingerprint": "ba58fa29016f4366679b31c483127417c7d74c51f8dbea2e0de6e4b65088d5e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017321.json",
