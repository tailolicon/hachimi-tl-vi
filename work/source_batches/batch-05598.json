    {
      "uid": "zhcn:d2b1361d81ad8ae91f5cca14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且，必须是配得上\n世纪壮举的奖赏才行。",
      "source_fingerprint": "4970db1ffad1d35992fd67b1516a5fffe506a55e7e49120f80704e66085df0ca",
