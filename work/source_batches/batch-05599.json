        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6a6325affcc39c42a4a61e68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・卧薪尝胆",
      "source_fingerprint": "14c580e44a1fc7b933ae5d2ae8b56bfbe33a75be28dcbc6ff78dd1a6c8e270f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017423.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e9f2b8cb0bbc043e157dab99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征称霸“日本德比”后\n举起两根手指，表示自己取得了第二冠。\n坐拥经典三冠的梦想似乎就要成真了。",
      "source_fingerprint": "ead4e3c44061fd68350e67746fe4b51c39c7faeeed488a602294a4f311c9a274",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017424.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:cc9efa8b6cdd6af8766d2cdb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征表示下一场“菊花赏”\n也要取得优胜，但是她已经无法掩盖\n繁忙的日子所累积的疲劳，令气槽担心不已。",
      "source_fingerprint": "c3202d3f9c9e9278c0b77e439b14a8ec6379e4db95d00a5ed8b59cf38539e74d",
