      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:f983ce4501759629e73e5d51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员与鲁道夫象征互道的感谢与慰劳，\n听起来令人心头暖暖的。",
      "source_fingerprint": "1346ba98d45f3969a0b32e09f40086d4875e6b7c8542d6b2c12ce6ef89420027",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
