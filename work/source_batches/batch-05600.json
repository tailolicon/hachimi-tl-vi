      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁对一心关注学生会的鲁道夫象征，\n丢出了辛辣的意见。",
      "source_fingerprint": "508593b5d268dee98996636309016b2548c146376b2685b25456b7ef2e64fbcd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
