      "source_language": "zh-CN",
      "source_text": "挑战成功",
      "source_fingerprint": "14a8ce016dbb507b1808b128f6e713baefa1804b6d0cdb480bf049a084143c4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017435.json",
      "json_path": [
