        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:5dccf3c978c4f23b0476ec90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征重新回想起奔跑的乐趣后，\n表示希望所有赛马娘都能感受到这股喜悦。",
      "source_fingerprint": "a4fd2cbbb60082155e8d611917103cc9cb281a0fc8c1340fb06a12d65c641a35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017434.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:51377312703f1585e6c77537",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在后来的记者会上，\n再次述说自己身为“皇帝”所拥有的梦想。\n今天，真正的“皇帝”诞生了。",
      "source_fingerprint": "d64ef3af16cc94b07a365675e835ac3f928428a1de01cd7c7b585a21c7e1c60f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017434.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:43ebd5672454eaa30f0617e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・皇帝君临",
      "source_fingerprint": "698dbaf7d3a1a7fc5d0f3e16105c7bfb5a6de5a8fad65e40a27fe01a0ab7c87c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017434.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:4d7116cd89692efd0fe54450",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所有比赛都结束了。\n她背负着观众与所有赛马娘的梦想奔驰，\n所有人都认同她的表现配得上“皇帝”二字。",
      "source_fingerprint": "9b3a045150754699a53756fcb892824622cb048bd56798706e8bdab034815385",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017435.json",
      "json_path": [
