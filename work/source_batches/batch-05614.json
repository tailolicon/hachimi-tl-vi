      "source_language": "zh-CN",
      "source_text": "不过即使是午休期间，我也不希望关闭\n同学的咨询窗口，也就是学生会办公室。",
      "source_fingerprint": "4e6bf55e2666dc8a618cf217c028605e7fca44c474bf03e59ef8b8880de439e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
