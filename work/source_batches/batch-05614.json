    },
    {
      "uid": "zhcn:02ca81783a5b3ac219f7ba00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在心里发誓，往后也一定要与她并肩同行。",
      "source_fingerprint": "a5c0e2ec4c549048d772f69b3b4994e9c0dff65a78b552a2b9a8dae3863f990d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017704.json",
      "json_path": [
