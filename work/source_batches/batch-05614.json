        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:4aab8ad77bab6cfafda6933c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征带我前往的地方是\n位于高地上的神社。",
      "source_fingerprint": "0b619474921928a10a6e0ba899853637d044b1f10bc71bd3c7e1b24cb6750490",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017704.json",
      "json_path": [
