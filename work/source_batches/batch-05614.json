      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:952989e6c0601c04c28fd507",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我抬头一看，确实像她说的，\n夜空中挂着一弯美丽又明亮的新月。",
      "source_fingerprint": "2ea5a399eff96de87cb0d903f88993b8955f534c8125f3a7c7a58305a26e9fc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017704.json",
      "json_path": [
