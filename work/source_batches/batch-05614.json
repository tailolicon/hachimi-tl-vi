    },
    {
      "uid": "zhcn:13a6b3976ee299ed57c52b99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征在月光照耀之下露出微笑。",
      "source_fingerprint": "29d96d4303b4c921bbbf6589d67d7d1384996a9f78df22cfd0ee33e2e56718c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
