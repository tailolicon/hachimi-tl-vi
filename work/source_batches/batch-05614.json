    },
    {
      "uid": "zhcn:384b8e92b12f01712c3dcb33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这里的遮蔽物与光害比较少，\n所以月亮看得非常清楚呢。",
      "source_fingerprint": "3b26db213f137e37e43f1833e6d38147c614d78eb7d9c8284ef15be84e0a5881",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1017/storytimeline_501017704.json",
      "json_path": [
        "text_block_list",
        5,
