      "source_path": "assets/story/data/50/1018/storytimeline_501018100.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:56cfe40aff18841229f9009d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "学生会长鲁道夫象征出现后，\n周围一阵骚动。\n这样实在没办法上前搭话……",
      "source_fingerprint": "4f2a95f0bbefa072fffde482dc7c9db2528e1d2a989abe81b9464e31645df220",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
