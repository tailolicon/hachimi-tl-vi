    },
    {
      "uid": "zhcn:4bf765b0ddcf9bc3fe8ea74b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要叫她就要趁现在！\n就在我内心这么想时──",
      "source_fingerprint": "347a61a1e3c67f19a3f572960904789bca446e8feb4f35d77c698f3bc2285666",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018100.json",
