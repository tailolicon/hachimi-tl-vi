      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这件事不急，另外找时间也可以，\n不知道你的行程如何呢？",
      "source_fingerprint": "ccf5333e611d83db0e1d89ac6af518914d7586b1aa5f508b9a3271a9c1aee7f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
