        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:58de1fa1724537b7db2b33ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘B",
      "source_fingerprint": "42ea8c79a86837cb9af953a10302def1e962afa4c95798592cbb74b636ec86b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018100.json",
