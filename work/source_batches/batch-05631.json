    },
    {
      "uid": "zhcn:a48a690fb4ba09ace8bb5ec0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从今天早上就一直在找机会跟气槽谈话，\n但她的工作一件接着一件……",
      "source_fingerprint": "4c4f6259598d12bec6a3067f53daf6d59f3757d77be72c575362cba33972fb00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
