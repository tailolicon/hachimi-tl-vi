    {
      "uid": "zhcn:8905fc3b4f77060e422d769f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，接下来……",
      "source_fingerprint": "3847e0309628449ddf839e9ada02cea55dce74e2c549f0312e972831733d14dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
