    },
    {
      "uid": "zhcn:b5cc96b57c766fbd016d5132",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（话虽如此，我也不能妨碍她工作……）",
      "source_fingerprint": "75a62d518576b1802955de1a3e4e20b4fdef106b774e230a2c2db226c84b746f",
