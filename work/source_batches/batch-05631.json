      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "会长？\n怎么了吗？",
      "source_fingerprint": "91697fba2d0ebf631cc2fe479e8124aada025122c5ff1ebece7223b59c0abcbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018100.json",
      "json_path": [
        "text_block_list",
