      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:82a9176a563222e93969321e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇，你看……！\n是鲁道夫象征学生会长跟气槽副会长……！",
      "source_fingerprint": "c5cbd7856dce1f2e0c320c84f100530c4db64c3b25b41ff2ae75b9bc7520d0fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
