    },
    {
      "uid": "zhcn:d965fd3aaee49991672734be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们两人站在一起好有气势哦～！\n好帅……♪",
      "source_fingerprint": "65c007505bced28d97ce07675e0c96c1a2d9254f4b3778d0813640ec4ac604ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
