    },
    {
      "uid": "zhcn:42a8db1f3eda13cbf2ee5249",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了能以训练员的身份站在她身边，\n我在内心发誓要更加拿出干劲。",
      "source_fingerprint": "f1839e16f0fa09988563ed66fdcade7024f77800b191c4b344a528106cc82d25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
