      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那些赛马娘的眼神深处，\n看起来就像点亮了新的光芒。",
      "source_fingerprint": "2306638661cbbe8b0b62f695eae37633cbac9684f4eabbb15b55730b3f3d60f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018100.json",
      "json_path": [
