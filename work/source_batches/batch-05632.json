    },
    {
      "uid": "zhcn:411a2a3febb2bdd849ef5ae3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是气槽再次跑了起来，\n赛马娘们的目光则紧追她的身影。",
      "source_fingerprint": "df96d8694db80f5780d1e5e094b66da05ead32c13615c6bd39c992c0c28cecf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
