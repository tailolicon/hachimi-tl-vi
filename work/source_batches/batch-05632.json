      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还好我有来找前辈商量……\n谢谢前辈愿意听我说！",
      "source_fingerprint": "211af62344ab1052b6d1e751822ce0ec6c53533bbca547dbe537c2ab2f091b89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
