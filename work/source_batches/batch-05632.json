      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:5e7dd42eda1f1c60f1ef8726",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──就这样，我与“女帝”气槽\n充满挑战的日子就此展开！",
      "source_fingerprint": "faffef63ae7824c32d32bb1cedc89e6d2e21cbecae4ebafc6925fc9bc1b091ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
