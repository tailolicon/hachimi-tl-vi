      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（现在不适合找她讲话……）",
      "source_fingerprint": "c6ceeaa941e381a97f04aa56441ba3814f0b8813c91d7f7730e9db9d36308bfe",
