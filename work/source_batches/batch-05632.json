      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好。\n还能再跑──",
      "source_fingerprint": "e8d77749bc8ba951fe9fa732a858a3d2259ef1d89aadd928be4364a173ff9443",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
