    {
      "uid": "zhcn:a184908c2f1b5c18bb604042",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天我就答应你的提议。\n既然决定了，那我们快去抽签！",
      "source_fingerprint": "288b8fb4a8fa8ef69c1b794703b6b8c8a20eb150e3bfe27cb010c589aaf0451e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
