    {
      "uid": "zhcn:ec800d559c3e5a3fcb4726ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后气槽抽到了这样的签，\n上面写着“保持弹性，勿埋头苦干”──",
      "source_fingerprint": "60642ee10b3e7122d4188f66331247a8dd7b22464dce4e80ab3714f5350fb345",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
