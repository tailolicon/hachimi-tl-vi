      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而学生会在粉丝感谢祭中则担任营运方，\n她们忙得不可开交。",
      "source_fingerprint": "cf4bcce2d63833164e858f40093e2dffb57026e11305bdd3b57fbcec7d5b4d49",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
