    },
    {
      "uid": "zhcn:9d5f56d55328f76d66441e43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征直直地看着我，\n向我提出这个问题。",
      "source_fingerprint": "247a676bfaa6169e073dd06cb22b9f0033489d3886019bfef9cc8778a63cfa4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018113.json",
      "json_path": [
        "text_block_list",
