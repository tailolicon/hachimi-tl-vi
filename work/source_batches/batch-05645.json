    },
    {
      "uid": "zhcn:907a15f77405a8c611f04d03",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "学生会的赛马娘",
      "source_fingerprint": "1ac6593e00aea2b5e46e7e4d58ab8e342e032c360d7a4d68a01defc9b94549d8",
