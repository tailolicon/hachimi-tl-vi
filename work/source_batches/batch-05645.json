      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听了她的问题，我脑海里第一个浮现的，\n是气槽曾说过的话──",
      "source_fingerprint": "8e39bc256960171fbe78c07224d667bb5374f50ec30cc925ad8beeb71b624509",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
