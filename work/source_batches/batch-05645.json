    },
    {
      "uid": "zhcn:8401ad70bb686235b8d60123",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（──会长？）",
      "source_fingerprint": "e50f9ef01214db1a411691ed01546a62aced3b140f121f7a2265ed6d951bc8bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
