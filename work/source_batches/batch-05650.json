    {
      "uid": "zhcn:cb40d85c3e192e065e50af91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "挑战者──",
      "source_fingerprint": "18ba70c7e876eeb6cc6ca62374feae43def2c90afa7072d439c46114c846ec6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018116.json",
