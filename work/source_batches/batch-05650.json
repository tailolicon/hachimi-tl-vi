        0
      ],
      "json_pointer": "/text_block_list/3/choice_data_list/0"
    },
    {
      "uid": "zhcn:a9f6a29186e85e3774763991",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你不是说过要超越铃鹿吗？",
      "source_fingerprint": "5e6623c649ef28a1cd32059a5559acf7c5c279ea654ee1f3652d9a5aa39c2fce",
