      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──目白多伯，\n她是人称名门“目白家”的赛马娘。",
      "source_fingerprint": "2b61b91a59026043dc8299db6c6e09f5ef0581368c722d07b52d77dc4cce0c4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
