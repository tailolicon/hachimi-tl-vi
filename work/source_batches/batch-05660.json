    {
      "uid": "zhcn:01093a9f97fc079ab28ca4d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我刚好有话跟你说，本来正想联络你的。",
      "source_fingerprint": "a0708ec321b7b6bd5c3854eeb0225b92a80d7b2282ae7c98ccf897edce0be424",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
