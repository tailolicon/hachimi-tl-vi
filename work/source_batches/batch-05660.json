        "name"
      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:7c2d5f88f6bc0e9ef3d0abad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "过去曾历经后冠路线的那些知名赛马娘，\n她们都拥有坚强实力，并兼具华丽高洁的特质。",
      "source_fingerprint": "36291ddc357394a525fc68560c638e0a22860f7d1272a07f7c8464ba07700671",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018304.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:69d39ee179520a812c4ffeeb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018304.json",
