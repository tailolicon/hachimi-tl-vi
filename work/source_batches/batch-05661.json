    },
    {
      "uid": "zhcn:e5e8091281c9fe0a43cc1395",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也有话要跟你说",
      "source_fingerprint": "ab696f6168e9cb0f51cbf964d3a6cff1ed4a1665e4b7003e0f7f516e66da234b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
