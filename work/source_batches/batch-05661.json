      "source_language": "zh-CN",
      "source_text": "就在我前往宿舍的路上，\n刚好在校门口遇见气槽。",
      "source_fingerprint": "6a413299a6397b32ae4d46bba45d37865003755f918acc574e17231deef3f9be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
