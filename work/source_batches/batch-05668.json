    },
    {
      "uid": "zhcn:c2dec1bed8cd7d2c8abbe2ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛的前一刻……两人简短交谈后，\n便上场一决胜负。",
      "source_fingerprint": "56e3506f76d33d95a709004b51f5e1700743c9f97d55035b577e3d3b24f2df79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1018/storytimeline_501018414.json",
      "json_path": [
