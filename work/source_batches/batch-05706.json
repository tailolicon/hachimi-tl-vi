    {
      "uid": "zhcn:fad23a0714e4c7084037d428",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这两位分别是好歌剧和名将怒涛。\n她们是前一个世代的赛马娘。",
      "source_fingerprint": "80c2486687384e955ba82efd9d94bafdbc371d3d6bb0a21871ac7cbe4d3061ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
