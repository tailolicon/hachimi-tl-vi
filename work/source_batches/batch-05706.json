    },
    {
      "uid": "zhcn:dbfd629658f67618c053c1ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好歌剧是言出必行的自恋狂。\n她已经在重赏比赛上得过优胜，\n也是经典赛的强力候补之一。",
      "source_fingerprint": "889903a76a421269608488387d68563936597a070452bffacc086351eb23f45e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1019/storytimeline_501019100.json",
      "json_path": [
