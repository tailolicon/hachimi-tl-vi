      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "推活就是要在远方才会萌生各种想像。\n这就是数码碳风格的隐密型情人节。",
      "source_fingerprint": "b6770b05b5d8a857a7c3851907f461894f6c36670715e574aa59cd0c72a41709",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
