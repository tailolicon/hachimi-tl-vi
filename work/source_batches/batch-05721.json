      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "名将怒涛",
      "source_fingerprint": "567703d9275812a37613cd54f05008f5fba9ac6c5086fcadc58481ab61c51fce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
