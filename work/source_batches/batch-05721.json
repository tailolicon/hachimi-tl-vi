      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:0f69b80799a288de4298de6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的建议会带来什么结果呢？\n我们终于等到了答案揭晓的日子。",
      "source_fingerprint": "a3399e4573d9a8187c437168796800b2d2ecc622ace20d6ca337a7d1a5ecc23c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
