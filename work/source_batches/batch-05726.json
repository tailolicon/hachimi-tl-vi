      "source_language": "zh-CN",
      "source_text": "与我相遇过的所有赛马娘……我要带上\n与大家的回忆！去跟霸王大人和怒涛对决！",
      "source_fingerprint": "1cf8b5e0549a50001be98386e49905b0885274d3021fca270cb7779033d4cd32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
