      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不愧是训练员！答得漂亮！\n哎呀，我身为你的同志也倍感骄傲呢！",
      "source_fingerprint": "ab9eecdb80669cc53235816ffb73d855b4cf775ac5944dd74657d4a785f428f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
