      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:b3a42257a9d9fee1a0ae62e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "试吃之后……发现里面的汤汁真的很美味，\n整体口感也很绵密，非常好吃。\n于是我们就这样三个人一起过年。",
      "source_fingerprint": "4c63c27c8446cbbf19d6b7fbac466ac070733c6b835e2f6469072ebff1c113bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
