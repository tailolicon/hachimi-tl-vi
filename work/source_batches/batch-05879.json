    },
    {
      "uid": "zhcn:903837cd862512f114073338",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你们就当作被骗，先吃看看吧。\n我本人特制的“无章鱼章鱼烧”！汤汁很赞喔！",
      "source_fingerprint": "a4e5842ff20253b50d22b23ae9eb81c5823bef97456de9f8cedadc3f6e83c9ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1021/storytimeline_501021101.json",
