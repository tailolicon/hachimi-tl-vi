      "source_language": "zh-CN",
      "source_text": "玉藻十字不屈服于痛苦和艰难，\n从不放弃寻找能够获胜的方法。",
      "source_fingerprint": "77406f82204313a3899bfdfa2c2d91fa2f9bd85b9f684812c41920790236632c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
