    {
      "uid": "zhcn:a174f378ada6d36505baf006",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定在闪耀系列赛期间引退。\n以拼死的决心特训。\n一场赌上性命的对决即将开始。",
      "source_fingerprint": "0fb3684983e6a9608aaba0e99e3d824118f66fd26e795944478b8a5c98dc4637",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1021/storytimeline_501021405.json",
      "json_path": [
        "text_block_list",
