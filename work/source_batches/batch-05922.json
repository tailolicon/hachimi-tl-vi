      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:326fb8a90a371638a0b7b079",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "未来的一切在一瞬之间",
      "source_fingerprint": "6cce5830c205c2f9ae1be496d37f32ce4e0d64e645635117466a5a7d9fd13c03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
