    },
    {
      "uid": "zhcn:bdd1cd55096f75157e21968a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽同时也将玉藻十字视为唯一的劲敌，\n告知玉藻十字自己将放弃经典三冠，\n以“天皇赏（秋）”为目标。",
      "source_fingerprint": "cf596e7430bafc7a3e7a620fe43d83d60ce420838df593c5b4cee4605ca0c06e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1021/storytimeline_501021404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:bcf81551fc3325a84af5b487",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被梦想选上的人",
      "source_fingerprint": "1c5b0757211c6a4699337dc8544d8ea061977f17f662163a8f78ce2e7c69f4d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1021/storytimeline_501021404.json",
