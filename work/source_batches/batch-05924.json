    },
    {
      "uid": "zhcn:ffc1a1e348ac5649d1b98d96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・闪电先取得胜利！",
      "source_fingerprint": "34d08ed2287eb63a3ddec55ee0e2a227e44a72111a4f1209adbac4581be79d74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
