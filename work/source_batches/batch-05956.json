    },
    {
      "uid": "zhcn:d11a28b31c8ee59c1a8fecad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美妙姿势不小心绊了自己一下。\r\n正当她的身子稍有摇晃之际——",
      "source_fingerprint": "d69f94545f8455a2325eabcbb78d07dca2a701e3394588020b3655a6ca1d19d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
