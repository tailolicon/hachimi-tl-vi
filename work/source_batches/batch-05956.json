      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:f4d467c0ed8a50f6bceae2b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美妙姿势",
      "source_fingerprint": "d1cb551351a68022b5153ce22910be53e5784043168e94eb897bec2ce3a0afb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
