    {
      "uid": "zhcn:ad6326e038b0bd19b7e74e72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "全力享受一番吧。尽情追逐梦想吧。\r\n留下无数美妙的回忆，然后——\r\n携着这一切，回到现实之中。",
      "source_fingerprint": "229e47875fde8f0e1c7d4b4895a7361aae6cc1a60eedb43de1491c62a0f9ef4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
