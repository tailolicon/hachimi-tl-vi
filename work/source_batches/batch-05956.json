    },
    {
      "uid": "zhcn:0cb7779cdd68ce237a593cc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "SP队长",
      "source_fingerprint": "929c1c910f077995e06a8a8a1bcd9eee754bbf82baf4ba6edb9f996b1978381f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022100.json",
      "json_path": [
        "text_block_list",
        18,
        "name"
      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:54eb42ef7231da370373b25e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您的身体有哪里不舒服吗？！\r\n……还是得进行一下检查才行！\r\n我马上安排，请稍等片刻。",
      "source_fingerprint": "2c2f5084e7717379e80b86b8a214b2c0ef00c2d7c10a0fedc01ff9803c3498f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022100.json",
