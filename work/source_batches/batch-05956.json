    {
      "uid": "zhcn:5630031aa6357c859ed5569f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只是绊了一跤罢了，无需担心。",
      "source_fingerprint": "a7bca69559a7c150a6e23db2c177500a46c510eb0d65ecdc56a1330832bdc387",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022100.json",
      "json_path": [
        "text_block_list",
