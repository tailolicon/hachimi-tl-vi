    {
      "uid": "zhcn:49e00ac5648871563a29016a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈……♪\r\n真舒服啊～！",
      "source_fingerprint": "4abeafbf04ab362b8afa48a9f02bf1f957b75678057ac329028eca9bcf72a7b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
