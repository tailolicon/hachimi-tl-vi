    },
    {
      "uid": "zhcn:3c30940d1d210f9247ffea6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员！\r\n快点啦快点♪",
      "source_fingerprint": "2e529dafc356a1f1df390168a5afdef626c04544f26382312e9b68c79e0b0ca2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
