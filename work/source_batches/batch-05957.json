        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:033c9be4548dff7161fdde79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与其他赛马娘不同，\r\n美妙姿势的三年便是她的全部。\r\n而我能为她做的事情就是……",
      "source_fingerprint": "28ee27f627986a185663eca4c9586be66d035b66b49966e4f08d3c6204a4c5ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022100.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:a83494cbc9d49ac077b01a8a",
