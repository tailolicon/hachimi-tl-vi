    {
      "uid": "zhcn:d7ec70161cde96f90fd2df9c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美妙姿势",
      "source_fingerprint": "d1cb551351a68022b5153ce22910be53e5784043168e94eb897bec2ce3a0afb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022108.json",
