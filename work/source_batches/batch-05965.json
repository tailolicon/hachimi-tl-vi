      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯，我知道。\r\n所以……",
      "source_fingerprint": "1302dca445066d4a8eae399754b4f9605677121dcf4a09c46d37ebb798eac142",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
