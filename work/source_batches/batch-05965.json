    },
    {
      "uid": "zhcn:dcea55b3975a32d452519fef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不想让她习惯于“孤身一人”。",
      "source_fingerprint": "c7ee0de47a86d0ccd4d9b42daa56d998a79eacab682f0b74d461d27518cdfadf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022108.json",
      "json_path": [
        "text_block_list",
