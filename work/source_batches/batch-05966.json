    },
    {
      "uid": "zhcn:aabea85e5f08bc62b8f357d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，作为闪耀・系列赛的支柱——",
      "source_fingerprint": "587ff28ce2d3b4252bcb5e388e8f3c71cf138950b5eca8bb8c50eeb4064fb0a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
