    {
      "uid": "zhcn:13908af1c72e59a43a087136",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "必须要对现实妥协、让自己的心妥协……\r\n我才能成为祖国的支柱。",
      "source_fingerprint": "f2b59f6a7e2046f657dda0fdc39da9e31fa093e3ff74239801ab44a2e1046c9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022108.json",
