    },
    {
      "uid": "zhcn:e23b30a61553fa094b2ac6fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "给世界，留下名为美妙姿势的震撼！",
      "source_fingerprint": "c0276db5f7985cabd5b440098f37a89878d80a09e9f5afcbc904bf192a7bc954",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
