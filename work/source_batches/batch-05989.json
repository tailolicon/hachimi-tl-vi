    },
    {
      "uid": "zhcn:ae4e0723333085cb9f1cdbe3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "去好好享受一番吧！",
      "source_fingerprint": "41d23413b9d550db620c4d1de95ed8c04490f3ebd729dc1509351e7576d85180",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
