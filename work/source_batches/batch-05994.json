      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:f0e80f2967f7bf32529f0fe1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这之后，比拼硬实力的比赛会接踵而至。\r\n首先打好基础，调整好状态参加比赛才行。\r\n习惯比赛的感觉——这就是之后的训练方针。",
      "source_fingerprint": "13d5bf2903c0ee00af4603c5bb30004ad82739ecae4f63b4cfcb052cf97d9a9f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
