    {
      "uid": "zhcn:9ce4521ced1396eeeb245c1e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为特殊原因，美妙姿势的训练，\r\n比起其他姑娘开始得更晚。",
      "source_fingerprint": "58414b612aee51bdbdfcb92356861a4c6d1c961c278dad7778fb1a38f28c804b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
