        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:d44a7defb3257bbb8d3e4f51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目標レースが有馬記念になった。",
      "source_fingerprint": "8f7209a84e0455855c1772eb8869cd25796a3080625cca5765387cf734e13922",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
