    },
    {
      "uid": "zhcn:a3059920b759075c486d8653",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本音を話し、スッキリできたと笑う\r\nファインモーション。だがトレーナーは、\r\nこのままでいいのかと迷う。",
      "source_fingerprint": "4cb46153fc0e3d112eceb40276426736cbd952a6a977ac2f8f18ba352a184270",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
