        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:3013665bc30f9227ccb62e1b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "楽しい時間が終わってしまうのが寂しい――\r\n夢のような時間が、本当に夢のように消え、\r\nみなに忘れられてしまうのが寂しい……と。",
      "source_fingerprint": "0c1200e5c1852cbdbacdffe7740b2dd6acdca274c26c481326dc4c597a3d45b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022430.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
