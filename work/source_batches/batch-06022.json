      "source_language": "zh-CN",
      "source_text": "——训练员！\r\n没事吧？你没受伤吧？",
      "source_fingerprint": "a4855766aae7feeaf0937511c90424fd3e847bf4e0882e961baa9f1f9fe52040",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
