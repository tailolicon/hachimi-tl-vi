      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "仿佛绝壁一般巍然耸立的作品，\r\n正屹立于大地之上——！！！",
      "source_fingerprint": "218d1a77599e8c2b8beba2bf5ff2b97a720e71b028650947e73a0ab7ca46a2ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
