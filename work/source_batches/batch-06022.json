      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:b3c8ce9a19aebde01bf85e43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这，这是……？！",
      "source_fingerprint": "f69fd79febd02f291faacae29c46fa50667f7d776686eae33b8bcbd80dbe84a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
