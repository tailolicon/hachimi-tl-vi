    },
    {
      "uid": "zhcn:6c7ebffa430298088d2b1559",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我好像被桌子腿给绊了下……\r\n但在我摔倒之前，\r\n美妙姿势一把将我抱入怀中……！",
      "source_fingerprint": "a6dc338a793cd93388e6f24b82ec5125c6d200d5eebfd87cb230a4d6d3496868",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022510.json",
