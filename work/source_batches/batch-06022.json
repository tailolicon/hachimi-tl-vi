    {
      "uid": "zhcn:34f7e68a7b023b266f0ea7d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知为何……\r\n我好像看见了她身后有什么东西——！",
      "source_fingerprint": "c409a188513481b09f43e503bc68a6bdb68d8492c5494c6cd42455a076d4a42f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
