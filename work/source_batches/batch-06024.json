    {
      "uid": "zhcn:e4b67b916181a32103aec2b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我丝毫不敢懈怠，并且时刻牢记——\r\n要拿出不会令祖国蒙羞的成绩。",
      "source_fingerprint": "b021cb50413f50a97e8ff75afd46052c0f81ce7c8f079c9076e95f3b96a0b5b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1022/storytimeline_501022513.json",
      "json_path": [
