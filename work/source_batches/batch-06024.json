    },
    {
      "uid": "zhcn:f69fdcf7978c9f1f0ed71837",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过也有声音说，\r\n您要是一味投身跑步的话，\r\n也会影响您处理公务的效率。",
      "source_fingerprint": "a6cbde25cf215317c6ab7a25f3fcec834e5158f0a56d0b787fdb3b91a23e80f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
