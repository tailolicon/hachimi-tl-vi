    },
    {
      "uid": "zhcn:515cfc8055a01b7bc8282f31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样啊，谢谢！\n我这就去请气槽同学教我做料理！",
      "source_fingerprint": "ba7fb9a87787389343619a37560fd144a136ee9cb22aa1a0d201f19c1c9d071a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
