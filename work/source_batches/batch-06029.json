      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:bb8487593201a354781623b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便奔跑于地球的两侧，\r\n亲情依旧将两位马娘紧紧联系在一起。\r\n有朝一日我也能目睹这场梦幻对决就好了……",
      "source_fingerprint": "c9042e486e24353ca57e0c635ad919c4064351a44799d8b9e5262907eaf4280f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
