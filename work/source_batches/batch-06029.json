        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:8d05056718ec617be7960d32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美妙姿势",
      "source_fingerprint": "d1cb551351a68022b5153ce22910be53e5784043168e94eb897bec2ce3a0afb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
