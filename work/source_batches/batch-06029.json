      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！\r\n也就是说，把我自己当作谢礼对吧？",
      "source_fingerprint": "fcd1b633759cc904187f02a724be9f2fba81f48baae54ec7fdf0dfacafd97b36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
