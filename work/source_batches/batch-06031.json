    },
    {
      "uid": "zhcn:c19e2a9a71fc301edf24cba3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "展现在我们面前的是——宛如要突破天际一般，\r\n堆着数量惊人的叉烧的酱油拉面……！",
      "source_fingerprint": "49e7f4055a5a2954e54229d33160e8013aff2a3b516b3c27ed20e37809f016d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
