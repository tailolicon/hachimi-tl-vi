      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（唰……啪嗒……\r\n………………………………）",
      "source_fingerprint": "c4f65e585ad1a2a3244f83e46c0d1c705e1dba7523e8bd9dded8b4926c59e5bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
