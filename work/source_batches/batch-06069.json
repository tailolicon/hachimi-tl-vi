        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:d1b2e70de0e1d6d75d369968",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要领先多少、\n在多前列的位置──\n才不会被她追上呢？",
      "source_fingerprint": "4264f90c4cd287e1d9ef7d503d77751dcfaf327ca6adc870ee3ac0ae4cc98a70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023113.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:7ed46576c1eb1e38dbaec604",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但考虑到琵琶晨光的潜力层面，\n我没有任何不安。",
      "source_fingerprint": "60ea403e6e63d7ba2cea3b39abe4cb6c8e00e4193469ddf306fec796095d6cd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
