    },
    {
      "uid": "zhcn:7a1c1c74d24377ce9b091f8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……假如成田白仁与琵琶晨光\n要互相较量的话。",
      "source_fingerprint": "789908715aee9f1dfb0c3d01d2e4d8a81c1b712f6dd06bd2a59bd297c782f385",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
