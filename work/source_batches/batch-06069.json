      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "划破喧嚣的是她惊人的尾段加速。\n赛道有一瞬间笼罩在寂静中。",
      "source_fingerprint": "d54f837f1760bdb72f041d90a6d2f8932e9e5e75fd25ee955b6c87ed24dae86c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
