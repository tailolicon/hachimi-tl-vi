    {
      "uid": "zhcn:a15bde7a85154eda56b0a8e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……今后是否也能\n继续看到这样的风景呢？",
      "source_fingerprint": "6a5039f26e6dfd6984753714c8196d8f643b70c6583ddd9744b571547d897dc2",
