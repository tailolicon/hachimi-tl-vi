      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唉，我也没资格说别人就是了。\n她的跑法很吸引人啊。",
      "source_fingerprint": "d6dd884c949188dbb80e91815788cadc11d65f3c7e66a5c04bff427ecbb9e265",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
