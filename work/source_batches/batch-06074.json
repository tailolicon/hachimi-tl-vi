      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……宝冢纪念时也活用这些资料吧）",
      "source_fingerprint": "8e543367d142597f1a4c9ad949c58eadc7eec4fd94c198cfabf26692c266e8d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
