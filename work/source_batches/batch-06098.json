    },
    {
      "uid": "zhcn:ee6d4a0257bffb5c017d9217",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光在记者会上宣言\n她将在“宝冢纪念”获胜，\n并且预言将与成田白仁进行姐妹对决。",
      "source_fingerprint": "01f0ca842cd9840a0516bf17190a6ef1b0f40426cd9804aae590befb12afd9e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023404.json",
      "json_path": [
