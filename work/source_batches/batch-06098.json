        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:0d413beff0a43831a986d6b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光将比之前更加受人瞩目。\n为了支持她，训练员努力分析\n对战的赛马娘们。",
      "source_fingerprint": "6a7fce68113ae298cc6478dafec0911eb36e987050a13fc99cf37d4c9bcf400c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:bc8a43ebafe33df0649858c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
