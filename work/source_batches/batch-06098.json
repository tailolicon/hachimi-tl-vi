      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与琵琶晨光的“夏季集训”开始了。\n就在这时──",
      "source_fingerprint": "e825f9937e6c538333d916be2ec9fddf9813fa73b553f388d3cd477586abd898",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
