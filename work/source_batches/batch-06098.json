    {
      "uid": "zhcn:0b203a6321fe2ee2698c64f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而德比的纪录影像中，\n可以看到“怪物”成田白仁\n以异常的速度不断成长的身影。",
      "source_fingerprint": "ef1a5013cff4aee81ba9d6cb9cf114c7ae6c73eeadb4a263ff56bdaeed0e6672",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:5b59f8535818e97bd6b714ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同侪效应",
      "source_fingerprint": "c2d283df5b6cab79b47be566cdcec6dd75fdcaf393a0bf1f07504177bbee01ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
