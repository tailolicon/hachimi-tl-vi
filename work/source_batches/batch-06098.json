    },
    {
      "uid": "zhcn:a4e09dd7a13aa5b5685e9626",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光要训练员早点休息后便回家了。\n但留在房间的训练员，\n一个人继续研究成田白仁。",
      "source_fingerprint": "9a99214cadc327c26f1a1ee828a04bd1c4faecec9c1bda488fc4d671dfc01825",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023405.json",
      "json_path": [
