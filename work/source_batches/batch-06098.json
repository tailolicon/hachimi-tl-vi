    },
    {
      "uid": "zhcn:42724585ade768d1c43ae033",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "像是事先约好了一样，\n胜利奖券与成田大进也出现了。",
      "source_fingerprint": "b20c5c57d7f5fc3a00ec0953f704ec4de1a67ada38ea48d5f071c46e6046e82e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
