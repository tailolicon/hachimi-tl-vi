      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:522397984266d462e2f9eecf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "越是清楚对手的强大，就越觉得着急，\n走投无路。甚至牺牲睡眠时间的训练员，\n疲劳早已经到达巅峰。",
      "source_fingerprint": "a5a9e65ebe68b3a481ac20dc5934cba0061c9df3c111c9db3c101815bb8baae8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
