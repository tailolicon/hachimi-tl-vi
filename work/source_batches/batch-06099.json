    {
      "uid": "zhcn:33838a5f288a19d08dd96a3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光反复分析着比赛视频。\n很明显地“妹妹”的身影烙印在她的脑海中。",
      "source_fingerprint": "d81a5995b2e6bd7bdd81b7f808783c92fc98610971269902ab5d3a40319c2581",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
