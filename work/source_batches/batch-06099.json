    {
      "uid": "zhcn:6844332f6f61956546340130",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最强姐妹对决的舞台\n“有马纪念”这天终于到来了。",
      "source_fingerprint": "63ce857d7739257c8f1b4d2bd5f7044988e328111e2e7e49e4616c310928d659",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
