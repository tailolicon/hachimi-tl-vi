      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:d959fa7d358890831dbd203e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "焦急的琵琶晨光为了让自己也抱持觉悟，\n提议进行高强度的训练，\n以避免在下次的目标“菊花赏”落败。",
      "source_fingerprint": "213fddccd15edb0168e5dfa277cf7401636313af926decd0db4da68276ee8533",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023424.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e71ffaf8f9e72021ee5a3bd3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本德比结束后・反映",
      "source_fingerprint": "a172113cc7da36a29bd9862368ca46e6d4c1b63877b9c6a6ebef329897e1a206",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023424.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:b2dbc444b4d35c480cd3a32d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光称霸了“菊花赏”。\n这是她首次不是为了“不败”，\n而是以“为了获胜的方程式”掌握荣耀。",
      "source_fingerprint": "9c441d55c6e1f68de9a75f07e68cee6a2c42b11ce28e0ec57e899908caeac586",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023425.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:41b6f467d3698b71f929ea89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光将感情完全表露，欣喜若狂。\n为要求再次对决而造访休息室的成田大进，\n惊讶地看着友人罕见的模样。",
      "source_fingerprint": "b0f1a8f592c11a5e6220bbc70d3e65d755907999655148f5bfc3da0f98d854bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023425.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:210f23fe2632e712ac1d120b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人约定下次在“天皇赏（春）”对决。\n琵琶晨光用开朗的表情\n宣言她会拿下胜利。",
      "source_fingerprint": "75b1198cfc20143cd5c9e094fcbbce2d19e9810e75f0bc8b396aa4af479c96a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023425.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:793a06b28e1bf493e52ab880",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花赏结束后・战吼",
      "source_fingerprint": "5ff587f8ee9f39f6939089aedcbb3f6dd60066da3db0e4e8c794145048efbae4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023425.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
