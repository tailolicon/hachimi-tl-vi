      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:d50f4305a25a7ff243ec80a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田大进与胜利奖券。\n两人会超越方程式，是因为她们具备\n自己欠缺的“为了变强的觉悟”吗？",
      "source_fingerprint": "e83525bcaf59e5566c8e192c52a809353750a93b99f6c824672a103cc1faceea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023424.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:b1637a56f1be22add099c828",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023424.json",
      "json_path": [
