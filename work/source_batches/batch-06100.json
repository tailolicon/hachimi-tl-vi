    },
    {
      "uid": "zhcn:1fb170cb7357979739bfcc95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛后，为了赞赏彼此的表现，\n成田大进与胜利奖券出现了。",
      "source_fingerprint": "7a806dc0188dd9d3de0266a2c9a000392959889cb6fd67f850e95f97863c4dc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023426.json",
