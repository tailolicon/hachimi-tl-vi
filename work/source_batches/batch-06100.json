    {
      "uid": "zhcn:1fcbcc12b4c104880a5d3dac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光宣誓下次一定会获胜。\n她的笑容比以前要爽朗许多。",
      "source_fingerprint": "7a837a2e29bcf197cc86a0d5c18cd5cc4332cc02fce0313201af05879a157729",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023426.json",
