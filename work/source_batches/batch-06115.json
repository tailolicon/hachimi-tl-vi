    {
      "uid": "zhcn:182877214aa3af9c19d00774",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的体力比想像中提升了许多啊！\n啊啊，多么令人开心的失算！！",
      "source_fingerprint": "a1844e03c27455f44cd9c70630c69cb05d53ba8b08e7c911d0a13accb88364be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023701.json",
      "json_path": [
