      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "充分休息！",
      "source_fingerprint": "257c5e29de65a9aabc6e4b90aee69cfd2694d3411fde0a16cdad213ef75805ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
