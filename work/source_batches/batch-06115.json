    {
      "uid": "zhcn:d78daf882c940b4a391d15ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最重要的是……\n我比闹钟早了10分钟起床！！",
      "source_fingerprint": "fb2bb42bd011fcb3530c0a020d04e13133d86bda2d88ff5974b08d497e75eadc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
