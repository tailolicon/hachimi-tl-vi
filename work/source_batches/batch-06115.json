    },
    {
      "uid": "zhcn:e1f5ecfe0e2738360c5c2670",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光就这样\n带着闪耀发亮的笑容前往校舍。",
      "source_fingerprint": "a96310aedf48b1faead3ab9698abf69065515eb184c2a725f9cb85b551ee53cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1023/storytimeline_501023701.json",
      "json_path": [
        "text_block_list",
