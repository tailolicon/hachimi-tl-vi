      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我与琵琶晨光外出，\n走了一阵子后──",
      "source_fingerprint": "4ff4f3ca4f3c6e1b3b924815d602394c42043cc19344c50cd382b8fe3da9f85b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
