    {
      "uid": "zhcn:2254caf0eb10fe091262d485",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我心想她简直就像个不动产业务一样──",
      "source_fingerprint": "b5b05712ceace9c98da865b2222271156b2de51ae957875c22d4d6c3a463f47a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
