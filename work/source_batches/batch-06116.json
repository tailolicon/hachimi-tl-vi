      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但琵琶晨光以她拥有的知识量和分析力，\n推荐了最适合的店给我。",
      "source_fingerprint": "56e3692c4cb8f205b65895b476dd05bea4b4a7ae789eb48cdb5d65a80d2116e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
