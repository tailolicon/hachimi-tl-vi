    {
      "uid": "zhcn:d2dd865e30072ee230eb337b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "摩耶重炮讲完这句话后，\n就朝卖冰淇淋的地方跑去了。",
      "source_fingerprint": "8b3b48577c61298d74515be233607db505beb3dd0dce3ad5bfa5607efce055d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
