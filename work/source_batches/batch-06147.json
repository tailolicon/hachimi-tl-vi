      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊哈哈，训练员，快点快点～！\n人家要紧急起飞了～☆",
      "source_fingerprint": "d3d169c71721cff500f7ab70cf2ff278a99e4bdfef7c422ad1eb7a31118a11f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
