    },
    {
      "uid": "zhcn:d792a8e7ac88dc2aeafea4d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原本是为了消除彼此的疲劳才来泡温泉，\n结果还是不出所料地跟在她后头跑──",
      "source_fingerprint": "a3aacd55380b3852a4b9ab2ac42cf9a5f24b28aeb7eac4ccc9e51cede86ae780",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
