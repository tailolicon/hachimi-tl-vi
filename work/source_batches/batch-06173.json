      "source_language": "zh-CN",
      "source_text": "“天皇赏（秋）”当天。",
      "source_fingerprint": "841d1ed4682f5eeee0c5fe0c734027f305b4241df60cdf8980ade5cf6d592029",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
