    {
      "uid": "zhcn:8fe977de49b3919bb54d8e68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "轻快地跑完“菊花赏”的摩耶重炮。\n持续关注她的乙名史记者\n前来进行采访。",
      "source_fingerprint": "b8b74cfde499421164ecebecb2259751614de540024940d1edaa083826edad2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
