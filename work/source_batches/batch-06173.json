      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:4917c8fc7ab8ffafefb5e023",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她对现实与想像间的落差感到困惑，\n完全丧失了在赛前有的活力。",
      "source_fingerprint": "77536107af0dc98b1a48629958ef7f53addf85325417869c99dba83aceebc809",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
