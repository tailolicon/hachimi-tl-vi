      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在她去比赛后，\n训练员──",
      "source_fingerprint": "cb9e96b2e4c920495cf10969299bf336f979234d1bb166f4d50900b17476356d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
