      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无法追过成田白仁，\n败下阵来的摩耶重炮。",
      "source_fingerprint": "a363be752fd16a007d7130ba28719fc86bcfac83a56b22f2acfe6ee7aac40849",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
