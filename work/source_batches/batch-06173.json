      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "得知了成田白仁在这场比赛之后，\n将针对“有马纪念”\n进入漫长的调整期。",
      "source_fingerprint": "839eb9c873f88392cf38463085e3402344ba0eb90aa5503f495c9b6c7f98dc68",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024412.json",
