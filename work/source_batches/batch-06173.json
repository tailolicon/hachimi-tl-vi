        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:311fee57a21eaa0e8a622c82",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "已经成长为让许多赛马娘都想要\n向她挑战那般“耀眼”存在的她，\n上场比赛了。",
      "source_fingerprint": "2809bbb492dcab1aa1e1684cf449ca180a1be3ccd9e3e5417535c387028fe06c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
