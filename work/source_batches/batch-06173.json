    },
    {
      "uid": "zhcn:e06208af057779cfb6bcacce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "摩耶重炮顺利地跑完了\n“出道战”。",
      "source_fingerprint": "9b3efc58c2d7c54763aa9aec46ebf2293c6e9bf88a8dff0bfe3f0b9623637edf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024416.json",
      "json_path": [
        "text_block_list",
