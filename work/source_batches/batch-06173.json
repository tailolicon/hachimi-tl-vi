      "source_language": "zh-CN",
      "source_text": "拿出全力后获胜的摩耶重炮。\n她打从心底享受和成田白仁的比赛，\n兴奋到停不下来。",
      "source_fingerprint": "37c8e112ce8873217b3103ec974350f1d9449967464f45750f851e00ff92b879",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
