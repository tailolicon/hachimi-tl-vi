    },
    {
      "uid": "zhcn:6e02ee33e37013343ec77bd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "摩耶重炮为了参加“有马纪念”，\n斗志比平常更加旺盛。",
      "source_fingerprint": "20a9675d454775822c5f1c3c1449462a73a672338df6f66b50e25d08ee33344c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024414.json",
      "json_path": [
