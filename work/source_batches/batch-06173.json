      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让成田白仁看看摩耶重炮的表现，\n菱亚马逊把她带到了赛场。",
      "source_fingerprint": "19d3b75bd746b61c11a7b6fc0dd58e12ac966f053ca5461f0a472ee386520414",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024413.json",
      "json_path": [
        "text_block_list",
        2,
