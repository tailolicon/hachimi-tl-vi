    },
    {
      "uid": "zhcn:e05696600c8cdaf95bfb4e75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "阪神大赏典结束后・驾驶杆还握在手中",
      "source_fingerprint": "fa3c879043e7593edb3a6347ad8c6193b8e84387b022e8bb1973484dd9a7f1da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
