      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e342bb11d981948519d121f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一直很向往闪耀系列赛的她，\n觉得所参加的竞赛比想像中还要无聊。",
      "source_fingerprint": "9f5df6a8e0b45a1ba798eac433242f2422dfc4cdbd07fb5154ae6e83574aace9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
