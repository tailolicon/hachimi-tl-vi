      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与成田白仁的决战之日，\n“有马纪念”的开赛日到了。",
      "source_fingerprint": "ca0ce93cd7c3524dcafc5cf1939627cc5c5a382d7daa10764e3b39185b2df4a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
