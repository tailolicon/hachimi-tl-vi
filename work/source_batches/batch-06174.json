    },
    {
      "uid": "zhcn:fac8bcb1804f70ff658e1d97",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很介意她在注视什么的摩耶重炮，\n为了得知答案，\n而想与她再战。",
      "source_fingerprint": "3d4c978624d9199c070c3b522eb1d8bef89e6d520bcc1b8b22a957a9ec1134c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
