    },
    {
      "uid": "zhcn:881ffd180f42f81f4f28167e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（春）结束后・紧急代码",
      "source_fingerprint": "4c29dc478403d7ce3649161ae9af0dd90beeaea38ddc207bf4c687b1c734f6ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024424.json",
      "json_path": [
        "title"
