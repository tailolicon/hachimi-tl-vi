        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:981eb5713255d8980d81d20b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很介意她在注视什么的摩耶重炮，\n为了得知答案，\n而想与她再战。",
      "source_fingerprint": "3d4c978624d9199c070c3b522eb1d8bef89e6d520bcc1b8b22a957a9ec1134c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024423.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:fcc29c3fbfa7c8b6b700e545",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，摩耶重炮听菱亚马逊说，\n成田白仁打算在“有马纪念”\n结束后引退──",
      "source_fingerprint": "ec08f8c826ca102f2b026283558ffba1de325bef10dee2ee2fedb3410b0d6bee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024423.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:9a809058cbdc071929379331",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "摩耶重炮发誓要成长为能让她感到兴奋的赛马娘。\n为此，要挑战强敌云集的\nGⅠ比赛“宝冢纪念”！",
      "source_fingerprint": "8a60636cc59143eb2fd3346c7cfadd3df81704c9ede61781701ac4daea775fe8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1024/storytimeline_501024423.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:37dda86719968561ca3c1e75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（春）结束后・紧急情况",
      "source_fingerprint": "5d35795257145c35e1932cbcedbc5c8e30bcf9132fd753cc931a07c476dfff60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
