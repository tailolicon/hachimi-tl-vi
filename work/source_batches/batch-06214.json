    },
    {
      "uid": "zhcn:de90ccae851825a5575879dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你找我有什么事吗？",
      "source_fingerprint": "6ed35bb70cf9d3a63c7dcccd27f730da75bad78dd9b0103395338c9e8fc450a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1025/storytimeline_501025100.json",
      "json_path": [
        "text_block_list",
