    },
    {
      "uid": "zhcn:7404be18b77c62cc1198dad4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，她──\n她就是──",
      "source_fingerprint": "30a4876e0ce3802278bc05fcb8fef8e925f50773f7e17265c828656d76237d60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1025/storytimeline_501025111.json",
      "json_path": [
        "text_block_list",
