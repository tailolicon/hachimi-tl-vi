    },
    {
      "uid": "zhcn:fd78efa4234d0863ae492b5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我仿佛听见……“种子”的声音。\n名为赛马娘种子的声音不断在耳边回绕……",
      "source_fingerprint": "5fbe0bee968b8ade559a51cb5a8708f031cab0ec4630fa172ee49ab80bca57f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1025/storytimeline_501025111.json",
      "json_path": [
        "text_block_list",
