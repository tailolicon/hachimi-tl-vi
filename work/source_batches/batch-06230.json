      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“追上朋友，并超越她”。",
      "source_fingerprint": "b26ee0ef206cd488838d1992836a878708f9349b5cabdea08b12cb04c3393405",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1025/storytimeline_501025116.json",
      "json_path": [
