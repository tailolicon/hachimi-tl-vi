    },
    {
      "uid": "zhcn:5c37163e189d2bedd32d91fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以今天──只能祈祷她平安无事了。",
      "source_fingerprint": "d641e53468bb8123aaafe571e146b8135dc7172464e505579902636607d7861f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
