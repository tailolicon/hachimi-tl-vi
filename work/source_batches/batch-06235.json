      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我盯着曼城茶座\n那异常严峻的表情。",
      "source_fingerprint": "75887567b3092df95267219b43eed3db93fdfdf05ca04425a75b71b0a9f63a21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
