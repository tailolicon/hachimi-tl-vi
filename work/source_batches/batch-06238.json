      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……搞清楚了一些事情",
      "source_fingerprint": "6120bd74f797a9a1d675f4a79c99f15cfb3019c6f87768cde3f7927674462215",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
