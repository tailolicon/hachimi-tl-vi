      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我将集训中了解到的事情向她坦白。\n包含“朋友”的一些举止。",
      "source_fingerprint": "6c29eaadf61a817eee691352ff36aef56aeca032899dcc194fa8d6e9b66c80c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
