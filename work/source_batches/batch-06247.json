      "source_language": "zh-CN",
      "source_text": "疯狂……\n原本可是我的个人专利呢。",
      "source_fingerprint": "57cd00e616e2b02b8b0090f0b6a10fcf332c0042d88e6ed55f6ae1474e00ac19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
