      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听到我的回答，\n曼城茶座露出了微笑。\n爱丽速子则是耸了耸肩。",
      "source_fingerprint": "6adc53ed8b23fde9cb586d9cd6e5a65316b786260bbaf395b61502004f7b5c4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
