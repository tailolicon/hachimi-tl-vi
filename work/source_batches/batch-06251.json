    {
      "uid": "zhcn:33d6173eb2fba9a591c12244",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而发生的各种现象已经无法纯粹地\n用身体虚弱来解释……简直跟怪异没两样。",
      "source_fingerprint": "5447a8cce5f012b43f2537b6762b7485c3da0002544f01d786d09af52b6bf9e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
