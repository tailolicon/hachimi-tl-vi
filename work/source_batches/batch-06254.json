    },
    {
      "uid": "zhcn:22abf927e43b21203db7de8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "照常理判断，下一场赛事\n应该会轮到春季大奖赛“宝冢纪念”。",
      "source_fingerprint": "cfb1fc2b001704a15d034f906d7c1b0a2071a47b425a5e58eca27645a167e455",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
