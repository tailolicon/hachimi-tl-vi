      "source_language": "zh-CN",
      "source_text": "她表示这是有史以来最接近“朋友”的一次，\n同时心中涌出了些许自信。",
      "source_fingerprint": "d1b4fb89d63bfa719277254cfe88e816da104541ca91d9b7d08a57c9a7e3ba7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
