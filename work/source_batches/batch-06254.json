    {
      "uid": "zhcn:d64c5aa263ba4db65fe77838",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，“朋友”则是更拉开了\n和曼城茶座的距离，跑得越来越远。",
      "source_fingerprint": "655edb05b9d7bbc96071ec07223ac0fcce893f6fa9db5231f7a3731bf5f784a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1025/storytimeline_501025424.json",
