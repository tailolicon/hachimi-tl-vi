    },
    {
      "uid": "zhcn:da0b81ce0948cfb2c9ebab7c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好歌剧称曼城茶座为\n“Leckermaul的伴侣”。\n这究竟代表什么意思呢……",
      "source_fingerprint": "1ff13e6ef803eccbcc83bbef573ffd5ff486951085497f5f3a99297f36669be1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
