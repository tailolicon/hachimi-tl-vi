      "source_path": "assets/story/data/50/1026/storytimeline_501026104.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:588c1ff52425c092796090ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为不忍心看她持续做勉强自己的训练，\n才建议她尝试以单圈时间为目标去奔跑。",
      "source_fingerprint": "b4c671d05534fbc7d806e66ee782b4a4afbac41aa4a53d5b593681d46d707fd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026104.json",
      "json_path": [
