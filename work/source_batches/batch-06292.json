      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以她天生快缩肌比较发达的强健体格来说，\n确实是更适合跑短距离。",
      "source_fingerprint": "34624438ae1c31a151f9826d1e4288b48fb5e87526984ad89920c93930bec1a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
