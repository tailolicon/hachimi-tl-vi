    },
    {
      "uid": "zhcn:c4fc285e4072ed547539d8d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁也在为了能够突破“菊花赏”\n3000米的难关而努力训练。",
      "source_fingerprint": "b18993855b95396946ef641137a296a683167d1563d8a38a549b3fcdf8e73ada",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
