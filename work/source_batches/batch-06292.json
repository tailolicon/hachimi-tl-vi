    },
    {
      "uid": "zhcn:5b6585cace4c069d78686063",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经她这么一说，\n让我想起相遇时确实有过这样的事。",
      "source_fingerprint": "eba973c4811372e3e47076b5abae37e0c2cae4788ee8a6d623b0ceee03ca9145",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
