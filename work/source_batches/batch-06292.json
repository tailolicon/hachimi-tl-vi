      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:47fefa21afca3c507f58bf3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "建议她注意单圈时间，\n也只是不忍心看她继续做勉强自己的训练。",
      "source_fingerprint": "75ec69f9624ea0b499c3b84131ae1767f2d06e1f0e097bf5ea90df5d26745efd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026104.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
