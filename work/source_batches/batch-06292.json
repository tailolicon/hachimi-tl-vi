    {
      "uid": "zhcn:32ba255c727c9614f7496b41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为你有效的建议，\n使我距离取得三冠更靠近一步。\n我很感谢你。",
      "source_fingerprint": "574fdc80c24ed418055d73e4ea0fae911d9f467be5aa763420601788cf17b8ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026104.json",
