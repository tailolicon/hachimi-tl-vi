      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这么说不太对",
      "source_fingerprint": "5b39808a39c171952ffdbe70eb85ce4f4a132bc08c3f97cf53e241729e45e796",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026104.json",
