      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是Master“信赖”着我，\n对我施行了有效的更新。",
      "source_fingerprint": "4c6947883c5a53026180a6b260f633e1116bfc6444dd9984cf60ce859fab9cb2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
