      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这么说不太对哦",
      "source_fingerprint": "38ae87c1be8605b6b74af099ae39a8d30ea374443134e056d3da0400ec8654ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
