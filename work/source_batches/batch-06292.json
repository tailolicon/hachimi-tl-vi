    {
      "uid": "zhcn:52531d851288a8c6f5d718f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……确认到状态正在转化为“喜悦”。",
      "source_fingerprint": "3260c2e953bc4f021d6059d6e12efb84828992b8720aa529973d11553061fcd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
