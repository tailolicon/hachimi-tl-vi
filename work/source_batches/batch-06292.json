      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:59f833d7bef70aa4fda534de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "坦白说，\n我也认为当时的她要跑长距离是很困难的。",
      "source_fingerprint": "a18a68f7f9f67b9a57fc114aa7710bf5e77709f3523648af8519306eeee49247",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026104.json",
      "json_path": [
        "text_block_list",
