    },
    {
      "uid": "zhcn:ed96e8785cff388255ccb41d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──那是我第一次\n带波旁去看“日本德比”时的票根。",
      "source_fingerprint": "28e183ffdbc922acbbdd18ddccabf5d11d0b4a1b20261da9d3c9149efb042361",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:3b4602762af7442aed24a548",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是很珍贵的纪念呢",
      "source_fingerprint": "de27d1fd5b9e74ba8b5d2e48daa2de34a52b45abe4937e0ec4e1b79119504ef0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
        29,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/29/choice_data_list/0"
    },
    {
      "uid": "zhcn:d998c3927278f01fb517b89d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "波旁的父亲",
      "source_fingerprint": "f2305406052b6df94b885256c1f049c435c2334025781db7d4e7eba0145879da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
