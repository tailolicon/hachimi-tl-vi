        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:39b6ba16c0630741c17b9e4e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁",
      "source_fingerprint": "d31aaadb85fb817a2c53dd55829df1a4c71dc82c8dd7c457754c51af5729ede3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
