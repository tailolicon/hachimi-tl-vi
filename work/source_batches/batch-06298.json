      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:4f35ee3c7a5f6919bd9a77c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之前有听波旁提起过，\n小时候是父亲带着她训练。",
      "source_fingerprint": "bf3690ab3cf2334dd31b2f273d1c64ca876ff9eaf0e7a0a461421b4c2ea85425",
