        "name"
      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:62b5775101088d0ef34e3396",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个──我不清楚。\n以前没看过。",
      "source_fingerprint": "45963141436d8bb2443fdbc17351f56bdaec70fd592ad947b5cc87f644883170",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:10e6788633778e8fbd25f174",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正当美浦波旁歪着头感到疑惑时，\n她的父亲端着茶走了进来。",
      "source_fingerprint": "95b045a797a84eb7130ac6a35c6eeebb5c08c345238d67105826241a0825385f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:9f32edeb94f22f91c7f1145f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "波旁的父亲",
      "source_fingerprint": "f2305406052b6df94b885256c1f049c435c2334025781db7d4e7eba0145879da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
