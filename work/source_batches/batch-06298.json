    {
      "uid": "zhcn:bb442d0acb7d5517c5faa5ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比对资料履历。\n那是我第一次得第一名时拍的照片。",
      "source_fingerprint": "c7c9248251736481bb535be509e12df86c0cce8c39622e1712e0fd7e2cd6d140",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
