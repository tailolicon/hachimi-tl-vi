    {
      "uid": "zhcn:881080b7ab6f3cffdb55c740",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听她那么说我也感到很高兴。\n我们从那天起就开始一起训练。",
      "source_fingerprint": "5abaedfeba1c5c283e4358e5ab67b24c272a0f3133dce6571b5ae6c5ec3aa015",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
