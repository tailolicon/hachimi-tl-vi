    },
    {
      "uid": "zhcn:06abfa759a2cbbeb0628583b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那一天，这孩子看完比赛，\n就突然说她想成为三冠赛马娘。",
      "source_fingerprint": "d4ef295d6528cc91b7e2235caf555b1aa5be3e8a8edd2ef75be509ef45f85253",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:241bdf2e917bda9369df12ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "波旁的父亲",
      "source_fingerprint": "f2305406052b6df94b885256c1f049c435c2334025781db7d4e7eba0145879da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
