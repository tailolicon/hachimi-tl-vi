      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Master能不能来我老家一趟呢？",
      "source_fingerprint": "44a6cb1917c94bc8c2d9c6f6f2b182bcdb52e68c4039992d4e4a169cc49a6e09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
