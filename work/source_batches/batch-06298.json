        "name"
      ],
      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:9c72b1406908490da3c82c8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想Master也很了解，\n她不是个会提出自己要求的孩子──",
      "source_fingerprint": "95ebd272366ccf77893ac2851daa2668da1fb8da641650df2e6be69ae4283a87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026111.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:f53337ee01291239db46ae3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "波旁的父亲",
      "source_fingerprint": "f2305406052b6df94b885256c1f049c435c2334025781db7d4e7eba0145879da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
