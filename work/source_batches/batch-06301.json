      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许能因此改变\n大家对美浦波旁的看法。",
      "source_fingerprint": "cec09db5bc5dc9dc642f95bc8f02b373b0c0df25c83e8e68f0217277cd20efa5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
