        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:d820af92cbc7758574ade831",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁的眼中，\n依旧倒映着东海帝王的背影。",
      "source_fingerprint": "dd06f64098b7453b5fc611759f63c4084016bac637e9e5600dbdb21d34e0981c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026116.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:07576fa233a61beab4246cb5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁",
      "source_fingerprint": "d31aaadb85fb817a2c53dd55829df1a4c71dc82c8dd7c457754c51af5729ede3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
