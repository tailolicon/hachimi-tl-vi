    },
    {
      "uid": "zhcn:c7d48612728f4581cd34c83e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "帝王她……\n拥有“勇气”。",
      "source_fingerprint": "420d17baa81ebc91d92440122b45712b303726bc02889383593f7797afb7bf2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026116.json",
      "json_path": [
        "text_block_list",
