    {
      "uid": "zhcn:8b3fa0916e2a66d6b38b476c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──原来“勇气”，\n是如此温暖且充满力量的呢。",
      "source_fingerprint": "e1c501eb24f748ac594e332074c6d48fa650c442d79da61fda2c20a635e8b90b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026116.json",
      "json_path": [
