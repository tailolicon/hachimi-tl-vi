    {
      "uid": "zhcn:5d71df939f8276522dda0ff6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我明白要想带给别人勇气，\n就必须拥有更强大的力量……！",
      "source_fingerprint": "9d2f392c598a1a9b64e030248d9308cf099412232330886ad97766ba031366da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026116.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:19e8f2aa5957c7ccb0a6cece",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美浦波旁",
      "source_fingerprint": "d31aaadb85fb817a2c53dd55829df1a4c71dc82c8dd7c457754c51af5729ede3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
