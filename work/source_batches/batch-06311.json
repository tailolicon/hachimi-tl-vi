      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身为目白家的赛马娘，\n这场比赛我说什么都不会输的。",
      "source_fingerprint": "c112c9711bda92a3a5c82e10b66b4ab7e3526a18afb9e054006c5bef1530fc22",
