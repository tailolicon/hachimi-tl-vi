      "source_language": "zh-CN",
      "source_text": "而东海帝王似乎正在努力准备回归。\n我们因为担心而前去关心──",
      "source_fingerprint": "eff72ecfca12cf386638fff12e7f41b645fc695181124d167971408cd5f2a7fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
