    },
    {
      "uid": "zhcn:9a5d0b7a79e772f290638e79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因她的支持度和实力而感到震撼……\n我们互相确认彼此是否依旧还有想赢的决心。",
      "source_fingerprint": "20ffa355ef78809b1090f1bf0b2d8667cbcda58f20a464197ebb77e02f681104",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026403.json",
      "json_path": [
