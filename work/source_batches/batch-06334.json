      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:3ea1c90d0fd738d5fc2252cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练要结束时，\n我收到有鸟撞破训练员室玻璃的消息……！",
      "source_fingerprint": "42a0bb235b6a1c7b49e756c62d1681afa762a0c6a5931a9bca9a671484a18482",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
