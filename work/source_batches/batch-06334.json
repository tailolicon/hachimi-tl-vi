      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（今天一定不会再失败了……！）",
      "source_fingerprint": "e8574f59a44251299b75266f913a5ced1ed1d20c2abb0c39fcbcbd6d86c9eb30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
