    },
    {
      "uid": "zhcn:98b515ded5a293ffd87583dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑外围两圈！",
      "source_fingerprint": "5e17da63262e34de02ba43b3f9f5b92f1461fdcf57624cd32480b46fed56d4bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026510.json",
      "json_path": [
        "text_block_list",
        28,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/28/choice_data_list/0"
    },
    {
      "uid": "zhcn:069745ba56fa1b28fc090cbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "做一套重训项目！",
      "source_fingerprint": "216ecf035490ac52d10c42caf43a22708b0e7f3babed0c1f3dc46643f0763460",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
