      ],
      "json_pointer": "/text_block_list/28/choice_data_list/1"
    },
    {
      "uid": "zhcn:8effd5afb495bfcc233cdd8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我简单扼要地向询问的美浦波旁说明原委，\n并指示剩余的训练内容。",
      "source_fingerprint": "7bd6acb619e57b3fbc03487c3a6a150bf64bc1976b108b52ffd6864059b7fc08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026510.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:8204fcb987c112af6573419a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "结束后做15分钟的缓和运动就可以回家了，\n我特别加上了这句──",
      "source_fingerprint": "53ce1b307f07c281b13d5b3bb60d442b0d5057cb120cb9ca6cd509a1f490314c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026510.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:f7a283ed49a277548071368a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确定听到美浦波旁的回应后，\n我便安心地赶去厕所。",
      "source_fingerprint": "0b38cec31e6ffe9e792946931a299740279785efa0371faa08f93286b8fbbf5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026510.json",
