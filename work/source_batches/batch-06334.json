      "source_language": "zh-CN",
      "source_text": "在本日早晨8点，委托相关人员来进行维护，\n直到刚刚总算能继续训练了。",
      "source_fingerprint": "fb75430350670823f4092952e741a481263d7269d426d3a984c61a8b5b52ba91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
