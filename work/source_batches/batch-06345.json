      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "了解。\n那么我们谁先当鬼呢？",
      "source_fingerprint": "a318b69ab187b5be40037c56ad12f72f38fd9ba5e7039827455acd0149cd0657",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
