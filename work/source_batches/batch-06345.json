    {
      "uid": "zhcn:74a83597703767c94c3b6744",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知为何，\n演变成我要和美浦波旁玩鬼抓人的局面。",
      "source_fingerprint": "3a1c6189dbdabd69944f04d6ef235919ac2aff52d1ff58558727c7221d20048a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
