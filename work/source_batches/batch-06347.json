    },
    {
      "uid": "zhcn:f552f453c187f08edfa44b0f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "波旁？",
      "source_fingerprint": "f3b6ab4068341bc2093834e5c153b0e2dff3ea5c99b230aa29829e0e128fdd05",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1026/storytimeline_501026703.json",
