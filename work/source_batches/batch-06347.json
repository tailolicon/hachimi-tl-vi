      "uid": "zhcn:0e2dfd613040c550d546a8c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽说我本来就打算由我来提出其他方法──",
      "source_fingerprint": "a3659c9197ab3de4429572f12c379c5d68ee9bddc3656d57bf27abe0de4aafac",
