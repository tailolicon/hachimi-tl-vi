    },
    {
      "uid": "zhcn:e1515bf9de20e4dd18085b2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是我自己没有及时阻止。\n我这么安慰美浦波旁后，\n她静静地看着我。",
      "source_fingerprint": "a45f750215195c56410ab91c9727291131a2e18fdcb52b7a02935c7dd28cb4bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
