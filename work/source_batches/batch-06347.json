    },
    {
      "uid": "zhcn:13d85e103d7567d5c7f9783e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我小心地拿起，\n本该是开机状态的智能手机\n却是黑画面的状态。",
      "source_fingerprint": "b4144b6ef495269c4359602dd5463578564fe8c714ce3ba786087653f0821125",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
