      "source_language": "zh-CN",
      "source_text": "我下次也会尽全力奔跑的！！\n跑得比谁都快，比谁都要畅快！！",
      "source_fingerprint": "daae0c56d8ca3fc0b5a38fd1b6861cca357e7fa21351692dcbf345e664a5fc55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
