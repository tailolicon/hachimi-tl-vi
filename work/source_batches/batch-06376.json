      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，还有恋爱！\n我也想谈恋爱，越快越好。",
      "source_fingerprint": "a89899cdc0c8b9738a48284c9b784ce81184acd678086698a000c6c9505d6ed0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
