      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:d646c1fbd83e1fbddba7786b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看来除了比赛以外……\n她还有其他梦想呢。",
      "source_fingerprint": "0bceaf561c69a016dc421986b017a872e328c7a32e3c1e8d0576043a43808e8a",
