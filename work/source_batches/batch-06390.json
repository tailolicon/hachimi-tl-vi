    },
    {
      "uid": "zhcn:4bcaa6fa8a0321a0faae0a85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对目白麦昆的信赖与恐惧让她全身颤抖。\n这是因为只有她清楚目白麦昆真正的实力。",
      "source_fingerprint": "c268014e18deb4ce5fbe1927eace1decaa81d837c54c3ded48116c2160e5673e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
