    {
      "uid": "zhcn:f2dc7886ee1ec1e873219249",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白赖恩",
      "source_fingerprint": "27f6e72e0c5efa49958dfacdc8da250e2490660afaa33a92ed97b52f06851b85",
