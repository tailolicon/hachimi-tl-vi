    {
      "uid": "zhcn:b4f23cf291e0603ee8fa5e6f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第三年）开始！",
      "source_fingerprint": "eef37080660583492caac78b957b8f144bbb2896156162385fc6034f5649e4df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1027/storytimeline_501027408.json",
      "json_path": [
