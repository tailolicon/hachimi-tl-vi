    {
      "uid": "zhcn:230fddab9782a0585b117467",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽",
      "source_fingerprint": "11eb326551def639a05cc8c2fabf151803cd99057ccfbaa0c6ba89756bb8c765",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1027/storytimeline_501027314.json",
