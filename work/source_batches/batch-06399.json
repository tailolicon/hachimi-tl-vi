    {
      "uid": "zhcn:1037926f8de818cab4068719",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我还想再和那位赛马娘比一次，\n不对，我还想和你培育的目白赖恩多比几次。",
      "source_fingerprint": "653f0bd91dea1326548b93244f8e752dadf4a1d06da561698eadadb01b79f02d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
