      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:3dfc44bcdf3be51ebfeab1fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好了，去优胜者区域吧。\n目白赖恩，今天的赢家──是你。",
      "source_fingerprint": "a3da1848ad4c5fb8a704adfa7ad1db9d390467f3ffbc11cff1106ca7898c6529",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1027/storytimeline_501027314.json",
      "json_path": [
        "text_block_list",
