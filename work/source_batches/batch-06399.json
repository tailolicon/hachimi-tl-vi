    {
      "uid": "zhcn:2bfdda7fbec3430e7eeda546",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗同学……",
      "source_fingerprint": "d373122b8b117d93975e6f9d75434490fcfa86f534275752553a85b1712f339e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
