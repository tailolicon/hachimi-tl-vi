    },
    {
      "uid": "zhcn:e421011e40ce19fb139046f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆纵使悔恨，\n依然赞扬获得胜利的目白赖恩。",
      "source_fingerprint": "c44b88dc5871074acc2260bc16d7f50c74ede8b5be86e4bb0ddc24896d25533e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1027/storytimeline_501027426.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
