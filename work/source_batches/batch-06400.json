      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后……\n立场对调的目白赖恩接受了目白麦昆的宣战。",
      "source_fingerprint": "3353ab48f7bee1d88b51ca235208e2aceb95cdd12fc5e26adfe1b49faec6d745",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
