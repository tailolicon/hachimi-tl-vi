      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:30de77ba98ebd3fb3eaf0a77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的下一个目标是决定春季中距离王者的──\n“宝冢纪念”。最近表现亮眼的她，\n有机会在粉丝投票中名列前茅！",
      "source_fingerprint": "5bc74c65238a00cf29c5795d4d77ae0d39bbe2da450006e74411c83a389796fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1027/storytimeline_501027426.json",
      "json_path": [
