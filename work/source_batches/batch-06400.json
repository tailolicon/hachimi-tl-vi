    },
    {
      "uid": "zhcn:ed8da627d7c4ad710ed815e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经典赛才过一半，\n秋季还有更加炽热的战斗等着目白赖恩。",
      "source_fingerprint": "eb307c0c771225352d597165d329cdcd73feea75c705e4aaae7102219824d9cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
