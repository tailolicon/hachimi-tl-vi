    },
    {
      "uid": "zhcn:106c8f8e08b93120b073b342",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是“相扑火锅”。",
      "source_fingerprint": "8ad1b62824b5414575e8d51949e261298036010bae25da3f6c5f8468492d5d3d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
