    },
    {
      "uid": "zhcn:73f8d48c9fd996208a6eac18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你虽然很优秀，但是！\n下次获胜的一定是我！",
      "source_fingerprint": "63096f5a7630daf63a3ddaf3615dbfe7287867098dba4a26b677bb38e6f45ea6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
