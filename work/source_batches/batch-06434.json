    {
      "uid": "zhcn:7e947a549f38741975cbcbca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "后方紧追不舍、紧追不舍，但无法追上──\n菱曙全力以赴，以第一名之姿抵达终点！",
      "source_fingerprint": "ed900da67aaff1732c6786f86240c53274bb468bc60754d71a911b917cf93896",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
