      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以希望你练出不会输给那种负荷的身体",
      "source_fingerprint": "73c7fefc6596f659e0c475b3bc460aaa34c6dfc0e8afbcdcbb4a43881d5dc39f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
