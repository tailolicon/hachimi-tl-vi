    {
      "uid": "zhcn:35bc3c77b1739268d6b9997e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是她和最重要的劲敌微光飞驹，\n一起为准备“短途马锦标”，\n开始了不断奔跑的日子！",
      "source_fingerprint": "fffccf3cc0370f112ecb11a66f222f67b95b111bad20f2fa38dd279d94152f33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1028/storytimeline_501028401.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:64664a35b031e287e058ecc5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "反差香辛料",
      "source_fingerprint": "314af2426546429794b8b1fc3a5e9b9bc9569572ff1ca8a67667ad5978c80247",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1028/storytimeline_501028401.json",
