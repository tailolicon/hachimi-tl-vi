    {
      "uid": "zhcn:fb1b8168ce46c200954b16dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "考虑到今后，训练员向她提议减轻体重，\n改为可降低脚部负担的赛跑风格。",
      "source_fingerprint": "6fb574702e096e6fdde2a248d600a31d5da535e42a241d46583a39917e1f5e3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1028/storytimeline_501028403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
