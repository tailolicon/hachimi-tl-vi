      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的相扑火锅",
      "source_fingerprint": "f60f2456b663679d9756acdcaf40a1fa5e6ef3691ddc5803b5c544da7da45c8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
