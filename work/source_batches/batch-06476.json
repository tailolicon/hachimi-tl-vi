    {
      "uid": "zhcn:1c4dc267b5a9f468e79b14e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们决定采取先以锻炼身体为重点的方针，\n挑战闪耀系列赛的日子\n就此展开！",
      "source_fingerprint": "dd54973355612b1458e87d84ad1373ea9c8ba112327885f3bae94e73f3256cdb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1028/storytimeline_501028400.json",
