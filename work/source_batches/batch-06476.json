      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:dfb30ae81937ee48df179fd3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看过比赛后，一定会对热血的对决感到满足！\n──她坚定如此地宣告。",
      "source_fingerprint": "ebd3d933bc3aa5dd3cf292e49afd24562695483d14fd9b682bf488e4d92c3cf5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1028/storytimeline_501028401.json",
      "json_path": [
