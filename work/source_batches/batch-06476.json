      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:c48f02888bcc5b557daa3ae7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "世人带着好奇的目光，把两人的对战\n视为可爱的反差搭档对决。\n但菱曙丝毫不在意！",
      "source_fingerprint": "cc26a9a06c0dfcffc0a11c71c98f7455a6989cb5e3c2054470cd13e8b0a1b424",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1028/storytimeline_501028401.json",
      "json_path": [
