    {
      "uid": "zhcn:7ae9061ece32be1cfc829024",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴前去拜托美浦波旁，\n要和她一起进行被称为“魔鬼”等级的训练。",
      "source_fingerprint": "7c727e10facd80f07500c8cfbb1b981eceb320ba315b7b85d2368e0c7bc19fc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030403.json",
      "json_path": [
