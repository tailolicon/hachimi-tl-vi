      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于来到了米浴参加\n“出道战”的日子。",
      "source_fingerprint": "9c5bbb34680a01b9f82e9abea52fd2659dedcf5437dec0a9733fd3c071ecbf34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
