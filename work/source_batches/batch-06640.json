    },
    {
      "uid": "zhcn:e3290b3d765e5dc20448cffd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这之后的某天，无论经历多么严苛的训练\n都从未受过伤的美浦波旁受伤了。",
      "source_fingerprint": "7b6b0a7f1f48a619b658211da1876046af5733a6a489d07a055042a3e2f976d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030402.json",
      "json_path": [
