    },
    {
      "uid": "zhcn:2e5bc7cb9234af8e6abac6e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030402.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:4459e4473171c36a311a91bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴觉得美浦波旁是因为\n将自己视为劲敌才会害她受伤，\n为此难过不已。",
      "source_fingerprint": "58b9178c9236ac3eae9dddac84355b0b99e8872871fba1636fe1bd5041edd3f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030402.json",
      "json_path": [
