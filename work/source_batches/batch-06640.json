    },
    {
      "uid": "zhcn:1d870b140b2cb448a7d0efaa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在那里看到了目白麦昆\n在大舞台上让观众们心醉的英姿。",
      "source_fingerprint": "b4445e01346ddcf74658bcd44aeecb9d3187cdf9e1cc42ccf32418a4758eab0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030401.json",
      "json_path": [
        "text_block_list",
        1,
