      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "万有一失",
      "source_fingerprint": "055f478b24a5765c3fbecd39caa4bb07bb4fc1ababb6fa91d3e2892ff43cce2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030404.json",
