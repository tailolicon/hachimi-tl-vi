      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "劲敌的不幸",
      "source_fingerprint": "20e1f9a3e875195cf0f5d6c092a4fe6dce95b07bd6704728802648ae5e75b9e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
