    },
    {
      "uid": "zhcn:586c82f62c6b3f4190455312",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "觉得自己总是为大家带来不幸的米浴，\n说她的梦想就是成为像这样的“蓝蔷薇”。",
      "source_fingerprint": "46faf380582cbdb544095ebf296349a78b7372d5098398ac1a845b69cca98aa1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a22b61ea52a5450d5753034f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于淀中盛开的花",
      "source_fingerprint": "209eb10ba1cf1f76fbacd138c63b8ea85cd1c675c7c050cda5fa18b0fbcf0889",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
