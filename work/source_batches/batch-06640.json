        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:b21b6ed50cce110aaa37d571",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因无法独自盛开",
      "source_fingerprint": "a6522679a84044dfb6aab8a9004a01e29f2107a1b5ca3f165cee042af3db2835",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:18504e2a2d441a6713fa074c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定下个目标是“宝冢纪念”的米浴，\n每天都非常努力训练，\n走在街上都能听到大家的“声援”。",
      "source_fingerprint": "97656abce575871a598b73d1d939b8ccfc7f0087875b2e48ca47c87111aaf9e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:91e530573a88750b5d7bd1f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "受到许多人支持的她，\n在粉丝投票中得到第一名的支持度，\n受邀参加阪神赛场的开幕典礼。",
      "source_fingerprint": "bb54ec710065a809dd806a09243d97e1d45d6a9ca63ae9fa2d0e6135f9caeabd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9e6057d78805e76a15f3cce0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴先去参加了彩排。\n不过因为会场发生意外，造成训练员受伤。",
      "source_fingerprint": "9709f95f67aa4435d888241f2ea4950bf1cdc97a0d02d5b92021ba893464c33d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:b464378dfe9b1e9668154cde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着，由于无法查明意外发生的原因，\n“宝冢纪念”面临无法顺利举办的窘境。",
      "source_fingerprint": "8e44dae60e71449b30528d387e3de13d018968a962e20be9dedbeaa1de8f7fc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
