    {
      "uid": "zhcn:a2edf4526956e4e30b683c91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面临第一次参赛，\n米浴倍感压力。",
      "source_fingerprint": "df946c1962d5faf8b8aed2a2f6d369c3eff966bade87c3da7fcf8fed11eea9db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
