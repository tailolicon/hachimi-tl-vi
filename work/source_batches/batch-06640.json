      "source_language": "zh-CN",
      "source_text": "以天皇赏（春）为目标的米浴，\n因为想要成为许多人的“蓝蔷薇”\n而勉强自己过度训练。",
      "source_fingerprint": "be3c2ece07c3beab476e3a6d0b0c61966e95f7b5eb7bb30b814e31951ef00fc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
