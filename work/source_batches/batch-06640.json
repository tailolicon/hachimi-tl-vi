      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后米浴才不安地吐露出自己的心声，\n说她不想让支持的人感到失望。",
      "source_fingerprint": "6caf201321db79b012a72a55b0cef8e92e3d330e7df8d5571a9be27a141ea840",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
