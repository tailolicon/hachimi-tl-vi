    },
    {
      "uid": "zhcn:ea0f1a9bb89ac949ca2010cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，知道不能总是害怕的她，\n努力鼓起勇气面对比赛。",
      "source_fingerprint": "6370dd03b80fc43c18c56240913e9627f1363879c811f66c1cdb0327dfc1c53e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
