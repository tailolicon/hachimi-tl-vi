      "source_language": "zh-CN",
      "source_text": "既然要以天皇赏（春）为目标，\n就必须出赛“日经赏”。",
      "source_fingerprint": "bd84d992fed579891cf3b00d2f9560bc63195d08f16116ac7fcee5222bbca28e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
