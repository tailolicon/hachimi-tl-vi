      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030401.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:38ae9826e364596c600af625",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴和樱花进王一起去观摩天皇赏（春）。",
      "source_fingerprint": "9ecd1a84d6c84ee3d40d5c3ef640909aec7187a50697c50e303596a047f5a383",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030401.json",
      "json_path": [
        "text_block_list",
