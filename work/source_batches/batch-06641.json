      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（春）结束后・在光芒之下",
      "source_fingerprint": "f509a79d4761b204ede33e505ed92463baa2cbfb79861d2e177fcb6507102083",
