      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6e3af38efc324b210a8af0a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，美浦波旁在这次的比赛中，\n也展现出不负“栗毛超特急”别称的表现，\n让观众为之沸腾。",
      "source_fingerprint": "b11a60166868bc15490d655dcbf44d321357900147395b3ec726c46da2612475",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030417.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:6f9e3544e883eda25586181b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了追上美浦波旁，\n不能够停下脚步。",
      "source_fingerprint": "22d8c038473d92c054844948fa0102406fa5d360f3d8e07518ded0d23d33c3d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
