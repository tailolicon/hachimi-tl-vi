      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:62b8aabd629444897f149474",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴将下一个目标订为“日本德比”，\n并开始着手进行准备。",
      "source_fingerprint": "fa122db1c378e83add19ca342a9fcb1a9754568f401e93954237c0dbd91a3fda",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030417.json",
