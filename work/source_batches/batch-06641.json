      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:826b7d1fb2f6bd8071348966",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了向支持自己的那些粉丝传达感谢之意，\n米浴踏上胜者舞台的舞台。",
      "source_fingerprint": "5b23e1ed0722194591750fa1655f70500009f0cbd3d9081af37f0628d1bd92d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030423.json",
      "json_path": [
