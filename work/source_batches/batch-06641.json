      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日经赏结束后・花瓣纷飞",
      "source_fingerprint": "ced6456cc95c843a1edcd836e6260e5aebbde2ec2aebde76521ff0bc99b1e803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
