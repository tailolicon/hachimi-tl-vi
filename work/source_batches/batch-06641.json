      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c1345d54ec53a353e4b9f02e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆鼓舞这样的她，\n邀请她一同前往胜者舞台。",
      "source_fingerprint": "d8f089a8ee28c0670209b47fe8f8a7778ff1f12d98ef42043dec3b21479f2f2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030423.json",
      "json_path": [
