    {
      "uid": "zhcn:c882e4ead05adb9816255b1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回想起过往粉丝们的笑容和欢呼声，\n米浴带着自信，\n决心勇敢迎战比赛。",
      "source_fingerprint": "1fe5337782bf8bf4d2252e2483f8a2fe912335c4b4f6176b3bf406ea9ab9f071",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030415.json",
