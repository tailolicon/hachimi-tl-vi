      "uid": "zhcn:4735bdc99b485aa3b6b32875",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在微笑的她面前翻开绘本。",
      "source_fingerprint": "02dbe8782755c23bd5f4fce4a94ebfda542ecb96dae60dfec645ef04acdaed64",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
