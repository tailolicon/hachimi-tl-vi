      "uid": "zhcn:889798ada1b6b969f81a5c86",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "姐姐……\n有件事想拜托你。",
      "source_fingerprint": "2016d2bc3ceb82954f30d2fb8629e92c1554edf7ec4c6ce82f7447198c167548",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
