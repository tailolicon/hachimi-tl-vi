    },
    {
      "uid": "zhcn:2a21320bdf323c6665d3fc58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "绘本上面没有文字，\n整本书从一片漆黑开始。",
      "source_fingerprint": "d3b4f521866551ee494d9bdf9167a9e1293a1d32b2dd0594e38f59199f00bbad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030704.json",
      "json_path": [
        "text_block_list",
