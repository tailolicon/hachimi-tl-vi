        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:38d8355dcaa2eda73dcbbde4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有某个黑色的物体蜷缩在黑暗的中心。\n外型感觉似曾相识──有点像是米浴。",
      "source_fingerprint": "cec4e99d438eb4baa29e60e53d8bd3eca7e46daf25355291ccd8777373476bb3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030704.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:16648dd62db059a3bfd13790",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个黑色物体在黑暗中流泪。\n好像很悲伤、很寂寞……",
      "source_fingerprint": "9b3d0711da4d816af40c2777675d8a12ac9a4b0c158de4b29b81d046b24d0c5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030704.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:bb197e2cdfac6967309130be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴",
      "source_fingerprint": "d99d52ed25db0eb937105063cfedfb65e5d199dc54c299f063e87411d9cb2f20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1030/storytimeline_501030704.json",
      "json_path": [
