      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黑色物体被太阳温暖的光照耀，\n取回了自己被黑暗遮掩的形体。",
      "source_fingerprint": "29c173e31eb1042d1b8772a2e3483e1b33532e7624ea8916bf1f89f40defe68a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
