      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着艾尼斯风神\n完成了我为她拟定的训练项目──",
      "source_fingerprint": "bd11aa778068350c9b20dedb6c376476303d6523379fbafbee569d7e3bb2672c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
