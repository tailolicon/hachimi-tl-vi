      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:a0f2b2067fb6567353a0a404",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你真的用尽了全力啊……！",
      "source_fingerprint": "2e599dba0070f005fca239e6125b6f0354fc85fe2025ab7cbd6a186e06763661",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
