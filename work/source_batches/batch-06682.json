      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要严格执行喔！",
      "source_fingerprint": "2557b3e2f116e69722ec3e146d1eef807eeece6a2573e0ebc96f24828773f873",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
