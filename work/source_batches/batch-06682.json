    {
      "uid": "zhcn:4a77780f28162befb7d9bf55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……赖恩。\n你在最后400米表现得非常好。\n我甚至一度怀疑自己觉得要输给你了呢。",
      "source_fingerprint": "56b2a11a6121fe627f88b614ed01987512b3e39797ff7e294c2f860d3ef80df5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
