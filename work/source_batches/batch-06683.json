      "uid": "zhcn:54c8af09f855bdae5372ccaf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呃，你是怎么啦！？\n怎么黑眼圈这么深啊！？",
      "source_fingerprint": "6b6444eb926727dd3852278ad326ae853b75e1b14472781ec572aff0eea68872",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
