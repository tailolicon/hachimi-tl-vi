      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我还没达到那种领域。\n我只是个刚站上起跑点的新人赛马娘而已。",
      "source_fingerprint": "c9407a06d9667c9788b521c1ab3bfc33f277b2f5da9571c3a736a9150c1aa515",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
