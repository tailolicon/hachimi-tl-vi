    },
    {
      "uid": "zhcn:cc20d0705b79ea853ddf4ea6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她臀腿的肌肉非常强壮。\n让她去健身房做五组棒式运动好了。\n总之先帮她安排锻炼体干的训练内容……",
      "source_fingerprint": "d8bc222b6df2cfc4dbdf517ff163976319b1439a1187f40157c64d5ac446b3b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
