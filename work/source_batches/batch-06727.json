      "source_language": "zh-CN",
      "source_text": "呜……呜、呜呜哇啊啊……！\n……呜啊啊啊啊……！！",
      "source_fingerprint": "7d004d0ca4fd8e3cd56885159485aedcbffe05873dad56de90a07ceacb8ced24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
