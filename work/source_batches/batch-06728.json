    {
      "uid": "zhcn:cb7800906f6719afe1cdadcc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼的父亲",
      "source_fingerprint": "ce03930dd9d133038885b00383ec6ddbdaf8619ef39a7a096b14e70d218702bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
