    {
      "uid": "zhcn:6e80b3b9c65ef6919beb21e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神",
      "source_fingerprint": "9dc9369440a9b696bdc605b98c8ab781a251bb4149a0083c969293a17093fbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031310.json",
