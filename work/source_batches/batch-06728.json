      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……所以你们在乎的就是\n“姐姐不放弃跑步这件事”\n对吗？",
      "source_fingerprint": "20486d6b0e91f2ce67df203b7aa1d332560702018f80210416daa6751baf3b7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031310.json",
      "json_path": [
