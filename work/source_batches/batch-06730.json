    {
      "uid": "zhcn:2ec6e445af2cc689a7678501",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神",
      "source_fingerprint": "9dc9369440a9b696bdc605b98c8ab781a251bb4149a0083c969293a17093fbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
