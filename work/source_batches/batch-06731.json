    },
    {
      "uid": "zhcn:dc00697c9ad64260ad7e6be3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以你们也不能放弃自己的梦想。\n……绝对不能放弃！！",
      "source_fingerprint": "8b45410067d8b6ab3108787ed12b4e28e7210eec7b5c9b7865ae8595e0fcb763",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
