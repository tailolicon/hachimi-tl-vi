    },
    {
      "uid": "zhcn:06449c13eee511268c14bb48",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……所以你们在乎的就是\n“姐姐不放弃跑步这件事”\n对吗？",
      "source_fingerprint": "20486d6b0e91f2ce67df203b7aa1d332560702018f80210416daa6751baf3b7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031312.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:de2ebf351ce73062d5cff81c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神",
      "source_fingerprint": "9dc9369440a9b696bdc605b98c8ab781a251bb4149a0083c969293a17093fbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031312.json",
      "json_path": [
