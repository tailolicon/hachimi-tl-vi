    },
    {
      "uid": "zhcn:fdf6ffc7170441b5a357b14b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我把艾尼斯风神抬到休息室。\n经过一些简易的检查，\n确认她身体没有大碍。",
      "source_fingerprint": "a3defa4906567fc968afc71b397c373bbff930561139728de813018f4b1adc1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031312.json",
      "json_path": [
