        28,
        "name"
      ],
      "json_pointer": "/text_block_list/28/name"
    },
    {
      "uid": "zhcn:5017128c61231df7860b1674",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那你们也不需要做家事。\n现在不是可以请人来帮忙做家事吗？\n我会去打工来负担这笔费用。",
      "source_fingerprint": "75c4cc00fd242f2f329c82a2c4ead90b1cbb8ab9d6c69aabb5db28a3a742d2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031312.json",
      "json_path": [
