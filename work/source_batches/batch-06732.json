        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:8673e035ea0a165444737060",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等到她哭完，稍微冷静之后，\n我们再一起思考接下来该怎么做。",
      "source_fingerprint": "12f15ae39c869f7cbeea6e2f3e172403aeb73c49d518e67258c30f765cb3c7fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
