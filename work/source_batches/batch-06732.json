      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神强忍已久的泪水\n终于从眼眶中滑落。",
      "source_fingerprint": "afd1d45dd00f1517a214d52128e0d2304d3a5aca1d52819ab4a19e872e377cf7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
