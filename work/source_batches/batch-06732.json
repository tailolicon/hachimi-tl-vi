    },
    {
      "uid": "zhcn:42770beb9db86b5bd8c44b28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她激动地放声大哭，\n我为了不让她更难过，\n一直静静地在一旁陪着她──",
      "source_fingerprint": "8852ad8bee97ef01b6959c7e13c4abbf4adfe5ca0aaee78c9c3cc20e1635f2d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
