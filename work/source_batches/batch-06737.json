      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就必须跑赢目白赖恩她们才行",
      "source_fingerprint": "7edd34cd09ef8f6c0d3072527f3f395a2a35b2507d064d3ce82e877701bedcd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031317.json",
