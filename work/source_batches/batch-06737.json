        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:b3568f6d32cf32d25ff4753c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们两个是目前赛马娘界中\n缺一不可的存在。",
      "source_fingerprint": "fb7e406cc7ee87d9d2baa14339a590b132eeeec782aceefb506e9f64b4bc3618",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031317.json",
      "json_path": [
