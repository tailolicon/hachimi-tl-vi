    },
    {
      "uid": "zhcn:010f3dbbf3f3acaa91164027",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那些人的想法\n一直都和我一样。",
      "source_fingerprint": "ffa93e2f296960cd1cfc8ecd8aa03e19edfcf310b9173a329fe99a25de1dbdab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
