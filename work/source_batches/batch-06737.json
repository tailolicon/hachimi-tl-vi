    },
    {
      "uid": "zhcn:216d21ecabc7c96df04a22a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一直以来目白赖恩和目白麦昆\n都受到相当高度的瞩目。",
      "source_fingerprint": "32749e8d98ba50b1d563b2b362ca2b6baf97329716e6d93f1436e0893a79a89f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
