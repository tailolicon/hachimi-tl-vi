    },
    {
      "uid": "zhcn:1a290a777523c89619b33564",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（都希望她能全力地享受跑步）",
      "source_fingerprint": "cb4968b836a43b80c4139306416fd1d10476ed9278304d031bb90457ac47787e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
