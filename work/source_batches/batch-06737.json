    {
      "uid": "zhcn:357b271da9d8281bcc1d95aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看着她抓着脸颊纳闷的样子，\n我回想起这一路走来\n她跟所有身边人的对话。",
      "source_fingerprint": "3c6173b2db8f77cbe4cbd66c60b5a1b8cf3d98c6e794ac41494e9eaa13df7862",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
