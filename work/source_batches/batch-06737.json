    },
    {
      "uid": "zhcn:6e24ebf11d2982f14256fe1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就必须跑赢目白赖恩她们才行呢",
      "source_fingerprint": "d11d32b4bd1f3d3d15d1bbc9cd8b996fcfdc6682192496b8c8125639f1209af3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
