    },
    {
      "uid": "zhcn:5226bd970957b274b356bb40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "人们则将情感与想法投注于\n赛马娘们奔跑的模样之上。",
      "source_fingerprint": "0d086b543af057907c47354baaca40a8a4d8236ac27cef616ab02fcfc30f1b67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031324.json",
      "json_path": [
