      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:e5d9a31b747b400f08bf8548",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而目白赖恩似乎打算\n前来观战“朝日杯FS”。\n艾尼斯风神也因为同伴的到来而更有干劲。",
      "source_fingerprint": "95b9ede9b0082d1acc6b6b69d7ba6d439cc95dc01ce9384b6b46531a0f9a4286",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031402.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:bf9c6f54700de6c56542aed1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为你加油",
