        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:d2fd63b225aa9a013b2ae652",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果训练的时间不够，\n那就由我来办法帮忙弥补。\n身为她的训练员，我要好好协助她！",
      "source_fingerprint": "034f76f6433af8b9fcb667a5f8440b02a3660d28f15efc950f881db4ba97897d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:93c8bf16443d4eef61e45a29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是她的日常",
      "source_fingerprint": "c5f1f849d41f9b9acf96133347d4f9c5d3ece4bf88942b2b6cb6ef173bc0c90a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031401.json",
