      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:f3336977394dd9b34b70274e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神打工的同事\n也为了全力努力的她加油打气。\n不只是我，大家都被她的努力打动。",
      "source_fingerprint": "fc34271b4ce2e1e756fac4d1b58654424cc5ef913eed4c8a9c8d2235a41da360",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031401.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0f27b3563d91886d95971a08",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031401.json",
      "json_path": [
