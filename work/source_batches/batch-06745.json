      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:0395818964b651ed2812189c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两者都是备受期待的赛马娘，\n然而看到艾尼斯风神卖力的模样后，\n目白赖恩的脸上露出了复杂的表情。",
      "source_fingerprint": "287f8637e80966f882790df58723fa2a137114e965f4bb689a0c075a94950943",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e52e909a759bdce8eba15e95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031402.json",
      "json_path": [
