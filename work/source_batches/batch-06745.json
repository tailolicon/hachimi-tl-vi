    },
    {
      "uid": "zhcn:29e3d8d12a57e7c1b295c71c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神做每件事都很卖力，\n平时在身边目睹其努力的同事，\n发自内心地由衷祝福她的梦想。",
      "source_fingerprint": "bcbf916c9d774491d9c077ab42afa6c05e5ea6fefa501e8d9dbc7488efb53df9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:7a5f69f6b0dcb19854a1bd90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
