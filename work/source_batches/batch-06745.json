        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:73271574173c7426ac80205a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "妹妹们用可爱的舞蹈为姐姐加油，\n为了不让她们失望，\n艾尼斯风神更鼓足了干劲！",
      "source_fingerprint": "439c992d4d98e50ffeda3f6b94f4699002b57a39802afbba3c3c096576e0e4ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031407.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:3a48ed7d134fa999971cf22c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛将会如何展开呢？\n另我雀跃不已的\n艾尼斯风神出道战即将开始……！",
      "source_fingerprint": "30a6cd3abc2c038b016d21d8ae5701ade106d7d6e713ddcaf34957251be9c3cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
