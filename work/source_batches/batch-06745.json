    },
    {
      "uid": "zhcn:a1741bf4df2d9888dc6c8b74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向皋月赏",
      "source_fingerprint": "83ff224a61598a6c666007568d7268968b6f324292cc2eee89e3b5acc428c30a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
