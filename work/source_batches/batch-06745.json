    {
      "uid": "zhcn:851613d7432a0b48eefb683f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "得知艾尼斯风神计划参加德比后，\n连不太了解赛跑世界的打工同事们\n都深感惊讶。",
      "source_fingerprint": "aaae498c064a1b3580ce21838133adbab9986d37e87415c9b3800412ea12a7e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:c47435fee8ef9b2870e92b44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
