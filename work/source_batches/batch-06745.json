        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:fea8de7251cebe0cbde4d88a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同时，被誉为名门希望的目白赖恩\n也受到了众多人的期待。\n并被视为最有希望称霸德比的选手。",
      "source_fingerprint": "3723f7ab4567295d462126f30b4c5d667b144b66a57e1e290aa30c391d6e2d31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a87af2289ef2de7016f1a537",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
