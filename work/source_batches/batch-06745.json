    {
      "uid": "zhcn:3451fb13416acd020558cfd4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练、学业、打工……\n每件事情她都丝毫不懈怠。\n面对梦想的第一步──出道战也是全力以赴。",
      "source_fingerprint": "36669ff63d7652c89b7d74c6d6a6e4f13637c5d96ca2d722fd50e06b5960030c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031401.json",
      "json_path": [
