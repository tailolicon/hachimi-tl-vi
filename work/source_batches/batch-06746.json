    {
      "uid": "zhcn:6abb6b52c68fc95b47ecce51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神为了家人\n持续打工寄钱回家。\n身为姐姐，她一非常努力。",
      "source_fingerprint": "4c360294dc884a7619be26af8380ab63ac65f459bf53814ce571b48084bc8054",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031413.json",
      "json_path": [
