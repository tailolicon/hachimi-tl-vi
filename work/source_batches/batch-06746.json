      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:5dd37e8981e9d82d14751e6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以两位妹妹……才会因此生她的气。\n希望姐姐不要擅自决定她们的梦想。\n因为她们现在只希望──姐姐能一直跑赢。",
      "source_fingerprint": "73027523752247fb963c7fe7d693ae8b517dc6f36b0bdbb49470eb36083254cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031412.json",
      "json_path": [
