      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:ee4c79531bfdb70dd1ded214",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向有马纪念",
