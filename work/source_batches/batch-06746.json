    },
    {
      "uid": "zhcn:1ae6e3c3e367f35f604cba89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031411.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:1d6f87b9cf541bb101f7734f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我协助一起解决后事情并无大碍……\n但她似乎深受打击。\n为了让她打起精神，我要尽全力为她加油。",
      "source_fingerprint": "16e03819baa3acfc61f030b0e875abf80a4d7f0804a964cd8d0f1dbe316e3307",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031411.json",
      "json_path": [
