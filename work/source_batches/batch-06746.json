      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:1878d203101a38cf9b3a2fda",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神打工的同事\n也对她的跑姿怀抱梦想。\n她在比赛的表现就是一直这么触动人心。",
      "source_fingerprint": "fbc1fc7749fa4218c297f53b9df55333ca644d234347074ab376f974f16b1ef1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031412.json",
      "json_path": [
