      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:af85802d855af67912991f14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神的心中不再有疑惑。\n今后也要一直快乐地奔跑下去。\n所有声援她的声音一定都会化为她的动力。",
      "source_fingerprint": "4b2b08b0288ad73faa4c59ad9a96160711dd28a4ac84210cc76333aa4fa995bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031441.json",
      "json_path": [
