      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:b3f0569550959aebcc59bb31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神在一旁目睹了一切。\n感受到自己和目白赖恩的差别，\n并开始认真思考自己该如何回应支持的声音。",
      "source_fingerprint": "8559a3a3074b2fd83ae4f8cad2dfb6154c9ac1dec0d61b15018aecf18558479b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031438.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:88dc939e620ad308233f1527",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031438.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:1e66d30b4d1c34f1565d389d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自己能变得像目白赖恩那样吗？\n为了确认这个答案，\n接着该努力为“宝冢纪念”做更多训练！",
      "source_fingerprint": "96d632a8778fd790d3b5abb9a669a77814a08484b1e333bfb96a938a847599e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031438.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:02cafc3e3fd0bd4ac7d55f9e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "背负名门荣耀的人们",
      "source_fingerprint": "639529973291693bd57e880049a0257f12145059d76c4a315160a4a11a118103",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031438.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a4421a29b8985d252286b06c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神在“宝冢纪念”和对手们\n尽情地享受激烈的竞争。\n赛场吹着舒服的风，让她还想要继续奔跑──",
      "source_fingerprint": "5bd7f5c601b1c3ec42a74480b714bd5c368075c2931011758d1e6db95764b484",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031439.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:4c3bea536e985d3cc96054d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她看见身旁的目白赖恩向观众敬礼，\n才急忙向声援自己的观众们表达感谢。\n并下定决心今后一定要好好回应大家的声音。",
      "source_fingerprint": "5f11555ceed79957f4a523372bb0eb677bc665a667eafcd5c7474bdb649e2d39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031439.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8bc36ba752ffe1ea8484732b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神希望下一场比赛\n也能让声援她的人看得开心。",
      "source_fingerprint": "4a70284e64c019315ff8c7d409cd787e814615fb3872c4081bc3e31462504bf5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031439.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:497a487108ff66b3a672c5f7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "粉丝一定也很希望能看见她\n尽情享受比赛的模样。\n她一定能在“天皇赏（秋）”跑得很开心！",
      "source_fingerprint": "9311e9da66a4cd44a082fe79f148c86fdd654cc3902b5c5950551f0e4d83bca4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031439.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:765399861bfb48b435975acc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・掌舵航行",
      "source_fingerprint": "bb25edea6d13137cce7328f4c62a195640ac7937b628767b8d684019ca3a2b0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031439.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:cec0c16e0d6e16948732adde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神带着大家的梦想\n冲过“天皇赏（秋）”的终点。\n她发自内心地享受比赛，并快乐地笑着。",
      "source_fingerprint": "362509036b98780499f784ba5b445c97f1afe529eb6d222d6691941fa0ddb4df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031440.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6c1170f41fb929a7e39778b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神的心中不再有疑惑。\n今后也要一直快乐地奔跑下去。\n所有声援她的声音一定都会化为她的动力。",
      "source_fingerprint": "4b2b08b0288ad73faa4c59ad9a96160711dd28a4ac84210cc76333aa4fa995bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031440.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a855db84c19d23b99e97bbbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“日本杯”",
      "source_fingerprint": "9707799bd1864f7cd7c190f139552185b1555ebfde81a1225ac868a422acf773",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031440.json",
      "json_path": [
