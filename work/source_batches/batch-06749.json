      "source_path": "assets/story/data/50/1031/storytimeline_501031440.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e3df651ffed82a9d962ec8f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "艾尼斯风神带着大家的梦想\n冲过“天皇赏（秋）”的终点。\n她发自内心地享受比赛，并快乐地笑着。",
      "source_fingerprint": "362509036b98780499f784ba5b445c97f1afe529eb6d222d6691941fa0ddb4df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
