        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c77a9da3015f70ee29de45d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一场比赛\n我也打算选最能让艾尼斯风神开心的赛事。",
      "source_fingerprint": "8cf48e33a685dc21ef1fd78c7f3f8c23f272c22fbe5e7fee5171437429a4f31f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031441.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:dc7c23967feee244c308c7f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "集结世界各地赛马娘的“日本杯”。\n我相信这场比赛里，\n她也会是世界第一享受比赛的选手！",
      "source_fingerprint": "84f5a3b7adff483f297258d66ce65bb717c6ee97cf032467b3641b011c4c7d67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
