        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:2e5482b111efbdeff0a4f9a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我正觉得这样很危险，\n此时那个赛马娘就这样一个没站稳──",
