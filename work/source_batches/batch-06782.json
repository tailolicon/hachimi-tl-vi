    },
    {
      "uid": "zhcn:6dc032c5fcd8afa8837c59de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天是第一天！我要跟爱丽速子一起\n讨论今后的动向，决定目标──",
      "source_fingerprint": "eb4703bc2eb9e2488e3efd12cba353b1759fbbba913e1a308174da810ed6a8d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
