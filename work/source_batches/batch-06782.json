      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:be032355fa4a182c19092f0f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她这么说着，再度替我戴上穿戴装置──",
      "source_fingerprint": "c8c71abe75fc7d23422ae4e05ce6a1c11193a08154f63185cecb89383636c03d",
