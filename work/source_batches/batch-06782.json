      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:f39be54d485cfda9a814e3df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本来应该是团结一致携手合作的\n闪耀系列赛挑战第一天──",
      "source_fingerprint": "82efc66b7e11e4e64e6367bc850462752e459e0e22b950b48c8665dd400b4008",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:6a8e6cc331620647474a9d4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "果然最后又被爱丽速子的步调给牵着鼻子走了。",
      "source_fingerprint": "8d8e17bdd433e3cf5172efc30159d85b0686cc541f27bc3e05d4d650266d1f7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:aed610efc1f0baf20de8ed59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔哇！？",
      "source_fingerprint": "5a0d791ab74893afe99a1e02928b4e17aa608e8354452fd1c3d47bd776bfcf8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
