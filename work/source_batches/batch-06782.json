    },
    {
      "uid": "zhcn:822a22b4917363f60b6261f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和爱丽速子\n终于要开始挑战闪耀系列赛了！",
      "source_fingerprint": "f67e6745df357eac4d8cb17f24a12d536494aaea7f86c9e15297b40a2ad1a035",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
