      ],
      "json_pointer": "/text_block_list/16/choice_data_list/0"
    },
    {
      "uid": "zhcn:5062b4d1f953a516253265db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等我回过神来时，我已经在起跑位置上了。",
      "source_fingerprint": "20e0ca7ef2c4f86cc528fa5a0b61028ce932e5cb63b0f87ef31f234018f0b197",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:561da8bb9b85f9a977a86d8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
