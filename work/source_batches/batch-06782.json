        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:2f4a38f8bc87489b56557e4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想将赛马娘的身体机能还有大脑潜能\n两者的差异化为数据，运用在未知的技术上。\n这次就是要进行这种测试。",
      "source_fingerprint": "dcae503729e170587be41d484a9cd357a2dbdc186d34487dedd4f669446d6dc4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:e5d7958b349c5b0337818b28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "！？",
      "source_fingerprint": "06e4166c9a86b4b55ea76af145d693083ff857e6e8d1132d63ba4f3379f978ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
