    {
      "uid": "zhcn:930013ed5b7965d82defa32c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Grand Live，开幕！",
      "source_fingerprint": "49bbf450b81c0e51f9d625b22ff8fedbbadfa48dd24fa85de0552023fab2a294",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1031/storytimeline_501031901.json",
