    },
    {
      "uid": "zhcn:26ca87dad5902e169a122cd0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好啦，这可是值得纪念的\n挑战闪耀系列赛第一天！铆足全力上吧！",
      "source_fingerprint": "abdc7108541cd1ba12a5c9dd14638cbe1db5dab1af6a119023ee708d295af185",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
