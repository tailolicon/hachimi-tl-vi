    {
      "uid": "zhcn:39a4d9dddf14a3714495b18a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是说，请你在虚拟现实里\n跟我一起并跑练习。感觉很有趣吧？",
      "source_fingerprint": "36bce8db4b7d3d1d04ccf814aa0841e4344d31476a89a1a2876a34f7142a9806",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
