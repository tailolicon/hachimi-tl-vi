    {
      "uid": "zhcn:60f6baa357caffb54c379988",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──越厉害的运动选手，\n他们大脑潜能的各项机能就越优秀。\n这对赛马娘而言也是一样。",
      "source_fingerprint": "fe2a4650de0e20d069dc75ef74f99a9912cd945dc967fd4779b074e63e2d1d94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:19b772c1916afae7eff4910b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
