    {
      "uid": "zhcn:d5fbd5d7ba5331b00552147b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隔天。",
      "source_fingerprint": "5ff05b1753d2ad99d596848c62dda099456f368750b09a084f9689d5e4702245",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
