        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:c24225f629f73c24870ed9fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
