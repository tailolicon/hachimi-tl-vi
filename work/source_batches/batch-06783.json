    },
    {
      "uid": "zhcn:4ad756a55c613e10d4783ee0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喂喂，别做这么不解风情的事！\n这对我的研究者人生而言\n可是十分重要的实验哦！",
      "source_fingerprint": "7e9a5aac69a124eef9ddd449bbf2ba4414e7d3ea734e4af832603d1c7b1d4181",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
