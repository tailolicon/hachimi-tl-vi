      "json_pointer": "/text_block_list/33/choice_data_list/0"
    },
    {
      "uid": "zhcn:b034903343a52a586b8bbe6a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的背影毫不留情地渐渐远去。\n就算我拼命想追上，也完全无法缩短距离。",
      "source_fingerprint": "7da4ab848bc74d9363929eec906e0749e93c953f68dc8ac565faa0c5bed59c07",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
