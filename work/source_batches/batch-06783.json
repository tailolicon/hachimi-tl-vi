    },
    {
      "uid": "zhcn:76c97aba8afa41878f5ae138",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "据说赛马娘的最高时速可达到70公里，\n这速度实在太惊人了！",
      "source_fingerprint": "d2f06af7c453d63160c4d80a62682c4911060af031272a901431e40cee3bb5c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
