    },
    {
      "uid": "zhcn:d682f3359d1735a0aa3716d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（想用人类的身体跟上是绝对不可能的！）",
      "source_fingerprint": "628bfcf9fcdfd43b7e08aa2caefcbfcd5472701db91e2741fc62f267a716e96a",
