    },
    {
      "uid": "zhcn:c2376040f8d0816abcaae9a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高速流动的光线、声音、颜色……\n心跳、空气、尘土……！",
      "source_fingerprint": "cb6776274802c7a43a1801a9ee92c5e6c43cf2217bb64756d27d8ec4796111cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
