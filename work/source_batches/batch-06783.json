        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:2fe07bf15a005730a9795609",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──当我还在感动时，\n本来还跑在前面不远处的她\n一下子就拉开了距离。",
      "source_fingerprint": "5fc89a528e30410f005f1673566264f80a0c221dcd55e8b30f6883935ec50aaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:599da0071e967004246fe5dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（好、好快！明明都是赛马娘！）",
      "source_fingerprint": "6554d4a97598a3dd58a29fb8bdb98ced217af59484283e2cdd71bd8fb7d6eb30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032100.json",
