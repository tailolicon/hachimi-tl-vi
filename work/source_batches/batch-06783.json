    {
      "uid": "zhcn:381ccf29576071c33f089dd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（你果然很厉害……！）",
      "source_fingerprint": "fb170c8be32c59ef4ce780e208bc2296d041a1d4e804195781bc62b6b0fa16b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
