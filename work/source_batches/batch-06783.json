    },
    {
      "uid": "zhcn:91342c2b240a577c8c115d00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就如同她所说的，严重的晕眩感\n导致我根本无法离开房间──",
      "source_fingerprint": "e19249819b0801e94c77347e90ee9312a2300c92aadfe8920f4bf8bef45375b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
