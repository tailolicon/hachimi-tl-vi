    {
      "uid": "zhcn:f367e558fc581117c36fb25e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然是个只对研究有兴趣的问题人物，\n但她的才能果然跟其他人有所区隔。",
      "source_fingerprint": "d92a16f286a51406e46db012c35d283767415d9a2e1bb493e26cd60e711a4604",
