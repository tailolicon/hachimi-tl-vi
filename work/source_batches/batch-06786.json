      "source_language": "zh-CN",
      "source_text": "身为一名训练员，你是否知道因为\n她取消参赛而引发了一连串的问题呢？",
      "source_fingerprint": "ec98e5736cc58a7132231e15880c3677fc5d93d58db3ab511ab5d63fe39f4d58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
