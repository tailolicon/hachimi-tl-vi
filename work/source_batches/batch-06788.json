      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然针对过去态度随便的她，\n批评和攻击言论相当严重──",
      "source_fingerprint": "6e032f067acf5003be62463146230a748d1afce124bc0f14ee0ea1fa01a9e71e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
