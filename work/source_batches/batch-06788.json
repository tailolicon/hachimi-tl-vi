      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隔天，她正式宣布要参加“菊花赏”。",
      "source_fingerprint": "ad5dd6331598ca3c2bcb3906272f2d88e14e67e988ad9241e7e1b120b765420f",
