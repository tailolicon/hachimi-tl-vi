      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她勾起嘴角这么说道。",
      "source_fingerprint": "721b2459435720ed2b0c94a30ba4f7619c8b91e677bbdb1ad75d227f16e8c61a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
