      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──总而言之，感谢祭的经验对她来说\n似乎是个不错的剌激。",
      "source_fingerprint": "f4e31711ece98e117c773e108a2c58cf1b9477bb38dc52af0f3228bcea272404",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
