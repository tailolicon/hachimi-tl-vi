      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子竟然反过来安慰我。",
      "source_fingerprint": "dd46ed9eab0da6d5c22dcd7d57ce0defefe64be9b6990c57eca34903f9f8f858",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
