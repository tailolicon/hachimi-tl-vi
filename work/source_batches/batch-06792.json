    {
      "uid": "zhcn:743ff94765c39c6d12e43485",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实我最近对“狂热”和“热情”\n所产生的力量非常有兴趣。",
      "source_fingerprint": "8276254bc53a47999398e1d86165ecc6d4178aabae0de923cb8f19d5184f3978",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032110.json",
      "json_path": [
