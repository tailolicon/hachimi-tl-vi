    },
    {
      "uid": "zhcn:a3d2d067653e78653054e71f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总觉得她好像在这之前\n也讲过同样的话──",
      "source_fingerprint": "4eace51dbbd14292696ffc86f753356801db47bb2ed567a511b646b33ef64ef4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
