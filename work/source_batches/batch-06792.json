      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本来还以为只是一时兴起，\n看来也不是那么一回事。",
      "source_fingerprint": "4175cd73b354726e1404886da74eb31e0884143740220d0bd4598ce1666a4b8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
