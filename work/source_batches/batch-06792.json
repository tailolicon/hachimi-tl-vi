    },
    {
      "uid": "zhcn:79b2f8646c999c04ac56b734",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "埋在土里的东西──\n我努力地思考着。",
      "source_fingerprint": "0efdb163e3236dcc3c58740d6d75f75fbfeddf177c6ff40eaa0f7e6a0e593cca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
