    },
    {
      "uid": "zhcn:e1721e4f5f210910b0df1844",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我们还沉浸于跨过这个重大阶段的余韵中时，\n在某天发生了一件事。",
      "source_fingerprint": "4b8905d70f5e9875d7d1ef0ad118515c990d8b38b7e903a246d7e1dae239aebc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
