    {
      "uid": "zhcn:3be97698b23846b913f23248",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为爱丽速子说想做心理测试，\n而来到了训练员室。",
      "source_fingerprint": "0856c8c7256de486bf0a4022594ff3cba846d2c3157882c113d9b8715cdab87f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
