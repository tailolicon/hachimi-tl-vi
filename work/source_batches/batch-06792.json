    },
    {
      "uid": "zhcn:fcdeae8e9ff5979789d84a80",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──无论如何，\n我与爱丽速子一同前进的日子\n又再次开始了。",
      "source_fingerprint": "a4a98bc1e41c9c6060ec000bc30765a3db85ba4a1eb2051bf1c9451be974668f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
