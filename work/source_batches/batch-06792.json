    {
      "uid": "zhcn:2ab4da97e68e437b4c2e09e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这之后，一直到天黑为止，\n我都在陪她进行心理测验。",
      "source_fingerprint": "4befd23b3b5b6a540274adba20b26e42a0530610788e5af7f8306e8ba5099f89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032110.json",
      "json_path": [
        "text_block_list",
