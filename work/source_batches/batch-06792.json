    {
      "uid": "zhcn:3f2393af190b63ef677bef3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……虽然不知道她在打什么主意，\n但除了一起做之外大概也没有其他选择了。",
      "source_fingerprint": "37458d9cf096fc71c4aaf7fd9a3491202ee2393e0596987bb0a9e9be83eaa950",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032110.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:83bc6d130d0d4e885b179145",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……根茎类蔬菜？",
