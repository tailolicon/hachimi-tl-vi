      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说到这里，她突然停了下来。",
      "source_fingerprint": "e685e56a7e7172dde0aa907836831e73d512c7c9827aaff8a50d0a8cfa451512",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
