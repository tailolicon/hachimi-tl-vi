    },
    {
      "uid": "zhcn:ca8ab350ff4e8a3b942bd985",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回想起来，她其实在满久之前\n就对“情感”表现出兴趣了。",
      "source_fingerprint": "c9c130607b1f6434fa719204311ac90d97c27c06fffe0278daa8df1c6456004e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032110.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:581d09d19783b1614a791bb0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为什么这么感兴趣呢？",
      "source_fingerprint": "eb080866a53ffcc1611f279d6accba04e7da848a70706055b9d9bea6bf0f22e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
