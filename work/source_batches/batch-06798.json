    {
      "uid": "zhcn:181b40ee2c5e9251cfdd48bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们姑且展开了以参加“日本德比”\n为目标的日子……",
      "source_fingerprint": "c9b203dfb56179774b1513e6c41db77cd46a2eaa24aa821191167e1e402bf999",
