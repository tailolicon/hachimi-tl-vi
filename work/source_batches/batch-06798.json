    {
      "uid": "zhcn:594264acfab2b1b8df1084ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“皋月赏”刚结束时，曾经说过\n不能保证会参加“日本德比”的她──",
      "source_fingerprint": "bc5149a47a443b62e6475ccb575576dfc7aa9dd31cc51e36ae7209d7c6725d6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032114.json",
      "json_path": [
