      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a8c15012d4e51fe0c565c386",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论如何，她积极参加训练这点\n还是令人高兴的。",
      "source_fingerprint": "cadcfc932f54442e4a2dbb0232243aabcaa1fd16a1774601a1f1b19ca2d0b4e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
