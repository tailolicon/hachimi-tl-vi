      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……对了！）",
      "source_fingerprint": "a30c8ad2050440bcc1b5bf0b0e7c27355430a81ff25959cc44e37bfae638ba55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
