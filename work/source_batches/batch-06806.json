    },
    {
      "uid": "zhcn:670417182cf9041021ada1bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看得出两位深厚的情谊呢，\n最后请各位热情鼓掌──",
      "source_fingerprint": "d8ec225c39e7bb9b13a69f1cdeadea7f4146370eb7220d608baae6c56ef071fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:13e394083e91ef4deafcc0c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（最重要的事？）",
      "source_fingerprint": "12322aa86ab08a5628ff992afcad5c10f4a60ce78db4fa658972f9fdf11c3343",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
