    },
    {
      "uid": "zhcn:1007ae06825b0590ddbc1753",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢您热血的发言！\n这下子责任重大呢，速子小姐。",
      "source_fingerprint": "a2bd5264d2398a9a13f29278fc9899ca105ca2254cd25817f6a76eb4de74d787",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
