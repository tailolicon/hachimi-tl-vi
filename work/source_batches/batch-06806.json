    {
      "uid": "zhcn:f8cec61cdce961f5d6859d16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯！务必让我好好观察\n你们扁桃腺的活动。",
      "source_fingerprint": "08ea0bc542e0eea40f522c960e9ee2cd149fb3e68c7db09ac4e96a65686ff77a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
