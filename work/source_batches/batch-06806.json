    },
    {
      "uid": "zhcn:c22cfd857dd9e87b41c80936",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯，那当然。我会负起责任\n带你跑向尽头，包在我身上吧。",
      "source_fingerprint": "4c543c94b83d595bb5ac15fd4796d74a564d5c7f1834e20ed53c91ea84e77369",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:3a914650763ad404cc32d309",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（哇……！）",
      "source_fingerprint": "c32030ba956fc423626f96ef018f3c09b5d8f3654c3d2e74b6c3e802d7cbd3da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
        "text_block_list",
