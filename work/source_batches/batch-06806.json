    },
    {
      "uid": "zhcn:8677c6479ebd1e50f721c0da",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
