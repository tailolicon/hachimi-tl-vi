    },
    {
      "uid": "zhcn:20fc8af0076152386be1bd69",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦哦哦……！\n真令人期待您今后的表现！",
      "source_fingerprint": "096028046d476b038071b5ecb4ae2abeba1d2b9e1a12a221feea3856f9900f2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
        "text_block_list",
        13,
