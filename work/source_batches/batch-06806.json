    },
    {
      "uid": "zhcn:414e9be522075f1a88bd7a33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "记者",
      "source_fingerprint": "5df8707c1e58ee5d8836124ac09bb9fc6923ff9a226b467e350aea00a8270f67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032119.json",
      "json_path": [
