      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "应该说，该进行的探索研究、开发研究，\n以及该挑战的竞赛堆积如山，\n远比以往更多！",
      "source_fingerprint": "531d66bcec11b83dca417766f04ba93db50bef71f9abe991c795fc6cea7e266a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
