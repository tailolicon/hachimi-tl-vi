      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:6321c576f831a411a5dfeb3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子",
      "source_fingerprint": "a7941ccee327c9920214fa57368736bb6e6ffd6ae906a25523b6b8d288d7a3e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
