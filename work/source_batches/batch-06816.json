        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:014a621db215455b466d479b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Report“不确定的约定”",
      "source_fingerprint": "f8fcbeb20eae0164a13edaeb8d6960ba54316e702560c019a113ff1b91c6df4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032401.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:acd75fb3432ed38dfd1de0f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了“日本德比”，\n爱丽速子难得地\n每天都认真接受训练。",
      "source_fingerprint": "0330cf59f73cddf110586795c9ccf3864ccac62759bc7b1eb35bc483180f8f7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:12f6694efef7205059def2e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时，曼城茶座指出\n她的跑法有所改变。",
      "source_fingerprint": "be045443b40a1ef71be16b1002e8f417286cc6324d860330dc280c5dd8094eee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:7d6d3817d0b6a0650fecd4c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员询问她\n关于“跑法”改变的事情，\n却被她巧妙地蒙混过去了。",
      "source_fingerprint": "d5bc98893fd056003fd94209327744c9a2dd13e2e033bb089a04f05231eedbc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1829078e407fe84fa7358b29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然抱有不安和疑问……但两人还是\n为了这个初夏的大舞台开始行动了。",
      "source_fingerprint": "9eba08ec73cf932329df3928c045c35da51086f41eb4bb3e510ea6fd657e1ae7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:6cebff32b63ff9c10d455556",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且因为提不起干劲，\n所以她要参加的比赛从“日本德比”\n换成了“NHK英里C”。",
      "source_fingerprint": "f2b2d3f96641b26282f04555c034bb79f2f77d43b2d8c8ad1a2460ceaf65b554",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032402.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:531c4e8baf4185b4d6b9148b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Report“透明的视线”",
      "source_fingerprint": "bfc00ef8496f82e332e5250f30690a8484f3e7a9110a67b4bd9ddc2fd7599b0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:34ab880a62e89dc48728e6ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让那些知名的赛马娘\n有个充分发挥实力的地方，\n规划了示范赛……“月桂杯”。",
      "source_fingerprint": "9636b1b242a605e8c3b59cb8b7e087cd0e7b3369870e2a71c332064e3cc85468",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:7cb611cb7e2d685d7e5d04ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了追求“可能性的尽头”\n而不断努力的爱丽速子，\n也收到了“月桂杯”的邀请。",
      "source_fingerprint": "db1be14ece232a17a27b2e607d6a424e5d08963c03a4c52dcd591913fbe96c2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:72d6075c03d2653bc2299339",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是从优秀的赛马娘身上取得数据的\n大好机会。但是她……\n却难以决定是否要参赛。",
      "source_fingerprint": "d9de372da8959ab9dfac573db68f54742128f6f0095f1aa5431539e02f9c08bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:4bdfb36ce5d3bab584adce1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后……半夜独自到操场奔跑的\n爱丽速子好像有了取舍，\n对接下来的方向做出了选择。",
      "source_fingerprint": "21fbe6bfb16739587513e61a34262f1dbe44d8bdd6c69b049ae5f0342fd42e92",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:c029f16040760eeda3822948",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "到了隔天。\n爱丽速子告知训练员\n她要参加“月桂杯”的决定。",
      "source_fingerprint": "9c483a050d021924ee3f77b66ce36a5085dc6c75989b910947e1451e73b3a02c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032403.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:7ff41606ff0bc5d32ec1ddcf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Report“志向”",
      "source_fingerprint": "e376dd47881e55fedfee6ca17a0f661f8719a1a7f83e3fff5b7d376a9eb19d47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:365a9a5be616d0e196447099",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了“月桂杯”，\n爱丽速子像是变了个人似地\n拼命进行训练。",
      "source_fingerprint": "b25ff03e8bae84089c0121885802152b3f4413e4566a600db746be5d4170f621",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:ec6055ce54127df44712331b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员看到她这样子，便热情地表示，\n只要是为了抵达“可能性的尽头”，\n自己什么都愿意替她做。",
      "source_fingerprint": "2300d51943410c3453d2718661e043d218a1cf746c5d7474fd8f5f2982c80651",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a5842ebe2093811af702f6ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子一方面对训练员的想法感到惊讶……\n同时似乎也为他搭挡以来\n一直没有改变的热情为之感动。",
      "source_fingerprint": "6d088eac06f946b2866b09fa7e433d6c7fa951313247b4aeeba49e826cf80d63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:95ff16c602aaacceb7d8f85f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "眼神再度恢复疯狂的她，\n说着“要放弃还嫌太早了”之后，\n便辞退了“月桂杯”。",
      "source_fingerprint": "f407fa116a5f29be7685728ecd47c3e790a25ee737bc4f1ed19b3292b7d7a911",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:67638110c85c57591703be54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Report“方向转换”",
      "source_fingerprint": "f6b1dc47055c3a7cb090455d02c0ccc344081ad5a176ddd05fa0815145f9ed98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:8d81dfe7d0f328b34fcd1c3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽速子在“菊花赏”结束后，\n向训练员坦承她的双脚\n处于随时都有可能无法奔跑的状态。",
      "source_fingerprint": "091ff66d38dcf8c4548035bf9510ec345d35636ca5a742dbbfc62d5c5ae31e09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:816a1ef8d1470a30ae55ef8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果自己的脚无法抵达“可能性的尽头”，\n就只能把可能性寄托在其他赛马娘身上。\n她经过这番思考后将梦想托付给其他赛马娘。",
      "source_fingerprint": "1b6c22029958ba96c9e6a926653df58a17dfe98bc1cb148293b9e4d74224bbf6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032405.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:15768477b7ffcc73add4de18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是在听过训练员发自真心的想法后，\n她坚定了要用自己的脚实现梦想的决心，\n克服了自己的弱点。",
      "source_fingerprint": "2dee9515e9e3e60bab428eeff9707175f60c6fec9bfcaf6633d7c207a236f714",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032405.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a52ef87f6d2062c3752d7c35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "得知爱丽速子一直都是\n独自奋战的训练员，\n表示会尽全力帮助她。就这样──",
      "source_fingerprint": "aef6f3b1f1e64ad567555c0ddc49aae60998734b95f1e6cf350519bdb3636b44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032405.json",
      "json_path": [
        "text_block_list",
        3,
