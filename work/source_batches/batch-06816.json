        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:dba6342b47f7a65b8643d745",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她看过计划后，\n声明因为一切以研究为优先，\n所以要参加哪个比赛会由自己来决定。",
      "source_fingerprint": "a0e4e0284c746de0b71dfadd11a3ae7647ea5ae310aee7914e1264b255e5eaa4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1032/storytimeline_501032401.json",
