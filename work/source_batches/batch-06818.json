    },
    {
      "uid": "zhcn:06103014fa0612016e636b02",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知道是不是我的合作态度让她开心了，\n爱丽速子比平常还要来得有干劲。",
      "source_fingerprint": "1f450eaf31da13e2bb8288b314873390a8bfa1bc5138c58f5d6821be8a8581bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
