      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听好了，你来帮忙搬东西。\n九点到车站前会合，记得一定要来。",
      "source_fingerprint": "eec56ce870c072312d08b04d7a74c9667b5e46749a8e1d47563065e170e45e8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
