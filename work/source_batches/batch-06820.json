        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:23a38af65fe268dc435844a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "难道发生了什么事……正当我这么想的时候，\n爱丽速子打了通电话过来。",
      "source_fingerprint": "bba0c4ce4dc3b6db2238a6051b47553f5c42932ce23155a4d4a865a8f77576fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
