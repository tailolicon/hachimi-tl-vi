      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "干得漂亮啊，训练员。顺带一提，\n真正的豚鼠也会游泳，\n你知道这件事情吗？",
      "source_fingerprint": "8786783cf500582a49512ebef3f86149e63c251dcd205dc53e93f3a4f7063dc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
