    },
    {
      "uid": "zhcn:09843c8b41ccacbdab378a66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来是这样呀。\r\n站在训练员的角度出发，\r\n这是个很棒的想法哦。",
      "source_fingerprint": "69dfc54e977a38563a6401e74411bab8d74b73600f1943dcad35165c0d542129",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033100.json",
      "json_path": [
