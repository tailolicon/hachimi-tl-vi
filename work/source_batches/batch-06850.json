      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:07cec6d4aa9baa331714a0c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033100.json",
      "json_path": [
        "text_block_list",
        5,
        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:87ac3258eddbaab61f420b44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，别太晚回来了啊。\r\n可别因为我习惯了你夜间外出就想钻空子哦。",
      "source_fingerprint": "3ec15f9e737c33e79395d6b1f5f15c7693387c4afdc521b6fd23cc6989bebee6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033100.json",
      "json_path": [
