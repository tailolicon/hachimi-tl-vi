      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算现在是自由时间，\r\n但要是和身体状况有关就另当别论了。",
      "source_fingerprint": "e92973bca0fe59fbbb1c192c39f37b2cf4e44cfc44c5f50981cffb2853f2b3f0",
