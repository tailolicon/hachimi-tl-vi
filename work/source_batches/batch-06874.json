    },
    {
      "uid": "zhcn:50362124b04855565b80aa83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱织……！太好了……！！",
      "source_fingerprint": "0a6de2ad37101c197ad87b4fd0aa9e9a6bb0c00a4b074934214cb20d13383083",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
