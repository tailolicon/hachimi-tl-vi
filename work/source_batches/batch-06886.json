    },
    {
      "uid": "zhcn:dd99ca51cb2028c9b4d0588f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田路说的是，\r\n记载着人气赛马娘的比赛情报杂志『闪耀月刊』\r\n一直在制作的特辑。",
      "source_fingerprint": "138d3fde97d9f10081d7c6a80f3fb350d35438c9393887c5663b18a1d6bbc225",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033201.json",
      "json_path": [
