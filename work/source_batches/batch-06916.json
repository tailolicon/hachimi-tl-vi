      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或者说，以春古马三冠为目标应该也不错……",
      "source_fingerprint": "7a46bbd2123b9cd76ab34257743e1f1c1e2dd8543c54f09b0be808eac1f1ec3a",
