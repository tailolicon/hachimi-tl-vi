      "uid": "zhcn:8281a3bce0830549c7621e20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱慕织姬——\n她的状态，非常差。",
      "source_fingerprint": "95e40be0f52a8deb769e0069cdf28e4c6a7fde554a0f5a892f8001a06a0c7772",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
