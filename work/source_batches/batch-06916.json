    },
    {
      "uid": "zhcn:c1d918e5ab843dec8e52d8ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回到房间后，我回忆起今天的比赛。",
      "source_fingerprint": "6ded7c0c26f757c00600bb8daa5c564db1abf700f91032124cd7679359350d84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
