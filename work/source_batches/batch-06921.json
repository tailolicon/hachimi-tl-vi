    {
      "uid": "zhcn:a6cd5a9f9dea201c69a5dc09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一方で、ナリタトップロードは\r\nアドマイヤベガに尊敬と対抗心を\n真っ直ぐ伝える。",
      "source_fingerprint": "2c18a3d8ac7140a84446e5ce647716c692867f05732ae16ec5a5591abc9b1aa9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033402.json",
      "json_path": [
        "text_block_list",
