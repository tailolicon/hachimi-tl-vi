      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:9c2253b01e0e316a8b7bc282",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "そうして迎えた夜明け、明星も消えた頃、\r\nナリタトップロードがアドマイヤベガを\nランニングに誘う。",
      "source_fingerprint": "11caacfe8b45c53afdd20eb92b6d16b0f72dcf88187ad8f466a351892d38b250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
