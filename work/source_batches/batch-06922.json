    },
    {
      "uid": "zhcn:59298efdf38b1a5f68aed4f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金世代の一員としてライバルに恵まれた\r\nスペシャルウィークからの激励も受け――",
      "source_fingerprint": "3fe42c4e0c0bbce80379a04506d23ed772bec5a532f87e00f699264231261f0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033411.json",
      "json_path": [
