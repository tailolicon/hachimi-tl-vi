    },
    {
      "uid": "zhcn:2299b710c8ad4f52596838ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "強豪集うその舞台で、\r\n異質な圧を纏ったテイエムオペラオーは\n高らかに『新章の開幕』を宣言する。",
      "source_fingerprint": "37b90e7ae7b16e44630b7a75e9464ce822981d8421001e2162187a86c983a7f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033437.json",
      "json_path": [
