      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a7228288a89fddcc940ff9f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "実際に、レースで見せた走りは\r\n凄まじかった。そしてレース後、客席の\nメイショウドトウに向かって彼女は語る。",
      "source_fingerprint": "00fc6b59c3cdaec25fb2ab19d633a579b7f30914d788fab203c810da91f86155",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1033/storytimeline_501033437.json",
      "json_path": [
