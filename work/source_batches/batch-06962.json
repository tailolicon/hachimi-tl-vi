      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然有许多无关的人满嘴意见──\n不过只要在比赛中展现稻荷大人的跑法，\n他们就会闭嘴了吧！",
      "source_fingerprint": "430672833a46d33e19c8c5fea29d50510db7bac0b4f1269ebbb241a0a41e81b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
