      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "电视的声音",
      "source_fingerprint": "46482f77c1d6ebcbdae1594c2377df4f9e6d3fe1aa4f908744f28b8447400a0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034102.json",
      "json_path": [
