    {
      "uid": "zhcn:d488491adb67428cd3d4319f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大婶！谢谢你。\n下次我会带着特雷森学园的人\n一起去光顾的。",
      "source_fingerprint": "ff02cba32846b015c0bf885272619235f3f509210ce43a4852b85279eef46e93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034102.json",
      "json_path": [
