    {
      "uid": "zhcn:1a4816a5f060881418a3fd5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稻荷一",
      "source_fingerprint": "0bdf3373db8e81d79748eb4e288190fa429705734f8d1059dc06a6d7baea0ebb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
