      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:737c461602dcd1489ff96c36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“目前最受瞩目的赛马娘非她莫属了吧？\n我本人在赛场上亲眼看过她的表现后，\n也完全成为她的粉丝了！”",
      "source_fingerprint": "9c30a3637a5fe10b29992179a4e09fefb9436817fc5e91c86eb586724aa358c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034102.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:2ae9aaba2dd975769f2040a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "电视的声音",
