    {
      "uid": "zhcn:d0420c4f2b10297510cb4d7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稻荷一说得没错。\n若想当上“年度代表赛马娘”，\n想必是非得先击败小栗帽她们的吧。",
      "source_fingerprint": "efabaaa3e51a4ec768cf4e2766a935f51998627d4066b03a08e2fa9bc1aace8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034318.json",
      "json_path": [
