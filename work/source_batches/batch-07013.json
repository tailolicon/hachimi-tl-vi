    },
    {
      "uid": "zhcn:5cbcbf6ae89021fc8b7ecee7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我又担心对现在的稻荷一来说，\n那件事或许会造成反效果──",
      "source_fingerprint": "37be51a0bd19eb1afd6f7a0874931adf95479a76881b419458cf164306b496c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034322.json",
      "json_path": [
        "text_block_list",
        61,
        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
