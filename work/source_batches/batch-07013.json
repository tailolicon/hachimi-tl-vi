    {
      "uid": "zhcn:a1f96d55ba3c24837ad99856",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我第一次看到\n稻荷一如此虚弱的模样。\n每当想起她的表情胸口就会一阵痛楚。",
      "source_fingerprint": "897f92e6c20d1072bc443818ee201e18dda09aa2e1f3aa87598901fd187f5afb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
