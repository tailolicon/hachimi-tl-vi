    },
    {
      "uid": "zhcn:2648a9c62be678a3a1cc0338",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──还来得及挽回。只要在下场对决，\n赢得让人无话可说就好……！\n你一定做得到的，对吧……！？",
      "source_fingerprint": "a93dd95b81a1343791672cb9c6cb0580b971a5793efa3c9ec372c028778256c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
