    },
    {
      "uid": "zhcn:57a2cacc25ead34ea54ee254",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我不求她能回来训练。\n现在我只想\n让她极度耗弱的心能重新打起精神。",
      "source_fingerprint": "1e4186c4ae781beed59c8c15aa6eb01e45202aefb8a876a7f85914a916488580",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
