        62,
        "text"
      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:a5d43c3b4b3de70e766dd452",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以现在……我要在这上面赌一把！",
      "source_fingerprint": "3c519b33722d26e7374bd71abd0db09257d4d2edb11ed1e1317999ef1d7295d3",
