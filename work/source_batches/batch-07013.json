    },
    {
      "uid": "zhcn:998aecfb7380f802acdaf9b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──脑中闪过我与稻荷一的回忆，\n我想到了一件\n能为她做的事。",
      "source_fingerprint": "c5d0ad18793373f1bba4387060f38340ba59549ce085a614385bd5ee635a27d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034322.json",
      "json_path": [
        "text_block_list",
        60,
        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:8c37c358c9e29f0a0dd6a9ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……还是相信她吧）",
      "source_fingerprint": "e8df7eea8d9ca6eef1a56c8a92a3a32368bb431625f44859e149ba861cea9dd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034322.json",
