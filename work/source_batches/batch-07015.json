    },
    {
      "uid": "zhcn:a8dd52bcf4513f2f68f1e526",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她还将榻榻米搬进训练员室，做好万全准备。\n一生一次的闯天下大战，\n闪耀系列赛的盛大祭典开始了！",
      "source_fingerprint": "36d5bfd0d6029343a4702448976419c7364d419cfda9e5b52179ee9223dcfee3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034400.json",
