      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稻荷一登场！",
      "source_fingerprint": "e0324aa06f0556d06d5a41092f4aed7c56c3b024e6c466a71ab823c3cd5e82a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
