      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:8c73db485340d4edae03bc36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是该怎么做才能达到目标呢？\n她不知道具体的方法。\n此时训练员提出建议。",
      "source_fingerprint": "ffede06bdf3d2ccccae30a5992ddac61e127d2873329eb22ff01fc39b0dd0ab2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
