    {
      "uid": "zhcn:b2172dfcae44a0ad9660f474",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她本人也沉浸在比赛的激情中，\n带着满满的活力与斗志，\n往下场比赛前进。",
      "source_fingerprint": "a627b38973a7d6e8f791f9d87462f2c71dbea0c8c4f0d3316846d95d9fad2a61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034418.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:7f5bc663b8f0d39796a49a4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・要开始闯天下啦",
      "source_fingerprint": "767986fd091cb543ad8ec0bf1e19f7cfe5a64394626d9b0f947b0080c04332f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
