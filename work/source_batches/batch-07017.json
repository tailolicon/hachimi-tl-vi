      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定天下归属的大战“有马纪念”，\n闪耀系列赛的一大祭典开始了。",
      "source_fingerprint": "012e8454118d26eedbe9c7a6ab7114e8aa1796b88efde6da2bfa09124db3d3fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
