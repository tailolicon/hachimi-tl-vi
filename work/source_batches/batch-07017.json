        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9de5290d7e1ea143bdff142e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
