      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稻荷一全力跑完了出道战，\n来观战的超级溪流与小栗帽\n对她表现赞赏不已。",
      "source_fingerprint": "d15f1da2dca45df5a7b8f1a43a5fa8f60ca93f03bdc5f2355beaa8a796732e4a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034418.json",
      "json_path": [
        "text_block_list",
