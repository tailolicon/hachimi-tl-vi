      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向有马纪念",
      "source_fingerprint": "a28480a57275928fde3ca335c4e37d5670b04bf8228df0e3cc61294de9b176ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1034/storytimeline_501034417.json",
