        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:d023cf71faa177a32446ed31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们两个来到了神社，\n但不知为何，稻荷一把鞋子换成了木屐。",
