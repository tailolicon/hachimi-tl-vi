    {
      "uid": "zhcn:975b12d98db6904472c597d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "太棒了────────！！",
      "source_fingerprint": "adecf7b2ff7176743c48f6dd2f05a3eadcfb02814e1357010f9759e2c12a8057",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
