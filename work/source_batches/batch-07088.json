      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "希望S结束后・结果极佳！",
      "source_fingerprint": "b9bd38aebba156e03c96a604175fb291d8bc80af815a5a6d5b704af2a45ecb82",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
