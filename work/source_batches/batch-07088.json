      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:d3e11736149d129bee2e843b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于到了胜利奖券参加\n“出道战”的日子。",
      "source_fingerprint": "b24f48dfb4c74f8c34f0e11fd4303f9f720dd129b2b170a1de88c8d477f0d23c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
