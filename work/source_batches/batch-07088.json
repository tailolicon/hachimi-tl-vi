      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着，成田大进宣告\n“皋月赏”她绝对不会输。",
      "source_fingerprint": "30a8734242abc0d6a9cbc168c364a4e37e0fbca7ecbf6209ef0597a6c1bb78e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
