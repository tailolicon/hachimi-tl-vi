    },
    {
      "uid": "zhcn:4c3080e6e77a59a9cec3517d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与成田大进的认真对决。\n胜利奖券火力全开，\n干劲十足地去参加比赛。",
      "source_fingerprint": "26b8870ce8fa2df91c957e2af1d2b6a239d4d4920247c3ba29c60e5bb4ad0bd6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035410.json",
