    },
    {
      "uid": "zhcn:61feb253e2556dc0ee66ccbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不要输给对手凌厉的跑法，\n胜利奖券全力奔跑，\n并胜过了成田大进。",
      "source_fingerprint": "38954f66aaa714830b62197db989503536adadf279ec1d6d3289be2c4696c10f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035419.json",
