    {
      "uid": "zhcn:52953ad73c4b49005e0f232f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "琵琶晨光、成田大进及胜利奖券，\n这三人被称为“BNW”，\n备受世人瞩目。",
      "source_fingerprint": "765bcf95ac8a447fc81c62bfc9d72657661a43d5c8dfaaa41210ee4855d015ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035411.json",
      "json_path": [
