    },
    {
      "uid": "zhcn:8108748b7e91e9fcdc226830",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利奖券获得勇气，\n踢走紧张与搔痒感后，\n迈向了“出道战”。",
      "source_fingerprint": "e23ecce8379fc5654882822af90e4ab51b70b315c9729c3cbc35cf98fa1b6fed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035408.json",
      "json_path": [
