      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:b1dc9b8010728744034d7cb8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员鼓励着\n一紧张就身体发痒的她。",
      "source_fingerprint": "e39fb83e3b2fcb1f3e5c12293626ba162e95da16db4077ede85223df8d2ee6e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
