    },
    {
      "uid": "zhcn:dc0f2bea4ba2e54b9bf204b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向出道战",
      "source_fingerprint": "4ea754365577b70c3247fb413fa7b90388e1e4a185a1da5f6c50ef25fe13c496",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035408.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:6bbc708c38d73d73049f7a6f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众万头攒动的GⅠ赛事“希望S”当天。",
      "source_fingerprint": "42171b2ff16db5b53f2efd5e475d23a99fd517ad548b730e5098821d20252df8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035409.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e4701d0d779ca94b9a4e3dec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了在这里习惯长距离，\n替她的真正目标“日本德比”铺路，\n胜利奖券全力挑战这场比赛。",
      "source_fingerprint": "cdbaa6792278b279deff4d9f49ea07a4e2fb845bb0aef0aeb8879940ec5d0807",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
