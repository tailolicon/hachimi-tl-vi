    {
      "uid": "zhcn:00304a52c0fd483f982f2b35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利奖券与训练员\n从此时开始\n将正式踏入充满挑战的日子。",
      "source_fingerprint": "377d30f0e7d35540a8632f8bccf1f413b8ddd9d2b54a62acd5357d60f52c4a81",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
