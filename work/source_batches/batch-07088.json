        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6ca1a785b52cb1a91a9932b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们齐聚一堂的经典三冠路线，\n第一场比赛就是“皋月赏”。",
      "source_fingerprint": "4cdeb5237c2856ccc4c3179e7b179110aa315242e1d30f4cb290f8c5392e1603",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035411.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:38f333db53adff7bf269ea45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "心怀坚韧意志，一心求胜的她们，\n带着十足干劲前往比赛。",
      "source_fingerprint": "62933c2c9907dc82cab0e76d18fdb83d35a3c4bdc808c23fc8891248e2f1026b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035411.json",
      "json_path": [
