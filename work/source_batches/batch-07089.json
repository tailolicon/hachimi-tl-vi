      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6aaf5784eaf7588b2b1334ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“你还是重新思考一下，自己是为何而跑。”\n琵琶晨光的这句话\n让胜利奖券陷入茫然。",
      "source_fingerprint": "6067f1395bfa26c5a151418f3b96eefd42be8fefb4595b9d75d1dadd7fce2c22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
