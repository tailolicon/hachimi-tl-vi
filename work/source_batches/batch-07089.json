      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・鬼，炸裂",
      "source_fingerprint": "0105084ccbd179f40cbfb8e94777bc74a92e54110fdb15a736d63c75649dab15",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
