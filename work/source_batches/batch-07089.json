      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0d8c9616d3e829d40de9a9e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花赏结束后・即使输了也最棒！",
      "source_fingerprint": "68697f22aaccc30b7a6c6d4a8d91dcf039754890441625f01fc95bc10e62b17b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035426.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a127806aeef4dfcbfcecb845",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利奖券靠着逼近极限的跑法，\n好不容易才胜过了成田大进。",
      "source_fingerprint": "4ebcda964a79b1e809b5417efe26b2fd9c85c494e6c9d099bebd345f932f8ca3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035427.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e991affe96d2bc855cb0eda0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而另一方面，比起期待已久的宿敌对决，\n成田大进气势逼人的跑法\n更令观众为之入迷。",
      "source_fingerprint": "4f8b7354592661e895beedaf8138ecb285724a84f8d5f4f49dda9432b33405be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035427.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:115d35bf2c10842a560c8612",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不输给这样的成田大进，\n胜利奖券更是斗志高涨，\n决定要更加努力。",
      "source_fingerprint": "817c43b5cbd51f7d62bcdef24ba43711fd7f6a0e83e8aedf17e2957b85e1a119",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035427.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:dd46e55d3c10f747a757ed0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "干劲十足的胜利奖券，\n以上半期闪耀系列赛最后的大舞台，\n“宝冢纪念”为目标向前迈进。",
      "source_fingerprint": "cd0b8f5c0059091e48e26e19bd159057d439744d19fbbf52668244a43a51611e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035427.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:f97e5bb1bc8a8156e96bf169",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯结束后・急促的呼吸",
      "source_fingerprint": "75efa0d16c795e4a9cc0bbdb2d8909e8d6cfc4507c361240292eb66ece418d7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035427.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a95a3255383647ab14c02dbd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利奖券虽尽了全力，\n却还是输给了跑得气势十足的成田大进。",
      "source_fingerprint": "5e565e2482897a92edc566d27c6534b79ee67702d4d5775ba6cd56e7162eb9ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035428.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:281eb52e425600e5db5cbea1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被成田大进的气势压倒后，\n“下次我要更加努力。”\n胜利奖券如此低语着。",
      "source_fingerprint": "b3e786c1825bfc977ff38418e21c23bf949942bc76db39496fea26b35d9d37d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1035/storytimeline_501035428.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:0b82fa7f8bfa8fe31fa139f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为此，她以上半期闪耀系列赛最后的大舞台，\n“宝冢纪念”为目标向前迈进。",
      "source_fingerprint": "a00964868c838356ecd2590bbccfa59c8d50c2eaf12d21c7f06f1bb2b89089a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
