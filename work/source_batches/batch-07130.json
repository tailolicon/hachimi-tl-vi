    {
      "uid": "zhcn:907a1dc076e45a07dc0e4316",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要是沟通不足造成问题会很麻烦，\n所以凡是我认为你该知道的，我会告诉你。",
      "source_fingerprint": "c4d5748c1a1eb5397706eafc6917879634cf75046a08f79bcb29aab17ad6feaa",
