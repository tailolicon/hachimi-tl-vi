      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在有必要知道吗？\n你先专注眼前的事情吧。",
      "source_fingerprint": "98eb1e0f5eff43d240e2f18e1cfffeb1e78d67f856d7c7ffdc900a95c1aa1cb2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
