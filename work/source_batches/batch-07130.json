    },
    {
      "uid": "zhcn:c0c51f2306c3e94645f004ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你能回答我刚才的问题吗？",
      "source_fingerprint": "d8477a9830d314978e91c6011fecf0c1dec76f5e32f1f2192dccce4c84146115",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
