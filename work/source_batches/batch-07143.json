        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a14e79e02a46dc9931ba63ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──在“有马纪念”结束后……\n空中神宫突然将部分的“Parcae”\n免费分享到网络上。",
      "source_fingerprint": "c6ada7e2b564aa481bb479ea6e04364480b357963ff486c7e25e7ee3d49de9f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036111.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:4b9b44d392b1503ccc1b92d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这举动引发了巨大骚动，\n带给社会不小的震撼。",
      "source_fingerprint": "4bc446ffbbb6ae84967a40c25817ef691ca5601a39192a55239b8032fd59fc7b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036111.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:45eca51747cbe2c48e70e830",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为有个完美的程序突然出现，\n举凡替赛马娘量身打造最适合的训练，\n或是模拟比赛情境……一切问题它都能解答。",
      "source_fingerprint": "3e4d82c79fab896cc49d822d166a89c08f58dd6c8a339c4504232d33a8e1224e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036111.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:11a8f16d35fb96a340094cfa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且还是匿名分享……这个程序的开发者\n为赛马娘界的发展做出了莫大贡献。\n学园也倾尽全力在寻找这个人，然而──",
      "source_fingerprint": "1e0f57174ffbbcfb909022aa2500cc8aeef4495ca4cd19586a0cb82d1e08e1d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036111.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:386f111c16ec03b4779da064",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "到现在也还无法找出是谁。\n不过，直觉敏锐的人似乎注意到了……",
      "source_fingerprint": "db703c023096f7c0d3d9f18f71f749beb93bf2ac0e0ee7abc517c9fa8164582d",
