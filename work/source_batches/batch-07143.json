      "source_language": "zh-CN",
      "source_text": "她努力地发光发热，甚至有人因此\n把这段时间称为“空中神宫的时代”──",
      "source_fingerprint": "163114b970f999ddb1b4ce2023725405bb84bf2b37555149fd7bc5087a0a2ce9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036111.json",
      "json_path": [
