    {
      "uid": "zhcn:e50637ee2173d1f947fe64c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "专心听我说。\n总之接下来的获胜条件很简单。",
      "source_fingerprint": "637545a2240d437eb6d57dafc5e12285968071bb83f48b803bdf8647f47a700c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
