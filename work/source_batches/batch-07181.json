      "json_pointer": "/text_block_list/56/choice_data_list/0"
    },
    {
      "uid": "zhcn:df4a23cfb7ac2d551bed8a21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我原本以为看见她战胜宿命、\n赢得胜利的那一刻，自己就会心满意足。\n但，我现在想要的更多了。",
      "source_fingerprint": "f0444ae06edda50db764e000074c99750282ff73f1c874d923fdd3bd8f23512c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036310.json",
