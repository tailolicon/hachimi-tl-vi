      "uid": "zhcn:3e1dc2ec0ca79bf06b1b7925",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我希望她的名字能流传后世──）",
      "source_fingerprint": "0436cd3c167e87482b5dc3516b018034e6fcf76aa966bd537603be7381758bce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
