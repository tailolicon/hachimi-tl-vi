        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:480e8f5f9c09d1eef051854e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她惊人的气势、利落的步伐，还有耀眼的光辉……\n更重要的是，她对胜利的那股执着。",
      "source_fingerprint": "b0608605b0933cafbcc46ea9e5a119299701f66e618126b2c86fc2a8600923da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036310.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:66f1203ac202cecf1a28d440",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我希望能有更多人认识她）",
      "source_fingerprint": "d69b764fe4a189b685bd9e74576536638fee3390695e76c87e26b09bb26218d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
