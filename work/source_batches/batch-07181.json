    {
      "uid": "zhcn:45718a6e04246af6fed8db42",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回家之后，我一个人回想着\n空中神宫今天的表现。",
      "source_fingerprint": "d87332d76862a64a68c92ff05c15089103655d3d6d7b2ba22b3f145c46b78c6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036310.json",
      "json_path": [
