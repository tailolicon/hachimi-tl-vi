      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练结束之后，\n我便立刻把信收到保管粉丝信用的箱子里。\n结果──",
      "source_fingerprint": "09770176cf0c4f7efa0f5f8f6bf3a99ce5dbe57786b23c14f2fefa46b60a8b88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036507.json",
      "json_path": [
