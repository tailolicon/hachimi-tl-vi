    {
      "uid": "zhcn:a5758cf90e291556a7df8b4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫充满干劲，\n曼城茶座则是盯着半空中。",
      "source_fingerprint": "bf6737353591845538d16699532b3b2739467be1e4143d9a227e3713b360f16c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036511.json",
