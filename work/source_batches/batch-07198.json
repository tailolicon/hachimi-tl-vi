    },
    {
      "uid": "zhcn:40f8268e680dd82f601f4746",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她突然走出围绕自己的人群，\n站上了赛道的起点位置，然后──",
      "source_fingerprint": "73be6f6ccd7f779487d4a9545bd6a0df8ad2df220e6915442244f86a530a4643",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036513.json",
      "json_path": [
        "text_block_list",
        29,
