        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:05d7712018df64a76155a6e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫对决胜服的讲究\n的确相当惊人。",
      "source_fingerprint": "b9abbffd99dabcf64264b4998dcfab71b5cc84b958af7b3d526373900bd11d86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036513.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:70108b6e18db4d25dee0d894",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先是寻找值得信赖的设计师，\n从材料的选择到蹄铁的细节……\n她参与了每一个细节的决定，直到自己满意。",
      "source_fingerprint": "965671b6f48e7f6089df109e3d501871b0c00998d0caddabdeba266ac53c7a50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036513.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:d33784bada24d270b98b7d90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫",
