      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:3c753c3c1e892c5c8dd687b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且今天主要是穿着决胜服进行摄影，\n所以跟决胜服相关的提问也特别多──",
      "source_fingerprint": "f1b538784568cf2a2cbd48766b934f9044cc0ff2a09ed2d890232852d4d741eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
