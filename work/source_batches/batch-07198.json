      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦？\n……神宫小姐？",
      "source_fingerprint": "786ecf909811d05b89f64ab87ee8babdf383a195e8d76f9f6a70da4538a3039e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
