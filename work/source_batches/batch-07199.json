    },
    {
      "uid": "zhcn:2275c5e67b41ed6fca847fa3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真的搞不懂。",
      "source_fingerprint": "7d89274031ae83658977d3e9919f9c1772df4e6b0fd25988632a3c0a97600d6e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
