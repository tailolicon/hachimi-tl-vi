    {
      "uid": "zhcn:70aa137039295956e0e45cb6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫",
      "source_fingerprint": "518141f549ec17c68539558e989d6e1e1572a826491709a731c97a2fe4f1603f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
