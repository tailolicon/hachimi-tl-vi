    },
    {
      "uid": "zhcn:a10059aceb0d8deca8e94ade",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但还是想为你做些什么，或许是这个意思吧",
      "source_fingerprint": "c9e86cbf0179a06c21ca09ea7de61e89a40915dff73d8c7bd7be2dc6348b2839",
