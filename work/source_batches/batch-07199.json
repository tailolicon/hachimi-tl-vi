      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:a6c16fc1da7e6801709222ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在那张两人互相倚靠的照片背后……\n写着“希望你至少告诉我该怎么做。\n也希望你能明白我的心情”。",
      "source_fingerprint": "c933b26df9517c0e366844943eeffe9edf793c139140094ab721c26e62aace41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
