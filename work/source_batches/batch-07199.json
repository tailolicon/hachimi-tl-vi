    {
      "uid": "zhcn:acd53f19e44ed98a94e4e2f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她说以前是在小小的酒吧角落，\n唱歌给喝酒的客人听。",
      "source_fingerprint": "46b89e2091c43b4acde44a6cb0428ffc9b10bd622dc167feeb337a77a46b573a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
