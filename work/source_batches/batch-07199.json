    },
    {
      "uid": "zhcn:3b7364bfaddc6467b5eded61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你小时候很可爱啊",
      "source_fingerprint": "a2344eeaf62525c6172d8756e0a113114e230dd1576e52d7a3915a01db0a1cbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
