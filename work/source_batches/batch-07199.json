    },
    {
      "uid": "zhcn:d46739bd5f32851ba0aeae32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──就是从那之后，\n她才开始会跟我搭话……",
      "source_fingerprint": "a4664c120f8fea2892bc1592bffd1cd00aede61a04b1bd5f3bc8fd4aff55bd85",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
