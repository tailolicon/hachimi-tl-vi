      ],
      "json_pointer": "/text_block_list/5/choice_data_list/0"
    },
    {
      "uid": "zhcn:f2b7b893c59698cf5731d635",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有不合科学的保健用品，也有最新的科学杂志。\n有图案幼稚的毛巾，却也有别致的手帕。\n在这么多杂物里，我注意到某样东西──",
      "source_fingerprint": "89f9e7417775b6fad277070cd178e7480cc9c566524e90acb44050960ba672ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:a5623538d9c232a0cd392aea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在一间像是酒吧的店里，\n有个气质空灵的年轻赛马娘抱着一个孩子。\n照片背面则写了一段话……",
      "source_fingerprint": "de67ec57c7b0d440a28a349b6b26ad7922360c76cc5fe6eb42fc890bdf33ab3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:f3a79a445df672baaf0d766b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫",
      "source_fingerprint": "518141f549ec17c68539558e989d6e1e1572a826491709a731c97a2fe4f1603f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
