    },
    {
      "uid": "zhcn:80e2d5832540cc1e4cf769cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以我跟她说“你吃掉我反而高兴，\n其他的也给你”，结果她好像很开心……",
      "source_fingerprint": "1faa1b695cd9f35be01000a046cc255574930675de8c996c9979014380525282",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036514.json",
      "json_path": [
        "text_block_list",
