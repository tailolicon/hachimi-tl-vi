    {
      "uid": "zhcn:a08474744e5fca5603f1e3a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对。\n她好像以为那是寄给她的东西。",
      "source_fingerprint": "b17259143f89b7e9939fe96d184b5c120c07d26da5040018a54a3cd67262b464",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
