    {
      "uid": "zhcn:0b2c5a26bf9423540aebfa46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哪里好？\n……你受了原本不会受的伤。",
      "source_fingerprint": "5543e960bd0202f8ae1dcc55df9d31ac8a12adc6979499675cba7d08592c3ca3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036515.json",
      "json_path": [
        "text_block_list",
