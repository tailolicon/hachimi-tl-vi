      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:9364fbc1449166349148f70f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为我在昏暗的山里只顾着向前跑，\n所以似乎被树枝之类的东西稍微刮伤了。",
      "source_fingerprint": "3bb4969562b05205c6b2641fcdca795a598d9d583d45ec713728710572adaa42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036515.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:d12de3f06f94523f7eb86f59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为一场意料外的大雨，\n我们所有的行程都往后延……\n结果连最后一班巴士都没搭上。",
      "source_fingerprint": "b594f9089863b9ecb526f9b7dfad1d796a9746044cff29497f4e8dd7a0ac42db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036515.json",
      "json_path": [
