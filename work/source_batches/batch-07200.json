    {
      "uid": "zhcn:0116e73c1a251906dcc9d824",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们不是来观光的啊。\n你的身体也还没习惯高地吧？",
      "source_fingerprint": "de684ae048353c0e152d03e61dfc8f47f2f4d02bcfa5839b413ba0a485cfa014",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1036/storytimeline_501036515.json",
      "json_path": [
        "text_block_list",
