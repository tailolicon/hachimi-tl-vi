    {
      "uid": "zhcn:94d923fa4cca90575b837c88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……喂，你从刚才就拿着手机\n东张西望……看了很烦。",
      "source_fingerprint": "3ac144fc4f6a9a4a59495f19e83d95e0bd2f768cfd52fb568945f58209419bb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
