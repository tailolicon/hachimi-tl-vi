      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这只是擦伤",
      "source_fingerprint": "a761430998df6cb01c533b2197165445f0bd61fedba57dd44a568a85188b014b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
