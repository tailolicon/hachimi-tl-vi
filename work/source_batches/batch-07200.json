      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过啊，既然你那时是在找有信号的地方，\n就跟我说一声啊。",
      "source_fingerprint": "db0a4ce6f662efd4a78cb9910aed980f8c06ef21777fa7bf2ab541ad45271806",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
