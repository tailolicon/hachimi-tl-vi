      "source_language": "zh-CN",
      "source_text": "所以希望训练员你能帮我。\n请将我锻炼成\n能够达成完美行程表的完美状态。",
      "source_fingerprint": "65197e3b41a0b7cafe156417fd4a5db264010e20108f066c46d9f50a96def1a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
