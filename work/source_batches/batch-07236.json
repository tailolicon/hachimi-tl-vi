    {
      "uid": "zhcn:5d1d976d91a6edb3f4f15243",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尤其是“日本德比”之前的行程。\n我想提高负荷。",
      "source_fingerprint": "8eeee255745be99f7d56c5abbef06e2a5d9e820dea841700504ffe535d7c887d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
