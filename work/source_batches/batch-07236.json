    },
    {
      "uid": "zhcn:991f6808d9008b94ad2b96a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……收到父母的心意后，\n我想要成长的念头又变得更加强烈了。",
      "source_fingerprint": "ba0e9fdd10d3ce20488d1b3b1d39afc3ee63f53f0d5337b508c74fa8fcdabe36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037113.json",
      "json_path": [
