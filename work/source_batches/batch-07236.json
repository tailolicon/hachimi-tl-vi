    {
      "uid": "zhcn:5b388e3e7bdb1db0239436aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看来她对“正确无误”的执着，\n是源自于对父母的强烈憧憬。",
      "source_fingerprint": "d43bff683e5d4a142937304942505c1e260208a81069e4ee22688a38447e7db0",
