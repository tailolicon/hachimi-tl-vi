      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不客气。\n……待会我可以\n跟你讨论训练行程吗？",
      "source_fingerprint": "383c652f8b79c196e470b18e8fa989496f65d4a78f9f8724479330c4105b3bf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037113.json",
