      ],
      "json_pointer": "/text_block_list/36/name"
    },
    {
      "uid": "zhcn:50985248087d4274dbd180e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以前我说过不会严格地以胜利为目标。\n不过……我想让母亲看到\n我在德比上获胜的模样。",
      "source_fingerprint": "3ae758aa12b9566f802bdacc67905c3b8b578cb9f9efecafa8909f55c847dad2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037113.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:5708a4caad626f880d26869f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "德比对你来说很特别吗？",
      "source_fingerprint": "cbcfd9ca190545e4b4bfa188c27dd60efb957a47a05ee66385ced18ba41acaf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037113.json",
      "json_path": [
