      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但比赛水准之高，令我立刻深深着迷。\n我暗中发誓，自己也要在此大展身手──",
      "source_fingerprint": "477201d03eeaaa49bf98b5e2685866dc46da90f3930823ed7a28aad09b4ce824",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037320.json",
