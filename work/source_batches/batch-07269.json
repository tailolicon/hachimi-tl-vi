    {
      "uid": "zhcn:c970ef622ecbcb81d1768d0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荣进闪耀因为创下某项记录，\n而获得表扬。",
      "source_fingerprint": "9e9b817c2c685d10c9937e5d6d7d388749efe9a82f7542bf1f6e1cf5ad96192e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
