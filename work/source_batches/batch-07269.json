      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那天我原本只是打算来观摩，\n看看日本比赛的实际状况──",
      "source_fingerprint": "8a7a15ce9699c1066e977eb3b047d2d36604df01cc1f0d63c6aef405bc47d8cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037320.json",
      "json_path": [
