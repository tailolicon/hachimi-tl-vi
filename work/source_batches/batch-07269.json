    {
      "uid": "zhcn:2fb2bbcaf2451b10e6d1dcf7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经历无数次比赛后，某一天──",
      "source_fingerprint": "80f74cc16151d4ad91b35186dbc1777c9b4471a72e84624136f309101396eaf7",
