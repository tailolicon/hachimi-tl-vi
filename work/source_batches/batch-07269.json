      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的。首先非常感谢各位\n举办这场典礼。",
      "source_fingerprint": "136dd5f36dff0874ea536f4ea6e4b5d52d76fecd6cd3c26720cc975ab43f2d2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
