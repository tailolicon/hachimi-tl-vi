      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说到这里，\n荣进闪耀迅速地看了我一眼。",
      "source_fingerprint": "abcc2d01138868ad123e51a5cd18e77fc0ee80a719a48c038a459490ebfb3335",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
