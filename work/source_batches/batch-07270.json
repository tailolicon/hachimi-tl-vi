    {
      "uid": "zhcn:bf93575c34b1403b77b24037",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面对“最强时代”的开幕，\n荣进闪耀看起来相当焦虑。\n训练时也错误百出。",
      "source_fingerprint": "dc50ea9dc7b8bc3783e2c76c7fda8d39f92f2a87dead307ef021fa7ed36883be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
