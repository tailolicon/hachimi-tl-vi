      "source_language": "zh-CN",
      "source_text": "憧憬的对象──\n荣进闪耀想起父母的身影后，\n终于能积极看待此次的行程调整了。",
      "source_fingerprint": "844520f96c730171afaf86cc15d5bb714a329d1a498241516a21ab0e3dea310f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
