      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表爽快地答应，并轻松赢过荣进闪耀，\n让她亲身体会到\n“赢得德比的诀窍”。",
      "source_fingerprint": "02823d31a9092e93ed0af5b6144f7ab82d99e4c82488fc61ff4ab2be63987d94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
