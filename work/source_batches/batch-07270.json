      "source_language": "zh-CN",
      "source_text": "要与曾打败自己的千明代表再度对决，\n荣进闪耀难掩不安。",
      "source_fingerprint": "a9506da7820098ed617b9a6c2cbcc1237a72eb83d93581c2e75354dc6a658401",
