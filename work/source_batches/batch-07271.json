      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "他拿出明天以后的行程表，虽然内容粗糙，\n但荣进闪耀仍从中感受到\n训练员希望她继续奔跑的热忱。",
      "source_fingerprint": "a31f9329617dd07c2aae10fac18bec5197d78b21d324d5ec0c248363c5124f5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
