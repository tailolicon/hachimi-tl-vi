      "source_language": "zh-CN",
      "source_text": "经历了各种经验与交流。\n她悄悄地燃起斗志，要向那三个人证明\n她所掌握到的，属于自己的“正道”。",
      "source_fingerprint": "ad34f74e845ff78752bb49211d328d826f68da2a00c7f2eea754361acd00d1fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
