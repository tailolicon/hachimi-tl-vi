      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "却因对健康状态的疑虑，决定将经典三冠竞赛\n最后一场“菊花赏”从目标中删除。",
      "source_fingerprint": "952e70b4d25acf0e54c9041a4354aa7a8b181478cbdf7c90cb67ce24ef6259b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
