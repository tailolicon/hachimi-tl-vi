    {
      "uid": "zhcn:b955ebb1bf5acdf32c904c32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无关乎同期的强者们。\n只要把握住今天抓到的感觉，\n就足以挑战“皋月赏”。",
      "source_fingerprint": "aa0e0b4d8e1edb499e84c12cdf8572c80a99bdc4e259162460db4127d3179a5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037422.json",
