    },
    {
      "uid": "zhcn:48907a7cfeda59ab0bda5e15",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是，训练员决定想个既不用逞强\n又能得到她想要的“经验”的方法──",
      "source_fingerprint": "2b379e18039583c69a9077e007e0f1658dbbe696e1b117c2591502bfa527b6b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037423.json",
