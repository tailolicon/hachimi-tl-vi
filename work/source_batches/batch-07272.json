    {
      "uid": "zhcn:d0275284edf52a4fff8f4c92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过她与其他赛马娘的评价仍有一段差距。\n为了缩短差距，她想到了──",
      "source_fingerprint": "0f370e83bd3332428a8bec6b972de2547d603c3dfd246d6e178f9f051a9126e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1037/storytimeline_501037423.json",
      "json_path": [
