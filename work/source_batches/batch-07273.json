    {
      "uid": "zhcn:f41806d8ebba9a2fc6dbfba5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "带着激昂的情绪跑完比赛后，\n荣进闪耀看到了，\n过去从未注意过的事物。",
      "source_fingerprint": "a0d5628c1fe04c70824f7c5e7b39df79f031d97c92cb61c14246d744151566b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
