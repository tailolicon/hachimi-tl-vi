      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦？为什么呢……？",
      "source_fingerprint": "6d87736fa1c8a070c8153560844c023d780b13e28ab8b4954bdaadba18a0bd52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
