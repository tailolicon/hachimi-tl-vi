      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──之后，\n我就在一旁观摩荣进闪耀\n用利落的手法制作甜点。",
      "source_fingerprint": "1ef144247d435a77e614b69fc31c1f3f0b869bd0a5224675fc99939c5e409da4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
