    },
    {
      "uid": "zhcn:e391b4fb61409eaae94ed457",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我把心里所想的全部告诉她──",
      "source_fingerprint": "e4f1aafb86fc29bed7071660c48b8958a97a1008673a62e57936fc258b8f377a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
