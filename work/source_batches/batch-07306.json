      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此展现的笑容，\n全都是独一无二、无可取代的。",
      "source_fingerprint": "30ecdaad2baf785d135b193b68445531f1ea2b191e530a9ab5612fa627e9b08b",
