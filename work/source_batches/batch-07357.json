    },
    {
      "uid": "zhcn:0583ad346c87a5864321c005",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可爱的认真",
      "source_fingerprint": "4546c876a767171804942cc556f01e05eb5be85280b8eb71df84da3235a20b4c",
