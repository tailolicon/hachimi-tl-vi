    {
      "uid": "zhcn:ba7761ec3214ceef39fd0cf3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真机伶对比赛的想法得到了热烈回响，\n成功颠覆了和记者同样抱持质疑的声量。",
      "source_fingerprint": "e5734faafe94a7b0b2240dd043837db0bb1039f5af325f94a602e0d4bd1b944f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
