      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真机伶正在盘算着\n要在“Umatube”上宣传自己。",
      "source_fingerprint": "e308c299db9d9d38775829f9784c6fe97eee82abf00b3003c0b998c1e5f632d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
