      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员在协助拍摄的过程中明白此举的辛苦。",
      "source_fingerprint": "7030a156825905d7e687edba78b961b9097867b20e222d67884ba66b996aebd5",
