    },
    {
      "uid": "zhcn:02d95093e40d52d4c72de27e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "沿着亮晶晶的东西是什么意思……？",
      "source_fingerprint": "68b1ce9fa3621d3f3b6692d79de2c17c48d1f3b4ab4c8034f5064e1887a2181b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1038/storytimeline_501038800.json",
      "json_path": [
        "text_block_list",
