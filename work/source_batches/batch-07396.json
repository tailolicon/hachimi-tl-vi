    {
      "uid": "zhcn:45e3fd77c87c60289b30efc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "亮晶晶可以说成璀璨、灿烂。\n换成英文有glitter、sparkle、\ntwinkle……闪耀？",
      "source_fingerprint": "84294676e561efe43a577d34d0387217255dc3fd862afdef38a96d24487f70c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1038/storytimeline_501038800.json",
      "json_path": [
