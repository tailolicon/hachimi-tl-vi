    {
      "uid": "zhcn:72291c7483e14f20a2279c46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真机伶的最新贴文是\n在宿舍房间内拍的照片。\n标签是“#中途开溜”……！",
      "source_fingerprint": "99c007a81c8b06033711189186bf30fdf98350c9433840bae44e7cb2d8c46999",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1038/storytimeline_501038800.json",
      "json_path": [
