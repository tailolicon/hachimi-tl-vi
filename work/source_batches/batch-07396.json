    {
      "uid": "zhcn:37210537012027c75aabab52",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许该用其他意思搜寻关键字。\n换成同义词或其他语言是经典题型♪",
      "source_fingerprint": "a9e9a0ec8c647c4cdc08789c6fa604d2182bfd25881a727bcec0b378abd855be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
