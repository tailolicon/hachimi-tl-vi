      ],
      "json_pointer": "/text_block_list/21/choice_data_list/0"
    },
    {
      "uid": "zhcn:e113ab9fb47047e9aa8c675e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "换句话说，这张照片是某种提示。\n消息提到“沿着亮晶晶的东西”，\n并要我去找她。",
      "source_fingerprint": "08bd6fcc040fdffdd386622d95ef63bf467a46823bbf4d896bd216cf2bc3b980",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1038/storytimeline_501038800.json",
      "json_path": [
