    {
      "uid": "zhcn:b4f6f186992c5a541e13c32a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "解谜的同时我发现了",
      "source_fingerprint": "939760c3ec32b746ca499d867fd61eed473bdf72dffbbe498717bd85088ebdc2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1038/storytimeline_501038800.json",
      "json_path": [
        "text_block_list",
        39,
        "choice_data_list",
