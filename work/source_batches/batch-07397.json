    },
    {
      "uid": "zhcn:5195be0612a280f945062e44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是要我像她穿上决胜服一样，\n说出心中的想法吧。",
      "source_fingerprint": "1db09f299b4162b16fb8c14e241f34074e7d6bce87c07145d1a4915f52446582",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
