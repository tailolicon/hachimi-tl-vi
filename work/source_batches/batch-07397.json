        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:4b894651c577660b33fe59c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我告诉真机伶，现在的她拥有女王般的\n品格与美丽，配得上那套决胜服。",
      "source_fingerprint": "0124d10768e216af2232fef820fca572fdc70c069ba769e577f14b965f142db1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
