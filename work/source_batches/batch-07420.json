      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:7829a8956f685f72b79595f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔，是那个小魔女跟暴冲赛马娘。\n暴冲赛马娘就是“橡树大赛”的……",
      "source_fingerprint": "117188afcd9955cb7103780b5d3d7b7bd787dbb9c25cc7b441422e961bc3def5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039115.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:f7cec437908e92d18f22143a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这样不要紧吗？",
      "source_fingerprint": "66ba21cb2cbc9b7167c1cd6bebb20d3f2d96db21893cd1076d23ba58fd19e86c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039115.json",
      "json_path": [
        "text_block_list",
