      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:9d666f8363c47f2ee13ff66c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "川上公主",
      "source_fingerprint": "6fdad786a4d6323b0540a6036476cf92ac347face738a3822759994bd866a68a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039115.json",
      "json_path": [
        "text_block_list",
        40,
        "name"
      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:8e31a22a89c3c7cba5320eac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎呀～用不着你提醒，我也一定会去参加！\n而且我绝～对会轻松拿下第一名。",
      "source_fingerprint": "b50ed3f29bb80ae669f2e226284a2967dae74c6ef53c3ba9c1d94b3ccaaee2d8",
