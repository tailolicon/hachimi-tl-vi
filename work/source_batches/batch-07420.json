    },
    {
      "uid": "zhcn:d93699e94cf91ec7a42b2979",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "路过的女士B",
      "source_fingerprint": "6d2018a05db783fee4b3c3cdb528cf28c16527a22a99f97cfabdaffb58f2a706",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039115.json",
      "json_path": [
