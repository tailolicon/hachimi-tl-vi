    },
    {
      "uid": "zhcn:293ffe3f8832fc668848ea76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们是怎么回事……\n吵架的方式真是一点气质都没有。",
      "source_fingerprint": "da43b67f9ff0cd163574b8525796b459ada389763ad5bf5fdc6545efe119db27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
