    },
    {
      "uid": "zhcn:481ee257206ecb3f9fbfa8f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算信里的内容可以归类为“意见”，\n但这些意见却是包含了各种要素。",
      "source_fingerprint": "5b9c8762791e3acdfba86b60d4360b5d4f970db77b06a52c1c773728488cbdd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039116.json",
      "json_path": [
