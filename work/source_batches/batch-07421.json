    },
    {
      "uid": "zhcn:fc9a99f4aca2afcc0649510b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──支持、赞赏、嫉妒、批评。\n并非全都是让人开心的内容。",
      "source_fingerprint": "e385f071be132a5d6631ec98074e5dc2990b0165e36f42398bc2c7453a3a404b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
