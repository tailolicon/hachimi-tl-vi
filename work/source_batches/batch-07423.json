      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:32d50d8b1145bbab172428a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实我有跟训练员提过，\n下次想请川上公主\n来上我们的直播节目。",
      "source_fingerprint": "163074bf740e0214d5c452e90e1bb91a43eeff4335816cf9d1e2b09b120a0643",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039116.json",
      "json_path": [
