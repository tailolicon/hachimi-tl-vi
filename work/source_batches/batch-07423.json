      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我今天跟川上公主一起来到了\n中京赛场。",
      "source_fingerprint": "829b19cce3b512d1e415ced56327f7b154d0f02850fe29a44f797faaf128161c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
