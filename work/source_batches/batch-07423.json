      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "拜托各位了",
      "source_fingerprint": "520590ba37c342c46ebf4b092364ee37ff2f7e19658ba676363b34e788579438",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
