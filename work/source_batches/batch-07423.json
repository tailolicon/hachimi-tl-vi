      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我是公主吗？",
      "source_fingerprint": "2722638f02b5d5eefe92abae0962006e1345e79f210c6edb93c9e495d1d4c893",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039116.json",
