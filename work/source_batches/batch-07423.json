    {
      "uid": "zhcn:5fb42233ddaccce6bf33e7c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，我从今以后一定会谨言慎行，\n不愧对公主的名号。",
      "source_fingerprint": "73e8469015d03351b93da1b3e58b517840eac8e97dbf529c09165755990719fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039116.json",
      "json_path": [
