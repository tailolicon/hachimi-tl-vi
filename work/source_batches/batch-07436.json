      "json_pointer": "/text_block_list/7/choice_data_list/0"
    },
    {
      "uid": "zhcn:978c44fca2185c18e0c716ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，她依然没有被局限在眼前的胜利，\n而是努力面对现在的自己必须克服的功课。",
      "source_fingerprint": "bf190d9f0239c5cc403a151bacc9786e774e65c0d42b9c1c574ed7a3eef7afc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
