      "uid": "zhcn:76041381bfd12977a2fa8f12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑得很好喔",
      "source_fingerprint": "3619de796be68146ec9b957931392d667cd1987e862f99294e5407a9d158a2ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
