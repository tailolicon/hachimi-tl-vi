    {
      "uid": "zhcn:1e82959cf04841bcdccb7266",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欸，你找到想关注的赛马娘了吗？\n我的话──",
      "source_fingerprint": "1d5a4d55c7f5307992534d9d5d44b96a2ddd7a9ac042aaaaaa7f1d47ed62fdbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
