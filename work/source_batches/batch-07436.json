      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:8ab1d429876924158b758662",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众的情绪是前所未见地高昂。\n明确感觉到受人关注，可说是一生一次的舞台。",
      "source_fingerprint": "425ca5229cdd0564cbcf1b8cea4d2bc58e93f18b992441c311e8dea5361fa0e9",
