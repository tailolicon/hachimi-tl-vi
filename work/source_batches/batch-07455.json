    },
    {
      "uid": "zhcn:462d2f9893f90d31ff80cea5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金鯱赏结束后・动弹不得，也不肯动弹",
      "source_fingerprint": "ffc467ba37d61abee43aaf54ff53c34540fe78328a97ec7c7171ad71fb577830",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
