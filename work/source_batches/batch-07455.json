        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:de32a95293546da3a271ba1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "变革虽然嘴上不饶人，\n实际上却很担心我的状态。\n看她现在笑得这么开心，我也很高兴！",
      "source_fingerprint": "60a2c9f4f08ef0efc8891a6f6a11859615b5f8da62ce761e5d1224b56df880ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039430.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:d5a36d5bd97d38568096b165",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而我经历这么多迷惘却还是能走到这一步，\n全是多亏有训练员的帮助……",
      "source_fingerprint": "67b070df55fbca1212d66e6b7e0ba5b5458b96131fb9a8ff2dc0c3e988b2085c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039430.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:cd46ee845501d7adb5a7737c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是我最棒的搭档。\n我们一起成为《公主战士》的\n传说级的训练员跟传说级的公主吧！",
      "source_fingerprint": "a30942406004e65c5e9be2cf050e665a420097d2770509915bb54a9e7200fddd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039430.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:aa1d14c64d3eaa19d405fd32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接下来是“宝冢纪念”！\n我要在赛场上大展身手！\n看招！公主☆天崩地裂──！！",
      "source_fingerprint": "a060ffd2694326a92dc1fab0aae73c46d7e4fb1e5ecfeffd9392cc57a7746644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
