      "uid": "zhcn:0dfa3611a032a968280e224b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我成功在“维多利亚英里赛”\n留下了好成绩！",
      "source_fingerprint": "9b1315377d8c2bdf5db457b778ba13e868fd57e1d3853a5229874adc4afdd7ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1039/storytimeline_501039430.json",
