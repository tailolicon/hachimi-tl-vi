    {
      "uid": "zhcn:0533f52f9efd82c19fcce50e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金城市为了出赛“日本德比”十分专注训练，\n状态可说是非常好。",
      "source_fingerprint": "5235613c12916d319bd81a387f706afb5305b8df4f0a3e1c0634c265257292b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040404.json",
      "json_path": [
        "text_block_list",
