    {
      "uid": "zhcn:1ba2cc931e9e5cfb593f469b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要让大家肯定自己的表现──\n怀抱同样想法的两人对彼此发誓，\n总有一天必定要同场竞技。",
      "source_fingerprint": "0ef5ae90d859b15e44a437e89deef3ed2b6932b68e5e945603204df35aa6f470",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040403.json",
      "json_path": [
        "text_block_list",
