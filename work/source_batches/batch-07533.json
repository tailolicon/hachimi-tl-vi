    },
    {
      "uid": "zhcn:d1e69188f664971dd9602111",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040404.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:fddd9a458fbf5a8e8409e5ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金城市已经借由皋月赏渐渐得到肯定，\n而玉藻十字不允许自己落后。她燃起斗志，\n并决心以双脚击败所有逆境。",
      "source_fingerprint": "4925096e09cf25ba42255af66155b6272f0c65896d89e000f81176b4af46d80e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d3265f029a312b470e5e595c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040404.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:78761ca81388bd8d1aa90ebc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金城市受到她的气魄所震摄，\n重新提起干劲面对德比。",
      "source_fingerprint": "260bb20946fc1b9ff3e627e4add4b0d6af22251179008cdddb8cd0975a09dfb5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:00f6e2b26ce1cfbb5d148d31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "激昂与焦躁",
      "source_fingerprint": "4d1037d22c85798e343ee74af52d79d5e91192dab5ac4752a47de0df491d36b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040404.json",
