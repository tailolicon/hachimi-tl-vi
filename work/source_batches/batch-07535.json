    {
      "uid": "zhcn:8153eb4f5e3fbeb9eecd011a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但之后她却又在匿名网站上\n看到许多人的留言，\n热烈地讨论着她的外表。",
      "source_fingerprint": "f091a805b2269b87740c41656c30a8222fa3b1dae2689faddfb4a94d6d76590d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040424.json",
