        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:bbc464159fd53eafe2c02a85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看见那些留言的东瀛佐敦\n流下不甘心的泪水。\n而黄金城市只是因评价没变而茫然。",
      "source_fingerprint": "4bda3dcbb74d1ad926857f6c683fd88fb291ce358df8ac39dd4afc7c8a74d119",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040424.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:b7b5dd6acf2c43b46581a2fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040424.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:f0d839971ac4d719e012fdf8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时训练员告诉快要放弃的她，\n现在只能继续跑下去来逐渐改变评价，\n并且向她提议出赛“有马纪念”。",
      "source_fingerprint": "6dbc4cc7fc6a1ff9fe9e4df24bee7c84cdc73a48b24b21f7c029bf6eb2631f84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040424.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e9223e959a7931552a2666eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花赏结束后・“洋娃娃”",
      "source_fingerprint": "718945c76c513a263282ae4ca6830d93ac6be6a519261816952988c5478261cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040424.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:127af69f2a52c8a7d8f0b9ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金城市赢过了玉藻十字。\n但就算赢了，大家也只称赞她跑步的样子，\n丝毫没听到有人赞美她的实力。",
      "source_fingerprint": "861527e5dc0fb93d142bb1f2edc6dd346686ca07a000cddee335a73e8c37be8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040425.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0240fc02619d8a9d6eba3b16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玉藻十字则相反，即使输了，\n她的表现仍备受瞩目。\n看见两者的不同，黄金城市大受打击。",
      "source_fingerprint": "d302eb2ef048b819cb8e06ef662a294261aa7786f7b6c7172e738bd6803f92ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040425.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b3607a1819d9aa77d72b7c74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玉藻十字对黄金城市消沉的表现愤怒不已，\n并问她究竟为何而跑。\n……黄金城市无法回答。",
      "source_fingerprint": "f6b94e1dff3f9fd9b1264b657e643c40c5f81a9a593887dfd05a0b44ab4e85bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040425.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:af733138b444d1641b58f584",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金城市忍不住对训练员表示，\n不管做什么都无法改变评价。\n然而，问她是否要放弃跑步时却又不点头。",
      "source_fingerprint": "07586ea59ddd585b534c2763e12aab7853d20c2d5ae119a66e9ffe18eb33f971",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040425.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:b881cebf4e2d7a24dc649c13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她并不想放弃跑步──训练员察觉到这件事后，\n便决定以春古马三冠为目标，\n让她参加“大阪杯”。",
      "source_fingerprint": "de9de028d837dd2bbe959fc9c0035ccc39e427af25b00f71a6c97b21c01261f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040425.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:789fef77193fb334e7f0ecf5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・放弃的念头",
      "source_fingerprint": "66d93cce6e47f85327116d6996c85a1e8429af71cb2c91397b04207ebfd85772",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1040/storytimeline_501040425.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
