    {
      "uid": "zhcn:2af5b25d478b8d3673f4dcc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王",
      "source_fingerprint": "fb83f0cfd91efed693a0e2da1635e6fbe976243d887008d948a31b60847aa357",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041317.json",
