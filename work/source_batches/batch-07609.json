    {
      "uid": "zhcn:11ad240ba9276504e43db8a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实我刚才，发现到一件事！",
      "source_fingerprint": "271e7b929f99644a772e27008b789176ac0910776338330f22fc76a01e5f44f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
