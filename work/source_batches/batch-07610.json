    {
      "uid": "zhcn:e15d623edcea56e81c30c002",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“英里CS”终于到来了！",
      "source_fingerprint": "c58c12dbec589e7fad0c11922b2f3a8e8333759403d286d1addd7b78cffee85a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041418.json",
      "json_path": [
        "text_block_list",
        0,
