      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:84b562f5dc0f0ea52e1d44f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "到了第三年，\n总算踏出了通往爆进之道的第一步！",
      "source_fingerprint": "378e7afa493ce53d7922b85ea18a17f978a81128bccb3dc94e8db1abfe542581",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041418.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a3baee4108983a51bbdb9cc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了获得最强英里跑者的称号，\n樱花进王奋勇爆进！",
      "source_fingerprint": "5a34fb88199d80eb3147632898364a0c7ea79237eff45d421d7638d22b3b582f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041418.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:5afe011b2e91fd76dc5bbe25",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向英里CS",
      "source_fingerprint": "9e000cb39e6ad6cc7160191f317779c075bdf528f3b0231716cd4759668b4bb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041418.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:acb1651c03663a412e19f40d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "漂亮跑完“出道战”后，\n樱花进王确定了自己的实力，\n于是打算乘势直闯GⅠ赛事。",
      "source_fingerprint": "076b5aa7f96646849ac2e895301f79ae72dd27cf74407483a0382813c6f5bd5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041419.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:f5e3a92ef1b0a15f2d530b7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而她没有实际战绩，不能参加GⅠ！\n训练员为了让她跑擅长的距离来观察状况，\n便含蓄地建议她参加“京王杯新马级S”。",
      "source_fingerprint": "5b5d4adeb35822e3e03325bff76bcf5d25d1ee05a1d4358827a615ff823a4615",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041419.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:55cb0f6b66e8b579d1ddef3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王本来不太愿意，但训练员劝她\n应该先让许多观众认识她的速度，\n于是她顿时变得充满干劲。",
      "source_fingerprint": "d0f99afaf0f726e8fbd20df80a2199d8233718d4d2d1fae54581444714f0089a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041419.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d8901f3f46d22c789b3d5e73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，樱花进王的下个目标\n就决定是“京王杯新马级S”了。",
      "source_fingerprint": "814582306ce94fc18ba7984ddff218029150376264d76dca7b08c66be9b79376",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041419.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:74dc7dc02f63bd524a6888d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・开始爆进！",
      "source_fingerprint": "0eb288dfb5fc479904090c758c462915213b3454e10875e8482bda7d28833b16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041419.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:2e35548efd55a99bf06fb9ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王在观众面前顺利亮相后，\n她斗志高昂地想迈向经典三冠路线。\n然而这对现在的她来说，难度依然太高。",
      "source_fingerprint": "f8fbdcc7e3cc6d6c1ebdf55b96fd25d267f2b1db0b5b43332b9e0ce314a103a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041420.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:5c95d8459d5924f843c40a8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员对此深有所感，\n于是为了保留时间思考今后的方针，\n训练员建议她参加“春季S”。",
      "source_fingerprint": "7f99155e3191ca2c0a60b231f4c91b5dd33c2ec700105eb2fead273cffb6fb29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041420.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:162ab506fe07368ccdae3ebe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听到这么做是为了替“皋月赏”布局，\n樱花进王感到心服口服，\n于是决定出赛“春季S”。",
      "source_fingerprint": "6ccca7bd90b7ce31b753fa5c8d1057e420dcdeda28d6f77871eb89d513ef65eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041420.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:c00ee70b1a799300876c1a34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "京王杯新马级S结束后・迈入春天",
      "source_fingerprint": "1fc7cab30ca775d60c2280e7c356580230bc288bc4668d7eae524124f12af041",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041420.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:b44401d0e8ff05f2e415dc4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王轻松克服了不擅长的距离\n并夺得胜利，她斗志昂扬，\n认为这样就能前进经典赛了。",
      "source_fingerprint": "9b1f5d43576a9262a9e1b9d17c4430d1574121b75e00c91ebb533aed4136215c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041421.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:7342d419eca93b4167bb24b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但训练员想让樱花进王发挥速度长才，\n于是极力说服她参加“葵锦标”。",
      "source_fingerprint": "f2413a5fc58e54de9a987317f1d7b620100229c6a22bcd81ebacecb4a6b9e671",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041421.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b5b22a9ed208bcb256c99eec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听到训练员表示想追求更快的速度，\n樱花进王大受感动，\n于是将“葵锦标”定为下一个目标。",
      "source_fingerprint": "15899910adc6d211d89a1dcda3b9503c69dcd136fbe42575875fbfbb5dc5f919",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041421.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a2c523cda8aed78cba7180e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春季S结束后・速度取胜",
      "source_fingerprint": "4754874a72c31b0a6e814c4480c17a5f1b77e9e668c956ce62504ea366e842ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041421.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ca08f332369701ad0c16be0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王在比赛中遭受挫败，\n她因此大受打击，怀疑自己没有才华，\n同时也乱了方寸。",
      "source_fingerprint": "49eea2f440e28f1974a0e7fe48f4777ed84e57b6f2d5abe01854373c7652176c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041422.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:08a09580f4ef4f928e9d5500",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员鼓励她，\n说只要再努力锻炼速度就一定能得胜，\n并建议她参加短距离赛事“葵锦标”。",
      "source_fingerprint": "17a81b51653185fe95dfeb94d3f3705da779914f31623ac86dfeab238b61c598",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041422.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:1b8de166905cb980e7f2bd11",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王相信了这番话，\n并且干劲十足地决定在下一场赛事到来前，\n要让自己有更多成长。",
      "source_fingerprint": "28cf81989da12b68d08d9b8a9f16398e99f2c667352e0efb466df573e946d7ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041422.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ee0b886f129c549e65735eab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春季S结束后・爆进成长",
      "source_fingerprint": "d49b18362bf6db10ba879dc9615a4f176cfe31deb80fb50165ef2ae73b231133",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041422.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:7a4a00e6b04d20496018619f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王以超群绝伦的速度\n在比赛当中拔得头筹。",
      "source_fingerprint": "31989d2fab9f3c16454b916f128ab6d5fb01562f03c2a20141c4f6634645ce5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041423.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:b4b54df6119d58a208de7019",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但训练员说这样还不算达到极致速度，\n提议让她参加短距离的顶尖赛事，\n“短途马S”。",
      "source_fingerprint": "387f70e0a9b307532b67c606e43eeb83f02de4d69d4d623192cc9c3595af4fe6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041423.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:690bcec94f641436e81379b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了获得最快的称号，\n樱花进王将挑战“短途马S”！",
      "source_fingerprint": "b5d4333c08ea7e630bf144fcc4a2fa379010c404569f2b449c3c0f1ce1cec2ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041423.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:938cfc28e6d045bc7e411ddd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葵锦标结束后・爆进，极",
      "source_fingerprint": "57f69494da3e67855255a7fd0b249ad3f14f8480dbbf5ba9eccac17d14425a8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041423.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e2d1675d48feda7559d23640",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花进王与西野花的对决令人紧张不已，\n最后比赛由樱花进王赢得胜利。",
      "source_fingerprint": "48213e2ed913aa561f63567a86cd67e9868488c508664eeea4f484eee15fb5f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041424.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:d9c811b884f22150f66002bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但训练员使出激将法，\n问樱花进王想不想以更悬殊的差距\n赢过西野花这号强敌。",
      "source_fingerprint": "b7a399f28789f0bc308ba55642da4b8de6cc86bf2b64ab0d61e419bb14528715",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
