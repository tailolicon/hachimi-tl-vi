      "source_language": "zh-CN",
      "source_text": "嗯，好的！",
      "source_fingerprint": "adc53a9149fc343fd9cfabff127419de3be763676fcb5885a2fa73cf182f2dd8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
