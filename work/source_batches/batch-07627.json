      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "基于学园的特性，学生转学是常有的事。\n话虽如此，一旦真的遇上，\n还是很难坦然面对别离吧。",
      "source_fingerprint": "07b8722e6821f81057b587ab4cfd441513f265530cd46fc5947512412973346d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041702.json",
