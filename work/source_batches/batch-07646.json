      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:b1c110d0797431e01c1926ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老师",
      "source_fingerprint": "c9a31a3f670b7f9973f2004ed383fc8c50a20c8d595556b8d8c266630234d8ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041801.json",
      "json_path": [
