    },
    {
      "uid": "zhcn:5e460deccc8134e35ae28114",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，不然就照座号吧！\n来来来，大家按座号排好～！",
      "source_fingerprint": "685964a5d32898e63864f34aaebae0e84396924a65d45bfd7217b1a47771380c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
