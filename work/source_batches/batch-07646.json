      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不用担心没关系！\n大家一起好好学，\n让自己可以在路上安心奔跑吧～！",
      "source_fingerprint": "7436f4458e0e4e2057a19d10ed91a76f8d2f99c59640d0b2b1506cfff21a58f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
