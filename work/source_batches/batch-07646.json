      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被指定为第一棒的小学生赛马娘\n战战兢兢地踏入赛马娘专用道──\n这时，她后方出现了一名高速奔驰而来的赛马娘。",
      "source_fingerprint": "682660277f5050899c4d61ec07665255694c37be3fc8d8d737e3b6f704909840",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
