    },
    {
      "uid": "zhcn:fc1bc5ea19ea7c9fd223d3d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "人、车、猫！！真正的道路是一刻不得闲的！！\n现在开始，要请大家跑这条路！",
      "source_fingerprint": "6dcef715daac38d05b3ad404cfd12f3f254e208389dc7ddd4c352b8aabb5b2b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041801.json",
      "json_path": [
