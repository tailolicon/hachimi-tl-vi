    {
      "uid": "zhcn:9496f4a44b433d01c67a0a91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先不管什么事都要爆进爆进！！\n来吧，谁是第一棒呢！？",
      "source_fingerprint": "6569e66b3779368258c9ddb3beacaa8ef81db2cbf978589b0a00a2a787ac312e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
