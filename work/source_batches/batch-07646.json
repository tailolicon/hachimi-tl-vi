      "json_path": [
        "text_block_list",
        14,
        "name"
      ],
      "json_pointer": "/text_block_list/14/name"
    },
    {
      "uid": "zhcn:7b0d1de874fdcd940ad49c06",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──谁、谁要先去？\n──我不要第一个！\n──一定会替别人添麻烦的……",
      "source_fingerprint": "ec025cd3e4bdb8f47cff9561ed9a85a58bdb0667f577da58573fc8ca06b742e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1041/storytimeline_501041801.json",
      "json_path": [
