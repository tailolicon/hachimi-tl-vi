      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:a9144b4a6b885977619b7a2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "年幼的赛马娘们",
      "source_fingerprint": "6c0a1e3e5e9b3a62cbd7df3583244e1c6976872223fbf21247b04ab708c8a1bb",
