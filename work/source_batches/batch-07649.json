        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:1875bdc89046f82b57468ac8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还必须被迫在不熟悉的环境中参赛。\n这曾让许多知名赛马娘因此失利。",
      "source_fingerprint": "046adaa6295920c7a8494d8b0386af361f1f29c31b23929a81b0aab347118307",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
