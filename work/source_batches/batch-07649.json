      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这才称得上是impossible！\n是值得达成的壮举。而且──",
      "source_fingerprint": "ec6901fe8321b6e604c90622d25fd16ddeba893dd39a98544b4e540505d10a0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
