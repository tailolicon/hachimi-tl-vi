      "source_language": "zh-CN",
      "source_text": "就是“欧洲GⅠ胜利”！",
      "source_fingerprint": "fe6c8bcc91e6de81fd4eda5f5674e80e4df03e62d75e62012d6f4032eb4b691c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
