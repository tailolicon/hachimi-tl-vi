    {
      "uid": "zhcn:4b530b4242d03acdd7012751",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──欧洲GⅠ胜利。\n这对特雷森学园的赛马娘来说是宿愿，\n也是无法实现的梦想。",
      "source_fingerprint": "68eeae6f2fcd3c5f8c19d673ab3572210390552302ee416cb8df85cfd68f539f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1042/storytimeline_501042100.json",
      "json_path": [
        "text_block_list",
