      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:7c6e67e559a1085c25fc4ceb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欧洲的草地赛道，无论草皮种类或路基\n都不一样。除了需要具备极为强大的韧性外……",
      "source_fingerprint": "c454161d614d41e1d05df63f4c6e8d0275aebf9caaeab8d1dd6d2c266129b928",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1042/storytimeline_501042100.json",
      "json_path": [
