      "source_language": "zh-CN",
      "source_text": "采珠说得没错。\n她的目的是将不可能化为可能。\n换句话说──",
      "source_fingerprint": "5a92c2bbfdda713a2dd8f89852fc674b4cae726844e4e7a2fb8fbea3b2b8f93f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
