    {
      "uid": "zhcn:7fa30e5e71d6cc2a9db87e61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，今天要替我的国外远征送行的劲敌，\n是哪些人呢？",
      "source_fingerprint": "f2fcff94b5318f8aa900b5fb5c20252c24875809566953b5db30eef1d603cff9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1042/storytimeline_501042207.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:75e2e4e9282f8bdd11e32b91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？？？",
      "source_fingerprint": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
