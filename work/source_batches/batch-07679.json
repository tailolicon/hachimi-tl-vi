      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "OK。\n暂时要跟国内的追踪者们道别了──",
      "source_fingerprint": "4cf55b20c8641d3da287529f0db51a1c49240e91aae76206b2d742cea038fc14",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
