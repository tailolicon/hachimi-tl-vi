    {
      "uid": "zhcn:7721b519e2ccf20a1d1adfc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，我要上啰！",
      "source_fingerprint": "c3604c1adac25be66b4ba8176bee9bbe87caf466c0729f619139ebf88d882bb2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1042/storytimeline_501042207.json",
