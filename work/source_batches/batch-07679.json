      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──谁都无法预测国外远征时会发生什么状况。\n正因如此……",
      "source_fingerprint": "6566a03524a478f125480bc3891eca0a38b93017dfa4b42ba07ccae4a07a81cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
