      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:d43a4cb27eaa0726120a0f54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从上方现身的，\n是崇拜英雄的赛马娘，微光飞驹。",
      "source_fingerprint": "361a71f3b36f425a2f27c2736a35d04b55cdd64c751af9aa6561ba379bd363cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1042/storytimeline_501042207.json",
      "json_path": [
