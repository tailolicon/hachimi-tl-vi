      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘的家族。\n我当然知道他们的存在。不过……",
      "source_fingerprint": "896faac94e8368a21a0eff72af5ce43c9137f2d0208d80b0c9e1f72266b2bd97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
