      ],
      "json_pointer": "/text_block_list/10/choice_data_list/0"
    },
    {
      "uid": "zhcn:6f2e27e903d272ef1032e1cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要在电影院上映当然也是不可能的事情。\n有没有什么办法能不泼她冷水，\n又能推动一个这种方向的计划呢……",
      "source_fingerprint": "141c06626bc888f59b62fb3b0c7a343500f8546d56be83011eb044789666a2bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1043/storytimeline_501043113.json",
      "json_path": [
