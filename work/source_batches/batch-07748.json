        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:e0a04c25b1962348f1c94585",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要制作一部电影的难度太高了，\n所以我提出改拍PV的建议。\n也符合她想宣传沙土比赛的想法。",
      "source_fingerprint": "08edc0e773a5fbc97c91fc8153a7c88afce30a3c692fa5723ea117f053ae850b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
