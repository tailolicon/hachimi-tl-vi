    },
    {
      "uid": "zhcn:cb3ab6ce9ee19c425bfadf66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对了，如果是简短的“PV”的话……！",
      "source_fingerprint": "651f2b4067cefbeba724f6f75305e3018f9ec8d148f84acad9d58b885fad67c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1043/storytimeline_501043113.json",
