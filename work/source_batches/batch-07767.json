        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:fc6f46dc4cebf7ab53fe2702",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而却也并不会达到她所希望留下的\n“强烈印象”……",
      "source_fingerprint": "4a2dec1cc9e6aa00bdbdb7db4a37fe81b359c1be07e9b3736918e32b57329e05",
