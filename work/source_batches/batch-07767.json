    },
    {
      "uid": "zhcn:0795b93d73e2227df7578294",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "得奖后，就会有一个“获奖”的成就，\n社会大众也会因此赞扬她。",
      "source_fingerprint": "e5a3c4fe0a01ef4a551bdb511a73bd368cf3098162a0bd651738263cb17f0557",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
