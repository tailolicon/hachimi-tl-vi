  "entries": [
    {
      "uid": "zhcn:19707da1142306f741e78f41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "拥有过人的“力量”是她的卖点。\n比起草地，她应该更适合沙土吧。\n她本身也因沙土更符合坏蛋形象而感到满意。",
      "source_fingerprint": "2f75d921dd9d718033e5b34bcb0eb4e54c0fe9b00b25c72dc251ddced96f6929",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
