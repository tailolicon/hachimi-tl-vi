      "source_language": "zh-CN",
      "source_text": "东商变革",
      "source_fingerprint": "7281a4e36830a49e7bf9024c39a41d6bf86957e1a7ed32a98967bb65c8a03663",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
