      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我走在旅馆里时，\n正好看到东商变革从更衣处出来。",
      "source_fingerprint": "7bea118b897d0a489255ceb32c9005ebf2710b30d45bdd9f00f2f413a3ea2f37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044112.json",
      "json_path": [
