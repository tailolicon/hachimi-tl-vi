    },
    {
      "uid": "zhcn:427662651b0b4e3ad36e5e22",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看来我在开门的同时，\n被枕头砸中了……！",
      "source_fingerprint": "41b9ee94fef55f8ef64156ece3771814bab2f50bdeadc9fc4aa8f8d467e15166",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044112.json",
