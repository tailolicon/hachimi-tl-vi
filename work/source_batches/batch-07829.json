    },
    {
      "uid": "zhcn:b771f1ef350cdc13169f5a41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你胆子真大！",
      "source_fingerprint": "9cacb13a665b870580ae11b9de5ed1cbf686c5d38689298977031ac3fb13cf86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044112.json",
