    {
      "uid": "zhcn:40a1993411837658ad52d84d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东商变革",
      "source_fingerprint": "7281a4e36830a49e7bf9024c39a41d6bf86957e1a7ed32a98967bb65c8a03663",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044112.json",
      "json_path": [
