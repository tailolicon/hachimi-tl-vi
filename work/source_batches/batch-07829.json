    },
    {
      "uid": "zhcn:22d701e46aa33c4d99874a36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来旅馆就是要打枕头战吧！\n看我再送你一颗！",
      "source_fingerprint": "ee8d20cc7b588ed42eb40295f443fa7e16b9225b33b33ba8a4654b8cde3a528a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
