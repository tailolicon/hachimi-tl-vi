    {
      "uid": "zhcn:6384f4064658554a88129a3c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对了，用魔法让电车变快吧！\n“时间加速！百合水仙☆”。",
      "source_fingerprint": "9dc97ca835279336d01a8c3170688e2d54f35316bc97376d0ac9f8f062e5547b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
