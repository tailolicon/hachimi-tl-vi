    {
      "uid": "zhcn:0c609a764335769d54277ecd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……没关系啦，我就是改变心意了嘛！\n话说电车不能开快一点吗？",
      "source_fingerprint": "47e09ba7a7bf9c276c6ed073681fdf110d38ac97e238ef9daaae2fe15df6ee52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
