      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:34d64ac8d6c0a0e6a6e812cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和东商变革共度了三年的时光。\n在这段不算短的时间里，\n或许她也渐渐变得成熟体贴了。",
      "source_fingerprint": "fe99569ec616f28f254cfae9e35e7941d1b6e47d18c222fc188c7e52401d4ff2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044112.json",
      "json_path": [
