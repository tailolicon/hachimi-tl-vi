    },
    {
      "uid": "zhcn:afac92aeecc807714e39e76f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她一直以来都有好好参加训练，\n所以不需要怀疑她的干劲。",
      "source_fingerprint": "fdd7eff5b123709d9fd18a8e6e075d41cab48e7bb0dd1f945f96d4f89ff8dbc4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
