    {
      "uid": "zhcn:6198af992ca7710f88113790",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果她一开始就不想跑，\n应该不会来训练。",
      "source_fingerprint": "c709a0431bf3e3f285fd92dbcbf95fae258814ce76e860f1f700d8edbb12aa51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044114.json",
