      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在等东商变革的期间，\n雪花开始缓缓地从空中飘下。",
      "source_fingerprint": "d01510acd05c63a2091337824449bb49afd6254b05ec498f45b15d14a23c4915",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
