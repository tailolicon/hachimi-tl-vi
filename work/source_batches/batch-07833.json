      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我用手拍掉肩膀上的积雪。\n衣服被雪弄湿的面积逐渐扩大。",
      "source_fingerprint": "02c7c79472a81c55d92e2f6149e6a82ec8712d9c1b0a7e4c6a165efcaef784f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
