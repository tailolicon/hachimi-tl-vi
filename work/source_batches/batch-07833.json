      "uid": "zhcn:7154e0b652d4078e7b189601",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我相信你，所以愿意等待",
      "source_fingerprint": "02aaccfadce4b26e6a25e0a02afe8b2c59830fee2d1cc96dd0111841d7221f1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044114.json",
