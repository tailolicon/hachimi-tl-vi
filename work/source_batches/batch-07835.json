      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:78b9ad4906eae422a3920b63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们的身影如盛放的花朵般优雅，\n同时充满压倒性的魄力，\n让人光是观看就忍不住屏息──",
      "source_fingerprint": "b22592c6e9ae87a770b97de438b4aca8c6cc7bdc6c6b70f39851de54024c83a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
