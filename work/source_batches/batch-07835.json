    },
    {
      "uid": "zhcn:aaf1946203e564f004b8ca31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看展的客人C",
      "source_fingerprint": "fd199c5eb12bf8da421b8ee9d0f6c2ff48bddea164166705b6b2cc3678a83519",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044115.json",
      "json_path": [
