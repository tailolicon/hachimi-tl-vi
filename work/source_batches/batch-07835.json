        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:9d386942c653d32d862004e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哼哼，你知道吗？\n看照片也是一种学习！",
      "source_fingerprint": "5b2e299ce6f1656d19076441d57c9ed833f96e5d7e2d1dbd29455a484920ce5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044115.json",
      "json_path": [
