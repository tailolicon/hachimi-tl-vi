      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那一定就是……",
      "source_fingerprint": "6483077a8b802cd6c7208deea719da6f018498ae374ebcbef76be3ed7b1c6b30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
