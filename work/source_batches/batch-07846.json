      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──一起去闪耀系列赛寻找魔法吧！",
      "source_fingerprint": "fafeaec9acefdf9717b74fd1c8c349bd4e2a12e03efb31034bec8079c1820f35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044202.json",
