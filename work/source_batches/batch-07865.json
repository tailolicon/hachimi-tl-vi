    },
    {
      "uid": "zhcn:bb693e2dc27c1e82eed5dc35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她跑步的样子魄力十足、资质绝佳，\n甚至就像是真正的魔法。",
      "source_fingerprint": "0d7c7238de042aaada2dee8b91c6b22280b7b61da15f022975b13e0e370d62df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044400.json",
      "json_path": [
