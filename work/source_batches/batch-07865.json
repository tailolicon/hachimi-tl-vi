      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员和任意使唤使魔的任性魔法少女，\n一起挑战闪耀系列赛的日子就此开始！",
      "source_fingerprint": "67cce2c3afa96489efa8a87602fa9b8fb31159e02cf60bb297bc805aa95b458a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
