    },
    {
      "uid": "zhcn:8e90dc523561b834e676c785",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而她的性格十分任性，\n不只把训练员当成“使魔”，\n第一次训练就将周围的人耍得团团转。",
      "source_fingerprint": "9ea2f65f5488a1a1a9332c00ea490fb0c71a381287081b2140f0b22f1774891e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044400.json",
