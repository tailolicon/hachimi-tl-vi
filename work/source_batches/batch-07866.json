      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当荒漠英雄努力想改变自己时，\n她得知了气槽对她的好友东商变革抱有期待。",
      "source_fingerprint": "54a0eb304ca57a1ef57148b403d502834c1753d54ce30c98dbc86448be4f0c5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
