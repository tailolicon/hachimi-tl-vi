      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的眼里充满了对第一名势在必得的决心。\n训练员尊重她的想法，\n决定整整两个星期都要用来训练。",
      "source_fingerprint": "2a29c8b622f3f62dfc637184d72ffbabe32cdcb466c2e1dbbbbce4b66f1b04c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
