      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:45a103ef6ce208bd1641f79b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与东商变革同期的赛马娘\n迟迟无法踏出重新挑战比赛的第一步，\n为此陷入烦恼。",
      "source_fingerprint": "20715667f0c46925f6654a78f6026edfe9dfd78a6cd3e6fd5765ea2308125740",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
