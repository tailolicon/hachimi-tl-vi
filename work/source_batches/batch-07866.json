    {
      "uid": "zhcn:2ef3435b8abd5a8398b13924",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，\n东商变革和训练员一起来到祖母家。",
      "source_fingerprint": "9b369b6d71e8bd9f3656157cdeb0f5c91b00f8ffdf7a74793e0c9d5b82a282ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044401.json",
