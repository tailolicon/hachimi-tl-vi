    {
      "uid": "zhcn:9fa1471a5023b2cc70d8bdf4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“秋华赏”当天，\n东商变革和劲敌互相倾诉自己对比赛的热情。",
      "source_fingerprint": "2e3c2341764e402b97dc00ef48af647a2f1ae4ab2772dab5c8c1e67b25152811",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
