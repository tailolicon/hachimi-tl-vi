    },
    {
      "uid": "zhcn:99c99a379327c93084c951db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东商变革漂亮地获得了“秋华赏”的荣耀。\n而且她感觉自己今天的表现\n让观众们的“眼神”改变了。",
      "source_fingerprint": "88d3796ac32ed439660044282db59365d452a0226398c53deb9baa25da6444bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
