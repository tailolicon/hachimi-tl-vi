    },
    {
      "uid": "zhcn:659d839a0cd9250d053cacd5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋华赏结束后・魔女的风范",
      "source_fingerprint": "15f1d54fb6e166d42c8a519bd3713f285505fc8e771e46ff6c886a9d677ad2e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
