    {
      "uid": "zhcn:18ccb36a47454290bc06a380",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向秋华赏",
      "source_fingerprint": "53c3f7abc2837ceb7e21241a97f6d971fe2525ff5ff4f9b8623b33edb7b18b79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044414.json",
      "json_path": [
        "title"
