    },
    {
      "uid": "zhcn:3b9321120640fd34db4141f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过想完成赛跑魔法，还需要满足两个条件。\n那就是“特别的劲敌”与“让自己变特别”。",
      "source_fingerprint": "410a350ea8b44320ad4cb3ad176bee6a124475275e72b38b0f42cee83ab28c17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044425.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e1061a421454d4740af6ce32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044425.json",
