    },
    {
      "uid": "zhcn:3b73d1aea7242cdfe5557cec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东商变革在比赛中竭尽全力，\n对川上公主等人施展魔法，\n让她们产生“获胜的欲望”。",
      "source_fingerprint": "795a0377d663c663af1f6879e8edd423c184c588dfcc9bb8b4001c5872aeab9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044429.json",
      "json_path": [
        "text_block_list",
