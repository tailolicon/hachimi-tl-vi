    {
      "uid": "zhcn:ac14c85450b3bf940d8e3f17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人都产生了不想放弃自己的梦想，\n以及想在比赛中获胜的强烈想法──",
      "source_fingerprint": "77d4807f0fa8c080fdb9f40f239b1aa44efb0b09fbef6660b34ddd9800189b1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
