      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:6972281ee3bcbaa8381f21a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天后，某篇有关“宝冢纪念”的报导上写着，\n“简直就像被施了魔法一样”。",
      "source_fingerprint": "843d615f3c1da062c4f2a9ab3d5c3afb4cd72ba709036e70261d61f0599e8cee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044428.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:0dc0a39505e102d31c7e440e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044428.json",
      "json_path": [
