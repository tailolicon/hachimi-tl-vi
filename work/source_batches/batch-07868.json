      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:1ffe70b56676f3c83801ab69",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因为对手是荒漠英雄这名最强的英雄，\n东商变革才能使出最厉害的赛跑魔法。",
      "source_fingerprint": "15d743b75124f63a21150cbd13fbda0a9f7316e577cdb9cfc6e40b284afd5ceb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044428.json",
      "json_path": [
