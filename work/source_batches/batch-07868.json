      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:6f5b44455978e0c5b1a3ca01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛场内寂静无声。\n迟来的喝采声和盛大的欢呼声象征着\n东商变革实现的理想有多么伟大。",
      "source_fingerprint": "33a54580e52707cc5bf1757c4788abcf71a73d33c1e57e60f4350abb01b18827",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044428.json",
      "json_path": [
