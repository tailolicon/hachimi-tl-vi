    {
      "uid": "zhcn:cfa0f4456b5c445bdc21de91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员提议将“宝冢纪念”作为下一个目标，\n在这个最棒的舞台上对全世界施展魔法──",
      "source_fingerprint": "0a8abceb3271279edb318d4cf75312267cd8df07d1039aa8320d902c32b09421",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044426.json",
      "json_path": [
