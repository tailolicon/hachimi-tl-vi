    },
    {
      "uid": "zhcn:c1c2e4ef37440355ec90d1fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东商变革在看见“魔法”这两个字之后，\n露出比平常还要天真无邪的笑容。",
      "source_fingerprint": "6ccec6b460899825bf63a869b20e277e365a88c550709833802ea66ff22dbb4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044428.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:a819c1ef4790beb11e7dd120",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・强大的赛马娘",
      "source_fingerprint": "aa2e16a19d93fd3a0639bb8dd4ab483c8bc748923f6c5290d4cdd6ea486aa88a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1044/storytimeline_501044428.json",
