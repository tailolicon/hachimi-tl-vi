    },
    {
      "uid": "zhcn:5f78e9b4014a14a15cb99377",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天非常感谢大家～！",
      "source_fingerprint": "f14fbc2fe84c19fb8db013afba8c661ac7778960eb499a60e8b68c40eecc1251",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045314.json",
