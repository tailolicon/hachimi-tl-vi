      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "堇S结束后・喘不过气的理由",
      "source_fingerprint": "931db903aa8805d13f92df9e91bb2fd7752f117430d08a8c21b993c916b6c0f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
