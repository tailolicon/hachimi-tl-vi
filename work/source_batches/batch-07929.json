      "source_language": "zh-CN",
      "source_text": "超级溪流找回自己的跑法，\n并因能爽快地奔驰而露出笑容。",
      "source_fingerprint": "b440a055e92fee5a2d22d1d654d600e604aceca510d413cd94e41d4d81f194e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
