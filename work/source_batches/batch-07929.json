    },
    {
      "uid": "zhcn:f0fd9173c15e0dc80e975b74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流表示能在不被看好的\n比赛中出赛并得到胜利，都要感谢训练员。",
      "source_fingerprint": "0adac3136280049eff6ef7144685e330c05c367fdaf90942a3d8616009e36f94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
