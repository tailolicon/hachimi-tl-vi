    },
    {
      "uid": "zhcn:c26ce4d643c8c8b2dba40117",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流以自己能胜过小栗帽为前提，\n在结束演绎坏蛋的练习后──",
      "source_fingerprint": "c2460e743071fdb377cb3a75dac109a95fb423a7a8485c776d45965427d570a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045414.json",
      "json_path": [
