      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了炒热“天皇赏（秋）”，\n超级溪流出发前往会场。",
      "source_fingerprint": "5de77ef37852092ba84ba85d7bead77a2b15039875201d68a5e70be4466cf401",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
