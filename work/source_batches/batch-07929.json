      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流在低潮中参加“日本德比”，\n创造奇迹赢得了比赛。",
      "source_fingerprint": "9de82ad6ba1d36064705e43f21a2a73fc7d0de9e75e0e0e90b5f7bf59b8629ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
