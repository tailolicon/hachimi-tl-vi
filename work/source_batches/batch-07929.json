    {
      "uid": "zhcn:da12e3351073108586dff413",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“天皇赏（秋）”就要开始了，\n大家都等着看小栗帽的精彩表现。",
      "source_fingerprint": "012a26c59cae8c5bbb210b6ca4179f68f2bce9c085ce964384ed7d9d7eaa0f44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045414.json",
      "json_path": [
