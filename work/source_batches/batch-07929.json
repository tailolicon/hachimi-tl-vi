      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・初春的奇迹！",
      "source_fingerprint": "3e82f0e8fd56a74b38cc01ebe1ac5fc86806dba0c0a51c3ee5e7cfaab330b0bb",
