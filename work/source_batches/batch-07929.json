      "source_language": "zh-CN",
      "source_text": "获得菊之王冠后，\n超级溪流跑到训练员身边。",
      "source_fingerprint": "3db6279a55630fc195bfa1506f8b369117fba261509905e4068e411fcb22c468",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
