    },
    {
      "uid": "zhcn:dc172829a803e17c622fb004",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向天皇赏（秋）",
      "source_fingerprint": "acd583fd839f6680a57f75e09880ff12f48e50ac7beeab6d01036df8eff7ff5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045414.json",
      "json_path": [
