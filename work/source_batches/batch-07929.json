    {
      "uid": "zhcn:54cbe69b9e858c89d623a4e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯当天，超级溪流借由对训练员\n无微不至的照顾而获得充足的精力。",
      "source_fingerprint": "3737a5291575dbf53fa26dfa0bde748fa9166879d5c44211e55d0b13fda31a32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045412.json",
