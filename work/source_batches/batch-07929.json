      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向大阪杯",
      "source_fingerprint": "4423575424741415861c85b2043870db30adb78bc366fd97792335ee5949271c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
