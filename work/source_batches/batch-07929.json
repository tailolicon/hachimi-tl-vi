    {
      "uid": "zhcn:e25aa6aa007d419b2fea02e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在强行出赛的“皋月赏”中，\n超级溪流获得了奇迹般的胜利。",
      "source_fingerprint": "aff7c1043a1a9828ef165814d9c1b765c6ea5bde657e862af0c039e37dbea679",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
