    {
      "uid": "zhcn:7d1c4fd41e1cc9ec3948ac12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流对战强敌表现优异，\n只可惜无法得到最后胜利。",
      "source_fingerprint": "acdafa9823dadc32e43f56dab68d434f5962355787b5727182bfb5065ea53366",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045423.json",
