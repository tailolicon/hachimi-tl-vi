      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e972feb6e1a648c2daa018f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流老实地接受这个结果，\n决定不要着急，要一步步慢慢成长。",
      "source_fingerprint": "0ed211c9340ac4fa30dd01cd474f7c437966a7ed26028ed28418849674dbdf60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045423.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9cfccda0f39bdd6c89093747",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在比赛后，她回顾过去，\n觉得至今的每一天，\n都是为了和训练员一起成长的试炼。",
      "source_fingerprint": "d414e7692dfeff4fadc98427708760bb7a3835f6f4b3f7d237b5b4d038cefb43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045423.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:13244a16952424fc7b7832ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着她回答记者，说下个目标\n希望能参加她憧憬的“大阪杯”。",
      "source_fingerprint": "553c58a4bd373cbb40c8e6d75f1dd395816616dca6d6ed6e0de488783ea911ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045423.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:cea1c5096d4d8ddf749012fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・路途仍遥远……",
      "source_fingerprint": "e3be4269737a264ebce169bfa7b7695afb5e1476b5fe0578cc36e05f49f47890",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045423.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:6920397a8735ddffc6e0c4de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流以带着安心感的跑法\n跑完了这场比赛。",
      "source_fingerprint": "910b523f2b121d88b3571bdf4bc7f478c66f34dc4284c202ef78eff5ec1c6cf6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045424.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e0b4452ae09049d09464b69b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玉藻十字得意地表示已经找到了她的弱点。",
      "source_fingerprint": "81df4dd6484943592f9e24f58f42336e161b53072428e229b8d586c99371d9a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045424.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:fd2e969f868a089cb7bf0b0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流的弱点是什么呢……\n在挂念着这件事的同时，\n也开始要为“天皇赏（春）”做准备。",
      "source_fingerprint": "557c965bd496c7ce592333609e41fbf50792c1ed101a2b43296cf8c02b2e803f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045424.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a6b614871c431376752edbf8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯结束后・玉藻十字的预告",
      "source_fingerprint": "f80b4c12181549091ac5f54317590aef29c69606b210e0413cc03474bf6d3a21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045424.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:186eaf1ef021d4ecc002ed61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045425.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:9e4dd93b589ba05f70b97baf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──春季“天皇赏”在欢呼声中落幕了。",
      "source_fingerprint": "933be2777721b4db1cc2cc9cf41d09cd350be91dac06409bc3ed3af2aeae6e74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045425.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:8ec8b473f8bf8a4303f1510c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超级溪流以惊人的跑法击败了玉藻十字。",
      "source_fingerprint": "14440a0d9f1b83a6a30311b9dc3119b7af8e481519fad4ba2c6a44485abeed27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045425.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:38b68f1b929517f1503a669f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1045/storytimeline_501045425.json",
