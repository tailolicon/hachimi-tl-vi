      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:74b6557a7332aebb71cf14fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她之前虽然一直都以C位为目标，\n却对胜利本身没什么执着。\n所以她会这么说肯定是有某种理由。",
      "source_fingerprint": "70ba609dcc4417e5d4bdbd4ddd9f965f341d824dccd31058e871481e9f6dd37b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
