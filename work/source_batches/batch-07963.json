      "source_text": "你想宣示的原因是？",
      "source_fingerprint": "54544dfde69362abaf7f86bfaa4bdcd4de36dcdb0908baa4e9fffd20c663f066",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
