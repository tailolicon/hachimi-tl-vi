    {
      "uid": "zhcn:dd8fd5e93ab80c2159e4dac6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "充满了观众、欢呼声和光芒的演唱会……\n我就快抵达我一直梦想的舞台了。",
      "source_fingerprint": "c8fa58737ceec216aeb75096c7fe6c8bf25d10c1aed87d653e7823ff5d03c68d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
