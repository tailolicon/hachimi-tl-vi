      "source_language": "zh-CN",
      "source_text": "明明我已经快实现在沙土成为\n顶尖赛马娘偶像的梦想了。这样很奇怪吧……",
      "source_fingerprint": "0db4eddf5355c6a34250c768795e85cd8b4d48a6778f8ea6ba3eeeccfa4ab468",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
