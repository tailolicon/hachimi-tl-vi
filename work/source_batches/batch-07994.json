      "json_pointer": "/text_block_list/31/choice_data_list/0"
    },
    {
      "uid": "zhcn:6913e17e7efbb37de2acbe6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后──看到在最高峰的舞台上唱歌跳舞的她，\n我自己也有同样的想法！",
      "source_fingerprint": "7097c3858dccd5728306833c12302da359e40dd01daa828310d7b0d41c178084",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
