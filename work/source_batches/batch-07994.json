      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次就在沙土赛欣赏今天的景色吧！",
      "source_fingerprint": "43507457dbd20737a26639543c75626756be07b7acb0b7e15ccbb0fbeba25478",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046306.json",
