    },
    {
      "uid": "zhcn:a193622cecbad731ecfd24e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Look！Up！To异次元☆",
      "source_fingerprint": "a6f86dea041741612d8ac5964b50bc53699fda806791f8609a7a9ec61ea2bdcb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
