        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:b18c60c6a6d27f2389c71bb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
