        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:52a7c372100d91af1e549407",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的沙土绝对王者宣言让世间为之沸腾。\n不过，她的朋友荣进闪耀却指出\n这种计划性的安排“很不像她”。",
      "source_fingerprint": "7ca3ee04b4d2673a47d48b42c4b1c896452a7ed8ec5cad757b2e6028bd6b9f9f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046405.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0a226271156b6a8782b44138",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046405.json",
      "json_path": [
