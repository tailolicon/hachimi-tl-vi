    },
    {
      "uid": "zhcn:98dfaccd9dce6e79323ea6de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她所发表的内容，是包括年底的\n“东京大赏典”在内，所有她预定要参加的\n沙土竞赛“都要拿第一名”。",
      "source_fingerprint": "98626b42f567090d0ca0fe7862bcab2a236a1a5a04ef8ca6e253f20084ca953f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046405.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9b0d2f2675de0c46d4bf6994",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046405.json",
      "json_path": [
        "text_block_list",
