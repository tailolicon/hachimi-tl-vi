        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:c4bfb5f292208baa8f97a1f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她并非失去了光芒。\n醒目飞鹰相信了训练员的话，\n继续往前迈进。",
      "source_fingerprint": "de50bc536507829fde0daa208afddf915da9a61a6f93334f02229a0ad0fe0e45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046406.json",
