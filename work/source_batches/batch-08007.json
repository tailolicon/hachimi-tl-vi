    },
    {
      "uid": "zhcn:fba2625440d826a381bfd119",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰在出道战拿下第一名，\n顺利地取得了胜者舞台的C位。",
      "source_fingerprint": "f85e2058ac1ec40dfba9145ba0d3b559188f8130bc35d0d504f5e2b196a2d769",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046419.json",
      "json_path": [
