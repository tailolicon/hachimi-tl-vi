    },
    {
      "uid": "zhcn:bda0793c94a069fd2847c02f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046416.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:41669a0d87aa3bde5717f188",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员表示想在比赛后和她谈谈，\n但她却笑着打断对话──\n然后就直接前往参加比赛了。",
      "source_fingerprint": "3f2f78d5ec8d454b394e043923439c2308a2980c6e6260736340561291da9674",
