    },
    {
      "uid": "zhcn:2d7a993cde1c52956f9e5f19",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醒目飞鹰认为世上没有比这更幸福的事。\n不对，真要说还有什么更幸福的事──",
      "source_fingerprint": "1ff1a67a7c001f35ad6465d3de39154374ec96d63d9a36333ffc393ada1d1d2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046418.json",
      "json_path": [
