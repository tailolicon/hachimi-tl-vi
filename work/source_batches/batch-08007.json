      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向东京大赏典",
      "source_fingerprint": "17e656d8ecc70789085a9335f998d6ecb0cd0dad01f61c5298e1cba1fa1c2a67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
