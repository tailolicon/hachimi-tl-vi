    {
      "uid": "zhcn:b6d669ef3a7d55f7cba4aecd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样的她提出了一个惊人的愿望。\n她希望下个目标可以设定为“皋月赏”！",
      "source_fingerprint": "2a762235c13f20b1daadfde229388951e9793260ff53df51c617c0ebdb6ec28d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1046/storytimeline_501046421.json",
      "json_path": [
