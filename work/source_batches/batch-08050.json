    },
    {
      "uid": "zhcn:559332b9646ce814f4558e26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“没错没错！\n其实目前出现了一位非常有趣的赛马娘喔！”",
      "source_fingerprint": "3c1713113c6a0457d462676748d29a793584aa9a2d394625ac7c9345f9968a68",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
