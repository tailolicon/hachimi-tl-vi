      ],
      "json_pointer": "/text_block_list/63/name"
    },
    {
      "uid": "zhcn:f0878defbad28076d9612a63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后节目话题一转，完全围绕在\n经典级赛马娘们身上……看来有不少\n格外才华洋溢的选手们正在一一崭露头角。",
      "source_fingerprint": "10a2a42f008ee6a5858e882e9673fe97c8cd599379c27818c192623564fc0bc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047102.json",
      "json_path": [
