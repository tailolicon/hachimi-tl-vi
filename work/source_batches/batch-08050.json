        68,
        "name"
      ],
      "json_pointer": "/text_block_list/68/name"
    },
    {
      "uid": "zhcn:8b971084bb04516f091b0015",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……一路走来经历过这些事情后，\n我好像重新体认到了一件事。",
      "source_fingerprint": "877cc586223d575a1dfec64619edcb163ef370de7d54db67527f2eae2b0b1c85",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047102.json",
      "json_path": [
        "text_block_list",
        68,
        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:2c8af4f7da1ecceca86b4ab5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047102.json",
      "json_path": [
        "text_block_list",
        69,
        "name"
      ],
      "json_pointer": "/text_block_list/69/name"
    },
    {
      "uid": "zhcn:eb35a69893b994086fbc269f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论是成为英雄的梦想……\n或是想成为崇拜对象心中的留恋这种奇怪目标。\n我好像每件事都没办法彻底放弃。",
      "source_fingerprint": "02e7c88dcfea9334c263541c6f5b6a5bbb62967fecf02ab35e119c13841229b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047102.json",
      "json_path": [
        "text_block_list",
        69,
        "text"
      ],
      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:394fc4ccebd29694a8a07bd5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
