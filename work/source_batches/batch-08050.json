    },
    {
      "uid": "zhcn:ac95a9831645316e7c532e51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让心情焕然一新后……得继续努力才行。",
      "source_fingerprint": "9051faa58994bf6047d2680a0f1d75de10cf3999728e32348b6c667dc43eb367",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
