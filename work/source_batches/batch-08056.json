    },
    {
      "uid": "zhcn:1171614bcc9b95571ff87efb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某位英雄",
      "source_fingerprint": "2498af2a6f376b55b07aad15ba8080d033d4ebf8b1d3ccc2ce2215d78e1f30eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
