    },
    {
      "uid": "zhcn:4ba64cfc58bd169539482134",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是两人共同写下的传说。\n我想自己此生再也不会忘记\n荒漠英雄说出这句话时的笑容。",
      "source_fingerprint": "85c6189c3977fe5ed01e6ddb07724ee2db8a4542259fb8c93aee069f6d0ed730",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047112.json",
      "json_path": [
