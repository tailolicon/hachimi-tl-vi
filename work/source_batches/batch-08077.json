    {
      "uid": "zhcn:709cc8a671a7d3b20ea169f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──好的，今年又到了“日本德比”，\n会场内的气氛十分热烈！！\n",
      "source_fingerprint": "b70a2f8940258e86a555803dd77cf8bc6c951fb74d1a4a088202b53387a0a2e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047202.json",
      "json_path": [
