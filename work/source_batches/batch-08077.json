        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:c95cda682f63443be6b49bdc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（哇啊啊──！！）",
