    {
      "uid": "zhcn:7a7312c053c732728fd43285",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不过没问题的。我一定可以的。",
      "source_fingerprint": "627b9e6e49d36e07c4a54a3d465ecfadb43af0737ad26b371a9cf9b70e106129",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
