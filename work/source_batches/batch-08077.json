    },
    {
      "uid": "zhcn:3b13278a54b8997e36c15d19",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训、训练员！？\n你怎么关掉我的──",
      "source_fingerprint": "9cf811992cd2bb8dc9940efc96479210af4c2505720c22f81c7899319476a400",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047202.json",
      "json_path": [
        "text_block_list",
