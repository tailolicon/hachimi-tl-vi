        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:b20d6c79da85c7b255013d62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“最后……她戴上荣耀的王冠，\n获得了只属于自己的剑，\n那把剑丝毫不输给她最崇拜的英雄罗布・罗伊。”",
      "source_fingerprint": "d904e5838bfe9280ae08b981c8ae77b15d02eeb80bdb1e8b2c607c0f81be57ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047202.json",
      "json_path": [
        "text_block_list",
        60,
        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
