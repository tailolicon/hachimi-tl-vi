      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:b7c339e3fde43ac2afe140fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不是说了今天早点回去休息吗？",
      "source_fingerprint": "5ea5744a452cc126f82d1fdb2f89211488bc91d55ba995837dd130305e338790",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
