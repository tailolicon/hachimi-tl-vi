      "source_language": "zh-CN",
      "source_text": "（或许只是被人潮挡住了，\n也可能真的太忙没办法来。）",
      "source_fingerprint": "1a0dd6c98aa9420fe9bcec2828ea9713838b28dd792451dd68187a272907d5cd",
