      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我一定要变得跟她一样，\n成为“毫不动摇的英雄”！",
      "source_fingerprint": "5411f9c71484e023fa608af97ce7c0e2b52bd0fa12b54ad0fb611d1993fd3cdc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
