      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向天皇赏（春）",
      "source_fingerprint": "787a30dcdda7188675e08b67055e274860a6c1346bc76e36d7243b3c8364986b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
