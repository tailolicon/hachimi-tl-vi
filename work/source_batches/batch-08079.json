    },
    {
      "uid": "zhcn:22caaf7136aadbd608fe8978",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──“宝冢纪念”。\n由粉丝投票选出的赛马娘们将在此对决，\n这场盛大比赛也是该年上半期的压轴战。",
      "source_fingerprint": "8db5025dd59aaa149397b27824e6f8ddce09dd9d9d41cbe9275a6ae4bf552179",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047206.json",
      "json_path": [
