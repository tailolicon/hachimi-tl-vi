        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:3a2a9741a7ade25bcdb3f916",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "阪神赛场的气氛如同往年般热闹不已。\n场内挤满了想要亲眼目睹当红赛马娘的观众……\n",
      "source_fingerprint": "0c6651fe6ae29b077e3fc47daecfb2db6c91715c9c0be0039aa16a8c8e3350c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047206.json",
      "json_path": [
