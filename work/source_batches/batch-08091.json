      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:bf8e58262370b44ec718ae27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若问她是否能够参赛，答案是肯定的。\n只要集中针对“皋月赏”研拟训练项目，\n甚至还有机会夺冠。",
      "source_fingerprint": "25954ff1097e80d87388990bc3415a8baf9477f72d5a6d93e495141d7d1355fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
