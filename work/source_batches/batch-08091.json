    },
    {
      "uid": "zhcn:dda75c5240dc9aaa831f562c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了追上我在那天看到的英雄传说……\n为了追上我一心向往的故事──",
      "source_fingerprint": "5a5c293d6bbf07ccec2a98d57bd9f38a61462987e92bc69ccc7970ba40f52f58",
