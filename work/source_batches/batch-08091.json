      ],
      "json_pointer": "/text_block_list/21/name"
    },
    {
      "uid": "zhcn:309a36b15898987b54a026dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“一生只有一次机会实现的梦想”……\n“最受命运眷顾之人才能获胜”……\n真是再戏剧性不过了呢。",
      "source_fingerprint": "31e8f29da66d61073560d689d23c7a2890ba7d78a0d47a854272eeba268b6e99",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:cea315619c2ef8d31d468163",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
      "json_path": [
