      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:b01848d996e4c294237651dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而她的身体尚未充分成长，\n“皋月赏”此一大舞台对她来说负担过重。\n是否真的该在此阶段就使尽所有全力呢？",
      "source_fingerprint": "551e6135fc3e4cf3132096c2ca4e06beee12b4b8f4754e1dd94be43380452ab0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
