        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:fa47b426c151af307c29a384",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "定下目标决定走上“最有英雄风范的王道”的她，\n今天也努力地投入练训练。\n",
      "source_fingerprint": "b0809acd88e252f7369b94fc672a61f37cac753dc30fa0acd0a64c894e7c51a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
