      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以……我不打算挑战“皋月赏”。",
      "source_fingerprint": "486d3943ce44994d25dfa7f63f32007f4b528da3971559bffcdb91ab0fced975",
