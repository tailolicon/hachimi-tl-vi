    },
    {
      "uid": "zhcn:65ee9863b5189e9577634db1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得不错",
      "source_fingerprint": "7cac529981d0c398c5f086bb3a6630e4834ffe3fca1058a6a20cb2d3fef03c73",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
