    {
      "uid": "zhcn:f500119475b1ea1a442be4e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！",
      "source_fingerprint": "98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
      "json_path": [
