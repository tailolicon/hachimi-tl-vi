        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:a9e2278a94591f1df48fe483",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得很好",
      "source_fingerprint": "bad682ca8c5a0245d43a4075ecab46ac84b14083f22d7a08ebddfa6894a8bef6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
      "json_path": [
        "text_block_list",
        38,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/38/choice_data_list/0"
    },
    {
      "uid": "zhcn:11506425f4e2a946561f4bbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……看样子荒漠英雄也得到了跟我同样的结论。\n",
      "source_fingerprint": "30aa0b76ac30112ab186b1b42ce4f6141a990932d95ce99f9c51b5ecce442936",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:210acd7cb31c3c1ae6bf02f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青叶赏与“日本德比”皆于同个赛场举办，\n就连比赛距离也相同。\n作为前哨战可说是无可挑剔。",
      "source_fingerprint": "b39bbff965a4b5267dc1e861ace1eda30a7972936b9faf86b2c2ef6f0b995453",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047304.json",
