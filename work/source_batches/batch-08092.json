      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:247315fa0d2d4ff8d60446b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是啊",
      "source_fingerprint": "3be12f45234df0a75fe7631f99eaa0b2a5dbc8ba137a5c9ce725752f780ad09a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
