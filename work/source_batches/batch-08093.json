        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:66bd0ba4b5673b33d605f7ee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“并且深深地坚信这幅景象必定会成真。”\n……我接着写上这些句子。\n",
      "source_fingerprint": "67ed42ae4157b942e207366ca81158bb801039d601478790ac4fcf74edb88c0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
