      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（好多人在欢呼，\n音量比我小时候参加幼儿赛时大多了。）",
      "source_fingerprint": "efef6118814d9799a9b849305f789e38221c5fedabd8a25ebbb559a96b01fe3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
