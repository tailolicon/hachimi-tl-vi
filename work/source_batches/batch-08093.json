    {
      "uid": "zhcn:639cd1b4fac53e65ec46f8a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“听完这番话，我在脑海里鲜明地描绘出\n英雄沐浴在热烈喝采之中的景色”──",
      "source_fingerprint": "2acd4ccb897a1662775c23801f525a034bc616a35ca2df325aa87fd7c6a91109",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
