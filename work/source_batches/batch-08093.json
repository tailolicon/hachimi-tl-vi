    },
    {
      "uid": "zhcn:ba4faf6ad3e96f68cb215058",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄坚定地踏出了迈向王道的第一步。\n",
      "source_fingerprint": "71e40ad5ff0310062e5204c79f2ae438455c93980aca9cbb11e6d4da09a0678a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
