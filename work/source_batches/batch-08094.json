      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:34bc1016bf73f6bf7b5c9853",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主角荒漠英雄紧接着就要前进“菊花赏”。\n──只有最强赛马娘才能获胜的比赛。\n",
      "source_fingerprint": "3499e960afe4edd89070df34f048e16ba077ab560893c9331915b7a34129cc7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047306.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:1651b9b92a401a829e4d759d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也是个跟未来的英雄十分相称的大舞台！",
      "source_fingerprint": "78c808a4ee0e83c3112ece683dcb082d556d34656e1713b51e0705a719827739",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
