    {
      "uid": "zhcn:7a9593b37c640c98bf05fec8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想要尽力以最优秀的样貌，\n在最豪华的舞台上迎接她归来。",
      "source_fingerprint": "78d5e327762c22d12e0574a02e9e0a1f835595929d48eaf3236ecab2aaef3293",
