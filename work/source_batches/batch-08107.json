      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:1bb81c0a2bb7fd16d3e6a965",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "除了她以外再也没人能够写出\n“荒漠英雄的传说”了。\n她振奋起精神，决心要写出一本名著。",
      "source_fingerprint": "aca708d9bd164c8f3e2364cb142e33bcd3f9efb4dc623b4004392b874f945f28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047400.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:44b31fd236a813bdaab40f28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄登场！",
      "source_fingerprint": "0f6c1c83f26c676fa274729ed7bbcb4aa8d34cef8c8e12b38e78e1a502b1bc71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047400.json",
      "json_path": [
