    },
    {
      "uid": "zhcn:71d9a7eef6184d726bc21f92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那刀锋发出漆黑光芒",
      "source_fingerprint": "81e30673a6c52438261470203bedea871b4df7deb03dd36810395de1fdf66ca1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
