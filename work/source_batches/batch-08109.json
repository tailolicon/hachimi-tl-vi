    },
    {
      "uid": "zhcn:b00909a57539eac359c24073",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "将目标放在──称霸“日本德比”。她自幼\n便为之倾倒的大舞台。然而她在重赏比赛的\n经验尚浅，直接挑战德比太不切实际了。",
      "source_fingerprint": "5ae882fb0cc8abf64d2d475b1e8d9bf2bcc3d74917e17ec451641a2c0c48cc58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047419.json",
      "json_path": [
