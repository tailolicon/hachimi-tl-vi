    {
      "uid": "zhcn:e66a328ce64a33ab4c3fa000",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比起其他赛马娘，荒漠英雄的成长进度稍显缓慢。\n我们判断对目前的她来说“皋月赏”负担过重，\n于是决定先不参赛。",
      "source_fingerprint": "755bd33e5d064daa572fb1cdbae0fdef91b8c567d2f6f960943f9ed12c5083f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
