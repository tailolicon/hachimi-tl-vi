      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:5a96312644feb83ea8a34b46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“我一定会成为真正的英雄”\n“我一定会创造出一篇\n能与日本德比这个大舞台匹配的英雄故事”……",
      "source_fingerprint": "60c15023a0b73aca93b1cbf4835f300d9168cb752390440091a42ffe52b96574",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047420.json",
