      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:864c1850e3f9b39b8f4a92ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄被记者群团团包围。\n被问到目标时，这次她终于说出口了。\n──成为“英雄”。",
      "source_fingerprint": "737e4074efe3a20930b26d9b8c0effde00cba103c84783a6ba3bbf6f307d4427",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
