        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:417b51d3331e4159c0cdc594",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听完这番话，我在脑海里鲜明地描绘出\n英雄沐浴在热烈喝采之中的景色。\n并且……",
      "source_fingerprint": "24f408aa76581698466744b72c321ef30e2523938295401141b64f96ee3a140a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047420.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:187f7ea5368afe624ac2f6ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄传说",
      "source_fingerprint": "b2e4953a8adb23b00064ed92298a98ec0875d81773561eb95f148a63b8bd7a22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047420.json",
      "json_path": [
