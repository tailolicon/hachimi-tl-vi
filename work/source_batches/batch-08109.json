    },
    {
      "uid": "zhcn:f5315ccf5cdfed3b950a2c0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青叶赏结束后・冲上舞台吧",
      "source_fingerprint": "f87e50c3b7371cba47c7a2fc0b0b45870fd5dc87f4adf7987ac103e73b044147",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
