      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:8573d3e2e5ba60772567b644",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "深深地坚信这幅景象必定会成真。\n接下来──就是“日本德比”了。",
      "source_fingerprint": "d795f9024c4502ff13b4ac066daada14c5e51382acd7713a8d458f575b666034",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047420.json",
      "json_path": [
