    },
    {
      "uid": "zhcn:7eb0330d252864afee0febb8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄坚定地踏出了迈向王道的第一步。\n她在热烈欢呼声之中开口诉说。\n",
      "source_fingerprint": "0fd2c23e4f848728bdbbe5c93b5871fc2092d0a47d972ac17cdaa1e41bf53e1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1047/storytimeline_501047420.json",
      "json_path": [
