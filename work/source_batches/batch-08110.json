      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过荒漠英雄仍专注地将手中的剑指向未来。\n她决定接着挑战“宝冢纪念”，\n以便更加吸引众人目光。",
      "source_fingerprint": "54787e4d5928d370ddd884a04560ac75e67d2c90480bd9f84d8667f729c2530a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
