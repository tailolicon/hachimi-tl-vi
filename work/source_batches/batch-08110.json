      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄漂亮地将荣耀的秋季奖牌收入囊中。\n观众们无不为之沸腾。\n",
      "source_fingerprint": "4ab63952b7e4b18506575c90919b60c2f735db632cb0af72f7753e700db0fc3a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
