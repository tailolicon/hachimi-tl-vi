    },
    {
      "uid": "zhcn:25547c6f19ac55bf631c582b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她们似乎相处得很融洽）",
      "source_fingerprint": "aecb59ec4124a1ac505a0cea8a0f21609ce60c19957ccb83d054b000c9a5fb76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
