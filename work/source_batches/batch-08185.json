    {
      "uid": "zhcn:2e0c73142e3e9a59d74bc819",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊啊啊啊啊啊～～～～～～！！\n我输了～～～～～～！！",
      "source_fingerprint": "a2cc187690cb7b7bc9354e08010d749578a5b78b03783bbfeb64b87f90eb1b91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
