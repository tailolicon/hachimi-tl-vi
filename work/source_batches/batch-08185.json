    },
    {
      "uid": "zhcn:80abca8901f766539221f4b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦",
      "source_fingerprint": "1f5020441e758dd5bda3c9e47666e17b05f8b71b8aa3e416da7e0196d5a2fc03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
