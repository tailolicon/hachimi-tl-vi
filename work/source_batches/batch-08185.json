      "source_text": "辣妹赛马娘B",
      "source_fingerprint": "2a90ce03857f289f531e216be55e19850bd24361ced3e5327efd0125f2eac89c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
