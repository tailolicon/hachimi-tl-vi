      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了超越作为范例\n设为目标的那一个人。",
      "source_fingerprint": "ebd6ef2a48102b3ca7e32f4a18b63ff759b4879761b8f807661a76951193f564",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
