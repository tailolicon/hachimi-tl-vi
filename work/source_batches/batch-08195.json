      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了这唯一的目标，\n能够无止尽地咬牙前进。\n充满求胜的意志力──",
      "source_fingerprint": "bf9138a2dcaaf1873076f0a0aa4c84fe217a8e106526eda3b5d577c338d38eaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
