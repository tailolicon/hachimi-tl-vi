    },
    {
      "uid": "zhcn:f36bdabbd197181e9c47096c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在“天皇赏（春）”这样的舞台上，\n光靠这份意志，就能一心一意地狂奔。",
      "source_fingerprint": "feb91f58539bbc4f4551e0a9e3d0ccbf2cd76812974fa75064c1bb48c2633a65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
