    {
      "uid": "zhcn:e86d18f3ca90dfd60b9199ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回到休息室后，\n东瀛佐敦精疲力尽地倒在沙发上。",
      "source_fingerprint": "f787023e53c480d18a1af591eae4498d5a5c910d893a0977cd63a55bc3bb1de6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
