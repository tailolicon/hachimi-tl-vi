      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦的脚趾甲状态，\n已经糟到不能再糟了。",
      "source_fingerprint": "1574623bf7002a000702c2353172969524ede3e8cf2ea15e75d9538dff2f7536",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
