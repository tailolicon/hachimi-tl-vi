    {
      "uid": "zhcn:c0196b6538bfceedd30a38b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦在训练员的指示下，\n参考各赛马娘制作美甲贴片。",
      "source_fingerprint": "f8bd5fb3cc098ac9c5392c8f9ea5087c56a003fa1d97ed1bf2c7a65363158c96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
