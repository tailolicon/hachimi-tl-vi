      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:22ea7c6167dd680a3ada5f58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不管皋月赏之后，情况会变得如何，\n要是不能跑，即使引退也在所不惜。",
      "source_fingerprint": "163cb935b338caba39dc0eb09c55d572682fcf61a7f9de525e570d6b5ca250dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
