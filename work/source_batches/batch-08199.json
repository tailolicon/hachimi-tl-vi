    },
    {
      "uid": "zhcn:5fbdac427b1a2d650d499dbd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "裂开了",
      "source_fingerprint": "9f863e666e56129db5873fff0cdc38b5ed0ca8e8643fc0328ef9e382d2db8e34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
