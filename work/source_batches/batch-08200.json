        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:9c97dccbaff15eb0c3ee5f35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就是向樱花进王拜师学艺！\n说到速度非她莫属。\n因此从早上四点开始……咦，早上四点！？",
      "source_fingerprint": "12f06156c191c6eb3d72ec3d16018ae1786f516598279fe3924125fe80e74ff0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048407.json",
      "json_path": [
