      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:fba5b65a9f4bd5b635c57965",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦的恐惧渐渐消解。\n再次出现在训练员面前时，\n她的表情已充满了干劲。",
      "source_fingerprint": "6b6ed0ccca629b1c29b059419d7f22579caf340fbcf168769d5fa916c53dd3ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048408.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:ba045424b96be23045950632",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向出道战",
