    {
      "uid": "zhcn:b3557c45a4b1e85675cb7cf6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "检查完毕后拿了药，\n东瀛佐敦\n就去参加夏季集训了。",
      "source_fingerprint": "c33ed7a2637d3dc72a24f1228416ef385b70adacc3b812a0a20122e954c8a116",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048406.json",
