      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b6e0b46186e09135773f34bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048408.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:6c190f59f264e6fb2e6a96cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到胆怯的她，训练员觉得\n或许跟朋友比较能毫无顾虑地商量，\n于是将她交给前来加油的目白善信。",
      "source_fingerprint": "a11e50590150d3d2fff37dcfa089c1fc6e24718d2ef10123d40a9023f0bcede7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048408.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:f97ed06a26d0cdccb08cfa21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048408.json",
      "json_path": [
