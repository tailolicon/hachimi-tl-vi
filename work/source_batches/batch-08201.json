      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在的她虽然不如其他赛马娘受瞩目……\n但她再次发誓，今后将成为伟大的选手。",
      "source_fingerprint": "778e15fd78013efb6de109fb2c5140cc7d56de4a15dbc64b85dc36d7e7664645",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
