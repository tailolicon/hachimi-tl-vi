    },
    {
      "uid": "zhcn:d4443e5747e5624e7375c993",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・就像假的一样",
      "source_fingerprint": "940356f36afbaff5319d0b891c34e3e2c12315fdb449167cc0326dd7c43b3546",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
