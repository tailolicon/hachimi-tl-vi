    },
    {
      "uid": "zhcn:e38d2f24d6ae3204eca40235",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听到她的心愿后，训练员要她\n在“天皇赏（秋）”上实现这件事。\n她鼓起勇气邀黄金船一起参赛。",
      "source_fingerprint": "b85977eeaa06be82698c2eede2a7a2a54753107c8ea5838e7d9b60880d6e3250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048427.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
