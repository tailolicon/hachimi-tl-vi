      "source_language": "zh-CN",
      "source_text": "在春古马三冠最后的舞台，\n磨好她的武器吧。",
      "source_fingerprint": "c91deab58250059562285a73aa97b42aea72ff4244abaafbb76ebe87d0a7cce3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048426.json",
