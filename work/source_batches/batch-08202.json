      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・嗨起来吧！",
      "source_fingerprint": "f684fd4cbce86c4c87f74d4ffdd766f488081a9de94980701565f0f374c467e2",
