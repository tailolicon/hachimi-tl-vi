    {
      "uid": "zhcn:8b29650836b2aedad7f7cc93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我不想变得更逊了。\n训练员想提议下一场跑“大阪杯”时，\n她逃避了。",
      "source_fingerprint": "1b4ededf0344fb9a50e1311da665f6cfb4b50281479312920d41e6e04c9f3604",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1048/storytimeline_501048424.json",
