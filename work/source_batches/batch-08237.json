    },
    {
      "uid": "zhcn:d0c5ceb12bf698e3aa12cffe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这位名为中山庆典的赛马娘，\n能将逆境视为让自己兴奋的要素，\n并且“乐在其中”。",
      "source_fingerprint": "6775729f632cd28cb7fa40b6781ce0adf441208c81bf07e18a81c33dd69926d6",
