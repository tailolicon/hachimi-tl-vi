    {
      "uid": "zhcn:e017cd9ecbc7337e8e4a693d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……中山庆典认识我之前，\n曾经跟外国赛马娘\n进行过一场非正式的比赛。",
      "source_fingerprint": "8837197e9447485eb3d9878f784deb42df1eda5c6c705403583ccfc948f28003",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
