    },
    {
      "uid": "zhcn:a567690339d8325e92d94779",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……光用学园的草地练跑是无法应付的。）",
      "source_fingerprint": "7728ce01e5337aa55828b4f041541bccc54b80135cd693579d8fbf295911bc17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049102.json",
