    },
    {
      "uid": "zhcn:bc3e72a3ca1cd86276f23885",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我试着走了几步，脚深深地踩进地面。\n有种被土地柔软包覆的感觉──",
      "source_fingerprint": "0c7a4630a9d0ca2ade84b4d75ccb45e8b18da751d54fcc65697e3f436e820bf1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049102.json",
      "json_path": [
