        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:01f86bd51b55de2c0cbdbaf8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我这才察觉自己在下意识中一直很天真，\n觉得只要在特雷森学园整备完美的\n环境中训练就没问题。",
      "source_fingerprint": "73845f3adf7d62ba491ac589457825bf3ffbd439557bd70a16cbfefacadbdc36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
