      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（得安排些不一样的训练才行……）",
      "source_fingerprint": "6d31a2307fbdcb1ad7da55aac78902b7e379312925517f2258eb82f75afce8fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049102.json",
