      "uid": "zhcn:4f6c865488eb04706d279e3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（噗咻……！）",
      "source_fingerprint": "82250185dfb9decc9715aeadb2e46ce8bd0877f4a1aae84ade5ab97fbd87997e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049102.json",
