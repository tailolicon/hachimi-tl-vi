    {
      "uid": "zhcn:51326f0d6604c3be7e8171d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为法国擅长\n活用土地的自然状态建成赛道啊。",
      "source_fingerprint": "aabce72f5dbe4ad6ca39c2cb48401afb32437498b16f58f015fce4da07f44bc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
