      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在我统整法国远征的事项时，\n脑中曾闪过一丝念头。",
      "source_fingerprint": "56355e0dd25759d2d28e5e3d5a516ce28dcc45969cc59e4bbf211cfe0a587395",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
