    {
      "uid": "zhcn:5f92d2b57838686ac3ccd299",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如同中山庆典因为法国联想到生蚝，\n说到法国美食的确不能不提生蚝。",
      "source_fingerprint": "e9943afa0b74adb0b862f9f1693ccfb823ca3091c7a4495e83995dac18018a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049109.json",
      "json_path": [
