    },
    {
      "uid": "zhcn:efe88a2aa03bb31555f545b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先就是这句万用招呼语！\n“La victoire est à moi！”",
      "source_fingerprint": "2806d6058aeead7568e4910a754dfafe3783cb7cd4546bdc4b1ec119f3ce7a90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049112.json",
      "json_path": [
