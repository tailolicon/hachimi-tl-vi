      ],
      "json_pointer": "/text_block_list/16/name"
    },
    {
      "uid": "zhcn:af59e2d1b9d9c56dc2ac69b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“啊，训练员！\n上次真是谢谢你了。”",
      "source_fingerprint": "13d267765f1cb44da8403a36c2b7c4aac2fd45d4d4e0475309c0652805cbf16b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:8105c914710b855b94f68733",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回答的同时，\n我脑中浮现起前几天的记忆。",
      "source_fingerprint": "71fae71af15f8d3113d61625b46261a5e291849749ac0b8f40a729b97780bf06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:b11a4f1079af605624a6e519",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山以前的导师",
