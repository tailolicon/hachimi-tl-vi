        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:aecfffc3121bb0616d43ed30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典",
      "source_fingerprint": "53c202db2755a9750c0769d373f4610457612e8abd3feb5044ef7914f3c657dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049112.json",
      "json_path": [
        "text_block_list",
        9,
        "name"
      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:0428c8eb5552dd8c83f45731",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……“别得意忘形”。\n我才不会上当，\n自己可是也学了一些法文。",
      "source_fingerprint": "dd000e7dfee7aa143194fdbd9198a369ce1fcef1e2d16b42c0dad6bb6e0b81fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049112.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:9c7d0ea5934c30ccbb91d76b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "温泉旅行",
      "source_fingerprint": "08f173fddcb7e5822fab5109fd215cebe140f0aa03b4c5e000b99882bdbd34eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049112.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:de016239348970b407425e2e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后过了几天。",
      "source_fingerprint": "5313191bf2156f41e21276431c5c1ed2cb4023324eac363aa222e479cb3627c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1c5b5d52888d2ba534c5281b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这天我趁空闲时间，\n独自参观学生们的练跑状况\n并收集数据。",
      "source_fingerprint": "509a5847242d6a01fb78bc820f8a9005145c6b36ce5ed2d2fd7c3b7b317f2452",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:0c35012ba8458def33d02a9b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使同为“领头”，有些选手只顾独自冲刺\n丝毫不在意旁人，但也有喜欢观察周遭对手\n边盘算对策边跑的赛马娘。",
      "source_fingerprint": "b0a1f38c8b62efa57d91b84af724625cf5a347fb3704ba55bb4e7349badd146e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:ba75ef13d15b54bb72aa078e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从这点看来，中山庆典她……",
      "source_fingerprint": "09a5ad9b4934574cb757770559777fa3e3a793356076879488c763d7cdc7a4c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        11,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/11/choice_data_list/0"
    },
    {
      "uid": "zhcn:963701fc24884f0e45fc9e2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是说，多多了解选手本身的个性，\n将有助于拟定最能取胜的战略。",
      "source_fingerprint": "9ce387274ea6a89a8f735f5696b113aa4380b2b95d3ee6bdc8bf3a8f51e6ae62",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:51a5e7fd449386831ece596d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我非常清楚她是个天生的赌徒，\n但除此之外还有很多不明的资讯。\n她是如何被塑造成今日这副模样的？",
      "source_fingerprint": "6a18a15072a90e6ea7b42d4ab6ee74083223d77f35f8bb8c6ad9603c108cb181",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:bfe42686504f27affa4f85ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喜欢的东西、讨厌的东西、特殊习惯。\n这些乍看之下与比赛无关的资讯，\n有时也能派上用场……",
      "source_fingerprint": "3b89b7e552d7f11ad48f7dda28fb3cff644e73ef769d507c734d9849df8537d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:27a17b511944e20bcd2260ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我甚至不知道她是何时开始立志\n进入特雷森学园，因为我们连这种\n最普通的闲话家常都不曾有过。",
      "source_fingerprint": "7bb35b5549f3157388e88a6c2d8fc8b8ffd5d8e3e272fb25dd13613ad1437c4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:6dd5173906e3a94490c6cbd6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，这电话号码是……",
      "source_fingerprint": "e41b2068d61181a9f601e6723491986e4399c3f5f15f5187ae7383fadfa95d40",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        15,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/15/choice_data_list/0"
    },
    {
      "uid": "zhcn:55b51ed20b11c5f5fb88ffff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（嗡──嗡──）",
      "source_fingerprint": "13f40f7405f655930abba443f5ca6ac43bc6b3a7c2869cc168abbaa26ddaa546",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:42531c022a684d8cc845bb4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "别这么说，我才受你照顾了！",
      "source_fingerprint": "9881226dda52cd35ed8121ccd7a7544827f6fa47fbe48e64b18180a50c976386",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        16,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/16/choice_data_list/0"
    },
    {
      "uid": "zhcn:3047df9ba41e58daa1d093bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山以前的导师",
      "source_fingerprint": "dcf2afed461feb158f394be1b92d4df633a8b8308f0c3283812d3a319b1356ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
