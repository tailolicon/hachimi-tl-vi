    },
    {
      "uid": "zhcn:a1074e346a1cade2cd72690a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………？\n……训练员？",
      "source_fingerprint": "667e146b8a7de96c8adf393f5c54709d776f517801b69a1f2974dae18dcd8d10",
