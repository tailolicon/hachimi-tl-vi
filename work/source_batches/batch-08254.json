      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山以前的导师",
      "source_fingerprint": "dcf2afed461feb158f394be1b92d4df633a8b8308f0c3283812d3a319b1356ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
