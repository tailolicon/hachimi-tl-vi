        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:29987074b50ad443f9c435c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:1ec92c3cef005097264ecdff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那我要冲啰～！\n小钻，跟上来～！",
      "source_fingerprint": "f921d426b20a180919987e733efcfbe94c09efd9dd86a3ea48219b6670aaf509",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ff2d08c342d689b2f9227bb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次方便让我好好访问你吗！？",
      "source_fingerprint": "e5f56c841bc16163b57c5c7117f0ce60b3c5013f15893a92c82ce0448b245d17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
