      ],
      "json_pointer": "/text_block_list/19/name"
    },
    {
      "uid": "zhcn:bade9cff076f8d7882b09e91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算再微小的资讯都好，\n我真的很想帮上你们的忙。",
      "source_fingerprint": "3984cc586cdab237a7d93a7747fde3e7b2252634e80b34ef1e12070a8abcb1df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049113.json",
      "json_path": [
        "text_block_list",
