      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会衡量能让你发挥所有实力的时机",
      "source_fingerprint": "0cac0d158e6eb67f1d9ac5fdecbfa1dd74bc94d846b637d2888aac669be7e9d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
