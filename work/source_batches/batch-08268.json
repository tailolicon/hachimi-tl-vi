      "source_language": "zh-CN",
      "source_text": "中山庆典说完，\n迈步前往“京成杯”的亮相圈──",
      "source_fingerprint": "6d0fda96c57fe35743df6698d6d85602c2f98b0d336afc3395bf218803d7bcc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
