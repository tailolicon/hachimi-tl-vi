    {
      "uid": "zhcn:f4eb9fe8e864eef35eaec049",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那孩子现在……能跑出怎么样的表现呢？",
      "source_fingerprint": "d173d3f87297e3c468cfea9baae1b72068a7dee52cc2065a814f83938d83afbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
