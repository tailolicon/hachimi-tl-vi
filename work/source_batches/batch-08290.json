    {
      "uid": "zhcn:b77939530111c20b40596da6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此刻，她开拓了崭新的未来──",
      "source_fingerprint": "f8a1e53d3908115a1c109f0904786f505af137ceb7dfc9f925c27159c34070f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
