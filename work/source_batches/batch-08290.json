        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:7e0df85e9312ef6821b39ae3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而神鹰却认为想赢得“凯旋门赏”\n还需要多花一年准备……\n她希望中山庆典能胜利才这么主张。",
      "source_fingerprint": "2b2aa11c890d0ec12f36a69e40f0ba590aa0ed44b68bfd05e81fd17e9ea93d43",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:05be341e48faf00dca9a5454",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:91f7e4daaae14a49c3e2d988",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她很清楚导师剩下的时间已经不多。\n所以即使明知自己实力不足，\n明知此行为必败的战役也要挑战──",
      "source_fingerprint": "f888cae833a6477ee6e156dfdbe6a659cc617c4a9a836ab28485739b074f625c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:366310858d1c63d7401ec769",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:f2abc80408e9bb8356b846a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时训练员再次询问中山庆典。\n难道要让恩师“承担”落败的责任，\n用“输了也是无可奈何”来开脱吗？",
      "source_fingerprint": "1a91c7fb6ed97ef2e51d6c1e632b50a3c45c983cb1d745f7cbacb98aaa59a010",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:91f3b8cc057ee94098be820a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:7f2e6dda0af27701680a7cb7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "星空下，中山庆典等人左右为难。\n究竟该立刻挑战目标\n留下“不坏的成果”呢？还是──",
      "source_fingerprint": "3753225923841a7a594a690d8592e1565cfe57cc3af0a4dc2362e0519c9341ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:0a875f60b3700e480d126eb0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迈向遥不可及的远方",
      "source_fingerprint": "79ef9c1ce9f1e0c5b749a85212da7d7178b111e6a37c71f8551c4241f049cb9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049405.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:fd2147fb32263169ab079cf9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前导师的病情仍不见好转。\n中山庆典在不祥预感的笼罩之中，\n迎接了夏季集训。",
      "source_fingerprint": "d294f4882168f09d5588c626195f192855a9783f319fdaef782a57690382b20d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049406.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:5df609ce110650e4b1786c62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，\n神鹰对草上飞说出为何不挑战海外的原因。\n说她正在寻找能继承自己意志的原石。",
      "source_fingerprint": "251334a5d2c8018dd90b5f02670630e75e8b14a8756520c9fc175442be012bbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049406.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:64614d38aa051599ceee573c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "记者们判断她指的正是橡树大赛赛马娘，\n一致认为她很有希望。\n──此刻中山庆典已然失去所有媒体关注。",
      "source_fingerprint": "a76d022be15b3bf6c5629d587f35db1add397a628e07a46ea7d3d7dc663a8776",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049406.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:62ca3f7af9a20281260e2ef6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她认清自己得成为老师的希望，但眼下甚至\n连大众的希望都不是自己的现实。不放弃的她，\n决定在集训增强实力再度吸引众人目光。",
      "source_fingerprint": "85274eb85f0f069d13addaecbb320d11aedb75c53a658db8cf439ecb2e8f0c2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049406.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:8735f5c9604e1b58d2e55400",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第二年）开始！",
      "source_fingerprint": "2e193ad94ba56712a8e92ed87a15587d1a6af48670f61e354efcb818a0837f0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049406.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
