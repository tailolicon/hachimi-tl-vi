    },
    {
      "uid": "zhcn:621af916377907f0dd0748e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典也燃起斗志。\n争夺“日本杯”的赌局\n此刻已然展开。",
      "source_fingerprint": "bfddbc66ce896008c86eddd2d8ab084551c4f4beb025a91ae56401cdf2ea4701",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049407.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:42c6976e42a9b90286d615b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第三年）开始！",
      "source_fingerprint": "eef37080660583492caac78b957b8f144bbb2896156162385fc6034f5649e4df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049407.json",
