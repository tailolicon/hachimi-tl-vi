    {
      "uid": "zhcn:84556b0db27d649901d7b619",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是训练员提议先挑战经典三冠──\n“皋月赏”、“日本德比”、“菊花赏”\n当作成长磨练的机会。",
      "source_fingerprint": "5fded2a00d3ee189dc50d761f0bac86a1df152b3e3f4fc3bd7d16c68768d6b48",
