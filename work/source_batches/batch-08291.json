      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:11b58c987f06924a9b011632",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每一位赛马娘都想在“经典三冠路线”中\n拼死一搏，中山庆典也是一样。",
      "source_fingerprint": "ea42d65bd80f3d75eb7c4eefc03fd3e72e6f6910a3e1bb52c644d0a51d93ba40",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049410.json",
