    },
    {
      "uid": "zhcn:f71cad9d1b617106aa64164b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她仍然现身于“日本德比”会场……\n希望若有办法让她看到梦想就试着办到。",
      "source_fingerprint": "6dff76564d3c07de1cda9cf5708d7a9820242da41299e05717e27321dbc40b6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
