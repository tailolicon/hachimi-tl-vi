    {
      "uid": "zhcn:f56b0bdcf2e0262f841714dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典听到老师托付的意志，\n恩师的话语激励了她。",
      "source_fingerprint": "f1a198bb1e2214df526d0934f4ff3f35fb10bd6cb5ffaa27c62e42ba28f2d64f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
