      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听见中山庆典在采访中的发言，\n东瀛佐敦心中涌出不满又复杂的情绪。\n她因伤失去了目标与希望。然而──",
      "source_fingerprint": "43be0e2c63bf30016121e1685fdc29653c04d156d609413cea4043fe497b59e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049411.json",
