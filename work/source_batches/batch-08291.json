    },
    {
      "uid": "zhcn:58f2cb2dbfda7692cb0306ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同期一步步冲上梦想舞台的姿态\n既炫目又刺眼……受伤的东瀛佐敦，\n已经注定无法在经典级大展身手。",
      "source_fingerprint": "75d75e7b296b96ed55123fea528a0cd984a1e96e7cf2ca1d143b4a67d32ccd1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049410.json",
      "json_path": [
