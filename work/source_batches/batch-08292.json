    {
      "uid": "zhcn:07b2959d6bd2e834c3bcc924",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想起了导师说过的话──\n“希望能让人生存下去”。\n于是她策划了一场赌局。",
      "source_fingerprint": "766915a3b52c5ac3a69ab62ee711388b44851d480c2c15cbb572af17b365f244",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049417.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:f70d822287a9f49a5c051d31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "京成杯结束后・开始运行的事物",
      "source_fingerprint": "34aff389c3d9e64f64f13f7ef57dca4f6823a64c7a803ce32aba87020000386c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049417.json",
