    },
    {
      "uid": "zhcn:a4252ede7a5c2ff9dd720a66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……游戏是我输了，\n但中山庆典还是说出了\n她最重视的事物。",
      "source_fingerprint": "8a46d1ece57a7afa6d2d3c00a6428c384e20345b9086a3de03a088f2fa1eebf4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049515.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:f2fe5ffe0a2130f50863524e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……真有你的风格",
      "source_fingerprint": "78c126cbe66910b968714c6c2b9b69a38f8be5c46dd7723a4c0ea290a597eee7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049515.json",
