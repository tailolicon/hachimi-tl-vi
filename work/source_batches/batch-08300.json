      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──这是跟自己的对决。",
      "source_fingerprint": "f44e06ab274b7037c9b017eab19c48d1d34ebdcc0153d9fa37627b22d393eb4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
