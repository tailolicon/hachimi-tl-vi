    {
      "uid": "zhcn:7902dad8df10d398d10f9402",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中山庆典露出恶作剧似的笑容，\n仿佛正在评估我的实力。\n她唯一重视的元素会是？",
      "source_fingerprint": "9a58ab4be28275209b879a0ec185b76e0fc0566aab558192f1e57e3118dfeec7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1049/storytimeline_501049515.json",
