    {
      "uid": "zhcn:84fb4b9667046d4503d9d89a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如今的她，已经成为了相当受欢迎的人。",
      "source_fingerprint": "5e08bc59562693ae2e610a4d58a09a5969c6e2794a07a6a15821a11fa439c91a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1050/storytimeline_501050111.json",
