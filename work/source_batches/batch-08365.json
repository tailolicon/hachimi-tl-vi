    {
      "uid": "zhcn:db403d333fdf757887b7ecd4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "憧れの舞台『日本ダービー』で勝つため、\nウイニングチケットはナリタタイシンに\n模擬レースを申し込む。",
      "source_fingerprint": "c21cf13b9c297a48a7006ca75a25037a2e522a32dd2a67c877025f3ec4e85edc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
