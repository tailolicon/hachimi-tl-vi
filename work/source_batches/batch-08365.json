      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "ビワハヤヒデ、ナリタタイシン、\nそして――ウイニングチケット。",
      "source_fingerprint": "5d3f5e09aeac1f336ae35f2271c790d3820e6aacfe48e07d789d3fb058a4ef66",
