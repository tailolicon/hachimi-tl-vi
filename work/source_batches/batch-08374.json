      "source_language": "zh-CN",
      "source_text": "…………嗯。",
      "source_fingerprint": "6e9c921ee546fc114aa120322892f9154be7b73f0d4c6a0c2acc83be84f4a428",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
