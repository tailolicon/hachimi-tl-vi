    },
    {
      "uid": "zhcn:048451631cb76f6b77487052",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我告诉大进——作为训练员，\r\n支持大进、让她不断变强本就是我的本职工作。",
      "source_fingerprint": "5d8d521ad4702956091195794180c80969b13f89672118354c975701bf42b8d1",
