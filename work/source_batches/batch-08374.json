        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:b200159f256dc42363478ca9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以后还有不少要一起完成的目标，\r\n虽说不能确定能不能构筑完美的信赖关系——",
      "source_fingerprint": "f7c4fa6e0e8ef5bd477f33ddf186ce66248d78a2592c81dbc971a8df22279cb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1050/storytimeline_501050513.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:d63da99f0eb6ef9d23ba8400",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我在心中发誓——\r\n我们要以自己的方式向前迈进。",
      "source_fingerprint": "f1173b03a805a296faabdfcd42ef0d2a791ebca97e349d13ad5b6a4a58a98007",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1050/storytimeline_501050513.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:ca1337dbba57bb37dea32b18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恭喜你，大进！！！",
