    {
      "uid": "zhcn:55389221f95268384864e123",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大进大进大进大进——————！！\r\n听说你可以申请决胜服了，真的吗？！",
      "source_fingerprint": "bd5b8872391b4b6efaaf6d0372f6896711af8b0d5ce9726c3595252690cb7943",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
