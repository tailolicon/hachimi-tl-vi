      "uid": "zhcn:73b98d5dc4e9f86d83b00962",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "战个痛快罢！",
      "source_fingerprint": "1a5760f8e80532b92a029b434e9a9c3511f4288499ccc57a00ec57ee9187fe47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
