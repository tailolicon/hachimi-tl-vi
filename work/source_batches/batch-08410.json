      "source_language": "zh-CN",
      "source_text": "训练员。\n辛苦了！",
      "source_fingerprint": "26b94ef5d3abbdd84d84bbb36f28741de074cae85d9be4ed234063c4c69fc172",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
