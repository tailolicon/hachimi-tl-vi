      "source_language": "zh-CN",
      "source_text": "保健室老师",
      "source_fingerprint": "52bcda103101eea9c1330bec1cb6899d9a1705b90ed18f9c18bce6615cb81462",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
