      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:bcd87954aee9f75604556240",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跟其他同学比起来，\n我的身体还发育得不够成熟……对吧？",
      "source_fingerprint": "9ff42de40602a8c0505d2f7c1b498e12287585064ee8654890d0a7f22755fec2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
