      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道了",
      "source_fingerprint": "348f1cf1243e74bc40ca0788530d6e72653e75544a25a8262a96b9f37d24c2ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
