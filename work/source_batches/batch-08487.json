      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了当她的榜样，\n我下定决心要表现得像个可靠的大人。",
      "source_fingerprint": "8d791a69e34289f51a34977d6158c70d595c9dd6f606a0f777c57cb96bb9201a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
