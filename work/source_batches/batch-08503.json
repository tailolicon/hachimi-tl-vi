    {
      "uid": "zhcn:74fa70b7e2cbd660e097cb1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，要飞走了！\n等等我啊──！",
      "source_fingerprint": "b07228f7ea9bc102df25209bb0d34ac1df78af15775fd6b8d270628a85caccbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
