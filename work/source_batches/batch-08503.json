      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（也不在这里……！）",
      "source_fingerprint": "285044c4201d4a3c0cfb3e4bdbcd2a80d06a7e67b9cc3d670c50c4b07d08d882",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
