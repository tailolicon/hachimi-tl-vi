      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽",
      "source_fingerprint": "ead52de8a28bca47cc3766a1d8f9d13fb6418b886c3d67c4cfb46ba54a745ff7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
