      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（不在这……）",
      "source_fingerprint": "babe4989105b87e75cc295aad0ff40341d26058a3474978e17e49f738233ee8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
