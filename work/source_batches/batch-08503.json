      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──听她描述，\n春丽似乎是追着蝴蝶追到河边，\n就开始跟鱼玩起你追我跑了。",
      "source_fingerprint": "bbfebc9e0dc09df0be98ab684fae07d947fbd68f0c122000b64dbcae572da69a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
