      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:bc371f90ff200ce1dcc1f5d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽一溜烟地跑了过去。\n该把她追回来……虽然这么想，\n但她或许有什么自己的考量。",
      "source_fingerprint": "49f56e344599b07405953ff1a0535df7d95ac0159c109bb4211c82304206ec29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
