      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:74e597dfea1dfe29fe3046f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽与米浴一边眺望着海一边聊天。\n内容似乎是在讨论白天的模拟赛。",
      "source_fingerprint": "6d31c68fa75d6f7e3914ccccbf0ea29e42bbc5d57dea59afc040087c17c3f177",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
