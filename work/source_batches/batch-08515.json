      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:c5607f1436bd93911d73a65d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论跑输几次，春丽都能保持笑容。\n虽然我很想设法让积极开朗又努力的她\n赢得胜利……",
      "source_fingerprint": "8f11b6b3440f97b08d29d646cbf5afe871abbb0bfc39f3576c7cd316aec5e17f",
