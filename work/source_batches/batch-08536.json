      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:adebf60cf57ad035dba69cf1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052401.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:ecd94b02ff4a5267b15daf41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "并且为了避免她玩腻，还将训练设计成\n“一决胜负”的方式，做好万全准备。",
      "source_fingerprint": "0e6a5f685fc9a204813d16868a6557944dc8d834aed628e72dd328c7d1f125da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052401.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:82a939c9317bb085e465fd70",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052401.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:5e31b7f6fe6700efb834d003",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个作战奏效了，\n成功让春丽一边玩耍\n一边累积训练成果。",
      "source_fingerprint": "19c71996e347f81d3e6d7eff4e5e29fb22a1b68560232e85aae3b72973bc7f9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e91cd5a2920506b0fede5de5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽式训练",
      "source_fingerprint": "d7fcc5d2d8b37c643213817217842c6ba79e952c91c1a3604898915aa090545e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052401.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:23d3663f6c48dcb9fc354ee8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽参加活动的热身赛，\n结果跑输了。",
      "source_fingerprint": "052d1b6f4c08bac46429808d1884010608e9350e0a1807d63298bc126956516e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:c924fc9c0596f21fda17c988",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "场景来到回程路上。春丽遭遇到了\n看完比赛的观众，正以轻视的语气\n在讨论着自己的场面。",
      "source_fingerprint": "964f0ae562b495c853994098b99cc1b8bcf5de401ee216e8b49112693bc984ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:bf4813c1780f5cd27cc80c02",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但春丽听到有人在谈论自己却很开心，\n她笑着冲向他们，表示自己下次会更努力，\n要对方为自己加油。",
      "source_fingerprint": "f6488925dbb562c0ffc48f53d66435ec5d8be364d9697efac5f9f4758f562cc0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:c318bb04bb5f0380f57643fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众们感受到春丽拼尽全力的干劲，\n不禁变成了她的粉丝。",
      "source_fingerprint": "2aa69339e66d17e6386ad6581571d0b2bb6b8d0856eb80e86f8a2aa8bde1720f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:6ce87096775cea94db2cf6cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家一起笑咪咪！",
      "source_fingerprint": "56cefe14db5c46e12eafa57a0f187ffee7712c12b8468c7cdd1048b48183296f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:450f88915c18803359ffe663",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了提高身为赛马娘的支持度，\n春丽展开了商店街的宣传活动。\n她快乐又开朗地努力推销着。",
      "source_fingerprint": "3cad55f2f2f479dc1d5b8191a9dbef0f97e76e0a04a1c24b27e77e96609e94f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:52ffbb115cff7e7d8b7f0e33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "商店街的人们表示，\n多亏有开朗的春丽，\n原本萧条的商店街才能恢复繁荣。",
      "source_fingerprint": "aa1b59bd92b162b900553aeffebdab4d6527ef5c271cba45692db22543f788b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:0b1464b77086a7a223e1b3f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "他们说想看着\n春丽快乐地奔跑，\n就算跑输也没关系。",
      "source_fingerprint": "cbadd0ea8c340eeda9e603ac8ef64c9f840190a96d070cefd7b5b582e36c3931",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0d9c44c0770f41921bc60f9e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员听到这些话后，\n开始怀疑是否真的只要这样就够了。",
      "source_fingerprint": "2f03fb60292ebf656b621ac8b38048c0ac756586a5f20def9493833cc03c5ca2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9ec3fea6025df4a3f5809305",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "商店街的偶像！",
      "source_fingerprint": "c55b19f2f9fa79ca76c057a3d50e48f6d7df808c3c228ac5d4cbc62b95e4fe4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:4bafd967a7f34413f2672abc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:3fd2833ff1457cf77f333e67",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "假日，春丽在商店街发送\n“后援会”成员制作的传单，四处拜托大家\n帮忙投票，好让她能参加“有马纪念”。",
      "source_fingerprint": "5affe8939649e2d4915c02fce5e017cf1727dc72f39568e03a87d6a6060babed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:38b9340e5c11d90c0d03fba5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:e46ecb54f27b326692cd5a25",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时，跟春丽一起参加过\n“二月S”的赛马娘正好经过。",
      "source_fingerprint": "48e69b7acf0a3b3d8f380093cd8a49382392be38238fef53976af513ee164303",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:3d2b3fac83e4584d7c80287f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a1c740b97dfac157170d85f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她看到传单上的拉票内容，得知春丽竟然\n不是用自己的赛跑表现吸引观众投票，\n不禁对春丽发怒，并离开了现场。",
      "source_fingerprint": "91018a4c217f53b502391d42f9294c26c9854b2749d0a7b040cd97e73d4504dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6631540603c6f37583062dbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:ac76e59659aa7183c36db852",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "留在原地的春丽，听了她的话\n才惊觉自己不能再继续这样下去了。",
      "source_fingerprint": "ef0665e610373499657a0b53a8884e3c569d4a24886a590149d791a988ba5d83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:478817aa1163848f6db666a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "后援会，失控！",
      "source_fingerprint": "1e9f32c2c7dcfb1bc02ec452dca62e4f77ff1b3e5194b8315d420409de5cd98a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:23a1f566376a2c8c08cec202",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052405.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:bdb36e81a0d178e5b3921e4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在商店街的那场争执后过了好几天。\n春丽一直是一副心事重重的模样。",
      "source_fingerprint": "e6af7a5aa0f6ee8c2e172d2b20390b7d92337f92cbb4d165eff38e5593328a21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:8083c47e61dfcf53c9d3d31d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052405.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:649ff5af1f5e3b953699f02c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴担心消沉的春丽，\n因此出声关心她，\n春丽便向米浴倾诉了烦恼。",
