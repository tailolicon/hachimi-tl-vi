  "entries": [
    {
      "uid": "zhcn:02c5659e1166f84cb5177c0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽说自己最喜欢帮忙了。\n得知这点的训练员便将帮商店街的忙\n与训练内容相结合。",
      "source_fingerprint": "322c18e8e20e757559c9d1710c4acfbaad5436df691c25fe784bb827d025b714",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052401.json",
      "json_path": [
