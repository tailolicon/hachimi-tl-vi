      "uid": "zhcn:e7bc1d736139d5d1ab8082ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・太棒了",
      "source_fingerprint": "a65ea55e4ee0c21206801adbb88b1e763011177a69594c1549c14c9c52c71dcb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
