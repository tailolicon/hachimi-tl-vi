    },
    {
      "uid": "zhcn:1733101005306c51ae113f3c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "榆树S结束后・忍耐、忍耐！",
      "source_fingerprint": "a2781c067bf4be3085c6ce356c58f0a01b80b93f5be4c0322881921e1b76f3b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
