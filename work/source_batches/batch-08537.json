    },
    {
      "uid": "zhcn:a830dc7052713e86e747e7f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让她去跑她擅长的短距离沙土赛道──\n“JBC短途赛”。",
      "source_fingerprint": "807c9fd98f4288b8e16af3acc17696eba2fe697d5c284aa12e671f3b462dd52f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
