    },
    {
      "uid": "zhcn:e06552e0dfaf39494b274bce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽在比赛中落败后，\n便催促训练员，说想尽快回去集训。",
      "source_fingerprint": "49a03a3154befd05c5ae3177733f4263f11a06f51f0649c0c533a5d710edd520",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
