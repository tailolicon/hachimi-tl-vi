      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "榆树S结束后・我会更努力！",
      "source_fingerprint": "a2e5521f51824758ad41ee94dae9ece4c9cd80d361e43c69b274ba057b3b7b5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
