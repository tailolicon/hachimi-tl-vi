      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:f2a07d2f2d16f8858b3dd2a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看着春丽因“认真”比赛却落败而懊悔，\n训练员真切地感受到她的成长。",
      "source_fingerprint": "93de78048610d46cd29fa372763282d8ea4a5ad1e64041f4d402f826b68a85c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
