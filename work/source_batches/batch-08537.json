    },
    {
      "uid": "zhcn:1bb143415b074d3d9723135a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽开心地表示，\n自己在跑步时听见了许多加油声。",
      "source_fingerprint": "7aa91b8948c2aa076d88a3d5a8ca91b9489a3585058b4810a1c0d4f6d80dfa30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052430.json",
