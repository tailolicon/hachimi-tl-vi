    {
      "uid": "zhcn:c5979362be855c93990e55fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "春丽在必须全力以赴的\nGⅠ竞赛中拿下了“第一名”。",
      "source_fingerprint": "201ebca794670af0c143fb498022d92e7e0d958be8785a8e06e15ce7de794b6e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1052/storytimeline_501052428.json",
      "json_path": [
