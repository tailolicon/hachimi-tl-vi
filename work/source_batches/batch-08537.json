      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我来到商店街采购时，\n看到春丽正哼着歌走在路上。",
      "source_fingerprint": "6bb14d1b79853aa25d5e952874dc9137c73b6fb84a326327ab46aaefdb2b688c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
