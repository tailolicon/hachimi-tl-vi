    },
    {
      "uid": "zhcn:e74fb35a5df4446f5056a258",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿，你看你看！\n她的和服还蛮好看的耶。",
      "source_fingerprint": "2dd4ea836059c1b363aabf560c1d1ce77a51277c8b95d53eee684584cf11249f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
