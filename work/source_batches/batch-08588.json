    },
    {
      "uid": "zhcn:b6186854c78efc768ac7c55a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青竹回忆克制不住心中的亢奋。\n她依然完全不怕跟小栗帽正面对垒。",
      "source_fingerprint": "81f518129d50bf7c5863654e3930fe94499a7dc3830f17da386134fc246c8f1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053117.json",
      "json_path": [
