      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……八重无敌那番话，\n或许是指可能因此引发的状况。",
      "source_fingerprint": "8e46bab3a8c2fad71d7bccf2642d072c4234ca88161356fa6af5384bfc0d6391",
