    {
      "uid": "zhcn:3e5f8615604ea346d8279c88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "关于八重无敌话中的含意，\n我把自己的猜测说给青竹回忆听──",
      "source_fingerprint": "6442beab0d9bb73d9c1fdbc5956c3beee773e0bcb9002110ad24cc9e42f22b8b",
