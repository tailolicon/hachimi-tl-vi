    },
    {
      "uid": "zhcn:79195e5bb779a617b0a4f9dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──进而吞噬别人的“梦想”。",
      "source_fingerprint": "f9484a1d2d293c36e627038655f63edd9d535968a7eee5592769f36ed04c7116",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
