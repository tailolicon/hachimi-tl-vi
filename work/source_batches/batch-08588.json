      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这终归是我的推测，你要听吗？",
      "source_fingerprint": "150edd71044be096f10c524a8dfc7c6511d47820b25ba18aacd1b89e874e08d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
