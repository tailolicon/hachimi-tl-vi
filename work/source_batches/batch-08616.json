    {
      "uid": "zhcn:2132eb7f3d2ef03e8b146456",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隔天，阿尔丹前辈告诉我，\n她会来观赏“高松宫纪念”！\n还说想了解我对“梦想”所投注的热情！",
      "source_fingerprint": "91f0af5c1d5731c6dad0ed2a736f30117144b3cd6e0e43a69f272d1704c91b53",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053404.json",
      "json_path": [
        "text_block_list",
