      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "直到未来交会的那天！",
      "source_fingerprint": "2aad34f9181740cd2d9a34d7826e21155821bbf95994910bceb9fee98ad9d26e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
