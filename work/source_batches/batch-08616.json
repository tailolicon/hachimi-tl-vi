    {
      "uid": "zhcn:916233410e3cee28fae6077c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "阿尔丹前辈终于确定要回归赛场了。\n只是她看到小栗前辈比赛时的表现，\n似乎感到相当不安……",
      "source_fingerprint": "738bbc6dad1ddbb5e28b75d3b481bb8b80373c2a5a11fbc38341f598d9696530",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053404.json",
      "json_path": [
