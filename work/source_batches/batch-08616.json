      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:7f0b2bbc7118d00de5634894",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让梦想再次闪耀！",
      "source_fingerprint": "07ab745734d681e9c078b2aa1e543093fdd0dac8287e1447cb3302136cba266b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
