      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和八重则是决定要好好努力，\n才能在她们复出时成为最棒的劲敌！",
      "source_fingerprint": "db83a8401a5830793c0ac97c290b7fc4f01e616cfc34fb8663069f3e343e9fc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053403.json",
