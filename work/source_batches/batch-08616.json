      "uid": "zhcn:91f34a40d7bfcadacc3e56a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让她明白我的认真及“梦想”……\n我会赢得“高松宫纪念”的！！！",
      "source_fingerprint": "05b99c0b3ff25d4fb83e1decac058e6dce77b685bb3b6bc0b5f8ffd6469ed559",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053404.json",
      "json_path": [
        "text_block_list",
        3,
