    },
    {
      "uid": "zhcn:3d30d9c59a6fb2590bd6d35c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“宝冢纪念”是一段如梦似幻的时光！\n大家的热情、光芒，以及“梦想”！\n我全都清楚明白地感受到了！",
      "source_fingerprint": "8f26e1f884ecb66f0e78359759d54a9dd498eb7604d8b1d302a467a1565e3c16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053424.json",
      "json_path": [
        "text_block_list",
