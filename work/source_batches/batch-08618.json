      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:df0a41997120df43331d1293",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青竹回忆",
      "source_fingerprint": "10c0e62c9c29b0c7110fc490d820aac2e1803271ecdde3830e065a1ed9bdb2d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
