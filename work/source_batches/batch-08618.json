    },
    {
      "uid": "zhcn:b00e19b93df988ee638f48c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一决胜负的舞台是“英里CS”！！\n站上英里赛巅峰的人──将会是我！！",
      "source_fingerprint": "d9b4dc6ab26ec50501901d51a927ba04d00cb687e6a6777b771ece3cfa635c9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
