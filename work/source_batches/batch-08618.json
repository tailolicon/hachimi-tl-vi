    {
      "uid": "zhcn:b06360e8f92f9ea2dcfbc5b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是八重回想起挑战“强者”时的心态，\n决定再次朝着自己的“梦想”奔驰而出！\n",
      "source_fingerprint": "62a9f580e889aaef77a431d3c0c412636642f338625b8cccb11cb500b44b0f91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053423.json",
      "json_path": [
        "text_block_list",
        2,
