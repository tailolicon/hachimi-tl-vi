      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此我向小栗前辈下了战帖！\n结果她说“很期待能一起比赛”呢！",
      "source_fingerprint": "df1d2229418310148b8cb38c8015fe27c378aec0028e3752151deb006711e083",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
