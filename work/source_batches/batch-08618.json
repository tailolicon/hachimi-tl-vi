    },
    {
      "uid": "zhcn:ab5eb390e8fcfd309eef482a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・感受到热情！",
      "source_fingerprint": "2168a1a669c171071697bf399fdddfe7930afd87bde968b04c47a3943b6e0311",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
