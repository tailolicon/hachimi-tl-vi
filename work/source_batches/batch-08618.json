    },
    {
      "uid": "zhcn:9d79a29f2f6de66961d14266",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我很少想那些困难的事。\n我脑中只有一个想法，\n就是和小栗前辈成为“最棒的劲敌”……！",
      "source_fingerprint": "2d26e1f51b38cfaa347fe2655e9c986efc3de112c43699bd88b4add706db8fff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053425.json",
      "json_path": [
