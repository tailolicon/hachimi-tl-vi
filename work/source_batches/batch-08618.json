      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──几天后八重告诉我，\n她觉得我会改变这个人称“小栗帽时代”的现况，\n可是──",
      "source_fingerprint": "eb1b5d3b2e5f37cd0c386d6cce35533e250ebcfa421bc6eb2234657c51b9101e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1053/storytimeline_501053425.json",
      "json_path": [
