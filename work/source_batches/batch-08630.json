    {
      "uid": "zhcn:4d99b826b22a84a11a5d6e13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……然而，\n她在训练开始前，似乎就已经濒临极限──",
      "source_fingerprint": "e9b9b36f1a27e9b9615cb59e25ba99c45db00a184012d918b781d490ec9f69f8",
