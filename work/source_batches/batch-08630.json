    },
    {
      "uid": "zhcn:a428ca39b01056ab69bce3ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……事情发生在我们针对训练内容\n开会讨论的空档。\n当话题稍稍走向闲聊的时候──",
      "source_fingerprint": "3d1266cbca994e19154368a0afc3dbd6813b25405c8342b840f1d1c64296a2a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
