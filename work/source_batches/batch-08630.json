      "source_language": "zh-CN",
      "source_text": "唔喔喔喔喔喔！！\n意、志、力！意、志、力──！！",
      "source_fingerprint": "a97001f23f5cad4e72573169d3456894a6be10836f1d14f8e03da21500d36492",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
