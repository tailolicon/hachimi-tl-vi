      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──富士奇石。",
      "source_fingerprint": "05fe155ee625f66ff9bf68f235af1b6a80b1e80927e6d9b3a66c35831cf74127",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
