    },
    {
      "uid": "zhcn:b0f89137d4c9dd537aa00a7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "行人B",
      "source_fingerprint": "753afc0e9e25f1f6e027fb1f574b886df173ffd2d9e59c0f1e8aa776ec946e04",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
