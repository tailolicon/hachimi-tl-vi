    },
    {
      "uid": "zhcn:07b0c5db59e530fc8b14ddef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要疗养一年以上啊……很久的时间呢。\n要是休息这么久，就算伤能够治好，\n也很难保证能恢复原本的成绩──",
      "source_fingerprint": "13759b11c098e734b76c185787ab3e40c5233140dbd543d3d5a72edfc62fed28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:988f5ab27c2de51c117486ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "行人A",
      "source_fingerprint": "0fa3850951311dc30061edc4d8841f0d48741b6c31eb2688530277a04458b067",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
