    {
      "uid": "zhcn:1bda4d747a42d1b054b26659",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一名和美丽周日同期的赛马娘，\n已经散发出魄力十足的巨星气息。",
      "source_fingerprint": "b4d9263d8620630f663454fd6206720d7587ec995e79ac6625a324581cd87692",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
