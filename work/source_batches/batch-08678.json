    },
    {
      "uid": "zhcn:1f73b238aebc03fc7cc449e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "评论员",
      "source_fingerprint": "d370d7d5b07c4a4699b9f2d0596e9a21fa324599b68df12ee0fb6c8835c38f8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
      "json_path": [
        "text_block_list",
        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:0468db1cd82fb1b453f40b4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论如何，至少需要一年以上的疗养。\n而之后能不能回到赛场上……",
      "source_fingerprint": "659aa605e5831b425c07e7cfc2008b101b76fcf94f2eb10183b264bf76873154",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
      "json_path": [
        "text_block_list",
