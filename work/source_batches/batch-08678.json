    },
    {
      "uid": "zhcn:0effa661b0bc3877d139640e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石后援会的会员A",
      "source_fingerprint": "3e82794f75909998a27432558fe2f403063703ed309dc2c92627548befab4709",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
      "json_path": [
        "text_block_list",
        11,
        "name"
      ],
      "json_pointer": "/text_block_list/11/name"
    },
    {
      "uid": "zhcn:fa6c9babe0bd4d8909af1a6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呜呜……怎么会……是在骗人吧……！\n居然说再也没机会看见\n富士大人奔跑的身姿了……！",
      "source_fingerprint": "fad6cbe1473f87f7ea117849d84f9cf2e429083f232b62b3961c3d6d6b6d1653",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
      "json_path": [
        "text_block_list",
