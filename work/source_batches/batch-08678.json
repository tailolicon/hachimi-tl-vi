    },
    {
      "uid": "zhcn:9e660b80c3fa0f6023ce10f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石后援会的会员B",
      "source_fingerprint": "13e301d80b89a211b954e60634ba92e4e061b0bf317872088e163fad11badbaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
