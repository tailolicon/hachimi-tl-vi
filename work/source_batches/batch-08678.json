      "source_language": "zh-CN",
      "source_text": "所以……我、我们也……\n不可以哭啊……！\n呜呜呜……！！",
      "source_fingerprint": "dc6b2ecfa6aff295a390bc572db9454fbea50ab6f741dc95d5ddf2c7f3da5cfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
