    {
      "uid": "zhcn:7aef9b18e31d5c3abb07755f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "行人A",
      "source_fingerprint": "0fa3850951311dc30061edc4d8841f0d48741b6c31eb2688530277a04458b067",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
