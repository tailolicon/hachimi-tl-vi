    },
    {
      "uid": "zhcn:6a3d21e975951e4e3876e144",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某天的训练时间。\n我和平时一样前往赛道时──",
      "source_fingerprint": "01a799837021f64c5931c3b36d04ddf4595f2ec0dd274d9e861530e4b1fed330",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055115.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:0fed8e75e6c5120ce75f147c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的一举一动都会吸引所有人的目光。\n华丽的加速力，令人为之着迷的跑法。",
