    {
      "uid": "zhcn:b9bd6a898dee97cc3b703431",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一个计划找上了\n最近粉丝数急剧增加的\n美丽周日――",
      "source_fingerprint": "64efeec8acb6d5bee99906abfbe1ac1aa7b3e15b3dee1033ef0b51074809f250",
