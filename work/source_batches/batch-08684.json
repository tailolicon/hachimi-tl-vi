    {
      "uid": "zhcn:27cfd5f8c2d29d07b84cca93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（这就是，如今美丽周日的人气……！）",
      "source_fingerprint": "cafa74df5cc52e3b780b0a91ccfbd9d62239c96b10ee636dd4ba068e26918c3c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
