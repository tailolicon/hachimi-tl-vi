    {
      "uid": "zhcn:d2d1a487d32991b5ae9c9f66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我问你，训练员。在我受伤之前，\n你定下了什么样的参赛计划呢？",
      "source_fingerprint": "f409976bf351f79ebed80082a0022954b78e9caca18ce6ebf7fa06ad6a63b816",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
