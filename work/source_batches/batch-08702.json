    },
    {
      "uid": "zhcn:3d386faa2db9f78f01decf73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "遗憾？为什么？",
      "source_fingerprint": "92a7c7112a80614dd9ae4fd19b02c0528bd05d145124c4b569cb804fec5aaa19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:cf37ab17ef24161268d8bce9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "参加重赏比赛，也考虑过三冠路线……",
      "source_fingerprint": "6bbcb881624577e8fa7ca7ccb07b0627c1d16e4f1a20a616335bc392d13bf636",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        56,
        "choice_data_list",
