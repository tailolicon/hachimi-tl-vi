    },
    {
      "uid": "zhcn:9610df876b4335a90ed5dd07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的骨骼强度，\n和她已经进入巅峰状态的脚力有一段差距。",
      "source_fingerprint": "71db14ecc2315718dd6e1d53dafc1bd5d1886a824adc57a32f7b074a25ca3d8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:a386fa022e2ff203f457a068",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
