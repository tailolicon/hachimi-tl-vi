      ],
      "json_pointer": "/text_block_list/56/choice_data_list/0"
    },
    {
      "uid": "zhcn:4dd4a80dea228d20ebbf3cae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美丽周日",
      "source_fingerprint": "9bc0c33874bededfe52b9c93170065a5bcb7d65f7c0f121c415bc51350086c26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
