        49,
        "name"
      ],
      "json_pointer": "/text_block_list/49/name"
    },
    {
      "uid": "zhcn:10e67261fc2d677fc2348248",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是说，她的身体\n还没办法跟上她本身的资质。",
      "source_fingerprint": "ad25784af02efbceba13b825a1ab387cd1fe7b1b811bb590ead4dbad491a3478",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:33d4036f96d0434692888581",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟在上午举办的\n粉丝活动上──",
      "source_fingerprint": "5ad246952fd7f7dd14351176ad95b50c9bb9ac761e4c06dccf174c37a71fbe77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:9f64344a7a4ae07c2a0e4086",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样啊……",
      "source_fingerprint": "bfadf38f28ab3c380bc741decaae2596d8fb6019c33935303fe4c649721e2992",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        50,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/50/choice_data_list/0"
    },
    {
      "uid": "zhcn:26d8987b10ec398a1ffdd2c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        50,
        "name"
      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:b5ecdb27a16c8b5fae762368",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算受的伤恢复了，在身体发育完全之前，\n还是要谨慎地进行训练。",
      "source_fingerprint": "c6769b6013b13653473b523260056327c7f5aeedeccbc74fae766037e5ac1709",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:c1cec0292448bd2b4bb7bbea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接下来就要挑战经典级了，\n却在这个关头受伤。\n而且还发现了今后不得不面对的体质问题。",
      "source_fingerprint": "107a9a85b1ef2a8c55890010ac41e4d8034564f48e0c3ad0a2f445c584305e7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:1aa1c9bf1e469a20ce4c7333",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美丽周日似乎也受到了相当大的打击。\n她一反常态地陷入沉默。\n而我不知该如何鼓励她，陷入了苦恼……",
      "source_fingerprint": "20d17cb64027b0f95c0fad8fc3fb6ecca46247cf2badd2e005c6ad79ee75d6a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:7679ff9b6e3f3f830b30aff0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "隔天，听过医生说的那些话后，\n我决定和她沟通经典级的目标。",
      "source_fingerprint": "4a15c93a621400f58c24bb95357f6876f85aecd26887abf113ce411320504d98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:969f718942253999a0fbe4ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然很遗憾，但之前的目标就先放弃吧──",
      "source_fingerprint": "068799c41163c2739d4cd89c2d31cfb825275940faa3f2338311e2f0fd3a1867",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        54,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/54/choice_data_list/0"
    },
    {
      "uid": "zhcn:964d9fc676492eb2c37184d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若按照医生的忠告，\n目前她难以承受和竞争对手同等的练习量。\n想当然地也难以挑战大型比赛吧。",
      "source_fingerprint": "38a9e637ce145162ba0949c9e6e90c74017d6946a52f2ad706a7ce6f33f05f09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:abc6d328b21fa188315405bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "什么……？",
      "source_fingerprint": "7b9c4953ab77964dbc5cd56b37bfe1a0df549263759f088f595dae547ba6bdb9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
        "text_block_list",
        55,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/55/choice_data_list/0"
    },
    {
      "uid": "zhcn:e2c2b10df027ee0f5dbd46d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美丽周日",
      "source_fingerprint": "9bc0c33874bededfe52b9c93170065a5bcb7d65f7c0f121c415bc51350086c26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055304.json",
      "json_path": [
