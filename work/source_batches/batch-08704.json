      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:bea09485539780eb01100741",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊哈哈哈哈哈哈☆★☆\n大家────！！觉得美──丽────吗？",
      "source_fingerprint": "3c8663528a5fad9d0f20802ba51067766bd5991843d6b624b8082d7f101b5c45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
