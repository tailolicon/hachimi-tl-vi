    {
      "uid": "zhcn:c8ca12841ee7f6d9a2f36d12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实前几天\n我才刚从训练员同事口中听说\n富士奇石的恢复状况。",
      "source_fingerprint": "b4db0b02395cbd9035e5a549724d3b10e6db4397ebae39270cd4467e7c75e7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
