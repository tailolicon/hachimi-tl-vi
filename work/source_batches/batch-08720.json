    {
      "uid": "zhcn:30e113147836ca6fff81adb8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于来到出道战当天。\n美丽周日显得比平时更加情绪高昂。",
      "source_fingerprint": "7eb55208f51a74259a418fc820e2f03ff36285605117e56fa4e1fc757e4c5c5d",
