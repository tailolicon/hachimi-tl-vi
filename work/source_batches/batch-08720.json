    },
    {
      "uid": "zhcn:a9d026ae644ca90a5edd738b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──与美丽周日共度的\n热血夏季集训就此揭开序幕！",
      "source_fingerprint": "b9babc1146b104751edc5f268b19a6c1fe38c6fffa097b2e8c0fe54dcc453c0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
