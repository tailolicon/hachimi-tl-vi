      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:0535d62ea01c2ac9a7798729",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向有马纪念",
      "source_fingerprint": "a28480a57275928fde3ca335c4e37d5670b04bf8228df0e3cc61294de9b176ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055411.json",
      "json_path": [
