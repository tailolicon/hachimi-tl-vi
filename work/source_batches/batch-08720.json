      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:78513316c1d21eced06f2093",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要她跑出活跃表现，\n往后一定四处都能听见赞颂美丽的声音。\n“世界美丽计划”的第一战即将展开。",
      "source_fingerprint": "7b57b36af124f961bbfb14f15b3b02874f0e27e7295edad736776fde3af2d05a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055408.json",
      "json_path": [
