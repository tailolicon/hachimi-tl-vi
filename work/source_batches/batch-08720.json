    },
    {
      "uid": "zhcn:4191514d2731d85978aa41b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "期待、不安、兴奋、困惑──来自赛马娘、\n训练员、观众们的各种感情仿佛互相交融似地\n从各处流向“有马纪念”。",
      "source_fingerprint": "1fcfb1319ff1447670d0cf8307563c37e7e2240e3bcf5df83b3032890f845452",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055411.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
