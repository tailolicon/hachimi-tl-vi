    {
      "uid": "zhcn:103c177bbe06c35291f47eb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁自受伤以来\n成绩就一直不见起色。",
      "source_fingerprint": "791bf2a9165dcdadf3c95fb4d5ffad1c24086e2ff37b9d26a0c94a5b976c5fac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
