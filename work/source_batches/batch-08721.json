        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:14f628cc8c1e15474750fb32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "维持这个气势，明年接着挑战\n“春古马三冠”吧。现在的她应该能够\n在强者云集的比赛中获得结果。",
      "source_fingerprint": "74d514abb56fd7f14bd802993afc4eaaffecf76af5e7d3bb0a71b026433267b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055421.json",
      "json_path": [
