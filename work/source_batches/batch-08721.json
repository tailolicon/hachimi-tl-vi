    },
    {
      "uid": "zhcn:b5d065cfadd022aa4632b7f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们遇见了崭新的光辉，与此同时，\n经典级的一年也就此落幕──",
      "source_fingerprint": "d561e1b4dbdd57634d7ebb6cb172fbb3d67c3d06ba36fe20452512383fd4eb25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055422.json",
      "json_path": [
