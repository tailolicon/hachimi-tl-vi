    {
      "uid": "zhcn:8398d3b8b38d75bf78bdd2c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "挑战C结束后・获得的强悍",
      "source_fingerprint": "0a3539888b38d67ac259e8059bcb65c96b36060116da75eb2b247d33d5e682fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
