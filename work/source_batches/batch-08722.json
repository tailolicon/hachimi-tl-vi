    {
      "uid": "zhcn:6846706eb276d14200abe245",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇迹不会就此停下脚步。\n美丽周日接着迈向下一个目标“日本杯”──",
      "source_fingerprint": "f5ceeefb198c28b11c4218b9b3f3587a60f355c1fd317d66529debd5a1f51f54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1055/storytimeline_501055430.json",
