      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "绵延不绝、永不止息的欢呼声──\n每一位粉丝与竞争对手\n无不绽放出耀眼的笑容。",
      "source_fingerprint": "6c48289f3fc327264d183663dca6f328935defacad1a274edbe7be5942f67694",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
