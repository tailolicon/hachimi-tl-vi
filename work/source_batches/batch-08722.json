    {
      "uid": "zhcn:f4e2391290047ffd0f841b10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从她身上流泄出的光彩\n似乎也感染了同在赛道的竞争对手们。",
      "source_fingerprint": "c3c9ce5fd36efdbacca4b10d5f3e75a5160ea11374360034b4aa2ca6f8a3a28d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
