      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美丽周日全力地跑完了“日本C”。\n那跑法就跟她的双眼一样闪亮。",
      "source_fingerprint": "660edb1f734f90ea3ba0aa9f4cce642c7594f36de6648a3c1b91e138546e4544",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
