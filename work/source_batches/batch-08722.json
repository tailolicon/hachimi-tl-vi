    },
    {
      "uid": "zhcn:4c048805e9a5cec837946a1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・迈向增添色彩的季节",
      "source_fingerprint": "fbf8ffd3aa8049a054e3fd8ace90502445825ca634baf5e234f0f21928696256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
