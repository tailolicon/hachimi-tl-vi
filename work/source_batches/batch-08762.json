    },
    {
      "uid": "zhcn:22b49ec3a74636f2f9ac2b07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大概是一直大吵大闹让她十分疲倦，\n所以开始打瞌睡了。",
      "source_fingerprint": "55a317249ede411d0e214101055e76d30b94184dd37b05923824628516e3474f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056112.json",
