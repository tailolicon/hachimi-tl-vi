    },
    {
      "uid": "zhcn:f959a82ef0bd81d5b745e845",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这是！？",
      "source_fingerprint": "5dc211b06b2aac353d7ea49fbf4cdea1bbf9a3bc07ca5d424edd12886c74d09d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056112.json",
