    {
      "uid": "zhcn:9c0d3d31d62febd0e872b19b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她以歪斜的字迹重写了好几次。\n上面写满了数也数不清的即兴搞笑内容……",
      "source_fingerprint": "b966b43125e8fcbcae3ae3fd73eee1c211ca2468e9a79e862bed674306d4bf1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
