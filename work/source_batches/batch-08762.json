    },
    {
      "uid": "zhcn:4497270ae453e7212ad1aeaa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──是灵感笔记。刚才表演的\n即兴搞笑点子全都写在上面了。",
      "source_fingerprint": "aa5688f42298954895f84abe5fcf04c32a657711adfbd41634b6cb210917287c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
