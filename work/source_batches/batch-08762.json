    },
    {
      "uid": "zhcn:76c6516ca81cb69d15711b35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我正在思考要不要让她\n先在哪里睡一下时……\n一张纸从她的手里掉了出来。",
      "source_fingerprint": "29bb3ee7b42c736278a032755a35f069589b2ada7fa56c4f5429452c08f72ce6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056112.json",
      "json_path": [
