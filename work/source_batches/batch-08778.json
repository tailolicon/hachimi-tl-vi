    },
    {
      "uid": "zhcn:d107bfd4a528cc6c97599e36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呃──全国的各位人士，\n我把值得庆贺的日子变得更可喜可贺了！",
      "source_fingerprint": "104a006f9ae6d1e2fc8b08b1f1ef4994845a26e7fedff898e0868a06266ff5c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056315.json",
      "json_path": [
        "text_block_list",
        8,
