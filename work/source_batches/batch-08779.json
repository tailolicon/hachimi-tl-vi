      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向菊花赏",
      "source_fingerprint": "c32fe703b345a297a6972e4f3115aec53ea8a9931382257ccb6b146928c5537e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
