        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0e0a251a442940bdcefa4d27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使面对3000米这个从未跑过的距离，\n待兼福来仍旧展现了积极的态度。",
      "source_fingerprint": "f3b57d51a08bfa7ab4fa29634c1be81d64a456e57264526dabeb98b1019ab4c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056413.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:cf30a912247a484b8a783988",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她把一切都寄托在神明与幸运上，\n前往挑战这场地狱般的长距离竞赛！",
      "source_fingerprint": "6e3f106c28d870795e1c2bc83a73930d84e92486af7262751353b62a3793773d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
