        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:389224a23782fab9ec60a3e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向日本德比",
      "source_fingerprint": "e4074326c9093437fbf37c8e5b00d67df67963c2eed1109506df4b11f06953bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056412.json",
      "json_path": [
