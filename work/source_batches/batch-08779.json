    },
    {
      "uid": "zhcn:38cb1941413d8fefa9f2c8f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在拥有众多神社与佛寺的京都举办的\n重要比赛……“菊花赏”即将开始。",
      "source_fingerprint": "c6fedcdc21287c8ad5a5e700f074f0394f46b0bef56126479d036f4e989f61c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056413.json",
      "json_path": [
