      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了拿下不会输给五棱郭的\n璀灿胜利之星──",
      "source_fingerprint": "8b2a88595c0ee0970e2ddafa613f006b35e66b2e528dd5523db87e7fb77c9c2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
