        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:99cd25c0025d8c4bb6a01fbb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "待兼福来充满了自信，\n认为自己已经和去年不一样了。",
      "source_fingerprint": "2f06d3e3ec06114ecce84924c36fdbf041f1568ce9ddc65241e76c539f0461e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056414.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:be685fae6a8469ef60b1c77b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无声铃鹿虽然很担心整个人散发\n异样气质的她，但她认为只要依靠幸运\n就会获胜，并没有注意到周遭的情况。",
      "source_fingerprint": "b3d06fa79e1cc35e7e80151b571800dcdba0ac5a9126c5ae6508392647b71d38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056414.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:67fa841cc1eafef5869732a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她带着比平常还要危险的眼神\n踏入了赛场。",
      "source_fingerprint": "72baaa7ca3a998b5a617aeb7ca305c33ca30b14fdcbb23f2dd9690251a019dc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056414.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:11b8f2817f225d130a61136f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向金鯱赏",
      "source_fingerprint": "9b54cec505cf296b5d72c10e4c1631d5eea5e023e4d143f67f434ddb1580965e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056414.json",
