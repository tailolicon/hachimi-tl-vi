    },
    {
      "uid": "zhcn:dc042f9417483b986dee5892",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "待兼福来准备挑战金鯱赏。\n今天的比赛无声铃鹿也会参加，\n但是……",
      "source_fingerprint": "178d27f5c435d8890a441b3ff95aec1577abb22469e02b98328b5bd40dcfdb45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
