    },
    {
      "uid": "zhcn:97104469b390ac48ac3f91c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的眼神兴奋无比，明显不太对劲。\n有些担心她的训练员决定稍微拉长比赛间隔，\n把目标放在明年春天的“金鯱赏”上。",
      "source_fingerprint": "9ea52ab6812381bcf02e94081489041d5f539940096350d276cc48809b0f8889",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056425.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1230150736114e09ef934a71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花赏结束后・福来，开☆眼",
      "source_fingerprint": "4e87fb73da402ec5ac6e0d1c5e1821c4c1cc0f157e4883b02709ab6637ccec42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
