      "source_path": "assets/story/data/50/1056/storytimeline_501056425.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:9e9434ca69375d09c9ab3c0f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许是因为神明听到她的祈祷，\n待兼福来赢得胜利了。",
      "source_fingerprint": "7f4eb38b7767309d6421c9ad4f4408fb924f49dd595ddedfce0fde4761be8390",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1056/storytimeline_501056426.json",
      "json_path": [
