      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "叮咚叮咚──！！！\n训练员，请你快开门──！！",
      "source_fingerprint": "ff7b0cd3b0769dc9ac6a2b75536e9a87777dc08a80f2e88dc61811c9bccd1580",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
