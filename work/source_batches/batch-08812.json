    },
    {
      "uid": "zhcn:75a1f34332432089c67df995",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她果然很厉害……！）",
      "source_fingerprint": "aa8bea9f07584454a87312331298f92659c879041872521a9c27524f5f2af70a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
