        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:58e33c706c3128165141f0c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她精彩的表现让我感到震撼，\n我忍不住看得入迷，甚至忘记自己正在找她。",
      "source_fingerprint": "62a966cb83eb985ab3d6fb59fa4da91a5d9e4c8025dca384ef1b7b15e45d9e20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
