        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:0f64f0bb826f8e832a44bb62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她没有来训练，于是我到处寻找后，\n终于在这个举办非正式比赛的地方，\n于火热的比赛中发现了她的身影──",
      "source_fingerprint": "087cbf51980af754b76d717ed4592cb7387c9ebc04de85c6cbf22f054447a505",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057100.json",
      "json_path": [
