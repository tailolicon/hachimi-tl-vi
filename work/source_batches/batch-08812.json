    {
      "uid": "zhcn:d73c3eb003729931a0e5734b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在花式自由赛的赛场上奔驰。",
      "source_fingerprint": "1073470363bb0559111f74194d67f95c0906c9fba232629dc4c2f771e3fb32bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057100.json",
      "json_path": [
