      "source_language": "zh-CN",
      "source_text": "……我对这些事没什么兴趣呢。",
      "source_fingerprint": "f5be23fab87e8478e789da6c55e7944d5eb8960d658550348f5c5108afb7bf38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
