      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:66575a6bf2cb5a3800351c58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘们",
      "source_fingerprint": "a0f0dcd5cfbde045bcedbcf0687c7f95f475ee6315345fa057f54916adbdac32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057100.json",
      "json_path": [
        "text_block_list",
        46,
        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:a0edafb3755b79b9b1e1e066",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "什么！？",
