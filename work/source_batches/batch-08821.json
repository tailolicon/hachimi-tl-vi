        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:802db105ed1b8310c2c9f891",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一大早就看到许多赛马娘，\n原来她们都是在等千明代表。\n大家手上拿着各自准备的礼物。",
      "source_fingerprint": "9130384416151872156ca064b11382cf489e654e75495d118ea8da0d1a4a514b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057107.json",
      "json_path": [
