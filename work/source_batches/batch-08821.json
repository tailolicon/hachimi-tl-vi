      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:cc6dacb022ffe273221cd044",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样啊……所以你才……",
