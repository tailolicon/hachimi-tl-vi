      ],
      "json_pointer": "/text_block_list/30/name"
    },
    {
      "uid": "zhcn:aa6cb6e023270676fc97b529",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……唔，是的，我明白……！\n即使如此……我还是想送给你。\n所以……请收下！",
      "source_fingerprint": "2527b268444eb4848d400dc28667f5a1d708a251877c8713cf72b6f1774609a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057107.json",
