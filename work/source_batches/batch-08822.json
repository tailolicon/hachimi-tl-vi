      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我、我只是随便说说！",
      "source_fingerprint": "7bf25cffc09250b6c3d0bed25eea1b25749bec911d69c71993328df9a1626ca6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
