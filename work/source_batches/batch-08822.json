    {
      "uid": "zhcn:a05ae8456a867b28509ea7fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为，既然目的是传达心意，\n那没有巧克力也没关系吧？",
      "source_fingerprint": "39c860860fa4379470c098eaf52b51bc5d818545bf708ccb858f253c2d77e3b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
