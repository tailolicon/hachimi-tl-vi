    {
      "uid": "zhcn:a1c642d322206e302572db61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（真是豁然呢……）",
      "source_fingerprint": "1c0d88cae7a169277fa5341bd2f9bbce13c83a327bbcaa244aa12951b07e0a86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
