        34,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/34/choice_data_list/0"
    },
    {
      "uid": "zhcn:d9988750f4fdd393ee44902a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但就算是这样的她，还是必须将巧克力拿在手上。\n即使只有几克，那份重量依然能\n确实对她带来影响。",
      "source_fingerprint": "27171752fcadd4747a6d2841262085744a18695d38728abe6195064a8ea2a2ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057107.json",
      "json_path": [
