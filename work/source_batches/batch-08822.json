    {
      "uid": "zhcn:9fb2d82e34dd508de212fba6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦？\n……重量？",
      "source_fingerprint": "6a0a384ad39ffda196461fc5ddeb0332661cae704652c98b253c3365775d36f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
