      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:b1ce91ab19cedd1b078f1655",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使只是微小的影响……",
      "source_fingerprint": "5a58c00da8a87e25efb43d768c8f2ca18c865ad5816a7c112e62c780d1895c05",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057107.json",
