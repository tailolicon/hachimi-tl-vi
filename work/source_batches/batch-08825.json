      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:61cb13991e1a9f150a4b0211",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我可以跟你一起去吗？",
