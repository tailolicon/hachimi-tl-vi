    {
      "uid": "zhcn:4e0fb7759363871757a51e07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她无论何时都会照自己的想法行动。\n看见她依然不改作风，\n让我觉得松了口气。",
      "source_fingerprint": "cdad3b39be7658dc51078cd7977dca6c722369c1f683c447c826ea457d0f852f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057109.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:3565f3571c022087445a08cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也想要那么做",
      "source_fingerprint": "403c3660331f5d46998b19ad22c107e706dedd2923b711ca756690d5649cb274",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
