    {
      "uid": "zhcn:af32c55c71750bbac2a09901",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我打算现在就出发。\n我把你的旅游券给你，\n你自己看着办吧。",
      "source_fingerprint": "9ba1303741d3f16616a0abeb0c63063f51be5863925eff2163241e03b59ee816",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
