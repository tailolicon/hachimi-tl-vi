    },
    {
      "uid": "zhcn:a68e62e136748c0517a746ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在这段时光中，\n深刻地感受到了\n与千明代表之间无可取代的情谊……",
      "source_fingerprint": "cfc8c6f7240a1ff3d8722276e192a23918408f1f85785d2c54a8410f2429116c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
