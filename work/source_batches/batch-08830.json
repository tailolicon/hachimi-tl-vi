    },
    {
      "uid": "zhcn:0d7ee68cea01a7298b7b41b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想起之前在商店街的抽奖活动\n抽到温泉旅游券的事情。",
      "source_fingerprint": "1f6558ae573044b96dfe9180dda0c6ba5161dbf6c7545e45b310e241bfdb51a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
