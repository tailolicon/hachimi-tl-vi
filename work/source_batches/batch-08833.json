      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了引导所有赛马娘获得幸福，\n我需要能够推动许多事情的力量。\n为此，我必须登上顶点。",
      "source_fingerprint": "810576f37c123a93992b80e8d10467a5db5ad3143dc90cbfe895d4a611be3f91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057114.json",
      "json_path": [
