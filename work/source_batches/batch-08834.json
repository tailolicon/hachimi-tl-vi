      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "褐发青年",
      "source_fingerprint": "a98ab2b20c04c5e563d9efbbae2d9c705155bc6ab3f6a7277c774e8da1ddf859",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057115.json",
      "json_path": [
