    },
    {
      "uid": "zhcn:82e60fe8305e1edb35a917a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──啊哈哈，怎么样？很厉害吧！",
      "source_fingerprint": "e7f998c073ee790e1c3f809ed23c8e7b3f4f78fd1a0c0e07cb450b4074e25056",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057114.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:9b5b1700df8678bf300b10f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但正因为如此，\n她让我见识到了许多一个人无法看见的景色。",
      "source_fingerprint": "9bd9723eb5559967c75a73ba12f9004aab32d8c9f4ca64a382bcf8fa1d728fcc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057114.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
