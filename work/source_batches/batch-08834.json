      "json_pointer": "/text_block_list/11/name"
    },
    {
      "uid": "zhcn:fb178dbd24537a349cd9f09b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以千明的实力，她只要不豪赌就会赢。\n我也有写信跟她建议了……\n她今天一定会赢！",
      "source_fingerprint": "c863f39c2fe7e024c14e7094b09d16a75ec3be87a8dc8a0e867f31fcb99ca57d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057115.json",
      "json_path": [
