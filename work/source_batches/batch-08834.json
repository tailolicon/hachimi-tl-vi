      "json_path": [
        "text_block_list",
        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:d96850311505f87840674d50",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这次的参赛阵容就像是GⅠ竞赛一样呢。\n千明和鲁道夫到底是谁会赢呀？",
      "source_fingerprint": "66fea12bafb8bd70d966e11f9b00ca41ae35516d85bd019cc7b75e419266654f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057115.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:ca0a56e01c2b110e7c75bf20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明的粉丝B",
      "source_fingerprint": "b0623151803218f071fcd956b4f808d95108d7ebe0cf9c05bcd95fe61b9641b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
