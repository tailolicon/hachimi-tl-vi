    },
    {
      "uid": "zhcn:0dbf3544f3bc82e8135fb14a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明的粉丝A",
      "source_fingerprint": "9beef4fcaa6ce017770188cdc55f77f05501da94429f77c346e34f37b415e1d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
