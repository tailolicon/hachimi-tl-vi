        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:d65946f9021778b74d3d1c7b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "活动实况",
      "source_fingerprint": "b780180f1daeb829cc62d85885e49b1841fa6fc126a32da21aaa6837ff15f86a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
