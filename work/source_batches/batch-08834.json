    {
      "uid": "zhcn:e6a9ca34c5bc45bd75cb4f41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我答应你。",
      "source_fingerprint": "6beb945eb6084ddebc79297bce9ebd988f4b1ce998a6a7ec2e64488ef9c4e133",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
