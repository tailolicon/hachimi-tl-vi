      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:dce44d73b667a63220bb51d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……什么？这个讨论串是怎么回事？\n“我就直接问了，\n千明和鲁道夫谁比较强？”",
      "source_fingerprint": "a8e6ca3f98fce00f439fe8a0e672c3a884fcd7e0d9a2c470059786edc808247c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057115.json",
      "json_path": [
        "text_block_list",
