    },
    {
      "uid": "zhcn:742f91d0571600c0b5bb9d9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第二年）开始！",
      "source_fingerprint": "2e193ad94ba56712a8e92ed87a15587d1a6af48670f61e354efcb818a0837f0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057406.json",
      "json_path": [
