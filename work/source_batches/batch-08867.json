      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:98e25ef4d7f0d3c7db177c25",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使不擅长，\n千明代表仍向训练员约定“不论发生什么事，\n我都会一直是能让你看见梦想的千明代表”。",
      "source_fingerprint": "f26b77034fd92dcc420869edf179ac622b7675c012befd0034223a83ee65417f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057402.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:26a11e8fdcf5f21036f9264f",
      "kind": "story",
      "source_language": "zh-CN",
