      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员担心千明代表会在意舆论，\n但她笑着表示自己不在意。",
      "source_fingerprint": "fe1dbd09a7c6890b6e7f10cee9e78f723def39a71fc99debb4d25c21f0abd134",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
