    {
      "uid": "zhcn:84ef4169cd73e026bd3ac72c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天后，\n千明代表说想让训练员看看她眼中的景色后，\n就提议要背着他跑。",
      "source_fingerprint": "48060548de59f0d837f55f10af6e6fbececc58829a5ddf355ac61bfe546f68e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:80c56524ddbe05f6e4afb809",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057401.json",
      "json_path": [
        "text_block_list",
