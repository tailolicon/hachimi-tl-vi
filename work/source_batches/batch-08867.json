      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:f577488ad28cca09cab773cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而，训练员不仅肯定了这样的她，\n还说自己的世界被她拓展了，\n这为她带来了勇气。",
      "source_fingerprint": "f3c4126535e8eea95b8e4522a18cc299bded561772611dccfb8c5fecfcedcc4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9991e93a9dda596ec2956ed6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057402.json",
      "json_path": [
        "text_block_list",
