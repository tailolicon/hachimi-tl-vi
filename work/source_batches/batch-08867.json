    },
    {
      "uid": "zhcn:cd76041c20e4098ea3e54886",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057403.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:98a4a9ee138cab34b5fd6626",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经营“周刊哒哒频道”的青年也有来观战，\n并采访了千明代表和鲁道夫象征。",
      "source_fingerprint": "35b4e6e166819c0e937b9d7025c1a2a4b79af1436d150edfe59ae12d51617079",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057403.json",
      "json_path": [
