    },
    {
      "uid": "zhcn:7d0508ab13c963a6c2a871cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "景色不断向身后飞去，风从耳边呼啸而过。\n训练员虽然只看见她眼中的部分景色，\n但仍获得了非常美好的体验。",
      "source_fingerprint": "3cd58b81906373f150d89c4a8a848c1bd55b55dc0f57232f75d8b100143c6084",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057401.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:fe0d93b0585a6d24aa448e5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我喜欢的世界",
      "source_fingerprint": "f12c31b534c3c9798283b015bca784e5f3c58acaa53af23a7d6330d14a7b652a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
