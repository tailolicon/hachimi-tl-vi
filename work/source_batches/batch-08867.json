    },
    {
      "uid": "zhcn:257a0e8204d495a36d7864d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青年表示自己期待千明代表\n能够成为传说中的知名赛马娘。\n然而，鲁道夫象征出现了。",
      "source_fingerprint": "bfb5bb686caa4abbf118ea7f7688e5a3cdba43eb70f0cb3f0adf17f864cf8bbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
