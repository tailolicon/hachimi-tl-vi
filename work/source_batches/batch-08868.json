        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:dd0af29f8f1ae916ebeaa970",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员建议她自由地奔跑。\n千明代表笑着表示，\n她会按照自己的风格随心所欲地奔跑。",
      "source_fingerprint": "df4a1c4be2f0c101f61b27013bd123f0b2ac1a288c284e9e76c66b4a1f6e992f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
