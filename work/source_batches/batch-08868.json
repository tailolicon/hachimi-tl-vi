    },
    {
      "uid": "zhcn:7e47abbef7a99103e4c24f2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然全身都因为这场比赛沾满泥巴，\n千明代表仍开心地跑到最后。",
      "source_fingerprint": "6641d00cfeeaa4396d102df1b22bf6d0a5da1a921bd97d723f01adf4d72a57de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
