      "source_language": "zh-CN",
      "source_text": "众人都期待千明代表能够达成由日本赛马娘\n首次称霸“日本C”的壮举。",
      "source_fingerprint": "5328ab3c921fb47834207312feb8647c3c7cd1ea160f6eed919cbbbb1d89b933",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
