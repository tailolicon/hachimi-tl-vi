      "source_language": "zh-CN",
      "source_text": "“日本杯”当天。\n观众们对于鲁道夫象征没有参赛一事感到遗憾。",
      "source_fingerprint": "50df4a66cad56335ce429e23aa9904a92f55cf1c38b5611516f480b1adcba3c9",
