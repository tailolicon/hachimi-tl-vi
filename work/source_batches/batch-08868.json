    },
    {
      "uid": "zhcn:456d2542388c688163478d18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "共同通信杯结束后・“跟我对决”",
      "source_fingerprint": "023972852d52c498a250c9e28fc19f3e382fbf679d1af357859678e69a8f5604",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
