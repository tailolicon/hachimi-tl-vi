      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・倾盆的热情",
      "source_fingerprint": "cb1a3eadf344f808493a8146ec1eb677461a77f8737ec0206e5270ff79f0af76",
