      "source_language": "zh-CN",
      "source_text": "千明代表表示虽然输了很不甘心，\n但这场比赛让她跑得非常尽兴。",
      "source_fingerprint": "99b2b62c1de6b98edcb60282804f1825dbdf25a92de3ac4a0b840c422368216f",
