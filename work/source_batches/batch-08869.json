    {
      "uid": "zhcn:59a4267375e296b1652525a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表赢得了天皇赏的荣耀。",
      "source_fingerprint": "77a09d8506f657ae68536e55868138136704f2895a67a5a382f177cf6d22862f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
