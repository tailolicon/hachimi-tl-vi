      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表的下一个目标，\n是经典三冠的最后一场比赛“菊花赏”。",
      "source_fingerprint": "2f06c8f53b8225821b25cc18d416cb7ef31373240883c5cebe07cca2a9257a95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057423.json",
