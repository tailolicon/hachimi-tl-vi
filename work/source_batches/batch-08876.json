      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我说，鲁道夫，再像之前那样比一次吧！\n这次我们都换上决胜服。",
      "source_fingerprint": "47b89a38230eaa8e36671c738891997003c65b2c21e7ffa08ac3428585d5a9ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
