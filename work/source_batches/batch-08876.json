    {
      "uid": "zhcn:3d737f7d195a9c7cadc40e57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正合我意。\n就让我亲自确认一下，\n你是否真的已经找到答案了。",
      "source_fingerprint": "3ec6f5c91e3db0a6bb7ca4b72b8379a0e41f02e2490996b8acca905d71367bfe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
