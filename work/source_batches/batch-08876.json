    {
      "uid": "zhcn:19e662f5d938947d7c3d61bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉千明代表刚才好像瞄了我一眼，\n但她很快就重新看向鲁道夫象征。",
      "source_fingerprint": "e03566a7184a4db82fa00b893a4e0796041646aa77f12427f5491be169da19d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
