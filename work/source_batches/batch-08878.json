      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:4005b0e5ed145c51fd09852e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我本来想提议下次再一起来……\n但最后还是把话吞了回去。\n因为我觉得立下束缚她的约定不太好。",
      "source_fingerprint": "35403b86a85b4dbaf4838eb32a0b8534233a8425880d1af2dde638992b0fda39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057515.json",
      "json_path": [
