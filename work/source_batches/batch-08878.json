    {
      "uid": "zhcn:ae871525f842b349b3cd8925",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果下次又遇到，就请多关照了。",
      "source_fingerprint": "6a6c11c4a93cce816d889071a0dc8cb83f686a8afd205433bee19b9b24daae0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
