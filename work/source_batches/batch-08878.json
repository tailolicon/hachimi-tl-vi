    },
    {
      "uid": "zhcn:1a28cce571870619c5730793",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这段如梦般的时光到此结束，\n为了继续在她身上看见梦想，\n我连忙追上她的背影。",
      "source_fingerprint": "2159948b4280ef876fc15d6f6a365e1b36220f9b0362aec8f72b4edae8233493",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
