    {
      "uid": "zhcn:4577d45d4f6d55b12b538208",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……\n我偶尔会来这里。\n所以──",
      "source_fingerprint": "e3e5f26fb3b658aefc78b17ff6cffdd4baaea1d37c2257673f9fa6f9a6da48e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057515.json",
      "json_path": [
        "text_block_list",
