    },
    {
      "uid": "zhcn:9b0775de19b0d2977f8e5601",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也效法她坐着闭上眼睛。",
      "source_fingerprint": "529994b6f4aff9ecb9ce0b37da90d9c6175cb2bda7abe71d1a6e176cdd927088",
