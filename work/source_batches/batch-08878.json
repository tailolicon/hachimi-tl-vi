    },
    {
      "uid": "zhcn:0a1f5baafb134a9101b19e95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表",
      "source_fingerprint": "ac2ed51a4f1bab94d7cfad72158d24dc1b65b6e98236640c4943c73987c0fb8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
