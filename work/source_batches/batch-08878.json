    {
      "uid": "zhcn:5c77806ac455a8f11d4dbf7b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊哈哈，你明明差点就遇难了耶？",
      "source_fingerprint": "d9b7cc99a1fd289825e14a521a7e84892b27f475bc4c58f389f0202b88917b05",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
