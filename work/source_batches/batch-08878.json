    {
      "uid": "zhcn:75c481c5758667131e77c839",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……吃饱饭就想睡了。\n呼啊……我稍微休息一下～",
      "source_fingerprint": "fe96ac26ebcd73979e9d92fc026da1abe9d586c907737dfc4ae56ec0ca0a782d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
