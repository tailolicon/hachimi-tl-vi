        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:bd9f22ede60cca2038cd08fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要回去！我想在你的身边看着梦想！",
      "source_fingerprint": "9d4f640e7a3a357c6032e94cd149cde04ff77d739ae38a9c15c716b4d09f9faf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
