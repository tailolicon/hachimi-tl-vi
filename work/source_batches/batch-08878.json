        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:0b17cc7c6da0c2d1eaefbd69",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯！我才要请你多多关照！",
      "source_fingerprint": "8982cb5f71f3797e0f2df3b61990726603bc4801e8304749b81ea9381a81ee60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
