    },
    {
      "uid": "zhcn:ba134a2f94e3700e1f36a042",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表非常轻快地吹着口哨，\n随心所欲地踏出步伐。",
      "source_fingerprint": "dfb6d0d42ed3dc90f7c5037e8af3520ea433c370385196b4d4512ead94922180",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
