    },
    {
      "uid": "zhcn:254b64fac16fe779b1730aea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "顺着当下的状况和心情前进，\n如果能再次像这样相遇就好了──\n我怀抱着小小的期待，踏上归途。",
      "source_fingerprint": "64839457a5e051af15296e97c2919341ec45f9daa9d23077ac8570d88d0268ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057515.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:9faa41eb6f459948ad95505e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表",
      "source_fingerprint": "ac2ed51a4f1bab94d7cfad72158d24dc1b65b6e98236640c4943c73987c0fb8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
