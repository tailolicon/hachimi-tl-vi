      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:5a8d8b23c67feec53f14eb71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表",
      "source_fingerprint": "ac2ed51a4f1bab94d7cfad72158d24dc1b65b6e98236640c4943c73987c0fb8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
