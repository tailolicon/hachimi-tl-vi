        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:aa7e4ee1acb0169ed903e04a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，她的母亲则是称霸重赏比赛的名赛马娘。\n没想到他们两个人后来会结婚。",
      "source_fingerprint": "59c664b6521b6aae71f497743cc74e131d101c4ba93814d34e00a683bc153167",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
