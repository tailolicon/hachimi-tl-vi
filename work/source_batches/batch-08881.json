      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我女儿承蒙你照顾了。\n没想到会在这里遇见你。",
      "source_fingerprint": "22571530d5eff734a17fd0fa44ff3c60f0a31eb916e90e5fef47a0a82ab0e298",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057524.json",
      "json_path": [
