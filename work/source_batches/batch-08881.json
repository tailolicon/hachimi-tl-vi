    {
      "uid": "zhcn:f618679163dd6c36dc280d80",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明的母亲",
      "source_fingerprint": "c07318aa1df5cec017881067d3ae5faebbf4cb2be2a2ff3c03b7296588551b97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
