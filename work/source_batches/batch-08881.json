    },
    {
      "uid": "zhcn:7df649ce6201a5e45505d3ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“他的签约赛马娘仿佛是在天上飞翔一样”\n──甚至还流传着这样的逸闻。",
      "source_fingerprint": "5cc145cf7d0ff854ad97a25aca5558f6678ee8e43e90ef6ff98a386c3bb62f34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057524.json",
      "json_path": [
