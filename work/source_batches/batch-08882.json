      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:a892eb3fe9cf8e78acd3b101",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在她的父母准备晚餐的期间，\n她邀我一起出门散步。\n而我也在想是不是该留下来帮忙准备。",
      "source_fingerprint": "9e82ef7a4edc864e7cf03becd006ddfbad677ef88b9dbe2454defe0bc5183e20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1057/storytimeline_501057524.json",
      "json_path": [
