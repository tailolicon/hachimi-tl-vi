    {
      "uid": "zhcn:9f04d33cb9196d71b1f16e8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不辜负她父母的期待，\n我在心里发誓要全力支持她。",
      "source_fingerprint": "b4dee166492cfc643f2643c92da97fe03e5f585321f1bfbfd36bc79ff58facba",
