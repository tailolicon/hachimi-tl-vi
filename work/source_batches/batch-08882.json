      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:05d0a220a75b8c847101f0f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让她的父母放心，\n我要证明自己有资格当她的训练员……！",
      "source_fingerprint": "ebf61b53db2d9e5887993f123cb2f19a00b7a2c7ee655ea3c1cd33dcdaf7cdbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
