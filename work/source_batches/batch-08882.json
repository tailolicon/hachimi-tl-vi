      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，\n我临时被千明代表和她的父母邀请一起用餐。",
      "source_fingerprint": "753ea0ea8cdfca183c1c1a47a1e814720cff2f13bcf8d69b056030dd6f4dd4fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
