    },
    {
      "uid": "zhcn:dbca1b0390c5f33ee945a22d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成长也是需要营养的。她今天哭了很久，\n为此让她能轻松自在地休息会比较好。",
      "source_fingerprint": "9dbc3c0d498b9f7849fa41c8d6a53b7b58a881167a7ea50877acb668d1a32c9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
