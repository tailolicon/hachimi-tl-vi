      "json_path": [
        "text_block_list",
        66,
        "name"
      ],
      "json_pointer": "/text_block_list/66/name"
    },
    {
      "uid": "zhcn:96cdd4eca82b7cb2453f46c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔喔喔，不错耶。逛百货公司地下美食街！\n期待你们带福袋回来当伴手礼喔！",
      "source_fingerprint": "effb38c35a69e9e6e220ce37264e58cacb9bbbd4971403d2312da387af1bff54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1058/storytimeline_501058101.json",
      "json_path": [
        "text_block_list",
        66,
        "text"
      ],
      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:8a229ee93837522269e9a3ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "买回去训练员室吃吧",
