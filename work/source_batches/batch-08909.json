    },
    {
      "uid": "zhcn:d101d31a93b06e62c57f9ecd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我给了一个不置可否的回应，\n同时看向怒涛最近的训练报告。",
      "source_fingerprint": "b7fe00b12b4ab0da4787175dcab47c306e037ebc04e39f01789a82f3d48fa236",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
