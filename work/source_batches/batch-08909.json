    {
      "uid": "zhcn:e731e4a4450cd42775bdeb47",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训～夏季集训～♪\n只差一步，我就能变得像\n好歌剧那样耀眼了。",
      "source_fingerprint": "954d67890aeabe8ac34970d975bebf1f5f6143e5b710b2ae9e0d28cdce5a334a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
