    {
      "uid": "zhcn:2961160e2d90e1e9a6f849fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是、是啊……",
      "source_fingerprint": "e38377abb64697d76b57e005b1cbe511117ce2e3beaa23b16612497c10420a01",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
