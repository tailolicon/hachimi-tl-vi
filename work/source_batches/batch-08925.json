      "source_language": "zh-CN",
      "source_text": "在宝冢纪念的时候，我终于第一个\n被好歌剧点名了。所以……",
      "source_fingerprint": "ecb07472a883d1d0e0af59b012b59d6b593d39fb18b468d3babc0cdf5855de91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1058/storytimeline_501058207.json",
