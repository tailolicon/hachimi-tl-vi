      "uid": "zhcn:b5ca1886900f9863a279d06b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你的意思是？",
      "source_fingerprint": "0521fe58148a447f3b4a6f6c10e79d0bc2715f5e06a4e068b893eebf3d32ea3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1058/storytimeline_501058316.json",
