    {
      "uid": "zhcn:d78e1546b9921a93f145649d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这点对赛马娘而言也一样。\n就在今年，有许多赛马娘必须要\n挑战自己的能力上限才行。",
      "source_fingerprint": "939f13da220c4d5bff14a4aac3c2116a49fa7c6efd66a7271614f47e43a43e5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
