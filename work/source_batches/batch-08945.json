    },
    {
      "uid": "zhcn:1332ad5178fb5c7e794adaaf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊！随时被粉丝投以\n“如果没有怒涛在就好了”的怜悯眼神，\n悲剧的女主角霸王就是我！",
      "source_fingerprint": "a6e1ff823aa164ba2395085de2dbef15cc131fd14ab6de6b7d64d28b3d7c8dd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1058/storytimeline_501058321.json",
      "json_path": [
