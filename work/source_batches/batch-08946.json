    },
    {
      "uid": "zhcn:44c92f433ad64593eddeb549",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・滋生嫩芽",
      "source_fingerprint": "69384a0653d765d0d6d31b4c83aedf620cab519bb3612fb306df74c5a6679a58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
