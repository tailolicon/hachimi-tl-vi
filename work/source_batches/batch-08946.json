      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:dbf62aee169e6f6afed16028",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，爱慕织姬隐约察觉到\n阻碍名将怒涛成长的天花板究竟为何了。\n也许事情在比赛后就会水落石出。",
      "source_fingerprint": "9447bde729113300774578bebffdc2f371848676f1dd387fd341e946d78b6dcc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
