      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b852dd7e85de1898037af33a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・忠狗大狂奔！",
      "source_fingerprint": "8934e964ff970a20b26821b190bca8fb85a678c5f53a500a004b4fe2c7599f69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1058/storytimeline_501058419.json",
