      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:752f48e7fad109c5b1e2357c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・头晕眼花昏倒在地",
      "source_fingerprint": "c4323f035f10a1781327224907c17274e16164475abfb0edd3a0db7cb4d1195c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
