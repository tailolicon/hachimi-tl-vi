      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:85fad275ffdbf1a2c5faa32f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这场竞赛是所谓3200米的长距离游行。\n名将怒涛立誓要做好带领好歌剧的任务。",
      "source_fingerprint": "236d2cd4ade3adcc9d6510d06883ac976c893ce8da4f2be72e232390c0631bc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
