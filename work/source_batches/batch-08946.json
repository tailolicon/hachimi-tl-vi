    },
    {
      "uid": "zhcn:c8413230b88794e6e1977c44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向宝冢纪念",
      "source_fingerprint": "4743315d92bef0a1d3815aad5f8b1374f193f12e0416639bccc69a7a0dc88f06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
