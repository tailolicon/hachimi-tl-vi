    {
      "uid": "zhcn:ab54a32098aa0750bf7e2f15",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・即使输了也很温暖",
      "source_fingerprint": "58b9ae221a0f75735ec312738de2be706d8070f97e891b4b4eee37049a3be748",
