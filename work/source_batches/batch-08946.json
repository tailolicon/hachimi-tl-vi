      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日经新春杯结束后・突袭！新的劲敌",
      "source_fingerprint": "b9fbae66f49dd9f50f081101f766ce9f9990ea447a84263de7fee5e7305935e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
