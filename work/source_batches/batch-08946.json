    },
    {
      "uid": "zhcn:c2e3868b060b5660b06e2fb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想不到名将怒涛会从好歌剧手中\n拿下皋月赏的胜利──",
      "source_fingerprint": "0d3fcb2784d9e27eda1f9460174a377c19dda1fcb80b582348e31fcc341d100b",
