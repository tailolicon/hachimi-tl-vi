      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "名将怒涛要和特别周、草上飞以及好歌剧\n进行决战。因为对手净是强敌，\n而使她丧失了信心。",
      "source_fingerprint": "990acc2d01a270f314f877d2c252db5c2891e4d919b80edc82b6056a305cd84a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
