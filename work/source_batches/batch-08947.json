      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:939e6127317d9e21258f9281",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金鯱赏结束后・继承而来的光芒",
      "source_fingerprint": "383d77144ff901e500d016897423d29cdc56caded72adcd610e44b36b1957786",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
