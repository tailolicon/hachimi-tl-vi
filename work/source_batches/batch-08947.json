      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（春）结束后・率领游行",
      "source_fingerprint": "4197a4254716ff9e1fdca6a1d6c665d00f59486802d991cbcf23c11a2b48ce46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
