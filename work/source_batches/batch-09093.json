      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在优秀素质的催促之下，\n我写下的愿望是……",
      "source_fingerprint": "6cfe4f5d5086532850367ec109159543f020bd3d98957aeb42a34eab6fe0d4c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
