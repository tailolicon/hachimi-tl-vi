      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为那两人提到的“确实的事物”，\n说不定是变强的重要提示。",
      "source_fingerprint": "bc986ed489a67f5ed20e1f0636bc04079d52386ee1f35ef79992383bfa490c84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
