    {
      "uid": "zhcn:ffa9fdf827798e136631f5bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她舍弃软弱的自己，\n增强了“想要获胜”的信念。",
      "source_fingerprint": "148abce888f0a4ee2dc8cc7c19db2ae3faf3cf6303c6ecd3a16417373fd5f909",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
