    },
    {
      "uid": "zhcn:b2ec929f098496bad5b5f6e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・胜利，然而",
      "source_fingerprint": "c73d3985726f095238b1d409550e519dbc7b1f683af1cdbb1bc37c428b866c57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
