        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:d1db9920466d84674c8f88d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・掠过的指尖",
      "source_fingerprint": "19245c242ca292f3dc209be6cfe191d68460659a02930b262788d6e48b49b4d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060429.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:90f276065dcee51a54ab922c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在“天皇赏（秋）”留下成果后，\n优秀素质又增加了一些自信。\n她希望下次能挑战“有马纪念”。",
      "source_fingerprint": "1240fc94eec822229925b8474453de0d60bc84ca5979ec17453ddd1e70f611fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060430.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e3b2e77d566e3a2526238ceb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“天皇赏（秋）”结束后，\n优秀素质来到商店街，\n与东海帝王不期而遇。",
      "source_fingerprint": "4271ca4c1b57ce78c8660bead06cdbc705f28afc88c676035f41f3c032a682df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060430.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8eb1b00a1b06a7ffc9eff6aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她认同优秀素质是自己的强敌，\n并挑衅优秀素质，告诉她若不赌上一切\n是无法赢过自己的。",
      "source_fingerprint": "d0526bd643cdd26ca614cafbfb0d67500b07d28f3a4e6e0118a98e871fb78b61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060430.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:30bb66be81bfe7af440204fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时优秀素质受到商店街众人的煽动，\n就这样接下挑衅，顺势发出宣言，\n将在“中日报杯”上“赢得胜利”。",
      "source_fingerprint": "6c108f5dd73e1896118b1d5b88b40e141a2ae0f858a66b39e9bf1aa41e46ffa5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060430.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:b4e0c956d44ec576907a54c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・响彻黄昏天空",
      "source_fingerprint": "e6114b747428b11e042ea596fb7a8d84cf23ab4f9b3143149de73bb8c0b3e51e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060430.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:0f4f946eff1729ef32179522",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "优秀素质拿出真本事\n挑战“中日报杯”，\n并确实地将胜利拿到手。",
      "source_fingerprint": "28a7561bcb8e6ca4e225b1213eafc38ba3b2ec14fb6848cf7a5ef860ec1407d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060431.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0a006936abb9e28b53f63dea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "花了好长一段时间成长至今的她，\n为了成为“闪闪发光的主角”──",
      "source_fingerprint": "04048f1f0886c678f1195604ffd92aa2a8fadce594ec876c4a8904b14e102336",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060431.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:da573f59c7e16ddc8f6a2036",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "坚定了意志，\n准备挑战大舞台“有马纪念”。",
      "source_fingerprint": "8fbeb68ab0344aff2bda68ef7146b678db49bfa80fc8cedb504bb5fd387c62f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060431.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:746d85f2efd609684a9d5a17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中日报杯结束后・迈向最后的大舞台",
      "source_fingerprint": "76f663ef3fa7da121b9b2d8cbdeb329a3fae37c504b6827439419dbfc3fd246b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060431.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:95115cc9b3e94f58e5a2205c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超越东海帝王，\n称霸作为目标的“有马纪念”后，\n优秀素质流下喜悦的泪水。",
      "source_fingerprint": "82238208e7e82f5e7691cc32dcd75b8fbb5a40644900534808f1b392abecbe04",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060432.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:268ae7174fa6056dc58f1033",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在赛后的访谈上，\n优秀素质被记者问到获胜的原因，\n她回答这是自己发挥出所有实力得到的成果。",
