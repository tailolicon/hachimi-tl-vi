      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・远望",
      "source_fingerprint": "9245707cfabe2cc81eddcc01ab5ed91f8586f5b06812a42cc060c67285e93916",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
