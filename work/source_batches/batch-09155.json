    },
    {
      "uid": "zhcn:dd4bb78ddffff2ae9470629f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我接着告诉她，既然机会难得，\n干脆让她妈妈看看她在比赛中奔跑的样子。\n以现在的状况，应该能挑战优胜。",
      "source_fingerprint": "68d214d657acd56b471f0ae3ffe84761cb39e3790de81d2b61ca121c9b69540c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060704.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:98ad709f1d52726da7804e4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我先请她母亲在食堂等候……",
      "source_fingerprint": "c212df2deab39e407b8ca403ea999bff13d5fed6bd651d09b9b152fc64363b51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060704.json",
      "json_path": [
