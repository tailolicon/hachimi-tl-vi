    },
    {
      "uid": "zhcn:a36e1b123ff13760f9b1e990",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使如此，优秀素质的母亲\n看起来仍然很开心，\n她似乎感受到女儿的成长了。",
      "source_fingerprint": "230e4bf4dd5ef6707dd999059c93c69d57e1df0c4c1cfdd94edd28407e091bd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060704.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:b2f843f3f500b910d58922b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过──",
      "source_fingerprint": "9756a221c17cee11c9595bdd469e65efc25d466bedae6e8425aa7e191866afbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
