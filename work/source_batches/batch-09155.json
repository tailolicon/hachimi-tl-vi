      ],
      "json_pointer": "/text_block_list/20/choice_data_list/0"
    },
    {
      "uid": "zhcn:5ce1ab39e3b79e4e2fdeba20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "模拟赛结束后都过一阵子了，\n但到处都找不到\n优秀素质的身影。",
      "source_fingerprint": "3499227b37393e3a4e48fe9386757a6f682ad7e0f9078155e17c25e9fb1b4778",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060704.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:e70b05931188b162bf616fb8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "校内全都找过了，是否该去外面找找呢？\n听优秀素质的母亲说，她从以前开始，\n消沉时就会一个人跑到河岸垂头丧气。",
      "source_fingerprint": "d8196d4638e9079d95f0e83f006068b46dc8afaa8d73ba38b5996b99baa16ea5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
