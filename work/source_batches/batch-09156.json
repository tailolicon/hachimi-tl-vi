        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:13caa03061390537a884b888",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我带着困惑的优秀素质\n前往已经彻底混熟的商店街。",
      "source_fingerprint": "2d490d3d8a6fb86488933f26115967f905e3303f59646c7b392b90d09ff176f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060704.json",
      "json_path": [
