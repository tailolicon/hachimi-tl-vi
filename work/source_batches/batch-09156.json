      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……噗！\n啊哈哈，你在说什么啦！",
      "source_fingerprint": "15a68ea63cb2dcdc48edaabb1c81a308baa3cef155f94ccd15a25afb011e535e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
