      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:2caf1253ec89649823cb03c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "难道你不喜欢鲷鱼烧？",
