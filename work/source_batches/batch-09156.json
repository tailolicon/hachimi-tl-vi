    {
      "uid": "zhcn:1bc35e451c0ab52d435a844c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "讨厌自己心胸狭窄，懂的太少，\n只是个无可救药的凡人……",
      "source_fingerprint": "4a67e1f90d35ba8ded8a55fe29bd56481e2cfc09a6ddcd1b849ff6f0d4654382",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
