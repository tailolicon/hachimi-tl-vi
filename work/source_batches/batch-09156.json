    {
      "uid": "zhcn:77305d7d1b47d30e82272fdd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "后来过了一阵子──我跟重新打起精神的\n优秀素质一起回去与她母亲会合。",
      "source_fingerprint": "82fd7a1ad8d060fc212ba9c7e002f26aff7b2f09c786b55b948acd5ed8f29e08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1060/storytimeline_501060704.json",
      "json_path": [
