      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，你带素质小姐来这里\n打算做什么？",
      "source_fingerprint": "7bd22a121a74c2c5eec2a1d034c2bcbcfd544eac1e0252fed8ff51cb90151f36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
