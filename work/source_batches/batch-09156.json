    },
    {
      "uid": "zhcn:51e4f2de0abdf4e8358c2169",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "优秀素质跟母亲说话时，\n露出了虽然害羞但似乎很开心的笑容。",
      "source_fingerprint": "b985f629123f81ebe4365c7faac760426b437568c0d80e3425217de6c4124c16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
