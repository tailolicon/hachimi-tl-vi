      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:fe8d2bbc1ec57d685446dfc7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "消沉的时候就是要大吃！",
      "source_fingerprint": "b150ed09265692e144803c818c49b575ef97b2e3d49f7587359fbbf4f2efb13b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
