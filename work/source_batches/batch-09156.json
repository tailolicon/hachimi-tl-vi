    },
    {
      "uid": "zhcn:84fe6d8c0926d8ca44080811",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我告诉她，要是有不懂的事，\n我想陪她一起思考。",
      "source_fingerprint": "31c6af612228753cc37dcecc47f10b1c1be02cb325fd9e40de067399b7492c46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
