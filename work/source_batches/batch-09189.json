      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……当训练终于开始时，\n我已经身心俱疲了。",
      "source_fingerprint": "440b34e9185f9e8e607f6dafce6def75d52831a30b1e8840ac7ffb41d59a6075",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
