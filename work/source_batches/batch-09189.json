    },
    {
      "uid": "zhcn:3272bda0055f1a9560910514",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然她就像这样，\n老是把训练员耍得团团转──",
      "source_fingerprint": "83d87df92af1e688e436eff9346f51b5005f5f6f8bcca449d223ef3df9927f98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1061/storytimeline_501061113.json",
      "json_path": [
