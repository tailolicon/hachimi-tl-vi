    {
      "uid": "zhcn:7b4167696f193916437138e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，那就照练习的来吧！\n我的名字是──！？",
      "source_fingerprint": "2c65a749213a1a2d3641cd698836b361dfb33c89ef61ad413fe8b6a192e12fa3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1061/storytimeline_501061113.json",
      "json_path": [
        "text_block_list",
