        "text"
      ],
      "json_pointer": "/text_block_list/72/text"
    },
    {
      "uid": "zhcn:330f1b9ee97ac81645461cd5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跟班们",
      "source_fingerprint": "623addb293552894b8da791ac2391e517e0c478283b569a3914dc4ec4a359e1e",
