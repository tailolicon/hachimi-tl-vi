    },
    {
      "uid": "zhcn:7e1162c6a26254e47b77d776",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个人是……",
      "source_fingerprint": "7cb7a6c5c2bcc0aafae0edc3615e8902059d7c9f2b6632dd7a45159ffd19038a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
