    },
    {
      "uid": "zhcn:4194e448ce6a96d982eab729",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从这眼神中可以感觉到，她们之间有着\n藏也藏不住的深刻鸿沟。但是──",
      "source_fingerprint": "7b0256096264f158cc8d9bd53f65bfea2a5ab48bfa646b12f07d2e32504909d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1061/storytimeline_501061113.json",
      "json_path": [
