        "name"
      ],
      "json_pointer": "/text_block_list/71/name"
    },
    {
      "uid": "zhcn:dff1082f9e50d99e79259c23",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且你的目标，\n难道“就只是为了受到认可”而跑吗？",
      "source_fingerprint": "5e47660bb2b54f2714fdf7a4ae4538c7fc20eae19e6f253eb707771a989f55f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1061/storytimeline_501061113.json",
      "json_path": [
        "text_block_list",
        71,
        "text"
      ],
      "json_pointer": "/text_block_list/71/text"
    },
