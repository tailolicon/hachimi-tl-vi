    {
      "uid": "zhcn:bcf4881034bf63e8615dd442",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟你有将本圣王光环的才能，\n展现在世人面前的义务。",
      "source_fingerprint": "3d309f11ecf4d83b505c04e9e742b003fe595ba3e9d0509b0d3a2bb096690bcf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
