      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──我们就这样走上三冠路线吧。",
      "source_fingerprint": "94869f69e7e713cf881169ebf44e54aa38acfc8ad798bebb21c763b5c7def4f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
