    {
      "uid": "zhcn:33dd45f021122487cde591f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "圣王光环",
      "source_fingerprint": "ae4906d6dcdeefba22045311d828cb642edc30b721f0d70bdfe2ab3207e98c48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1061/storytimeline_501061316.json",
      "json_path": [
        "text_block_list",
        7,
        "name"
      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:aea2a79c32447a4cff576649",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……哼。\n那你从一开始就别说不就好了？",
      "source_fingerprint": "1bef0254f82d3d87fee53e7aaea5e602c458ca81ae7c916062afb977ab63ff0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
