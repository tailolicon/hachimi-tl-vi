    },
    {
      "uid": "zhcn:df4fcabc92ca275853785c27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──圣王光环起得很早。",
      "source_fingerprint": "b86c7e9bce819b08b15c744731e2b16655ddee924f42a44cd72b8408611ad3ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
