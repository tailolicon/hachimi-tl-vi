    },
    {
      "uid": "zhcn:dcb37526a66b57f336102713",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青云天空",
      "source_fingerprint": "ded35a7f69bae7ffc26786ffbea2aa51ca63558d569a98da0b4725e8da7c5f8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1061/storytimeline_501061500.json",
