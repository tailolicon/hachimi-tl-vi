    },
    {
      "uid": "zhcn:6da7e10d68b52820413ca5fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿～那真是聪明。\n说不定真的是个好主意。",
      "source_fingerprint": "960297283bb185a12958571a0e50e409032d30748e610c264b1b4ba44efaacfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
