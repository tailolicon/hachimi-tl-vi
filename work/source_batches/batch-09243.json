      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:72bbb481b5530c409156481b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就像她刚才说的，就连这次的受伤，\n她也一定能够跨越吧。",
      "source_fingerprint": "464c08991021fde9cdd4ea7bb62250db0befbdbb652bc25f7946ffe83e390479",
