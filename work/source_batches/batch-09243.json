    {
      "uid": "zhcn:55d6e4564d185370a8e4e7c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不论碰到多么痛苦的状况，\n圣王光环仍会不断地尝试站起来。",
      "source_fingerprint": "ebce7bbe504f23c60be22a06de76b4e5443a5558354b52632787224bc01cd5b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
