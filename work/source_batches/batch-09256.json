      "json_pointer": "/text_block_list/80/text"
    },
    {
      "uid": "zhcn:9e6cf32ef3bb2adedc14a5e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我猜不透她的意图，\n但是她确实特别注意待兼诗歌剧。",
      "source_fingerprint": "b092cfb19a900cc69a62832afc4309da7a4ca66d43f5ffbcda27f92f1ed7e16b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
