    },
    {
      "uid": "zhcn:4a34edf10fdaf02782de6181",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长不是第一次向待兼诗歌剧\n表达对她的期望。",
      "source_fingerprint": "0ff4ef9cc0b7107e3327edd42956b1b271d0f7271006a7ec8451c1845dbcac45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
