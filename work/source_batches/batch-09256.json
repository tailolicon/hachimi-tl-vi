      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以！我们就一起多努力一点吧，训练员！",
      "source_fingerprint": "bb30dcbc435dd10d05e5049a13b3657e325b63c69afe62888dcc069df353dc26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
