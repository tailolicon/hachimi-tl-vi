      "source_language": "zh-CN",
      "source_text": "也就是特雷森学园！\n可喜可贺，可喜可贺！",
      "source_fingerprint": "c9ec85f8ff359700322a54b4f9ab3ca21eb5322583122b5d0947fd3cc6c81b2a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
