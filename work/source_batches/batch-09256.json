      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老实说，我不知道理事长为什么\n会期待平凡的我有好表现──",
      "source_fingerprint": "8136b8e886bcbbda8bf8307e7163477636d79a549c11c2dd786460f18c375dea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
