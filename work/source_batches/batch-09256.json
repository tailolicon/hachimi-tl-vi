    {
      "uid": "zhcn:737438e7252c56824ac686bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "理事长对我说了这些话呢！\n嘿嘿嘿。",
      "source_fingerprint": "30ec3344a110912d58b713aadfe239df34bb0e05bd8a4175e7f5d6bfdbb0dbd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
