      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "地下道是赛马娘在参赛前\n用来提高自身干劲的路！",
      "source_fingerprint": "04b7ed2d4071620afa618b9c12a70912a1649cef0f9f701d53d4412abde35fd8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
