      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……却没看到人。",
      "source_fingerprint": "356d0c7abcaa8a0482c896609506b9e6ba896fb5560f5ee51e6b11b1d273c2e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
