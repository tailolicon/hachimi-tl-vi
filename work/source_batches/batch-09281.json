      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我猜一定会是美浦波旁拿下第一名吧！\n我今天就是来帮她加油的。",
      "source_fingerprint": "d2337b18f14db502cc0b81ed0bcfa751e6269a1144735fe184cdaed99f790d35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062201.json",
