      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "待兼诗歌剧所指的方向──\n站着美浦波旁。",
      "source_fingerprint": "7493ca017d1004d73776647376ee8625d0d7f7379ec4892d23564eba99142f03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
