    {
      "uid": "zhcn:f2fd92534380246c9bdd4b57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………",
      "source_fingerprint": "b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
