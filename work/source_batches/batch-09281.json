    },
    {
      "uid": "zhcn:5e699040ae5638982857e721",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇怪！？",
      "source_fingerprint": "6a2a7d6cf50969d553a37f0fd7dc9183454b18bc8931722b7333ef435557ce93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
