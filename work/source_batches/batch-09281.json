      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以！为了先拿下一次胜利，\n我会拼上我跟训练员的全力的！",
      "source_fingerprint": "361aa8507a9d964af613c963a77967feda1b620eda9ca9c19f0dfd349ae9206a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
