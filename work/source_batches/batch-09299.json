    },
    {
      "uid": "zhcn:2f9dc4eab7c4df8929defc05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽管她应该跟以往一样没有想那么多，\n但她提出的意见却非常有建设性。",
      "source_fingerprint": "a04b25885d11b75bcade72bd87539a37e07316f445a650da25ef07f56e57569a",
