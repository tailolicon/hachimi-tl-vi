        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:0a8c4387f3adb709cb89c01c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以及社会上对此事的感想，\n才会无法专心训练。\n“换作是诗歌剧会怎么想？”",
      "source_fingerprint": "c1bd47584ed9a1b5b2334bd9df3b18a457a31d91548e32d3177b4caee2e6946d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
