      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "米浴决定在美浦波旁复出之前变得更强，\n便重新展开训练，\n不断进步──",
      "source_fingerprint": "4cdeb8be861844c8c85d58124e3cbebf1bb9da7877978d383ca9f7d13052d8fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
