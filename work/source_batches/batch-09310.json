      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:816b4080199ec7166f6dea9e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的这席话隐约散发出她的坚定决心……\n那似乎让正在烦恼的圆框眼镜记者深受感动。",
      "source_fingerprint": "ec1f3167b5d3af7f280a6d21e3f72c9c2070c4361776c21e862b2dd6bc9fac0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062402.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:f9fa1bfbcf04ad2412f9b811",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "依然、梦想、第一名！",
      "source_fingerprint": "ef9dcd1e47303a31ec492c0e00ab218ef82010c109c0363e8e2d72cdcd04054b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062402.json",
      "json_path": [
