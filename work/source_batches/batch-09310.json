    },
    {
      "uid": "zhcn:c5b7dde9914dbd385776a166",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这时，担心两人的待兼诗歌剧\n接到了来自优秀素质的电话。",
      "source_fingerprint": "ae245dd77b8b1dfd3cbc0f2daa6006fd9d73f07a9a2c05f9d8f5ee4119e9d650",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062403.json",
