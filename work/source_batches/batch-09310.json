      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她这番话让优秀素质\n得到积极面对比赛的勇气。\n表情也重新开朗了起来。",
      "source_fingerprint": "196654fff679fd3dbdcfd8bf48b1eb72eea1b7d166772a377d8a98df2319806a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062401.json",
      "json_path": [
