    },
    {
      "uid": "zhcn:1b31fbbfcae65322082e127b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她，跟她，以及旁边的她",
      "source_fingerprint": "f10bbfdf098a4ccbbb2e0ca5ff7a32d03087a550b2859e9eeaf3b63df323f639",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
