    {
      "uid": "zhcn:043078be74a4e27fb455ebbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "待兼诗歌剧语带感慨地不断说着\n“主角”这个词……让我印象非常深刻。",
      "source_fingerprint": "2d1d67e49a55d1165e802e1460776044196913ce2e7187de7da9380be737fc1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062404.json",
      "json_path": [
