      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:cc7c1ce679c022a3ad2bfadc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062402.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:6ab448bb28c80cd20b0cecf2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "记者们不认为美浦波旁以外的赛马娘会赢，\n更表示“没有读者要看波旁以外的报导。”\n听完这番言论，待兼诗歌剧对她们说──",
      "source_fingerprint": "1b3968c7c4bfd2a3a0c2bf4e84201f4d3c9ff8747f65a1ca3b6371d5317e92a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:eadc2de7c1b12e296c92893f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062402.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:b378f1a3acba471f4cfee06c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“我的确一点都不特别──\n不过，我也一样\n不需要第一名以外的名次！”",
      "source_fingerprint": "fd021b2163fc7d5569768ca9997655ec9fe41eae0d53683c56d01fa30bede8e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:50225422030e1cd50c7afb69",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
