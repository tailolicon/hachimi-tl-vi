      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:952f3a9273dc0a85b7ddf918",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但待兼诗歌剧\n依然一如既往地开朗与悠哉。",
      "source_fingerprint": "a5875b254ee8bc8e5dcc1dbdcf886805163b1767ece3c6a917fb85e35e045eeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062407.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:105365d5ddf32125982e279f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062407.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:4bd5e77cfea642dcd8207750",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无时无刻都能保持平常心的她，\n就这么搭着巴士\n缓缓前往集训宿舍。",
      "source_fingerprint": "358569133b8483bdb02128c016311eb925387e92ad7471e73d6b4e71d292b31d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1062/storytimeline_501062407.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6f526475671ba1f52157fa44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第二年）开始！",
      "source_fingerprint": "2e193ad94ba56712a8e92ed87a15587d1a6af48670f61e354efcb818a0837f0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
