    },
    {
      "uid": "zhcn:a20152fce427142b500553bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "待兼诗歌剧就这么一边跟朋友开开心心地\n玩起猜谜，一边前往集训宿舍。",
      "source_fingerprint": "287881d7930702fc964a8cf7907759f5d83a67d2eafe69668f2de501f6b207a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
