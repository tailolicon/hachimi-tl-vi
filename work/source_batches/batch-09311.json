      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于到了出道战当天！",
      "source_fingerprint": "4e2a387443df1e9ad9211960e2b496654fc7603930350648fc57645cb9106b5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
