    },
    {
      "uid": "zhcn:570b5ee583675ec38c095ed2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这份誓言，永不改变――",
      "source_fingerprint": "b5bd2c1f5a66c2664d499136c63e0b0dc6a3dbe7e70e2cebb5d977dd503fb671",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
