    {
      "uid": "zhcn:3c13033dc983b6a2e0d099e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今后，\n也请多多指教了。训练员。",
      "source_fingerprint": "68691dc4121a7bcf0232ca86e0c56f6b1fe7723ad7b27b8ebfc4aa69f75f85f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
