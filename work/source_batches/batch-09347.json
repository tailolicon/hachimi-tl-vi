    {
      "uid": "zhcn:8c89a8c6e3905a8a7de43997",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以制定了这个讲习会计划吗。\n我明白了……",
      "source_fingerprint": "611fd534f77b54da5c4d76b4d29cbfeffb3bfe38ad53f1dfd58516eeaae63427",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
