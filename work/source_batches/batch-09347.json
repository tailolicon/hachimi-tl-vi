    {
      "uid": "zhcn:52ac8eb7fe1b770075ebdb74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "佐岳五月",
      "source_fingerprint": "f0f020f41e886b639f865972238103e4ca9efef1b7a7723deac76c455585c28d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063110.json",
      "json_path": [
        "text_block_list",
