    },
    {
      "uid": "zhcn:6d69351dc71eb83cb084a3fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后人们会被她的奔跑所吸引。\n她内心的祈愿，她梦想的世界……",
      "source_fingerprint": "6fa1a9770c6670c1010cfbf10f34ebfe9ab8f6080f24f556a655c2627879820a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
