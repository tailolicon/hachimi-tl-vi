      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:fcf57f4c4cb0c6e420a0cbaa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――『IRON WILL』的共享，\n似乎正一点点稳步地，为人们的\n内心带来深远的影响。",
      "source_fingerprint": "3bf70f8eb3c8698794f46728a85b20f6810801d4354bdefabfebbc86990e8392",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:84dee90b04fc372cd59e3560",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而关于贡献者\n我与生野狄杜斯――",
      "source_fingerprint": "8cafc4d3f522881641c28a5b2e66a9b8827c60dc109eb62f170f1354909b36c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
