    },
    {
      "uid": "zhcn:afa7a5956342431599a9f346",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，『IRON WILL』。这个可厉害了。\n比赛前做了什么训练，\n全都详细记录在上面――",
      "source_fingerprint": "1748329015bbcbe2d5ca65ca9bacc0037a1bf3ba37845f3a60254bb99c0c7295",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
