      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:8268c6f36292fe5bdc34a5ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要生野狄杜斯还渴望奔跑，\n我就会一直作为她的训练员陪伴她。",
      "source_fingerprint": "6403b0f888943d1b0bd908c9e8a20834b4d0dac7ab62bf5c51a69a9170b38edf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
