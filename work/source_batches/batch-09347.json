    {
      "uid": "zhcn:a74d70387f1521028781c8c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为我的训练员。",
      "source_fingerprint": "267b5c669bbf8cf95480e897c0aefee7e3e00e532b6efecc09595edafbc57f51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
