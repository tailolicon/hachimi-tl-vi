    {
      "uid": "zhcn:c386708191c6c3a1c49152a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你和生野狄杜斯的愿望，\n也是我们梦寐以求的理想！",
      "source_fingerprint": "6114444dd31d33e1dd87bfcbd465d358dc18a9b46cae58c83df6901b56a0a32b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
