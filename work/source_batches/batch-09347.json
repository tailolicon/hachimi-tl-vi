    {
      "uid": "zhcn:7abf36b763e8ab997b8de490",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "生野狄杜斯",
      "source_fingerprint": "73591e968e6e55add318c6642876a233b71c9133534f118cf16308ba9278213c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
