    },
    {
      "uid": "zhcn:21bcbe2cc6a40e0d5113acff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛粉丝B",
      "source_fingerprint": "e712057b4c6d914e7bfa3a8f64af009d20710f5834cd4d6ee4d3370f07067043",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
