      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦，那是……\n特雷森学园之前发布的东西？",
      "source_fingerprint": "75a563d33525d281b124848ca2c9237b96df8e497a1d9e719bd0eccdb64a23ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
