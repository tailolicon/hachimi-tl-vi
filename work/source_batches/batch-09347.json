      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:457ccc849f5e576975081021",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――好。终于要第一次挑战重赏了。\n今天开始就要调整训练量了。",
      "source_fingerprint": "fff3b892e779770fc1d9d11a5211f0fc3c59e4b293aa3c656cc2098afcc1406a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
