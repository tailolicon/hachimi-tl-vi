    },
    {
      "uid": "zhcn:599bf5250adaced382c9b1b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "学园的训练员",
      "source_fingerprint": "f6fc2e106638a0e84f2f70aa92658723d8e30d86a25a753f32da115803fb32e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
