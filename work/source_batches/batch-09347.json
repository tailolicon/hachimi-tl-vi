    },
    {
      "uid": "zhcn:ea73b78bd51389ee4d2f7f35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "佐岳五月",
      "source_fingerprint": "f0f020f41e886b639f865972238103e4ca9efef1b7a7723deac76c455585c28d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063110.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:fc2d8652776403640d25ab0f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确实不止是训练员和管理方，\n为选手增加统一的学习培训\n夯实基础也很重要啊――",
      "source_fingerprint": "e1bf09ae11c1ccd01ba96381731fd3970e65d89ce105e5cd88d66b179a328d26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063110.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:dc80a7af06b1bbb84e8f9449",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你",
      "source_fingerprint": "8aaa2ee628be08866bfa2f0d5ff39aaa391ae1e9d55e869a9a051ae9ffe041a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063110.json",
      "json_path": [
