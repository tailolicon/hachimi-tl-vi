    {
      "uid": "zhcn:c6ad9ec847e472ca0a5a4b78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我参考『IRON WILL』的数据\n制作了新的训练计划，\n首先确认一下这个吧。",
      "source_fingerprint": "dbdadbf08856e2ebaff83dc2bab0ae35c785ba583a48dc8aeb42feff83240397",
