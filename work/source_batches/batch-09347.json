      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "结局（普通）",
      "source_fingerprint": "6ceff4163d3b76f24b921c5a6b0b4fe5bc18980200c0b27e11f7c2f3e7a83b15",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
