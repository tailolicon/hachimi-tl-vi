    {
      "uid": "zhcn:58860f92c52a6ac6b50ed51f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "佐岳五月",
      "source_fingerprint": "f0f020f41e886b639f865972238103e4ca9efef1b7a7723deac76c455585c28d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
