    },
    {
      "uid": "zhcn:70362515084751da67ae04a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总觉得……参加比赛的赛马娘，\n每天都这么的努力……\n我好感动哦。就忍不住天天关注。",
      "source_fingerprint": "8faff6f166762c621ecd0d50de36d118bbba9b52f9a21ee57d41c3cd913bf0ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
