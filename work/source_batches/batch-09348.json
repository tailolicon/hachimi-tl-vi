    },
    {
      "uid": "zhcn:c9e81135fb932fea84d84701",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――你们公开的『IRON WILL』。\n我也见识过了。",
      "source_fingerprint": "d97d1e36fea3b177c74fb4ebceb995cd08388299a844a30d80f47afeffe1a133",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:11e414a6dbd517473905de0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "创造一个比赛谁也不会受伤的未来――",
      "source_fingerprint": "269eab75f95b08ea3fad5c5d1946a70f93d43e7c2d3f512dc7e02f9f00ae2066",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
