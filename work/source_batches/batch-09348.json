    {
      "uid": "zhcn:98186f5208e33aae10b17445",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那真是很优秀的应用啊。\n能感受到你们3年来不懈的努力，\n还有如名字一般的强大意志――",
      "source_fingerprint": "07723e971ab4b89b74fb11f237add192354aced445523b213f623c7269ebf75b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
