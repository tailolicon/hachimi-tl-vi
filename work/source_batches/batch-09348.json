    },
    {
      "uid": "zhcn:20ec23fa20e469829e9f5f36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "生野的恩师",
      "source_fingerprint": "a93b18abaa62ca31fc7b8ceb6721c2169432e46c72251b50a52b827487c05a1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
