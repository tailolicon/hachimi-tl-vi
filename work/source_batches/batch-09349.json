        61,
        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:ddc3eee414071802abc6dc86",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，只要她还渴望奔跑，\n我就会一直作为训练员陪在她身边。",
      "source_fingerprint": "deebfe0496df239cad106ef985919caa097af3ade660ec1cb26938978042a648",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
        62,
        "text"
      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:ca9c39b4f3159c547dfbe3eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也还想，让你继续奔跑下去啊",
      "source_fingerprint": "959e27b02754fded476a1160ec36e49d098f8b3ef52607adf414b082705a2ca0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
