    },
    {
      "uid": "zhcn:5cb00a5fbda512423e97fd17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "彼此交换新的誓言。",
      "source_fingerprint": "3e945586a72b2d0c6b7d67d3690d17b456a26e741c045e9fecde4170d01220fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
