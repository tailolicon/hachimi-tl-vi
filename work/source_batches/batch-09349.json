      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也还想，让你继续奔跑下去啊",
      "source_fingerprint": "959e27b02754fded476a1160ec36e49d098f8b3ef52607adf414b082705a2ca0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
