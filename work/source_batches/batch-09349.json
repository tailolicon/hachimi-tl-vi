    {
      "uid": "zhcn:e3f34aa01774609bb02c4b6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
