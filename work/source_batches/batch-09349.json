      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――刚刚进入特雷森学园的时候，\n我就对自己的训练员徽章发过誓。",
      "source_fingerprint": "e2624ee401f7375a77338a10c25fea013c93b25412cfd53c09c4f9e89eb79034",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
