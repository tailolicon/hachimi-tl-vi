        "text"
      ],
      "json_pointer": "/text_block_list/73/text"
    },
    {
      "uid": "zhcn:bea60275e99b858f6076db68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多如繁星的心愿。",
      "source_fingerprint": "b33509a7851c688018ec78350edebc0c9b8b3adc45260d7f111cf56f20beffbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
