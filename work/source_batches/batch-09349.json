    },
    {
      "uid": "zhcn:75598143b8af4aa4d970f022",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "各自向自己的道路进发。",
      "source_fingerprint": "f8d2ea95413debae5bf908d979ee8d5b5c52da9528e11096dcffd41edb4e6339",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
        72,
        "text"
      ],
      "json_pointer": "/text_block_list/72/text"
    },
    {
      "uid": "zhcn:848ecfa6553508ea0a5fd31f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "数不胜数的比赛。",
      "source_fingerprint": "5e086e068bde7d2758bce2d7060f53df8f68ec3f8a51202fe2efab992944ac84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
