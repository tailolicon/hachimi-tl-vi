      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无数的奇迹交织在一起，梦寐以求的。",
      "source_fingerprint": "6e6ff7e5e1ce9d3c2595949c73ba47f4973707dd0b9043a6dff9455cca847cc1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
