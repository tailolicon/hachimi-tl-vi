    {
      "uid": "zhcn:e39691f8ea9ce326ebddae6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一个誓言，也一直存在。",
      "source_fingerprint": "c8e2eab22c245a9dcf86d11002681024142cedd1d8a8f21f138231d55a6282f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
