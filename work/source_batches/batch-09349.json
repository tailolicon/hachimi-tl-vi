    },
    {
      "uid": "zhcn:811e4a300af014a59c35b000",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――随后时间流转。",
      "source_fingerprint": "160fbb8d87f5e22c6ce8176a3bdf08ffef201d97717cb6d1af306f38d7d0dfe4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
