      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要我们的山盟海誓还在，\n无论多少次我都会对你说。",
      "source_fingerprint": "5c6c5f73d497155a41678bfb8d14f764657273a66c765c87d04d1ed6298ee035",
