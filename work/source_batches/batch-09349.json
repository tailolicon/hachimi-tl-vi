      "json_pointer": "/text_block_list/65/text"
    },
    {
      "uid": "zhcn:35a240e1eb2139bfdc8784a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，让我一直做你的训练员吧",
