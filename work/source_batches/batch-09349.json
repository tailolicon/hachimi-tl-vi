    },
    {
      "uid": "zhcn:3c5849d5843d00b19ddc0e72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『只要赛马娘愿意，\n我会帮助她长久并健康地奔跑下去』。",
      "source_fingerprint": "d1aa94267f78bdf5dee56a2162889ecae2819fbff26e3b7d45bd98b2f1a797c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
