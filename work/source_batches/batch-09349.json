      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……而且。",
      "source_fingerprint": "8ecdebadbe681d527ff32753af75720c5b3cd1a5c7c9b7c9c54ee66b9f78fc3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
