    },
    {
      "uid": "zhcn:038724746afa70f00b3bcb55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――“未来”。",
      "source_fingerprint": "f05e1d8b600461bdfe7e02deccebfe4d7d9679be6f2cff47bc6bc7b185adb5a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1063/storytimeline_501063111.json",
      "json_path": [
        "text_block_list",
        76,
        "text"
      ],
      "json_pointer": "/text_block_list/76/text"
    },
    {
      "uid": "zhcn:c16d1c1befb73a8e51e1b4b3",
      "kind": "story",
