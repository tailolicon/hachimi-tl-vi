      "uid": "zhcn:b697dd5b8d715727a7d8417a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦，这情况是怎样？\n我只管照着做就好了吗？",
      "source_fingerprint": "bfb0388b69cec90a8b832bc2abf9b7fe8896c84c7f7e023ee044bfb7423845c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
