    {
      "uid": "zhcn:3f136e09ed214da47d22cafd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不喜欢那样。\n你也喜欢那种不断攻击，\n不让别人有机会打的策略吧？",
      "source_fingerprint": "ab75915120df9fe476bcc807efe296ef3f6ef0d9af3029e7724d993869446bc2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
