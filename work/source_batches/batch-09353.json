      "source_path": "assets/story/data/50/1064/storytimeline_501064102.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:dcf44de67b638a72dec31e10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "各种不同的经验化为她的实力，\n看来今年目白善信能随心所欲大展身手了。",
      "source_fingerprint": "ebbce4ed44bbbef14e7148a5e7b76067f420368ad58d53da9b5cef06657d1586",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
