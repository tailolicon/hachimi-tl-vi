      "source_language": "zh-CN",
      "source_text": "如果目白善信那时仍在当选手的话，\n到时候她一定已经下定决心了吧。",
      "source_fingerprint": "804766117656181b2350ecd6f5be2d1810d7cf960852bd6a64ad858fb2579eb2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
