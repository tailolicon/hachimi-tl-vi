    },
    {
      "uid": "zhcn:31bc3b68ed8a018a9747da6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不想被目白家的头衔束缚。\n因此想要多多展现自己。\n但是……",
      "source_fingerprint": "00d1762209cd18aab4388c1b5dd4d4faa777cd5aea4a880c41abadcafd7acfb4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1064/storytimeline_501064317.json",
      "json_path": [
        "text_block_list",
