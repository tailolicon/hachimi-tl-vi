      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:684a5323ae3206e2cc21e8e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她很沮丧。鼓励她最好的方法……\n就是祭典型竞赛了。\n既然如此──",
      "source_fingerprint": "72f5090dc548ce292f5e1fb41895cc7da5352db2482f5508620ed3c759771cef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
