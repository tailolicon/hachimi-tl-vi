    {
      "uid": "zhcn:7dc199997b2da668479ca717",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为这是“天皇赏（春）”吗……\n毕竟这是对目白家而言很特别的比赛。",
      "source_fingerprint": "23b79c0f8a43d57c17fbe55e8fa7ccb8764375b3b4c56de4dc0f16395edc51a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
