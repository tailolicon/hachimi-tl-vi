      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白善信抬头望向天花板后，\n轻叹了一口气──",
      "source_fingerprint": "1f21de405f61a056a84849f69ad36270d36fa3dadda01243055d91ba3e40650b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
