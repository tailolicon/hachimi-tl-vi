      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想找回自己，即使只有一点点也好……\n为了这个，我的下次比赛……",
      "source_fingerprint": "a1678a59cc8dc0db0e2cae7fdfe3a9d44f009b5d01790090db927f11656ec752",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1064/storytimeline_501064317.json",
