    },
    {
      "uid": "zhcn:1092391102a9ec935f220dba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白善信",
      "source_fingerprint": "292838dd30209de26be736979e1f3a3bc826881c9ce11ed7480a487776eff441",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1064/storytimeline_501064317.json",
      "json_path": [
        "text_block_list",
        27,
        "name"
      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:64aa8f7974cadd6495494385",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到麦昆那认真的表情，\n我开始想，如果不是为了目白家而跑，\n那我是为何而跑呢？",
      "source_fingerprint": "9e6c68fa048da03ae2b5b665f35b1b2e0feadfd2ba19a3f6b5208f0c94d50ac8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1064/storytimeline_501064317.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:f2b24cc0cdc9431f89dbad5c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白善信",
      "source_fingerprint": "292838dd30209de26be736979e1f3a3bc826881c9ce11ed7480a487776eff441",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1064/storytimeline_501064317.json",
      "json_path": [
        "text_block_list",
