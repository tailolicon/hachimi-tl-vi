        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:dc60a327a63b7e9d8ec4f933",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──双人爆速领头。互相鼓舞的同时往前冲，\n乱七八糟的全力奔驰。然后──",
      "source_fingerprint": "4da20de8c5cefb15219013d27eb46321236c4b4039cb8d68d1f0ade9daf7d2b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1064/storytimeline_501064320.json",
