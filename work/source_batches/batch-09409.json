      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ef763726b7665014dd7fa6f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从这个夏季开始，\n目白善信要以全新的自己重新开始。",
      "source_fingerprint": "2af296515b2bb04be4c89460f44b2269a1368363cca2aa7542f4c85db1790248",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
