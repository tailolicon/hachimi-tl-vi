    {
      "uid": "zhcn:b496ad2619850b61600ca1fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样就算向神明许愿，\n也一定没问题──",
      "source_fingerprint": "137c81530f80f20ab175b26d90a028fcf6b885463e09288b61cda82c43c7ba23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
