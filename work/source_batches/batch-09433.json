      "source_language": "zh-CN",
      "source_text": "好～！把这里扫得超干净，\n让神明吓一跳吧！",
      "source_fingerprint": "56b56276a61b8f87c3fa677fe9bacd1aa6475b544ab0c2ad42470f5275ce2cc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
