      "source_language": "zh-CN",
      "source_text": "我想，对人──\n以及赛马娘来说都是这样的。",
      "source_fingerprint": "db08a59abb81e5ab8bb9cc8090a5b39a41fb7b2fc486cadb06ae5f08c38a5085",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
