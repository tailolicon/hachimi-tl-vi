    },
    {
      "uid": "zhcn:51c532a1cf123c0d2b667502",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若能跑出最强的起跑冲刺，\n跑短距离会比较有利。\n虽然也能这样看，但是……",
      "source_fingerprint": "cbade09eae7553b7634db9222a5d67cf4e09a6c6a6f8c2e0055365473fd11f54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
