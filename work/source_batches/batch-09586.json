    {
      "uid": "zhcn:449775a0dfdb9360f909da49",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，身体的肌肉量恢复了不少呢！",
      "source_fingerprint": "d2b3a8be580897d84bb78fafca90629c9f9b9ee8042761484c80f06882bfffe1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
