      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好～涡轮出发啰！\n涡轮全开～！！",
      "source_fingerprint": "52172a10f7522c72def17ea06f4340d6b833b819db904c2f88f9ffde36396e35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
