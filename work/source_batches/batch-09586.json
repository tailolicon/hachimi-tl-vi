      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:9f7921274b955a5f8c83553e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──“圣烈特纪念（GⅡ）”\n是在中山赛场举办的竞赛，\n也是“菊花赏”的前哨战之一。",
      "source_fingerprint": "1049e0bd3402adf7014b33245bee98e392fd37451ff90284e222e6b9e5d6b934",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066204.json",
      "json_path": [
