      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，这里有名的超粗炒面很好吃喔！\n还有桃子也是！",
      "source_fingerprint": "22499da5d6a498b63745c8ed088afec2250e3bfbd836dd67b7d0d2c78d858fb4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
