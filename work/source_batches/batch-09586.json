    {
      "uid": "zhcn:97e9db7f8ee8ee3aaa36dedd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欸，训练员。\n今天的比赛，真有那么不容易吗？",
      "source_fingerprint": "ea3ecf0ebec4baebeec1d9b62b77a8088cd1fe8432f264dd8445af2a4c7034c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
