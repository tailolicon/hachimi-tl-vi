    },
    {
      "uid": "zhcn:8bef6bd2d545bde637e34a5c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向日经电台赏",
      "source_fingerprint": "c203585ef68c4aa6de21fb09a822f8fc2944f8a77f9f6f0811718e3973c3f914",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
