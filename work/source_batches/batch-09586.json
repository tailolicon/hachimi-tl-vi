        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:43ed7812ed0f336611fe42ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，身体的肌肉量恢复了不少呢！",
      "source_fingerprint": "d9262747a45926348620045af37aa7e1f0474870c87378ecc95c20f32b347e26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
