      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来到福岛了～！！",
      "source_fingerprint": "a94319fd6e4aff63536c5a995f7b3b05d55030a0cc03990440538194584e32a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
