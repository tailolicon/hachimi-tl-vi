    {
      "uid": "zhcn:e83689062d653e57cd0c6327",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“日经电台赏”举办于“福岛”。\n因此我们来到了双涡轮最爱的地方。",
      "source_fingerprint": "29b1116dcc3a29f28f49269c002d85131be154e7750b0dbe0b5bd6870dfc277d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
