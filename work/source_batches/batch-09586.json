      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:c90c00fb78f33dd2d3bc3055",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "似乎连食物都很合她的胃口，\n只见她一口接一口地大吃特吃。",
      "source_fingerprint": "9b3e16e4b1dc5bd297254fc113e371f73b4a552f11f114c475bcac7b721c237f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066203.json",
      "json_path": [
