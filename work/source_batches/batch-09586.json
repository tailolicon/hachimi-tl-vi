    },
    {
      "uid": "zhcn:fc7d2b1933bb144cc4ea71ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "考虑到资质的话，\n“日本德比”这场比赛，\n其实非常不适合双涡轮。",
      "source_fingerprint": "056088c5f10fe1cfeffba1ae3a53cd6a34b6dfa565635b76ba937087d5ccb9f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
