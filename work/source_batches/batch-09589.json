    },
    {
      "uid": "zhcn:57040038317269f537de0dfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她不需要退路。如果不堵住退路\n她的“领头”反而会变得迟钝。",
      "source_fingerprint": "87829aa02dea9db778ea44c97c32587ba589a0d2685fa1a16667b7001ca62653",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066207.json",
