        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:5d14957e514b871519bfff33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有啊！再把自己逼得更紧一点吧！",
      "source_fingerprint": "e47ab09790e3d83026f96e8e03db68c26f3d785cd6c2e8c78233b9d308e8264f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
