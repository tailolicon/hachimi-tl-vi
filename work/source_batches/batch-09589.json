      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:a0d2424f385c4c5ddbbef961",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“七夕赏”。这场比赛甚至不是比赛，\n而是对究极的挑战。\n她能贯彻自我到何种程度呢……",
      "source_fingerprint": "c71aafd9b06bb60f17e6ac3493e8de47c565318cbeb3d7982709dbef2ef6e5c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066207.json",
      "json_path": [
