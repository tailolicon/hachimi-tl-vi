      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:cc295739a4ffbfec08f390f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，出道前，\n为了让双涡轮能自由地训练，\n我们三人曾一起去福岛旅行。",
      "source_fingerprint": "f739f3d28deddadb2e1a46f4c8309ad47481d226450315d6d1feb4e351a80283",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066304.json",
      "json_path": [
