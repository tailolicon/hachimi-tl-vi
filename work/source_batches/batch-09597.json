        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:24c73386d407301f8062d3a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在和东京与中山完全不同的赛道上\n寻找改善跑法的灵感，\n或许也是个好办法。",
      "source_fingerprint": "daccee874a63fa4408ac5214d54a666e81883e71eaae02a990820a93aa291543",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066304.json",
      "json_path": [
