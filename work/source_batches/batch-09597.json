    {
      "uid": "zhcn:54c5401a08cdc2346bb9d525",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那里充满了我们三人的回忆呢。",
      "source_fingerprint": "c56cef1813954613023b0a421a4b15980c79c2272ac80f2332bf6281b687f31e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
