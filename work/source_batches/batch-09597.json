      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们去“日经电台赏”吧",
      "source_fingerprint": "b282d4a47dee7423a2e60dfcde48d1b7e3ec018f2a9b5a2b09d70c86bd20d1a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
