      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "双涡轮",
      "source_fingerprint": "bd9198235f86ac3572d3b9faecd9fc51ff7daf7b62a8c4f6e6263a31d4322ff9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
