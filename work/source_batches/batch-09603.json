    },
    {
      "uid": "zhcn:b4628d462fb8b9ce1cafba9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，你说得没错",
      "source_fingerprint": "684b28040163813b2ea6b5995bef272a8b3001fe08bf5e3aa915636bb9e20ece",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
