    },
    {
      "uid": "zhcn:9fefbddeb3d0cebcd8edbe47",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，没错",
      "source_fingerprint": "97e13912168b6f9ef314b16a03b433b7189028784fa79597f5e177d8abef0112",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066311.json",
      "json_path": [
        "text_block_list",
        26,
