    {
      "uid": "zhcn:42e370a221dba0095546abda",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为她可是东海帝王喔，\n只是骨头折到一下而已，\n怎么可能放弃。",
      "source_fingerprint": "7261aad1ed06181e3e693fec5dc4fdb797284a47fb46c48d23a4780d8c3db822",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066311.json",
      "json_path": [
        "text_block_list",
