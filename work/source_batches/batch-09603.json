      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:cdb4b60a01e439a5e6af34a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训的季节就要到了。\n而且目标竞赛“日经电台赏”也越来越近。",
      "source_fingerprint": "4c6ec015eda5c95e1b908eb295fbf0c6ba23bfa637249cf1c3d50eaf27b78a49",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066311.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:ec9118edde21bcbd3f2ed002",
      "kind": "story",
      "source_language": "zh-CN",
