    {
      "uid": "zhcn:46db4a2590003e115f863e0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可能连“菊花赏”都无法出场……\n不会吧……",
      "source_fingerprint": "4ca6599ad5464dbe6ca0aa104d8d6b26cbc4ab199d7aa06b7af1d2c1196199e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
