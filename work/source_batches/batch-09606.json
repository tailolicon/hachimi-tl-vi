    {
      "uid": "zhcn:2e5e2e0c1aeffa898c8235a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为她，今年的“有马纪念”，\n成了颇具祭典氛围的比赛了呢。",
      "source_fingerprint": "2b13bafc6d7a5824ff4afee7f7a059cf1915bf0fc44b3edb2c8cb33d83fb717c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
