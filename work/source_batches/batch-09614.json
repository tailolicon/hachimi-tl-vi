    },
    {
      "uid": "zhcn:b8a03dac7a64c1525176e8cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就此，训练员决定，\n今后也要向生野狄杜斯请教意见。",
      "source_fingerprint": "30ac8b81e60933da72c117d198d977593ce616ff5557591f89586230cbda6c96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a5439c2ba1b891092622481e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "打败“讨厌闸门”吧！",
      "source_fingerprint": "31ae00fe3f647c97c790e5c655217646f9ea0a2d6c80e5ed8311434cb1534afa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1066/storytimeline_501066401.json",
