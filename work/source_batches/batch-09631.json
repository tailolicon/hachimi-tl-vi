    {
      "uid": "zhcn:3be81a6f05f18ace045b8870",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔喔喔喔！那是训练员的海吗！？\n跟涡轮的海有得拼呢！！",
      "source_fingerprint": "e51aef735a1ad10869b72684e5ca364d8b5702521b4c1dad6a75b916c2c29667",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
