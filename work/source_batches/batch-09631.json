    {
      "uid": "zhcn:407fe42eddfb8b7e8e84bb8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哼哼～！没错！\n因为训练员是涡轮的训练员，\n所以跟涡轮一样厉害！",
      "source_fingerprint": "7e47275d20f7651293fce4c4156e3b2c75be9c6a347e9853c953cba2dcadad8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
