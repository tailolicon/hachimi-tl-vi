      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "！\n平手！唔唔，训练员不错嘛！\n下次涡轮会赢的，这次就一起庆贺吧！！",
      "source_fingerprint": "cc96d787b38339dcabe54048d1037b4dfe7ebcadfb7d128252c2e200bf541f60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
