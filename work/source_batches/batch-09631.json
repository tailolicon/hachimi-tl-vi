    {
      "uid": "zhcn:d1b62c7827902865c4d0ded9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这气势与令人移不开眼睛的感觉……\n确实是涡轮的训练员会有的手笔呢。",
      "source_fingerprint": "1d7244cf106f682269412d4b2531e41875d35c511f5091d658ae7ecf22514abb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
