    },
    {
      "uid": "zhcn:cf1cd713173bde715f1faaa8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我拿起双涡轮写的“海”，\n与自己的一起展示给优秀素质看，\n两边都是很有魄力的文字。",
      "source_fingerprint": "06fdf5bd7c6643a9feae55edf5024a371888a45dd07cb86928cca0fb2d2916bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
