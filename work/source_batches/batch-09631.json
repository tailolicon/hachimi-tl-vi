      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:93fd9952cd424954c821a9d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "参考波浪声与大海磅礡的形象，\n我写了带着沉稳感的“海”。",
      "source_fingerprint": "47409a3a7c671d15c970e8a097e256833c49a630b9366eb997e6df24d8889139",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
