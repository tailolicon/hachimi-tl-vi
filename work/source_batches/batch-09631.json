      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好好好。\n既然如此，就判……双方平手吧。",
      "source_fingerprint": "6595f2236b966401a4af01d9896235809a2b5f71c38ec88fde5a4f31ed0fd6ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
