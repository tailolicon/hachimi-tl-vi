      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "该怎么说呢，涡轮不管是内在还是写出来的字，\n都率直到不行呢。",
      "source_fingerprint": "c058f071cc2fe1597c0bb109362c13467c06c34b9c4cb52f062cab052eba534b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
