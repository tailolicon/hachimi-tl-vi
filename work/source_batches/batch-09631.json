    {
      "uid": "zhcn:7fae3906c33cb114d9e1513a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈哈……这股势头，\n她一旦变成那样就无法阻止了。",
      "source_fingerprint": "5f8e1944c47797f2298adc4ef75b33c7141ed3ec7b4b359030659bbb13610318",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
