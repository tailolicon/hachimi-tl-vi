    },
    {
      "uid": "zhcn:7c3ba4090540f3f2b95aa990",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我接下双涡轮的纸，\n并与自己的纸一起展示了出来。",
      "source_fingerprint": "aa40c62575ecd5b64900bfb15edabf06fb41144cbdc16171559bdaa733115d31",
