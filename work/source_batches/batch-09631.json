    {
      "uid": "zhcn:5a79e172b300bb54b48ab7e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因为她不会想得太复杂……",
      "source_fingerprint": "6740dc740ef8fe8557734f6f030384156a3597e995b3db63782e02378143fa8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
