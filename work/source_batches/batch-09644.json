    {
      "uid": "zhcn:0296442b821c23c7dc5ab1ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身为里见的训练员，\n被访问也是早晚的事。\n你应该要提前做好准备。",
      "source_fingerprint": "02bb6aaa2b7640bcaf5576f296413d1732d03d93493768d946d0c311e4c8b514",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
