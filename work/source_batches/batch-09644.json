      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:93d8d1c95a6c15f540acfa75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高不可攀的对象──这是我一开始对她的感觉。\n却在之后受到里见光钻亲自指名，\n成为了她的签约训练员。",
      "source_fingerprint": "4b1c77285c2461795d0ee48c6e1f7602edf1bb78aa7e5aab7ca67bb493868495",
