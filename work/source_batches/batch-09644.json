    },
    {
      "uid": "zhcn:72f228bd78fb95d4597224e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "希望你的梦想能够实现，我们会为你加油的。",
      "source_fingerprint": "3e6517710c6248baf5eb90e0ac8b2010d00e1d4489f95f8c397763daf73f3a8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067100.json",
      "json_path": [
