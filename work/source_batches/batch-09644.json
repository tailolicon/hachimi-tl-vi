    },
    {
      "uid": "zhcn:66323b179bc7225b860733c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "光钻的父亲",
      "source_fingerprint": "9e185c6d6d0aedeb9445d84708f036db2491143cfe9bfca2783943cfd8f37361",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067100.json",
