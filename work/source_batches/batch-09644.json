      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦！？我、我吗……？",
      "source_fingerprint": "b51f9602dac50a54538ebfc4d4791b2615dc5a372f1f651e558dc5784fc79a93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
