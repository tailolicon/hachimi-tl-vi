    },
    {
      "uid": "zhcn:01905f0f7a3a47c581aa370c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她是目白麦昆。\n代表名门目白家的赛马娘之一。",
      "source_fingerprint": "b695208be67fa8591548a0c019b607e9ee7317c71fb27d1e1f5d7a15f5d9ba95",
