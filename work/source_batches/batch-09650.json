    {
      "uid": "zhcn:e1475b6318134f2fcc4a456b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可、可是……原本订定的训练还没做完……",
      "source_fingerprint": "5c06e8bf3774ec33558d040dca12de7a37fb2332c580b5a916e0524bb37e7314",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
