      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……怎么了吗？\n怎么这样盯着我的脸看。",
      "source_fingerprint": "95f16fbc3fde79c803de3784334e3d5a6df453b77a6e6ea44051aeee5ccfa096",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
