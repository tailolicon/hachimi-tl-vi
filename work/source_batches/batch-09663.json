    {
      "uid": "zhcn:2ae06b0f7108d6a4d2f2edfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是说对目标吗？\n因为那就是我来到这世上的理由。\n这点是不用怀疑的。",
      "source_fingerprint": "7beede50415ec4c0d838ac9ed8f48032e3fba0c50e0ee4127fad19b38dc3f9e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067113.json",
      "json_path": [
        "text_block_list",
