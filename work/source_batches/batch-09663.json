      ],
      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:2429741fae34f217348fb961",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这么说起来，\n我好像还没跟你说过，\n我和父母为什么会这么执着于知名赛马娘吧。",
      "source_fingerprint": "30896cc0d72ef8583e36d3f97fee8731afed44d53a16c647f71938588c81868f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067113.json",
      "json_path": [
        "text_block_list",
