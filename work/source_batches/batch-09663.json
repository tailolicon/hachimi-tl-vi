    },
    {
      "uid": "zhcn:5f3991ab57e4901f885a6750",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
