      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "甚至让里见家一度认为，\n生不出赛马娘\n也都是因为魔咒的关系。",
      "source_fingerprint": "0fce804575789701c872dd6447f984c99cff1d9e7485a961eecf91795f8f00b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
