        60,
        "name"
      ],
      "json_pointer": "/text_block_list/60/name"
    },
    {
      "uid": "zhcn:5b7517bf748845d88a05e96e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我总是追着跑在我前面的小北一直跑，\n一直、一直追着她的脚步……",
      "source_fingerprint": "37546deb52c02d3ebcbcbebe82fdfdf29daea55ffd98906f9b1b2d08ff8ff86d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
