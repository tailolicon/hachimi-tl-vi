    },
    {
      "uid": "zhcn:6df2b7543da11626f694cc2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想我大概能明白你的意思……！",
      "source_fingerprint": "14ca1016710ce8ab33e10305732522a94ef372ae1b8216a49dff32705c1b241d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067113.json",
