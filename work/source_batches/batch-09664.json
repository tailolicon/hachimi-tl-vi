    {
      "uid": "zhcn:2938ddcfbc3989e092b5678a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的目标是成为一个从内部支持赛马娘界，\n以及赛马娘竞赛文化的存在。",
      "source_fingerprint": "f90762d13bbc3aa0ae724743a2a0678471d5796b828331b22d57ef1ad188e8b6",
