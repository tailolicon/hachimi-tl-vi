      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:cc9180e3ae660b0b10ebc538",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天我和里见光钻一起，\n来观战北部玄驹即将出赛的\n“菊花赏”。",
      "source_fingerprint": "a481213ffaaa2e17f64b21920858c892f33330a3a63adffe606b00c5d20b050a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067114.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
