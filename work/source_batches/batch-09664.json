    {
      "uid": "zhcn:7bc11b689a72c082045b19a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果可以的话，\n我希望能以万全的状态挑战“皋月赏”。",
      "source_fingerprint": "fd1e366f3c0ec08e8d34e814eed38a0484a2cc6783d7b16253b67f3dc0f9c8b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
