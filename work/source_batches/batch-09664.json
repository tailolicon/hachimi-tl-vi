      "uid": "zhcn:a28e3932d57a254cf0df4967",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小北不仅是我的好朋友，\n也是我一直想要战胜的目标。",
      "source_fingerprint": "5144f35e80557c9e4d337e4094967576441d9d02a0cd17613c50f55f4ecc4dc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
