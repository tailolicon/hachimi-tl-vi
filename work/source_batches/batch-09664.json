      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成就我的存在",
      "source_fingerprint": "ba93a0dc330768ebf9353e3b5b086211dd23fac75a679be67f35ec3da293d6ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
