      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但小北是绝对不会放弃的个性。\n她接下来的比赛才是关键呢！",
      "source_fingerprint": "d371fb81ca0eb5999bc08e92ebf91491f2319230c29a07b659b1f523e00e1dbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
