      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是我向她说明，\n在身体成长完全前承受太大负担是可能受伤的。",
      "source_fingerprint": "d56fab9d66bd8674119c797d41eb7f1e151aed8e3c9e028bef5f2d1000bc0426",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
