      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那不然做坡道冲刺的训练怎么样呢！？",
      "source_fingerprint": "8a08c67a0fe94e467167f284697298b2debdabcce8d7a0918b9508ccee2fdeaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
