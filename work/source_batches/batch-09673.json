    {
      "uid": "zhcn:cac9300ad70845b5521de88f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你要是一直这样静不下心来的话，\n比赛的时候就要遭殃啰，小北。",
      "source_fingerprint": "d23a30b16c04d431bbff6752e5eaebdc0b46bd503e025abc787a6bb1e2fb7af8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
