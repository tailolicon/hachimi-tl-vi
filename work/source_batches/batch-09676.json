    {
      "uid": "zhcn:a2fc65526fbdfb031d6ed4c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“Rookie Knowledge,\nStats, and Talent”",
      "source_fingerprint": "2af49601216cae9d15a83372961c549fe04cc6a5e003bc00951004e8f74f549b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067200.json",
      "json_path": [
