      "source_text": "是！\n里见光钻要上场了！",
      "source_fingerprint": "877964fa9aaea26c190a09cf7040ae24a0c42e2399c2bb43ae636a8482530b83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
