        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/6/choice_data_list/0"
    },
    {
      "uid": "zhcn:be7e2a5db69f3203243194ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下交流道后的路况也依旧拥塞，\n再这样下去就要迟到了……！",
      "source_fingerprint": "eeafb9e09cd2cfc38fa5374d97fdc4b30d4787c46eaa44e15d47563926d6260d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067201.json",
