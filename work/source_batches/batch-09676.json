      "source_language": "zh-CN",
      "source_text": "唔……！风好大……！",
      "source_fingerprint": "6c4e2609fedd63c47722e00ac9f8ed1ee1ef220dd61ffc19e9e04fe147a82b22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
