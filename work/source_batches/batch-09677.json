    {
      "uid": "zhcn:cae1827a80c974bbe6d78ac2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "父亲和母亲无论多忙碌，\n也都不忘为赛马娘界的发展尽心尽力。",
      "source_fingerprint": "f7f1fed6491682a4e8d71b50d0d0283c6b7a6686a882b923388a81e838ffc835",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067202.json",
