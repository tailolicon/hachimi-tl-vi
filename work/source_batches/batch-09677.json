      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一定要把最棒的奖励带给他们！",
      "source_fingerprint": "d86d629f8228e1021fe0a689e95d77d2ce8c6ea353ad6c8af49400a81d7c8dbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
