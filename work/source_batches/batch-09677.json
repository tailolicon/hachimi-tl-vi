        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:d7cbf41646d5804092762a5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们对于在“皋月赏”获胜更加充满了干劲。\n很期待她能顺利赢得第一个GⅠ胜利。",
      "source_fingerprint": "8be00b22039d8650fe7cd5108e88867537fc4bd0185ec3e697eea15c94eb6995",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067202.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:3159375f2e492be695a12f12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听说明天会有暴风雨……",
      "source_fingerprint": "817727fe0a64a52317e3758cbb5c13f14743ff04ce6c2b59ab52fd74c19cbf54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067202.json",
      "json_path": [
        "text_block_list",
        18,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/18/choice_data_list/0"
    },
    {
      "uid": "zhcn:3298a72820ec6fdce0943a3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──然而，就像是老天爷要泼我们冷水一般，\n电视上的天气预报显示出令人担忧的资讯。",
      "source_fingerprint": "a4a260cceb17f7f0cca1f253ce4c12d5b33dc0e87545306ee5fea772084caafc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067202.json",
      "json_path": [
