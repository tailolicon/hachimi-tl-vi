    {
      "uid": "zhcn:66d4e425cd990abf3fe0b561",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯！里见家首次的GⅠ胜利，\n我一定会达成的！",
      "source_fingerprint": "c2f0a93215bd8d338d6d4c72e5dee58344ee7caf0495a3be8ddb34643ccac093",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
