    },
    {
      "uid": "zhcn:19fc27b84806d5b9e42208f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好像是这样呢。\n但请放心吧！\n我有做好面对极差路况的准备！",
      "source_fingerprint": "eb0cfd72a1e7d4ee81c3f184502df64fee1428da1302f92bac9f66b2a9189920",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
