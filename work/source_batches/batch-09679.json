      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:139155acb44250ccc5b3f506",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为这对里见光钻来说，\n是一个相当好的预兆。",
