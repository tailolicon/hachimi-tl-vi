    {
      "uid": "zhcn:b4d5512b101ddfdcf07299ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小钻的训练员！\n怎么样？小钻的状态还好吗？",
      "source_fingerprint": "8e9b59a9a43ecb835d2ad4c2af438ac3fb66158f6d229b9b1ca9628b8600d5ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
