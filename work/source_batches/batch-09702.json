    {
      "uid": "zhcn:b480eb121c9d5dd1714a4295",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想要参加“天皇赏（秋）”！\n我想要挑战麦昆！！",
      "source_fingerprint": "ac1d5c73549539e91c66de9cfa4b6f118bfbc75500038c34811e05a36c288501",
