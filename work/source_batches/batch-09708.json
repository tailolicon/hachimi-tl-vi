    },
    {
      "uid": "zhcn:482a26c3c9c270f1b17de871",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家在里见光钻身上所追求的事情。\n她的表现能带给粉丝什么梦想。",
      "source_fingerprint": "5887434879e7b5ecbbb8315cc571e2adcae4125d0c54a9e7420896d6cc196a3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
