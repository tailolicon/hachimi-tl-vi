      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身为一个赛马娘，\n我的表现能带给大家的究竟是什么……",
      "source_fingerprint": "6a7101bcc5673647b886b545fa705b7707c81c09c61ba2e8316e8fb60cfc2b3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
