        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:0d3f2149dd2474e1398b76b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成功克服了里见家长年所困魔咒的她，\n给人一种，\n或许她有可能做到任何事的感觉。",
      "source_fingerprint": "ca14728a00cd6d44e57cb851ea29ffc6bc87a5405c3b8a62737a3eee156e365f",
