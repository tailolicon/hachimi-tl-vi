    },
    {
      "uid": "zhcn:e910b5c41e4407d97dd10e54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻充满着斗志，\n她打算在这次的夏季集训当中，\n练就不被魔咒左右的强大实力。",
      "source_fingerprint": "ec02fde514860d4816e4487c2ccc2f9a2b7b6d23163f4da5f119f8c7572aa3ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067405.json",
      "json_path": [
