    {
      "uid": "zhcn:3ef715dd3d9e678ead1ca3d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻听了建议后，\n决定专心投入在练好自己的跑法上。",
      "source_fingerprint": "4552fbacc3dea8ba814e0c7cbaf2389e1b2546bb37ec9150c85a59cc1e048693",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067403.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:8ef672a23bc932991b2f2c7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "困住我的东西",
      "source_fingerprint": "b9ef3cf2018b2e0603ee091ef70ae6eb9ff068c7e05ae709aee35bed9161e342",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067403.json",
