    },
    {
      "uid": "zhcn:7f23a720bf6049c325d066b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员找北部玄驹商量此事，\n决定要让她们进行并跑练习，\n但里见光钻依旧没有找回自己的跑法。",
      "source_fingerprint": "046dc3c436e39060ac859b13a8c1c2ca1ab5fe3cfefa097029dc2406aaf39a98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067404.json",
      "json_path": [
