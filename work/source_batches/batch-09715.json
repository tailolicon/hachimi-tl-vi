      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:950003fed1fb948d5692d11c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同时，北部玄驹也充满了干劲。\n两人为了迎向一起比赛的将来而互相打气，\n并约好要一起努力。",
      "source_fingerprint": "58bdd70dcae236637dd12a2ef77eacef9bf21c65753106ed2f6e7b34cee31887",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
