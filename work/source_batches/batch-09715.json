    },
    {
      "uid": "zhcn:3ab8b816e9b71a7d4391178e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练结束后，\n北部玄驹突然拉着里见光钻的手奔跑。\n两人就这样跑去了各种地方。",
      "source_fingerprint": "bf5fd561d930c9022187b6d92e0f5067e78f25e102ebe4a291c8b620b1de4ca3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067404.json",
      "json_path": [
        "text_block_list",
