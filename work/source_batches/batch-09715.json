      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a92381572a14c448fafd5342",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人进行长跑训练的途中，\n里见光钻前去购买饮料，\n打算挑战喝那个饮料就会跑输比赛的魔咒。",
      "source_fingerprint": "166cb7b01ed327e09cc6b4d293568a660030fd921311fcd067b153d7b599a916",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:be6648acc7289d0a1bcfe8ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
