      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:94f70dd506a2a04cbfc39a28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白麦昆和东海帝王\n也在观众席上见证了整场比赛。",
      "source_fingerprint": "4e33d6a74bc61462c7fd3adb976dccd2386c6eff9d442f3533c73835a56a3c2e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067430.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9ed7734532fe35d2ce911f05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹虽对结果感到不甘心，\n却仍旧表示希望还能再一起比赛。",
      "source_fingerprint": "c7aeae058ab5691e2effd19688873b29d689d867864c0c9da35dca19942b247f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067430.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
