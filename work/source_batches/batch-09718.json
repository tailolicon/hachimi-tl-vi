    },
    {
      "uid": "zhcn:b7ed67924cda0c33bc3b2058",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻在“大阪杯”取得了第一名。\n观众们对她美丽的跑姿赞不绝口。",
      "source_fingerprint": "815fcf564d113ac03d65ab07a8e4eae631342bc87d48de125dba26ac81649127",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
