    {
      "uid": "zhcn:7b33c711bcc4c482d4e29ceb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻称霸了“有马纪念”！",
      "source_fingerprint": "df6b08e16ffdfb6189dce2c32c20c26c6f4c0b6ebf9e58dc6c133524f9958203",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
