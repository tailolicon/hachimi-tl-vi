    },
    {
      "uid": "zhcn:8193c5a347d7da3477783d09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而她未来的蓝图里，\n依旧会有北部玄驹的存在。",
      "source_fingerprint": "71becea8342b7ba79284d8d772f00c1de58d90ffec481732d9f0e124155f3f93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
