    {
      "uid": "zhcn:365f3ef95e22f22b27242394",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听完之后，\n里见光钻开始思考，\n自己身为“知名赛马娘”该有的姿态为何。",
      "source_fingerprint": "3f07f3d25d75a4c0a07358eceee278d196ba132edd117ba6df5c5441ce868cd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067438.json",
