      "source_path": "assets/story/data/50/1067/storytimeline_501067443.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:4afeb2ce70290cb50e41edbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是里见光钻所认为的\n“知名赛马娘”该有的姿态。",
      "source_fingerprint": "687aa3c732ddad50c460107d7a3f473f0f407a2d0ea5cd440cb239c38f004382",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067443.json",
      "json_path": [
