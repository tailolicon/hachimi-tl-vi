    },
    {
      "uid": "zhcn:ba0192f9f4585385fa59fa84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她誓言今后将以“知名赛马娘”的身份，\n挑战各种顶点，\n为日本赛马娘界做出贡献。",
      "source_fingerprint": "23df1ed4a26505d762d701a53f5845fc29436e98a3f627439c188b0fa9d8a503",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067440.json",
      "json_path": [
