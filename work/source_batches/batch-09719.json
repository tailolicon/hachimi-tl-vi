        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8952e7c3d2451d2ce77b0658",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹因为辜负大家的期望而痛哭。\n里见光钻则是温柔地在一旁安慰她，\n并告诉她观众不会因此而放弃她的。",
      "source_fingerprint": "66d09141cdee3ff91500ea72be127701f90ae864842b236dc0f869a05488243d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067442.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:7dfcebc6bb6c7826fb7e75a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "粉丝们是在北部玄驹努力的模样中\n看到了自己的影子，因为有共鸣感而支持她的。所以，\n粉丝们现在一定很期待看到她能重新再站起来。",
      "source_fingerprint": "d4ec837236d351ba47f4f24acf5ca1525137a6df97be06962ed9a05487c166a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067442.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:f1fe57537cb337fabf68f091",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "连里见光钻本身也是抱持这种期待的。\n说完，\n便让北部玄驹自己思考答案。",
      "source_fingerprint": "0165ba3410343514851d3518316d92190b202254d7beed8098655f577248d677",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067442.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:46f6cfd5fefc0670f1a792d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那是唯一的光芒",
      "source_fingerprint": "8ee61aa868d6090c3623c0d926497a18090cf408b7f93f2b2eeef62ad98c9ab9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067442.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:e5b2be183aaf9cf0e246b118",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻观战“日本杯”。\n对东海帝王和北部玄驹两人\n积极进攻的表现感到很震惊。",
      "source_fingerprint": "42c60e5b4aa1870563cf2639b837b8bd1507ab8cd42c00c98a1c46ed0744bb39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067443.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:d650d79d0f2626ccefd37916",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王说起自己也总是\n把自己定位在挑战者身份的心路历程。\n一旦停止挑战就等于结束自己的旅程。",
      "source_fingerprint": "fe460b0d9e3614b281e87dc7e8712cbc94a5d69023dd950224ad9a7ce4e0160d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067443.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:1e72c30cc0a124bb5927890f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听完东海帝王所说的话后，\n里见光钻也产生想要持续当一名挑战者的\n想法。",
      "source_fingerprint": "d55f7f72d083034b73b69b05e795cb93533b57c326d78961facdb5c81b8e3a35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1067/storytimeline_501067443.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:9f2283a67768db4ff5afe83d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决心要挑战各种事情，\n为里见家和日本赛马娘界\n开拓新的历史。",
      "source_fingerprint": "007190687c8625ac4babf615dafd61f6fd03cb07c831cc013c95e16cc43a6555",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
