      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "拍影片。\n我打算拍来当作VR赛马娘模拟器的素材。",
      "source_fingerprint": "ab309fa8ff0f694e5f9c9409fa4cf7ec0d48fa6b87b07756a8b40e27344bb2fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
