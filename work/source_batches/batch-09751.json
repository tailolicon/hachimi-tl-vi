    },
    {
      "uid": "zhcn:e6bec6572a7fd5a22e2e2ddd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
