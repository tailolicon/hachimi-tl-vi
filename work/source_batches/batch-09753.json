      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
