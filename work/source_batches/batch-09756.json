      "source_language": "zh-CN",
      "source_text": "里见光钻",
      "source_fingerprint": "a913b033e75912b0a4cb7963f7e72669b709a7ceab5f45934f12e6bb61efe713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1068/storytimeline_501068102.json",
      "json_path": [
