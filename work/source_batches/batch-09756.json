    {
      "uid": "zhcn:6e5b9121827e0299877de693",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1068/storytimeline_501068102.json",
      "json_path": [
