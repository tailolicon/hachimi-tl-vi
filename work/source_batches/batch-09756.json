    {
      "uid": "zhcn:ab9693ff0885b58c8b9a8b76",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一定要“称霸GⅠ”。\n完成宿愿，\n用里见家的光辉照耀大家！",
      "source_fingerprint": "e25f3faa5cdbd97532d0056fe76277e56f931653f721797ba58941f82fd737b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
