    },
    {
      "uid": "zhcn:ca361b68afc5bb18a465bdc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小钻，那我们就来做每年都做的那个吧。\n新年对战！",
      "source_fingerprint": "055d8a15f27005c70c81c52dc0a21fc36f6154b5fab2dd6501ba660aaa64ac1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1068/storytimeline_501068102.json",
      "json_path": [
