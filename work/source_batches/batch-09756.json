    },
    {
      "uid": "zhcn:0b99ce5645571a3af647d199",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然顺利完成了新年参拜，但──",
      "source_fingerprint": "69373538c0867253aff03b7c305b95eb9778c50720e16724f7260b80563d521d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1068/storytimeline_501068102.json",
      "json_path": [
