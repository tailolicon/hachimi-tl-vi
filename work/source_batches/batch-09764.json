      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:33ee93723d25186abeaec33b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一边赏雪，一边干杯。\n这样过圣诞节也是别有一番风味。",
      "source_fingerprint": "3a1b49fcc33cbbea7973682daa0aa17e7435ce9963a514128dff8285393ab25c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1068/storytimeline_501068109.json",
      "json_path": [
