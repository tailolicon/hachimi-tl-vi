      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:7209f2eb0a363f62b170541a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一边聊着彼此的回忆，\n一边持续喝着饮料……",
      "source_fingerprint": "55b2b3587d2135a8337d30ab8c9dc2c7690a8d500e960dd76f863735b79ce2cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
