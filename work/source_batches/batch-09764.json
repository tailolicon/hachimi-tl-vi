    {
      "uid": "zhcn:417874af160bf3157383a137",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯──我想想，\n说到圣诞节，果然就是要去……",
      "source_fingerprint": "ac58895c1f1bd6cdf6f6232a2a9de1d2a5304bb3064a3896d6aa1ebc7f29c2fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
