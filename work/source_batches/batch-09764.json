      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，我们去看吧！\n毕竟这是大家的好意嘛！",
      "source_fingerprint": "1b551366c28bc8717b14c3a1e888478ae7fefa8edd27f7ff264673b636b6429e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
