      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "再怎么有才华的赛马娘都培养不出这种器量。\n没错，北部玄驹──",
      "source_fingerprint": "d65daaaf9331d0bb78dc9272f3b1cfdb9f602670ac0defdfd8e09faa98983b5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
