      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一句话自然而然地从我的心底脱口而出，\n我代表所有和赛马娘有关的人……",
      "source_fingerprint": "bc1fa0aa8cd084798eb8f147dd589f7fe5a8f4f04a52b1752c1ef622624be1d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
