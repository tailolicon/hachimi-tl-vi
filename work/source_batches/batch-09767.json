      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:b3f4bd2af5fc2214897a0fd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的器度无可比拟，梦想的格局也不同于别人。\n还有谁能跟她的贡献比肩呢？",
      "source_fingerprint": "897786c2946415bcca1470e0485eae99b653446293c20a346bfee86baeeca254",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
