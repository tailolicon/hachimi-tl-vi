    {
      "uid": "zhcn:1d850f657da91f6c1bfc164b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不怕，因为我不再是一个人了！\n我的身边还有很多很多\n支持我的同伴！",
      "source_fingerprint": "b33b382fefa93e03f472c45278daa50d360d4aee535e4003c80635e93e94e3aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
