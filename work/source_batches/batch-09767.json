      "uid": "zhcn:abe4f7f9fcbeee0ae0693714",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你，北部玄驹",
      "source_fingerprint": "43345d1fee6a3e1ab166b310b52272dff13fc0f66f47cbbf2438c9277a430b10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
