    {
      "uid": "zhcn:525933d32a961ba9b84c4a5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她就是大家的太阳。\n从无人知晓的最北边冉冉升起──",
      "source_fingerprint": "b39dc75920109b0edaace55ccec3db2701812fc71943f49ea57d7427d15b0e40",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
