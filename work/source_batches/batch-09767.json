    },
    {
      "uid": "zhcn:28717915244b63ce308292a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "升到最高点后，\n成为了照亮万物的太阳。",
      "source_fingerprint": "14b7fe52396c9ad01bd19c2ac8040b52c5bc81287d247beb46bb769fa79c9740",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
