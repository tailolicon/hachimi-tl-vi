    },
    {
      "uid": "zhcn:87ae82e04b0da04a1f6b249e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹从不懈怠。\n就是这股惊人的行动力\n引领着大家前往更明亮的未来。",
      "source_fingerprint": "38a72fa1c13bef2cb990f9f36f8bdacd34af4a5cceaf300fb765e47a808a90ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
