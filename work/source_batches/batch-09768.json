      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的！因为登台表演时都是跳比较西式的舞，\n几乎都没有机会可以跳日式的舞嘛。",
      "source_fingerprint": "d88c64e5a8c0f40b6c53706d8a1695eaee0d1497f7c4203d88249ae148a928ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
