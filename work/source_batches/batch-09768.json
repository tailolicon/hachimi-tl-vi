    {
      "uid": "zhcn:d2514e3b8a4077a997aa050b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "平时总是乖巧守本分的北部玄驹，\n今天像变了个人一样开心地自由放松……",
      "source_fingerprint": "35a8f364cf1e11b7d2a0d1115d8bef9e848d64e2973081a7b5756a1f8f2f3410",
