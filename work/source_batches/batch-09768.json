    {
      "uid": "zhcn:eae6e86d552e55c1aba01962",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，对了，训练员！\n要不要跟我一起跳盆舞？来跳盆舞吧！",
      "source_fingerprint": "4ff9f4513cb7bcfed864b14d21f923b9c38572407b1b29b949c7db8f4b695d1f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
