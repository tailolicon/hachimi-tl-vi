      "source_language": "zh-CN",
      "source_text": "我是觉得小北的个性认真又老实，\n所以太过鲁莽的策略跟跑法\n都不太适合她啦。",
      "source_fingerprint": "b33d1757f011bfffb4d60edb8cd2df3b121e336d3c24823c6373b0dcab594e83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
