    },
    {
      "uid": "zhcn:a44e8a9a579e6bd330cbfa32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁莽狂音的训练员！\n关于今后的计划，\n应该也包含了经典级的GⅠ竞赛吧？",
      "source_fingerprint": "3e0115b8f364b381f31010af7c07b015e5c411cc51ce091444e2077917dcf8a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1068/storytimeline_501068115.json",
      "json_path": [
        "text_block_list",
