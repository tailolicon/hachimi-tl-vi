    },
    {
      "uid": "zhcn:35f42cd9aed1120a6d27b752",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "距离资质是相当难辨识的部分。\n正确来说，\n是只能透过累积实战来观察的能力。",
      "source_fingerprint": "c3c753a1a6de247538a80c30884e1dba3d72f7da665cf7d2e5b79711af015481",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
