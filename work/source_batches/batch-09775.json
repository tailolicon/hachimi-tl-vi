    },
    {
      "uid": "zhcn:2017eb6c48c2f72d125e09fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "眼看北部玄驹差点就要相信，\n我简短地出声阻止。",
      "source_fingerprint": "0e11bfdab3a32065cff7bd6147c5845d3356a12865568c2730c37b878681b12d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
