      "source_language": "zh-CN",
      "source_text": "哼哼哼──这还用说吗！\n担任你特别教练的人是谁啊？",
      "source_fingerprint": "bf45a7e4d4a04e1d33819711a23eee79d4b1d6a1862031f6583dc1c4ec944e03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
