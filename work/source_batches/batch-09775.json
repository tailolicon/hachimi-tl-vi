    },
    {
      "uid": "zhcn:61efb4529d14db86437cdb32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果进王这么说的话，\n我觉得应该不用担心呢，训练员！",
      "source_fingerprint": "c8a13ba0490fd5f0dccc79c1a2648a46be1f2f0b2e7de053dcabe79ebd6adc9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
