      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:8790ce56d36de0acf2f25bd6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹还具备了\n长距离所需要的坚强内心。\n现在的我比起疑虑，对她更多的是期待。",
      "source_fingerprint": "f8f82405b0624c6d854ca7270d94c9585079abd725fd29f7b4cb7d239067eb90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
