    },
    {
      "uid": "zhcn:0ca84bbe6a855d278d66c6dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "友情的河川。\n深处有着连绵不断且难分难舍的汇流。",
      "source_fingerprint": "bac1f88b932bb86234613983a25a6d6ec7e880752fda37bb07089422102257be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
