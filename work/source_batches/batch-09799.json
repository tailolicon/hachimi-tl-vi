        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:3a6fa1a5f384458e15ea88c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹顺利地在和各国强劲对手的竞争下，\n完成了日本助人总大将的使命。",
      "source_fingerprint": "192f226b204e06a42f879777f0075c7d4f21dddda13e0df7cc3910b020315afd",
