    {
      "uid": "zhcn:c099c60c388ec18c8c70e6d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就像我们一开始\n一起踏入特雷森学园的大门时一样！\n抱着绝不输给对方的心愿……！",
      "source_fingerprint": "83ac20402f6f347c03a829b5c1a4e6f149f9879886613e5e030d2ae2afb5fb0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
