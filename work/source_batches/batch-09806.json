    {
      "uid": "zhcn:e37e341f17ee9088ac44357b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹充满活力地如此宣告，\n然后展现了\n比昨天更好的表现。",
      "source_fingerprint": "13151ca514d781685e5896ce05c4f8985c190992337f1724be926934da40d823",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
