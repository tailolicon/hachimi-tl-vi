    },
    {
      "uid": "zhcn:a79b7046bf9e2c9218eae48a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有马纪念结束后・超越憧憬",
      "source_fingerprint": "30e348894dbc3a105778503b5e958a863837d0babf30c4cb0d6a4a0871b25490",
