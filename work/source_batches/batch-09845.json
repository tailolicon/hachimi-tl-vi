    {
      "uid": "zhcn:c46fbc5e8ab06f29df2ef70b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "换句话说——即便学年不同，\r\n此时坐在此处的赛马娘，全都是樱花千代王\r\n同期的对手。",
      "source_fingerprint": "02e0543d519930c881440ab18fd44d171eb3604797040295c04847f9ce79758d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069100.json",
      "json_path": [
        "text_block_list",
