        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:2d61f87e27463f95deb25408",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……必须要牢记的劲敌也太多了……）",
