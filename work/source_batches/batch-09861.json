    {
      "uid": "zhcn:077464c4664db26267a0e072",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会付出“现在”我所拥有的一切，\r\n以『目白阿尔丹』的身份赢下日本德比。",
      "source_fingerprint": "00be3117d38c01e63da1cbc600a2a4337349a3410a6beaafadf635a9a8f88e1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
