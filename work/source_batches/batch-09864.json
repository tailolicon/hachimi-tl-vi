    },
    {
      "uid": "zhcn:98df11e39068a21496104dce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她不愿和我对视，目光游离——\r\n但同时，还不自然地抬了抬自己的右脚。",
      "source_fingerprint": "e15935ae1e5eac7c9a6dc8b54c63e78b4349be2183d90e982967e61e5c915515",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
