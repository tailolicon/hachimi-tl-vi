      "source_language": "zh-CN",
      "source_text": "…………好的。",
      "source_fingerprint": "ce4ef835b31e8c789c93c0d1ac3c2308fb9f3f68e6b60305bd2bdc4ee586ac4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
