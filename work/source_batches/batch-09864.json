    {
      "uid": "zhcn:218fce3ee7b9a2cadce880ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王的右脚小腿上缠满了绷带。",
      "source_fingerprint": "5d7b1f786c6351fcbb311d839b27f0fcdeeabb3353cf1e6cd136b6f81559b584",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069114.json",
      "json_path": [
