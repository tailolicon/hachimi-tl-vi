        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:7d09a16371374bd39e345758",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你在背着我悄悄自主训练吗？",
      "source_fingerprint": "12a764e98a8526a4eac02ee40e02777535fa89b1ab884d8582e47d73e9d78ba0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
