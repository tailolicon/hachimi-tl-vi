    {
      "uid": "zhcn:de1686a2ea9a2fabf9dbb608",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……让我看看你的右脚。",
      "source_fingerprint": "eda89d863bffa6eae712045a717b7f49963e39a808764589c2f4f81031a0b7fe",
