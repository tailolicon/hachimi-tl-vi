    {
      "uid": "zhcn:7513f6caad1e8a64e7e29540",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……最近，吃东西的时候有点犯恶心。",
      "source_fingerprint": "a07641e09e916c0afb4489989ed1cdae778b7708ac9089856393f1c976e7096a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
