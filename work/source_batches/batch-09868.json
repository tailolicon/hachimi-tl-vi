      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——突然，\r\n我意识到我在什么地方听过似曾相识的话。",
      "source_fingerprint": "104c2aa25c224bae6c0fa5fb41bc47cb6ae491b5ca415af6c843e0de14102cf8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
