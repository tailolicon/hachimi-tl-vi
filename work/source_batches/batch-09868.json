    {
      "uid": "zhcn:a4429e59d9dfcca570969cc4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身体也感觉有些沉重……\r\n嘿嘿，是不是身体在提醒我该减肥了呢。",
      "source_fingerprint": "824bfcb7ca05d30088875cbca83c6627cc972c839db5eb3e01a759daa02b0f98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
