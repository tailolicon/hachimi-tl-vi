    {
      "uid": "zhcn:29700531c3efcaa343f6a5a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想赢……！\r\n为了我的梦想、丸善小姐托付给我的梦想……！！",
      "source_fingerprint": "05099b67c3f8d35310a98b4e62b1574496a4bda9547da60f6a61e07d4755ce1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
