      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——终于有一天，\r\n我听见自己体内的什么东西折断的声音。",
      "source_fingerprint": "b322cef0a550d960f26ca04077629882f77841113e254c9979dfeada3e1d156f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069203.json",
      "json_path": [
