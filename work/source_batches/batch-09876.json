        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:575de1ac5db1426e6c070bca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基",
      "source_fingerprint": "3a111c295c29db60e32bd168d60190c13455a98552a2c34857e1da93a365a5b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
