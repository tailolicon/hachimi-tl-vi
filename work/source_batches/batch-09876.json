    },
    {
      "uid": "zhcn:31541cefad6f6ce2ab350b34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基",
      "source_fingerprint": "3a111c295c29db60e32bd168d60190c13455a98552a2c34857e1da93a365a5b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069203.json",
      "json_path": [
