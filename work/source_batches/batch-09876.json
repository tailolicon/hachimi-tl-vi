    },
    {
      "uid": "zhcn:17a3883b7ecd1a264ac91f51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "偶尔，我也会听见观众们的呼声——\r\n『你的话一定能成为德比赛马娘的！』\r\n『肯定不止啦！大奖赛肯定也能轻松拿下吧！』",
      "source_fingerprint": "6f6d75a820c60b15851294b117131ea906c396a10d2c10e170f8c680b487d074",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069203.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:06410851727c5b234aa7b595",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基",
      "source_fingerprint": "3a111c295c29db60e32bd168d60190c13455a98552a2c34857e1da93a365a5b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
