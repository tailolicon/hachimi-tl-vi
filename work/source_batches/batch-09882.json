    },
    {
      "uid": "zhcn:83d1501fe0ecbde4eaa0919b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是的。\r\n她们两人，对我而言是无可替代的劲敌。",
      "source_fingerprint": "a02548b417ba9d86e0c19125e8e12d528a157c1c0a90c2504282b74548f7d2fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
