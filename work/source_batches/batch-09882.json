    },
    {
      "uid": "zhcn:40c5c0c3a9915c32ee007078",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千代王应该还没有将自己的情况告知这二人……",
      "source_fingerprint": "c80d920ee3296037ddafe4852fc7ddeb687ebd0ccc4ecd2ed18636a4f236e2cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:16d7785f6a6767c42150f7db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你真是结交了些好劲敌啊。",
      "source_fingerprint": "a37f6cb017c4afd57fea09c7dfbc853adc1ea81ad12f9abc35746bd652c7a7d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
