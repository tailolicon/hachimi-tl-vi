      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:fbab9348d240345da5d1aaa9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然她的身体水平正在退步——\r\n但是换而言之，她作为运动员做积累的经验正在\r\n不断增加。",
      "source_fingerprint": "906a8c1ad29b239dcf59f2cfd9b59cedca74229f6bdb18096db850dc1e77e97c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
