        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:d20cf3ccae8bbd40e8d06e1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——她的成绩，比去年冬天缩短了1.1秒。",
      "source_fingerprint": "09d5f75505089762dbd8b9cc7f08c48a00234791305bb730e89ea97097ad976c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:e5cec956a35beaab2e590953",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比起单纯依靠身体一跑到底，\r\n现在应该着眼于她的爆发力和思考能力。\r\n……需要训练的内容已经截然不同了。",
      "source_fingerprint": "ec529a146272d2fd0e492549677daa28e497d2703822041330cdf09d53251150",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:4fab91610ec855389f073b79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与此同时，为了迎接比赛而调整状态的方法也得\r\n着重注意，绝对不能让她像皋月赏时那样受伤。",
      "source_fingerprint": "06d83dbd7237dd1b52a1a40a6beaa466dd150d928d291178e4302050d5371185",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:471c001a2633388059cc3593",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是为了治愈疲劳啦，好好忍着。",
      "source_fingerprint": "9289e3c20ba2cb7e208b176c734fddaae13cd448f3e557bc287778a0dc634162",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
