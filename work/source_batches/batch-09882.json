    },
    {
      "uid": "zhcn:47f96080eacad35facbf40e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌",
      "source_fingerprint": "de3656ba07dd9368850ce26c63bb79082f1316261fe58ad07b81cfe0e318be71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
