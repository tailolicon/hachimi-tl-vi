    {
      "uid": "zhcn:3f052f1d44520e9c976900d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请你一定要牢记这份心境。\r\n……告辞！",
      "source_fingerprint": "ea1a8c1baba4b6f3dc2e08975be41df9f341ba3e2b17e65d79e2df63b95cd4cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
