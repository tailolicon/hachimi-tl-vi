      "json_pointer": "/text_block_list/19/name"
    },
    {
      "uid": "zhcn:eb0f0c2127b994a22a40e8a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶？你、你怎么突然说这话呀，八重同学。",
      "source_fingerprint": "0354838d606cf02ffb646aef4f4ece6f2724375f593f57986540fa43483748c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
