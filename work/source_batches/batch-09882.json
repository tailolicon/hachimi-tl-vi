        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:eea90aa2d97c8a4d391cdca3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从那天开始，我们已经将训练方案改换为了专为\r\n已经度过巅峰期的赛马娘准备的方案。",
      "source_fingerprint": "efefacee2c6282b578f3395d57040b7d249ddc6519424ab8f2ef7ef6f99f1316",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d374264bf2117ad51044ac74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌",
      "source_fingerprint": "de3656ba07dd9368850ce26c63bb79082f1316261fe58ad07b81cfe0e318be71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        20,
        "name"
      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:1a1e70d76c0acc435193d42a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前几日，我想用激将之法使你振作起来……\r\n是我太过愚钝，没想到起了反作用。\r\n作为谢罪，请让我指导你一招。",
      "source_fingerprint": "ae066ace364b24201624aeec07012eab8b9d9eecf457a7d46fb755d126c73a3c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
