    },
    {
      "uid": "zhcn:6b40345becd6816cb8765de0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那我就将其破坏掉……！！",
      "source_fingerprint": "771ff65e75c2cbb4cbdba712c257dd3b10c876ca84e02d5aab87e15d53182dab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:a5c445512a216338e2a3ba49",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王接受了现在的自己，\r\n再度在海滨驰骋起来。",
      "source_fingerprint": "2e2ab905d8035b3a13c92eb2b14c7cae4827b7ff4bef0532ed4591967037dd0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
