        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:464f3959f6e3d28d342be895",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我已经不会再畏惧现实了。\r\n就算要承认自己的身体已经脆弱不堪……\r\n就算要不得不选择破坏掉什么东西……",
      "source_fingerprint": "6334828859a872b484d3506c28873409003477d2be46949f7def569f30f7850f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069301.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
