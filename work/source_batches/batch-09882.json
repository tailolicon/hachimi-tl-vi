      "source_language": "zh-CN",
      "source_text": "……八重同学。",
      "source_fingerprint": "713ee9a4421a58ecc98b6a1e57eabb8208fa7b7bd16841d31269636421a966e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
