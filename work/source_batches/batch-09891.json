      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后过了数天——",
      "source_fingerprint": "3db50e058429621a18c46cd2346ef2001ea167fc8032b5298bb24824edf9bb30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
