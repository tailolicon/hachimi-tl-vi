    },
    {
      "uid": "zhcn:73a1d4813fae4c93e8135384",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王",
      "source_fingerprint": "ec59744d588a1310f2984a7c0c6f87f1b1077dca51cda1c301578865155b5c9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069308.json",
      "json_path": [
