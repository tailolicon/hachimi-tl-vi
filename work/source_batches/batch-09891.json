    {
      "uid": "zhcn:1bfba371a5236acdef5354ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我其实稍微思考了一下哦。\r\n我的起点，是『德比获胜』——",
      "source_fingerprint": "9e2972064e44a5874184763400b51a0cf090b892b29403a4f9453baa089ac192",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
