      "source_language": "zh-CN",
      "source_text": "在胜者LIVE之后，\r\n紧随其来的竟是救护车的警笛声。",
      "source_fingerprint": "397be4d910d61231e4f24cc28ed6feefbf38c43e84e758baabea32a65c63f307",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069308.json",
