      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:ce25e7f5d203e738041019b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在目白阿尔丹乘着救护车送往医院的路上，\r\n千代王一直面色铁青地握着阿尔丹的手，\r\n不断呼唤着她。",
      "source_fingerprint": "4a8bb0c329c645ccf6daf0b156881f09ed827a39dde079e8b4d1051d5564258f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
