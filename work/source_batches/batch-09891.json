      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "阿尔丹小姐……\r\n目白阿尔丹小姐倒下了！！",
      "source_fingerprint": "684e458a338dc7cd157d2fe2278eca4ea064fcf4b386498591d7ada2e33f5cfd",
