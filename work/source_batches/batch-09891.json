      "source_language": "zh-CN",
      "source_text": "但是不知何时，\r\n我也将『不想输』的信念也加入其中了。\r\n这份信念让我奋起、不断迈进……",
      "source_fingerprint": "43f0078219264346ed40b0f64bcd77db04c095160bae2d6aa2acbe33897668b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069308.json",
