      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——但是，现在我不会这么想啦。\r\n这次的『日本杯』，看来会很享受呢。",
      "source_fingerprint": "721eabaa23910c512b260beaa509f64b43508255669013048d735c2b83cf5541",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
