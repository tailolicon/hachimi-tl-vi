      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在医院的治疗和家人的关爱下，\n即使将老家的榻榻米磨得光秃秃的，\n她也会坚持继续前进。",
      "source_fingerprint": "489c5e272800203ccefd7994cc8ed95282ccac726097c83fc34b6686275ee21c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069402.json",
      "json_path": [
