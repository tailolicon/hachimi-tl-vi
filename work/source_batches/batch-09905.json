      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:08e5cfdabb7e57ed6bbf9111",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王的巅峰期有可能已经结束，\n开始走向竞赛生涯的终点。",
      "source_fingerprint": "1bdf72945ab632520a0bbe9ba911732d280698d80cea64cfa377a064a224c5b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069404.json",
