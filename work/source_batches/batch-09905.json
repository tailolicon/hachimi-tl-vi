    {
      "uid": "zhcn:b0e6c1db804e0e94bd0de81f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "丸善斯基竟然主动邀约\n樱花千代王一起来场模拟赛！",
      "source_fingerprint": "091f0beb9c650939c35d3013ff0f072a1df0e942db9b3aaf785ee20cf848639d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
