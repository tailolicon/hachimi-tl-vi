    },
    {
      "uid": "zhcn:d067c67204eef57d5bc61d90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，樱花千代王开始有\n“懒得吃东西，身体很沉重”的感觉。\n这代表──",
      "source_fingerprint": "652a6458c87b970b8d78b4106a6215d4814209a9e817065505b39dd74fc1bb41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069404.json",
