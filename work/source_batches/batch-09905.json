    },
    {
      "uid": "zhcn:506b8d034636f2f78232ba12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069400.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:e97f4548d29c90bdb5535159",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为此一定要赢得德比，\n成为实力坚强的赛马娘！\n樱花千代王迫不及待地开始冲刺。",
      "source_fingerprint": "03a348d9fe03622ba209d1dd96fcab77c601a5f1a70edc2585862d17946d23c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069400.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:f4aa86b678a56914a9e79c93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王登场！",
      "source_fingerprint": "90429ca476b93d4b23c7a8206c92332a98f798b5c7f18596a6f1620dd7e58277",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069400.json",
      "json_path": [
