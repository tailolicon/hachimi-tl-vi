      "source_language": "zh-CN",
      "source_text": "居然将我们苦心积虑的提案弃敝屣，\r\n任由自己的心被对胜负的渴望所吸引。",
      "source_fingerprint": "67614ea61e9d1aadbc77d1e9417af973cb85190ba4df1596f4146bf33495fa69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
