      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她开始渐渐地逼迫自己，\n瞒着他人自行训练，\n结果导致脚部出现异常。",
      "source_fingerprint": "9940a39c4a9b30f4a45081f16cffef713bcf8ae1575288d98b1004a7ac707c34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
