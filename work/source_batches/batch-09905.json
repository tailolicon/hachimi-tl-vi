    },
    {
      "uid": "zhcn:277ae7604cdb0cc4b662d6ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“用这双脚走上崭新的榻榻米”",
      "source_fingerprint": "a5f5f4003eebb80190f90cdbdec144fd1c6d8e217e92dcd08bb809bb32cf3a89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
