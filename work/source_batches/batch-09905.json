      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员带着想隐瞒症状的她回到老家，\n让她在老家专心复健一段时间。",
      "source_fingerprint": "d6c3b88ac30b584bd5b8511d2077e52f8b0be2d5c0e017b1bc3f09e27bf23ecc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069402.json",
      "json_path": [
