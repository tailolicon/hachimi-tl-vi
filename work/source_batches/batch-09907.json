      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时千明代表的身影\n却出现在亮相圈上。",
      "source_fingerprint": "00c91b63a887be67522def932d973a0e0a35ac0535e8936d7b2f99c76c73c4cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
