    },
    {
      "uid": "zhcn:0bca7ebded5aef40cb1a9f62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表与樱花千代王的对决\n即将开跑！",
      "source_fingerprint": "f7dadaaf357d26abc99910a50833678c539079ae11978aed05caa3b87b514b10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
