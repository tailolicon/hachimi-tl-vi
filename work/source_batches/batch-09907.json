    {
      "uid": "zhcn:e5671a8a50e7983364c5451e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王坚持跑完比赛，\n她开始能够掌握自己的课题跟武器了。",
      "source_fingerprint": "c90e470b05bc1a3654c176b6982a17e1d703021c59dec97fac505300d6e52a20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1069/storytimeline_501069418.json",
      "json_path": [
