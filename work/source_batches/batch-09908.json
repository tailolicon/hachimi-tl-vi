      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "中距离路线的“宝冢纪念”",
      "source_fingerprint": "7ee6977c0388695d6d05a253035967110a58adc9d4d7bd0e368d3fcb44796535",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
