    {
      "uid": "zhcn:1da1a33b92432cb773dfc1e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实，我小时候也是这个──\n“胜利俱乐部”的成员。",
      "source_fingerprint": "cbb3874368e93ca7f94caaca9c71a90dfc31285d4785e0f092fe0cba3e1d1353",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
