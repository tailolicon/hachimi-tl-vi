      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以这次他们才会来拜托你啊……",
      "source_fingerprint": "d0ace78f81cac4c100255e81c1aaa69321989bb50436e1cdfc81fcc4f587824a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
