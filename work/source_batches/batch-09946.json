    {
      "uid": "zhcn:1934649c14a9bc695cabaa56",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她一如往常摆出要找人吵架的态度，\n我露出苦笑并跟着她来到走廊，然后──",
      "source_fingerprint": "fa9fbfbfef2be39bd6edaa5e74f31788c76e9e577c3ef695184059e43c4747c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070101.json",
