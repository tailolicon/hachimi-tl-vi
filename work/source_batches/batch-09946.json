    {
      "uid": "zhcn:39e9f889124673f6f5ca5b97",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真是剑拔弩张啊。\n鲁道夫明明那么出色，为什么……",
      "source_fingerprint": "9e816621d18c44955b278f74285953e4e9a794fe1943495122c11fd040dc9d46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
