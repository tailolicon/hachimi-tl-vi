      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:c8a615eedac9ead362e3bf5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你看到了吗？她跟鲁道夫象征杠上了……\n看来传闻是真的呢。",
      "source_fingerprint": "e4f763d8dfe4a956b936e2a61f86dc13cabd469652b33cbd60ee6d78e0cf1220",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070101.json",
