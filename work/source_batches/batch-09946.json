      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "戴黑框眼镜的URA职员",
      "source_fingerprint": "5657f7c17aae11be30507d16aca17e272fd02cd3b8ee1232449401a0c2ab910e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
