      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯，说得也是。\n我会小心的。",
      "source_fingerprint": "1019727c66063c97d5f2812cd61d796f727638ec922d87627f026205c6742562",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
