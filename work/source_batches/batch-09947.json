    {
      "uid": "zhcn:3d3c8cac99a46162fcfe80cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然语气严厉，但接受她精确的指导后，\n我的台球技术稍微进步了。",
      "source_fingerprint": "77c5973dda816fb35e01e0aca765be5915b7f716c014e3f887a8cf122a51a65e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
