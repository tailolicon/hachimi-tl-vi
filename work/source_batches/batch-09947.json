    {
      "uid": "zhcn:512e333320a8fedd568d72fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想必今年将会是关键的一年。\n我希望和她一起\n奔向更高的目标！",
      "source_fingerprint": "eab8932f261561e5ea396d946cc757426d92bb3d67252d34eb751dc462b2cbbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
