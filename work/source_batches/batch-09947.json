    },
    {
      "uid": "zhcn:2377992d4fc54b2479042027",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "过完新年没多久，\n就收到了来自URA的新通知。",
      "source_fingerprint": "7624d77adbb38328afb878a5e81a01b7a11d27c39939517f898b0acec7d08be1",
