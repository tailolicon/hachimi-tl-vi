    {
      "uid": "zhcn:11f655a23cff1e38407af8e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最重要的是你太用力了，\n肩膀用了太多不必要的力量……换我来。",
      "source_fingerprint": "48b2ee15009d40c5082c0c6b163cbe83ffefed9bc1e1bfae1de46995c5b349ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
