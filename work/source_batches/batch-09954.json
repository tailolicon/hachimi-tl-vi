      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总有一天，我会在隆尚的天空下大放光彩！",
      "source_fingerprint": "c133a66ae19dc641e58578cd01f3821b57ae96a924d93dae5a9614121a49ba57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
