      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:94a8677792ced9e6ff638c60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着，天狼星象征似乎想引起关注地\n大声地说道。",
