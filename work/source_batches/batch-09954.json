      "source_language": "zh-CN",
      "source_text": "王牌的粉丝",
      "source_fingerprint": "d957de3605eb5ee167ae2885e9882995816b475966ad7be64da33df671cb8c36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
