    {
      "uid": "zhcn:eacd8267d4a08cffe83ded5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不会将自己局限于国内，\n我会超越世界上所有的赛马娘──",
      "source_fingerprint": "81f4dfcc0327c974220a339abfd7a86987712e2998b1cd8bac46d7119aea51c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070108.json",
      "json_path": [
        "text_block_list",
