      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉今天会很热血沸腾呢……！\n请多指教喔，天狼星！",
      "source_fingerprint": "672397c413156bc480ee4fc8d38c43322d7b54990fe3b9b4b920575af7c20abc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
