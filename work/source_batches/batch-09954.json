    {
      "uid": "zhcn:d0fe2c26c8e55bb96d26ea4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你。\n我也觉得能跟你们一起比赛真是太好了。",
      "source_fingerprint": "8131202090eacdbef19de51e51e4408b7034e69ca8c52b5c2c698e79da58a64a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
