      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:c20959dc566e4019a2241784",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她强而有力的宣言\n让观众席陷入一片寂静。\n然后，千明代表和葛城王牌则是──",
      "source_fingerprint": "572e96577b44b40310a285cbae85ab6ecdeabfb2d641c91a8c2b4553d26ba60f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070108.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:82c53d2ac7e54427e277614c",
      "kind": "story",
