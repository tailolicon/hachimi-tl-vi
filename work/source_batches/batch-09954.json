    {
      "uid": "zhcn:9a0105534e0e8775c00ef18e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，这位带着好胜笑容的人，\n就是从乡下来的热血赛马娘──",
      "source_fingerprint": "99d8d05b2c5dd2671cebd5ec22ec32b64a2d1a5c9bedbeaa1402da8ebe938694",
