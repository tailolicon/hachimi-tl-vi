    {
      "uid": "zhcn:9b75b2d940c09bcd6bd37dca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我是会称霸世界顶点的赛马娘！",
      "source_fingerprint": "6dc0807e2d0baf59ffb0d170d6df27076d6e0a50b7d4ba8353a2f145a5ccdf78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
