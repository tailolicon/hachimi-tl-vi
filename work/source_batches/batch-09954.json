      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔，好厉害──！千明跟王牌还有天狼星象征，\n她们好像在谈论什么呢！",
      "source_fingerprint": "4a24d7f7b45dff7f1ecb920e0c8ba6074ae74af129e56c99a28e6db166ef7d10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
