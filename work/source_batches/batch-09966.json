    {
      "uid": "zhcn:703b8b067cc6e9737bd367df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──不过……哈哈！\n你那像野兽一样的眼睛果然很棒呢！\n我想紧咬不放，想让你感到害怕！",
      "source_fingerprint": "0cb3ee9defdefc2bde7770c8713eabd0fbbfa0ef1ee5461049b473f46ebf379b",
