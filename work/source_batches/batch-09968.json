    },
    {
      "uid": "zhcn:5851e1505bdd03f2a833956d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天的她根本无法集中注意力，\n所以──",
      "source_fingerprint": "ebb9fc2d1c8e55f111973b2c82d5336198e9a4645a2d332d8e59d0fbe9206287",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
