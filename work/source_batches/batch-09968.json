    {
      "uid": "zhcn:83c40bd9b9285a93f807055c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你会让人跑两次德比吗？\n会因为同情就让人再挑战一次吗？",
      "source_fingerprint": "4729ed45ce66b815e7778868be13cd7c0cd05e33645b106ea0e28125fc44be1f",
