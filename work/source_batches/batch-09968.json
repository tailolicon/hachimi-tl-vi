      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（现在先冷静下来，做好该做的事……）",
      "source_fingerprint": "0d3b0a5125c1fb42c9eb694a3f520572f4a2d14b798c1700b44b3af14e75a38e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
