      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:c39b50bdb56b3ec46b5427db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回应我的是一记强劲的踢击。\n墙壁被她踢中之处\n零星地掉落了些许碎片。",
      "source_fingerprint": "8930bffbda37b990baac5e779c62a5d7f9bcf0bbbe6daac4572eefdc4da92c31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
