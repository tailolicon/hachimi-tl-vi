      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:8c7991d8b9f7b7b60784e1f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说到赢过天狼星象征的手段，\n那就是平时的台球比赛了。",
      "source_fingerprint": "4116784dad7e9bd8d0e8be754c1c041fcad1e6f16c936e9b5ce4b3af76e14869",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:e8e514a07ba71f5e2583885c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "周围没有任何人，\n只传来了沉静的背景音乐。",
      "source_fingerprint": "5776c2562c8c5c9f3430891ba176a1b8e8d2d8f15b53855900a036509ddccd99",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:8c93c03b672233ab9dbf4aef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
