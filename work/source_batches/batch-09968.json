      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "少瞧不起人了。",
      "source_fingerprint": "683774173a2d748594c97a438b1ea9c3d3f91e314cf8677e84cf9f2c67692758",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
