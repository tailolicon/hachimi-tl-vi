    {
      "uid": "zhcn:2edd25918c72c10cf621dc65",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果她打出组合球让球直接进洞的话，\n就是她赢了。",
      "source_fingerprint": "401a513aa0803794ae785234168c008416ee4337d3f743db76334c65abee7165",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
