    {
      "uid": "zhcn:8184ae1bfd3a278ab87440be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她转身离开，看着她远去的背影。\n不安与焦虑感逐渐增加──",
      "source_fingerprint": "0c278f1219c03a638afc73940e8b9c669cf296accd99f4787b501c5e51412d0f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
