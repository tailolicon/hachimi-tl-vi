    },
    {
      "uid": "zhcn:6a6e56aa692dbb5199df83bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……可恶，吵死了……！",
      "source_fingerprint": "4f160f426e374f5d8e4b3f4421f7d5fb5629b861b99e204da13a74d0f8ac5005",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
