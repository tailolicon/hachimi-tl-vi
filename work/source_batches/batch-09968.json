    },
    {
      "uid": "zhcn:8956d5b4e252c7a9e26452c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（糟糕……！）",
      "source_fingerprint": "6263b8ccf5d7f830038db9b8defc098c7c4a4e316763981150954d298195346c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
