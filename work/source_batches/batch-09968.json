    },
    {
      "uid": "zhcn:439b6507053adbd1a42e4db8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为要是如果不做到这种程度，\n势必无法阻止她。",
      "source_fingerprint": "7d45f21111843507e8b7a227b6a4352fa53d7745f689f5f08fdac59256f5c43f",
