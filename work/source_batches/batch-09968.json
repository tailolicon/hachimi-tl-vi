    {
      "uid": "zhcn:1980f0e39cc069fb9c08ddec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "………………啊？",
      "source_fingerprint": "1190c09f2d4d878e0d3820f2d396c2b6b2b3334c1aa5f2cd0529c9fc9e734c74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
