    },
    {
      "uid": "zhcn:982f1baee1cc96f6579d7dfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不是在说你。",
      "source_fingerprint": "0e1abbbefdce01ad25bf1a72b7232904363e44b0e1f58874168927d0450707ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:3bc74f353b5e3bf095cd47aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征看起来非常烦躁，\n然后拿起了球杆。",
      "source_fingerprint": "1e5c53c2444d3d8c11ba9ddc426bdfabf20c256650a7188f025e76a48af7234a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:2639b8d4c73a30253d7d4418",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然需要一些技巧，\n但这个局面对她来说并不困难。然而──",
      "source_fingerprint": "c10b51711c5cf1d5dd0cb81ed375318a80b0da371777118db568a5d0e985cd74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:2a3864e0704265416c3de992",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
