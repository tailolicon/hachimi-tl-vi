      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:ae6be9743a95f2e7e417930b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（锵！）",
      "source_fingerprint": "0d7247c9b5c7c7571698af33292669d9293a3112d018f9cd62faf4b892ca12b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
