      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还不清楚事情的全貌之前，\n我不知道该对她说些什么。\n不上不下的安慰只会伤到她的自尊心。",
      "source_fingerprint": "7a460ff63feb5a84e66a13e633d71d1e07071dbf7ce478383909621806aecbba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
