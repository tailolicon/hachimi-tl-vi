      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以她才会说服自己“没有对战的价值”，\n然后避免自己去正面对决。",
      "source_fingerprint": "469b83a232ae21de6dfa63f4fd471b041d0fdd0d7ab8ed484623f4ec9d4544b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
