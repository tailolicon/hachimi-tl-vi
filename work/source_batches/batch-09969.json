    },
    {
      "uid": "zhcn:f238429628349611b5b9a919",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "仿佛掉进洞里一样的失落感、孤独感──\n还有忌妒。",
      "source_fingerprint": "dc746e8b9bc72301510330cdf39a34b0957471d9a68b66cbe0650497fef80d6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
