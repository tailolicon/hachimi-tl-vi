    },
    {
      "uid": "zhcn:d374de739af6d09b464850b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星的跟班B",
      "source_fingerprint": "e23d355bce40799e78a221aa72b507e077ae74438545979946b631de60a67534",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        46,
        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:75d8c83a15971d1e1a28f4ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……就是这样。\n当时我听了就觉得真难得她会这样说呢。",
      "source_fingerprint": "122ab48be6e65bf939393aff611699eb2a0d688f1418537e6396d9c8b6ac5294",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:4b7eea4e7d21b1832d771e64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来是这样啊……",
      "source_fingerprint": "58ab5cabf61e5b25d7cc741fc609d6877544da0fce67f8dd50fc4bda87314262",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
        47,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/47/choice_data_list/0"
    },
    {
      "uid": "zhcn:6bf7a9ffe4af62529244ee17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来是这样啊……",
      "source_fingerprint": "58ab5cabf61e5b25d7cc741fc609d6877544da0fce67f8dd50fc4bda87314262",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070116.json",
      "json_path": [
        "text_block_list",
