  "entries": [
    {
      "uid": "zhcn:1cc043ec512a15fb6d2d3700",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……更重要的是，要是能跟那个人一起\n大闹国外，应该能看到有趣的景色吧。",
      "source_fingerprint": "e5d1dce87e80bb119159fdfe9bd26836616f21c5bc0172851afa6e16c47b2fc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
