        66,
        "text"
      ],
      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:06b22b4bd8d598681a9cb827",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本该强大又勇猛的自己，\n却有着不该存在，如烂泥般的“感情”。",
      "source_fingerprint": "adc3589c47a39786b30da54a94aef22b58ae405fd846b0e7aa1ff6af55c7a02b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
