    },
    {
      "uid": "zhcn:a6ac040670dfa11578cd01c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──这种感情很难面对。",
      "source_fingerprint": "f0d34a3708a73ec8dee6c7ed786f25c83a7993b71105765263afd2ad498eee54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
