    },
    {
      "uid": "zhcn:3184134bb0b0a563707aed39",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070203.json",
      "json_path": [
        "text_block_list",
        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:ff5cdc0710059e13a29475ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──不过，这也就到今天为止了。我会让\n“那家伙”从所有人的脑海中消失……！",
      "source_fingerprint": "9f83236a1c00169fae9753c2f0537d26bca2e9751e7e3936717b6f6c54ca9c2a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070203.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:5b319e66e3d80a426dc9b22a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她很有干劲呢……！）",
      "source_fingerprint": "ded5553bc5f7749da2a92f2a7ba817e12ee254991df28cac72f08c24d1bc9f3a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070203.json",
