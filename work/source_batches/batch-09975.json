    {
      "uid": "zhcn:deb335a91b43bbf9f46dcd8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的梦想是有朝一日进军国外，\n成为世界第一耀眼的赛马娘。",
      "source_fingerprint": "7c2ee081af839cd73fc4322655d76e5cd6266f2a38de452ddb72735f77cc5df2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070203.json",
      "json_path": [
