      ],
      "json_pointer": "/text_block_list/13/choice_data_list/0"
    },
    {
      "uid": "zhcn:0eaaad740e3e494b1f9f7851",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "去赢得胜利吧，天狼星！",
      "source_fingerprint": "6bb48cde07aa77e60d4df822d4e4cb3a7ac4ba2309aae277e807cf2a63a142cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
