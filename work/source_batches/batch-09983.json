      "source_language": "zh-CN",
      "source_text": "回答呢？",
      "source_fingerprint": "649b97ee8d29c47c63de8a66813d7b2147af28a361035868040c730be87f897d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
