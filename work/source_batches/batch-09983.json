      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想超越她的战绩但不想正面对决，\n这让我觉得难以理解。",
      "source_fingerprint": "7182e08ef6df3b6430fe194c38068b0381bd20475730f325ffaf2311e9e34cbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
