    {
      "uid": "zhcn:8d4ebe84ec8c3e85bb15cea4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她毫不犹豫地拒绝了，\n这让我感受到难以形容的异样感。",
      "source_fingerprint": "e663f2e1db71808fa6a71e9d75246bcb815585b26137eabd220171b92476f00b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
