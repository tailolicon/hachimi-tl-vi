      "source_language": "zh-CN",
      "source_text": "……我知道了",
      "source_fingerprint": "55c2250d7e1fdcdf10f6797017c6148a40c441be3806eaacce9db93da844abe0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
