    {
      "uid": "zhcn:66df6c5679e78491f7803f00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这么一想，天狼星象征之所以\n提议这个参赛计划该不会──",
      "source_fingerprint": "b5f1af2e6ae65f2c27561136c2d573840058bf0e0e6e0955c22ca83c568b1d3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070303.json",
      "json_path": [
