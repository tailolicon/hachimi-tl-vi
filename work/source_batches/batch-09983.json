      "uid": "zhcn:c5459872baf57763828c65bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我拒绝。\n那家伙没有这种价值吧。",
      "source_fingerprint": "d3c0af31c6cff8365f6ea4684b33c5d45176d38444b170e22e7427679b5375f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
