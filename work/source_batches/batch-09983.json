    {
      "uid": "zhcn:a5e8e892086164c1e4ecfa1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我订下的就是你的规则。\n……如果想反抗就先赢过我。",
      "source_fingerprint": "c2d2fce83e797480b910c5bf637fb2579e591fc42cb7eb2bbd888c5faae0ecd2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
