    {
      "uid": "zhcn:c515bb96f34305500b2e0fd0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "别忘了我们之间的主从关系，\n基本上你处于应该服从我的立场。",
      "source_fingerprint": "940202b079656490ea19d1ab56c29faf23d8a87fec25e3ae4dcf40473d26e48b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
