    },
    {
      "uid": "zhcn:c7c7719af39db24f0bf9da69",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许她们之间有着超乎想像的鸿沟，\n因此才会产生“没有一战的价值”这种结论。",
      "source_fingerprint": "4dd02863e4f5616f7333823629d9cb9686f39c8df39fa000bfbd74bb45be9547",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
