        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:5238ebbfc6f115c9f9591fd4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（是想追上鲁道夫吗？不，可是……）",
      "source_fingerprint": "a0bbcfb90188cd6a6b8f848f9586e400bb70c01d789a2408a62786ef67ddb99b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
