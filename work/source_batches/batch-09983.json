      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道了，一起加油吧！",
      "source_fingerprint": "ea077f0ed04218a12de9dfffa019e7df6d15b51afd46d00191d14c4273fd2d25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
