      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:df5c0ff97a86bb5231c135e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
