      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我看着她转身离开的背影，\n突然想起了去年的新闻。",
      "source_fingerprint": "63ddaa80dc040ed82b1229fefc86b83f08426d4a0cadc12c0b84df367ebc2ddf",
