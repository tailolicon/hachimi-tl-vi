    },
    {
      "uid": "zhcn:879d5ed1c175353a0fafabe1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好好记住这件事，训练员。",
      "source_fingerprint": "718791e55b10a9b8470760b29439b7be1a4d16de0c9eb898ee60f6f14d7346dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070304.json",
      "json_path": [
