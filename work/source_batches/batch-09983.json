      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个目标是“皋月赏”。\n明年要走经典三冠路线。",
      "source_fingerprint": "8c8f3a8abe44047d1a680a71c119898c54a423cd1cf8e21a9360edd5f4677395",
