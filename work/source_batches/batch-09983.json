      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──天狼星象征展现了\n惊人的跑姿！",
      "source_fingerprint": "e8c0235792688da2ea1e6d4bf1a842f3246209e50c597bb784a48daec262f026",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
