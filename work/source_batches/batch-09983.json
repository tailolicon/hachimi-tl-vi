      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
