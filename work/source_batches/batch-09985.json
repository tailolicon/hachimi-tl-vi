      "uid": "zhcn:58cc44c6507fefeb81e12a9e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎呀，因为我想尽快跟你商量！\n那个──",
      "source_fingerprint": "52ad0347acd8d1ed078098d9735fb78f4039bf0166414111258971e5bb6cc67f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070306.json",
      "json_path": [
        "text_block_list",
