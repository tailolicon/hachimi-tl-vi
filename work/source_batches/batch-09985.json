      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我再次感到一丝不安，当天傍晚──",
      "source_fingerprint": "c6c347aa80637abf04e92afc04325099f0a68cf4e3285c1ccb6cb1a779bbf329",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
