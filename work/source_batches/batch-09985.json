      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……唔，吵死了，吵死了，吵死了！）",
      "source_fingerprint": "a9d3dc44f33de9fa588f540fae2767dd27351499182776cefe54932ff295f897",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
