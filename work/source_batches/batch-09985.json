    },
    {
      "uid": "zhcn:12d0c4bb9e8b51940c93ea89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到她稳定前进的样子，\n我也因此感到安心，不过……",
      "source_fingerprint": "62590f61a1df7ec241ef9239b80e82980e9dec0317a4c2e2241716b98130e553",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
