    {
      "uid": "zhcn:0f644dcc46e3413880abbbb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你愿意担任鲁道夫\n去国外挑战时的随行人员吗……！？",
      "source_fingerprint": "1bcdd623fda14a32287508cd3370961cf69d4e4ef62c2f45d6ba1c280fd7cc27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070306.json",
      "json_path": [
