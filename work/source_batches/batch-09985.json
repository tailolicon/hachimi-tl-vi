    {
      "uid": "zhcn:6a7603c317e5dd71283a1ba9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她赢得了“日本德比”。\n明明已经站上同世代赛马娘的顶点──",
      "source_fingerprint": "2553bced1b4c86b3cacb90868044f2cd9e21c277599b1fc1a295a986402fdd5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070306.json",
