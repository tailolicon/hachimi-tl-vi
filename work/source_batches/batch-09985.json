    },
    {
      "uid": "zhcn:77ff26781b4a1af2030a6435",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“她对鲁道夫象征的感情，\n只不过是其中一个动机而已。”",
      "source_fingerprint": "00c3f48f5b1a13b71801a85a4aef07ef8b41bfcd3a28502496dc2e8e395b70bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070306.json",
