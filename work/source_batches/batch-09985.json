      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一定要获胜。\n我要获胜──然后涂改这一切……！",
      "source_fingerprint": "91a338ed518c9a3a9d1a7b0c051bd7ebd8f0ef5642907894237c22c6c2092b80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
