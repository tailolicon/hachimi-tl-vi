    },
    {
      "uid": "zhcn:2ebd2339be94b2cf8755ca0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没想到即使才刚获胜，\n她的注意力还是全都在鲁道夫象征身上。",
      "source_fingerprint": "6cbf75137c7384c93717a3c23a44198776ea1f47ae660805ea4cb96eebcf93fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
