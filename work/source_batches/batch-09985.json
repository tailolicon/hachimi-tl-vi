      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:233a887ffe020c7dcdbf9cb8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "！",
      "source_fingerprint": "631157c15452e8cefd925437a26f1d016b1a5d7575f9234fd0bf7aff0369e63d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
