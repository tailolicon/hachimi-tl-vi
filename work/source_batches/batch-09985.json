      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "URA计划委员",
      "source_fingerprint": "800fb67b0f73336567bc60cf8aa31f2b8c6700e5641bc56dc3ced7376151faef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
