        0
      ],
      "json_pointer": "/text_block_list/36/choice_data_list/0"
    },
    {
      "uid": "zhcn:29dc9599910dd3e6e8cb70e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然说不是主要人员，但也有机会\n参加比赛……还有最重要的诱因，\n就是单纯看中可以借此探勘场地。",
      "source_fingerprint": "71df0aeef07c134999d96b6b6ec7a2e401d7eb2407914249e3899eb98f0be1e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070306.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:c878a56355c4c7a8177b3190",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "更何况，不知她的自尊心是否能够接受\n担任鲁道夫象征的随行人员这种立场──",
      "source_fingerprint": "d3b52cc5b8df1fecbd583a43013186770bcf6bb578c5d53ae8d6b4d40bfe0967",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
