    {
      "uid": "zhcn:bbeda879f3fba16b759dd11c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我才刚回到家，你就这么着急。\n……有什么事吗？",
      "source_fingerprint": "80724534525d70429ef4246dcc2546f0649bdb7f7a80513f84af4f4a09707604",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
