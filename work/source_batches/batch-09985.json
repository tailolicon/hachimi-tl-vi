    },
    {
      "uid": "zhcn:5ecaf57ad219156e1f33fe5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（是我误会了吗……？）",
      "source_fingerprint": "3bfb39a5a3b22caa1221f2633dd36bbbae83dcad56fe158ca8d279bd632b868c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
