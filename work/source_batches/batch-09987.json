    {
      "uid": "zhcn:00ecc33603447696a6655ee4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接下来是“有马纪念”。",
      "source_fingerprint": "99fb50c7abcd1f961f391f25fb57d71a4b302ec457cb4a24d0dd34f868401807",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
