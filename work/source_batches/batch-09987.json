    },
    {
      "uid": "zhcn:ab5eb429fc057cfb04632436",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会避战只是因为没有价值，\n就只是这样而已。",
      "source_fingerprint": "dd8005f352c8db82f147d9f8b6cbc8c920ec320f8b076077f19ecbc7bd1c97d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070308.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:87f8f5ec563e9edeb2d6556f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070308.json",
      "json_path": [
