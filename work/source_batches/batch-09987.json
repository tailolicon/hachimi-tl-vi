    {
      "uid": "zhcn:1ca4d99ee4917758a54742d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……抱歉让你担心了。\n但是我绝不可能觉得“寂寞”。",
      "source_fingerprint": "f88779d40cf3c724aa848b8c0a9fd8abcd7afa21768b00651a1829a0d402273c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
