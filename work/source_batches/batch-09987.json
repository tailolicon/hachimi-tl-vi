    {
      "uid": "zhcn:f063d169f58b3b4ce884e0a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会证明给你看。",
      "source_fingerprint": "e70939b0d058fe47d6c9b2e569bbfbd78a3631a71406d24630a517da00748131",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
