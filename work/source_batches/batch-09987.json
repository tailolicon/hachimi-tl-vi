    },
    {
      "uid": "zhcn:706b7ca381503a4e16d89e04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……果然，\n看来她真的看过那本笔记本了。",
      "source_fingerprint": "6a1321d1b53fe0fc74b56e5f495cec33e5ffba9a411a329a08d3e91eed105d51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
