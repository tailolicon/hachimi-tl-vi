    {
      "uid": "zhcn:47c890a104121fe74af28f40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道你脑袋里在想什么，\n你在想什么，在担心什么──我全都知道。",
      "source_fingerprint": "56e22f55953cebe6b3fdbfa76978981e526a81961cc30f60cdfe7636e89e3ea6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
