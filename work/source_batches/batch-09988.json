      "source_language": "zh-CN",
      "source_text": "她的热情让鲁道夫象征\n不禁嘴角上扬──",
      "source_fingerprint": "257aa141a8c6419fe1516c3da2f383c15f397440f585d70811e6c5146bf6bfa4",
