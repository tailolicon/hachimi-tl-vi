    },
    {
      "uid": "zhcn:489b3a9d0c3a41b91c03f1b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我正感到不安时……\n走在前方的她突然停下了脚步。",
      "source_fingerprint": "96ab9b2d8a5dfd9de37a5f5f289b1803934647077b2803872f4f71c07d44cd83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
