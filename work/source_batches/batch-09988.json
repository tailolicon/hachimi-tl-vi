      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她没事吧？）",
      "source_fingerprint": "868fd1e094d7680930bd679d23c4c36a74d4a526c6807c95eb41f6f60ac338b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
