    {
      "uid": "zhcn:9c08f184ac718ab907acc6d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征在“有马纪念”上\n跑出了压倒性的比赛。",
      "source_fingerprint": "29a5e161a8328670fbe80d2cd8460a0e86810400390557df33fc10cd7eff9930",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
