    {
      "uid": "zhcn:4bee7281aba8fb174d26198a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总之先拿下“大阪杯”和“宝冢纪念”──\n要确实地在大型GⅠ留下成绩。",
      "source_fingerprint": "61e3dd5cf4192fb72e98141bfa7131c84357677127f857a4b856e649eb1917e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
