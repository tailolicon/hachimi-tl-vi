      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她还好吗？）",
      "source_fingerprint": "5da91de23d1031e79c3ebda49b4c1ce684a01517aeb5e65759213e415ab06502",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
