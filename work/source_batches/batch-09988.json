      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你的意思是──",
      "source_fingerprint": "f96974388fdb192c6a8a29043cc69d27cccd12abef634833d17019011bde5f97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
