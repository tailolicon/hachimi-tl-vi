    {
      "uid": "zhcn:7e705f8296f5fa877ccb5cc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……但是，当天回程路上，\n她表现得比往常更加沉默。",
      "source_fingerprint": "97756aa5c3f1c1a2dfc61c6ab77524855967073342399e2e9a0e48f6be19fce7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
