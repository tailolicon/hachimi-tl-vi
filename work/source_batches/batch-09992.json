    },
    {
      "uid": "zhcn:d501f9f845e25ca0905ef0c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "年幼的天狼星",
      "source_fingerprint": "02a2a135d09669b2249dd333a8f7de97544f7b7bab6e485c55e98998a1a97183",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
