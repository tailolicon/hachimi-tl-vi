    },
    {
      "uid": "zhcn:c445f08c628a85b8438a2c78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后，天狼星象征\n再也不曾多说什么，但是──",
      "source_fingerprint": "316447e56c199a26271b73b7832be4ba4c9570dc32b7354ddfdf22493ab27a1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070311.json",
