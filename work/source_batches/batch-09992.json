        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:df37e606c9ef2dc840a94ce1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她似乎已经确实地取回了那道光芒。",
      "source_fingerprint": "d2db7639d1e634837cfeee08756154fbe8f13875420b1246262272270016f871",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
