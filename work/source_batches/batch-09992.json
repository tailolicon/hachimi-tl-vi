      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──那一刻，某个画面──以及记忆，\n浮现在天狼星象征的脑海中。",
      "source_fingerprint": "6e68defd697acc261496518bf694e7071a290f169b652f848c87268519293102",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070311.json",
