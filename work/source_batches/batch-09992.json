    {
      "uid": "zhcn:00cc2e252c9085d3d55080e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如同鬼火一样燃烧的眼神，\n仅仅一瞬间就牢牢锁定天狼星象征。",
      "source_fingerprint": "98e1449918c38b287c2a0f75637fec0a85bf0d9836046ddba2f82c95031b6392",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070311.json",
      "json_path": [
