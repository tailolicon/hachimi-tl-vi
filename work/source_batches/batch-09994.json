    {
      "uid": "zhcn:a384f9398c032f0fc42ded1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……经典级时，\n她曾因迷失自己而发生了很多事。",
      "source_fingerprint": "65ef92a69c2b7bb1b6651f8669d6d23bb80c147e76c648688a3b56219d271a3d",
