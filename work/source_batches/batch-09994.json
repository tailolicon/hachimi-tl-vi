      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么……就暂时到“日本C”为止吗？",
      "source_fingerprint": "328548f93c5e21b4dcaa9a6b69590c045cae0b7a3a5ddd0bbe199c5c236d02aa",
