    {
      "uid": "zhcn:69a130fa0e5afcc60df08d5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征退出第一线，\n转到幕后的新闻\n让世人感到相当震惊。",
      "source_fingerprint": "3691c1cec88d50511769c548f1422fc238ea00bae24c46903d28c7dabca5e86e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
