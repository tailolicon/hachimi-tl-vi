      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:79d9f5e2e47fed2a6f9d5dc7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070406.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:fc525ae84509b202b3bf3a0f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，转到幕后的鲁道夫象征\n遵循自己的感觉向天狼星象征说出\n“我想跟你再跑一次”。",
      "source_fingerprint": "fc24a702982161c60d3495f96809f4de3fc158e42aa67072842cc01be1849721",
