      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不失去自己真正的梦想，\n她需要在下一次“菊花赏”之前\n重新找回原本的光芒。",
      "source_fingerprint": "ad9c9348d78fa78a8dfc69e28391faf8d59243d31998045ee1f03bf0e4451c65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
