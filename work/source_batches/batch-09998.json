      "source_language": "zh-CN",
      "source_text": "天狼星象征不想以正面对决，\n而是打算以涂改战绩的\n方式凌驾对方。",
      "source_fingerprint": "ed363549942f6c876eb42185f7f4990cdad9e93c6874439e1f332033b36c4354",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
