    {
      "uid": "zhcn:78ccb77e50bc69d829e11fa8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以我这套为例，整体上与遵循\n正统“现代古典”风格的“现代英式”\n形成对比，采用了独特的意大利风格。",
      "source_fingerprint": "cd74698d2cceea549b6ee0140c57142d017f2e5638ff63186732149622b7fdab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070513.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:c7c8d7ac2792057335ec0f00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征",
      "source_fingerprint": "6ec317440b52f89fbdfad76110a7afc3ac55b01c91d67997968e5ba969bc9ea2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
