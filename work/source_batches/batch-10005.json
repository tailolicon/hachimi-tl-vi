    {
      "uid": "zhcn:dceac24c662745d830cc77f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的决胜服也跟西装很像，\n应该能获得一些灵感吧。",
      "source_fingerprint": "9e724d8e5a9f36bc6ece9b911b526e772a565bf51c51c4d201a666b912965129",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
