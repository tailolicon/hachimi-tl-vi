      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认可你虽然无知但还是拼命挣扎这点。\n──特别为你上一课吧。",
      "source_fingerprint": "bf1fbe38910bf50ab3180770d08fb78e4e1c5d973783ed40d7a688c752999c73",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
