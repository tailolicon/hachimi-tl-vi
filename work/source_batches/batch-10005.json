    },
    {
      "uid": "zhcn:4d51768f1ece566e9c8b44ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──我简直不敢相信自己的眼睛。",
      "source_fingerprint": "793248cd8f684c8fccc33ffa22774cd1eeb3bd76e5ca02ab51ba7d9a9c8bd213",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070514.json",
      "json_path": [
