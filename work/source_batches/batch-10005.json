        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:5bac47dc6b3dd1ed9578d875",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而我也不想要过时的款式。\n所以西装裤选择了“无褶皱”还有“低腰”，\n打造出简约的线条。",
      "source_fingerprint": "cf5d94de04661a745fe586fcab1750fd686f2cbaa79955713640e052d69ce062",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070513.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:558abab61896f60714975ddf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔喔，原来如此……！",
      "source_fingerprint": "949ce355caf250df779dac0fc7ad60ee0878bf01cadef36b2241d8ff4b45b23d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070513.json",
      "json_path": [
        "text_block_list",
