    },
    {
      "uid": "zhcn:a0898c65ba8d23e9ca4709fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "量身订制的精随",
      "source_fingerprint": "96ad1dfe5ba0fd7ea74cd0aef882fedac6acbed59caabd5b17ed6ae693ba9684",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1070/storytimeline_501070513.json",
      "json_path": [
        "title"
