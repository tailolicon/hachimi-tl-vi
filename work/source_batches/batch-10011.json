    },
    {
      "uid": "zhcn:c51016775a286446348b8a30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对她的旺盛野心感到惊讶的同时，\n我也产生了一个疑问。",
      "source_fingerprint": "8888ea7cf23e4b8b8f318f40a23b941b375c9624e62ac178eed5f61806260dcf",
