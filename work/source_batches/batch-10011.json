      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:f7db52138bfd35afc5333455",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "先不深究与黄金船之间的对话……\n透过与他人互动中学到的收获，\n让她的跑步技术变得更加精湛了！",
      "source_fingerprint": "343346a7d9d36015c8adf98b96d28f3cad0cc4d9ede31e693c29d2ebf5a2702f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
