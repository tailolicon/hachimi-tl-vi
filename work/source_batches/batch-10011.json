    {
      "uid": "zhcn:a8d3b6b314e99370aee2048d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那你跟黄金船之间的对话也是！？",
      "source_fingerprint": "9b94401efafcfc97199443af8b5b96943f2ae4edd99da3d0098d6cdd16cce7da",
