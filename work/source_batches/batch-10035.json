      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真的很好吃",
      "source_fingerprint": "bde87deb0a04af1b60d9a57162359e04623c0d4e822fbf03351c055f0948eb3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
