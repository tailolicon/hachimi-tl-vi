    },
    {
      "uid": "zhcn:27163d6dda3f827b31ad2b4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个味道也是她累积的“现在”之一。\n怎么可能会不好吃。",
      "source_fingerprint": "730d3eef30183608e88d1852f0836db0a98ae3b7a21df99b3d0aa7bf1a2d9a87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
