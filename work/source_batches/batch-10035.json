    {
      "uid": "zhcn:00b8bb44e459d4df7e7d0f78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "配料都被整齐地切成方便入口的大小，\n年糕也烤得很漂亮，能够隐约窥见\n目白阿尔丹细心的厨艺。不过──",
      "source_fingerprint": "770653215074fe0b08667169f3f3773bdd8ef63d6a9f30198a0bd889d88b9955",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071101.json",
