      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我做的料理……味道不知为何常变得很清淡。",
      "source_fingerprint": "0598f539569a7abcf7fe883dab3a5652d69e22072e2760a018668d9eae759e46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
