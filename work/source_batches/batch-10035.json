    {
      "uid": "zhcn:cfeea62251119e4b54eb31ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这碗年糕汤让我看见了目白阿尔丹\n全新的一面，光是这样就让我非常满足──",
      "source_fingerprint": "8bd9bedd0147b9c1ebac356810b121ae30207fcf293d2f75514d7e02319249e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071101.json",
      "json_path": [
