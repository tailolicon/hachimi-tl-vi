        "text"
      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:f808116d353f15e33357a1fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过因为味道纤细又温和，\n所以整体还是非常美味，\n但与此同时……也会让人觉得稍显清淡。",
      "source_fingerprint": "437ffda8f5bf8f750d78eb869288cfd18b666f0b74c17660d4981f9f5109bd36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071101.json",
      "json_path": [
        "text_block_list",
        63,
        "text"
      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:c9cd340f0e75edfd70e3a9a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，没这回事──",
      "source_fingerprint": "87f1a9ce088d73743de20d86e79743ded6de79f7af6f212cd6242963531188be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
