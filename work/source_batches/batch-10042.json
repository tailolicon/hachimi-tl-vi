        "name"
      ],
      "json_pointer": "/text_block_list/100/name"
    },
    {
      "uid": "zhcn:fdcc8815fef2227fc4bf692a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王……\n会再次于赛场上好好表现给大家看的！",
      "source_fingerprint": "f4c2cfc71a85fb2589c4ee7695a74614d589b150cc8e4c05161ad7ab5b092587",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071108.json",
      "json_path": [
        "text_block_list",
        100,
        "text"
      ],
      "json_pointer": "/text_block_list/100/text"
    },
    {
      "uid": "zhcn:fd9a764cf49740a51ba9e446",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王的回归宣言\n瞬间引起了话题，让“宝冢纪念”\n变得更受大众瞩目……！",
      "source_fingerprint": "12eb9f5c816a8cebe9ad3872f98772096dcc4c5ac95b949409548ebc5fdcf00d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071108.json",
      "json_path": [
        "text_block_list",
        101,
        "text"
      ],
      "json_pointer": "/text_block_list/101/text"
    },
