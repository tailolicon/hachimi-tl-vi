      "uid": "zhcn:438af8a0d05814dba365605e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "妈妈。\n今天可以近距离看到小栗吗？",
      "source_fingerprint": "cbc681f5a40a44af53d706410d1d8a113921e3cc965ed2feae5f325f9f17c04f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
