      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:d63dcb269fa5d8fee203d07c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且，那个“未来”也确实存在。",
      "source_fingerprint": "f577b937f51826c7639f44f38ac2b8119462d123abca64015c3d12fbd7783623",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071111.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:6901f8bbbba4478eebd85d2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论是现在还是未来，\n只要我还活着，目白阿尔丹就会\n持续在我的心里留下痕迹。",
      "source_fingerprint": "9d90ec972b4cc7d9ca442ba95c9d82d273027b238753baf44ea43c81242c579f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071111.json",
      "json_path": [
