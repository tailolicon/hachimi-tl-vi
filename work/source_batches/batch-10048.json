        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:fb80aa48236b62bc6c64db35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你对我来说，是“永恒”的光辉",
      "source_fingerprint": "5c23cb5a8ac0736013d7d57a6556ba1b5e17166a8992609612b7bd72e06de5e1",
