      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:7b4bc4bc71700caf602a3a54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算哪天我不在了，\n目白阿尔丹留下的光迹也会继续流传后世，\n不断地延续到未来。",
      "source_fingerprint": "ba369e3d686f76b86e155e435a08bd17f0cdf2d28e8efc34f33d19fe3f1e161b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071111.json",
      "json_path": [
        "text_block_list",
