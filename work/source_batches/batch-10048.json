    {
      "uid": "zhcn:c1c88f94812964317aec05b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的“未来”是否依旧坚定不移地，\n一直持续存在于你的心里呢？",
      "source_fingerprint": "cace0ef25e3ededc1cc0c8331d1ae7d9f10f861197aa1df37987fb8d8db9c9bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071111.json",
      "json_path": [
        "text_block_list",
