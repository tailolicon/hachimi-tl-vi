    },
    {
      "uid": "zhcn:06a8b61a121464e360578ad5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹说的话让我吓了一跳，\n不过她说要立刻去训练，\n我们就先这样直接走掉了──",
      "source_fingerprint": "5b126c0b6b216e26054d14374942f8f0cddc1cec9880f2de3a74bfe2359a92a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
