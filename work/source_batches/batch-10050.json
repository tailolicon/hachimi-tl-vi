      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在目白阿尔丹的视线前方，\n有两名赛马娘正在互相切磋。",
      "source_fingerprint": "67b3625fdb67347a68cd64607227b6e1b2be691348fd688c76a9a0d833095eff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
