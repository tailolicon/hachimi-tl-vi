    {
      "uid": "zhcn:1be5c5158ccb0109b3e99fdd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──呼……呼……\n……心跳和脚的状态都没问题。\n那就继续做下一组──",
      "source_fingerprint": "a39fc0eb75750d6483cf145bb979d1716adb26cc2931dae192414547ae404cc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071113.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:c74691f72fcdb8ea4f1280dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（话说回来──）",
      "source_fingerprint": "45502552bb8b5b8fb3c6432a92f9df6143f5ba38ac2b1866592246cde4ebef36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071113.json",
      "json_path": [
        "text_block_list",
        32,
        "choice_data_list",
