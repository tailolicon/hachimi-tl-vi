      "uid": "zhcn:4056f0e2eaddfaa479beafb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王",
      "source_fingerprint": "ec59744d588a1310f2984a7c0c6f87f1b1077dca51cda1c301578865155b5c9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
