      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，我们走吧。",
      "source_fingerprint": "ba27ca002192a559af629fb6342f8dcde4c33c8ff62df524fed7d5abaa57bdde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
