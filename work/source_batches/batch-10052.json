      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我试着预测目白阿尔丹\n今后可能面临的各种状况，\n竭尽所能地想出多种版本对应。",
      "source_fingerprint": "e5bacc6c71c1f8675e950978e881ff887ccc510a18c8604c501efa7d93740fd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
