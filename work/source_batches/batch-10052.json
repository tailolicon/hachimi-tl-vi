    {
      "uid": "zhcn:daa4d24201280eba2a8e333d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我交给目白阿尔丹的平板上，\n显示着她进入新马级后的参赛计划，\n以及训练项目。",
      "source_fingerprint": "0b762b172af9af5fb83824345fda7b02f1bb8b61c7eb88b36ee27716b3f2d145",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
