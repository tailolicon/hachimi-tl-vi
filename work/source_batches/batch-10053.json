    },
    {
      "uid": "zhcn:f9ade5caac27344b18621e4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹的这段话，\n让我感觉她比以前……\n稍微地更加依赖我了。",
      "source_fingerprint": "64273bbbf0f29c1cc21b79125cfb453aac8e6685202915c3afa366e9fcea6160",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071114.json",
      "json_path": [
