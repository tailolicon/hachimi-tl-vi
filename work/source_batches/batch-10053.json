      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一点一点地变强吧",
      "source_fingerprint": "8b5f37eb9a4530066d49b63c9fcc7af224c634a8508f448cfa643aa0b1554bd6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071114.json",
