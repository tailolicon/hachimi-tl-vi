    },
    {
      "uid": "zhcn:959270c47b3e0e55ba925f0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹现在需要的，\n是能够撑过正式比赛的\n身体素质和实战经验。",
      "source_fingerprint": "c86bf3408045cb832e49e36dd52c5f48210f1aa2b4ff10d1b9d4271855f6a5dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
