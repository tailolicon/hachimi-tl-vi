      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，请你指示我\n该累积什么样的“现在”吧。",
      "source_fingerprint": "dda75e6c0f018da388d21ac70c1c6dead8a1574ba4efc1df0c38fefb55bb5209",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
