      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，以更闪耀的舞台为目标吧",
      "source_fingerprint": "c85728e6a3a9d71c8ac6a1401de77ec40e9de89406ca3b34a0929b7aaaf6185a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
