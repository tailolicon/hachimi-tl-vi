      "source_language": "zh-CN",
      "source_text": "之后，\n立刻送她去了医院──",
      "source_fingerprint": "ba73230d5b1881e8bb41240f2f37a94dcd099f821f5555cc9718900f30c026f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
