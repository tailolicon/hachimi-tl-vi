      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经过缜密的诊察，\n确认目前没什么大碍后，\n目白阿尔丹的身体状况也稍微恢复了。",
      "source_fingerprint": "3ee8dfa0d5f7def863dcf74e826c19cffe214278e7760a01b561cbc9f2e9d759",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
