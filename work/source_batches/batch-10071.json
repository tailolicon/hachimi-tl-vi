        "name"
      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:992a5af926b44ce80fb0fe3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "假如大小姐之后也要持续挑战\n大型比赛，一定会对她造成比今天\n还要大的负担吧。",
      "source_fingerprint": "584f749a21f96b3a07519216a82300a2ac3953359e3f1199a1c5bb79ee0d9021",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071303.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:d504b097503431696dba7728",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主治医生",
      "source_fingerprint": "24cc43b27409017ca78b242c0620db0aa2988dbf86965ad16da1cad872dd2404",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071303.json",
      "json_path": [
