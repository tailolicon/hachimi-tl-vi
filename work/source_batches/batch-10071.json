    },
    {
      "uid": "zhcn:07b5333967a2fa37e43aace1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我想训练员应该最了解\n那会是多么严苛的状况吧。",
      "source_fingerprint": "cf238f2e8acd17204058a981d4035dd5b2e6813578d35f6541bc3c6c17b7fd2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
