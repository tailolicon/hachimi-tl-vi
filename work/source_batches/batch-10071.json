    {
      "uid": "zhcn:6f33481f5137496ea1414995",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请问有什么事……",
      "source_fingerprint": "79da29eda7a9ca29f34d08df4ac271e42882d9fcefa03e8a648dfe974776b0d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071303.json",
      "json_path": [
        "text_block_list",
        30,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:3e89d4f349f9dcf321df3c59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白家的主治医生带我来到其他房间，\n请我坐下。",
      "source_fingerprint": "d1408ecab5a1ccbe26f2c2f8d9cbbe02f1f51573078d2139dcabf03e5d95851d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071303.json",
      "json_path": [
