    {
      "uid": "zhcn:e3f9415c482e990739942e79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主治医生",
      "source_fingerprint": "24cc43b27409017ca78b242c0620db0aa2988dbf86965ad16da1cad872dd2404",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
