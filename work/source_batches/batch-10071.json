    },
    {
      "uid": "zhcn:90d2112ec0050876f9d0b452",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在大小姐因为比赛结束\n而稍微松懈时，这一切就立刻如洪流般\n倾泄而出──",
      "source_fingerprint": "3cdce50bac2671aeba0a834424c55fe1853ae180dbfadfe58540764ec46c38da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071303.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:4d817835ae69af6e4b5d236f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主治医生",
      "source_fingerprint": "24cc43b27409017ca78b242c0620db0aa2988dbf86965ad16da1cad872dd2404",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071303.json",
      "json_path": [
