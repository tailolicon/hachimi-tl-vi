      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“现在”的你，有能力把这当成目标",
      "source_fingerprint": "f13c0225d2a83504275ee63d831bb563704616535255fdf34441626dfbe409df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
