      "uid": "zhcn:5be68e7bed2f1b477c80235e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花千代王",
      "source_fingerprint": "ec59744d588a1310f2984a7c0c6f87f1b1077dca51cda1c301578865155b5c9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071315.json",
      "json_path": [
        "text_block_list",
        34,
        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:74b156d22de29b35ff6cc8d4",
      "kind": "story",
