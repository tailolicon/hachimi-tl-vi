      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了战胜两人，实现信念，\n目白阿尔丹强烈渴望能够\n超越自己“现在”的极限。",
      "source_fingerprint": "678046fb47addc7a7cd58e30ed4c2a68ffd272c6eee4dbcb1f41748ffca7d344",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071403.json",
