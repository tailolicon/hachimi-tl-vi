      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员下定决心，要帮目白阿尔丹\n守住最后的界线，与她一起\n努力到极限。",
      "source_fingerprint": "537f46243c18565c9964137bfa93453fe5165e536eeec72cbd7f5ea0d5c82e78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
