    {
      "uid": "zhcn:e1d9a7adbd19ab48dfcf7dad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹漂亮地称霸了“皋月赏”。\n她细细体会使出全力并获胜后的景色，\n和自己从出道战以来的成长。",
      "source_fingerprint": "b6fea8175f3a5ed4bcaee75a4a4675452a7655056d9eff5449787c69f0202021",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071421.json",
      "json_path": [
