    },
    {
      "uid": "zhcn:ab343e294698f0016ff6ca08",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071417.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:3591d15b5a1a7d003d61939a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹细细体会和樱花千代王\n与八重无敌这些值得尊敬的劲敌，\n一起跑过的足迹──",
