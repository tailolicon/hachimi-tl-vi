      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:2910f8101a5f221b3272a2ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌想为了樱花千代王跑出\n最棒的比赛，目白阿尔丹感觉到她的\n这份心意后，表现出喜悦和斗志。",
      "source_fingerprint": "c3bf89256b31c2d45674da30ac180b3d881e9a7159c64c395f357a2ec9f61f81",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071414.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8ddaab55c0274584d47e7139",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071414.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:c8ab479418da2552323df1a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要一同超越极限给朋友看。\n目白阿尔丹和八重无敌在心里\n如此发誓，准备挑战比赛。",
      "source_fingerprint": "63c8bc3518415c0d0dcdd9509129f33757bdc4dd73bd0f1d371505006b61bf6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071414.json",
      "json_path": [
