    },
    {
      "uid": "zhcn:0a6edd6dbed46436ab9ff045",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向宝冢纪念",
      "source_fingerprint": "4743315d92bef0a1d3815aad5f8b1374f193f12e0416639bccc69a7a0dc88f06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1071/storytimeline_501071415.json",
