      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "负责演出的赛马娘",
      "source_fingerprint": "2aa7a41cfa0247926d611f02b18b4cf5708c7550393c2e0332c1a8393f520d66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
