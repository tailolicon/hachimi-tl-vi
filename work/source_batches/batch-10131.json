    {
      "uid": "zhcn:02fa23bbe41dd5304edf660f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……真像个小孩呢。\n我会在睡前让自己冷静下来的。",
      "source_fingerprint": "035fe2fef19acdbdc7e521102731c957b8ec4c1851aff3b4bc17236b2909f269",
