    {
      "uid": "zhcn:6e3472e091221d49447d5d08",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会运用和训练员一起找出的“战术”，\n掌握“火水合一”。",
      "source_fingerprint": "be4c589a0463823ad5c458c40a2b076a3948b48103530ee33ba800aba379f453",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072100.json",
