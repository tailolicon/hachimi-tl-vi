      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………呼……",
      "source_fingerprint": "0d706a71dffd5700bbdda4345e9d67794f2910b93a26a26b57305246644e3292",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
