    },
    {
      "uid": "zhcn:e8341db16c6b324ba39e7b19",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，就是这样！",
      "source_fingerprint": "337f5c89af3aa3a703140914ae0ac86948833d8aa490dccc3f56ba7c57a775b0",
