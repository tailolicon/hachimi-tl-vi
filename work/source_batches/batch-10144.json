    {
      "uid": "zhcn:26e812d445a97362d5b7c632",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……之后我认真训练。\n几天后就收到了礼物。",
      "source_fingerprint": "5ce00892d8c7e3033552b1d361bee15ec509a939433f04185eeaea44da9082f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072109.json",
      "json_path": [
