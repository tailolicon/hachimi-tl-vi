    {
      "uid": "zhcn:e18c167f57bf8daabc6c200a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我自己不会特别做什么。\n但有参加过学园或宿舍举办的宴会。",
      "source_fingerprint": "e5536ec1b0feaf11b09ba620a47aa435c823a6741a0f555196c6d22bd9985f7b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072109.json",
      "json_path": [
