    },
    {
      "uid": "zhcn:cee7c0622cd3b856d6fec8b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "富士奇石",
      "source_fingerprint": "630c9bd72789e662b81a8b83212e911d7bcbf6bb2d055023fb47ed14bb6bbee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072109.json",
      "json_path": [
