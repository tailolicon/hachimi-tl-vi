    {
      "uid": "zhcn:fafe5fb622ed08d5e701bdb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果以一般的方式获得礼物，\n我一定不会想要认真训练吧。",
      "source_fingerprint": "85174aac1355a0ed7aa5d4442c7c43eaa7c0336c26b99e832f31e35310a0d9e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
