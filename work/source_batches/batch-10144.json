      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来是这样啊……",
      "source_fingerprint": "58ab5cabf61e5b25d7cc741fc609d6877544da0fce67f8dd50fc4bda87314262",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
