      "uid": "zhcn:b6b430644ca6367473c7b9a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌的祖父",
      "source_fingerprint": "6c1f6b712abb8bf64e62b93d0394e6ae9912813260854a1d00503319f5536375",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072109.json",
