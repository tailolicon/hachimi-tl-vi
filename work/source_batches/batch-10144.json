      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以你想拜托我在圣诞节前一天晚上，\n送礼物给八重吧？",
      "source_fingerprint": "9cbdf46bdcc6fba34bf34347c4d16e4e79c256c21dcc40376aeb5d1b7b31459a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
