      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……爷爷早在那时候就看穿了\n我真正的欲望……",
      "source_fingerprint": "eb7234ba24bd541e1ca4ab47738e93d06121666cb7d75727e3d47480d97d7cfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
