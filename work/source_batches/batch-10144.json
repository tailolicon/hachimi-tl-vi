      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……原来如此。\n嗯，听起来不错！我非常赞成！",
      "source_fingerprint": "d41ed23acecdebdb246cd3f8aa8a028eb3f1336f7bafa0cf06771343a85f1c72",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
