    },
    {
      "uid": "zhcn:6ba8540494368789b849ed78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……现在回想起来，\n那也是我的自我表现欲\n在“获得圣诞老人认同”后得到了满足。",
      "source_fingerprint": "fe5f64269ea710cab1f1cec474b0f6ec49cb660d03da89d372799317e97ec84d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
