      "source_language": "zh-CN",
      "source_text": "正因为原本没有被认定为好孩子，\n获得认同时的喜悦才格外强烈。",
      "source_fingerprint": "82403af7b2a8c6bc43110aade7ae13bff5bde4cd132f32c34f9aaca67c17e9c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
