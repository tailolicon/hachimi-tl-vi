    {
      "uid": "zhcn:c18113b0b5540051d1a3c776",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在与众多劲敌对决的过程中，\n八重无敌的身心都获得了成长──",
      "source_fingerprint": "c8e80251f635bfefeda66f8da87b9eeeb89dea21998909222654c85e89d1c9b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
