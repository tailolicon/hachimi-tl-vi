      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:39efdc41ce61ab92a92b223f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我不觉得她有错。\n我强烈主张若想战胜那些劲敌，\n就必须要这么做。",
      "source_fingerprint": "b422cb8678d95e42790c96b77bb36cdd035bce47aed3b036f54e4174e977c6df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
