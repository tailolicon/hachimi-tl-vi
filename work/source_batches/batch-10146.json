    {
      "uid": "zhcn:aec03a681385c3cb7c2afb60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，身为训练员，\n训练员正确地引导了我。",
      "source_fingerprint": "cc12688b3f72774c3b53e5b63dc04be2060f7d38b4ee1671c12f6f003702e22d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
