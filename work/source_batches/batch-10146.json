    {
      "uid": "zhcn:9cc154fd222ba091a76942ee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我没有压抑自己的自我表现欲，\n违背了金刚八重垣流的教诲。",
      "source_fingerprint": "c4b1f20a1217f535bbce040c7456f95d35d3b059f6b577dfcaa31faedba176aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
