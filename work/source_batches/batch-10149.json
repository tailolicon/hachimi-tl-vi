      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那么，开始吧！",
      "source_fingerprint": "adea940897a36ccbfdd6c6ff30fa0073efe31ecae1b74fdfff8668ff2a2d261a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
