      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来一起练武吧。\n我想透过练武\n推测训练员心里的想法。",
      "source_fingerprint": "b1e5d4461e752f3659054a1f28d8f015730ed7ba2d1fbebf27ee3748a5cd17e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
