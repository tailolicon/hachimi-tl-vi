    },
    {
      "uid": "zhcn:5a03ba7410d19dede035d847",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我当初决定和八重无敌搭档时，\n她也曾透过练武将心意传达给我。",
      "source_fingerprint": "28d60bd9a4d50a1ca9bde9e002a9b8cd4809078ec1b83c3d350cc888882aa818",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
