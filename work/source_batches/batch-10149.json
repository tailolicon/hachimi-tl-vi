    },
    {
      "uid": "zhcn:f92bf0d3fb0047ea135635a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要是能透过练武互相表达心意──\n那正合我意。",
      "source_fingerprint": "9ee2accaff92b92cadd92475dd02e6ef0e3b21c715610ef230009c35fe6524c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
