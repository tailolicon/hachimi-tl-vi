    },
    {
      "uid": "zhcn:577d1a06f538be73104db7ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌回过头后，突然停止动作。\n在她视线的前方──",
      "source_fingerprint": "8a66932331bf9879ec8c9bf136f8c864c3122decee982c307517952272bc2603",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
