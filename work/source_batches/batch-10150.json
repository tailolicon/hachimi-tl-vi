      "source_language": "zh-CN",
      "source_text": "……八重。\n不用担心。我没事。",
      "source_fingerprint": "3aefd1ccffefeee679c8f48514bfc8b73c66776638b8ebba7c5458f66683aead",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
