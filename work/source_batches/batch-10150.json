    },
    {
      "uid": "zhcn:d827fd29a69f3e43b37cc678",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在闪耀系列赛也累积了丰富的经验，\n和她一起练跑应该能学到很多东西。",
      "source_fingerprint": "c93e7b027445b2cb09b7aa12551c868140e425c998d2579c6fa744f46853b685",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
