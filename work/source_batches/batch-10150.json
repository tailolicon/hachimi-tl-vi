      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果对身体造成太大的负担，\n她可能得再次住院。",
      "source_fingerprint": "4346942b9c3f1432ccadac163e496abfa5983d36e0c8257661b4547474471cbb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
