    },
    {
      "uid": "zhcn:dedea3a3ec3920f65a1bc0d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我听说她很久以前就迎来\n赛马娘的成长期，但即使已经进入巅峰期，\n依然迟迟没有出道。",
      "source_fingerprint": "6c58642e8f1c34b0f953ad53b7d5b7fc48c0bc0ff029c6f50489de90a42e2bc1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
