    {
      "uid": "zhcn:71183a49553ee74713799a13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然那是我现在的全力……",
      "source_fingerprint": "590634c73094bfa5e93b7825e8d23b513f7157b66f7029bf7768722a9f8c034e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
