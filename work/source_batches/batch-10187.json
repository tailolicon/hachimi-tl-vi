    },
    {
      "uid": "zhcn:f824ba257e7a905231c0927a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了能在“菊花赏”发挥稳定的表现，\n请你继续指导我。",
      "source_fingerprint": "739970e6b8bd859a46363cdc413e75bd02c059e58163f48d511afa323621fdf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
