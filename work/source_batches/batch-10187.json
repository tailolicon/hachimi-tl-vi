      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌",
      "source_fingerprint": "de3656ba07dd9368850ce26c63bb79082f1316261fe58ad07b81cfe0e318be71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072311.json",
      "json_path": [
