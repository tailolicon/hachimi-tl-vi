      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "太好了……\n幸好训练员的想法和我一样。",
      "source_fingerprint": "333d655bdcab9ecec1b3f14eae74a881d9f71ce8cc39982ab9f5cb2f84a33068",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
