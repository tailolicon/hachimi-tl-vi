      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:ea44bfb825bc16c24c83bd61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使我的脚粉碎也没关系！！\n我要将自己的生命燃烧殆尽，\n在这一刻留下活过的证明！！",
      "source_fingerprint": "90fb487e184ab9e16fa6f3c9b085f35fc931d3bff87bbffe477c98203c04925f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
