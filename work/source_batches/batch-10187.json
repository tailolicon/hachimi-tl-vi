    },
    {
      "uid": "zhcn:ce577d929066e9d0cd9e8761",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就把“火水合一”练得更加完美吧",
      "source_fingerprint": "f54d54f4a20e0157e12c8f4bfe4153f8a1a4375e080ca2a1174841454fcd5b25",
