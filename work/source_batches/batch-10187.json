    {
      "uid": "zhcn:b7f78dc97bb0edf1c459c0c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和千代王与阿尔丹\n进行了一场精彩的对决。\n我自己也跑出了最好的表现。",
      "source_fingerprint": "2c27cba1de29a6e90636cced21a51bec12267336147b294397e84734a7587dc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
