      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过……如果之后又面临相同状况，\n难保我下次不会失控。",
      "source_fingerprint": "6f680cb2b2a6b7cf2f021dcdd25254e797a073d2a653f76374894569e33d6fc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
