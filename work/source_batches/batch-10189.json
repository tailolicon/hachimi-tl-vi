      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不能接受自己\n一直以这种不稳定的方式奔跑……",
      "source_fingerprint": "4df0917cdc914d0c89abf9f3c235d5233a551e967586535328833e04e8911d91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
