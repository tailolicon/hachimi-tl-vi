    },
    {
      "uid": "zhcn:5d434af55a1afaff9ac49354",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是因为千代王和阿尔丹不在吗……？",
      "source_fingerprint": "7eb0b7385b11ecadc174980d1f6eeb53a9613a7e3f78234bff78752c358efb69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072314.json",
