      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们收到消息，\n樱花千代王和目白阿尔丹都将\n因为受伤而暂停参加比赛。",
      "source_fingerprint": "c2a20854592b0e70467b338d81280ceb6f7701e9ec791b80c08b12eeb09e69ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072313.json",
      "json_path": [
