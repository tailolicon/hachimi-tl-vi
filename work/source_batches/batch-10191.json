      "source_fingerprint": "77a883b21ec11b9af7d8a992f0ee47ce85c84bf28bf05c36b0d176177d1c7c86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072314.json",
