      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而，几天后──",
      "source_fingerprint": "ed3ad5b618bbacdd6da748d3abf2d0bff31301dedfe938811dc31342730c6d90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
