      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:cedb761d01951f6501d79612",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过比起喜悦，\n她更对自己的表现深深感到后悔。",
      "source_fingerprint": "73325dd82c1da7e5f370470082579c74d6cdc18f19fe4ed8c8585f0cfc723f5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072314.json",
      "json_path": [
