    {
      "uid": "zhcn:002b59b80f4e6ccdf2d4605a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我今天对胜利的渴望，\n还不足以称作“执着”……",
      "source_fingerprint": "b8a289cef4f9351984b055735b5e1d7e5694c26de4a25e7640549b4675dbf891",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
