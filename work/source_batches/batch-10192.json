      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，没错",
      "source_fingerprint": "97e13912168b6f9ef314b16a03b433b7189028784fa79597f5e177d8abef0112",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
