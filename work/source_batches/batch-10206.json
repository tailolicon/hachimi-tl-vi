      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:c271c1e20b20c5b4f826c83b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这正是八重无敌最害怕的状况。",
      "source_fingerprint": "801045823bc42e879207cf8674027148fabaa8ee05acb783f36a9c76c5803bf5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072323.json",
      "json_path": [
