      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:f8b3a4be383795f3e4f35e96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这么做或许能够提高胜算。\n不过，失控的风险也很高。",
      "source_fingerprint": "182ed84c1b09198f0d75467fb6572f99a8c53214cfa42a081fb98d581eeed059",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072323.json",
      "json_path": [
