      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:c1902736bb6bf155933a197b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然现在没什么头绪，但我们一起想想吧",
      "source_fingerprint": "b9298d38ce916ca7f73a526e41a1ad10a1e404d2ffdcb5f17737a57524a62417",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072323.json",
