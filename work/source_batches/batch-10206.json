    {
      "uid": "zhcn:f947e9792562857a0befefc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道连续参赛有点勉强，\n但还是建议她参加“宝冢纪念”。",
      "source_fingerprint": "bb4e4da9c67df19fe42254cba3ef63703ddd4cf8b8f24588f621f5a9f0ccf93d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
