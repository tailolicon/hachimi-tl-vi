      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:9caade775b9ac97f312f4222",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一旦失控就有可能再也无法控制，\n导致她迷失自己的跑法。",
      "source_fingerprint": "90f3a3694079e46d9ed8015e1d95434b13765e4286e334323e3daddd3707b991",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072323.json",
      "json_path": [
