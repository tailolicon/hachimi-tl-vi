      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:f06df33395bc43b8c9ebe086",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "考虑到她的目标是战胜强者，\n吸引更多观众的关注，\n我问她是不是想参加大奖赛。",
      "source_fingerprint": "60b5c582d45f900858f60ac586d831e935f8dcb336a966b1d39d68b3789396a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
