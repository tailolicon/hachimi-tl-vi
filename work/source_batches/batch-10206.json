      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只能日积月累地持续锻炼。",
      "source_fingerprint": "3dc646f9456692de162912534f1331a00c4feb4a1dbff442aa24811511067371",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
