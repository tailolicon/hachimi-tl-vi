      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "话说下一场竞赛……",
      "source_fingerprint": "c4d6244eff0971fc6313a2729e0386ff52ad2cd9779e9a4bcb3bfd254c0e7a3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
