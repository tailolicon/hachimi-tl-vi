    {
      "uid": "zhcn:1ee1fbed4c85d07cbb7c15de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我才是……我才是──！！",
      "source_fingerprint": "a95d7de4369e12a6bc0e8d9570bf02ec5f40128321170fcb0b73639cd5907c19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
