        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:aab7f5e5e513362c7fa10357",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌怀着对祖父母的感激之情，\n发誓要在“皋月赏”获胜证明自己的成长。",
      "source_fingerprint": "611073d0caa9012c30fd4cdaccfa7d62d85570d4b3b69dbfd69d799018382d7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072409.json",
      "json_path": [
