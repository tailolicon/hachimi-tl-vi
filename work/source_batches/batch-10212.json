    },
    {
      "uid": "zhcn:9b28be52a591b2cf2fad57b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过她没有太在意这件事，\n并鼓起干劲将注意力集中在比赛上！",
      "source_fingerprint": "2819b5d01c59b3af8ecc990a8a3f94ee9bdb8a7504886877f6845514fc9533fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
