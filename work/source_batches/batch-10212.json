    {
      "uid": "zhcn:9378d9707c6d6c0adbf7712c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，\n樱花千代王的训练也变得越来越严苛。",
      "source_fingerprint": "3830c4102f977a041551cea70a7eea0373645f7486ba40d29cc785af73fec290",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
