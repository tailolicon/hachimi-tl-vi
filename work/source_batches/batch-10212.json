      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:d2818602bf4d474c277803eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多亏了祖父的耐心教导，\n以及祖母的陪伴，她才能走到今天这一步。",
      "source_fingerprint": "6389f8217199395e136fdc77d13a183d9c10b4bca0494921183d9c5a2cee128f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072409.json",
