    },
    {
      "uid": "zhcn:aba2a62404a576258793505d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072402.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:d1506d8f3bf8fc0cf6f90f01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她背负着自己憧憬的丸善斯基的梦想，\n怀抱着非比寻常的坚定决心，\n想要赢下“日本德比”。",
      "source_fingerprint": "ce27b494f489ae23196f75d4964717dc2f8428a45a942a60bfef04cbb2f993d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:c3e6f151cfdfee183d0e043c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072402.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:c5d6d7ce9b0000498beb6abd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "八重无敌接触到两名同期劲敌的决心后，\n也重新下定决心，\n要诚心诚意地挑战她们。",
      "source_fingerprint": "21fc817413ea17d31e88572daefc747715612f1f738b9685f2e8031a6c144ecc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072402.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:7fafbb08a7ac1d6288822a7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以敬爱和诚意待人谓之礼",
      "source_fingerprint": "08964243fe3181876c9c9f327aa2b34ed7fa164b2c7294bd81e93fc3fa473bff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:94dfa8928a958f85c20b747d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072403.json",
      "json_path": [
        "text_block_list",
