      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小栗帽在亮相圈时也获得压倒性的支持。",
      "source_fingerprint": "9b5f894153cb282adee74bb387c885db17054d27b80f45fd8507c7a9ef533aea",
