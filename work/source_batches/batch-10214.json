    },
    {
      "uid": "zhcn:b7dabdda990fb8de86df675d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员推测，她表现不好的原因是\n因为目白阿尔丹和樱花千代王\n没有参赛。",
      "source_fingerprint": "4b687ca26bdcc91f6416980eb950db7e259cd7debd6f3e4b8811a2fd0c49ad4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
