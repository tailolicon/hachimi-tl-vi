    },
    {
      "uid": "zhcn:d8d4c31f57574e9cc5634982",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她感叹自己无法燃起斗志，\n表现得十分差劲。",
      "source_fingerprint": "8e97093d1f08b367d3c6969a07d1c3d4ce5a6c0d1ec8467d3e529508cb602c1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
