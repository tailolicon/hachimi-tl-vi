    },
    {
      "uid": "zhcn:e3d194b7c386beab088a1243",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以诚维系友谊谓之信",
      "source_fingerprint": "9b3ad5a64950de65fac1d2a7bd754eb22c278221b7ae3e2d371837af9506ac48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
