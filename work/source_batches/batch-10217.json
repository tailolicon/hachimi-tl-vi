    {
      "uid": "zhcn:ef4ddd5366bd37d3d75b7b8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“止水”开眼──\n我会将所有攻击……全部化解！",
      "source_fingerprint": "bdd8995d3cff3bb540d484c41eae51455796d9a8b205b11c1bc510c40bc3ca2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1072/storytimeline_501072506.json",
      "json_path": [
