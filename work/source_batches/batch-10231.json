      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:bf0534651562731c9c589070",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……相信你至今所学的一切吧！",
      "source_fingerprint": "4f3850d92a205ab1efc9423ad2decb67b9c5f584cdc8e2e721e2b01aab3ce4b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
