    {
      "uid": "zhcn:9afb9f563c19bf43f3221e1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你怎么了？\n总觉得你的表情看起来有点惊讶。",
      "source_fingerprint": "41a53f9dc4a2fce5dbf02a9a892687bb838ad44c3cd30481ba458482af2a2cbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
