      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果她不介意……\n我还真想拜她为“师”。",
      "source_fingerprint": "770a9508b2e4093eccb6f53b2634c553569f2f4ee942f655af09b35170227d3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
