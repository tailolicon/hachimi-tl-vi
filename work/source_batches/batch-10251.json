      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员大人，我跟你约定。\n等这棵树结出果实后，\n我会亲手制作巧克力的。",
      "source_fingerprint": "38446b8c72f2aefe5baec55fcfd0fd4e802a05ef5ce30872cd0312c6b49b4c0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
