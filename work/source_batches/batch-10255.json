    {
      "uid": "zhcn:2ebeeee82ffd3a9badf566d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等待着你出现的……\n并不是只有我喔。",
      "source_fingerprint": "71830d56700bc5ac2878d83c1a3069f1c9ecb6fe46d0963829716ae85b5c282f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
