    {
      "uid": "zhcn:e56cdbc0ce43234821c9ca80",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们需要遇见新邂逅。我们需要遇见\n能带给我们新想法和新思想的新血。",
      "source_fingerprint": "df0aba2d67cde88f3ebbecc52a60420113f19793db45b0064765f8388b6fa815",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
