      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:33f8ae867fb3770050ecc6a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她正在跑着一场名为“赛马娘史”的长距离比赛。\n距离长度无可匹敌的比赛。",
      "source_fingerprint": "546469bb60d745297a86ad1be940635fb51e119fe5be763d97ab6ef78184f666",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
