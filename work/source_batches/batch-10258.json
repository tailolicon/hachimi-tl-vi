    },
    {
      "uid": "zhcn:e69d26fc3c3b4cb360e26df0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知不觉中自然地被她牵着鼻子走。\n就算是这样──",
      "source_fingerprint": "2695adc724921daad079862fa698ff6fa4fcf62bfe91430dc4ca8e6e21f0dffc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
