    {
      "uid": "zhcn:9f06d1a1ec75cd08356f7a44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，未来总有一天，请训练员大人也务必\n陪我一起经营旅馆、招待客人喔～",
      "source_fingerprint": "b99eb933f3e0ded49135b9c04b1eb1cba48080c35ca863bd8d1bfb563b92e0e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074112.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:3d96a8f1609a875baa24aac0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，我来帮忙",
      "source_fingerprint": "f66c6484a2a9a193df90fcd1e60b08c23006438221149fd4aeebd59e35f0a5c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
