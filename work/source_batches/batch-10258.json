    },
    {
      "uid": "zhcn:b6020075eb2ca968f17288d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，我来帮忙",
      "source_fingerprint": "82058f6899494a17e87d7536f589adbf089888b82a6a7b4b3cfc986d968b32bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
