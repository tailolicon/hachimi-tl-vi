    {
      "uid": "zhcn:4912827bb6c200374d335625",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "什么准备……？\n这个嘛……",
      "source_fingerprint": "6bb16b0de3b0cd84c57e5826466c704702fd3491b6c692f52e9664b269f5bdfd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
