    {
      "uid": "zhcn:88498fba33b71d2134119314",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想说，\n疼痛消失前我得乖乖忍耐～",
      "source_fingerprint": "4dcb2de5ca30683ad2d68233b5ce7825fa06ffd5ebbdc8270a048b588d21d973",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
