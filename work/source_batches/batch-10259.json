      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:691ccfd3049aca46603a78a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以你才坚持不勉强自己……",
      "source_fingerprint": "0aaf3d9c2a18a041c9642cc2a5bc96217340724d1d956b936bb9b484c6f121c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
