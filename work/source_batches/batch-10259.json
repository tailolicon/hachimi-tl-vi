    {
      "uid": "zhcn:636849a18a48aa907d895c88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其实……虽然程度很轻微，\n但我的脚一直都会觉得痛。",
      "source_fingerprint": "22dda389667080b86fa1ea678b260b84316dfbfd149a4ee982bc859f40cde2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074113.json",
      "json_path": [
        "text_block_list",
        38,
