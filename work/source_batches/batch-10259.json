    {
      "uid": "zhcn:356bfa12f72d0da43dc3e2f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的～我不想让训练员大人担心，\n所以默默地等待～",
      "source_fingerprint": "d7a23f656fac7ca5c880a9990c38e5bc676900f510689991a2adf930aa366441",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
