    {
      "uid": "zhcn:3ab2227545ad3c3a0c1dbca5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "调配……比赛进程？",
      "source_fingerprint": "e80b2614df44a2b96cec0c794e4d9a996d9b9918916c82d1ce2a163f8917bce7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
