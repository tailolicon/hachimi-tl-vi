    },
    {
      "uid": "zhcn:0382f1ad238c40187d121eb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白家的祖母",
      "source_fingerprint": "635f81e8a5a7646e1b4a84e11bd339f0bb9484c91de40a6df335288f75c3bccd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
