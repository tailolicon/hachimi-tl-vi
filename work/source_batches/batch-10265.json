      "source_language": "zh-CN",
      "source_text": "届时光明如何才能超越铃鹿？\n此为本次目白家会议主题！",
      "source_fingerprint": "0e7764387a990828f7f2ef3b8ee3af0e26098b59e00ec393fb3728d9015e0722",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
