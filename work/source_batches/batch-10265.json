    },
    {
      "uid": "zhcn:397f80d81a3f2279ee90ceeb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──冲进比赛。让无数人们沸腾、\n感动人心、让观众露出笑容。",
      "source_fingerprint": "930b17199e7c6f9a9f67da570b4c5d13258babc3f1fe6870ed3eb6d6d1b80dba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
