    },
    {
      "uid": "zhcn:bbe72a993e689b253b69f0fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白多伯",
      "source_fingerprint": "5b2e9db3e375085a768aff75885101a019a2c4eb826583e7d0dcf525ec7cba67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
