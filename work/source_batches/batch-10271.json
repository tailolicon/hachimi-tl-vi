    {
      "uid": "zhcn:1ffd80f6bd1ef0507f909fa3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你来了啊，多伯。你究竟有没有\n成为女王的资质呢？让我见识一下吧。",
      "source_fingerprint": "ff39d2b0c4336d6ae5f55351d79caa9eaf6b6df2c7edcb1840578434de52a3f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
