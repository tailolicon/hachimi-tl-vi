      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的，气槽前辈。\n我一定会让前辈大吃一惊的！",
      "source_fingerprint": "47fd2a2ff1814a01bea28ed2b25578487d19b0f41b11075fb616c36743349c38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
