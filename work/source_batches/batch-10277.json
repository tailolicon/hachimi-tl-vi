        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:62c7244c2bda26111c81e776",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金色的季风久违地吹起。\n目白光明身负目白家的希望，\n即将挑战“皋月赏”。",
      "source_fingerprint": "083d439f8c7d5b2f1a9b080c26ab03e94755d814af22c1751853451472838639",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
