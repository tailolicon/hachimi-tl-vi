    },
    {
      "uid": "zhcn:f1811a16bdade389ba43c26d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她全盘托出内心的深远考量……当下寂静无声。\n这就是──目白家的大计划。",
      "source_fingerprint": "7a68e1670f9555fd5be3377b77021e2b67fe2ba6a7f9779c373e4217ac806db9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
