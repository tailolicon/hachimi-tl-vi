    },
    {
      "uid": "zhcn:5562b6b6973ab9ce13b925a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的，我答应你！",
      "source_fingerprint": "07a27adb4553cd62dc36d6595f0fd8267281bab7887d29a1e75ac6ad8835dc11",
