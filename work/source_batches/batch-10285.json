    },
    {
      "uid": "zhcn:8d9f0458ced1e303d017e25b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──特别周。\n这位跟无声铃鹿同寝室的后辈\n称霸了“日本德比”。",
      "source_fingerprint": "3d2a8abf7f434250bdcb76cdafc911b936dbfce58864e9a9ca5de51a28022beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
