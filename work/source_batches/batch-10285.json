    {
      "uid": "zhcn:e43ad1295835e78ff711841f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这两人互相从对方身上获得刺激进而觉醒，\n她们即将前往再次相会之地。接下来──",
      "source_fingerprint": "8329af412021a0b053864f1bc130405bb1c485a7f6b81053a3c551b536e42cd2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
