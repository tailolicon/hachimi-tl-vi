      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:91207c15cef63ec7324adefd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "各位，我们走吧～目白家成员、\n非目白家的赛马娘，让我们一起……",
      "source_fingerprint": "2506443ae219899005c1db90ee030c9d3d95f7747bc551842ecb2b8d0bdd31b5",
