    },
    {
      "uid": "zhcn:230a5974ec39e4952d4ff044",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我可是一直都跑在最后面，\n仔～细地看着每一位赛马娘喔。\n所以呢……",
      "source_fingerprint": "00543d314bc858a43d56ae073826d30a0885d845cbd89b5a66249a6974dfb574",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
