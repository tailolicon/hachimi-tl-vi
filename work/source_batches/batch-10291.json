      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我受邀来到目白家，\n陪同目白光明参加于宅邸举办的会议。",
      "source_fingerprint": "87fb1c1ca93d5edd3d3aba194a4a97fef911e31a6357be3a497ef5055288ad1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
