    {
      "uid": "zhcn:646157960384f388fe039779",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "针对“皋月赏”不断进行训练的期间，\n我们开始看出目白光明的问题点。\n看来必须让她学会控制比赛进程的能力。",
      "source_fingerprint": "c33cd9ff2be5e87c9b78ff2dd7934f50ed2ec154dd7fa7b406f87720a79990ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074402.json",
      "json_path": [
