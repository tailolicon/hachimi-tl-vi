      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我决定在闪耀系列赛中\n守候她的成长过程。",
      "source_fingerprint": "e7d41d857d520ffa111b75a56e885d0b0febe16a76ea97d30e5624c0132a7f3b",
