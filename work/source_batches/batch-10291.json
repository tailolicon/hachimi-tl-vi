      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "继承你的梦想",
      "source_fingerprint": "f67a9f017e25aaed86e7b0975311ced56900555e88a4a0f1ee4edcfed1a12610",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
