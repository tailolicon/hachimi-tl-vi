      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了纪念我想安排一场对谈，可以吗？\n你愿意跟那位长途跑者对谈吗！？",
      "source_fingerprint": "efc8b9058395cc8ec2b15046f2f51175f63e81df8070419cae31e2c3411e717c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
