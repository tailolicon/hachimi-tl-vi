      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此时某一天，转机来临了。\n目白光明突然展现出\n判若两人的实力。",
      "source_fingerprint": "5711cef6b1083c995dc84568a4a045432a49f2ab32fac0e219bf7cb7fe5abd1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
