    {
      "uid": "zhcn:d69447f6b7a9f76aaa647bec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "由前人一同创造的目白家历史──\n其中的意志如今已传承给目白光明。",
      "source_fingerprint": "4f1aed165739a3867a3a01ab41a52bffb138b48d6af3698710b867951272c4a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
