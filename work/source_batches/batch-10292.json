    },
    {
      "uid": "zhcn:15b464a1526aaea5bacde1cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "名为目白的传说",
      "source_fingerprint": "153c59beb339ded269c1a2b419a52443dfa02bda31fa62668021c5ab9f5e02f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
