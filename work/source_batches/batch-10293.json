    },
    {
      "uid": "zhcn:f1bd9bba13fa0a3a07614366",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白光明的心意\n让目白赖恩很是欣慰。\n但同时也告诫她要“为了自己而跑”。",
      "source_fingerprint": "b9890396e8638ca7e6c55fa3149e52e03c026622f664805e7ef5874224b7db59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074420.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b448f80977185669e84258d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
