    },
    {
      "uid": "zhcn:4df603f5897cfb84e9b57dca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白多伯也即将\n与目白光明在同一座舞台上绽放光芒。",
      "source_fingerprint": "8387f5221fae043c80132610046ad059b7d85851dd3bfe168d3e362398b8cd7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074417.json",
      "json_path": [
