        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:628ecb6d8ae2a51959ae2e4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "希望S结束后・两人一起挑战新时代",
      "source_fingerprint": "42db3abc9d7b060d2b2699763fec1111959d41107913b3b75fea5b3a5d956ab9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
