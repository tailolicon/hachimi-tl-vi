    {
      "uid": "zhcn:e5b8ffdf3db65ad266bf8086",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白光明深信，所有闪耀的赛马娘之中，\n目白家的光芒是最为强烈的。",
      "source_fingerprint": "15a2fae4fa95c1f3f7de01d666800a5857b985381f0e69dcf671280df29ef878",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074417.json",
      "json_path": [
