      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:601fb3696728c1307e1888c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此外，其他赛马娘们也都各自抱着信念，\n看来今天将是一场大混战。",
      "source_fingerprint": "268048b96aa54fdc4f1078b5a24dac2664ef8619c449d1afa0ad2bb17d602a2d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074417.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0c0fca5fe3d18ab76ea4a4ee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074417.json",
      "json_path": [
        "text_block_list",
        3,
