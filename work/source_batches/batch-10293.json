      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:da766c311347b1238a5878b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但目白光明仍毫不退缩，\n为了让目白家的威名震撼四方，\n她站上了“有马纪念”的舞台。",
      "source_fingerprint": "e4e912b455c8a3e3345fdf08cb86ce5785f153bb0d30fc497f384397c2fdbf71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074417.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:8bebdf393f38a27de045b874",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向有马纪念",
      "source_fingerprint": "a28480a57275928fde3ca335c4e37d5670b04bf8228df0e3cc61294de9b176ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074417.json",
