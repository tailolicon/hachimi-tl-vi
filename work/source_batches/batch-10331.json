    },
    {
      "uid": "zhcn:d1e80d3de6b5cf90f47849c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔～嗯……。",
      "source_fingerprint": "08b8124d092b38f10c8c8483c440b4b4100e0dac291f9e5dd9018baaffd31f21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:4dc42905595f397fd8312b9c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "望向对面的沙发，只见目白光明\n正安静地熟睡。她把我搬到沙发上以后，\n自己也睡着了吗。",
      "source_fingerprint": "3f837886f270357dde681b7f0af84f3e6168fe4701a95a2a5902dd695b95137c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:721386907d72eb0b470d042c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉让你为我操了不少心",
      "source_fingerprint": "3825c251293479e5a41824fb0b76cec1b246a1f8b1cc906b8f878c68bc17ab84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        46,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/46/choice_data_list/0"
    },
    {
      "uid": "zhcn:64f21dde7a999e2c3c2e4188",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好像让你替我操了不少心呢",
      "source_fingerprint": "45f8cc01ff691ca0eaa73c120555a0e5fa8d9f2e662789cfdd539be21ec3b70e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
