        "name"
      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:8f87e75cf1d1b2b5fdf6776d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您脸上的疲惫似乎消失了～。\n太好了。",
      "source_fingerprint": "d2d3bf5f7aa42cc0d71bfa3edb0313322d96e7518dd32fba461de63ffc501f1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:f8ddd05a216b4e0eec75cc5d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白光明",
      "source_fingerprint": "0cce4d859896c50ae77983029951d94a41ba9369dc531a5184d37f6b802e9b98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        36,
        "name"
      ],
      "json_pointer": "/text_block_list/36/name"
    },
    {
      "uid": "zhcn:a68a1accdc2985fd129d906d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵……累了的话，我还会\n继续帮助您～。",
      "source_fingerprint": "d2d50af26ac519b9bccaf0e981944a8a9c3f301f7a7ae00e0ff0d7ffeb7e35fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:b6e32b11200673dcdd42011c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，多亏目白光明的帮助，\n我总算处理完了文书工作。",
      "source_fingerprint": "45c6f2aab319ccf3861a1f0768ebd52e0856bcaf0bfa81798f2d27f014e231b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:363c08211476032515a41b6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使如此，我也不能把工作扔在一旁。\n虽然暂时还在坚持抵抗，但――",
      "source_fingerprint": "3fec34685a1c9e09760e2059abb092570889d94e47da78c3d5186f557538f19d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:d83e8d7d8b3d58b94faa7f7b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白光明",
      "source_fingerprint": "0cce4d859896c50ae77983029951d94a41ba9369dc531a5184d37f6b802e9b98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        39,
        "name"
      ],
      "json_pointer": "/text_block_list/39/name"
    },
    {
      "uid": "zhcn:01cc2c9a8b307b1f48fa957f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要消除疲劳，工作一定也会更加顺利。",
      "source_fingerprint": "a13b59e7f5f9e90285913fbeebc7861f7d16a655a50e52563fd81bc9ac774928",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:46ece9b89f7fc98d9d139df9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……思绪无法集中，我停下了手。\n事情正是在这时开始的。",
      "source_fingerprint": "a0800a5c296471441b44ba757be1d1f507fb3f4a19b25153c11c8a0af157b6a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:5eb7fee8f39927625fc01838",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白光明",
      "source_fingerprint": "0cce4d859896c50ae77983029951d94a41ba9369dc531a5184d37f6b802e9b98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1074/storytimeline_501074805.json",
      "json_path": [
