    {
      "uid": "zhcn:0b632e9854f23e9ebe26b378",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……大人～……。\n请好好……保重身体――",
      "source_fingerprint": "b7e642b201da01715e9a73e3736b2cd4510b9ce4832cb401dfed3b06f5943098",
