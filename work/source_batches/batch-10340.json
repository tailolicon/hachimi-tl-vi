    },
    {
      "uid": "zhcn:300b059dc7544711accd68cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠此话之中似乎另有深意。\n但她并未对我说出真实想法，\n仿佛现在还不敢相信自己心中疑虑。",
      "source_fingerprint": "9f441b325f94d2157d42d7cb921e134465511273ad2e862323002aa460b35e58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
