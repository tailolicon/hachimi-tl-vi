      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我当然会优先做完训练再去观摩。\n那个……",
      "source_fingerprint": "4a5e7e3e03e148e21f2d11dcc0c785e89136e0bdb54a76baecefb5572051ac3b",
