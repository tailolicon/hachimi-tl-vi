      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……有件事令我有点在意。",
      "source_fingerprint": "8dfdf055dab264b7236c3faeea5fb060f458ca46d0f680438b77f8ca31325cfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
