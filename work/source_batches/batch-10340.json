      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁的“应援团”\n举着巨大旗帜来到现场加油。",
      "source_fingerprint": "b87449172b8f60065cf604222708a0d280d6bf47f9b7dfd01444dc6776815887",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
