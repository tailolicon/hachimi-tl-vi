      ],
      "json_pointer": "/text_block_list/58/text"
    },
    {
      "uid": "zhcn:d30be2d5207d80f6bad5fb4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这么说来，\n我听樱花桂冠说过她小时候是在法国长大的。",
      "source_fingerprint": "6f0dd213e5ccc7b40a69c61b40b636979aa561e3f055883f2e8c42e1bc5f49c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
