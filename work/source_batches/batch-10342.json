    {
      "uid": "zhcn:94c41cf4decda561adb3d7d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠送的巧克力品尝起来滋味非常温润。",
      "source_fingerprint": "a4d5532024335232a69cc035f494366ebc72a9917bbc3040fb7347d540d42d1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076107.json",
      "json_path": [
