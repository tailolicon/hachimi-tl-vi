    {
      "uid": "zhcn:7bc870b7f550cff7cce66d3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（对我来说情人节是……）",
      "source_fingerprint": "55db7a67bea3287e1fe2382cea7aba8eebb69172cef342e06639681f44ccf9bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076107.json",
