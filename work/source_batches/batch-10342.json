    },
    {
      "uid": "zhcn:b3d0b01f50f8d043ef02fe7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得是传达宝贵心意的日子吧",
      "source_fingerprint": "9b3a668346c5bb95a0125d0cf443bfe42dadd0be839d31263c565427dd8378de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
