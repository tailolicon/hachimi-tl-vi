      "source_language": "zh-CN",
      "source_text": "请训练员也跟着我们一起喊！\n要喊啰～！预备～！",
      "source_fingerprint": "13fefefdd7a5b519a4bd578034b66e07a042068cf2f7432d3eb18735c23fc97a",
