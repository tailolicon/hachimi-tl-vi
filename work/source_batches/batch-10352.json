      ],
      "json_pointer": "/text_block_list/78/text"
    },
    {
      "uid": "zhcn:719541a4b732b3ad609a0075",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是怎么回事！？你们要对桂冠做什么！？",
