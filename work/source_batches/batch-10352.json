    },
    {
      "uid": "zhcn:f837061dd0de6b527da7da2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当地工作人员用急躁的表情对我抛出问句，\n似乎想确认些什么。",
      "source_fingerprint": "529e3d4d574aac84539c6abf08263a7e4e36cc5dd71b4d00de983b287a006091",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
