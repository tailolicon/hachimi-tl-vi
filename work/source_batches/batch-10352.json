        "name"
      ],
      "json_pointer": "/text_block_list/78/name"
    },
    {
      "uid": "zhcn:09779e90485e2f642aa85741",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“Une civière, vite!\nEt toi, tu serais pas son\ncoach par hasard?”",
      "source_fingerprint": "ce5fb01a59f24c08132f4229ea14f680547d3978d73d84d556385592ccc8af9a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
