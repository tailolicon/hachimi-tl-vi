      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实况",
      "source_fingerprint": "50349a592c466fb97eeafeb81fd3fa65c8c3b2e779463937300c4c8f97230140",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
