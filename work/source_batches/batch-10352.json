    },
    {
      "uid": "zhcn:46e2e4056c0029bb6dd05505",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“Sakura Laurel ne parvientpas\nà rattraper les autres!\nElle ralentit!”",
      "source_fingerprint": "10a6d162aee987cf456815215e2d04dd9e34b26280c5befbe6ae232976a5a396",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
