      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──当晚我做了一个梦。",
      "source_fingerprint": "34a27f86477083019007cbeadcd1770d54614e58f5c148ee92823a7d93a66439",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
