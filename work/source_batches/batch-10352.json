    },
    {
      "uid": "zhcn:b53129da54a687e45c775a89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "书页上记载着对抗病痛的壮烈纪录。",
      "source_fingerprint": "4aafe34e26a5fcdbc8e13e21dbc52b62aca14029db659436f9874d0529272e6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076113.json",
      "json_path": [
