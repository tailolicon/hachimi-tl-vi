    },
    {
      "uid": "zhcn:5de571aba4dff4835501e609",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“训练员，我一定……\n会去拿下通往梦想的入场券！”",
      "source_fingerprint": "958e667e8eec1fd9f022c722ec58f99e0cea11f1b758faac9f3c95667c94e86a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
