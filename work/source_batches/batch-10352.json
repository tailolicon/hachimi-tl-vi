      "uid": "zhcn:7571a7d59c7a702147738f35",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当地工作人员",
      "source_fingerprint": "70472c79fc420bc9e9f553fd8df74e6671e1584dc2919aa13f98ddb58b7daa3c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
