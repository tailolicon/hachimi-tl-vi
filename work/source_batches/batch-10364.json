      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知至今出现过几位有资格\n以“最强”之称号留名于历史的赛马娘？",
      "source_fingerprint": "7ec3fc9c0335ddeb7af8cc0b2f9a68caba1ba8db7ea14341831705438369c87a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
