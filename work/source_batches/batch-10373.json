    },
    {
      "uid": "zhcn:eb979f97a507dbcd6f11cbf3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战就这样结束了。隔天──",
      "source_fingerprint": "a0db90b4f7ac8fc807a334c653bd2c079e240bbffb6744efb552810c56cd4808",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
