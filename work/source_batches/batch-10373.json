      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:203e0df1225add9df165051a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠露出微笑，\n在我眼中她的双眸正闪着美丽的光辉。",
      "source_fingerprint": "5e54a34a6510623a978b609f32044d98b9f7a15f50e8a9c15918754b303f7f84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
