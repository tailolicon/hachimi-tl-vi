      "source_path": "assets/story/data/50/1076/storytimeline_501076303.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:aacc53f99d427c0ab8a97629",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但训练时间到了她却没出现……？",
      "source_fingerprint": "be7a2e6a2bd93e6da0411b85cc9fd70199fd0ff96bb63ba65541a02fcf0ee058",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
