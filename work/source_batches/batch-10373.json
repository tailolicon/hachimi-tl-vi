    {
      "uid": "zhcn:0a9b84c37cf1e49e3d9ee48f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你跟我正看着同样的梦想。\n──赢得“凯旋门赏”的梦想。",
      "source_fingerprint": "cd65f89bd6382ad0052ea8d1788ab73873869056a7f5f6aa4286c58f14b95f12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
