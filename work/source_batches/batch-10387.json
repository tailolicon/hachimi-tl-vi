      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那现在就先别贸然定为目标吧",
      "source_fingerprint": "a58b8f55e9a62e7fd4abcefd870a113aa9800d471bb0e3f40d377b136cb646be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
