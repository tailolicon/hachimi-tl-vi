        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:3535f3f7bb13b097d1e81311",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠",
