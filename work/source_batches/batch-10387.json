    },
    {
      "uid": "zhcn:be1ff78cf58c45a7111ab932",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你想参赛？",
      "source_fingerprint": "f6110c16d69b5bea613b9e66405786cf1d5f7f30aaa284d2b88d16bb78ec95b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
