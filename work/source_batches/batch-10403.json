    },
    {
      "uid": "zhcn:aa9ba21cef5c073adf1d1253",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076404.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a673233d125f84e90af8d32e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑步姿势对赛马娘来说很重要──\n一旦迷失，要再找回是很困难的。\n……难道成田白仁真的失去了原本的跑法？",
      "source_fingerprint": "97ed95e134ba3af1b58c060e57ae053214bf60257c256d03c5a4b0f2b4d295c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076404.json",
