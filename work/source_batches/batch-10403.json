    {
      "uid": "zhcn:d928c8e29bfd4398b33175e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠能够切身想像那\n“无法如愿奔跑”的痛苦。",
      "source_fingerprint": "ceb7ccccd3809e57802c5e3d060979a221a2439fdeb40c92347dac57c43b4b65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076404.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:1b231cc7238be30339393129",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076404.json",
