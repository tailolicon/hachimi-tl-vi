        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:9007ba4c9dc9da81eef1a048",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“憧憬”的她",
      "source_fingerprint": "c4cf9a72d7f1cae0503ba983f9df2be81476d8010d7e8166c9f50b8d78e1c542",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076404.json",
