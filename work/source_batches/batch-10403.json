    {
      "uid": "zhcn:1a39dc8e429adf29c56defdb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "甚至还想挑战经典三冠。\n并且有朝一日一定要前进“凯旋门赏”──\n樱花桂冠踏上了实现梦想的旅程。",
      "source_fingerprint": "99e82a51fc555c93b00b6ee3c8c711c6e6ca1bf371de0e1cd505a48bf1cab8d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076400.json",
      "json_path": [
        "text_block_list",
        4,
