      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:e3656953ac6cca31d01b5274",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经过观摩后她懂了。\n此刻的成田白仁无法完全重现以前的跑法。",
      "source_fingerprint": "dd4bae66616ee95cedd15fe5c0ed18612bd29cfe46292b3c82c9cb866f84fae9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076404.json",
      "json_path": [
