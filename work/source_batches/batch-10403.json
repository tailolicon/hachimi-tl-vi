      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:a5e663ad00a756cbed661756",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伤势康复后重回赛道的成田白仁也大受瞩目。\n光是热身阶段的表现就如此震撼……\n令四周观众骚动不已。",
      "source_fingerprint": "a53f41a29fed3067e6a4d7cbed75a92424857eee7a3a1da8bc3ee01debe7731c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076406.json",
      "json_path": [
