      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:f447b0c064851ac27ef096dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "集训宿舍所在地的特产似乎是饮用水，\n樱花桂冠喝着取自当地的好水补充士气。",
      "source_fingerprint": "b49c75b041d47c7b49fadf847852608599645e9ea989f46c21465807005289bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076405.json",
