      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:854393cc0c75fdeb8fcd8ec9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠登场！",
      "source_fingerprint": "aef451ee68a0b36df1f8b2c52aa9aca4b272becbde1d4c10601b8ffb86ba3490",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076400.json",
