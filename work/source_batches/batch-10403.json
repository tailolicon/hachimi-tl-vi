    },
    {
      "uid": "zhcn:88603886371110c43b5ccaa0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但樱花桂冠却觉得她的\n跑姿似乎跟原本状态有些许差异。",
      "source_fingerprint": "1abeaeaf2ee018a09c544e707dca65d2ad3cb5e9321c5fab6d4368e791d85ef2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
