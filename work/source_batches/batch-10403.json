      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员持续做着樱花桂冠在国外受重伤的恶梦。",
      "source_fingerprint": "0e9581eaf6377d27d91b0e69858edb8c5fc5db49138ab340cba792e45829bf63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076407.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
