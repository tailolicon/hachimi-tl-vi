      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:efbc6c4a9f2d6cd221682d31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛前，\n樱花桂冠更是带着强烈的意念准备上阵较劲。",
      "source_fingerprint": "b7ea4996ac07259ab7524570700da9d863aff22be089f818be5d9a1a6d4cca86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076416.json",
      "json_path": [
