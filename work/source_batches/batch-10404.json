        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:2c9b60e9a2bed69ba4c05cb4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
