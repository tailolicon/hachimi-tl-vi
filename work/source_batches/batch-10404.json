      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:dd33ca46d4c31919ab0a51d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "决定同世代顶点的比赛。\n樱花桂冠的心已被一辈子只能挑战一次的\n“日本德比”彻底掳获。",
      "source_fingerprint": "6f8bc4386f7d6acb607eb8629d42ec27f14a46d28a6bc0e76feb38b4f9f6461b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076419.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:07261a42bb7853b9da52142f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏结束后・这就是经典赛",
      "source_fingerprint": "bf0eb0d6640289361f79daf6f55d2000f43e517208c2767d6cb07b3b9b233b09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
