    },
    {
      "uid": "zhcn:553563c3ede5535d0a26a6d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向中山金杯",
      "source_fingerprint": "ee28ee5f2692251126ec85e47632b063c34a8113729a652299f0677033e00056",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076411.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:4934e965b3e31b1b124c96c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了跟被誉为最强的成田白仁一决胜负，\n樱花桂冠决定参赛“阪神大赏典”。",
      "source_fingerprint": "9043041bba0d96f29c9a90f7660a03747fc2b0148734625a07451954cf9a6672",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076412.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:a973ca073e57d5224eae1e30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "随时随地都能听见人们谈论着成田白仁。\n她的一切都是如此压倒众人──此刻任谁都\n打从心底认可她就是人们期盼已久的英雄。",
      "source_fingerprint": "81bfe603cc5c4b107b0065c8dd1883cfa761f16262dd80a1a9d2529a8eb8101b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076412.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a0910254194e7863ee357f57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠从比赛前便开始深刻感受到\n最强赛马娘的魄力。\n为了赢过憧憬的对象，她将全力倾注在双脚迎战。",
      "source_fingerprint": "9288e4f7aaa5e7b5db9976583dbf12ab296b510f5543226b91ac4fcb7e315f90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076412.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:48d4cbb4627d6e299c8b0e81",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向阪神大赏典",
      "source_fingerprint": "1eff3f304c323271c02280b3943718aea198180df9d54702c0264fc0dd5165b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
