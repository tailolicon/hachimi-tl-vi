    },
    {
      "uid": "zhcn:a32f9d4a6beb8bdbd2c38414",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛后，\n训练员带樱花桂冠就医检查双脚，\n检查结果并未发现异常。",
      "source_fingerprint": "ea6cd636c2381160f4a4c5472f0382aa48fdcb1c8ee3de002b9f97126b14e14e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076420.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b0cb0826a6accf2362fc6d77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076420.json",
      "json_path": [
        "text_block_list",
