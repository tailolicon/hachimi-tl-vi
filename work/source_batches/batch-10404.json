    {
      "uid": "zhcn:e1f6a17e23e45b17c473aa6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人决定暂且先观察双脚状况，\n依情况挑选不会造成负担的比赛来累积成绩。",
      "source_fingerprint": "e74c24dc023f6fb86987f0a9e4165d5005638cfc0de00060aea3c9a5887abcd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
