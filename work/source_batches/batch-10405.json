    {
      "uid": "zhcn:401397de3ad7b676b3974d4d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "三冠路线开始了",
      "source_fingerprint": "2aa63095bf349e5c59f56af9e0921a431bbb43f520f731ff8f45d01046af166a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
