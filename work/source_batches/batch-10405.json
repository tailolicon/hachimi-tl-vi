        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:4599cd22a87e5146587123db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠达成了在重赏比赛跑进前三名的目标。\n此时其他同期们皆已开始针对\n“日本德比”努力进行严苛的训练。",
      "source_fingerprint": "9da359707eb173af586d7b7bbd05cdca1cc5e59711219aec69bdb148b9eb09dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076423.json",
      "json_path": [
