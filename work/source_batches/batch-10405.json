    },
    {
      "uid": "zhcn:f6b2651be6492bc7387d9f94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁称霸了“日本德比”。\n樱花桂冠强烈地想要赢过这位心中的憧憬。",
      "source_fingerprint": "fed8e2ba81a125dcab34b56511df07ff1e04fbfdf76ac1ae4bdd8dec92278c72",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076427.json",
      "json_path": [
