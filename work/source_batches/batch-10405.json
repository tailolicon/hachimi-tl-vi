    {
      "uid": "zhcn:2c60b2f890948df68306cca1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想站上一生只能挑战一次的\n“日本德比”舞台的意念，\n逼她吞下了口中的话语……",
      "source_fingerprint": "5339af2adf7cc92ea596e58dd0c2f778152352f41a7727eb85314e0d6ef5ccc2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076420.json",
