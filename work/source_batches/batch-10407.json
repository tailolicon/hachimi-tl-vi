      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:7dd875efb8a701cd77b9ef9d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后却传出了成田白仁因受伤\n而取消参加“天皇赏（春）”的消息。\n尽管如此，樱花桂冠仍然一心专注向前迈进。",
      "source_fingerprint": "3c27e3cf6ef55d7fb80b33b7c8cbf5b218588ef6d9a708255b00866b5f15d930",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076437.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e59342a8d6948679db38957d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076437.json",
      "json_path": [
