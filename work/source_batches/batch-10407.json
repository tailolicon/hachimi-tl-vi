    {
      "uid": "zhcn:a27b5688ff2fb0083281cf81",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她决心要成为带领成田白仁看见梦想的英雄，\n并将目标定为“日本杯”。",
      "source_fingerprint": "d1407732bc931502ab45863c9c2fbd44f264229727ab0a8148709bca8c702d8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076439.json",
      "json_path": [
