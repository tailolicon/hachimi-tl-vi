      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:34254447508d6e7868314c7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此刻她唯一的遗憾只有未能跟成田白仁同场竞争。\n最憧憬的对象在樱花桂冠心中的分量日渐增长。",
      "source_fingerprint": "ebb3306b989b9a43246e9af26d94bc26ef604811dc449ad7e69947144dcd59c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076438.json",
      "json_path": [
        "text_block_list",
        1,
