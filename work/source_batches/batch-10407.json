      "source_path": "assets/story/data/50/1076/storytimeline_501076439.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:680d3af3e59093e20b931f25",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此后成田白仁的状况仍持续低迷。\n那苦苦挣扎的模样逐渐开始引发周遭人们的不安。",
      "source_fingerprint": "4f998a8b3d434a40a817a1118c9e60df3d485c5fdf492e0290a35fe8a914ae58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076439.json",
      "json_path": [
        "text_block_list",
