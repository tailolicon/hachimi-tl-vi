    },
    {
      "uid": "zhcn:26ec07024f04e0876f309655",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "憧憬跑向了遥远的彼方──\n因此而更吸引后人追逐。\n樱花桂冠决心有朝一日一定要超越成田白仁。",
      "source_fingerprint": "2ecca5d7e2377c6b8f28af774b4bf530e7b2e4509f6cb6e53580ab485bedf46f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076437.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:a4a4237c12592eb2c8bc3cc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
