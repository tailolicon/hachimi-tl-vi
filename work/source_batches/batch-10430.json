    {
      "uid": "zhcn:469629f564e63bb76bb2109a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "樱花桂冠一边注意着伤势，\n一边在可承受范围内继续进行训练。",
      "source_fingerprint": "007500dc3064cf74a81b9546903f3ac25f3ba2bbe110c77778f40774c8bf2ac9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1076/storytimeline_501076714.json",
      "json_path": [
