      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想把胜利当成是礼物。\n跟感谢的话一起送给老师。",
      "source_fingerprint": "5f641b6d803cde470695dc30f8f0c6ef1632b2f6332298d7f88eb7c24347d629",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
