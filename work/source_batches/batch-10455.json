      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一名普通而有趣的赛马娘。\n成田路，她会带着大家的爱，继续奔跑下去。",
      "source_fingerprint": "a043355d8bd977cae376a52b1fde7fac3fe09ded9e6ebda50315228a10c74f5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
