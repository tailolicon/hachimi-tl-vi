      "source_language": "zh-CN",
      "source_text": "以后不管是比赛的喜悦，还是比赛的成果，\n无论什么时候我都会和训练员一起分享。",
      "source_fingerprint": "802ef1ff2a8fe53c8fa3861add5937cc165dc9f53f5407607a53689252b5f193",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
