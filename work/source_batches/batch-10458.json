      "source_language": "zh-CN",
      "source_text": "反过来也是一样的。",
      "source_fingerprint": "0f68d27ae454f680a54de2b193608ff1119da97242a0d3fac2a687bd64014ec1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
