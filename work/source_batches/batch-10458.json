      "uid": "zhcn:18d0d26865f2f3b67f55ca53",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呃，嗯……",
      "source_fingerprint": "11540b5c9b38a6fb7cdff1a40c693e6f417dbeeab8ae446782c1ef8fd40f913e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
