    {
      "uid": "zhcn:2150f64d265b491f3a86ef1b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯，约好了",
      "source_fingerprint": "5892277c818a549b887afd3698598a5a96185a697131bb0e146b1a46b0dcd9e2",
