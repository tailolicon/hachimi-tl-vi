      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不，还是等过段时间再去吧。\n我想帮忙照顾训练员，而且……",
      "source_fingerprint": "e520e05c32ffcc378a50c59bf095d3a9f912b43100d6ebb914450bad3f087a30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
