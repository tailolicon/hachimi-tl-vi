      "source_language": "zh-CN",
      "source_text": "啊，啊……",
      "source_fingerprint": "d69bd7e658eb3535ff34f815791c9eb48dd2e782e451a37a79c9a64bb383795e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
