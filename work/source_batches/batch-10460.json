      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好的。",
      "source_fingerprint": "c69b6b2cacc3fb0ae03798151b2954be697a2092751fc1c54899ac377ff2861d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
