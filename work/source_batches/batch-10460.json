      ],
      "json_pointer": "/text_block_list/13/name"
    },
    {
      "uid": "zhcn:4caf2f1ed72574526e713691",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦呦，好久不见。\n怎么了？怎么一副愁眉苦脸的样子。",
      "source_fingerprint": "0814a0a2e6bd7f863be7fa46741b0e20365598ca68afe7c12919d75dd9d30b1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077114.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:9d07cba696bec2787e592e6b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老师还是如往常一样欢迎了我",
      "source_fingerprint": "a7770c62d76fb85d084d6283d0e877a4ee945400fb34c2972ff467d419291260",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077114.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:e53bd113f1af0490335bd8fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想要请教，有关心灵的武器的事",
      "source_fingerprint": "487bfda64c1b899287c9fb9f6416367dead6bba184ec7adacbb76c7fec7cf469",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077114.json",
      "json_path": [
        "text_block_list",
        15,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/15/choice_data_list/0"
    },
    {
      "uid": "zhcn:3d40ba76d8c2d2c1c044bd83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这位就是我和成田路共同的恩师，\n是教导了我本领的人。",
      "source_fingerprint": "d18724da4dbd9c3bec586b45197ba8df017dcc7d46e472296c689a32a73c3481",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
