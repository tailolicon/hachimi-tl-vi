      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:5378c6d52e71760b956784c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "先生",
      "source_fingerprint": "cd98e43da31bb1b90dc152851c85c7d266d47ba97bc5ff7bd137c5920429d467",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077114.json",
      "json_path": [
