    {
      "uid": "zhcn:b5da82bd97a2df3b866741e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然难以阻止追寻光芒的想法。\n那至少能做到的有――",
      "source_fingerprint": "23243a2b47997b2b53f690282dc01fe5aca79638de0c662a7c50af32f4e1bc53",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
