      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样就算不训练，也能学到很多东西！",
      "source_fingerprint": "50f4ce4a223a6842f3cfeabababa8205bbc36168921a4ef3e79719f3c66163f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
