      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在比赛和训练中获得的经验，\n逐渐积累起来了……",
      "source_fingerprint": "886b7284c7a2fb7dd53503cdbcb4731dba86f4d256abf15e0e306f4acfc8ed13",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
