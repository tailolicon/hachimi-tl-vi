      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对哦，明天是爱织同学参加重赏比赛的日子……！",
      "source_fingerprint": "6c8fc51927e9fda22b381c27340fd93d07beb494d7b6f7bd3f1ec450449b81e6",
