    {
      "uid": "zhcn:e549b99d6113cba623f87370",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她一直憧憬的马娘爱慕织姬，\n在闪耀系列赛中的存在感日益渐增。",
      "source_fingerprint": "d85282735293717e70d3855aba2986eced78eca3469eb55807b1047c8923f8d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
