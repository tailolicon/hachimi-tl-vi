      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论怎样，这次稳如磐石！\n堪称漂亮的复仇战！",
      "source_fingerprint": "dc855008dc08d18c11172efc08bf0bb01c20a2b3ae48b467ffbc0eeba97bf742",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
