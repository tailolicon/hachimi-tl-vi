      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:ce90853057a7619c84aa7fc2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在之前爱慕织姬被判降着，\n导致输掉比赛以后――",
      "source_fingerprint": "f205b60b59fdfd6cb5590271f10877841665163c0fea65fd441cdf71891923ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077304.json",
