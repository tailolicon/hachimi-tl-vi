    },
    {
      "uid": "zhcn:9a46407b2b5bf754f3fd8a32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――",
      "source_fingerprint": "85b4e57cfb65ac4c03f193f7a21e745cbc1b55259994bcccb1759a1c7591ef3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
