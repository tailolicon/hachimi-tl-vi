      "uid": "zhcn:e4e62018a3e7149e9630c445",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想能跑得不愧于声援我的大家！\n想不留下遗憾。",
      "source_fingerprint": "84f80900fc6b1ebb4326e42599e2a200a623625906477cfb4675d5bdac79e4a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
