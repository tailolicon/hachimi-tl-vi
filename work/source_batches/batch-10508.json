    },
    {
      "uid": "zhcn:d6f1a869e3356f9548a47737",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱慕织姬",
      "source_fingerprint": "133221201a09546ab4acd4d3464f307913be827dafcf84f30563c8c657e48319",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077319.json",
