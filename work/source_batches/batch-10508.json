    {
      "uid": "zhcn:74a52b3563ea452f7aa853e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不去面对她才更可怕。\n如果因为害怕就逃跑的话……",
      "source_fingerprint": "19175e3d63111ee4eadb13e8c18ca57088d544327ec36190dcfaa3e8b6f5b448",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077319.json",
      "json_path": [
        "text_block_list",
        42,
