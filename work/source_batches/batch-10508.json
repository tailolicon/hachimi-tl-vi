      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确实，小歌剧很强很可怕，但是……",
      "source_fingerprint": "d9136c1270d881bcae438e55d5be0d9b2deb49ee76e3905b32855f14965cda6d",
