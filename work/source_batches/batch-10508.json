      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:2d3c2cc56913f91f2e9cb9f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田路",
      "source_fingerprint": "988a071d6223b7f19ac194fb48e747cae2ebec8525c415e4d4d92ec1443cca38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077319.json",
