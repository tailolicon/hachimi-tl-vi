      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱织同学，训练员。\n『宝冢纪念』我也想参加……！",
      "source_fingerprint": "146552183e14c81af8f327d23d6a72a50da2c205bb4e853bcc6b4ee7094c5410",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
