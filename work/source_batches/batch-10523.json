    {
      "uid": "zhcn:9d7999e5c336e283cb1e6cfe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦，此世群星闪耀，\n但是统领了整个世代的人还是我！",
      "source_fingerprint": "081b7b331cc4be0157bfbd44286a46857a2c7067cb72212ba35a96c8f5bdc8cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
