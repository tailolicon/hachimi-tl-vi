    },
    {
      "uid": "zhcn:3a0e23aafa5fad554f9e648e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每个人都发挥出了200%的实力，\n然后――",
      "source_fingerprint": "80d738c3dd18c6e32d16ce699e1121e6b88d1d4ef9898f9f7ce91f2089658b84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
