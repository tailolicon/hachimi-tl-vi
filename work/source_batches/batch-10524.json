    {
      "uid": "zhcn:9d6e261b27a56ef04778653b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我觉得应该不是那回事，但是……\n能赢下来真是太好了～。",
      "source_fingerprint": "b30d8a44e4980151a992a2aaaadf08d0fec5b866d70e6ae2aa04486ff2480724",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
