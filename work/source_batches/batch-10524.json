      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:71c65c2937c95346276181a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利者是名将怒涛。\n虽然不知所措，但是还是用怒涛般的攻势，\n击败了来自世界各地的强者。",
      "source_fingerprint": "1ad27c765c9ac1b6337dc079a915f4ea34930762270e7676e704c6568726cde6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
