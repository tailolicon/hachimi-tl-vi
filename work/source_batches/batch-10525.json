      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家你一言我一语的把充实的感情倾述出来。\n然后――",
      "source_fingerprint": "13a0dd4a0dff49511d6042c071a5b81d25d7ea73c72baf3c235ded7f4836b819",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
