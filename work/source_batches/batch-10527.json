    {
      "uid": "zhcn:b33c4950c1526af3fb606fc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同期たちの力強い走りに触発され、\n気合いを入れ直すナリタトップロード。\n2人の背を追いかけると誓うのだった。",
      "source_fingerprint": "26e6f569539e2f94e6926de26db6e1d84072ae4bfd4d10ff89e045cd41701906",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077401.json",
