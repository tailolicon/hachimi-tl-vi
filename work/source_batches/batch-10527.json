    {
      "uid": "zhcn:296760aebf934d6f4754dc73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『天皇賞（春）』――\nナリタトップロードとテイエムオペラオーの\n対決は、もう目前に迫っている。",
      "source_fingerprint": "305173b3149fa0ebe8aaf037469bff7ff68588a151d503264af487edf9a4cc89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077403.json",
