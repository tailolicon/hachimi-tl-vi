    },
    {
      "uid": "zhcn:6726f1aa36ab42d904f93035",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "羽ばたくライバルたち",
      "source_fingerprint": "6e7f1aeb022275d9e6d94424f41edecc004079e8b5fc64a653800058fed00143",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
