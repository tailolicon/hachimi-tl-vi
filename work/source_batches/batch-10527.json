    },
    {
      "uid": "zhcn:66e6d6dca5a8cd28f5d6f326",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077403.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:ceaa8cb2ea25833c67f39bcc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "テイエムオペラオーは、格段に強くなって\nいた。盟友たちとの戦いを経た結果、\n強者としての彼女が目を覚ましたのだ。",
      "source_fingerprint": "22a2279f0d7a71ccfd763c9f2e49b17ac4bae5a7db8bf0d396d92812c082d05c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
