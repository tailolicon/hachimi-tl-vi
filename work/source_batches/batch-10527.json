    },
    {
      "uid": "zhcn:5fa5de582e6ab2dc378a7318",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "輝かしい理想を、自分に見せてほしい――\nナリタトップロードはトレーナーの期待を\n背に、いざ菊の舞台へと赴く！",
      "source_fingerprint": "281c8303253e0b28ae2f9f7f0217d2ffff9d97b6f96dce724b8b6a72fb2244f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077402.json",
      "json_path": [
