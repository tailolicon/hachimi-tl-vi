    },
    {
      "uid": "zhcn:d78cbbdc253af557261ed57b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077403.json",
      "json_path": [
