        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:d5eeea7167048a8e23184677",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恩師の助言を、ナリタトップロードに自身の\n言葉で伝えるトレーナー。おかげで彼女は、\n自らを信じる力を手に入れることができた。",
      "source_fingerprint": "e21c60bd96db31da8be5646ac0e4ba19f939d7246eaf7414b72b25cf08debaeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077402.json",
      "json_path": [
