        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:d947794e170dfa86f5520b0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "誰にもできて、できないこと",
      "source_fingerprint": "58fd1fc3771c1a93e715a45da4b315e955eb19b7eb3a41d8cf31f5e446f62280",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
