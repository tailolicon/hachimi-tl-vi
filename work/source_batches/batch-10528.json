    {
      "uid": "zhcn:3a9b631be51fcfac7f59f9c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "さらにはファンに応えたい気持ちも武器とし、\nクラシック三冠の2戦目、\n『日本ダービー』で実力を示す！",
      "source_fingerprint": "4d2e5872e128fbf5f2feb090da4cd7fc4454a069c4684ebf9f53823efef9bd23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077411.json",
      "json_path": [
