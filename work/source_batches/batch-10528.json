      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e3e800ef208ff255c7f3d1bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本ダービーにむけて",
