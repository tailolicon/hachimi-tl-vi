    {
      "uid": "zhcn:cf6e5569f9e458dce5214164",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――決戦の刻は来た。\nクラシック三冠のフィナーレ、『菊花賞』\nナリタトップロードは落ち着いていた。",
      "source_fingerprint": "26f37aa4283e537abc1dd77019212b80eb9e33777518f4abc3a5c894314bf8a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
