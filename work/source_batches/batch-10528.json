      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:42a90ed3bd3f528415211d4d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
