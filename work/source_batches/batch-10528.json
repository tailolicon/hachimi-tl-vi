    },
    {
      "uid": "zhcn:937361c27df3850892e04da7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "ひとまずは、テイエムオペラオーとの決着を\n見据えるトレーナー。ナリタトップロードは\nこの夏合宿で、より高みを目指すのだった。",
      "source_fingerprint": "c51f8c05df5805ece88d1d5fcc84706c93b1e0ddf9da563f24cc87bffaf55bc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077407.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:be528818b0a966b21822d155",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏合宿（3年目）スタート！",
      "source_fingerprint": "7f9e28d6a2726a83c77ee2ee91da88350aced44f6339349a93cce941e9a5d0bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
