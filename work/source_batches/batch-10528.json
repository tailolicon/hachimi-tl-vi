        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e831ebe36adb1c57faaf62f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花賞にむけて",
      "source_fingerprint": "13633969b6aa2110a104bdebee02869ab98c5b4da2a4ee408369ffaeb75a46ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077412.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:4fdfc677692c14aaa888d654",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一流のステイヤーとして掴みたい、\n『天皇賞（春）』のタイトル――",
      "source_fingerprint": "6f9d2b745b90128f8e5f325add70d194cd0922394cd253811e4ed996ac71becd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077413.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:ca30361dbbc0e8033f4b18ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "しかし、そのためには、\n恐ろしいほど強くなった“彼女”を\n打ち倒さなければならない。",
      "source_fingerprint": "f6c4e1bf261a8a385ff383e08d83c86fbc63d6cdebeddc0109fb4351b061491a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077413.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:20d140e763fa7f9373841e9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "テイエムオペラオー。シニア級で一気に\n化けた彼女を、それでも超えるために\nナリタトップロードと共に努力を重ねてきた。",
      "source_fingerprint": "6ea834680acb7ec3f97c2adbd6094a41454a5baac253ad726e0c66314da83b8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077413.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:7b6576cb36661023c1bbb708",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "彼女ならば誰よりも輝ける……！　自分の\n信じる1番の努力家ナリタトップロードが、\n覚醒した覇王に挑む！",
      "source_fingerprint": "3f7eb383b0b75ddc0b320677d83c2c93e0a73a2f19c124284f5d92c4d06348ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077413.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:7a600de49d14cfa20239e026",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇賞（春）にむけて",
      "source_fingerprint": "5e1d48585b620e66c0b1af62d5d31ef22b13830ad6b20f11fb02131d3b3f1b51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
