        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:b724e386a680582c05a86267",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "そんな折、彼女の脚から血が滴り落ちた……\n極度の集中のため、負傷に気づかなかった\nらしい。それは一見、長所にも思えるが――",
      "source_fingerprint": "5569d4cc685aa9c0afa18f815d36866a6d1564b75faef05b061902e5108fcade",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c3584483bf4a6d6e16595a61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a79ee3c79221f080a5e251e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "後日、練習中でも軽傷を負ったことに\n気づかずにいた。\n……その懸命さに、危機感を覚える。",
      "source_fingerprint": "9a14c2605be30eb0759caef4b42bb04f2d9cabcd11c305c9bf225a346f4ae757",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:888539854d198882fce8f4bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:f20fdb4296f0063078ee93a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "ひとまずは目標を決めず、レース経験を\n積むべきだと提案する。ブレーキ役として\n彼女の身を守りながらの二人三脚が始まる。",
      "source_fingerprint": "231015821d8159a4c996fa424147c419a1f02ce8aeb8441c8d42beec9f82d250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:faba0c86c633575a5b829575",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "デビュー戦の後に・真面目ゆえに",
      "source_fingerprint": "b54a765ee1a03575520c99fa3b7975a2220c15109afe2b5e0dcfe8d41bfeaa41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:960839ff8b88d2cc0af56825",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "経験を重ね実力をつけたナリタトップロード。\nしかし、いまだ頑張りすぎたり、頑張るなと\n言うと何もできなくなる不器用なまま……",
      "source_fingerprint": "201ab89b6d55f2e4b5a253a4be21942e2f7ef5d37ee78f427ebd43fc9d7e3731",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077419.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6067523a8e952a7ce4a3c4b3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "そんなある日、アドマイヤベガの出走する\n重賞レースを観戦しに行く。――それは、\n洗練された、他を圧倒する走りだった。",
      "source_fingerprint": "a9e5a304e2e944bfe0f741635ec5a0449e3372c043828768ff1637f68a6f88e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077419.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:939bb54631cb01912f34bf40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宿敵の好走を目の当たりにし、\nナリタトップロードの様子が変わる……\nそれは、理解したからに他ならない。",
      "source_fingerprint": "ca12f34f6555d7e5aba66d6c0449255dea888738b6bcab95bbcff1c77c8d9a65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077419.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0fbb787256fa52c24b98e393",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "がむしゃらさだけでは追いつけない、\n頂へは至れない――であればこそ、\n地道な努力を重ねるしかないのだと。",
      "source_fingerprint": "7315ce1a3e01d20116fca63c8e57a393979f8556c42db826637d2a8b14c0d3e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077419.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:b3b52f7be50edc8c9d1d17f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "焦りが消え、正しい努力の方法を掴んだ、\nナリタトップロード。『弥生賞』で、\n憧れの星、アドマイヤベガに挑む！",
      "source_fingerprint": "d02adf7ac7164991d2f33c3eff68a82f42a8cc73ed1fc8918d21160addc85511",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077419.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:21a9919687dcf4a3a2e1da74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目標達成の後に・一番星を追って",
      "source_fingerprint": "463659dd0b06bd5c39880cb9a480fe5c81262fda9844b5a13c01569dbceb1289",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077419.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:56f02e5d508887f111a5e5b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:e34178bcd43b870a409e5032",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "アドマイヤベガの走りは、圧巻だった……\nレースに懸ける“執念”が、他のウマ娘とは\n一線を画していたのだ。",
      "source_fingerprint": "389d3118e0fa1d28535b77b3b76101899780e7e17b15059cf85519927b41d7d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:7a0883b89b88edf7606ab960",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:d5feba58ec08da2eddbb4053",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "負けられないから、走っている――\n言葉以上の重圧を感じるアドマイヤベガの\n凄みに、たじろぐナリタトップロード。",
      "source_fingerprint": "8d83044a0449a61bd5cd710aa41607d7716f362ca1e64facc6a899fe39f4a454",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:f319e43afe92f6a479384a8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:287f30d89418f88332b5181f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今のままでは、勝てないかもしれない……\nそう自覚したナリタトップロードは、少し\nでも強くなるための努力を、改めて始める。",
      "source_fingerprint": "a14ad53142244d50ad5749deb062edba2cb71e7d48115f8fb95521e49fcd445e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d1343497afe81e9d6adc2af9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077420.json",
      "json_path": [
        "text_block_list",
        3,
