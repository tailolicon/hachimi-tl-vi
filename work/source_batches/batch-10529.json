    {
      "uid": "zhcn:aa237a29e7f0b30661772400",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――テイエムオペラオー。\n気迫に満ちた走りを見せた彼女は、\n最後には王が、全てをねじ伏せると語る。",
      "source_fingerprint": "ec922ef6e0883bfbe102390bada5de3a5f05dce3749c7472ace2c83c463e79fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077424.json",
