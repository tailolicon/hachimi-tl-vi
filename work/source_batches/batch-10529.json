    },
    {
      "uid": "zhcn:d39bc6b7dd3edf3596375e56",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "無事デビューを果たしたナリタトップロード。\n彼女はその生真面目さから、すぐさま\nトレーナーと反省会を始める。",
      "source_fingerprint": "ebdc8a61a41cfaf8d535837bd4db69085cf1d14d4be14ddd5aba85188ddb1d97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:6c9931b4fd0c4b99b53eeb0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1077/storytimeline_501077418.json",
      "json_path": [
