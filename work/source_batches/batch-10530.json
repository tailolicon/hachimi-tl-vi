      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "モノローグ",
      "source_fingerprint": "143e706e67b179bcda182d47e6a727910bb5778ac01a05356150554568138628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
