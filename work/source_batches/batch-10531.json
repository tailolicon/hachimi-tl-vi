    },
    {
      "uid": "zhcn:8f305729dfa6de837d45f466",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝塚記念の後に・あざやかなゴール！",
      "source_fingerprint": "9a0651d4aec54aeb7372122795581056af8d06b83a7f5b7281c20bb98a7f8610",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
