      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "并拜托她来观看第一战“短途马锦标”。\n──赛马娘之间，\n有一种只能用奔跑来传达的心意。",
      "source_fingerprint": "9776d9e4708a36c409b9d03b1aff8a0090f85d1cf41c80e4c9ffc3768e7171c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078404.json",
