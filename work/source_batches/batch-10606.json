      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:71dd148a5b3ca69b6be611a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是她决定和训练员商讨赢过两人的对策。\n──同时，\n一个突如其来的恶耗震惊了社会。",
      "source_fingerprint": "05fb9e9f02139d564befbbf5da61c9bf445d28f9e03c1d720b96b298c2817524",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:dd4c74d099bc0dc7e9e828c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "云会带风雨前来",
      "source_fingerprint": "54a8cb1edd6cc6a170e5560db77ad83afdab74204e2900c2e3d368f632903efa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
