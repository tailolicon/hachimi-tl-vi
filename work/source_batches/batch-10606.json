    },
    {
      "uid": "zhcn:a8265e89ca7ca8b55e68349f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不懂得放弃的雄风们",
      "source_fingerprint": "a7d3274ee632d395e475f69995305d644ec94d740ad83cd1316c6fabfc6a2010",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
