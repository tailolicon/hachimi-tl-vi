    {
      "uid": "zhcn:b8041c11800a76dc499f9a49",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──“皇帝”鲁道夫象征以惊人表现\n赢得了“日本德比”。东海帝王想要像她一样\n成为不败三冠赛马娘！",
      "source_fingerprint": "a770403338e3889f8d5072c9ee4f97b5b0a91a82351156b43b825323682424fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078401.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8d8cfbc86f533b4d68595c1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078401.json",
      "json_path": [
