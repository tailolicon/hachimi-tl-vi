    },
    {
      "uid": "zhcn:fb5605f54d821e4c81a4f7b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无形却也要伸手掌握",
      "source_fingerprint": "b4fde87ece7670f30c5fb287218b0d273df02d1ff4fabf233e6afe2460650da7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
