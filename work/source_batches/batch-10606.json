        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:45afc423c4908719e2b501d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而也文摄辉则是崇拜着“英里皇帝”。\n虽然彼此尊敬的对象不同，\n却因同为“憧憬”努力而志同道合。",
      "source_fingerprint": "a7e7e97c45bbacf89cfa809b7053518b606d35ffa1040c9f93bece0238722733",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078401.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d0ca06e62e83d2757ffc4758",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078401.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:06568126f2ea92f5fa79f91e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉选择走上英里路线；\n东海帝王则是三冠路线。\n纵然路线不同，却都因不想输给对方而燃起斗志。",
      "source_fingerprint": "79800c2ca6d9fed7b2effa407400cc4dbd802cc1b24983b9c445b90b44cded7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:6e4e5642ee6ee4821b53e6ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": " 青岚，相互交叠",
      "source_fingerprint": "456a541ae8587a6ef6d6732491031f805b67b5f1a7b3f7bc3f2741f3c5979aee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078401.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:8488e9f5ac669f05efaf02dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:296f6ffc6f65063589c8ab90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉原本对他人丝毫不感兴趣。\n这样的她却深深被电视吸引。\n因为──",
      "source_fingerprint": "5c6239ecfdce82d1997876e0f8a066262dc16523bcff1e83a42ddfc6776ab8c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:323f6e6df5ab795d2cc9c8da",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:750927b776e11f3ca9bdb26b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王出现在节目上。\n她的目标是成为和“皇帝”一样的\n“不败的三冠赛马娘”。",
      "source_fingerprint": "ee2bf4bc5bb5ff408766b6e4386bd0d90db42fc76498e34ee1b8915c253e8eb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:76310a76d83e433ff3bd1c22",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a869191462ad94d8bbcba337",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而她却说起梦想的终点。\n那就是──\n超越“皇帝”，成为“帝王”。",
      "source_fingerprint": "1e6bdbb9c95fe2aabf5dff7ff8f29ad46afa314d6b738b8db0e2fcd7595123d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:155c1369dbd9def16db56f47",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:054f8e890e1bfa71a8dddb8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉从没有想过\n要由自己超越崇拜的“英里皇帝”，\n这天她因此发言而深受震撼。",
      "source_fingerprint": "8fc7feb76e4829eeddebd14a9e30cf9fc0393daec7ac266732bd3c8e25ca4c8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:acd0f915d09c68e0c4b9e811",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是风吹晃了花苞吧",
      "source_fingerprint": "307e59ce8b26d9c5af295029ec5c3f69dfdce964a8554468a86c5fddc68bcad7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ed04e02d075e50a886e43c2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:4aee4e5cbf76963b6de40159",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉决定将今后目标定为短距离、\n英里的GⅠ竞赛。\n因此她需要更加了解两个对手。",
      "source_fingerprint": "e0a52185ee715c4751294ca6be7feaa8f9642d919a1e0fd2e8d91e774cf28104",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:f4e9dc288f1e0046c2423537",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:dd6c54b03fe13e718c2d37d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一个是“华丽一族”的第一红宝石。\n背负着一族的荣耀而奔跑，\n她所散发出来的霸气让人感到沉重。",
      "source_fingerprint": "68b101048c7d4b5e94abf9729ec8ec1786738749f692323cc906d22a0a8babd0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:fdb1462fcec3d6c9da168d6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:2ed1950f4a9ea18b4d917055",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一人则是展现了相当惊人的爆速领头，\n仿佛速度无极限的大拓太阳神。",
      "source_fingerprint": "c47c70daa0a4b4dae5c2b694ccf0a396f6fc79e19992fa25f8ae4f0bc3e1a925",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:dbecbe4d7c6ede18393d2186",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:5729bbcb8978930c278a912e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这两面必须跨越的高墙另也文摄辉为之愕然。\n她因拓展视野并明白对手的强大，\n而开始感受到压力。",
      "source_fingerprint": "8f2dd9de3ddca297db8d176e4e27ffad4a75e7f3d259d7e686d2fe6477dc3ae9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:453ae576cc43e6096ba86c6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078403.json",
      "json_path": [
        "text_block_list",
        4,
