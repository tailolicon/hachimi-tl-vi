      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──“约定”可以有无限个。\n只要两人都不放弃继续奔跑。",
      "source_fingerprint": "3d00e5d0259c1d4a62fac3739776bdb3f70cc337c1871b8320305d6a1a925019",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
