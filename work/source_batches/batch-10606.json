      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉在某日，\n询问了同期的\n东海帝王的目标。",
      "source_fingerprint": "abc6b5d0b8822a6eee5f831732023f03c3cb3e1059d27a1146f64b76d9ba1712",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
