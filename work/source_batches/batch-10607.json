    },
    {
      "uid": "zhcn:1a3e9189d0b7e9dc0daf1b1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "像是在相互较劲般，\n东海帝王也在这之后成为了不败的皋月赏赛马娘。",
      "source_fingerprint": "15100848a2a7b2959ee62fcf1013cac62aed169c2981aa4633d563d45b9f826d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078418.json",
      "json_path": [
