    },
    {
      "uid": "zhcn:71b75443b4b9811155d7b641",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・风的起点",
      "source_fingerprint": "de6b34d00edf36b5762e13ab5023fa76f1a79a5bd3d57f42c82d41002e6a7683",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
