        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:e5112af868d7f815cd6779c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然如此，就该一边以英里为中心，\n一边同时参加短距离竞赛，\n将跑速锻炼到更上一层楼。",
      "source_fingerprint": "540207aabd8096446ca0f58cb95a401354a634b1ac5a15fbf7153d59e6a5e287",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
