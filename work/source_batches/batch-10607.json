    },
    {
      "uid": "zhcn:f45250fd8dca85612bf6070f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人回到学园后开始商讨今后的事情。\n为了追上“英里皇帝”的脚步，\n她主张挑战走上英里路线。",
      "source_fingerprint": "5b6b7af3555aa3f934f82d05b9899a0d63458d37f496186454e69aa180958392",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078417.json",
      "json_path": [
