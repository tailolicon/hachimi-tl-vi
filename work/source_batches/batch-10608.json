      "source_language": "zh-CN",
      "source_text": "出道战时期还对周遭不感兴趣的也文摄辉，\n此时却主动提出想了解对手情报。",
      "source_fingerprint": "e1b84fd4863f289d59dd193761d15824f9f13a60eae228f9ce5858be26439bc1",
