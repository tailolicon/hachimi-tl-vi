      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:08cc39c5b0834ce34e09f2be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葵S结束后・乾风的预感",
      "source_fingerprint": "c2ad06a3034ccff886314ce2ba616277a0603f46b446591e242e7fdb473a0e1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
