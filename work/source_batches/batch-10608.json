    },
    {
      "uid": "zhcn:a68fc8379e36726ad2fd2cc5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉顺利在“安田纪念”获胜。\n这么一来，\n就完成了“称霸三阶级”的第一个目标。",
      "source_fingerprint": "01c7bb52b383bd28c847ef9784fed62003b1a3ccd8069165e029f3409b3e4951",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078422.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:fbb080710c0d417ae0e64669",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078422.json",
      "json_path": [
