      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:042f858d89fd7c1a266c8b99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉使出了浑身解数，\n甚至感到自己在比赛中成为了风。\n同时却也觉得还有进步的空间。",
      "source_fingerprint": "9f10df30964ec8fd2a76ba914fc9e1b44c34e642d074a5f7ef412c0e8304a9cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:fec9dc0d0fbd3bb02296fc0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:36f3e00798797f827220057e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在观众席上看见写着“摄辉魂”的横幅布条。\n誓言要将粉丝们的支持当作助力，\n成为更强大的风。",
      "source_fingerprint": "da4c08f9f69445477e9ce6fa137888b38402c87c50fe49553cd6a61fa8fc2dc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
