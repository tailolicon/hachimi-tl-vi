      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:78a553c8248f2452cc92d2b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜者舞台结束后，她说道。\n自己就是在这里遇见“英里皇帝”，\n一切都从这里开始。所以──",
      "source_fingerprint": "c5e73b68cd5bc177a785b5c0f2cab2db6c0b0a81cbc958b88b1cf1db15bdaf1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:145ba75568d9cc2ddb0749a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:7e065786fd6c425d942a1fdd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她决定将下个目标订为英里战“安田纪念”。\n超越“英里皇帝”的“称霸三阶级”\n要以这里为起点。",
      "source_fingerprint": "3ea85c45ac2a54e906d1a7a2bcd926c21a496711250d22c97848816a8d1c3724",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:0e9d15e93f5e1de1e996c19b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "英里CS结束后・风从这里开始",
      "source_fingerprint": "ca35f6414f5fcef020fcf8f6ca0f207855e31ff0a349fc52a46952e55b03efbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078421.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:9b855c345cfb267130c7cfe9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078422.json",
      "json_path": [
