      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:7cb69e964a8bb5b7c42d0daf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078420.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:f78fee0362eabd0ce8ec5b13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东海帝王说道。\n亲眼看见了这样的比赛内容，\n让她更无法放弃跑步这件事。",
      "source_fingerprint": "b508cab90b60c9618b9a48e4ed79e23aea1853773327860fbb97512259b75426",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1078/storytimeline_501078420.json",
      "json_path": [
