        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:0c427ab5f7de91dc9ef27db8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "体感装置有让你感受到雨风吗？",
