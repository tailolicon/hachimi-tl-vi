    {
      "uid": "zhcn:2f899b4f5b72874d582f3376",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也文摄辉又问了一样的问题后，\n走到了外面。",
      "source_fingerprint": "55049075f6a3afc8e57d533e9f04c1c30b769ccb19a2c8c9c561f2b00c4b00d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
