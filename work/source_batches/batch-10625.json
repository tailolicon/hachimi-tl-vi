    {
      "uid": "zhcn:55314aaaf428ac0769bb5847",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，你喜欢雨天吗？",
      "source_fingerprint": "5c876bf51023642ed25edccf4561b0f236551ea6c79b9a7085b4a3b6136066f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
