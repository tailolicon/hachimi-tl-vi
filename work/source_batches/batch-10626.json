    {
      "uid": "zhcn:61d5ef94a12b311d34441c8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我能成为风，但却变不成风筝呢。\n训练员，你有没有什么好建议呢？",
      "source_fingerprint": "b9ecec222e237cebe3b97e43926892082669ef70aef27aad6fd0f09b27ed25a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
