        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:711dddeb365c7063264dc377",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美丽又梦幻的星空在我的眼前延展。\n还有不知从何处飘来的香氛薰染，\n让我整个人无比疗愈────",
      "source_fingerprint": "c79567db92822b19062473ffa8cc3363a2493d6c89607cf54338c270e8d45a0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083107.json",
      "json_path": [
