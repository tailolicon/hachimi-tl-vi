    {
      "uid": "zhcn:d1be586a0f74b5d77cbd35a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使如此，\n就算怀着无法抹灭的不安──",
      "source_fingerprint": "5f4d158a0ac76075000b749c4b8922bde33789c0e7faae8b4c8db7dab32afb6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
