      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:53eca3b23ced988bba5e356e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──没问题的。我并不害怕",
