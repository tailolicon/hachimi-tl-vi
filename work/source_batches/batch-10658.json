    {
      "uid": "zhcn:a90dd171d065739ceb5ae76a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "评论员",
      "source_fingerprint": "d370d7d5b07c4a4699b9f2d0596e9a21fa324599b68df12ee0fb6c8835c38f8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
