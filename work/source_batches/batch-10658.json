    {
      "uid": "zhcn:a2d79ac56e2919cf4b6ce0c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒的“资质”至今仍深不见底。\n这一点是最可怕的。",
      "source_fingerprint": "b0e93e9ecdbf9f37a0b46c3940a6428680bfcb88cd2a3614f82f746a47cf7abe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
