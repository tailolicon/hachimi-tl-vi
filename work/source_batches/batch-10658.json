    },
    {
      "uid": "zhcn:476200eccf5cf4ed0a4c49ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的赛跑能力甚至可能会在“日本德比”\n进一步开花结果──",
      "source_fingerprint": "a089e2b1781f9f424b8f3c76d8c463ebac9d64a01081db5cffe5f69e167f2771",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083113.json",
      "json_path": [
