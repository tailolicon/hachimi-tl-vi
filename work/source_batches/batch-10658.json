      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“谷野美酒的参赛计划，\n果然也是独树一格吗？”",
      "source_fingerprint": "1773aad5976469ae1ebfd8883302f41a57b151472f480cc5340fee733d00458f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
