      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:fb9731ef867bfebb50371090",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想美酒是期待看到你出色的表现",
      "source_fingerprint": "963fe2b5b8b4109ce18b0ad719e5084e4741208e3109140b38237843c26e9294",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
