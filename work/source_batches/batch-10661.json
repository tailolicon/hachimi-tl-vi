      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒对吉兆说的，\n一定就是她的真心话。",
      "source_fingerprint": "85c726333193bea1f1891f7c0314b9f92b76138e379e657d41ef208094c5b50a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
