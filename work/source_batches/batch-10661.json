      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:98d8070c6353c4758277aefb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以吉兆在自己的道路上勇往直前，\n应该也能回应谷野美酒的期待才对。",
      "source_fingerprint": "0f98ef7acc1904294fe799815feaf90934fc75ec2bc1891e0c29694eea76316e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
