      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其结果，就是我现在坐于死荫之中……\n这就是代价。",
      "source_fingerprint": "e1b1fa8b031b853527447ea8623ec3e2820dfafe954f5d22edf8669ee3d4bee9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
