    },
    {
      "uid": "zhcn:5ac9469563ee972aead136cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "重振精神后──以绝对强者为目标，\n首先朝“天皇赏（秋）”进军！",
      "source_fingerprint": "81a5087e0c92956187160a21eece9cd7da4f1f917a674dbfe5e82e5031277bb5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083117.json",
      "json_path": [
