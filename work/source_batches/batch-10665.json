    {
      "uid": "zhcn:c1d5559e686962ba66d9d092",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许压在吉兆心头上的事情，\n与跳舞城的狂热有关…………",
      "source_fingerprint": "73ca4610545e2c9be07e9e7079b2af7d6b165bc1c9870c792733a685d470aaaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
