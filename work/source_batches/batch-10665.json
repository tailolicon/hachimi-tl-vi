    },
    {
      "uid": "zhcn:1f3db82f3985912ead2a6b7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了打破僵局，\n我下定决心、安排计划，\n以便与吉兆好好谈话。",
      "source_fingerprint": "32405bb34a9288e27ab9b8da4b7ff725487bf1e055a6cb2d002990e6597cb35f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
