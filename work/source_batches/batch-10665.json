      ],
      "json_pointer": "/text_block_list/103/text"
    },
    {
      "uid": "zhcn:5917ab77685d67bfcace32a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到她的神情后，我忽然有股直觉。",
      "source_fingerprint": "889987a521e55d1e1ae2defd898f2018a3d31d00ee87808719942f057a7abd44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
