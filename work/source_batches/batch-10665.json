      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（果然还是得找个时间沟通一下才行。）",
      "source_fingerprint": "b14869f5a902739824129393e34b85f82b085b0941fbe9e25f56028d999eeb20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
