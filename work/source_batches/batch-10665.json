    {
      "uid": "zhcn:ae6cc42e5037a83990481661",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "────我们重新开始吧。\n……开始我们的──“使命”。",
      "source_fingerprint": "afc173061ce6ccebef0530f4e874e07300c99e43624a149ca80400cdea052761",
