    {
      "uid": "zhcn:a4b37aca219c920498428727",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Wow!\n──那家伙让你露出了很棒的表情呢。",
      "source_fingerprint": "eeae4b644a6973bb8d0c0ad7b18da6ec1e9bcc01626d24c15db3eb795e1dd694",
