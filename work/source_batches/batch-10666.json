      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "英雄……舞城────",
      "source_fingerprint": "32a893ca17f51c0f9d7dd62ba2a18ad2f9fb84901209aea99c39289933ce377a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
