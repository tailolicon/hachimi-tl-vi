    },
    {
      "uid": "zhcn:051798c5de781e0c625a99f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你觉得她们为什么这么努力？",
      "source_fingerprint": "0cc73c8385a1b32a9096ab8dd965673ec41718882ec14e5ec1a688d370e13c36",
