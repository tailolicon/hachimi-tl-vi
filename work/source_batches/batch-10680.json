    {
      "uid": "zhcn:82519359e525df28239345c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“青叶赏”──我想参加这场竞赛……\n作为milestone──中程目标。",
      "source_fingerprint": "bf5d47cbe56841de5e24370db9ae4d42c9aa276dd37e9c5424cb146a99ef691e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
