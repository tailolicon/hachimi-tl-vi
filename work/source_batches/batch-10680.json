      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吉兆",
      "source_fingerprint": "33a0f36db3e54f4e2fa022c8d29dd07a8f024a475cae2ddfb01ad1c1967834f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
