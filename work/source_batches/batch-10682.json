      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你有自信能在1600米获胜吗？",
      "source_fingerprint": "91df11203acce6b3e58e2efaea19982f05cfdb49a60dde3293ab64367b27efba",
