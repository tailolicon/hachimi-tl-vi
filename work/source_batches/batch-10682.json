      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果能在这两场比赛跑出令人惊艳的“成果”。",
      "source_fingerprint": "799781fa768f1ca7e6ef0b703dd02d6f81c622dc1e12f04338e7eece61b1290c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
