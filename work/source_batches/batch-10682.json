      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………！\n原来如此──美酒她──",
      "source_fingerprint": "7f40e18478b8fcbfe3f9dbeab7d2aa1fa37c1d134412910d8d3875d589c76167",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
