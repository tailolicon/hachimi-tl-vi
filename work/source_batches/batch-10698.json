    {
      "uid": "zhcn:56fb4f01ac9a1b356a622c9c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄询问吉兆，\n为什么要选择“青叶赏”\n作为“日本德比”的前哨战？",
      "source_fingerprint": "131e1fcdb53ee827478e12f695f5b55fd5aaaa58e394af815adb3afbca731911",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083409.json",
      "json_path": [
