    {
      "uid": "zhcn:620b644d0cdbc22123611877",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083409.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:5e6d2c13eec649492c130bbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曾在“青叶赏”获胜的赛马娘中，\n没有任何一人能够称霸“日本德比”。\n这是很有名的“‘青叶赏’魔咒”。",
      "source_fingerprint": "78c0ea8dd3b48747b574af58f2e8cb0c2726ebd79a69c140345eed65510a5100",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083409.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
