      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:8eb76aaf1c750dbc0ad685e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要成为绝对强者，成为大家的“考验”就好──\n训练员如是说。\n听到这句话后，吉兆走出了迷惘。",
      "source_fingerprint": "5461ea26d40746ead7e81e0c87cc6b326c5b017bfd183106ffbb39c4050f66a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083405.json",
      "json_path": [
