    },
    {
      "uid": "zhcn:385e30473b37253bfd430db7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083410.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:e333ee757e41187fc4ccd8ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但吉兆跟训练员说，\n无须隐藏不安。他们的内在有着一个共通点，\n就是能够将他人的愿望当成自己的愿望。",
      "source_fingerprint": "f9ed70d1fe562f397a307d3b5da61f9a95d85b83646e4ffb107e6c77e8687bf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083410.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
