      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083405.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:727c61c952ac6b2d61a548cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吉兆堆砌的成果，\n已逐渐改变了日本竞赛界。\n而她自身并不必成为“革命”的旗手。",
      "source_fingerprint": "cb81228b1a6e9cb41de080740bf4a4ee07708ddaeeef0e4668f57b72bd691274",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083405.json",
      "json_path": [
        "text_block_list",
