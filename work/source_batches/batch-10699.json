    {
      "uid": "zhcn:482184ab959fcc59e0ac447d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天后，谷野美酒告诉她，\n自己将会参加“皋月赏”、“NHK英里C”\n与“日本德比”。",
      "source_fingerprint": "5c393bd9848b72fe1178b6bddf51a7bfcf1bb2217ca8d3218f3c1adc3c681b96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083418.json",
      "json_path": [
