    {
      "uid": "zhcn:1a19f991ec9408c4304ef20a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吉兆确实感受到她的热情与强悍。\n也正因为如此，她下定决心保持冰冷，\n并前往参赛。",
      "source_fingerprint": "395544f91040794ac19423bfe4b7811718ba65b49c0ec11d6dfea1d3a6aeb826",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
