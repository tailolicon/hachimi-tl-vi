    },
    {
      "uid": "zhcn:0b0c8b22955b9aa98c31f16c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・Raison d'être",
      "source_fingerprint": "fe79b53ac9e20808a8d8a8692e94e0497436881f4bf902d69be65db627e85a93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
