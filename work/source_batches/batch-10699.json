      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:42629fb03a2edf5e41cf0ecd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向有马纪念",
