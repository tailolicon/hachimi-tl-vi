      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:e7786b4afd72442b7461cd74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后，谷野美酒宣告谢幕并离去，\n吉兆推测不出她的真意为何。",
      "source_fingerprint": "f75dc79ce9da037199d35af2ab5eceff8668472acf1586234d7bff3d4e93d2e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083423.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:5250d66f86c1f2d8e911841c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
