    },
    {
      "uid": "zhcn:93859242432e40bbe99fc26d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跳舞城想知道吉兆\n要如何完成“革命”，\n于是提出要在“有马纪念”决一胜负。",
      "source_fingerprint": "13097c50c37552ff40c09ece0f703a4bca555bedc40f275ee7200c630627ac6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083424.json",
