      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a52d631da35cbc39fd48fb0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某天，在古马级大显身手的跳舞城，\n向吉兆挑战斗舞，\n情况一触即发。",
      "source_fingerprint": "1b7b6060a55b3ed402ec8f61bc4cb4cc36c1037f85a785e5d3b6e44fc961b91c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083424.json",
      "json_path": [
