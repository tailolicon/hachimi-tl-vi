    {
      "uid": "zhcn:c95b38a1642044e6cf01502b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她冷淡的反应令观众不悦。\n另一方面，荒漠英雄目睹那败北后也毫不动摇\n的姿态，认定她是必须视为目标的“英雄”。",
      "source_fingerprint": "7b3e189804a7af1042ceb71348ccdd22e802cf4f1df96fa69b30bd3c16754817",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083423.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8866b80fd0ed19a09aa48cd2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
