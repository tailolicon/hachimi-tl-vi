      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:04308d59c9ab8cbe410f2670",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "随后她告诉训练员想要参赛“有马纪念”。\n训练员支持她的决定，认为依她现在坚强的实力，\n在有马纪念也能有精彩的表现。",
      "source_fingerprint": "4d792bd7d02c8994624b97db8cf525f5bd9e3d2073f8030bb3e1413928b903ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083424.json",
      "json_path": [
