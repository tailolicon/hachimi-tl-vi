      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:db1f85273e08c562ce1487e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒虽然败北，\n但她的表现令观众陷入狂热。\n吉兆感觉自己无法创造出那样的狂热。",
      "source_fingerprint": "fe7afd121c0344d3a89028f39235dd8b67cb30b51c079a79418c4657c07b1b11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083423.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:9076d62658ed55860c67f3c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
