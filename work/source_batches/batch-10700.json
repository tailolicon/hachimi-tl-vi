      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:4581abfb8cc21a1608d07399",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吉兆思索着\n跳舞城以舞蹈所掀起的狂热。\n她认为那种狂热与谷野美酒给人的感受很相似。",
      "source_fingerprint": "6235b6c672a133a26fc07b2582a11afdfb53d3430665066a961b2d7150f27ec3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1083/storytimeline_501083424.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
