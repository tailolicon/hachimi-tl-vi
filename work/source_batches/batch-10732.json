      ],
      "json_pointer": "/text_block_list/48/name"
    },
    {
      "uid": "zhcn:b718b3c6f405da948f7d57c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──那就是“MC参赛计划”。\n这在近年开始蔚为话题，\n也正是谷野美酒想挑战的参赛计划。",
      "source_fingerprint": "25b2da8c5b7986c7d03b8c1fa8f0c00eb4d1b4cd26bc4eb7183110d5d48bfcc6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:52bd4be02d8aa05a67bf99c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        49,
        "name"
      ],
      "json_pointer": "/text_block_list/49/name"
    },
    {
      "uid": "zhcn:39771e1569356d1e4e3ad8f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这个参赛计划里必须连续参加\n1600米的GⅠ竞赛“NHK英里赛”与\n2400米的GⅠ竞赛“日本德比”──",
      "source_fingerprint": "a48c40650f6c2079fea9408bfef7e83c054d6c6589184df69f09939ab7de9c44",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:9cc15a0438d0392ecfbad8bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒",
      "source_fingerprint": "313e63f64ae1904fcf07bab0ada331d13e164e5dd9cfb8cdad386ace12e23d08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        5,
        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:2e8ec828985e1a49cd84ee2b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要以名为吾的理想！\n彻底摧毁世界上的一切法则！！\n已经没有人能够阻止我了！！",
      "source_fingerprint": "6322a2b327b0c39df97f6e07c75500b8d5d1abc4e21cee12daa6b4365975ac6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:42fc4c865280affb9884058d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        50,
        "name"
      ],
      "json_pointer": "/text_block_list/50/name"
    },
    {
      "uid": "zhcn:795b4afa5ab39d4554eb4580",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "核心思想是以1600米证明跑者\n与生俱来的速度适合英里赛，并透过2400米\n证明其综合实力足以称霸中距离。",
      "source_fingerprint": "08aa8a793e155fa0ad79e9229f746c8247e8deed370d035df00ab2f1b79a5aab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:e0c906cf5edf5c8e22f04d18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        51,
        "name"
      ],
      "json_pointer": "/text_block_list/51/name"
    },
    {
      "uid": "zhcn:3396758d8f810dc89a0ec397",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以优异的成绩达成“MC参赛计划”\n将能大力展现出该名赛马娘的\n“资质”有多么出色……！",
      "source_fingerprint": "519f8cdffd94e56ff017bb2e42fb5165cc00684d914b9324d6b19802a103b742",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:6183aaebe74cb649d3099290",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
