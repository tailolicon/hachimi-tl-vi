    },
    {
      "uid": "zhcn:be0a4596588c46d2f648ed83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最糟的情况是\n跑者有可能会受到致命伤害──",
      "source_fingerprint": "b3e6aadaa7caae91752be8de0a39f617366a92dc52e133574ad8772a7305ace8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:cfce1a32c0c50dc67f4c61a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒",
      "source_fingerprint": "313e63f64ae1904fcf07bab0ada331d13e164e5dd9cfb8cdad386ace12e23d08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        56,
        "name"
      ],
      "json_pointer": "/text_block_list/56/name"
    },
    {
      "uid": "zhcn:0bd44dd631b50c9c88057474",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──当然，我知道这是严峻的挑战。",
      "source_fingerprint": "f11f500e0c3c0c50c733997d44b395f3cef3330a2d885cba201d09752db4ea74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
