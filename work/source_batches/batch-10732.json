    },
    {
      "uid": "zhcn:b331a29e13af4c246005c910",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“NHK英里C”与“日本德比”，\n这两场竞赛间相隔的时间很短。",
      "source_fingerprint": "d2884ed9fee77362440099e005775f1ada7c1d82111378af9fa152a665e80fd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:c5272a65dfa55b73ebae39a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
