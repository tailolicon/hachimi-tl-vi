    },
    {
      "uid": "zhcn:44009ecd7e8e24f8c088b63a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对，没错……！",
      "source_fingerprint": "57c4d13da63acf8c519b8406d2e49207e44e386dd88359068f4fd41a8ee13bd3",
