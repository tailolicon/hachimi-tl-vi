    },
    {
      "uid": "zhcn:e6eb7a15e4b885457c034633",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对于身体还没有锻练好的经典级赛马娘来说，\n要在这么短的期间内\n参加比赛实在很严苛。",
      "source_fingerprint": "388d6a032895e8ac20329ac49f577f7a396d521db0c3aaf34723cccaf17b7890",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:d9290b04f2002dba512d1d7c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084100.json",
      "json_path": [
