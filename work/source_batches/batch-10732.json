    },
    {
      "uid": "zhcn:f0325bd7f3f8223da8931d8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是！正因严峻才值得挑战！\n其中有热情！有酩酊！！！",
      "source_fingerprint": "56d24bf9e4da86a80e1c216eb0cfab0351acb9dbb222c04a118912989955c2af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
