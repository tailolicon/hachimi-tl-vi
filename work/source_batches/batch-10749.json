    },
    {
      "uid": "zhcn:50ba0443dcf03d17a80677f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊。\n从吾的角度来看，她也相当特殊。",
      "source_fingerprint": "3111a89f061050c88a187910031f0934deb52f6e7badd2f261ae252ed9a5d7fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:d07b85b80d28e91584180096",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒",
      "source_fingerprint": "313e63f64ae1904fcf07bab0ada331d13e164e5dd9cfb8cdad386ace12e23d08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
      "json_path": [
