    },
    {
      "uid": "zhcn:0a94720934bc048663998d0e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "坚定的意志与一致的步调。\n由这两点酝酿出无人能敌的气势\n相当类似于大自然的严苛无情。",
      "source_fingerprint": "8e9d508822a05dd1651715b746b4e3b01508af11702b970fb463ad3422fcd046",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:73bd83d276412555c28de9b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你也很在意她呢",
      "source_fingerprint": "449d33aaffc14a41f19cdedde3fb0e7d47b5a823e288786c23a6b91ab797087e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
      "json_path": [
