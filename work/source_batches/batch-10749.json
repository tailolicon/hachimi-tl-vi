      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:198c8833edd8a83be48fc660",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒",
      "source_fingerprint": "313e63f64ae1904fcf07bab0ada331d13e164e5dd9cfb8cdad386ace12e23d08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
