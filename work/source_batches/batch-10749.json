    {
      "uid": "zhcn:aff4e7ade1aa058e5b00f5dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，\n竟然在这段时间内整理出如此详尽的调查纪录，\n你还真是疯狂……！",
      "source_fingerprint": "4c796939d1a0e17aa2279b17e6ad3a69169ba3f48a15bdf5e40f613ab196b48c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
      "json_path": [
        "text_block_list",
        32,
