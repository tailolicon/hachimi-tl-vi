        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:85e0c57854df47d8d5d264b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──在那之后我顺势把自己整理的\n同期赛马娘调查纪录拿给谷野美酒看。",
      "source_fingerprint": "7f0ab2f563a425de67011d343043d555854a3d0fedbb52a00cf7d6da7178ba76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:a28ca821b1a74eff8bab2be6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……因为我是你的训练员啊",
      "source_fingerprint": "4a5e138d0b2ff26b753e86996b4bddbb35564944b57724a225411038edb47335",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084114.json",
