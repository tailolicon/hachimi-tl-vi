      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:df31baa9b30c01013ede21cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒前进得“迅疾”且“有力”，\n如果要与她以实现MC参赛计划为目标一同前进，\n我觉得自己做到这样仍然不够。",
      "source_fingerprint": "cde07c0e01b5bee5cec43fc014bfdfae71ebe4bc0e5aabe91fc3a3e41123a2a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
