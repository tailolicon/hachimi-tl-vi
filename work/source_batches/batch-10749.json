    {
      "uid": "zhcn:db508b5fb1ae4298dbe4cef6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不知道会是\n“现在”还是“往后”。",
      "source_fingerprint": "c2fb6db44689a083c8838c07f1594f0bc4a33c82d05267ff660663a2ec558694",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
