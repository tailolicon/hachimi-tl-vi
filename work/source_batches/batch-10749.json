    {
      "uid": "zhcn:c8b8fafcf2ee75e4858a6a5e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你也要继续观察她，\n才能稳固我的剧本。",
      "source_fingerprint": "244ac56a5b2007bacf348c309e8802aff51df2659ab778ab801eacfefb1b4f11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
