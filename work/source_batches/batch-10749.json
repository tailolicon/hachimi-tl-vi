        22,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/22/choice_data_list/0"
    },
    {
      "uid": "zhcn:ff018d1ed93fdc65e4abeca1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你也很在意她呢",
      "source_fingerprint": "449d33aaffc14a41f19cdedde3fb0e7d47b5a823e288786c23a6b91ab797087e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
