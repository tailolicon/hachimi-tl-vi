    {
      "uid": "zhcn:5d4a7fbdf359846b8527fc4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啧啧啧，你别误会了。\n我不是想要表现得像个暴君。\n我不是说我明白你的用意吗？",
      "source_fingerprint": "bfb9f7a7b46e99a3a694e5cfe7f61b16cebe4bae486f2603305f6dbee325f664",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
