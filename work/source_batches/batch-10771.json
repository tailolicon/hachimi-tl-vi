    {
      "uid": "zhcn:8268f8577f33c98a1f9553a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "吾又怎么能够反抗\n源于自身的狂热？",
      "source_fingerprint": "8b3696bfd20cc4fcac8d1000ad609e9d453d80ded075b25d93353482e2c389c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
