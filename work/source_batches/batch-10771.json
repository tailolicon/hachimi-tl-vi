        "name"
      ],
      "json_pointer": "/text_block_list/29/name"
    },
    {
      "uid": "zhcn:2669043f48b519f18ef9f01e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──呵呵，我真是可怕。\n现在比过去更能看清自己的使命……！",
      "source_fingerprint": "9b26f776646422a85383bd3f0f69d3f55fa3d0fd267450a4445eee928cb6e517",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:0c1116216fb0bf89d5eea6e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众A",
      "source_fingerprint": "eee86b64dc7889c9a8a0c3464472500fce48b2487b81ae5e25e0e3845b56d9ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:5d4ba08e65599789c35771a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒跑起来果然很强悍啊！\n感觉她有机会成为\n“皋月赏”主角之一……！",
      "source_fingerprint": "43e2046296167070dadc7f2b4949a9e2082d778c50496e8b06fee842b8305249",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:ca57ffeaf93424b4bf9dde0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……谷野美酒最近\n以前所未有的速度急遽成长。",
      "source_fingerprint": "e1af3f04819d8f23bc8586f14aa30ef394d47b8d68113a0bc427293bd5eec84f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:2bd19b84ec17e14c89c4d698",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我原本就知道她蕴含着相当惊人的潜能，\n但是──\n或许连我最初的看法都低估了。",
      "source_fingerprint": "f9687d8fdd3a440ae9f6b29933a6fefd21aee589d54cfa6e4e302a8f78a85d42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:24e428cb902e2e3f0871f8b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为看见她如此令人惊艳的成长幅度，\n所以我的大脑最近总是会浮现“某个想法”。",
      "source_fingerprint": "7859a4c4a9dd1d676039f4e9a45396012334145f44889b23f4837e9da143f534",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:8653f40ac20d31a37015f961",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……谷野美酒或许能够达成\n超越“MC参赛计划”的壮举。",
      "source_fingerprint": "e0e5661c7e78f2ace5550b65a047f90a761c01f8150bb9385d6e773c5fc3dd63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084304.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:33587d57f45701b514ceaa90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "或许她拥有的力量\n足以创造非凡的成就，\n将她自己的名号打响全世界。",
      "source_fingerprint": "55ee0a30cc106f006fdd9d3b3f0eb48c6f0cf741ddec7e28b5ef05167858c2ea",
