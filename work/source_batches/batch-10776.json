      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "────唔喔喔喔喔喔喔喔喔！！！",
      "source_fingerprint": "b2b4eaea2a2932b08be077d5e9c27929e5f088e5fee7748488a720c68b409d1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
