      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:0e1cc70a561e7a72b04f0e68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "评论员",
      "source_fingerprint": "d370d7d5b07c4a4699b9f2d0596e9a21fa324599b68df12ee0fb6c8835c38f8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084307.json",
      "json_path": [
        "text_block_list",
        37,
        "name"
      ],
      "json_pointer": "/text_block_list/37/name"
    },
    {
      "uid": "zhcn:ebd7f708e6cf5f85450d0f1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“──哎呀，她在NHK英里C表现得真出色！\n只是这也让我很担心她要挑战德比的事～”",
      "source_fingerprint": "967e1159f233b5557526f43ae18dfc5efc91afd6c0a2af768162ffad1438302a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084307.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:e4ddfdedc5f8875690837409",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主播",
      "source_fingerprint": "a41fab00b502315e18b62c8a7c2005b4a4d8106674dcc0e84f72853d5ffd7c64",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084307.json",
      "json_path": [
        "text_block_list",
        38,
        "name"
      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:3530fc4bae93672be4fc6f8a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“两场比赛相隔短暂，\n她在这段期间内是否能完全消除疲劳？\n看来这会是倍受关注的一点！”",
      "source_fingerprint": "b1b0bd6d69911760c32d3eadb296d0a9f2b02cdbae1a07b678df7389a033cc6b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084307.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:2466929788ca9d580eac423c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "评论员",
      "source_fingerprint": "d370d7d5b07c4a4699b9f2d0596e9a21fa324599b68df12ee0fb6c8835c38f8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
