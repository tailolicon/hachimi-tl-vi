    },
    {
      "uid": "zhcn:98fb700cde7509133048895e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这部分就再看看要怎么做吧。\n好，那么以执行这个方案为前提\n立刻进行评估吧！",
      "source_fingerprint": "64222493c7057e99145cf307fafbde7e57d4c141c24ab844def2f30496d3fc9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
