    },
    {
      "uid": "zhcn:45a163e4b0af4261ca3c1a55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒",
      "source_fingerprint": "313e63f64ae1904fcf07bab0ada331d13e164e5dd9cfb8cdad386ace12e23d08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
