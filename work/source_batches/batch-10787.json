    },
    {
      "uid": "zhcn:320574380ab0e8a19b30ab16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──但是，我不能因此裹足不前。\n我现在应该要让谷野美酒\n能够再次参加比赛！",
      "source_fingerprint": "26784bea4bbce8d28f33ee2f1b9019b34a752094c1ff203d1de13542ad57a7ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084311.json",
      "json_path": [
        "text_block_list",
        57,
