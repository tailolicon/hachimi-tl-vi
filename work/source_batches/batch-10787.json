        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:5878dff78879f6c70ccfdc07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "都是我能力不够……",
      "source_fingerprint": "b904cb0c4061169e34798b5653ff3006ebcf42b532d820e470881035ccc58248",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
