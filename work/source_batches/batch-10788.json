    },
    {
      "uid": "zhcn:d6cdbcaf91321e6ecafc19f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒的复活剧，以及她的劲敌\n吉兆将要参加“天皇赏（秋）”的消息\n在社会上引发许多讨论。",
      "source_fingerprint": "7265b8044ab9b542b2bedd4d8192133e00a9391cb982ef9facfc379fa9e564f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084312.json",
      "json_path": [
