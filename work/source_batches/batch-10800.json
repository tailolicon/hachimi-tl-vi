    {
      "uid": "zhcn:e4c84c5abaecbbb3f86f04bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在经常拜访的酒吧里，\n对训练员立下的约定……\n比神话中的誓约还要坚固──还要甜美。",
      "source_fingerprint": "bb74f0b76d34a5bf71a6a28204b213fb0d84276bab848f1a2a960a68f7750a25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084400.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:0f5c418e94efbbce053be9e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒登场！",
      "source_fingerprint": "fefb33a91910149d6ea46abff193b2f54f4996677bd231ab200226fd4d3a4dec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
