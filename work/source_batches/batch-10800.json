    },
    {
      "uid": "zhcn:37fad7e72fff02453a36487d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员说要一起挑战“安田纪念”与\n“宝冢纪念”！要成为支持谷野美酒\n所有想法的人！为此愿意“赌上自己的人生”！",
      "source_fingerprint": "9a85a629abd4ac4d95e3dd26a947bd3fa047128350bc92d7218d108535868a54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
