        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:3eb8c129fc63edf8297e600b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经典三冠是主流！\n而吾迈向的是伟大之路，也是称霸之路！\n有哪个英雄会避开龙，而去打倒魔犬！？",
      "source_fingerprint": "da49229938adc8af7fffcb2dbb784cf99b355639966853f1c6869e55fad398e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084422.json",
      "json_path": [
