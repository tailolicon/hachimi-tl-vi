    },
    {
      "uid": "zhcn:e1a73d7f68e092760660a104",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谷野美酒",
      "source_fingerprint": "313e63f64ae1904fcf07bab0ada331d13e164e5dd9cfb8cdad386ace12e23d08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084422.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:9de3e4ec2f407c1a2bb94b45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "醉客希望我拿下经典三冠！\n无视这股热情有违我的美学！",
      "source_fingerprint": "3e2a3b32063ef12e357348610da83abaa0d7562d5349f886beede428131df9b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084422.json",
      "json_path": [
