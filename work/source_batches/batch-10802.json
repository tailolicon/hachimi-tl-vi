    },
    {
      "uid": "zhcn:359bbc4a38bcfe72c36a30fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "倾尽所有的力量，试着践踏我吧！\n有资格摧折的仅限──\n已有觉悟被我碾压的人！",
      "source_fingerprint": "74a3b0c6b2aeb1c44ea232e49e7f72ee9ccb960ca08ca089ecae5b3b718aaab2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
