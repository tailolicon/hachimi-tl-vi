    {
      "uid": "zhcn:5b3b8de88169fac03a3a66fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以及我的偌大考验。\n来吧，无数的主角们！\n世代最强的赛马娘！",
      "source_fingerprint": "7458bee8560e441b3e79863b2b57171275cedf0c3516380a20cee211442db65b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084420.json",
      "json_path": [
