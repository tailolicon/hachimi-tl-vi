    },
    {
      "uid": "zhcn:62967ebbb5601448e4b501ee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因此我决定把目标设于神赞纪念。\n等于说新马级是我熟成的期间。",
      "source_fingerprint": "dd482be0e222ecea8fabf92fd7e3a91a6dabae39245451fd8270ffd9275191e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084421.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
