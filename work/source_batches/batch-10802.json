    {
      "uid": "zhcn:22142f244453677bc619c1b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "挺身而出的英杰是热情如火、自由自在的舞者。\n秉持耀眼决心，走向险峻英雄之路的人。",
      "source_fingerprint": "825326e10e5c60e8711ea5b82f35d857cdcaed5febf705c9f54b61cc967ff36d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
