      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:7453ae9feb85612b00cebb2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神赞纪念结束后・已无退路",
      "source_fingerprint": "7b78622f2f67561d2c2579947d33e49826a43008ea7a49a04b1b64c81cadcd18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
