    {
      "uid": "zhcn:dec4b1bf16bc797cc8b44f1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我称霸了出道战。\n训练员对我那亮眼的可能性陶醉不已。",
      "source_fingerprint": "b8dadf838b4386ffa67851e6c494380cd608016b68235e5a8b1054ceca357511",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084421.json",
      "json_path": [
