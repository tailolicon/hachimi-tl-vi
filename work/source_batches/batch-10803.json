    },
    {
      "uid": "zhcn:6cf7fbf794bc6679864e5233",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "安田纪念结束后・重生的跃动",
      "source_fingerprint": "6a6a3ff0c05c5a1ed1e99b09fc0edca1f66d2a3856dfefecd7099954847aced5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
