    {
      "uid": "zhcn:d821fbeb5525454d5c5257fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要作为“破坏神”站上时代的顶点。\n该降临的应许之地是──“天皇赏（秋）”。",
      "source_fingerprint": "ee63baa5916f8bab8742ac33daec7281cb1da902302f68a058a2552683669c56",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
