    {
      "uid": "zhcn:8aa876ad073658ec3bcf6bad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个舞台是强者云集的“宝冢纪念”！\n你问会发生什么事？\n巨神大战啊。",
      "source_fingerprint": "5944bebab9a25a2c2a3a824326117d447a264742817eda8ef432d52c6ca77d94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1084/storytimeline_501084434.json",
      "json_path": [
