      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伏特加已经熟成完毕。\n她想要像我一样，打破思维的框架。\n她呐喊着“我要超越阿琴前辈”！",
      "source_fingerprint": "0f2a8081a4a67322bdf4d8fc309044d16b95ca04e499fb2335c42d7aec19388c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
