      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会看透你的真理！\n就让你深深地陷入酩酊吧……！",
      "source_fingerprint": "6a83bfab9fb8cee93ce078a9e336b4e6d9071f7a5e69bdcca90f3fb1a2ef0f21",
