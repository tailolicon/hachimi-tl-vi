      "source_language": "zh-CN",
      "source_text": "我决定了！今晚──\n要去看这片夜空里最美的星，跟我走！！",
      "source_fingerprint": "fa5440bd4949473cd2f40d0998bb6fd47cac6c8b770aad6f1c34109082135b4a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
