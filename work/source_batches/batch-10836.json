      "source_language": "zh-CN",
      "source_text": "如今我可以断言，\n这双腿的状况已经完全没有疑虑。",
      "source_fingerprint": "2238e818b5018fee27fea35574e9fb84a7d2def56d30bbd3bbc8462726e705a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
