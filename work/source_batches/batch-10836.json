      "source_language": "zh-CN",
      "source_text": "往后敬请关注“华丽一族”的\n崭新历史篇章。",
      "source_fingerprint": "b507b070660adac27a2afd62c0cc224bfc7b4ef3f16e4640a8a531ee9f65bb9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
