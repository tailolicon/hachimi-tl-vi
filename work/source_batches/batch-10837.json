      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "仔细一想，的确难以想像\n第一红宝石与家人围着新年餐盒，\n吃着里面食物的模样。",
      "source_fingerprint": "aece034ee511f9e4c1430cf45607d17565e3db7b036812e431ae644ffea6e6da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
