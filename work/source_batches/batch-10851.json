    },
    {
      "uid": "zhcn:3c06d47d4c20cf9086700495",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听说敝公司的员工\n也有幸出一份力。",
      "source_fingerprint": "140c9e339ec6c95b235a7928fdf1b79bf21194a1359de3cb52b6a1f356b8f1ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
