    {
      "uid": "zhcn:523985e4352ed0d2b59f84f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我很感谢至今发生过的一切",
      "source_fingerprint": "7681887168a07c45e97c57f3a4f5ac6c9b9e3d6875403924abb15cdcf2c011f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
