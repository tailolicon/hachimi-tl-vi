      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "报社总裁",
      "source_fingerprint": "ea6769d980bb464c3ab77599fa087ac2859bbc3a9060a44216c71f32ad8bd649",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
