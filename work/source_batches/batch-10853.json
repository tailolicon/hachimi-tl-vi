    },
    {
      "uid": "zhcn:07a34c04614ab69d271d8f0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我诚心诚意地对她表达感谢。\n说不定，第一红宝石在今后会打算\n更换训练员。",
      "source_fingerprint": "e48fae76871a50cd3b230a9ebf2fdcee9e92876495beaea1cca628de081839db",
