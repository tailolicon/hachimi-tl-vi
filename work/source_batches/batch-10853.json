    {
      "uid": "zhcn:62c185c05f237ee5e3cac8ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我才要说谢谢你",
      "source_fingerprint": "9cfd74ba6262c2be0bc744cbfb1015fbe8e7447fe74f31d533c1dec1c2342a7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
