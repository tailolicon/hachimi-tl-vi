    },
    {
      "uid": "zhcn:16c81c685fd980e001ebd8c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石斩钉截铁地断言道。\n她的眼神中的确看不到一丝动摇。",
      "source_fingerprint": "0e24868e5518e3314a8da1111a9dac8b59132c8cc46a2f965c92ac9960dbe3ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085200.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:25378bd7fecc5b60edde8a85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……去吧！",
      "source_fingerprint": "dd96e99ca6cc92ee00158fdf7fa761bea27f018745aa791c9d9281947793f44a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085200.json",
