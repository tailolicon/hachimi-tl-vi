      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我们去休息室吧。",
      "source_fingerprint": "e3c7449bbdacd15d12449e91cc98ecb290a94a9fe116fe7f71013e1af7e59afa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
