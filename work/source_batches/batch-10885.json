    },
    {
      "uid": "zhcn:b50e58734abb4ce548e8b5c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "依她的速度……我想甚至足以挑战\n极速赛马娘齐聚的短距离竞赛。",
      "source_fingerprint": "043bfe21fe0e71754b2bb5b28749a8c1c3efee1a00e128c2117a832646e31b4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085304.json",
      "json_path": [
