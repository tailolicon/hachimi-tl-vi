    },
    {
      "uid": "zhcn:7edce0cdad092ff2a9b94044",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！讲、讲完了！",
      "source_fingerprint": "f85a019ab75aa29be6312bcb62ef2f78a1c79f980f25388aea3ad1b607bbe9a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
