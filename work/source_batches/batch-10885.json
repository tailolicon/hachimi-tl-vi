    {
      "uid": "zhcn:95f0334523eadf5d2ae083cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "麻烦你讲评今天这场比赛。",
      "source_fingerprint": "39d5e394c31221520cd65bed030cdfd3b082731dfe67931550f2239043a6725e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
