    },
    {
      "uid": "zhcn:537345da44b6933b82c22354",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。不是直接去参加秋华赏，\n而是插入“玫瑰锦标”作为前哨战。",
      "source_fingerprint": "120de256835904e58cdeffc35cc4b2adef1e0d2c165827e38d6fb9d4ce4df503",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085307.json",
      "json_path": [
