    },
    {
      "uid": "zhcn:63c7bcac5b4915edd99c1e75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“玫瑰S”……众多赛马娘将其视为\n“秋华赏”的前哨战，\n以1800米的距离彼此切磋。",
      "source_fingerprint": "cb1298f04fe45643ed53c344f8f08437db478a778e9fc34de608b8b886047993",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085307.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:6ae797fee456119dcfc3ea8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石",
      "source_fingerprint": "9b56cd884b7441b8b32119740e379b8bc7aa840838b1c62bd9418c4a41cbf2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
