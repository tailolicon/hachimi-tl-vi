    {
      "uid": "zhcn:cc86933861fb6a2406bc6e54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一个目标赛事维持预定是“秋华赏”……\n不过在那之前，我有个提议。",
      "source_fingerprint": "53913796afec57e8e84c1e7d83c76dc17674b80e8f1037e638da671cbb2e7054",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
