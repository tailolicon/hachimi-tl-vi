      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:5c05e5264c347706ca221748",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那我先到入口处等你",
      "source_fingerprint": "1bb7f1c4a8d5fc55ae841a1a6681635d3d3160968b24304e892f31cc35ec1c0c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
