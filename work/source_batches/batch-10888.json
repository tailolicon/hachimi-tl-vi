    },
    {
      "uid": "zhcn:9b4c0746d8f5339cda729446",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与其在集训结束后留下空档，\n多加一场比赛的确也有助于热身。",
      "source_fingerprint": "f1193a48835c5293f6a488728f9e2974f94b06be34c1e42ec2cb41a34da2695d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085307.json",
      "json_path": [
