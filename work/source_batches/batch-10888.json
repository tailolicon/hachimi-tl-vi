    {
      "uid": "zhcn:408dfcb0d9402b03762596f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道了。",
      "source_fingerprint": "e4751dd24b1cc01c018d0bfc5e41666107f225b47c76b137af696c4a8217995a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
