    },
    {
      "uid": "zhcn:6bb58251f95e2079065bf59b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个期间还有夏季集训，所以有必要让\n自己的状况在最重视的比赛达到高峰。",
      "source_fingerprint": "9abb5b8c36fabd18882b0165b5e3bab2b85f1d497019cdf96a44dad7aa94627b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085307.json",
      "json_path": [
