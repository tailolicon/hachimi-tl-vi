    {
      "uid": "zhcn:e627b1e978e541b84b147f63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（短距离才最能让红宝绽放光芒）",
      "source_fingerprint": "5c97aa6afa4ab7a1e96ed2a7960597a2fcacb7111f9b5694be5640994b09afe5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
