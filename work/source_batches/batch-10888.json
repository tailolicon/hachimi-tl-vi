        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:cf82870b5f04b1c007cc37c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特雷森学园每年定期举办夏季集训，\n赛马娘们会在此期间努力提升实力。",
      "source_fingerprint": "2019cd55053470d0a47e432fcbd1f754584e3de513b85530ae850f99d740e9bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085307.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:90b8cb9c3a65aad235be53aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，前进“玫瑰S”吧",
      "source_fingerprint": "3b097deebb1ca8734502ccce4d91da545e0ad51eac49067dc169e9375a3aea03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085307.json",
      "json_path": [
        "text_block_list",
