    },
    {
      "uid": "zhcn:d566a8069ab67a88b85bc71e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（在短距离才最能绽放光芒）",
      "source_fingerprint": "2be96486ef60781000c60eaff202d980bbe7d7de2547afa2a9ad724cd3162a46",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085308.json",
      "json_path": [
        "text_block_list",
