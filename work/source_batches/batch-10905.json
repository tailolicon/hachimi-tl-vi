      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:4a5b114e598299487c8ad7b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
