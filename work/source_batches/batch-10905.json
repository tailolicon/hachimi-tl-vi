        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:0469a0a00c0261cc2cd30de3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，第一红宝石也察觉到自己的资质。\n在短距离路线缔造功绩也是一条可行的路。然而，\n她认为遵循家族轨迹走上主流才是自己的使命。",
      "source_fingerprint": "6f7875722ae8f291d84c1e0669e188aee976e760d7e2333d2e2b7915d62389b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085423.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:4bccc685b8a8fe4d0b120a24",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085423.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:33894b2990aea1408ce4cf94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石决定先利用夏季集训\n尝试克服距离限制，\n并且把“玫瑰锦标”当作下个目标。",
      "source_fingerprint": "15ec50c0258908b6befa495db9048e10dcceacadfc37f67b2e14e8da4a32bfa2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085423.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:95a5323fd7871fdf6389bbf3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "橡树大赛结束后・橡木高耸矗立",
      "source_fingerprint": "0758da8a3f0b25466ced4564f7cb27d971bdbd5e1c591654e9e660340374fa8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085423.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:7d4591e10da42ac4b10348a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石在“玫瑰锦标”跑出稳定的表现。\n但是在比赛后，她发现右脚受了伤。",
      "source_fingerprint": "11c73de7fbdc67abc4031967c090eafc9e99664d4a89853438e195c51cdf925d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085424.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e4e6ebb940142b9431d3059a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经医生诊断，伤势应可赶在“秋华赏”前\n完全康复。但她与训练员讨论过后，\n决定慎重行事，取消今年内的目标。",
      "source_fingerprint": "370c6be906666c955c8e3ccaaa76e9fa7ccf90cd8dace45a4c4320b7d1e6e09c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085424.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:5a2af123735f08b9dbde0c2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此外，她还要提前公布往后改跑短距离。\n在震惊不已的媒体们面前，她发誓将在\n短距离路线上成为“华丽一族”的新象征。",
      "source_fingerprint": "ced0109b516e3dab16d798f3ae53450143f0747c848e7cc009f0e8b857e3241a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085424.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:b69f3d3e943d9f0b1cdd5a8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，大拓太阳神得知第一红宝石\n决定变更路线后，开始期待着\n与最在乎的对手互相竞争。",
      "source_fingerprint": "0311c34ced3caecb6c6f12378316ea04343beea16cd0ed2e2568293ba2133e82",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085424.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:519dac0171ff1a1a58ca256b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石即将挑战新的使命。\n下个目标是古马级春季的“高松宫纪念”。\n这将左右她能否为家族达成三代称霸的伟业。",
      "source_fingerprint": "b821d957bd59a01ca917199e3e4697099fbcc02349bf91e2d08d0de17c6926c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085424.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:4463110e336f723de09575e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "玫瑰S结束后・华丽地改变路线",
      "source_fingerprint": "ac05a427bd191e1cf11edd3a3fedd34e23279f26b1d522927037db663d0a3c7e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
