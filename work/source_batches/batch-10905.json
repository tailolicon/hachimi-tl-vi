    {
      "uid": "zhcn:05af4e96c81367d9ab021261",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员提议，她的资质足以挑战\n新马级GⅠ。但第一红宝石却表示\n想利用这一年专注于锻炼基础体能。",
      "source_fingerprint": "512e30ec2c04e01fd2fd08d6126ed3b4207dc99620caa438664d48d7893fe070",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085418.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
