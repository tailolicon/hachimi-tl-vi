      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:6974f1e4d1d06d0cfaffa7d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她想接着继续挑战GⅠ，\n于是训练员提议参加“安田纪念”。\n大拓太阳神也表示要一同参赛。",
      "source_fingerprint": "6998cedfb4b282c5e840bfb974cf78423849f5bddaa0b81e0b9895b89ee0417e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
