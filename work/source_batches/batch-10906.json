    {
      "uid": "zhcn:7fd1ff19b03300971c88d9e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "安田纪念结束后・深红色是热情之色",
      "source_fingerprint": "4e2490e4a64545ba8a1f8a306167cd3780659555edccaa4543f876872e1c4307",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
