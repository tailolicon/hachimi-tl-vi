    },
    {
      "uid": "zhcn:f7de5677c31065aec07bd231",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那、那真是太好了……！",
      "source_fingerprint": "5daf775cb875c3c5758dabd88e0d438185528db87404d460d0f13ba438752faa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
