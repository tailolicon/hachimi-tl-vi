    {
      "uid": "zhcn:ba17785e1ed6f6f1c14af5c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以游乐园为例──",
      "source_fingerprint": "4cab2c855434e56f8099f75058019fe555272132572ce2f484930f0ccf4444c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
