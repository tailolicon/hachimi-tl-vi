    {
      "uid": "zhcn:f7fae22ac0978b78aab873e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石",
      "source_fingerprint": "9b56cd884b7441b8b32119740e379b8bc7aa840838b1c62bd9418c4a41cbf2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085704.json",
      "json_path": [
