    {
      "uid": "zhcn:2ba7a0e2c482a1fcb6cf6c94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然只是我个人的经验，\n但我认为游乐园是能让来场的游客们\n缩短心灵距离的场所。",
      "source_fingerprint": "4fb74979c5bdb5e015b0650fee2a4e1ec52e6258dcde5a7cfcc80ec42b0fa9b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1085/storytimeline_501085704.json",
      "json_path": [
        "text_block_list",
