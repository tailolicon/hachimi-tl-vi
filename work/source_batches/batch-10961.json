    },
    {
      "uid": "zhcn:fab0d58b558389483dd404b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后声音化为鲜明的欢呼声。",
      "source_fingerprint": "ed438fa95044216c084dff12970a5d7289a7edb44dbe29b1f9bed4326559c985",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
