      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:c0f0f6e02bb6dfc22d640e5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有个赛马娘在赛场上冲刺。\n她卖力地扬起尘土，不断向前踏步，\n每眨眼一次她的速度就变得更快。",
      "source_fingerprint": "3ca7224341bf727c1129c5a282c8e9d00a443490056c78470693654e6fb4acb4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
