    {
      "uid": "zhcn:4669cefbb309901f663292ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，再见了。",
      "source_fingerprint": "8550d8db6c03507f2a66a3ac82bcfc5d9ff87b11b9e895e7051e9d68b7972941",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
