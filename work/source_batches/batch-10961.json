        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:877cef93d568d3ec0878edcc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "坐立难安之下我决定去见真弓快车一面。\n可是──",
      "source_fingerprint": "9594bd49b1009bb9e264050a3ebe4f78ca9a6e367e54911684be20dabf8e780d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087116.json",
