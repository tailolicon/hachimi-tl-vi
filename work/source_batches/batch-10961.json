    {
      "uid": "zhcn:f7b3c8d16c38a7055a5e1589",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我突然觉得听见了某人的声音。",
      "source_fingerprint": "0c2479452a5a950e337643dbae7ac764941abc3a30e7fc3bd5dd473f56cec188",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
