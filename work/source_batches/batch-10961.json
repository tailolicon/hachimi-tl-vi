      "uid": "zhcn:b5f643a5da42c0f4cf56d2d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是真弓快车的实力！",
      "source_fingerprint": "645b9df724388c0132964c304709ae0a77af7860b11fb663875e0b62af171c3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
