      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个比谁都耀眼夺目地\n冲过终点的赛马娘是──",
      "source_fingerprint": "943f005ef0f148f06b1eced512cee0eb71279be21e3e82c28cf92f67a43ebeca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
