      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我忍不住站起身。",
      "source_fingerprint": "40f654aee4c4ea13b82eaef54bac3d913ba99bfd57dc2e0819d7bac2007a7e57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
