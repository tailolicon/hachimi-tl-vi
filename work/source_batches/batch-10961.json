      "uid": "zhcn:c05f9196684a57f119f3b7c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是真弓快车",
      "source_fingerprint": "77c0e1b119b9ac4eb8a354f31c9307c0b9f37ec289e80b4b81251ebda7bd4b4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
