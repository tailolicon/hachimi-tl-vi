      "source_language": "zh-CN",
      "source_text": "喝啊啊啊啊！！",
      "source_fingerprint": "06e38705b9fe1c9a566f7330f9398c9227bfe922ef43f0dc53307e4dbe1d0aab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
