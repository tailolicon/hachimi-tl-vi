        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:5d47566cc9770de59e68d7fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们绕到中央广场的樱花树林荫道。现在似乎\n正是最佳赏花时机，好几位赛马娘都\n停下脚步仰望樱花树并拍照留念。",
      "source_fingerprint": "06190f3ec18d063ed664be1f9d63ed478d29229ab800dc590a986eb0d0705329",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
