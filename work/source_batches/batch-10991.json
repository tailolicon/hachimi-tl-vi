    },
    {
      "uid": "zhcn:255942e208d2e6e53005e8e1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真弓快车",
      "source_fingerprint": "eb12aa42f9fd0aba9267db5c2901cc53c437e87018d0410f3ecfe9561c0f158a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
