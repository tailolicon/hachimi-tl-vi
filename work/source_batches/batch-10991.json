    {
      "uid": "zhcn:87aa3d85c22a4286411b01a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我觉得自己快不行了。",
      "source_fingerprint": "a3a14edf931a784b0e5699f26727e61298be268de468a286cec1d23f6c17d5fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
