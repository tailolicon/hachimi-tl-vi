    },
    {
      "uid": "zhcn:7007a46f6a1308cbb1030541",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我急忙擦掉额头上的汗水。\n刚刚那是白日梦吗？",
      "source_fingerprint": "b5739d739492f58f6f38095f1631ea0c50f3ea9d4ec1a2c54a0f004d27051689",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
