    },
    {
      "uid": "zhcn:5ca8782489b5e753e2d05c79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回去时一起去赏樱吧。\n我们来举办第二次跟春天打好关系交流会。",
      "source_fingerprint": "5f751bd1c74a7682c7934748cbec104da649eec82ed92a8d3ec1e376ec71a368",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087318.json",
      "json_path": [
