    {
      "uid": "zhcn:973e98f0ec6d879e45fb0ae6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你怎么了？\n你满身是汗喔……太热了吗？",
      "source_fingerprint": "7ee34b8e424573d4b7ca6ee9a71e6a25950a427a7c75923ffe69500fa0732741",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
