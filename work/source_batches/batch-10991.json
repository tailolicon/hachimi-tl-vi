    },
    {
      "uid": "zhcn:a8af1dc267bc29577066736b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你还好吗？\n难道连训练员都跟春天交恶了吗？",
      "source_fingerprint": "d54b85734e161ed29df092e9b8b92591e5db6cce93d96561f6fca50e7e7842da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
