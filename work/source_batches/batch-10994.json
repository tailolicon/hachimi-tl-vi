      "source_language": "zh-CN",
      "source_text": "两人决定在“樱花赏”一决胜负。\n到时真弓快车也会参赛。",
      "source_fingerprint": "d0bc19e18aef3603f267ee1e9bbaa176dcac175689499183e402438d97a55dbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
