    {
      "uid": "zhcn:98ede0039f77f725c81f9e8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真弓快车突然开始直播！\n她找来大和赤骥与伏特加──",
      "source_fingerprint": "bf27a79c1f5702cafa09c59b4dde8dde7b98d3744bfe3dee24c36e968589380b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087403.json",
      "json_path": [
        "text_block_list",
