      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:1853b9f44a5a6b2d778f7a9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“谁叫你是个怪人呢”\n她说道，并转回来背对大海。\n真弓快车的传说还不会就此终结。",
      "source_fingerprint": "aef6e08dc5027a6614acbc02e303bbdd6d263e7798a701da575c2ab5158a6ed9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087404.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:bee6eb5719e262b2a49ee1df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你还愿意看着我吗",
      "source_fingerprint": "4df6ba6d88013a75aa4613f1d4471b94b5d860527de02b189abb8ef27bc15b0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:d699f1f2d066841598f1b981",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087405.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:c3faa849e34cca9650487d99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真弓快车到现场视察真弓布偶的销售状况。\n她发现有些顾客并未观看比赛\n就直接购入吉祥物商品。",
      "source_fingerprint": "2901ccc291f67672c33e75ea182b2ef9a6f171a7e2cc6bddc87631f51971351d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:ff2813ee95203ed74f119b2e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087405.json",
      "json_path": [
        "text_block_list",
        1,
        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:c415d75df26b6c6880549d23",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论吉祥物商品再畅销，要是消费者\n根本不了解自己，那仍旧没有意义。\n必须尽快解决这个问题──",
      "source_fingerprint": "e86256178b854273c7de890c3f70da702c3bf287860ceba67340aa6bcea16350",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1087/storytimeline_501087405.json",
      "json_path": [
