    {
      "uid": "zhcn:ba3602d9a2df194d58606c57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真弓快车出现在“天皇赏（秋）”参赛阵容！\n她再次实现了与大和赤骥、\n伏特加间的三强对决！",
      "source_fingerprint": "0ade07604cf854ba14731b2ad344f3068206084c4b60bc6c364fd0de7838e560",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
