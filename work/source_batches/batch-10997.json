    {
      "uid": "zhcn:adbaf8a5f602e34d7c6eb75a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "人人都得独自度过人生。\n但训练员却愿意尽全力陪伴她共度人生。\n这令她感到不可思议。",
      "source_fingerprint": "226ba38eac54469de83cdf610ead0145fd3f9cbeea1c4dbe32b8ed8836db89c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
