    {
      "uid": "zhcn:57fcceb86a40a4415d81226d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她甚至还前所未有地跟训练员讨论起下一场比赛。\n两人一起决定下个目标将挑战“高松宫纪念”！",
      "source_fingerprint": "05488b101afe91156b0cb6a4161104b089ca534757827dbaae576cf30dce7a11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
