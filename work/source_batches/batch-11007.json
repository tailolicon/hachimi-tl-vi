    },
    {
      "uid": "zhcn:80ca36f82c7907060f641d94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但当我完成工作\n正打算离开训练员室时……",
      "source_fingerprint": "5cc3efb13c8b07bd48c5da0a9309554690c4f9d9fe9df238e3c0002d750792d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
