      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（咦？那本笔记本是……）",
      "source_fingerprint": "91d5f488ed5305bec06c7301760aa0571d9d97bd9627233b2129af65c9577846",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
