      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:aa9b63760d5e80e0f3bf2186",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说完后，她仿佛征求同意似地看着我的脸。\n我不禁微笑，这不可思议的距离感\n令人感到很自在。",
      "source_fingerprint": "7fd66ec5adcce287a6b99b4d0a0de0032e0a3a9f9ab97c7e9ea47f58fda9515e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
