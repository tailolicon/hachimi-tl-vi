    },
    {
      "uid": "zhcn:8767dac54eec9f481c0bade9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "待兼诗歌剧",
      "source_fingerprint": "9d7494cdddfef759444d8ae8b1a726a437b35adadd24196dff1fc6bfb8d14e77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
