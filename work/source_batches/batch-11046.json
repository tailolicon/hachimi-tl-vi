    {
      "uid": "zhcn:68d36a9b1a6fb7a8635d5fe5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "饮食会大大影响到每一天的表现。\n该在事前做好所有\n能做到的对策！",
      "source_fingerprint": "17f20cde11d22929e894aa84e1bab2a3ef76148738f5cfdc4d92b4c5ea5c9899",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088111.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
