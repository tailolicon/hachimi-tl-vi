      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:714c87e90689c2297deb70af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了实现里见皇冠长久以来的目标\n「成为世界知名赛马娘」，\n终于开始拟定挑战国外的计划。",
      "source_fingerprint": "40715f111bba7904a4fb9a1fa5d16726ad73983dd8b29d03b8d0a2ce496fd6b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088111.json",
      "json_path": [
