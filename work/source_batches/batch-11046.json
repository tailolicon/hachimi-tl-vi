        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:ac9cc3d637e1ce99bb166a71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我经常听人说\n到国外后「会很想念日式料理」，\n所以当然不能轻忽呢。",
      "source_fingerprint": "792076d404e0494cfdfb175e50d7cea5ca9a8f02bceae92ab4c9ce860bf56aea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088111.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:5dcf947881de32246c12680c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见皇冠",
      "source_fingerprint": "b0ef26861bf626c7200ae8b01ef10143b621af6d508b6cd1b9048704e421f291",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088111.json",
