    {
      "uid": "zhcn:6218f77acf746f5ba5aa721a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "顺利地跑完闪耀系列赛的\n最初的三年后，我们──",
      "source_fingerprint": "b614be2d03e6bfa36b33921ebc980b2ab30f8d708b1c67c65c286b56be788a63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088111.json",
      "json_path": [
        "text_block_list",
        0,
