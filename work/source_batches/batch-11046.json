    },
    {
      "uid": "zhcn:af94a7e01b6692b6105c1ddb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见皇冠",
      "source_fingerprint": "b0ef26861bf626c7200ae8b01ef10143b621af6d508b6cd1b9048704e421f291",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088111.json",
      "json_path": [
        "text_block_list",
