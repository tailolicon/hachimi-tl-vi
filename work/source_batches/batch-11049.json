    },
    {
      "uid": "zhcn:bb948093090b8ea1a862a662",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见皇冠在「皋月赏」中体验到\n遭受大鸣大放猛攻的感觉。",
      "source_fingerprint": "e8fc11510791859ee78523d2a3e467747e8c7309c8915bc7d6298594eabdcb52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088113.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
