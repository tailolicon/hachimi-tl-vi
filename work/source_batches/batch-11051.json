    },
    {
      "uid": "zhcn:f0f529b77f650ec83a4b01f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊。\n看那训练内容，她正在锻炼足以维持领头\n跑完全程的耐力。",
      "source_fingerprint": "68602850fc3cac1f6aaab8858a457ec0281eeacd39621abbf85594d2d9e20217",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088113.json",
      "json_path": [
