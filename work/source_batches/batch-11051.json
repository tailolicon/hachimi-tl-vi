    },
    {
      "uid": "zhcn:f82675c8c72814941e58f5e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "冷静并猛烈地",
      "source_fingerprint": "0c1e9b473f73f622ccfd3ac283796ac0c1c50eb0ad4463abfd9da0b0a96dfb15",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088113.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:faeb2da8d30161df9352129a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟里见皇冠正在确认──\n为了在日本德比对付大鸣大放\n而精心研拟出来的对策。",
      "source_fingerprint": "1dc08f95c000aef398a5241c2eab198ce8f505bd9710d2dce7d0edd67bbe2071",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088114.json",
      "json_path": [
