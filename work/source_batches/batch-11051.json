      "source_language": "zh-CN",
      "source_text": "里见皇冠指向一位同期的赛马娘。\n我记得她应该比较擅长前列作战，\n但……",
      "source_fingerprint": "53beb5445ddd515c527d38d49027a973216fd49fa7d6e57701261eea97f07eb3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
