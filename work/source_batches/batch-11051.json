    },
    {
      "uid": "zhcn:0891a8a38a5825cfba609a5e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比起跑在最内侧的选手，\n该赛马娘跑过的距离将多出约19米。",
      "source_fingerprint": "b3cd03ee6058b025a8c88cda5a70be86f4b2760bbd32aa6b08cd954a80d25e3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088114.json",
      "json_path": [
