    },
    {
      "uid": "zhcn:21f5868b0314eed79f8560e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过对你来说只要能领先这点差距就够了",
      "source_fingerprint": "b7a68c674f2b8ef67466ceb074d83a7127a42f47818448c2b59bb1da033fec15",
