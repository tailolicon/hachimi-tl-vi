      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不过呢，就算是这样的我，\n依然面对着某个需要克服的课题。",
      "source_fingerprint": "9b5b94d921437d37e6256c2a3d9bc63449c1b487264bc4f372991ad83fb2246c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
