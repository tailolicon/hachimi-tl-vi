    },
    {
      "uid": "zhcn:702a781e37ddf252eaf41587",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯",
      "source_fingerprint": "c8c817907dbce17961409932d8322b7bdac52b9ef3b19542def7a8c3eb9229e6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
