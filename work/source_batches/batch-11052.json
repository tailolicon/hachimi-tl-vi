    },
    {
      "uid": "zhcn:26d9cfcb2a11004b921fde2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "至今我看过不下无数次了，\n无论受到何种压力袭击，\n她都能微笑着将其视为良机。",
      "source_fingerprint": "7ae13d85d7b701c3ad5ee90b4e6abbe06349aab23577a5d93bdca396f2a28fcc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
