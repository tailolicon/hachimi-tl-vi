      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，不想在关键时刻被对手包围，\n或想专心自己跑的选手会选择跑在外侧。",
      "source_fingerprint": "9f623bb6ce48b4beb2b1f7dcbbc087dd810ec6418ce35dea48587a5e16dd261d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
