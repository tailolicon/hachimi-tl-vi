    {
      "uid": "zhcn:422faeabe03d2f5ca0fb044b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为我足够冷静，拥有宽广视野，\n能够依照状况选择当下位置。",
      "source_fingerprint": "905eb6ecce865d748ac5117af66177aead9010423ffcfd10f924d06b815969db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088114.json",
      "json_path": [
        "text_block_list",
