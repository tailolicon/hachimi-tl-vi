      "source_language": "zh-CN",
      "source_text": "但是，紧贴内侧围栏前进的缺点\n并不会影响到我。",
      "source_fingerprint": "d5c44f75b216ce046ecb7c4e3a4d97b0563a3651ba52cdd56a026bdc91e60bc7",
