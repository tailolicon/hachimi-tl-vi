    },
    {
      "uid": "zhcn:be138db2df875bec8b4dda95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是的",
      "source_fingerprint": "fb82193af44d68b00b416c088b09538a609c37137758f2796c053e2caf1fa274",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088114.json",
      "json_path": [
        "text_block_list",
