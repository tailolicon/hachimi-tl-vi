      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不会受其他赛马娘施压影响的\n强劲毅力。",
      "source_fingerprint": "4f0723fa4be7b70e7548de705e568228ad0298a889230804682a86707ca56d91",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
