    {
      "uid": "zhcn:23b7f1c2251a895e6e3884dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见皇冠就这样\n接受赛马娘们的激烈攻势及锻炼。",
      "source_fingerprint": "7df1ebeaeec645125569e1badcd02c504231bbe44fdb300658292abd1768adbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
