      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "NO!!\n你也只剩现在还能悠哉地说笑了！",
      "source_fingerprint": "78ab4a224eeda2295359f9febc9b023a1d9e22f449fe215c4f7d76418b84bf24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
