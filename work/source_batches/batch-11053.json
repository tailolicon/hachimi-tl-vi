    },
    {
      "uid": "zhcn:887598623b504e0e9f1e984c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "能够依照状况选择当下位置的\n冷静特质与宽广视野。",
      "source_fingerprint": "6a6f3dc28cd1129fefc990a34a26234f10a24710d5a59f84f52fcdd6ea7bf95b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
