      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "Crown! You're racing me next!\n（皇冠！下一个对手是我──！）",
      "source_fingerprint": "2d4eb543a856e9c7ea3a4c1a1b7ef8d5101499c600b2fbd9070a92baabc807c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
