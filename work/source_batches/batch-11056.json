    },
    {
      "uid": "zhcn:ebf949c7fc5d789dd96401d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘们累积的实力各自开花结果，\n将秋季竞赛妆点得色彩缤纷。",
      "source_fingerprint": "259f877f2347a04d00f3d2935c5cadb580d5d5f8830ebf428dcf1d9117e1079f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088116.json",
