    },
    {
      "uid": "zhcn:16b8f401c644c6b29dca6bd7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "根本论不上什么知不知道。\n不仅香港，面前这位赛马娘还曾在\n美国与法国大获成功。",
      "source_fingerprint": "7055bef9a7b6eddae4c65b1264b3610e3cc07c352f11a2a28317838e8d94d908",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
