    {
      "uid": "zhcn:c31cf23684382b0f1ecfe901",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊！训练员也知道她？\n她就是赢得今年香港国际GⅠ的选手哦！",
      "source_fingerprint": "ee0da735bd36fffa36cc586234edc6a661a48af9d97dcb5d4fc173821374dbd1",
