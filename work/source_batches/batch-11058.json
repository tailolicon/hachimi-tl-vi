    {
      "uid": "zhcn:ea9ec6f5b42c1476c51dd171",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "五月。\n我跟里见皇冠一起来看\n里见光钻参赛的「日本德比」。",
      "source_fingerprint": "8f9b7fda6bf6e7565a0cc4f718716fa1510ec015e6b19f0ed07fdeb3f7feb108",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
