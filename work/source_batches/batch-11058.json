      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我同时也觉得\n「我就知道她们一定会这么说」。",
      "source_fingerprint": "ad01af28e20a6f3ca13f37049bd677004027a9c48657d4cd279f97a716555290",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
