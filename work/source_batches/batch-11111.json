    },
    {
      "uid": "zhcn:4f14f5b60f1e4dec081c5fa2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜利的作战",
      "source_fingerprint": "b78ae1a0d74212b9f2799788ecc89cd20ad4b91263b3ef05c7a6a8f32cc575ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088402.json",
      "json_path": [
        "title"
      ],
