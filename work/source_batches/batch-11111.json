    {
      "uid": "zhcn:3f1251647b336dce36ec27f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经过无数场模拟赛后她终于找出获胜方法。\n那就是……磨练里见皇冠自身原有的特质，\n习得「最强的尾段加速」。",
      "source_fingerprint": "903f06ff0ec38c719bc1083a22208bd761727e104a65fce231d57bc5fcfc8822",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:54a423042ffed8409c03be2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "I'm confident",
      "source_fingerprint": "c6d5030a38d37b8704548be62024ed6d3451152170646393d474ecb8dc1f2d4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088404.json",
