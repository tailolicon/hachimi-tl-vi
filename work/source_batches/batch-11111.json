      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "很快就是「日本德比」了──！",
      "source_fingerprint": "9021de3eccd5921fd20da810fbc3c9b7257ccab06d4aadcefacfac8cead4ed81",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
