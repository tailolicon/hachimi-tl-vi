      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:253fba96e15c3704108374b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过里见皇冠也早就思考过数百种\n比赛发展了。她绝不会将「皋月赏」\n优胜者宝座让给任何人──！",
      "source_fingerprint": "a7ab5cad3f47d8653a9d6c4d06f60d7716dddb1b0abdee048193dffd4bab614b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088411.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9a9ac4e32041193a62354ff5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向皋月赏",
