        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:8ec57c44b02b56c77ed38cbb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大鸣大放斗志高昂地站上会场。\n她散发出明显不同以往的霸气，\n震撼四周。",
      "source_fingerprint": "7cca4be395aa5989c854c4434cb63e090e96131882f7a4a439c793eaad6aaa86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088411.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1676960594b2a747aa3e16f7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088411.json",
      "json_path": [
        "text_block_list",
        3,
