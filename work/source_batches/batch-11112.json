      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:460f596327d9ba5bce73fc92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了获得「德比赛马娘」的荣誉，\n此刻她即将挑战同世代的「怪物」──！",
      "source_fingerprint": "51023e1c78ed791e4d9127be3ac9a0fb494f5b16d48dff21584b48a46087d200",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088412.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:f83055ba36f09f0fead16dd3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向日本德比",
      "source_fingerprint": "e4074326c9093437fbf37c8e5b00d67df67963c2eed1109506df4b11f06953bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088412.json",
      "json_path": [
