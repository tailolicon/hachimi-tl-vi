    {
      "uid": "zhcn:39e0d4d87f5b85cc4c50e066",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了对抗北部玄驹，里见皇冠决心\n锻炼尾段加速。该怎么做才能获得\n跟大鸣大放一样的尾段加速呢？",
      "source_fingerprint": "62941b287448e563a4379e0b971442291db2a59d2acb6d33e15baa817964cafa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088414.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e8b7ae2ffb14e6ab1a0651bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088414.json",
      "json_path": [
        "text_block_list",
