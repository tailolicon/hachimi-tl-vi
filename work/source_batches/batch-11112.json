        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:64063eb3defb3c04453878db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而跟大鸣大放对话之后，\n她才发现自己根本不须以他人为榜样。\n只要遵从自己的信念克服逆境。",
      "source_fingerprint": "15578052fd33702678bf8ccf14dfe91ece22b51a161f6c26161bc0135b373b88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088414.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:d83c50f303f8f759a3199bc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088414.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:a8e160fdd3764a5d7d262958",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这份自信让里见皇冠的尾段加速变得凶猛锐利。\n准备万全后，就迈向「京都纪念」吧──！",
      "source_fingerprint": "ad37e625c286a689e5674dc8321454e6403d60fa5bd1cf623a8a6b16fd05cbdc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
