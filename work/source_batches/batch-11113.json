    },
    {
      "uid": "zhcn:736b9e9ec88779fb26d65c9c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "里见皇冠接下了所有挑战。\n为了让里见之名轰动全世界──！",
      "source_fingerprint": "9d1b10e3778868165e53060a6145f10383044936b01a242b02a55b81f5034c4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1088/storytimeline_501088418.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:c5850e520d6ba434ed9d8778",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向日本C",
