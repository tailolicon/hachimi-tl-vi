      ],
      "json_pointer": "/text_block_list/23/choice_data_list/0"
    },
    {
      "uid": "zhcn:a54a935dd88714357b01bf9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯唔，如果有希望的话只是想了解一下",
      "source_fingerprint": "52eb3dbe8c6096c5bf734848b930fae12136d0d4af53b247d9877b4abb8ce33e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
