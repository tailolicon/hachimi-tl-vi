      ],
      "json_pointer": "/text_block_list/26/choice_data_list/1"
    },
    {
      "uid": "zhcn:b19ed51c27325ffa42f8a803",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，另一方面——",
      "source_fingerprint": "6899b62318b48ea7ce254fb74eb560113c3fc05443bccb2710140961842d2c3d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089303.json",
      "json_path": [
