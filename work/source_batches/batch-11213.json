      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在过了最终弯道的前方突然，\n抛弃了宁静，\n傲然地夺取了胜利。",
      "source_fingerprint": "4d519f86fb48d55e64f89466e33d58d1938e596d50daf4c83f8fa2f26996281a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
