    },
    {
      "uid": "zhcn:89175b0db8cb8ebad1815773",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然放弃了出战，\n但为了实现她想要成为\n“伟大的赛马娘”的梦想——",
      "source_fingerprint": "d908d8ea1d7623895bd2bb141221386efee266ad64f94500c36544bb7229cee3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
