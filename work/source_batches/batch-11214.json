        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:0eb0e6933e950d49a0508dab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了能与她们直接对峙的那一天……。\n我下定决心要和高尚骏逸\n一起以此勉励——",
      "source_fingerprint": "4b844480935263a6788acdda2bc6d4004893eb4560a12cde5ee6897f4def0e16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089308.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:1e3a9e5a18bf22aa83c5fa81",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为掌握同期竞争对手们的动向\n是必须的。",
      "source_fingerprint": "cf5bd3c7b02218c8c3b9f5d3a59afd004e5f45541795662f81bfbe03c9e53d33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
