    },
    {
      "uid": "zhcn:2d1c719eeebe68ab5150ae5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总有一天必须战胜她们。\n如果要以“伟大的赛马娘”为目标，\n这是无法避开的道路。",
      "source_fingerprint": "4a218eff4a8a065570108745ae877920bc5a121df4ac05788a1936003ce10712",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
