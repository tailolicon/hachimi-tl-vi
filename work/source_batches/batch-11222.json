    {
      "uid": "zhcn:8cd288f6602226bf3f5b5d58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以那个……唔，我，那个……唔。",
      "source_fingerprint": "1f0a00791e86d38791dc7f946b1b3cebbbf5ef2046493d2c2e827534e1e281b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
