      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和北部玄驹一决胜负吧！",
      "source_fingerprint": "f11c3fb5bdb0a10fd742dbea17640468fc871638582b1cb7b2e3bba3216ae1be",
