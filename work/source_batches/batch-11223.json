        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:cbae021c2c91cb78c090bad6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然如此，要做的事只有一件呢",
      "source_fingerprint": "d4921bcd5ccd1a2a5aa5bf621486a065478e6041fdecff7c673c53f35eac794c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089314.json",
