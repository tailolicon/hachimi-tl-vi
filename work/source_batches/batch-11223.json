    {
      "uid": "zhcn:561a918d0c45a29a0ac97433",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高尚骏逸的告白让我胸口发热。\n直到能说出这份心情为止，\n她跨越了多少障碍呢。",
      "source_fingerprint": "c542ebfbee23ad9812760e1c05017dc6191912f61af8cb52392ee6b4bced48d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089314.json",
      "json_path": [
