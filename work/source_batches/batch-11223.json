      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:8ab8de998d1b52a5772a9ceb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了她的成长，\n这也一定会成为有价值的比赛。\n我不由得这么想道——",
      "source_fingerprint": "3e507339dc8ee448a2c3f4b798a97128423c80e2d3acd6d9b10e17275870ea1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
