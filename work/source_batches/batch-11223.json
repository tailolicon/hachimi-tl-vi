    },
    {
      "uid": "zhcn:5daea18ae0724cc9e081fdd8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "至今为止只关注自己弱点的\n高尚骏逸，\n第一次将视线投向了外面。",
      "source_fingerprint": "49976a719de8c0d651b653016dfbac498a252b6ce28057f60c14df48ad83874d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
