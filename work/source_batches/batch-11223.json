    },
    {
      "uid": "zhcn:99a8cf9f4080875422df45f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从一开始就作为竞争对手，\n怀着获胜的心情向北部玄驹挑战！",
      "source_fingerprint": "e8d6d105411fe2bf4b67992df0543381fe8154ec75750474ac741a3dbdd12dc6",
