    {
      "uid": "zhcn:f8248a80a06ac0af9397d6af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。……我想跑。\n——和北部玄驹。",
      "source_fingerprint": "38b68217250e78182586fbd56cb2b0c4ba8e3b2fd6f6d75e720ac7eea7cf7f0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
