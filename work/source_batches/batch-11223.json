    },
    {
      "uid": "zhcn:710fd270da47a7ee04d4cde0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹",
      "source_fingerprint": "b35c8efe526549443c05f78c85df93324a34a54bd209672f562a6e43ba69f190",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
