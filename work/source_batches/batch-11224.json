    {
      "uid": "zhcn:5f3adfd2ad9bb081f9e069dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和同期相比并不起眼的自己，\n以及同样没有受到瞩目的\n北部玄驹的事情。",
      "source_fingerprint": "427e30bb6ddf43a343498dbd1c60fe4c09ca620fa35fd1ed2c1f6563dc1078db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089315.json",
      "json_path": [
