    {
      "uid": "zhcn:ed5543fc7cb14b84bc7b07db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "话说回来，那个……。\n训练员先生，今、今天——",
      "source_fingerprint": "c4da7038cab9e9356d8e077c77e495268ce34f99745036830217fb0f95905a5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089317.json",
      "json_path": [
        "text_block_list",
        39,
