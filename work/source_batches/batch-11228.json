    },
    {
      "uid": "zhcn:00f860f8951fa1c7c4be96d8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "钓鱼，果然很习惯呢",
      "source_fingerprint": "cb76e95ee6cfcf222388509730a67aad08a43852d7c8fc741f96b11b416c66ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089317.json",
