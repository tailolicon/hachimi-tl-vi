      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:2cc45f248aa04533516debdf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "钓鱼，果然很习惯呢",
      "source_fingerprint": "cb76e95ee6cfcf222388509730a67aad08a43852d7c8fc741f96b11b416c66ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
