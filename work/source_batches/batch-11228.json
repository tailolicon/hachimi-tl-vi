      ],
      "json_pointer": "/text_block_list/45/choice_data_list/0"
    },
    {
      "uid": "zhcn:56a6571d889f0b97ee98dd7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且，以此比赛为台阶，\n我有想要让高尚骏逸挑战的比赛。",
      "source_fingerprint": "06b94ec9c591c99c94caf81d02bb3cc1e8999423ea1a3a12d660ae542e92392a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089317.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:c66beb5b98b54f01c138c18d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北部玄驹一定也会出战的",
      "source_fingerprint": "7126f0e5c6e5112f39c306334d8925b7aa8b9ae87756c9d41639a28af9b8ff97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
