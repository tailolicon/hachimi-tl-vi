      "source_language": "zh-CN",
      "source_text": "我也想相信……我也有强大的地方……、\n有只属于我的强大。\n所以——",
      "source_fingerprint": "4afa048f8695bbcdcc575bcc6c4bb66752aebfa87987ef4628afb8e6f59cd83e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089317.json",
      "json_path": [
        "text_block_list",
        49,
