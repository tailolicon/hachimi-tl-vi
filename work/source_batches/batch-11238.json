      "source_language": "zh-CN",
      "source_text": "高尚骏逸向我介绍了她在少年\n俱乐部时期的青梅竹马。",
      "source_fingerprint": "9af8b4d8367f9f73154eb256db567152ec392171bed9c3de8f9ac34800d78e38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
