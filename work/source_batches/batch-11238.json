      "source_language": "zh-CN",
      "source_text": "原来会因为与他人比较而烦恼的人，并\n不只有自己一个。高尚骏逸第一次明白了这一点。",
      "source_fingerprint": "d449bf4364ece7dc9e72df4c3b49ca6a2061ff0fea99cc247f01539fc4008040",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
