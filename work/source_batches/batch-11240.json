    },
    {
      "uid": "zhcn:6fd0af974313cf84e4a65d8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迈向日本杯",
      "source_fingerprint": "1fb754ea4749f17aea2988067fbcc57bb9aabd196400fbc36712bdc815fa7d37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
