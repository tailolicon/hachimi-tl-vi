        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:3192a811a0702dd67f4bed72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与姐妹的差异，并不是优劣，而是她的强项。\n高尚骏逸的耐力与韧性，尤其能在\n长距离赛中发挥作用。",
      "source_fingerprint": "fa9a413ef5c8390975cb4998f9515248f3411c191e077736372e08048f9fe463",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089418.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:039fd7b7b9d66b59bbb8355a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
