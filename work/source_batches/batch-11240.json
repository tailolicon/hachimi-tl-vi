    {
      "uid": "zhcn:ee63828ad867435858f9b725",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "高尚骏逸在出道战中拼尽全力跑到了最后。",
      "source_fingerprint": "7ba787a1de6998a8040b6b61505f9fad51da5cee95fb3de1e495bcccae5b5658",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089418.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:674b1e01537344f26f8208d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
