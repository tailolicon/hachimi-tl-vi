      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——要把勇气，传到海的另一边。『日本杯』，终于\n开幕。",
      "source_fingerprint": "426af10376e21295153893fe07e2b651a34afb11f893de5ab11a9c4f72ededbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089417.json",
      "json_path": [
