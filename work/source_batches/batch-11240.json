    },
    {
      "uid": "zhcn:d9948957f95d627a85959b93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而，在决定下一场要出战什么比赛时，\n她依旧因为内向的性格，无法自己做出决定。",
      "source_fingerprint": "0d3a45343ef4563a30b67962bc634e941d67c2d81ba89130e471e285529db4a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089418.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
