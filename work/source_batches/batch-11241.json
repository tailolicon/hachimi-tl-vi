      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:289354c803a16603a55ba822",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自己究竟怀着怎样的觉悟站上赛场——\n她开始责备那个带着半吊子心态参加比赛的自己。",
      "source_fingerprint": "bc2f3057d1f56124fc62b2dea171759e88926e9050c0f151be1ce74fd5b050f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089424.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e0a2b103c0f1a8650e3b4cd1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本德比后・虽成世代最强",
      "source_fingerprint": "d1e4303f4b951902471e58a5f05df9532dd7024569ab61c307e673acf1991d3a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089424.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:7c031c3c1bdb6cc7608393a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089425.json",
      "json_path": [
