        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:42ce049a38e39a719744dfdc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一边想着，总有一天想看到她也能挺起\n胸膛说出“我同样很了不起！”，一边离开了赛场。",
      "source_fingerprint": "b34ccf007b29ed412ab47227510e98b19be08424c1fca9f2843d254f27d24364",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089422.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:b93e3c8b2ffd2f11a5c1f584",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皋月赏后・被展现出的“觉悟”",
      "source_fingerprint": "33ce63067b4123ba70a515a15176ab8025aa80be5d618c7f685ea7b79368b51e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1089/storytimeline_501089422.json",
