    {
      "uid": "zhcn:aa80c7ef6703d1c3b5bd294f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一个是看起来年轻华美的马娘，\n一个是体格健壮又爽朗的男性……\n强击的父母，和睦地紧挨在一起。",
      "source_fingerprint": "49ffa53cc94867b6d65af66858f2934db36f5aa883147aa26f2d0f8606eb97b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1091/storytimeline_501091100.json",
