      "source_language": "zh-CN",
      "source_text": "（哦，见到本人了……）",
      "source_fingerprint": "8073b92876c18d095824877df916484854133743f9f341ceaa54cab99f6fed9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
