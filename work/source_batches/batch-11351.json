      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "极峰在理解了强击的意志后，\n把妹妹的托付给了训练员。",
      "source_fingerprint": "1cee36ab678af0e5b9d6bc1dcc4b3d59da954e18b252ec138995fa1d287a4b51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
