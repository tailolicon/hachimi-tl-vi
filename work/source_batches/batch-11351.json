      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "My Beloved Sister♡　-1-",
      "source_fingerprint": "d00748d0487e223643c5c98591dd0e002eaa298d3acbec1ee9acf79405b2748d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
