      "source_language": "zh-CN",
      "source_text": "极峰急忙赶了过来，\n并主张强击在完全治好前应该休息不要参赛，\n训练员也表示同意。",
      "source_fingerprint": "f694b24c9dbceff48bb65f37c5328fca2db80a86f1859065ec0ac51f9dada146",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
