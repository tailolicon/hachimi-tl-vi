      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与之相反，强击为了让姐姐高兴，\n下定决心要夺得姐姐没能实现的三后冠。",
      "source_fingerprint": "9eec013f26a10c2a1f16b6ca03a5675e4b0ce4463bdb7730b79b720e7f39f54c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
