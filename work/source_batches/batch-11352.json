    {
      "uid": "zhcn:d1bc6685380332ada960c3b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "承载着粉丝的期待，训练员的信赖，\n以及姐姐的心愿，迎来了『樱花赏』！",
      "source_fingerprint": "9e2fcb0cc260075ed731fc89ba81fc8bb8117c96262ab53ac3ac2ccfbe01858d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
