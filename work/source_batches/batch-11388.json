      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:edf49a0122dd4733fa3b570c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "平日里沉睡着在她身体里“狂气之血”。\n一旦苏醒——",
      "source_fingerprint": "13e3c7e13e8d8e1e076f1067d2db124ff7690c40540a4ee3e398b01f74f9eb59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1097/storytimeline_501097100.json",
      "json_path": [
