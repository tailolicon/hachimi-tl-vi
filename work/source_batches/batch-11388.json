        "name"
      ],
      "json_pointer": "/text_block_list/23/name"
    },
    {
      "uid": "zhcn:9161e7ff18856b2685c6a6a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我吸取……你的力量吧！！\n——直至血液枯竭殆尽！！！！",
