    },
    {
      "uid": "zhcn:03f64139fbe7ebd7b79c3245",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——忽然间、一阵寒意窜上脊背。\n在脑海里如闪电般骤然复苏的、\n是与她邂逅之夜的记忆……。",
      "source_fingerprint": "1d22e2e2572823c7ca0cfeacbf066cfb43fed86c28b4bc0f96ad5a29c3a0f8bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1097/storytimeline_501097100.json",
      "json_path": [
