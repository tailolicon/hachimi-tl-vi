    },
    {
      "uid": "zhcn:4b8ff8b8245dad03d11d30f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱如往昔是一名低调、不起眼的赛马娘。\n除此以外、她只是个温柔善良的普通女孩——",
      "source_fingerprint": "9fe208364306f54390a7d465634e0ceb6c8319892bd753c9822340f19148df0b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1097/storytimeline_501097100.json",
      "json_path": [
