    },
    {
      "uid": "zhcn:0d680a7eaceee7c5a685a98b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱如往昔",
      "source_fingerprint": "700dee5173354f7b50adc1015a5eb201cda85290bc9a071978400ef72dbfc37f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1097/storytimeline_501097100.json",
