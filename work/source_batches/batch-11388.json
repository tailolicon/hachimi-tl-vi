      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是在做训练的准备、对吧。\n请让我来帮忙吧。",
      "source_fingerprint": "e7111cc6274984d85476fff8a801d6aa6669cc36f0b619ee0881b2647e7e29a7",
