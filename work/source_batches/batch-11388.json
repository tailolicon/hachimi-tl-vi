    },
    {
      "uid": "zhcn:61dcc2b0d6d924036646364f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱如往昔的、另一面。\n那是……如同野兽般、展露\"本能\"的姿态。",
      "source_fingerprint": "ac965b98f82e1e38817bd982e124f21c4b1e995ec07e02a7925ca36ec6503cae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
