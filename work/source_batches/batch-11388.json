      "uid": "zhcn:d80a5ffbaa0a66638abe5cc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（不过她还有“并非如此”的……另一面）",
      "source_fingerprint": "5cba80e82e198f0507bc2ba8e7782d4aeb02cb930849239370fff1ab7519eac5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
