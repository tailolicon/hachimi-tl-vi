    {
      "uid": "zhcn:d3229325ba3663ff7c61ceca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱如往昔",
      "source_fingerprint": "700dee5173354f7b50adc1015a5eb201cda85290bc9a071978400ef72dbfc37f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
