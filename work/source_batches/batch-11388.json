      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊哈啊！啊哈哈哈哈哈哈哈哈哈！\n啊啊啊啊啊啊啊啊啊啊啊………………！",
      "source_fingerprint": "aabe8ac38c68e9fae604d32403e0ff842bf2ca52b94b6ad0c9c9bb7dfda02d4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
