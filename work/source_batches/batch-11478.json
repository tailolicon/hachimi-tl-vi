    {
      "uid": "zhcn:ffd2176a2e76b0b9a93ae08e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向卧龙S",
      "source_fingerprint": "ea6555e90229e63b8b5f0b1a22401e8992b9e2517680efae4ef3a896c01aab98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
