      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:abc86b6a77b32653e4ed22d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，试着挑战看看吧",
      "source_fingerprint": "f012646144e243ffe8c29d8b08607bb51d3903af93cb55ba35b8302e4789d557",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
