      "source_path": "assets/story/data/50/1098/storytimeline_501098205.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:4571fc574b01a5404403c203",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们同心协力，\n一起去了所有想得到的地方。",
      "source_fingerprint": "f0a083b640b7c4abdafdba3fdec9c5ec14e54b7845184d233c832e156526141e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
