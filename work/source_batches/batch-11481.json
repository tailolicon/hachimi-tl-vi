      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:56864cfba30330fc755d949c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇好不容易获得了\n不会输给任何人的信心。\n她将面对古马级最初也是最大的分水岭。",
      "source_fingerprint": "452ed9086aa53f77ea1ed6db299b9d61a45f5d4f4136af63102b47bc57e65ebe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
