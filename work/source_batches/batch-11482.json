      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:2063d22ea85b827e9d1bae0b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北港火山总是把“只要获胜，\n就能对苫小牧有所帮助”这句话挂在嘴边。",
      "source_fingerprint": "ae0bb07c27624800da4ba4e3ffd6ddfb81658d8ba4cf5d0841c56914f5bd04fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098207.json",
      "json_path": [
        "text_block_list",
