      "source_language": "zh-CN",
      "source_text": "气已经恢复，她再来\n只要接纳这股气就行了啊。",
      "source_fingerprint": "ddc4f0e26f1532f39e548df9293fc00753c0db7feccb886879b0a0da6e87c486",
