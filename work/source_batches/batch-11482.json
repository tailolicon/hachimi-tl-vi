    {
      "uid": "zhcn:5c6298b53003af3b6940c44e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "假如我能拿下冠军，\n就能一口气打响苫小牧的知名度。",
      "source_fingerprint": "8f4a6eece44968d95574f2970ddb40932893fde54e193b1f40ea43285c1218eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098207.json",
      "json_path": [
