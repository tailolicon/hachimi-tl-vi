        0
      ],
      "json_pointer": "/text_block_list/17/choice_data_list/0"
    },
    {
      "uid": "zhcn:4851fddac9f2ea52063bc13f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那如果她输了比赛呢──？",
      "source_fingerprint": "6696b9ce0857ec83e04aa8a0c88ab12b0df6312675db26496a2d79b73d7be354",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098207.json",
      "json_path": [
