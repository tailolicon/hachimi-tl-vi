    },
    {
      "uid": "zhcn:461fc9237f9ae2be3ac9371b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若不去挑战，就无法改变任何事。\n我们也尽全力累积无可动摇的实力吧。",
      "source_fingerprint": "e068de4c6c23670ca5baa01994d1103d34516370ff32f40b4723f2062b2aed70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
