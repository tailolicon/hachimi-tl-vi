      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我有个提议，这时候──\n不如先“让龙暂时蛰伏地底”怎么样？",
      "source_fingerprint": "581eb859ae6022baba643bf88ec6a7a8a9d840be409d51fb34fd4c6fdcfb1038",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
