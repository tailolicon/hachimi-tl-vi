    {
      "uid": "zhcn:3f7cd956812d7834486ff8f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──小林历奇展现了威风凛凛的跑法。\n她在中央GⅠ这个沙土最顶级的舞台上，\n展现了年轻的才能。",
      "source_fingerprint": "f829e345cdb2c5a055c6a774d46da52c03a1eefcef714a6159332cc0fdf3b44e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098309.json",
      "json_path": [
