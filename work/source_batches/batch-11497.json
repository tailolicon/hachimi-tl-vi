    },
    {
      "uid": "zhcn:3c86235aa33cd3f23db61253",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098309.json",
      "json_path": [
        "text_block_list",
        60,
        "name"
      ],
      "json_pointer": "/text_block_list/60/name"
    },
    {
      "uid": "zhcn:fb86ba35e40385e98e1b133b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "火山对故乡的心意，以及我想用风水\n帮助人的心意。我们应该将这些重要的心意\n寄托在跑步上互相竞争才对──",
      "source_fingerprint": "47d0f84d093ac7f67d0dabf697edaa4e1221f5a2e653a1621a0a4730b266acfb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098309.json",
      "json_path": [
        "text_block_list",
        60,
        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:73958b40c106a415e57ac023",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇",
      "source_fingerprint": "5062acb0b4a86a5620c916b5619b61f071134305d2ea0a4b3346ce3d45cdc803",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098309.json",
      "json_path": [
        "text_block_list",
        61,
        "name"
      ],
      "json_pointer": "/text_block_list/61/name"
    },
    {
      "uid": "zhcn:5c3b749802a9e2367a500228",
      "kind": "story",
