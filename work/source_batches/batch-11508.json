      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:2d808f6d6868a6524ddff4bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要以活用风水的战术在比赛中获胜，\n一定能让大家更了解风水──基于这个想法，\n她决定朝适合自己的沙土路线迈进。",
      "source_fingerprint": "6b10ec1a54afdcc3fd2075484b4d2f7ecaed0561f449303245c6a9a1ecaec447",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
