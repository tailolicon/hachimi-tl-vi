      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旧情如同流动的沙",
      "source_fingerprint": "622c321f793cccd040f6942dd17e2cf9e0a1eda096cfc0da88c80ac72d9ace1f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
