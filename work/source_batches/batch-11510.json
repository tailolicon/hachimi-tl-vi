    {
      "uid": "zhcn:455ab15221f732dbb54f1d86",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇漂亮地拿出精彩表现。\n她那根基于风水的独特跑法，\n吸引了观众的注意。",
      "source_fingerprint": "7b4ca442107f32c2ca5050393fdb267e68e523919e32bd54b876aec316b4e111",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098419.json",
      "json_path": [
