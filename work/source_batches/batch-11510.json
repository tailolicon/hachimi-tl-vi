    },
    {
      "uid": "zhcn:7d6e1c892673b4401eac6f8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・风水并非奇迹",
      "source_fingerprint": "244244313367962bd190d1345fb36a58974e871adfd4b5675149c42ad15c4d50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
