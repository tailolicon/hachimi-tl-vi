      "source_language": "zh-CN",
      "source_text": "但小林历奇──\n反而“不做选择”。",
      "source_fingerprint": "e752d004e0c3e9e47734a8a7448fcbf94ae04890a19699080fbc0add35ea9ec5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
