      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:4a3b48f42de57b5e97d3a872",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只有超越两名强者并站上顶点，\n才能证明风水的力量──\n小林历奇以成为王者为目标开始奔驰。",
      "source_fingerprint": "11f85da545b6b5878fb93767695a8833e0e834f2314370de6911d73489038165",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
