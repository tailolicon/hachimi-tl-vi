      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小林历奇与同伴们一起训练。在这段过程中，\n她能往草地赛发展的可能性浮上台面。",
      "source_fingerprint": "d6b29b0edb1852a9c89260845823ceac485ceea0f3e86c9bbd89c8d64e4f4e4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098420.json",
      "json_path": [
