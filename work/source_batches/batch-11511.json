    },
    {
      "uid": "zhcn:6a36eeb6c0534ef19947101e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "英里CS南部杯结束后・正因为迷惘过",
      "source_fingerprint": "74c8e271416393fe1521a258a1ae7903518172fefe8571deeff157bd28d29d71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1098/storytimeline_501098432.json",
