    },
    {
      "uid": "zhcn:8ff9b357ae140e5b2c04bf4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "JBC经典赛结束后・未知的咆哮",
      "source_fingerprint": "bd2135def90b12115dd13161afe8ac425f0be1e765a28d7fb1c71b71cff3e8a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
