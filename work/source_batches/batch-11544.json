      ],
      "json_pointer": "/text_block_list/25/name"
    },
    {
      "uid": "zhcn:5eefe7520c02683360335582",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多亏了训练员的建议，\n我觉得愿意停下脚步听的人\n确实增加了。",
      "source_fingerprint": "4deb8330e0263b376756c6f901ccabd3e67ab4440e194458dc2be549d1969eac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099100.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:888f71e76a559feb6694da5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尊重签约赛马娘的梦想，是训练员该做的事",
      "source_fingerprint": "8f8d677523d012401ed5fc7937a43ccce52259864c011a0bb563a5dcca8bbef2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099100.json",
      "json_path": [
        "text_block_list",
        26,
        "choice_data_list",
        0
      ],
