    {
      "uid": "zhcn:084ace55a8ad84c3b1ba4972",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯，虽然从数字来看，\n还微不足道就是了。",
      "source_fingerprint": "2d58cc7ac818516ab7485129c7c05b72dceb8cd4a4c2ac0c804f01f7ffd1b661",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
