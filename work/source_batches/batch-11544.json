    },
    {
      "uid": "zhcn:4a52bff6a59bcad3de6705d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，已经有稳定的成效了呢",
      "source_fingerprint": "94450fdf9ce1bff1ed385bfc7584162d397791f0cc10264e3da0ff6f57a0072f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
