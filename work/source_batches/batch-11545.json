    },
    {
      "uid": "zhcn:2fcfa3288c7b7be9fb31f7d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她是驰骋在沙土竞赛的最前线，\n货真价实的实力派赛马娘──",
      "source_fingerprint": "c2540e4538d877947f5b97a4cfc54068806b61a7a4b94280ae65d6eb50776b40",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099100.json",
      "json_path": [
