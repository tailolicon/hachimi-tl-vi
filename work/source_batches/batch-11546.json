      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新的一年开始了，\n北港火山正准备迎接经典级的挑战──",
      "source_fingerprint": "7f446c7d45eefcec30206ad3ea3603623f1d223fc6700a2ede3c1be668a9ed8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
