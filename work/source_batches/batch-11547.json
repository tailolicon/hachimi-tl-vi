      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:1b2312804ba809ee16adf630",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──非常感谢您之前在社交平台上\n对年底的活动进行了宣传和介绍。\n营运团队也感到非常高兴。",
      "source_fingerprint": "29fdd95fbf6479fadb368e4efd4fec7d80be4786f2677e3eec464419026d4765",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099101.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:3b45013be24de3d67ce1af17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "换句话说，就是“群雄割据”的赛场。",
      "source_fingerprint": "6c9ed6ba574e3acf8a87e2e07348768020612e9af8e90b80a86f35bd0394b3e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
