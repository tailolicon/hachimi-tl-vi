      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:675c874375a7c632022cd1b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也同样重新体悟到。\n沙土竞赛的最前线，是绝对王者\n和挑战她地位的实力派云集之处──",
      "source_fingerprint": "138419e9607fe4bbadf96d0e73bd318da58d4e86cc8d1395bb3267fcdc640f96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099101.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:76ddfd6454f0422b268c24b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "苫小牧观光协会职员",
      "source_fingerprint": "f191e84bf9af06d43383136a4522b9f6517e1b4e17d900e3c398d22348a70fb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
