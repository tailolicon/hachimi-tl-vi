      "uid": "zhcn:5c71c46ed524f4b1f519b1fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且没关系的。\n我的家人和苫小牧的大家，\n都支持我的做法！",
      "source_fingerprint": "00864b7c9dd39677d5721f352096c6949f53ab727572425ac8e6922dbdedea80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099102.json",
      "json_path": [
