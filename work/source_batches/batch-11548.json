    },
    {
      "uid": "zhcn:e712792cd62e6e9b73a35bcb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在那之后，\n我也一边听北港火山为我导览，\n一边开心地逛美术博物馆──",
      "source_fingerprint": "cbfc628b3c2aa6fd52c51161626803abb8640d5f7fa4b304aadbc01122450664",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
