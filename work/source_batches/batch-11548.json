      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "苫小牧观光协会职员",
      "source_fingerprint": "f191e84bf9af06d43383136a4522b9f6517e1b4e17d900e3c398d22348a70fb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
