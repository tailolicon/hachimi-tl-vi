      "source_language": "zh-CN",
      "source_text": "就这样，\n北港火山的在地偶像活动，\n从年初开始转为强调娱乐内容了……",
      "source_fingerprint": "aa1136d92e8326896d9b0babff68efaa779df500e0a4cfdaa84fc5b333839b1e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
