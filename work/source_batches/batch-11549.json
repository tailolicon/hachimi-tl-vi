      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我带着北港火山，\n前往我想去的那间店──",
      "source_fingerprint": "8d332c9d64923e7c4b8baf57108193236b99023264d0ebfad3ab7494fb5d8ebf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
