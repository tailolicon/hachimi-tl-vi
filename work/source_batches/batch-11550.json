      "uid": "zhcn:0a2075abbf2b76eee820b8d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金船",
      "source_fingerprint": "773bb77adc4234f0841be2cd0672c54a891d010762b54baefd3bfef9f7e99754",
