      "uid": "zhcn:037edb203e6721f5798b2dba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄、黄金船！？\n你怎么会在这里！？",
      "source_fingerprint": "bb0df5f969b3b5495ff44980c49d4345f0cc59ffbee791d6bd6d027c073b43bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
