      "source_text": "啊──\n那就让我来泡吧！",
      "source_fingerprint": "4493079e1ad9a5a023b91851d65abfa76aab55f7b540cd6faeb79877cad26508",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
