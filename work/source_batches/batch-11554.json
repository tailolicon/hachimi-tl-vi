    {
      "uid": "zhcn:fc11b50fa9254c33e7e09c42",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我把“盒子”打开，\n向北港火山展示──",
      "source_fingerprint": "85c42dace98ed1f1e9c98f71851b963dd8ba9d90241ad51c6cc4c4cb2a34c3b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
