    {
      "uid": "zhcn:64f96ae8c4824ea01958f1af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──接着我便把茶泡好，\n将事先准备好的“盒子”\n放到北港火山面前的桌子上。",
      "source_fingerprint": "161c9f49098375d5da9488b084b89789a70cd3967a544cbbac7a31d4916052ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099107.json",
