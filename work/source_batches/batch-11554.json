      "uid": "zhcn:1925509d7911a2e68d6701d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "装在里面的蓝靛果烤起司蛋糕。",
      "source_fingerprint": "8db139999ea41cdac03036d60a202178bb6d3dc5d7f74bdd12646baeae2b878c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
