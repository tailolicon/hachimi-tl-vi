      "source_language": "zh-CN",
      "source_text": "啊，有今年沙土特集的\n那个节目开始播了。",
      "source_fingerprint": "330c8f25ab29968daa03cb122e5cbdc43752bb672d9007aefdb6be0ee108d458",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
