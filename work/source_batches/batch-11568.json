        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:8ca1b8ed691817d7ae7ba2e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回过神来，\n我已经喜欢上苫小牧，\n就像它成了“我心目中的故乡”。",
      "source_fingerprint": "d91270b0dcec765a8c33e5c3a2ff12a69f483af9118eb085edf3cb37c9c81d41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
