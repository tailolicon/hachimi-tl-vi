    {
      "uid": "zhcn:f1756fe7a878fc5538d3708e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我回想起北港火山第一次告诉我\n她对苫小牧的心意，\n和奔跑的理由那天──",
      "source_fingerprint": "584fcb85ad16b130ba9de10fec91dee8970d0b4d0d1df89efd7d1b91b576f153",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
