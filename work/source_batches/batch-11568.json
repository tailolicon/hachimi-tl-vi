    },
    {
      "uid": "zhcn:346de073f2b6582895e2af2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我就是从那时候开始……\n想支持她对故乡的浓厚情感和温情。",
      "source_fingerprint": "3893cc23d266dd78dd033c6feb12ca068a441c78f361763f840dfdfac08f0d1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
