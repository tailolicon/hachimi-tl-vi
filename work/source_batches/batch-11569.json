    {
      "uid": "zhcn:71f4f0dad813dd196cfcd6ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我至今……一直都……\n只推广和苫小牧有关的“资讯”……",
      "source_fingerprint": "e7be58902e11f85c0f8e701a44108bc21942d138975e5e9b8bf2bd870f569b20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
        "text_block_list",
        60,
        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:8ce54ed6b1577e33554c5b8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那也很重要喔",
      "source_fingerprint": "db86365423dc08336f456e5a4824fe546f58a2d6066af91df7e4df5eba8f79d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
