      "source_language": "zh-CN",
      "source_text": "但我却误以为会不受大众欢迎，\n所以擅自把个人相关的部分删减了──",
      "source_fingerprint": "4c8016902766deab56cb5186ee1fdac3f97b2bee403e27824daee07c8d418f36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
