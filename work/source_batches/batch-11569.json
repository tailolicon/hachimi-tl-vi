      ],
      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:15e10d6846bc15f732c05597",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果能了解到她更真实的一面，\n肯定会让人觉得更亲近她和苫小牧。\n现在仍然有胜算……！",
      "source_fingerprint": "3f3bcc336f5a30275fdbb93de5d26047ed756c13306415cccafffb9cafaed2ee",
