    {
      "uid": "zhcn:8b86fc84cd0c8575a463e814",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "把我的故乡……",
      "source_fingerprint": "aed228323f67be810e528bbeeb082a36eab99537cb49c9d18612354afde16008",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
