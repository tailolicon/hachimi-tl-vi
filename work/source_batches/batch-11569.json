      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北港火山",
      "source_fingerprint": "1ee1a88f99b1a696d33193182032b690b1f067c59c49543607bd7a836e26d514",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
