        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:33f7a419676ca244d191d0ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让大家以你对苫小牧的情感\n为起点接触苫小牧。",
      "source_fingerprint": "e1ca74fa30d903f811324d6c9f749a9c4ab034614e4cf1831cb3eded32852ced",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:cafd6812a0f0c7aa07fe368c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是只有北港火山\n才有办法传达的苫小牧魅力──",
      "source_fingerprint": "fb6e47052c521a9b6d2c72d0a347106589fa248c26f21c633a08a5606c8f0ab6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
        "text_block_list",
        56,
        "text"
      ],
      "json_pointer": "/text_block_list/56/text"
    },
    {
      "uid": "zhcn:00bbf06d31a96a283ae6a5e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对支持北港火山的人们而言，\n肯定会是最适合了解苫小牧的契机。",
      "source_fingerprint": "5c4e74ce7c6f68b0eb6643b677523dcdfd15a3c584207f9ca4df939c30c74d1f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
