    {
      "uid": "zhcn:a883ac7694148cd6f2c232a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，若北港火山想实现自己的梦想，\n她接下来该做的就是──",
      "source_fingerprint": "39aaa269cf413e36f796ee251edfdba791e4f7ceb13c0074ee8bd9f92d57198f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099116.json",
      "json_path": [
