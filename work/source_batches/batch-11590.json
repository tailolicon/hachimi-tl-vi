      "source_text": "引发争论的贴文",
      "source_fingerprint": "e0695c2a63d5afb69abbd0dbccad44355d3aef27787ccbf04789c5239cf781b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
