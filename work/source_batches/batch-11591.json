    },
    {
      "uid": "zhcn:ee708ee53a684ff79eaf83fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家──！！\n谢谢你们帮侬加油──！！",
      "source_fingerprint": "04d10cc2845a71a4f61a474afc681046f6dcdc2d95c270cd0fca35fd43525aab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:1a3f231df7ac441bb9a0c054",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "火山，我们回学园吧",
      "source_fingerprint": "d7b2f587254d9e07c61a47d75a941659924f68190d4c83f6c5684c8f06fe48dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
      "json_path": [
        "text_block_list",
        30,
        "choice_data_list",
