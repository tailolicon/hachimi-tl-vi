    },
    {
      "uid": "zhcn:4f61c43e7e196781da85f246",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北港火山",
      "source_fingerprint": "1ee1a88f99b1a696d33193182032b690b1f067c59c49543607bd7a836e26d514",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
