      "source_language": "zh-CN",
      "source_text": "………………好……",
      "source_fingerprint": "4961d9e8cfcbb2cd26cc45a6e6bf6fc97dcc2f066bc8f36861fb8486328dabf8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
