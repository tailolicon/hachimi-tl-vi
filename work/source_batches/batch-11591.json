    },
    {
      "uid": "zhcn:5b58b2055ae4b5812b390f0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天还是远离社交平台，休息一下比较好",
      "source_fingerprint": "cb8180818fc1634181ed2a11025a693fddb3749623e1a6197e9314f084c69da5",
