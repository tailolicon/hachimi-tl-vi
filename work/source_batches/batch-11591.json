    },
    {
      "uid": "zhcn:c44e5bb44c552cc44abe3a0f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和失魂落魄的北港火山\n一路沉默地返回学园──",
      "source_fingerprint": "97178bde6e00094666cdd43729b961cad7a34ae0a1c823c127bc08b9e47b181b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:3620c30fc5abf3b5b66e1878",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──隔天。\n关于北港火山的议论\n仍继续在社交平台上争持不下……",
      "source_fingerprint": "3ed39ea6f613f677e7a33bac7daf2422e38bb535ef49eae1ad4eb41e01e5f5ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:8dc68e8b8af259332a620265",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……真担心火山……）",
      "source_fingerprint": "97cbe673212fb296e7d3cc61365cc25b89e3c08a1b355db1c5d869adc66e6b84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
