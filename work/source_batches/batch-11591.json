      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:16fdc86546d8ba9d0ef73bcc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──这些贴文一来一往，\n在北港火山不知道的情况下，\n各式各样的意见形成一片混乱……",
      "source_fingerprint": "e62eaee1a6a526107e159a6c9b1d03b6c43b8d14690b4f274b88767e5b16eafb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:aa4032d740a6453390df5f60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我握住呆站在原地的她的手，\n试图让她放下手机。",
      "source_fingerprint": "0aee71662a66a2a5c6685f8fa5ac3b280c48847b48ec5eafbd1573f153fed3c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099307.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:4e2dbdd5981487e959759446",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一定很快就会平息的",
      "source_fingerprint": "99bc38f903eca8ffdd0a33c763a231a48835e1e0f7d350cfef2a4a1a49d38c9e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
