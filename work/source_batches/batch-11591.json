        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:e2634b574892b50d4ffc4d00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "社交平台的贴文D",
      "source_fingerprint": "75b98dcb4d1fee54c2fb35801a743597ec6df4e19024f90f7f70049f33dde639",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
