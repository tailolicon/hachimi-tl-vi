      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──训练员！\n来决定下一场目标竞赛吧！",
      "source_fingerprint": "08b0d14fc9ef00f1652c2d8de7fe02592a654b393f74b440f21926bd34a4b3f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
