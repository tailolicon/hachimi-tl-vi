      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……小火山的事情让我很担心。\n……训练员你还好吗？",
      "source_fingerprint": "39b7ff76b3c10173f96c20c5c2930e9df7855875588a6adc249e8c1cc81aad52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
