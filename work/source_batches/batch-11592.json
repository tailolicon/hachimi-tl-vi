      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……屋内只剩下通话结束的声音。\n既响亮，又冰冷。",
      "source_fingerprint": "5a1f9a37c93953b861bc3aff99dc377625f45c10ebacd05769cc34bc51f39c7d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
