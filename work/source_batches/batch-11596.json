      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了引出醒目飞鹰，\n她打算展示“历史性纪录”──",
      "source_fingerprint": "a3d19a516182d93f1a371c099d67852b7065229c279aab6fe724e04cd64bfa3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
