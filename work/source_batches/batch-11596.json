      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏的实力曾让北港火山感到震撼，\n但她现在已经成了能与其并肩较量的存在。\n这个事实也让我感到非常骄傲──",
      "source_fingerprint": "f6e02b14ed883a9aecbe0e5e2f333afbd564fc13b3fa5b80139e18f91e8d99dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099310.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
