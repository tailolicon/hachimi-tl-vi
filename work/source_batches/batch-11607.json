      "source_language": "zh-CN",
      "source_text": "这样下去，即使她的人气之后到达颠峰，\n苫小牧的知名度也只会有小幅提升。",
      "source_fingerprint": "cd78680db13593bc955a2bbaab58179f99a0c24786e5b2810ddffb86ee10b370",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
