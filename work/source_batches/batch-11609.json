    },
    {
      "uid": "zhcn:60f2ceb8f9766b4914092337",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北港火山将醒目飞鹰对沙土赛马娘的\n喊话铭记于心，并朝着下个目标\n“猎豹锦标”前进……！",
      "source_fingerprint": "140afc341f5c8ad719e6707afe27b42ba4f9b4adde3218353e6bf42b50734d33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099419.json",
      "json_path": [
        "text_block_list",
        4,
