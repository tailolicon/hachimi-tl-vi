      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:8cbd23305424e5d4ee4182f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "过了一天仍未平息的争论让北港火山发现，\n大家只注意到自己是沙土赛马娘，\n或者只注意到自己是在地偶像──",
      "source_fingerprint": "8ffbd7c247e5f1adada6a511c0bfed1aba3cf82b85b822f8334b021407c132dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1099/storytimeline_501099422.json",
      "json_path": [
