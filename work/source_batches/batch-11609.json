    },
    {
      "uid": "zhcn:f2111f0680e0090065ce0875",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・在地偶像的证明",
      "source_fingerprint": "e219e0ce991d5db551db570d859a649b8f4ab806f4c865cb2c6a2bdea04a532e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
