    {
      "uid": "zhcn:89575872cf48d6bb43594898",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的表现鼓舞了小林历奇，\n也打动了醒目飞鹰的心。",
      "source_fingerprint": "2445d43a26ed1e9b8a216ab97e5acb6a992ea552f3316ce847cba5290e2309f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
