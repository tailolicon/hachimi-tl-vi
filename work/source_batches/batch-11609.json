    },
    {
      "uid": "zhcn:460f6bf0785fac794d0adfd5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "北港火山在比赛中获得好成绩。\n观众们开始注意到身为在地偶像的她。",
      "source_fingerprint": "5fa6572e4ea4e425ee3e7121d4deacfcf5a40e469870f470387861bde8e13509",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
