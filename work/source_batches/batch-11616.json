    {
      "uid": "zhcn:0f955d3ffc3ee58fd4bae6a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想像这样把苫小牧的历史和优点\n一项一项好好传达给大家。",
      "source_fingerprint": "a2cb35166bd8c4f95b3d3490581d157e15d3c0af66c34fdc9a6e54717372687f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
