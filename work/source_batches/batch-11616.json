    {
      "uid": "zhcn:29138ff96b7cda1a2e801136",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老家的人",
      "source_fingerprint": "f0d73afef3879cd0d1562508dc8788368ffeb54e0d3a32cb5ca599b246422a26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
