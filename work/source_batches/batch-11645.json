    {
      "uid": "zhcn:5a94a9b3ea21ddcc52e88516",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经典级的这一年，\n对草地赛马娘跟沙土赛马娘来说都一样重要。",
      "source_fingerprint": "244a7f7f829d24eb2ef1b84793a5e18b871e3770a991caa3b61dfbb4671e80ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
