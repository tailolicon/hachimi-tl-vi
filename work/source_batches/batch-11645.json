      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:e7bbab895bf81fcbee166743",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要想尽办法获得参赛权，\n并在那里留下好成绩……",
      "source_fingerprint": "a4c29f2cae1c7bb35f3971cf2447f08111d927837efc9b28f5ef198571b57695",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
