    },
    {
      "uid": "zhcn:97d7a8796256c31236cc7c43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尤其是夏天举办的“日本沙土德比”，\n更是所有沙土赛马娘所追求的祭典。\n",
      "source_fingerprint": "1e7ef8bc1ae1148e984d88ee80ca37c9c6ad3921f917497ea9580514e2571454",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
