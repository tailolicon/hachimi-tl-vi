    {
      "uid": "zhcn:76751e725b92c23540b0fbc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔……这少根筋的程度……\n看来你是个不容小觑的对手。",
      "source_fingerprint": "0fbf13f7e5631cafd94dcb810a05e1e3c342b57541ecc553b5ef0a3629f73ced",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
