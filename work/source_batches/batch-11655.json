      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏在持续参赛的同时，\n也当上了拳馆的会长。\n",
      "source_fingerprint": "51c0a5d8062655e6aba724b010870d9a3721a6210b30cb36b65f4f8bc4886555",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
