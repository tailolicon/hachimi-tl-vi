      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:ba55c62ab471bdd556c4415a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们两人就在温馨的气氛下出发了。",
      "source_fingerprint": "a81fdd862ff14c0d8b7babbcfab50b79aa6e15fb1c6198ab4ccfbe604c514b51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100112.json",
      "json_path": [
