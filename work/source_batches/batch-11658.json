    {
      "uid": "zhcn:bb69c725f7e06300cb896044",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在我与奇锐骏一路赢得许多比赛后的某天──\n",
      "source_fingerprint": "5cdf00c550068a413a93bc0dc9fe60cd2457e7b9313a05540120178e6f4a573b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
