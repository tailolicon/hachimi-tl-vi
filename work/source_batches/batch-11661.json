      "source_text": "睁大──你的双眼！",
      "source_fingerprint": "93a12094b2cc1f34072230e0b6c34e6e0f9c213283ce068759e86a3a9929d52e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
