      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事长",
      "source_fingerprint": "610762d94d7d1f35bbf866cd6d6c8f5d78f090737bc26dcba88e358dac124ab3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
