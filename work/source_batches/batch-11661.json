    },
    {
      "uid": "zhcn:21f50c74a35d0c99a6c3ca79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我看到了天空。\n一片无止境的蓝天。",
      "source_fingerprint": "eaff6f511c4f63a401060ebf3703a16f15b173c6760760f04bfb2f24fa34ac74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100114.json",
