    {
      "uid": "zhcn:65a082332c233a346b9e6934",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要我对自己有自信可不容易。\n我在特雷森学园的生活……\n多得是不如意的事。",
      "source_fingerprint": "977127632f2eb70de90492711c9d9b994fa8e3e1e800a6a18dbde816144eac41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100114.json",
