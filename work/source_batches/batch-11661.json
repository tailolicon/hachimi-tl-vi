      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:62391b9463badc3ebac3e108",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后我看见了──",
      "source_fingerprint": "4b944c2045c9e2dfd17d089139b5595df3481d829577896ff8b667305553ab42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100114.json",
