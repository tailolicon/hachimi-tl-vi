      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔，无论如何你都不愿意张眼吗？\n那就──",
      "source_fingerprint": "a8192f39ae07cfaec58e26ed01d48c9cea9c284da4c7889f673df750ee9d8206",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
