    },
    {
      "uid": "zhcn:87d27695250d3415910c790d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在我们能用心观察对方，\n并诚实告诉对方自己的想法后，\n我们的关系迈开了强而有力的一步。",
      "source_fingerprint": "ec5e4985d4f88d4b860fbc9609c6d8aefacb230cd66b9f9fb6ae0d0cbd2ef9b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
