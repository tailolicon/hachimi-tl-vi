      "json_pointer": "/text_block_list/84/text"
    },
    {
      "uid": "zhcn:817862d0c13215902012977d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "完全被她说中了。\n在违背基本原则的状况下，\n是不可能把赛马娘训练好的。",
      "source_fingerprint": "f87e0a0f17a19f9fecd7eaf45b8d7be9ac65447d72fa9d0b8c3501f5c2391241",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
