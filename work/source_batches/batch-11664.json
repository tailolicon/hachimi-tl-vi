    },
    {
      "uid": "zhcn:3b178d4f1276e2b3b23f2cc8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这不单只是为了他人的善意。\n应该还包含了──本能。",
      "source_fingerprint": "59209ae9f72df1b8abb664d82788523065b1e623f6f4b6ff45c7e4c5e83094df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100115.json",
      "json_path": [
