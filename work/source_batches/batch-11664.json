      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "刻意舍弃这样的智慧加快步调，\n也算是一种智慧喔。",
      "source_fingerprint": "4cd3f06f1d83ef85949b37ad9873c8270670e77eab4e5d3dbceb0f65bd8c694b",
