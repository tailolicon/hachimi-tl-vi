      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你要去哪？",
      "source_fingerprint": "d0c4d79a27e97a366a5e261e9a804f8f145b09d1dc0ecb8819d82a6d07fe5307",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
