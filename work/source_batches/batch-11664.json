      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会觉得很难为情唷。\n别这样别这样……不敢当不敢当不敢当……",
      "source_fingerprint": "7f32ff3bcd98b941afdc822ade391bd157ef6cc3e87927b31b4622f2d6343841",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
