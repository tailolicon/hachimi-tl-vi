    {
      "uid": "zhcn:ef00ae138f08a1ddd516dbd3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是我……是我自己……\n是我想要现在立刻就赢呢。",
      "source_fingerprint": "fa885e960d2d3a733d585199151d943a3df5cf75528f3cf98c712e7bca436928",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
