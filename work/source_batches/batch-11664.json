        "text"
      ],
      "json_pointer": "/text_block_list/67/text"
    },
    {
      "uid": "zhcn:90c66b05c339de9537f56aeb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我明白她想表达的意思了。\n将她最大的长处──持之以恒和续航力──",
      "source_fingerprint": "0c336b1ee17d5e3f10538341977b42730a10ecbc90ac4ebd23415a171e310e94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100115.json",
      "json_path": [
        "text_block_list",
        68,
        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:3eab4533dfb3be19ef6ddee0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "全都舍弃，进行“全力调整”。\n而且是选在“川崎纪念”──！？",
      "source_fingerprint": "122c718c988524dbd8f930ddebd247563e4453d3a8ca4dd9da20a25335be098f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100115.json",
      "json_path": [
        "text_block_list",
        69,
        "text"
      ],
      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:ca67f00c908259164d258707",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我急忙叫住因为害羞，\n不知道想跑去哪的奇锐骏。",
      "source_fingerprint": "7fe7f25220ce124cb45bf5f42865e2001787310646431a66dd1eb4aa7805995f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
