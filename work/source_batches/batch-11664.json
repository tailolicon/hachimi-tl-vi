    {
      "uid": "zhcn:6ed461a373bcf2a338f10141",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但要在下一场比赛就做到……",
      "source_fingerprint": "26fa390e97db0d66e9b2c1d2f159cb6a5d777c18650b05ee292336ae7e0cf48b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100115.json",
