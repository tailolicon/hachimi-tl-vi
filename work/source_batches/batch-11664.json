    },
    {
      "uid": "zhcn:e2dbdd027ddfed162502f6c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算要稍微缩短我的职业生涯，不眠不休地追赶，\n我也没关系。",
      "source_fingerprint": "d8efa2b5c71f8688f14933321afd29422f1df84f85fbb8f77947e11218f53133",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100115.json",
