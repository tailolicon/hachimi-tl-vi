      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:a2e3bc52c7cf4ff9bcda2d64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "却是在GⅠ拥有七胜成绩的超强选手。\n并以天不怕地不怕的个性自豪──",
      "source_fingerprint": "1d9c39b9a7c3806f491b07343dac121f00c8c3f7fe92a568f37e722f7a816ad4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100304.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:47dcc1c73e22bee96be30cd8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论竞争多激烈，也绝对不在终点前让步──\n可说是王者中的王者。",
      "source_fingerprint": "f27253a73938b95d9522dff3375541f057a3ac4f830583176f931f3311af090c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
