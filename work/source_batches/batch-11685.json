      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100306.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:a8ce364014d9a252a0adebdf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏",
      "source_fingerprint": "a207abcfd80fb4fb6f8d31f126614b1c06f6c929c600c2ce53b7c13145067eb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100306.json",
      "json_path": [
        "text_block_list",
        28,
        "name"
      ],
      "json_pointer": "/text_block_list/28/name"
    },
    {
      "uid": "zhcn:f4840f4100f8ec1afdeaa1b3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你觉得呢？\n我是不是差不多，可以紧追在她身后了呢？",
      "source_fingerprint": "2507c592691913e91f8bc1149fd039a03bd9cc5b748299c6c9538e199d6e7d7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
