      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:b772ed6b9d4ab58e4f9d2dd1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一起去“东京大赏典”吧！",
      "source_fingerprint": "39c03e174464e99dc9fa074066be3da2741d2e8cb949d603a9d628577e1f9c84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
