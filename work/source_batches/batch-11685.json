      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:89e518e35227e440586e311f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏",
      "source_fingerprint": "a207abcfd80fb4fb6f8d31f126614b1c06f6c929c600c2ce53b7c13145067eb1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
