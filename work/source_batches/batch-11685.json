      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:f341a48a52e5842bfde00c29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的目标，可是“追上她”。\n",
