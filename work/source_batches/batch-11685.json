    },
    {
      "uid": "zhcn:f9291a20012ebd538bc1473f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某训练员",
      "source_fingerprint": "c80ac0dc7cedb15175e156051d5cdec4800695a514844adc6c22d46b4c841088",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100306.json",
      "json_path": [
        "text_block_list",
        3,
