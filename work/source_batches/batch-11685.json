    },
    {
      "uid": "zhcn:205ccf6c15d7e7e3fd7a78ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，坦白说我还不觉得自己能跑赢，\n但是～",
      "source_fingerprint": "c62124f73e5a33219dcfa0dae9389660483c336f38ead6da5e60f680c47639d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
