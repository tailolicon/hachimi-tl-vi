    },
    {
      "uid": "zhcn:35f2bee73bbfec6fc412ae2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔喔喔，想不到能听到你对我这么说～\n好感激呢、好开心呢。",
      "source_fingerprint": "c16610ea4bf1aa78dbd633ac12b464dabe648d86c549693827e805207cc8a442",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
