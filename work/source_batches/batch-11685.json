      "uid": "zhcn:b9ac8768adb34eee06ededd4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只能实际跑过才知道了。\n──在年底的大井赛场上。",
      "source_fingerprint": "015a615c83fd92b02c46b84fc9b1adde9b28eedee3adb35ba6696784903a87b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100306.json",
