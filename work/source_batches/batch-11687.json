        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:21415e8de2d4f901e6f241e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，今天的你真的很耀眼！",
      "source_fingerprint": "c39557a8d1aea7ba30dc935616796fd90902e093500aef5c5c94a2dfb6bedcd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100308.json",
      "json_path": [
