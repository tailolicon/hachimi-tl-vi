      "json_pointer": "/text_block_list/31/choice_data_list/0"
    },
    {
      "uid": "zhcn:1fe302e720670c8f89118088",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，今天的你真的很耀眼唷！",
      "source_fingerprint": "54c889b81220a6c8163a81e785274d365660523f5f6f15fb0201200ad0c301f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
