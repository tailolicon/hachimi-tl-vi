    {
      "uid": "zhcn:b3d571d6eb68c11bf9c0fef4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，\n要去哪才能再跟飞鹰子一起跑呢？",
      "source_fingerprint": "a02eacf0c2a239e9b3b07b3118c4a8d6a9df9cac1cbe0b13fc9d9f5cdb19b91f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
