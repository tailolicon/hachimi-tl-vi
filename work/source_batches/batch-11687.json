    },
    {
      "uid": "zhcn:2f42fa6cca369b492c20fb13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……说话到一半我陷入思考。\nGⅠ的“二月S”的确是沙土最盛大的比赛，\n但是……",
      "source_fingerprint": "0582e3b2ae96fba5f9afa5740f549e313c80c2157b500ba823e15aacb4d3c4e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
