      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的姿态在全国转播──她全力绽放的光辉，\n强而猛烈地照亮了大家的内心。",
      "source_fingerprint": "151f3a28a4e5ad6acb300afc707cdaa1fce7ba57b02c69aa593ff471f1eec469",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
