      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主角的表现！\n我心中的火在熊熊燃烧！",
      "source_fingerprint": "5919ad13deb3f8632a5b86c97011fe901277c47b4cf6160d7b774cf4153e3f69",
