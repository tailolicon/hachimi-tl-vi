    {
      "uid": "zhcn:30a2aaac5cb05c8026761079",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果她讨厌跑步就没办法了。\n我无法强迫她，也不能强迫她。",
      "source_fingerprint": "45544ba2155c9a486d79f309b17d09b893f4da343bfc69a878be1a33f2a3ceef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
