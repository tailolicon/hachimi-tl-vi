      "source_language": "zh-CN",
      "source_text": "因为对脚的负担较少，\n所以能在第一线的期间很长，并且──",
      "source_fingerprint": "7ecf95cb4785be8ad06bbc17368a1894285dbaaffa2de2ab5f756491e2c7d018",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
