      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们的未来或许能继续得更久一点。\n奇锐骏的未来──还能长久地持续下去。",
      "source_fingerprint": "eb4cb90f0d1216f41b18e1fd0c0b264a4e49f562c493e87f749145701225aec7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
