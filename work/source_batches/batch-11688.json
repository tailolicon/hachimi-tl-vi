      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是……",
      "source_fingerprint": "c508ff2f5a5b37e768671342ec0dd2d0bcab53aea44fc4ab276020e49ccf8967",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
