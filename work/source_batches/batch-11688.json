    },
    {
      "uid": "zhcn:6f000a481dada7972067e9c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──过于急促完成的梦想。\n要是没有那场比赛……",
      "source_fingerprint": "5d2d283d317c9489c554b2ded20c8b38b5f49249f0f77f587e82dcb6037c9820",
