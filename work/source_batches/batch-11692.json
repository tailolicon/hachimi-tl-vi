      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员因为担心奇锐骏，\n考虑要终止严苛的训练，\n但好歌剧却表示──",
      "source_fingerprint": "36a000adda2c01b60fafc3edea6dc16d293d508c52e6aa959f627e2b77d99ec4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
