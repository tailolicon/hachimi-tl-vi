        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:2d498e8922188f556b8ba13e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏登场！",
      "source_fingerprint": "a0411d00de60235aef76b556307b1af742f69cd315cf9cc83514137b3e82c0be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
