    {
      "uid": "zhcn:fcb083c8d8e51001a9940fea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "另一方面，走严苛训练流派的训练员\n本来因为找不到契合的赛马娘而苦恼，\n但在奇锐骏的接纳下终于看见了希望。",
      "source_fingerprint": "fad7d0bc0aff251ffbf9325f5f3956f99077bec98e7eed04c07f7df34a7e1a8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100400.json",
      "json_path": [
