    },
    {
      "uid": "zhcn:9bac5e5be51975f8d782d602",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为此只能舍弃稳扎稳打，\n拼出瞬间的炽热。\n奇锐骏决定牺牲未来，以必死的决心猛烈训练。",
      "source_fingerprint": "15c3cf3c84d6942c1e823605ecc9ffbb192ba696d6fdb259f97cc219cd938f7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100403.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:7f348fdef6da41373029e1bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "集合众多的银",
      "source_fingerprint": "2246a9ac624b49ea5e802582e6a805a151f7f3bb05c77319eae520c5af3fb26b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100403.json",
      "json_path": [
        "title"
