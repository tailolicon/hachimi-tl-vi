      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:2fa5bb7aaefadaf31b2b0628",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若要真的让大家看到希望，\n就必须在比赛中\n绽放出超越醒目飞鹰的“光辉”。",
      "source_fingerprint": "670c554d525d27225ba5a1e07ec21020b9ae3d9b9473afd75a2563d2df693d72",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:67c0c3d6f39f5360d8c03830",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
