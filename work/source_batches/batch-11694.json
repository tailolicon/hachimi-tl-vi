    },
    {
      "uid": "zhcn:e198c5d9bfa6f7528f6602db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・怎么好像累累的？",
      "source_fingerprint": "1dc4e1b4aef3cae5f7791af747e9eb3b4ece64f5a7f71277ab92023736195c87",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
