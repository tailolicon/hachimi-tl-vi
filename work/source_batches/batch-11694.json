      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:52ac6a909c11018fb60c80ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下个继承者并不是北港火山，\n而是奇锐骏。\n她决定以沙土第一人之姿接受挑战。",
      "source_fingerprint": "dad28da832b1445a19b604121161c6423c316df83528e980242b829c5cc5a792",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100417.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c38e5e4e99d5224fc20e82b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎向东京大赏典",
      "source_fingerprint": "17e656d8ecc70789085a9335f998d6ecb0cd0dad01f61c5298e1cba1fa1c2a67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100417.json",
