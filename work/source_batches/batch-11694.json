    },
    {
      "uid": "zhcn:c6deb6122c648b4786bfc1f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而最近她的体质似乎变得容易疲累。\n明明她正使用着\n训练员所推荐的饮食管理程式……",
      "source_fingerprint": "dbd64ab745b08474107669b506e31fa5d1053d92702d9b0de96e25a32a5c8cdb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100419.json",
      "json_path": [
        "text_block_list",
        1,
