        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:ceb89d9b64fd78e188895d90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战结束后・以电视机前的观众为目标",
      "source_fingerprint": "d3bf16d0ba60b55d018e42091dccd70ddea818a47311194c4442b6d7aeb55542",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100418.json",
