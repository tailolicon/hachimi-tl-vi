    {
      "uid": "zhcn:1b0b1075e5346b6234f33f02",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "奇锐骏在出道战跑出了好成绩。\n但为了让住院中的人们看见希望，\n她想要参加能获得更多关注的比赛。",
      "source_fingerprint": "46825b03f8fa357dae1df9ae3f2d4012aed052a95f24f714b32b851cc757f9f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100418.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:c0d0b707d7b08c94abb3da62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
