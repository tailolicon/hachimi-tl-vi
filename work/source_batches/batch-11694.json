    {
      "uid": "zhcn:ed35236d1e0426044689cdcd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "透过严格进行基础训练，\n奇锐骏的表现进步了非常多。\n下一个目标是“日本沙土德比”。",
      "source_fingerprint": "13c6aecda956552af1aba8cd86b80e09e7a67bf00461679ba1d37df92f992551",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1100/storytimeline_501100419.json",
