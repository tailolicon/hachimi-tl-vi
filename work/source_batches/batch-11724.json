    {
      "uid": "zhcn:716fb0680978ca8737fca8b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好厉害！那是什么跑法……！？\n那样居然还只是出道前吗……！！",
      "source_fingerprint": "8460b2d313bfe380f35f52eba34bbc4b1f76787ff279c58dd6c14f4804c1cb4a",
