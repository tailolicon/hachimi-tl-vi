    {
      "uid": "zhcn:109a863e67b5d8d4f21a4770",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……那样的存在，居然是她的同期吗？）",
      "source_fingerprint": "56c77c79d292f72ec5e501895e168921491c4a3e5e6b03a440e3d9818fb17819",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
