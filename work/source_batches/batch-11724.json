        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:57a75b313bf39ff4f63f4728",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她是葛城王牌的同期，\n同时也是她……憧憬的对象。",
      "source_fingerprint": "f38c00dcf44164647a4e0214ef8caeff490e99ce8411a7bbe4eddafa34ff732b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
