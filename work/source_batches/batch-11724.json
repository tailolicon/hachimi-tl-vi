    },
    {
      "uid": "zhcn:c806b7d33b721dfe9c3717a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表是一位受到周遭高度关注的赛马娘。\n早在出道之前，\n她就因为出色的才能而备受瞩目。",
      "source_fingerprint": "0b23d696da07c3e33f4e5eb22b5c2a5f2bd2d6c994c98cc7d54fce49e5e56bc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104100.json",
      "json_path": [
