      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从葛城王牌口中得知\n刚才她与朋友的对话，\n以及千明代表的发言──",
      "source_fingerprint": "d73ee7119c08f30389316843e2c754d8822101b5aa7bed5be22f921d21a69425",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104101.json",
      "json_path": [
