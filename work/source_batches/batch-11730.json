    },
    {
      "uid": "zhcn:d825ea83592d6a2585339248",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……呼……",
      "source_fingerprint": "855324f325b45ab757c58f849841cb9ee1df8cf01fa20beda2d412c2fc4109e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
