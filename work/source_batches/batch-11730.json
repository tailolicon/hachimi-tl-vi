      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:0c4da4a80000c151e59ad42c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我必须要改变一切才行──！",
      "source_fingerprint": "4873de1e798dfcd5d29b4f14210972a0acd1a39571077c54681d78d85180bb9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:d03320b146849ec5718e2efa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "乍看之下葛城王牌像是\n为了“天皇赏（秋）”\n而专注地进行训练，不过──",
      "source_fingerprint": "d9013f5c15af1edc9bb8b3e77880699e31d32365de4de5a7ab57b4cbe1d3ec10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:0df024e0ca1a214c3f915e75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（不能就这样放着不管）",
      "source_fingerprint": "ed83c87da434d2770310b2139d196d399baa78da72029cb6728087b276e5512b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        5,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/5/choice_data_list/0"
    },
    {
      "uid": "zhcn:38b3fbf807e48da579975331",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "事实上我能感受到她的焦躁感，\n她似乎十分精神紧绷……",
      "source_fingerprint": "399ed4d6c58295d2973e9f22f001ac2bb90513ddcc0981a09da94b46968b9183",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:72a0be4db76f7347738630ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "必须设法调整葛城王牌的心态才行。\n但我一时却想不到该用什么办法才好。",
      "source_fingerprint": "fb64cf1640f71d7b74aeacc2196db5b1d6b32c04efcdd7f89c3526b88405c5c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:ca19b23fd2f00c29a0ad3c03",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当焦躁感也渐渐地渗入我内心时──",
      "source_fingerprint": "4b68b40bc34510512021b9210cb3611376484b72754b6f5d8790e359e1e2d657",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:fb4f34910afb792d054b8d84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（是王牌的粉丝们寄来的……？）",
      "source_fingerprint": "86c2855b3d4dfa6b487c093d5ac90c029cb07c5504308f21f073417d8cb3869b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        8,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/8/choice_data_list/0"
    },
    {
      "uid": "zhcn:4d43900a489ca490a8ea78a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──那封信寄到了我这里。",
      "source_fingerprint": "c2027d5ae3484ecbbf23fef47e632f5976cb633c585bcb933865c56f6d75fced",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:37a8b5e1c5ff25db6d078470",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一群葛城王牌粉丝集结而成的团体\n把写着某个委托的邮件，\n寄到了我工作用的信箱。",
      "source_fingerprint": "6c6abbc25300591a47298af27a6f6991879f2fc329849febc275cfa68f87c651",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:d0a87553244bf009bfac9e2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第三年）开始！",
      "source_fingerprint": "eef37080660583492caac78b957b8f144bbb2896156162385fc6034f5649e4df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:38650f07f2a340a9a6aba72e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白善信",
      "source_fingerprint": "292838dd30209de26be736979e1f3a3bc826881c9ce11ed7480a487776eff441",
