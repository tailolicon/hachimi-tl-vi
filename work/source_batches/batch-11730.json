        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:3f13fe4e5e3c3e473afaaa14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可恶……不行不行！\n这个样子，完全不行……！",
      "source_fingerprint": "d8a43385b307d854c3a8c27fbe76c30a6bd6d3dd62463d46a2a12f3c95859202",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104105.json",
      "json_path": [
        "text_block_list",
        2,
