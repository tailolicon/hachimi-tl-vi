    {
      "uid": "zhcn:d626e98cac0c0d105013257e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "简单来说，我们没有余力为迎面而来的\n圣诞节气氛感到兴奋──",
      "source_fingerprint": "b8be100d5ce9b2144c3b838abd67fcefc2be8b7f645fd66f514cfc979193c1c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
