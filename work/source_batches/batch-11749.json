    },
    {
      "uid": "zhcn:3526f690796e5dff2c27047d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "王牌的粉丝代表A",
      "source_fingerprint": "47e0a48b8bea140e4fe78de63790f9e454741329190b6f4dba1da374a0781950",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
