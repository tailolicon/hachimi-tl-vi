    {
      "uid": "zhcn:aa49f1d6405a52ff494012a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我开始关注你的比赛后，\n便从你的跑姿和战斗之中\n获得勇气──",
      "source_fingerprint": "1136713e8bcb4a283bed1001388e2c39bd669143f4ff2eb7ef3d243e8c543383",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104117.json",
      "json_path": [
