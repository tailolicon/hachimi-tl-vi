    },
    {
      "uid": "zhcn:2019302df2fa064b70d5c74a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后，你终于能以时代中心的身份而战！\n这真的非常帅气……我很感动……",
      "source_fingerprint": "fcd996a49f2fd895611f7e1463e308bd9622dddf19ee4924bdb27498c349b2dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
