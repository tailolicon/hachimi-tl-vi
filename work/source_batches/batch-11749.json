    },
    {
      "uid": "zhcn:baa4d39ba1fbde8d34196f65",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当时我闲得发慌，\n不经意地常跑赛场看比赛时\n正好看到了你的出道战。",
      "source_fingerprint": "81daf75abf201b03c2233cc2333b6c64d690658d778be96de831708dffba5cab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104117.json",
      "json_path": [
        "text_block_list",
