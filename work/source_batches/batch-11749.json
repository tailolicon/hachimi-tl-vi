    },
    {
      "uid": "zhcn:cbbbd46a99bb71802c9e921b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说实话，你的经历和其他同期选手相比\n并不是那么引人注目，\n但看到你拼命奔跑，朝着未来努力的样子──",
      "source_fingerprint": "6e2edfeba8590a3a8147fa337415403287d9b21ed3ff1fa52afc7dda93e2f293",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104117.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:9a0b288f7aa847cfd2b830ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "王牌的粉丝代表B",
      "source_fingerprint": "7f0b2f7b3aad625506f00d5ba39b249ac8c42c21ccd9f770ea2c40b8d682877b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
