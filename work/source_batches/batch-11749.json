    {
      "uid": "zhcn:56ae29251812adc7d067acd6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看着你拼命呐喊着，不断向前奔跑的姿态，\n我受到了极大的冲击。",
      "source_fingerprint": "b8c401916af771e874cb0f8be7cab8e0a4c860006a8348971dd7ed4a7694eb6d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
