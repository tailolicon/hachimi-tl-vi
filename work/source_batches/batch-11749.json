      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "王牌的粉丝代表B",
      "source_fingerprint": "7f0b2f7b3aad625506f00d5ba39b249ac8c42c21ccd9f770ea2c40b8d682877b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
