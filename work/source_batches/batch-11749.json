    {
      "uid": "zhcn:a52250d0582923417dd134cb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知不觉中，\n我开始觉得想向你看齐，\n坚持“必须战斗”才行……！",
      "source_fingerprint": "224103f00f3b2d63a1db8916cf8963a6915ccbf310ffefe3f369de78cb13634a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104117.json",
      "json_path": [
        "text_block_list",
