      "source_language": "zh-CN",
      "source_text": "……现在开始以最快速度行动的话，\n应该勉强可以赶上比赛。",
      "source_fingerprint": "08ff74238073cf55e960424825cdbc156002fafc313bf0594ede584cb8839faa",
