    {
      "uid": "zhcn:6807e44eabf5722c2ac9e74f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这、这样真的可以吗！？\n如果不好好留意身后的人──",
      "source_fingerprint": "46f639077b63a94ac49e2f86b3def7e270b4c2e28b068a6c1cb08760b484fdc0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
