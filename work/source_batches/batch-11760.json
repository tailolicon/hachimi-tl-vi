    {
      "uid": "zhcn:10c0ba3e53b57d89b971ffaf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是葛城王牌现在\n能够采取的最强战术──",
      "source_fingerprint": "73f202db57b943a97427ca8015c2b563e374e8f611c94192ee12e4e391b48a60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
