    },
    {
      "uid": "zhcn:6393b04d1cafd3dcc8e6217f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是只有你才能做到的“王牌”跑法！",
      "source_fingerprint": "cc067a5f1a63b9ca87b593c479aaf7794a2edc3f76d7ab0d8bd6c7a41492f01d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
