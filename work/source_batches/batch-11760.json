      "source_text": "葛城王牌",
      "source_fingerprint": "a1e4f90b59d679f54f3a8c84a8c11fe55f91cf86a898da433bbfe74a988804c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
