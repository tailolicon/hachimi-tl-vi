      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只有这样，葛城王牌才能展现出\n“中距离最强”的实力……！",
      "source_fingerprint": "fe3168712356d85ed5ef96c321abe8d964bcb583869ca2fecb36af9ca991140a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
