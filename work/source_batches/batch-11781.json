      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──几天后。\n千明代表因腿部有些问题\n而宣布将进入长期休养。",
      "source_fingerprint": "8b5fe003b9eb306ca409bcf06a22971fc1c2ea3f34801751aaf8fdf41292d4af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
