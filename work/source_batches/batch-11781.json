      ],
      "json_pointer": "/text_block_list/72/text"
    },
    {
      "uid": "zhcn:5f08770d70700870cda292f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "简单来说，我们的目标就是成为\n这时代的“中距离最强”。也就是说，\n需要取得符合这个头衔的成就……！",
      "source_fingerprint": "140ea203a95edbb91206f6b11236cb20178528ad81fa075ca1fae5b874f6174a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104312.json",
      "json_path": [
        "text_block_list",
        73,
        "text"
      ],
      "json_pointer": "/text_block_list/73/text"
    },
    {
