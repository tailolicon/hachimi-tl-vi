        71,
        "text"
      ],
      "json_pointer": "/text_block_list/71/text"
    },
    {
      "uid": "zhcn:42db95025322c4615c3ccb4e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──以至今为止的比赛来看，\n我确定了葛城王牌在中距离特别优秀。\n接下来应该专注加强这个强项。",
      "source_fingerprint": "57d3de33600f87fba133440220fb43dab36dc2b4d48df8e3b13be8c249764f84",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104312.json",
      "json_path": [
        "text_block_list",
        72,
