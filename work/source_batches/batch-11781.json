    {
      "uid": "zhcn:dcc18470736f72ee35754bbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌！葛城王牌！！\n冲到最前头的是葛城王牌！！",
      "source_fingerprint": "e55f938b5c1b0b120ca85413cc0e882abbf26759352dd3b64a1be39a366a2a7d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
