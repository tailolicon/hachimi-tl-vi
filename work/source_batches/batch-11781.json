      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了这个目标──",
      "source_fingerprint": "c80a4ab499721d347692bd10640c4d32dd06b2a459aaa5b262585a219d1d82b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
