      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“一定”要赢下“大阪杯”和“宝冢纪念”",
      "source_fingerprint": "64db16468354ae27290a471ed73e730b74b076a789ef27d7f5fc13d6ca7aa4b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
