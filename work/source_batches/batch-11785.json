    {
      "uid": "zhcn:4915932c6fd7ac4a07014665",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦！？真、真的吗！？",
      "source_fingerprint": "792371f742877406acaf80f852543537a21873789f6df76151ae90dc87c5bd27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
