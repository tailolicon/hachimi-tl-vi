      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──但是，我会赢。\n身为立志成为独一无二的“皇帝”之人，\n无论面对什么对手，我都一定会赢。",
      "source_fingerprint": "a8fa082b15d15e4be05b36c55153baebb9bb69e629ede2a44cd00857989ebaf8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
