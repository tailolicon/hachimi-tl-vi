      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“唔喔喔喔喔，终于来啦！！\n千明代表对上鲁道夫象征！！\n我等这场对决等很久了！！”",
      "source_fingerprint": "032b739482d66d1b27cc2741a39f3dda7423df448139c1e41aff1800dfe9a710",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104317.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
