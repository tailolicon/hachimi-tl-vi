    },
    {
      "uid": "zhcn:e937119dd69d63ad16437417",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "世人的反应",
      "source_fingerprint": "c531fdb581d38252768c04e9156feeb53e660b4b1b7b36a4f09c1835b6e8870b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
