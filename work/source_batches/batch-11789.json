      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我非常清楚这将会是场严峻的比赛。\n根据我的了解，这个舞台聚集了\n为时代增光的至高赛马娘们。",
      "source_fingerprint": "b428d47f03ec5187398f83f6585c78b9a84008ecd36582fe7fa65ab0b77e1275",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104317.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:e2f42b4089f824a8ba3997a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鲁道夫象征",
