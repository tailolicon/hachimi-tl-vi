      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:53a2fcf82aa3ac3cb9f1ac52",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌在训练时\n也变得更有干劲了！不过──",
      "source_fingerprint": "8cb10921ea83b4b5d0f62050b2c8303d51a071c7489da4c6b4abcf8c2dc635b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:e5205ff011fec731b2875a4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:1d1dcd267eef2039f6230f34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌的朋友们却因为\n在自己的出道战中败北而感到气馁。\n她们觉得看见优秀赛马娘的光芒令人痛苦。",
      "source_fingerprint": "9cffaa772a42ef0da683218d65e9a0964159be5970d4595aa063a1cee3206e38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:9e29558f64a0081baab977bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:ef1bc313ab4675668857fa00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比起用言语表达，现在更应该继续前进。\n葛城王牌下定了决心，\n一定要获胜，带给朋友们希望。",
      "source_fingerprint": "35ff025401c050fc4a52de24c942b5043b5fd667e7c1769be078b0a4a1a2010c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:2b7f51f424e0d09dbcbc11fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明暗",
      "source_fingerprint": "751d6ddba1e955be5c922d61acdc70a40434432412dfb808b84dbf6f50fd90f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:f9a07e71f80b6fb4d2ce3338",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌到“共同通信杯”观战时，\n亲眼见识到了千明代表的强大。",
      "source_fingerprint": "1262c3dd7f79f1519608374228f1c1618ff396f13c564e121b48a55c6cf3e47b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104403.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:763d6c2977e74543a734b381",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在压倒性的差距面前，葛城王牌开始思考，\n这就是想要超越她的原因。\n这么思考着的葛城王牌她──",
      "source_fingerprint": "e2695d3b1768284e4a8f2d761148f4dc7733aafa26ebb3d02d010d8b3c79d61d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104403.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:13f1750e9581c5e152c2c9bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向千明代表递出战帖。\n“在经典三冠上，和我用三场比赛决胜负吧。”\n此挑衅发言转瞬间便传遍了日本。",
      "source_fingerprint": "f0703334f9db7a082fff7410898a21c0a70c12d585c4ef43114f4d3df1726615",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104403.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:6f3b3250c61842565552832f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "世间一面倒地认为千明代表会获得压倒性胜利。\n但葛城王牌的朋友们却不这么想。\n她们希望她作为“王牌”好好努力。",
      "source_fingerprint": "453a865f95f4c5f236f7c94d7b0b89530242d3cae7616e2a57c5f8533a3845d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104403.json",
