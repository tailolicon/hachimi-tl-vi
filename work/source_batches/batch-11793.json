      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:5ac5772c21a1fc266b0c6fa5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表的出道战。\n面对她压倒性的强大，观众们抱持着期待，\n希望她能成为未来的“三冠赛马娘”。",
      "source_fingerprint": "0610b62f938611af4861acea7b02a7d2a5b8a8bfd64fb094a60a76add137adde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1f54e0e3111c776d5d3becf7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104402.json",
      "json_path": [
