    {
      "uid": "zhcn:64f6df45624a96d1f9a8e779",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表将参加“共同通信杯”。\n葛城王牌得知此事后，\n向训练员提出想要参加比赛。",
      "source_fingerprint": "edaf0dd574b5e419aa284e0a5dd5cc71d51f01a127b4e4dadc5cbc9208e5fa6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104409.json",
      "json_path": [
