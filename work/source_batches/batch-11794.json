      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:bf89840b907ff0ed79a2b20a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了和强大的对手竞争而参赛，\n千明代表的参赛理由让她热血沸腾。\n思考着对方所指的强大对手是不是自己。",
      "source_fingerprint": "45bbea4c82713e69b89f0a6c4cc53d628ba19c38a5293cca3bb02015530f8cc4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104409.json",
      "json_path": [
