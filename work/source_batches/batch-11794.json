      "source_language": "zh-CN",
      "source_text": "就在这时，成长后的葛城王牌\n以充满自信的态度迎向比赛。\n训练员感觉她的背影十分庞大。",
      "source_fingerprint": "10e5d85ccae654ac4a666892b744c7d35de3ac00ca0e658fec6cb1356d6dbd3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
