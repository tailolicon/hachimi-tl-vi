        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:2c1f81bbf6937197cd66b111",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面对强敌们，葛城王牌振奋精神\n迎接挑战。目标是作为“王牌”\n赢下“皋月赏”！",
      "source_fingerprint": "94b6dca8aa14b22754986a073f6eb380c783ef4247b80613ddf4f35b7f3442df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104410.json",
      "json_path": [
