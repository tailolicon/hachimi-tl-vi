      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:1fb7b747a295436b17f0469f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "椎名弗雷瑞斯认为\n自己非得变得更强，\n于是以非比寻常的方式挑战夏季集训。",
      "source_fingerprint": "8c4b85776edf953b23439c89e1e394ee4d9f117399cd92330f5cba0f03021453",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104406.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:4fb8163032ebca98eff66175",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104406.json",
      "json_path": [
