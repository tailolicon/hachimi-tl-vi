      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:15e559f09bf2c15d62301a54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "经典三冠的第二战“日本德比”。\n相信自己至今为止的一切──\n葛城王牌将展现出自己的所有实力！",
      "source_fingerprint": "7b33f76fbcf020033dff3b3e992d17dbcb9396e78390c590467739b5d1421505",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
