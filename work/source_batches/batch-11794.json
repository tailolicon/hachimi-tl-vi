    },
    {
      "uid": "zhcn:aed5d3f914731191d7e3a1d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当训练员一筹莫展的时候，\n某个团体寄来邮件，\n成为打破现状的提示。",
      "source_fingerprint": "68e90c12145495c62d1f1f9665bb60b8a505271124a9bdf52f08634cffa4896e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
