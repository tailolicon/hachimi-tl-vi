        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:ecbb49f593aaca9ae0b98c1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了借机评估两位对手的\n存在是否会成为自己的阻碍，\n鲁道夫象征也来观看两人的战斗。",
      "source_fingerprint": "ea6490a5e341942642a2b4e992fb2e106c8c56ad885eece594daf172f583d912",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104415.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:ac60e829bd3e2b210bae5d3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然而现在的葛城王牌\n所拥有的是持续战斗的意志，\n她将奋战到被世界认可的那一天为止。",
      "source_fingerprint": "971e4f5c32522fcd14463b3e40678ff579df370c283b9a8c22c1dad397844a0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104415.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:e73ef7aeb51ebfc55401f434",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌和千明代表。\n互相认可的两人，绝不退让的\n“天皇赏（秋）”就要开始了……！",
      "source_fingerprint": "e860ea2c53687e5cd4cd6027e4fd0e5c15d110eb7024a08864af4b4052840c4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
