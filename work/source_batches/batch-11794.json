    {
      "uid": "zhcn:7b2e54cbe2d50e9c891f15de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌来参加\n“菊花赏”之前的夏季集训。",
      "source_fingerprint": "1d3f9da20ea9003d4a50ca8c044fa3edc0475c52611715e1f6c375fb2cf924a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
