    },
    {
      "uid": "zhcn:ed04e3c954c6cccef246f097",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员尊重葛城王牌的斗志，\n允许她参加比赛，\n这是与未来注定对决的对手之间的前哨战。",
      "source_fingerprint": "be15cd91bbadaec2d58b04ba1327b163bd3c51b41aa1a9ad9adbe988bfc28a6f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
