      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:07fa39409575d407c2299ad8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那位竞争对手也参加了夏季集训。\n同样立志打倒千明代表，\n来自名门的──椎名弗雷瑞斯。",
      "source_fingerprint": "f5c7e27afd11c538ecb67488f5d4b6b5995d45c9c8102a12191a8563550336a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104406.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:25d4ea700e12e51de2a37649",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104406.json",
      "json_path": [
        "text_block_list",
