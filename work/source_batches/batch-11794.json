      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌的内心感到雀跃不已。\n她成为不被眷顾之人的先锋，\n使出全力奋勇向前。",
      "source_fingerprint": "45d8727a225f3bc7ec818df3cec15088e9ab8c8519440ba434385911974db246",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
