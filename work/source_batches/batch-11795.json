    },
    {
      "uid": "zhcn:750029f5b10c697b13ee8e52",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算对上名门还是要称霸“皋月赏”。\n葛城王牌的干劲又更加见长了！",
      "source_fingerprint": "ca86a3bdcd603bfa3dd03bf09d3dc9b5a612bc711b4ca80edad8cd244b2b8b70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
