    },
    {
      "uid": "zhcn:aa97fe94036c3758d40a2cf8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次恐怕赢不了。\n葛城王牌心中浮现出这样的想法。",
      "source_fingerprint": "ed536fbf5bccb90a0e253b6a292be430b28ae277d2ce62bb2197fd95b264a4ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
