      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8f9bec277f7ed39f425b7f30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对千明代表的评价与日俱增，\n实际上她的实力的确非比寻常。\n面临这种差距甚至有赛马娘因此退出前线。",
      "source_fingerprint": "16d2f45248e1eb4466ecaa553c9e186c4e76e1eeb45e544793229fbe3bf5585c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
