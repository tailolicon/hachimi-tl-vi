      "source_language": "zh-CN",
      "source_text": "菊花赏结束后・抵抗，在最前线",
      "source_fingerprint": "95a507318df558aacca8bc58c849ba3d37c511c00ce1eb20737f1b62d2fbd975",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
