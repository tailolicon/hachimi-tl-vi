      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:486227b5018df95a1f56bee1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌在“大阪杯”中获胜了，\n她跑出的好成绩成为\n改变世人看法的重大契机。",
      "source_fingerprint": "b5e2be5f67171bdfb83e23da43532cab839f631b980c5c29de8a15c9a6c58815",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104430.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:546ba364956145601bde7871",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104430.json",
      "json_path": [
        "text_block_list",
