        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:5f2c90d5798c82b8ef28fa88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌以草根性功成名就的姿态\n让人获得了勇气，\n支持的声音也开始渐渐增加。",
      "source_fingerprint": "ed97a20b34a094d120b0e63346bbe212c3c7dfad51de71537f38a0f125a32e54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104430.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9f757c90f0cda9d1447201fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104430.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:e92145998e14021bfac790c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果在下一场“宝冢纪念”中获胜，\n又能更加稳固对葛城王牌的评价。\n训练员更加绷紧了神经！",
      "source_fingerprint": "9af6853c217b363702bfb7779c588c9e4de43df70af3dcddd918b5a33bf40d25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104430.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:64d763ea88e3371bf390e12c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯结束后・变革的一步",
      "source_fingerprint": "a5186915489625442f0b76315007418c5aed70e9713cfa42351f99d0fa7391ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104430.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:f585f3f8ba7606cdc1401ba9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌称霸了“宝冢纪念”。\n她展现出了足以自称中距离最强选手的表现，\n不过──",
      "source_fingerprint": "e753766b3f9f73a60e492b7a10ce01c82e8af489c1cf734b2149e1e8943e1369",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104431.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0e8eed58459dc75faa6a22bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "世人却关注着其他地方，\n千明代表将参加“天皇赏（秋）”，\n期待鲁道夫象征无败达成三冠。",
      "source_fingerprint": "c526ea095b259fa423ef2977048062a386fc8c11a74357d0cef3c3290dac611c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104431.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:4e0a0a05b9d21334e63730c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不管怎么看都没有自己的名字，\n简直就像被区分到“另一个世界”一样。\n葛城王牌难以掩饰内心的愤怒。",
      "source_fingerprint": "c63e78e0b6812499099f9d5ccc02d87cf9bc5a16781fa16f7863ad064ec53d39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104431.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:d11c1e0ef249f37519352e15",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因如此才需要以获胜来证明这一点。\n葛城王牌和她的竞争对手们\n绝对并非“身处不同世界”的存在。",
      "source_fingerprint": "6c900008c5048017c1aeeecca7aa993bc07c58c23a8d381b31ee6585f4fcecd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104431.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a50464bd3a76b27fd426d3e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先是千明代表的复出战，\n锁定“天皇赏（秋）”为目标吧！",
      "source_fingerprint": "c97da1cf7d4e3a35c4b45a4af56bbe022c6cfafa68fad0249862facf854f071a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104431.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:add0eb0d433a87351b72ae4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "宝冢纪念结束后・在极光的映照下",
      "source_fingerprint": "3150108bc7354fe776e10dbda173ccdd61332d3d72c21739a112a15a89ab0b03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104431.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a1c0a81da9c2018db49c0ddb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌顺利地跑完了“天皇赏（秋）”。\n互相竞争切磋的两个人，\n已经把目标放在下场比赛了。",
      "source_fingerprint": "4299e74ff70410dfc6d53780b3c05b306e948acbe3243d51410dd9b89f4744b0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104432.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:0540b5f4618cdea82a880f5e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次的舞台是“日本杯”，\n三冠赛马娘鲁道夫象征也会加入，\n擦出了激烈火花。",
      "source_fingerprint": "2e0de962cfe85b5d09d81a647ead0d22267e186986ab40fc2d0e2e6166256b7a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104432.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:b00aa0a03ec97a7fe1303aa2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "关系到日本赛马娘是否能初次称霸“日本杯”，\n以即将与两位强大的竞争对手对决，\n让葛城王牌背负了庞大的压力。",
      "source_fingerprint": "8c81948492f1ebb0e9a4a79757b521442a4c4de413f720292f42997b93c564e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104432.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:8a76e84276106bc1f0e1525b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她开始变得焦虑，无法想像自己获胜的样子。\n就在这时，训练员收到了一个消息，\n正是有助于赢得“日本杯”的秘策。",
      "source_fingerprint": "37190c4e016c0bbd9548c75f47b18dc732a91f5314f58b6bdb86f19ac72280e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104432.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:1bc07bae37f18511264172c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・三骏鼎立",
      "source_fingerprint": "fc498f454054ae42a48e30316faa2615243d7876ff59b83688d0907ae4b9ae30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104432.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:021dda9cbe0b998409c00dea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌在三强鼎立的\n“日本杯”中获胜了。\n她成为了三强之一而扬名。",
      "source_fingerprint": "ed30c5dd0ebee3324fd7f49456495241297cf90289dd46ff1e4519bdb3eec773",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104433.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:f0e5435d1573439c0633fb66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "落败的千明代表和鲁道夫象征\n热血沸腾地希望能够早日再战，\n于是三人约定在“有马纪念”上对决。",
      "source_fingerprint": "aadaaccf02f4164fb3cfb75ccba801b4652609136fab902006aa0cfbbb3f8dbf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104433.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:a284d2c94c09996e3380ccf3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌作为日本的“王牌”，\n不管对手是谁她都要胜利。\n她宣布自己将会赢得“有马纪念”！",
      "source_fingerprint": "fd7fbf64f8ebbcca1854b5a16325790c4bf6525d1643b107fa49491e79fe5538",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104433.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:98051d1efca2bf4a641a71ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本C结束后・翱翔天际",
      "source_fingerprint": "61a12ce49e11e1feb30293187f1a7249a86bf0b67040740d86ffc4f2ad149380",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104433.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:6e664bf67ea8fb3e8eb2fed0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌展现了“王牌”的跑法，\n在“有马纪念”上获胜了。\n此外，还达成了最优秀资深赛马娘的成就。",
      "source_fingerprint": "b7432e71df4663f4ad617d2ba011f2e1145a3565aa28b1863b5d30f89fef767c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104434.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:75f9bc6d567cbab6845b024d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不管是赢不过“另一个世界”赛马娘的“常识”，\n还是不被眷顾之人纷纷离去的“现实”，\n葛城王牌都无视这一切只顾继续奔跑。",
      "source_fingerprint": "49665a733b1e573ea1381078ea4a1dac12639ebff46fe53ddacf4d5810801b4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104434.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:49336d9cfe6a6862ae07ec83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的英姿给了人们的希望。\n而且今后也会继续带领众人，\n挥舞着希望的旗帜。",
      "source_fingerprint": "e76e44af9191696bc2bc95ee38415413eed4daac6daf668f87b56adf6de2e529",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104434.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ac054eab9112e4a44e9b4a84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如今已再也无人怀疑她了，\n赛马娘界的“王牌”就此诞生。",
      "source_fingerprint": "521f26b22b253e66cbdf5038c9746e2640ca28bee23adac1b0fc21dc59f0ed1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104434.json",
