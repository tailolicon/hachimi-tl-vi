    {
      "uid": "zhcn:41f87a8b09512e3ece50ac7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔，训练员！\n这个是──",
      "source_fingerprint": "195f3ee226200f98c389421dc291828c6cc845edad4abcf78f7d9479b3b2644e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
