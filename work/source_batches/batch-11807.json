    },
    {
      "uid": "zhcn:5fd4e0f26d65c3f3fb632285",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从来没有和其他车并排行驶的经验……\n一不小心就像在赛道上\n一样热血沸腾了。",
      "source_fingerprint": "1acea62f46a4ffc06ba71d224944f0045e17a576c2a43961a3a0c11d5b8e00e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104520.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:6852e73cb33117fffec6ece9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌",
      "source_fingerprint": "a1e4f90b59d679f54f3a8c84a8c11fe55f91cf86a898da433bbfe74a988804c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104520.json",
      "json_path": [
