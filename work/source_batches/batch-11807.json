      ],
      "json_pointer": "/text_block_list/43/choice_data_list/0"
    },
    {
      "uid": "zhcn:af6b22c039a95cb101f9974b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌",
      "source_fingerprint": "a1e4f90b59d679f54f3a8c84a8c11fe55f91cf86a898da433bbfe74a988804c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
