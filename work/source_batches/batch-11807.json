    {
      "uid": "zhcn:14cee2d616865317330e4b4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个甩尾！拉起刹车的\n时机太完美了，我好感动♪",
      "source_fingerprint": "a71acbe6e52743b4bfc5d2417626c127ad1ebe39841c0c2f7202d9ecd5ade398",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
