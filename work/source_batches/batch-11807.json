      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:e23670fdccea9abd5c4d7a61",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "葛城王牌",
      "source_fingerprint": "a1e4f90b59d679f54f3a8c84a8c11fe55f91cf86a898da433bbfe74a988804c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1104/storytimeline_501104520.json",
      "json_path": [
