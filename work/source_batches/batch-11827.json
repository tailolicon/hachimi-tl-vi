    },
    {
      "uid": "zhcn:27a40f963b1ecd361155fccd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与新宇宙共度的日子终于要开始了。\r\n她实在是个在各方各面都显得异常的赛马娘……",
      "source_fingerprint": "b3c5c276418c4edf832ff14588d3c3bef95201f269dd2a7bd13db18cdd35d83a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
