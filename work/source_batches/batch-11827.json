      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:9e25e1592d36fe5c78778da5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她绝不是在说什么毫无意义的话。新宇宙的智力\r\n水平高到令人震惊，所以只可能是我跟不上她对\r\n“语言”的理解罢了。",
      "source_fingerprint": "ab7ef091d83f1d5b74659c3d537329a14b155304ff57428ff0cf7731d924037c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105100.json",
      "json_path": [
