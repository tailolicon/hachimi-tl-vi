    {
      "uid": "zhcn:4637486f509e4babb5f45e11",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明明是『新快』的时候，\r\n却为你徒增疲劳。",
      "source_fingerprint": "06992f4cc79489801d0c963855dc66edc435a4f41549fffef0c2befe1557f555",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
