    {
      "uid": "zhcn:e256632f453459fee0306e94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。\r\n“SETO”。\n那是——群星的中转点。",
      "source_fingerprint": "aedfbcfd7f4f8436e8304fc7e1a104b97d1188454aca297f0c3a8385b429bd50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
