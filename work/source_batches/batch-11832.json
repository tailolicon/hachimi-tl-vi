    {
      "uid": "zhcn:436f78427f2c1f76433e3ebc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我说我说！\r\n如果是你们几位的话，会怎样跨越这巨浪呢？",
      "source_fingerprint": "580d633f5f0bed8dd3ebef93095afce1ec0287d366fa200076cc370ee83fbaaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
