    {
      "uid": "zhcn:4eb4d3dfa73287a2a7d6c545",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——夏季集训。\r\n终于……我们再度来到了海边。",
      "source_fingerprint": "d4ff846f9ae785d56d23335a8fbe34ea3b8008f2f7bc7c2abea498f07e4fc110",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105105.json",
