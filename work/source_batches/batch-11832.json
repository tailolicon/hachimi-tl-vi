      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:d052d486dd685545892c8d96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有个四人组造访了此处。\r\n她们全都是新宇宙上一个世代的赛马娘。",
      "source_fingerprint": "47b776139af864a5a15d3925ba0d1e38b90687b89ec64df42e8e11120cf1c33c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
