        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:09fe42affae25e36e711dd1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在还不能下定论。",
      "source_fingerprint": "767a1e657a1e1987349f4b1e73ae35fc08825fe0bb8b1adf70da741dd698e4dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
