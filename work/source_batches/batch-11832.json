      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那“ABSS”之影……",
      "source_fingerprint": "986d6acdbae8d7c9b02adca773d57075bf2eafd73dadbc73b6229eafdd3b7d02",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105105.json",
