    {
      "uid": "zhcn:4fcab75d70eb8b09c0f4ef90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇～大家快看快看！\r\n好高的浪呀♪",
      "source_fingerprint": "69ccd49774789399a691e460aed9ae75f05f64dcf5065739a5cbb66cda396a06",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
