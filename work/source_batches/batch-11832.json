      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我会跟上来的。",
      "source_fingerprint": "c56b5cfc664b25aaa7193f0ff0e1e5eb94e4206de8cb81eb1a5243fe04bb382b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105104.json",
