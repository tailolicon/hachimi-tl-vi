      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们可是樱花幼儿园三人众！\r\n况且胜利俱乐部旁边就有两个保龄球馆呢！",
      "source_fingerprint": "c7c7e743731f6ca2dad477777d85cc0f2935f41700c231d5fcb89bfbaf57d9ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
