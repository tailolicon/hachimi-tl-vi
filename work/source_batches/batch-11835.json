    {
      "uid": "zhcn:cf4500ad32a52ca2c56461c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我明白了，\r\n为什么她会看不见其他宇宙的新宇宙。",
      "source_fingerprint": "57caba3e1df68e6021bc55c16d0ccb9b42a48f684cc74a22f796a726848f2597",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
