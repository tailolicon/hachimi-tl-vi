    },
    {
      "uid": "zhcn:082b54cac86ab4edc44aedc9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，但是……",
      "source_fingerprint": "89eb25ace93cbe8827c9c006df27d7e178886994ce3c8cb23c7adee93c40d40f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
