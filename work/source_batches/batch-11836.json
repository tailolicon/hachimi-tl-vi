    {
      "uid": "zhcn:9887110918ffbe8f1f8b62db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要想要观测『我（わたし）』的话——\r\n就可以看见。",
      "source_fingerprint": "df5209f6861cdd461503db6ab8fcddb9e233c3be74c75ce36e7fc5db639e8fff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
