    {
      "uid": "zhcn:d3e6e047c2b75d92e3397675",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是，为了“结果”而开始『耕田』。\r\n你明白……两人之间牵起手的原因吗？",
      "source_fingerprint": "014c70b6e0a8f790fc762f4516b940465066d161800debe8eb330445661dc3e0",
