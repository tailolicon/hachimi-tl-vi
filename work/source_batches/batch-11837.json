    {
      "uid": "zhcn:12aefb63797996ac9d4c8416",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "境界线本就不存在。\r\n只是有人将之当作“线”，\r\n有人将之当作“面”罢了。",
      "source_fingerprint": "cf271a1bf3907b8ab7a4a825de35c2da589f2bb518c6f130e4d82fa9fe809b24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105109.json",
      "json_path": [
