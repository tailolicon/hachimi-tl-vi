    {
      "uid": "zhcn:84b551678aac62b424698e40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而现在，新宇宙与训练员……",
      "source_fingerprint": "fbedcd1ab611d04d11a5d7f06aafdc70a1eb5231f593c4b634d40f2b07d333a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
