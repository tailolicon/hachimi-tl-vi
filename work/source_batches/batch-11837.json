      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正站在这时间轴的末端。\r\n也就是，“种子”的——最前方。",
      "source_fingerprint": "91226445f2654d8eb39792e74bdad58b79cf28cb335e49d5ba17f3a31dda1ccd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
