    },
    {
      "uid": "zhcn:58331d70412804a8e5b72d68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好吧。看来她也明白圣诞节这个概念。",
      "source_fingerprint": "b870df574dcc21f3a9ee697d89f88a4686f8f75ebe1206041426dfae937cfadf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
