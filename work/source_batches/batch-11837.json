      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙与你曾共同仰望天空……\r\n一同踏上旅途。",
      "source_fingerprint": "9e2baa35ce0db3c0f4684088d610e710b41603ac12aedcd74f9f19d56af18250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
