    },
    {
      "uid": "zhcn:a0c389e8eb8ce849bd65aebc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样吗……",
      "source_fingerprint": "d18de83bd94c693ef72d92bad171077c6cd3baa59223e179880aef2fc6c7372b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
