    {
      "uid": "zhcn:e385a9f0cb3977d1e566fd73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "简直是……单相思的“亚当与夏娃”呢。",
      "source_fingerprint": "855b7b8a15f231176696a2a0c99ac1b736767f9556664774e6c717c0f7c09c90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
