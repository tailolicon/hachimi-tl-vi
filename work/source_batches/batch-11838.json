      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:c016be1a1dce708e96a6083a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们到达的，是札幌的竞马场。\r\n迄今为止，都与我们没什么太深的“缘”\r\n的竞马场。",
      "source_fingerprint": "48da81453df787a3f47bc2a1d0b1d88c38fbf2cd1a22cd19881116c9cd2fc0de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105110.json",
