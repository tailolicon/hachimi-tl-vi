    {
      "uid": "zhcn:647ded77ff382aa73d35f8b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的额头上，传来冰冷的触感。\r\n这是——",
      "source_fingerprint": "477b8e414ed8a8a0f36db15d1df0ce8cc4828b56bca15af5d6d090b99d808155",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
