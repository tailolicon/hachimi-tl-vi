    },
    {
      "uid": "zhcn:82b6cb3ad3dd5c9d6aee56c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，这些故事——",
      "source_fingerprint": "ca7a915274ef32b26537c380c9906a9a864718eddc3c7d81dfbf71c5ab48240e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105110.json",
      "json_path": [
