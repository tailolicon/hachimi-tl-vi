      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:59ea444657505a7eddc8538e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——发生在其他宇宙的故事，并非只有悲剧。\r\n其中一些随时间沉淀，最终也变作了美妙的回忆。",
      "source_fingerprint": "46eaef4670ce891c653b102092ba36e418425674dbd61003c58d8225bd17ccc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105110.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:59d43800ec2a99b9471d1e1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好好地记在心里吧。",
      "source_fingerprint": "13c5288108a3da4a871db9a477bfc4ca5d289ae086634e62dfe41b2e24a615f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
