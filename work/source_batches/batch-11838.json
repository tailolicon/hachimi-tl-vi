    },
    {
      "uid": "zhcn:57f969abf543f529594d7238",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想要“反刍”心中的……『幸福』。\r\n从车轮被发明出来的那一日开始……",
      "source_fingerprint": "6b0b7fbedeed16e7cf1428769a449339252d3f34ef7bcd6a30d214061b394284",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105109.json",
      "json_path": [
        "text_block_list",
