    {
      "uid": "zhcn:b588b376014b7834fa84059f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员。新宇宙……\r\n想要“讴歌”。",
      "source_fingerprint": "19dc2cf72dd350465ae7c2b5fbd6f0f64e63682d591f641c01490952b19d6ddb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
