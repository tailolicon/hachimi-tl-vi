    {
      "uid": "zhcn:d1d68470415cb53ccbd0df04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旅行是——“不可逆”的。\r\n一旦出发，便不可能再回头。",
      "source_fingerprint": "cc025089a46e2a873715079307ccd30f69aa38f6a7f20c233af807a9d6f1f262",
