    {
      "uid": "zhcn:93ab950952bfb7050791d238",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——直至通往群星之道也被筑起。\r\n能够走到今天这一步……“SISR”……",
      "source_fingerprint": "42c11c00acc2dee27675c68cca1eca116fdae2fd173bb3de414b76c23898c6b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105109.json",
      "json_path": [
        "text_block_list",
