    },
    {
      "uid": "zhcn:5eafced0e6613872a71d3045",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105109.json",
