      "uid": "zhcn:b702166a960829061c655834",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。因为，这是属于他们的故事。",
      "source_fingerprint": "7ad2bde594fcaede89f1692d013bcfa90388c5e667333831d41b2260f193fab6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
