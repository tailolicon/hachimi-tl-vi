      "source_language": "zh-CN",
      "source_text": "即便无法一起奔跑……她也与我们同在。\r\n她——正奔跑着。",
      "source_fingerprint": "fcc7909bc6c88badc9f394b48af70ebe83daf226feb0fa95543014b3f33cf3c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
