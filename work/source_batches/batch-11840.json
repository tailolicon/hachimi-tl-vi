      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这就是，你我能够彼此相伴的——\r\n“新宇宙”。",
      "source_fingerprint": "05b19692cb95d0d30bfef599fd26ea11d6f71942038573bf890b9a3a8746e266",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
