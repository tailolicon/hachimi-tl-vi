    {
      "uid": "zhcn:56b17f65da24918d33326661",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "本能与憎恶，都无法跨越次元。\r\n能够永恒存在的——",
      "source_fingerprint": "6fa257d5e800437fa3b83d7159a2741f99c2576f121e2e0b50fbaba93569f8ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105111.json",
      "json_path": [
        "text_block_list",
        72,
        "text"
      ],
      "json_pointer": "/text_block_list/72/text"
    },
    {
      "uid": "zhcn:e3bd4459dba72f71affa88f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
