      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "于是——这个宇宙与我们，为这愿望而诞生。",
      "source_fingerprint": "e6f1a95c35d6ce578a84c4a19278fce2ff1b8a414d4d9cf9223a056a447a6654",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
