        7,
        "name"
      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:179de872a57e4887c5008ece",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不用担心。\r\n……荒漠英雄，东商变革。",
      "source_fingerprint": "609d828db1bd594610da667c97ae271d6508cb5e1c6002efab6df3bb4709b0c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105111.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:66d546abface4e081c33ed6a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无数个新宇宙，变为我眼前的她。\r\n而无数个我，也变作了她眼前的训练员。\r\n这时，我终于真切地感受到了——",
      "source_fingerprint": "783f4f3728e67a3d3e358a3aeebf0a8578a6fc3a7ec632af6ee8cfcbe447071e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105111.json",
      "json_path": [
        "text_block_list",
        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:b97c1651f2cc8a383caf5202",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的确……“爱着新宇宙”。",
      "source_fingerprint": "b91bfda4103c3f323f3bc4564fe9416cf07d43abbc0a9406eefc027a6fa730fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105111.json",
      "json_path": [
        "text_block_list",
        71,
        "text"
      ],
      "json_pointer": "/text_block_list/71/text"
    },
    {
      "uid": "zhcn:041811dcc3146bfe7107e8b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105111.json",
