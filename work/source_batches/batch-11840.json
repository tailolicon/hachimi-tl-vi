    {
      "uid": "zhcn:212a6a1109d9a59fc723437f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真是遗憾呢，尤妮同学。\r\n本来还以为能和去年的德比赛马娘一起好好跑\r\n一场的……",
      "source_fingerprint": "e014d3bb91c9654449674f0407dd715fcb6faf025e92633cdf0b3f38eda94054",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
