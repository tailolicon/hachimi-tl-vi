      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好，那就换为热敷吧。",
      "source_fingerprint": "3f29f4c52c5f9ad226df0168ccadb625db4d72f8d18d3fa972655743a56c959d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
