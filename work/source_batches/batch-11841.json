      "source_text": "——这里哦。",
      "source_fingerprint": "19adef9f4b9ca837a1e812a53e5059d6c28a435619f09073f4ba4b4f187d8645",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
