      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "总算变回了往日的模样，\r\n新宇宙微笑着说道。",
      "source_fingerprint": "2be887623dd538d7a766803933ebe585a478773d18dc8e3a060777a31a9c83f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
