      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也开始能够理解她在训练时发出的某\r\n些信号的意思了——",
      "source_fingerprint": "335619bc9db2a2abfcb6b78915a0480e82fb4f13a3ef9313050a66c919beb285",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
