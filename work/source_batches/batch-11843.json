    },
    {
      "uid": "zhcn:1f829caff5917836cb2856ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，我还是会好好回应大家的期待的。\r\n嘿嘿……",
      "source_fingerprint": "68750857a5f65418406cab419ad5a0b91178a17352da7d03e6c3142c04d9552b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105114.json",
      "json_path": [
