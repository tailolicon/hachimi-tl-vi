    {
      "uid": "zhcn:d6c2f33f4c354aa842f94606",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，尤妮同学！训练员！\r\n你们二位也来观战了呢。",
      "source_fingerprint": "4d41d556909f27cb51cdad75c3cfba2c9e9f09000fadc333475226b13e9da210",
