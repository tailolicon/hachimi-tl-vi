        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:480a4830b1dfcb2cb8622153",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄紧盯着亮相圈，\r\n眼神火热。",
      "source_fingerprint": "003750be14e213bb52987f43287458ceb0ea6768df6884e99fcea68272c7a0f0",
