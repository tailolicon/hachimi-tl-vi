    {
      "uid": "zhcn:186df36d3e31785660a4a7af",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请看看赛场吧！\r\n曾在无数战场上浴血奋战的英雄们，\r\n正英姿勃发地站立于此！",
      "source_fingerprint": "16cae0f962790ab925f1ed87094e8651ffbab9928fc20844c97d394b39c7e710",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105114.json",
      "json_path": [
