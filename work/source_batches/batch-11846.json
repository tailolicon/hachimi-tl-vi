    {
      "uid": "zhcn:076ff8c68fc606d20c3e70eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就像是眼镜起雾的时候，\r\n眼前的一样都会雾蒙蒙的一样。",
      "source_fingerprint": "5e8c4920394b9ebd9e21b6a2fd72b6702e35aa53319e1a2446ebd1c083ba116e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
