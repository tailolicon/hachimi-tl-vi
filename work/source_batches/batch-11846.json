    },
    {
      "uid": "zhcn:3268a794e42b9c7f528f0e60",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，加油吧！",
      "source_fingerprint": "3bb8a3e9fabae1217b8a205630bb9d65933967c47f8c3e0326b2946578bed68d",
