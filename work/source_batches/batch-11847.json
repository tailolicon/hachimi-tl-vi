        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:b6588fa3f128f6f4694a591c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这次——不一样了。",
      "source_fingerprint": "6a406ec54e0af2586ca650a14b547abdab8d1f227c5256a3a13e8111fe20053d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105117.json",
      "json_path": [
