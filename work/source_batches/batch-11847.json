    {
      "uid": "zhcn:5ef52a5b590231293727de20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没能告诉你……伤情……\r\n之后就一直身处……“ABSS”中……！",
      "source_fingerprint": "80df7a680a8990536ca7df42a8a82ac3195bdeaf5d94e75d3128789c0723d7db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
