    {
      "uid": "zhcn:0bffbadd2269509701cb7405",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家，都变得『有趣』起来了。",
      "source_fingerprint": "fedab1bb48e23c69c385c26f597618473d8bac10a4c17e4e18d130d45c3cac4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105117.json",
