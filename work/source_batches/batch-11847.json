    },
    {
      "uid": "zhcn:1b9f76b649c73facb88fbf44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙，我们多交流一下吧。",
      "source_fingerprint": "35006fc3b7b6874ed825acda1e49aa9fc31ffeb2a88bc9591cc96314270cf727",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
