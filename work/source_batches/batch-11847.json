      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:a9afdff2c4a21d4832851419",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尽可能地多交流。你现在累吗？",
