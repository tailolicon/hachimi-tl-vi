    },
    {
      "uid": "zhcn:adc891172c6ada191333bc3c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——对话的“断绝”。\r\n眼下这种状况，\r\n不正和其他宇宙中发生的悲剧一样吗？",
      "source_fingerprint": "da8e9dc7ab12e9519d03410e883cccb566fdb6d63fdf3ca69d0a25559f46b1a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
