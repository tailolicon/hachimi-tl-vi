    },
    {
      "uid": "zhcn:e9075585fe0116d568c14146",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没有注意到。\r\n没能告诉我。\r\n也就是说——无法传达。",
      "source_fingerprint": "f43fea4b04f8a37ef69cb862fca022cd36672b1650b12ee9fea8bd52a301cef9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
