    },
    {
      "uid": "zhcn:4f845601a3c16603b6c5a227",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季仍然遥遥无期。\r\n我们所期盼的，盛夏……",
      "source_fingerprint": "8c5b0b03633204e37b7636cf0961c669a737363b61995b5a8f13c91685897551",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105117.json",
      "json_path": [
