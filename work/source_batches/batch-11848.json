      "source_language": "zh-CN",
      "source_text": "……嗯。",
      "source_fingerprint": "87edde57f118d82ef628f3bc65638bde6f3e73d1f4bcaf4429300789f7c70006",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
