    },
    {
      "uid": "zhcn:948819260f2db2f552415443",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样的日子一直持续着。\r\n不断地调整着训练计划，神经时刻紧绷。",
      "source_fingerprint": "52731d1962f14f5eac5214431d4873c636168ad4e97cce5ce32aa0f74f62b9a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
