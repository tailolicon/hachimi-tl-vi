        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:cc72e0777c269f2474713e5b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我竟有种错觉，我与新宇宙一同化作了“光”。\r\n但就算如此——",
      "source_fingerprint": "49ef984d6f2a4d638f3e11b4b736c630f1a322317ecbe262a60bdc2f6c9ab54b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105117.json",
      "json_path": [
        "text_block_list",
        69,
        "text"
      ],
      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:456b17bf3aaa92ec990dcedc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
