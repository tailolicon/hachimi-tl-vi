      "source_language": "zh-CN",
      "source_text": "这片宙域，简直就是……",
      "source_fingerprint": "d0e9fc69cfd1ebbeff3b58d4fdbfad71ab0008142621a2bfbe9ac9076e6e042b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
