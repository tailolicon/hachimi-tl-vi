    {
      "uid": "zhcn:a449c90d45d50ab26dea2f68",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——“ZDAL”。\r\n“帚星之尾”。\r\n所以……",
      "source_fingerprint": "cb5c078adcfd5c6b374ffafd7a01c8607b963dbb44a181190d265c0ebde8cc34",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
