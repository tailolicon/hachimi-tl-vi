      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某位训练员",
      "source_fingerprint": "f8f9894d3efc7f95a83db8bb53fd4c67f978cb9b48fd76f49113fff795d1b218",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
