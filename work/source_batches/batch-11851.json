    {
      "uid": "zhcn:e31185eca3a5aa4602f3cb2b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "潜藏着“秘密”呢。\r\n想要……尽早与你『连接』……",
      "source_fingerprint": "21fd0e4a9594284e7c90cb6bf835cecfb45f82685bebd1997fc93522584fc52d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
