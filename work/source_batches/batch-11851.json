        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:600352966bc9a0b609f9ce0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们急急忙忙地做完出赛准备，\r\n接着便来到亮相圈。\r\n而毫无疑问——",
      "source_fingerprint": "2de3597b259393af27073f463cce95eef20770fabcf940e44b9e04b458cd30b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105202.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:442e93f5a11bb195f40dcbff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正有人等待着新宇宙到来。\r\n终于，她也踏上了这个舞台——",
      "source_fingerprint": "9e9dd9e8cf7e50e97fbc5f0b9f6fbe4cc0b72736587c36f1ba0e8076f6874856",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105202.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:d8316f27b11b770d68f4e6d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
