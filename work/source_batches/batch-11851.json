      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……\r\n你赶上了呢。",
      "source_fingerprint": "0e398437ef29bd06d5106771ed235d4f2bf400c9f560d742eb5a9129dbaf452c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
