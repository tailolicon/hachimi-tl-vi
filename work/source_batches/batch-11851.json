      "source_language": "zh-CN",
      "source_text": "是吗……太好了……\r\n果然，荒漠英雄——",
      "source_fingerprint": "cf059bd6ce1dc47de2c0966495a962fc6a9db2646ba3bfd476f50148f3ac6ef5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
