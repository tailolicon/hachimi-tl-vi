    {
      "uid": "zhcn:fc2643ddc51c6d5222749b05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱丽数码",
      "source_fingerprint": "688eafe80b6050de44156f2ae0deceecad377af0dea52898620dd3d997484876",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
