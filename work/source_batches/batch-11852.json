    },
    {
      "uid": "zhcn:c8c5567fdd831be53054c403",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "噗哈～☆顶尖马娘酱的乐园！！\r\n这里简直就是，天堂中的天堂！",
      "source_fingerprint": "b6edd7762c0fd651126f8cc4cd46d3aa3f921db08b264f73e073bd2a0ac5e4e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
