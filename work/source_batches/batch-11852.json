    {
      "uid": "zhcn:6c3c4649e9a3e421c0aae4ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶？诶？怎、怎么了？我我我我可不是什么可疑\r\n人士哦？别看我这样，我也是参赛选手呀。",
      "source_fingerprint": "b3c8a58ec8727383e81c0b240227d86f4ce7370bc6afdc3dde2791726cf62fc1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105203.json",
