      "uid": "zhcn:828fc65bdba92bdb90534d7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菊花賞にむけて",
      "source_fingerprint": "13633969b6aa2110a104bdebee02869ab98c5b4da2a4ee408369ffaeb75a46ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
