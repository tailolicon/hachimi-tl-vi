        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:ac8b3c408ca24f6d053de153",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过昨天却阴雨连连，\r\n赛道已变成了“重马场”。",
      "source_fingerprint": "944b470667bce52604d3ca50a26af355dba7f250106d3842cc9eb781be741380",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105205.json",
      "json_path": [
