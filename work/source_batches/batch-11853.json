    {
      "uid": "zhcn:82439c1bc3300ac118a8fee3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员——将会被因果所阻碍。\r\n比『日本德比』那次更为严重，\r\n整片海洋将挡在你面前。",
      "source_fingerprint": "dc66daebc70dab145df3f2e0077337ba2cb5f6f8feb90e3fcdc1b868bc8af158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
