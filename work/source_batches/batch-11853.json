    },
    {
      "uid": "zhcn:8eb0e5d0264c33b7196d8da8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因果……\r\n新宇宙所说的因果，难道就是这个？",
      "source_fingerprint": "87701590bbd993e3940e1c8186a8395ecef409fc2566dbfe791ce72674c9f5d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
