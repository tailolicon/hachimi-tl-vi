    {
      "uid": "zhcn:a54504b8163f188630c8513c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知航路是否会重合。\r\n所以——",
      "source_fingerprint": "f27f1b63ef9648f5788235793cd15cae50155a2ae1949db7d41e6e6bfcc12880",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
