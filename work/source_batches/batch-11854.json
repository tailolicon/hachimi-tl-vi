      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:d4476e3bba3de59f586b7eee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且并非是一直看不见她自己，\r\n而是在『天皇赏（春）』之后突然看不见的。",
      "source_fingerprint": "3578543681978621395b322899deab42160a52af313236c70fccec03335caa8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105206.json",
      "json_path": [
