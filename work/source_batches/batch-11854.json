      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:85b1245529564dc496d479de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这应该是她观测其他宇宙的唯一窗口。\r\n而就是这窗口因某种原因影响了观测，\r\n这才导致情报无法正确送达。",
      "source_fingerprint": "9b67d9410770cbf19a666dde4ac7fa877a1623a554c07cc064f3230d9036aee0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105206.json",
      "json_path": [
        "text_block_list",
        29,
