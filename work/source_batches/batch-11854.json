      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯にむけて",
      "source_fingerprint": "d0afcbf1f55b3754c0c06a45f26641e6028864abb3cfafa5f275d70608709085",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
