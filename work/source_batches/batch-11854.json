    {
      "uid": "zhcn:153e99b780dbcbc071e64b4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“GATE”『天皇赏（春）』。\r\n这边是我们一直以来的目标——最大的关卡。",
      "source_fingerprint": "eea0bf0dfaf982fb54e5b9fee3fc5a5766ea577c5226750d1c5d1428fc59c776",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
