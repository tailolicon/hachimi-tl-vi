    {
      "uid": "zhcn:8c445330e37d57e2a8faf229",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙的眼睛。\r\n那双——苍蓝色的双瞳。",
      "source_fingerprint": "4ec29eea7ad5ab68358e4437513a563811c20cdff4445e7e95ed3d1226eda1b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
