      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么想都想不明白……",
      "source_fingerprint": "c73ea5e9aa8597d063a1e30812f6471a7bfd761b072f040912a3525c43807e47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
