      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也没看见自己修养或是退役的模样吧？",
      "source_fingerprint": "d52c3cf2dbecb91615dff89deaa60f2a62c8151b7e8b195bd4f80f09e200d425",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
