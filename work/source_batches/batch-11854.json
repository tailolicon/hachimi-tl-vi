      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:42c4fc56889a8b9074868573",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过既然这么说的话，我也理清了一点情报。",
      "source_fingerprint": "9206fc465ff2fa1ffcfbf06fe18ad0b69f3dd7e7e176f27874fbaaffd84dc17b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
