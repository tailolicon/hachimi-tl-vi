      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:d6abd77afad7da0f3ecb7df9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我看着她充满希望的表情……\r\n脑中却无法控制地回忆起那个问题。",
      "source_fingerprint": "31b684e19e48fc06bfc404431b603b2c3220ca46e44c891a3762dfefd3b0ea07",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
