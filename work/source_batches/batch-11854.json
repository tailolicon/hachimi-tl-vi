      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙，你看不见那个消失的瞬间吗？",
      "source_fingerprint": "75ec3781858e749508b489b936747c8fd25d01b38489cf1a7a434283e8ba4d0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
