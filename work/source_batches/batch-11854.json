    },
    {
      "uid": "zhcn:9349a2944af6072db6d44be0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——至少，“她在比赛中没有遭遇危险”。",
      "source_fingerprint": "fe9eca32ef3db09b5bb25d555e48099e386e4ab4c798a41d40a6895f04f22dd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105206.json",
      "json_path": [
