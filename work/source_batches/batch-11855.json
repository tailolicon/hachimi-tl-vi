    },
    {
      "uid": "zhcn:280091be70fe493595643996",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员。新宇宙已经“确定”了哦。",
      "source_fingerprint": "a69644c9b282c2eb48a6b06dee4da98331ff332154a0e4d2727e942defe50707",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105207.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:0fb486424c4f2216eabf70a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……在这之后，对吧。",
      "source_fingerprint": "1f15f2b6fb811001afd3ecfb5baed2e02330bb65880d21031477cf9b07a64109",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105207.json",
      "json_path": [
        "text_block_list",
