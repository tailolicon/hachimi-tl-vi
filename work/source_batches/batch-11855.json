      ],
      "json_pointer": "/text_block_list/3/choice_data_list/0"
    },
    {
      "uid": "zhcn:ccdb72151ad0a1341089abf0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……在这之后，对吧。",
      "source_fingerprint": "1f15f2b6fb811001afd3ecfb5baed2e02330bb65880d21031477cf9b07a64109",
