    {
      "uid": "zhcn:d0a2acde74dbabae7d5f6dfe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“大王”与“特异点”即将到来。\r\n所以……",
      "source_fingerprint": "b79781d83a74c936294069038a23cfb55080b9b0804974994f30dbb591a53e61",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
