    },
    {
      "uid": "zhcn:9d53b217aeef386c8738f162",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105208.json",
      "json_path": [
        "text_block_list",
        12,
        "name"
      ],
      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:c6dd90c7e9ce6871d3e6c8d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尤妮同学，终于到今天了呢。\r\n秋三冠的初战。",
      "source_fingerprint": "41500b2c679810272319e8053fdbd111309ad9a287d12ab8a968c5264cbb047b",
