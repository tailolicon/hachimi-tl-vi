    },
    {
      "uid": "zhcn:5f7b8a311e19fdfdced6ad97",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙——\r\n照常继续进行“连接”。",
      "source_fingerprint": "06f549e96a20e50bc6cebd8a4c5faace853777db12a9f7ed8f71e649c58faadc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
