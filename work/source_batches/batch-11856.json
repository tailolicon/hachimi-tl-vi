    {
      "uid": "zhcn:8f143d3ae2f130a2a088303d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……“Mutev”。\r\n（纯生造词，大概是“交给我吧”的意思）",
      "source_fingerprint": "a6883f5059a566fb7189a33a7545575835040f4ee9b26814bc61db6403a60f75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105209.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:14a1912cd5ed5308e534d384",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙微笑起来，小声地宣告道。",
      "source_fingerprint": "7b1e1b52f5a73f6988f27de2c6a5b3ea36b8ba8cf2ca406007d19f653d182a63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105209.json",
