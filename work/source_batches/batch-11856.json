    },
    {
      "uid": "zhcn:2c9eb9e82bdcd24df687b5b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员。新宇宙要“告白”了哦。",
      "source_fingerprint": "f788444a523ac6116b51c618954af18a0a632b7b53b80981c71cacaf9d2d2753",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105209.json",
      "json_path": [
