    },
    {
      "uid": "zhcn:1e80ba3e129b094a13ea34a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“形状”——还不能确定。",
      "source_fingerprint": "1a079a9f85a8be3f9faf73009538c6b290fbc79238a1583e30eec03a8b2ecd7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
