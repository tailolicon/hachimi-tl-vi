      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105210.json",
