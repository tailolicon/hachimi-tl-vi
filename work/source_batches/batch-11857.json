      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:e5fc04e139cccaf7f661a505",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "弥漫于此的，仅有幸福与快乐的气息。\r\n而且——",
      "source_fingerprint": "dc9664979fd47b517ef4b270122fc2714a5bbc46349d87c331b47182c055db69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105210.json",
