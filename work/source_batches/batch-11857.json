    },
    {
      "uid": "zhcn:9739d5376c939402acc03621",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们在集训宿舍旁的铁板烧店里，\r\n开了一场小小的壮行会。\r\n参加者有……",
      "source_fingerprint": "f471d5c3cccf4bedfe8388cb3874b1b8659bf3ccf316cedbb598c6ceda0bb924",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
