      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——Affirmative。\r\n新宇宙，要为今年『锦上添花』。",
      "source_fingerprint": "54b208e7ac19bdb89da002a984b06d37bf83fd3250bc0ff54d1d919f15e9ae95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
