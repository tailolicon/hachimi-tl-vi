    },
    {
      "uid": "zhcn:cffb79cf20c63db9c950a360",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔，这样吗……\r\n……真难理解啊。",
      "source_fingerprint": "a5d19b9eff5003b0d36117325d150857269a6648630106f312f27f42dbf90e9a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
