    {
      "uid": "zhcn:9420d5489856340bafd580f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "尤妮同学……\r\n虽然我还是不大能理解你话语之后的含义，\r\n但是……",
      "source_fingerprint": "9fbc992d957cbf78bdba60c694e9ef829414d249c250ea189eaa3274db84f962",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105301.json",
      "json_path": [
