    },
    {
      "uid": "zhcn:9c146ade42596a44be0bf5c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄",
      "source_fingerprint": "aaf6b29d17c0d17b31649773a41c9995f963b5bb8c45fb8d89c79c740e5bc158",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
