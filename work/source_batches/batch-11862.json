      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:b6d6bbc54dc714a7c8e3d25e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "气槽",
      "source_fingerprint": "11b0d85f586c72905b86f884e647da7cea18f09793eb88ad129938776b139644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105303.json",
