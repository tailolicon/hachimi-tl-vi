    {
      "uid": "zhcn:df4e2a59c03c568ee888dbfe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“按照记录”，这是……\r\n——“ZDAL”的来访。",
      "source_fingerprint": "8a8844643d262bac8855f83df3508697ff615b7dc6e4b650f9f7e1d1a8ac127f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
