    {
      "uid": "zhcn:506865e9d4369c27276bd31a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………？",
      "source_fingerprint": "95de4f7f02b4746535ddff1c6de269be277bef18e7bd6f807d3b5836d78dc5cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
