      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:9cf94dcccf9b6156b296482a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若是与她遭遇的话……\r\n想到这儿，我的心突然微微颤动了一下。",
      "source_fingerprint": "de14583cd8ea75f828d6a063429f846cc1321a3730c629f51fe408f473925c7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105303.json",
      "json_path": [
