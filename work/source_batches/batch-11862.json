    },
    {
      "uid": "zhcn:4aa75f1a245d2917686fd683",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——是夜。",
      "source_fingerprint": "2da32f56c8dbb80d5e1093fe5a8568395dff2db539cbe1dbb60b4bf89f9d9e22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105303.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
