      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:faf83e1b00842265417eca9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对不起，新宇宙……",
      "source_fingerprint": "93bcfa37eefcd720da3114efdfd5598bad00b4ad202b603099c7464c6b108c9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
