      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "再会了，新宇宙与这位训练员。\r\n共勉。",
      "source_fingerprint": "460317ded6302ac987adb73672b8ba3d5d7e65627dae453a0324e15c8143678d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
