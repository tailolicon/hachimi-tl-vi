    },
    {
      "uid": "zhcn:3161df4a5adc9b1d570b30cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……",
      "source_fingerprint": "f297853ef1b1b7db68c78ec4d2b8a22265e660e6d8cfc87bc1e707b608964801",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105303.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:03323d615bba32bec0269d40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们的相性应该不错。\r\n但绝不能因此而懈怠——\r\n我必须要彻底地与她互相理解才行。",
      "source_fingerprint": "a7cfd204a2954ff3a3d30ca36311ad120f5e939b27ff38395c4cf13ad128dc33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105303.json",
