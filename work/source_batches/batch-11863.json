    {
      "uid": "zhcn:3e5a1fba83779a97a7075cbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无数行星想要通过的“轨道”……\r\n这条路线——",
      "source_fingerprint": "d9cac6f29fa34e6ca4f3518c03b63e90316cddaae475d779dee63c61f69fe779",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
