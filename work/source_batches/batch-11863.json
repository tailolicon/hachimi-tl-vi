    },
    {
      "uid": "zhcn:aedfeee63da3f32f86471ae5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得『皋月赏』不错哦。",
      "source_fingerprint": "c39be11ccf8d4c47029771bcc41b7141263505259089f6a1a4610d573af3a255",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
