      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:248c1486aa89d5fe10ecf3ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然新宇宙看上去还有些犹豫……\r\n但似乎也算是接受了我的提议。",
      "source_fingerprint": "b21e2f9b3c0daff256ed888b2eea80f7b86e21043df99e0695f6d587313eb217",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
