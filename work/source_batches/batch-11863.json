    },
    {
      "uid": "zhcn:ce32117dfbd9611dd2944ead",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——但是，暂且把这些事放在一边。",
      "source_fingerprint": "ac3c1554b3513a896cc3d2e5fb3592cfb7f6aa4ca1452dcd93b2a274ff5049c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
