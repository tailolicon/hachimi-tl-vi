      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:ed0f1e03fd9a1cffea88f8ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙，那个……",
      "source_fingerprint": "16ac60096fdcdcd542b4543315c66a0aae74f2a00b2bf754d3bb85b25d3f257d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105304.json",
