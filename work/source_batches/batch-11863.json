      "source_language": "zh-CN",
      "source_text": "『皋月赏』。\r\n——1.242742英里。",
      "source_fingerprint": "964ace437f8365759f735d819161ce1a7de9870b85073af4cb6d11f51164d723",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
