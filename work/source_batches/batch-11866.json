    },
    {
      "uid": "zhcn:3ebdce8dc202c13f2b9f7869",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你认真的吗？！",
      "source_fingerprint": "1bb24b31c7b657cb79da14816e368e43d5bd71a680ec399804abc01cfc651f4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
