    },
    {
      "uid": "zhcn:0642035ae93503291611dcaf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“入场券”已经到手了。\r\n偏置至其他轨道。\r\n接下来要参加的是——",
      "source_fingerprint": "1d6ece49ea3e41da98e99c2fb2dcc287e0097edb6578efab6fe3e403617c16af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105307.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:cdb18ee14c942ab5a11c6ffe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你认真的吗？！",
      "source_fingerprint": "1bb24b31c7b657cb79da14816e368e43d5bd71a680ec399804abc01cfc651f4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105307.json",
      "json_path": [
