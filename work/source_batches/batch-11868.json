    {
      "uid": "zhcn:b61801d1e6c321b3137d37ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与“前一周期的赛马娘”的“交流”。",
      "source_fingerprint": "f19f2ad872f2eadfd1cf24e9ed9290908415a6194bb8345f6576eb3c668bc3aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105308.json",
