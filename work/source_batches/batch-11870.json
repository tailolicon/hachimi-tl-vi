      "source_language": "zh-CN",
      "source_text": "与“前一周期的赛马娘”的“交流”。",
      "source_fingerprint": "f19f2ad872f2eadfd1cf24e9ed9290908415a6194bb8345f6576eb3c668bc3aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
