      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:d10d66e9c58e695de4c7f1e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你认真的吗？！",
      "source_fingerprint": "1bb24b31c7b657cb79da14816e368e43d5bd71a680ec399804abc01cfc651f4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
