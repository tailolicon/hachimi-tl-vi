      "source_language": "zh-CN",
      "source_text": "“入场券”已经到手了。\r\n偏置至其他轨道。\r\n接下来要参加的是——",
      "source_fingerprint": "1d6ece49ea3e41da98e99c2fb2dcc287e0097edb6578efab6fe3e403617c16af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105310.json",
      "json_path": [
