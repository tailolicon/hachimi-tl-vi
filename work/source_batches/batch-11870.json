      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——『宝冢纪念』。",
      "source_fingerprint": "0d51bc06540796567e4e96c8fea976795367d2626043f37140b4d2d52464e593",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105310.json",
