        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:3dfeb66ec5d80840c9fafda9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "成田白仁",
      "source_fingerprint": "6fb15929642a2af0acd6295846a4e80e8710eb9086799818f198da1835f9a4cb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105312.json",
      "json_path": [
        "text_block_list",
        17,
        "name"
      ],
      "json_pointer": "/text_block_list/17/name"
    },
    {
      "uid": "zhcn:68adfab692a82f19c8cbd6c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你——很强。\r\n仅此而已。\r\n哪天能和你交手就好了。",
      "source_fingerprint": "4bddbe748c1fc2c091415cf0cc534f88b772328f4b084aa858f731ab0d1bf43e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105312.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:1fde3344f3763bfecfec9d58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后是，成田白仁。\r\n这是来自历代三冠赛马娘的祝福……",
      "source_fingerprint": "ff293f7d6fb8be52d87aecfb35e943fb9be771626a63e7bda0340cd76f5f7a7b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105312.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
