    },
    {
      "uid": "zhcn:b6008fdceddda9c33ef51faa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙——成为“L4”了呢。\r\n『未知』的……编组……",
      "source_fingerprint": "3c10071ab714709097736ae93021d8d6e36edf84d4d2fe52137d63f17451e957",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105312.json",
      "json_path": [
