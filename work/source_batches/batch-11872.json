    {
      "uid": "zhcn:69ed218dcc5facdeaeb76af5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员。新宇宙有件事情很『担心』。\r\n关于训练员的资格……",
      "source_fingerprint": "c64c23d975db657a49c20f8730d9eeb8bf929d40443a3b5b1e2089710f18fade",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105313.json",
      "json_path": [
