      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:3c4894d96b1fbffb2a6fa19d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们一定能一同毫无迷惘地面对“GATE”——\r\n『天皇赏（春）』了吧。\r\n不过到春季天皇赏还有段时间……",
      "source_fingerprint": "46b2e0b0d62179a210f7a8ae51b0050894c459aba6f59e865e0f319518e51106",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
