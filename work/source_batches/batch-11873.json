    },
    {
      "uid": "zhcn:89e687323b295c3f0d42fc99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我的故事还不能被称之为“英雄谭”，\r\n但就算如此……！",
      "source_fingerprint": "272b78d5f81cf787d4d474f6ea9bf83e717a5693ed38b99ab19eded392419bd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
