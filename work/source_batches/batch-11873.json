    {
      "uid": "zhcn:e3c2b08ade3ee0dcd0b1fa94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，“观测”这场比赛的结局之后——",
      "source_fingerprint": "914d7a54cf2536ba6e92eae35a2bb113a16759dd19c6f9f2e7e596a3ece19776",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
