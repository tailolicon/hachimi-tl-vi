    {
      "uid": "zhcn:fce579fe865110807feb8ea0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——Affirmative。新宇宙也赞同。\r\n就参加『日本杯』吧。",
      "source_fingerprint": "bcaf74c978c9f2c0e4c9c672f6909292df7e29d902e8ae7c5627091bb2271f11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
