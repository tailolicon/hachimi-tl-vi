      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:e071f0237d115c5b99d1b9e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明年的……计划？",
