      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:391ae8b011589c56399948b3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "根据今天的表现来看，长距离比赛对她而言仍然\r\n是个过重的负担。\r\n既然这样……",
      "source_fingerprint": "c0d3ad2728d6a02e05a522a6d1e8e1a65e70cfcde6a81daba22c0b147b9773af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105314.json",
