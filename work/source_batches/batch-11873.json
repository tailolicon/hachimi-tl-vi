      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:223d68ace1d369ef15bf9cd1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『日本杯』怎么样？",
