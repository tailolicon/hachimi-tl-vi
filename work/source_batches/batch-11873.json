      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而可选的比赛里……",
      "source_fingerprint": "d99cea6eadff517b4e828f1a892906a0aaed38c8cd926e3857e40c9d9cf4443f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
