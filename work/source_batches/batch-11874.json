    {
      "uid": "zhcn:9a152840f12fb4d2bc515d9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，新宇宙想——",
      "source_fingerprint": "0a71da850b3232edffe9a178362b76e6cda6322d26af3072fc8bda55f488c09d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
