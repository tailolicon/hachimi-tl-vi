    {
      "uid": "zhcn:0d8590d7d349cb479f56e466",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄。新宇宙想告诉你，\r\n『恭喜夺冠』。",
      "source_fingerprint": "1644d41532c9c587424f086c5d4ff9b5050c6f2dc8cd751d749af585e8f95c30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
