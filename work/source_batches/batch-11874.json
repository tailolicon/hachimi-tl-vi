    },
    {
      "uid": "zhcn:f94d0dd2141695bbcad34ed2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……呼……\r\n“危难之海”……\r\n推进力已经……",
      "source_fingerprint": "e06e272312839362831c104043b9c9f14ed020f15c2aa1135a01bb98a783f1d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
