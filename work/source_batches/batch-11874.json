    {
      "uid": "zhcn:911c1ba194a2806892b2e4e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。\r\n『可以接受』与『不想这样』并存的感情……\r\n",
      "source_fingerprint": "13c289e6787288dd2580502bc7e6c080b333f79316cfef3d6dace59c9504a209",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
