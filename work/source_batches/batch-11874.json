    {
      "uid": "zhcn:5636a324ff18e855b54d3e7e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙……比起“线”，\r\n更像是“点”。",
      "source_fingerprint": "6b041a224dcdd49ebf39cca7e16266930e8030317885ab68ba170004ec61d332",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
