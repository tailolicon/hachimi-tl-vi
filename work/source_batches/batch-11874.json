    },
    {
      "uid": "zhcn:ca5624adf6775e4a5cc91e12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看上去，\r\n新宇宙在某种程度上也接受了自己的败北。",
      "source_fingerprint": "737dead1feb7e5f2aef94e7aeabf1a69e92856489e89493205c10d1c7a0c4a5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105315.json",
      "json_path": [
        "text_block_list",
        12,
