      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:af3705a859ae605c5235936f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着，当晚——",
      "source_fingerprint": "d1a6c554f798388df57c4a8dc2a7c027c140d57086c0d758a8fc3b5eb89dce69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105315.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:e2f24c9a5d43090659a106a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢关心。关于这个嘛……",
      "source_fingerprint": "3a626a2685732872d0b90f922b402550f2fdb8a765eb0f3f8d3cf03336da33aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105315.json",
      "json_path": [
        "text_block_list",
        14,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/14/choice_data_list/0"
    },
    {
      "uid": "zhcn:2b7252e04b548b16afe3c8aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105315.json",
      "json_path": [
