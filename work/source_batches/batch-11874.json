        "name"
      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:3f2ed9b49680a6e7486717da",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你，尤妮同学！\r\n这都是托了尤妮同学的福……！",
      "source_fingerprint": "523cb2df15b35083fee8dc5c4888baa5899e7a6633f8ccb0e33917ebb4e15988",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105314.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:60adf1aa158f3b448d7e85a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最后夺得胜利的，是荒漠英雄。\r\n而新宇宙，也的确在这场比赛里将自己的心意\r\n完全倾注于她的奔跑之中了。",
      "source_fingerprint": "15a981a11ea2f0954307e3fb34fc90a2c1fbd0f7b8dc0b3453e4d52e7ae90d6a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105314.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:9876f9d6d046fe93315fb0c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不用在意哦。",
      "source_fingerprint": "7efc5340fdb829921b5d78b761ed6fedfe83b0df47a631f634f5e2dae584ffd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
