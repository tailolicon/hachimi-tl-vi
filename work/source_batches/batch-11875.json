      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "存在着别的新宇宙。\r\n也许是“DBER”，或是“MUTX”……",
      "source_fingerprint": "9fb6a66bdde1ba8d48b1ea7c6e459bd04303378d399301e4e1c4d49b71a37a76",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
