        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:14472b11ddf2bda92279713a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——距离『天皇赏（春）』，还有半年。\r\n到那天为止，我们能找出“消失”的真相吗……",
      "source_fingerprint": "24a4c6ae2f7ece46b312dc94c325878a2c5e53d5118180cbb0ba886f886ca0a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:96433de572c2827959b3a284",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接下来，准备参加什么比赛……？",
      "source_fingerprint": "29234144bd975f96f6d153a4b0bda1a016fce328c0199548eb612d0d9cc63888",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
