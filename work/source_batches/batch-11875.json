      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:ce8c70d01fb1f8c070db0fa6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是我无法理解的词汇。\r\n如果说退役的话，我还可以理解。\r\n但新宇宙刚刚说的是……",
      "source_fingerprint": "a75751892922825ce568b61526d64d6700744e28b73b5f78f8796b5c4e1a4ea5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:6a0494ce4c99061c64965d7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——“消失了”。\r\n也就是说，连她自己也不明白发生了什么。",
      "source_fingerprint": "88e2e0df7deff98174a5a074191033a802f46637bed4ccb96479d44e1280753b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:b6ec3b6d2e27725bf86dd687",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
      "json_path": [
