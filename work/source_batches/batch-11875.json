    },
    {
      "uid": "zhcn:3e152219f2b46af06b44a27e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙消失了。\r\n无法进行“观测”，也无法了解发生了什么。",
      "source_fingerprint": "9ec5a2caf4c86cde647e501bd733e978ad8462e837d48b4fe0b60eed96501372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
      "json_path": [
        "text_block_list",
        42,
