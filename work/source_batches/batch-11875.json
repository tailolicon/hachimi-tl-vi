    {
      "uid": "zhcn:a1bee018ba03bf9ac0d420b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙之间彼此相连，诞生出无限个新宇宙。",
      "source_fingerprint": "8ab7bc1e50073915aae6466eaa9152559b0ddaa404bbeaa40fa68fa4654514ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105316.json",
      "json_path": [
        "text_block_list",
        23,
