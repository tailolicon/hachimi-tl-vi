      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:a645204213ffe66e0f5fc90c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她也无法救下荒漠英雄。\r\n若是一度选择逃避命运，\r\n那么她也终将被下一个时代的浪潮吞没。",
      "source_fingerprint": "9549a8c0c2f973005bbcb8d4c95019cee6f01f8aac85726c1b64aa8cac4a486d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
