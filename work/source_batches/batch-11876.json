    },
    {
      "uid": "zhcn:3ed59dc3bc5e4b0887786762",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——特雷森学园校舍的天台。\r\n当初，我就是在这里与新宇宙相遇的。",
      "source_fingerprint": "fac9d5d8fa031ac075510a2b498f9f7df9ab2deb563ff344f04ed257601e4a11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
