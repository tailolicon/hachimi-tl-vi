    {
      "uid": "zhcn:e34ca53b059351c8b2da83e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "况且身为赛马娘，逃避比赛也并非善策。\r\n即便这种方法能够保护她自己——",
      "source_fingerprint": "1113518ea43bad22e8ab15a057757b7560d59a404aa0673e8492a7748dd3aa81",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
