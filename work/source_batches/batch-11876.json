    },
    {
      "uid": "zhcn:464d1ab2d1422922dce68038",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在新宇宙的眼中，\r\n究竟映出了什么了……？",
      "source_fingerprint": "29f5baec703fa183590643d1fa41ce68d078e82b315e1022ba69bde49f56a350",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
