      "uid": "zhcn:1fc8cb70c599c70ee463eae5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——Negative。\r\n这是，『我们（わたしたち）』的“SERR”……",
      "source_fingerprint": "4f810551378e2d157ecaba282755fd3120746d8ad5b926f3000aef7221634b5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
