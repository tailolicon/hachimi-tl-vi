    {
      "uid": "zhcn:af9b1755a7b3e095a83460c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与训练员共度的——最后的，幸福回忆。",
      "source_fingerprint": "db3b76b00184602b010d557c3f534e83db38e9d2984de441cb6c354d9a810895",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
