      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:c5e46f7c7fd83921dc44f2d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『天皇赏（春）』总算是平安无事地度过了。\r\n接下来，就是向着真正的“GATE”出击。",
      "source_fingerprint": "68d579b3b3f9651278819a9798bf6789e5fc5ea058452add0ec3610b295b386c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105318.json",
      "json_path": [
