    },
    {
      "uid": "zhcn:d0dc8b7c6441e0ce9622a989",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对绝大多数赛马娘而言，\r\n比赛的结果便是一切。\r\n不过——",
      "source_fingerprint": "6e4bad78fd86095094ad1b44c4e634918884dcb1c47b39bb69e23105d755994e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105318.json",
