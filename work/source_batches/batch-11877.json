    },
    {
      "uid": "zhcn:db305d24ab08d79734bd68d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯の後に・運命の渦動へ",
      "source_fingerprint": "1d5c0a5f5efb5fbb12ade41fd32326e252c6fec35c2484aecb73e4216aeff238",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
