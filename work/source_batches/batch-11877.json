    {
      "uid": "zhcn:be9b93f59f61dd6855fd21b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以……只剩“一件事”了。",
      "source_fingerprint": "b741dd53c01a52b8e0767c8f8bd5e04d1bc8bde32ca25d4323eff61e14780380",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
