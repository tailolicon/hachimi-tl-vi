    },
    {
      "uid": "zhcn:42f41905964843055653f142",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，接下来的“方针”——",
      "source_fingerprint": "e71ef2f5bee2d8781729c6336b1935bcc0292722d418df41274e0837e5005a5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105318.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:e6e96270693829f3db7ad629",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105318.json",
      "json_path": [
        "text_block_list",
        13,
