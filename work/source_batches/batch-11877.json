      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:f83f9a3db2f04990b61f057e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真是不可思议的感觉。\r\n即便新宇宙仍说着那难以理解的语言，\r\n但我却能清楚的感知到她的喜悦。",
      "source_fingerprint": "4d17de88eb5304bf87f231b0466f083351109fea1c86d00a458b0b048a1ab441",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
