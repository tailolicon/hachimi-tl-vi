    },
    {
      "uid": "zhcn:47700c4156abf851cea3af7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "再无迷惘的必要。\r\n东京。草地。2400米——\r\n秋三冠的第二战。",
      "source_fingerprint": "2560c755f9a093ea12f50a182151308a219dd6e014b6362b7e9ca6d2faa381db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
