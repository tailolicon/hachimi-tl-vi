      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:06ed2b31d116a82b3afc2c99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙与同期赛马娘──荒漠英雄的对战。\n终于有机会并肩奔跑的两人，\n是否能透过比赛达到心意相通呢？",
      "source_fingerprint": "6dd2b0c5a6cfc7ebe8bc8527367d9526256f23f7f57cb75f46382fa765c2718b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
