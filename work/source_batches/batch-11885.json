      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:9e40e3e79a951ec18ed535e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“SETO”继承者",
      "source_fingerprint": "4480468a9307b91b0c33f49797ea222bea9d7ad0b9b8be60c3f08d9b77753960",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105403.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:78c792f2a448b363fe7b06d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙之后可能会“消失”。\n──这个“消失”是什么意思？",
      "source_fingerprint": "de1ed84b4a1bf6997e4ee4c9dd076fbadb5e67c63986b81c44a4b3be47923511",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105404.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:3eee51c11d444f2d6fab82e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荒漠英雄建立的假设是\n“新宇宙会透过某种事物观察其他宇宙……\n并且受到影响而变得看不清楚”。",
      "source_fingerprint": "84f3c12be6e8c5e20522d01d286e3b87dfae787526f1bbcf2d919b3ff915cb0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105404.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:2cdf294fb5c7ac4a7aa71f77",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员确信如果要防止新宇宙“消失”，\n明年会是特别重要的一年。",
      "source_fingerprint": "5de8b7ab69550d3f01fff31b39dabae3c76edbe923bb8166af79e430d4eb6fa7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105404.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:be60a970e049a3bb1789d7dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "验证“消失”",
      "source_fingerprint": "31315f57dbaa30b07f1e71a8bb47b46012e573e3d6d53fef8e6503c8911ba98f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105404.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a43b1c5bc409ec1d665e9249",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为新宇宙不擅长表达想法，\n所以训练员小心翼翼，避免漏掉任何一点异状。\n然后训练员发现了一件事。",
      "source_fingerprint": "b024f3b410766a3d05e16ffaf0ceb0e4575583a76345f082b6a3e43983856990",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105405.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:4c7d1b794ed495f65d0ce4b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙在其他宇宙失败\n会不会是因为“沟通上的困难”这个弱点？",
      "source_fingerprint": "8eaf189c25b07c21216b8d9c02bedc9c4cbf019efb511a3ed49c004f8e26a30c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105405.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:3c21a794e45a43c446371e1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，新宇宙与训练员不停“交流”，\n一点一点地拉近彼此的距离。\n训练员现在已经可以感受到她的想法。",
      "source_fingerprint": "b86b99c791abf5082937afb48ab93c3ff86179468443cc129f3f153d13e71ded",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105405.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:7c29589733fde1892397a1be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人一再地用心沟通，\n最后也发现了轻微的身体问题。\n这样的日子持续了一段时间。",
      "source_fingerprint": "c716161afc139048e2888c70eef9dec39f5e645d2d78c555b1d6580b17f7c837",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105405.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:0ccf15d92b9b590db02f5cea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯一的弱点",
      "source_fingerprint": "9489c60fc6477e45b36f1d2005337c0d9888c5756a172aa8d206e98cedb730b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105405.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:ccc85060cab35a1808d5cd74",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105406.json",
      "json_path": [
        "text_block_list",
        0,
        "name"
      ],
      "json_pointer": "/text_block_list/0/name"
    },
    {
      "uid": "zhcn:4d34b88ad040d4960ca33b13",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训终于到来！\n但是新宇宙的牙齿会感到疼痛。",
      "source_fingerprint": "143defd775ef79ef70d47fde826bac7b5edff8128866bf4fb2558629c1941680",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105406.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:ff7bdde3dd3380d259c892cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105406.json",
      "json_path": [
