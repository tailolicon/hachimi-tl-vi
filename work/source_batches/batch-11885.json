      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:41ed6777a21d26846e9a6ee0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然，现在还不能完全放心。\n不过新宇宙谈起了接下来的“希望”。",
      "source_fingerprint": "f80ca0be415fb1e116f9340afc7fc94f2377b4e6e448da530e48888f6cbbc843",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105407.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:2c1303a4c53dbb15759a1e85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105407.json",
      "json_path": [
