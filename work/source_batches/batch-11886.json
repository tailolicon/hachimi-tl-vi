      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:6089da5da683e75792878ce1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目标达成后・冷冻之门",
      "source_fingerprint": "5486d7d0b7d14eb7f53381c7d9b86c1f5969c09cc4082ff3163d206157f8cbe9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105420.json",
      "json_path": [
