    },
    {
      "uid": "zhcn:90172539a24ceb24bdb2a4b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙漂亮地拿下胜利……\n说那位赞扬她获胜的宿命训练员\n也是“SETO”。",
      "source_fingerprint": "f4ed2a74274a09dd9c3e9d7bb99b08479bcca7eff6e6e143c5c40cd04293b04e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105421.json",
      "json_path": [
