        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:da522c34c8fae914edfc936a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "两人展开激烈对决，\n而全新的史实即将诞生。",
