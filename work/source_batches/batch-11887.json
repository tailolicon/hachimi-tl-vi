    },
    {
      "uid": "zhcn:15d42c67eeabf15050f5c2c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接着她揭晓了令人冲击的事实。\n新宇宙并没有预见未来的能力，\n而是看得见其他宇宙的自己。",
      "source_fingerprint": "65ba16b1693396a645b247c8d19d566e512b9e62a72390c9324bb20aafadf19d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105432.json",
      "json_path": [
