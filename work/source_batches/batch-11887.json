        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:1e763e88c7c01e14976c5c54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105432.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:fb2f0b1274c28f9638168ad7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了避免她消失，下一场比赛是──\n其他宇宙也选择过的“大阪杯”。\n必须在这场比赛拿出更好的结果。",
      "source_fingerprint": "e283135016074405af0dd346f216471728e2db7c7eb1cf48f80e6ab5cc9e9280",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105432.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:8c2bafaf80649783e0baaf79",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日本C结束后・揭晓“窗”的真相",
      "source_fingerprint": "bf6a4602376744c55d7dea5d239f0321b038c9745037cfeb7ac12069c270abbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105432.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:6180ebdbf0a59593f8ddc6e3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑完“大阪杯”的新宇宙\n以难懂的语句表达自己内心的欢喜。\n训练员一瞬间便理解了她的意思。",
      "source_fingerprint": "9ac4b6499e8e2526803c017617c5939d425238b6e70628160c3302fe6d1902c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105433.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:58cb9cf9b5c48b44286af161",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就像其他宇宙的记忆流入脑内，\n心灵产生了连系一样……两人如此想道。\n──“希望能够像这样一起奔驰下去”。",
      "source_fingerprint": "7509da73e6cbe467f6e9c429fdeb4d6b7db26c6f2bc9b8072e2397a7d60bfc8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105433.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:8479da21a7212a029d4dbb07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了实现愿望，训练员说道，\n“会不会并没有消失，\n只是没有看见而已”。",
      "source_fingerprint": "5e8bb3bf6119933eb5c8904dfd89e9a6f41dc2d0d31138ecde8d6ce44316a90b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105433.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:90e9a41b9040d19ed3f65a25",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谜题未解……不过，两人已经尝试过各种方法。\n既然如此，也不必耍小聪明回避比赛，\n全力冲向“GATE”──“天皇赏（春）”。",
      "source_fingerprint": "91ed940997bca9cf5de202063572927c7123328c36f32a9045eb53ee486b0b92",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105433.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:0e068be200b287690761838c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大阪杯结束后・前往命运的涡流",
      "source_fingerprint": "4ce0aabef26ea481f3d91337497d0ef8fb9a61ad3ea06998fe736c0affcda42e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105433.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:aa9653727c49c2e20b58ad1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙顺利跑完“天皇赏（春）”。\n然而两人并没有时间庆祝，\n便匆忙赶往医院检查。",
      "source_fingerprint": "a76535523773b9f8af916340930ffb8b0218fc80bf68fd82f204c4029acc1734",
