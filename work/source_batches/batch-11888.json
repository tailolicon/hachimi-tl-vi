      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──我回来了。",
      "source_fingerprint": "f505ee3808d676cb98fd762766d6f48b6a9ce9db14ca19d16260fa1f6fdb2a26",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105438.json",
