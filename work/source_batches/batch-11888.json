    {
      "uid": "zhcn:ea0ed36d2db3d98aef440418",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・秋季三冠，消失",
      "source_fingerprint": "feba6058caee7be08595452e2bf8b9cfec9d5971dc69d395b37441e6fb10df29",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
