      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙的话令我鼻子一酸。\n我跟她约定好，\n一定要再一起玩。",
      "source_fingerprint": "ff45560bda183c82e66e0e03a36c1b0f2736f7a2c8b931a3aacd656f7156c30d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
