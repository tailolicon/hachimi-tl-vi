      "source_language": "zh-CN",
      "source_text": "……“应该”。\n但是，新宇宙“不清楚”。",
      "source_fingerprint": "a80517a287191f4e7ff3585a16f4569fcd9288fd2ba037284797cf3153d22a32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
