    {
      "uid": "zhcn:c13fce2749784db1c1514004",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目的、方法──“未知数”。\n因此无法“一起”。",
      "source_fingerprint": "9cc9278730f6e8dcdb902fc15528816dad0df64664320e26f622d6666ac3af4d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105705.json",
      "json_path": [
