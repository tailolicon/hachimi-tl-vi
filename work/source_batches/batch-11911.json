    },
    {
      "uid": "zhcn:5d3799ff9ad146f195bbc3cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，新宇宙想要变更任务。\n如果是以“微重力”进行“训练”，\n便能将影响降至最低……",
      "source_fingerprint": "0f463f5f9807a0632282250df2dd07b4a80f76dcd4f44baf06509f04dcae4fc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105714.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:1418f769624a6e50d303b5a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在应该要专心养伤",
      "source_fingerprint": "861312ac54e1a5aebb35ae41b52b8bef69179fa050df73231ea723e627635584",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105714.json",
      "json_path": [
        "text_block_list",
