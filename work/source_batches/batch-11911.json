    {
      "uid": "zhcn:cd592fd33d9f998c517aec3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙一边评估伤势，\n一边完成了轻度的训练。",
      "source_fingerprint": "7fd77f4a5e05a3971bb5b91cfeb099b9516aa8784aece704b33fcbbb60fa4be7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
