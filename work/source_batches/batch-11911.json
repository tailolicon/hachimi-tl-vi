      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新宇宙",
      "source_fingerprint": "f4d688f71d8c38a8a2d9ef98cb402b044f0892dc958bfddf71ec65b7b37fbf2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105714.json",
