        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/5/choice_data_list/0"
    },
    {
      "uid": "zhcn:908c886359927f1dc138ea96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果我认为太勉强就会立刻阻止你喔",
      "source_fingerprint": "400fb7c1765ba470765cac6168e340764258f898ee94f3e0bd2c4741ccd94556",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1105/storytimeline_501105714.json",
