      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:9cf9d4e6f42297a6a0ce5d90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实际上根本没有这回事。就算她很被动，\n但还是拼命努力地完成了\n跟其他赛马娘一样的训练项目。",
      "source_fingerprint": "ff8fc08f563c7c2f9582ef966dd674a1e58ba8c02f411d6de97ff98ee67e5c37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
