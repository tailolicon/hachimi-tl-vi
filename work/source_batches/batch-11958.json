    },
    {
      "uid": "zhcn:c7a6ba8c717eb4dbada46a54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──正好相反，虽然菱钻奇宝说自己做的事\n不属于“努力”的范畴……",
      "source_fingerprint": "a544f767261fe9bc10e7fca169b749770b1c11d16b9c729497bf444582474752",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
