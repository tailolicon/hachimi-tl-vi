    {
      "uid": "zhcn:765ad5bf6b66116519f67ec0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦、咦？训练员，\n你该不会认为我是个没出息的家伙吧？",
      "source_fingerprint": "f0775ea79a2b9d4e1570fc79f9615937357ae6314d2e7e735bcde76579724187",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
