    {
      "uid": "zhcn:7ef7d7273dd41220467c22b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "到经典级的五月为止一切都顺利结束了，\n不过菱钻奇宝她……",
      "source_fingerprint": "3bacf0e4db62b563db992be01619394fea87a27fdbfc38f0c853cd33650ca7f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106419.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:21a7b0db3a0520b8cbbb17c0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
