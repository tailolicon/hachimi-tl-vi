    },
    {
      "uid": "zhcn:62ee52d23523468a2b51eb16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱钻奇宝就这样毫无真实感地\n结束了比赛。",
      "source_fingerprint": "83d70bf990f67162107f025f1518d7971f8e18f9e48efbfdda4eb3931be0d466",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106418.json",
      "json_path": [
        "text_block_list",
        1,
