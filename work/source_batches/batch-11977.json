    {
      "uid": "zhcn:a66853a8fdd516be40d86f06",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "顺利跑完“日本德比”。\n然而，这个世界就像在某个人的梦里一样……",
      "source_fingerprint": "43d478ca7cdbd10ce7c654cab5df9e3109546c503c49af89032264ab47fc705a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
