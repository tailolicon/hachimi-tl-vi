      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9d15ff63c324efb840ac520f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天皇赏（秋）结束后・终点的另一边",
      "source_fingerprint": "eaa55a07be000a0107d530e705aacab18d15dcd6019fdfa068c248f644242264",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106429.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:54f337e4d810853e6003ccf7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然跑完了比赛，但还是找不到自己的梦想。\n对着这样的菱钻奇宝──",
      "source_fingerprint": "d3cc4ed08a85a3bdae032ab4ecd27c0d62290ba60793f6890467fed849a7c685",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106430.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:8f5d609b62c0cea1df6a8c5f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "传来了大叔的声援，\n大叔希望她能再次让他们看见梦想。\n她发现有人能在没有梦想的自己身上看见梦想。",
      "source_fingerprint": "d586cebfec388b045d29a5b167075273fe4741e910c172010411e40d98b35fcc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106430.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c3f38b63ff0cddfa9731fe48",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在年底的“有马纪念”\n等待着她的是爱丽数码，\n以及喜欢阅读的英雄，荒漠英雄……",
      "source_fingerprint": "b3335b641c4230f8d773e7951b021576fa5e45345820a7863d61f632232a1392",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106430.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:5995ca2f9c936983ee11850a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "菱钻奇宝就这样\n受到大叔的声音引导，\n决定以“有马纪念”为目标。",
      "source_fingerprint": "dff4543f1e990fdafe1a1732d2478bca441b7d86df5fc58b76d1876d3abc0d9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106430.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a36147faf5094345543d3baf",
      "kind": "story",
      "source_language": "zh-CN",
