    },
    {
      "uid": "zhcn:5f610d190ca00766639498bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其他赛马娘都有着什么样的梦想呢？\n为了当作参考，\n她决定前往世界级的梦想展览会“日本杯”。",
      "source_fingerprint": "06c661f45d41e22411c15f7d65c6c3ad6c21ad86cfa17bee2d6ee3be25a6682f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1106/storytimeline_501106429.json",
      "json_path": [
        "text_block_list",
        1,
