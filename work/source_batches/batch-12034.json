      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……之后便以闪耀・系列赛为目标\n只身前往日本。",
      "source_fingerprint": "a4113e422f6643033ae36732186545513fe81b2b465684e054145690fea0523f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
