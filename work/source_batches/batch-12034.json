        "text"
      ],
      "json_pointer": "/text_block_list/67/text"
    },
    {
      "uid": "zhcn:b3bba2d89734d1812c634284",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为这一机缘而相遇，成婚。\n勇敢之心在懂事前就跟随母亲去了美国。",
      "source_fingerprint": "0ca836fc027f62c8872953805f83d89748efc2646f74143707cda5b770b14568",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109113.json",
      "json_path": [
