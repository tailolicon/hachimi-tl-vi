      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不仅如此，她还\n得到了“希尔埃斯塔学院”的全力支持。",
      "source_fingerprint": "e2f046f6d5dd3df1ca58f36c8ded7930e812ff720be3c35821840b83120ecb4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
