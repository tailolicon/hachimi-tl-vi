      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋日温柔的阳光透过树叶\n从窗边照射进来，莱茵力量还在沉睡。",
      "source_fingerprint": "930e32337d5f9b30020b95c97218ee1918eb00fe7b20ce7275bf254f8b026b3e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
