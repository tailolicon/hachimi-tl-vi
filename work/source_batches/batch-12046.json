    {
      "uid": "zhcn:8664f53051723d32ebea06c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我双手掩面。\n紧咬牙关，恨不得把牙齿咬碎。",
      "source_fingerprint": "56de7a9b59c3431e716489d470cd5075ef444fe7779006cbe60e1c59b6cb47bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109119.json",
