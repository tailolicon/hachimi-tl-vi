      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "快起来，莱茵。\n不然的话……我可就要先你一步了。",
      "source_fingerprint": "a83113ab2c5d53934651517dcff36096db4b62e3307b09f9b26cd2f45caf69e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
