      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——我突然想起莱茵力量\n当时从睡梦中醒来的场景。",
      "source_fingerprint": "20d55ae42b9b5cf908490d7269268ec1d498697da15321c833215a123a261e8b",
