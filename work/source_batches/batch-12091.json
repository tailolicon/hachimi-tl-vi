      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109400.json",
      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:bddd131e90a73da77778da4d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同时，也有很多对手。同期的西沙里奥、空中救主还有勇敢之心也将目标定在了后冠路线。",
      "source_fingerprint": "33b56b989bf1d0358dfc7ae243f3e15f950a3069b5d3263a34dec8d358cdd526",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109400.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:a2822a5baa2ad940039df416",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109400.json",
