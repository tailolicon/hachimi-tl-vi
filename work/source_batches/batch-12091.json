        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:c880b703f0da180386ca81b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109401.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:3030c6d6026745f31b4b8520",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量说着自己也要再加把劲。\n这时，前来观战的勇敢之心告知说\n自己也要参加『阪神JF』。",
      "source_fingerprint": "6d4bbe769466f24ef123748f797c7eb4a02189a2aa2f5a098642110bcfce1e45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109401.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:ebe258179712f7b25a497263",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109401.json",
      "json_path": [
