        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:6be014cac891098ec7e18893",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇敢之心是为了夺得三后冠而带着坚强意志\n只身来到日本的赛马娘。同时也是\n最顶级的赛马娘育成俱乐部出身。",
      "source_fingerprint": "7b66b9def77bbd0eb45d9231bc5732a20847d02efb7ac44a5ab42ab482b3acc7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109401.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:6a9165ddf65c2544891a3fee",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109401.json",
      "json_path": [
        "text_block_list",
