    },
    {
      "uid": "zhcn:8829122fc7fe3ad259aa1ce3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "闪耀的心意",
      "source_fingerprint": "d4b0c32e92dc5b84824bdabcd095d25ce96dc493ee2a9d17e272923bbf657a75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
