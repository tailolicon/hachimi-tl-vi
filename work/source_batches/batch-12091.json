    },
    {
      "uid": "zhcn:02e00c95c2c536c29555be22",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在这些同期们面前宣言了\n自己要在三后冠——『樱花赏』\n『日本橡树大赛』『秋华赏』中取得胜利",
      "source_fingerprint": "6c36faa040897452d66f56c59a7c504f652d60aac683b866ecbad24b057457b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109400.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:18ba28556e337497e6049ae3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量登场！",
      "source_fingerprint": "5334aee1fd25827f7f10a5dfb53e513114f2e1e7a7b2ee00779abf7b85cac1ae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
