      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:f9b6f76a4c78190c11e7b271",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第三年）开始！",
      "source_fingerprint": "eef37080660583492caac78b957b8f144bbb2896156162385fc6034f5649e4df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
