    },
    {
      "uid": "zhcn:80d43082a440c5a26c11b56e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与此同时，训练员和西沙里奥\n担心着叫不醒的莱茵力量。\n她还在沉睡着……",
      "source_fingerprint": "1465e2fb5d43d28c48042ae05ad16eb7c36e70d76393a8f6764d8d7b8bb022b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109409.json",
      "json_path": [
