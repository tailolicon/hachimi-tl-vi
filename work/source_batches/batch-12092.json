      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这时，她又突然想到西沙里奥\n还没确定是否会参加『秋华赏』。",
      "source_fingerprint": "30db1316c309ed9f2687bd0be7f4e9588fb5b712d2545e8b1c16c0c139aa6ffa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109408.json",
      "json_path": [
