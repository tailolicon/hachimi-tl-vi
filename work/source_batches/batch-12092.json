      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:ec6889a54d03c6a60ecce7a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为后冠赛马娘，与某人的梦想相连。\n『我』是不是也在这里与某人相连呢。\n对此莱茵力量心中激动不已。",
      "source_fingerprint": "e4cbc620d84927f4d4a058301a2e61f68eaa23a0cbd7b7ecaa4a808c839f228c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
