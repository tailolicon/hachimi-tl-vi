      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量问了勇敢之心，\n为什么要选择挑战『NHK英里杯』。",
      "source_fingerprint": "9b48c4b868d496dc045309636e411ffd7a87ef5c54d92e2ddd1a9766684e00e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
