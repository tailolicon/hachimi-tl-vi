      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，她相信对自己充满期待的教练，\n决心以『阪神JF』为目标。",
      "source_fingerprint": "d1e7e455cc30534eb20142ed4bc6dff2faf0c2f7656e17c53e6eba3084ab9a22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
