    },
    {
      "uid": "zhcn:345a9c7a19aa7d797ab15dc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众们掀起了狂热的旋涡。\n因为在大家心中留下光辉，\n她的眼中泛起了泪光。",
      "source_fingerprint": "ddf54d696161e765f1ac7bf040f38e4fbe451940bb57658327239e7f8365c7de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
