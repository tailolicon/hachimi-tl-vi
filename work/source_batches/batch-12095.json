      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家一起跑的话，就会有更厉害的魔法。\n在『维多利亚英里赛』临近时，\n她这么说道。",
      "source_fingerprint": "30d866a6ee0ca2ab324b67bfecfb35850da72df036b114c20041fc85c054b665",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
