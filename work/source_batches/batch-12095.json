      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋华赏结束后・在我的背后",
      "source_fingerprint": "7f754adaa4032876a4aa50e68c79a18f09168bd930c13a0694acfb558bbcbf30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
