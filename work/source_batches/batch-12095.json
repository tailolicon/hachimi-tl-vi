    },
    {
      "uid": "zhcn:d75c2a2aa939735659bcfb56",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "维多利亚英里赛结束后・梦想",
      "source_fingerprint": "33589af3767da178150959435c23ce28a7fe1e47b4b11284c6ca475c8815a4d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
