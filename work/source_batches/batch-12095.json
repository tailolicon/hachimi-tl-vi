      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就在这段时间，她看到了意想不到的人物。\n那是小时候在比赛中看到的橡树大赛马娘\n以及她的小宝宝。",
      "source_fingerprint": "b4042ae73395aec72caf75d9ddbd236874efd6b408fe9ce2ccd569fa88e383a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109436.json",
      "json_path": [
