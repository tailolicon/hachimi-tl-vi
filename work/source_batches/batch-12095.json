    },
    {
      "uid": "zhcn:f88464fe8522e1de4b0fe0dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "超越了憧憬的后冠赛马娘们，\n莱茵力量漂亮地取得了第一名。",
      "source_fingerprint": "19d3bbe3b4d5ad502da119360c31aaf2be727821d0f1038bc6f167df0566f45c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1109/storytimeline_501109437.json",
      "json_path": [
