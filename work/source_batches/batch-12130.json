    },
    {
      "uid": "zhcn:94162e9f1241fa7d17f659df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我推荐的比赛吗……。\n嗯，果然还是目白高峰前辈的\n史上首次三后冠达成吧――",
      "source_fingerprint": "125cc8fc994564ef23ec1ba1c406be840e52c14151599e8d5cdfade2c76e0d0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
