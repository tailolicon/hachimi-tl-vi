    {
      "uid": "zhcn:15a642674b7aa93d2232bf31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从小就反复观看，\n那是我的原点――\n是我应当追随的方向，也是活力的源泉。",
      "source_fingerprint": "0e8e0507cdcf4212057df9d8a6bf52a62294e5524e5b71bdfc0126c4d4f4fd5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
