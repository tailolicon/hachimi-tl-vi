    {
      "uid": "zhcn:c77448bb1353be6c594e5734",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一定要跑出一场比所有\n闪耀・系列赛都更耀眼，更加精彩的比赛！",
      "source_fingerprint": "aab07433195d72b5dbff697cc737302406fc57f2031b385ab79a2a51e6e7ff08",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
