    },
    {
      "uid": "zhcn:e4f2cb2cead85015cd866509",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量",
      "source_fingerprint": "0cc0478397dddaf29860878e611e32a8803c3deb73f318f6dbdfb06a653d53cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
