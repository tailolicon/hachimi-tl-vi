      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:853e8ecd099e591a6105453c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "惊人的最终直线――\n甩开后续马群，进一步拉开差距\n四马身的压倒性胜利！",
      "source_fingerprint": "d2adfa9e8560b0959dc9e46881cc0ea38fbeedc62a431ef9f373c26642c06e01",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
