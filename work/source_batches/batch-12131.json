      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，容我冒昧拟定了一套\n实现目标的步骤。",
      "source_fingerprint": "4c23a26ea0d93d988973929b57e25894578ce215948b0c29a2b5d001184908ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
