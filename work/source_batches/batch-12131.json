    },
    {
      "uid": "zhcn:4e3801e6d24973c762824455",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大目标是三后冠。\n特别是『橡树大赛』的胜利――\n橡树女王的桂冠绝不能错过。",
      "source_fingerprint": "640a20a65d87d7215defd1de7b193b3551d647bb7b57bb26c55128a36b020b72",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
