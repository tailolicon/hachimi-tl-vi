        80,
        "text"
      ],
      "json_pointer": "/text_block_list/80/text"
    },
    {
      "uid": "zhcn:efbf480a67f3403aaa01d69d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "流畅说出的言语和知识\n连现役训练员都自愧不如。",
      "source_fingerprint": "423520b8a2038b1c5946083207e9c02b309810cb7a4fab7dfc1962d94dfebfd0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
