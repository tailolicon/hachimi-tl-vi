      "json_pointer": "/text_block_list/81/text"
    },
    {
      "uid": "zhcn:75f4738b0ced170d0e2cecb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，在那之后的训练场上也是如此――！",
      "source_fingerprint": "833df05797f238c6c32ce5365278a5e3bdb66504abf323c4be22df08bd4418fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
