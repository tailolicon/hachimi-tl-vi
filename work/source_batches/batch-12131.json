    },
    {
      "uid": "zhcn:297a0f9615f541666e85218b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……好厉害的梦……",
      "source_fingerprint": "c25b3c81e0c4f4e627340d9e91dff99bc4a7e51fe94533d99bee0a61111fd7c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
