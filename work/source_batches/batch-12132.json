    },
    {
      "uid": "zhcn:cee31a9c98e076b06fd93a34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥登场！",
      "source_fingerprint": "454ac2bfd5264aba4236d707575e63d59ed8b503bf80b226ad3f92f020e7df74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
