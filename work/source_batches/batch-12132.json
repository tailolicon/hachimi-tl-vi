    {
      "uid": "zhcn:9434672c481671e77c144e1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "抱、抱歉！",
      "source_fingerprint": "7cb99cef94a20756095aefcd3d93d633b8930ced125c87a80e4a6d3ce3c4b5d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
        "text_block_list",
