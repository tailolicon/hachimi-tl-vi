    },
    {
      "uid": "zhcn:97c124da850cd9d44f402b7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我培养的孩子，由您来让她们获胜。",
      "source_fingerprint": "309d582429f0b894e03788ab7f020a196a06c5cf2944ef79e782ec09eefddf8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
