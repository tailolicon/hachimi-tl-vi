      "json_pointer": "/text_block_list/92/text"
    },
    {
      "uid": "zhcn:1f241958f51247b1b853c210",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知不觉间，似乎表现在脸上了。",
      "source_fingerprint": "0676bcb555085b6ccd5a6453a99c433261eac5ef54367382d9882174bd20848f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
