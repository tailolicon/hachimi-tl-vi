      "json_pointer": "/text_block_list/92/choice_data_list/0"
    },
    {
      "uid": "zhcn:9ee6a294a2b4d0d50b2dbce4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对、对不起！",
      "source_fingerprint": "8379fffba59e5c990a882a0c362d96c479fcf424051cf17816e45733e0de6785",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
