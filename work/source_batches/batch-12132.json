      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我获得三后冠，\n并且退役后也作为训练员\n支持我的梦想――",
      "source_fingerprint": "490e5a58c0ff58d5e9fc6e2eca47a4497d0eec4442362ba66dfa039fc706c1e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
