    {
      "uid": "zhcn:a30c9339b95a5ed257acb7e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没什么，只是您夸得\n实在太坦率了。",
      "source_fingerprint": "44e87424eee870221a15908783743720027dd1b58c02ceef8d4912aea01c269e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
