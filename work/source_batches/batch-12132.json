    {
      "uid": "zhcn:a6d23064716956b25d70c33f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还有那道炙热的目光。\n……能清楚地感受到您的期待。",
      "source_fingerprint": "e08cf42eb845d97495c837e76a8cb787be99005fbbf4ac954ced3ca2b41d976b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110100.json",
      "json_path": [
