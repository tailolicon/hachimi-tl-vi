      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那天晚上的事，\n即使闭上眼睛也能清晰地回想起来。",
      "source_fingerprint": "c3086e48f1803961e6c2c8ec2fd3b41eecda4b6df35b4c1c2f9ea33f6e5b9b9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
