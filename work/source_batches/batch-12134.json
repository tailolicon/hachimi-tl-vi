      "source_language": "zh-CN",
      "source_text": "我也分享到了她的幸福。\n莱茵，真是个了不起的孩子呢。",
      "source_fingerprint": "dd221c53c03c9d464bbb282e23cb49e76521ed1eac7ec1f40e8a7bac0d0384b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
