    {
      "uid": "zhcn:be29b433174dcef91d58c2e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个，有件事想和您商量。\n这周末，能占用您一些时间吗？",
      "source_fingerprint": "4798f48a19994cab07b2d42cf48dc491991f356e4e91c470a5c52cf16fd4c929",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
