      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也是赛马娘，自然大致理解\n那股想要奔跑的本能，究竟是什么。",
      "source_fingerprint": "05ad48f47bf2ef465701d28fb8530ab3effdf90cb7a9b42906e60c73e5d2e205",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
