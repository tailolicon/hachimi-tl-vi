      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:39fd9923946e35ad045df794",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一步步来是不是比较好",
      "source_fingerprint": "35a1f520e297734135d7548211523b008649553dbf35d44608633013d40f80f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
