      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:168ab3d65144b4238dcbe0fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样一来，等我们讲起规则时\n她或许也会愿意听了。",
      "source_fingerprint": "bcc3e1889340fe33f2b636d6d11d2d9300e0381a0dcb0fc2ae974b62c904951c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
