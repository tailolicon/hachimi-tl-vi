      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:09f3b8efe3ae3da2590c5562",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那孩子是想跑得更快呢",
      "source_fingerprint": "2b299235ac80b1bbea3ab9cbe0f67768b86dced28bf74bf08ccade279a0ea18f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
      "json_path": [
        "text_block_list",
