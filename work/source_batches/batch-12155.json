      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:7c2fe17d2ad7e36bdcfaf64c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……",
      "source_fingerprint": "a977ca8e3137e67a7a6918a06d3d86d57fbf577994f726c5155115e0a2b3071a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
