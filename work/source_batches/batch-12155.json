    },
    {
      "uid": "zhcn:7e04d6b1669a021afd25df78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………。\n原来如此，谢谢您。",
      "source_fingerprint": "85857ab240c20a12cc7ef8e06d363c8b789eae642f2b0f8795ddacf9a379958d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:94d0d42beaa3e9e5265d1ea4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
      "json_path": [
