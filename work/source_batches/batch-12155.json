    {
      "uid": "zhcn:60e69594d0e14df2f76a93d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥开足马力飞驰。\n年幼的赛马娘笑容灿烂，兴奋地放声尖叫。",
      "source_fingerprint": "6aeb977ffd25d7251500214d75eafdb87cfa126560cb0e1cd2b7728787ee605d",
