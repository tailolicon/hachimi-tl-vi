    },
    {
      "uid": "zhcn:8992479aac1f0927d2af6a54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "能够迅速赢得信任的办法，\n我只想到一个。",
      "source_fingerprint": "ea06a9e116a7aa66788b8178246d92ec5cfe019fb6d6609a8e1f1456c87e9aae",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
