    {
      "uid": "zhcn:0e3c5bfe7a88ab3ffe9150ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是……培养信任关系，\n并非一朝一夕能成。",
      "source_fingerprint": "5610de3541b445f226db35e91a26dd114ff0fc69e8bf1bfd11f95d5057049f00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
      "json_path": [
