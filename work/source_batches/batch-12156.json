    {
      "uid": "zhcn:733a77f520883317f773cd94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我当然什么都能和您说。",
      "source_fingerprint": "1d08767a4b94a0e8b6844d3d9c53e460cd05e7aa0e1d14ff1a3514c9ac05b0a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
