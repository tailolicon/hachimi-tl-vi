      "json_pointer": "/text_block_list/82/text"
    },
    {
      "uid": "zhcn:e04c6728c969d285a9319160",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对那个只会赞美却未能成为她支柱的自己\n怀有愤怒、焦躁、不安。",
      "source_fingerprint": "f1e321d24fbc64985d308556e3bc9d77443b9e596c857d804340fd133129117e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
