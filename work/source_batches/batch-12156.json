    {
      "uid": "zhcn:bc8760dcb608f3828010f268",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "望着她直视我的双眼――\n埋在心底的情绪终于满溢而出。",
      "source_fingerprint": "7a29ae38f1ad086f1e2a184db35322a1379af22bf7269b129ddf08048fa2f469",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
