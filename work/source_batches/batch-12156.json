    {
      "uid": "zhcn:60d2e5efc2320f0f9cdaf93b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "讨论那个孩子时，\n您毫不犹豫地选择了折中方案吧？",
      "source_fingerprint": "02c13d178225c5ec180d2fde334e075a5afdac36684219a44a5c555e6eef6ce5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
