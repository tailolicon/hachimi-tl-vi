      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您比谁都了解我。\n今天我尤其强烈地感受到了这一点。",
      "source_fingerprint": "9f6a467f48b0ca90ec4a5ccbc57d201e41f51c6bf324b5a03480ad77bd71e499",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
