      "source_path": "assets/story/data/50/1110/storytimeline_501110114.json",
      "json_path": [
        "text_block_list",
        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:26528d5714591288659ccc4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
