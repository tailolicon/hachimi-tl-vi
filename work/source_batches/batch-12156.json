      ],
      "json_pointer": "/text_block_list/83/text"
    },
    {
      "uid": "zhcn:af504cf06a0b73d364c3793e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了与她并肩，为了助她一臂之力。\n我四处奔走收集、分析、汲取知识，\n始终与她认真相对的那些日子。",
      "source_fingerprint": "04239cf101f22a796a3a18326b90b45e9826356a88a012605f3e8b2b6c876f09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
