      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我很少有这样的经历，\n感觉既开心，又害羞得心里发痒――",
      "source_fingerprint": "026adeb39cc3e9b244623110f5602700d3404f8367c406074ece0858b987b530",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
