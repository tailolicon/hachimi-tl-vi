        "name"
      ],
      "json_pointer": "/text_block_list/74/name"
    },
    {
      "uid": "zhcn:e158aca83036da4cf2dbdd88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您瞬间看穿了我无论如何都不能退让，\n却又想尊重您主张的矛盾。",
      "source_fingerprint": "6b2845cd89943dd099cf0404c4fadd7eed34cdab2d87d1a65c4d033b25c5e5f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
