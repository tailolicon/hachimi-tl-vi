      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:6f4737250abe473852917872",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赴美的准备在稳步推进。",
      "source_fingerprint": "d615b1fd318433ca4e236e4f914be6d3942665f43e809bbca914c920476442d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
