    {
      "uid": "zhcn:de27efc2e244d698eee53101",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想进一步强化从动作分析数据中\n得出的，我目前所需的肌力――",
      "source_fingerprint": "cd7423a190554fe97066a57a926ef1e2cb1799c6ae738da11df1bb3f775e852a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
