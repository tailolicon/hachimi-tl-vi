      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "用合适的训练强度增强身体。\n同时兼顾腿部护理与健康管理――",
      "source_fingerprint": "c2a1e2a7053ec901f7673e8598a4301048c099c0b2731106c4ec3103f66ceb85",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
