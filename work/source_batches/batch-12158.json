      "source_language": "zh-CN",
      "source_text": "需要的东西，基本都齐了呢。\n剩下的是转换插头吧？",
      "source_fingerprint": "3be807541a5665e8be580499a58de95fe37b44b8b9666aa05babbf24cc98ab65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
