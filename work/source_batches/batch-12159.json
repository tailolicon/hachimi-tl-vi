    },
    {
      "uid": "zhcn:c7cb89c3c2011bf1c55af1ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『美国橡树大赛』在等着。",
      "source_fingerprint": "c6a897d999144ee243d1c47f8d7e7c5923d8a324b3c7d78a756cec92475d231a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:ca2055f756c717fd5b15b14b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥公布的计划，\n在社会各界引起了巨大反响――",
      "source_fingerprint": "2e4d1a1ee4f6a148a2f228af34d2bf4aefc3c95d84dd82cd984937f68388e5a1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:f603dbd183d7d00064798922",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
