      ],
      "json_pointer": "/text_block_list/38/name"
    },
    {
      "uid": "zhcn:f62c39544378c4235f47eb45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若现在继续勉强，\n转为慢性炎症的可能，也并非没有。",
      "source_fingerprint": "ab1aea830b9bb692ded5c966a6049b727adc99bc52e8be02eb9f15b634f924eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
