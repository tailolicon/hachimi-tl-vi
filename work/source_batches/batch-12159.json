    },
    {
      "uid": "zhcn:0e0222d21b02ce04f8d77cbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
