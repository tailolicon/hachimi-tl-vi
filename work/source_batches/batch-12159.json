        40,
        "name"
      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:187d4f1e22fcfd0b19408f00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道。\n也知道这对两位来说是巨大的挑战。",
      "source_fingerprint": "01fd5e89f91e93596ac6c0d9f9bdd4de94b26cbe91d82ba0a7c47810b71b495e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:2984aeda0bb1e1c33f6c3b21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        41,
        "name"
      ],
      "json_pointer": "/text_block_list/41/name"
    },
    {
      "uid": "zhcn:13f847ef7a15bd196721f256",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……既然提前这么多发现，炎症也很轻，\n参赛后不出问题的可能性反而更高。",
      "source_fingerprint": "9c1804175ad509245bb53bf6f694ba15da0f9dfc7056f05fbc45e0381f665fb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:ca37ad2d8ccca9590cf40efe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        42,
        "name"
      ],
      "json_pointer": "/text_block_list/42/name"
    },
    {
      "uid": "zhcn:3a568f5339ef96161e62f1c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论如何，\n对于赛马娘来说比赛就是人生本身――",
      "source_fingerprint": "a7e4e909d6cc9b10ab72e15654224b2ce7b3ef293754dad08e899b6bdfeb6a63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:d1d54b880e5b949582a5f4e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是",
      "source_fingerprint": "6418dcaa68f3f962e7994ec43d66fbfc3e790894ffea8b3fdbe13d5e6234af32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        43,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/43/choice_data_list/0"
    },
    {
      "uid": "zhcn:80e8137e94f032f7e0d0b14b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
      "source_fingerprint": "e8ec877c8da553d3c55be4e735c406596a5c12c545adfd3c0c6a6108c87aa7ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        43,
        "name"
      ],
      "json_pointer": "/text_block_list/43/name"
    },
    {
      "uid": "zhcn:17abd0ae57276bc685a9e75c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是否出赛，就交由两位自行判断。",
      "source_fingerprint": "dadcf0875ced4dc04980850c6f99df21bdd5335a2250afef3f5cc51fb5a24ae1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:c2f3766c2014459bfdf8957a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……――",
      "source_fingerprint": "28fbf0e5a46c7053545bcf1401c5e72875bd0100c361792176d130bc7eddc9f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:c93263cb0bd608756fc492fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥将一切押在了这次挑战上。",
      "source_fingerprint": "2a2c2b0104fb6f9c33549c9100cf58eb1e9e86d26250477cdeb0ecdff2e86717",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:7e2208b78cb911d1c3291634",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向来冷静的她曾露出那般灿烂的笑容\n我始终无法忘怀。",
      "source_fingerprint": "9520ccfae5c5ccb04ed5e3af9e2dacabd2f11804ead4ded09ad9ceff3563e55b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:332cf68d4423992b4fb98bf7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但是――）",
      "source_fingerprint": "d61a180ae721f4e3b8887db1ea74e4a1701954e1e65b0f149ba0874ba38c88a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        47,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/47/choice_data_list/0"
    },
    {
      "uid": "zhcn:5290f973fdeffab925b1cc62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要充分留意似乎不会有问题。\n我真想让她去迎接这场挑战。",
      "source_fingerprint": "cf3ca21fbdc6c97d7f0d0b785576c4c94c507656cc67ca67f4e42ff5b440adad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:57f2a1540935a952cff02f00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果出了什么事呢？",
      "source_fingerprint": "47a49dff6073d75e0c1e6df23606e200f767bb597ba264d8aeea95364a7cfb22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:ea7122ec9eae1c0bc80b360d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……总之先验证一下吧）",
      "source_fingerprint": "5054c24dab58d1fd87affb44e2cd5b9a5c22bc4ba88d9ff9ac13bc14ef4d903d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        49,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/49/choice_data_list/0"
    },
    {
      "uid": "zhcn:9042fc9a2817167bd00a501d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道自己想太多了，\n但脑海中总是浮现不好的事。",
      "source_fingerprint": "7a7e3b6ee1d8727b5f4aee28d234b3a80a452d6deb2d0aa82f061d5d8716204d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:7b078530a0276e28d1054d0c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇敢之心",
      "source_fingerprint": "9a26c04a8af8557f331ed7076671e2fce274ed0afd52fdd6e88b73fe92f7c8e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        5,
        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:175008a671b3cfc2502e1b2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真亏你想得出\n这么惊人的事呢。",
      "source_fingerprint": "745e97eefe90e5c0d3ff9e5ada5238799e0f0b63a0e814551ec07afb66a18561",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:2fb1288e1ffbedc74c115782",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所有伤病都会从轻症时的逞强开始加重。\n复发这个词大概在不知不觉间\n放大了我的不安。",
      "source_fingerprint": "413d5d8e040c755ca52279c4fadd9608977ed7e1212131e12aefe93be3868e9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:40f8b3e077895840669b5c9d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我翻出至今积累的数据\n与为海外挑战收集的资料，\n还有所有专业书籍。",
      "source_fingerprint": "b4cf9907cc7300fad173025d6b247f595ee5ac112c5df3920edcc06af0941a4a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:79f669f631c8aca7fcd46970",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "过去是否有类似的先例――\n有没有能减轻负担的跑姿――\n怎样的护理方式更适合她的腿――",
      "source_fingerprint": "b10543019f01fc136d61fbd735e3ff04f188bfc703aaf79a01e509133ce31072",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:50cae50c51bd49c536d291b4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "复发伤演变为慢性的过程――\n当地草皮的柔软度对腿的负荷――\n过去，因比赛受伤而引退的赛马娘――",
      "source_fingerprint": "d4dd9a7acbb90c1d470a54366037a1bf1f1ccfb68b70e66a872175377e909180",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:8c34b7470d18a545312481cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "积累的数据在调查时派上了用场。",
      "source_fingerprint": "1e0ca8870c6925b2d806838d47d57500278fdf10b14bc5fbf6afcf58da704490",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:259dcc5247e26a69660d63c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（会不会恶化，不知道）",
      "source_fingerprint": "8a57da71ce4d17d0e86061fcb2f24405ce3bbe06be433d4ddb8d9e2cd3f5f847",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        55,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/55/choice_data_list/0"
    },
    {
      "uid": "zhcn:3b2a57d73ca567143061c57c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是，我仍找不到答案。",
      "source_fingerprint": "618d69221fcf63555a53491aee3862082f156ee4d4ca74846f7fe6b5a6062257",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:5bf92dbd2b4996faf7bf6526",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她赴美，参加了比赛。\n漂亮地拿下胜利，摘得桂冠。\n此后的赛跑生涯也顺利延续。",
      "source_fingerprint": "a5e73c4d21ae1617a5e13fe856e7188caace289ba9e6fb5ffd15116d87ee7147",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        56,
        "text"
      ],
      "json_pointer": "/text_block_list/56/text"
    },
    {
      "uid": "zhcn:bd16ac45595cf5ee8b0007dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这种未来完全有可能实现。\n我由衷渴望看到她做到。",
      "source_fingerprint": "8596fa0ff971c73d58fc93af97bf884ea683966f959dd49b2c57e21f2abe33dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
      "json_path": [
        "text_block_list",
        57,
        "text"
      ],
      "json_pointer": "/text_block_list/57/text"
    },
    {
      "uid": "zhcn:5c7bdfdecf3b9a314f32230b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（身为训练员，应该阻止她）",
      "source_fingerprint": "b392163bbbe9fbc89d3f4535fd817bebacd9de7aa3dc8fd3610432d6ab380117",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110116.json",
