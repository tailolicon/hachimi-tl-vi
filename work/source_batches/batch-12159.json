    },
    {
      "uid": "zhcn:4165c0d25b18b9a9acb140be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，即使如此――",
      "source_fingerprint": "7a612118e3e6b949e7a3b655f4587b9f282c8b22e26fa83b62f44b72ccd9026a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
