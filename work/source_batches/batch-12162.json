      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:9f947494421d18bf4c75349b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "后冠赛马娘A",
      "source_fingerprint": "0e608a9db0a272363d872cde6c48df5fc1d7a6a5c5aed23474ecb309fec2dcda",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110118.json",
      "json_path": [
