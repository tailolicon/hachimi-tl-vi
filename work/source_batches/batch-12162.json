      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呀～～～！西沙里奥同学！\n请收下这个！",
      "source_fingerprint": "13166f705716c7eb8d7c5e43a7a91cec46fe544bddedd07869f035cbece10776",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
