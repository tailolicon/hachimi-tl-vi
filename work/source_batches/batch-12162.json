    },
    {
      "uid": "zhcn:4a27fde48087c7676f825964",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈、哈、哈……！\n……啊！还差得远！",
      "source_fingerprint": "f22e54f6d6d2231811967d34056725811b654e810e64400add61cb1e27551e83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110118.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:6909542745fc01fb25c18020",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110118.json",
