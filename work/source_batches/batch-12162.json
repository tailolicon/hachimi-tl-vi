    },
    {
      "uid": "zhcn:7b77846f3ff2495792936da5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个，我的目标，\n是在后冠路线的GⅠ中获胜……！\n请对我说一句，加油吧！",
      "source_fingerprint": "b347db8f25b3f9bab884705096c0152a0ab2017c99b7cec47508e84eccfd1bd7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110118.json",
      "json_path": [
