    {
      "uid": "zhcn:6cc6beceacf11c7140787d98",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天正是，堪称揭幕战的出道战！",
      "source_fingerprint": "96e7cad5e1ab6b6531055ee797a900e5cd8240c145225411527631b0111782b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
