      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我告诉她我们彼此相伴一同努力。\n话音落下后――",
      "source_fingerprint": "c6d8a234ff548f919d80de76c7fd1e2ef1bf3dc6163a2b49185fea452d54a4dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
