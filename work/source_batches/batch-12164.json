    },
    {
      "uid": "zhcn:6045258974e7c9890ac85e43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样啊……！\n举止完全看不出紧张，不愧是您！",
      "source_fingerprint": "e726de555a8f80a434265c8c0f4aa55dc762ae9970029e423a852bd97eda2418",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
