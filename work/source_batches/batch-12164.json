    },
    {
      "uid": "zhcn:9a63de22bf277fe69976bcfb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "非常好。这是久违的目标赛，\n我正适度地兴奋着。",
      "source_fingerprint": "a21d3e1721a85c67fd3fe80677108cfc6ea034a2a6515e036c6207011832f068",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
