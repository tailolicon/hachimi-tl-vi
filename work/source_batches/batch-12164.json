    {
      "uid": "zhcn:ecf37b07d6a0c013c684a130",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！\n谢谢您！",
      "source_fingerprint": "9cca6f6f6f7cd6d9fe59df77bca422efb3db9923af10df7134d71456e79ee25f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110201.json",
