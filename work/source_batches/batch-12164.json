      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:c66f770e49f66ed0cc7ee8d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在逐步了解西沙里奥的过程中，\n或许不知不觉，\n我的观察力也得到了锻炼！",
      "source_fingerprint": "3e13eb62e5ea39982892f5fb1f01afc65f742781e2e6e938b8385b84f1e069be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110201.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:7bf6fd8288de8a118bf5dc21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好嘞！",
      "source_fingerprint": "5b8624abed948d0e6a84b94335e1037decef0acf48c44155fdd86e0f5fcff33b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110201.json",
