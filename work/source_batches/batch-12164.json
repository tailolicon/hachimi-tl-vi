        "name"
      ],
      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:45466d0830a65e6ff84d1bdc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "直说吧！\n今天的状态如何？",
