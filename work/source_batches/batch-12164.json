      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，和我期待的反应有点不一样。",
      "source_fingerprint": "9a3c8850d12b336155e0eaf080522dad4227862b24b34d71311cba2b6d803cde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
