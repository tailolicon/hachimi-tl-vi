      "source_fingerprint": "0cc0478397dddaf29860878e611e32a8803c3deb73f318f6dbdfb06a653d53cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110207.json",
      "json_path": [
        "text_block_list",
