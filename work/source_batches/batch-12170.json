      "source_text": "嗯……。\n――Come in!",
      "source_fingerprint": "cb82d47742a60345cbb3b6e995dab2b52100221218b26abe601c6de999239f60",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
