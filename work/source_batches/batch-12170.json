      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从近期战绩来看，\n最该提防的是救世主同学。",
      "source_fingerprint": "65d032a551bde70bf721f3a3b1870a3001edf9bd7d6d75e58b5f67fedba1f88e",
