      "uid": "zhcn:4f7af53f136b6198af13ecd7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "简直像节日一样！",
      "source_fingerprint": "73a069caeaff687b47b1260b0496a4a452fc1e2b77c3731d28577fb05a08fa19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110207.json",
      "json_path": [
