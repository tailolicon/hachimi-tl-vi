      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "承载着托付给她的梦想，\n迎来的『伊丽莎白女王杯』――",
      "source_fingerprint": "079bb565a9b239714660d6f2802c53096b7e235cdbc0500134a37bcb31eea782",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110207.json",
      "json_path": [
