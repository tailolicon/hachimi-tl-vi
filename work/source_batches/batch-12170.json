      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，明白了！",
      "source_fingerprint": "097a05a4c764345ed33fd14a87b28f3024ce4a6d3a8783f87b77f184deec584f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
