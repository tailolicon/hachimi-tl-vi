      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为我想把“我”的光芒，\n最先展现给大家！",
      "source_fingerprint": "1a97b2c67b519368a268f06d5bcef5061d10cd253b1f3e4815d6bf5a42666835",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
