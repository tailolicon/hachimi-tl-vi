      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迈向维多利亚英里赛",
      "source_fingerprint": "2779f50cbb97857a3db02c3a810160dfd568e12d8c70a2e2271f440a1f53484d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
