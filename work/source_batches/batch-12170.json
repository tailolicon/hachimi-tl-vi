      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了获得应得之物。\n『维多利亚英里赛』开始了――！",
      "source_fingerprint": "6b82367ff134280be30ac72feb6a762610282fc8e473eec4672055c46dbd71b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
