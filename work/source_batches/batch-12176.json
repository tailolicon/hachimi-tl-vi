    },
    {
      "uid": "zhcn:aecbb9046d1a977dee3cf6f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没问题哦！",
      "source_fingerprint": "54e0d2e0faf608afb292c29cc8d38e3a3ff5f9a74685c5ed7f8da47959548335",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110303.json",
