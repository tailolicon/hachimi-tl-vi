    },
    {
      "uid": "zhcn:29d53e2bbece46ada4b5985c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她是着眼于『橡树大赛』，所以\n想要，挑战这个距离吧。",
      "source_fingerprint": "6988abda9399166da09877238e7b8e98f98158135585db43246b55ada1a70713",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
