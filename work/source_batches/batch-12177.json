    },
    {
      "uid": "zhcn:38547bacab3ac9718914c326",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――若要用一个词形容初登赛场的西沙里奥“\n”初露锋芒！再合适不过！",
      "source_fingerprint": "771b29248a2313c1c995b4985261316a960ec1b242fdf3da500cee5075c45825",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
