    {
      "uid": "zhcn:c54a5ce40de53d3256fc9e26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――向着一年后的『百花杯』，\n需要完成的事，还有很多。",
      "source_fingerprint": "e4d666db89f788df6af3d04aee6d07709e480e4157291ee13f36f6663d7798d2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
