        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:d7baab697c2c1664bf850789",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一场目标比赛是『百花杯』。\n我已经，不想再做一个只会重复\n“精彩”的训练员……！",
      "source_fingerprint": "045ac5a87d30b1ddf1a3a8fc0f6fbaf72e57740c9e6d2e133741e69e6d97230d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110303.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:be2c5d5c6153d63ebd4c95a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "辛苦了，西沙里奥！",
      "source_fingerprint": "b2e16f347c54d604538dded2bc4689fa16b370f2eae165011466d9bb8a642a67",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
