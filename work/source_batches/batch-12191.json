      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『维多利亚英里赛』，\n是资深级的GⅠ赛事。\n自然备受世人瞩目。",
      "source_fingerprint": "3b4ddb8c1abb074ee3c761fb252e5d351d62f70337bdd9e986ff58781b112b82",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110315.json",
      "json_path": [
