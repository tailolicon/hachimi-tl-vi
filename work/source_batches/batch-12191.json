      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那正是西沙里奥在这个夏天遗落的东西。",
      "source_fingerprint": "a5f9727b3f137d55ea43df489294c3d909d5ad6706ad20211638a2f76262b032",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
