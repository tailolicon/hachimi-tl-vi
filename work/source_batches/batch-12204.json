    },
    {
      "uid": "zhcn:d6fe3ca83b31707cdf452854",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。\n因为穿上胜负服时，我就是战斗者。",
      "source_fingerprint": "9e8739d7a2315e74420a4a35567b29a0081e690f076e13b9c3b69ddb770a334c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
