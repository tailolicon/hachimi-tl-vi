    },
    {
      "uid": "zhcn:a412dc5daa83543951e9d254",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『但是，我知道。\n女人对男人怀抱的爱，\n究竟能深至何处――』",
      "source_fingerprint": "67fb7bce42b08c9888c42782ba6533690067c602447fa4d3d898161fc6b9d956",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
