      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。似乎是出了差错才通知得晚",
      "source_fingerprint": "0baf92fd7e77b417452bf241f7021592b0be45fc8b06728c5591b5d061d9fdbe",
