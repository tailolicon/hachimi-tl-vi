    {
      "uid": "zhcn:23908a71ea6346e41bcf061f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就是这个，就是这个！\n咦，训练员也喜欢吗……？",
      "source_fingerprint": "e3410b7e7af3ff2e84fea37e08fb9d421b0639a9f1e47737de7afde9db6a5fcb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
