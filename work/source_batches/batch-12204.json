      "source_language": "zh-CN",
      "source_text": "就是这个……您看能用吗？",
      "source_fingerprint": "d7f90ecf1585c6ab9fd3a929e1e582b9ef8c58fa7abe0866bc2a90332d680888",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
