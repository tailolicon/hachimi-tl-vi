        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:13c4709e411f85c86124ec70",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我知道她喜欢喜剧，\n却没想到连最喜欢的剧目也相同。\n发现意外的共同点后，我们相视而笑。",
      "source_fingerprint": "058fd4a84efc45bb7d8cb375b0a62d24f6f1668b9b0c530fbdcdd9230a5edf88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:bc8c233bea95d3bf661e9d48",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
