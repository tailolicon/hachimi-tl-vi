      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她将动摇的少女心深藏心底，\n以男性的身份完成了被赋予的使命。",
      "source_fingerprint": "9abca82b7c3178073285455d686d387787a2455783cfc0a57cd7c4dd4adcea57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
