    },
    {
      "uid": "zhcn:61d733b0bf8bba1eaa138151",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为书来读氛围又不一样！\n呵呵，作为读物也很不错呢。\n文字实在优美！",
      "source_fingerprint": "87b755c9d40ffff566623d546d5e710352c87d62e6be877a2cabb8dc35b24fd9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:d7511a30b7d9558fe9941ad3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥兴致勃勃地\n翻阅着书页。",
      "source_fingerprint": "dd3a7d9d8189bbf645eddcf0e8c2b912112ab8c76f38a451ae7910611d12c85a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:54f51c2232d608c7c1c13d01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在某一页停下手，\n指向女主角的一句台词。",
      "source_fingerprint": "9cad7b68e8117fd9f6e0cd131ea256fccc303932adbec90f8bceb07819ad797d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
