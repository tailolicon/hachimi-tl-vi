    {
      "uid": "zhcn:4e6c312f218a47937cb9a959",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是爱慕公爵的女主角，\n借隐喻传达自己心意的台词。",
      "source_fingerprint": "5fc162752dd49c11ed1d189559ed1280b84c4be2d5978f8f3d10a93633aabdf3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:7a41f16da404dfc47fa211d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
