        "name"
      ],
      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:566a1753bf3e1ba9582e8791",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "佩剑，行礼，改变走路方式，举止，\n演得毫无疑点，完美无缺。",
      "source_fingerprint": "efa9e680340bc2f43f2709ac0aff5a190823ae01acc712d71a47fd09d84e8c5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:939a6bb402e68270dfed131d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:8a27dd1df394e222fed187cd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也想像她那样坚强。\n因为通往『基石』的道路，\n想必会十分艰险。",
      "source_fingerprint": "1ed725f27f381991efe40542028dd33d402c49957b37a562abd220cf73f7f410",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:05535adffc199a9e38b90ef3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:63b8a7f1f87e7d7f4b1e036f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这身胜负服会让我敏锐地切换到，ON“状态”\n正因如此。我才能战斗、前进、跨越阻碍。",
      "source_fingerprint": "d846a2388307e88d09434cdc209f70b74d6add91c50d6d5b32853e43822936c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:ef930d00f732ec7fe5745f93",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的心脏开始怦怦作响。\n那份悸动与选拔赛上初次见到她时相同，\n甚至令灵魂也为之震颤。",
      "source_fingerprint": "aaa010aa95cf5013cbd707525b2b40ea01021da1cb20ea38edade559893df388",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:d7b4b8499efbf64f1a13495b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她描绘的宏伟愿景让我看见了梦想。\n她那堂堂正正的身姿也令我移不开目光。",
      "source_fingerprint": "d92d0a63831af366f72c42ea7a578c90301bb9894c9dd977fb4d5b11df92006f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:27c05ea5f95f88469a6ced37",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好好展现出身为『基石』的器量吧",
      "source_fingerprint": "2369697115a53c1de9f6992cf4eaa1a6343c155ae66e53c41ffe02ed2d84ec19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        36,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/36/choice_data_list/0"
    },
    {
      "uid": "zhcn:137bac755c0b5e8883431280",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一场接一场，扎实地战斗下去吧",
      "source_fingerprint": "6be5bc68241bdf67310d280d91907d417b42dd7dd508b9b0367b40ea158bd1d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        36,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/36/choice_data_list/1"
    },
    {
      "uid": "zhcn:1aad4b9fdca0bd7e3f6ac485",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想支持她、实现梦想、走在同一条道路上。\n如今又添了一份『想与她并肩战斗』的愿望，\n令我的胸膛炽热起来――",
      "source_fingerprint": "aab0b78648aec09240f9a01d2350e59545885925dc5ef36b62198a0cf62fe925",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:8db990baf58fe23e929bcac8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
