    },
    {
      "uid": "zhcn:07011d23dce20b072d5bf269",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。这也是我爱读的书之一",
      "source_fingerprint": "14472c7003058fce1c0943bd7c1bed9bc585400861225737d54c6c3c373ba25e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
