    {
      "uid": "zhcn:93b684851a8885af7a338220",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇，真让人惊讶！\n我们，喜欢的是同一本呢♪",
      "source_fingerprint": "10279511c56dce77bcd8df26863eecf8df34e7d4e7429ba675440fd9a888e7fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
