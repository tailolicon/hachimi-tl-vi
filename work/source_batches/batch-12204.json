      "json_pointer": "/text_block_list/30/name"
    },
    {
      "uid": "zhcn:f7b4a7e3921da2a788bd4b8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若能索性表明真实身份就好了――\n但她依然继续扮演着自己的角色。",
      "source_fingerprint": "dd7d35cd7dd11052b7d9b8ec24c1bdd1da679be8c7c853b260f85c69be7abfb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:addef442ced49d72093defde",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥",
      "source_fingerprint": "7b7ea8f429e376dcab41bee5b946ee4fb9dc8e928a406a356926b617ad6aaffb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
