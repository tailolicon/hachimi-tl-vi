    },
    {
      "uid": "zhcn:49c0eaf71cf0e4a14900a997",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以才是“战斗者”啊",
      "source_fingerprint": "883e737d83455412ed65b39ccc40bc628cfc29514e7747c5c1738911e395999f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
