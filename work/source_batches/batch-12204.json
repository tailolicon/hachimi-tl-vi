    {
      "uid": "zhcn:2d951f1b46892d0f9bd00b95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『我也想成为那样帅气的赛马娘』\n……我还记得，年幼的自己曾如此强烈地期盼。",
      "source_fingerprint": "80f46107e4931255593d4cacc4c6c5cfac66fe0737e3652c547419a5b0a04b86",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
        18,
        "text"
      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:e4998049f369b197698676d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以才是“战斗者”吗",
      "source_fingerprint": "1f5926df2aa049edbef2c5db7aad929fec3f5e2aa0053f41024d1836f5d76beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
      "json_path": [
        "text_block_list",
