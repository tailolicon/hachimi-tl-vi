      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不错。誊清后提交吧",
      "source_fingerprint": "bafe605a0793a969151a6e19a56d7b66a21f8138764db377bafa25602d606f8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110513.json",
