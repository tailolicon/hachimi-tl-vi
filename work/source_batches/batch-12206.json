    {
      "uid": "zhcn:d5cc1556e647b46a0a75eb11",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我去那边摊位买点冰凉的东西，\n训练员请坐在长椅上休息。",
      "source_fingerprint": "3901f15eaa32fc415f0dbe6cce96f5a0382944010dd209a48099cd2ffa9e2481",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
