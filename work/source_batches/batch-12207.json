    {
      "uid": "zhcn:11f1f888dbe32a11c3543319",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但愿，有一天这份力量\n也能推动我将指导的赛马娘前进――",
      "source_fingerprint": "5e1355a7688179a5f8adccc304311ae6458f8d527da2854ebf44543962f8ebb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110515.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
