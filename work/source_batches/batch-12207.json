      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:e121cd7d7f5aef372cab6d40",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "怎么会。这是个非常美好的愿望！",
      "source_fingerprint": "71f4a76fa27d80b4964ea880a0fd4fd1becd7176144147a10915c23556ed88ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
