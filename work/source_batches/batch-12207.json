      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。\n我会和珍视的朋友一起，\n留下更多珍贵的回忆。",
      "source_fingerprint": "9714ae8849529e14934013c0d34291e6635fc25e66f91d7a1caef86ccfc35af4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
