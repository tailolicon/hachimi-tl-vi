      "source_language": "zh-CN",
      "source_text": "啊，不如制定一条新规矩吧？\n每次去远征时，\n都买一件纪念品！",
      "source_fingerprint": "4e5a8e9df950473a80a83e73d55eef246adce9d8363d700aad76f6650d91cb52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
