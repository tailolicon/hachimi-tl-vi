    {
      "uid": "zhcn:eb5fa58f0133fc23547b120d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "妈妈又寄来了胡萝卜。\n所以作为上次的回礼，\n请让我做点什么招待你们吧！",
      "source_fingerprint": "7a10015291d52785ae00fa635a463b33ce2aaedc284df24466d43606b1e9eec2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
