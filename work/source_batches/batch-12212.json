    },
    {
      "uid": "zhcn:e4dcd46e072ef483e9f1a169",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "躺下来的西沙里奥仰望着天花板，\n脸上浮现出发自内心的幸福笑容。",
      "source_fingerprint": "293dc392bb60a3841201e414b6776dc2b8c21a4542c53ba78691cd8cf05d7df1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
