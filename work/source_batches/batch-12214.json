    {
      "uid": "zhcn:058107a49b878f2e6dc5bbec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我得继续努力，争取让大家把我当作\n引导后辈的指导者，平等地对待才行！",
      "source_fingerprint": "ad070185ee13213a691b6d276c965af33ee96e62fe6cd70478df00f3fcb85c59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
