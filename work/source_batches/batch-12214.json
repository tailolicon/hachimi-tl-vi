        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:7671e2b4c5cb6fab72dc20bd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，我们要做的是――",
