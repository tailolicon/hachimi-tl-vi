      "uid": "zhcn:d86c4bbfe2c4c03cf4dceb31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――原来如此，今天的主题是\n『为自家孩子制作运动员角色便当』吗。",
      "source_fingerprint": "1f87baff7acebce7ed9626e0e7315d9126b1fc30f27e9a735ad8f0cc7528ca7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110702.json",
      "json_path": [
