      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真是的……！\n大人，太狡猾了。",
      "source_fingerprint": "29d73fcd67dc35e3dd500b6c096222c8d93b88a237a0eff09fe12f3aead56264",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
