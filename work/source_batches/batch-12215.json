      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那也许，只是平凡日常中的一幕。",
      "source_fingerprint": "ffe9b92e03d66391e311f2410115039964dbb742ee3d8a3949e537ebd0fdd5fd",
