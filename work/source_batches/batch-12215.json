      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也可能是与对手们互相竞争的瞬间。",
      "source_fingerprint": "521327b5648f500934f0fb77fe60e1b20a7c6dec375360508fab2f79479cf466",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
