    },
    {
      "uid": "zhcn:9f69541ea414840c45aa9e20",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是西沙里奥今后将会经历的，\n一段段美好时光的积累――我这样告诉她。",
      "source_fingerprint": "435a9e4ada3bbc58a952ef552c898584beba6965ad9361f4b71db02bd5dc0617",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110703.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
