      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。训练员的话，\n肯定不会下让人为难的命令。",
      "source_fingerprint": "58d1e4ae9dc9b68d14433b8b1b5995e4083a2a47736eab3e5d31b9eb875414be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
