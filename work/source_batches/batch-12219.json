      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "国王可以向没有吃到费弗的人\n下达命令。",
      "source_fingerprint": "e30b8a6aac5bacbc27b13532064bb319201bd1e55994efd70dbd1e15a4562aeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
