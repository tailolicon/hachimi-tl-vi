        40,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/40/choice_data_list/0"
    },
    {
      "uid": "zhcn:dcb68749f528b1b92e792bed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这种事有种朴素的乐趣呢！",
