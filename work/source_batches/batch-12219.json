        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:7042798b602ecba2e361c2dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们围着手机，商量要看哪出戏。\n心仪场次的票还没有售罄，\n于是当场完成了预约。",
      "source_fingerprint": "7339a4086cfe7766fd586b3c8dd138b7f895418f23055e912c5c299fe163686c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
