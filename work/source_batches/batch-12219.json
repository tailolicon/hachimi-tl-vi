    },
    {
      "uid": "zhcn:1f356728a3340c2a21e30316",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那家店可以买到费弗吗？",
      "source_fingerprint": "36fa2f49eb1a0a53a9af45f809b3b5ba5b951660c86e81856c6a8531aa807c0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
