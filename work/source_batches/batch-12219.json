      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喜剧……这不是我的爱好嘛。\n这样的命令真的可以吗？",
      "source_fingerprint": "25b38968fcead44bc11de230ce811850afe5fc3cfb7790d51a31ecc8ab167a36",
