      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那家店能买到费弗吗？",
      "source_fingerprint": "99baebec86110c7e6b59c0402cf072fe892c9976143b4848815bc5780108d0fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
