    {
      "uid": "zhcn:076c72d6682efda1b4bf133a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……真有训练员的风格呢。\n已经决定看哪一出了吗？\n如果愿意我可以推荐一家剧团。",
      "source_fingerprint": "f4378667d7395a360c9d199bdd09e3ff895166d1a6af3b8bff5eaa1505201622",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110706.json",
      "json_path": [
