    },
    {
      "uid": "zhcn:e269cbb21d19d303b1e1df86",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是只有一个又太孤单，\n于是我攒下零花钱逐渐为它找来伙伴――",
      "source_fingerprint": "1fbe78a8a45f99811f19017cc4ea0b6cfa8498e3684a58ac09f8b04ac5fcade2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
