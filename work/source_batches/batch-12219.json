    {
      "uid": "zhcn:f32942c63b0ebe3c12dd71ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个……这枚费弗，\n真的可以送给我吗？\n明明是训练员抽中的。",
      "source_fingerprint": "7e9f64017f9dd6b19535a73192f4b8977fe8d187396a2d33e78d5dd94eb8efeb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110706.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:457a1851a08647c8e7dbd51f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为一起看会更开心",
      "source_fingerprint": "4ff4ad7fdc545c50d4a47188fed730b4ec9beb66395c54d2a96bab9a6dca004c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110706.json",
