    },
    {
      "uid": "zhcn:120d50e5816ff0a93db234c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这种事有种朴素的乐趣呢！",
      "source_fingerprint": "64bf35d58f8edad3939dc915302205381f5cb4260d4371ecec0b1e6b2196b488",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110706.json",
      "json_path": [
