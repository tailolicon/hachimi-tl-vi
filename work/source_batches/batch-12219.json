    },
    {
      "uid": "zhcn:784d5c23c225508cc9b3c1d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥打开话匣子后就停不下来，\n直到返回学园\n我们都度过了一段愉快的时光。",
      "source_fingerprint": "6a568091d029b0a6a8a8ebafc947c32f7bcd52998cc32327450dc3ca304bcc12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110706.json",
