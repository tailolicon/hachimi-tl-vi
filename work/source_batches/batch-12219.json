        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:e3db1448d4c188de0599698a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然。把它加入你的收藏吧",
      "source_fingerprint": "e768495dc283a888ef30599f6070b0cc46b99f84aba3c7165223c117dcaff4ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
