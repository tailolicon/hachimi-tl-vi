    {
      "uid": "zhcn:0fae2f1fab7ddb8e6d8034aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为此。我想积累成绩与经验，\n这就是我现在的愿望。",
      "source_fingerprint": "eaba73bcc01e0c47ed8485ea9708b7ca6254cac39ba218572fadec25a4206ce9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1110/storytimeline_501110707.json",
      "json_path": [
