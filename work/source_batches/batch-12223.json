      "source_language": "zh-CN",
      "source_text": "按照医院的指导节奏，\n就能把恶化的风险降到最低。",
      "source_fingerprint": "6f2b92154e8d1b382c286d0d422f60605497ed2fa945acfb6a9b7aad38eafab4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
