    {
      "uid": "zhcn:6979e86bccc0e21acd181d83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我是以将来成为指导者为目标的人，\n不会做那种莽撞的事。",
      "source_fingerprint": "3b30341ea335a73fe8a25ca3ba762d3d8399086bcdc18ad77fbd5fba8c05b4e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
