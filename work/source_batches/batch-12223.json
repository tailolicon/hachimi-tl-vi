      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……训练员，\n我有事想恳求您。",
      "source_fingerprint": "4088c5b2fcc81e9f80d62bae909a429b6f59e7edb3d269af419555a4dd6279c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
