    {
      "uid": "zhcn:c6a018c3cc591bd35e4cf557",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "照这个势头，首先便能早日复出。\n还请您，再等一阵子。",
      "source_fingerprint": "79a96089798c08ce9626023075c16593d9a432b4dada4f29af485ace1ac0475a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
