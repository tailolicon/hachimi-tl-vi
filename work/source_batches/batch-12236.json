    {
      "uid": "zhcn:92d7d18d5bd84a1d35260673",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯……是啊。你总是\n愿意这么说，不过――",
      "source_fingerprint": "48ef97fe848ed762a37408af1a8c0186d85d294e5a72219e10cf6fb2382e365b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
