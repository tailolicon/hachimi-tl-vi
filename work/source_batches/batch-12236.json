    },
    {
      "uid": "zhcn:5e0cc788349f2a822fb617d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哪里。我所拥有的一切，\n都是从母亲大人那里得到的优势。",
      "source_fingerprint": "78494d464919c2c786ed4f65a310df1ce172e158fbdf67dbb19429d81c6cdb54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111100.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:4d2a3ab536bdd7713393a329",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
