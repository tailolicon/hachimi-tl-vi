      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "踏实、稳健。\n凭借不屈的意志不断努力。",
      "source_fingerprint": "eec8ec331736604f8059d1c88814b3dabe960e479bf9ff3138d33020f8c20b49",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
