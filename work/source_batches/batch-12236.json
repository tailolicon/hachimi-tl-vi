    {
      "uid": "zhcn:9c787a3761fa90a2a7682af3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向我展示这种理想的人，\n正是母亲大人。",
      "source_fingerprint": "96bc3a9878637aad50fe79818558183afb566a264c042b901a820b5dd9580fc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
