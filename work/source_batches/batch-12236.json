      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『空中救世主同学\n\n感谢你的日报。我已确认。』",
      "source_fingerprint": "23b461420320e871de61d9ba95486353738528071d2843fad9ab5016cb624b7d",
