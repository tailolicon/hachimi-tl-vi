    },
    {
      "uid": "zhcn:11c552780c3d77c5954725c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。上次教你的要点，\n你都做得非常好。\n跑姿变得很漂亮了呢，救世主。",
      "source_fingerprint": "ae4801aa5249e288291cabadc7454a39f3cc5f3813ca29781a6b7b5162945eb4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
