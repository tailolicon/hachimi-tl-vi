    },
    {
      "uid": "zhcn:b51d2d7fd900bae8aa89d587",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这里和母亲共度的时光，就是您的原点吧",
      "source_fingerprint": "81f526faa95faef118633ff73d23ba764057535706ce4caa5e4cf350471eaf8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
