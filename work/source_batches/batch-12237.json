      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跑出来了吗，\n像母亲大人一样？跑得很！漂亮……！",
      "source_fingerprint": "4b800d98360100fcb29c315580b1ad5d934fce426d7d3c95ffe37b6acfa956ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
