    {
      "uid": "zhcn:5b4c8c21293090ef4b57b4c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "幼年救世主",
      "source_fingerprint": "1e953f80daa0c42fb96c42d8904475710d6c812b88cad6b1904d940bf99211ea",
