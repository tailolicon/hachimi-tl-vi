    {
      "uid": "zhcn:5225bfb22fb94bece1fa8b87",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，我们郑重地互致问候，\n随后离开了空中救世主家。",
      "source_fingerprint": "8e21c91cb99d84fcdc8cfc4d7b2a11deaf446bab4351dd471069ae5f79138ab1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
