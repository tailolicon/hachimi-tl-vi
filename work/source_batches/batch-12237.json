    {
      "uid": "zhcn:a5c89cc406abcb98a29aaf62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "将那份意志，那份灵魂，\n一一亲手传递给每一个人。",
      "source_fingerprint": "e244150c11ae44e6dbb0122459426a41e70573cf74d7178f39bec06953d882ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
