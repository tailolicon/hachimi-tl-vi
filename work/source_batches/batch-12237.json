    {
      "uid": "zhcn:01c5dbc1a373c6fa22e40f18",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈啊、哈啊……！\n母、母亲大人，刚才怎么样……！？",
      "source_fingerprint": "729ee5fac754b251f22d9f0790fc298ccba50cbb5f5cf7fa24739db904a68a9a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
