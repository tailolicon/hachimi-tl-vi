      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:b961ec056913562e96531225",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确认成功发送后，我松了口气。\n……如今每当收到她的日报，我都会切实感到\n一天已经结束。",
      "source_fingerprint": "8d4ec1a1833497c8c7eafb4592d337e35b07ccd2a09debe638b1d1bd71b4ecfe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111100.json",
      "json_path": [
