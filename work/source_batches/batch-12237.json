    {
      "uid": "zhcn:23019d010b74ea360196d8d3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主显得非常害羞……\n可不知不觉间，我又仔细端详了起来。",
      "source_fingerprint": "af09c6ad520fc5af1f6dca5b2c4cdbd00be988b438eff57542c151cb8efc732c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111100.json",
      "json_path": [
        "text_block_list",
