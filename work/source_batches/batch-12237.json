      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您已经看过了吧，那篇报道。\n我……亲手写的报道。",
      "source_fingerprint": "68c0f2ee14022c48fdfcfa4a487e7868165666f764d263816f4e1f300c17e613",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
