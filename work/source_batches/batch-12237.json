      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "已、已经，可以了吧，\n训练员！",
      "source_fingerprint": "7450f710dd14326d2f43846243ee1b91d5a2aa0fcc5d6b665bf6e1510ae70cd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
