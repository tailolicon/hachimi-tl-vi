        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:59038e7f4d758f7aca157b4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这里和母亲共度的时光，就是你的原点吧",
      "source_fingerprint": "316094451f45b0862dd9196309b5a1bcd005d2c373c6a538b17828d1b6793488",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
