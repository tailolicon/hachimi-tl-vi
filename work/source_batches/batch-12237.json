    {
      "uid": "zhcn:9006680782e1d6319153e861",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她第一次说想看我的比赛……\n对了，应该是在我把当年的报道也拿给她看之后吧？",
      "source_fingerprint": "0d90bf3d0e31b305c373a13b9e484e0a13a6471a9679c73f4192d2ee32bd72ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
