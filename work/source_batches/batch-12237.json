      "source_language": "zh-CN",
      "source_text": "这里，就是我的起点。\n是我的憧憬。我的梦想。以及――",
      "source_fingerprint": "27b6b0b4a5e8295d630b5f1bea74a8581b8d03bf76eaece58a837d45ece39e67",
