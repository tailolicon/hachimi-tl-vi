    },
    {
      "uid": "zhcn:2be7bf31df00e156e64397d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今年也请多多指教",
      "source_fingerprint": "5087d84c36f225b4410f40b5f0e5e8e19149968ff2b756c06c36c31836bbcb0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
