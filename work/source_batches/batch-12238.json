    },
    {
      "uid": "zhcn:5bfa390c54f1b1d39b051aac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主登场！",
      "source_fingerprint": "99ca4e756f48bdbe813c421fd26b3661fa6da9886c9cd7e53929f65b13be1aca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
