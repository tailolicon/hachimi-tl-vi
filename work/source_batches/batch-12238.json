      ],
      "json_pointer": "/text_block_list/11/name"
    },
    {
      "uid": "zhcn:e7cdc4b0355202e434d8bd23",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，我以前，有说过这件事吗？\n神宫同学，从我很小的时候起\n就一直很照顾我。",
      "source_fingerprint": "db42ba38e05a29c8ef4c8ab899463fbde8f69cce6a194d2affe615fca2f14379",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
