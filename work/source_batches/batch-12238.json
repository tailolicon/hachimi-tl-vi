      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说是青梅竹马……或许有些夸张，\n但从入学前起，我就偶尔会见到她。",
      "source_fingerprint": "56db1fe94abb92e7741e9d644047d3a10080f816f37743f831a937b395f3982c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
