        "text"
      ],
      "json_pointer": "/text_block_list/93/text"
    },
    {
      "uid": "zhcn:7b3a821de160cfc8de929a88",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯。我们一起，一定要实现它",
      "source_fingerprint": "f0ccd7008d75900cea3ee599d32b7c75cf270eac57d480a31735535dd919ca32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
