    {
      "uid": "zhcn:5e8e7c5f339d5b2d6183a570",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新年快乐。\n今年也，请您多多指教。",
      "source_fingerprint": "46b5f2344bb7dc9a9b2a543a860c1318f4ebb4d50f2d767755a7cb0130947b11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
