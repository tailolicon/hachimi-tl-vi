      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "身为女儿的我，一定会赢。\n并且证明。",
      "source_fingerprint": "ad3ef8cbb6c3a82341185a5f87373c84a049332ffeccbdfcf8145cc98eb2e4bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
