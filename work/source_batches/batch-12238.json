    {
      "uid": "zhcn:964d6183bb6edf6d519e704c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "用我的双腿――一定会！",
      "source_fingerprint": "38ee519e7c119b34a9ffeb6ada36b57a9751b92fec8b4ad0127b1aae293b33de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
