    {
      "uid": "zhcn:ff0a2d63ee950e8c26e029a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "母亲绝不是一位只会留下『遗憾』的赛马娘。\n我要证明传承下来的血脉有多么尊贵，多么强大！",
      "source_fingerprint": "cf3c6d5dd6a8f91ecb9d625f1cfc5d2d4416c6c72990d4c87e896ccb964bf493",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111100.json",
      "json_path": [
        "text_block_list",
