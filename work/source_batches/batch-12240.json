    {
      "uid": "zhcn:8201f1c60aebaa5853faec1e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我，从小就很喜欢学习。\n不过，现在想来――",
      "source_fingerprint": "e45e50dcf7afb31f923cfb25238a6c08efb1d6903b21e6e740885b58a155424f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
