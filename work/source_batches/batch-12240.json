    {
      "uid": "zhcn:3c04a55169d9e0ae04694101",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我之所以向往聪慧，或许正是从那时开始的……\n如今，我也会，偶尔这样想。",
      "source_fingerprint": "e52abfa2efd08f8b1618931858866760fedb3250131963e7031d5b3d210f5a30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111101.json",
      "json_path": [
        "text_block_list",
        72,
        "text"
      ],
      "json_pointer": "/text_block_list/72/text"
    },
    {
      "uid": "zhcn:403c228bf1f56281453ac332",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
