      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:d8b5be7f29b2fb86467ac812",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我深深点头。仔细想来，的确总是在夏天。\n与空中救世主相遇也好，\n与她结下深厚的羁绊也好――",
      "source_fingerprint": "b4704c01acfad2a9a979ca3b0566532e040af8a216496ec108262a06aa4e5397",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111105.json",
      "json_path": [
