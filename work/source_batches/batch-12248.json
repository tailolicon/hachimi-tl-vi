        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:74c86f065bccc480034915b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『只求胜利』。\n这句话沉沉回响，令我心头一紧。",
      "source_fingerprint": "dbff32fcc4f9dfffc61e06fff739c7f50cce6d0812bf2afa0de80496ed3732b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111105.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:b386b9b7dad8689dd3e1d9c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……还有，从她口中听到\n那个重要的『答案』也是如此。",
      "source_fingerprint": "4e162f37028f39999cc74a1af54e381f10ac6f6976cb4fdb8697074d96dafbc8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111105.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:788c1de055ecfa09c9b972b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊――原来如此。\n她、她们，一直以来都――",
      "source_fingerprint": "d2b903b1b6e88d463d1ad4b7063f5eab8551c7abda5e9a93b6e387776e18a335",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111105.json",
      "json_path": [
