    },
    {
      "uid": "zhcn:fbdfdee81d59d8c863c06701",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的尾巴随夏日微风摇曳，\n我目送着她跑远。",
      "source_fingerprint": "193cddc73c3b763106f4c282ea1dce7d4f5a9317e29625fe9b6510fd1585cb39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
