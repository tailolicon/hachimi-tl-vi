    },
    {
      "uid": "zhcn:48926e4d995c72a6786ce877",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯独那一刻，\n她少有地露出促狭的神情并微微眯起眼睛。",
      "source_fingerprint": "7624a95a4ae2bebfc279a3328dd7b3d4af8b52683ad6de6cc8bb21d2fbec924e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
