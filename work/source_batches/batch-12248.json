    },
    {
      "uid": "zhcn:5bd3c44f89d75931d157d5fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不由得望向她。\n彼此的视线正好撞在一起。",
      "source_fingerprint": "b1b20950af2a5ffc43997252abc4be39f5edc4a3102cedc8684c9718a689bc18",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
