      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对我而言――\n那，才是最大的转折点。",
      "source_fingerprint": "5f62b55a8ba7e69b0f125c9f4e6832a976f16c80950978723ee5c48923b3b4c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
