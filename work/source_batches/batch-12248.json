    },
    {
      "uid": "zhcn:c4f04c39b580847525ceffec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我笨拙地寻找着措辞。\n即便如此，仍竭尽所能地向她说明。",
      "source_fingerprint": "f4afa11303dcf7b090afc1c885c715839273158797226b944875eb36b341ce00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
