      "uid": "zhcn:caf983cbd599e5c3040815c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嘿嘿……那么，当天见。\n告辞了！",
      "source_fingerprint": "bb901525211456505421b732e02e9eaf07f166c40342da79b163ac74f188c92c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
