        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:0046c934dbfe17751189db83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么，我们再梳理一遍步骤吧。\n尽量错开烤箱的使用时间，\n安排得更有效率一些。",
      "source_fingerprint": "2bd521a61fdba4316b53a7d314fd9eea3916f1039d566da75df17b5a8520f88e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111107.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:ef8827a2dc676b61f236c17f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "情人节即将到来的某一天，\n我一边纳闷，一边走在走廊上。\n……没想到，刚才那已经是第7个人了。",
      "source_fingerprint": "df9257feb63c95981d8b25bc64d8d3eafd567304ba64b0c5a9cd352c91679618",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111107.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:d41ef918ac27ec556e149fe5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（大家都会聊到情人节……）",
      "source_fingerprint": "708326d5d3db1faa3d63bdc024d10f1f09d3313753fd213f7cb1ed78e8bc2a3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111107.json",
      "json_path": [
        "text_block_list",
        51,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/51/choice_data_list/0"
    },
    {
      "uid": "zhcn:c5b579fb2e72d98d744d1973",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有时是在训练员休息室。有时是在走廊。\n中央广场，训练场也一样。\n最近，我总会在各处被人叫住――",
      "source_fingerprint": "2e4a06c80a1b5615b9ddc4b2a1d55702f96c9fefa709850d3f8ccf9e1e7134ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111107.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:9830857e1ab3328f89fd0dec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我甚至想过，难道是『发生了什么误会\n让大家以为我是个特别爱吃点心的人？』\n不过看来，似乎并非如此。",
      "source_fingerprint": "435376825b2b8f476cf5ccfa84f876dd3396c10b151f2646312455b24297be7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111107.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:b868ed22d728664720e2e761",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "简单说――我，似乎正受到瞩目。",
      "source_fingerprint": "6337e3ec1424a7f97d036d4b6cbbb73de401c9d7d28d4a289987f26deb54af79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
