    },
    {
      "uid": "zhcn:d421f959006015cbf8a4a745",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（人还真是会变啊……）",
      "source_fingerprint": "11b79b4cf8bc0f0cd02e651e1c0f079121ee537671dcf0cdf9f18fe8046e0098",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
