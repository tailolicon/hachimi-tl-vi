      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:c4b188d9080e5550314a3bdb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "平时到了最后，我只能祈祷，只能守望\n……而这次，我却能直接为她的胜利出力。\n这，难道不是一次难得的机会吗？",
      "source_fingerprint": "fc5aece04e30ba747572b855248d2868381c00435ddf7f82b1ca6db07f81eaf2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111108.json",
      "json_path": [
        "text_block_list",
