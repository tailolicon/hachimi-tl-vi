        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:7b941a1951ce048e3fbb82cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我……会努力的！比赛，参加吧！",
      "source_fingerprint": "c1523948b65a76fa87d4a5f6102b387b2d0d6ce8b1eb155f0cd42ad7eb3bc068",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
