    },
    {
      "uid": "zhcn:64db8184c2845204bf2b9421",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……果然，相当辛苦吧。要在活动当天以前\n准备足足10公斤的料理……。",
      "source_fingerprint": "782e6c2b0e00ca65dfb0dd1cb702b963e13f5e15b7aff49a37d2756118a3f5fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111108.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
