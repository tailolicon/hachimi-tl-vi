      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:06d04cc3442d0eae3ef5e647",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "10公斤！！！！！！",
      "source_fingerprint": "3adebb759df5d0f2c9b55f9df7bf0f6f4924d21613978464be18b9bb829440a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111108.json",
