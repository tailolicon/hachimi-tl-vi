      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "参赛赛马娘A",
      "source_fingerprint": "7df80cf5d7e2c0532efeb74ca698719b2380bf460fdeba58f4daf845f0ce7d3f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
