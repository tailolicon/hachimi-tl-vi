    },
    {
      "uid": "zhcn:6088db5f7e4017b0649d75e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一想到，能吃到许多训练员亲手做的料理……。",
      "source_fingerprint": "514e1171ea5655c59cc55bab47da9705813b195c2871a67717726345e8f6da88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111108.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:4b1af8bf0c1d61822a02c0b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
