      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，您已经很努力了……！",
      "source_fingerprint": "4f19ff09453dac4557fbdf1dbe1691d3e15debaf875ab588f4c3d5798f851f32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
