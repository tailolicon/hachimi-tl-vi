    },
    {
      "uid": "zhcn:56324491fbe8391401088e52",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以她没有亲自提议举办活动，\n而是准备参加\n学园提供的活动之一――",
      "source_fingerprint": "e20ec1d239539324ab498acbd06c44fd4907de21619da3a34993abf22ea6bb33",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
