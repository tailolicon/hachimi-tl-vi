    {
      "uid": "zhcn:bc576c4dcc3be4bbb4f2440b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还远远不够，我还能继续吃！\n――再来一份！",
      "source_fingerprint": "54d26b252e9f44092560bc808eb1360646cae4776cb47b37290d268db6d20796",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
