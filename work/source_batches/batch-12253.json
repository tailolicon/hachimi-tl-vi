      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……非常抱歉，训练员。\n只差……一步。",
      "source_fingerprint": "2d2ed106a1f5bc86e6f0cae829410cbc8142448cca862dc663f60b25896530fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
