    {
      "uid": "zhcn:81de5b1741ba6a6dacedb974",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主的母亲",
      "source_fingerprint": "377835c78f9b27c34272eaf82ca537e023d1b1129ff6bbd08c7e798ada6bddd2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
