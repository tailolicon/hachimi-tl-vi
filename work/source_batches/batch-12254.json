        "name"
      ],
      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:984ab3058a64a1d40ab3684e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今晚若能亲自向您请教，我将不胜荣幸。\n例如赛马娘俱乐部的指导方针\n等等，务必请您赐教。",
      "source_fingerprint": "7147ed4f00919d861700805a89a9454b0f0cc94c761a18d940fd0bca8eca908f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111109.json",
      "json_path": [
