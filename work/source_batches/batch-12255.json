      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毛线织的，玩偶……？",
      "source_fingerprint": "1c85624d7181a2a7fba5df9469711ce5d7b89add6c318ce96c6d16f6e2243cc3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
