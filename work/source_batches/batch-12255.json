      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:b93ae975b533aefa9481d9f7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想让她再放空一阵。\n于是什么也没说，\n只是默默站在她身旁。",
      "source_fingerprint": "ee163c8a51cce22eb85d18ff0fa0180e17b6727385339acf5cfdf8f5388422db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
