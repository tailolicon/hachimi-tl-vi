    },
    {
      "uid": "zhcn:298970a2013ae70e7a4d4729",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这份再正统不过的圣诞礼物\n很有她的风格，令我不由得笑了出来。",
      "source_fingerprint": "91c16b95453e8264f532d543aacf47e94534e92fd937c5149509fd199505ca58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
