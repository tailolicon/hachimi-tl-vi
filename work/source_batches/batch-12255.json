      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面对宾客或母亲时\n她看起来都若无其事……。",
      "source_fingerprint": "cab31662b532119a0016d1e4d73270266c5aa61808ef3111abce10aecd8c4ea3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
