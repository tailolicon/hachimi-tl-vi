    },
    {
      "uid": "zhcn:4278e0de7a341a68c5017398",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就下次再见……！",
      "source_fingerprint": "59fd387102e0f5375257d2b48e3d97ffe23d3e0503f610984fed717122fdb951",
