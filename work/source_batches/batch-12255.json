      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:27740f25c0457e19eb43ef64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你，救世主",
      "source_fingerprint": "49548e4c7edbbb45745f9e02c5ea6882c9391f57d246bb11112bf7f1540838bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
