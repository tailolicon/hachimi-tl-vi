      ],
      "json_pointer": "/text_block_list/64/text"
    },
    {
      "uid": "zhcn:18c20e61e2cff48de4f880d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她支支吾吾地开了口，\n声音险些淹没在热闹的人群中――",
      "source_fingerprint": "9518bfc2b66f254c211094724087f80eaddfb8b63c7f072a0ccfb33c3397a6b5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111109.json",
      "json_path": [
