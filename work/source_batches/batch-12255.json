    },
    {
      "uid": "zhcn:bc7dee06e07c62e433c74a1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最近这段时间，天气尤其寒冷。\n……请您，注意保暖。",
      "source_fingerprint": "2036baabad9cc6ca25a3ea81f322732fb38eb9dedb3e16f91bc78291b973fa1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
