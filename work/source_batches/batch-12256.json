        0
      ],
      "json_pointer": "/text_block_list/87/choice_data_list/0"
    },
    {
      "uid": "zhcn:bbfc4503c00cc449da344850",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大象的确出人意料，可南方小岛的元素\n真的有必要吗。\n究竟什么是稳妥的想法，什么又算大胆出格――",
      "source_fingerprint": "93818b6fa502a09c31b97e78f196bf74ce7abcb1ae72cff2b0b5bbe4e45ed703",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
