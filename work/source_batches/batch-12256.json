      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "况且，原本就不必勉强自己这么做。\n……我都明白。",
      "source_fingerprint": "d4087b6665bf8d80733c77875501db208d0e368be1293db9214b41f88a63e2f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
