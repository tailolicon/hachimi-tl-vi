      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且即使是玩偶，也没有选择\n常见的狗或猫，\n而是刻意选择了大象――",
      "source_fingerprint": "03959e0b8c33ca1e03520c3ec99632add10feeea36476f198e21c25ede361a65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111109.json",
      "json_path": [
