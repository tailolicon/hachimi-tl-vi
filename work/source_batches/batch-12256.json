      "json_pointer": "/text_block_list/84/text"
    },
    {
      "uid": "zhcn:017498d6c513b66f8326dce0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那、那个……！",
      "source_fingerprint": "e3425221b47615b061d0fea4b53c14b7417b02993238586d4334920ce27412d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
