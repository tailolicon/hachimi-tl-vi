    {
      "uid": "zhcn:586afea9240b027ae95f3b00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，我从许多方面……都试着，大胆了一次。",
      "source_fingerprint": "f8fca18f7d4e0e6f6138afa07f1dbad14fc658d2dbbcba794255f64c96c83ca7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111109.json",
      "json_path": [
        "text_block_list",
        84,
        "text"
