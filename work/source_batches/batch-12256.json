      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同时又刻意加入南方小岛的元素，\n在圣诞时节营造热带气息――",
      "source_fingerprint": "e5323df027a6b97b563bac5827b5905ac9da2eee8069a8b7515982331f001a7d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
