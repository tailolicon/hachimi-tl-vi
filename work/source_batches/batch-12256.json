      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……您觉得，怎么样。",
      "source_fingerprint": "434db5398ccf346c982cc4e30a3f224e8cf9a488b8cee31cb0b71d6b74bc7ae6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
