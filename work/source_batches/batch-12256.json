    {
      "uid": "zhcn:ed538b94b0e67ab5d5c3d1e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "老实说――我也不知道。\n不过手织的毛线玩偶本身说到底\n不也算是经典礼物。",
      "source_fingerprint": "db9f06bd9f36bafd5c6da3e32bfb8e03ee60b04834f4eb6167ba8e129f8bc16a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111109.json",
      "json_path": [
        "text_block_list",
        86,
        "text"
      ],
      "json_pointer": "/text_block_list/86/text"
    },
    {
      "uid": "zhcn:a59f35fd95f7ab49664b8561",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（我不懂……不过玩偶很可爱……）",
      "source_fingerprint": "5f6aa23349b6e9f072389b22b2f2bea6fb2a796464730d75c01c30330b70d2bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111109.json",
      "json_path": [
        "text_block_list",
