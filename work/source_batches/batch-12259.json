      "uid": "zhcn:957a49ee820316bda1041cd6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和您很像，都是认真的人呢",
      "source_fingerprint": "c41d93486a7fc324aac842db12b8f2bb4b3177363b2fe3e0a167b29207eb14e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
