      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:3e76f1f3fd99bff904cf573e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『可我本来就没有附加任何条件』，我小声嘀咕道。\n……没错，是她本人提出希望先从临时加入开始，\n并主动拜托我的。",
      "source_fingerprint": "2f5f6afc7f333be564ea378da93bc614866eba46663ffb412a7a8435489cb916",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
