    },
    {
      "uid": "zhcn:80d90db883cdeb5273443b2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是……！\n所以，请安排侧重实战的训练菜单！",
      "source_fingerprint": "82c747ff3001a66c57ed0595c805156d8e3591ada24cff098a8675f8b468924b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111111.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:099c0d73ba00948c17ba15c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明白了。……总之先从热身开始――",
      "source_fingerprint": "1fb24f3f2c99176e00c7d032c332d2e98863c8dfa5a0efde4ac24e51ead779cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
