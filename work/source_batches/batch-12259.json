    {
      "uid": "zhcn:954e969e2ef217a1e073cadf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵。\n……看起来，干劲十足呢。",
      "source_fingerprint": "38dd8eb90cda548dc65a5bfa748bebc5c6206245712b780148ad42bf6e327131",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
