    {
      "uid": "zhcn:850af110b78732c8b82174dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大概是在为正式加入燃烧斗志吧。只是――",
      "source_fingerprint": "60275d072c27bccd15bfd1c1d91e2b87066c8a7f6fcabd58ea935e39c3df13b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
