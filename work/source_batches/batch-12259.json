      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您，马上就要参加模拟赛了吧",
      "source_fingerprint": "73a05c201d0292d9c2d1b2a5483f937be75d9d7a819ae6f2c1070f6a6c877012",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
