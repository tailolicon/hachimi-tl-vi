    {
      "uid": "zhcn:e754588054493e18daec8efd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈、哈、哈、哈――\n噢噢噢噢噢噢噢噢！！",
      "source_fingerprint": "05dee3d0f6b5d80d974a6b1a9abacc336137e1b69b87d42607ac5546c6f3d7ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
