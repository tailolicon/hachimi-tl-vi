    },
    {
      "uid": "zhcn:9d6fa38e2067fb2f33146bd3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "戴蓝色发夹的赛马娘",
      "source_fingerprint": "8091d369356a8ef87dce7f7ec0d404c7ca7748459f1abeef1fd02b69be1a925d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
