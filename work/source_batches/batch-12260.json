    {
      "uid": "zhcn:6578d332d521190c0733bfe4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……\n训练员，请再往这边一些。",
      "source_fingerprint": "8868e2c17520daa28bf77fc7e29184bd33f3cb01c0d66944ebcfa525515a6347",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
