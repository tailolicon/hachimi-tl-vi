        "name"
      ],
      "json_pointer": "/text_block_list/70/name"
    },
    {
      "uid": "zhcn:93f690ccd91fa3e303b0bce6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊……对不起，\n我只顾着觉得这一幕很温馨站在旁边看了。",
      "source_fingerprint": "e1b2c7a671c833488fdbb896218a0156170a4ce227c358b164dc037ac4fe1cf9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111111.json",
      "json_path": [
        "text_block_list",
        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:b1820e08e937e9b3b61e85f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯？……真的。是花香吗？",
      "source_fingerprint": "bbc58cdcf99f3169d9a4ee6634db319fdc5f9862e51c8e05674ad9a093417a2a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111111.json",
