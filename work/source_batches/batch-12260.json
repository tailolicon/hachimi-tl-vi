      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:4629d99d2e70e14add793d43",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "季节，踏踏实实地轮转。\n与空中救世主共度的第四个春天到来了――",
      "source_fingerprint": "fed523ca13b82af54ce316d972b627b2efb67076b11e104fc281e7f83268540d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111111.json",
      "json_path": [
