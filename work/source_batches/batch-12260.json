    {
      "uid": "zhcn:d724be72f4c738f28b149817",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员，您没事吧？\n它们似乎一直在往您腿上爬。",
      "source_fingerprint": "4488e248838627d7f76725f1b50a4a5c041a6906730e7a807c2668a9ee9deb99",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
