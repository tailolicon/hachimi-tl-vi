      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……哎呀。\n似乎，有一股香味飘来不是吗？",
      "source_fingerprint": "e4c1aa2d90c4c21db0d28cd4fdd9583b569f3ab0fb764603a6f2459fc9ebb2b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
