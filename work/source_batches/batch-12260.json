      ],
      "json_pointer": "/text_block_list/78/text"
    },
    {
      "uid": "zhcn:a2662c6e25ed768e291e5db6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘们",
      "source_fingerprint": "a0f0dcd5cfbde045bcedbcf0687c7f95f475ee6315345fa057f54916adbdac32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111111.json",
