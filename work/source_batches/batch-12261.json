    {
      "uid": "zhcn:0d1f7c4b250d9ba050bef41f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自己是一名『向前迈步』的赛马娘，我为此庆幸。\n我是这样想的。",
      "source_fingerprint": "f270da975713b015b74b0e44c5f06bf0097e1c403aa6505a0f916262f5a5da43",
