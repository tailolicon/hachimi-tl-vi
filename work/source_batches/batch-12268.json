      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:e309dfef008247b73f5db975",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一直以来都是如此。我拥有的，\n只有认真得令人无奈的性格，以及一根筋。",
      "source_fingerprint": "8382c1d6888b3adbc6a48b6360fd29cd8fbc269faa5358f353b475422857e317",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:b28e58fde4eee51acc5a2db4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "关于你，我写了一篇论文！！",
      "source_fingerprint": "8afd7db91140abaf39a40fbb3fcc8c8c036857c68bd864d50cc551c54e5dd38f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
