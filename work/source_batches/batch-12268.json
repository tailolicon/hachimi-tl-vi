      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:54015424060e1e5396c12888",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "足以让我这样断言的依据，要多少有多少！",
      "source_fingerprint": "67d79b92d9e7d8c8e713c65ec9bad9a1c7e6f501fec6cc690ec24cec9d4b0b59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
