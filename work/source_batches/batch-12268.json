    },
    {
      "uid": "zhcn:a2b529cc0fa091809198685d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是，我说不出什么漂亮话。\n并不具备那种灵巧。",
      "source_fingerprint": "a2cc8d7e255905eac8fea5a31c6b8ee22ea137166e4699fb8efaee9388b9b45e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
      "json_path": [
        "text_block_list",
