      "uid": "zhcn:c7a3cbf8054528de6ae06f9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "训练员……这份文件，难道是……。",
      "source_fingerprint": "e09497473c818b717a612ed863d01045e3da05cbaac834f53c214c59c09d8a20",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
