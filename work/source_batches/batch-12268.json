    },
    {
      "uid": "zhcn:34908afa324665d2e29ec75c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "关于您，我写了一篇论文！！",
      "source_fingerprint": "bbe7cdfca211816c55af45704ecf1b18a90984b4e31728fdac7e3968fba806e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
