    },
    {
      "uid": "zhcn:6e73117dc9396432f0ad73c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『技能图表分析_62』。\n『训练计划表_89』。\n『对手数据分析_78』。",
      "source_fingerprint": "f6a0d22fe2b465e025da3e41225e71bddb86259abdd2a2129738241430a96cf8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
