    {
      "uid": "zhcn:e111a19f57ed53f7633cbc10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『空中救世主在秋华赏中必胜的依据』\n日本赛马娘训练中心学园\n<username>……。",
      "source_fingerprint": "de471aceb3d71e1db1252cf5ab65328b88950127cf937f41e1f9311c59159797",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
