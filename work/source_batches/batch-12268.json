    },
    {
      "uid": "zhcn:d6e6c9f633cca613ac24e0ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想把你心中的疑虑，一扫而空",
      "source_fingerprint": "3dcb7629ba9c434bf4d795a373a1d352d6cf4e5b8c30a7ecefd30140abb4fc41",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
