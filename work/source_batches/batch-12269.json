      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:c061ba9120444ee33abff02a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "已经没事了。她没事了。\n清冽的晨间空气，温柔的潮声，\n仿佛一切都在祝福着她。",
      "source_fingerprint": "e998dd51ee39044965a54baa7df25a27ffaf2854f67985df52602e5e29984da1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
      "json_path": [
