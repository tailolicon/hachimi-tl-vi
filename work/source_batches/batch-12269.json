    {
      "uid": "zhcn:2a121dc2d11129f60fb21034",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主露出了明朗的笑容。\n那份高洁，令我蓦然屏住呼吸。",
      "source_fingerprint": "c89b80c8a7383ee190d67e1515f73a86f61925e673141d3986ef072191b08815",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111115.json",
      "json_path": [
