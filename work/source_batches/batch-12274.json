        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:ff20fe5dea7fcb158dcda548",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可是即使告诉自己『因为紧张，所以别紧张』，\n当然也不会有任何效果……\n我能感觉到冷汗正缓缓滑过背脊。",
      "source_fingerprint": "e5de2f273afcbc079b68f13f3502633dfac8345a322097ddc310c118e3f6e9f8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111200.json",
      "json_path": [
