    },
    {
      "uid": "zhcn:5e4f30effc0eb237cb2da104",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了届时做好准备――",
      "source_fingerprint": "22bd18aa17811b66d3aa859bd03b1303488479a486b401d687ebf1464ef902d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111202.json",
