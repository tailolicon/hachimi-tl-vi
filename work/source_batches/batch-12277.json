      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "必须具备堪称――“时代最快”的速度，\n方能成为胜者。",
      "source_fingerprint": "feeca3755a8ea5ecf399a23f724e88a457f9ea95d87cfd8dc356af12c05448f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
