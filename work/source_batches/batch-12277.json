      "source_language": "zh-CN",
      "source_text": "……为了亲眼确认，也为了提前准备。\n我出发了。",
      "source_fingerprint": "dfbf6262081f8837ebfa8fed90782f30640456ff529f3c9d3e0cbd350506c22f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
