      "uid": "zhcn:26d96b5b779a76ceee1cd74c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她怀着自己就是时代最快的自信，来到了这里",
      "source_fingerprint": "ef097ff14aca73d90e02b4fafd404fe7de66df17d8f41f24d147bb6a3e535d89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
