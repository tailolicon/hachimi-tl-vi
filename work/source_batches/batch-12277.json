      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而在这之后，她又宣布……参加NHK英里赛。",
      "source_fingerprint": "9e535f8986a354bc579a374f5a1401db132dc19d36de3dedd88e8a8a51438bd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
