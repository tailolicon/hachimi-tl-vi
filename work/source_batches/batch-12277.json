    {
      "uid": "zhcn:e9c24f1717af4ea6aeec237f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而同样宣布参赛的勇敢之心同学，\n或许，也怀着相同的想法。",
      "source_fingerprint": "99e44436200aeafe0ab13c523e5d5046e074d177098a69876d157f35d80676be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
