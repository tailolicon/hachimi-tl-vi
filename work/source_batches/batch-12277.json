    },
    {
      "uid": "zhcn:dd5051a2a4f24fbdc5beb436",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不，那个――",
      "source_fingerprint": "da5bfa6476668d523d32b1670715a7905b5127e6ce33d3a9a0eca191152598cf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
