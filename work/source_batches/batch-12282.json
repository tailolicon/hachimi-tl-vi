      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好、好的……！\n那、那个，请多关照！",
      "source_fingerprint": "052e0844a7411a72c6df0bdb1498209b8f833a0e60824eda3ccc3482554afeaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
