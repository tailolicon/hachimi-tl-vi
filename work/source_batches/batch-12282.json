      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:3c8823b26ac0d8bb6381bba6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们对机内周到的服务惶恐不已，\n以惊人速度飞越天空，抵达目的地后……\n她带着清雅笑容，在城堡里等候我们。",
      "source_fingerprint": "8ce78e10101957108818dbf845171977c283ba91feead3b89aebaa8be67a5db9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
