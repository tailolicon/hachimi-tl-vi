    },
    {
      "uid": "zhcn:6d4e85208845d081c15a32d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "眼前的情形令我头晕目眩，却还是\n和空中救世主一起登上了小型喷气式飞机。",
      "source_fingerprint": "4234bc2579e375de10e72670daf1beaf0f8d4aa18c3b7a1f6fea66b50fa361d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
