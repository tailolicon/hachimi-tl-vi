      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石",
      "source_fingerprint": "9b56cd884b7441b8b32119740e379b8bc7aa840838b1c62bd9418c4a41cbf2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
