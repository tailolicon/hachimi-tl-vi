    {
      "uid": "zhcn:d272a6cbbc2f543b4a8444e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红宝石的管家",
      "source_fingerprint": "4bf632e9a44ceeef1cec7d8cf5593d00ae57ee8ee6d72a0dc625cbaf2ba81744",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
