      ],
      "json_pointer": "/text_block_list/56/name"
    },
    {
      "uid": "zhcn:661af195e49940523f9d9814",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――您想问的是『血』与『传承』，对吧。",
      "source_fingerprint": "aa34d9e62b55db2ec5822db1cd1060438e7c2c048c71c21fa149cb7d04c944cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
