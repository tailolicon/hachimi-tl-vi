    {
      "uid": "zhcn:053236c8dd14edaa76358349",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其中寄宿着怎样的灵魂，怎样的心愿，\n又是如何传承下去的。",
      "source_fingerprint": "d0d82b0b7d7f1db1ae465357d916879271fa80def92a11dfc13c2eb484f42b2d",
