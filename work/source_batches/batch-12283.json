    },
    {
      "uid": "zhcn:3c85c3f02aafedfe015752b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好了……呵呵，其实我还想\n和你们多聊一会儿。不过赛前正值关键时期，\n可不能浪费你们的时间。",
      "source_fingerprint": "ad1700a863f36a704066db9fc9f7edf87c7c82313d9306a036d4337c7e6f201b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:8f656ebb5658483a9a685acc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "美妙姿势",
      "source_fingerprint": "d1cb551351a68022b5153ce22910be53e5784043168e94eb897bec2ce3a0afb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
