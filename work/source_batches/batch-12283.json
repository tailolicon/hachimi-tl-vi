    {
      "uid": "zhcn:b1dae763c7ff1b9f9bfd82ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然谈到『血』，果然还是。\n你们应该拜访的赛马娘是――",
      "source_fingerprint": "96dda6ea193fdc3fbc093917923ad6648358434afdeff38c56637e9966516290",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
