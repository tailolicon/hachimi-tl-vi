    },
    {
      "uid": "zhcn:7ee5eafd2fca85bc07511814",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但在最后，也让我来。\n为你们介绍一位，可以吗？",
      "source_fingerprint": "1929cf364d841da6e181a4a03a2714a7c64094e5e327b597b38e88d5725c51ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
