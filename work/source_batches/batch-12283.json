      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "祖先寄托在我身上的，\n果然，应该是高洁――吧。",
      "source_fingerprint": "aff84f6f8f5a63cc3466407a030c6cbd76c269dbf699d698cbf4eca0bdeb64e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
