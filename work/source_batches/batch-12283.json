        53,
        "text"
      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:2a3f63e9e361923f4fc2d3a8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石肃穆地向我们致意，\n反而令我更加惶恐。毕竟，她正是\n著名“华丽一族”的继承人――",
      "source_fingerprint": "55ab48df51b0ce1c5ab3961cfe0e49940e5694af9f5205cfcf773089aeab37b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:f9a6c0262223309fd8cfe3e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因如此……我们才务必，想向您请教",
      "source_fingerprint": "c7dd4d378d3d95d0291c2006c58b00ad16eba354bf1f2e9ede30d78e49e26c5d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
        "text_block_list",
        55,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/55/choice_data_list/0"
    },
    {
      "uid": "zhcn:5b59ee5ccc3af4fba716a78a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她不仅在政商界拥有压倒性的影响力，还\n在赛事界留下了伟大的功绩\n寄宿于她体内的『血』……实在太过特别。",
      "source_fingerprint": "a8b22e0d325ca9b2a9d2f9cbbdd459cf0f2c612b4d82e2b752a870287709881b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:8625840636e3a625b663ee71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石",
      "source_fingerprint": "9b56cd884b7441b8b32119740e379b8bc7aa840838b1c62bd9418c4a41cbf2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111206.json",
      "json_path": [
