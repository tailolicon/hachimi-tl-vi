    {
      "uid": "zhcn:5b75c4fd0f4798407dec5164",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感谢二位特意前来。\n此外，事先共享问题事项也帮了很大的忙。",
      "source_fingerprint": "46e4184298ea8d5a7d49295144856be9de2412d486b549262105afb45665f104",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
