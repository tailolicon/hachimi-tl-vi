    {
      "uid": "zhcn:f87cadb8cfbbeda50e09c9aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "相信那里面寄宿着\n不会改变，不会动摇的强大。",
      "source_fingerprint": "926665384f124466417529a36b3726972f367285fe23530a8b38684a14c47d78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
