    {
      "uid": "zhcn:38106a43e3105e2090e23bb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主与我，不断积累。\n一天又一天，积累正当而应有的努力。",
      "source_fingerprint": "b7c77672ffe9e51687b1163bff92c87ce747b42694c36f838f53538f1c2902d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
