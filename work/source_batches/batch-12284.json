      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:86703f2638a6c58ba14a30b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们郑重地互相行礼，抬起头后，\n摊开事先打印好的资料。",
      "source_fingerprint": "5753112ceacceec57d4ecdb90a8f3dbd0b2f078633fc93f3c8d3ebf7f55ca210",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
