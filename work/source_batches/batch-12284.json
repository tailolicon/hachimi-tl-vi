    {
      "uid": "zhcn:f93baa359c7c16bed8b5e79e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她从较晚的出道战开始一路连胜，\n短短4场比赛便登上GⅠ霸主之位――",
      "source_fingerprint": "3163a1a2cf4c36a8536410c2bc1e581d4ef650433c80320b19d750ca55ca6ed2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111207.json",
      "json_path": [
