      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "把你视为明年……经典级，三后冠路线中，\n需要警惕的对手之一。",
      "source_fingerprint": "4aa3e05a36143e74bca27c8c76db76f41131f9fb8101b318d6f65c2879d33e04",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
