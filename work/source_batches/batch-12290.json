    {
      "uid": "zhcn:66460a6fa6911e4f4d5ef4f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和煦天气中，风轻轻摇动树叶。\n身旁的空中救世主像要吸入弥漫的草木气息般，\n胸口微微起伏。",
      "source_fingerprint": "714f30843d82f203d7060cd1e9ad5a8a4835e5cdf6f8738ab819a7922563d4e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111303.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:f9108de08fa32c9d9b9f9322",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不用谢。休息，确实也很重要",
      "source_fingerprint": "51d99bd15578ce8341d43a395c0501356a12825d728f1723232c072ede812c2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111303.json",
