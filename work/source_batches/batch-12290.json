    {
      "uid": "zhcn:50a4be07510f5e21e8ef6178",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我有个提议。在此以前，\n先安排一段休养期如何？",
      "source_fingerprint": "58f847c07dc6b2f439399122ae9f6d6b22a70165978c456a5ad58ce4c00d5073",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111303.json",
      "json_path": [
        "text_block_list",
