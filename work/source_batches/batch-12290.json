      "uid": "zhcn:675a326896d60dc3d8f5c605",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得这个想法很重要。我也会向你学习",
      "source_fingerprint": "0bffd55adaec59071e06f734a6d54d418ed1bb56fee1b311c5df9601c0864993",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111303.json",
