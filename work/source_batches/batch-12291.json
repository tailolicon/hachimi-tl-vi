      "source_language": "zh-CN",
      "source_text": "要向已经开始释放出巨大压力的对手，\n发起挑战――",
      "source_fingerprint": "9af6c357d64254146682018b51c0abcda865b29ea8ef5cebf4984c26ada4d138",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
