    },
    {
      "uid": "zhcn:010cbfd227db8253fa621cca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『那么，我们应该怎么做？』\n我果然无法不去思考，这一点。",
      "source_fingerprint": "040ca32139fae0e792eae4c4cd629312fa7832a22912432d4b906be6b11e9934",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
