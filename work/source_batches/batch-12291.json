    {
      "uid": "zhcn:e126b8c983f6fcc0bfe53e30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论是对后冠的渴望――\n还有，实力。\n她们全都无懈可击地兼备。",
      "source_fingerprint": "4b11688f3d3c6bc51b2b336b0861a02253dc43d4868d1064e7d61e7e19cf5c40",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111303.json",
      "json_path": [
