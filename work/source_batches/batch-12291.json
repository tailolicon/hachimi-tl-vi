    },
    {
      "uid": "zhcn:d15015d77b9d13a5ab245449",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们两位都把『阪神两岁雌马大赛』\n……新马级GⅠ之一，\n定为重大目标。",
      "source_fingerprint": "eaf7dabc1da5aafb27e8370737f32e99c8cacb46f1a4e693faf28495fb7c6983",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111303.json",
      "json_path": [
        "text_block_list",
        59,
        "text"
      ],
      "json_pointer": "/text_block_list/59/text"
    },
    {
      "uid": "zhcn:7ebd2aeda58083fc4d140c7b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，不！是不是准备得有些夸张――",
      "source_fingerprint": "301500b383de3b803ab7b3c7786918d23a372bbebbe695f682757d373173fb73",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
