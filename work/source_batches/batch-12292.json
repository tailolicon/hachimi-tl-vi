      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出道战后・此刻，萌芽",
      "source_fingerprint": "3114ee9ab82a13459eb537eabbb42468cad43c053403805d0873106f7e269c9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
