      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "西沙里奥终于开始崭露头角。\n而且，还不只是她――",
      "source_fingerprint": "f19d423ca887422bfbb8dc2797cc7bda7e36d68eb40f483da3031a5850fd97b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
