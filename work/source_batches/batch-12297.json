      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "接下来，我要夺得秋之冠！\n一定会把它握在手中！！",
      "source_fingerprint": "4c612a9e0eb3686aef7238e41612356a78b018d97f6fc719f5f35e94349152a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
