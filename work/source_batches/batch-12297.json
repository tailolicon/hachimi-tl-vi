        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:5f8eb3fa0de2918f8620e390",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量已经表明将参加『秋华赏』。\n也就是说，我们必须继续研究对策。\n……『对手数据分析_37』。",
      "source_fingerprint": "d494a462524723b77cca89c78ff66a251c9a3bfe9194a329b12f0898474d0c4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
