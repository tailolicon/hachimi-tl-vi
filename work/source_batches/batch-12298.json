      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是莱茵力量，莱茵力量！！\n『樱花赏』参赛选手漂亮地率先冲线！！",
      "source_fingerprint": "9228c8598eb9c376dccc4b31f7ccb6d41cdebf0a3b8a01b3ea9ba301d86270a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
