        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:6e6d4e326a4cfa25596fd53b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "莱茵力量已经表明将参加『秋华赏』。\n也就是说，我们必须继续研究对策。\n……『对手数据分析_37』。",
      "source_fingerprint": "d494a462524723b77cca89c78ff66a251c9a3bfe9194a329b12f0898474d0c4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111310.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
