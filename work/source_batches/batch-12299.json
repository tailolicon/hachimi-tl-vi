      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:7be02dc407a3f33d559e08a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是，啊",
      "source_fingerprint": "2c25092b76b653a04c2d36c36e8fd9323f8fe0095e2d86157a8c450132ccc0e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
