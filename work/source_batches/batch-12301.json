    {
      "uid": "zhcn:a654b4be797bc21e02435385",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在此发誓『将向各位展现\n比先前』橡树大赛，时更为惊人，\n更加压倒性的进化！",
      "source_fingerprint": "f74520080e7fc4c4ad0dc067d3612cec9c0459cc39ee40d860ee8046ceddce7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111312.json",
