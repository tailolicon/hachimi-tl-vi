      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。我打算立即做好准备，\n启程赴美。",
      "source_fingerprint": "281efebb280f632bcb760738bc215fcc13f564760a1b81830803f15b28a19111",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
