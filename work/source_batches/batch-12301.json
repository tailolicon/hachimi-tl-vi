      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "并且，我一定会――\n把日本赛马娘前所未有的荣誉，握在手中。",
      "source_fingerprint": "39396c7530d12b4436e4cb77f36f9c177b1860b95c9e4dba2fcf25decd8188b9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111312.json",
