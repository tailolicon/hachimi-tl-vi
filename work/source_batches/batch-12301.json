      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也为了成为一块基石，\n承接那绵延不绝的后冠历史。",
      "source_fingerprint": "6d8a8e714ac35347061d2e3184b203065d4d23e8991f3d6b989f838576a0504d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
