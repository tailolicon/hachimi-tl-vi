      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "记者们",
      "source_fingerprint": "6e9ddc6220ede6bf78d357d12faa0afc6f5a760b6c5d65fc4d37e8a560245795",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111312.json",
      "json_path": [
        "text_block_list",
        26,
        "name"
      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:f37452261e04e7c24e30eff5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "噢噢噢噢噢噢……！！",
      "source_fingerprint": "62a5dd2ea153273785dc65c661adc96ac23a562e1e7e2629054b881c1144fbfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111312.json",
      "json_path": [
        "text_block_list",
