    },
    {
      "uid": "zhcn:54622ef0baf02c058fb5a178",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众们",
      "source_fingerprint": "fb9eb6518e94670473e15bc84b7c6dc3f58687c51fb543b0e89b34018813d2d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
