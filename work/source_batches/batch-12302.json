      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但她的声音，任谁都能清楚听出\n――无比微弱。",
      "source_fingerprint": "fc69cddfbb9c7d660587ac8f446c878025fd5e0cf34cf50a69351b803fc304ef",
