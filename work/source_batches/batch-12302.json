      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她……到了秋天，究竟会成长到何种地步……！）",
      "source_fingerprint": "a2ca1e6015d18abf08e767bac1e5cd1ef8f33f8b57580739edceb23bff914771",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
