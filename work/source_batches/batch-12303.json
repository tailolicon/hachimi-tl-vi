    },
    {
      "uid": "zhcn:8422493a8f20fd018e2e24bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "噢噢噢噢噢噢……！！",
      "source_fingerprint": "62a5dd2ea153273785dc65c661adc96ac23a562e1e7e2629054b881c1144fbfc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111314.json",
      "json_path": [
        "text_block_list",
