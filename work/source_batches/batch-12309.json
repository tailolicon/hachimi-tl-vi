        27,
        "name"
      ],
      "json_pointer": "/text_block_list/27/name"
    },
    {
      "uid": "zhcn:c528ed1df750075193f149c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以前勇心同学邀请我参加她朋友们的聚会时，\n也许是因为拉绳用力过猛，\n我没能让礼花炮响起来……。",
      "source_fingerprint": "ecc67c329d71a262ebc91e5a041e1d247f607b4ba3f5b867f52ccc67ec938c4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        27,
        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:72d894f5c61df7ca5bb69bd1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "确实，可不能一开始就碰壁啊……",
      "source_fingerprint": "30d80cf262616f320f417d87e02faea73cad27560426c0d847abfe52c4a00327",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        28,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/28/choice_data_list/0"
    },
    {
      "uid": "zhcn:f54cb09caaece876695bf3ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
