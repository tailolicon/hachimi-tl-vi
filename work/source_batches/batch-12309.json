    {
      "uid": "zhcn:e903c49c6e43ef65ce482c83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "真不愧是训练员。\n那么，我们先把这份说明\n仔细读一遍吧。",
      "source_fingerprint": "e746472f12d494775737fcd1d199ec7404f9c200d90f2d8d8a2e1c2d4a38217d",
