      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:6c63597af6a195d8906c8154",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（就像母亲，曾经为我所做的那样。\n我也，想把这份心意传到你的心底深处――）",
      "source_fingerprint": "f40bb9a67ad6edb8f91ceb2887161a8305e70903f26e41e4f7edec4ab3fa4511",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:63aeba6e0b8e1e931829e797",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……找到了！说明书！",
      "source_fingerprint": "e6f416806f3c4c95dfa6e926c3831d1acd1759dad91693b80085c991b6c5a36b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        30,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/30/choice_data_list/0"
    },
    {
      "uid": "zhcn:300228b36ff72f1927b14323",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稍加思索后，我拿出手机。\n确认着商品名称，\n在搜索栏中输入――",
