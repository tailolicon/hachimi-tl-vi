    },
    {
      "uid": "zhcn:59b1230d82077729776dab2e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但，那样就无法『烘托气氛』。",
      "source_fingerprint": "99d931200416d1b935c4f0028bd3a1c0b82dda42f01498da7fdfafb937fe4223",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:cf18d509f349de8bc64b7e7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        29,
        "name"
      ],
      "json_pointer": "/text_block_list/29/name"
    },
    {
      "uid": "zhcn:9276b19ca4740e4e07cd3248",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正如您所说。\n既然如此，首先应该……。",
      "source_fingerprint": "13e53c7b3c86cfa0eaaa48ab2ce2ec8eed5f8b16f45294eab3b9e14ef97c7942",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:80e1d8f2411431ef5786eceb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
