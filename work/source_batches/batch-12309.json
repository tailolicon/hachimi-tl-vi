        "name"
      ],
      "json_pointer": "/text_block_list/22/name"
    },
    {
      "uid": "zhcn:df26d7c5ead5d1687b1d0560",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家都说，放学后\n会过来参加。",
      "source_fingerprint": "f8986dc9e34b1ab267466c3710c9ec2e9aa94a032552cb77fa5255e325bb2a27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:46030e28a4b35029b7d298a2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        23,
        "name"
      ],
      "json_pointer": "/text_block_list/23/name"
    },
    {
      "uid": "zhcn:37546647c01ffd77bb33d195",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。第一项是\n『用礼花炮烘托气氛』，对吧。",
      "source_fingerprint": "83fa0bfa1c10d70e0398c6aab6181c4381df0ba59950a268bd0462652f89c3ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:48e2b93c71be92c713e20098",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "熟、熟悉……可能谈不上",
      "source_fingerprint": "e7c32286e9d6d76e0ab48ecf01d346edfe4f6b3b7eecd10d96e339ae63e323d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        24,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/24/choice_data_list/0"
    },
    {
      "uid": "zhcn:234fd14e068d0451ffe032bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        24,
        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:7486afdde679b4e64890c5ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "说起来，这个问题或许有些奇怪……\n训练员，您熟悉礼花炮的用法吗？",
      "source_fingerprint": "00d0908da09ac599340f962f4137d50f7760ff018c073384ab789b8c80e67142",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:c6afdb48befd679b5f581aba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟我的人生中并不常遇到\n需要礼花炮登场的场合。\n我坦白告诉她，自己也已经很久没拿过了。",
      "source_fingerprint": "cff9b87d9337b94dea53cd3f41d1ebc14a833d4f94fba8cba8b79b4dea16607c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:887ff20623f4018811460cb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（礼花炮还有熟练度一说……？）",
      "source_fingerprint": "a9cbd0d7b629a3e6166a12643d8c30e1f10fde82810a77d239de360e9c659f93",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        26,
