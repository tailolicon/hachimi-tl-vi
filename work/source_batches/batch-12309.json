      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（啪！）",
      "source_fingerprint": "a14b695f437543be51589e962e5fc40c44698a92673ec9f18c689704ce383753",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
