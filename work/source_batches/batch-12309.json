      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们交换眼神后，彼此点头，\n喊着『一二』一同拉响礼花炮。",
      "source_fingerprint": "0e7495b57d99395cabf231ffedfdedaa96ab5bf0e83d0b0d09b243f329b626ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
