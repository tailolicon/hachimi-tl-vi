        0
      ],
      "json_pointer": "/text_block_list/26/choice_data_list/0"
    },
    {
      "uid": "zhcn:22167ba709f19d09b8fb0179",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111318.json",
      "json_path": [
        "text_block_list",
        26,
        "name"
      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:bb473dc1dc60d3f152575cb1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样啊……\n不，我的熟练度也差不多。",
      "source_fingerprint": "ccfc15f037f60da93856c1e233300b743b1e79080275a6d45e8ba8d77169871d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
