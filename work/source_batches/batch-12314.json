        "name"
      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:b5e523a6eec02a4c284b23e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但母亲无疑很强，也值得敬佩。\n我为母亲感到骄傲。发自内心。",
      "source_fingerprint": "3a1e388b81a1104a6a4c6baf4627b708e6827cbadaeea004ce925e5ffda857f1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
