      "source_language": "zh-CN",
      "source_text": "您能注意到。我很高兴，\n这是母亲胜负服的配色。",
      "source_fingerprint": "edd921018bb985f27a70711004976db3e4d290fd6af9131ca6bfe4b7e95f0f6e",
