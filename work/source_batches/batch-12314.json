    },
    {
      "uid": "zhcn:4938a2c9f9a30a47862a6f3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因如此才想赢――\n用胜利，证明我与母亲都很强。",
      "source_fingerprint": "5f2fd3796151fb4baf79457a675b80b3c42b84c82ab5b459be46d7ffcb7f7029",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
