      ],
      "json_pointer": "/text_block_list/20/name"
    },
    {
      "uid": "zhcn:c91dfb9782e768a06f94634c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我要用自己证明，母亲的奔跑并非只有遗憾，\n而是为了跨越世代最终赢得胜利。",
      "source_fingerprint": "aa5362b550c94550145ab9942da1be7a5f558d2c672f6bf849bce74b6280d27b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
