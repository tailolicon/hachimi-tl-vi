    },
    {
      "uid": "zhcn:638f362d0d85948f6fbeac72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "母亲，在世人眼中，\n或许只是一位屡次惜败的『遗憾赛马娘』。",
      "source_fingerprint": "40dcc4e170111e24afc1ac41d9521b2ebf23ed3c26df2987ef3305e49bdf1037",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
