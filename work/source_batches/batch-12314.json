      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:feca2d5be1d403f972f1aa64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "胜负服还有其他特别讲究的地方吗？",
      "source_fingerprint": "1829c0d65dc983fdd0c70392710e6ded57eecd50995752f25e55c40d3957066c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
