    },
    {
      "uid": "zhcn:09f4b8f4a97ee13da5f630fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
