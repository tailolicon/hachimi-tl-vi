    },
    {
      "uid": "zhcn:4677699a07c86bb1904651fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "母亲赐予我的这两种颜色中，\n便寄托着这样的心意。",
      "source_fingerprint": "575693712812a24f56eec8b82ea3b11372c210c9ce545eb5f9ea3a0ca0816da2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
