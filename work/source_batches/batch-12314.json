      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:aa6822f4ae21bc9cf6191317",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "几天前，空中救世主作为近期备受瞩目的赛马娘，\n收到了杂志采访的邀约。",
      "source_fingerprint": "232618dd5effbc0fceab9a49686772659720b7d2e8edcede33c54ba81ce7467a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
