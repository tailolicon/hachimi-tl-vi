      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――以上，就是我对下一场比赛的决心。",
      "source_fingerprint": "cfb2d228b04543d944b32870fbb78e9e98eef53282181f1bf6c73a08a0fc6839",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
