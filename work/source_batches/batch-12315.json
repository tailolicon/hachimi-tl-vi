        "name"
      ],
      "json_pointer": "/text_block_list/34/name"
    },
    {
      "uid": "zhcn:e2c35987bd08912fdd6ba6ad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听您这么说我就放心了。\n不过，刚才一定还不够完美。\n若有在意之处，请告诉我。",
      "source_fingerprint": "3c1361de5873491cf9672bd4c8dadc6897e6e25b3588f3e49c8604dbc57f77e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:fd22c1897b11088d9f623295",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我告诉她过于专注采访时表情会变得严肃。\n为了展现平时空中救世主的气质需要提醒\n自己注意这一点。",
      "source_fingerprint": "b60d4818aa40061dd8b673253ce032550d84bc6bcbe7cb23557e6f4f85a3596f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:6592f6e02bf5715d56555a7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        36,
        "name"
      ],
      "json_pointer": "/text_block_list/36/name"
    },
    {
      "uid": "zhcn:522ccaaa04ee00df1944e2f1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要记得微笑。对吧，\n那么练习回答时，\n我会对着镜子仔细确认表情。",
      "source_fingerprint": "3150d810711419e77841b46040985e3d4768d39809db6240e8390f40f63a358d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:08eca83d2fbb6b88d271c3ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        37,
        "name"
      ],
      "json_pointer": "/text_block_list/37/name"
    },
    {
      "uid": "zhcn:31cef4d3cdd4171916d17546",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的一举一动，也会影响母亲的声誉。\n我必须认真对待。",
      "source_fingerprint": "669361333084740e42916671eb75e5e3e3a565eab31fa68dc12293db7080a17d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:7256e3a6b7038ecac686a49e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主为了立刻实践，开始用手镜检查表情。\n照这样下去正式采访一定也能顺利完成。",
      "source_fingerprint": "7b7fc03f497d11c76b3820c2fe5c5a05bc6085e85b6f1a0fc73762764bb250ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:8b22397fd7dd8e4df324464b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主曾告诉我，\n她小时候很怕生。",
      "source_fingerprint": "ad4d0faeb72c8b19db9c9d7685c9a017f746db3e31d232a6aaab99a7dda35284",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:60d744106fc2a5f7b026f73a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢。那么你的长处是什么？",
      "source_fingerprint": "4d4d92f480e617aa0ea6c4e79c024e7781528a00cd932a1e5c8421327730ae54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        4,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/4/choice_data_list/0"
    },
    {
      "uid": "zhcn:0c8c33eb9600188e9bd61a0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:50c0ef63c6e5054d8167bca3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的。我叫空中救世主。\n受曾是竞赛赛马娘的母亲影响，我立志参加比赛\n目前就读于特雷森学园。",
      "source_fingerprint": "6aa3fb9bedb7794d96dba3569068427f0ec1736955b3abec824a24d6a1b37e8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:ce37b2f81fa09a22074957b2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使通过努力克服了这一点，\n也未必就会擅长面对众人。\n我提醒她不要忘记放松。",
      "source_fingerprint": "dc4e6665e4c7ee5f705ca6cf6817e7dd991af571d94ab9edf23650ba91d82304",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:2510213ad013d523399a5878",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
