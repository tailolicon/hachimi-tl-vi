        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:f70f12930bd6c5ce8038e490",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论多么不起眼的工作，\n我都能踏踏实实地坚持下去。\n凡事绝不偷懒便是我的长处。",
      "source_fingerprint": "995ea3a0cc3b04b366a886beb607cb5ad85d4e7b90d5a10135325b2ac96ee2c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:5ab051da6cd7347100232b00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中救世主",
      "source_fingerprint": "44b0b4536a8618f87e6f59f3e688bdf6df0281db1545eb55578e92f69875751b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1111/storytimeline_501111513.json",
