    {
      "uid": "zhcn:efc30ff5caae58e62ff79301",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大家都说我是一位认真的赛马娘――",
      "source_fingerprint": "de2534c3651ed09fc65b3789725cca5f53e7ab681bd65287fac4763c0160e36c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
