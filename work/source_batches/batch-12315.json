      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:2656340232867ec5ea8cec3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听您这么说我就放心了。\n不过，刚才一定还不够完美。\n若有在意之处，请告诉我。",
      "source_fingerprint": "3c1361de5873491cf9672bd4c8dadc6897e6e25b3588f3e49c8604dbc57f77e1",
