    {
      "uid": "zhcn:8c58d0650fb66fab31a588e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是我将桔梗与西洋菜相结合，\n亲自设计的花。",
      "source_fingerprint": "fc8f2cf841e4d3488372d88130fa7c818cc8cb69ea60bb32d2ca56be5c5739c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
