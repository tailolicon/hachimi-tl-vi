      "source_language": "zh-CN",
      "source_text": "可是，有一天，打扫结束后走到外面――\n母亲正等着我。",
      "source_fingerprint": "4028586bd028d26a8661688f86b66708d04ecb3c62a2c143ddb22f806d507d4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
