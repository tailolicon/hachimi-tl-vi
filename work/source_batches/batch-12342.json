    {
      "uid": "zhcn:b695c53420a9d28505e6dbce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……Come on, Heart!\n你可以做到的！",
      "source_fingerprint": "13791823388080968bdb2b4f5e9738bc002d1e1f2aae50da40cee3eb7161eb98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112100.json",
