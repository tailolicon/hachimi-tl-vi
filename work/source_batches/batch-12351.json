    {
      "uid": "zhcn:546d3b5829c635dac44d29ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "警报一响就要立即休息啊",
      "source_fingerprint": "34dde3f0ad8937b317ece736502c7fae6400ee81ef2eeea06d280121d617c461",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112104.json",
