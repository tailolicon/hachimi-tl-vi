      "json_pointer": "/text_block_list/55/name"
    },
    {
      "uid": "zhcn:a83b2ae18d7ffa4401a81e7b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好啦，都跟你说了别露出这副表情嘛。\n这不是我自己无论如何，都求你这样的嘛。\n――求你，让我一个人待着。",
      "source_fingerprint": "6162ad44643f9f9775c7e61031c916a8c16527bcd4eb55ff18d459676babb7a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112104.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:81d7762f3411babe2b895189",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇敢之心",
      "source_fingerprint": "9a26c04a8af8557f331ed7076671e2fce274ed0afd52fdd6e88b73fe92f7c8e9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
