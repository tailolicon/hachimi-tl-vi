    {
      "uid": "zhcn:f268c4a07201d13daee91376",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，勇敢之心＆信念队，\n漂亮地赢得了『全能对决』的冠军！\n",
      "source_fingerprint": "0ccf6946dfbc6d072085587721b26c5ea3526c1a765f5962e7e6b872c29abf78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
