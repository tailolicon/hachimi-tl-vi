    {
      "uid": "zhcn:73abdcc75b40e75ac6b1d837",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那个，神宫前辈。\n您为什么会答应我呢？",
      "source_fingerprint": "607789b1c6553bacbf636fdf860a7f2d01f12f9741e6823ff66e13e8f8fcb9fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
