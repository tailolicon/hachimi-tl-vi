    },
    {
      "uid": "zhcn:bba985469e180a086e6bf23a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――辛苦啦！\n今天就练到这里吧。",
      "source_fingerprint": "191a0529637325f22d2d2821d40cef8604bc983a48e7649f5e4b05341d8c6360",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112109.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
