    {
      "uid": "zhcn:0614bf21b9ce2685d554eb3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "空中神宫",
      "source_fingerprint": "518141f549ec17c68539558e989d6e1e1572a826491709a731c97a2fe4f1603f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112108.json",
      "json_path": [
