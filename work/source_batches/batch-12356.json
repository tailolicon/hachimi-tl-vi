    {
      "uid": "zhcn:e8d1a99c389d94b885ad6eac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "景致同学，今天我可能会在很多地方\n都要麻烦你……不过我会努力争取胜利的！",
      "source_fingerprint": "3b64d44038d45a728c8290c84539d9e5c5e19067ec9892367e6e1f2abc9ffab7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
