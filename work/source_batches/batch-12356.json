    {
      "uid": "zhcn:374de7acac73adecfe6c2e58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯！　赢了之后，\n一起向小特前辈报告吧♪",
      "source_fingerprint": "4a5336f7c3952d9624b87ecfd5656074a70c97c2c9da92b26a7ace2426a7647a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
