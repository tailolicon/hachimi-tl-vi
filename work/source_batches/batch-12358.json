    },
    {
      "uid": "zhcn:5998692323afa89f6793c8a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……话是这么说，也不是只要跑下去就行。\n因为她是――能跑赢的赛马娘啊。",
      "source_fingerprint": "f1810bcd66df01dec43fe8a9461494e8ee563a27e43b2e867a620f657a5152bb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
