      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈啊啊啊啊啊啊啊啊啊啊！！！！",
      "source_fingerprint": "24cbc4412c0c2603d8a95c42c2d83ddc83e67b4fd6af0703349441d0fb827acd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
