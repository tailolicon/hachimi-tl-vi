    {
      "uid": "zhcn:289133887a33ef9f9863de25",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我还有这颗心在。\n那种时候我也能竭尽全力！",
      "source_fingerprint": "e7a5a7c541612754bbe2fd8782ff217ce21f753ed5b759f360caadfa22cd6979",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
