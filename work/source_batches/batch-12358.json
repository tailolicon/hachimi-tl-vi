        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:86fd3173267e321f68aa1d4a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下次一定要赢，好好展现自己",
      "source_fingerprint": "d6b88024cb53adb9c39414f6c318145d0551e277165976540cfde9065d1a5000",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
