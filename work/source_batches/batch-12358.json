    },
    {
      "uid": "zhcn:3f3ab36f94960c41a075c568",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我有个小小的提议――",
      "source_fingerprint": "cc2d3ac42c368b9b41287b31b8c4aa754f8bb056b270fb386cd146ee258f8fd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
