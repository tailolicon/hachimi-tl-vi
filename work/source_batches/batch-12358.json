    {
      "uid": "zhcn:29ef31966fc3dafd64b96b0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下场比赛跑泥地啊……\n你在想些夸张的事情哦。",
      "source_fingerprint": "064a5ff4b1b6b18fc310c0f865aea930a121fa0419810f3fad7ad42abb826dd4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
