      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:fcdd45cd07c0f6667647ef90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『樱花赏』『日本橡树大赛』『秋华赏』\n组成的三后冠路线。\n她们全都是――志在后冠路线。",
      "source_fingerprint": "105ab9d145872e86f259a7ad2edf7ce06fd943e3c55c9a701d45dfa2ef1670c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112113.json",
      "json_path": [
