    {
      "uid": "zhcn:dc3d4fbc36502f343ca3350e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "闪耀・系列赛中，有两条主要路线。",
      "source_fingerprint": "1ea41916d827cc908fc30d85dab29c45e818fbc9ae61103674851b3b06d0314a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
