    {
      "uid": "zhcn:da4b99886ee193dcf9010c41",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在三后冠路线上，\n我要献上更加更加炽热的比赛！",
      "source_fingerprint": "44402dacb132455d7bb2031fec4d78de75bcc57469248df98016778f9c94952a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
