        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:ded8aaa0b51f5078539ac47e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先是、『皐月赏』『日本德比』『菊花赏』\n组成的经典三冠路线。\n然后另一条是――",
      "source_fingerprint": "b33103937a0981ba4fc742bbe79c8a0970bb125effb618b5f71c5bdbead1a8f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112113.json",
      "json_path": [
        "text_block_list",
        37,
