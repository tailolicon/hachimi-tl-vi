        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:96105cc984d94ca83621535b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在勇敢之心身旁的是莱茵力量。\n与天真无邪的外表相反，\n她是位蕴藏着惊人素质的赛马娘。",
      "source_fingerprint": "5070d6a60ab3881405bdbc1fec591a073f663c1813cd8f3345c3f3ef65fed7a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
