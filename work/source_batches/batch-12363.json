    },
    {
      "uid": "zhcn:bc91b6cab9ab687270042270",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊……。\n――后冠的梦想，我绝不相让。",
      "source_fingerprint": "7be2a72fe5ab34351565939ec5ce82788e5d295fb72ef967982e51bae4c8f8c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
