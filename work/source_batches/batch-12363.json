    },
    {
      "uid": "zhcn:4520dc3d361e8b16a8884f32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对在高声宣言的勇敢之心，\n在场的人们零星地送上掌声。\n同时――",
      "source_fingerprint": "1407d270c525aef28bcc009e12574e430f0d7d098f1ee28a55fc294dcbfa62d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
