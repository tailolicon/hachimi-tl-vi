    {
      "uid": "zhcn:6ff862995fbe545ed15ae847",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "勇敢之心也很不错……。\n――但实话讲，完全被压过一头啊……。",
      "source_fingerprint": "adbd99798a5557d93a8c73d787d3956639b22bf89196a291976e68b816e52b42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112114.json",
      "json_path": [
