        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:1db709493cc0e287f02c0e05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我无法否定周围的声音。\n莱茵力量流畅地占据前方后，\n用完美的配速衔接最后的冲刺。",
      "source_fingerprint": "ec1590932eed2877db69a17d85da9c8494a6f0f61e19000242f1e430d81b4765",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
