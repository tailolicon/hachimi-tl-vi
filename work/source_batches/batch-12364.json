    {
      "uid": "zhcn:85a9d7b575f6844395095d71",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在完成全部训练之后――",
      "source_fingerprint": "a0b74c452dec220b5540fe11c26ed132eaaa410e60d977a2c9c924739050957a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
