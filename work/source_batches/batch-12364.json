      "source_path": "assets/story/data/50/1112/storytimeline_501112114.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:feb35f01266069afa766595c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……勇心――",
      "source_fingerprint": "941ee8e739bd6c5b77389c4e9f92aad67e5db8fee7fb0915b402fb3eb3525281",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112114.json",
