      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到力量，\n你也是这么想的吧？\n即便同为先行型――级别也是不同的。",
      "source_fingerprint": "55e7178b4a2d3ebe76cdbaaf05364274985861c5ec97801c0db5dace7a8bc501",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112114.json",
      "json_path": [
