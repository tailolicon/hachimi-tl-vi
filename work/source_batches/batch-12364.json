      "json_pointer": "/text_block_list/35/choice_data_list/0"
    },
    {
      "uid": "zhcn:5a6805909df3d7531aada06a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是说，她虽然还在新马级，\n却已逐渐趋近于理想的先行型……。",
      "source_fingerprint": "11607707c7ea1145c0f2ca1b4dd2e216f4a846f3cbd725c3e43fd4f19ad7e8fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
