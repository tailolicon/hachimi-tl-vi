      ],
      "json_pointer": "/text_block_list/18/choice_data_list/0"
    },
    {
      "uid": "zhcn:bae3358a32cfdba749f20577",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯。有件事想拜托你――",
      "source_fingerprint": "f4267ccca5f164e09a8b2b096299a398204144bf417f63cc57d1f2a754b20b45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
