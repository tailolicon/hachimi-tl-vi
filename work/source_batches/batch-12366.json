    },
    {
      "uid": "zhcn:3db5b33076d2ddf5cbcf4d08",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………那个。",
      "source_fingerprint": "ba510fc53f406e8d11e2be3a305a42097eb3b4852adc67913894d99534bdc57b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112115.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:f698efc076dc3f8f7edc972d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯。有件事想拜托你――",
      "source_fingerprint": "f4267ccca5f164e09a8b2b096299a398204144bf417f63cc57d1f2a754b20b45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112115.json",
      "json_path": [
        "text_block_list",
