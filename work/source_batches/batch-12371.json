    {
      "uid": "zhcn:d32bb1ae9cf8c22d673c9b4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的武器――就是这颗永远享受当下的心。\n“Daring heart”正是my weapon!\n（“勇敢之心”正是我的武器！）",
      "source_fingerprint": "1c471cc5c611a60659083c4f96a011523b6fc9d93021c0ae5afda41bd3966086",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112116.json",
