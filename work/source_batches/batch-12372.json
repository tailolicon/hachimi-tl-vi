    },
    {
      "uid": "zhcn:29efee071c721150e7d1f68b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可、不是还――",
      "source_fingerprint": "706dccfd81f7865a1eb79d69af5ffafddbd43c863bc5105b6f7e1a3a8548e0b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
