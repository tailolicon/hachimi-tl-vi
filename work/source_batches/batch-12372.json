    },
    {
      "uid": "zhcn:ea704016619bde2e1134d67f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呐、你看……反正不管怎样，\n我也不可能永远跑下去吧？",
      "source_fingerprint": "e03ac6bcfbe75df927226aacffdfdf69f9a15a8e6c93eb54dc0b5eb02d82855f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112117.json",
      "json_path": [
