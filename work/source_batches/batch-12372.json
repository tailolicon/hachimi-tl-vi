      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且……。",
      "source_fingerprint": "7c1265f6f837fcc9ae14d542bcb60b6c13827909cbb72a854422555571e7f8c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1112/storytimeline_501112117.json",
