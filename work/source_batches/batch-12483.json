      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "差不多该出发了吧。\n文件都带过来了吧？",
      "source_fingerprint": "9b2ed5414c425a3453311b4319fbcaaca6aab3bc679669ae4482d8b58a39afd3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
