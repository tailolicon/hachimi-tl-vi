      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        51,
        "name"
      ],
      "json_pointer": "/text_block_list/51/name"
    },
    {
      "uid": "zhcn:6b024ae42cfeba325ffcecd6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――嗯、我愿意。人家的训练员！",
      "source_fingerprint": "43633f6b4d9ab8ae2303c71460dbe55abe797f9939e85dfd7a6a37700e757535",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:74cd319e5a1b0a1dc74b4545",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们二人终于站上了起跑线。\n从今往后……彼此将并肩共同实现梦想。",
      "source_fingerprint": "1495b9966053ffd658c660e7eff2dbd3849bcfd70ea094ca00bcf01f15e5c60e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:dd8293f710696162f9b08664",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯嗯、当然",
      "source_fingerprint": "63a7227bc02e08450293de6a3ee92ccd0cf379685c4d3fc7ffb5d164f8b2b2d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
