    {
      "uid": "zhcn:4b09ea45d24854b7ca0f380b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呜嗯！　……哒啊ーーーーー！！",
      "source_fingerprint": "70f157927762cba770933bcf613b4d6ca26d2a5b9edd6fa5019c033df91fd315",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
