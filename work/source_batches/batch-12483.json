    },
    {
      "uid": "zhcn:46a9ea54d6cc60799f956027",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊、但是让我再确认一次吧",
      "source_fingerprint": "d8bafebb1a11755559c2632b6e8d420ae55275e8c5604c37a05db9fab1dd429d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
