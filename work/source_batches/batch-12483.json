        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:41d83cc83514a6985396e198",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼呼……嗯、还不够！！\n呀啊啊啊啊啊啊ーーーー！！",
      "source_fingerprint": "dd4859a8b8593b0a9a634598243827f0965ca60487ea4a63bd20174939abe2fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:a226122224e0329d62ba2584",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那道疾驰的身影太过耀眼、太过炫目……。\n――年少的胸怀里、就此种下远大的梦想。",
      "source_fingerprint": "69d42f6b9242d9e729b53ce5096c5b8291dd20599db31edf78b076dc5ed19f58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:c48a1374c612fbdbaf607900",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『我总有一天要成为、\n迷人景致的担当训练员』――",
      "source_fingerprint": "07e9e4acd937bc685464c0d6f6926ea4c90b26dbdf5fa3e44d48a799623360a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:c455df12eb814210775201a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我终于能向她倾诉这个梦想的那天。\n她的眼角微微泛起泪光……\n随后、对我露出了迷人的微笑。",
      "source_fingerprint": "04f227e9a050b0ce70651fc4f291156394018880a03a7a4fbad2c37cd736afd1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        49,
        "text"
      ],
      "json_pointer": "/text_block_list/49/text"
    },
    {
      "uid": "zhcn:340fbe83d5356ee7ef2b3e03",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "沐浴着灿烂的阳光、她纵情奔跑。\n姿势与步态皆堪称优秀、但其中最为亮眼的是\n――最终加速的凌厉。",
      "source_fingerprint": "2f86c2c12d33274fb993c1f406cd510330616b9be670336c151b09df4b6e5326",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:7a3016becf3b365f9cb93427",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你愿意、和我签订担当契约吗？",
      "source_fingerprint": "13c6d1a0198e1e46d75297fa6c5b5da1c98dd71d40432e34d21bf8e6faf0ff55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        50,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/50/choice_data_list/0"
    },
    {
      "uid": "zhcn:d37f70099a5637e95a310a9b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你愿意、和我签订担当契约吗？",
      "source_fingerprint": "13c6d1a0198e1e46d75297fa6c5b5da1c98dd71d40432e34d21bf8e6faf0ff55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        50,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/50/choice_data_list/1"
    },
    {
      "uid": "zhcn:6a23e2166597ec28d6a40e29",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我追随着她进入特雷森学院的脚步、\n顺利成为训练员……以此表明自己的决心。\n然后、实现最初梦想的时刻终于降临。",
      "source_fingerprint": "50d664e4927f1cf8df790b431e6012bb655e2d66036f1520ecd8d7c9aa067c1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114100.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:da69d45f3103455a6c6d6e63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致",
      "source_fingerprint": "8d00a4803d17b32d08d3d9ae9844b52810f0b4162c25dd8d8a1226ea163081d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
