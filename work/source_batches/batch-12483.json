    },
    {
      "uid": "zhcn:5746d7bf7bcd77866f4ba2aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "年幼的景致",
      "source_fingerprint": "f8ef928c569408686cc806562529316f0d257facd7af3a8a9edabfb2362d8751",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
