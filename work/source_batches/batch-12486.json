      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便在漫长的闪耀系列赛的历史中、\n摘得这一荣耀的也只有两位――",
      "source_fingerprint": "8051d521822df544a2003856e7e1f246f3e75d6614bd41e3387fcfe00e2ca17c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114101.json",
      "json_path": [
