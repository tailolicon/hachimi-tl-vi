        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:2851c9c594af5bde313e121d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "拿给我看的是比赛粉丝间最具权威的投票网站。\n粉丝们可以在各场比赛中\n为自己支持的赛马娘投票。",
      "source_fingerprint": "00552855ada6464b9a826677c0258cbd8e0c8470d36e140bd17b68b09f64c987",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114101.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:a909406fd28f96c012f9f34a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“谁背负最高的期待呢”……\n这个网站能准确地反映出来。\n在上面、迷人景致她――",
      "source_fingerprint": "719c412a45a0557d8f2754bf7e61794ac88312abb8118326d399f129d6d4b141",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
