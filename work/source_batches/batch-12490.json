        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:c463a667dabe472932e4ca55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（――也许、如此吧）",
      "source_fingerprint": "c04441094c1575bc81685eb84243840132ea27c0bb3a39799b39f2baee1656dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114103.json",
      "json_path": [
        "text_block_list",
        46,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/46/choice_data_list/0"
    },
    {
      "uid": "zhcn:95e90770709d831a67aa96d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『日本橡树大赛』的热度远超以往。\n受其影响、导致她的心态变得过于激进――",
      "source_fingerprint": "e01725f7de2aa6366bf07122c2faff42c1157dc30b76746f8f36523e1bcb32f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114103.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:0d05db65c75d075283b0a330",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（啊这……看来准没错！）",
      "source_fingerprint": "0e9f5e900161bcf74cbab65a84656aa1094910d3d7d48243bdc6bf0bfd702cb8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114103.json",
      "json_path": [
