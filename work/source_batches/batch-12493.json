    {
      "uid": "zhcn:652290a69761ab403f51c28d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊咧、有记者在……。\n今年不是……？",
      "source_fingerprint": "3a038da546fa41b42092b2e8e4c7ca23f2f9890e960193b3d17415c330792603",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114105.json",
