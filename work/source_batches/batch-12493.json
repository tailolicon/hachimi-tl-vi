      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第二年）途中",
      "source_fingerprint": "7110dc9e12b7a950b87217511f6073929f5a26d01250a7e7e7d7589f51295fda",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
