    },
    {
      "uid": "zhcn:02c966ce0a6b3889cd76f808",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（黄金巨匠啊……！）",
      "source_fingerprint": "8f1da75b85b70cb46ed929918e5f061a6b430a1f86e932f2dcf8ca34fe4bc052",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
