    {
      "uid": "zhcn:d718bf3174725ec5d123c016",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "记者A",
      "source_fingerprint": "e727284e47e7d9a58d24f984ebd7a8d19c16f65187c12dd1c7871d7683e242d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
