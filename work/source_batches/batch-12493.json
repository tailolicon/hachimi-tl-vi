    {
      "uid": "zhcn:c8da4a494c1ba839780fba70",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我看着自然站到迷人景致身旁的特别周。\n再次认识到、那背影何其的伟岸――",
      "source_fingerprint": "5b0f62be48d1625e2f22b8535ba50a371846ea47f72fca7393ab3b2cbf85e8de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
