      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:eebfcf8549133c8bd45e80d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样、在学园方面的关怀下、\n我们获得了更能专注训练的环境――的才对。",
      "source_fingerprint": "99f83f38c2e8c025e5433b3e6a9f12359f697babddb3e5ebaa253fbbfc5b175b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114105.json",
      "json_path": [
