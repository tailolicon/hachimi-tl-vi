      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:d8524824a4ab3e54d770b177",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也不知是取得了许可还是钻了空子……。\n正在我先要向记者确认情况时――",
      "source_fingerprint": "625a5e834d3af2c764b1ad095e76dc129b5a18b77eeed47ac5e1d126f09739ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114105.json",
