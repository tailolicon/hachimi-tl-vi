    {
      "uid": "zhcn:1a7129b91789ce63853ab535",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "平日总把回应粉丝期待挂在嘴边的迷人景致、\n自然干劲十足。她选择的项目是――",
      "source_fingerprint": "cdaf94f9164249cde42121b825b87dbbd42d73dee1c1ade1504755b510dc3373",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114108.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
