    },
    {
      "uid": "zhcn:334c70da8f3186eb1ca1d650",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呐。总有一天、我们也绝对要――！",
      "source_fingerprint": "6c7215ec74c4143c26f411cfd7b51633302c22306f9c86694dbf87139b371cb7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
