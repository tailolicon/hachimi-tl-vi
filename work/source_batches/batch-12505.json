        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:3c8a92357e8bebb794824952",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（没错、那幅“景色”――正是我们的梦想）",
      "source_fingerprint": "7d9fcaa5fee1417b7d788cc30bc0c21cf0a728c51028bd41d5b33d9e8f3e03a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114113.json",
      "json_path": [
