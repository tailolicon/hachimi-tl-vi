    },
    {
      "uid": "zhcn:42ec84ff1bcec07bd1afbdb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致",
      "source_fingerprint": "8d00a4803d17b32d08d3d9ae9844b52810f0b4162c25dd8d8a1226ea163081d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
