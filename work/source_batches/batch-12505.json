        "name"
      ],
      "json_pointer": "/text_block_list/16/name"
    },
    {
      "uid": "zhcn:fc8788cddac74311d10fbebd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "何等的、绝景……！！",
      "source_fingerprint": "3f6963b9464f7562a33ac8cd6e148290e22cadbae2105bcab555b65358ef34c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114113.json",
      "json_path": [
