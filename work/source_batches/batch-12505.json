    },
    {
      "uid": "zhcn:6b69d64730fb861bdc2f0ae3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为我们带来如此绚烂的梦想的……\n正是特别周。",
      "source_fingerprint": "73c9388323260edabda8c976fc8a79a37f0afb98c975b45e9932bc5930d79dec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
