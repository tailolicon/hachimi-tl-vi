      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是呀！光是在亮相圈就充满威严――",
      "source_fingerprint": "ca9faa3521d5168b61a13cd57080d86edef4756c6791e3737ac5038457793744",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
