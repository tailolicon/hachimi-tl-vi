    {
      "uid": "zhcn:472fdaebd4fb4bbd5348dbf5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实况解说",
      "source_fingerprint": "f0c6e85e4cca1be55785e09562f9eb332fe0e02c5e706e1ec706b55d0222b46b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114113.json",
