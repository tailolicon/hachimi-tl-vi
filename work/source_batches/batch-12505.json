    },
    {
      "uid": "zhcn:242cf79f4c617313d38cffed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "威风凛凛地、击败凯旋门赏赛马娘！\n威风凛凛地、拿下『日本杯』的胜利！！",
      "source_fingerprint": "a93abbc2b630709185be26314f1dbb73c5f2c8699a5dece097d2674ca5f89b72",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114113.json",
      "json_path": [
