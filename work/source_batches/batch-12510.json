      "source_language": "zh-CN",
      "source_text": "我们追寻的是、传递给每个人的绝景。\n所以――",
      "source_fingerprint": "5dbf3295ac8eb6e607861822e3ef131caca5d7a8fe541049a8e4cb52f77b4eed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
