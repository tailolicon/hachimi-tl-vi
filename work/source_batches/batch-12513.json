      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:279af21695f9eb566d4005c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "粉丝们",
      "source_fingerprint": "1d0127c03babea170dc2400559be29585f9a07fc8c29021b4ac4edc8961dbd3c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
