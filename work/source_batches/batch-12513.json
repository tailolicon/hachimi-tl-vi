    {
      "uid": "zhcn:22e9ae7cd650d6fc72e03d7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呜。\n――嗯……。",
      "source_fingerprint": "66d1fade70335dc08ab18e17b51043a20a91215ff1f1ae5079533bc410a83f5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
