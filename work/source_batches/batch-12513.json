      ],
      "json_pointer": "/text_block_list/100/name"
    },
    {
      "uid": "zhcn:3de2466c1653e7689595e566",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今后的道路、请与我同行！\n直到这双脚、停下为止……！",
      "source_fingerprint": "b09862b208c921e53f24d7860cb507f94e343141647598b2a2b48e09d149e545",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114117.json",
      "json_path": [
        "text_block_list",
        100,
        "text"
      ],
      "json_pointer": "/text_block_list/100/text"
    },
    {
      "uid": "zhcn:9aa2b40884b3b986ca77e170",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致",
      "source_fingerprint": "8d00a4803d17b32d08d3d9ae9844b52810f0b4162c25dd8d8a1226ea163081d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114117.json",
      "json_path": [
        "text_block_list",
        101,
        "name"
      ],
      "json_pointer": "/text_block_list/101/name"
    },
    {
      "uid": "zhcn:eaeac5d61aa920fcb40719a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了能够实现与你的梦想……！\n我也不会……再以为自己孤身一人什么的了。\n",
      "source_fingerprint": "9da30f0438f270d0eaf520b32fe8c89a3b581db8d81f3e87c0d2c3c3ef64b6aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114117.json",
      "json_path": [
        "text_block_list",
        101,
        "text"
      ],
      "json_pointer": "/text_block_list/101/text"
    },
    {
      "uid": "zhcn:16f001f9742f30acf0126a5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致",
      "source_fingerprint": "8d00a4803d17b32d08d3d9ae9844b52810f0b4162c25dd8d8a1226ea163081d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114117.json",
      "json_path": [
        "text_block_list",
        102,
        "name"
      ],
      "json_pointer": "/text_block_list/102/name"
    },
    {
      "uid": "zhcn:b6cd7a7d3c6fb178a98bcd2b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――让我们一起抵达、\n想要展示给大家看的绝景吧！",
      "source_fingerprint": "ba9948bee61d51b706152711bd7cd3f7028c0ff6cb7eb3077c07bd97b0b75a39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1114/storytimeline_501114117.json",
      "json_path": [
        "text_block_list",
        102,
        "text"
      ],
      "json_pointer": "/text_block_list/102/text"
    },
    {
      "uid": "zhcn:1dc70254a5421a6dca8b1146",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致",
      "source_fingerprint": "8d00a4803d17b32d08d3d9ae9844b52810f0b4162c25dd8d8a1226ea163081d6",
