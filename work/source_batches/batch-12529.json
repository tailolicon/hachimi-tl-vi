      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（即便如此……它们、也确实地传达到了）",
      "source_fingerprint": "225da811aa2fea931e675345d12f545cf424497e2efa704bba561abc44617124",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
