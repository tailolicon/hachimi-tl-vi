    {
      "uid": "zhcn:b5b8fd56a14b7f26100deb15",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――甚至超越了预期。",
      "source_fingerprint": "cab03e911bf8cb0627bdf3838f294ddb39212ecff99d105b9266123b1d91009b",
