      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诸位、感谢大家的提问。\n我会逐一回答的！",
      "source_fingerprint": "e6bb426d922f4b44d2caba5b946d2713e9b43a5a70cce78b9109b8d39f4d2e59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
