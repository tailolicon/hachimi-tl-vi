        "name"
      ],
      "json_pointer": "/text_block_list/30/name"
    },
    {
      "uid": "zhcn:176f4120d4a975655b28f6c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "爱如……往昔……！",
      "source_fingerprint": "0626ea01d8c38735d6715d61a03cb5bd4763474479da875cdbd59d74692a9062",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1118/storytimeline_501118103.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:d9ad2700e44dc2d7f3c48a69",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目前，爱慕律动已经深陷于\n对爱如往昔的执念中无法自拔。",
      "source_fingerprint": "864c0ae297a809e33fa9e821cf82d0e9992839645983c05e7f097a2eb652a95e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1118/storytimeline_501118103.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:bf4b1b1d964d465f6ae7c8d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每当意识到对方就在附近，或是对方进入视线，\n她的视野就会变得极其狭窄，情况十分严重。\n必须先想办法减轻这种症状……。",
      "source_fingerprint": "d4bf2667fba1ac98db33722fd7f4b8120efb21958655bc02370a13d77604890a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1118/storytimeline_501118103.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:26c5f5c9e28da3c638c5ff8f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "最优先的任务是确保训练环境……！",
      "source_fingerprint": "4aee81af16a491b9f3ee7cb46b4ca3860c30a1a090c0e48936a64c1a3c332a25",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
