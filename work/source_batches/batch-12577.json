    },
    {
      "uid": "zhcn:d73ada388c0689d3052a85f7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在日复一日紧绷的训练生活中，\n还承受着被深不可测的劲敌追赶的重压。",
      "source_fingerprint": "d0d2eb105cbb47d0743a640e95481b937984727d35f03935e742b9e8b5c811f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1118/storytimeline_501118113.json",
      "json_path": [
        "text_block_list",
