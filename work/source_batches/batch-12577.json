      ],
      "json_pointer": "/text_block_list/71/text"
    },
    {
      "uid": "zhcn:885c28fcdcd20f52344f0a2a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论是在精神上还是肉体上，负担想必都很大吧。\n我很想在这些方面照顾一下她。\n但是——",
      "source_fingerprint": "f018ae71ad715524e351bbc33f176a493e1c8ccab88c843f6e6e2c965763c0a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1118/storytimeline_501118113.json",
