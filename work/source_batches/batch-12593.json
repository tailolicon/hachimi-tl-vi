      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:0bdda98b954ec1c87adc8873",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然参加同一场赛事，在同一班新干线上\n偶遇也是极有可能的。",
      "source_fingerprint": "1ceffa6c03daa7ba277e3e32c54a9635a849b7398da10366e387332252b00037",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
