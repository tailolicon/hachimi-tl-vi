      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:75c1a7875a14293ddae40f4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "その不屈の姿に，多くのものをもらった。\nいつしか彼女の惜敗を，\n心から悔しがるようになった。",
      "source_fingerprint": "9812f0d743daef70261b6495f52e3ac8cf0b6fbc798fe94fc7b097cac88165d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119100.json",
      "json_path": [
