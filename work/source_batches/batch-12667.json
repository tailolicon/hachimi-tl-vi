        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:40d7a676d9565535f7dcc0ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『がんばれ』と。『今日こそは』と。\n応援せずにいられない。\n愛さずにいられない。",
      "source_fingerprint": "9383fe912eaee6b4348485fd101dc2e09ba3c2d8fb604b298e28e8c48ced6d97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
