      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:753c3af51546db6a37c94a2b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "梦之旅",
      "source_fingerprint": "cf8724919ad561d2fc2975485b8a693f3f4ccfa3c3219ef0d80b886d506c1223",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119100.json",
      "json_path": [
