    {
      "uid": "zhcn:697e39a32aff21a99308022f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "どうぞ，遠慮なく仰ってください。\n貴方は私のトレーナーなのですから。",
      "source_fingerprint": "487feabf8a4aa7ab0b48b2f3ccd9f177687950590736850514e1bdd86455305f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119100.json",
