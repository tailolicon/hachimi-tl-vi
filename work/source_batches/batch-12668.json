    },
    {
      "uid": "zhcn:4aabe5b5a2d7097f2002f986",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "梦之旅",
      "source_fingerprint": "cf8724919ad561d2fc2975485b8a693f3f4ccfa3c3219ef0d80b886d506c1223",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
