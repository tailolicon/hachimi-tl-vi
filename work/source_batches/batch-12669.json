      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "そう思うと……\n縁のようなものを感じてしまいますね。",
      "source_fingerprint": "831425df9b4420386b8115d24653fd23be29ac75a831895eb84c81a41ec0f913",
