    {
      "uid": "zhcn:342ecf02fc5131efb29a01a5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "その日の夜――",
      "source_fingerprint": "d4c5eb2a84c9e982575d8e0ecd181e386b14bc6edb3a078c6e943395c62c7102",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
