    {
      "uid": "zhcn:ac37c269f6653525e0550029",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "ではまずは，デビューに向けて……\nよろしくお願いしますね。",
      "source_fingerprint": "f5250eae93fcc49b61013dcfa3075ab9d5c5dc22335b5065b43e534924cae358",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
