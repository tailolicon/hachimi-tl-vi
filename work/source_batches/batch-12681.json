    },
    {
      "uid": "zhcn:f58ea35d8ba6fec97649df42",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今日は全力でやらせていただきますので……\nお互い頑張りましょうね。\nウオッカさん。スカーレットさん。",
      "source_fingerprint": "e6ac3a3b17d8c50137c40312f2338d11c951ebeacf38b50e3fc82eb46fcceca6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
