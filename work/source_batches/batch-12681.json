      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "はい。\n……自分の心境の変化が。",
      "source_fingerprint": "35ba7100b42d889e8c8a4e1b12b1d07bf5b330e64c253558f5389a264cad5ba2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
