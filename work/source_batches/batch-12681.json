      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――『春のファン大感謝祭』。",
      "source_fingerprint": "4958c6a7e214d546c23c5108dd6809b596beb3f4fe94f42c9a9009a7196c557f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
