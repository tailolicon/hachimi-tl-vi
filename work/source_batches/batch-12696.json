    {
      "uid": "zhcn:bf878541235ee3239d8e38f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "先日メジロマックイーンが\nドリームジャーニーにもたらした手紙。\n送り主はまさかの“アネゴ”だったのだが――",
      "source_fingerprint": "8b67b2f3eda08a8e5ae5891dc959355f52fdfd39b26c5b0edc4ecb337c8e3ab9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119115.json",
