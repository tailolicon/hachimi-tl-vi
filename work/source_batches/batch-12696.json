    {
      "uid": "zhcn:e1b04cf7227ce29f1995094e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……いったい、どんな内容だったの？",
      "source_fingerprint": "ff65757aa9f46a3e91f703445a705ec8dbe930717c827836ec2181f71988ea88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
