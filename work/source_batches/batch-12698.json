      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……人気ですね、ブエナさん。",
      "source_fingerprint": "a9d5b91e8246fc285110241c21b9b2dfafa183fbef601dd9f5534afbd2dcca98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
