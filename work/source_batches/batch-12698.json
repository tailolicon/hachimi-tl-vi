    {
      "uid": "zhcn:af77854ee4f8ab758155bce8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "インタビュアー",
      "source_fingerprint": "45fec8ecd1a3c2e8e62e35ca00b2b64e359c20ed6c7882e809510ad380dda734",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
