    },
    {
      "uid": "zhcn:d0854a3ecafba591b9251f8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "世間にメジロ家の強さを\n再認識させたのだった……――",
      "source_fingerprint": "a0764aea507b0d20f417ca52a209f957c612d514fb9a6f3ca8cd5e20b6fa13e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
