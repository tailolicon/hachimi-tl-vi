    {
      "uid": "zhcn:e92533735dafee83e73e52f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "メジロのウマ娘って最近見なかったけど……\nやっぱ今でも長距離強いんだね……！",
      "source_fingerprint": "ef18ce2d06870f2ae7e2d70805db3e351fa4e48b0a5758c14e1c0d1e59eaf61e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119311.json",
      "json_path": [
