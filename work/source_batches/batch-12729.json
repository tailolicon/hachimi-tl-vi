    },
    {
      "uid": "zhcn:e7209b525b156dd30e1adfaf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "そうしてドリームジャーニーと、\n少しの間、勝利を称える歓声を聞き入り――",
      "source_fingerprint": "23dd4cc3887b8aae63a748963f668dda917d31f872277a3f54158a5eb06a1cf9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
