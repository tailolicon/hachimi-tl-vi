      ],
      "json_pointer": "/text_block_list/26/name"
    },
    {
      "uid": "zhcn:fb20c333670c32b9b8bfb08c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "ドリームジャーニーにメジロ家の\nバックアップあったとか、マジか……！\n思わぬところが繋がってきたな～。",
      "source_fingerprint": "7587ab28bb6bb833e533f77c5d2eaec8e6a4c9cbead6f5a222da871f19348178",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119311.json",
      "json_path": [
