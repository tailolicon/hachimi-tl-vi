      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "実況",
      "source_fingerprint": "c8c8677a84ba3062cdf09f6632d114bd46855d5163cc9a530d10ac56eb9417b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
