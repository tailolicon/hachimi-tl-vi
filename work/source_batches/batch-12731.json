      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:7030916bf547e46ba47dd342",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“嵐”と多く邂逅することを望むのであれば、\nこれ以上相応しい舞台はないはずだ。",
      "source_fingerprint": "40d370fa56b3534162eade54df1435d7e9a747feefd00a35e3436eb2c0471b12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1119/storytimeline_501119312.json",
