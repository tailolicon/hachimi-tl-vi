        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:b8875ba56cf6cdaff4938a3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "そして、彼女の望む“嵐”を引き寄せ、\n“一筋の黄金”へと至れると信じている……！",
      "source_fingerprint": "c0b32daca1e553106f58618fdc96fc2c4367b424a5f054b72b35e4994b1e4017",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
