    },
    {
      "uid": "zhcn:801e9dbc9d1a5b874b0b1590",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "终于啊……！\n我终于能参加闪耀系列赛了！",
      "source_fingerprint": "26bb939e566be252d36e533b00ef0f7042ae9684a263f4eb03d48d7accec9108",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129100.json",
      "json_path": [
        "text_block_list",
        20,
        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:ded8581f331a36d209c90d12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个嘛、首先――",
      "source_fingerprint": "d19e9d6a73d0c37c6e1cc76c074ac2ad6e4d6c18cf86c3c0a51398ea63fb9246",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
