    },
    {
      "uid": "zhcn:8d4d209dccca203483c5d33b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了制定迎向出道战的最佳训练方案，\n首先对她当前的能力进行了测试――",
      "source_fingerprint": "01f91fd189e4ae7084fb106b52251850f52a6c84e2a7c6a0827e5f338236a392",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
