      "json_pointer": "/text_block_list/21/choice_data_list/0"
    },
    {
      "uid": "zhcn:ce148416033931bf2d905958",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个嘛、首先――",
      "source_fingerprint": "d19e9d6a73d0c37c6e1cc76c074ac2ad6e4d6c18cf86c3c0a51398ea63fb9246",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
