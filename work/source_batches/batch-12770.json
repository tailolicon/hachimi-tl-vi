      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼……呼……！\n……呼！",
      "source_fingerprint": "a162a3cfccb6e3e16cd6c5d0c505d6db60014e409be3722b962f447600786fb5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
