    },
    {
      "uid": "zhcn:ad0c0d509d3261e166f87bb1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "过去创下的记录，\n会在未来由某人改写――\n正是这样的循环往复，推动其不断前进。",
      "source_fingerprint": "cdc138b2a84791b8a62a8ee44872e551210f061654f7b4010b4001d7e513f671",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129100.json",
      "json_path": [
        "text_block_list",
