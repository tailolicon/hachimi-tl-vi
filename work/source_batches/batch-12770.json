      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "闪耀系列赛会“进化”",
      "source_fingerprint": "97ce35149f5fad70b63753036e23cb677a6d28c86ab9fefc0278c30feabfcdf9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129100.json",
