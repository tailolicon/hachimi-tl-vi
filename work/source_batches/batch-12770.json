      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "再次请多指教、训练员！\n事不宜迟……我们从什么开始？",
      "source_fingerprint": "045a9e3e489ecdcd7137339f3aca592e6cebf2a34b7f3b71c59bcbf637ab68c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
