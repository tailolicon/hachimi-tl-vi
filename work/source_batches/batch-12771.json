      "uid": "zhcn:d5ccd329a84ce52c6aabd892",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――今后也请不要放弃。不要妥协。",
      "source_fingerprint": "fd08425652a1d31b4c29981637370a9e1aa66908f18f35efce1aa7fa1e05d426",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
