      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:3f2428843473e27bdb7b1396",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦……",
      "source_fingerprint": "c524e1aa103d713a1842c319d97cdfe411958060e89485e5c51acf957f52ec79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
