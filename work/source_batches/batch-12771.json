    {
      "uid": "zhcn:f7f1bb84aae7af042caf7f92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――你呢？",
      "source_fingerprint": "848895c83b2e517657ed5b3d77b4392e0c65eebb05e1844e2828cc4622df0185",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
