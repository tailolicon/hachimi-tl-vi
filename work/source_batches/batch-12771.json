    {
      "uid": "zhcn:4b312308e219cba75f87896e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好呀、我来为你实现！\n相对的、你也绝不能输！",
      "source_fingerprint": "9fc5a9350e022793c571679c542272f8393615faa9871f9ca5b19dd934f40274",
