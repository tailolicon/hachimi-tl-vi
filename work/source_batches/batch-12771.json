    },
    {
      "uid": "zhcn:675afd2750669435053b911c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呵呵。\n原来如此。",
      "source_fingerprint": "96733d2ae0802f6143e41468161916652f2c9f8d3b169836f3e9d42801a3fbe2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
