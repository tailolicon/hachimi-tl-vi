    },
    {
      "uid": "zhcn:b423207f4e707b974b34f57e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你的梦想，\n就是我自己啊。",
      "source_fingerprint": "f06a0ac0317114e0f480a697f8f407309834c4b936276463031e776c550b3f45",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
