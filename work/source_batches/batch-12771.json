    },
    {
      "uid": "zhcn:11ac88dc436ddbe2a8e647f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……明白了、我发誓",
      "source_fingerprint": "3f9a32283b1928c090b7014dcf5c769e5ee11cd40a394a4c65f28c2b4c656c49",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
