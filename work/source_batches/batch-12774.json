      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（――两人都绝不回头）",
      "source_fingerprint": "c117c58c4a71b42f729478f8d570033888b3b4b618dae4d414d96ff814260dce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
