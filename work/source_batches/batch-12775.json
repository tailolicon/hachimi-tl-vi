    },
    {
      "uid": "zhcn:e7b6dd70692df9877c295c8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，和北部玄驹聊着聊着就到活动时间了――",
      "source_fingerprint": "8aec4d43f8a5cd98f61b9219b625ba2bbcbfbd2c0dbde54bff8d8cc15472ec9d",
