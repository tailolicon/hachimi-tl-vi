    {
      "uid": "zhcn:a012bd9a00643748e5f88052",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后就突然想到了小杏！\n身体能力这么高的你来做的话，\n我们很好奇会有什么效果啊。",
      "source_fingerprint": "a64f0a1592c0e7edff9bc3a50cf6159276e8f4ea2d385029485c2d3f0b81834f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
