      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:ccb08c589b50e38dbb4f92c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（…………吁！）",
      "source_fingerprint": "9dada6ba8922f720f4f7d6e0c93919a5e77660a68705233971b704bcd6a355df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129114.json",
