      "source_language": "zh-CN",
      "source_text": "心想『为了赢该怎么做』。\n……无论如何、就是控制不住！",
      "source_fingerprint": "72b3babdba9e7a27cd50f3dcf08b08a3b3ca53e3c9ed81118d6a27f5bc9a14e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
