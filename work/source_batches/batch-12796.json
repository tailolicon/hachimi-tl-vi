    },
    {
      "uid": "zhcn:d3cadaaf654bae4f49fe232c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，为了解决出迟问题，\n我们不断进行提高起跑专注力的训练――",
      "source_fingerprint": "63dac7ea78f6f0d673809e531ceddbddcc10fd08df8cae26ba848b0806117894",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129114.json",
