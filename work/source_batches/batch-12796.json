      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为什么呀……！\n出道战明明不这样的。",
      "source_fingerprint": "4f83b51142a5163acc168d90051ed611ed1344ffe286b8fdaaa4b3f7af3c8dac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
