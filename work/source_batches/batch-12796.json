      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "房一潘多拉",
      "source_fingerprint": "52993fdc193e0304fbd481bac97e74dd6321661ebbd4f661d89756a66469442a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
