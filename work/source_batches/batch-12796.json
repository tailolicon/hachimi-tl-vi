    {
      "uid": "zhcn:a63c71826520b4f9dc4b45cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好、随时都可以！\n――请吹哨吧、训练员！",
      "source_fingerprint": "d46f6c830be6e9347e75d002af0b3cbdc5fa88178e0b67b750eff5cbf71588b3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
