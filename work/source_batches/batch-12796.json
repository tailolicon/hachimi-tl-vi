      "source_path": "assets/story/data/50/1129/storytimeline_501129114.json",
      "json_path": [
        "text_block_list",
        55,
        "text"
      ],
      "json_pointer": "/text_block_list/55/text"
    },
    {
      "uid": "zhcn:9ad89df9f327fa9bdc0614cc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要好好集中注意力就能反应过来！",
