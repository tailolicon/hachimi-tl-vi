    {
      "uid": "zhcn:966f82144fa74bef95479459",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呜……！\n明白了、再来一次！",
      "source_fingerprint": "77251eaf41b59d24b1f671ffed49976fdec372e7538381d0287ab875a4760465",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
