      "source_language": "zh-CN",
      "source_text": "想着唯独这时绝对不能输\n――然后赢了自己的时候！",
      "source_fingerprint": "46d8b5993b713233f34ceac3d3b761252ecd68d8600edb2729b726c40093c9b2",
