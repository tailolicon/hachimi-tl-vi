      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就算不顾身体，也想要奔驰。",
      "source_fingerprint": "9b4ee7555fe50607719339a2d8ba96bab9b91284567772fd59dee3ba63543029",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
