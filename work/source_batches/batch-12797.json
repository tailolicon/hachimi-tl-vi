    },
    {
      "uid": "zhcn:a9788e036fea70a49f7454ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……稍微和她谈谈吧）",
      "source_fingerprint": "e8abd227f8bde6ebd7296784ce1283fdbfac88f40dd3fc3f6002fbd65de65c28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
