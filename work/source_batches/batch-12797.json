      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呐、能理解了吧？\n为了能品味那种滋味――",
      "source_fingerprint": "118c22903fdf88fb59c046aa52f87c14af8e97ccdd1e48f51180ee5e553c02f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
