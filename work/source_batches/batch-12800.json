    },
    {
      "uid": "zhcn:195d5cd0274d6f4cd9602ee2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊……是拉拉！",
      "source_fingerprint": "a96e2d3d82f25163fbf4fc74546d3142cd307a15a964d529c0d650afd20b21fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:cc36eed4df39ed4195f2ed19",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁今天获得了第二人气。\n第一人气的孩子和她同样赢得过重赏。",
      "source_fingerprint": "3dd7aa96ace358639914d749e90cd0d262d10995c4cab4edeb5b42d96ffd6942",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:e80d6ad04f1c07bd80aa7880",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一人气的赛马娘",
      "source_fingerprint": "91f891b9f3aca9c1f75df1f99e7327c470ec51dc90cdfa769f6eb74b7cf22e09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "text_block_list",
        8,
        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:c11f1dc62180f45edf1c0a99",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――请多指教啊、拉拉！\n同为憧憬巨匠大人的同志，\n我们要努力更接近她一点啊！",
      "source_fingerprint": "a0155616312b5c8a583a6dcf288b4fe37d2e13640c50f93406b25f5f06dd8617",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:f9831edad23d979ce0f96d83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
