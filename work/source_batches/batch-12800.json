        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:cb8047cce96106e1a14d851d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目",
      "source_fingerprint": "b632be927b5d52ab85b0cfae236cdc76e44b41d48ba6e925027a4013417d1d5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "text_block_list",
