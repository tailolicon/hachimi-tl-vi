    },
    {
      "uid": "zhcn:cb1723ad2a48de4cf790c4c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……去不去『秋华赏』看你心情",
      "source_fingerprint": "7b3e03d7fb060d46d359fce4466512b97f938db78f151e57d94d07da333d320a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
