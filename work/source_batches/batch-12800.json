    },
    {
      "uid": "zhcn:0e00defe7a3054c5df4a6267",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……接近。",
      "source_fingerprint": "d3fb6ec205a94e73c384c2afd683f819a6fb3cd5ef5cc54ff29450d0fa38ccf4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:c55c4ef78ed69ecd708c6ad0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "紫丁香花在呼唤",
      "source_fingerprint": "d9f8e26eb2e4ffcd8fe589ea48808a42044624b1d43e7a6402abd9433b141429",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129116.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:8614081d05a414733cf1d209",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我打开窗户，吹进来的风带着些凉意。\n马上就到――『天皇赏（秋）』了。",
      "source_fingerprint": "02cad535ac68f523bf24d87e8a7a313d6d8d19e7a7afa22319d29144720e2d0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129117.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:93a72004b680138b6332f174",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（准备已经万全。即使如此……）",
      "source_fingerprint": "ac104f316749ca250e14c33ad23c8d98bac9123c2761177cfbd2b47ccda41489",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129117.json",
