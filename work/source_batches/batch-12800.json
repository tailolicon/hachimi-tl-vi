      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:9c9f374a903795769c551c87",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，也有过那样的事呢",
      "source_fingerprint": "5bac36ee0324fe504ccf8a388146eae625b69911e578cf5f52aa81b2bd316e09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
