    },
    {
      "uid": "zhcn:e1ee0aff8cf926febece2d63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目将进军草地GⅠ8胜，\n还是止步于此呢……终于要迎来结果了。",
      "source_fingerprint": "d8bb609b0c36a3ade667baf2f36af2029c542a3ac336f865a78a2170c6035a70",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129117.json",
      "json_path": [
        "text_block_list",
        1,
