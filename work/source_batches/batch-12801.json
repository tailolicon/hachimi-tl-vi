      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "换言之，你在质疑我的实力――",
      "source_fingerprint": "affc1243fb401cbd6b215cdeb2277d2baf1d0e95a808e95bb9a3d42196dc1c1a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
