      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为，我们……\n不是一起努力过来的嘛？",
      "source_fingerprint": "51a4832696b5f104deff50d00aae39698dc22946b8991bc2b416b3b7295be343",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
