        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:f33e6364ee39e45d371cd8ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！",
      "source_fingerprint": "98739b95ccd71250c93eb093e8d38baf3f898a648b1a0e49967a79cf39a4611a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
