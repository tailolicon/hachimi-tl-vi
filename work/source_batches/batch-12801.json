      "source_language": "zh-CN",
      "source_text": "两个人一起分享的胜利，\n可是远比一个人……还要棒的多啊！",
      "source_fingerprint": "d9b650c0763d9ae9df52b9f3f6f41a7e2bb90986a1610a2547f0955e2cfd0918",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
