    },
    {
      "uid": "zhcn:32bed507446a8076d6bec717",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这一带，\n训练结束后也常来呢……――",
      "source_fingerprint": "05a628ab9d9beb9dc80f2ae3443c813e0fa209fdcc9771f6b1daa1dba00c7c97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129117.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:d7cf0382f73fb281935574f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "笼罩内心的阴影完全消散了。\n留下的只有――两人一起赢得胜利的决意。",
      "source_fingerprint": "85681a1af0d25193516e8672d7690eb45bb30d0107d9528b764e3c5cbb43f080",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129117.json",
      "json_path": [
        "text_block_list",
        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:18975108d3ac90a2bea738a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "？",
      "source_fingerprint": "d6a4e79b56c212bb6e83b3632ed432fc67c2aff81a7fc3d2f1c77cf669cea254",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
