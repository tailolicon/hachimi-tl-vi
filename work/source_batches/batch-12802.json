      "source_language": "zh-CN",
      "source_text": "……呵呵。",
      "source_fingerprint": "6f83c9c6f76bfe968eb0cfcbbf2cdd58ef69d323a0b49631c6c32f1d51e6ccde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
