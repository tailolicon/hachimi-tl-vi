    {
      "uid": "zhcn:c1376f4cb5b58c4788380f62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目充满了可能性。\n她能做到任何事――\n直觉是这么告诉我的。所以――",
      "source_fingerprint": "36c592dcb1c06cf8203acfaf30539604f85392ea19136a43af877d8acd5741db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
