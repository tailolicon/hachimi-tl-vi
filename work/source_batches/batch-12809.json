    },
    {
      "uid": "zhcn:3b311893ea20212783498971",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的功绩令人惊叹。\n不仅达成了三后冠，\n更在紧接着的『日本杯』上――",
      "source_fingerprint": "aca082478fff0b754f20229e958a40775179a64423aacab8e5d7b3a00f74a157",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129205.json",
      "json_path": [
