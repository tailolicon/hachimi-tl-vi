    },
    {
      "uid": "zhcn:c24c723a54c22b423cc2b16e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面对当时君临顶点的，大一届的黄金巨匠\n――作为经典级后冠赛马娘取得了史上首场胜利。 \n",
      "source_fingerprint": "38f627061b4c5c25b70859301e48cf9f320f39d4ed7549e1225a2d05585394de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129205.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:06af65914cf78dda3db57322",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们这边也想要点建议啊",
      "source_fingerprint": "b976374e644177d47d851c6102dcf73567fe0806c1a812aad443395eda57afdb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129205.json",
