      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:4360f09df3749fbfd4d36776",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今年的『日本杯』同样有\n诸多知名赛马娘宣布出战。",
      "source_fingerprint": "b0836f61deccb6f2ddac2f44a0e9ffa2cd8311ab33b7f27a46f1c1dfef0ea5ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
