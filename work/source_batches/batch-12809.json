      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "话说！　大家都是朋友，\n真想给所有人都加油啊！",
      "source_fingerprint": "15ffe09adf2110594a8539559c2a5f82e4f40c06090ef93963b6b54dccabaeaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
