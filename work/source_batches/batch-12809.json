    {
      "uid": "zhcn:9e32dea2e5214f797ea0288c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "距离『日本杯』还有几周时间。\n我和杏目一起商讨着比赛对策。",
      "source_fingerprint": "cc2eb20ad97c6ca05210eabfe16adea8d292429c5e5edb7b80564ac5219457ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
