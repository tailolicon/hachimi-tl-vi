      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是说……她是在和现在的杏目相同立场上\n达成了伟业。",
      "source_fingerprint": "fe2cc331a348bf9f51a77cce58e7dde03d287094008d74e18dfb8ac2f24ca4c3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
