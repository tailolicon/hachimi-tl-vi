      "source_text": "……呜呜噗哈啊！",
      "source_fingerprint": "e272a9464cbd3bb01b58a08583391dc23e82bd5112e3758869e0cb4763840696",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
