      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――感谢大家过来帮忙！\n今天可能要麻烦大家跑很多次……\n拜托各位了！",
      "source_fingerprint": "4fe8e681ac91bdca26f19c41251cb5857cf0615a2357232ec293acc569318b55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
