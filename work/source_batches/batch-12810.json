      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第二天，我召集了以机伶金花为首的14名赛马娘。",
      "source_fingerprint": "4e96c14bf1246d0ad2e972a15706422f4739023f238be0aa1e36bd41f0fc3acb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
