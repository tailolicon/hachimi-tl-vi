    {
      "uid": "zhcn:7ef5cea450bbb22c9e2155b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呜呜～……。\n是啊……果然，不行呢……。",
      "source_fingerprint": "427d87ebaee00b1b134a83a9f8ea6bc5aa20e824693057553d5e422265446f39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
