      "source_path": "assets/story/data/50/1129/storytimeline_501129205.json",
      "json_path": [
        "text_block_list",
        60,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/60/choice_data_list/0"
    },
    {
      "uid": "zhcn:843b1bb0eb0f9c1174228a55",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就在这时――我突然想到。\n她的精神强度说不定比贵妇人还强。",
      "source_fingerprint": "e6bd282926974ccc7dc313e5055f03836771024735d6a826041042189535fa78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
