    {
      "uid": "zhcn:ed1741315cfde63995183c33",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不不、你很努力了……",
      "source_fingerprint": "ab58ecccf627efce9ccdfb3c6a5869bad89ac8086359034bfee3533791e6c282",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
