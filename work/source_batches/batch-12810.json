    {
      "uid": "zhcn:769e8bac6e6ff8debf96460b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我一点也不怕苦！\n能帮我重新制定清单吗？",
      "source_fingerprint": "669e43fa9c142167207be84b1f3c62b94b3069df02f9b2c336c8ef8082dbb0b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129205.json",
      "json_path": [
        "text_block_list",
