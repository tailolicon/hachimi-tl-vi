    {
      "uid": "zhcn:137aeec1d1a71d45a4f6d3db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那要不要换个方法，\n施加同等程度的负荷呢！？",
      "source_fingerprint": "3e3f9a312d629a66f097f0ea91883441c8df124e8a9c4bd8bc19b292d7597c27",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
