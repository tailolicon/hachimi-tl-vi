    {
      "uid": "zhcn:2865264aaedb892893b71ea4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（那孩子，还要继续练吗……）",
      "source_fingerprint": "108259b1267fa44bcfe95c8eab6a08f0e8e7bc63405c5c03eedc9e6b9d0996c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
