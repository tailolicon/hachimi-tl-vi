      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那来做一下回顾吧",
      "source_fingerprint": "f04087918be346d16013fb9b24482a71ae39982212aa618593b9ee404fd32152",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
