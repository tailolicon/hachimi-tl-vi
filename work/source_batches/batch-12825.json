      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的身体与心灵，\n好像开始完美契合了！",
      "source_fingerprint": "8bfabd8af3dea377a16e493e657816e6c3a6943a3fa4ae97907f2ac9185c0b63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
