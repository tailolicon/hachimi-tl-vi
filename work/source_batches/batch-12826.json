    },
    {
      "uid": "zhcn:c9f7e9abe75af8d4f3bfae6f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为后冠路线出身的赛马娘，\n首次赢下了『日本德比』。\n――颠覆了比赛界的常识。",
      "source_fingerprint": "5f96a755e6e7005dc3b34e45f264ee3af8a77ef07b01e71d5d60688283a3f788",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
