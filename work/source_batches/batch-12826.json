      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在所有的收尾工作和记者会结束后，\n我们回到特雷森学园时――",
      "source_fingerprint": "92fafb3a4bbe7db0d775af03241be581b52dd16e2add93f593c3b7fac8b4bb77",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
