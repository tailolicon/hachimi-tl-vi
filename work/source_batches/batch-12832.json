    },
    {
      "uid": "zhcn:f3da2178d281dde4910528ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（――哪个都不是“杏”的伟业）",
      "source_fingerprint": "a47166a45702eeb66c66622b7772e0e6cfdae35ab54803efc432886570040313",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
