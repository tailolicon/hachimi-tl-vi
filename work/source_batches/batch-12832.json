      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……OK！　那就等你把心情整理好之后\n再决定下一场目标比赛吧！",
      "source_fingerprint": "673d9ec76e251e50e73ecc11645777af525d232458bceacb7476ff30b9102120",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
