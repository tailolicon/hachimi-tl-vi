    },
    {
      "uid": "zhcn:1c6d8d539cf0b245f96579cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "仅凭『强大』是无法永存于世的。\n必须与被称为“最强”的赛马娘们并肩――\n不，要达成超越她们的伟业。",
      "source_fingerprint": "cbc70ccdca2cbad3818ec39eb198e11c3a61d78023fe223d0e5ba045ecfc2e35",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
