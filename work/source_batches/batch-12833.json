      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（果然……链接着“这里”吗）",
      "source_fingerprint": "b17ddd2d6932663de3c3f5cdc0f3c779b5fcd08c6295cf13e9cc353922f997c9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129309.json",
