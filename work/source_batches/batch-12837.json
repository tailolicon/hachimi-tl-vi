    },
    {
      "uid": "zhcn:14719a8ef8a20184f389eeb4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯独爱你",
      "source_fingerprint": "9399f1eac3e90e02e56c05a130bf24bc0c3867f6772ed5a8ee1c325df7f0f243",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129311.json",
      "json_path": [
        "text_block_list",
        6,
        "name"
      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:93e81963e1a359e3c0c03887",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……果然厉害啊。\n我们必须战胜那个人才行……。",
      "source_fingerprint": "582abf4474aca38198ebee301bff557605c1e338071f7ddab190b878a8ec0182",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129311.json",
      "json_path": [
