    {
      "uid": "zhcn:036cd30d578c3f9c5b1dee1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！？",
      "source_fingerprint": "c852f2a372d80446b99a7c7fe3b82ec07bab9faf8d327ec068aaf7f7392bf0c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
