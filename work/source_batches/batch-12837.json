    {
      "uid": "zhcn:3929bfbe074f54c684849993",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我能一直，这么开心下去！",
      "source_fingerprint": "8968bb43d98af8431890720f6d517bae389056c1cae484f3a1258e7fe6a659a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129311.json",
      "json_path": [
        "text_block_list",
        59,
