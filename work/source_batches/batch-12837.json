      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――所以我没事的！\n我要参加『安田纪念』！",
      "source_fingerprint": "ae6b8a0aa897d76104db673919add7ec343519b9b0f23d8dff8abc97f4e62221",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
