      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……啊哈哈，语气好怪！\n讨厌，都让你逗笑了。",
      "source_fingerprint": "be3558350f966f7cf512a86da34f60cbf04a3b5e0dadc3f5f46ddef99929229b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
