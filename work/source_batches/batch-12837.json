      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯嗯。\n……谢谢你！",
      "source_fingerprint": "c029210e40010b6a234b74c370284c40b906a3c811492423a980e6726b1cd89e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129311.json",
      "json_path": [
