    },
    {
      "uid": "zhcn:3838c2b098671caedcb9021a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑了这么多比赛……赢了这么多比赛！\n马上又有下一场，所以能更努力――",
      "source_fingerprint": "7811352ffe788ec161c170c1e10bdd9adbb0396b8a05d2b60f4f29b1deb88dfb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129311.json",
      "json_path": [
        "text_block_list",
