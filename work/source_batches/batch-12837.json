    },
    {
      "uid": "zhcn:69461657a5f2b6d3356e47f4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就放松下来，好好乐一乐吧",
      "source_fingerprint": "a3bd6d7c0c6185a20010ac879b4f491c98f6c03dde13de685183d375684d1a24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
