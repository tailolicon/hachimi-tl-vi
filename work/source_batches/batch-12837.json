    },
    {
      "uid": "zhcn:ff7464027ca70ee488cb9f11",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想赢得、更多……\n更多…………更多！！",
      "source_fingerprint": "2594cf80a726bf29bf7f02038ed718dedef3a8692621e0ca56c9910600c6b993",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129311.json",
      "json_path": [
        "text_block_list",
