    },
    {
      "uid": "zhcn:14b6e67411a8e6cb744ba8ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自从『维多利亚英里赛』之后\n我就一直只关注他的身体状况，\n完全忘了这回事……！",
      "source_fingerprint": "b5f40eebcabc7d13a04f89ebf015ef172cefa41614ae515aabac1ff3c023c570",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
