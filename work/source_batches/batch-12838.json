      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是――如果有人会为此高兴的话，\n我现在觉得，自己也会想着去打破它！",
      "source_fingerprint": "f53a8ee9162151b369d2c328acb4d38d87f7432b10d3766583a080cfcb8469b3",
