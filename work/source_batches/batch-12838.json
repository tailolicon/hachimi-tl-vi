    {
      "uid": "zhcn:6df880082a4660a821f45c89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，杏目选手您是这样的呢！\n数字无关紧要……但是――",
      "source_fingerprint": "e763e8cc2186d6db729fe18d69aa98ecbf00ad230c67b2da7aeea9c61857fd36",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
