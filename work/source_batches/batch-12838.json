    {
      "uid": "zhcn:85d65366c7cb52c1db79ef2d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们无论如何都忍不住去梦想，\n梦想着您冲破那道高墙……！",
      "source_fingerprint": "3afe6a18dee4c3897f53b54a275c4574ea7197b9e8e7ffff55d6b496dd941f89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1129/storytimeline_501129312.json",
      "json_path": [
