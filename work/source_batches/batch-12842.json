      "json_pointer": "/text_block_list/31/name"
    },
    {
      "uid": "zhcn:8dd0b0b1b36f074f6d452285",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "用绚烂华丽的奔跑，为观者的心涂上感动的色彩，\n叫人目不转睛、魂牵梦萦……。",
      "source_fingerprint": "c544eb879d15e7d393e519b8117e4d161ebde657564e912d745c5dc9c9cd3a79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:34caec03118f96c9fb3330e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
