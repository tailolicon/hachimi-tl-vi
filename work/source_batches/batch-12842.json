      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:efa90e22e938f968998d57c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咱想要成为那样的赛马娘。\n……比如说――",
      "source_fingerprint": "667f231bcad9aaacee9826e0d140d0783cf0af7c2ccd0e2cf8a26fee096c1b1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:977ed0651672d96ab7088f66",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        33,
        "name"
      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:c7ab45bfcdd99820f6d837a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "像黄金巨匠前辈那样。",
      "source_fingerprint": "bbbcc65b9523af5e25416a1a9e01bed1e1b893e5ac70d9e11cdb31397f03f564",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:7bd1f5325157b051288526d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……“暴君”、黄金巨匠。",
      "source_fingerprint": "63a0b1848b554c20f96a209b1558db5dbf79914ea89e0b4bf40af89da966bc75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        34,
        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:ef20ba2b8a6dfe643863e774",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『皐月赏』『日本德比』『菊花赏』\n赢下以上全部比赛的，\n史上第7位经典三冠赛马娘――",
      "source_fingerprint": "e0937c9d34a5720d3bc2d1f3bb7a2f2e5ea30385d81dbe9495b6638d1bbf1248",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:fb4084ceec9230fc30297e4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "GⅠ总胜场为6场。\n在世界级赛事『凯旋门赏』留下了\n2年连续第2的惊人战果。",
      "source_fingerprint": "e92288aba5534e66016db5ac048c0b7a455eb0b742127119976e6ccb3cdf2287",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:75459a0fde318d661e7695e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在比赛界熠熠生辉，\n是名副其实的传说级赛马娘之一。",
      "source_fingerprint": "f1ce0557cc42057cbafb697832da9b89f61c4efdee6f696a64d1816afeee6a54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:8ae0fc7308235c522f394330",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在签订契约之前，\n旺紫丁为让黄金巨匠认可自己的奔跑，\n曾一次次地向她发起挑战……。",
      "source_fingerprint": "eedcea7507cdbd49eb4c27917dcafe4c1487f642def46225c42cb680f064399e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:fc46926e5de6c0a16eed9302",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对于旺紫丁而言，\n黄金巨匠就是这样榜样般的存在，\n是她憧憬的对象――",
      "source_fingerprint": "40a8bb49c45adb9a898e4c94245707b05545167434cb5d388137e8593ce48cf4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:a9c8a2457527775018ddf2bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对不住对不住，光瞄着破记录了",
      "source_fingerprint": "ac2a095859642d1d999d9bf68263b0901a7fb98a0e8f9c5b87c94c73e5c9efd5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        4,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/4/choice_data_list/0"
    },
    {
      "uid": "zhcn:d779314ca4c1467d482d6fad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:380b18946a5d0b63b3c3baf3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还没自报家门就完事儿了是吧！\n招呼都不打就想开溜啊！！",
      "source_fingerprint": "3182238d92bf60060c0663b65c18f51bcc2e9e65249d8aaf1e9c8d5539632cf1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:867a4d14236fd83162232c3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "紫丁想走上和黄金巨匠一样的路线吗？",
      "source_fingerprint": "8bab437315521d9e83f196a191d3ea172b7e7303baecb1ef0567f304b84c6129",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        40,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/40/choice_data_list/0"
    },
    {
      "uid": "zhcn:1338026572182e6a93ae8dbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……而正因为有如此明确的憧憬，\n我才有件事必须找她确认清楚。",
      "source_fingerprint": "b417118d7db643d3e7d2c38e36016ec622bb429fcc2b78de8701f000e3adcc79",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:5edf35c1f6fe5973dd98c920",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        41,
        "name"
      ],
      "json_pointer": "/text_block_list/41/name"
    },
    {
      "uid": "zhcn:2801a623705e93ba4ef70052",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……――",
      "source_fingerprint": "28fbf0e5a46c7053545bcf1401c5e72875bd0100c361792176d130bc7eddc9f0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:3e26d78319d68f285a1bcd94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……在闪耀系列赛里，\n有着两条大的路线。",
      "source_fingerprint": "3ffb3fcd63c65da58a8a1311c63eed07ebfd03f24274cc0039ebb7b6a429d82c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:f23941d58f7ee4231d859e0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "其一是『皐月赏』『日本德比』『菊花赏』\n这三场为主要目标比赛的『经典三冠路线』。",
      "source_fingerprint": "ca88f4a72063fb487be855bd54a42ac706e5c174acbcadb790a3356d48d3b727",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:f6e02e92b4e44506e5c2e553",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与之相对的另一条是以『樱花赏』、\n『日本橡树大赛』、『秋华赏』为目标的\n『三后冠路线』。",
      "source_fingerprint": "3f3a45c597f29091905f7c9319e22fb176929ce1052e548a544bd5028c47e1e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:bd4f6bb8a370bd886c119c22",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我刚才向旺紫丁提出的问题就有问她\n『这两条路线你想走哪一条』的意思。",
      "source_fingerprint": "4167f1d0b6aa6bdf4c17f9c1ef70037af1f786f9fe03245303f273acb213e68c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:c7223a8cc755a2cc317c9e1f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        46,
        "name"
      ],
      "json_pointer": "/text_block_list/46/name"
    },
    {
      "uid": "zhcn:05d8c4a2d512aa044af2c6ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……巨匠前辈于咱而言\n的确称得上是一位原点般的存在。\n但是――",
      "source_fingerprint": "33e117bbdc614bfe4c13410ebc8ff90248bc833abf81b9b5a29f5a9459bc49f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130100.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:f3cd18ecb3773b1e49cd8fa7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
