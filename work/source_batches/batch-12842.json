    },
    {
      "uid": "zhcn:c9284d9aec29e6685c17461e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "知道了。\n……咱所向往的，是比赛界的“明星”",
      "source_fingerprint": "6ba7813bd222007f925aec0da8f9520205abdb67f8e43a3ae097dcb9b75c165d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
