    },
    {
      "uid": "zhcn:8335a618889060b63c14a0fe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要庆祝、是吗？",
      "source_fingerprint": "bdae9cce1e8af688141eb4a667f17a3c699d1a154ece2bf2d165ce699412b63f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
