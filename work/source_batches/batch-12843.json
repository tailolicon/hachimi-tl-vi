        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:6de260bdd0325984dc867c32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对三后冠表现出强烈意愿，话题性也极佳。\n当真是一位光彩夺目的新女主角啊。",
      "source_fingerprint": "8d9ce04428fd644a5a50cc1823eebe640df4701806d59b91d7ceb38d699c7e47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:1e1ad0b624f1e660a2ee3ec4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……在台上侃侃而谈的旺紫丁的身姿\n的确散发着无可置疑的女王气质。",
      "source_fingerprint": "ad0e7212d7709de9bebe5026772e97e80583f8fa30f0f8f1aa0e97582bed584f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:4056944b14974eb28bc2d3d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为立于她身侧的训练员必须端正身心。\n在这场颁奖典礼上，我重新立下如是誓言――",
      "source_fingerprint": "6bee3b9282d9865c9cc657e7b90596c4762f032097686b7f5699fdfd3782a018",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:1c46eba8a98cd1b5d55a6c0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――翌日。",
      "source_fingerprint": "012af4226e129d701f48dbb66a16b57736b8d1a589caff3040203dba500deeaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        13,
        "text"
      ],
      "json_pointer": "/text_block_list/13/text"
    },
    {
      "uid": "zhcn:08d12ab9824dd447371d0ad1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，为了庆祝获奖的贺宴！",
      "source_fingerprint": "31a8b4c2bac01c5358129eb81fd74d0cc814104aa5ba7c0b06f4a95164790e0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        14,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/14/choice_data_list/0"
    },
    {
      "uid": "zhcn:893885aec3cd30efdb55d288",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错，为了庆祝获奖的贺宴！",
      "source_fingerprint": "31a8b4c2bac01c5358129eb81fd74d0cc814104aa5ba7c0b06f4a95164790e0e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
