        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:860ae8ff746d99e9d64c6b96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……回想起来旺紫丁在新马级那年里\n始终过得克制且刻苦。",
      "source_fingerprint": "e6c9f04ceb689ddacc9a13b4f1a4ee746704542b96a3ded36a39da5fa169ee94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:c3a3f58ee44d71b92b1417ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "端正身心固然重要，但同样的\n在每个荣耀时刻尽情欢庆也很重要。",
      "source_fingerprint": "0e06da68dc0ddfc003b0945af13c209fdf1ce187febb10203996bba1a376b4a7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:de4fddd47c880bf87298ffe0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是我想让她好好庆贺伟业的同时\n兼做适当的休息提出的想法――",
      "source_fingerprint": "96c7d41be1045421f35f12e576d02bb12f6fac82f3f64db8f25595238647868c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:456a53beee162a85f0d3353b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
