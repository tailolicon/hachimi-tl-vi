      "source_text": "――接下来，有请荣获\n最优秀新马级女王赛马娘称号的\n旺紫丁选手入场！",
      "source_fingerprint": "bb28a260a092a1d83938f40bf75e27780ccb33aa29b0fbe6cdfc13d8aab866ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:6b9528642c0f6bd4aa2753f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "参加者B",
      "source_fingerprint": "4a2723c0ae87448ce422c1f52f525f73f2833ee2bc8c93e24b917ba5fe34467d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130101.json",
      "json_path": [
