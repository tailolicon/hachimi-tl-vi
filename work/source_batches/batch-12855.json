      "source_language": "zh-CN",
      "source_text": "在旺紫丁的催促下我打开了礼物。\n里面的是――",
      "source_fingerprint": "8b69ec30864b8e6c682e1e43f1f78cb02b15ac2993085912e8c01f74c394ca9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
