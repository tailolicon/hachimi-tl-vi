    },
    {
      "uid": "zhcn:90eabc3335b73e1e5034926d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（哇啊啊啊啊啊啊啊啊啊ーーーー！！！！）",
      "source_fingerprint": "0e21512262b6adc7c12c654dd32e4761a099b4ab1cfb56cc62cf0a21d2326f9d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
