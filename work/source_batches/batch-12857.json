      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:64d4719464864b79ab3578c1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "并肩之花，绚烂绽放",
      "source_fingerprint": "44877816d04ceb4f59b31f82b0850e5d48eb143eea88a5e7cbddcee4daa89e5c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
