    },
    {
      "uid": "zhcn:15b05084765c68773d74d8ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁！！\n杏目！！　获胜的是――！！！",
      "source_fingerprint": "700708330321da6c3be676ff55c4093b1b47bd63859a445f118d6de7ac396b80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130111.json",
      "json_path": [
        "text_block_list",
        5,
