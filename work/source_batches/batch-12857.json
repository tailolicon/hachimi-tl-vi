      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在咱的身边。\n一同欣赏同一景色。",
      "source_fingerprint": "33ff9371a85746a76726b0bda28406894697be2ba49babdbb5cebd234784e714",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
