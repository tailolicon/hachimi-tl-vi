      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:0deae0a2d6e35c58041d7996",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们真的好厉害敌不过啊……！\n两个人都太无懈可击――",
      "source_fingerprint": "721ad95209da9eefc7b9234b5d8303d73d9d0e007c569a34b8097ff38a2dd9ea",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130111.json",
      "json_path": [
