    {
      "uid": "zhcn:7062de4a61516b106fed1739",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛粉丝A",
      "source_fingerprint": "f569583d3ca1bab11e2cbb4d06c211c3c0034a5e4db136d3fd6be432e740c337",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
