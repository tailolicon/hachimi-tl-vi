      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:fa9da41be8a3b4ff34ceace6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯有，站在我身边的她的吐槽\n依旧那般犀利，依旧那般温暖――",
      "source_fingerprint": "523bcff4c596419d375ad64233f1e2e0f408ca98a7c814041ebe78b6b7aba6a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130111.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:706749095b1de8f25a29c1e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在夕阳的映照下，\n宛若一朵绚烂绽放的丁香花。",
      "source_fingerprint": "25742a1df8250eb93bc91782b0572ea238c3ac328439c1a0d56aaff5033196f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
