        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:6471aef98b9ab83e37e03cb1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯独爱你",
      "source_fingerprint": "9399f1eac3e90e02e56c05a130bf24bc0c3867f6772ed5a8ee1c325df7f0f243",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
