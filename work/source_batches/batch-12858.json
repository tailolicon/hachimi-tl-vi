    {
      "uid": "zhcn:6a78ae85e4e3c668ef6d4f58",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――您看、景致前辈不也赢下过『阪神JF』嘛。",
      "source_fingerprint": "2a2f0d52691066e014a5c7a4396f0764362027c5c05c5ceb546f8d7ac52fe74d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
