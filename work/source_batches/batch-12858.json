      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没有啦。\n我们不过是闲聊几句而已。",
      "source_fingerprint": "492e0a2d29238db0513a0c1e3b1fda30291636402afc22a43f54ad473ebcc924",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
