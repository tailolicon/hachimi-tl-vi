      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:e0b5cc7ab1a8d4a4947a89da",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁是极为优秀的赛马娘。\n天赋异禀的素质、对任何训练都\n默默坚持的强忍耐力与认真态度――",
      "source_fingerprint": "348450386b079a4bfb6c057ba09c3b05fb076d85f0be50f5553a269ca50f9ab7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
