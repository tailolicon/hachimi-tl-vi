    },
    {
      "uid": "zhcn:dcc2f74dcb43f18cf3bef127",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咱定能承受、必将证明。\n待到『阪神JF』之时，向景致前辈――",
      "source_fingerprint": "e4a9975f7ea79c8d5b03b345c7267d016cbdcf5622d2bc61ef2bb50c57c6e3da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
        "text_block_list",
        61,
        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:63f1433d95b7aa5f5d814d3c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不愧是你啊",
      "source_fingerprint": "e3a1ff7e0bd2b13dbf66598fbb160940fd2785168071445773160f2ae9d88612",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
        "text_block_list",
        62,
