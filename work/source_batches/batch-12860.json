      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:0c43a4d131aeaf849e4f64dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
