      ],
      "json_pointer": "/text_block_list/59/text"
    },
    {
      "uid": "zhcn:96e23043291cb0d3a09d0db8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁身兼如此之多的长处，\n身为她的训练员固然倍感可靠――",
      "source_fingerprint": "b765745320bb161358d471ee3cef925147bc4fe6943b7fb61c1fbcc78b035a98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
        "text_block_list",
        6,
