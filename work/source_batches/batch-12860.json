      ],
      "json_pointer": "/text_block_list/69/name"
    },
    {
      "uid": "zhcn:20be9b609d9201986ffdc3e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――就不能换个说法吗！\n冲紫丁是在冲什么呀！！",
      "source_fingerprint": "3223b1b9cfd66dd929c7e43f8c1762b1ee70d9247a4aac648099754cc557e4f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
        "text_block_list",
        69,
        "text"
      ],
      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:04560bc3500593e6210de197",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……然而她所向往的“明星”恰如黄金巨匠那般，\n是唯有活跃至铭刻历史的程度才能成为的。",
      "source_fingerprint": "c56ae6340ebefcf4315828113279be1c3d8c3ed5578c12c116088a5dd6658887",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:754b4154ca49a7f63dd84d73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
