    {
      "uid": "zhcn:4ac2a99975c31dc885cf7399",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而咱……若想要逼近那高度，\n非得拼上一切不可。",
      "source_fingerprint": "4b3cdb7c416df73b31099d6c8181c70550a7d8fb3db62864789d4ba2bc35280e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
