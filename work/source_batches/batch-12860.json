        0
      ],
      "json_pointer": "/text_block_list/104/choice_data_list/0"
    },
    {
      "uid": "zhcn:a59ef5cf8447f164a9fa803e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个“自己应有的模样”也就是――",
      "source_fingerprint": "514a05db779e1cb6c44328d58a9df4053382709351e9203384a106a8254d5b14",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
        "text_block_list",
        104,
        "text"
      ],
      "json_pointer": "/text_block_list/104/text"
    },
    {
      "uid": "zhcn:1e56ee13d1dba2be39d582ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……再唤醒一次试试吧。\n唤醒她作为“女王”的自我与自信。\n",
      "source_fingerprint": "e257edaf85e9b0c0a00c4daf38e45bb88a519f5a51265841b9a343004131675b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
        "text_block_list",
        105,
        "text"
      ],
      "json_pointer": "/text_block_list/105/text"
    },
    {
      "uid": "zhcn:7bd6ae0c01f2baf18702a409",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为此我……\n做好了装不被期望之傻的，觉悟――",
      "source_fingerprint": "f5a6821e30c5243a6e2ff50fff7967ea8fb0d73ca3aeb57aba1cb4efaf37599b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
        "text_block_list",
        106,
        "text"
      ],
      "json_pointer": "/text_block_list/106/text"
    },
    {
      "uid": "zhcn:3c3fdb8f4d06d2e2145a1cce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后『日本杯』开始了――",
      "source_fingerprint": "b5abd093224f79df685dd46301d67b2042346fb13f64a568790b425895d8b66d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
        "text_block_list",
