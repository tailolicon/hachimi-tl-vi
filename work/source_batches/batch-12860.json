        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:a9103be2cb1a2de8cfa58f10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "历史改变了。",
      "source_fingerprint": "8bfe0509a8da16aa38ce667c470eebc518324aa3a514ba47b04b2f8d0e4b30e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
