    },
    {
      "uid": "zhcn:b0d87ae7efd4aa74068cc9e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从今天起，咱一定要重整心气。\n所以也请训练员更加严厉地鞭策咱吧。",
      "source_fingerprint": "fc040355822ab506c9a6ff64f5f774635be8d5807edbab2b87d0275dbf2bf95c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130113.json",
      "json_path": [
