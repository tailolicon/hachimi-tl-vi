        81,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/81/choice_data_list/0"
    },
    {
      "uid": "zhcn:28dd25976bb019750ac1c4ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她自己没有自信的话，\n让某个人带给她自信怎么样呢。",
      "source_fingerprint": "11f9fc084c0a23b32ac7a433dc40a29358869f1d4c36f59c3ded13268c136b14",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
