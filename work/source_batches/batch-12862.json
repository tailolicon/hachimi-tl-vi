    },
    {
      "uid": "zhcn:3fc237f6af8f4919320aa1dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "把今年的后冠路线极大炒热的，\n现在在闪耀系列赛中有着偶像般人气的杏目。",
      "source_fingerprint": "4f229abbf35cb7c17b333ef78b107aa61a7bf5514225d63c4b875afe9bd12355",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
