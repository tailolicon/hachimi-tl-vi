        "text"
      ],
      "json_pointer": "/text_block_list/80/text"
    },
    {
      "uid": "zhcn:399faaf4816427d76b1aa22e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（有一位。没有比她更好的人选了……！）",
      "source_fingerprint": "64fbae2571e4ae42358668f2cae636213dab9fcf859743fb0b6a79447ecc67da",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
