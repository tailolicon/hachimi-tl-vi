        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:f2950c8b7fa69676e4bbb6d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "取回旺紫丁的自信该怎么做。\n我思考了很多却只想到了一个方法。",
      "source_fingerprint": "1adfcea29d1a8d110b6ab382f73ff5ece06304d61cb672721ddb0110f38cd9d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
