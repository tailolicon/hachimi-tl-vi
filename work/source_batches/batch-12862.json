      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……我怎么也，看不出来）",
      "source_fingerprint": "fe31c6f351c5f84ea6762038ad372a88f102abf57024e5e3a02295f05c5a5d09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
