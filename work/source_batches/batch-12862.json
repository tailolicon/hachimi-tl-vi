    },
    {
      "uid": "zhcn:601de8d4de6fd9703c71ea50",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以我不认为她真心觉得『已经够了』。\n反倒能看出一些不服气。",
      "source_fingerprint": "e4d941f754a40259aeb32e3821de874f0150d715b19a47b8a224374facfc9f2b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130114.json",
      "json_path": [
        "text_block_list",
        76,
        "text"
      ],
      "json_pointer": "/text_block_list/76/text"
    },
    {
      "uid": "zhcn:96531a337921218a3f6ddf74",
      "kind": "story",
      "source_language": "zh-CN",
