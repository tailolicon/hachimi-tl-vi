      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……差不多快到上场的时候了。\n我必须得对旺紫丁说点什么打气的话才行！",
      "source_fingerprint": "0d6caac33ad8db5a48dd1f0889f65124a1ae43319bdaf6596e5726b31fb20b5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
