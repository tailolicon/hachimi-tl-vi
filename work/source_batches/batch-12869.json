      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夕阳映照下的誓言",
      "source_fingerprint": "29f725536f7b9e8403f7b57262993168514be38b378728699e7a0db749679753",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
