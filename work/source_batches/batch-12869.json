    },
    {
      "uid": "zhcn:700bd3a4fdf0ce52a3e596dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正合我意……！\n啊啊，好期待啊……！！",
      "source_fingerprint": "644d59ebfe1b19518a7481d7e2c82d26361bbc3923254511d8b351bdfda376aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130117.json",
      "json_path": [
        "text_block_list",
        79,
        "text"
      ],
      "json_pointer": "/text_block_list/79/text"
    },
    {
      "uid": "zhcn:a1546299a3302ff236370c32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在的旺紫丁，\n也能像当年的黄金巨匠她们一样，\n与杏目共存的吧。",
      "source_fingerprint": "07e11ebf3bd7c9a9eef3adacfed904ddef195ebb22372c7caa3d8e0c17ff7cb9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130117.json",
      "json_path": [
