      "source_text": "（……………………我瞅）",
      "source_fingerprint": "98d4a91f7a2d193839f5debc1562dae1efd5e0b882ed298b29f8a509fbf89498",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
