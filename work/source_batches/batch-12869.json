    {
      "uid": "zhcn:dfa2fd282422c7ca866662c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今、今天你就放胸（松）一战罢！！",
      "source_fingerprint": "590211333a8bdcb43bc79607fea57681abe6a19c6c47067140b855bf65df4241",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
