      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:153e1849d3cf0884e120c646",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在今天的『樱花赏』尽情讴歌吧！",
      "source_fingerprint": "0d325a698b40a897ea2521d48e4da15fba0ed25debd2897527bb3cc05510b5eb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
