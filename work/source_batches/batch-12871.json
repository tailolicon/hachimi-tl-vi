      "source_language": "zh-CN",
      "source_text": "…………好。",
      "source_fingerprint": "e5b8fcc58cc598e0ad5543fbfae6d75d8d6644e5f784abeda1c9719db05c7798",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
