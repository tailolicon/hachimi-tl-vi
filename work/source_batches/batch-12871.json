    },
    {
      "uid": "zhcn:c5b1a79e9ac0c8f017eadf28",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……倘若观众们，在咱和杏同学的对决中，\n看到了巨匠前辈她们对决的影子――",
      "source_fingerprint": "717674585ecb10d4fbce9fbbbf0ec0181a171f80f726e57741f327cba8ee36d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130202.json",
      "json_path": [
        "text_block_list",
        21,
        "text"
      ],
      "json_pointer": "/text_block_list/21/text"
    },
    {
      "uid": "zhcn:6f728da0daccb6d8a93888b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130202.json",
      "json_path": [
        "text_block_list",
