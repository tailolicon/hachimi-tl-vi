        "name"
      ],
      "json_pointer": "/text_block_list/22/name"
    },
    {
      "uid": "zhcn:8da0ab21a5bf9a5fcd489c3f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那咱不能输给杏同学的理由\n又多了呢。",
      "source_fingerprint": "d98c25d4cce8b2b331ffc0ce8fa1feebf22a7f5a92f88af7f7c822afda46dd28",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130202.json",
      "json_path": [
        "text_block_list",
        22,
        "text"
      ],
      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:adc5cadec15d025e067bbf91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她凝望着杏目的眼眸中，\n静静地、却又确凿而强烈地\n燃烧着斗志的火焰――",
      "source_fingerprint": "995e633b9118fb459655f78a6b584b681b963265add0ba82ca91ed339a9d5913",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130202.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:3a726f043cc641e35cfb3a16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――接着迎来了『樱花赏』当天。",
      "source_fingerprint": "7ba3dbcc340ef9d9fe10cad9585ba7ea3ddaddb80903fdd08717101710895338",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
