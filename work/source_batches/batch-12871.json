    {
      "uid": "zhcn:487f48e72012fdab60345c00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "旺紫丁",
      "source_fingerprint": "9bd13b5e1395ea87340cd1c102f7f659c57ca9664b7ec0b998ebc201a2149beb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
