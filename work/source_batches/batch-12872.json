      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……有哪里怪吗？",
      "source_fingerprint": "cba5f219739b859b111f145b215459c3faed87e59329e1af78263df86aacd428",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
