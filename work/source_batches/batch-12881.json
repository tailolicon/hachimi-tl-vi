        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:899c75cde0fddc1db81ecd14",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这场比赛只有新马级选手能够参赛，\n许多以后冠路线为目标的赛马娘\n都会选择它作登龙门。",
      "source_fingerprint": "fe19f27769789b3e4d98605c8c4c47a989915cf439e2079d774d94d0b184c23b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130303.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:7c171f678814693c2f8f6623",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果旺紫丁能够在这场比赛中获胜，\n就能早早地以女王之姿君临新马级了吧。",
      "source_fingerprint": "93047fa5f62c7cadc708d645bde83acca83330fa30cd7848b8f609dee07d2505",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130303.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:387534ed27448a2a3b28fddd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那应该是能让她朝着“明星”的目标\n迈进一大步的实绩……！",
      "source_fingerprint": "f986cccc422b5f539640a6eb180c6a1d63b21fc203deb639c98eb863e40845a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130303.json",
      "json_path": [
