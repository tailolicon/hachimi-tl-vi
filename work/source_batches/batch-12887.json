    },
    {
      "uid": "zhcn:20c4b4f00cce90d205d7fe4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……从这里，再开始吧",
      "source_fingerprint": "366ddbd27233dec01f0e284cf799c049af52f346c6dd4bbbf34d305209099626",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
