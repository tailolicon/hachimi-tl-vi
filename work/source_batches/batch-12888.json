      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正如训练员所说，要想成为古马级“女王”，\n这的确是一场避不开的比赛。……只是――",
      "source_fingerprint": "94c07483b05e1fbf99f97f37b394830a4d2eb1d3f50528bfe35fa1ef6b1a5283",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130316.json",
