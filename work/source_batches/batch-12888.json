    {
      "uid": "zhcn:87a588ec5297e83ca1b3f9ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "翌日。\n在决定下一个目标的会议上――",
      "source_fingerprint": "d6d784275dae32bc07ba518d12dec1fc4aafa841adf6ef65689829f2935a1019",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130316.json",
      "json_path": [
