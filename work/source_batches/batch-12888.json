    {
      "uid": "zhcn:d31414d5999f544ddd21e16a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一场就定在『维多利亚英里赛』吧！",
      "source_fingerprint": "119a50cfd4faffb400cdb7880895358d536f504de02bde3dea964622cf4f69df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
