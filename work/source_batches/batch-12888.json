    {
      "uid": "zhcn:09fa76984109ec7e1b68dec8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――――能不能让咱跑『大阪杯』。",
      "source_fingerprint": "c939b55f719adab632f1e8bb62bdbcb8a56698f0ab4a9cfbacfa26ef4b029e94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130316.json",
      "json_path": [
