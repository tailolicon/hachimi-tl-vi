      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋天，\n请让咱去跑『伊丽莎白女王杯』。",
      "source_fingerprint": "c2faa964e94093d68dabd5010ae931137823205a9f48d67ea9fe4a472f333661",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
