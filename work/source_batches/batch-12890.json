      "source_path": "assets/story/data/50/1130/storytimeline_501130317.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:213b708e474c73de5782746a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赢下这两场比赛就意味着。\n自己正是当代最强后冠赛马娘……！",
      "source_fingerprint": "0c8451b99f053a1e81efb148a2c29e6544deb795d73256fb48ec5b78991d91c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
