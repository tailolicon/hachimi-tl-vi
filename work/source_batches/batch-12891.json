        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:cb156bcbc798cabc504ce7f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因比赛场方面的原因导致举办地变更\n这类情况过去也时有发生。",
      "source_fingerprint": "3d6063f0f2bcbf126b0f81642888ffd620d94077e423a9d86aecd20e48bcb3d0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1130/storytimeline_501130318.json",
      "json_path": [
