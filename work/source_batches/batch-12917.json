        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:6edaf2135eb92f103037d659",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
