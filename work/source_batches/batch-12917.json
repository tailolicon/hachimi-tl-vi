    },
    {
      "uid": "zhcn:601b39c6bef812e555eb9abe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不喜欢戴耳机。\n耳朵被塞起来就没法放松了。",
      "source_fingerprint": "a4da41edf5ab81848ff3d7789fabae1d833542b8546db04c3716d43dcd3d12de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
