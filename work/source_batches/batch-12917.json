      "json_path": [
        "text_block_list",
        108,
        "name"
      ],
      "json_pointer": "/text_block_list/108/name"
    },
    {
      "uid": "zhcn:346f493aed1f98f69ad364c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正合我意！那么明年──\n我们就在「樱花赏」上一决胜负吧！",
      "source_fingerprint": "62fdd78f4655e46e87d9aea6a9bf0f870f0a1893943eac4f11e03dc970424cf5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131113.json",
      "json_path": [
        "text_block_list",
        108,
        "text"
      ],
      "json_pointer": "/text_block_list/108/text"
    },
    {
      "uid": "zhcn:ef630595f11d4ffebe1b1df8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "独白",
      "source_fingerprint": "182cc3cf530783b6da4d14ed3d7d177e4428e3ba9645975eb9ef22934b7d221c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
