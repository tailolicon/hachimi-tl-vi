      "source_path": "assets/story/data/50/1131/storytimeline_501131113.json",
      "json_path": [
        "text_block_list",
        12,
        "name"
      ],
      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:27007f71965f42ceb25a3328",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放放不嫌弃的话，我来协助你减轻行李吧。\n是什么东西占位置啊？",
      "source_fingerprint": "131267a88df6dea831713dbfcfcea78cf39c4545e41527ad1b758bc9b5919aa3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131113.json",
      "json_path": [
        "text_block_list",
