    {
      "uid": "zhcn:a1cda369b24295fbcc2ea5e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放声欢呼",
      "source_fingerprint": "f6f9d4474a6735b6f626fab88bdf3039da94d23a4c9c8c9f6d7f45e584ff4250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131113.json",
      "json_path": [
