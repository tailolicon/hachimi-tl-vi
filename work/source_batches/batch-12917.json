    },
    {
      "uid": "zhcn:f7f2a35979944429934f42c4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯独爱你",
      "source_fingerprint": "9399f1eac3e90e02e56c05a130bf24bc0c3867f6772ed5a8ee1c325df7f0f243",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
