      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过啊──你是不是忘了？\n我们也是以「樱花赏」为目标的。",
      "source_fingerprint": "557069be7df7ef5450d95e453bad50032e0f47548a6fde7fb51314fa18245f5e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131113.json",
      "json_path": [
