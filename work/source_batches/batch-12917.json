    {
      "uid": "zhcn:7100e8b289c677690587ba3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──我想在越过冬天，萌发春芽前，\n培育出樱花花束──并将它传递出去。",
      "source_fingerprint": "1740cf89dd57722986fa18c58394b2fc34be062a1b849d473a5336769c30166a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131113.json",
      "json_path": [
        "text_block_list",
        107,
        "text"
      ],
      "json_pointer": "/text_block_list/107/text"
    },
    {
      "uid": "zhcn:196385f1fbd7988b27492d8e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放声欢呼",
      "source_fingerprint": "f6f9d4474a6735b6f626fab88bdf3039da94d23a4c9c8c9f6d7f45e584ff4250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
