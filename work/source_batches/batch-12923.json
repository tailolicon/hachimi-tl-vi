      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前英里王训练员",
      "source_fingerprint": "b0bb78423b35933f702e43213abe3d924a4dac3cbd59909d55c47d459fe74116",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
