    {
      "uid": "zhcn:535b0f369f5da904201b4dc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欢呼声平息后到来的寂静。\n视线完全集中在闸门后的她身上。",
      "source_fingerprint": "13a269c5a29e71bc3f89b57a01483aef6f6c9eacc688878ce1f0955f337c9370",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
