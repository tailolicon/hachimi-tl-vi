      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我从跟他们有关的书籍以及访问视频中，\n寻找与放声欢呼的相似之处。",
      "source_fingerprint": "e55d31649884e8bbcb286b9991be3e61a7f2cc6ef8c4e0f1be2b2e6488463154",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
