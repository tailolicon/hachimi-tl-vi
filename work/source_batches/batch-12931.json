    },
    {
      "uid": "zhcn:6c885e91d213349a23b6d348",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我曾听说过，有好几个运动选手\n都是这种类型的天才。",
      "source_fingerprint": "ae394e62e95e10316ec3654c335153d58c85aa7be05d0488b8cf54b6e7600706",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
