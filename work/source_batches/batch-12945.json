    },
    {
      "uid": "zhcn:c605e68ac08b389fba9bbf46",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众A",
      "source_fingerprint": "eee86b64dc7889c9a8a0c3464472500fce48b2487b81ae5e25e0e3845b56d9ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
