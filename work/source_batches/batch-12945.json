      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:196025e8589c902f59628abc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好、好厉害……那种速度是怎么回事？\n那不是新马级赛马娘该有的速度吧……！",
      "source_fingerprint": "96d16d16095a918aacba36f8215869bf2c490a1c04a7b23e86fe51d8720fa634",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131303.json",
      "json_path": [
        "text_block_list",
        32,
