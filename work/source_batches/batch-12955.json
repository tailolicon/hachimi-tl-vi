      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:82eec21a9fa2e75a778f5eaa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "名字旁边的标题是「宣布放弃凯旋门赏」。\n不久前，杏目在记者会上发表了\n她不会参加「凯旋门赏」的事。",
      "source_fingerprint": "13970a0e9816959a71e5445c6e1dd2b1063c6cfbf9c9ed66f6f7cfda91a8563e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131309.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:cd6cafa26c4a9dd5a7ac6355",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "毕竟那边的草地跟路基都完全不同",
      "source_fingerprint": "4da1abef795893ac442f81ebc4262d84f450ce713deb0e3cc4708011e9925722",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131309.json",
      "json_path": [
        "text_block_list",
        51,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/51/choice_data_list/0"
    },
    {
      "uid": "zhcn:e4b04e123b97880e89d80971",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放声欢呼",
      "source_fingerprint": "f6f9d4474a6735b6f626fab88bdf3039da94d23a4c9c8c9f6d7f45e584ff4250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131309.json",
      "json_path": [
