    },
    {
      "uid": "zhcn:5872548b364b720fb6e1e35f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回程路上，为了购买参考资料，\n我与放声欢呼一起顺路去了趟书店。",
      "source_fingerprint": "e8b6127991c80b5c405f2eb22bcceef6d77f4316c4bdac08114b3cffbccf1a95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
