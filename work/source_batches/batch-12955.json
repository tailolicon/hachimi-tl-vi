    {
      "uid": "zhcn:71350d23b60219b011d0642e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要从「阪神C」开始\n往称霸短距离迈进对吧！",
      "source_fingerprint": "32d19cae031ed72e66cd9ca736eef324cb0f2a7f1d40c6550231b7fd74247bcc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
