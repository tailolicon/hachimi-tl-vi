    },
    {
      "uid": "zhcn:76ac3cc0011f6d85be6353e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的，我没问题！",
      "source_fingerprint": "4f11b61c835e0effff62af3a529d0e797a0e6dab2d78f92fc0a213db1cfa35c0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
