      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:1aaac327b410fdfe069309c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么选1400米的「阪神杯」如何？",
      "source_fingerprint": "aa99dad73347dd60aa0b8f54379884c27c7af98e1cb1d079e6bc51b10b4995b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1131/storytimeline_501131309.json",
