    },
    {
      "uid": "zhcn:3848e9714a7893e0e82fe560",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……唯爱，再闭上一次眼睛",
      "source_fingerprint": "11ab23c57a4d5353e4f895af2faa096ecca7e277fbe686cca307ce4189d79d23",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1132/storytimeline_501132203.json",
