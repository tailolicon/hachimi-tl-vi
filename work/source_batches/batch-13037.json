    },
    {
      "uid": "zhcn:91861f3940fa1f1ac81543b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而这份强烈，如今反而\n成了她的某种压力也说不定――",
      "source_fingerprint": "7d6266ce30f98f5b369dcf32b745253fe864303e40aed1788a8865d44ec8ace2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
