    {
      "uid": "zhcn:a769657be1979332537bceef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "召集有海外经验的人进行校外训练直播……\n真棒呢。请务必让我来帮忙。",
      "source_fingerprint": "0b5f6074fa6e53200ec62372cb082c39ebe50288842fd0a5e51719623e32c62f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
