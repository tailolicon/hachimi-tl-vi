    {
      "uid": "zhcn:900be397b4203483e7c675ba",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "洛林军歌",
      "source_fingerprint": "e2394fc4419262ab1cf553390b0ff2b363c50193da508afe85f441f9dc3d1566",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
