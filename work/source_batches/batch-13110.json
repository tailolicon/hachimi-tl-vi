      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:9b4a1673848ca10f81ebf455",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在世界各地拥有各种战绩的学生们\n都爽快地答应了出演。还有最后一个人……\n去和那位大人物交涉吧……！",
      "source_fingerprint": "4bb85bb191d2938f7eecdc2c2a1d081fca21725fccb50fd0bfbcc4509474fb6a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
