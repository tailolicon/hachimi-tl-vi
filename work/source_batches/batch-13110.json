      "uid": "zhcn:2ce8e813bc45ec23f1ea30d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢！这份恩情我记下了……！",
      "source_fingerprint": "e83fe2adf722938a09750a5bddeb5983cb873a07f131f243f61f23160724a21a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
