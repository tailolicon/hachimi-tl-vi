    },
    {
      "uid": "zhcn:04eabf42df94ce11ee71390c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『小洛林要成为唯爱酱\n最棒的训练对手――\n成为能一起以海外为目标的搭档！』",
      "source_fingerprint": "8e9fa90ef9b91b0f72c8398f50b6a682a7c527af15c1dd8ee5bc28cb0676b83c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1132/storytimeline_501132802.json",
      "json_path": [
