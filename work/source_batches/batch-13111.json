      "uid": "zhcn:349f4c82949d714e13acbbeb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "社区成员们",
      "source_fingerprint": "7fc753e83cbeacf4784bbbbaaa9f6a82fc2848b5ac4d7f8b00d41ab08370a49e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
