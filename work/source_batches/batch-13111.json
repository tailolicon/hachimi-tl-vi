      ],
      "json_pointer": "/text_block_list/49/name"
    },
    {
      "uid": "zhcn:95c5420d6d64dc56f73f6c12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『我们！？』\n『就是要装作对唯爱酱毫不关心的样子吗！？』\n『呜，这简直是意料之外的苦行……』",
      "source_fingerprint": "1bf7460c1c76ad85436ee7857144c3e01527bc0a73890e5824cdbae931edb9c1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1132/storytimeline_501132802.json",
      "json_path": [
