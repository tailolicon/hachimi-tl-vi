      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:662c58ffe6d48df2b00325fd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "伴随着大家的爱与应援，\n在背后推唯独爱你一把……\n想与她一同展翅高飞。飞向世界！",
      "source_fingerprint": "4f997034c3f8820df824220cc170c3954ff4d53d1ffac57bf7ee750caa96f51b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
