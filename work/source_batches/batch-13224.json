    {
      "uid": "zhcn:55051cfb3d85df74552c1722",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——这是一位对英里有着强烈执念的赛马娘。\n实际上，在赛事中她也最擅长英里赛，\n在12月的英里赛事中是夺冠的热门人选。",
      "source_fingerprint": "8251034ee32292e2ea77188896573efe4a405eca1a6338756590399f94f7ecde",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
