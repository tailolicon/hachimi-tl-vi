    },
    {
      "uid": "zhcn:69b0e19d5cca8bea99336bd9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我以前有一阵子，也会用自己在庭院里种的洋甘菊\n来沏茶喝。",
      "source_fingerprint": "5a55bbb84e3f75bde3727a1fd686c3fd82052cbfc67540c21fd052052e5d3578",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134101.json",
      "json_path": [
