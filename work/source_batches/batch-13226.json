      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:3fcb1ee2bd6b41ac4c91fbb3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，请让我去买。\n――您知道咖啡树的花语吗？",
      "source_fingerprint": "088eb96d4c81c009ea207dd389eb1ecdbddecee3132bfce391d2153b3a8e0e32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:aaf6da8e522e60df7333c9ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
