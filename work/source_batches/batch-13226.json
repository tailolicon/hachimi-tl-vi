    },
    {
      "uid": "zhcn:ed6493321bb106bf9de3d273",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "去车里睡一会吧？",
      "source_fingerprint": "5aaff4015ab624c3e6314d414dfca2116aac9479010223f3801c8ba04c9a10f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
