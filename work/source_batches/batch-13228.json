      ],
      "json_pointer": "/text_block_list/66/name"
    },
    {
      "uid": "zhcn:e1f640683f64cabf3e4e6baf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢您，训练员。\n――好美的天空。能和您一起看真是太好了。",
      "source_fingerprint": "bbfed6386e94dd9133aec54495677de522fbbf91f24df9921cb1413e4e6b190b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        66,
        "text"
      ],
      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:68694ed3f76064d05c6e0297",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
