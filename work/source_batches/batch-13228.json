    {
      "uid": "zhcn:7cc805b4566a9336cdb0fc32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到日出了就去叫她。\n如此约定好后，我移动到了\n能同时照看到车和天空的位置。",
      "source_fingerprint": "3a4fc6967b2a63d8d49e3ccd1b9b22e62ddb3a619a21eda15731a45169df8b6a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
