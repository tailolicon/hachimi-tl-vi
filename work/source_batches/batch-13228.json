    {
      "uid": "zhcn:d09eb2cc76b5e7c6f69c1e6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "并且想将它，献给您。\n我是打从心底这么想的――\n仅此而已。",
      "source_fingerprint": "250895d25a76232215f9f6f94667793f260f77adf998e7f9d93b0e93226c2ad0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
