      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈啊，哈啊……。\n――没关系，的。呵呵。",
      "source_fingerprint": "68779bb6a8f806c964fde41a8e8bf05aac5f0a6c2c830d072c5fd2517fa34ad0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
