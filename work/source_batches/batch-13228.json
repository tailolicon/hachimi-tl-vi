      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――",
      "source_fingerprint": "527f73ca912b77c8dd4d91262d2819ddc10a5a47f0b31e5ffcb5165537fa98e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
