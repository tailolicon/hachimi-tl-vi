        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:767d6b1bab36d165682ba616",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "想将胜利结成束，作为花束送给我。\n她在这之前，\n也曾无数次这么对我说过。",
      "source_fingerprint": "819b7a49d60c85ba96ad9f6160d484b310e72f44062f5a24570a1d26ef5057d8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
