      ],
      "json_pointer": "/text_block_list/56/text"
    },
    {
      "uid": "zhcn:4a8c1ce47ba1066c5a3daa72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个冬天，一直在进行着\n极高负荷的耐力训练。",
      "source_fingerprint": "be952078d5232e034abf660a0b8bd9037331a3162661da383b9ad8576acf6b50",
