    },
    {
      "uid": "zhcn:051fc9ccf98119e881ac3ff6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后再将它\n交到训练员您的手上。",
      "source_fingerprint": "84e300884be2a268f44ce1de0efa6c7c1ab9869229c43db766144ccaf5f1c233",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
