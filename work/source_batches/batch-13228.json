      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……我真的配得上它吗？）",
      "source_fingerprint": "d98fc59834cb4cee6ce347cf6b765e69b6e83c1abfb078739040ed625e5dbc03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
