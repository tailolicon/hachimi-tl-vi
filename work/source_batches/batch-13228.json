      ],
      "json_pointer": "/text_block_list/6/name"
    },
    {
      "uid": "zhcn:a46a1ec9777170326e8fc9f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――谢谢您。\n好香。这下也清醒了呢。",
      "source_fingerprint": "89f255e9a4d81900d614df7c9d94255534f9a1432fbff1af86e9d9f68ee675ac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:d925bcdeb037300699431edf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――肯定有比我更相配的人存在。",
      "source_fingerprint": "841929dfafcf6c10d73f784b2260ff561c919b11ecdb73a65145ebe2c6cee7df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        60,
        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:32243ec586bd84d0154d09a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个想法直到现在，\n也时不时地在脑海中挥之不去。",
      "source_fingerprint": "5af715e54683ca93ca3908bfd288f4672d2546653ab43bffa9ae2228ea9d4712",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        61,
        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:0fca4d7a1d52714b8b25f009",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但是在担当金花的训练员之前我――）",
      "source_fingerprint": "e7e4a1203e15d29dd1ae25365d992b3f6ae73c9b0ac1a88f194749cf296fdac4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        62,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/62/choice_data_list/0"
    },
    {
      "uid": "zhcn:c284e2457091115d0ec7da6d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但是在担当金花的训练员之前我――）",
      "source_fingerprint": "e7e4a1203e15d29dd1ae25365d992b3f6ae73c9b0ac1a88f194749cf296fdac4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        62,
        "choice_data_list",
        1
      ],
      "json_pointer": "/text_block_list/62/choice_data_list/1"
    },
    {
      "uid": "zhcn:f0645e63b44ba9ced13035e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了回应她那份想将『天皇赏（春）』\n献给我的心意，现在可没时间软弱。",
      "source_fingerprint": "0f7d619a5d22ea2d3b7f6cecc52934d6cbab758c252589542f59e66a033c8c5f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        62,
        "text"
      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:b2adf7f00fb33067e96eaa48",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（总而言之，去做好该做的事吧）",
      "source_fingerprint": "94836dfa0f9d64645ada0097ecbcc482287887a6d22a0342632e8e5c79e9a8aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        63,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/63/choice_data_list/0"
    },
    {
      "uid": "zhcn:b6577926871099fc08fe3d0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――摇了摇头。\n想这些也没用。",
      "source_fingerprint": "a291c52eef33b60bafdf6697f5c57aee2ddaab7f3fed9ac17ba87402a360835f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        63,
        "text"
      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:a5e9d3e32d9974aa4358d34a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "转换思绪，抬起沉重的头时――",
      "source_fingerprint": "734f0c538d1f749adb46168c3ff2ed67cbcd4f067bb5073963365833d72afe09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        64,
        "text"
      ],
      "json_pointer": "/text_block_list/64/text"
    },
    {
      "uid": "zhcn:38f716784e032be270285bcd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "回过神来，天空已经泛起了鱼肚白。\n我慌忙转过身，向停车场走去。",
      "source_fingerprint": "e7311f82365b7c18a8af9d48f484c5dda8c975f24168de9198761bf6168f650a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        65,
        "text"
      ],
      "json_pointer": "/text_block_list/65/text"
    },
    {
      "uid": "zhcn:2d9b5d0cf036ab20247fc278",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
