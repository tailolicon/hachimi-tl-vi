      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（――『想为您献上黄金的花束』）",
      "source_fingerprint": "3f1a882b20bf80fb6bed79909ad0f6c7956058b9282fa3d220a14f7860bf41e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
