        "name"
      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:5e40a366055e8d17d5c00a36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……哎呀，训练员您，\n不喝吗。",
      "source_fingerprint": "8caedc77c8daa8c28ffc0ae317aaf5247d8c8e751c80b8f794b367c521555be8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:dd98afba40540440ae173b7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先第一步，为了实现她的梦想。\n我必须脚踏实地，一直支撑她走下去。",
      "source_fingerprint": "3bfe2b5ae84c185ad42928901c65789b60b6a2ae32386d277b4e4266d863242d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        70,
        "text"
      ],
      "json_pointer": "/text_block_list/70/text"
    },
    {
      "uid": "zhcn:3f1a52a821ef3bf904875642",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我忘了买自己的那份。\n再特意跑一趟自动售货机\n也嫌麻烦，于是说明了情况便坐了下来。",
      "source_fingerprint": "50383540282dbb7c9866b25a66b90e0a752c60e43037c61e47cd2bda7c28aacc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:7cb0a0b364bacbeb4854b04a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诶！？不用，没关系！",
      "source_fingerprint": "cb340be469bdcc01bdbcffbbe328c25436f9033cfb14188e4217433b00b46d75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
