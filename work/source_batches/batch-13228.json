        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:59f4170c26d5227d3b79d881",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
