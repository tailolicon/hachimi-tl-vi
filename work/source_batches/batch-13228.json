      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那，就睡一小会。\n谢谢、您。",
      "source_fingerprint": "79836b15898ed7ceb176f687edfcc9604f233297627a30174f800ca9ac66f282",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
