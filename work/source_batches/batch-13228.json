    },
    {
      "uid": "zhcn:fef690b0f036fd37110cde54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "稍微等我一下",
      "source_fingerprint": "d7a05011ceb419dcd720124887f789d6c5ffce94fc095c7c9d4543d84cd22d4f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
