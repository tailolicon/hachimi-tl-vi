      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:bbfcac46216b3a47e0773641",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……我真的能配得上它吗？）",
      "source_fingerprint": "5840efb9be8123873adaa09539594ceb4282473321e049558819bb73aa212401",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
