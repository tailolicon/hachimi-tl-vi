      ],
      "json_pointer": "/text_block_list/59/name"
    },
    {
      "uid": "zhcn:07dc28b1f55bb67d19c47b32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只是稍微有点脱力，而已。\n还能，再来一次……！",
      "source_fingerprint": "89795b3c01c011e1e2a37cd6c9b5bf1ed34b6b68d4cee861d51f9e6ef12eba8f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134102.json",
      "json_path": [
