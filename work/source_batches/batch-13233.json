    {
      "uid": "zhcn:b9aec87c4dcd21034cc96713",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎呀，来了很多客人呢。\n在『粉丝感谢祭』的招牌前，你看——",
      "source_fingerprint": "155071521df7c63009069ef7486f9fca596e90abe1c3108392faea281e396b3d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134108.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:7149fd04753d56fbd2b0b1e5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感谢祭执行委员长",
      "source_fingerprint": "0ba31259ba0f06a651603d0da51c16da3d7b5287a5598a06e20333860c752b75",
