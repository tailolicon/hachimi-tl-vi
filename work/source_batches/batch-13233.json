    },
    {
      "uid": "zhcn:f6a87dff187fb97edf3dd05a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金花同学，\n差不多该准备握手会了，拜托啦！",
      "source_fingerprint": "d1bb33db4ee0a84836124b56c568dbdaedf87170c11b4b309339f1a7c6b60238",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
