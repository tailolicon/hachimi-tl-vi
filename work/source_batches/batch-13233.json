      "source_language": "zh-CN",
      "source_text": "是，是的！\n今后也会一直一直，为您应援的！",
      "source_fingerprint": "4f5283a114094b10cd0f992c6977988fc5c644f2dd78f0645d24e8c40397cadf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
