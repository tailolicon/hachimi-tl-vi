      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后——时光飞逝，到了粉丝感谢祭当天。",
      "source_fingerprint": "6718866702421bf45ca2c8157e573ff7c3e02153fa201b07c351e494a617315a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134108.json",
      "json_path": [
