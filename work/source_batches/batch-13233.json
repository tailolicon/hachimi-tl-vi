    {
      "uid": "zhcn:5832f9d44d70fbc5abdd0811",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——机伶金花虽然这么说，但。",
      "source_fingerprint": "8138686b851d56731842274e82f8d2d0d96357044a2f1add62a919c22793ff55",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
