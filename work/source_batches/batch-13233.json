    {
      "uid": "zhcn:1a9955b0e2ace8a7e57d19c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（果然，还是有点在意）",
      "source_fingerprint": "421fd645ebfc8d6f304c2a4c08517acab1557efabc6902c9800cf59ffcd50a37",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
