    {
      "uid": "zhcn:9879a8414f03abbf2f31a1bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但这是我一定要完成的事。\n我会努力的。",
      "source_fingerprint": "5d7710ef05a83ee77ae7e36af03df754091f53f4fb04e75c723bd93a7df03be4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
