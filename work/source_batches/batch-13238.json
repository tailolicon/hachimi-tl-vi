    {
      "uid": "zhcn:77740b6978cd5d6666ef2841",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "泡澡中……。",
      "source_fingerprint": "64355424c99f2c273e4c7151f8f0ad3a054fba8a030c8b68f2337b1683f19b12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
