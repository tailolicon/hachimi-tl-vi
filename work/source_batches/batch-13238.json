    {
      "uid": "zhcn:17849521ac20170c64d67f17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（金花她，肯定也在享受其中吧）",
      "source_fingerprint": "e2b1170eb4f13d32b505c93061f0c4d7b20d4e557ddef11cc1b072f9d6e69b88",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
