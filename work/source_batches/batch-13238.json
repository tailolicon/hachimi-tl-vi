      "source_language": "zh-CN",
      "source_text": "——哎呀，那边也有。\n是压花耳环吗，真漂亮。",
      "source_fingerprint": "6f2711fc35bda749a38d4fa9853e340e56dbfbac555bdfdbaa6890497c75c6a8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
