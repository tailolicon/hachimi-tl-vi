      "source_language": "zh-CN",
      "source_text": "总觉得今天真是选了个\n奢侈的日子过来了呢。",
      "source_fingerprint": "d0d394dc6b519c2194488da8e813bf1ca103fa1879f7a39d55aa8626e997b488",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
