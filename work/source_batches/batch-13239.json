        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:cfb45a249fadd5d608272bc5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因如此——",
      "source_fingerprint": "0850fafb12e013c0c3ea3abe13a2c54f2644a6f527cb607d103fe58b586b5d51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134112.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:af14a0e952e03116b42b1c62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要将赛马娘放在首位。\n无论何时，都是第一位的。",
      "source_fingerprint": "4938f5f285cb427d36d7912080d291e5603b3b4ac07501bc33e6eb1cc7eaa9df",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134112.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:4469374f099f7e60de546138",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得在那黄金的花束中，\n也一同扎进了这份我内心从未改变过的愿望。",
      "source_fingerprint": "2c804288fac042c2ab532b483b0a7ee66982d4db329685009f0f1884043416b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134112.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:7b993003fd6deaf9225853fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你",
      "source_fingerprint": "8aaa2ee628be08866bfa2f0d5ff39aaa391ae1e9d55e869a9a051ae9ffe041a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134112.json",
      "json_path": [
        "text_block_list",
