    },
    {
      "uid": "zhcn:2cf5b03c81829bac3e2bc0f2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那份愿望，在多大程度上，\n温暖了我的心。",
      "source_fingerprint": "39ceb227ce95e1b16c8fa89d4771b56e0ca4d988fafc875749818e00f0d1cc32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134112.json",
      "json_path": [
