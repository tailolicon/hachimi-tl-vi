    },
    {
      "uid": "zhcn:aa8a323723d8b60ee1144454",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯独爱你",
      "source_fingerprint": "9399f1eac3e90e02e56c05a130bf24bc0c3867f6772ed5a8ee1c325df7f0f243",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134114.json",
      "json_path": [
        "text_block_list",
        8,
        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:3e3e41b055f0e69fcaff16c7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——没能参加『樱花赏』，真的非常遗憾。\n不过，我会将这份遗憾转化为动力，\n朝着『橡树大赛』好好努力的。",
      "source_fingerprint": "964496e1b37751dae0129142d6e0c09ef378e35dc3ff6477ea3949eefb4e58d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
