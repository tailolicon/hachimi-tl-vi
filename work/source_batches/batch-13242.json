      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:8d6392f4a19fc9a8dedff509",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唯独爱你",
      "source_fingerprint": "9399f1eac3e90e02e56c05a130bf24bc0c3867f6772ed5a8ee1c325df7f0f243",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134114.json",
      "json_path": [
        "text_block_list",
        5,
        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:f6cb69bb6102c2bb68e1877a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "发现腿部出现了肿胀。",
      "source_fingerprint": "e2f5dfb7928f39e965b1bee20fcedba389bb45767623197af85b07d0476bc14d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134114.json",
      "json_path": [
