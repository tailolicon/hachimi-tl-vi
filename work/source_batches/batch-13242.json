    {
      "uid": "zhcn:38663e22b87945e549940a4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "至于为什么唯独爱你没有出战『樱花赏』——",
      "source_fingerprint": "a828fcdd2b35ded0dc4b291a6193330f43d1190ba3c44caef82bbb327e1cbab4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
