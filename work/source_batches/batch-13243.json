    {
      "uid": "zhcn:04d8cf81dbf38ee111b71f67",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您明明给了我那么多、那么多的——\n支持与关怀。",
      "source_fingerprint": "3e6d1c20f36ae3d4aef24b41c740e6a078151942a3be2ea0d6aa3eff45c4506a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
