        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:36fcebe249b8a3fe121098cf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:8982ca33ac487ce2cd3581a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她拥有极佳的末脚。\n正因如此，我学到了很多。\n——我想现在就和她交换一下心得。",
      "source_fingerprint": "ffb2633867882ab3aa4dea0bc9884e5ad8d77fe0fe47df16a370b05fc8570d0d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:dc5f218d5e397a8fe62350f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我本以为自己已经做好了所有该做的事。\n她也毫无保留地拼尽全力回应了我。\n我曾经明明……是那样坚信不疑的。",
      "source_fingerprint": "fee9880abd677486ba4b3c794e360c7d5b7cef3c9255e799a2a224576de08064",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:5fda8622a6cc2bd4786176a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可即便如此，\n依旧未能摘得桂冠。",
      "source_fingerprint": "01a223f4d9a02f5602391883306c0b9cb06980bd122a9acc7b409005ab00a628",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:2a204f96ecbeed53b41fec96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "甚至，我连前三名的领奖台，\n都没能让她踏上去——",
      "source_fingerprint": "5f6d9a2201ec0a250817f16d86958f1a0cded2fbd1e286b84667ce2eab72fc5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        42,
        "text"
      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:d74034b89c28e2cc6ec91cb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——第二天。送来的体育报纸上，\n刊登了关于这场表演赛的报道。",
      "source_fingerprint": "a2cbf2f3bf516730f3ae1535e064eb9ad576afc805bbc6d6d532df924c27f1c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        43,
        "text"
      ],
      "json_pointer": "/text_block_list/43/text"
    },
    {
      "uid": "zhcn:2bc4728fa1a471575c026306",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『后冠赛马娘三强对决』\n『创世、唯爱、欢呼的激战』\n『同世代代表赛马娘之战』——",
      "source_fingerprint": "cf84736f80910592f7bb820192a2f6f14612153a19379a49ab58c8c584577709",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        44,
        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:361926daec3b48ae7b426dd9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这样的标题，\n正以黄边红字醒目地排版在版面上。",
      "source_fingerprint": "10ffa97d3db4ac34857f30a0ccc0cf62856a542184995bf38281d2f9e95bdb97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:e5da0b2d7cde98cf65577a59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在可不是垂头丧气的时候。\n我必须制定对策，为古马级赛事做好准备。\n虽然心里这么想着，但另一方面——",
      "source_fingerprint": "ac2df32b51125430f890ed8f56d6970b258c11a1f3d039c4a5500611c08a44f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        46,
        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:acb1fbbf258f91535a114e78",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『如果，机伶金花的\n担当训练员不是我……\n是不是会更……』",
      "source_fingerprint": "e8ba5a06be1a46fba4cd8cdba3c63d24c333ab556a0c26018eec3c3b5a3cd6a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:57edea1664efb827e3d05ef4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那天脑海中隐约浮现出的那个念头，\n怎么也——挥之不去了。",
      "source_fingerprint": "23580447a184b30bc6007b8e4fd82e8279c884fa8baddacee4755fdf1071893a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134115.json",
      "json_path": [
        "text_block_list",
        48,
        "text"
      ],
      "json_pointer": "/text_block_list/48/text"
    },
    {
      "uid": "zhcn:0b89cea0084613db4372e9e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
