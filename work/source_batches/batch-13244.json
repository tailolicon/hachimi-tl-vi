      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『如果不介意的话，\n可以接受我们的采访吗？』",
      "source_fingerprint": "762857e037ba65359912214c0867c8e65193b15b2f67f6d844827104f5d37af1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
