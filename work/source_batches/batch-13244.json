      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在借助他的力量之下，\n瞬间便伫立于聚光灯下的她。",
      "source_fingerprint": "4fd4370acb5aab2ba3fad2421f2846e208203abfdf0dc503b985ce2c8d7c56ad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
