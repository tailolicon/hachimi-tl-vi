    {
      "uid": "zhcn:024ec47096060403d3e4794c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我有很重要的话，想跟您说。",
      "source_fingerprint": "cc125afd89b58a619bd4018dc3da00c1c0b642f78b7f16cbf580ac17f47da93f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134117.json",
      "json_path": [
