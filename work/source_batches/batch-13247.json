    },
    {
      "uid": "zhcn:4078a0518848ed12f0dca170",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——我忽然察觉到。\n她的眼中，充满了期待，以及决绝的觉悟。",
      "source_fingerprint": "a031a8b85872a5b48a4c6350accaa1908d90fa662655bd0570a584af4d224e17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134117.json",
