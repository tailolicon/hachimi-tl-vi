        "name"
      ],
      "json_pointer": "/text_block_list/63/name"
    },
    {
      "uid": "zhcn:0efdcf381c24806855f3d80d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，即便如此——！",
      "source_fingerprint": "74d138da25e75c5f46aa96686c74349b575a7563ac8019f80e15b8400940fa5b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134117.json",
      "json_path": [
        "text_block_list",
        63,
        "text"
      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:05451a6a6fcde5f0d1045369",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134117.json",
      "json_path": [
        "text_block_list",
        64,
        "name"
      ],
      "json_pointer": "/text_block_list/64/name"
    },
    {
      "uid": "zhcn:8fc275540ebf0f7a23ead45c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也想利用这副身体，去完成一项壮举。\n一项能让我获得特别花朵的，特别的壮举。",
      "source_fingerprint": "0a5ee874a4b8ea0e4435e6e68fd8b21e7028535890b10720166f57235ec8c5e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134117.json",
      "json_path": [
        "text_block_list",
        64,
        "text"
      ],
      "json_pointer": "/text_block_list/64/text"
    },
    {
      "uid": "zhcn:3c4d77a33c14d4cea69b4ea5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金花……",
      "source_fingerprint": "c2f6e498996213fcce30d0e4c186648c264fecc64605f065e6947d9a8f75403f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134117.json",
      "json_path": [
        "text_block_list",
        65,
        "choice_data_list",
