      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……听好了。担当训练员的存在，\n远比我们想象的还要重要得多。",
      "source_fingerprint": "873ad8ebc82580c990f23ddf295a851014f7282bd528d630af13f297610cf976",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
