    },
    {
      "uid": "zhcn:089a8448e5c7a0530893977f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯——当然。",
      "source_fingerprint": "33b4461ae562df064ccec11a662310045fa012baa87c0473c151268c8d93c6a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
