    {
      "uid": "zhcn:5dfba43594dda716949030c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（到底有没有足够的能力，\n去追逐那项特别的荣冠！）",
      "source_fingerprint": "807708e2719bb4847e5d7a21a1b32c6b41000f9c60974d49bcc280bab1e8338c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
