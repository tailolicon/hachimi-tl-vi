        "name"
      ],
      "json_pointer": "/text_block_list/5/name"
    },
    {
      "uid": "zhcn:7efeeefccb3a009f6e935d12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——现场涌入了超过6万1千名观众，\n欢呼声震耳欲聋！\n最受瞩目的当然是剑指二冠的杏目！",
      "source_fingerprint": "c086d53bf619085d00749786bd1d553b41181851f7937f5ac28487e05d816d7c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134200.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:0a8b657355fe26b203ca47b6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在出道战前的一个休息日。\n我邀请她一起，来观看『橡树大赛』。",
      "source_fingerprint": "594672169dc35c3e5f7ceebac488b15de1a8e9ee4aae57983849bc1da4d18e03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134200.json",
      "json_path": [
        "text_block_list",
        6,
        "text"
      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:3a51a078a7090b7451e18db7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134200.json",
      "json_path": [
        "text_block_list",
        7,
        "name"
      ],
      "json_pointer": "/text_block_list/7/name"
    },
    {
      "uid": "zhcn:de269e416a687633a73d1f04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "杏目同学的『橡树大赛』——\n总觉得，我的心也跟着扑通扑通直跳了呢。",
      "source_fingerprint": "8fb57f2273f74f7bda23234b1632bd41ed763ed17336819f343c99dc25f340bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134200.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:3869819a379a2c3ca1d615db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "出战成员杏目，\n是目前在赛界被誉为锋芒毕露的奇才，\n一位好强而又优等生的后冠赛马娘。",
      "source_fingerprint": "fbb70cca9a040e35d4743948f2e6b07e3ab4a41c586fea96e07a92115d568b7f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134200.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:8a7c167aeb7cec056057d1d6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她和机伶金花\n因为宿舍相邻而有所交流，\n两人的关系也很要好。",
      "source_fingerprint": "ff5e406877c57a41018aded029ec2f2c581c19aebfb970b6b4d89a8fd3b2d958",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134200.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:9d644085a922fb21c298ae70",
      "kind": "story",
      "source_language": "zh-CN",
