    },
    {
      "uid": "zhcn:6f4f5d535de527750c78e016",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "放声欢呼",
      "source_fingerprint": "f6f9d4474a6735b6f626fab88bdf3039da94d23a4c9c8c9f6d7f45e584ff4250",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
