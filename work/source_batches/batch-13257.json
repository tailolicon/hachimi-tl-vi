    },
    {
      "uid": "zhcn:9a160a5c20a584e8f81f77d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以耐力训练为中心，\n我们进行了无数次训练——\n接着作为收尾。",
      "source_fingerprint": "ec956ffbb0a6ad18130dd1d48c9ba7ec7004782cdcc2238a8f26ae5d674608a3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
