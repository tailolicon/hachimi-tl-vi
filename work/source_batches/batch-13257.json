      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "同僚训练员",
      "source_fingerprint": "30cad4c0485c1fa7c7e877f0ad534540bde42ced413ae685c32f9a917991308d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
