      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新人训练员",
      "source_fingerprint": "c2814acf58cca54d150211830eeae5640e61a7c568c13143d2e948409a8072f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
