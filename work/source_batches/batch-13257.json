      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:c2abdc7e05eb9b88a49a4c17",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我和创世酱，马上也要去海外挑战了。\n为了提升实力，也请务必让我们加入。",
      "source_fingerprint": "9c186053b2b90695bad505312e49108bd95ad9e544d9716168d895a1469dbcfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
