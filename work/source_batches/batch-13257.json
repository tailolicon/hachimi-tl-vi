    {
      "uid": "zhcn:c249216eac21de47ee3c5607",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "表情也，不知不觉间变得更加坚毅了呢。\n哎呀，让人忍不住想为她加油呢。",
      "source_fingerprint": "bbb1b183e90763e0d2e35796ff4fde6ab19d2202965b21e97325d15b8eba2249",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134204.json",
      "json_path": [
