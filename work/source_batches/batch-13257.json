    },
    {
      "uid": "zhcn:ffa7230ebb77896b04477576",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们几个一起合宿训练！？\n好呀，听起来好有意思！",
      "source_fingerprint": "ea20676d9fe1cf32d585d3c41b2d27e7ee6ec10b6f482d5c6326bef365ba245d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134204.json",
      "json_path": [
