    },
    {
      "uid": "zhcn:4444c063bec0959267a38b27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——对我来说，能够有机会\n向大家介绍训练员，是一件非常开心的事情。",
      "source_fingerprint": "266f5736c5b0b4335aad9f0902054bda59845db34b64cfb7a75d905121f138e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134206.json",
      "json_path": [
        "text_block_list",
        19,
        "text"
      ],
      "json_pointer": "/text_block_list/19/text"
    },
    {
      "uid": "zhcn:fc0663d1e220f140687f3744",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是啊，开得很漂亮呢",
      "source_fingerprint": "37a2fb5a3596e0c55b5d95fc4fe34439fe8eb28be88b1dd1515c819f9b3b0618",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134206.json",
      "json_path": [
        "text_block_list",
