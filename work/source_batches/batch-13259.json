      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这真是，太荣幸了。\n可是为什么，偏偏是我们呢——？",
      "source_fingerprint": "aa5ddfe3e7067236073865ea62e792095a0dee9146f1ce9aabece1e12153b77d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
