      "json_pointer": "/text_block_list/2/choice_data_list/0"
    },
    {
      "uid": "zhcn:8f9899a67645122737300550",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，开得很漂亮呢",
      "source_fingerprint": "a712326b8a44daeef55338a1599b3f20ca0ffc94d2e976893b3a628b02ddf5e2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
