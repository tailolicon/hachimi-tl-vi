    {
      "uid": "zhcn:52e0a9cdcd4258c9416e136e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『他们身上似乎散发着相同的氛围，\n我们将一步步揭开他们共同走过的轨迹，\n以及他们的未来——』",
      "source_fingerprint": "af3ea01f27e448e5274cfc07eab313666ac0fdd3cd22c2670da57cc6f0de1c19",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
