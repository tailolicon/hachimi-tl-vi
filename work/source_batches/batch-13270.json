      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我确信，在那里我能够献给您的\n不是降临在大地上的光芒，\n而是滋润心灵根基的沃土……！",
      "source_fingerprint": "996457ba1e04f25334e500931b92b1c9f916fdb39ac3c6d9da52a6b29c2bed74",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134304.json",
