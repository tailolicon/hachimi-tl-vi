      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你确信你的梦想就在那里，对吧",
      "source_fingerprint": "45abb15b5f5199c4559b7e2cc8c3e8bfcd27584eac7fb5de0a8e7072ad6f049a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
