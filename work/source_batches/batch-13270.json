      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——因为我想为您献上璀璨的光芒，\n所以才渴望得到三后冠。",
      "source_fingerprint": "692a1e6026a258236ac2e994fa9c37d4bcd8d2ed82e4b70096e184b505a7ae1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
