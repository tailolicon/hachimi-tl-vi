    {
      "uid": "zhcn:72e91aad5714f1f6fc9f9fd8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——我被吓了一跳。\n真没想到她竟然会以如此强烈的气势\n向我表达心声。",
      "source_fingerprint": "aebe5af8ec6c6e5d33fd6a81345e0f5a344d2955b3ae4aeb657ba04c5e9130ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
