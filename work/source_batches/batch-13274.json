      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——目送着她离开训练员室，\n我下定了一个决心。",
      "source_fingerprint": "4fe790af3520b82148d91a446dfaffcf943e16bd3cf4c4c01b0ad86a13d6dff4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
