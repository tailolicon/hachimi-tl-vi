    },
    {
      "uid": "zhcn:3809107ac47cfec3a40104ae",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "如果，她是想献给一位\n更有知名度的一流老手训练员的话——",
      "source_fingerprint": "7311f7129a1ac4325dee4ba0abae1dc613174b8d81cc431f527d7aaad3cad17e",
