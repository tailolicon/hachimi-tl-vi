      "source_language": "zh-CN",
      "source_text": "她不像唯独爱你或创世驹那样，\n能够吸引人们的心，\n并在那里产生狂热。",
      "source_fingerprint": "331c6346cd96571937356f8837ea2c69250ad9735f08d8f222c4840b4465ae90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
