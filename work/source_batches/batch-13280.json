        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:6032d0c4985459c6325a8c4c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我都想竭尽所能，一直去支持她。",
