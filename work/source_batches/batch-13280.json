    {
      "uid": "zhcn:89567fc70515c0e262d3b825",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她果然，是一位优秀的赛马娘呢）",
      "source_fingerprint": "ee03fceaab4d32ac69e1de992736af3f2581cb3c55338c221d37154205c96af8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
