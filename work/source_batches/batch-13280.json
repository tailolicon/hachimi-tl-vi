      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（在表演赛中，跑出成绩来吧）",
      "source_fingerprint": "cf7116134e875ff138fdf2854200ca07c21ab680d296d5223f85c2d4f3d6b83d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
