    {
      "uid": "zhcn:428b1f9f1ccc60993e87ea31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，我突然想起了\n在粉丝感谢祭上粉丝们的模样。",
      "source_fingerprint": "81a0fe8a7c2aacc1a066d4b0816f69d4bf1999af9c0d97fad0fd8888ae250c5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
