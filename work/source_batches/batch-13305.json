      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:a120d412ab001623e1911140",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某天早晨，我在学园前\n碰见了机伶金花。\n离上课时间还早得很……。",
      "source_fingerprint": "3a5ad5bcc7f4ab8ef282aee7aeeb4829b31ee87dfb6dcf7110585aa6b470ddca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
