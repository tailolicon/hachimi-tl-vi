      "source_path": "assets/story/data/50/1134/storytimeline_501134522.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:809815e35b6a5665e4663215",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那是大家一起观看\n神业为了学习恐怖演出而找来的\n恐怖电影时发生的事――",
      "source_fingerprint": "5e7be3445f6a3b52c919f1f4dc588a6d558f67cfa9382152d0b4144beba39ba5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
