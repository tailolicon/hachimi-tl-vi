      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "太好了――我也觉得应该会很相配。\n和这束满天星，还有花瓶的颜色……。",
      "source_fingerprint": "392fa79799d7e41692b422a0539b4bb1e1e69bc170e1f8b92bb505596d9b01ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
