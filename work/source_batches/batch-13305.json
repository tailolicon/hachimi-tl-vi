    {
      "uid": "zhcn:5b91451eab30c9111ae7c5ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "小苍兰的话……\n黄色，还是紫色――训练员，\n您觉得哪一种比较好呢？",
      "source_fingerprint": "3dff84a616499ad5b87c973347653a79e694ee0665d0104bdd54d1b914445bb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
