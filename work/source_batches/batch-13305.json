    },
    {
      "uid": "zhcn:3d9bc95022aca49d1448ccc1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "向无形的悲伤伸出手",
      "source_fingerprint": "5031969da4f44e424e5d95db8296612aefcbfa2c31c135e0fe2a5f6095709c00",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
