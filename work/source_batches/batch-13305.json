    },
    {
      "uid": "zhcn:7e9fb5e56696d1e39564e199",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花一直犹豫不决，\n最后悄悄地，轻轻叹了一口气。",
      "source_fingerprint": "22612f8667c6f7d58c650db257f44afcb728d3b9dfaf7a488f97ba378acaf14d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134522.json",
