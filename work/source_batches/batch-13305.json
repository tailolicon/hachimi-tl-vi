      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个嘛……这边的怎么样？",
      "source_fingerprint": "cbcfebb20d4bc61d9074376faeac5b4527c06203d0a7eefb3fbb74cb01ed5e58",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
