    },
    {
      "uid": "zhcn:17eb7627c10f3fdccaf466d1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "皮肤状态有些……",
      "source_fingerprint": "5fe157df73e84918e815853cce22af4de61bfafecc6fc766eb43110fb57eacee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
