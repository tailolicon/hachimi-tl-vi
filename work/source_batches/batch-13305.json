      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――就这样，机伶金花开始打理\n装饰在学园各处的\n许多花瓶。",
      "source_fingerprint": "a82c6e4440c0796afbf3fb570c6685a238354602bb0434f2d62247009b10a6e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
