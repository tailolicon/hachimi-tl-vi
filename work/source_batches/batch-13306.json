    },
    {
      "uid": "zhcn:c43f4a7fab889f9c7f0f8fa2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢您。\n这个秋天，我一定会让胜利――绽放。",
      "source_fingerprint": "7ef592b248d7a5386f18cc87850c70ee759713c2a0b9561c48c70a6315aa2a63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
        "text_block_list",
