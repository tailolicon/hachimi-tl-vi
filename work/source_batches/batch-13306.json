      "source_language": "zh-CN",
      "source_text": "又――变干净了呢……。\n难道说――",
      "source_fingerprint": "3147460b7eac2f9d520c53834322770a9eb025c38fdb731c85fc3eb699813f2c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
