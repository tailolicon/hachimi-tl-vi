      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哪里……\n我只是因为喜欢，才这么做的。",
      "source_fingerprint": "b8a2592a79cb7f72f8ae262c3f7a79fdfafea939360f55b17c113f1c0952b13b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
