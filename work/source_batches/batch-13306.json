    {
      "uid": "zhcn:4018ca83188fa3e9207d99e4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――辛苦、您了。",
      "source_fingerprint": "30166707014c5e25a01f28257dc234d648b46e5200602adb0f5ce0f1043a5a54",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
