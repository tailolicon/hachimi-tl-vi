    },
    {
      "uid": "zhcn:e7274b41e929d32cac5129dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天训练结束之后，\n您要不要去看看呢？",
      "source_fingerprint": "54dad92eb2183048d64c16a8d1248c58b89937eb819e412f736540c482bfbaf2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
