      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "果然，是训练员呢。\n呵呵……终于――被我抓到了。",
      "source_fingerprint": "870e5c5ce173c90b49e44819e960c3d270c85830a1aa1ab84e962bc8f73f3bb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
