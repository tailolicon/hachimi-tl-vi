    },
    {
      "uid": "zhcn:ef7065dcf748e96c85a15f3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过――呵呵――\n谢谢您。",
      "source_fingerprint": "a5e18654d4545e247ce74401d49b298466f1e0bf1204002b1b4ae87292060140",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
