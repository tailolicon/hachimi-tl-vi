        "text"
      ],
      "json_pointer": "/text_block_list/46/text"
    },
    {
      "uid": "zhcn:1a01a5581c89a1cdccd40ca0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后，我们两人一起照料了玫瑰。\n那是一株纤细，却又让人感受到生命力的苗木。\n然后，过了些日子――",
      "source_fingerprint": "31ce63c462c94010b783c1bcf42f4003526d3558077f80d7d3b56b445a2a7387",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
        "text_block_list",
        47,
        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:eb4f9e124ebe0fe67f0b5ce6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
