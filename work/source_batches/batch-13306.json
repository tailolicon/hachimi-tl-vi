    {
      "uid": "zhcn:cea3d89802db0b3f2cf1d74b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦，很漂亮呢",
      "source_fingerprint": "0f4d3d484b4f98df066f50dacfa1ed23dadec38553aa476399579f7497e55128",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
