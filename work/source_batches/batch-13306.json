    {
      "uid": "zhcn:05a396c297f34d33583aba05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "金花……那个，擅自这么做，对不起",
      "source_fingerprint": "ab596e6d2bea9d1ffcf535f5432dd3528b23b3eee75ae0758c916f510211d301",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
