    {
      "uid": "zhcn:d010c23591f33c81855cf019",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的――不过，这也很有夏天的感觉。\n我老家的庭院，也是这样的。",
      "source_fingerprint": "81d763ab22da88bc37f38d984d976d3458c0b78a2f2d898ec81f58b89095efcd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
