        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:63ee3bf206ae8fa1114ec9fa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们来到了寒风吹拂的田地。\n机伶金花说，\n她要照料三色堇……。",
      "source_fingerprint": "9ffcc96f87e49ea107aba3ef2ceef8b29b35390e1448b01a0aee4de513d13024",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
        "text_block_list",
        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:42714b0abf628af5a8a92dce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "色彩鲜明，真漂亮啊……！",
      "source_fingerprint": "2b48c063397fbdf7e276402b5ec7d3189f75ffd9891f720e3d79c1f611af2330",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
