    },
    {
      "uid": "zhcn:4e5712fdc665b3cbb337ca51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢您――\n冬天的景色会变得有些寂寥，\n所以我想，至少能为这里添上一点色彩。",
      "source_fingerprint": "1b00efcdc89d85a9bf7de9ee95d79f7fc7b29314c025a4f7a5cc1f3130f49c53",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
        "text_block_list",
