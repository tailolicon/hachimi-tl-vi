    },
    {
      "uid": "zhcn:7c1dd50e9b3ca34a440288b7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "三色堇是即使在冬天也能开放的坚强花朵。\n不过……我还是想替它们做好防寒措施。",
      "source_fingerprint": "8e65377245359d28c40252436a0c0c42aebc17a30b1970696f1bc87d2a051a8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
        "text_block_list",
        54,
        "text"
      ],
      "json_pointer": "/text_block_list/54/text"
    },
    {
      "uid": "zhcn:c303dce19cdc925fcc94e42a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好——就是这个吧？哇哇……！",
      "source_fingerprint": "f32da9a328c879f398651489afae26acda94e960b18a386f99b52d90e6de78db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
