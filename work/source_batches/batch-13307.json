    {
      "uid": "zhcn:e2aa90cb32cbc3af30bc509d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您没事吧？\n我们一起，把它按住……！",
      "source_fingerprint": "14cdaf5dcde7713570f6c60c30293bfef5ce4b332c3f4075de6b31bc3abf3e51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
