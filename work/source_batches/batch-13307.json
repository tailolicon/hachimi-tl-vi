      ],
      "json_pointer": "/text_block_list/53/text"
    },
    {
      "uid": "zhcn:b37d937693dcf800563e425e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花",
      "source_fingerprint": "955cd4363878ef381a312628deed024641cd3a750624558cd2f55accb62d0a66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
