    {
      "uid": "zhcn:a00c7a05622cbbba09d4c952",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在秋末种下了许多。\n为了让各种颜色彼此调和，\n也仔细地安排好了位置……。",
      "source_fingerprint": "54c67f64b423f6bd78e18c6f233bcf0f7645f94f7f32cfdc34347fde83ba7adc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134524.json",
      "json_path": [
