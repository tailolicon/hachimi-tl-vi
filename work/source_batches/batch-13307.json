      ],
      "json_pointer": "/text_block_list/57/text"
    },
    {
      "uid": "zhcn:7030bd9ec64bceefdec6411c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要、要把那么大的花盆全都搬过去……？",
