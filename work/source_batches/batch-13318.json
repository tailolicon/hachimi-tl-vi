    },
    {
      "uid": "zhcn:27e45979a75da431c478b51a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "直到训练员怀抱黄金花束的\n那一天为止――我绝不会折断这花朵。",
      "source_fingerprint": "99a41f4e14516f28e516852ca1781b4ddee7dfd23074cd37c639ae6af16f344d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134711.json",
      "json_path": [
