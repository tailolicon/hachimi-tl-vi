        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:86a6c1379c7af22a09d4af3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这次一定不会输！",
      "source_fingerprint": "0cbac891157c5704c460960a710d92a599ab52c1a5a4dc091a5c82438f5a76d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
