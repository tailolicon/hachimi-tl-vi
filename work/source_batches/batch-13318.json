        "text_block_list",
        8,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/8/choice_data_list/0"
    },
    {
      "uid": "zhcn:971a2491e3938dfa471cb8d2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我明白了。接下来会稍微严格一点",
      "source_fingerprint": "61ef3090f24c6a525da51df7ebad3145843c43f0928f21cab1c641e5e8351ac2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
