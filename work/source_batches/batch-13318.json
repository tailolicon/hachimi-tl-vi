      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇，非常感谢！\n竟然帮我们整理得这么漂亮……\n一定很辛苦吧？",
      "source_fingerprint": "8ab51d76d0206b288b0e30e420121bb6433e486e594c2ef42f059295a979102a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134712.json",
      "json_path": [
