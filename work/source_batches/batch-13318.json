      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我将训练中受伤的\n机伶金花带到了保健室。",
      "source_fingerprint": "084c9df15dadd7c6068090d5dd03e32c0084ae3a6686e2118987252b025a792a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
