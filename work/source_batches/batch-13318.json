    },
    {
      "uid": "zhcn:e418f5784cd404408400af62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好的。若想让美丽的花朵绽放……\n良好的土壤必不可少。",
      "source_fingerprint": "9713802c49ca9a750120071fbe3a726365769eb3df2f319dc92df9eba629673e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134711.json",
      "json_path": [
        "text_block_list",
