    {
      "uid": "zhcn:757d1a09d1da75b02776670d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可以的话，我想实际被追一次，\n亲身体验一下临场感。\n所以拜托了！　请追着我跑吧！",
      "source_fingerprint": "3dcccdaec5956efeb53c3a99b14d0369169d9fd0c34d6cead1763b3f43cc62ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1134/storytimeline_501134715.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:d0b83cf418b9dc1969bff11e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉会成为不错的训练呢！",
