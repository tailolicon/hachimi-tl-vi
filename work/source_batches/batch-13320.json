      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我明白了……。\n为了回应你的期待，我会尽全力\n追上去的――！",
      "source_fingerprint": "6e5d63ee44cd50b9976b8574834f8c28916e9957404882ee309de787b6029a4b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
