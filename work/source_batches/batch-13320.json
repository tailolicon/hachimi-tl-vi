      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要是能改天再说就……",
      "source_fingerprint": "bb6ce182fcc91b8114e07732a413990f175d6ebd96d6ef47fd424355443d0908",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
