    },
    {
      "uid": "zhcn:eb26626227005c7393c3f7d5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天就到这里吧！",
      "source_fingerprint": "147fccbc4a088b47f6e8092095b144b033a6c6c8b16119a56a0e0520dff268e4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
