      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "结束了训练，打算就此解散而\n向红色梦想搭话。",
      "source_fingerprint": "773ce9b7d20ce0b7c817635a551b26219a8baec271be5a218aef95eec6df037c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
