    },
    {
      "uid": "zhcn:c4696cfbfb2c40b281b14865",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……那么，让我们开始新的试练吧。\n圣女，可没有停下脚步的闲暇。",
      "source_fingerprint": "a01f3ed3ad82b0c4b0eaff194bc915a9147c9fa54823e6f455f35f080f9aa4fe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136100.json",
      "json_path": [
        "text_block_list",
        45,
        "text"
      ],
      "json_pointer": "/text_block_list/45/text"
    },
    {
      "uid": "zhcn:c7200cbfce32ee5c6e6deb9c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
