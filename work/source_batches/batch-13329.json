      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为在跨越、跨越、跨越试练的终点。\n真正的光芒，正在等待着我！",
      "source_fingerprint": "815b7fa1ffbdc1fb1c56c583c7a2997e21083daa5553d47959bed830a3749832",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136100.json",
      "json_path": [
        "text_block_list",
