    },
    {
      "uid": "zhcn:d24ce7534b82f46dd2292e4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "开始吧，今天的试练！",
      "source_fingerprint": "a3b8d721b0b916c4844104d5b66137dc4237223ec997d48a162695c3a39320e8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136100.json",
      "json_path": [
        "text_block_list",
        47,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/47/choice_data_list/0"
    },
    {
      "uid": "zhcn:6bfbb64f1f7660ef62672a83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "视野，已然一片澄明。\n这样一来，就能和她眺望同一片风景了。",
      "source_fingerprint": "a32330b7bc1d3d3bbd811fb44da7cb4f89241f7f2bce02b5e4ee2c51e9ea6bb0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
