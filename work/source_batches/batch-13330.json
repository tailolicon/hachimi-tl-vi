      "source_language": "zh-CN",
      "source_text": "让我们再次祈祷并立下誓言吧。\n我绝不会背弃自己的信念。",
      "source_fingerprint": "2b70a6433e55e2dfdcdc7b35c2d30d39216478d6c81b6c0d8a93aa3965ef4caa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
