      "source_language": "zh-CN",
      "source_text": "……而我最大的试炼，\n便是那位绝对的女主角——景致小姐。",
      "source_fingerprint": "1b1534ac1e4f52f61a0de4e73a8a2b1f0be209ed301730f255800c0f15ca94ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
