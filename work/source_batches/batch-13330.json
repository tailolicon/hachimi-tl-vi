      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……不断前进的力量吧",
      "source_fingerprint": "6bddaf9c8a1fd0eb02315c980213d379678ab196384df5ac22c1177a8d3ea954",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
