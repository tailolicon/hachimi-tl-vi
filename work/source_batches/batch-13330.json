    {
      "uid": "zhcn:ac98086777b915474ba29010",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "治愈人们心灵的存在……",
      "source_fingerprint": "c2205f44a6aa6d21ed2f01fbaaf56765e6627178d50b06b5f98962385d13346a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
