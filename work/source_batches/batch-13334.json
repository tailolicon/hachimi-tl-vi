        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:7bf52665bf56fc785834691a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想的状态并没有完全调整好。\n因为她一直将迷人景致视为目标在奔跑，\n这也是没有办法的事。",
      "source_fingerprint": "72eeb8cf826e757c6b84a6f19eb4dfe15fbc3521cf224e54f35d1399efe3f8d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136103.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:99f4875d139eeaefc2cbfc1c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但若继续这样下去，\n别说是『秋华赏』，\n连经典级都可能以悔恨收场。",
      "source_fingerprint": "eb381d292f3815315f3c44090e63933f36be3b0d5add57a54787e96fbbfb56ec",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136103.json",
      "json_path": [
        "text_block_list",
        5,
        "text"
      ],
      "json_pointer": "/text_block_list/5/text"
    },
    {
      "uid": "zhcn:8b476f6d072919ea06068b82",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了不让那种事发生——必须采取行动！",
      "source_fingerprint": "a1c584d39cc0299907e15d4e2c3eaeffc0fa2b750f1ecb7de424ab19fab835ce",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
