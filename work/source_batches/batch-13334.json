    },
    {
      "uid": "zhcn:32e186b7187ed475eaf3ef6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "无论如何，伏特加的加入，\n让人看到了一线希望。",
      "source_fingerprint": "5327978f369c5dcd6ccd14e277af22364a84b1107dd718c4eed451d37d0d5b89",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
