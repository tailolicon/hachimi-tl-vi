    {
      "uid": "zhcn:b4c2ef8dfa8de9dda439c8a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "果然我们，无论身在何处，\n都是命中注定会相遇的吗……！！",
      "source_fingerprint": "3cdb3f2b4795b2e0f1cc74f329022750cfbe9073128c2e8f96b57a2d6c00bf3b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
