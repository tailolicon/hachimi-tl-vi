      "source_path": "assets/story/data/50/1136/storytimeline_501136110.json",
      "json_path": [
        "text_block_list",
        23,
        "text"
      ],
      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:9fec7e297d75a1c7fe9330bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
