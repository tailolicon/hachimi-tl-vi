      "source_language": "zh-CN",
      "source_text": "……训练员。\n我，现在依旧是一名尚未成熟的圣女。",
      "source_fingerprint": "d3c623e5ac0a5df9c488384bcee8d1839f46cffd219737fbccbabddadadc98ab",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
