      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:f8c690f8342be47a0d5fce94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正如所见――在红色梦想的体内\n『红之楔』的阴影已经彻底消失了。",
      "source_fingerprint": "a7bd8e3180267c637ebc699c5c52e94636beef8d5f3007ec51cecd791b407741",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
