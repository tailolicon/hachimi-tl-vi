      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:e75c35aaee124aebbdc629b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是的。\n明明经历了那样激烈的奔跑，\n却没有发现任何异常。",
      "source_fingerprint": "93fd206ba937e8ee58ded863118d7be210af305101b92a93b6aa9fb8be56f6c8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
