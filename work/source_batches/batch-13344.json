        "text"
      ],
      "json_pointer": "/text_block_list/27/text"
    },
    {
      "uid": "zhcn:1663b1067bcec9f9d9aeb3f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想的灵魂在\n喜悦、满溢，向世界扩散开来。",
      "source_fingerprint": "245fa89cb0f00523f58f70eedc65e167d52aa83b12ede3aa97193b3483a350fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        28,
        "text"
      ],
      "json_pointer": "/text_block_list/28/text"
    },
    {
      "uid": "zhcn:c5f813b1070072fd277eed6e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就这样，\n红色梦想制霸了『育马者杯』――",
      "source_fingerprint": "c42358c838d7735c15d88b95250f90619424fe0ce5b1f214a8e2364708995306",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        29,
        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:cb38a1c1e1c5934865f0d205",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在红色梦想面前，那扇大门终于开启。\n――向『育马者杯』发起挑战。",
      "source_fingerprint": "4a667c801a687a4da0f982b68234ad83dc75d5569cc4b2722bdd2ca5a1321575",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:266c92b86aec61ce9b7415b0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不仅国内，\n可以说是沐浴在了来自全世界人们那\n如潮水般的赞美之中。",
      "source_fingerprint": "afd05b1f499f747ee1ed6b5b673c3eaef4a275cb66cee9c14c78e4ef6ece40ed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        30,
        "text"
      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:f84541f182a9c477eed4486c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "然后，几天后――",
      "source_fingerprint": "4d2a1e80c2bf833f44860878ca65ddd3fecfa9c725d31667f4ac033cc297ec31",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
      "json_pointer": "/text_block_list/31/text"
    },
    {
      "uid": "zhcn:3d6829d0f0ff371ad46cf382",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
