    },
    {
      "uid": "zhcn:ea0b55a677092952c344e736",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呼呼……非常感谢您。",
      "source_fingerprint": "ab57e5c666864d2c46a2fa47380a49939a8b021f9baec6daddc7557c9441c673",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
