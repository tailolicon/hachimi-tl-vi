    },
    {
      "uid": "zhcn:27e7aa91a3c80a5c02f38c31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "连『红之楔』这一宿疾，\n都已被完全驯服――",
      "source_fingerprint": "72c7b6b7f7b5cd196b63d68708eeafe886f1c0004350ae97a4c1639d0e1cdbcc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
