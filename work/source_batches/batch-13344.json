    {
      "uid": "zhcn:065c1d3f021218224e827666",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了让圣女红色梦想能够\n真正闪耀的世界扩展开来――",
      "source_fingerprint": "5ae79faab9ed50e3e9cf93f01e249547980714e6324baa634a69f942672c8ce8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
