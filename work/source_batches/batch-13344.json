    },
    {
      "uid": "zhcn:fe4f76212e5b3a53bedad4d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可以说是完全康复了。\n说实话……这简直就像奇迹一样。",
      "source_fingerprint": "bbc7d88cc31c0caa3e14dc543d7f132f27563672bf6ff2e5f32f224a96b0367f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
