    {
      "uid": "zhcn:3652c5efa1d252d1eb1db9dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我，终于蜕变完成了。",
      "source_fingerprint": "ad2a05eba5a9fbeed95f4e241f23b9e187c878446122ccf7776af22ffbef0a9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
