    },
    {
      "uid": "zhcn:d98d7ce092d973e0a6cc4f04",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――……。",
      "source_fingerprint": "a335c086956a2172bf7dada0e5c662faecfa3f4b5bf53d65aae5517f6b73455c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
