    },
    {
      "uid": "zhcn:20e307f743becbcd3a659f45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "充满光芒了呢――！",
      "source_fingerprint": "8c9390d55365ef532509dda0a77501293c80d3e6ab21412bbe56370fbe6f38dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
