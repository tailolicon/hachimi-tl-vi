        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:ff86ee1a70467e13de5df4a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "医生",
