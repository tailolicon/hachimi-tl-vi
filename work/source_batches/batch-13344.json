    {
      "uid": "zhcn:138d5edeb94d0a512d8b30a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我在这之后，也会\n继续在世界里奔驰下去。",
      "source_fingerprint": "e512b891dd8f4918ffa78c4804b5a25b437c2b8825dae410a736cf01627b3773",
