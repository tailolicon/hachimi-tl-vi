    },
    {
      "uid": "zhcn:4d8272a2122ea9df7dd32a31",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "至今为止经历的众多考验，\n在那里获得的所有的祝福……以及痛苦。",
      "source_fingerprint": "00ea2a78724cb4f8d943442827b49b1f9adb578e5ae54f4b45ef980450c7ac6a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
