    {
      "uid": "zhcn:97c25c5567cae13f340674d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看着自己教导、引领的孩子们活跃在赛场上，\n这种感觉……是非常神圣而又高尚的呢。",
      "source_fingerprint": "6a1b075d96774b41ca7e7f2db872ea6673b8b2b61d8662c2244581d879a348f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        64,
        "text"
      ],
      "json_pointer": "/text_block_list/64/text"
    },
    {
      "uid": "zhcn:5b06858747f3a04106883056",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
