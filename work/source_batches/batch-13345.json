    },
    {
      "uid": "zhcn:976f37d595da6ccc3ae77b94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这两者的推动下，这个世界将――\n变成圣女红色梦想所应在的世界。",
      "source_fingerprint": "8464ef3b5f2aa40c49bbbf45a2df36c1638928986754f612b7f6265bb4f595dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
