        "name"
      ],
      "json_pointer": "/text_block_list/68/name"
    },
    {
      "uid": "zhcn:3ed093aba9742191d144e2e0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "变成我……以及所有相信着我的人们，\n强烈渴求的美好世界――！",
      "source_fingerprint": "53cafa2ecaca9f8140a6cffd12cd1653b8ce42d8aa3de47bebe1d52ffbebceb2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136111.json",
      "json_path": [
        "text_block_list",
        68,
        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:84e62112d17b5d1caac81cff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "世界，不久后\n一定会真正地获得新生吧。",
      "source_fingerprint": "e0dfd90152708652f50e5281239baf2fb3246ef9ef73fdd4aeb87bb6a33467a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
