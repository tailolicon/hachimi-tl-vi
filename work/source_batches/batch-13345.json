    },
    {
      "uid": "zhcn:a6e564be96effc7c0aaa148d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就让我来为你施加圣女的祝福吧。\n能让你变得愿意相信自己的，祝福。",
      "source_fingerprint": "f0bad5c8e347bf945c026bfe7b81c96f9646cb36cc27f3eff1e513eaffd9a9a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
