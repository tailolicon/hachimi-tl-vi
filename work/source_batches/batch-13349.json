    },
    {
      "uid": "zhcn:629dd59b87ef680c68bda867",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "景致小姐才是，被这个世界所深爱着的、\n“绝对的女主角”啊！",
      "source_fingerprint": "09e540426180333a0732eff840833cdd0e9c901f09a0e9a754550fb33d3e20d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        61,
        "text"
      ],
      "json_pointer": "/text_block_list/61/text"
    },
    {
      "uid": "zhcn:8a0330c691dd939fcb3ca572",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这是什么意思……？",
      "source_fingerprint": "1cf5059c311b72b89bded54db820c86d14d7b0df06ac190cc84028a8c36c123b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
