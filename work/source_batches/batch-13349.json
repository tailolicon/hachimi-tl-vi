    },
    {
      "uid": "zhcn:61be1d1989be09f572dc1e01",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这个世界接受考验的期间，\n免不了会被拿来作比较、\n或是遭受一些不公的对待吧。",
      "source_fingerprint": "ce92fb432fbac092c09e2901b64899f44538e39be1fa5d66e1be9802634f4764",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        73,
        "text"
      ],
      "json_pointer": "/text_block_list/73/text"
    },
    {
      "uid": "zhcn:ead12149234f326b026b7558",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
