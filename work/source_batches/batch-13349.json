      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:75757447d791b9e4bddf7726",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "收到了来自红色梦想那\n『有重大事件要说明』的报告。\n正想着发生了什么事，急忙赶到了约定地点――",
      "source_fingerprint": "ac73d3f8131fefc7de17e939646ed5864d1f99606aec75d5c4319ec31c1e40f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        60,
        "text"
      ],
      "json_pointer": "/text_block_list/60/text"
    },
    {
      "uid": "zhcn:49b4304e11acbbca92e7b1fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
