    {
      "uid": "zhcn:d163579e375d722ef4ca1009",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊，景致小姐，你正是――……！",
      "source_fingerprint": "b2887783791374f757cd8d46b7b9a2e8fd260d5255739421d3628be9e60a3674",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
