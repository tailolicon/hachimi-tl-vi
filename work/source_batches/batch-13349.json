    {
      "uid": "zhcn:34867224eb724722e4ec210b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那也仅仅说明，这个世界的女主角\n正好是景致小姐而已！",
      "source_fingerprint": "5d254c0cc13ce3ee76ea3ea5952e173b2433ba2af98f5b2a1ba8b6237e4481cc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
