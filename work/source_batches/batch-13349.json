    {
      "uid": "zhcn:ea0820f985f5ef5c01ff3e3e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她那出众的天赋以及天真烂漫的性格，\n俘获了所有人的心。",
      "source_fingerprint": "86182beb64f1a541567e6e4e7e4de8ab742d452fc0658af23b739ff525a46d9c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
