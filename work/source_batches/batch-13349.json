    },
    {
      "uid": "zhcn:eca5ddbe001058f1b3f9f5f7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "处在人群中心的是迷人景致。\n她和红色梦想一样，\n也是即将迎来出道战的“同期”马娘。",
      "source_fingerprint": "0a72977bac83bd9cf430434d12998ef29fd1c58b30a27d9bd8fb04b7dc17d753",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
