        1
      ],
      "json_pointer": "/text_block_list/77/choice_data_list/1"
    },
    {
      "uid": "zhcn:86bce40bde43241acffcc3c3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她既承认了迷人景致的厉害之处，\n同时也对自己是特别的这一事实深信不疑。",
      "source_fingerprint": "44764b3331ec963ceb7215120d22a372f51497e75d698a86afeb6b1c688c3dc5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        77,
        "text"
      ],
      "json_pointer": "/text_block_list/77/text"
    },
    {
      "uid": "zhcn:f0c98b34d2b8672acea4d2ff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        78,
        "name"
      ],
      "json_pointer": "/text_block_list/78/name"
    },
    {
      "uid": "zhcn:8b80afa1bfefb11389f42ea8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的，怎么可能会失去呢。\n――无论发生什么，\n属于我自身故事的主人公，永远是我自己。",
      "source_fingerprint": "500a1f236cf5e77acc56a474e1612beca7c6b0c30b6828c5388f31b4333d7bbd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        78,
        "text"
      ],
      "json_pointer": "/text_block_list/78/text"
    },
    {
      "uid": "zhcn:ddb438dd53189b6e7b2115a1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        79,
        "name"
      ],
      "json_pointer": "/text_block_list/79/name"
    },
    {
      "uid": "zhcn:aa9d7b268028dd87bdaa371e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每个人都是在各自故事里闪耀的、\n独一无二的主人公――\n因为这，是绝不会动摇的真理！",
      "source_fingerprint": "ae4b90aeddbd88585d5f49dc87f80a7b9c876f0a1f1edfbe8ac97fd49e09dc69",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        79,
        "text"
      ],
      "json_pointer": "/text_block_list/79/text"
    },
    {
      "uid": "zhcn:c01a374973bfc1d1f37bbef4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新人训练员A",
      "source_fingerprint": "e829f9d4dc056512054ee3af7d16ee643fea041192ab34f55f5b5f4bdc406a95",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        8,
        "name"
      ],
      "json_pointer": "/text_block_list/8/name"
    },
    {
      "uid": "zhcn:27a548294694f9fdb78054bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迷人景致……果然好厉害啊。\n在这一代里，简直是压倒性的强大。",
      "source_fingerprint": "581c41b8f5dc623085ac000a11b7dd6e696ba1bc7612be94d49f1998669ae789",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        8,
        "text"
      ],
      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:f691cfa8f8649d49f2796fd8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想不曾动摇。\n既然如此，接下来只需将自己的力量磨砺到\n足以与迷人景致抗衡的地步就行了。",
      "source_fingerprint": "65eaaa00e81d8089572f28b0535832ae571c6f21657d7335753ba4e467ae51fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        80,
        "text"
      ],
      "json_pointer": "/text_block_list/80/text"
    },
    {
      "uid": "zhcn:c6dee1371033350c70a02edd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "首先，必须在即将来临的出道战上\n拿下一场胜利――！",
      "source_fingerprint": "f66f5867d3b29ec2c071e846bcaae77b993805d1e6734376aa5f7f49bebd92a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        81,
        "text"
      ],
      "json_pointer": "/text_block_list/81/text"
    },
    {
      "uid": "zhcn:79695f61f3f960f165272e07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "新人训练员B",
      "source_fingerprint": "a6c20876c7d64f38b15f4ea428eef16a66b8c7b7a4d7ba18dfaddf6beba0ea1f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        9,
        "name"
      ],
      "json_pointer": "/text_block_list/9/name"
    },
    {
      "uid": "zhcn:aae8ace8126097dae2b3392a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有种所向披靡的感觉呢。\n不愧是“次世代的女主角”啊！",
      "source_fingerprint": "7873be029811b82afdb7864f92f3205309e573d78bf2000f87668ef945dbd6fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:c42184299072b34face12777",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是女主角",
      "source_fingerprint": "f1066c32795af4d1bc876473243cd500fd4cac88e51505bcb8309998504ea8d4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
