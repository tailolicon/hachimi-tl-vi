    },
    {
      "uid": "zhcn:bcb185b87c56c8a42a1391f5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，这并不意味着我有什么地方是不如人的，\n也完全没有必要感到自惭形秽。",
      "source_fingerprint": "e4709b1d0151ba7eef0afe857d5b65994cde37abf68367447d9c57ab76571382",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136113.json",
      "json_path": [
