    },
    {
      "uid": "zhcn:7e518fa57436cf06ee0b6619",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正当自己一边这样\n想着一边在学园内走着的时候――",
      "source_fingerprint": "b4e88d9bccea0addf33b6c9bb1ded1b19575e3047515496082fd0c21c92f83ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
