      "source_language": "zh-CN",
      "source_text": "『只要把彼此的眼睛当作镜子，爱便会自然\n浮现。来，牵起彼此的手――』",
      "source_fingerprint": "ee0f9272009954705d682f923413daddf505dac1c8793ccd2344404d215bd235",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
