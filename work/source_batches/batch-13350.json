    },
    {
      "uid": "zhcn:27da49ed5909b4fb937916ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『现在，就由我来赐予大家圣女的力量吧――！』",
      "source_fingerprint": "2675b971a6f38e0ac44d54e6f2660f32110702509287c3d9cd2d0496d473c934",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:e9dd11077324d0520ce6f78d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以前从伏特加那里听到过一些话。\n如果还有其他知道异世界的马娘在，\n真想去请教一下。",
      "source_fingerprint": "30242155afcb7a7f6e8f12d26b5e77fe2104dcec36b29a13fdf7e01deabef4cd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        4,
        "text"
      ],
      "json_pointer": "/text_block_list/4/text"
    },
    {
      "uid": "zhcn:f83ed8d49c1bb28772289069",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众们",
      "source_fingerprint": "fb9eb6518e94670473e15bc84b7c6dc3f58687c51fb543b0e89b34018813d2d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        40,
        "name"
      ],
      "json_pointer": "/text_block_list/40/name"
    },
    {
      "uid": "zhcn:d3cbbf8390c280456c3b3c8c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『梦想大人――！太棒了――！』\n『噢噢噢噢！』",
      "source_fingerprint": "36b3d9e96b20caf803879aaeb84681d0e2c805c27aa2eab22b6c3a930866ee42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:5aaabf2cc8fc55486b12283a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为演剧同好会的帮手饰演了圣女一角，\n收获了观众们热烈的欢呼与喝彩。",
      "source_fingerprint": "ef0ff8531c875e9f8fbab78016af64301cbfb8cb7de895cca9ce47bc5aba1889",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
      "uid": "zhcn:d50568df4310926e5c963260",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
