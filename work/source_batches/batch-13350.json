      "source_language": "zh-CN",
      "source_text": "只要内心充实，就能前往『异世界』了吧？",
      "source_fingerprint": "6b5a7caf331053d1ce5030cd6b9c0d51c4eebfec7f9c90dcf8de8244159632fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
