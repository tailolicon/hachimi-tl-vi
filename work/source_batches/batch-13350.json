    {
      "uid": "zhcn:86ce996d76edb3fd59517a89",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『迷茫的人们啊，无需感到恐惧』",
      "source_fingerprint": "111ba53d4abce45a4135b0c2ff004203b951ad9c951de808797a530744437b16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
