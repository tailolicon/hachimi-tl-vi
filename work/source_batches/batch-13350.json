    {
      "uid": "zhcn:7ef874b5a414318fcf372474",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『在这里让我们再次，\n向对方许下永恒的誓言吧……！』",
      "source_fingerprint": "7262038adcb55ff751b604c392deb49b81504d503985e4ca69ea942558a551d7",
