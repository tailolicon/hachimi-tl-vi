      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:39735863e884c07cf4020715",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但我觉得，这至少在思考\n『如何前往异世界的方法』时，\n能够成为一个线索。",
      "source_fingerprint": "8b9de726605c2a66cdbed67070da5e355993eb6075569bf9fbfb1ed0ebc8b3f9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
