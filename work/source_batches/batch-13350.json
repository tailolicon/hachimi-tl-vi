    },
    {
      "uid": "zhcn:a6bb9fb13ef3e484d3eb04aa",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然并不能确定……。",
      "source_fingerprint": "9bded7116118c80761160e983e51b4b0abb5fb76c734c2411d4cd265c2b3caf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
