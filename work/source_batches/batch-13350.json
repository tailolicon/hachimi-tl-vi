      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:82e2778892f74bd744863a9f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在训练的间隙，\n一起去品尝了人气极高的胡萝卜甜点。",
      "source_fingerprint": "ff3532ff17c7bf04d4d4c561345e8f2e9954c596e7d93c11afac5e865ded557c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
