    {
      "uid": "zhcn:0d08d4f6c915b7f9d41fbcfe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的……一定。 \n当能够获得发自内心的充实感时…… \n崭新的大门，应该就会随之开启吧……。",
      "source_fingerprint": "291047aa983892be860fd7189f0bb97f28cee97cc54300d83d21bc387fd81351",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
