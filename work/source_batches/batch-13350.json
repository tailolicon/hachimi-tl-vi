      "json_pointer": "/text_block_list/31/choice_data_list/1"
    },
    {
      "uid": "zhcn:66687eccfa97682e3f68929a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这背后，是不是一直都有着\n『想要获得充实感』……\n这种想要去填满自己的强烈渴望呢。",
      "source_fingerprint": "7f6856aebf3731451c2bb433dc7982a04f0c27d36265696f963bd2aeb9fa555c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        31,
        "text"
      ],
