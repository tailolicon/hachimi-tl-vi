      ],
      "json_pointer": "/text_block_list/35/name"
    },
    {
      "uid": "zhcn:71228f420a2fae58b256c022",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哎呀……原来充实感，\n才是通往『异世界』的钥匙呢……！",
      "source_fingerprint": "6d1a6296e3b4986f292643f43f184bc6730312500af167740cfd7e9cde1bbc3a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        35,
        "text"
      ],
      "json_pointer": "/text_block_list/35/text"
    },
    {
      "uid": "zhcn:94ebcc587af9b8b12774a6e8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然如此，就必须去探索能\n让红色梦想感到满足充实的方法了。",
      "source_fingerprint": "cc70aa991fe0dd8a486cdc6d55b074b5e192fc3401ab0ef6772a187c3ed05b2e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:76ff0683ed6f50a50d30ca9a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从那天起――\n让红色梦想获得充实感的日子开始了！",
      "source_fingerprint": "4f029a8dab68fc966f9c3f33b81504d0a56329d7c866c3b337c51beccb6ce73c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:64a10ffda646c86d29c5c70f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
