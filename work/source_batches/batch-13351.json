    {
      "uid": "zhcn:809397cade1e4d1e16164014",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这对我来说，才是真正的『充实感』！",
      "source_fingerprint": "ac3268cdde0fad3bfed3d9bd49918639818dacda550e3d2585f2314bcfb141aa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
