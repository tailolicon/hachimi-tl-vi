    },
    {
      "uid": "zhcn:e73a259b37a1da44943406b9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想所需充实感的真面目。\n看着她拼尽全力奔跑的姿态，\n自己也渐渐开始意识到了。",
      "source_fingerprint": "1004e9fd668be2af3b42b193e21ba117bf3276a5056210f6d3a3f17d429bf03f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
        "text_block_list",
        67,
        "text"
      ],
      "json_pointer": "/text_block_list/67/text"
    },
    {
      "uid": "zhcn:f425a7d53555a3e892f78c94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
