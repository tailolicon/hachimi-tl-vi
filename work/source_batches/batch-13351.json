    },
    {
      "uid": "zhcn:a3b1ec8a708a8203986218e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她所应当驻足并前进的道路，\n绝不是一条被人牵着手、 \n铺设得工工整整的华美坦途。",
      "source_fingerprint": "bd8bbc7a6835781b3f16540b7219087dbc97def707c85991b079f4304fc4839c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136114.json",
      "json_path": [
