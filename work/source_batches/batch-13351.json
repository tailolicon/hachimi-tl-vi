    {
      "uid": "zhcn:0f7b91db38622b2948d6bcf7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这对我来说，\n才是毫无疑问的『充实感』――！",
      "source_fingerprint": "da5a55dfd251b01434dedbec150b30db6129b1f6d2d268c219752e993570146d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
