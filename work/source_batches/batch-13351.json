      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "把时间告诉她后，\n她的脸上绽放出了满面的笑容。",
      "source_fingerprint": "b186028b79d77a14271e54ab99cd2d9e7e77493092fea011d546d6fbb8bcf969",
