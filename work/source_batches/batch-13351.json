      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:a07182f5e784349a9dd4544e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（被别人赋予的幸福，是没有意义的）",
      "source_fingerprint": "83d99abedeba727ff86c73dedfe80579599437cde4a9233167c7430ba142cf4c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
