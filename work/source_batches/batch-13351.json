      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……哎呀。真是少见的客人呢……。",
      "source_fingerprint": "252462228a0c0132c3e1e74c523a908e334abc3ec6ea1d3507ac5ff2bdcda663",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
