    },
    {
      "uid": "zhcn:dc3caab056121336a4fca381",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "特立独行者的誓言",
      "source_fingerprint": "f5e0cfc2111615563fd2083a2c8a26ce85c69f762bcfd63a4deb232e3394634f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136115.json",
      "json_path": [
        "title"
      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:9ec7b91d4b3f2e39b93dde96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "自『维多利亚英里赛』已过去数日。\n那一天的冲击，至今仍无法完全抹去。",
      "source_fingerprint": "6620c732b6e44dcb5f34b02830b9ad2db6bfd7be0fd898769a65aea40f795d65",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
        "text_block_list",
        0,
        "text"
      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:1ab4d6dc3f813730901b3248",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
