    },
    {
      "uid": "zhcn:23d08b3a7fe8a5d6c6e7e7a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "随后想着是否也能让红色梦想参赛，\n于是急忙进行了交涉。",
      "source_fingerprint": "a35f04fbee514def7e2eed4097844503a50fd824eaf9cf4576290a8ae3c6c7e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
