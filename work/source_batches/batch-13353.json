        "name"
      ],
      "json_pointer": "/text_block_list/1/name"
    },
    {
      "uid": "zhcn:8ed98bb31e06b6cf42911b83",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……『红之楔』很容易转为慢性疾病。",
      "source_fingerprint": "c22ff0a5e1cd30e9fa056f6355be71eef60377c9e092d70e0873a765e470fc7a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
        "text_block_list",
        1,
        "text"
      ],
      "json_pointer": "/text_block_list/1/text"
    },
    {
      "uid": "zhcn:6ab79a65bf367763f0005e63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这一切，都是她教会我的。\n――正因如此。",
      "source_fingerprint": "967a0b34190af56ae148a9f426385243432be0b67a0a53444b7f81397ac10f80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:4d89090c31c78b238da1863e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也要，继续挣扎到底！",
      "source_fingerprint": "7b6c47a23afe24330329e7110f3dbc907f636adfc909a64be3dbe82eab175d57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
        "text_block_list",
        11,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/11/choice_data_list/0"
    },
    {
      "uid": "zhcn:1375a0729983a3967f8273eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我也要，继续挣扎到底！",
      "source_fingerprint": "7b6c47a23afe24330329e7110f3dbc907f636adfc909a64be3dbe82eab175d57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
