      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（想要根治，非常困难……）",
      "source_fingerprint": "c8178b0bb7c6b7904c850d31aea2c8934eeaf2a3c3e671b5e96bc0054a50bc6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
