    {
      "uid": "zhcn:2d8de22b118dcc65b3b39ce3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了将我从『红之楔』中拯救出来，\n您竟然如此拼命地为我筹谋策路……。",
      "source_fingerprint": "e73acbdb7757029410c637eb777d22e800c1818f399ced55ce29e45b8fe903a4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:672f230752a02451b30f5cff",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那、那么……！",
      "source_fingerprint": "eb6cda1efd6ad321b61d95fe6e75f08fd1e9281e597f4a7cad7dc64bcafe748c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
