    {
      "uid": "zhcn:a6753b89ad4a080118276567",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………。\n由衷地感谢您，训练员。",
      "source_fingerprint": "2eff8c716f648a39a4e08d88ac2db6f98cb1beca250ff707a696d0b9e3c651ee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
        "text_block_list",
