    {
      "uid": "zhcn:3712121b1206e46de9ce7bb9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，还不够。",
      "source_fingerprint": "64e06858ff32a252d5bd0764a9cfdd6a6e005f97bdbe3e480e656ab22cf8973e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
