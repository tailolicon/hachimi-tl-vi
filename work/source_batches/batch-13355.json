    {
      "uid": "zhcn:819ef4c03ff76df8cf983e07",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "下一场比赛……选『札幌纪念』怎么样？",
      "source_fingerprint": "000280e449651a7b24cc4e81ff80c2de4800d9a352605eaa879761e11f31b559",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
