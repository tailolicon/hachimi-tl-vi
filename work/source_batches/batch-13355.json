        "text"
      ],
      "json_pointer": "/text_block_list/59/text"
    },
    {
      "uid": "zhcn:dd08e001d1a28094e292128b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明明她的奔跑，已经开始受到\n无数粉丝的由衷期待了……――",
      "source_fingerprint": "36a90bc8e798bde1a11199df758c428cf58d3fb643d5ae5dd0e1e9b12730be80",
