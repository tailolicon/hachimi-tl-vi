        "text"
      ],
      "json_pointer": "/text_block_list/56/text"
    },
    {
      "uid": "zhcn:d2003c946b9ff6349180aa3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我觉得这很乱来。\n但正因为这份乱来……\n才是我一直以来所深深向往的、圣女应有的姿态。",
      "source_fingerprint": "a31736c1209bc9f527d56c5da85bfaa015d47b96459658ef77329a4a525267ba",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136116.json",
      "json_path": [
