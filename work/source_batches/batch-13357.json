      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但是……她却完全没有表现出那种迹象）",
      "source_fingerprint": "2ffcfb09491265e1271f233250de04a045d75c0eb41884ebaad71031534491d2",
