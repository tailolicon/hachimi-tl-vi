    },
    {
      "uid": "zhcn:4bdfd18c4bb4c13f498dc57e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是，训练员！",
      "source_fingerprint": "fc17b9300bb6974ce93e28b0f0c2eb1156888cd74d66e4ef4fa709585dacfc8e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
