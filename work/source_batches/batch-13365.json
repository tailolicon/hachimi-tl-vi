    },
    {
      "uid": "zhcn:c3bfedcf3f89e9dbb5dd8708",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这也难怪……。 \n毕竟那位大人，可是大家心目中憧憬的焦点。",
      "source_fingerprint": "77b9ed26ecbe75735b68d9ffd8f46bc94dee87636a3ce0cd065a230d366c9aa9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
