    },
    {
      "uid": "zhcn:4b1bcb074128e44ea7eaa67e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而在另一方面，她也是一位曾斩获了以\n『宝塚纪念』和『有马纪念』为首的众\n多重赏赛事的实力派选手。",
      "source_fingerprint": "ae2aeb53bde1ef10aa17206ca2753186b8fba417292b92e8dbe4095d849e6b1b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136206.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:744c984657f7070776c2671c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136206.json",
      "json_path": [
        "text_block_list",
