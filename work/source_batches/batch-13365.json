    {
      "uid": "zhcn:4db1a74aaac8930849169b00",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在这名为『日本杯』的大舞台上， \n我连对您的憧憬都将化作自身的给养……――",
      "source_fingerprint": "f40494b93e3e2752bdbd01f854124ead6f74bc8ac79da46c5bfe0a079da8f185",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
