      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:27a9055eecf9cf3a210aa633",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "迎战日本杯",
      "source_fingerprint": "161987fbcae1ab9777f8f1d71aa75dcd78bc351e45651e097dbc397ac741a104",
