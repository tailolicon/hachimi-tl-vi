        "name"
      ],
      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:3cc6784ff0ed7584f31d84ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想请您帮我审视一下。\n那条真正通往异世界的，道路――！",
      "source_fingerprint": "b8d8babda5e7acf1ad4a7fbe2e8f04b00338695c574ea019cd32ee896a4fd888",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
