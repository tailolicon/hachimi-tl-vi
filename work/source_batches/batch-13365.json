      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『凯旋门赏』，或者是『育马者杯』吗……。",
      "source_fingerprint": "5fbffc98ab5bea3ef4bde3f039c20588f40c11ec3d7ac822d32c590e9b2c2d95",
