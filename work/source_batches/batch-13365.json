    {
      "uid": "zhcn:a04e945af3a3ba407c8cb990",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（两者都同样精彩，\n而且，是非常严酷的试炼――）",
      "source_fingerprint": "f75753ed3dd48011c6f7e9140d0895b8a8c0a0f5516dbe6cd1eed41dfb65cefa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
