    },
    {
      "uid": "zhcn:1164f5778a29dedbc36ffebf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谁都正苦苦渴盼着， \n目睹她在『日本杯』上的华丽身姿呢……！",
      "source_fingerprint": "bc20d38d7fc67adc4ec502317278800a5e7c4f534d0b4549519dd1392f2e01a6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136205.json",
