      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:4c79f64306c9aa9e7a0b3b4b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦",
