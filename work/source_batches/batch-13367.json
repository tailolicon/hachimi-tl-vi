    },
    {
      "uid": "zhcn:ac373697be92bc112cf3b52b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "要是不能动真格地比一场的话，\n那也太没劲了吧？你看，大家可都在看着呢。",
      "source_fingerprint": "90253db0d99bc86b8735ae84cbc3815e73c7c491cde363248ec5d5f7777f0481",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
