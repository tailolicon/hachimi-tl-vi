    },
    {
      "uid": "zhcn:0566d2ec9b3f5909409578fb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦",
      "source_fingerprint": "1f5020441e758dd5bda3c9e47666e17b05f8b71b8aa3e416da7e0196d5a2fc03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136208.json",
