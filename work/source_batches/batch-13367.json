    {
      "uid": "zhcn:8c8f100df7d6560ef25e4730",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "佐敦小姐。\n感谢你的关心。",
      "source_fingerprint": "9cd844cc5c9d0ad8317025ab19535e4eac599ce8100730c88cbc86c5c29d9d6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
