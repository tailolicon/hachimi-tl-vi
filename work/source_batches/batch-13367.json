    },
    {
      "uid": "zhcn:468106e7551af11cae2798c9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔哼哼……――如今，\n就连这北方大地的凉爽微风，\n也都成了我的顺风。",
      "source_fingerprint": "a28a962a10cf0b2c9b7e4556154f1a2868fd6ba2a41a4a84b8d1fb224e2f0feb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136208.json",
      "json_path": [
