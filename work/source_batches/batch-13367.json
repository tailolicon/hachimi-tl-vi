        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:eca1733b2cead08d3de0bdbe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "东瀛佐敦――\n是在这场『札幌纪念』中，与红色梦想\n同样备受瞩目的赛马娘。",
      "source_fingerprint": "cc37c7809a486cf48708720ccf4d64cba843c635e793cff20adcb43989e49d51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136208.json",
      "json_path": [
        "text_block_list",
        12,
        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:4668b3b535e197d81439ff63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "红色梦想",
      "source_fingerprint": "405c5a0b0ebadc3e73aa5cd38d97e1245d0918e4d04ce079a699041f7ad83372",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
