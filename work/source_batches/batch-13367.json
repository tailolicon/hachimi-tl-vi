    {
      "uid": "zhcn:b14b977aa101598686b6ac05",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过看起来状态挺不错的嘛？\n不如说，好过头了反而感觉有点超现实了吧……。",
      "source_fingerprint": "c717fb50b4ac248ea28897e7254b20b5a616e01b2014c8b0a057f0c67755744f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136208.json",
      "json_path": [
        "text_block_list",
