    },
    {
      "uid": "zhcn:b1ac2195b09981c480510a12",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看吧，你也感受到了对吧？\n那在背后推着圣女前行、精灵们的呼吸声――！",
      "source_fingerprint": "71badff74028d011b7ef54b3c00d0993ec36277f9303c0ecb4a3c97f28fe921b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
