      "source_path": "assets/story/data/50/1136/storytimeline_501136208.json",
      "json_path": [
        "text_block_list",
        10,
        "name"
      ],
      "json_pointer": "/text_block_list/10/name"
    },
    {
      "uid": "zhcn:292d81a667d81306fcdbfd5c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之前听说你在赛场上流鼻血了，\n真的吓了我一跳耶……。",
      "source_fingerprint": "b05bc1e6dd31e0d24e2ebdaaa324055004b9bd5ea156a9f041c0541f057f8a30",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136208.json",
      "json_path": [
        "text_block_list",
