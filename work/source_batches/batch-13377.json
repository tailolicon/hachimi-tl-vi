    {
      "uid": "zhcn:4d8b1014015e5232fa97d0f6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我们走吧。为了迎接即将到来的最大试炼——\n也就是经典级的战斗！",
      "source_fingerprint": "77dd063b86def9585b8724c8f1fe9083348fa80f5898fec77ec3cf7f32b681f5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
