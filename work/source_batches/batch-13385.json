      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你在比赛中感受到喜悦，是在什么时候？",
      "source_fingerprint": "799a116cf4a3e3766ee80fdfd252d1418bca68a59327ad0e208bb5666eb9ea0b",
