      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好……！古马级就让我们将目光投向海外吧！",
      "source_fingerprint": "a357be3594fac1448423346b9470c506a0d846a3c24a713759b64c19e52db818",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
