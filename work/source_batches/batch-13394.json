        51,
        "text"
      ],
      "json_pointer": "/text_block_list/51/text"
    },
    {
      "uid": "zhcn:425a2c664a81daf9e20edbe8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这种想法，我并不是没有产生过――",
      "source_fingerprint": "0499a466a03f515bdd20479f7bf45997ac1853ed60946cf7256d95178fb1e6e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136315.json",
      "json_path": [
        "text_block_list",
        52,
        "text"
      ],
      "json_pointer": "/text_block_list/52/text"
    },
    {
      "uid": "zhcn:7e4db8a647a7ace3e0c3d55c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是在历经了三后冠的洗礼、\n并且在『日本杯』上展现出如此英姿的当下，这\n个想法听起来更具现实感了。",
      "source_fingerprint": "528bdb3e511188dc9d44a24eac01e2d54f4ed0461c348157457cfcde37f4c6e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
