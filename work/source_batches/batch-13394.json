    },
    {
      "uid": "zhcn:c5f4c26ddfcdb67e828880ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请将更进一步的试炼，\n授给我也无妨……！！",
      "source_fingerprint": "9cd7da97fef7fe90396a7248dbc47f8a35467e308346af76f5290cc821310bfa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136315.json",
      "json_path": [
