    {
      "uid": "zhcn:d879343650be9d576e97b401",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……――！！",
      "source_fingerprint": "508355c5faa8b60fb7a4ebe91c6ed7470b9c49db58ee8f56bb4861aaa0f58419",
