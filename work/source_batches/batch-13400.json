    {
      "uid": "zhcn:c2e08e4f5ed077d5a7342c8d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我马上，就会追上你的！",
      "source_fingerprint": "122ef3d9763bd2d412624da4bf3e377a90c5285cb1e87331064b2f517e8bf590",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
