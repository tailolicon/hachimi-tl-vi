    },
    {
      "uid": "zhcn:f5c137ad0e5dcb755fe77fad",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来如此，真是贴心的关怀",
      "source_fingerprint": "464a303c67d6a36f50a5356eac40d8dcfe7d065e527c13cafd16bb2d943805a5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
