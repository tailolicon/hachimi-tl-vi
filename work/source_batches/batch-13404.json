      "uid": "zhcn:5595f6eb5ec962e0d18dfc96",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "作为负责她的人，想向你们道谢",
      "source_fingerprint": "87b1967b76c329a4adfbd09696f4b593fda0f6592275b21c0ce72a2500795124",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
