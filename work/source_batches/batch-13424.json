      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一个人往树林的方向走去了……？\n是怎么了呢。",
      "source_fingerprint": "ce7742aacbbec5c4adb0cfe166eb19b6c868155224b697e4c447d1c1d0ca39b1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
