    },
    {
      "uid": "zhcn:2019d3e651bfcae8d5fbfeac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊，不可以。\n不要靠近——",
      "source_fingerprint": "9e6f5c77288831d7d6cfa1ebc906e0f8253ac4230947983f2628eb318d76b8f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136706.json",
      "json_path": [
        "text_block_list",
