      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "等等，感觉有什么不好的兆头——",
      "source_fingerprint": "196d82b8a55f529a9e10be72fb3abea92ed16be23e68dcc8e45107214238eba6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
