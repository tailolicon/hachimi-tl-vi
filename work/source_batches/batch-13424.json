    },
    {
      "uid": "zhcn:346fb65463e520833226ce37",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曼城茶座",
      "source_fingerprint": "d954d0142b37975f0fc4d92f09ba75f9d3a0fd440959bda37bcf818148a467be",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136706.json",
      "json_path": [
