    {
      "uid": "zhcn:ba7a927b8109cf81b0b803ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "面对红色梦想带着一丝不满的话语，\n自己只能一边苦笑一边点头——",
      "source_fingerprint": "626d18b8ffbfbffa3770fc66f96dd42c2f74026e095d1fa00bfc0851c2926cac",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136706.json",
      "json_path": [
