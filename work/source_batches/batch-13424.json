      "json_pointer": "/text_block_list/8/text"
    },
    {
      "uid": "zhcn:37fe237be8088899453460e7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不知为何突然间身体变得非常沉重……！\n简直就像是有谁整个人压在了身上一样……。",
      "source_fingerprint": "0c07d236070c3053ae0eb4dcf54870585706b53d1cbb58b5856087fd4ef516de",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1136/storytimeline_501136706.json",
      "json_path": [
        "text_block_list",
        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:3b036070ec0259e7f86a4898",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "纵使此身朽灭",
