      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:b09a3c24f75e306d5b26f3c5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "唔……！？",
      "source_fingerprint": "f3813fcee74dbff1cdef685323f63d377b67cb58212b2621ca2758c52275bf97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
