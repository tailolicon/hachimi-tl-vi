    {
      "uid": "zhcn:a274ab52e04c9963a5c22e0a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的。宝冢是大奖赛。\n一般是授予有人气的赛马娘参赛权！",
      "source_fingerprint": "65f3da5cbcee980ffae8f955187bed1c7681d3d280a0059d7e0a142b86d01e13",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137102.json",
      "json_path": [
