    {
      "uid": "zhcn:f03e1579352b37c8877d3810",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "连黄金巨匠前辈也来了！？",
      "source_fingerprint": "694773cc08e80c7206f398034742ea61c4e719601a290db0f5bd3c73e008860a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
