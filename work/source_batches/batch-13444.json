      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:d5fcbdc48c1b2841bfc3ac59",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之前她一直拒绝参加的……\n看来在见识到阵容后就来了兴趣的样子。",
      "source_fingerprint": "00d4be7880c6109266780368e9356d3fda1d56b6762f9107cfbb9c96a2c8d93c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
