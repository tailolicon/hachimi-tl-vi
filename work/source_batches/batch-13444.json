      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "跑在巨匠她们的后头",
      "source_fingerprint": "c5ebeccd6bc754609145383ed6da2480655d941b7f1bbac88a5b2a5e8a97f237",
