    {
      "uid": "zhcn:276b7eb0368d91af038c5b7d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赢得三冠，为人们带来希望的\n独一无二的“金色暴君”黄金巨匠。",
      "source_fingerprint": "3942e5d9f2c276b8d042cf55db54ae021c81933ca9801749e344153fd570a562",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137104.json",
      "json_path": [
