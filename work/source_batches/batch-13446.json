    },
    {
      "uid": "zhcn:9ac9298d330bae2c93d3cc4f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便有朝一日，神业与杏目交锋的时刻\n真的到来……也定是她会赢。",
      "source_fingerprint": "f99cb28a58f9464b7cf2a66ed6e0cc933bf0f2a8f5bc1bcbbdcbdbdc1e78e954",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
