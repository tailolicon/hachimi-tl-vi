    {
      "uid": "zhcn:6f09304a78e67bbd7cf70036",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……――――呜。训练员！",
      "source_fingerprint": "dc794611e2a494ca21398cff7c9377229ddd7230c60155ad268e60c5541154d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137105.json",
      "json_path": [
