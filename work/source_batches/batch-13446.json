    {
      "uid": "zhcn:a724ded59a0bb9654d05b641",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这个也、那个也、哪个都……、\n全是以小目的『日本橡树大赛』为主啊……。",
      "source_fingerprint": "40bfb1a3a5cf09772267f544c306e0f97bc7a33474b48db25fbbad6205de7fd0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
