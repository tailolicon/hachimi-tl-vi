      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:8f91e00a67d20495a9add484",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……『早已是三后冠赛马娘级别，\n不、是经典三冠赛马娘级别』、\n『我们此刻、在见证历史』。",
      "source_fingerprint": "40fdf872a14b25ee68d5cb417f4c635a24d62c2603201206e98ab8f747e84c50",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137105.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
      "json_pointer": "/text_block_list/32/text"
    },
    {
      "uid": "zhcn:e1a14623a5071605ace4cc1a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137105.json",
      "json_path": [
