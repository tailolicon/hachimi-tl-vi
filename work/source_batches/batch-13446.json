    },
    {
      "uid": "zhcn:dd6795b196a7f2580100f8ca",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天是情人节！\n话虽如此，我没什么特别的安排！",
      "source_fingerprint": "a5606c7810aaf1ee425956930d20231d961a66aec09d65c266cf894d6ad15a3a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
