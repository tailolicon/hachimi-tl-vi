    },
    {
      "uid": "zhcn:8bd2fe2a40ad06a68202ba1b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『她正是世界第一的大器』\n『巨星诞生！　她正是最强』――",
      "source_fingerprint": "3bfc1467adda7ee42fbab709843240f2c817b7fbf971ef3c7b8c0e5130a00443",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137105.json",
      "json_path": [
