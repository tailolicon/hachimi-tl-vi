      "source_path": "assets/story/data/50/1137/storytimeline_501137111.json",
      "json_path": [
        "text_block_list",
        33,
        "text"
      ],
      "json_pointer": "/text_block_list/33/text"
    },
    {
      "uid": "zhcn:74b916507fcf4e5bba376a84",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "“无法预测的赛场”\n与比赛的本质紧密相连。",
      "source_fingerprint": "06c044024de8b140c6778847973033a6ecc75196da51e5a317af7a83f166ac90",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137111.json",
      "json_path": [
