      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那是因为她的有趣之处――",
      "source_fingerprint": "6747d1038745ecfd49773b8af4cbb8b275906d43ae31eed8e110253b6e40c213",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
