    {
      "uid": "zhcn:288a8b234cb2e1cab20196a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业每一次的比赛，\n都会为自己带来新的粉丝。",
      "source_fingerprint": "857b861bd0060430347fa99726a2806b20ad63e82b633bc57e700cb8211657f4",
