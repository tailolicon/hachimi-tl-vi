    },
    {
      "uid": "zhcn:d8140859aedac95788fa0d3d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "一位带着母亲过来的年幼马娘\n朝神业挥了挥小手。",
      "source_fingerprint": "618825dc1f72f6cd39f07174c2378f4785e4300e17f4ef8432b462880a479351",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137111.json",
      "json_path": [
