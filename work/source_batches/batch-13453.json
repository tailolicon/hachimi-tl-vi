        "text"
      ],
      "json_pointer": "/text_block_list/34/text"
    },
    {
      "uid": "zhcn:91e846334b0cccd7cba2b8d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以令人期待后续",
      "source_fingerprint": "dfb382c0208dd90dbd82e9385e34cf9f9e5ce19b35adb71dc59f3d293a228166",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137111.json",
