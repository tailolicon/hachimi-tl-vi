        0
      ],
      "json_pointer": "/text_block_list/63/choice_data_list/0"
    },
    {
      "uid": "zhcn:0401026567521ececcbe8dbf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……神业是一名拥有创作思考与信念的赛马娘。\n对她而言『因为无法创作而休息』或许是一种禁忌。",
      "source_fingerprint": "b54deda63ad11197ce1021c28cbb7987c20a4adff9794c98a635bbd94d0b91a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137114.json",
      "json_path": [
        "text_block_list",
        63,
        "text"
      ],
      "json_pointer": "/text_block_list/63/text"
    },
    {
      "uid": "zhcn:ca8b2ad302998935cbe002b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是也要注意别勉强自己",
      "source_fingerprint": "f3dbfbe08daf1b4dfaafb5b58d132cd07fde32870c01fc993c519f65f6df0ca0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137114.json",
      "json_path": [
        "text_block_list",
