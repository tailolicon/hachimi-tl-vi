    {
      "uid": "zhcn:b811eea4a33625020fe349bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……可以别这样吗？\n要是现在放下笔、我…………。",
      "source_fingerprint": "4b4b395cc6ba2ed3753f2e99ff684af1a1ddc9ab1825fb8b73d9463200642876",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137114.json",
      "json_path": [
        "text_block_list",
        62,
        "text"
      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:17643759887d99b4c48ea33f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "抱歉，那就不提休养了。",
      "source_fingerprint": "54e420f5cc154933a9d5c11ff6835dc0055b87c325bd3998a998a861388c0a0a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137114.json",
      "json_path": [
        "text_block_list",
