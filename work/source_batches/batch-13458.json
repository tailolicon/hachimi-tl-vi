        0
      ],
      "json_pointer": "/text_block_list/64/choice_data_list/0"
    },
    {
      "uid": "zhcn:1f58d96fd940337f2171b0d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是也要注意别勉强自己",
      "source_fingerprint": "f3dbfbe08daf1b4dfaafb5b58d132cd07fde32870c01fc993c519f65f6df0ca0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
