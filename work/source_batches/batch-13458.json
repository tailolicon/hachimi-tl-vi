      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是……。",
      "source_fingerprint": "962ce3d66026d28afb425df28dae6a30630b539fd00b86deda991f7d3c5d5b1c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
