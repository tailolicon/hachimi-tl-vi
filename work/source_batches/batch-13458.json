    },
    {
      "uid": "zhcn:91728d93f4f7b7176472abb4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "咦、不、休息――",
      "source_fingerprint": "1186b60d906817ca2b8b63b3b85b34830e9dd26a8a9c3a9e43ba98b92e0b76f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137114.json",
