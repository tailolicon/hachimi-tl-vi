        "text"
      ],
      "json_pointer": "/text_block_list/66/text"
    },
    {
      "uid": "zhcn:fa92b66e91d9ffd6687cdada",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……抱歉。明天开始再一起努力吧",
      "source_fingerprint": "5e2345d016d2f1e3db270f7fa3df1d9dea769421d030be18b58232286802dcaa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
