    },
    {
      "uid": "zhcn:100f9953dd4255e07329b620",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……已经没有“下一话”了。",
      "source_fingerprint": "4c7bc804150ee24cb1aa572958bd58dbfd441fac1f6165b5c06150fa9b66e644",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137119.json",
      "json_path": [
