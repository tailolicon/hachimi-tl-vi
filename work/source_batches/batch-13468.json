    {
      "uid": "zhcn:d9943e22c53536f3d1128cd5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那一定是我人生中的高光时刻。 \n就算变成老奶奶也能回想起来的最佳回忆。",
      "source_fingerprint": "8143bdce58909ae79656dfe3e2fca0f9bf0bd242b251053e9c40e6bee904987a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
