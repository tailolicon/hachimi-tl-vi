    },
    {
      "uid": "zhcn:31df7f0af4394564ca1243bc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对于作品而言，\n现在引退是我最好的选择。",
      "source_fingerprint": "9cc4cc7a0654187221921023bd5c6b5c1a0e5466a5e2fc413708d4e6aced1e4e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137119.json",
      "json_path": [
        "text_block_list",
        50,
        "text"
      ],
      "json_pointer": "/text_block_list/50/text"
    },
    {
      "uid": "zhcn:c985a20810731e45e0b4ed85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "寂静支配了空间。\n一股寂寥穿透了我。",
      "source_fingerprint": "eef25f51455d10532d8c33b4e8d25b9e5d22473c18560d8975e4ef8a4994fde8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137119.json",
      "json_path": [
