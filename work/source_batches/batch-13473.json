    {
      "uid": "zhcn:6b191e3444a3c04721202e0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（她的才能货真价实）",
      "source_fingerprint": "57723984748171c5de4bd115caed4f0a731e6cc7569c3839d5e0746245295d80",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
