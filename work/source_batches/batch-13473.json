    },
    {
      "uid": "zhcn:bbf9083a41dce012411338e2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『想创造出有趣的比赛』\n并且她能将自由的构想运用于比赛中。",
      "source_fingerprint": "e49168e44c64d211369a8e1db2fa949e290acf6f7400abb81c42e6c4fcf88d6a",
