    {
      "uid": "zhcn:b729b6463a583a7e606e33a9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（哗ーーー！！）",
      "source_fingerprint": "48480fd6233b579d7083c6547c978f44c3cc558f02f2ba9d5d39eb62c715a5e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
