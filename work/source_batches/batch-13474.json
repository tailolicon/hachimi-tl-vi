    },
    {
      "uid": "zhcn:1236f243c79e1e44e0fa5e44",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实况",
      "source_fingerprint": "50349a592c466fb97eeafeb81fd3fa65c8c3b2e779463937300c4c8f97230140",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137201.json",
      "json_path": [
        "text_block_list",
        14,
        "name"
      ],
      "json_pointer": "/text_block_list/14/name"
    },
    {
      "uid": "zhcn:1b78a8d7dee46e261e2d0ae4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘们在泥泞的赛道上前进！\n这……这样的节奏很慢啊！",
      "source_fingerprint": "12a980600b42cea1e02377c522d58ea46300b49f8dadb523fbdd938d455ba9af",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137201.json",
      "json_path": [
