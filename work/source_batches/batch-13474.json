      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――『菊花赏』当天。",
      "source_fingerprint": "196634ced8db33e9f8536f96be74b1188b50149ab899eb16f4f5c9252110dac4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
