      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没错！　因为我已经决定好了！\n要用这双必杀的腿，让大家都大吃一惊。",
      "source_fingerprint": "452436aba4534b2f7ed29776de46f547eb6d1d33fe4374093b4d718e4f89131b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
