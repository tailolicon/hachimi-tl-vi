      ],
      "json_pointer": "/text_block_list/18/text"
    },
    {
      "uid": "zhcn:7cf3d8f0a79689518e9a4a21",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "就是说你不准备“改变”？",
      "source_fingerprint": "62e81886ab65c021b3c86cffe9930739c5d4eb32b11f88a3872b98cd5da758f7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
