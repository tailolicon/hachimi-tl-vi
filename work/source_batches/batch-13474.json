    {
      "uid": "zhcn:2206768152ca9305d9aad2ac",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "而且即便状况对“差行”不利，\n我的差行也与其他赛马娘的不一样。",
      "source_fingerprint": "7795da4ce41366b056182443575b0f58307308c52d8606e477f3f3ead52ce1b8",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
