      ],
      "json_pointer": "/text_block_list/6/text"
    },
    {
      "uid": "zhcn:5d8dcba5bafa99b7270fcd62",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既要活用她拥有的这份趣味性，\n又要将其打磨成合理的、精彩的跑法。",
      "source_fingerprint": "1eb38139b4e4095b7ad0cf8dbd103f2dc089466888f1a4b73e6fea4787d809c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
