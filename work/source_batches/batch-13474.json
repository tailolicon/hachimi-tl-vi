      ],
      "json_pointer": "/text_block_list/18/name"
    },
    {
      "uid": "zhcn:52b75c2d671bf6c94a508479",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……照目前利好前排的情况，\n通常会改变策略跑领放或者先行吧。",
      "source_fingerprint": "1b29ec88966c71a11d09b8549c7efeca777c497871054bbdc9d8e6da05885ead",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137201.json",
      "json_path": [
