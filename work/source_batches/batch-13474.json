      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的“紧抓地面的跑法”，\n是能在任何场地上奔跑的、无敌的跑法！",
      "source_fingerprint": "70d469bdf8156cbb32671c461496a5a87d7a7880b43b051dd032fbd26bb2b1d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
