      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:a16621f86e3109e9ab964417",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "解说",
      "source_fingerprint": "9ca0a41d5cdb419c4fd19aae6febfbb7f658ff014636b5d29d31bc0d0771b290",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137201.json",
      "json_path": [
        "text_block_list",
        15,
        "name"
      ],
      "json_pointer": "/text_block_list/15/name"
    },
    {
      "uid": "zhcn:bbaac1ddb0e2df02a58feb2f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对差行、后追的赛马娘来说赛场状况很糟糕。\n哎呀而且今天――\n竟然反向破了赛场记录……！",
      "source_fingerprint": "d7d0ff8ecacddde53be7584491dc52f4d7f8d99beaeef13e0579a72e7d4dd92d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137201.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:86bdd6938d80abdccc8a1523",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "赛马娘A",
      "source_fingerprint": "f9e9430bf7526a9a3befdb1bbc497b3d1dd69a6e8a0dd7bb7bf98684f4aee0bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137201.json",
      "json_path": [
