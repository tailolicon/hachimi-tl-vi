      "json_pointer": "/text_block_list/22/text"
    },
    {
      "uid": "zhcn:680d158d860bbbfc3085be2e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（不过相应的很消耗体力――）",
      "source_fingerprint": "a7e4560199280fcd939090183800543ff1a03f31440daac9ab13bef2ee10b864",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
