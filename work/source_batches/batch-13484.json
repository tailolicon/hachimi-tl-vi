      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……就是这样、同时实现抓地有力和\n最大步幅的跑法！！",
      "source_fingerprint": "4f898a000203a9a790bfeae876aa8a601de72d3eeb5ef46551480e42a61b6119",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
