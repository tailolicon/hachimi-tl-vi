    },
    {
      "uid": "zhcn:bf6e62a71554f0e9bfed3ebe",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当然、这是极度消耗体力和精力的跑法……",
      "source_fingerprint": "9f1adcd9a0e10247e630bfd2a4da1e240ccb2083305eab41f18057a869ca9191",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
