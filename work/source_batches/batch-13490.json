      "json_pointer": "/text_block_list/23/text"
    },
    {
      "uid": "zhcn:3410160075629bc2321cab2c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——我相信身为创作者的她并等待着。\n我们之间的关系不仅仅是指导者与学生。",
      "source_fingerprint": "2935fb920ac6e34560e635e9a49a1aded10b51983e3593cb2b162467189bbe17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137304.json",
      "json_path": [
