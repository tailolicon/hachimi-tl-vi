    {
      "uid": "zhcn:d93484025be16737c13d3866",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业是创作者。\n思考力是她的宝贵财富。",
      "source_fingerprint": "d0847b485f2f4f46f8928ea67b2c20cba954252aab86c101024d8cb8d82fef21",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
