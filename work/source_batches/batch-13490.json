      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是——我不能成为\n轻易剥夺她思考过程的人。",
      "source_fingerprint": "029af2113c165fb567738caba9e639d3a9008c5f48f414fc87a31b37d248c364",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
