    },
    {
      "uid": "zhcn:2220834c137e09df6109bbed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "和北部玄驹一起训练的特训持续了一段日子。",
      "source_fingerprint": "bc95f11759cf687e20cf05894fdef7d6c1e18ba06bc68b49e774db9aba27226c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
