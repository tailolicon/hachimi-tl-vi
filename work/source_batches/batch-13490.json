    },
    {
      "uid": "zhcn:8526afc39f2bba82e06cc7c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（但她自己并不接受这个解释）",
      "source_fingerprint": "fa2ec548ad72860f18a3f7e89b9d064b31cff5683120345d6cb53b3438ab0882",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
