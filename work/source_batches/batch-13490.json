    {
      "uid": "zhcn:0a510b9b39518099f84057f9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我的作品、从现在才正式开始啊ーーー！",
      "source_fingerprint": "a0e620e08699bc5908f4f38a537b5a4275805319573b8a2d74f62de6f469b0f3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
