    {
      "uid": "zhcn:56572bb895bef33538c9f2b8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那、那就是因为她是和我不一样的赛马娘！\n思考方式本身就不同……吧？",
      "source_fingerprint": "0635297bb0e10e7bd5565821c2b97cf0c55851de310396a11ca05e5edd8612b2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
