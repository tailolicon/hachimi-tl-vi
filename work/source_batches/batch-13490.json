      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "反过来想想，为什么小北不会有这样的烦恼呢",
      "source_fingerprint": "1bfc86963ffb956ec410750c4f25f83c56c4392c89e8acebce8f86c40fb23735",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137304.json",
