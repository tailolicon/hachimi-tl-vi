    {
      "uid": "zhcn:eee797f524cb1b802c0ad278",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那、那是当然啦！\n我也要成为主人公的！！",
      "source_fingerprint": "9e1380d7f52d2ef59a4cb0cbdf8ce8e9bf52ac63f6d7e9c9fe7ba2688d1b2c47",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
