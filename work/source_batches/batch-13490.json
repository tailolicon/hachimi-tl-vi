    },
    {
      "uid": "zhcn:e944209e0f5ecaa6bdd5c432",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她在思考。为了寻找一个超出我们想象范畴的、\n独属于她自己的答案。",
      "source_fingerprint": "e6989bcfe8830f6ba5804293d4a7c80cda6df044514218178b4ae2b7bc61b4c4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137304.json",
      "json_path": [
