      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……啊哈哈！　啊哈哈哈哈！\n我也要、变成那样试试啊ーーーー！！",
      "source_fingerprint": "ee1d4d6f3a6fd2b5e4b60881de7412f8909036871ac9bd1df1a075bc305e3da7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
