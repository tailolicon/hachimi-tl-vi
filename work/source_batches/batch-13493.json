    {
      "uid": "zhcn:b457712b9a93233cca21275a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我们来定下一个、\n――让人仰得脖子发酸那么高远的目标罢！",
      "source_fingerprint": "e7b6b83fc81d2c76d3cc8aaa3fc07a4a879cd319c461a55fd4bdfdc06e1b9b6e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
