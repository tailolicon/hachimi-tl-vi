    {
      "uid": "zhcn:0742d5c18324efe7d1914c45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……小北、我不会输的。",
      "source_fingerprint": "0ea14b8ce47e79d26a68bb62043c0d8ab8bbd4947086c8ac03e94c4eecc68c17",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
