    },
    {
      "uid": "zhcn:eed53d4aea6dd06fd69b5bec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……说起来我最初提出的\n『在重赏赛获胜』的目标，\n感觉冲击力有些不足呢。",
      "source_fingerprint": "8186d91cd824b4f2bf5f6db47e93ba29b6db968f2588f0780d83cc8bba14272d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
