      "uid": "zhcn:0ccb66de468bc33f2bd48cb5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我想让你能激动不已地去挑战！",
      "source_fingerprint": "4287dabad0e8cdbbfb133beeb7f672228a467b5ceea968a29d3947d0b8617f66",
