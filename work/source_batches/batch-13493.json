    },
    {
      "uid": "zhcn:511195f39d161c8303c744e9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
