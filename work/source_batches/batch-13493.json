    {
      "uid": "zhcn:abb59fae7997e133408f7db6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "收集着所需的情报……\n必要时也会直接向本人询问。",
      "source_fingerprint": "72e76745884e1f440da849045db490ce8f7fbbea12865923fbbe36605872c7b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
