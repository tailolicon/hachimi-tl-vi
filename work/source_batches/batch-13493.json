    },
    {
      "uid": "zhcn:ffede713bb982b1336ebba16",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是从今往后！\n我要看得更远更远！\n",
      "source_fingerprint": "7af81e8b0c7401caab275e00c46d7d421fc96eca57785a72a53a1cfc2ecead2e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
      "json_path": [
