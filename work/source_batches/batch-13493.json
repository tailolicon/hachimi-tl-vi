      "json_pointer": "/text_block_list/14/name"
    },
    {
      "uid": "zhcn:38b889c0f399c4f56aedc734",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比方说2000胜……即便做不到。\n也要成为拿下数十场胜利的赛马娘之类的！\n或者海外远征、去往各种国家之类的！",
      "source_fingerprint": "fbe991f2fdea9ba39829527f8fe2617fbc1a5ab2c71cf424e7af31bc864f8977",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
      "json_path": [
        "text_block_list",
        14,
        "text"
      ],
      "json_pointer": "/text_block_list/14/text"
    },
    {
      "uid": "zhcn:cc012f1ec40c65f1e7b07702",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那就先当个世代最强！",
      "source_fingerprint": "b13de7ed8fe10a0655a7fcb84ad24650b50d60e4ef74e53b232f60089f18d018",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
      "json_path": [
        "text_block_list",
        15,
        "choice_data_list",
        0
      ],
      "json_pointer": "/text_block_list/15/choice_data_list/0"
    },
    {
      "uid": "zhcn:8ec79e3df052574ca64db8a6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "神业",
      "source_fingerprint": "724792a2e3d296c7611773ef019203633319ea51a39af196ebd8de8dbc3c2a42",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
