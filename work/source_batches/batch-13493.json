      "source_language": "zh-CN",
      "source_text": "我要创造出超越历代三冠赛马娘的奔跑！",
      "source_fingerprint": "0b66b7f74d067592277556d4c9da5d926395a0082b81a3df2d7ff4b9cffa71d1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
