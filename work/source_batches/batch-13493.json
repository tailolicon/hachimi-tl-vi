    },
    {
      "uid": "zhcn:613e20295307a9f02dedc998",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那么、首先就该让身边的你！\n觉得我的挑战最有趣才行呀！",
      "source_fingerprint": "b8d29b0bd7100cfff79e4dcbf5a209469243e52822509ab83e74af10e305afe2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1137/storytimeline_501137305.json",
      "json_path": [
