    },
    {
      "uid": "zhcn:63f4fa015111e91923775937",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我、还想再见到大家。",
      "source_fingerprint": "66e8479e29decd7d2fa36bfdc7b03def1f71f24dcb56b2049d59902768adaa8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143100.json",
      "json_path": [
