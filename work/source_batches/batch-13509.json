    {
      "uid": "zhcn:ddd65449f625a6ddc3b80dc2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，一起努力吧",
      "source_fingerprint": "b4a63b8abf43958ff3062eed11baf27fb7812be63e50dbbe6bb3c6f71525d7fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
