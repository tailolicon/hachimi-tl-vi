    {
      "uid": "zhcn:18ce345c0d51307f4331876e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "它甚至可以为孤独颤抖的人，\n披上温暖的光芒。",
      "source_fingerprint": "d40e43d74a78a6d7e4901f028236dddda8e447d39f98e8240e05c552a2b6d699",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143100.json",
      "json_path": [
