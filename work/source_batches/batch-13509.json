    {
      "uid": "zhcn:7c3884b5b5f48ae50ce92b54",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以……\n我一心一意地坚信。",
      "source_fingerprint": "14914bf61849b6f8b995d63e8a8982eacd8a898d270e6b1744888760fe8510a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143100.json",
      "json_path": [
        "text_block_list",
        81,
        "text"
      ],
      "json_pointer": "/text_block_list/81/text"
    },
    {
      "uid": "zhcn:877385412c343be274318966",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯，一起努力吧",
      "source_fingerprint": "b4a63b8abf43958ff3062eed11baf27fb7812be63e50dbbe6bb3c6f71525d7fa",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143100.json",
