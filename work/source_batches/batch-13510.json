      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（同期之轮、吗……）",
      "source_fingerprint": "b283c4ed7ab120b5159723618475aa338ff85ce8800ee0014a6589b17a2acb98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
