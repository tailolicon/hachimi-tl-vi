        "text"
      ],
      "json_pointer": "/text_block_list/47/text"
    },
    {
      "uid": "zhcn:69bbc4d228f4dac3371621d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "刚才的通话结束后，我们便趁着新年\n在热闹非凡的街道上散步。",
      "source_fingerprint": "b1cb2d3ecefddcb83347bf2bfe41b27ba728bab0f73ae1493735dd20f4d12c39",
