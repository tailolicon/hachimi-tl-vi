      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，“远见”什么的，\n我并没有想得那么深啦。",
      "source_fingerprint": "b408fced86941cb227d3c5ef183adcfa2a215ebd2e63c9f5e58c5ade46b52843",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
