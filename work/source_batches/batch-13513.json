      "json_pointer": "/text_block_list/84/text"
    },
    {
      "uid": "zhcn:4486e77fb94e6ac86c1dd1d4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "惊涛骇浪般的冬天结束后――\n今年的正月，依旧是如此的祥和宁静。",
      "source_fingerprint": "ccbae2437869cf1b89345c95531ed9a1e134bd87e45fb117f8014b37d7a2bee5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143102.json",
      "json_path": [
