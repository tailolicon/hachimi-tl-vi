    },
    {
      "uid": "zhcn:77985ff4eb1f55819634e8bf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呀啊，比萨同学。\n我听说了你的活跃哦。stupendo（了不起）！\n",
      "source_fingerprint": "f44c6c0d3034c0d90399ec99141fca7e47f7589173c95bfbc79483edc71382dc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143103.json",
      "json_path": [
