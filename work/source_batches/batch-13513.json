      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "万籁争鸣",
      "source_fingerprint": "36257dab47699fee781e7bccec58607ec4ca0c4959e55358203c057436d8779e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
