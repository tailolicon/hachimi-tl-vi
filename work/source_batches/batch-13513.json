        "text"
      ],
      "json_pointer": "/text_block_list/86/text"
    },
    {
      "uid": "zhcn:8b58b993122967780fc42ab5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――比赛进入中盘。\n旧友身处中间位置，虎视眈眈地瞄着前面。",
      "source_fingerprint": "7d33e51ed356c1bc97fd37a1b940e33d0b369e3895df65cbb06c9b452e39fdf6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
