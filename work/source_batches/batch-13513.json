        85,
        "text"
      ],
      "json_pointer": "/text_block_list/85/text"
    },
    {
      "uid": "zhcn:29c83d638f763c8e15378f45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "为了进一步联结圆环，孕育希望。\n今年一年，我也想和她一起奔跑下去。",
      "source_fingerprint": "fdcf953fbb9781d58dc3687376fde38e8b45597844370b58bb5bc4494b1c2c1d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143102.json",
      "json_path": [
