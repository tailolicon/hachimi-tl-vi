      ],
      "json_pointer": "/text_block_list/0/text"
    },
    {
      "uid": "zhcn:e03b9cbd8ae3c1e113529e30",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在夏季集训的第一天――\n热爱音乐的爽朗赛马娘\n万籁争鸣过来搭话了。",
      "source_fingerprint": "39b4e4e5019dbbb55097c2b25f7826ebf880bc1227998ea7dff5edda17220545",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
