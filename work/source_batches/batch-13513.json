    {
      "uid": "zhcn:b1532201989762da47e832d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨的母亲",
      "source_fingerprint": "485e1262f64ec9d51291fab6ab5402f3c08d9a2b4c653b79b8a5d4afc583b989",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
