    {
      "uid": "zhcn:c1a9ed027a471ce8a3a2c82d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵。我们会一直支持你的。\n加油哦！　训练员先生也是。",
      "source_fingerprint": "bc9bf64439d80eb42e46b8fdd473db186744934fdf6a6b26e08b1d515e861f98",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
