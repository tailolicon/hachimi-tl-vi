    {
      "uid": "zhcn:1585cce6f50f3068791c3d94",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多亏了大家的应援。\n决赛我也全力以赴的！",
      "source_fingerprint": "92ee4baddc3724c74b31bbe563bfacf897795dee6c3c64cee78ca8b6b1a7170f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
