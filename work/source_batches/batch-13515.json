    },
    {
      "uid": "zhcn:4b3d1dd27fe72bfd992dc12b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『呜嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷嗷ーー！！』\n『迷人景致、加油啊ーーー！！』",
      "source_fingerprint": "108aaeeba88e36e16039d5ad7576af5dfe6fa667bbd03bfacc14a4835499b3e5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143104.json",
      "json_path": [
