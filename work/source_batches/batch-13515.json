      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "观众们",
      "source_fingerprint": "fb9eb6518e94670473e15bc84b7c6dc3f58687c51fb543b0e89b34018813d2d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143104.json",
