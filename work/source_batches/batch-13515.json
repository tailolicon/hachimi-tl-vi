    {
      "uid": "zhcn:d1c1b0eeb839605586717b5e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她那压倒性的、极高的人气。",
      "source_fingerprint": "2f9007bca610e1b7fd33f48e76afd37a457f9284e95dc8eed8d3c2291320aa22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
