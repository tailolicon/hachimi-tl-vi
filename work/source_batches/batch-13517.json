      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――不能断言、这不可能。\n但、这是一个非常、非常宏大的梦想。",
      "source_fingerprint": "850f8020ce10b348d5512b5650e99dc45da739ec819b3614e47a39d2828fbc14",
