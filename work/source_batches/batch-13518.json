    {
      "uid": "zhcn:0363e4b18a0fbbe119bbe3c8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请让我去吧……！\n为了将希望，编织到全世界――",
      "source_fingerprint": "246d06b8fbeb0fcde1731a2d03a7981693bd9862cc09bc3574221703631f78c8",
