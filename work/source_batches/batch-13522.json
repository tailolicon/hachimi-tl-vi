    },
    {
      "uid": "zhcn:7adb01fac10f64dd2d5f2652",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "您不介意的话，能陪我一起去吗？",
      "source_fingerprint": "158536a60fc1c53cf7b1af9e24c4f72cd1ef90d3d0889f49d6da8d063f36dce3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
