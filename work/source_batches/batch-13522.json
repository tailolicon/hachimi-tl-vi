        0
      ],
      "json_pointer": "/text_block_list/68/choice_data_list/0"
    },
    {
      "uid": "zhcn:6db405c37c84918571fb5d3b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也让我送你一份礼物吧",
      "source_fingerprint": "8e91f1c478a110520c5cd177d5fd4d7157653225c6c1cb2b9682f8204073ee94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
