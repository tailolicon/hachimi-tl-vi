      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今后也请，继续陪在我身边吧。\n拜托您――",
      "source_fingerprint": "cb252b42eedf71f4b75644937b77e7d53bd019043c464cb5e8a966e9125fa3c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
