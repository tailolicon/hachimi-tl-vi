    },
    {
      "uid": "zhcn:beff541986b112b4e3563b57",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大致出于与她相同的理由――\n这是融入了我心中积攒的\n对她满满的感激之情制作的。",
      "source_fingerprint": "476084ff646e12d83d80f94486356d4cd67ce51adf5ab0a996d2c08cbf6d7f39",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
