    {
      "uid": "zhcn:aa231cb1d33b6b689b928b56",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我手心上的戒指，\n有着沉稳内敛的锤目纹。",
      "source_fingerprint": "5534f6261b57818bc188ba612ccfccc644c2a7cd1bcb09729983af3b9ab390e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143109.json",
      "json_path": [
