      ],
      "json_pointer": "/text_block_list/67/text"
    },
    {
      "uid": "zhcn:d9b0ebe9c45e0bf0718d8d34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也让我送你一份礼物吧",
      "source_fingerprint": "8e91f1c478a110520c5cd177d5fd4d7157653225c6c1cb2b9682f8204073ee94",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143109.json",
