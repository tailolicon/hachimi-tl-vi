      "json_path": [
        "text_block_list",
        69,
        "text"
      ],
      "json_pointer": "/text_block_list/69/text"
    },
    {
      "uid": "zhcn:385996e767b9a403d17a4edd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨胜驹",
      "source_fingerprint": "9beb50d57d7703a64ba6e9d70094d69e3edf1f53654ce1b6055f0ddd7c2b63d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
