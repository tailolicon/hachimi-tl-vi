      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "甚至到了，\n自认识您以来，心中生出了一种恐惧的程度。",
      "source_fingerprint": "cced36ea8ce7a0b0c59f4330f83ce829f6c9b707edf395a100fce9b738b42b12",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
