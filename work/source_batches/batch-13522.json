    {
      "uid": "zhcn:08fe8cd043de3bf66ea0dace",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我将刚刚完成的尾戒递给了她。",
      "source_fingerprint": "be265bc4bf79911b903e620b1a55dfb60bfba9a8dbbe184fe14c4a47db67b7d3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143109.json",
      "json_path": [
        "text_block_list",
        68,
        "text"
      ],
      "json_pointer": "/text_block_list/68/text"
    },
    {
      "uid": "zhcn:8ddf6a4f73fa895711422c5a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你的清纯，是我的指路灯",
      "source_fingerprint": "6a6e6a7e702c704564b20faeafba744fe292ef59d03b3c1aa8a06d5ebb7229bd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143109.json",
