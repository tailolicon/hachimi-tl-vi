      "source_path": "assets/story/data/50/1143/storytimeline_501143109.json",
      "json_path": [
        "text_block_list",
        7,
        "text"
      ],
      "json_pointer": "/text_block_list/7/text"
    },
    {
      "uid": "zhcn:2098255074f7e6617a593c95",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即便无法成为你那般模样，\n我也想要变得像你一样。\n不知何时，我自然地产生了这样的想法。",
      "source_fingerprint": "462393f7fd0ee9b2e2f8040d0a21659abe2386b789d69a6e8152755078d8e366",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143109.json",
      "json_path": [
        "text_block_list",
        70,
