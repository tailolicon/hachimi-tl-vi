    },
    {
      "uid": "zhcn:018cdcb79ac63dedfe35edef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是请不要忘记。\n她不仅仅为一个国家带去希望――",
      "source_fingerprint": "3434543c06496600b45a4c9a5f9b8cac3ece7546e8f2e437e4df72462ca7c81c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143111.json",
      "json_path": [
        "text_block_list",
