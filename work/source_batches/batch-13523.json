      ],
      "json_pointer": "/text_block_list/62/text"
    },
    {
      "uid": "zhcn:863a86eccf83d467c6522036",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她还创造了联结世界人民的“心之环”。\n那道圆环――至今仍联结着比赛界。",
      "source_fingerprint": "e3da0ae8732650e1b4e00c26104d710ff18f77223cd3773b9ee38673f8459504",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
