    {
      "uid": "zhcn:e07047139c22191cdd5e4998",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『我这次去日本看她了。\n还结识了日本的比赛粉丝』",
      "source_fingerprint": "a15cc44d6e195379590aed70a5800a55c7bf7f06b978fc2a3db69db7f8eb64a6",
