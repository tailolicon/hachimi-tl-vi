    },
    {
      "uid": "zhcn:9bee462b9418ff869421078c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她使出浑身解数得来的荣光，\n为国难当头的祖国带来了希望。",
      "source_fingerprint": "6b0078305bc3b5d9273314a2c1e88d38d5987543c941a64c80fea4a1f0a10afd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143111.json",
      "json_path": [
