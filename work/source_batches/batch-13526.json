    {
      "uid": "zhcn:b14bd5e5aa8966ca1972d7df",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "能不能让我偶尔配合闪耀同学的自主训练。",
      "source_fingerprint": "3ccc8a37708788242e48f6b9c5bc2958efa5cd0df918fa8840bd208eb67ef556",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
