      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "原来如此",
      "source_fingerprint": "ff8cb3082a2b665288d79fe1158a2cb684903cee1feb8acf5983b563c7b8b935",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
