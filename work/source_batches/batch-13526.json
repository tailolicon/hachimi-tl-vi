      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "所以，即使疏松我也想和她保持联系。\n因此我有个请求。\n",
      "source_fingerprint": "34a2a822f08e4948865deba8bb800898fd48970dcb0fa302e4edee3af5f08c22",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
