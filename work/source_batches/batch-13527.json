      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你才是……特别是精神状态良好的时候\n集中力真是惊人。",
      "source_fingerprint": "c9ad96eff2a9d6803d1d8c61eeaa91345083c70f3b61fd8c3bc7dbae4dc97596",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
