        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:0ab3165ec99e22ab19d06e73",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "若以更短的间隔参赛，\n就意味着要带着累积的疲劳投入战斗。",
      "source_fingerprint": "7b2d66acc1cbb327b49a87c99b823975bf29963af87142e3efcb7e3e5cfbc499",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
