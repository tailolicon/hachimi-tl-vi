      ],
      "json_pointer": "/title"
    },
    {
      "uid": "zhcn:588198ec5cba6162b30a9282",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『成为与迷人景致比肩的存在』――\n怀揣着这个目标，\n我们从夏天开始便一直刻苦地训练。",
      "source_fingerprint": "4a4f920f4d6e291950771c98327eed058b423fcd6c46e9fbf5f7bce1b24da73a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
