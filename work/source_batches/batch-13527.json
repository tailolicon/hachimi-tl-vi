      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『想弥补经验的差距』\n……原来如此。",
      "source_fingerprint": "ce61d3a1a642229ea5cd7a65c1ef23f9e3c476cb4d50161695f34eb4b7c967d7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
