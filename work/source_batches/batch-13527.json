    {
      "uid": "zhcn:88e9affe961689121fc38567",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋意渐浓。\n梦想的舞台，早已悄然拉开序幕。",
      "source_fingerprint": "acaad56abad5520c9e031c2b2151b89e925fff658f5681dfb0a0524ec3399b9a",
