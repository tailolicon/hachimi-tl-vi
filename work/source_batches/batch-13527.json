      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:38d4b7f450bc156d9d742b0d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "以世界最高墙\n法国的GⅠ比赛『凯旋门赏』\n为目标的所有赛马娘集结的模拟赛。",
      "source_fingerprint": "3d3b9e957a34f59360920c254f95db1bfa3d36f072e5a78942b5dae3c6da8dca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143114.json",
      "json_path": [
