      "source_language": "zh-CN",
      "source_text": "所以、斗胆提议――\n能否与有海外远征经验的对手们\n尽可能……短间隔地进行多次模拟赛？",
      "source_fingerprint": "f83a1afebf993c9ff977a89baef4a4a428fe578cfc0203ede947ccb61e5b4c82",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143114.json",
