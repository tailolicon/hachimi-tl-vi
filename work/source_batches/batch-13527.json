    {
      "uid": "zhcn:01746ae85ec37b39a7b2ec36",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比方说――\n天狼星象征、神鹰。",
      "source_fingerprint": "085a10a8590e02c67ae0a007505b776a519726bb659bb4293c329211f31b632d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
