      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "曼城茶座、\n跳舞城。",
      "source_fingerprint": "c7082d4c03ad8cdede43a17fdddf1d6c0ab14d7ece4f7a064a3e933a5576dd51",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
