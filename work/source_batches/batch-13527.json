        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:d46b409a1425b12feba3ec09",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她们一定能通过比赛\n带给现在的比萨胜驹各种各种的事物吧。",
      "source_fingerprint": "99a768ab99caa4e700e85db9b7a6d97d433f426d6d2bd9c291ec00efdecc0635",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
