    {
      "uid": "zhcn:8148f1d5e6e5ed04ec3d0aa0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我轻吸一口气。",
      "source_fingerprint": "029e7fbd1b18e9124e71696d7e7273216a5c80078b2905643393df09cf06d356",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
