    {
      "uid": "zhcn:b9a8b20c8d3c2a2634897366",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "纯洁的盘算",
      "source_fingerprint": "fc6a98308fd5034195567fa340b9d39d1c4c6978f224552b2a8bf2e24519310b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
