      ],
      "json_pointer": "/text_block_list/100/text"
    },
    {
      "uid": "zhcn:4ce6b6264a9137b1c15cf84b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『若是她的话』――\n这样的希望，太过耀眼。",
      "source_fingerprint": "93f034eaeed51d9709e56c0aacdb6340ca474ce54d3d28f7556f51c9b103970b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
