    },
    {
      "uid": "zhcn:c2efba3bca6653765358630c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "实力正在稳步提升，\n身体状态也很健康。",
      "source_fingerprint": "217be03d67b0bbf23a875ca161b8c8ac815d8fdd5170bb8078dcf197d52aadfa",
