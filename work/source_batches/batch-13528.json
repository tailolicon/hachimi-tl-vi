      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "从无半句怨言，\n精神状态也极其稳定。",
      "source_fingerprint": "af1d008c672aa5dbe8bdcb99ef5bc8fbdc537df02d2461461f8bf6e1532796bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
