        "text"
      ],
      "json_pointer": "/text_block_list/113/text"
    },
    {
      "uid": "zhcn:42166f62250b6d09d7f458dd",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "只要你发誓要做到，就一定能做到",
