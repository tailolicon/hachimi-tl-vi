      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "演唱会、赏花会、庆典活动……。\n甚至学校的庆祝典礼，\n也不得不面临终止或自肃的局面。\n",
      "source_fingerprint": "95790d804c4d1110e30b5508da6b22dd671cf4517c1d4533cbefabae1cc18925",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143116.json",
      "json_path": [
        "text_block_list",
