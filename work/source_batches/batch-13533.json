    },
    {
      "uid": "zhcn:3e766d59e07a58798c3259db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "正因为是这种时候，\n我认为才更应该出战。",
      "source_fingerprint": "fd99cf1b2617a2bc5c6c39db8a119dc831586592cd3715060391df26ae75d3a9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143116.json",
      "json_path": [
