    {
      "uid": "zhcn:01081f0c44c82f6b8b7e0cda",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我认为――\n我们应该出战。",
      "source_fingerprint": "e91983a691b026d8624f5610e976c71e3af8a9c47b6fab3caa5e6808278056f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143116.json",
      "json_path": [
        "text_block_list",
        17,
        "text"
      ],
      "json_pointer": "/text_block_list/17/text"
    },
    {
      "uid": "zhcn:74125ae38f4ed0de3fcc9176",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛场静得仿佛能听到落针之声。\n但她毫不在意地继续说道。",
      "source_fingerprint": "c345b30774ae06ffe808a5823a0496e65a011560871e1b017d5751c7e93d9edf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143116.json",
      "json_path": [
