      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我知道。\n现在，一定有许多人根本无暇顾及比赛。",
      "source_fingerprint": "115f348334ea3979f85d1be0e562c28cf9c9c988c4ba93fa463a471716aa4665",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
