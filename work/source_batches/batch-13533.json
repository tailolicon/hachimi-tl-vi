      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――我听说在日本，\n已经有许多比赛被取消了。\n……不、不仅仅是比赛。",
      "source_fingerprint": "3ff8fb79205dfc5c7915f5c2541f6261c66e48d950333c5299e33a10c7e3dec2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
