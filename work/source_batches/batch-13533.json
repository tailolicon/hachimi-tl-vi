    },
    {
      "uid": "zhcn:0bc53a84116a5d2c33553aa1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨胜驹",
      "source_fingerprint": "9beb50d57d7703a64ba6e9d70094d69e3edf1f53654ce1b6055f0ddd7c2b63d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
