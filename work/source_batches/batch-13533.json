    },
    {
      "uid": "zhcn:552461c382bd5a316a3c2763",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……可是、比萨同学――",
      "source_fingerprint": "19477476e2c9966ebbc55874f9d3c3c55d386696a913c12ca665408fde6cca63",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
