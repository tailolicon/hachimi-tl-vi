    },
    {
      "uid": "zhcn:e9b67c05ad259cb03dc366a7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……一想到灾区的状况，我就心痛不已。\n坐立难安、辗转反侧――",
      "source_fingerprint": "e8c70fe2cec1e1416f435c1739cdc229278c41530b8109e5d67f6648a61646e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143116.json",
      "json_path": [
