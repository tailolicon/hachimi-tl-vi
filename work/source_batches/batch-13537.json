    {
      "uid": "zhcn:f8618527c8f24a3457df647a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不由得这样觉得。\n我――",
      "source_fingerprint": "84ce6bbade189280a0478ac97e78bbb04e883c06f54f2423fa675f8cb3fb8b48",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
