      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "但是那样也好。\n只要大家之间的圆环紧密联系、存有希望的话。",
      "source_fingerprint": "5eb4bd51bea3a72870f432f9b0a8edb841fadad88d97b922914a0db057309eed",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
