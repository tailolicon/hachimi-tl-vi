    },
    {
      "uid": "zhcn:462b757cb3923c262e00e6ab",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨……",
      "source_fingerprint": "358bc65ab4e8066552467eed7f2d325154dc27d736d4f78ca9b659043f1eab4b",
