      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:726e65a4599215a625de98a4",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――……要是我拒绝了，\n她一定会再努力一阵子吧。",
      "source_fingerprint": "b6f6c46907821684b00f01a0161c0b0e29aec813c55b999602555097d050206e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143118.json",
      "json_path": [
