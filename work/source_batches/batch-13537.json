        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:d47959c5cc4dc4208c22203c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……我早有预感。\n早就清楚无法恢复状态的原因就是这个。",
      "source_fingerprint": "5c7d49a14356c7ff3e9772949a936872069ce92aba27d1174acdb6c15e06839f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143118.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:4ae23271894fc192bc290750",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我忍行拾起几欲低落的心，\n看向她。",
      "source_fingerprint": "5ae702d209e348acffcfc6ba1c6d981f688d533c0f6192c107badf313cb3ed24",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143118.json",
      "json_path": [
        "text_block_list",
        38,
        "text"
      ],
      "json_pointer": "/text_block_list/38/text"
    },
    {
      "uid": "zhcn:c113cd4b7c2591a0c4b4726e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她的表情，\n是那般、那般的晴朗。",
      "source_fingerprint": "e78123151464ffec2f9468b8be59a7d89bf60c4696cc880bbbbc91f756b5f64f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143118.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:2778dc78139506951215a4b1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "黄金巨匠达成了三冠，\n世间为崭新三冠赛马娘的诞生沸腾不已。",
      "source_fingerprint": "d864e6ee8d92a624e197f894aa58a2440ebf4318df503b69f958c463cf4b434a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143118.json",
      "json_path": [
