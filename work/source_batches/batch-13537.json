    },
    {
      "uid": "zhcn:8d92871125cf3177faed68ef",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "欲语凝噎。",
      "source_fingerprint": "390568e70521a0141da2382f3552c2bdb2eac6a4d2bd8722818971939c492bd7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
