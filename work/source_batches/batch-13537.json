        "text"
      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:d3440063513187a6c6d33eb5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，是一定能找回。\n肯定没问题的。她的话，一定能――",
      "source_fingerprint": "db4ebd1fa9ae5cc3b23ab3cebd7e1ab7a3cb42b650764dc336f062f1f53916e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
