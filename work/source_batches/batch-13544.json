    {
      "uid": "zhcn:42dfe06417fe403a41cda696",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "荣进闪耀",
      "source_fingerprint": "dddbabf0a14340be785a6989ad9c1b0d7af7714ae783df71e025920875aeeda6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143203.json",
