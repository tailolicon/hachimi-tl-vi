    {
      "uid": "zhcn:3f1785dbf251621af7e0a19f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主持人A",
      "source_fingerprint": "af4573f5b51b65fb3718842b922284c1a3544016419ba5fd1b7d3a8ee4404923",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
