    {
      "uid": "zhcn:d718d375fd967860bb4ab641",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "让我们去追逐胜利、并献上胜利吧。",
      "source_fingerprint": "f89aa7b4fa3d0b297fdbe7c46f770f15c4afb9d049d9680612fcf9d6387e65bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143203.json",
      "json_path": [
