    },
    {
      "uid": "zhcn:f8e142b7b194db6762cfc8ed",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我、献给父母。统治同学献给自己。\n玫瑰同学献给薔薇一族。比萨同学――",
      "source_fingerprint": "3a90d387c3ae4b1f82c822ca852408ac86b2cc1a8b80d606d20285b9ed407f9f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143203.json",
      "json_path": [
