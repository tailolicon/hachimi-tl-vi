    },
    {
      "uid": "zhcn:91655e09a35208185515086c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨胜驹",
      "source_fingerprint": "9beb50d57d7703a64ba6e9d70094d69e3edf1f53654ce1b6055f0ddd7c2b63d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143203.json",
      "json_path": [
        "text_block_list",
        32,
        "name"
      ],
      "json_pointer": "/text_block_list/32/name"
    },
    {
      "uid": "zhcn:1ace8cdf7d5cff91cf2e01f0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "献给所有关注这场『日本德比』的大家。",
      "source_fingerprint": "36d4aa8850163eb309cf59953a3414f83c1c78a3fcf85f962666a1d80aa040f2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143203.json",
      "json_path": [
        "text_block_list",
        32,
        "text"
      ],
