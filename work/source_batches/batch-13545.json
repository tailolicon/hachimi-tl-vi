    },
    {
      "uid": "zhcn:dc4bc18599947d61e81326e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "与她相比毫不逊色，\n散发着强大存在感的是玫瑰帝国！\n她把薔薇一族之名刻进了GⅠ赛事！",
      "source_fingerprint": "1d588b9f4f2e259e5869db1564dcc9de34860ea566a3dcbe5b09231725a57ba1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
