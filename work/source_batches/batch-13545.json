    {
      "uid": "zhcn:e0c3124b288d254844cf1192",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "此外还有以荣进闪耀为首的选手，\n今年的『日本德比』可谓良才云集！\n",
      "source_fingerprint": "a2cee313cbd6d3c66753ffb8d79cda95ae7d4d07a10bc578e1b57ea0d59404fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143203.json",
      "json_path": [
        "text_block_list",
        8,
