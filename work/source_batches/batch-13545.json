    },
    {
      "uid": "zhcn:0ac07739aca4b2f92032e4f3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "主持人A",
      "source_fingerprint": "af4573f5b51b65fb3718842b922284c1a3544016419ba5fd1b7d3a8ee4404923",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
