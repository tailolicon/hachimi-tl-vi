    {
      "uid": "zhcn:64f64a2db117221ceacfe5bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "现在，世界各地都，\n点亮了提灯。\n",
      "source_fingerprint": "ba0398fe7a72c2abff4c19a2ec1e23c7b6d8da1e69b55465a73ef601dc2cf1f7",
