    },
    {
      "uid": "zhcn:23ad226449fd58b63f95ae64",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "明天就是她的最后一场比赛――\n我怀着一事无成的无力感，\n备受煎熬、陷入了浅眠。",
      "source_fingerprint": "c4c63e5b7bf13647d0116fd42c404b686d8baa5ea93cd8376695f2f25ad8b558",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
