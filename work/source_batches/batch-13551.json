    {
      "uid": "zhcn:9bd6ee21b4f81603edef0ac7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我尚不知晓详情，\n于是打开了她告诉我的正在直播的\n马管的视频。",
      "source_fingerprint": "2a2c8024fa7403b7dad033b4cd6ddaae3c21f356440e74e902fec74f53ca994f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
