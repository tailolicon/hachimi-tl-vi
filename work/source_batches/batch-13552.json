    },
    {
      "uid": "zhcn:42653bbedefb41635ad96ff6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "即使从前的火焰已然熄灭，\n现在的她也定能全力奔跑到最后。",
      "source_fingerprint": "8e496fa39bd9cccea570c9cb37839ee4cf587ddbe5e9b9b6b4cf37da9f7e4702",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143208.json",
      "json_path": [
