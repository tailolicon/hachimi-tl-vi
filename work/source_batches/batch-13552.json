        9,
        "text"
      ],
      "json_pointer": "/text_block_list/9/text"
    },
    {
      "uid": "zhcn:89afe33be57e4ce13b3fb678",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为现在的你，充满了希望啊",
      "source_fingerprint": "1968266b8547971aea3fd93ba98316bf8267bcdeb8d6c4f9c4f391343fc00a97",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
