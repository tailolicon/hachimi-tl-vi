    {
      "uid": "zhcn:5109681bcd19062bca082a26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我伸出手。\n她带着一丝犹豫，将手叠了上来。",
      "source_fingerprint": "982fcf512ff77b61a26fe8f6f78b93dfd8a0c7b0277d2970bb5cc11d7413a14e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
