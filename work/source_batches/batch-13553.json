    },
    {
      "uid": "zhcn:4f848187c8ae459f9e6d0606",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "某天，在我和她一起去商店街\n购物完回去的路上。",
      "source_fingerprint": "7df8f624bc408da5b6404cd68f9a51aa6a5dd11f7dc0b51052e62dd8b35a7f75",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
