      "uid": "zhcn:7a4ba2af77afc90f5dcafaa5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "夏季集训（第3年）结束",
      "source_fingerprint": "6e8c1fa11dc2b76b23986588b4944853f60d57a16a5b34908dfc7e7b02a89354",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
