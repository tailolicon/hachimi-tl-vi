    },
    {
      "uid": "zhcn:970edb7dd632cb70a0dd0d26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比萨胜驹",
      "source_fingerprint": "9beb50d57d7703a64ba6e9d70094d69e3edf1f53654ce1b6055f0ddd7c2b63d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
