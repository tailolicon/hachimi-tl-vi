    {
      "uid": "zhcn:b9ff5d911c1e70f7219c1adf",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "…………。\n……――对不起……。",
      "source_fingerprint": "68239f58a34217083701e93b9e26dabcb081414fe2355b92ba4621f217f19da4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143301.json",
      "json_path": [
        "text_block_list",
