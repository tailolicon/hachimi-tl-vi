    },
    {
      "uid": "zhcn:694851fcc822ab5313c09fdc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……是啊。\n总之，先向着『日本杯』努力。",
      "source_fingerprint": "52b8faaeaddfa625235f68c4fb507117accc10be73b2988e899289389a1fcf07",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143301.json",
      "json_path": [
