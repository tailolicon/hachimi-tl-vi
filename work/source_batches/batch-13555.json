      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "来吧、从这里――冲刺！",
      "source_fingerprint": "67ac14537dd3e8248c25022b87dd80e822391de3f6f75adc1cec6518f15a05bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
