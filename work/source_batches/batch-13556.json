    {
      "uid": "zhcn:ec3267903fff9b0eb996d11f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "方法很简单。\n为了将放松与动作联系起来，\n有意识地进行条件反射训练。首先要――",
      "source_fingerprint": "ddc637260187318830a968964fc93fba9aa0a0ec440690da7c69662f31166897",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143304.json",
      "json_path": [
