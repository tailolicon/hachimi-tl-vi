      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，谢谢您。\n既然如此那就没问题了。",
      "source_fingerprint": "d3e2590709d8a3f3075e901e0c34de16f703338400728571a212fa38a9c6d96d",
