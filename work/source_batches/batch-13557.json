    {
      "uid": "zhcn:91705f7807294ff028f91fc3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今晚我打算要向玫瑰同学请教\n请问有什么问题吗？",
      "source_fingerprint": "b2f44c7a36391e8032740f692d6ca790bb68a0ebee6bf229265fe46cb3620725",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
