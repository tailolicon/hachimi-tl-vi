    {
      "uid": "zhcn:3e7c6a93be6ec6eb3bf5007b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "问题是没有，如果不舒服的话希望你不要勉强",
      "source_fingerprint": "d6d55fe679ccc84a9266b4fbb62d3f8f9515500e2a9b0f513a50e96355a12eca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
