      "source_language": "zh-CN",
      "source_text": "这是外人看来毫无必要的\n多余的努力。",
      "source_fingerprint": "3c495852415dd116e7a1184eac5978736b0ae4b64b84f9488d0ad8844e7441fd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
