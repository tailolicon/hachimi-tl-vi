      "source_language": "zh-CN",
      "source_text": "话题性十足，与强者们的激烈竞逐\n也会促进她的成长吧。",
      "source_fingerprint": "7daf6a587517c37cc7fa3e00c7898f2c855c41052df1f4bd8458e061ef507330",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
