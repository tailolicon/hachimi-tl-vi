        "name"
      ],
      "json_pointer": "/text_block_list/112/name"
    },
    {
      "uid": "zhcn:9a26850c9e2030fca13d7b63",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "果然是……\n『日本杯』对吧。",
      "source_fingerprint": "f6cb16a20bf4adf7aaa932087f3b4ffe3ff01fea4503ca072e750f382164d19c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
        "text_block_list",
        112,
        "text"
      ],
      "json_pointer": "/text_block_list/112/text"
    },
    {
      "uid": "zhcn:8fe638d6b754549faf0e55f8",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『日本杯』是在东京比赛场举办的国际赛事。\n国内外强者齐聚的，角逐世界最强赛马娘的大舞台。",
      "source_fingerprint": "c2f585f26038d3ed7c04355cddf01ae6c2ecf81299d1b025fb8649a58341e2e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
