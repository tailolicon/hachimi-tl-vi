    },
    {
      "uid": "zhcn:b363aa462a08f5848109dd75",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『……为什么？』",
      "source_fingerprint": "3eb320b39fd06d91771f81f24e960129ab696f0366889c638888609f21b63af7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
