    },
    {
      "uid": "zhcn:07b4aa0c1d5e666fff85dad9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "啊啊――\n今天的比赛是“史上最强”的！！\n大家一起来庆祝吧、恭喜你们！！",
      "source_fingerprint": "eb1c219da13090587fdf1d32b46028dbdc4e2895a4e9678d9ee76a68a033f1ff",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
