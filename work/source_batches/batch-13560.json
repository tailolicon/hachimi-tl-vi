      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『别这么说嘛、来。\n抬起头来看看吧、比萨』",
      "source_fingerprint": "4f5db48684f94ee2ea3c139b403cde61691b837de2f2df6663b91d172f4290dd",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
