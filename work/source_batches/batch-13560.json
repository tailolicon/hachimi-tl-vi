      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『好厉害……大家、都想赢呀。\n但是、为什么？』",
      "source_fingerprint": "1dd84a194916f8132626fc885a9fc97f8bf09b8310dd982c31341ca898a437e3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
