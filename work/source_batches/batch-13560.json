        "text"
      ],
      "json_pointer": "/text_block_list/29/text"
    },
    {
      "uid": "zhcn:c0178aaf0a321afbb7fbbfc7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "每个人都一心凝视前方，\n为了夺取独一无二的荣冠拼尽全力。",
      "source_fingerprint": "1a2ed59d9b261d62062454c54cacfb9cf8acf60fc006bec4b1614623fda659c2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
        "text_block_list",
        3,
        "text"
      ],
      "json_pointer": "/text_block_list/3/text"
    },
    {
      "uid": "zhcn:09037007a202d2c53fb0de34",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "比赛的母亲",
      "source_fingerprint": "a33e0ac3d01716b2a83c451feeb404a3f0ef6988c74b6f4b6ed807344d58e6e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
