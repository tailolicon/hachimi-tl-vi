    },
    {
      "uid": "zhcn:ff49847cb807b85361280bcc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "『为什么要在这种时候来看比赛啊？\n我不想来。现在，只觉得难过啊。』",
      "source_fingerprint": "69d3b4014d5c156c62501293db49be2ea6e9cd19ecc6e5a23a191985d4f1f8a0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
