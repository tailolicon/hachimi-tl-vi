        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:b52c40df5383ef6ca9c5da65",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――这正是、融为一体。",
      "source_fingerprint": "adfbddacc642a6c1d7712c4edd5942884238d4a92b3d388d27470b9e1055efe4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
        "text_block_list",
        25,
        "text"
      ],
      "json_pointer": "/text_block_list/25/text"
    },
    {
      "uid": "zhcn:b9b2cf36aeebe9d21aa27094",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "互相拍着肩膀、分享喜悦，\n这处充满了笑容与兴奋的地方――",
      "source_fingerprint": "9189569a3a9efb3e24bf376f4613ef4fe755e6fcd288f80447bf579993b29977",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
        "text_block_list",
        26,
        "text"
      ],
      "json_pointer": "/text_block_list/26/text"
    },
    {
      "uid": "zhcn:7f0ecde7290d77be7672aeb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她正在、目不转睛地注视着。",
      "source_fingerprint": "965d62feedfc3d4f5085f237a5b4a5ff35057e99c4c4442393bd7eb0fbb69e78",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
