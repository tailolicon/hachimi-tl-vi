        24,
        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:c89027649d4e82ab7f424fa1",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "恭喜你们！！",
      "source_fingerprint": "cc075ac1e286c826e2c2a561675f37f7322ba5a34875ddca140ccdfa849e1e10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
        "text_block_list",
