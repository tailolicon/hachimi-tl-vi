    {
      "uid": "zhcn:69a5d7b90b288c53e7b0f583",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――并非不可能。……只是，\n执行起来恐怕相当困难吧。",
      "source_fingerprint": "fde9d2c783e0e09a1d78485892b1b6ac2cc23088f6f0bde49ad43a20b285922c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/50/1143/storytimeline_501143307.json",
      "json_path": [
