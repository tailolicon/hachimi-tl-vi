    {
      "uid": "zhcn:d0c048c13a9069235c20b3b5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "名称叫做……\n“能够稍微勉强的安全训练理论”。",
      "source_fingerprint": "0f3ece657523708eda00c3d0a28612c0d00cb8c32e5245ef96e59993bd69b86b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
