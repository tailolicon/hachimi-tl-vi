    },
    {
      "uid": "zhcn:84b6eb1461d405bb505d6d26",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我把自己常用的地图app\n告诉了雪之美人。",
      "source_fingerprint": "e1592dd5143e71f7f79487db46c8da02778a438bf7cf38b6f7008ef711fe95d6",
