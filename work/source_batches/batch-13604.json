      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "非常好。期盼总有一天要追到\n而不断追逐公主的骑士故事，也完全可以！",
      "source_fingerprint": "452b15f2541f08c960a62f16ad32cf5c80dfe10ce6e5236d64ed723ac167f829",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
