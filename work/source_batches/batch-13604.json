      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "上演的是多鬼一人的另类鬼抓人。\n但是她跳过秋千、爬上攀登架，\n移动方式可说是千变万化。",
      "source_fingerprint": "f1ecf88bb086d3a6c869440bee9d41431d4cb0e68130db0346d507b722d0182b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
