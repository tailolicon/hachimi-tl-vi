    },
    {
      "uid": "zhcn:946c4ed8c3029402d0e6ab92",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "男孩A",
      "source_fingerprint": "552aa0689c151263aeb3a04915dc88ee847a77adc8052d585b8aa4a44f0fe8fb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/1039/storytimeline_801039002.json",
