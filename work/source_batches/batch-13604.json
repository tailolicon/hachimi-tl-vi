      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:3e83d127ef1e84fcdd4143eb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "可恶～～公主姐姐，再来一次！\n这次不会输了～！",
      "source_fingerprint": "f513336637e549c04d1b8ff813c13ab0285f1031dbb7af6948b0254a10a97929",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
