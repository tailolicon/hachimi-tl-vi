      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——呵呵。\n这样下去，简直就像是——\n在互相夸奖呢？",
      "source_fingerprint": "d1274aad52a6043a360870ae9d1670b6cd678919109413aace1f818eabd7c804",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
