    {
      "uid": "zhcn:9459f729e73f48922b16f517",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——是的，确实如此。纷争这种事——\n我希望能守护大家\n轻松愉快的时光。",
      "source_fingerprint": "e3416e4babc5af4f4ef43695c86425b0d0f8d5ef47dd23bf0371bba44e835af0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/1134/storytimeline_801134001.json",
      "json_path": [
        "text_block_list",
        15,
        "text"
      ],
      "json_pointer": "/text_block_list/15/text"
    },
    {
      "uid": "zhcn:c0b02db4fa7b37bfb986d25c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "共享场地，让出沙拉。",
      "source_fingerprint": "779f688dd641ecca9b6637570448370dd273c793a1ef20c4aae6aa048d36a7c7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/1134/storytimeline_801134001.json",
      "json_path": [
        "text_block_list",
        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:df3afecc4d0d5741830baa7a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我觉得你很温柔",
      "source_fingerprint": "ae77249eabd6fb324eb018dcf8413c17698ec6226a37fd97a90d2763d0c740e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
