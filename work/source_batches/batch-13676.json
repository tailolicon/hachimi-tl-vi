      "json_pointer": "/text_block_list/14/choice_data_list/0"
    },
    {
      "uid": "zhcn:4ae36d3a1de97996d2877ddb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看来，她也注意到了。\n于是，我试着把自己对她今天行为的\n感想说了出来。",
      "source_fingerprint": "3c5e1818f9d755ffb411984255546d6eed95d7e783f77b102a5dfb052438c037",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/1134/storytimeline_801134001.json",
      "json_path": [
