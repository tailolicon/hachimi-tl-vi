    {
      "uid": "zhcn:6008c24cd67d8a07a3628b3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "没关系——过一会儿，\n应该还会补上的。\n你先请吧。",
      "source_fingerprint": "a6381d726b8cd34c779011c5ba95b142f367b9309c4f44cd9b7f9992c4326090",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
