    },
    {
      "uid": "zhcn:d6b834d2ea8f8833f239d59f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "机伶金花绽开了笑容，\n温柔得如同花朵盛开一般。",
      "source_fingerprint": "428519e0507df8efc6c3ea2b2fb5a819f78a8c702dfbe412f51ceba173f7d6c5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
