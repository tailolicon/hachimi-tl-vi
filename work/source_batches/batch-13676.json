      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "——辛苦了。\n呵呵，我们真有缘呢。",
      "source_fingerprint": "aefcda2b041b95d33a0d34a775beb0bfa1f77a9a2937317b0d12f933257981b7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/1134/storytimeline_801134001.json",
