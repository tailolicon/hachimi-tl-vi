    },
    {
      "uid": "zhcn:d71493c79363030ae6a6f481",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你——你——你为什么会在这里啊！\n这里明明是我预约的啊！！",
      "source_fingerprint": "3e4bf1e3a6f26a83276345f4d200f4552a401eca21c202d0c4a09eef0a88ecad",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/1134/storytimeline_801134001.json",
