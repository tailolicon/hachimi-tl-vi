    },
    {
      "uid": "zhcn:96f9dc9307e0d7c3411bba90",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你是不是不擅长应对争执？",
      "source_fingerprint": "bd882ef5afa274b396f9641c9e732c55d2efab86e4345899db6eda5436da6bf5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
