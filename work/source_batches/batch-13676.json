    {
      "uid": "zhcn:a09f3a79c992012626c65762",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯——\n我预约的，那个场地——",
      "source_fingerprint": "4edf266ba5e707ac49a0e91eae042b82eee6348e3c0f66125ee6755bf0d2abbc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
