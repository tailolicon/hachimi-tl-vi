      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "秋川理事長",
      "source_fingerprint": "4a0c82c519bbbaf1e91c9d5e965a8640643b4ad1cf107eebabc5262cb9af6adb",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
