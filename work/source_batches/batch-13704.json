    },
    {
      "uid": "zhcn:9f52e2d49b1af13ff417713b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "被手纲小姐教训了一顿――\n游乐园的梦，化作了泡影……",
      "source_fingerprint": "358cd9f2d5c3926bdba5981caa4bdbdf3047cdeabf6155fc558ea2fe30bdca96",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/9002/storytimeline_809002004.json",
      "json_path": [
        "text_block_list",
        36,
        "text"
      ],
      "json_pointer": "/text_block_list/36/text"
    },
    {
      "uid": "zhcn:5c52d0ef80d050f4d5283f51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "――不过，通过这件事，\n和秋川理事长的关系，\n似乎加深了一些。",
      "source_fingerprint": "3de8f23365cb1a37c5735f6bfdbe49ebc9080938c738586e033fd9a9d2a51d32",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
