      "source_language": "zh-CN",
      "source_text": "手纲小姐的一句话，\n一下子击碎了我们的幻想……",
      "source_fingerprint": "996a5e9bfed74348250f7ac904302c218b03390f7af1f4147d6b0e74b9b155e1",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
