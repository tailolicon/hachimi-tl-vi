    {
      "uid": "zhcn:a3eef6747e8c3582d2843187",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "嗯呣！　那对面\n建过山车！\n从学园的窗户也能看到那边的轨道！",
      "source_fingerprint": "5d7722233d6a6fecd2fd4d7bd2c0b7ce82856931a4a6de9d05806120d20f9a72",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
