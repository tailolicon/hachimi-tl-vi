      ],
      "json_pointer": "/text_block_list/42/text"
    },
    {
      "uid": "zhcn:91a463999121cb1c63738b6b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "诸如此类，两人兴奋地\n在学园里奔走――",
      "source_fingerprint": "db892cfc823cbd9e2306fa7c8269f210c703634146abe8fbb49998243a455505",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
