    },
    {
      "uid": "zhcn:aed8042adfd677e45e511f7f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……妈妈？",
      "source_fingerprint": "a7b1d6cdcda39fb01c3429eec59a9ab9a3d6e13aaf5262486e4f4b63a6dc28d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
