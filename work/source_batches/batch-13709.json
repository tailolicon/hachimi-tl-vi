    {
      "uid": "zhcn:9df1f7b4b70e9a5df4405a91",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……有这么多人愿意为你提供帮助，\n说明你也为周围人付出了很多呢。",
      "source_fingerprint": "a0c041ad5341ce2eb9ad8b7af3439516da176c01c70fb26857bf359af829a34d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
