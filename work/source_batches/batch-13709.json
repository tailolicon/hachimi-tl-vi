    },
    {
      "uid": "zhcn:39e4e5a8f5d6e3eaeec254c6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "前学园理事长",
      "source_fingerprint": "2a4fb05386ad3b828ae773bfe14e680b669935c84d51b49b92572787c2fc1c16",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/9002/storytimeline_809002008.json",
      "json_path": [
