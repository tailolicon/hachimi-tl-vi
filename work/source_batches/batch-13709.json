      "json_pointer": "/text_block_list/37/name"
    },
    {
      "uid": "zhcn:6195a7c9f9178300846e351f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……你长大了呀，弥生。\n对不起，妈妈来晚了。",
      "source_fingerprint": "e0baac380875166ccdd0136ba465feba17f3b6a97571a9f02b787f22670ad035",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/9002/storytimeline_809002008.json",
      "json_path": [
        "text_block_list",
        37,
        "text"
      ],
      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:7393e5753d1754080c54d25c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "（……真是太好了，理事长）",
      "source_fingerprint": "92c2d0939a315e51d9b1578b92fe1def27af86c6bf7cab143667851f8b230e59",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/80/9002/storytimeline_809002008.json",
      "json_path": [
