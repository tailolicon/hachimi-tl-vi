      "json_pointer": "/text_block_list/37/text"
    },
    {
      "uid": "zhcn:4303b0ddc25ade2e5dbedbbc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千篇一律的方法解决不了个人的问题。\n天狼星象征选择尊重个人的想法，\n我赞同她的意见。",
      "source_fingerprint": "288cb0845b3528933dab8e169fa1d312f6884773dcecee4d3a399b416a4220a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
