      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哦，你挺上道的啊。\n难道你也是……“同道中人”？",
      "source_fingerprint": "74f119ce43ecb841cfb48fd40a2001b99446c5a2e899c56b4a9d6493bfb70a8d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
