    {
      "uid": "zhcn:1f41d522e547fc6d10eb6af5",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喂，你一直在偷听我们讨论吧？\n那你说说看谁的意见才正确。",
      "source_fingerprint": "cc5fe8185a4f626ac3ebd85dbb308f0340f9f5f47e3f47620aa024231665efbe",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
