      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青云天空的信",
      "source_fingerprint": "7d0b1503bc8ab0bfbddb6aa8c0b487f8f3fb781898b6edd63fb5286633402a11",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
