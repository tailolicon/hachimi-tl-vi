    {
      "uid": "zhcn:3f32f26c08c03d1e2e699bb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "还说过不要输给伤病痛苦，\n想一直在比赛中跑下去呢！",
      "source_fingerprint": "1089e106228a03b7ca63d01451a17ffe3708771f20c32fc6406ffe1934bed759",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
