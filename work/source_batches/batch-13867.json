      "json_path": [
        "text_block_list",
        3,
        "name"
      ],
      "json_pointer": "/text_block_list/3/name"
    },
    {
      "uid": "zhcn:2e49df8f5d336ee4f0aed7db",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "也就是说――只要跟踪那两个人，\n或许就能知道小草喜欢上蒲公英的契机了！",
      "source_fingerprint": "74d720e844acdf1e70f19f3cda4961dbd030a740ffe302e7b178eb6b5d438611",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/82/0065/storytimeline_820065002.json",
      "json_path": [
