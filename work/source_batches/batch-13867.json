    {
      "uid": "zhcn:a60e13fceaff827bdb7e62dc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……呵呵，你想太多了哦？\n这是千真万确的，我的真心话。",
      "source_fingerprint": "3561d98fe0c0af724079dcc4d8dc20efba1015414dd41b088d8bd40bc84ea075",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
