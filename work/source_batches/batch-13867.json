      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵呵，果然对你说不出口啊。\n因为――",
      "source_fingerprint": "01d54eca96a3dd7c59574e925f5e76f7aa63903eab1a09bfc29ebe38969278e1",
