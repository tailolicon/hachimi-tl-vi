    {
      "uid": "zhcn:1c82d7a32b3ec376b31bcdb2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "鹤丸刚志",
      "source_fingerprint": "4d9e2b3cae72899b469943d664c16afb74f6604d5e5a555074d58beedb0c90e7",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
