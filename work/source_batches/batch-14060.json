      "source_language": "zh-CN",
      "source_text": "这还用问吗！\n当然是鲁道夫象征会长啊！\n会长可是最厉害、最帅气的赛马娘耶。",
      "source_fingerprint": "694f6d28caba431945cd02a1bdef1a9fd3da577d263400b987c3ac9769d22c38",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
