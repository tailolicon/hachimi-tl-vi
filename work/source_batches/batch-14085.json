      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哈哈哈！猫的朋友应该也是猫吧！\n即使看不见，也能一起用脚步声演奏！",
      "source_fingerprint": "fbdcb8f3f699bde8e0c063f1b24d45a519345fbb3d92776fa4c1239993b3001e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
