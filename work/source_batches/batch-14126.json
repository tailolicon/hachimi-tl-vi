      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──我被交待要帮忙学园主办的\n“赛马娘共同小型演唱会”。",
      "source_fingerprint": "466ddb9a449bdd14a3630bfd4113a2b3b546482cd8e8ab73a08fb4f5ad3eaf10",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
