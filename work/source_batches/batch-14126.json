    },
    {
      "uid": "zhcn:285c3ed4fa0cfea7744000ec",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有四位赛马娘要上台表演。虽然距离当天还早，\n但印刷的海报已经送达……",
      "source_fingerprint": "0d477b8116e990510c7869696479dee5882b83253b248e698a54b84792dde6f4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0086/storytimeline_830086002.json",
