    {
      "uid": "zhcn:550c36f9bcfd1080177c06bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "虽然我并不笃定也无法证明，\n但我强烈觉得是其他情感。",
      "source_fingerprint": "23ef4598db2613278741cc57a612f592a3a95aa9c7147ed7c781392b83728c09",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
