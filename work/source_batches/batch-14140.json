    {
      "uid": "zhcn:f3826e36245f9b0e979000d7",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "天狼星象征对鲁道夫象征的情感\n应该不是“憎恨”。",
      "source_fingerprint": "b051f22be1eb28bac8a0be3318880a1fb0a99547f85fa200e88baa186217da5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
