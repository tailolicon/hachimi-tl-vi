    {
      "uid": "zhcn:bbfabc91c9ebf0df9343526a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "准备开始吧。这只手，\n正是为了此刻牵住你而存在的。",
      "source_fingerprint": "e6d7b0ff816bb58b5bf549092952041c82c5e31e99cea677c2cbe753a0177a8c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
