      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "──总有一天要抵达那里。",
      "source_fingerprint": "d320c7d6181b33e62442ad93b74432f4abc9ded33b7e86da682f010ac8e16c13",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
