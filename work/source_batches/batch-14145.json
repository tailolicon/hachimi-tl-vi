    },
    {
      "uid": "zhcn:fbbde4057a891d3fffb230de",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她指向格外耀眼的一等星。",
      "source_fingerprint": "9a0aa3e84d90165bb9565545414fa425a8661480ea64113cdd6bb328c8671f5a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0091/storytimeline_830091003.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:6852f3703bc7802a52037e51",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "感觉很像她的作风。\n我一边这么想，一边跟她闲聊片刻。\n不久之后，派对开始了。",
      "source_fingerprint": "1b5870630a896692cf00ad3ea96fb5cb5beea2da6a16ab14e4b99b472ef0b477",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
