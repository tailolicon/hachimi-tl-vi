      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有个诡异的声音传入耳里。\n如果不是我多心，这声音似乎是人声──",
      "source_fingerprint": "f8f1e044eb22d74b4b122f7d30931c3229b945ec065fcc5e078a1bf8f31b5854",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
