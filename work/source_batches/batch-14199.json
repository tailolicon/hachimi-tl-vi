      "source_language": "zh-CN",
      "source_text": "我接下来会实际尝试看看，\n希望你可以提供最真实的意见！\n首先是──",
      "source_fingerprint": "bcca370b147271ad11ffd924fd3af076134589c31aa0c2f9c3a25f340b8cb0c6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
