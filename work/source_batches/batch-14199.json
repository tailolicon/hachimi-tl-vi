      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "谢谢你之前帮忙提供点子！\n后来我又去征询了\n很多赛马娘的意见！",
      "source_fingerprint": "52ad0b6bbbf704f47dd5e15c3488c1fc588cb0d1f5c0f7b86bf1b1693907fba9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
