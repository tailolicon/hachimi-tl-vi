    {
      "uid": "zhcn:bf10f67ab269cc07fd20379b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好～！要忙起来了～！等准备好了以后，\n我也会邀请你参加的！\n千代王，加油──！！",
      "source_fingerprint": "62890d3b3e6486c9c4cfb3b612fee33bdd60ff79f81ccbf5682cb6b95179cb03",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
