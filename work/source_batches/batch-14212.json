      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟涡轮加上晨光的话，\n想必能进行得很顺利～！",
      "source_fingerprint": "cb20b7ae9f3d7e14a060805ef437f7894341805f3636a7cd296a4955013c0691",
