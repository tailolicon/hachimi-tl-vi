    },
    {
      "uid": "zhcn:e1f0ba938c11a6faaee18e39",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当初看她二次获颁URA奖，\n我就深深体会到她的实力有多么坚强。",
      "source_fingerprint": "b15c0b2870383750247fb2572a8dbafd8db7ab3eb5a280750334e92edc309b57",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114001.json",
      "json_path": [
        "text_block_list",
        10,
        "text"
      ],
      "json_pointer": "/text_block_list/10/text"
    },
    {
      "uid": "zhcn:348bedf1ed2821c22d8d8ea3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "留胡子的绅士",
      "source_fingerprint": "21057d3fd1edd6f51d2590f65ca606c52869c016487aa90a047405f80b928092",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114001.json",
      "json_path": [
