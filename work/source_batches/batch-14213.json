    },
    {
      "uid": "zhcn:b245c29e6710c62803104504",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的，我叫第一红宝石。\n能让你认得我，我感到非常荣幸。",
      "source_fingerprint": "d7236d3a3cee408c195f39c3b7c23dc9e6158eb2636b1955ea9a2a2d22582f34",
