        "name"
      ],
      "json_pointer": "/text_block_list/24/name"
    },
    {
      "uid": "zhcn:6e174f7ab171f982875c085f",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "请你先返回会场吧。我认为学园的训练员\n应该优先向其他重要人士打招呼，\n而不是留在这里和我交谈才是。",
      "source_fingerprint": "bbd09074c85dbdd8693caa8522652ed8e47f3024da11c68ca6d6e9e9c20bc6bf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114001.json",
      "json_path": [
        "text_block_list",
        24,
        "text"
      ],
      "json_pointer": "/text_block_list/24/text"
    },
    {
      "uid": "zhcn:11e41b4e512c902f1334f7bb",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "第一红宝石",
      "source_fingerprint": "9b56cd884b7441b8b32119740e379b8bc7aa840838b1c62bd9418c4a41cbf2b4",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114001.json",
      "json_path": [
