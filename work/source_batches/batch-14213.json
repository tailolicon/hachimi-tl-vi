    },
    {
      "uid": "zhcn:4d4ec6960a0cf42dc92e809d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "有年纪的绅士",
      "source_fingerprint": "f3f03c04c82c59a3843af4e77c79f93952bf6ff6ad3ccca053e70264b2da25b6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
