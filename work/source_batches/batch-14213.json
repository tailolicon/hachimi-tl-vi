      ],
      "json_pointer": "/text_block_list/11/name"
    },
    {
      "uid": "zhcn:25a3b0c52f847fe05d29a9ce",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "后来红宝石的母亲在出道战创下新纪录……\n当时真的令我好激动。\n令人不禁感觉到传说再临！",
      "source_fingerprint": "a9fc323cd58235c9b2cc6cbf468740a108a542eed3ff42a1665f756d858d13d9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114001.json",
      "json_path": [
        "text_block_list",
        11,
        "text"
      ],
      "json_pointer": "/text_block_list/11/text"
    },
    {
      "uid": "zhcn:8527d5ebe68cff901c4fed3a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "打扮华丽的女士",
      "source_fingerprint": "23b0d91c33c750e7507d0231eee8ba5d6e6e8b1fc975fd977dd46b5fb3590f52",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
