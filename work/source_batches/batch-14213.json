      ],
      "json_pointer": "/text_block_list/12/name"
    },
    {
      "uid": "zhcn:6c9f7b95150df586b3ee3b85",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对，没错！她后来在后冠路线\n也表现得非常亮眼……\n获得URA奖也是理所应当的！",
      "source_fingerprint": "b49898363a37365748bfa1603c4928748d4360c663eab1db05a5ddc0ef250573",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
