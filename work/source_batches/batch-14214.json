      ],
      "json_pointer": "/text_block_list/30/text"
    },
    {
      "uid": "zhcn:1f40acb97608d64e0aa8f4a0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不，我不是这个意思……！",
      "source_fingerprint": "c056b8c4f3b47cb261601849a11105498afb2b00afdde351ffcbca0153884f6c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114001.json",
