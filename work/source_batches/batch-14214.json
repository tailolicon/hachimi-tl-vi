    },
    {
      "uid": "zhcn:68a002aecabcb4ceb0d55568",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "喔～不错嘛！\n我也想看看那个千金小姐\n帮人顾店的模样！",
      "source_fingerprint": "af82f8099049459b58a4f1e52853412acd122342340b7b726cbd92f359065ddc",
