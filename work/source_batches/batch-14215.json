      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……嗯，你还是跟那时候一样呢。\n你记得吗？小时候在某一场派对，\n有个女生不小心把果汁洒到裙子上。",
      "source_fingerprint": "67834039b4942136703ef4ad5a572a262c5c2e476f9500c3080d20f2a6504830",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114002.json",
      "json_path": [
        "text_block_list",
        40,
        "text"
      ],
      "json_pointer": "/text_block_list/40/text"
    },
    {
      "uid": "zhcn:17338cbecb4ac30783a9a5d0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表",
      "source_fingerprint": "ac2ed51a4f1bab94d7cfad72158d24dc1b65b6e98236640c4943c73987c0fb8b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
