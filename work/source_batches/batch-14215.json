    },
    {
      "uid": "zhcn:e2e24987afd7407cef72ffe2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "你明明特地带她去换衣服……\n却用一句“我只是做了我们家族该有的应对”\n回绝她的谢意。",
      "source_fingerprint": "1b99f748261f6d1c2a49e6732bd853adb04c32b6196cb04643002f1bd63f1ce3",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0114/storytimeline_830114002.json",
      "json_path": [
        "text_block_list",
        41,
        "text"
      ],
      "json_pointer": "/text_block_list/41/text"
    },
    {
