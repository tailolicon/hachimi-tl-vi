      "source_path": "assets/story/data/83/0114/storytimeline_830114002.json",
      "json_path": [
        "text_block_list",
        4,
        "name"
      ],
      "json_pointer": "/text_block_list/4/name"
    },
    {
      "uid": "zhcn:5950c5af0748f5a3a9029c10",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "今天原本应该会有很多客人来……\n但可能要害大家失望了……",
      "source_fingerprint": "81275c3f4948d93f6e79597274b2965d1218288c227e8e4a04aca9ca8c1922fc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
