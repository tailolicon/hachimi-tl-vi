      "source_path": "assets/story/data/83/0114/storytimeline_830114002.json",
      "json_path": [
        "text_block_list",
        39,
        "text"
      ],
      "json_pointer": "/text_block_list/39/text"
    },
    {
      "uid": "zhcn:6c267b07bbb99b5bca39d322",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "日式点心店的老婆婆",
      "source_fingerprint": "e1d04b3814836a26ff67e97262daf5a7c460864ffa2d325aa21ae5e9bb75d84b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
