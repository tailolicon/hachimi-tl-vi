    {
      "uid": "zhcn:1146511918ae8265bc58331a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "店外的确有越来越多人聚集。\n看来这间店非常受到大家的欢迎……！",
      "source_fingerprint": "5a5462cfdb13433548a50ece28939a2a7da7a263498be7b55006b9f4503738d6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
