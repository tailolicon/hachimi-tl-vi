      ],
      "json_pointer": "/text_block_list/44/text"
    },
    {
      "uid": "zhcn:a064a3051b3a6f037d9360fc",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "千明代表离开之后，\n第一红宝石仍然手脚利落地\n处理好店内的工作。",
      "source_fingerprint": "b0e3842f2999e77efb3e9ccbd9a6f4da2abc06d39e9d30d954a16224fa450527",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
