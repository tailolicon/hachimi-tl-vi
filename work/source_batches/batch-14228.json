    {
      "uid": "zhcn:0b5353b59d913b074fbd4c45",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "善信是威名远播的四天王之首，渡边纲。\n太阳就扮演以“金太郎”之名为人熟知的\n坂田金时怎么样？",
      "source_fingerprint": "af63dbceaf971eab0eefc35766b29bc22f3e44285895589316e698338c70a77c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0119/storytimeline_830119001.json",
      "json_path": [
        "text_block_list",
