      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "既然想避免被怀疑，\n是不是把斧头藏起来比较好？",
      "source_fingerprint": "c613b2351f81e909891f7fa23e853b5b217fdbb018f800f8b61889dacd1c8fee",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
