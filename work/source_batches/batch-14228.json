      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我是金太郎！？好耶～！\n我要背着斧头去打鬼啰，喔耶喔耶～☆",
      "source_fingerprint": "1ba3187e9c9d71a2026b18329fa9dbb58d28c037313965ef81c92eb18f117f2f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
