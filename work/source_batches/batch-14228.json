        "text"
      ],
      "json_pointer": "/text_block_list/20/text"
    },
    {
      "uid": "zhcn:0bf1e9b191df21b342459cea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白阿尔丹",
      "source_fingerprint": "f8b9b5f7d8a5e6012d5978f9469dfcb0b8ba9cf1e4b3a12ddfa00cec84018256",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
