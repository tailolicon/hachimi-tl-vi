    },
    {
      "uid": "zhcn:f5fb8dea42bfcef3d9939d27",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "目白善信",
      "source_fingerprint": "292838dd30209de26be736979e1f3a3bc826881c9ce11ed7480a487776eff441",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
