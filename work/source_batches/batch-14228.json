        "text"
      ],
      "json_pointer": "/text_block_list/12/text"
    },
    {
      "uid": "zhcn:dbf9d5975c6eab7791971711",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "大拓太阳神",
      "source_fingerprint": "0f674377b83dac19093bba6ea2724d4eadc2ccd13a070e9d651967969bd200ef",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
