      "source_language": "zh-CN",
      "source_text": "呼、呼、呼……\n风仿佛仍在我的心里吹拂──",
      "source_fingerprint": "7d56ed46e550c2de791531c20d132fcfa0159f4965954604414ca444e69ae4d5",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
