      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在漫长的时光中，这里从辽阔的草原\n变成了空荡荡的荒野。",
      "source_fingerprint": "75af8a13812454f7705ec4c7421493519c49e72498bad359db84dd719607f384",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
