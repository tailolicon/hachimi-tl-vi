    },
    {
      "uid": "zhcn:1058d947fb0105f95bb71993",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "哇啊……！眼前一片绿油油的！\n草的味道闻起来好舒服……",
      "source_fingerprint": "91e495fc712e921aa108736e80bcc6d2ea127cf1bfe53bedd84e394f4ee2efb6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
