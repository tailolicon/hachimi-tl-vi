      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为这里曾经是一个名为达利阿拉伯的\n赛马娘所深爱的地方。",
      "source_fingerprint": "8873aaecef1de7e194899bb3c19d787f295173175a587d038f3edd9eaee3d912",
