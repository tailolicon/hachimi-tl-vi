      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……这里原本是一片荒芜的土地。",
      "source_fingerprint": "3a9fb102418dab529158bd1331d2a50637e7bf56069113c7a075f7cfbb3478f6",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
