      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不过，这也是太阳的指引。\n不介意的话，要不要和我们一起旅行？",
      "source_fingerprint": "83e01f65b5766be0b74fc58fb0c3d926c013e30eedb836a5a8268dc04a01913a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
