      "source_language": "zh-CN",
      "source_text": "达利阿拉伯",
      "source_fingerprint": "b85e6b90e35e2145a15d84f1c6bbd73545044c8ba2851665925c878539abc963",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
