      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "她把略为陈旧的工具交到我手上。\n不过工具看起来完全能正常使用，\n或许是受到了精心维护。",
      "source_fingerprint": "37788c126a585f42bd9c62d352e3125fb32911f5220066f369e8f8ab4131783e",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
