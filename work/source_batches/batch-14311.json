      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这让我再次感觉到，\n或许是在她的支持下，\n学生们才有平日的精彩表现吧。",
      "source_fingerprint": "f5f34d839ac5094142dc99e2435d3f2c523dcf30e1ee1be1cde0ed71255e3b8a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
