      "source_language": "zh-CN",
      "source_text": "我明白了，保养蹄铁的工具对吧。\n可以详细告诉我你想借什么吗？",
      "source_fingerprint": "40cc3423f1b635e8582cdb42df663b7ae816dd17a248b4acc7578d8f0dc196a2",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
