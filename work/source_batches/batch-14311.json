      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "是的，当然。\n只要有需要的东西，我随时服务。",
      "source_fingerprint": "9dadc340c3b13945ae48e0b73b3238b2ae4afaa12abc19d9c221486a4085fdaf",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
