      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "之后我跟生野狄杜斯谈了一会──",
      "source_fingerprint": "bf7186e66eb27d20274da9ecedcb8558775f62c370eb91eedeec1f51bc6b454b",
