    {
      "uid": "zhcn:0a0810d68a9d095333296cc0",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "好、好喔……",
      "source_fingerprint": "cf448645cabb5eaad511cf1e80675e2d23d6c53f4d172c5e3cf0e7853522bf66",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0145/storytimeline_830145001.json",
