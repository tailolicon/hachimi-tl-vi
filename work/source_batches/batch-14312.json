        16,
        "text"
      ],
      "json_pointer": "/text_block_list/16/text"
    },
    {
      "uid": "zhcn:22c71677cd7f5e8f72e202a3",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "意思是她想要追求这两点吧？\n……大概是。",
      "source_fingerprint": "9f41dab82e482150e5d80809b72ac23c36f8d32eaac69c557dc32a3fb0205a83",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
