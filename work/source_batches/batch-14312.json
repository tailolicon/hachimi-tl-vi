    {
      "uid": "zhcn:9fbac04d0b8e6c927f692185",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……很好，跟我来。\n我告诉你如何步向乐园。",
      "source_fingerprint": "7368db7ae7566037d8dfc75a7660427727f4171cad93a72cc72fa9bc7ce3d875",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0145/storytimeline_830145001.json",
      "json_path": [
