    {
      "uid": "zhcn:5bd0ea3e217bc9d37f1e76be",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "呵……你观察得真仔细。\n不愧是誓死坚持个人美学的人。",
      "source_fingerprint": "c045a1378a7617e02d324ff54b21478155d1ce7f718f2b44714c036ed3daa7ca",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
