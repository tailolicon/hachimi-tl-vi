    },
    {
      "uid": "zhcn:b77a87ea0dadc30d672913c2",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "登山客的语气听起来有些困扰。\n我仔细一看才发现，\n另一个人是特雷森学园的赛马娘。",
      "source_fingerprint": "d8bbee73bf4f09ec8253366efe22defa5f39d4a1abe4c7b3f003fcd48ea8d08d",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
