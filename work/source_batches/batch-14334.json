    {
      "uid": "zhcn:146733cfd5d61e14f6f1ea1d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我跟怒涛在排练歌剧新作的时候，\n被热情的粉丝团团围起来了！",
      "source_fingerprint": "df63f36e5d15094fa3e5ca29d0497840794de160bec30bb895b9eac6fc0b6a71",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
