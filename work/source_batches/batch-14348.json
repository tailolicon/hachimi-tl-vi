    {
      "uid": "zhcn:fe67378fd86919d0221110d9",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "当我走下楼梯时，不知道从哪里传来了\n赛马娘喃喃自语的声音。",
      "source_fingerprint": "577f2e485ecdbbb42c370194fe3f6489d803d8c8d2443bdaa785de8504af07e0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
