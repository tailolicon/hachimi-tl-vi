      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "对，就是你！\n你有没有看见茶座？\n因为我有事情想请她帮忙──",
      "source_fingerprint": "b080069448159e7987655b986f6c96e77b06a745ffe56fee1942fe2130b56289",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
