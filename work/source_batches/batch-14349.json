    },
    {
      "uid": "zhcn:10525d4c304811b5b05f9e06",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我不想久待，正打算拿着东西\n赶快回到训练员室时──",
      "source_fingerprint": "c73cb99112d711a6006af1764417ff01244a21aee25343733971ac092c05176c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0157/storytimeline_830157001.json",
      "json_path": [
        "text_block_list",
        2,
        "text"
      ],
      "json_pointer": "/text_block_list/2/text"
    },
    {
      "uid": "zhcn:52f4de310d7698c9c18bee72",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……她不在这里喔",
      "source_fingerprint": "e721ff46ee6b7bfeed02958c3e362bf3a998e49b3753a1a9423534161acd64b4",
