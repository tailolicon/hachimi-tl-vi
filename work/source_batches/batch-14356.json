    },
    {
      "uid": "zhcn:0d9a60c7094e650ab9dff27a",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "看到在跟赛马娘四处打听的\n气槽，就过去打了个招呼。",
      "source_fingerprint": "d16174036a35fe130175a8c35aed1df387c06d5631c0e05dfb031a07d307106a",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0159/storytimeline_830159002.json",
      "json_path": [
