    },
    {
      "uid": "zhcn:29aab23d8893d8db25836e1e",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "听她说，她好像在跟有兄弟姐妹的赛马娘请教\n姐妹吵架后和好的办法。\n然后气槽的下一个目标是――",
      "source_fingerprint": "e7f504206d1721861a98eef0c120bc73450e00475954af3baa19a3a75c67d60f",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0159/storytimeline_830159002.json",
      "json_path": [
