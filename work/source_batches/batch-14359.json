    {
      "uid": "zhcn:3910f00090341147ec29cb6c",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "我懂得了。在你们的帮助下，\n去了解这个世界，积累更多的经验。",
      "source_fingerprint": "89bc05902d42fcf44672f2565c13741fa80eee3d4913dc3d0f0a278ad05ae009",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
