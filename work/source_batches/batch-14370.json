      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "阿妈",
      "source_fingerprint": "676a215e0efa3768f5c6fbee9c1c003808c6354503a4efb629e0e34c60284659",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0234/storytimeline_830234001.json",
      "json_path": [
        "text_block_list",
        2,
        "name"
      ],
      "json_pointer": "/text_block_list/2/name"
    },
    {
      "uid": "zhcn:e82e3b90fcf0fd17ded570b1",
      "kind": "story",
