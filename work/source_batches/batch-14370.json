      "source_language": "zh-CN",
      "source_text": "我在找睡衣。\n前开式，纱布质地的睡衣\n在住院时穿很方便的。",
      "source_fingerprint": "244f798e70787ff8f95d39b418185b2399bed04e5316eb3fd8035abea3bf1bf0",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
