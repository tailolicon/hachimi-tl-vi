    },
    {
      "uid": "zhcn:8706724b8b3bccff30d40141",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "多亏了你，我才能愉快地送别他",
      "source_fingerprint": "85a3f2bc500aed365c121b224196af77eb6997f0f6f8084926597f80be16f3db",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
