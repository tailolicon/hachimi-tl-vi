      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那个时候，让你担心了，对不起",
      "source_fingerprint": "438c9f63ffdbc00bc35215bd5533b1694e8a27911f062fe8e7ad5884bc8bfdeb",
