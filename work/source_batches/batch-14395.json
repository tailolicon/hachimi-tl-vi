    {
      "uid": "zhcn:ee5a1e9f777fa5cfd57bf3e6",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "不把事情都揽在自己身上，才能做得更好啊",
      "source_fingerprint": "65b152300abdfef3f665288007ecf35852715843027a2f05f5ea4c6911aeb607",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
