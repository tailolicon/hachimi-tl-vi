    {
      "uid": "zhcn:8546bc191c1a93ecac84a52b",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "在大家的幸福之中——\n也应当包含，\n您自身的幸福——才对。",
      "source_fingerprint": "c7bf0e1a84f88427f4780cd192f8db9944b042da73a8761142a98416663aa604",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
