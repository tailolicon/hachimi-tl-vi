      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "青春永驻",
      "source_fingerprint": "476ed508d9d1be628a0f146f1908512cb67ff3f58f9463fb5b22adeee9da5bc9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
