      ],
      "json_pointer": "/text_block_list/33/name"
    },
    {
      "uid": "zhcn:abe246824d8af6d55d72916d",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "那孩子啊，和你一样来自日本，\n怀揣着要在海外拿冠军的满腔热血在奋斗哦。\n……来，我们给她加个油。",
      "source_fingerprint": "bb6f6f4cae41801c89fb6595a22643a62c617ccae89e78118cf25957ad1253bc",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
