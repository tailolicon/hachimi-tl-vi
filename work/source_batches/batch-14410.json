    },
    {
      "uid": "zhcn:3032620ca76dec0cd2ea7084",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "幼年青春永驻",
      "source_fingerprint": "96f974f2bfd551e97bc75ef635cc3f63b82b7b1c72605f5c4153152c47dee270",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
