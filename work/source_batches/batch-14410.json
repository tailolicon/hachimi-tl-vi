    },
    {
      "uid": "zhcn:596ef35085814d6b654e6e32",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "永驻的父亲",
      "source_fingerprint": "07ac3cfbd4e8e5e4643d760a62a47513e857fb53c77b29fb1a0b9384aa870ef9",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0289/storytimeline_830289002.json",
      "json_path": [
        "text_block_list",
