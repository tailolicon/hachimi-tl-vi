    {
      "uid": "zhcn:fe55d5ee0e51c3e2a6d4e0ea",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "因为有同期的存在，可能性才会被无限拓展。\n所以来吧，来特雷森学园——！",
      "source_fingerprint": "31b72faaf3a27fa3236052d158c9d5fcd2c9beafb362d996bd7e401a6f46dc9b",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
