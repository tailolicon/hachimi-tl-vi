      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……请问发生什么事了吗？",
      "source_fingerprint": "227ddaa2c35686652122b71e9a53fe7fed23859cc19eb2bc6700d4536d6df576",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
