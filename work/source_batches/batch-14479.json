    },
    {
      "uid": "zhcn:6d15ed171e235c95aa107277",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "……！我们一定会让您满意的！！\n各位，开作战会议！\n哦—！",
      "source_fingerprint": "c6016bda44af7d0d190be54211b94e0899cf000e9c83800e0289e86f1185e389",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
      "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
      "source_path": "assets/story/data/83/0312/storytimeline_830312001.json",
      "json_path": [
