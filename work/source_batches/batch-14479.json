    },
    {
      "uid": "zhcn:800adc852913c70db0b17360",
      "kind": "story",
      "source_language": "zh-CN",
      "source_text": "这，才正是千明代表的本色。",
      "source_fingerprint": "6e753e98a21b53273e516b23634fbb72f94a2ad242c60f097494e8555032c45c",
      "source_repo": "Hachimi-Hachimi/tl-zh-cn",
