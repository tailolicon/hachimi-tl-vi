{
  "schema_version": 1,
  "policy_version": 1,
  "plan_id": "tr-p1-67f8551f7780-cc8de526ed4a-6ad5511b56",
  "batch_id": "tr-p1-67f8551f7780-cc8de526ed4a-6ad5511b56-b0518",
  "context_snapshot_sha256": "6ad5511b56525b4d395dab866f829e03d028e74651cdfd6e6e729152cab9f3fe",
  "review_generation": "retrospective-canonical-full-review",
  "items": [
    {
      "uid": "zhcn:ac8faaa9e82a3f63fbb7166a",
      "source_batch": 130,
      "entry_index": 20,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1043"
      ],
      "key": null,
      "source_text": "紧靠着被冷雨冻僵的肩膀，誓要创造奇迹的少女们的歌曲。\\n我会无数次闪耀，只要有梦相伴——只要有你相伴。",
      "source_fingerprint": "ca95c7db1a5a9052dd000d45521132ec6f1b7db05b5809e994360abce87ca76a",
      "current_text": "Tựa vai sát bên nhau khi đã lạnh cóng dưới cơn mưa buốt giá, những cô gái thề sẽ tạo nên kỳ tích cất tiếng hát.\\nTôi sẽ tỏa sáng hết lần này đến lần khác, miễn còn có giấc mơ bên mình――miễn còn có bạn bên mình.",
      "current_fingerprint": "a77a67495c14a3483018237c3a66764f029e97ab51bc8e51c60511915f13a9c1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:4fe4b4180bed948266ec76a9",
      "source_batch": 130,
      "entry_index": 21,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1044"
      ],
      "key": null,
      "source_text": "目标是，顶尖马娘偶像！拿起麦克风，以愉快的心情\\n用可爱又活泼♪的笑容来唱歌吧☆",
      "source_fingerprint": "613b8afc06885196bcec06d0e016de691faae00251bb6030b6e6a0addcb219c5",
      "current_text": "Mục tiêu là trở thành thần tượng Uma Musume hàng đầu! Cầm lấy micro, với tâm trạng thật vui vẻ,\\nhãy hát bằng nụ cười đáng yêu và tràn đầy sức sống♪☆",
      "current_fingerprint": "4fd90b67e36cdec2bb2b81e912dc53c883275061418014fe1a329a02f94b0a37",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:b3f1e5632ce1ca42741a94b7",
      "source_batch": 130,
      "entry_index": 22,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1046"
      ],
      "key": null,
      "source_text": "『一逃到底☆SISTERS』将，冲入你的心灵！\\n毕竟，恋爱最重要的就是冲刺！对吧？",
      "source_fingerprint": "784d31dfde51518c790ff48c16274f6328fbf11533ce1e945f0debe1e6cb7946",
      "current_text": "『Ichi Nige Tōtō☆SISTERS』 sẽ lao thẳng vào trái tim bạn!\\nBởi vì trong tình yêu, điều quan trọng nhất chính là tăng tốc! Đúng không?",
      "current_fingerprint": "8861d5b5caeb1223a3ae72474cd35ffe46ac5f27337110c3a70a7bf092b4e947",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:26260496dfac85637d6f50e8",
      "source_batch": 130,
      "entry_index": 23,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1047"
      ],
      "key": null,
      "source_text": "轻轻回响于心灵的摇篮曲。\\n越是痛苦与疲惫时，越要『PAYAPAYA』。……有什么意见吗？",
      "source_fingerprint": "1cdaf19287081f2cf8ff0e6511e7d3bbcc92fcfeb69806c6a5623a4662dbf33f",
      "current_text": "Một khúc hát ru nhẹ nhàng vang vọng trong tim.\\nCàng đau khổ, càng mệt mỏi thì càng phải 『PAYAPAYA』. …Có ý kiến gì sao?",
      "current_fingerprint": "4bd970340e79d5fb06d356936ef9d8937ff0dabc13ef8985025680a7ab6ea5e0",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:f7af6650002ea407eaa6f7a4",
      "source_batch": 130,
      "entry_index": 24,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1048"
      ],
      "key": null,
      "source_text": "闸门已经敞开。对奔跑者而言一切都是广泛而平等的。\\n――来吧，挑战吧！来吧，奔跑吧！向着那强风吹拂的方向！",
      "source_fingerprint": "3f76179a79e89d9aac291948c744a3efce397d8671916414db440a020f343cbd",
      "current_text": "Cổng xuất phát đã mở. Với những người chạy, mọi thứ đều rộng mở và bình đẳng.\\n――Nào, hãy thách thức! Nào, hãy chạy! Hướng về nơi cơn gió mạnh đang thổi!",
      "current_fingerprint": "94b177c891b6ebac33eeb8ef17b9b0bc1162b28f9b478e6917a78f9a4a310699",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:838b700b0e50a12fa745bfd1",
      "source_batch": 130,
      "entry_index": 25,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1049"
      ],
      "key": null,
      "source_text": "属于爆进！根据爆进！！为了爆进而作的歌曲！！！\\n听了这个的你，也是爆进伙伴了！（谈：班长）",
      "source_fingerprint": "63db370251f70bfc16dd743a4c1ffb3c7c8d8395b1ac27e52a9807d384cc4768",
      "current_text": "Một ca khúc của Bakushin! Theo Bakushin!! Và dành cho Bakushin!!!\\nBạn nghe rồi thì cũng là đồng đội Bakushin nhé! (Lời: Lớp trưởng)",
      "current_fingerprint": "c31296c8106c4c446f9c9687d64d327552b34b8314dd0eda818d04610f1eaf95",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:3f475c793e7ff99d300a8ba5",
      "source_batch": 130,
      "entry_index": 26,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1050"
      ],
      "key": null,
      "source_text": "一周年纪念之际，满怀感激之情所创作的歌曲。\\n我们会朝着梦想之后的梦想、甚至是再往后的梦想不断奔跑——与你同行。",
      "source_fingerprint": "2a1d72c15ad4c8e4924d116da720938e56997bc4c7c043d146a8ba4d2564ffaf",
      "current_text": "Ca khúc được sáng tác nhân dịp kỷ niệm 1 năm, chứa đầy lòng biết ơn.\\nChúng tôi sẽ tiếp tục chạy tới giấc mơ sau giấc mơ, rồi cả những giấc mơ xa hơn nữa――cùng bạn.",
      "current_fingerprint": "f972dc5b0f2116cf790655a80d582005cd4fa0dde717372076cef56b05d1b25b",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:ee32e23a310b8ee70df2f7b0",
      "source_batch": 130,
      "entry_index": 27,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1051"
      ],
      "key": null,
      "source_text": "不断奔驰——直到梦想实现的那一天！\\n将赛马娘们由笑容与泪水所编织的青春融入其中的歌曲。",
      "source_fingerprint": "ba44ee848c39937fc62e35683a77448c682c0eaee4bb3da63f601b080e3f7958",
      "current_text": "Tiếp tục chạy――cho đến ngày giấc mơ thành hiện thực!\\nMột ca khúc dệt nên tuổi trẻ của các Uma Musume bằng nụ cười và nước mắt.",
      "current_fingerprint": "d9a15aff09d40349e0d09588a6c2bf003d64e509e8e6c878c6feab26ae24fad1",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:2f566fbbaf7c905c7cfa7c77",
      "source_batch": 130,
      "entry_index": 28,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1052"
      ],
      "key": null,
      "source_text": "无",
      "source_fingerprint": "484d55613910eb8c0917fe308b499d474115ced993cd002a17d7cc75254330a4",
      "current_text": "Không có",
      "current_fingerprint": "af48b64f2cb6cce392c175016f400d937dd8d183cfaf51511aac9e01ffe36666",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:95cf2f3278db8a0000569f39",
      "source_batch": 130,
      "entry_index": 29,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1053"
      ],
      "key": null,
      "source_text": "霓虹灯下舞动，委身于节拍。一首让夏天更加火热的乐曲！\\nLive也好比赛也好，绝不能把观众的视线让给任何人！！",
      "source_fingerprint": "5e4f68370565412e5892193350f7c7b29bfbc37f64104a323c2a4d8de29c2957",
      "current_text": "Nhảy múa dưới ánh đèn neon, thả mình theo nhịp điệu. Một ca khúc khiến mùa hè càng thêm nóng bỏng!\\nDù là Live hay cuộc đua, tuyệt đối không nhường ánh mắt khán giả cho bất kỳ ai!!",
      "current_fingerprint": "0e73e8af639c87fbac7a00499f52a8e6577de567437c4430df633118ff19aa5d",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:f1c556c705608cc092fe6f59",
      "source_batch": 130,
      "entry_index": 30,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1054"
      ],
      "key": null,
      "source_text": "歌颂激情、热血、一马当先的胜者之歌。\\n铭刻于历史的胜利之时，将永远留下其熊熊燃烧的余韵。",
      "source_fingerprint": "7684189df04e5f4d851f7689e47723383523e04066379ec3f9a55510c4cbb94f",
      "current_text": "Khúc ca của người chiến thắng, tôn vinh đam mê, nhiệt huyết và tinh thần dẫn đầu.\\nKhoảnh khắc chiến thắng khắc vào lịch sử sẽ mãi lưu lại dư âm cháy bỏng.",
      "current_fingerprint": "7692a439d6f7aad15675a5478d949906db8f476348171eff87dde8e851ec8af4",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:bd1185193ee53cb7750cb44a",
      "source_batch": 130,
      "entry_index": 31,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1055"
      ],
      "key": null,
      "source_text": "看那儿！是船！？还是UFO！？都不是，是小金船哒！！！\\nPeace Peace♪怎样～？这块地方被我掳走咯☆",
      "source_fingerprint": "c844b0ff87dd26a2d607a806bae3f6975f6bb1430729d07b31a86dae994b1382",
      "current_text": "Nhìn kìa! Là tàu!? Hay UFO!? Không, là Gold Ship bé nhỏ đây!!!\\nPeace Peace♪ Thế nào～? Chỗ này đã bị tui bắt cóc rồi☆",
      "current_fingerprint": "4d39f36156fee75b9274798db5839755daa3d23197cf1773ce6c15fcea053426",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:e206b23f6d7353c39ca57a84",
      "source_batch": 130,
      "entry_index": 32,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1056"
      ],
      "key": null,
      "source_text": "由名门目白家演唱的，旋律庄严的合唱曲。\\n目白家族的荣光，无论何时都至高无上，绵延不绝――",
      "source_fingerprint": "483979e51f5217c2c9551ac0248eafb98a211317b64f2cc81580a0fcbabdf28e",
      "current_text": "Một bản hợp xướng trang nghiêm do danh gia Mejiro cất tiếng hát.\\nVinh quang của gia tộc Mejiro, bất cứ lúc nào cũng tối cao và trường tồn――",
      "current_fingerprint": "8becdfa94f58dcc30f326888965127dec7e1aa4158cf1fc0d54d309b9cbcb04c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:ea682e017009b260a37994e7",
      "source_batch": 130,
      "entry_index": 33,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1057"
      ],
      "key": null,
      "source_text": "一首伴着汗水与泪水的闪耀歌曲！闪闪发亮的可爱马娘偶像\\n背后是踏踏实实的努力☆",
      "source_fingerprint": "68b7fb5cc8212384928de2569e1f5fbc369ad6a2a58b72a063af10873ef89e0d",
      "current_text": "Một ca khúc lấp lánh cùng mồ hôi và nước mắt! Phía sau thần tượng Uma Musume đáng yêu, tỏa sáng rực rỡ\\nlà những nỗ lực bền bỉ và chắc chắn☆",
      "current_fingerprint": "b90289f5e9a5fe493e698a2e3a589d37c5f6201cec0d4dc84a81daaf8084c8bb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:95773ed3f946b9fb3b654d70",
      "source_batch": 130,
      "entry_index": 34,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1058"
      ],
      "key": null,
      "source_text": "一首歌颂自遥远的过去延续至今的灿烂光辉的歌曲。\\n那绵延不绝的光辉，还将继续奔向未来！",
      "source_fingerprint": "3b731c1b2292aa3b69eeae59b762774eeaaeb4eca1413075ab7afec8a4371bf9",
      "current_text": "Một ca khúc ca ngợi ánh hào quang rực rỡ kéo dài từ quá khứ xa xôi cho đến hôm nay.\\nÁnh sáng không ngừng nối tiếp ấy sẽ còn tiếp tục lao về phía tương lai!",
      "current_fingerprint": "2398db7e4b7cdb92c4ba9a720bda1c48356c1cd9816cd7e99079b08a6ec358a2",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:e1e6ffdcb42505d1070149c0",
      "source_batch": 130,
      "entry_index": 35,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1059"
      ],
      "key": null,
      "source_text": "在闪电战般的赛场上展开激烈竞争的同伴们，与她们所演唱的歌曲。\\n无论何时都想要保持微笑――\\n因此才要拼尽全力，奔向胜利的彼岸！",
      "source_fingerprint": "050a9d2b20ad70c365bc636fad4eed4a3b313aaef94f486257b1715bf0efb60f",
      "current_text": "Ca khúc được hát bởi những người bạn đang cạnh tranh quyết liệt trên đường đua nhanh như chớp.\\nDù lúc nào cũng muốn giữ nụ cười――\\nchính vì thế mới phải dốc hết sức, chạy tới bờ bên kia của chiến thắng!",
      "current_fingerprint": "fd42d12ee8a0119dc6ec2f501f1299185713afd62bbc1a413ddf96b6982d2638",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
          "target_vi": "Dốc hết sức",
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:d25304bb9c6d48340815342b",
      "source_batch": 130,
      "entry_index": 36,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1060"
      ],
      "key": null,
      "source_text": "一首献给肩负辉煌未来的诸位英雄的歌曲。\\n目标是名为梦想的财宝，向着未知的大海――启航吧！！",
      "source_fingerprint": "9f1d646027fad2dbcd3f8e7ed47a98e273cf95630ae34bf56fade12c943e191a",
      "current_text": "Một ca khúc dành tặng những vị anh hùng đang gánh trên vai tương lai huy hoàng.\\nMục tiêu là kho báu mang tên giấc mơ; hướng tới đại dương chưa biết――ra khơi nào!!",
      "current_fingerprint": "f66208f33738583754c87519f44c0226fa3972df82522c5b6a5a147d9a5f48b0",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:46a04059ea36edd214d1cc99",
      "source_batch": 130,
      "entry_index": 37,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1061"
      ],
      "key": null,
      "source_text": "有争斗、也有和睦！摇曳地♪塞满了赛马娘们软乎乎～时光\\n的学园欢歌♪",
