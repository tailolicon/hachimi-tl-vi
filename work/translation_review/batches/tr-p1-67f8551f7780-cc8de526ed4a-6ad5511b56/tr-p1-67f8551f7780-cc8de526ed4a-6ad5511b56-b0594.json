      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "4"
      ],
      "key": null,
      "source_text": "鼓励！　期待今后的\\n成长哦！",
      "source_fingerprint": "344bcbe0169b5f2a57744fddd75ced3348e7b59a7ebfb6ba4046f79ac5a0b03d",
      "current_text": "Cố lên! Mong chờ\\nsự trưởng thành sau này nhé!",
