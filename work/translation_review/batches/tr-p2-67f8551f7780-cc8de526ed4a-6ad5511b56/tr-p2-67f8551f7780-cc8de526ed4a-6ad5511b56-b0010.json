      ],
      "key": "AccoutDataLink608023",
      "source_text": "即将打开Cygames ID门户网站，\n确定吗？",
      "source_fingerprint": "fc77803f45b6a477668a1560882f9f26006dbfee8e04bfa4f28ea0d717ef72d2",
      "current_text": "Sắp mở cổng Cygames ID,\nbạn có chắc không?",
