{
  "schema_version": 1,
  "policy_version": 2,
  "plan_id": "tr-p2-67f8551f7780-cc8de526ed4a-6ad5511b56",
  "batch_id": "tr-p2-67f8551f7780-cc8de526ed4a-6ad5511b56-b0523",
  "context_snapshot_sha256": "6ad5511b56525b4d395dab866f829e03d028e74651cdfd6e6e729152cab9f3fe",
  "review_generation": "retrospective-canonical-full-review",
  "items": [
    {
      "uid": "zhcn:b4eafdd04bcc40d31e690729",
      "source_batch": 131,
      "entry_index": 40,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1145"
      ],
      "key": null,
      "source_text": "追逐憧憬，积累的努力一定会结出果实。\\n绚烂盛开的花束。如果要赠送的话，请一定送给你。",
      "source_fingerprint": "dad49ff575fe1facafc391f5dd9bad2d232ae7738532c92d9fea448b0da34d38",
      "current_text": "Theo đuổi niềm ngưỡng mộ, những nỗ lực tích lũy rồi nhất định sẽ kết trái.\\nMột bó hoa nở rực rỡ — nếu được tặng, nhất định tôi muốn tặng cho bạn.",
      "current_fingerprint": "403e4f3ccdec89e407354a181ebaf5c83e7d9d40f4d8e39605000f25c0897410",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:f2f8eff1f522ce2c2c8003da",
      "source_batch": 131,
      "entry_index": 41,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1146"
      ],
      "key": null,
      "source_text": "心中燃烧的心之火焰，耀眼地燃烧着。\\n要与律动的节奏一起闪耀，my Queendom！",
      "source_fingerprint": "5a9fa3c8bdfc8fc6a63ae75c271a7da5e367ba0bd922ef8e51f23b3e76a472e1",
      "current_text": "Ngọn lửa trong tim cháy rực, tỏa sáng chói lòa.\\nHãy cùng nhịp điệu rung động mà tỏa sáng — my Queendom!",
      "current_fingerprint": "8b19cf740d19b5ff030c396964df70fec17db510357ef59f22c7a3f293567b2d",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:b67cbd5bf0c8af38b92c82aa",
      "source_batch": 131,
      "entry_index": 42,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1147"
      ],
      "key": null,
      "source_text": "用这双腿开拓无人到达的未来！\\n刻下只属于我的轨迹，追寻那天憧憬的荣冠！",
      "source_fingerprint": "ca16ec33cd4877eb4b4f00a87b4d7172b6567933e5952efb598fc94711c9c768",
      "current_text": "Dùng đôi chân này mở lối tới tương lai chưa ai từng chạm tới!\\nKhắc nên quỹ đạo chỉ thuộc về mình, truy tìm vương miện từng ngưỡng mộ ngày ấy!",
      "current_fingerprint": "14de11c413819c9af0cd61220159901232af39fec40d9f5743c6059068cd98cc",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:a51584efa1ba47bed3b2f5c3",
      "source_batch": 131,
      "entry_index": 43,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1148"
      ],
      "key": null,
      "source_text": "现在，宛如遥远银河的交响乐响彻。\\n为了夺回黑暗中的星光，像彗星一样奔跑吧“宇宙赛马娘”。",
      "source_fingerprint": "80e1ba8491691ca9c22a9b7ae606c10942d2c580e49ef6953cc0b812b9c44a18",
      "current_text": "Giờ đây, bản giao hưởng tựa dải ngân hà xa xôi vang vọng.\\nĐể giành lại ánh sao trong bóng tối, hãy lao đi như sao chổi — “Uma Musume vũ trụ”.",
      "current_fingerprint": "92ee64d53a909f3e0da25c6eff8d2df09078bdcb0d9e1db935a67bf4b3726dbe",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:793a6e0cbb94992e21be3fa0",
      "source_batch": 131,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1149"
      ],
      "key": null,
      "source_text": "去皮OK！火候刚好！营养满分！你猜隐藏的调味是什么？\\n美味做好啦！来，快来多吃点美食吧！",
      "source_fingerprint": "e5c33de202c05eb96633a32558c1a22fa62aaa06263c8f7eed9ac2d89cd09768",
      "current_text": "Gọt vỏ OK! Lửa vừa đẹp! Dinh dưỡng tròn điểm! Đố bạn gia vị bí mật là gì?\\nMón ngon hoàn thành rồi! Nào, mau ăn thật nhiều nhé!",
      "current_fingerprint": "2f97c3d6cb7ab9c4769f2c3d3c168fd10214bcab239ac75bf379330e88d6f422",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:eeb2bf3876feca013460fbdd",
      "source_batch": 131,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1150"
      ],
      "key": null,
      "source_text": "点缀四周年的 FORCE——那就是挑战之心！\\n从这里，属于你们时代的大门将开启！",
      "source_fingerprint": "1493701da3b2ea40656beb21d0a7b53ed22512b809f6c1111946c38c1ede9720",
      "current_text": "FORCE tô điểm kỷ niệm 4 năm — chính là tinh thần thách thức!\\nTừ đây, cánh cửa dẫn tới thời đại của các bạn sẽ mở ra!",
      "current_fingerprint": "1b47a927de3221f27247dfae1bb901a97bf433a16401accf8e2f79194fccbce0",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:aff58590375a5f5bcabd374a",
      "source_batch": 131,
      "entry_index": 46,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1151"
      ],
      "key": null,
      "source_text": "向在这个时代出生的所有人宣告——\\n来吧，放声欢呼吧。你也将成为『传奇』的暴风眼！",
      "source_fingerprint": "02caca1d260628edd3a280446bef6a05390872387f615ae8f3c87ce7d8848be9",
      "current_text": "Xin tuyên bố với tất cả những ai sinh ra trong thời đại này —\\nNào, hãy reo hò thật lớn. Bạn cũng sẽ trở thành tâm bão của “huyền thoại”!",
      "current_fingerprint": "aaf1bcb99a63ec5b2007b7e6676fc782c5499805d3efc27fcae3d61a647a923e",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch"
      ],
      "risk_score": 11,
      "locked_terms": [
        {
          "id": "character.gran_alegria",
          "target_vi": "Gran Alegria",
          "matched_aliases": [
            "放声欢呼"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:e8b5ea5142ba89553407b5a9",
      "source_batch": 131,
      "entry_index": 47,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1152"
      ],
      "key": null,
      "source_text": "海里的美味、河里的美味，全都来吧～☆人生就是要尽情享受\\n翻滚吧！带着鲑鱼般的好运，精彩地GO GO！",
      "source_fingerprint": "17cb8700fb13790b53d608e825b2e2744facdb84c869cf12f5a3e0fe48fa758e",
      "current_text": "Món ngon từ biển, món ngon từ sông, mang hết tới đây nào～☆ Đời là phải tận hưởng hết mình\\nLăn thôi! Mang theo vận may như cá hồi, thật hoành tráng GO GO!",
      "current_fingerprint": "34df2fc6f01291918a0213b13a182fc2a0a6c44ca73794a4d96f8b3f1bb9b441",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:ee49875f7361a24cb11fcee8",
      "source_batch": 131,
      "entry_index": 48,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1154"
      ],
      "key": null,
      "source_text": "你踏入的是自然丰富的特雷森岛！\\n这里只有大自然，这首曲子——还有肌肉！",
      "source_fingerprint": "829e1218cced757d57b4fb1e8634bb20b2af3a448a5a5d5877040857a79043cb",
      "current_text": "Nơi bạn vừa đặt chân tới là đảo Tracen tràn ngập thiên nhiên!\\nỞ đây chỉ có đại tự nhiên, bản nhạc này — và cơ bắp!",
      "current_fingerprint": "3e530618c3ae95f6f9771293df59bf713cd630e5a4bfed9ac4b393359458de1a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:d4453572a1822497a08adb7d",
      "source_batch": 131,
      "entry_index": 49,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1155"
      ],
      "key": null,
      "source_text": "向着追寻已久的蹄印前方。\\n此刻，迈出步伐——将寄托的梦想负于肩上。",
      "source_fingerprint": "34aa15630d44655ef8fc31148c729a0e8e38551632ec9b67f98b3f34b9efef61",
      "current_text": "Hướng về phía trước của dấu móng đã theo đuổi bấy lâu.\\nGiờ đây, bước chân lên — mang giấc mơ được gửi gắm trên vai.",
      "current_fingerprint": "29c0a6c6dee2cafc6b1e1489f946a2f52bdeb7ded0bfce3c2b30d0b92d400afa",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:0f71c3b5387e29c77cc5ebeb",
      "source_batch": 131,
      "entry_index": 50,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1156"
      ],
      "key": null,
      "source_text": "托大家的福——『已经变得这么大啦♡』\\n满载爱的感谢献给你♡请从你喜欢的地方欣赏吧♪",
      "source_fingerprint": "9389e9191ca86fe128e63a10d6e29a0c52b3432dcb5213a9e9b710e0fb8e0ab2",
      "current_text": "Nhờ mọi người — “đã lớn đến thế này rồi nè♡”\\nGửi tới bạn lời cảm ơn ngập tràn yêu thương♡ Hãy ngắm từ góc bạn thích nhé♪",
      "current_fingerprint": "ec9027b069c45155a19eb2948b79ca77f6c2dce3e165faaa186413284f8daf87",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:7587cfed32520cc283a11d62",
      "source_batch": 131,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1157"
      ],
      "key": null,
      "source_text": "那日的记忆在蒸汽般飘荡，令人难忘，但又模糊不清……\\n请听「汤驹浪漫纯情派」。",
      "source_fingerprint": "446387d745bfbc15d2f1ac23bfa9ce9f3fc48fbfa0afa6e02568744f72736c7b",
      "current_text": "Ký ức ngày ấy bồng bềnh như hơi nước, khó quên mà lại mơ hồ…\\nXin mời lắng nghe “Khúc lãng mạn thuần tình của Ngựa Suối Nóng”.",
      "current_fingerprint": "64c2fa667b0a80cb40ac3600a5b1036ee482aa65d36da30d0dd3de717feaca63",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:1253faff0e7e470310794531",
      "source_batch": 131,
      "entry_index": 52,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1158"
      ],
      "key": null,
      "source_text": "踢飞无聊的夜晚，这是『BoC'z we＼n』的最新单曲。\\n铭刻下、交错融合的 AM×i／OK→U／CΛ2 的 flow 吧——！",
      "source_fingerprint": "869ced8d6ed0b1e8eb4ca06435493e58cd94b9eb34244120058350f5e9a9d6c4",
      "current_text": "Đá bay màn đêm nhàm chán — single mới nhất của “BoC'z we＼n”.\\nHãy khắc ghi flow AM×i／OK→U／CΛ2 đan xen hòa quyện này —!",
      "current_fingerprint": "fccc093caf7c5ba3392ba2e52920752d8ee85eb4e35547b33e4e008ee7b577ea",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:5b6d07328fa9c06ac1e2b2bd",
      "source_batch": 131,
      "entry_index": 53,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1159"
      ],
      "key": null,
      "source_text": "常识被一脚踢开，灰烬在大地上刻下痕迹。\\n坠入吧，向着黑白的世界——",
      "source_fingerprint": "dd63e8cb348f417b0790aa1d7a0f29f22cd9e48dc77937f1f48dd177dbce2bf2",
      "current_text": "Thường thức bị đá văng, tro tàn khắc dấu lên mặt đất.\\nHãy rơi xuống — hướng tới thế giới đen trắng —",
      "current_fingerprint": "b0ec4bdc5a09c5bd0aae55e5b24ed75011737492eae05a9046dd613c81a48ea0",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:2a2708518f7030d3b08f221d",
      "source_batch": 131,
      "entry_index": 54,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1160"
      ],
      "key": null,
      "source_text": "喧哗上等！放马过来！有这首歌的话绝对不会输！\\n把你们全部都弄得头冒金星！……这就是充满如此气概的灵魂之曲！",
      "source_fingerprint": "126e6e92def6be6adb0f4a1f40f084f4d135c95f25e616c0357ed4333ec61ad8",
      "current_text": "Muốn gây sự thì cứ tới! Có bài hát này thì tuyệt đối không thua!\\nCho tất cả các ngươi hoa mắt chóng mặt! …Đây chính là khúc ca linh hồn tràn đầy khí thế như thế!",
      "current_fingerprint": "c14de7618a7c85e791802ac598231d329b15c41f386f1607edc7ca34e8fb5d57",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:3a69ca3c67cd5df11f121121",
      "source_batch": 131,
      "entry_index": 55,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1161"
      ],
      "key": null,
      "source_text": "正在寻找未知的“某物”——为了触动心灵深处。\\n那么，今天要度过怎样的一天呢？一边听这首歌一边思考吧！",
      "source_fingerprint": "e5a8700d4892614cc7c8bded3bef4e414d92959597513a7e90fb0c5a36a2458d",
      "current_text": "Đang tìm kiếm một “thứ gì đó” chưa biết — để lay động nơi sâu thẳm trong tim.\\nVậy hôm nay sẽ trải qua một ngày thế nào? Vừa nghe bài này vừa nghĩ thử nhé!",
      "current_fingerprint": "1699cf3e410941840749fb3c36e6584a68cada39113293d6e637b72b63f77f31",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:b4e07d4aebcbf0bf95c9f45b",
      "source_batch": 131,
      "entry_index": 56,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1162"
      ],
      "key": null,
      "source_text": "那段时光里不变的热血梦想，凝聚成这一曲。定能传递给每一个人！\\n脚下的大地虽不同，但仰望的星空却是同一片！",
      "source_fingerprint": "9845ef97d776adf87dd40f76e9b6ee1188fb6035462e0dea20b3613624b058db",
      "current_text": "Giấc mơ cháy bỏng không đổi của những tháng ngày ấy được kết tinh thành khúc ca này. Nhất định sẽ truyền tới mọi người!\\nMặt đất dưới chân có thể khác nhau, nhưng bầu trời sao ngước nhìn vẫn là một!",
      "current_fingerprint": "4462e250c3000dcdd4a179240e62e1ee265dcba2fc979437e0d31299d3790358",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:0fc4904b85075c945c5aaf61",
      "source_batch": 131,
      "entry_index": 57,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1163"
      ],
      "key": null,
      "source_text": "刻骨铭心，一生都无法消逝的景色————\\n“爱”往往就是如此之物。",
      "source_fingerprint": "0fcbfc73cec9fa3f54b824d22c4bfc97f30b07cc6154e5640fda22f8a9b4633d",
      "current_text": "Khung cảnh khắc cốt ghi tâm, suốt đời không thể phai mờ ————\\n“Yêu” thường chính là một thứ như thế.",
      "current_fingerprint": "2d0e897c9c3b144ad6f5d532ed016b2465eebda40a9c1810b06f0dbcc08f0a88",
      "risk_flags": [
        "very_long_target"
