  "review_generation": "retrospective-canonical-full-review",
  "items": [
    {
      "uid": "zhcn:fe0df75d38c708d2c28e6292",
      "source_batch": 221,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1118"
      ],
      "key": null,
      "source_text": "我是爱慕律动。\\n甜美和温柔，对我来说都没有必要。\\n我只想提升自己……仅此而已。",
      "source_fingerprint": "29c53170539fc3b665653688cbde7e15cd1132f024e168a574da0a957935fe5a",
      "current_text": "Tôi là Admire Groove.\\nSự ngọt ngào hay dịu dàng đều không cần thiết với tôi.\\nTôi chỉ muốn hoàn thiện bản thân... chỉ vậy thôi.",
      "current_fingerprint": "cd85679b4b7d16777c96b509fd3ddbc27d189d7c8e955970a8c50a33bb57c2c4",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.admire_groove",
          "target_vi": "Admire Groove",
          "matched_aliases": [
            "爱慕律动"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:06e1af24f54b0f40b46f1f1f",
      "source_batch": 221,
      "entry_index": 1,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1119"
      ],
      "key": null,
      "source_text": "要是想商量有关远征的问题，可以找我梦之旅……\\n就让我们一起踏上梦幻般的旅途吧。\\n在我看来你配得上拥有",
      "source_fingerprint": "862cfe05ee453c25350696b7431d935b1bdf4151d72375a02aa21503f220afa9",
      "current_text": "Nếu muốn trao đổi về chuyện viễn chinh, cứ tìm tôi, Dream Journey...\\nHãy cùng nhau lên đường trong một chuyến đi như mơ.\\nTheo tôi, bạn xứng đáng có được",
      "current_fingerprint": "2d98b3d0d2ee5deaca42967005cd5568b7655f678727621f06a4bbe4f5bbffeb",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.dream_journey",
          "target_vi": "Dream Journey",
          "matched_aliases": [
            "梦之旅"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:ea220398c6cd4ab19d2ec99d",
      "source_batch": 221,
      "entry_index": 2,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1120"
      ],
      "key": null,
      "source_text": "金镇之光。\\n梦想是刷新最高速。喜欢直线。\\n完毕。自我介绍我也要最快",
      "source_fingerprint": "8f5bf8809ba50ff731be5f225bea8e8f819293c675d2798d67e473ffcebb0906",
      "current_text": "Calstone Light O.\\nƯớc mơ là phá kỷ lục tốc độ tối đa. Tôi thích đường thẳng.\\nHết. Cả phần tự giới thiệu tôi cũng phải nhanh nhất",
      "current_fingerprint": "0d2952c1531d536e118abba25e29fd931ad1c50d5053edb6c85bbd1683bc8581",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.calstone_light_o",
          "target_vi": "Calstone Light O",
          "matched_aliases": [
            "金镇之光"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:e178ef0faae33989b1fd2d05",
      "source_batch": 221,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1121"
      ],
      "key": null,
      "source_text": "我的圣剑将散发疾速的光辉，\\n斩除一切不忠于您的黑暗！\\n我是多旺达，维护誓言与忠义的骑士！",
      "source_fingerprint": "1557cedf1b9a2fc8edda9bbdbcb016e3776d2427242ab3d150b4c64b573ad86a",
      "current_text": "Thánh kiếm của tôi sẽ tỏa ánh sáng thần tốc,\\nchém tan mọi bóng tối bất trung với ngài!\\nTôi là Durandal, hiệp sĩ gìn giữ lời thề và lòng trung nghĩa!",
      "current_fingerprint": "db475a946ada7c66bb42203d4a0b23e14e5c2bf19945fbcd5d3e4f104faabadb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.durandal",
          "target_vi": "Durandal",
          "matched_aliases": [
            "多旺达"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:bbfddbe42484bdee3304606c",
      "source_batch": 221,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1124"
      ],
      "key": null,
      "source_text": "我有一项宣言。『身为冲锋队长，\\n我要掀起属于四天王的旋风！』\\n我们一起，让梦想膨胀起来吧！",
      "source_fingerprint": "68931b368e7efec87a936ec9f57c0c5105664ed1a9b017f6272487dc769ed095",
      "current_text": "Tôi có một lời tuyên bố. 『Với tư cách đội trưởng xung phong,\\ntôi sẽ thổi bùng cơn lốc của Tứ Thiên Vương!』\\nCùng nhau khiến ước mơ lớn lên nào!",
      "current_fingerprint": "0054ace3b679b77c14189789872c16ea9bd8c8c8dc4792625e8f7407a06817ad",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:1f4874e8e31a53efb35680af",
      "source_batch": 221,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1126"
      ],
      "key": null,
      "source_text": "我是樱花千岁王。……哦呀，您的脸色？\\n可以的话，不妨调整一下饮食吧。\\n气血水的调和，正是每日活力的源泉",
      "source_fingerprint": "1d74aa6d3ef05aca2c22a0715e1d354de0be9b29418ce828674d68dfe02bec45",
      "current_text": "Tôi là Sakura Chitose O. ...Ồ, sắc mặt của ngài?\\nNếu có thể, sao không thử điều chỉnh chế độ ăn nhỉ.\\nSự điều hòa khí, huyết và thủy chính là nguồn sinh lực mỗi ngày",
      "current_fingerprint": "840823b9f3c5ce8bde8a5315550e57b7605f883a03d9863d03b14f7980ee1aa0",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.sakura_chitose_o",
          "target_vi": "Sakura Chitose O",
          "matched_aliases": [
            "樱花千岁王"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:43c722d7a925fd3b9f17bb9c",
      "source_batch": 221,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1127"
      ],
      "key": null,
      "source_text": "哈！本官是超常骏骥，\\n中央特雷森学园所属！\\n为做孩子们的榜样，我愿粉身碎骨！",
      "source_fingerprint": "5db8e9eec92a8850187f6b5273b5c5a0172120da0ea38d94b95d01ab3b6068d3",
      "current_text": "Ha! Bổn quan là Fenomeno,\\nthuộc Học viện Tracen Trung ương!\\nĐể làm gương cho các em nhỏ, tôi nguyện dốc hết sức mình!",
      "current_fingerprint": "cba538f31c00e83f4e22c8cbdfe94c5071b8cbf0ac380144203e8c3af8adbaea",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.tracen",
          "target_vi": "Học viện Tracen",
          "matched_aliases": [
            "特雷森学园"
          ],
          "present": true
        },
        {
          "id": "character.fenomeno",
          "target_vi": "Fenomeno",
          "matched_aliases": [
            "超常骏骥"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:1d608bb64d108eb04dd81ddb",
      "source_batch": 221,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1128"
      ],
      "key": null,
      "source_text": "我是防爆装束哦！\\n人类很温柔，所以我最最最喜欢了！\\n很想多多接触，和大家友好相处！！",
      "source_fingerprint": "98373807ad2c607ecf1225ad4e88eb0a0f7e4e61da7a42e191cda01a3ff49785",
      "current_text": "Tôi là Blast Onepiece!\\nCon người rất dịu dàng, nên tôi thích thích thích nhất luôn!\\nTôi muốn được tiếp xúc thật nhiều và thân thiết với mọi người!!",
      "current_fingerprint": "7482ac05aafc043b6b0afa2ff39e88c55f668422d0b8e9f8f5ce6972e2c41802",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.blast_onepiece",
          "target_vi": "Blast Onepiece",
          "matched_aliases": [
            "防爆装束"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:5d492c43375fc344825616b3",
      "source_batch": 221,
      "entry_index": 8,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1129"
      ],
      "key": null,
      "source_text": "我是杏目。\\n就算对手是传奇，我也要获胜。\\n不是别人，而是自己，我始终如此坚信！",
      "source_fingerprint": "0aa1a65fafc7655aa79283dd93ec5bde6590d45c307b65c82a64de280bc31f2a",
      "current_text": "Tôi là Almond Eye.\\nDù đối thủ là huyền thoại, tôi vẫn sẽ chiến thắng.\\nKhông phải ai khác, mà là chính mình — tôi luôn tin như vậy!",
      "current_fingerprint": "37a61191116535017980a7776683ba975b463eb2e50ed20c6ca47568a76d250a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.almond_eye",
          "target_vi": "Almond Eye",
          "matched_aliases": [
            "杏目"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:6ae635d405fe877a9c17e375",
      "source_batch": 221,
      "entry_index": 9,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1130"
      ],
      "key": null,
      "source_text": "我是旺紫丁。\\n以草地之星为目标，任何考验都能忍受。\\n请多指教。",
      "source_fingerprint": "cff50997df1d1c5ac1765dfc49fa3c53f05740202ba76697c3e6f53d00595a62",
      "current_text": "Tôi là Lucky Lilac.\\nNhắm tới ngôi sao sân cỏ, thử thách nào tôi cũng chịu được.\\nMong được chỉ giáo.",
      "current_fingerprint": "9f5bfd3f08ed510e12b462520ecec1f51c6451b676aa075e1962ed725577b4c5",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [
        {
          "id": "character.lucky_lilac",
          "target_vi": "Lucky Lilac",
          "matched_aliases": [
            "旺紫丁"
          ],
          "present": true
        }
      ],
      "community_terms": [
        {
          "id": "common.surface.turf",
          "preferred": "Turf",
          "accepted": [
            "Turf"
          ],
          "forbidden": [
            "Sân cỏ"
          ],
          "matched_aliases": [
            "草地"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "Common EN-version surface label."
        }
      ],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:ec34efee253c4a588e4612c5",
      "source_batch": 221,
      "entry_index": 10,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1131"
      ],
      "key": null,
      "source_text": "在，我是放声欢呼！\\n0.75英里也好，1.25英里也好\\n未来的英里女王都不会输！",
      "source_fingerprint": "4201f4f47cfa0e0412d4d1c46dd04e017738dcc95e78eb707872570a0bf0dea7",
      "current_text": "Vâng, tôi là Gran Alegria!\\nDù 0,75 dặm hay 1,25 dặm,\\nnữ hoàng đường mile tương lai cũng sẽ không thua!",
      "current_fingerprint": "454bac4109d91be81f33c41ebd184400a64996db5ef39be54937991881242bec",
      "risk_flags": [
        "community_term"
      ],
      "risk_score": 2,
      "locked_terms": [
        {
          "id": "character.gran_alegria",
          "target_vi": "Gran Alegria",
          "matched_aliases": [
            "放声欢呼"
          ],
          "present": true
        }
      ],
      "community_terms": [
        {
          "id": "common.distance.mile",
          "preferred": "Mile",
          "accepted": [
            "Mile"
          ],
          "forbidden": [],
          "matched_aliases": [
            "英里"
          ],
          "accepted_present": true,
          "forbidden_present": false,
          "require_accepted": true,
          "basis": "Common EN-version distance class."
        }
      ],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:26ae10eec304faab74f1fc29",
      "source_batch": 221,
      "entry_index": 11,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1132"
      ],
      "key": null,
      "source_text": "我是唯独爱你♪\\n我的爱【Love】不是单向而是双向的！\\n让我们用直播把它传播到世界各地吧♡",
      "source_fingerprint": "7fd473f7738452d42e02515fb4ac513eff55426c1ae9b7fdf1a5bf9043546956",
      "current_text": "Tôi là Loves Only You♪\\nTình yêu【Love】của tôi không phải một chiều mà là hai chiều!\\nHãy dùng livestream để lan tỏa nó khắp thế giới nhé♡",
      "current_fingerprint": "6fda27334cd4627720b57392e69e0b6b6dbf1d96b21dc85b3fff66c3e5cffe02",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:10cb3fb3dfbf3b301d902c02",
      "source_batch": 221,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1133"
      ],
      "key": null,
      "source_text": "我是创世驹。\\n喜欢探究赛跑史……\\n想要在历史上刻下自己的足迹。",
      "source_fingerprint": "99832f6ccba1b8037d63480ade81bd3a49109066a7fcac301063ea6c6ec0c78a",
      "current_text": "Tôi là Chrono Genesis.\\nTôi thích nghiên cứu lịch sử đua ngựa...\\nVà muốn khắc dấu chân của mình vào lịch sử.",
      "current_fingerprint": "24e3eb0eb7682b6b9d84cd316b03cc259e4b5dabdb575144239f77f18374434d",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.chrono_genesis",
          "target_vi": "Chrono Genesis",
          "matched_aliases": [
            "创世驹"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:8da203447281521ea6eaa8b8",
      "source_batch": 221,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1134"
      ],
      "key": null,
      "source_text": "我是机伶金花。喜欢的东西是\\n把花儿漂亮地装饰起来。还有，我想想啊……\\n争斗之类的——我不太擅长呢",
      "source_fingerprint": "0c18dc4a8ff6a07cfb1f50e700048168807eba0512ff5bc88a8890d6396a4b84",
      "current_text": "Tôi là Curren Bouquetd'or. Điều tôi thích là\\ntrang trí hoa thật đẹp. Còn nữa, để xem nào...\\nNhững chuyện như tranh đấu — tôi không giỏi lắm.",
      "current_fingerprint": "e1674251f262cf80cdfddde92b9dc501030684cead3fff8faba07d21aacf49cb",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.curren_bouquetdor",
          "target_vi": "Curren Bouquetd'or",
          "matched_aliases": [
            "机伶金花"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:587c204dd87e93a9dacdbf52",
      "source_batch": 221,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1135"
      ],
      "key": null,
      "source_text": "请多关照，我是黄金旅程。\\n来吧，让我们享受一段愉快的旅程！\\n随心所欲地踏上黄金之旅吧",
      "source_fingerprint": "656cb5da1f5cff0104b3a83714a71f773a404658a3b9cf171b613098b03ff379",
      "current_text": "Rất mong được giúp đỡ, tôi là Stay Gold.\\nNào, cùng tận hưởng một chuyến đi vui vẻ nhé!\\nCứ tự do lên đường trên hành trình vàng thôi.",
      "current_fingerprint": "746773cd38361f18e9aaa47588561174e2f7084dec4501f528efc42684c3359f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.stay_gold",
          "target_vi": "Stay Gold",
          "matched_aliases": [
            "黄金旅程"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:69faf7dd543501531eea9fdb",
      "source_batch": 221,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1136"
      ],
      "key": null,
