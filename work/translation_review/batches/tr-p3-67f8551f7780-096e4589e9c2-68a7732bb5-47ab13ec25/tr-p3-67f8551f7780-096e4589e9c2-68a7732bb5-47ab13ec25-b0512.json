      ],
      "key": null,
      "source_text": "随着秋川理事长宣布开放农田，\\n特雷森学园的大农耕时代开始了。\\n烈日之下，大家一起挥动锄头；\\n日落时分，众人共同围坐餐桌。\\n来吧，今天我们也去种田吧――！",
      "source_fingerprint": "4245a5126f8c425e43eaf92edffb045cada30eadc262e4be7f8c909cc6124faf",
      "current_text": "Cùng tuyên bố mở đất nông nghiệp của Chủ tịch Akikawa,\\nkỷ nguyên đại canh tác của Học viện Tracen bắt đầu.\\nDưới nắng gắt, mọi người cùng vung cuốc;\\nkhi mặt trời lặn, tất cả quây quần bên bàn ăn.\\nNào, hôm nay cũng đi trồng trọt thôi――!",
      "current_fingerprint": "122dd72bc05b6157ed231386cd2f1833256840f26a534accdef34ba033b53fc1",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.tracen",
          "target_vi": "Học viện Tracen",
          "matched_aliases": [
            "特雷森学园"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:ba7ad93c7255a7ea392ca365",
      "source_batch": 129,
      "entry_index": 59,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "120",
        "9"
      ],
      "key": null,
      "source_text": "特雷森学园中出现了机械赛马娘。\\n那是由天才博士砂糖光制作的机器人。\\n不过它还是初始型号，仍有许多问题……\\n让我们去强化它，来实现博士的梦想吧！",
      "source_fingerprint": "03568a8ece876de23aa2714308de226c4289f3902cf6aa19bee1a7101bca37a3",
      "current_text": "Một Mecha Uma Musume xuất hiện tại Học viện Tracen.\\nĐó là robot do thiên tài tiến sĩ Sugar Lights chế tạo.\\nNhưng nó vẫn là mẫu thử ban đầu và còn nhiều vấn đề...\\nHãy tăng cường nó để biến giấc mơ của tiến sĩ thành hiện thực!",
      "current_fingerprint": "dc72ab0078ed5544643c2c41244992ca22e5e72f645cc7d412d434e72fcc034a",
      "risk_flags": [
        "very_long_target",
        "community_term",
