    {
      "uid": "zhcn:669639e3259b83e521ee782a",
      "source_batch": 132,
      "entry_index": 1,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1188"
      ],
      "key": null,
      "source_text": "在“永恒”之中，闪耀的一曲。\\n距离实现曾与你许下的约定，只差一步之遥……。",
      "source_fingerprint": "c16dd18b1aaa2624ecb33d5f6535fb8afea22446a23f81186ea6f109223925a4",
      "current_text": "Một khúc nhạc tỏa sáng giữa “vĩnh hằng”.\\nChỉ còn một bước nữa là thực hiện được lời hứa năm nào với bạn…….",
      "current_fingerprint": "c0ba02ff2843feee8ef1936d67f6ac171bfcf809aa65678f057d7a9fd1ce484f",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:7a00c6870d60b8d30cfad059",
      "source_batch": 132,
      "entry_index": 2,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1189"
      ],
      "key": null,
      "source_text": "无数深深刻下的蹄印。它们终将编织出历史——\\n正因如此，我也要前行。因为这足迹，将通往创世。",
      "source_fingerprint": "f979a6b3ee4abda7c414ae0701e397b566c12e331611655d2b198d8eb7ade4df",
      "current_text": "Vô số dấu móng in sâu. Rồi chúng sẽ dệt nên lịch sử—\\nChính vì thế, tôi cũng sẽ tiến bước. Bởi dấu chân này sẽ dẫn tới buổi sáng thế.",
      "current_fingerprint": "9e779222117c1c05a7dbadf2bee93b5b4eaeaf5f6b6cd693be52726eebdb4513",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
