    {
      "uid": "zhcn:8aafe15d2df6fdfd97742c4a",
      "source_batch": 132,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1194"
      ],
      "key": null,
      "source_text": "做好觉悟吧。只要听过一次，\\n就会烙印在耳膜与灵魂深处，挥之不去的黄金旋律。",
      "source_fingerprint": "620f5fa19ff1345168acb8061fb065806157800c0edd889f0198b2ed8abd816f",
      "current_text": "Hãy chuẩn bị tinh thần. Chỉ cần nghe một lần,\\ngiai điệu vàng ấy sẽ khắc sâu vào màng nhĩ và tận sâu linh hồn, chẳng thể phai mờ.",
      "current_fingerprint": "fe79674bbdab0cc746f52dda025a2519c828024e1eb21f812ae6bc40aeb4ac31",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:0dc41793eb087de97f115375",
      "source_batch": 132,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1200"
      ],
      "key": null,
      "source_text": "呐，今晚也要互诉心声吗？我们要传达的可是彼此的爱。\\n打开社区的大门——就是Love me♡Love you♡哦♡",
      "source_fingerprint": "4eb6834dc87892265787d83a03e5093e067978927759489246e65b0dacb554f6",
      "current_text": "Này, tối nay chúng ta lại thổ lộ lòng mình nhé? Điều muốn gửi tới nhau chính là tình yêu.\\nMở cánh cửa cộng đồng—chính là Love me♡Love you♡ đó♡",
      "current_fingerprint": "5169586a2da5d06f14d7a080687c29d5c190b5d6892854caf28a46c6d8deb214",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:51ab7d697ef6ed2a84a96f6b",
      "source_batch": 132,
      "entry_index": 8,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1201"
      ],
      "key": null,
      "source_text": "所需要的，是一点点勇气。即使害怕，只要描绘出来就一定会改变。\\n因为不想只停留在想象中——就迈出脚步吧，趁现在！",
      "source_fingerprint": "7ba97c4f5a9e7a4211f229648fa6054a5b58ff5e4d968c9765d561ff152ab3b6",
      "current_text": "Điều cần có chỉ là một chút dũng khí. Dù sợ hãi, chỉ cần vẽ nên nó thì chắc chắn sẽ thay đổi.\\nVì không muốn mãi chỉ nằm trong tưởng tượng—hãy bước đi, ngay lúc này!",
      "current_fingerprint": "e74be66e5240b2e898e77bd5f04bb4fd69f03d90f36b27e84b2daa56aa976096",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:00caaf81ef1bfdc530de2be7",
      "source_batch": 132,
      "entry_index": 9,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1202"
      ],
      "key": null,
      "source_text": "呜呼哦哦哦！尊爆赛马娘酱的坑来啦━(ﾟ∀ﾟ)━！！\\n感谢与推相遇的奇迹！祈求全推幸福世界最尊！！！",
      "source_fingerprint": "6d4174052e79016932d7dd7b0f63ac278b2904480a2322a4894775e102ddb2ba",
      "current_text": "Uooooo! Hố Uma Musume-chan siêu tôn quý tới rồi━(ﾟ∀ﾟ)━!!\\nCảm tạ kỳ tích được gặp oshi! Cầu mong tất cả oshi hạnh phúc, tôn quý nhất thế gian!!!",
      "current_fingerprint": "f9fd9e3c1a46c3d162a9157de0ce725445697521679acecb78deac5f61a0a61e",
      "risk_flags": [
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 16,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.world.umamusume",
