    {
      "uid": "zhcn:fdbe180fe7755e28db53c660",
      "source_batch": 132,
      "entry_index": 10,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1203"
      ],
      "key": null,
      "source_text": "请，轻轻地牵起彼此的手。因为那份温暖，会化作\\n思念的圆环——为了能传达到所有孤独之人的心中，倾注祈愿。",
      "source_fingerprint": "f6a4f61df378b5f4621ca2073fe7e36dcd375b5b99f736ad896590df45b3fb22",
      "current_text": "Xin hãy nhẹ nhàng nắm lấy tay nhau. Bởi hơi ấm ấy sẽ hóa thành\\nvòng tròn của những tâm tư—gửi trọn lời nguyện cầu để chạm tới trái tim của mọi người cô đơn.",
      "current_fingerprint": "5dd46ee4b1d41624d8d197c03e6988f6cf287714cf629010c49a93b4672becdd",
      "risk_flags": [
        "very_long_target"
      ],
