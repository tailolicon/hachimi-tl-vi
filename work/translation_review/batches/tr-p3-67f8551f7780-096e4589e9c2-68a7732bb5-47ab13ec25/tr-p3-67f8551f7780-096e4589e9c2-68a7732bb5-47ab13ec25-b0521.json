      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:3e5c0ffaae0244dfe287bf58",
      "source_batch": 132,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1208"
      ],
      "key": null,
      "source_text": "在怀旧的旋律中，回想起的是黄金般的心象。\\n自由的旅人未曾停下脚步——无论谁，都会对那段旅途心怀梦想。",
      "source_fingerprint": "faca9261ad3069a4d790ff629f2d61360662f3d1ad256b8c73250134dca73570",
      "current_text": "Giữa giai điệu hoài niệm, hiện về là cảnh tượng trong tim tựa sắc vàng.\\nLữ khách tự do chưa từng dừng bước—bất kỳ ai cũng sẽ ôm mộng về hành trình ấy.",
      "current_fingerprint": "8ba13c20c40aa695a5b52e6c37c62acafcf1119e63e2b1e57590842d19d77afd",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:c8b1bda58646dbca4f82be52",
      "source_batch": 132,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1209"
      ],
      "key": null,
      "source_text": "要想夺取顶点就绝不妥协。顺从本能，将其粉碎吧！\\n咆哮吧——刻印在新时代之上，那才是最强的证明！",
      "source_fingerprint": "bf1934605b6aee88cd9af2df4c3b44828d688d3310f1eea48072858f27e329cd",
      "current_text": "Muốn đoạt lấy đỉnh cao thì tuyệt đối không thỏa hiệp. Hãy thuận theo bản năng và nghiền nát tất cả!\\nGầm vang lên—khắc dấu vào thời đại mới, đó mới là minh chứng của kẻ mạnh nhất!",
      "current_fingerprint": "69c289286c18745a4adf15c55fae774ba44527820bb884f5f0e1ac40397bbd7d",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
