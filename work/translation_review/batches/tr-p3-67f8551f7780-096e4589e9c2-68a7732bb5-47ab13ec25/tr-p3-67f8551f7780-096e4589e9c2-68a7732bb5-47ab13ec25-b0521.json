    {
      "uid": "zhcn:fc08dd262784c96efb2d49f9",
      "source_batch": 132,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1205"
      ],
      "key": null,
      "source_text": "伴随着直指顶点的热情节拍，狂热度达到最高潮！\\n来吧，去超越极限，为了在全新的舞台上闪耀！",
      "source_fingerprint": "9ff127602f78156f3dbde7f7f36ae691730f811706be800bc488c0564a1eb9cd",
      "current_text": "Nhịp điệu nhiệt huyết hướng thẳng tới đỉnh cao đưa sự cuồng nhiệt lên cực điểm!\\nNào, hãy vượt qua giới hạn để tỏa sáng trên sân khấu hoàn toàn mới!",
      "current_fingerprint": "c4176fb6d04075a396196d46ffc7061795d0efb0ac4cdcb439b21ddeb58865b1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:21f605c63854c903cd62da6c",
      "source_batch": 132,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1206"
      ],
      "key": null,
      "source_text": "呐，愿意带我走吗？前往我所未知的崭新世界！\\n若这只是泡沫般的片刻——那就如做梦一般，踏上旅途吧♪",
      "source_fingerprint": "d632644e126ffd28fe3e652bd793bf2e39fc1eacbbbe45225b0fc13e5b23ae01",
      "current_text": "Này, bạn có sẵn lòng đưa tôi đi không? Đến một thế giới mới mà tôi chưa từng biết!\\nNếu đây chỉ là khoảnh khắc tựa bọt nước—thì hãy lên đường như đang trong mơ nhé♪",
      "current_fingerprint": "2f52fc52542e8ad2117921188457a1d66e12478123a976c5c4bbbc2800a67635",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:f307f697da4527aeb4ed2e2e",
      "source_batch": 132,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1207"
      ],
      "key": null,
      "source_text": "气氛嗨到爆！情绪拉到满！趴体・Party・fu～♪\\n果然还是辣妹YYDS对吧♪毕竟今天的主角可是我！",
      "source_fingerprint": "4f93468050cbe0a90a6bc6cade0be164a9390fdab7481f3c5eec67b137a92474",
      "current_text": "Không khí quẩy tung nóc! Cảm xúc max level! Pả-ti・Party・fu~♪\\nQuả nhiên gyaru vẫn là đỉnh nhất nhỉ♪ Dù sao nhân vật chính hôm nay chính là tôi!",
      "current_fingerprint": "07a6b9b231553e11c1e54b6facd21c8bf1ddeed5e20cf762a964c221ccf48638",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
