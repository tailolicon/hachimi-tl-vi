    {
      "uid": "zhcn:08981739c2141836ff82ae17",
      "source_batch": 132,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1191"
      ],
      "key": null,
      "source_text": "三姐妹依偎在一起的和声，温柔地抚慰着心灵——\\n让歌声与思念重叠吧。即便道路不同，我们永远相伴。",
      "source_fingerprint": "f9f7c4320d72326928aeb745d027513123f087fcbebe37d79ffeff29b23d3d84",
      "current_text": "Hòa âm của ba chị em tựa vào nhau, dịu dàng xoa dịu tâm hồn—\\nHãy để tiếng hát hòa cùng nỗi niềm. Dẫu đường đi khác nhau, chúng ta mãi bên nhau.",
      "current_fingerprint": "bb26e68cf8136a938b9787f6e44bd05e3eabda8276dbe6e9e99211ea55bd15b8",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:5211f4e063be40a6a9173da2",
      "source_batch": 132,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1192"
      ],
      "key": null,
      "source_text": "寄宿着觉悟的少女们，坚定不移的决心之曲。\\n因为宿敌赋予了我们力量——无论到哪里，都一起前行吧。",
      "source_fingerprint": "dbb53245b325ebfca1516edec8af4086451cfb887970e6ac7601443e18e2185f",
      "current_text": "Khúc nhạc của quyết tâm kiên định, nơi ý chí của những thiếu nữ trú ngụ.\\nBởi kình địch đã trao cho chúng ta sức mạnh—dù đi đâu, hãy cùng nhau tiến bước.",
      "current_fingerprint": "b9a45e59f48f22796af10fd8a41077b5a83cab1a678ea876ad7ac9a84bd40a7d",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
        "absence_risk"
      ],
      "risk_score": 24,
      "locked_terms": [],
      "community_terms": [
        {
