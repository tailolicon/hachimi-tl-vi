        "128",
        "1185"
      ],
      "key": null,
      "source_text": "拜托了♡正因为是你，我才会这么想撒娇。\\n连全世界都会为之着迷的，可爱的流行歌曲！",
      "source_fingerprint": "525912bcfb92b78bbe7a757d8f429cf8d1ba8bc7bda5a94d92455959be5e95c7",
      "current_text": "Làm ơn nhé♡ Chính vì là bạn nên tôi mới muốn làm nũng thế này.\\nMột bài pop dễ thương đến mức cả thế giới cũng phải mê mẩn!",
      "current_fingerprint": "564fb09e6cd82b10a98c6f230d12838cf9068e2855d5963fc0252f8bbec46621",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
