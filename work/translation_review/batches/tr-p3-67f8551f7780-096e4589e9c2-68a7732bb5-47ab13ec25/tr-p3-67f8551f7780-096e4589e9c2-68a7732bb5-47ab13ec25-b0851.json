    {
      "uid": "zhcn:ade79421e119cab849ed4e7a",
      "source_batch": 219,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1029"
      ],
      "key": null,
      "source_text": "我，我叫雪之美人！\\n在闪耀系列赛中大放光彩，成为憧憬的城市女孩\\n这就是我的梦想！呼……好好的说出来了……",
      "source_fingerprint": "fa8c28370c80a47d2dea23ae4fde855e0174e166fe41960bd07e9c160737af9d",
      "current_text": "M-mình là Yukino Bijin!\\nTỏa sáng trong Twinkle Series, trở thành cô gái thành thị mà mình hằng ngưỡng mộ——\\nđó là ước mơ của mình! Phù…… nói ra đàng hoàng rồi……",
      "current_fingerprint": "b611eb10ba0149c19a159bb10da7ceeae618e2d96726182a5d26fedf7445c744",
