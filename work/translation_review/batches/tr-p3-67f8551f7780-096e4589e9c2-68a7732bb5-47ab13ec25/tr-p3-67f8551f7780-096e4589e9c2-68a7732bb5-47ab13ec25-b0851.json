      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1028"
      ],
      "key": null,
      "source_text": "BuonoBuo-no♪我是菱曙～☆\\n无论是料理还是赛跑，我都会将大大的爱情\\n传达给大家！请多关照～♪",
      "source_fingerprint": "9d465656ba4cf122cce89b03c4190c0592ace7674720dce2c8fea51b9cb640a0",
      "current_text": "BuonoBuo-no♪ Mình là Hishi Akebono～☆\\nDù là nấu ăn hay đua, mình đều sẽ gửi tình yêu thật lớn\\nđến mọi người! Mong được giúp đỡ～♪",
      "current_fingerprint": "36dd7170f3ec43941f190b69bbf59d4f6c63ad97a204a4832c9586a5ca4d1fbb",
      "risk_flags": [
        "absence_risk"
