      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1046"
      ],
      "key": null,
      "source_text": "我是醒目飞鹰！请叫我飞鹰子吧！\\n我的梦想是成为马娘偶像！\\n要签名的话一直都欢迎哟☆",
      "source_fingerprint": "0e473a53ae02f72c797ee84d3c60a1a2443557d173b77ed00bfc2ce0ed1f755f",
      "current_text": "Tôi là Smart Falcon! Cứ gọi tôi là Falco nhé!\\nƯớc mơ của tôi là trở thành idol Uma Musume!\\nMuốn xin chữ ký thì lúc nào cũng hoan nghênh☆",
      "current_fingerprint": "11d1772e60fe718163b4aa14b9a6a7660deafc72f153c095af0bb036fbc29f57",
