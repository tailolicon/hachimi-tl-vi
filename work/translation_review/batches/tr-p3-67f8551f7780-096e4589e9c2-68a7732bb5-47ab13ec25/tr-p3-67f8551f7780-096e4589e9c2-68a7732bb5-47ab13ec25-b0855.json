    {
      "uid": "zhcn:cea3f4bcc6cccb938efbec4c",
      "source_batch": 220,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1109"
      ],
      "key": null,
      "source_text": "我是莱茵力量！继承心意，\\n开拓道路，连接未来。\\n我想要成为这样的后冠赛马娘！",
      "source_fingerprint": "0f433e0a7856710be3253311048037c7bd54d650919d612e431aab4a57ac506a",
      "current_text": "Tôi là Rhein Kraft! Kế thừa tâm ý,\\nmở lối đi và kết nối tương lai.\\nTôi muốn trở thành một Uma Musume đội vương miện như thế!",
      "current_fingerprint": "27afc08cf8111525fb90683e8c1e0befafe069b3812399942c9b5b002df6c20a",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
