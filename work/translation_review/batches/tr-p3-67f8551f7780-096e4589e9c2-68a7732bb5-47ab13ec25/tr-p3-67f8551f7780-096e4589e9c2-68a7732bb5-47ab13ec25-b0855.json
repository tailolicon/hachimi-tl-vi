    {
      "uid": "zhcn:50f622d774cbdd8ca09e24f3",
      "source_batch": 220,
      "entry_index": 66,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1104"
      ],
      "key": null,
      "source_text": "我是葛城王牌，请多指教！\\n如果有梦想就不必胆怯了哦？\\n就由我来打破那些制约人的障壁！",
      "source_fingerprint": "093072ff9cbf5f1edf0a9fe9558b0d50ed22782aa34fb4c57132abe35fa3c64a",
      "current_text": "Tôi là Katsuragi Ace, rất mong được giúp đỡ!\\nNếu có ước mơ thì chẳng cần phải rụt rè, đúng không?\\nCứ để tôi phá tan những bức tường trói buộc mọi người!",
      "current_fingerprint": "a9464cecdb986a67d2c99ca0a9dd6120ea3c0652e4de02ea7bc65317b427d8c1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.katsuragi_ace",
          "target_vi": "Katsuragi Ace",
          "matched_aliases": [
            "葛城王牌"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:4ab50fedf6846715335ebf6b",
      "source_batch": 220,
      "entry_index": 67,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1105"
      ],
      "key": null,
      "source_text": "新宇宙我，\\n向你提出友好的“接触”方案。\\n换言之――『请多指教』",
      "source_fingerprint": "7bf4e0391b047cfa89bf2b61584d533e8ccb48e7ded9c2e73db8c6e34cd9290d",
      "current_text": "Tôi, Neo Universe,\\nđề xuất với bạn một kế hoạch “tiếp xúc” hữu nghị.\\nNói cách khác――『rất mong được giúp đỡ』",
      "current_fingerprint": "cde27184a3eeaf1208029fd5c3097272e93d733d2a60e7b6100dd4938f1ca2df",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.neo_universe",
          "target_vi": "Neo Universe",
          "matched_aliases": [
            "新宇宙"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:0fb53c08bad9732f854e67fb",
      "source_batch": 220,
      "entry_index": 68,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1106"
      ],
      "key": null,
      "source_text": "你好，我是菱钻奇宝。说不出理由，不过我\\n感觉不错，如果能尽力就更好了呢，\\n请多指教～",
      "source_fingerprint": "f5b3b1e0059228aa4308f0b3855fff094aac969bf74705b19a6cbaa89de83a0a",
      "current_text": "Xin chào, tôi là Hishi Miracle. Không rõ vì sao, nhưng tôi\\ncảm thấy khá ổn; nếu có thể cố hết sức thì càng tốt nhỉ,\\nrất mong được giúp đỡ～",
      "current_fingerprint": "d24af22f934e7f9309df42cfee6b25614af96e4e3f59742e7c356027b285e65e",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.hishi_miracle",
          "target_vi": "Hishi Miracle",
          "matched_aliases": [
            "菱钻奇宝"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:674fbb866df3af70067a656e",
      "source_batch": 220,
      "entry_index": 69,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1107"
      ],
      "key": null,
      "source_text": "开启振奋人心的旅途吧！同你的好友彻夜起舞吧！\\n想要邂逅梦想的Everyone――\\n搭上属于我跳舞城的船来！",
      "source_fingerprint": "5f1d3bdb60f740625b9c03b7728206fad0ca686562787811f1c9b294dace3332",
      "current_text": "Hãy bắt đầu chuyến đi đầy hứng khởi! Cùng bạn bè nhảy múa thâu đêm!\\nEveryone muốn gặp gỡ ước mơ――\\nhãy bước lên con tàu của tôi, Tap Dance City!",
      "current_fingerprint": "8c15a87b4ad20f60d0321eb311fbcb2447aa544ee955ad6ab2bed5e1b32bfc46",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.tap_dance_city",
          "target_vi": "Tap Dance City",
          "matched_aliases": [
            "跳舞城"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:501a4fefdeab559264c4517d",
      "source_batch": 220,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1108"
      ],
      "key": null,
      "source_text": "……我是大鸣大放。\\n我所追求的不是胜利，而是处于更前方的“最强”。\\n…………就这样",
      "source_fingerprint": "962409a25996c7bca6aeeff65285bc088fe6c4b44d9a5476b89610d00a0d3cd7",
      "current_text": "…Tôi là Duramente.\\nThứ tôi theo đuổi không phải chiến thắng, mà là “mạnh nhất” ở phía xa hơn nữa.\\n…………Chỉ vậy thôi.",
      "current_fingerprint": "f2ac789408a41de38ec149e7952b719f8e1fb48bf0ead15f9fa4f6b42cf2481b",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.duramente",
          "target_vi": "Duramente",
          "matched_aliases": [
            "大鸣大放"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
