      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1102"
      ],
      "key": null,
      "source_text": "噢噢，我爱着的诸位音乐家啊！\\n同我万籁争鸣一起，\\n今天也奏响旋律吧！",
      "source_fingerprint": "c45bb5b7bc570a2c6bb5da85b820c7142843eee99359649a313466842fd947b0",
      "current_text": "Ôi, hỡi những nhạc sĩ ta yêu quý!\\nCùng ta, Sounds of Earth,\\nhôm nay hãy tiếp tục tấu lên giai điệu!",
      "current_fingerprint": "0bd5087f0f7903f067d93bdd459ddbc3327a0f72d478d63f7dbc8886ec1b4109",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.sounds_of_earth",
          "target_vi": "Sounds of Earth",
          "matched_aliases": [
            "万籁争鸣"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
