    {
      "uid": "zhcn:e178ef0faae33989b1fd2d05",
      "source_batch": 221,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1121"
      ],
      "key": null,
      "source_text": "我的圣剑将散发疾速的光辉，\\n斩除一切不忠于您的黑暗！\\n我是多旺达，维护誓言与忠义的骑士！",
      "source_fingerprint": "1557cedf1b9a2fc8edda9bbdbcb016e3776d2427242ab3d150b4c64b573ad86a",
      "current_text": "Thánh kiếm của tôi sẽ tỏa ánh sáng thần tốc,\\nchém tan mọi bóng tối bất trung với ngài!\\nTôi là Durandal, hiệp sĩ gìn giữ lời thề và lòng trung nghĩa!",
      "current_fingerprint": "db475a946ada7c66bb42203d4a0b23e14e5c2bf19945fbcd5d3e4f104faabadb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.durandal",
          "target_vi": "Durandal",
          "matched_aliases": [
            "多旺达"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": "c3eb3c92aed858d0aed2c82b4df6144f8e7e2ff87405643d4e57259c36afa1a7"
    },
    {
      "uid": "zhcn:bbfddbe42484bdee3304606c",
      "source_batch": 221,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1124"
      ],
      "key": null,
      "source_text": "我有一项宣言。『身为冲锋队长，\\n我要掀起属于四天王的旋风！』\\n我们一起，让梦想膨胀起来吧！",
      "source_fingerprint": "68931b368e7efec87a936ec9f57c0c5105664ed1a9b017f6272487dc769ed095",
      "current_text": "Tôi có một lời tuyên bố. 『Với tư cách đội trưởng xung phong,\\ntôi sẽ thổi bùng cơn lốc của Tứ Thiên Vương!』\\nCùng nhau khiến ước mơ lớn lên nào!",
      "current_fingerprint": "0054ace3b679b77c14189789872c16ea9bd8c8c8dc4792625e8f7407a06817ad",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:1f4874e8e31a53efb35680af",
      "source_batch": 221,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1126"
      ],
      "key": null,
      "source_text": "我是樱花千岁王。……哦呀，您的脸色？\\n可以的话，不妨调整一下饮食吧。\\n气血水的调和，正是每日活力的源泉",
      "source_fingerprint": "1d74aa6d3ef05aca2c22a0715e1d354de0be9b29418ce828674d68dfe02bec45",
      "current_text": "Tôi là Sakura Chitose O. ...Ồ, sắc mặt của ngài?\\nNếu có thể, sao không thử điều chỉnh chế độ ăn nhỉ.\\nSự điều hòa khí, huyết và thủy chính là nguồn sinh lực mỗi ngày",
      "current_fingerprint": "840823b9f3c5ce8bde8a5315550e57b7605f883a03d9863d03b14f7980ee1aa0",
      "risk_flags": [
        "very_long_target"
