      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:e681f26329b194f17fb9c11a",
      "source_batch": 130,
      "entry_index": 62,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1086"
      ],
      "key": null,
      "source_text": "如同谎言般酷帅的激昂歌曲，妆点着一年365天。\\n那样的搭档，会成为你的个性。──by「BoC'z」。",
      "source_fingerprint": "0b8dd2464447816c6aa4f35b24ae2f19306bd6f012988e5ada845602f5812dbc",
      "current_text": "Một ca khúc sôi động ngầu đến khó tin, tô điểm cho cả 365 ngày trong năm.\\nMột người bạn đồng hành như thế sẽ trở thành cá tính của bạn. ──by「BoC'z」.",
      "current_fingerprint": "418e9f450730a82fcadcee01d4285e0db19ef43dd632a1cbf80d5c3abdbdb4d7",
      "risk_flags": [
        "numeric_token_mismatch"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:0aea32c1f25ea5facb70c2bb",
      "source_batch": 130,
      "entry_index": 63,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1087"
      ],
      "key": null,
      "source_text": "辣妹赛马娘们统统嗨起来！为了辣妹而存在的歌曲！\\n我们是forever☆最强的赛马娘死党！",
      "source_fingerprint": "136a0208f99d39fb5f47bf336e163676cde7c8ab882f4a76c238405b22af2e4a",
      "current_text": "Các Uma Musume gyaru, quẩy hết mình nào! Một ca khúc sinh ra vì gyaru!\\nChúng ta là forever☆ hội bạn Uma Musume mạnh nhất!",
      "current_fingerprint": "4e7aa2d8fbf4dd0b8688ceae511af37f5b64845b301e47093a7456ef5706a032",
      "risk_flags": [
        "community_term",
