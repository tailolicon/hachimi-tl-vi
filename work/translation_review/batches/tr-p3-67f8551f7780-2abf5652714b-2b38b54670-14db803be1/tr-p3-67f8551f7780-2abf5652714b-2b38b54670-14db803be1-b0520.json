    },
    {
      "uid": "zhcn:87c447fd0ee050870d41c119",
      "source_batch": 130,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1096"
      ],
      "key": null,
      "source_text": "在镜球的照耀下，你就是Dancing Queen──\\n带着心中的这份雀跃，手舞足蹈♪又酷又炫地☆热力四射！",
      "source_fingerprint": "05ec09283ca0574b9aa7f638b979c75100565e9820f714d365fcec7aefb0af2d",
      "current_text": "Dưới ánh cầu gương, bạn chính là Dancing Queen──\\nMang theo niềm rộn ràng trong tim, nhảy múa♪ vừa cool vừa flashy☆ bùng cháy hết mình!",
      "current_fingerprint": "b9d8adf5672b3f9d01a7627877cc6ebc36098e12d0fd74652f4b3d0440e111b6",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:3cd0a65c7d5035a3b8f6d5df",
      "source_batch": 130,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1097"
      ],
      "key": null,
      "source_text": "用只属于你的颜色将这个世界染上Vivid的色调，\\n用流行轻快的旋律散发出Bright的光芒，就是现在！",
      "source_fingerprint": "adbaaa792e03cd490a42102e6a48c32ff37737cc0ba2cc71ad89d6216f90377f",
      "current_text": "Hãy nhuộm thế giới này bằng sắc Vivid chỉ thuộc về bạn,\\nvà tỏa ánh Bright bằng giai điệu pop nhẹ nhàng――chính là lúc này!",
      "current_fingerprint": "ef13098b9870bf3caa9c7de4a946785d626a3e8508ce65fa126bdc5e10fd6683",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
