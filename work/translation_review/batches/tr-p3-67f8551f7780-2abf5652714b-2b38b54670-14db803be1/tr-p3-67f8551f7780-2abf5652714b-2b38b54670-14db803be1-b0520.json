      "item_context_sha256": null
    },
    {
      "uid": "zhcn:a21e01872324441b62817296",
      "source_batch": 130,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1099"
      ],
      "key": null,
      "source_text": "决心要抓住那天看到的星星，她们朝着高远的天空奔驰而去。\\n前进的路只有一条──目标之星也只有一颗！抓住吧，最闪亮之星！",
      "source_fingerprint": "496c00173c818cfe4f3a02ea22dcdd8f3c5c5c39ecd727ba7c18f68611f125a2",
      "current_text": "Quyết tâm nắm lấy ngôi sao từng nhìn thấy ngày ấy, họ lao về phía bầu trời cao xa.\\nCon đường tiến lên chỉ có một──ngôi sao mục tiêu cũng chỉ có một! Hãy nắm lấy ngôi sao rực rỡ nhất!",
      "current_fingerprint": "6e88c04f697d5c5788567bec4f7fe65036699fe33d1a39ccf0c22a59753fcc8f",
      "risk_flags": [
        "very_long_target"
      ],
