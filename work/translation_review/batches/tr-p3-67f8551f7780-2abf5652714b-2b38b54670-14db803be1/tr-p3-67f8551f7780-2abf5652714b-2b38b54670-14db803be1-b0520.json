    {
      "uid": "zhcn:c04f4338bbc58b9eb16a8356",
      "source_batch": 130,
      "entry_index": 67,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1092"
      ],
      "key": null,
      "source_text": "丰收！种下蔬菜，制作料理，吃完后就元气满满地跑向前吧！\\n感谢今天的美味与爱，我要开动啦——！",
      "source_fingerprint": "05fc7f8dc459aa198c0dbfdf0b2b4a44cd7582fa7835820c450eb6e6a6343515",
      "current_text": "Bội thu! Trồng rau, nấu món ngon, ăn xong thì tràn đầy năng lượng chạy về phía trước!\\nCảm ơn món ngon và tình yêu hôm nay, mình xin phép ăn nhé——!",
      "current_fingerprint": "61b215d7b2ee3ae1c3e8edc3da84d7dedfecee1aaf9d1c5421d4db4bb65bdd94",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
