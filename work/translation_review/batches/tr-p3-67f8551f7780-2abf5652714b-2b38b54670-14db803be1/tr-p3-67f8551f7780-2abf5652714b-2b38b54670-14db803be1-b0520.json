    {
      "uid": "zhcn:7e34ec98b46d84890a23d16d",
      "source_batch": 130,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1095"
      ],
      "key": null,
      "source_text": "仅赠予荣获三后冠的女王们的歌曲。\\n华丽的同时，也有着顽强追梦的美。",
      "source_fingerprint": "80a55b72c2a740cff1f9760c28c28e5735e42fdf5cd90aca6aa814166601e7ba",
      "current_text": "Ca khúc chỉ được trao tặng cho những nữ hoàng giành được Triple Tiara.\\nVừa lộng lẫy, vừa mang vẻ đẹp kiên cường theo đuổi giấc mơ.",
      "current_fingerprint": "f0ddb01a6201045c4c1d0bbfca3346ee2ed02035b95369cec9f6cb2b769dde46",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
