    {
      "uid": "zhcn:926c5d6edef3833f197efa02",
      "source_batch": 130,
      "entry_index": 64,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1088"
      ],
      "key": null,
      "source_text": "纯度100%・运动员们的斗志，于歌舞中迸发而出！！\\n一场暴热的表演！！敬请期待！！！！",
      "source_fingerprint": "33524a57b8d4af0d6c80d12bf134042171b36beaf425d2756474fc7c9a718181",
      "current_text": "100% tinh khiết・ý chí chiến đấu của các vận động viên bùng nổ trong ca hát và vũ đạo!!\\nMột màn trình diễn nóng bỏng cực độ!! Xin hãy đón xem!!!!",
      "current_fingerprint": "cf88024f639d88aa905857833b83cfd49b68832f12b737b33c7800b816b00da6",
      "risk_flags": [
        "very_long_target",
        "numeric_token_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
