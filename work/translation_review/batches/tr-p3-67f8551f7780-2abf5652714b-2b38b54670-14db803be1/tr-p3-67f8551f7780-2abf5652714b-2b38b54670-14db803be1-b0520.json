      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1094"
      ],
      "key": null,
      "source_text": "结束阶段。输入最后的代码吧。\\nU+3042U+308AU+304CU+3068U+3046",
      "source_fingerprint": "e0bf549dc274872a7639b5810d5d90b0a0bcf6dfbf83a4f6f2857d80a65dcae6",
      "current_text": "Giai đoạn kết thúc. Hãy nhập đoạn mã cuối cùng.\\nU+3042U+308AU+304CU+3068U+3046",
      "current_fingerprint": "8d77483d835e3d0d2f0f900862a3de38baba48b7a346faae43fb5ab846aebca1",
