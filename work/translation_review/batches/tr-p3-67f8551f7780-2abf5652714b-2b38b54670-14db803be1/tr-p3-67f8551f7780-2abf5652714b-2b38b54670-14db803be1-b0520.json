      ],
      "key": null,
      "source_text": "永不放弃，直至触及梦想――！\\n怀着满腔热情，奔向胜利之路吧！",
      "source_fingerprint": "2e586ecce2a0c8b93baff0a014ac92b0f6867c4c2d3c4aa2c624f02a208c56fd",
      "current_text": "Không bao giờ bỏ cuộc, cho đến khi chạm tới giấc mơ――!\\nMang theo nhiệt huyết tràn đầy, hãy chạy trên con đường dẫn tới chiến thắng!",
      "current_fingerprint": "cd31e6ad56ed340fc04a2229990bb2a4e80f5a222111fbbfccec31752816c7fb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
