    },
    {
      "uid": "zhcn:fe7c7ac6b48ad1ce0e4033dd",
      "source_batch": 130,
      "entry_index": 68,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1093"
      ],
      "key": null,
      "source_text": "把情绪和欢呼声都拉升至最高潮！\\n超越盛夏的酷热↑来吧！一起嗨翻天！",
      "source_fingerprint": "39b8b4e1ee3136d819425885cc14bcee79d0268aca08a3da9a05cfa68ad3eca3",
      "current_text": "Đẩy cảm xúc và tiếng reo hò lên đến cao trào!\\nVượt qua cái nóng giữa hè↑ Nào! Cùng quẩy hết mình!",
      "current_fingerprint": "8e3d4c40712a2c5af3d1b31931f92aa0c4b94e4a174df1e0f04127c19a4f03d9",
      "risk_flags": [],
