      "item_context_sha256": null
    },
    {
      "uid": "zhcn:0d92504965fd97040a6adb45",
      "source_batch": 130,
      "entry_index": 61,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1085"
      ],
      "key": null,
      "source_text": "热血上涌、心跳加速！情绪高昂、激动不已！\\n让我们在这场喧闹至极的大祭典上，朝着胜利冲刺吧！",
      "source_fingerprint": "0b037124c58a796ee614f50cac471be83c538a78c31d1e0f292b9c4fc689bee8",
      "current_text": "Nhiệt huyết dâng trào, tim đập tăng tốc! Cảm xúc lên cao, phấn khích tột độ!\\nTrong đại lễ hội náo nhiệt hết cỡ này, hãy cùng lao về phía chiến thắng!",
      "current_fingerprint": "9b2f2135657bf80690731988d04e64a9ee7a5f47cbb9c202c5a402b6ad6b4448",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
