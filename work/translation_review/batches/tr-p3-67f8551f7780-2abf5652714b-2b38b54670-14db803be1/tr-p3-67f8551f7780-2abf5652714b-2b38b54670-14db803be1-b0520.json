    {
      "uid": "zhcn:67eba10734b54e4729205266",
      "source_batch": 130,
      "entry_index": 65,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1089"
      ],
      "key": null,
      "source_text": "没有时间眨眼了！宇宙现正随着超新星们的不断出现\\n而无限扩张――这，就是U.M.A.WORLD！",
      "source_fingerprint": "b039e901c52829c231258e5d2d0cb032743de73d45bc56638671f742396739c6",
      "current_text": "Không còn thời gian để chớp mắt! Vũ trụ đang vô hạn mở rộng khi những siêu tân tinh liên tục xuất hiện\\n――đây chính là U.M.A.WORLD!",
      "current_fingerprint": "422477160ac75012d8e25aabe2d578282960082e84032d2966bf3e6c17808a9d",
      "risk_flags": [],
