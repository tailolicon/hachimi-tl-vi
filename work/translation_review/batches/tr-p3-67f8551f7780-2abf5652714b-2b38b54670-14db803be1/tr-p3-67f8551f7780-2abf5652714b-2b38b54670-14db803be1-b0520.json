      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:c8830ebc155ac52082b0b646",
      "source_batch": 130,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1098"
      ],
      "key": null,
      "source_text": "在更迭交替的季节里，与你共度的时光如同永恒──\\n用不会褪色的色彩，让它永远停驻吧。",
      "source_fingerprint": "728233a1884fdac32524a9c481a0e7591eeda564d89b2fb09f1413503054a32d",
      "current_text": "Giữa những mùa thay phiên trôi qua, thời gian bên bạn tựa như vĩnh hằng──\\nHãy giữ nó mãi ở lại bằng những sắc màu không bao giờ phai.",
      "current_fingerprint": "569b695ef35514985d2776f313d940f05c6f2b9fc7e16830365903a79d7c1dc8",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
