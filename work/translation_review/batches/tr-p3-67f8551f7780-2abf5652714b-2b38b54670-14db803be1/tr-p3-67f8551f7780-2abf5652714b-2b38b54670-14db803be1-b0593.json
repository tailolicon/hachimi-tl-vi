      "json_path": [
        "139",
        "12"
      ],
      "key": null,
      "source_text": "希望你今后的表现也能不辱特雷森之名。",
      "source_fingerprint": "7c1638bbbbae75ed43e99b7b6a24f40d8adc9150a57426be2837d3539b4476fe",
      "current_text": "Mong rằng những màn thể hiện sắp tới của bạn cũng sẽ xứng đáng với danh tiếng Tracen.",
      "current_fingerprint": "1db5a7169dc640bfb5a7e209d4ca325d93b9a8e3ad83a39d3778f444544da31f",
      "risk_flags": [
        "very_long_target"
