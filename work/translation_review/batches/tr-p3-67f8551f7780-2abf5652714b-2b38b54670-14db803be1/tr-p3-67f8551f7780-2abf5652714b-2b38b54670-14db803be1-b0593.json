      "source_batch": 149,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "13"
      ],
      "key": null,
      "source_text": "最近每次来观摩都会令我着迷。\\n……着迷于各位所散发的光辉。",
      "source_fingerprint": "9e8aa264767e985c2038607507c454387d75aca4529a7cf03d574be9813d1e48",
      "current_text": "Gần đây mỗi lần đến quan sát tôi đều bị cuốn hút.\\n...Bị cuốn hút bởi ánh hào quang mà mọi người tỏa ra.",
      "current_fingerprint": "c3c94d3a88f559e736442c55128629142e499e45c1d125fa2c4af0bdaf197d37",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
