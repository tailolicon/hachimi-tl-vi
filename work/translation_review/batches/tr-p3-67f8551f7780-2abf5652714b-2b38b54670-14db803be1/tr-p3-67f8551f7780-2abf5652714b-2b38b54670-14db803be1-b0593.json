      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "14"
      ],
      "key": null,
      "source_text": "完成度又更高了……！\\n真不愧是训练员呢。",
      "source_fingerprint": "4e25dd09cd1268caebbbaab2c712a9e2bf82274ae9255765390da47998e63a17",
      "current_text": "Mức độ hoàn thiện lại cao hơn nữa...!\\nQuả không hổ danh Huấn luyện viên.",
      "current_fingerprint": "4a68123b52a9c315ce27bafe0f7efce90deaf098d2575d395faed35411f0c4d6",
      "risk_flags": [
