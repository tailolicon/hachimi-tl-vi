      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "15"
      ],
      "key": null,
      "source_text": "看来日积月累的努力\\n有确实为她所吸收！",
      "source_fingerprint": "ac763a8b9341802b065ae02dd6b6726110a053cf6d9280475f42ac438885d761",
      "current_text": "Có vẻ những nỗ lực tích lũy từng ngày\\nđã thực sự thấm vào cô ấy!",
      "current_fingerprint": "fd6f999a2bab4999b02162d08213fe284afc05cfa957bd6a3d6ccd47c10b60ac",
      "risk_flags": [
        "very_long_target"
