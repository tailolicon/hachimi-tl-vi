      "source_batch": 149,
      "entry_index": 11,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "24"
      ],
      "key": null,
      "source_text": "有什么烦恼吗？\\n有什么事都可以来谈谈喔！",
      "source_fingerprint": "e5c15fcedbcc9928ad5069b6fcdce5b4066e48cac9706ce325217a4019834e8f",
      "current_text": "Có điều gì phiền lòng không?\\nChuyện gì cũng có thể đến tâm sự với tôi!",
      "current_fingerprint": "9ce480c5c6426c6d1198aa7ee0bc85af5545b7bc02a02bac311a469f62194941",
      "risk_flags": [
        "very_long_target"
