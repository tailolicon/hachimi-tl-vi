      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "21"
      ],
      "key": null,
      "source_text": "真的……非常以你们为傲！\\n你们正可说是──梦想。",
      "source_fingerprint": "afbd2231d5e3ec385cb1038ab64ac33893fff62f9b3853b2730043b0b4d9f8fe",
      "current_text": "Thật sự... tôi vô cùng tự hào về hai người!\\nHai người quả thật chính là──ước mơ.",
      "current_fingerprint": "2c65d8e845204259d16a0d77645492f31dd563e7b706ece470cecced1080310c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
