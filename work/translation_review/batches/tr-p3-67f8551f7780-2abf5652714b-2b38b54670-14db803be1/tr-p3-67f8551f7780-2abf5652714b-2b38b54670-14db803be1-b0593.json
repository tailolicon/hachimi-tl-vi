    {
      "uid": "zhcn:7af4cf3e0cbf89b41b3a8778",
      "source_batch": 149,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "16"
      ],
      "key": null,
      "source_text": "如果有什么我能帮上忙的地方，\\n请不要客气尽管告诉我喔～",
      "source_fingerprint": "b58dad4e14ea2bf563354f361418c3648a4b625cb186b944b4f3d5d354199a3f",
      "current_text": "Nếu có việc gì tôi giúp được,\\nthì cứ nói với tôi, đừng ngại nhé～",
      "current_fingerprint": "47e171c4d3e11109472bca7eccf1f269c060b966aa3cdc26deaeb36a3885fcfb",
      "risk_flags": [],
      "risk_score": 0,
