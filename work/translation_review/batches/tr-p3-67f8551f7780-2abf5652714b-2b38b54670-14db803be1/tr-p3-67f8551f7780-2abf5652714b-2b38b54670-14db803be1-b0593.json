      "source_batch": 149,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "2"
      ],
      "key": null,
      "source_text": "优秀！\\n期待能有更上一层楼的活跃表现！",
      "source_fingerprint": "c6dabd4fe1396b4b7357f16b8e7a940a60ec29a1792254d33f762ef64b91bc17",
      "current_text": "Xuất sắc!\\nMong chờ những màn thể hiện còn tiến xa hơn nữa!",
      "current_fingerprint": "c7dc613735a732139602f0d7861b46f35ea8150f3f275965d44aa80a6c60fb66",
      "risk_flags": [],
      "risk_score": 0,
