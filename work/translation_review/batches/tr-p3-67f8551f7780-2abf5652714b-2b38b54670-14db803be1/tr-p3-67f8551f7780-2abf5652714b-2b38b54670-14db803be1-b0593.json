      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "25"
      ],
      "key": null,
      "source_text": "感動とは……貴方たちのような\\n強い絆から生まれるのですね。",
      "source_fingerprint": "7b90beb22e477b85421fb87e4f64980dc4145fba6b1e2f97b8215f9d64b37bb2",
      "current_text": "Cảm động... đúng là được sinh ra từ\\nmối liên kết bền chặt như của hai người nhỉ.",
      "current_fingerprint": "dda6da062d32a64d656a14f74dcdb3da0c79d34182fd3be80ec240eec8580b8a",
      "risk_flags": [],
      "risk_score": 0,
