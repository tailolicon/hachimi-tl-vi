    },
    {
      "uid": "zhcn:62773de6dc049cf4cecfa9e7",
      "source_batch": 131,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1123"
      ],
      "key": null,
      "source_text": "不赌上一切的胜负有什么价值？\\n让热血沸腾，洞察极限，赌徒现在就要出手……！",
      "source_fingerprint": "bf11823f6ff3b451f92d93c5c1d8fe748194e613d8f0939342929cec4f2e91a5",
      "current_text": "Một cuộc phân thắng bại không đánh cược tất cả thì có giá trị gì?\\nHãy để máu nóng sục sôi, nhìn thấu cực hạn — con bạc giờ sẽ ra tay…!",
      "current_fingerprint": "ae0daf925f7ee1dd36ce41071e343ff9f69237d561e87a1e824ce66a8c1bc3b1",
      "risk_flags": [
        "very_long_target"
