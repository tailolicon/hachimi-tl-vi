  "items": [
    {
      "uid": "zhcn:71eb0c9873edd1f120e32aaa",
      "source_batch": 131,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1105"
      ],
      "key": null,
      "source_text": "每当独自奔跑时，就会感受到有如针刺的疼痛，以及焦躁……\\n即使如此也不停下脚步，就算可能性低于零也是。",
      "source_fingerprint": "e5a2309f80c77c02aadb326ca16509db873d70bd7eb1a508c18991113ed91464",
      "current_text": "Mỗi khi chạy một mình, lại cảm thấy nhói đau như kim châm cùng nỗi bồn chồn…\\nDẫu vậy vẫn không dừng bước, cho dù khả năng còn thấp hơn cả con số không.",
      "current_fingerprint": "57a282415605d370b696c2d8ecba92eb2053e9578d84cc579045398c908d90fb",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:f185de7d34409956080a3622",
      "source_batch": 131,
      "entry_index": 1,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1106"
      ],
      "key": null,
      "source_text": "为了达成使命，去钻研磨练、去激昂、热血起来。\\n超越现在的自己吧──SUPER STRONG.",
      "source_fingerprint": "6f2d108aec9368d671105c0f0e1cdb1ae746a0aec1f4e64aef78222689329966",
      "current_text": "Để hoàn thành sứ mệnh, hãy mài giũa bản thân, hãy sục sôi và cháy hết mình.\\nVượt qua chính mình của hiện tại — SUPER STRONG.",
      "current_fingerprint": "05e044b955695e326c16102df20481536c757cfe05f74388524af975867715cb",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:9339df81c0bbe1fbbcbb1eea",
      "source_batch": 131,
      "entry_index": 2,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1107"
      ],
      "key": null,
      "source_text": "一生仅有一次的光辉就在此处。无论摔倒多少次都不会放弃。\\n带着决心和勇气，与伙伴一起──用全力在梦想的舞台上奔驰。",
      "source_fingerprint": "3b06144b3435f2c646d3275990b41ddf06b1d901ff712e2ae00da291ba733b59",
      "current_text": "Ánh hào quang chỉ có một lần trong đời đang ở ngay nơi đây. Dù ngã bao nhiêu lần cũng không bỏ cuộc.\\nMang theo quyết tâm và dũng khí, cùng đồng đội — dốc toàn lực chạy trên sân khấu của những giấc mơ.",
      "current_fingerprint": "daec738b273e45d1f00ed9148d95de6d37ac91148f72319c0803e3887a7256ee",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch",
        "absence_risk"
      ],
      "risk_score": 16,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
          "target_vi": "Dốc hết sức",
          "matched_aliases": [
            "全力"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:04cfa093a908022cb27c85d3",
      "source_batch": 131,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1108"
      ],
      "key": null,
      "source_text": "只要两人有良好的契合度，不走运的日子也Don't Worry☆\\n幸运、快乐和胜利，全部都能抓进手中☆",
      "source_fingerprint": "3a49ac0bbb95863592bb7a0900f44b962517bb57933294f59bb0b13ea1caa50b",
      "current_text": "Chỉ cần hai người thật ăn ý, ngày xui xẻo cũng Don't Worry☆\\nMay mắn, niềm vui và chiến thắng — tất cả đều có thể nắm trong tay☆",
      "current_fingerprint": "6f20167c5675df9672e75bcdb4b23292e78c7632704b79d40b579189df778ae8",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:f5ac21f3ae16cfe2a0ca24b4",
      "source_batch": 131,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1109"
      ],
      "key": null,
      "source_text": "倾注祝福！醉于狂乱！禁忌的果实就在不可能的彼端。\\n来吧，这是超越神话的破灭之始。",
      "source_fingerprint": "33c0ede336992011f864b6c3b5101d6e2611c34fb316d5ef383a0627c0dc3d32",
      "current_text": "Dâng lời chúc phúc! Say trong cuồng loạn! Trái cấm nằm ở phía bên kia điều bất khả thi.\\nNào, đây là khởi đầu của sự diệt vong vượt trên cả thần thoại.",
      "current_fingerprint": "337d4edfb2e4d6799db9fb784dabb1838e2072dc23dab882eb5d98622b55bb8e",
      "risk_flags": [
        "very_long_target",
        "negation_capability_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:18656ae8c8fdee0d07912f79",
      "source_batch": 131,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1110"
      ],
      "key": null,
      "source_text": "超越法则，领先光速──只要在我的脚加上名为「你」的要素，\\n就能解答一切，揭开未曾见得的A计划。",
      "source_fingerprint": "fc38bf1bb20148bfef3032927fc02a53624dc96d930d336480d39f5488db1958",
      "current_text": "Vượt qua quy luật, đi trước cả tốc độ ánh sáng — chỉ cần thêm yếu tố mang tên “bạn” vào đôi chân này,\\nmọi thứ đều có thể giải được, hé mở Kế hoạch A chưa từng thấy.",
      "current_fingerprint": "9e40e0d4653d81dee158b6d4125f81e15064b508c5cc121ebb13d5553edd9525",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:370dff613574b6dcb26f751f",
      "source_batch": 131,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1111"
      ],
      "key": null,
      "source_text": "憧憬的她身边的位置，就算是我……！\\n不论因为自己的笨拙而灰心多少次，最后也绝对能……！",
      "source_fingerprint": "fa173d29ca3d878a9fe239066f368ca99b481532eb89f3ceb6b08e0bdb652619",
      "current_text": "Vị trí bên cạnh người mà mình hằng ngưỡng mộ, ngay cả mình cũng…!\\nDù có bao lần nản lòng vì sự vụng về của bản thân, cuối cùng nhất định cũng có thể…!",
      "current_fingerprint": "426f291d29e065f7da02945a09c842ddafa7d949176b45d0600245115b9f1e4b",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d353118874cd3812814f8077",
      "source_batch": 131,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1112"
      ],
      "key": null,
      "source_text": "赞颂霸王吧！奏响欢喜吧！见证这震撼人心的一幕吧！\\n现在，前无古人的荣光，即将刻划在历史上。",
      "source_fingerprint": "27818d2f50ed45d8d63c31df830fe15f70a0de04504877a68cbb580e4295fd15",
      "current_text": "Hãy ca tụng Bá Vương! Hãy tấu lên khúc hoan ca! Hãy chứng kiến khoảnh khắc chấn động lòng người này!\\nGiờ đây, vinh quang vô tiền khoáng hậu sắp được khắc vào lịch sử.",
      "current_fingerprint": "b6da0fdd6599903680da1df0c5a07ea7f123df14a5bddfcd12e7146c4be74130",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:f588bbdce60c8f1b6e25f55b",
      "source_batch": 131,
      "entry_index": 8,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1113"
      ],
      "key": null,
      "source_text": "在寂静之中，背负着起誓过的使命持续奔驰。\\n为了带着如同一等星般的闪耀，将胜利献给夜空──",
      "source_fingerprint": "7d7ec03da3605368e844dbf54ca61d8f863b679539eda7cde6153c00f50b36a7",
      "current_text": "Trong tĩnh lặng, tiếp tục chạy với sứ mệnh đã thề nguyện trên vai.\\nĐể mang ánh sáng rực rỡ như ngôi sao hạng nhất, dâng chiến thắng lên bầu trời đêm —",
      "current_fingerprint": "0b8a868a590984c0a356b60a9ebccee324927e3dbfd7465d63b3c28f896382d1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d2331af0a9d384f8e4a8875b",
      "source_batch": 131,
      "entry_index": 9,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1114"
      ],
      "key": null,
      "source_text": "即使因面前的高墙而害怕，你的声援仍点燃了我的斗志。 \\n无论几次都会向梦想发起挑战。永不放弃──再一次！",
      "source_fingerprint": "8cbe69fcbb5af12748a1d2182cc7ae869458b860d1ef52c360f5bec71bb35bb4",
      "current_text": "Dẫu sợ hãi trước bức tường cao chắn lối, lời cổ vũ của bạn vẫn thắp bùng ý chí chiến đấu trong tôi. \\nDù bao nhiêu lần cũng sẽ tiếp tục thách thức giấc mơ. Không bao giờ bỏ cuộc — thêm một lần nữa!",
      "current_fingerprint": "4c468c7daa68abea8d08e4d97b144daaa054dcf0cb302664e571dffeb888f58d",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:b779b71d6eaad5aaccec51f0",
      "source_batch": 131,
      "entry_index": 10,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1115"
      ],
      "key": null,
      "source_text": "轻快的摇滚节奏中高声歌唱，\\n黄金的浪漫！以一夜暴富为目标，Ships set sail!",
      "source_fingerprint": "d3a554eb47cf20fcc2fa516ae9e838c367dfc8375ef0c0b9a513f026710c5c49",
      "current_text": "Cất cao tiếng hát giữa nhịp rock rộn ràng,\\nkhúc lãng mạn vàng son! Nhắm tới đổi đời sau một đêm, Ships set sail!",
      "current_fingerprint": "907c72305fb55e7f516c88802fcf5c854778ba60656ea6b77e565f1ed4c57a81",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:fcd1331383c79a928263f391",
      "source_batch": 131,
      "entry_index": 11,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1116"
      ],
      "key": null,
      "source_text": "每天坚持努力，总有顺风的时候……应该吧！\\n配合流行的节奏，加油，加油，嗯！",
      "source_fingerprint": "f488b795cbd8a00e3b298ece9db629e25af1516712facbae738ae24448a0d139",
      "current_text": "Cứ kiên trì cố gắng mỗi ngày rồi sẽ có lúc gặp gió thuận… chắc vậy!\\nTheo nhịp điệu thịnh hành, cố lên, cố lên, ừ!",
      "current_fingerprint": "da76718ad9e432540ed92f998a10a1ec5f67f31698b4ccee12b972dae6480736",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:a8a20bfc34708c643520f36f",
      "source_batch": 131,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1117"
      ],
      "key": null,
      "source_text": "毫无疏漏，毫无阻碍，一切都缜密安排。彻底的管理就是完美，\\n以钢铁意志贯彻的是『跑完全程的觉悟』——",
      "source_fingerprint": "d7dfc449a389c02fa5fb9131a48ef55298bb5fc2765032bb85f1e9b6947df8ee",
      "current_text": "Không sơ suất, không trở ngại, mọi thứ đều được sắp xếp tỉ mỉ. Quản lý triệt để chính là hoàn hảo,\\nvà thứ được thực hiện bằng ý chí thép là “giác ngộ chạy đến cùng” —",
      "current_fingerprint": "f70831ed1f3b8b751d00a21999b4d1d100f863db6fee12c539de8a8af57abb87",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.7f03adcd94bc",
          "target_vi": "Ý chí thép",
          "matched_aliases": [
            "钢铁意志"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:51b2d5edfe019398cabf49a6",
      "source_batch": 131,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1118"
      ],
      "key": null,
      "source_text": "涡轮全开！冲向极限的彼方！！\\n所谓不放弃，就是这样的啊！！",
      "source_fingerprint": "0fe6690de38dad7c4044f4be6859d9b419fdbf8bea8685c6dfad9f9a5e67d528",
      "current_text": "Turbo toàn khai! Lao tới phía bên kia giới hạn!!\\nKhông bỏ cuộc chính là như thế này đây!!",
      "current_fingerprint": "cfad081ebaeecaf7948e82aca7b3cdbb0d6c6e613e7cbcbf87b1235008a0316a",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:fe8c38bbe59ae35d2da24dfe",
      "source_batch": 131,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1119"
      ],
      "key": null,
      "source_text": "为心灵的杯子增添色彩的是……\\n怀着淡淡的忧伤，歌唱新的旅程。",
      "source_fingerprint": "7009403d793bf42a8497e245702625a8f6c43d84f6fa25e1234de36d9fdd0c2c",
      "current_text": "Thứ tô điểm sắc màu cho chiếc cốc của tâm hồn là…\\nmột chút man mác buồn, cất tiếng hát về hành trình mới.",
      "current_fingerprint": "bc2a7ae22ccc2b6e347ab4e022419b397a1391d7bbb8fa69f8b17f47231b8069",
      "risk_flags": [
        "very_long_target"
