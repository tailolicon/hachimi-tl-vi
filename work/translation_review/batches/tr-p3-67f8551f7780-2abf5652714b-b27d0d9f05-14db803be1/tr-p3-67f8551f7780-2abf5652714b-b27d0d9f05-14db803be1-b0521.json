    {
      "uid": "zhcn:f38c056deba6af3d2a76cfdd",
      "source_batch": 131,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1120"
      ],
      "key": null,
      "source_text": "像在春日暖阳下散步一样，为心灵充满元气吧！\\n无论什么事都能顺其自然！嗯，没问题的！",
      "source_fingerprint": "8fd71a3fb4b0cfb5770cc07f25a07199ab1765694d3dd294923ae59956118859",
      "current_text": "Như dạo bước dưới nắng ấm ngày xuân, hãy để trái tim tràn đầy sức sống!\\nChuyện gì rồi cũng sẽ tự nhiên ổn thôi! Ừ, không sao đâu!",
      "current_fingerprint": "35a30998ca1b9f60622928685d50b8777bf13a91b0e867c9c178ccb1569666d9",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:ff27a7ac3762063397a2f11b",
      "source_batch": 131,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1121"
      ],
      "key": null,
      "source_text": "不管周围怎么说，我就是我。\\n虽然笨拙，但不是装出来的，我是真心在这里——",
      "source_fingerprint": "4c697fcf4ea08d38904c5a5673f813a108bd147eb93326913b46a032164c27fd",
      "current_text": "Dù xung quanh nói gì đi nữa, tôi vẫn là tôi.\\nDẫu vụng về, đây không phải giả vờ — tôi thật lòng đứng ở nơi này —",
      "current_fingerprint": "3d52ebbce3c47bd7622b9b76e16414d7dbffab10424d70c1b1abeb4aa8e544df",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:bb0f9be909faac76506fa971",
      "source_batch": 131,
      "entry_index": 17,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1122"
      ],
      "key": null,
      "source_text": "让脑髓都震颤的狂野斗争本能。\\n真正的王者，征服一切，走向荣耀。",
      "source_fingerprint": "9253b52c5a978ef6751b3ceaee5d12c8534cf582282adb7aaafff43a33757f16",
      "current_text": "Bản năng chiến đấu hoang dại khiến cả não tủy rung chuyển.\\nBậc vương giả đích thực chinh phục tất cả, tiến tới vinh quang.",
      "current_fingerprint": "aa0ca918a674cdebca45c6e56affc41059cf4556acd9aa31d2e133c1e2ff5696",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
