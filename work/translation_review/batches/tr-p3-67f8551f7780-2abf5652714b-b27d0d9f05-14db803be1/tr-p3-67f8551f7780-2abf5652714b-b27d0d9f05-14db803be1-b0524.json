  "batch_id": "tr-p3-67f8551f7780-2abf5652714b-b27d0d9f05-14db803be1-b0524",
  "context_snapshot_sha256": "b27d0d9f053e55917fdd8bf13e4988efc3325d2b1bcb3f042948abc64046a8dd",
  "source_bridge_policy_sha256": "1faac1e600d42535217e267fbba196d6723753776386d93856ced27a90801c9e",
