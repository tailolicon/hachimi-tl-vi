  "items": [
    {
      "uid": "zhcn:db6aa96856d625004baabacf",
      "source_batch": 131,
      "entry_index": 60,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1166"
      ],
      "key": null,
      "source_text": "随心所欲，随风而去，飞向遥远的彼方！\\n若想知晓风的去向，聆听这首曲子便好。",
      "source_fingerprint": "f1e4f9f90703a4fbce1ac659e498a22e099726259e03fc7805fe3ca2d3814977",
      "current_text": "Tùy lòng mà đi, theo gió mà bay, hướng tới phương xa!\\nMuốn biết gió sẽ về đâu, chỉ cần lắng nghe khúc nhạc này.",
      "current_fingerprint": "d24fbeaafbe2f85fa20eac1ba54ed437d25f9f08a5f57bfb442f360e7f999207",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:878a58b2c9d9a7184d2fca7c",
      "source_batch": 131,
      "entry_index": 61,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1167"
      ],
      "key": null,
      "source_text": "太阳正在地平线的某处升起……只是并非此处。\\n奔跑吧。总有一天，这片阴云也会散去的。",
      "source_fingerprint": "d99301dff80f85a39826c71a529a90d86f47d6e8ca7afd247c00feaf4eb988d1",
      "current_text": "Mặt trời đang mọc ở đâu đó trên đường chân trời… chỉ là không phải nơi này.\\nHãy chạy đi. Rồi một ngày, mây mù nơi đây cũng sẽ tan.",
      "current_fingerprint": "c503865e013603cd72865ac81a7b1b17430d2763d6237fa197e4a23eeef89ff9",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:e6bc73d7042725b4d5cb2cdc",
      "source_batch": 131,
      "entry_index": 62,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1168"
      ],
      "key": null,
      "source_text": "跪拜聆听！",
      "source_fingerprint": "01a45ddd47190dd605ff10534746b38f4445acf5dbe1eb7223fc4b2bb8e52034",
      "current_text": "Quỳ xuống mà lắng nghe!",
      "current_fingerprint": "044ff522770390e5fdd4ab61a90a14db5fe19508dbccb9038dd0ee0374b1d535",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:8aeacd594255264ae4c4127d",
      "source_batch": 131,
      "entry_index": 63,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1169"
      ],
      "key": null,
      "source_text": "旅途中拾起的风景，将成为连接未来的梦想。\\n那么，今晚又会做怎样的梦呢……",
      "source_fingerprint": "d166a88f224e103b6db8cf966a06f3894f8450c2244ce374dbc53558cb653c08",
      "current_text": "Những phong cảnh nhặt được trên hành trình sẽ trở thành giấc mơ nối liền tương lai.\\nVậy tối nay sẽ lại mơ giấc mơ thế nào đây…",
      "current_fingerprint": "7455eb20ddccbe86163f96483b933bc8789f5c3e37dd36e1f0788b4dd2b982ec",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:631e62c8a7473069e194a24f",
      "source_batch": 131,
      "entry_index": 64,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1170"
      ],
      "key": null,
      "source_text": "有一种光芒让人无法移开目光。\\n只要听这首曲子——不，其实你已经知道了吧？",
      "source_fingerprint": "84c1069438893b8b342f49be79a0fbcd74beaebfae1db7b7b55fe46b95dc74dd",
      "current_text": "Có một ánh sáng khiến người ta không thể rời mắt.\\nChỉ cần nghe khúc nhạc này — không, thật ra bạn đã biết rồi, đúng không?",
      "current_fingerprint": "fc00258978a53b5f9000660f957de376d0edf86659c0c39105140eef5e8ea710",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:6f7c18bc56606e1deecc2165",
      "source_batch": 131,
      "entry_index": 65,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1171"
      ],
      "key": null,
      "source_text": "辉煌梦想的顶峰遥不可及，前路充满绝望……\\n然后，少女走向了荣华之门。",
      "source_fingerprint": "4c63fb5e5fc8c077ffd924bd72837f270315103a34fbdc432f65fff6d1d6b6e6",
      "current_text": "Đỉnh cao của giấc mơ huy hoàng xa ngoài tầm với, con đường phía trước ngập tràn tuyệt vọng…\\nVà rồi, cô gái bước tới cánh cửa vinh hoa.",
      "current_fingerprint": "ee025707df98024f22afa5a696dbac31e521ba2cbe720a38861a89f7999f8b22",
      "risk_flags": [
        "very_long_target",
        "negation_capability_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d377f13b8f6d61a5da77bd7a",
      "source_batch": 131,
      "entry_index": 66,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1172"
      ],
      "key": null,
      "source_text": "争先恐后超越他人的背影！\\n燃烧的热情终将成为照亮新时代的灯火！",
      "source_fingerprint": "ddcf1d5230d4828111729dca81c545cb8c92f21c7ecee16cf5822fbb41b8588a",
      "current_text": "Tranh nhau vượt qua bóng lưng của người khác!\\nNhiệt huyết cháy bỏng rồi sẽ hóa thành ngọn đèn soi sáng thời đại mới!",
      "current_fingerprint": "266377d3bfab27bc1f9fa322dfedf2f5abf52d7c50b2a7c855dc9ba128f8a45c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:c3a6a5d3c19639d9bd123d27",
      "source_batch": 131,
      "entry_index": 67,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1173"
      ],
      "key": null,
      "source_text": "奔跑吧，Frontier！用震撼的全力疾奔撼动世界！\\n来吧，究竟是谁将开辟全新的世界！？",
      "source_fingerprint": "31bfa0f750cc4c0261397fc7f8043ca9d504fe02b566b0ae120dd066c3e278fa",
      "current_text": "Chạy đi, Frontier! Dùng cú nước rút toàn lực chấn động cả thế giới!\\nNào, rốt cuộc ai sẽ là người khai mở một thế giới hoàn toàn mới!?",
      "current_fingerprint": "90d80a393fa1abb3237019c58d5b40f9fd03c9ea7b405d235ee9f8cc47ad33de",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
          "target_vi": "Dốc hết sức",
          "matched_aliases": [
            "全力"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:45bccc91862cf3a2f91a404b",
      "source_batch": 131,
      "entry_index": 68,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1174"
      ],
      "key": null,
      "source_text": "在夕阳余晖下的归途，某天突然溢出的旋律。\\n\n不可思议地，声音重叠着传来……就像那一天一样。",
      "source_fingerprint": "7a0cb889eb3f274423dc57723cb5906a514a3a3348772f60170bb5edcb447303",
      "current_text": "Trên đường về dưới ánh chiều tà, một ngày nọ giai điệu bỗng trào dâng.\\n\nKỳ lạ thay, những giọng âm chồng lên nhau vọng tới… hệt như ngày hôm ấy.",
      "current_fingerprint": "4c3d75bc73656f57b1321bc8b9c168dead0e236f1fd42a72923ff7c56ced7f3b",
      "risk_flags": [
        "very_long_target",
        "negation_capability_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:31be97cde28fff86030e9b16",
      "source_batch": 131,
      "entry_index": 69,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1175"
      ],
      "key": null,
      "source_text": "一起奔跑的日子。不知不觉已经来到了这么远的地方。\\n并肩奔跑的两人的牵绊，将一直延续到梦想的尽头——",
      "source_fingerprint": "fb31f9039a1867f66a6b02cd63cde340fd54566f07d4833d860f5ebba37cfd7a",
      "current_text": "Những ngày cùng nhau chạy. Chẳng biết từ bao giờ đã đi xa đến thế này.\\nMối gắn kết của hai người chạy vai kề vai sẽ còn kéo dài tới tận cùng giấc mơ —",
      "current_fingerprint": "69257c220bd6d6d3e62684a71a755ad913015a5d6e241cb4807986c21d097387",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:78c5fe72d01388b878619089",
      "source_batch": 131,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1176"
      ],
      "key": null,
      "source_text": "划破风暴的，是你那举世无双的光芒——\\n披挂上阵吧，在那缤纷绚烂的色彩中。鸣响吧，那革命的歌声。",
      "source_fingerprint": "0c9e57f10d99f84b70df7259ea1d79ff1cc8fdc1480777f125476c217d6d949b",
      "current_text": "Xé toạc bão tố chính là ánh sáng vô song của bạn —\\nHãy khoác giáp ra trận giữa muôn màu rực rỡ. Hãy vang lên, khúc ca cách mạng ấy.",
      "current_fingerprint": "19e2c70115cf952c05e85c17a462fb682610f546d9eb73f697fb18eb232e8152",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:7d2071440960643b1aa7f2ab",
      "source_batch": 131,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1177"
      ],
      "key": null,
      "source_text": "在这场豪华绚丽的盛典中，证明出团队的羁绊。\n以此团结之力攀登世界之巅！拿下吧，美国梦！",
      "source_fingerprint": "d3049ae23595807548430a941542d8affaebc1af8f855bee2fedebe145e7713d",
      "current_text": "Trong lễ hội lộng lẫy này, hãy chứng minh mối gắn kết của cả đội.\nDùng sức mạnh đoàn kết ấy leo lên đỉnh thế giới! Giành lấy Giấc mơ Mỹ!",
      "current_fingerprint": "866241632621f3611684e70d3a2bbf3b29b55cf59be2b80dcff709dade888436",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:78225a9b059a49631af7cee8",
      "source_batch": 131,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1178"
      ],
      "key": null,
      "source_text": "想要比任何人都要强烈、激烈，闪耀如流星般的一曲！\\n掠过天际的灰色轨迹，将会震撼每一个人的心！",
      "source_fingerprint": "1ea5a311120350b01b2e5e126f197395e02124bdc9ef578334c4ce980a2aadb1",
      "current_text": "Một khúc ca muốn tỏa sáng mãnh liệt, dữ dội hơn bất kỳ ai — như sao băng!\\nQuỹ đạo xám lướt ngang bầu trời sẽ làm rung động trái tim tất cả mọi người!",
      "current_fingerprint": "7a370af1142ffd2132c151b3a56d1480e066b3852395cd9652e7136980c4b10c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d37c2e6a3046d139960ab588",
      "source_batch": 131,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1179"
      ],
      "key": null,
      "source_text": "不善于使用言语表达……即便如此，还是想要传达出来。\\n就是这样，一首稍微有点笨拙的歌。",
      "source_fingerprint": "c9200df9f4e31ab61ab761352bfa7b58f487e5898d0073bb2df8f169045744fd",
      "current_text": "Không giỏi diễn đạt bằng lời… nhưng dù vậy vẫn muốn truyền đạt ra.\\nĐó là một bài hát hơi vụng về một chút như thế.",
      "current_fingerprint": "70a657470b2dfd6a3c34691cc3fddeffea5748886b0b54ee3facc805bdc209ef",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:181cc577cf445e3c42dfc61d",
      "source_batch": 131,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1181"
      ],
      "key": null,
      "source_text": "赠予你的这一碗。面条、配菜与热情，\\n盛满平日里满满的感谢——嘿，让您久等啦！！",
      "source_fingerprint": "505c5b425c9c1f6aea176c1aceec6b0ec5737c508b5a4a4ffed834da334ebdb9",
      "current_text": "Tặng bạn một bát này. Mì, đồ ăn kèm và cả nhiệt huyết,\\nđong đầy lời cảm ơn thường ngày — này, để bạn đợi lâu rồi!!",
      "current_fingerprint": "ab121f5fda8b468d9577572fe2bf55c074796a79e5d2f3680dd3c9b1d2cdbfa9",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:996c7568e8341c51f3593486",
      "source_batch": 131,
      "entry_index": 75,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1182"
      ],
      "key": null,
      "source_text": "『#kawaii』『#梦幻柔软』『#心动不已？』\\n可爱是能传达到宇宙的暗号！呐，可以再多喜欢我一点吗？",
      "source_fingerprint": "410a1d5da43efff3a849005af5e013bf077ba6e7dbd5d0d32f6041d35c4f9657",
      "current_text": "“#kawaii” “#mơmàngmềmmại” “#timđậpnhanh?”\\nDễ thương là mật mã có thể truyền tới tận vũ trụ! Nè, bạn có thể thích tôi thêm một chút nữa không?",
      "current_fingerprint": "2ea0875186c0ee7b659d270e60cf028d926de78287298747b9c8115e72323e64",
