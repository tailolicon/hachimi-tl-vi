    {
      "uid": "zhcn:fcaf8910f5a4288b34f940fe",
      "source_batch": 130,
      "entry_index": 58,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1082"
      ],
      "key": null,
      "source_text": "少女们背负着积年夙愿，向那前所未有的胜利发起挑战。\\n誓要凯旋，踏上了异国征程――荣光的大门，就在她们眼前。",
      "source_fingerprint": "0921fca2a638e3dd10e87d3f286c83b742508beb2412184bc6cc6446f1cbbd8e",
      "current_text": "Những cô gái mang trên vai tâm nguyện ấp ủ bao năm, thách thức chiến thắng chưa từng có.\\nThề sẽ khải hoàn, họ bước lên hành trình nơi đất khách――cánh cổng vinh quang đang ở ngay trước mắt.",
      "current_fingerprint": "ee8afabd3ca14789d31a7ea125ce47feea187ab4c19d0927531f5e2121d322b4",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:0aea32c1f25ea5facb70c2bb",
      "source_batch": 130,
      "entry_index": 63,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1087"
      ],
      "key": null,
      "source_text": "辣妹赛马娘们统统嗨起来！为了辣妹而存在的歌曲！\\n我们是forever☆最强的赛马娘死党！",
      "source_fingerprint": "136a0208f99d39fb5f47bf336e163676cde7c8ab882f4a76c238405b22af2e4a",
      "current_text": "Các Uma Musume gyaru, quẩy hết mình nào! Một ca khúc sinh ra vì gyaru!\\nChúng ta là forever☆ hội bạn Uma Musume mạnh nhất!",
      "current_fingerprint": "4e7aa2d8fbf4dd0b8688ceae511af37f5b64845b301e47093a7456ef5706a032",
      "risk_flags": [
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
        "canonical_finding"
