    {
      "uid": "zhcn:9df874a99473ee3688bdfc70",
      "source_batch": 221,
      "entry_index": 38,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "9050"
      ],
      "key": null,
      "source_text": "我是汤驹温泉的老板娘，保科健子。\\n疲劳伤痛什么的泡温泉很管用哦。\\n俗话说，健康第一嘛……嚯嚯嚯！",
      "source_fingerprint": "ed5aa5a1ea5f247b7c55f9071127ff783b99a31fb0ff1d1ad7ff1c63746b46c5",
      "current_text": "Tôi là Hoshina Kiyoko, bà chủ lữ quán Yukoma.\\nMệt mỏi hay chấn thương thì ngâm suối nước nóng rất hiệu nghiệm đấy.\\nNgười ta vẫn nói sức khỏe là trên hết mà... hô hô hô!",
      "current_fingerprint": "c8e23a276d8b41c62562855d8fcc1f2c726bbb566aa1eb753a3c30f52447aa52",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
