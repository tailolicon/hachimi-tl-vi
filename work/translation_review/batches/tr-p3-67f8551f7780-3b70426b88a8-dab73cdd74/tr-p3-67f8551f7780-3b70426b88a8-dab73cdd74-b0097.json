    {
      "uid": "zhcn:aeeaccd868a6ea18fc656254",
      "source_batch": 26,
      "entry_index": 27,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Heroes511054"
      ],
      "key": "Heroes511054",
      "source_text": "・根据比赛结果积累英雄量表\n・英雄量表达到MAX后，在下一局的比赛对手决定前，\n　参赛的3名赛马娘将全部获得1个相同的英雄技能\n・获得了英雄技能的比赛中不会积累英雄量表\n・获得了英雄技能的1局比赛结束后，\n　英雄量表归零，可从下一局起再次积累",
      "source_fingerprint": "6ff237d61fed780e0af146258939e7689e4f7d69787f74d78bf8b5e7f47ed158",
      "current_text": "・Thanh Anh hùng sẽ tích lũy dựa trên kết quả cuộc đua\n・Khi Thanh Anh hùng đạt MAX, trước khi xác định đối thủ ở lượt đua tiếp theo,\n　cả 3 Uma Musume tham gia sẽ nhận cùng 1 Kỹ năng Anh hùng\n・Không tích lũy Thanh Anh hùng trong lượt đua đã nhận Kỹ năng Anh hùng\n・Sau khi kết thúc 1 lượt đua có Kỹ năng Anh hùng,\n　Thanh Anh hùng trở về 0 và có thể tích lũy lại từ lượt tiếp theo",
      "current_fingerprint": "3e914f4ea0632d362ff239a0bea3b70a07250100fbbf85416de432b32a037e31",
      "risk_flags": [
