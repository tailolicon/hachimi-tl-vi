      ],
      "key": "Race0486",
      "source_text": "干的不错呢！\n继续以优胜为目标加油吧！",
      "source_fingerprint": "a7deb906bd97ebac55310fb4384bdbff1bf9b393b6cd294cd88535ce10963a88",
      "current_text": "Làm rất tốt!\nHãy tiếp tục cố gắng hướng tới chiến thắng!",
      "current_fingerprint": "de450c69b6373e493a89240f3cafcf29869699bb518a4e151ce1f4d23f2936c4",
