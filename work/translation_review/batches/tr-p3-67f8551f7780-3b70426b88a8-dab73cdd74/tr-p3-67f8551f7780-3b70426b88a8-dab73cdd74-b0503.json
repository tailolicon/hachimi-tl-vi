  "items": [
    {
      "uid": "zhcn:869cd06e8c2a8d13896aa9c4",
      "source_batch": 129,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1001"
      ],
      "key": null,
      "source_text": "粉饰URA总决赛的欢快歌曲。\\n马儿跳♪马儿跳♪绝对能带起现场的气氛！",
      "source_fingerprint": "ca0a69d88943c4f2a6ba935358fa033fbc59b57bc8a9939007c9d0b8a4324070",
      "current_text": "Ca khúc vui tươi tô điểm cho URA Finals.\\nNgựa nhảy♪ Ngựa nhảy♪ Chắc chắn sẽ khuấy động không khí!",
      "current_fingerprint": "4861a7c66b373662a5b30be07554ee0383a46f9e4dba4f574160ecc5e69220c1",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:32534c621c0e3f52cad487cc",
      "source_batch": 129,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1003"
      ],
      "key": null,
      "source_text": "我们两人一起，什么都可以做到！\\n这充满活力的乐曲，一定也能令你欢笑☆",
      "source_fingerprint": "5050c0e710a6e76414cc064f905caf37e22d828f76b02998ff171e3cc8cf1396",
      "current_text": "Hai chúng ta bên nhau, chuyện gì cũng làm được!\\nGiai điệu tràn đầy năng lượng này chắc chắn cũng sẽ khiến bạn mỉm cười☆",
      "current_fingerprint": "7f87d9988ea69b9beb8526cdf960038c2333c238e3d498c79dace8a51df43375",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:8413b24294453735b45a0a76",
      "source_batch": 129,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1004"
      ],
      "key": null,
      "source_text": "因为和你一同奔跑ー\\n我们的旋律永远不会停止。已经，不会再回头了。",
      "source_fingerprint": "8d39ea31f558d5cad69cd63639f26896c1b6d8b49ae76eb25598569c49380920",
      "current_text": "Vì được chạy cùng bạn—\\nGiai điệu của chúng ta sẽ không bao giờ dừng lại. Giờ đây, sẽ không quay đầu nữa.",
      "current_fingerprint": "921c4521422c4cc8a8bfc0e95d456e52edc9044004783bb43612dd312c979829",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:8bd91d3bf294c19ef09f8edc",
      "source_batch": 129,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1005"
      ],
      "key": null,
      "source_text": "仅赠予荣获三后冠的女王们的歌曲。\\n华丽的同时，也有着顽强追梦的美。",
      "source_fingerprint": "80a55b72c2a740cff1f9760c28c28e5735e42fdf5cd90aca6aa814166601e7ba",
      "current_text": "Ca khúc chỉ dành tặng những nữ hoàng giành Triple Tiara.\\nLộng lẫy nhưng cũng mang vẻ đẹp kiên cường theo đuổi ước mơ.",
      "current_fingerprint": "fe6d7c1da5cef6ce02d7e644a3dd738fa4c344064e188bb564c76c8ada82c177",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f812a8a4770d3d3afe8e2dbb",
      "source_batch": 129,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1006"
      ],
      "key": null,
      "source_text": "献给刚出道赛马娘的首支歌曲。\\n吹响那开场号！响彻至终点吧！！",
      "source_fingerprint": "253236cd6601347b62670db8bec41a60e6d01f6b0b49164e7693f8613b894889",
      "current_text": "Ca khúc đầu tiên dành tặng Uma Musume vừa ra mắt.\\nHãy thổi vang tiếng kèn khai màn! Vang tới tận vạch đích!!",
      "current_fingerprint": "6e113d2c32df9fdd2ccca192d6ade12153887e66f36fedbf7043c226e116148f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:082c951d547d52abdfc82222",
      "source_batch": 129,
      "entry_index": 75,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1007"
      ],
      "key": null,
      "source_text": "在新马级比赛中表现出色的希望之星们展现的清爽乐曲。\\n赛马娘们疾驰着，她们的梦想闪耀着七色的光芒。",
      "source_fingerprint": "f371580e198265e7db1e610301664c7f66a398b93354c0abeae3e04be3b5ced0",
      "current_text": "Giai điệu tươi mát do những ngôi sao hy vọng tỏa sáng trong các cuộc đua tân mã thể hiện.\\nCác Uma Musume lao đi, giấc mơ của họ lấp lánh bảy sắc màu.",
      "current_fingerprint": "8cd111fd7a2be6235cbd6e2c7f52ffd40edf7b0a6d75be3153dc3d2c717644bb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        },
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:5c43ce2538bc2cf1f1d7249d",
      "source_batch": 129,
      "entry_index": 76,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1008"
      ],
      "key": null,
      "source_text": "只有以顶点为目标，不懈努力之人才能抵达。\\nNEXT FRONTIER――这是为永盛不衰的霸者设立的舞台。",
      "source_fingerprint": "8c2abad9b89360bb5d985eccb540592ecacaeb3fe094c633eec082e38077c1cd",
      "current_text": "Chỉ những ai không ngừng nỗ lực hướng tới đỉnh cao mới có thể chạm tới.\\nNEXT FRONTIER――đây là sân khấu dành cho bá chủ trường thịnh bất suy.",
      "current_fingerprint": "8e9c334d37a6900cbf879d4fb54465a60dad07c0ec1c02ed34ec4762e422b73d",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:53ceaec0846bade035eb9c52",
      "source_batch": 129,
      "entry_index": 77,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1009"
      ],
      "key": null,
      "source_text": "赠予即使在泥泞之中也以不屈斗志战斗下去的赛马娘的灵魂之歌。\\n即使被疾风骤雨夺去视线，脚步也不会停止。",
      "source_fingerprint": "08c402d5af3d6f7331266206ea14505e686c73614b64d80aeaeee15e2db9de73",
      "current_text": "Bản soul dành tặng những Uma Musume tiếp tục chiến đấu bằng ý chí bất khuất dù giữa bùn lầy.\\nDẫu cuồng phong mưa dữ che mất tầm nhìn, bước chân vẫn không dừng lại.",
      "current_fingerprint": "03b0fc6dc052d73e10464ef8eff5567e5ba3f7b50dc01872605349b6bdfd52b5",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:524437de3ce445f93754f76b",
      "source_batch": 129,
      "entry_index": 78,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1010"
      ],
      "key": null,
      "source_text": "照亮GⅠ胜利这一特别的瞬间，在天空绽放的歌曲。\\n只要一直追寻想要实现的未来的话，梦想就一定会实现！",
      "source_fingerprint": "f3facaa36bbf7bb1d711f925fe82b210472b6cc0121ca03aac4be7969dfb01ce",
      "current_text": "Ca khúc nở rộ trên bầu trời, soi sáng khoảnh khắc đặc biệt của chiến thắng GⅠ.\\nChỉ cần luôn theo đuổi tương lai muốn đạt tới, ước mơ nhất định sẽ thành hiện thực!",
      "current_fingerprint": "20fba469a52b6d3fbc8220cb7fc0f301dcd55a7f00150faba58ab27db89594d0",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:43443b41e5b8f9645c1ec7ce",
      "source_batch": 129,
      "entry_index": 79,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1012"
      ],
      "key": null,
      "source_text": "无论奔跑还是玩耍，我们都全力以赴！　用旋律来承载\\n大家缤纷的梦想――Let's Go Starting Gate!",
      "source_fingerprint": "dee200ed6fca9f666e15df40ab35ff8f946f45fa1834e9d1be666b1d9f98ce25",
      "current_text": "Dù chạy hay chơi, chúng ta đều hết mình! Dùng giai điệu để chở\\nnhững giấc mơ đầy màu sắc của mọi người――Let's Go Starting Gate!",
      "current_fingerprint": "1aa9f9c2d7a47059142e035a481af00a7717b9a61eaa5b9a98a51ebf5c527f45",
      "risk_flags": [
        "locked_term_mismatch",
        "absence_risk"
      ],
      "risk_score": 13,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
          "target_vi": "Dốc hết sức",
          "matched_aliases": [
            "全力"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:2af1dcfb7fbeb84d4e7b2a54",
      "source_batch": 130,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1013"
      ],
      "key": null,
      "source_text": "星光照亮前路，你的未来充满光明。\\n为支持我的人们表达感谢的1曲。",
      "source_fingerprint": "7641ddc99e7ffeb05e026364d9bba1df777bf3d5166ab0d398a9850fb17c6ade",
      "current_text": "Ánh sao soi sáng con đường phía trước, tương lai của bạn ngập tràn ánh sáng.\\nMột ca khúc gửi lời cảm ơn đến những người luôn ủng hộ tôi.",
      "current_fingerprint": "4a38cfec3eb73d6a48d20622bf3a3cc907c6c29b46c22b65af14ecfd8713aa60",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.6b9641d2417b",
          "target_vi": "Ánh sáng",
          "matched_aliases": [
            "光明"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6dc6c1ef4029f090a2ee316c",
      "source_batch": 130,
      "entry_index": 1,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1021"
      ],
      "key": null,
      "source_text": "キラキラ！トキメキ！ただ輝く景色を駆け抜ければいい！\\nだって、僕らは愛されるために生まれてきたのだからっ！",
      "source_fingerprint": "73103edd8673496b46e80d574eca927d92a6e86ad5235e4e8327975002ace8f2",
      "current_text": "Lấp lánh! Rung động! Chỉ cần chạy xuyên qua khung cảnh rực sáng là được!\\nBởi vì chúng ta sinh ra để được yêu thương mà!",
      "current_fingerprint": "9ba548ebb8896b02fd6c4dba60257d0a1c4bcbb2d0d30b2dddee48ea3121e4f8",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:9a08773c1635145f9c653503",
      "source_batch": 130,
      "entry_index": 2,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1023"
      ],
      "key": null,
      "source_text": "经常吵架，也互不道歉――但是，想永远一起欢笑下去。\\n这是青涩而又略带苦涩的，我们的友情应援歌。",
      "source_fingerprint": "e0d3797827b94fee2e8976b0de37eceade8a45baf959b6798ccec16e26701f01",
      "current_text": "Thường xuyên cãi nhau, cũng chẳng ai chịu xin lỗi――nhưng vẫn muốn mãi mãi cùng nhau cười vui.\\nĐây là khúc cổ vũ tình bạn non trẻ, ngọt ngào mà hơi đăng đắng của chúng ta.",
      "current_fingerprint": "d50943b49266dc3da19722a30ea9daeb620a43c5383af4c4c66c88cf1c8785ff",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:4356f25f4741607a818a6b75",
      "source_batch": 130,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1024"
      ],
      "key": null,
      "source_text": "把过去、现在所经历过的全部装进宝箱，面向未来！\\n――来吧，让整个世界充满『最喜欢了！』吧。",
      "source_fingerprint": "9e02d74559e808073ffeb2a8ef6329c1fc7177c59ec1755ab2bb469d0800f140",
      "current_text": "Hãy cất tất cả những gì đã trải qua trong quá khứ và hiện tại vào rương báu, rồi hướng tới tương lai!\\n――Nào, hãy lấp đầy cả thế giới bằng câu 『Mình thích nhất!』.",
      "current_fingerprint": "73dc7e30ccd2ffd9d165db5708e35142d471fffebbff151b99ca88210a541b01",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:34bcf34bd6b40461dd198bea",
      "source_batch": 130,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1025"
      ],
      "key": null,
      "source_text": "疾驰的一等星闪耀着，充满勇气与希望的歌曲。\\n心动的预感――那就是比赛开始的信号",
      "source_fingerprint": "316e2a7163d6866624623d20eb585422f060c2a13763ce6ddae613c616b180a6",
      "current_text": "Một ca khúc tràn đầy dũng khí và hy vọng, như ngôi sao sáng nhất đang lao đi rực rỡ.\\nLinh cảm khiến tim rung động――đó chính là tín hiệu cuộc đua bắt đầu.",
      "current_fingerprint": "9a0436d1ef50634a9cc894907485e10d5ab237a05d56d2442d24f8d6d05917e1",
      "risk_flags": [
        "very_long_target",
