    {
      "uid": "zhcn:3fe1b6fe8e6d5a57c7f8e100",
      "source_batch": 130,
      "entry_index": 8,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1029"
      ],
      "key": null,
      "source_text": "想要与你一决胜负。少女们心怀绝不退让的信念，登上舞台。\\n无论是灯火或是烟花……无论怎样的光芒，都绝不可能比身为“主人公”的她们更为闪耀。",
      "source_fingerprint": "451e1bf65f2a4495d2cedac5a3e005536f03281342ef3df4a281853565d4b362",
      "current_text": "Muốn phân thắng bại với bạn. Những cô gái mang niềm tin không bao giờ nhượng bộ bước lên sân khấu.\\nDù là ánh đèn hay pháo hoa… chẳng thứ ánh sáng nào có thể rực rỡ hơn họ, những 『nhân vật chính』.",
      "current_fingerprint": "b01e188dbab31d33ca04dbeebee43e9863c47e49c74ec783efe0b2fa6bfec49a",
      "risk_flags": [
        "negation_capability_risk",
        "absence_risk"
      ],
      "risk_score": 10,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b89010f4405f60f723dba30f",
      "source_batch": 130,
      "entry_index": 9,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1030"
      ],
      "key": null,
      "source_text": "因为有认真的你陪在身边，我才不论何时都能朝着胜利冲刺！\\n充满活力的青春之歌！",
      "source_fingerprint": "903059c11428286414447e28b27c7b6750c61944fd255502e9019b86b5fab5c8",
      "current_text": "Bởi có bạn luôn nghiêm túc ở bên, nên bất cứ lúc nào tôi cũng có thể lao thẳng tới chiến thắng!\\nMột khúc ca tuổi trẻ tràn đầy sức sống!",
      "current_fingerprint": "39c6bd2975e378dfcae7c4b4c004631e18d8682a8a103e5a35b8ad1123499f7a",
