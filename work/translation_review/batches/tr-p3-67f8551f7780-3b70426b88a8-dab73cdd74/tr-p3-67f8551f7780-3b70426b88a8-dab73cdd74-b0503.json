    },
    {
      "uid": "zhcn:7b617fbe398dac5891c75ec7",
      "source_batch": 130,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1026"
      ],
      "key": null,
      "source_text": "若我启程奔跑的话——这是一首融入了虚幻而坚强意志的歌曲。\\n将的思念藏在心中，向夜空中高悬的明月祈祷。",
      "source_fingerprint": "5e905da63e6e793b2e43a4f06587a18e8bc2209eba77821546a19d68debad554",
      "current_text": "Nếu tôi cất bước chạy――đây là ca khúc gửi gắm một ý chí mong manh mà mạnh mẽ.\\nGiấu nỗi niềm trong tim, cầu nguyện với vầng trăng treo cao trên bầu trời đêm.",
      "current_fingerprint": "2a4b8c1c35728deaf38c8899ddc8e22968f7c37793fc76b0f670c47787ec03bb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6d1498bbabc0338106c4409b",
      "source_batch": 130,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1027"
      ],
      "key": null,
      "source_text": "心中所起誓的是『最快』二字！　直到极限的尽头\\n疾驰的赛马娘们遵循本能地呼喊！！",
      "source_fingerprint": "58d11166ef0fea76dec387749bf2fd196b5992cef50c8c12d3f8e75670795f01",
      "current_text": "Điều đã thề trong tim chỉ có hai chữ 『nhanh nhất』!　Cho đến tận cùng giới hạn,\\nnhững Uma Musume lao vun vút cất tiếng gào theo bản năng!!",
      "current_fingerprint": "f3caee041bd8ba23d82dac717e8bf64e368bdee8e8a5c197b821a2a9e44866fd",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:317744a81c16e2f2bc618e52",
      "source_batch": 130,
