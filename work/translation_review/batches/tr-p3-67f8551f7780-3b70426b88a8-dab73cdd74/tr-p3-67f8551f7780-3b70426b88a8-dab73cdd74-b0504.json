{
  "schema_version": 1,
  "policy_version": 3,
  "plan_id": "tr-p3-67f8551f7780-3b70426b88a8-dab73cdd74",
  "batch_id": "tr-p3-67f8551f7780-3b70426b88a8-dab73cdd74-b0504",
  "context_snapshot_sha256": "dab73cdd749801d75d5c6a1648320c1de6fc87f59049ed2a44a77e335956e423",
  "source_bridge_policy_sha256": "17e70931bc5face8ac299d5bedacb78fddb59704ab91dc4095c6d76142178d54",
  "review_generation": "retrospective-canonical-full-review",
  "context_mode": "embedded-first-lazy-extra",
  "items": [
    {
      "uid": "zhcn:43b89551a25dd48b4a2ff954",
      "source_batch": 130,
      "entry_index": 10,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1031"
      ],
      "key": null,
      "source_text": "对比赛的渴望、执着、焦燥……能感受到炽热而沉重的灵魂的歌曲。\\n即使依旧被命运所囚禁，也无法停止追寻希望的脚步。",
      "source_fingerprint": "b4384c7ab92038ef64b37e3277341dd9f2c6002d19938260af892da0e53b5438",
      "current_text": "Một ca khúc khiến ta cảm nhận được linh hồn nóng bỏng mà nặng trĩu bởi khát vọng, chấp niệm và nôn nóng với cuộc đua…\\nDù vẫn bị số phận giam cầm, bước chân tìm kiếm hy vọng vẫn không thể dừng lại.",
      "current_fingerprint": "a21ef3c26bda107c123bc264d0ce12b289fe72d2e480a7de945352570bf43058",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:9743508c73999cd1196c3ae4",
      "source_batch": 130,
      "entry_index": 11,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1032"
      ],
      "key": null,
      "source_text": "与劲敌一同演唱的爽畅歌曲。\\n『我将与你一同追寻梦想』――这是个铭刻于心的故事。",
      "source_fingerprint": "e55e4f89854dc11ac05cd4c9f79e2d6ba262a2c70ca3651dbd0f9b704e2ceab0",
      "current_text": "Một ca khúc sảng khoái được cất lên cùng đối thủ.\\n『Tôi sẽ cùng bạn theo đuổi giấc mơ』――đó là câu chuyện khắc sâu trong tim.",
      "current_fingerprint": "122ca6ca9dd4d699a85bc24ba6ff2a77c8cc9abcb0751f5aaed17fd1c85dbf18",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:507f1caa3e66bf528e406006",
      "source_batch": 130,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1033"
      ],
      "key": null,
      "source_text": "这首乐曲中寄托着大家对未来的憧憬，即便是满天繁星也不及\\n这份心意那般耀眼。你也应是观众之一——梦幻灯光秀，开幕！",
      "source_fingerprint": "ed00fb0f71fe1f9c231f165a2983f1e5fc26c0beeb5ff0a741735909f7d5d637",
      "current_text": "Ca khúc gửi gắm khát vọng tương lai của mọi người; ngay cả trời sao cũng chẳng thể sánh bằng\\nánh sáng của tâm ý này. Bạn cũng là một khán giả――màn trình diễn ánh sáng trong mơ, khai màn!",
      "current_fingerprint": "8afb758f8e34c8dc6ce1d1d0df4fb67058add33e433a359d97e07ae423bc81f2",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:9680c95dbe96a9a386e62b7e",
      "source_batch": 130,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1034"
      ],
      "key": null,
      "source_text": "有欢笑也有泪水！将赛马娘们的悠闲时光\\n咻♪的一下塞进去的学园生活之歌☆",
      "source_fingerprint": "b1a697247f2a4d9865c8c630c406626610657a1ec91cf10f70d6c43d10e02e52",
      "current_text": "Có tiếng cười, cũng có nước mắt! Một khúc ca đời sống học viện nhét trọn những khoảnh khắc thư thả của các Uma Musume\\nvào trong một tiếng vút♪ thật nhanh☆",
      "current_fingerprint": "4c951a5cf2d6019c27c5303b91508507a6567753b8c12233a85653ed08d4a1cf",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:5540d834b3601b910967023a",
      "source_batch": 130,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1035"
      ],
      "key": null,
      "source_text": "『因为已不是独自一人，所以才会变得更强』\\n大家一起哭泣、欢笑、奔跑――这是牵绊与青春的旋律。",
      "source_fingerprint": "0488fa70f0a556bacb822c2376f4fc56ee9d96b55d384e93b4973a6f15b55865",
      "current_text": "『Chính vì không còn đơn độc nên mới có thể trở nên mạnh mẽ hơn』\\nCùng nhau khóc, cười và chạy――đây là giai điệu của gắn kết và tuổi trẻ.",
      "current_fingerprint": "a2755c07643b8ba9e0e23ddfbd9aa5196829de6426dc07413774af0578af3984",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f3c89f0e476ce770ed31a53f",
      "source_batch": 130,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1036"
      ],
      "key": null,
      "source_text": "超越春夏秋冬，只为与你共奏一曲合音。\\n胸中激昂的心跳化作旋律——终于，遇见大家了。",
      "source_fingerprint": "6f8b6418ea46c154ae2556d6d2190b112faeeac88ebbf3c72abb1f4ff3e4601a",
      "current_text": "Vượt qua xuân hạ thu đông, chỉ để cùng bạn hòa chung một khúc ca.\\nNhịp tim rộn ràng trong lồng ngực hóa thành giai điệu――cuối cùng, mình đã gặp được mọi người.",
      "current_fingerprint": "d31b43534bf9384a3446c98b8bb7910056f817bc7790ef18b8350cb145b564d3",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:da41ce34e2a1d18aee6b11db",
      "source_batch": 130,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1037"
      ],
      "key": null,
      "source_text": "向着未知的终点，未曾见过的景色――\\n神秘而又温暖的旋律，推动着你，轻语道：『奔跑起来吧』。",
      "source_fingerprint": "98a180c0907dc3357b0dae3151c6ab1a57d7ec74d42f55f1e6cbfc1290ef7b42",
      "current_text": "Hướng tới đích đến chưa biết, tới phong cảnh chưa từng thấy――\\nGiai điệu bí ẩn mà ấm áp đẩy bạn tiến lên, khẽ thì thầm: 『Hãy chạy đi』.",
      "current_fingerprint": "f690eaa43c510d951c48c2ee8749cbf13294909a727a7a156ffdc37039fff4da",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a2a3767321b11ae9cbca3b40",
      "source_batch": 130,
      "entry_index": 17,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1040"
      ],
      "key": null,
      "source_text": "友情、竞争、眼泪、笑容、不安、希望――\\n全部都是闪闪发光着的歌♪『青春』一定就是这样的感觉！",
      "source_fingerprint": "e50b55d8423cf9573edd350559d6daf12e1ca9752f11b1663599c9645aeb130f",
      "current_text": "Tình bạn, cạnh tranh, nước mắt, nụ cười, bất an, hy vọng――\\ntất cả đều là những khúc ca lấp lánh♪ 『Tuổi trẻ』 chắc hẳn chính là cảm giác như thế này!",
      "current_fingerprint": "d7eab2dda555c6d1d920eb1d87389d1e5aa886235d90beed6ae7e3480d41128a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:001d948bfb04b0b9edc11858",
      "source_batch": 130,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1041"
      ],
      "key": null,
      "source_text": "描绘了互相切磋的少女们的心意的乐曲。\\n梦想多么高远、多么宽广、多么蔚蓝生辉。来，一同前行吧！",
      "source_fingerprint": "ddbec9999bc68a0bb15899e52500f78e4bc5afbc0af44e45f19295a434dad578",
      "current_text": "Một ca khúc khắc họa tâm tư của những cô gái cùng nhau mài giũa bản thân.\\nGiấc mơ thật cao, thật rộng và xanh biếc rực rỡ. Nào, cùng tiến bước thôi!",
      "current_fingerprint": "854b7d902803b88ed1c2d2f425d3cf6d89d4ffaaedae9eac0d05adf09128f5fe",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ded1aefad3969e2e268d2d74",
      "source_batch": 130,
      "entry_index": 19,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1042"
      ],
      "key": null,
      "source_text": "要向着梦想奔跑。这是谱写了这份决心的乐曲。\\n即使迷茫，即使不安，也要向前迈进。将这首歌作为路标。",
      "source_fingerprint": "04b62a9696999297efd11a8b212e6b94a11d055275f7ed1d107baf6a6eed360a",
      "current_text": "Phải chạy về phía giấc mơ. Đây là ca khúc viết nên quyết tâm ấy.\\nDù lạc lối, dù bất an, vẫn phải tiến về phía trước. Hãy lấy bài hát này làm cột mốc dẫn đường.",
      "current_fingerprint": "d9e2b443b7afccec99296542d04f877280079598885968cb132250b29de2a564",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ac8faaa9e82a3f63fbb7166a",
      "source_batch": 130,
      "entry_index": 20,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1043"
      ],
      "key": null,
      "source_text": "紧靠着被冷雨冻僵的肩膀，誓要创造奇迹的少女们的歌曲。\\n我会无数次闪耀，只要有梦相伴——只要有你相伴。",
      "source_fingerprint": "ca95c7db1a5a9052dd000d45521132ec6f1b7db05b5809e994360abce87ca76a",
      "current_text": "Tựa vai sát bên nhau khi đã lạnh cóng dưới cơn mưa buốt giá, những cô gái thề sẽ tạo nên kỳ tích cất tiếng hát.\\nTôi sẽ tỏa sáng hết lần này đến lần khác, miễn còn có giấc mơ bên mình――miễn còn có bạn bên mình.",
      "current_fingerprint": "a77a67495c14a3483018237c3a66764f029e97ab51bc8e51c60511915f13a9c1",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:4fe4b4180bed948266ec76a9",
      "source_batch": 130,
      "entry_index": 21,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1044"
      ],
      "key": null,
      "source_text": "目标是，顶尖马娘偶像！拿起麦克风，以愉快的心情\\n用可爱又活泼♪的笑容来唱歌吧☆",
      "source_fingerprint": "613b8afc06885196bcec06d0e016de691faae00251bb6030b6e6a0addcb219c5",
      "current_text": "Mục tiêu là trở thành thần tượng Uma Musume hàng đầu! Cầm lấy micro, với tâm trạng thật vui vẻ,\\nhãy hát bằng nụ cười đáng yêu và tràn đầy sức sống♪☆",
      "current_fingerprint": "4fd90b67e36cdec2bb2b81e912dc53c883275061418014fe1a329a02f94b0a37",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b3f1e5632ce1ca42741a94b7",
      "source_batch": 130,
      "entry_index": 22,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1046"
      ],
      "key": null,
      "source_text": "『一逃到底☆SISTERS』将，冲入你的心灵！\\n毕竟，恋爱最重要的就是冲刺！对吧？",
      "source_fingerprint": "784d31dfde51518c790ff48c16274f6328fbf11533ce1e945f0debe1e6cb7946",
      "current_text": "『Ichi Nige Tōtō☆SISTERS』 sẽ lao thẳng vào trái tim bạn!\\nBởi vì trong tình yêu, điều quan trọng nhất chính là tăng tốc! Đúng không?",
      "current_fingerprint": "8861d5b5caeb1223a3ae72474cd35ffe46ac5f27337110c3a70a7bf092b4e947",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:26260496dfac85637d6f50e8",
      "source_batch": 130,
      "entry_index": 23,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1047"
      ],
      "key": null,
      "source_text": "轻轻回响于心灵的摇篮曲。\\n越是痛苦与疲惫时，越要『PAYAPAYA』。……有什么意见吗？",
      "source_fingerprint": "1cdaf19287081f2cf8ff0e6511e7d3bbcc92fcfeb69806c6a5623a4662dbf33f",
      "current_text": "Một khúc hát ru nhẹ nhàng vang vọng trong tim.\\nCàng đau khổ, càng mệt mỏi thì càng phải 『PAYAPAYA』. …Có ý kiến gì sao?",
      "current_fingerprint": "4bd970340e79d5fb06d356936ef9d8937ff0dabc13ef8985025680a7ab6ea5e0",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f7af6650002ea407eaa6f7a4",
      "source_batch": 130,
      "entry_index": 24,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1048"
      ],
      "key": null,
      "source_text": "闸门已经敞开。对奔跑者而言一切都是广泛而平等的。\\n――来吧，挑战吧！来吧，奔跑吧！向着那强风吹拂的方向！",
      "source_fingerprint": "3f76179a79e89d9aac291948c744a3efce397d8671916414db440a020f343cbd",
      "current_text": "Cổng xuất phát đã mở. Với những người chạy, mọi thứ đều rộng mở và bình đẳng.\\n――Nào, hãy thách thức! Nào, hãy chạy! Hướng về nơi cơn gió mạnh đang thổi!",
      "current_fingerprint": "94b177c891b6ebac33eeb8ef17b9b0bc1162b28f9b478e6917a78f9a4a310699",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:838b700b0e50a12fa745bfd1",
      "source_batch": 130,
      "entry_index": 25,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1049"
      ],
      "key": null,
      "source_text": "属于爆进！根据爆进！！为了爆进而作的歌曲！！！\\n听了这个的你，也是爆进伙伴了！（谈：班长）",
      "source_fingerprint": "63db370251f70bfc16dd743a4c1ffb3c7c8d8395b1ac27e52a9807d384cc4768",
      "current_text": "Một ca khúc của Bakushin! Theo Bakushin!! Và dành cho Bakushin!!!\\nBạn nghe rồi thì cũng là đồng đội Bakushin nhé! (Lời: Lớp trưởng)",
      "current_fingerprint": "c31296c8106c4c446f9c9687d64d327552b34b8314dd0eda818d04610f1eaf95",
      "risk_flags": [],
      "risk_score": 0,
