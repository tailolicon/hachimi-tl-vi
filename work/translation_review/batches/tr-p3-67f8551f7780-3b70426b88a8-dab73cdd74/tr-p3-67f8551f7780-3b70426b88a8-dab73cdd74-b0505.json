      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1071"
      ],
      "key": null,
      "source_text": "带着那无法抑制的心跳声飞翔起来吧♪\\n直奔那憧憬之地！的雀跃之歌！Take Off☆",
      "source_fingerprint": "dcd07586b6f177e6c1d3228f4f567307aee8ca068e444db0ca272fae2224a4a0",
      "current_text": "Hãy bay lên cùng nhịp tim không thể kìm nén ấy♪\\nThẳng tới miền đất hằng ao ước! Một khúc ca rộn ràng! Take Off☆",
      "current_fingerprint": "db46680c3bb3e176a7d0f63d5403853a1bde182e2786ca5e14f46ba87e77ce07",
      "risk_flags": [
