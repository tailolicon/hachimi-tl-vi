  "items": [
    {
      "uid": "zhcn:f1c556c705608cc092fe6f59",
      "source_batch": 130,
      "entry_index": 30,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1054"
      ],
      "key": null,
      "source_text": "歌颂激情、热血、一马当先的胜者之歌。\\n铭刻于历史的胜利之时，将永远留下其熊熊燃烧的余韵。",
      "source_fingerprint": "7684189df04e5f4d851f7689e47723383523e04066379ec3f9a55510c4cbb94f",
      "current_text": "Khúc ca của người chiến thắng, tôn vinh đam mê, nhiệt huyết và tinh thần dẫn đầu.\\nKhoảnh khắc chiến thắng khắc vào lịch sử sẽ mãi lưu lại dư âm cháy bỏng.",
      "current_fingerprint": "7692a439d6f7aad15675a5478d949906db8f476348171eff87dde8e851ec8af4",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:bd1185193ee53cb7750cb44a",
      "source_batch": 130,
      "entry_index": 31,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1055"
      ],
      "key": null,
      "source_text": "看那儿！是船！？还是UFO！？都不是，是小金船哒！！！\\nPeace Peace♪怎样～？这块地方被我掳走咯☆",
      "source_fingerprint": "c844b0ff87dd26a2d607a806bae3f6975f6bb1430729d07b31a86dae994b1382",
      "current_text": "Nhìn kìa! Là tàu!? Hay UFO!? Không, là Gold Ship bé nhỏ đây!!!\\nPeace Peace♪ Thế nào～? Chỗ này đã bị tui bắt cóc rồi☆",
      "current_fingerprint": "4d39f36156fee75b9274798db5839755daa3d23197cf1773ce6c15fcea053426",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:e206b23f6d7353c39ca57a84",
      "source_batch": 130,
      "entry_index": 32,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1056"
      ],
      "key": null,
      "source_text": "由名门目白家演唱的，旋律庄严的合唱曲。\\n目白家族的荣光，无论何时都至高无上，绵延不绝――",
      "source_fingerprint": "483979e51f5217c2c9551ac0248eafb98a211317b64f2cc81580a0fcbabdf28e",
      "current_text": "Một bản hợp xướng trang nghiêm do danh gia Mejiro cất tiếng hát.\\nVinh quang của gia tộc Mejiro, bất cứ lúc nào cũng tối cao và trường tồn――",
      "current_fingerprint": "8becdfa94f58dcc30f326888965127dec7e1aa4158cf1fc0d54d309b9cbcb04c",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ea682e017009b260a37994e7",
      "source_batch": 130,
      "entry_index": 33,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1057"
      ],
      "key": null,
      "source_text": "一首伴着汗水与泪水的闪耀歌曲！闪闪发亮的可爱马娘偶像\\n背后是踏踏实实的努力☆",
      "source_fingerprint": "68b7fb5cc8212384928de2569e1f5fbc369ad6a2a58b72a063af10873ef89e0d",
      "current_text": "Một ca khúc lấp lánh cùng mồ hôi và nước mắt! Phía sau thần tượng Uma Musume đáng yêu, tỏa sáng rực rỡ\\nlà những nỗ lực bền bỉ và chắc chắn☆",
      "current_fingerprint": "b90289f5e9a5fe493e698a2e3a589d37c5f6201cec0d4dc84a81daaf8084c8bb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:95773ed3f946b9fb3b654d70",
      "source_batch": 130,
      "entry_index": 34,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1058"
      ],
      "key": null,
      "source_text": "一首歌颂自遥远的过去延续至今的灿烂光辉的歌曲。\\n那绵延不绝的光辉，还将继续奔向未来！",
      "source_fingerprint": "3b731c1b2292aa3b69eeae59b762774eeaaeb4eca1413075ab7afec8a4371bf9",
      "current_text": "Một ca khúc ca ngợi ánh hào quang rực rỡ kéo dài từ quá khứ xa xôi cho đến hôm nay.\\nÁnh sáng không ngừng nối tiếp ấy sẽ còn tiếp tục lao về phía tương lai!",
      "current_fingerprint": "2398db7e4b7cdb92c4ba9a720bda1c48356c1cd9816cd7e99079b08a6ec358a2",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:e1e6ffdcb42505d1070149c0",
      "source_batch": 130,
      "entry_index": 35,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1059"
      ],
      "key": null,
      "source_text": "在闪电战般的赛场上展开激烈竞争的同伴们，与她们所演唱的歌曲。\\n无论何时都想要保持微笑――\\n因此才要拼尽全力，奔向胜利的彼岸！",
      "source_fingerprint": "050a9d2b20ad70c365bc636fad4eed4a3b313aaef94f486257b1715bf0efb60f",
      "current_text": "Ca khúc được hát bởi những người bạn đang cạnh tranh quyết liệt trên đường đua nhanh như chớp.\\nDù lúc nào cũng muốn giữ nụ cười――\\nchính vì thế mới phải dốc hết sức, chạy tới bờ bên kia của chiến thắng!",
      "current_fingerprint": "fd42d12ee8a0119dc6ec2f501f1299185713afd62bbc1a413ddf96b6982d2638",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
          "target_vi": "Dốc hết sức",
          "matched_aliases": [
            "全力"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:d25304bb9c6d48340815342b",
      "source_batch": 130,
      "entry_index": 36,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1060"
      ],
      "key": null,
      "source_text": "一首献给肩负辉煌未来的诸位英雄的歌曲。\\n目标是名为梦想的财宝，向着未知的大海――启航吧！！",
      "source_fingerprint": "9f1d646027fad2dbcd3f8e7ed47a98e273cf95630ae34bf56fade12c943e191a",
      "current_text": "Một ca khúc dành tặng những vị anh hùng đang gánh trên vai tương lai huy hoàng.\\nMục tiêu là kho báu mang tên giấc mơ; hướng tới đại dương chưa biết――ra khơi nào!!",
      "current_fingerprint": "f66208f33738583754c87519f44c0226fa3972df82522c5b6a5a147d9a5f48b0",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:46a04059ea36edd214d1cc99",
      "source_batch": 130,
      "entry_index": 37,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1061"
      ],
      "key": null,
      "source_text": "有争斗、也有和睦！摇曳地♪塞满了赛马娘们软乎乎～时光\\n的学园欢歌♪",
      "source_fingerprint": "72a522d7026238744cf1ab2dd9e179cf66bcf0eb40f826a269e2dd39df6b098d",
      "current_text": "Có cãi vã, cũng có hòa thuận! Một khúc ca học viện nhẹ nhàng♪ nhét đầy những khoảng thời gian mềm mại～ của các Uma Musume\\ntrong từng giai điệu đung đưa♪",
      "current_fingerprint": "50c274cdfaa8e781a0132b9d2ca7b0072f0fc8d8a1c3d117cae71781fd6aaf96",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:58a590e60b4da1ad36ab63a5",
      "source_batch": 130,
      "entry_index": 38,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1062"
      ],
      "key": null,
      "source_text": "鸣奏出因期待而跃动的心，相当令人跃跃欲试的歌曲♪\\n将这特别的梦，传达至大本命◎的你身边！",
      "source_fingerprint": "288e210bfc4a8c47003fa31948819c16903342c1b68c247f05c08fec310da6d6",
      "current_text": "Một ca khúc khiến trái tim rộn ràng vì mong đợi, nghe là muốn lao vào thử sức ngay♪\\nHãy gửi giấc mơ đặc biệt này tới bạn, lựa chọn số một◎!",
      "current_fingerprint": "0f8d1182d3c8b93c975181920ebb852472c90d8d1246fca148f674101d99ec6c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:cba6cecbef73bd7af8dad5c2",
      "source_batch": 130,
      "entry_index": 39,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1063"
      ],
      "key": null,
      "source_text": "绝不背叛那日的约定与决心。\\n这灰色的觉悟，将成为最闪耀的希望。",
      "source_fingerprint": "fcb59853842fefc019d41ee86c3d7c8ed562dd6b775c6f4b3c91ac32607d825b",
      "current_text": "Tuyệt đối không phản bội lời hứa và quyết tâm của ngày ấy.\\nQuyết tâm màu xám này sẽ trở thành niềm hy vọng rực rỡ nhất.",
      "current_fingerprint": "55381aeae518b6a4c9597b06b8dda65f1d649f1910c284c41963c6d3638c7831",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:1d0327588b26cadc305a30b5",
      "source_batch": 130,
      "entry_index": 40,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1064"
      ],
      "key": null,
      "source_text": "将胜利握入手中。疾驰至天涯海角。\\n无人可挡，那觉悟便是――『一马当先，万马无光』。",
      "source_fingerprint": "07f6b20f4c60ae2c2dfa464eb93288b1a24f7ff349bd0d341dd22031461a6e0f",
      "current_text": "Nắm chiến thắng trong tay. Phi tới tận cùng trời đất.\\nKhông ai có thể cản bước; quyết tâm ấy chính là――『một ngựa dẫn đầu, vạn ngựa lu mờ』.",
      "current_fingerprint": "2fa2fe5bfd4abb925374333fcd4d931c3759ec503bc5be94340fb547ee6941c4",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:edc585d5fe60b7db9c7e06ef",
      "source_batch": 130,
      "entry_index": 41,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1065"
      ],
      "key": null,
      "source_text": "温柔地向支持者们表达感谢的，治愈的旋律。\\n我想用硕大的爱去回应。与你一同，踏起柔和的步调。",
      "source_fingerprint": "8b4ae24abdabae1ed216e6ddd029cea9234660753045f8cdbaebc12891630a6a",
      "current_text": "Giai điệu chữa lành, dịu dàng gửi lời cảm ơn đến những người luôn ủng hộ.\\nTôi muốn đáp lại bằng tình yêu thật lớn lao. Cùng bạn, bước theo nhịp điệu êm đềm.",
      "current_fingerprint": "365657a90a4f64f9627791286501933f13e4acfc08ddfe678a0ee365aae17557",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:0e4f467bdb420ebcabcb5130",
      "source_batch": 130,
      "entry_index": 42,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1066"
      ],
      "key": null,
      "source_text": "势必劈开所有迎面而来的狂风。轰鸣着白色斗志的1曲。\\n胜利不可退让，故继续抗争。那就是，咱的战斗之道呀。",
      "source_fingerprint": "9a3bf4c3df6ba37a480934770c192e9f7b329d66f00b51dac42a5640166e89b4",
      "current_text": "Nhất định sẽ xé toạc mọi cơn cuồng phong ập tới. Một ca khúc gầm vang ý chí chiến đấu trắng rực.\\nChiến thắng không thể nhường, vì vậy ta tiếp tục chiến đấu. Đó chính là cách ta chiến đấu.",
      "current_fingerprint": "f43b404e983074e19e1064fa8f253963e02e9e7f1799182358da6e7dfbdad630",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6e85776dbf767bec4076f297",
      "source_batch": 130,
      "entry_index": 43,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1067"
      ],
      "key": null,
      "source_text": "以向往之心纺织而成的，纯情之歌。憧憬永不会停止。\\n因为……唯有这场比赛，我不愿败北。",
      "source_fingerprint": "a4b1823c88499c79c354f7056d09af963ce26fcd466f13c0f196428be047afef",
      "current_text": "Một khúc tình ca trong sáng được dệt nên từ lòng ngưỡng mộ. Niềm khát khao sẽ không bao giờ dừng lại.\\nBởi vì… chỉ riêng cuộc đua này, tôi không muốn thua.",
      "current_fingerprint": "a7cdcd19b8a71e325d679fbf811e22813afb6f380198e12aa100f9d5879fd711",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:27d9e84b2202b9fa15c55fb8",
      "source_batch": 130,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1068"
      ],
      "key": null,
      "source_text": "唱响那憧憬之梦、那背负心愿而奔跑的决意的歌曲。\\n做一个永不会结束的梦吧――不论几次、不论何时。",
      "source_fingerprint": "dfcccf66ae8e67f5f45eb3f0141147d5aaf9263a289cf97032ff77ed752be89f",
      "current_text": "Ca khúc cất lên giấc mơ ngưỡng vọng và quyết tâm chạy khi mang theo những tâm nguyện trên vai.\\nHãy mơ một giấc mơ không bao giờ kết thúc――dù bao nhiêu lần, dù vào bất cứ lúc nào.",
      "current_fingerprint": "451d80a0ea7f8abdbb06dc0c4215b5b456b8cededc274433f9653a765c7c997f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:38e3256fe07ae725eae30ea0",
      "source_batch": 130,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1069"
      ],
      "key": null,
      "source_text": "比起未来、比起过去，更要把握燃烧生命的现在――\\n心怀对那刹那光辉的祈祷，玻璃的叙事曲。",
      "source_fingerprint": "438c5ac49d388c5e37f9cb0751b6193ec819f7a105a775faa815e1a24dee18bd",
      "current_text": "Hơn cả tương lai, hơn cả quá khứ, hãy nắm lấy hiện tại nơi sinh mệnh đang cháy――\\nMột bản ballad thủy tinh mang lời cầu nguyện cho ánh sáng lóe lên trong khoảnh khắc ấy.",
      "current_fingerprint": "5a2b8f0503bdbdde846af80071d67287cea51ce65672a012ddb476e013900811",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
