      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1070"
      ],
      "key": null,
      "source_text": "轻柔地、婀娜地……如微风般奔跑的自由之歌。\\n旋律时而改变风向，随心吹拂。",
      "source_fingerprint": "1d0bc38637afe7e810a7e0106c69d731bbf4db8e9c43c0f7efd8c3672ad7a62f",
      "current_text": "Nhẹ nhàng, uyển chuyển… một khúc ca tự do chạy như làn gió thoảng.\\nGiai điệu đôi khi đổi hướng gió, rồi tự do thổi theo ý mình.",
      "current_fingerprint": "6885cd2adc3bcb0082cb35ccb84e8fc4b5828d95ffd53486299d27f6f6efc2b9",
      "risk_flags": [
        "very_long_target"
      ],
