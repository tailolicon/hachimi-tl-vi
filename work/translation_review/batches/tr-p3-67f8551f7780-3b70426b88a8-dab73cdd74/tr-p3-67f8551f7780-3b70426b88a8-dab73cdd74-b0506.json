    {
      "uid": "zhcn:e59583f756f5f94b87bac5ee",
      "source_batch": 130,
      "entry_index": 57,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1081"
      ],
      "key": null,
      "source_text": "各自的道路不断交汇，劲敌们亦不断重逢。\\n将炽热的激情埋藏于心，Running to the top!",
      "source_fingerprint": "f605fef2b26561368da913f1574ff483e4d3e22077688cca5d12f4bbe7a9b142",
      "current_text": "Những con đường riêng không ngừng giao nhau, các đối thủ cũng liên tục tái ngộ.\\nGiấu niềm đam mê cháy bỏng trong tim, Running to the top!",
      "current_fingerprint": "76192a90cdffb750324bcd9dad29fb0115617788852aef8834b5537d8eeb1d16",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:fcaf8910f5a4288b34f940fe",
      "source_batch": 130,
      "entry_index": 58,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1082"
      ],
      "key": null,
      "source_text": "少女们背负着积年夙愿，向那前所未有的胜利发起挑战。\\n誓要凯旋，踏上了异国征程――荣光的大门，就在她们眼前。",
      "source_fingerprint": "0921fca2a638e3dd10e87d3f286c83b742508beb2412184bc6cc6446f1cbbd8e",
      "current_text": "Những cô gái mang trên vai tâm nguyện ấp ủ bao năm, thách thức chiến thắng chưa từng có.\\nThề sẽ khải hoàn, họ bước lên hành trình nơi đất khách――cánh cổng vinh quang đang ở ngay trước mắt.",
      "current_fingerprint": "ee8afabd3ca14789d31a7ea125ce47feea187ab4c19d0927531f5e2121d322b4",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.1c68057834c9",
          "target_vi": "Khải hoàn",
          "matched_aliases": [
            "凯旋"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:df6e4a2b1fe9008a25ad4116",
      "source_batch": 130,
      "entry_index": 59,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1083"
      ],
      "key": null,
      "source_text": "夏天ー！祭典ー！！特雷森音头ーーー！！！\\n随时都可以参与其中哦！来吧来吧，你的意愿如何ーー？？",
      "source_fingerprint": "68a6a8bdc80e483c68c92c8284be735a403ece5ff09d359e815f87575052a9b1",
      "current_text": "Mùa hèー! Lễ hộiー!! Tracen Ondoーーー!!!\\nLúc nào cũng có thể nhập hội nhé! Nào nào, ý bạn thế nàoooーー??",
      "current_fingerprint": "3aad501680ab113879444474db154739b82bdd292f9aeee6dbeed1898da7ee59",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f9b3b896c50775a6b1a7b222",
      "source_batch": 130,
      "entry_index": 60,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1084"
      ],
      "key": null,
      "source_text": "永不放弃，直至触及梦想――！\\n怀着满腔热情，奔向胜利之路吧！",
      "source_fingerprint": "2e586ecce2a0c8b93baff0a014ac92b0f6867c4c2d3c4aa2c624f02a208c56fd",
      "current_text": "Không bao giờ bỏ cuộc, cho đến khi chạm tới giấc mơ――!\\nMang theo nhiệt huyết tràn đầy, hãy chạy trên con đường dẫn tới chiến thắng!",
      "current_fingerprint": "cd31e6ad56ed340fc04a2229990bb2a4e80f5a222111fbbfccec31752816c7fb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:0d92504965fd97040a6adb45",
      "source_batch": 130,
      "entry_index": 61,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1085"
      ],
      "key": null,
      "source_text": "热血上涌、心跳加速！情绪高昂、激动不已！\\n让我们在这场喧闹至极的大祭典上，朝着胜利冲刺吧！",
      "source_fingerprint": "0b037124c58a796ee614f50cac471be83c538a78c31d1e0f292b9c4fc689bee8",
      "current_text": "Nhiệt huyết dâng trào, tim đập tăng tốc! Cảm xúc lên cao, phấn khích tột độ!\\nTrong đại lễ hội náo nhiệt hết cỡ này, hãy cùng lao về phía chiến thắng!",
      "current_fingerprint": "9b2f2135657bf80690731988d04e64a9ee7a5f47cbb9c202c5a402b6ad6b4448",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:e681f26329b194f17fb9c11a",
      "source_batch": 130,
      "entry_index": 62,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1086"
      ],
      "key": null,
      "source_text": "如同谎言般酷帅的激昂歌曲，妆点着一年365天。\\n那样的搭档，会成为你的个性。──by「BoC'z」。",
      "source_fingerprint": "0b8dd2464447816c6aa4f35b24ae2f19306bd6f012988e5ada845602f5812dbc",
      "current_text": "Một ca khúc sôi động ngầu đến khó tin, tô điểm cho cả 365 ngày trong năm.\\nMột người bạn đồng hành như thế sẽ trở thành cá tính của bạn. ──by「BoC'z」.",
      "current_fingerprint": "418e9f450730a82fcadcee01d4285e0db19ef43dd632a1cbf80d5c3abdbdb4d7",
      "risk_flags": [
        "numeric_token_mismatch"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:0aea32c1f25ea5facb70c2bb",
      "source_batch": 130,
      "entry_index": 63,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1087"
      ],
      "key": null,
      "source_text": "辣妹赛马娘们统统嗨起来！为了辣妹而存在的歌曲！\\n我们是forever☆最强的赛马娘死党！",
      "source_fingerprint": "136a0208f99d39fb5f47bf336e163676cde7c8ab882f4a76c238405b22af2e4a",
      "current_text": "Các Uma Musume gyaru, quẩy hết mình nào! Một ca khúc sinh ra vì gyaru!\\nChúng ta là forever☆ hội bạn Uma Musume mạnh nhất!",
      "current_fingerprint": "4e7aa2d8fbf4dd0b8688ceae511af37f5b64845b301e47093a7456ef5706a032",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:926c5d6edef3833f197efa02",
      "source_batch": 130,
      "entry_index": 64,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1088"
      ],
      "key": null,
      "source_text": "纯度100%・运动员们的斗志，于歌舞中迸发而出！！\\n一场暴热的表演！！敬请期待！！！！",
      "source_fingerprint": "33524a57b8d4af0d6c80d12bf134042171b36beaf425d2756474fc7c9a718181",
      "current_text": "100% tinh khiết・ý chí chiến đấu của các vận động viên bùng nổ trong ca hát và vũ đạo!!\\nMột màn trình diễn nóng bỏng cực độ!! Xin hãy đón xem!!!!",
      "current_fingerprint": "cf88024f639d88aa905857833b83cfd49b68832f12b737b33c7800b816b00da6",
      "risk_flags": [
        "very_long_target",
        "numeric_token_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [],
