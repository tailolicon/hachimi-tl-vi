  "items": [
    {
      "uid": "zhcn:421b11e1dffbd75a43972983",
      "source_batch": 130,
      "entry_index": 50,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1074"
      ],
      "key": null,
      "source_text": "不可思议的轻盈，又有几分边缘感的乐曲。\\n那些日子的苦痛，请你一定不要忘记……好吗？",
      "source_fingerprint": "027f58c3c3f929365e50c5a4a6d6ed01dcee2ec7b7e44169f628850e0c95889a",
      "current_text": "Một ca khúc nhẹ tênh đến kỳ lạ, lại mang chút sắc cạnh.\\nXin bạn nhất định đừng quên nỗi đau của những ngày ấy… được chứ?",
      "current_fingerprint": "887a31ed5a522c81c28b82901b6d8018ccfd465488ee3cf20000661b11daa2f1",
      "risk_flags": [
        "negation_capability_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f3244435c442fdca562090fc",
      "source_batch": 130,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1075"
      ],
      "key": null,
      "source_text": "阿船's RAP！DE情绪燃起来！\\n阿船与RAP，搞一首试试吧！",
      "source_fingerprint": "c6283b47fce6fdef7a8620e9bcfc27a1581a6128d9bcac46c2941bd7ced65fd6",
      "current_text": "Gold Ship's RAP! DE cảm xúc bùng cháy!\\nGold Ship với RAP, làm thử một bài nào!",
      "current_fingerprint": "1482aa3d45184dce18ec2ba435bd768de03222654d23760711bf7cead663883c",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b73d94bb5b1e3464bc85cfc7",
      "source_batch": 130,
      "entry_index": 52,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1076"
      ],
      "key": null,
      "source_text": "一等星所编织的故事，延续至最闪耀的光辉。\\n那份心愿被继承――将再次成为梦想。",
      "source_fingerprint": "2610056ce1ea7e526a9783601c44669da603b2c1e97130f4707262d7b9722fa6",
      "current_text": "Câu chuyện được dệt nên bởi ngôi sao sáng nhất tiếp nối đến ánh hào quang rực rỡ nhất.\\nTâm nguyện ấy được kế thừa――và sẽ một lần nữa trở thành giấc mơ.",
      "current_fingerprint": "5db501fe8e6f2f9c7128492d165245550e33105084a484eb6dc189464711555f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6dd4880ed7fd03f4fa59783b",
      "source_batch": 130,
      "entry_index": 53,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1077"
      ],
      "key": null,
      "source_text": "平凡如今日，也一定很重要。\\n拥抱它，并梦想明天……『晚安』。",
      "source_fingerprint": "bb770dfe15d77feab1f54d085d374595bc2ee141bfae2f5b5f99f1e15b8f1439",
      "current_text": "Một ngày bình thường như hôm nay chắc chắn cũng rất quan trọng.\\nHãy ôm lấy nó, rồi mơ về ngày mai……『Chúc ngủ ngon』.",
      "current_fingerprint": "014bc97b8947b8c1b7ee9c799394687fa01681c8a8e83e5f96837d506bf1c94b",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:fd71c806d1cf94b86b061a8d",
      "source_batch": 130,
      "entry_index": 54,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1078"
      ],
      "key": null,
      "source_text": "献给一同追寻过憧憬的她，如此一首青春之歌。\\n虽然珍视你，但我不会败给你。与你就此……决胜！",
      "source_fingerprint": "acc08e58f8dd31c122ae923d6ccfa97c19328b5c67dac00aec9b2a8feaaa5d8c",
      "current_text": "Một khúc ca tuổi trẻ dành tặng cô ấy, người đã cùng tôi theo đuổi niềm ngưỡng vọng.\\nTôi trân trọng bạn, nhưng sẽ không thua bạn. Với bạn, ngay tại đây……phân thắng bại!",
      "current_fingerprint": "b4b414ac9f003f3000a5d13f8563b4a3895f74f793c924eb2a9950369cd9fad1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:c8d6742ae7d923a6662edbac",
      "source_batch": 130,
      "entry_index": 55,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1079"
      ],
      "key": null,
      "source_text": "赢得经典三冠的证明。\\n那首赛马娘们所憧憬之乐曲的，Club Arrange版本！",
      "source_fingerprint": "4c7babf59091adae73bb720dd7bbe8608454a997684fe7f5e98ad1581698a8dd",
      "current_text": "Minh chứng cho việc giành được Tam Quan Classic.\\nPhiên bản Club Arrange của ca khúc mà mọi Uma Musume đều hằng ao ước!",
      "current_fingerprint": "bcedbb854fa69d820a190236c49028dc9bca263251b65fdf5ceafbea9de89e27",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:370316158c0b1eef8eadaefb",
      "source_batch": 130,
      "entry_index": 56,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
