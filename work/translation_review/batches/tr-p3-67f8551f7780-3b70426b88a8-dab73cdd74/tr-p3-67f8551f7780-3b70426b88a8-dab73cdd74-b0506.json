      ],
      "key": null,
      "source_text": "无",
      "source_fingerprint": "484d55613910eb8c0917fe308b499d474115ced993cd002a17d7cc75254330a4",
      "current_text": "Không có",
      "current_fingerprint": "af48b64f2cb6cce392c175016f400d937dd8d183cfaf51511aac9e01ffe36666",
