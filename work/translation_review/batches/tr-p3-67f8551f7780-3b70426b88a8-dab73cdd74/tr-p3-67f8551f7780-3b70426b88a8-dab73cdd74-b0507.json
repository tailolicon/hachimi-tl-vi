  "items": [
    {
      "uid": "zhcn:7e34ec98b46d84890a23d16d",
      "source_batch": 130,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1095"
      ],
      "key": null,
      "source_text": "仅赠予荣获三后冠的女王们的歌曲。\\n华丽的同时，也有着顽强追梦的美。",
      "source_fingerprint": "80a55b72c2a740cff1f9760c28c28e5735e42fdf5cd90aca6aa814166601e7ba",
      "current_text": "Ca khúc chỉ được trao tặng cho những nữ hoàng giành được Triple Tiara.\\nVừa lộng lẫy, vừa mang vẻ đẹp kiên cường theo đuổi giấc mơ.",
      "current_fingerprint": "f0ddb01a6201045c4c1d0bbfca3346ee2ed02035b95369cec9f6cb2b769dde46",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:87c447fd0ee050870d41c119",
      "source_batch": 130,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1096"
      ],
      "key": null,
      "source_text": "在镜球的照耀下，你就是Dancing Queen──\\n带着心中的这份雀跃，手舞足蹈♪又酷又炫地☆热力四射！",
      "source_fingerprint": "05ec09283ca0574b9aa7f638b979c75100565e9820f714d365fcec7aefb0af2d",
      "current_text": "Dưới ánh cầu gương, bạn chính là Dancing Queen──\\nMang theo niềm rộn ràng trong tim, nhảy múa♪ vừa cool vừa flashy☆ bùng cháy hết mình!",
      "current_fingerprint": "b9d8adf5672b3f9d01a7627877cc6ebc36098e12d0fd74652f4b3d0440e111b6",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:3cd0a65c7d5035a3b8f6d5df",
      "source_batch": 130,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1097"
      ],
      "key": null,
      "source_text": "用只属于你的颜色将这个世界染上Vivid的色调，\\n用流行轻快的旋律散发出Bright的光芒，就是现在！",
      "source_fingerprint": "adbaaa792e03cd490a42102e6a48c32ff37737cc0ba2cc71ad89d6216f90377f",
      "current_text": "Hãy nhuộm thế giới này bằng sắc Vivid chỉ thuộc về bạn,\\nvà tỏa ánh Bright bằng giai điệu pop nhẹ nhàng――chính là lúc này!",
      "current_fingerprint": "ef13098b9870bf3caa9c7de4a946785d626a3e8508ce65fa126bdc5e10fd6683",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:c8830ebc155ac52082b0b646",
      "source_batch": 130,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1098"
      ],
      "key": null,
      "source_text": "在更迭交替的季节里，与你共度的时光如同永恒──\\n用不会褪色的色彩，让它永远停驻吧。",
      "source_fingerprint": "728233a1884fdac32524a9c481a0e7591eeda564d89b2fb09f1413503054a32d",
      "current_text": "Giữa những mùa thay phiên trôi qua, thời gian bên bạn tựa như vĩnh hằng──\\nHãy giữ nó mãi ở lại bằng những sắc màu không bao giờ phai.",
      "current_fingerprint": "569b695ef35514985d2776f313d940f05c6f2b9fc7e16830365903a79d7c1dc8",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a21e01872324441b62817296",
      "source_batch": 130,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1099"
      ],
      "key": null,
      "source_text": "决心要抓住那天看到的星星，她们朝着高远的天空奔驰而去。\\n前进的路只有一条──目标之星也只有一颗！抓住吧，最闪亮之星！",
      "source_fingerprint": "496c00173c818cfe4f3a02ea22dcdd8f3c5c5c39ecd727ba7c18f68611f125a2",
      "current_text": "Quyết tâm nắm lấy ngôi sao từng nhìn thấy ngày ấy, họ lao về phía bầu trời cao xa.\\nCon đường tiến lên chỉ có một──ngôi sao mục tiêu cũng chỉ có một! Hãy nắm lấy ngôi sao rực rỡ nhất!",
      "current_fingerprint": "6e88c04f697d5c5788567bec4f7fe65036699fe33d1a39ccf0c22a59753fcc8f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:60beef9737c849710b1f0c49",
      "source_batch": 130,
      "entry_index": 75,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1100"
      ],
      "key": null,
      "source_text": "What's up?用力嗨起来吧♪\\n最棒的开场小号！要送给大家喔～！！",
      "source_fingerprint": "657e948437412ae01972813d42f3118ba322cd5488208b9b90f6d4a1d51cd8b6",
      "current_text": "What's up? Quẩy thật sung nào♪\\nTiếng kèn mở màn tuyệt nhất! Tặng cho tất cả mọi người đó～!!",
      "current_fingerprint": "9c804372be9ed31cb0cbeff6658386f6bfc5bc3bf67fa59495eb97660542d4b4",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:914fdf6b320b30ea749efe86",
      "source_batch": 130,
      "entry_index": 76,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1101"
      ],
      "key": null,
      "source_text": "Are you ready!?一旦起跑就不会停下了喔？\\n融入节奏之后，Don't look back!!",
      "source_fingerprint": "c2dddc2878c633a5cca104eb025e1ab3b773b3024683cda49b1de90125281b48",
      "current_text": "Are you ready!? Một khi xuất phát thì sẽ không dừng lại đâu nhé?\\nHòa mình vào nhịp điệu rồi, Don't look back!!",
      "current_fingerprint": "2853b88b69dd02ad2c94b9443432f99cddd97c0c626c4591094d7b9ada5de6e4",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f907eaeee12ccecfba8d2bec",
      "source_batch": 130,
      "entry_index": 77,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1102"
      ],
      "key": null,
      "source_text": "还很渺小的我，在心中怀抱的是像苫小牧的天空一样广大的梦想！\\n想传达给最重要的你♪要更加更～加喜爱苫小牧！",
      "source_fingerprint": "1cea7f70137427bfac21df3e2e0b6147d90cba0b309e3433688a8326ae49c9e3",
      "current_text": "Tôi vẫn còn nhỏ bé, nhưng trong tim ôm một giấc mơ rộng lớn như bầu trời Tomakomai!\\nMuốn gửi đến bạn, người quan trọng nhất♪ Hãy yêu Tomakomai nhiều hơn, nhiều～ hơn nữa!",
      "current_fingerprint": "fe6634adfb713e53850b59c3c423baf8ec28c12844a0820bf1459333b0a4a58c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:361d65ed54a0c08234044841",
      "source_batch": 130,
      "entry_index": 78,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1103"
      ],
      "key": null,
      "source_text": "如同阳光一般温暖你的心。不用焦躁，慢慢来──\\n一步一脚印地前进，梦想正在彼方等着我们。",
      "source_fingerprint": "043e1805c72c4030434616251fc97e7937e955eeb4fafa2011bd5a5bbd2d5210",
      "current_text": "Ấm áp trái tim bạn như ánh mặt trời. Đừng vội, cứ từ từ thôi──\\nTiến từng bước vững chắc, giấc mơ đang chờ chúng ta ở phía trước.",
      "current_fingerprint": "d9148fb5754e555c843f26fcb0cdb98f643791160bd30189332e634a2e29e290",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:8d1ff68eb5fec7c73dc89ccd",
      "source_batch": 130,
      "entry_index": 79,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1104"
      ],
      "key": null,
      "source_text": "想要的并不只是理论，还有只能和你一起抵达的未来。\\n将情谊化为力量，超越无法估量的命运。",
      "source_fingerprint": "c475cefc4c6051ce631785b9cca1c80ed583ad4d0c58e6208c3352f92352a622",
      "current_text": "Điều tôi muốn không chỉ là lý thuyết, mà còn là tương lai chỉ có thể cùng bạn chạm tới.\\nBiến tình cảm gắn bó thành sức mạnh, vượt qua số phận không thể đo lường.",
      "current_fingerprint": "517b8e314775757e50b05f3369993c31565dd1d75e734abdb092f0e9c300198c",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
        "not_yet_risk",
        "absence_risk"
      ],
      "risk_score": 29,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.stat.power",
          "preferred": "Power",
          "accepted": [
            "Power"
          ],
          "forbidden": [
            "Sức mạnh"
          ],
          "matched_aliases": [
            "力量"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "Common EN-version stat label."
        }
      ],
