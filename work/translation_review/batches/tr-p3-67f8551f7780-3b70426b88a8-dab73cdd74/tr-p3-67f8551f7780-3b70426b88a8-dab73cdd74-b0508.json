  "context_snapshot_sha256": "dab73cdd749801d75d5c6a1648320c1de6fc87f59049ed2a44a77e335956e423",
  "source_bridge_policy_sha256": "4e901db6f39859ccdfa2c44a88f271e6396ead9376e5f2c691d98a1dcb66e4e2",
  "review_generation": "retrospective-canonical-full-review",
  "context_mode": "embedded-first-lazy-extra",
  "items": [
    {
      "uid": "zhcn:b779b71d6eaad5aaccec51f0",
      "source_batch": 131,
      "entry_index": 10,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1115"
      ],
      "key": null,
      "source_text": "轻快的摇滚节奏中高声歌唱，\\n黄金的浪漫！以一夜暴富为目标，Ships set sail!",
      "source_fingerprint": "d3a554eb47cf20fcc2fa516ae9e838c367dfc8375ef0c0b9a513f026710c5c49",
      "current_text": "Cất cao tiếng hát giữa nhịp rock rộn ràng,\\nkhúc lãng mạn vàng son! Nhắm tới đổi đời sau một đêm, Ships set sail!",
      "current_fingerprint": "907c72305fb55e7f516c88802fcf5c854778ba60656ea6b77e565f1ed4c57a81",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:fcd1331383c79a928263f391",
      "source_batch": 131,
      "entry_index": 11,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1116"
      ],
      "key": null,
      "source_text": "每天坚持努力，总有顺风的时候……应该吧！\\n配合流行的节奏，加油，加油，嗯！",
      "source_fingerprint": "f488b795cbd8a00e3b298ece9db629e25af1516712facbae738ae24448a0d139",
      "current_text": "Cứ kiên trì cố gắng mỗi ngày rồi sẽ có lúc gặp gió thuận… chắc vậy!\\nTheo nhịp điệu thịnh hành, cố lên, cố lên, ừ!",
      "current_fingerprint": "da76718ad9e432540ed92f998a10a1ec5f67f31698b4ccee12b972dae6480736",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a8a20bfc34708c643520f36f",
      "source_batch": 131,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1117"
      ],
      "key": null,
      "source_text": "毫无疏漏，毫无阻碍，一切都缜密安排。彻底的管理就是完美，\\n以钢铁意志贯彻的是『跑完全程的觉悟』——",
      "source_fingerprint": "d7dfc449a389c02fa5fb9131a48ef55298bb5fc2765032bb85f1e9b6947df8ee",
      "current_text": "Không sơ suất, không trở ngại, mọi thứ đều được sắp xếp tỉ mỉ. Quản lý triệt để chính là hoàn hảo,\\nvà thứ được thực hiện bằng ý chí thép là “giác ngộ chạy đến cùng” —",
      "current_fingerprint": "f70831ed1f3b8b751d00a21999b4d1d100f863db6fee12c539de8a8af57abb87",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.7f03adcd94bc",
          "target_vi": "Ý chí thép",
          "matched_aliases": [
            "钢铁意志"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:51b2d5edfe019398cabf49a6",
      "source_batch": 131,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1118"
      ],
      "key": null,
      "source_text": "涡轮全开！冲向极限的彼方！！\\n所谓不放弃，就是这样的啊！！",
      "source_fingerprint": "0fe6690de38dad7c4044f4be6859d9b419fdbf8bea8685c6dfad9f9a5e67d528",
      "current_text": "Turbo toàn khai! Lao tới phía bên kia giới hạn!!\\nKhông bỏ cuộc chính là như thế này đây!!",
      "current_fingerprint": "cfad081ebaeecaf7948e82aca7b3cdbb0d6c6e613e7cbcbf87b1235008a0316a",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:fe8c38bbe59ae35d2da24dfe",
      "source_batch": 131,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1119"
      ],
      "key": null,
      "source_text": "为心灵的杯子增添色彩的是……\\n怀着淡淡的忧伤，歌唱新的旅程。",
      "source_fingerprint": "7009403d793bf42a8497e245702625a8f6c43d84f6fa25e1234de36d9fdd0c2c",
      "current_text": "Thứ tô điểm sắc màu cho chiếc cốc của tâm hồn là…\\nmột chút man mác buồn, cất tiếng hát về hành trình mới.",
      "current_fingerprint": "bc2a7ae22ccc2b6e347ab4e022419b397a1391d7bbb8fa69f8b17f47231b8069",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f38c056deba6af3d2a76cfdd",
      "source_batch": 131,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1120"
      ],
      "key": null,
      "source_text": "像在春日暖阳下散步一样，为心灵充满元气吧！\\n无论什么事都能顺其自然！嗯，没问题的！",
      "source_fingerprint": "8fd71a3fb4b0cfb5770cc07f25a07199ab1765694d3dd294923ae59956118859",
      "current_text": "Như dạo bước dưới nắng ấm ngày xuân, hãy để trái tim tràn đầy sức sống!\\nChuyện gì rồi cũng sẽ tự nhiên ổn thôi! Ừ, không sao đâu!",
      "current_fingerprint": "35a30998ca1b9f60622928685d50b8777bf13a91b0e867c9c178ccb1569666d9",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ff27a7ac3762063397a2f11b",
      "source_batch": 131,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1121"
      ],
      "key": null,
      "source_text": "不管周围怎么说，我就是我。\\n虽然笨拙，但不是装出来的，我是真心在这里——",
      "source_fingerprint": "4c697fcf4ea08d38904c5a5673f813a108bd147eb93326913b46a032164c27fd",
      "current_text": "Dù xung quanh nói gì đi nữa, tôi vẫn là tôi.\\nDẫu vụng về, đây không phải giả vờ — tôi thật lòng đứng ở nơi này —",
      "current_fingerprint": "3d52ebbce3c47bd7622b9b76e16414d7dbffab10424d70c1b1abeb4aa8e544df",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:bb0f9be909faac76506fa971",
      "source_batch": 131,
      "entry_index": 17,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1122"
      ],
      "key": null,
      "source_text": "让脑髓都震颤的狂野斗争本能。\\n真正的王者，征服一切，走向荣耀。",
      "source_fingerprint": "9253b52c5a978ef6751b3ceaee5d12c8534cf582282adb7aaafff43a33757f16",
      "current_text": "Bản năng chiến đấu hoang dại khiến cả não tủy rung chuyển.\\nBậc vương giả đích thực chinh phục tất cả, tiến tới vinh quang.",
      "current_fingerprint": "aa0ca918a674cdebca45c6e56affc41059cf4556acd9aa31d2e133c1e2ff5696",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:62773de6dc049cf4cecfa9e7",
      "source_batch": 131,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1123"
      ],
      "key": null,
      "source_text": "不赌上一切的胜负有什么价值？\\n让热血沸腾，洞察极限，赌徒现在就要出手……！",
      "source_fingerprint": "bf11823f6ff3b451f92d93c5c1d8fe748194e613d8f0939342929cec4f2e91a5",
      "current_text": "Một cuộc phân thắng bại không đánh cược tất cả thì có giá trị gì?\\nHãy để máu nóng sục sôi, nhìn thấu cực hạn — con bạc giờ sẽ ra tay…!",
      "current_fingerprint": "ae0daf925f7ee1dd36ce41071e343ff9f69237d561e87a1e824ce66a8c1bc3b1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:70734ca03fe3aba8bfb5f8ac",
      "source_batch": 131,
      "entry_index": 19,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1124"
      ],
      "key": null,
      "source_text": "奔跑过的道路，与你的足迹，将一直延续到远方。\\n不要忘记，这如奇迹般的日子。",
      "source_fingerprint": "0c663adc7b5cc79c58e8447fe112297f319ee56226c78167c8e743d5ebfeb008",
      "current_text": "Con đường từng chạy qua cùng dấu chân của bạn sẽ còn kéo dài mãi về phía xa.\\nĐừng quên những ngày tháng tựa như phép màu này.",
      "current_fingerprint": "f8d643ec3ae8060e5319885169eff0161b7d3d1fe2423bceb491a46fd8764823",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:9677e6447f1746cbbde0492e",
      "source_batch": 131,
      "entry_index": 20,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1125"
      ],
      "key": null,
      "source_text": "充满挑战的路上，永远有大家在身旁。\\n用跳跃的步伐抓住闪闪发光的碎片吧！",
      "source_fingerprint": "4a70131b9cc1b241d7e5ebab4a62755e2533df2020d302497d88182997c7be7e",
      "current_text": "Trên con đường đầy thử thách, mọi người luôn ở bên cạnh.\\nHãy tung bước nhảy và nắm lấy những mảnh sáng lấp lánh!",
      "current_fingerprint": "b4b6bbcf8674ca04c6a9a2fb40f211adfdc2ebf8ad1a9839d7b452334243fd36",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:5c56b5293eadd8319e441873",
      "source_batch": 131,
      "entry_index": 21,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1126"
      ],
      "key": null,
      "source_text": "打破新时代之门的人……就是我！\\n追求最强灵魂的呐喊，我将撼动大地！",
      "source_fingerprint": "30532eb909841aad63a8ca7eb648edbc6b3d15d63c89c083cabacac81ca28d7b",
      "current_text": "Người phá tung cánh cửa của thời đại mới… chính là tôi!\\nTheo đuổi tiếng gào của linh hồn mạnh nhất, tôi sẽ làm rung chuyển mặt đất!",
      "current_fingerprint": "4d3785b28f938256401943a20ac289dc6bd539d0d494bbc181b1aa2f73157988",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:e61f8eb022bf32b489c6c2ad",
      "source_batch": 131,
      "entry_index": 22,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1127"
      ],
      "key": null,
      "source_text": "前进、行进、船进进！变成幼儿园小朋友的\\n小金船的Supisupi进行曲，Pisupiisu☆",
      "source_fingerprint": "bba2a9448f8e18806b582a260fb2138e3ef7cd3b7207ff2dc5f58b769f37494c",
      "current_text": "Tiến lên, tiến lên, thuyền tiến tiến! Biến thành bé mẫu giáo,\\nGold Ship bé nhỏ diễu hành Supisupi, Pisupiisu☆",
      "current_fingerprint": "488cfe352a1346b2029bdef41e0f8d1104906077ff66703a7b8148a9f4a8e4ef",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:437224849d5aedd5360f6189",
      "source_batch": 131,
      "entry_index": 23,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1128"
      ],
      "key": null,
      "source_text": "那天看到的星光，遥远而虚幻，\\n在这无法触及的地方消散——",
      "source_fingerprint": "b0f1d7911a81eda25af88eaec67353ae7c29419a889345d430660a69cdba81c7",
      "current_text": "Ánh sao nhìn thấy ngày ấy, xa xôi và hư ảo,\\ntan biến ở nơi không thể chạm tới —",
      "current_fingerprint": "dbf0967e5e0f44be830d446e9d8a6ce6f1fc6c654f3edba01590595703dfd31a",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:56b4a27a5890534aa5243ee4",
      "source_batch": 131,
      "entry_index": 24,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1129"
      ],
      "key": null,
      "source_text": "贯彻强烈意志的身姿，高贵而尊贵。\\n将苦难化为养分的钻石光辉，照亮未来。",
      "source_fingerprint": "447fa53d7f4a100c29a78799ac4e1f805dde3276d521d63437c16dc6e65c44ed",
      "current_text": "Dáng hình kiên định với ý chí mãnh liệt, cao quý và trang nghiêm.\\nÁnh kim cương lấy gian nan làm dưỡng chất sẽ soi sáng tương lai.",
      "current_fingerprint": "c10be6e5f00699838296bb2ff94d04343f18f4ece2290b3b4a5f83a94ab36e58",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:88f0d8ec0ddb536c4ba8fe52",
      "source_batch": 131,
      "entry_index": 25,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1130"
      ],
      "key": null,
      "source_text": "种子和机关都由我亲手创造。\\n在摩天楼展现吧，像魔法一样的胜利！",
      "source_fingerprint": "a710135ccedd1a32f2c9af795a5d57f0625759f100448e15c094ee83ffe51b5b",
      "current_text": "Hạt giống lẫn cơ quan đều do chính tay ta tạo ra.\\nHãy trình diễn giữa những tòa nhà chọc trời — chiến thắng tựa phép màu!",
      "current_fingerprint": "ea303df3e9c929d96878c7b05c6d96ef00b74b8c9bcd48c1005694c3b570dc36",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:4d79fe848cb45f5e3dbe5383",
      "source_batch": 131,
      "entry_index": 26,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1131"
      ],
      "key": null,
      "source_text": "即使被疏远，也有持续照耀的光。\\n但是——现在超越了，将这憧憬的光献上。",
      "source_fingerprint": "b23492e9aaa4358669ed6fe07341c04b6ca213feeb7f931229966900d10d34e3",
      "current_text": "Dù từng bị xa lánh, vẫn có một ánh sáng tiếp tục soi rọi.\\nNhưng giờ đây — đã vượt qua rồi, xin dâng lên ánh sáng ngưỡng mộ này.",
      "current_fingerprint": "883b40cf607eea0590261490236ea8cfce7239d70d9a19ea4935592f3261a3ef",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
