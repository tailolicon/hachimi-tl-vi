  "plan_id": "tr-p3-67f8551f7780-3b70426b88a8-dab73cdd74",
  "batch_id": "tr-p3-67f8551f7780-3b70426b88a8-dab73cdd74-b0509",
  "context_snapshot_sha256": "dab73cdd749801d75d5c6a1648320c1de6fc87f59049ed2a44a77e335956e423",
  "source_bridge_policy_sha256": "4e901db6f39859ccdfa2c44a88f271e6396ead9376e5f2c691d98a1dcb66e4e2",
  "review_generation": "retrospective-canonical-full-review",
  "context_mode": "embedded-first-lazy-extra",
  "items": [
    {
      "uid": "zhcn:5bf83ba8d72636a10c01699b",
      "source_batch": 131,
      "entry_index": 30,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1135"
      ],
      "key": null,
      "source_text": "无论对手多强，无论挑战多么无谋，发动机都不会停。\\n只要灵魂点燃，就只管冲刺。奔向最棒的胜利！",
      "source_fingerprint": "d744e51fbae54f10e76bb28a193a396a645f606c7ded253efa79c723fccc7c3d",
      "current_text": "Dù đối thủ mạnh đến đâu, dù thử thách liều lĩnh đến mức nào, động cơ cũng không dừng lại.\\nChỉ cần linh hồn bùng cháy, cứ thế tăng tốc. Lao tới chiến thắng tuyệt vời nhất!",
      "current_fingerprint": "9aeec2b7c7e99455ccce0a0febc70329abe764973c8c1e036565ee5de7db8065",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:05433a9a914d56d19186e90c",
      "source_batch": 131,
      "entry_index": 31,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1136"
      ],
      "key": null,
      "source_text": "追逐的梦想，永远只有一个！\\n我一定要和你一起听！胜利的旋律！",
      "source_fingerprint": "aa6916d4ba7af1d1ce0de05e58538ebb33001a2559dc8c86a96276d17a2d6af6",
      "current_text": "Giấc mơ đuổi theo, từ đầu đến cuối chỉ có một!\\nTôi nhất định sẽ cùng bạn lắng nghe — giai điệu của chiến thắng!",
      "current_fingerprint": "8e7771f992fb7e9cb13070bcb2bc62253b62922840e03a156a8a1e93cf0c77a6",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:3f50323b61064b721188c524",
      "source_batch": 131,
      "entry_index": 32,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1137"
      ],
      "key": null,
      "source_text": "用力祈愿，虔诚祈祷！冲向闪耀的未来！\\n来吧来吧，请一起高唱！开运招福福来临！",
      "source_fingerprint": "4322df0f6749d9b6775b0deec0f9dc2408965b3fba58f1fd18cb4a15566b0a5a",
      "current_text": "Hết lòng cầu nguyện, thành tâm khấn nguyện! Lao tới tương lai rực sáng!\\nNào nào, hãy cùng cất cao tiếng hát! Khai vận chiêu phúc, phúc lành kéo đến!",
      "current_fingerprint": "7439ddec885fce81fab63cf32b4e992a3c2d71403cb7e193b7c854121409468d",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:e24f509f9ecadbe9bb160b77",
      "source_batch": 131,
      "entry_index": 33,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1138"
      ],
      "key": null,
      "source_text": "来吧，出发！向着光明的未来。\\n——只要和你在一起，无论到哪里！",
      "source_fingerprint": "9bba781826eb6751bc0d42d31262bc5750d454071e35fe0c38eaecac04956405",
      "current_text": "Nào, lên đường! Hướng tới tương lai tươi sáng.\\n— Chỉ cần ở bên bạn, đi đâu cũng được!",
      "current_fingerprint": "e68ea0db4e37edf238d98d13d0334c4f4fbf842f18fe71df816c1520d020aca3",
      "risk_flags": [
        "locked_term_mismatch",
        "not_yet_risk",
        "absence_risk"
      ],
      "risk_score": 18,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.6b9641d2417b",
          "target_vi": "Ánh sáng",
          "matched_aliases": [
            "光明"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a6a63718ae295f1910039124",
      "source_batch": 131,
      "entry_index": 34,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1139"
      ],
      "key": null,
      "source_text": "早上困倦，午餐美味，晚上疲惫。什么都没有。\\n不过，偶尔也可以期待一下吧。毕竟我也是赛马娘。",
      "source_fingerprint": "4048a489b263e54c624ea91d9c60421fee9e506bb970aa78740ab54a31b4885c",
      "current_text": "Sáng thì buồn ngủ, bữa trưa thì ngon, tối thì mệt. Chẳng có gì cả.\\nNhưng đôi khi cũng có thể mong chờ một chút chứ. Dù sao mình cũng là Uma Musume mà.",
      "current_fingerprint": "9fc4060229dbfe772e827e8d39f637acc91df8a9246d6c1b55cf7decccf27f92",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ab60ecde572fcb0c92bd0b4d",
      "source_batch": 131,
      "entry_index": 35,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1140"
      ],
      "key": null,
      "source_text": "你能感受到吧，炽热的血潮。你能听到吧，灵魂的呐喊！\\n用正义之火讨伐邪恶！去吧，去吧去吧英雄！！！！",
      "source_fingerprint": "567c9fa58ea9a714c1d544bf36866851df631f7b08b1c1518938dc6923323ed1",
      "current_text": "Bạn cảm nhận được chứ, dòng máu nóng bỏng. Bạn nghe thấy chứ, tiếng gào của linh hồn!\\nDùng ngọn lửa chính nghĩa tiêu diệt cái ác! Tiến lên, tiến lên tiến lên, anh hùng!!!!",
      "current_fingerprint": "1ad49833d9698c4b3d43acb9b7b0cc3fa945bd806f5d2382bda62e95460711d8",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:aa032e8566a0f7b6111c9f0a",
      "source_batch": 131,
      "entry_index": 36,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1141"
      ],
      "key": null,
      "source_text": "即使到达彼方并抓住，也会从手中滑落。所以——\\n追逐着，追逐着，追逐着——终于抓住了。",
      "source_fingerprint": "c7f320d5a750687b6c5f65b1062c121a4172ea9319190d805c3c2b4c932edc0e",
      "current_text": "Dù tới được nơi xa xôi và nắm lấy, nó vẫn tuột khỏi tay. Vì vậy —\\ncứ đuổi theo, đuổi theo, đuổi theo — cuối cùng cũng đã nắm được.",
      "current_fingerprint": "935b4ef56fc6a19ec35e44bbfb1176d2a1cb2ba6621136f9ad6e991549734012",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:d0acb48477ef2d2a994fe0b7",
      "source_batch": 131,
      "entry_index": 37,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1142"
      ],
      "key": null,
      "source_text": "怀抱在心中的孤狼誓言绝不动摇。\\n无论是自己的影子还是前方的背影，都要像吞噬般甩开！！",
      "source_fingerprint": "a50af3dfd4ac183324be6c3e376a783a196be0437b6123a3001d622374b83fbf",
      "current_text": "Lời thề của sói cô độc khắc sâu trong tim tuyệt đối không lay chuyển.\\nDù là chiếc bóng của chính mình hay bóng lưng phía trước, đều phải bỏ xa như muốn nuốt chửng!!",
      "current_fingerprint": "ba3dbccad0e373c66b9d7a5d2f8cb831f0d44ab006fc6d6f47860bbd0548858b",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:1d487823478f05b97d104061",
      "source_batch": 131,
      "entry_index": 38,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1143"
      ],
      "key": null,
      "source_text": "填补无数不足，稍微踮起脚尖。\\n我也一定能实现……因为我相信。",
      "source_fingerprint": "ed351667d86f74118a1520bd0191f33fc0c4c0d1309a06f3abfd944c1d6c745e",
      "current_text": "Bù đắp vô số thiếu sót, khẽ nhón chân thêm một chút.\\nMình nhất định cũng sẽ làm được… vì mình tin như vậy.",
      "current_fingerprint": "3646d41509749972fa68383ddae2b0a3ad9a145b818cd113dda7e5e42abccfcb",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:9ec57ffa6289c197675b1637",
      "source_batch": 131,
      "entry_index": 39,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1144"
      ],
      "key": null,
      "source_text": "右手握着高贵，左手怀着慈爱。\\n为了成为引领一切的女王——走上吧，这荣耀之路。",
      "source_fingerprint": "f357cd3cb44f6467f1cf906d3f7574665485ea3b7c928d2d02c21c74acf6431b",
      "current_text": "Tay phải nắm lấy cao quý, tay trái ôm trọn lòng nhân ái.\\nĐể trở thành nữ vương dẫn dắt tất cả — hãy bước lên con đường vinh quang này.",
      "current_fingerprint": "03442c1894bcec601b25c63d2d6beb4a9aafa8f0237bc2ee38db6c22466838d5",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b4eafdd04bcc40d31e690729",
      "source_batch": 131,
      "entry_index": 40,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1145"
      ],
      "key": null,
      "source_text": "追逐憧憬，积累的努力一定会结出果实。\\n绚烂盛开的花束。如果要赠送的话，请一定送给你。",
      "source_fingerprint": "dad49ff575fe1facafc391f5dd9bad2d232ae7738532c92d9fea448b0da34d38",
      "current_text": "Theo đuổi niềm ngưỡng mộ, những nỗ lực tích lũy rồi nhất định sẽ kết trái.\\nMột bó hoa nở rực rỡ — nếu được tặng, nhất định tôi muốn tặng cho bạn.",
      "current_fingerprint": "403e4f3ccdec89e407354a181ebaf5c83e7d9d40f4d8e39605000f25c0897410",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f2f8eff1f522ce2c2c8003da",
      "source_batch": 131,
      "entry_index": 41,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1146"
      ],
      "key": null,
      "source_text": "心中燃烧的心之火焰，耀眼地燃烧着。\\n要与律动的节奏一起闪耀，my Queendom！",
      "source_fingerprint": "5a9fa3c8bdfc8fc6a63ae75c271a7da5e367ba0bd922ef8e51f23b3e76a472e1",
      "current_text": "Ngọn lửa trong tim cháy rực, tỏa sáng chói lòa.\\nHãy cùng nhịp điệu rung động mà tỏa sáng — my Queendom!",
      "current_fingerprint": "8b19cf740d19b5ff030c396964df70fec17db510357ef59f22c7a3f293567b2d",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b67cbd5bf0c8af38b92c82aa",
      "source_batch": 131,
      "entry_index": 42,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1147"
      ],
      "key": null,
      "source_text": "用这双腿开拓无人到达的未来！\\n刻下只属于我的轨迹，追寻那天憧憬的荣冠！",
      "source_fingerprint": "ca16ec33cd4877eb4b4f00a87b4d7172b6567933e5952efb598fc94711c9c768",
      "current_text": "Dùng đôi chân này mở lối tới tương lai chưa ai từng chạm tới!\\nKhắc nên quỹ đạo chỉ thuộc về mình, truy tìm vương miện từng ngưỡng mộ ngày ấy!",
      "current_fingerprint": "14de11c413819c9af0cd61220159901232af39fec40d9f5743c6059068cd98cc",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a51584efa1ba47bed3b2f5c3",
      "source_batch": 131,
      "entry_index": 43,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1148"
      ],
      "key": null,
      "source_text": "现在，宛如遥远银河的交响乐响彻。\\n为了夺回黑暗中的星光，像彗星一样奔跑吧“宇宙赛马娘”。",
      "source_fingerprint": "80e1ba8491691ca9c22a9b7ae606c10942d2c580e49ef6953cc0b812b9c44a18",
      "current_text": "Giờ đây, bản giao hưởng tựa dải ngân hà xa xôi vang vọng.\\nĐể giành lại ánh sao trong bóng tối, hãy lao đi như sao chổi — “Uma Musume vũ trụ”.",
      "current_fingerprint": "92ee64d53a909f3e0da25c6eff8d2df09078bdcb0d9e1db935a67bf4b3726dbe",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:793a6e0cbb94992e21be3fa0",
      "source_batch": 131,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1149"
      ],
      "key": null,
      "source_text": "去皮OK！火候刚好！营养满分！你猜隐藏的调味是什么？\\n美味做好啦！来，快来多吃点美食吧！",
      "source_fingerprint": "e5c33de202c05eb96633a32558c1a22fa62aaa06263c8f7eed9ac2d89cd09768",
      "current_text": "Gọt vỏ OK! Lửa vừa đẹp! Dinh dưỡng tròn điểm! Đố bạn gia vị bí mật là gì?\\nMón ngon hoàn thành rồi! Nào, mau ăn thật nhiều nhé!",
      "current_fingerprint": "2f97c3d6cb7ab9c4769f2c3d3c168fd10214bcab239ac75bf379330e88d6f422",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:eeb2bf3876feca013460fbdd",
      "source_batch": 131,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1150"
      ],
      "key": null,
      "source_text": "点缀四周年的 FORCE——那就是挑战之心！\\n从这里，属于你们时代的大门将开启！",
      "source_fingerprint": "1493701da3b2ea40656beb21d0a7b53ed22512b809f6c1111946c38c1ede9720",
      "current_text": "FORCE tô điểm kỷ niệm 4 năm — chính là tinh thần thách thức!\\nTừ đây, cánh cửa dẫn tới thời đại của các bạn sẽ mở ra!",
      "current_fingerprint": "1b47a927de3221f27247dfae1bb901a97bf433a16401accf8e2f79194fccbce0",
      "risk_flags": [
