      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1154"
      ],
      "key": null,
      "source_text": "你踏入的是自然丰富的特雷森岛！\\n这里只有大自然，这首曲子——还有肌肉！",
      "source_fingerprint": "829e1218cced757d57b4fb1e8634bb20b2af3a448a5a5d5877040857a79043cb",
      "current_text": "Nơi bạn vừa đặt chân tới là đảo Tracen tràn ngập thiên nhiên!\\nỞ đây chỉ có đại tự nhiên, bản nhạc này — và cơ bắp!",
      "current_fingerprint": "3e530618c3ae95f6f9771293df59bf713cd630e5a4bfed9ac4b393359458de1a",
      "risk_flags": [
