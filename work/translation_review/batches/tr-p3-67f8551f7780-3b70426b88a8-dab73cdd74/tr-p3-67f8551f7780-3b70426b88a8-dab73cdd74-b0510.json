  "context_snapshot_sha256": "dab73cdd749801d75d5c6a1648320c1de6fc87f59049ed2a44a77e335956e423",
  "source_bridge_policy_sha256": "17e70931bc5face8ac299d5bedacb78fddb59704ab91dc4095c6d76142178d54",
  "review_generation": "retrospective-canonical-full-review",
  "context_mode": "embedded-first-lazy-extra",
  "items": [
    {
      "uid": "zhcn:0f71c3b5387e29c77cc5ebeb",
      "source_batch": 131,
      "entry_index": 50,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1156"
      ],
      "key": null,
      "source_text": "托大家的福——『已经变得这么大啦♡』\\n满载爱的感谢献给你♡请从你喜欢的地方欣赏吧♪",
      "source_fingerprint": "9389e9191ca86fe128e63a10d6e29a0c52b3432dcb5213a9e9b710e0fb8e0ab2",
      "current_text": "Nhờ mọi người — “đã lớn đến thế này rồi nè♡”\\nGửi tới bạn lời cảm ơn ngập tràn yêu thương♡ Hãy ngắm từ góc bạn thích nhé♪",
      "current_fingerprint": "ec9027b069c45155a19eb2948b79ca77f6c2dce3e165faaa186413284f8daf87",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:7587cfed32520cc283a11d62",
      "source_batch": 131,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1157"
      ],
      "key": null,
      "source_text": "那日的记忆在蒸汽般飘荡，令人难忘，但又模糊不清……\\n请听「汤驹浪漫纯情派」。",
      "source_fingerprint": "446387d745bfbc15d2f1ac23bfa9ce9f3fc48fbfa0afa6e02568744f72736c7b",
      "current_text": "Ký ức ngày ấy bồng bềnh như hơi nước, khó quên mà lại mơ hồ…\\nXin mời lắng nghe “Khúc lãng mạn thuần tình của Ngựa Suối Nóng”.",
      "current_fingerprint": "64c2fa667b0a80cb40ac3600a5b1036ee482aa65d36da30d0dd3de717feaca63",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:1253faff0e7e470310794531",
      "source_batch": 131,
      "entry_index": 52,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1158"
      ],
      "key": null,
      "source_text": "踢飞无聊的夜晚，这是『BoC'z we＼n』的最新单曲。\\n铭刻下、交错融合的 AM×i／OK→U／CΛ2 的 flow 吧——！",
      "source_fingerprint": "869ced8d6ed0b1e8eb4ca06435493e58cd94b9eb34244120058350f5e9a9d6c4",
      "current_text": "Đá bay màn đêm nhàm chán — single mới nhất của “BoC'z we＼n”.\\nHãy khắc ghi flow AM×i／OK→U／CΛ2 đan xen hòa quyện này —!",
      "current_fingerprint": "fccc093caf7c5ba3392ba2e52920752d8ee85eb4e35547b33e4e008ee7b577ea",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:5b6d07328fa9c06ac1e2b2bd",
      "source_batch": 131,
      "entry_index": 53,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1159"
      ],
      "key": null,
      "source_text": "常识被一脚踢开，灰烬在大地上刻下痕迹。\\n坠入吧，向着黑白的世界——",
      "source_fingerprint": "dd63e8cb348f417b0790aa1d7a0f29f22cd9e48dc77937f1f48dd177dbce2bf2",
      "current_text": "Thường thức bị đá văng, tro tàn khắc dấu lên mặt đất.\\nHãy rơi xuống — hướng tới thế giới đen trắng —",
      "current_fingerprint": "b0ec4bdc5a09c5bd0aae55e5b24ed75011737492eae05a9046dd613c81a48ea0",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:2a2708518f7030d3b08f221d",
      "source_batch": 131,
      "entry_index": 54,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1160"
      ],
      "key": null,
      "source_text": "喧哗上等！放马过来！有这首歌的话绝对不会输！\\n把你们全部都弄得头冒金星！……这就是充满如此气概的灵魂之曲！",
      "source_fingerprint": "126e6e92def6be6adb0f4a1f40f084f4d135c95f25e616c0357ed4333ec61ad8",
      "current_text": "Muốn gây sự thì cứ tới! Có bài hát này thì tuyệt đối không thua!\\nCho tất cả các ngươi hoa mắt chóng mặt! …Đây chính là khúc ca linh hồn tràn đầy khí thế như thế!",
      "current_fingerprint": "c14de7618a7c85e791802ac598231d329b15c41f386f1607edc7ca34e8fb5d57",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:3a69ca3c67cd5df11f121121",
      "source_batch": 131,
      "entry_index": 55,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1161"
      ],
      "key": null,
      "source_text": "正在寻找未知的“某物”——为了触动心灵深处。\\n那么，今天要度过怎样的一天呢？一边听这首歌一边思考吧！",
      "source_fingerprint": "e5a8700d4892614cc7c8bded3bef4e414d92959597513a7e90fb0c5a36a2458d",
      "current_text": "Đang tìm kiếm một “thứ gì đó” chưa biết — để lay động nơi sâu thẳm trong tim.\\nVậy hôm nay sẽ trải qua một ngày thế nào? Vừa nghe bài này vừa nghĩ thử nhé!",
      "current_fingerprint": "1699cf3e410941840749fb3c36e6584a68cada39113293d6e637b72b63f77f31",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b4e07d4aebcbf0bf95c9f45b",
      "source_batch": 131,
      "entry_index": 56,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1162"
      ],
      "key": null,
      "source_text": "那段时光里不变的热血梦想，凝聚成这一曲。定能传递给每一个人！\\n脚下的大地虽不同，但仰望的星空却是同一片！",
      "source_fingerprint": "9845ef97d776adf87dd40f76e9b6ee1188fb6035462e0dea20b3613624b058db",
      "current_text": "Giấc mơ cháy bỏng không đổi của những tháng ngày ấy được kết tinh thành khúc ca này. Nhất định sẽ truyền tới mọi người!\\nMặt đất dưới chân có thể khác nhau, nhưng bầu trời sao ngước nhìn vẫn là một!",
      "current_fingerprint": "4462e250c3000dcdd4a179240e62e1ee265dcba2fc979437e0d31299d3790358",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:0fc4904b85075c945c5aaf61",
      "source_batch": 131,
      "entry_index": 57,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1163"
      ],
      "key": null,
      "source_text": "刻骨铭心，一生都无法消逝的景色————\\n“爱”往往就是如此之物。",
      "source_fingerprint": "0fcbfc73cec9fa3f54b824d22c4bfc97f30b07cc6154e5640fda22f8a9b4633d",
      "current_text": "Khung cảnh khắc cốt ghi tâm, suốt đời không thể phai mờ ————\\n“Yêu” thường chính là một thứ như thế.",
      "current_fingerprint": "2d0e897c9c3b144ad6f5d532ed016b2465eebda40a9c1810b06f0dbcc08f0a88",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:1d118827b55e4807780023b0",
      "source_batch": 131,
      "entry_index": 58,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1164"
      ],
      "key": null,
      "source_text": "为了清白正直，让我们忍耐吧。严于律己，\\n唯有自制。忍耐才是美德。是的，听了这首歌就会明白。",
      "source_fingerprint": "0ba58c507e871bc5d510a390c22bb40dd27fba3c7d13ebf5726b6c51d98a17f5",
      "current_text": "Để sống trong sạch và ngay thẳng, hãy nhẫn nại. Nghiêm khắc với bản thân,\\nchỉ có tự chế. Nhẫn nại là một đức hạnh. Đúng vậy, nghe bài này rồi sẽ hiểu.",
      "current_fingerprint": "d404ad9af518f5af9cb3ad29df3b0d06db6108f55a8885b42bd99b805b51d208",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:d517c4e1a11a67b09264a8f2",
      "source_batch": 131,
      "entry_index": 59,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1165"
      ],
      "key": null,
      "source_text": "万物所向披靡的优雅旋律，是胜者的绝对证明！\\n 她的道路无人能挡！只因任何事物在她面前都如微风一般！",
      "source_fingerprint": "279e8266208df5b9898cca31a8a03d4d3108fd7ed403a5256d277e854cdadef9",
      "current_text": "Giai điệu tao nhã nghiền nát vạn vật chính là bằng chứng tuyệt đối của người chiến thắng!\\n Con đường của nàng không ai cản nổi! Bởi trước nàng, mọi thứ chỉ như một làn gió nhẹ!",
      "current_fingerprint": "04089d64d698f232464102d67c1d797d941c63719df2b28aa09fc0aa2a6a4bb8",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:db6aa96856d625004baabacf",
      "source_batch": 131,
      "entry_index": 60,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1166"
      ],
      "key": null,
      "source_text": "随心所欲，随风而去，飞向遥远的彼方！\\n若想知晓风的去向，聆听这首曲子便好。",
      "source_fingerprint": "f1e4f9f90703a4fbce1ac659e498a22e099726259e03fc7805fe3ca2d3814977",
      "current_text": "Tùy lòng mà đi, theo gió mà bay, hướng tới phương xa!\\nMuốn biết gió sẽ về đâu, chỉ cần lắng nghe khúc nhạc này.",
      "current_fingerprint": "d24fbeaafbe2f85fa20eac1ba54ed437d25f9f08a5f57bfb442f360e7f999207",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:878a58b2c9d9a7184d2fca7c",
      "source_batch": 131,
      "entry_index": 61,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1167"
      ],
      "key": null,
      "source_text": "太阳正在地平线的某处升起……只是并非此处。\\n奔跑吧。总有一天，这片阴云也会散去的。",
      "source_fingerprint": "d99301dff80f85a39826c71a529a90d86f47d6e8ca7afd247c00feaf4eb988d1",
      "current_text": "Mặt trời đang mọc ở đâu đó trên đường chân trời… chỉ là không phải nơi này.\\nHãy chạy đi. Rồi một ngày, mây mù nơi đây cũng sẽ tan.",
      "current_fingerprint": "c503865e013603cd72865ac81a7b1b17430d2763d6237fa197e4a23eeef89ff9",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:e6bc73d7042725b4d5cb2cdc",
      "source_batch": 131,
      "entry_index": 62,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1168"
      ],
      "key": null,
      "source_text": "跪拜聆听！",
      "source_fingerprint": "01a45ddd47190dd605ff10534746b38f4445acf5dbe1eb7223fc4b2bb8e52034",
      "current_text": "Quỳ xuống mà lắng nghe!",
      "current_fingerprint": "044ff522770390e5fdd4ab61a90a14db5fe19508dbccb9038dd0ee0374b1d535",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:8aeacd594255264ae4c4127d",
      "source_batch": 131,
      "entry_index": 63,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1169"
      ],
      "key": null,
      "source_text": "旅途中拾起的风景，将成为连接未来的梦想。\\n那么，今晚又会做怎样的梦呢……",
      "source_fingerprint": "d166a88f224e103b6db8cf966a06f3894f8450c2244ce374dbc53558cb653c08",
      "current_text": "Những phong cảnh nhặt được trên hành trình sẽ trở thành giấc mơ nối liền tương lai.\\nVậy tối nay sẽ lại mơ giấc mơ thế nào đây…",
      "current_fingerprint": "7455eb20ddccbe86163f96483b933bc8789f5c3e37dd36e1f0788b4dd2b982ec",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:631e62c8a7473069e194a24f",
      "source_batch": 131,
      "entry_index": 64,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1170"
      ],
      "key": null,
      "source_text": "有一种光芒让人无法移开目光。\\n只要听这首曲子——不，其实你已经知道了吧？",
      "source_fingerprint": "84c1069438893b8b342f49be79a0fbcd74beaebfae1db7b7b55fe46b95dc74dd",
      "current_text": "Có một ánh sáng khiến người ta không thể rời mắt.\\nChỉ cần nghe khúc nhạc này — không, thật ra bạn đã biết rồi, đúng không?",
      "current_fingerprint": "fc00258978a53b5f9000660f957de376d0edf86659c0c39105140eef5e8ea710",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6f7c18bc56606e1deecc2165",
      "source_batch": 131,
      "entry_index": 65,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1171"
      ],
      "key": null,
      "source_text": "辉煌梦想的顶峰遥不可及，前路充满绝望……\\n然后，少女走向了荣华之门。",
      "source_fingerprint": "4c63fb5e5fc8c077ffd924bd72837f270315103a34fbdc432f65fff6d1d6b6e6",
      "current_text": "Đỉnh cao của giấc mơ huy hoàng xa ngoài tầm với, con đường phía trước ngập tràn tuyệt vọng…\\nVà rồi, cô gái bước tới cánh cửa vinh hoa.",
      "current_fingerprint": "ee025707df98024f22afa5a696dbac31e521ba2cbe720a38861a89f7999f8b22",
      "risk_flags": [
        "very_long_target",
        "negation_capability_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:d377f13b8f6d61a5da77bd7a",
      "source_batch": 131,
      "entry_index": 66,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1172"
      ],
      "key": null,
      "source_text": "争先恐后超越他人的背影！\\n燃烧的热情终将成为照亮新时代的灯火！",
      "source_fingerprint": "ddcf1d5230d4828111729dca81c545cb8c92f21c7ecee16cf5822fbb41b8588a",
      "current_text": "Tranh nhau vượt qua bóng lưng của người khác!\\nNhiệt huyết cháy bỏng rồi sẽ hóa thành ngọn đèn soi sáng thời đại mới!",
      "current_fingerprint": "266377d3bfab27bc1f9fa322dfedf2f5abf52d7c50b2a7c855dc9ba128f8a45c",
