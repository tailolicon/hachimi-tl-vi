    {
      "uid": "zhcn:08981739c2141836ff82ae17",
      "source_batch": 132,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1191"
      ],
      "key": null,
      "source_text": "三姐妹依偎在一起的和声，温柔地抚慰着心灵——\\n让歌声与思念重叠吧。即便道路不同，我们永远相伴。",
      "source_fingerprint": "f9f7c4320d72326928aeb745d027513123f087fcbebe37d79ffeff29b23d3d84",
      "current_text": "Hòa âm của ba chị em tựa vào nhau, dịu dàng xoa dịu tâm hồn—\\nHãy để tiếng hát hòa cùng nỗi niềm. Dẫu đường đi khác nhau, chúng ta mãi bên nhau.",
      "current_fingerprint": "bb26e68cf8136a938b9787f6e44bd05e3eabda8276dbe6e9e99211ea55bd15b8",
