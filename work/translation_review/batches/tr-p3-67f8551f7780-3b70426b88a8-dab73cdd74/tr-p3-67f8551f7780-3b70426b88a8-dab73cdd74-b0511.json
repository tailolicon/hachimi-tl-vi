  "items": [
    {
      "uid": "zhcn:78c5fe72d01388b878619089",
      "source_batch": 131,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1176"
      ],
      "key": null,
      "source_text": "划破风暴的，是你那举世无双的光芒——\\n披挂上阵吧，在那缤纷绚烂的色彩中。鸣响吧，那革命的歌声。",
      "source_fingerprint": "0c9e57f10d99f84b70df7259ea1d79ff1cc8fdc1480777f125476c217d6d949b",
      "current_text": "Xé toạc bão tố chính là ánh sáng vô song của bạn —\\nHãy khoác giáp ra trận giữa muôn màu rực rỡ. Hãy vang lên, khúc ca cách mạng ấy.",
      "current_fingerprint": "19e2c70115cf952c05e85c17a462fb682610f546d9eb73f697fb18eb232e8152",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:7d2071440960643b1aa7f2ab",
      "source_batch": 131,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1177"
      ],
      "key": null,
      "source_text": "在这场豪华绚丽的盛典中，证明出团队的羁绊。\n以此团结之力攀登世界之巅！拿下吧，美国梦！",
      "source_fingerprint": "d3049ae23595807548430a941542d8affaebc1af8f855bee2fedebe145e7713d",
      "current_text": "Trong lễ hội lộng lẫy này, hãy chứng minh mối gắn kết của cả đội.\nDùng sức mạnh đoàn kết ấy leo lên đỉnh thế giới! Giành lấy Giấc mơ Mỹ!",
      "current_fingerprint": "866241632621f3611684e70d3a2bbf3b29b55cf59be2b80dcff709dade888436",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "progress.bond",
          "target_vi": "Gắn kết",
          "matched_aliases": [
            "羁绊"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:78225a9b059a49631af7cee8",
      "source_batch": 131,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1178"
      ],
      "key": null,
      "source_text": "想要比任何人都要强烈、激烈，闪耀如流星般的一曲！\\n掠过天际的灰色轨迹，将会震撼每一个人的心！",
      "source_fingerprint": "1ea5a311120350b01b2e5e126f197395e02124bdc9ef578334c4ce980a2aadb1",
      "current_text": "Một khúc ca muốn tỏa sáng mãnh liệt, dữ dội hơn bất kỳ ai — như sao băng!\\nQuỹ đạo xám lướt ngang bầu trời sẽ làm rung động trái tim tất cả mọi người!",
      "current_fingerprint": "7a370af1142ffd2132c151b3a56d1480e066b3852395cd9652e7136980c4b10c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:d37c2e6a3046d139960ab588",
      "source_batch": 131,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1179"
      ],
      "key": null,
      "source_text": "不善于使用言语表达……即便如此，还是想要传达出来。\\n就是这样，一首稍微有点笨拙的歌。",
      "source_fingerprint": "c9200df9f4e31ab61ab761352bfa7b58f487e5898d0073bb2df8f169045744fd",
      "current_text": "Không giỏi diễn đạt bằng lời… nhưng dù vậy vẫn muốn truyền đạt ra.\\nĐó là một bài hát hơi vụng về một chút như thế.",
      "current_fingerprint": "70a657470b2dfd6a3c34691cc3fddeffea5748886b0b54ee3facc805bdc209ef",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:181cc577cf445e3c42dfc61d",
      "source_batch": 131,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1181"
      ],
      "key": null,
      "source_text": "赠予你的这一碗。面条、配菜与热情，\\n盛满平日里满满的感谢——嘿，让您久等啦！！",
      "source_fingerprint": "505c5b425c9c1f6aea176c1aceec6b0ec5737c508b5a4a4ffed834da334ebdb9",
      "current_text": "Tặng bạn một bát này. Mì, đồ ăn kèm và cả nhiệt huyết,\\nđong đầy lời cảm ơn thường ngày — này, để bạn đợi lâu rồi!!",
      "current_fingerprint": "ab121f5fda8b468d9577572fe2bf55c074796a79e5d2f3680dd3c9b1d2cdbfa9",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:996c7568e8341c51f3593486",
      "source_batch": 131,
      "entry_index": 75,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1182"
      ],
      "key": null,
      "source_text": "『#kawaii』『#梦幻柔软』『#心动不已？』\\n可爱是能传达到宇宙的暗号！呐，可以再多喜欢我一点吗？",
      "source_fingerprint": "410a1d5da43efff3a849005af5e013bf077ba6e7dbd5d0d32f6041d35c4f9657",
      "current_text": "“#kawaii” “#mơmàngmềmmại” “#timđậpnhanh?”\\nDễ thương là mật mã có thể truyền tới tận vũ trụ! Nè, bạn có thể thích tôi thêm một chút nữa không?",
      "current_fingerprint": "2ea0875186c0ee7b659d270e60cf028d926de78287298747b9c8115e72323e64",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.3346bd209f49",
          "target_vi": "Nhịp tim rộn ràng",
          "matched_aliases": [
            "心动"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:1c9f68bc65e67e485df90050",
      "source_batch": 131,
      "entry_index": 76,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1183"
      ],
      "key": null,
      "source_text": "高涨的心跳已经无法抑制！ \\n毫无保留地倾诉炽热的思念，一首让人心跳加速的歌曲！",
      "source_fingerprint": "a525512dfe02bc7cae1075026fa2cd5d2986b8e82552815abe5ae72293e3aae0",
      "current_text": "Nhịp tim dâng cao đã không thể kìm nén nữa! \\nTrút hết nỗi lòng nóng bỏng không chút giấu giếm — một bài hát khiến tim tăng tốc!",
      "current_fingerprint": "d9dbb9d20a690465511da77f03a5b557c3a3d36f514e56c50fea32bc2d6e8bbb",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:79dfc863223b14a2e4f300f9",
      "source_batch": 131,
      "entry_index": 77,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1184"
      ],
      "key": null,
      "source_text": "灵魂为之震颤，歌颂着骄傲不屈的乐曲。\\n绝不会轻易屈服，直到成为“女王”的那一天。",
      "source_fingerprint": "6e1eb37482eefe949d29706f459830f31bbd17a64c4ad188500011b431a96e3b",
      "current_text": "Khúc nhạc khiến linh hồn rung chuyển, ca ngợi niềm kiêu hãnh bất khuất.\\nTuyệt đối không dễ dàng khuất phục, cho tới ngày trở thành “Nữ vương”.",
      "current_fingerprint": "48dafb0c775df9fd76d0813ccdb6a9d59d783a663e2bb2f71dab6d407c93d9e9",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:524e9bf9062d0bcfb924af3a",
      "source_batch": 131,
      "entry_index": 78,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1185"
      ],
      "key": null,
      "source_text": "拜托了♡正因为是你，我才会这么想撒娇。\\n连全世界都会为之着迷的，可爱的流行歌曲！",
      "source_fingerprint": "525912bcfb92b78bbe7a757d8f429cf8d1ba8bc7bda5a94d92455959be5e95c7",
      "current_text": "Làm ơn nhé♡ Chính vì là bạn nên tôi mới muốn làm nũng thế này.\\nMột bài pop dễ thương đến mức cả thế giới cũng phải mê mẩn!",
      "current_fingerprint": "564fb09e6cd82b10a98c6f230d12838cf9068e2855d5963fc0252f8bbec46621",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:3d65627bcaaf9193b139f920",
      "source_batch": 131,
      "entry_index": 79,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1186"
      ],
      "key": null,
      "source_text": "注入了能一扫无聊日常的特别魔法的乐曲！\\n只需要相信的心。仅凭这一点——无论什么都一定能做到！",
      "source_fingerprint": "ea4b7c44c0aff35bf60f78c44fad18c1deb9a5e5aac5d8c87e94bdc9fd63109d",
      "current_text": "Khúc nhạc được rót vào thứ phép thuật đặc biệt có thể quét sạch những ngày thường nhàm chán!\\nChỉ cần một trái tim biết tin tưởng. Chỉ vậy thôi — chuyện gì cũng nhất định làm được!",
      "current_fingerprint": "fa64db335a387a1a751d32f9c907ed9817d405ee2a121a8c5408dd26aa6f36ee",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:896b56be0adb3987b5b003f6",
      "source_batch": 132,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1187"
      ],
      "key": null,
      "source_text": "华丽、优雅、勇敢！点燃内心的充满力量的乐曲！\\n无论遇到什么困难都不会屈服——这才是公主应有的姿态！",
      "source_fingerprint": "627c7ddfd31ec59005af6b6f9ed19832c194148bcfdc62f5d08f26f005512730",
      "current_text": "Rực rỡ, thanh lịch, dũng cảm! Một khúc nhạc tràn đầy sức mạnh thắp sáng trái tim!\\nDù gặp bất cứ khó khăn nào cũng không khuất phục—đó mới là dáng vẻ của một công chúa!",
      "current_fingerprint": "55ec40803eca90d683fe7c7d9491813d7dbff7da68a9e5989075a432e28f4f93",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
        "absence_risk"
      ],
      "risk_score": 24,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.stat.power",
          "preferred": "Power",
          "accepted": [
            "Power"
          ],
          "forbidden": [
            "Sức mạnh"
          ],
          "matched_aliases": [
            "力量"
          ],
