    {
      "uid": "zhcn:06120801c2248b942213cb8b",
      "source_batch": 148,
      "entry_index": 79,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "1"
      ],
      "key": null,
      "source_text": "佩服！　两人的关系\\n是多么的理想啊……！！",
      "source_fingerprint": "dc1a7f2f3d5e4ca133e8dd2f6a7fa84d72851d87ab5b6414b2898c34037b170e",
      "current_text": "Khâm phục quá!　Mối quan hệ của hai người\\nthật lý tưởng biết bao……!!",
      "current_fingerprint": "a967dd741e8c18165644b3d5d155a8c335805dd170ac6b7d49141f4cc54fb78e",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:5ff6a3ff763f16411239c219",
      "source_batch": 149,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "10"
      ],
      "key": null,
      "source_text": "原来如此。此等实力……\\n果然不是只会耍嘴皮子而已啊。",
      "source_fingerprint": "d974c3fce29e8eb4b747557f82e41fce9cb472bcfa2254a8f9ec2ea8143c7ac3",
      "current_text": "Ra là vậy. Thực lực đến mức này...\\nQuả nhiên không phải chỉ giỏi nói suông.",
      "current_fingerprint": "2354a60380920386a3f081b47eb28da8211dc95b9ed496be6ebd01f7d31798fd",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:8bb5f212516ee8900a400bdf",
      "source_batch": 149,
      "entry_index": 1,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "11"
      ],
      "key": null,
      "source_text": "从今往后，也请你负起训练员的责任，\\n以热忱之心与赛马娘诚挚来往。",
      "source_fingerprint": "69fc480177a7c5408e7d6a68ecbfad9510a78a955824d04e1d59ac89f5601242",
      "current_text": "Từ nay về sau, hãy tiếp tục gánh vác trách nhiệm của một Huấn luyện viên,\\nvà chân thành đồng hành cùng Uma Musume bằng tất cả nhiệt huyết.",
      "current_fingerprint": "e99136f0e53234ceb0d7c0f6a68b0bc213c9e3bebcb8b2d3c2b18f0f43027070",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [
        {
          "id": "common.trainer",
          "preferred": "Trainer",
          "accepted": [
            "Trainer"
          ],
          "forbidden": [
            "Huấn luyện viên"
          ],
          "matched_aliases": [
            "训练员"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "Common EN-version player terminology."
        }
      ],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ed4c5798244384ef19251576",
      "source_batch": 149,
      "entry_index": 2,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "12"
      ],
      "key": null,
      "source_text": "希望你今后的表现也能不辱特雷森之名。",
      "source_fingerprint": "7c1638bbbbae75ed43e99b7b6a24f40d8adc9150a57426be2837d3539b4476fe",
      "current_text": "Mong rằng những màn thể hiện sắp tới của bạn cũng sẽ xứng đáng với danh tiếng Tracen.",
      "current_fingerprint": "1db5a7169dc640bfb5a7e209d4ca325d93b9a8e3ad83a39d3778f444544da31f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:20653fd306783b0bce07e4b4",
      "source_batch": 149,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "13"
      ],
      "key": null,
      "source_text": "最近每次来观摩都会令我着迷。\\n……着迷于各位所散发的光辉。",
      "source_fingerprint": "9e8aa264767e985c2038607507c454387d75aca4529a7cf03d574be9813d1e48",
      "current_text": "Gần đây mỗi lần đến quan sát tôi đều bị cuốn hút.\\n...Bị cuốn hút bởi ánh hào quang mà mọi người tỏa ra.",
      "current_fingerprint": "c3c94d3a88f559e736442c55128629142e499e45c1d125fa2c4af0bdaf197d37",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:da66328e7c7f22dcfcfa7c17",
      "source_batch": 149,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "14"
      ],
      "key": null,
      "source_text": "完成度又更高了……！\\n真不愧是训练员呢。",
      "source_fingerprint": "4e25dd09cd1268caebbbaab2c712a9e2bf82274ae9255765390da47998e63a17",
      "current_text": "Mức độ hoàn thiện lại cao hơn nữa...!\\nQuả không hổ danh Huấn luyện viên.",
      "current_fingerprint": "4a68123b52a9c315ce27bafe0f7efce90deaf098d2575d395faed35411f0c4d6",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.trainer",
          "preferred": "Trainer",
          "accepted": [
            "Trainer"
          ],
          "forbidden": [
            "Huấn luyện viên"
          ],
          "matched_aliases": [
            "训练员"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "Common EN-version player terminology."
        }
      ],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:3731ef69e0c3bb3769555b35",
      "source_batch": 149,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "15"
      ],
      "key": null,
      "source_text": "看来日积月累的努力\\n有确实为她所吸收！",
      "source_fingerprint": "ac763a8b9341802b065ae02dd6b6726110a053cf6d9280475f42ac438885d761",
      "current_text": "Có vẻ những nỗ lực tích lũy từng ngày\\nđã thực sự thấm vào cô ấy!",
      "current_fingerprint": "fd6f999a2bab4999b02162d08213fe284afc05cfa957bd6a3d6ccd47c10b60ac",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:7af4cf3e0cbf89b41b3a8778",
      "source_batch": 149,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "16"
      ],
      "key": null,
      "source_text": "如果有什么我能帮上忙的地方，\\n请不要客气尽管告诉我喔～",
      "source_fingerprint": "b58dad4e14ea2bf563354f361418c3648a4b625cb186b944b4f3d5d354199a3f",
      "current_text": "Nếu có việc gì tôi giúp được,\\nthì cứ nói với tôi, đừng ngại nhé～",
      "current_fingerprint": "47e171c4d3e11109472bca7eccf1f269c060b966aa3cdc26deaeb36a3885fcfb",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:11d07807ea6005494d6a38df",
      "source_batch": 149,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "2"
      ],
      "key": null,
      "source_text": "优秀！\\n期待能有更上一层楼的活跃表现！",
      "source_fingerprint": "c6dabd4fe1396b4b7357f16b8e7a940a60ec29a1792254d33f762ef64b91bc17",
      "current_text": "Xuất sắc!\\nMong chờ những màn thể hiện còn tiến xa hơn nữa!",
      "current_fingerprint": "c7dc613735a732139602f0d7861b46f35ea8150f3f275965d44aa80a6c60fb66",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a0005d56a762693b314ee6d0",
      "source_batch": 149,
      "entry_index": 8,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "21"
      ],
      "key": null,
      "source_text": "真的……非常以你们为傲！\\n你们正可说是──梦想。",
      "source_fingerprint": "afbd2231d5e3ec385cb1038ab64ac33893fff62f9b3853b2730043b0b4d9f8fe",
      "current_text": "Thật sự... tôi vô cùng tự hào về hai người!\\nHai người quả thật chính là──ước mơ.",
      "current_fingerprint": "2c65d8e845204259d16a0d77645492f31dd563e7b706ece470cecced1080310c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a447173ab530055fe8681719",
      "source_batch": 149,
      "entry_index": 9,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "22"
      ],
      "key": null,
      "source_text": "喜悦与烦恼都能共有共享。\\n对彼此而言都是无可取代的伙伴！",
