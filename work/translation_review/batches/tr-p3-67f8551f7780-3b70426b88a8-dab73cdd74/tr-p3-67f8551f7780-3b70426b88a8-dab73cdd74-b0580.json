      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "29"
      ],
      "key": null,
      "source_text": "我感觉到了，感受到了啊！\\n灵魂燃烧的声音！达哈哈哈！",
      "source_fingerprint": "ccc78b6a33dad4a039ad75058f04b60a38c1f180e2783cd82dde4758602e8daa",
      "current_text": "Tôi cảm nhận được, cảm nhận được rồi!\\nTiếng linh hồn đang bùng cháy! Dahahaha!",
      "current_fingerprint": "062a6d6b2fb1ff620294b1aaf2bbb70d55980e2cc8911b97cd6c2b41c0abf84e",
