      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "28"
      ],
      "key": null,
      "source_text": "相談したいことがございましたら\\nいつでも仰ってくださいね。",
      "source_fingerprint": "664c97e03d39f11ae627531dddd1183b4215bbf41e7987095107c628216303b5",
      "current_text": "Nếu có điều gì muốn trao đổi,\\nhãy cứ nói với tôi bất cứ lúc nào nhé.",
      "current_fingerprint": "72155119d5f3b3337bdea0b798f1eb026955c34e45c840cf828ff646bfff5ac9",
