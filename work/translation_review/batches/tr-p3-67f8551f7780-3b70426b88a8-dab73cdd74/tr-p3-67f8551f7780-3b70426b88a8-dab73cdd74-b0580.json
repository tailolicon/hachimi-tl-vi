      "json_path": [
        "139",
        "3"
      ],
      "key": null,
      "source_text": "不错！　实力似乎\\n渐渐增长了呢！",
      "source_fingerprint": "7fc749db6212824759642712437022d8454375b611f958d59daa71f265583c2d",
      "current_text": "Tốt lắm! Thực lực dường như\\nđang dần tăng lên rồi nhỉ!",
