      "source_batch": 149,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "26"
      ],
      "key": null,
      "source_text": "大変ご活躍のようですね……！\\n私個人としても応援しています。",
      "source_fingerprint": "5ec74d348bdbb5252c8e57093ff3027379fac9591c4bb017720be183e8ed1aa3",
      "current_text": "Có vẻ hai người đang hoạt động rất nổi bật...!\\nCá nhân tôi cũng luôn ủng hộ.",
      "current_fingerprint": "f572036dc5d9d7f55de3cb99f9e161f7900210c6ee9951e6d7abb06b3b0b6a6b",
      "risk_flags": [],
