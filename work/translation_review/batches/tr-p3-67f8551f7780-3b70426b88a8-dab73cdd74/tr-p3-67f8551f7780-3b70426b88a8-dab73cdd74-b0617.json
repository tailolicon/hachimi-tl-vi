      "source_batch": 159,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1083"
      ],
      "key": null,
      "source_text": "海外诞生，\\n沉默寡言的任务执行者",
      "source_fingerprint": "60e801e479f7712944dcc44ff2e3d32262a7f707c09269cc8426deff1c30fe5f",
      "current_text": "Sinh ra ở hải ngoại,\\nNgười thi hành nhiệm vụ ít lời",
