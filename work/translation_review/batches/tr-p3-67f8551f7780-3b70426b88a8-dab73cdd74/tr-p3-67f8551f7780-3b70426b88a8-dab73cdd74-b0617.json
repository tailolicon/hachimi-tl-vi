      "source_batch": 159,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1081"
      ],
      "key": null,
      "source_text": "可别小看我！\\n尖声的处于叛逆期的少女",
      "source_fingerprint": "acb69231f6ef8a1d84fa7a5e00f4cf6b1ce652e6ab50dadc324211372efdeac8",
      "current_text": "Đừng xem thường tôi!\\nCô gái tuổi nổi loạn với giọng the thé",
      "current_fingerprint": "60080b7d67798d8758fa0e2168df79cf2f9ea24f0fdefc2d7605bbf8786eef77",
      "risk_flags": [
        "very_long_target"
