      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1087"
      ],
      "key": null,
      "source_text": "目标是成为吉祥物。\\n有着奇幻气质的不可思议的孩子",
      "source_fingerprint": "3e9f78a2cdf825dbddf9cf857c0f2e92a4ceeba55f1fe70355e98a31003e37db",
      "current_text": "Mục tiêu là trở thành linh vật.\\nĐứa trẻ kỳ lạ mang khí chất huyền ảo",
      "current_fingerprint": "c021347d37a2922ae5cc193c1354a83a3547ff708f958c53452dc968da35a26b",
