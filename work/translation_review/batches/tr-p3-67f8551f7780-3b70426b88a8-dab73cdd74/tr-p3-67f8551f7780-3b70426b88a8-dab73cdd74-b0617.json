      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1090"
      ],
      "key": null,
      "source_text": "目标是与自己相配的『女王』之座。\\n好胜的名流赛马娘",
      "source_fingerprint": "78d27666663a84679f6e3e24a74ce4fe9d8914a333afec82d180cdede046ee03",
      "current_text": "Mục tiêu là ngôi vị『Nữ hoàng』xứng với mình.\\nUma Musume thượng lưu hiếu thắng",
      "current_fingerprint": "c23159769f6edff9895b36434690c5b63a3bf409ccd4edcda3f1256eb421ac10",
      "risk_flags": [],
