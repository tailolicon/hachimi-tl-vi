      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1085"
      ],
      "key": null,
      "source_text": "胜利是必然的。\\n华丽一族的赛马娘",
      "source_fingerprint": "7f94fd779ab42dfe3ddb05aab08ae355841aabdd84d2fbe5fc4e142697e8f2c1",
      "current_text": "Chiến thắng là điều tất nhiên.\\nUma Musume thuộc một gia tộc danh giá",
      "current_fingerprint": "7c9c243f8cc419c9979f589c4b907bc08b9d5e24072e47e6e64ac431cda3d03c",
      "risk_flags": [
        "very_long_target"
