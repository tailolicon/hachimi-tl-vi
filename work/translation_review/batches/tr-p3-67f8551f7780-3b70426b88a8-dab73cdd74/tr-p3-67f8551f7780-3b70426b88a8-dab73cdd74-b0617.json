      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1093"
      ],
      "key": null,
      "source_text": "为表感谢而创造奇迹。\\n温柔而稳重的赛马娘",
      "source_fingerprint": "7eb554e41f2c5aa978d2c62c4a326a20457cb17121976a96bfaef705f9eb5f4a",
      "current_text": "Tạo nên kỳ tích để đáp lại lòng biết ơn.\\nUma Musume dịu dàng và điềm đạm",
      "current_fingerprint": "eb3cd15a6f485e1d2894cc2685a8ad53cd3b4ac63e89be66a4a75c25b1e954cf",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
