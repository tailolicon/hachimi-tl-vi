      "source_batch": 159,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1086"
      ],
      "key": null,
      "source_text": "将至高无上的爱献给比赛……\\n绝世独立，绽放于顶点的魔性之花",
      "source_fingerprint": "123934297e76e1f3c2c692633efa7a48b431b68bea2490cf3d6c56d2e673ef18",
      "current_text": "Dâng tình yêu tối thượng cho những cuộc đua...\\nĐộc nhất vô song, đóa hoa ma mị nở trên đỉnh cao",
      "current_fingerprint": "5ac8a493ca484f9f76048e535a8f77078d8a23cdf927fb06ece1775ff2ed0ff0",
      "risk_flags": [
        "very_long_target",
