      "source_batch": 159,
      "entry_index": 24,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1092"
      ],
      "key": null,
      "source_text": "老好人！\\n根本是个可爱的听使唤的人",
      "source_fingerprint": "70f8b8d958dcf38213f36123855152337e51ec159703a24c7741f0c838b1cef1",
      "current_text": "Tốt bụng đến mức quá mức!\\nĐúng là cô nàng đáng yêu luôn nghe lời",
      "current_fingerprint": "715332d0fbd27f1d729ecb6d71fb849bf29ccd139c79a88e04a921547718fdf1",
      "risk_flags": [
        "very_long_target"
