      "source_batch": 159,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1080"
      ],
      "key": null,
      "source_text": "想要兴奋不已！\\n追求未知的情报商",
      "source_fingerprint": "c082f00f037880fe1ab7ccc2d11b40c2f91cd3d51f10af83b9799971a78ba8c6",
      "current_text": "Muốn được phấn khích!\\nThương nhân tình báo săn tìm điều chưa biết",
      "current_fingerprint": "5e949eee34984a00be5a6d7f6a4e2aa99c62575712a3ae305125f7dfb651bf93",
      "risk_flags": [
        "very_long_target"
