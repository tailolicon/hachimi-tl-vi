      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1082"
      ],
      "key": null,
      "source_text": "光辉需要磨练！\\n闪耀的时尚达人",
      "source_fingerprint": "dfa73c875f250bbddb3663ba671f6c952daa551ca49a3c7b8d2188e421e2143c",
      "current_text": "Ánh sáng cần được mài giũa!\\nTín đồ thời trang lấp lánh",
      "current_fingerprint": "48439ce9e383ccc5484f83cb08ca15755f2d054bd25da9c36a32c3bc9bedcf1a",
      "risk_flags": [
        "very_long_target"
      ],
