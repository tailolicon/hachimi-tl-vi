      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1079"
      ],
      "key": null,
      "source_text": "坚定不移的船桥爱。\\n来自地方的文静留学生",
      "source_fingerprint": "dc8871437c6285bac29fa10b1ea059b437fca89ea9dfc13700e5f38d66258b65",
      "current_text": "Tình yêu Funabashi kiên định.\\nDu học sinh trầm lặng đến từ địa phương",
      "current_fingerprint": "a505f0e815aa707f94f366621b39740a9daf5582bc3c61ebea826461e9964b44",
      "risk_flags": [
        "very_long_target"
