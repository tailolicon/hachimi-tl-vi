      "source_batch": 159,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1084"
      ],
      "key": null,
      "source_text": "可别止步于这种美学！\\n追求完美的破坏神",
      "source_fingerprint": "3020ddd8441596e9dec9571b9738460e30e63722c27eddd105517e724270cbe9",
      "current_text": "Đừng dừng lại ở thứ mỹ học này!\\nThần hủy diệt theo đuổi sự hoàn mỹ",
      "current_fingerprint": "aa42b0cf6b2b4f357bee09216ba44cf474e4fb86a62ebe20caf59007d2280111",
      "risk_flags": [
