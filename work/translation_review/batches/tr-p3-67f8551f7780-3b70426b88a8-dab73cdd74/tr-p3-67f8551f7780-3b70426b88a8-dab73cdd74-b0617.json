    {
      "uid": "zhcn:15568231748a42aebfd0031f",
      "source_batch": 159,
      "entry_index": 26,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1094"
      ],
      "key": null,
      "source_text": "以最强为目标，屡战屡胜！\\n天衣无缝的非凡不良",
      "source_fingerprint": "7022f8719c7aae335647fee653d7d560c3fba6a0e134dca34f5dffc63390e974",
      "current_text": "Nhắm đến mạnh nhất, càng chiến càng thắng!\\nCô nàng bất hảo phi thường, hoàn hảo không tì vết",
      "current_fingerprint": "4d00726becb62e467065bea53b02de68e8e43367105631f5d95fd0aa411f5e3e",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
