      "source_batch": 159,
      "entry_index": 27,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1095"
      ],
      "key": null,
      "source_text": "『最速』即为技艺精湛\\n坚忍不拔的匠人马娘",
