      "source_batch": 159,
      "entry_index": 23,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "144",
        "1091"
      ],
      "key": null,
      "source_text": "天生讨人喜欢，\\n梦想是跨越遥远的大海",
      "source_fingerprint": "888d45fe1421045d3bc8cdbb49739d10057203736b397cad22b45b00c2d11be7",
      "current_text": "Bẩm sinh được mọi người yêu mến,\\nƯớc mơ vượt qua biển khơi xa xôi",
      "current_fingerprint": "b21289c773ad0b1f7a3b4c32d809c100b06a3b623383c8c1a71d0b42a86d9e04",
