    {
      "uid": "zhcn:7900c0f94aa9aaa582cd2f8a",
      "source_batch": 219,
      "entry_index": 53,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1010"
      ],
      "key": null,
      "source_text": "Howdy！我叫大树快车！\\n我要用我充满力量感的赛跑给大家带来Happy！",
      "source_fingerprint": "aa2187dbc6ecfe06f92fdd2cc6dd664cf10a52eaa873314044f33252a80a62fd",
      "current_text": "Howdy! Tôi là Taiki Shuttle!\\nTôi sẽ mang Happy đến cho mọi người bằng những cuộc đua đầy Power của mình!",
      "current_fingerprint": "99c3f61ca1115b13ceed877838f0ca778d45c5c8c20fa451fba39215f1beb0cb",
