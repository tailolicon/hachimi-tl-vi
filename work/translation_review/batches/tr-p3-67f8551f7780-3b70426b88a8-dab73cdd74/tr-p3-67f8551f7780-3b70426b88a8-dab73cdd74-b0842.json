      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:0314ef8777103e7b6a92100d",
      "source_batch": 219,
      "entry_index": 50,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1007"
      ],
      "key": null,
      "source_text": "哟，是我黄金船大人哒！\\n在火焰中、草地中！或是宇宙的尽头都无所谓！\\n无论身处何处我都要探寻有趣的东西～☆",
      "source_fingerprint": "e15a26ee2ed0584df4cb27f59703d710a3915fa243f1ffe06fd849830dcda36c",
      "current_text": "Yo, ta là ngài Gold Ship đây!\\nDù trong lửa, trên đồng cỏ! Hay tận cùng vũ trụ cũng chẳng sao!\\nDù ở đâu ta cũng sẽ săn tìm những thứ thú vị～☆",
      "current_fingerprint": "e0787cd43f75b91662b36fe4deec191651b500e219b21a1dbb0f25b17eea9aa2",
      "risk_flags": [
        "community_term",
