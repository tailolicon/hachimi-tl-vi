      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f03028a8f838069579be134e",
      "source_batch": 219,
      "entry_index": 52,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1009"
      ],
      "key": null,
      "source_text": "你好，我叫大和赤骥！\\n做什么事情都要竭尽全力……嗯？你就是我的训练员吗。哼！\\n我的目标只有第一名。除此之外别无他物！",
      "source_fingerprint": "54944baa86ff99b3ccf240d7603c2321faa249524ea139bb154b35091b7f5b14",
      "current_text": "Xin chào, mình là Daiwa Scarlet!\\nLàm gì cũng phải dốc hết sức…… Hửm? Bạn là Trainer của mình à. Hừ!\\nMục tiêu của mình chỉ có hạng nhất. Ngoài ra chẳng có gì khác!",
      "current_fingerprint": "35a25bee53330d78158ae27df657286e53ffe12c9da30185318f9f4475067835",
      "risk_flags": [
        "community_term",
        "absence_risk"
