    {
      "uid": "zhcn:2b9bae1443d2f903ca91a2a3",
      "source_batch": 219,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1001"
      ],
      "key": null,
      "source_text": "我的名字叫特别周！\\n梦想是成为日本第一的赛马娘！\\n为了让妈妈们感到欣慰，我会加油的！",
      "source_fingerprint": "00ca9fbb196091f984161acbd4170f7de6d5c2fa5a768352e0504114d898bf76",
      "current_text": "Mình là Special Week!\\nƯớc mơ của mình là trở thành Uma Musume số một Nhật Bản!\\nĐể các mẹ vui lòng, mình sẽ cố gắng hết sức!",
      "current_fingerprint": "695f8d3138edad591e8103f118bc3dbaeb79c28083ac365d87a9f64f89718aed",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:a9940218c0050b68276945b8",
      "source_batch": 219,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1002"
      ],
      "key": null,
      "source_text": "我的名字是无声铃鹿。\\n喜欢的事情是奔跑。那前方的景色，不会让给任何人。\\n嗯……那个，就是这样。",
      "source_fingerprint": "95676b78b0f3a16d8d1d73e89f456496dd88a14dfc0d796b752916be19f006db",
      "current_text": "Tôi là Silence Suzuka.\\nĐiều tôi thích là chạy. Khung cảnh phía trước ấy, tôi sẽ không nhường cho bất kỳ ai.\\nỪm…… chỉ vậy thôi.",
      "current_fingerprint": "fbc4ca6e01db51930ee6aa14359d62872698de9319312a2724c498e88f391037",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ddad61f331e40b89288507c4",
      "source_batch": 219,
      "entry_index": 46,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1003"
      ],
      "key": null,
      "source_text": "呀吼，我是东海帝王！\\n事关不败的三冠赛马娘，\\n我绝——对不会错过！",
      "source_fingerprint": "37a517d69faaa11cff3c06d3a991f0bf0a1f4c61961d9c7d8d2c4d8017709ba1",
      "current_text": "Yahoo, tớ là Tokai Teio!\\nMục tiêu là trở thành Uma Musume Tam Quan bất bại,\\ntớ tuyệt——đối sẽ không bỏ lỡ!",
      "current_fingerprint": "8ecfac6e5e642c9ea967a7cf1b83ede65cf12fb4ef8eaacaf80c36659f989ed7",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:44ed72d59958bbd21524ba45",
      "source_batch": 219,
      "entry_index": 47,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1004"
      ],
      "key": null,
      "source_text": "Hi～，我是丸善斯基哟！\\n你也是来看的吧？我那异次元般的跑法。\\n哼哼♪被迷的神魂颠倒的话……我可不管哦♪",
      "source_fingerprint": "24dcae83a61984ad3ed255c7be2ac5935be8e698b53da5475ee4203d40b7d64a",
      "current_text": "Hi～, mình là Maruzensky!\\nBạn cũng đến xem nhỉ? Cách chạy như đến từ chiều không gian khác của mình ấy.\\nHừm hừm♪ Nếu mê mẩn đến mất hồn…… mình không chịu trách nhiệm đâu nhé♪",
      "current_fingerprint": "41b9d5f5b059b4a003ab9a15fe4c06d2abb8a7643724a692f2a1362fdfc434ed",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_term_mismatch"
      ],
      "risk_score": 11,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.style",
          "preferred": "Style",
          "accepted": [
            "Style"
          ],
          "forbidden": [
            "Lối chạy"
          ],
          "matched_aliases": [
            "跑法"
          ],
          "accepted_present": false,
          "forbidden_present": false,
          "require_accepted": true,
          "basis": "Common EN-version category label."
        }
      ],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:74226dbb17a41bf3b191f7df",
      "source_batch": 219,
      "entry_index": 48,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1005"
      ],
      "key": null,
      "source_text": "让客人们都欢笑的漆黑的艺人\\n就是我富士奇石！用最棒的“奇迹”，\\n必定夺得你的笑容！",
      "source_fingerprint": "f707e1915edad23125ce00c58acc3cb42996aae52f4e5d611f4f9fed6136e79f",
      "current_text": "Nghệ sĩ áo đen mang nụ cười đến cho mọi khán giả\\nchính là tôi, Fuji Kiseki! Với “phép màu” tuyệt vời nhất,\\ntôi nhất định sẽ giành lấy nụ cười của bạn!",
      "current_fingerprint": "275f398d7a8ab9fe6fc039ba719d33754aa8bb41e71ac36fca7ca78c59635ada",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.fuji_kiseki",
          "target_vi": "Fuji Kiseki",
          "matched_aliases": [
            "富士奇石"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:1b80247fa5482940808de61c",
      "source_batch": 219,
      "entry_index": 49,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1006"
      ],
      "key": null,
      "source_text": "我是小栗帽。\\n为了让故乡支持我的大家都能够开心，\\n我会全力以赴的。请多关照",
      "source_fingerprint": "53abbcb94c82b41cb628ba5136671d030bc1bef223b39d5aa3a2542d29beb8bc",
      "current_text": "Tôi là Oguri Cap.\\nĐể mọi người ở quê nhà luôn ủng hộ tôi được vui,\\ntôi sẽ dốc toàn lực. Mong được giúp đỡ.",
      "current_fingerprint": "f837df839be8bf9ebc143b560505ce7dcd3474c8de16de10baf05f08a0828ba3",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
