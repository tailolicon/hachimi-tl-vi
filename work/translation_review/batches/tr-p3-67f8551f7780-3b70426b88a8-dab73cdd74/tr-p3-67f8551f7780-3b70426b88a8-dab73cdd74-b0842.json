    {
      "uid": "zhcn:80300e73413f315a0a7a079c",
      "source_batch": 219,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1008"
      ],
      "key": null,
      "source_text": "哦！我是伏特加！\\n我的原则就是做一个比谁都要帅气的赛马娘！\\n逊爆了的事情是不会做的。给我记好了！",
      "source_fingerprint": "78a417d31ce47a7486fca08853b6ec92e06e3452b419e5de0d457ed37ca9a64e",
      "current_text": "Ồ! Tôi là Vodka!\\nNguyên tắc của tôi là trở thành Uma Musume ngầu hơn bất kỳ ai!\\nMấy chuyện quê mùa tôi không làm đâu. Nhớ kỹ đấy!",
      "current_fingerprint": "8377c2872c1a7c58571173cbc6e88f0dd0fe68e864fa29a5da5e3137bbbe65ae",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        },
        {
          "id": "character.vodka",
          "target_vi": "Vodka",
          "matched_aliases": [
            "伏特加"
          ],
          "present": true
        }
      ],
      "community_terms": [],
