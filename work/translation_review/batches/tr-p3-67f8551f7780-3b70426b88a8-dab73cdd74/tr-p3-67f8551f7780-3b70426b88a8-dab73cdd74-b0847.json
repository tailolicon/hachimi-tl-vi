    },
    {
      "uid": "zhcn:343f28e0cc6dfa23229e7508",
      "source_batch": 220,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1110"
      ],
      "key": null,
      "source_text": "我的夙愿，是加冕后冠，\\n令其成为我光辉未来的基石。\\n――还请你多多指教哦♪",
      "source_fingerprint": "16c0a15d855528a6d21ea77aa8ff81b02998392a2ef09a53ce463df465a5741a",
      "current_text": "Ước nguyện từ lâu của tôi là được đội vương miện,\\nđể nó trở thành nền móng cho tương lai rực rỡ của mình.\\n――Mong bạn giúp đỡ tôi thật nhiều nhé♪",
      "current_fingerprint": "202a6b44190eac15ea6c7eb788a1fd43f25240a5dc33927de74af618caec7409",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:5cc7e5cfa1c29a43c16c871a",
      "source_batch": 220,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1111"
      ],
      "key": null,
      "source_text": "目标是成为强大又华丽……像母亲那样的马娘\\n空中救主——传承之伟大，\\n未来相连之尊贵，就由我来证明。",
      "source_fingerprint": "1b3c67bb4338b65036ee000c62d0672ea7fbe754966d30c66872d915d1794ee0",
      "current_text": "Mục tiêu là trở thành một Uma Musume mạnh mẽ và lộng lẫy… như mẹ.\\nAir Messiah――sự vĩ đại của truyền thừa,\\nvà sự cao quý kết nối tương lai, tôi sẽ chứng minh.",
      "current_fingerprint": "9395a1b727e1283ddd1d3fccba1dde2dbe53185a3d3b1f74d87f5710dd0801bd",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:593538081e6f3fdb999334c5",
      "source_batch": 220,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1112"
      ],
      "key": null,
      "source_text": "Follow my lead! 敬请期待哦。\\n后冠之光辉定会降临到我身上。\\n我就是未来的女王・勇敢之心！",
      "source_fingerprint": "633397a487b53a140491133b988592216dcc49d708f7b6e15eafa367f82fb3f9",
      "current_text": "Follow my lead! Hãy chờ xem nhé.\\nÁnh hào quang của vương miện nhất định sẽ đến với tôi.\\nTôi chính là nữ vương tương lai・Daring Heart!",
      "current_fingerprint": "4a05ce4ee4da1e7a0a6b2090c81b6fd3de3e539405f4cd0544fff1effada0d71",
