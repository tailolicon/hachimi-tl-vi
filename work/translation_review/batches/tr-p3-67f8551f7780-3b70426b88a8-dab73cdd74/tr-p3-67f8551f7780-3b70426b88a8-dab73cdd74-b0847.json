      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1097"
      ],
      "key": null,
      "source_text": "我是爱如往昔……我……\\n不，我并没有什么可说的……\\n即便有，嗯……也只有一些秘密，罢了……",
      "source_fingerprint": "9e38f1e4b855dad3e538c2ef143dc4d1f6718a6121fbddcc6b9513fc459b93b2",
      "current_text": "Tôi là Still in Love… tôi…\\nKhông, tôi chẳng có gì để nói cả…\\nDù có thì, ừm… cũng chỉ là vài bí mật, thế thôi…",
      "current_fingerprint": "5e0567b9c95a08292dc8df6ec52c20f09f4764d245a4e53233ba13459a3bfa2b",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [
        {
          "id": "character.still_in_love",
          "target_vi": "Still in Love",
          "matched_aliases": [
            "爱如往昔"
          ],
          "present": true
