    {
      "uid": "zhcn:7957d1c6e76a5cfe00f4344b",
      "source_batch": 220,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1082"
      ],
      "key": null,
      "source_text": "你好，我是北方飞翔！从衣服、化妆、\\n配饰，到持之以恒的努力，\\n请见证我在各方面所磨练出的光辉吧！",
      "source_fingerprint": "99e98c2884c70aa72b01714aab0ca1e4cf08d12e20a16e1e6f4918eb2450ca66",
      "current_text": "Xin chào, tôi là North Flight! Từ quần áo, trang điểm,\\nphụ kiện, cho đến sự nỗ lực bền bỉ,\\nhãy chứng kiến ánh sáng tôi đã mài giũa trên mọi phương diện!",
      "current_fingerprint": "5fa230ccb46e65f0f215a51bb4e9f050a1a7f8e9a5a7fa71aac0a76ed00ae673",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.north_flight",
          "target_vi": "North Flight",
          "matched_aliases": [
            "北方飞翔"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
