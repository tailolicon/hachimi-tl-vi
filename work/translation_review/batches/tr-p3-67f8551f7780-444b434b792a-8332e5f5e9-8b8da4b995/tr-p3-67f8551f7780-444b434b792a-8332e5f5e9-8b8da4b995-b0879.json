    {
      "uid": "zhcn:db3c10af4c98705d001802c1",
      "source_batch": 220,
      "entry_index": 50,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1087"
      ],
      "key": null,
      "source_text": "我是小真。真弓快车。\\n总有一天我会成为世界的吉祥物。\\n请用你的那双眼一直看着我吧",
      "source_fingerprint": "32b8ffb7d15fb14ee16b277e776abfc16eee61eb27d3bf3257b64a2d12e683ab",
      "current_text": "Tôi là Machan. Aston Machan.\\nMột ngày nào đó, tôi sẽ trở thành linh vật của cả thế giới.\\nHãy luôn dõi theo tôi bằng chính đôi mắt ấy nhé.",
      "current_fingerprint": "d7028cd2ea082cc1c8f81f8299585703c87ac3fae65f96b3f863ee3cfab93185",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.aston_machan",
          "target_vi": "Aston Machan",
          "matched_aliases": [
            "真弓快车"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d283a8858523a0d1bcd52f5d",
      "source_batch": 220,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1088"
      ],
      "key": null,
      "source_text": "我是里见皇冠哦。我一定要为里见家夺得荣冠。\\n为此我会做好一切准备，\\n化逆境为力量！敬请期待！",
      "source_fingerprint": "63e287e730b33c4bfb89f40ce4fa822e290fce6229b1c0e913307e2de501a3a4",
      "current_text": "Tôi là Satono Crown. Tôi nhất định sẽ mang vương miện về cho nhà Satono.\\nVì thế, tôi sẽ chuẩn bị mọi thứ thật chu toàn,\\nbiến nghịch cảnh thành sức mạnh! Hãy chờ xem nhé!",
      "current_fingerprint": "5d288d934959a630549f5ddb2f8cbe9c6975b4a3f0c9fba7321fc3e665e9d9ec",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [],
