    {
      "uid": "zhcn:1cc3dda86d2201a7a1063a01",
      "source_batch": 220,
      "entry_index": 49,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1086"
      ],
      "key": null,
      "source_text": "想要了解我？那就去草地上吧。\\n关于我…目白高峰的一切都在那里",
      "source_fingerprint": "8bc52af7ca7979dcf3f47b9742e3895bb95f5c73a4e64a8bcb7cde03ceda41e7",
      "current_text": "Muốn hiểu tôi sao? Vậy hãy ra sân cỏ.\\nMọi thứ về tôi… Mejiro Ramonu, đều ở nơi đó.",
      "current_fingerprint": "385819776c65c601031a0b686eb741e1358760e481caa69e34b1f8f6f88b54d0",
      "risk_flags": [
