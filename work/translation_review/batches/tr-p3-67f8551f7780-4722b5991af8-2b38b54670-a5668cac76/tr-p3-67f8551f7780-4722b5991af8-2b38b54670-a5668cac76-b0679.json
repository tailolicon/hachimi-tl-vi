    {
      "uid": "zhcn:2b9bae1443d2f903ca91a2a3",
      "source_batch": 219,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1001"
      ],
      "key": null,
      "source_text": "我的名字叫特别周！\\n梦想是成为日本第一的赛马娘！\\n为了让妈妈们感到欣慰，我会加油的！",
      "source_fingerprint": "00ca9fbb196091f984161acbd4170f7de6d5c2fa5a768352e0504114d898bf76",
      "current_text": "Mình là Special Week!\\nƯớc mơ của mình là trở thành Uma Musume số một Nhật Bản!\\nĐể các mẹ vui lòng, mình sẽ cố gắng hết sức!",
      "current_fingerprint": "695f8d3138edad591e8103f118bc3dbaeb79c28083ac365d87a9f64f89718aed",
      "risk_flags": [
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 16,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.world.umamusume",
          "preferred": "Mã Nương",
          "accepted": [
            "Mã Nương"
          ],
          "forbidden": [
            "Uma Musume"
          ],
          "matched_aliases": [
            "赛马娘"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "Vietnamese project term established by the official Vietnamese anime subtitle usage supplied by the project owner; applies to the generic world/species term, not the franchise title."
        }
      ],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:a9940218c0050b68276945b8",
      "source_batch": 219,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1002"
      ],
      "key": null,
      "source_text": "我的名字是无声铃鹿。\\n喜欢的事情是奔跑。那前方的景色，不会让给任何人。\\n嗯……那个，就是这样。",
      "source_fingerprint": "95676b78b0f3a16d8d1d73e89f456496dd88a14dfc0d796b752916be19f006db",
      "current_text": "Tôi là Silence Suzuka.\\nĐiều tôi thích là chạy. Khung cảnh phía trước ấy, tôi sẽ không nhường cho bất kỳ ai.\\nỪm…… chỉ vậy thôi.",
      "current_fingerprint": "fbc4ca6e01db51930ee6aa14359d62872698de9319312a2724c498e88f391037",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:ddad61f331e40b89288507c4",
      "source_batch": 219,
      "entry_index": 46,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1003"
      ],
      "key": null,
      "source_text": "呀吼，我是东海帝王！\\n事关不败的三冠赛马娘，\\n我绝——对不会错过！",
      "source_fingerprint": "37a517d69faaa11cff3c06d3a991f0bf0a1f4c61961d9c7d8d2c4d8017709ba1",
      "current_text": "Yahoo, tớ là Tokai Teio!\\nMục tiêu là trở thành Uma Musume Tam Quan bất bại,\\ntớ tuyệt——đối sẽ không bỏ lỡ!",
      "current_fingerprint": "8ecfac6e5e642c9ea967a7cf1b83ede65cf12fb4ef8eaacaf80c36659f989ed7",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.world.umamusume",
          "preferred": "Mã Nương",
          "accepted": [
            "Mã Nương"
          ],
          "forbidden": [
            "Uma Musume"
