    {
      "uid": "zhcn:d97b972db0f8aed2db4f63bf",
      "source_batch": 220,
      "entry_index": 38,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1075"
      ],
      "key": null,
      "source_text": "我是谋勇兼备。\\n为了严格而温暖地养育着我的故乡……\\n梦想是『成为名留历史的马娘』！",
      "source_fingerprint": "0f5fba736c983e9355bef23b1e67c716fe9bfd3960db6b3f76b0c31348964c92",
      "current_text": "Tôi là Daring Tact.\\nVì quê hương đã nghiêm khắc mà ấm áp nuôi dưỡng tôi…\\nƯớc mơ của tôi là “trở thành một Uma Musume lưu danh sử sách”!",
      "current_fingerprint": "77b68517a43a7dcb549df82ae5d3cee2f42a326af39ce72351d3b933dddf682b",
