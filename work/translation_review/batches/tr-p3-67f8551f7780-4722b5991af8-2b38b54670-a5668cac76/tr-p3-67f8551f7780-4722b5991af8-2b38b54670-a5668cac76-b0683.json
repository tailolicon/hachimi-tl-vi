        },
        {
          "id": "character.sakura_laurel",
          "target_vi": "Sakura Laurel",
          "matched_aliases": [
            "樱花桂冠"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
