      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1069"
      ],
      "key": null,
      "source_text": "我、我叫樱花千代王！\\n与憧憬的那个人一起，站在梦寐以求的舞台上\\n这个梦想——我一定会将其实现！",
      "source_fingerprint": "f5affeee9f1344443e31605db26f233ab7ea6161f4a9be170df9a699243a6c86",
      "current_text": "T-tôi là Sakura Chiyono O!\\nĐược đứng cùng người mình ngưỡng mộ trên sân khấu hằng mơ ước—\\ngiấc mơ ấy, tôi nhất định sẽ biến thành hiện thực!",
      "current_fingerprint": "ad1ebaa213062f03d41e78da25e090bec6bb57db80a3095e4e5ad027e480ef07",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
