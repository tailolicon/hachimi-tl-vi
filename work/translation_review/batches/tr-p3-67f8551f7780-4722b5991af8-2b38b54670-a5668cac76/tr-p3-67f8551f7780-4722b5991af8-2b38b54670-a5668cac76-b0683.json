    {
      "uid": "zhcn:380c57dac2fce28eea364cbe",
      "source_batch": 220,
      "entry_index": 36,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1073"
      ],
      "key": null,
      "source_text": "我是鹤丸刚志！我会以『三冠赛马娘』\\n为目标！总之，先全力——咳唔？！\\n……只、只是被呛到了而已！我超健康的，不用担心！",
      "source_fingerprint": "14e7a2fc79a11c70fd296f8fc511711b039ce7339f2db65278775fa2242ccbbb",
      "current_text": "Tôi là Tsurumaru Tsuyoshi! Mục tiêu của tôi là trở thành\\n“Uma Musume Tam Quan”! Trước hết, dốc hết sức—khụ?!\\n…Ch-chỉ là bị sặc thôi! Tôi siêu khỏe mạnh, đừng lo!",
      "current_fingerprint": "2acadcb19998b87fcca46b90e43fb87dc2e78abfacb4e920c7112d2bb5173aca",
