    {
      "uid": "zhcn:8266bda1e4fddd8098855a37",
      "source_batch": 220,
      "entry_index": 39,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1076"
      ],
      "key": null,
      "source_text": "我是樱花桂冠。我的目标是，世界。\\n是凯旋门赏！――呵呵，虽然它现在\\n只是个『梦』……但总有一天必会实现",
      "source_fingerprint": "46bf29de9fd639b214fbfb9957190285a72eb166f6b8745fd5ba7f1883ba1884",
      "current_text": "Tôi là Sakura Laurel. Mục tiêu của tôi là thế giới.\\nLà Prix de l’Arc de Triomphe! ――Fufu, tuy hiện giờ\\nđó vẫn chỉ là một “giấc mơ”… nhưng một ngày nào đó nhất định sẽ thành hiện thực.",
      "current_fingerprint": "3f1ee8c6b6a4f08aa6755028a6d8225996fcf0fa9ae0ea733e9011125e3aee63",
      "risk_flags": [
        "very_long_target",
