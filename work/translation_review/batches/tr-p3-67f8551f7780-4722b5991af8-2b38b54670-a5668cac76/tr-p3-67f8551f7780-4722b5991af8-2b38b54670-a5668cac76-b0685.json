      "json_path": [
        "163",
        "1115"
      ],
      "key": null,
      "source_text": "不敬，速跪。\\n――面对吾黄金巨匠之霸道，\\n虔诚顺服为宜",
      "source_fingerprint": "c7f44389d84ed456ea62a35da9ad8e2eeec1e4e349395bcd3af15a5a7eba845f",
      "current_text": "Bất kính. Mau quỳ xuống.\\n――Trước bá đạo của ta, Orfevre,\\ntốt hơn hết hãy thành kính quy phục.",
      "current_fingerprint": "0de86bf4b80681b2ed7dea5fc3a68974ea6a26c6715616da73492dd7330f772d",
