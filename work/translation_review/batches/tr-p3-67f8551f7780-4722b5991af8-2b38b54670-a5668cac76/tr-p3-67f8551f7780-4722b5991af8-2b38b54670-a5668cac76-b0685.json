      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1110"
      ],
      "key": null,
      "source_text": "我的夙愿，是加冕后冠，\\n令其成为我光辉未来的基石。\\n――还请你多多指教哦♪",
      "source_fingerprint": "16c0a15d855528a6d21ea77aa8ff81b02998392a2ef09a53ce463df465a5741a",
      "current_text": "Ước nguyện từ lâu của tôi là được đội vương miện,\\nđể nó trở thành nền móng cho tương lai rực rỡ của mình.\\n――Mong bạn giúp đỡ tôi thật nhiều nhé♪",
      "current_fingerprint": "202a6b44190eac15ea6c7eb788a1fd43f25240a5dc33927de74af618caec7409",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
