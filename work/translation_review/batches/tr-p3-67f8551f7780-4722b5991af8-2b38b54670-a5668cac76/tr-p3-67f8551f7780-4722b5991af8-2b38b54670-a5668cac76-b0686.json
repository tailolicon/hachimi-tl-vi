    {
      "uid": "zhcn:587c204dd87e93a9dacdbf52",
      "source_batch": 221,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1135"
      ],
      "key": null,
      "source_text": "请多关照，我是黄金旅程。\\n来吧，让我们享受一段愉快的旅程！\\n随心所欲地踏上黄金之旅吧",
      "source_fingerprint": "656cb5da1f5cff0104b3a83714a71f773a404658a3b9cf171b613098b03ff379",
      "current_text": "Rất mong được giúp đỡ, tôi là Stay Gold.\\nNào, cùng tận hưởng một chuyến đi vui vẻ nhé!\\nCứ tự do lên đường trên hành trình vàng thôi.",
      "current_fingerprint": "746773cd38361f18e9aaa47588561174e2f7084dec4501f528efc42684c3359f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.stay_gold",
          "target_vi": "Stay Gold",
          "matched_aliases": [
            "黄金旅程"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
