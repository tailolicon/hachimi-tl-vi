    {
      "uid": "zhcn:8cac50a6cb62de37ee2cdaf8",
      "source_batch": 221,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1137"
      ],
      "key": null,
      "source_text": "我是神业！艰苦的修行，炽热的友情，\\n戏剧性的胜利！在这样的赛场世界里，\\n我一定会成为主角！",
      "source_fingerprint": "6ac266147bd666cb6624f27c801ff33e0e93123053e493587e5ce36fcdaf651c",
      "current_text": "Tôi là Kiseki! Khổ luyện gian nan, tình bạn rực cháy,\\nchiến thắng đầy kịch tính! Trong thế giới trường đua như thế,\\nnhất định tôi sẽ trở thành nhân vật chính!",
      "current_fingerprint": "245a6c7bab03e08a36239b9028718d936887a3e7d4a573f79f20aea12761ab8a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.kiseki",
          "target_vi": "Kiseki",
          "matched_aliases": [
            "神业"
