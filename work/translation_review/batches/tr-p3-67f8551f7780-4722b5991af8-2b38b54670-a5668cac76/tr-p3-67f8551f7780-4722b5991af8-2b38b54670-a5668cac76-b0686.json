    {
      "uid": "zhcn:69faf7dd543501531eea9fdb",
      "source_batch": 221,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1136"
      ],
      "key": null,
      "source_text": "我的名字是红色梦想。\\n前方的路，是一望无际的试炼，\\n为了成为真正的圣女，我会将其全部征服！",
      "source_fingerprint": "8b6969829434b47dbdb8a5c0899145248f4df4a9ae79dd1e9b2623a404dbe182",
      "current_text": "Tên tôi là Red Desire.\\nCon đường phía trước là những thử thách trải dài vô tận,\\nnhưng để trở thành một thánh nữ đích thực, tôi sẽ chinh phục tất cả!",
      "current_fingerprint": "248ba860c73741b05b4ad24a71090924d514f25aa70d42d086a0e1e7210dcc34",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
