      "source_path": "text_data_dict.json",
      "json_path": [
        "139",
        "22"
      ],
      "key": null,
      "source_text": "喜悦与烦恼都能共有共享。\\n对彼此而言都是无可取代的伙伴！",
      "source_fingerprint": "99e3eed5e5aef1d7d24fd621143ce0ef6d35d035a2608c3d71223dc9e5dfea0e",
      "current_text": "Có thể cùng sẻ chia cả niềm vui lẫn phiền muộn.\\nĐối với nhau, hai người là những người đồng hành không thể thay thế!",
      "current_fingerprint": "7d8079e0a4c6a7c16bd250849a043e600c2b071a166d64a9f4f531e8c534e025",
      "risk_flags": [
        "very_long_target",
