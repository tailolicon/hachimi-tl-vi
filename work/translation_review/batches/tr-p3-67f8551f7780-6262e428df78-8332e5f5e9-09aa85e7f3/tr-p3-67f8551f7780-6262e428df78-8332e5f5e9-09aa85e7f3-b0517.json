  "items": [
    {
      "uid": "zhcn:2af1dcfb7fbeb84d4e7b2a54",
      "source_batch": 130,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1013"
      ],
      "key": null,
      "source_text": "星光照亮前路，你的未来充满光明。\\n为支持我的人们表达感谢的1曲。",
      "source_fingerprint": "7641ddc99e7ffeb05e026364d9bba1df777bf3d5166ab0d398a9850fb17c6ade",
      "current_text": "Ánh sao soi sáng con đường phía trước, tương lai của bạn ngập tràn ánh sáng.\\nMột ca khúc gửi lời cảm ơn đến những người luôn ủng hộ tôi.",
      "current_fingerprint": "4a38cfec3eb73d6a48d20622bf3a3cc907c6c29b46c22b65af14ecfd8713aa60",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.6b9641d2417b",
          "target_vi": "Ánh sáng",
          "matched_aliases": [
            "光明"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:6dc6c1ef4029f090a2ee316c",
      "source_batch": 130,
      "entry_index": 1,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1021"
      ],
      "key": null,
      "source_text": "キラキラ！トキメキ！ただ輝く景色を駆け抜ければいい！\\nだって、僕らは愛されるために生まれてきたのだからっ！",
      "source_fingerprint": "73103edd8673496b46e80d574eca927d92a6e86ad5235e4e8327975002ace8f2",
      "current_text": "Lấp lánh! Rung động! Chỉ cần chạy xuyên qua khung cảnh rực sáng là được!\\nBởi vì chúng ta sinh ra để được yêu thương mà!",
      "current_fingerprint": "9ba548ebb8896b02fd6c4dba60257d0a1c4bcbb2d0d30b2dddee48ea3121e4f8",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:9a08773c1635145f9c653503",
      "source_batch": 130,
      "entry_index": 2,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1023"
      ],
      "key": null,
      "source_text": "经常吵架，也互不道歉――但是，想永远一起欢笑下去。\\n这是青涩而又略带苦涩的，我们的友情应援歌。",
      "source_fingerprint": "e0d3797827b94fee2e8976b0de37eceade8a45baf959b6798ccec16e26701f01",
      "current_text": "Thường xuyên cãi nhau, cũng chẳng ai chịu xin lỗi――nhưng vẫn muốn mãi mãi cùng nhau cười vui.\\nĐây là khúc cổ vũ tình bạn non trẻ, ngọt ngào mà hơi đăng đắng của chúng ta.",
      "current_fingerprint": "d50943b49266dc3da19722a30ea9daeb620a43c5383af4c4c66c88cf1c8785ff",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:4356f25f4741607a818a6b75",
      "source_batch": 130,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1024"
      ],
      "key": null,
      "source_text": "把过去、现在所经历过的全部装进宝箱，面向未来！\\n――来吧，让整个世界充满『最喜欢了！』吧。",
      "source_fingerprint": "9e02d74559e808073ffeb2a8ef6329c1fc7177c59ec1755ab2bb469d0800f140",
      "current_text": "Hãy cất tất cả những gì đã trải qua trong quá khứ và hiện tại vào rương báu, rồi hướng tới tương lai!\\n――Nào, hãy lấp đầy cả thế giới bằng câu 『Mình thích nhất!』.",
      "current_fingerprint": "73dc7e30ccd2ffd9d165db5708e35142d471fffebbff151b99ca88210a541b01",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:34bcf34bd6b40461dd198bea",
      "source_batch": 130,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1025"
      ],
      "key": null,
      "source_text": "疾驰的一等星闪耀着，充满勇气与希望的歌曲。\\n心动的预感――那就是比赛开始的信号",
      "source_fingerprint": "316e2a7163d6866624623d20eb585422f060c2a13763ce6ddae613c616b180a6",
      "current_text": "Một ca khúc tràn đầy dũng khí và hy vọng, như ngôi sao sáng nhất đang lao đi rực rỡ.\\nLinh cảm khiến tim rung động――đó chính là tín hiệu cuộc đua bắt đầu.",
      "current_fingerprint": "9a0436d1ef50634a9cc894907485e10d5ab237a05d56d2442d24f8d6d05917e1",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch"
      ],
      "risk_score": 11,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        },
        {
          "id": "reviewed.skill_name.3346bd209f49",
          "target_vi": "Nhịp tim rộn ràng",
          "matched_aliases": [
            "心动"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:7b617fbe398dac5891c75ec7",
      "source_batch": 130,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1026"
      ],
      "key": null,
      "source_text": "若我启程奔跑的话——这是一首融入了虚幻而坚强意志的歌曲。\\n将的思念藏在心中，向夜空中高悬的明月祈祷。",
      "source_fingerprint": "5e905da63e6e793b2e43a4f06587a18e8bc2209eba77821546a19d68debad554",
      "current_text": "Nếu tôi cất bước chạy――đây là ca khúc gửi gắm một ý chí mong manh mà mạnh mẽ.\\nGiấu nỗi niềm trong tim, cầu nguyện với vầng trăng treo cao trên bầu trời đêm.",
      "current_fingerprint": "2a4b8c1c35728deaf38c8899ddc8e22968f7c37793fc76b0f670c47787ec03bb",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:6d1498bbabc0338106c4409b",
      "source_batch": 130,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1027"
      ],
      "key": null,
      "source_text": "心中所起誓的是『最快』二字！　直到极限的尽头\\n疾驰的赛马娘们遵循本能地呼喊！！",
      "source_fingerprint": "58d11166ef0fea76dec387749bf2fd196b5992cef50c8c12d3f8e75670795f01",
      "current_text": "Điều đã thề trong tim chỉ có hai chữ 『nhanh nhất』!　Cho đến tận cùng giới hạn,\\nnhững Uma Musume lao vun vút cất tiếng gào theo bản năng!!",
      "current_fingerprint": "f3caee041bd8ba23d82dac717e8bf64e368bdee8e8a5c197b821a2a9e44866fd",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.world.umamusume",
          "preferred": "Mã Nương",
          "accepted": [
            "Mã Nương"
          ],
          "forbidden": [
            "Uma Musume"
          ],
