      "item_context_sha256": null
    },
    {
      "uid": "zhcn:3fe1b6fe8e6d5a57c7f8e100",
      "source_batch": 130,
      "entry_index": 8,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1029"
      ],
      "key": null,
      "source_text": "想要与你一决胜负。少女们心怀绝不退让的信念，登上舞台。\\n无论是灯火或是烟花……无论怎样的光芒，都绝不可能比身为“主人公”的她们更为闪耀。",
      "source_fingerprint": "451e1bf65f2a4495d2cedac5a3e005536f03281342ef3df4a281853565d4b362",
      "current_text": "Muốn phân thắng bại với bạn. Những cô gái mang niềm tin không bao giờ nhượng bộ bước lên sân khấu.\\nDù là ánh đèn hay pháo hoa… chẳng thứ ánh sáng nào có thể rực rỡ hơn họ, những 『nhân vật chính』.",
      "current_fingerprint": "b01e188dbab31d33ca04dbeebee43e9863c47e49c74ec783efe0b2fa6bfec49a",
      "risk_flags": [
        "negation_capability_risk",
        "absence_risk"
      ],
      "risk_score": 10,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:b89010f4405f60f723dba30f",
      "source_batch": 130,
      "entry_index": 9,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1030"
      ],
      "key": null,
      "source_text": "因为有认真的你陪在身边，我才不论何时都能朝着胜利冲刺！\\n充满活力的青春之歌！",
      "source_fingerprint": "903059c11428286414447e28b27c7b6750c61944fd255502e9019b86b5fab5c8",
      "current_text": "Bởi có bạn luôn nghiêm túc ở bên, nên bất cứ lúc nào tôi cũng có thể lao thẳng tới chiến thắng!\\nMột khúc ca tuổi trẻ tràn đầy sức sống!",
      "current_fingerprint": "39c6bd2975e378dfcae7c4b4c004631e18d8682a8a103e5a35b8ad1123499f7a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:43b89551a25dd48b4a2ff954",
      "source_batch": 130,
      "entry_index": 10,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1031"
      ],
      "key": null,
      "source_text": "对比赛的渴望、执着、焦燥……能感受到炽热而沉重的灵魂的歌曲。\\n即使依旧被命运所囚禁，也无法停止追寻希望的脚步。",
      "source_fingerprint": "b4384c7ab92038ef64b37e3277341dd9f2c6002d19938260af892da0e53b5438",
      "current_text": "Một ca khúc khiến ta cảm nhận được linh hồn nóng bỏng mà nặng trĩu bởi khát vọng, chấp niệm và nôn nóng với cuộc đua…\\nDù vẫn bị số phận giam cầm, bước chân tìm kiếm hy vọng vẫn không thể dừng lại.",
      "current_fingerprint": "a21ef3c26bda107c123bc264d0ce12b289fe72d2e480a7de945352570bf43058",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:9743508c73999cd1196c3ae4",
      "source_batch": 130,
      "entry_index": 11,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1032"
      ],
      "key": null,
      "source_text": "与劲敌一同演唱的爽畅歌曲。\\n『我将与你一同追寻梦想』――这是个铭刻于心的故事。",
      "source_fingerprint": "e55e4f89854dc11ac05cd4c9f79e2d6ba262a2c70ca3651dbd0f9b704e2ceab0",
      "current_text": "Một ca khúc sảng khoái được cất lên cùng đối thủ.\\n『Tôi sẽ cùng bạn theo đuổi giấc mơ』――đó là câu chuyện khắc sâu trong tim.",
      "current_fingerprint": "122ca6ca9dd4d699a85bc24ba6ff2a77c8cc9abcb0751f5aaed17fd1c85dbf18",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:507f1caa3e66bf528e406006",
      "source_batch": 130,
      "entry_index": 12,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1033"
      ],
      "key": null,
      "source_text": "这首乐曲中寄托着大家对未来的憧憬，即便是满天繁星也不及\\n这份心意那般耀眼。你也应是观众之一——梦幻灯光秀，开幕！",
      "source_fingerprint": "ed00fb0f71fe1f9c231f165a2983f1e5fc26c0beeb5ff0a741735909f7d5d637",
      "current_text": "Ca khúc gửi gắm khát vọng tương lai của mọi người; ngay cả trời sao cũng chẳng thể sánh bằng\\nánh sáng của tâm ý này. Bạn cũng là một khán giả――màn trình diễn ánh sáng trong mơ, khai màn!",
      "current_fingerprint": "8afb758f8e34c8dc6ce1d1d0df4fb67058add33e433a359d97e07ae423bc81f2",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:9680c95dbe96a9a386e62b7e",
      "source_batch": 130,
      "entry_index": 13,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1034"
      ],
      "key": null,
      "source_text": "有欢笑也有泪水！将赛马娘们的悠闲时光\\n咻♪的一下塞进去的学园生活之歌☆",
      "source_fingerprint": "b1a697247f2a4d9865c8c630c406626610657a1ec91cf10f70d6c43d10e02e52",
      "current_text": "Có tiếng cười, cũng có nước mắt! Một khúc ca đời sống học viện nhét trọn những khoảnh khắc thư thả của các Uma Musume\\nvào trong một tiếng vút♪ thật nhanh☆",
      "current_fingerprint": "4c951a5cf2d6019c27c5303b91508507a6567753b8c12233a85653ed08d4a1cf",
      "risk_flags": [
        "very_long_target",
