    {
      "uid": "zhcn:5540d834b3601b910967023a",
      "source_batch": 130,
      "entry_index": 14,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1035"
      ],
      "key": null,
      "source_text": "『因为已不是独自一人，所以才会变得更强』\\n大家一起哭泣、欢笑、奔跑――这是牵绊与青春的旋律。",
      "source_fingerprint": "0488fa70f0a556bacb822c2376f4fc56ee9d96b55d384e93b4973a6f15b55865",
      "current_text": "『Chính vì không còn đơn độc nên mới có thể trở nên mạnh mẽ hơn』\\nCùng nhau khóc, cười và chạy――đây là giai điệu của gắn kết và tuổi trẻ.",
      "current_fingerprint": "a2755c07643b8ba9e0e23ddfbd9aa5196829de6426dc07413774af0578af3984",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:f3c89f0e476ce770ed31a53f",
      "source_batch": 130,
      "entry_index": 15,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1036"
      ],
      "key": null,
      "source_text": "超越春夏秋冬，只为与你共奏一曲合音。\\n胸中激昂的心跳化作旋律——终于，遇见大家了。",
      "source_fingerprint": "6f8b6418ea46c154ae2556d6d2190b112faeeac88ebbf3c72abb1f4ff3e4601a",
      "current_text": "Vượt qua xuân hạ thu đông, chỉ để cùng bạn hòa chung một khúc ca.\\nNhịp tim rộn ràng trong lồng ngực hóa thành giai điệu――cuối cùng, mình đã gặp được mọi người.",
      "current_fingerprint": "d31b43534bf9384a3446c98b8bb7910056f817bc7790ef18b8350cb145b564d3",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:da41ce34e2a1d18aee6b11db",
      "source_batch": 130,
      "entry_index": 16,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1037"
      ],
      "key": null,
      "source_text": "向着未知的终点，未曾见过的景色――\\n神秘而又温暖的旋律，推动着你，轻语道：『奔跑起来吧』。",
      "source_fingerprint": "98a180c0907dc3357b0dae3151c6ab1a57d7ec74d42f55f1e6cbfc1290ef7b42",
      "current_text": "Hướng tới đích đến chưa biết, tới phong cảnh chưa từng thấy――\\nGiai điệu bí ẩn mà ấm áp đẩy bạn tiến lên, khẽ thì thầm: 『Hãy chạy đi』.",
      "current_fingerprint": "f690eaa43c510d951c48c2ee8749cbf13294909a727a7a156ffdc37039fff4da",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:a2a3767321b11ae9cbca3b40",
      "source_batch": 130,
      "entry_index": 17,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1040"
      ],
      "key": null,
      "source_text": "友情、竞争、眼泪、笑容、不安、希望――\\n全部都是闪闪发光着的歌♪『青春』一定就是这样的感觉！",
      "source_fingerprint": "e50b55d8423cf9573edd350559d6daf12e1ca9752f11b1663599c9645aeb130f",
      "current_text": "Tình bạn, cạnh tranh, nước mắt, nụ cười, bất an, hy vọng――\\ntất cả đều là những khúc ca lấp lánh♪ 『Tuổi trẻ』 chắc hẳn chính là cảm giác như thế này!",
      "current_fingerprint": "d7eab2dda555c6d1d920eb1d87389d1e5aa886235d90beed6ae7e3480d41128a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:001d948bfb04b0b9edc11858",
      "source_batch": 130,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1041"
      ],
      "key": null,
      "source_text": "描绘了互相切磋的少女们的心意的乐曲。\\n梦想多么高远、多么宽广、多么蔚蓝生辉。来，一同前行吧！",
      "source_fingerprint": "ddbec9999bc68a0bb15899e52500f78e4bc5afbc0af44e45f19295a434dad578",
      "current_text": "Một ca khúc khắc họa tâm tư của những cô gái cùng nhau mài giũa bản thân.\\nGiấc mơ thật cao, thật rộng và xanh biếc rực rỡ. Nào, cùng tiến bước thôi!",
      "current_fingerprint": "854b7d902803b88ed1c2d2f425d3cf6d89d4ffaaedae9eac0d05adf09128f5fe",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:ded1aefad3969e2e268d2d74",
      "source_batch": 130,
      "entry_index": 19,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1042"
      ],
      "key": null,
      "source_text": "要向着梦想奔跑。这是谱写了这份决心的乐曲。\\n即使迷茫，即使不安，也要向前迈进。将这首歌作为路标。",
      "source_fingerprint": "04b62a9696999297efd11a8b212e6b94a11d055275f7ed1d107baf6a6eed360a",
      "current_text": "Phải chạy về phía giấc mơ. Đây là ca khúc viết nên quyết tâm ấy.\\nDù lạc lối, dù bất an, vẫn phải tiến về phía trước. Hãy lấy bài hát này làm cột mốc dẫn đường.",
      "current_fingerprint": "d9e2b443b7afccec99296542d04f877280079598885968cb132250b29de2a564",
