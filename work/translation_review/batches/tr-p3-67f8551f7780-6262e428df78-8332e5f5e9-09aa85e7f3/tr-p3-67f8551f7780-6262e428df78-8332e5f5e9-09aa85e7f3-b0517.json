    },
    {
      "uid": "zhcn:317744a81c16e2f2bc618e52",
      "source_batch": 130,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1028"
      ],
      "key": null,
      "source_text": "只有赢得经典三冠者才有资格演唱的歌曲。\\n这首歌曲是所有赛马娘的『向往』。",
      "source_fingerprint": "586fb412869663ed682723ec58b0a1ebc22a47971c6efa5095a89d0d0de18b76",
      "current_text": "Ca khúc chỉ người giành được Tam Quan Classic mới có tư cách cất tiếng hát.\\nĐây là 『niềm ao ước』 của tất cả Uma Musume.",
      "current_fingerprint": "2879a3808b40350ac45c818daeed5f7c4a4321abf3a968137784aab7d4a9abf0",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.world.umamusume",
          "preferred": "Mã Nương",
          "accepted": [
            "Mã Nương"
          ],
          "forbidden": [
            "Uma Musume"
          ],
          "matched_aliases": [
            "赛马娘"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "Vietnamese project term established by the official Vietnamese anime subtitle usage supplied by the project owner; applies to the generic world/species term, not the franchise title."
        }
      ],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
