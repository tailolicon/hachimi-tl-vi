    {
      "uid": "zhcn:4f3111e6b58d38db3678e5dc",
      "source_batch": 132,
      "entry_index": 23,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "8506"
      ],
      "key": null,
      "source_text": "ダービースタリオン マスターズ春の１曲。\\nそのハーモニーは新たな生命の息吹を感じさせる。",
      "source_fingerprint": "ffc003000aad4224b69f71a58420ec0a6b3a06fdbd3457e7fdde3bdc54c4d9e5",
      "current_text": "Một ca khúc mùa xuân của ダービースタリオン マスターズ.\\nPhần hòa âm khiến ta cảm nhận hơi thở của một sinh mệnh mới.",
      "current_fingerprint": "958dcddeac59188b2efc5fd3eece99dec245518d1e04ae3c3ccd06a1a57986aa",
      "risk_flags": [
        "cjk_in_target"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:2a20b550318ee5cde16fe76d",
      "source_batch": 132,
      "entry_index": 24,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "8507"
      ],
      "key": null,
      "source_text": "ダービースタリオン マスターズ夏の１曲。\\nそのリズムは降り注ぐ太陽の煌きを感じさせる。",
      "source_fingerprint": "1ac8325932e171f1c380e956e9db5eab38d4f7e647e5822ac67d0bebbdc0a47e",
      "current_text": "Một ca khúc mùa hè của ダービースタリオン マスターズ.\\nNhịp điệu khiến ta cảm nhận ánh mặt trời rực rỡ tuôn xuống.",
      "current_fingerprint": "9b6674b7ea20babfee33596c81c010197de9c9bd7e91451bb5cd93b683b065fb",
      "risk_flags": [
        "cjk_in_target"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
