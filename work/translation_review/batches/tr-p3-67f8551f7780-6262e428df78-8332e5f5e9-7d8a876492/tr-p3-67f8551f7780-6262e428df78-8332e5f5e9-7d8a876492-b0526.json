    },
    {
      "uid": "zhcn:0b3ef29ce6fdf321ce57e473",
      "source_batch": 132,
      "entry_index": 21,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "8504"
      ],
      "key": null,
      "source_text": "于StarHorse4的生产环节播放的BGM。\\n是能够慢慢思考自己专属血统表的曲风。",
      "source_fingerprint": "804813b23274f0fa5464d3699b9159a183052c8de67dd6a6580f7ec0c89094ae",
      "current_text": "BGM phát trong giai đoạn phối giống của StarHorse4.\\nGiai điệu cho phép bạn thong thả suy nghĩ về phả hệ riêng của mình.",
      "current_fingerprint": "f11c9e9dae1f842841c0dcae65097e13399f5744f63cc613da093dc119fce2df",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
