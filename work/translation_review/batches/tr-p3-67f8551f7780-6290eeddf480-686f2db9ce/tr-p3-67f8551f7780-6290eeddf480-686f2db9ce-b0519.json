  "plan_id": "tr-p3-67f8551f7780-6290eeddf480-686f2db9ce",
  "batch_id": "tr-p3-67f8551f7780-6290eeddf480-686f2db9ce-b0519",
  "context_snapshot_sha256": "686f2db9cee00fb817784f762f43bda887ffa240e8a87509255fe01b19a0b655",
  "source_bridge_policy_sha256": "8659db357bac0cb95793321c49890ef5a5be5246ee618d8c6722925326f4363c",
  "review_generation": "retrospective-canonical-full-review",
  "context_mode": "embedded-first-lazy-extra",
  "items": [
    {
      "uid": "zhcn:1d0327588b26cadc305a30b5",
      "source_batch": 130,
      "entry_index": 40,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1064"
      ],
      "key": null,
      "source_text": "将胜利握入手中。疾驰至天涯海角。\\n无人可挡，那觉悟便是――『一马当先，万马无光』。",
      "source_fingerprint": "07f6b20f4c60ae2c2dfa464eb93288b1a24f7ff349bd0d341dd22031461a6e0f",
      "current_text": "Nắm chiến thắng trong tay. Phi tới tận cùng trời đất.\\nKhông ai có thể cản bước; quyết tâm ấy chính là――『một ngựa dẫn đầu, vạn ngựa lu mờ』.",
      "current_fingerprint": "2fa2fe5bfd4abb925374333fcd4d931c3759ec503bc5be94340fb547ee6941c4",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:edc585d5fe60b7db9c7e06ef",
      "source_batch": 130,
      "entry_index": 41,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1065"
      ],
      "key": null,
      "source_text": "温柔地向支持者们表达感谢的，治愈的旋律。\\n我想用硕大的爱去回应。与你一同，踏起柔和的步调。",
      "source_fingerprint": "8b4ae24abdabae1ed216e6ddd029cea9234660753045f8cdbaebc12891630a6a",
      "current_text": "Giai điệu chữa lành, dịu dàng gửi lời cảm ơn đến những người luôn ủng hộ.\\nTôi muốn đáp lại bằng tình yêu thật lớn lao. Cùng bạn, bước theo nhịp điệu êm đềm.",
      "current_fingerprint": "365657a90a4f64f9627791286501933f13e4acfc08ddfe678a0ee365aae17557",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:0e4f467bdb420ebcabcb5130",
      "source_batch": 130,
      "entry_index": 42,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1066"
      ],
      "key": null,
      "source_text": "势必劈开所有迎面而来的狂风。轰鸣着白色斗志的1曲。\\n胜利不可退让，故继续抗争。那就是，咱的战斗之道呀。",
      "source_fingerprint": "9a3bf4c3df6ba37a480934770c192e9f7b329d66f00b51dac42a5640166e89b4",
      "current_text": "Nhất định sẽ xé toạc mọi cơn cuồng phong ập tới. Một ca khúc gầm vang ý chí chiến đấu trắng rực.\\nChiến thắng không thể nhường, vì vậy ta tiếp tục chiến đấu. Đó chính là cách ta chiến đấu.",
      "current_fingerprint": "f43b404e983074e19e1064fa8f253963e02e9e7f1799182358da6e7dfbdad630",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6e85776dbf767bec4076f297",
      "source_batch": 130,
      "entry_index": 43,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1067"
      ],
      "key": null,
      "source_text": "以向往之心纺织而成的，纯情之歌。憧憬永不会停止。\\n因为……唯有这场比赛，我不愿败北。",
      "source_fingerprint": "a4b1823c88499c79c354f7056d09af963ce26fcd466f13c0f196428be047afef",
      "current_text": "Một khúc tình ca trong sáng được dệt nên từ lòng ngưỡng mộ. Niềm khát khao sẽ không bao giờ dừng lại.\\nBởi vì… chỉ riêng cuộc đua này, tôi không muốn thua.",
      "current_fingerprint": "a7cdcd19b8a71e325d679fbf811e22813afb6f380198e12aa100f9d5879fd711",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:27d9e84b2202b9fa15c55fb8",
      "source_batch": 130,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1068"
      ],
      "key": null,
      "source_text": "唱响那憧憬之梦、那背负心愿而奔跑的决意的歌曲。\\n做一个永不会结束的梦吧――不论几次、不论何时。",
      "source_fingerprint": "dfcccf66ae8e67f5f45eb3f0141147d5aaf9263a289cf97032ff77ed752be89f",
      "current_text": "Ca khúc cất lên giấc mơ ngưỡng vọng và quyết tâm chạy khi mang theo những tâm nguyện trên vai.\\nHãy mơ một giấc mơ không bao giờ kết thúc――dù bao nhiêu lần, dù vào bất cứ lúc nào.",
      "current_fingerprint": "451d80a0ea7f8abdbb06dc0c4215b5b456b8cededc274433f9653a765c7c997f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:38e3256fe07ae725eae30ea0",
      "source_batch": 130,
      "entry_index": 45,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1069"
      ],
      "key": null,
      "source_text": "比起未来、比起过去，更要把握燃烧生命的现在――\\n心怀对那刹那光辉的祈祷，玻璃的叙事曲。",
      "source_fingerprint": "438c5ac49d388c5e37f9cb0751b6193ec819f7a105a775faa815e1a24dee18bd",
      "current_text": "Hơn cả tương lai, hơn cả quá khứ, hãy nắm lấy hiện tại nơi sinh mệnh đang cháy――\\nMột bản ballad thủy tinh mang lời cầu nguyện cho ánh sáng lóe lên trong khoảnh khắc ấy.",
      "current_fingerprint": "5a2b8f0503bdbdde846af80071d67287cea51ce65672a012ddb476e013900811",
      "risk_flags": [
        "very_long_target",
        "not_yet_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:7d7774f4156404476efabc3b",
      "source_batch": 130,
      "entry_index": 46,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1070"
      ],
      "key": null,
      "source_text": "轻柔地、婀娜地……如微风般奔跑的自由之歌。\\n旋律时而改变风向，随心吹拂。",
      "source_fingerprint": "1d0bc38637afe7e810a7e0106c69d731bbf4db8e9c43c0f7efd8c3672ad7a62f",
      "current_text": "Nhẹ nhàng, uyển chuyển… một khúc ca tự do chạy như làn gió thoảng.\\nGiai điệu đôi khi đổi hướng gió, rồi tự do thổi theo ý mình.",
      "current_fingerprint": "6885cd2adc3bcb0082cb35ccb84e8fc4b5828d95ffd53486299d27f6f6efc2b9",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:ce190c5feb2295b51a8967a8",
      "source_batch": 130,
      "entry_index": 47,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1071"
      ],
      "key": null,
      "source_text": "带着那无法抑制的心跳声飞翔起来吧♪\\n直奔那憧憬之地！的雀跃之歌！Take Off☆",
      "source_fingerprint": "dcd07586b6f177e6c1d3228f4f567307aee8ca068e444db0ca272fae2224a4a0",
      "current_text": "Hãy bay lên cùng nhịp tim không thể kìm nén ấy♪\\nThẳng tới miền đất hằng ao ước! Một khúc ca rộn ràng! Take Off☆",
      "current_fingerprint": "db46680c3bb3e176a7d0f63d5403853a1bde182e2786ca5e14f46ba87e77ce07",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:8ad63d077655cbf5ef71298b",
      "source_batch": 130,
      "entry_index": 48,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1072"
      ],
      "key": null,
      "source_text": "无法忘却的心愿、无法放弃的梦想，为了保持住曾经的自己……！\\n直到那不屈樱花绽放之日，这歌声不会停止。",
      "source_fingerprint": "92c20f2f64abadcceb02fb93dd4c10a555eb521ec6d4438ebee80dd676421e1b",
      "current_text": "Tâm nguyện không thể quên, giấc mơ không thể từ bỏ, để vẫn giữ được chính mình của ngày xưa…!\\nCho đến ngày đóa anh đào bất khuất nở rộ, tiếng hát này sẽ không dừng lại.",
      "current_fingerprint": "6fcf126c6604d7e754446f659b4a926a3144a515d162630b9fa0be869b7dcf13",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:3a6c03bcb0321952be2f9e1d",
      "source_batch": 130,
      "entry_index": 49,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1073"
      ],
      "key": null,
      "source_text": "VayVa～y！嗨起来嗨起来↑像开趴一样有趣的乐曲☆\\n总之先保持微笑？咱毕竟是太阳嘛！所以间奏就拜托咯～♪",
      "source_fingerprint": "87c77afe689cbeb4ebfc204904aa5274e171521cdccb02f205d4bc4e3d2853a3",
      "current_text": "VayVa～y! Quẩy lên quẩy lên↑ một ca khúc vui như đang mở tiệc☆\\nTrước hết cứ cười đã nhé? Vì tui chính là mặt trời mà! Đoạn nhạc giữa nhờ bạn đó～♪",
      "current_fingerprint": "657279ca4e6b97e71ef06c3c2f7dcf3caf81f78aa7696b2733ebc549c52e248e",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:421b11e1dffbd75a43972983",
      "source_batch": 130,
      "entry_index": 50,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1074"
      ],
      "key": null,
      "source_text": "不可思议的轻盈，又有几分边缘感的乐曲。\\n那些日子的苦痛，请你一定不要忘记……好吗？",
      "source_fingerprint": "027f58c3c3f929365e50c5a4a6d6ed01dcee2ec7b7e44169f628850e0c95889a",
      "current_text": "Một ca khúc nhẹ tênh đến kỳ lạ, lại mang chút sắc cạnh.\\nXin bạn nhất định đừng quên nỗi đau của những ngày ấy… được chứ?",
      "current_fingerprint": "887a31ed5a522c81c28b82901b6d8018ccfd465488ee3cf20000661b11daa2f1",
      "risk_flags": [
        "negation_capability_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:f3244435c442fdca562090fc",
      "source_batch": 130,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1075"
      ],
      "key": null,
      "source_text": "阿船's RAP！DE情绪燃起来！\\n阿船与RAP，搞一首试试吧！",
      "source_fingerprint": "c6283b47fce6fdef7a8620e9bcfc27a1581a6128d9bcac46c2941bd7ced65fd6",
      "current_text": "Gold Ship's RAP! DE cảm xúc bùng cháy!\\nGold Ship với RAP, làm thử một bài nào!",
      "current_fingerprint": "1482aa3d45184dce18ec2ba435bd768de03222654d23760711bf7cead663883c",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:b73d94bb5b1e3464bc85cfc7",
      "source_batch": 130,
      "entry_index": 52,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1076"
      ],
      "key": null,
      "source_text": "一等星所编织的故事，延续至最闪耀的光辉。\\n那份心愿被继承――将再次成为梦想。",
      "source_fingerprint": "2610056ce1ea7e526a9783601c44669da603b2c1e97130f4707262d7b9722fa6",
      "current_text": "Câu chuyện được dệt nên bởi ngôi sao sáng nhất tiếp nối đến ánh hào quang rực rỡ nhất.\\nTâm nguyện ấy được kế thừa――và sẽ một lần nữa trở thành giấc mơ.",
      "current_fingerprint": "5db501fe8e6f2f9c7128492d165245550e33105084a484eb6dc189464711555f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6dd4880ed7fd03f4fa59783b",
      "source_batch": 130,
      "entry_index": 53,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1077"
      ],
      "key": null,
      "source_text": "平凡如今日，也一定很重要。\\n拥抱它，并梦想明天……『晚安』。",
      "source_fingerprint": "bb770dfe15d77feab1f54d085d374595bc2ee141bfae2f5b5f99f1e15b8f1439",
      "current_text": "Một ngày bình thường như hôm nay chắc chắn cũng rất quan trọng.\\nHãy ôm lấy nó, rồi mơ về ngày mai……『Chúc ngủ ngon』.",
      "current_fingerprint": "014bc97b8947b8c1b7ee9c799394687fa01681c8a8e83e5f96837d506bf1c94b",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:fd71c806d1cf94b86b061a8d",
      "source_batch": 130,
      "entry_index": 54,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1078"
      ],
      "key": null,
      "source_text": "献给一同追寻过憧憬的她，如此一首青春之歌。\\n虽然珍视你，但我不会败给你。与你就此……决胜！",
      "source_fingerprint": "acc08e58f8dd31c122ae923d6ccfa97c19328b5c67dac00aec9b2a8feaaa5d8c",
      "current_text": "Một khúc ca tuổi trẻ dành tặng cô ấy, người đã cùng tôi theo đuổi niềm ngưỡng vọng.\\nTôi trân trọng bạn, nhưng sẽ không thua bạn. Với bạn, ngay tại đây……phân thắng bại!",
      "current_fingerprint": "b4b414ac9f003f3000a5d13f8563b4a3895f74f793c924eb2a9950369cd9fad1",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:c8d6742ae7d923a6662edbac",
      "source_batch": 130,
      "entry_index": 55,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1079"
      ],
      "key": null,
      "source_text": "赢得经典三冠的证明。\\n那首赛马娘们所憧憬之乐曲的，Club Arrange版本！",
      "source_fingerprint": "4c7babf59091adae73bb720dd7bbe8608454a997684fe7f5e98ad1581698a8dd",
      "current_text": "Minh chứng cho việc giành được Tam Quan Classic.\\nPhiên bản Club Arrange của ca khúc mà mọi Uma Musume đều hằng ao ước!",
      "current_fingerprint": "bcedbb854fa69d820a190236c49028dc9bca263251b65fdf5ceafbea9de89e27",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "world.umamusume",
          "target_vi": "Uma Musume",
          "matched_aliases": [
            "赛马娘"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
