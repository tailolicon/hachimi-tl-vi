    {
      "uid": "zhcn:8967b0e9ff061fcd6fbd800d",
      "source_batch": 220,
      "entry_index": 6,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1043"
      ],
      "key": null,
      "source_text": "嘎～嗷！我是新光风！\\n害怕了吗？老实说，很可怕对不对～！\\n……喂！不要无视我！我咬！",
      "source_fingerprint": "013643540e1e1da198d85ff63415216353267242a4791f329734c617a561e685",
      "current_text": "Gào～! Tôi là Shinko Windy!\\nSợ rồi chứ? Nói thật đi, đáng sợ lắm đúng không～!\\n…Này! Đừng có lờ tôi đi! Tôi cắn đấy!",
      "current_fingerprint": "d61e59e24c9f7653a290ed4b4ce25d4b1b964dac6e0140fa72a1aa06afae2359",
      "risk_flags": [
        "absence_risk"
