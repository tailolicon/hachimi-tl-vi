      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:6f46ff408dfd2ae928c8a79f",
      "source_batch": 220,
      "entry_index": 7,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1044"
      ],
      "key": null,
      "source_text": "东商变革只是变身前的名字罢了！\\n我的真身为魔法少女Sweepy！\\n这就是魔法哟！诶！（哐）",
      "source_fingerprint": "281ee311bd0dfa27b5ea40a8fb21d99e8970a52f9b07d8b2891c6b9ac491c262",
      "current_text": "Sweep Tosho chỉ là cái tên trước khi biến thân thôi!\\nDanh tính thật của tôi là cô gái phép thuật Sweepy!\\nĐây chính là phép thuật! Hây! (Rầm)",
      "current_fingerprint": "5405c719868d475d7390ebe56deb6adb5a84990ddb3b2b9173374b4cbea44672",
      "risk_flags": [
