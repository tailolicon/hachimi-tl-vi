      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1038"
      ],
      "key": null,
      "source_text": "可爱的，真机伶Deーsu！\\n整个世界都被“可爱”所包围着☆\\n东张西望是不行的，只能好好注视着机伶哟♪",
      "source_fingerprint": "cd584f1dad092d8fd0c0228092a54a35b695166c1d4bc0949a29520c4f9dc06c",
      "current_text": "Dễ thương, Curren Chan desu!\\nCả thế giới đều được bao quanh bởi sự “dễ thương”☆\\nKhông được nhìn ngó lung tung đâu, chỉ được chăm chú nhìn Curren thôi nhé♪",
      "current_fingerprint": "7d56fb5ac66fd77b57a940c029b820a2e36dfa9dc88a0c37b307e21408c6cf90",
      "risk_flags": [],
      "risk_score": 0,
