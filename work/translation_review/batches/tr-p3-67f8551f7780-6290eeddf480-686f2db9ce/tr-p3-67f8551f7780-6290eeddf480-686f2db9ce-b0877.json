    {
      "uid": "zhcn:e9f2c4da352b0448b18574c2",
      "source_batch": 220,
      "entry_index": 4,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1041"
      ],
      "key": null,
      "source_text": "你好！我叫樱花进王！\\n正如你所见，是一位出色的班长！\\n为了成为大家的榜样，上吧！爆进！",
      "source_fingerprint": "90f7bca8f69558a60f934f62bbe2d6862ab26e5b6bd312386c9c567a34ac7706",
      "current_text": "Xin chào! Tôi là Sakura Bakushin O!\\nNhư bạn thấy đấy, tôi là một lớp trưởng xuất sắc!\\nĐể trở thành tấm gương cho mọi người, tiến lên! Bakushin!",
      "current_fingerprint": "b71168800caec9e881375f489f5b44d804cd5ede3cbebbfde6e2ba663d236aaa",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.sakura_bakushin_o",
          "target_vi": "Sakura Bakushin O",
          "matched_aliases": [
            "樱花进王"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
