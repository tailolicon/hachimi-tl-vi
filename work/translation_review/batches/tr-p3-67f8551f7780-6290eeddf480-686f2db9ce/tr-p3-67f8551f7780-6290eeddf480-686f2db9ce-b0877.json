      "source_bridge_policy_sha256": null
    },
    {
      "uid": "zhcn:72a20da1c72272ce5315551a",
      "source_batch": 220,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1042"
      ],
      "key": null,
      "source_text": "哈ー哈哈哈！我叫采珠！\\n你知道吗？世界充满了无尽的可能性。\\n而这一结论就由我来证明！",
      "source_fingerprint": "1ac0a7358c17808c7c32706764a5b7cf645924b5d11aec4295d87c3857dfb97e",
      "current_text": "Ha-ha-ha-ha! Tôi là Seeking the Pearl!\\nBạn biết không? Thế giới tràn ngập những khả năng vô tận.\\nVà chính tôi sẽ chứng minh điều đó!",
      "current_fingerprint": "de0d5ba91ff6bbc5054912e0eb3d506b1155bc23da794b37670b6b9f16f8b9e9",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "character.seeking_the_pearl",
          "target_vi": "Seeking the Pearl",
          "matched_aliases": [
            "采珠"
          ],
          "present": true
