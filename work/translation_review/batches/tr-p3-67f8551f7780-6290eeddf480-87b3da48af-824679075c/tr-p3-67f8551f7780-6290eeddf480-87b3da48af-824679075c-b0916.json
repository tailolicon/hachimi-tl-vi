      "source_batch": 229,
      "entry_index": 77,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1014"
      ],
      "key": null,
      "source_text": "与名为“曼波”的老鹰如姐弟般一同长大",
      "source_fingerprint": "bf259d4678a3c6143306b0ba9b8f8e2fe638d9334b5e466d2c0f47ecdddc3025",
      "current_text": "Lớn lên cùng chú đại bàng tên “Mambo”, thân thiết như chị với em trai",
      "current_fingerprint": "3699a87e3329b0067e0a14969ef65ff6ee824ec9965e6de05762f3391b65598a",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
