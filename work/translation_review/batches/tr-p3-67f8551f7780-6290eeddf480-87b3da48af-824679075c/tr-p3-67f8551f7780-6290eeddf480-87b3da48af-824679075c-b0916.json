    },
    {
      "uid": "zhcn:0261bf18ce72d0994503fb4c",
      "source_batch": 229,
      "entry_index": 78,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1015"
      ],
      "key": null,
      "source_text": "尊敬着生下并养育了美丽自己的双亲",
      "source_fingerprint": "e5e6b54ba84927b367406659ebafd8d4e6448c8c70a4b6b8366cd1aa3ee9f2ae",
      "current_text": "Kính trọng bố mẹ đã sinh thành và nuôi dưỡng mình xinh đẹp như hôm nay",
      "current_fingerprint": "e62c67e67a2aa917195a4ced0764a613ee93208ac4faa2a333f1183e9d1425a5",
      "risk_flags": [
        "very_long_target"
