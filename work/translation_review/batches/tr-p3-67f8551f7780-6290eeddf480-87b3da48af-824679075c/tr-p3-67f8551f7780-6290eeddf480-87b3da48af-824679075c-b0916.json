    {
      "uid": "zhcn:d02254174e099f24d392792b",
      "source_batch": 229,
      "entry_index": 79,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1016"
      ],
