      "source_batch": 229,
      "entry_index": 68,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1005"
      ],
      "key": null,
      "source_text": "出身于舞台家族，双亲时常全国巡演",
      "source_fingerprint": "d76add5a4474f2d348f00ba2ea44f8d0c105b6f9576a2c132e53533b38bf9447",
      "current_text": "Sinh ra trong một gia đình nghệ thuật sân khấu, bố mẹ thường xuyên lưu diễn khắp cả nước",
      "current_fingerprint": "f6539ec4b7bb33211c9c35cf688a21164fd441d59e95a647387dcaa5996468ff",
      "risk_flags": [
        "very_long_target"
      ],
