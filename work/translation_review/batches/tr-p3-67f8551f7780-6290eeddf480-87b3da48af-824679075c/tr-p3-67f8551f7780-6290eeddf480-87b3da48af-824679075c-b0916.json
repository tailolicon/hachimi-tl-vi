      "item_context_sha256": null
    },
    {
      "uid": "zhcn:54f48804a0c1876bc668e4bf",
      "source_batch": 229,
      "entry_index": 75,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1012"
      ],
      "key": null,
      "source_text": "大姐头气质遗传自母亲，但其实是家中老幺",
      "source_fingerprint": "81d21cdf7ff92723379a13822c9280b5eee4d4a581577f491482b4a30c0dc418",
      "current_text": "Khí chất “chị đại” được thừa hưởng từ mẹ, nhưng thực ra lại là con út trong nhà",
      "current_fingerprint": "83e810d462c3bf375ba7424cde70be7fe781b1c2068c9bbcd6de7cf09ca5276f",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:4f2fa58597f88727b95f9408",
      "source_batch": 229,
      "entry_index": 76,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1013"
      ],
      "key": null,
      "source_text": "双亲以“麦酱”称呼自己",
      "source_fingerprint": "a096e6c740493c17c9d14f810d7c73421b317c42bf977b0e7f4f574887612a9d",
      "current_text": "Bố mẹ gọi cô là “Mugi-chan”",
      "current_fingerprint": "58d768a8fb8d8358b8dd27f70035bc629aa1bd459242ffb542253f0e33432edf",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
