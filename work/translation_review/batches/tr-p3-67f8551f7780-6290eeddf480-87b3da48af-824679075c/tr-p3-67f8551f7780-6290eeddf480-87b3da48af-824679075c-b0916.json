      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:1e9958977ff4321d07e4e231",
      "source_batch": 229,
      "entry_index": 69,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1006"
      ],
      "key": null,
      "source_text": "说到家族旅行就是去温泉，全家都是某个秘汤的常客",
      "source_fingerprint": "bb5c217a9de0ca714b09350bd1f00d98eb39e2930a7aa2a4fae49c40a89c81f7",
      "current_text": "Mỗi khi cả nhà đi du lịch là lại tới suối nước nóng; cả gia đình là khách quen của một khu suối nước nóng hẻo lánh",
      "current_fingerprint": "3484a9d93873d9efa9035506a94567d46e5b6dd19aaf535e7663b5997d1efa0d",
      "risk_flags": [
        "very_long_target"
