      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1009"
      ],
      "key": null,
      "source_text": "憧憬并挂念着对工作热心的母亲",
      "source_fingerprint": "9daf992ad1e0af964df8205da3254fa75cc66221a516dc0bf05393ae13da74bd",
      "current_text": "Ngưỡng mộ và luôn lo cho người mẹ hết lòng vì công việc",
      "current_fingerprint": "2460d18dd00fb1f2d03dca51d11ce7506e5db3f127d96dc4defd88a0f7ad9511",
      "risk_flags": [
