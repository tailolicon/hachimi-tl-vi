    {
      "uid": "zhcn:9e2e7023e69302ec3687ea48",
      "source_batch": 129,
      "entry_index": 54,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "120",
        "4"
      ],
      "key": null,
      "source_text": "媒体主导设立的新赛事\\n<color=#FF6D26>『闪耀明星巅峰赛』</color>\\n这是为决出最强者的战斗！\\n来吧，朝着梦想启程\\n以各项最强为目标吧――！",
      "source_fingerprint": "b56eed1f9a50b0436646a42d8a5181d7cfa13985a3424c153f18e6ad3e78b432",
      "current_text": "Cuộc đua mới do truyền thông dẫn dắt thành lập,\\n<color=#FF6D26>『Twinkle Star Climax』</color>.\\nĐây là cuộc chiến để quyết định kẻ mạnh nhất!\\nNào, hãy lên đường hướng tới ước mơ,\\nnhắm tới vị trí mạnh nhất ở mọi hạng mục――!",
      "current_fingerprint": "0f537a68fcc9b5a279fe650a81faae4604412a3511efbe9d4add0dbbf733dd31",
      "risk_flags": [],
      "risk_score": 0,
