    {
      "uid": "zhcn:163b8adade8cd58712a0c6cf",
      "source_batch": 129,
      "entry_index": 58,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "120",
        "8"
      ],
      "key": null,
      "source_text": "随着秋川理事长宣布开放农田，\\n特雷森学园的大农耕时代开始了。\\n烈日之下，大家一起挥动锄头；\\n日落时分，众人共同围坐餐桌。\\n来吧，今天我们也去种田吧――！",
      "source_fingerprint": "4245a5126f8c425e43eaf92edffb045cada30eadc262e4be7f8c909cc6124faf",
      "current_text": "Cùng tuyên bố mở đất nông nghiệp của Chủ tịch Akikawa,\\nkỷ nguyên đại canh tác của Học viện Tracen bắt đầu.\\nDưới nắng gắt, mọi người cùng vung cuốc;\\nkhi mặt trời lặn, tất cả quây quần bên bàn ăn.\\nNào, hôm nay cũng đi trồng trọt thôi――!",
      "current_fingerprint": "122dd72bc05b6157ed231386cd2f1833256840f26a534accdef34ba033b53fc1",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
