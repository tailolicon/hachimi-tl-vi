    {
      "uid": "zhcn:4eca0ca8c0b49c1d99268d0e",
      "source_batch": 129,
      "entry_index": 57,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "120",
        "7"
      ],
      "key": null,
      "source_text": "决出No.1运动员赛马娘的\\n综合体育大会<color=#FF6D26>『U.A.F.』</color>开幕！\\n赛马娘们将在15种独特的比赛中\\n挑战自我极限，挥洒汗水！\\n运动员们的灵魂共鸣，请拭目以待！",
      "source_fingerprint": "ea8944b725bda56fdd898f043b86ee2d156a5ddaaca94ae2691a4a63cb35f8f9",
      "current_text": "Đại hội thể thao tổng hợp quyết định Mã Nương vận động viên No.1,\\n<color=#FF6D26>『U.A.F.』</color>, khai mạc!\\nCác Mã Nương sẽ thử thách giới hạn bản thân\\nqua 15 Cuộc đua độc đáo, đổ mồ hôi hết mình!\\nHãy đón xem linh hồn các vận động viên cộng hưởng!",
      "current_fingerprint": "c59eb12d73577ff1ef895ff286e2182cc3a953b5c32a5ff7fe1003419b7bcabb",
