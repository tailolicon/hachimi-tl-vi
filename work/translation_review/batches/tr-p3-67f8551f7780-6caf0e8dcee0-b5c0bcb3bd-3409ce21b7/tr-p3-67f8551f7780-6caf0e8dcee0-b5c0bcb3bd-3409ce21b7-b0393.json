    {
      "uid": "zhcn:ab60ecde572fcb0c92bd0b4d",
      "source_batch": 131,
      "entry_index": 35,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1140"
      ],
      "key": null,
      "source_text": "你能感受到吧，炽热的血潮。你能听到吧，灵魂的呐喊！\\n用正义之火讨伐邪恶！去吧，去吧去吧英雄！！！！",
      "source_fingerprint": "567c9fa58ea9a714c1d544bf36866851df631f7b08b1c1518938dc6923323ed1",
      "current_text": "Bạn cảm nhận được chứ, dòng máu nóng bỏng. Bạn nghe thấy chứ, tiếng gào của linh hồn!\\nDùng ngọn lửa chính nghĩa tiêu diệt cái ác! Tiến lên, tiến lên tiến lên, anh hùng!!!!",
      "current_fingerprint": "1ad49833d9698c4b3d43acb9b7b0cc3fa945bd806f5d2382bda62e95460711d8",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:aa032e8566a0f7b6111c9f0a",
      "source_batch": 131,
      "entry_index": 36,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1141"
      ],
      "key": null,
      "source_text": "即使到达彼方并抓住，也会从手中滑落。所以——\\n追逐着，追逐着，追逐着——终于抓住了。",
      "source_fingerprint": "c7f320d5a750687b6c5f65b1062c121a4172ea9319190d805c3c2b4c932edc0e",
      "current_text": "Dù tới được nơi xa xôi và nắm lấy, nó vẫn tuột khỏi tay. Vì vậy —\\ncứ đuổi theo, đuổi theo, đuổi theo — cuối cùng cũng đã nắm được.",
      "current_fingerprint": "935b4ef56fc6a19ec35e44bbfb1176d2a1cb2ba6621136f9ad6e991549734012",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d0acb48477ef2d2a994fe0b7",
      "source_batch": 131,
      "entry_index": 37,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1142"
      ],
      "key": null,
      "source_text": "怀抱在心中的孤狼誓言绝不动摇。\\n无论是自己的影子还是前方的背影，都要像吞噬般甩开！！",
      "source_fingerprint": "a50af3dfd4ac183324be6c3e376a783a196be0437b6123a3001d622374b83fbf",
      "current_text": "Lời thề của sói cô độc khắc sâu trong tim tuyệt đối không lay chuyển.\\nDù là chiếc bóng của chính mình hay bóng lưng phía trước, đều phải bỏ xa như muốn nuốt chửng!!",
      "current_fingerprint": "ba3dbccad0e373c66b9d7a5d2f8cb831f0d44ab006fc6d6f47860bbd0548858b",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:1d487823478f05b97d104061",
      "source_batch": 131,
      "entry_index": 38,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1143"
      ],
      "key": null,
      "source_text": "填补无数不足，稍微踮起脚尖。\\n我也一定能实现……因为我相信。",
      "source_fingerprint": "ed351667d86f74118a1520bd0191f33fc0c4c0d1309a06f3abfd944c1d6c745e",
      "current_text": "Bù đắp vô số thiếu sót, khẽ nhón chân thêm một chút.\\nMình nhất định cũng sẽ làm được… vì mình tin như vậy.",
      "current_fingerprint": "3646d41509749972fa68383ddae2b0a3ad9a145b818cd113dda7e5e42abccfcb",
      "risk_flags": [
