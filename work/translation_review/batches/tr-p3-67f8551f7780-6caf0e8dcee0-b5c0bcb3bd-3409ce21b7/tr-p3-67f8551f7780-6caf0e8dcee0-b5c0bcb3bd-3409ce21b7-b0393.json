      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1144"
      ],
      "key": null,
      "source_text": "右手握着高贵，左手怀着慈爱。\\n为了成为引领一切的女王——走上吧，这荣耀之路。",
      "source_fingerprint": "f357cd3cb44f6467f1cf906d3f7574665485ea3b7c928d2d02c21c74acf6431b",
      "current_text": "Tay phải nắm lấy cao quý, tay trái ôm trọn lòng nhân ái.\\nĐể trở thành nữ vương dẫn dắt tất cả — hãy bước lên con đường vinh quang này.",
      "current_fingerprint": "03442c1894bcec601b25c63d2d6beb4a9aafa8f0237bc2ee38db6c22466838d5",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
