  "items": [
    {
      "uid": "zhcn:6f7c18bc56606e1deecc2165",
      "source_batch": 131,
      "entry_index": 65,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1171"
      ],
      "key": null,
      "source_text": "辉煌梦想的顶峰遥不可及，前路充满绝望……\\n然后，少女走向了荣华之门。",
      "source_fingerprint": "4c63fb5e5fc8c077ffd924bd72837f270315103a34fbdc432f65fff6d1d6b6e6",
      "current_text": "Đỉnh cao của giấc mơ huy hoàng xa ngoài tầm với, con đường phía trước ngập tràn tuyệt vọng…\\nVà rồi, cô gái bước tới cánh cửa vinh hoa.",
      "current_fingerprint": "ee025707df98024f22afa5a696dbac31e521ba2cbe720a38861a89f7999f8b22",
      "risk_flags": [
        "very_long_target",
        "negation_capability_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d377f13b8f6d61a5da77bd7a",
      "source_batch": 131,
      "entry_index": 66,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1172"
      ],
      "key": null,
      "source_text": "争先恐后超越他人的背影！\\n燃烧的热情终将成为照亮新时代的灯火！",
      "source_fingerprint": "ddcf1d5230d4828111729dca81c545cb8c92f21c7ecee16cf5822fbb41b8588a",
      "current_text": "Tranh nhau vượt qua bóng lưng của người khác!\\nNhiệt huyết cháy bỏng rồi sẽ hóa thành ngọn đèn soi sáng thời đại mới!",
      "current_fingerprint": "266377d3bfab27bc1f9fa322dfedf2f5abf52d7c50b2a7c855dc9ba128f8a45c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:c3a6a5d3c19639d9bd123d27",
      "source_batch": 131,
      "entry_index": 67,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1173"
      ],
      "key": null,
      "source_text": "奔跑吧，Frontier！用震撼的全力疾奔撼动世界！\\n来吧，究竟是谁将开辟全新的世界！？",
      "source_fingerprint": "31bfa0f750cc4c0261397fc7f8043ca9d504fe02b566b0ae120dd066c3e278fa",
      "current_text": "Chạy đi, Frontier! Dùng cú nước rút toàn lực chấn động cả thế giới!\\nNào, rốt cuộc ai sẽ là người khai mở một thế giới hoàn toàn mới!?",
      "current_fingerprint": "90d80a393fa1abb3237019c58d5b40f9fd03c9ea7b405d235ee9f8cc47ad33de",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.5907479481a9",
          "target_vi": "Dốc hết sức",
          "matched_aliases": [
            "全力"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": "1421762cb6b17e1f2fb960e592ba9c06c08241788f4e215b73a9c0571e70cf01"
    },
    {
      "uid": "zhcn:45bccc91862cf3a2f91a404b",
      "source_batch": 131,
      "entry_index": 68,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1174"
      ],
      "key": null,
      "source_text": "在夕阳余晖下的归途，某天突然溢出的旋律。\\n\n不可思议地，声音重叠着传来……就像那一天一样。",
      "source_fingerprint": "7a0cb889eb3f274423dc57723cb5906a514a3a3348772f60170bb5edcb447303",
      "current_text": "Trên đường về dưới ánh chiều tà, một ngày nọ giai điệu bỗng trào dâng.\\n\nKỳ lạ thay, những giọng âm chồng lên nhau vọng tới… hệt như ngày hôm ấy.",
      "current_fingerprint": "4c3d75bc73656f57b1321bc8b9c168dead0e236f1fd42a72923ff7c56ced7f3b",
      "risk_flags": [
        "very_long_target",
        "negation_capability_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:31be97cde28fff86030e9b16",
      "source_batch": 131,
      "entry_index": 69,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1175"
      ],
      "key": null,
      "source_text": "一起奔跑的日子。不知不觉已经来到了这么远的地方。\\n并肩奔跑的两人的牵绊，将一直延续到梦想的尽头——",
      "source_fingerprint": "fb31f9039a1867f66a6b02cd63cde340fd54566f07d4833d860f5ebba37cfd7a",
      "current_text": "Những ngày cùng nhau chạy. Chẳng biết từ bao giờ đã đi xa đến thế này.\\nMối gắn kết của hai người chạy vai kề vai sẽ còn kéo dài tới tận cùng giấc mơ —",
      "current_fingerprint": "69257c220bd6d6d3e62684a71a755ad913015a5d6e241cb4807986c21d097387",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:78c5fe72d01388b878619089",
      "source_batch": 131,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1176"
      ],
      "key": null,
      "source_text": "划破风暴的，是你那举世无双的光芒——\\n披挂上阵吧，在那缤纷绚烂的色彩中。鸣响吧，那革命的歌声。",
      "source_fingerprint": "0c9e57f10d99f84b70df7259ea1d79ff1cc8fdc1480777f125476c217d6d949b",
      "current_text": "Xé toạc bão tố chính là ánh sáng vô song của bạn —\\nHãy khoác giáp ra trận giữa muôn màu rực rỡ. Hãy vang lên, khúc ca cách mạng ấy.",
      "current_fingerprint": "19e2c70115cf952c05e85c17a462fb682610f546d9eb73f697fb18eb232e8152",
      "risk_flags": [
        "absence_risk"
      ],
      "risk_score": 5,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:7d2071440960643b1aa7f2ab",
      "source_batch": 131,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1177"
      ],
      "key": null,
      "source_text": "在这场豪华绚丽的盛典中，证明出团队的羁绊。\n以此团结之力攀登世界之巅！拿下吧，美国梦！",
      "source_fingerprint": "d3049ae23595807548430a941542d8affaebc1af8f855bee2fedebe145e7713d",
      "current_text": "Trong lễ hội lộng lẫy này, hãy chứng minh mối gắn kết của cả đội.\nDùng sức mạnh đoàn kết ấy leo lên đỉnh thế giới! Giành lấy Giấc mơ Mỹ!",
      "current_fingerprint": "866241632621f3611684e70d3a2bbf3b29b55cf59be2b80dcff709dade888436",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:78225a9b059a49631af7cee8",
      "source_batch": 131,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1178"
      ],
      "key": null,
      "source_text": "想要比任何人都要强烈、激烈，闪耀如流星般的一曲！\\n掠过天际的灰色轨迹，将会震撼每一个人的心！",
      "source_fingerprint": "1ea5a311120350b01b2e5e126f197395e02124bdc9ef578334c4ce980a2aadb1",
      "current_text": "Một khúc ca muốn tỏa sáng mãnh liệt, dữ dội hơn bất kỳ ai — như sao băng!\\nQuỹ đạo xám lướt ngang bầu trời sẽ làm rung động trái tim tất cả mọi người!",
      "current_fingerprint": "7a370af1142ffd2132c151b3a56d1480e066b3852395cd9652e7136980c4b10c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:d37c2e6a3046d139960ab588",
      "source_batch": 131,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1179"
      ],
      "key": null,
      "source_text": "不善于使用言语表达……即便如此，还是想要传达出来。\\n就是这样，一首稍微有点笨拙的歌。",
      "source_fingerprint": "c9200df9f4e31ab61ab761352bfa7b58f487e5898d0073bb2df8f169045744fd",
      "current_text": "Không giỏi diễn đạt bằng lời… nhưng dù vậy vẫn muốn truyền đạt ra.\\nĐó là một bài hát hơi vụng về một chút như thế.",
      "current_fingerprint": "70a657470b2dfd6a3c34691cc3fddeffea5748886b0b54ee3facc805bdc209ef",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:181cc577cf445e3c42dfc61d",
      "source_batch": 131,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1181"
      ],
      "key": null,
      "source_text": "赠予你的这一碗。面条、配菜与热情，\\n盛满平日里满满的感谢——嘿，让您久等啦！！",
      "source_fingerprint": "505c5b425c9c1f6aea176c1aceec6b0ec5737c508b5a4a4ffed834da334ebdb9",
      "current_text": "Tặng bạn một bát này. Mì, đồ ăn kèm và cả nhiệt huyết,\\nđong đầy lời cảm ơn thường ngày — này, để bạn đợi lâu rồi!!",
      "current_fingerprint": "ab121f5fda8b468d9577572fe2bf55c074796a79e5d2f3680dd3c9b1d2cdbfa9",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:996c7568e8341c51f3593486",
      "source_batch": 131,
      "entry_index": 75,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1182"
      ],
      "key": null,
      "source_text": "『#kawaii』『#梦幻柔软』『#心动不已？』\\n可爱是能传达到宇宙的暗号！呐，可以再多喜欢我一点吗？",
      "source_fingerprint": "410a1d5da43efff3a849005af5e013bf077ba6e7dbd5d0d32f6041d35c4f9657",
      "current_text": "“#kawaii” “#mơmàngmềmmại” “#timđậpnhanh?”\\nDễ thương là mật mã có thể truyền tới tận vũ trụ! Nè, bạn có thể thích tôi thêm một chút nữa không?",
      "current_fingerprint": "2ea0875186c0ee7b659d270e60cf028d926de78287298747b9c8115e72323e64",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.3346bd209f49",
          "target_vi": "Nhịp tim rộn ràng",
          "matched_aliases": [
            "心动"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": "53d57ec1562d2a80030e337cddc681095991d1900406d52d9e9bb3dc8806c7f7"
    },
    {
      "uid": "zhcn:1c9f68bc65e67e485df90050",
      "source_batch": 131,
      "entry_index": 76,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1183"
      ],
      "key": null,
      "source_text": "高涨的心跳已经无法抑制！ \\n毫无保留地倾诉炽热的思念，一首让人心跳加速的歌曲！",
      "source_fingerprint": "a525512dfe02bc7cae1075026fa2cd5d2986b8e82552815abe5ae72293e3aae0",
      "current_text": "Nhịp tim dâng cao đã không thể kìm nén nữa! \\nTrút hết nỗi lòng nóng bỏng không chút giấu giếm — một bài hát khiến tim tăng tốc!",
      "current_fingerprint": "d9dbb9d20a690465511da77f03a5b557c3a3d36f514e56c50fea32bc2d6e8bbb",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:79dfc863223b14a2e4f300f9",
      "source_batch": 131,
      "entry_index": 77,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1184"
      ],
      "key": null,
      "source_text": "灵魂为之震颤，歌颂着骄傲不屈的乐曲。\\n绝不会轻易屈服，直到成为“女王”的那一天。",
      "source_fingerprint": "6e1eb37482eefe949d29706f459830f31bbd17a64c4ad188500011b431a96e3b",
      "current_text": "Khúc nhạc khiến linh hồn rung chuyển, ca ngợi niềm kiêu hãnh bất khuất.\\nTuyệt đối không dễ dàng khuất phục, cho tới ngày trở thành “Nữ vương”.",
      "current_fingerprint": "48dafb0c775df9fd76d0813ccdb6a9d59d783a663e2bb2f71dab6d407c93d9e9",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:524e9bf9062d0bcfb924af3a",
      "source_batch": 131,
      "entry_index": 78,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1185"
      ],
      "key": null,
      "source_text": "拜托了♡正因为是你，我才会这么想撒娇。\\n连全世界都会为之着迷的，可爱的流行歌曲！",
      "source_fingerprint": "525912bcfb92b78bbe7a757d8f429cf8d1ba8bc7bda5a94d92455959be5e95c7",
      "current_text": "Làm ơn nhé♡ Chính vì là bạn nên tôi mới muốn làm nũng thế này.\\nMột bài pop dễ thương đến mức cả thế giới cũng phải mê mẩn!",
      "current_fingerprint": "564fb09e6cd82b10a98c6f230d12838cf9068e2855d5963fc0252f8bbec46621",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:896b56be0adb3987b5b003f6",
      "source_batch": 132,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1187"
      ],
      "key": null,
      "source_text": "华丽、优雅、勇敢！点燃内心的充满力量的乐曲！\\n无论遇到什么困难都不会屈服——这才是公主应有的姿态！",
      "source_fingerprint": "627c7ddfd31ec59005af6b6f9ed19832c194148bcfdc62f5d08f26f005512730",
      "current_text": "Rực rỡ, thanh lịch, dũng cảm! Một khúc nhạc tràn đầy sức mạnh thắp sáng trái tim!\\nDù gặp bất cứ khó khăn nào cũng không khuất phục—đó mới là dáng vẻ của một công chúa!",
      "current_fingerprint": "55ec40803eca90d683fe7c7d9491813d7dbff7da68a9e5989075a432e28f4f93",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
        "absence_risk",
        "canonical_finding"
      ],
      "risk_score": 64,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.stat.power",
