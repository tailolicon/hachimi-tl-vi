      ],
      "key": null,
      "source_text": "可用于抽取参加5th EVENT GAZE的\\n2023/9/11为止奖池中出现过的\\n育成赛马娘的抽奖券。",
      "source_fingerprint": "accca2efd3001d36463b4d2089081f48e8d2b180404e895bbb1ffc5bb25c146c",
      "current_text": "Vé gacha dùng để quay Mã Nương huấn luyện tham gia\\n5th EVENT GAZE đã từng xuất hiện trong banner\\ntính đến 2023/9/11.",
      "current_fingerprint": "f00e2b5cc422ce5ca245121559e3c62d2e0176b27bb1e8c9fefb4cf97f59a7b4",
      "risk_flags": [
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
        "numeric_token_mismatch"
      ],
      "risk_score": 21,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "career.ui.trainee.text_data",
          "preferred": "Trainee",
          "accepted": [
            "Trainee"
          ],
          "forbidden": [
            "Uma Musume huấn luyện",
            "Uma Musume Huấn luyện",
            "Mã Nương huấn luyện"
          ],
          "matched_aliases": [
            "育成赛马娘"
          ],
          "accepted_present": false,
          "forbidden_present": true,
          "require_accepted": true,
          "basis": "The repository already defines the full compound 育成赛马娘 / 育成ウマ娘 as the player-facing Trainee concept and explicitly excludes it from generic Umamusume matching. Extend that same full-compound identity to text_data descriptions. This does not map bare 育成 or bare 赛马娘 and therefore avoids the ambiguity that required the original localize_dict key scoping."
        }
      ],
