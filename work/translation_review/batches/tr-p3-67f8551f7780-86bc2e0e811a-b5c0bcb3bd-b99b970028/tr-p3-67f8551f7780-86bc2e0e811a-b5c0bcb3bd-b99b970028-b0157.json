    {
      "uid": "zhcn:f4f74fce2c15127c0eb07be4",
      "source_batch": 220,
      "entry_index": 34,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1071"
      ],
      "key": null,
      "source_text": "我的名字是目白阿尔丹。\\n即使这双脚脆弱不堪，我也要骄傲的奔跑下去……\\n哪怕只有一瞬也好，我也想在比赛中大放光彩。",
      "source_fingerprint": "f7762205e972aa100899d067d84fe23aea8f7e21e7d1540883262af441537c76",
      "current_text": "Tên tôi là Mejiro Ardan.\\nDù đôi chân này mong manh, tôi vẫn sẽ tiếp tục chạy với niềm kiêu hãnh…\\nDẫu chỉ trong một khoảnh khắc, tôi cũng muốn tỏa sáng rực rỡ trong Cuộc đua.",
      "current_fingerprint": "76a6bf163b7d905978c1fbc936c850e917bbcd2556a4d51c031c45a1e7585b07",
      "risk_flags": [
        "very_long_target"
