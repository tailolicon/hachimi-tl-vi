    {
      "uid": "zhcn:aff58590375a5f5bcabd374a",
      "source_batch": 131,
      "entry_index": 46,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1151"
      ],
      "key": null,
      "source_text": "向在这个时代出生的所有人宣告——\\n来吧，放声欢呼吧。你也将成为『传奇』的暴风眼！",
      "source_fingerprint": "02caca1d260628edd3a280446bef6a05390872387f615ae8f3c87ce7d8848be9",
      "current_text": "Xin tuyên bố với tất cả những ai sinh ra trong thời đại này —\\nNào, hãy reo hò thật lớn. Bạn cũng sẽ trở thành tâm bão của “huyền thoại”!",
      "current_fingerprint": "aaf1bcb99a63ec5b2007b7e6676fc782c5499805d3efc27fcae3d61a647a923e",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch"
      ],
      "risk_score": 11,
      "locked_terms": [
        {
          "id": "character.gran_alegria",
          "target_vi": "Gran Alegria",
          "matched_aliases": [
            "放声欢呼"
          ],
          "present": false
        }
      ],
      "community_terms": [],
