    {
      "uid": "zhcn:7587cfed32520cc283a11d62",
      "source_batch": 131,
      "entry_index": 51,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1157"
      ],
      "key": null,
      "source_text": "那日的记忆在蒸汽般飘荡，令人难忘，但又模糊不清……\\n请听「汤驹浪漫纯情派」。",
      "source_fingerprint": "446387d745bfbc15d2f1ac23bfa9ce9f3fc48fbfa0afa6e02568744f72736c7b",
      "current_text": "Ký ức ngày ấy bồng bềnh như hơi nước, khó quên mà lại mơ hồ…\\nXin mời lắng nghe “Khúc lãng mạn thuần tình của Ngựa Suối Nóng”.",
      "current_fingerprint": "64c2fa667b0a80cb40ac3600a5b1036ee482aa65d36da30d0dd3de717feaca63",
      "risk_flags": [
        "very_long_target",
        "community_term",
        "community_calque_risk",
        "community_term_mismatch"
      ],
      "risk_score": 19,
      "locked_terms": [],
