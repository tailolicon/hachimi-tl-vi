      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "8508"
      ],
      "key": null,
      "source_text": "ダービースタリオン マスターズ秋の１曲。\\n切ないラインは美しい紅葉の騒めきを感じさせる。",
      "source_fingerprint": "6b3d72961f3fde3fafe83fda23f14c4d63384013f90231f4d87f8a5f73d8967a",
      "current_text": "Một ca khúc mùa thu của ダービースタリオン マスターズ.\\nDòng giai điệu da diết khiến ta cảm nhận tiếng xào xạc của lá đỏ tuyệt đẹp.",
      "current_fingerprint": "47faed418ffe7454afddc49b196b5fd75f79783a44ada069fb20e711316e4e1a",
      "risk_flags": [
        "cjk_in_target"
