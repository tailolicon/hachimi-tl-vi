      "item_context_sha256": null
    },
    {
      "uid": "zhcn:841806db2b66318ec21ab8ef",
      "source_batch": 132,
      "entry_index": 22,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "8505"
      ],
      "key": null,
      "source_text": "于StarHorse4的生产环节播放的BGM。\\n随着成长过程与影片一同欣赏十分令人心满意足。",
      "source_fingerprint": "2c06fe6197c37523036962e78d55dbdc087937b5b39d0ced60f322e9cc515b3f",
      "current_text": "BGM phát trong giai đoạn phối giống của StarHorse4.\\nNgắm quá trình trưởng thành cùng video trên nền bài này thực sự rất mãn nguyện.",
      "current_fingerprint": "a70998789c1b65a69c042a7b31300a273ca7e3fd502df0ac72f7c2500eb3104e",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
