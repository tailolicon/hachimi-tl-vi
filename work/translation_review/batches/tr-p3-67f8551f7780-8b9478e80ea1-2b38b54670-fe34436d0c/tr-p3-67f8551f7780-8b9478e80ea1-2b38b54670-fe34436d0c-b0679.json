      "json_path": [
        "163",
        "1087"
      ],
      "key": null,
      "source_text": "我是小真。真弓快车。\\n总有一天我会成为世界的吉祥物。\\n请用你的那双眼一直看着我吧",
      "source_fingerprint": "32b8ffb7d15fb14ee16b277e776abfc16eee61eb27d3bf3257b64a2d12e683ab",
      "current_text": "Tôi là Machan. Aston Machan.\\nMột ngày nào đó, tôi sẽ trở thành linh vật của cả thế giới.\\nHãy luôn dõi theo tôi bằng chính đôi mắt ấy nhé.",
      "current_fingerprint": "d7028cd2ea082cc1c8f81f8299585703c87ac3fae65f96b3f863ee3cfab93185",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.aston_machan",
          "target_vi": "Aston Machan",
