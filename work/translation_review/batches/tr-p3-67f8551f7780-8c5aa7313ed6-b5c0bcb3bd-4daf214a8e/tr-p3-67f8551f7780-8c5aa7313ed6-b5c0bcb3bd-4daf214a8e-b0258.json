    },
    {
      "uid": "zhcn:896b56be0adb3987b5b003f6",
      "source_batch": 132,
      "entry_index": 0,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1187"
      ],
      "key": null,
      "source_text": "华丽、优雅、勇敢！点燃内心的充满力量的乐曲！\\n无论遇到什么困难都不会屈服——这才是公主应有的姿态！",
      "source_fingerprint": "627c7ddfd31ec59005af6b6f9ed19832c194148bcfdc62f5d08f26f005512730",
      "current_text": "Rực rỡ, thanh lịch, dũng cảm! Một khúc nhạc tràn đầy sức mạnh thắp sáng trái tim!\\nDù gặp bất cứ khó khăn nào cũng không khuất phục—đó mới là dáng vẻ của một công chúa!",
      "current_fingerprint": "55ec40803eca90d683fe7c7d9491813d7dbff7da68a9e5989075a432e28f4f93",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch",
        "absence_risk"
      ],
      "risk_score": 16,
      "locked_terms": [
        {
          "id": "stat.power",
          "target_vi": "Power",
          "matched_aliases": [
            "力量"
          ],
          "present": false
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": "ecd8b44729a810e790b53e6ff0dccc41f4d34e8db38281827e0c2b57b8142220"
    },
    {
      "uid": "zhcn:21ac70eddf577f31a7e0b58b",
      "source_batch": 132,
      "entry_index": 3,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1190"
      ],
      "key": null,
      "source_text": "传递☆我们的全力应援！将最大力量献给你♪\\n我们相信！你就是最强！！直到极限Pom Pon!!!",
      "source_fingerprint": "55e8a62e33f722cf8d0583ad8cec355288f2bb584d26ed2e5d2262402b44ead1",
      "current_text": "Trao gửi☆toàn bộ lời cổ vũ của chúng tôi! Dành sức mạnh lớn nhất cho bạn♪\\nChúng tôi tin! Bạn chính là mạnh nhất!! Cổ vũ hết mình, Pom Pon!!!",
      "current_fingerprint": "ac149d87e978632f875701e105485f6d2ab95f170c6f8ed257bca286bf77e273",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "stat.power",
          "target_vi": "Power",
