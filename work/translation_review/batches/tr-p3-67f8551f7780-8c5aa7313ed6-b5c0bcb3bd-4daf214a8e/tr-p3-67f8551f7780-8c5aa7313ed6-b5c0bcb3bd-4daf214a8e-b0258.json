    {
      "uid": "zhcn:5211f4e063be40a6a9173da2",
      "source_batch": 132,
      "entry_index": 5,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1192"
      ],
      "key": null,
      "source_text": "寄宿着觉悟的少女们，坚定不移的决心之曲。\\n因为宿敌赋予了我们力量——无论到哪里，都一起前行吧。",
      "source_fingerprint": "dbb53245b325ebfca1516edec8af4086451cfb887970e6ac7601443e18e2185f",
      "current_text": "Khúc nhạc của quyết tâm kiên định, nơi ý chí của những thiếu nữ trú ngụ.\\nBởi kình địch đã trao cho chúng ta sức mạnh—dù đi đâu, hãy cùng nhau tiến bước.",
      "current_fingerprint": "b9a45e59f48f22796af10fd8a41077b5a83cab1a678ea876ad7ac9a84bd40a7d",
      "risk_flags": [
        "very_long_target",
