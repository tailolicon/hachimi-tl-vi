      "json_path": [
        "131",
        "9"
      ],
      "key": null,
      "source_text": "继承来源双方皆为在育成过程中未取得过重赏胜利的赛马娘，\\n在继承心意后取得GⅠ胜利",
      "source_fingerprint": "c47a9d946e0d4d89a6d1fda1307bcbdb71d75641fd40a1f9858841be5accc017",
      "current_text": "Cả hai Mã Nương nguồn kế thừa đều chưa từng thắng giải trọng thưởng trong quá trình Huấn luyện,\\ngiành chiến thắng G1 sau khi kế thừa tâm ý",
      "current_fingerprint": "609cb552f01ddb8f6003f9e2379eb6904dc9ccb43a46eca0a97c99d4b9b4d952",
      "risk_flags": [
        "very_long_target",
