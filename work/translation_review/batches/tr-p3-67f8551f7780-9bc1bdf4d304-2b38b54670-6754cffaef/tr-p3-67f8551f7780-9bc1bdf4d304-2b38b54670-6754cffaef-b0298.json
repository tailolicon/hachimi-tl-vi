      "source_path": "localize_dict.json",
      "json_path": [
        "SingleModeScenarioTeamRace0064"
      ],
      "key": "SingleModeScenarioTeamRace0064",
      "source_text": "看来会陷入苦战，\n但可能性也不是零哦！",
