      "source_batch": 95,
      "entry_index": 42,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "SingleModeScenarioTeamRace0063"
      ],
      "key": "SingleModeScenarioTeamRace0063",
      "source_text": "是实力相近的队伍呢。\n虽然不能掉以轻心，但应该会是一场精彩的对决！",
      "source_fingerprint": "47d968d2a26cf206df7762f3d8e4f6533ec529ff79cb755500971e3a6363b947",
      "current_text": "Đây là đội có thực lực khá ngang nhau.\nKhông thể chủ quan, nhưng chắc chắn sẽ là một màn đối đầu hấp dẫn!",
      "current_fingerprint": "87943fb9fab3e9ac0164ae5a864f3ff541dae3320dedacca45b53d63121dbd02",
      "risk_flags": [
        "very_long_target"
