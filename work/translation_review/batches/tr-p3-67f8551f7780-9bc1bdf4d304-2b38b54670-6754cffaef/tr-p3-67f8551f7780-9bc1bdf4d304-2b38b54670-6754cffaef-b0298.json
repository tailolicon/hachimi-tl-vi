      "entry_index": 41,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "SingleModeScenarioTeamRace0062"
      ],
      "key": "SingleModeScenarioTeamRace0062",
      "source_text": "队员们都能发挥出实力的话，\n获胜概率应该会很大！",
      "source_fingerprint": "6a5d50d9b35dc78b8b3abd26073768c61d678f91decf426c78cba6a2d9fb1252",
      "current_text": "Nếu các thành viên đều phát huy được thực lực,\nkhả năng chiến thắng sẽ rất cao!",
      "current_fingerprint": "0ffdf31c78807fa7fc450786983c3887441fb2cf4ad0450a90c20a2995c57b49",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
