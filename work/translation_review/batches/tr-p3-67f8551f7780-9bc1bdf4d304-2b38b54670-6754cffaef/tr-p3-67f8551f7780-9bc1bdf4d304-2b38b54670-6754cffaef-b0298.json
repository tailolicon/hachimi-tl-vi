      "json_path": [
        "SingleModeScenarioTeamRace0060"
      ],
      "key": "SingleModeScenarioTeamRace0060",
      "source_text": "队员的实力都很充足。\n通过此次对战提高排名吧！",
      "source_fingerprint": "ea0630bf6cfdd3ee5daededfcb8832a403b5dd5f2e5c6d6626d466ba2d386051",
      "current_text": "Thực lực của các thành viên đều rất tốt.\nHãy nâng thứ hạng qua trận đấu này!",
      "current_fingerprint": "b272285a26777836e407932bd665ffbe5892f112611874e88ee1b9649f2f7902",
      "risk_flags": [
