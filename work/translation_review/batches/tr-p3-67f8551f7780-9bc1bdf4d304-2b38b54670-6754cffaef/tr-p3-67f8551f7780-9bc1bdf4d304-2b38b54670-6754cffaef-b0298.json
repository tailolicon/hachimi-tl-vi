      "source_path": "localize_dict.json",
      "json_path": [
        "SingleModeScenarioTeamRace0061"
      ],
      "key": "SingleModeScenarioTeamRace0061",
      "source_text": "虽然也有需要担心的比赛，\n但以她们为对手可以期待获胜！",
      "source_fingerprint": "4520ef73c35d498c2a42167eb96790d66697331c7e594f4d07fc7f7f5311545a",
      "current_text": "Dù có vài cuộc đua đáng lo,\nnhưng trước đối thủ này có thể kỳ vọng chiến thắng!",
      "current_fingerprint": "76dd78f0f5860f75f8ea8fcd0fb0c0986e18e3f9d26b3737ab477527f028e54d",
      "risk_flags": [],
      "risk_score": 0,
