    {
      "uid": "zhcn:916c6952c3e44fa9aa0d663d",
      "source_batch": 220,
      "entry_index": 65,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1103"
      ],
      "key": null,
      "source_text": "我的愿望只有一个――那就是获得“最强”之称号！\\n我要成为能留在人们记忆中的赛马娘！\\n为了实现这个目标，必不可少的……没错，就是自我展示！",
