    {
      "uid": "zhcn:7bcb5d17761bf3e9ecdd370f",
      "source_batch": 52,
      "entry_index": 31,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0479"
      ],
      "key": "Race0479",
      "source_text": "恭喜！\n积累平时的胜利是很重要的。",
      "source_fingerprint": "f69cdaddbbc0631e4f84559e9e783c300ccb44492b3243d39de3d88908273bbc",
      "current_text": "Chúc mừng!\nTích lũy những chiến thắng thường ngày là điều rất quan trọng.",
      "current_fingerprint": "fd6f801d7961f0c33bebbb192d25a5047382be3985d095451ae23ebe451ee48d",
      "risk_flags": [
        "very_long_target"
