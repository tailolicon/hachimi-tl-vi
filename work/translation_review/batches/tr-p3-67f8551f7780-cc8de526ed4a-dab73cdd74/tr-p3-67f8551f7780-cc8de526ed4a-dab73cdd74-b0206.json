    {
      "uid": "zhcn:c7c1cbd13408e206939ef86c",
      "source_batch": 52,
      "entry_index": 33,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0481"
      ],
      "key": "Race0481",
      "source_text": "恭喜获胜！　能在有强大对手参赛的比赛中\n获胜是很了不起的。",
      "source_fingerprint": "4f6529f68eeaf560ef517d844190a30110bf27fe13cd9c316159f67eca6c9b12",
      "current_text": "Chúc mừng chiến thắng! Có thể giành chiến thắng trong cuộc đua\ncó những đối thủ mạnh tham gia thật sự rất đáng nể.",
      "current_fingerprint": "75e60d6f62448f274f2b5125302b06404341d66f834d9efe2abc4085cabbba40",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "race.generic",
          "target_vi": "Cuộc đua",
          "matched_aliases": [
            "比赛"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:fcd5e3847e3f74ab0c9a262e",
      "source_batch": 52,
      "entry_index": 34,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0482"
      ],
      "key": "Race0482",
      "source_text": "让优胜逃走了呢。\n在有强敌的情况下战斗能够增强自信呢！",
      "source_fingerprint": "9b3c6cbbf6b47bdc4b4211c9476a077b9612999834843b152cf4dea1e27b73e5",
      "current_text": "Đã để vuột mất chiến thắng.\nĐược thi đấu khi có đối thủ mạnh sẽ giúp tăng thêm tự tin!",
      "current_fingerprint": "ac8b03d3f0114f0284b93ac956954f63fc99a8d13443f12c0217b1c4ef1d2924",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:35e2bc92fc4e9f44845af45e",
      "source_batch": 52,
      "entry_index": 35,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0484"
      ],
      "key": "Race0484",
      "source_text": "恭喜取得初次胜利！\n千里之行始于足下，新的传说开始了呢。",
      "source_fingerprint": "bc90f0ef9354891be57bdc628a4606a12760fac3ce1b4afdba949f3978f7b48b",
      "current_text": "Chúc mừng chiến thắng đầu tiên!\nHành trình ngàn dặm bắt đầu từ một bước chân, một huyền thoại mới đã bắt đầu.",
      "current_fingerprint": "e77f5c63779895a1a4d3efaf3bbd2e678783f6fe9212c8b6de319a9b538a9207",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:85849403833cf78e8cf05646",
      "source_batch": 52,
      "entry_index": 36,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0485"
      ],
      "key": "Race0485",
      "source_text": "恭喜！\n保持这种状态继续取胜吧。",
      "source_fingerprint": "5f5cdf47161d9121478e54ed301c4519731427fe5ea5984eb057e36bf2725599",
      "current_text": "Chúc mừng!\nHãy giữ phong độ này và tiếp tục giành chiến thắng.",
      "current_fingerprint": "ce0d14f6dcfe7e2cb11eebeb8a11a7b8c4ba5ac8b8e56feeee289896875c5697",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
      "uid": "zhcn:f55a45f41b8167c046b17749",
      "source_batch": 52,
      "entry_index": 37,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0486"
      ],
      "key": "Race0486",
      "source_text": "干的不错呢！\n继续以优胜为目标加油吧！",
      "source_fingerprint": "a7deb906bd97ebac55310fb4384bdbff1bf9b393b6cd294cd88535ce10963a88",
      "current_text": "Làm rất tốt!\nHãy tiếp tục cố gắng hướng tới chiến thắng!",
      "current_fingerprint": "de450c69b6373e493a89240f3cafcf29869699bb518a4e151ce1f4d23f2936c4",
