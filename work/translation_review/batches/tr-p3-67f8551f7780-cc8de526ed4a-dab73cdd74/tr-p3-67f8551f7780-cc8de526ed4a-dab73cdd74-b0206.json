      "source_batch": 52,
      "entry_index": 32,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0480"
      ],
      "key": "Race0480",
      "source_text": "就差一点点了呢。但也从失败中学到了东西\n将其活用到下次比赛吧。",
      "source_fingerprint": "4f807df8f579ff22ae37a465aefee74e89846e949fe68a09cab1a676416bd986",
      "current_text": "Chỉ thiếu một chút thôi. Nhưng cũng đã học được điều gì đó từ thất bại\nhãy vận dụng vào cuộc đua tiếp theo.",
      "current_fingerprint": "7dfb09a8f45144997219c28570d387e168862d3693a229ce1300c5eca0bc5dbc",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "race.generic",
