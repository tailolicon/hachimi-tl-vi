      "source_batch": 52,
      "entry_index": 42,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0493"
      ],
      "key": "Race0493",
      "source_text": "非常可惜。虽然错过了优胜\n但比赛很充实呢。",
      "source_fingerprint": "f19ac6f4355876da2303435679fcc9e6b886fec89117ad4cdefabb85a4ac5b2b",
      "current_text": "Rất đáng tiếc. Dù đã vuột mất chiến thắng\nnhưng đây là một cuộc đua rất trọn vẹn.",
      "current_fingerprint": "9131b5a58f00c18499017982c74450f6a7c201a9646c1ecd3a599a0ee5da4fe5",
      "risk_flags": [
        "very_long_target"
