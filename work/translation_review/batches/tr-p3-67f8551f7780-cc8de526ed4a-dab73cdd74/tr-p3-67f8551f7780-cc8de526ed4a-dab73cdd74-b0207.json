      "entry_index": 41,
      "kind": "localize",
      "source_path": "localize_dict.json",
      "json_path": [
        "Race0492"
      ],
      "key": "Race0492",
      "source_text": "离胜利还有一点距离呢。虽然结果有点遗憾\n但也显示出了实力吧。",
      "source_fingerprint": "4ad35d3014a41755ec060c113d4c1373128d301e9d5c6b67a57880fa79e272a2",
      "current_text": "Vẫn còn một chút khoảng cách đến chiến thắng. Dù kết quả hơi đáng tiếc\nnhưng cũng đã thể hiện được thực lực.",
      "current_fingerprint": "31f8b90ba9d8ab2ba7a801b5062c4693ba515a89854c6232f5f0c04261e7edda",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null
    },
    {
