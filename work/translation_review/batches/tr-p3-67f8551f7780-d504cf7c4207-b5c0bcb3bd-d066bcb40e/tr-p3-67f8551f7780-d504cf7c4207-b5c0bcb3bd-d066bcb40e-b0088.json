        "131",
        "190"
      ],
      "key": null,
      "source_text": "在取得「超凡赛马娘」称号的情况下，取得春季天皇赏、宝冢纪念、\\n日本杯、秋季天皇赏、大阪杯以及有马纪念中任意2场的胜利\\n※Make a new track!!～巅峰赛开幕～限定",
      "source_fingerprint": "7fcd8f8adea2dc3ed845a9c6beed121e0ab5494829ba1f3432d0299a4d3faa85",
      "current_text": "Trong khi đã đạt danh hiệu 「Mã Nương Siêu phàm」, giành chiến thắng 2 cuộc bất kỳ trong số Tenno Sho (Spring), Takarazuka Kinen,\\nJapan Cup, Tenno Sho (Autumn), Osaka Hai và Arima Kinen\\n※Chỉ dành cho Make a new track!! ～Cuộc đua đỉnh cao khai màn～",
      "current_fingerprint": "22316e538e4c8a4e1bd19f3e8975cf5a46e6738b1006ad5c115c9bb8e15f161a",
      "risk_flags": [
        "community_term",
        "community_term_mismatch",
        "numeric_token_mismatch"
      ],
      "risk_score": 13,
      "locked_terms": [],
      "community_terms": [
        {
          "id": "common.world.umamusume",
          "preferred": "Mã Nương",
          "accepted": [
