            "Uma Musume"
          ],
          "matched_aliases": [
            "赛马娘"
          ],
          "accepted_present": true,
          "forbidden_present": false,
          "require_accepted": true,
          "basis": "Generic 赛马娘 is the project world/species term Mã Nương, but it must not fire inside established ウマ娘ステークス race-name forms represented by 赛马娘锦标."
        },
        {
          "id": "scenario.trackblazer.start_of_the_climax",
          "preferred": "Start of the Climax",
          "accepted": [
            "Start of the Climax"
          ],
          "forbidden": [
            "Climax khai mạc",
            "Khai mạc Climax"
          ],
          "matched_aliases": [
            "巅峰赛开幕"
          ],
          "accepted_present": false,
          "forbidden_present": false,
          "require_accepted": true,
          "basis": "The zh-CN subtitle 巅峰赛开幕 is the localized bridge for JP クライマックス開幕 in the third Career scenario. The released Global scenario is Trackblazer: Start of the Climax, so preserve the player-facing Global subtitle Start of the Climax rather than the mixed Vietnamese calque Climax khai mạc."
        }
      ],
