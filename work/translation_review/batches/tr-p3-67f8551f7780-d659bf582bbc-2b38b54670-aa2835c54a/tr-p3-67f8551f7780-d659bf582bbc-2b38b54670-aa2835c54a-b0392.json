    {
      "uid": "zhcn:869cd06e8c2a8d13896aa9c4",
      "source_batch": 129,
      "entry_index": 70,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1001"
      ],
      "key": null,
      "source_text": "粉饰URA总决赛的欢快歌曲。\\n马儿跳♪马儿跳♪绝对能带起现场的气氛！",
      "source_fingerprint": "ca0a69d88943c4f2a6ba935358fa033fbc59b57bc8a9939007c9d0b8a4324070",
      "current_text": "Ca khúc vui tươi tô điểm cho URA Finals.\\nNgựa nhảy♪ Ngựa nhảy♪ Chắc chắn sẽ khuấy động không khí!",
      "current_fingerprint": "4861a7c66b373662a5b30be07554ee0383a46f9e4dba4f574160ecc5e69220c1",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:32534c621c0e3f52cad487cc",
      "source_batch": 129,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1003"
      ],
      "key": null,
      "source_text": "我们两人一起，什么都可以做到！\\n这充满活力的乐曲，一定也能令你欢笑☆",
      "source_fingerprint": "5050c0e710a6e76414cc064f905caf37e22d828f76b02998ff171e3cc8cf1396",
      "current_text": "Hai chúng ta bên nhau, chuyện gì cũng làm được!\\nGiai điệu tràn đầy năng lượng này chắc chắn cũng sẽ khiến bạn mỉm cười☆",
      "current_fingerprint": "7f87d9988ea69b9beb8526cdf960038c2333c238e3d498c79dace8a51df43375",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:8413b24294453735b45a0a76",
      "source_batch": 129,
      "entry_index": 72,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1004"
      ],
      "key": null,
      "source_text": "因为和你一同奔跑ー\\n我们的旋律永远不会停止。已经，不会再回头了。",
      "source_fingerprint": "8d39ea31f558d5cad69cd63639f26896c1b6d8b49ae76eb25598569c49380920",
      "current_text": "Vì được chạy cùng bạn—\\nGiai điệu của chúng ta sẽ không bao giờ dừng lại. Giờ đây, sẽ không quay đầu nữa.",
      "current_fingerprint": "921c4521422c4cc8a8bfc0e95d456e52edc9044004783bb43612dd312c979829",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:8bd91d3bf294c19ef09f8edc",
      "source_batch": 129,
      "entry_index": 73,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1005"
      ],
      "key": null,
      "source_text": "仅赠予荣获三后冠的女王们的歌曲。\\n华丽的同时，也有着顽强追梦的美。",
      "source_fingerprint": "80a55b72c2a740cff1f9760c28c28e5735e42fdf5cd90aca6aa814166601e7ba",
      "current_text": "Ca khúc chỉ dành tặng những nữ hoàng giành Triple Tiara.\\nLộng lẫy nhưng cũng mang vẻ đẹp kiên cường theo đuổi ước mơ.",
      "current_fingerprint": "fe6d7c1da5cef6ce02d7e644a3dd738fa4c344064e188bb564c76c8ada82c177",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:f812a8a4770d3d3afe8e2dbb",
      "source_batch": 129,
      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1006"
      ],
      "key": null,
      "source_text": "献给刚出道赛马娘的首支歌曲。\\n吹响那开场号！响彻至终点吧！！",
      "source_fingerprint": "253236cd6601347b62670db8bec41a60e6d01f6b0b49164e7693f8613b894889",
      "current_text": "Ca khúc đầu tiên dành tặng Uma Musume vừa ra mắt.\\nHãy thổi vang tiếng kèn khai màn! Vang tới tận vạch đích!!",
      "current_fingerprint": "6e113d2c32df9fdd2ccca192d6ade12153887e66f36fedbf7043c226e116148f",
