    {
      "uid": "zhcn:c0c393dc2c0494ccea9e444c",
      "source_batch": 143,
      "entry_index": 37,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "131",
        "187"
      ],
      "key": null,
      "source_text": "达成「超凡赛马娘」（カリスマウマ娘）、「马娘女主角」（ヒロインウマ娘）中的一个，\\n并达成「春之霸者」、「秋之霸者」\\n※Make a new track!!～巅峰赛开幕～限定",
      "source_fingerprint": "3c12fe14b64e729c2d65bdc8f2b70e99de8de795447d1ee91b402803af436c4a",
      "current_text": "Đạt một trong hai danh hiệu 「Mã Nương Siêu phàm」 hoặc 「Nữ chính Mã Nương」,\\nđồng thời đạt 「Bá chủ Mùa xuân」 và 「Bá chủ Mùa thu」\\n※Chỉ dành cho Make a new track!! ～Cuộc đua đỉnh cao khai màn～",
      "current_fingerprint": "ae4bee7e05f3e29bee49e6f9011c73af9098629c83a9635d83368e2fd5289b31",
      "risk_flags": [
        "community_term"
