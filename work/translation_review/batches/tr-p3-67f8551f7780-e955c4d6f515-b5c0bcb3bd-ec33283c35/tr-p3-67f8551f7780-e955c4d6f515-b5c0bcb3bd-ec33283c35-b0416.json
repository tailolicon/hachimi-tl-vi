      "source_path": "text_data_dict.json",
      "json_path": [
        "128",
        "1001"
      ],
      "key": null,
      "source_text": "粉饰URA总决赛的欢快歌曲。\\n马儿跳♪马儿跳♪绝对能带起现场的气氛！",
      "source_fingerprint": "ca0a69d88943c4f2a6ba935358fa033fbc59b57bc8a9939007c9d0b8a4324070",
      "current_text": "Ca khúc vui tươi tô điểm cho URA Finals.\\nNgựa nhảy♪ Ngựa nhảy♪ Chắc chắn sẽ khuấy động không khí!",
      "current_fingerprint": "4861a7c66b373662a5b30be07554ee0383a46f9e4dba4f574160ecc5e69220c1",
      "risk_flags": [],
      "risk_score": 0,
