    {
      "uid": "zhcn:2b9bae1443d2f903ca91a2a3",
      "source_batch": 219,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1001"
      ],
      "key": null,
      "source_text": "我的名字叫特别周！\\n梦想是成为日本第一的赛马娘！\\n为了让妈妈们感到欣慰，我会加油的！",
      "source_fingerprint": "00ca9fbb196091f984161acbd4170f7de6d5c2fa5a768352e0504114d898bf76",
      "current_text": "Mình là Special Week!\\nƯớc mơ của mình là trở thành Uma Musume số một Nhật Bản!\\nĐể các mẹ vui lòng, mình sẽ cố gắng hết sức!",
      "current_fingerprint": "695f8d3138edad591e8103f118bc3dbaeb79c28083ac365d87a9f64f89718aed",
      "risk_flags": [
        "community_term",
        "community_calque_risk",
        "community_term_mismatch",
