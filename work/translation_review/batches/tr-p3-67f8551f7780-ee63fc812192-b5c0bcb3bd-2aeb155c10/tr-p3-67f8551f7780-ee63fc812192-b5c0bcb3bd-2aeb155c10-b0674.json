      "locked_terms": [
        {
          "id": "character.mr_cb",
          "target_vi": "Mr. C.B.",
          "matched_aliases": [
            "千明代表"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
