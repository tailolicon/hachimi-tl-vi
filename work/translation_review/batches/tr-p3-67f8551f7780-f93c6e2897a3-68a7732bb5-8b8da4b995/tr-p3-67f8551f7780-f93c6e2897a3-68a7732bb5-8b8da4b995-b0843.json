    {
      "uid": "zhcn:739e85c8d4f0e55181e31ef4",
      "source_batch": 220,
      "entry_index": 25,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1062"
      ],
      "key": null,
      "source_text": "呀吼！我是待兼诗歌剧哟！\\n为了不输给努力的大家，我也得一鼓作气的\\n努力练习……诶，今天是休息日！？",
      "source_fingerprint": "54f6139c8fd69435cef906ba996833a3497d4eac3d9089a9457454c43ab9b6c3",
      "current_text": "Yahho! Tôi là Matikanetannhauser đây!\\nĐể không thua mọi người đang nỗ lực, tôi cũng phải hăng hái\\nluyện tập thật chăm… Ể, hôm nay là ngày nghỉ á!?",
      "current_fingerprint": "2e726a4b924f97e8f9b7797abae98f4aad290f7d295c737f2a4f88eb672b8cd5",
      "risk_flags": [],
      "risk_score": 0,
