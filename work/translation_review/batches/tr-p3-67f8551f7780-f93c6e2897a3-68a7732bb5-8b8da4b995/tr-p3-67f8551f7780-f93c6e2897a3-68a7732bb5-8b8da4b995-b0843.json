    {
      "uid": "zhcn:3338838232ae4e6c539a8f9c",
      "source_batch": 220,
      "entry_index": 27,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1064"
      ],
      "key": null,
      "source_text": "我是目白善信！你好吗～？\\n嘛，有什么事的话随时都可以找我聊哦。\\n不用太拘谨哟♪",
      "source_fingerprint": "c0c73ce98a1730c65610935936ba6169c425bc886cac2558ac6eb108900961b5",
      "current_text": "Tôi là Mejiro Palmer! Khỏe không～?\\nMà, có chuyện gì thì cứ tìm tôi tâm sự bất cứ lúc nào nhé.\\nĐừng khách sáo quá♪",
      "current_fingerprint": "f82e25b1ada0bb0821c1956c2f82d01d6744b70dd384d7649727e4d052ee00ed",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.mejiro_palmer",
          "target_vi": "Mejiro Palmer",
          "matched_aliases": [
            "目白善信"
          ],
