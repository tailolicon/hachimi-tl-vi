    {
      "uid": "zhcn:a5701c92ee5f8c496788f567",
      "source_batch": 220,
      "entry_index": 28,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1065"
      ],
      "key": null,
      "source_text": "Va——y！大拓太阳神哟！\\n我会在嗨翻天的比赛上猛冲，\\n所以麻烦给我最高亢的CALL哦☆",
      "source_fingerprint": "b6714629422f6f78ad90d700288c4f99c3796377ea6adae96c515788211294bb",
      "current_text": "Vaaay! Daitaku Helios đây!\\nTôi sẽ lao hết mình trong những cuộc đua quẩy banh nóc,\\nnên nhớ dành cho tôi tiếng CALL máu lửa nhất nhé☆",
      "current_fingerprint": "9c9a95e5f74860766af85a09fb4982958431e1dbf9c1560b3f072fdc587f5558",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
