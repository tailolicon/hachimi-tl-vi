    {
      "uid": "zhcn:e5a805b777497d5785c846b5",
      "source_batch": 220,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1055"
      ],
      "key": null,
      "source_text": "嗨嗨，我是美丽周日！\\n向全世界传递Marvelous的感觉！\\n那么，大家也一起，Marvelous！",
      "source_fingerprint": "1e7e307eb45c87bab8103a1f9b21b38d41e941f9dd0facaaef41fb47140048c9",
      "current_text": "Hi hi, tôi là Marvelous Sunday!\\nLan tỏa cảm giác Marvelous đến khắp thế giới!\\nNào, mọi người cùng nhau, Marvelous!",
      "current_fingerprint": "5438bcf842fcbc4f5cc5c9c41a81cc1485ca083683775a5324bed20727b7d375",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.marvelous_sunday",
          "target_vi": "Marvelous Sunday",
          "matched_aliases": [
            "美丽周日"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
