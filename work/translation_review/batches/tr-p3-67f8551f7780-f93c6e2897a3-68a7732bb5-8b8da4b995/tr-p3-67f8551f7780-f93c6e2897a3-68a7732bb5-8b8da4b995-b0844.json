    {
      "uid": "zhcn:d97dff15adbd945ccd5c1e71",
      "source_batch": 220,
      "entry_index": 44,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1081"
      ],
      "key": null,
      "source_text": "我是希望之城ー！\\n比赛的话随时奉陪！我要让你们都叫苦不迭……\\n喂你这家伙！别来摸我啊！",
      "source_fingerprint": "84bf98e17f5cf1e373e372123f42978fc20acf570c7b4c1dd5e7f4e9f840cd97",
      "current_text": "Tôi là Espoir Cityー!\\nĐua lúc nào tôi cũng chiều! Tôi sẽ khiến các người khổ sở cho xem…\\nNày, tên kia! Đừng có sờ tôi!",
      "current_fingerprint": "74bc43861f6fd9ac07499ac5600f22a3b6f6b14d92e8877bcab7c9496d0de6eb",
      "risk_flags": [
        "locked_term_mismatch"
      ],
      "risk_score": 8,
