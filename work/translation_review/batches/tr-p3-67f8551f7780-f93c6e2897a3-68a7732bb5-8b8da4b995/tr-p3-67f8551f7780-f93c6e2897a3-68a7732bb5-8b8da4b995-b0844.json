      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:1969600c6812221497cd02d1",
      "source_batch": 220,
      "entry_index": 42,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1079"
      ],
      "key": null,
      "source_text": "我是狂怒乐章，非中央所属。\\n是从船桥来的特别留学生。\\n船桥的强大……我一定会展现出来。",
      "source_fingerprint": "fb6c46b1e6d3e0192d3df2b2ccc7afb6e2217fdc4c590b75ed6cd4e4cd00d8b0",
      "current_text": "Tôi là Furioso, không thuộc hệ Trung ương.\\nTôi là du học sinh đặc biệt đến từ Funabashi.\\nSức mạnh của Funabashi… tôi nhất định sẽ cho mọi người thấy.",
      "current_fingerprint": "174e8b106f25352d37d5040653389535053998f5b9d45914aab122a84ad7210c",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:e8bd29c8ea9a36c086cb18c5",
      "source_batch": 220,
      "entry_index": 43,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1080"
      ],
      "key": null,
      "source_text": "所以说请多关照咯～训练员酱♪\\n咱们就一起去寻找那些\\n令人兴奋不已的事情吧ー",
      "source_fingerprint": "ed958925dd3f057cfad2c6dd323323342eee0f019a841fddcde83bc49056625c",
      "current_text": "Vậy nên mong được giúp đỡ nha～ Trainer-chan♪\\nChúng ta hãy cùng nhau đi tìm\\nnhững điều khiến mình phấn khích không thôi nhéー",
      "current_fingerprint": "140ab402213adb75542cf6ae08486df728a99cc3d151c7e601f9debbb73d791d",
      "risk_flags": [
        "very_long_target",
