          ],
          "present": false
        },
        {
          "id": "character.espoir_city",
          "target_vi": "Espoir City",
          "matched_aliases": [
            "希望之城"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
