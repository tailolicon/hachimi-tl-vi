    {
      "uid": "zhcn:1573a1685e8aca3dd5140820",
      "source_batch": 220,
      "entry_index": 77,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1115"
      ],
      "key": null,
      "source_text": "不敬，速跪。\\n――面对吾黄金巨匠之霸道，\\n虔诚顺服为宜",
      "source_fingerprint": "c7f44389d84ed456ea62a35da9ad8e2eeec1e4e349395bcd3af15a5a7eba845f",
      "current_text": "Bất kính. Mau quỳ xuống.\\n――Trước bá đạo của ta, Orfevre,\\ntốt hơn hết hãy thành kính quy phục.",
      "current_fingerprint": "0de86bf4b80681b2ed7dea5fc3a68974ea6a26c6715616da73492dd7330f772d",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.orfevre",
          "target_vi": "Orfevre",
          "matched_aliases": [
            "黄金巨匠"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:96e7da0808636b9a665d0176",
      "source_batch": 220,
      "entry_index": 78,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1116"
      ],
      "key": null,
      "source_text": "过程和理论什么的，全都没有意义。\\n胜者就是正义，不对吗？\\n我贵妇人，会让一切屈服于我的",
      "source_fingerprint": "08c16ffdba4f6330cebf1a2d9369a70ca2b51b41e7ddf369d3feb469f3ade12b",
      "current_text": "Quá trình hay lý luận gì đó đều vô nghĩa.\\nKẻ chiến thắng mới là chính nghĩa, chẳng phải sao?\\nTa, Gentildonna, sẽ khiến tất cả phải khuất phục.",
      "current_fingerprint": "f56fc52b683d4ac9565b7dad2d84ab4eb39528acaf7d2938ec9afa3eab370ec9",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [
        {
          "id": "character.gentildonna",
          "target_vi": "Gentildonna",
          "matched_aliases": [
            "贵妇人"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:4bd75ea8fb6f7726cb518e03",
      "source_batch": 220,
      "entry_index": 79,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1117"
      ],
      "key": null,
      "source_text": "我是凯旋芭蕾。主角……\\n想要成为主角只有不断努力！\\n虽然身边都是很强的家伙我也不会气馁！",
      "source_fingerprint": "0e77e9ba4dceb22fb2a09443cc67b7bad5ec082ab41f97daefca2399a2f37d8c",
      "current_text": "Tôi là Win Variation. Nhân vật chính…\\nMuốn trở thành nhân vật chính thì chỉ có cách không ngừng nỗ lực!\\nDù xung quanh toàn những kẻ rất mạnh, tôi cũng sẽ không nản lòng!",
      "current_fingerprint": "09e7a579b5a9078f3ea1ecf5ffe956155163945530ae0959b7670fb1158da31b",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch"
      ],
      "risk_score": 11,
      "locked_terms": [
        {
          "id": "reviewed.skill_name.1c68057834c9",
          "target_vi": "Khải hoàn",
          "matched_aliases": [
            "凯旋"
          ],
          "present": false
        },
        {
          "id": "character.win_variation",
          "target_vi": "Win Variation",
          "matched_aliases": [
            "凯旋芭蕾"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
