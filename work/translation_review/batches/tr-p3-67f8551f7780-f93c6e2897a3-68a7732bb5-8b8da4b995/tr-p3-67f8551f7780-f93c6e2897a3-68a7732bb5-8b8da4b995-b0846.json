      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1114"
      ],
      "key": null,
      "source_text": "我是迷人景致。我的梦想，就是兑现约定。\\n――我要抵达那“绝景”。\\n请多关照，训练员！……呵呵",
      "source_fingerprint": "c9e5a740041e088c03b4b5b935359a6c80fda8a2348e59f0f2fbe39b417241db",
      "current_text": "Tôi là Buena Vista. Ước mơ của tôi là thực hiện lời hứa.\\n――Tôi sẽ vươn tới “tuyệt cảnh” ấy.\\nRất mong được giúp đỡ, Trainer! …Fufu.",
      "current_fingerprint": "1754551b66b324ae1e4b6324548e510947a0c4ca333355141c9cad73d431ad32",
      "risk_flags": [
        "community_term"
      ],
      "risk_score": 2,
      "locked_terms": [
        {
          "id": "character.buena_vista",
          "target_vi": "Buena Vista",
