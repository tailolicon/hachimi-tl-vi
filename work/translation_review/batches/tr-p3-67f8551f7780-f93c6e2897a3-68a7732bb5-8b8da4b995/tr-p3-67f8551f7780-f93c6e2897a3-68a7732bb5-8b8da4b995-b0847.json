    {
      "uid": "zhcn:62964375fbc4a0b58ac69af2",
      "source_batch": 221,
      "entry_index": 20,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1141"
      ],
      "key": null,
      "source_text": "我是神威启示！伴随着『命运之声』的\n祝福，让我引领大家走向幸福吧！\n将命运传播至宇宙的尽头！就是现在！",
      "source_fingerprint": "8e0f4305ad5ed9cc2b6067359d0da51fe61506a3a8f6c109287b9b4751ed8d1b",
      "current_text": "Tôi là Epiphaneia! Với phúc lành của 『Tiếng nói Định mệnh』,\nhãy để tôi dẫn dắt mọi người tới hạnh phúc!\nHãy truyền vận mệnh đến tận cùng vũ trụ! Ngay bây giờ!",
      "current_fingerprint": "c71ffdfb924b6837478cea3af58648a66b811ea5ce9c7e18143f276bf1154c4e",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:c0cccf0f63ef24208209a4b8",
      "source_batch": 221,
      "entry_index": 21,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1143"
      ],
      "key": null,
      "source_text": "我是比萨胜驹。为了不让别人感到“孤单”，\\n为了让世界与希望之轮连结在一起。\\n就用我的奔跑来实现",
      "source_fingerprint": "3449ee1db91bdc482fe46782c19a3358a2fafae67cc9603815ce773e7a1c7889",
      "current_text": "Tôi là Victoire Pisa. Để không ai phải cảm thấy “cô đơn”,\\nđể thế giới kết nối thành vòng tròn hy vọng.\\nTôi sẽ biến điều đó thành hiện thực bằng những bước chạy của mình",
      "current_fingerprint": "cb917b80960279b5352bf26ea9662bb6394e60abe501d047fe62ee0b05ec0882",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [
        {
          "id": "character.victoire_pisa",
          "target_vi": "Victoire Pisa",
          "matched_aliases": [
            "比萨胜驹"
          ],
          "present": true
        }
      ],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:995d8b90981803a1f185d976",
      "source_batch": 221,
      "entry_index": 22,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1145"
      ],
      "key": null,
      "source_text": "我是统治地位。凭借我这完美的\\n战略，我将华丽地支配\\n闪耀系列赛这局棋盘！",
      "source_fingerprint": "f081b1f6aab47417d62be3482e4f5cb37d8da4769ea1c2c5b23aa87327abc65e",
      "current_text": "Tôi là Rulership. Với chiến lược hoàn hảo\\ncủa mình, tôi sẽ hoa lệ thống trị\\nbàn cờ mang tên Twinkle Series!",
      "current_fingerprint": "534c0f91be52f346f828b9ebfce3099a4bb90589317d07e3d84ea2dbf74c9a50",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [
        {
          "id": "character.rulership",
          "target_vi": "Rulership",
          "matched_aliases": [
            "统治地位"
