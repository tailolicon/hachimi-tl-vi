      "source_batch": 221,
      "entry_index": 33,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "9044"
      ],
      "key": null,
      "source_text": "我是都留岐凉花。我的日常工作\\n就是制作各类内容。\\n我会把至高的感动传递给大家",
      "source_fingerprint": "4cdb32d4e05f359abc9bcb9dbaaf4efa5d5b3dacce9033fc609dd44bf0b8ad80",
      "current_text": "Tôi là Tsurugi Ryoka. Công việc thường ngày của tôi\\nlà sản xuất đủ loại nội dung.\\nTôi sẽ mang niềm xúc động tột đỉnh đến cho mọi người.",
      "current_fingerprint": "828732859429b2e6f71ab4e39d2e7a61085e25f8ee31f2745c7ad9d96cfff094",
