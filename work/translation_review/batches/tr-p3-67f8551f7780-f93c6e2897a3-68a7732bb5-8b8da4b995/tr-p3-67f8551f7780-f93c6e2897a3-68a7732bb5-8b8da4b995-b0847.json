    {
      "uid": "zhcn:3711c5deba2a98d1fe5cd105",
      "source_batch": 221,
      "entry_index": 19,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1140"
      ],
      "key": null,
      "source_text": "啊、那个……就是——『你好☆\n我是洛林酱哦♪我会和青梅竹马的唯爱酱\n一起，好好加油哦☆』",
      "source_fingerprint": "459304e453d77960545f69387f2a964d440fc148985d69a31c7bb489834f7053",
      "current_text": "À, ừm... chính là—『Xin chào☆\nMình là Marche-chan đây♪ Mình sẽ cùng người bạn thuở nhỏ Loves-chan\ncố gắng thật chăm chỉ nhé☆』",
      "current_fingerprint": "28eabbd7bbd7c691e146a067ae065ccb48a70081324e522103ee71540496bd5e",
      "risk_flags": [],
      "risk_score": 0,
      "locked_terms": [],
      "community_terms": [],
