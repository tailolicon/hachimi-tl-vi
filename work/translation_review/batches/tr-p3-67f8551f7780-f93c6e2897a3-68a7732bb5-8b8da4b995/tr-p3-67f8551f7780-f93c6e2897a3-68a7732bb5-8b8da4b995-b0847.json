    {
      "uid": "zhcn:f92a9396804feb6e3e33933d",
      "source_batch": 221,
      "entry_index": 18,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "1139"
      ],
      "key": null,
      "source_text": "我是夺金旅途。无论是多高的顶点，\\n只要踏出脚步就都能接近。我有\\n给你勇气的资质，哦",
      "source_fingerprint": "32f9d5a74548c67f41fc8d37ce2c4a8aee252e4a4e1c0fddda094de8d2bb4536",
      "current_text": "Tôi là Casino Drive. Dù đỉnh cao có cao đến đâu,\\nchỉ cần bước đi là sẽ tiến gần hơn. Tôi có\\ntư chất để trao cho bạn dũng khí, đấy.",
      "current_fingerprint": "89f66b731c13ff2e0e8a46086946c78b937b6c6b7c1622bf113b4d0dc9df92cd",
      "risk_flags": [
        "very_long_target",
        "absence_risk"
      ],
      "risk_score": 8,
      "locked_terms": [],
      "community_terms": [],
