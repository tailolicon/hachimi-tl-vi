      "source_path": "text_data_dict.json",
      "json_path": [
        "163",
        "9001"
      ],
      "key": null,
      "source_text": "您好，我是特雷森学园的理事长秘书骏川手纲。\\n为了让大家能够过上更好的学园生活，\\n我会全力支援您的♪",
      "source_fingerprint": "69dd42e6caeaec2788354ebf403d5ba13ab115c858b7ad0b725ae38967f3db5f",
      "current_text": "Xin chào, tôi là Tazuna Hayakawa, thư ký hiệu trưởng Học viện Tracen.\\nĐể mọi người có một cuộc sống học đường tốt đẹp hơn,\\ntôi sẽ dốc toàn lực hỗ trợ bạn♪",
      "current_fingerprint": "a13208540d82b5d7886bb571be77e6fd9fd19c269483d7a1449a3ed387187274",
      "risk_flags": [
        "very_long_target",
        "locked_term_mismatch"
      ],
      "risk_score": 11,
      "locked_terms": [
        {
          "id": "world.tracen",
