      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1004"
      ],
      "key": null,
      "source_text": "赤红色的超级跑车为父亲的旧车",
      "source_fingerprint": "1efaa56aa98baed0cebefa705b892bd7f0fb464526da5fa5a784ffad71af8c21",
      "current_text": "Chiếc siêu xe màu đỏ thẫm là xe cũ của bố",
