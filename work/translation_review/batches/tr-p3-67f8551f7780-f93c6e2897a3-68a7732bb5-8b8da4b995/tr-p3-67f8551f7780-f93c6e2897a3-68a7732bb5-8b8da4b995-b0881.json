      "entry_index": 74,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1011"
      ],
      "key": null,
      "source_text": "性格受喜欢日本文化的双亲影响。在老家也有和室",
      "source_fingerprint": "66c5ec8428dcbc025efef9f6aac8fb4371b18a42ad50e1647e5ece56baf77f1a",
      "current_text": "Tính cách chịu ảnh hưởng từ bố mẹ yêu thích văn hóa Nhật Bản. Ở nhà cũng có phòng kiểu Nhật",
      "current_fingerprint": "fab46d056d1203fbc3e93ca97d9958f466d01541d0ac2673f7b2f48f691d2fde",
      "risk_flags": [
        "very_long_target"
      ],
