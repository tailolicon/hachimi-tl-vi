      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1010"
      ],
      "key": null,
      "source_text": "老家时常准备着欢迎用烟花",
      "source_fingerprint": "5c25ab0afa61719edbaa0dbf1b3a6e214ef2bda096d9884caa5c74b10bcd8d78",
      "current_text": "Ở quê nhà thường chuẩn bị pháo hoa để chào đón",
