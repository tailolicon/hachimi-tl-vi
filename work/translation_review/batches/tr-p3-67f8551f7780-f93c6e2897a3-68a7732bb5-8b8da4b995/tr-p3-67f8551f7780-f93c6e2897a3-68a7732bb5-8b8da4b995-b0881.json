      "source_batch": 229,
      "entry_index": 68,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1005"
      ],
      "key": null,
      "source_text": "出身于舞台家族，双亲时常全国巡演",
      "source_fingerprint": "d76add5a4474f2d348f00ba2ea44f8d0c105b6f9576a2c132e53533b38bf9447",
      "current_text": "Sinh ra trong một gia đình nghệ thuật sân khấu, bố mẹ thường xuyên lưu diễn khắp cả nước",
      "current_fingerprint": "f6539ec4b7bb33211c9c35cf688a21164fd441d59e95a647387dcaa5996468ff",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
      "source_bridge_risks": [],
      "source_bridge_policy_sha256": null,
      "canonical_findings": [],
      "item_context_sha256": null
    },
    {
      "uid": "zhcn:1e9958977ff4321d07e4e231",
      "source_batch": 229,
      "entry_index": 69,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1006"
      ],
      "key": null,
      "source_text": "说到家族旅行就是去温泉，全家都是某个秘汤的常客",
      "source_fingerprint": "bb5c217a9de0ca714b09350bd1f00d98eb39e2930a7aa2a4fae49c40a89c81f7",
      "current_text": "Mỗi khi cả nhà đi du lịch là lại tới suối nước nóng; cả gia đình là khách quen của một khu suối nước nóng hẻo lánh",
      "current_fingerprint": "3484a9d93873d9efa9035506a94567d46e5b6dd19aaf535e7663b5997d1efa0d",
      "risk_flags": [
        "very_long_target"
      ],
      "risk_score": 3,
      "locked_terms": [],
      "community_terms": [],
      "skill_name_canonical": null,
      "source_bridge_terms": [],
