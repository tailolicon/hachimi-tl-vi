      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1007"
      ],
      "key": null,
      "source_text": "好像是国家级的机密事项",
      "source_fingerprint": "37ba9c320d478abc39b4b7c2019c5b3f5eb9687940b752e7309642f8734919d5",
      "current_text": "Có vẻ là bí mật cấp quốc gia",
      "current_fingerprint": "c7817a370a859145744cf900b3bd4b9a260520a8c752d140206e6c32f8a73f3e",
      "risk_flags": [],
      "risk_score": 0,
