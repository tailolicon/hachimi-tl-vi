    },
    {
      "uid": "zhcn:413e1b93fa465ccf65296930",
      "source_batch": 229,
      "entry_index": 71,
      "kind": "text_data",
      "source_path": "text_data_dict.json",
      "json_path": [
        "169",
        "1008"
      ],
      "key": null,
      "source_text": "经常和父亲一起皮，一起被母亲说教",
      "source_fingerprint": "0affe62134cb1ed66d49bd08718627295a54bfbf7dbfe0ccb0508d5a27b4aeb9",
      "current_text": "Thường nghịch ngợm cùng bố rồi cả hai cùng bị mẹ mắng",
      "current_fingerprint": "3e3b116b432c78885f2df96db8460021845bfd344870ea115938c5908da6b125",
      "risk_flags": [
