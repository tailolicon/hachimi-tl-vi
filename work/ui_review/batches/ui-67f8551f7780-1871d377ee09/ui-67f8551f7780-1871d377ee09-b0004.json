      "source_batch": 3,
      "uid": "zhcn:dea3510b1d1136f71a48016d",
      "current_text": "<atlas=PreIn sprite=utx_ico_notice_00/><color=#ff4400>Ngay cả khi xóa tài khoản, gói đăng ký Umamusume cũng không bị hủy</color>",
      "current_fingerprint": "5f1f1ea4b2c9ce6dba374a950b0038b142ae30179f4d63b1dc1d7ae191c340d3",
