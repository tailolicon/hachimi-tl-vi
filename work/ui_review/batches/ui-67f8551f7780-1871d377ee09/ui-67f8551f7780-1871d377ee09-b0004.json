      "source_batch": 3,
      "uid": "zhcn:589322ef8ef5cbd3e9767c93",
      "current_text": "Thanh Thử thách MAX! Hãy đến <color=#ff911c>Đua Thử thách</color>!",
      "current_fingerprint": "1e79f3f7a7ff3091eb98620c5b1a7aa142c53fd86d54135e69d932616ce69067",
