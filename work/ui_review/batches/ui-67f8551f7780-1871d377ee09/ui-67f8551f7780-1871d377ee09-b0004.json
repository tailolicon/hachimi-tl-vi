        "wide_label"
      ],
      "risk_score": 9
    },
    {
      "key": "ChallengeMatch249004",
      "path": [
        "ChallengeMatch249004"
      ],
      "source_text": "在育成中继承<color=#ff911c>嘉年华BONUS因子</color>\n来获得<color=#ff911c>嘉年华BONUS技能</color>吧！",
      "source_fingerprint": "5b2e179752a523f64c5902f00d5ce1ecb305fd9c67377a41d77cbc01cb602f99",
      "source_batch": 3,
      "uid": "zhcn:ad0a92fafbed8edc596c2f80",
      "current_text": "Trong Huấn luyện, hãy kế thừa <color=#ff911c>Nhân tố Carnival BONUS</color>\nđể nhận <color=#ff911c>Kỹ năng Carnival BONUS</color>!",
      "current_fingerprint": "fe85244019a6ec0a711c537a356818eb2bf0f393c9090d88eaa98e6eb684b7b5",
      "source_visual_width": 13.9,
      "current_visual_width": 27.71,
      "risk_flags": [
        "overflow_risk",
        "slash_compound",
        "wide_label"
      ],
      "risk_score": 9
    },
    {
      "key": "ChallengeMatch249006",
      "path": [
        "ChallengeMatch249006"
      ],
      "source_text": "由于已拥有技能，因子 <color=#ff911c>升级</color>了",
      "source_fingerprint": "4f1cfff460d8535910c2bb9f53e3dfbb3efc5ca88011b7a7927ad482f0d6d49d",
      "source_batch": 3,
      "uid": "zhcn:d78109f516918dd0ff4350bf",
      "current_text": "Vì đã sở hữu kỹ năng, Nhân tố đã được <color=#ff911c>nâng cấp</color>",
      "current_fingerprint": "80420b315f2d8df28dcb893d8e88f46b17621ed21cbcbe5e4ca8367895306453",
      "source_visual_width": 12.71,
      "current_visual_width": 23.73,
      "risk_flags": [
        "overflow_risk",
        "slash_compound",
        "wide_label"
      ],
      "risk_score": 9
    },
    {
      "key": "ChallengeMatch408011",
      "path": [
        "ChallengeMatch408011"
      ],
      "source_text": "参加嘉年华比赛积累<color=#ff911c>挑战量表</color>吧！",
      "source_fingerprint": "c0c03c2d04246abed76431138c14fa551f676cd841f1ee56a1cbaecd4b010a62",
      "source_batch": 3,
      "uid": "zhcn:df135786e520a063aa96ae55",
      "current_text": "Hãy tham gia Đua Carnival để tích lũy <color=#ff911c>Thanh Thử thách</color>!",
      "current_fingerprint": "06e32d02cf3b9a21d7853c5953edf05b388714b643ffd118890bf4626b0bf218",
      "source_visual_width": 14.38,
      "current_visual_width": 28.62,
      "risk_flags": [
        "overflow_risk",
