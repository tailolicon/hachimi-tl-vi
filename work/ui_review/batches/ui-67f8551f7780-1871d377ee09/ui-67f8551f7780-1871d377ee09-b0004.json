    {
      "key": "AccoutDataLink608018",
      "path": [
        "AccoutDataLink608018"
      ],
      "source_text": "<color=#ff4400>如需与其他平台绑定，\n当前平台购买的付费宝石将无法同步</color>",
      "source_fingerprint": "dc0eed7cacb0a1015ad7880bc724e5b76dfa9873a61d8699c333eaf5de01e1f4",
      "source_batch": 3,
      "uid": "zhcn:b608677975670e0f002c0727",
      "current_text": "<color=#ff4400>Nếu liên kết với nền tảng khác,\nNgọc trả phí mua trên nền tảng hiện tại sẽ không được đồng bộ</color>",
      "current_fingerprint": "b42d06996996f67b90ff372791c2474ed8c6ed1ddcd9c4efb0f01b1a5a70fdac",
      "source_visual_width": 16.0,
      "current_visual_width": 32.13,
      "risk_flags": [
        "overflow_risk",
