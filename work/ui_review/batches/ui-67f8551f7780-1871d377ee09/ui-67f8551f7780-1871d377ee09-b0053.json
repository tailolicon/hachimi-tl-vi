  "items": [
    {
      "key": "Heroes467005",
      "path": [
        "Heroes467005"
      ],
      "source_text": "为了领取奖励，是否启动浏览器\n访问官方网站？",
      "source_fingerprint": "98df875013d42adc6e40ae1a5f8f96f88f1bd1a4617bcbeb5db0eea9582dc917",
      "source_batch": 25,
      "uid": "zhcn:49af9085e3605f2bd5ef26f3",
      "current_text": "Để nhận phần thưởng, bạn có muốn mở trình duyệt\nvà truy cập trang web chính thức không?",
      "current_fingerprint": "8181bc78f61def2392db94b7fac39586487166cc0702600be035665d423eaa5b",
      "source_visual_width": 13.38,
      "current_visual_width": 24.81,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes467009",
      "path": [
        "Heroes467009"
      ],
      "source_text": "请务必不要将网站链接\n泄露给他人",
      "source_fingerprint": "cfabdc76f0b21bc089b6e54bf1dc9775371a387450b9fb0920fc0f738a26046d",
      "source_batch": 25,
      "uid": "zhcn:c8adbcd6a52cf202d40c26ab",
      "current_text": "Vui lòng tuyệt đối không để lộ liên kết trang web\ncho người khác",
      "current_fingerprint": "3e30268a2684cf40fd362c1882451d50f9b0b7f96d1f33006baf09038f86c38c",
      "source_visual_width": 10.0,
      "current_visual_width": 25.92,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes497001",
      "path": [
        "Heroes497001"
      ],
      "source_text": "可随时在队伍编组中修改队伍名",
      "source_fingerprint": "5e3aacc804141450baab49c1a23d47507e08ac4afb47e0f724774f13b6519aba",
      "source_batch": 25,
      "uid": "zhcn:6000c7e5e7eb5abc5f8cae7e",
      "current_text": "Có thể đổi tên đội bất cứ lúc nào trong phần lập đội",
      "current_fingerprint": "9173e41ddaab994bea9e4d93318e54f6de93d7cf27e92237ec8de01c646f9b1e",
      "source_visual_width": 14.0,
      "current_visual_width": 27.16,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes510000",
      "path": [
        "Heroes510000"
      ],
      "source_text": "{0}集团 第{1}场比赛参赛",
      "source_fingerprint": "23431f91153d2a0ae18a64f5eb466f485cf25c01a206e3713602f5c9f71ba9a7",
      "source_batch": 25,
      "uid": "zhcn:688112f0f3e7ef4a32a0b466",
      "current_text": "Tham gia Nhóm {0}, Cuộc đua thứ {1}",
      "current_fingerprint": "f27abcc9bc31bbf92230062d544991bd88fb2f5e2a6932b69831bd304e5b7934",
      "source_visual_width": 9.49,
      "current_visual_width": 16.03,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511004",
      "path": [
        "Heroes511004"
      ],
      "source_text": "已被编入英雄联赛中，无法移籍",
      "source_fingerprint": "7d0b213c6692277fa2749ba752662cb8d722408d4515fc7beb69a27f0501340c",
      "source_batch": 25,
      "uid": "zhcn:8c2dad18505f12365d5e84fc",
      "current_text": "Đã được xếp vào Hero League nên không thể chuyển nhượng",
      "current_fingerprint": "bb0c5935ad70a9a15a70dc4858a64c8ef8073963e07f9a19dead8bd87b2c8234",
      "source_visual_width": 13.38,
      "current_visual_width": 29.4,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511009",
      "path": [
        "Heroes511009"
      ],
      "source_text": "积累英雄量表\n来让活动形势对我方有利吧！",
      "source_fingerprint": "f8b798b04fb5f33eb0c55c675410caa81a9cce8de83857fd523af52f8edb7933",
      "source_batch": 25,
      "uid": "zhcn:e66067082a3d8281d3021589",
      "current_text": "Tích lũy Thanh Anh hùng\nđể tạo lợi thế cho phe ta trong sự kiện!",
      "current_fingerprint": "11fac57062bb317a574cc774f135706e2d708bee98dc79100682a04be500b694",
      "source_visual_width": 12.38,
      "current_visual_width": 20.75,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511010",
      "path": [
        "Heroes511010"
      ],
      "source_text": "英雄量表获得量",
      "source_fingerprint": "3f26becfe65f68621f614cde349f47aaabffd92d8c079543ada793e88e52dd08",
      "source_batch": 25,
      "uid": "zhcn:9021e60eedbb83e8e22b62dc",
      "current_text": "Lượng Thanh Anh hùng nhận được",
      "current_fingerprint": "826b67a689ee5ff2dca5163fa9a750f9c9094117aef8bc279797f06f2e8e2338",
      "source_visual_width": 7.0,
      "current_visual_width": 16.15,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511012",
      "path": [
        "Heroes511012"
      ],
      "source_text": "排名的显示有时会耗费一定时间",
      "source_fingerprint": "39fbc720d8309ad990c4e7c2396d958c58214a0bd469b93e89fbb80592b07de5",
      "source_batch": 25,
      "uid": "zhcn:64ad08d4529e01290d724486",
      "current_text": "Việc hiển thị xếp hạng đôi khi có thể mất một chút thời gian",
      "current_fingerprint": "1d50eec04a7738e5a86890822cb3a67ef9e5e49ce7a449fac690df9122a7b113",
      "source_visual_width": 14.0,
      "current_visual_width": 31.55,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511017",
      "path": [
        "Heroes511017"
      ],
      "source_text": "自动使用英雄技能对应道具",
      "source_fingerprint": "e16550f6621852f13f89ae239bee2649593c6e69a330a146e0db6e5232c20efe",
      "source_batch": 25,
      "uid": "zhcn:d7c7545feb6ae66b34b2fe9b",
      "current_text": "Tự động dùng vật phẩm tương ứng với Kỹ năng Anh hùng",
      "current_fingerprint": "7cae11b35fb709c9a5ac671465baedf31b909c9c3c929d942f39d134fee131f7",
      "source_visual_width": 12.0,
      "current_visual_width": 27.41,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511022",
      "path": [
        "Heroes511022"
      ],
      "source_text": "确定以当前成员和作战策略\n来编组吗？",
      "source_fingerprint": "45b50ebc992a0ae375880113ad833aec3548199c8dd9239d94c2eb219befe0a0",
      "source_batch": 25,
      "uid": "zhcn:10b7e63b15e131fa27b2e3f8",
      "current_text": "Bạn muốn lập đội với thành viên và chiến thuật hiện tại\nkhông?",
      "current_fingerprint": "b7b1faf5bf5f472e1865780c81cb8a5772a49e62e626c621a0d00db58eaf6ae7",
      "source_visual_width": 12.0,
      "current_visual_width": 29.15,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511023",
      "path": [
        "Heroes511023"
      ],
      "source_text": "设为OFF后，将不能参加\n特别阶段的比赛",
      "source_fingerprint": "de9c37c8ab6928eac27da78c53dbf819fc3ae331ba15f8ea67c706cfb88ffac3",
      "source_batch": 25,
      "uid": "zhcn:107d05830d3b94cb7e573993",
      "current_text": "Sau khi đặt OFF, bạn sẽ không thể tham gia\ncuộc đua Giai đoạn đặc biệt",
      "current_fingerprint": "7a9bc88790f72a4fe7d5ce936e882a31f14e6f63cc0f7d22df7e723b0ece3e9b",
      "source_visual_width": 10.12,
      "current_visual_width": 21.91,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511024",
      "path": [
        "Heroes511024"
      ],
      "source_text": "可确认有关英雄联赛的\n各种信息",
      "source_fingerprint": "cb6c8b0c01f2aba1d0cb8eabb447103c543027a05ed6cd5b222051ec5c23bcf1",
      "source_batch": 25,
      "uid": "zhcn:a12dec31d180a6038fa958af",
      "current_text": "Có thể kiểm tra nhiều thông tin khác nhau\nvề Hero League",
      "current_fingerprint": "bc820ada39aa62f450b17193e8a9a1f5e442c887b97216d1d95db84f9b2dde4e",
      "source_visual_width": 10.0,
      "current_visual_width": 21.78,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511029",
      "path": [
        "Heroes511029"
      ],
      "source_text": "联赛等级达到PLATINUM1的话，将可以获得\n含有特定赛马娘名字的活动限定称号！",
      "source_fingerprint": "7730306bc40a26cd561e810408df2392b5590f7441eab67a1559e58eb772c38b",
      "source_batch": 26,
      "uid": "zhcn:bf7aa4e4ecf96e698854d9bf",
      "current_text": "Khi Hạng Liên đoàn đạt PLATINUM1, bạn có thể nhận\ndanh hiệu giới hạn sự kiện có tên của một Uma Musume cụ thể!",
      "current_fingerprint": "6e836925bbb0723134f944d60f3b7ca3305ef57b68997a0675c8924bfa6fab32",
      "source_visual_width": 18.6,
      "current_visual_width": 31.35,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511030",
      "path": [
        "Heroes511030"
      ],
      "source_text": "可选择称号「英雄奇谭」的赛马娘的条件",
      "source_fingerprint": "7de093901082b7bba62030f8630e9dff7cd409863bea1cf931ee6ff0acfd644b",
      "source_batch": 26,
      "uid": "zhcn:42a69bdb6ed0f0ab15aed0ec",
      "current_text": "Điều kiện để chọn Uma Musume cho danh hiệu「Anh Hùng Kỳ Đàm」",
      "current_fingerprint": "2c3d672e10770ada8e4d805dd958bdc283890dca951b1809dfc6362af32ebf3a",
      "source_visual_width": 16.76,
      "current_visual_width": 31.07,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511031",
      "path": [
        "Heroes511031"
      ],
      "source_text": "可选择满足下列①②中任意一个条件的赛马娘",
      "source_fingerprint": "fb080554cd2bdecf79925761fcaa00e033570e1db6cb88ff6db791ef5fa8d500",
      "source_batch": 26,
      "uid": "zhcn:421491371c5a3ca1eef25c3a",
      "current_text": "Có thể chọn Uma Musume đáp ứng một trong hai điều kiện ① hoặc ② dưới đây",
      "current_fingerprint": "4030269cbc9cdd143c7794cb57608fbcfa44dcadb4a6c393de135a3ce2dbdd7b",
      "source_visual_width": 19.16,
      "current_visual_width": 37.76,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511043",
      "path": [
        "Heroes511043"
      ],
      "source_text": "排名TOP96的队伍可以参加\n特别阶段的比赛",
      "source_fingerprint": "5d758780872e6618e6c8ba72ba3db05971c573ff2a6b491566c312d0a6cf7197",
      "source_batch": 26,
      "uid": "zhcn:6f64b22f3946c5be875cbe91",
      "current_text": "Các đội trong TOP 96 xếp hạng có thể tham gia\ncác cuộc đua Extra Stage",
      "current_fingerprint": "0aefbb0eb771faef77f449375c96107d0d1abb4f9cc0d3bd90464ba47620c06d",
      "source_visual_width": 11.9,
      "current_visual_width": 23.6,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511044",
      "path": [
        "Heroes511044"
      ],
      "source_text": "每一局从各个种类中最多可获得5个奖励",
      "source_fingerprint": "e52d3878e1493c90d170678a229027d67e2a798196501848a3921cee36389beb",
      "source_batch": 26,
      "uid": "zhcn:d3c3b98fd94d8e2785b557a1",
      "current_text": "Mỗi lượt có thể nhận tối đa 5 phần thưởng của từng loại",
      "current_fingerprint": "ff62b5d4163c6bb8bf3f084c4d18b9a05e9f59bae56627a0f7a98e5ddd8a5fab",
      "source_visual_width": 17.58,
      "current_visual_width": 28.9,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511045",
      "path": [
        "Heroes511045"
      ],
      "source_text": "称号「英雄奇谭」可于主要阶段排名发表后获得\n称号中可填入符合条件的「赛马娘」的名字",
      "source_fingerprint": "c01919ac92a7a5ab16cc8bbff08ed8fb6fe00240a8eb925b6538fa4a69ee2865",
      "source_batch": 26,
      "uid": "zhcn:63f5dca6c3a36b887d62be96",
      "current_text": "Có thể nhận danh hiệu「Anh Hùng Kỳ Đàm」sau khi công bố xếp hạng Main Stage\nCó thể điền tên của「Uma Musume」đủ điều kiện vào danh hiệu",
      "current_fingerprint": "66a919ef4c4a8ace32e6b3e6cc4cabe8c467fc4b5cfb02a4d010424d579b9b6c",
      "source_visual_width": 19.76,
      "current_visual_width": 38.44,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511047",
      "path": [
        "Heroes511047"
      ],
      "source_text": "同一名赛马娘不可多次获得",
      "source_fingerprint": "37eb66838ed559aec33ef4c3fe5b3b1ce8920c2f3313809f8b03f62035a1e04c",
      "source_batch": 26,
      "uid": "zhcn:77cd7cb22c07ee96589748ef",
      "current_text": "Cùng một Uma Musume không thể nhận nhiều lần",
      "current_fingerprint": "cd37b567e78594116e7c608a63b70cf2121feeb349dc9c9a872aa7dff1611b82",
      "source_visual_width": 12.0,
      "current_visual_width": 23.52,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Heroes511048",
      "path": [
        "Heroes511048"
      ],
      "source_text": "接受马赞期间内，可通过点马赞来获得",
      "source_fingerprint": "a3a29343c5083d50395a33a855418e2704b3cb3f9fcc4c907c95f0f670c13963",
      "source_batch": 26,
      "uid": "zhcn:bba01271fc173f8f3e16d135",
      "current_text": "Có thể nhận bằng cách nhấn Uma Like! trong thời gian tiếp nhận Uma Like!",
      "current_fingerprint": "6305f82b63b1139a6180b71ca951c55a620e936f11c4316e7b7dbbbd6e91baf9",
      "source_visual_width": 16.38,
      "current_visual_width": 37.86,
      "risk_flags": [
        "overflow_risk",
