    },
    {
      "key": "Race0018",
      "path": [
        "Race0018"
      ],
      "source_text": "相同跑法中瞄准第一名",
      "source_fingerprint": "1a291a1b0d8b30c149b09be1d5aefe383ec83dc7bd38d966547771679a5a2b8f",
      "source_batch": 51,
      "uid": "zhcn:52a1dc7ed67f89ae61d4075c",
