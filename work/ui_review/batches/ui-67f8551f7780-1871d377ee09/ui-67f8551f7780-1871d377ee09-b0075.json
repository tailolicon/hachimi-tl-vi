        "Race0015"
      ],
      "source_text": "不能变更其他赛马娘的作战设定",
      "source_fingerprint": "744e578901f0ba6a976a3b69f8132db97483d3b05d8c5fb7cb5bebddc88c9108",
      "source_batch": 51,
      "uid": "zhcn:b4492cecedbce225ef298bc6",
      "current_text": "Không thể thay đổi chiến thuật của Uma Musume khác",
