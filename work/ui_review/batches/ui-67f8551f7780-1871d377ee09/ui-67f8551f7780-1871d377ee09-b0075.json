    },
    {
      "key": "Race0032",
      "path": [
        "Race0032"
      ],
      "source_text": "比赛中的音量设定",
      "source_fingerprint": "7084c3016ac649605272de325c2e382b6cde2c0f6dced1dc28cec1c8706e6869",
      "source_batch": 51,
      "uid": "zhcn:4bb0ce3eed3636543fb3b630",
      "current_text": "Cài đặt âm lượng trong cuộc đua",
      "current_fingerprint": "8ab7e3f51cf69b77f5cf970d4e4abe68b8f98a53eb6b9806849593fcf22d91e7",
      "source_visual_width": 8.0,
      "current_visual_width": 16.48,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0078",
      "path": [
        "Race0078"
      ],
      "source_text": "可以获得才能开花所需的\n特殊碎片。",
      "source_fingerprint": "a16b3aff8415aaf626bc56e2371fabcf887da9ecf5f561030a20f576d8b0bccc",
      "source_batch": 51,
      "uid": "zhcn:4b7405ec29db85bed7c5fdf8",
      "current_text": "Có thể nhận Mảnh đặc biệt cần thiết\ncho Khai hoa tài năng.",
      "current_fingerprint": "8037c1ece034491fc83fb5150f748d99c2fd09ab73028944876ae02aead4ed35",
      "source_visual_width": 11.0,
      "current_visual_width": 18.55,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0080",
      "path": [
        "Race0080"
      ],
      "source_text": "本日可购买次数达到上限",
      "source_fingerprint": "5bfdafb3c1fc50f8a1120ef29db5f907a219c6f7982ee4d6400ceda6103c7aa0",
      "source_batch": 51,
      "uid": "zhcn:73a40ff7a26c62b800e3c632",
      "current_text": "Đã đạt giới hạn số lần mua hôm nay",
      "current_fingerprint": "c77a74d375819394cbc25e7f50cd10d6f1a0d3988a423591d123291f88eeadd4",
      "source_visual_width": 11.0,
      "current_visual_width": 17.72,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0089",
      "path": [
        "Race0089"
      ],
      "source_text": "在集团最后方保存体力\n在最后的直线上决定胜负",
      "source_fingerprint": "8529510506a1e0806c83347b381555f147cf4554a2420af030a83c19906fde49",
      "source_batch": 51,
      "uid": "zhcn:9b2f93c5113cf3d65445db61",
      "current_text": "Giữ thể lực ở cuối đoàn\nquyết định thắng bại trên đoạn thẳng cuối",
      "current_fingerprint": "a49f1617e293f5dc87133a6b17b71fd6b3b2c9bd9cdee3422cff01cb20bdc979",
      "source_visual_width": 11.0,
      "current_visual_width": 22.03,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0091",
      "path": [
        "Race0091"
      ],
      "source_text": "途中处于集团中间位置\n终点前加速冲到最前方",
      "source_fingerprint": "a8ea95bb5d5aa61ff0be041c79df73ce26716821d4a8e844cfc2c41f10cd915c",
      "source_batch": 51,
      "uid": "zhcn:4d3bac861d7f36139234fe87",
      "current_text": "Giữ vị trí giữa đoàn trong suốt cuộc đua\ntăng tốc lên phía trước trước vạch đích",
      "current_fingerprint": "7915f1c70fead7196a68dd5b20a4ed03492c952d698c35a3770bfbeb23ec4bc5",
      "source_visual_width": 10.0,
      "current_visual_width": 21.2,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0092",
      "path": [
        "Race0092"
      ],
      "source_text": "尽量跟紧前方\n努力保持领先",
      "source_fingerprint": "bef4fa773d49eab883aaa684ea7b2a0322590dff29e684e3d5391bdd99a59d9e",
      "source_batch": 51,
      "uid": "zhcn:c5b3a8042bc5c955ee323ddd",
      "current_text": "Bám sát nhóm đầu\ncố gắng duy trì vị trí dẫn trước",
      "current_fingerprint": "7add4253c0e94d9c428adfaa633fe5ed28a57eb2c4340c176c8afe4a75322813",
      "source_visual_width": 6.0,
      "current_visual_width": 16.81,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0095",
      "path": [
        "Race0095"
      ],
      "source_text": "作战策略交给赛马娘",
      "source_fingerprint": "4683b9276d6174aeb2959898215904506b51e949c5f6857e22cddfeca2f0d2eb",
      "source_batch": 51,
      "uid": "zhcn:88a89b28d66491f5dce5f63e",
      "current_text": "Để Uma Musume tự quyết định chiến thuật",
      "current_fingerprint": "c0fc257da14f22b699016ade4c23ee7b8e64a1f519bd68ea372901ad2fc7a9d8",
      "source_visual_width": 9.0,
      "current_visual_width": 20.87,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0096",
      "path": [
        "Race0096"
      ],
      "source_text": "恭喜获胜！　主线故事中的\n比赛可以重复挑战哦。",
      "source_fingerprint": "cf9f612f9a619162ddfa4e61b6a8748f7d4ca13fd874678fff8b3cbb896d8b61",
      "source_batch": 51,
      "uid": "zhcn:946bb9c9d70c4b93adc05a9f",
      "current_text": "Chúc mừng chiến thắng! Các cuộc đua trong Cốt truyện chính\ncó thể được thử lại nhiều lần.",
      "current_fingerprint": "b686d004b2b9fe57e2938a6326cf5aad9b8c3996536cd235538c67bb471b020b",
      "source_visual_width": 10.71,
      "current_visual_width": 30.94,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0097",
      "path": [
        "Race0097"
      ],
      "source_text": "没能夺冠，真可惜啊。不过可以重复参赛\n也用其他殿堂赛马娘挑战一下吧。",
      "source_fingerprint": "cd852b0bd74074d5f89f71b9a25afb3038686f5f65047e15b641897306fb753b",
      "source_batch": 51,
      "uid": "zhcn:425145bb548a27a4b58552d1",
      "current_text": "Tiếc là chưa thể giành chức vô địch. Nhưng bạn có thể tham gia lại\nvà thử thách bằng Uma Musume Đại sảnh Danh vọng khác.",
      "current_fingerprint": "7f98c9f77aeb89a6ece50cc55e94bfc1c36c14532ca3c0481b9b94e3623a8c8a",
      "source_visual_width": 16.76,
      "current_visual_width": 34.58,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0336",
      "path": [
        "Race0336"
      ],
      "source_text": "不在可参赛的时间",
      "source_fingerprint": "1d853e346cdfece4462a8dd6ccc78a9df8559484d486328a175b58f3b5d997b6",
      "source_batch": 52,
      "uid": "zhcn:16aa3b1b671bf47a659fc507",
      "current_text": "Ngoài thời gian có thể tham gia đua",
      "current_fingerprint": "468642beb7ab6d6dc26be1979670eab2add0cff561360f8e760f69f1c56763ae",
      "source_visual_width": 8.0,
      "current_visual_width": 18.55,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0460",
      "path": [
        "Race0460"
      ],
      "source_text": "真是一场精彩的比赛呢！　粉丝和队友的应援\n也提供了力量，跑的很棒呢。",
      "source_fingerprint": "1d4bf8c9dcc7dfae46373d7f2d36b464e00eed2077c46fe6eaa1f6b61d33e187",
      "source_batch": 52,
      "uid": "zhcn:462db4449b3fa09fbb847e4a",
      "current_text": "Quả là một cuộc đua tuyệt vời! Sự cổ vũ của người hâm mộ và đồng đội\ncũng tiếp thêm sức mạnh, chạy rất tốt đấy.",
      "current_fingerprint": "d9ac53fe168081f4c49fa1a5bf34a7268a9bbe12105d07356f5dce4f986f6ad4",
      "source_visual_width": 18.71,
      "current_visual_width": 35.24,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0461",
      "path": [
        "Race0461"
      ],
      "source_text": "虽然没能获得第一，但这是一场\n引发观众热烈欢呼的精彩比赛。",
      "source_fingerprint": "55937b8b1447d8fdd0921f2d9a5d42dc8cea193f5a470ed04e81d172a5ca3316",
      "source_batch": 52,
      "uid": "zhcn:802949a85c07cb55afd0e1c0",
      "current_text": "Dù không giành được hạng nhất, nhưng đây là một cuộc đua tuyệt vời\nkhiến khán giả reo hò nhiệt liệt.",
      "current_fingerprint": "cbd96bea2badf4a01cc962206c712bb31b591fc70e2132a3e3f9b0fed617b318",
      "source_visual_width": 13.38,
      "current_visual_width": 34.83,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0462",
      "path": [
        "Race0462"
      ],
      "source_text": "真是一场精彩的比赛呢！　这是队伍中的\n大家努力奔跑的结果呢。",
      "source_fingerprint": "a8a43659efdce4a216267355d5bd7d7ae95fb766b068b7c28f3339167da7fc91",
      "source_batch": 52,
      "uid": "zhcn:7045f01581afa3c544d7f594",
      "current_text": "Quả là một cuộc đua tuyệt vời! Đây là thành quả\ncủa tất cả mọi người trong đội đã nỗ lực chạy hết mình.",
      "current_fingerprint": "7be308d53bca851b69bed09b635d85a07810e4c7a5b4fc6da187be045ba72437",
      "source_visual_width": 16.71,
      "current_visual_width": 28.7,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0463",
      "path": [
        "Race0463"
      ],
      "source_text": "虽然错过了第1名，但是得到了观众的热烈欢呼\n也算一场不错的比赛呢。",
      "source_fingerprint": "72c2c306f7df3cb4085a7b57761fe3f4a0e5de8013b1f7ec08d8cbf5d4b1a478",
      "source_batch": 52,
      "uid": "zhcn:0613fe40565042dddd9d22b8",
      "current_text": "Dù bỏ lỡ hạng nhất, nhưng đã nhận được những tiếng reo hò nhiệt liệt từ khán giả\nnên vẫn là một cuộc đua khá tốt đấy.",
      "current_fingerprint": "5d6b6a466305ba4bd509a2e1829b3ec27bb153b2585fcc056ffbc5c7716044ff",
      "source_visual_width": 19.96,
      "current_visual_width": 41.95,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0464",
      "path": [
        "Race0464"
      ],
      "source_text": "非常不错的比赛呢！\n也期待更广阔的世界的比赛吧。",
      "source_fingerprint": "252e6f2f8d0a92e19eb744a07979cdf9f0c0491abf67ddbcd729ae494f43a9ee",
      "source_batch": 52,
      "uid": "zhcn:b046129af8e98420da711a52",
      "current_text": "Một cuộc đua rất tốt!\nHãy cùng chờ đón những cuộc đua ở một thế giới rộng lớn hơn nữa.",
      "current_fingerprint": "897d9071e7a3bf536d45f35d11efdda26e9b7c4c0eee6f180ba5dacf7835f4a0",
      "source_visual_width": 13.38,
      "current_visual_width": 33.42,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    }
  ]
}
