{
  "schema_version": 1,
  "plan_id": "ui-67f8551f7780-1871d377ee09",
  "batch_id": "ui-67f8551f7780-1871d377ee09-b0076",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "items": [
    {
      "key": "Race0465",
      "path": [
        "Race0465"
      ],
      "source_text": "虽然失败很可惜，但我认为我们面对这些对手\n已经有足够的实力了。",
      "source_fingerprint": "56b7575b345eed4d66041d789f66c005c4aeae155680e2f390907eea44291393",
      "source_batch": 52,
      "uid": "zhcn:5fa66f56d776e95db2da7f3b",
      "current_text": "Thất bại thật đáng tiếc, nhưng tôi nghĩ trước những đối thủ này\nchúng ta đã thể hiện đủ thực lực rồi.",
      "current_fingerprint": "396eb7bb34ac2c6b96ab3deeb490474da006e0b46b81838e8a535fe3c75700a6",
      "source_visual_width": 19.38,
      "current_visual_width": 33.34,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0466",
      "path": [
        "Race0466"
      ],
      "source_text": "恭喜获胜！与强大的赛马娘对手们\n进行了一场精彩的比赛呢。",
      "source_fingerprint": "8ac79a32d7cad8f63bf561ad8e94ab83f1a09a00c28e6ed8d2fdb9ee619ab4a1",
      "source_batch": 52,
      "uid": "zhcn:6b8ae75eb378408bb2432d9f",
      "current_text": "Chúc mừng chiến thắng! Đó là một cuộc đua tuyệt vời\nvới những Uma Musume đối thủ rất mạnh.",
      "current_fingerprint": "8a8802d443d2097c3318263f71e4fe4473267593b6415f03d3097fd5fdde9392",
      "source_visual_width": 14.38,
      "current_visual_width": 26.88,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0479",
      "path": [
        "Race0479"
      ],
      "source_text": "恭喜！\n积累平时的胜利是很重要的。",
      "source_fingerprint": "f69cdaddbbc0631e4f84559e9e783c300ccb44492b3243d39de3d88908273bbc",
      "source_batch": 52,
      "uid": "zhcn:7bcb5d17761bf3e9ecdd370f",
      "current_text": "Chúc mừng!\nTích lũy những chiến thắng thường ngày là điều rất quan trọng.",
      "current_fingerprint": "fd6f801d7961f0c33bebbb192d25a5047382be3985d095451ae23ebe451ee48d",
      "source_visual_width": 12.38,
      "current_visual_width": 33.01,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0480",
      "path": [
        "Race0480"
      ],
      "source_text": "就差一点点了呢。但也从失败中学到了东西\n将其活用到下次比赛吧。",
      "source_fingerprint": "4f807df8f579ff22ae37a465aefee74e89846e949fe68a09cab1a676416bd986",
      "source_batch": 52,
      "uid": "zhcn:76173ee232d16c0bf738aa85",
      "current_text": "Chỉ thiếu một chút thôi. Nhưng cũng đã học được điều gì đó từ thất bại\nhãy vận dụng vào cuộc đua tiếp theo.",
      "current_fingerprint": "7dfb09a8f45144997219c28570d387e168862d3693a229ce1300c5eca0bc5dbc",
      "source_visual_width": 18.38,
      "current_visual_width": 36.65,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0481",
      "path": [
        "Race0481"
      ],
      "source_text": "恭喜获胜！　能在有强大对手参赛的比赛中\n获胜是很了不起的。",
      "source_fingerprint": "4f6529f68eeaf560ef517d844190a30110bf27fe13cd9c316159f67eca6c9b12",
      "source_batch": 52,
      "uid": "zhcn:c7c1cbd13408e206939ef86c",
      "current_text": "Chúc mừng chiến thắng! Có thể giành chiến thắng trong cuộc đua\ncó những đối thủ mạnh tham gia thật sự rất đáng nể.",
      "current_fingerprint": "75e60d6f62448f274f2b5125302b06404341d66f834d9efe2abc4085cabbba40",
      "source_visual_width": 17.71,
      "current_visual_width": 33.01,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0482",
      "path": [
        "Race0482"
      ],
      "source_text": "让优胜逃走了呢。\n在有强敌的情况下战斗能够增强自信呢！",
      "source_fingerprint": "9b3c6cbbf6b47bdc4b4211c9476a077b9612999834843b152cf4dea1e27b73e5",
      "source_batch": 52,
      "uid": "zhcn:fcd5e3847e3f74ab0c9a262e",
      "current_text": "Đã để vuột mất chiến thắng.\nĐược thi đấu khi có đối thủ mạnh sẽ giúp tăng thêm tự tin!",
      "current_fingerprint": "ac8b03d3f0114f0284b93ac956954f63fc99a8d13443f12c0217b1c4ef1d2924",
      "source_visual_width": 17.38,
      "current_visual_width": 30.19,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0484",
      "path": [
        "Race0484"
      ],
      "source_text": "恭喜取得初次胜利！\n千里之行始于足下，新的传说开始了呢。",
      "source_fingerprint": "bc90f0ef9354891be57bdc628a4606a12760fac3ce1b4afdba949f3978f7b48b",
      "source_batch": 52,
      "uid": "zhcn:35e2bc92fc4e9f44845af45e",
      "current_text": "Chúc mừng chiến thắng đầu tiên!\nHành trình ngàn dặm bắt đầu từ một bước chân, một huyền thoại mới đã bắt đầu.",
      "current_fingerprint": "e77f5c63779895a1a4d3efaf3bbd2e678783f6fe9212c8b6de319a9b538a9207",
      "source_visual_width": 16.76,
      "current_visual_width": 40.26,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0485",
      "path": [
        "Race0485"
      ],
      "source_text": "恭喜！\n保持这种状态继续取胜吧。",
      "source_fingerprint": "5f5cdf47161d9121478e54ed301c4519731427fe5ea5984eb057e36bf2725599",
      "source_batch": 52,
      "uid": "zhcn:85849403833cf78e8cf05646",
      "current_text": "Chúc mừng!\nHãy giữ phong độ này và tiếp tục giành chiến thắng.",
      "current_fingerprint": "ce0d14f6dcfe7e2cb11eebeb8a11a7b8c4ba5ac8b8e56feeee289896875c5697",
      "source_visual_width": 11.38,
      "current_visual_width": 26.88,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0486",
      "path": [
        "Race0486"
      ],
      "source_text": "干的不错呢！\n继续以优胜为目标加油吧！",
      "source_fingerprint": "a7deb906bd97ebac55310fb4384bdbff1bf9b393b6cd294cd88535ce10963a88",
      "source_batch": 52,
      "uid": "zhcn:f55a45f41b8167c046b17749",
      "current_text": "Làm rất tốt!\nHãy tiếp tục cố gắng hướng tới chiến thắng!",
      "current_fingerprint": "de450c69b6373e493a89240f3cafcf29869699bb518a4e151ce1f4d23f2936c4",
      "source_visual_width": 11.38,
      "current_visual_width": 22.74,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0487",
      "path": [
        "Race0487"
      ],
      "source_text": "恭喜获胜！　在强力赛马娘云集\n的比赛中取得了漂亮的胜利呢。",
      "source_fingerprint": "13a1a9bb0a8eaa95054fb72232cb33c829fc95fc409a0e340d951d5935d06902",
      "source_batch": 52,
      "uid": "zhcn:2b07280c4b376c297e81173e",
      "current_text": "Chúc mừng chiến thắng! Trong cuộc đua quy tụ\nnhững Uma Musume mạnh, đã giành được một chiến thắng thật đẹp.",
      "current_fingerprint": "e58c89bf4796d3dc9d52775fa32c92ef0f9bc0aa49613508ef2cb304253d7d11",
      "source_visual_width": 13.38,
      "current_visual_width": 32.81,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0490",
      "path": [
        "Race0490"
      ],
      "source_text": "就差一点了呢。虽然胜负的世界很残酷，\n但今后还有很长的路呢。",
      "source_fingerprint": "e2cd3e2038e12224cf4936adc2e07acaae03284b9f4062723e041a8608ab3ad8",
      "source_batch": 52,
      "uid": "zhcn:e304df2b6e93c70aa5347c2b",
      "current_text": "Chỉ thiếu một chút nữa thôi. Dù thế giới thắng thua rất khắc nghiệt,\nnhưng phía trước vẫn còn một chặng đường dài.",
      "current_fingerprint": "63210d26721659b23daf81a51e581af247006dd1fecc07f4192a23b607fe0881",
      "source_visual_width": 16.76,
      "current_visual_width": 35.79,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0491",
      "path": [
        "Race0491"
      ],
      "source_text": "虽然差一点就能取得胜利，\n但这是一场能够连接下一场的好比赛呢。",
      "source_fingerprint": "a7b4b78315ffafbe3e36218937e8e13c1ad6df2f0ae3b0135639e142f96e2783",
      "source_batch": 52,
      "uid": "zhcn:c233787ac2c934102dfba9cf",
      "current_text": "Dù chỉ thiếu một chút nữa là giành chiến thắng,\nnhưng đây là một cuộc đua tốt tạo đà cho lần tiếp theo.",
      "current_fingerprint": "eb6ed722c99cc4f51295a7150eb3357ca51b8819c4b033ef03da5c7dfcdd0978",
      "source_visual_width": 17.38,
      "current_visual_width": 28.7,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0492",
      "path": [
        "Race0492"
      ],
      "source_text": "离胜利还有一点距离呢。虽然结果有点遗憾\n但也显示出了实力吧。",
      "source_fingerprint": "4ad35d3014a41755ec060c113d4c1373128d301e9d5c6b67a57880fa79e272a2",
      "source_batch": 52,
      "uid": "zhcn:8ab8a1affad97e03b7b84f1f",
      "current_text": "Vẫn còn một chút khoảng cách đến chiến thắng. Dù kết quả hơi đáng tiếc\nnhưng cũng đã thể hiện được thực lực.",
      "current_fingerprint": "31f8b90ba9d8ab2ba7a801b5062c4693ba515a89854c6232f5f0c04261e7edda",
      "source_visual_width": 18.38,
      "current_visual_width": 36.9,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0493",
      "path": [
        "Race0493"
      ],
      "source_text": "非常可惜。虽然错过了优胜\n但比赛很充实呢。",
      "source_fingerprint": "f19ac6f4355876da2303435679fcc9e6b886fec89117ad4cdefabb85a4ac5b2b",
      "source_batch": 52,
      "uid": "zhcn:9edcd11ce76d5f677b067285",
      "current_text": "Rất đáng tiếc. Dù đã vuột mất chiến thắng\nnhưng đây là một cuộc đua rất trọn vẹn.",
      "current_fingerprint": "9131b5a58f00c18499017982c74450f6a7c201a9646c1ecd3a599a0ee5da4fe5",
      "source_visual_width": 11.38,
      "current_visual_width": 21.58,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0496",
      "path": [
        "Race0496"
      ],
      "source_text": "选择{0}策略的对手很多呢。相同策略人数太多\n的话会很难取胜，试试不同的作战策略吧。",
      "source_fingerprint": "5c22d4d0b72a1fd4a93d03971054ba79e4531327256bc2d4c5c31e5a71188538",
      "source_batch": 52,
      "uid": "zhcn:d04cecc2b4d96f74887fa1b0",
      "current_text": "Có nhiều đối thủ chọn chiến thuật {0}. Nếu quá nhiều người dùng cùng chiến thuật\nsẽ khó giành chiến thắng, hãy thử một chiến thuật khác.",
      "current_fingerprint": "0c0b3fd4972cc87f527b9bd0ff175f9df4e69159c317857831b891e9f8fd0ed0",
      "source_visual_width": 18.96,
      "current_visual_width": 41.29,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0498",
      "path": [
        "Race0498"
      ],
      "source_text": "有点缺乏冷静力呢。步调乱了的话\n会浪费体力，提高一下智力吧。",
      "source_fingerprint": "2beef5ee1966081257e2ba846866e5c828e7cc03be62f2dbaaefcb1ab9dddd9e",
      "source_batch": 52,
      "uid": "zhcn:9ed4a00becf1a8ac741722b6",
      "current_text": "Có vẻ hơi thiếu bình tĩnh. Nếu nhịp chạy bị rối loạn\nsẽ lãng phí thể lực, hãy nâng Trí tuệ.",
      "current_fingerprint": "4f5c2c0b7a4f2b1de628ed63a92fc600cc2a52466fdb2265c09c9edaf938a607",
      "source_visual_width": 14.38,
      "current_visual_width": 27.21,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0499",
      "path": [
        "Race0499"
      ],
      "source_text": "比赛时步调乱了，\n好像没能冷静地跑呢。",
      "source_fingerprint": "43c6f96a670f9fc305380a28977468e6328fd15d07c2d50a6c66d0ef08bffc9c",
      "source_batch": 52,
      "uid": "zhcn:1bc3fe7887b4a5be8e7f61ff",
      "current_text": "Nhịp chạy bị rối loạn trong cuộc đua,\ncó vẻ đã không thể chạy một cách bình tĩnh.",
      "current_fingerprint": "d7bc726d5f60c051b75a7043b3595695e44fcef031ff0acd7c7ababc980e9065",
      "source_visual_width": 9.38,
      "current_visual_width": 22.49,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0502",
      "path": [
        "Race0502"
      ],
      "source_text": "比起其他赛马娘来看根性不足，终盘时好像\n体力耗尽了。提升根性来增强竞争心吧。",
      "source_fingerprint": "39bfb266cdfc947a9deb598d16d8c5c9bb4873b50bfb3505f9012e75b384338a",
      "source_batch": 52,
      "uid": "zhcn:5eb1ce2050913caa338ded61",
      "current_text": "So với các Uma Musume khác thì Ý chí còn thấp, đến cuối chặng có vẻ\nđã cạn thể lực. Hãy nâng Ý chí để tăng tinh thần cạnh tranh.",
      "current_fingerprint": "cbea9ea27bc1fe829f394902392beb9befa2ec602fd7c7958465c41242e86d50",
      "source_visual_width": 18.38,
      "current_visual_width": 34.91,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0503",
      "path": [
        "Race0503"
      ],
      "source_text": "比起其他赛马娘来看根性不足，\n终盘时貌似体力耗尽了呢。",
      "source_fingerprint": "a840caef427a9905fc5f72ae9aa157c933076624a555d91a6368d72bfa536f2f",
      "source_batch": 52,
      "uid": "zhcn:252f0d1e1145fe0b81b43191",
      "current_text": "So với các Uma Musume khác thì Ý chí còn thấp,\nđến cuối chặng có vẻ đã cạn thể lực.",
      "current_fingerprint": "cc86bdc0ff6e05ae91dfcc8b2fb9f9cb4a3a88a1752d454fc4bf830ed323fff1",
      "source_visual_width": 13.38,
      "current_visual_width": 23.98,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0504",
      "path": [
        "Race0504"
      ],
      "source_text": "比赛途中好像体力耗尽而导致速度\n大幅下降了呢。试试提升耐力吧。",
      "source_fingerprint": "3628dc2f592c72e94d26904b041e1b6b44764ba1fc7858252a9315e611cfadda",
      "source_batch": 52,
      "uid": "zhcn:17124424961da1792e7181f2",
      "current_text": "Giữa cuộc đua có vẻ đã cạn thể lực khiến tốc độ\ngiảm mạnh. Hãy thử nâng Thể lực.",
      "current_fingerprint": "26b4812050a59075b64026a8e9cefb6f20ac44f3fd2839d749968b0df3a07b3e",
      "source_visual_width": 15.0,
      "current_visual_width": 24.51,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    }
  ]
}
