    },
    {
      "key": "Race0605",
      "path": [
        "Race0605"
      ],
      "source_text": "训练的效果增加10％\n比赛时，基础能力增加2％",
      "source_fingerprint": "53ec15c9f03a54b95a25560271c54a0e40e9bba5035b409883e0341847aabf0d",
      "source_batch": 53,
      "uid": "zhcn:109da702e2b2be1d508dc3f8",
      "current_text": "Hiệu quả huấn luyện tăng 10％\nTrong cuộc đua, chỉ số cơ bản tăng 2％",
