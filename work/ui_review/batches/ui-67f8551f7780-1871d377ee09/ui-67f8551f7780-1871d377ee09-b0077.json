{
  "schema_version": 1,
  "plan_id": "ui-67f8551f7780-1871d377ee09",
  "batch_id": "ui-67f8551f7780-1871d377ee09-b0077",
  "source_commit": "67f8551f77807292cebd2b20b2c752b652393835",
  "source_queue_git_commit": "ba3815ed06a2a9bb3fddb38a6e1ea7ca64506da2",
  "items": [
    {
      "key": "Race0506",
      "path": [
        "Race0506"
      ],
      "source_text": "好像没有为最终冲刺保存体力。\n锻炼一下耐力吧。",
      "source_fingerprint": "8854fbdb854c57fa33001c196e409e53936219c45f483948d59d7bc33c759a8d",
      "source_batch": 52,
      "uid": "zhcn:438f1bc7afef87cad92a4930",
      "current_text": "Có vẻ đã không giữ đủ thể lực cho cú nước rút cuối.\nHãy rèn luyện Thể lực.",
      "current_fingerprint": "a1fbeaec5634a7f11d61579a4f71e81580bf27908fb2eaa7cf40476e9d95b772",
      "source_visual_width": 13.38,
      "current_visual_width": 26.38,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0508",
      "path": [
        "Race0508"
      ],
      "source_text": "最终冲刺还有进步余地。为了能够达到最高速度\n提升耐力吧。",
      "source_fingerprint": "941b00192ce4b01014912ee288c9ee6ab171e8aafc4742e63e70a81252df7acf",
      "source_batch": 52,
      "uid": "zhcn:adb5c61e1020731d26140766",
      "current_text": "Cú nước rút cuối vẫn còn có thể cải thiện. Để đạt được tốc độ tối đa\nhãy nâng Thể lực.",
      "current_fingerprint": "a55285acafee35ba0ec25e0f7b2be03197f5fd7bec026b8a7b1bf33337a6e70e",
      "source_visual_width": 20.38,
      "current_visual_width": 35.24,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0509",
      "path": [
        "Race0509"
      ],
      "source_text": "没能达到最高速度，最终冲刺还有\n进步余地呢。",
      "source_fingerprint": "819b71683b1310bccf866e57634cb98188e1bde09ef90d030a7dbbf50ade2271",
      "source_batch": 52,
      "uid": "zhcn:0f3e1dfd16590be399d39eee",
      "current_text": "Đã không thể đạt tốc độ tối đa, cú nước rút cuối vẫn còn\ndư địa để cải thiện.",
      "current_fingerprint": "9ad17c258eed85241f5bfe8df8f71748ef376921e409ae8ee776e028bac7ad1a",
      "source_visual_width": 14.38,
      "current_visual_width": 29.03,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0512",
      "path": [
        "Race0512"
      ],
      "source_text": "似乎被其他赛马娘挡住了，\n很难突破重围。",
      "source_fingerprint": "37ef7b811a6f624566c63c723769ea8707bf5a0ab5f3bc55ef74e1a3a1b3e64f",
      "source_batch": 52,
      "uid": "zhcn:f71db5b1bc2a24a96a29fb96",
      "current_text": "Có vẻ đã bị các Uma Musume khác chặn lại,\nnên rất khó thoát khỏi vòng vây.",
      "current_fingerprint": "f6d310f5284a6433ad9372b79ae2cadc5aa12533dc67ef142ae75460de0948c6",
      "source_visual_width": 11.38,
      "current_visual_width": 21.33,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0513",
      "path": [
        "Race0513"
      ],
      "source_text": "好像被其他赛马娘挡住了，\n很难冲出来。",
      "source_fingerprint": "832b6d678b3a1f21c1732eff032f82c72eb459075f46aa12bb34de69a8bb97a5",
      "source_batch": 52,
      "uid": "zhcn:4f9e420e8ac376f95a1a2dcf",
      "current_text": "Có vẻ đã bị các Uma Musume khác chặn lại,\nnên rất khó lao ra.",
      "current_fingerprint": "4d99183ccb45635d322773fe05d8242e02ac1a53b24117aff76a9f6ae9fb5e80",
      "source_visual_width": 11.38,
      "current_visual_width": 21.33,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0514",
      "path": [
        "Race0514"
      ],
      "source_text": "这一次错失了胜利呢。\n审视一下技能与基础能力间的平衡吧。",
      "source_fingerprint": "c037c15dc25051a9c9ac83669ed6dbc4e0fa96e2bf1d8e6ded6a2ac5b710ee08",
      "source_batch": 52,
      "uid": "zhcn:5160471241a43f3bb98e5b4d",
      "current_text": "Lần này đã bỏ lỡ chiến thắng.\nHãy xem lại sự cân bằng giữa kỹ năng và chỉ số cơ bản.",
      "current_fingerprint": "3dbdb55e737d21784fa7fcdca3576a250f78934ff45225cea3e23b29aee8e9ac",
      "source_visual_width": 16.38,
      "current_visual_width": 27.87,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0515",
      "path": [
        "Race0515"
      ],
      "source_text": "这一次错失了胜利呢。\n下次比赛再加油吧！",
      "source_fingerprint": "919dbec6916f52cfe111b288264d472ce43a21062e34ea3572c15e37e5e55848",
      "source_batch": 52,
      "uid": "zhcn:4a98a1a32a1d16ecb96b8026",
      "current_text": "Lần này đã bỏ lỡ chiến thắng.\nHãy cố gắng hơn ở cuộc đua tiếp theo!",
      "current_fingerprint": "074b5ab082acae9bbb91ec21a0cafb7c6623d4bc958a1b2a8c509509e65bb290",
      "source_visual_width": 9.38,
      "current_visual_width": 19.26,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0516",
      "path": [
        "Race0516"
      ],
      "source_text": "由于距离适性不符，未能完全发挥能力。\n选择距离适性等级较高的比赛距离吧。",
      "source_fingerprint": "8599370265ec84f2eb1dffdea247ddc0b407a5d160812d7c13f1359044e1762b",
      "source_batch": 52,
      "uid": "zhcn:4f5743dc42e97992bdde7cdc",
      "current_text": "Do độ thích nghi cự ly không phù hợp nên chưa thể phát huy hết khả năng.\nHãy chọn cự ly đua có hạng thích nghi cự ly cao hơn.",
      "current_fingerprint": "8151350f90a04f1dd6d2e200b0392e1231198989a58dad73c0fb220176089474",
      "source_visual_width": 16.76,
      "current_visual_width": 37.56,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0517",
      "path": [
        "Race0517"
      ],
      "source_text": "距离适应性不合适而导致没能发挥出能力呢。\n选择距离适应性等级高的距离吧。",
      "source_fingerprint": "b9fa348c9733361d0ab6a534d716dacc13d23ec5642cc68526370c48d1469cc3",
      "source_batch": 52,
      "uid": "zhcn:9bd48b36bd2b168443031285",
      "current_text": "Do độ thích nghi cự ly không phù hợp nên chưa thể phát huy khả năng.\nHãy chọn cự ly có hạng thích nghi cự ly cao hơn.",
      "current_fingerprint": "c85c1f2d1a7063548c91dc2a6ebb95731cab5e6ea4003c9903e7ebee32a2f90c",
      "source_visual_width": 19.38,
      "current_visual_width": 35.49,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0518",
      "path": [
        "Race0518"
      ],
      "source_text": "由于场地适性不符，未能完全发挥能力。\n选择场地适性等级较高的场地吧。",
      "source_fingerprint": "6bb1a593fa5ccde1aa000188f5af52a46497e8e36c84bc4a81083b1b096ca369",
      "source_batch": 52,
      "uid": "zhcn:171637252d96e03b99000ee1",
      "current_text": "Do độ thích nghi sân đua không phù hợp nên chưa thể phát huy hết khả năng.\nHãy chọn sân đua có hạng thích nghi cao hơn.",
      "current_fingerprint": "60837730de80dfb922ee714f76c8d896defdd07789a8ad7f804928f3f9db8c96",
      "source_visual_width": 16.76,
      "current_visual_width": 38.72,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0519",
      "path": [
        "Race0519"
      ],
      "source_text": "马场适性不合适而导致没能发挥出能力呢。\n选择马场适性等级高的马场吧。",
      "source_fingerprint": "892510fdb3ec6ae3b3da8a3eca2bba90f1c3ce41997c81654a3dddc376ae004b",
      "source_batch": 52,
      "uid": "zhcn:4199a3ff6209503f4b32c171",
      "current_text": "Do độ thích nghi sân đua không phù hợp nên chưa thể phát huy khả năng.\nHãy chọn loại sân có hạng thích nghi cao hơn.",
      "current_fingerprint": "663967f1e4a28b5962f9ac6054b73c85d26ba5c686a149633caab059afccd77c",
      "source_visual_width": 18.38,
      "current_visual_width": 36.65,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0520",
      "path": [
        "Race0520"
      ],
      "source_text": "比赛辛苦啦！如果能通过继承提高适性的话\n就有可能期待取胜吧！",
      "source_fingerprint": "c64602802f3ce4aaa941d28fd7db2d41134a15f63a21002623ca94fac06af23a",
      "source_batch": 52,
      "uid": "zhcn:6a317f1f18594c709a66ddb5",
      "current_text": "Cuộc đua vất vả rồi! Nếu có thể tăng độ thích nghi thông qua kế thừa\nthì có thể kỳ vọng vào chiến thắng!",
      "current_fingerprint": "849432362932e7d627b04bd181d66e3a1511de2ef3ecb9815c8d9ed260b9b036",
      "source_visual_width": 18.38,
      "current_visual_width": 35.49,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0521",
      "path": [
        "Race0521"
      ],
      "source_text": "干劲低下，好像没能发挥出原本的能力。\n通过外出维持干劲吧。",
      "source_fingerprint": "f81bb28856121c766729e2c513b13f96cdfd050e7f49b2d4aa7d669c57968897",
      "source_batch": 52,
      "uid": "zhcn:19a325da25c78cec99cae411",
      "current_text": "Tinh thần xuống thấp nên có vẻ chưa thể phát huy khả năng vốn có.\nHãy duy trì tinh thần bằng cách đi chơi.",
      "current_fingerprint": "380f33aa10d70ab778cd327fe38e3342d9e0c71c7ef64750911b86563a80c85f",
      "source_visual_width": 16.76,
      "current_visual_width": 34.0,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0522",
      "path": [
        "Race0522"
      ],
      "source_text": "由于干劲低下，赛马娘好像没能\n发挥出原本的能力。",
      "source_fingerprint": "f0c85420361391d95be03607c956d20cf87d9f1092a9677759931e95699fc6b1",
      "source_batch": 52,
      "uid": "zhcn:5c9b6fd539bfc5e0d96640d5",
      "current_text": "Do tinh thần xuống thấp, Uma Musume có vẻ chưa thể\nphát huy khả năng vốn có.",
      "current_fingerprint": "2a02a50823de27dfca5b3a42656d803e34ff10f1602f704c758af6c4a432dc0c",
      "source_visual_width": 13.38,
      "current_visual_width": 26.3,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0534",
      "path": [
        "Race0534"
      ],
      "source_text": "同策略马娘太多",
      "source_fingerprint": "d7defd00f22627c6d4d9835ad77f68cef3478e08f27b3e141df0da7da5ed7fad",
      "source_batch": 52,
      "uid": "zhcn:62f76a71df5bf6e96c20dbac",
      "current_text": "Quá nhiều Uma Musume cùng chiến thuật",
      "current_fingerprint": "000195e303ec2cfd92e52e228f155963b15d0c41e2d720b9995ad63c2aa4ae58",
      "source_visual_width": 7.0,
      "current_visual_width": 19.96,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0537",
      "path": [
        "Race0537"
      ],
      "source_text": "马场适性未达到B",
      "source_fingerprint": "f21e2774e5281bde9fa298f8fa5c1d348cd16306cc19fa880819fbec72dda5e5",
      "source_batch": 52,
      "uid": "zhcn:3021a866f475e9ded21ed205",
      "current_text": "Độ thích nghi sân đua chưa đạt B",
      "current_fingerprint": "cbcedeb8f4d6b6e69b51fd189cdf42eab57a12b1ffff3ec469524a5650d4069e",
      "source_visual_width": 7.58,
      "current_visual_width": 16.81,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0602",
      "path": [
        "Race0602"
      ],
      "source_text": "训练的效果减少20％\n比赛时，基础能力减少4％",
      "source_fingerprint": "8222bf10e2ab7cc071a9a5739d0ebc15fa726b243c2636d28500c9df957c7195",
      "source_batch": 53,
      "uid": "zhcn:9346522b70b54ce52940e306",
      "current_text": "Hiệu quả huấn luyện giảm 20％\nTrong cuộc đua, chỉ số cơ bản giảm 4％",
      "current_fingerprint": "90b31d54dbafc23d02def6b4fe24740aad3609561bb0b069509acbf348f04de2",
      "source_visual_width": 10.34,
      "current_visual_width": 19.06,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0603",
      "path": [
        "Race0603"
      ],
      "source_text": "训练的效果减少10％\n比赛时，基础能力减少2％",
      "source_fingerprint": "efb7e9e968540e427cc4d1b290b694233ac21deeb91b597fd9d982d0f8be05d3",
      "source_batch": 53,
      "uid": "zhcn:48d9957d90b331435989b73b",
      "current_text": "Hiệu quả huấn luyện giảm 10％\nTrong cuộc đua, chỉ số cơ bản giảm 2％",
      "current_fingerprint": "9f01d8e25416c5ae58618cb1c8f1b49de148c2aa9a09a4728aa4d488cbefad5c",
      "source_visual_width": 10.34,
      "current_visual_width": 19.06,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Race0604",
      "path": [
        "Race0604"
      ],
      "source_text": "训练的效果不变\n比赛时，基础能力不变",
      "source_fingerprint": "0099c8ca61b8485a2e5fa57d32ea07b0393ee903766dab87e5b5a46cbd218060",
      "source_batch": 53,
      "uid": "zhcn:43653b0c88c4ea49471e291d",
      "current_text": "Hiệu quả huấn luyện không đổi\nTrong cuộc đua, chỉ số cơ bản không đổi",
