    {
      "key": "Shop0022",
      "path": [
        "Shop0022"
      ],
      "source_text": "年龄在出生月份的次月1日加1岁。\n未成年人购买需要法定代理人（双亲等）的同意。",
      "source_fingerprint": "433cdec3af9d80c454781e07c8684e5673f1178387e564c1f2dcea72d6119627",
      "source_batch": 62,
      "uid": "zhcn:8cb80412b000960446ff5787",
      "current_text": "Tuổi sẽ tăng thêm 1 vào ngày 1 của tháng sau tháng sinh.\nNgười chưa thành niên cần có sự đồng ý của người đại diện pháp luật (cha mẹ, v.v.) khi mua hàng.",
      "current_fingerprint": "15210762d3a58a5c0969218c438466faef4c3e88fc7fb7243987bb36e90d0060",
      "source_visual_width": 20.14,
      "current_visual_width": 49.48,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Shop0023",
      "path": [
        "Shop0023"
      ],
      "source_text": "出生年月以后无法更改",
      "source_fingerprint": "77ca8c1a229d05fafa3549afb1adf8d953c0ff382f9898ffa657a1ffb72b1c00",
      "source_batch": 62,
      "uid": "zhcn:e0bbf04b8fc78294d0a1ca8b",
      "current_text": "Không thể thay đổi năm tháng sinh sau này",
