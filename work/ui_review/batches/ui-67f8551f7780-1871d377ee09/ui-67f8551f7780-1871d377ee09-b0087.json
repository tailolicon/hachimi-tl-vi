      "source_batch": 62,
      "uid": "zhcn:7815e2d71ba4671c41ae8ad1",
      "current_text": "Bạn thuộc nhóm từ 20 tuổi trở lên.\nKhông có giới hạn mua hàng mỗi tháng.",
      "current_fingerprint": "7d18572ffaceca6892478c5e8916df2f8980447a31aeb17f4b76188b3768b2aa",
      "source_visual_width": 8.38,
      "current_visual_width": 19.51,
