      "source_visual_width": 13.38,
      "current_visual_width": 26.96,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode699002",
      "path": [
        "SingleMode699002"
      ],
      "source_text": "基础能力最大上限",
