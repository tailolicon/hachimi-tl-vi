      "current_visual_width": 17.97,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode661025",
      "path": [
        "SingleMode661025"
      ],
      "source_text": "其他持有的技能灵感",
      "source_fingerprint": "a6d136b537fdda46b5202e4ce09658f7b3a360614ae9998c32478f537aaa2bcc",
      "source_batch": 76,
      "uid": "zhcn:d8d90046250d5e7820cbb296",
      "current_text": "Cảm hứng kỹ năng khác đang sở hữu",
      "current_fingerprint": "8a1ec5f184646fb35dbf1a63a5b0232fd69459223abf9fb0773b738fce14e730",
