      "source_batch": 76,
      "uid": "zhcn:71ca1b0e8315fff143b9e416",
      "current_text": "Do không thể tham gia cuộc đua đã đặt trước,\nđặt trước cuộc đua này đã bị hủy.",
      "current_fingerprint": "bc1e3ce4badeffd9931f5f44357577156c1c92d40c13ec840bd3603468c8906f",
