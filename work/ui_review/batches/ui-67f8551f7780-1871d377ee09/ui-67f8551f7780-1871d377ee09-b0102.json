    {
      "key": "SingleMode661016",
      "path": [
        "SingleMode661016"
      ],
      "source_text": "闹钟不足\n要在商店兑换吗？",
      "source_fingerprint": "f81b5495edf9b10ccb1adaaf9e36e9f9049befda99a18d79b5905d10364a78e6",
      "source_batch": 76,
      "uid": "zhcn:98f6df565f887e969350207a",
      "current_text": "Không đủ Đồng hồ báo thức\nBạn có muốn đổi trong cửa hàng không?",
      "current_fingerprint": "f213ea40661e45db068cd868a97093222eb374a682067724356743aaf432164f",
      "source_visual_width": 7.38,
      "current_visual_width": 19.51,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode661017",
      "path": [
        "SingleMode661017"
      ],
      "source_text": "兑换完成后，将使用闹钟继续游戏",
      "source_fingerprint": "d97d0480f76c2c97d424769464a03dddfadbfa20d1b26960c704df37d0c69e89",
      "source_batch": 76,
      "uid": "zhcn:8377d474c73dee16e0a82708",
      "current_text": "Sau khi đổi xong, sẽ dùng Đồng hồ báo thức để tiếp tục trò chơi",
      "current_fingerprint": "a3adf3b6a2eb6c3013bdb35e4098bd925d7f91829c599cf3e00404552a283b2f",
      "source_visual_width": 14.38,
      "current_visual_width": 32.84,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode661020",
      "path": [
        "SingleMode661020"
      ],
      "source_text": "请选择要继承的因子",
      "source_fingerprint": "38829fcdf8ffce7fb435eee5e9d19b1c71adbb8352a4bc07f410a6b3a219429f",
      "source_batch": 76,
      "uid": "zhcn:42a43a00a34436372bf7b941",
      "current_text": "Vui lòng chọn Nhân tố muốn kế thừa",
      "current_fingerprint": "8f0f9fb17d371144ee95c14ffd62d611bd953d732d4c70225c618caae07cf0bb",
