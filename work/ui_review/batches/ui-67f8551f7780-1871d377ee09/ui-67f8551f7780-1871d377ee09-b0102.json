      "current_visual_width": 17.39,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode661026",
      "path": [
        "SingleMode661026"
      ],
      "source_text": "确定要继承这些因子吗？",
