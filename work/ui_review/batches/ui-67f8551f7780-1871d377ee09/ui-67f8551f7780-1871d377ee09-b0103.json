      "source_visual_width": 17.38,
      "current_visual_width": 41.95,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode701029",
      "path": [
        "SingleMode701029"
      ],
      "source_text": "可以在“闹钟设置”中，\n设置为不在资质较低的比赛中使用闹钟",
