      "source_batch": 77,
      "uid": "zhcn:9ad50fbef8f404bcaa322836",
      "current_text": "Trong “Cài đặt Đồng hồ báo thức”,\ncó thể thiết lập không sử dụng Đồng hồ báo thức ở các cuộc đua có mức thích nghi thấp",
      "current_fingerprint": "719e353ae131b8f97c6f1e302ffcd459257ac3f2c05a7900f11d92d1deb48a9e",
      "source_visual_width": 17.0,
      "current_visual_width": 44.55,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleMode701030",
      "path": [
        "SingleMode701030"
      ],
