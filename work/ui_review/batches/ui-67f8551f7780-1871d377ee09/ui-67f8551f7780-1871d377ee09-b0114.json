    {
      "key": "SingleModeScenarioOnsen194046",
      "path": [
        "SingleModeScenarioOnsen194046"
      ],
      "source_text": "悠闲地泡一泡温泉，不仅能恢复体力，\n还能提升训练质量哦！",
      "source_fingerprint": "b277f1fbc27f046658efd53efb3160f42430fe7463acb5d7bdd630442729ec86",
      "source_batch": 88,
      "uid": "zhcn:5ff77f9becdd1fcf66bc5f2f",
      "current_text": "Ngâm mình thư giãn trong suối nước nóng không chỉ hồi Thể lực,\nmà còn nâng cao chất lượng huấn luyện!",
      "current_fingerprint": "04a914d407af585eaaf4f2682dff569994161c38582ead8d018b30a5d889ec45",
      "source_visual_width": 15.76,
      "current_visual_width": 32.76,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
