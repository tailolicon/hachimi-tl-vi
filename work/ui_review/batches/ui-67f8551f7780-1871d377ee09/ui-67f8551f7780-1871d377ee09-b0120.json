    {
      "key": "SingleModeScenarioTeamRace0040",
      "path": [
        "SingleModeScenarioTeamRace0040"
      ],
      "source_text": "育成赛马娘必须编为エース（领队）",
      "source_fingerprint": "0207810f5640e4f44627cc526566dcdca5b6840fd81a350a4eb64b12efb53f78",
      "source_batch": 95,
      "uid": "zhcn:f8e4165ee392487eec5e957d",
      "current_text": "Uma Musume huấn luyện phải được xếp làm Ace (đội trưởng)",
      "current_fingerprint": "f1ad65e0f441176b79f383f4533bd97b14f2d9d7fef5c25cca8812095f397c7c",
      "source_visual_width": 14.76,
      "current_visual_width": 29.58,
      "risk_flags": [
