        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0047",
      "path": [
        "SingleModeScenarioTeamRace0047"
      ],
      "source_text": "已集齐青春杯所需的成员",
      "source_fingerprint": "a5b3f243f3e140808991763580ad0cc74be71c727518f6d8055f74491bb438ed",
      "source_batch": 95,
      "uid": "zhcn:3f2645232826a888e0865fb9",
      "current_text": "Đã tập hợp đủ thành viên cần thiết cho Aoharu Cup",
      "current_fingerprint": "1ae7292c40d109fedeaec90f0cd49bb6c9d6f85c195c0cbf03d227bc40843317",
      "source_visual_width": 11.0,
      "current_visual_width": 25.92,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0051",
      "path": [
        "SingleModeScenarioTeamRace0051"
      ],
      "source_text": "与对自己队伍感兴趣的赛马娘\n一同训练，将其拉入队伍吧",
      "source_fingerprint": "bd82d44faf66173697f48918dc43552081b94e24ea8f03a877c6aa1e09e6fd53",
      "source_batch": 95,
      "uid": "zhcn:492bb04fc0ff0d8deb5d58a9",
      "current_text": "Hãy huấn luyện cùng Uma Musume quan tâm đến đội của mình\nvà chiêu mộ cô ấy vào đội",
      "current_fingerprint": "1a674fca1d058f2aff7ffa4af4d57f79c53dd52469bac1a7faf698dbfc7f18ae",
      "source_visual_width": 13.0,
      "current_visual_width": 29.73,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0060",
      "path": [
        "SingleModeScenarioTeamRace0060"
      ],
      "source_text": "队员的实力都很充足。\n通过此次对战提高排名吧！",
      "source_fingerprint": "ea0630bf6cfdd3ee5daededfcb8832a403b5dd5f2e5c6d6626d466ba2d386051",
      "source_batch": 95,
      "uid": "zhcn:7ac2bea63f5f33b99931eb8e",
      "current_text": "Thực lực của các thành viên đều rất tốt.\nHãy nâng thứ hạng qua trận đấu này!",
      "current_fingerprint": "b272285a26777836e407932bd665ffbe5892f112611874e88ee1b9649f2f7902",
      "source_visual_width": 11.38,
      "current_visual_width": 21.0,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0061",
      "path": [
        "SingleModeScenarioTeamRace0061"
      ],
      "source_text": "虽然也有需要担心的比赛，\n但以她们为对手可以期待获胜！",
      "source_fingerprint": "4520ef73c35d498c2a42167eb96790d66697331c7e594f4d07fc7f7f5311545a",
      "source_batch": 95,
      "uid": "zhcn:7d0d6cd4acbadccfa2e25b14",
      "current_text": "Dù có vài cuộc đua đáng lo,\nnhưng trước đối thủ này có thể kỳ vọng chiến thắng!",
      "current_fingerprint": "76dd78f0f5860f75f8ea8fcd0fb0c0986e18e3f9d26b3737ab477527f028e54d",
      "source_visual_width": 13.38,
      "current_visual_width": 26.88,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0062",
      "path": [
        "SingleModeScenarioTeamRace0062"
      ],
      "source_text": "队员们都能发挥出实力的话，\n获胜概率应该会很大！",
      "source_fingerprint": "6a5d50d9b35dc78b8b3abd26073768c61d678f91decf426c78cba6a2d9fb1252",
      "source_batch": 95,
      "uid": "zhcn:c82ef5bee0d1cbc5dbfa29c1",
      "current_text": "Nếu các thành viên đều phát huy được thực lực,\nkhả năng chiến thắng sẽ rất cao!",
      "current_fingerprint": "0ffdf31c78807fa7fc450786983c3887441fb2cf4ad0450a90c20a2995c57b49",
      "source_visual_width": 12.38,
      "current_visual_width": 24.23,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0063",
      "path": [
        "SingleModeScenarioTeamRace0063"
      ],
      "source_text": "是实力相近的队伍呢。\n虽然不能掉以轻心，但应该会是一场精彩的对决！",
      "source_fingerprint": "47d968d2a26cf206df7762f3d8e4f6533ec529ff79cb755500971e3a6363b947",
      "source_batch": 95,
      "uid": "zhcn:c0c7d6afbe99e79aac721868",
      "current_text": "Đây là đội có thực lực khá ngang nhau.\nKhông thể chủ quan, nhưng chắc chắn sẽ là một màn đối đầu hấp dẫn!",
      "current_fingerprint": "87943fb9fab3e9ac0164ae5a864f3ff541dae3320dedacca45b53d63121dbd02",
      "source_visual_width": 20.76,
      "current_visual_width": 34.38,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0064",
      "path": [
        "SingleModeScenarioTeamRace0064"
      ],
      "source_text": "看来会陷入苦战，\n但可能性也不是零哦！",
      "source_fingerprint": "0a7628e0790c77ec322a6cc2e89a2692dad15b95e9509025ce8dd6d9ec1492bd",
      "source_batch": 95,
      "uid": "zhcn:2aa25ae7c77637bea1197e25",
      "current_text": "Có vẻ sẽ là một trận đấu khó khăn,\nnhưng cơ hội vẫn chưa bằng không!",
      "current_fingerprint": "41391dacb47b3a2bce497559c6250acf319f743af310ff181e549311391c7b04",
      "source_visual_width": 9.38,
      "current_visual_width": 17.52,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0065",
      "path": [
        "SingleModeScenarioTeamRace0065"
      ],
      "source_text": "虽然无法否认实力不足，但对队员们来说，\n也许会成为不错的经验呢！",
      "source_fingerprint": "5525bc5bdefb0404f90b40f9176f5e97da62c8b27bb9197bdb6da62ad695b1c7",
      "source_batch": 95,
      "uid": "zhcn:b8008d816558bfec16db72a4",
      "current_text": "Không thể phủ nhận chúng ta còn thiếu thực lực, nhưng với các thành viên,\nđây có thể là một trải nghiệm tốt!",
      "current_fingerprint": "c829c6c5a7d072f2bed48d7e7f505e24345a2afae8238258946697de222d5312",
      "source_visual_width": 17.76,
      "current_visual_width": 38.44,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "SingleModeScenarioTeamRace0072",
      "path": [
        "SingleModeScenarioTeamRace0072"
      ],
      "source_text": "好像没有对队伍感兴趣的赛马娘",
      "source_fingerprint": "433e657af2a0d89118c116917a20d2fc896beb9fef223de130755946eefefbf8",
      "source_batch": 95,
      "uid": "zhcn:46a8a8e496a6a48228ceaa74",
      "current_text": "Có vẻ không có Uma Musume nào quan tâm đến đội",
      "current_fingerprint": "ac1f1e44a9d73ffe93ba213b595b2109cc65bb3ea93c7e433af8dc3bfed3fee4",
      "source_visual_width": 14.0,
      "current_visual_width": 24.18,
