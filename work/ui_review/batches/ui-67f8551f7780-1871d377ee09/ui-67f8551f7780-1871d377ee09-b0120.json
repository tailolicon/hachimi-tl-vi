    {
      "key": "SingleModeScenarioTeamRace0039",
      "path": [
        "SingleModeScenarioTeamRace0039"
      ],
      "source_text": "请将育成赛马娘编为エース（领队）",
      "source_fingerprint": "5d3dcc58fc8f1073e3ca12cd89882c3ff61ed1baa9c050334dfa6ad5e6308e53",
      "source_batch": 95,
      "uid": "zhcn:1cac84a05935817bd2f40977",
      "current_text": "Hãy xếp Uma Musume huấn luyện làm Ace (đội trưởng)",
