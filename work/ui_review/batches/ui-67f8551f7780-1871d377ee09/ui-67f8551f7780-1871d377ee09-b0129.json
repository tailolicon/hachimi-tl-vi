  "items": [
    {
      "key": "Title0052",
      "path": [
        "Title0052"
      ],
      "source_text": "根据网络状况有时会耗费一定时间。\n推荐在Wi-Fi环境下载。",
      "source_fingerprint": "6174e25fbc1b1eafe176df94abdb9d14ecdcf184fbde6365ac0eb92d8155943b",
      "source_batch": 105,
      "uid": "zhcn:ce6d222ed26674b62c406744",
      "current_text": "Tùy tình trạng mạng, quá trình có thể mất một chút thời gian.\nKhuyến nghị tải xuống qua Wi-Fi.",
      "current_fingerprint": "f2da33d442eb1220d461184380cddf14c05ba78140f6d6d86c9df81729f01f2d",
      "source_visual_width": 15.38,
      "current_visual_width": 31.98,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0054",
      "path": [
        "Title0054"
      ],
      "source_text": "必ず法定代理人（ご両親等）に許可をもらうか",
      "source_fingerprint": "fe3a7e93fe5ac85885447976aff2a9409de4156b2b2f87b1596b6e183476353a",
      "source_batch": 105,
      "uid": "zhcn:ff8afa24592d002d0e12a778",
      "current_text": "Hãy luôn xin phép người đại diện pháp luật (cha mẹ, v.v.) hoặc",
      "current_fingerprint": "d7a38c57fb0db994a2a7340d08e04ecaf1f5a3e9e4d1fc112fddfacd6f4d7557",
      "source_visual_width": 19.76,
      "current_visual_width": 31.96,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0062",
      "path": [
        "Title0062"
      ],
      "source_text": "推荐在Wi-Fi环境下载",
      "source_fingerprint": "875e2ba2cf6bc593cf55cccaa9559ba91b0092eff921cd61bd81b0a4aa8c6385",
      "source_batch": 105,
      "uid": "zhcn:8771657278ddc37d7c15f50f",
      "current_text": "Khuyến nghị tải xuống qua Wi-Fi",
      "current_fingerprint": "56f19f8df860996ef3f68b821fb328b176aab2c6ba7ad8e615c471bff2e376f5",
      "source_visual_width": 9.7,
      "current_visual_width": 16.53,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0078",
      "path": [
        "Title0078"
      ],
      "source_text": "请让我们听听您的意见和要求\n※将打开网页浏览器",
      "source_fingerprint": "cd92ff53705f22e88227d5547f6054ac64bae3f36c1e5ed9e5648a7f91bf57fb",
      "source_batch": 105,
      "uid": "zhcn:3da65e917134914fd26b8101",
      "current_text": "Hãy cho chúng tôi biết ý kiến và mong muốn của bạn\n※Trình duyệt web sẽ được mở",
      "current_fingerprint": "4cdd847c0c2047c82eedc8dc9cfb58407b97bb30bb8f8000cb791e171806fcfa",
      "source_visual_width": 13.0,
      "current_visual_width": 26.25,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0084",
      "path": [
        "Title0084"
      ],
      "source_text": "进行数据修复时请减少操作",
      "source_fingerprint": "b288f00232fc34a7107f2daf835f495a4c6017ccceb7514404e9936946b25995",
      "source_batch": 105,
      "uid": "zhcn:60a63f13c3f261afad953a45",
      "current_text": "Vui lòng hạn chế thao tác khi đang sửa dữ liệu",
      "current_fingerprint": "5a647a0edf05080390e546133e79d82eb659ca3470cd4952841ee71406eb19f2",
      "source_visual_width": 12.0,
      "current_visual_width": 24.18,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0085",
      "path": [
        "Title0085"
      ],
      "source_text": "使用训练员ID和密码\n引继以前的数据",
      "source_fingerprint": "8b7d7e0bbf048c48d563605129c62a7d1760abc413b04cd8262ea37f4021c403",
      "source_batch": 105,
      "uid": "zhcn:f8b6a8568a73becc27c39e90",
      "current_text": "Dùng ID Huấn luyện viên và mật khẩu\nđể chuyển dữ liệu trước đây",
      "current_fingerprint": "9bcfc915c82157f24deb49f6c61e3dc61746a606fbfe6c8809ddab24d3d66265",
      "source_visual_width": 9.16,
      "current_visual_width": 18.55,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0091",
      "path": [
        "Title0091"
      ],
      "source_text": "アプリの利用方法（利用時間等）は",
      "source_fingerprint": "67960f70a2d59d618efab704f5383d79b39e73d6d87f61cc290e9a818b5f14d7",
      "source_batch": 105,
      "uid": "zhcn:38949375fb50ce3d75033d4b",
      "current_text": "Về cách sử dụng ứng dụng (thời gian sử dụng, v.v.)",
      "current_fingerprint": "926e0efd0ae44c6be2b0fc963c4017a29a2ad841eb02befc4186a8a5a6702574",
      "source_visual_width": 14.76,
      "current_visual_width": 25.5,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0099",
      "path": [
        "Title0099"
      ],
      "source_text": "要前往{0}登录吗？",
      "source_fingerprint": "086b02e8743c93c3b12163ef095782307b8dad2d94911c062c720d93ae72d193",
      "source_batch": 105,
      "uid": "zhcn:70f61911dfa9daf2eba76ac0",
      "current_text": "Bạn có muốn đến {0} để đăng nhập không?",
      "current_fingerprint": "df39343e457da1af07dc96d445b1c6086b54d736e74a1cf29b5ec6067d4f8cc9",
      "source_visual_width": 6.96,
      "current_visual_width": 19.26,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0105",
      "path": [
        "Title0105"
      ],
      "source_text": "此设定可在个人资料中随时更改",
      "source_fingerprint": "a99c76ffec2061cd2bb61515256ce149bb2b14ddd97411c36ce3c365cd0f7771",
      "source_batch": 106,
      "uid": "zhcn:1a9cfbb834106894557f6387",
      "current_text": "Cài đặt này có thể thay đổi bất cứ lúc nào trong Hồ sơ",
      "current_fingerprint": "7d3284d3680d927b86c74788532157c4c21e7d95aa32f3a454718feadfe66396",
      "source_visual_width": 14.0,
      "current_visual_width": 28.07,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0107",
      "path": [
        "Title0107"
      ],
      "source_text": "用户数据删除确认",
      "source_fingerprint": "7a94ac0c1829eee8c8ba7a0bf301ff16fd3d98ce6be74bbef5805b4937559af5",
      "source_batch": 106,
      "uid": "zhcn:4846bcc5d7368aa677a50deb",
      "current_text": "Xác nhận xóa dữ liệu người dùng",
      "current_fingerprint": "a5930ce48a7193887e9989c12fe7989b9daa9bbeb4e012dfd863b55755ac259f",
      "source_visual_width": 8.0,
      "current_visual_width": 16.48,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0108",
      "path": [
        "Title0108"
      ],
      "source_text": "已删除的用户数据无法恢复。\n确定吗？",
      "source_fingerprint": "0d34f88f6fc95418e4a128ed5d36eb51f9fc5ce01569dd6bdabadb549f427d5d",
      "source_batch": 106,
      "uid": "zhcn:2a04f4b1cc302354aa02ba62",
      "current_text": "Dữ liệu người dùng đã xóa không thể khôi phục.\nBạn có chắc không?",
      "current_fingerprint": "c8017c9d190fa61681b747b16a49f4a7d2410588e0f54dc55cfe9901d781374c",
      "source_visual_width": 12.38,
      "current_visual_width": 24.23,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0112",
      "path": [
        "Title0112"
      ],
      "source_text": "根据网络状况有时会耗费一定时间。",
