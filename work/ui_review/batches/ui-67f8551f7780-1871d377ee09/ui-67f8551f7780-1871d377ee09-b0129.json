    },
    {
      "key": "Title0121",
      "path": [
        "Title0121"
      ],
      "source_text": "关于信息对外传输",
      "source_fingerprint": "bacbd404171f58825e0ab23b1054123f4b5380b5ae68996d7c114119eab06b23",
      "source_batch": 106,
      "uid": "zhcn:f814b3419ab2cc296f6dd067",
      "current_text": "Về việc truyền thông tin ra bên ngoài",
      "current_fingerprint": "6f5ff21b43ad70160701b4e7d6246fe6ebd2fda9d070f295731b985a278c0998",
      "source_visual_width": 8.0,
      "current_visual_width": 19.71,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title0122",
      "path": [
        "Title0122"
      ],
      "source_text": "有关从设备传输信息的情况请到这里\n※将打开网页浏览器。",
      "source_fingerprint": "19fa722fa483759cfb781a11bd007764436f718cfa961aa36e62acfa1803d6b3",
      "source_batch": 106,
      "uid": "zhcn:22ec28c3f6ea00a270120e01",
      "current_text": "Xem tại đây để biết thông tin về dữ liệu được truyền từ thiết bị\n※Trình duyệt web sẽ được mở.",
      "current_fingerprint": "bbe0801f82d89d5438f378566bd82130905f0e83065083c5aed9f568a61c0b8d",
      "source_visual_width": 16.0,
      "current_visual_width": 33.62,
      "risk_flags": [
        "overflow_risk",
        "wide_label"
      ],
      "risk_score": 6
    },
    {
      "key": "Title467002",
      "path": [
        "Title467002"
      ],
      "source_text": "确定要结束游戏吗？",
      "source_fingerprint": "2435a3c5b544e02ee850fb2af48aa5c738c87df22ee62c12dc28264c1b630bdb",
      "source_batch": 106,
      "uid": "zhcn:4acc001514f3e230e700b146",
      "current_text": "Bạn có chắc muốn thoát game không?",
      "current_fingerprint": "cb544ef6c9ae6000baae995e3d1a03fd3c7eb1e6b2efda40166533e788b6c14c",
