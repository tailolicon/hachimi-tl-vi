      "source_batch": 90,
      "uid": "zhcn:6fb7ecb02d7b1e17ac99d480",
      "current_text": "Mỗi khi nhận {0} Pt Phát triển, hồi Thể lực <color=#FF911C>+1</color> (tối đa hồi <color=#FF911C>+{1}</color>)",
