      "source_batch": 49,
      "uid": "zhcn:1e3534dcbdad10ac0abc42e3",
      "current_text": "Nếu quà không hiển thị, hãy đặt bộ lọc thành OFF\nrồi kiểm tra lại",
      "current_fingerprint": "83ca65af78b481b7580fa451805651f20596dc3d76078a14d67421a243926a87",
      "source_visual_width": 16.12,
      "current_visual_width": 25.14,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "ProfileCard02491",
      "path": [
        "ProfileCard02491"
      ],
      "source_text": "LIVE只能在横屏状态下拍摄",
      "source_fingerprint": "cbdc6bed55cda448f028dd68d01fceae55232f71d215936db6a4f55ae9ae6642",
      "source_batch": 50,
      "uid": "zhcn:cfc13b0c172f420090d9b606",
      "current_text": "LIVE chỉ có thể chụp ở màn hình ngang",
      "current_fingerprint": "ae04d1be78e3e50c9d0f016eca9c059464fd1b8cd2b7e272b6d70dceeeab04ef",
      "source_visual_width": 12.32,
      "current_visual_width": 19.46,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "ProfileCard024919",
      "path": [
        "ProfileCard024919"
      ],
      "source_text": "如果不保存就返回，编辑的内容将会被废弃",
      "source_fingerprint": "920ca89214f5ba711a7a12c6b14f739967c9e9f6a689147d9b5694163a6f101f",
      "source_batch": 50,
      "uid": "zhcn:a5c3643cf7697f60fdfdf18e",
      "current_text": "Nếu quay lại mà không lưu, nội dung chỉnh sửa sẽ bị hủy",
      "current_fingerprint": "3b40a92aa9259136c1c0aef41036fb2c9ef838f44c96d27e7feabd6e83cabc7a",
      "source_visual_width": 18.38,
      "current_visual_width": 28.7,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "ProfileCard600010",
      "path": [
        "ProfileCard600010"
      ],
      "source_text": "由于未开启「在背面填写信息」\n因此无法进行设置",
      "source_fingerprint": "83a451e6cdb24593646c72bbedf076c4e4b9c24fb99acaa8f4cb96e29d6e198a",
      "source_batch": 50,
      "uid": "zhcn:d00adc329ddd5b3d1111f420",
      "current_text": "Do chưa bật 「Điền thông tin ở mặt sau」\nnên không thể thiết lập",
      "current_fingerprint": "6d5231888f76628ddd17a9b87054cd98378fc91a1799fd20f155cd30d0e24b96",
      "source_visual_width": 12.76,
      "current_visual_width": 19.64,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race0467",
      "path": [
        "Race0467"
      ],
      "source_text": "离胜利还差一步了呢。\n面对强大的赛马娘对手们有好好努力过了。",
      "source_fingerprint": "cea6403ebb5cf3eda85e1e36033e3a2bde8da2bdd71596e00df4c8e5f5f7c107",
      "source_batch": 52,
      "uid": "zhcn:94e958b9c8b4e13711dfe138",
      "current_text": "Chỉ còn một bước nữa là đến chiến thắng.\nĐã cố gắng rất tốt trước những Uma Musume đối thủ mạnh.",
      "current_fingerprint": "87b37a17f30720ad06042afc5c7c4eaf0009cff4ea428e24fc195af645e9f022",
      "source_visual_width": 18.38,
      "current_visual_width": 28.95,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race0505",
      "path": [
        "Race0505"
      ],
      "source_text": "比赛途中好像体力耗尽了，\n速度大幅下降了呢。",
      "source_fingerprint": "8746d41d009aee88c1ba5fabf4b90c848ba72766f50a17f5b5109e00fb1dc5a8",
      "source_batch": 52,
      "uid": "zhcn:bbec772c283bddad1af873cb",
      "current_text": "Giữa cuộc đua có vẻ đã cạn thể lực,\nkhiến tốc độ giảm mạnh.",
      "current_fingerprint": "cfcead5cdd194dbb12aa4633656d991e831e46cfbaf095d7409a92c4ab0d78b2",
      "source_visual_width": 11.38,
      "current_visual_width": 18.1,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race0510",
      "path": [
        "Race0510"
      ],
      "source_text": "拥有的技能似乎有些少呢。\n去获得更多的技能吧。",
      "source_fingerprint": "33a4b13f17169579d20a5e3c8beca8249ae2e829c2515197acaca8bdc8a91a5b",
      "source_batch": 52,
      "uid": "zhcn:5f4d088d8537c036c7783e3a",
      "current_text": "Có vẻ số kỹ năng sở hữu hơi ít.\nHãy nhận thêm nhiều kỹ năng hơn.",
      "current_fingerprint": "0183ee02ac545749131e32d73d98928f8fcff717a98bcc85dc08b44ddb11afd3",
      "source_visual_width": 11.38,
      "current_visual_width": 16.86,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race0511",
      "path": [
        "Race0511"
      ],
      "source_text": "与排在前面的赛马娘比较的话\n拥有的技能好像有点少。",
      "source_fingerprint": "4508e2946a68baab5951d88c607b903fca7570f99c0ff3961de34080381d96b2",
      "source_batch": 52,
      "uid": "zhcn:8971f737a4837c04f4c57fe1",
      "current_text": "So với những Uma Musume xếp phía trước\ncó vẻ số kỹ năng sở hữu hơi ít.",
      "current_fingerprint": "fea6f078a3ef6d91c10eba8432784b4dbe0c6bc3280cf8217a207921e89c128f",
      "source_visual_width": 13.0,
      "current_visual_width": 20.29,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race9511004",
      "path": [
        "Race9511004"
      ],
      "source_text": "在播放回放时，部分对手赛马娘\n可被选择为镜头的视点",
      "source_fingerprint": "2cd3de8a50c7d71c042b89076a183a63b617afbad59804b9be959880e23bc4ed",
      "source_batch": 54,
      "uid": "zhcn:5711fc770c5a8e57c3090ca8",
      "current_text": "Khi phát lại, một số Uma Musume đối thủ\ncó thể được chọn làm góc nhìn camera",
      "current_fingerprint": "6a73df15bb194af90057535331f15a6c586409e2c0ef1f97f690b6cb649e6f0b",
      "source_visual_width": 13.38,
      "current_visual_width": 20.42,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race9511008",
      "path": [
        "Race9511008"
      ],
      "source_text": "可在播放回放时选择的赛马娘",
      "source_fingerprint": "3e4f3f7cb905eee5a5fd7cf2b8250832bfbf027f346f7945b27b9bb4fbc041d1",
      "source_batch": 54,
      "uid": "zhcn:3bc605009de27dd33d4d9385",
      "current_text": "Uma Musume có thể chọn khi phát lại",
      "current_fingerprint": "7f15dfa68d56c830c20c2201eaa3d3e92a8b71807b239ffd81df2052501b126d",
      "source_visual_width": 13.0,
      "current_visual_width": 18.55,
      "risk_flags": [
        "wide_label"
      ],
      "risk_score": 1
    },
    {
      "key": "Race9511081",
      "path": [
        "Race9511081"
      ],
      "source_text": "无法在额外关卡（EX）中使用",
      "source_fingerprint": "b8992bfe88da06c2230d9e37ab51e650fd0e8a4835524a93ec09975351daf5fd",
      "source_batch": 55,
      "uid": "zhcn:d506be3d4730ef75caa7666d",
      "current_text": "Không thể sử dụng trong màn phụ (EX)",
      "current_fingerprint": "4d41b1bf3fd7100ac25bea8179e8cd636fff4173a2fb4fa99599c45f6664aec2",
      "source_visual_width": 11.92,
